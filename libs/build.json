{
    "version": 1,
    "runtimeNames": "brix",
    "targets": {
        "macos": {
            "family": "macos",
            "triple": "arm64-apple-macos",
            "libraries": [
                "bsm",
                "c++",
                "z"
            ]
        },
        "ios-simulator": {
            "family": "ios",
            "triple": "arm64-apple-ios17.0-simulator",
            "sdk": "iphonesimulator",
            "buildDirectory": "ios-simulator",
            "components": [
                "utf8proc",
                "brixgc",
                "brixcore",
                "brixevents",
                "brixgraphics",
                "brixapplegui",
                "brixmedia",
                "pcre2",
                "brixregex",
                "sqlite",
                "brixsqlite"
            ],
            "libraries": [
                "c++",
                "z"
            ]
        },
        "ios": {
            "family": "ios",
            "triple": "arm64-apple-ios17.0",
            "sdk": "iphoneos",
            "buildDirectory": "ios",
            "components": [
                "utf8proc",
                "brixgc",
                "brixcore",
                "brixevents",
                "brixgraphics",
                "brixapplegui",
                "brixmedia",
                "pcre2",
                "brixregex",
                "sqlite",
                "brixsqlite"
            ],
            "libraries": [
                "c++",
                "z"
            ]
        },
        "linux": {
            "family": "linux",
            "triple": "aarch64-linux-gnu",
            "sysroot": "build/deps/linux-sysroot",
            "gccInstallDirectory": "usr/lib/gcc/aarch64-amazon-linux/11",
            "cpu": "neoverse-n1",
            "linker": "build/deps/llvm/bin/ld.lld",
            "archiver": "build/deps/llvm/bin/llvm-ar",
            "libclang": "build/deps/llvm/lib/libclang.so",
            "buildDirectory": "linux",
            "components": [
                "utf8proc",
                "brixgc",
                "brixcore",
                "brixevents",
                "openssl",
                "brixtls",
                "brixcheaderscan",
                "sqlite",
                "brixsqlite"
            ]
        }
    },
    "toolchain": {
        "cCompiler": "clang",
        "cxxCompiler": "clang++",
        "linker": "clang"
    },
    "compile": {
        "runtimeCxxStandard": "c++11",
        "harnessCxxStandard": "c++17",
        "commonFlags": [
            "-fexceptions",
            "-pipe",
            "-Wno-trigraphs",
            "-Wreturn-type",
            "-Wunused-variable",
            "-DBX_RELEASE",
            "-DMAC",
            "-O3"
        ]
    },
    "gcModes": {
        "normal": {
            "defines": {
                "BX_ENABLE_BRIX_GC": 1,
                "BX_GC_NEVER_COLLECT": 0
            }
        },
        "no-gc": {
            "benchmarkOnly": true,
            "buildDirectory": "no-gc",
            "defines": {
                "BX_ENABLE_BRIX_GC": 0,
                "BX_GC_NEVER_COLLECT": 0
            },
            "omitProjects": [
                "brixgc"
            ]
        },
        "never-collect": {
            "benchmarkOnly": true,
            "buildDirectory": "never-collect",
            "defines": {
                "BX_ENABLE_BRIX_GC": 1,
                "BX_GC_NEVER_COLLECT": 1
            }
        }
    },
    "sanitizers": {
        "thread": {
            "buildDirectory": "tsan",
            "compileFlags": [
                "-fsanitize=thread",
                "-fno-omit-frame-pointer",
                "-fno-sanitize-recover=all",
                "-g",
                "-O1"
            ],
            "library": "libclang_rt.tsan_osx_dynamic.dylib"
        },
        "address": {
            "buildDirectory": "asan",
            "compileFlags": [
                "-fsanitize=address",
                "-fno-omit-frame-pointer",
                "-fno-sanitize-recover=all",
                "-g",
                "-O1"
            ],
            "library": "libclang_rt.asan_osx_dynamic.dylib"
        }
    },
    "externalLibraries": {
        "openssl": {
            "path": "build/deps/openssl",
            "exports": {
                "include/openssl": "openssl"
            },
            "includePaths": [
                "build/deps/openssl/include"
            ],
            "libraryPaths": [
                "build/deps/openssl/lib/libssl.a",
                "build/deps/openssl/lib/libcrypto.a"
            ]
        },
        "utf8proc": {
            "path": "build/deps/utf8proc",
            "exports": {
                "include": "utf8proc"
            },
            "includePaths": [
                "build/deps/utf8proc/include"
            ],
            "libraryPaths": [
                "build/deps/utf8proc/lib/libutf8proc.a"
            ]
        },
        "treesitter": {
            "path": "build/deps/tree-sitter",
            "includePaths": [
                "build/deps/tree-sitter/include"
            ],
            "libraryPaths": [
                "build/deps/tree-sitter/lib/libtree-sitter-c.a",
                "build/deps/tree-sitter/lib/libtree-sitter-cpp.a",
                "build/deps/tree-sitter/lib/libtree-sitter-objcpp.a",
                "build/deps/tree-sitter/lib/libtree-sitter-javascript.a",
                "build/deps/tree-sitter/lib/libtree-sitter-typescript.a",
                "build/deps/tree-sitter/lib/libtree-sitter-tsx.a",
                "build/deps/tree-sitter/lib/libtree-sitter-python.a",
                "build/deps/tree-sitter/lib/libtree-sitter-rust.a",
                "build/deps/tree-sitter/lib/libtree-sitter-go.a",
                "build/deps/tree-sitter/lib/libtree-sitter-json.a",
                "build/deps/tree-sitter/lib/libtree-sitter-css.a",
                "build/deps/tree-sitter/lib/libtree-sitter-html.a",
                "build/deps/tree-sitter/lib/libtree-sitter-bash.a",
                "build/deps/tree-sitter/lib/libtree-sitter-markdown.a",
                "build/deps/tree-sitter/lib/libtree-sitter.a"
            ]
        },
        "ghosttyvt": {
            "path": "build/deps/ghostty-vt",
            "includePaths": [
                "build/deps/ghostty-vt/include"
            ],
            "libraryPaths": [
                "build/deps/ghostty-vt/lib/libghostty-vt.a"
            ]
        },
        "pcre2": {
            "path": "build/deps/pcre2",
            "includePaths": [
                "build/deps/pcre2/include"
            ],
            "libraryPaths": [
                "build/deps/pcre2/lib/libpcre2-8.a"
            ]
        },
        "sqlite": {
            "path": "build/deps/sqlite",
            "exports": {
                "include": "sqlite"
            },
            "includePaths": [
                "build/deps/sqlite/include"
            ],
            "libraryPaths": [
                "build/deps/sqlite/lib/libsqlite3.a"
            ]
        }
    },
    "runtimeProjects": {
        "brixgc": {
            "path": "libs/gc",
            "exports": {
                "include": "BxGC"
            },
            "includePaths": [
                "build/brix/libs/core",
                "build/brix/libs/events"
            ],
            "compilerFlags": [
                "-fno-omit-frame-pointer"
            ],
            "requires": [
                "brixcore",
                "brixevents"
            ],
            "archive": "brix/libs/gc/libbrixgc.a"
        },
        "brixcore": {
            "path": "libs/core",
            "exports": {
                "include": "BxCore",
                "include/.": "JaCore"
            },
            "includePaths": [
                "build/brix/libs/gc"
            ],
            "compilerFlags": [
                "-fno-omit-frame-pointer"
            ],
            "requires": [
                "brixgc",
                "brixevents",
                "utf8proc"
            ],
            "archive": "brix/libs/core/libbrixcore.a"
        },
        "brixtls": {
            "path": "libs/tls",
            "exports": {
                "include": "BxTLS"
            },
            "requires": [
                "openssl"
            ],
            "archive": "brix/libs/tls/libbrixtls.a"
        },
        "brixevents": {
            "path": "libs/events",
            "exports": {
                "include": "BxEvents"
            },
            "includePaths": [
                "build/brix/libs/core",
                "build/brix/libs/gc"
            ],
            "compilerFlags": [
                "-fno-omit-frame-pointer"
            ],
            "frameworks": [
                "CoreFoundation",
                "CoreServices",
                "IOKit"
            ],
            "targets": {
                "ios": {
                    "frameworks": [
                        "CoreFoundation"
                    ],
                    "exclude": [
                        "BxEpollLoop.cpp",
                        "BxFSEventsPathWatcher.cpp",
                        "BxInotifyPathWatcher.cpp",
                        "BxPathWatcher.cpp"
                    ]
                },
                "macos": {
                    "exclude": [
                        "BxEpollLoop.cpp",
                        "BxInotifyPathWatcher.cpp"
                    ]
                },
                "linux": {
                    "exclude": [
                        "BxBundle.cpp",
                        "BxFSEventsPathWatcher.cpp",
                        "BxKQueueLoop.cpp",
                        "BxMachPorts.cpp",
                        "BxSelectLoop.cpp",
                        "BxTriggerFile.cpp"
                    ]
                }
            },
            "requires": [
                "brixcore",
                "brixgc"
            ],
            "archive": "brix/libs/events/libbrixevents.a"
        },
        "brixgraphics": {
            "path": "libs/graphics",
            "exports": {
                "include": "BxGraphics"
            },
            "includePaths": [
                "build/brix/libs/gc"
            ],
            "frameworks": [
                "CoreFoundation",
                "CoreGraphics",
                "CoreText",
                "Foundation",
                "IOSurface",
                "ImageIO",
                "Metal"
            ],
            "archive": "brix/libs/graphics/libbrixgraphics.a"
        },
        "brixapplegui": {
            "path": "libs/applegui",
            "exports": {
                "include": "BxAppleGUI"
            },
            "compilerFlags": [
                "-fobjc-arc"
            ],
            "includePaths": [
                "build/brix/libs/core",
                "build/brix/libs/events",
                "build/brix/libs/gc",
                "build/brix/libs/graphics"
            ],
            "frameworks": [
                "AppKit",
                "CoreGraphics",
                "CoreVideo",
                "IOSurface",
                "Metal",
                "QuartzCore",
                "UniformTypeIdentifiers"
            ],
            "targets": {
                "macos": {
                    "exclude": [
                        "BxUIKitGUI.mm"
                    ]
                },
                "ios": {
                    "frameworks": [
                        "CoreGraphics",
                        "IOSurface",
                        "Metal",
                        "QuartzCore",
                        "UIKit"
                    ],
                    "exclude": [
                        "BxAppleGUI.mm",
                        "BxFileDialog.mm"
                    ]
                }
            },
            "requires": [
                "brixcore",
                "brixevents",
                "brixgraphics"
            ],
            "archive": "brix/libs/applegui/libbrixapplegui.a"
        },
        "brixmovie": {
            "path": "libs/movie",
            "exports": {
                "include": "BxMovie"
            },
            "includePaths": [
                "build/brix/libs/gc",
                "build/brix/libs/graphics"
            ],
            "frameworks": [
                "AVFoundation",
                "CoreFoundation",
                "CoreGraphics",
                "CoreMedia",
                "CoreVideo",
                "Foundation"
            ],
            "requires": [
                "brixgraphics"
            ],
            "archive": "brix/libs/movie/libbrixmovie.a"
        },
        "brixmedia": {
            "path": "libs/media",
            "exports": {
                "include": "BxMedia"
            },
            "includePaths": [
                "build/brix/libs/gc"
            ],
            "frameworks": [
                "AudioToolbox",
                "CoreAudio",
                "CoreFoundation"
            ],
            "targets": {
                "macos": {
                    "exclude": [
                        "BxAudioSession.mm"
                    ]
                },
                "ios": {
                    "frameworks": [
                        "AVFAudio",
                        "AudioToolbox",
                        "CoreFoundation",
                        "UIKit"
                    ]
                }
            },
            "archive": "brix/libs/media/libbrixmedia.a"
        },
        "brixwebkit": {
            "path": "libs/webkit",
            "exports": {
                "include": "BxWebKit"
            },
            "includePaths": [
                "build/brix/libs/applegui",
                "build/brix/libs/core",
                "build/brix/libs/events",
                "build/brix/libs/gc"
            ],
            "frameworks": [
                "AppKit",
                "AuthenticationServices",
                "WebKit"
            ],
            "requires": [
                "brixapplegui",
                "brixcore",
                "brixevents"
            ],
            "archive": "brix/libs/webkit/libbrixwebkit.a"
        },
        "brixsyntax": {
            "path": "libs/syntax",
            "exports": {
                "include": "BxSyntax"
            },
            "includePaths": [
                "build/brix/libs/gc",
                "build/deps/tree-sitter/include"
            ],
            "compilerFlags": [
                "-std=gnu11"
            ],
            "requires": [
                "treesitter"
            ],
            "archive": "brix/libs/syntax/libbrixsyntax.a"
        },
        "brixterminal": {
            "path": "libs/terminal",
            "exports": {
                "include": "BxTerminal"
            },
            "includePaths": [
                "build/brix/libs/gc",
                "build/deps/ghostty-vt/include"
            ],
            "compilerFlags": [
                "-std=gnu11",
                "-DGHOSTTY_STATIC"
            ],
            "requires": [
                "ghosttyvt"
            ],
            "archive": "brix/libs/terminal/libbrixterminal.a"
        },
        "brixregex": {
            "path": "libs/regex",
            "exports": {
                "include": "BxRegex"
            },
            "includePaths": [
                "build/brix/libs/gc",
                "build/deps/pcre2/include"
            ],
            "compilerFlags": [
                "-std=gnu11"
            ],
            "requires": [
                "pcre2"
            ],
            "archive": "brix/libs/regex/libbrixregex.a"
        },
        "brixsqlite": {
            "path": "libs/sqlite",
            "exports": {
                "include": "BxSQLite"
            },
            "includePaths": [
                "build/brix/libs/gc",
                "build/deps/sqlite/include"
            ],
            "compilerFlags": [
                "-std=gnu11"
            ],
            "requires": [
                "sqlite"
            ],
            "archive": "brix/libs/sqlite/libbrixsqlite.a"
        },
        "brixcheaderscan": {
            "path": "libs/cheaderscan",
            "exports": {
                "include": "BxCHeaderScan"
            },
            "includePaths": [
                "build/deps/clang-c/include"
            ],
            "compilerFlags": [
                "-std=gnu11"
            ],
            "archive": "brix/libs/cheaderscan/libbrixcheaderscan.a"
        }
    },
    "runtimeLink": {
        "always": [
            "brixcore",
            "brixgc",
            "brixevents"
        ],
        "warningFlags": [
            "-w"
        ]
    }
}
