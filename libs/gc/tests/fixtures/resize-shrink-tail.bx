(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(blank)

(main
  (let resized (call make-resized-buffer))
  (call C:brixCollect)
  (blank)
  (if (!= (. resized length) 2)
    (throw (call Panic "described shrink changed resized buffer length"))
  )
  (blank)
  (print (str "resize-shrink-tail-ok " (. ([] resized 0) value) "," (. ([] resized 1) value)))
)

(fn-do + make-resized-buffer (of Array Node)
  (let buffer (call (of Array Node) 12))
  (for (in i (..< 0 12))
    (= ([] buffer i) (call Node i))
  )
  (blank)
  (= buffer (call (. buffer resize) 2))
  (return buffer)
)

(type + Node
  (prop + value Size (= 0))
  (fn-do + This _
    (param v Size)
    (= value v)
  )
)
