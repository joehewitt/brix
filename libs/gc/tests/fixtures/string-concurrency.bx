(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(blank)

(main
  (let worker (call Worker 2))
  (let ready (of SyncChannel Bool))
  (let start (of SyncChannel Bool))
  (let done (of SyncChannel String))
  (blank)
  (do-new (worker: worker)
    (inline (call iterate-strings ready start done))
  )
  (do-new (worker: worker)
    (inline (call collect-strings ready start done))
  )
  (blank)
  (<- ready)
  (<- ready)
  (<- start true)
  (<- start true)
  (blank)
  (let first (<- done))
  (let second (<- done))
  (call (. worker stop))
  (blank)
  (if (not (or (and (== first "iterator-ok") (== second "collector-ok")) (and (== first "collector-ok") (== second "iterator-ok"))))
    (throw (call Panic "String iterator concurrency results were incomplete"))
  )
  (blank)
  (print "gc-string-iterator-concurrency-ok")
)

(fn-do + iterate-strings _
  (param ready (of SyncChannel Bool))
  (param start (of SyncChannel Bool))
  (param done (of SyncChannel String))
  (<- ready true)
  (<- start)
  (blank)
  (let source (* "Aé漢😀é" 128))
  (let expected-count 768)
  (let expected-pass-checksum (* 158130 128))
  (let checksum (as 0 Size))
  (for (in round (..< 0 32))
    (let count 0)
    (let pass-checksum (as 0 Size))
    (for (in char source)
      (+= count 1)
      (+= pass-checksum (as char Size))
      (if (== (% count 128) 0)
        (call C:brixCollect)
      )
    )
    (if (or (!= count expected-count) (!= pass-checksum expected-pass-checksum))
      (<- done "iterator-corrupt")
      (return)
    )
    (+= checksum pass-checksum)
  )
  (blank)
  (if (!= checksum (* expected-pass-checksum 32))
    (<- done "iterator-checksum")
    (else
      (<- done "iterator-ok")
    )
  )
)

(fn-do + collect-strings _
  (param ready (of SyncChannel Bool))
  (param start (of SyncChannel Bool))
  (param done (of SyncChannel String))
  (<- ready true)
  (<- start)
  (blank)
  (for (in i (..< 0 128))
    (let churn (* (str "collector-" i) 8))
    (if (== (. churn length) 0)
      (<- done "collector-corrupt")
      (return)
    )
    (call C:brixCollect)
  )
  (blank)
  (<- done "collector-ok")
)
