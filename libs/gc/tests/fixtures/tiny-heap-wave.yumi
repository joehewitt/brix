/YuCore/YuCore.h
/YuGC/YuGC.h

. width = 512
. rounds = 96
. survivors = Array'Node(width)

for i in 0 .. < width
    survivors[i] = Node(i)

. checksum = 0 as Size
for round in 0 .. < rounds
    for i in 0 .. < width
        . node = Node(round * width + i)
        node.left = survivors[i]
        survivors[i] = node

    if round % 8 == 0
        . pulse = Array'Int(2048)
        pulse[0] = round

for i in 0 .. < width
    checksum += survivors[i].value

-- "tiny-heap-wave-ok ${checksum}"

