(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(import /data/markdown)
(blank)

(main
  (let heap-goal 1048576)
  (call C:brixGCSetHeapGoal heap-goal)
  (blank)
  (let chunks 16)
  (let chunk "This is a streaming markdown sentence with **bold text**, *emphasis*, and [a link](https://example.com). ")
  (let transcript "")
  (let checksum (as 0 Size))
  (blank)
  (for (in i (..< 0 chunks))
    (++= transcript chunk)
    (let document (call Markdown transcript))
    (let html (call markdown-to-html document))
    (+= checksum (. html length))
    (if (== (% i 4) 3)
      (call C:brixCollect)
    )
  )
  (blank)
  (if (< checksum (. transcript length))
    (throw (call Panic "markdown refresh result was too short"))
  )
  (blank)
  (print (str "markdown-refresh-ok " checksum))
)
