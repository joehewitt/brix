(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(blank)

(main
  (let width 512)
  (let rounds 96)
  (let survivors (call (of Array Node) width))
  (blank)
  (for (in i (..< 0 width))
    (= ([] survivors i) (call Node i))
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in round (..< 0 rounds))
    (for (in i (..< 0 width))
      (let node (call Node (+ (* round width) i)))
      (= (. node left) ([] survivors i))
      (= ([] survivors i) node)
    )
    (blank)
    (if (== (% round 8) 0)
      (let pulse (call (of Array Int) 2048))
      (= ([] pulse 0) round)
    )
  )
  (blank)
  (for (in i (..< 0 width))
    (+= checksum (. ([] survivors i) value))
  )
  (blank)
  (print (str "tiny-heap-wave-ok " checksum))
)

(type + Node
  (prop + value Size (= 0))
  (prop + left (? Node))
  (prop + right (? Node))
  (prop + padding (tuple U64 U64 U64 U64))
  (fn-do + This _
    (param v Size)
    (= value v)
  )
)
