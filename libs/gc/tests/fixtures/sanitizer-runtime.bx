(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(blank)

(main
  (let nodes (call (of Array SanitizerNode) 2048))
  (let checksum (as 0 Size))
  (for (in index (..< 0 (. nodes length)))
    (= ([] nodes index) (call SanitizerNode index))
    (+= checksum (. ([] nodes index) value))
  )
  (blank)
  (call C:brixCollect)
  (print (str "gc-sanitizer-ok " checksum))
)

(type + SanitizerNode
  (prop + value Size (= 0))
  (prop + next (? SanitizerNode))
  (fn-do + This _
    (param initial-value Size)
    (= value initial-value)
  )
)
