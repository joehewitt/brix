/YuCore/YuCore.h
/YuGC/YuGC.h

. nodes = Array'SanitizerNode(2048)
. checksum = 0 as Size
for index in 0 .. < nodes.length
    nodes[index] = SanitizerNode(index)
    checksum += nodes[index].value

C:yumiCollect()
-- "gc-sanitizer-ok ${checksum}"

