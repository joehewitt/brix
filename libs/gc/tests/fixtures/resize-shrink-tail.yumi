. resized = make-resized-buffer()
C:yumiCollect()

if resized.length != 2
    ?! Panic("described shrink changed resized buffer length")

-- "resize-shrink-tail-ok ${resized[0].value},${resized[1].value}"

━━━━━━━━━━━━━━━━━━━━
+ do make-resized-buffer Array'Node

. buffer = Array'Node(12)
for i in 0 .. < 12
    buffer[i] = Node(i)

buffer = buffer.resize(2)
= buffer

