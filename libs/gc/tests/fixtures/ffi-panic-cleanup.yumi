/JaCore/tests.h
/YuCore/YuCore.h
/YuGC/YuGC.h

run-ffi-panic()

━━━━━━━━━━━━━━━━━━━━
+ TestCallback is (*C) I32
    - n I32

━━━━━━━━━━━━━━━━━━━━
+ do run-ffi-panic

do finally
    . panic = recover()
    if panic
        C:yumiCollect()
        -- "ffi-panic-cleanup-ok"

C:ctestCallback(panic-callback as TestCallback)
?! Panic("FFI callback did not panic")

━━━━━━━━━━━━━━━━━━━━
+ panic-callback I32
    - n I32

?! Panic("callback panic ${n}")
