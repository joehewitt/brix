/JaCore/tests.h
/YuCore/YuCore.h
/YuGC/YuGC.h

. running = do new run-ffi-panic()
catch failure
    C:yumiCollect()
    -- "ffi-panic-cleanup-ok"
running.wait()

━━━━━━━━━━━━━━━━━━━━
+ TestCallback is (*C) I32
    - n I32

━━━━━━━━━━━━━━━━━━━━
+ do run-ffi-panic

C:ctestCallback(panic-callback as TestCallback)
?! Panic("FFI callback did not panic")

━━━━━━━━━━━━━━━━━━━━
+ panic-callback I32
    - n I32

?! Panic("callback panic ${n}")
