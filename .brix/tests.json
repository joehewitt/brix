{
    "brix": ["./bin/brix"],
    "env": {
        "BRIXPATH": "./stdlib",
        "BRIX_BUILD_PATH": "./.tmp/build",
        "BRIX_DEBUG_LOG": null
    },
    "suites": [
        {
            "id": "parse",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "env": {
                "BRIX_TEST_SUITE": "parse",
                "BRIX_TEST_ROOT": "./stdlib/lang/tests/parse"
            }
        },
        {
            "id": "ubrix",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "env": {
                "BRIX_TEST_SUITE": "ubrix",
                "BRIX_TEST_ROOT": "./stdlib/lang/tests/parse"
            }
        },
        {
            "id": "core",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "env": {
                "BRIX_TEST_SUITE": "core",
                "BRIX_TEST_ROOT": "./stdlib/core/tests"
            }
        },
        {
            "id": "diagnostics",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "env": {
                "BRIX_TEST_SUITE": "diagnostics",
                "BRIX_TEST_ROOT": "./stdlib/lang/tests/diagnostics"
            }
        },
        {
            "id": "docs",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "env": {
                "BRIX_TEST_SUITE": "docs",
                "BRIX_TEST_ROOT": "./docs/ref"
            }
        },
        {
            "id": "stdlib",
            "modules": "./stdlib"
        },
        {
            "id": "parity",
            "modules": [
                "./stdlib/gui/parity/metal-parity",
                "./stdlib/gui/parity/scene-parity",
                "./stdlib/gui/parity/presented-surface"
            ]
        },
        {
            "id": "other",
            "catalog": ["./bin/brixtest-python", "catalog"],
            "run": ["./bin/brixtest-python", "run"],
            "env": {
                "BRIXTEST_PYTHON_FILES": "libs/events/tests/event_loop.py libs/gc/tests/sanitizers.py libs/gc/tests/stress.py stdlib/core/tests/effect_copies.py stdlib/core/tests/probe_transport.py stdlib/lang/lint/tests/import_conflicts.py stdlib/lang/lint/tests/literal_suffix.py stdlib/lang/lint/tests/semantic_rules.py toolchain/bench/tests/launches.py"
            }
        },
        {
            "id": "scratch",
            "catalog": ["./bin/brix", "test-suite", "catalog"],
            "run": ["./bin/brix", "test-suite", "run"],
            "default": false,
            "env": {
                "BRIX_TEST_SUITE": "scratch",
                "BRIX_TEST_ROOT": "./.tmp/scratch"
            }
        }
    ]
}
