./bench-catalog
./bench-config
./bench-metrics
./bench-report
./bench-runner
/data/json
/time/timer

_ bench-shown-metrics Size = 6
_ bench-shown-lines Size = 40
_ bench-reason-limit Size = 120

━━━━━━━━━━━━━━━━━━━━
+ BenchSession

+ results [BenchResult?]
+ phase BenchPhase?
+ current Index?
+ iteration Size = 0
+ phase-started U64
+ setup = ""
+ saved String?
+ problem String?
+ started U64
+ ended U64
+ is-stopping = false
+ is-stopped = false
+ is-complete = false

────────────────────
+ This
    - count Size

started = monotonic-time-nanoseconds()
for _ in 0 .. < count
    results += null

────────────────────
+ do apply
    - event BenchEvent

do match? event
    | .setup(state)
        setup = state
    | .progress(bench, phase, iteration, at, _)
        current = bench
        this.phase = phase
        this.iteration = iteration
        if phase == BenchPhase.compile || phase == BenchPhase.run || is-warmup
            phase-started = at
        .. is-warmup = phase == BenchPhase.warmup-compile || phase == BenchPhase.warmup-run
    | .finished(bench, result)
        results[bench] = result
        current = null
    | .saved(path)
        saved = path
    | .failed(message)
        problem = message
    | .completed(stopped)
        is-stopped = stopped
        ended = monotonic-time-nanoseconds()
        is-complete = true

────────────────────
+ get elapsed U64

(if ended != 0 then ended else monotonic-time-nanoseconds()) - started

━━━━━━━━━━━━━━━━━━━━
+ do bench-run-info BenchRunInfo ?! Error
    - config BenchConfig
    - profile BenchProfile
    - selectors [String]
    - timeout U64
    - keeps Bool
    - saved-by String
    - iterations Size?
    - warmup Size?
    - compare String?
    - save String?
    - reason String?

. uses-timing = profile.uses-timing-samples
. note = (reason ?? "").trim()
?! Error("A benchmark reason must be at most $bench-reason-limit characters")
    if note.length > bench-reason-limit
= BenchRunInfo
    - bench-run-id()
    - bench-iso-time()
    - config
    - profile
    - selectors
    - if uses-timing then (iterations ?? 1) else 1
    - if uses-timing then (warmup ?? 0) else 0
    - timeout
    - keeps
    - bench-saved-name(save ?? bench-last-run-name, profile.name)
    - if compare then bench-saved-name(compare, profile.name) else ""
    - note
    - saved-by

━━━━━━━━━━━━━━━━━━━━
+ do bench-run-notes [String]
    - profile BenchProfile
    - iterations Size?
    - warmup Size?

. notes [String]
if !profile.uses-timing-samples && (iterations != null || warmup != null)
    notes += "${profile.name} has no timing metric, so each benchmark runs once without warmup"
= notes

━━━━━━━━━━━━━━━━━━━━
+ do bench-baseline [String = JSON] ?! Error
    - root String
    - compare-name String

. baseline [String = JSON]
if compare-name != ""
    for item in bench-items(bench-field("results", load-bench-baseline(root, compare-name))) ?? List'JSON()
        baseline[bench-string(bench-field("id", item))] = item
= baseline

━━━━━━━━━━━━━━━━━━━━
+ do bench-shown-metrics [Index] ?! Error
    - profile BenchProfile
    - option String?

. shown [Index]
if !option
    for index in 0 .. < profile.metrics.length
        if index < bench-shown-metrics
            shown += index
    = shown
if option == "all"
    for index in 0 .. < profile.metrics.length
        shown += index
    = shown
for key in bench-commas(option)
    . found = false
    for index in 0 .. < profile.metrics.length
        if profile.metrics[index].key == key
            shown += index
            found = true
    ?! Error("${profile.name} has no metric $key")
        if !found
= shown

━━━━━━━━━━━━━━━━━━━━
+ do bench-profile-lines [String]
    - config BenchConfig
    - cases [BenchCase]

. lines [String]
lines += "profiles"
for profile in ordered-bench-profiles(config)
    . note = if profile.is-default then "  (default)" else ""
    lines += "  ${profile.name}$note  $metric-count  ${profile.description}"
        .. metric-count = bench-count-text(profile.metrics.length, "metric")
lines += ""
lines += "suites"
for suite in config.suites
    . count = 0
    for bench in cases
        if bench.suite.name == suite.name
            count += 1
    lines += "  ${suite.name}  ${bench-count-text(count, "benchmark")}  ${suite.description}"
lines += "${bench-count-text(cases.length, "benchmark")}"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do bench-selection-lines [String]
    - selected [BenchCase]
    - shows-benchmarks Bool

. suites [String]
. counts [String = Size]
for bench in selected
    if !counts[bench.suite.name]
        suites += bench.suite.name
    counts[bench.suite.name] = (counts[bench.suite.name] ?? 0) + 1
. lines [String]
for suite in suites
    lines += "$suite  ${bench-count-text(counts[suite]!, "benchmark")}"
    if shows-benchmarks
        for bench in selected
            if bench.suite.name == suite
                lines += "    ${bench.id}  ${bench.description}"
lines += "${bench-count-text(selected.length, "benchmark")} selected"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do bench-saved-run-lines [String]
    - runs [BenchSavedRun]
    - profile String?

. lines [String]
if runs.length == 0
    lines += "No saved runs${if profile then " for ${profile}" else ""}"
    = lines
for saved in runs
    . reason = if saved.reason != "" then "  ${saved.reason}" else ""
    . owner = if saved.saved-by != "" && saved.saved-by != "human" then saver-note else ""
        .. saver-note = "  saved by ${saved.saved-by}"
    lines += "${saved.name}  ${saved.generated}$reason$owner"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do bench-heading String
    - info BenchRunInfo
    - count Size

. parts [String]
if info.iterations > 1
    parts += "${info.iterations} iterations"
if info.warmup > 0
    parts += "${info.warmup} warmup"
if info.compare-name != ""
    parts += "compared with ${info.compare-name}"
. note = if parts.length > 0 then "  ${"  ".join(parts)}" else ""
= "${info.profile.name}  ${bench-count-text(count, "benchmark")}$note"

━━━━━━━━━━━━━━━━━━━━
+ do bench-result-lines [String]
    - result BenchResult
    - info BenchRunInfo
    - shown [Index]
    - baseline [String = JSON]

. parts [String]
for index in shown
    parts += bench-metric-text
        - result
        - info.profile.metrics[index]
        - index
        - baseline[result.bench.id]
. label = if result.is-passed then "PASS" else result.status.uppercased
. values = if parts.length > 0 then "  ${"  ".join(parts)}" else ""
. lines [String]
lines += "$label  ${result.bench.id}$values"
if !result.is-passed
    for diagnostic in result.diagnostics
        lines ++= bench-indented-lines(diagnostic)
    lines += ""
= lines

━━━━━━━━━━━━━━━━━━━━
+ do bench-status-line String
    - session BenchSession
    - selected [BenchCase]
    - info BenchRunInfo

. done = 0
. passed = 0
for result in session.results
    if result
        done += 1
        if result.is-passed
            passed += 1
. line = "$done/${selected.length}  $passed passed"
if done > passed
    line = "$line  ${done - passed} failed"
line = "$line  ${bench-elapsed-text(session.elapsed)}"
=? "$line  stopping…" if session.is-stopping
=? "$line  ${bench-setup-text(session.setup)}" if is-idle && session.setup == "provider-setup"
.. is-idle = session.current == null
. current = session.current
=? line if current == null
. phase = bench-phase-text(session.phase!, session.iteration, info)
. timer = if session.phase-started != 0 then phase-elapsed else ""
    .. phase-elapsed = bench-elapsed-text(monotonic-time-nanoseconds() - session.phase-started)
= "$line  ${selected[current].id}  $phase  $timer"

━━━━━━━━━━━━━━━━━━━━
+ do bench-summary-lines [String]
    - session BenchSession
    - info BenchRunInfo

. total = 0
. passed = 0
for result in session.results
    if result
        total += 1
        if result.is-passed
            passed += 1
. outcome = if session.is-stopped then "stopped  " else ""
. failed = if total > passed then "  ${total - passed} failed" else ""
. lines [String]
lines += "$outcome${bench-count-text(total, "benchmark")}  $passed passed$failed  $elapsed-text"
    .. elapsed-text = bench-elapsed-text(session.elapsed)
. saved = session.saved
if saved
    lines += "saved ${if saved.starts-with("${info.config.root}/") then relative-saved else saved}"
        .. relative-saved = saved[info.config.root.length + 1 ...]
= lines

━━━━━━━━━━━━━━━━━━━━
+ bench-count-text String
    - count Size
    - noun String

if count == 1 then "1 $noun" else "$count ${noun}s"

━━━━━━━━━━━━━━━━━━━━
_ bench-metric-text String
    - result BenchResult
    - metric BenchMetric
    - index Index
    - base JSON?

|? !base
    "${metric.title} $value"
??
    "${metric.title} $value (${bench-delta-text(delta.percent)})"

.. summary = result.summaries[index]
.. value = if summary.is-dispersed && summary.min && summary.max then "${bench-value-text(metric.format, summary.min)}–${bench-value-text(metric.format, summary.max)}" else bench-value-text(metric.format, summary.median)
.. delta = bench-delta(bench-result-median(base, metric.key), summary.median)

━━━━━━━━━━━━━━━━━━━━
_ do bench-indented-lines [String]
    - text String

. lines [String]
for line in text.split("\n")
    lines += line
. shown [String]
. count = 0
for line in lines
    if count == bench-shown-lines
        shown += "    … ${lines.length - count} more lines"
        break
    shown += "    $line"
    count += 1
= shown

━━━━━━━━━━━━━━━━━━━━
_ bench-phase-text String
    - phase BenchPhase
    - iteration Size
    - info BenchRunInfo

match phase
    | .warmup-compile
        "warmup compile ${iteration + 1}/${info.warmup}"
    | .warmup-compile-done
        "warmup compile ${iteration + 1}/${info.warmup}"
    | .warmup-run
        "warmup run ${iteration + 1}/${info.warmup}"
    | .warmup-run-done
        "warmup run ${iteration + 1}/${info.warmup}"
    | .compile
        "compile ${iteration + 1}/${info.iterations}"
    | .compile-done
        "compile ${iteration + 1}/${info.iterations}"
    | .run
        "run ${iteration + 1}/${info.iterations}"
    | .run-done
        "run ${iteration + 1}/${info.iterations}"

━━━━━━━━━━━━━━━━━━━━
_ bench-setup-text String
    - state String

if state == "provider-setup" then "setting up the benchmark runtime" else state
