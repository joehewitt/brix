_ bench-refresh = 100ms
_ bench-clear-line = "\r\x1b[K"

request-process-termination(BenchTool().run())

━━━━━━━━━━━━━━━━━━━━
_ BenchTool is CommandLine

────────────────────

<This
    name = "yumi bench"
    about = "Build and measure a project's benchmarks. Each folder inside a bench folder under the project root is a suite named after it, and the timing profile measures run time, CPU time, instructions and cycles. $bench-config-path can add suites, metrics and profiles, and folders under the root can hold a $bench-config-path of their own."

    <Subcommand "list"
        about = "profiles and suites, or the benchmarks a selection holds"
        action = => list(root.value ?? (project-root as String), listed.values, benchmarks.value, profile.value)

        <Arguments listed "selector"
        <Flag benchmarks "--benchmarks"
            about = "list each selected benchmark"

    <Subcommand "runs"
        about = "saved runs to compare against"
        action = => list-runs(root.value ?? (project-root as String), profile.value)

    <Subcommand "run"
        about = "run the selected benchmarks, or the profile's default selection"
        action = => run-chosen()

        <Arguments chosen "selector"
        <Option'Size iterations "--iterations"
            value-name = "N"
            about = "measured samples of each benchmark, for profiles with a timing metric"
        <Option'Size warmup "--warmup"
            value-name = "N"
            about = "discarded samples before measuring"
        <Option compare "--compare"
            value-name = "NAME"
            about = "compare against a saved run"
        <Option save "--save"
            value-name = "NAME"
            about = "also save this run under NAME"
        <Option reason "--reason"
            value-name = "TEXT"
            about = "a note saved with the report"
        <Option'U64 timeout "--timeout"
            value-name = "MS"
            about = "the limit for each compile or run"
            default = bench-default-timeout
        <Option metrics "--metrics"
            value-name = "KEYS"
            about = "the metrics shown for each benchmark, comma separated, or all"
        <Flag keep "--keep"
            about = "keep the built executables and metric files"

    <Subcommand "launch"
        about = "launch a built benchmark once to warm it, then until its timing settles, and print its process metrics"
        action = => BenchLauncher(Path(executable.value!).resolved as String, deadline.value!).run()

        <Argument executable "executable"
        <Option'Seconds deadline "--deadline"
            value-name = "D"
            parser = :: text => parse-timeout(text)
            default = bench-launch-deadline
            about = "stop launching after D (500ms, 30s, 2m) and exit with 124"

    <HelpTopic "selectors"
        <HelpEntry "array"
            about = "a whole suite"
        <HelpEntry "array/scalar-index"
            about = "one benchmark, in one suite"
        <HelpEntry "scalar-index"
            about = "a benchmark in every suite that has it"
        <HelpEntry "stdlib/core/bench/array/scalar-index-access.yumi"
            about = "a benchmark source file"

    <Option profile "--profile"
        value-name = "NAME"
        about = "the profile to run, list or compare; the config's default otherwise"
    <Option root "--root"
        value-name = "PATH"
        about = "the project folder holding $bench-config-path; by default the nearest folder holding .git, or else a $project-folder-name folder, or else the current folder"

────────────────────
_ run-chosen Int ?! Error

run-benchmarks
    - root.value ?? (project-root as String)
    - chosen.values
    - timeout.value!
    - keep.value
    - profile.value
    - iterations.value
    - warmup.value
    - compare.value
    - save.value
    - reason.value
    - metrics.value

━━━━━━━━━━━━━━━━━━━━
_ do list Int ?! Error
    - root String
    - selectors [String]
    - shows-benchmarks Bool
    - profile-name String?

. config = load-bench-config(root)
. cases = discover-bench-cases(config)
if selectors.length == 0 && !shows-benchmarks
    for line in bench-profile-lines(config, cases)
        -- line
    = 0
. chosen = if selectors.length > 0 then selectors else config.profile(wanted-name).default-selectors
    .. wanted-name = profile-name ?? config.default-profile
for selector in unmatched-bench-selectors(cases, chosen)
    stderr <- "warning: $selector matched no benchmarks\n"
. selected = select-bench-cases(cases, chosen)
for line in bench-selection-lines(selected, shows-benchmarks)
    -- line
= if selected.length > 0 then 0 else 1

━━━━━━━━━━━━━━━━━━━━
_ do list-runs Int ?! Error
    - root String
    - profile-name String?

. config = load-bench-config(root)
. profile = config.profile(profile-name).name if profile-name
for line in bench-saved-run-lines(bench-saved-runs(root, profile), profile)
    -- line
= 0

━━━━━━━━━━━━━━━━━━━━
_ do run-benchmarks Int ?! Error
    - root String
    - selectors [String]
    - timeout U64
    - keeps Bool
    - profile-name String?
    - iterations Size?
    - warmup Size?
    - compare String?
    - save String?
    - reason String?
    - metrics String?

. config = load-bench-config(root)
. profile = config.profile(profile-name ?? config.default-profile)
. cases = discover-bench-cases(config)
. chosen = if selectors.length > 0 then selectors else profile.default-selectors
for selector in unmatched-bench-selectors(cases, chosen)
    stderr <- "warning: $selector matched no benchmarks\n"
. selected = select-bench-cases(cases, chosen)
?! Error("No benchmarks matched $chosen-text for profile ${profile.name}")
    if selected.length == 0
.. chosen-text = if chosen.length > 0 then ", ".join(chosen) else "all"
for note in bench-run-notes(profile, iterations, warmup)
    stderr <- "note: $note\n"
. info = bench-run-info
    - config
    - profile
    - chosen
    - timeout
    - keeps
    - "human"
    - iterations
    - warmup
    - compare
    - save
    - reason
. shown = bench-shown-metrics(profile, metrics)
. baseline = bench-baseline(root, info.compare-name)
. runner = use BenchRunner()
. session = BenchSession(selected.length)
do new
    for frame in runner.frames
        session.apply(frame.event)
        if session.is-complete
            break
runner.start(BenchOrder(1, info, selected))
do new
    for sig on sig-int
        if session.is-stopping
            request-process-termination(130)
        session.is-stopping = true
        runner.stop(1)
. is-live = C:isatty(1) == 1
-- bench-heading(info, selected.length)
. printed = 0
while !session.is-complete
    printed = print-finished(session, info, shown, baseline, printed, is-live)
    if is-live
        stdout <- "$bench-clear-line${bench-status-line(session, selected, info)}"
    bench-refresh.wait()
print-finished(session, info, shown, baseline, printed, is-live)
if is-live
    stdout <- bench-clear-line
for line in bench-summary-lines(session, info)
    -- line
. problem = session.problem
if problem
    stderr <- "error: $problem\n"
=? 130 if session.is-stopped
=? 1 if problem
for result in session.results
    =? 1 if !result || !result.is-passed
= 0

━━━━━━━━━━━━━━━━━━━━
_ do print-finished Size
    - session BenchSession
    - info BenchRunInfo
    - shown [Index]
    - baseline [String = JSON]
    - printed Size
    - is-live Bool

. next = printed
while next < session.results.length && session.results[next]
    next += 1
=? printed if next == printed
if is-live
    stdout <- bench-clear-line
for index in printed .. < next
    for line in bench-result-lines(session.results[index]!, info, shown, baseline)
        -- line
= next
