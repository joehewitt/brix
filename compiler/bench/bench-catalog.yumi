./bench-config
/os/file
/os/path
/stream/sort

+ bench-metadata-marker = "benchmark.meta"

━━━━━━━━━━━━━━━━━━━━
+ BenchCase is Tuple

+ suite BenchSuite
+ case-name String
+ id String
+ description String
+ tags [String]
+ timing String?
+ profiles [String]?
+ source-path String
+ relative-path String

━━━━━━━━━━━━━━━━━━━━
_ BenchMetadataLine is (key String, value String)

━━━━━━━━━━━━━━━━━━━━
+ do discover-bench-cases [BenchCase] ?! Error
    - config BenchConfig

. cases [BenchCase]
. sources [String = [String = String]]
for suite in config.suites
    for source-path in bench-files(suite)
        . within-suite = source-path[suite.path.length + 1 ...]
        . case-name = bench-without-extension(within-suite, suite.extensions)
        . id = "${suite.name}/$case-name"
        . known = sources[source-path]
        . metadata = if known then known else bench-metadata(read-file-text(Path(source-path, 0)))
        sources[source-path] = metadata
        . description = metadata["description"] ?? ""
        ?! Error("Benchmark $id is missing `$bench-metadata-marker description")
            if description == ""
        . timing = metadata["timing"]
        ?! Error("Invalid timing '${timing}' for benchmark $id")
            if timing && timing != "recommended" && timing != "not-recommended"
        . listed = metadata["profiles"]
        cases += BenchCase
            - suite
            - case-name
            - id
            - description
            - bench-commas(metadata["tags"] ?? "")
            - timing
            - bench-unique(bench-commas(listed)) if listed
            - source-path
            - if source-path.starts-with("${config.root}/") then relative-source else source-path
        .. relative-source = source-path[config.root.length + 1 ...]
= sort(cases) • using :: a, b => if a.id < b.id then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
+ do select-bench-cases [BenchCase]
    - cases [BenchCase]
    - selectors [String]

=? cases if selectors.length == 0
. normalized [String]
for selector in selectors
    normalized += bench-selector(selector)
. selected [BenchCase]
for bench in cases
    for selector in normalized
        if bench-case-matches(bench, selector)
            selected += bench
            break
= selected

━━━━━━━━━━━━━━━━━━━━
+ do unmatched-bench-selectors [String]
    - cases [BenchCase]
    - selectors [String]

. unmatched [String]
for selector in selectors
    . normalized = bench-selector(selector)
    . found = false
    for bench in cases
        if bench-case-matches(bench, normalized)
            found = true
            break
    if !found
        unmatched += selector
= unmatched

━━━━━━━━━━━━━━━━━━━━
+ bench-case-matches Bool
    - bench BenchCase
    - selector String

selector == bench.suite.name || selector == bench.id || selector == "${bench.id}$extension" || selector == bench.case-name || selector == file-name || selector == bench-selector(bench.relative-path) || selector == bench-selector(bench.source-path) || selector.ends-with("/${bench.id}") || selector.ends-with("/${bench.id}$extension")

.. extension = bench-extension(bench.relative-path)
.. file-name = bench-file-name(bench.relative-path)

━━━━━━━━━━━━━━━━━━━━
+ do bench-selector String
    - text String

. rest = text
while rest.starts-with("./")
    rest = rest[2 ...]
    while rest.starts-with("/")
        rest = rest[1 ...]
=? "." if rest == ""
. normalized = bench-normalized-path(rest)
= if normalized != "" then normalized else "."

━━━━━━━━━━━━━━━━━━━━
_ do bench-files [String] ?! Error
    - suite BenchSuite

. files [String]
. root = Path(suite.path, 0)
=? files if !root.exists
visit-bench-files(suite.path, suite.extensions, files)
= sort(files) • using :: a, b => if a < b then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
_ do visit-bench-files ?! Error
    - directory String
    - extensions [String]
    - files [String]

for entry in Path(directory, 0).entries
    if entry.name == "." || entry.name == ".."
        continue
    . path = "$directory/${entry.name}"
    if entry.kind == PathKind.directory
        visit-bench-files(path, extensions, files)
    else if entry.kind == PathKind.file
        for extension in extensions
            if entry.name.ends-with(extension)
                files += path
                break

━━━━━━━━━━━━━━━━━━━━
_ do bench-metadata [String = String] ?! Error
    - source String

. fields [String = String]
for line in source.split("\n")
    . parsed = bench-metadata-line(line)
    if parsed
        fields[parsed.key] = parsed.value
= fields

━━━━━━━━━━━━━━━━━━━━
_ do bench-metadata-line BenchMetadataLine? ?! Error
    - line String

=? null if !line.starts-with("`") && !line.starts-with(";")
. comment = line[1 ...]
. start = 0
while start < comment.length && (comment[start] == ' ' || comment[start] == '\t')
    start += 1
. text = comment[start ...]
=? null if !text.starts-with(bench-metadata-marker)
. body = text[bench-metadata-marker.length ...].trim()
. colon = body.find(":")
?! Error("Invalid benchmark metadata line: $line")
    if !colon
= BenchMetadataLine(body[0 .. < colon].trim(), body[colon + 1 ...].trim())

━━━━━━━━━━━━━━━━━━━━
_ do bench-without-extension String
    - path String
    - extensions [String]

for extension in extensions
    =? path[0 .. < path.length - extension.length] if path.ends-with(extension)
= path

━━━━━━━━━━━━━━━━━━━━
+ bench-file-name String
    - path String

if slash then path[slash + 1 ...] else path

.. slash = path.find("/", 0, true)

━━━━━━━━━━━━━━━━━━━━
+ bench-extension String
    - path String

if dot && dot > 0 then name[dot ...] else ""

.. name = bench-file-name(path)
.. dot = name.find(".", 0, true)

━━━━━━━━━━━━━━━━━━━━
_ do bench-unique [String]
    - values [String]

. unique [String]
for value in values
    if !(unique has value)
        unique += value
= unique
