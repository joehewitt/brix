_ tool-names [String] = ["probes", "test", "bench", "lint"]
_ guide-index Path := toolchain-root / "docs/index.md"

set-minimum-heap-goal(256 * 1048576)
request-process-termination
    - run-tool(cmdline-args()) ?? run-init(cmdline-args()) ?? CompilerCommand().run()

━━━━━━━━━━━━━━━━━━━━
+ BatchManifest

` The cases of a batch as a test runner lists them: the file the runtime marks each case in as it
` starts and finishes, the files the cases print to, and for each case its id, the directory it
` runs in, and its source with the name of its module.

+ control = ""
+ output = ""
+ errors = ""
+ ids [String]
+ directories [String]
+ roots [(String, String)]

━━━━━━━━━━━━━━━━━━━━
+ do read-batch-manifest BatchManifest ?! Error
    - path String?

` Reads a manifest of a batch: a first line of its control, output and error files, then a line
` for each case of its id, its directory and the path of its source, each split by tabs. The
` module of a case is named by its place in the batch. Without a manifest there is no batch.
if !path
    = BatchManifest()
. file = use File(path)
. lines [String] = (file as String).split("\n")
. files [String] = lines[0].split("\t")
?! Error("A batch manifest begins with its control, output and error files")
    if files.length != 3
. manifest = BatchManifest()
manifest.control = files[0]
manifest.output = files[1]
manifest.errors = files[2]
for position in 1 .. < lines.length
    if lines[position].length == 0
        continue
    . fields [String] = lines[position].split("\t")
    ?! Error("A case of a batch manifest names its id, its directory and its source")
        if fields.length != 3
    manifest.ids += fields[0]
    manifest.directories += fields[1]
    manifest.roots += (fields[2], "__test__/t${(manifest.roots.length as Int).pad(6)}/__source__")
?! Error("A batch manifest names no case")
    if !manifest.roots
= manifest

━━━━━━━━━━━━━━━━━━━━
+ do load-program Program
    - yumi YumiCompiler
    - manifest BatchManifest
    - source-path String?
    - code String?

` The program a command names: the cases of a batch, or one source, read from its path or given
` as `code`.
=? yumi.batch-to-ast(manifest.roots) if manifest.roots
= yumi.source-to-ast(source-path ?? "", "__source__", code)

━━━━━━━━━━━━━━━━━━━━
_ CompilerCommand is CommandLine

+ modules ModuleView?
+ lowerings BackendCache?
+ emissions EmissionMemory?
+ typings KeptTyping?
+ is-served = false

────────────────────

<This
    name = "yumi"
    about = "Check a Yumi program, or build it with -o and run it with the arguments after its source.\n\nBefore writing Yumi, read $guide-index, an index of the guides, the standard library and the examples."

    <Argument source "path.yumi"
        about = "the program to check, build or run"
    <Arguments passed "args"
        about = "the program's arguments; after --, they may start with -"
    <Flag shows-version "--version"
        aliases = ["-v"]
        about = "print the release this compiler came in, or the commit a local build is of"

    <OptionGroup "build"
        <Option executable "-o"
            aliases = ["--o"]
            value-name = "PATH"
            about = "build the executable at PATH and run it; without -o or --probes the program is only checked"
        <Flag compiles "--compile"
            about = "build with -o but do not run"
        <Flag claims-documents "--claims-documents"
            about = "make the app bundle claim its DocumentType files, so the OS opens them with it; give it only to the build that gets installed, since a launched bundle stays registered"
        <Flag stops-at-object "--object-only"
            about = "write the object file at -o PATH and stop, without linking or running"
        <Flag reached-only "--reached-only"
            about = "without -o, check only what the program reaches, as a build does; a check otherwise also types what the source declares that nothing reaches"
        <Option built "--run"
            value-name = "PATH"
            about = "run a program built with --compile -o PATH, installing it on its simulator or device first"
        <Option device "--device"
            value-name = "NAME"
            about = "the simulator or device an iOS program runs on, by name or id; the first --list-devices lists by default"
        <Flag lists-devices "--list-devices"
            about = "list the simulators or devices of --target, one JSON line each, in the order a run picks from"
        <Option code "-c"
            aliases = ["--c"]
            value-name = "SOURCE"
            about = "the program's source text in place of a file"
        <Option target-name "--target"
            value-name = "NAME"
            choices = each.name in targets()
            default = host-target().name
            about = "the platform to build for: ${", ".join(each.name in targets())}"
        <Option c-header-snapshot "--c-headers"
            value-name = "PATH"
            about = "read the C headers from the snapshot at PATH, which --record-c-headers wrote, in place of the target's SDK or sysroot"
        <Option c-header-recording "--record-c-headers"
            value-name = "PATH"
            about = "write a snapshot at PATH of the C headers the build reads, for a host without the target's SDK to build as this one does"
        <Option'Int workers "--workers"
            value-name = "N"
            about = "threads for typing and emission"
        <Flag unoptimized "--unoptimized"
            about = "build without optimizing"
        <Flag warns "--warnings"
            about = "report warnings"
        <Flag verifies-reuse "--verify-reuse"
            about = "in the build daemon, emit, inline and lower each function a build would reuse, and fail where they differ"
        <Option batch-path "--batch"
            hidden = true
        <Flag debugs "--debug"
            hidden = true
        <Flag serves "--serve"
            hidden = true
            about = "answer build and analysis requests on stdin, one JSON-RPC line each, keeping what each parse and each lowered function makes"
        <Flag debug-intrinsics "--compiler-debug-intrinsics"
            aliases = ["--compilerDebugIntrinsics"]
            hidden = true

    <OptionGroup "probes"
        <Options probes "--probes"
            needs-value = false
            value-name = "SELECTORS"
            parser = :: text => text if is-selector-list(text)
            about = "compile probes in, run, and record the trace in .tmp/build/probes/; without -o, the executable is built at .tmp/build/probes/bin/NAME; with no selectors, every probe in the source and every probe with no key"
        <Option'Seconds time-limit "--timeout"
            value-name = "D"
            parser = :: text => parse-timeout(text)
            about = "stop the program after D (500ms, 30s, 2m) and exit with 124"
        <Option trace-path "--trace"
            value-name = "PATH"
            about = "where to write the trace"
        <Flag quiet-probes "--quiet-probes"
            about = "print only the footer, not each probe line"

    <OptionGroup "inspection"
        <Flag dumps-ir "--dump-ir"
            about = "print the IR of each function to stderr as it builds"
        <Option inspection "--inspect"
            choices = ["ir", "emitted"]
            about = "print the IR to stderr without building; ir adds each backend stage, emitted does not"
        <Flag lists-sources "--list-sources"
            about = "list the modules the program loads"
        <Option explained "--explain"
            value-name = "FUNCTION"
            about = "print what the compiler inferred about a function: a name, Type.method, path:name, or file:line"
        <Flag lists-probes "--list-probes"
            about = "list each probe the program writes, as a JSON line of its key, kind, path and line"
        <Flag timings "--timings"
            about = "print the time each phase takes"
        <Option link-record "--link-record"
            value-name = "PATH"
            about = "write the link command as JSON to PATH"

    <HelpTopic "probe selectors, joined by commas or spaces in one argument"
        <HelpEntry "key, key.*"
            about = "a key and the keys inside it"
        <HelpEntry "log:, log:key"
            about = "logs with no key, or logs under a key"
        <HelpEntry "counter:*"
            about = "every counter"
        <HelpEntry "profile:key"
            about = "counters and groups without text as metrics, no records"
        <HelpEntry "gc"
            about = "the collector's cycles, pauses and assist time"
        <HelpEntry "*"
            about = "every probe"

    <HelpTopic "tools"
        <HelpEntry "yumi init [folder]"
            about = "write the AGENTS.md section and CLAUDE.md import that send agents to these guides"
        <HelpEntry "yumi probes --help"
            about = "query the trace of a run: summary, log, agg, durations, tree, timeline, outliers"
        <HelpEntry "yumi test --help"
            about = "run the test modules in the tests folders of a project, or the suites .yumi/tests.json defines"
        <HelpEntry "yumi bench --help"
            about = "build, measure and compare the benchmarks in the bench folders of a project"
        <HelpEntry "yumi lint --help"
            about = "lint Yumi files, or apply the fixes their rules make safely"

    <HelpTopic "bin/yumi"
        <HelpEntry "--compiler-probes [SELECTORS]"
            about = "build the compiler with these probes and record its run"

────────────────────
+ do main Int ?! Error

=? serve() if serves.value
=? show-version() if shows-version.value
=? introduce() if cmdline-args().length < 2
?! UsageError("missing <path.yumi>", this)
    if !source-path && !code.value && !batch-path.value && !built.value && !lists-devices.value
?! UsageError("--trace and --quiet-probes need --probes", this)
    if !probes.is-given && (trace-path.value || quiet-probes.value)
?! UsageError("--compile needs -o PATH for the executable", this)
    if compiles.value && !executable.value && !batch-path.value
?! UsageError("--object-only needs -o PATH for the object", this)
    if stops-at-object.value && !executable.value
?! UsageError("The build service builds with --compile or checks without -o, and runs no program", this)
    if is-served && runs-program
=? list-devices() if lists-devices.value
=? run-built-program(built.value, program-arguments, chosen-device) if built.value
= check()

────────────────────
_ get source-path String?

source.value if !code.value && !built.value

────────────────────
_ get program-arguments [String]

** leading
** passed.values

.. leading [String] = if source.value && !source-path then [source.value] else List'String()

────────────────────
_ get runs-program Bool

built.value || (!stops-early && (executable.value || probes.is-given))

.. stops-early = compiles.value || stops-at-object.value || batch-path.value || inspection.value || is-listing || explained.value
.. is-listing = lists-sources.value || lists-probes.value || lists-devices.value

────────────────────
_ get chosen-device String?

device.value if device.value != ""

────────────────────
_ get types-unreached Bool

is-check-only && inspection.value == null && !batch-path.value && !reached-only.value

.. is-check-only = !executable.value && !probes.is-given

────────────────────
_ do introduce Int

stdout <- "$usage\n\n$about\n\nrun `yumi --help` for its options\n"
= 0

────────────────────
_ do show-version Int

-- version-text()
= 0

────────────────────
_ do explain Int
    - program Program
    - session Session
    - asked String

. root = source-module(program)
. ref = explained-function(program, root, asked)
    catch error ExplainError
        stderr <- "${error.message}\n"
        = 1
. holder = program.modules[ref.module]
. read = catch? source-text(holder.path)
-- explain-function(session, root, ref, read ?? "")
= 0

────────────────────
_ do list-devices Int ?! Error

. target = target-named(target-name.value!)!
for record in device-records(target, yumi-build-path / "devices")
    -- record
= 0

────────────────────
_ do check Int ?! Error

. yumi YumiCompiler
yumi.modules = modules
yumi.probes = ProbeSelection(probes.is-given, " ".join(probes.values), ["__source__"])
yumi.search-paths = module-search-paths()

. target = target-named(target-name.value!)!
?! UsageError("--probes and --timeout need a target that runs on this machine", this)
    if (probes.is-given || time-limit.value) && !target.runs-on-host
yumi.target = target
. recording = chosen-c-headers(yumi, target)
    catch error Error
        stderr <- "$error.message\n"
        = 1
. started = clock()
//+compiler.phase.parse
. manifest = read-batch-manifest(batch-path.value)
    catch error Error
        stderr <- "$error.message\n"
        = 1
. program = load-program(yumi, manifest, source-path, code.value)
    catch error YumiSyntaxError
        -- error.exception-text
        = diagnostic-status
    catch error Error
        stderr <- "$error.message\n"
        = 1
if recording
    recording.write(Path(c-header-recording.value!))
        catch error Error
            stderr <- "$error.message\n"
            = 1
if lists-sources.value || lists-probes.value
    for module in program.modules
        if lists-sources.value
            -- module.path
        else
            for line in probe-lines(module.tree, module.path)
                -- line
    program.release()
    = 0

//-compiler.phase.parse
. parse-time = started.elapsed'Microseconds()
. typing-started = clock()
//+compiler.phase.typing
. kept = typings ?? KeptTyping()
do finally
    if !typings
        kept.release()
. session = kept.typed
    - typing-key()
    - program
    - workers.value ?? default-worker-count
    - types-unreached
//-compiler.phase.typing
. typing-time = typing-started.elapsed'Microseconds()

. text = FactsText(session, yumi.search-paths)
. reported = text.reported-entries(diagnostic-limit)
if reported.length != 0
    -- "\n\n".join(reported)
    = diagnostic-status
. asked = explained.value
if asked
    = explain(program, session, asked)
. product = read-product(program, session.types, target)
    catch error ProductError
        -- error.message
        = diagnostic-status
. inspects = inspection.value != null
. output = output-path(inspects)
    catch error Error
        stderr <- "$error.message\n"
        = 1
if !output && !inspects
    = 0

. emission = EmissionOptions()
emission.object-path = if !output then "" else if stops-at-object.value then output else "${output}.o"
emission.catalog-path = if output && !inspects then "${output}.probes.json" else ""
emission.writes-object = !inspects
emission.batch-control = manifest.control
emission.batch-output = manifest.output
emission.batch-errors = manifest.errors
emission.batch-ids = manifest.ids
emission.batch-directories = manifest.directories
emission.dumps-ir = dumps-ir.value || inspects
emission.dumps-stages = dumps-ir.value || inspection.value == "ir"
emission.warns = warns.value
emission.optimizes = !unoptimized.value
if workers.value
    emission.worker-count = workers.value
emission.backend-cache = lowerings
emission.memory = emissions
emission.verifies-reuse = verifies-reuse.value
emit-program(program, session.instances, session.facts, session.types, session.bindings, emission)
    catch error Error
        stderr <- "$error.message\n"
        = 1
if inspects || batch-path.value || compiles.value || stops-at-object.value
    for selector in emission.unmatched-probes
        stderr <- "warning: --probes selector $selector matched no probe sites\n"
if !typings
    program.release-trees()
    session.release-typing()
if inspects || stops-at-object.value
    = 0
. link-started = clock()
//+compiler.phase.link
. plan = link-plan(program, emission.object-path, output!, target)
    catch error Error
        stderr <- "$error.message\n"
        = 1
modules?.note-files(plan.inputs)
link-executable(plan, link-record.value)
    catch error Error
        stderr <- "$error.message\n"
        = 1
//-compiler.phase.link
if timings.value
    . link-time = link-started.elapsed'Microseconds()
    stderr <- "parse $parse-time\ntyping $typing-time\nprogram-tables $emission.tables-time\n"
    stderr <- "round $emission.round-time\nmerge $emission.merge-time\nobject $object-time\n"
        .. object-time = emission.object-time
    stderr <- "link $link-time\ntotal ${started.elapsed'Microseconds()}\n"
    if typings
        stderr <- "kept ${kept.refusal ?? "retyped"}\n"
    if lowerings
        stderr <- "reused ${lowerings.hits} of ${lowerings!.hits + lowerings!.misses}\n"
    if emissions
        stderr <- "uninlined ${emissions.reused}\nverified ${emissions!.verified}\n"
if batch-path.value
    = 0
. packaged = package-program(output!, target, product, claims-documents.value)
    catch error Error
        stderr <- "$error.message\n"
        = 1
if compiles.value
    = 0
. arguments = program-arguments
if !probes.is-given && !time-limit.value
    . status = run-program(packaged, target, arguments, chosen-device)
        catch error Error
            stderr <- "$error.message\n"
            = 1
    = status
. command-arguments = packaged.command[1 ...]
command-arguments ++= arguments
. supervised = ProbeRun(packaged.command[0], command-arguments)
supervised.timeout = time-limit.value
. traces = yumi-probes-path
if probes.is-given
    if trace-path.value
        supervised.trace-path = trace-path.value
    else
        . chosen = new-trace-path(traces, Path(output!).name)
            catch error Error
                stderr <- "$error.message\n"
                = 1
        supervised.trace-path = chosen as String
    supervised.catalog-path = emission.catalog-path
    supervised.shows-lines = !quiet-probes.value
    supervised.unmatched = emission.unmatched-probes
. exit-code = supervised.run()
    catch error Error
        stderr <- "$error.message\n"
        = 1
if probes.is-given
    catch write-last-run(traces, supervised, exit-code)
= exit-code

────────────────────
_ do chosen-c-headers CHeaderSnapshot? ?! Error
    - yumi YumiCompiler
    - target Target

` Points `yumi` at the snapshot --c-headers names, or at the target's headers with a recording for
` --record-c-headers, which it gives back to be written once the program is read.
?! UsageError("--c-headers and --record-c-headers cannot be given together", this)
    if c-header-snapshot.value && c-header-recording.value
if c-header-snapshot.value
    . snapshot = read-c-header-snapshot(Path(c-header-snapshot.value))
    ?! Error("$snapshot-path is a snapshot of $snapshot-target headers, not ${target.name}")
        if snapshot.target-name != target.name
    .. snapshot-path = c-header-snapshot.value
    .. snapshot-target = snapshot.target-name
    yumi.c-headers = CHeaders(target.name, snapshot.c-root, List'String(), snapshot)
    = null
if !c-header-recording.value
    = null
. headers = target-c-headers(target)
. recording = CHeaderSnapshot(target.name, headers.c-root)
yumi.c-headers = CHeaders(headers.target-name, headers.c-root, headers.arguments, null, recording)
= recording

────────────────────
_ do serve Int ?! Error

. search-paths = module-search-paths()
. cache = use ModuleCache()
. view = use cache.view()
. store = use ProgramStore(search-paths, cache)
. lowerings = use BackendCache()
. emissions = use EmissionMemory()
. typings = use KeptTyping(view)
. builds = ServedBuilds(name, view, lowerings, emissions, typings)
. daemon = BuildDaemon(AnalysisService(store), view, search-paths, builds.run)
daemon.rest = builds.rest
= daemon.serve()

────────────────────
_ typing-key String

"${source-path ?? ""}|${target-name.value ?? ""}|${code.value ?? ""}|${batch-path.value ?? ""}|${probes.is-given} ${" ".join(probes.values)}|${toolchain-env("PATH") ?? ""}|$types-unreached"

────────────────────
_ do output-path String? ?! Error
    - inspects Bool

. given = executable.value
if given && !inspects
    Path(given).parent?.make-directories()
=? given if given || !probes.is-given || inspects || batch-path.value
. directory = yumi-probes-path
(directory / "bin").make-directories()
. base = if source-path then Path(source-path!).base-name else "program"
= (directory / "bin" / base) as String

━━━━━━━━━━━━━━━━━━━━
_ ServedBuilds

+ name String
+ modules ModuleView
+ lowerings BackendCache
+ emissions EmissionMemory
+ typings KeptTyping

────────────────────
+ This
    - name String
    - modules ModuleView
    - lowerings BackendCache
    - emissions EmissionMemory
    - typings KeptTyping

────────────────────
+ do run BuildResult
    - arguments [String]

. result = catch captured(arguments)
=? BuildResult(1, "${(result as Error).message}\n", null) if result is Error
= result

────────────────────
+ do rest

typings.release()
collect-garbage()
return-free-memory()

────────────────────
_ do captured BuildResult ?! Error
    - arguments [String]

. command = CompilerCommand()
command.modules = modules
command.lowerings = lowerings
command.emissions = emissions
command.typings = typings
command.is-served = true
. given [String]
given += name
given ++= arguments
. capture = Path("${env("TMPDIR") ?? "/tmp"}/yumi-serve-${C:getpid()}.out")
. file = File
    - capture as String
    - FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
    - user-read-perm + user-write-perm
. saved-output = C:dup(1)
. saved-errors = C:dup(2)
C:dup2(file.fd, 1)
C:dup2(file.fd, 2)
. ran = catch command.respond(given)
if !(ran is Error) && ran as Int == 0
    modules.finish-round()
modules.settle()
C:dup2(saved-output, 1)
C:dup2(saved-errors, 2)
C:close(saved-output)
C:close(saved-errors)
file.close()
. output = read-file-text(capture)
capture.delete()
collect-garbage()
return-free-memory()
=? BuildResult(1, "$output${(ran as Error).message}\n", command.executable.value) if ran is Error
= BuildResult(ran, output, command.executable.value)

━━━━━━━━━━━━━━━━━━━━
_ do run-tool Int?
    - argv [String]

. name = if argv.length > 1 then argv[1] else ""
=? null if !(some(tool-names) • where each == name)
. tool = (toolchain-root / "bin" / "yumi-$name") as String
. arguments = String[argv.length]
arguments[0] = tool
for index in 2 .. < argv.length
    arguments[index - 1] = argv[index]
C:execv(tool, arguments)
stderr <- "yumi $name is not in this toolchain: $tool does not run\n"
= 1

━━━━━━━━━━━━━━━━━━━━
_ do run-init Int?
    - argv [String]

=? null if argv.length < 2 || argv[1] != "init"
= InitCommand().respond(argv[1 ...])

━━━━━━━━━━━━━━━━━━━━
_ do is-selector-list Bool
    - text String

=? false if text.length == 0 || text.starts-with("-") || source-stem(text) != null
for char in text
    . allowed = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || (char >= '0' && char <= '9')
    =? false if !allowed && char != '.' && char != '*' && char != ':' && char != ',' && char != '-' && char != '_' && char != ' '
= true

━━━━━━━━━━━━━━━━━━━━
_ do probe-lines [String]
    - tree AST
    - path String

. lines [String]
for id in 1u32 .. < tree.nodes.length
    . kind = probe-kind(tree, id as SyntaxId)
    if kind
        . entry = Map'String'JSON
            • "key" probe-key(tree, id as SyntaxId) as JSON
            • "kind" kind as JSON
            • "path" path as JSON
            • "line" ((tree.nodes.loc[id].begin.line + 1) as Int) as JSON
        lines += to-json(entry as JSON)
= lines

━━━━━━━━━━━━━━━━━━━━
_ do probe-kind String?
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-probe(row)
        = if row.name then "event" else "log"
    | .node-probe-group(row)
        =? null if row.is-end
        = if row.is-data then "data" else "group"
    | .node-probe-counter(row)
        = "counter"
    | .node-probe-assign(row)
        = "property"
    | .node-probe-statement(row)
        = "statement"
= null

━━━━━━━━━━━━━━━━━━━━
_ do probe-key String
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-probe(row)
        = if row.key then row.key.text else ""
    | .node-probe-group(row)
        = if row.key then row.key.text else ""
    | .node-probe-counter(row)
        = row.key.text
    | .node-probe-assign(row)
        = row.key.text
    | .node-probe-statement(row)
        = if row.key then row.key.text else ""
= ""

━━━━━━━━━━━━━━━━━━━━
_ do source-module ModuleId
    - program Program

for position in 0 .. < program.modules.length
    =? position as ModuleId if program.modules[position].name == "__source__"
= 0

━━━━━━━━━━━━━━━━━━━━
_ do source-text String ?! Error
    - path String

. file = use File(path)
= file as String
