./commands
./options
./query
/os/cli
/probes/supervise
/time/duration

request-process-termination(ProbesTool().run())

━━━━━━━━━━━━━━━━━━━━
_ ProbesTool is CommandLine

────────────────────

<This
    name = "brix probes"
    about = "Query the probe trace of a run. A run is recorded each time a program runs with `brix x.yumi -o out --probes` or `brix probes run`. A trace is the last run's by default, or a .trace file or .run.json record from .tmp/build/probes/."

    <Subcommand "summary"
        about = "records, groups by time, counters and the busiest sites"
        action = => summary(query([summary-trace.value!]))

        <Argument summary-trace "trace"
            default = "last"

    <Subcommand "sites"
        about = "each probe site with its fields, location and record count"
        action = => sites(query([sites-trace.value!]), sites-all.value)

        <Argument sites-trace "trace"
            default = "last"
        <Flag sites-all "--all"
            about = "also list the sites that wrote no records"

    <Subcommand "log"
        about = "records in order, filtered"
        action = => log(query([log-trace.value!]))

        <Argument log-trace "trace"
            default = "last"

    <Subcommand "around"
        about = "records around a record index (120) or a time (1.5s)"
        action = => around(query([around-target.value!, around-trace.value!]), around-context.value)

        <Argument around-target "index|time"
            required = true
        <Argument around-trace "trace"
            default = "last"
        <Option'Size around-context "--context"
            value-name = "N"
            about = "records shown on each side (10 by default)"

    <Subcommand "agg"
        about = "statistics of a field, such as agg --field ms p50,p95,max --by frame"
        action = => agg(query(agg-operands.values), split-list(agg-stats.value), agg-field.value, agg-by.value)

        <Arguments agg-operands "stats|trace"
            about = "statistics joined by commas, or the trace"
        <Option agg-field "--field"
            value-name = "NAME"
            about = "the field to aggregate"
        <Option agg-by "--by"
            value-name = "NAME"
            about = "group the statistics by a field"
        <Option agg-stats "--stats"
            value-name = "STATS"
            about = "count, sum, min, max, mean, median or pNN, joined by commas"
            parser = :: text => text if is-stat-list(text)

    <Subcommand "durations"
        about = "group times by group: count, total, mean, p50, p95, max"
        action = => durations(query([durations-trace.value!]))

        <Argument durations-trace "trace"
            default = "last"

    <Subcommand "tree"
        about = "nested group time as a tree with total and self time"
        action = => tree(query([tree-trace.value!]), tree-depth.value)

        <Argument tree-trace "trace"
            default = "last"
        <Option'Size tree-depth "--depth"
            value-name = "N"
            about = "the deepest groups shown"

    <Subcommand "counters"
        about = "counter values and profile metrics"
        action = => counters(query([counters-trace.value!]))

        <Argument counters-trace "trace"
            default = "last"

    <Subcommand "timeline"
        about = "records per bucket as sparklines; with --field, a statistic of it"
        action = => timeline(query([timeline-trace.value!]), split-list(timeline-stats.value), timeline-bucket.value, timeline-field.value)

        <Argument timeline-trace "trace"
            default = "last"
        <Option'U64 timeline-bucket "--bucket"
            value-name = "D"
            about = "the time each column covers, such as 10ms"
            parser = :: text => duration-of(text)
        <Option timeline-field "--field"
            value-name = "NAME"
            about = "chart a statistic of this field in place of the record count"
        <Option timeline-stats "--stats"
            value-name = "STAT"
            about = "the statistic charted: count, sum, min, max, mean, median or pNN"
            parser = :: text => text if is-stat-list(text)

    <Subcommand "outliers"
        about = "slowest groups, or largest values of a field, against the median"
        action = => outliers(query([outliers-trace.value!]), outliers-field.value, outliers-context.value)

        <Argument outliers-trace "trace"
            default = "last"
        <Option outliers-field "--field"
            value-name = "NAME"
            about = "rank records by this field in place of group time"
        <Option'Size outliers-context "--context"
            value-name = "N"
            about = "records shown around each outlier"

    <Subcommand "diff"
        about = "changes in records per site, group times and counters"
        action = => diff(query([diff-old.value!, diff-new.value!]), diff-all.value)

        <Argument diff-old "a"
            required = true
        <Argument diff-new "b"
            required = true
        <Flag diff-all "--all"
            about = "also list what did not change"

    <Subcommand "run"
        about = "run a program built with --probes and record its trace: run -- program [args]"
        action = => run-program(run-command.values, run-quiet.value, run-timeout.value, run-trace.value)

        <Arguments run-command "command"
            required = true
        <Option'Seconds run-timeout "--timeout"
            value-name = "D"
            about = "stop the program after D (500ms, 30s, 2m), then kill it after a grace period"
            parser = :: text => parse-timeout(text)
        <Option run-trace "--trace"
            value-name = "PATH"
            about = "where to write the trace; .tmp/build/probes/ by default"
        <Flag run-quiet "--quiet"
            about = "show only the footer, not each probe line"

    <OptionGroup "filters"
        <Options keys "--key"
            value-name = "K[,K]"
            about = "key globs (gui.*, *.frame); a plain key also matches keys inside it"
        <Options wheres "--where"
            value-name = "EXPR"
            about = "comparisons of fields joined by &&: 'ms > 4 && frame < 10'; also duration, time, depth, index, key, label, text, location"
        <Options texts "--text"
            value-name = "S"
            about = "the record's text contains S"
        <Options sources "--source"
            value-name = "F[:L]"
            about = "records written at a file, or a file and line"
        <Option'U64 since "--since"
            value-name = "D"
            about = "time from the first record: 250us, 100ms, 1.5s"
            parser = :: text => duration-of(text)
        <Option'U64 until "--until"
            value-name = "D"
            about = "time from the first record"
            parser = :: text => duration-of(text)
        <Options kinds "--kind"
            value-name = "K[,K]"
            about = "log, event, group, begin, end, system, or open for groups that never ended"

    <OptionGroup "output"
        <Option'Size limit "--limit"
            value-name = "N"
            about = "page through results; text output is capped and says how to see more"
        <Option'Size offset "--offset"
            value-name = "N"
        <Option format "--format"
            choices = ["text", "json", "jsonl"]
            default = "text"
            about = "machine-readable output"
        <Option catalog "--catalog"
            value-name = "PATH"
            about = "the catalog that names fields; found next to the trace by default"

────────────────────
_ do query ProbeQuery ?! UsageError
    - positionals [String]

. made = ProbeQuery()
made.positionals = positionals
made.catalog = catalog.value
made.output.format = format.value!
made.output.limit = limit.value
made.output.offset = offset.value ?? 0
made.filter.earliest = since.value
made.filter.latest = until.value
for text in texts.values
    made.filter.texts += text
for list in keys.values
    for key in split-list(list)
        made.filter.keys += key
for list in sources.values
    for source in split-list(list)
        made.filter.sources += source
for list in kinds.values
    made.filter.add-kinds(list)
        catch error Error
            ?! UsageError(error.message, this)
for clause in wheres.values
    made.filter.add-where(clause)
        catch error Error
            ?! UsageError(error.message, this)
= made
