./model
./query
./stats
/probes/model
/stream/sort

━━━━━━━━━━━━━━━━━━━━
+ GroupSummary

+ label = ""
+ location = ""
+ stats = Stats()
+ unended Size = 0

━━━━━━━━━━━━━━━━━━━━
+ do group-summaries [GroupSummary]
    - trace ProbeTrace
    - filter RowFilter

. found [String = GroupSummary]
for row in trace.rows
    if row.kind != TraceRowKind.begin || !filter.accepts(row)
        continue
    . summary = found[row.label] ?? new-summary(row)
    found[row.label] = summary
    if row.duration
        summary.stats.add(row.duration as F64)
    else
        summary.unended += 1
= sort(found.values) • using :: a, b => if a.stats.sum > b.stats.sum then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
_ do new-summary GroupSummary
    - row TraceRow

. summary = GroupSummary()
summary.label = row.label
summary.location = row.location
= summary

━━━━━━━━━━━━━━━━━━━━
+ TreeNode

+ path = ""
+ label = ""
+ parent = ""
+ depth Size = 0
+ count Size = 0
+ total U64
+ own U64
+ children [TreeNode]

━━━━━━━━━━━━━━━━━━━━
+ do group-tree [TreeNode]
    - trace ProbeTrace
    - filter RowFilter

. nested [Size = U64]
for row in trace.rows
    if row.kind == TraceRowKind.begin && row.parent && row.duration
        nested[row.parent!] = (nested[row.parent] ?? 0u64) + row.duration!
. paths [Size = String]
. nodes [String = TreeNode]
. order [String]
for row in trace.rows
    if row.kind != TraceRowKind.begin
        continue
    . above = ""
    if row.parent
        above = paths[row.parent] ?? ""
    . path = if above != "" then "$above › ${row.label}" else row.label
    paths[row.index] = path
    if !row.duration || !filter.accepts(row)
        continue
    . node = nodes[path] ?? TreeNode()
    if node.path == ""
        node.path = path
        node.label = row.label
        node.parent = above
        node.depth = row.depth
        nodes[path] = node
        order += path
    node.count += 1
    node.total += row.duration!
    . inside = nested[row.index] ?? 0u64
    node.own += if row.duration! > inside then row.duration! - inside else 0u64
. roots [TreeNode]
for path in order
    . node = nodes[path]!
    . owner = nodes[node.parent]
    if owner
        owner.children += node
    else
        roots += node
. flat [TreeNode]
flatten(roots, flat)
= flat

━━━━━━━━━━━━━━━━━━━━
_ do flatten
    - nodes [TreeNode]
    - flat [TreeNode]

. ordered = sort(nodes) • using :: a, b => if a.total > b.total then .lesser else .greater
for node in ordered
    flat += node
    flatten(node.children, flat)

━━━━━━━━━━━━━━━━━━━━
+ FieldGroup

+ name = ""
+ number F64?
+ stats = Stats()

━━━━━━━━━━━━━━━━━━━━
+ do field-groups [FieldGroup]
    - trace ProbeTrace
    - filter RowFilter
    - field String
    - group-by String?

. found [String = FieldGroup]
for row in trace.rows
    if !filter.accepts(row)
        continue
    . value = datum-number(field-datum(row, field))
    if !value
        continue
    . datum = field-datum(row, group-by) if group-by
    if group-by && !datum
        continue
    . name = if group-by then datum-text(datum) else "all"
    . group = found[name] ?? FieldGroup()
    if group.name == ""
        group.name = name
        group.number = datum-number(datum) if group-by
        found[name] = group
    group.stats.add(value)
. groups [FieldGroup]
. numeric = true
for _, group in found
    groups += group
    if !group.number
        numeric = false
if numeric && group-by
    = sort(groups) • using :: a, b => if a.number! < b.number! then .lesser else .greater
= sort(groups) • using :: a, b => if a.stats.count > b.stats.count || (a.stats.count == b.stats.count && a.name < b.name) then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
+ Series

+ label = ""
+ count Size = 0
+ buckets [F64]
+ stats [Stats]

━━━━━━━━━━━━━━━━━━━━
+ do timeline-series [Series]
    - trace ProbeTrace
    - filter RowFilter
    - bucket U64
    - stat String
    - field String?

. width = (trace.span / bucket + 1) as Size
. found [String = Series]
for row in trace.rows
    if row.kind == TraceRowKind.end || !filter.accepts(row)
        continue
    . value F64? = 1.0
    if field
        value = datum-number(field-datum(row, field))
    if !value
        continue
    . series = found[row.label] ?? new-series(row.label, width)
    found[row.label] = series
    series.count += 1
    . slot = (row.time / bucket) as Size
    series.stats[if slot < width then slot else width - 1].add(value)
. ordered = sort(found.values) • using :: a, b => if a.count > b.count then .lesser else .greater
for series in ordered
    for index in 0 .. < width
        . stats = series.stats[index]
        series.buckets += stats.stat(stat) ?? 0.0
= ordered

━━━━━━━━━━━━━━━━━━━━
_ do new-series Series
    - label String
    - width Size

. series = Series()
series.label = label
for _ in 0 .. < width
    series.stats += Stats()
= series

━━━━━━━━━━━━━━━━━━━━
+ do nice-bucket U64
    - span U64
    - columns U64

. wanted = span / columns + 1
for step in [1u64, 2u64, 5u64]
    . scale = 1u64
    while scale < 100000000000
        . size = step * scale
        if size >= wanted && is-smallest(size, wanted)
            = size
        scale *= 10
= wanted

━━━━━━━━━━━━━━━━━━━━
_ do is-smallest Bool
    - size U64
    - wanted U64

for step in [1u64, 2u64, 5u64]
    . scale = 1u64
    while scale < 100000000000
        . other = step * scale
        if other >= wanted && other < size
            = false
        scale *= 10
= true

━━━━━━━━━━━━━━━━━━━━
+ Outlier

+ row TraceRow
+ value F64
+ median F64

────────────────────
+ This
    - row TraceRow
    - value F64
    - median F64

━━━━━━━━━━━━━━━━━━━━
+ do find-outliers [Outlier]
    - trace ProbeTrace
    - filter RowFilter
    - field String?

. populations [String = Stats]
. candidates [Outlier]
for row in trace.rows
    if !filter.accepts(row)
        continue
    . value F64? = null
    if field
        value = datum-number(field-datum(row, field))
    else if row.kind == TraceRowKind.begin && row.duration
        value = row.duration as F64
    if !value
        continue
    . population = populations[row.label] ?? Stats()
    populations[row.label] = population
    population.add(value)
    candidates += Outlier(row, value, 0.0)
for candidate in candidates
    candidate.median = populations[candidate.row.label]!.percentile(50.0)
= sort(candidates) • using :: a, b => if ratio(a) > ratio(b) || (ratio(a) == ratio(b) && a.value > b.value) then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
+ ratio F64
    - outlier Outlier

if outlier.median > 0.0 then outlier.value / outlier.median else outlier.value

━━━━━━━━━━━━━━━━━━━━
+ Change

+ section = ""
+ name = ""
+ left F64
+ right F64
+ is-duration = false

────────────────────
+ get delta F64

right - left

────────────────────
+ get weight F64

|? left == 0.0
    if right != 0.0 then 1000000.0 else 0.0
??
    if delta >= 0.0 then (delta / left) else (-delta / left)

━━━━━━━━━━━━━━━━━━━━
+ do trace-changes [Change]
    - left ProbeTrace
    - right ProbeTrace
    - shows-all Bool

. changes [Change]
. empty = RowFilter()
compare(changes, "records", site-counts(left), site-counts(right), false)
compare
    - changes
    - "group total"
    - group-totals(left, empty, "sum")
    - group-totals(right, empty, "sum")
    - true
compare
    - changes
    - "group p50"
    - group-totals(left, empty, "p50")
    - group-totals(right, empty, "p50")
    - true
compare(changes, "counter", counter-totals(left), counter-totals(right), false)
. kept [Change]
for change in changes
    if shows-all || change.left != change.right
        kept += change
= sort(kept) • using :: a, b => if a.weight > b.weight then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
_ do compare
    - changes [Change]
    - section String
    - left [String = F64]
    - right [String = F64]
    - is-duration Bool

. names [String = Bool]
for name, _ in left
    names[name] = true
for name, _ in right
    names[name] = true
for name, _ in names
    . change = Change()
    change.section = section
    change.name = name
    change.left = left[name] ?? 0.0
    change.right = right[name] ?? 0.0
    change.is-duration = is-duration
    changes += change

━━━━━━━━━━━━━━━━━━━━
_ do site-counts [String = F64]
    - trace ProbeTrace

. counts [String = F64]
for row in trace.rows
    if row.kind == TraceRowKind.end
        continue
    . name = if row.location != "" then "${row.label} ${row.location}" else row.label
    counts[name] = (counts[name] ?? 0.0) + 1.0
= counts

━━━━━━━━━━━━━━━━━━━━
_ do group-totals [String = F64]
    - trace ProbeTrace
    - filter RowFilter
    - stat String

. totals [String = F64]
for summary in group-summaries(trace, filter)
    if summary.stats.count != 0
        totals[summary.label] = summary.stats.stat(stat) ?? 0.0
= totals

━━━━━━━━━━━━━━━━━━━━
_ do counter-totals [String = F64]
    - trace ProbeTrace

. totals [String = F64]
for count in trace.counts
    totals[count.key] = (totals[count.key] ?? 0.0) + (count.value as F64)
for metric in trace.metrics
    totals[metric.site.key] = (totals[metric.site.key] ?? 0.0) + (metric.value as F64)
= totals
