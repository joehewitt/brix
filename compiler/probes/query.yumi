./model
/probes/console
/probes/model
/probes/trace
/stream/aggregate

_ Clause is (field String, operator String, value String)

━━━━━━━━━━━━━━━━━━━━
+ Datum is Union

| number F64
| text String

━━━━━━━━━━━━━━━━━━━━
+ RowFilter

+ keys [String]
+ texts [String]
+ sources [String]
+ kinds [TraceRowKind]
+ earliest U64?
+ latest U64?
+ is-open-only = false

_ clauses [Clause]

────────────────────
+ do add-where ?! Error
    - text String

for clause in parse-clauses(text)
    clauses += clause

────────────────────
+ do add-kinds ?! Error
    - text String

for name in text.split(",")
    do match name.trim()
        |= "log"
            kinds += TraceRowKind.log
        |= "event"
            kinds += TraceRowKind.event
        |= "group"
            kinds += TraceRowKind.begin
            kinds += TraceRowKind.end
        |= "begin"
            kinds += TraceRowKind.begin
        |= "end"
            kinds += TraceRowKind.end
        |= "open"
            kinds += TraceRowKind.begin
            is-open-only = true
        |= "system"
            kinds += TraceRowKind.system
        ?! Error("Unknown --kind ${name.trim()} (use log, event, group, begin, end, open or system)")

────────────────────
+ do accepts Bool
    - row TraceRow

=? false if kinds.length != 0 && !(kinds has row.kind)
=? false if is-open-only && (row.kind != TraceRowKind.begin || row.duration != null)
=? false if earliest && row.time < earliest
=? false if latest && row.time > latest
=? false if keys.length != 0 && !matches-key(row)
=? false if sources.length != 0 && !matches-source(row)
for text in texts
    =? false if row.text.find(text) == null
= all(clauses) • where clause-holds(each, row)

────────────────────
_ do matches-key Bool
    - row TraceRow

. name = if row.key != "" then row.key else row.label
for pattern in keys
    =? true if glob-matches(pattern, name)
    =? true if !pattern.find("*") && !pattern.find("?") && name.starts-with("$pattern.")
= false

────────────────────
_ do matches-source Bool
    - row TraceRow

for wanted in sources
    . colon = wanted.find-reverse(":")
    . file = wanted
    . line U32? = null
    if colon
        . number = parse-number(wanted[colon + 1 ...])
        if number
            file = wanted[0 .. < colon]
            line = number as U32
    . place = if row.path != "" then row.path else row.location
    . named = place == file || place.ends-with("/$file") || row.location.starts-with("$file:")
    if named && (!line || line == row.line)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ parse-duration U64? ?! Error
    - text String

?! Error("Invalid duration: $text (use a number with ns, us, ms, s or m)")
    if !nanoseconds

nanoseconds

.. nanoseconds = duration-of(text)

━━━━━━━━━━━━━━━━━━━━
+ do duration-of U64?
    - text String

. scale = 1000000000.0
. cut Size = 0
if text.ends-with("ns")
    scale = 1.0
    cut = 2
else if text.ends-with("us") || text.ends-with("µs")
    scale = 1000.0
    cut = 2
else if text.ends-with("ms")
    scale = 1000000.0
    cut = 2
else if text.ends-with("s")
    cut = 1
else if text.ends-with("m")
    scale = 60000000000.0
    cut = 1
. value = parse-number(text[0 .. < text.length - cut])
=? null if !value || value < 0.0
= (value * scale) as U64

━━━━━━━━━━━━━━━━━━━━
+ do parse-number F64?
    - text String

=? null if text.length == 0
. dots = 0
. digits = 0
. first = true
for char in text
    . leading = first
    first = false
    if char == '.'
        dots += 1
    else if char == '-' && leading
        continue
    else if char < '0' || char > '9'
        = null
    else
        digits += 1
=? null if dots > 1 || digits == 0
= text as F64

━━━━━━━━━━━━━━━━━━━━
+ parse-quantity F64?
    - text String

|? number
    number
|? !text.ends-with("s") && !text.ends-with("m")
    null
|? !nanoseconds
    null
??
    nanoseconds as F64

.. number = parse-number(text)
.. nanoseconds = catch? parse-duration(text)

━━━━━━━━━━━━━━━━━━━━
+ do glob-matches Bool
    - pattern String
    - text String

=? true if pattern == "*"
. wanted = chars(pattern)
. given = chars(text)
. cursor = 0
. matched = 0
. star Size? = null
. resume = 0
while matched < given.length
    if cursor < wanted.length && (wanted[cursor] == '?' || wanted[cursor] == given[matched])
        cursor += 1
        matched += 1
    else if cursor < wanted.length && wanted[cursor] == '*'
        star = cursor
        resume = matched
        cursor += 1
    else if star
        cursor = star + 1
        resume += 1
        matched = resume
    else
        = false
while cursor < wanted.length && wanted[cursor] == '*'
    cursor += 1
= cursor == wanted.length

━━━━━━━━━━━━━━━━━━━━
+ do field-datum Datum?
    - row TraceRow
    - name String

do match? name
    |= "duration"
        =? Datum.number(row.duration as F64) if row.duration
        = null
    |= "time"
        = Datum.number(row.time as F64)
    |= "depth"
        = Datum.number(row.depth as F64)
    |= "index"
        = Datum.number(row.index as F64)
    |= "key"
        = Datum.text(row.key)
    |= "label"
        = Datum.text(row.label)
    |= "text"
        = Datum.text(row.text)
    |= "location"
        = Datum.text(row.location)
    |= "owner"
        = Datum.text(row.owner)
. found = row.value(name)
=? null if !found
= value-datum(found)

━━━━━━━━━━━━━━━━━━━━
+ do value-datum Datum
    - value TraceValue

do match? value
    | .truth(truth)
        = Datum.number(if truth then 1.0 else 0.0)
    | .integer(integer)
        = Datum.number(integer as F64)
    | .unsigned(unsigned)
        = Datum.number(unsigned as F64)
    | .real(real)
        = Datum.number(real)
    | .text(text)
        . number = parse-number(text)
        =? Datum.number(number) if number
        = Datum.text(text)
= Datum.text(value-text(value, Map'U16'String()))

━━━━━━━━━━━━━━━━━━━━
+ do datum-number F64?
    - datum Datum?

=? null if !datum
do match? datum
    | .number(number)
        = number
= null

━━━━━━━━━━━━━━━━━━━━
+ do datum-text String
    - datum Datum?

=? "" if !datum
do match? datum
    | .number(number)
        = number-text(number)
    | .text(text)
        = text
= ""

━━━━━━━━━━━━━━━━━━━━
+ do number-text String
    - value F64

. negative = value < 0.0
. magnitude = if negative then -value else value
. scaled = (magnitude * 1000.0 + 0.5) as U64
. whole = scaled / 1000
. fraction = scaled % 1000
. sign = if negative && scaled != 0 then "-" else ""
=? "$sign$whole" if fraction == 0
. padded = "${fraction + 1000}"
. digits = padded[1 ...]
while digits.ends-with("0")
    digits = digits[0 .. < digits.length - 1]
= "$sign$whole.$digits"

━━━━━━━━━━━━━━━━━━━━
+ do split-list [String]
    - text String?

. items [String]
=? items if !text
for part in text.split(",")
    . trimmed = part.trim()
    if trimmed != ""
        items += trimmed
= items

━━━━━━━━━━━━━━━━━━━━
_ chars [Char]
    - text String

each in text

━━━━━━━━━━━━━━━━━━━━
_ do parse-clauses [Clause] ?! Error
    - text String

. clauses [Clause]
for part in text.split("&&")
    for piece in part.split(" and ")
        . trimmed = piece.trim()
        if trimmed != ""
            clauses += parse-clause(trimmed)
= clauses

━━━━━━━━━━━━━━━━━━━━
_ do parse-clause Clause ?! Error
    - text String

for operator in ["==", "!=", "<=", ">=", "~", "<", ">", "="]
    . cursor = text.find(operator)
    if cursor
        . field = text[0 .. < cursor].trim()
        . value = unquoted(text[cursor + operator.length ...].trim())
        ?! Error("Invalid --where clause: $text (use field op value, such as ms > 4)")
            if field == "" || value == ""
        = Clause(field, if operator == "=" then "==" else operator, value)
?! Error("Invalid --where clause: $text (use field op value, where op is ==, !=, <, <=, >, >= or ~)")

━━━━━━━━━━━━━━━━━━━━
_ unquoted String
    - text String

|? text.length >= 2 && ((text.starts-with("\"") && text.ends-with("\"")) || is-single-quoted)
    text[1 .. < text.length - 1]
??
    text

.. is-single-quoted = text.starts-with("'") && text.ends-with("'")

━━━━━━━━━━━━━━━━━━━━
_ do clause-holds Bool
    - clause Clause
    - row TraceRow

. datum = field-datum(row, clause.field)
=? false if !datum
. left = datum-number(datum)
. right = parse-quantity(clause.value)
if left && right
    . a = left
    . b = right
    do match? clause.operator
        |= "=="
            = a == b
        |= "!="
            = a != b
        |= "<"
            = a < b
        |= "<="
            = a <= b
        |= ">"
            = a > b
        |= ">="
            = a >= b
. text = datum-text(datum)
do match? clause.operator
    |= "=="
        = text == clause.value
    |= "!="
        = text != clause.value
    |= "~"
        = text.find(clause.value) != null
    |= "<"
        = text < clause.value
    |= "<="
        = text <= clause.value
    |= ">"
        = text > clause.value
    |= ">="
        = text >= clause.value
= false
