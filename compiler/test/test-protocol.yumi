/data/json
/os/file

━━━━━━━━━━━━━━━━━━━━
+ do selected-test-ids [String]
    - text String

. decoded = JSON(text)
if decoded is not [JSON]
    ?! Error("The selected tests must be a JSON array")

. ids [String]
for value in decoded as [JSON]
    if value is not String
        ?! Error("The ids of the selected tests must be strings")
    ids += value
= ids

━━━━━━━━━━━━━━━━━━━━
+ run-start-json [String = JSON]
    - selected-ids [String]

Map'String'JSON
    • "protocol" "ometer.testometer.v1" as JSON
    • "version" 1 as JSON
    • "type" "runStart" as JSON
    • "count" selected-ids.length as JSON
    • "testIds" json-strings(selected-ids) as JSON

━━━━━━━━━━━━━━━━━━━━
+ test-start-json [String = JSON]
    - id String

Map'String'JSON
    • "protocol" "ometer.testometer.v1" as JSON
    • "version" 1 as JSON
    • "type" "testStart" as JSON
    • "id" id as JSON

━━━━━━━━━━━━━━━━━━━━
+ run-end-json [String = JSON]
    - count Int
    - passed Int
    - failed Int
    - skipped Int
    - crashed Int
    - killed Int

Map'String'JSON
    • "protocol" "ometer.testometer.v1" as JSON
    • "version" 1 as JSON
    • "type" "runEnd" as JSON
    • "count" count as JSON
    • "passed" passed as JSON
    • "failed" failed as JSON
    • "skipped" skipped as JSON
    • "crashed" crashed as JSON
    • "killed" killed as JSON

━━━━━━━━━━━━━━━━━━━━
+ json-strings [JSON]
    - values [String]

<* value in values
    value as JSON

━━━━━━━━━━━━━━━━━━━━
+ do emit-json
    - value [String = JSON]

stdout.write("${to-json(value)}\n")
