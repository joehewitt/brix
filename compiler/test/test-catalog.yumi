./../command-template
./test-config
/core/tokenstream
/data/json
/os/path
/os/process
/time/duration

_ test-listing-timeout = 60s

━━━━━━━━━━━━━━━━━━━━
+ TestNodeKind is Union

| suite
| group
| test

━━━━━━━━━━━━━━━━━━━━
+ TestNode

+ kind TestNodeKind
+ suite Index
+ id String
+ label String
+ selector String
+ parent Index?
+ children [Index]
+ relative-path = ""
+ line-start Size = 0
+ line-end Size = 0
+ selectors [String]

────────────────────
+ This
    - kind
    - suite
    - id
    - label
    - selector
    - parent

────────────────────
+ get is-test Bool

kind == TestNodeKind.test

━━━━━━━━━━━━━━━━━━━━
+ TestSelection is Tuple

+ leaves [Index]
+ unmatched [String]

━━━━━━━━━━━━━━━━━━━━
+ TestCatalog

+ root String
+ nodes [TestNode]
+ suites [Index]
+ problems [String]

────────────────────
+ This
    - root

────────────────────
+ do add Index
    - node TestNode

. index = nodes.length
nodes += node
if node.parent
    nodes[node.parent].children += index
= index

────────────────────
+ do leaves [Index]
    - node Index

. found [Index]
collect-leaves(node, found)
= found

────────────────────
+ do suite-of Index
    - node Index

. current = node
while nodes[current].parent
    current = nodes[current].parent!
= current

────────────────────
+ do select TestSelection
    - selectors [String]

. chosen = Bool[nodes.length]
. unmatched [String]
if selectors.length == 0
    for suite in suites
        mark(suite, chosen)
for selector in selectors
    if !choose(selector, chosen)
        unmatched += selector
. leaves [Index]
for index in 0 .. < nodes.length
    if chosen[index] && nodes[index].is-test
        leaves += index
= TestSelection(leaves, unmatched)

────────────────────
_ do collect-leaves
    - node Index
    - found [Index]

. entry = nodes[node]
if entry.is-test
    found += node
    =
for child in entry.children
    collect-leaves(child, found)

────────────────────
_ do mark Bool
    - node Index
    - chosen Bool[]

. matched = false
for leaf in leaves(node)
    chosen[leaf] = true
    matched = true
= matched

────────────────────
_ do choose Bool
    - selector String
    - chosen Bool[]

if selector.starts-with("suite:")
    . name = selector["suite:".length ...]
    . matched = false
    for suite in suites
        if nodes[suite].id == name
            matched = mark(suite, chosen) || matched
    =? true if matched
    = choose-groups(selector, chosen) || choose-groups(name, chosen)
if selector.starts-with("file:")
    . path = test-relative-path(selector["file:".length ...], root)
    = choose-tests(chosen, :: node => node.relative-path == path)
if selector.starts-with("test:")
    = choose-tests(chosen, :: node => node.id == selector || node.selector == selector)
. line = test-line-selector(selector)
if line
    . path = test-relative-path(line.path, root)
    . number = line.number
    = choose-tests(chosen, :: node => node.relative-path == path && node.line-start <= number && number <= node.line-end)
=? true if choose-groups(selector, chosen)
. path = test-relative-path(selector, root)
=? true if choose-tests(chosen, :: node => node.selectors has selector || node.relative-path == path || Path(node.relative-path, 0).name == selector)
. prefix = "${path}/"
= choose-tests(chosen, :: node => node.relative-path.starts-with(prefix))

────────────────────
_ do choose-groups Bool
    - selector String
    - chosen Bool[]

. matched = false
for index in 0 .. < nodes.length
    . node = nodes[index]
    if !node.is-test && (is-named || node.selectors has selector || is-at-path)
        matched = mark(index, chosen) || matched
    .. is-named = node.selector == selector || node.id == selector
    .. is-at-path = node.relative-path != "" && node.relative-path == selector
= matched

────────────────────
_ do choose-tests Bool
    - chosen Bool[]
    - accepts TestNodePredicate

. matched = false
for index in 0 .. < nodes.length
    . node = nodes[index]
    if node.is-test && accepts(node)
        chosen[index] = true
        matched = true
= matched

━━━━━━━━━━━━━━━━━━━━
_ TestNodePredicate is () Bool
    - node TestNode

━━━━━━━━━━━━━━━━━━━━
_ TestLineSelector is (path String, number Size)

━━━━━━━━━━━━━━━━━━━━
_ do test-line-selector TestLineSelector?
    - selector String

. colon = selector.find-reverse(":")
=? null if colon == null || colon == 0
. digits = selector[colon + 1 ...]
=? null if digits.length == 0
for char in digits
    =? null if char < '0' || char > '9'
. path = selector[0 .. < colon]
=? null if path.find("/") == null && path.find(".") == null
= TestLineSelector(path, digits as Size)

━━━━━━━━━━━━━━━━━━━━
+ test-relative-path String
    - path String
    - root String

|? path.starts-with("./")
    path[2 ...]
|? path.starts-with("$root/")
    path[root.length + 1 ...]
??
    path

━━━━━━━━━━━━━━━━━━━━
_ TestListing is (index Index, text String, problem String?)

━━━━━━━━━━━━━━━━━━━━
+ TestDiscovery

+ is-stopped = false
+ is-finished = false

_ processes [Process]
_ done := SyncBufferedChannel'Bool()

────────────────────
+ do stop

=? if is-stopped
is-stopped = true
for process in processes
    process.kill-tree()

────────────────────
+ do finish

is-finished = true
done.close()

────────────────────
+ do await

<- done

────────────────────
_ do watch
    - process Process

if is-stopped
    process.kill-tree()
processes += process

────────────────────
_ do forget
    - process Process

processes = List'Process(each in processes when each as Pointer != process as Pointer)

━━━━━━━━━━━━━━━━━━━━
+ do discover-tests TestCatalog
    - config TestConfig
    - discovery TestDiscovery

. catalog = TestCatalog(config.root)
. listed = SyncBufferedChannel'TestListing()
for index in 0 .. < config.suites.length
    do new
        listed <- list-suite(config, index, discovery)
. listings = Map'Index'TestListing()
for _ in 0 .. < config.suites.length
    . listing = <- listed
    if listing
        listings[listing.index] = listing
for index in 0 .. < config.suites.length
    . suite = config.suites[index]
    . listing = listings[index]
    . problem = listing?.problem
    if listing && !problem
        . added = catch add-listing(catalog, index, suite, listing.text)
        if added is Error
            catalog.problems += "${suite.id}: ${(added as Error).message}"
    else
        catalog.problems += "${suite.id}: ${problem ?? "no catalog"}"
= catalog

━━━━━━━━━━━━━━━━━━━━
_ do list-suite TestListing
    - config TestConfig
    - index Index
    - discovery TestDiscovery

. suite = config.suites[index]
. listed = catch read-listing(config, suite, discovery)
do match listed
    | failure Error
        = TestListing(index, "", failure.message)
    | text String
        = TestListing(index, text, null)

━━━━━━━━━━━━━━━━━━━━
_ do read-listing String ?! Error
    - config TestConfig
    - suite TestSuiteConfig
    - discovery TestDiscovery

?! Error("discovery stopped")
    if discovery.is-stopped
. step = config.step(suite, suite.catalog, Map'String'String())
. command = step.arguments
. process = use Process(command[0], ProcessStderr.capture, command[1 ...], config.root, step.variables) • group ProcessGroup.own
discovery.watch(process)
do finally
    discovery.forget(process)
. capture = TestCapture(process)
. output = ChunkedTokenStream'Byte(process).read().slice-string()
. status = process.wait(null) ?? -1
capture.settle()
. errors = capture.errors()
?! Error("listing timed out after ${test-listing-timeout}")
    if capture.is-timed-out
?! Error(test-failure-text(errors, "listing exited with status $status"))
    if status != 0
= output

━━━━━━━━━━━━━━━━━━━━
+ test-failure-text String
    - errors String
    - fallback String

if last != "" then last else fallback

.. last = test-last-line(errors)

━━━━━━━━━━━━━━━━━━━━
+ test-last-line String
    - text String

if newline then trimmed[newline + 1 ...].trim() else trimmed

.. trimmed = text.trim()
.. newline = trimmed.find-reverse("\n")

━━━━━━━━━━━━━━━━━━━━
_ TestCapture

+ is-timed-out = false

_ process Process
_ drained := Semaphore'String()
_ is-settled = false
_ timer Task?

────────────────────
+ This
    - process

. errors = process.stderr!
do new
    . text = errors as String
    drained.post(text)
do new
    watch()

────────────────────
+ do settle

is-settled = true
timer?.cancel()

────────────────────
+ do errors String

= drained.await() ?? ""

────────────────────
_ do watch

timer = get-active-task()
=? if is-settled
test-listing-timeout.wait()
=? if is-settled
is-timed-out = true
process.kill-tree()

━━━━━━━━━━━━━━━━━━━━
_ do add-listing ?! Error
    - catalog TestCatalog
    - index Index
    - suite TestSuiteConfig
    - text String

. listing = JSONReader("${suite.id} catalog", parse-json(text)).object()
. details = Map'String'JSONObjectReader()
for item in listing["tests"].items()
    . fields = item.object()
    details[fields["id"].string()] = fields
. root = TestNode(TestNodeKind.suite, index, suite.id, suite.id, "suite:${suite.id}", null)
. node = catalog.add(root)
catalog.suites += node
. tops = listing["suites"].items()
if tops.length == 1 && test-field(tops[0].object(), "kind") == "suite"
    . top = tops[0].object()
    root.selectors += test-field(top, "selector")
    root.selectors += test-field(top, "id")
    add-children(catalog, node, test-items(top, "children"), details)
else
    add-children(catalog, node, tops, details)

━━━━━━━━━━━━━━━━━━━━
_ do add-children ?! Error
    - catalog TestCatalog
    - parent Index
    - items [JSONReader]
    - details [String = JSONObjectReader]

. suite = catalog.nodes[parent].suite
for item in items
    . fields = item.object()
    . id = test-field(fields, "id")
    if test-field(fields, "kind") == "test"
        . detail = details[id] ?? fields
        . node = TestNode
            - TestNodeKind.test
            - suite
            - id
            - test-first-line(test-field(detail, "label"))
            - test-field(detail, "selector")
            - parent
        node.relative-path = test-location(detail, root) ?? test-field(detail, "relativePath")
            .. root = catalog.root
        node.line-start = test-number(detail, "lineNoStart")
        node.line-end = test-number(detail, "lineNoEnd")
        for selector in test-items(detail, "selectors")
            node.selectors += selector.string()
        catalog.add(node)
    else
        . node = TestNode
            - TestNodeKind.group
            - suite
            - id
            - test-field(fields, "label")
            - test-field(fields, "selector")
            - parent
        node.relative-path = test-location(fields, catalog.root) ?? (if id.starts-with("file:") then id["file:".length ...] else test-field(fields, "relativePath"))
        add-children(catalog, catalog.add(node), test-items(fields, "children"), details)

━━━━━━━━━━━━━━━━━━━━
_ test-location String? ?! Error
    - fields JSONObjectReader
    - root String

source[root.length + 1 ...] if source.starts-with("$root/")

.. source = test-field(fields, "sourcePath")

━━━━━━━━━━━━━━━━━━━━
+ test-field String ?! Error
    - fields JSONObjectReader
    - key String

if fields[key].is-present then fields[key].string() else ""

━━━━━━━━━━━━━━━━━━━━
+ test-number Size ?! Error
    - fields JSONObjectReader
    - key String

if fields[key].is-present then fields[key].int() else 0

━━━━━━━━━━━━━━━━━━━━
+ test-items [JSONReader] ?! Error
    - fields JSONObjectReader
    - key String

if fields[key].is-present then fields[key].items() else List'JSONReader()

━━━━━━━━━━━━━━━━━━━━
_ test-first-line String
    - text String

if newline then trimmed[0 .. < newline].trim() else trimmed

.. trimmed = text.trim()
.. newline = trimmed.find("\n")
