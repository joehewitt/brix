━━━━━━━━━━━━━━━━━━━━
_ without-test-notes String
    - text String

"\n".join(each in text.split("\n") when !each.starts-with("?"))

━━━━━━━━━━━━━━━━━━━━
+ ParsedTestFile

+ cases [ParsedCase]

────────────────────
+ This
    - cases [ParsedCase]

────────────────────
+ This ~ Char

~ entries \file-entry* \blank-line* /
    This(parsed-cases(entries))

.. file-entry ParsedCase? ~
    ~ \blank-line* test \test-case
        test
    ~ \blank-line* \comment
        null
    ~ \blank-line* \ignored-remainder
        null
    ~ \blank-line* \empty-trailing-test
        null

.. test-case ParsedCase ~
    ~ focused \head-separator source \test-source tail \test-tail
        ParsedCase(source, tail, focused)

.. test-tail ParsedTail ~
    ~ \mid-separator settings \test-setting* expected \test-expected end-line \tail-separator
        parsed-tail(expected, end-line, settings)

.. test-source ParsedSource ~
    ~ \source-comment-line* first \source-content-line rest \source-part*
        combined-source(first, rest)
    ~ \source-comment-line* &(\mid-separator)
        ParsedSource("", 0)

.. source-part ParsedSource? ~
    ~ \source-comment-line
        null
    ~ line \source-content-line
        line

.. source-content-line ParsedSource ~
    ~ !(\mid-separator | \source-comment-line) text \source-line \nl
        ParsedSource("$text\n", location.begin.line)
    ~ !(\mid-separator | \source-comment-line) text \source-line
        ParsedSource(text, location.begin.line)

.. source-line String ~
    ~ chars \line-char*
        Array'Char(chars).slice-string()

.. source-comment-line ~
    ~ "#" \horizontal-space \line-char* \nl

.. test-setting ParsedSetting ~
    ~ file \file-block
        file
    ~ brix \brix-block
        brix
    ~ option \option-line
        option

.. file-block ParsedSetting ~
    ~ "%file:" \horizontal-space+ name \source-line \nl content \file-content \mid-separator
        ParsedSetting.file(name.trim(), content)

.. brix-block ParsedSetting ~
    ~ "%brix" \horizontal-space* \nl content \file-content \mid-separator
        ParsedSetting.brix(content)

.. file-content String ~
    ~ chars \file-char*
        without-final-newline(Array'Char(chars).slice-string())

.. file-char Char ~
    ~ !(\mid-separator) .

.. option-line ParsedSetting ~
    ~ "%" !("file" (":" | &\nl)) name \option-name value \option-value? \nl
        .option(name, value ?? "true")

.. option-name String ~
    ~ chars \option-name-char*
        chars

.. option-name-char ~
    ~ !(\nl | \option-value-start) .

.. option-value String ~
    ~ \option-value-start value \line-char*
        value.trim()

.. option-value-start ~
    ~ ":" \horizontal-space+

.. test-expected String ~
    ~ chars \expected-char*
        Array'Char(chars).slice-string()

.. expected-char Char ~
    ~ !(\tail-separator) .

.. comment ~
    ~ \comment-separator \comment-char* \comment-separator

.. comment-char ~
    ~ !(\comment-separator) .

.. ignored-remainder ~
    ~ "/:===" "="* .*

.. empty-trailing-test ~
    ~ \head-separator /

.. head-separator Bool ~
    ~ "::===" "="* \nl
        true
    ~ ":===" "="* \nl
        false

.. mid-separator ~
    ~ ":---" "-"* \nl

.. tail-separator Int ~
    ~ ";===" "="* \nl?
        (location.begin.line as Int) + 1

.. comment-separator ~
    ~ "===" "="* \nl

.. horizontal-space ~
    ~ " " | "\t" | "\r" | "\v" | "\f"

.. blank-line ~
    ~ \horizontal-space* \nl

.. line-char ~
    ~ !(\nl) .

