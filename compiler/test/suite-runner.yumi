this.suite = suite
this.source-path = source-path
relative-path = relative-test-path(source-path, project-path)
file-label = test-file-label(source-path)

────────────────────
+ do parse [TestCase]

. source-file = use File(source-path)
. text = source-file as String
. parsed = match text
    ~ ParsedTestFile
        it
    ?! Error("Malformed test file $relative-path")

= <* index, test-case in indexed(parsed.cases)
    TestCase()
        - suite
        - source-path
        - relative-path
        - file-label
        - index + 1
        - test-case.source
        - without-test-notes(test-case.expected).trim()
        - test-case.line-no-start
        - test-case.line-no-end
        - test-case.is-focused
        - test-case.options
        - test-case.files
        - test-case.brix

━━━━━━━━━━━━━━━━━━━━
_ parsed-cases
    - entries <ParsedCase?>

** entries
?*> each
|> List

━━━━━━━━━━━━━━━━━━━━
_ parsed-tail ParsedTail
    - expected String
    - line-no-end Int
    - settings [ParsedSetting]

ParsedTail(expected, line-no-end, options, files, brix)

.. options =
    ** settings
    ?*> match? each
        | .option(name, value)
            name, value
    |> Map
.. files =
    ** settings
    ?*> match? each
        | .file(path, content)
            path, content
    |> Map
.. brix =
    ** settings
    ?*> match? each
        | .brix(content)
            content
    |> first

━━━━━━━━━━━━━━━━━━━━
_ without-final-newline String
    - text String

if text.ends-with("\n") then text[0 .. < text.length - 1] else text

━━━━━━━━━━━━━━━━━━━━
_ combined-source
    - first ParsedSource
    - rest <ParsedSource?>

ParsedSource(text, first.line-no)

.. text = "".join
    * first.text
    **
        rest
        ?*> each?.text

━━━━━━━━━━━━━━━━━━━━
_ relative-test-path String
    - source-path String
    - project-path String

?! Error("Test file is outside the project: $source-path")
    if !source-path.starts-with("$project-path/")

source-path[project-path.length + 1 ...]

━━━━━━━━━━━━━━━━━━━━
_ do test-file-label String
    - source-path String

. words [String]
. word = ""
. previous Char?
for char in Path(source-path).base-name
    . is-separator = char == '-' || char == '_'
    . starts-after-lowercase = previous && previous >= 'a' && previous <= 'z'
    . starts-camel-word = starts-after-lowercase && char >= 'A' && char <= 'Z'
    if is-separator || starts-camel-word
        if word
            words += word
        word = ""
    if !is-separator
        word += char
    previous = char
if word
    words += word

= " ".join
    ** 1 .. < words.length
    *> words[each].lowercased

