+ actual = ""
+ expected = ""
+ errors = ""
+ duration = 0ms
+ compiled = false
+ exit = 0

────────────────────
+ do compare
    - actual String
    - expected String

this.actual = actual
this.expected = expected
status = if actual.trim() == expected.trim() then "passed" else "failed"

