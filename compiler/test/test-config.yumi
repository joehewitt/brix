/time/duration

+ test-config-path = ".brix/tests.json"

_ test-idle-timeout = 300s
_ test-protocol-prefix = "OMETER_TESTOMETER_"
_ default-brix [String] = ["brix"]
_ default-suite-name = "tests"

━━━━━━━━━━━━━━━━━━━━
+ TestConfig is Tuple

+ root String
+ variables [TargetVariable]
+ suites [TestSuiteConfig]

────────────────────
+ do step TargetStep ?! Error
    - suite TestSuiteConfig
    - arguments [String]
    - extra [String = String]

. environment = test-environment(root, suite.id)
for name, value in extra
    environment[name] = value
. values = Map'String'String
    • "root" root
apply-variables(environment, variables, values)
apply-variables(environment, suite.variables, values)
= TargetStep(expand-arguments(arguments, values), environment)

━━━━━━━━━━━━━━━━━━━━
+ TestSuiteConfig is Tuple

+ id String
+ catalog [String]
+ run [String]
+ variables [TargetVariable]
+ idle-timeout Seconds
+ modes [String = [String]]

━━━━━━━━━━━━━━━━━━━━
+ do load-test-config TestConfig ?! Error
    - root String

. path = Path("$root/$test-config-path", 0)
. nested = nested-configs(root, test-config-path)
=? default-test-config(root) if !path.exists && !nested
. file = test-file(path, test-config-path)
. brix = if file.has("brix") then target-arguments(file["brix"]) else default-brix
. suites [TestSuiteConfig]
. claimed [String = String]
. layers [String = TestLayer]
layers[root] = TestLayer(brix, List'TargetVariable())
add-test-suites(suites, claimed, file, test-config-path, null, layers[root]!)
for config in nested
    . entry = test-file(Path("${config.folder}/$test-config-path", 0), config.label)
    . inherited = layers[config.parent]!
    . folder = config.folder
    . given-brix = rebased-paths(target-arguments(entry["brix"]), folder) if entry.has("brix")
    . given-env = if entry.has("env") then target-variables(entry["env"]) else List'TargetVariable()
    . layer = TestLayer
        - given-brix ?? inherited.brix
        - inherited.variables ++ rebased-variables(given-env, folder)
    layers[folder] = layer
    add-test-suites(suites, claimed, entry, config.label, folder, layer)
. variables = if file.has("env") then target-variables(file["env"]) else List'TargetVariable()
= TestConfig(root, variables, suites)

━━━━━━━━━━━━━━━━━━━━
_ TestLayer is Tuple

+ brix [String]
+ variables [TargetVariable]

━━━━━━━━━━━━━━━━━━━━
_ default-test-config TestConfig
    - root String

TestConfig(root, none, [suite])

.. none = List'TargetVariable()
.. suite = module-suite(default-brix, default-suite-name, ["."], none, test-idle-timeout)

━━━━━━━━━━━━━━━━━━━━
_ do test-file JSONObjectReader ?! Error
    - path Path
    - label String

. text = if path.exists then read-file-text(path) else "{}"
= JSONReader(label, parse-json(text)).object()

━━━━━━━━━━━━━━━━━━━━
_ do add-test-suites ?! Error
    - suites [TestSuiteConfig]
    - claimed [String = String]
    - file JSONObjectReader
    - label String
    - folder String?
    - layer TestLayer

=? if !file.has("suites")
for item in file["suites"].items()
    . entry = item.object()
    . id = entry["id"].string()
    . other = claimed[id]
    ?! Error("Suite $id appears twice in ${config-places(other, label)}")
        if other
    claimed[id] = label
    . own = if entry.has("env") then target-variables(entry["env"]) else List'TargetVariable()
    . variables = layer.variables ++ rebased-variables(own, folder)
    . timeout = if entry.has("timeout") then (entry["timeout"].number() as Seconds) else test-idle-timeout
    if entry.has("modules")
        . sources = rebased-paths(module-sources(entry["modules"]), folder)
        suites += module-suite(layer.brix, id, sources, variables, timeout)
        continue
    suites += TestSuiteConfig
        - id
        - rebased-paths(target-arguments(entry["catalog"]), folder)
        - rebased-paths(target-arguments(entry["run"]), folder)
        - variables
        - timeout
        - test-modes(entry, folder)

━━━━━━━━━━━━━━━━━━━━
_ module-sources [String] ?! Error
    - reader JSONReader

` What a suite with modules names: one folder, or a list of folders and of modules named by their
` path without `.yumi`.
|? reader.value is String
    [reader.value as String]
??
    <* item in reader.items()
        item.string()

━━━━━━━━━━━━━━━━━━━━
_ module-suite TestSuiteConfig
    - brix [String]
    - id String
    - sources [String]
    - variables [TargetVariable]
    - timeout Seconds

TestSuiteConfig
    - id
    - modules-command(brix, "catalog-modules", sources)
    - modules-command(brix, "run-modules", sources)
    - variables
    - timeout
    - Map'String'[String]()

━━━━━━━━━━━━━━━━━━━━
_ modules-command [String]
    - brix [String]
    - action String
    - sources [String]

parts

.. parts [String]
    ** brix
    * "test"
    * action
    ** sources

━━━━━━━━━━━━━━━━━━━━
_ do test-modes [String = [String]] ?! Error
    - entry JSONObjectReader
    - folder String?

. modes [String = [String]]
=? modes if !entry.has("modes")
. reader = entry["modes"]
for name, value in reader.object().fields
    . arguments [String]
    for item in JSONReader("${reader.label}.$name", value).items()
        arguments += rebased-path(item.string(), folder)
    modes[name] = arguments
= modes

━━━━━━━━━━━━━━━━━━━━
_ do test-environment [String = String]
    - root String
    - suite String

await-login-shell-environment()
. variables = Map'String'String()
for name, value in environment()
    if !name.starts-with(test-protocol-prefix)
        variables[name] = value
variables["${test-protocol-prefix}PROJECT_ROOT"] = root
variables["${test-protocol-prefix}SUITE_NAME"] = suite
= variables
