; name: Lazy values
; category: basics
; size: medium
; summary: A lazy value is worked out the first time it is read, and never if nothing reads it.
; examples: basics/reactivity/tracked-cart.bx, basics/functions/text-bodies-receipt.bx, basics/classics/lisp-interpreter.bx
(main
  (call report false)
  (call report true)
)

(fn-do + report _
  (param is-detailed Bool)
  (lazy stats (call expensive-stats))
  (if is-detailed
    (print (str "mean " stats))
    (else
      (print "summary only")
    )
  )
)

(fn-expr + expensive-stats Float
  (before
    (print "computing stats")
  )
  4.2
)
