; name: Bindings
; category: front-end
; size: medium
; summary: `<->` binds a property of an element to a place in a model, and each follows the other.
; examples: gui/quakes/quakes-window.bx, gui/image-viewer/image-viewer-panel.bx
(import /gui)

(main
  (let mixer (call Mixer))
  (<> App
    (<> Window (• flex-col)
      (= title "Mixer")
      (<> Slider
        (<-> value (. mixer volume))
      )
      (<> Label
        (= text (str "volume " (. mixer #volume)))
      )
    )
  )
)

(type + Mixer
  (prop + volume F64 (= 0.5))
)
