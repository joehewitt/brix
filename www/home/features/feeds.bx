; name: Feeds
; category: basics
; size: medium
; summary: A list is built one row at a time, with items that may be missing and collections spread in place.
; examples: basics/pipelines/top-words.bx, basics/pipelines/generators.bx
(main
  (print (call menu true (list "timing" "memory")))
  (print (call menu false null))
)

(fn-expr + menu (list String)
  (param has-debug Bool)
  (param extras (? (list String)))
  (item "status")
  (item? (only-if "debug" (if has-debug)))
  (spread? extras)
  (item "quit")
)
