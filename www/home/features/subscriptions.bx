; name: Subscriptions
; category: front-end
; size: medium
; summary: A loop `on` an event is written like a loop `in` a list, with the same clauses, and `break` ends the subscription.
; examples: basics/reactivity/events-newsletter.bx, basics/reactivity/tracked-cart.bx, tui/table.bx
(main
  (for (in n (list 1 2 3) (when (> n 1)))
    (print (str "in " n))
  )
  (let clicks (call Clicker))
  (for (on n (. clicks clicked) (until (== n 3)))
    (print (str "on " n))
  )
  (for (in n (.. 1 4))
    (<- (. clicks clicked) n)
  )
)

(type + Clicker
  (event + clicked Int)
)
