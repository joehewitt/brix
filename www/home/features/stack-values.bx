; name: Stack values
; category: systems
; size: medium
; summary: A `@stack` value is given for a block and everything it calls, and the compiler checks that every call path reaching a read gives one.
(prop + request-id String @stack)

(main
  (do-with request-id "r-42"
    (call handle "GET /")
  )
)

(fn-do + handle _
  (param route String)
  (call log (str "handling " route))
)

(fn-do + log _
  (param text String)
  (print (str "[" request-id "] " text))
)
