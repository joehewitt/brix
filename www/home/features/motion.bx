; name: Motion
; category: front-end
; size: medium
; summary: Style values move from one to the next with the motion a rule names, and keyframes describe an animation as a value of the sheet.
; examples: gui/basics/swatches.bx, gui/basics/counter.bx, gui/showcase/motion/motion-app.bx
(import /gui)
(import /math/easing)
(import /time/duration)
(import /units)

(main
  (<> App
    (<> Window
      (= title "Motion")
      (<> Stage (• flex-col) (• items-center) (• justify-center)
        (<> Button (text: "Hover me") (• bouncy))
        (<> Box (• heart))
      )
    )
  )
)

(type + Stage (is Box)
  (using MotionSheet)
)

(style MotionSheet
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxTransform)
  (keyframes beat animation 900ms
    (= repeat (. Repeat forever))
    (track scale
      (at 0% 1)
      (at 50% 1.4 (:easing (. Easing ease-in-out)))
      (at 100% 1)
    )
  )
  (rule bouncy
    (= motion gui-motion-bouncy)
    (when-style #is-hover-within
      (= scale 1.1)
    )
  )
  (rule heart (• w 24) (• h 24) (• bg gui-danger-color)
    (= animation beat)
  )
)
