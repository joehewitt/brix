; name: Streams
; category: basics
; size: large
; summary: One `stream` type takes lists, ranges, generators and channels, so one function reads them all, whether the items are stored or still arriving.
; examples: basics/streams/one-function-any-source.bx, basics/grammars/arriving-input.bx, basics/pipelines/generators.bx
(main
  (let readings (channel Int))
  (do-new
    (<- readings 3 4 5)
    (call (. readings close))
  )
  (print (call total (list 1 2 3)))
  (print (call total (.. 1 10)))
  (print (call total readings))
)

(fn-do + total Int
  (param values (stream Int))
  (let sum 0)
  (for (in value values)
    (+= sum value)
  )
  (return sum)
)
