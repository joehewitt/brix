; name: Reactivity
; category: front-end
; size: large
; summary: Reading a value as `#count` makes whatever is built from it follow it, in properties, plain assignments and lazy values alike, with no framework like React or MobX.
; examples: basics/reactivity/tracked-cart.bx, gui/basics/counter.bx, tui/order.bx
(main
  (let counter (call Counter))
  (let badge (call Badge))
  (= (. badge text) (str "count " (. counter #count)))
  (lazy doubled (* (. counter #count) 2))
  (= (. counter count) 5)
  (print (. badge text))
  (print doubled)
)

(type + Counter
  (prop + count _ (= 1))
)

(type + Badge
  (prop + text _ (= ""))
)
