; name: Grammars
; category: basics
; size: large
; summary: Grammars replace regular expressions: they read text, bytes or any other items, and their captures come back as typed values.
; examples: basics/grammars/log-lines.bx, basics/grammars/binary-packet.bx, basics/grammars/event-gestures.bx
(main
  (for (in text (list "v1.2.3" "v10.0.7" "1.2"))
    (print (call version text))
  )
)

(fn-expr + version String
  (param text String)
  (match text
    (~ (seq "v" (: major (of \num Int)) "." (: minor (of \num Int)) "." (: patch (of \num Int)))
      (str "next release: v" major "." minor "." (+ patch 1))
    )
    (default
      (inline (str "not a version: " text))
    )
  )
)
