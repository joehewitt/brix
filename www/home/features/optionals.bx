; name: Optionals
; category: basics
; size: small
; summary: A value that may be missing has an optional type, and a test that it is present narrows it to the value.
; examples: basics/types/optionals-profile.bx
(main
  (print (call greeting "Ada"))
  (print (call greeting null))
)

(fn-expr + greeting String
  (param nickname (? String))
  (if-expr nickname (str "Hi, " nickname) "Hello, stranger")
)
