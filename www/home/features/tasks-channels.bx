; name: Tasks & channels
; category: systems
; size: medium
; summary: `do-new` starts a lightweight task, and channels carry values between tasks.
; examples: basics/concurrency/channels-ping-pong.bx, basics/concurrency/parallel-fetch.bx, basics/concurrency/threads-prime-count.bx
(main
  (let numbers (channel Int))
  (do-new
    (for (in n (.. 1 3))
      (<- numbers n)
    )
    (call (. numbers close))
  )
  (for (in n numbers)
    (print (str "got " n))
  )
)
