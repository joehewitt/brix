; name: Classes & interfaces
; category: basics
; size: small
; summary: Classes have properties, constructors and methods, and an interface names what any type that implements it can do.
; examples: basics/classes/properties-thermostat.bx, basics/classes/delegation-logger.bx, basics/functions/multiple-dispatch.bx
(main
  (let shapes (list Shape) (list (call Square 2) (call Circle 1)))
  (for (in shape shapes)
    (print (call (. shape area)))
  )
)

(type + Shape (is Interface)
  (fn-expr + area Float)
)

(type + Square
  (implements Shape)
  (prop + side Float)
  (fn-do + This _
    (param side _)
  )
  (fn-expr + area Float
    (* side side)
  )
)

(type + Circle
  (implements Shape)
  (prop + radius Float)
  (fn-do + This _
    (param radius _)
  )
  (fn-expr + area Float
    (* 3.14159 radius radius)
  )
)
