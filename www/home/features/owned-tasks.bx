; name: Owned tasks
; category: systems
; size: medium
; summary: A task started in a method belongs to its object, and one started in a state belongs to that state, so closing the object or leaving the state cancels it.
; examples: gui/quakes/quakes-window.bx, gui/basics/download.bx, tui/timer.bx
(import /time/duration)

(main
  (let poller (call Poller))
  (call (. poller start))
  (call (. 250ms wait))
  (call (. poller close))
  (call (. 250ms wait))
  (print "closed, and the polling stopped")
)

(type + Poller
  (fn-do + start _
    (do-new
      (while true
        (print "polling")
        (call (. 100ms wait))
      )
    )
  )
  (fn-do + close _)
)
