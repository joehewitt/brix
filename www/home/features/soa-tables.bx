; name: SoA tables
; category: systems
; size: medium
; summary: A table stores each field of its rows as an array of its own, so a pass over one field reads one block of memory.
; examples: basics/collections/tables-particles.bx
(import /core/table)

(main
  (let particles (call (of Table Particle) 4 (:with (call Particle 0 (as each F32)))))
  (for (in i (..< 0 (. particles length)))
    (+= (. ([] particles i) x) (. ([] particles i) speed))
  )
  (print (call ", " (. particles x)))
)

(type + Particle (is Struct)
  (prop + x F32)
  (prop + speed F32)
)
