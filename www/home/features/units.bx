; name: Units
; category: basics
; size: medium
; summary: A unit written after a number makes it a value of that unit's type, and units of one family convert on their own.
; examples: basics/types/units-recipe.bx, basics/types/units-pitch.bx, basics/types/units-pace.bx
(import /time/duration)
(import /units)

(main
  (let timeout Seconds 1500ms)
  (print (as timeout UnitString))
  (print (as (+ 8hours 30minutes) UnitString))
  (print (as (+ 2km 300meters) UnitString))
  (print (< 500ms 1s))
)
