; name: Arenas
; category: systems
; size: medium
; summary: An arena holds memory the collector never sees, and frees all of it at once.
(import /core/arena)

(main
  (let arena (use (call Arena)))
  (let squares (call (of Array I64) arena 1000))
  (for (in i (..< 0 1000))
    (= ([] squares i) (* i i))
  )
  (print ([] squares 999))
)
