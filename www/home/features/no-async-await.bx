; name: No async/await
; category: basics
; size: large
; summary: A function that waits is written and called like any other, so nothing has to be marked `async` and no library needs a second, async copy of itself.
; examples: basics/concurrency/parallel-fetch.bx, basics/streams/one-function-any-source.bx, basics/streams/library-running-balance.bx
(import /time/duration)

(main
  (do-new
    (print (call slow-greeting "Ada"))
  )
  (print (call slow-greeting "Grace"))
)

(fn-do + slow-greeting String
  (param name String)
  (call (. 100ms wait))
  (return (str "Hello, " name))
)
