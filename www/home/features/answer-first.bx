; name: Answer-first functions
; category: basics
; size: large
; summary: A function states its answer first and defines the parts below it, each worked out only if the answer reads it.
; examples: basics/classics/mandelbrot.bx, basics/functions/text-bodies-receipt.bx
(main
  (print (call describe-order 3 4.5 true))
)

(fn-expr + describe-order String
  (param count Int)
  (param price Float)
  (param is-member Bool)
  (str count " items, " total " total")
  (where
    (lazy subtotal (* count price))
    (lazy discount (if-expr is-member 0.1 0.0))
    (lazy total (* subtotal (- 1 discount)))
  )
)
