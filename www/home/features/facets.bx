; name: Facets
; category: basics
; size: medium
; summary: A class can be split into facets, each in a file of its own with its own stored state and private members, and together they are still one object.
; examples: basics/classes/facets-document.bx, basics/classes/document.history.bx, basics/classes/document.search.bx
(main
  (let draft (call Document))
  (call (. draft type-text) "hello")
  (call (. draft type-text) ", world")
  (call (. draft undo))
  (print (. draft text))
)

(type + Document
  (prop + text String (= ""))
  (fn-do + type-text _
    (param more String)
    (call record)
    (= text (++ text more))
  )
)

(type + DocumentHistory (facet-of Document)
  (prop _ earlier (list String) (= (call (of List String))))
  (fn-do ^ record _
    (+= earlier text)
  )
  (fn-do + undo _
    (= text (?? (call (. earlier pop)) text))
  )
)
