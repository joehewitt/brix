; name: Markup
; category: front-end
; size: large
; summary: Markup makes real objects of any class, not just one framework's elements as JSX does, with loops and branches inside it, and the parts that read tracked values follow them.
; examples: basics/markup/data-file-tree.bx, graphics/vector-flower.bx, basics/markup/cli-options.bx
(import /gui)

(main
  (let todos (list "Write docs" "Ship it"))
  (<> App
    (<> Window (• flex-col)
      (= title "Todos")
      (for (in todo #todos)
        (<> Label (text: todo))
      )
      (if (== (. #todos length) 0)
        (<> Label (text: "All done"))
      )
    )
  )
)
