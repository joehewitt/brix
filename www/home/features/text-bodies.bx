; name: Text bodies
; category: basics
; size: medium
; summary: A function whose body is the text it gives, one row for each line, with values written into it.
; examples: basics/functions/text-bodies-receipt.bx
(main
  (print (call receipt "Ada" 3 4))
)

(fn-expr + receipt _
  (param name String)
  (param count Int)
  (param price Int)
  (paragraph
    (str "Receipt for " name)
    "=============="
    (str count " cups at " price " dollars")
    (str "Total: " (* count price) " dollars")
  )
)
