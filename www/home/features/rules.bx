; name: Rules
; category: front-end
; size: medium
; summary: A class's rules run when what they read changes: `when` while a test holds, `whenever` each time a value changes.
; examples: basics/reactivity/rules-low-stock.bx
(main
  (let room (call Room))
  (= (. room celsius) 30)
  (= (. room celsius) 18)
)

(type + Room
  (prop + celsius _ (= 20.0))
  (when-rule (> #celsius 25)
    (print (str "too hot at " celsius))
  )
  (whenever-rule #celsius
    (print (str "now " celsius))
  )
)
