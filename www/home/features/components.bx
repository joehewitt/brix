; name: Components & slots
; category: front-end
; size: medium
; summary: A class's `content` builds its own markup, with slots that a caller fills by name and fallbacks for the slots it leaves empty.
; examples: tui/slots.bx, gui/basics/download.bx, tui/timer.bx
(import /gui)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Cards")
      (<> Card
        (<> Label (slot: title) (text: "Today"))
        (<> Label (text: "Write the docs."))
      )
      (<> Card
        (<> Label (text: "This card has no title."))
      )
    )
  )
)

(type + Card (is Box)
  (content
    (+<> Label (id: title)
      (<> Label (text: "Untitled"))
    )
    (+<> Box)
  )
)
