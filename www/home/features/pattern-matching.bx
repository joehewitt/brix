; name: Pattern matching
; category: basics
; size: small
; summary: A match takes values apart by shape: lists, tuples, types, union cases and text.
; examples: basics/patterns/tuples-fizzbuzz.bx, basics/patterns/lists-commands.bx, basics/patterns/maps-json.bx
(main
  (for (in words (list (list "move" "3" "4") (list "say" "hi" "there") (list "quit")))
    (print (call run words))
  )
)

(fn-expr + run String
  (param words (list String))
  (match words
    (case (list "move" x y)
      (str "moving to " x ", " y)
    )
    (case (list "say" ...rest)
      (call (. " " join) rest)
    )
    (default
      "bye"
    )
  )
)
