; name: Conversions
; category: basics
; size: medium
; summary: A type says how it becomes text, a number or a stream, and the conversion happens wherever that is wanted, even in a loop.
; examples: basics/classes/conversions-colors.bx
(main
  (let order (call Order "tea" 3))
  (print order)
  (for (in cup order)
    (print cup)
  )
)

(type + Order (is (tuple (: drink String) (: count Int)))
  (fn-to-expr + String
    (str count " cups of " drink)
  )
  (fn-to-do + (of Iterable String)
    (for (in n (.. 1 count))
      (yield (str drink " #" n))
    )
  )
)
