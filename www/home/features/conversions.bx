; name: Conversions
; category: basics
; size: medium
; summary: Once a type says how it becomes a stream, its values can be looped over like lists, and conversions to text or a number work the same way, wherever one is wanted.
; examples: basics/classes/conversions-colors.bx
(main
  (let order (call Order "tea" 3))
  (print order)
  (for (in cup order)
    (print cup)
  )
)

(type + Order (is (tuple (: drink String) (: count Int)))
  (fn-to-expr + String
    (str count " cups of " drink)
  )
  (fn-to-do + (of Iterable String)
    (for (in n (.. 1 count))
      (yield (str drink " #" n))
    )
  )
)
