; name: Pointers
; category: systems
; size: small
; summary: Pointers read and write memory from C, and an array laid over them gives back checked indexing.
; examples: basics/systems/c-headers-libc.bx
(import /stdlib.h)

(main
  (let count 5)
  (let cells (as (call C:calloc count (. I32 size)) (of CPointer I32)))
  (for (in i (..< 0 count))
    (= ([] cells i) (as (* i i) I32))
  )
  (print (call ", " (call (of Array I32) cells count)))
  (call C:free cells)
)
