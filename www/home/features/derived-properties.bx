; name: Derived properties
; category: front-end
; size: medium
; summary: A property whose value reads tracked properties stays up to date as they change.
; examples: gui/basics/counter.bx, tui/order.bx, basics/reactivity/tracked-cart.bx
(main
  (let cart (call Cart))
  (print (. cart total))
  (= (. cart quantity) 3)
  (print (. cart total))
)

(type + Cart
  (prop + quantity _ (= 1))
  (prop + price _ (= 5))
  (prop + total _ (= (* #quantity #price)))
)
