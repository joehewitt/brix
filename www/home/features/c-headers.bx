; name: C headers
; category: systems
; size: medium
; summary: Importing a C header makes its functions and constants callable as `C:` names, with no bindings to write.
; examples: basics/systems/c-headers-libc.bx, basics/systems/effects-dice.bx
(import /stdlib.h)
(import /string.h)

(main
  (let phrase "native code")
  (print (call C:strlen phrase))
  (print (call C:strstr phrase "code"))
  (print (call C:atoi "42 apples"))
)
