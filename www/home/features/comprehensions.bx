; name: Comprehensions
; category: basics
; size: medium
; summary: A comprehension describes a stream by the items it is made from, with clauses that pick among them.
; examples: basics/collections/comprehensions-word-count.bx, basics/classics/mandelbrot.bx, basics/classics/wc.bx
(main
  (let words (list "probe" "stream" "rule" "grammar" "machine"))
  (let long-words (list String) (in (. each uppercased) words (when (> (. each length) 5))))
  (print long-words)
)
