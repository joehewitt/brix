; name: Themes
; category: front-end
; size: medium
; summary: A sheet derived for a tag restates the sheet's values, and turning the tag on for an element restyles everything beneath it.
; examples: gui/basics/themes.bx, gui/loom/loom-app.bx, gui/sequencer/sequencer-app.bx
(import /graphics/color)
(import /gui)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Themes")
      (<> Panel (• flex-col) (for: night)
        (<> Label (text: "Good evening") (• greeting))
      )
    )
  )
)

(type + Panel (is Box)
  (using PanelTheme)
)

(style PanelTheme
  (using GUIDefaultTheme)
  (prop + paper-color RGBA (= (call RGBA "#fffdf8")))
  (prop + ink-color RGBA (= (call RGBA "#2b2622")))
  (rule greeting (• text ink-color) (• bg paper-color) (• p 16))
)

(style PanelNightTheme (is PanelTheme) (for night)
  (prop + paper-color _ (= (call RGBA "#1c1917")))
  (prop + ink-color _ (= (call RGBA "#f5f5f4")))
)
