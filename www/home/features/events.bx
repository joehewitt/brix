; name: Events
; category: front-end
; size: medium
; summary: A class declares the events it publishes, and every subscriber runs as soon as a value is sent.
; examples: basics/reactivity/events-newsletter.bx, basics/state-machines/vending-machine.bx, tui/timer.bx
(main
  (let door (call Door))
  (for (on who (. door rang))
    (print (str "ding dong: " who))
  )
  (call (. door ring) "Ada")
  (<- (. door rang) "Bo")
)

(type + Door
  (event + rang String)
  (fn-do + ring _
    (param who String)
    (<- rang who)
  )
)
