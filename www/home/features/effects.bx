; name: Effects
; category: systems
; size: large
; summary: A library names the doors through which code reaches the outside world, so `without` can forbid one through every call below it and `do-with` can swap in a fake, with no annotations on the functions in between and no mocking framework.
; examples: basics/systems/effects-dice.bx, basics/systems/effects-reminders.bx
(import /stdlib.h)

(main
  (print (call total-of (call throw-dice 3)))
  (do-with dice (call LoadedDice)
    (print (call throw-dice 3))
  )
)

(effect + dice
  (claim C:arc4random_uniform)
)

(fn-do + roll Int (door dice)
  (return (+ (as (call C:arc4random_uniform 6) Int) 1))
)

(fn-expr + throw-dice (list Int)
  (param count Int)
  (in (call roll) (..< 0 count))
)

(fn-do + total-of Int (without dice)
  (param hand (list Int))
  (let total 0)
  (for (in face hand)
    (+= total face)
  )
  (return total)
)

(type + LoadedDice
  (fn-do + roll Int
    (return 6)
  )
)
