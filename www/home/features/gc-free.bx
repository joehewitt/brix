; name: GC-free zones
; category: systems
; size: large
; summary: `without gc` makes the compiler prove that a function, and everything it calls, never allocates, never pauses for the collector and never waits.
; examples: basics/systems/gc-free-synth.bx
(main
  (let samples (call (of Array F64) (list 0.5 0.25 -0.75)))
  (print (call peak samples))
)

(fn-do + peak F64 (without gc)
  (param samples (of Array F64))
  (let top 0.0)
  (for (in sample samples)
    (if (> sample top)
      (= top sample)
    )
  )
  (return top)
)
