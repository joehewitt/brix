; name: Generators
; category: basics
; size: medium
; summary: A function that yields gives its items one at a time, as they are read, and a generator marked `@inline` fuses into the loop that reads it.
; examples: basics/streams/generator-primes.bx, basics/pipelines/fusion.bx, basics/classics/eight-queens.bx
(main
  (for (in n (call fibonacci) (while (< n 100)))
    (print n)
  )
)

(fn-do + fibonacci (stream Int) @inline
  (let a 0)
  (let b 1)
  (while true
    (yield a)
    (let next (+ a b))
    (= a b)
    (= b next)
  )
)
