; name: Named arguments
; category: basics
; size: small
; summary: Any argument can be given by name, and parameters named with prepositions make a call read like a phrase.
; examples: basics/data/csv-report.bx
(main
  (print (call move "box" (:from 3) (:to 8)))
  (print (call move "lamp" (:to 2)))
)

(fn-expr + move String
  (param item String)
  (param to Int)
  (param from Int (= 0))
  (str "move the " item " from " from " to " to)
)
