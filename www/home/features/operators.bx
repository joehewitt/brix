; name: Operator overloading
; category: basics
; size: small
; summary: A type says what `+`, `*` and the other operators mean for its values, and any function of two values can be written between slashes as an operator.
; examples: basics/classes/operators-vector.bx
(main
  (let wind (call Vector 3 4))
  (let current (call Vector 1 -2))
  (print (+ wind current))
  (print (* wind 2))
  (print (/dot/ wind current))
)

(type + Vector (is Tuple)
  (prop + x Int)
  (prop + y Int)
  (fn-expr + (infix this + (param other Vector)) _
    (call Vector (+ x (. other x)) (+ y (. other y)))
  )
  (fn-expr + (infix this * (param factor Int)) _
    (call Vector (* x factor) (* y factor))
  )
)

(fn-expr + dot Int
  (param a Vector)
  (param b Vector)
  (+ (* (. a x) (. b x)) (* (. a y) (. b y)))
)
