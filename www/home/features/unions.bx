; name: Unions & enums
; category: basics
; size: small
; summary: A union holds one of several cases, each with its own data, and a match must cover every case.
; examples: basics/types/unions-payments.bx, basics/classics/lisp-interpreter.bx, basics/grammars/search-query.bx
(main
  (let shapes (list Shape) (list (call .circle 1.0) (call .square 2.0) .point))
  (for (in shape shapes)
    (print (call area shape))
  )
)

(type + Shape (is Union)
  (variant circle (tuple Float))
  (variant square (tuple Float))
  (variant point)
)

(fn-expr + area Float
  (param shape Shape)
  (match shape
    (case (call .circle r)
      (* 3.14159 r r)
    )
    (case (call .square side)
      (* side side)
    )
    (case .point
      0.0
    )
  )
)
