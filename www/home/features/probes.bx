; name: Probes
; category: systems
; size: large
; summary: Probes record typed values as a program runs, cost nothing in a build that leaves them out, and `brix probes` sums, times and filters what they recorded.
; examples: basics/systems/probes-channel-inspector.bx, basics/systems/probes-profile-console.bx
(main
  (let orders (list (tuple "tea" 3) (tuple "cake" 1) (tuple "tea" 2)))
  (let total 0)
  (for (in (tuple item count) orders)
    (probe-log shop.order (items: item count))
    (+= total count)
  )
  (probe-count shop.runs)
  (print total)
)
