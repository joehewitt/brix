; name: Style sheets
; category: front-end
; size: large
; summary: Style sheets are typed and checked by the compiler, with rules by name, states that follow tracked values, and motion, for views or any other tree of objects.
; examples: gui/basics/themes.bx, basics/markup/style-sheet-pricing.bx, graphics/vector-chart.bx
(import /gui)

(main
  (<> App
    (<> Window
      (= title "Notes")
      (<> NotePanel (• flex-col)
        (<> Label (text: "Buy milk") (• note))
        (<> Label (text: "Pay rent") (• note) (• urgent))
      )
    )
  )
)

(type + NotePanel (is Box)
  (using NoteTheme)
)

(style NoteTheme
  (using GUIDefaultTheme)
  (rule note (• p 8)
    (= font-size 18)
  )
  (rule urgent
    (= color gui-danger-color)
  )
)
