; name: Generics
; category: basics
; size: small
; summary: Types and functions take type parameters, and the compiler makes a copy for each set of types a program uses.
; examples: basics/classes/generics-stack.bx, basics/pipelines/generators.bx
(main
  (print (call swap (tuple 1 "one")))
  (print (call swap (tuple 2.5 true)))
)

(fn-expr + (of swap A B) (tuple B A)
  (param pair (tuple A B))
  (tuple second first)
  (where
    (lazy (tuple first second) pair)
  )
)
