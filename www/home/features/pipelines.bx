; name: Pipelines
; category: basics
; size: large
; summary: Stages keep the items that pass, change each one or tap it as it goes by, and the compiler fuses them into a single loop.
; examples: basics/pipelines/whole-program.bx, basics/pipelines/library-functions.bx, basics/pipelines/top-words.bx
(import /stream/aggregate)

(main
  (print (call big-total (list 12 40 7 33 25)))
)

(fn-expr + big-total Int
  (param prices (list Int))
  prices
  (pipe ?> (> each 20))
  (pipe *> (* each 2))
  (pipe |> sum)
)
