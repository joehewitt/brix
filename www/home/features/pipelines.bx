; name: Pipelines
; category: basics
; size: large
; summary: A pipeline runs any stream, stored or still arriving, through stages that read each item as `each` instead of taking a lambda, where a grammar or any library function can be a stage, and a pipeline read where it is written compiles into one loop.
; examples: basics/pipelines/whole-program.bx, basics/pipelines/library-functions.bx, basics/pipelines/top-words.bx
(import /core/patterns)
(import /stream/sort)

(main
  (spread "yeast,3\nflour,12\nvanilla,1\nbutter,4\n")
  (pipe ~> \item)
  (pipe ?> (< (. each count) 5))
  (pipe *> (. each name))
  (pipe |> sort)
  (pipe *> (str "reorder " each))
  (pipe |> print-all)
)

(type + Item (is Tuple)
  (prop + name String)
  (prop + count Int)
)

(fn-expr + item Item (over: Char)
  (~ (seq (: name (+ (seq (! ",") .))) "," (: count (of \num Int)) \nl)
    (call Item name count)
  )
)
