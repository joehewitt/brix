; name: Closures
; category: basics
; size: small
; summary: A function value shares the locals of the body that made it, and a call that ends in `...` gives back a function of the arguments left out.
; examples: basics/functions/closures-pricing.bx
(main
  (let next (call counter-from 10))
  (call next)
  (print (call next))
  (let add-ten (call add 10 ...))
  (print (call add-ten 5))
)

(fn-do + counter-from (fn-type Int)
  (param start Int)
  (let count start)
  (return
    (=> () :do
      (block
        (+= count 1)
        (return count)
      )
    )
  )
)

(fn-expr + add Int
  (param a Int)
  (param b Int)
  (+ a b)
)
