; name: Decision tables
; category: basics
; size: small
; summary: A value can be chosen by a table of conditions, tried in order, with a default for everything else.
; examples: tui/mesh-gradient.bx, gui/weather/weather-forecast.bx
(main
  (for (in score (list 95 82 40))
    (print (call grade score))
  )
)

(fn-expr + grade String
  (param score Int)
  (case? (>= score 90)
    "A"
  )
  (case? (>= score 80)
    "B"
  )
  (default
    "C"
  )
)
