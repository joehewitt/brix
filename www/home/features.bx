(import ./../rows/rows)
(import /data/markdown)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)

(prop _ home-feature-categories (list String) (= (list "basics" "front-end" "systems")))
(prop _ home-feature-sizes (list String) (= (list "large" "medium" "small")))

(type _ HomeFeature (is Tuple)
  (prop + slug String)
  (prop + name String)
  (prop + category String)
  (prop + size String)
  (prop + summary String)
  (prop + examples (list String))
  (prop + view String)
  (prop + code String)
)

(fn-do + home-features-html String (?! Error)
  (param folder Path)
  (param known (list String))
  (let features (list HomeFeature))
  (for (in path-text (call sort (in (str each) (. folder contents))))
    (let path (call Path path-text))
    (if (== (. path ext) "bx")
      (+= features (call home-feature-read path known))
    )
  )
  (let terms "")
  (for (in feature (call home-features-ordered features))
    (+= terms (call home-feature-term-html feature))
  )
  (let templates "")
  (for (in feature features)
    (+= templates (call home-feature-template-html feature))
  )
  (return (call home-features-section-html terms templates))
)

(fn-do _ home-feature-read HomeFeature (?! Error)
  (param path Path)
  (param known (list String))
  (let name "")
  (let category "")
  (let size "")
  (let summary "")
  (let view "rows")
  (let examples (list String))
  (let code (list String))
  (for (in line (call (. (call read-file-text path) split) "\n"))
    (if (> (. code length) 0)
      (+= code line)
      (continue)
    )
    (if (= (~ (seq "; " (: key (+ (chars "a-z"))) ": " (: value (* .)))) line)
      (match key
        (case= "name"
          (= name value)
        )
        (case= "category"
          (= category value)
        )
        (case= "size"
          (= size value)
        )
        (case= "summary"
          (= summary value)
        )
        (case= "view"
          (= view value)
        )
        (case= "examples"
          (= examples (call List (call (. value split) ", ")))
        )
        (default
          (throw (call Error (str (. path name) ": unknown front matter " key)))
        )
      )
      (continue)
    )
    (+= code line)
  )
  (let label (. path name))
  (throw (call Error (str label " has no name")) (if (== name "")))
  (throw (call Error (str label " has no summary")) (if (== summary "")))
  (throw (call Error (str label ": category " category " is not one of " home-feature-categories)) (if (not-in category home-feature-categories)))
  (throw (call Error (str label ": size " size " is not one of " home-feature-sizes)) (if (and (!= size "") (not-in size home-feature-sizes))))
  (for (in example examples)
    (throw (call Error (str label " links " example ", which is not an example")) (if (not-in example known)))
  )
  (return (call HomeFeature (. path base-name) name category size summary examples view (call (. (call (. "\n" join) code) trim))))
)

(fn-do _ home-features-ordered (list HomeFeature)
  (param features (list HomeFeature))
  (let groups (list (list HomeFeature)))
  (for (in category home-feature-categories)
    (let sized (list (list HomeFeature)))
    (for (in size home-feature-sizes)
      (+= sized (call List (in each features (when (and (== (. each category) category) (== (. each size) size))))))
    )
    (+= groups (call home-features-spread sized 0.0))
  )
  (return (call home-features-spread groups 0.5))
)

(fn-do _ home-features-spread (list HomeFeature)
  (param groups (list (list HomeFeature)))
  (param offset Float)
  (let taken (list Index))
  (for (in groups)
    (+= taken 0)
  )
  (let spread (list HomeFeature))
  (while true
    (let best Index -1)
    (let best-place 2.0)
    (for (in index (..< 0 (. groups length)))
      (let count (. ([] groups index) length))
      (let next ([] taken index))
      (if (< next count)
        (let place (/ (+ next offset) count))
        (if (< place best-place)
          (= best index)
          (= best-place place)
        )
      )
    )
    (if (< best 0)
      (break)
    )
    (+= spread ([] ([] groups best) ([] taken best)))
    (+= ([] taken best) 1)
  )
  (return spread)
)

(fn-expr _ home-feature-term-html String
  (param feature HomeFeature)
  (str "<button type=\"button\" class=\"feature-term\" data-feature=\"" slug "\" data-category=\"" (. feature category) "\" data-size=\"" (. feature size) "\" aria-controls=\"feature-card\" aria-expanded=\"false\">" (call html-text (. feature name)) "</button>")
  (where
    (lazy slug (call html-attribute (. feature slug)))
  )
)

(fn-do _ home-feature-template-html String (?! Error)
  (param feature HomeFeature)
  (let source (use (call rows-document (. feature code) (str (. feature slug) ".bx"))))
  (let summary (call markdown-to-html (call Markdown (. feature summary))))
  (let rows (call rows-html source))
  (let forms (call html-text (. feature code)))
  (let is-both (== (. feature view) "both"))
  (let rows-label (if-expr is-both "<p class=\"feature-code-label\">For humans</p>" ""))
  (let forms-label (if-expr is-both "<p class=\"feature-code-label\">For agents</p>" ""))
  (let rows-block (str "<div class=\"brix-rows\">" rows-label rows "</div>"))
  (let forms-block (str "<div class=\"brix-forms\">" forms-label "<pre><code class=\"language-brix\">" forms "</code></pre></div>"))
  (return
    (str
      "<template data-feature-template=\""
      (call html-attribute (. feature slug))
      "\" data-name=\""
      (call html-attribute (. feature name))
      "\" data-category=\""
      (. feature category)
      "\" data-size=\""
      (. feature size)
      "\"><div class=\"feature-summary\">"
      summary
      "</div><div class=\"feature-code\" data-view=\""
      (. feature view)
      "\">"
      (if-expr is-both (++ forms-block rows-block) (++ rows-block forms-block))
      "</div>"
      (call home-feature-examples-html (. feature examples))
      "</template>"
    )
  )
)

(fn-expr _ home-feature-examples-html String
  (param examples (list String))
  (if-expr (== (. examples length) 0) "" (str "<p class=\"feature-examples\"><span>Examples</span>" links "</p>"))
  (where
    (lazy links (call (. "" join) (in (call home-feature-example-html each) examples)))
  )
)

(fn-expr _ home-feature-example-html String
  (param example String)
  (str "<a href=\"#" link "\" data-example-link=\"" link "\">" (call html-text example) "</a>")
  (where
    (lazy link (call html-attribute example))
  )
)

(fn-expr _ home-features-section-html String
  (param terms String)
  (param templates String)
  (paragraph
    "<section class=\"features\" id=\"features\" data-features aria-label=\"Features\">"
    (str "<div class=\"feature-cloud\">" terms "</div>")
    "<ul class=\"feature-legend\">"
    "<li data-category=\"basics\">Basics</li>"
    "<li data-category=\"front-end\">Front end</li>"
    "<li data-category=\"systems\">Systems</li>"
    "</ul>"
    "<div class=\"feature-card\" id=\"feature-card\" role=\"dialog\" aria-labelledby=\"feature-card-name\" hidden data-feature-card>"
    "<div class=\"feature-card-bar\">"
    "<span class=\"feature-card-name\" id=\"feature-card-name\" data-feature-name></span>"
    "<span class=\"feature-card-category\" data-feature-category></span>"
    "<button type=\"button\" class=\"source-toggle\" data-source-toggle aria-pressed=\"false\" hidden>Source</button>"
    "<button type=\"button\" class=\"feature-card-close\" data-feature-close aria-label=\"Close\">&times;</button>"
    "</div>"
    "<div class=\"feature-card-body\" data-feature-body></div>"
    "</div>"
    (str templates)
    "</section>"
  )
)
