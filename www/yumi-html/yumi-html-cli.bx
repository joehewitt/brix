(import ./source-html)
(import /data/markdown)
(import /os/cli)
(import /os/file)
(import /os/path)
(blank)

(main
  (call run)
)

(fn-do + run _
  (let command (call cmdline-args))
  (throw (call Error "Usage: yumi-html <source.yumi|document.md>") (if (!= (. command length) 2)))
  (blank)
  (let source-path String ([] command 1))
  (let source (call read-file-text (call Path source-path)))
  (blank)
  (if (call (. source-path ends-with) ".md")
    (call (. stdout write) (call markdown-to-html (call Markdown source) markdown-fenced-code))
    (else
      (call (. stdout write) (call yumi-source-html source source-path))
    )
  )
)

(fn-expr _ markdown-fenced-code String
  (param code MDFencedCode)
  (case? (== (. code language) "yumi")
    (call yumi-source-code-html (. code body))
  )
  (case? (. code language)
    (call markdown-language-fenced-code (call html-attribute (. code language)) (call html-text (. code body)))
  )
  (default
    (call markdown-plain-fenced-code (call html-text (. code body)))
  )
)

(fn-expr _ markdown-language-fenced-code _
  (param language String)
  (param body String)
  (paragraph
    (str "<pre><code class=\"language-" language "\">" body "</code></pre>")
  )
)

(fn-expr _ markdown-plain-fenced-code _
  (param body String)
  (paragraph
    (str "<pre><code>" body "</code></pre>")
  )
)

(fn-expr _ html-text String
  (param text String)
  (call (. "" join) (in (call html-character each) text))
)

(fn-expr _ html-attribute String
  (param text String)
  (call (. "" join) (in (call html-attribute-character each) text))
)

(fn-expr _ html-character String
  (param char Char)
  (case? (== char '&')
    "&amp;"
  )
  (case? (== char '<')
    "&lt;"
  )
  (case? (== char '>')
    "&gt;"
  )
  (default
    (as char String)
  )
)

(fn-expr _ html-attribute-character String
  (param char Char)
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (call html-character char)
  )
)
