━━━━━━━━━━━━━━━━━━━━
+ do yumi-source-presentation SourcePresentation
    - source String
    - source-path = ""

. parsed = parse-yumi-tracked(source, source-path)
. builder = parsed.tree
use builder
. infos = syntax-infos(builder)
. atoms = use AtomPool()
. tree = builder.finish(atoms)
use tree
. ranges = source-ranges(tree, infos, parsed.tracking)
. scopes = syntax-scopes(tree, infos, ranges, source)
scopes ++= lexical-scopes
    - source
    - parsed.tracking.source-line-starts
    - parsed.tracking.trivia
    - parsed.grammar-word-ranges
    - scopes
. runs = source-runs(source, scopes, ranges, parsed.tracking.trivia)
. nodes = source-presentation-nodes(tree, infos, ranges)
= SourcePresentation(source-path, tree.root, nodes, runs)

