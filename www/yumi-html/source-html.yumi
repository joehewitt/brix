+ escapes [SourceRange]

━━━━━━━━━━━━━━━━━━━━
_ do render-yumi-source String
    - source String
    - source-path String
    - include-presentation Bool

. presentation = yumi-source-presentation(source, source-path)
. code = render-source-code-compact(source, presentation.runs)
if include-presentation
    code = render-source-code(source, presentation.runs)
. source-html = source-code-html(code)

=? compact-source-html(source-html) if !include-presentation
. data = presentation-json(presentation, source)
. data-html = source-presentation-data-html(script-safe-json(to-json(data)))
= source-presentation-html(source-html, data-html)

