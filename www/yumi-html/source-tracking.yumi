/core/arena
/core/atom-pool
/core/parsing
/lang/ast/ast-builder
/lang/ast/ast-nodes
/lang/ast/error
/lang/ast/grammar
/lang/ast/preparse

━━━━━━━━━━━━━━━━━━━━
+ PreparseSpanKind is U8

| copied = 0
| inserted = 1
| replaced = 2
| removed = 3

━━━━━━━━━━━━━━━━━━━━
+ PreparseTriviaKind is U8

| comment = 0
| divider-class = 1
| divider-function = 2
| divider-header = 3

━━━━━━━━━━━━━━━━━━━━
+ SourceRange is Tuple

+ start Index
+ end Index

━━━━━━━━━━━━━━━━━━━━
+ PreparseSpan is Tuple

+ prepared-start Index
+ prepared-end Index
+ source-start Index
+ source-end Index
+ kind PreparseSpanKind

━━━━━━━━━━━━━━━━━━━━
+ PreparseTrivia is Tuple

+ start Index
+ end Index
+ kind PreparseTriviaKind

━━━━━━━━━━━━━━━━━━━━
+ TrackedPreparse is Tuple

+ spans [PreparseSpan]
+ trivia [PreparseTrivia]
+ source-line-starts [Index]
+ line-starts [Index]
+ prepared-length Size

────────────────────
+ do source-range SourceRange?
    - location MatchLocation

. begin = prepared-offset(line-starts, prepared-length, location.begin)
. end = prepared-offset(line-starts, prepared-length, location.end)
if end < prepared-length
    end += 1
if end < begin
    end = begin
= source-range(begin, end)

────────────────────
+ do source-range SourceRange?
    - begin Index
    - end Index

. source-start = Index.max
. source-end Index = 0
for span in spans
    if span.kind != .copied && span.kind != .replaced
        continue
    if span.prepared-start < end && span.prepared-end > begin
        if span.source-start < source-start
            source-start = span.source-start
        if span.source-end > source-end
            source-end = span.source-end

=? if source-start == Index.max
= SourceRange(source-start, source-end)

━━━━━━━━━━━━━━━━━━━━
+ TrackedYumiSyntax is Tuple

+ tree ASTBuilder
+ tracking TrackedPreparse
+ grammar-word-ranges [SourceRange]

━━━━━━━━━━━━━━━━━━━━
+ parse-yumi-tracked TrackedYumiSyntax ?! YumiSyntaxError
    - source String
    - source-path = ""

parse-yumi-tracked(source, source-path, scratch)

.. scratch = use Arena()

━━━━━━━━━━━━━━━━━━━━
+ do parse-yumi-tracked TrackedYumiSyntax ?! YumiSyntaxError
    - source String
    - source-path String
    - scratch Arena

. prepared = preparse(source, scratch)
. tracking = track-preparse(source, prepared)
. tree = ASTBuilder(source, source-path)
. context = LiteralTrackingParseContext(tree)

tree = parse-yumi-preparsed-with
    - prepared
    - source
    - source-path
    - scratch
    - tree
    - context

. grammar-word-ranges [SourceRange]
for literal in context.literals
    . range = tracking.source-range(literal.start, literal.end)
    if range
        grammar-word-ranges += range

= TrackedYumiSyntax(tree, tracking, grammar-word-ranges)

━━━━━━━━━━━━━━━━━━━━
_ PreparedLiteral is Tuple

+ start Index
+ end Index

━━━━━━━━━━━━━━━━━━━━
_ LiteralTrackingParseContext
    is PatternCollectorStorage'ArenaBacking
    is PatternMaterializationRoot'SyntaxId
    is PatternCaptureMaterializer'Char'String
    is PatternValueMaterializer'String'String
    is PatternCaptureMaterializer'Char'Atom
    is PatternValueMaterializer'String'Atom
    is PatternRollback'ASTBuilderMark
    is PatternLiteralObserver

+ literals [PreparedLiteral]

as PatternCollectorStorage'ArenaBacking, PatternMaterializationRoot'SyntaxId for
as PatternCaptureMaterializer'Char'String, PatternValueMaterializer'String'String for
as PatternCaptureMaterializer'Char'Atom, PatternValueMaterializer'String'Atom for
as PatternRollback'ASTBuilderMark for
_ tree ASTBuilder

────────────────────
+ This
    - tree

────────────────────
+ do record-pattern-literal
    - start Index
    - end Index

literals += PreparedLiteral(start, end)

────────────────────
+ do rewind-pattern-literals
    - cursor Index

while literals && literals[literals.length - 1].end > cursor
    literals.pop()

━━━━━━━━━━━━━━━━━━━━
_ SourceTriviaLine is Tuple

+ text String
+ start Index
+ end Index

━━━━━━━━━━━━━━━━━━━━
_ SourceTriviaKind is U8

| trivia-none = 0
| trivia-comment = 1
| trivia-divider-class = 2
| trivia-divider-function = 3
| trivia-divider-header = 4

━━━━━━━━━━━━━━━━━━━━
_ do track-preparse TrackedPreparse
    - source String
    - prepared Char[]

. source-line-starts [Index] = [0]
for index in 0 .. < source.length
    if source[index] == '\n'
        source-line-starts += index + 1

. prepared-line-starts [Index] = [0]
for index in 0 .. < prepared.length
    if prepared[index] == '\n'
        prepared-line-starts += index + 1

. spans [PreparseSpan]
for line in 0 .. < prepared-line-starts.length - 1
    . prepared-start = prepared-line-starts[line]
    . prepared-end = prepared-line-starts[line + 1] - 1
    . source-start = source.length
    . source-end = source.length
    . has-source-line = line < source-line-starts.length
    if has-source-line
        source-start = source-line-starts[line]
        source-end = source.length
        if line + 1 < source-line-starts.length
            source-end = source-line-starts[line + 1] - 1
    track-preparse-line
        - spans
        - source
        - source-start
        - source-end
        - prepared
        - prepared-start
        - prepared-end
    if has-source-line && source-end < source.length
        spans += PreparseSpan
            - prepared-end
            - prepared-end + 1
            - source-end
            - source-end + 1
            - .copied
    else
        spans += PreparseSpan
            - prepared-end
            - prepared-end + 1
            - source-end
            - source-end
            - .inserted

= TrackedPreparse
    - spans
    - source-trivia(source, source-line-starts)
    - source-line-starts
    - prepared-line-starts
    - prepared.length

━━━━━━━━━━━━━━━━━━━━
_ do track-preparse-line
    - spans [PreparseSpan]
    - source String
    - source-start Index
    - source-end Index
    - prepared Char[]
    - prepared-start Index
    - prepared-end Index

. source-cursor = source-start
for prepared-index in prepared-start .. < prepared-end
    . char = prepared[prepared-index]
    if is-synthetic-preparse-char(source, source-cursor, source-end, char)
        spans += PreparseSpan
            - prepared-index
            - prepared-index + 1
            - source-cursor
            - source-cursor
            - .inserted
        continue
    . found = find-source-char(source, source-cursor, source-end, char)
    if found
        if found > source-cursor
            spans += PreparseSpan(prepared-index, prepared-index, source-cursor, found, .removed)
        spans += PreparseSpan(prepared-index, prepared-index + 1, found, found + 1, .copied)
        source-cursor = found + 1
    else if source-cursor < source-end
        spans += PreparseSpan
            - prepared-index
            - prepared-index + 1
            - source-cursor
            - source-cursor + 1
            - .replaced
        source-cursor += 1
    else
        spans += PreparseSpan
            - prepared-index
            - prepared-index + 1
            - source-cursor
            - source-cursor
            - .inserted

if source-cursor < source-end
    spans += PreparseSpan(prepared-end, prepared-end, source-cursor, source-end, .removed)

━━━━━━━━━━━━━━━━━━━━
_ do find-source-char Index?
    - source String
    - start Index
    - end Index
    - wanted Char

for index in start .. < end
    =? index if source[index] == wanted

━━━━━━━━━━━━━━━━━━━━
_ is-preparse-marker Bool
    - char Char

char == '≤' || char == '≥' || char == 'Æ' || char == '═'

━━━━━━━━━━━━━━━━━━━━
_ is-synthetic-preparse-char Bool
    - source String
    - source-cursor Index
    - source-end Index
    - char Char

|? !is-preparse-marker(char)
    false
|? source-cursor >= source-end
    true
??
    source[source-cursor] != char

━━━━━━━━━━━━━━━━━━━━
_ source-trivia [PreparseTrivia]
    - source String
    - line-starts [Index]

<* item in items when item
    item

.. items = source-trivia-items(source, line-starts)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-items ImmutableArray'(PreparseTrivia?)
    - source String
    - line-starts [Index]

match source
    ~ items \source-trivia-item(line-starts)* !.
        items
    ?! Panic("Source trivia lexer did not consume its input")

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-item ~ Char PreparseTrivia?
    - line-starts [Index]

~ line \source-trivia-line(line-starts) \nl
    source-trivia-at(line)
~ line \source-trivia-final-line(line-starts) !.
    source-trivia-at(line)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-line ~ Char SourceTriviaLine
    - line-starts [Index]

~ text (!\nl .)*
    source-trivia-line-at(text, location, line-starts)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-final-line ~ Char SourceTriviaLine
    - line-starts [Index]

~ text (!\nl .)+
    source-trivia-line-at(text, location, line-starts)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-line-at SourceTriviaLine
    - text String
    - location MatchLocation
    - line-starts [Index]

SourceTriviaLine(text, range.start, range.end)

.. range = tracked-source-range-at(location, line-starts)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-at PreparseTrivia?
    - line SourceTriviaLine

match source-trivia-kind(line.text)
    |= .trivia-none
        null
    |= .trivia-comment
        PreparseTrivia(line.start, line.end, .comment)
    |= .trivia-divider-class
        PreparseTrivia(line.start, line.end, .divider-class)
    |= .trivia-divider-function
        PreparseTrivia(line.start, line.end, .divider-function)
    |= .trivia-divider-header
        PreparseTrivia(line.start, line.end, .divider-header)

━━━━━━━━━━━━━━━━━━━━
_ source-trivia-kind SourceTriviaKind
    - line String

match line
    ~ (" " | "\t" | "\r")* "`" .* !.
        .trivia-comment
    ~ "━"{3} "━"* !.
        .trivia-divider-class
    ~ "─"{3} "─"* !.
        .trivia-divider-function
    ~ "═"{3} "═"* !.
        .trivia-divider-header
    ??
        .trivia-none

━━━━━━━━━━━━━━━━━━━━
_ tracked-source-range-at SourceRange
    - location MatchLocation
    - line-starts [Index]

SourceRange(start, end)

.. start = line-starts[location.begin.line] + location.begin.column
.. end = line-starts[location.end.line] + location.end.column + 1

━━━━━━━━━━━━━━━━━━━━
_ prepared-offset Index
    - line-starts [Index]
    - prepared-length Size
    - location TokenLocation

|? location.line >= line-starts.length
    prepared-length
|? offset > prepared-length
    prepared-length
??
    offset

.. offset = line-starts[location.line] + location.column
