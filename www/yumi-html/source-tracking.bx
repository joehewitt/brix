(import /core/arena)
(import /core/atom-pool)
(import /core/parsing)
(import /lang/ast/ast-builder)
(import /lang/ast/ast-nodes)
(import /lang/ast/error)
(import /lang/ast/grammar)
(import /lang/ast/preparse)

(type + PreparseSpanKind (is U8)
  (variant copied (= 0))
  (variant inserted (= 1))
  (variant replaced (= 2))
  (variant removed (= 3))
)

(type + PreparseTriviaKind (is U8)
  (variant comment (= 0))
  (variant divider-class (= 1))
  (variant divider-function (= 2))
  (variant divider-header (= 3))
)

(type + SourceRange (is Tuple)
  (prop + start Index)
  (prop + end Index)
)

(type + PreparseSpan (is Tuple)
  (prop + prepared-start Index)
  (prop + prepared-end Index)
  (prop + source-start Index)
  (prop + source-end Index)
  (prop + kind PreparseSpanKind)
)

(type + PreparseTrivia (is Tuple)
  (prop + start Index)
  (prop + end Index)
  (prop + kind PreparseTriviaKind)
)

(type + TrackedPreparse (is Tuple)
  (prop + spans (list PreparseSpan))
  (prop + trivia (list PreparseTrivia))
  (prop + source-line-starts (list Index))
  (prop + line-starts (list Index))
  (prop + prepared-length Size)
  (fn-do + source-range (? SourceRange)
    (param location MatchLocation)
    (let begin (call prepared-offset line-starts prepared-length (. location begin)))
    (let end (call prepared-offset line-starts prepared-length (. location end)))
    (if (< end prepared-length)
      (+= end 1)
    )
    (if (< end begin)
      (= end begin)
    )
    (return (call source-range begin end))
  )
  (fn-do + source-range (? SourceRange)
    (param begin Index)
    (param end Index)
    (let source-start (. Index max))
    (let source-end Index 0)
    (for (in span spans)
      (if (and (!= (. span kind) .copied) (!= (. span kind) .replaced))
        (continue)
      )
      (if (and (< (. span prepared-start) end) (> (. span prepared-end) begin))
        (if (< (. span source-start) source-start)
          (= source-start (. span source-start))
        )
        (if (> (. span source-end) source-end)
          (= source-end (. span source-end))
        )
      )
    )
    (blank)
    (return-if (if (== source-start (. Index max))))
    (return (call SourceRange source-start source-end))
  )
)

(type + TrackedYumiSyntax (is Tuple)
  (prop + tree ASTBuilder)
  (prop + tracking TrackedPreparse)
  (prop + grammar-word-ranges (list SourceRange))
)

(fn-expr + parse-yumi-tracked TrackedYumiSyntax (?! YumiSyntaxError)
  (param source String)
  (param source-path _ (= ""))
  (call parse-yumi-tracked source source-path scratch)
  (where
    (lazy scratch (use (call Arena)))
  )
)

(fn-do + parse-yumi-tracked TrackedYumiSyntax (?! YumiSyntaxError)
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (let prepared (call preparse source scratch))
  (let tracking (call track-preparse source prepared))
  (let tree (call ASTBuilder source source-path))
  (let context (call LiteralTrackingParseContext tree))
  (blank)
  (= tree
    (call parse-yumi-preparsed-with
      (block
        (arg prepared)
        (arg source)
        (arg source-path)
        (arg scratch)
        (arg tree)
        (arg context)
      )
    )
  )
  (blank)
  (let grammar-word-ranges (list SourceRange))
  (for (in literal (. context literals))
    (let range (call (. tracking source-range) (. literal start) (. literal end)))
    (if range
      (+= grammar-word-ranges range)
    )
  )
  (blank)
  (return (call TrackedYumiSyntax tree tracking grammar-word-ranges))
)

(type _ PreparedLiteral (is Tuple)
  (prop + start Index)
  (prop + end Index)
)

(type _ LiteralTrackingParseContext
  (implements (of PatternCollectorStorage ArenaBacking))
  (implements (of PatternMaterializationRoot SyntaxId))
  (implements (of PatternCaptureMaterializer Char String))
  (implements (of PatternValueMaterializer String String))
  (implements (of PatternCaptureMaterializer Char Atom))
  (implements (of PatternValueMaterializer String Atom))
  (implements (of PatternRollback ASTBuilderMark))
  (implements PatternLiteralObserver)
  (prop + literals (list PreparedLiteral))
  (blank)
  (delegate (of PatternCollectorStorage ArenaBacking) (of PatternMaterializationRoot SyntaxId))
  (delegate (of PatternCaptureMaterializer Char String) (of PatternValueMaterializer String String))
  (delegate (of PatternCaptureMaterializer Char Atom) (of PatternValueMaterializer String Atom))
  (delegate (of PatternRollback ASTBuilderMark))
  (prop _ tree ASTBuilder)
  (fn-do + This _
    (param tree _)
  )
  (fn-do + record-pattern-literal _
    (param start Index)
    (param end Index)
    (+= literals (call PreparedLiteral start end))
  )
  (fn-do + rewind-pattern-literals _
    (param cursor Index)
    (while (and literals (> (. ([] literals (- (. literals length) 1)) end) cursor))
      (call (. literals pop))
    )
  )
)

(type _ SourceTriviaLine (is Tuple)
  (prop + text String)
  (prop + start Index)
  (prop + end Index)
)

(type _ SourceTriviaKind (is U8)
  (variant trivia-none (= 0))
  (variant trivia-comment (= 1))
  (variant trivia-divider-class (= 2))
  (variant trivia-divider-function (= 3))
  (variant trivia-divider-header (= 4))
)

(fn-do _ track-preparse TrackedPreparse
  (param source String)
  (param prepared ([] Char))
  (let source-line-starts (list Index) (list 0))
  (for (in index (..< 0 (. source length)))
    (if (== ([] source index) (char "\n"))
      (+= source-line-starts (+ index 1))
    )
  )
  (blank)
  (let prepared-line-starts (list Index) (list 0))
  (for (in index (..< 0 (. prepared length)))
    (if (== ([] prepared index) (char "\n"))
      (+= prepared-line-starts (+ index 1))
    )
  )
  (blank)
  (let spans (list PreparseSpan))
  (for (in line (..< 0 (- (. prepared-line-starts length) 1)))
    (let prepared-start ([] prepared-line-starts line))
    (let prepared-end (- ([] prepared-line-starts (+ line 1)) 1))
    (let source-start (. source length))
    (let source-end (. source length))
    (let has-source-line (< line (. source-line-starts length)))
    (if has-source-line
      (= source-start ([] source-line-starts line))
      (= source-end (. source length))
      (if (< (+ line 1) (. source-line-starts length))
        (= source-end (- ([] source-line-starts (+ line 1)) 1))
      )
    )
    (call track-preparse-line
      (block
        (arg spans)
        (arg source)
        (arg source-start)
        (arg source-end)
        (arg prepared)
        (arg prepared-start)
        (arg prepared-end)
      )
    )
    (if (and has-source-line (< source-end (. source length)))
      (+= spans
        (call PreparseSpan
          (block
            (arg prepared-end)
            (arg (+ prepared-end 1))
            (arg source-end)
            (arg (+ source-end 1))
            (arg .copied)
          )
        )
      )
      (else
        (+= spans
          (call PreparseSpan
            (block
              (arg prepared-end)
              (arg (+ prepared-end 1))
              (arg source-end)
              (arg source-end)
              (arg .inserted)
            )
          )
        )
      )
    )
  )
  (blank)
  (return
    (call TrackedPreparse
      (block
        (arg spans)
        (arg (call source-trivia source source-line-starts))
        (arg source-line-starts)
        (arg prepared-line-starts)
        (arg (. prepared length))
      )
    )
  )
)

(fn-do _ track-preparse-line _
  (param spans (list PreparseSpan))
  (param source String)
  (param source-start Index)
  (param source-end Index)
  (param prepared ([] Char))
  (param prepared-start Index)
  (param prepared-end Index)
  (let source-cursor source-start)
  (for (in prepared-index (..< prepared-start prepared-end))
    (let char ([] prepared prepared-index))
    (if (call is-synthetic-preparse-char source source-cursor source-end char)
      (+= spans
        (call PreparseSpan
          (block
            (arg prepared-index)
            (arg (+ prepared-index 1))
            (arg source-cursor)
            (arg source-cursor)
            (arg .inserted)
          )
        )
      )
      (continue)
    )
    (let found (call find-source-char source source-cursor source-end char))
    (if found
      (if (> found source-cursor)
        (+= spans (call PreparseSpan prepared-index prepared-index source-cursor found .removed))
      )
      (+= spans (call PreparseSpan prepared-index (+ prepared-index 1) found (+ found 1) .copied))
      (= source-cursor (+ found 1))
      (else-if (< source-cursor source-end)
        (+= spans
          (call PreparseSpan
            (block
              (arg prepared-index)
              (arg (+ prepared-index 1))
              (arg source-cursor)
              (arg (+ source-cursor 1))
              (arg .replaced)
            )
          )
        )
        (+= source-cursor 1)
      )
      (else
        (+= spans
          (call PreparseSpan
            (block
              (arg prepared-index)
              (arg (+ prepared-index 1))
              (arg source-cursor)
              (arg source-cursor)
              (arg .inserted)
            )
          )
        )
      )
    )
  )
  (blank)
  (if (< source-cursor source-end)
    (+= spans (call PreparseSpan prepared-end prepared-end source-cursor source-end .removed))
  )
)

(fn-do _ find-source-char (? Index)
  (param source String)
  (param start Index)
  (param end Index)
  (param wanted Char)
  (for (in index (..< start end))
    (return-if index (if (== ([] source index) wanted)))
  )
)

(fn-expr _ is-preparse-marker Bool
  (param char Char)
  (or (== char (char "≤")) (== char (char "≥")) (== char (char "Æ")) (== char (char "═")))
)

(fn-expr _ is-synthetic-preparse-char Bool
  (param source String)
  (param source-cursor Index)
  (param source-end Index)
  (param char Char)
  (case? (not (call is-preparse-marker char))
    false
  )
  (case? (>= source-cursor source-end)
    true
  )
  (default
    (!= ([] source source-cursor) char)
  )
)

(fn-expr _ source-trivia (list PreparseTrivia)
  (param source String)
  (param line-starts (list Index))
  (case-each (in item items (when item))
    item
  )
  (where
    (lazy items (call source-trivia-items source line-starts))
  )
)

(fn-expr _ source-trivia-items (of ImmutableArray (? PreparseTrivia))
  (param source String)
  (param line-starts (list Index))
  (match source
    (~ (seq (: items (* (call \source-trivia-item line-starts))) (! .))
      items
    )
    (throw (call Panic "Source trivia lexer did not consume its input"))
  )
)

(fn-expr _ source-trivia-item (? PreparseTrivia) (over: Char)
  (param line-starts (list Index))
  (~ (seq (: line (call \source-trivia-line line-starts)) \nl)
    (call source-trivia-at line)
  )
  (~ (seq (: line (call \source-trivia-final-line line-starts)) (! .))
    (call source-trivia-at line)
  )
)

(fn-expr _ source-trivia-line SourceTriviaLine (over: Char)
  (param line-starts (list Index))
  (~ (: text (* (seq (! \nl) .)))
    (call source-trivia-line-at text location line-starts)
  )
)

(fn-expr _ source-trivia-final-line SourceTriviaLine (over: Char)
  (param line-starts (list Index))
  (~ (: text (+ (seq (! \nl) .)))
    (call source-trivia-line-at text location line-starts)
  )
)

(fn-expr _ source-trivia-line-at SourceTriviaLine
  (param text String)
  (param location MatchLocation)
  (param line-starts (list Index))
  (call SourceTriviaLine text (. range start) (. range end))
  (where
    (lazy range (call tracked-source-range-at location line-starts))
  )
)

(fn-expr _ source-trivia-at (? PreparseTrivia)
  (param line SourceTriviaLine)
  (match (call source-trivia-kind (. line text))
    (case= .trivia-none
      null
    )
    (case= .trivia-comment
      (call PreparseTrivia (. line start) (. line end) .comment)
    )
    (case= .trivia-divider-class
      (call PreparseTrivia (. line start) (. line end) .divider-class)
    )
    (case= .trivia-divider-function
      (call PreparseTrivia (. line start) (. line end) .divider-function)
    )
    (case= .trivia-divider-header
      (call PreparseTrivia (. line start) (. line end) .divider-header)
    )
  )
)

(fn-expr _ source-trivia-kind SourceTriviaKind
  (param line String)
  (match line
    (~ (seq (* (| " " "\t" "\r")) "`" (* .) (! .))
      .trivia-comment
    )
    (~ (seq ({} "━" 3) (* "━") (! .))
      .trivia-divider-class
    )
    (~ (seq ({} "─" 3) (* "─") (! .))
      .trivia-divider-function
    )
    (~ (seq ({} "═" 3) (* "═") (! .))
      .trivia-divider-header
    )
    (default
      .trivia-none
    )
  )
)

(fn-expr _ tracked-source-range-at SourceRange
  (param location MatchLocation)
  (param line-starts (list Index))
  (call SourceRange start end)
  (where
    (lazy start (+ ([] line-starts (. location begin line)) (. location begin column)))
    (lazy end (+ ([] line-starts (. location end line)) (. location end column) 1))
  )
)

(fn-expr _ prepared-offset Index
  (param line-starts (list Index))
  (param prepared-length Size)
  (param location TokenLocation)
  (case? (>= (. location line) (. line-starts length))
    prepared-length
  )
  (case? (> offset prepared-length)
    prepared-length
  )
  (default
    offset
  )
  (where
    (lazy offset (+ ([] line-starts (. location line)) (. location column)))
  )
)
