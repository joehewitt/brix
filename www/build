#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

WWW = Path(__file__).resolve().parent
ROOT = WWW.parent
SITE = ROOT / '.tmp' / 'site'
HOME = WWW / 'prelaunch'
REFERENCE_SOURCE = Path('www/reference/build.yumi')
REFERENCE_PROGRAM = Path('.tmp/build/build-reference')


def main(arguments):
    parser = argparse.ArgumentParser(
        prog='www/build',
        description=f'Build the website into {SITE.relative_to(ROOT)}: the home page and the language reference.')
    parser.parse_args(arguments)
    if SITE.exists():
        shutil.rmtree(SITE)
    shutil.copytree(HOME, SITE)
    built = subprocess.run(
        [str(ROOT / 'bin' / 'brix'), str(REFERENCE_SOURCE), '-o', str(REFERENCE_PROGRAM),
         '--', '--output', str(SITE / 'ref')],
        cwd=ROOT)
    if built.returncode != 0:
        print('www/build: the reference did not build', file=sys.stderr)
        return built.returncode
    print(f'Built {SITE.relative_to(ROOT)}')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
