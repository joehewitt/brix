#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

WWW = Path(__file__).resolve().parent
ROOT = WWW.parent
SITE = ROOT / '.tmp' / 'site'
BUILDERS = [
    ('the home page', Path('www/home/build.bx'), Path('.tmp/build/build-home'), SITE),
    ('the reference', Path('www/reference/build.bx'), Path('.tmp/build/build-reference'), SITE / 'ref'),
]


def main(arguments):
    parser = argparse.ArgumentParser(
        prog='www/build',
        description=f'Build the website into {SITE.relative_to(ROOT)}: the home page, the examples and the language reference.')
    parser.parse_args(arguments)
    if SITE.exists():
        shutil.rmtree(SITE)
    for name, source, program, output in BUILDERS:
        built = subprocess.run(
            [str(ROOT / 'bin' / 'brix'), str(source), '-o', str(program), '--', '--output', str(output)],
            cwd=ROOT)
        if built.returncode != 0:
            print(f'www/build: {name} did not build', file=sys.stderr)
            return built.returncode
    print(f'Built {SITE.relative_to(ROOT)}')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
