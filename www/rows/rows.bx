(import /code/structure/document)
(import /code/structure/rows)
(import /lang/ubrix/ubrix)
(blank)
(prop _ rows-row-height Size (= 22))
(prop _ rows-edge Size (= 11))
(prop _ rows-half-gap Size (= 6))
(prop _ rows-member-gap Size (= 2))
(prop _ rows-edge-step Size (= 4))
(prop _ rows-wash-trail Size (= 7))
(prop _ rows-rule-offset Size (= 10))
(prop _ rows-double-offset Size (= 9))
(prop _ rows-border Size (= 1))

(type _ RowsRange (is (tuple (: start Size) (: end Size))))

(type _ RowsSize (is (tuple (: height Size) (: end Size))))

(type _ RowsLayout (is Tuple)
  (prop + tops (list Size))
  (prop + sizes (list RowsSize))
)

(fn-expr + html-text String
  (param text String)
  (call (. "" join) (in (call html-character each) text))
)

(fn-expr + html-attribute String
  (param text String)
  (call (. "" join) (in (call html-attribute-character each) text))
)

(fn-do + rows-document SourceDocument
  (param forms String)
  (param name String)
  (return
    (call brix-document-read forms
      (block
        (on-error (: error Error)
          (throw (call Error (str name ": " (. error message))))
        )
      )
    )
  )
)

(fn-do + rows-html String
  (param source SourceDocument)
  (let blocks (list (list SourceOutlineRow)))
  (let shown (list SourceRow))
  (let kept Size 0)
  (for (in index (..< 0 (. source declarations length)))
    (let base (call (. source first-row) index))
    (let rows (call (. source rows-of) index))
    (+= blocks rows)
    (let is-boxed (!= (. ([] rows 0) block) (. SourceRowBlock none)))
    (for (in local (..< 0 (. rows length)))
      (let row (call (. source row-at) (+ base local)))
      (+= shown row)
      (if (or is-boxed (call rows-has-content row))
        (= kept (+ base local 1))
      )
    )
  )
  (let sizes (list RowsSize))
  (let base Size 0)
  (for (in index (..< 0 (. blocks length)))
    (let is-followed (and (< (+ index 1) (. blocks length)) (!= (. ([] ([] blocks (+ index 1)) 0) block) (. SourceRowBlock none))))
    (++= sizes (call rows-sizes ([] blocks index) base kept is-followed))
    (+= base (. ([] blocks index) length))
  )
  (let tops (list Size))
  (let top Size 0)
  (for (in size sizes)
    (+= tops top)
    (+= top (. size height))
  )
  (let layout (call RowsLayout tops sizes))
  (let layers "")
  (= base 0)
  (for (in rows blocks)
    (if (!= (. ([] rows 0) block) (. SourceRowBlock none))
      (+= layers (call rows-surface-html rows base layout))
    )
    (+= base (. rows length))
  )
  (let text "")
  (for (in index (..< 0 kept))
    (let row ([] shown index))
    (+= text (call rows-row-html row (. ([] sizes index) height)))
    (if (== (. row divider) source-divider-double)
      (+= layers
        (paragraph
          (str "<div class=\"ub-double\" style=\"top:" (+ ([] tops index) rows-double-offset) "px\"></div>")
        )
      )
    )
  )
  (return
    (paragraph
      (str "<div class=\"ubrix\"><div class=\"ubrix-sheet\">" layers "<div class=\"ubrix-text\">" text "</div></div></div>")
    )
  )
)

(fn-do _ rows-sizes (list RowsSize)
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param kept Size)
  (param is-followed Bool)
  (let sizes (list RowsSize))
  (let is-boxed (!= (. ([] rows 0) block) (. SourceRowBlock none)))
  (let members (list RowsRange))
  (if (== (. ([] rows 0) block) (. SourceRowBlock holder))
    (= members (call rows-members rows))
  )
  (for (in local (..< 0 (. rows length)))
    (let row (+ base local))
    (let is-gap (call rows-is-gap ([] rows local)))
    (let is-last (== (+ local 1) (. rows length)))
    (let above (if-expr (== row 0) 0 rows-half-gap))
    (let below (if-expr (>= (+ row 1) kept) 0 rows-half-gap))
    (if (not is-boxed)
      (if (> (. ([] rows local) divider) 0)
        (+= sizes (call RowsSize above above))
        (else-if (and is-gap (> local 0) (> (. ([] rows (- local 1)) divider) 0))
          (+= sizes (call RowsSize 0 0))
        )
        (else-if (and is-last is-gap is-followed)
          (+= sizes (call RowsSize rows-half-gap rows-half-gap))
        )
        (else
          (+= sizes (call RowsSize rows-row-height rows-row-height))
        )
      )
      (else-if (or (== local 0) (call rows-member-starts members local))
        (+= sizes (call RowsSize (+ above rows-edge) (+ above rows-edge)))
      )
      (else-if (and is-gap is-last)
        (let inside
          (block
            (case? (call rows-member-ends members local)
              rows-member-gap
            )
            (default
              rows-edge
            )
          )
        )
        (+= sizes (call RowsSize (+ inside below) inside))
      )
      (else-if (and is-gap (call rows-member-ends members (+ local 1)))
        (+= sizes (call RowsSize (+ rows-edge rows-half-gap) rows-edge))
      )
      (else
        (+= sizes (call RowsSize rows-row-height rows-row-height))
      )
    )
  )
  (return sizes)
)

(fn-do + rows-inline-lines (list String)
  (param source SourceDocument)
  (let lines (list String))
  (let first (? Size) null)
  (let kept Size 0)
  (for (in index (..< 0 (. source declarations length)))
    (let base (call (. source first-row) index))
    (for (in local (..< 0 (. (call (. source rows-of) index) length)))
      (let row (call (. source row-at) (+ base local)))
      (if (not (. row is-divider))
        (if (call rows-has-content row)
          (= first (?? first (. lines length)))
          (= kept (+ (. lines length) 1))
        )
        (+= lines (str (* " " (. row content-start)) (call rows-spans-html (. row spans))))
      )
    )
  )
  (let trimmed (list String))
  (for (in index (..< (?? first 0) kept))
    (+= trimmed ([] lines index))
  )
  (return trimmed)
)

(fn-expr _ rows-has-content Bool
  (param row SourceRow)
  (and (not (. row is-divider)) (> (. (call (. row content trim)) length) 0))
)

(fn-do _ rows-row-html String
  (param row SourceRow)
  (param height Size)
  (let style (if-expr (== height rows-row-height) "" (str " style=\"height:" height "px\"")))
  (return-if (str "<div class=\"ub-row\"" style "></div>") (if (or (. row is-divider) (== (. row spans length) 0))))
  (blank)
  (let preamble (if-expr (== (. row zone) (. SourceRowZone preamble)) " ub-preamble" ""))
  (return
    (paragraph
      (str "<div class=\"ub-row" preamble "\"" style ">" (* " " (. row content-start)) (call rows-spans-html (. row spans)) "</div>")
    )
  )
)

(fn-do _ rows-spans-html String
  (param spans (list SourceSpan))
  (let html "")
  (let index Size 0)
  (while (< index (. spans length))
    (let span ([] spans index))
    (let text (. span text))
    (+= index 1)
    (while (and (< index (. spans length)) (== (. ([] spans index) kind) (. span kind)) (== (. ([] spans index) is-optional) (. span is-optional)))
      (+= text (. ([] spans index) text))
      (+= index 1)
    )
    (+= html (call rows-span-html (. span kind) (. span is-optional) text))
  )
  (return html)
)

(fn-expr _ rows-span-html String
  (param kind SourceSpanKind)
  (param is-optional Bool)
  (param text String)
  (case? (and (== kind (. SourceSpanKind plain)) (not is-optional))
    (call html-text text)
  )
  (default
    (str "<span class=\"s-" kind optional "\">" (call html-text text) "</span>")
  )
  (where
    (lazy optional (if-expr is-optional " s-optional" ""))
  )
)

(fn-do _ rows-surface-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param layout RowsLayout)
  (let kind (. ([] rows 0) block))
  (let is-tray (== kind (. SourceRowBlock holder)))
  (let members (list RowsRange))
  (if is-tray
    (= members (call rows-members rows))
  )
  (let top (call rows-opener-top layout base))
  (let bottom (call rows-region-bottom rows base (. rows length) false layout))
  (let inner (call rows-wash-html rows base 0 (. rows length) false top layout))
  (for (in local (..< 0 (. rows length)))
    (if (and (== (. ([] rows local) divider) source-divider-dashed) (not (call rows-in-members members local)))
      (+= inner (call rows-rule-html ([] (. layout tops) (+ base local)) top))
    )
  )
  (for (in member members)
    (+= inner (call rows-member-html rows base member top layout))
  )
  (let surface (if-expr is-tray "ub-tray" (str "ub-box ub-" kind)))
  (return (call rows-layer-html (str surface (call rows-private ([] rows 0))) top (- bottom top) inner))
)

(fn-do _ rows-members (list RowsRange)
  (param rows (list SourceOutlineRow))
  (let home (. ([] rows 0) owner))
  (let members (list RowsRange))
  (let start Size 1)
  (while (< start (. rows length))
    (if (== (. ([] rows start) owner) home)
      (+= start 1)
      (else
        (let end (+ start 1))
        (while (and (< end (. rows length)) (!= (. ([] rows end) owner) home) (!= (. ([] rows end) divider) source-divider-thin))
          (+= end 1)
        )
        (if (and (== (. ([] rows start) divider) source-divider-thin) (call rows-is-function-block (. ([] rows start) block)))
          (+= members (call RowsRange start end))
        )
        (= start end)
      )
    )
  )
  (return members)
)

(fn-do _ rows-in-members Bool
  (param members (list RowsRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (and (>= local (. member start)) (< local (. member end)))))
  )
  (return false)
)

(fn-do _ rows-member-starts Bool
  (param members (list RowsRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (== (. member start) local)))
  )
  (return false)
)

(fn-do _ rows-member-ends Bool
  (param members (list RowsRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (== (. member end) local)))
  )
  (return false)
)

(fn-do _ rows-member-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param member RowsRange)
  (param parent Size)
  (param layout RowsLayout)
  (let top (call rows-opener-top layout (+ base (. member start))))
  (let bottom (call rows-region-bottom rows base (. member end) true layout))
  (let inner (call rows-wash-html rows base (. member start) (. member end) true top layout))
  (for (in local (..< (. member start) (. member end)))
    (if (== (. ([] rows local) divider) source-divider-dashed)
      (+= inner (call rows-rule-html ([] (. layout tops) (+ base local)) top))
    )
  )
  (let head ([] rows (. member start)))
  (let classes (str "ub-member ub-" (. head block) (call rows-private head)))
  (return (call rows-layer-html classes (- top parent rows-border) (- bottom top) inner))
)

(fn-do _ rows-wash-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param opener Size)
  (param end Size)
  (param is-member Bool)
  (param parent Size)
  (param layout RowsLayout)
  (let last (+ opener 1))
  (return-if "" (if (or (>= last end) (!= (. ([] rows last) zone) (. SourceRowZone header)))))
  (blank)
  (while (and (< (+ last 1) end) (== (. ([] rows (+ last 1)) zone) (. SourceRowZone header)))
    (+= last 1)
  )
  (let next (+ last 1))
  (let reached
    (block
      (?? (call rows-row-bottom rows base last end is-member layout) (. ([] (. layout sizes) (+ base last)) height))
    )
  )
  (let bottom (+ ([] (. layout tops) (+ base last)) reached))
  (if (and (< next (. rows length)) (== (. ([] rows next) node) null))
    (= bottom ([] (. layout tops) (+ base next)))
    (if (call rows-is-gap ([] rows next))
      (let reach
        (block
          (?? (call rows-row-bottom rows base next end is-member layout) rows-wash-trail)
        )
      )
      (+= bottom (if-expr (< reach rows-wash-trail) reach rows-wash-trail))
    )
  )
  (return
    (paragraph
      (str "<div class=\"ub-wash ub-" (. ([] rows opener) block) "\" style=\"height:" (- bottom parent rows-border) "px\"></div>")
    )
  )
)

(fn-expr _ rows-rule-html String
  (param row-top Size)
  (param parent Size)
  (str "<div class=\"ub-rule\" style=\"top:" top "px\"></div>")
  (where
    (lazy top (- (+ row-top rows-rule-offset) parent rows-border))
  )
)

(fn-expr _ rows-layer-html String
  (param classes String)
  (param top Size)
  (param height Size)
  (param inner String)
  (str "<div class=\"" classes "\" style=\"top:" top "px;height:" height "px\">" inner "</div>")
)

(fn-expr _ rows-opener-top Size
  (param layout RowsLayout)
  (param row Size)
  (- (+ ([] (. layout tops) row) (. ([] (. layout sizes) row) height)) rows-edge)
)

(fn-expr _ rows-region-bottom Size
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param end Size)
  (param is-member Bool)
  (param layout RowsLayout)
  (+ ([] (. layout tops) (- (+ base end) 1)) (?? (call rows-row-bottom rows base (- end 1) end is-member layout) 0))
)

(fn-expr _ rows-row-bottom (? Size)
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param local Size)
  (param end Size)
  (param is-member Bool)
  (param layout RowsLayout)
  (case? (< (+ local 1) end)
    null
  )
  (case? (and is-member (>= (+ local 1) (. rows length)))
    (- close rows-edge-step)
  )
  (default
    close
  )
  (where
    (lazy close (. ([] (. layout sizes) (+ base local)) end))
  )
)

(fn-expr _ rows-is-gap Bool
  (param row SourceOutlineRow)
  (and (== (. row node) null) (== (. row divider) 0))
)

(fn-expr _ rows-is-function-block Bool
  (param block SourceRowBlock)
  (or (== block (. SourceRowBlock leaf)) (== block (. SourceRowBlock steps)) (== block (. SourceRowBlock text)))
)

(fn-expr _ rows-private String
  (param row SourceOutlineRow)
  (if-expr (. row is-private) " ub-private" "")
)

(fn-expr _ html-character String
  (param char Char)
  (case? (== char '&')
    "&amp;"
  )
  (case? (== char '<')
    "&lt;"
  )
  (case? (== char '>')
    "&gt;"
  )
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (as char String)
  )
)

(fn-expr _ html-attribute-character String
  (param char Char)
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (call html-character char)
  )
)
