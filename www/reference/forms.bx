(import ./../markdown-site/site)
(import /code/structure/document)
(import /code/structure/rows)
(import /data/markdown)
(import /lang/ubrix/ubrix)
(blank)
(prop _ reference-row-height Size (= 22))
(prop _ reference-edge Size (= 11))
(prop _ reference-half-gap Size (= 6))
(prop _ reference-member-gap Size (= 2))
(prop _ reference-edge-step Size (= 4))
(prop _ reference-wash-trail Size (= 7))
(prop _ reference-rule-offset Size (= 10))
(prop _ reference-double-offset Size (= 9))
(prop _ reference-border Size (= 1))

(type _ ReferenceRange (is (tuple (: start Size) (: end Size))))

(type _ ReferenceSize (is (tuple (: height Size) (: end Size))))

(type _ ReferenceLayout (is Tuple)
  (prop + tops (list Size))
  (prop + sizes (list ReferenceSize))
)

(fn-do + render-reference-code String
  (param document MarkdownSiteDocument)
  (param code MDFencedCode)
  (if (== (. code language) "brix")
    (let forms (call (. code body trim)))
    (let source (use (call reference-document forms (str (. document source-name) ":" (. code first-body-line)))))
    (return (call reference-forms-html (call reference-rows-html source) (call reference-html forms)))
  )
  (let text (call reference-html (. code body)))
  (return-if (str "<pre><code>" text "</code></pre>") (if (not (. code language))))
  (return (str "<pre><code class=\"language-" (call reference-html-attribute (. code language)) "\">" text "</code></pre>"))
)

(fn-do + render-reference-inline-code String
  (param document MarkdownSiteDocument)
  (param code MDInlineCode)
  (let text (call reference-html (. code code)))
  (if (== (. code language) "brix")
    (let source (use (call reference-document (. code code) (str (. document source-name) ": " (. code code)))))
    (let lines (call reference-inline-lines source))
    (let multiline (if-expr (> (. lines length) 1) " brix-multiline" ""))
    (let html (str "<code class=\"language-brix" multiline "\"><span class=\"brix-rows ubrix-inline\">"))
    (+= html (str (call (. "\n" join) lines) "</span><span class=\"brix-forms\">" text "</span></code>"))
    (return html)
  )
  (return-if (str "<code>" text "</code>") (if (not (. code language))))
  (return (str "<code class=\"language-" (call reference-html-attribute (. code language)) "\">" text "</code>"))
)

(fn-expr + reference-html String
  (param text String)
  (call (. "" join) (in (call reference-html-character each) text))
)

(fn-expr + reference-html-attribute String
  (param text String)
  (call (. "" join) (in (call reference-html-attribute-character each) text))
)

(fn-do _ reference-document SourceDocument
  (param forms String)
  (param name String)
  (return
    (call brix-document-read forms
      (block
        (on-error (: error Error)
          (throw (call Error (str name ": " (. error message))))
        )
      )
    )
  )
)

(fn-do _ reference-rows-html String
  (param source SourceDocument)
  (let blocks (list (list SourceOutlineRow)))
  (let shown (list SourceRow))
  (let kept Size 0)
  (for (in index (..< 0 (. source declarations length)))
    (let base (call (. source first-row) index))
    (let rows (call (. source rows-of) index))
    (+= blocks rows)
    (let is-boxed (!= (. ([] rows 0) block) (. SourceRowBlock none)))
    (for (in local (..< 0 (. rows length)))
      (let row (call (. source row-at) (+ base local)))
      (+= shown row)
      (if (or is-boxed (call reference-has-content row))
        (= kept (+ base local 1))
      )
    )
  )
  (let sizes (list ReferenceSize))
  (let base Size 0)
  (for (in index (..< 0 (. blocks length)))
    (let is-followed (and (< (+ index 1) (. blocks length)) (!= (. ([] ([] blocks (+ index 1)) 0) block) (. SourceRowBlock none))))
    (++= sizes (call reference-sizes ([] blocks index) base kept is-followed))
    (+= base (. ([] blocks index) length))
  )
  (let tops (list Size))
  (let top Size 0)
  (for (in size sizes)
    (+= tops top)
    (+= top (. size height))
  )
  (let layout (call ReferenceLayout tops sizes))
  (let layers "")
  (= base 0)
  (for (in rows blocks)
    (if (!= (. ([] rows 0) block) (. SourceRowBlock none))
      (+= layers (call reference-surface-html rows base layout))
    )
    (+= base (. rows length))
  )
  (let text "")
  (for (in index (..< 0 kept))
    (let row ([] shown index))
    (+= text (call reference-row-html row (. ([] sizes index) height)))
    (if (== (. row divider) source-divider-double)
      (+= layers (str "<div class=\"ub-double\" style=\"top:" (+ ([] tops index) reference-double-offset) "px\"></div>"))
    )
  )
  (return (str "<div class=\"ubrix\"><div class=\"ubrix-sheet\">" layers "<div class=\"ubrix-text\">" text "</div></div></div>"))
)

(fn-do _ reference-sizes (list ReferenceSize)
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param kept Size)
  (param is-followed Bool)
  (let sizes (list ReferenceSize))
  (let is-boxed (!= (. ([] rows 0) block) (. SourceRowBlock none)))
  (let members (list ReferenceRange))
  (if (== (. ([] rows 0) block) (. SourceRowBlock holder))
    (= members (call reference-members rows))
  )
  (for (in local (..< 0 (. rows length)))
    (let row (+ base local))
    (let is-gap (call reference-is-gap ([] rows local)))
    (let is-last (== (+ local 1) (. rows length)))
    (let above (if-expr (== row 0) 0 reference-half-gap))
    (let below (if-expr (>= (+ row 1) kept) 0 reference-half-gap))
    (if (not is-boxed)
      (if (> (. ([] rows local) divider) 0)
        (+= sizes (call ReferenceSize above above))
        (else-if (and is-gap (> local 0) (> (. ([] rows (- local 1)) divider) 0))
          (+= sizes (call ReferenceSize 0 0))
        )
        (else-if (and is-last is-gap is-followed)
          (+= sizes (call ReferenceSize reference-half-gap reference-half-gap))
        )
        (else
          (+= sizes (call ReferenceSize reference-row-height reference-row-height))
        )
      )
      (else-if (or (== local 0) (call reference-member-starts members local))
        (+= sizes (call ReferenceSize (+ above reference-edge) (+ above reference-edge)))
      )
      (else-if (and is-gap is-last)
        (let inside (if-expr (call reference-member-ends members local) reference-member-gap reference-edge))
        (+= sizes (call ReferenceSize (+ inside below) inside))
      )
      (else-if (and is-gap (call reference-member-ends members (+ local 1)))
        (+= sizes (call ReferenceSize (+ reference-edge reference-half-gap) reference-edge))
      )
      (else
        (+= sizes (call ReferenceSize reference-row-height reference-row-height))
      )
    )
  )
  (return sizes)
)

(fn-do _ reference-inline-lines (list String)
  (param source SourceDocument)
  (let lines (list String))
  (let first (? Size) null)
  (let kept Size 0)
  (for (in index (..< 0 (. source declarations length)))
    (let base (call (. source first-row) index))
    (for (in local (..< 0 (. (call (. source rows-of) index) length)))
      (let row (call (. source row-at) (+ base local)))
      (if (not (. row is-divider))
        (if (call reference-has-content row)
          (= first (?? first (. lines length)))
          (= kept (+ (. lines length) 1))
        )
        (+= lines (str (* " " (. row content-start)) (call reference-spans-html (. row spans))))
      )
    )
  )
  (let trimmed (list String))
  (for (in index (..< (?? first 0) kept))
    (+= trimmed ([] lines index))
  )
  (return trimmed)
)

(fn-expr _ reference-has-content Bool
  (param row SourceRow)
  (and (not (. row is-divider)) (> (. (call (. row content trim)) length) 0))
)

(fn-do _ reference-row-html String
  (param row SourceRow)
  (param height Size)
  (let style (if-expr (== height reference-row-height) "" (str " style=\"height:" height "px\"")))
  (return-if (str "<div class=\"ub-row\"" style "></div>") (if (or (. row is-divider) (== (. row spans length) 0))))
  (let preamble (if-expr (== (. row zone) (. SourceRowZone preamble)) " ub-preamble" ""))
  (return (str "<div class=\"ub-row" preamble "\"" style ">" (* " " (. row content-start)) (call reference-spans-html (. row spans)) "</div>"))
)

(fn-do _ reference-spans-html String
  (param spans (list SourceSpan))
  (let html "")
  (let index Size 0)
  (while (< index (. spans length))
    (let span ([] spans index))
    (let text (. span text))
    (+= index 1)
    (while (and (< index (. spans length)) (== (. ([] spans index) kind) (. span kind)) (== (. ([] spans index) is-optional) (. span is-optional)))
      (+= text (. ([] spans index) text))
      (+= index 1)
    )
    (+= html (call reference-span-html (. span kind) (. span is-optional) text))
  )
  (return html)
)

(fn-expr _ reference-span-html String
  (param kind SourceSpanKind)
  (param is-optional Bool)
  (param text String)
  (case? (and (== kind (. SourceSpanKind plain)) (not is-optional))
    (call reference-html text)
  )
  (default
    (str "<span class=\"s-" kind optional "\">" (call reference-html text) "</span>")
  )
  (where
    (lazy optional (if-expr is-optional " s-optional" ""))
  )
)

(fn-do _ reference-surface-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param layout ReferenceLayout)
  (let kind (. ([] rows 0) block))
  (let is-tray (== kind (. SourceRowBlock holder)))
  (let members (list ReferenceRange))
  (if is-tray
    (= members (call reference-members rows))
  )
  (let top (call reference-opener-top layout base))
  (let bottom (call reference-region-bottom rows base (. rows length) false layout))
  (let inner (call reference-wash-html rows base 0 (. rows length) false top layout))
  (for (in local (..< 0 (. rows length)))
    (if (and (== (. ([] rows local) divider) source-divider-dashed) (not (call reference-in-members members local)))
      (+= inner (call reference-rule-html ([] (. layout tops) (+ base local)) top))
    )
  )
  (for (in member members)
    (+= inner (call reference-member-html rows base member top layout))
  )
  (let surface (if-expr is-tray "ub-tray" (str "ub-box ub-" kind)))
  (return (call reference-layer-html (str surface (call reference-private ([] rows 0))) top (- bottom top) inner))
)

(fn-do _ reference-members (list ReferenceRange)
  (param rows (list SourceOutlineRow))
  (let home (. ([] rows 0) owner))
  (let members (list ReferenceRange))
  (let start Size 1)
  (while (< start (. rows length))
    (if (== (. ([] rows start) owner) home)
      (+= start 1)
      (else
        (let end (+ start 1))
        (while (and (< end (. rows length)) (!= (. ([] rows end) owner) home) (!= (. ([] rows end) divider) source-divider-thin))
          (+= end 1)
        )
        (if (and (== (. ([] rows start) divider) source-divider-thin) (call reference-is-function-block (. ([] rows start) block)))
          (+= members (call ReferenceRange start end))
        )
        (= start end)
      )
    )
  )
  (return members)
)

(fn-do _ reference-in-members Bool
  (param members (list ReferenceRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (and (>= local (. member start)) (< local (. member end)))))
  )
  (return false)
)

(fn-do _ reference-member-starts Bool
  (param members (list ReferenceRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (== (. member start) local)))
  )
  (return false)
)

(fn-do _ reference-member-ends Bool
  (param members (list ReferenceRange))
  (param local Size)
  (for (in member members)
    (return-if true (if (== (. member end) local)))
  )
  (return false)
)

(fn-do _ reference-member-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param member ReferenceRange)
  (param parent Size)
  (param layout ReferenceLayout)
  (let top (call reference-opener-top layout (+ base (. member start))))
  (let bottom (call reference-region-bottom rows base (. member end) true layout))
  (let inner (call reference-wash-html rows base (. member start) (. member end) true top layout))
  (for (in local (..< (. member start) (. member end)))
    (if (== (. ([] rows local) divider) source-divider-dashed)
      (+= inner (call reference-rule-html ([] (. layout tops) (+ base local)) top))
    )
  )
  (let head ([] rows (. member start)))
  (let classes (str "ub-member ub-" (. head block) (call reference-private head)))
  (return (call reference-layer-html classes (- top parent reference-border) (- bottom top) inner))
)

(fn-do _ reference-wash-html String
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param opener Size)
  (param end Size)
  (param is-member Bool)
  (param parent Size)
  (param layout ReferenceLayout)
  (let last (+ opener 1))
  (return-if "" (if (or (>= last end) (!= (. ([] rows last) zone) (. SourceRowZone header)))))
  (while (and (< (+ last 1) end) (== (. ([] rows (+ last 1)) zone) (. SourceRowZone header)))
    (+= last 1)
  )
  (let next (+ last 1))
  (let reached (?? (call reference-row-bottom rows base last end is-member layout) (. ([] (. layout sizes) (+ base last)) height)))
  (let bottom (+ ([] (. layout tops) (+ base last)) reached))
  (if (and (< next (. rows length)) (== (. ([] rows next) node) null))
    (= bottom ([] (. layout tops) (+ base next)))
    (if (call reference-is-gap ([] rows next))
      (let reach (?? (call reference-row-bottom rows base next end is-member layout) reference-wash-trail))
      (+= bottom (if-expr (< reach reference-wash-trail) reach reference-wash-trail))
    )
  )
  (return (str "<div class=\"ub-wash ub-" (. ([] rows opener) block) "\" style=\"height:" (- bottom parent reference-border) "px\"></div>"))
)

(fn-expr _ reference-rule-html String
  (param row-top Size)
  (param parent Size)
  (str "<div class=\"ub-rule\" style=\"top:" top "px\"></div>")
  (where
    (lazy top (- (+ row-top reference-rule-offset) parent reference-border))
  )
)

(fn-expr _ reference-layer-html String
  (param classes String)
  (param top Size)
  (param height Size)
  (param inner String)
  (str "<div class=\"" classes "\" style=\"top:" top "px;height:" height "px\">" inner "</div>")
)

(fn-expr _ reference-opener-top Size
  (param layout ReferenceLayout)
  (param row Size)
  (- (+ ([] (. layout tops) row) (. ([] (. layout sizes) row) height)) reference-edge)
)

(fn-expr _ reference-region-bottom Size
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param end Size)
  (param is-member Bool)
  (param layout ReferenceLayout)
  (+ ([] (. layout tops) (- (+ base end) 1)) (?? (call reference-row-bottom rows base (- end 1) end is-member layout) 0))
)

(fn-expr _ reference-row-bottom (? Size)
  (param rows (list SourceOutlineRow))
  (param base Size)
  (param local Size)
  (param end Size)
  (param is-member Bool)
  (param layout ReferenceLayout)
  (case? (< (+ local 1) end)
    null
  )
  (case? (and is-member (>= (+ local 1) (. rows length)))
    (- close reference-edge-step)
  )
  (default
    close
  )
  (where
    (lazy close (. ([] (. layout sizes) (+ base local)) end))
  )
)

(fn-expr _ reference-is-gap Bool
  (param row SourceOutlineRow)
  (and (== (. row node) null) (== (. row divider) 0))
)

(fn-expr _ reference-is-function-block Bool
  (param block SourceRowBlock)
  (or (== block (. SourceRowBlock leaf)) (== block (. SourceRowBlock steps)) (== block (. SourceRowBlock text)))
)

(fn-expr _ reference-private String
  (param row SourceOutlineRow)
  (if-expr (. row is-private) " ub-private" "")
)

(fn-expr _ reference-forms-html _
  (param rows String)
  (param forms String)
  (paragraph
    (str "<div class=\"brix-code\" data-brix-code><div class=\"brix-rows\">" rows "</div><div class=\"brix-forms\"><pre><code class=\"language-brix\">" forms "</code></pre></div></div>")
  )
)

(fn-expr _ reference-html-character String
  (param char Char)
  (case? (== char '&')
    "&amp;"
  )
  (case? (== char '<')
    "&lt;"
  )
  (case? (== char '>')
    "&gt;"
  )
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (as char String)
  )
)

(fn-expr _ reference-html-attribute-character String
  (param char Char)
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (call reference-html-character char)
  )
)
