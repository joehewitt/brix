(import ./../markdown-site/site)
(import ./../rows/rows)
(import /data/markdown)
(blank)

(fn-do + render-reference-code String
  (param document MarkdownSiteDocument)
  (param code MDFencedCode)
  (if (== (. code language) "brix")
    (let forms (call (. code body trim)))
    (let source (use (call rows-document forms (str (. document source-name) ":" (. code first-body-line)))))
    (return (call reference-forms-html (call rows-html source) (call html-text forms)))
  )
  (let text (call html-text (. code body)))
  (return-if (str "<pre><code>" text "</code></pre>") (if (not (. code language))))
  (return (str "<pre><code class=\"language-" (call html-attribute (. code language)) "\">" text "</code></pre>"))
)

(fn-do + render-reference-inline-code String
  (param document MarkdownSiteDocument)
  (param code MDInlineCode)
  (let text (call html-text (. code code)))
  (if (== (. code language) "brix")
    (let source (use (call rows-document (. code code) (str (. document source-name) ": " (. code code)))))
    (let lines (call rows-inline-lines source))
    (let multiline (if-expr (> (. lines length) 1) " brix-multiline" ""))
    (let html (str "<code class=\"language-brix" multiline "\"><span class=\"brix-rows ubrix-inline\">"))
    (+= html (str (call (. "\n" join) lines) "</span><span class=\"brix-forms\">" text "</span></code>"))
    (return html)
  )
  (return-if (str "<code>" text "</code>") (if (not (. code language))))
  (return (str "<code class=\"language-" (call html-attribute (. code language)) "\">" text "</code>"))
)

(fn-expr _ reference-forms-html _
  (param rows String)
  (param forms String)
  (paragraph
    (str "<div class=\"brix-code\" data-brix-code><div class=\"brix-rows\">" rows "</div><div class=\"brix-forms\"><pre><code class=\"language-brix\">" forms "</code></pre></div></div>")
  )
)
