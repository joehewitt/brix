(import ./../markdown-site/site)
(import ./annotations)
(import ./forms)
(import /BxCore/BxCore.h)
(import /data/markdown)
(import /os/cli)
(import /os/file)
(import /os/path)
(blank)

(main
  (call run-reference-builder)
)

(type _ ReferenceChapter (is Tuple)
  (prop + document MarkdownSiteDocument)
  (prop + examples (list ReferenceExample))
)

(type _ ReferenceAnnotationTarget (is Tuple)
  (prop + example-id String)
  (prop + feature-id String)
)

(type _ ReferenceBuildOptions (is Tuple)
  (prop + source Path)
  (prop + output Path)
  (prop + watch Bool)
)

(fn-do _ run-reference-builder _
  (let options (call reference-build-options (call cmdline-args)))
  (if (. options watch)
    (let watched (call (. options source watch) true))
    (use watched)
    (call build-reference options)
    (print (str "Watching " (. options source)))
    (for (on event watched)
      (if (or (. event must-rescan) (== (. event path ext) "md"))
        (let rebuilt (call rebuild-reference options))
      )
    )
    (return)
  )
  (call build-reference options)
)

(fn-do _ rebuild-reference Bool
  (param options ReferenceBuildOptions)
  (call build-reference options
    (block
      (on-error (: error Error)
        (call (. stderr write) (str "Reference build failed: " (. error message) "\n"))
        (return false)
      )
    )
  )
  (return true)
)

(fn-do _ build-reference _
  (param options ReferenceBuildOptions)
  (let site (call load-markdown-site (. options source) "README.md" reference-chapter-id (list "syntax.md")))
  (let chapters (list ReferenceChapter))
  (for (in document (. site documents))
    (+= chapters (call ReferenceChapter document (call reference-examples document)))
  )
  (let content "")
  (for (in chapter chapters)
    (let code-renderer
      (=> (document code)
        (block
          (call reference-code document (. chapter examples) code)
        )
      )
    )
    (let link-renderer
      (=> (document url)
        (block
          (call reference-link site chapters document url)
        )
      )
    )
    (let rendered
      (call render-markdown-site-document
        (block
          (arg site)
          (arg (. chapter document))
          (arg code-renderer)
          (arg link-renderer)
          (arg render-reference-inline-code)
        )
      )
    )
    (= rendered (call render-reference-example-pairs rendered (. chapter document source-name)))
    (let heading (call reference-first-heading-id rendered (. chapter document source-name)))
    (+= content (str "<section class=\"chapter\" id=\"" (. chapter document id) "\" data-chapter"))
    (+= content (str " tabindex=\"-1\" aria-labelledby=\"" heading "\">" rendered "</section>\n"))
  )
  (let navigation (call reference-navigation chapters))
  (let stylesheet (call read-file-text (call Path "www/reference/style.css")))
  (let module-javascript (call read-file-text (call Path "www/reference/script.js")))
  (let javascript (call reference-classic-javascript module-javascript))
  (let asset-version (as (call hash-for (++ stylesheet javascript)) Hex))
  (let html
    (call reference-page
      (block
        (arg (. ([] (. site documents) 0) title))
        (arg (str asset-version))
        (arg (. navigation ticks))
        (arg (. navigation contents))
        (arg content)
      )
    )
  )
  (call ensure-reference-directory (. options output))
  (call write-reference-file (/ (. options output) "reference.css") stylesheet)
  (call write-reference-file (/ (. options output) "reference.js") javascript)
  (call write-reference-file (/ (. options output) "index.html") html)
  (print (str "Built " (/ (. options output) "index.html")))
)

(fn-do _ reference-build-options ReferenceBuildOptions
  (param command (list String))
  (let source (call Path "docs/ref"))
  (let output (call Path ".tmp/site/ref"))
  (let watch false)
  (let index Index 1)
  (while (< index (. command length))
    (let argument ([] command index))
    (if (== argument "--watch")
      (= watch true)
      (else-if (== argument "--source")
        (+= index 1)
        (throw (call Error "--source needs a directory") (if (>= index (. command length))))
        (= source (call Path ([] command index)))
      )
      (else-if (== argument "--output")
        (+= index 1)
        (throw (call Error "--output needs a directory") (if (>= index (. command length))))
        (= output (call Path ([] command index)))
      )
      (else-if (or (== argument "--help") (== argument "-h"))
        (print "Usage: build-reference [--watch] [--source directory] [--output directory]")
        (call C:exit 0)
      )
      (else
        (throw (call Error (str "Unknown option " argument)))
      )
    )
    (+= index 1)
  )
  (return (call ReferenceBuildOptions source output watch))
)

(fn-expr _ reference-chapter-id String
  (param source-name String)
  (if-expr (== source-name "README.md") "guide" (str "chapter-" (call markdown-site-document-id source-name)))
)

(fn-expr _ reference-code String (?! Error)
  (param document MarkdownSiteDocument)
  (param examples (list ReferenceExample))
  (param code MDFencedCode)
  (case? (== (. code language) "brix")
    (call render-reference-forms document code)
  )
  (default
    (call render-reference-code document examples code)
  )
)

(fn-do _ reference-link MarkdownHTMLLink
  (param site MarkdownSite)
  (param chapters (list ReferenceChapter))
  (param document MarkdownSiteDocument)
  (param url String)
  (if (call (. url starts-with) "../")
    (return (call MarkdownHTMLLink (call reference-repository-link url) ""))
  )
  (let resolved (call markdown-site-link site document url))
  (let hash (call (. url find) "#"))
  (return-if resolved (if (not hash)))
  (let fragment ([] url (... (+ hash 1))))
  (let file ([] url (... _ hash)))
  (let target (call reference-target-chapter chapters document file))
  (return-if resolved (if (not target)))
  (let annotation (call reference-annotation-target target fragment))
  (return-if resolved (if (not annotation)))
  (let attributes (str " data-code-link data-code-example-id=\"" (. target document id)))
  (+= attributes (str "--" (. annotation example-id) "\""))
  (+= attributes (str " data-code-feature=\"" (. annotation feature-id) "\""))
  (return (call MarkdownHTMLLink (. resolved target) attributes))
)

(fn-do _ reference-target-chapter (? ReferenceChapter)
  (param chapters (list ReferenceChapter))
  (param current MarkdownSiteDocument)
  (param file String)
  (if (not file)
    (for (in chapter chapters)
      (return-if chapter (if (== (. chapter document source-name) (. current source-name))))
    )
  )
  (let normalized (if-expr (call (. file starts-with) "./") ([] file (... 2)) file))
  (for (in chapter chapters)
    (return-if chapter (if (== (. chapter document source-name) normalized)))
  )
)

(fn-do _ reference-annotation-target (? ReferenceAnnotationTarget)
  (param chapter ReferenceChapter)
  (param fragment String)
  (for (in example (. chapter examples))
    (for (in feature (. example features))
      (if (== fragment (str "source-" (. example id) "--" (. feature id)))
        (return (call ReferenceAnnotationTarget (. example id) (. feature id)))
      )
    )
  )
)

(fn-do _ reference-repository-link String
  (param target String)
  (let hash (call (. target find) "#"))
  (let path (if-expr hash ([] target (... _ hash)) target))
  (let fragment (if-expr hash ([] target (... hash)) ""))
  (let parts (list String) (list "docs" "ref"))
  (for (in part (call (. path split) "/"))
    (if (or (not part) (== part "."))
      (continue)
    )
    (if (== part "..")
      (throw (call Error (str "Link leaves the repository: " target)) (if (== (. parts length) 0)))
      (call (. parts pop))
      (else
        (+= parts part)
      )
    )
  )
  (return (str "https://github.com/joehewitt/brix/blob/main/" (call (. "/" join) parts) fragment))
)

(fn-expr _ reference-first-heading-id String
  (param html String)
  (param source-name String)
  (before
    (throw (call Error (str source-name ": Missing chapter heading")) (if (not start)))
    (throw (call Error (str source-name ": Invalid chapter heading")) (if (not end)))
  )
  ([] html (..< value-start end))
  (where
    (lazy prefix "<h1 id=\"")
    (lazy start (call (. html find) prefix))
    (lazy value-start (+ start (. prefix length)))
    (lazy end (call (. html find) "\"" value-start))
  )
)

(fn-do _ reference-navigation (tuple (: ticks String) (: contents String))
  (param chapters (list ReferenceChapter))
  (let ticks "")
  (let contents "")
  (for (in index (..< 0 (. chapters length)))
    (let chapter ([] chapters index))
    (let current (if-expr (== index 0) " aria-current=\"location\"" ""))
    (let id (. chapter document id))
    (let title (call reference-html (. chapter document title)))
    (+= ticks (str "<a class=\"chapter-tick\" href=\"#" id "\" data-chapter-link=\"" id "\""))
    (+= ticks (str " aria-label=\"" title "\"" current "><span></span></a>"))
    (let label (if-expr (== index 0) "•" (str (call (. index pad) 2))))
    (+= contents (str "<li><a href=\"#" id "\" data-chapter-link=\"" id "\"" current ">"))
    (+= contents (str "<span>" label "</span><b>" title "</b></a></li>"))
  )
  (return (tuple ticks contents))
)

(fn-expr _ reference-classic-javascript String
  (param source String)
  (call (. "\n" join) (in (call reference-classic-javascript-line each) (call (. source split) "\n")))
)

(fn-expr _ reference-classic-javascript-line String
  (param line String)
  (if-expr (call (. line starts-with) "export ") ([] line (... 7)) line)
)

(fn-do _ ensure-reference-directory _ (?! Error)
  (param path Path)
  (return-if (if (. path is-dir)))
  (if (not (. path dir is-dir))
    (call ensure-reference-directory (. path dir))
  )
  (call (. path make-directory))
)

(fn-do _ write-reference-file _
  (param path Path)
  (param contents String)
  (let temporary (call Path (str path ".tmp")))
  (let permissions (/or/ user-read-perm user-write-perm group-read-perm other-read-perm))
  (let flags (/or/ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let output (call File (as temporary String) flags permissions))
  (call (. output write) contents)
  (call (. output close))
  (call (. temporary move) path)
)

(fn-expr _ reference-page _
  (param title String)
  (param asset-version String)
  (param ticks String)
  (param navigation String)
  (param content String)
  (paragraph
    "<!doctype html>"
    "<html lang=\"en\">"
    "<head>"
    "<meta charset=\"utf-8\">"
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    "<meta name=\"color-scheme\" content=\"light dark\">"
    (str "<title>" (call reference-html title) "</title>")
    (str "<link rel=\"stylesheet\" href=\"reference.css?v=" asset-version "\">")
    (str "<script defer src=\"reference.js?v=" asset-version "\"></script>")
    "</head>"
    "<body>"
    "<a class=\"skip-link\" href=\"#content\">Skip to content</a>"
    "<header class=\"site-header\">"
    "<p>Language reference</p>"
    "</header>"
    "<nav class=\"chapter-navigation\" data-chapter-navigation aria-label=\"Reference chapters\">"
    "<div class=\"chapter-rail\" data-chapter-rail>"
    (str "<div class=\"chapter-ticks\">" ticks "</div>")
    "</div>"
    "<div class=\"chapter-toc\" id=\"chapter-toc\" data-chapter-toc hidden>"
    "<div class=\"chapter-toc-heading\">"
    "<button type=\"button\" data-chapter-close aria-label=\"Close table of contents\">×</button>"
    "</div>"
    (str "<ol>" navigation "</ol>")
    "</div>"
    "</nav>"
    "<main id=\"content\" class=\"article\">"
    (str "<article class=\"guide\">" content "</article>")
    "</main>"
    "</body>"
    "</html>"
  )
)
