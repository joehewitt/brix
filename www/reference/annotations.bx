(import ./../markdown-site/site)
(import ./../yumi-html/source-html)
(import /data/json)
(import /data/markdown)
(import /stream/aggregate)
(import /stream/sort)

(type + ReferenceAnnotationSelection (is Tuple)
  (prop + id String)
  (prop + kind (? String))
  (prop + start Index)
  (prop + end Index)
)

(type + ReferenceFeatureSpec (is Tuple)
  (prop + id String)
  (prop + kind (? String))
)

(type + ReferenceResolvedNode (is Tuple)
  (prop + id U32)
  (prop + kind String)
  (prop + start Index)
  (prop + end Index)
)

(type + ReferenceResolvedRange (is Tuple)
  (prop + start Index)
  (prop + end Index)
  (prop + selection-start Index)
  (prop + selection-end Index)
  (prop + nodes (list ReferenceResolvedNode))
)

(type + ReferenceFeature (is Tuple)
  (prop + id String)
  (prop + kind (? String))
  (prop + ranges (list ReferenceResolvedRange))
)

(type + ReferenceExample (is Tuple)
  (prop + document-id String)
  (prop + id String)
  (prop + name String)
  (prop + source String)
  (prop + selections (list ReferenceAnnotationSelection))
  (prop + features (list ReferenceFeatureSpec))
)

(fn-do + reference-examples (list ReferenceExample)
  (param document MarkdownSiteDocument)
  (let examples (list ReferenceExample))
  (for (in code (call reference-fenced-codes (. document markdown)))
    (let id (call reference-example-id document code))
    (if (not id)
      (if (and (== (. code language) "yumi") (call (. code body find) "⟦"))
        (let message (str (. document source-name) ":" (. code first-body-line) ":"))
        (+= message " Annotated source needs a named fence")
        (throw (call Error message))
      )
      (continue)
    )
    (throw (call Error (str (. document source-name) ": Duplicate example " id)) (if (call reference-example examples id)))
    (let name (str (. document source-name) ":" (. code first-body-line)))
    (let stripped (call strip-reference-annotations (. code body) name))
    (let ordered-selections (call sort (. stripped selections) (:using compare-reference-selection)))
    (let features (list ReferenceFeatureSpec))
    (for (in selection ordered-selections)
      (let existing (call reference-feature-spec features (. selection id)))
      (if existing
        (throw (call Error (str name ": Conflicting node kinds for " (. selection id))) (if (!= (. existing kind) (. selection kind))))
        (else
          (+= features (call ReferenceFeatureSpec (. selection id) (. selection kind)))
        )
      )
    )
    (throw (call Error (str name ": Named example has no annotated ranges")) (if (== (. features length) 0)))
    (+= examples
      (call ReferenceExample
        (block
          (arg (. document id))
          (arg id)
          (arg name)
          (arg (. stripped source))
          (arg (. stripped selections))
          (arg features)
        )
      )
    )
  )
  (return examples)
)

(fn-expr + render-reference-code String
  (param document MarkdownSiteDocument)
  (param examples (list ReferenceExample))
  (param code MDFencedCode)
  (before
    (throw (call Error (str (. document source-name) ":" (. code first-body-line) ": Unknown example " id)) (if (and id (not example))))
  )
  (case? (and id example)
    (call render-reference-example example)
  )
  (case? (== (. code language) "yumi")
    (call yumi-source-code-html (. code body) (. document source-name))
  )
  (case? (. code language)
    (str "<pre><code class=\"language-" language "\">" (call reference-html (. code body)) "</code></pre>")
  )
  (default
    (str "<pre><code>" (call reference-html (. code body)) "</code></pre>")
  )
  (where
    (lazy id (call reference-example-id document code))
    (lazy example (call reference-example examples id))
    (lazy language (call reference-html-attribute (. code language)))
  )
)

(fn-do + render-reference-example String
  (param example ReferenceExample)
  (let presentation (call yumi-source-presentation (. example source) (. example name)))
  (let features (call resolve-reference-features example presentation))
  (let boundaries (list Index))
  (for (in feature features)
    (for (in range (. feature ranges))
      (call add-reference-boundary boundaries (. range start))
      (call add-reference-boundary boundaries (. range end))
    )
  )
  (let anchored (call (of Map String Bool)))
  (let code "")
  (let cursor Index)
  (for (in run (. presentation runs))
    (throw (call Error (str (. example name) ": Invalid parser presentation offsets")) (if (!= (. run start) cursor)))
    (let segments "")
    (let cuts (list Index) (list (. run start)))
    (for (in boundary boundaries)
      (if (and (> boundary (. run start)) (< boundary (. run end)))
        (+= cuts boundary)
      )
    )
    (+= cuts (. run end))
    (for (in index (..< 0 (- (. cuts length) 1)))
      (let start ([] cuts index))
      (let end ([] cuts (+ index 1)))
      (let ids (list String))
      (let anchors "")
      (for (in feature features)
        (if (call reference-feature-covers feature start end)
          (+= ids (. feature id))
        )
        (if (and (not ([] anchored (. feature id))) (call reference-feature-starts feature start))
          (= ([] anchored (. feature id)) true)
          (+= anchors (str "<span class=\"code-source-anchor\" id=\"" (. example document-id)))
          (+= anchors (str "--source-" (. example id) "--" (. feature id) "\"></span>"))
        )
      )
      (let utf-start (call reference-utf16-offset (. example source) start))
      (let utf-end (call reference-utf16-offset (. example source) end))
      (let scopes (call reference-html-attribute (call (. " " join) (. run scopes))))
      (let feature-ids (call reference-html-attribute (call (. " " join) ids)))
      (+= segments anchors)
      (+= segments (str "<span class=\"yumi-run\" data-scopes=\"" scopes "\""))
      (+= segments (str " data-source-range=\"" utf-start ":" utf-end "\""))
      (+= segments (str " data-feature-ids=\"" feature-ids "\">"))
      (+= segments (call reference-html ([] (. example source) (..< start end))))
      (+= segments "</span>")
    )
    (if (. run divider)
      (let fill (* (as ([] (. example source) (. run start)) String) 512))
      (let width (- (. run end) (. run start)))
      (let scopes (call reference-html-attribute (call (. " " join) (. run scopes))))
      (+= code (str "<span class=\"yumi-run yumi-divider\" data-scopes=\"" scopes "\""))
      (+= code (str " data-divider-fill=\"" (call reference-html-attribute fill) "\""))
      (+= code (str " style=\"--divider-source-width:" width "ch\">" segments "</span>"))
      (else
        (+= code segments)
      )
    )
    (= cursor (. run end))
  )
  (throw (call Error (str (. example name) ": Parser presentation changed the example text")) (if (!= cursor (. example source length))))
  (return (call reference-example-html example code (call reference-feature-json example features)))
)

(fn-do + render-reference-example-pairs String
  (param html String)
  (param document-name String)
  (let opening "<p>:::example-pair</p>")
  (let closing "<p>:::</p>")
  (let output "")
  (let cursor Index)
  (while (< cursor (. html length))
    (let start (call (. html find) opening cursor))
    (if (not start)
      (+= output ([] html (... cursor)))
      (break)
    )
    (+= output ([] html (..< cursor start)))
    (let content-start (+ start (. opening length)))
    (let end (call (. html find) closing content-start))
    (throw (call Error (str document-name ": Unclosed example pair")) (if (not end)))
    (throw (call Error (str document-name ": Example pairs cannot nest")) (if (and (call (. html find) opening content-start) (< (!! (call (. html find) opening content-start)) end))))
    (let content ([] html (..< content-start end)))
    (let source-start (call (. content find) "<section class=\"code-example\""))
    (throw (call Error (str document-name ": Example pair needs one annotated example")) (if (not source-start)))
    (let source-end-marker "</section>")
    (let source-end (call (. content find) source-end-marker source-start))
    (throw (call Error (str document-name ": Example pair has an incomplete annotated example")) (if (not source-end)))
    (let source-after (+ source-end (. source-end-marker length)))
    (throw (call Error (str document-name ": Example pair needs exactly one annotated example")) (if (call (. content find) "<section class=\"code-example\"" source-after)))
    (let prose (call (. (++ ([] content (... _ source-start)) ([] content (... source-after))) trim)))
    (throw (call Error (str document-name ": Example pair needs prose")) (if (not prose)))
    (let source ([] content (..< source-start source-after)))
    (+= output (str "<div class=\"example-pair\"><div class=\"example-prose\">" prose "</div>"))
    (+= output (str "<div class=\"example-source\">" source "</div></div>"))
    (= cursor (+ end (. closing length)))
  )
  (return output)
)

(fn-expr + reference-html String
  (param text String)
  (call (. "" join) (in (call reference-html-character each) text))
)

(fn-expr + reference-html-attribute String
  (param text String)
  (call (. "" join) (in (call reference-html-attribute-character each) text))
)

(type _ ReferenceAnnotationOpen (is Tuple)
  (prop + id String)
  (prop + kind (? String))
  (prop + start Index)
)

(type _ StrippedReferenceSource (is Tuple)
  (prop + source String)
  (prop + selections (list ReferenceAnnotationSelection))
)

(fn-expr _ compare-reference-selection Comparison
  (param left ReferenceAnnotationSelection)
  (param right ReferenceAnnotationSelection)
  (case? (< (. left start) (. right start))
    .lesser
  )
  (case? (> (. left start) (. right start))
    .greater
  )
  (case? (> (. left end) (. right end))
    .lesser
  )
  (case? (< (. left end) (. right end))
    .greater
  )
  (default
    .equal
  )
)

(fn-expr _ reference-example-html _
  (param example ReferenceExample)
  (param code String)
  (param data String)
  (paragraph
    (str "<section class=\"code-example\" data-code-example=\"" (. example document-id) "--" (. example id) "\" id=\"" (. example document-id) "--source-" (. example id) "\" aria-label=\"Annotated Brix example\"><div class=\"yumi-source\" data-yumi-source><pre class=\"yumi-source-pre\"><code class=\"source-yumi\">" code "</code></pre></div><script type=\"application/json\" data-code-features>" data "</script></section>")
  )
)

(fn-do _ strip-reference-annotations StrippedReferenceSource
  (param authored String)
  (param name String)
  (let source "")
  (let selections (list ReferenceAnnotationSelection))
  (let stack (list ReferenceAnnotationOpen))
  (let cursor Index)
  (while (< cursor (. authored length))
    (if (and (== ([] authored cursor) (char "\\")) (< (+ cursor 1) (. authored length)) (== ([] authored (+ cursor 1)) (char "⟦")))
      (+= source "⟦")
      (+= cursor 2)
      (continue)
    )
    (if (!= ([] authored cursor) (char "⟦"))
      (+= source (as ([] authored cursor) String))
      (+= cursor 1)
      (continue)
    )
    (let marker-end (call (. authored find) "⟧" (+ cursor 1)))
    (throw (call Error (str name ": Invalid annotation marker")) (if (not marker-end)))
    (let marker ([] authored (..< (+ cursor 1) marker-end)))
    (let closing (call (. marker starts-with) "/"))
    (if closing
      (= marker ([] marker (... 1)))
    )
    (let colon (call (. marker find) ":"))
    (let id (if-expr colon ([] marker (... _ colon)) marker))
    (let kind (? String))
    (if colon
      (= kind ([] marker (... (+ colon 1))))
    )
    (throw (call Error (str name ": Invalid annotation marker")) (if (or (not (call reference-annotation-id id)) (and kind (not (call reference-node-kind kind))))))
    (if closing
      (throw (call Error (str name ": Closing markers cannot select a node kind")) (if kind))
      (throw (call Error (str name ": Unmatched closing marker " id)) (if (== (. stack length) 0)))
      (let open (call (. stack pop)))
      (throw (call Error (str name ": Unmatched closing marker " id)) (if (!= (. open id) id)))
      (throw (call Error (str name ": Empty annotation " id)) (if (== (. open start) (. source length))))
      (+= selections (call ReferenceAnnotationSelection (. open id) (. open kind) (. open start) (. source length)))
      (else
        (+= stack (call ReferenceAnnotationOpen id kind (. source length)))
      )
    )
    (= cursor (+ marker-end 1))
  )
  (throw (call Error (str name ": Unclosed annotation " (. ([] stack (- (. stack length) 1)) id))) (if (> (. stack length) 0)))
  (return (call StrippedReferenceSource source selections))
)

(fn-do _ resolve-reference-features (list ReferenceFeature)
  (param example ReferenceExample)
  (param presentation SourcePresentation)
  (let features (list ReferenceFeature))
  (for (in spec (. example features))
    (let ranges (list ReferenceResolvedRange))
    (for (in selection (. example selections))
      (if (!= (. selection id) (. spec id))
        (continue)
      )
      (let candidates (list ReferenceResolvedNode))
      (for (in node (. presentation nodes))
        (if (or (> (. node start) (. selection start)) (< (. node end) (. selection end)))
          (continue)
        )
        (if (. spec kind)
          (if (!= (. node kind) (. spec kind))
            (continue)
          )
          (else-if (or (== (. node kind) "TopLevel") (== (. node kind) "Block") (== (. node kind) "Noop"))
            (continue)
          )
        )
        (+= candidates (call ReferenceResolvedNode (. node id) (. node kind) (. node start) (. node end)))
      )
      (let smallest (list ReferenceResolvedNode))
      (if (> (. candidates length) 0)
        (let width (call reference-smallest-node-width candidates))
        (for (in node candidates)
          (if (== (- (. node end) (. node start)) width)
            (+= smallest node)
          )
        )
      )
      (if (. spec kind)
        (throw (call Error (str (. example name) ": No enclosing " (. spec kind) " for " (. spec id))) (if (== (. smallest length) 0)))
        (for (in left smallest)
          (for (in right smallest)
            (throw (call Error (str (. example name) ": Ambiguous enclosing " (. spec kind) " for " (. spec id))) (if (or (!= (. left start) (. right start)) (!= (. left end) (. right end)))))
          )
        )
      )
      (let start (. selection start))
      (let end (. selection end))
      (if (. spec kind)
        (= start (. ([] smallest 0) start))
        (= end (. ([] smallest 0) end))
      )
      (+= ranges (call ReferenceResolvedRange start end (. selection start) (. selection end) smallest))
    )
    (+= features (call ReferenceFeature (. spec id) (. spec kind) ranges))
  )
  (return features)
)

(fn-do _ reference-feature-json String
  (param example ReferenceExample)
  (param features (list ReferenceFeature))
  (let json-features (list JSON))
  (for (in feature features)
    (let json-ranges (list JSON))
    (for (in range (. feature ranges))
      (let json-nodes (list JSON))
      (for (in node (. range nodes))
        (let json-node
          (call (of Map String JSON)
            (block
              (entry "id" (as (. node id) Int JSON))
              (entry "kind" (as (. node kind) JSON))
              (entry "start" (as (call reference-utf16-offset (. example source) (. node start)) Int JSON))
              (entry "end" (as (call reference-utf16-offset (. example source) (. node end)) Int JSON))
            )
          )
        )
        (+= json-nodes json-node)
      )
      (let selection-start (call reference-utf16-offset (. example source) (. range selection-start)))
      (let selection-end (call reference-utf16-offset (. example source) (. range selection-end)))
      (let json-range
        (call (of Map String JSON)
          (block
            (entry "start" (as (call reference-utf16-offset (. example source) (. range start)) Int JSON))
            (entry "end" (as (call reference-utf16-offset (. example source) (. range end)) Int JSON))
            (entry "selectionStart" (as selection-start Int JSON))
            (entry "selectionEnd" (as selection-end Int JSON))
            (entry "nodes" (as json-nodes JSON))
          )
        )
      )
      (+= json-ranges json-range)
    )
    (let item
      (call (of Map String JSON)
        (block
          (entry "id" (as (. feature id) JSON))
          (entry "ranges" (as json-ranges JSON))
        )
      )
    )
    (if (. feature kind)
      (= ([] item "kind") (. feature kind))
    )
    (+= json-features item)
  )
  (let root
    (call (of Map String JSON)
      (block
        (entry "source" (as (. example source) JSON))
        (entry "features" (as json-features JSON))
        (entry "sourceMap" (as (call (of List JSON)) JSON))
      )
    )
  )
  (return (call reference-script-json (call to-json root)))
)

(fn-do _ reference-fenced-codes (list MDFencedCode)
  (param markdown Markdown)
  (let codes (list MDFencedCode))
  (call collect-reference-fenced-codes markdown codes)
  (return codes)
)

(fn-do _ collect-reference-fenced-codes _
  (param node Markdown)
  (param codes (list MDFencedCode))
  (match? node
    (case MDFencedCode
      (+= codes it)
    )
    (case MDDocument
      (for (in child (. it content))
        (call collect-reference-fenced-codes child codes)
      )
    )
    (case MDBlockQuote
      (for (in child (. it content))
        (call collect-reference-fenced-codes child codes)
      )
    )
    (case MDList
      (for (in child (. it children))
        (call collect-reference-fenced-codes child codes)
      )
    )
    (case MDListItem
      (for (in child (. it blocks))
        (call collect-reference-fenced-codes child codes)
      )
    )
  )
)

(fn-do _ reference-example-id (? String)
  (param document MarkdownSiteDocument)
  (param code MDFencedCode)
  (return-if (if (!= (. code language) "yumi")))
  (let opening ([] (. document source) (..< (. code range start) (. code body-range start))))
  (let hash (call (. opening find) "#"))
  (return-if (if (not hash)))
  (let id (call (. ([] opening (... (+ hash 1))) trim)))
  (throw (call Error (str (. document source-name) ":" (- (. code first-body-line) 1) ": Invalid example name")) (if (not (call reference-annotation-id id))))
  (return id)
)

(fn-do _ reference-example (? ReferenceExample)
  (param examples (list ReferenceExample))
  (param id String)
  (for (in example examples)
    (return-if example (if (== (. example id) id)))
  )
)

(fn-do _ reference-feature-spec (? ReferenceFeatureSpec)
  (param features (list ReferenceFeatureSpec))
  (param id String)
  (for (in feature features)
    (return-if feature (if (== (. feature id) id)))
  )
)

(fn-do _ reference-smallest-node-width Index
  (param nodes (list ReferenceResolvedNode))
  (let result (- (. ([] nodes 0) end) (. ([] nodes 0) start)))
  (for (in node nodes)
    (let width (- (. node end) (. node start)))
    (if (< width result)
      (= result width)
    )
  )
  (return result)
)

(fn-do _ add-reference-boundary _
  (param boundaries (list Index))
  (param boundary Index)
  (for (in existing boundaries)
    (return-if (if (== existing boundary)))
  )
  (let index Index)
  (while (and (< index (. boundaries length)) (< ([] boundaries index) boundary))
    (+= index 1)
  )
  (call (. boundaries insert) boundary index)
)

(fn-expr _ reference-feature-covers Bool
  (param feature ReferenceFeature)
  (param start Index)
  (param end Index)
  (call some (. feature ranges) (:where (and (<= (. each start) start) (>= (. each end) end))))
)

(fn-expr _ reference-feature-starts Bool
  (param feature ReferenceFeature)
  (param start Index)
  (call some (. feature ranges) (:where (== (. each start) start)))
)

(fn-do _ reference-utf16-offset Index
  (param source String)
  (param codepoint-offset Index)
  (let result Index)
  (for (in index (..< 0 codepoint-offset))
    (+= result (if-expr (> (as ([] source index) U32) 65535) 2 1))
  )
  (return result)
)

(fn-do _ reference-annotation-id Bool
  (param value String)
  (return-if false (if (not value)))
  (return-if false (if (or (< ([] value 0) 'a') (> ([] value 0) 'z'))))
  (let previous-hyphen false)
  (for (in char value)
    (let hyphen (== char '-'))
    (return-if false (if (and hyphen previous-hyphen)))
    (return-if false (if (and (not hyphen) (not (and (>= char 'a') (<= char 'z'))) (not (and (>= char '0') (<= char '9'))))))
    (= previous-hyphen hyphen)
  )
  (return (not previous-hyphen))
)

(fn-do _ reference-node-kind Bool
  (param value String)
  (return-if false (if (not value)))
  (let first ([] value 0))
  (return-if false (if (and (not (and (>= first 'A') (<= first 'Z'))) (not (and (>= first 'a') (<= first 'z'))))))
  (for (in char ([] value (... 1)))
    (let letter (or (and (>= char 'A') (<= char 'Z')) (and (>= char 'a') (<= char 'z'))))
    (let number (and (>= char '0') (<= char '9')))
    (return-if false (if (and (not letter) (not number))))
  )
  (return true)
)

(fn-expr _ reference-html-character String
  (param char Char)
  (case? (== char '&')
    "&amp;"
  )
  (case? (== char '<')
    "&lt;"
  )
  (case? (== char '>')
    "&gt;"
  )
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (as char String)
  )
)

(fn-expr _ reference-html-attribute-character String
  (param char Char)
  (case? (== char (char "\""))
    "&quot;"
  )
  (case? (== char (char "'"))
    "&#39;"
  )
  (default
    (call reference-html-character char)
  )
)

(fn-expr _ reference-script-json String
  (param text String)
  (call (. "" join) (in (call reference-script-json-character each) text))
)

(fn-expr _ reference-script-json-character String
  (param char Char)
  (case? (== char '<')
    "\\u003c"
  )
  (case? (== char '>')
    "\\u003e"
  )
  (case? (== char '&')
    "\\u0026"
  )
  (default
    (as char String)
  )
)
