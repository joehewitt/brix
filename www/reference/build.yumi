./../markdown-site/site
./annotations
./forms
/BxCore/BxCore.h
/data/markdown
/os/cli
/os/file
/os/path

run-reference-builder()

━━━━━━━━━━━━━━━━━━━━
_ ReferenceChapter is Tuple

+ document MarkdownSiteDocument
+ examples [ReferenceExample]

━━━━━━━━━━━━━━━━━━━━
_ ReferenceAnnotationTarget is Tuple

+ example-id String
+ feature-id String

━━━━━━━━━━━━━━━━━━━━
_ ReferenceBuildOptions is Tuple

+ source Path
+ output Path
+ watch Bool

━━━━━━━━━━━━━━━━━━━━
_ do run-reference-builder

. options = reference-build-options(cmdline-args())
if options.watch
    . watched = options.source.watch(true)
    use watched
    build-reference(options)
    -- "Watching ${options.source}"
    for event on watched
        if event.must-rescan || event.path.ext == "md"
            . rebuilt = rebuild-reference(options)
    =
build-reference(options)

━━━━━━━━━━━━━━━━━━━━
_ do rebuild-reference Bool
    - options ReferenceBuildOptions

build-reference(options)
    catch error Error
        stderr.write("Reference build failed: ${error.message}\n")
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do build-reference
    - options ReferenceBuildOptions

. site = load-markdown-site(options.source, "README.md", reference-chapter-id, ["syntax.md"])
. chapters [ReferenceChapter]
for document in site.documents
    chapters += ReferenceChapter(document, reference-examples(document))
. content = ""
for chapter in chapters
    . code-renderer = :: document, code =>
        reference-code(document, chapter.examples, code)
    . link-renderer = :: document, url =>
        reference-link(site, chapters, document, url)
    . rendered = render-markdown-site-document
        - site
        - chapter.document
        - code-renderer
        - link-renderer
        - render-reference-inline-code
    rendered = render-reference-example-pairs(rendered, chapter.document.source-name)
    . heading = reference-first-heading-id(rendered, chapter.document.source-name)
    content += "<section class=\"chapter\" id=\"${chapter.document.id}\" data-chapter"
    content += " tabindex=\"-1\" aria-labelledby=\"$heading\">$rendered</section>\n"
. navigation = reference-navigation(chapters)
. stylesheet = read-file-text(Path("www/reference/style.css"))
. module-javascript = read-file-text(Path("www/reference/script.js"))
. javascript = reference-classic-javascript(module-javascript)
. asset-version = hash-for(stylesheet ++ javascript) as Hex
. html = reference-page
    - site.documents[0].title
    - "$asset-version"
    - navigation.ticks
    - navigation.contents
    - content
ensure-reference-directory(options.output)
write-reference-file(options.output / "reference.css", stylesheet)
write-reference-file(options.output / "reference.js", javascript)
write-reference-file(options.output / "index.html", html)
-- "Built ${options.output / "index.html"}"

━━━━━━━━━━━━━━━━━━━━
_ do reference-build-options ReferenceBuildOptions
    - command [String]

. source = Path("docs/ref")
. output = Path(".tmp/site/ref")
. watch = false
. index Index = 1
while index < command.length
    . argument = command[index]
    if argument == "--watch"
        watch = true
    else if argument == "--source"
        index += 1
        ?! Error("--source needs a directory")
            if index >= command.length
        source = Path(command[index])
    else if argument == "--output"
        index += 1
        ?! Error("--output needs a directory")
            if index >= command.length
        output = Path(command[index])
    else if argument == "--help" || argument == "-h"
        -- "Usage: build-reference [--watch] [--source directory] [--output directory]"
        C:exit(0)
    else
        ?! Error("Unknown option $argument")
    index += 1
= ReferenceBuildOptions(source, output, watch)

━━━━━━━━━━━━━━━━━━━━
_ reference-chapter-id String
    - source-name String

if source-name == "README.md" then "guide" else "chapter-${markdown-site-document-id(source-name)}"

━━━━━━━━━━━━━━━━━━━━
_ reference-code String ?! Error
    - document MarkdownSiteDocument
    - examples [ReferenceExample]
    - code MDFencedCode

|? code.language == "brix"
    render-reference-forms(document, code)
??
    render-reference-code(document, examples, code)

━━━━━━━━━━━━━━━━━━━━
_ do reference-link MarkdownHTMLLink
    - site MarkdownSite
    - chapters [ReferenceChapter]
    - document MarkdownSiteDocument
    - url String

if url.starts-with("../")
    = MarkdownHTMLLink(reference-repository-link(url), "")
. resolved = markdown-site-link(site, document, url)
. hash = url.find("#")
=? resolved if !hash
. fragment = url[hash + 1 ...]
. file = url[... hash]
. target = reference-target-chapter(chapters, document, file)
=? resolved if !target
. annotation = reference-annotation-target(target, fragment)
=? resolved if !annotation
. attributes = " data-code-link data-code-example-id=\"${target.document.id}"
attributes += "--${annotation.example-id}\""
attributes += " data-code-feature=\"${annotation.feature-id}\""
= MarkdownHTMLLink(resolved.target, attributes)

━━━━━━━━━━━━━━━━━━━━
_ do reference-target-chapter ReferenceChapter?
    - chapters [ReferenceChapter]
    - current MarkdownSiteDocument
    - file String

if !file
    for chapter in chapters
        =? chapter if chapter.document.source-name == current.source-name
. normalized = if file.starts-with("./") then file[2 ...] else file
for chapter in chapters
    =? chapter if chapter.document.source-name == normalized

━━━━━━━━━━━━━━━━━━━━
_ do reference-annotation-target ReferenceAnnotationTarget?
    - chapter ReferenceChapter
    - fragment String

for example in chapter.examples
    for feature in example.features
        if fragment == "source-${example.id}--${feature.id}"
            = ReferenceAnnotationTarget(example.id, feature.id)

━━━━━━━━━━━━━━━━━━━━
_ do reference-repository-link String
    - target String

. hash = target.find("#")
. path = if hash then target[... hash] else target
. fragment = if hash then target[hash ...] else ""
. parts [String] = ["docs", "ref"]
for part in path.split("/")
    if !part || part == "."
        continue
    if part == ".."
        ?! Error("Link leaves the repository: $target")
            if parts.length == 0
        parts.pop()
    else
        parts += part
= "https://github.com/joehewitt/brix/blob/main/${"/".join(parts)}$fragment"

━━━━━━━━━━━━━━━━━━━━
_ reference-first-heading-id String
    - html String
    - source-name String

?! Error("$source-name: Missing chapter heading")
    if !start
?! Error("$source-name: Invalid chapter heading")
    if !end
html[value-start .. < end]

.. prefix = "<h1 id=\""
.. start = html.find(prefix)
.. value-start = start + prefix.length
.. end = html.find("\"", value-start)

━━━━━━━━━━━━━━━━━━━━
_ do reference-navigation (ticks String, contents String)
    - chapters [ReferenceChapter]

. ticks = ""
. contents = ""
for index in 0 .. < chapters.length
    . chapter = chapters[index]
    . current = if index == 0 then " aria-current=\"location\"" else ""
    . id = chapter.document.id
    . title = reference-html(chapter.document.title)
    ticks += "<a class=\"chapter-tick\" href=\"#$id\" data-chapter-link=\"$id\""
    ticks += " aria-label=\"$title\"$current><span></span></a>"
    . label = if index == 0 then "•" else "${index.pad(2)}"
    contents += "<li><a href=\"#$id\" data-chapter-link=\"$id\"$current>"
    contents += "<span>$label</span><b>$title</b></a></li>"
= (ticks, contents)

━━━━━━━━━━━━━━━━━━━━
_ reference-classic-javascript String
    - source String

"\n".join(reference-classic-javascript-line(each) in source.split("\n"))

━━━━━━━━━━━━━━━━━━━━
_ reference-classic-javascript-line String
    - line String

if line.starts-with("export ") then line[7 ...] else line

━━━━━━━━━━━━━━━━━━━━
_ do ensure-reference-directory ?! Error
    - path Path

=? if path.is-dir
if !path.dir.is-dir
    ensure-reference-directory(path.dir)
path.make-directory()

━━━━━━━━━━━━━━━━━━━━
_ do write-reference-file
    - path Path
    - contents String

. temporary = Path("${path}.tmp")
. permissions = user-read-perm /or/ user-write-perm /or/ group-read-perm /or/ other-read-perm
. flags = FileFlags.write-mode /or/ FileFlags.create-mode /or/ FileFlags.truncate-mode
. output = File(temporary as String, flags, permissions)
output.write(contents)
output.close()
temporary.move(path)

━━━━━━━━━━━━━━━━━━━━
_ ¶ reference-page
    - title String
    - asset-version String
    - ticks String
    - navigation String
    - content String

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>${reference-html(title)}</title>
<link rel="stylesheet" href="reference.css?v=$asset-version">
<script defer src="reference.js?v=$asset-version"></script>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
<p>Language reference</p>
</header>
<nav class="chapter-navigation" data-chapter-navigation aria-label="Reference chapters">
<div class="chapter-rail" data-chapter-rail>
<div class="chapter-ticks">$ticks</div>
</div>
<div class="chapter-toc" id="chapter-toc" data-chapter-toc hidden>
<div class="chapter-toc-heading">
<button type="button" data-chapter-close aria-label="Close table of contents">×</button>
</div>
<ol>$navigation</ol>
</div>
</nav>
<main id="content" class="article">
<article class="guide">$content</article>
</main>
</body>
</html>
