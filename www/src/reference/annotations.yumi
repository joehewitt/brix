━━━━━━━━━━━━━━━━━━━━
+ do reference-examples [ReferenceExample]
    - document MarkdownSiteDocument

. examples [ReferenceExample]
for code in reference-fenced-codes(document.markdown)
    . id = reference-example-id(document, code)
    if !id
        if code.language == "yumi" && code.body.find("⟦")
            . message = "${document.source-name}:${code.first-body-line}:"
            message += " Annotated source needs a named fence"
            ?! Error(message)
        continue
    ?! Error("${document.source-name}: Duplicate example ${id}")
        if reference-example(examples, id)
    . name = "${document.source-name}:${code.first-body-line}"
    . stripped = strip-reference-annotations(code.body, name)
    . ordered-selections = sort(stripped.selections) • using compare-reference-selection
    . features [ReferenceFeatureSpec]
    for selection in ordered-selections
        . existing = reference-feature-spec(features, selection.id)
        if existing
            ?! Error("$name: Conflicting node kinds for ${selection.id}")
                if existing.kind != selection.kind
        else
            features += ReferenceFeatureSpec(selection.id, selection.kind)
    ?! Error("$name: Named example has no annotated ranges")
        if features.length == 0
    examples += ReferenceExample
        - document.id
        - id
        - name
        - stripped.source
        - stripped.selections
        - features
= examples

━━━━━━━━━━━━━━━━━━━━
+ render-reference-code String
    - document MarkdownSiteDocument
    - examples [ReferenceExample]
    - code MDFencedCode

?! Error("${document.source-name}:${code.first-body-line}: Unknown example ${id}") if id && !example
|? id && example
    render-reference-example(example)
|? code.language == "yumi"
    yumi-source-code-html(code.body, document.source-name)
|? code.language
    "<pre><code class=\"language-$language\">${reference-html(code.body)}</code></pre>"
??
    "<pre><code>${reference-html(code.body)}</code></pre>"

.. id = reference-example-id(document, code)
.. example = reference-example(examples, id)
.. language = reference-html-attribute(code.language)

━━━━━━━━━━━━━━━━━━━━
+ do render-reference-example String
    - example ReferenceExample

. presentation = yumi-source-presentation(example.source, example.name)
. features = resolve-reference-features(example, presentation)
. boundaries [Index]
for feature in features
    for range in feature.ranges
        add-reference-boundary(boundaries, range.start)
        add-reference-boundary(boundaries, range.end)
. anchored = Map'String'Bool()
. code = ""
. cursor Index
for run in presentation.runs
    ?! Error("${example.name}: Invalid parser presentation offsets")
        if run.start != cursor
    . segments = ""
    . cuts [Index] = [run.start]
    for boundary in boundaries
        if boundary > run.start && boundary < run.end
            cuts += boundary
    cuts += run.end
    for index in 0 .. < cuts.length - 1
        . start = cuts[index]
        . end = cuts[index + 1]
        . ids [String]
        . anchors = ""
        for feature in features
            if reference-feature-covers(feature, start, end)
                ids += feature.id
            if !anchored[feature.id] && reference-feature-starts(feature, start)
                anchored[feature.id] = true
                anchors += "<span class=\"code-source-anchor\" id=\"${example.document-id}"
                anchors += "--source-${example.id}--${feature.id}\"></span>"
        . utf-start = reference-utf16-offset(example.source, start)
        . utf-end = reference-utf16-offset(example.source, end)
        . scopes = reference-html-attribute(" ".join(run.scopes))
        . feature-ids = reference-html-attribute(" ".join(ids))
        segments += anchors
        segments += "<span class=\"yumi-run\" data-scopes=\"$scopes\""
        segments += " data-source-range=\"$utf-start:$utf-end\""
        segments += " data-feature-ids=\"$feature-ids\">"
        segments += reference-html(example.source[start .. < end])
        segments += "</span>"
    if run.divider
        . fill = (example.source[run.start] as String) * 512
        . width = run.end - run.start
        . scopes = reference-html-attribute(" ".join(run.scopes))
        code += "<span class=\"yumi-run yumi-divider\" data-scopes=\"$scopes\""
        code += " data-divider-fill=\"${reference-html-attribute(fill)}\""
        code += " style=\"--divider-source-width:${width}ch\">$segments</span>"
    else
        code += segments
    cursor = run.end
?! Error("${example.name}: Parser presentation changed the example text")
    if cursor != example.source.length
= reference-example-html(example, code, reference-feature-json(example, features))

━━━━━━━━━━━━━━━━━━━━
+ do render-reference-example-pairs String
    - html String
    - document-name String

. opening = "<p>:::example-pair</p>"
. closing = "<p>:::</p>"
. output = ""
. cursor Index
while cursor < html.length
    . start = html.find(opening, cursor)
    if !start
        output += html[cursor ...]
        break
    output += html[cursor .. < start]
    . content-start = start + opening.length
    . end = html.find(closing, content-start)
    ?! Error("$document-name: Unclosed example pair")
        if !end
    ?! Error("$document-name: Example pairs cannot nest")
        if html.find(opening, content-start) && html.find(opening, content-start)! < end
    . content = html[content-start .. < end]
    . source-start = content.find("<section class=\"code-example\"")
    ?! Error("$document-name: Example pair needs one annotated example")
        if !source-start
    . source-end-marker = "</section>"
    . source-end = content.find(source-end-marker, source-start)
    ?! Error("$document-name: Example pair has an incomplete annotated example")
        if !source-end
    . source-after = source-end + source-end-marker.length
    ?! Error("$document-name: Example pair needs exactly one annotated example")
        if content.find("<section class=\"code-example\"", source-after)
    . prose = (content[... source-start] ++ content[source-after ...]).trim()
    ?! Error("$document-name: Example pair needs prose")
        if !prose
    . source = content[source-start .. < source-after]
    output += "<div class=\"example-pair\"><div class=\"example-prose\">$prose</div>"
    output += "<div class=\"example-source\">$source</div></div>"
    cursor = end + closing.length
= output

