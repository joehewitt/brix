+ source String
+ selections [ReferenceAnnotationSelection]

━━━━━━━━━━━━━━━━━━━━
_ compare-reference-selection Comparison
    - left ReferenceAnnotationSelection
    - right ReferenceAnnotationSelection

|? left.start < right.start
    .lesser
|? left.start > right.start
    .greater
|? left.end > right.end
    .lesser
|? left.end < right.end
    .greater
??
    .equal

━━━━━━━━━━━━━━━━━━━━
_ ¶ reference-example-html
    - example ReferenceExample
    - code String
    - data String

<section class="code-example" data-code-example="${example.document-id}--${example.id}" \
id="${example.document-id}--source-${example.id}" aria-label="Annotated Brix example">\
<div class="yumi-source" data-yumi-source>\
<pre class="yumi-source-pre"><code class="source-yumi">$code</code></pre></div>\
<script type="application/json" data-code-features>$data</script></section>

━━━━━━━━━━━━━━━━━━━━
_ do strip-reference-annotations StrippedReferenceSource
    - authored String
    - name String

. source = ""
. selections [ReferenceAnnotationSelection]
. stack [ReferenceAnnotationOpen]
. cursor Index
while cursor < authored.length
    if authored[cursor] == '\\' && cursor + 1 < authored.length && authored[cursor + 1] == '⟦'
        source += "⟦"
        cursor += 2
        continue
    if authored[cursor] != '⟦'
        source += authored[cursor] as String
        cursor += 1
        continue
    . marker-end = authored.find("⟧", cursor + 1)
    ?! Error("$name: Invalid annotation marker")
        if !marker-end
    . marker = authored[cursor + 1 .. < marker-end]
    . closing = marker.starts-with("/")
    if closing
        marker = marker[1 ...]
    . colon = marker.find(":")
    . id = if colon then marker[... colon] else marker
    . kind String?
    if colon
        kind = marker[colon + 1 ...]
    ?! Error("$name: Invalid annotation marker")
        if !reference-annotation-id(id) || (kind && !reference-node-kind(kind))
    if closing
        ?! Error("$name: Closing markers cannot select a node kind")
            if kind
        ?! Error("$name: Unmatched closing marker $id")
            if stack.length == 0
        . open = stack.pop()
        ?! Error("$name: Unmatched closing marker $id")
            if open.id != id
        ?! Error("$name: Empty annotation $id")
            if open.start == source.length
        selections += ReferenceAnnotationSelection(open.id, open.kind, open.start, source.length)
    else
        stack += ReferenceAnnotationOpen(id, kind, source.length)
    cursor = marker-end + 1
?! Error("$name: Unclosed annotation ${stack[stack.length - 1].id}")
    if stack.length > 0
= StrippedReferenceSource(source, selections)

━━━━━━━━━━━━━━━━━━━━
_ do resolve-reference-features [ReferenceFeature]
    - example ReferenceExample
    - presentation SourcePresentation

. features [ReferenceFeature]
for spec in example.features
    . ranges [ReferenceResolvedRange]
    for selection in example.selections
        if selection.id != spec.id
            continue
        . candidates [ReferenceResolvedNode]
        for node in presentation.nodes
            if node.start > selection.start || node.end < selection.end
                continue
            if spec.kind
                if node.kind != spec.kind
                    continue
            else if node.kind == "TopLevel" || node.kind == "Block" || node.kind == "Noop"
                continue
            candidates += ReferenceResolvedNode(node.id, node.kind, node.start, node.end)
        . smallest [ReferenceResolvedNode]
        if candidates.length > 0
            . width = reference-smallest-node-width(candidates)
            for node in candidates
                if node.end - node.start == width
                    smallest += node
        if spec.kind
            ?! Error("${example.name}: No enclosing ${spec.kind} for ${spec.id}")
                if smallest.length == 0
            for left in smallest
                for right in smallest
                    ?! Error("${example.name}: Ambiguous enclosing ${spec.kind} for ${spec.id}")
                        if left.start != right.start || left.end != right.end
        . start = selection.start
        . end = selection.end
        if spec.kind
            start = smallest[0].start
            end = smallest[0].end
        ranges += ReferenceResolvedRange(start, end, selection.start, selection.end, smallest)
    features += ReferenceFeature(spec.id, spec.kind, ranges)
= features

━━━━━━━━━━━━━━━━━━━━
_ do reference-feature-json String
    - example ReferenceExample
    - features [ReferenceFeature]

. json-features [JSON]
for feature in features
    . json-ranges [JSON]
    for range in feature.ranges
        . json-nodes [JSON]
        for node in range.nodes
            . json-node = Map'String'JSON
                • "id" node.id as Int as JSON
                • "kind" node.kind as JSON
                • "start" reference-utf16-offset(example.source, node.start) as Int as JSON
                • "end" reference-utf16-offset(example.source, node.end) as Int as JSON
            json-nodes += json-node
        . selection-start = reference-utf16-offset(example.source, range.selection-start)
        . selection-end = reference-utf16-offset(example.source, range.selection-end)
        . json-range = Map'String'JSON
            • "start" reference-utf16-offset(example.source, range.start) as Int as JSON
            • "end" reference-utf16-offset(example.source, range.end) as Int as JSON
            • "selectionStart" selection-start as Int as JSON
            • "selectionEnd" selection-end as Int as JSON
            • "nodes" json-nodes as JSON
        json-ranges += json-range
    . item = Map'String'JSON
        • "id" feature.id as JSON
        • "ranges" json-ranges as JSON
    if feature.kind
        item["kind"] = feature.kind
    json-features += item
. root = Map'String'JSON
    • "source" example.source as JSON
    • "features" json-features as JSON
    • "sourceMap" List'JSON() as JSON
= reference-script-json(to-json(root))

━━━━━━━━━━━━━━━━━━━━
_ do reference-fenced-codes [MDFencedCode]
    - markdown Markdown

. codes [MDFencedCode]
collect-reference-fenced-codes(markdown, codes)
= codes

━━━━━━━━━━━━━━━━━━━━
_ do collect-reference-fenced-codes
    - node Markdown
    - codes [MDFencedCode]

do match? node
    | MDFencedCode
        codes += it
    | MDDocument
        for child in it.content
            collect-reference-fenced-codes(child, codes)
    | MDBlockQuote
        for child in it.content
            collect-reference-fenced-codes(child, codes)
    | MDList
        for child in it.children
            collect-reference-fenced-codes(child, codes)
    | MDListItem
        for child in it.blocks
            collect-reference-fenced-codes(child, codes)

━━━━━━━━━━━━━━━━━━━━
_ do reference-example-id String?
    - document MarkdownSiteDocument
    - code MDFencedCode

=? if code.language != "yumi"
. opening = document.source[code.range.start .. < code.body-range.start]
. hash = opening.find("#")
=? if !hash
. id = opening[hash + 1 ...].trim()
?! Error("${document.source-name}:${code.first-body-line - 1}: Invalid example name")
    if !reference-annotation-id(id)
= id

━━━━━━━━━━━━━━━━━━━━
_ do reference-example ReferenceExample?
    - examples [ReferenceExample]
    - id String

for example in examples
    =? example if example.id == id

━━━━━━━━━━━━━━━━━━━━
_ do reference-feature-spec ReferenceFeatureSpec?
    - features [ReferenceFeatureSpec]
    - id String

for feature in features
    =? feature if feature.id == id

━━━━━━━━━━━━━━━━━━━━
_ do reference-smallest-node-width Index
    - nodes [ReferenceResolvedNode]

. result = nodes[0].end - nodes[0].start
for node in nodes
    . width = node.end - node.start
    if width < result
        result = width
= result

━━━━━━━━━━━━━━━━━━━━
_ do add-reference-boundary
    - boundaries [Index]
    - boundary Index

for existing in boundaries
    =? if existing == boundary
. index Index
while index < boundaries.length && boundaries[index] < boundary
    index += 1
boundaries.insert(boundary, index)

━━━━━━━━━━━━━━━━━━━━
_ reference-feature-covers Bool
    - feature ReferenceFeature
    - start Index
    - end Index

some(feature.ranges) • where each.start <= start && each.end >= end

━━━━━━━━━━━━━━━━━━━━
_ reference-feature-starts Bool
    - feature ReferenceFeature
    - start Index

some(feature.ranges) • where each.start == start

━━━━━━━━━━━━━━━━━━━━
_ do reference-utf16-offset Index
    - source String
    - codepoint-offset Index

. result Index
for index in 0 .. < codepoint-offset
    result += if (source[index] as U32) > 65535 then 2 else 1
= result

━━━━━━━━━━━━━━━━━━━━
_ do reference-annotation-id Bool
    - value String

=? false if !value
=? false if value[0] < 'a' || value[0] > 'z'
. previous-hyphen = false
for char in value
    . hyphen = char == '-'
    =? false if hyphen && previous-hyphen
    =? false if !hyphen && !(char >= 'a' && char <= 'z') && !(char >= '0' && char <= '9')
    previous-hyphen = hyphen
= !previous-hyphen

━━━━━━━━━━━━━━━━━━━━
_ do reference-node-kind Bool
    - value String

=? false if !value
. first = value[0]
=? false if !(first >= 'A' && first <= 'Z') && !(first >= 'a' && first <= 'z')
for char in value[1 ...]
    . letter = (char >= 'A' && char <= 'Z') || (char >= 'a' && char <= 'z')
    . number = char >= '0' && char <= '9'
    =? false if !letter && !number
= true

━━━━━━━━━━━━━━━━━━━━
_ reference-html-character String
    - char Char

|? char == '&'
    "&amp;"
|? char == '<'
    "&lt;"
|? char == '>'
    "&gt;"
|? char == '"'
    "&quot;"
|? char == '\''
    "&#39;"
??
    char as String

━━━━━━━━━━━━━━━━━━━━
_ reference-html-attribute-character String
    - char Char

|? char == '"'
    "&quot;"
|? char == '\''
    "&#39;"
??
    reference-html-character(char)

━━━━━━━━━━━━━━━━━━━━
_ reference-script-json String
    - text String

"".join(reference-script-json-character(each) in text)

━━━━━━━━━━━━━━━━━━━━
_ reference-script-json-character String
    - char Char

|? char == '<'
    "\\u003c"
|? char == '>'
    "\\u003e"
|? char == '&'
    "\\u0026"
??
    char as String
