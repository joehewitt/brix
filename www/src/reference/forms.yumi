./../markdown-site/site
./../yumi-html/source-html
./annotations
/data/markdown
/lang/brix/convert
/os/file

━━━━━━━━━━━━━━━━━━━━
+ do render-reference-forms String
    - document MarkdownSiteDocument
    - code MDFencedCode

. name = "${document.source-name}:${code.first-body-line}"
. forms = code.body.trim()
. rows = reference-rows(forms, name)
. opening = document.source[code.range.start .. < code.body-range.start]
. rows-html = reference-rows-html(rows, name, opening.find("compile-error"))
= reference-forms-html(rows-html, reference-html(forms))

━━━━━━━━━━━━━━━━━━━━
+ do render-reference-inline-code String
    - document MarkdownSiteDocument
    - code MDInlineCode

. text = reference-html(code.code)
if code.language == "brix"
    . rows = reference-rows(code.code, "${document.source-name}: ${code.code}")
    . multiline = if rows.find("\n") then " brix-multiline" else ""
    . html = "<code class=\"language-brix$multiline\"><span class=\"brix-rows\">"
    html += "${reference-html(rows)}</span><span class=\"brix-forms\">$text</span></code>"
    = html
=? "<code>$text</code>" if !code.language
= "<code class=\"language-${reference-html-attribute(code.language)}\">$text</code>"

━━━━━━━━━━━━━━━━━━━━
_ do reference-rows String
    - forms String
    - name String

. text = brix-yumi-text(forms)
    catch error Error
        ?! Error("$name: ${error.message}")
. lines = List(text.split("\n"))
if lines && lines.tail.starts-with("━")
    lines.pop()
= "\n".join(lines).trim()

━━━━━━━━━━━━━━━━━━━━
_ do reference-rows-html String
    - rows String
    - name String
    - refused Bool

= yumi-source-code-html(rows, name)
    catch error Error
        if !refused
            stderr.write("Warning: $name: rows are not highlighted: ${error.message}\n")
        = "<pre><code class=\"language-rows\">${reference-html(rows)}</code></pre>"

━━━━━━━━━━━━━━━━━━━━
_ ¶ reference-forms-html
    - rows String
    - forms String

<div class="brix-code" data-brix-code>\
<div class="brix-rows">$rows</div>\
<div class="brix-forms"><pre><code class="language-brix">$forms</code></pre></div>\
</div>
