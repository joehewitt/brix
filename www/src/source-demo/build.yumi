./../yumi-html/source-html
/BxCore/BxCore.h
/os/cli
/os/file
/os/path

run-source-demo-builder()

━━━━━━━━━━━━━━━━━━━━
_ SourceDemoBuildOptions is Tuple

+ output Path

━━━━━━━━━━━━━━━━━━━━
_ do run-source-demo-builder

. options = source-demo-build-options(cmdline-args())
. fragments [String]
. inputs = source-demo-inputs()
for index in 0 .. < inputs.length
    fragments += render-source-demo-file(inputs[index], index)
. template = read-file-text(Path("www/src/source-demo/template.html"))
. stylesheet = read-file-text(Path("www/src/source-demo/style.css"))
. javascript = read-file-text(Path("www/src/source-demo/script.js"))
. rendered-fragments = "\n".join(fragments)
. html = source-demo-template-value(template, "{{DEMO_CSS}}", stylesheet)
html = source-demo-template-value(html, "{{YUMI_SOURCE_FRAGMENT}}", rendered-fragments)
html = source-demo-template-value(html, "{{DEMO_JS}}", source-demo-script(javascript))
ensure-source-demo-directory(options.output)
write-source-demo-file(options.output / "yumi-source-demo.html", html)
-- "Built ${options.output / "yumi-source-demo.html"}"

━━━━━━━━━━━━━━━━━━━━
_ do source-demo-build-options SourceDemoBuildOptions
    - command [String]

. output = Path("www/dist")
. index Index = 1
while index < command.length
    . argument = command[index]
    if argument == "--output"
        index += 1
        ?! Error("--output needs a directory")
            if index >= command.length
        output = Path(command[index])
    else if argument == "--help" || argument == "-h"
        -- "Usage: build-source-demo [--output directory]"
        C:exit(0)
    else
        ?! Error("Unknown option $argument")
    index += 1
= SourceDemoBuildOptions(output)

━━━━━━━━━━━━━━━━━━━━
_ source-demo-inputs [String]

* "stdlib/data/json.yumi"
* "stdlib/os/process.yumi"
* "stdlib/stream/router.yumi"
* "stdlib/time/timer.yumi"
* "stdlib/gui/color-well.yumi"

━━━━━━━━━━━━━━━━━━━━
_ do render-source-demo-file String
    - path String
    - index Index

. source = read-file-text(Path(path))
. heading = source-demo-html(path)
. rendered = yumi-source-html(source, path)
= source-demo-file(heading, rendered, index)

━━━━━━━━━━━━━━━━━━━━
_ ¶ source-demo-file
    - heading String
    - rendered String
    - index Index

<section class="source-file" aria-labelledby="source-file-$index">
<h2 class="source-file-header" id="source-file-$index">$heading</h2>
$rendered
</section>

━━━━━━━━━━━━━━━━━━━━
_ source-demo-template-value String
    - template String
    - marker String
    - value String

?! Error("Source demo template is missing $marker")
    if !start
template[... start] ++ value ++ template[value-end ...]

.. start = template.find(marker)
.. value-end = start + marker.length

━━━━━━━━━━━━━━━━━━━━
_ source-demo-script String
    - source String

"<\\/script>".join(source.split("</script>"))

━━━━━━━━━━━━━━━━━━━━
_ source-demo-html String
    - text String

"".join(source-demo-html-character(each) in text)

━━━━━━━━━━━━━━━━━━━━
_ source-demo-html-character String
    - char Char

|? char == '&'
    "&amp;"
|? char == '<'
    "&lt;"
|? char == '>'
    "&gt;"
|? char == '"'
    "&quot;"
??
    char as String

━━━━━━━━━━━━━━━━━━━━
_ do ensure-source-demo-directory ?! Error
    - path Path

=? if path.is-dir
if !path.dir.is-dir
    ensure-source-demo-directory(path.dir)
path.make-directory()

━━━━━━━━━━━━━━━━━━━━
_ do write-source-demo-file
    - path Path
    - contents String

. temporary = Path("${path}.tmp")
. permissions = user-read-perm /or/ user-write-perm /or/ group-read-perm /or/ other-read-perm
. flags = FileFlags.write-mode /or/ FileFlags.create-mode /or/ FileFlags.truncate-mode
. output = File(temporary as String, flags, permissions)
output.write(contents)
output.close()
temporary.move(path)
