(import ./../yumi-html/source-html)
(import /BxCore/BxCore.h)
(import /os/cli)
(import /os/file)
(import /os/path)
(blank)

(main
  (call run-source-demo-builder)
)

(type _ SourceDemoBuildOptions (is Tuple)
  (prop + output Path)
)

(fn-do _ run-source-demo-builder _
  (let options (call source-demo-build-options (call cmdline-args)))
  (let fragments (list String))
  (let inputs (call source-demo-inputs))
  (for (in index (..< 0 (. inputs length)))
    (+= fragments (call render-source-demo-file ([] inputs index) index))
  )
  (let template (call read-file-text (call Path "www/source-demo/template.html")))
  (let stylesheet (call read-file-text (call Path "www/source-demo/style.css")))
  (let javascript (call read-file-text (call Path "www/source-demo/script.js")))
  (let rendered-fragments (call (. "\n" join) fragments))
  (let html (call source-demo-template-value template "{{DEMO_CSS}}" stylesheet))
  (= html (call source-demo-template-value html "{{YUMI_SOURCE_FRAGMENT}}" rendered-fragments))
  (= html (call source-demo-template-value html "{{DEMO_JS}}" (call source-demo-script javascript)))
  (call ensure-source-demo-directory (. options output))
  (call write-source-demo-file (/ (. options output) "yumi-source-demo.html") html)
  (print (str "Built " (/ (. options output) "yumi-source-demo.html")))
)

(fn-do _ source-demo-build-options SourceDemoBuildOptions
  (param command (list String))
  (let output (call Path ".tmp/source-demo"))
  (let index Index 1)
  (while (< index (. command length))
    (let argument ([] command index))
    (if (== argument "--output")
      (+= index 1)
      (throw (call Error "--output needs a directory") (if (>= index (. command length))))
      (= output (call Path ([] command index)))
      (else-if (or (== argument "--help") (== argument "-h"))
        (print "Usage: build-source-demo [--output directory]")
        (call C:exit 0)
      )
      (else
        (throw (call Error (str "Unknown option " argument)))
      )
    )
    (+= index 1)
  )
  (return (call SourceDemoBuildOptions output))
)

(fn-expr _ source-demo-inputs (list String)
  (item "stdlib/data/json.yumi")
  (item "stdlib/os/process.yumi")
  (item "stdlib/stream/router.yumi")
  (item "stdlib/time/timer.yumi")
  (item "stdlib/gui/color-well.yumi")
)

(fn-do _ render-source-demo-file String
  (param path String)
  (param index Index)
  (let source (call read-file-text (call Path path)))
  (let heading (call source-demo-html path))
  (let rendered (call yumi-source-html source path))
  (return (call source-demo-file heading rendered index))
)

(fn-expr _ source-demo-file _
  (param heading String)
  (param rendered String)
  (param index Index)
  (paragraph
    (str "<section class=\"source-file\" aria-labelledby=\"source-file-" index "\">")
    (str "<h2 class=\"source-file-header\" id=\"source-file-" index "\">" heading "</h2>")
    (str rendered)
    "</section>"
  )
)

(fn-expr _ source-demo-template-value String
  (param template String)
  (param marker String)
  (param value String)
  (before
    (throw (call Error (str "Source demo template is missing " marker)) (if (not start)))
  )
  (++ ([] template (... _ start)) value ([] template (... value-end)))
  (where
    (lazy start (call (. template find) marker))
    (lazy value-end (+ start (. marker length)))
  )
)

(fn-expr _ source-demo-script String
  (param source String)
  (call (. "<\\/script>" join) (call (. source split) "</script>"))
)

(fn-expr _ source-demo-html String
  (param text String)
  (call (. "" join) (in (call source-demo-html-character each) text))
)

(fn-expr _ source-demo-html-character String
  (param char Char)
  (case? (== char '&')
    "&amp;"
  )
  (case? (== char '<')
    "&lt;"
  )
  (case? (== char '>')
    "&gt;"
  )
  (case? (== char (char "\""))
    "&quot;"
  )
  (default
    (as char String)
  )
)

(fn-do _ ensure-source-demo-directory _ (?! Error)
  (param path Path)
  (return-if (if (. path is-dir)))
  (if (not (. path dir is-dir))
    (call ensure-source-demo-directory (. path dir))
  )
  (call (. path make-directory))
)

(fn-do _ write-source-demo-file _
  (param path Path)
  (param contents String)
  (let temporary (call Path (str path ".tmp")))
  (let permissions (/or/ user-read-perm user-write-perm group-read-perm other-read-perm))
  (let flags (/or/ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let output (call File (as temporary String) flags permissions))
  (call (. output write) contents)
  (call (. output close))
  (call (. temporary move) path)
)
