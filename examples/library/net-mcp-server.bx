; An MCP server: tools an agent can call, served over HTTP. The server, its
; endpoint and each tool are markup, and a tool's work is a function. Run it,
; then give an agent http://127.0.0.1:8765/mcp as an MCP server.
(import /ai/mcp)
(import /data/json)
(import /net/http-server)
(blank)

(main
  (let notes (list String))
  (blank)
  (<> HTTPServer (id: server)
    (= port 8765)
    (blank)
    (<> MCPEndpoint (text: "/mcp")
      (= name "notes")
      (= instructions "Keeps a list of notes for as long as the server runs.")
      (blank)
      (<> MCPTool (text: "add_note")
        (= description "Add a note to the list.")
        ; The schema tells the agent what to send. It is JSON, written as maps.
        (= input-schema
          (call (of Map String JSON)
            (block
              (:type "object")
              (:properties
                (call (of Map String JSON)
                  (block
                    (:text
                      (call (of Map String JSON)
                        (block
                          (:type "string")
                          (:description "What the note says")
                        )
                      )
                    )
                  )
                )
              )
              (:required (list "text"))
            )
          )
        )
        ; The text a tool returns is its answer. An error here, such as a note
        ; with no text, goes back to the agent as a failed call.
        (= call
          (=> (request) :do
            (block
              (let text (call (. ([] request "text") string)))
              (+= notes text)
              (print (str "an agent added: " text))
              (return (str "Added note " (. notes length) "."))
            )
          )
        )
      )
      (blank)
      (<> MCPTool (text: "list_notes")
        (= description "List every note, one to a line.")
        (= call
          (=> (request) :do
            (block
              (print "an agent read the notes")
              (return (if-expr notes (call (. "\n" join) notes) "There are no notes."))
            )
          )
        )
      )
    )
  )
  (blank)
  (print (str "Notes server at http://" (. server host) ":" (. server port) "/mcp"))
  (call (. server run))
)
