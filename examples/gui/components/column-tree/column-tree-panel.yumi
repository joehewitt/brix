/gui

━━━━━━━━━━━━━━━━━━━━
+ ColumnTreePanel is Box

────────────────────

<This • flex-col
    <ColumnTree'DemoNode tree • flex:1
        root-node = DemoNode("root", "Root", true)
        load-children = demo-children
        item-has-children = :: node => node.has-children

        <Label (row) - row
            text = row.#item?.text ?? ""

━━━━━━━━━━━━━━━━━━━━
+ DemoNode is Tuple

+ id String
+ text String
+ has-children = false

━━━━━━━━━━━━━━━━━━━━
+ demo-children [DemoNode]?
    - item DemoNode

match item.id
    | "root"
        * DemoNode("workspace", "Workspace", true)
        * DemoNode("projects", "Projects", true)
        * DemoNode("systems", "Systems", true)
        * DemoNode("teams", "Teams", true)
        * DemoNode("archive", "Archive", true)

    | "workspace"
        * DemoNode("workspace/design", "Design Notes", true)
        * DemoNode("workspace/data", "Data Sets", true)
        * DemoNode("workspace/research", "Research", true)
        * DemoNode("workspace/roadmap", "Roadmap", true)
        * DemoNode("workspace/inbox", "Inbox", true)
        * DemoNode("workspace/readme", "README.md")
        * DemoNode("workspace/today", "Today.todo")
        * DemoNode("workspace/scratch", "Scratchpad.txt")

    | "workspace/design"
        * DemoNode("workspace/design/components", "Components", true)
        * DemoNode("workspace/design/tui", "TUI", true)
        * DemoNode("workspace/design/accessibility", "Accessibility", true)
        * DemoNode("workspace/design/sketches", "Sketches", true)
        * DemoNode("workspace/design/listbox", "ListBox spec.md")
        * DemoNode("workspace/design/columntree", "ColumnTree spec.md")
        * DemoNode("workspace/design/layout", "Layout notes.md")
        * DemoNode("workspace/design/theme", "Theme palette.md")
        * DemoNode("workspace/design/scroll", "Scroll behavior.md")
        * DemoNode("workspace/design/keyboard", "Keyboard map.md")

    | "workspace/design/components"
        ** DemoNode("workspace/design/components/rfc-${each}", "RFC ${each}: Contract") in 1 .. 8
        * DemoNode("workspace/design/components/style-rules", "Style rules.md")
        * DemoNode("workspace/design/components/slots", "Slots and rows.md")
        * DemoNode("workspace/design/components/focus", "Focus choreography.md")

    | "workspace/design/tui"
        * DemoNode("workspace/design/tui/listbox", "ListBox")
        * DemoNode("workspace/design/tui/columntree", "ColumnTree")
        * DemoNode("workspace/design/tui/dialogs", "Dialogs")
        * DemoNode("workspace/design/tui/forms", "Forms")
        * DemoNode("workspace/design/tui/status", "Status bars")
        ** DemoNode("workspace/design/tui/note-${each}", "Layout note ${each}.md") in 1 .. 5

    | "workspace/design/accessibility"
        * DemoNode("workspace/design/accessibility/focus-order", "Focus order.md")
        * DemoNode("workspace/design/accessibility/status-text", "Status text.md")
        * DemoNode("workspace/design/accessibility/color-contrast", "Color contrast.md")
        * DemoNode("workspace/design/accessibility/reduced-motion", "Reduced motion.md")

    | "workspace/design/sketches"
        ** DemoNode("workspace/design/sketches/${each}", "Sketch ${each}.yumi") in 1 .. 12

    | "workspace/data"
        * DemoNode("workspace/data/fixtures", "Fixtures", true)
        * DemoNode("workspace/data/exports", "Exports", true)
        * DemoNode("workspace/data/snapshots", "Snapshots", true)
        ** DemoNode("workspace/data/dataset-${each}", "dataset-${each}.jsonl") in 1 .. 9

    | "workspace/data/fixtures"
        * DemoNode("workspace/data/fixtures/columns", "columns.json")
        * DemoNode("workspace/data/fixtures/rows", "rows.json")
        * DemoNode("workspace/data/fixtures/theme", "theme.toml")
        * DemoNode("workspace/data/fixtures/shortcuts", "shortcuts.yaml")

    | "workspace/data/exports"
        ** DemoNode("workspace/data/exports/report-${each}", "report-${each}.csv") in 2022 .. 2026
        * DemoNode("workspace/data/exports/latest", "latest-summary.csv")

    | "workspace/data/snapshots"
        ** DemoNode("workspace/data/snapshots/snapshot-${each}", "snapshot-${each}.bin") in 1 .. 6

    | "workspace/research"
        * DemoNode("workspace/research/terminal-ux", "Terminal UX")
        * DemoNode("workspace/research/lazy-trees", "Lazy trees", true)
        * DemoNode("workspace/research/keyboard-models", "Keyboard models")
        ** DemoNode("workspace/research/brief-${each}", "Research brief ${each}.md") in 1 .. 5

    | "workspace/research/lazy-trees"
        * DemoNode("workspace/research/lazy-trees/memo", "Memo.md")
        * DemoNode("workspace/research/lazy-trees/open-questions", "Open questions.md")
        ** DemoNode("workspace/research/lazy/proto-${each}", "Prototype ${each}") in 1 .. 4

    | "workspace/roadmap"
        * DemoNode("workspace/roadmap/now", "Now")
        * DemoNode("workspace/roadmap/next", "Next")
        * DemoNode("workspace/roadmap/later", "Later")
        ** DemoNode("workspace/roadmap/milestone-${each}", "Milestone ${each}") in 1 .. 6

    | "workspace/inbox"
        ** DemoNode("workspace/inbox/task-${each}", "Task ${each}.todo") in 1 .. 15

    | "projects"
        * DemoNode("projects/yumi", "Yumi", true)
        * DemoNode("projects/sketchbook", "Sketchbook", true)
        * DemoNode("projects/orbit", "Orbit.app", true)
        * DemoNode("projects/notes", "Notes")
        * DemoNode("projects/infra", "Infra", true)
        * DemoNode("projects/labs", "Labs", true)

    | "projects/yumi"
        * DemoNode("projects/yumi/stdlib", "stdlib", true)
        * DemoNode("projects/yumi/examples", "examples", true)
        * DemoNode("projects/yumi/tests", "tests", true)
        * DemoNode("projects/yumi/compiler", "compiler", true)
        * DemoNode("projects/yumi/runtime", "runtime")
        * DemoNode("projects/yumi/readme", "README.md")

    | "projects/yumi/stdlib"
        * DemoNode("projects/yumi/stdlib/tui", "tui")
        * DemoNode("projects/yumi/stdlib/core", "core")
        * DemoNode("projects/yumi/stdlib/data", "data")
        * DemoNode("projects/yumi/stdlib/net", "net")
        * DemoNode("projects/yumi/stdlib/graphics", "graphics")
        ** DemoNode("projects/yumi/stdlib/module-${each}", "module-${each}.yumi") in 1 .. 8

    | "projects/yumi/examples"
        * DemoNode("projects/yumi/examples/tui", "tui")
        * DemoNode("projects/yumi/examples/gui", "gui")
        * DemoNode("projects/yumi/examples/net", "net")
        ** DemoNode("projects/yumi/examples/demo-${each}", "demo-${each}.yumi") in 1 .. 10

    | "projects/yumi/tests"
        ** DemoNode("projects/yumi/tests/core-${each}", "core batch ${each}") in 1 .. 12
        * DemoNode("projects/yumi/tests/stdlib", "stdlib")
        * DemoNode("projects/yumi/tests/parse", "parse")
        * DemoNode("projects/yumi/tests/runtime", "runtime")

    | "projects/yumi/compiler"
        * DemoNode("projects/yumi/compiler/ast", "AST")
        * DemoNode("projects/yumi/compiler/ir", "IR")
        * DemoNode("projects/yumi/compiler/type-system", "Type system")
        * DemoNode("projects/yumi/compiler/markup", "Markup")
        * DemoNode("projects/yumi/compiler/diagnostics", "Diagnostics")

    | "projects/sketchbook"
        * DemoNode("projects/sketchbook/assets", "assets")
        * DemoNode("projects/sketchbook/story", "story.md")
        * DemoNode("projects/sketchbook/timeline", "timeline.md")
        * DemoNode("projects/sketchbook/experiments", "experiments")
        ** DemoNode("projects/sketchbook/page-${each}", "page-${each}.md") in 1 .. 9

    | "projects/orbit"
        * DemoNode("projects/orbit/app", "app")
        * DemoNode("projects/orbit/design", "design")
        * DemoNode("projects/orbit/releases", "releases", true)
        ** DemoNode("projects/orbit/issue-${each}", "Issue ${each}") in 100 .. 112

    | "projects/orbit/releases"
        ** DemoNode("projects/orbit/releases/2026-${each}", "2026.${each}") in 1 .. 8

    | "projects/infra"
        * DemoNode("projects/infra/ci", "ci")
        * DemoNode("projects/infra/probes", "probes")
        * DemoNode("projects/infra/builds", "builds")
        ** DemoNode("projects/infra/runbook-${each}", "Runbook ${each}.md") in 1 .. 6

    | "projects/labs"
        ** DemoNode("projects/labs/experiment-${each}", "Experiment ${each}") in 1 .. 16

    | "systems"
        * DemoNode("systems/tui", "TUI", true)
        * DemoNode("systems/compiler", "Compiler", true)
        * DemoNode("systems/runtime", "Runtime", true)
        * DemoNode("systems/probes", "Probes", true)
        * DemoNode("systems/networking", "Networking", true)
        * DemoNode("systems/storage", "Storage")

    | "systems/tui"
        * DemoNode("systems/tui/box", "Box")
        * DemoNode("systems/tui/layout", "Layout")
        * DemoNode("systems/tui/style", "Style")
        * DemoNode("systems/tui/events", "Events")
        * DemoNode("systems/tui/window", "Window")
        * DemoNode("systems/tui/shortcuts", "Shortcuts")
        * DemoNode("systems/tui/terminal", "Terminal")

    | "systems/compiler"
        * DemoNode("systems/compiler/parser", "Parser")
        * DemoNode("systems/compiler/type-checker", "Type checker")
        * DemoNode("systems/compiler/codegen", "Codegen")
        * DemoNode("systems/compiler/tests", "Tests")
        ** DemoNode("systems/compiler/pass-${each}", "Pass ${each}") in 1 .. 7

    | "systems/runtime"
        * DemoNode("systems/runtime/gc", "GC")
        * DemoNode("systems/runtime/tasks", "Tasks")
        * DemoNode("systems/runtime/io", "IO")
        * DemoNode("systems/runtime/events", "Events")
        ** DemoNode("systems/runtime/checkpoint-${each}", "Checkpoint ${each}") in 1 .. 5

    | "systems/probes"
        * DemoNode("systems/probes/timeline", "Timeline")
        * DemoNode("systems/probes/snapshots", "Snapshots")
        * DemoNode("systems/probes/inspector", "Inspector")
        ** DemoNode("systems/probes/profile-${each}", "Profile ${each}.probes") in 1 .. 10

    | "systems/networking"
        * DemoNode("systems/networking/http", "HTTP")
        * DemoNode("systems/networking/sse", "SSE")
        * DemoNode("systems/networking/jsonrpc", "JSON-RPC")
        ** DemoNode("systems/networking/trace-${each}", "Trace ${each}.log") in 1 .. 6

    | "teams"
        * DemoNode("teams/design", "Design", true)
        * DemoNode("teams/compiler", "Compiler", true)
        * DemoNode("teams/runtime", "Runtime")
        * DemoNode("teams/qa", "QA")
        ** DemoNode("teams/sync-${each}", "Sync notes ${each}.md") in 1 .. 8

    | "teams/design"
        * DemoNode("teams/design/reviews", "Reviews")
        * DemoNode("teams/design/research", "Research")
        ** DemoNode("teams/design/crit-${each}", "Crit ${each}") in 1 .. 6

    | "teams/compiler"
        ** DemoNode("teams/compiler/issue-${each}", "Compiler issue ${each}") in 200 .. 212
        * DemoNode("teams/compiler/triage", "Triage")

    | "archive"
        ** DemoNode("archive/${each}", "$each", each >= 2025) in 2021 .. 2026
        * DemoNode("archive/ideas", "Old Ideas", true)
        * DemoNode("archive/graveyard", "Graveyard")

    | "archive/2026"
        ** DemoNode("archive/2026/sprint-${each}", "Sprint ${each}") in 1 .. 18
        * DemoNode("archive/2026/releases", "Releases")
        * DemoNode("archive/2026/notes", "Notes")

    | "archive/2025"
        ** DemoNode("archive/2025/month-${each}", "Month ${each}") in 1 .. 12

    | "archive/ideas"
        ** DemoNode("archive/ideas/idea-${each}", "Idea ${each}.md") in 1 .. 20
    ??
        List'DemoNode()
