/graphics/color
/graphics/text
/gui

━━━━━━━━━━━━━━━━━━━━
• ColorPickerTheme
    using GUIDefaultTheme
    using GUIBoxPaint
    using GUITextPaint
    using GUIFontStyle

• showcase-panel • bg:gui-panel-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 14

• showcase-heading • text:gui-strong-text-color
    font-size = 15
    font-weight = FontWeight.bold

• showcase-caption • text:gui-muted-text-color
    font-size = 12

• showcase-swatch
    border-color = gui-border-color
    border-width = 1
    corner-radius = 10

• PlaneSlider
    corner-radius = 10

━━━━━━━━━━━━━━━━━━━━
+ ColorPickerPanel is Box
    using ColorPickerTheme

+ chosen = RGBA("#e8641c")
+ gesture = "Drag, or type a hex code"

────────────────────

<This • flex-row p:24
    <Box • showcase-panel flex-col w:300 p:18
        <ColorPicker picker • flex:1
            color = #chosen
            checker-light = $gui-border-color
            checker-dark = $gui-field-color
            for event on value-changed
                choose(event)

    <Box • flex-col flex:1 ml:24
        <Label • showcase-heading h:22
            text = "Color"
        <Label • showcase-caption h:18 mt:4
            text = "Drags report each gesture phase"
        <Box • showcase-swatch h:150 mt:16
            background = ColorSwatchPainter(#chosen, $gui-border-color, $gui-field-color)
        <Label • h:22 mt:14
            font-size = 14
            text = "#${hex-text(#chosen)} · ${opacity-text(#chosen.alpha)} opacity"
        <Label • showcase-caption h:18 mt:4
            text = #gesture
        <Box • flex-row h:30 mt:18
            for preset in showcase-presets()
                <ColorPresetButton • w:30 h:30 mr:6
                    preset = preset
                    for event on click
                        apply-preset(preset)
                        event.cancel()

────────────────────
+ do choose
    - event ValueChange'RGBA

chosen = event.value
gesture = showcase-phase-label(event.phase)

────────────────────
+ do apply-preset
    - preset RGBA

chosen = preset
gesture = "Preset assigned"

━━━━━━━━━━━━━━━━━━━━
+ ColorPresetButton is Box

+ preset RGBA

• This • showcase-swatch
    focus-mode = FocusMode.press
    window-draggable = false

────────────────────

<This
    background = ColorSwatchPainter(#preset, $gui-border-color, $gui-field-color)

━━━━━━━━━━━━━━━━━━━━
_ showcase-presets

* RGBA("#e8641c")
* RGBA("#2563eb")
* RGBA("#16a34a")
* RGBA("#f5d90a")
* RGBA(0.86, 0.15, 0.47, 0.5)
* RGBA("#ffffff")

━━━━━━━━━━━━━━━━━━━━
+ showcase-phase-label
    - phase ValueChangePhase

match phase
    |= ValueChangePhase.began
        "Gesture began"
    |= ValueChangePhase.changed
        "Gesture changing"
    |= ValueChangePhase.ended
        "Gesture ended"
    ??
        "Discrete change"
