./controls-kit
/gui
/gui/icons/lucide/download
/gui/icons/lucide/inbox
/gui/icons/lucide/plus
/gui/icons/lucide/search
/gui/icons/lucide/settings
/gui/icons/lucide/star

━━━━━━━━━━━━━━━━━━━━
+ ButtonsPanel is Box
    using ControlsTheme

+ is-starred = true

────────────────────

<This • controls-page
    <ControlsCard "Push buttons"
        <Box • controls-row
            <Button "Cancel"
            <Button "Save"
                role = ButtonRole.default
        <Box • controls-row
            <Button "Delete"
                role = ButtonRole.destructive
            <Button "Starred" • icon-star
                is-on = #is-starred
                action = => do toggle-star()
        <Box • controls-row
            <Button "Disabled"
                is-enabled = false
            <Button "Default"
                role = ButtonRole.default
                is-enabled = false
    <ControlsCard "Icons, hints and badges"
        <Box • controls-row
            <Button "Add" • icon-plus
            <Button • icon-settings
        <Box • controls-row
            <Button "Search" • icon-search
                <Label (trailing) "⌘K" • button-hint
            <Button "Inbox" • icon-inbox
                <Label (trailing) "12" • button-badge
    <ControlsCard "Icon buttons"
        <Box • controls-row
            <IconButton • icon-plus
            <IconButton • icon-search
            <IconButton • icon-star
                is-on = true
            <IconButton • icon-settings
            <IconButton • icon-download
                is-enabled = false
    <ControlsCard "Menus and selects"
        <MenuButton "Sort by Name" • mb:10
            <Menu
                <MenuItem "Name"
                <MenuItem "Date Modified"
                <MenuItem "Size"
        <Select'String • mb:10
            options = controls-fonts()
            selected = "Helvetica"
        <Select'String • mb:10
            options = controls-fonts()
            placeholder = "Choose a font"
        <Select'String
            options = controls-fonts()
            selected = "Menlo"
            is-enabled = false

────────────────────
_ do toggle-star

is-starred = !is-starred

━━━━━━━━━━━━━━━━━━━━
_ controls-fonts [String]

["Avenir", "Baskerville", "Futura", "Helvetica", "Menlo", "Palatino"]
