./controls-kit
/graphics/color
/gui

━━━━━━━━━━━━━━━━━━━━
+ ChoicesPanel is Box
    using ControlsTheme

+ alignment = "left"
+ view = "list"
+ document = "notes"

────────────────────

<This • controls-page
    <ControlsCard "Check boxes and switches"
        <CheckBox "Show hidden files" • mb:10
            is-on = true
        <CheckBox "Wrap lines" • mb:10
        <CheckBox "Some selected" • mb:10
            is-mixed = true
        <CheckBox "Disabled" • mb:14
            is-on = true
            is-enabled = false
        <Switch "Snap to grid" • mb:10
            is-on = true
        <Switch "Show rulers" • mb:10
        <Switch "Disabled"
            is-enabled = false
    <ControlsCard "Segmented controls"
        <SegmentedControl'String • mb:10
            selected = #alignment
            for event on selection-changed
                alignment = event.value
            <Segment'String "Left"
                value = "left"
            <Segment'String "Center"
                value = "center"
            <Segment'String "Right"
                value = "right"
            <Segment'String "Justify"
                value = "justify"
                is-enabled = false
        <SegmentedControl'String
            selected = #view
            for event on selection-changed
                view = event.value
            <Segment'String "List" • flex:1
                value = "list"
            <Segment'String "Board" • flex:1
                value = "board"
            <Segment'String "Timeline" • flex:1
                value = "timeline"
    <ControlsCard "Sliders, progress and color wells"
        <Slider • h:24 mb:6
            minimum = 0
            maximum = 100
            value = 40
        <Slider • h:24 mb:6
            minimum = 0
            maximum = 100
            step = 25
            value = 50
        <Slider • h:24 mb:10
            value = 0.3
            is-enabled = false
        <ProgressBar • mb:10
            minimum = 0
            value = 0.35
        <ProgressBar • mb:14
            minimum = 0
            is-indeterminate = true
        <Box • controls-row
            <ColorWell
                color = RGBA("#3b82f6")
            <ColorWell
                color = RGBA("#f59e0b")
            <ColorWell
                color = RGBA("#22c55e80")
    <ControlsCard "Tabs"
        <TabBar'String
            selected = #document
            for event on selection-changed
                document = event.value
            <TabStrip
                <Tab'String
                    title = "Notes"
                    value = "notes"
                    is-closable = false
                <Tab'String
                    title = "Sketch"
                    value = "sketch"
                    is-renamable = true
                <Tab'String
                    title = "Budget"
                    value = "budget"
