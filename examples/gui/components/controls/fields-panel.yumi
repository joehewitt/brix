./controls-kit
/graphics/color
/gui
/gui/icons/lucide/search

━━━━━━━━━━━━━━━━━━━━
+ FieldsPanel is Box
    using ControlsTheme

────────────────────

<This • controls-page
    <ControlsCard "Text fields"
        <TextInput • mb:10
            placeholder = "Name"
        <TextInput • mb:10
            text = "Ada Lovelace"
        <TextInput • mb:10
            text = "Read only"
            is-read-only = true
        <TextInput
            text = "Disabled"
            is-enabled = false
    <ControlsCard "Rows of fields and buttons"
        <Box • controls-row
            <Label "Name"
            <TextInput • flex:1
                placeholder = "Untitled"
            <Button "Save"
                role = ButtonRole.default
        <Box • controls-row
            <TextInput • flex:1
                placeholder = "Search"
            <IconButton • icon-search
        <Box • controls-row
            <ComboBox • flex:1
                placeholder = "City"
                suggestions = ["Amsterdam", "Berlin", "Lisbon", "Oslo", "Paris"]
            <Select'String
                options = ["Any", "Europe", "Asia"]
                selected = "Any"
    <ControlsCard "Number and color fields"
        <Box • controls-row
            <NumberField • flex:1
                label = "W"
                unit = "px"
                value = 120
                minimum = 0
            <NumberField • flex:1
                label = "A"
                unit = "%"
                value = 80
                minimum = 0
                maximum = 100
                step = 5
        <Box • controls-row
            <NumberField • flex:1
                label = "X"
                value = 3
                is-enabled = false
            <NumberField • flex:1
                label = "Y"
                value = 12
                is-read-only = true
        <ColorField • mb:10
            color = RGBA("#3b82f6")
        <ColorField
            color = RGBA("#22c55e80")
    <ControlsCard "Wrapping and bare fields"
        <TextInput • mb:10
            text = "A wrapping field grows a line at a time as its text wraps, up to three lines, and then scrolls."
            wraps = true
            max-lines = 3
        <TextInput
            placeholder = "A bare field has no bezel"
            is-bare = true
