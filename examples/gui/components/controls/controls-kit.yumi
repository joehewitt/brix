━━━━━━━━━━━━━━━━━━━━
• ControlsTheme
    using GUIDefaultTheme

• controls-page • p:24
    layout = GridLayout([GridTrack.flex(1), GridTrack.flex(1)])
    gap = 16

• controls-card • bg:gui-panel-color flex-col p:16
    border-color = gui-border-color
    border-width = 1
    corner-radius = gui-card-radius

• controls-card-title • h:20 mb:12
    font-size = 14
    font-weight = FontWeight.bold

• controls-row • flex-row mb:10
    gap = 8

