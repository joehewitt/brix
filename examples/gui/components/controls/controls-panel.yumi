./buttons-panel
./choices-panel
./controls-kit
./fields-panel
/gui

━━━━━━━━━━━━━━━━━━━━
+ ControlsPanel is Box
    using ControlsTheme

+ page = "buttons"
+ control-size = ControlSize.regular

────────────────────

<This • flex-col
    <Box • flex-row h:44 px:24 items-center
        <SegmentedControl'String
            selected = #page
            for event on selection-changed
                page = event.value
            <Segment'String "Buttons"
                value = "buttons"
            <Segment'String "Fields"
                value = "fields"
            <Segment'String "Choices"
                value = "choices"
        <SegmentedControl'ControlSize • ml:24
            selected = #control-size
            for event on selection-changed
                set-size(event.value)
            <Segment'ControlSize "Small"
                value = ControlSize.small
            <Segment'ControlSize "Regular"
                value = ControlSize.regular
            <Segment'ControlSize "Large"
                value = ControlSize.large
    <Box stage • flex-col flex:1
        overflow-y = ScrollOverflow.auto
        if #page == "buttons"
            <ButtonsPanel
        else if #page == "fields"
            <FieldsPanel
        else
            <ChoicesPanel

────────────────────
_ do set-size
    - next ControlSize

control-size = next
stage.set-control-size(next)
