./popups-panel
/graphics/color
/graphics/primitives
/graphics/text
/gui

━━━━━━━━━━━━━━━━━━━━
+ ModalSection is Box

+ file-count = 3
+ notification-count = 0

────────────────────

<This • flex-col
    <Box • flex-row
        <DemoCard "Confirmation" • w:330 h:200
            caption = join • stream
                * "A modal dialog blocks the window, keeps Tab inside, closes with Esc, and "
                * "accepts with Return."
            <Button • w:170
                title = "Delete ${#file-count} files…"
                action = => do confirm.show()
            <Dialog confirm
                title = "Delete ${#file-count} files?"
                <Label (body) • w:300 card-caption
                    text = "This removes the files from the project. You can’t undo this action."
                <Box (actions) • flex-row
                    <Box • flex:1
                    <Button "Cancel" • w:90
                        action = => do confirm.dismiss()
                    <Button "Delete" • w:90 ml:8
                        is-on = true
                        action = => do delete-files()
        <DemoCard "Forms in a dialog" • w:330 h:200
            caption = "Menus and selects open above the dialog and stay inside its modal scope."
            <Button "New project…" • w:170
                action = => do project.show()
            <Dialog project "New project"
                <Box (body) • flex-col w:300
                    <TextInput project-name
                        placeholder = "Project name"
                    <Box • flex-row h:26 mt:10
                        <Label • w:80
                            text = "Template"
                        <Select'String • flex:1
                            options = ["Blank", "Document", "Presentation", "Spreadsheet"]
                            selected = "Blank"
                    <Box • flex-row h:26 mt:10
                        <Label • w:80
                            text = "Location"
                        <MenuButton "~/Projects" • flex:1
                            <Menu
                                <MenuItem "~/Projects"
                                <MenuItem "~/Desktop"
                                <MenuItem "Other…"
                <Box (actions) • flex-row
                    <Box • flex:1
                    <Button "Cancel" • w:90
                        action = => do project.dismiss()
                    <Button "Create" • w:90 ml:8
                        role = ButtonRole.default
                        action = => do create-project()
    <Box • flex-row
        <DemoCard "Toasts" • w:330 h:200
            caption = join • stream
                * "Notifications stack in the window corner, never take focus, ignore outside "
                * "clicks, and expire on their own. Click one to dismiss it."
            <Button "Post a notification" • w:190
                action = => do post()
        <DemoCard "Command palette" • w:330 h:200
            caption = join • stream
                * "The command palette is a modal popup centered near the top of the window, with "
                * "a native search field."
            <Button "Open palette  ⌘K" • w:190
                action = => do open-palette()
    <Toaster toaster

────────────────────
+ do delete-files

confirm.dismiss(DismissReason.chosen)
popups-report(this, "Deleted $file-count files")
file-count += 1

────────────────────
+ do create-project

. name = if project-name.text then project-name.text else "Untitled"
project.dismiss(DismissReason.chosen)
popups-report(this, "Created project “$name”")

────────────────────
+ do post

notification-count += 1
toaster.post("Notification $notification-count: saved a copy to the cloud")

────────────────────
+ do open-palette

ancestor'PopupsPanel()?.open-palette()

────────────────────
for accepted on confirm.accepted

delete-files()

────────────────────
for accepted on project.accepted

create-project()
