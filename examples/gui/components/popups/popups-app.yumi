./popups-panel
/gui

<App
    <PopupsWindow
        title = "Yumi GUI: Popups"
        size = (1280, 820)

━━━━━━━━━━━━━━━━━━━━
_ PopupsWindow is Window
    using PopupsTheme

+ section = "menus"
+ sections [PopupsSection] = popups-sections()

────────────────────

<This • shell flex-row
    <Sidebar • w:230
        <Label • sidebar-title h:22 mx:16 mt:14
            text = "Popups"
        <Label • sidebar-caption mx:16 mt:2 mb:12
            text = "Layers, placement, and dismissal on one model."
        <SidebarSection
            for entry in sections
                <SidebarItem
                    title = entry.title
                    is-on = #section == entry.id
                    action = => do show-section(entry.id)
    <PopupsPanel • flex:1
        section = #section

────────────────────
_ do show-section
    - id String

section = id
