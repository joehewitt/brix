━━━━━━━━━━━━━━━━━━━━
• PopupsTheme
    using GUIDefaultTheme

• shell
    font-family = "Helvetica Neue"

• sidebar-title
    font-size = 15
    font-weight = FontWeight.bold

• sidebar-caption • text:gui-muted-text-color
    font-size = 11
    text-wrap = TextWrap.word

• section-title
    font-size = 20
    font-weight = FontWeight.bold

• section-caption • text:gui-muted-text-color
    text-wrap = TextWrap.word

• demo-card • bg:gui-panel-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 12

• demo-well • bg:gui-well-color
    border-color = gui-border-color
    border-width = 1

• card-title
    font-size = 14
    font-weight = FontWeight.bold

• card-caption • text:gui-muted-text-color
    font-size = 12
    text-wrap = TextWrap.word

• status-bar • bg:gui-panel-color
    border-color = gui-divider-color
    border-top-width = 1
    font-size = 12

• swatch
    corner-radius = 6
    border-color = gui-border-color
    border-width = 1

━━━━━━━━━━━━━━━━━━━━
+ PopupsSection is Tuple

+ id String
+ title String
+ caption String

━━━━━━━━━━━━━━━━━━━━
+ PopupsPanel is Box
    using PopupsTheme

+ section = "menus"
+ status = popups-intro-status()
+ current = popups-section(#section)

────────────────────

<This • shell flex-col
    <Box • flex-col px:24 pt:20 pb:12
        <Label • section-title h:28
            text = #current.title
        <Label • section-caption mt:4
            text = #current.caption
    <Box • flex-col flex:1 px:24 pb:16
        if #section == "context"
            <ContextSection • flex:1
        else if #section == "hover"
            <HoverSection • flex:1
        else if #section == "forms"
            <FormsSection • flex:1
        else if #section == "popovers"
            <PopoversSection • flex:1
        else if #section == "modal"
            <ModalSection • flex:1
        else if #section == "anchoring"
            <AnchoringSection • flex:1
        else if #section == "creative"
            <CreativeSection • flex:1
        else
            <MenusSection • flex:1
    <Box • status-bar flex-row h:30 px:16 items-center
        <Label • flex:1
            text = #status
        <MenuButton "Zoom 100%" • w:120
            <Menu
                for zoom in ["50%", "75%", "100%", "125%", "150%", "200%", "400%"]
                    <MenuItem
                        title = zoom
                        action = => do
                            report("Zoom menu opened below the window edge: chose $zoom")
    <KeyShortcut "Command Palette"
        key = KeyCombo("Cmd+K")
        repeat = false
        action = => do palette.show()
    <CommandPalette palette • centered:60

────────────────────
+ do report
    - text String

status = text

────────────────────
+ do open-palette

palette.show()

━━━━━━━━━━━━━━━━━━━━
+ popups-sections

* PopupsSection
    - "menus"
    - "Menus"
    - join • stream
        * "Menu bars, menu buttons, submenus, checkmarks, disabled items, and menus that fit the "
        * "screen."
* PopupsSection
    - "context"
    - "Context menus"
    - join • stream
        * "Right-click or Control-click. The nearest context menu to the pressed element wins; "
        * "press, drag, and release chooses."
* PopupsSection
    - "hover"
    - "Tooltips and hover cards"
    - join • stream
        * "Hover-triggered popups with a warm-up delay, instant switching once warm, and "
        * "interactive cards you can move into."
* PopupsSection
    - "forms"
    - "Selects and autocomplete"
    - join • stream
        * "A select places its chosen row over the field; autocomplete suggestions never take "
        * "focus from the text field."
* PopupsSection
    - "popovers"
    - "Popovers"
    - join • stream
        * "Anchored panels with arrows that follow the side they land on, nested popups, and "
        * "native text fields inside a popup."
* PopupsSection
    - "modal"
    - "Dialogs and notifications"
    - join • stream
        * "Modal dialogs trap focus and input, toasts stack in a corner, and the command palette "
        * "is just another popup."
* PopupsSection
    - "anchoring"
    - "Anchoring and placement"
    - join • stream
        * "Popups follow anchors through scrolling, close when the anchor scrolls away, and flip "
        * "or shift at screen edges."
* PopupsSection
    - "creative"
    - "Creative"
    - join • stream
        * "Custom placements and layouts: a radial menu, a drag ghost that leaves the window, and "
        * "a spotlight tour."

━━━━━━━━━━━━━━━━━━━━
+ do popups-section PopupsSection
    - id String

. sections [PopupsSection] = popups-sections()
for section in sections
    =? section if section.id == id
= sections[0]

━━━━━━━━━━━━━━━━━━━━
+ popups-has-section Bool
    - id String

some(popups-sections()) • where each.id == id

━━━━━━━━━━━━━━━━━━━━
+ DemoCard is Box

+ title = ""
+ caption = ""

────────────────────
+ This
    - title = ""

────────────────────

<This • demo-card flex-col p:16 mr:14 mb:14
    <Label • card-title h:20
        text = #title
    <Label • card-caption mt:4 mb:12
        text = #caption

━━━━━━━━━━━━━━━━━━━━
+ do popups-report
    - box Box
    - text String

box.ancestor'PopupsPanel()?.report(text)

━━━━━━━━━━━━━━━━━━━━
_ popups-intro-status

join • stream
    * "Every popup here is a native child panel: "
    * "it can cover native controls and extend past the window."
