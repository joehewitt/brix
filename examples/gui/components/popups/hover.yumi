./popups-panel
/graphics/color
/graphics/primitives
/graphics/text
/gui
/gui/icons/lucide/align-left
/gui/icons/lucide/bold
/gui/icons/lucide/image
/gui/icons/lucide/italic
/gui/icons/lucide/share
/gui/icons/lucide/trash
/gui/icons/lucide/type
/gui/icons/lucide/underline

━━━━━━━━━━━━━━━━━━━━
+ HoverSection is Box

────────────────────

<This • flex-col
    <Box • flex-row
        <DemoCard "Tooltips" • w:440 h:190
            caption = join • stream
                * "Rest on a tool for a moment. Once one tooltip is showing, moving along the "
                * "toolbar switches instantly; after a pause the delay returns."
            <Box • flex-row h:40
                <ToolButton • icon-bold w:40 h:40
                    <Tooltip "Bold  ⌘B"
                <ToolButton • icon-italic w:40 h:40 ml:4
                    <Tooltip "Italic  ⌘I"
                <ToolButton • icon-underline w:40 h:40 ml:4
                    <Tooltip "Underline  ⌘U"
                <ToolButton • icon-align-left w:40 h:40 ml:4
                    <Tooltip "Align text"
                <ToolButton • icon-image w:40 h:40 ml:4
                    <Tooltip "Insert image"
                <ToolButton • icon-type w:40 h:40 ml:4
                    <Tooltip "Text style"
                        placement = AnchoredPlacement(Side.bottom, AnchorPoint.center, 6)
                <ToolButton • icon-share w:40 h:40 ml:4
                    <Tooltip "Share (below, by request)"
                        placement = AnchoredPlacement(Side.bottom, AnchorPoint.center, 6)
                <ToolButton • icon-trash w:40 h:40 ml:4
                    <Tooltip "Delete"
        <DemoCard "Hover cards" • w:440 h:190
            caption = join • stream
                * "Hover a person. The card is interactive: move into it and it stays open; its "
                * "button works."
            <Box • flex-row h:44
                for person in showcase-people()
                    <PersonChip • w:44 h:44 mr:10
                        person = person
    <Box • flex-row
        <DemoCard "Tooltips never block" • w:440 h:150
            caption = join • stream
                * "Tooltips pass the pointer through and close on any press, so they never steal a "
                * "click from what is under them."
            <Button "Click me through a tooltip" • w:230
                action = => do
                    popups-report(this, "The click reached the button under the tooltip")
                <Tooltip "I sit right on top of the button"
                    placement = AnchoredPlacement(Side.bottom, AnchorPoint.center, -14)

━━━━━━━━━━━━━━━━━━━━
+ ToolButton is Box

• This • flex-col text:gui-muted-text-color
    focus-mode = FocusMode.press
    corner-radius = gui-control-radius

    when #is-hover-within
        • bg:gui-hover-color
        • text:gui-text-color

    • icon
        align-y = Alignment.center

────────────────────

<This
    <Box • icon-host flex-row flex:1
        align-x = Alignment.center

━━━━━━━━━━━━━━━━━━━━
+ ShowcasePerson is (name String, role String, initials String, color RGBA)

━━━━━━━━━━━━━━━━━━━━
+ showcase-people

* ShowcasePerson("Ada Lovelace", "Analytical engines", "AL", "#f59e0b")
* ShowcasePerson("Grace Hopper", "Compilers", "GH", "#3b82f6")
* ShowcasePerson("Alan Kay", "Objects and messages", "AK", "#10b981")
* ShowcasePerson("Barbara Liskov", "Abstraction", "BL", "#ef4444")

━━━━━━━━━━━━━━━━━━━━
+ PersonChip is Box

+ person ShowcasePerson
+ following = false

• This
    corner-radius = 22
    color = "#ffffff"
    font-weight = FontWeight.bold

────────────────────

<This • flex-row
    background-color = person.color
    <Label • flex:1
        align-y = Alignment.center
        text = person.initials
        text-alignment = TextAlignment.center
    <HoverCard • w:240
        <Box • flex-row h:40
            <Box • flex-row w:40 h:40
                background-color = person.color
                corner-radius = 20
                <Label • flex:1 text:"#ffffff"
                    text = person.initials
                    text-alignment = TextAlignment.center
            <Box • flex-col flex:1 ml:10
                <Label • h:18
                    text = person.name
                    font-weight = FontWeight.bold
                <Label • h:16 text:gui-muted-text-color
                    text = person.role
        <Button • mt:12
            title = if #following then "Unfollow" else "Follow"
            is-on = #following
            action = => do toggle-follow()

────────────────────
+ do toggle-follow

following = !following
popups-report(this, "${if following then "Following" else "Unfollowed"} ${person.name}")
