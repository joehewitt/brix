+ do hover-check
    - point Point

. targeted = presentation-rect(bounds).contains(point)
if targeted != is-targeted
    is-targeted = targeted
= targeted

━━━━━━━━━━━━━━━━━━━━
+ Spotlight is Popup

+ step Size = 0
+ targets [Box]
+ titles = ["Toolbar", "Search", "Profile"]
+ spotlight-self => this

• This • fill-window modal
    popup-stacking = PopupStacking.manual

────────────────────

<This
    <Popover coach • w:240
        popup-stacking = PopupStacking.manual
        outside-press-dismiss = false
        escape-dismiss = false
        <Label • card-title h:20
            text = "Step ${#step + 1} of 3: ${#titles[#step]}"
        <Label • card-caption h:36
            text = "This popover is anchored to a box it does not own."
        <Box • flex-row mt:10
            <Button "Skip" • flex:1
                action = => do dismiss()
            <Button • flex:1 ml:8
                title = if #step == 2 then "Done" else "Next"
                is-on = true
                action = => do advance()

────────────────────
+ do start
    - first Box
    - second Box
    - third Box

targets = [first, second, third]
step = 0
show(PopupAnchor.window)
focus-step()

────────────────────
+ do advance

if step >= 2
    dismiss(DismissReason.chosen)
    popups-report(this, "Tour finished")
    =
step += 1
focus-step()

────────────────────
+ do focus-step

. target = targets[step]
coach.dismiss()
coach.show(PopupAnchor.box(target))
invalidate-paint()

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-background
    - canvas Canvas

canvas.push()
canvas.stroke-color = null
canvas.fill-color = $gui-scrim-color
canvas.begin()
RoundedRect(bounds, 0, 0, 0, 0).outline(canvas)
if step < targets.length
    . target = targets[step]
    . hole = target.presentation-rect(target.bounds).pad(-8)
    RoundedRect(hole, 12, 12, 12, 12).outline(canvas)
canvas.end(false, FillRule.even-odd)
canvas.pop()
