+ CreativeSection is Box

+ drops = 0
+ section-self => this

────────────────────

<This • flow-row
    <DemoCard "Radial menu" • w:276 h:300
        caption = join • stream
            * "Right-click in the dark area. A custom Placement centers the popup on the pointer "
            * "and a custom Layout arranges items on a ring. Press, drag to a slice, and release."
        <Box • demo-well flex:1
            <RadialMenu
                <RadialItem "Copy" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Copy")
                <RadialItem "Paste" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Paste")
                <RadialItem "Undo" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Undo")
                <RadialItem "Redo" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Redo")
                <RadialItem "Share" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Share")
                <RadialItem "Delete" • w:64 h:64
                    action = => do popups-report(this, "Radial ▸ Delete")
    <DemoCard "Drag ghost" • w:276 h:300
        caption = join • stream
            * "Drag a chip. A pointer-transparent popup follows the pointer, even outside the "
            * "window, and the drop target lights up."
        <Box • flex-row h:36
            for chip in ["Photo", "Song", "Note"]
                <DragChip • w:80 h:32 mr:8
                    title = chip
                    section = section-self
        <DropBin bin • h:120 mt:20
            drops = #drops
    <DemoCard "Spotlight tour" • w:276 h:300
        caption = join • stream
            * "A modal popup paints a dimmed window with a hole around its target, and a popover "
            * "anchored to a box it does not own explains each step."
        <Box • flex-row h:30
            <Button tour-first "Toolbar" • w:58
            <Button tour-second "Search" • w:58 ml:8
            <Button tour-third "Profile" • w:58 ml:8
        <Button "Start tour" • w:120 mt:24
            action = => do spotlight.start(tour-first, tour-second, tour-third)
        <Spotlight spotlight

────────────────────
+ do hover-bin
    - point Point

= bin.hover-check(point)

────────────────────
+ do accept-drop
    - title String

drops += 1
popups-report(this, "Dropped “$title” in the bin")

━━━━━━━━━━━━━━━━━━━━
+ CenterOnPointPlacement is Placement

╌╌╌╌╌╌╌╌╌╌ is Placement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ place
    - request PlacementRequest

PlacementResult(Rect(x, y, size.width, size.height))

.. size = placement-natural-size(request.popup, request.boundary)
.. center = request.anchor.top-left
.. x = placement-clamp(center.x - size.width / 2, boundary.x, boundary.width, size.width)
.. y = placement-clamp(center.y - size.height / 2, boundary.y, boundary.height, size.height)
.. boundary = request.boundary

━━━━━━━━━━━━━━━━━━━━
+ RadialLayout is Layout

+ radius Length

────────────────────
+ This
    - radius = 70

╌╌╌╌╌╌╌╌╌╌ is Layout ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ measure-content
    - box Box
    - query MeasureQuery

Dimensions(radius * 2 + 72, radius * 2 + 72)

────────────────────
+ do arrange-box
    - box Box
    - hint LayoutArrangeHint = LayoutArrangeHint.full

. content = box.content-bounds
. center = content.center
. children [Box]
for child in box.active-children
    children += child
. count = children.length
=? if count == 0
for index in 0 .. < count
    . child = children[index]
    . size = child.measure().outer-size
    . angle = π * (2.0 * index / count - 0.5)
    . x = center.x + cos(angle) * radius - size.width / 2
    . y = center.y + sin(angle) * radius - size.height / 2
    child.arrange-outer-bounds(Rect(x, y, size.width, size.height))

