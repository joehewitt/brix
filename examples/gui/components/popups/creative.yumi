+ do paint-background
    - canvas Canvas

. ring = bounds.center
canvas.push()
canvas.stroke-color = null
canvas.fill-color = $gui-popup-color
canvas.circle(ring.x, ring.y, min(bounds.width, bounds.height) / 2)
canvas.fill-color = $gui-border-color
canvas.circle(ring.x, ring.y, 20)
canvas.pop()

