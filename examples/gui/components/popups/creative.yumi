────────────────────
for event on pointer-drag

if !ghost.is-open
    ghost.show()
section.hover-bin(event.root-point)

────────────────────
for event on pointer-up

if ghost.is-open
    ghost.dismiss()
    if section.hover-bin(event.root-point)
        section.accept-drop(title)
section.hover-bin(Point(-100000, -100000))

