./popups-panel
/graphics/color
/graphics/primitives
/graphics/text
/gui

━━━━━━━━━━━━━━━━━━━━
+ MenusSection is Box

+ show-grid = true
+ show-rulers = false
+ alignment = "Left"
+ fonts [String] = showcase-font-names()

────────────────────

<This • flex-col
    <MenuBar • demo-card mb:14
        is-native = false
        <MenuBarItem "File"
            <Menu
                <MenuItem
                    command = new-document-shortcut
                <MenuItem
                    command = open-document-shortcut
                <MenuItem "Open Recent"
                    <Menu
                        <MenuItem "Quarterly plan.yumi"
                            action = => do report("File ▸ Open Recent ▸ Quarterly plan")
                        <MenuItem "Roadmap.yumi"
                            action = => do report("File ▸ Open Recent ▸ Roadmap")
                        <MenuSeparator
                        <MenuItem "Clear Menu"
                            action = => do report("File ▸ Open Recent ▸ Clear Menu")
                <MenuSeparator
                <MenuItem "Export"
                    <Menu
                        <MenuItem "PNG Image"
                            action = => do report("File ▸ Export ▸ PNG")
                        <MenuItem "SVG Drawing"
                            action = => do report("File ▸ Export ▸ SVG")
                        <MenuItem "More Formats"
                            <Menu
                                <MenuItem "PDF Document"
                                    action = => do report("File ▸ Export ▸ More ▸ PDF")
                                <MenuItem "TIFF Image"
                                    action = => do report("File ▸ Export ▸ More ▸ TIFF")
                <MenuItem "Print…"
                    key = KeyCombo("Cmd+P")
                    is-enabled = false
        <MenuBarItem "Edit"
            <Menu
                <MenuItem
                    command = undo-shortcut
                <MenuItem
                    command = redo-shortcut
                <MenuSeparator
                <MenuItem
                    command = cut-shortcut
                <MenuItem
                    command = copy-shortcut
                <MenuItem
                    command = paste-shortcut
        <MenuBarItem "View"
            <Menu
                <MenuItem "Show Grid"
                    is-on = #show-grid
                    action = => do toggle-grid()
                <MenuItem "Show Rulers"
                    is-on = #show-rulers
                    action = => do toggle-rulers()
                <MenuSeparator
                <MenuItem "Appearance"
                    <Menu
                        <MenuItem "Light"
                            action = => do report("View ▸ Appearance ▸ Light")
                        <MenuItem "Dark"
                            action = => do report("View ▸ Appearance ▸ Dark")
                        <MenuItem "Match System"
                            is-on = true
                            action = => do report("View ▸ Appearance ▸ Match System")
    <Box • flow-row flex:1
        <DemoCard "Menu buttons" • w:276 h:170
            caption = join • stream
                * "Click, or press and drag to an item and release. Use ↑ ↓ → ← Return and Esc "
                * "from the keyboard."
            <Box • flex-row
                <MenuButton "Align: ${#alignment}" • w:150
                    <Menu
                        for choice in ["Left", "Center", "Right", "Justify"]
                            <MenuItem
                                title = choice
                                is-on = #alignment == choice
                                action = => do align(choice)
                <MenuButton "Insert" • w:110 ml:10
                    <Menu
                        <MenuItem "Image…"
                            action = => do report("Insert ▸ Image")
                        <MenuItem "Table"
                            <Menu
                                for size in ["2 × 2", "3 × 3", "4 × 4", "Custom…"]
                                    <MenuItem
                                        title = size
                                        action = => do report("Insert ▸ Table ▸ $size")
                        <MenuItem "Chart"
                            is-enabled = false
        <DemoCard "Long menus fit the screen" • w:276 h:170
            caption = join • stream
                * "Forty fonts: the menu is clamped to the space on screen and scrolls, even "
                * "beyond the window."
            <MenuButton "Choose a font" • w:180
                <Menu
                    for font in #fonts
                        <MenuItem
                            title = font
                            action = => do report("Font ▸ $font")
        <DemoCard "Keyboard shortcuts" • w:276 h:170
            caption = join • stream
                * "Edit menu items read their titles and shortcuts from the same KeyShortcut "
                * "commands the window runs. Try ⌘Z."
            <Label • h:20
                text = "The command palette (⌘K) lists them too."
    <KeyShortcut new-document-shortcut "New Document"
        key = KeyCombo("Cmd+N")
        action = => do report("New Document")
    <KeyShortcut open-document-shortcut "Open…"
        key = KeyCombo("Cmd+O")
        action = => do report("Open…")
    <KeyShortcut undo-shortcut "Undo"
        key = KeyCombo("Cmd+Z")
        action = => do report("Undo")
    <KeyShortcut redo-shortcut "Redo"
        key = KeyCombo("Cmd+Shift+Z")
        action = => do report("Redo")
    <KeyShortcut cut-shortcut "Cut"
        key = KeyCombo("Cmd+X")
        action = => do report("Cut")
    <KeyShortcut copy-shortcut "Copy"
        key = KeyCombo("Cmd+C")
        action = => do report("Copy")
    <KeyShortcut paste-shortcut "Paste"
        key = KeyCombo("Cmd+V")
        action = => do report("Paste")

────────────────────
+ do report
    - text String

popups-report(this, text)

────────────────────
+ do toggle-grid

show-grid = !show-grid
report("View ▸ Show Grid is ${if show-grid then "on" else "off"}")

────────────────────
+ do toggle-rulers

show-rulers = !show-rulers
report("View ▸ Show Rulers is ${if show-rulers then "on" else "off"}")

────────────────────
+ do align
    - choice String

alignment = choice
report("Align ▸ $choice")

━━━━━━━━━━━━━━━━━━━━
+ showcase-font-names

** 0 .. < 40
*> "${font-families[each % font-families.length]} ${each / font-families.length + 1}"
|> List

.. font-families = showcase-font-families()

━━━━━━━━━━━━━━━━━━━━
_ showcase-font-families [String]

* "Avenir"
* "Baskerville"
* "Futura"
* "Gill Sans"
* "Helvetica"
* "Menlo"
* "Optima"
* "Palatino"
