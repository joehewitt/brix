./popups-panel
/graphics/color
/graphics/primitives
/graphics/text
/gui

━━━━━━━━━━━━━━━━━━━━
+ FormsSection is Box

+ family-name = "Futura"
+ size-name = "12"
+ weight-name = "Regular"

────────────────────

<This • flow-row
    <DemoCard "Selects" • w:276 h:250
        caption = join • stream
            * "The open list lines the chosen row up with the field, then shifts to stay on screen "
            * "near an edge."
        <FormRow "Family"
            <Select'String family • w:180
                options = ["Avenir", "Baskerville", "Futura", "Helvetica", "Menlo", "Palatino"]
                selected = #family-name
        <FormRow "Size" • mt:10
            <Select'String size • w:180
                options = ["9", "10", "11", "12", "13", "14", "18", "24", "36", "48", "72"]
                selected = #size-name
        <FormRow "Weight" • mt:10
            <Select'String weight • w:180
                options = ["Regular", "Medium", "Bold", "Black"]
                selected = #weight-name
    <DemoCard "Autocomplete" • w:276 h:250
        caption = join • stream
            * "Type a city. Suggestions follow the field width, ↑ ↓ and Return pick one, and focus "
            * "never leaves the native text field."
        <ComboBox city • w:260
            placeholder = "Search cities"
            suggestions = showcase-cities()
    <DemoCard "Nested inside a popover" • w:276 h:250
        caption = join • stream
            * "Popups can open other popups. The select below lives inside a popover; choosing "
            * "keeps the popover open."
        <Button "Text settings…" • w:170
            action = => do settings.toggle()
            <Popover settings • w:260
                <Label • card-title h:20
                    text = "Text settings"
                <FormRow "Case" • mt:10
                    <Select'String • w:140
                        options = ["Sentence", "Title", "Upper", "Lower"]
                        selected = "Sentence"
                <FormRow "Spacing" • mt:10
                    <Select'String • w:140
                        options = ["Tight", "Normal", "Loose"]
                        selected = "Normal"

────────────────────
for event on family.selection-changed

family-name = event.value
popups-report(this, "Family ▸ ${event.value}")

────────────────────
for event on size.selection-changed

size-name = event.value
popups-report(this, "Size ▸ ${event.value}")

────────────────────
for event on weight.selection-changed

weight-name = event.value
popups-report(this, "Weight ▸ ${event.value}")

────────────────────
for event on city.value-changed

popups-report(this, "City ▸ ${event.value}")

━━━━━━━━━━━━━━━━━━━━
+ FormRow is Box

+ label = ""

────────────────────
+ This
    - label = ""

────────────────────

<This • flex-row h:26
    <Label • w:70
        align-y = Alignment.center
        text = #label

