• showcase-shell
    font-size = 14

• showcase-header • bg:gui-panel-color
    border-color = gui-border-color
    border-width = 1
    font-size = 20
    font-weight = FontWeight.bold

• icon-card • bg:gui-field-color
    border-color = gui-border-color
    border-width = 1
    font-size = 13

━━━━━━━━━━━━━━━━━━━━
+ IconsPanel is Box
    using IconsTheme

────────────────────

<This • showcase-shell flex-col p:22
    <Box • showcase-header flex-col h:74 px:18 py:12
        <Label
            text = "Vector icon showcase"

        <Label • mt:5
            text = "Flow stacks the rows · flex shares each row evenly"

    <Box • icon-grid flow-col flex:1 mt:16
        <Box • icon-row flex-row h:108
            <IconCard "Home"
                <LucideHouse home-icon
                    stroke = "#2563eb"

            <IconCard "Search" • ml:12
                <LucideSearch search-icon
                    stroke = "#7c3aed"

            <IconCard "Bell" • ml:12
                <LucideBell bell-icon
                    stroke = "#d97706"

            <IconCard "Calendar" • ml:12
                <LucideCalendarDays calendar-icon
                    stroke = "#059669"

        <Box • icon-row flex-row h:108 mt:12
            <IconCard "Camera"
                <LucideCamera camera-icon
                    stroke = "#db2777"

            <IconCard "Heart" • ml:12
                <LucideHeart heart-icon
                    stroke = "#e11d48"

            <IconCard "Star" • ml:12
                <LucideStar star-icon
                    stroke = "#ca8a04"

            <IconCard "Compass" • ml:12
                <LucideCompass compass-icon
                    stroke = "#0891b2"

        <Box • icon-row flex-row h:108 mt:12
            <IconCard "Mail"
                <LucideMail mail-icon
                    stroke = "#4f46e5"

            <IconCard "Map pin" • ml:12
                <LucideMapPin map-pin-icon
                    stroke = "#dc2626"

            <IconCard "Music" • ml:12
                <LucideMusic music-icon
                    stroke = "#9333ea"

            <IconCard "Settings" • ml:12
                <LucideSettings settings-icon
                    stroke = "#94a3b8"

        <Box • icon-row flex-row h:108 mt:12
            <IconCard "Sparkles"
                <LucideSparkles sparkles-icon
                    stroke = "#c026d3"

            <IconCard "Weather" • ml:12
                <LucideCloudSun weather-icon
                    stroke = "#0284c7"

            <IconCard "Coffee" • ml:12
                <LucideCoffee coffee-icon
                    stroke = "#a16207"

            <IconCard "Rocket" • ml:12
                <LucideRocket rocket-icon
                    stroke = "#ea580c"

