+ BillionDays is Box

+ source := VirtualRangeSource(timeline-day-count)

────────────────────

<This • flex-col
    <Box • timeline-toolbar flex-row h:56 px:14 py:12
        <Button start-button "Start" • w:80
        <Button middle-button "Middle" • ml:8 w:80
        <Button end-button "End" • ml:8 w:80

        <Label status • timeline-status flex:1 ml:16
            text = "Scroll sideways across a billion days"

    <VirtualRegion'I64 region • flex:1 bg:gui-well-color
        source = #source
        virtual-layout = HorizontalFixedLayout(timeline-column-width)
        overscan = VirtualInsets(0vcoord, 264vcoord, 0vcoord, 264vcoord)

        <DayColumn (row) - slot
            address = slot.#address

────────────────────
+ do jump-to
    - address I64

. last = (timeline-day-count as I64) - 1
. target = if address < 0 then 0 else if address > last then last else address
. ignored = region.scroll-to-address(target)

────────────────────
+ do refresh-status

. viewport = region.content-bounds.width
status.text = timeline-range-text(region.scroll-x, viewport)

────────────────────
for event on region.scroll-changed

refresh-status()

────────────────────
for event on start-button.click

jump-to(0)

────────────────────
for event on middle-button.click

jump-to(499999999)

────────────────────
for event on end-button.click

jump-to(999999999)

━━━━━━━━━━━━━━━━━━━━
+ DayColumn is Box

+ address I64

• This • flex-col p:10
    background-color = if #address % 7 < 5 then $gui-field-color else $gui-panel-color
    border-color = gui-border-color
    border-width = 1

────────────────────

<This
    <Label • day-number h:22
        text = "Day ${timeline-format(#address + 1)}"

    <Label • day-detail h:18
        text = timeline-weekday(#address)

    <Box • flex:1

    <Box • day-bar h:(timeline-bar-height(#address))

━━━━━━━━━━━━━━━━━━━━
+ timeline-bar-height
    - address I64

(16 + (address * 7919) % 180) as F64

━━━━━━━━━━━━━━━━━━━━
+ timeline-weekday
    - address I64

match address % 7
    |= 0
        "Monday"
    |= 1
        "Tuesday"
    |= 2
        "Wednesday"
    |= 3
        "Thursday"
    |= 4
        "Friday"
    |= 5
        "Saturday"
    ??
        "Sunday"

━━━━━━━━━━━━━━━━━━━━
+ timeline-range-text
    - scroll-x F64
    - viewport F64

"Days ${timeline-format(first + 1)}–${timeline-format(last)} of ${timeline-format(total)}"

.. width = (timeline-column-width as I64) as F64
.. first = (scroll-x / width) as I64
.. visible = (viewport / width) as I64
.. total = timeline-day-count as I64
.. last = if first + visible < total then first + visible else total

━━━━━━━━━━━━━━━━━━━━
+ timeline-format String
    - value I64

|? value < 1000
    "$value"
??
    "$head,$pad$tail"

.. head = timeline-format(value / 1000)
.. tail = value % 1000
.. pad = if tail < 10 then "00" else if tail < 100 then "0" else ""
