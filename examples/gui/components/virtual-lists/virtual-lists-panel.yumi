━━━━━━━━━━━━━━━━━━━━
+ VirtualListsPanel is Box
    using VirtualListsTheme

────────────────────

<This • flex-col
    <BillionRows • flex:1
    <BillionDays • h:320

━━━━━━━━━━━━━━━━━━━━
+ BillionRows is Box

+ source := VirtualRangeSource(billion-row-count)

────────────────────

<This • flex-col
    <Box • billion-toolbar flex-row h:56 px:14 py:12
        <Button top-button "Top" • w:72
        <Button million-button "Row 1,000,000" • ml:8 w:128
        <Button middle-button "Middle" • ml:8 w:80
        <Button bottom-button "Bottom" • ml:8 w:80

        <TextInput go-to • ml:16 w:180
            placeholder = "Go to row…"

        <Label status • billion-status flex:1 ml:16
            text = "Scroll, jump, or type a row number"

    <VirtualRegion'I64 region • flex:1 bg:gui-well-color
        source = #source
        virtual-layout = VerticalFixedLayout(billion-row-height)
        overscan = VirtualInsets(112vcoord, 0vcoord, 112vcoord, 0vcoord)

        <BillionRow (row) - slot
            address = slot.#address

────────────────────
+ do jump-to
    - address I64

. last = (billion-row-count as I64) - 1
. target = if address < 0 then 0 else if address > last then last else address
. ignored = region.scroll-to-address(target)

────────────────────
+ do refresh-status

. viewport = region.content-bounds.height
status.text = billion-range-text(region.scroll-y, viewport)

────────────────────
for event on region.scroll-changed

refresh-status()

────────────────────
for event on top-button.click

jump-to(0)

────────────────────
for event on million-button.click

jump-to(999999)

────────────────────
for event on middle-button.click

jump-to(499999999)

────────────────────
for event on bottom-button.click

jump-to(999999999)

────────────────────
for event on go-to.submit

. requested = billion-parse-row(event.text)
if requested
    jump-to(requested - 1)

━━━━━━━━━━━━━━━━━━━━
+ BillionRow is Box

+ address I64

• This • flex-row px:16
    background-color = if #address % 2 == 0 then $gui-well-color else $gui-window-color

────────────────────

<This
    <Label • billion-number w:180
        text = "Row ${billion-format(#address + 1)}"

    <Label • billion-detail flex:1
        text = billion-detail-text(#address)

━━━━━━━━━━━━━━━━━━━━
+ billion-detail-text
    - address I64

"Item ${address % 9973} · shard ${address % 64} · checksum ${(address * 2654435761) % 1000003}"

━━━━━━━━━━━━━━━━━━━━
+ billion-range-text
    - scroll-y F64
    - viewport F64

"Rows ${billion-format(first + 1)}–${billion-format(last)} of ${billion-format(total)}"

.. height = (billion-row-height as I64) as F64
.. first = (scroll-y / height) as I64
.. visible = (viewport / height) as I64
.. total = billion-row-count as I64
.. last = if first + visible < total then first + visible else total

━━━━━━━━━━━━━━━━━━━━
+ billion-format String
    - value I64

|? value < 1000
    "$value"
??
    "$head,$pad$tail"

.. head = billion-format(value / 1000)
.. tail = value % 1000
.. pad = if tail < 10 then "00" else if tail < 100 then "0" else ""

━━━━━━━━━━━━━━━━━━━━
+ do billion-parse-row I64?
    - text String

. value I64
. digits Size = 0
for index in 0 .. < text.length
    . char = text[index]
    if char >= '0' && char <= '9'
        =? if value > 100000000000
        value = value * 10 + ((char - '0') as I64)
        digits += 1
    else if char != ',' && char != ' ' && char != '_'
        = null
=? if digits == 0
= value

