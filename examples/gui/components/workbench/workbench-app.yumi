./demo-bench
/gui
/gui/workbench

. switch-key = KeyCombo("Cmd+T")

<App
    <Window • flex-col
        title = "Yumi GUI: Workbench"
        size = (1280, 820)
        titlebar-visible = false
        stoplight-offset = workbench-stoplight-offset
        state-key = "workbench-demo"

        <DemoBench bench • flex:1
            model = demo-model()
            state-key = "demo"
        <KeyShortcut "Switch Tab…"
            key = switch-key
            repeat = false
            action = => do bench.show-switcher(switch-key)
        <KeyShortcut "Close Tab"
            key = KeyCombo("Cmd+W")
            action = => do bench.close-main-view()
        <KeyShortcut "Reopen Closed Tab"
            key = KeyCombo("Cmd+Shift+T")
            action = => do bench.model.reopen()
        <KeyShortcut "Previous Tab"
            key = KeyCombo("Cmd+{")
            action = => do bench.model.step-tab(-1)
        <KeyShortcut "Next Tab"
            key = KeyCombo("Cmd+}")
            action = => do bench.model.step-tab(1)
