    using DemoTheme

+ state DemoState
+ view String

────────────────────
+ This
    - state
    - view

────────────────────

<This • demo-panel flex-col
    <Label • demo-title
        text = demo-title(view)
    <Label • demo-muted mb:12
        text = "A note that belongs to one context. It moves only in that context’s workspace."
    <Label • demo-big
        text = "${demo-clicks(state, view, state.#revision)}"
    <Button "Count"
        action = => do state.click(view)

