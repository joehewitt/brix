━━━━━━━━━━━━━━━━━━━━
+ demo-title String
    - view String

|? parts.length < 3
    view
|? kind != "note"
    name
??
    "Note ${pieces[pieces.length - 1]}"

.. parts = List'String(view.split("/"))
.. kind = parts[1]
.. name = parts[parts.length - 1]
.. pieces = List'String(name.split("-"))

━━━━━━━━━━━━━━━━━━━━
_ demo-contexts [PaneContext]
    - model PaneModel
    - revision U64

List'PaneContext(model.contexts)

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ demo-current String
    - model PaneModel
    - revision U64

model.current

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ demo-context-name String
    - model PaneModel
    - revision U64

model.context().name

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ do demo-recent [String]
    - state DemoState
    - revision U64

. lines = List'String()
. start = max(0, state.activity.length - 40)
for index in start .. < state.activity.length
    lines += "${index + 1}  ${state.activity[index]}"
= lines

━━━━━━━━━━━━━━━━━━━━
_ demo-is-checked Bool
    - state DemoState
    - item String
    - revision U64

state.checked[item] ?? false

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ demo-clicks Int
    - state DemoState
    - view String
    - revision U64

state.clicks[view] ?? 0

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ do demo-inspect [String]
    - model PaneModel
    - revision U64

. owner = model.context()
. owned = model.layout()
. lines = List'String()
lines += "Context: ${owner.name}"
lines += "Layout: ${owned.name}"
lines += if owned.is-shared then "Shared by ${model.users-of(owned).length} contexts" else "Only ${owner.name} uses it"
lines += "Floating panels: ${owned.floats.length}"
lines += "Open in this context: ${model.session().instances.length}"
= lines

━━━━━━━━━━━━━━━━━━━━
_ do demo-file-lines [String]
    - view String

. name = demo-title(view)
. lines = List'String()
lines += "-- $name"
lines += ""
lines += "+ Panel is Box"
lines += ""
lines += "+ title = \"$name\""
lines += "+ is-open = true"
lines += ""
lines += "<This • flex-col"
lines += "    <Label title"
= lines
