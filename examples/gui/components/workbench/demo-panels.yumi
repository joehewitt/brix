━━━━━━━━━━━━━━━━━━━━
+ DeployPanel is Box
    using DemoTheme

+ state DemoState

────────────────────
+ This
    - state

────────────────────

<This • demo-panel flex-col
    <Label "DEPLOY" • demo-heading
    if demo-current(state.model, state.model.#revision) == "beta"
        <ProgressBar • mb:10
            minimum = 0
            value = 0.62
        <Button "Ship Beta"
            action = => do state.log("Shipped Beta")
    else
        <Label • demo-muted
            text = "${demo-context-name(state.model, state.model.#revision)} has no deploy target."

