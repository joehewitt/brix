━━━━━━━━━━━━━━━━━━━━
+ ChecklistPanel is Box
    using DemoTheme

+ state DemoState

────────────────────
+ This
    - state

────────────────────

<This • demo-panel flex-col
    <Label "TRY THIS" • demo-heading
    for item in demo-checks
        <CheckBox • mb:8
            title = item
            is-on = demo-is-checked(state, item, state.#revision)
            for event on click
                state.toggle-check(item)

━━━━━━━━━━━━━━━━━━━━
+ PalettePanel is Box
    using DemoTheme

+ state DemoState

────────────────────
+ This
    - state

────────────────────

<This • demo-panel flex-col
    <Label "PALETTE" • demo-heading
    <Box • flow-row
        for hex in demo-swatches
            <Button • demo-swatch
                background-color = RGBA(hex)
                border-width = if state.#color == hex then 3 else 1
                border-color = if state.#color == hex then RGBA("#ffffff") else RGBA("#00000040")
                action = => do state.pick-color(hex)
    <Box • h:48 mt:6
        background-color = RGBA(state.#color)
        corner-radius = 8
    <Label • demo-code mt:6
        text = state.#color

