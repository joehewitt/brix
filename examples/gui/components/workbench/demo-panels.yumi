/graphics/color
/graphics/primitives
/graphics/text
/gui
/gui/workbench
/math

+ demo-files = ["main.yumi", "layout.yumi", "theme.yumi", "README.md", "notes.txt"]
+ demo-swatches = ["#ef4444", "#f97316", "#eab308", "#22c55e", "#14b8a6", "#3b82f6", "#6366f1", "#a855f7", "#ec4899", "#78716c"]
+ demo-checks = ["Drag a tab into another group", "Split a pane by dropping on its edge", "Float a group with ⌥ while dragging", "Collapse the right dock to a rail", "Give one context its own layout"]

━━━━━━━━━━━━━━━━━━━━
• DemoTheme
    using GUIDefaultTheme

• demo-panel • p:12

• demo-heading • text:gui-muted-text-color h:18 mb:6
    font-size = 11
    font-weight = FontWeight.bold

• demo-title • text:gui-strong-text-color h:30
    font-size = 20
    font-weight = FontWeight.bold

• demo-text • text:gui-text-color mb:8
    text-wrap = TextWrap.word

• demo-muted • text:gui-muted-text-color
    text-wrap = TextWrap.word

• demo-row • bg:transparent text:gui-text-color h:26 px:8 mb:1
    shadow = null
    corner-radius = 6

    when #is-hover-within
        • bg:gui-hover-color

    when #is-on
        • bg:gui-pressed-color
        • text:gui-strong-text-color

    • button-content
        align-x = Alignment.start

• demo-context • bg:transparent
    shadow = null

    • menu-button-arrow • text:transparent

    when #is-hover-within
        • bg:gui-hover-color
        • menu-button-arrow • text:gui-muted-text-color

    when #is-open
        • bg:gui-pressed-color
        • menu-button-arrow • text:gui-muted-text-color

• demo-code • text:gui-text-color h:20
    font-family = "Menlo"
    font-size = 12

• demo-swatch • w:34 h:34 mr:6 mb:6
    corner-radius = 8
    border-color = gui-border-color
    border-width = 1

• demo-swatch-on
    border-color = gui-strong-text-color
    border-width = 3

• demo-big • text:gui-strong-text-color h:64
    font-size = 48
    font-weight = FontWeight.bold

━━━━━━━━━━━━━━━━━━━━
+ DemoState

+ model PaneModel
+ activity [String]
+ clicks [String = Int]
+ checked [String = Bool]
+ color = "#3b82f6"
+ revision U64

────────────────────
+ This
    - model

────────────────────
+ do open-file
    - name String

. owner = model.context()
model.open("${owner.id}/file/$name", "file")
log("Opened $name in ${owner.name}")

────────────────────
+ do new-note
    - beside String? = null

. owner = model.context()
. view = "${owner.id}/note/${model.make-id("note")}"
model.open(view, "note", beside)
log("Made ${demo-title(view)} in ${owner.name}")

────────────────────
+ do click
    - view String

clicks[view] = (clicks[view] ?? 0) + 1
revision += 1

────────────────────
+ do toggle-check
    - item String

checked[item] = !(checked[item] ?? false)
revision += 1

────────────────────
+ do pick-color
    - value String

color = value
log("Picked $value")

────────────────────
+ do log
    - text String

activity += text
revision += 1

━━━━━━━━━━━━━━━━━━━━
+ ProjectsPanel is Box
    using DemoTheme

+ state DemoState

────────────────────
+ This
    - state

────────────────────

<This • demo-panel flex-col
    <Label "CONTEXTS" • demo-heading
    for owner in demo-contexts(state.model, state.model.#revision) keyed by owner.id
        <Button • demo-row
            title = owner.name
            is-on = owner.id == demo-current(state.model, state.model.#revision)
            action = => do state.model.switch-to(owner.id)
    <Label • demo-muted mt:10
        text = "Projects is an app view: it shows the same list in every context."

