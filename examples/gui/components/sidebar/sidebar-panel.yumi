./files
./theme
/graphics/primitives
/graphics/text
/gui
/gui/icons/lucide/box
/gui/icons/lucide/download
/gui/icons/lucide/inbox
/gui/icons/lucide/map
/gui/icons/lucide/palette
/gui/icons/lucide/plus
