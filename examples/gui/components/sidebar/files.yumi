━━━━━━━━━━━━━━━━━━━━
+ do file-path String?
    - node FileNode
    - id String
    - prefix String = ""

. children = node.children
=? if !children
for child in children
    . path = "$prefix${child.name}"
    =? path if child.id == id
    . found = file-path(child, id, "$path/")
    =? found if found

━━━━━━━━━━━━━━━━━━━━
+ do detach-file
    - parent FileNode
    - node FileNode

. children = parent.children
=? if !children
for index in 0 .. < children.length
    if children[index].id == node.id
        children.remove(index)
        =
for child in children
    detach-file(child, node)

━━━━━━━━━━━━━━━━━━━━
_ file FileNode
    - path String

FileNode(path, file-leaf-name(path))

━━━━━━━━━━━━━━━━━━━━
_ folder FileNode
    - path String
    ... children [FileNode]

FileNode(path, file-leaf-name(path), children)

━━━━━━━━━━━━━━━━━━━━
_ file-leaf-name String
    - path String

if slash == null then path else path[(slash as Index) + 1 .. < path.length]

.. slash = path.find-reverse("/")

━━━━━━━━━━━━━━━━━━━━
_ do notes-folder FileNode
    - count Size

. notes [FileNode]
for index in 0 .. < count
    notes += file("notes/note-${index + 1}.md")
= FileNode("notes", "notes", notes)

