━━━━━━━━━━━━━━━━━━━━
+ ScriptNumber is Span

+ value F64
+ step F64 = 1
+ suffix = ""
+ is-editing = false
+ is-dragging = false
+ number-self => this
_ drag-origin Length = 0
_ drag-start-value F64
_ did-drag = false

────────────────────
+ This
    - value

────────────────────

<This • script-number
    text = if #is-editing then "" else "${gallery-number-text(#value)}$suffix"
    if #is-editing
        <ScriptNumberEditor • script-editor w:72 h:22
            number = number-self
            text = gallery-number-text(value)

────────────────────
for event on pointer-down

drag-origin = event.root-point.x
drag-start-value = value
did-drag = false

────────────────────
for event on pointer-drag

. distance = event.root-point.x - drag-origin
if did-drag || abs(distance) >= 3
    did-drag = true
    is-dragging = true
    value = drag-start-value + round(distance / 2) * step
    ancestor'TextGallery()?.report("Dragging number: ${gallery-number-text(value)}$suffix")

────────────────────
for event on pointer-up

is-dragging = false

────────────────────
for event on click

if !did-drag && !is-editing
    is-editing = true
event.cancel()

────────────────────
+ do commit
    - text String

. parsed = text as F64
if text.length && is-finite(parsed)
    value = parsed
    ancestor'TextGallery()?.report("Edited number: ${gallery-number-text(value)}$suffix")
is-editing = false

