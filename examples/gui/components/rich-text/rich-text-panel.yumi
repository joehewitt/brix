━━━━━━━━━━━━━━━━━━━━
+ TextGallery is Box
    is MarkupBatch
    using TextGalleryTheme

+ markup-batch-queue := MarkupBatchQueue(this as MarkupBatch)
+ status = "Hover and click the links, drag or click the green numbers, click the orange words."
+ reflow-width Length = 420
+ reflow-alignment TextAlignment = TextAlignment.left
+ linked-name = ""
+ counter = 0
+ likes = 3

────────────────────

<This • gallery flex-col p:28
    <Label • gallery-title h:36
        text = "Text"
    <Label • gallery-status h:34 px:12 mt:6 mb:18
        text = #status

    <Box • flex-row
        <Box • flex-col flex:1 mr:18
            <GalleryCard "INLINE STYLES"
                <Text • body
                    "Plain, "
                    <Span "bold" • strong
                    ", "
                    <Span "italic" • em
                    ", "
                    <Span "bold italic" • strong em
                    ", "
                    <Span "serif" • serif
                    " and "
                    <Span "monospace" • mono
                    " faces. Colors like "
                    <Span "crimson"
                        color = "#dc2626"
                    ", "
                    <Span "emerald"
                        color = "#059669"
                    " and "
                    <Span "violet"
                        color = "#7c3aed"
                    ". Sizes share a baseline: "
                    <Span "tiny "
                        font-size = 10
                    <Span "small "
                        font-size = 13
                    <Span "large "
                        font-size = 20
                    <Span "huge"
                        font-size = 30
                        font-weight = FontWeight.bold
                    " back to normal."

            <GalleryCard "DECORATIONS"
                <Text • body
                    "Text can be "
                    <Span "underlined" • underline
                    ", "
                    <Span "struck through" • strike
                    ", marked with a "
                    <Span "dotted spelling note" • wavy-note
                    ", or given a "
                    <Span "thick colored underline" • thick-underline
                    " that follows the text as it "
                    <Span • underline
                        "wraps from one line onto the next without breaking the decoration"
                    "."

            <GalleryCard "BACKGROUNDS, PADDING, BORDERS"
                <Text • body
                    "Call "
                    <Span "layout.fragments" • code
                    " to read span geometry, press "
                    <Span "⌘" • keycap
                    " "
                    <Span "K" • keycap
                    " for commands, and "
                    <Span • marker
                        "highlight the important part of a sentence even when it spans lines"
                    ". Tags: "
                    <Span "design" • tag
                    <Span "stdlib" • tag
                    <Span "text" • tag

            <GalleryCard "NESTED SPANS"
                <Text • body
                    "An outer link "
                    <GalleryLink • link
                        target = "nested link"
                        "contains "
                        <Span "bold" • strong
                        ", "
                        <Span "code()" • code
                        " and "
                        <Span "italic" • em
                        " children"
                    ", and hovering anywhere inside underlines the whole run. Nested "
                    <Span • marker
                        "backgrounds "
                        <Span "stack" • tag
                        " inside each other"
                    "."

            <GalleryCard "SHRINK WRAP"
                <Label • bubble-caption h:16 mb:4
                    text = "Available width: the bubble fills its 250 pt cap"
                <Box • flex-row mb:10
                    <Box • bubble flex-col px:12 py:8
                        <Text • bubble-text
                            "Did the "
                            <Span "styled layout" • strong
                            " land? The wrapped lines leave a ragged gap on the right."
                <Label • bubble-caption h:16 mb:4
                    text = "Tight: the same lines, hugging the longest one"
                <Box • flex-row mb:10
                    <Box • bubble flex-col px:12 py:8
                        <Text • bubble-text tight
                            "Did the "
                            <Span "styled layout" • strong
                            " land? The wrapped lines leave a ragged gap on the right."
                <Box • flex-row
                    <Box • flex:1
                    <Box • bubble-mine flex-col px:12 py:8
                        <Text • bubble-text tight
                            "It did, and "
                            <Span "tight" • em
                            " sizing works with "
                            <Span "code()" • code
                            " chips too."

            <GalleryCard "INLINE BOXES"
                <Text • body
                    "Icons "
                    <LucideStar • w:16 h:16
                        stroke = "#f59e0b"
                    " "
                    <LucideHeart • w:16 h:16
                        stroke = "#e11d48"
                    " "
                    <LucideSparkles • w:16 h:16
                        stroke = "#7c3aed"
                    " sit in the text, as do swatches "
                    <Box • swatch w:12 h:12 bg:"#22c55e"
                    " "
                    <Box • swatch w:12 h:12 bg:"#3b82f6"
                    " "
                    <Box • swatch w:12 h:12 bg:"#f97316"
                    ", real controls like "
                    <Button "Like" • inline-button w:44 h:20
                        action = => do likes += 1
                    " (liked "
                    <Span • strong
                        text = "${#likes} times"
                    "), and a text field "
                    <TextInput • inline-input w:120 h:22
                        placeholder = "type here"
                    " that wraps along with the words around it."

        <Box • flex-col flex:1
            <GalleryCard "LINKS"
                <Text • body
                    "Read the "
                    <GalleryLink "layout guide" • link
                        target = "layout guide"
                    ", browse "
                    <GalleryLink "the full reference documentation for text spans" • link
                        target = "reference"
                    ", or open a "
                    <GalleryLink "dotted link" • soft-link
                        target = "dotted link"
                    " "
                    <LucideLink • w:14 h:14
                        stroke = "#5eead4"
                    ". Words like "
                    <GalleryLink "this" • hover-chip
                        target = "hover chip"
                    " can light up as chips."

            <GalleryCard "SCRIPT SENTENCES"
                <Box • script-panel flex-col px:14 py:4
                    <Text • script-row py:10
                        "Draw ellipse with radius "
                        <ScriptNumber = 7.5
                            step = 0.5
                        " wide and "
                        <ScriptNumber = 7.5
                            step = 0.5
                        " high at x= "
                        <ScriptNumber = -181.5
                        " and y= "
                        <ScriptNumber = -67.25
                        " as "
                        <ScriptDefinition "Control Ball"
                        "."
                    <Text • script-row py:10
                        "Draw star with "
                        <ScriptNumber = 5
                        " points, radius of "
                        <ScriptNumber = 0.5
                            step = 0.05
                        ", and size "
                        <ScriptNumber = 128
                        " wide and "
                        <ScriptNumber = 128
                        " high at x= "
                        <ScriptNumber = -114
                        " and y= "
                        <ScriptNumber = -86.25
                        " as "
                        <ScriptDefinition "Control Star"
                        "."
                    <Text • script-row py:10
                        "Scale "
                        <ScriptChoice "center"
                        " of "
                        <ScriptReference "Control Star"
                        " by "
                        <ScriptNumber = -74.22
                            suffix = "%"
                        " wide and "
                        <ScriptNumber = -74.22
                            suffix = "%"
                        " high."
                    <Text • script-row py:10
                        "Scale "
                        <ScriptChoice "center"
                        " of "
                        <ScriptReference "Control Ball"
                        " by "
                        <ScriptNumber = -16.67
                            suffix = "%"
                        " wide and "
                        <ScriptNumber = -16.67
                            suffix = "%"
                        " high."
                    <Text • script-row py:10
                        "Duplicate "
                        <ScriptReference "Control Star"
                        " into "
                        <ScriptChoice "scene"
                            options = ["scene", "Guides", "Background"]
                        " as "
                        <ScriptDefinition "Star"
                        "."
                    <Text • script-row py:10
                        "Move "
                        <ScriptReference "Star"
                        " by "
                        <ScriptNumber = 213
                        " wide and "
                        <ScriptNumber = 18
                        " high."
                    <Text • script-row last-row py:10
                        "Make "
                        <ScriptReference "Star"
                        " a guide."

            <GalleryCard "LIVE REFLOW"
                <Text • body mb:10
                    "The frame below is "
                    <Span • strong
                        text = "${round(#reflow-width)} pt"
                    " wide and "
                    <Span • strong
                        text = gallery-alignment-name(#reflow-alignment)
                    " aligned. The counter reads "
                    <Span • code
                        text = "${#counter}"
                    ". "
                    <Button "+1" • inline-button w:30 h:20
                        action = => do counter += 1
                    " "
                    <Button "Align" • inline-button w:48 h:20
                        action = => do cycle-reflow-alignment()
                <Box • reflow-frame flex-col p:10 w:(#reflow-width)
                    <Text • body
                        text-alignment = #reflow-alignment
                        "Every "
                        <Span "span" • strong
                        " keeps its "
                        <Span "style" • em
                        " while the paragraph re-wraps. Counter "
                        <Span • tag
                            text = "${#counter}"
                        " Long words like "
                        <Span "supercalifragilisticexpialidocious" • marker
                        " break by cluster only when they must."

            <GalleryCard "WRAPPING, SCRIPTS, OVERFLOW"
                <Text • body mb:10
                    "Hard breaks\nstart new lines.\nMixed scripts: "
                    <Span "日本語のテキスト" • strong
                    ", e\u0301 · 👩🏽‍💻 · ✨, and a URL "
                    <Span "https://example.com/a/very/long/path/that/cannot/break/at/spaces" • link
                    "."
                <Text • body
                    text-wrap = TextWrap.no-wrap
                    text-overflow = TextOverflow.truncate-tail
                    "No-wrap with tail truncation: "
                    <Span "styled" • strong
                    " text keeps its colors "
                    <Span "right up to" • link
                    " the ellipsis at the edge of the box."

    <KeyShortcut "Cancel number edit"
        key = .escape
        repeat = false
        discoverable = false
        allow-while-input = true
        action = => do cancel-script-edits()

────────────────────
whenever #linked-name

sync-linked-spans(this, linked-name)

────────────────────
+ do report
    - message String

status = message

────────────────────
_ do cycle-reflow-alignment

reflow-alignment = match reflow-alignment
    | .left
        TextAlignment.center
    | .center
        TextAlignment.right
    | .right
        TextAlignment.left

────────────────────
+ do cancel-script-edits

cancel-script-number-edits(this)

━━━━━━━━━━━━━━━━━━━━
+ do sync-linked-spans
    - node GuiNode
    - name String

for child in node.children
    if child is ScriptName
        . script-name = child as ScriptName
        script-name.is-linked = name.length > 0 && script-name.text == name
    sync-linked-spans(child, name)

━━━━━━━━━━━━━━━━━━━━
+ do cancel-script-number-edits
    - node GuiNode

for child in node.children
    if child is ScriptNumber
        (child as ScriptNumber).is-editing = false
    cancel-script-number-edits(child)

━━━━━━━━━━━━━━━━━━━━
+ script-anchor-names [String]

* "center"
* "top-left"
* "top"
* "top-right"
* "left"
* "right"
* "bottom-left"
* "bottom"
* "bottom-right"

━━━━━━━━━━━━━━━━━━━━
+ gallery-alignment-name
    - alignment TextAlignment

match alignment
    | .left
        "left"
    | .center
        "center"
    | .right
        "right"

━━━━━━━━━━━━━━━━━━━━
+ gallery-number-text
    - value F64

"$sign$whole$decimals"

.. hundredths = round(abs(value) * 100) as Int
.. fraction = hundredths % 100
.. whole = (hundredths - fraction) / 100
.. sign = if value < 0 && hundredths > 0 then "-" else ""
.. decimals = gallery-fraction-text(fraction)

━━━━━━━━━━━━━━━━━━━━
+ gallery-fraction-text
    - fraction Int

|? fraction == 0
    ""
|? fraction % 10 == 0
    ".${fraction / 10}"
|? fraction < 10
    ".0$fraction"
??
    ".$fraction"

