"${node.id}"

━━━━━━━━━━━━━━━━━━━━
_ lazy-has-children Bool
    - id String

lazy-depth(id) < 6

━━━━━━━━━━━━━━━━━━━━
_ lazy-key String
    - id String

id

━━━━━━━━━━━━━━━━━━━━
_ do lazy-depth Size
    - id String

=? 0 if !id.length
. depth Size = 1
for char in id
    if char == '/'
        depth += 1
= depth

━━━━━━━━━━━━━━━━━━━━
_ lazy-title String
    - id String

"Node ${".".join(id.split("/"))}"

