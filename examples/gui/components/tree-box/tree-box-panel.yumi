━━━━━━━━━━━━━━━━━━━━
+ TreeBoxPanel is Box
    using TreeBoxTheme

+ explorer-root = explorer-fixture()
+ explorer-activated = "Nothing opened yet"
+ outline = OutlineModel()
+ outline-reloads = 0
+ lazy-loads = 0

────────────────────

<This • flex-row p:16
    <Box • showcase-panel flex-col flex:1 p:12
        <Label • panel-title h:22
            text = "Project explorer"
        <Label • panel-note h:34
            text = "Arrows move · → opens · ← closes or climbs · Enter or double-click opens a file"
            text-wrap = TextWrap.word

        <TreeBox'ExplorerNode explorer • showcase-tree flex:1 mt:6
            root-node = explorer-root
            load-children = explorer-children
            key-builder = explorer-key

            <ExplorerRow (row) - row
                item = row.#item!

        <Label • panel-status h:20 mt:6
            text = "Selected: ${#explorer.#selected-item?.path ?? "none"}"
        <Label • panel-status h:20
            text = "Opened: ${#explorer-activated}"
        <Box • flex-row h:28 mt:6
            <Button "Expand all" • showcase-action flex:1 mr:6
                action = => do explorer.expand-all()
            <Button "Collapse all" • showcase-action flex:1 mr:6
                action = => do explorer.collapse-all()
            <Button "Reveal chevron" • showcase-action flex:1
                action = => do reveal-chevron()

    <Box • showcase-panel flex-col flex:1 p:12 mx:12
        <Label • panel-title h:22
            text = "Live outline"
        <Label • panel-note h:34
            text = "Click · ⌘-click toggles · ⇧-click selects a range · edits call reload() and keep expansion"
            text-wrap = TextWrap.word

        <TreeBox'OutlineNode outline-tree • showcase-tree flex:1 mt:6
            root-node = outline.root
            load-children = outline-children
            key-builder = outline-key
            selection-mode = SelectionMode.multiple

            <OutlineRow (row) - row
                item = row.#item!

        <Label • panel-status h:20 mt:6
            text = "Selected: ${#outline-tree.#selected-keys.length} · rows: ${#outline-tree.#entries.length} · reloads: ${#outline-reloads}"
        <Box • flex-row h:28 mt:6
            <Button "Add shape" • showcase-action flex:1 mr:6
                action = => do add-outline-node(false)
            <Button "Add group" • showcase-action flex:1 mr:6
                action = => do add-outline-node(true)
            <Button "Rename" • showcase-action flex:1
                action = => do rename-outline-node()
        <Box • flex-row h:28 mt:6
            <Button "Move up" • showcase-action flex:1 mr:6
                action = => do move-outline-node-up()
            <Button "Delete selected" • showcase-action flex:1
                action = => do delete-outline-node()

    <Box • showcase-panel flex-col flex:1 p:12
        <Label • panel-title h:22
            text = "Lazy stress tree"
        <Label • panel-note h:34
            text = "Twelve children per folder, six levels deep; folders load only when opened"
            text-wrap = TextWrap.word

        <TreeBox'String lazy-tree • showcase-tree flex:1 mt:6
            root-node = ""
            load-children = :: id => load-lazy-children(id)
            item-has-children = lazy-has-children
            key-builder = lazy-key

            <LazyRow (row) - row
                item = row.#item!

        <Label • panel-status h:20 mt:6
            text = "Folders loaded: ${#lazy-loads} · visible rows: ${#lazy-tree.#entries.length}"
        <Box • flex-row h:28 mt:6
            <Button "Expand 2 levels" • showcase-action flex:1 mr:6
                action = => do lazy-tree.expand-all(2)
            <Button "Expand 3 levels" • showcase-action flex:1 mr:6
                action = => do lazy-tree.expand-all(3)
            <Button "Collapse all" • showcase-action flex:1
                action = => do lazy-tree.collapse-all()

────────────────────
for event on explorer.item-activated

explorer-activated = explorer.selected-item?.name ?? "Nothing opened yet"

────────────────────
_ do reveal-chevron

. ignored = explorer.reveal-key-path
    - explorer-key-path
        - "stdlib"
        - "stdlib/gui"
        - "stdlib/gui/icons"
        - "stdlib/gui/icons/lucide"
        - "stdlib/gui/icons/lucide/chevron-right.yumi"
explorer.request-focus()

────────────────────
_ do add-outline-node
    - is-group Bool

. node = outline.add(outline-insertion-group(), is-group)
reload-outline()
. ignored = outline-tree.reveal-key-path(outline.key-path(node))
outline-tree.select-key(outline-key(node))
outline-tree.request-focus()

────────────────────
_ do rename-outline-node

. node = outline-tree.selected-item
=? if !node
node.name = outline.next-name(node.is-group)
reload-outline()

────────────────────
_ do move-outline-node-up

. node = outline-tree.selected-item
=? if !node
outline.move-up(node)
reload-outline()

────────────────────
_ do delete-outline-node

. doomed = outline-tree.selected-items
=? if !doomed
for node in doomed
    outline.remove(node)
reload-outline()
outline-tree.select-key(outline-tree.selected-entry?.key)
outline-tree.request-focus()

────────────────────
_ do reload-outline

outline-tree.reload()
outline-reloads += 1

────────────────────
_ outline-insertion-group OutlineNode

|? !node
    outline.root
|? node.is-group
    node
??
    node.parent ?? outline.root

.. node = outline-tree.selected-item

────────────────────
_ do load-lazy-children [String]?
    - id String

lazy-loads += 1
. result [String]
. index = 0
while index < 12
    result += if id.length then "$id/$index" else "$index"
    index += 1
= result

