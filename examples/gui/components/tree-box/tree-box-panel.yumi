_ file ExplorerNode
    - path String

ExplorerNode(path, explorer-leaf-name(path))

━━━━━━━━━━━━━━━━━━━━
_ folder ExplorerNode
    - path String
    ... children [ExplorerNode]

ExplorerNode(path, explorer-leaf-name(path), children)

━━━━━━━━━━━━━━━━━━━━
_ explorer-leaf-name String
    - path String

if slash == null then path else path[(slash as Index) + 1 .. < path.length]

.. slash = path.find-reverse("/")

