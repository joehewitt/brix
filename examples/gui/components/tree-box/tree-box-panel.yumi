────────────────────
+ This
    - id
    - name
    - is-group
    - parent OutlineNode? = null

━━━━━━━━━━━━━━━━━━━━
+ OutlineModel

+ root OutlineNode

_ next-id Size = 1
_ shape-count Size = 0
_ group-count Size = 0

────────────────────
+ This

.. root = OutlineNode(0, "Document", true)
. background = add(root, true, "Background")
. ignored-sky = add(background, false, "Sky")
. ignored-hills = add(background, false, "Hills")
. figure = add(root, true, "Figure")
. head = add(figure, true, "Head")
. ignored-eyes = add(head, false, "Eyes")
. ignored-smile = add(head, false, "Smile")
. ignored-body = add(figure, false, "Body")
. ignored-signature = add(root, false, "Signature")

────────────────────
+ do add OutlineNode
    - parent OutlineNode
    - is-group Bool
    - name String? = null

. node = OutlineNode(next-id, name ?? next-name(is-group), is-group, parent)
next-id += 1
parent.children += node
= node

────────────────────
+ do next-name String
    - is-group Bool

if is-group
    group-count += 1
    = "Group $group-count"
shape-count += 1
= "Shape $shape-count"

────────────────────
+ do remove
    - node OutlineNode

. parent = node.parent
=? if !parent
. index = index-in-parent(node)
if index != null
    parent.children.remove(index)

────────────────────
+ do move-up
    - node OutlineNode

. parent = node.parent
=? if !parent
. index = index-in-parent(node)
=? if index == null || index == 0
. siblings = parent.children
. previous = siblings[index - 1]
siblings[index - 1] = node
siblings[index] = previous

────────────────────
+ do key-path [String]
    - node OutlineNode

. reversed [String]
. current OutlineNode? = node
while current && current.parent
    reversed += outline-key(current)
    current = current.parent
. result [String]
. index = reversed.length
while index > 0
    index -= 1
    result += reversed[index]
= result

────────────────────
_ do index-in-parent Index?
    - node OutlineNode

. parent = node.parent
=? if !parent
. index Index = 0
for child in parent.children
    =? index if child.id == node.id
    index += 1

