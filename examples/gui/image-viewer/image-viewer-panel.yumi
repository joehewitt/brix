────────────────────
+ do mounted

super.mounted()
. target = start
if target
    . node = files.find(target)
    if node
        session.revealed <- node

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

load-serial += 1
image?.release()
image = null
super.close()
thumbnails.close()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do toggle-pixelated

is-pixelated = !is-pixelated

────────────────────
_ do toggle-grid

shows-grid = !shows-grid

────────────────────
_ do zoom-thumbnails
    - event ValueChange'F64

if event.phase == ValueChangePhase.began
    thumbnails-view.begin-zoom()
thumbnails-view.zoom-to(exp(event.value * log(2)))
if event.phase == ValueChangePhase.ended
    thumbnails-view.end-zoom()

────────────────────
_ do zoom-step
    - is-in Bool

. exponent = log(viewer.effective-zoom) / log(2)
. step = if is-in then floor(exponent + 0.001) + 1 else ceil(exponent - 0.001) - 1
viewer.zoom-to(exp(step * log(2)))

────────────────────
_ do show
    - node FileNode?

=? if !node
if node.is-directory
    use-folder(node)
    is-grid = true
    status = image-viewer-folder-status(thumbnails-view.paths.length)
    =
. path = node.path
=? if !image-viewer-shows(path.ext)
. parent = node.parent
if parent
    use-folder(parent)
thumbnails-view.selected = path
is-grid = false
=? if image-path == path
image-path = path
load-serial += 1
do new load(path, load-serial)

────────────────────
_ do use-folder
    - node FileNode

=? if folder as Pointer? == node as Pointer
folder = node
folder-name = node.name
thumbnails-view.paths = image-viewer-paths(files, node)
thumbnails-view.scroll-to-top()

────────────────────
_ do refresh-folder
    - changed [FileNode]

. current = folder
=? if !current
for node in changed
    if node as Pointer == current as Pointer
        thumbnails-view.paths = image-viewer-paths(files, current)
        =

────────────────────
_ do open-path
    - path Path

. node = files.find(path)
=? if !node
show(node)
session.revealed <- node

────────────────────
_ do show-grid

=? if is-grid
. node = folder
=? if !node
is-grid = true
status = image-viewer-folder-status(thumbnails-view.paths.length)
session.revealed <- node
. ignored = thumbnails-view.request-focus()

────────────────────
_ do load
    - path Path
    - serial Size

status = "Loading ${path.name}"
. loaded = catch? load-image(path)
if serial != load-serial
    loaded?.release()
    =
if !loaded
    status = "${path.name} could not be opened"
    =
. previous = image
image = loaded
previous?.release()
viewer.fit()
status = image-viewer-status(path, loaded)

━━━━━━━━━━━━━━━━━━━━
_ do viewer-checkerboard-image Image

. canvas = RasterCanvas(16, 16, 2)
fill-checkerboard(canvas, Rect(0, 0, 16, 16), 8, RGBA("#52525b"), RGBA("#3f3f46"))
= Image(canvas, 2)

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-shows Bool
    - ext String

|? name == "png" || name == "jpg" || name == "jpeg" || name == "gif" || name == "heic"
    true
??
    name == "webp" || name == "tif" || name == "tiff" || name == "bmp"

.. name = ext.lowercased

━━━━━━━━━━━━━━━━━━━━
_ do image-viewer-paths [Path]
    - files FileTree
    - node FileNode

. found = List'Path()
. children = files.children-of(node)
=? found if !children
for child in children
    if !child.is-directory
        . path = child.path
        if image-viewer-shows(path.ext)
            found += path
= found

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-octave F64
    - length Length

log(length) / log(2)

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-folder-status String
    - count Size

if count == 1 then "1 image" else "$count images"

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-zoom-label String
    - event ImageZoomEvent

if event.is-fit then "Fit" else "${round(event.zoom * 100)}%"

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-status String
    - path Path
    - image Image

"${path.name} · ${image.pixel-width} × ${image.pixel-height} px$density"

.. density = if image.scale != 1 then " @${image.scale}x" else ""
