━━━━━━━━━━━━━━━━━━━━
+ ImageViewerPanel is Box
    using ImageViewerTheme

+ files FileTree
+ start Path?
+ session := FileSession()
+ image Image?
+ is-pixelated = false
+ shows-grid = true
+ is-checkered = false
+ is-fitted = true
+ zoom-label = "Fit"
+ status = "Choose an image"
+ selected = session.#current
+ is-grid = true
+ folder FileNode?
+ folder-name = ""
+ thumbnail-length Length = 160
+ thumbnails := ThumbnailCache()

_ load-serial Size
_ image-path Path?

────────────────────

<This • flex-row
    <KeyShortcut "Zoom to Fit"
        key = KeyCombo("Cmd+9")
        stable-key = "viewer.fit"
        repeat = false
        action = => do viewer.fit()
    <KeyShortcut "Actual Size"
        key = KeyCombo("Cmd+0")
        stable-key = "viewer.actual-size"
        repeat = false
        action = => do viewer.zoom-to(1)
    <KeyShortcut "Zoom In"
        key = KeyCombo("Cmd+=")
        stable-key = "viewer.zoom-in"
        action = => do zoom-step(true)
    <KeyShortcut "Zoom Out"
        key = KeyCombo("Cmd+-")
        stable-key = "viewer.zoom-out"
        action = => do zoom-step(false)
    <KeyShortcut "Pixelated"
        key = KeyCombo("Cmd+P")
        stable-key = "viewer.pixelated"
        repeat = false
        action = => do toggle-pixelated()
    <KeyShortcut "Pixel Grid"
        key = KeyCombo("Cmd+'")
        stable-key = "viewer.pixel-grid"
        repeat = false
        action = => do toggle-grid()
    <KeyShortcut "Back to Grid"
        key = .escape
        stable-key = "viewer.back-to-grid"
        repeat = false
        action = => do show-grid()

    <Sidebar • w:260
        <SidebarSection • flex:1 pt:10 pb:0
            title = files.root.path.name

            <FileTreeBox • flex:1
                files = files
                session = session

    <Box • flex-col flex:1
        <Box • viewer-toolbar viewer-grid-only
            <Label • flex:1
                text = #folder-name
            <Slider • w:180
                minimum = image-viewer-octave(64)
                maximum = image-viewer-octave(512)
                value = image-viewer-octave(#thumbnail-length)
                for event on value-changed
                    zoom-thumbnails(event)

        <Box • viewer-toolbar viewer-image-only
            <Button "Grid" • mr:16
                action = => do show-grid()
            <Button "Fit" • mr:8
                is-on = #is-fitted
                action = => do viewer.fit()
            <Button "Actual Size" • mr:8
                action = => do viewer.zoom-to(1)
            <Button "−" • mr:4
                action = => do zoom-step(false)
            <Button "+" • mr:16
                action = => do zoom-step(true)
            <Switch "Pixelated" • mr:16
                is-on = #is-pixelated
                for event on value-changed
                    is-pixelated = event.value
            <Switch "Grid" • mr:16
                is-on = #shows-grid
                for event on value-changed
                    shows-grid = event.value
            <Switch "Checkerboard"
                is-on = #is-checkered
                for event on value-changed
                    is-checkered = event.value

        <ThumbnailGrid thumbnails-view • viewer-stage viewer-grid-only flex:1
            cache = thumbnails
            cell-length = thumbnail-length
            for event on chosen
                status = event.name
            for event on opened
                open-path(event)
            for event on zoomed
                thumbnail-length = event

        <ViewerImage viewer • viewer-stage viewer-image-only flex:1
            image = #image
            is-pixelated = #is-pixelated
            hides-grid = !#shows-grid
            is-checkered = #is-checkered
            for event on zoomed
                is-fitted = event.is-fit
                zoom-label = image-viewer-zoom-label(event)

        <Box • viewer-status
            <Label • flex:1
                text = #status
            <Label • viewer-image-only
                text = #zoom-label

