./image-viewer-panel
/gui
/gui/file-browsing
/os/cli
/os/env
/os/path

. start = image-viewer-start(cmdline().args)
. files = use FileTree(image-viewer-root(start))

<App
    <Window • flex-col
        title = "Yumi GUI: Image Viewer"
        size = (1180, 780)
        use-wide-gamut = true

        <ImageViewerPanel • flex:1
            files = files
            start = start

━━━━━━━━━━━━━━━━━━━━
_ do image-viewer-start Path
    - args [String]

=? Path(args[0], 0).resolved if args.length > 0
. home = env-required("HOME")
    catch err Error
        ?! Panic("Could not locate the home directory: $err")
= Path("$home/Pictures", 0)

━━━━━━━━━━━━━━━━━━━━
_ image-viewer-root Path
    - start Path

|? start.is-dir
    start
??
    start.parent ?? start
