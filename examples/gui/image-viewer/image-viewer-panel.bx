(import /graphics/canvas)
(import /graphics/color)
(import /graphics/image)
(import /graphics/pattern)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/thumbnail-cache)
(import /gui)
(import /gui/file-browsing)
(import /math)
(import /os/path)
(blank)
(prop _ viewer-stage-color _ (= (call RGBA "#18181b")))
(prop _ viewer-checkerboard _ (:= (call viewer-checkerboard-image)))

(style ImageViewerTheme
  (using GUIDefaultTheme)
  (using GUIImageStyle)
  (rule viewer-toolbar (• flex-row) (• h 44) (• px 12) (• py 8)
    (= border-color gui-border-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule viewer-stage (• bg viewer-stage-color))
  (blank)
  (rule viewer-status (• flex-row) (• text gui-muted-text-color) (• h 28) (• px 12) (• pt 6)
    (= font-size 12)
  )
  (blank)
  (rule ImageViewerPanel
    (when-style #is-grid
      (rule viewer-image-only
        (= display (. Display hidden))
      )
    )
    (when-style (not #is-grid)
      (rule viewer-grid-only
        (= display (. Display hidden))
      )
    )
  )
)

(type + ViewerImage (is ImageZoomView)
  (prop + is-pixelated _ (= false))
  (prop + hides-grid _ (= false))
  (prop + is-checkered _ (= false))
  (blank)
  (rule This
    (= image-fit (. ImageFit scale-down))
    (= background-repeat (. ImageRepeat both))
    (= background-align-x (. AnchorPoint start))
    (= background-align-y (. AnchorPoint start))
    (blank)
    (when-style #is-pixelated
      (= image-sampling (. ImageSampling pixelated))
    )
    (blank)
    (when-style #hides-grid
      (= pixel-grid-ratio null)
    )
    (blank)
    (when-style #is-checkered
      (= background-image viewer-checkerboard)
    )
  )
)

(type + ImageViewerPanel (is Box)
  (using ImageViewerTheme)
  (prop + files FileTree)
  (prop + start (? Path))
  (prop + session _ (:= (call FileSession)))
  (prop + image (? Image))
  (prop + is-pixelated _ (= false))
  (prop + shows-grid _ (= true))
  (prop + is-checkered _ (= false))
  (prop + is-fitted _ (= true))
  (prop + zoom-label _ (= "Fit"))
  (prop + status _ (= "Choose an image"))
  (prop + selected _ (= (. session #current)))
  (prop + is-grid _ (= true))
  (prop + folder (? FileNode))
  (prop + folder-name _ (= ""))
  (prop + thumbnail-length Length (= 160))
  (prop + thumbnails _ (:= (call ThumbnailCache)))
  (blank)
  (prop _ load-serial Size)
  (prop _ image-path (? Path))
  (content
    (<> This (• flex-row)
      (<> KeyShortcut (text: "Zoom to Fit")
        (= key (call KeyCombo "Cmd+9"))
        (= stable-key "viewer.fit")
        (= repeat false)
        (= action (=> () :do (call (. viewer fit))))
      )
      (<> KeyShortcut (text: "Actual Size")
        (= key (call KeyCombo "Cmd+0"))
        (= stable-key "viewer.actual-size")
        (= repeat false)
        (= action (=> () :do (call (. viewer zoom-to) 1)))
      )
      (<> KeyShortcut (text: "Zoom In")
        (= key (call KeyCombo "Cmd+="))
        (= stable-key "viewer.zoom-in")
        (= action (=> () :do (call zoom-step true)))
      )
      (<> KeyShortcut (text: "Zoom Out")
        (= key (call KeyCombo "Cmd+-"))
        (= stable-key "viewer.zoom-out")
        (= action (=> () :do (call zoom-step false)))
      )
      (<> KeyShortcut (text: "Pixelated")
        (= key (call KeyCombo "Cmd+P"))
        (= stable-key "viewer.pixelated")
        (= repeat false)
        (= action (=> () :do (call toggle-pixelated)))
      )
      (<> KeyShortcut (text: "Pixel Grid")
        (= key (call KeyCombo "Cmd+'"))
        (= stable-key "viewer.pixel-grid")
        (= repeat false)
        (= action (=> () :do (call toggle-grid)))
      )
      (<> KeyShortcut (text: "Back to Grid")
        (= key .escape)
        (= stable-key "viewer.back-to-grid")
        (= repeat false)
        (= action (=> () :do (call show-grid)))
      )
      (blank)
      (<> Sidebar (• w 260)
        (<> SidebarSection (• flex 1) (• pt 10) (• pb 0)
          (= title (. files root path name))
          (blank)
          (<> FileTreeBox (• flex 1)
            (= files files)
            (= session session)
          )
        )
      )
      (blank)
      (<> Box (• flex-col) (• flex 1)
        (<> Box (• viewer-toolbar) (• viewer-grid-only)
          (<> Label (• flex 1)
            (= text #folder-name)
          )
          (<> Slider (• w 180)
            (= minimum (call image-viewer-octave 64))
            (= maximum (call image-viewer-octave 512))
            (= value (call image-viewer-octave #thumbnail-length))
            (for (on event value-changed)
              (call zoom-thumbnails event)
            )
          )
        )
        (blank)
        (<> Box (• viewer-toolbar) (• viewer-image-only)
          (<> Button (text: "Grid") (• mr 16)
            (= action (=> () :do (call show-grid)))
          )
          (<> Button (text: "Fit") (• mr 8)
            (= is-on #is-fitted)
            (= action (=> () :do (call (. viewer fit))))
          )
          (<> Button (text: "Actual Size") (• mr 8)
            (= action (=> () :do (call (. viewer zoom-to) 1)))
          )
          (<> Button (text: "−") (• mr 4)
            (= action (=> () :do (call zoom-step false)))
          )
          (<> Button (text: "+") (• mr 16)
            (= action (=> () :do (call zoom-step true)))
          )
          (<> Switch (text: "Pixelated") (• mr 16)
            (= is-on #is-pixelated)
            (for (on event value-changed)
              (= is-pixelated (. event value))
            )
          )
          (<> Switch (text: "Grid") (• mr 16)
            (= is-on #shows-grid)
            (for (on event value-changed)
              (= shows-grid (. event value))
            )
          )
          (<> Switch (text: "Checkerboard")
            (= is-on #is-checkered)
            (for (on event value-changed)
              (= is-checkered (. event value))
            )
          )
        )
        (blank)
        (<> ThumbnailGrid (id: thumbnails-view) (• viewer-stage) (• viewer-grid-only) (• flex 1)
          (= cache thumbnails)
          (= cell-length thumbnail-length)
          (for (on event chosen)
            (= status (. event name))
          )
          (for (on event opened)
            (call open-path event)
          )
          (for (on event zoomed)
            (= thumbnail-length event)
          )
        )
        (blank)
        (<> ViewerImage (id: viewer) (• viewer-stage) (• viewer-image-only) (• flex 1)
          (= image #image)
          (= is-pixelated #is-pixelated)
          (= hides-grid (not #shows-grid))
          (= is-checkered #is-checkered)
          (for (on event zoomed)
            (= is-fitted (. event is-fit))
            (= zoom-label (call image-viewer-zoom-label event))
          )
        )
        (blank)
        (<> Box (• viewer-status)
          (<> Label (• flex 1)
            (= text #status)
          )
          (<> Label (• viewer-image-only)
            (= text #zoom-label)
          )
        )
      )
    )
  )
  (whenever-rule #selected
    (call show selected)
  )
  (subscribe-for (on event (. files changed))
    (call refresh-folder event)
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is MarkupElement ╌╌╌╌╌╌╌╌╌╌
  (fn-do + mounted _
    (call (. super mounted))
    (let target start)
    (if target
      (let node (call (. files find) target))
      (if node
        (<- (. session revealed) node)
      )
    )
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + close _
    (+= load-serial 1)
    (call (?. image release))
    (= image null)
    (call (. super close))
    (call (. thumbnails close))
  )
  ; ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌
  (fn-do _ toggle-pixelated _
    (= is-pixelated (not is-pixelated))
  )
  (fn-do _ toggle-grid _
    (= shows-grid (not shows-grid))
  )
  (fn-do _ zoom-thumbnails _
    (param event (of ValueChange F64))
    (if (== (. event phase) (. ValueChangePhase began))
      (call (. thumbnails-view begin-zoom))
    )
    (call (. thumbnails-view zoom-to) (call exp (* (. event value) (call log 2))))
    (if (== (. event phase) (. ValueChangePhase ended))
      (call (. thumbnails-view end-zoom))
    )
  )
  (fn-do _ zoom-step _
    (param is-in Bool)
    (let exponent (/ (call log (. viewer effective-zoom)) (call log 2)))
    (let step (if-expr is-in (+ (call floor (+ exponent 0.001)) 1) (- (call ceil (- exponent 0.001)) 1)))
    (call (. viewer zoom-to) (call exp (* step (call log 2))))
  )
  (fn-do _ show _
    (param node (? FileNode))
    (return-if (if (not node)))
    (if (. node is-directory)
      (call use-folder node)
      (= is-grid true)
      (= status (call image-viewer-folder-status (. thumbnails-view paths length)))
      (return)
    )
    (let path (. node path))
    (return-if (if (not (call image-viewer-shows (. path ext)))))
    (let parent (. node parent))
    (if parent
      (call use-folder parent)
    )
    (= (. thumbnails-view selected) path)
    (= is-grid false)
    (return-if (if (== image-path path)))
    (= image-path path)
    (+= load-serial 1)
    (do-new
      (inline (call load path load-serial))
    )
  )
  (fn-do _ use-folder _
    (param node FileNode)
    (return-if (if (== (as folder (? Pointer)) (as node Pointer))))
    (= folder node)
    (= folder-name (. node name))
    (= (. thumbnails-view paths) (call image-viewer-paths files node))
    (call (. thumbnails-view scroll-to-top))
  )
  (fn-do _ refresh-folder _
    (param changed (list FileNode))
    (let current folder)
    (return-if (if (not current)))
    (for (in node changed)
      (if (== (as node Pointer) (as current Pointer))
        (= (. thumbnails-view paths) (call image-viewer-paths files current))
        (return)
      )
    )
  )
  (fn-do _ open-path _
    (param path Path)
    (let node (call (. files find) path))
    (return-if (if (not node)))
    (call show node)
    (<- (. session revealed) node)
  )
  (fn-do _ show-grid _
    (return-if (if is-grid))
    (let node folder)
    (return-if (if (not node)))
    (= is-grid true)
    (= status (call image-viewer-folder-status (. thumbnails-view paths length)))
    (<- (. session revealed) node)
    (let ignored (call (. thumbnails-view request-focus)))
  )
  (fn-do _ load _
    (param path Path)
    (param serial Size)
    (= status (str "Loading " (. path name)))
    (let loaded (catch? (call load-image path)))
    (if (!= serial load-serial)
      (call (?. loaded release))
      (return)
    )
    (if (not loaded)
      (= status (str (. path name) " could not be opened"))
      (return)
    )
    (let previous image)
    (= image loaded)
    (call (?. previous release))
    (call (. viewer fit))
    (= status (call image-viewer-status path loaded))
  )
)

(fn-do _ viewer-checkerboard-image Image
  (let canvas (call RasterCanvas 16 16 2))
  (call fill-checkerboard canvas (call Rect 0 0 16 16) 8 (call RGBA "#52525b") (call RGBA "#3f3f46"))
  (return (call Image canvas 2))
)

(fn-expr _ image-viewer-shows Bool
  (param ext String)
  (case? (or (== name "png") (== name "jpg") (== name "jpeg") (== name "gif") (== name "heic"))
    true
  )
  (default
    (or (== name "webp") (== name "tif") (== name "tiff") (== name "bmp"))
  )
  (where
    (lazy name (. ext lowercased))
  )
)

(fn-do _ image-viewer-paths (list Path)
  (param files FileTree)
  (param node FileNode)
  (let found (call (of List Path)))
  (let children (call (. files children-of) node))
  (return-if found (if (not children)))
  (for (in child children)
    (if (not (. child is-directory))
      (let path (. child path))
      (if (call image-viewer-shows (. path ext))
        (+= found path)
      )
    )
  )
  (return found)
)

(fn-expr _ image-viewer-octave F64
  (param length Length)
  (/ (call log length) (call log 2))
)

(fn-expr _ image-viewer-folder-status String
  (param count Size)
  (if-expr (== count 1) "1 image" (str count " images"))
)

(fn-expr _ image-viewer-zoom-label String
  (param event ImageZoomEvent)
  (if-expr (. event is-fit) "Fit" (str (call round (* (. event zoom) 100)) "%"))
)

(fn-expr _ image-viewer-status String
  (param path Path)
  (param image Image)
  (str (. path name) " · " (. image pixel-width) " × " (. image pixel-height) " px" density)
  (where
    (lazy density (if-expr (!= (. image scale) 1) (str " @" (. image scale) "x") ""))
  )
)
