_ chat-demo-title-pad Length = 16

━━━━━━━━━━━━━━━━━━━━
+ ChatWindow is Window

+ store AIChatStore
+ images AIImageStore?
+ caches := ChatBlockCaches()
+ branchings := ChatBranchings()
+ active-branching = branchings.branching(#store.#active)
+ can-stop = #is-main-working || (#active-branching.#focus?.#is-busy ?? false)
+ is-main-working = chat-is-working
    - #active-branching.#main
    - #active-branching.#main.#is-busy
    - #active-branching.#main.tool-tasks.#revision
+ has-side-chat = #active-branching.#focus != null
+ chat-title = #store.#active.document.#title ?? "New chat"

• This
    • chat-demo-title-bar • flex-row h:40 items-center pr:chat-demo-title-pad
        border-color = gui-divider-color
        border-bottom-width = 1
        window-draggable = true

    • chat-demo-title • text:gui-muted-text-color
        text-wrap = TextWrap.no-wrap
        window-draggable = true

────────────────────

<This • flex-row
    title = "Chat"
    titlebar-visible = false
    stoplight-offset = window-stoplight-offset
    size = Dimensions(1080, 760)

    <MenuBar
        <MenuBarItem "File"
            <Menu
                <MenuItem
                    command = new-chat-shortcut
                <MenuSeparator
                <MenuItem
                    command = close-side-chat-shortcut
                <MenuItem
                    role = MenuRole.close-window
        <MenuBarItem "Edit"
            <Menu
                <MenuItem
                    role = MenuRole.undo
                <MenuItem
                    role = MenuRole.redo
                <MenuSeparator
                <MenuItem
                    role = MenuRole.cut
                <MenuItem
                    role = MenuRole.copy
                <MenuItem
                    role = MenuRole.paste
                <MenuItem
                    role = MenuRole.select-all
        <MenuBarItem "View"
            <Menu
                <MenuItem
                    command = sidebar-shortcut
                <MenuSeparator
                <MenuItem
                    role = MenuRole.toggle-full-screen
        <MenuBarItem "Chat"
            <Menu
                <MenuItem
                    command = stop-shortcut
        <MenuBarItem "Window"
            <Menu
                <MenuItem
                    role = MenuRole.minimize
                <MenuItem
                    role = MenuRole.zoom
                <MenuSeparator
                <MenuItem
                    role = MenuRole.bring-all-to-front
    <KeyShortcut new-chat-shortcut "New Chat"
        key = KeyCombo("Cmd+N")
        action = => do store.new-session()
    <KeyShortcut close-side-chat-shortcut "Close Side Chat"
        key = KeyCombo("Cmd+Shift+W")
        enabled = #has-side-chat
        action = => do active-branching.close()
    <KeyShortcut sidebar-shortcut "Toggle Sidebar"
        key = KeyCombo("Ctrl+Cmd+S")
        action = => do sidebar.toggle()
    <KeyShortcut stop-shortcut "Stop Response"
        key = KeyCombo("Cmd+.")
        enabled = #can-stop
        action = => do stop-replies()
    <ChatSidebar sidebar • w:260
        store = #store
        branching = #active-branching
        <Box (header) • h:40
            window-draggable = true
    <Box • flex-col flex:1
        <Box • chat-demo-title-bar
            padding-left = chat-demo-title-inset(sidebar.#is-collapsed, #is-full-screen)
            <Label • chat-demo-title flex:1
                text = #chat-title
        for session in [#store.#active] keyed by session.id
            <ChatWorkspace • flex:1
                branching = branchings.branching(session)
                services = #store.#services
                caches = caches
                images = images
                wording = chat-demo-wording()
                branch-modifiers = chat-demo-branch-modifiers()
    <IconButton • icon-panel-left absolute w:28 h:28
        left = PositionOffset.coord
            - if #is-full-screen then window-full-screen-inset else window-stoplight-inset
        top = PositionOffset.coord(8)
        action = => do sidebar.toggle()
        <Tooltip
            text = if sidebar.#is-collapsed then "Show Sidebar" else "Hide Sidebar"

────────────────────
for node on sidebar.chosen

store.select(node.session)
if store.active == node.session
    branchings.branching(node.session).open(node.branch-id)

────────────────────
_ do stop-replies

. branching = active-branching
. side = branching.focus
if side && side.is-busy
    branching.request-stop(side)
else
    branching.request-stop(branching.main)

━━━━━━━━━━━━━━━━━━━━
_ chat-demo-title-inset Length
    - is-collapsed Bool
    - is-full-screen Bool

|? !is-collapsed
    chat-demo-title-pad
|? is-full-screen
    window-full-screen-sidebar-toggle-inset
??
    window-sidebar-toggle-inset

━━━━━━━━━━━━━━━━━━━━
_ chat-demo-wording

ChatWording()
    • greeting "What can I help with?"
    • branch-placeholder "Ask on the side"

━━━━━━━━━━━━━━━━━━━━
_ chat-demo-branch-modifiers

PointerModifiers()
    • command true
    • shift true
