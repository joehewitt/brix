(import ./chat-window)
(import ./provider)
(import /gui)
(import /lang/product/mac-app)
(blank)

(main
  (<> MacApp (id: product)
    (= id "com.brix-lang.chat")
    (= name "Chat")
  )
  (blank)
  (let images (call chat-images))
  (<> App
    (<> ChatWindow
      (= store (call chat-store images))
      (= images images)
    )
  )
)
