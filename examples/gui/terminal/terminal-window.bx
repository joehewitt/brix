(import ./terminal-tab)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/desktop)
(import /gui/icons/lucide/plus)
(import /gui/terminal-view)
(import /math)
(import /net/url)
(import /os/env)
(import /os/terminal)

(type + TerminalWindow (is Window)
  (prop + directory String)
  (prop + tabs _ (= (call (of List TerminalTab))))
  (prop + active (? TerminalTab))
  (prop + shown _
    (=
      (call (of List TerminalTab)
        (block
          (bullet? #active)
        )
      )
    )
  )
  (prop + next-id _ (= 1))
  (prop + has-tab-bar _ (= (> (. #tabs length) 1)))
  (event + window-requested String)
  (blank)
  (rule This
    (rule title-strip (• flex-row) (• h gui-tab-bar-height) (• items-center) (• justify-center) (• bg gui-terminal-background-color)
      (= window-draggable true)
    )
    (rule title-text (• text gui-terminal-bright-black-color) (• shrink 1)
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-tail))
      (= window-draggable true)
    )
    (rule title-tabs (• bg gui-terminal-background-color)
      (= border-bottom-width 0)
    )
  )
  (fn-do + This _
    (param directory _)
    (call add-tab directory)
  )
  (content
    (<> This (• flex-col)
      (= title (?? (?. #active #title) "Terminal"))
      (= titlebar-visible false)
      (= stoplight-offset gui-tab-bar-stoplight-offset)
      (= size (call Dimensions 760 480))
      (blank)
      (<> MenuBar
        (<> MenuBarItem (text: "Shell")
          (<> Menu
            (<> MenuItem
              (= command new-window-shortcut)
            )
            (<> MenuItem
              (= command new-tab-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command close-tab-shortcut)
            )
            (<> MenuItem
              (= command close-window-shortcut)
            )
          )
        )
        (<> MenuBarItem (text: "Edit")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole copy))
            )
            (<> MenuItem
              (= role (. MenuRole paste))
            )
            (<> MenuItem
              (= role (. MenuRole select-all))
            )
          )
        )
        (<> MenuBarItem (text: "View")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole zoom-in))
            )
            (<> MenuItem
              (= role (. MenuRole zoom-out))
            )
            (<> MenuItem
              (= role (. MenuRole actual-size))
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= role (. MenuRole toggle-full-screen))
            )
          )
        )
        (<> MenuBarItem (text: "Window")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole minimize))
            )
            (<> MenuItem
              (= role (. MenuRole zoom))
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command previous-tab-shortcut)
            )
            (<> MenuItem
              (= command next-tab-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= role (. MenuRole bring-all-to-front))
            )
          )
        )
      )
      (<> KeyShortcut (id: new-window-shortcut) (text: "New Window")
        (= key (call KeyCombo "Cmd+N"))
        (= action (=> () :do (<- window-requested (call current-directory))))
      )
      (<> KeyShortcut (id: new-tab-shortcut) (text: "New Tab")
        (= key (call KeyCombo "Cmd+T"))
        (= action (=> () :do (call add-tab (call current-directory))))
      )
      (<> KeyShortcut (id: close-tab-shortcut) (text: "Close Tab")
        (= key (call KeyCombo "Cmd+W"))
        (= enabled (!= #active null))
        (= action (=> () :do (call close-tab (!! active))))
      )
      (<> KeyShortcut (id: close-window-shortcut) (text: "Close Window")
        (= key (call KeyCombo "Shift+Cmd+W"))
        (= action (=> () :do (call request-close)))
      )
      (<> KeyShortcut (id: previous-tab-shortcut) (text: "Show Previous Tab")
        (= key (call KeyCombo "Shift+Cmd+["))
        (= enabled (> (. #tabs length) 1))
        (= action (=> () :do (call step-tab -1)))
      )
      (<> KeyShortcut (id: next-tab-shortcut) (text: "Show Next Tab")
        (= key (call KeyCombo "Shift+Cmd+]"))
        (= enabled (> (. #tabs length) 1))
        (= action (=> () :do (call step-tab 1)))
      )
      (for (in number (.. 1 9))
        (<> KeyShortcut (text: (str "Show Tab " number))
          (= key (call KeyCombo (str "Cmd+" number)))
          (= discoverable false)
          (= enabled (<= number (. #tabs length)))
          (= action (=> () :do (call activate ([] tabs (- number 1)))))
        )
      )
      (blank)
      (<> Box (• title-strip)
        (= padding-left #stoplight-inset)
        (= padding-right #stoplight-inset)
        (<> Label (• title-text)
          (= text #title)
        )
      )
      (if #has-tab-bar
        (<> (of TabBar TerminalTab) (• title-tabs)
          (= is-reorderable true)
          (= keeps-focus true)
          (= selected #active)
          (for (on event selection-changed)
            (call activate (. event value))
          )
          (for (on move moved)
            (call move-tab (. move value) (. move index))
          )
          (<> TabStrip
            (for (in tab #tabs (keyed-by (. tab id)))
              (<> (of Tab TerminalTab)
                (= value tab)
                (= title (. tab #title))
                (= is-modified (. tab #has-rung))
                (for (on dismissed)
                  (call close-tab tab)
                )
              )
            )
            (<> IconButton (slot: trailing) (• icon-plus) (• w 24) (• h 24) (• ml 2)
              (= action (=> () :do (call add-tab (call current-directory))))
              (<> Tooltip (text: "New Tab (⌘T)"))
            )
          )
        )
      )
      (for (in tab #shown (keyed-by (. tab id)))
        (<> TerminalPane (• flex 1) (• p 6)
          (= session (. tab session))
          (= focus-default true)
          (for (on link path-opened)
            (call open-link link)
          )
        )
      )
    )
  )
  (subscribe (on closed)
    (for (in tab tabs)
      (call (. tab close))
    )
  )
  (fn-do + add-tab _
    (param directory String)
    (let tab (call TerminalTab next-id directory))
    (+= next-id 1)
    (+= tabs tab)
    (for (on (. tab session exited))
      (call close-tab tab)
    )
    (for (on (. tab session bell) (when (!= tab active)))
      (= (. tab has-rung) true)
    )
    (call (. tab start))
    (call activate tab)
  )
  (fn-do + close-tab _
    (param tab TerminalTab)
    (let index (?? (call (. tabs find) tab) 0))
    (call (. tab close))
    (= tabs (call (of List TerminalTab) (in each tabs (when (!= each tab)))))
    (if (== (. tabs length) 0)
      (call close)
      (return)
    )
    (if (== tab active)
      (call activate ([] tabs (call min index (- (. tabs length) 1))))
    )
  )
  (fn-do + move-tab _
    (param tab TerminalTab)
    (param index Index)
    (let others (call (of List TerminalTab) (in each tabs (when (!= each tab)))))
    (call (. others insert) tab (call min index (. others length)))
    (= tabs others)
  )
  (fn-do + activate _
    (param tab TerminalTab)
    (= (. tab has-rung) false)
    (= active tab)
  )
  (fn-do + step-tab _
    (param offset Int)
    (let index (?? (call (. tabs find) (!! active)) 0))
    (let count (. tabs length))
    (call activate ([] tabs (% (+ index offset count) count)))
  )
  (fn-do + current-directory String
    (let tab active)
    (if tab
      (return (call (. tab session working-directory)))
    )
    (return directory)
  )
  (fn-do + open-link _
    (param link TerminalPathLink)
    (let parts (in (call url-encode each) (call (. (. link path) split) "/")))
    (let ignored (call open-url (str "file://" (call (. "/" join) parts))))
  )
)

(type + TerminalPane (is TerminalView)
  (fn-do + mounted _
    (call (. super mounted))
    (let ignored (call request-focus))
  )
)
