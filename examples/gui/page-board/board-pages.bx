(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /math)
(blank)
(prop + page-width _ (= 400.0))
(prop + page-height _ (= 560.0))
(prop + page-gap _ (= 48.0))
(prop + row-font-size _ (= 13.0))
(prop + icon-size _ (= 16.0))
(prop _ board-aspect _ (= 1.6))
(prop _ tone-count _ (= 12))
(prop _ page-paper _ (= (call RGBA "#ffffff")))
(prop _ page-wash _ (= (call RGBA "#eef1f6")))
(prop _ page-ink _ (= (call RGBA "#1d2330")))
(prop _ page-muted _ (= (call RGBA "#7a8394")))
(prop _ page-rule _ (= (call RGBA "#c9d0db")))
(prop _ page-glow _ (= (call RGBA "#ffffffb3")))
(prop _ page-names _
  (=
    (list
      "Avery Chen" "Jonah Park" "Mira Okafor" "Theo Lindqvist" "Sana Iqbal" "Ruth Calder"
      "Diego Ferraz" "Lena Novak" "Kofi Mensah" "Ines Duarte" "Oskar Brandt" "Priya Raman"
      "Hugo Laurent" "Yuki Sato" "Nadia Haddad" "Felix Weber"
    )
  )
)
(prop _ page-notes _ (= (list "2 min ago" "Yesterday" "Draft" "Shared" "In review" "12 files" "Merged" "Paused" "Today" "3 comments")))
(prop _ page-titles _
  (=
    (list
      "Inbox" "Launch metrics" "Moodboard" "Field notes" "Team" "Weekly review" "Explorations"
      "Release notes" "Contacts" "Revenue" "Photo picks" "Research" "Directory" "Usage" "Gallery" "Essay"
    )
  )
)
(prop _ page-figures _ (= (list "12,480" "3.2k" "98.4%" "41 ms" "6,215" "870" "1.7M" "24.9%")))
(prop _ page-labels _ (= (list "Active users" "Sessions" "Uptime" "Median latency" "Orders" "Signups" "Requests" "Conversion")))
(prop _ page-captions _ (= (list "Harbor at dawn" "Salt flats" "North ridge" "Old town" "Fern study" "Low tide" "Glacier" "Dunes")))
(prop _ page-headlines _
  (=
    (list
      "What a thousand pages teach us about drawing fast"
      "Notes from the edge of the canvas"
      "Every pixel earns its keep"
      "Zooming out without slowing down"
    )
  )
)
(prop _ page-paragraphs _
  (=
    (list
      "A board of pages is mostly text and small shapes, and most of it is far too small to read once you zoom out. Drawing every glyph at that size wastes time on detail nobody can see."
      "So the renderer swaps detail for coverage: lines of tiny text become soft bars, and icons smaller than a few pixels become squares of the same ink. Up close, everything is drawn exactly."
      "Draws of the same kind are merged whenever nothing drawn between them touches the same pixels, so a screen of thousands of rows still costs only a handful of GPU draw calls."
      "Panning only moves the camera. The recorded scene stays put, and only the parts in view are encoded again, which keeps the frame cheap even when the board holds a million items."
      "The panel in the corner shows what each frame costs, so you can watch the detail change as the text and icons cross a few pixels in size."
    )
  )
)

(type + PageKit
  (prop + names (list TextLayout))
  (prop + notes (list TextLayout))
  (prop + titles (list TextLayout))
  (prop + figures (list TextLayout))
  (prop + labels (list TextLayout))
  (prop + captions (list TextLayout))
  (prop + headlines (list TextLayout))
  (prop + paragraphs (list TextLayout))
  (prop + shapes (list VectorGeometryHandle))
  (prop + tints (list RGBA))
  (prop + palettes (list (list RGBA)))
  (prop + glow _ (= (list page-glow)))
  (fn-do + This _
    (param table VectorGeometryTable)
    (let row-font (call Font "Helvetica" row-font-size))
    (let small-font (call Font "Helvetica" 11))
    (for (in name page-names)
      (+= names (call TextLayout name row-font 220))
    )
    (for (in note page-notes)
      (+= notes (call TextLayout note small-font 130))
    )
    (for (in title page-titles)
      (+= titles (call TextLayout title (call Font "Helvetica" 20 (. FontWeight bold)) 360))
    )
    (for (in figure page-figures)
      (+= figures (call TextLayout figure (call Font "Helvetica" 22 (. FontWeight bold)) 150))
    )
    (for (in label page-labels)
      (+= labels (call TextLayout label (call Font "Helvetica" 10) 150))
    )
    (for (in caption page-captions)
      (+= captions (call TextLayout caption small-font 112))
    )
    (for (in headline page-headlines)
      (+= headlines (call TextLayout headline (call Font "Helvetica" 17 (. FontWeight bold)) 360 (. TextOverflow clip) (. TextWrap word)))
    )
    (for (in paragraph page-paragraphs)
      (+= paragraphs (call TextLayout paragraph small-font 360 (. TextOverflow clip) (. TextWrap word)))
    )
    (+= shapes (call (. table intern-geometry) (as 920001 U64) (=> () (call blob-geometry))))
    (+= shapes (call (. table intern-geometry) (as 920002 U64) (=> () (call star-geometry))))
    (+= shapes (call (. table intern-geometry) (as 920003 U64) (=> () (call ridge-geometry))))
    (for (in tone (..< 0 tone-count))
      (let hue (/ (as tone F64) (as tone-count F64)))
      (let tint (call RGBA (+ 0.25 (* 0.6 (call wave hue 0))) (+ 0.3 (* 0.45 (call wave hue 0.33))) (+ 0.35 (* 0.55 (call wave hue 0.66))) 1))
      (+= tints tint)
      (+= palettes (list tint))
    )
  )
)

(fn-expr _ wave F64
  (param hue F64)
  (param shift F64)
  (* 0.5 (+ 1 (call cos (* 2 π (- hue shift)))))
)

(fn-expr _ jitter F64
  (param seed Int)
  (- value (call floor value))
  (where
    (lazy value (* (call sin (* (as seed F64) 12.9898)) 43758.5453))
  )
)

(fn-expr + board-columns Int
  (param count Int)
  (call max 1 (as (call ceil (call sqrt (* (as count F64) board-aspect ratio))) Int))
  (where
    (lazy ratio (/ (+ page-height page-gap) (+ page-width page-gap)))
  )
)

(fn-expr + board-size Dimensions
  (param count Int)
  (call Dimensions (- (* (as columns F64) (+ page-width page-gap)) page-gap) (- (* (as rows F64) (+ page-height page-gap)) page-gap))
  (where
    (lazy columns (call board-columns count))
    (lazy rows (/ (+ count (- columns 1)) columns))
  )
)

(fn-do + visible-pages Int
  (param count Int)
  (param world Rect)
  (let columns (call board-columns count))
  (let rows (/ (+ count (- columns 1)) columns))
  (let pitch-x (+ page-width page-gap))
  (let pitch-y (+ page-height page-gap))
  (let first-column (call max 0 (as (call floor (/ (. world x) pitch-x)) Int)))
  (let last-column (call min (- columns 1) (as (call floor (/ (+ (. world x) (. world width)) pitch-x)) Int)))
  (let first-row (call max 0 (as (call floor (/ (. world y) pitch-y)) Int)))
  (let last-row (call min (- rows 1) (as (call floor (/ (+ (. world y) (. world height)) pitch-y)) Int)))
  (return-if 0 (if (or (> first-column last-column) (> first-row last-row))))
  (blank)
  (return (call min count (* (+ (- last-column first-column) 1) (+ (- last-row first-row) 1))))
)

(fn-do + paint-board _
  (param kit PageKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param count Int)
  (let columns (call board-columns count))
  (for (in page (..< 0 count))
    (let x (* (as (% page columns) F64) (+ page-width page-gap)))
    (let y (* (as (/ page columns) F64) (+ page-height page-gap)))
    (call paint-page kit table canvas page x y)
  )
)

(fn-do _ paint-page _
  (param kit PageKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param page Int)
  (param x F64)
  (param y F64)
  (let tone (% (* page 5) tone-count))
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) page-paper)
  (call (. canvas outline) (call Outline (call Rect x y page-width page-height) 12))
  (= (. canvas fill-color) ([] (. kit tints) tone))
  (call (. canvas outline) (call Outline (call Rect x y page-width 64) 12))
  (call (. canvas rect) (call Rect x (+ y 40) page-width 24))
  (= (. canvas text-color) page-paper)
  (call (. canvas draw-text) ([] (. kit titles) (% page (. (. kit titles) length))) (call Rect (+ x 20) (+ y 20) 360 28))
  (let kind (% page 4))
  (if (== kind 0)
    (call paint-list kit table canvas page tone x y)
    (else-if (== kind 1)
      (call paint-dashboard kit canvas page tone x y)
    )
    (else-if (== kind 2)
      (call paint-gallery kit table canvas page tone x y)
    )
    (else
      (call paint-article kit table canvas page tone x y)
    )
  )
)

(fn-do _ stamp _
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param shape VectorGeometryHandle)
  (param palette (list RGBA))
  (param rect Rect)
  (let transform (call Matrix (/ (. rect width) 100) 0 0 (/ (. rect height) 100) (. rect x) (. rect y)))
  (let ignored (call (. table paint-vector) shape canvas palette transform))
)

(fn-do _ paint-list _
  (param kit PageKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param page Int)
  (param tone Int)
  (param x F64)
  (param y F64)
  (for (in row (..< 0 20))
    (let top (+ y 82 (* (as row F64) 23)))
    (let shape ([] (. kit shapes) (% (+ row page) 2)))
    (call stamp table canvas shape ([] (. kit palettes) (% (+ tone row) tone-count)) (call Rect (+ x 20) top icon-size icon-size))
    (= (. canvas text-color) page-ink)
    (call (. canvas draw-text) ([] (. kit names) (% (+ page (* row 3)) (. (. kit names) length))) (call Rect (+ x 46) (- top 1) 220 18))
    (= (. canvas text-color) page-muted)
    (call (. canvas draw-text) ([] (. kit notes) (% (+ page row) (. (. kit notes) length))) (call Rect (+ x 250) top 130 18) (. TextAlignment right))
    (if (== (% (+ row page) 3) 0)
      (= (. canvas fill-color) ([] (. kit tints) (% (+ tone 4) tone-count)))
      (call (. canvas outline) (call Outline (call Rect (+ x 190) (+ top 3) 36 11) 5.5))
    )
  )
)

(fn-do _ paint-dashboard _
  (param kit PageKit)
  (param canvas Canvas)
  (param page Int)
  (param tone Int)
  (param x F64)
  (param y F64)
  (for (in tile (..< 0 4))
    (let left (+ x 20 (* (as (% tile 2) F64) 184)))
    (let top (+ y 82 (* (as (/ tile 2) F64) 84)))
    (let pick (% (+ page tile) (. (. kit figures) length)))
    (= (. canvas fill-color) page-wash)
    (call (. canvas outline) (call Outline (call Rect left top 176 74) 8))
    (= (. canvas text-color) page-ink)
    (call (. canvas draw-text) ([] (. kit figures) pick) (call Rect (+ left 14) (+ top 12) 150 28))
    (= (. canvas text-color) page-muted)
    (call (. canvas draw-text) ([] (. kit labels) pick) (call Rect (+ left 14) (+ top 46) 150 14))
  )
  (let baseline (+ y 380))
  (for (in bar (..< 0 16))
    (let height (+ 16 (* 104 (call jitter (+ (* page 16) bar)))))
    (= (. canvas fill-color) ([] (. kit tints) (% (+ tone (* 3 (% bar 2))) tone-count)))
    (call (. canvas outline) (call Outline (call Rect (+ x 22 (* (as bar F64) 22.5)) (- baseline height) 16 height) 3))
  )
  (= (. canvas stroke-color) page-rule)
  (= (. canvas stroke-width) 1)
  (call (. canvas line) (+ x 20) (+ baseline 0.5) (+ x 380) (+ baseline 0.5))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) ([] (. kit tints) (% (+ tone 6) tone-count)))
  (= (. canvas stroke-width) 2.5)
  (call (. canvas begin))
  (for (in step (..< 0 37))
    (let along (/ (as step F64) 36))
    (let level (+ (* 0.6 (call sin (+ (* along 7) (as page F64)))) (* 0.4 (- (call jitter (+ (* page 37) step)) 0.5))))
    (let px (+ x 20 (* along 360)))
    (let py (- (+ y 480) (* level 56)))
    (if (== step 0)
      (call (. canvas move) px py)
      (else
        (call (. canvas line) px py)
      )
    )
  )
  (call (. canvas end))
  (= (. canvas stroke-color) null)
)

(fn-do _ paint-gallery _
  (param kit PageKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param page Int)
  (param tone Int)
  (param x F64)
  (param y F64)
  (for (in thumb (..< 0 12))
    (let left (+ x 20 (* (as (% thumb 3) F64) 124)))
    (let top (+ y 82 (* (as (/ thumb 3) F64) 118)))
    (let shade (% (+ tone thumb) tone-count))
    (= (. canvas fill-color) page-wash)
    (call (. canvas outline) (call Outline (call Rect left top 112 84) 8))
    (call stamp table canvas ([] (. kit shapes) 2) ([] (. kit palettes) shade) (call Rect (+ left 6) (+ top 36) 100 44))
    (= (. canvas fill-color) ([] (. kit tints) (% (+ shade 5) tone-count)))
    (call (. canvas circle) (+ left 84) (+ top 22) (+ 6 (* 5 (call jitter (+ (* page 12) thumb)))))
    (= (. canvas text-color) page-muted)
    (call (. canvas draw-text) ([] (. kit captions) (% (+ page thumb) (. (. kit captions) length))) (call Rect left (+ top 88) 112 16))
  )
)

(fn-do _ paint-article _
  (param kit PageKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param page Int)
  (param tone Int)
  (param x F64)
  (param y F64)
  (= (. canvas fill-color) ([] (. kit tints) (% (+ tone 2) tone-count)))
  (call (. canvas outline) (call Outline (call Rect (+ x 20) (+ y 82) 360 120) 10))
  (call stamp table canvas ([] (. kit shapes) 0) (. kit glow) (call Rect (+ x 40) (+ y 98) 88 88))
  (call stamp table canvas ([] (. kit shapes) 1) (. kit glow) (call Rect (+ x 250) (+ y 104) 72 72))
  (let headline ([] (. kit headlines) (% page (. (. kit headlines) length))))
  (= (. canvas text-color) page-ink)
  (call (. canvas draw-text) headline (call Rect (+ x 20) (+ y 216) 360 (. headline height)))
  (= (. canvas text-color) page-muted)
  (let top (+ y 226 (. headline height)))
  (for (in index (..< 0 4))
    (let paragraph ([] (. kit paragraphs) (% (+ page index) (. (. kit paragraphs) length))))
    (if (<= (+ top (. paragraph height)) (+ y page-height -16))
      (call (. canvas draw-text) paragraph (call Rect (+ x 20) top 360 (. paragraph height)))
    )
    (= top (+ top (. paragraph height) 10))
  )
)

(fn-do _ blob-geometry VectorGeometry
  (let outline (call Path))
  (let center (call Point 50 50))
  (let step (/ (* 2 π) 8))
  (let bulge (* 46 1.08))
  (for (in index (..< 0 8))
    (let start (* (as index F64) step))
    (if (== index 0)
      (call (. outline move-to) (+ center (call Point 46 0)))
    )
    (call (. outline cubic-curve-to)
      (block
        (arg (+ center (call Point (* (call cos (+ start (/ step 3))) bulge) (* (call sin (+ start (/ step 3))) bulge))))
        (arg (+ center (call Point (* (call cos (+ start (/ (* step 2) 3))) bulge) (* (call sin (+ start (/ (* step 2) 3))) bulge))))
        (arg (+ center (call Point (* (call cos (+ start step)) 46) (* (call sin (+ start step)) 46))))
      )
    )
  )
  (call (. outline close))
  (return (call filled-geometry outline))
)

(fn-do _ star-geometry VectorGeometry
  (let outline (call Path))
  (for (in index (..< 0 10))
    (let angle (- (* (as index F64) (/ π 5)) (/ π 2)))
    (let reach (if-expr (== (% index 2) 0) 48.0 20.0))
    (let point (call Point (+ 50 (* (call cos angle) reach)) (+ 52 (* (call sin angle) reach))))
    (if (== index 0)
      (call (. outline move-to) point)
      (else
        (call (. outline line-to) point)
      )
    )
  )
  (call (. outline close))
  (return (call filled-geometry outline))
)

(fn-do _ ridge-geometry VectorGeometry
  (let outline (call Path))
  (call (. outline move-to) 0 100)
  (call (. outline line-to) 0 70)
  (call (. outline line-to) 30 18)
  (call (. outline line-to) 48 48)
  (call (. outline line-to) 66 30)
  (call (. outline line-to) 100 78)
  (call (. outline line-to) 100 100)
  (call (. outline close))
  (return (call filled-geometry outline))
)

(fn-expr _ filled-geometry VectorGeometry
  (param outline Path)
  (call VectorGeometry (call Rect 0 0 100 100) (call Rect -10 -10 120 120) (list (call VectorGeometrySpan outline color none null null null (. FillRule nonzero))) false false)
  (where
    (lazy none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
    (lazy color (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  )
)
