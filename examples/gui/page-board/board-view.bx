(import ./board-camera)
(import ./board-pages)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui)
(import /math)
(import /time/duration)
(blank)
(prop _ precise-zoom-rate _ (= 0.01))
(prop _ line-zoom-rate _ (= 0.15))
(prop _ wheel-line _ (= 40.0))
(prop _ longest-step _ (= 0.1))
(prop _ sample-period _ (= 0.5))

(type + FrameSample (is Tuple)
  (prop + zoom F64)
  (prop + pixel-scale F64)
  (prop + visible Int)
  (prop + frames-per-second F64)
  (prop + cpu-ms F64)
  (prop + gpu-ms F64)
  (prop + draw-calls I64)
)

(type + BoardView (is Box)
  (prop + page-count _ (= 1000))
  (prop + is-touring _ (= false))
  (event + measured FrameSample)
  (prop _ camera _ (= (call BoardCamera)))
  (prop _ kit (? PageKit) (= null))
  (prop _ tour-clock _ (= 0.0))
  (prop _ was-moving _ (= false))
  (prop _ last-frame _ (= -1))
  (prop _ last-done _ (= -1))
  (prop _ sampled-time _ (= 0.0))
  (prop _ moving-time _ (= 0.0))
  (prop _ moving-ticks _ (= 0))
  (prop _ frame-count _ (= 0))
  (prop _ cpu-nanos _ (= 0))
  (prop _ gpu-frames _ (= 0))
  (prop _ gpu-nanos _ (= 0))
  (prop _ draw-calls _ (= 0))
  (depends invalidate-paint page-count)
  (depends start-tour is-touring)
  (prop _ running _
    (machine
      (state live
        (for (on tick frames)
          (call advance (call min longest-step (as (as (. tick delta) Seconds) F64)))
        )
      )
    )
  )
  (content
    (<> This
      (for (on event scroll)
        (= is-touring false)
        (let modifiers (. event modifiers))
        (if (or (. modifiers command) (. modifiers control) (. modifiers option))
          (let rate (if-expr (. event is-precise) precise-zoom-rate line-zoom-rate))
          (call (. camera zoom-by) (call exp (* (- (. event delta-y)) rate)) (. event point))
          (else
            (let line (if-expr (. event is-precise) 1.0 wheel-line))
            (call (. camera pan) (call Point (* (- (. event delta-x)) line) (* (- (. event delta-y)) line)))
          )
        )
        (call invalidate-content-transform)
        (call (. event cancel))
      )
      (for (on event magnify)
        (= is-touring false)
        (call (. camera pinch) (. event scale) (. event point))
        (call invalidate-content-transform)
        (call (. event cancel))
      )
      (for (on event pointer-drag)
        (= is-touring false)
        (call (. camera pan) (. event delta))
        (call invalidate-content-transform)
        (call (. event cancel))
      )
    )
  )
  (fn-expr + content-transform _ :get
    (. camera transform)
  )
  (fn-do + fit _
    (= is-touring false)
    (call (. camera fit))
  )
  (fn-do _ start-tour _
    (if is-touring
      (= tour-clock (* tour-period 0.5))
    )
  )
  (fn-do _ advance _
    (param seconds F64)
    (let placed (. camera is-placed))
    (call (. camera place) (. bounds size) (call board-size page-count))
    (let moved (call move-camera seconds))
    (if (or moved (not placed))
      (call invalidate-content-transform)
    )
    (call sample seconds moved)
  )
  (fn-do _ move-camera Bool
    (param seconds F64)
    (if is-touring
      (= tour-clock (+ tour-clock seconds))
      (call (. camera tour) tour-clock)
      (return true)
    )
    (return (call (. camera step) seconds))
  )
  (fn-do _ sample _
    (param seconds F64)
    (param moved Bool)
    (let root window)
    (return-if (if (not root)))
    (blank)
    (let host (as root Window))
    (let frame (. host last-metal-frame-id))
    (if (and was-moving (!= frame last-frame))
      (= frame-count (+ frame-count 1))
      (= cpu-nanos (+ cpu-nanos (call max 0 (+ (. host metal-encode-nanos) (. host metal-walk-nanos)))))
      (= draw-calls (. host metal-draw-calls))
    )
    (= last-frame frame)
    (let done (. host completed-metal-frame-id))
    (if (and was-moving (!= done last-done))
      (let spent (call (. host metal-frame-gpu-nanos) done))
      (if (>= spent 0)
        (= gpu-frames (+ gpu-frames 1))
        (= gpu-nanos (+ gpu-nanos spent))
      )
    )
    (= last-done done)
    (if moved
      (= moving-time (+ moving-time seconds))
      (= moving-ticks (+ moving-ticks 1))
    )
    (= was-moving moved)
    (= sampled-time (+ sampled-time seconds))
    (return-if (if (< sampled-time sample-period)))
    (blank)
    (if (> frame-count 0)
      (<- measured
        (call FrameSample
          (block
            (arg (. camera scale))
            (arg (* (. camera scale) device-scale))
            (arg (call visible-pages page-count (. camera world-bounds)))
            (arg (if-expr (> moving-time 0) (/ (as moving-ticks F64) moving-time) 0.0))
            (arg (/ (as cpu-nanos F64) (* (as frame-count F64) 1000000)))
            (arg (if-expr (> gpu-frames 0) (/ (as gpu-nanos F64) (* (as gpu-frames F64) 1000000)) 0.0))
            (arg draw-calls)
          )
        )
      )
    )
    (= sampled-time 0.0)
    (= moving-time 0.0)
    (= moving-ticks 0)
    (= frame-count 0)
    (= cpu-nanos 0)
    (= gpu-frames 0)
    (= gpu-nanos 0)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (let pages (?? kit (call PageKit table)))
    (= kit pages)
    (call paint-board pages table canvas page-count)
  )
)
