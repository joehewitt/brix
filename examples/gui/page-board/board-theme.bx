(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)
(blank)

(style BoardTheme
  (using GUIDefaultTheme)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUITextPaint)
  (prop + board-ground-color RGBA (= (call RGBA "#1b1e24")))
  (blank)
  (style-domains board-ground-color (domain paint))
  (blank)
  (rule board-surface (• absolute)
    (= caches-raster true)
    (= cursor (. CursorStyle open-hand))
    (= drag-cursor (. CursorStyle closed-hand))
  )
  (blank)
  (rule board-stats (• glass-panel) (• absolute) (• flex-col) (• px 14) (• py 12))
  (blank)
  (rule board-stats-title (• text gui-strong-text-color)
    (= font-size 13)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule board-stats-line (• text gui-strong-text-color) (• mt 4)
    (= font-size 12)
  )
  (blank)
  (rule board-stats-note (• text gui-muted-text-color) (• mt 8)
    (= font-size 11)
  )
)
