; benchmark.meta description: Zooms Page Board's 4,000 pages from fit to about 105% and back by 1.04 every second trackpad scroll step, in a real 1440 x 900 window at scale 2 with the glass panel, reporting each committed frame's main-thread phases, GPU time and scripted input latency.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-window
(blank)
(import ./../fixtures/board-bench-fixture)
(import /gui)
(blank)

(main
  (<> App
    (<> BoardBenchWindow
      (= script (. BoardBenchScript zoom))
      (= moving-steps 360)
      (= result-name "page-board/window-board-zoom")
    )
  )
)
