(import ./../../board-window)
(import /graphics/point)
(import /gui)
(import /gui/bench/fixtures/window-frame-fixture)
(import /time/timer)
(blank)
(prop + board-bench-pages Size (= 4000))
(prop _ board-bench-settle-steps Size (= 40))
(prop _ board-bench-tail-steps Size (= 30))
(prop _ board-bench-pan _ (= (call Point -3 -1)))
(prop _ board-bench-zoom-delta F64 (= 3.9220713))
(prop _ board-bench-command U64 (= 8))

(type + BoardBenchScript (is Union)
  (variant pan)
  (variant zoom)
)

(type + BoardBenchWindow (is BoardWindow)
  (prop + script BoardBenchScript (= (. BoardBenchScript pan)))
  (prop + moving-steps Size (= 120))
  (prop + result-name String (= "page-board/window-board"))
  (prop _ log _ (:= (call WindowBenchLog this)))
  (fn-do + open _
    (= state-key null)
    (= size window-bench-size)
    (= page-count board-bench-pages)
    (call (. super open))
    (call (. log start))
  )
  (fn-do + end-frame _
    (param committed Bool)
    (call (. super end-frame) committed)
    (call drive committed)
  )
  (fn-do _ drive _
    (param committed Bool)
    (call (. log after-frame) committed)
    (let step (. log steps))
    (let last (+ board-bench-settle-steps moving-steps))
    (if (== step (+ last board-bench-tail-steps))
      (call (. log finish) result-name (+ board-bench-pages step))
      (return)
    )
    (return-if (if (or (< step board-bench-settle-steps) (> step last))))
    (blank)
    (let started (call monotonic-time-nanoseconds))
    (let moved (- step board-bench-settle-steps))
    (let phase (call board-bench-phase moved moving-steps))
    (let center (call Point 720 450))
    (match script
      (case= (. BoardBenchScript pan)
        (call (. log scroll) center (if-expr (== moved moving-steps) (call Point 0 0) board-bench-pan) phase)
      )
      (case= (. BoardBenchScript zoom)
        (if (or (== (% moved 2) 0) (== moved moving-steps))
          (let inward (< moved (/ moving-steps 2)))
          (let delta (if-expr inward (- board-bench-zoom-delta) board-bench-zoom-delta))
          (let shown (if-expr (== moved moving-steps) 0.0 delta))
          (call (. log scroll) center (call Point 0 shown) phase board-bench-command)
        )
      )
    )
    (call (. log timed) started)
  )
)

(fn-expr _ board-bench-phase ScrollPhase
  (param moved Size)
  (param steps Size)
  (case? (== moved 0)
    (. ScrollPhase began)
  )
  (case? (== moved steps)
    (. ScrollPhase ended)
  )
  (default
    (. ScrollPhase changed)
  )
)
