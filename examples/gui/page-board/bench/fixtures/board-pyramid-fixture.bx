(import ./../../board-view)
(import ./../../board-window)
(import ./board-bench-fixture)
(import /graphics/point)
(import /gui)
(import /gui/bench/fixtures/window-frame-fixture)
(import /math)
(import /time/timer)
(blank)
(prop _ pyramid-bounds _ (= (list 0 40 160 340 460 640 700 820 880 1000)))
(prop _ pyramid-pan-fit Size (= 1))
(prop _ pyramid-zoom-in Size (= 2))
(prop _ pyramid-pan-near Size (= 3))
(prop _ pyramid-zoom-out Size (= 4))
(prop _ pyramid-pan-fit-again Size (= 5))
(prop _ pyramid-still Size (= 6))
(prop _ pyramid-jump Size (= 7))
(prop _ pyramid-fit Size (= 8))
(prop _ pyramid-end Size (= 9))
(prop _ pyramid-pan _ (= (call Point -3 -1)))
(prop _ pyramid-zoom-delta F64 (= 3.9220713))
(prop _ pyramid-jump-magnification F64 (= 31))
(prop _ pyramid-command U64 (= 8))
(prop _ pyramid-near-scale F64 (= 0.12))
(prop _ pyramid-center _ (= (call Point 720 450)))

(type + PyramidFrame (is Tuple)
  (prop + segment Size)
  (prop + frame I64)
  (prop + encode-us U64)
  (prop + scale F64)
  (prop + at U64)
)

(type + BoardPyramidWindow (is BoardWindow)
  (prop _ log _ (:= (call WindowBenchLog this)))
  (prop _ view (? BoardView))
  (prop _ records (list PyramidFrame))
  (prop _ starts (list U64))
  (prop _ last-frame I64 (= -1))
  (fn-do + open _
    (= state-key null)
    (= size window-bench-size)
    (= page-count board-bench-pages)
    (call (. super open))
    (= view (call find-board-view this))
    (throw (call Panic "Pyramid window has no board view") (if (not view)))
    (for (in _ pyramid-bounds)
      (+= starts 0u)
    )
    (call (. log start))
  )
  (fn-do + end-frame _
    (param committed Bool)
    (call (. super end-frame) committed)
    (call drive committed)
  )
  (fn-do _ drive _
    (param committed Bool)
    (call (. log after-frame) committed)
    (let step (. log steps))
    (return-if (if (== step 0)))
    (blank)
    (let segment (call pyramid-segment step))
    (if committed
      (call note-frame segment)
    )
    (if (== segment pyramid-end)
      (call report)
      (call (. log finish) "page-board/window-board-pyramid" (+ board-bench-pages step))
      (return)
    )
    (let start ([] pyramid-bounds segment))
    (let moved (- step start))
    (if (== moved 0)
      (= ([] starts segment) (call monotonic-time-nanoseconds))
    )
    (let last (- ([] pyramid-bounds (+ segment 1)) start 1))
    (let started (call monotonic-time-nanoseconds))
    (match? segment
      (case= pyramid-pan-fit
        (call pan-step moved last)
      )
      (case= pyramid-zoom-in
        (call zoom-step moved last true)
      )
      (case= pyramid-pan-near
        (call pan-step moved last)
      )
      (case= pyramid-zoom-out
        (call zoom-step moved last false)
      )
      (case= pyramid-pan-fit-again
        (call pan-step moved last)
      )
      (case= pyramid-jump
        (if (== moved 0)
          (call (. log magnify) pyramid-center pyramid-jump-magnification)
        )
      )
      (case= pyramid-fit
        (if (== moved 0)
          (call (. (!! view) fit))
        )
      )
    )
    (call (. log timed) started)
  )
  (fn-do _ pan-step _
    (param moved Size)
    (param last Size)
    (let delta (if-expr (== moved last) (call Point 0 0) pyramid-pan))
    (call (. log scroll) pyramid-center delta (call pyramid-phase moved last))
  )
  (fn-do _ zoom-step _
    (param moved Size)
    (param last Size)
    (param inward Bool)
    (return-if (if (and (!= (% moved 2) 0) (!= moved last))))
    (blank)
    (let delta (if-expr inward (- pyramid-zoom-delta) pyramid-zoom-delta))
    (let shown (if-expr (== moved last) 0.0 delta))
    (call (. log scroll) pyramid-center (call Point 0 shown) (call pyramid-phase moved last) pyramid-command)
  )
  (fn-do _ note-frame _
    (param segment Size)
    (let frame last-metal-frame-id)
    (let times last-frame-times)
    (return-if (if (or (== frame last-frame) (not times))))
    (blank)
    (= last-frame frame)
    (let scale (. (!! (. (!! view) content-transform)) a))
    (let encode (/ (as (call max 0 (as (. times encode) I64)) U64) 1000))
    (+= records (call PyramidFrame segment frame encode scale (call monotonic-time-nanoseconds)))
  )
  (fn-do _ report _
    (let pan-fit (call encodes pyramid-pan-fit pyramid-pan-fit 100.0))
    (probe-count gui.bench.board.pan-fit-encode-p50-us (call window-bench-percentile pan-fit 50))
    (probe-count gui.bench.board.pan-fit-encode-max-us (call window-bench-percentile pan-fit 100))
    (probe-count gui.bench.board.pan-fit-gpu-p50-us (call window-bench-percentile (call gpus pyramid-pan-fit) 50))
    (let near (call encodes pyramid-zoom-in pyramid-zoom-out pyramid-near-scale))
    (probe-count gui.bench.board.zoom-near-encode-p50-us (call window-bench-percentile near 50))
    (probe-count gui.bench.board.zoom-near-encode-max-us (call window-bench-percentile near 100))
    (probe-count gui.bench.board.zoom-near-frames (as (. near length) U64))
    (let zooming (call encodes pyramid-zoom-in pyramid-zoom-out 100.0))
    (probe-count gui.bench.board.zoom-encode-p50-us (call window-bench-percentile zooming 50))
    (probe-count gui.bench.board.zoom-encode-max-us (call window-bench-percentile zooming 100))
    (let pan-near (call encodes pyramid-pan-near pyramid-pan-near 100.0))
    (probe-count gui.bench.board.pan-near-encode-p50-us (call window-bench-percentile pan-near 50))
    (let pan-again (call encodes pyramid-pan-fit-again pyramid-pan-fit-again 100.0))
    (probe-count gui.bench.board.pan-fit-again-encode-p50-us (call window-bench-percentile pan-again 50))
    (probe-count gui.bench.board.pan-fit-again-gpu-p50-us (call window-bench-percentile (call gpus pyramid-pan-fit-again) 50))
    (probe-count gui.bench.board.still-settle-us (call settle-us pyramid-still))
    (probe-count gui.bench.board.still-frames (as (. (call encodes pyramid-still pyramid-still 100.0) length) U64))
    (probe-count gui.bench.board.jump-encode-max-us (call window-bench-percentile (call encodes pyramid-jump pyramid-jump 100.0) 100))
    (probe-count gui.bench.board.jump-settle-us (call settle-us pyramid-jump))
    (probe-count gui.bench.board.fit-encode-max-us (call window-bench-percentile (call encodes pyramid-fit pyramid-fit 100.0) 100))
    (probe-count gui.bench.board.fit-settle-us (call settle-us pyramid-fit))
  )
  (fn-do _ encodes (list U64)
    (param first Size)
    (param second Size)
    (param most F64)
    (let found (list U64))
    (for (in sample records)
      (if (and (or (== (. sample segment) first) (== (. sample segment) second)) (<= (. sample scale) most))
        (+= found (. sample encode-us))
      )
    )
    (return found)
  )
  (fn-do _ gpus (list U64)
    (param segment Size)
    (let found (list U64))
    (for (in sample records)
      (if (== (. sample segment) segment)
        (let spent (call metal-frame-gpu-nanos (. sample frame)))
        (if (>= spent 0)
          (+= found (/ (as spent U64) 1000))
        )
      )
    )
    (return found)
  )
  (fn-do _ settle-us U64
    (param segment Size)
    (let start ([] starts segment))
    (let latest start)
    (for (in sample records)
      (if (== (. sample segment) segment)
        (= latest (call max latest (. sample at)))
      )
    )
    (return (/ (- latest start) 1000))
  )
)

(fn-do + find-board-view (? BoardView)
  (param node GuiNode)
  (if (is node BoardView)
    (return (as node BoardView))
  )
  (for (in child (. node children))
    (let found (call find-board-view child))
    (return-if found (if found))
  )
  (return null)
)

(fn-do _ pyramid-segment Size
  (param step Size)
  (let segment Size 0)
  (while (and (< (+ segment 1) (. pyramid-bounds length)) (>= step ([] pyramid-bounds (+ segment 1))))
    (+= segment 1)
  )
  (return segment)
)

(fn-expr _ pyramid-phase ScrollPhase
  (param moved Size)
  (param last Size)
  (case? (== moved 0)
    (. ScrollPhase began)
  )
  (case? (== moved last)
    (. ScrollPhase ended)
  )
  (default
    (. ScrollPhase changed)
  )
)
