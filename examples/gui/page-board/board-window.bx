(import ./board-pages)
(import ./board-theme)
(import ./board-view)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/maximize)
(import /gui/icons/lucide/play)
(import /math)
(blank)
(prop _ page-choices _ (= (list 250 1000 4000)))

(type + BoardWindow (is Window)
  (using BoardTheme)
  (prop + page-count _ (= 1000))
  (prop + is-touring _ (= false))
  (prop + sample _ (= (call FrameSample 1 2 0 0 0 0 0)))
  (content
    (<> This
      (= title "Page Board")
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= size (call Dimensions 1440 900))
      (= state-key "page-board")
      (= background $board-ground-color)
      (blank)
      (<> BoardView (id: board) (• board-surface) (• cover .parent)
        (= page-count #page-count)
        (<-> is-touring is-touring)
        (for (on value measured)
          (= sample value)
        )
      )
      (<> Box (• board-stats)
        (= left (call (. PositionOffset coord) 16))
        (= bottom (call (. PositionOffset coord) 16))
        (<> Label (• board-stats-title)
          (= text (call scene-line #page-count #sample))
        )
        (<> Label (• board-stats-line)
          (= text (call zoom-line #sample))
        )
        (<> Label (• board-stats-line)
          (= text (call frame-line #sample))
        )
        (<> Label (• board-stats-note)
          (= text "Text under 4 px per em draws as bars; shapes under 3 px as squares.")
        )
      )
      (<> Toolbar (• absolute)
        (= left (call (. PositionOffset coord) 0))
        (= right (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (= is-title-bar true)
        (<> ToolbarTitle (text: "Page Board"))
        (<> ToolbarGroup
          (<> (of SegmentedControl Int)
            (<-> selected page-count)
            (for (in choice page-choices)
              (<> (of Segment Int) (text: (str choice " pages"))
                (= value choice)
              )
            )
          )
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> ToolbarButton (text: "Tour") (• icon-play)
            (= is-on #is-touring)
            (= action (=> () :do (= is-touring (not is-touring))))
          )
          (<> ToolbarButton (text: "Fit") (• icon-maximize)
            (= action (=> () :do (call (. board fit))))
          )
        )
      )
    )
  )
)

(fn-expr _ scene-line String
  (param count Int)
  (param sample FrameSample)
  (str count " pages · " (. sample visible) " in view")
)

(fn-expr _ zoom-line String
  (param sample FrameSample)
  (str "Zoom " (call rounded (* (. sample zoom) 100) 1) "% · text " (call rounded (* row-font-size (. sample pixel-scale)) 1) " px per em · icons " (call rounded (* icon-size (. sample pixel-scale)) 1) " px")
)

(fn-expr _ frame-line String
  (param sample FrameSample)
  (if-expr (== (. sample draw-calls) 0)
    "Pan, zoom or tour to measure frames"
    (str (call rounded (. sample frames-per-second) 0) " fps · CPU " (call rounded (. sample cpu-ms) 2) " ms · GPU " (call rounded (. sample gpu-ms) 2) " ms · " (. sample draw-calls) " draw calls")
  )
)

(fn-expr _ rounded F64
  (param value F64)
  (param places Int)
  (/ (call round (* value scale)) scale)
  (where
    (lazy scale (%% 10.0 (as places F64)))
  )
)
