(import ./quake-card)
(import ./quake-feed)
(import ./quake-map)
(import ./quake-text)
(import ./quakes-theme)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/play)
(import /gui/icons/lucide/refresh-cw)
(import /math)
(import /time/duration)
(import /time/timer)
(import /units/distance)
(blank)
(prop _ feeds _ (= (list (. QuakeFeed hour) (. QuakeFeed day) (. QuakeFeed week) (. QuakeFeed month))))
(prop _ refresh-interval _ (= 5minutes))
(prop _ retry-interval _ (= 30s))
(prop _ replay-length _ (= 10s))
(prop _ cluster-reach _ (= 100km))
(prop _ list-limit _ (= 50))

(type + QuakesWindow (is Window)
  (using QuakesTheme)
  (prop + feed _ (= (. QuakeFeed day)))
  (prop + quakes (list Quake))
  (prop + outlines (list (list Coordinate)))
  (prop + floor Magnitude (= 0mag))
  (prop + uses-miles _ (= false))
  (prop + chosen-id _ (= ""))
  (prop + clock Seconds (= (call epoch-now)))
  (prop + updated Seconds (= (call epoch-now)))
  (prop + progress _ (= 1.0))
  (prop + listed _ (= (call strongest #quakes #floor)))
  (prop + top _ (= ([] #listed (..< 0 (call min list-limit (. #listed length))))))
  (prop + shown _ (= (call up-to #listed (call replay-cutoff #quakes #clock #progress))))
  (prop + picked _ (= (call with-id #quakes #chosen-id)))
  (event + reloads Bool)
  (event + replays Bool)
  (prop + phase _
    (machine
      (state loading
        (do
          (do-new
            (<- outcome (call load-quakes feed))
          )
        )
        (blank)
        (then showing (trigger for (call .loaded found) outcome)
          (do
            (= quakes found)
            (= updated (call epoch-now))
            (= clock updated)
          )
        )
        (blank)
        (then (call failed message) (trigger for (call .failed message) outcome))
        (then loading (trigger on reloads))
        (then loading (trigger whenever #feed))
        (blank)
        (lazy outcome (call (of AsyncBufferedChannel QuakeUpdate)))
      )
      (blank)
      (state showing
        (then loading (trigger on reloads))
        (then loading (trigger whenever #feed))
        (then loading (trigger on (call Timer refresh-interval)))
      )
      (blank)
      (state (call failed message)
        (then loading (trigger on reloads))
        (then loading (trigger whenever #feed))
        (then loading (trigger on (call Timer retry-interval)))
      )
    )
  )
  (prop + playback _
    (machine
      (state is-still
        (then is-replaying (trigger on replays))
      )
      (blank)
      (state is-replaying
        (do
          (= progress 0.0)
        )
        (blank)
        (finally
          (= progress 1.0)
        )
        (blank)
        (for (on tick frames)
          (= progress (call min 1.0 (+ progress (as (/ (. tick delta) replay-length) F64))))
        )
        (blank)
        (then is-still (trigger on frames (>= progress 1)))
        (then is-still (trigger on replays))
      )
    )
  )
  (content
    (<> This
      (= title "Earthquakes")
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= size (call Dimensions 1440 640))
      (= state-key "quakes")
      (= background $quake-space-color)
      (blank)
      (<> QuakeMap (id: map) (• absolute) (• cover .parent)
        (= fit-insets (call Insets (+ gui-toolbar-height quake-margin) quake-margin quake-margin quake-list-room))
        (= outlines #outlines)
        (= quakes #shown)
        (= marked-id #chosen-id)
        (= clock #clock)
        (for (on id chosen)
          (= chosen-id id)
        )
        (for (in quake #picked (keyed-by (. quake id)))
          (<> QuakeCard
            (= left (call (. PositionOffset coord) quake-list-room))
            (= bottom (call (. PositionOffset coord) quake-margin))
            (= quake quake)
            (= age (- #clock (. quake time)))
            (= nearby (call neighbors quake #shown cluster-reach))
            (= reach cluster-reach)
            (= uses-miles #uses-miles)
          )
        )
        (if (is #playback .is-replaying)
          (<> ProgressBar (• absolute) (• h 3)
            (= left (call (. PositionOffset coord) 0))
            (= right (call (. PositionOffset coord) 0))
            (= bottom (call (. PositionOffset coord) 0))
            (= value #progress)
          )
        )
      )
      (<> Sidebar (• quake-list)
        (= left (call (. PositionOffset coord) quake-margin))
        (= top (call (. PositionOffset coord) (+ gui-toolbar-height quake-margin)))
        (= bottom (call (. PositionOffset coord) quake-margin))
        (<> SidebarSection (text: "Strongest") (• pt 10)
          (for (in quake #top (keyed-by (. quake id)))
            (<> SidebarItem
              (= title (. quake place))
              (= is-on (== #chosen-id (. quake id)))
              (= action (=> () :do (call choose quake)))
              (<> Label (slot: trailing) (• button-badge)
                (= text (call magnitude-label (. quake magnitude)))
              )
            )
          )
        )
      )
      (<> Toolbar (• absolute)
        (= left (call (. PositionOffset coord) 0))
        (= right (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (= is-title-bar true)
        (<> ToolbarTitle (text: "Earthquakes"))
        (<> ToolbarGroup
          (<> (of SegmentedControl QuakeFeed)
            (<-> selected feed)
            (for (in choice feeds)
              (<> (of Segment QuakeFeed) (text: (. choice title))
                (= value choice)
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> Label (• quake-floor)
            (= text (str (call magnitude-label #floor) "+"))
          )
          (<> Slider (• w 120)
            (= minimum 0)
            (= maximum 7)
            (= step 0.5)
            (<-> value floor)
          )
        )
        (<> ToolbarGroup
          (<> (of SegmentedControl Bool)
            (<-> selected uses-miles)
            (<> (of Segment Bool) (text: "km")
              (= value false)
            )
            (<> (of Segment Bool) (text: "mi")
              (= value true)
            )
          )
        )
        (<> ToolbarSpace)
        (<> Label (• quake-status)
          (= text
            (match #phase
              (case (call .failed message)
                (str "Could not load earthquakes: " message)
              )
              (case .loading
                (str "Loading the past " (. #feed period) "…")
              )
              (default
                (call feed-summary (. #listed length) (- #clock #updated))
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (text: "Replay") (• icon-play)
            (= is-on (is #playback .is-replaying))
            (= action (=> () :do (<- replays true)))
          )
          (<> ToolbarButton (• icon-refresh-cw)
            (= is-enabled (is-not #phase .loading))
            (= action (=> () :do (<- reloads true)))
            (<> Tooltip
              (= text "Refresh")
            )
          )
        )
      )
    )
  )
  (subscribe-for (on tick (call Timer 30s))
    (= clock (call epoch-now))
  )
  (fn-do + This _
    (do-new
      (= outlines (?? (catch? (call fetch-land)) outlines))
    )
  )
  (fn-do + choose _
    (param quake Quake)
    (= chosen-id (. quake id))
    (call (. map reveal) (. quake position))
  )
)
