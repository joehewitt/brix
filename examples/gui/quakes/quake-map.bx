(import ./quake-feed)
(import ./quake-text)
(import ./quakes-theme)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/maximize)
(import /gui/icons/lucide/minus)
(import /gui/icons/lucide/plus)
(import /math)
(import /time/duration)
(import /units)
(import /units/distance)
(blank)
(prop _ world-size _ (= (call Dimensions 360 180)))
(prop _ closest-zoom _ (= 40.0))
(prop _ zoom-step _ (= 2.0))
(prop _ wheel-rate _ (= 0.15))
(prop _ click-slop _ (= 4.0))

(type + QuakeMap (is Box)
  (implements ZoomOwner)
  (using QuakesTheme)
  (prop + outlines (list (list Coordinate)))
  (prop + quakes (list Quake))
  (prop + marked-id _ (= ""))
  (prop + clock Seconds)
  (prop + fit-insets _ (= (call Insets 0 0 0 0)))
  (prop + is-zoomed _ (= false))
  (event + chosen String)
  (blank)
  (prop _ framing _ (:= (call ZoomFrame this this)))
  (prop _ placement _ (:= (call WorldPlacement this)))
  (prop _ pressed-at _ (= (call Point 0 0)))
  (content
    (<> This
      (<> Box (id: viewport) (• quake-viewport) (• cover .parent) (• quake-pannable (if: #is-zoomed))
        (for (on event scroll)
          (call zoom-or-pan event)
        )
        (for (on event magnify)
          (if (call (. framing handle-magnify) event)
            (call (. event cancel))
          )
        )
        (for (on event pointer-down)
          (= pressed-at (. event point))
          (let ignored (call (. framing handle-pointer-down) event))
        )
        (for (on event pointer-drag)
          (if (call (. framing handle-pointer-drag) event)
            (call (. event cancel))
          )
        )
        (for (on event pointer-up)
          (call (. framing handle-pointer-up))
        )
        (for (on event click)
          (if (< (call (. pressed-at distance) (. event point)) click-slop)
            (<- chosen "")
          )
        )
        (<> QuakeWorld
          (= position placement)
          (= outlines #outlines)
          (for (in quake #quakes (keyed-by (. quake id)))
            (<> QuakeMarker
              (= quake quake)
              (= is-chosen (== #marked-id (. quake id)))
              (= is-fresh (< (- #clock (. quake time)) 1hours))
              (for (on event click)
                (<- chosen (. quake id))
                (call (. event cancel))
              )
            )
          )
        )
      )
      (<> ToolbarGroup (• absolute)
        (= top (call (. PositionOffset coord) (. #fit-insets top)))
        (= right (call (. PositionOffset coord) (. #fit-insets right)))
        (<> ToolbarButton (• icon-minus)
          (= is-enabled #is-zoomed)
          (= action (=> () :do (call zoom-by (/ 1 zoom-step))))
          (<> Tooltip
            (= text "Zoom Out")
          )
        )
        (<> ToolbarButton (• icon-plus)
          (= action (=> () :do (call zoom-by zoom-step)))
          (<> Tooltip
            (= text "Zoom In")
          )
        )
        (<> ToolbarButton (• icon-maximize)
          (= is-enabled #is-zoomed)
          (= action (=> () :do (call fit)))
          (<> Tooltip
            (= text "Show the Whole World")
          )
        )
      )
    )
  )
  (depends reframe fit-insets)
  (blank)
  (subscribe-for (on _ (. framing moved))
    (= is-zoomed (not (. framing is-fit)))
    (call reframe)
  )
  (fn-expr + placed Rect :get
    (call (. framing placed))
  )
  (fn-do + zoom-by _
    (param factor F64)
    (call (. framing zoom-by) factor (- (. clear center) (call Point (. bounds x) (. bounds y))))
  )
  (fn-do + fit _
    (call (. framing fit))
  )
  (fn-do + reveal _
    (param place Coordinate)
    (return-if (if (. framing is-fit)))
    (let scale (call (. framing effective-zoom)))
    (let shift (- (. clear center) (. content-bounds center)))
    (= (. framing center)
      (call Point
        (block
          (arg (- (* (. place across) (. world-size width)) (/ (. shift x) scale)))
          (arg (- (* (. place down) (. world-size height)) (/ (. shift y) scale)))
        )
      )
    )
    (call reframe)
  )
  (fn-expr _ clear Rect :get
    (call (. content-bounds inset) fit-insets)
  )
  (fn-do _ reframe _
    (call (. viewport invalidate-layout))
  )
  (fn-do _ zoom-or-pan _
    (param event ScrollEvent)
    (if (. event is-precise)
      (let ignored (call (. framing handle-scroll) event))
      (else
        (call (. framing zoom-by) (call exp (* (- (. event delta-y)) wheel-rate)) (. event point))
      )
    )
    (call (. event cancel))
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is ZoomOwner ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + zoom-bounds ZoomBounds
    (call ZoomBounds world-size fitted (/ (. fitted width) (. world-size width)) closest-zoom)
    (where
      (lazy fitted (call image-fit-rect world-size clear (. ImageFit contain) (. AnchorPoint center) (. AnchorPoint center)))
    )
  )
)

(type _ WorldPlacement (is AbsolutePosition)
  (prop + map QuakeMap)
  (fn-do + This _
    (param map _)
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is Position ╌╌╌╌╌╌╌╌╌╌
  (fn-do + arrange _
    (param parent Box)
    (param child Box)
    (call (. child arrange-outer-bounds) (. map placed))
  )
)

(type _ QuakeWorld (is Box)
  (using QuakesTheme)
  (prop + outlines (list (list Coordinate)))
  (blank)
  (depends invalidate-paint outlines)
  (blank)
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (let content content-bounds)
      (call (. canvas translate) (. content x) (. content y))
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) $quake-ocean-color)
      (call (. canvas rect) (call Rect 0 0 width height))
      (= (. canvas fill-color) $quake-land-color)
      (call (. canvas begin))
      (for (in outline outlines)
        (let start (call spot ([] outline 0)))
        (call (. canvas move) (. start x) (. start y))
        (for (in corner outline)
          (call (. canvas line) (call spot corner))
        )
        (call (. canvas enclose))
      )
      (call (. canvas end))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) $quake-grid-color)
      (= (. canvas stroke-width) 1)
      (let step (call grid-step (/ width (. world-size width))))
      (for (in longitude (..< step 360 (by: step)))
        (call (. canvas line) (* (/ longitude 360.0) width) 0 (* (/ longitude 360.0) width) height)
      )
      (for (in latitude (..< step 180 (by: step)))
        (call (. canvas line) 0 (* (/ latitude 180.0) height) width (* (/ latitude 180.0) height))
      )
    )
  )
  ; ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌
  (fn-expr _ spot Point
    (param place Coordinate)
    (call Point (* (. place across) width) (* (. place down) height))
  )
)

(type + QuakeMarker (is Box)
  (using QuakesTheme)
  (prop + quake Quake)
  (prop + is-chosen _ (= false))
  (prop + is-fresh _ (= false))
  (prop + size Length (= (call quake-size (. #quake magnitude))))
  (prop + color RGBA (= (call depth-color (. #quake depth))))
  (content
    (<> This (• quake-marker)
      (= anchor (. Anchor parent))
      (= left (call (. PositionOffset percent) (. #quake position across)))
      (= top (call (. PositionOffset percent) (. #quake position down)))
      (if #is-fresh
        (<> Box (• quake-ripple)
          (= left (call position-pin (. AnchorPoint center) (. AnchorPoint center)))
          (= top (call position-pin (. AnchorPoint center) (. AnchorPoint center)))
          (= min-width (call (. SizeSpec coord) #size))
          (= min-height (call (. SizeSpec coord) #size))
          (= corner-radius (/ #size 2))
          (= border-color #color)
        )
      )
      (<> Box (• quake-dot)
        (= left (call position-pin (. AnchorPoint center) (. AnchorPoint center)))
        (= top (call position-pin (. AnchorPoint center) (. AnchorPoint center)))
        (= min-width (call (. SizeSpec coord) #size))
        (= min-height (call (. SizeSpec coord) #size))
        (= corner-radius (/ #size 2))
        (= background-color (call (. #color with-alpha) 0.8))
        (<> Tooltip
          (= text (call quake-title #quake))
        )
      )
    )
  )
)

(fn-expr + quake-size Length
  (param magnitude Magnitude)
  (+ 4 (* 0.6 (%% (call max 0mag magnitude) 2)))
)

(fn-expr + depth-color RGBA
  (param depth Kilometers)
  (match depth
    (case? (< it 35km)
      (call RGBA "#ff5a36")
    )
    (case? (< it 70km)
      (call RGBA "#ff9f1c")
    )
    (case? (< it 300km)
      (call RGBA "#f4d35e")
    )
    (default
      (call RGBA "#3da5ff")
    )
  )
)

(fn-expr _ grid-step Int
  (param scale F64)
  (match scale
    (case? (< it 8)
      30
    )
    (case? (< it 24)
      10
    )
    (default
      5
    )
  )
)
