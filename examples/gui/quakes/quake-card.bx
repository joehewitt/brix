(import ./quake-feed)
(import ./quake-text)
(import ./quakes-theme)
(import /graphics/primitives)
(import /gui)
(import /gui/desktop)
(import /time/duration)
(import /units/distance)

(type + QuakeCard (is Box)
  (using QuakesTheme)
  (prop + quake Quake)
  (prop + age Seconds)
  (prop + nearby Size)
  (prop + reach Kilometers)
  (prop + uses-miles _ (= false))
  (content
    (<> This (• quake-card) (• flex-col)
      (<> Label (• quake-card-title)
        (= text (call quake-title #quake))
      )
      (<> Label (• quake-card-line)
        (= text (call quake-facts #quake #age #uses-miles))
      )
      (<> Label (• quake-card-line)
        (= text (call cluster-note #nearby #reach #uses-miles))
      )
      (<> Button (text: "Open on USGS") (• mt 10)
        (= action (=> () :do (call open-url (. quake url))))
      )
    )
  )
)
