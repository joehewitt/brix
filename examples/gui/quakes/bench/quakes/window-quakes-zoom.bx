; benchmark.meta description: Zooms Quakes' world map from fit in to its closest zoom and back by command scrolls, panning between, over 120 generated coastlines of 60 corners and 600 generated quakes, in a real 1440 x 900 window at scale 2, reporting each committed frame's main-thread phases, GPU time and scripted input latency.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-window
(blank)
(import ./../../quake-feed)
(import ./../../quake-map)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /gui/bench/fixtures/window-frame-fixture)
(import /math)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ quakes-bench-coasts Size (= 120))
(prop _ quakes-bench-corners Size (= 60))
(prop _ quakes-bench-count Size (= 600))
(prop _ quakes-bench-settle-steps Size (= 40))
(prop _ quakes-bench-segment-steps Size (= 60))
(prop _ quakes-bench-tail-steps Size (= 30))
(prop _ quakes-bench-zoom-delta F64 (= 3.9220713))
(prop _ quakes-bench-pan _ (= (call Point 6 2)))
(prop _ quakes-bench-command U64 (= 8))
(prop _ quakes-bench-center _ (= (call Point 720 450)))

(main
  (<> App
    (<> QuakesBenchWindow
      (<> QuakeMap (• absolute) (• cover .parent)
        (= fit-insets (call Insets 40 40 40 40))
        (= outlines (call quakes-bench-outlines))
        (= quakes (call quakes-bench-quakes))
        (= clock 1800000)
      )
    )
  )
)

(type _ QuakesBenchWindow (is Window)
  (prop _ log _ (:= (call WindowBenchLog this)))
  (prop _ ticks Size)
  (prop _ ticking _
    (machine
      (state live
        (for (on tick frames)
          (+= ticks 1)
        )
      )
    )
  )
  (fn-do + open _
    (= state-key null)
    (= size window-bench-size)
    (= title "Quakes Zoom")
    (call (. super open))
    (call (. log start))
  )
  (fn-do + end-frame _
    (param committed Bool)
    (call (. super end-frame) committed)
    (call drive committed)
  )
  (fn-do _ drive _
    (param committed Bool)
    (call (. log after-frame) committed)
    (let step (. log steps))
    (let moving (* quakes-bench-segment-steps 3))
    (let last (+ quakes-bench-settle-steps moving))
    (if (== step (+ last quakes-bench-tail-steps))
      (call (. log finish) "quakes/window-quakes-zoom" (+ quakes-bench-count step))
      (return)
    )
    (return-if (if (or (< step quakes-bench-settle-steps) (>= step last))))
    (blank)
    (let started (call monotonic-time-nanoseconds))
    (let moved (- step quakes-bench-settle-steps))
    (let segment (/ moved quakes-bench-segment-steps))
    (let within (% moved quakes-bench-segment-steps))
    (let phase (call quakes-bench-phase within quakes-bench-segment-steps))
    (let ending (== within (- quakes-bench-segment-steps 1)))
    (match segment
      (case= 1
        (call (. log scroll) quakes-bench-center (if-expr ending (call Point 0 0) quakes-bench-pan) phase)
      )
      (default
        (let delta (if-expr (== segment 0) (- quakes-bench-zoom-delta) quakes-bench-zoom-delta))
        (call (. log scroll) quakes-bench-center (call Point 0 (if-expr ending 0.0 delta)) phase quakes-bench-command)
      )
    )
    (call (. log timed) started)
  )
)

(fn-expr _ quakes-bench-phase ScrollPhase
  (param within Size)
  (param steps Size)
  (case? (== within 0)
    (. ScrollPhase began)
  )
  (case? (== within (- steps 1))
    (. ScrollPhase ended)
  )
  (default
    (. ScrollPhase changed)
  )
)

(fn-do _ quakes-bench-outlines (list (list Coordinate))
  (let outlines (list (list Coordinate)))
  (for (in coast (..< 0 quakes-bench-coasts))
    (let seed (as coast F64))
    (let longitude (- (* (call quakes-bench-fraction (* seed 0.618034)) 340) 170))
    (let latitude (- (* (call quakes-bench-fraction (* seed 0.381966)) 130) 60))
    (let radius (+ 3 (* (call quakes-bench-fraction (* seed 0.723607)) 12)))
    (let corners (list Coordinate))
    (for (in corner (..< 0 quakes-bench-corners))
      (let angle (/ (* 2 π (as corner F64)) (as quakes-bench-corners F64)))
      (let wobble (+ 1 (* 0.25 (call sin (+ (* angle 3) seed))) (* 0.1 (call sin (+ (* angle 7) (* seed 2))))))
      (+= corners (call Coordinate (+ longitude (* radius wobble (call cos angle))) (+ latitude (* radius 0.6 wobble (call sin angle)))))
    )
    (+= outlines corners)
  )
  (return outlines)
)

(fn-do _ quakes-bench-quakes (list Quake)
  (let quakes (list Quake))
  (for (in index (..< 0 quakes-bench-count))
    (let seed (as index F64))
    (let longitude (- (* (call quakes-bench-fraction (* seed 0.618034)) 360) 180))
    (let latitude (- (* (call quakes-bench-fraction (* seed 0.754878)) 150) 75))
    (let magnitude (+ 2.5 (* (call quakes-bench-fraction (* seed 0.569840)) 4.5)))
    (let depth (* (call quakes-bench-fraction (* seed 0.412454)) 600))
    (let time (* (call quakes-bench-fraction (* seed 0.311804)) 1800000))
    (+= quakes (call Quake (str "q" index) (str "Place " index) magnitude (call Coordinate longitude latitude) depth (as time Milliseconds) ""))
  )
  (return quakes)
)

(fn-expr _ quakes-bench-fraction F64
  (param value F64)
  (- value (call floor value))
)
