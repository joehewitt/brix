(import /graphics/color)
(import /graphics/point)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop + quake-margin _ (= 12.0))
(prop + quake-list-width _ (= 280.0))
(prop + quake-list-room _ (= (+ quake-list-width (* 2 quake-margin))))

(style QuakesTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIBoxTransform)
  (using GUIFontStyle)
  (using GUITextPaint)
  (prop + quake-space-color RGBA (= (call RGBA "#070c13")))
  (prop + quake-ocean-color RGBA (= (call RGBA "#0d1722")))
  (prop + quake-land-color RGBA (= (call RGBA "#22303d")))
  (prop + quake-grid-color RGBA (= (call RGBA "#ffffff0f")))
  (blank)
  (style-domains quake-space-color (domain paint))
  (style-domains quake-ocean-color (domain paint))
  (style-domains quake-land-color (domain paint))
  (style-domains quake-grid-color (domain paint))
  (blank)
  (keyframes quake-ripple animation 1800ms
    (= repeat (. Repeat forever))
    (range scale 1 3.6)
    (range opacity 0.8%% 0%%)
  )
  (blank)
  (rule quake-viewport (• absolute)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (rule quake-pannable
    (= cursor (. CursorStyle open-hand))
    (= drag-cursor (. CursorStyle closed-hand))
  )
  (blank)
  (rule quake-marker (• absolute)
    (= motion gui-motion-bouncy)
    (blank)
    (when-style #is-entering
      (= scale 0)
      (= opacity 0%%)
    )
    (blank)
    (when-style #is-leaving
      (= scale 0)
      (= opacity 0%%)
      (= motion gui-motion-quick)
    )
    (blank)
    (when-style #is-chosen
      (rule quake-dot
        (= border-color white)
        (= border-width 2)
      )
    )
  )
  (blank)
  (rule quake-dot (• absolute)
    (= border-color (call RGBA "#00000066"))
    (= border-width 1)
    (= motion gui-motion-quick)
    (blank)
    (when-style #is-hovered
      (= scale 1.3)
    )
  )
  (blank)
  (rule quake-ripple (• absolute)
    (= border-width 1.5)
    (= animation quake-ripple)
  )
  (blank)
  (rule quake-list (• glass-panel) (• absolute) (• w quake-list-width))
  (blank)
  (rule quake-floor (• text gui-muted-text-color) (• w 50) (• pl 10)
    (= font-size 12)
    (= align-y (. Alignment center))
  )
  (blank)
  (rule quake-status (• text gui-muted-text-color) (• px 8)
    (= font-size 12)
    (= align-y (. Alignment center))
  )
  (blank)
  (rule quake-card (• glass-panel) (• absolute) (• p 14)
    (= motion gui-motion-smooth)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 0 12))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
    )
  )
  (blank)
  (rule quake-card-title (• text gui-strong-text-color)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule quake-card-line (• text gui-muted-text-color) (• mt 4))
)

(style QuakesLightTheme (is QuakesTheme) (for light)
  (prop + quake-space-color _ (= (call RGBA "#dfe4ea")))
  (prop + quake-ocean-color _ (= (call RGBA "#c7d6e3")))
  (prop + quake-land-color _ (= (call RGBA "#f4f2ec")))
  (prop + quake-grid-color _ (= (call RGBA "#00000012")))
)
