<App
    <StaticResizeScaleWindow • scale-shell flex-col p:14
        title = "Yumi GUI: Static Resize Scale Stress"
        size = (1360, 860)
        use-metal = false

        ` This scene deliberately matches City Pulse's physical scale without scheduling work:
        ` 1,000 painted cells, 480 retained row boxes, and 480 retained row labels.
        <Box • scale-header flex-row h:72 px:18 py:10
            <Box • flex-col flex:1
                <Label • scale-title
                    text = "Static Layout Scale · Resize Stress"

                <Label • scale-subtitle mt:4
                    text = "1,000 cells · 480 rows + labels · zero timers or mutations"

            <Box • scale-header-tags flow-row
                <StaticScalePill "CORE GRAPHICS"
                <StaticScalePill "STATIC" • ml:7
                <StaticScalePill "2,000+ BOXES" • ml:7

        <Box • flex-row h:92 mt:12
            <StaticScaleStatCard "cells"
            <StaticScaleStatCard "rows" • ml:10
            <StaticScaleStatCard "labels" • ml:10
            <StaticScaleStatCard "work" • ml:10

        ` This split mirrors City Pulse: a flexible map panel beside a fixed-width feed panel.
        <Box • flex-row flex:1 mt:12
            <Box • scale-panel flex-col flex:1 p:12
                <Box • flex-row h:40
                    <Box • flex-col flex:1
                        <Label • scale-kicker
                            text = "FIXED CELL MATRIX"

                        <Label • scale-panel-title mt:3
                            text = "40 × 25 physical cells inside flexible ancestors"

                    <StaticScalePill "1,025 GRID NODES"

                <Box • scale-stage flex-col flex:1 mt:10 p:10
                    <StaticScaleGrid • w:600 h:375

                    <Box • flow-row mt:10
                        <StaticScaleDistrict "NORTH"
                        <StaticScaleDistrict "HARBOR" • ml:6
                        <StaticScaleDistrict "MARKET" • ml:6
                        <StaticScaleDistrict "CIVIC" • ml:6
                        <StaticScaleDistrict "UNION" • ml:6
                        <StaticScaleDistrict "SOMA" • ml:6
                        <StaticScaleDistrict "MISSION" • ml:6
                        <StaticScaleDistrict "SUNSET" • ml:6
                        <StaticScaleDistrict "NORTH" • ml:6
                        <StaticScaleDistrict "HARBOR" • ml:6
                        <StaticScaleDistrict "MARKET" • ml:6
                        <StaticScaleDistrict "CIVIC" • ml:6

            ` Moving this fixed panel during horizontal resize moves its entire 960-node feed.
            <Box • scale-panel flex-col w:432 ml:12 p:12
                <Box • flex-row h:40
                    <Box • flex-col flex:1
                        <Label • scale-kicker
                            text = "PHYSICAL INCIDENT FEED"

                        <Label • scale-panel-title mt:3
                            text = "480 row boxes · 480 retained text labels"

                    <StaticScalePill "960 FEED NODES"

                <Box • scale-filter flex-row h:29 mt:9 px:9
                    <Label • scale-filter-copy flex:1
                        text = "Static filter chrome with intrinsic text"

                    <StaticScalePill "NO INPUT"

                <Box • scale-feed-note flex-row h:25 mt:7 px:8
                    <Label • scale-feed-note-text flex:1
                        text = "No scroll, animation, mutation, or scheduled render work"

                <StaticScaleFeed • scale-feed flex:1 mt:9

        <Box • scale-footer flex-row h:48 mt:12 px:12 py:8
            <Box • flow-row flex:1
                <StaticScalePill "STATIC"
                <StaticScalePill "NO TIMERS" • ml:7
                <StaticScalePill "NO MUTATIONS" • ml:7
                <StaticScalePill "NO AUTO-SCROLL" • ml:7

            <Label • scale-footer-copy
                text = "Resize continuously across both axes"

━━━━━━━━━━━━━━━━━━━━
• StaticResizeScaleTheme
    using GUIDefaultTheme
    using GUIBoxPaint
    using GUITextPaint
