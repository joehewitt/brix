+ StaticScaleStatCard is Box

+ kind String
+ title => static-scale-stat-title(kind)
+ value => static-scale-stat-value(kind)

────────────────────
+ This
    - kind

────────────────────

<This • scale-stat-card flex-row flex:1 p:12
    <Box • flex-col w:155
        <Label • scale-stat-title
            text = title

        <Label • scale-stat-value mt:6
            text = value

    <Box • flex-col flex:1 ml:10
        <Box • flex:1
        <Box • scale-stat-bar flex-row h:14
            <Box • scale-stat-fill-a flex:3
            <Box • scale-stat-fill-b flex:2
            <Box • scale-stat-fill-c flex:1

━━━━━━━━━━━━━━━━━━━━
+ StaticScaleGrid is Box

• This
    layout = flow-col

────────────────────
+ This

for row-index in 0 .. < 25
    . row = StaticScaleGridRow()
    markup-append(this, row)
    for column-index in 0 .. < 40
        . index = row-index * 40 + column-index
        markup-append(row, StaticScaleCell(index))

