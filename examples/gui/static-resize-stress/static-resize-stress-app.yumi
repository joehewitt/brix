for index in 0 .. < 480
    markup-append(this, StaticScaleFeedRow(index))

━━━━━━━━━━━━━━━━━━━━
+ StaticScaleFeedRow is Box

+ index Size

• This • h:18

────────────────────
+ This
    - index

markup-append(this, StaticScaleFeedText(index))

────────────────────
+ do paint-background
    - canvas Canvas

canvas.push()
canvas.fill-color = static-scale-feed-color(index)
canvas.stroke-color = null
canvas.rect(bounds)
canvas.pop()

━━━━━━━━━━━━━━━━━━━━
+ StaticScaleFeedText is Label

• This • scale-feed-text absolute cover:.parent px:5

────────────────────
+ This
    - index Size

. id = 10000 + index
. category = static-scale-category(index)
. district = static-scale-district(index)
. unit = 10 + index % 89
text = "#$id  $category · $district · unit $unit"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-cell-color RGBA
    - index Size

match (index * 17) % 9
    | 0
        "#0e7490"
    | 1
        "#0891b2"
    | 2
        "#0284c7"
    | 3
        "#2563eb"
    | 4
        "#4f46e5"
    | 5
        "#7c3aed"
    | 6
        "#c026d3"
    | 7
        "#e11d48"
    ??
        "#f97316"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-feed-color RGBA
    - index Size

match index % 5
    | 0
        "#172554"
    | 1
        "#134e4a"
    | 2
        "#3f1d42"
    | 3
        "#3b2f12"
    ??
        "#1e293b"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-category String
    - index Size

match index % 5
    | 0
        "FIRE"
    | 1
        "MEDICAL"
    | 2
        "TRAFFIC"
    | 3
        "TRANSIT"
    ??
        "UTILITY"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-district String
    - index Size

match index % 8
    | 0
        "North"
    | 1
        "Harbor"
    | 2
        "Market"
    | 3
        "Civic"
    | 4
        "Union"
    | 5
        "SOMA"
    | 6
        "Mission"
    ??
        "Sunset"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-stat-title String
    - kind String

match kind
    | "cells"
        "CELLS"
    | "rows"
        "ROW BOXES"
    | "labels"
        "ROW LABELS"
    ??
        "FRAME WORK"

━━━━━━━━━━━━━━━━━━━━
_ static-scale-stat-value String
    - kind String

match kind
    | "cells"
        "1,000"
    | "rows"
        "480"
    | "labels"
        "480"
    ??
        "RESIZE ONLY"
