(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop + cell-width _ (= 142.0))
(prop + cell-height _ (= 142.0))
(prop + field-margin _ (= 140.0))
(prop _ garden-aspect _ (= 1.58))
(prop _ gust-lifetime _ (= 4.5))
(prop _ gust-speed _ (= 480.0))
(prop _ gust-band _ (= 260.0))
(prop _ max-gusts _ (= 6))

(type + MotionMode (is Union)
  (variant transforms)
  (variant deform)
  (fn-expr + title String :get
    (match this
      (case .transforms
        "Transforms"
      )
      (default
        "Deform"
      )
    )
  )
)

(type + PaintTier (is Union)
  (variant fills)
  (variant strokes)
  (variant gradients)
  (variant effects)
  (fn-expr + title String :get
    (match this
      (case .fills
        "Fills"
      )
      (case .strokes
        "+ Strokes"
      )
      (case .gradients
        "+ Gradients"
      )
      (default
        "+ Clips & FX"
      )
    )
  )
  (fn-expr + has-strokes Bool :get
    (!= this (. PaintTier fills))
  )
  (fn-expr + has-gradients Bool :get
    (or (== this (. PaintTier gradients)) (== this (. PaintTier effects)))
  )
  (fn-expr + has-effects Bool :get
    (== this (. PaintTier effects))
  )
)

(type + SpecimenKind (is Union)
  (variant fern)
  (variant vine)
  (variant pod)
  (variant blossom)
)

(type + Specimen (is Tuple)
  (prop + index Int)
  (prop + kind SpecimenKind)
  (prop + x F64)
  (prop + y F64)
  (prop + scale F64)
  (prop + angle F64)
  (prop + palette Int)
  (prop + phase F64)
  (prop + leaflets Int)
  (prop + variant-id Int)
  (prop + is-animated Bool)
)

(type + Pollinator (is Tuple)
  (prop + index Int)
  (prop + home-x F64)
  (prop + home-y F64)
  (prop + radius-x F64)
  (prop + radius-y F64)
  (prop + speed F64)
  (prop + phase F64)
  (prop + scale F64)
  (prop + palette Int)
)

(type + WindGust (is Tuple)
  (prop + origin Point)
  (prop + born F64)
  (prop + strength F64)
)

(type + WindOffset (is Tuple)
  (prop + x F64)
  (prop + y F64)
)

(type + SceneCounts (is Tuple)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
)

(type + HerbariumField
  (prop + specimen-count Int)
  (prop + animated-share Int)
  (prop + columns Int)
  (prop + rows Int)
  (prop + extent Dimensions)
  (prop + specimens (list Specimen))
  (prop + pollinators (list Pollinator))
  (prop + animated-count Int)
  (fn-do + This _
    (param count Int)
    (param share Int)
    (= specimen-count count)
    (= animated-share share)
    (= columns (call garden-columns count))
    (= rows (/ (+ count (- columns 1)) columns))
    (= extent (call garden-size count))
    (let inner-w (- (. extent width) (* field-margin 2)))
    (let inner-h (- (. extent height) (* field-margin 2) 48.0))
    (let ferns (call (of List Specimen)))
    (let vines (call (of List Specimen)))
    (let pods (call (of List Specimen)))
    (let blossoms (call (of List Specimen)))
    (let total-animated 0)
    (for (in index (..< 0 count))
      (let col (% index columns))
      (let row (/ index columns))
      (let row-items (if-expr (== row (- rows 1)) (call max 1 (- count (* row columns))) columns))
      (let base-x (+ field-margin (* (/ (+ (as col F64) 0.5) (as row-items F64)) inner-w)))
      (let base-y (+ field-margin 48.0 (* (+ (as row F64) 0.5) cell-height)))
      (let jx (* (- (call hash-unit (+ (* index 17) 3)) 0.5) cell-width 0.96))
      (let jy (* (- (call hash-unit (+ (* index 31) 11)) 0.5) cell-height 0.96))
      (let drift-x (* (call sin (+ (* (as row F64) 0.58) (* (as col F64) 0.27))) cell-width 0.34))
      (let drift-y (* (call cos (+ (* (as col F64) 0.53) (* (as row F64) 0.23))) cell-height 0.34))
      (let px (call clamp (+ base-x jx drift-x) (+ field-margin 20.0) (+ field-margin inner-w -20.0)))
      (let py (call clamp (+ base-y jy drift-y) (+ field-margin 68.0) (+ field-margin 48.0 inner-h -20.0)))
      (let kind (call pick-specimen-kind index))
      (let scale (+ 0.92 (* 0.62 (call hash-unit (+ (* index 43) 7)))))
      (let angle (* (- (call hash-unit (+ (* index 59) 19)) 0.5) 1.15))
      (let palette (call pick-palette kind index))
      (let phase (* (call hash-unit (+ (* index 73) 29)) 2 π))
      (let leaflets (+ 7 (% (+ index (/ index 5)) 4)))
      (let variant-id (% (+ (* index 11) (/ index 3)) 3))
      (let moving (call specimen-is-animated index share))
      (if moving
        (+= total-animated 1)
      )
      (let entry (call Specimen index kind px py scale angle palette phase leaflets variant-id moving))
      (match kind
        (case .fern
          (+= ferns entry)
        )
        (case .vine
          (+= vines entry)
        )
        (case .pod
          (+= pods entry)
        )
        (default
          (+= blossoms entry)
        )
      )
    )
    (for (in item ferns)
      (+= specimens item)
    )
    (for (in item vines)
      (+= specimens item)
    )
    (for (in item pods)
      (+= specimens item)
    )
    (for (in item blossoms)
      (+= specimens item)
    )
    (= animated-count total-animated)
    (let moth-count (if-expr (== share 0) 0 (call clamp (/ count 18) 12 160)))
    (for (in idx (..< 0 moth-count))
      (let rx (call min (* inner-w 0.22) (+ 160.0 (* 280.0 (call hash-unit (+ (* idx 131) 17))))))
      (let ry (call min (* inner-h 0.22) (+ 140.0 (* 220.0 (call hash-unit (+ (* idx 149) 23))))))
      (let home-x (+ field-margin rx (* (call hash-unit (+ (* idx 89) 101)) (call max 10.0 (- inner-w (* rx 2))))))
      (let home-y (+ field-margin 56.0 ry (* (call hash-unit (+ (* idx 113) 211)) (call max 10.0 (- inner-h (* ry 2))))))
      (let speed (+ 0.14 (* 0.2 (call hash-unit (+ (* idx 167) 41)))))
      (let phase (* (call hash-unit (+ (* idx 191) 53)) 2 π))
      (let scale (+ 0.85 (* 0.55 (call hash-unit (+ (* idx 223) 71)))))
      (let palette (+ 5 (% idx 7)))
      (+= pollinators (call Pollinator idx home-x home-y rx ry speed phase scale palette))
    )
  )
  (fn-do + visible-specimens Int
    (param world Rect)
    (let pad 190.0)
    (let min-x (- (. world x) pad))
    (let max-x (+ (. world x) (. world width) pad))
    (let min-y (- (. world y) pad))
    (let max-y (+ (. world y) (. world height) pad))
    (let shown 0)
    (for (in item specimens)
      (if (and (>= (. item x) min-x) (<= (. item x) max-x) (>= (. item y) min-y) (<= (. item y) max-y))
        (+= shown 1)
      )
    )
    (return shown)
  )
)

(type + GustField
  (prop + gusts (list WindGust))
  (fn-do + spawn _
    (param origin Point)
    (param clock F64)
    (+= gusts (call WindGust origin clock 1.0))
    (while (> (. gusts length) max-gusts)
      (call (. gusts remove) 0)
    )
  )
  (fn-do + prune _
    (param clock F64)
    (let index 0)
    (while (< index (. gusts length))
      (if (> (- clock (. ([] gusts index) born)) gust-lifetime)
        (call (. gusts remove) index)
        (else
          (+= index 1)
        )
      )
    )
  )
)

(fn-expr + hash-unit F64
  (param seed Int)
  (- value (call floor value))
  (where
    (lazy value (* (call sin (* (as seed F64) 12.9898)) 43758.5453))
  )
)

(fn-expr + garden-columns Int
  (param count Int)
  (call max 1 (as (call ceil (call sqrt (* (as count F64) garden-aspect))) Int))
)

(fn-expr + garden-size Dimensions
  (param count Int)
  (call Dimensions (+ (* (as columns F64) cell-width) (* field-margin 2)) (+ (* (as rows F64) cell-height) (* field-margin 2) 48.0))
  (where
    (lazy columns (call garden-columns count))
    (lazy rows (/ (+ count (- columns 1)) columns))
  )
)

(fn-expr _ pick-specimen-kind SpecimenKind
  (param index Int)
  (if-expr (< roll 0.34)
    (. SpecimenKind fern)
    (if-expr (< roll 0.58)
      (. SpecimenKind vine)
      (if-expr (< roll 0.74)
        (. SpecimenKind pod)
        (. SpecimenKind blossom)
      )
    )
  )
  (where
    (lazy roll (call hash-unit (+ (* index 97) 13)))
  )
)

(fn-expr _ pick-palette Int
  (param kind SpecimenKind)
  (param index Int)
  (match kind
    (case .fern
      (% (+ (* index 3) (/ index 5)) 5)
    )
    (case .vine
      (% (+ (* index 7) 1) 5)
    )
    (case .pod
      (+ 4 (% (+ (* index 5) (/ index 3)) 4))
    )
    (default
      (+ 5 (% (+ (* index 5) (/ index 2)) 7))
    )
  )
)

(fn-expr _ specimen-is-animated Bool
  (param index Int)
  (param share Int)
  (if-expr (<= share 0)
    false
    (if-expr (>= share 100)
      true
      (< (% (* index 37) 100) share)
    )
  )
)

(fn-do + wind-at WindOffset
  (param x F64)
  (param y F64)
  (param phase F64)
  (param clock F64)
  (param gusts (list WindGust))
  (let wave (+ (* clock 1.55) (* x 0.0022) (* y 0.0016) phase))
  (let secondary (+ (* clock 2.6) (* x 0.0039) (- (* y 0.0031)) (* phase 0.5)))
  (let wx (+ (* (call sin wave) 16.0) (* (call cos secondary) 5.5)))
  (let wy (+ (* (call cos (* wave 0.82)) 6.5) (* (call sin secondary) 3.0)))
  (for (in gust gusts)
    (let age (- clock (. gust born)))
    (if (and (>= age 0) (< age gust-lifetime))
      (let dx (- x (as (. gust origin x) F64)))
      (let dy (- y (as (. gust origin y) F64)))
      (let dist (call sqrt (+ (* dx dx) (* dy dy) 1.0)))
      (let front (* age gust-speed))
      (let delta (/ (- dist front) gust-band))
      (let envelope (* (call exp (* (- delta) delta)) (- 1.0 (/ age gust-lifetime))))
      (let push (* envelope (. gust strength) 56.0))
      (+= wx (* (/ dx dist) push))
      (+= wy (* (/ dy dist) push))
    )
  )
  (return (call WindOffset wx wy))
)
