  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan petal fill-paint stroke-paint (only-if 1.8 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (return (call VectorGeometry (call Rect -10 -50 120 100) (call Rect -16 -56 132 112) spans false false))
)

(fn-do _ core-geometry VectorGeometry
  (let outline (call Path))
  (let r 44.0)
  (let k (* r 0.5522847498307936))
  (call (. outline move-to) r 0)
  (call (. outline cubic-curve-to) r k k r 0 r)
  (call (. outline cubic-curve-to) (- k) r (- r) k (- r) 0)
  (call (. outline cubic-curve-to) (- r) (- k) (- k) (- r) 0 (- r))
  (call (. outline cubic-curve-to) k (- r) r (- k) r 0)
  (call (. outline close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let stroke-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (return (call VectorGeometry (call Rect -50 -50 100 100) (call Rect -56 -56 112 112) (list (call VectorGeometrySpan outline fill-paint stroke-paint 4.0 (. LineCap round) (. LineJoin round) (. FillRule nonzero))) false false))
)

(fn-do _ vine-leaf-geometry VectorGeometry
  (param stroked Bool)
  (let leaf (call Path))
  (call (. leaf move-to) 0 0)
  (call (. leaf cubic-curve-to) -22 -42 8 -62 36 -54)
  (call (. leaf cubic-curve-to) 68 -44 88 -16 100 0)
  (call (. leaf cubic-curve-to) 88 16 68 44 36 54)
  (call (. leaf cubic-curve-to) 8 62 -22 42 0 0)
  (call (. leaf close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
