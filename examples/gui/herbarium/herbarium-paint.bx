  (return (call VectorGeometry (call Rect -44 -106 88 112) (call Rect -50 -112 100 124) spans false false))
)

(fn-do _ moth-geometry VectorGeometry
  (param stroked Bool)
  (let wings (call Path))
  (call (. wings move-to) 0 0)
  (call (. wings cubic-curve-to) -44 -58 -92 -24 -64 10)
  (call (. wings cubic-curve-to) -68 46 -34 74 -18 52)
  (call (. wings cubic-curve-to) -10 26 -4 12 0 0)
  (call (. wings close))
  (call (. wings move-to) 0 0)
  (call (. wings cubic-curve-to) 44 -58 92 -24 64 10)
  (call (. wings cubic-curve-to) 68 46 34 74 18 52)
  (call (. wings cubic-curve-to) 10 26 4 12 0 0)
  (call (. wings close))
  (let spots (call Path))
  (call (. spots move-to) -42 -12)
  (call (. spots cubic-curve-to) -42 -20 -30 -20 -30 -12)
  (call (. spots cubic-curve-to) -30 -4 -42 -4 -42 -12)
  (call (. spots close))
  (call (. spots move-to) 42 -12)
  (call (. spots cubic-curve-to) 42 -20 30 -20 30 -12)
  (call (. spots cubic-curve-to) 30 -4 42 -4 42 -12)
  (call (. spots close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let spot-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans
    (list
      (call VectorGeometrySpan wings fill-paint stroke-paint (only-if 2.4 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))
      (call VectorGeometrySpan spots spot-paint none-paint null null null (. FillRule nonzero))
    )
  )
  (return (call VectorGeometry (call Rect -96 -62 192 140) (call Rect -102 -68 204 152) spans false false))
)
