  (let spans (list (call VectorGeometrySpan leaf fill-paint stroke-paint (only-if 2.0 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (if stroked
    (let rib (call Path))
    (call (. rib move-to) 4 0)
