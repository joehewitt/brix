(import ./herbarium-scene)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /math)
(import /units)
(blank)
(prop _ plate-paper _ (= (call RGBA "#f3ece0")))
(prop _ plate-paper-inner _ (= (call RGBA "#f7f1e6")))
(prop _ plate-border-outer _ (= (call RGBA "#9c8f78")))
(prop _ plate-border-inner _ (= (call RGBA "#c9bda6")))
(prop _ plate-ink _ (= (call RGBA "#3c352a")))
(prop _ plate-muted _ (= (call RGBA "#786e5c")))
(prop _ ink-outline _ (= (call RGBA "#2a2821b8")))
(prop _ calyx-green _ (= (call RGBA "#2f5741")))
(prop _ stamen-dark _ (= (call RGBA "#33261d")))
(prop _ pollen-gold _ (= (call RGBA "#e3b341")))
(prop _ berry-crimson _ (= (call RGBA "#b83b36")))
(prop _ specimen-shadow _ (= (call Shadow (call RGBA "#2b241840") 10 4 6 0)))

(type + BotanicalPalette (is Tuple)
  (prop + deep RGBA)
  (prop + mid RGBA)
  (prop + light RGBA)
  (prop + wash RGBA)
  (prop + stem RGBA)
  (prop + vein RGBA)
  (prop + accent RGBA)
  (prop + leaf-stops (list GradientStop) (= (call (of List GradientStop))))
  (prop + outer-petal-stops (list GradientStop) (= (call (of List GradientStop))))
  (prop + inner-petal-stops (list GradientStop) (= (call (of List GradientStop))))
  (prop + pod-stops (list GradientStop) (= (call (of List GradientStop))))
)

(prop _ botanical-palettes _
  (=
    (list
      (call BotanicalPalette (call RGBA "#1c4a38") (call RGBA "#2e6b50") (call RGBA "#68a37c") (call RGBA "#2e6b50b5") (call RGBA "#284c3a") (call RGBA "#173326b0") (call RGBA "#c4a34f"))
      (call BotanicalPalette (call RGBA "#2b593c") (call RGBA "#4a7d52") (call RGBA "#8ab376") (call RGBA "#4a7d52b5") (call RGBA "#335437") (call RGBA "#1f3d26b0") (call RGBA "#d6ae54"))
      (call BotanicalPalette (call RGBA "#1d4e52") (call RGBA "#2e7575") (call RGBA "#6caea8") (call RGBA "#2e7575b5") (call RGBA "#245452") (call RGBA "#143838b0") (call RGBA "#d99e4e"))
      (call BotanicalPalette (call RGBA "#47592c") (call RGBA "#6c8241") (call RGBA "#a3b567") (call RGBA "#6c8241b5") (call RGBA "#44522a") (call RGBA "#2e3b1cb0") (call RGBA "#cf9842"))
      (call BotanicalPalette (call RGBA "#3b5946") (call RGBA "#5e856c") (call RGBA "#9ac2a5") (call RGBA "#5e856cb5") (call RGBA "#355240") (call RGBA "#223b2cb0") (call RGBA "#c9744d"))
      (call BotanicalPalette (call RGBA "#9c2d29") (call RGBA "#cc4b3e") (call RGBA "#f09986") (call RGBA "#cc4b3eb8") (call RGBA "#2d573e") (call RGBA "#611c19a8") (call RGBA "#f0c659"))
      (call BotanicalPalette (call RGBA "#a8442a") (call RGBA "#d96c3e") (call RGBA "#f5b084") (call RGBA "#d96c3eb8") (call RGBA "#365c3e") (call RGBA "#692818a8") (call RGBA "#f5d36e"))
      (call BotanicalPalette (call RGBA "#a8701d") (call RGBA "#d99d32") (call RGBA "#f5d57d") (call RGBA "#d99d32b8") (call RGBA "#33593a") (call RGBA "#6e4612a8") (call RGBA "#a8382e"))
      (call BotanicalPalette (call RGBA "#8c3552") (call RGBA "#c25777") (call RGBA "#eb9eb4") (call RGBA "#c25777b8") (call RGBA "#2f5741") (call RGBA "#571f32a8") (call RGBA "#f2cb66"))
      (call BotanicalPalette (call RGBA "#5c366b") (call RGBA "#8c579c") (call RGBA "#c89cd6") (call RGBA "#8c579cb8") (call RGBA "#2c5442") (call RGBA "#3a1f45a8") (call RGBA "#ebc059"))
      (call BotanicalPalette (call RGBA "#24496e") (call RGBA "#3e74a3") (call RGBA "#8ab8db") (call RGBA "#3e74a3b8") (call RGBA "#295443") (call RGBA "#16304aa8") (call RGBA "#f0c456"))
      (call BotanicalPalette (call RGBA "#9c7c52") (call RGBA "#d4b68c") (call RGBA "#f5e6cc") (call RGBA "#d4b68cc0") (call RGBA "#3b593c") (call RGBA "#634c31a8") (call RGBA "#c9533c"))
    )
  )
)

(type + BotanicalKit
  (prop + palettes (list BotanicalPalette))
  (prop + leaf-palettes (list (list RGBA)))
  (prop + petal-palettes (list (list RGBA)))
  (prop + inner-petal-palettes (list (list RGBA)))
  (prop + pod-palettes (list (list RGBA)))
  (prop + moth-palettes (list (list RGBA)))
  (prop + plate-title TextLayout)
  (prop + plate-subtitle TextLayout)
  (prop + fern-blade VectorGeometryHandle)
  (prop + fern-blade-veined VectorGeometryHandle)
  (prop + blossom-petal VectorGeometryHandle)
  (prop + blossom-petal-veined VectorGeometryHandle)
  (prop + blossom-core VectorGeometryHandle)
  (prop + vine-leaf VectorGeometryHandle)
  (prop + vine-leaf-veined VectorGeometryHandle)
  (prop + seed-capsule VectorGeometryHandle)
  (prop + seed-capsule-veined VectorGeometryHandle)
  (prop + moth-wings VectorGeometryHandle)
  (prop + moth-wings-veined VectorGeometryHandle)
  (fn-do + This _
    (param table VectorGeometryTable)
    (for (in entry botanical-palettes)
      (let with-stops
        (call BotanicalPalette
          (block
            (arg (. entry deep))
            (arg (. entry mid))
            (arg (. entry light))
            (arg (. entry wash))
            (arg (. entry stem))
            (arg (. entry vein))
            (arg (. entry accent))
            (arg (list (call GradientStop 0%% (. entry deep)) (call GradientStop 1%% (. entry light))))
            (arg (list (call GradientStop 0%% (. entry deep)) (call GradientStop 1%% (. entry mid))))
            (arg (list (call GradientStop 0%% (. entry mid)) (call GradientStop 1%% (. entry light))))
            (arg (list (call GradientStop 0%% (. entry deep)) (call GradientStop 1%% (. entry accent))))
          )
        )
      )
      (+= palettes with-stops)
      (+= leaf-palettes (list (. entry mid) (. entry vein) (. entry light)))
      (+= petal-palettes (list (. entry mid) (. entry vein) (. entry deep)))
      (+= inner-petal-palettes (list (. entry light) (. entry vein) (. entry accent)))
      (+= pod-palettes (list (. entry mid) (. entry vein) (. entry accent)))
      (+= moth-palettes (list (. entry light) (. entry deep) (. entry accent)))
    )
    (= plate-title (call TextLayout "HERBARIUM VIVUM  ·  ATLAS BOTANICA" (call Font "Georgia" 24 (. FontWeight bold)) 680))
    (= plate-subtitle (call TextLayout "PL. IV  —  PTERIDOPHYTA, ANTHOPHYTA & LEPIDOPTERA" (call Font "Georgia" 12) 680))
    (= fern-blade (call (. table intern-geometry) (as 941101 U64) (=> () (call fern-blade-geometry false))))
    (= fern-blade-veined (call (. table intern-geometry) (as 941102 U64) (=> () (call fern-blade-geometry true))))
    (= blossom-petal (call (. table intern-geometry) (as 941103 U64) (=> () (call petal-geometry false))))
    (= blossom-petal-veined (call (. table intern-geometry) (as 941104 U64) (=> () (call petal-geometry true))))
    (= blossom-core (call (. table intern-geometry) (as 941105 U64) (=> () (call core-geometry))))
    (= vine-leaf (call (. table intern-geometry) (as 941106 U64) (=> () (call vine-leaf-geometry false))))
    (= vine-leaf-veined (call (. table intern-geometry) (as 941107 U64) (=> () (call vine-leaf-geometry true))))
    (= seed-capsule (call (. table intern-geometry) (as 941108 U64) (=> () (call seed-capsule-geometry false))))
    (= seed-capsule-veined (call (. table intern-geometry) (as 941109 U64) (=> () (call seed-capsule-geometry true))))
    (= moth-wings (call (. table intern-geometry) (as 941110 U64) (=> () (call moth-geometry false))))
    (= moth-wings-veined (call (. table intern-geometry) (as 941111 U64) (=> () (call moth-geometry true))))
  )
)

(type _ Tally
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (fn-do + record _
    (param segs Int)
    (param stroked Bool)
    (+= paths 1)
    (+= segments segs)
    (if stroked
      (+= strokes 1)
    )
  )
  (fn-expr + snapshot SceneCounts :get
    (call SceneCounts paths segments strokes)
  )
)

(fn-do + paint-plate _
  (param kit BotanicalKit)
  (param canvas Canvas)
  (param extent Dimensions)
  (let outer (call Rect 28 28 (- (. extent width) 56) (- (. extent height) 56)))
  (= (. canvas fill-color) plate-paper)
  (= (. canvas stroke-color) plate-border-outer)
  (= (. canvas stroke-width) 2.5)
  (call (. canvas outline) (call Outline outer 10))
  (let inner (call (. outer pad) 18))
  (= (. canvas fill-color) plate-paper-inner)
  (= (. canvas stroke-color) plate-border-inner)
  (= (. canvas stroke-width) 1.2)
  (call (. canvas outline) (call Outline inner 4))
  (let frame (call (. inner pad) 8))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) plate-border-outer)
  (= (. canvas stroke-width) 0.9)
  (call (. canvas outline) (call Outline frame 2))
  (= (. canvas text-color) plate-ink)
  (call (. canvas draw-text) (. kit plate-title) (call Rect (- (/ (. extent width) 2) 340) 64 680 30) (. TextAlignment center))
  (= (. canvas text-color) plate-muted)
  (call (. canvas draw-text) (. kit plate-subtitle) (call Rect (- (/ (. extent width) 2) 340) 96 680 18) (. TextAlignment center))
  (= (. canvas stroke-color) plate-border-inner)
  (= (. canvas stroke-width) 1.0)
  (call (. canvas line) (- (/ (. extent width) 2) 220) 118 (+ (/ (. extent width) 2) 220) 118)
  (= (. canvas stroke-color) null)
)

(fn-do + paint-herbarium-layer SceneCounts
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field HerbariumField)
  (param clock F64)
  (param gusts (list WindGust))
  (param motion MotionMode)
  (param tier PaintTier)
  (param include-static Bool)
  (param include-animated Bool)
  (let tally (call Tally))
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-join) (. LineJoin round))
  (= (. canvas stroke-dash) 0)
  (if include-static
    (call paint-plate kit canvas (. field extent))
  )
  (for (in specimen (. field specimens))
    (let wants (if-expr (. specimen is-animated) include-animated include-static))
    (if wants
      (let sway
        (if-expr (. specimen is-animated)
          (call wind-at (. specimen x) (. specimen y) (. specimen phase) clock gusts)
          (call WindOffset 0 0)
        )
      )
      (if (== motion (. MotionMode transforms))
        (call paint-specimen-instanced kit table canvas specimen sway clock tier tally)
        (else
          (call paint-specimen-deformed kit canvas specimen sway clock tier tally)
        )
      )
    )
  )
  (if include-animated
    (for (in moth (. field pollinators))
      (call paint-pollinator kit table canvas moth clock motion tier tally)
    )
  )
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-dash) 0)
  (= (. canvas blend-mode) (. BlendMode normal))
  (return (. tally snapshot))
)

(fn-do _ paint-specimen-deformed _
  (param kit BotanicalKit)
  (param canvas Canvas)
  (param specimen Specimen)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let palette ([] (. kit palettes) (. specimen palette)))
  (match (. specimen kind)
    (case .fern
      (call paint-fern-deformed canvas specimen palette sway tier tally)
    )
    (case .blossom
      (call paint-blossom-deformed canvas specimen palette sway clock tier tally)
    )
    (case .vine
      (call paint-vine-deformed canvas specimen palette sway tier tally)
    )
    (default
      (call paint-pod-deformed canvas specimen palette sway clock tier tally)
    )
  )
)

(fn-do _ paint-specimen-instanced _
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param specimen Specimen)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let palette ([] (. kit palettes) (. specimen palette)))
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let bend (* (. sway x) 0.01))
  (let base-angle (+ (. specimen angle) bend))
  (let has-strokes (. tier has-strokes))
  (let has-effects (. tier has-effects))
  (let leaf-pal ([] (. kit leaf-palettes) (. specimen palette)))
  (let petal-pal ([] (. kit petal-palettes) (. specimen palette)))
  (let inner-pal ([] (. kit inner-petal-palettes) (. specimen palette)))
  (let pod-pal ([] (. kit pod-palettes) (. specimen palette)))
  (match (. specimen kind)
    (case .fern
      (let fronds (if-expr (== (. specimen variant-id) 0) 2 1))
      (for (in f (..< 0 fronds))
        (let fan (if-expr (== fronds 2) (if-expr (== f 0) -0.34 0.34) 0.0))
        (let fa (+ base-angle fan))
        (let stem-len (* (if-expr (== f 0) 152.0 124.0) s))
        (let dir-x (call sin fa))
        (let dir-y (- (call cos fa)))
        (let bx (- cx (* dir-x stem-len 0.42)))
        (let by (- cy (* dir-y stem-len 0.42)))
        (if has-strokes
          (= (. canvas fill-color) null)
          (= (. canvas stroke-color) (. palette stem))
          (= (. canvas stroke-width) (* 2.4 s))
          (call (. canvas begin))
          (call (. canvas move) bx by)
          (call (. canvas curve)
            (block
              (arg (+ bx (* dir-x stem-len 0.36) (* (. sway x) 0.28)))
              (arg (+ by (* dir-y stem-len 0.36) (* (. sway y) 0.28)))
              (arg (+ bx (* dir-x stem-len 0.72) (* (. sway x) 0.65)))
              (arg (+ by (* dir-y stem-len 0.72) (* (. sway y) 0.65)))
              (arg (+ bx (* dir-x stem-len) (. sway x)))
              (arg (+ by (* dir-y stem-len) (. sway y)))
            )
          )
          (call (. canvas end))
          (call (. tally record) 1 true)
        )
        (let shape (if-expr has-strokes (. kit fern-blade-veined) (. kit fern-blade)))
        (let stem-theta (- fa (/ π 2)))
        (let pairs (. specimen leaflets))
        (for (in step (..< 0 pairs))
          (let t (/ (+ (as step F64) 0.6) (+ (as pairs F64) 0.8)))
          (let env (call sin (* t π 0.92)))
          (let px (+ bx (* dir-x stem-len t) (* (. sway x) t t)))
          (let py (+ by (* dir-y stem-len t) (* (. sway y) t t)))
          (let leaf-s (* s (+ 0.16 (* env 0.36))))
          (let spread (- 1.12 (* t 0.38)))
          (let left-m (call stamp-matrix px py (- stem-theta spread) leaf-s leaf-s))
          (let right-m (call stamp-matrix px py (+ stem-theta spread) leaf-s (- leaf-s)))
          (let ignored-l (call (. table paint-vector) shape canvas leaf-pal left-m))
          (let ignored-r (call (. table paint-vector) shape canvas leaf-pal right-m))
          (call (. tally record) 3 has-strokes)
          (call (. tally record) 3 has-strokes)
        )
      )
    )
    (case .blossom
      (let head-x (+ cx (* (. sway x) 0.85)))
      (let head-y (+ cy (* (. sway y) 0.55) (* -18.0 s)))
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette stem))
        (= (. canvas stroke-width) (* 2.8 s))
        (call (. canvas begin))
        (call (. canvas move) cx (+ cy (* 78.0 s)))
        (call (. canvas curve) (+ cx (* 14.0 s) (* (. sway x) 0.2)) (+ cy (* 38.0 s)) (+ head-x (* -10.0 s)) (+ head-y (* 28.0 s)) head-x head-y)
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
      (let leaf-shape (if-expr has-strokes (. kit vine-leaf-veined) (. kit vine-leaf)))
      (let l1 (call stamp-matrix (+ cx (* 4.0 s)) (+ cy (* 36.0 s)) -2.35 (* s 0.34) (* s 0.34)))
      (let l2 (call stamp-matrix (+ cx (* 2.0 s)) (+ cy (* 22.0 s)) -0.78 (* s 0.3) (* s -0.3)))
      (let ig1 (call (. table paint-vector) leaf-shape canvas ([] (. kit leaf-palettes) 0) l1))
      (let ig2 (call (. table paint-vector) leaf-shape canvas ([] (. kit leaf-palettes) 1) l2))
      (call (. tally record) 4 has-strokes)
      (call (. tally record) 4 has-strokes)
      (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* clock 0.45) (. specimen phase)) (. specimen angle)))
      (let petals (+ 7 (% (. specimen variant-id) 2)))
      (let petal-shape (if-expr has-strokes (. kit blossom-petal-veined) (. kit blossom-petal)))
      (if has-effects
        (= (. canvas blend-mode) (. BlendMode multiply))
      )
      (for (in p (..< 0 petals))
        (let theta (+ spin (* (as p F64) (/ (* 2 π) (as petals F64)))))
        (let m (call stamp-matrix head-x head-y theta (* s 0.54) (* s 0.54)))
        (let ignored (call (. table paint-vector) petal-shape canvas petal-pal m))
        (call (. tally record) 4 has-strokes)
      )
      (for (in p (..< 0 petals))
        (let theta (+ spin (/ π (as petals F64)) (* (as p F64) (/ (* 2 π) (as petals F64)))))
        (let m (call stamp-matrix head-x head-y theta (* s 0.36) (* s 0.36)))
        (let ignored (call (. table paint-vector) petal-shape canvas inner-pal m))
        (call (. tally record) 4 has-strokes)
      )
      (if has-effects
        (= (. canvas blend-mode) (. BlendMode normal))
      )
      (let core-m (call stamp-matrix head-x head-y (- spin) (* s 0.25) (* s 0.25)))
      (let ignored-c (call (. table paint-vector) (. kit blossom-core) canvas inner-pal core-m))
      (call (. tally record) 4 false)
    )
    (case .vine
      (let span (* 195.0 s))
      (let dx (* (call cos base-angle) span))
      (let dy (* (call sin base-angle) span))
      (let x0 (- cx (* dx 0.52)))
      (let y0 (- cy (* dy 0.52)))
      (let x3 (+ cx (* dx 0.52) (* (. sway x) 0.65)))
      (let y3 (+ cy (* dy 0.52) (* (. sway y) 0.65)))
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette stem))
        (= (. canvas stroke-width) (* 2.3 s))
        (call (. canvas begin))
        (call (. canvas move) x0 y0)
        (call (. canvas curve) (+ cx (- (* dy 0.36)) (* (. sway x) 0.3)) (+ cy (* dx 0.36) (* (. sway y) 0.3)) (+ cx (* dy 0.34) (* (. sway x) 0.5)) (+ cy (- (* dx 0.34)) (* (. sway y) 0.5)) x3 y3)
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
      (let leaf-shape (if-expr has-strokes (. kit vine-leaf-veined) (. kit vine-leaf)))
      (for (in k (..< 0 6))
        (let t (/ (+ (as k F64) 0.5) 6.0))
        (let side (if-expr (== (% k 2) 0) 1.0 -1.0))
        (let px (+ x0 (* (- x3 x0) t) (* (- dy) 0.14 (call sin (* t 2 π)))))
        (let py (+ y0 (* (- y3 y0) t) (* dx 0.14 (call sin (* t 2 π)))))
        (let theta (+ base-angle (* side 0.96) (* (. sway x) 0.008)))
        (let ls (* s (+ 0.28 (* 0.14 (call sin (* t π))))))
        (let m (call stamp-matrix px py theta ls ls))
        (let ignored (call (. table paint-vector) leaf-shape canvas leaf-pal m))
        (call (. tally record) 4 has-strokes)
      )
    )
    (default
      (let pod-shape (if-expr has-strokes (. kit seed-capsule-veined) (. kit seed-capsule)))
      (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* (call sin (+ (* clock 1.3) (. specimen phase))) 0.28)) (. specimen angle)))
      (for (in k (..< 0 5))
        (let spread (+ spin (* (- (as k F64) 2.0) 0.36)))
        (let reach (* (+ 54.0 (* (as (% k 2) F64) 22.0)) s))
        (let tip-x (+ cx (* (call sin spread) reach) (* (. sway x) 0.65)))
        (let tip-y (- (+ cy (* 48.0 s)) (* (call cos spread) reach) (- (* (. sway y) 0.45))))
        (if has-strokes
          (= (. canvas fill-color) null)
          (= (. canvas stroke-color) (. palette stem))
          (= (. canvas stroke-width) (* 1.8 s))
          (call (. canvas begin))
          (call (. canvas move) cx (+ cy (* 64.0 s)))
          (call (. canvas curve) cx (+ cy (* 22.0 s)) (+ cx (* (call sin spread) reach 0.52) (* (. sway x) 0.3)) (- (+ cy (* 26.0 s)) (* (call cos spread) reach 0.48)) tip-x tip-y)
          (call (. canvas end))
          (call (. tally record) 1 true)
        )
        (let m (call stamp-matrix tip-x tip-y (+ spread (* (. sway x) 0.009)) (* s 0.38) (* s 0.38)))
        (let ignored (call (. table paint-vector) pod-shape canvas pod-pal m))
        (call (. tally record) 4 has-strokes)
      )
    )
  )
)

(fn-do _ paint-fern-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let fronds (if-expr (== (. specimen variant-id) 0) 2 1))
  (for (in f (..< 0 fronds))
    (let fan (if-expr (== fronds 2) (if-expr (== f 0) -0.36 0.32) 0.0))
    (let len (* (if-expr (== f 0) 156.0 124.0) s))
    (call paint-single-frond canvas cx cy (+ (. specimen angle) fan) len s (. specimen leaflets) palette sway tier tally)
  )
)

(fn-do _ paint-single-frond _
  (param canvas Canvas)
  (param cx F64)
  (param cy F64)
  (param angle F64)
  (param len F64)
  (param s F64)
  (param pairs Int)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param tier PaintTier)
  (param tally Tally)
  (let dir-x (call sin angle))
  (let dir-y (- (call cos angle)))
  (let perp-x (- dir-y))
  (let perp-y dir-x)
  (let x0 (- cx (* dir-x len 0.44)))
  (let y0 (- cy (* dir-y len 0.44)))
  (let arch (* len 0.14))
  (let c1x (+ x0 (* dir-x len 0.34) (* perp-x arch 0.4) (* (. sway x) 0.25)))
  (let c1y (+ y0 (* dir-y len 0.34) (* perp-y arch 0.4) (* (. sway y) 0.25)))
  (let c2x (+ x0 (* dir-x len 0.72) (* perp-x arch) (* (. sway x) 0.68)))
  (let c2y (+ y0 (* dir-y len 0.72) (* perp-y arch) (* (. sway y) 0.68)))
  (let x3 (+ x0 (* dir-x len) (* perp-x arch 1.35) (* (. sway x) 1.15)))
  (let y3 (+ y0 (* dir-y len) (* perp-y arch 1.35) (* (. sway y) 1.15)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
  (let blade-sw (* (if-expr has-gradients 0.8 0.75) s))
  (let vein-sw (* 0.7 s))
  (for (in step (..< 0 pairs))
    (let t (/ (+ (as step F64) 0.65) (+ (as pairs F64) 0.9)))
    (let stem-pt (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 t))
    (let env (call sin (* (+ (* t 0.88) 0.08) π)))
    (let leaf-len (* s (+ 14.0 (* 40.0 env))))
    (let leaf-w (* leaf-len 0.26))
    (for (in dir-idx (..< 0 2))
      (let dir (if-expr (== dir-idx 0) -1.0 1.0))
      (let sweep (+ 0.48 (* t 0.28)))
      (let out-x (+ (* perp-x dir 0.85) (* dir-x sweep)))
      (let out-y (+ (* perp-y dir 0.85) (* dir-y sweep)))
      (let inv (call max 0.001 (call sqrt (+ (* out-x out-x) (* out-y out-y)))))
      (let ux (/ out-x inv))
      (let uy (/ out-y inv))
      (let lat-x (- uy))
      (let lat-y ux)
      (let tip-x (+ (. stem-pt x) (* ux leaf-len) (* (. sway x) t 0.26)))
      (let tip-y (+ (. stem-pt y) (* uy leaf-len) (* (. sway y) t 0.26)))
      (let fill-col (if-expr (== (% step 2) 0) (. palette mid) (. palette deep)))
      (if has-strokes
        (= (. canvas stroke-width) blade-sw)
      )
      (if has-gradients
        (let grad-end (call safe-gradient-end (. stem-pt x) (. stem-pt y) tip-x tip-y))
        (= (. canvas gradient-fill) (call LinearGradient (call Point (. stem-pt x) (. stem-pt y)) grad-end (. palette leaf-stops)))
        (call (. canvas begin))
        (call trace-leaf-blade canvas (. stem-pt x) (. stem-pt y) tip-x tip-y ux uy lat-x lat-y leaf-len leaf-w)
        (call (. canvas end) true)
        (else
          (= (. canvas fill-color) (if-expr has-effects (. palette wash) fill-col))
          (call (. canvas begin))
          (call trace-leaf-blade canvas (. stem-pt x) (. stem-pt y) tip-x tip-y ux uy lat-x lat-y leaf-len leaf-w)
          (call (. canvas end) true)
        )
      )
      (call (. tally record) 2 has-strokes)
      (if has-strokes
        (if has-gradients
          (= (. canvas gradient-fill) null)
        )
        (= (. canvas fill-color) null)
        (= (. canvas stroke-width) vein-sw)
        (call (. canvas begin))
        (call (. canvas move) (. stem-pt x) (. stem-pt y))
        (call (. canvas curve)
          (block
            (arg (+ (. stem-pt x) (* ux leaf-len 0.38)))
            (arg (+ (. stem-pt y) (* uy leaf-len 0.38)))
            (arg (+ (. stem-pt x) (* ux leaf-len 0.68) (* (. sway x) t 0.1)))
            (arg (+ (. stem-pt y) (* uy leaf-len 0.68) (* (. sway y) t 0.1)))
            (arg (+ (. stem-pt x) (* (- tip-x (. stem-pt x)) 0.85)))
            (arg (+ (. stem-pt y) (* (- tip-y (. stem-pt y)) 0.85)))
          )
        )
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
    )
  )
  (if has-gradients
    (= (. canvas gradient-fill) null)
  )
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 2.5 s))
    (call (. canvas begin))
    (call (. canvas move) x0 y0)
    (call (. canvas curve) c1x c1y c2x c2y x3 y3)
    (call (. canvas curve)
      (block
        (arg (+ x3 (* dir-x 16.0 s) (* perp-x 14.0 s)))
        (arg (+ y3 (* dir-y 16.0 s) (* perp-y 14.0 s)))
        (arg (+ x3 (* dir-x 2.0 s) (* perp-x 22.0 s)))
        (arg (+ y3 (* dir-y 2.0 s) (* perp-y 22.0 s)))
        (arg (+ x3 (* perp-x 9.0 s)))
        (arg (+ y3 (* perp-y 9.0 s)))
      )
    )
    (call (. canvas end))
    (call (. tally record) 2 true)
  )
)

(fn-do _ paint-blossom-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let base-x cx)
  (let base-y (+ cy (* 84.0 s)))
  (let head-x (+ cx (* (. sway x) 0.92)))
  (let head-y (+ (- cy (* 20.0 s)) (* (. sway y) 0.56)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (let stem-c1x (+ base-x (* 18.0 s) (* (. sway x) 0.25)))
  (let stem-c1y (- base-y (* 36.0 s)))
  (let stem-c2x (+ head-x (* -14.0 s)))
  (let stem-c2y (+ head-y (* 32.0 s)))
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 2.8 s))
    (call (. canvas begin))
    (call (. canvas move) base-x base-y)
    (call (. canvas curve) stem-c1x stem-c1y stem-c2x stem-c2y head-x head-y)
    (call (. canvas end))
    (call (. tally record) 1 true)
  )
  (for (in side-idx (..< 0 2))
    (let side (if-expr (== side-idx 0) -1.0 1.0))
    (let attach (call eval-cubic base-x base-y stem-c1x stem-c1y stem-c2x stem-c2y head-x head-y (if-expr (< side 0) 0.42 0.58)))
    (let lx (* side 0.84))
    (let ly -0.54)
    (let lpx (- ly))
    (let lpy lx)
    (let slen (* 36.0 s))
    (let sw (* 14.0 s))
    (let ltip-x (+ (. attach x) (* lx slen) (* (. sway x) 0.25)))
    (let ltip-y (+ (. attach y) (* ly slen) (* (. sway y) 0.25)))
    (= (. canvas fill-color) calyx-green)
    (= (. canvas stroke-color) (only-if ink-outline (if has-strokes)))
    (= (. canvas stroke-width) (* 0.85 s))
    (call (. canvas begin))
    (call trace-leaf-blade canvas (. attach x) (. attach y) ltip-x ltip-y lx ly lpx lpy slen sw)
    (call (. canvas end) true)
    (call (. tally record) 2 has-strokes)
  )
  (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* clock 0.38) (. specimen phase)) (. specimen angle)))
  (let breath (if-expr (. specimen is-animated) (+ 1.0 (* 0.06 (call sin (+ (* clock 2.0) (. specimen phase))))) 1.0))
  (let outer-len (* 52.0 s breath))
  (let outer-w (* 26.0 s))
  (let petals (+ 7 (% (. specimen variant-id) 2)))
  (if (and has-effects (== (. specimen variant-id) 0))
    (call (. canvas begin))
    (call (. canvas oval-path) (call Rect (- head-x (* 44.0 s)) (- head-y (* 44.0 s)) (* 88.0 s) (* 88.0 s)))
    (call (. canvas shadow-path) specimen-shadow)
    (call (. tally record) 4 false)
  )
  (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
  (= (. canvas stroke-width) (* 0.9 s))
  (if (not has-gradients)
    (= (. canvas fill-color) (. palette mid))
  )
  (let petal-step (/ (* 2 π) (as petals F64)))
  (for (in p (..< 0 petals))
    (let theta (+ spin (* (as p F64) petal-step)))
    (let dx (call cos theta))
    (let dy (call sin theta))
    (let px (- dy))
    (let py dx)
    (let tip-x (+ head-x (* dx outer-len) (* (. sway x) 0.16)))
    (let tip-y (+ head-y (* dy outer-len) (* (. sway y) 0.16)))
    (if has-gradients
      (let grad-end (call safe-gradient-end head-x head-y tip-x tip-y))
      (= (. canvas gradient-fill) (call LinearGradient (call Point head-x head-y) grad-end (. palette outer-petal-stops)))
    )
    (call (. canvas begin))
    (call trace-cupped-petal canvas head-x head-y tip-x tip-y dx dy px py outer-len outer-w)
    (call (. canvas end) true)
    (call (. tally record) 3 has-strokes)
  )
  (let inner-len (* 34.0 s breath))
  (let inner-w (* 17.0 s))
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode multiply))
  )
  (= (. canvas stroke-width) (* 0.75 s))
  (if (not has-gradients)
    (= (. canvas fill-color) (if-expr has-effects (. palette wash) (. palette light)))
  )
  (let half-step (/ π (as petals F64)))
  (for (in p (..< 0 petals))
    (let theta (+ spin half-step (* (as p F64) petal-step)))
    (let dx (call cos theta))
    (let dy (call sin theta))
    (let px (- dy))
    (let py dx)
    (let tip-x (+ head-x (* dx inner-len) (* (. sway x) 0.12)))
    (let tip-y (+ head-y (* dy inner-len) (* (. sway y) 0.12)))
    (if has-gradients
      (let grad-end (call safe-gradient-end head-x head-y tip-x tip-y))
      (= (. canvas gradient-fill) (call LinearGradient (call Point head-x head-y) grad-end (. palette inner-petal-stops)))
    )
    (call (. canvas begin))
    (call trace-cupped-petal canvas head-x head-y tip-x tip-y dx dy px py inner-len inner-w)
    (call (. canvas end) true)
    (call (. tally record) 3 has-strokes)
  )
  (if has-gradients
    (= (. canvas gradient-fill) null)
  )
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode normal))
  )
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) stamen-dark)
    (= (. canvas stroke-width) (* 0.85 s))
    (let stamens 10)
    (let r (* 19.0 s))
    (let c25 0.9689124217106447)
    (let s25 0.24740395925452294)
    (let c15 0.9887710779360422)
    (let s15 0.14943813247359922)
    (let stamen-step (/ (* 2 π) (as stamens F64)))
    (let step-c (call cos stamen-step))
    (let step-s (call sin stamen-step))
    (let ca (call cos spin))
    (let sa (call sin spin))
    (for (in k (..< 0 stamens))
      (let sx (+ head-x (* ca r)))
      (let sy (+ head-y (* sa r)))
      (let ca25 (- (* ca c25) (* sa s25)))
      (let sa25 (+ (* sa c25) (* ca s25)))
      (let ca15 (- (* ca c15) (* sa s15)))
      (let sa15 (+ (* sa c15) (* ca s15)))
      (call (. canvas begin))
      (call (. canvas move) head-x head-y)
      (call (. canvas curve) (+ head-x (* ca25 r 0.55)) (+ head-y (* sa25 r 0.55)) (+ head-x (* ca15 r 0.85)) (+ head-y (* sa15 r 0.85)) sx sy)
      (call (. canvas end))
      (call (. tally record) 1 true)
      (let next-c (- (* ca step-c) (* sa step-s)))
      (let next-s (+ (* sa step-c) (* ca step-s)))
      (= ca next-c)
      (= sa next-s)
    )
    (= (. canvas fill-color) pollen-gold)
    (= (. canvas stroke-color) null)
    (= ca (call cos spin))
    (= sa (call sin spin))
    (let dot-r (* 2.1 s))
    (for (in k (..< 0 stamens))
      (call (. canvas circle) (+ head-x (* ca r)) (+ head-y (* sa r)) dot-r)
      (let next-c (- (* ca step-c) (* sa step-s)))
      (let next-s (+ (* sa step-c) (* ca step-s)))
      (= ca next-c)
      (= sa next-s)
    )
  )
  (= (. canvas fill-color) stamen-dark)
  (= (. canvas stroke-color) (only-if (. palette accent) (if has-strokes)))
  (= (. canvas stroke-width) (* 1.6 s))
  (call (. canvas circle) head-x head-y (* 8.5 s))
  (call (. tally record) 4 has-strokes)
)

(fn-do _ paint-vine-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let a (+ (. specimen angle) 0.45))
  (let ca (call cos a))
  (let sa (call sin a))
  (let span (* 225.0 s))
  (let dx (* ca span))
  (let dy (* sa span))
  (let perp-x (- sa))
  (let perp-y ca)
  (let x0 (- cx (* dx 0.52)))
  (let y0 (- cy (* dy 0.52)))
  (let c1x (+ cx (* perp-x 66.0 s) (* (. sway x) 0.55)))
  (let c1y (+ cy (* perp-y 66.0 s) (* (. sway y) 0.55)))
  (let c2x (- cx (* perp-x 62.0 s) (- (* (. sway x) 0.85))))
  (let c2y (- cy (* perp-y 62.0 s) (- (* (. sway y) 0.85))))
  (let x3 (+ cx (* dx 0.52) (* (. sway x) 0.72)))
  (let y3 (+ cy (* dy 0.52) (* (. sway y) 0.72)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 2.4 s))
    (call (. canvas begin))
    (call (. canvas move) x0 y0)
    (call (. canvas curve) c1x c1y c2x c2y x3 y3)
    (call (. canvas end))
    (call (. tally record) 1 true)
  )
  (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
  (let vine-leaf-sw (* (if-expr has-gradients 0.9 0.85) s))
  (let vine-vein-sw (* 0.7 s))
  (for (in k (..< 0 6))
    (let t (/ (+ (as k F64) 0.55) 6.1))
    (let pt (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 t))
    (let side (if-expr (== (% k 2) 0) 1.0 -1.0))
    (let dir-x (+ (* perp-x side 0.84) (* ca 0.52)))
    (let dir-y (+ (* perp-y side 0.84) (* sa 0.52)))
    (let inv (call max 0.001 (call sqrt (+ (* dir-x dir-x) (* dir-y dir-y)))))
    (let ux (/ dir-x inv))
    (let uy (/ dir-y inv))
    (let lat-x (- uy))
    (let lat-y ux)
    (let env (+ 0.68 (* 0.44 (call sin (* t π)))))
    (let leaf-len (* 40.0 s env))
    (let leaf-w (* 22.0 s env))
    (let tip-x (+ (. pt x) (* ux leaf-len) (* (. sway x) 0.24)))
    (let tip-y (+ (. pt y) (* uy leaf-len) (* (. sway y) 0.24)))
    (if has-strokes
      (= (. canvas stroke-width) vine-leaf-sw)
    )
    (if has-gradients
      (let grad-end (call safe-gradient-end (. pt x) (. pt y) tip-x tip-y))
      (= (. canvas gradient-fill) (call LinearGradient (call Point (. pt x) (. pt y)) grad-end (. palette leaf-stops)))
      (call (. canvas begin))
      (call trace-heart-leaf canvas (. pt x) (. pt y) tip-x tip-y ux uy lat-x lat-y leaf-len leaf-w)
      (call (. canvas end) true)
      (else
        (= (. canvas fill-color) (if-expr (== (% k 2) 0) (. palette mid) (. palette deep)))
        (call (. canvas begin))
        (call trace-heart-leaf canvas (. pt x) (. pt y) tip-x tip-y ux uy lat-x lat-y leaf-len leaf-w)
        (call (. canvas end) true)
      )
    )
    (call (. tally record) 4 has-strokes)
    (if has-strokes
      (if has-gradients
        (= (. canvas gradient-fill) null)
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-width) vine-vein-sw)
      (call (. canvas begin))
      (call (. canvas move) (. pt x) (. pt y))
      (call (. canvas line) (+ (. pt x) (* (- tip-x (. pt x)) 0.82)) (+ (. pt y) (* (- tip-y (. pt y)) 0.82)))
      (for (in v-idx (..< 0 2))
        (let v (if-expr (== v-idx 0) 0.34 0.58))
        (let vx (+ (. pt x) (* (- tip-x (. pt x)) v)))
        (let vy (+ (. pt y) (* (- tip-y (. pt y)) v)))
        (let rib (* leaf-w (- 0.7 (* v 0.35))))
        (call (. canvas move) vx vy)
        (call (. canvas line) (+ vx (* ux rib 0.45) (* lat-x rib)) (+ vy (* uy rib 0.45) (* lat-y rib)))
        (call (. canvas move) vx vy)
        (call (. canvas line) (- (+ vx (* ux rib 0.45)) (* lat-x rib)) (- (+ vy (* uy rib 0.45)) (* lat-y rib)))
      )
      (call (. canvas end))
      (call (. tally record) 5 true)
    )
  )
  (if has-gradients
    (= (. canvas gradient-fill) null)
  )
  (for (in b-idx (..< 0 2))
    (let b (if-expr (== b-idx 0) 0.28 0.64))
    (let bp (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 b))
    (= (. canvas fill-color) (if-expr (== (. specimen variant-id) 0) berry-crimson (. palette accent)))
    (= (. canvas stroke-color) (only-if ink-outline (if has-strokes)))
    (= (. canvas stroke-width) (* 0.75 s))
    (call (. canvas circle) (+ (. bp x) (* perp-x 10.0 s)) (+ (. bp y) (* perp-y 10.0 s)) (* 4.4 s))
    (call (. canvas circle) (+ (. bp x) (* perp-x 16.0 s) (* ca 5.0 s)) (+ (. bp y) (* perp-y 16.0 s) (* sa 5.0 s)) (* 3.4 s))
    (call (. tally record) 8 has-strokes)
  )
  (if has-strokes
    (let tip (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 0.82))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 1.3 s))
    (call (. canvas begin))
    (call (. canvas move) (. tip x) (. tip y))
    (call (. canvas curve)
      (block
        (arg (+ (. tip x) (* perp-x 30.0 s) (* (. sway x) 0.4)))
        (arg (+ (. tip y) (* perp-y 30.0 s) (* (. sway y) 0.4)))
        (arg (+ (. tip x) (* perp-x 46.0 s) (* ca 24.0 s)))
        (arg (+ (. tip y) (* perp-y 46.0 s) (* sa 24.0 s)))
        (arg (+ (. tip x) (* perp-x 26.0 s) (* ca 36.0 s)))
        (arg (+ (. tip y) (* perp-y 26.0 s) (* sa 36.0 s)))
      )
    )
    (call (. canvas curve)
      (block
        (arg (+ (. tip x) (* perp-x 10.0 s) (* ca 40.0 s)))
        (arg (+ (. tip y) (* perp-y 10.0 s) (* sa 40.0 s)))
        (arg (+ (. tip x) (* perp-x 12.0 s) (* ca 18.0 s)))
        (arg (+ (. tip y) (* perp-y 12.0 s) (* sa 18.0 s)))
        (arg (+ (. tip x) (* perp-x 23.0 s) (* ca 23.0 s)))
        (arg (+ (. tip y) (* perp-y 23.0 s) (* sa 23.0 s)))
      )
    )
    (call (. canvas end))
    (call (. tally record) 2 true)
  )
)

(fn-do _ paint-pod-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let base-x cx)
  (let base-y (+ cy (* 72.0 s)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (let rock (if-expr (. specimen is-animated) (* (call sin (+ (* clock 1.4) (. specimen phase))) 0.14) 0.0))
  (for (in k (..< 0 5))
    (let spread (+ (. specimen angle) rock (* (- (as k F64) 2.0) 0.36)))
    (let reach (* (+ 68.0 (* (as (% k 2) F64) 26.0)) s))
    (let dx (call sin spread))
    (let dy (- (call cos spread)))
    (let tip-x (+ base-x (* dx reach) (* (. sway x) 0.8)))
    (let tip-y (+ base-y (* dy reach) (* (. sway y) 0.55)))
    (if has-strokes
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (. palette stem))
      (= (. canvas stroke-width) (* 1.9 s))
      (call (. canvas begin))
      (call (. canvas move) base-x base-y)
      (call (. canvas curve) base-x (- base-y (* reach 0.44)) (+ base-x (* dx reach 0.55) (* (. sway x) 0.4)) (+ base-y (* dy reach 0.62)) tip-x tip-y)
      (call (. canvas end))
      (call (. tally record) 1 true)
    )
    (let pod-len (* 38.0 s))
    (let pod-w (* 17.0 s))
    (let lat-x (- dy))
    (let lat-y dx)
    (let pod-tip-x (+ tip-x (* dx pod-len)))
    (let pod-tip-y (+ tip-y (* dy pod-len)))
    (if has-effects
      (= (. canvas blend-mode) (. BlendMode multiply))
    )
    (if has-gradients
      (let grad-end (call safe-gradient-end tip-x tip-y pod-tip-x pod-tip-y))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) null)
      (= (. canvas gradient-fill) (call LinearGradient (call Point tip-x tip-y) grad-end (. palette pod-stops)))
      (call (. canvas begin))
      (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
      (let in-x0 (+ tip-x (* dx pod-len 0.26)))
      (let in-y0 (+ tip-y (* dy pod-len 0.26)))
      (let in-x1 (+ tip-x (* dx pod-len 0.72)))
      (let in-y1 (+ tip-y (* dy pod-len 0.72)))
      (call trace-leaf-blade canvas in-x0 in-y0 in-x1 in-y1 dx dy lat-x lat-y (* pod-len 0.46) (* pod-w 0.4))
      (call (. canvas end) false (. FillRule even-odd))
      (= (. canvas gradient-fill) null)
      (if has-strokes
        (= (. canvas stroke-color) (. palette vein))
        (= (. canvas stroke-width) (* 1.0 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
        (call (. canvas end) true)
      )
      (else
        (= (. canvas fill-color) (. palette mid))
        (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
        (= (. canvas stroke-width) (* 1.0 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
        (let in-x0 (+ tip-x (* dx pod-len 0.26)))
        (let in-y0 (+ tip-y (* dy pod-len 0.26)))
        (let in-x1 (+ tip-x (* dx pod-len 0.72)))
        (let in-y1 (+ tip-y (* dy pod-len 0.72)))
        (call trace-leaf-blade canvas in-x0 in-y0 in-x1 in-y1 dx dy lat-x lat-y (* pod-len 0.46) (* pod-w 0.4))
        (call (. canvas end) false (. FillRule even-odd))
      )
    )
    (if has-effects
      (= (. canvas blend-mode) (. BlendMode normal))
    )
    (call (. tally record) 4 has-strokes)
  )
)

(fn-do _ paint-pollinator _
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param moth Pollinator)
  (param clock F64)
  (param motion MotionMode)
  (param tier PaintTier)
  (param tally Tally)
  (let t (+ (* clock (. moth speed)) (. moth phase)))
  (let x (+ (. moth home-x) (* (call sin t) (. moth radius-x))))
  (let y (+ (. moth home-y) (* (call sin (* t 2.0)) (. moth radius-y) 0.55)))
  (let vx (* (call cos t) (. moth radius-x) (. moth speed)))
  (let vy (* (call cos (* t 2.0)) (. moth radius-y) 1.1 (. moth speed)))
  (let heading (+ (call atan2 vy vx) (/ π 2)))
  (let flap (+ 0.34 (* 0.66 (call abs (call sin (+ (* clock 8.5) (* (. moth phase) 3.0)))))))
  (let s (* (. moth scale) 0.48))
  (let palette ([] (. kit palettes) (. moth palette)))
  (let has-strokes (. tier has-strokes))
  (if (== motion (. MotionMode transforms))
    (let m (call stamp-matrix x y heading (* s flap) s))
    (let shape (if-expr has-strokes (. kit moth-wings-veined) (. kit moth-wings)))
    (let ignored (call (. table paint-vector) shape canvas ([] (. kit moth-palettes) (. moth palette)) m))
    (call (. tally record) 6 has-strokes)
    (return)
  )
  (let cosa (call cos heading))
  (let sina (call sin heading))
  (let wing-x (* 34.0 (. moth scale) flap))
  (let wing-y (* 26.0 (. moth scale)))
  (for (in side-idx (..< 0 2))
    (let side (if-expr (== side-idx 0) -1.0 1.0))
    (let wx (* side wing-x))
    (= (. canvas fill-color) (if-expr (. tier has-gradients) (. palette light) (. palette mid)))
    (= (. canvas stroke-color) (only-if (. palette deep) (if has-strokes)))
    (= (. canvas stroke-width) (* 1.4 (. moth scale)))
    (call (. canvas begin))
    (call (. canvas move) x y)
    (call (. canvas curve)
      (block
        (arg (+ x (- (* wx 0.68 cosa) (* (- wing-y) 1.15 sina))))
        (arg (+ y (* wx 0.68 sina) (* (- wing-y) 1.15 cosa)))
        (arg (+ x (- (* wx 1.32 cosa) (* (- wing-y) 0.25 sina))))
        (arg (+ y (* wx 1.32 sina) (* (- wing-y) 0.25 cosa)))
        (arg (+ x (- (* wx 0.92 cosa) (* (* wing-y 0.12) sina))))
        (arg (+ y (* wx 0.92 sina) (* (* wing-y 0.12) cosa)))
      )
    )
    (call (. canvas curve)
      (block
        (arg (+ x (- (* wx 0.96 cosa) (* (* wing-y 0.72) sina))))
        (arg (+ y (* wx 0.96 sina) (* (* wing-y 0.72) cosa)))
        (arg (+ x (- (* wx 0.52 cosa) (* (* wing-y 1.25) sina))))
        (arg (+ y (* wx 0.52 sina) (* (* wing-y 1.25) cosa)))
        (arg (+ x (- (* wx 0.28 cosa) (* (* wing-y 0.88) sina))))
        (arg (+ y (* wx 0.28 sina) (* (* wing-y 0.88) cosa)))
      )
    )
    (call (. canvas curve)
      (block
        (arg (+ x (- (* wx 0.16 cosa) (* (* wing-y 0.45) sina))))
        (arg (+ y (* wx 0.16 sina) (* (* wing-y 0.45) cosa)))
        (arg (+ x (- (* wx 0.08 cosa) (* (* wing-y 0.15) sina))))
        (arg (+ y (* wx 0.08 sina) (* (* wing-y 0.15) cosa)))
        (arg x)
        (arg y)
      )
    )
    (call (. canvas end) true)
    (= (. canvas fill-color) (. palette accent))
    (= (. canvas stroke-color) (only-if stamen-dark (if has-strokes)))
    (= (. canvas stroke-width) (* 0.8 (. moth scale)))
    (let spot-x (+ x (- (* wx 0.55 cosa) (* (- wing-y) 0.32 sina))))
    (let spot-y (+ y (* wx 0.55 sina) (* (- wing-y) 0.32 cosa)))
    (call (. canvas circle) spot-x spot-y (* 3.6 (. moth scale) flap))
    (call (. tally record) 4 has-strokes)
  )
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) stamen-dark)
    (= (. canvas stroke-width) (* 2.0 (. moth scale)))
    (call (. canvas begin))
    (call (. canvas move) (+ x (* 12.0 (. moth scale) sina)) (- y (* 12.0 (. moth scale) cosa)))
    (call (. canvas line) (- x (* 16.0 (. moth scale) sina)) (+ y (* 16.0 (. moth scale) cosa)))
    (call (. canvas end))
    (call (. tally record) 1 true)
  )
)

(fn-do _ trace-leaf-blade _ @inline
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param out-x F64)
  (param out-y F64)
  (param lat-x F64)
  (param lat-y F64)
  (param len F64)
  (param width F64)
  (let c1x (+ x0 (* out-x len 0.3) (* lat-x width)))
  (let c1y (+ y0 (* out-y len 0.3) (* lat-y width)))
  (let c2x (+ x0 (* out-x len 0.72) (* lat-x width 0.58)))
  (let c2y (+ y0 (* out-y len 0.72) (* lat-y width 0.58)))
  (let c3x (- (+ x0 (* out-x len 0.72)) (* lat-x width 0.58)))
  (let c3y (- (+ y0 (* out-y len 0.72)) (* lat-y width 0.58)))
  (let c4x (- (+ x0 (* out-x len 0.3)) (* lat-x width)))
  (let c4y (- (+ y0 (* out-y len 0.3)) (* lat-y width)))
  (call (. canvas move) x0 y0)
  (call (. canvas curve) c1x c1y c2x c2y x1 y1)
  (call (. canvas curve) c3x c3y c4x c4y x0 y0)
  (call (. canvas enclose))
)

(fn-do _ trace-cupped-petal _ @inline
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param out-x F64)
  (param out-y F64)
  (param lat-x F64)
  (param lat-y F64)
  (param len F64)
  (param width F64)
  (let notch-x (- x1 (* out-x len 0.08)))
  (let notch-y (- y1 (* out-y len 0.08)))
  (let lobe1-x (+ x1 (* lat-x width 0.38)))
  (let lobe1-y (+ y1 (* lat-y width 0.38)))
  (let lobe2-x (- x1 (* lat-x width 0.38)))
  (let lobe2-y (- y1 (* lat-y width 0.38)))
  (call (. canvas move) x0 y0)
  (call (. canvas curve) (+ x0 (* out-x len 0.28) (* lat-x width 0.95)) (+ y0 (* out-y len 0.28) (* lat-y width 0.95)) (+ x0 (* out-x len 0.86) (* lat-x width 0.92)) (+ y0 (* out-y len 0.86) (* lat-y width 0.92)) lobe1-x lobe1-y)
  (call (. canvas curve) (+ notch-x (* lat-x width 0.14)) (+ notch-y (* lat-y width 0.14)) (- notch-x (* lat-x width 0.14)) (- notch-y (* lat-y width 0.14)) lobe2-x lobe2-y)
  (call (. canvas curve) (- (+ x0 (* out-x len 0.86)) (* lat-x width 0.92)) (- (+ y0 (* out-y len 0.86)) (* lat-y width 0.92)) (- (+ x0 (* out-x len 0.28)) (* lat-x width 0.95)) (- (+ y0 (* out-y len 0.28)) (* lat-y width 0.95)) x0 y0)
  (call (. canvas enclose))
)

(fn-do _ trace-heart-leaf _ @inline
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param out-x F64)
  (param out-y F64)
  (param lat-x F64)
  (param lat-y F64)
  (param len F64)
  (param width F64)
  (let mid1-x (+ x0 (* out-x len 0.36) (* lat-x width)))
  (let mid1-y (+ y0 (* out-y len 0.36) (* lat-y width)))
  (let mid2-x (- (+ x0 (* out-x len 0.36)) (* lat-x width)))
  (let mid2-y (- (+ y0 (* out-y len 0.36)) (* lat-y width)))
  (call (. canvas move) x0 y0)
  (call (. canvas curve) (+ x0 (- (* out-x len 0.22)) (* lat-x width 0.72)) (+ y0 (- (* out-y len 0.22)) (* lat-y width 0.72)) (+ x0 (* out-x len 0.08) (* lat-x width 1.08)) (+ y0 (* out-y len 0.08) (* lat-y width 1.08)) mid1-x mid1-y)
  (call (. canvas curve) (+ x0 (* out-x len 0.68) (* lat-x width 0.78)) (+ y0 (* out-y len 0.68) (* lat-y width 0.78)) (+ x0 (* out-x len 0.88) (* lat-x width 0.24)) (+ y0 (* out-y len 0.88) (* lat-y width 0.24)) x1 y1)
  (call (. canvas curve) (- (+ x0 (* out-x len 0.88)) (* lat-x width 0.24)) (- (+ y0 (* out-y len 0.88)) (* lat-y width 0.24)) (- (+ x0 (* out-x len 0.68)) (* lat-x width 0.78)) (- (+ y0 (* out-y len 0.68)) (* lat-y width 0.78)) mid2-x mid2-y)
  (call (. canvas curve) (- (+ x0 (* out-x len 0.08)) (* lat-x width 1.08)) (- (+ y0 (* out-y len 0.08)) (* lat-y width 1.08)) (- (+ x0 (- (* out-x len 0.22))) (* lat-x width 0.72)) (- (+ y0 (- (* out-y len 0.22))) (* lat-y width 0.72)) x0 y0)
  (call (. canvas enclose))
)

(fn-expr _ safe-gradient-end Point @inline
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (if-expr (< (+ (* dx dx) (* dy dy)) 1.0)
    (call Point (+ x0 1.0) y0)
    (call Point x1 y1)
  )
  (where
    (lazy dx (- x1 x0))
    (lazy dy (- y1 y0))
  )
)

(fn-expr _ eval-cubic Point @inline
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param x2 F64)
  (param y2 F64)
  (param x3 F64)
  (param y3 F64)
  (param t F64)
  (call Point (+ (* u3 x0) (* 3 u2 t x1) (* 3 u t2 x2) (* t3 x3)) (+ (* u3 y0) (* 3 u2 t y1) (* 3 u t2 y2) (* t3 y3)))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy u3 (* u2 u))
    (lazy t2 (* t t))
    (lazy t3 (* t2 t))
  )
)

(fn-expr _ stamp-matrix Matrix
  (param tx F64)
  (param ty F64)
  (param angle F64)
  (param sx F64)
  (param sy F64)
  (call Matrix (* cosa sx) (* sina sx) (* (- sina) sy) (* cosa sy) tx ty)
  (where
    (lazy cosa (call cos angle))
    (lazy sina (call sin angle))
  )
)

(fn-do _ fern-blade-geometry VectorGeometry
  (param stroked Bool)
  (let blade (call Path))
  (call (. blade move-to) 0 0)
  (call (. blade cubic-curve-to) 28 -28 74 -20 100 0)
  (call (. blade cubic-curve-to) 74 20 28 28 0 0)
  (call (. blade close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan blade fill-paint stroke-paint (only-if 2.0 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (if stroked
    (let vein (call Path))
    (call (. vein move-to) 4 0)
    (call (. vein cubic-curve-to) 34 -4 64 4 86 0)
    (+= spans (call VectorGeometrySpan vein none-paint stroke-paint 1.6 (. LineCap round) (. LineJoin round) (. FillRule nonzero)))
  )
  (return (call VectorGeometry (call Rect -10 -40 120 80) (call Rect -16 -46 132 92) spans false false))
)

