(import ./herbarium-scene)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /math)
(import /units)
(blank)
(prop _ plate-paper _ (= (call RGBA "#18201b")))
(prop _ plate-border _ (= (call RGBA "#2e3d34")))
(prop _ plate-rule _ (= (call RGBA "#233028")))
(prop _ stamen-gold _ (= (call RGBA "#f2c96b")))
(prop _ specimen-shadow _ (= (call Shadow (call RGBA "#060a0870") 10 4 6 0)))

(type + BotanicalPalette (is Tuple)
  (prop + base RGBA)
  (prop + bright RGBA)
  (prop + glaze RGBA)
  (prop + stem RGBA)
  (prop + vein RGBA)
  (prop + accent RGBA)
)

(prop _ botanical-palettes _
  (=
    (list
      (call BotanicalPalette (call RGBA "#2e6f52") (call RGBA "#5fb886") (call RGBA "#7ce0a875") (call RGBA "#4d916d") (call RGBA "#a7e6be") (call RGBA "#f0d27a"))
      (call BotanicalPalette (call RGBA "#3c7a57") (call RGBA "#7fc48a") (call RGBA "#a2e0a575") (call RGBA "#589968") (call RGBA "#c7edb8") (call RGBA "#e8be66"))
      (call BotanicalPalette (call RGBA "#265d58") (call RGBA "#4da398") (call RGBA "#6fd1c475") (call RGBA "#3f847c") (call RGBA "#9ce8dc") (call RGBA "#f2b872"))
      (call BotanicalPalette (call RGBA "#4e7040") (call RGBA "#8db05a") (call RGBA "#b3d67c75") (call RGBA "#6b8f4e") (call RGBA "#d4eb9e") (call RGBA "#f2c66d"))
      (call BotanicalPalette (call RGBA "#b84a45") (call RGBA "#e87868") (call RGBA "#ffa08f80") (call RGBA "#5d875c") (call RGBA "#ffd2c2") (call RGBA "#f7d469"))
      (call BotanicalPalette (call RGBA "#c46442") (call RGBA "#f0965e") (call RGBA "#ffba8a80") (call RGBA "#628a58") (call RGBA "#ffe0c2") (call RGBA "#fae084"))
      (call BotanicalPalette (call RGBA "#b57a2d") (call RGBA "#e8b44c") (call RGBA "#ffd77a80") (call RGBA "#588255") (call RGBA "#fff0b8") (call RGBA "#f59d62"))
      (call BotanicalPalette (call RGBA "#7e4f8f") (call RGBA "#b67ec9") (call RGBA "#d8a8eb80") (call RGBA "#4c8062") (call RGBA "#efd4fa") (call RGBA "#f5cf76"))
      (call BotanicalPalette (call RGBA "#a84f6e") (call RGBA "#df7fa0") (call RGBA "#f7adc680") (call RGBA "#548264") (call RGBA "#ffd9e6") (call RGBA "#f5cc78"))
      (call BotanicalPalette (call RGBA "#386b7a") (call RGBA "#63a9bd") (call RGBA "#8fd4e878") (call RGBA "#498780") (call RGBA "#c4eef7") (call RGBA "#f2c474"))
      (call BotanicalPalette (call RGBA "#8c6b38") (call RGBA "#c9a45b") (call RGBA "#e6c88578") (call RGBA "#667d4c") (call RGBA "#f5e4b8") (call RGBA "#e88a68"))
      (call BotanicalPalette (call RGBA "#58568a") (call RGBA "#8c8ac7") (call RGBA "#b4b2eb78") (call RGBA "#4b7d69") (call RGBA "#dcdbf7") (call RGBA "#f0c975"))
    )
  )
)

(type + BotanicalKit
  (prop + palettes (list BotanicalPalette))
  (prop + fill-palettes (list (list RGBA)))
  (prop + stroke-palettes (list (list RGBA)))
  (prop + accent-palettes (list (list RGBA)))
  (prop + fern-blade VectorGeometryHandle)
  (prop + fern-blade-veined VectorGeometryHandle)
  (prop + blossom-petal VectorGeometryHandle)
  (prop + blossom-petal-veined VectorGeometryHandle)
  (prop + blossom-core VectorGeometryHandle)
  (prop + vine-leaf VectorGeometryHandle)
  (prop + vine-leaf-veined VectorGeometryHandle)
  (prop + seed-capsule VectorGeometryHandle)
  (prop + seed-capsule-veined VectorGeometryHandle)
  (prop + moth-wings VectorGeometryHandle)
  (prop + moth-wings-veined VectorGeometryHandle)
  (fn-do + This _
    (param table VectorGeometryTable)
    (for (in entry botanical-palettes)
      (+= palettes entry)
      (+= fill-palettes (list (. entry base)))
      (+= stroke-palettes (list (. entry base) (. entry vein)))
      (+= accent-palettes (list (. entry bright) (. entry accent)))
    )
    (= fern-blade (call (. table intern-geometry) (as 940101 U64) (=> () (call fern-blade-geometry false))))
    (= fern-blade-veined (call (. table intern-geometry) (as 940102 U64) (=> () (call fern-blade-geometry true))))
    (= blossom-petal (call (. table intern-geometry) (as 940103 U64) (=> () (call petal-geometry false))))
    (= blossom-petal-veined (call (. table intern-geometry) (as 940104 U64) (=> () (call petal-geometry true))))
    (= blossom-core (call (. table intern-geometry) (as 940105 U64) (=> () (call core-geometry))))
    (= vine-leaf (call (. table intern-geometry) (as 940106 U64) (=> () (call vine-leaf-geometry false))))
    (= vine-leaf-veined (call (. table intern-geometry) (as 940107 U64) (=> () (call vine-leaf-geometry true))))
    (= seed-capsule (call (. table intern-geometry) (as 940108 U64) (=> () (call seed-capsule-geometry false))))
    (= seed-capsule-veined (call (. table intern-geometry) (as 940109 U64) (=> () (call seed-capsule-geometry true))))
    (= moth-wings (call (. table intern-geometry) (as 940110 U64) (=> () (call moth-geometry false))))
    (= moth-wings-veined (call (. table intern-geometry) (as 940111 U64) (=> () (call moth-geometry true))))
  )
)

(type _ Tally
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (fn-do + record _
    (param segs Int)
    (param stroked Bool)
    (+= paths 1)
    (+= segments segs)
    (if stroked
      (+= strokes 1)
    )
  )
  (fn-expr + snapshot SceneCounts :get
    (call SceneCounts paths segments strokes)
  )
)

(fn-do + paint-plate _
  (param canvas Canvas)
  (param extent Dimensions)
  (let inset 32.0)
  (let rect (call Rect inset inset (- (. extent width) (* inset 2)) (- (. extent height) (* inset 2))))
  (= (. canvas fill-color) plate-paper)
  (= (. canvas stroke-color) plate-border)
  (= (. canvas stroke-width) 2.5)
  (call (. canvas outline) (call Outline rect 24))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) plate-rule)
  (= (. canvas stroke-width) 1.0)
  (call (. canvas outline) (call Outline (call (. rect pad) 18) 14))
  (= (. canvas stroke-color) null)
)

(fn-do + paint-herbarium-layer SceneCounts
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field HerbariumField)
  (param clock F64)
  (param gusts (list WindGust))
  (param motion MotionMode)
  (param tier PaintTier)
  (param include-static Bool)
  (param include-animated Bool)
  (let tally (call Tally))
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-join) (. LineJoin round))
  (= (. canvas stroke-dash) 0)
  (if include-static
    (call paint-plate canvas (. field extent))
  )
  (for (in specimen (. field specimens))
    (let wants (if-expr (. specimen is-animated) include-animated include-static))
    (if wants
      (let sway
        (if-expr (. specimen is-animated)
          (call wind-at (. specimen x) (. specimen y) (. specimen phase) clock gusts)
          (call WindOffset 0 0)
        )
      )
      (if (== motion (. MotionMode transforms))
        (call paint-specimen-instanced kit table canvas specimen sway clock tier tally)
        (else
          (call paint-specimen-deformed kit canvas specimen sway clock tier tally)
        )
      )
    )
  )
  (if include-animated
    (for (in moth (. field pollinators))
      (call paint-pollinator kit table canvas moth clock motion tier tally)
    )
  )
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-dash) 0)
  (= (. canvas blend-mode) (. BlendMode normal))
  (return (. tally snapshot))
)

(fn-do _ paint-specimen-deformed _
  (param kit BotanicalKit)
  (param canvas Canvas)
  (param specimen Specimen)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let palette ([] (. kit palettes) (. specimen palette)))
  (match (. specimen kind)
    (case .fern
      (call paint-fern-deformed canvas specimen palette sway tier tally)
    )
    (case .blossom
      (call paint-blossom-deformed canvas specimen palette sway clock tier tally)
    )
    (case .vine
      (call paint-vine-deformed canvas specimen palette sway tier tally)
    )
    (default
      (call paint-pod-deformed canvas specimen palette sway clock tier tally)
    )
  )
)

(fn-do _ paint-specimen-instanced _
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param specimen Specimen)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let palette ([] (. kit palettes) (. specimen palette)))
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let bend (* (. sway x) 0.011))
  (let base-angle (+ (. specimen angle) bend))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (let blade-palette (if-expr has-strokes ([] (. kit stroke-palettes) (. specimen palette)) ([] (. kit fill-palettes) (. specimen palette))))
  (let accent-palette (if-expr has-strokes ([] (. kit accent-palettes) (. specimen palette)) ([] (. kit fill-palettes) (. specimen palette))))
  (match (. specimen kind)
    (case .fern
      (let stem-len (* 124.0 s))
      (let dir-x (call sin base-angle))
      (let dir-y (- (call cos base-angle)))
      (let bx (- cx (* dir-x stem-len 0.45)))
      (let by (- cy (* dir-y stem-len 0.45)))
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette stem))
        (= (. canvas stroke-width) (* 2.6 s))
        (call (. canvas begin))
        (call (. canvas move) bx by)
        (call (. canvas curve)
          (block
            (arg (+ bx (* dir-x stem-len 0.35) (* (. sway x) 0.28)))
            (arg (+ by (* dir-y stem-len 0.35) (* (. sway y) 0.28)))
            (arg (+ bx (* dir-x stem-len 0.72) (* (. sway x) 0.65)))
            (arg (+ by (* dir-y stem-len 0.72) (* (. sway y) 0.65)))
            (arg (+ bx (* dir-x stem-len) (. sway x)))
            (arg (+ by (* dir-y stem-len) (. sway y)))
          )
        )
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
      (let shape (if-expr has-strokes (. kit fern-blade-veined) (. kit fern-blade)))
      (let stem-theta (- base-angle (/ π 2)))
      (let pairs (. specimen leaflets))
      (for (in step (..< 0 pairs))
        (let t (/ (+ (as step F64) 0.8) (+ (as pairs F64) 0.8)))
        (let px (+ bx (* dir-x stem-len t) (* (. sway x) t t)))
        (let py (+ by (* dir-y stem-len t) (* (. sway y) t t)))
        (let leaf-s (* s (- 1.0 (* t 0.45)) 0.44))
        (let spread (- 1.08 (* t 0.22)))
        (let left-m (call stamp-matrix px py (- stem-theta spread) leaf-s leaf-s))
        (let right-m (call stamp-matrix px py (+ stem-theta spread) leaf-s (- leaf-s)))
        (let ignored-l (call (. table paint-vector) shape canvas blade-palette left-m))
        (let ignored-r (call (. table paint-vector) shape canvas blade-palette right-m))
        (call (. tally record) 2 has-strokes)
        (call (. tally record) 2 has-strokes)
      )
    )
    (case .blossom
      (let head-x (+ cx (* (. sway x) 0.75)))
      (let head-y (+ cy (* (. sway y) 0.55) (* -14.0 s)))
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette stem))
        (= (. canvas stroke-width) (* 2.8 s))
        (call (. canvas begin))
        (call (. canvas move) cx (+ cy (* 64.0 s)))
        (call (. canvas curve) (+ cx (* (. sway x) 0.2)) (+ cy (* 32.0 s)) (+ cx (* (. sway x) 0.5)) (+ cy (* 6.0 s)) head-x head-y)
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
      (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* clock 0.65) (. specimen phase)) (. specimen angle)))
      (let petals 6)
      (let petal-shape (if-expr has-strokes (. kit blossom-petal-veined) (. kit blossom-petal)))
      (if has-effects
        (= (. canvas blend-mode) (. BlendMode screen))
      )
      (for (in p (..< 0 petals))
        (let theta (+ spin (* (as p F64) (/ (* 2 π) (as petals F64)))))
        (let m (call stamp-matrix head-x head-y theta (* s 0.48) (* s 0.48)))
        (let chosen (if-expr (and has-gradients (== (% p 2) 1)) accent-palette blade-palette))
        (let ignored (call (. table paint-vector) petal-shape canvas chosen m))
        (call (. tally record) 2 has-strokes)
      )
      (if has-effects
        (= (. canvas blend-mode) (. BlendMode normal))
      )
      (let core-m (call stamp-matrix head-x head-y (- spin) (* s 0.24) (* s 0.24)))
      (let ignored-c (call (. table paint-vector) (. kit blossom-core) canvas accent-palette core-m))
      (call (. tally record) 4 false)
    )
    (case .vine
      (let span (* 145.0 s))
      (let dx (* (call cos base-angle) span))
      (let dy (* (call sin base-angle) span))
      (let x0 (- cx (* dx 0.5)))
      (let y0 (- cy (* dy 0.5)))
      (let x3 (+ cx (* dx 0.5) (* (. sway x) 0.6)))
      (let y3 (+ cy (* dy 0.5) (* (. sway y) 0.6)))
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette stem))
        (= (. canvas stroke-width) (* 2.4 s))
        (call (. canvas begin))
        (call (. canvas move) x0 y0)
        (call (. canvas curve) (+ cx (- (* dy 0.34)) (* (. sway x) 0.3)) (+ cy (* dx 0.34) (* (. sway y) 0.3)) (+ cx (* dy 0.32) (* (. sway x) 0.45)) (+ cy (- (* dx 0.32)) (* (. sway y) 0.45)) x3 y3)
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
      (let leaf-shape (if-expr has-strokes (. kit vine-leaf-veined) (. kit vine-leaf)))
      (for (in k (..< 0 5))
        (let t (/ (+ (as k F64) 0.5) 5.0))
        (let side (if-expr (== (% k 2) 0) 1.0 -1.0))
        (let px (+ x0 (* (- x3 x0) t) (* (- dy) 0.14 (call sin (* t 2 π)))))
        (let py (+ y0 (* (- y3 y0) t) (* dx 0.14 (call sin (* t 2 π)))))
        (let theta (+ base-angle (* side 0.92) (* (. sway x) 0.008)))
        (let m (call stamp-matrix px py theta (* s 0.36) (* s 0.36)))
        (let ignored (call (. table paint-vector) leaf-shape canvas blade-palette m))
        (call (. tally record) 2 has-strokes)
      )
    )
    (default
      (let pod-shape (if-expr has-strokes (. kit seed-capsule-veined) (. kit seed-capsule)))
      (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* (call sin (+ (* clock 1.4) (. specimen phase))) 0.38)) (. specimen angle)))
      (for (in k (..< 0 4))
        (let spread (+ spin (* (- (as k F64) 1.5) 0.42)))
        (let reach (* (+ 46.0 (* (as (% k 2) F64) 18.0)) s))
        (let tip-x (+ cx (* (call sin spread) reach) (* (. sway x) 0.6)))
        (let tip-y (- (+ cy (* 42.0 s)) (* (call cos spread) reach) (- (* (. sway y) 0.4))))
        (if has-strokes
          (= (. canvas fill-color) null)
          (= (. canvas stroke-color) (. palette stem))
          (= (. canvas stroke-width) (* 1.9 s))
          (call (. canvas begin))
          (call (. canvas move) cx (+ cy (* 56.0 s)))
          (call (. canvas curve) cx (+ cy (* 18.0 s)) (+ cx (* (call sin spread) reach 0.5) (* (. sway x) 0.3)) (- (+ cy (* 22.0 s)) (* (call cos spread) reach 0.45)) tip-x tip-y)
          (call (. canvas end))
          (call (. tally record) 1 true)
        )
        (let m (call stamp-matrix tip-x tip-y (+ spread (* (. sway x) 0.01)) (* s 0.4) (* s 0.4)))
        (let ignored (call (. table paint-vector) pod-shape canvas accent-palette m))
        (call (. tally record) 4 has-strokes)
      )
    )
  )
)

(fn-do _ paint-fern-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let a (. specimen angle))
  (let len (* 128.0 s))
  (let dir-x (call sin a))
  (let dir-y (- (call cos a)))
  (let perp-x (- dir-y))
  (let perp-y dir-x)
  (let x0 (- cx (* dir-x len 0.48)))
  (let y0 (- cy (* dir-y len 0.48)))
  (let c1x (+ x0 (* dir-x len 0.34) (* (. sway x) 0.25)))
  (let c1y (+ y0 (* dir-y len 0.34) (* (. sway y) 0.25)))
  (let c2x (+ x0 (* dir-x len 0.72) (* (. sway x) 0.68)))
  (let c2y (+ y0 (* dir-y len 0.72) (* (. sway y) 0.68)))
  (let x3 (+ x0 (* dir-x len) (* (. sway x) 1.15)))
  (let y3 (+ y0 (* dir-y len) (* (. sway y) 1.15)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (let pairs (. specimen leaflets))
  (for (in step (..< 0 pairs))
    (let t (/ (+ (as step F64) 0.75) (+ (as pairs F64) 0.75)))
    (let stem-pt (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 t))
    (let leaf-len (* s (+ 26.0 (* 28.0 (- 1.0 (* t 0.68))))))
    (let leaf-w (* leaf-len 0.3))
    (for (in dir (list -1.0 1.0))
      (let out-x (+ (* perp-x dir 0.88) (* dir-x 0.46)))
      (let out-y (+ (* perp-y dir 0.88) (* dir-y 0.46)))
      (let lat-x (- out-y))
      (let lat-y out-x)
      (let tip-x (+ (. stem-pt x) (* out-x leaf-len) (* (. sway x) t 0.28)))
      (let tip-y (+ (. stem-pt y) (* out-y leaf-len) (* (. sway y) t 0.28)))
      (let fill-col (if-expr (== (% step 2) 0) (. palette base) (. palette bright)))
      (if has-gradients
        (call fill-gradient-leaf canvas (. stem-pt x) (. stem-pt y) tip-x tip-y out-x out-y lat-x lat-y leaf-len leaf-w (. palette base) (. palette bright) has-strokes (. palette vein) (* 1.0 s))
        (else
          (= (. canvas fill-color) (if-expr has-effects (. palette glaze) fill-col))
          (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
          (= (. canvas stroke-width) (* 0.9 s))
          (call (. canvas begin))
          (call trace-leaf-blade canvas (. stem-pt x) (. stem-pt y) tip-x tip-y out-x out-y lat-x lat-y leaf-len leaf-w)
          (call (. canvas end) true)
        )
      )
      (call (. tally record) 2 has-strokes)
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette vein))
        (= (. canvas stroke-width) (* 0.85 s))
        (call (. canvas begin))
        (call (. canvas move) (. stem-pt x) (. stem-pt y))
        (call (. canvas curve)
          (block
            (arg (+ (. stem-pt x) (* out-x leaf-len 0.35)))
            (arg (+ (. stem-pt y) (* out-y leaf-len 0.35)))
            (arg (+ (. stem-pt x) (* out-x leaf-len 0.68) (* (. sway x) t 0.12)))
            (arg (+ (. stem-pt y) (* out-y leaf-len 0.68) (* (. sway y) t 0.12)))
            (arg (+ (. stem-pt x) (* (- tip-x (. stem-pt x)) 0.82)))
            (arg (+ (. stem-pt y) (* (- tip-y (. stem-pt y)) 0.82)))
          )
        )
        (call (. canvas end))
        (call (. tally record) 1 true)
      )
    )
  )
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 2.8 s))
    (call (. canvas begin))
    (call (. canvas move) x0 y0)
    (call (. canvas curve) c1x c1y c2x c2y x3 y3)
    (call (. canvas curve)
      (block
        (arg (+ x3 (* dir-x 18.0 s) (* perp-x 14.0 s)))
        (arg (+ y3 (* dir-y 18.0 s) (* perp-y 14.0 s)))
        (arg (+ x3 (* dir-x 4.0 s) (* perp-x 22.0 s)))
        (arg (+ y3 (* dir-y 4.0 s) (* perp-y 22.0 s)))
        (arg (+ x3 (* perp-x 10.0 s)))
        (arg (+ y3 (* perp-y 10.0 s)))
      )
    )
    (call (. canvas end))
    (call (. tally record) 2 true)
  )
)

(fn-do _ paint-blossom-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let base-x cx)
  (let base-y (+ cy (* 68.0 s)))
  (let head-x (+ cx (* (. sway x) 0.92)))
  (let head-y (+ (- cy (* 18.0 s)) (* (. sway y) 0.58)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 3.0 s))
    (call (. canvas begin))
    (call (. canvas move) base-x base-y)
    (call (. canvas curve) (+ base-x (* 16.0 s) (* (. sway x) 0.25)) (- base-y (* 30.0 s)) (+ head-x (* -12.0 s)) (+ head-y (* 28.0 s)) head-x head-y)
    (call (. canvas end))
    (call (. tally record) 1 true)
  )
  (let spin (if-expr (. specimen is-animated) (+ (. specimen angle) (* clock 0.55) (. specimen phase)) (. specimen angle)))
  (let breath (if-expr (. specimen is-animated) (+ 1.0 (* 0.08 (call sin (+ (* clock 2.2) (. specimen phase))))) 1.0))
  (let petal-len (* 46.0 s breath))
  (let petal-w (* 22.0 s))
  (let petals 6)
  (if has-effects
    (call (. canvas begin))
    (call (. canvas oval-path) (call Rect (- head-x (* 40.0 s)) (- head-y (* 40.0 s)) (* 80.0 s) (* 80.0 s)))
    (call (. canvas shadow-path) specimen-shadow)
    (call (. tally record) 4 false)
  )
  (for (in p (..< 0 petals))
    (let theta (+ spin (* (as p F64) (/ (* 2 π) (as petals F64)))))
    (let dx (call cos theta))
    (let dy (call sin theta))
    (let px (- dy))
    (let py dx)
    (let tip-x (+ head-x (* dx petal-len) (* (. sway x) 0.18)))
    (let tip-y (+ head-y (* dy petal-len) (* (. sway y) 0.18)))
    (if has-gradients
      (call fill-gradient-leaf canvas head-x head-y tip-x tip-y dx dy px py petal-len petal-w (. palette base) (. palette bright) has-strokes (. palette vein) (* 1.1 s))
      (else
        (= (. canvas fill-color) (if-expr (== (% p 2) 0) (. palette base) (. palette glaze)))
        (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
        (= (. canvas stroke-width) (* 1.0 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas head-x head-y tip-x tip-y dx dy px py petal-len petal-w)
        (call (. canvas end) true)
      )
    )
    (call (. tally record) 2 has-strokes)
  )
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode screen))
    (= (. canvas fill-color) (. palette glaze))
    (= (. canvas stroke-color) null)
    (call (. canvas circle) head-x head-y (* 18.0 s))
    (= (. canvas blend-mode) (. BlendMode normal))
    (call (. tally record) 4 false)
  )
  (= (. canvas fill-color) (. palette accent))
  (= (. canvas stroke-color) (only-if stamen-gold (if has-strokes)))
  (= (. canvas stroke-width) (* 1.2 s))
  (call (. canvas circle) head-x head-y (* 9.5 s))
  (call (. tally record) 4 has-strokes)
)

(fn-do _ paint-vine-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let a (+ (. specimen angle) 0.55))
  (let span (* 190.0 s))
  (let dx (* (call cos a) span))
  (let dy (* (call sin a) span))
  (let perp-x (- (call sin a)))
  (let perp-y (call cos a))
  (let x0 (- cx (* dx 0.52)))
  (let y0 (- cy (* dy 0.52)))
  (let c1x (+ cx (* perp-x 58.0 s) (* (. sway x) 0.55)))
  (let c1y (+ cy (* perp-y 58.0 s) (* (. sway y) 0.55)))
  (let c2x (- cx (* perp-x 54.0 s) (- (* (. sway x) 0.85))))
  (let c2y (- cy (* perp-y 54.0 s) (- (* (. sway y) 0.85))))
  (let x3 (+ cx (* dx 0.52) (* (. sway x) 0.7)))
  (let y3 (+ cy (* dy 0.52) (* (. sway y) 0.7)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette stem))
    (= (. canvas stroke-width) (* 2.6 s))
    (call (. canvas begin))
    (call (. canvas move) x0 y0)
    (call (. canvas curve) c1x c1y c2x c2y x3 y3)
    (call (. canvas end))
    (call (. tally record) 1 true)
    (= (. canvas stroke-color) (. palette vein))
    (= (. canvas stroke-width) (* 1.35 s))
    (= (. canvas stroke-dash) (* 6.0 s))
    (call (. canvas begin))
    (call (. canvas move) x0 y0)
    (call (. canvas curve) (+ c1x (* perp-x 18.0 s)) (+ c1y (* perp-y 18.0 s)) (- c2x (* perp-x 16.0 s)) (- c2y (* perp-y 16.0 s)) x3 y3)
    (call (. canvas end))
    (= (. canvas stroke-dash) 0)
    (call (. tally record) 1 true)
  )
  (for (in k (..< 0 5))
    (let t (/ (+ (as k F64) 0.6) 5.2))
    (let pt (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 t))
    (let side (if-expr (== (% k 2) 0) 1.0 -1.0))
    (let dir-x (+ (* perp-x side 0.86) (* (call cos a) 0.5)))
    (let dir-y (+ (* perp-y side 0.86) (* (call sin a) 0.5)))
    (let lat-x (- dir-y))
    (let lat-y dir-x)
    (let leaf-len (* 34.0 s))
    (let leaf-w (* 16.0 s))
    (let tip-x (+ (. pt x) (* dir-x leaf-len) (* (. sway x) 0.25)))
    (let tip-y (+ (. pt y) (* dir-y leaf-len) (* (. sway y) 0.25)))
    (if has-gradients
      (call fill-gradient-leaf canvas (. pt x) (. pt y) tip-x tip-y dir-x dir-y lat-x lat-y leaf-len leaf-w (. palette base) (. palette bright) has-strokes (. palette vein) (* 1.0 s))
      (else
        (= (. canvas fill-color) (if-expr (== (% k 2) 0) (. palette base) (. palette bright)))
        (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
        (= (. canvas stroke-width) (* 0.95 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas (. pt x) (. pt y) tip-x tip-y dir-x dir-y lat-x lat-y leaf-len leaf-w)
        (call (. canvas end) true)
      )
    )
    (call (. tally record) 2 has-strokes)
  )
  (if has-strokes
    (let tip (call eval-cubic x0 y0 c1x c1y c2x c2y x3 y3 0.78))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette accent))
    (= (. canvas stroke-width) (* 1.5 s))
    (call (. canvas begin))
    (call (. canvas move) (. tip x) (. tip y))
    (call (. canvas curve)
      (block
        (arg (+ (. tip x) (* perp-x 28.0 s) (* (. sway x) 0.4)))
        (arg (+ (. tip y) (* perp-y 28.0 s) (* (. sway y) 0.4)))
        (arg (+ (. tip x) (* perp-x 42.0 s) (* (call cos a) 22.0 s)))
        (arg (+ (. tip y) (* perp-y 42.0 s) (* (call sin a) 22.0 s)))
        (arg (+ (. tip x) (* perp-x 24.0 s) (* (call cos a) 32.0 s)))
        (arg (+ (. tip y) (* perp-y 24.0 s) (* (call sin a) 32.0 s)))
      )
    )
    (call (. canvas curve)
      (block
        (arg (+ (. tip x) (* perp-x 10.0 s) (* (call cos a) 36.0 s)))
        (arg (+ (. tip y) (* perp-y 10.0 s) (* (call sin a) 36.0 s)))
        (arg (+ (. tip x) (* perp-x 12.0 s) (* (call cos a) 18.0 s)))
        (arg (+ (. tip y) (* perp-y 12.0 s) (* (call sin a) 18.0 s)))
        (arg (+ (. tip x) (* perp-x 22.0 s) (* (call cos a) 22.0 s)))
        (arg (+ (. tip y) (* perp-y 22.0 s) (* (call sin a) 22.0 s)))
      )
    )
    (call (. canvas end))
    (call (. tally record) 2 true)
  )
)

(fn-do _ paint-pod-deformed _
  (param canvas Canvas)
  (param specimen Specimen)
  (param palette BotanicalPalette)
  (param sway WindOffset)
  (param clock F64)
  (param tier PaintTier)
  (param tally Tally)
  (let s (. specimen scale))
  (let cx (. specimen x))
  (let cy (. specimen y))
  (let base-x cx)
  (let base-y (+ cy (* 64.0 s)))
  (let has-strokes (. tier has-strokes))
  (let has-gradients (. tier has-gradients))
  (let has-effects (. tier has-effects))
  (let rock (if-expr (. specimen is-animated) (* (call sin (+ (* clock 1.5) (. specimen phase))) 0.16) 0.0))
  (for (in k (..< 0 4))
    (let spread (+ (. specimen angle) rock (* (- (as k F64) 1.5) 0.44)))
    (let reach (* (+ 66.0 (* (as (% k 2) F64) 22.0)) s))
    (let dx (call sin spread))
    (let dy (- (call cos spread)))
    (let tip-x (+ base-x (* dx reach) (* (. sway x) 0.82)))
    (let tip-y (+ base-y (* dy reach) (* (. sway y) 0.55)))
    (if has-strokes
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (. palette stem))
      (= (. canvas stroke-width) (* 2.0 s))
      (call (. canvas begin))
      (call (. canvas move) base-x base-y)
      (call (. canvas curve) base-x (- base-y (* reach 0.42)) (+ base-x (* dx reach 0.55) (* (. sway x) 0.4)) (+ base-y (* dy reach 0.62)) tip-x tip-y)
      (call (. canvas end))
      (call (. tally record) 1 true)
    )
    (let pod-len (* 34.0 s))
    (let pod-w (* 15.0 s))
    (let lat-x (- dy))
    (let lat-y dx)
    (let pod-tip-x (+ tip-x (* dx pod-len)))
    (let pod-tip-y (+ tip-y (* dy pod-len)))
    (if has-effects
      (= (. canvas blend-mode) (. BlendMode screen))
    )
    (if has-gradients
      (let pod-min-x (- (call min tip-x pod-tip-x) (+ pod-w 6.0)))
      (let pod-min-y (- (call min tip-y pod-tip-y) (+ pod-w 6.0)))
      (let pod-max-x (+ (call max tip-x pod-tip-x) (+ pod-w 6.0)))
      (let pod-max-y (+ (call max tip-y pod-tip-y) (+ pod-w 6.0)))
      (let pod-box (call Rect pod-min-x pod-min-y (- pod-max-x pod-min-x) (- pod-max-y pod-min-y)))
      (let grad-end (call safe-gradient-end tip-x tip-y pod-tip-x pod-tip-y))
      (do-use (. canvas saved-state)
        (call (. canvas begin))
        (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
        (let in-x0 (+ tip-x (* dx pod-len 0.28)))
        (let in-y0 (+ tip-y (* dy pod-len 0.28)))
        (let in-x1 (+ tip-x (* dx pod-len 0.74)))
        (let in-y1 (+ tip-y (* dy pod-len 0.74)))
        (call trace-leaf-blade canvas in-x0 in-y0 in-x1 in-y1 dx dy lat-x lat-y (* pod-len 0.46) (* pod-w 0.42))
        (call (. canvas clip-path) (. FillRule even-odd))
        (call (. canvas fill-gradient) pod-box (call linear-gradient (call Point tip-x tip-y) grad-end (. palette base) (. palette accent)))
      )
      (if has-strokes
        (= (. canvas fill-color) null)
        (= (. canvas stroke-color) (. palette vein))
        (= (. canvas stroke-width) (* 1.15 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
        (call (. canvas end) true)
      )
      (else
        (= (. canvas fill-color) (. palette bright))
        (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
        (= (. canvas stroke-width) (* 1.15 s))
        (call (. canvas begin))
        (call trace-leaf-blade canvas tip-x tip-y pod-tip-x pod-tip-y dx dy lat-x lat-y pod-len pod-w)
        (let in-x0 (+ tip-x (* dx pod-len 0.28)))
        (let in-y0 (+ tip-y (* dy pod-len 0.28)))
        (let in-x1 (+ tip-x (* dx pod-len 0.74)))
        (let in-y1 (+ tip-y (* dy pod-len 0.74)))
        (call trace-leaf-blade canvas in-x0 in-y0 in-x1 in-y1 dx dy lat-x lat-y (* pod-len 0.46) (* pod-w 0.42))
        (call (. canvas end) false (. FillRule even-odd))
      )
    )
    (if has-effects
      (= (. canvas blend-mode) (. BlendMode normal))
    )
    (call (. tally record) 4 has-strokes)
  )
)

(fn-do _ paint-pollinator _
  (param kit BotanicalKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param moth Pollinator)
  (param clock F64)
  (param motion MotionMode)
  (param tier PaintTier)
  (param tally Tally)
  (let t (+ (* clock (. moth speed)) (. moth phase)))
  (let x (+ (. moth home-x) (* (call sin t) (. moth radius-x))))
  (let y (+ (. moth home-y) (* (call sin (* t 2.0)) (. moth radius-y) 0.55)))
  (let vx (* (call cos t) (. moth radius-x) (. moth speed)))
  (let vy (* (call cos (* t 2.0)) (. moth radius-y) 1.1 (. moth speed)))
  (let heading (+ (call atan2 vy vx) (/ π 2)))
  (let flap (+ 0.35 (* 0.65 (call abs (call sin (+ (* clock 9.5) (* (. moth phase) 3.0)))))))
  (let s (* (. moth scale) 0.42))
  (let palette ([] (. kit palettes) (. moth palette)))
  (let has-strokes (. tier has-strokes))
  (if (== motion (. MotionMode transforms))
    (let m (call stamp-matrix x y heading (* s flap) s))
    (let shape (if-expr has-strokes (. kit moth-wings-veined) (. kit moth-wings)))
    (let colors (if-expr has-strokes ([] (. kit accent-palettes) (. moth palette)) ([] (. kit fill-palettes) (. moth palette))))
    (let ignored (call (. table paint-vector) shape canvas colors m))
    (call (. tally record) 4 has-strokes)
    (return)
  )
  (let cosa (call cos heading))
  (let sina (call sin heading))
  (let wing-x (* 28.0 (. moth scale) flap))
  (let wing-y (* 22.0 (. moth scale)))
  (= (. canvas fill-color) (if-expr (. tier has-gradients) (. palette glaze) (. palette accent)))
  (= (. canvas stroke-color) (only-if (. palette vein) (if has-strokes)))
  (= (. canvas stroke-width) (* 1.1 (. moth scale)))
  (for (in side (list -1.0 1.0))
    (let wx (* side wing-x))
    (call (. canvas begin))
    (call (. canvas move) x y)
    (call (. canvas curve)
      (block
        (arg (+ x (- (* wx 0.7 cosa) (* (- wing-y) 1.1 sina))))
        (arg (+ y (* wx 0.7 sina) (* (- wing-y) 1.1 cosa)))
        (arg (+ x (- (* wx 1.25 cosa) (* (- wing-y) 0.15 sina))))
        (arg (+ y (* wx 1.25 sina) (* (- wing-y) 0.15 cosa)))
        (arg (+ x (- (* wx 0.85 cosa) (* (* wing-y 0.45) sina))))
        (arg (+ y (* wx 0.85 sina) (* (* wing-y 0.45) cosa)))
      )
    )
    (call (. canvas curve)
      (block
        (arg (+ x (- (* wx 0.55 cosa) (* (* wing-y 0.85) sina))))
        (arg (+ y (* wx 0.55 sina) (* (* wing-y 0.85) cosa)))
        (arg (+ x (- (* wx 0.15 cosa) (* (* wing-y 0.35) sina))))
        (arg (+ y (* wx 0.15 sina) (* (* wing-y 0.35) cosa)))
        (arg x)
        (arg y)
      )
    )
    (call (. canvas end) true)
    (call (. tally record) 2 has-strokes)
  )
  (if has-strokes
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (. palette vein))
    (= (. canvas stroke-width) (* 1.1 (. moth scale)))
    (call (. canvas begin))
    (call (. canvas move) (+ x (* 10.0 (. moth scale) sina)) (- y (* 10.0 (. moth scale) cosa)))
    (call (. canvas line) (- x (* 12.0 (. moth scale) sina)) (+ y (* 12.0 (. moth scale) cosa)))
    (call (. canvas end))
    (call (. tally record) 1 true)
  )
)

(fn-do _ fill-gradient-leaf _
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param out-x F64)
  (param out-y F64)
  (param lat-x F64)
  (param lat-y F64)
  (param len F64)
  (param width F64)
  (param start-color RGBA)
  (param end-color RGBA)
  (param stroked Bool)
  (param stroke-col RGBA)
  (param width-px F64)
  (let pad (+ width 6.0))
  (let min-x (- (call min x0 x1) pad))
  (let min-y (- (call min y0 y1) pad))
  (let max-x (+ (call max x0 x1) pad))
  (let max-y (+ (call max y0 y1) pad))
  (let box (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
  (let grad-end (call safe-gradient-end x0 y0 x1 y1))
  (do-use (. canvas saved-state)
    (call (. canvas begin))
    (call trace-leaf-blade canvas x0 y0 x1 y1 out-x out-y lat-x lat-y len width)
    (call (. canvas clip-path))
    (call (. canvas fill-gradient) box (call linear-gradient (call Point x0 y0) grad-end start-color end-color))
  )
  (if stroked
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) stroke-col)
    (= (. canvas stroke-width) width-px)
    (call (. canvas begin))
    (call trace-leaf-blade canvas x0 y0 x1 y1 out-x out-y lat-x lat-y len width)
    (call (. canvas end) true)
  )
)

(fn-do _ trace-leaf-blade _
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param out-x F64)
  (param out-y F64)
  (param lat-x F64)
  (param lat-y F64)
  (param len F64)
  (param width F64)
  (let c1x (+ x0 (* out-x len 0.34) (* lat-x width)))
  (let c1y (+ y0 (* out-y len 0.34) (* lat-y width)))
  (let c2x (+ x0 (* out-x len 0.74) (* lat-x width 0.55)))
  (let c2y (+ y0 (* out-y len 0.74) (* lat-y width 0.55)))
  (let c3x (- (+ x0 (* out-x len 0.74)) (* lat-x width 0.55)))
  (let c3y (- (+ y0 (* out-y len 0.74)) (* lat-y width 0.55)))
  (let c4x (- (+ x0 (* out-x len 0.34)) (* lat-x width)))
  (let c4y (- (+ y0 (* out-y len 0.34)) (* lat-y width)))
  (call (. canvas move) x0 y0)
  (call (. canvas curve) c1x c1y c2x c2y x1 y1)
  (call (. canvas curve) c3x c3y c4x c4y x0 y0)
  (call (. canvas enclose))
)

(fn-expr _ safe-gradient-end Point
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (if-expr (< (+ (* dx dx) (* dy dy)) 1.0)
    (call Point (+ x0 1.0) y0)
    (call Point x1 y1)
  )
  (where
    (lazy dx (- x1 x0))
    (lazy dy (- y1 y0))
  )
)

(fn-expr _ eval-cubic Point
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param x2 F64)
  (param y2 F64)
  (param x3 F64)
  (param y3 F64)
  (param t F64)
  (call Point (+ (* u3 x0) (* 3 u2 t x1) (* 3 u t2 x2) (* t3 x3)) (+ (* u3 y0) (* 3 u2 t y1) (* 3 u t2 y2) (* t3 y3)))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy u3 (* u2 u))
    (lazy t2 (* t t))
    (lazy t3 (* t2 t))
  )
)

(fn-expr _ stamp-matrix Matrix
  (param tx F64)
  (param ty F64)
  (param angle F64)
  (param sx F64)
  (param sy F64)
  (call Matrix (* cosa sx) (* sina sx) (* (- sina) sy) (* cosa sy) tx ty)
  (where
    (lazy cosa (call cos angle))
    (lazy sina (call sin angle))
  )
)

(fn-do _ fern-blade-geometry VectorGeometry
  (param stroked Bool)
  (let blade (call Path))
  (call (. blade move-to) 0 0)
  (call (. blade cubic-curve-to) 32 -28 74 -20 100 0)
  (call (. blade cubic-curve-to) 74 20 32 28 0 0)
  (call (. blade close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan blade fill-paint stroke-paint (only-if 2.2 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (if stroked
    (let vein (call Path))
    (call (. vein move-to) 4 0)
    (call (. vein cubic-curve-to) 34 -4 62 4 86 0)
    (+= spans (call VectorGeometrySpan vein none-paint stroke-paint 1.8 (. LineCap round) (. LineJoin round) (. FillRule nonzero)))
  )
  (return (call VectorGeometry (call Rect -10 -40 120 80) (call Rect -16 -46 132 92) spans false false))
)

(fn-do _ petal-geometry VectorGeometry
  (param stroked Bool)
  (let petal (call Path))
  (call (. petal move-to) 0 0)
  (call (. petal cubic-curve-to) 24 -42 82 -34 100 0)
  (call (. petal cubic-curve-to) 82 34 24 42 0 0)
  (call (. petal close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan petal fill-paint stroke-paint (only-if 2.0 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (return (call VectorGeometry (call Rect -10 -48 120 96) (call Rect -16 -54 132 108) spans false false))
)

(fn-do _ core-geometry VectorGeometry
  (let outline (call Path))
  (let r 44.0)
  (let k (* r 0.5522847498307936))
  (call (. outline move-to) r 0)
  (call (. outline cubic-curve-to) r k k r 0 r)
  (call (. outline cubic-curve-to) (- k) r (- r) k (- r) 0)
  (call (. outline cubic-curve-to) (- r) (- k) (- k) (- r) 0 (- r))
  (call (. outline cubic-curve-to) k (- r) r (- k) r 0)
  (call (. outline close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (return (call VectorGeometry (call Rect -50 -50 100 100) (call Rect -56 -56 112 112) (list (call VectorGeometrySpan outline fill-paint none-paint null null null (. FillRule nonzero))) false false))
)

(fn-do _ vine-leaf-geometry VectorGeometry
  (param stroked Bool)
  (let leaf (call Path))
  (call (. leaf move-to) 0 0)
  (call (. leaf cubic-curve-to) 16 -48 76 -42 100 0)
  (call (. leaf cubic-curve-to) 76 42 16 48 0 0)
  (call (. leaf close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan leaf fill-paint stroke-paint (only-if 2.0 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (if stroked
    (let rib (call Path))
    (call (. rib move-to) 6 0)
    (call (. rib cubic-curve-to) 36 -5 64 5 84 0)
    (+= spans (call VectorGeometrySpan rib none-paint stroke-paint 1.6 (. LineCap round) (. LineJoin round) (. FillRule nonzero)))
  )
  (return (call VectorGeometry (call Rect -10 -50 120 100) (call Rect -16 -56 132 112) spans false false))
)

(fn-do _ seed-capsule-geometry VectorGeometry
  (param stroked Bool)
  (let pod (call Path))
  (call (. pod move-to) 0 0)
  (call (. pod cubic-curve-to) -38 -24 -32 -78 0 -100)
  (call (. pod cubic-curve-to) 32 -78 38 -24 0 0)
  (call (. pod close))
  (call (. pod move-to) 0 -24)
  (call (. pod cubic-curve-to) -16 -36 -14 -64 0 -76)
  (call (. pod cubic-curve-to) 14 -64 16 -36 0 -24)
  (call (. pod close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan pod fill-paint stroke-paint (only-if 2.2 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule even-odd))))
  (return (call VectorGeometry (call Rect -44 -106 88 112) (call Rect -50 -112 100 124) spans false false))
)

(fn-do _ moth-geometry VectorGeometry
  (param stroked Bool)
  (let wings (call Path))
  (call (. wings move-to) 0 0)
  (call (. wings cubic-curve-to) -42 -48 -84 -16 -56 18)
  (call (. wings cubic-curve-to) -36 42 -12 24 0 0)
  (call (. wings close))
  (call (. wings move-to) 0 0)
  (call (. wings cubic-curve-to) 42 -48 84 -16 56 18)
  (call (. wings cubic-curve-to) 36 42 12 24 0 0)
  (call (. wings close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke-paint (if-expr stroked (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none-paint))
  (let spans (list (call VectorGeometrySpan wings fill-paint stroke-paint (only-if 2.4 (if stroked)) (. LineCap round) (. LineJoin round) (. FillRule nonzero))))
  (return (call VectorGeometry (call Rect -90 -54 180 100) (call Rect -96 -60 192 112) spans false false))
)
