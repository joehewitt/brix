(import ./herbarium-camera)
(import ./herbarium-paint)
(import ./herbarium-scene)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui)
(import /math)
(import /time/duration)
(blank)
(prop _ precise-zoom-rate _ (= 0.01))
(prop _ line-zoom-rate _ (= 0.15))
(prop _ wheel-line _ (= 40.0))
(prop _ click-slop _ (= 4.0))
(prop _ longest-step _ (= 0.1))
(prop _ sample-period _ (= 0.5))
(prop _ latency-lag _ (= 8))
(prop + empty-frame-times _ (= (call FrameTimes -1 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns)))

(type + HerbariumSample (is Tuple)
  (prop + zoom F64)
  (prop + visible Int)
  (prop + animated Int)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + frames-per-second F64)
  (prop + frames Int)
  (prop + times FrameTimes)
  (prop + latency-ms F64)
  (prop + gpu-ms F64)
  (prop + draw-calls I64)
)

(type _ HerbariumStaticLayer (is Box)
  (prop + owner (? HerbariumView) (= null))
  (fn-expr + content-transform _ :get
    (?. owner camera-transform)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let view owner)
    (return-if (if (not view)))
    (call (. view paint-static-layer) canvas markup-batch-root)
  )
)

(type _ HerbariumDynamicLayer (is Box)
  (prop + owner (? HerbariumView) (= null))
  (fn-expr + content-transform _ :get
    (?. owner camera-transform)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let view owner)
    (return-if (if (not view)))
    (call (. view paint-dynamic-layer) canvas markup-batch-root)
  )
)

(type + HerbariumView (is Box)
  (prop + specimen-count _ (= 1000))
  (prop + animated-share _ (= 5))
  (prop + motion-mode _ (= (. MotionMode deform)))
  (prop + paint-tier _ (= (. PaintTier strokes)))
  (prop + split-layers _ (= true))
  (prop + is-touring _ (= false))
  (event + measured HerbariumSample)
  (prop _ camera _ (= (call HerbariumCamera)))
  (prop _ field _ (= (call HerbariumField 1000 5)))
  (prop _ kit (? BotanicalKit) (= null))
  (prop _ gusts _ (= (call GustField)))
  (prop _ clock _ (= 0.0))
  (prop _ tour-clock _ (= 0.0))
  (prop _ pressed-at (? Point) (= null))
  (prop _ is-panning _ (= false))
  (prop _ static-counts _ (= (call SceneCounts 0 0 0)))
  (prop _ dynamic-counts _ (= (call SceneCounts 0 0 0)))
  (prop _ was-active _ (= false))
  (prop _ last-frame _ (= -1))
  (prop _ last-done _ (= -1))
  (prop _ sampled-time _ (= 0.0))
  (prop _ active-time _ (= 0.0))
  (prop _ active-ticks _ (= 0))
  (prop _ frame-count _ (= 0))
  (prop _ frame-times _ (= empty-frame-times))
  (prop _ latency-nanos _ (= 0))
  (prop _ latency-count _ (= 0))
  (prop _ gpu-frames _ (= 0))
  (prop _ gpu-nanos _ (= 0))
  (prop _ draw-calls _ (= 0))
  (depends rebuild-scene specimen-count animated-share)
  (depends invalidate-all-layers motion-mode paint-tier split-layers)
  (depends start-tour is-touring)
  (prop _ running _
    (machine
      (state live
        (for (on tick frames)
          (call advance (call min longest-step (as (as (. tick delta) Seconds) F64)))
        )
      )
    )
  )
  (content
    (<> This
      (<> HerbariumStaticLayer (id: static-layer) (• cover .parent)
        (= owner this)
      )
      (<> HerbariumDynamicLayer (id: dynamic-layer) (• cover .parent)
        (= owner this)
        (= drag-cursor (. CursorStyle closed-hand))
      )
      (for (on event scroll)
        (= is-touring false)
        (let modifiers (. event modifiers))
        (if (or (. modifiers command) (. modifiers control) (. modifiers option))
          (let rate (if-expr (. event is-precise) precise-zoom-rate line-zoom-rate))
          (call (. camera zoom-by) (call exp (* (- (. event delta-y)) rate)) (. event point))
          (else
            (let line (if-expr (. event is-precise) 1.0 wheel-line))
            (call (. camera pan) (call Point (* (- (. event delta-x)) line) (* (- (. event delta-y)) line)))
          )
        )
        (call sync-transforms)
        (call (. event cancel))
      )
      (for (on event magnify)
        (= is-touring false)
        (call (. camera pinch) (. event scale) (. event point))
        (call sync-transforms)
        (call (. event cancel))
      )
      (for (on event pointer-down)
        (if (== (. event button) (. PointerButton primary))
          (= pressed-at (. event point))
          (= is-panning false)
          (call (. event cancel))
        )
      )
      (for (on event pointer-drag)
        (let origin pressed-at)
        (if origin
          (if (or is-panning (>= (call (. origin distance) (. event point)) click-slop))
            (= is-touring false)
            (= is-panning true)
            (call (. camera pan) (. event delta))
            (call sync-transforms)
          )
          (call (. event cancel))
        )
      )
      (for (on event pointer-up)
        (let origin pressed-at)
        (if (and origin (not is-panning) (not (. event is-interrupted)))
          (call (. gusts spawn) (call (. camera world-point) (. event point)) clock)
        )
        (= pressed-at null)
        (= is-panning false)
      )
    )
  )
  (fn-expr + camera-transform Matrix :get
    (. camera transform)
  )
  (fn-do + fit _
    (= is-touring false)
    (call (. camera fit))
  )
  (fn-do + paint-static-layer _
    (param canvas Canvas)
    (param batch-root _)
    (if (and (not split-layers) (> animated-share 0))
      (= static-counts (call SceneCounts 0 0 0))
      (return)
    )
    (let table (call vector-geometry-table-for batch-root))
    (let assets (?? kit (call BotanicalKit table)))
    (= kit assets)
    (let include-anim (and (not split-layers) (== animated-share 0)))
    (= static-counts (call paint-herbarium-layer assets table canvas field clock (. gusts gusts) motion-mode paint-tier true include-anim))
  )
  (fn-do + paint-dynamic-layer _
    (param canvas Canvas)
    (param batch-root _)
    (if (== animated-share 0)
      (= dynamic-counts (call SceneCounts 0 0 0))
      (return)
    )
    (let table (call vector-geometry-table-for batch-root))
    (let assets (?? kit (call BotanicalKit table)))
    (= kit assets)
    (let include-static (not split-layers))
    (= dynamic-counts (call paint-herbarium-layer assets table canvas field clock (. gusts gusts) motion-mode paint-tier include-static true))
  )
  (fn-do _ rebuild-scene _
    (= field (call HerbariumField specimen-count animated-share))
    (call invalidate-all-layers)
  )
  (fn-do _ invalidate-all-layers _
    (call (. static-layer invalidate-paint))
    (call (. dynamic-layer invalidate-paint))
  )
  (fn-do _ sync-transforms _
    (call (. static-layer invalidate-content-transform))
    (call (. dynamic-layer invalidate-content-transform))
  )
  (fn-do _ start-tour _
    (if is-touring
      (= tour-clock (* tour-period 0.5))
    )
  )
  (fn-do _ advance _
    (param seconds F64)
    (let placed (. camera is-placed))
    (call (. camera place) (. bounds size) (. field extent))
    (let moved (call move-camera seconds))
    (if (or moved (not placed))
      (call sync-transforms)
    )
    (let animating (> animated-share 0))
    (if animating
      (+= clock seconds)
      (call (. gusts prune) clock)
      (call (. dynamic-layer invalidate-paint))
    )
    (call sample seconds (or moved animating))
  )
  (fn-do _ move-camera Bool
    (param seconds F64)
    (if is-touring
      (+= tour-clock seconds)
      (call (. camera tour) tour-clock)
      (return true)
    )
    (return (call (. camera step) seconds))
  )
  (fn-do _ sample _
    (param seconds F64)
    (param active Bool)
    (let root window)
    (return-if (if (not root)))
    (blank)
    (let host (as root Window))
    (let frame (. host last-metal-frame-id))
    (if (and was-active (!= frame last-frame))
      (+= frame-count 1)
      (let times (. host last-frame-times))
      (if times
        (= frame-times (call summed-times frame-times times))
      )
      (let latency (call (. host metal-frame-input-latency-nanos) (- frame latency-lag)))
      (if (>= latency 0)
        (+= latency-nanos latency)
        (+= latency-count 1)
      )
      (= draw-calls (. host metal-draw-calls))
    )
    (= last-frame frame)
    (let done (. host completed-metal-frame-id))
    (if (and was-active (!= done last-done))
      (let spent (call (. host metal-frame-gpu-nanos) done))
      (if (>= spent 0)
        (+= gpu-frames 1)
        (+= gpu-nanos spent)
      )
    )
    (= last-done done)
    (if active
      (+= active-time seconds)
      (+= active-ticks 1)
    )
    (= was-active active)
    (+= sampled-time seconds)
    (return-if (if (< sampled-time sample-period)))
    (blank)
    (if (> frame-count 0)
      (<- measured
        (call HerbariumSample
          (block
            (arg (. camera scale))
            (arg (call (. field visible-specimens) (. camera world-bounds)))
            (arg (. field animated-count))
            (arg (+ (. static-counts paths) (. dynamic-counts paths)))
            (arg (+ (. static-counts segments) (. dynamic-counts segments)))
            (arg (+ (. static-counts strokes) (. dynamic-counts strokes)))
            (arg (if-expr (> active-time 0) (/ (as active-ticks F64) active-time) 0.0))
            (arg frame-count)
            (arg frame-times)
            (arg (if-expr (> latency-count 0) (/ (as latency-nanos F64) (* (as latency-count F64) 1000000)) -1.0))
            (arg (if-expr (> gpu-frames 0) (/ (as gpu-nanos F64) (* (as gpu-frames F64) 1000000)) 0.0))
            (arg draw-calls)
          )
        )
      )
    )
    (= sampled-time 0.0)
    (= active-time 0.0)
    (= active-ticks 0)
    (= frame-count 0)
    (= frame-times empty-frame-times)
    (= latency-nanos 0)
    (= latency-count 0)
    (= gpu-frames 0)
    (= gpu-nanos 0)
  )
)

(fn-expr _ summed-times FrameTimes
  (param sum FrameTimes)
  (param times FrameTimes)
  (call FrameTimes
    (block
      (arg (. times frame))
      (arg (+ (. sum input) (. times input)))
      (arg (+ (. sum tick) (. times tick)))
      (arg (+ (. sum update) (. times update)))
      (arg (+ (. sum layout) (. times layout)))
      (arg (+ (. sum record) (. times record)))
      (arg (+ (. sum encode) (. times encode)))
      (arg (+ (. sum walk) (. times walk)))
      (arg (+ (. sum native) (. times native)))
      (arg (+ (. sum commit) (. times commit)))
      (arg (+ (. sum total) (. times total)))
    )
  )
)
