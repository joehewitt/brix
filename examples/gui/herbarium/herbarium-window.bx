(import ./herbarium-scene)
(import ./herbarium-theme)
(import ./herbarium-view)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/layers)
(import /gui/icons/lucide/maximize)
(import /gui/icons/lucide/play)
(import /math)
(import /time/duration)
(blank)
(prop _ density-choices _ (= (list 250 1000 4000)))
(prop _ share-choices _ (= (list 0 5 50 100)))
(prop _ motion-choices _ (= (list (. MotionMode transforms) (. MotionMode deform))))
(prop _ paint-choices _ (= (list (. PaintTier fills) (. PaintTier strokes) (. PaintTier gradients) (. PaintTier effects))))

(type + HerbariumWindow (is Window)
  (using HerbariumTheme)
  (prop + specimen-count _ (= 1000))
  (prop + animated-share _ (= 5))
  (prop + motion-mode _ (= (. MotionMode deform)))
  (prop + paint-tier _ (= (. PaintTier gradients)))
  (prop + split-layers _ (= true))
  (prop + is-touring _ (= false))
  (prop + sample _ (= (call HerbariumSample 1 0 0 0 0 0 0 0 empty-frame-times -1 0 0)))
  (prop + is-measured _ (= (> (. #sample frames) 0)))
  (content
    (<> This
      (= title "Living Herbarium")
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= size (call Dimensions 1440 900))
      (= state-key "living-herbarium")
      (= background $herbarium-ground-color)
      (blank)
      (<> HerbariumView (id: herbarium) (• herbarium-surface) (• cover .parent)
        (= specimen-count #specimen-count)
        (= animated-share #animated-share)
        (= motion-mode #motion-mode)
        (= paint-tier #paint-tier)
        (= split-layers #split-layers)
        (<-> is-touring is-touring)
        (for (on value measured)
          (= sample value)
        )
      )
      (<> Box (• herbarium-stats)
        (= left (call (. PositionOffset coord) 16))
        (= bottom (call (. PositionOffset coord) 16))
        (<> Label (• herbarium-stats-title)
          (= text (call scene-line #specimen-count #sample #split-layers))
        )
        (<> Label (• herbarium-stats-line)
          (= text (call geometry-line #sample))
        )
        (<> Label (• herbarium-stats-line)
          (= text (call frame-line #sample))
        )
        (if #is-measured
          (<> Label (• herbarium-stats-line)
            (= text (call phase-line #sample))
          )
          (<> Label (• herbarium-stats-line)
            (= text (call latency-line #sample))
          )
        )
        (<> Label (• herbarium-stats-note)
          (= text (call mode-note #motion-mode #paint-tier #split-layers))
        )
      )
      (<> Toolbar (• absolute)
        (= left (call (. PositionOffset coord) 0))
        (= right (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (= is-title-bar true)
        (<> ToolbarTitle (text: "Living Herbarium"))
        (<> ToolbarGroup
          (<> (of SegmentedControl Int)
            (<-> selected specimen-count)
            (for (in choice density-choices)
              (<> (of Segment Int) (text: (call density-label choice))
                (= value choice)
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> (of SegmentedControl Int)
            (<-> selected animated-share)
            (for (in choice share-choices)
              (<> (of Segment Int) (text: (str choice "%"))
                (= value choice)
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> (of SegmentedControl MotionMode)
            (<-> selected motion-mode)
            (for (in choice motion-choices)
              (<> (of Segment MotionMode) (text: (. choice title))
                (= value choice)
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> MenuButton (text: (. #paint-tier title))
            (<> Menu
              (for (in choice paint-choices)
                (<> MenuItem
                  (= title (. choice title))
                  (= is-on (== #paint-tier choice))
                  (= action (=> () :do (= paint-tier choice)))
                )
              )
            )
          )
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> ToolbarButton (text: (if-expr #split-layers "Split" "Single")) (• icon-layers)
            (= is-on #split-layers)
            (= action (=> () :do (= split-layers (not split-layers))))
          )
          (<> ToolbarButton (text: "Tour") (• icon-play)
            (= is-on #is-touring)
            (= action (=> () :do (= is-touring (not is-touring))))
          )
          (<> ToolbarButton (text: "Fit") (• icon-maximize)
            (= action (=> () :do (call (. herbarium fit))))
          )
        )
      )
    )
  )
)

(fn-expr _ density-label String
  (param count Int)
  (if-expr (>= count 1000)
    (str (/ count 1000) "k")
    (str count)
  )
)

(fn-expr _ scene-line String
  (param count Int)
  (param sample HerbariumSample)
  (param split Bool)
  (str count " specimens · " (. sample visible) " in view · " (. sample animated) " live · " (if-expr split "split layers" "single chunk"))
)

(fn-expr _ geometry-line String
  (param sample HerbariumSample)
  (str "Zoom " (call rounded (* (. sample zoom) 100) 1) "% · " (. sample paths) " paths · " (. sample segments) " cubics · " (. sample strokes) " strokes")
)

(fn-expr _ frame-line String
  (param sample HerbariumSample)
  (if-expr (== (. sample frames) 0)
    "Pan, zoom, tour or animate to measure frames"
    (str (call rounded (. sample frames-per-second) 0) " fps · main thread " (call per-frame sample (. sample times total)) " ms · GPU " (call rounded (. sample gpu-ms) 2) " ms · " (. sample draw-calls) " draw calls")
  )
)

(fn-expr _ phase-line String
  (param sample HerbariumSample)
  (str "input " (call per-frame sample (. sample times input)) " · tick " (call per-frame sample (. sample times tick)) " · update " (call per-frame sample (. sample times update)) " · layout " (call per-frame sample (. sample times layout)) " · record " (call per-frame sample (. sample times record)) " · walk " (call per-frame sample (. sample times walk)) " · encode " (call per-frame sample (. sample times encode)) " (native " (call per-frame sample (. sample times native)) ") · commit " (call per-frame sample (. sample times commit)) " ms")
)

(fn-expr _ latency-line String
  (param sample HerbariumSample)
  (if-expr (< (. sample latency-ms) 0)
    "Input to screen: no input in this sample"
    (str "Input to screen " (call rounded (. sample latency-ms) 1) " ms")
  )
)

(fn-expr _ mode-note String
  (param motion MotionMode)
  (param tier PaintTier)
  (param split Bool)
  (str (. motion title) " · " (. tier title) " · " (if-expr split "static foliage stays retained" "whole scene re-records on animation") " · click canvas for a wind gust")
)

(fn-expr _ per-frame F64
  (param sample HerbariumSample)
  (param value Nanoseconds)
  (call rounded (/ (as (as value I64) F64) (* (as (. sample frames) F64) 1000000)) 2)
)

(fn-expr _ rounded F64
  (param value F64)
  (param places Int)
  (/ (call round (* value scale)) scale)
  (where
    (lazy scale (%% 10.0 (as places F64)))
  )
)
