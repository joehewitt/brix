(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ zoom-ease _ (= 0.09))
(prop _ closest-zoom _ (= 4.5))
(prop _ fit-margin _ (= 0.92))
(prop + tour-period _ (= 24.0))
(prop _ tour-near _ (= 1.6))

(type + HerbariumCamera
  (prop + center _ (= (call Point 0 0)))
  (prop + scale _ (= 1.0))
  (prop + goal _ (= 1.0))
  (prop + view _ (= (call Dimensions 0 0)))
  (prop + garden _ (= (call Dimensions 0 0)))
  (prop + is-placed _ (= false))
  (prop _ anchor _ (= (call Point 0 0)))
  (prop _ aim (? Point) (= null))
  (fn-expr + transform Matrix :get
    (call Matrix scale 0 0 scale (- (/ (. view width) 2) (* (. center x) scale)) (- (/ (. view height) 2) (* (. center y) scale)))
  )
  (fn-expr + fit-scale F64 :get
    (* fit-margin (call min (/ (. view width) (call max 1 (. garden width))) (/ (. view height) (call max 1 (. garden height)))))
  )
  (fn-expr + low F64 :get
    (* fit-scale 0.45)
  )
  (fn-expr + garden-center Point :get
    (call Point (/ (. garden width) 2) (/ (. garden height) 2))
  )
  (fn-expr + world-bounds Rect :get
    (call Rect (- (. center x) (/ (. view width) (* 2 scale))) (- (. center y) (/ (. view height) (* 2 scale))) (/ (. view width) scale) (/ (. view height) scale))
  )
  (fn-expr + world-point Point
    (param point Point)
    (call Point (+ (. center x) (/ (- (. point x) (/ (. view width) 2)) scale)) (+ (. center y) (/ (- (. point y) (/ (. view height) 2)) scale)))
  )
  (fn-do + place Bool
    (param size Dimensions)
    (param extent Dimensions)
    (let resized (or (!= (. size width) (. view width)) (!= (. size height) (. view height))))
    (= view size)
    (if (or (!= (. extent width) (. garden width)) (!= (. extent height) (. garden height)))
      (= garden extent)
      (= is-placed false)
    )
    (return-if (and is-placed resized (> (. size width) 0) (> (. size height) 0)) (if (or is-placed (<= (. size width) 0) (<= (. size height) 0))))
    (blank)
    (= scale fit-scale)
    (= goal scale)
    (= center garden-center)
    (= aim null)
    (= is-placed true)
    (return true)
  )
  (fn-do + fit _
    (= anchor (call Point (/ (. view width) 2) (/ (. view height) 2)))
    (= goal fit-scale)
    (= aim garden-center)
  )
  (fn-do + zoom-by _
    (param factor F64)
    (param point Point)
    (= anchor point)
    (= aim null)
    (= goal (call clamp (* goal factor) low closest-zoom))
  )
  (fn-do + pinch _
    (param factor F64)
    (param point Point)
    (call zoom-by factor point)
    (call zoom-to goal)
  )
  (fn-do + pan _
    (param delta Point)
    (= aim null)
    (= center (call Point (- (. center x) (/ (. delta x) scale)) (- (. center y) (/ (. delta y) scale))))
  )
  (fn-do + step Bool
    (param seconds F64)
    (let blend (- 1 (call exp (/ (- seconds) zoom-ease))))
    (let target aim)
    (if target
      (if (< (call (. center distance) target) (/ 0.5 scale))
        (= center target)
        (= aim null)
        (else
          (= center (call Point (+ (. center x) (* (- (. target x) (. center x)) blend)) (+ (. center y) (* (- (. target y) (. center y)) blend))))
        )
      )
    )
    (return-if (!= target null) (if (== scale goal)))
    (blank)
    (let next (call exp (+ (call log scale) (* (- (call log goal) (call log scale)) blend))))
    (call zoom-to (if-expr (< (call abs (- (/ next goal) 1)) 0.0005) goal next))
    (return true)
  )
  (fn-do + tour _
    (param clock F64)
    (let phase (/ clock tour-period))
    (let depth (- 0.5 (* 0.5 (call cos (* 2 π phase)))))
    (let near (call max tour-near fit-scale))
    (= scale (call exp (+ (call log near) (* (- (call log fit-scale) (call log near)) depth))))
    (= goal scale)
    (= aim null)
    (let wander-x (* (. garden width) (+ 0.5 (* 0.42 (call sin (* 2 π phase 0.61))))))
    (let wander-y (* (. garden height) (+ 0.5 (* 0.42 (call sin (+ 1 (* 2 π phase 0.43)))))))
    (let home garden-center)
    (= center (call Point (+ wander-x (* (- (. home x) wander-x) depth)) (+ wander-y (* (- (. home y) wander-y) depth))))
  )
  (fn-do _ zoom-to _
    (param next F64)
    (let held (call world-point anchor))
    (= scale next)
    (let moved (call world-point anchor))
    (= center (call Point (+ (. center x) (- (. held x) (. moved x))) (+ (. center y) (- (. held y) (. moved y)))))
  )
)
