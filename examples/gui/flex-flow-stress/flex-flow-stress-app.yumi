━━━━━━━━━━━━━━━━━━━━
+ stress-navigation-data StressNavigationData
    - key String

match key
    | "Overview"
        StressNavigationData(key, "12")
    | "Active incidents"
        StressNavigationData(key, "4")
    | "Deployments"
        StressNavigationData(key, "18")
    | "Long-running workflows"
        StressNavigationData(key, "203")
    | "Audit and compliance"
        StressNavigationData(key, "7")
    ??
        StressNavigationData(key, "—")

━━━━━━━━━━━━━━━━━━━━
+ stress-capacity-data StressCapacityData
    - key String

match key
    | "Compute"
        StressCapacityData(key, "74%", 0.74, "#3b82f6")
    | "Storage"
        StressCapacityData(key, "58%", 0.58, "#8b5cf6")
    | "Network"
        StressCapacityData(key, "31%", 0.31, "#f59e0b")
    ??
        StressCapacityData(key, "0%", 0, "#94a3b8")

━━━━━━━━━━━━━━━━━━━━
+ stress-metric-data StressMetricData
    - key String

match key
    | "THROUGHPUT"
        StressMetricData(key, "18.4k", "+12.8% over baseline", "#2563eb")
    | "P95 LATENCY"
        StressMetricData(key, "47 ms", "9 ms below budget", "#7c3aed")
    | "ACTIVE JOBS"
        StressMetricData(key, "1,284", "Across 32 elastic pools", "#0891b2")
    | "ERROR RATE"
        StressMetricData(key, "0.08%", "Stable for 6 hours", "#ea580c")
    ??
        StressMetricData(key, "—", "No sample", "#94a3b8")

━━━━━━━━━━━━━━━━━━━━
+ stress-activity-data StressActivityData
    - key String

match key
    | "asset-indexer"
        StressActivityData(key, "us-west", "RUNNING", "02:14", "#3b82f6")
    | "billing-rollup-long-name"
        StressActivityData(key, "eu-central", "QUEUED", "00:38", "#8b5cf6")
    | "thumbnail-fanout"
        StressActivityData(key, "ap-south", "RUNNING", "04:51", "#06b6d4")
    | "compliance-export"
        StressActivityData(key, "us-east", "WAITING", "11:07", "#f59e0b")
    | "search-compaction"
        StressActivityData(key, "eu-west", "RUNNING", "01:43", "#10b981")
    | "warehouse-snapshot"
        StressActivityData(key, "us-west", "QUEUED", "00:19", "#ec4899")
    ??
        StressActivityData(key, "unknown", "IDLE", "00:00", "#94a3b8")

━━━━━━━━━━━━━━━━━━━━
+ stress-lane-data StressLaneData
    - key String

match key
    | "CPU burst"
        StressLaneData(key, "8 workers", "#3b82f6")
    | "Cache fill"
        StressLaneData(key, "3 workers", "#8b5cf6")
    | "Object sync"
        StressLaneData(key, "12 workers", "#06b6d4")
    | "Cold archive"
        StressLaneData(key, "2 workers", "#f59e0b")
    ??
        StressLaneData(key, "0 workers", "#94a3b8")

━━━━━━━━━━━━━━━━━━━━
+ stress-signal-data StressSignalData
    - key String

match key
    | "Input records"
        StressSignalData(key, "482,991")
    | "Output records"
        StressSignalData(key, "471,238")
    | "Memory high-water"
        StressSignalData(key, "1.8 GB")
    | "Checkpoint age"
        StressSignalData(key, "12 sec")
    ??
        StressSignalData(key, "—")
