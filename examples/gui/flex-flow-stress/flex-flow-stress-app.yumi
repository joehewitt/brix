━━━━━━━━━━━━━━━━━━━━
+ FlexFlowStressWindow is Window
    using FlexFlowStressTheme

━━━━━━━━━━━━━━━━━━━━
+ StressPill is Box

+ label String

────────────────────
+ This
    - label

────────────────────

<This • stress-pill flow-row
    <Label
        text = label

━━━━━━━━━━━━━━━━━━━━
+ StressNavigationData is Tuple

+ label String
+ count String

━━━━━━━━━━━━━━━━━━━━
+ StressNavigationRow is Box

+ key String
+ data => stress-navigation-data(key)

────────────────────
+ This
    - key

────────────────────

<This • navigation-row flex-row
    <Label • navigation-label flex:1
        text = data.label
    <Label • navigation-count
        text = data.count

━━━━━━━━━━━━━━━━━━━━
+ StressCapacityData is Tuple

+ label String
+ value String
+ fraction Float
+ accent RGBA

━━━━━━━━━━━━━━━━━━━━
+ StressCapacityRow is Box

+ key String
+ data => stress-capacity-data(key)

────────────────────
+ This
    - key

────────────────────

<This • flow-col
    <Box • flex-row
        <Label • capacity-label flex:1
            text = data.label
        <Label • capacity-value
            text = data.value
    <Box • capacity-track flex-row h:7 mt:5
        <Box • capacity-fill flex:data.fraction bg:data.accent
        <Box • flex:(1 - data.fraction)

