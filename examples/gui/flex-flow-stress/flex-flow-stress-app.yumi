<This • metric-card flex-col flex:1
    <Box • flex-row h:18
        <Label • metric-kicker flex:1
            text = data.kicker
        <Box • metric-spark w:28 h:5 bg:data.accent
    <Label • metric-value mt:5
        text = data.value
    <Label • metric-detail mt:3
        text = data.detail

