/graphics/color
/graphics/text
/gui

<App
    <FlexFlowStressWindow • flex-col p:16
        title = "Yumi GUI: Flex + Flow Resize Stress"
        size = (1240, 820)

        ` Resize continuously across both axes. The alternating flex/flow tree deliberately mixes
        ` natural content, fixed dimensions, weights, margins, padding, and min/max clamps.
        <Box • topbar flex-row h:72 px:18 py:11
            <Box • flex-col flex:1
                <Label • title-label
                    text = "Operations layout stress"

                <Label • subtitle-label mt:4
                    text = "Alternating layouts · intrinsic controls · fixed + weighted boxes"

            <Box • header-pills flow-row
                <StressPill "LIVE RESIZE" • pill-green
                <StressPill "FLEX 17" • ml:7
                <StressPill "FLOW 23" • ml:7

        <Box • workspace flex-row flex:1 mt:12
            ` Fixed outer width, vertically flexed regions, and naturally measured rows.
            <Box • sidebar flex-col w:236 p:13
                <Box • account-row flow-row
                    <Box • avatar w:38 h:38
                    <Box • account-copy flow-col ml:10
                        <Label • account-name
                            text = "Northstar Lab"
                        <Label • account-plan mt:3
                            text = "Production workspace"

                <TextInput • mt:14
                    placeholder = "Filter intrinsically sized rows"

                <Label • section-kicker mt:16
                    text = "PRIMARY QUEUES"

                <Box • navigation flow-col flex:1 mt:8
                    <StressNavigationRow "Overview" • nav-selected
                    <StressNavigationRow "Active incidents" • mt:5
                    <StressNavigationRow "Deployments" • mt:5
                    <StressNavigationRow "Long-running workflows" • mt:5
                    <StressNavigationRow "Audit and compliance" • mt:5

                    <Box • sidebar-separator h:1 mt:12

                    <Label • section-kicker mt:12
                        text = "CAPACITY"

                    <StressCapacityRow "Compute" • mt:9
                    <StressCapacityRow "Storage" • mt:9
                    <StressCapacityRow "Network" • mt:9

                <Box • sidebar-foot flow-col mt:12 p:10
                    <Label • sidebar-foot-title
                        text = "Resize target"
                    <Label • sidebar-foot-note mt:4
                        text = "Drag through narrow and wide widths without pausing."

            ` Every descendant of this flexible column is affected by a window-size change.
            <Box • main-column flex-col flex:1 ml:12
                <Box • metric-strip flex-row h:112
                    <StressMetricCard "THROUGHPUT" • metric-blue
                    <StressMetricCard "P95 LATENCY" • metric-violet ml:10
                    <StressMetricCard "ACTIVE JOBS" • metric-cyan ml:10
                    <StressMetricCard "ERROR RATE" • metric-orange ml:10 max-w:235

                <Box • workbench flex-row flex:1 mt:10
                    ` Weighted panel containing fixed header/footer and a flexible nested split.
                    <Box • panel flex-col flex:2 p:13
                        <Box • panel-heading flex-row h:45
                            <Box • flex-col flex:1
                                <Label • panel-title
                                    text = "Live execution matrix"
                                <Label • panel-subtitle mt:3
                                    text = "Intrinsic rows inside a flexible-height panel"

                            <Box • heading-actions flow-row
                                <StressPill "ALL REGIONS"
                                <StressPill "LAST 15 MIN" • ml:6

                        <Box • execution-body flex-row flex:1 mt:11
                            <Box • timeline flex-col flex:2
                                <Box • column-head flow-row h:25 px:8
                                    <Label • column-label w:94
                                        text = "PIPELINE"
                                    <Label • column-label w:70 ml:8
                                        text = "REGION"
                                    <Label • column-label w:64 ml:8
                                        text = "STATE"
                                    <Label • column-label ml:8
                                        text = "DURATION"

                                <Box • activity-list flow-col flex:1
                                    <StressActivityRow "asset-indexer"
                                    <StressActivityRow "billing-rollup-long-name" • mt:5
                                    <StressActivityRow "thumbnail-fanout" • mt:5
                                    <StressActivityRow "compliance-export" • mt:5
                                    <StressActivityRow "search-compaction" • mt:5
                                    <StressActivityRow "warehouse-snapshot" • mt:5

                                <Box • timeline-footer flex-row h:42 mt:8 px:10 py:8
                                    <Label • footer-copy flex:1
                                        text = "Showing six naturally measured execution rows"
                                    <Box • footer-pages flow-row
                                        <Label • page-chip
                                            text = "1"
                                        <Label • page-chip ml:5
                                            text = "2"
                                        <Label • page-chip ml:5
                                            text = "3"

                            ` Fixed-width sibling whose children alternate flow and flex again.
                            <Box • lane-column flex-col w:198 ml:10
                                <Label • column-label
                                    text = "RESOURCE LANES"

                                <Box • lane-list flow-col flex:1 mt:8
                                    <StressLane "CPU burst"
                                    <StressLane "Cache fill" • mt:7
                                    <StressLane "Object sync" • mt:7
                                    <StressLane "Cold archive" • mt:7

                                <Box • distribution flex-col h:101 mt:8 p:9
                                    <Box • flex-row h:20
                                        <Label • distribution-title flex:1
                                            text = "Allocation"
                                        <Label • distribution-value
                                            text = "72 / 100"
                                    <Box • distribution-bar flex-row h:16 mt:9
                                        <Box • distribution-a flex:3
                                        <Box • distribution-b flex:2 ml:3
                                        <Box • distribution-c flex:1 ml:3
                                    <Box • distribution-legend flow-row mt:8
                                        <Label • legend-blue
                                            text = "hot"
                                        <Label • legend-violet ml:7
                                            text = "warm"
                                        <Label • legend-orange ml:7
                                            text = "idle"

                    ` A constrained flexible panel stresses redistribution as width crosses clamps.
                    <Box • panel inspector flex-col flex:1 ml:10 p:13 min-w:248 max-w:326
                        <Box • inspector-head flow-row
                            <Box • signal-dot w:10 h:10
                            <Box • flow-col ml:8
                                <Label • panel-title
                                    text = "Selection inspector"
                                <Label • panel-subtitle mt:3
                                    text = "asset-indexer / shard 08"

                        <Box • selection-card flex-col h:122 mt:12 p:10
                            <Box • flow-row
                                <StressPill "HEALTHY" • pill-green
                                <StressPill "PRIMARY" • ml:6
                            <Label • selection-name mt:10
                                text = "index-production-assets-v3"
                            <Label • selection-detail mt:4
                                text = "Started 02:14 ago · retry 0 of 4"
                            <Box • selection-track flex-row h:9 mt:10
                                <Box • selection-progress flex:4
                                <Box • selection-remainder flex:1

                        <Label • section-kicker mt:13
                            text = "SIGNALS"

                        <Box • signal-list flow-col flex:1 mt:8
                            <StressSignalRow "Input records"
                            <StressSignalRow "Output records" • mt:6
                            <StressSignalRow "Memory high-water" • mt:6
                            <StressSignalRow "Checkpoint age" • mt:6

                            <Box • affinity-box flex-col mt:10 p:9
                                <Label • distribution-title
                                    text = "Placement affinity"
                                <Box • affinity-row flex-row h:30 mt:8
                                    <Box • affinity-cell affinity-a flex:2
                                    <Box • affinity-cell affinity-b flex:1 ml:5
                                    <Box • affinity-cell affinity-c flex:3 ml:5

                        <Label • section-kicker mt:11
                            text = "PRIORITY WEIGHT"
                        <Slider • mt:7
                            minimum = 0
                            maximum = 1
                            value = 0.68

                <Box • statusbar flex-row h:42 mt:10 px:12 py:8
                    <Box • status-copy flow-row flex:1
                        <Box • status-light w:8 h:8
                        <Label • status-text ml:7
                            text = "All layout regions active"
                        <Label • status-muted ml:12
                            text = "Resize continuously to expose dropped frames"

                    <Box • status-tags flow-row
                        <StressPill "INTRINSIC"
                        <StressPill "EXTRINSIC" • ml:6
                        <StressPill "CLAMPED" • ml:6

