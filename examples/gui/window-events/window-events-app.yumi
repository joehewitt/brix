/graphics/text
/gui

<App
    <WindowEventsWindow
        title = "Yumi GUI: Window Events"
        size = (640, 300)

━━━━━━━━━━━━━━━━━━━━
• WindowEventsTheme
    using GUIDefaultTheme

• status-panel • bg:gui-well-color
    border-color = gui-border-color
    border-width = 2
    font-size = 15

━━━━━━━━━━━━━━━━━━━━
_ WindowEventsWindow is Window
    using WindowEventsTheme

+ cancel-next-close = true
+ status = "Switch to another app and back, or request a close"

────────────────────

<This • flex-col p:32
    <Label • h:24
        text = "The first close request is canceled; the next one is accepted."
        text-alignment = TextAlignment.center

    <Box • flex-row h:36 mt:24
        <Box • flex:1
        <Button "Request close" • w:180
            action = => do request-close()
        <Box • flex:1

    <Label • status-panel h:48 mt:32
        text = #status
        text-alignment = TextAlignment.center

────────────────────
for event on activated

status = "Window activated"

────────────────────
for event on deactivated

status = "Window deactivated · focus remembered"

────────────────────
for event on closing

if cancel-next-close
    cancel-next-close = false
    event.cancel()
    status = "Closing canceled · the next close request will succeed"
