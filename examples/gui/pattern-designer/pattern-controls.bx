(import ./pattern-canvas)
(import ./pattern-model)
(import ./pattern-session)
(import ./pattern-theme)
(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/copy)
(import /gui/icons/lucide/plus)
(import /gui/icons/lucide/trash-2)

(type + PatternLibrary (is Sidebar)
  (using PatternTheme)
  (prop + session PatternSession)
  (content
    (<> This (• pattern-sidebar)
      (<> SidebarSection (text: "Studies")
        (for (in index (..< 0 3))
          (<> StudyButton (• study-card)
            (= design (call starter-design index))
            (= is-on (== (. #session #design name) (. (call starter-design index) name)))
            (= action (=> () :do (call (. session load-study) index)))
          )
        )
      )
      (<> SidebarSection (text: "Motifs")
        (for (in motif (. #session #design motifs) (keyed-by (. motif id)))
          (<> MotifRow (• motif-row)
            (= motif motif)
            (= colors (. #session #design colors))
            (= is-on (== (. #session #motif id) (. motif id)))
            (= action (=> () :do (call (. session choose-id) (. motif id))))
          )
        )
      )
      (<> MenuButton (slot: footer) (text: "Add motif") (• icon-plus) (• flex 1) (• m 8)
        (= is-enabled (< (. #session #design motifs length) 24))
        (<> Menu
          (for (in kind (list (. MotifKind flower) (. MotifKind leaf) (. MotifKind sprig) (. MotifKind fan)))
            (<> MenuItem
              (= title (call motif-name kind))
              (= action (=> () :do (call (. session add-motif) kind)))
            )
          )
        )
      )
    )
  )
)

(type _ StudyButton (is Button)
  (using PatternTheme)
  (prop + design PatternDesign)
  (content
    (<> This
      (= title (. #design name))
      (<> PatternThumbnail (• study-preview)
        (= design #design)
      )
      (<> Label (• study-title)
        (= text (. #design name))
      )
    )
  )
)

(type _ MotifRow (is SidebarItem)
  (prop + motif PatternMotif)
  (prop + colors (list RGBA))
  (content
    (<> This
      (= title (call motif-name (. #motif kind)))
      (<> MotifThumbnail (slot: leading) (• w 28) (• h 28) (• mr 8)
        (= motif #motif)
        (= colors #colors)
      )
    )
  )
)

(type + PatternInspector (is Sidebar)
  (using PatternTheme)
  (prop + session PatternSession)
  (prop + status String)
  (prop + failed Bool)
  (content
    (<> This (• pattern-inspector)
      (<> SidebarSection (text: "Repeat")
        (<> (of Select RepeatMode) (• mx 12) (• mb 6)
          (= options (list (. RepeatMode straight) (. RepeatMode half-drop) (. RepeatMode brick) (. RepeatMode mirror)))
          (= selected (. #session #design repeat))
          (= option-title (=> (mode) (call repeat-name mode)))
          (for (on event selection-changed)
            (call (. session set-repeat) (. event value))
          )
        )
        (<> Box (• inspector-row)
          (<> Label (text: "Spacing") (• flex 1))
          (<> NumberField (• w 96)
            (= value (. #session #design spacing))
            (= minimum 75)
            (= maximum 160)
            (= step 1)
            (= precision 1)
            (= unit "%")
            (= scrub-handle (. NumberFieldScrubHandle unit))
            (for (on event value-changed)
              (call (. session set-parameter) (. PatternParameter spacing) (. event value) (. event phase))
              (call (. event cancel))
            )
          )
        )
      )
      (<> SidebarSection
        (= title (call motif-name (. #session #motif kind)))
        (<> Box (• flex-row) (• items-center) (• gap 6) (• mx 12) (• mb 8)
          (<> MotifThumbnail (• w 44) (• h 44)
            (= motif (. #session #motif))
            (= colors (. #session #design colors))
          )
          (<> (of Select Index) (• flex 1)
            (= options (list 1 2 3 4))
            (= selected (. #session #motif ink))
            (= option-title (=> (ink) (str "Ink " ink)))
            (for (on event selection-changed)
              (call (. session set-ink) (. event value))
            )
          )
          (<> IconButton (• icon-copy) (• w 22) (• h 22)
            (= is-enabled (< (. #session #design motifs length) 24))
            (= action (=> () :do (call (. session duplicate))))
            (<> Tooltip (text: "Duplicate motif · ⌘D"))
          )
          (<> IconButton (• icon-trash-2) (• w 22) (• h 22)
            (= is-enabled (> (. #session #design motifs length) 1))
            (= action (=> () :do (call (. session remove))))
            (<> Tooltip (text: "Delete motif"))
          )
        )
        (for (in parameter (list (. PatternParameter scale) (. PatternParameter rotation) (. PatternParameter shape)))
          (<> Box (• inspector-row)
            (<> Label (• flex 1)
              (= text (call parameter-title parameter))
            )
            (<> NumberField (• w 96)
              (= value (call motif-parameter (. #session #motif) parameter))
              (= minimum (call parameter-minimum parameter))
              (= maximum (call parameter-maximum parameter))
              (= step 1)
              (= precision 1)
              (= unit (if-expr (== parameter (. PatternParameter rotation)) "°" "%"))
              (= scrub-handle (. NumberFieldScrubHandle unit))
              (for (on event value-changed)
                (call (. session set-parameter) parameter (. event value) (. event phase))
                (call (. event cancel))
              )
            )
          )
        )
      )
      (<> SidebarSection (text: "Palette")
        (<> (of Select Index) (• mx 12) (• mb 6)
          (= options (list 0 1 2 3))
          (= selected (call palette-index (. #session #design colors)))
          (= placeholder "Custom palette")
          (= option-title (=> (index) (. ([] pattern-palettes index) name)))
          (for (on event selection-changed)
            (call (. session set-palette) ([] pattern-palettes (. event value)))
          )
        )
        (for (in slot (..< 0 5))
          (<> Box (• inspector-row)
            (<> Label (• w 72)
              (= text (if-expr (== slot 0) "Background" (str "Ink " slot)))
            )
            (<> ColorField (• flex 1)
              (= color ([] (. #session #design colors) slot))
              (for (on event value-changed)
                (call (. session set-color) slot (. event value) (. event phase))
              )
            )
          )
        )
      )
      (<> Box (slot: footer) (• flex-row) (• flex 1) (• px 12) (• py 10)
        (<> Label (• muted-label) (• flex 1)
          (= text #status)
          (= color (if-expr #failed $gui-danger-color $gui-muted-text-color))
          (= text-wrap (. TextWrap word))
        )
      )
    )
  )
)

(fn-do _ palette-index (? Index)
  (param colors (list RGBA))
  (for (in index (..< 0 (. pattern-palettes length)))
    (if (== colors (. ([] pattern-palettes index) colors))
      (return index)
    )
  )
  (return null)
)

(fn-expr _ parameter-title String
  (param parameter PatternParameter)
  (match parameter
    (case= (. PatternParameter spacing)
      "Spacing"
    )
    (case= (. PatternParameter scale)
      "Scale"
    )
    (case= (. PatternParameter rotation)
      "Rotation"
    )
    (case= (. PatternParameter shape)
      "Fullness"
    )
  )
)

(fn-expr _ parameter-minimum Float
  (param parameter PatternParameter)
  (match parameter
    (case= (. PatternParameter scale)
      30
    )
    (case= (. PatternParameter rotation)
      -180
    )
    (default
      0
    )
  )
)

(fn-expr _ parameter-maximum Float
  (param parameter PatternParameter)
  (match parameter
    (case= (. PatternParameter scale)
      180
    )
    (case= (. PatternParameter rotation)
      180
    )
    (default
      100
    )
  )
)
