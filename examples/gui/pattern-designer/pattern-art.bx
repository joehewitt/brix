(import ./pattern-model)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vector)
(import /math)
(import /units)

(type + MotifPart (is Tuple)
  (prop + path Path)
  (prop + ink Index)
  (prop + transform Matrix)
  (prop + stroke Float)
)

(type + MotifArtwork (is Tuple)
  (prop + motif PatternMotif)
  (prop + parts (list MotifPart))
)

(type + RepeatCell (is Tuple)
  (prop + column Int)
  (prop + row Int)
  (prop + transform Matrix)
)

(fn-expr + pattern-artwork (list MotifArtwork)
  (param design PatternDesign)
  (call List (in (call MotifArtwork each (call motif-parts each)) (. design motifs)))
)

(fn-expr + motif-parts (list MotifPart)
  (param motif PatternMotif)
  (match (. motif kind)
    (case= (. MotifKind flower)
      (spread (in (call MotifPart petal ink (call matrix-from-rotation (as (* each (/ 360.0 7)) Degrees) (call Point)) 0) (..< 0 7)))
      (item (call MotifPart (call circle-path 9) accent (call Matrix) 0))
      (item (call MotifPart (call circle-path 3) 0 (call Matrix) 0))
    )
    (case= (. MotifKind leaf)
      (list (call MotifPart leaf ink (call Matrix) 0) (call MotifPart (call vein-path) 0 (call Matrix) 1.5))
    )
    (case= (. MotifKind sprig)
      (item (call MotifPart stem ink (call Matrix) 2.5))
      (spread (in (call sprig-leaf leaf ink each) (..< 0 6)))
    )
    (case= (. MotifKind fan)
      (spread (in (call MotifPart petal ink (call matrix-from-rotation (as (- (* each 28.0) 56) Degrees) (call Point)) 0) (..< 0 5)))
      (item (call MotifPart stem accent (call Matrix) 2.5))
    )
  )
  (where
    (lazy ink (. motif ink))
    (lazy accent (if-expr (== ink 1) 3 1))
    (lazy petal (call petal-path (. motif shape)))
    (lazy leaf (call leaf-path (. motif shape)))
    (lazy stem (call stem-path))
  )
)

(fn-expr _ petal-path Path
  (param shape Float)
  (!! (call vector-path (call (of List PathOp) (call M -3 4) (call C (- width) -12 (- width) -55 -4 -58) (call C (* width 0.8) -63 width -30 3 4) (call Z))))
  (where
    (lazy width (+ 12 (* shape 0.28)))
  )
)

(fn-expr _ leaf-path Path
  (param shape Float)
  (!! (call vector-path (call (of List PathOp) (call M 0 52) (call C (- width) 24 (- width) -28 0 -62) (call C width -23 (* width 0.8) 30 0 52) (call Z))))
  (where
    (lazy width (+ 20 (* shape 0.35)))
  )
)

(fn-expr _ vein-path Path
  (!! (call vector-path (call (of List PathOp) (call M 0 44) (call C 4 18 -5 -18 0 -49) (call M 1 24) (call Q -12 14 -21 8) (call M 0 6) (call Q 12 -4 22 -10) (call M -1 -13) (call Q -10 -20 -16 -28))))
)

(fn-expr _ stem-path Path
  (!! (call vector-path (call (of List PathOp) (call M -3 60) (call C -9 20 8 -20 0 -61))))
)

(fn-do _ circle-path Path
  (param radius Float)
  (let path (call Path))
  (call (. path append-circle) (call Point) radius)
  (return path)
)

(fn-expr _ sprig-leaf MotifPart
  (param leaf Path)
  (param ink Index)
  (param index Index)
  (call MotifPart leaf ink transform 0)
  (where
    (lazy side (if-expr (== (% index 2) 0) -1.0 1.0))
    (lazy tier (as (/ index 2) Int))
    (lazy size (+ 0.3 (* tier 0.07)))
    (lazy transform (call (. (call (. (call matrix-from-translation (call Point (* side (+ 12 (* tier 3))) (+ -43 (* tier 31.0)))) rotate) (as (* side 50) Degrees) (call Point)) scale) (call Dimensions size size)))
  )
)

(fn-expr + repeat-cells (list RepeatCell)
  (param design PatternDesign)
  (param area Rect)
  (call List (call flat-map (in (call repeat-row design each first-column last-column) (.. first-row last-row))))
  (where
    (lazy pitch (call pattern-pitch design))
    (lazy first-column (- (as (call floor (/ (. area x) pitch)) Int) 2))
    (lazy last-column (+ (as (call ceil (/ (. area right) pitch)) Int) 1))
    (lazy first-row (- (as (call floor (/ (. area y) pitch)) Int) 2))
    (lazy last-row (+ (as (call ceil (/ (. area bottom) pitch)) Int) 1))
  )
)

(fn-expr _ repeat-row (list RepeatCell)
  (param design PatternDesign)
  (param row Int)
  (param first Int)
  (param last Int)
  (call List (in (call RepeatCell each row (call repeat-transform design each row)) (.. first last)))
)

(fn-do + paint-motif _
  (param canvas Canvas)
  (param artwork MotifArtwork)
  (param colors (list RGBA))
  (for (in part (. artwork parts))
    (do-use (. canvas saved-state)
      (call (. canvas transform) (. part transform))
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-join) (. LineJoin round))
      (= (. canvas stroke-width) (. part stroke))
      (= (. canvas stroke-color) (only-if ([] colors (. part ink)) (if (> (. part stroke) 0))))
      (= (. canvas fill-color) (only-if ([] colors (. part ink)) (if (== (. part stroke) 0))))
      (call (. part path outline) canvas)
    )
  )
)

(fn-do + paint-pattern _
  (param canvas Canvas)
  (param design PatternDesign)
  (param artwork (list MotifArtwork))
  (param area Rect)
  (do-use (. canvas saved-state)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) ([] (. design colors) 0))
    (call (. canvas rect) area)
    (let pitch (call pattern-pitch design))
    (for (in cell (call repeat-cells design area))
      (do-use (. canvas saved-state)
        (call (. canvas transform) (. cell transform))
        (for (in motif artwork)
          (do-use (. canvas saved-state)
            (call (. canvas transform) (call motif-transform (. motif motif) pitch))
            (call paint-motif canvas motif (. design colors))
          )
        )
      )
    )
  )
)

(fn-do + motif-contains Bool
  (param artwork MotifArtwork)
  (param point Point)
  (for (in part (. artwork parts))
    (if (== (. part stroke) 0)
      (let local (call (. part transform inverse-transform) point))
      (if (and local (call (. part path contains) local))
        (return true)
      )
    )
  )
  (return false)
)
