(import ./pattern-art)
(import ./pattern-material)
(import ./pattern-model)
(import ./pattern-session)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shader)
(import /gui)
(import /math)
(import /ui/value-change-phase)
(blank)
(prop + pattern-sheet-size _ (= (call Dimensions 1200 1000)))

(type _ MotifHandle (is U8)
  (variant move)
  (variant scale)
  (variant shape)
)

(type _ MotifGesture (is Tuple)
  (prop + pointer U64)
  (prop + handle MotifHandle)
  (prop + start Point)
  (prop + motif PatternMotif)
  (prop + transform Matrix)
  (prop + cell RepeatCell)
)

(type _ MotifHit (is Tuple)
  (prop + index Index)
  (prop + cell RepeatCell)
)

(type + PatternCanvas (is Box)
  (implements ZoomOwner)
  (prop + session PatternSession)
  (prop + fit-insets _ (= (call Insets 24 24 24 24)))
  (prop + fabric _ (= false))
  (prop + guides _ (= false))
  (prop + hand _ (= false))
  (prop + is-panning _ (= (or #hand #fabric)))
  (prop + framing _ (:= (call ZoomFrame this this)))
  (prop _ artwork _ (= (call pattern-artwork (. #session #design))))
  (prop _ column Int (= 1))
  (prop _ row Int (= 1))
  (prop _ gesture (? MotifGesture))
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
    (when-style #is-panning
      (= cursor (. CursorStyle open-hand))
      (= drag-cursor (. CursorStyle closed-hand))
    )
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
    (= filters (if-expr #fabric (list (call PatternLinen)) (call (of List ShaderFilter))))
  )
  (depends invalidate-paint artwork fabric guides hand column row fit-insets)
  (whenever-rule (. #session #selected)
    (call invalidate-paint)
  )
  (subscribe-for (on restored (. session restored))
    (= gesture null)
  )
  (subscribe-for (on moved (. framing moved))
    (call invalidate-paint)
  )
  (subscribe-for (on event scroll)
    (if (call (. framing handle-scroll) event)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event magnify)
    (if (call (. framing handle-magnify) event)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (call request-focus)
      (if is-panning
        (let ignored (call (. framing handle-pointer-down) event))
        (else
          (call begin-edit event)
        )
      )
    )
  )
  (subscribe-for (on event pointer-drag)
    (if (and gesture (== (. event pointer-id) (?. gesture pointer)))
      (call drag-to (+ (. event point) (. bounds top-left)) (. ValueChangePhase changed))
      (call (. event cancel))
      (else-if is-panning
        (if (call (. framing handle-pointer-drag) event)
          (call (. event cancel))
        )
      )
    )
  )
  (subscribe-for (on event pointer-up)
    (if (and gesture (== (. event pointer-id) (?. gesture pointer)))
      (if (not (. event is-interrupted))
        (call drag-to (+ (. event point) (. bounds top-left)) (. ValueChangePhase ended))
      )
      (call end-edit)
      (call (. event cancel))
    )
    (call (. framing handle-pointer-up))
  )
  (subscribe-for (on event blur)
    (call end-edit)
    (call (. framing handle-pointer-up))
  )
  (fn-do + zoom-bounds ZoomBounds
    (let fitted (call (. content-bounds inset) fit-insets))
    (return (call ZoomBounds pattern-sheet-size (call image-fit-rect pattern-sheet-size fitted (. ImageFit contain) (. AnchorPoint center) (. AnchorPoint center)) 0.25 3))
  )
  (fn-expr _ view-transform Matrix :get
    (call Matrix scale 0 0 scale (. placed x) (. placed y))
    (where
      (lazy placed (call (. framing placed)))
      (lazy scale (call (. framing effective-zoom)))
    )
  )
  (fn-expr _ selection-transform Matrix :get
    (call (. (call (. view-transform concatenate) (call repeat-transform design column row)) concatenate) (call motif-transform (. session motif) (call pattern-pitch design)))
    (where
      (lazy design (. session design))
    )
  )
  (fn-do _ begin-edit _
    (param event PointerDownEvent)
    (let point (+ (. event point) (. bounds top-left)))
    (let transform selection-transform)
    (let scale-point (call (. transform transform) (call Point 65 65)))
    (let shape-point (call (. transform transform) (call Point 60 -55)))
    (let handle
      (block
        (case? (< (call (. point distance) scale-point) 12)
          (. MotifHandle scale)
        )
        (case? (< (call (. point distance) shape-point) 12)
          (. MotifHandle shape)
        )
        (default
          (. MotifHandle move)
        )
      )
    )
    (if (== handle (. MotifHandle move))
      (let hit (call pick point))
      (return-if (if (not hit)))
      (call (. session choose) (. hit index))
      (= column (. hit cell column))
      (= row (. hit cell row))
    )
    (= gesture (call MotifGesture (. event pointer-id) handle point (. session motif) selection-transform (call RepeatCell column row (call repeat-transform (. session design) column row))))
    (call drag-to point (. ValueChangePhase began))
  )
  (fn-do _ drag-to _
    (param point Point)
    (param phase ValueChangePhase)
    (let active gesture)
    (return-if (if (not active)))
    (let delta (- point (. active start)))
    (let motif (. active motif))
    (match (. active handle)
      (case= (. MotifHandle move)
        (let design (. session design))
        (let cell (call (. view-transform concatenate) (. active cell transform)))
        (let start (call (. cell inverse-transform) (. active start)))
        (let finish (call (. cell inverse-transform) point))
        (if (and start finish)
          (let position (+ (. motif position) (/ (- finish start) (call pattern-pitch design))))
          (let wrapped (call pattern-wrapped-position design position))
          (= column (+ (. active cell column) (as (call round (* (- (. position x) (. wrapped x)) (. active cell transform a))) Int)))
          (= row (+ (. active cell row) (as (call round (* (- (. position y) (. wrapped y)) (. active cell transform d))) Int)))
          (call (. session move-motif) wrapped phase)
        )
      )
      (case= (. MotifHandle scale)
        (let center (call (. active transform transform) (call Point)))
        (let ratio (/ (call (. point distance) center) (call max 1 (call (. active start distance) center))))
        (call (. session set-parameter) (. PatternParameter scale) (call clamp (* (. motif scale) ratio) 30.0 180.0) phase)
      )
      (case= (. MotifHandle shape)
        (call (. session set-parameter) (. PatternParameter shape) (call clamp (+ (. motif shape) (/ (. delta x) (call (. framing effective-zoom)))) 0.0 100.0) phase)
      )
    )
  )
  (fn-do _ end-edit _
    (if gesture
      (call (. session finish-gesture))
      (= gesture null)
    )
  )
  (fn-do _ pick (? MotifHit)
    (param point Point)
    (let world (call (. view-transform inverse-transform) point))
    (return-if null (if (not world)))
    (let design (. session design))
    (let pitch (call pattern-pitch design))
    (let cells (call repeat-cells design (call Rect (. world x) (. world y) 1 1)))
    (for (in cell-index (.. (- (. cells length) 1) 0))
      (let cell ([] cells cell-index))
      (for (in index (.. (- (. artwork length) 1) 0))
        (let item ([] artwork index))
        (let matrix (call (. cell transform concatenate) (call motif-transform (. item motif) pitch)))
        (let local (call (. matrix inverse-transform) world))
        (if (and local (call motif-contains item local))
          (return (call MotifHit index cell))
        )
      )
    )
    (return null)
  )
  (fn-do + unmounted _
    (call end-edit)
    (call (. super unmounted))
  )
  (fn-expr _ visible-area Rect :get
    (call Rect (/ (- (. area x) (. placed x)) scale) (/ (- (. area y) (. placed y)) scale) (/ (. area width) scale) (/ (. area height) scale))
    (where
      (lazy area content-bounds)
      (lazy placed (call (. framing placed)))
      (lazy scale (call (. framing effective-zoom)))
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (call (. canvas clip) content-bounds)
      (call (. canvas transform) view-transform)
      (let visible visible-area)
      (call paint-pattern canvas (. session design) artwork visible)
      (if (and guides (not fabric))
        (call paint-guides canvas visible)
      )
    )
    (if (not is-panning)
      (call paint-selection canvas)
    )
  )
  (fn-do _ paint-guides _
    (param canvas Canvas)
    (param area Rect)
    (let pitch (call pattern-pitch (. session design)))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (call (. $gui-accent-bright-color with-alpha) 0.35))
    (= (. canvas stroke-width) (/ 1 (call (. framing effective-zoom))))
    (for (in cell (call repeat-cells (. session design) area))
      (do-use (. canvas saved-state)
        (call (. canvas transform) (. cell transform))
        (call (. canvas rect) (call Rect 0 0 pitch pitch))
      )
    )
  )
  (fn-do _ paint-selection _
    (param canvas Canvas)
    (let matrix selection-transform)
    (do-use (. canvas saved-state)
      (call (. canvas clip) content-bounds)
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call (. $gui-accent-bright-color with-alpha) 0.75))
      (= (. canvas stroke-width) 1)
      (call (. canvas begin))
      (for (in point (list (call Point -65 -65) (call Point 65 -65) (call Point 65 65) (call Point -65 65)))
        (let placed (call (. matrix transform) point))
        (if (== point (call Point -65 -65))
          (call (. canvas move) (. placed x) (. placed y))
          (else
            (call (. canvas line) (. placed x) (. placed y))
          )
        )
      )
      (call (. canvas enclose))
      (call (. canvas end))
      (call paint-handle canvas (call (. matrix transform) (call Point 65 65)) false $gui-accent-bright-color)
      (call paint-handle canvas (call (. matrix transform) (call Point 60 -55)) true $gui-accent-bright-color)
    )
  )
)

(fn-do _ paint-handle _
  (param canvas Canvas)
  (param point Point)
  (param shape Bool)
  (param handle-color RGBA)
  (= (. canvas fill-color) (if-expr shape handle-color white))
  (= (. canvas stroke-color) handle-color)
  (= (. canvas stroke-width) 1.5)
  (call (. canvas circle) (. point x) (. point y) (if-expr shape 4.5 4.0))
)

(type + PatternThumbnail (is Box)
  (prop + design PatternDesign)
  (prop _ artwork _ (= (call pattern-artwork #design)))
  (depends invalidate-paint artwork)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let scale (/ (. area width) 500))
    (return-if (if (<= scale 0)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) area)
      (call (. canvas translate) (. area x) (. area y))
      (call (. canvas transform) (call (. (call Matrix) scale) (call Dimensions scale scale)))
      (call paint-pattern canvas design artwork (call Rect 0 0 500 (/ (. area height) scale)))
    )
  )
)

(type + MotifThumbnail (is Box)
  (prop + motif PatternMotif)
  (prop + colors (list RGBA))
  (prop _ artwork _ (= (call MotifArtwork #motif (call motif-parts #motif))))
  (depends invalidate-paint artwork colors)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let scale (/ (call min (. area width) (. area height)) 150))
    (do-use (. canvas saved-state)
      (call (. canvas clip) area)
      (call (. canvas translate) (. area center x) (. area center y))
      (call (. canvas transform) (call (. (call Matrix) scale) (call Dimensions scale scale)))
      (call paint-motif canvas artwork colors)
    )
  )
)
