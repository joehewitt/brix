(import ./pattern-canvas)
(import ./pattern-controls)
(import ./pattern-file)
(import ./pattern-model)
(import ./pattern-session)
(import ./pattern-theme)
(import /graphics/color)
(import /graphics/primitives)
(import /gui)
(import /gui/file-dialogs)
(import /gui/icons/lucide/download)
(import /gui/icons/lucide/folder-open)
(import /gui/icons/lucide/grid-2x2)
(import /gui/icons/lucide/hand)
(import /gui/icons/lucide/minus)
(import /gui/icons/lucide/mouse-pointer-2)
(import /gui/icons/lucide/plus)
(import /gui/icons/lucide/redo-2)
(import /gui/icons/lucide/save)
(import /gui/icons/lucide/undo-2)
(import /math)
(import /os/file)
(import /os/path)

(type + PatternWindow (is Window)
  (using PatternTheme)
  (prop + session _ (= (call PatternSession)))
  (prop _ file-path (? Path))
  (prop _ status _ (= ""))
  (prop _ failed _ (= false))
  (prop + undo-target _ (=> session))
  (whenever-rule (. #session #design)
    (= status "")
    (= failed false)
  )
  (content
    (<> This (• pattern-window)
      (= title (str (. #session #design name) " — Pattern"))
      (= size (call Dimensions 1380 900))
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= state-key "pattern-designer")
      (<> PatternCanvas (id: canvas) (• absolute) (• cover .parent)
        (= session session)
        (= fit-insets
          (call Insets
            (block
              (arg (+ gui-toolbar-height 28))
              (arg (+ pattern-inspector-width (* 2 pattern-margin)))
              (arg 72)
              (arg (+ pattern-library-width (* 2 pattern-margin)))
            )
          )
        )
      )
      (<> PatternLibrary
        (= session session)
        (= left (call (. PositionOffset coord) pattern-margin))
        (= top (call (. PositionOffset coord) (+ gui-toolbar-height pattern-margin)))
        (= bottom (call (. PositionOffset coord) pattern-margin))
      )
      (<> PatternInspector
        (= session session)
        (= right (call (. PositionOffset coord) pattern-margin))
        (= top (call (. PositionOffset coord) (+ gui-toolbar-height pattern-margin)))
        (= bottom (call (. PositionOffset coord) pattern-margin))
        (= status (if-expr (!= #status "") #status (if-expr (. #session history #is-modified) "Edited" "Ready")))
        (= failed #failed)
      )
      (<> Toolbar (• absolute)
        (= left (call (. PositionOffset coord) 0))
        (= right (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (= is-title-bar true)
        (<> ToolbarTitle
          (= text (. #session #design name))
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> (of SegmentedControl Bool)
            (<-> selected (. canvas fabric))
            (<> (of Segment Bool) (text: "Design")
              (= value false)
            )
            (<> (of Segment Bool) (text: "Linen")
              (= value true)
            )
          )
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-undo-2)
            (= is-enabled (. #session #can-undo))
            (= action (=> () :do (call (. session undo))))
            (<> Tooltip
              (= text (. #session #undo-title))
            )
          )
          (<> ToolbarButton (• icon-redo-2)
            (= is-enabled (. #session #can-redo))
            (= action (=> () :do (call (. session redo))))
            (<> Tooltip
              (= text (. #session #redo-title))
            )
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-folder-open)
            (= action (=> () :do (call open-document)))
            (<> Tooltip (text: "Open pattern · ⌘O"))
          )
          (<> ToolbarButton (• icon-save)
            (= action (=> () :do (call save-document)))
            (<> Tooltip (text: "Save pattern · ⌘S"))
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (text: "Export SVG") (• icon-download)
            (= is-default true)
            (= action (=> () :do (call export-document)))
          )
        )
      )
      (<> Box (• absolute) (• flex-row) (• items-center) (• gap 8)
        (= left (call (. PositionOffset coord) (+ pattern-library-width (* 2 pattern-margin))))
        (= right (call (. PositionOffset coord) (+ pattern-inspector-width (* 2 pattern-margin))))
        (= bottom (call (. PositionOffset coord) 20))
        (<> Box (• flex 1))
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-mouse-pointer-2)
            (= is-on (not (. canvas #hand)))
            (= action (=> () :do (= (. canvas hand) false)))
            (<> Tooltip (text: "Move motifs · Filled handle reshapes · Hollow handle scales"))
          )
          (<> ToolbarButton (• icon-hand)
            (= is-on (. canvas #hand))
            (= action (=> () :do (= (. canvas hand) true)))
            (<> Tooltip (text: "Pan"))
          )
          (<> ToolbarButton (• icon-grid-2x2)
            (= is-on (. canvas #guides))
            (= action (=> () :do (= (. canvas guides) (not (. canvas guides)))))
            (<> Tooltip (text: "Repeat boundaries"))
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-minus)
            (= action (=> () :do (call (. canvas framing zoom-by) 0.8)))
            (<> Tooltip (text: "Zoom out"))
          )
          (<> ToolbarButton
            (= title (call zoom-title (. canvas framing #zoom)))
            (= action (=> () :do (call (. canvas framing fit))))
            (<> Tooltip (text: "Fit to window"))
          )
          (<> ToolbarButton (• icon-plus)
            (= action (=> () :do (call (. canvas framing zoom-by) 1.25)))
            (<> Tooltip (text: "Zoom in"))
          )
        )
        (<> Box (• flex 1))
      )
      (<> KeyShortcut (text: "Save pattern")
        (= key (call KeyCombo "Cmd+S"))
        (= action (=> () :do (call save-document)))
      )
      (<> KeyShortcut (text: "Open pattern")
        (= key (call KeyCombo "Cmd+O"))
        (= action (=> () :do (call open-document)))
      )
      (<> KeyShortcut (text: "Export SVG")
        (= key (call KeyCombo "Cmd+E"))
        (= action (=> () :do (call export-document)))
      )
      (<> KeyShortcut (text: "Duplicate motif")
        (= key (call KeyCombo "Cmd+D"))
        (= action (=> () :do (call (. session duplicate))))
      )
      (<> KeyShortcut (text: "Delete motif")
        (= key .backspace)
        (= action (=> () :do (call (. session remove))))
      )
    )
  )
  (fn-do _ save-document _
    (call (. session finish-gesture))
    (let path (?? file-path (call choose-save-path this (str (. session design name) ".pattern.json") (list "json"))))
    (return-if (if (not path)))
    (blank)
    (call write-file-atomically path (call encode-pattern (. session design)))
    (on-error (: error Error)
      (call report-error error)
      (return)
    )
    (= file-path path)
    (call (. session history mark-saved))
    (= failed false)
    (= status "Pattern saved")
  )
  (fn-do _ open-document _
    (let path (call choose-open-path this (list "json")))
    (return-if (if (not path)))
    (blank)
    (let design (call decode-pattern (call read-file-text path)))
    (on-error (: error Error)
      (call report-error error)
      (return)
    )
    (call (. session open) design)
    (= file-path path)
    (= failed false)
    (= status "Pattern opened")
  )
  (fn-do _ export-document _
    (call (. session finish-gesture))
    (let design (. session design))
    (let path (call choose-save-path this (str (. design name) ".svg") (list "svg")))
    (return-if (if (not path)))
    (blank)
    (call export-pattern design path)
    (on-error (: error Error)
      (call report-error error)
      (return)
    )
    (= failed false)
    (= status "Seamless SVG tile exported")
  )
  (fn-do _ report-error _
    (param error Error)
    (= status (str error))
    (= failed true)
  )
)

(fn-expr _ zoom-title String
  (param level (? Float))
  (if-expr level (str (as (call round (* level 100)) Int) "%") "Fit")
)
