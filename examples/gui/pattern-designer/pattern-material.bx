(import /graphics/shader-declarations)

(type + PatternLinen (is LayerShader)
  (fn-expr + metal _
    (paragraph
      "float4 filter(float2 p, ShaderLayer layer, PatternLinenArgs args) {"
      "    float4 color = layer.sample(p);"
      "    float2 weave = p * 2.7;"
      "    float warp = sin(weave.x * 3.14159);"
      "    float weft = sin(weave.y * 3.14159);"
      "    float crossing = warp * weft;"
      "    float grain = fract(sin(dot(floor(p * 2.0), float2(12.9898, 78.233))) * 43758.5453);"
      "    float light = 0.97 + warp * 0.018 + weft * 0.018 + crossing * 0.028;"
      "    light += (grain - 0.5) * 0.045;"
      "    color.rgb *= light;"
      "    return color;"
      "}"
    )
  )
)
