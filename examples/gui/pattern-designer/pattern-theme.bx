(import /graphics/color)
(import /graphics/text)
(import /gui)
(blank)
(prop + pattern-margin _ (= 12.0))
(prop + pattern-library-width _ (= 236.0))
(prop + pattern-inspector-width _ (= 300.0))

(style PatternTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIMetrics)
  (using GUIBoxCursor)
  (using GUIBoxTransform)
  (rule pattern-window (• bg gui-window-color) (• text gui-text-color))
  (rule pattern-sidebar (• glass-panel) (• absolute) (• w pattern-library-width)
    (rule sidebar-body (• py 10))
  )
  (rule pattern-inspector (• glass-panel) (• absolute) (• w pattern-inspector-width)
    (= font-size 12)
    (rule sidebar-body (• py 10))
  )
  (rule inspector-row (• flex-row) (• items-center) (• h 28) (• mx 12) (• gap 6))
  (rule muted-label (• text gui-muted-text-color)
    (= font-size gui-footnote-font-size)
  )
  (rule study-card (• flex-col) (• p 4) (• mx 10) (• mb 6) (• h 104) (• gap 4) (• bg transparent)
    (= corner-radius gui-card-radius)
    (= border-width 1.5)
    (= border-color transparent)
    (= shadow null)
    (= motion gui-motion-quick)
    (rule button-content
      (= display (. Display hidden))
    )
    (when-style #is-on
      (= background-color (call (. gui-accent-bright-color with-alpha) 0.12))
      (= border-color gui-accent-bright-color)
    )
    (when-style #is-hover-within
      (= border-color gui-focus-border-color)
    )
  )
  (rule study-preview (• h 71)
    (= corner-radius 6)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (rule study-title (• text gui-text-color) (• h 18) (• px 5)
    (= font-size gui-footnote-font-size)
    (= font-weight (. FontWeight medium))
  )
  (rule motif-row (• h 36))
)
