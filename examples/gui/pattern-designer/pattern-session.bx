(import ./pattern-model)
(import /graphics/color)
(import /graphics/point)
(import /math)
(import /ui/command-history)
(import /ui/undo-target)
(import /ui/value-change-phase)

(type + PatternSession
  (implements UndoTarget)
  (event + restored Bool)
  (prop + design _ (= (call starter-design 0)))
  (prop + selected Index (= 0))
  (prop + history _ (= (call CommandHistory)))
  (prop _ gesture-start (? PatternDesign))
  (prop _ next-id Int (= 5))
  (prop + motif _ (= ([] (. #design motifs) #selected)))
  (prop + can-undo _ (= (or (. history #can-undo) (and #gesture-start (!= #gesture-start #design)))))
  (prop + can-redo _ (= (. history #can-redo)))
  (prop + undo-title _ (= (. history #undo-title)))
  (prop + redo-title _ (= (. history #redo-title)))
  (fn-do + undo _
    (call finish-gesture)
    (call (. history undo))
  )
  (fn-do + redo _
    (call finish-gesture)
    (call (. history redo))
  )
  (fn-do + apply _
    (param next PatternDesign)
    (param title String)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (if (or (== phase (. ValueChangePhase began)) (== phase (. ValueChangePhase discrete)))
      (call finish-gesture)
      (= gesture-start design)
    )
    (= design next)
    (if (or (== phase (. ValueChangePhase ended)) (== phase (. ValueChangePhase discrete)))
      (call finish-gesture title)
    )
  )
  (fn-do + finish-gesture _
    (param title String (= "Edit pattern"))
    (let before gesture-start)
    (= gesture-start null)
    (if (and before (!= before design))
      (call (. history record) title (call PatternEdit this before design))
    )
  )
  (fn-do + restore _
    (param next PatternDesign)
    (= gesture-start null)
    (= design next)
    (= selected (call min selected (- (. next motifs length) 1)))
    (<- restored true)
  )
  (fn-do + open _
    (param next PatternDesign)
    (call apply next "Open pattern")
    (= selected 0)
    (= next-id (call max next-id (+ 1 (. next motifs length))))
    (call (. history mark-saved))
  )
  (fn-do + choose _
    (param index Index)
    (call finish-gesture)
    (= selected index)
  )
  (fn-do + choose-id _
    (param id Int)
    (for (in index (..< 0 (. design motifs length)))
      (if (== (. ([] (. design motifs) index) id) id)
        (call choose index)
        (return)
      )
    )
  )
  (fn-do + load-study _
    (param index Index)
    (call apply (call starter-design index) "Change study")
    (= selected 0)
  )
  (fn-do + set-repeat _
    (param mode RepeatMode)
    (call apply (call pattern-with-repeat design mode) "Change repeat")
  )
  (fn-do + set-palette _
    (param palette PatternPalette)
    (call apply (call pattern-with-colors design (. palette colors)) "Change palette")
  )
  (fn-do + set-color _
    (param slot Index)
    (param value RGBA)
    (param phase ValueChangePhase)
    (let colors
      (call List
        (block
          (arg (in (if-expr (== each slot) value ([] (. design colors) each)) (..< 0 (. design colors length))))
        )
      )
    )
    (call apply (call pattern-with-colors design colors) "Edit color" phase)
  )
  (fn-do + set-ink _
    (param ink Index)
    (let current motif)
    (let next
      (call PatternMotif
        (block
          (arg (. current id))
          (arg (. current kind))
          (arg (. current position))
          (arg (. current scale))
          (arg (. current rotation))
          (arg (. current shape))
          (arg ink)
        )
      )
    )
    (call replace-motif next "Change motif color")
  )
  (fn-do + set-parameter _
    (param parameter PatternParameter)
    (param value Float)
    (param phase ValueChangePhase)
    (if (== parameter (. PatternParameter spacing))
      (call apply
        (block
          (arg (call PatternDesign (. design name) (. design motifs) (. design colors) (. design repeat) value))
          (arg "Change spacing")
          (arg phase)
        )
      )
      (else
        (call replace-motif (call motif-with-parameter motif parameter value) "Transform motif" phase)
      )
    )
  )
  (fn-do + move-motif _
    (param position Point)
    (param phase ValueChangePhase)
    (call replace-motif (call motif-at motif (call pattern-wrapped-position design position)) "Move motif" phase)
  )
  (fn-do _ replace-motif _
    (param next PatternMotif)
    (param title String)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (let motifs (call List (in (if-expr (== (. each id) (. next id)) next each) (. design motifs))))
    (call apply (call pattern-with-motifs design motifs) title phase)
  )
  (fn-do + add-motif _
    (param kind MotifKind)
    (return-if (if (>= (. design motifs length) 24)))
    (blank)
    (let next (call PatternMotif next-id kind (call Point 0.5 0.5) 80 0° 50 1))
    (+= next-id 1)
    (call apply (call pattern-with-motifs design (++ (. design motifs) (list next))) "Add motif")
    (= selected (- (. design motifs length) 1))
  )
  (fn-do + duplicate _
    (return-if (if (>= (. design motifs length) 24)))
    (blank)
    (let current motif)
    (let next
      (call PatternMotif
        (block
          (arg next-id)
          (arg (. current kind))
          (arg (call pattern-wrapped-position design (+ (. current position) (call Point 0.12 0.12))))
          (arg (. current scale))
          (arg (. current rotation))
          (arg (. current shape))
          (arg (. current ink))
        )
      )
    )
    (+= next-id 1)
    (call apply (call pattern-with-motifs design (++ (. design motifs) (list next))) "Duplicate motif")
    (= selected (- (. design motifs length) 1))
  )
  (fn-do + remove _
    (return-if (if (<= (. design motifs length) 1)))
    (blank)
    (let id (. motif id))
    (let motifs (call List (in each (. design motifs) (when (!= (. each id) id)))))
    (call apply (call pattern-with-motifs design motifs) "Delete motif")
    (= selected (call min selected (- (. motifs length) 1)))
  )
)

(type _ PatternEdit (is Tuple)
  (implements CommandHistoryEntry)
  (prop + session PatternSession)
  (prop + before PatternDesign)
  (prop + after PatternDesign)
  (fn-do + undo _
    (call (. session restore) before)
  )
  (fn-do + redo _
    (call (. session restore) after)
  )
)
