(import ./jelly-body)
(import ./jelly-game)
(import ./jelly-material)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/painter)
(import /math)
(import /time/duration)
(blank)
(prop + jelly-ink RGBA (= "#35284f"))
(prop + jelly-muted RGBA (= "#8c7c9f"))
(prop _ morning RGBA (= "#fff9ee"))
(prop _ dusk RGBA (= "#f0eafa"))
(prop _ card-top RGBA (= "#f9eafa"))
(prop _ card-bottom RGBA (= "#fff6ed"))
(prop _ pedestal-shade RGBA (= "#c4afd8"))
(prop _ pedestal-face RGBA (= "#eee0f6"))
(prop _ card-rim _ (= (call RGBA 1 1 1 0.82)))
(prop _ blush _ (= (call RGBA 1 0.85 0.86 0.3)))
(prop _ lilac _ (= (call RGBA 0.8 0.77 0.96 0.19)))
(prop _ sparkle-color _ (= (call RGBA 0.67 0.54 0.77 0.22)))
(prop _ cheek-color _ (= (call RGBA 0.83 0.26 0.46 0.22)))
(prop _ glint-color _ (= (call RGBA 1 1 1 0.9)))
(prop _ jelly-shadow _ (= (call Shadow (call RGBA 0.25 0.13 0.4 0.18) 8 0 6)))
(prop _ card-radius _ (= 42.0))
(prop _ halo-center _ (= (call Point 284 254)))
(prop _ sparkle-count _ (= 16))
(prop _ nervous-risk _ (= 0.72))
(prop _ shader-margin _ (= 28.0))
(prop _ outline-order _ (= (list 0 1 2 5 8 7 6 3)))
(prop _ sparkle-tips _ (= (list (call Point 0 -1) (call Point 1 0) (call Point 0 1) (call Point -1 0))))
(prop _ palette (list RGBA) (= (list "#ee79aa" "#8d83e8" "#61cbb7" "#ffbc65" "#72bcec" "#cf8cda")))

(fn-expr + jelly-color RGBA
  (param flavor Int)
  ([] palette (% flavor (. palette length)))
)

(type + JellyBackdrop (is Painter)
  ; ╌╌╌╌╌╌╌╌╌╌ is Painter ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas fill-gradient) rect (call linear-gradient (. rect top-left) (. rect bottom-right) morning dusk))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) blush)
    (call dot canvas (call spot rect 0 0.53) (* (. rect height) 0.26))
    (= (. canvas fill-color) lilac)
    (call dot canvas (call spot rect 0.98 0.29) (* (. rect height) 0.25))
    (for (in index (..< 0 sparkle-count))
      (let across (% (* index 0.618034) 1.0))
      (let down (+ 0.28 (* (% (* index 0.754878) 1.0) 0.56)))
      (call sparkle canvas (call spot rect across down) (+ 3.5 (* (call sin (as index Float)) 1.5)) sparkle-color)
    )
  )
)

(fn-do + paint-jelly-stage _
  (param canvas Canvas)
  (param game JellyGame)
  (param is-aiming Bool)
  (let area (call Rect jelly-stage-size))
  (let card (call Outline area card-radius))
  (let clock (. game clock))
  (let is-nervous (or (> (. game risk) nervous-risk) (. game is-toppled)))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) card)
    (let wash (call linear-gradient (. area top-center) (. area bottom-center) card-top card-bottom))
    (call (. canvas fill-gradient) area wash)
    (= (. canvas stroke-color) null)
    (call halo canvas 233 0.33)
    (call halo canvas 173 0.28)
    (call halo canvas 112 0.3)
    (call (. canvas translate) 0 (. game camera))
    (call paint-pedestal canvas)
    (let block (. game current))
    (if (and is-aiming block)
      (call paint-drop-guide canvas game block)
    )
    (for (in item (. game blocks))
      (if (call is-onstage item (. game camera))
        (call paint-jelly canvas item clock is-nervous 0)
      )
    )
    (if block
      (let gaze (call clamp (/ (- (. game target-x) (. block place x)) 100) -1.0 1.0))
      (call paint-jelly canvas block clock false gaze)
    )
    (for (in spark (. game sparks))
      (call paint-spark canvas spark clock)
    )
  )
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) card-rim)
  (= (. canvas stroke-width) 2)
  (call (. canvas outline) card)
)

(fn-do _ halo _
  (param canvas Canvas)
  (param radius Float)
  (param alpha Float)
  (= (. canvas fill-color) (call RGBA 1 1 1 alpha))
  (call dot canvas halo-center radius)
)

(fn-do _ paint-pedestal _
  (param canvas Canvas)
  (let width (. jelly-stage-size width))
  (= (. canvas fill-color) (call RGBA 0.38 0.22 0.47 0.08))
  (call (. canvas oval) (call Rect 14 (+ jelly-floor-y 16) (- width 28) 26))
  (call pill canvas (call Rect 10 (+ jelly-floor-y 10) (- width 20) 17) pedestal-shade 8)
  (call pill canvas (call Rect 0 jelly-floor-y width 18) pedestal-face 9)
  (call pill canvas (call Rect 15 (+ jelly-floor-y 2) (- width 30) 5) (call RGBA 1 1 1 0.8) 3)
)

(fn-do _ paint-drop-guide _
  (param canvas Canvas)
  (param game JellyGame)
  (param block Jelly)
  (let color (call jelly-color (. block flavor)))
  (let surface (. game surface))
  (= (. canvas fill-color) (call (. color with-alpha) 0.1))
  (call (. canvas oval) (call Rect (. block left) (- surface 5) (. block size width) 10))
  (= (. canvas fill-color) (call (. color with-alpha) 0.25))
  (let y (+ (. block bottom) 18))
  (while (< y (- surface 12))
    (call dot canvas (call Point (. block place x) y) 1.5)
    (+= y 13)
  )
)

(fn-do _ paint-jelly _
  (param canvas Canvas)
  (param block Jelly)
  (param clock Seconds)
  (param is-nervous Bool)
  (param gaze Float)
  (do-use (. canvas saved-state)
    (call (. canvas translate) (. block place x) (. block place y))
    (call (. canvas transform) (call matrix-from-rotation (. block angle) (call Point 0 0)))
    (= (. canvas stroke-color) null)
    (call trace-jelly canvas block)
    (call (. canvas shadow-path) jelly-shadow)
    (= (. canvas shape-fill) (call gelatin-for block))
    (call (. canvas rect) (call shader-bounds block))
    (= (. canvas shape-fill) null)
    (call paint-face canvas block clock is-nervous gaze)
  )
)

(fn-do _ paint-face _
  (param canvas Canvas)
  (param block Jelly)
  (param clock Seconds)
  (param is-nervous Bool)
  (param gaze Float)
  (let body (. block body))
  (let center (call (. body offset) 4))
  (let left (call (. body offset) 3))
  (let right (call (. body offset) 5))
  (let tilt (call atan2 (- (. right y) (. left y)) (- (+ (. block size width) (. right x)) (. left x))))
  (call (. canvas translate) (. center x) (- (. center y) 3))
  (call (. canvas transform) (call matrix-from-rotation tilt (call Point 0 0)))
  (= (. canvas fill-color) cheek-color)
  (call (. canvas oval) (call Rect -33 6 13 7))
  (call (. canvas oval) (call Rect 20 6 13 7))
  (let is-blinking (> (call sin (+ (* (as clock Float) 1.7) (* (. block flavor) 2.1))) 0.993))
  (let eye-height (if-expr is-blinking 2.0 (if-expr is-nervous 9.0 11.0)))
  (for (in side (list -1 1))
    (let x (+ (* side 15) (* gaze 2) (/ (. center x) 3)))
    (= (. canvas fill-color) jelly-ink)
    (call (. canvas oval) (call Rect (- x 3.3) -2 6.6 eye-height))
    (if (not is-blinking)
      (= (. canvas fill-color) glint-color)
      (call (. canvas circle) (+ x 0.8) 0.5 1.3)
    )
  )
  (let is-alarmed (or is-nervous (. block is-falling)))
  (if is-alarmed
    (= (. canvas fill-color) jelly-ink)
    (call (. canvas oval) (call Rect -3 10 6 (if-expr (. block is-falling) 8 5)))
    (else
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) jelly-ink)
      (= (. canvas stroke-width) 2.2)
      (= (. canvas stroke-cap) (. LineCap round))
      (call (. canvas curve) -5 10 -3 16 3 16 5 10)
    )
  )
)

(fn-do _ trace-jelly _
  (param canvas Canvas)
  (param block Jelly)
  (let points (call (of List Point) (in (call (. block shape-point) each) outline-order)))
  (let count (. points length))
  (let radius (call min 18.0 (* (. block size height) 0.28)))
  (let incoming (call (of List Point) (in (call edge-point points each -1 radius) (..< 0 count))))
  (let outgoing (call (of List Point) (in (call edge-point points each 1 radius) (..< 0 count))))
  (call (. canvas begin))
  (call (. canvas move) (. incoming head x) (. incoming head y))
  (for (in index (..< 0 count))
    (let corner ([] points index))
    (let after ([] outgoing index))
    (let enter (call handle ([] incoming index) corner))
    (let leave (call handle after corner))
    (call (. canvas curve) (. enter x) (. enter y) (. leave x) (. leave y) (. after x) (. after y))
    (call (. canvas line) ([] incoming (% (+ index 1) count)))
  )
  (call (. canvas enclose))
)

(fn-do _ paint-spark _
  (param canvas Canvas)
  (param spark JellySpark)
  (param clock Seconds)
  (let remaining (- (+ (. spark born) (. spark lifetime)) clock))
  (let color (call (. (call jelly-color (. spark flavor)) with-alpha) (call clamp-unit (* (as remaining Float) 2))))
  (do-use (. canvas saved-state)
    (call (. canvas translate) (. spark place x) (. spark place y))
    (call (. canvas transform) (call matrix-from-rotation (. spark turn) (call Point 0 0)))
    (call sparkle canvas (call Point 0 0) (. spark size) color)
  )
)

(fn-do _ sparkle _
  (param canvas Canvas)
  (param center Point)
  (param size Float)
  (param color RGBA)
  (let start (+ center (* (. sparkle-tips head) size)))
  (= (. canvas fill-color) color)
  (= (. canvas stroke-color) null)
  (call (. canvas begin))
  (call (. canvas move) (. start x) (. start y))
  (for (in index (..< 0 4))
    (let from ([] sparkle-tips index))
    (let to ([] sparkle-tips (% (+ index 1) 4)))
    (let pinch (+ center (* (+ from to) (* size 0.2))))
    (let tip (+ center (* to size)))
    (call (. canvas curve) (. pinch x) (. pinch y) (. pinch x) (. pinch y) (. tip x) (. tip y))
  )
  (call (. canvas end) true)
)

(fn-do _ pill _
  (param canvas Canvas)
  (param rect Rect)
  (param color RGBA)
  (param radius Float)
  (= (. canvas fill-color) color)
  (call (. canvas outline) (call Outline rect radius))
)

(fn-do _ dot _
  (param canvas Canvas)
  (param center Point)
  (param radius Float)
  (call (. canvas circle) (. center x) (. center y) radius)
)

(fn-expr _ gelatin-for Gelatin
  (param block Jelly)
  (call Gelatin
    (block
      (arg (call jelly-color (. block flavor)))
      (arg (. block size width))
      (arg (. block size height))
      (arg (call offset 0))
      (arg (call offset 1))
      (arg (call offset 2))
      (arg (call offset 3))
      (arg (call offset 4))
      (arg (call offset 5))
      (arg (call offset 6))
      (arg (call offset 7))
      (arg (call offset 8))
    )
  )
  (where
    (lazy offset (. block body offset))
  )
)

(fn-do _ shader-bounds Rect
  (param block Jelly)
  (let margin (call Point shader-margin shader-margin))
  (for (in index (..< 0 jelly-node-count))
    (let offset (call (. block body offset) index))
    (= margin (call (. margin max) (+ (call Point (call abs (. offset x)) (call abs (. offset y))) 16)))
  )
  (let half (+ (call Point (/ (. block size width) 2) (/ (. block size height) 2)) margin))
  (return (call Rect (- (. half x)) (- (. half y)) (* (. half x) 2) (* (. half y) 2)))
)

(fn-expr _ is-onstage Bool
  (param block Jelly)
  (param camera Float)
  (and (> (+ (. block bottom) camera) 0) (< (+ (. block top) camera) (. jelly-stage-size height)))
)

(fn-expr _ edge-point Point
  (param points (list Point))
  (param index Int)
  (param neighbor Int)
  (param radius Float)
  (+ here (* (- next here) amount))
  (where
    (lazy count (. points length))
    (lazy here ([] points index))
    (lazy next ([] points (% (+ index count neighbor) count)))
    (lazy amount (call min 0.45 (/ radius (call max 1.0 (call (. here distance) next)))))
  )
)

(fn-expr _ handle Point
  (param from Point)
  (param corner Point)
  (+ from (* (- corner from) (/ 2 3.0)))
)

(fn-expr _ spot Point
  (param rect Rect)
  (param across Float)
  (param down Float)
  (+ (. rect top-left) (call Point (* (. rect width) across) (* (. rect height) down)))
)
