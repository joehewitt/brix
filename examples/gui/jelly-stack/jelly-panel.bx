(import ./jelly-art)
(import ./jelly-game)
(import ./jelly-theme)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ settle-pause Seconds (= 600ms))
(prop _ lean-pause Seconds (= 200ms))
(prop _ topple-pause Seconds (= 1300ms))

(type + JellyPanel (is Box)
  (using JellyTheme)
  (event + activations Bool)
  (event + pauses Bool)
  (event + restarts Bool)
  (event + interruptions Bool)
  (prop + game _ (= (call JellyGame)))
  (prop _ owner-window (of Ancestor Window))
  (prop _ is-window-active _ (= (?? (?. #owner-window #is-active) false)))
  (prop _ action-hint _
    (=
      (block
        (case? (is #phase .aiming)
          "Click or Space  Drop"
        )
        (case? (is #phase .paused)
          "Click or Space  Resume"
        )
        (case? (is #phase .over)
          "Click or Space  Play again"
        )
        (default
          ""
        )
      )
    )
  )
  (prop + phase _
    (machine
      (state running
        (do
          (call (. game reset))
        )
        (blank)
        (then running (trigger on restarts))
        (blank)
        (state aiming
          (for (on tick frames)
            (call (. game aim) (. tick delta))
          )
          (blank)
          (then falling (trigger on activations)
            (do
              (call (. game drop))
            )
          )
          (then paused (trigger on pauses))
          (then paused (trigger on interruptions))
        )
        (blank)
        (state paused
          (then aiming (trigger on pauses))
          (then aiming (trigger on activations))
        )
        (blank)
        (state falling
          (for (on tick frames)
            (call (. game fall) (. tick delta))
          )
          (blank)
          (then settling (trigger for .stacked (. game landings)))
          (then teetering (trigger for .leaning (. game landings)))
          (then toppled (trigger for .missed (. game landings)))
        )
        (blank)
        (state settling
          (for (on tick frames)
            (call (. game settle) (. tick delta))
          )
          (blank)
          (then aiming (trigger on (call Timer settle-pause))
            (do
              (call (. game spawn))
            )
          )
        )
        (blank)
        (state teetering
          (for (on tick frames)
            (call (. game settle) (. tick delta))
          )
          (blank)
          (then toppled (trigger on (call Timer lean-pause)))
        )
        (blank)
        (state toppled
          (do
            (call (. game topple))
          )
          (blank)
          (for (on tick frames)
            (call (. game collapse) (. tick delta))
          )
          (blank)
          (then over (trigger on (call Timer topple-pause)))
        )
        (blank)
        (state over
          (for (on tick frames)
            (call (. game collapse) (. tick delta))
          )
          (blank)
          (then running (trigger on activations))
        )
      )
    )
  )
  (content
    (<> This (• jelly-panel)
      (<> Box (• jelly-header)
        (<> Box (• jelly-side))
        (<> Label (text: "Jelly Stack") (• jelly-title))
        (<> Box (• jelly-side)
          (<> Label (• jelly-score)
            (= text (call score-text (call animated (. #game #score) $gui-motion-smooth)))
          )
          (<> Label (• jelly-caption)
            (= text (str "BEST " (. #game #best)))
          )
        )
      )
      (blank)
      (<> JellyBoard (id: board) (• jelly-board)
        (= game game)
        (= is-aiming (is #phase .aiming))
        (= is-pokeable (not (or (is #phase .paused) (is #phase .toppled) (is #phase .over))))
        (= is-dimmed (or (is #phase .paused) (is #phase .over)))
      )
      (blank)
      (<> Box (• jelly-footer)
        (<> Box (• jelly-help)
          (<> Label (• jelly-caption)
            (= text #action-hint)
          )
          (<> Label (text: "Right-click  Poke") (• jelly-caption))
          (<> Label (text: "P or Esc  Pause") (• jelly-caption))
          (<> Label (text: "R  Restart") (• jelly-caption))
        )
      )
      (blank)
      (if (is #phase .paused)
        (<> JellyBanner (text: "Paused"))
      )
      (if (is #phase .over)
        (<> JellyBanner (text: "Game over")
          (= detail (str (. game score)))
        )
      )
      (blank)
      (<> KeyShortcut (text: "Drop")
        (= key .space)
        (= repeat false)
        (= action (=> () :do (<- activations true)))
      )
      (<> KeyShortcut (text: "Drop")
        (= key .enter)
        (= repeat false)
        (= action (=> () :do (<- activations true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key .escape)
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key (char "p"))
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Restart")
        (= key (char "r"))
        (= repeat false)
        (= action (=> () :do (<- restarts true)))
      )
    )
  )
  (whenever-rule #is-window-active
    (if (not is-window-active)
      (<- interruptions true)
    )
  )
  (subscribe-for (on jolt (. game jolts))
    (call (. board play) (shape $shake jolt))
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (<- activations true)
      (call (. event cancel))
    )
  )
)

(type + JellyBoard (is Box)
  (prop + game JellyGame)
  (prop + is-aiming _ (= false))
  (prop + is-pokeable _ (= false))
  (prop + is-dimmed _ (= false))
  (prop _ clock _ (= (. #game #clock)))
  (depends invalidate-paint clock is-aiming)
  (subscribe-for (on event pointer-down)
    (if (and is-pokeable (== (. event button) (. PointerButton secondary)))
      (call (. game poke) (call world-point (. event point)))
      (call (. event cancel))
    )
  )
  (fn-expr _ world-point Point
    (param point Point)
    (call Point (. staged x) (- (. staged y) (. game camera)))
    (where
      (lazy stage-rect stage)
      (lazy scale (/ (. stage-rect width) (. jelly-stage-size width)))
      (lazy staged (/ (- (+ point (. bounds top-left)) (. stage-rect top-left)) scale))
    )
  )
  (fn-expr _ stage Rect :get
    (call image-fit-rect jelly-stage-size content-bounds (. ImageFit contain) center center)
    (where
      (lazy center (. AnchorPoint center))
    )
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect stage)
    (return-if (if (<= (. stage-rect width) 0)))
    (let scale (/ (. stage-rect width) (. jelly-stage-size width)))
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. stage-rect x) (. stage-rect y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (call paint-jelly-stage canvas game is-aiming)
    )
  )
)

(type + JellyBanner (is Box)
  (using JellyTheme)
  (prop + title String)
  (prop + detail _ (= ""))
  (fn-do + This _
    (param title _)
  )
  (content
    (<> This (• jelly-banner)
      (<> Label (• jelly-banner-title)
        (= text #title)
      )
      (if #detail
        (<> Label (• jelly-banner-detail)
          (= text #detail)
        )
      )
    )
  )
)

(fn-expr _ score-text String
  (param value Float)
  (str (as (call round value) Int))
)
