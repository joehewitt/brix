(import ./jelly-art)
(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)

(style JellyTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxTransform)
  (using GUIBoxWindowDrag)
  (rule jelly-panel (• flex-col) (• text jelly-ink)
    (= background (call JellyBackdrop))
    (= cursor (. CursorStyle pointing-hand))
    (= focus-mode (. FocusMode keys))
    (= focus-default true)
    (= focus-home true)
  )
  (rule jelly-header (• flex-row) (• items-start) (• h 122) (• px 32) (• pt 24)
    (= window-draggable true)
  )
  (rule jelly-side (• flex-col) (• w 180))
  (rule jelly-title (• flex 1) (• h 84)
    (= font-family "Avenir Next")
    (= font-size 56)
    (= font-weight (. FontWeight heavy))
    (= text-alignment (. TextAlignment center))
  )
  (rule jelly-score (• h 40)
    (= font-size 28)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment right))
  )
  (rule jelly-caption (• text jelly-muted) (• h 20)
    (= font-size 11)
    (= text-alignment (. TextAlignment right))
  )
  (rule jelly-board (• flex 1) (• mx 64)
    (= motion gui-motion-smooth)
    (when-style #is-dimmed
      (= opacity 0.2%%)
    )
  )
  (rule jelly-footer (• flex-row) (• justify-end) (• h 100) (• pr 28) (• pb 20))
  (rule jelly-help (• flex-col) (• justify-end) (• w 240))
  (rule jelly-banner (• absolute) (• center .parent) (• flex-col) (• w 440)
    (when-style #is-entering
      (= animation pop-in)
    )
    (when-style #is-leaving
      (= animation popup-out)
    )
  )
  (rule jelly-banner-title (• h 56)
    (= font-size 39)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment center))
  )
  (rule jelly-banner-detail (• h 40)
    (= font-size 25)
    (= text-alignment (. TextAlignment center))
  )
)
