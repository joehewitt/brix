(import /gui)
(import /gui/web-sign-in)
(import /gui/web-view)
(blank)
(prop _ bridge-page _ (= "<body style='font: 15px -apple-system; padding: 24px'><h2>Bridge</h2><input placeholder='Type, then copy and paste'><p><button onclick='window.webkit.messageHandlers.yumi.postMessage({ title: document.title, at: Date.now() })'>Send a message to Brix</button> <button onclick='alert(confirm(\"Confirm?\"))'>Alert</button></p></body>"))
(prop _ sign-in-url _ (= "https://httpbin.org/redirect-to?url=brix-web-view%3A%2F%2Fsigned-in%3Fcode%3Ddemo"))
(blank)

(main
  (<> App
    (<> BrowserWindow
      (= title "Brix GUI: Web View")
      (= size (tuple 1100 760))
    )
  )
)

(style BrowserTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (rule browser-toolbar (• bg gui-panel-color)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule browser-status (• text gui-muted-text-color))
)

(type _ BrowserWindow (is Window)
  (using BrowserTheme)
  (prop + status _ (= "Ready"))
  (content
    (<> This (• flex-col)
      (<> Box (• browser-toolbar) (• flex-row) (• p 8)
        (<> Button (text: "‹") (• w 32)
          (= is-enabled (. #page #can-go-back))
          (= action (=> () :do (call (. page go-back))))
        )
        (<> Button (text: "›") (• w 32) (• ml 4)
          (= is-enabled (. #page #can-go-forward))
          (= action (=> () :do (call (. page go-forward))))
        )
        (<> Button (text: "Reload") (• w 72) (• ml 4)
          (= action (=> () :do (call (. page reload))))
        )
        (<> TextInput (id: address) (• flex 1) (• ml 8)
          (= text (?? (. #page #url) ""))
          (= placeholder "Enter a URL")
        )
        (<> Button (text: "Title") (• w 64) (• ml 8)
          (= action (=> () :do (call read-title)))
        )
        (<> Button (text: "Bridge") (• w 72) (• ml 4)
          (= action (=> () :do (= (. page html) bridge-page)))
        )
        (<> Button (text: "Sign In") (• w 72) (• ml 4)
          (= action (=> () :do (call sign-in)))
        )
      )
      (<> WebView (id: page) (• flex 1)
        (= url "https://www.apple.com")
        (= is-inspectable true)
        (= message-names (list "brix"))
      )
      (<> Label (• browser-status) (• h 24) (• px 8)
        (= text #status)
      )
      (blank)
      (<> KeyShortcut (text: "Back")
        (= key (call KeyCombo "Cmd+["))
        (= stable-key "web-view.back")
        (= action (=> () :do (call (. page go-back))))
      )
      (<> KeyShortcut (text: "Forward")
        (= key (call KeyCombo "Cmd+]"))
        (= stable-key "web-view.forward")
        (= action (=> () :do (call (. page go-forward))))
      )
    )
  )
  (subscribe-for (on event (. address submit))
    (let text (. event text))
    (= (. page url) (if-expr (!= (call (. text find) "://") null) text (str "https://" text)))
  )
  (subscribe-for (on event (. page loaded))
    (= status (str "Loaded " (. event url)))
  )
  (subscribe-for (on event (. page load-failed))
    (= status (str "Failed to load " (. event url) ": " (?? (. event error) "")))
  )
  (subscribe-for (on event (. page message))
    (= status (str "Message from page: " (. event name) " " (. event body)))
  )
  (fn-do _ read-title _
    (do-new
      (let value
        (call (. page evaluate) "document.title"
          (block
            (on-error (: err WebScriptError)
              (= status (str "Script failed: " (. err message)))
              (return)
            )
          )
        )
      )
      (= status (str "document.title is " value))
    )
  )
  (fn-do _ sign-in _
    (do-new
      (let callback
        (call web-sign-in this sign-in-url "brix-web-view"
          (block
            (on-error (: err WebSignInError)
              (= status (str "Sign-in failed: " (. err message)))
              (return)
            )
          )
        )
      )
      (= status (if-expr callback (str "Signed in: " callback) "Sign-in canceled"))
    )
  )
)
