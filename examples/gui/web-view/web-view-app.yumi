/gui
/gui/web-sign-in
/gui/web-view

_ bridge-page = "<body style='font: 15px -apple-system; padding: 24px'><h2>Bridge</h2><input placeholder='Type, then copy and paste'><p><button onclick='window.webkit.messageHandlers.yumi.postMessage({ title: document.title, at: Date.now() })'>Send a message to Yumi</button> <button onclick='alert(confirm(\"Confirm?\"))'>Alert</button></p></body>"
_ sign-in-url = "https://httpbin.org/redirect-to?url=yumi-web-view%3A%2F%2Fsigned-in%3Fcode%3Ddemo"

<App
    <BrowserWindow
        title = "Yumi GUI: Web View"
        size = (1100, 760)

━━━━━━━━━━━━━━━━━━━━
• BrowserTheme
    using GUIDefaultTheme
    using GUIBoxPaint
    using GUITextPaint

• browser-toolbar • bg:gui-panel-color
    border-color = gui-divider-color
    border-bottom-width = 1

• browser-status • text:gui-muted-text-color

━━━━━━━━━━━━━━━━━━━━
_ BrowserWindow is Window
    using BrowserTheme

+ status = "Ready"

────────────────────

<This • flex-col
    <Box • browser-toolbar flex-row p:8
        <Button "‹" • w:32
            is-enabled = #page.#can-go-back
            action = => do page.go-back()
        <Button "›" • w:32 ml:4
            is-enabled = #page.#can-go-forward
            action = => do page.go-forward()
        <Button "Reload" • w:72 ml:4
            action = => do page.reload()
        <TextInput address • flex:1 ml:8
            text = #page.#url ?? ""
            placeholder = "Enter a URL"
        <Button "Title" • w:64 ml:8
            action = => do read-title()
        <Button "Bridge" • w:72 ml:4
            action = => do page.html = bridge-page
        <Button "Sign In" • w:72 ml:4
            action = => do sign-in()
    <WebView page • flex:1
        url = "https://www.apple.com"
        is-inspectable = true
        message-names = ["yumi"]
    <Label • browser-status h:24 px:8
        text = #status

    <KeyShortcut "Back"
        key = KeyCombo("Cmd+[")
        stable-key = "web-view.back"
        action = => do page.go-back()
    <KeyShortcut "Forward"
        key = KeyCombo("Cmd+]")
        stable-key = "web-view.forward"
        action = => do page.go-forward()

────────────────────
for event on address.submit

. text = event.text
page.url = if text.find("://") != null then text else "https://$text"

────────────────────
for event on page.loaded

status = "Loaded ${event.url}"

────────────────────
for event on page.load-failed

status = "Failed to load ${event.url}: ${event.error ?? ""}"

────────────────────
for event on page.message

status = "Message from page: ${event.name} ${event.body}"

────────────────────
_ do read-title

do new
    . value = page.evaluate("document.title")
        catch err WebScriptError
            status = "Script failed: ${err.message}"
            =
    status = "document.title is $value"

────────────────────
_ do sign-in

do new
    . callback = web-sign-in(this, sign-in-url, "yumi-web-view")
        catch err WebSignInError
            status = "Sign-in failed: ${err.message}"
            =
    status = if callback then "Signed in: ${callback}" else "Sign-in canceled"
