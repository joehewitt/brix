(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ wave-lifetime _ (= 5.5))
(prop _ wave-speed _ (= 1150.0))
(prop _ max-waves _ (= 8))

(type + MotionMode (is Union)
  (variant transforms)
  (variant deform)
  (fn-expr + title String :get
    (match this
      (case .transforms
        "Transforms"
      )
      (default
        "Deform"
      )
    )
  )
)

(type + PaintTier (is Union)
  (variant routes)
  (variant dashes)
  (variant aligned)
  (variant effects)
  (fn-expr + title String :get
    (match this
      (case .routes
        "Routes"
      )
      (case .dashes
        "+ Dashes"
      )
      (case .aligned
        "+ Aligned"
      )
      (default
        "+ Glows & FX"
      )
    )
  )
  (fn-expr + has-dashes Bool :get
    (!= this (. PaintTier routes))
  )
  (fn-expr + has-aligned Bool :get
    (or (== this (. PaintTier aligned)) (== this (. PaintTier effects)))
  )
  (fn-expr + has-effects Bool :get
    (== this (. PaintTier effects))
  )
)

(type + RouteKind (is Union)
  (variant trunk)
  (variant orbital)
  (variant express)
  (variant spur)
  (variant ferry)
)

(type + CubicSeg (is Tuple)
  (prop + x0 F64)
  (prop + y0 F64)
  (prop + c1x F64)
  (prop + c1y F64)
  (prop + c2x F64)
  (prop + c2y F64)
  (prop + x3 F64)
  (prop + y3 F64)
  (prop + length F64)
)

(type + SamplePose (is Tuple)
  (prop + x F64)
  (prop + y F64)
  (prop + heading F64)
  (prop + seg-index Int)
  (prop + local-t F64)
)

(type + TransitRoute
  (prop + index Int)
  (prop + kind RouteKind)
  (prop + palette Int)
  (prop + width F64)
  (prop + is-closed Bool)
  (prop + uses-miter Bool)
  (prop + dash-length F64)
  (prop + segments (list CubicSeg))
  (prop + total-length F64)
  (prop + path Path)
  (prop + hub-ids (list Int))
  (fn-do + This _
    (param route-index Int)
    (param route-kind RouteKind)
    (param route-palette Int)
    (param route-width F64)
    (param closed Bool)
    (param miter Bool)
    (param dash F64)
    (param segs (list CubicSeg))
    (= index route-index)
    (= kind route-kind)
    (= palette route-palette)
    (= width route-width)
    (= is-closed closed)
    (= uses-miter miter)
    (= dash-length dash)
    (= segments segs)
    (let sum 0.0)
    (let built (call Path))
    (for (in i (..< 0 (. segs length)))
      (let seg ([] segs i))
      (+= sum (. seg length))
      (if (== i 0)
        (call (. built move-to) (. seg x0) (. seg y0))
      )
      (call (. built cubic-curve-to) (. seg c1x) (. seg c1y) (. seg c2x) (. seg c2y) (. seg x3) (. seg y3))
    )
    (if closed
      (call (. built close))
    )
    (= total-length (call max 1.0 sum))
    (= path built)
  )
  (fn-do + sample-at SamplePose
    (param distance F64)
    (let wrapped (% distance total-length))
    (if (< wrapped 0)
      (+= wrapped total-length)
    )
    (let remaining wrapped)
    (let count (. segments length))
    (for (in i (..< 0 count))
      (let seg ([] segments i))
      (if (or (<= remaining (. seg length)) (== i (- count 1)))
        (let local-t (call clamp (/ remaining (call max 1.0 (. seg length))) 0.0 1.0))
        (let pt (call eval-seg seg local-t))
        (let tan (call tangent-seg seg local-t))
        (return (call SamplePose (as (. pt x) F64) (as (. pt y) F64) (call atan2 (as (. tan y) F64) (as (. tan x) F64)) i local-t))
      )
      (-= remaining (. seg length))
    )
    (return (call SamplePose 0 0 0 0 0))
  )
)

(type + TransitHub (is Tuple)
  (prop + index Int)
  (prop + x F64)
  (prop + y F64)
  (prop + radius F64)
  (prop + is-major Bool)
  (prop + is-capsule Bool)
  (prop + capsule-w F64)
  (prop + capsule-h F64)
  (prop + name-index Int)
  (prop + palette Int)
  (prop + phase F64)
  (prop + route-ids (list Int))
)

(type + WaterBody (is Tuple)
  (prop + path Path)
  (prop + is-island Bool)
)

(type + Waterway (is Tuple)
  (prop + width F64)
  (prop + segments (list CubicSeg))
)

(type + ParkZone (is Tuple)
  (prop + rect Rect)
  (prop + radius F64)
  (prop + tone Int)
  (prop + path Path)
)

(type + DistrictLabel (is Tuple)
  (prop + name-index Int)
  (prop + x F64)
  (prop + y F64)
)

(type + Vehicle (is Tuple)
  (prop + index Int)
  (prop + route-index Int)
  (prop + offset F64)
  (prop + speed F64)
  (prop + direction F64)
  (prop + is-ferry Bool)
  (prop + is-express Bool)
  (prop + is-animated Bool)
)

(type + RerouteWave (is Tuple)
  (prop + hub-index Int)
  (prop + origin Point)
  (prop + born F64)
  (prop + route-ids (list Int))
)

(type + SceneCounts (is Tuple)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + dashed Int)
)

(type + TransitNetwork
  (prop + vehicle-count Int)
  (prop + animated-share Int)
  (prop + extent Dimensions)
  (prop + bay-path Path)
  (prop + shelf-path Path)
  (prop + island-path Path)
  (prop + waterways (list Waterway))
  (prop + parks (list ParkZone))
  (prop + districts (list DistrictLabel))
  (prop + routes (list TransitRoute))
  (prop + hubs (list TransitHub))
  (prop + vehicles (list Vehicle))
  (prop + animated-vehicles Int)
  (fn-do + This _
    (param count Int)
    (param share Int)
    (= vehicle-count count)
    (= animated-share share)
    (let scale-factor (if-expr (<= count 250) 1.0 (if-expr (<= count 1000) 1.45 2.1)))
    (let map-w (* 4200.0 scale-factor))
    (let map-h (* 2650.0 scale-factor))
    (= extent (call Dimensions map-w map-h))
    (call build-geography map-w map-h scale-factor count)
    (call build-routes map-w map-h scale-factor count)
    (call build-hubs map-w map-h scale-factor)
    (call build-vehicles count share)
  )
  (fn-do _ build-geography _
    (param map-w F64)
    (param map-h F64)
    (param scale F64)
    (param count Int)
    (let pad 28.0)
    (let r (- map-w pad))
    (let b (- map-h pad))
    (let bay (call Path))
    (call (. bay move-to) (* map-w 0.6) b)
    (call (. bay cubic-curve-to) (* map-w 0.64) (* map-h 0.84) (* map-w 0.72) (* map-h 0.76) (* map-w 0.8) (* map-h 0.68))
    (call (. bay cubic-curve-to) (* map-w 0.87) (* map-h 0.61) (* map-w 0.91) (* map-h 0.5) r (* map-h 0.44))
    (call (. bay line-to) r b)
    (call (. bay close))
    (= bay-path bay)
    (let shelf (call Path))
    (call (. shelf move-to) (* map-w 0.66) b)
    (call (. shelf cubic-curve-to) (* map-w 0.71) (* map-h 0.88) (* map-w 0.78) (* map-h 0.81) (* map-w 0.86) (* map-h 0.74))
    (call (. shelf cubic-curve-to) (* map-w 0.91) (* map-h 0.69) (* map-w 0.95) (* map-h 0.6) r (* map-h 0.54))
    (call (. shelf line-to) r b)
    (call (. shelf close))
    (= shelf-path shelf)
    (let isl (call Path))
    (let ix (* map-w 0.83))
    (let iy (* map-h 0.81))
    (let irx (* 165.0 scale))
    (let iry (* 98.0 scale))
    (call (. isl move-to) (- ix irx) iy)
    (call (. isl cubic-curve-to) (- ix (* irx 0.8)) (- iy (* iry 1.15)) (+ ix (* irx 0.5)) (- iy (* iry 1.05)) (+ ix irx) (- iy (* iry 0.1)))
    (call (. isl cubic-curve-to) (+ ix (* irx 0.85)) (+ iy (* iry 1.1)) (- ix (* irx 0.55)) (+ iy (* iry 1.05)) (- ix irx) iy)
    (call (. isl close))
    (= island-path isl)
    (let river-xs (list pad (* map-w 0.18) (* map-w 0.36) (* map-w 0.54) (* map-w 0.72) (* map-w 0.86)))
    (let river-ys (list (* map-h 0.76) (* map-h 0.64) (* map-h 0.68) (* map-h 0.56) (* map-h 0.66) (* map-h 0.78)))
    (+= waterways (call Waterway (* 118.0 scale) (call catmull-rom-cubics river-xs river-ys 1.0)))
    (let trib-xs (list (* map-w 0.24) (* map-w 0.31) (* map-w 0.38) (* map-w 0.46)))
    (let trib-ys (list pad (* map-h 0.22) (* map-h 0.44) (* map-h 0.62)))
    (+= waterways (call Waterway (* 68.0 scale) (call catmull-rom-cubics trib-xs trib-ys 1.0)))
    (call add-park map-w map-h 0.44 0.16 0.13 0.18 (* 26.0 scale) 0)
    (call add-park map-w map-h 0.14 0.24 0.11 0.14 (* 24.0 scale) 1)
    (call add-park map-w map-h 0.68 0.22 0.12 0.12 (* 28.0 scale) 2)
    (call add-park map-w map-h 0.26 0.78 0.14 0.11 (* 22.0 scale) 0)
    (call add-park map-w map-h 0.54 0.78 0.09 0.1 (* 20.0 scale) 1)
    (if (> count 250)
      (call add-park map-w map-h 0.82 0.14 0.09 0.12 (* 20.0 scale) 2)
      (call add-park map-w map-h 0.12 0.52 0.09 0.11 (* 20.0 scale) 1)
      (call add-park map-w map-h 0.62 0.44 0.08 0.09 (* 18.0 scale) 0)
    )
    (+= districts (call DistrictLabel 0 (* map-w 0.48) (* map-h 0.46)))
    (+= districts (call DistrictLabel 1 (* map-w 0.85) (* map-h 0.88)))
    (+= districts (call DistrictLabel 2 (* map-w 0.18) (* map-h 0.17)))
    (+= districts (call DistrictLabel 3 (* map-w 0.76) (* map-h 0.19)))
    (+= districts (call DistrictLabel 4 (* map-w 0.17) (* map-h 0.83)))
    (+= districts (call DistrictLabel 5 (* map-w 0.49) (* map-h 0.13)))
    (+= districts (call DistrictLabel 6 (* map-w 0.68) (* map-h 0.52)))
    (+= districts (call DistrictLabel 7 (* map-w 0.34) (* map-h 0.34)))
  )
  (fn-do _ add-park _
    (param map-w F64)
    (param map-h F64)
    (param fx F64)
    (param fy F64)
    (param fw F64)
    (param fh F64)
    (param radius F64)
    (param tone Int)
    (let rect (call Rect (* map-w fx) (* map-h fy) (* map-w fw) (* map-h fh)))
    (let p (call rounded-rect-path rect radius))
    (+= parks (call ParkZone rect radius tone p))
  )
  (fn-do _ build-routes _
    (param map-w F64)
    (param map-h F64)
    (param scale F64)
    (param count Int)
    (let cx (* map-w 0.48))
    (let cy (* map-h 0.48))
    (let lane-pitch (* 18.0 scale))
    (let bend-r (* 92.0 scale))
    (let route-id 0)
    (let ring-count (if-expr (<= count 250) 2 (if-expr (<= count 1000) 4 7)))
    (for (in ring (..< 0 ring-count))
      (let frac (+ 0.18 (* (as ring F64) (/ 0.25 (as (call max 1 (- ring-count 1)) F64)))))
      (let rx (* map-w frac))
      (let ry (* map-h (* frac 1.06)))
      (let segs (call build-octagonal-loop cx cy rx ry (* 78.0 scale)))
      (let width (if-expr (== ring 0) (* 8.0 scale) (* 6.5 scale)))
      (+= routes (call TransitRoute route-id (. RouteKind orbital) (% (+ (* ring 3) 3) 12) width true false 0.0 segs))
      (+= route-id 1)
    )
    (let ns-x (* map-w 0.43))
    (let ew-y (* map-h 0.44))
    (let diag1-x (* map-w 0.54))
    (let diag1-y (* map-h 0.51))
    (let diag2-x (* map-w 0.48))
    (let diag2-y (* map-h 0.55))
    (let ns-lanes (if-expr (<= count 250) 3 (if-expr (<= count 1000) 5 9)))
    (for (in i (..< 0 ns-lanes))
      (let lane (- (as i F64) (* (as (- ns-lanes 1) F64) 0.5)))
      (let off (* lane lane-pitch))
      (let spread-n (* lane (* 250.0 scale)))
      (let spread-s (* lane (* 230.0 scale)))
      (let pts
        (list
          (call Point (call clamp (+ ns-x spread-n) 110.0 (- map-w 110.0)) 95.0)
          (call Point (+ ns-x off (* spread-n 0.38)) (* map-h 0.22))
          (call Point (+ ns-x off) (* map-h 0.33))
          (call Point (+ ns-x off) (* map-h 0.64))
          (call Point (+ ns-x off (* spread-s 0.45)) (* map-h 0.78))
          (call Point (call clamp (+ ns-x spread-s) 110.0 (- map-w 110.0)) (- map-h 95.0))
        )
      )
      (let is-exp (== (% i 2) 1))
      (let kind (if-expr is-exp (. RouteKind express) (. RouteKind trunk)))
      (let segs (call octilinear-cubics pts bend-r))
      (+= routes (call TransitRoute route-id kind (% i 12) (* (if-expr is-exp 7.4 6.2) scale) false false (if-expr is-exp (* 18.0 scale) 0.0) segs))
      (+= route-id 1)
    )
    (let ew-lanes (if-expr (<= count 250) 3 (if-expr (<= count 1000) 5 9)))
    (for (in i (..< 0 ew-lanes))
      (let lane (- (as i F64) (* (as (- ew-lanes 1) F64) 0.5)))
      (let off (* lane lane-pitch))
      (let spread-w (* lane (* 185.0 scale)))
      (let spread-e (* lane (* 175.0 scale)))
      (let pts
        (list
          (call Point 95.0 (call clamp (+ ew-y spread-w) 110.0 (- map-h 110.0)))
          (call Point (* map-w 0.21) (+ ew-y off (* spread-w 0.35)))
          (call Point (* map-w 0.31) (+ ew-y off))
          (call Point (* map-w 0.65) (+ ew-y off))
          (call Point (* map-w 0.77) (+ ew-y off (* spread-e 0.4)))
          (call Point (- map-w 95.0) (call clamp (+ ew-y spread-e) 110.0 (- map-h 110.0)))
        )
      )
      (let is-exp (== (% i 3) 0))
      (let kind (if-expr is-exp (. RouteKind express) (. RouteKind trunk)))
      (let segs (call octilinear-cubics pts bend-r))
      (+= routes (call TransitRoute route-id kind (% (+ i 4) 12) (* (if-expr is-exp 7.4 6.2) scale) false false (if-expr is-exp (* 18.0 scale) 0.0) segs))
      (+= route-id 1)
    )
    (let diag-lanes (if-expr (<= count 250) 2 (if-expr (<= count 1000) 4 8)))
    (for (in i (..< 0 diag-lanes))
      (let lane (- (as i F64) (* (as (- diag-lanes 1) F64) 0.5)))
      (let off (* lane lane-pitch 1.15))
      (let pts1
        (list
          (call Point (+ 110.0 (* (call max 0.0 lane) 180.0 scale)) (+ 110.0 (* (call max 0.0 (- lane)) 140.0 scale)))
          (call Point (+ (* map-w 0.28) off) (+ (* map-h 0.29) (- off)))
          (call Point (+ diag1-x off) (+ diag1-y (- off)))
          (call Point (+ (* map-w 0.72) off) (+ (* map-h 0.69) (- off)))
          (call Point (call clamp (+ (* map-w 0.85) off) 120.0 (- map-w 120.0)) (call clamp (+ (* map-h 0.82) (- off)) 120.0 (- map-h 120.0)))
        )
      )
      (let segs1 (call octilinear-cubics pts1 bend-r))
      (+= routes (call TransitRoute route-id (if-expr (== (% i 2) 0) (. RouteKind express) (. RouteKind trunk)) (% (+ i 7) 12) (* 6.6 scale) false false (if-expr (== (% i 2) 0) (* 18.0 scale) 0.0) segs1))
      (+= route-id 1)
      (let pts2
        (list
          (call Point (+ 110.0 (* (call max 0.0 lane) 160.0 scale)) (- map-h 110.0 (* (call max 0.0 (- lane)) 140.0 scale)))
          (call Point (+ (* map-w 0.26) off) (+ (* map-h 0.74) off))
          (call Point (+ diag2-x off) (+ diag2-y off))
          (call Point (+ (* map-w 0.72) off) (+ (* map-h 0.28) off))
          (call Point (- map-w 110.0 (* (call max 0.0 (- lane)) 160.0 scale)) (+ 110.0 (* (call max 0.0 lane) 140.0 scale)))
        )
      )
      (let segs2 (call octilinear-cubics pts2 bend-r))
      (+= routes (call TransitRoute route-id (. RouteKind trunk) (% (+ i 9) 12) (* 6.0 scale) false (== (% i 2) 1) 0.0 segs2))
      (+= route-id 1)
    )
    (let spur-count (if-expr (<= count 250) 4 (if-expr (<= count 1000) 10 22)))
    (for (in sp (..< 0 spur-count))
      (let segs (call build-commuter-spur map-w map-h scale sp spur-count))
      (+= routes (call TransitRoute route-id (. RouteKind spur) (% (+ (* sp 5) 2) 12) (* 4.4 scale) false true (if-expr (== (% sp 3) 0) (* 12.0 scale) 0.0) segs))
      (+= route-id 1)
    )
    (let ferry1
      (call catmull-rom-cubics
        (list (* map-w 0.08) (* map-w 0.24) (* map-w 0.42) (* map-w 0.62) (* map-w 0.81))
        (list (* map-h 0.72) (* map-h 0.65) (* map-h 0.64) (* map-h 0.6) (* map-h 0.79))
        1.0
      )
    )
    (+= routes (call TransitRoute route-id (. RouteKind ferry) 5 (* 3.4 scale) false false (* 14.0 scale) ferry1))
    (+= route-id 1)
    (let ferry2
      (call catmull-rom-cubics
        (list (* map-w 0.67) (* map-w 0.75) (* map-w 0.83) (* map-w 0.93))
        (list (* map-h 0.92) (* map-h 0.86) (* map-h 0.82) (* map-h 0.6))
        1.0
      )
    )
    (+= routes (call TransitRoute route-id (. RouteKind ferry) 5 (* 3.4 scale) false false (* 14.0 scale) ferry2))
    (+= route-id 1)
    (let ferry3
      (call catmull-rom-cubics
        (list (* map-w 0.26) (* map-w 0.34) (* map-w 0.43) (* map-w 0.56))
        (list (* map-h 0.08) (* map-h 0.3) (* map-h 0.58) (* map-h 0.58))
        1.0
      )
    )
    (+= routes (call TransitRoute route-id (. RouteKind ferry) 5 (* 3.4 scale) false false (* 14.0 scale) ferry3))
    (+= route-id 1)
  )
  (fn-do _ build-hubs _
    (param map-w F64)
    (param map-h F64)
    (param scale F64)
    (let hub-id 0)
    (let merge-dist (* 125.0 scale))
    (let cx (* map-w 0.43))
    (let cy (* map-h 0.44))
    (let grand-routes (call (of List Int)))
    (for (in r (..< 0 (. routes length)))
      (let route ([] routes r))
      (if (!= (. route kind) (. RouteKind ferry))
        (let p0 (call (. route sample-at) (* (. route total-length) 0.5)))
        (if (< (call seg-dist (- (. p0 x) cx) (- (. p0 y) cy)) (* 220.0 scale))
          (+= grand-routes r)
          (+= (. route hub-ids) 0)
        )
      )
    )
    (+= hubs (call TransitHub 0 cx cy (* 22.0 scale) true true (* 74.0 scale) (* 30.0 scale) 0 3 0.0 grand-routes))
    (+= hub-id 1)
    (for (in r (..< 0 (. routes length)))
      (let route ([] routes r))
      (let stops (if-expr (== (. route kind) (. RouteKind ferry)) 4 (if-expr (== (. route kind) (. RouteKind orbital)) 8 (if-expr (== (. route kind) (. RouteKind spur)) 3 7))))
      (for (in s (..< 0 stops))
        (let u (/ (+ (as s F64) 0.5) (as stops F64)))
        (let pose (call (. route sample-at) (* (. route total-length) u)))
        (let px (. pose x))
        (let py (. pose y))
        (if (and (> px 70) (< px (- map-w 70)) (> py 70) (< py (- map-h 70)))
          (let matched -1)
          (for (in h (..< 0 (. hubs length)))
            (let existing ([] hubs h))
            (let dx (- px (. existing x)))
            (let dy (- py (. existing y)))
            (if (< (+ (* dx dx) (* dy dy)) (* merge-dist merge-dist))
              (= matched h)
              (break)
            )
          )
          (if (>= matched 0)
            (let existing ([] hubs matched))
            (call append-unique (. existing route-ids) r)
            (call append-unique (. route hub-ids) matched)
            (let multi (>= (. existing route-ids length) 3))
            (let new-r (call min (* 20.0 scale) (+ (. existing radius) (* 1.3 scale))))
            (let cw (if-expr (. existing is-capsule) (. existing capsule-w) (if-expr multi (* 48.0 scale) (* new-r 2.0))))
            (let ch (if-expr (. existing is-capsule) (. existing capsule-h) (if-expr multi (* 22.0 scale) (* new-r 2.0))))
            (let upgraded (call TransitHub (. existing index) (. existing x) (. existing y) new-r (>= (. existing route-ids length) 2) (or (. existing is-capsule) multi) cw ch (. existing name-index) (. existing palette) (. existing phase) (. existing route-ids)))
            (= ([] hubs matched) upgraded)
            (else
              (let route-list (list r))
              (let phase (* (call hash-unit (+ (* hub-id 43) 17)) 2 π))
              (+= hubs (call TransitHub hub-id px py (* 8.5 scale) false false (* 17.0 scale) (* 17.0 scale) (% hub-id 24) (. route palette) phase route-list))
              (call append-unique (. route hub-ids) hub-id)
              (+= hub-id 1)
            )
          )
        )
      )
    )
  )
  (fn-do _ build-vehicles _
    (param count Int)
    (param share Int)
    (let route-count (. routes length))
    (let moving-total 0)
    (for (in i (..< 0 count))
      (let route-idx (% (+ (* i 7) (/ i 3)) route-count))
      (let route ([] routes route-idx))
      (let offset (* (call hash-unit (+ (* i 67) 19)) (. route total-length)))
      (let is-ferry (== (. route kind) (. RouteKind ferry)))
      (let is-express (== (. route kind) (. RouteKind express)))
      (let base-speed (if-expr is-ferry 70.0 (if-expr is-express 240.0 155.0)))
      (let speed (* base-speed (+ 0.76 (* 0.48 (call hash-unit (+ (* i 83) 29))))))
      (let direction (if-expr (== (% i 2) 0) 1.0 -1.0))
      (let is-anim (call item-is-animated i share))
      (if is-anim
        (+= moving-total 1)
      )
      (+= vehicles (call Vehicle i route-idx offset speed direction is-ferry is-express is-anim))
    )
    (= animated-vehicles moving-total)
  )
  (fn-do + visible-hubs Int
    (param world Rect)
    (let pad 120.0)
    (let min-x (- (. world x) pad))
    (let max-x (+ (. world x) (. world width) pad))
    (let min-y (- (. world y) pad))
    (let max-y (+ (. world y) (. world height) pad))
    (let shown 0)
    (for (in hub hubs)
      (if (and (>= (. hub x) min-x) (<= (. hub x) max-x) (>= (. hub y) min-y) (<= (. hub y) max-y))
        (+= shown 1)
      )
    )
    (return shown)
  )
  (fn-do + nearest-hub (? TransitHub)
    (param point Point)
    (return-if null (if (== (. hubs length) 0)))
    (let best ([] hubs 0))
    (let best-d2 1e18)
    (for (in hub hubs)
      (let dx (- (as (. point x) F64) (. hub x)))
      (let dy (- (as (. point y) F64) (. hub y)))
      (let d2 (+ (* dx dx) (* dy dy)))
      (if (< d2 best-d2)
        (= best-d2 d2)
        (= best hub)
      )
    )
    (return best)
  )
)

(type + WaveField
  (prop + waves (list RerouteWave))
  (fn-do + spawn-at _
    (param network TransitNetwork)
    (param world-pt Point)
    (param clock F64)
    (let hit (call (. network nearest-hub) world-pt))
    (return-if (if (not hit)))
    (let origin (call Point (. hit x) (. hit y)))
    (+= waves (call RerouteWave (. hit index) origin clock (. hit route-ids)))
    (while (> (. waves length) max-waves)
      (call (. waves remove) 0)
    )
  )
  (fn-do + prune _
    (param clock F64)
    (let idx 0)
    (while (< idx (. waves length))
      (if (> (- clock (. ([] waves idx) born)) wave-lifetime)
        (call (. waves remove) idx)
        (else
          (+= idx 1)
        )
      )
    )
  )
  (fn-do + route-boost F64
    (param route-id Int)
    (param clock F64)
    (let boost 0.0)
    (for (in wave waves)
      (let age (- clock (. wave born)))
      (if (and (>= age 0) (< age wave-lifetime))
        (for (in id (. wave route-ids))
          (if (== id route-id)
            (let fade (- 1.0 (/ age wave-lifetime)))
            (= boost (call max boost fade))
          )
        )
      )
    )
    (return boost)
  )
)

(fn-do _ build-octagonal-loop (list CubicSeg)
  (param cx F64)
  (param cy F64)
  (param rx F64)
  (param ry F64)
  (param corner-r F64)
  (let cut 0.42)
  (let pts
    (list
      (call Point (- cx (* rx cut)) (- cy ry))
      (call Point (+ cx (* rx cut)) (- cy ry))
      (call Point (+ cx rx) (- cy (* ry cut)))
      (call Point (+ cx rx) (+ cy (* ry cut)))
      (call Point (+ cx (* rx cut)) (+ cy ry))
      (call Point (- cx (* rx cut)) (+ cy ry))
      (call Point (- cx rx) (+ cy (* ry cut)))
      (call Point (- cx rx) (- cy (* ry cut)))
    )
  )
  (return (call closed-rounded-cubics pts corner-r))
)

(fn-do _ closed-rounded-cubics (list CubicSeg)
  (param pts (list Point))
  (param radius F64)
  (let segs (call (of List CubicSeg)))
  (let n (. pts length))
  (return-if segs (if (< n 3)))
  (let starts (call (of List Point)))
  (let ends (call (of List Point)))
  (for (in i (..< 0 n))
    (let prev ([] pts (% (+ i (- n 1)) n)))
    (let curr ([] pts i))
    (let next ([] pts (% (+ i 1) n)))
    (let dx1 (- (as (. prev x) F64) (as (. curr x) F64)))
    (let dy1 (- (as (. prev y) F64) (as (. curr y) F64)))
    (let dx2 (- (as (. next x) F64) (as (. curr x) F64)))
    (let dy2 (- (as (. next y) F64) (as (. curr y) F64)))
    (let l1 (call max 1.0 (call seg-dist dx1 dy1)))
    (let l2 (call max 1.0 (call seg-dist dx2 dy2)))
    (let r (call min radius (* 0.35 (call min l1 l2))))
    (+= starts (call Point (+ (as (. curr x) F64) (* (/ dx1 l1) r)) (+ (as (. curr y) F64) (* (/ dy1 l1) r))))
    (+= ends (call Point (+ (as (. curr x) F64) (* (/ dx2 l2) r)) (+ (as (. curr y) F64) (* (/ dy2 l2) r))))
  )
  (for (in i (..< 0 n))
    (let curr ([] pts i))
    (let a ([] starts i))
    (let b ([] ends i))
    (let next-a ([] starts (% (+ i 1) n)))
    (let ax (as (. a x) F64))
    (let ay (as (. a y) F64))
    (let cx (as (. curr x) F64))
    (let cy (as (. curr y) F64))
    (let bx (as (. b x) F64))
    (let by (as (. b y) F64))
    (+= segs (call make-cubic ax ay (+ ax (* (- cx ax) 0.58)) (+ ay (* (- cy ay) 0.58)) (+ bx (* (- cx bx) 0.58)) (+ by (* (- cy by) 0.58)) bx by))
    (let nx (as (. next-a x) F64))
    (let ny (as (. next-a y) F64))
    (+= segs (call make-cubic bx by (+ bx (* (- nx bx) 0.33)) (+ by (* (- ny by) 0.33)) (+ bx (* (- nx bx) 0.67)) (+ by (* (- ny by) 0.67)) nx ny))
  )
  (return segs)
)

(fn-do _ octilinear-cubics (list CubicSeg)
  (param pts (list Point))
  (param radius F64)
  (let segs (call (of List CubicSeg)))
  (let n (. pts length))
  (return-if segs (if (< n 2)))
  (let cur-x (as (. ([] pts 0) x) F64))
  (let cur-y (as (. ([] pts 0) y) F64))
  (for (in i (..< 1 (- n 1)))
    (let prev ([] pts (- i 1)))
    (let curr ([] pts i))
    (let next ([] pts (+ i 1)))
    (let dx1 (- (as (. prev x) F64) (as (. curr x) F64)))
    (let dy1 (- (as (. prev y) F64) (as (. curr y) F64)))
    (let dx2 (- (as (. next x) F64) (as (. curr x) F64)))
    (let dy2 (- (as (. next y) F64) (as (. curr y) F64)))
    (let l1 (call max 1.0 (call seg-dist dx1 dy1)))
    (let l2 (call max 1.0 (call seg-dist dx2 dy2)))
    (let r (call min radius (* 0.36 (call min l1 l2))))
    (let cx (as (. curr x) F64))
    (let cy (as (. curr y) F64))
    (let ax (+ cx (* (/ dx1 l1) r)))
    (let ay (+ cy (* (/ dy1 l1) r)))
    (let bx (+ cx (* (/ dx2 l2) r)))
    (let by (+ cy (* (/ dy2 l2) r)))
    (if (> (call seg-dist (- ax cur-x) (- ay cur-y)) 1.0)
      (+= segs (call make-cubic cur-x cur-y (+ cur-x (* (- ax cur-x) 0.33)) (+ cur-y (* (- ay cur-y) 0.33)) (+ cur-x (* (- ax cur-x) 0.67)) (+ cur-y (* (- ay cur-y) 0.67)) ax ay))
    )
    (+= segs (call make-cubic ax ay (+ ax (* (- cx ax) 0.58)) (+ ay (* (- cy ay) 0.58)) (+ bx (* (- cx bx) 0.58)) (+ by (* (- cy by) 0.58)) bx by))
    (= cur-x bx)
    (= cur-y by)
  )
  (let last-x (as (. ([] pts (- n 1)) x) F64))
  (let last-y (as (. ([] pts (- n 1)) y) F64))
  (if (> (call seg-dist (- last-x cur-x) (- last-y cur-y)) 1.0)
    (+= segs (call make-cubic cur-x cur-y (+ cur-x (* (- last-x cur-x) 0.33)) (+ cur-y (* (- last-y cur-y) 0.33)) (+ cur-x (* (- last-x cur-x) 0.67)) (+ cur-y (* (- last-y cur-y) 0.67)) last-x last-y))
  )
  (return segs)
)

(fn-do _ build-commuter-spur (list CubicSeg)
  (param map-w F64)
  (param map-h F64)
  (param scale F64)
  (param index Int)
  (param total Int)
  (let oct-angle (* (as (% index 8) F64) (/ π 4)))
  (let ring-r (+ 0.22 (* 0.12 (call hash-unit (+ (* index 37) 5)))))
  (let x0 (+ (* map-w 0.48) (* (call cos oct-angle) map-w ring-r)))
  (let y0 (+ (* map-h 0.48) (* (call sin oct-angle) map-h ring-r)))
  (let reach (* (+ 420.0 (* 360.0 (call hash-unit (+ (* index 53) 13)))) scale))
  (let x1 (call clamp (+ x0 (* (call cos oct-angle) reach 0.55)) 95.0 (- map-w 95.0)))
  (let y1 (call clamp (+ y0 (* (call sin oct-angle) reach 0.55)) 95.0 (- map-h 95.0)))
  (let turn (if-expr (== (% index 2) 0) (/ π 4) (- (/ π 4))))
  (let a2 (+ oct-angle turn))
  (let x2 (call clamp (+ x1 (* (call cos a2) reach 0.55)) 95.0 (- map-w 95.0)))
  (let y2 (call clamp (+ y1 (* (call sin a2) reach 0.55)) 95.0 (- map-h 95.0)))
  (let ignored total)
  (return (call octilinear-cubics (list (call Point x0 y0) (call Point x1 y1) (call Point x2 y2)) (* 54.0 scale)))
)

(fn-do _ catmull-rom-cubics (list CubicSeg)
  (param xs (list F64))
  (param ys (list F64))
  (param smoothness F64)
  (let segs (call (of List CubicSeg)))
  (let count (. xs length))
  (return-if segs (if (< count 2)))
  (let tension (/ smoothness 6.0))
  (for (in i (..< 0 (- count 1)))
    (let i0 (call max 0 (- i 1)))
    (let i3 (call min (- count 1) (+ i 2)))
    (let x0 ([] xs i))
    (let y0 ([] ys i))
    (let x3 ([] xs (+ i 1)))
    (let y3 ([] ys (+ i 1)))
    (let c1x (+ x0 (* (- x3 ([] xs i0)) tension)))
    (let c1y (+ y0 (* (- y3 ([] ys i0)) tension)))
    (let c2x (- x3 (* (- ([] xs i3) x0) tension)))
    (let c2y (- y3 (* (- ([] ys i3) y0) tension)))
    (+= segs (call make-cubic x0 y0 c1x c1y c2x c2y x3 y3))
  )
  (return segs)
)

(fn-do _ rounded-rect-path Path
  (param rect Rect)
  (param radius F64)
  (let p (call Path))
  (let x (as (. rect x) F64))
  (let y (as (. rect y) F64))
  (let w (as (. rect width) F64))
  (let h (as (. rect height) F64))
  (let r (call min radius (* 0.45 (call min w h))))
  (let k (* r 0.5522847498307936))
  (call (. p move-to) (+ x r) y)
  (call (. p line-to) (- (+ x w) r) y)
  (call (. p cubic-curve-to) (+ (- (+ x w) r) k) y (+ x w) (- (+ y r) k) (+ x w) (+ y r))
  (call (. p line-to) (+ x w) (- (+ y h) r))
  (call (. p cubic-curve-to) (+ x w) (+ (- (+ y h) r) k) (+ (- (+ x w) r) k) (+ y h) (- (+ x w) r) (+ y h))
  (call (. p line-to) (+ x r) (+ y h))
  (call (. p cubic-curve-to) (- (+ x r) k) (+ y h) x (+ (- (+ y h) r) k) x (- (+ y h) r))
  (call (. p line-to) x (+ y r))
  (call (. p cubic-curve-to) x (- (+ y r) k) (- (+ x r) k) y (+ x r) y)
  (call (. p close))
  (return p)
)

(fn-do _ append-unique _
  (param items (list Int))
  (param value Int)
  (for (in item items)
    (return-if (if (== item value)))
  )
  (+= items value)
)

(fn-expr _ item-is-animated Bool
  (param index Int)
  (param share Int)
  (if-expr (<= share 0)
    false
    (if-expr (>= share 100)
      true
      (< (% (* index 37) 100) share)
    )
  )
)

(fn-expr + hash-unit F64
  (param seed Int)
  (- value (call floor value))
  (where
    (lazy value (* (call sin (* (as seed F64) 12.9898)) 43758.5453))
  )
)

(fn-expr _ seg-dist F64
  (param dx F64)
  (param dy F64)
  (call sqrt (+ (* dx dx) (* dy dy)))
)

(fn-do + make-cubic CubicSeg
  (param x0 F64)
  (param y0 F64)
  (param c1x F64)
  (param c1y F64)
  (param c2x F64)
  (param c2y F64)
  (param x3 F64)
  (param y3 F64)
  (let chord (call seg-dist (- x3 x0) (- y3 y0)))
  (let poly (+ (call seg-dist (- c1x x0) (- c1y y0)) (call seg-dist (- c2x c1x) (- c2y c1y)) (call seg-dist (- x3 c2x) (- y3 c2y))))
  (let approx (call max 1.0 (* 0.5 (+ chord poly))))
  (return (call CubicSeg x0 y0 c1x c1y c2x c2y x3 y3 approx))
)

(fn-expr + eval-seg Point
  (param seg CubicSeg)
  (param t F64)
  (call Point (+ (* u3 (. seg x0)) (* 3 u2 t (. seg c1x)) (* 3 u t2 (. seg c2x)) (* t3 (. seg x3))) (+ (* u3 (. seg y0)) (* 3 u2 t (. seg c1y)) (* 3 u t2 (. seg c2y)) (* t3 (. seg y3))))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy u3 (* u2 u))
    (lazy t2 (* t t))
    (lazy t3 (* t2 t))
  )
)

(fn-expr + tangent-seg Point
  (param seg CubicSeg)
  (param t F64)
  (call Point (+ (* 3 u2 (- (. seg c1x) (. seg x0))) (* 6 u t (- (. seg c2x) (. seg c1x))) (* 3 t2 (- (. seg x3) (. seg c2x)))) (+ (* 3 u2 (- (. seg c1y) (. seg y0))) (* 6 u t (- (. seg c2y) (. seg c1y))) (* 3 t2 (- (. seg y3) (. seg c2y)))))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy t2 (* t t))
  )
)

(fn-do + slice-seg CubicSeg
  (param seg CubicSeg)
  (param t0 F64)
  (param t1 F64)
  (let a (call clamp t0 0.0 1.0))
  (let b (call clamp t1 0.0 1.0))
  (let right (call split-right seg a))
  (let denom (call max 1e-6 (- 1.0 a)))
  (let rel (call clamp (/ (- b a) denom) 0.0 1.0))
  (return (call split-left right rel))
)

(fn-do _ split-right CubicSeg
  (param seg CubicSeg)
  (param t F64)
  (let p01x (+ (. seg x0) (* (- (. seg c1x) (. seg x0)) t)))
  (let p01y (+ (. seg y0) (* (- (. seg c1y) (. seg y0)) t)))
  (let p12x (+ (. seg c1x) (* (- (. seg c2x) (. seg c1x)) t)))
  (let p12y (+ (. seg c1y) (* (- (. seg c2y) (. seg c1y)) t)))
  (let p23x (+ (. seg c2x) (* (- (. seg x3) (. seg c2x)) t)))
  (let p23y (+ (. seg c2y) (* (- (. seg y3) (. seg c2y)) t)))
  (let p012x (+ p01x (* (- p12x p01x) t)))
  (let p012y (+ p01y (* (- p12y p01y) t)))
  (let p123x (+ p12x (* (- p23x p12x) t)))
  (let p123y (+ p12y (* (- p23y p12y) t)))
  (let midx (+ p012x (* (- p123x p012x) t)))
  (let midy (+ p012y (* (- p123y p012y) t)))
  (return (call make-cubic midx midy p123x p123y p23x p23y (. seg x3) (. seg y3)))
)

(fn-do _ split-left CubicSeg
  (param seg CubicSeg)
  (param t F64)
  (let p01x (+ (. seg x0) (* (- (. seg c1x) (. seg x0)) t)))
  (let p01y (+ (. seg y0) (* (- (. seg c1y) (. seg y0)) t)))
  (let p12x (+ (. seg c1x) (* (- (. seg c2x) (. seg c1x)) t)))
  (let p12y (+ (. seg c1y) (* (- (. seg c2y) (. seg c1y)) t)))
  (let p23x (+ (. seg c2x) (* (- (. seg x3) (. seg c2x)) t)))
  (let p23y (+ (. seg c2y) (* (- (. seg y3) (. seg c2y)) t)))
  (let p012x (+ p01x (* (- p12x p01x) t)))
  (let p012y (+ p01y (* (- p12y p01y) t)))
  (let p123x (+ p12x (* (- p23x p12x) t)))
  (let p123y (+ p12y (* (- p23y p12y) t)))
  (let midx (+ p012x (* (- p123x p012x) t)))
  (let midy (+ p012y (* (- p123y p012y) t)))
  (return (call make-cubic (. seg x0) (. seg y0) p01x p01y p012x p012y midx midy))
)

(fn-expr + wave-front-radius F64
  (param age F64)
