(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ wave-lifetime _ (= 5.5))
(prop _ wave-speed _ (= 1150.0))
(prop _ max-waves _ (= 8))

(type + MotionMode (is Union)
  (variant transforms)
  (variant deform)
  (fn-expr + title String :get
    (match this
      (case .transforms
        "Transforms"
      )
      (default
        "Deform"
      )
    )
  )
)

(type + PaintTier (is Union)
  (variant routes)
  (variant dashes)
  (variant aligned)
  (variant effects)
  (fn-expr + title String :get
    (match this
      (case .routes
        "Routes"
      )
      (case .dashes
        "+ Dashes"
      )
      (case .aligned
        "+ Aligned"
      )
      (default
        "+ Glows & FX"
      )
    )
  )
  (fn-expr + has-dashes Bool :get
    (!= this (. PaintTier routes))
  )
  (fn-expr + has-aligned Bool :get
    (or (== this (. PaintTier aligned)) (== this (. PaintTier effects)))
  )
  (fn-expr + has-effects Bool :get
    (== this (. PaintTier effects))
  )
)

(type + RouteKind (is Union)
  (variant trunk)
  (variant orbital)
  (variant express)
  (variant spur)
  (variant ferry)
)

(type + CubicSeg (is Tuple)
  (prop + x0 F64)
  (prop + y0 F64)
  (prop + c1x F64)
  (prop + c1y F64)
  (prop + c2x F64)
  (prop + c2y F64)
  (prop + x3 F64)
  (prop + y3 F64)
  (prop + length F64)
)

(type + SamplePose (is Tuple)
  (prop + x F64)
  (prop + y F64)
  (prop + heading F64)
  (prop + seg-index Int)
  (prop + local-t F64)
)

(type + TransitRoute
  (prop + index Int)
  (prop + kind RouteKind)
  (prop + palette Int)
  (prop + width F64)
  (prop + is-closed Bool)
  (prop + uses-miter Bool)
  (prop + dash-length F64)
  (prop + segments (list CubicSeg))
  (prop + total-length F64)
  (prop + path Path)
  (prop + hub-ids (list Int))
  (fn-do + This _
    (param route-index Int)
    (param route-kind RouteKind)
    (param route-palette Int)
    (param route-width F64)
    (param closed Bool)
    (param miter Bool)
    (param dash F64)
    (param segs (list CubicSeg))
    (= index route-index)
    (= kind route-kind)
    (= palette route-palette)
    (= width route-width)
    (= is-closed closed)
    (= uses-miter miter)
    (= dash-length dash)
    (= segments segs)
    (let sum 0.0)
    (let built (call Path))
    (for (in i (..< 0 (. segs length)))
      (let seg ([] segs i))
      (+= sum (. seg length))
      (if (== i 0)
        (call (. built move-to) (. seg x0) (. seg y0))
      )
      (call (. built cubic-curve-to) (. seg c1x) (. seg c1y) (. seg c2x) (. seg c2y) (. seg x3) (. seg y3))
    )
    (if closed
      (call (. built close))
    )
    (= total-length (call max 1.0 sum))
    (= path built)
  )
  (fn-do + sample-at SamplePose
    (param distance F64)
    (let wrapped (% distance total-length))
    (if (< wrapped 0)
      (+= wrapped total-length)
    )
    (let remaining wrapped)
    (let count (. segments length))
    (for (in i (..< 0 count))
      (let seg ([] segments i))
      (if (or (<= remaining (. seg length)) (== i (- count 1)))
        (let local-t (call clamp (/ remaining (call max 1.0 (. seg length))) 0.0 1.0))
        (let pt (call eval-seg seg local-t))
        (let tan (call tangent-seg seg local-t))
        (return (call SamplePose (as (. pt x) F64) (as (. pt y) F64) (call atan2 (as (. tan y) F64) (as (. tan x) F64)) i local-t))
      )
      (-= remaining (. seg length))
    )
    (return (call SamplePose 0 0 0 0 0))
  )
)

(type + TransitHub (is Tuple)
  (prop + index Int)
  (prop + x F64)
  (prop + y F64)
  (prop + radius F64)
  (prop + is-major Bool)
  (prop + palette Int)
  (prop + phase F64)
  (prop + route-ids (list Int))
)

(type + Waterway (is Tuple)
  (prop + width F64)
  (prop + segments (list CubicSeg))
)

(type + ParkZone (is Tuple)
  (prop + cx F64)
  (prop + cy F64)
  (prop + radius F64)
  (prop + tone Int)
  (prop + path Path)
)

(type + Vehicle (is Tuple)
  (prop + index Int)
  (prop + route-index Int)
  (prop + offset F64)
  (prop + speed F64)
  (prop + direction F64)
  (prop + is-ferry Bool)
  (prop + is-express Bool)
  (prop + is-animated Bool)
)

(type + RerouteWave (is Tuple)
  (prop + hub-index Int)
  (prop + origin Point)
  (prop + born F64)
  (prop + route-ids (list Int))
)

(type + SceneCounts (is Tuple)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + dashed Int)
)

(type + TransitNetwork
  (prop + vehicle-count Int)
  (prop + animated-share Int)
  (prop + extent Dimensions)
  (prop + waterways (list Waterway))
  (prop + parks (list ParkZone))
  (prop + routes (list TransitRoute))
  (prop + hubs (list TransitHub))
  (prop + vehicles (list Vehicle))
  (prop + animated-vehicles Int)
  (fn-do + This _
    (param count Int)
    (param share Int)
    (= vehicle-count count)
    (= animated-share share)
    (let scale-factor (if-expr (<= count 250) 1.0 (if-expr (<= count 1000) 1.55 2.35)))
    (let map-w (* 4200.0 scale-factor))
    (let map-h (* 2650.0 scale-factor))
    (= extent (call Dimensions map-w map-h))
    (call build-waterways map-w map-h scale-factor)
    (call build-parks map-w map-h count)
    (call build-routes map-w map-h count)
    (call build-hubs map-w map-h)
    (call build-vehicles count share)
  )
  (fn-do _ build-waterways _
    (param map-w F64)
    (param map-h F64)
    (param scale-factor F64)
    (let river-count (if-expr (< scale-factor 1.2) 3 (if-expr (< scale-factor 1.9) 4 5)))
    (let pad 64.0)
    (for (in r (..< 0 river-count))
      (let ratio (/ (+ (as r F64) 0.55) (+ (as river-count F64) 0.1)))
      (let steps 7)
      (let horizontal (== (% r 2) 0))
      (let xs (call (of List F64)))
      (let ys (call (of List F64)))
      (for (in step (.. 0 steps))
        (let u (/ (as step F64) (as steps F64)))
        (let x
          (if-expr horizontal
            (+ pad (* (- map-w (* pad 2)) u))
            (call clamp (+ (* map-w ratio) (* (call sin (+ (* u 2 π 1.15) (* (as r F64) 1.3))) map-w 0.13)) (+ pad 40) (- map-w (+ pad 40)))
          )
        )
        (let y
          (if-expr horizontal
            (call clamp (+ (* map-h ratio) (* (call sin (+ (* u 2 π 1.05) (* (as r F64) 1.7))) map-h 0.14)) (+ pad 40) (- map-h (+ pad 40)))
            (+ pad (* (- map-h (* pad 2)) u))
          )
        )
        (+= xs x)
        (+= ys y)
      )
      (let segs (call catmull-rom-cubics xs ys 0.95))
      (+= waterways (call Waterway (* (+ 74.0 (* 26.0 (as (% r 3) F64))) scale-factor) segs))
    )
  )
  (fn-do _ build-parks _
    (param map-w F64)
    (param map-h F64)
    (param count Int)
    (let park-count (if-expr (<= count 250) 18 (if-expr (<= count 1000) 36 72)))
    (for (in p (..< 0 park-count))
      (let cx (+ 180.0 (* (call hash-unit (+ (* p 53) 11)) (- map-w 360.0))))
      (let cy (+ 180.0 (* (call hash-unit (+ (* p 79) 23)) (- map-h 360.0))))
      (let radius (+ 95.0 (* 155.0 (call hash-unit (+ (* p 101) 7)))))
      (let lobes (+ 5 (% p 4)))
      (let path (call Path))
      (let step (/ (* 2 π) (as lobes F64)))
      (for (in k (..< 0 lobes))
        (let a0 (* (as k F64) step))
        (let a1 (* (as (+ k 1) F64) step))
        (let r0 (* radius (+ 0.72 (* 0.42 (call hash-unit (+ (* p 37) (* k 17)))))))
        (let r1 (* radius (+ 0.72 (* 0.42 (call hash-unit (+ (* p 37) (* (% (+ k 1) lobes) 17)))))))
        (let x0 (+ cx (* (call cos a0) r0)))
        (let y0 (+ cy (* (call sin a0) r0)))
        (let x3 (+ cx (* (call cos a1) r1)))
        (let y3 (+ cy (* (call sin a1) r1)))
        (let handle (* (as step F64) 0.36))
        (let c1x (- x0 (* (call sin a0) r0 handle)))
        (let c1y (+ y0 (* (call cos a0) r0 handle)))
        (let c2x (+ x3 (* (call sin a1) r1 handle)))
        (let c2y (- y3 (* (call cos a1) r1 handle)))
        (if (== k 0)
          (call (. path move-to) x0 y0)
        )
        (call (. path cubic-curve-to) c1x c1y c2x c2y x3 y3)
      )
      (call (. path close))
      (+= parks (call ParkZone cx cy radius (% p 3) path))
    )
  )
  (fn-do _ build-routes _
    (param map-w F64)
    (param map-h F64)
    (param count Int)
    (let cx (* map-w 0.5))
    (let cy (* map-h 0.5))
    (let orbital-count (if-expr (<= count 250) 4 (if-expr (<= count 1000) 7 12)))
    (let trunk-count (if-expr (<= count 250) 14 (if-expr (<= count 1000) 28 56)))
    (let spur-count (if-expr (<= count 250) 10 (if-expr (<= count 1000) 24 52)))
    (let route-id 0)
    (for (in ring (..< 0 orbital-count))
      (let frac (/ (+ (as ring F64) 0.72) (+ (as orbital-count F64) 0.55)))
      (let rx (* map-w 0.41 frac))
      (let ry (* map-h 0.4 frac))
      (let off-x (* (- (call hash-unit (+ (* ring 19) 5)) 0.5) map-w 0.06))
      (let off-y (* (- (call hash-unit (+ (* ring 29) 9)) 0.5) map-h 0.06))
      (let seg-count (+ 8 (* (% ring 3) 2)))
      (let segs (call build-orbital-segments (+ cx off-x) (+ cy off-y) rx ry seg-count ring))
      (let width (if-expr (== (% ring 2) 0) 7.5 6.0))
      (+= routes (call TransitRoute route-id (. RouteKind orbital) (% ring 12) width true false 0.0 segs))
      (+= route-id 1)
    )
    (for (in t (..< 0 trunk-count))
      (let is-express (== (% t 3) 0))
      (let kind (if-expr is-express (. RouteKind express) (. RouteKind trunk)))
      (let is-miter (== (% t 4) 1))
      (let segs (call build-diagonal-trunk map-w map-h t trunk-count is-miter))
      (let width (if-expr is-express 7.0 5.5))
      (let dash (if-expr is-express 16.0 0.0))
      (+= routes (call TransitRoute route-id kind (% (+ (* t 5) 2) 12) width false is-miter dash segs))
      (+= route-id 1)
    )
    (for (in sp (..< 0 spur-count))
      (let segs (call build-branch-spur map-w map-h sp))
      (+= routes (call TransitRoute route-id (. RouteKind spur) (% (+ (* sp 7) 4) 12) 4.2 false true (if-expr (== (% sp 3) 0) 10.0 0.0) segs))
      (+= route-id 1)
    )
    (for (in w (..< 0 (. waterways length)))
      (let water ([] waterways w))
      (+= routes (call TransitRoute route-id (. RouteKind ferry) 5 3.6 false false 14.0 (. water segments)))
      (+= route-id 1)
    )
  )
  (fn-do _ build-hubs _
    (param map-w F64)
    (param map-h F64)
    (let hub-id 0)
    (let merge-dist 135.0)
    (for (in r (..< 0 (. routes length)))
      (let route ([] routes r))
      (let stops (if-expr (== (. route kind) (. RouteKind ferry)) 4 (if-expr (== (. route kind) (. RouteKind orbital)) 8 (if-expr (== (. route kind) (. RouteKind spur)) 3 6))))
      (for (in s (..< 0 stops))
        (let u (/ (+ (as s F64) 0.5) (as stops F64)))
        (let pose (call (. route sample-at) (* (. route total-length) u)))
        (let px (. pose x))
        (let py (. pose y))
        (if (and (> px 40) (< px (- map-w 40)) (> py 40) (< py (- map-h 40)))
          (let matched -1)
          (for (in h (..< 0 (. hubs length)))
            (let existing ([] hubs h))
            (let dx (- px (. existing x)))
            (let dy (- py (. existing y)))
            (if (< (+ (* dx dx) (* dy dy)) (* merge-dist merge-dist))
              (= matched h)
              (break)
            )
          )
          (if (>= matched 0)
            (let existing ([] hubs matched))
            (call append-unique (. existing route-ids) r)
            (call append-unique (. route hub-ids) matched)
            (let upgraded (call TransitHub (. existing index) (. existing x) (. existing y) (call min 18.0 (+ (. existing radius) 1.6)) (>= (. existing route-ids length) 2) (. existing palette) (. existing phase) (. existing route-ids)))
            (= ([] hubs matched) upgraded)
            (else
              (let route-list (list r))
              (let phase (* (call hash-unit (+ (* hub-id 43) 17)) 2 π))
              (+= hubs (call TransitHub hub-id px py 7.5 false (. route palette) phase route-list))
              (call append-unique (. route hub-ids) hub-id)
              (+= hub-id 1)
            )
          )
        )
      )
    )
  )
  (fn-do _ build-vehicles _
    (param count Int)
    (param share Int)
    (let route-count (. routes length))
    (let moving-total 0)
    (for (in i (..< 0 count))
      (let route-idx (% (+ (* i 7) (/ i 3)) route-count))
      (let route ([] routes route-idx))
      (let offset (* (call hash-unit (+ (* i 67) 19)) (. route total-length)))
      (let is-ferry (== (. route kind) (. RouteKind ferry)))
      (let is-express (== (. route kind) (. RouteKind express)))
      (let base-speed (if-expr is-ferry 65.0 (if-expr is-express 230.0 145.0)))
      (let speed (* base-speed (+ 0.72 (* 0.58 (call hash-unit (+ (* i 83) 29))))))
      (let direction (if-expr (== (% i 2) 0) 1.0 -1.0))
      (let is-anim (call item-is-animated i share))
      (if is-anim
        (+= moving-total 1)
      )
      (+= vehicles (call Vehicle i route-idx offset speed direction is-ferry is-express is-anim))
    )
    (= animated-vehicles moving-total)
  )
  (fn-do + visible-hubs Int
    (param world Rect)
    (let pad 120.0)
    (let min-x (- (. world x) pad))
    (let max-x (+ (. world x) (. world width) pad))
    (let min-y (- (. world y) pad))
    (let max-y (+ (. world y) (. world height) pad))
    (let shown 0)
    (for (in hub hubs)
      (if (and (>= (. hub x) min-x) (<= (. hub x) max-x) (>= (. hub y) min-y) (<= (. hub y) max-y))
        (+= shown 1)
      )
    )
    (return shown)
  )
  (fn-do + nearest-hub (? TransitHub)
    (param point Point)
    (return-if null (if (== (. hubs length) 0)))
    (let best ([] hubs 0))
    (let best-d2 1e18)
    (for (in hub hubs)
      (let dx (- (as (. point x) F64) (. hub x)))
      (let dy (- (as (. point y) F64) (. hub y)))
      (let d2 (+ (* dx dx) (* dy dy)))
      (if (< d2 best-d2)
        (= best-d2 d2)
        (= best hub)
      )
    )
    (return best)
  )
)

(type + WaveField
  (prop + waves (list RerouteWave))
  (fn-do + spawn-at _
    (param network TransitNetwork)
    (param world-pt Point)
    (param clock F64)
    (let hit (call (. network nearest-hub) world-pt))
    (return-if (if (not hit)))
    (let origin (call Point (. hit x) (. hit y)))
    (+= waves (call RerouteWave (. hit index) origin clock (. hit route-ids)))
    (while (> (. waves length) max-waves)
      (call (. waves remove) 0)
    )
  )
  (fn-do + prune _
    (param clock F64)
    (let idx 0)
    (while (< idx (. waves length))
      (if (> (- clock (. ([] waves idx) born)) wave-lifetime)
        (call (. waves remove) idx)
        (else
          (+= idx 1)
        )
      )
    )
  )
  (fn-do + route-boost F64
    (param route-id Int)
    (param clock F64)
    (let boost 0.0)
    (for (in wave waves)
      (let age (- clock (. wave born)))
      (if (and (>= age 0) (< age wave-lifetime))
        (for (in id (. wave route-ids))
          (if (== id route-id)
            (let fade (- 1.0 (/ age wave-lifetime)))
            (= boost (call max boost fade))
          )
        )
      )
    )
    (return boost)
  )
)

(fn-do _ build-orbital-segments (list CubicSeg)
  (param cx F64)
  (param cy F64)
  (param rx F64)
  (param ry F64)
  (param seg-count Int)
  (param seed Int)
  (let segs (call (of List CubicSeg)))
  (let step (/ (* 2 π) (as seg-count F64)))
  (let k (* (/ 4.0 3.0) (call tan (/ step 4.0))))
  (for (in i (..< 0 seg-count))
    (let a0 (* (as i F64) step))
    (let a1 (* (as (+ i 1) F64) step))
    (let w0 (+ 1.0 (* 0.14 (call sin (+ (* a0 3.0) (as seed F64))))))
    (let w1 (+ 1.0 (* 0.14 (call sin (+ (* a1 3.0) (as seed F64))))))
    (let x0 (+ cx (* (call cos a0) rx w0)))
    (let y0 (+ cy (* (call sin a0) ry w0)))
    (let x3 (+ cx (* (call cos a1) rx w1)))
    (let y3 (+ cy (* (call sin a1) ry w1)))
    (let c1x (- x0 (* (call sin a0) rx w0 k)))
    (let c1y (+ y0 (* (call cos a0) ry w0 k)))
    (let c2x (+ x3 (* (call sin a1) rx w1 k)))
    (let c2y (- y3 (* (call cos a1) ry w1 k)))
    (+= segs (call make-cubic x0 y0 c1x c1y c2x c2y x3 y3))
  )
  (return segs)
)

(fn-do _ build-diagonal-trunk (list CubicSeg)
  (param map-w F64)
  (param map-h F64)
  (param index Int)
  (param total Int)
  (param angular Bool)
  (let angle (+ (* (/ (as index F64) (as (call max 1 total) F64)) π) (* (- (call hash-unit (+ (* index 31) 7)) 0.5) 0.14)))
  (let dir-x (call cos angle))
  (let dir-y (call sin angle))
  (let perp-x (- dir-y))
  (let perp-y dir-x)
  (let span (* (call sqrt (+ (* map-w map-w) (* map-h map-h))) 0.88))
  (let lateral (* (- (call hash-unit (+ (* index 59) 13)) 0.5) (call min map-w map-h) 0.54))
  (let center-x (+ (* map-w 0.5) (* perp-x lateral)))
  (let center-y (+ (* map-h 0.5) (* perp-y lateral)))
  (let steps (+ 6 (% index 4)))
  (let pad 64.0)
  (let xs (call (of List F64)))
  (let ys (call (of List F64)))
  (for (in s (.. 0 steps))
    (let u (/ (as s F64) (as steps F64)))
    (let along (- u 0.5))
    (let bend (* (call sin (+ (* u 2 π (+ 0.85 (* 0.35 (as (% index 3) F64)))) (as index F64))) (call min map-w map-h) 0.085))
    (let jog (if-expr angular (* (- (call hash-unit (+ (* index 17) (* s 23))) 0.5) 140.0) 0.0))
    (let px (call clamp (+ center-x (* dir-x span along) (* perp-x (+ bend jog))) pad (- map-w pad)))
    (let py (call clamp (+ center-y (* dir-y span along) (* perp-y (+ bend jog))) pad (- map-h pad)))
    (+= xs px)
    (+= ys py)
  )
  (return (call catmull-rom-cubics xs ys (if-expr angular 0.35 1.0)))
)

(fn-do _ catmull-rom-cubics (list CubicSeg)
  (param xs (list F64))
  (param ys (list F64))
  (param smoothness F64)
  (let segs (call (of List CubicSeg)))
  (let count (. xs length))
  (return-if segs (if (< count 2)))
  (let tension (/ smoothness 6.0))
  (for (in i (..< 0 (- count 1)))
    (let i0 (call max 0 (- i 1)))
    (let i3 (call min (- count 1) (+ i 2)))
    (let x0 ([] xs i))
    (let y0 ([] ys i))
    (let x3 ([] xs (+ i 1)))
    (let y3 ([] ys (+ i 1)))
    (let c1x (+ x0 (* (- x3 ([] xs i0)) tension)))
    (let c1y (+ y0 (* (- y3 ([] ys i0)) tension)))
    (let c2x (- x3 (* (- ([] xs i3) x0) tension)))
    (let c2y (- y3 (* (- ([] ys i3) y0) tension)))
    (+= segs (call make-cubic x0 y0 c1x c1y c2x c2y x3 y3))
  )
  (return segs)
)

(fn-do _ build-branch-spur (list CubicSeg)
  (param map-w F64)
  (param map-h F64)
  (param index Int)
  (let segs (call (of List CubicSeg)))
  (let x0 (+ 240.0 (* (call hash-unit (+ (* index 41) 3)) (- map-w 480.0))))
  (let y0 (+ 240.0 (* (call hash-unit (+ (* index 67) 17)) (- map-h 480.0))))
  (let theta (* (call hash-unit (+ (* index 89) 29)) 2 π))
  (let length (+ 520.0 (* 920.0 (call hash-unit (+ (* index 103) 41)))))
  (let steps 3)
  (let prev-x x0)
  (let prev-y y0)
  (for (in s (..< 0 steps))
    (let turn (* (- (call hash-unit (+ (* index 23) (* s 37))) 0.5) 1.25))
    (let a (+ theta (* (as s F64) 0.35) turn))
    (let seg-l (/ length (as steps F64)))
    (let next-x (call clamp (+ prev-x (* (call cos a) seg-l)) 100.0 (- map-w 100.0)))
    (let next-y (call clamp (+ prev-y (* (call sin a) seg-l)) 100.0 (- map-h 100.0)))
    (let px (- (call sin a)))
    (let py (call cos a))
    (let curve-bow (* (- (call hash-unit (+ (* index 53) (* s 19))) 0.5) seg-l 0.65))
    (let c1x (+ prev-x (* (- next-x prev-x) 0.33) (* px curve-bow)))
    (let c1y (+ prev-y (* (- next-y prev-y) 0.33) (* py curve-bow)))
    (let c2x (+ prev-x (* (- next-x prev-x) 0.67) (* px curve-bow)))
    (let c2y (+ prev-y (* (- next-y prev-y) 0.67) (* py curve-bow)))
    (+= segs (call make-cubic prev-x prev-y c1x c1y c2x c2y next-x next-y))
    (= prev-x next-x)
    (= prev-y next-y)
  )
  (return segs)
)

(fn-do _ append-unique _
  (param items (list Int))
  (param value Int)
  (for (in item items)
    (return-if (if (== item value)))
  )
  (+= items value)
)

(fn-expr _ item-is-animated Bool
  (param index Int)
  (param share Int)
  (if-expr (<= share 0)
    false
    (if-expr (>= share 100)
      true
      (< (% (* index 37) 100) share)
    )
  )
)

(fn-expr + hash-unit F64
  (param seed Int)
  (- value (call floor value))
  (where
    (lazy value (* (call sin (* (as seed F64) 12.9898)) 43758.5453))
  )
)

(fn-expr _ seg-dist F64
  (param dx F64)
  (param dy F64)
  (call sqrt (+ (* dx dx) (* dy dy)))
)

(fn-do + make-cubic CubicSeg
  (param x0 F64)
  (param y0 F64)
  (param c1x F64)
  (param c1y F64)
  (param c2x F64)
  (param c2y F64)
  (param x3 F64)
  (param y3 F64)
  (let chord (call seg-dist (- x3 x0) (- y3 y0)))
  (let poly (+ (call seg-dist (- c1x x0) (- c1y y0)) (call seg-dist (- c2x c1x) (- c2y c1y)) (call seg-dist (- x3 c2x) (- y3 c2y))))
  (let approx (call max 1.0 (* 0.5 (+ chord poly))))
  (return (call CubicSeg x0 y0 c1x c1y c2x c2y x3 y3 approx))
)

(fn-expr + eval-seg Point
  (param seg CubicSeg)
  (param t F64)
  (call Point (+ (* u3 (. seg x0)) (* 3 u2 t (. seg c1x)) (* 3 u t2 (. seg c2x)) (* t3 (. seg x3))) (+ (* u3 (. seg y0)) (* 3 u2 t (. seg c1y)) (* 3 u t2 (. seg c2y)) (* t3 (. seg y3))))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy u3 (* u2 u))
    (lazy t2 (* t t))
    (lazy t3 (* t2 t))
  )
)

(fn-expr + tangent-seg Point
  (param seg CubicSeg)
  (param t F64)
  (call Point (+ (* 3 u2 (- (. seg c1x) (. seg x0))) (* 6 u t (- (. seg c2x) (. seg c1x))) (* 3 t2 (- (. seg x3) (. seg c2x)))) (+ (* 3 u2 (- (. seg c1y) (. seg y0))) (* 6 u t (- (. seg c2y) (. seg c1y))) (* 3 t2 (- (. seg y3) (. seg c2y)))))
  (where
    (lazy u (- 1.0 t))
    (lazy u2 (* u u))
    (lazy t2 (* t t))
  )
)

(fn-do + slice-seg CubicSeg
  (param seg CubicSeg)
  (param t0 F64)
  (param t1 F64)
  (let a (call clamp t0 0.0 1.0))
  (let b (call clamp t1 0.0 1.0))
  (let right (call split-right seg a))
  (let denom (call max 1e-6 (- 1.0 a)))
  (let rel (call clamp (/ (- b a) denom) 0.0 1.0))
  (return (call split-left right rel))
)

(fn-do _ split-right CubicSeg
  (param seg CubicSeg)
  (param t F64)
  (let p01x (+ (. seg x0) (* (- (. seg c1x) (. seg x0)) t)))
  (let p01y (+ (. seg y0) (* (- (. seg c1y) (. seg y0)) t)))
  (let p12x (+ (. seg c1x) (* (- (. seg c2x) (. seg c1x)) t)))
  (let p12y (+ (. seg c1y) (* (- (. seg c2y) (. seg c1y)) t)))
  (let p23x (+ (. seg c2x) (* (- (. seg x3) (. seg c2x)) t)))
  (let p23y (+ (. seg c2y) (* (- (. seg y3) (. seg c2y)) t)))
  (let p012x (+ p01x (* (- p12x p01x) t)))
  (let p012y (+ p01y (* (- p12y p01y) t)))
  (let p123x (+ p12x (* (- p23x p12x) t)))
  (let p123y (+ p12y (* (- p23y p12y) t)))
  (let midx (+ p012x (* (- p123x p012x) t)))
  (let midy (+ p012y (* (- p123y p012y) t)))
  (return (call make-cubic midx midy p123x p123y p23x p23y (. seg x3) (. seg y3)))
)

(fn-do _ split-left CubicSeg
  (param seg CubicSeg)
  (param t F64)
  (let p01x (+ (. seg x0) (* (- (. seg c1x) (. seg x0)) t)))
  (let p01y (+ (. seg y0) (* (- (. seg c1y) (. seg y0)) t)))
  (let p12x (+ (. seg c1x) (* (- (. seg c2x) (. seg c1x)) t)))
  (let p12y (+ (. seg c1y) (* (- (. seg c2y) (. seg c1y)) t)))
  (let p23x (+ (. seg c2x) (* (- (. seg x3) (. seg c2x)) t)))
  (let p23y (+ (. seg c2y) (* (- (. seg y3) (. seg c2y)) t)))
  (let p012x (+ p01x (* (- p12x p01x) t)))
  (let p012y (+ p01y (* (- p12y p01y) t)))
  (let p123x (+ p12x (* (- p23x p12x) t)))
  (let p123y (+ p12y (* (- p23y p12y) t)))
  (let midx (+ p012x (* (- p123x p012x) t)))
  (let midy (+ p012y (* (- p123y p012y) t)))
  (return (call make-cubic (. seg x0) (. seg y0) p01x p01y p012x p012y midx midy))
)

(fn-expr + wave-front-radius F64
  (param age F64)
