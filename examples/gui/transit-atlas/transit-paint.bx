      (call VectorGeometrySpan body body-fill rim-stroke 3.4 (. LineCap round) (. LineJoin round) (. FillRule nonzero))
      (call VectorGeometrySpan cabin accent-fill none-paint null null null (. FillRule nonzero))
    )
  )
  (return (call VectorGeometry (call Rect -86 -26 180 52) (call Rect -92 -32 192 64) spans false false))
)

(fn-do _ ferry-hull-geometry VectorGeometry
  (let hull (call Path))
  (call (. hull move-to) -46 -16)
  (call (. hull cubic-curve-to) 0 -22 36 -14 58 0)
  (call (. hull cubic-curve-to) 36 14 0 22 -46 16)
  (call (. hull cubic-curve-to) -56 8 -56 -8 -46 -16)
  (call (. hull close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let stroke-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (return (call VectorGeometry (call Rect -60 -26 124 52) (call Rect -66 -32 136 64) (list (call VectorGeometrySpan hull fill-paint stroke-paint 3.0 (. LineCap round) (. LineJoin round) (. FillRule nonzero))) false false))
)
