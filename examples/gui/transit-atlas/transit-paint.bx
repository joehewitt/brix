  (call (. body close))
  (let cabin (call Path))
  (call (. cabin move-to) 28 -11)
  (call (. cabin cubic-curve-to) 58 -11 70 -4 72 0)
  (call (. cabin cubic-curve-to) 70 4 58 11 28 11)
  (call (. cabin close))
  (let body-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (let accent-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let rim-stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let spans
