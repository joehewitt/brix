(import ./transit-network)
(import /graphics/appearance)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /math)
(import /units)
(blank)
(prop _ map-land _ (= (call RGBA "#141a24")))
(prop _ map-border _ (= (call RGBA "#29374c")))
(prop _ map-grid-minor _ (= (call RGBA "#1a2230")))
(prop _ map-grid-major _ (= (call RGBA "#202b3c")))
(prop _ water-deep _ (= (call RGBA "#0c1c2e")))
(prop _ water-mid _ (= (call RGBA "#11273f")))
(prop _ water-shore _ (= (call RGBA "#204469")))
(prop _ water-contour _ (= (call RGBA "#1a3857")))
(prop _ rail-bed _ (= (call RGBA "#0b1017")))
(prop _ hub-core _ (= (call RGBA "#f5f8fc")))
(prop _ hub-ring-dark _ (= (call RGBA "#0c1118")))
(prop _ label-ink _ (= (call RGBA "#dce6f5")))
(prop _ label-muted _ (= (call RGBA "#8c9eb8")))
(prop _ cartouche-bg _ (= (call RGBA "#0f151ee0")))
(prop _ district-ink _ (= (call RGBA "#273447")))
(prop _ wave-glow _ (= (call RGBA "#66e8ff")))
(prop _ hub-shadow _ (= (call Shadow (call RGBA "#04070cb0") 8 2 4 0)))
(prop _ park-fills _ (= (list (call RGBA "#152b24") (call RGBA "#183028") (call RGBA "#142622"))))
(prop _ park-rims _ (= (list (call RGBA "#244c3f") (call RGBA "#2a5748") (call RGBA "#214239"))))
(prop _ station-names _
  (=
    (list
      "Central Terminal" "Harbor Quay" "Grand Plaza" "Observatory"
      "Old Town" "Botanical Park" "Union Square" "Bay Bridge"
      "Ironworks" "Northgate" "West Pier" "Eastside"
      "Clocktower" "Civic Center" "Marina" "Highland"
      "Mercer St" "Parkview" "Riverbend" "South Wharf"
      "University" "Foundry" "Cathedral" "Beacon Hill"
    )
  )
)
(prop _ district-names _
  (=
    (list
      "MIDTOWN" "HARBOR BAY" "WESTSIDE" "NORTHGATE"
      "SOUTH WHARF" "PARK DISTRICT" "EAST QUAY" "OLD TOWN"
    )
  )
)

(type + LinePalette (is Tuple)
  (prop + line RGBA)
  (prop + bright RGBA)
  (prop + glow RGBA)
  (prop + bed RGBA)
)

(prop _ transit-palettes _
  (=
    (list
      (call LinePalette (call RGBA "#e5484d") (call RGBA "#ff9194") (call RGBA "#ff6b7099") (call RGBA "#521a1e"))
      (call LinePalette (call RGBA "#3484e6") (call RGBA "#8cc4ff") (call RGBA "#5ca8ff99") (call RGBA "#153254"))
      (call LinePalette (call RGBA "#2ab36b") (call RGBA "#80edb4") (call RGBA "#4cd99099") (call RGBA "#12422a"))
      (call LinePalette (call RGBA "#eba428") (call RGBA "#ffd97d") (call RGBA "#ffc04d99") (call RGBA "#543b10"))
      (call LinePalette (call RGBA "#a855d4") (call RGBA "#dfb0ff") (call RGBA "#c478f099") (call RGBA "#3e1d52"))
      (call LinePalette (call RGBA "#24b5c9") (call RGBA "#87f0fc") (call RGBA "#4cd8e899") (call RGBA "#10454d"))
      (call LinePalette (call RGBA "#eb6c2d") (call RGBA "#ffb285") (call RGBA "#ff8a5299") (call RGBA "#542611"))
      (call LinePalette (call RGBA "#d6498e") (call RGBA "#ff9ccc") (call RGBA "#f274b199") (call RGBA "#4d1b34"))
      (call LinePalette (call RGBA "#84bf2e") (call RGBA "#c9f57f") (call RGBA "#a3db4f99") (call RGBA "#2f4510"))
      (call LinePalette (call RGBA "#576ce6") (call RGBA "#a6b3ff") (call RGBA "#7d8eff99") (call RGBA "#1e2654"))
      (call LinePalette (call RGBA "#d4ba31") (call RGBA "#fff294") (call RGBA "#f0d95999") (call RGBA "#4a4212"))
      (call LinePalette (call RGBA "#32bf9c") (call RGBA "#8ef5dc") (call RGBA "#59dbb899") (call RGBA "#124539"))
    )
  )
)

(type + TransitKit
  (prop + palettes (list LinePalette))
  (prop + train-palettes (list (list RGBA)))
  (prop + ferry-palettes (list (list RGBA)))
  (prop + station-labels (list TextLayout))
  (prop + district-labels (list TextLayout))
  (prop + atlas-title TextLayout)
  (prop + atlas-sub TextLayout)
  (prop + train-car VectorGeometryHandle)
  (prop + express-train VectorGeometryHandle)
  (prop + ferry-hull VectorGeometryHandle)
  (fn-do + This _
    (param table VectorGeometryTable)
    (for (in entry transit-palettes)
      (+= palettes entry)
      (+= train-palettes (list (. entry bright) hub-core (. entry line)))
      (+= ferry-palettes (list (. entry bright) water-shore))
    )
    (let st-font (call Font "Helvetica" 14 (. FontWeight semibold)))
    (for (in name station-names)
      (+= station-labels (call TextLayout name st-font 180))
    )
    (let dist-font (call Font "Helvetica" 40 (. FontWeight bold)))
    (for (in name district-names)
      (+= district-labels (call TextLayout name dist-font 440))
    )
    (= atlas-title (call TextLayout "METROPOLITAN TRANSIT ATLAS" (call Font "Helvetica" 26 (. FontWeight bold)) 560))
    (= atlas-sub (call TextLayout "RAPID RAIL · ORBITAL RINGS · HARBOR FERRIES" (call Font "Helvetica" 13 (. FontWeight semibold)) 560))
    (= train-car (call (. table intern-geometry) (as 951201 U64) (=> () (call train-car-geometry))))
    (= express-train (call (. table intern-geometry) (as 951202 U64) (=> () (call express-train-geometry))))
    (= ferry-hull (call (. table intern-geometry) (as 951203 U64) (=> () (call ferry-hull-geometry))))
  )
)

(type _ Tally
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + dashed Int)
  (fn-do + record _
    (param segs Int)
    (param stroked Bool)
    (param is-dashed Bool (= false))
    (+= paths 1)
    (+= segments segs)
    (if stroked
      (+= strokes 1)
    )
    (if is-dashed
      (+= dashed 1)
    )
  )
  (fn-expr + snapshot SceneCounts :get
    (call SceneCounts paths segments strokes dashed)
  )
)

(fn-do + paint-transit-layer SceneCounts
  (param kit TransitKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param clock F64)
  (param waves WaveField)
  (param motion MotionMode)
  (param tier PaintTier)
  (param include-static Bool)
  (param include-dynamic Bool)
  (let tally (call Tally))
  (if include-static
    (call paint-base-map kit table canvas network motion tier tally)
  )
  (if include-dynamic
    (call paint-live-overlays kit table canvas network clock waves motion tier tally)
  )
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-dash) 0)
  (= (. canvas blend-mode) (. BlendMode normal))
  (return (. tally snapshot))
)

(fn-do _ paint-base-map _
  (param kit TransitKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param motion MotionMode)
  (param tier PaintTier)
  (param tally Tally)
  (let extent (. network extent))
  (let rect (call Rect 28 28 (- (. extent width) 56) (- (. extent height) 56)))
  (= (. canvas fill-color) map-land)
  (= (. canvas stroke-color) map-border)
  (= (. canvas stroke-width) 2.5)
  (call (. canvas outline) (call Outline rect 16))
  (call (. tally record) 8 true)
  (call paint-city-grid canvas extent tally)
  (call paint-parks canvas network tier tally)
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) (call Outline rect 16))
    (call paint-water-geography canvas network tier tally)
  )
  (call paint-districts kit canvas network)
  (call paint-routes kit canvas network tier tally)
  (call paint-static-hubs kit canvas network tier tally)
  (call paint-title-cartouche kit canvas)
  (let has-effects (. tier has-effects))
  (for (in vehicle (. network vehicles))
    (if (not (. vehicle is-animated))
      (let route ([] (. network routes) (. vehicle route-index)))
      (if (== motion (. MotionMode transforms))
        (call paint-vehicle-instanced kit table canvas route vehicle (. vehicle offset) has-effects tally)
        (else
          (call paint-vehicle-deformed kit canvas route vehicle (. vehicle offset) has-effects tally)
        )
      )
    )
  )
)

(fn-do _ paint-city-grid _
  (param canvas Canvas)
  (param extent Dimensions)
  (param tally Tally)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-cap) (. LineCap butt))
  (= (. canvas stroke-dash) 0)
  (let minor 160.0)
  (let x 160.0)
  (let col 1)
  (while (< x (- (. extent width) 40))
    (let major (== (% col 4) 0))
    (= (. canvas stroke-color) (if-expr major map-grid-major map-grid-minor))
    (= (. canvas stroke-width) (if-expr major 1.4 0.8))
    (call (. canvas line) x 36 x (- (. extent height) 36))
    (call (. tally record) 1 true)
    (+= x minor)
    (+= col 1)
  )
  (let y 160.0)
  (let row 1)
  (while (< y (- (. extent height) 40))
    (let major (== (% row 4) 0))
    (= (. canvas stroke-color) (if-expr major map-grid-major map-grid-minor))
    (= (. canvas stroke-width) (if-expr major 1.4 0.8))
    (call (. canvas line) 36 y (- (. extent width) 36) y)
    (call (. tally record) 1 true)
    (+= y minor)
    (+= row 1)
  )
)

(fn-do _ paint-parks _
  (param canvas Canvas)
  (param network TransitNetwork)
  (param tier PaintTier)
  (param tally Tally)
  (let has-aligned (. tier has-aligned))
  (for (in park (. network parks))
    (= (. canvas fill-color) ([] park-fills (. park tone)))
    (= (. canvas stroke-color) (only-if ([] park-rims (. park tone)) (if (not has-aligned))))
    (= (. canvas stroke-width) 1.8)
    (= (. canvas stroke-join) (. LineJoin round))
    (call (. park path outline) canvas)
    (call (. tally record) 8 (not has-aligned))
    (if has-aligned
      (= (. canvas stroke-color) ([] park-rims (. park tone)))
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-join) (. LineJoin round))
      (call paint-aligned-stroke canvas (. park path) (. FillRule nonzero) (. StrokeAlignment inside) 4.0)
      (call (. tally record) 8 true)
    )
  )
)

(fn-do _ paint-water-geography _
  (param canvas Canvas)
  (param network TransitNetwork)
  (param tier PaintTier)
  (param tally Tally)
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-join) (. LineJoin round))
  (= (. canvas stroke-dash) 0)
  (= (. canvas fill-color) water-mid)
  (= (. canvas stroke-color) water-shore)
  (= (. canvas stroke-width) 3.0)
  (call (. (. network bay-path) outline) canvas)
  (call (. tally record) 4 true)
  (= (. canvas fill-color) water-deep)
  (= (. canvas stroke-color) water-contour)
  (= (. canvas stroke-width) 1.5)
  (call (. (. network shelf-path) outline) canvas)
  (call (. tally record) 4 true)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-cap) (. LineCap butt))
  (for (in water (. network waterways))
    (let segs (. water segments))
    (= (. canvas stroke-color) water-shore)
    (= (. canvas stroke-width) (+ (. water width) 8.0))
    (call trace-segments canvas segs false)
    (call (. tally record) (. segs length) true)
    (= (. canvas stroke-color) water-mid)
    (= (. canvas stroke-width) (. water width))
    (call trace-segments canvas segs false)
    (call (. tally record) (. segs length) true)
    (= (. canvas stroke-color) water-deep)
    (= (. canvas stroke-width) (* (. water width) 0.56))
    (call trace-segments canvas segs false)
    (call (. tally record) (. segs length) true)
  )
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas fill-color) map-land)
  (= (. canvas stroke-color) water-shore)
  (= (. canvas stroke-width) 2.8)
  (call (. (. network island-path) outline) canvas)
  (call (. tally record) 3 true)
)

(fn-do _ paint-districts _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (= (. canvas text-color) district-ink)
  (for (in dist (. network districts))
    (let label ([] (. kit district-labels) (% (. dist name-index) (. (. kit district-labels) length))))
    (call (. canvas draw-text) label (call Rect (- (. dist x) 220) (- (. dist y) 22) 440 48) (. TextAlignment center))
  )
)

(fn-do _ paint-title-cartouche _
  (param kit TransitKit)
  (param canvas Canvas)
  (let box (call Rect 72 72 548 84))
  (= (. canvas fill-color) cartouche-bg)
  (= (. canvas stroke-color) map-border)
  (= (. canvas stroke-width) 1.5)
  (call (. canvas outline) (call Outline box 10))
  (= (. canvas text-color) label-ink)
  (call (. canvas draw-text) (. kit atlas-title) (call Rect 94 86 508 32))
  (= (. canvas text-color) label-muted)
  (call (. canvas draw-text) (. kit atlas-sub) (call Rect 94 122 508 20))
)

(fn-do _ paint-routes _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param tier PaintTier)
  (param tally Tally)
  (let has-dashes (. tier has-dashes))
  (let has-aligned (. tier has-aligned))
  (= (. canvas fill-color) null)
  (for (in route (. network routes))
    (let palette ([] (. kit palettes) (. route palette)))
    (let seg-count (. route segments length))
    (= (. canvas stroke-cap) (if-expr (. route uses-miter) (. LineCap square) (. LineCap round)))
    (= (. canvas stroke-join) (if-expr (. route uses-miter) (. LineJoin miter) (. LineJoin round)))
    (= (. canvas stroke-dash) 0)
    (if (== (. route kind) (. RouteKind ferry))
      (if has-dashes
        (= (. canvas stroke-color) (. palette bright))
        (= (. canvas stroke-width) (. route width))
        (= (. canvas stroke-dash) (. route dash-length))
        (call trace-segments canvas (. route segments) false)
        (= (. canvas stroke-dash) 0)
        (call (. tally record) seg-count true true)
        (else
          (= (. canvas stroke-color) (. palette line))
          (= (. canvas stroke-width) 2.5)
          (call trace-segments canvas (. route segments) false)
          (call (. tally record) seg-count true)
        )
      )
      (else-if (and (. route is-closed) has-aligned)
        (= (. canvas stroke-color) rail-bed)
        (= (. canvas stroke-width) (+ (. route width) 12.0))
        (call (. route path outline) canvas)
        (call (. tally record) seg-count true)
        (= (. canvas stroke-color) (. palette line))
        (call paint-aligned-stroke canvas (. route path) (. FillRule nonzero) (. StrokeAlignment outside) 3.6)
        (call (. tally record) seg-count true)
        (= (. canvas stroke-color) (. palette bright))
        (call paint-aligned-stroke canvas (. route path) (. FillRule nonzero) (. StrokeAlignment inside) 3.0)
        (call (. tally record) seg-count true)
      )
      (else
        (= (. canvas stroke-color) rail-bed)
        (= (. canvas stroke-width) (+ (. route width) 5.0))
        (call trace-segments canvas (. route segments) (. route is-closed))
        (call (. tally record) seg-count true)
        (= (. canvas stroke-color) (. palette line))
        (= (. canvas stroke-width) (. route width))
        (call trace-segments canvas (. route segments) (. route is-closed))
        (call (. tally record) seg-count true)
        (if (and has-dashes (> (. route dash-length) 0))
          (= (. canvas stroke-color) (. palette bright))
          (= (. canvas stroke-width) (call max 2.0 (* (. route width) 0.4)))
          (= (. canvas stroke-dash) (. route dash-length))
          (call trace-segments canvas (. route segments) (. route is-closed))
          (= (. canvas stroke-dash) 0)
          (call (. tally record) seg-count true true)
        )
      )
    )
  )
)

(fn-do _ paint-static-hubs _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param tier PaintTier)
  (param tally Tally)
  (let has-effects (. tier has-effects))
  (= (. canvas stroke-dash) 0)
  (for (in hub (. network hubs))
    (let palette ([] (. kit palettes) (. hub palette)))
    (let r (. hub radius))
    (if (. hub is-capsule)
      (let cw (. hub capsule-w))
      (let ch (. hub capsule-h))
      (let pill (call Rect (- (. hub x) (* cw 0.5)) (- (. hub y) (* ch 0.5)) cw ch))
      (if has-effects
        (call (. canvas begin))
        (call (. canvas outline-path) (call Outline pill (* ch 0.5)))
        (call (. canvas shadow-path) hub-shadow)
        (call (. tally record) 8 false)
      )
      (= (. canvas fill-color) hub-core)
      (= (. canvas stroke-color) hub-ring-dark)
      (= (. canvas stroke-width) 4.0)
      (call (. canvas outline) (call Outline pill (* ch 0.5)))
      (call (. tally record) 8 true)
      (let pips (call min 4 (. hub route-ids length)))
      (for (in p (..< 0 pips))
        (let frac (if-expr (== pips 1) 0.0 (- (/ (as p F64) (as (- pips 1) F64)) 0.5)))
        (let px (+ (. hub x) (* frac (- cw ch))))
        (let route-id ([] (. hub route-ids) p))
        (let p-col (if-expr (< route-id (. network routes length)) (. ([] (. kit palettes) (. ([] (. network routes) route-id) palette)) line) (. palette line)))
        (= (. canvas fill-color) p-col)
        (= (. canvas stroke-color) null)
        (call (. canvas circle) px (. hub y) (* ch 0.24))
        (call (. tally record) 4 false)
      )
      (let label ([] (. kit station-labels) (% (. hub name-index) (. (. kit station-labels) length))))
      (let lx (+ (. hub x) (* cw 0.5) 10))
      (let ly (- (. hub y) 11))
      (let tag (call Rect (- lx 6) (- ly 2) (+ (. label width) 12) 22))
      (= (. canvas fill-color) cartouche-bg)
      (= (. canvas stroke-color) map-border)
      (= (. canvas stroke-width) 1.0)
      (call (. canvas outline) (call Outline tag 5))
      (= (. canvas text-color) label-ink)
      (call (. canvas draw-text) label (call Rect lx (+ ly 1) 180 20))
      (else
        (= (. canvas fill-color) hub-core)
        (= (. canvas stroke-color) (. palette line))
        (= (. canvas stroke-width) (if-expr (. hub is-major) 3.8 2.6))
        (call (. canvas circle) (. hub x) (. hub y) r)
        (call (. tally record) 4 true)
        (if (. hub is-major)
          (= (. canvas fill-color) hub-ring-dark)
          (= (. canvas stroke-color) null)
          (call (. canvas circle) (. hub x) (. hub y) (* r 0.36))
          (call (. tally record) 4 false)
        )
      )
    )
  )
)

(fn-do _ paint-live-overlays _
  (param kit TransitKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param clock F64)
  (param waves WaveField)
  (param motion MotionMode)
  (param tier PaintTier)
  (param tally Tally)
  (let has-dashes (. tier has-dashes))
  (let has-effects (. tier has-effects))
  (if (and (> (. network animated-share) 0) has-dashes)
    (call paint-express-signals kit canvas network clock waves has-effects tally)
  )
  (if (> (. network animated-share) 0)
    (call paint-hub-pulses kit canvas network clock waves has-effects tally)
  )
  (call paint-reroute-waves kit canvas network clock waves has-effects tally)
  (for (in vehicle (. network vehicles))
    (if (. vehicle is-animated)
      (let route ([] (. network routes) (. vehicle route-index)))
      (let boost (call (. waves route-boost) (. route index) clock))
      (let travel (* clock (. vehicle speed) (+ 1.0 (* boost 1.4)) (. vehicle direction)))
      (let dist (+ (. vehicle offset) travel))
      (if (== motion (. MotionMode transforms))
        (call paint-vehicle-instanced kit table canvas route vehicle dist has-effects tally)
        (else
          (call paint-vehicle-deformed kit canvas route vehicle dist has-effects tally)
        )
      )
    )
  )
)

(fn-do _ paint-express-signals _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param clock F64)
  (param waves WaveField)
  (param has-effects Bool)
  (param tally Tally)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-join) (. LineJoin round))
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode screen))
  )
  (for (in route (. network routes))
    (let boost (call (. waves route-boost) (. route index) clock))
    (if (or (== (. route kind) (. RouteKind express)) (> boost 0.01))
      (let palette ([] (. kit palettes) (. route palette)))
      (let seg-count (. route segments length))
      (let speed (if-expr (> boost 0.01) 0.55 0.22))
      (let head (% (+ (* clock speed) (* (as (. route index) F64) 0.19)) 1.0))
      (let seg-pos (* head (as seg-count F64)))
      (let seg-idx (% (as (call floor seg-pos) Int) seg-count))
      (let local-t (- seg-pos (call floor seg-pos)))
      (let seg ([] (. route segments) seg-idx))
      (let span (if-expr (> boost 0.01) 0.72 0.48))
      (let t0 (call max 0.0 (- local-t span)))
      (let t1 (call min 1.0 (+ local-t 0.05)))
      (if (> (- t1 t0) 0.02)
        (let arc (call slice-seg seg t0 t1))
        (= (. canvas stroke-color) (if-expr (> boost 0.01) wave-glow (. palette bright)))
        (= (. canvas stroke-width) (if-expr (> boost 0.01) 4.8 3.2))
        (= (. canvas stroke-dash) (if-expr (> boost 0.01) 20.0 14.0))
        (call (. canvas begin))
        (call (. canvas move) (. arc x0) (. arc y0))
        (call (. canvas curve) (. arc c1x) (. arc c1y) (. arc c2x) (. arc c2y) (. arc x3) (. arc y3))
        (call (. canvas end))
        (call (. tally record) 1 true true)
      )
    )
  )
  (= (. canvas stroke-dash) 0)
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode normal))
  )
)

(fn-do _ paint-hub-pulses _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param clock F64)
  (param waves WaveField)
  (param has-effects Bool)
  (param tally Tally)
  (let share (. network animated-share))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-dash) 0)
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode screen))
  )
  (for (in hub (. network hubs))
    (let active (and (. hub is-capsule) (or (>= share 50) (== (% (. hub index) 2) 0))))
    (if active
      (let palette ([] (. kit palettes) (. hub palette)))
      (let cycle (% (+ (* clock 0.5) (/ (. hub phase) (* 2 π))) 1.0))
      (let ring-r (+ (* (. hub capsule-w) 0.4) (* cycle 34.0)))
      (let fade (* (- 1.0 cycle) 0.7))
      (= (. canvas stroke-color) (call (. (. palette bright) with-alpha) fade))
      (= (. canvas stroke-width) (+ 1.4 (* (- 1.0 cycle) 1.8)))
      (call (. canvas circle) (. hub x) (. hub y) ring-r)
      (call (. tally record) 4 true)
      (if has-effects
        (let ring2 (% (+ cycle 0.5) 1.0))
        (= (. canvas stroke-color) (call (. (. palette line) with-alpha) (* (- 1.0 ring2) 0.55)))
        (= (. canvas stroke-width) 1.4)
        (call (. canvas circle) (. hub x) (. hub y) (+ (* (. hub capsule-w) 0.4) (* ring2 34.0)))
        (call (. tally record) 4 true)
      )
    )
  )
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode normal))
  )
)

(fn-do _ paint-reroute-waves _
  (param kit TransitKit)
  (param canvas Canvas)
  (param network TransitNetwork)
  (param clock F64)
  (param waves WaveField)
  (param has-effects Bool)
  (param tally Tally)
  (return-if (if (== (. waves waves length) 0)))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-cap) (. LineCap round))
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode screen))
  )
  (for (in wave (. waves waves))
    (let age (- clock (. wave born)))
    (if (and (>= age 0) (< age wave-life))
      (let fade (- 1.0 (/ age wave-life)))
      (let radius (call wave-front-radius age))
      (= (. canvas stroke-color) (call (. wave-glow with-alpha) (* fade 0.8)))
      (= (. canvas stroke-width) (+ 2.5 (* fade 4.0)))
      (= (. canvas stroke-dash) 24.0)
      (call (. canvas circle) (. wave origin x) (. wave origin y) radius)
      (call (. tally record) 4 true true)
      (= (. canvas stroke-dash) 0)
      (for (in route-id (. wave route-ids))
        (if (< route-id (. network routes length))
          (let route ([] (. network routes) route-id))
          (= (. canvas stroke-color) (call (. wave-glow with-alpha) (* fade 0.78)))
          (= (. canvas stroke-width) (+ (. route width) 3.5))
          (= (. canvas stroke-dash) 28.0)
          (call trace-segments canvas (. route segments) (. route is-closed))
          (call (. tally record) (. route segments length) true true)
        )
      )
    )
  )
  (= (. canvas stroke-dash) 0)
  (if has-effects
    (= (. canvas blend-mode) (. BlendMode normal))
  )
)

(fn-do _ paint-vehicle-instanced _
  (param kit TransitKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param route TransitRoute)
  (param vehicle Vehicle)
  (param dist F64)
  (param has-effects Bool)
  (param tally Tally)
  (let pose (call (. route sample-at) dist))
  (let angle (if-expr (> (. vehicle direction) 0) (. pose heading) (+ (. pose heading) π)))
  (let scale (if-expr (. vehicle is-ferry) 0.3 (if-expr (. vehicle is-express) 0.4 0.33)))
  (let m (call stamp-matrix (. pose x) (. pose y) angle scale scale))
  (if (. vehicle is-ferry)
    (let ignored (call (. table paint-vector) (. kit ferry-hull) canvas ([] (. kit ferry-palettes) (. route palette)) m))
    (call (. tally record) 4 false)
    (else
      (let shape (if-expr (. vehicle is-express) (. kit express-train) (. kit train-car)))
      (let ignored (call (. table paint-vector) shape canvas ([] (. kit train-palettes) (. route palette)) m))
      (call (. tally record) 4 false)
      (if has-effects
        (let palette ([] (. kit palettes) (. route palette)))
        (= (. canvas blend-mode) (. BlendMode screen))
        (= (. canvas fill-color) (. palette glow))
        (= (. canvas stroke-color) null)
        (call (. canvas circle) (. pose x) (. pose y) (* scale 42.0))
        (= (. canvas blend-mode) (. BlendMode normal))
        (call (. tally record) 4 false)
      )
    )
  )
)

(fn-do _ paint-vehicle-deformed _
  (param kit TransitKit)
  (param canvas Canvas)
  (param route TransitRoute)
  (param vehicle Vehicle)
  (param dist F64)
  (param has-effects Bool)
  (param tally Tally)
  (let palette ([] (. kit palettes) (. route palette)))
  (let pose (call (. route sample-at) dist))
  (let seg ([] (. route segments) (. pose seg-index)))
  (let train-len (if-expr (. vehicle is-ferry) 38.0 (if-expr (. vehicle is-express) 76.0 54.0)))
  (let dt (/ train-len (call max 1.0 (. seg length))))
  (let t0 (call max 0.0 (- (. pose local-t) (* dt 0.5))))
  (let t1 (call min 1.0 (+ (. pose local-t) (* dt 0.5))))
  (if (> (- t1 t0) 0.008)
    (let arc (call slice-seg seg t0 t1))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-cap) (. LineCap round))
    (= (. canvas stroke-join) (. LineJoin round))
    (= (. canvas stroke-dash) 0)
    (if has-effects
      (= (. canvas blend-mode) (. BlendMode screen))
      (= (. canvas stroke-color) (. palette glow))
      (= (. canvas stroke-width) (if-expr (. vehicle is-express) 16.0 12.0))
      (call (. canvas begin))
      (call (. canvas move) (. arc x0) (. arc y0))
      (call (. canvas curve) (. arc c1x) (. arc c1y) (. arc c2x) (. arc c2y) (. arc x3) (. arc y3))
      (call (. canvas end))
      (= (. canvas blend-mode) (. BlendMode normal))
      (call (. tally record) 1 true)
    )
    (= (. canvas stroke-color) (if-expr (. vehicle is-ferry) (. palette bright) hub-core))
    (= (. canvas stroke-width) (if-expr (. vehicle is-ferry) 7.5 (if-expr (. vehicle is-express) 9.8 7.8)))
    (call (. canvas begin))
    (call (. canvas move) (. arc x0) (. arc y0))
    (call (. canvas curve) (. arc c1x) (. arc c1y) (. arc c2x) (. arc c2y) (. arc x3) (. arc y3))
    (call (. canvas end))
    (call (. tally record) 1 true)
    (= (. canvas stroke-color) (. palette line))
    (= (. canvas stroke-width) (if-expr (. vehicle is-express) 4.8 3.6))
    (call (. canvas begin))
    (call (. canvas move) (. arc x0) (. arc y0))
    (call (. canvas curve) (. arc c1x) (. arc c1y) (. arc c2x) (. arc c2y) (. arc x3) (. arc y3))
    (call (. canvas end))
    (call (. tally record) 1 true)
    (let nose-x (if-expr (> (. vehicle direction) 0) (. arc x3) (. arc x0)))
    (let nose-y (if-expr (> (. vehicle direction) 0) (. arc y3) (. arc y0)))
    (= (. canvas fill-color) hub-core)
    (= (. canvas stroke-color) null)
    (call (. canvas circle) nose-x nose-y (if-expr (. vehicle is-express) 3.8 2.8))
    (call (. tally record) 4 false)
    (else
      (= (. canvas fill-color) hub-core)
      (= (. canvas stroke-color) (. palette line))
      (= (. canvas stroke-width) 2.2)
      (call (. canvas circle) (. pose x) (. pose y) 5.0)
      (call (. tally record) 4 true)
    )
  )
)

(fn-do _ trace-segments _
  (param canvas Canvas)
  (param segs (list CubicSeg))
  (param closed Bool)
  (return-if (if (== (. segs length) 0)))
  (call (. canvas begin))
  (for (in i (..< 0 (. segs length)))
    (let seg ([] segs i))
    (if (== i 0)
      (call (. canvas move) (. seg x0) (. seg y0))
    )
    (call (. canvas curve) (. seg c1x) (. seg c1y) (. seg c2x) (. seg c2y) (. seg x3) (. seg y3))
  )
  (call (. canvas end) closed)
)

(fn-expr _ stamp-matrix Matrix
  (param tx F64)
  (param ty F64)
  (param angle F64)
  (param sx F64)
  (param sy F64)
  (call Matrix (* cosa sx) (* sina sx) (* (- sina) sy) (* cosa sy) tx ty)
  (where
    (lazy cosa (call cos angle))
    (lazy sina (call sin angle))
  )
)

(fn-do _ train-car-geometry VectorGeometry
  (let body (call Path))
  (call (. body move-to) -48 -18)
  (call (. body line-to) 34 -18)
  (call (. body cubic-curve-to) 54 -18 58 -8 58 0)
  (call (. body cubic-curve-to) 58 8 54 18 34 18)
  (call (. body line-to) -48 18)
  (call (. body cubic-curve-to) -58 18 -58 -18 -48 -18)
  (call (. body close))
  (let stripe (call Path))
  (call (. stripe move-to) -38 -6)
  (call (. stripe line-to) 36 -6)
  (call (. stripe line-to) 36 6)
  (call (. stripe line-to) -38 6)
  (call (. stripe close))
  (let body-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (let stripe-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let rim-stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let spans
    (list
      (call VectorGeometrySpan body body-fill rim-stroke 3.2 (. LineCap round) (. LineJoin round) (. FillRule nonzero))
      (call VectorGeometrySpan stripe stripe-fill none-paint null null null (. FillRule nonzero))
    )
  )
  (return (call VectorGeometry (call Rect -64 -24 128 48) (call Rect -70 -30 140 60) spans false false))
)

(fn-do _ express-train-geometry VectorGeometry
  (let body (call Path))
  (call (. body move-to) -68 -19)
  (call (. body line-to) 44 -19)
  (call (. body cubic-curve-to) 72 -19 86 -6 88 0)
  (call (. body cubic-curve-to) 86 6 72 19 44 19)
  (call (. body line-to) -68 19)
  (call (. body cubic-curve-to) -82 19 -82 -19 -68 -19)
  (call (. body close))
  (let cabin (call Path))
  (call (. cabin move-to) 28 -11)
  (call (. cabin cubic-curve-to) 58 -11 70 -4 72 0)
  (call (. cabin cubic-curve-to) 70 4 58 11 28 11)
  (call (. cabin close))
  (let body-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (let accent-fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let rim-stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let none-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let spans
    (list
      (call VectorGeometrySpan body body-fill rim-stroke 3.4 (. LineCap round) (. LineJoin round) (. FillRule nonzero))
      (call VectorGeometrySpan cabin accent-fill none-paint null null null (. FillRule nonzero))
    )
  )
  (return (call VectorGeometry (call Rect -86 -26 180 52) (call Rect -92 -32 192 64) spans false false))
)

(fn-do _ ferry-hull-geometry VectorGeometry
  (let hull (call Path))
  (call (. hull move-to) -46 -16)
  (call (. hull cubic-curve-to) 0 -22 36 -14 58 0)
  (call (. hull cubic-curve-to) 36 14 0 22 -46 16)
  (call (. hull cubic-curve-to) -56 8 -56 -8 -46 -16)
  (call (. hull close))
  (let fill-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let stroke-paint (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (return (call VectorGeometry (call Rect -60 -26 124 52) (call Rect -66 -32 136 64) (list (call VectorGeometrySpan hull fill-paint stroke-paint 3.0 (. LineCap round) (. LineJoin round) (. FillRule nonzero))) false false))
)
