(import ./theme)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/file-browsing)

(type + FileBrowserPanel (is Box)
  (using FileBrowserTheme)
  (prop + files FileTree)
  (prop + session _ (:= (call FileSession)))
  (prop + shows-columns _ (= false))
  (prop + revision Size (= 0))
  (prop + opened _ (= "Nothing opened yet"))
  (prop + selected-name _ (= (?? (?. (. session #current) #name) "No selection")))
  (prop + selected-location _ (= (call file-browser-location #revision (. session #current))))
  (prop + status _ (= (call file-browser-status files #revision)))
  (content
    (<> This (• flex-row)
      (<> KeyShortcut (id: columns-shortcut) (text: "Toggle Column View")
        (= key (call KeyCombo "Cmd+Shift+C"))
        (= stable-key "files.toggle-columns")
        (= repeat false)
        (= action (=> () :do (call toggle-columns)))
      )
      (<> KeyShortcut (id: palette-shortcut) (text: "Go to File")
        (= key (call KeyCombo "Cmd+Shift+P"))
        (= stable-key "files.palette")
        (= repeat false)
        (= action (=> () :do (call (. palette show))))
      )
      (blank)
      (if #shows-columns
        (<> FileColumnTree (• flex 1)
          (= files files)
          (= session session)
        )
        (else
          (<> Sidebar (• w 300)
            (<> SidebarSection (• flex 1) (• pt 10) (• pb 0)
              (= title (. files root path name))
              (blank)
              (<> FileTreeBox (• flex 1)
                (= files files)
                (= session session)
              )
            )
          )
          (blank)
          (<> Box (• flex-col) (• flex 1) (• p 32)
            (<> Label (• content-title)
              (= text #selected-name)
            )
            (<> Label (• content-note)
              (= text #selected-location)
            )
            (<> Label (• content-note)
              (= text (str "Opened: " #opened))
            )
            (<> Label (• content-note)
              (= text #status)
            )
            (<> Label (• content-note)
              (= text (str (. columns-shortcut symbol-label) " switches to columns"))
            )
            (<> Label (• content-note)
              (= text (str (. palette-shortcut symbol-label) " browses by folder"))
            )
          )
        )
      )
      (blank)
      (<> FilePalette (id: palette)
        (= files files)
      )
      (<> Toaster (id: toaster))
    )
  )
  (subscribe-for (on node (. session opened))
    (= opened (str (. node path)))
  )
  (subscribe-for (on item (. palette chosen))
    (let node (call (. files find) (. item path)))
    (if node
      (<- (. session revealed) node)
      (else-if (call (. files contains) (. item path))
        (call (. toaster post) (str (. item name) " is no longer there"))
      )
      (else
        (call (. toaster post) (str (. item name) " is outside " (. files root path name)))
      )
    )
  )
  (subscribe-for (on touched (. files changed))
    (+= revision 1)
  )
  (subscribe-for (on message (. session failed))
    (call (. toaster post) message)
  )
  (fn-do + toggle-columns _
    (= shows-columns (not shows-columns))
  )
)

(fn-expr _ file-browser-location String
  (param revision Size)
  (param node (? FileNode))
  (case? node
    (str (. node path))
  )
  (default
    ""
  )
)

(fn-expr _ file-browser-status String
  (param files FileTree)
  (param revision Size)
  (str (. files loaded-count) " folders loaded · updates: " revision " · " watching)
  (where
    (lazy watching (if-expr (. files is-watching) "watching" "not watching"))
  )
)
