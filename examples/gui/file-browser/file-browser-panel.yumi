./theme
/graphics/primitives
/graphics/text
/gui
/gui/file-browsing

━━━━━━━━━━━━━━━━━━━━
+ FileBrowserPanel is Box
    using FileBrowserTheme

+ files FileTree
+ session := FileSession()
+ shows-columns = false
+ revision Size = 0
+ opened = "Nothing opened yet"
+ selected-name = session.#current?.#name ?? "No selection"
+ selected-location = file-browser-location(#revision, session.#current)
+ status = file-browser-status(files, #revision)

────────────────────

<This • flex-row
    <KeyShortcut columns-shortcut "Toggle Column View"
        key = KeyCombo("Cmd+Shift+C")
        stable-key = "files.toggle-columns"
        repeat = false
        action = => do toggle-columns()
    <KeyShortcut palette-shortcut "Go to File"
        key = KeyCombo("Cmd+Shift+P")
        stable-key = "files.palette"
        repeat = false
        action = => do palette.show()

    if #shows-columns
        <FileColumnTree • flex:1
            files = files
            session = session
    else
        <Sidebar • w:300
            <SidebarSection • flex:1 pt:10 pb:0
                title = files.root.path.name

                <FileTreeBox • flex:1
                    files = files
                    session = session

        <Box • flex-col flex:1 p:32
            <Label • content-title
                text = #selected-name
            <Label • content-note
                text = #selected-location
            <Label • content-note
                text = "Opened: ${#opened}"
            <Label • content-note
                text = #status
            <Label • content-note
                text = "${columns-shortcut.symbol-label} switches to columns"
            <Label • content-note
                text = "${palette-shortcut.symbol-label} browses by folder"

    <FilePalette palette
        files = files
    <Toaster toaster

────────────────────
for node on session.opened

opened = "${node.path}"

────────────────────
for item on palette.chosen

. node = files.find(item.path)
if node
    session.revealed <- node
else if files.contains(item.path)
    toaster.post("${item.name} is no longer there")
else
    toaster.post("${item.name} is outside ${files.root.path.name}")

────────────────────
for touched on files.changed

revision += 1

────────────────────
for message on session.failed

toaster.post(message)

────────────────────
+ do toggle-columns

shows-columns = !shows-columns

━━━━━━━━━━━━━━━━━━━━
_ file-browser-location String
    - revision Size
    - node FileNode?

|? node
    "${node.path}"
??
    ""

━━━━━━━━━━━━━━━━━━━━
_ file-browser-status String
    - files FileTree
    - revision Size

"${files.loaded-count} folders loaded · updates: $revision · $watching"

.. watching = if files.is-watching then "watching" else "not watching"
