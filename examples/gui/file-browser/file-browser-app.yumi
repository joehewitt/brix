./file-browser-panel
/gui
/gui/file-browsing
/os/cli
/os/env
/os/path

. files = use FileTree(file-browser-root(cmdline().args))

<App
    <Window • flex-col
        title = "Yumi GUI: File Browser"
        size = (1080, 760)

        <FileBrowserPanel • flex:1
            files = files

━━━━━━━━━━━━━━━━━━━━
_ file-browser-root Path
    - args [String]

|? args.length > 0
    Path(args[0], 0)
??
    Path(home, 0)

.. home = env-required("HOME")
    catch err Error
        ?! Panic("Could not locate the home directory: $err")
