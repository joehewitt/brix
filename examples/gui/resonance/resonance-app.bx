(import ./resonance-panel)
(import ./resonance-sound)
(import /graphics/primitives)
(import /gui)
(import /lang/product/mac-app)
(blank)

(main
  (<> MacApp
    (= id "com.yumi.resonance")
    (= name "Resonance")
  )
  (blank)
  (let instrument (call ResonanceSound (call resonance-sounds)))
  (use instrument)
  (blank)
  (<> App
    (<> Window (• flex-col)
      (= appearance (. WindowAppearance dark))
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= title "Resonance")
      (= size (call Dimensions 1000 800))
      (blank)
      (<> ResonancePanel (• flex 1)
        (= sound instrument)
      )
    )
  )
)
