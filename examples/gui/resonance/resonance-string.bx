(import /graphics/point)
(import /math)
(import /time/duration)
(blank)
(prop + strand-segments _ (= 24))
(prop _ strand-tension _ (= 2400.0))
(prop _ strand-damping _ (= 2.4))
(prop _ strand-reach _ (= 140.0))
(prop _ glow-decay _ (= 0.65))

(type _ StrandNode
  (prop + displacement Float)
  (prop + velocity Float)
)

(type + ResonanceString
  (prop + from Point)
  (prop + to Point)
  (prop + voice Int)
  (prop + glow Float)
  (prop + rang-at (? Seconds))
  (prop _ nodes _ (= (call (of List StrandNode) (in (call StrandNode) (.. 0 strand-segments)))))
  (fn-do + This _
    (param from _)
    (param to _)
    (param voice _)
  )
  (fn-expr + normal Point :get
    (/ (call Point (- (. span y)) (. span x)) (call max 1.0 (. span length)))
    (where
      (lazy span (- to from))
    )
  )
  (fn-expr + rest Point
    (param index Int)
    (+ from (* (- to from) (/ index (as strand-segments Float))))
  )
  (fn-expr + point Point
    (param index Int)
    (+ (call rest index) (* normal (call displacement-at index)))
  )
  (fn-expr + along Point
    (param progress Float)
    (+ start (* (- (call point (+ index 1)) start) (- position index)))
    (where
      (lazy position (* progress strand-segments))
      (lazy index (call min (- strand-segments 1) (as position Int)))
      (lazy start (call point index))
    )
  )
  (fn-expr + displacement-at Float
    (param index Int)
    (. ([] nodes index) displacement)
  )
  (fn-expr + velocity-at Float
    (param index Int)
    (param t Float)
    (+ (* (. ([] nodes index) velocity) (- 1 t)) (* (. ([] nodes (+ index 1)) velocity) t))
  )
  (fn-do + pull _
    (param index Int)
    (param offset Float)
    (= (. ([] nodes index) displacement) offset)
    (= glow 1)
  )
  (fn-do + step _
    (param dt Float)
    (param held (? Int))
    (for (in index (..< 1 strand-segments))
      (let node ([] nodes index))
      (let neighbors (+ (call displacement-at (- index 1)) (call displacement-at (+ index 1))))
      (let curvature (- neighbors (* (. node displacement) 2)))
      (+= (. node velocity) (* (- (* curvature strand-tension) (* (. node velocity) strand-damping)) dt))
    )
    (for (in index (..< 1 strand-segments))
      (let node ([] nodes index))
      (if (== index held)
        (= (. node velocity) 0)
        (else
          (let moved (+ (. node displacement) (* (. node velocity) dt)))
          (= (. node displacement) (call clamp moved (- strand-reach) strand-reach))
        )
      )
    )
    (= glow (call max 0.0 (- glow (* dt glow-decay))))
  )
  (fn-do + excite _
    (param index Int)
    (param strength Float)
    (for (in offset (.. -2 2))
      (let at (+ index offset))
      (if (and (> at 0) (< at strand-segments))
        (+= (. ([] nodes at) velocity) (* strength (- 1 (* (call abs offset) 0.28))))
      )
    )
    (= glow (call min 1.0 (+ glow (/ (call abs strength) 240))))
  )
)
