(import ./resonance-art)
(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)

(style ResonanceTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxTransform)
  (using GUIBoxWindowDrag)
  (rule resonance-panel (• bg resonance-night) (• text resonance-ink)
    (= focus-mode (. FocusMode keys))
    (= focus-default true)
    (= focus-home true)
  )
  (rule resonance-board (• absolute) (• cover .parent))
  (rule resonance-title (• absolute) (• flex-col) (• h 118)
    (= left 0)
    (= right 0)
    (= top 34)
    (= window-draggable true)
    (rule Label (• text resonance-mist) (• h 118)
      (= font-family "Avenir Next")
      (= font-size 104)
      (= font-weight (. FontWeight heavy))
      (= text-alignment (. TextAlignment center))
    )
  )
  (rule resonance-help (• absolute) (• flex-col) (• w 260)
    (= right 30)
    (= bottom 22)
  )
  (rule resonance-caption (• text resonance-muted) (• h 20)
    (= font-size 11)
    (= text-alignment (. TextAlignment right))
  )
  (rule resonance-banner (• absolute) (• center .parent) (• w 200) (• h 50)
    (= font-size 30)
    (= text-alignment (. TextAlignment center))
    (when-style #is-entering
      (= animation pop-in)
    )
    (when-style #is-leaving
      (= animation popup-out)
    )
  )
)
