(import ./resonance-field)
(import ./resonance-game)
(import ./resonance-string)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /time/duration)
(blank)
(prop + resonance-night RGBA (= "#04080e"))
(prop + resonance-mist RGBA (= "#c0d4de70"))
(prop + resonance-muted RGBA (= "#74858e"))
(prop + resonance-ink RGBA (= "#eef2ec"))
(prop _ frost _ (= (call RGBA 0.55 0.72 0.8)))
(prop _ star-color _ (= (call RGBA 0.7 0.82 0.9)))
(prop _ bell-core RGBA (= "#f2f4e9"))
(prop _ grip-core RGBA (= "#fff8e8"))
(prop _ star-count _ (= 100))
(prop _ golden-angle Radians (= 2.39996rad))
(prop _ tick-count _ (= 84))
(prop _ bell-flash Seconds (= 1.54s))
(prop _ bloom-rings _ (= 5))
(prop _ strand-widths _ (= (list 9.0 3.5 0.9)))
(prop _ palette (list RGBA) (= (list "#b9a3ed" "#94b8f3" "#8ad9db" "#b6dfbe" "#ead99c" "#eeb49a" "#e7a4c9")))

(fn-expr + resonance-color RGBA
  (param voice Int)
  ([] palette (% voice (. palette length)))
)

(fn-do + paint-resonance-stage _
  (param canvas Canvas)
  (param game ResonanceGame)
  (let clock (. game clock))
  (let bloom (call sin (* (. game bloom-progress) π)))
  (do-use (. canvas saved-state)
    (= (. canvas shape-fill) (call ResonanceField clock bloom resonance-center resonance-radius))
    (call (. canvas rect) (call Rect resonance-stage-size))
  )
  (call paint-sky canvas clock)
  (call paint-rim canvas)
  (for (in ripple (. game ripples))
    (call paint-ripple canvas ripple clock)
  )
  (for (in strand (. game strings))
    (call paint-string canvas strand (call (. game is-touched) (. strand voice)) clock)
  )
  (for (in mote (. game motes))
    (call paint-mote canvas mote clock)
  )
  (for (in bell (. game bells))
    (call paint-bell canvas bell clock)
  )
  (let touch (. game held))
  (if touch
    (call paint-pull canvas ([] (. game strings) (. touch voice)) (. touch node))
  )
  (if (> bloom 0)
    (for (in index (..< 0 bloom-rings))
      (let radius (+ 45 (* (. game bloom-progress) 315) (* index 18.0)))
      (call stroke canvas (call (. (call resonance-color index) with-alpha) (* bloom 0.18)) 1.5)
      (call dot canvas resonance-center radius)
    )
  )
)

(fn-do _ paint-sky _
  (param canvas Canvas)
  (param clock Seconds)
  (= (. canvas stroke-color) null)
  (for (in index (..< 0 star-count))
    (let place (call resonance-orbit (* golden-angle index) (+ 40 (* (call sqrt (/ index (as star-count Float))) 360))))
    (= (. canvas fill-color) (call (. star-color with-alpha) (+ 0.08 (* 0.05 (call sin (+ (* (as clock Float) 0.7) index))))))
    (call dot canvas place (if-expr (== (% index 9) 0) 1.2 0.6))
  )
)

(fn-do _ paint-rim _
  (param canvas Canvas)
  (call stroke canvas (call (. frost with-alpha) 0.12) 1)
  (call dot canvas resonance-center (+ resonance-radius 1))
  (call stroke canvas (call (. frost with-alpha) 0.04) 1)
  (call dot canvas resonance-center (+ resonance-radius 8))
  (call stroke canvas (call (. frost with-alpha) 0.09) 1)
  (for (in index (..< 0 tick-count))
    (let angle (/ (* π 2 index) tick-count))
    (let inner (call resonance-orbit angle (+ resonance-radius 6)))
    (call (. canvas line) inner (call resonance-orbit angle (+ resonance-radius 10)))
  )
)

(fn-do _ paint-ripple _
  (param canvas Canvas)
  (param ripple ResonanceRipple)
  (param clock Seconds)
  (let fade (call resonance-fade clock (. ripple born) resonance-ripple-lifetime))
  (let radius (+ 8 (* (as (- clock (. ripple born)) Float) 115)))
  (let color (call resonance-color (. ripple voice)))
  (call stroke canvas (call (. color with-alpha) (* fade 0.035)) 7)
  (call dot canvas (. ripple point) radius)
  (call stroke canvas (call (. color with-alpha) (* fade 0.18)) 0.7)
  (call dot canvas (. ripple point) radius)
)

(fn-do _ paint-string _
  (param canvas Canvas)
  (param strand ResonanceString)
  (param is-touched Bool)
  (param clock Seconds)
  (let color (call resonance-color (. strand voice)))
  (let glow (call max (. strand glow) (if-expr is-touched 0.7 0.0)))
  (let opacities (list (+ 0.025 (* glow 0.04)) (+ 0.1 (* glow 0.12)) (+ 0.55 (* glow 0.4))))
  (for (in layer (..< 0 (. strand-widths length)))
    (call stroke canvas (call (. color with-alpha) ([] opacities layer)) ([] strand-widths layer))
    (call trace-strand canvas strand)
  )
  (= (. canvas stroke-color) null)
  (if (> glow 0.05)
    (for (in packet (..< 0 3))
      (let progress (% (+ (* (as clock Float) 0.6) (/ packet 3.0) (* (. strand voice) 0.13)) 1.0))
      (let place (call (. strand along) progress))
      (call glint canvas place 6 (call (. color with-alpha) (* glow 0.1)))
      (call glint canvas place 1.6 (call (. color with-alpha) (* glow 0.9)))
    )
  )
  (for (in anchor (list (. strand from) (. strand to)))
    (call glint canvas anchor (+ 10 (* glow 3)) (call (. color with-alpha) (+ 0.04 (* glow 0.05))))
    (call stroke canvas (call (. color with-alpha) 0.5) 0.8)
    (call dot canvas anchor 4)
    (call glint canvas anchor 1.5 color)
  )
)

(fn-do _ trace-strand _
  (param canvas Canvas)
  (param strand ResonanceString)
  (let first (call (. strand point) 0))
  (call (. canvas begin))
  (call (. canvas move) (. first x) (. first y))
  (for (in index (..< 0 strand-segments))
    (let before (call (. strand point) (call max 0 (- index 1))))
    (let start (call (. strand point) index))
    (let end (call (. strand point) (+ index 1)))
    (let after (call (. strand point) (call min strand-segments (+ index 2))))
    (let leave (+ start (/ (- end before) 6)))
    (let enter (- end (/ (- after start) 6)))
    (call (. canvas curve) (. leave x) (. leave y) (. enter x) (. enter y) (. end x) (. end y))
  )
  (call (. canvas end))
)

(fn-do _ paint-mote _
  (param canvas Canvas)
  (param mote LightMote)
  (param clock Seconds)
  (let color (call resonance-color (. mote voice)))
  (let life (call clamp-unit (* (as (- (. mote expires-at) clock) Float) 0.7)))
  (call paint-trail canvas (. mote trail) color life)
  (call glint canvas (. mote place) 14 (call (. color with-alpha) (* life 0.04)))
  (call glint canvas (. mote place) 8 (call (. color with-alpha) (* life 0.12)))
  (call glint canvas (. mote place) 3.5 (call (. color with-alpha) life))
  (call glint canvas (. mote place) 1.7 (call RGBA 1 1 1 life))
)

(fn-do _ paint-trail _
  (param canvas Canvas)
  (param trail (list Point))
  (param color RGBA)
  (param life Float)
  (return-if (if (< (. trail length) 2)))
  (for (in index (..< 1 (. trail length)))
    (let fade (* (/ index (as (. trail length) Float)) life))
    (let from ([] trail (- index 1)))
    (let to ([] trail index))
    (call stroke canvas (call (. color with-alpha) (* fade 0.07)) 7)
    (call (. canvas line) from to)
    (call stroke canvas (call (. color with-alpha) (* fade 0.65)) 1.5)
    (call (. canvas line) from to)
  )
)

(fn-do _ paint-bell _
  (param canvas Canvas)
  (param bell ResonanceBell)
  (param clock Seconds)
  (let color (call resonance-color (. bell voice)))
  (let level (if-expr (. bell is-lit) 1.0 0.6))
  (let pulse (call resonance-fade clock (. bell rang-at) bell-flash))
  (let seconds (as clock Float))
  (let radius (+ 22 (* (call sin (+ (* seconds 1.4) (. bell voice))) 1.2)))
  (call glint canvas (. bell point) 33 (call (. color with-alpha) (+ 0.02 (* pulse 0.08))))
  (call stroke canvas (call (. color with-alpha) (* level 0.7)) 1)
  (call dot canvas (. bell point) radius)
  (call stroke canvas (call (. color with-alpha) (* level 0.18)) 0.8)
  (call dot canvas (. bell point) (- radius 5))
  (for (in index (..< 0 6))
    (let angle (+ (/ (* π index) 3) (* seconds 0.06)))
    (call glint canvas (+ (. bell point) (call polar angle radius)) 1.4 (call (. color with-alpha) level))
  )
  (if (. bell is-lit)
    (call glint canvas (. bell point) 10 (call (. color with-alpha) 0.13))
    (call glint canvas (. bell point) 4 color)
    (call glint canvas (. bell point) 2 bell-core)
    (else
      (call stroke canvas (call (. color with-alpha) 0.45) 1)
      (call dot canvas (. bell point) 3)
    )
  )
  (if (> pulse 0)
    (call stroke canvas (call (. color with-alpha) (* pulse 0.6)) 1)
    (call dot canvas (. bell point) (+ 25 (* (- 1 pulse) 58)))
  )
)

(fn-do _ paint-pull _
  (param canvas Canvas)
  (param strand ResonanceString)
  (param node Int)
  (let origin (call (. strand point) node))
  (let pull (call (. strand displacement-at) node))
  (let color (call resonance-color (. strand voice)))
  (call stroke canvas (call (. color with-alpha) 0.18) 0.7)
  (call (. canvas line) (call (. strand rest) node) origin)
  (let step (* (. strand normal) (if-expr (>= pull 0) -13.0 13.0)))
  (for (in index (.. 1 8))
    (call glint canvas (+ origin (* step (as index Float))) 0.8 (call (. color with-alpha) (* (- 1 (/ index 9.0)) 0.45)))
  )
  (call stroke canvas (call (. color with-alpha) 0.35) 0.8)
  (call dot canvas origin (+ 13 (* (call abs pull) 0.04)))
  (call glint canvas origin 8 (call (. color with-alpha) 0.15))
  (call glint canvas origin 4 grip-core)
)

(fn-do _ glint _
  (param canvas Canvas)
  (param center Point)
  (param radius Float)
  (param color RGBA)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) color)
  (call dot canvas center radius)
)

(fn-do _ stroke _
  (param canvas Canvas)
  (param color RGBA)
  (param width Float)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) color)
  (= (. canvas stroke-width) width)
  (= (. canvas stroke-cap) (. LineCap round))
)

(fn-do _ dot _
  (param canvas Canvas)
  (param center Point)
  (param radius Float)
  (call (. canvas circle) (. center x) (. center y) radius)
)

(fn-expr _ polar Point
  (param angle Radians)
  (param length Float)
  (* (call Point (call cos angle) (call sin angle)) length)
)
