(import ./../../clockwork-window)
(import /graphics/point)
(import /gui)
(import /gui/bench/fixtures/window-frame-fixture)
(import /time/timer)
(blank)
(prop _ clockwork-bench-settle-steps Size (= 40))
(prop _ clockwork-bench-tail-steps Size (= 30))
(prop _ clockwork-bench-segment-steps Size (= 60))
(prop _ clockwork-bench-zoom-delta F64 (= 3.9220713))
(prop _ clockwork-bench-pan _ (= (call Point 6 2)))
(prop _ clockwork-bench-command U64 (= 8))
(prop _ clockwork-bench-center _ (= (call Point 720 450)))

(type + ClockworkBenchScript (is Union)
  (variant animate)
  (variant zoom)
)

(type + ClockworkBenchWindow (is ClockworkWindow)
  (prop + script ClockworkBenchScript (= (. ClockworkBenchScript animate)))
  (prop + moving-steps Size (= 180))
  (prop + result-name String (= "clockwork/window-clockwork"))
  (prop _ log _ (:= (call WindowBenchLog this)))
  (fn-do + open _
    (= state-key null)
    (= size window-bench-size)
    (call (. super open))
    (call (. log start))
  )
  (fn-do + end-frame _
    (param committed Bool)
    (call (. super end-frame) committed)
    (call drive committed)
  )
  (fn-do _ drive _
    (param committed Bool)
    (call (. log after-frame) committed)
    (let step (. log steps))
    (let last (+ clockwork-bench-settle-steps moving-steps))
    (if (== step (+ last clockwork-bench-tail-steps))
      (call (. log finish) result-name (+ gear-count step))
      (return)
    )
    (return-if (if (or (< step clockwork-bench-settle-steps) (>= step last) (== script (. ClockworkBenchScript animate)))))
    (blank)
    (let started (call monotonic-time-nanoseconds))
    (let moved (- step clockwork-bench-settle-steps))
    (let segment (/ moved clockwork-bench-segment-steps))
    (let within (% moved clockwork-bench-segment-steps))
    (let ending (== within (- clockwork-bench-segment-steps 1)))
    (let phase (if-expr (== within 0) (. ScrollPhase began) (if-expr ending (. ScrollPhase ended) (. ScrollPhase changed))))
    (match segment
      (case= 1
        (call (. log scroll) clockwork-bench-center (if-expr ending (call Point 0 0) clockwork-bench-pan) phase)
      )
      (default
        (let delta (if-expr (== segment 0) (- clockwork-bench-zoom-delta) clockwork-bench-zoom-delta))
        (call (. log scroll) clockwork-bench-center (call Point 0 (if-expr ending 0.0 delta)) phase clockwork-bench-command)
      )
    )
    (call (. log timed) started)
  )
)
