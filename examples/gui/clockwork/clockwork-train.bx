(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop + base-module _ (= 3.0))
(prop + plate-radius _ (= 250.0))
(prop + bezel-inset _ (= 14.0))
(prop + crank-reach _ (= 150.0))
(prop + rocker-length _ (= 60.0))
(prop + balance-size _ (= 30.0))
(prop + tooth-counts _ (= (list 8 10 12 14 16 20 24 30 36 42 48 60)))
(prop _ cell-size _ (= 560.0))
(prop _ field-margin _ (= 120.0))
(prop _ field-aspect _ (= 1.58))
(prop _ gears-per-movement _ (= 25))
(prop _ growth-attempts _ (= 900))
(prop _ kick-time _ (= 6.0))
(prop _ drive-ease _ (= 3.0))
(prop _ swing-rate _ (= 9.0))
(prop _ swing-reach _ (= 1.15))

(type + MotionMode (is Union)
  (variant transforms)
  (variant deform)
  (fn-expr + title String :get
    (match this
      (case .transforms
        "Transforms"
      )
      (default
        "Deform"
      )
    )
  )
)

(type + Detail (is Union)
  (variant coarse)
  (variant fine)
  (variant ultra)
  (fn-expr + title String :get
    (match this
      (case .coarse
        "Coarse teeth"
      )
      (case .fine
        "Fine teeth"
      )
      (default
        "Ultra teeth"
      )
    )
  )
  (fn-expr + code Int :get
    (match this
      (case .coarse
        0
      )
      (case .fine
        1
      )
      (default
        2
      )
    )
  )
)

(type + CutoutMode (is Union)
  (variant off)
  (variant winding)
  (variant even-odd)
  (fn-expr + title String :get
    (match this
      (case .off
        "No cutouts"
      )
      (case .winding
        "Winding cutouts"
      )
      (default
        "Even-odd cutouts"
      )
    )
  )
  (fn-expr + code Int :get
    (match this
      (case .off
        0
      )
      (case .winding
        1
      )
      (default
        2
      )
    )
  )
)

(type + ClockworkSettings (is Tuple)
  (prop + motion MotionMode)
  (prop + detail Detail)
  (prop + cutouts CutoutMode)
  (prop + has-strokes Bool)
  (prop + has-bevels Bool)
  (prop + has-gradients Bool)
  (prop + has-glints Bool)
  (prop + has-shadows Bool)
  (prop + has-clips Bool)
  (fn-expr + kit-code Int :get
    (+ (. detail code) (* (. cutouts code) 3) (if-expr has-strokes 9 0) (if-expr has-bevels 18 0))
  )
)

(type + Gear (is Tuple)
  (prop + index Int)
  (prop + movement Int)
  (prop + parent Int)
  (prop + x F64)
  (prop + y F64)
  (prop + slot Int)
  (prop + teeth Int)
  (prop + module F64)
  (prop + base F64)
  (prop + rate F64)
  (prop + palette Int)
  (prop + is-coaxial Bool)
  (fn-expr + radius F64 :get
    (* module (as teeth F64) 0.5)
  )
  (fn-expr + tip-radius F64 :get
    (+ (* module (as teeth F64) 0.5) module)
  )
)

(type + Movement (is Tuple)
  (prop + index Int)
  (prop + x F64)
  (prop + y F64)
  (prop + first-gear Int)
  (prop + gear-count Int)
  (prop + first-balance Int)
  (prop + balance-count Int)
  (prop + is-animated Bool)
  (prop + speed F64)
  (prop + has-linkage Bool)
  (prop + pivot-x F64)
  (prop + pivot-y F64)
  (prop + crank-radius F64)
  (prop + label Int)
  (prop + is-calibration Bool)
)

(type + Balance (is Tuple)
  (prop + movement Int)
  (prop + x F64)
  (prop + y F64)
  (prop + radius F64)
  (prop + spring-slot Int)
  (prop + phase F64)
)

(type + SceneCounts (is Tuple)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + clips Int)
  (prop + shadows Int)
)

(type + ClockworkField
  (prop + animated-share Int)
  (prop + extent Dimensions)
  (prop + gears (list Gear))
  (prop + movements (list Movement))
  (prop + balances (list Balance))
  (prop + mean-diameter F64)
  (prop + live-count Int)
  (prop _ drive (list F64))
  (prop _ velocity (list F64))
  (prop _ heading (list F64))
  (prop _ kick (list F64))
  (fn-do + This _
    (param count Int)
    (param share Int)
    (= animated-share share)
    (let total (call max 1 (/ (+ count (/ gears-per-movement 2)) gears-per-movement)))
    (let columns (call max 1 (as (call ceil (call sqrt (* (as total F64) field-aspect))) Int)))
    (let rows (/ (+ total (- columns 1)) columns))
    (= extent (call Dimensions (+ (* (as columns F64) cell-size) (* field-margin 2)) (+ (* (as rows F64) cell-size) (* field-margin 2))))
    (for (in index (..< 0 total))
      (let cx (+ field-margin (* (+ (as (% index columns) F64) 0.5) cell-size)))
      (let cy (+ field-margin (* (+ (as (/ index columns) F64) 0.5) cell-size)))
      (if (== index 0)
        (call grow-calibration cx cy)
        (else
          (call grow-movement index cx cy)
        )
      )
    )
    (let span 0.0)
    (for (in gear gears)
      (+= span (* (. gear radius) 2))
    )
    (= mean-diameter (/ span (as (call max 1 (. gears length)) F64)))
    (for (in movement movements)
      (+= drive (* (call hash-unit (+ (* (. movement index) 211) 5)) 40))
      (+= velocity (if-expr (. movement is-animated) (. movement speed) 0.0))
      (+= heading (if-expr (== (% (. movement index) 3) 1) -1.0 1.0))
      (+= kick 0.0)
      (if (. movement is-animated)
        (+= live-count 1)
      )
    )
  )
  (fn-expr + is-live Bool
    (param index Int)
    (or (. ([] movements index) is-animated) (> ([] kick index) 0))
  )
  (fn-expr + gear-angle F64
    (param gear Gear)
    (+ (. gear base) (* (. gear rate) ([] drive (. gear movement))))
  )
  (fn-expr + balance-swing F64
    (param balance Balance)
    (* swing-reach (call sin (+ (* ([] drive (. balance movement)) swing-rate) (. balance phase))))
  )
  (fn-do + advance Bool
    (param seconds F64)
    (let changed false)
    (let blend (call min 1.0 (* seconds drive-ease)))
    (for (in movement movements)
      (let index (. movement index))
      (let left ([] kick index))
      (if (or (. movement is-animated) (> left 0))
        (let pace (if-expr (. movement is-animated) 1.0 (call min 1.0 left)))
        (let goal (* ([] heading index) (. movement speed) pace))
        (let speed (+ ([] velocity index) (* (- goal ([] velocity index)) blend)))
        (= ([] velocity index) speed)
        (= ([] drive index) (+ ([] drive index) (* speed seconds)))
        (if (> left 0)
          (let rest (- left seconds))
          (if (<= rest 0)
            (= ([] kick index) 0.0)
            (= ([] velocity index) 0.0)
            (if (not (. movement is-animated))
              (-= live-count 1)
              (= changed true)
            )
            (else
              (= ([] kick index) rest)
            )
          )
        )
      )
    )
    (return changed)
  )
  (fn-do + poke Bool
    (param point Point)
    (for (in movement movements)
      (let dx (- (. point x) (. movement x)))
      (let dy (- (. point y) (. movement y)))
      (if (<= (+ (* dx dx) (* dy dy)) (* plate-radius plate-radius))
        (let index (. movement index))
        (if (. movement is-animated)
          (= ([] heading index) (- ([] heading index)))
          (return false)
        )
        (let was-live (> ([] kick index) 0))
        (= ([] kick index) kick-time)
        (return-if false (if was-live))
        (blank)
        (+= live-count 1)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ grow-movement _
    (param index Int)
    (param cx F64)
    (param cy F64)
    (let first (. gears length))
    (let seed (+ (* index 7919) 13))
    (+= gears (call Gear first index -1 cx cy 8 36 base-module 0.0 1.0 (% index 3) false))
    (for (in attempt (..< 0 growth-attempts))
      (let grown (- (. gears length) first))
      (if (>= grown gears-per-movement)
        (break)
      )
      (let pick (call hash-unit (+ seed (* attempt 17))))
      (let size (call hash-unit (+ seed (* attempt 31) 7)))
      (let turn (call hash-unit (+ seed (* attempt 43) 11)))
      (let parent ([] gears (+ first (call min (- grown 1) (as (* pick (as grown F64)) Int)))))
      (let slot (call min 11 (as (+ (* size size 9) (* size 3)) Int)))
      (let teeth ([] tooth-counts slot))
      (let radius (* base-module (as teeth F64) 0.5))
      (let tip (+ radius base-module))
      (let phi (* turn 2 π))
      (let reach (+ (. parent radius) radius))
      (let x (+ (. parent x) (* reach (call cos phi))))
      (let y (+ (. parent y) (* reach (call sin phi))))
      (let fits (<= (+ (call distance x y cx cy) tip) (- plate-radius 6)))
      (if fits
        (for (in other (..< first (. gears length)))
          (let near ([] gears other))
          (if (and (!= other (. parent index)) (< (call distance x y (. near x) (. near y)) (+ (. near tip-radius) tip 2.5)))
            (= fits false)
            (break)
          )
        )
      )
      (if fits
        (let ratio (/ (as (. parent teeth) F64) (as teeth F64)))
        (let base (+ phi π (- (/ π (as teeth F64))) (* ratio (- phi (. parent base)))))
        (let palette (if-expr (< teeth 16) (+ 3 (% attempt 2)) (% (+ index attempt) 3)))
        (+= gears (call Gear (. gears length) index (. parent index) x y slot teeth base-module base (- (* ratio (. parent rate))) palette false))
      )
    )
    (let meshed (. gears length))
    (for (in host (..< first meshed))
      (let wheel ([] gears host))
      (if (and (>= (. wheel teeth) 30) (< (call hash-unit (+ seed (* host 59) 3)) 0.6))
        (let slot (+ 1 (% host 2)))
        (+= gears (call Gear (. gears length) index host (. wheel x) (. wheel y) slot ([] tooth-counts slot) base-module (. wheel base) (. wheel rate) 3 true))
      )
    )
    (let first-balance (. balances length))
    (for (in attempt (..< 0 80))
      (let far (* (call sqrt (call hash-unit (+ seed (* attempt 67) 23))) (- plate-radius balance-size 10)))
      (let around (* (call hash-unit (+ seed (* attempt 71) 29)) 2 π))
      (let x (+ cx (* far (call cos around))))
      (let y (+ cy (* far (call sin around))))
      (let fits true)
      (for (in other (..< first meshed))
        (let near ([] gears other))
        (if (< (call distance x y (. near x) (. near y)) (+ (. near tip-radius) balance-size 3))
          (= fits false)
          (break)
        )
      )
      (if fits
        (+= balances (call Balance index x y balance-size 0 (* (call hash-unit (+ seed 41)) 2 π)))
        (break)
      )
    )
    (let swing (* (call hash-unit (+ seed 53)) 2 π))
    (let speed (+ 0.45 (* 0.5 (call hash-unit (+ seed 61)))))
    (+= movements
      (call Movement
        (block
          (arg index)
          (arg cx)
          (arg cy)
          (arg first)
          (arg (- (. gears length) first))
          (arg first-balance)
          (arg (- (. balances length) first-balance))
          (arg (call movement-is-animated index animated-share))
          (arg speed)
          (arg true)
          (arg (+ cx (* crank-reach (call cos swing))))
          (arg (+ cy (* crank-reach (call sin swing))))
          (arg 22.0)
          (arg (% index 6))
          (arg false)
        )
      )
    )
  )
  (fn-do _ grow-calibration _
    (param cx F64)
    (param cy F64)
    (let first (. gears length))
    (let top (- cy 126.0))
    (let module 4.0)
    (for (in row (..< 0 5))
      (let x (- cx 110.0))
      (let y (+ top (* module 13)))
      (let driver (. gears length))
      (+= gears (call Gear driver 0 -1 x y 6 24 module 0.0 1.0 (% row 3) false))
      (+= gears (call Gear (+ driver 1) 0 driver (+ x (* module 20)) y 4 16 module (- π (/ π 16)) -1.5 3 false))
      (+= top (+ (* module 26) 10))
      (*= module 0.5)
    )
    (let first-balance (. balances length))
    (for (in slot (..< 1 5))
      (+= balances (call Balance 0 (+ cx 120.0) (+ cy -180.0 (* (as slot F64) 72)) 26.0 slot (* (as slot F64) 0.9)))
    )
    (+= movements
      (call Movement
        (block
          (arg 0)
          (arg cx)
          (arg cy)
          (arg first)
          (arg (- (. gears length) first))
          (arg first-balance)
          (arg (- (. balances length) first-balance))
          (arg (call movement-is-animated 0 animated-share))
          (arg 0.6)
          (arg false)
          (arg cx)
          (arg cy)
          (arg 0.0)
          (arg 6)
          (arg true)
        )
      )
    )
  )
)

(fn-expr + hash-unit F64
  (param seed Int)
  (- value (call floor value))
  (where
    (lazy value (* (call sin (* (as seed F64) 12.9898)) 43758.5453))
  )
)

(fn-expr _ distance F64
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (call sqrt (+ (* (- x1 x0) (- x1 x0)) (* (- y1 y0) (- y1 y0))))
)

(fn-expr _ movement-is-animated Bool
  (param index Int)
  (param share Int)
  (and (> share 0) (or (>= share 100) (< (% (* index 37) 100) share)))
)
