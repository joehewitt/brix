(import ./clockwork-gears)
(import ./clockwork-train)
(import /graphics/appearance)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /math)
(import /units)
(blank)
(prop _ plate-fill _ (= (call RGBA "#3a3f47")))
(prop _ plate-rim _ (= (call RGBA "#5d646e")))
(prop _ plate-groove _ (= (call RGBA "#2c3037")))
(prop _ plate-turning _ (= (call RGBA "#474d57")))
(prop _ plate-ink _ (= (call RGBA "#9aa3b0")))
(prop _ screw-head _ (= (call RGBA "#aeb6c2")))
(prop _ screw-slot _ (= (call RGBA "#23262c")))
(prop _ jewel-fill _ (= (call RGBA "#c2274f")))
(prop _ jewel-rim _ (= (call RGBA "#e8c66a")))
(prop _ spring-blue _ (= (call RGBA "#4f7fe0")))
(prop _ glint-light _ (= (call RGBA "#fff6d048")))
(prop _ glint-shade _ (= (call RGBA "#2a1c1070")))
(prop _ gear-shadow _ (= (call Shadow (call RGBA "#0000007a") 5 1.5 2.5 0)))
(prop _ lifted-shadow _ (= (call Shadow (call RGBA "#00000090") 8 2.5 4 0)))
(prop _ gear-stroke _ (= 0.9))
(prop _ inside-bevel _ (= 1.4))
(prop _ outside-bevel _ (= 1.0))
(prop _ long-bar-half _ (= 2.6))
(prop _ short-bar-half _ (= 3.2))
(prop _ light-x _ (= -0.6))
(prop _ light-y _ (= -0.8))
(prop _ spring-widths _ (= (list 1.1 2.0 1.0 0.5 0.25)))
(prop _ kit-key-base _ (= 961000000))
(prop _ calibre-names _
  (=
    (list
      "CAL. 1042 · 17 JEWELS"
      "CAL. 2260 · 21 JEWELS"
      "CAL. 3105 · 19 JEWELS"
      "CAL. 4471 · 25 JEWELS"
      "CAL. 5038 · 23 JEWELS"
      "CAL. 6690 · 15 JEWELS"
    )
  )
)

(type + MetalPalette (is Tuple)
  (prop + body RGBA)
  (prop + edge RGBA)
  (prop + light RGBA)
  (prop + shade RGBA)
)

(prop _ metal-palettes _
  (=
    (list
      (call MetalPalette (call RGBA "#c9a24a") (call RGBA "#5f4717") (call RGBA "#f4dc92") (call RGBA "#8a6a25"))
      (call MetalPalette (call RGBA "#cf9270") (call RGBA "#673a26") (call RGBA "#f6c9ae") (call RGBA "#935a40"))
      (call MetalPalette (call RGBA "#d9c27a") (call RGBA "#6b5a24") (call RGBA "#fbeeb8") (call RGBA "#9c8640"))
      (call MetalPalette (call RGBA "#aab2bd") (call RGBA "#3c424b") (call RGBA "#eef2f7") (call RGBA "#6c7480"))
      (call MetalPalette (call RGBA "#8b939f") (call RGBA "#2f343c") (call RGBA "#d3d9e1") (call RGBA "#565d68"))
      (call MetalPalette (call RGBA "#3f62b8") (call RGBA "#162449") (call RGBA "#8fb0f5") (call RGBA "#273f80"))
    )
  )
)

(type + ClockworkKit
  (prop + palettes (list MetalPalette))
  (prop + stamp-palettes (list (list RGBA)))
  (prop + spring-palette (list RGBA))
  (prop + tracer _ (= (call GearTracer)))
  (prop + scratch _ (= (call Path)))
  (prop + rule _ (= (. FillRule nonzero)))
  (prop + gear-paths (list Path))
  (prop + gear-segments (list Int))
  (prop + filled (list VectorGeometryHandle))
  (prop + hollow (list VectorGeometryHandle))
  (prop + rim (? VectorGeometryHandle) (= null))
  (prop + springs (list VectorGeometryHandle))
  (prop + long-bar (? VectorGeometryHandle) (= null))
  (prop + short-bar (? VectorGeometryHandle) (= null))
  (prop + labels (list TextLayout))
  (fn-do + This _
    (param table VectorGeometryTable)
    (param settings ClockworkSettings)
    (for (in entry metal-palettes)
      (+= palettes entry)
      (+= stamp-palettes (list (. entry body) (. entry edge) (. entry light) (. entry shade)))
    )
    (+= spring-palette spring-blue)
    (if (== (. settings cutouts) (. CutoutMode even-odd))
      (= rule (. FillRule even-odd))
    )
    (let key (+ kit-key-base (* (. settings kit-code) 1000)))
    (for (in slot (..< 0 (. tooth-counts length)))
      (let teeth ([] tooth-counts slot))
      (let path (call Path))
      (+= gear-segments (call (. tracer trace-gear) path teeth base-module (. settings detail) (. settings cutouts) 0.0 0.0 0.0))
      (+= gear-paths path)
      (+= filled (call (. table intern-geometry) (as (+ key slot) U64) (=> () (call gear-geometry path teeth settings true))))
      (+= hollow (call (. table intern-geometry) (as (+ key 100 slot) U64) (=> () (call gear-geometry path teeth settings false))))
    )
    (= rim (call (. table intern-geometry) (as (+ key 200) U64) (=> () (call rim-geometry settings))))
    (= long-bar (call (. table intern-geometry) (as (+ key 210) U64) (=> () (call bar-geometry crank-reach long-bar-half settings))))
    (= short-bar (call (. table intern-geometry) (as (+ key 211) U64) (=> () (call bar-geometry rocker-length short-bar-half settings))))
    (for (in slot (..< 0 (. spring-widths length)))
      (+= springs (call (. table intern-geometry) (as (+ kit-key-base 900 slot) U64) (=> () (call spring-geometry ([] spring-widths slot)))))
    )
    (let font (call Font "Helvetica" 11 (. FontWeight semibold)))
    (for (in name calibre-names)
      (+= labels (call TextLayout name font 260))
    )
    (+= labels (call TextLayout "CALIBRATION · PITCH AND STROKE TO SUB-PIXEL" font 320))
  )
)

(type _ Tally
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + clips Int)
  (prop + shadows Int)
  (fn-do + record _
    (param count Int)
    (param stroked Bool)
    (+= paths 1)
    (+= segments count)
    (if stroked
      (+= strokes 1)
    )
  )
  (fn-expr + snapshot SceneCounts :get
    (call SceneCounts paths segments strokes clips shadows)
  )
)

(fn-do + paint-clockwork-layer SceneCounts
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param settings ClockworkSettings)
  (param include-plates Bool)
  (param include-stopped Bool)
  (param include-live Bool)
  (let tally (call Tally))
  (if include-plates
    (for (in movement (. field movements))
      (call paint-plate kit canvas movement tally)
    )
  )
  (for (in movement (. field movements))
    (if (if-expr (call (. field is-live) (. movement index)) include-live include-stopped)
      (call paint-movement kit table canvas field movement settings tally)
    )
  )
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) null)
  (= (. canvas blend-mode) (. BlendMode normal))
  (return (. tally snapshot))
)

(fn-do _ paint-plate _
  (param kit ClockworkKit)
  (param canvas Canvas)
  (param movement Movement)
  (param tally Tally)
  (let x (. movement x))
  (let y (. movement y))
  (= (. canvas fill-color) plate-fill)
  (= (. canvas stroke-color) plate-rim)
  (= (. canvas stroke-width) 3.0)
  (call (. canvas circle) x y plate-radius)
  (call (. tally record) 4 true)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) plate-turning)
  (= (. canvas stroke-width) 0.6)
  (for (in turn (..< 0 12))
    (let around (* (as turn F64) (/ π 6)))
    (call (. canvas circle) (+ x (* 118 (call cos around))) (+ y (* 118 (call sin around))) 96)
    (call (. tally record) 4 true)
  )
  (= (. canvas stroke-color) plate-groove)
  (= (. canvas stroke-width) 1.4)
  (call (. canvas circle) x y (- plate-radius bezel-inset))
  (call (. tally record) 4 true)
  (for (in corner (..< 0 4))
    (let around (+ (/ π 4) (* (as corner F64) (/ π 2))))
    (let sx (+ x (* (- plate-radius 7) (call cos around))))
    (let sy (+ y (* (- plate-radius 7) (call sin around))))
    (= (. canvas fill-color) screw-head)
    (= (. canvas stroke-color) screw-slot)
    (= (. canvas stroke-width) 0.7)
    (call (. canvas circle) sx sy 4.4)
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) 1.1)
    (call (. canvas line) (- sx 3.0) (- sy 1.6) (+ sx 3.0) (+ sy 1.6))
    (call (. tally record) 4 true)
    (call (. tally record) 1 true)
  )
  (= (. canvas text-color) plate-ink)
  (call (. canvas draw-text) ([] (. kit labels) (. movement label)) (call Rect (- x 160) (+ y plate-radius 8) 320 16) (. TextAlignment center))
  (if (. movement is-calibration)
    (= (. canvas stroke-color) screw-head)
    (= (. canvas stroke-width) 0.25)
    (for (in ring (..< 0 12))
      (call (. canvas circle) (+ x 10) (+ y 170) (+ 6.0 (* (as ring F64) 3.5)))
      (call (. tally record) 4 true)
    )
  )
)

(fn-do _ paint-movement _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param movement Movement)
  (param settings ClockworkSettings)
  (param tally Tally)
  (if (. settings has-clips)
    (let reach (- plate-radius bezel-inset))
    (do-use (. canvas saved-state)
      (call (. canvas begin))
      (call (. canvas oval-path) (call Rect (- (. movement x) reach) (- (. movement y) reach) (* reach 2) (* reach 2)))
      (call (. canvas clip-path))
      (+= (. tally clips) 1)
      (call paint-mechanism kit table canvas field movement settings tally)
    )
    (else
      (call paint-mechanism kit table canvas field movement settings tally)
    )
  )
)

(fn-do _ paint-mechanism _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param movement Movement)
  (param settings ClockworkSettings)
  (param tally Tally)
  (let first (. movement first-gear))
  (for (in index (..< first (+ first (. movement gear-count))))
    (call paint-gear kit table canvas field ([] (. field gears) index) settings tally)
  )
  (if (. movement has-linkage)
    (call paint-linkage kit table canvas field movement settings tally)
  )
  (let first-balance (. movement first-balance))
  (for (in index (..< first-balance (+ first-balance (. movement balance-count))))
    (call paint-balance kit table canvas field ([] (. field balances) index) settings tally)
  )
)

(fn-do _ paint-gear _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param gear Gear)
  (param settings ClockworkSettings)
  (param tally Tally)
  (let x (. gear x))
  (let y (. gear y))
  (let radius (. gear radius))
  (let tip (. gear tip-radius))
  (let angle (call (. field gear-angle) gear))
  (let metal ([] (. kit palettes) (. gear palette)))
  (let stroked (or (. settings has-strokes) (. settings has-bevels)))
  (if (. settings has-shadows)
    (call (. canvas begin))
    (call (. canvas oval-path) (call Rect (- x tip) (- y tip) (* tip 2) (* tip 2)))
    (call (. canvas shadow-path) (if-expr (. gear is-coaxial) lifted-shadow gear-shadow))
    (+= (. tally shadows) 1)
  )
  (if (== (. settings motion) (. MotionMode transforms))
    (call paint-gear-stamped kit table canvas gear angle metal settings)
    (else
      (call paint-gear-traced kit canvas gear angle metal settings)
    )
  )
  (call (. tally record) ([] (. kit gear-segments) (. gear slot)) stroked)
  (if (. settings has-bevels)
    (call (. tally record) ([] (. kit gear-segments) (. gear slot)) true)
    (call (. tally record) ([] (. kit gear-segments) (. gear slot)) true)
    (+= (. tally clips) 2)
  )
  (if (. settings has-gradients)
    (+= (. tally clips) 1)
  )
  (= (. canvas stroke-color) null)
  (if (. settings has-glints)
    (= (. canvas blend-mode) (. BlendMode screen))
    (= (. canvas fill-color) glint-light)
    (call (. canvas circle) (- x (* radius 0.07)) (- y (* radius 0.09)) (* radius 0.18))
    (= (. canvas blend-mode) (. BlendMode multiply))
    (= (. canvas fill-color) glint-shade)
    (call (. canvas circle) (+ x (* radius 0.08)) (+ y (* radius 0.1)) (* radius 0.16))
    (= (. canvas blend-mode) (. BlendMode normal))
    (call (. tally record) 4 false)
    (call (. tally record) 4 false)
  )
  (= (. canvas fill-color) (if-expr (. gear is-coaxial) (. metal light) jewel-fill))
  (call (. canvas circle) x y (call max (* (. gear module) 0.45) (* radius 0.06)))
  (call (. tally record) 4 false)
)

(fn-do _ paint-gear-stamped _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param gear Gear)
  (param angle F64)
  (param metal MetalPalette)
  (param settings ClockworkSettings)
  (let slot (. gear slot))
  (let scale (/ (. gear module) base-module))
  (let matrix (call stamp-matrix (. gear x) (. gear y) angle scale scale))
  (let palette ([] (. kit stamp-palettes) (. gear palette)))
  (if (not (. settings has-gradients))
    (let ignored (call (. table paint-vector) ([] (. kit filled) slot) canvas palette matrix))
    (return)
  )
  (let reach (+ (* base-module (as (. gear teeth) F64) 0.5) base-module))
  (let cosine (call cos angle))
  (let sine (call sin angle))
  (let lx (* reach (+ (* light-x cosine) (* light-y sine))))
  (let ly (* reach (- (* light-y cosine) (* light-x sine))))
  (do-use (. canvas saved-state)
    (call (. canvas transform) matrix)
    (call (. ([] (. kit gear-paths) slot) clip) canvas (. kit rule))
    (call (. canvas fill-gradient) (call Rect (- reach) (- reach) (* reach 2) (* reach 2)) (call linear-gradient (call Point lx ly) (call Point (- lx) (- ly)) (. metal light) (. metal shade)))
  )
  (if (or (. settings has-strokes) (. settings has-bevels))
    (let ignored (call (. table paint-vector) ([] (. kit hollow) slot) canvas palette matrix))
  )
)

(fn-do _ paint-gear-traced _
  (param kit ClockworkKit)
  (param canvas Canvas)
  (param gear Gear)
  (param angle F64)
  (param metal MetalPalette)
  (param settings ClockworkSettings)
  (let x (. gear x))
  (let y (. gear y))
  (let tip (. gear tip-radius))
  (let scale (/ (. gear module) base-module))
  (let path (. kit scratch))
  (call (. path clear))
  (let ignored (call (. kit tracer trace-gear) path (. gear teeth) (. gear module) (. settings detail) (. settings cutouts) x y angle))
  (= (. canvas fill-color) (. metal body))
  (if (. settings has-gradients)
    (do-use (. canvas saved-state)
      (call (. path clip) canvas (. kit rule))
      (call (. canvas fill-gradient) (call Rect (- x tip) (- y tip) (* tip 2) (* tip 2)) (call linear-gradient (call Point (+ x (* tip light-x)) (+ y (* tip light-y))) (call Point (- x (* tip light-x)) (- y (* tip light-y))) (. metal light) (. metal shade)))
    )
    (= (. canvas fill-color) null)
  )
  (= (. canvas stroke-color) (only-if (. metal edge) (if (. settings has-strokes))))
  (= (. canvas stroke-width) (* gear-stroke scale))
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-join) (call gear-join (. gear teeth)))
  (if (or (not (. settings has-gradients)) (. settings has-strokes))
    (call (. path outline) canvas (. kit rule))
  )
  (if (. settings has-bevels)
    (= (. canvas stroke-join) (. LineJoin round))
    (= (. canvas stroke-color) (. metal light))
    (call paint-aligned-stroke canvas path (. kit rule) (. StrokeAlignment inside) (* inside-bevel scale))
    (= (. canvas stroke-color) (. metal shade))
    (call paint-aligned-stroke canvas path (. kit rule) (. StrokeAlignment outside) (* outside-bevel scale))
  )
)

(fn-do _ paint-linkage _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param movement Movement)
  (param settings ClockworkSettings)
  (param tally Tally)
  (let turn (call (. field gear-angle) ([] (. field gears) (. movement first-gear))))
  (let crank-x (+ (. movement x) (* (. movement crank-radius) (call cos turn))))
  (let crank-y (+ (. movement y) (* (. movement crank-radius) (call sin turn))))
  (let dx (- (. movement pivot-x) crank-x))
  (let dy (- (. movement pivot-y) crank-y))
  (let span (call max 1.0 (call sqrt (+ (* dx dx) (* dy dy)))))
  (let along (/ (+ (- (* crank-reach crank-reach) (* rocker-length rocker-length)) (* span span)) (* 2 span)))
  (let across (call sqrt (call max 0.0 (- (* crank-reach crank-reach) (* along along)))))
  (let joint-x (+ crank-x (/ (- (* along dx) (* across dy)) span)))
  (let joint-y (+ crank-y (/ (+ (* along dy) (* across dx)) span)))
  (let long-bar (. kit long-bar))
  (let short-bar (. kit short-bar))
  (if (and (== (. settings motion) (. MotionMode transforms)) long-bar short-bar)
    (let rocking (as (call atan2 (- joint-y (. movement pivot-y)) (- joint-x (. movement pivot-x))) F64))
    (let pushing (as (call atan2 (- joint-y crank-y) (- joint-x crank-x)) F64))
    (let rocker (call (. table paint-vector) short-bar canvas ([] (. kit stamp-palettes) 3) (call stamp-matrix (. movement pivot-x) (. movement pivot-y) rocking 1.0 1.0)))
    (let coupler (call (. table paint-vector) long-bar canvas ([] (. kit stamp-palettes) 5) (call stamp-matrix crank-x crank-y pushing 1.0 1.0)))
    (else
      (= (. canvas stroke-width) gear-stroke)
      (= (. canvas stroke-join) (. LineJoin round))
      (call paint-traced-bar kit canvas (. movement pivot-x) (. movement pivot-y) joint-x joint-y short-bar-half ([] (. kit palettes) 3) settings)
      (call paint-traced-bar kit canvas crank-x crank-y joint-x joint-y long-bar-half ([] (. kit palettes) 5) settings)
    )
  )
  (call (. tally record) 6 (. settings has-strokes))
  (call (. tally record) 6 (. settings has-strokes))
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) jewel-rim)
  (call (. canvas circle) crank-x crank-y 2.2)
  (call (. canvas circle) joint-x joint-y 2.2)
  (call (. canvas circle) (. movement pivot-x) (. movement pivot-y) 2.6)
  (call (. tally record) 4 false)
  (call (. tally record) 4 false)
  (call (. tally record) 4 false)
)

(fn-do _ paint-traced-bar _
  (param kit ClockworkKit)
  (param canvas Canvas)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param half F64)
  (param metal MetalPalette)
  (param settings ClockworkSettings)
  (let path (. kit scratch))
  (call (. path clear))
  (let ignored (call trace-bar path x0 y0 x1 y1 half))
  (= (. canvas fill-color) (. metal body))
  (= (. canvas stroke-color) (only-if (. metal edge) (if (. settings has-strokes))))
  (call (. path outline) canvas)
)

(fn-do _ paint-balance _
  (param kit ClockworkKit)
  (param table VectorGeometryTable)
  (param canvas Canvas)
  (param field ClockworkField)
  (param balance Balance)
  (param settings ClockworkSettings)
  (param tally Tally)
  (let x (. balance x))
  (let y (. balance y))
  (let radius (. balance radius))
  (let swing (call (. field balance-swing) balance))
  (let width ([] spring-widths (. balance spring-slot)))
  (let rim (. kit rim))
  (if (and (== (. settings motion) (. MotionMode transforms)) rim)
    (let scale (/ radius balance-size))
    (let matrix (call stamp-matrix x y swing scale scale))
    (let wheel (call (. table paint-vector) rim canvas ([] (. kit stamp-palettes) 2) matrix))
    (let spring (call (. table paint-vector) ([] (. kit springs) (. balance spring-slot)) canvas (. kit spring-palette) matrix))
    (else
      (let metal ([] (. kit palettes) 2))
      (let path (. kit scratch))
      (call (. path clear))
      (let ignored (call trace-rim path x y radius swing (== (. settings cutouts) (. CutoutMode winding))))
      (= (. canvas fill-color) (. metal body))
      (= (. canvas stroke-color) (only-if (. metal edge) (if (. settings has-strokes))))
      (= (. canvas stroke-width) gear-stroke)
      (= (. canvas stroke-join) (. LineJoin round))
      (call (. path outline) canvas (call rim-rule settings))
      (call (. path clear))
      (let pieces (call trace-spiral path x y (* radius 0.12) (* radius 0.62) swing (+ (* spring-turns 2 π) 0.8)))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) spring-blue)
      (= (. canvas stroke-width) width)
      (= (. canvas stroke-cap) (. LineCap round))
      (call (. path outline) canvas)
    )
  )
  (call (. tally record) 22 (. settings has-strokes))
  (call (. tally record) spring-pieces true)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) jewel-fill)
  (call (. canvas circle) x y (* radius 0.07))
  (call (. tally record) 4 false)
)

(fn-expr _ stamp-matrix Matrix
  (param tx F64)
  (param ty F64)
  (param angle F64)
  (param sx F64)
  (param sy F64)
  (call Matrix (* cosine sx) (* sine sx) (* (- sine) sy) (* cosine sy) tx ty)
  (where
    (lazy cosine (call cos angle))
    (lazy sine (call sin angle))
  )
)

(fn-expr _ gear-join LineJoin
  (param teeth Int)
  (if-expr (< teeth 16) (. LineJoin round) (. LineJoin miter))
)

(fn-expr _ rim-rule FillRule
  (param settings ClockworkSettings)
  (if-expr (== (. settings cutouts) (. CutoutMode winding)) (. FillRule nonzero) (. FillRule even-odd))
)

(fn-do _ gear-geometry VectorGeometry
  (param path Path)
  (param teeth Int)
  (param settings ClockworkSettings)
  (param is-filled Bool)
  (let reach (+ (* base-module (as teeth F64) 0.5) base-module 2))
  (let rule (if-expr (== (. settings cutouts) (. CutoutMode even-odd)) (. FillRule even-odd) (. FillRule nonzero)))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let body (if-expr is-filled (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0) none))
  (let edge (if-expr (. settings has-strokes) (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none))
  (let spans (call (of List VectorGeometrySpan)))
  (if (or is-filled (. settings has-strokes))
    (+= spans (call VectorGeometrySpan path body edge (only-if gear-stroke (if (. settings has-strokes))) (. LineCap round) (call gear-join teeth) rule))
  )
  (if (. settings has-bevels)
    (+= spans (call VectorGeometrySpan path none (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2) inside-bevel (. LineCap round) (. LineJoin round) rule (. StrokeAlignment inside)))
    (+= spans (call VectorGeometrySpan path none (call VectorGeometryPaint (. VectorGeometryPaintRole color) 3) outside-bevel (. LineCap round) (. LineJoin round) rule (. StrokeAlignment outside)))
  )
  (return (call VectorGeometry (call Rect (- reach) (- reach) (* reach 2) (* reach 2)) (call Rect (- reach) (- reach) (* reach 2) (* reach 2)) spans false false))
)

(fn-do _ rim-geometry VectorGeometry
  (param settings ClockworkSettings)
  (let path (call Path))
  (let ignored (call trace-rim path 0.0 0.0 balance-size 0.0 (== (. settings cutouts) (. CutoutMode winding))))
  (let reach (+ balance-size 2))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let body (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let edge (if-expr (. settings has-strokes) (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none))
  (let span (call VectorGeometrySpan path body edge (only-if gear-stroke (if (. settings has-strokes))) (. LineCap round) (. LineJoin round) (call rim-rule settings)))
  (return (call VectorGeometry (call Rect (- reach) (- reach) (* reach 2) (* reach 2)) (call Rect (- reach) (- reach) (* reach 2) (* reach 2)) (list span) false false))
)

(fn-do _ bar-geometry VectorGeometry
  (param length F64)
  (param half F64)
  (param settings ClockworkSettings)
  (let path (call Path))
  (let ignored (call trace-bar path 0.0 0.0 length 0.0 half))
  (let pad (+ half 2))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let body (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let edge (if-expr (. settings has-strokes) (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1) none))
  (let span (call VectorGeometrySpan path body edge (only-if gear-stroke (if (. settings has-strokes))) (. LineCap round) (. LineJoin round) (. FillRule nonzero)))
  (let box (call Rect (- pad) (- pad) (+ length (* pad 2)) (* pad 2)))
  (return (call VectorGeometry box box (list span) false false))
)

(fn-do _ spring-geometry VectorGeometry
  (param width F64)
  (let path (call Path))
  (let ignored (call trace-spiral path 0.0 0.0 (* balance-size 0.12) (* balance-size 0.62) 0.0 (+ (* spring-turns 2 π) 0.8)))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let ink (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let span (call VectorGeometrySpan path none ink width (. LineCap round) (. LineJoin round) (. FillRule nonzero)))
  (let box (call Rect (- balance-size) (- balance-size) (* balance-size 2) (* balance-size 2)))
  (return (call VectorGeometry box box (list span) false false))
)
