(import ./clockwork-train)
(import /graphics/path)
(import /math)
(blank)
(prop _ coarse-offsets _ (= (list -0.27 -0.12 0.12 0.27)))
(prop _ coarse-heights _ (= (list 0.0 1.0 1.0 0.0)))
(prop _ fine-offsets _ (= (list -0.29 -0.23 -0.17 -0.12 0.12 0.17 0.23 0.29)))
(prop _ fine-heights _ (= (list 0.0 0.36 0.78 1.0 1.0 0.78 0.36 0.0)))
(prop _ ultra-offsets _ (= (list -0.29 -0.25 -0.21 -0.17 -0.12 -0.04 0.04 0.12 0.17 0.21 0.25 0.29)))
(prop _ ultra-heights _ (= (list 0.0 0.22 0.5 0.78 1.0 1.0 1.0 1.0 0.78 0.5 0.22 0.0)))
(prop _ quarter-turn _ (= (/ π 2)))
(prop + spring-turns _ (= 5.5))
(prop + spring-pieces _ (= 36))

(type + GearTracer
  (prop _ xs (list F64))
  (prop _ ys (list F64))
  (fn-do + trace-gear Int
    (param path Path)
    (param teeth Int)
    (param module F64)
    (param detail Detail)
    (param cutouts CutoutMode)
    (param cx F64)
    (param cy F64)
    (param angle F64)
    (let offsets (call tooth-offsets detail))
    (let heights (call tooth-heights detail))
    (let per (. offsets length))
    (let pitch (/ (* 2 π) (as teeth F64)))
    (let radius (* module (as teeth F64) 0.5))
    (let root (- radius (* module 1.25)))
    (let depth (* module 2.25))
    (let total (* teeth per))
    (call (. xs clear))
    (call (. ys clear))
    (for (in tooth (..< 0 teeth))
      (for (in step (..< 0 per))
        (let around (+ angle (* (+ (as tooth F64) ([] offsets step)) pitch)))
        (let reach (+ root (* ([] heights step) depth)))
        (+= xs (+ cx (* reach (call cos around))))
        (+= ys (+ cy (* reach (call sin around))))
      )
    )
    (call (. path move-to) ([] xs 0) ([] ys 0))
    (if (== detail (. Detail coarse))
      (for (in index (..< 1 total))
        (call (. path line-to) ([] xs index) ([] ys index))
      )
      (else
        (for (in index (..< 0 total))
          (let before (% (+ index total -1) total))
          (let next (% (+ index 1) total))
          (let after (% (+ index 2) total))
          (call (. path cubic-curve-to)
            (block
              (arg (+ ([] xs index) (/ (- ([] xs next) ([] xs before)) 6)))
              (arg (+ ([] ys index) (/ (- ([] ys next) ([] ys before)) 6)))
              (arg (- ([] xs next) (/ (- ([] xs after) ([] xs index)) 6)))
              (arg (- ([] ys next) (/ (- ([] ys after) ([] ys index)) 6)))
              (arg ([] xs next))
              (arg ([] ys next))
            )
          )
        )
      )
    )
    (call (. path close))
    (let segments total)
    (return-if segments (if (== cutouts (. CutoutMode off))))
    (blank)
    (let reversed (== cutouts (. CutoutMode winding)))
    (call trace-circle path cx cy (call max (* module 0.7) (* radius 0.11)) angle reversed)
    (+= segments 4)
    (return-if segments (if (< teeth 16)))
    (blank)
    (let windows (if-expr (>= teeth 36) 6 5))
    (let span (/ (* 2 π) (as windows F64)))
    (for (in window (..< 0 windows))
      (let start (+ angle (* (as window F64) span)))
      (call trace-window path cx cy (* radius 0.3) (- root (* module 1.3)) start (+ start span) (* module 1.1) reversed)
      (+= segments 4)
    )
    (return segments)
  )
)

(fn-do + trace-rim Int
  (param path Path)
  (param cx F64)
  (param cy F64)
  (param radius F64)
  (param angle F64)
  (param reversed Bool)
  (call trace-circle path cx cy radius angle false)
  (let span (/ (* 2 π) 3))
  (for (in window (..< 0 3))
    (let start (+ angle (* (as window F64) span)))
    (call trace-window path cx cy (* radius 0.2) (* radius 0.84) start (+ start span) (* radius 0.075) reversed)
  )
  (return 22)
)

(fn-do + trace-bar Int
  (param path Path)
  (param x0 F64)
  (param y0 F64)
  (param x1 F64)
  (param y1 F64)
  (param half F64)
  (let heading (as (call atan2 (- y1 y0) (- x1 x0)) F64))
  (let left (+ heading quarter-turn))
  (let right (- heading quarter-turn))
  (call (. path move-to) (+ x0 (* half (call cos left))) (+ y0 (* half (call sin left))))
  (call (. path line-to) (+ x1 (* half (call cos left))) (+ y1 (* half (call sin left))))
  (call arc-to path x1 y1 half left right)
  (call (. path line-to) (+ x0 (* half (call cos right))) (+ y0 (* half (call sin right))))
  (call arc-to path x0 y0 half right (- right π))
  (call (. path close))
  (return 6)
)

(fn-do + trace-spiral Int
  (param path Path)
  (param cx F64)
  (param cy F64)
  (param inner F64)
  (param outer F64)
  (param start F64)
  (param finish F64)
  (let sweep (- finish start))
  (let rise (- outer inner))
  (let step (/ 1.0 (as spring-pieces F64)))
  (let third (/ step 3))
  (let last-x 0.0)
  (let last-y 0.0)
  (let last-dx 0.0)
  (let last-dy 0.0)
  (for (in piece (.. 0 spring-pieces))
    (let along (* (as piece F64) step))
    (let around (+ start (* sweep along)))
    (let reach (+ inner (* rise along)))
    (let cosine (call cos around))
    (let sine (call sin around))
    (let x (+ cx (* reach cosine)))
    (let y (+ cy (* reach sine)))
    (let dx (* (- (* rise cosine) (* reach sweep sine)) third))
    (let dy (* (+ (* rise sine) (* reach sweep cosine)) third))
    (if (== piece 0)
      (call (. path move-to) x y)
      (else
        (call (. path cubic-curve-to) (+ last-x last-dx) (+ last-y last-dy) (- x dx) (- y dy) x y)
      )
    )
    (= last-x x)
    (= last-y y)
    (= last-dx dx)
    (= last-dy dy)
  )
  (return spring-pieces)
)

(fn-do _ trace-circle _
  (param path Path)
  (param cx F64)
  (param cy F64)
  (param radius F64)
  (param start F64)
  (param reversed Bool)
  (let turn (if-expr reversed (- (* 2 π)) (* 2 π)))
  (call (. path move-to) (+ cx (* radius (call cos start))) (+ cy (* radius (call sin start))))
  (call arc-to path cx cy radius start (+ start turn))
  (call (. path close))
)

(fn-do _ trace-window _
  (param path Path)
  (param cx F64)
  (param cy F64)
  (param inner F64)
  (param outer F64)
  (param start F64)
  (param finish F64)
  (param half F64)
  (param reversed Bool)
  (let outer-gap (/ half outer))
  (let inner-gap (/ half inner))
  (let outer-from (if-expr reversed (- finish outer-gap) (+ start outer-gap)))
  (let outer-to (if-expr reversed (+ start outer-gap) (- finish outer-gap)))
  (let inner-from (if-expr reversed (+ start inner-gap) (- finish inner-gap)))
  (let inner-to (if-expr reversed (- finish inner-gap) (+ start inner-gap)))
  (call (. path move-to) (+ cx (* outer (call cos outer-from))) (+ cy (* outer (call sin outer-from))))
  (call arc-to path cx cy outer outer-from outer-to)
  (call (. path line-to) (+ cx (* inner (call cos inner-from))) (+ cy (* inner (call sin inner-from))))
  (call arc-to path cx cy inner inner-from inner-to)
  (call (. path close))
)

(fn-do _ arc-to _
  (param path Path)
  (param cx F64)
  (param cy F64)
  (param radius F64)
  (param start F64)
  (param finish F64)
  (let pieces (call max 1 (as (call ceil (/ (call abs (- finish start)) (+ quarter-turn 0.001))) Int)))
  (let step (/ (- finish start) (as pieces F64)))
  (let handle (* radius (/ 4.0 3.0) (call tan (/ step 4))))
  (for (in piece (..< 0 pieces))
    (let from (+ start (* (as piece F64) step)))
    (let to (+ from step))
    (let x0 (+ cx (* radius (call cos from))))
    (let y0 (+ cy (* radius (call sin from))))
    (let x1 (+ cx (* radius (call cos to))))
    (let y1 (+ cy (* radius (call sin to))))
    (call (. path cubic-curve-to)
      (block
        (arg (- x0 (* handle (call sin from))))
        (arg (+ y0 (* handle (call cos from))))
        (arg (+ x1 (* handle (call sin to))))
        (arg (- y1 (* handle (call cos to))))
        (arg x1)
        (arg y1)
      )
    )
  )
)

(fn-expr _ tooth-offsets (list F64)
  (param detail Detail)
  (match detail
    (case .coarse
      coarse-offsets
    )
    (case .fine
      fine-offsets
    )
    (default
      ultra-offsets
    )
  )
)

(fn-expr _ tooth-heights (list F64)
  (param detail Detail)
  (match detail
    (case .coarse
      coarse-heights
    )
    (case .fine
      fine-heights
    )
    (default
      ultra-heights
    )
  )
)
