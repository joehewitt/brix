(import ./clockwork-camera)
(import ./clockwork-paint)
(import ./clockwork-train)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui)
(import /math)
(import /time/duration)
(blank)
(prop _ precise-zoom-rate _ (= 0.01))
(prop _ line-zoom-rate _ (= 0.15))
(prop _ wheel-line _ (= 40.0))
(prop _ click-slop _ (= 4.0))
(prop _ longest-step _ (= 0.1))
(prop _ sample-period _ (= 0.5))
(prop _ latency-lag _ (= 8))
(prop _ no-counts _ (= (call SceneCounts 0 0 0 0 0)))
(prop + empty-frame-times _ (= (call FrameTimes -1 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns 0ns)))

(type + ClockworkSample (is Tuple)
  (prop + zoom F64)
  (prop + gears Int)
  (prop + movements Int)
  (prop + live-movements Int)
  (prop + paths Int)
  (prop + segments Int)
  (prop + strokes Int)
  (prop + clips Int)
  (prop + shadows Int)
  (prop + gear-pixels F64)
  (prop + frames-per-second F64)
  (prop + frames Int)
  (prop + times FrameTimes)
  (prop + latency-ms F64)
  (prop + gpu-ms F64)
  (prop + draw-calls I64)
)

(type _ ClockworkStaticLayer (is Box)
  (prop + owner (? ClockworkView) (= null))
  (fn-expr + content-transform _ :get
    (?. owner camera-transform)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let view owner)
    (return-if (if (not view)))
    (call (. view paint-static-layer) canvas markup-batch-root)
  )
)

(type _ ClockworkDynamicLayer (is Box)
  (prop + owner (? ClockworkView) (= null))
  (fn-expr + content-transform _ :get
    (?. owner camera-transform)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let view owner)
    (return-if (if (not view)))
    (call (. view paint-dynamic-layer) canvas markup-batch-root)
  )
)

(type + ClockworkView (is Box)
  (prop + gear-count _ (= 1000))
  (prop + animated-share _ (= 50))
  (prop + motion-mode _ (= (. MotionMode transforms)))
  (prop + detail _ (= (. Detail fine)))
  (prop + cutouts _ (= (. CutoutMode even-odd)))
  (prop + has-strokes _ (= true))
  (prop + has-bevels _ (= false))
  (prop + has-gradients _ (= false))
  (prop + has-glints _ (= false))
  (prop + has-shadows _ (= false))
  (prop + has-clips _ (= false))
  (prop + split-layers _ (= true))
  (prop + is-touring _ (= false))
  (prop + is-paused _ (= false))
  (event + measured ClockworkSample)
  (prop _ camera _ (= (call ClockworkCamera)))
  (prop _ field _ (= (call ClockworkField 1000 50)))
  (prop _ kit (? ClockworkKit) (= null))
  (prop _ tour-clock _ (= 0.0))
  (prop _ pressed-at (? Point) (= null))
  (prop _ is-panning _ (= false))
  (prop _ static-counts _ (= no-counts))
  (prop _ dynamic-counts _ (= no-counts))
  (prop _ was-active _ (= false))
  (prop _ last-frame _ (= -1))
  (prop _ last-done _ (= -1))
  (prop _ sampled-time _ (= 0.0))
  (prop _ active-time _ (= 0.0))
  (prop _ active-ticks _ (= 0))
  (prop _ frame-count _ (= 0))
  (prop _ frame-times _ (= empty-frame-times))
  (prop _ latency-nanos _ (= 0))
  (prop _ latency-count _ (= 0))
  (prop _ gpu-frames _ (= 0))
  (prop _ gpu-nanos _ (= 0))
  (prop _ draw-calls _ (= 0))
  (depends rebuild-field gear-count animated-share)
  (depends restyle motion-mode detail cutouts has-strokes has-bevels has-gradients has-glints has-shadows has-clips split-layers)
  (depends start-tour is-touring)
  (prop _ running _
    (machine
      (state live
        (for (on tick frames)
          (call advance (call min longest-step (as (as (. tick delta) Seconds) F64)))
        )
      )
    )
  )
  (content
    (<> This
      (<> ClockworkStaticLayer (id: static-layer) (• cover .parent)
        (= owner this)
      )
      (<> ClockworkDynamicLayer (id: dynamic-layer) (• cover .parent)
        (= owner this)
        (= drag-cursor (. CursorStyle closed-hand))
      )
      (for (on event scroll)
        (= is-touring false)
        (let modifiers (. event modifiers))
        (if (or (. modifiers command) (. modifiers control) (. modifiers option))
          (let rate (if-expr (. event is-precise) precise-zoom-rate line-zoom-rate))
          (call (. camera zoom-by) (call exp (* (- (. event delta-y)) rate)) (. event point))
          (else
            (let line (if-expr (. event is-precise) 1.0 wheel-line))
            (call (. camera pan) (call Point (* (- (. event delta-x)) line) (* (- (. event delta-y)) line)))
          )
        )
        (call sync-transforms)
        (call (. event cancel))
      )
      (for (on event magnify)
        (= is-touring false)
        (call (. camera pinch) (. event scale) (. event point))
        (call sync-transforms)
        (call (. event cancel))
      )
      (for (on event pointer-down)
        (if (== (. event button) (. PointerButton primary))
          (= pressed-at (. event point))
          (= is-panning false)
          (call (. event cancel))
        )
      )
      (for (on event pointer-drag)
        (let origin pressed-at)
        (if origin
          (if (or is-panning (>= (call (. origin distance) (. event point)) click-slop))
            (= is-touring false)
            (= is-panning true)
            (call (. camera pan) (. event delta))
            (call sync-transforms)
          )
          (call (. event cancel))
        )
      )
      (for (on event pointer-up)
        (let origin pressed-at)
        (if (and origin (not is-panning) (not (. event is-interrupted)))
          (if (call (. field poke) (call (. camera world-point) (. event point)))
            (call invalidate-all-layers)
          )
        )
        (= pressed-at null)
        (= is-panning false)
      )
    )
  )
  (fn-expr + camera-transform Matrix :get
    (. camera transform)
  )
  (fn-expr _ settings ClockworkSettings :get
    (call ClockworkSettings motion-mode detail cutouts has-strokes has-bevels has-gradients has-glints has-shadows has-clips)
  )
  (fn-do + fit _
    (= is-touring false)
    (call (. camera fit))
  )
  (fn-do + paint-static-layer _
    (param canvas Canvas)
    (param batch-root _)
    (if (and (not split-layers) (> (. field live-count) 0))
      (= static-counts no-counts)
      (return)
    )
    (let table (call vector-geometry-table-for batch-root))
    (let look settings)
    (let assets (?? kit (call ClockworkKit table look)))
    (= kit assets)
    (= static-counts (call paint-clockwork-layer assets table canvas field look true true false))
  )
  (fn-do + paint-dynamic-layer _
    (param canvas Canvas)
    (param batch-root _)
    (if (== (. field live-count) 0)
      (= dynamic-counts no-counts)
      (return)
    )
    (let table (call vector-geometry-table-for batch-root))
    (let look settings)
    (let assets (?? kit (call ClockworkKit table look)))
    (= kit assets)
    (= dynamic-counts (call paint-clockwork-layer assets table canvas field look (not split-layers) (not split-layers) true))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (if (call (. camera place) (. bounds size) (. field extent))
      (call sync-transforms)
    )
  )
  (fn-do _ rebuild-field _
    (= field (call ClockworkField gear-count animated-share))
    (let ignored (call (. camera place) (. bounds size) (. field extent)))
    (call invalidate-all-layers)
  )
  (fn-do _ restyle _
    (= kit null)
    (call invalidate-all-layers)
  )
  (fn-do _ invalidate-all-layers _
    (call (. static-layer invalidate-paint))
    (call (. dynamic-layer invalidate-paint))
  )
  (fn-do _ sync-transforms _
    (call (. static-layer invalidate-content-transform))
    (call (. dynamic-layer invalidate-content-transform))
  )
  (fn-do _ start-tour _
    (if is-touring
      (= tour-clock (* tour-period 0.5))
    )
  )
  (fn-do _ advance _
    (param seconds F64)
    (let placed (call (. camera place) (. bounds size) (. field extent)))
    (let moved (call move-camera seconds))
    (if (or moved placed)
      (call sync-transforms)
    )
    (let animating (and (not is-paused) (> (. field live-count) 0)))
    (if animating
      (if (call (. field advance) seconds)
        (call invalidate-all-layers)
        (else
          (call (. dynamic-layer invalidate-paint))
        )
      )
    )
    (call sample seconds (or moved animating))
  )
  (fn-do _ move-camera Bool
    (param seconds F64)
    (if is-touring
      (+= tour-clock seconds)
      (call (. camera tour) tour-clock)
      (return true)
    )
    (return (call (. camera step) seconds))
  )
  (fn-do _ sample _
    (param seconds F64)
    (param active Bool)
    (let root window)
    (return-if (if (not root)))
    (blank)
    (let host (as root Window))
    (let frame (. host last-metal-frame-id))
    (if (and was-active (!= frame last-frame))
      (+= frame-count 1)
      (let times (. host last-frame-times))
      (if times
        (= frame-times (call summed-times frame-times times))
      )
      (let latency (call (. host metal-frame-input-latency-nanos) (- frame latency-lag)))
      (if (>= latency 0)
        (+= latency-nanos latency)
        (+= latency-count 1)
      )
      (= draw-calls (. host metal-draw-calls))
    )
    (= last-frame frame)
    (let done (. host completed-metal-frame-id))
    (if (and was-active (!= done last-done))
      (let spent (call (. host metal-frame-gpu-nanos) done))
      (if (>= spent 0)
        (+= gpu-frames 1)
        (+= gpu-nanos spent)
      )
    )
    (= last-done done)
    (if active
      (+= active-time seconds)
      (+= active-ticks 1)
    )
    (= was-active active)
    (+= sampled-time seconds)
    (return-if (if (< sampled-time sample-period)))
    (blank)
    (if (> frame-count 0)
      (<- measured
        (call ClockworkSample
          (block
            (arg (. camera scale))
            (arg (. field gears length))
            (arg (. field movements length))
            (arg (. field live-count))
            (arg (+ (. static-counts paths) (. dynamic-counts paths)))
            (arg (+ (. static-counts segments) (. dynamic-counts segments)))
            (arg (+ (. static-counts strokes) (. dynamic-counts strokes)))
            (arg (+ (. static-counts clips) (. dynamic-counts clips)))
            (arg (+ (. static-counts shadows) (. dynamic-counts shadows)))
            (arg (* (. field mean-diameter) (. camera scale)))
            (arg (if-expr (> active-time 0) (/ (as active-ticks F64) active-time) 0.0))
            (arg frame-count)
            (arg frame-times)
            (arg (if-expr (> latency-count 0) (/ (as latency-nanos F64) (* (as latency-count F64) 1000000)) -1.0))
            (arg (if-expr (> gpu-frames 0) (/ (as gpu-nanos F64) (* (as gpu-frames F64) 1000000)) 0.0))
            (arg draw-calls)
          )
        )
      )
    )
    (= sampled-time 0.0)
    (= active-time 0.0)
    (= active-ticks 0)
    (= frame-count 0)
    (= frame-times empty-frame-times)
    (= latency-nanos 0)
    (= latency-count 0)
    (= gpu-frames 0)
    (= gpu-nanos 0)
  )
)

(fn-expr _ summed-times FrameTimes
  (param sum FrameTimes)
  (param times FrameTimes)
  (call FrameTimes
    (block
      (arg (. times frame))
      (arg (+ (. sum input) (. times input)))
      (arg (+ (. sum tick) (. times tick)))
      (arg (+ (. sum update) (. times update)))
      (arg (+ (. sum layout) (. times layout)))
      (arg (+ (. sum record) (. times record)))
      (arg (+ (. sum encode) (. times encode)))
      (arg (+ (. sum walk) (. times walk)))
      (arg (+ (. sum native) (. times native)))
      (arg (+ (. sum commit) (. times commit)))
      (arg (+ (. sum total) (. times total)))
    )
  )
)
