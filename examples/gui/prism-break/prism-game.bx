(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop + prism-board-size _ (= (call Dimensions 832 578)))
(prop + prism-brick-size _ (= (call Dimensions 70 28)))
(prop + prism-paddle-size _ (= (call Dimensions 128 14)))
(prop + prism-paddle-top _ (= 534.0))
(prop + prism-ball-radius _ (= 8.0))
(prop + prism-lives _ (= 3))
(prop + prism-flavors _ (= 6))
(prop _ brick-columns _ (= 10))
(prop _ brick-rows _ (= 5))
(prop _ brick-origin _ (= (call Point 65 37)))
(prop _ brick-pitch _ (= (call Point 78 42)))
(prop _ paddle-reach _ (= (+ (/ (. prism-paddle-size width) 2) 4)))
(prop _ paddle-spread Radians (= 1.05rad))
(prop _ split-angle Radians (= 0.42rad))
(prop _ drain-y _ (= 600.0))
(prop _ chase-speed _ (= 1200.0))
(prop _ steer-speed _ (= 760.0))
(prop _ top-speed _ (= 820.0))
(prop _ shard-gravity _ (= 110.0))
(prop _ ball-limit _ (= 5))
(prop _ shard-limit _ (= 220))
(prop _ trail-length _ (= 16))
(prop _ trail-interval Seconds (= 16ms))
(prop _ longest-frame Seconds (= 50ms))
(prop _ substeps-per-second _ (= 240.0))

(type + PrismEnding (is Union)
  (variant cleared)
  (variant missed)
  (variant lost)
)

(type + PrismBall
  (prop + place Point)
  (prop + velocity Point)
  (prop + flavor Int)
  (prop + trail _ (= (call (of List Point))))
  (prop + sampled-at Seconds)
  (fn-do + This _
    (param place _)
    (param velocity _)
    (param flavor _)
  )
)

(type + PrismBrick
  (prop + center Point)
  (prop + flavor Int)
  (prop + health Int)
  (prop + is-splitter Bool)
  (prop + hit-at (? Seconds))
  (fn-do + This _
    (param center _)
    (param flavor _)
    (param health _)
    (param is-splitter _)
  )
  (fn-expr + rect Rect :get
    (call Rect (- (. center x) (/ width 2)) (- (. center y) (/ height 2)) width height)
    (where
      (lazy width (. prism-brick-size width))
      (lazy height (. prism-brick-size height))
    )
  )
)

(type + PrismShard
  (prop + place Point)
  (prop + velocity Point)
  (prop + angle Radians)
  (prop + spin Float)
  (prop + size Float)
  (prop + flavor Int)
  (prop + born Seconds)
  (prop + lifetime Seconds)
  (fn-do + This _
    (param place _)
    (param velocity _)
    (param angle _)
    (param spin _)
    (param size _)
    (param flavor _)
    (param born _)
    (param lifetime _)
  )
)

(type + PrismGame
  (event + endings PrismEnding)
  (event + jolts Length)
  (prop + bricks _ (= (call (of List PrismBrick))))
  (prop + balls _ (= (call (of List PrismBall))))
  (prop + shards _ (= (call (of List PrismShard))))
  (prop + score Int)
  (prop + best Int)
  (prop + lives Int)
  (prop + level Int)
  (prop + clock Seconds)
  (prop + paddle-x Float)
  (prop + paddle-speed Float)
  (prop + paddle-hit-at (? Seconds))
  (prop + split-at (? Seconds))
  (prop + steer Int)
  (blank)
  (prop _ paddle-target Float)
  (prop _ combo Int)
  (fn-do + This _
    (call reset)
  )
  (fn-expr + launch-velocity Point :get
    (call upward (call clamp (+ (* paddle-speed 0.25) 140) (* speed -0.65) (* speed 0.65)) speed)
    (where
      (lazy speed (+ 460 (* (call min 5 (- level 1)) 25.0)))
    )
  )
  (fn-expr + paddle-rect Rect :get
    (call Rect (- paddle-x (/ width 2)) prism-paddle-top width (. prism-paddle-size height))
    (where
      (lazy width (. prism-paddle-size width))
    )
  )
  (fn-do + reset _
    (= score 0)
    (= lives prism-lives)
    (= level 1)
    (= paddle-x (/ (. prism-board-size width) 2))
    (= paddle-target paddle-x)
    (= paddle-speed 0)
    (call (. shards clear))
    (call build-level)
  )
  (fn-do + advance-level _
    (+= level 1)
    (call build-level)
  )
  (fn-do + serve _
    (= combo 0)
    (= balls (list (call PrismBall (call Point paddle-x rest-y) (call Point 0 0) 0)))
  )
  (fn-do + launch _
    (= (. balls head velocity) launch-velocity)
    (= paddle-hit-at clock)
  )
  (fn-do + aim _
    (param x Float)
    (= paddle-target (call clamp x paddle-reach (- (. prism-board-size width) paddle-reach)))
  )
  (fn-do + drift _
    (param elapsed Seconds)
    (call tick (call frame-seconds elapsed))
    (call expire)
  )
  (fn-do + hold _
    (param elapsed Seconds)
    (call drift elapsed)
    (= (. balls head place) (call Point paddle-x rest-y))
  )
  (fn-do + play _
    (param elapsed Seconds)
    (let dt (call frame-seconds elapsed))
    (let steps (call max 1 (as (call ceil (* dt substeps-per-second)) Int)))
    (let step (/ dt steps))
    (for (in _ (..< 0 steps))
      (call tick step)
      (for (in index (..< 0 (. balls length)))
        (call advance ([] balls index) step)
      )
      (= balls (call (of List PrismBall) (in each balls (when (< (. each place y) drain-y)))))
      (let ending (call finished-round))
      (if ending
        (call expire)
        (<- endings ending)
        (return)
      )
    )
    (call expire)
  )
  (fn-expr _ rest-y Float :get
    (- prism-paddle-top prism-ball-radius 2)
  )
  (fn-do _ build-level _
    (= bricks (call (of List PrismBrick) (call flat-map (in (call brick-row each) (..< 0 brick-rows)))))
    (call serve)
  )
  (fn-expr _ brick-row (list PrismBrick)
    (param row Int)
    (call (of List PrismBrick) (in (call brick-at row each) (..< 0 brick-columns)))
  )
  (fn-expr _ brick-at PrismBrick
    (param row Int)
    (param column Int)
    (call PrismBrick center flavor (if-expr (or is-splitter is-armored) 2 1) is-splitter)
    (where
      (lazy center (+ brick-origin (call Point (* column (. brick-pitch x)) (* row (. brick-pitch y)))))
      (lazy flavor (% (- (+ column (/ row 2) level) 1) prism-flavors))
      (lazy is-splitter (and (== row 2) (or (== column 3) (== column 6))))
      (lazy is-armored (and (== row 0) (> level 1)))
    )
  )
  (fn-do _ tick _
    (param dt Float)
    (+= clock dt)
    (call move-paddle dt)
    (for (in shard shards)
      (+= (. shard velocity) (call Point 0 (* shard-gravity dt)))
      (+= (. shard place) (* (. shard velocity) dt))
      (+= (. shard angle) (* (. shard spin) dt))
    )
  )
  (fn-do _ expire _
    (= shards (call (of List PrismShard) (in each shards (when (< (- clock (. each born)) (. each lifetime))))))
  )
  (fn-do _ move-paddle _
    (param dt Float)
    (if (!= steer 0)
      (call aim (+ paddle-x (* steer steer-speed dt)))
    )
    (let previous paddle-x)
    (+= paddle-x (call clamp (- paddle-target paddle-x) (* (- chase-speed) dt) (* chase-speed dt)))
    (= paddle-speed (/ (- paddle-x previous) dt))
  )
  (fn-do _ finished-round (? PrismEnding)
    (if (== (. bricks length) 0)
      (call (. balls clear))
      (return .cleared)
    )
    (return-if null (if (> (. balls length) 0)))
    (-= lives 1)
    (<- jolts 4)
    (return (if-expr (== lives 0) .lost .missed))
  )
  (fn-do _ advance _
    (param ball PrismBall)
    (param dt Float)
    (let before (. ball place))
    (+= (. ball place) (* (. ball velocity) dt))
    (call sample-trail ball)
    (call rebound-walls ball)
    (call rebound-paddle ball before)
    (let struck (call deflect ball))
    (if struck
      (call strike struck ball)
    )
  )
  (fn-do _ sample-trail _
    (param ball PrismBall)
    (return-if (if (< (- clock (. ball sampled-at)) trail-interval)))
    (= (. ball sampled-at) clock)
    (+= (. ball trail) (. ball place))
    (if (> (. ball trail length) trail-length)
      (call (. ball trail pop-first))
    )
  )
  (fn-do _ rebound-walls _
    (param ball PrismBall)
    (let place (. ball place))
    (let velocity (. ball velocity))
    (let right (- (. prism-board-size width) prism-ball-radius))
    (let vx
      (block
        (case? (< (. place x) prism-ball-radius)
          (call abs (. velocity x))
        )
        (case? (> (. place x) right)
          (- (call abs (. velocity x)))
        )
        (default
          (. velocity x)
        )
      )
    )
    (let vy (if-expr (< (. place y) prism-ball-radius) (call abs (. velocity y)) (. velocity y)))
    (= (. ball velocity) (call Point vx vy))
    (= (. ball place) (call Point (call clamp (. place x) prism-ball-radius right) (call max (. place y) prism-ball-radius)))
  )
  (fn-do _ rebound-paddle _
    (param ball PrismBall)
    (param before Point)
    (let contact (- prism-paddle-top prism-ball-radius))
    (let half-width (/ (. prism-paddle-size width) 2))
    (let offset (- (. ball place x) paddle-x))
    (let falling (> (. ball velocity y) 0))
    (let crossed (and (<= (. before y) contact) (>= (. ball place y) contact)))
    (return-if (if (or (not falling) (not crossed) (>= (call abs offset) (+ half-width prism-ball-radius)))))
    (let speed (call min top-speed (+ (. ball velocity length) 10)))
    (let angle (* (call clamp (/ offset half-width) -1.0 1.0) paddle-spread))
    (let english (+ (* (call sin angle) speed) (* paddle-speed 0.12)))
    (= (. ball velocity) (call upward (call clamp english (* speed -0.92) (* speed 0.92)) speed))
    (= (. ball place) (call Point (. ball place x) contact))
    (= paddle-hit-at clock)
    (= combo 0)
    (call burst (call Point (. ball place x) prism-paddle-top) (. ball flavor) 5)
  )
  (fn-do _ deflect (? PrismBrick)
    (param ball PrismBall)
    (for (in brick bricks)
      (return-if brick (if (call bounce ball brick)))
    )
    (return null)
  )
  (fn-do _ bounce Bool
    (param ball PrismBall)
    (param brick PrismBrick)
    (let rect (. brick rect))
    (let nearest (call (. (call (. ball place max) (. rect top-left)) min) (. rect bottom-right)))
    (let offset (- (. ball place) nearest))
    (let distance (. offset length))
    (return-if false (if (>= distance prism-ball-radius)))
    (let fallback (call Point 0 (if-expr (> (. ball velocity y) 0) -1 1)))
    (let normal (if-expr (> distance 0.001) (/ offset distance) fallback))
    (let approach (call (. ball velocity dot) normal))
    (return-if false (if (>= approach 0)))
    (+= (. ball place) (* normal (+ (- prism-ball-radius distance) 0.1)))
    (let reflected (- (. ball velocity) (* normal (* 2 approach))))
    (let speed (call min top-speed (+ (. reflected length) 3)))
    (let rise (call max (call abs (. reflected y)) (* speed 0.24)))
    (let vy (if-expr (< (. reflected y) 0) (- rise) rise))
    (= (. ball velocity) (call with-length (call Point (. reflected x) vy) speed))
    (return true)
  )
  (fn-do _ strike _
    (param brick PrismBrick)
    (param ball PrismBall)
    (-= (. brick health) 1)
    (= (. brick hit-at) clock)
    (= (. ball flavor) (. brick flavor))
    (<- jolts 1.5)
    (if (> (. brick health) 0)
      (+= score 10)
      (call burst (. ball place) (. brick flavor) 4)
      (else
        (-= bricks brick)
        (+= combo 1)
        (+= score (* 50 (call min 5 (+ 1 (/ combo 5)))))
        (call burst (. brick center) (. brick flavor) (if-expr (. brick is-splitter) 24 12))
        (if (. brick is-splitter)
          (call split ball)
        )
      )
    )
    (= best (call max best score))
  )
  (fn-do _ split _
    (param ball PrismBall)
    (= split-at clock)
    (<- jolts 4)
    (for (in turn (list -1 1) (while (< (. balls length) ball-limit)))
      (let velocity (call (. ball velocity rotate) (* turn split-angle)))
      (let flavor (% (+ (. ball flavor) (if-expr (< turn 0) 2 4)) prism-flavors))
      (+= balls (call PrismBall (. ball place) velocity flavor))
    )
  )
  (fn-do _ burst _
    (param place Point)
    (param flavor Int)
    (param count Int)
    (for (in _ (..< 0 count))
      (let angle (call random 0rad (* π 2)))
      (let velocity (* (call Point (call cos angle) (call sin angle)) (call random 45.0 255.0)))
      (+= shards
        (call PrismShard
          (block
            (arg place)
            (arg velocity)
            (arg angle)
            (arg (call random -5.0 5.0))
            (arg (call random 2.0 7.0))
            (arg flavor)
            (arg clock)
            (arg (call random 300ms 800ms))
          )
        )
      )
    )
    (while (> (. shards length) shard-limit)
      (call (. shards pop-first))
    )
  )
)

(fn-expr + prism-fade Float
  (param now Seconds)
  (param since (? Seconds))
  (param length Seconds)
  (match since
    (case= null
      0.0
    )
    (default
      (call clamp-unit (- 1 (as (/ (- now since) length) Float)))
    )
  )
)

(fn-expr _ frame-seconds Float
  (param elapsed Seconds)
  (call min elapsed longest-frame)
)

(fn-expr _ upward Point
  (param vx Float)
  (param speed Float)
  (call Point vx (- (call sqrt (- (* speed speed) (* vx vx)))))
)

(fn-expr _ with-length Point
  (param vector Point)
  (param length Float)
  (* vector (/ length (. vector length)))
)
