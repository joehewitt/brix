(import ./prism-art)
(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)
(blank)
(prop + prism-cyan _ (= (call prism-color 0)))

(style PrismTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxTransform)
  (using GUIBoxWindowDrag)
  (rule prism-panel (• flex-col) (• text prism-ink)
    (= background (call PrismSky))
    (= focus-mode (. FocusMode keys))
    (= focus-default true)
    (= focus-home true)
  )
  (rule prism-header (• flex-row) (• items-start) (• h 122) (• px 32) (• pt 24)
    (= window-draggable true)
  )
  (rule prism-side (• flex-col) (• w 180))
  (rule prism-title (• flex 1) (• h 84)
    (= font-family "Avenir Next")
    (= font-size 56)
    (= font-weight (. FontWeight heavy))
    (= text-alignment (. TextAlignment center))
  )
  (rule prism-score (• h 40)
    (= font-size 28)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment right))
  )
  (rule prism-caption (• text prism-muted) (• h 20)
    (= font-size 11)
    (= text-alignment (. TextAlignment right))
  )
  (rule prism-board (• flex 1) (• mx 64)
    (= motion gui-motion-smooth)
    (when-style #is-dimmed
      (= opacity 0.3%%)
    )
  )
  (rule prism-footer (• flex-row) (• h 100) (• pl 74) (• pr 28) (• pb 20))
  (rule prism-lives (• flex-row) (• gap 12) (• pt 22))
  (rule prism-life (• h 16)
    (= font-size 13)
    (= motion gui-motion-smooth)
  )
  (rule prism-help (• flex-col) (• justify-end) (• w 240))
  (rule prism-banner (• absolute) (• center .parent) (• flex-col) (• w 440)
    (when-style #is-entering
      (= animation pop-in)
    )
    (when-style #is-leaving
      (= animation popup-out)
    )
  )
  (rule prism-banner-title (• h 56)
    (= font-size 39)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment center))
  )
  (rule prism-banner-detail (• h 40)
    (= font-size 25)
    (= text-alignment (. TextAlignment center))
  )
)
