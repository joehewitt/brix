(import ./prism-panel)
(import /graphics/color)
(import /graphics/primitives)
(import /gui)
(import /lang/product/mac-app)
(blank)

(main
  (<> MacApp
    (= id "com.yumi.prism-break")
    (= name "Prism Break")
  )
  (blank)
  (<> App
    (<> Window (• flex-col)
      (= appearance (. WindowAppearance dark))
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= title "Prism Break")
      (= size (call Dimensions 960 800))
      (blank)
      (<> PrismPanel (• flex 1))
    )
  )
)
