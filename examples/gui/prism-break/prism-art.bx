(import ./prism-game)
(import ./prism-material)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/painter)
(import /math)
(import /time/duration)
(blank)
(prop + prism-ink _ (= (call RGBA "#eff7ff")))
(prop + prism-muted _ (= (call RGBA "#74859f")))
(prop + prism-dim _ (= (call RGBA "#273044")))
(prop + prism-night _ (= (call RGBA "#070a18")))
(prop _ prism-dusk _ (= (call RGBA "#11132c")))
(prop _ board-fill _ (= (call RGBA "#0a1021")))
(prop _ board-edge _ (= (call RGBA "#29364e")))
(prop _ board-shadow _ (= (call Shadow (call RGBA 0 0 0 0.4) 24 0 8)))
(prop _ grid-color _ (= (call RGBA 0.35 0.6 0.85 0.035)))
(prop _ star-color _ (= (call RGBA 0.45 0.63 0.86)))
(prop _ board-radius _ (= 20.0))
(prop _ grid-pitch _ (= 40.0))
(prop _ star-count _ (= 54))
(prop _ brick-flash Seconds (= 200ms))
(prop _ paddle-flash Seconds (= 250ms))
(prop _ split-flash Seconds (= 500ms))
(prop _ pulse-rate _ (= 3.0))
(prop _ upward _ (= (call Point 0 -1)))
(prop _ palette (list RGBA) (= (list "#52e8ff" "#68f2b2" "#f5e481" "#ff9a73" "#ff70bb" "#a88bff")))

(fn-expr + prism-color RGBA
  (param flavor Int)
  ([] palette (% flavor (. palette length)))
)

(type + PrismSky (is Painter)
  ; ╌╌╌╌╌╌╌╌╌╌ is Painter ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (let sky (call linear-gradient (. rect top-left) (. rect bottom-right) prism-dusk prism-night))
    (call (. canvas fill-gradient) rect sky)
    (= (. canvas stroke-color) null)
    (for (in index (..< 0 star-count))
      (let spot (call Point (* (. rect width) (% (* index 0.618034) 1.0)) (* (. rect height) (% (* index 0.754878) 1.0))))
      (= (. canvas fill-color) (call (. star-color with-alpha) (+ 0.08 (* (% index 3) 0.03))))
      (call dot canvas (+ (. rect top-left) spot) (if-expr (== (% index 7) 0) 1.3 0.7))
    )
  )
)

(fn-do + paint-prism-board _
  (param canvas Canvas)
  (param game PrismGame)
  (param is-aiming Bool)
  (let area (call Rect prism-board-size))
  (let board (call Outline area board-radius))
  (let clock (. game clock))
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) board-fill)
  (call (. canvas shadow) board board-shadow)
  (call (. canvas outline) board)
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) board)
    (call paint-grid canvas area)
    (call paint-split-flash canvas area (call prism-fade clock (. game split-at) split-flash))
    (for (in brick (. game bricks))
      (call paint-brick canvas brick clock)
    )
    (for (in ball (. game balls))
      (call paint-ball canvas ball)
    )
    (call paint-paddle canvas game)
    (for (in shard (. game shards))
      (call paint-shard canvas shard clock)
    )
    (if is-aiming
      (call paint-aim canvas game)
    )
  )
  (call paint-rim canvas board area)
)

(fn-do _ paint-grid _
  (param canvas Canvas)
  (param area Rect)
  (call stroke canvas grid-color 1)
  (for (in x (.. 0.0 (. area width) (by: grid-pitch)))
    (call (. canvas line) (call Point x 0) (call Point x (. area height)))
  )
  (for (in y (.. 0.0 (. area height) (by: grid-pitch)))
    (call (. canvas line) (call Point 0 y) (call Point (. area width) y))
  )
)

(fn-do _ paint-split-flash _
  (param canvas Canvas)
  (param area Rect)
  (param strength Float)
  (return-if (if (<= strength 0)))
  (let start (call (. (call prism-color 0) with-alpha) (* strength 0.12)))
  (let end (call (. (call prism-color 4) with-alpha) (* strength 0.04)))
  (call (. canvas fill-gradient) area (call linear-gradient (. area top-left) (. area bottom-right) start end))
)

(fn-do _ paint-rim _
  (param canvas Canvas)
  (param board Outline)
  (param area Rect)
  (call stroke canvas board-edge 1)
  (call (. canvas outline) board)
  (call stroke canvas (call (. (call prism-color 0) with-alpha) 0.65) 1.5)
  (call (. canvas line) (call Point 24 1) (call Point 306 1))
  (call stroke canvas (call (. (call prism-color 5) with-alpha) 0.5) 1.5)
  (call (. canvas line) (call Point (- (. area width) 305) (- (. area height) 1)) (call Point (- (. area width) 24) (- (. area height) 1)))
)

(fn-do _ paint-brick _
  (param canvas Canvas)
  (param brick PrismBrick)
  (param clock Seconds)
  (let flash (call prism-fade clock (. brick hit-at) brick-flash))
  (let glass (call PrismGlass (call prism-color (. brick flavor)) flash (if-expr (. brick is-splitter) 1 0)))
  (do-use (. canvas saved-state)
    (= (. canvas stroke-color) null)
    (= (. canvas shape-fill) glass)
    (call (. canvas rect) (. brick rect))
  )
  (let center (. brick center))
  (if (. brick is-splitter)
    (call triangle canvas center 7 upward (call (. prism-ink with-alpha) (call pulse clock 0.65 0.2)))
    (call stroke canvas (call (. prism-ink with-alpha) 0.6) 1)
    (call (. canvas line) (+ center (call Point -23 0)) (+ center (call Point -9 0)))
    (for (in side (list -1 0 1))
      (call stroke canvas (call prism-color (+ side 3)) 1)
      (call (. canvas line) (+ center (call Point 8 0)) (+ center (call Point 25 (* side 7.0))))
    )
    (else-if (> (. brick health) 1)
      (call stroke canvas (call (. prism-ink with-alpha) 0.6) 1)
      (call (. canvas line) (+ center (call Point -8 4)) (+ center (call Point 8 4)))
    )
  )
)

(fn-do _ paint-ball _
  (param canvas Canvas)
  (param ball PrismBall)
  (let color (call prism-color (. ball flavor)))
  (call paint-trail canvas (. ball trail) color)
  (= (. canvas stroke-color) null)
  (for (in ring (list 3 2 1))
    (= (. canvas fill-color) (call (. color with-alpha) (+ 0.03 (* (- 4 ring) 0.025))))
    (call dot canvas (. ball place) (+ prism-ball-radius (* ring 5.0)))
  )
  (= (. canvas fill-color) color)
  (call dot canvas (. ball place) (- prism-ball-radius 1))
  (= (. canvas fill-color) prism-ink)
  (call dot canvas (- (. ball place) (call Point 1 1)) (/ prism-ball-radius 2))
)

(fn-do _ paint-trail _
  (param canvas Canvas)
  (param trail (list Point))
  (param color RGBA)
  (return-if (if (< (. trail length) 2)))
  (for (in index (..< 1 (. trail length)))
    (let fade (/ index (as (. trail length) Float)))
    (let from ([] trail (- index 1)))
    (let to ([] trail index))
    (call stroke canvas (call (. color with-alpha) (* fade 0.05)) (* 13 fade))
    (call (. canvas line) from to)
    (call stroke canvas (call (. color with-alpha) (* fade 0.48)) (* 4 fade))
    (call (. canvas line) from to)
  )
)

(fn-do _ paint-paddle _
  (param canvas Canvas)
  (param game PrismGame)
  (let flash (call prism-fade (. game clock) (. game paddle-hit-at) paddle-flash))
  (let rect (. game paddle-rect))
  (let outline (call Outline rect 6))
  (let glow (call (. (call prism-color 0) with-alpha) (+ 0.35 (* flash 0.3))))
  (call (. canvas shadow) outline (call Shadow glow 17 0 2))
  (do-use (. canvas saved-state)
    (= (. canvas stroke-color) null)
    (call (. canvas clip-outline) outline)
    (let sheen (call linear-gradient (. rect left-center) (. rect right-center) (call prism-color 0) (call prism-color 5)))
    (call (. canvas fill-gradient) rect sheen)
  )
  (= (. canvas fill-color) (call (. prism-ink with-alpha) (+ 0.7 (* flash 0.3))))
  (call (. canvas outline) (call Outline (call Rect (+ (. rect x) 4) (+ (. rect y) 2) (- (. rect width) 8) 3) 1.5))
  (call stroke canvas (call (. prism-ink with-alpha) 0.75) 1)
  (for (in side (list -1 1))
    (let notch (+ (. rect center) (call Point (* side 43.0) -2)))
    (call (. canvas line) notch (+ notch (call Point (* side 9.0) 0)))
  )
)

(fn-do _ paint-shard _
  (param canvas Canvas)
  (param shard PrismShard)
  (param clock Seconds)
  (let life (call prism-fade clock (. shard born) (. shard lifetime)))
  (let heading (call Point (call cos (. shard angle)) (call sin (. shard angle))))
  (call triangle canvas (. shard place) (. shard size) heading (call (. (call prism-color (. shard flavor)) with-alpha) life))
)

(fn-do _ paint-aim _
  (param canvas Canvas)
  (param game PrismGame)
  (let velocity (. game launch-velocity))
  (let heading (/ velocity (. velocity length)))
  (let origin (. game balls head place))
  (let color (call (. (call prism-color 0) with-alpha) (call pulse (. game clock) 0.4 0.15)))
  (call stroke canvas color 1)
  (call (. canvas line) (+ origin (* heading 16)) (+ origin (* heading 96)))
  (call triangle canvas (+ origin (* heading 100)) 4 heading color)
)

(fn-do _ triangle _
  (param canvas Canvas)
  (param center Point)
  (param size Float)
  (param heading Point)
  (param color RGBA)
  (let side (* (call Point (- (. heading y)) (. heading x)) (* size 0.86)))
  (let tip (+ center (* heading size)))
  (let base (- center (* heading (* size 0.5))))
  (= (. canvas fill-color) color)
  (= (. canvas stroke-color) null)
  (call (. canvas begin))
  (call (. canvas move) (. tip x) (. tip y))
  (call (. canvas line) (+ base side))
  (call (. canvas line) (- base side))
  (call (. canvas end) true)
)

(fn-do _ stroke _
  (param canvas Canvas)
  (param color RGBA)
  (param width Float)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) color)
  (= (. canvas stroke-width) width)
  (= (. canvas stroke-cap) (. LineCap round))
)

(fn-do _ dot _
  (param canvas Canvas)
  (param center Point)
  (param radius Float)
  (call (. canvas circle) (. center x) (. center y) radius)
)

(fn-expr _ pulse Float
  (param clock Seconds)
  (param base Float)
  (param swing Float)
  (+ base (* (call sin (* (as clock Float) pulse-rate)) swing))
)
