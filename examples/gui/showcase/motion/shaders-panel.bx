(import ./gallery-shaders)
(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)

(style ShadersTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule shader-grid (• flex-row) (• flex 1) (• mt 18) (• gap 18))
  (blank)
  (rule shader-tile (• flex-col) (• justify-end) (• flex 1) (• p 16)
    (= corner-radius 18)
    (= shadow (call Shadow (call RGBA "#00000040") 10 0 4))
    (= motion gui-motion-smooth)
    (= (. motion background-fill) (call ease-in-out 900ms))
    (= (. motion scale) gui-motion-bouncy)
    (blank)
    (when-style #is-hover-within
      (= scale 1.03)
      (= shadow (call Shadow (call RGBA "#00000080") 28 0 14))
    )
  )
  (blank)
  (rule tile-name
    (= font-size 17)
    (= font-weight (. FontWeight bold))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule tile-hint (• mt 3)
    (= font-size 12)
    (= color (call RGBA "#ffffffc0"))
  )
  (blank)
  (rule plasma-tile
    (= background-fill (call Plasma (call RGBA "#1b0b4d") (call RGBA "#ff4fa3")))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Plasma (call RGBA "#00303a") (call RGBA "#9dffd0") (:scale 2.4)))
    )
  )
  (blank)
  (rule aurora-tile
    (= background-fill (call Aurora (call RGBA "#06112b") (call RGBA "#3dff9e") (call RGBA "#2f6bff")))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Aurora (call RGBA "#16061f") (call RGBA "#ff5ad1") (call RGBA "#ffb347")))
    )
  )
  (blank)
  (rule ripples-tile
    (= background-fill (call Ripples (call RGBA "#04364f") (call RGBA "#9be8ff")))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Ripples (call RGBA "#2b0f45") (call RGBA "#ffd36e") (:center (call Point 0.2 0.3)) (:wavelength 9)))
    )
  )
  (blank)
  (rule lava-tile
    (= background-fill (call Lava (call RGBA "#2a0610") (call RGBA "#ff7a1a")))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Lava (call RGBA "#04152e") (call RGBA "#36e4ff")))
    )
  )
  (blank)
  (rule flames-tile
    (= background-fill (call Flames (call RGBA "#7a0c02") (call RGBA "#ff7b00") (call RGBA "#fff1a8") (:height 0.7)))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Flames (call RGBA "#1d0a6b") (call RGBA "#5b6bff") (call RGBA "#e8f6ff") (:height 1.5)))
    )
  )
  (blank)
  (rule warp-tile
    (= background-fill (call Warp (call RGBA "#05060f") (call RGBA "#bcd7ff") (:warp 0.4)))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Warp (call RGBA "#0b0420") (call RGBA "#ffffff") (:warp 4)))
    )
  )
  (blank)
  (rule shader-strip (• flex-row) (• mt 18) (• gap 18) (• h 120))
  (blank)
  (rule spectrum-card (• motion-card) (• flex-col) (• justify-center) (• flex 1))
  (blank)
  (rule spectrum-title
    (= font-size 40)
    (= font-weight (. FontWeight heavy))
    (= text-fill (call Spectrum))
  )
  (blank)
  (rule spin-card (• flex-col) (• justify-center) (• flex 1) (• bg gui-panel-color) (• p 18)
    (= corner-radius 18)
    (= border-width 3)
    (= border-fill (call Spin (call RGBA "#2a1d6b") (call RGBA "#7df9ff")))
    (= (. motion border-fill) (call ease-in-out 700ms))
    (blank)
    (when-style #is-hover-within
      (= border-fill (call Spin (call RGBA "#4a1020") (call RGBA "#ffcf5a") (:turns 1.2)))
    )
  )
  (blank)
  (rule progress-card (• motion-card) (• flex-col) (• justify-center) (• flex 1))
  (blank)
  (rule progress-track (• flex-row) (• mt 12) (• h 16) (• bg gui-well-color)
    (= corner-radius 8)
  )
  (blank)
  (rule progress-bar (• h 16)
    (= corner-radius 8)
    (= background-fill (call Stripes (call RGBA "#2f7bff") (call RGBA "#5b9dff")))
    (= motion gui-motion-smooth)
    (= (. motion background-fill) (call ease-in-out 600ms))
    (blank)
    (when-style #is-hover-within
      (= background-fill (call Stripes (call RGBA "#16a34a") (call RGBA "#4ade80") (:width 6) (:speed 60)))
    )
  )
)

(type + ShadersPanel (is Box)
  (using MotionKitTheme)
  (using ShadersTheme)
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Shader gallery")
        (= lede "Each fill below is a Brix class with a Metal body, running live on the GPU from the window's fill clock. Hover one and its parameters ease to new values while it keeps moving.")
      )
      (<> Box (• shader-grid)
        (<> Box (• shader-tile) (• plasma-tile)
          (<> Label (text: "Plasma") (• tile-name))
          (<> Label (text: "Hover to zoom and recolor") (• tile-hint))
        )
        (<> Box (• shader-tile) (• aurora-tile)
          (<> Label (text: "Aurora") (• tile-name))
          (<> Label (text: "Hover for a different sky") (• tile-hint))
        )
        (<> Box (• shader-tile) (• ripples-tile)
          (<> Label (text: "Ripples") (• tile-name))
          (<> Label (text: "Hover to move the source and tighten the waves") (• tile-hint))
        )
      )
      (<> Box (• shader-grid)
        (<> Box (• shader-tile) (• lava-tile)
          (<> Label (text: "Lava") (• tile-name))
          (<> Label (text: "Hover to cool it down") (• tile-hint))
        )
        (<> Box (• shader-tile) (• flames-tile)
          (<> Label (text: "Flames") (• tile-name))
          (<> Label (text: "Hover to turn up the gas") (• tile-hint))
        )
        (<> Box (• shader-tile) (• warp-tile)
          (<> Label (text: "Warp") (• tile-name))
          (<> Label (text: "Hover to jump to lightspeed") (• tile-hint))
        )
      )
      (<> Box (• shader-strip)
        (<> Box (• spectrum-card)
          (<> Label (text: "Spectrum") (• spectrum-title))
          (<> Label (text: "A text fill sweeping through the hues") (• motion-note) (• mt 4))
        )
        (<> Box (• spin-card)
          (<> Label (text: "Spinning border") (• motion-card-title))
          (<> Label (text: "A border fill that turns. Hover to spin it faster and warm it up.") (• motion-note) (• mt 4))
        )
        (<> Box (• progress-card)
          (<> Label (text: "Barber stripes") (• motion-card-title))
          (<> Box (• progress-track)
            (<> Box (• progress-bar) (• w 240))
          )
          (<> Label (text: "Hover the bar to turn it green and speed it up") (• motion-note) (• mt 8))
        )
      )
    )
  )
)
