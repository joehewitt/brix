(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/grip-vertical)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)

(type + ReorderSong (is Tuple)
  (prop + id Int)
  (prop + title String)
  (prop + artist String)
  (prop + length String)
  (prop + hue Index)
)

(type + ReorderMood (is Tuple)
  (prop + id Int)
  (prop + name String)
  (prop + share F64)
  (prop + hue Index)
)

(type + PlaylistDrag (is Tuple)
  (implements DragPayload)
  (prop + view PlaylistView)
  (prop + row PlaylistRow)
  (blank)
  ; ╌╌╌╌╌╌╌╌╌╌ is DragPayload ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + drag-kind _ :get
    "motion.playlist"
  )
)

(type + MoodDrag (is Tuple)
  (implements DragPayload)
  (prop + view MoodStrip)
  (prop + chip MoodChip)
  (blank)
  ; ╌╌╌╌╌╌╌╌╌╌ is DragPayload ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + drag-kind _ :get
    "motion.mood"
  )
)

(style ReorderTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (prop + reorder-settle Motion (= (call spring 420ms 0.22)))
  (blank)
  (rule playlist-row (• bg gui-well-color) (• flex-row) (• items-center) (• h 54) (• px 12) (• mb 8)
    (= corner-radius 12)
    (= (. motion position) reorder-settle)
    (= (. motion scale) gui-motion-quick)
    (blank)
    (when-style #is-carried
      (• bg gui-field-color)
      (= shadow gui-lifted-shadow)
      (= scale 1.03)
    )
  )
  (blank)
  (rule playlist-grip (• text gui-muted-text-color) (• w 16) (• h 16) (• mr 10))
  (blank)
  (rule playlist-art (• w 36) (• h 36) (• mr 12)
    (= corner-radius 8)
  )
  (blank)
  (rule mood-strip (• flow-row) (• h 48))
  (blank)
  (rule mood-chip (• flex-row) (• items-center) (• h 40) (• px 15) (• mr 8)
    (= corner-radius 20)
    (= (. motion position) reorder-settle)
    (= (. motion scale) gui-motion-quick)
    (blank)
    (when-style #is-carried
      (= shadow gui-lifted-shadow)
      (= scale 1.08)
    )
  )
  (blank)
  (rule mood-name (• text gui-strong-text-color)
    (= font-size 14)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule mood-bar (• flex-row) (• h 170)
    (= corner-radius 18)
  )
  (blank)
  (rule mood-segment (• flex-col) (• justify-end) (• p 12)
    (= (. motion position) reorder-settle)
    (= (. motion size) reorder-settle)
  )
  (blank)
  (rule mood-segment-name (• text gui-strong-text-color)
    (= font-size 13)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule order-readout (• text gui-muted-text-color)
    (= font-size 13)
    (= text-wrap (. TextWrap word))
  )
)

(type + ReorderPanel (is Box)
  (using MotionKitTheme)
  (using ReorderTheme)
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Drag to reorder")
        (= lede "A drag started with event.carry(payload) lifts the item itself. Its siblings make room under their own motion.position, and on drop it settles into its new slot at the speed it was thrown.")
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Playlist") (• w 520)
          (= note "Drag a row by any part of it. #is-carried lifts it with a shadow.")
          (<> PlaylistView (id: playlist) (• flex-col) (• flex 1) (• mt 12))
        )
        (<> MotionCard (text: "Moods") (• flex 1)
          (= note "A flow row projects the carried chip's slot the same way. The mix below follows the model, so its segments slide when a drop reorders it.")
          (<> MoodStrip (id: moods) (• flex-col) (• flex 1) (• mt 14))
        )
      )
    )
  )
)

(type + PlaylistView (is Box)
  (using MotionKitTheme)
  (using ReorderTheme)
  (prop + songs (list ReorderSong) (= (call reorder-songs)))
  (content
    (<> This
      (<> Box (id: rows) (• flex-col)
        (for (in song #songs (keyed-by (. song id)))
          (<> PlaylistRow
            (= song song)
          )
        )
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (is (. event payload) PlaylistDrag)
      (let drag (as (. event payload) PlaylistDrag))
      (if (== (. drag view) this)
        (call (. event accept) this)
      )
    )
  )
  (subscribe-for (on event drop)
    (if (is (. event payload) PlaylistDrag)
      (let drag (as (. event payload) PlaylistDrag))
      (let index (. drag row carry-slot))
      (if (and (== (. drag view) this) (!= index null))
        (call move (. drag row song id) index)
      )
    )
  )
  (fn-do + move _
    (param id Int)
    (param index Index)
    (let moving (call (of List ReorderSong) (in each songs (when (== (. each id) id)))))
    (return-if (if (== (. moving length) 0)))
    (let rest (call (of List ReorderSong) (in each songs (when (!= (. each id) id)))))
    (let split (if-expr (< index (. rest length)) index (. rest length)))
    (= songs (++ (call (of List ReorderSong) ([] rest (..< 0 split))) moving ([] rest (..< split (. rest length)))))
  )
)

(type + PlaylistRow (is Box)
  (using MotionKitTheme)
  (using ReorderTheme)
  (prop + song ReorderSong)
  (blank)
  (prop _ view (of Ancestor PlaylistView))
  (content
    (<> This (• playlist-row)
      (<> LucideGripVertical (• icon) (• playlist-grip))
      (<> Box (• playlist-art)
        (= background (call motion-glow (. #song hue)))
      )
      (<> Box (• flex-col) (• flex 1)
        (<> Label (• motion-label)
          (= text (. #song title))
        )
        (<> Label (• motion-note) (• mt 2)
          (= text (. #song artist))
        )
      )
      (<> Label (• motion-caption)
        (= text (. #song length))
      )
    )
  )
  (subscribe-for (on event drag-start)
    (let owner view)
    (if owner
      (let ignored (call (. event carry) (call PlaylistDrag owner this)))
    )
  )
)

(type + MoodStrip (is Box)
  (using MotionKitTheme)
  (using ReorderTheme)
  (prop + moods (list ReorderMood) (= (call reorder-moods)))
  (content
    (<> This
      (<> Box (id: chips) (• mood-strip)
        (for (in mood #moods (keyed-by (. mood id)))
          (<> MoodChip
            (= mood mood)
          )
        )
      )
      (<> Label (text: "THE MIX") (• motion-tag) (• mt 26) (• mb 8))
      (<> Box (• mood-bar)
        (for (in mood #moods (keyed-by (. mood id)))
          (<> Box (• mood-segment)
            (= flex (. mood share))
            (= background (call motion-glow (. mood hue)))
            (<> Label (• mood-segment-name)
              (= text (. mood name))
            )
          )
        )
      )
      (<> Label (• order-readout) (• mt 12)
        (= text (call mood-order #moods))
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (is (. event payload) MoodDrag)
      (let drag (as (. event payload) MoodDrag))
      (if (== (. drag view) this)
        (call (. event accept) this)
      )
    )
  )
  (subscribe-for (on event drop)
    (if (is (. event payload) MoodDrag)
      (let drag (as (. event payload) MoodDrag))
      (let index (. drag chip carry-slot))
      (if (and (== (. drag view) this) (!= index null))
        (call move (. drag chip mood id) index)
      )
    )
  )
  (fn-do + move _
    (param id Int)
    (param index Index)
    (let moving (call (of List ReorderMood) (in each moods (when (== (. each id) id)))))
    (return-if (if (== (. moving length) 0)))
    (let rest (call (of List ReorderMood) (in each moods (when (!= (. each id) id)))))
    (let split (if-expr (< index (. rest length)) index (. rest length)))
    (= moods (++ (call (of List ReorderMood) ([] rest (..< 0 split))) moving ([] rest (..< split (. rest length)))))
  )
)

(type + MoodChip (is Box)
  (using MotionKitTheme)
  (using ReorderTheme)
  (prop + mood ReorderMood)
  (blank)
  (prop _ view (of Ancestor MoodStrip))
  (content
    (<> This (• mood-chip)
      (= background (call motion-glow (. #mood hue)))
      (<> Label (• mood-name)
        (= text (. #mood name))
      )
    )
  )
  (subscribe-for (on event drag-start)
    (let owner view)
    (if owner
      (let ignored (call (. event carry) (call MoodDrag owner this)))
    )
  )
)

(fn-expr + mood-order String
  (param moods (list ReorderMood))
  (str "Order: " (call (. " → " join) (call (of List String) (in (. each name) moods))))
)

(fn-expr _ reorder-songs (list ReorderSong)
  (bullet (call ReorderSong 0 "Glass Hours" "Mira Vale" "3:41" 2))
  (bullet (call ReorderSong 1 "Paper Planes" "June Atlas" "2:58" 0))
  (bullet (call ReorderSong 2 "Night Bus" "Harbor Lights" "4:12" 4))
  (bullet (call ReorderSong 3 "Slow Orbit" "The Long Dark" "5:03" 5))
  (bullet (call ReorderSong 4 "Coral" "Seaside Choir" "3:26" 3))
  (bullet (call ReorderSong 5 "Neon Rain" "Static Ghosts" "3:55" 6))
  (bullet (call ReorderSong 6 "Low Tide" "Ferns & Fog" "4:31" 1))
)

(fn-expr _ reorder-moods (list ReorderMood)
  (bullet (call ReorderMood 0 "Dreamy" 3 6))
  (bullet (call ReorderMood 1 "Bright" 2 0))
  (bullet (call ReorderMood 2 "Lush" 2.5 2))
  (bullet (call ReorderMood 3 "Moody" 1.5 5))
  (bullet (call ReorderMood 4 "Warm" 2 7))
  (bullet (call ReorderMood 5 "Cool" 1.5 4))
)
