(import ./gallery-shaders)
(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/shader)
(import /graphics/shader-filters)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)

(style EffectsTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule effects-row (• flex-row) (• flex 1) (• mt 18) (• gap 18))
  (blank)
  (rule effect-frame (• motion-clip) (• flex-col) (• flex 1)
    (= corner-radius 18)
    (= shadow (call Shadow (call RGBA "#00000040") 10 0 4))
  )
  (blank)
  (rule effect-body (• flex-col) (• justify-end) (• flex 1) (• p 16))
  (blank)
  (rule effect-name
    (= font-size 17)
    (= font-weight (. FontWeight bold))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule effect-hint (• mt 3)
    (= font-size 12)
    (= color (call RGBA "#ffffffc8"))
  )
  (blank)
  (rule effect-banner (• flex 1)
    (= font-size 30)
    (= font-weight (. FontWeight heavy))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule crt-body
    (= background-fill (call Aurora (call RGBA "#06112b") (call RGBA "#3dff9e") (call RGBA "#2f6bff")))
    (= filters (list (call CRT)))
    (blank)
    (when-style #is-hover-within
      (= filters (list (call CRT 0.22)))
    )
  )
  (blank)
  (rule wave-body
    (= background-fill (call Plasma (call RGBA "#1b0b4d") (call RGBA "#ff4fa3")))
    (= filters (list (call Wave 6) (call Pixelate 5)))
    (blank)
    (when-style #is-hover-within
      (= filters (list (call Wave 14) (call Pixelate 10)))
    )
  )
  (blank)
  (rule thermal-body
    (= background-fill (call Lava (call RGBA "#04152e") (call RGBA "#36e4ff")))
    (= filters (list (call Thermal)))
    (blank)
    (when-style #is-hover-within
      (= filters (list (call Thermal) (call Glitch 1.4)))
    )
  )
  (blank)
  (rule mask-art (• flex 1))
  (blank)
  (rule mask-caption (• flex-col) (• p 16) (• bg (call RGBA "#141821")))
  (blank)
  (rule mask-caption-name (• text gui-strong-text-color)
    (= font-size 17)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule mask-caption-hint (• text gui-muted-text-color) (• mt 3)
    (= font-size 12)
  )
  (blank)
  (rule iris-body
    (= background-fill (call Ripples (call RGBA "#2b0f45") (call RGBA "#ffd36e")))
    (= mask (call Iris))
    (= (. motion mask) (call ease-in-out 800ms))
    (blank)
    (when-style #is-hover-within
      (= mask (call Iris 1.2))
    )
  )
  (blank)
  (rule blinds-body
    (= background-fill (call Flames (call RGBA "#7a0c02") (call RGBA "#ff7b00") (call RGBA "#fff1a8")))
    (= mask (call Blinds))
    (= (. motion mask) (call ease-in-out 700ms))
    (blank)
    (when-style #is-hover-within
      (= mask (call Blinds 1.1 0))
    )
  )
  (blank)
  (rule lens-stage (• flex-row) (• items-center) (• gap 22) (• p 22)
    (= background-fill (call Stripes (call RGBA "#2f7bff") (call RGBA "#ffcf5a") (:width 14) (:speed 30)))
  )
  (blank)
  (rule lens-pane (• flex-col) (• justify-end) (• flex 1) (• p 14) (• h 150)
    (= corner-radius 22)
    (= border-width 1)
    (= border-color (call RGBA "#ffffff70"))
    (= (. motion backdrop) (call ease-in-out 600ms))
  )
  (blank)
  (rule lens-pane-lens
    (= backdrop (call Lens))
    (blank)
    (when-style #is-hover-within
      (= backdrop (call Lens 0.75))
    )
  )
  (blank)
  (rule lens-pane-puddle
    (= backdrop (call Puddle))
    (blank)
    (when-style #is-hover-within
      (= backdrop (call Puddle 10))
    )
  )
  (blank)
  (rule lens-pane-name
    (= font-size 15)
    (= font-weight (. FontWeight bold))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule swap-card (• motion-card) (• flex 1))
  (blank)
  (rule swap-row (• flex-row) (• mt 18) (• gap 18)
    (= flex 1.35)
  )
  (blank)
  (rule swap-controls (• flex-row) (• items-center) (• mt 12))
  (blank)
  (rule swap-stage (• motion-clip) (• flex-col) (• flex 1) (• mt 14)
    (= corner-radius 14)
    (= (. motion swap-transition) (call ease-in-out 1100ms))
  )
  (blank)
  (rule swap-page (• flex-col) (• justify-end) (• flex 1) (• p 18))
  (blank)
  (rule plasma-page
    (= background-fill (call Plasma (call RGBA "#1b0b4d") (call RGBA "#ff4fa3")))
  )
  (blank)
  (rule aurora-page
    (= background-fill (call Aurora (call RGBA "#16061f") (call RGBA "#ff5ad1") (call RGBA "#ffb347")))
  )
  (blank)
  (rule ripples-page
    (= background-fill (call Ripples (call RGBA "#04364f") (call RGBA "#9be8ff")))
  )
  (blank)
  (rule swap-title
    (= font-size 34)
    (= font-weight (. FontWeight heavy))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule swap-caption (• mt 2)
    (= font-size 13)
    (= color (call RGBA "#ffffffc8"))
  )
)

(type + ShaderEffectsPanel (is Box)
  (using MotionKitTheme)
  (using EffectsTheme)
  (prop + page _ (= 0))
  (prop + transition-name _ (= "dissolve"))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Shader effects")
        (= lede
          (paragraph
            "Each kind of shader in action. Layer filters rework a box's rendered content, masks shape its alpha, backdrops bend whatever sits behind it, and swap transitions blend one branch of markup into the next. Hover the tiles to change their parameters."
          )
        )
      )
      (<> Box (• effects-row)
        (<> Box (• effect-frame)
          (<> Box (• effect-body) (• crt-body)
            (<> Label (text: "CHANNEL 3") (• effect-banner))
            (<> Label (text: "CRT") (• effect-name))
            (<> Label (text: "A layer filter. Hover to bend the glass.") (• effect-hint))
          )
        )
        (<> Box (• effect-frame)
          (<> Box (• effect-body) (• wave-body)
            (<> Label (text: "UNDERWATER") (• effect-banner))
            (<> Label (text: "Wave, then pixelate") (• effect-name))
            (<> Label (text: "Two filters stacked in a list. Hover for more of both.") (• effect-hint))
          )
        )
        (<> Box (• effect-frame)
          (<> Box (• effect-body) (• thermal-body)
            (<> Label (text: "HEAT") (• effect-banner))
            (<> Label (text: "Thermal") (• effect-name))
            (<> Label (text: "Hover to stack a glitch on top.") (• effect-hint))
          )
        )
      )
      (<> Box (• effects-row)
        (<> Box (• effect-frame) (• bg (call RGBA "#0b0d14"))
          (<> Box (• mask-art) (• iris-body))
          (<> Box (• mask-caption)
            (<> Label (text: "Iris mask") (• mask-caption-name))
            (<> Label (text: "A mask shader with a breathing edge. Hover to open it.") (• mask-caption-hint))
          )
        )
        (<> Box (• effect-frame) (• bg (call RGBA "#0b0d14"))
          (<> Box (• mask-art) (• blinds-body))
          (<> Box (• mask-caption)
            (<> Label (text: "Blinds mask") (• mask-caption-name))
            (<> Label (text: "Hover and the slats ease open.") (• mask-caption-hint))
          )
        )
        (<> Box (• effect-frame) (• flex 1.6)
          (<> Box (• lens-stage) (• flex 1)
            (<> Box (• lens-pane) (• lens-pane-lens)
              (<> Label (text: "Lens") (• lens-pane-name))
              (<> Label (text: "A backdrop shader magnifying what's behind it. Hover to push it.") (• effect-hint))
            )
            (<> Box (• lens-pane) (• lens-pane-puddle)
              (<> Label (text: "Puddle") (• lens-pane-name))
              (<> Label (text: "Live ripples over the stripes. Hover to stir them.") (• effect-hint))
            )
          )
        )
      )
      (<> Box (• swap-row)
        (<> Box (• swap-card)
          (<> Label (text: "Swap transitions") (• motion-card-title))
          (<> Label (text: "The box below switches between the arms of an if. Its swap-transition snapshots the old arm and blends it into the new one as progress runs from 0 to 1.") (• motion-note) (• mt 4))
          (<> Box (• swap-controls)
            (<> (of SegmentedControl String)
              (<-> selected transition-name)
              (<> (of Segment String) (id: dissolve-segment) (text: "Dissolve")
                (= value "dissolve")
              )
              (<> (of Segment String) (id: portal-segment) (text: "Portal")
                (= value "portal")
              )
              (<> (of Segment String) (id: swirl-segment) (text: "Swirl")
                (= value "swirl")
              )
              (<> (of Segment String) (id: mosaic-segment) (text: "Mosaic")
                (= value "mosaic")
              )
            )
            (<> Button (id: next-button) (text: "Next page") (• ml 12)
              (= action (=> () :do (call next-page)))
            )
          )
          (<> Box (• swap-stage)
            (= swap-transition (call effect-transition #transition-name))
            (if (== #page 0)
              (<> Box (• swap-page) (• plasma-page)
                (<> Label (text: "Plasma") (• swap-title))
                (<> Label (text: "Page one of three") (• swap-caption))
              )
              (else-if (== #page 1)
                (<> Box (• swap-page) (• aurora-page)
                  (<> Label (text: "Aurora") (• swap-title))
                  (<> Label (text: "Page two of three") (• swap-caption))
                )
              )
              (else
                (<> Box (• swap-page) (• ripples-page)
                  (<> Label (text: "Ripples") (• swap-title))
                  (<> Label (text: "Page three of three") (• swap-caption))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do + next-page _
    (= page (% (+ page 1) 3))
  )
)

(fn-expr + effect-transition ShaderTransition
  (param name String)
  (match name
    (case= "portal"
      (call Portal)
    )
    (case= "swirl"
      (call Swirl)
    )
    (case= "mosaic"
      (call Mosaic)
    )
    (default
      (call Dissolve)
    )
  )
)
