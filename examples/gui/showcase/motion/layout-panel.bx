(import ./motion-kit)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/motion)
(import /stream/sort)
(import /time/duration)
(import /units)

(type + GridTile (is Tuple)
  (prop + id Index)
  (prop + hue Index)
)

(style LayoutMotionTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule tile-grid (• grid 7) (• mt 14)
    (= gap 8)
  )
  (blank)
  (rule grid-tile (• flex-col) (• items-center) (• justify-center) (• w 64) (• h 64) (• text gui-accent-text-color)
    (= corner-radius 14)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
    (= motion gui-motion-smooth)
    (= (. motion position) (call spring 520ms 0.2))
    (= (. motion size) (call spring 520ms 0.35))
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-big
      (• w 136)
    )
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= scale 0.4)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= scale 0.4)
    )
  )
  (blank)
  (rule resize-slot (• flex-col) (• items-start) (• w 146) (• h 150) (• mt 8))
  (blank)
  (rule resize-demo (• flex-col) (• bg gui-field-color) (• w 84) (• h 80)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 12)
    (= (. motion size) (call spring 900ms 0.15))
    (blank)
    (when-style #is-wide
      (• w 140)
      (• h 124)
    )
  )
  (blank)
  (rule resize-strip (• h 8)
    (= corner-radius 4)
  )
  (blank)
  (rule resize-text (• text gui-strong-text-color) (• mt 6)
    (= font-size 10)
    (= text-wrap (. TextWrap word))
  )
  (blank)
  (rule resize-dots (• flex-row) (• justify-between) (• items-end) (• flex 1))
  (blank)
  (rule resize-dot (• w 10) (• h 10)
    (= corner-radius 5)
  )
  (blank)
  (rule resize-caption (• text gui-muted-text-color) (• mt 8)
    (= font-size 11)
  )
  (blank)
  (rule stack-well (• motion-well) (• flex-col) (• p 10) (• w 150) (• h 192) (• mt 8))
  (blank)
  (rule stack-bar (• flex-row) (• items-center) (• h 30) (• px 10) (• text gui-accent-text-color)
    (= corner-radius 8)
    (= font-size 11)
    (= font-weight (. FontWeight bold))
    (= (. motion position) gui-motion-quick)
    (= (. motion size) (call spring 700ms 0.3))
    (blank)
    (when-style #is-open
      (• h 84)
    )
  )
  (blank)
  (rule scope-well (• motion-well) (• flex-row) (• items-center) (• h 84) (• px 12) (• mt 12))
  (blank)
  (rule scope-ball (• w 60) (• h 60)
    (= corner-radius 30)
  )
)

(type + LayoutPanel (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + tiles (list GridTile) (= (call layout-tiles 12)))
  (prop + big-id Index (= -1))
  (prop + serial Index (= 12))
  (prop + is-wide _ (= false))
  (prop + is-stack-open _ (= false))
  (prop + is-right _ (= false))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Layout moves itself")
        (= lede
          (paragraph
            "When a write changes layout, each box slides and resizes from where it was under motion.position and motion.size. Nobody measures anything."
          )
        )
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "A flow of tiles") (• flex 1.25)
          (<> Box (• flex-row) (• mt 12)
            (<> Button (id: shuffle-button) (text: "Shuffle")
              (= action (=> () :do (call shuffle)))
            )
            (<> Button (id: sort-button) (text: "Sort") (• ml 8)
              (= action (=> () :do (call sort-tiles)))
            )
            (<> Button (id: add-button) (text: "Add") (• ml 8)
              (= action (=> () :do (call add)))
            )
            (<> Button (id: remove-button) (text: "Remove") (• ml 8)
              (= action (=> () :do (call remove)))
            )
            (<> Button (id: grow-button) (text: "Grow") (• ml 8)
              (= action (=> () :do (call grow)))
            )
          )
          (<> Box (• tile-grid)
            (for (in tile #tiles (keyed-by (. tile id)))
              (<> TileBox
                (= tile tile)
                (= is-big (== #big-id (. tile id)))
              )
            )
          )
        )
        (<> Box (• motion-card) (• flex 1)
          (<> Box (• flex-row) (• items-center)
            (<> Label (text: "resize-content") (• motion-card-title) (• flex 1))
            (<> Button (id: resize-button) (text: "Resize")
              (= action (=> () :do (call resize)))
            )
          )
          (<> Box (• flex-row) (• mt 10)
            (<> ResizeColumn
              (= title "reveal")
              (= mode (. ResizeContent reveal))
              (= hue 0)
              (= blurb "Final layout, clipped")
              (= is-wide #is-wide)
            )
            (<> ResizeColumn (• ml 8)
              (= title "reflow")
              (= mode (. ResizeContent reflow))
              (= hue 3)
              (= blurb "Laid out every frame")
              (= is-wide #is-wide)
            )
            (<> ResizeColumn (• ml 8)
              (= title "scale")
              (= mode (. ResizeContent scale))
              (= hue 5)
              (= blurb "Stretched in its transform")
              (= is-wide #is-wide)
            )
          )
        )
      )
      (<> Box (• flex-row) (• h 300) (• mt 18) (• gap 18)
        (<> Box (• motion-card) (• flex 1.25)
          (<> Box (• flex-row) (• items-center)
            (<> Label (text: "Coupled stacks") (• motion-card-title) (• flex 1))
            (<> Button (id: stack-button) (text: "Toggle")
              (= action (=> () :do (call toggle-stack)))
            )
          )
          (<> Box (• flex-row) (• mt 4)
            (<> Box (• flex-col)
              (<> Label (text: "free") (• motion-tag) (• mt 6))
              (<> Box (• stack-well)
                (<> StackBars
                  (= is-open #is-stack-open)
                )
              )
            )
            (<> Box (• flex-col) (• ml 16)
              (<> Label (text: "stack-motion = coupled") (• motion-tag) (• mt 6))
              (<> Box (• stack-well)
                (<> StackBars
                  (= stack-motion (. StackMotion coupled))
                  (= is-open #is-stack-open)
                )
              )
            )
            (<> Label (• motion-note) (• ml 16) (• flex 1) (• mt 28)
              (= text
                (paragraph
                  "The second bar grows on a slow spring while its siblings move on a quick one. A coupled stack places them from the presented sizes every frame, so they stay touching."
                )
              )
            )
          )
        )
        (<> MotionCard (text: "Motion scopes") (• flex 1)
          (= note
            (paragraph
              "The ball declares no motion at all. Move snaps it. Move in scope writes the same change inside do use motion(gui-motion-bouncy)."
            )
          )
          (<> Box (id: scope-well) (• scope-well)
            (= justify (if-expr #is-right (. Justify end) (. Justify start)))
            (<> Box (• scope-ball)
              (= background-color (if-expr #is-right (call motion-hue 7) (call motion-hue 4)))
            )
          )
          (<> Box (• flex-row) (• mt 14)
            (<> Button (id: plain-button) (text: "Move")
              (= action (=> () :do (call move-plain)))
            )
            (<> Button (id: scope-button) (text: "Move in scope") (• ml 8)
              (= action (=> () :do (call move-scoped)))
            )
          )
        )
      )
    )
  )
  (fn-do + shuffle _
    (let next (call (of List GridTile) tiles))
    (for (in index (..< 0 (. next length)))
      (let other (+ index (call random 0 (- (. next length) index))))
      (let held ([] next index))
      (= ([] next index) ([] next other))
      (= ([] next other) held)
    )
    (= tiles next)
  )
  (fn-do + sort-tiles _
    (= tiles (call sort tiles (:using (=> (left right) (if-expr (< (. left id) (. right id)) .lesser .greater)))))
  )
  (fn-do + add _
    (+= serial 1)
    (let next (call (of List GridTile) tiles))
    (call (. next insert) (call GridTile serial serial) (call random 0 (+ (. next length) 1)))
    (= tiles next)
  )
  (fn-do + remove _
    (return-if (if (== (. tiles length) 0)))
    (blank)
    (let next (call (of List GridTile) tiles))
    (call (. next remove) (call random 0 (. next length)))
    (= tiles next)
  )
  (fn-do + grow _
    (return-if (if (== (. tiles length) 0)))
    (blank)
    (let candidate (. ([] tiles (call random 0 (. tiles length))) id))
    (= big-id (if-expr (== candidate big-id) -1 candidate))
  )
  (fn-do + resize _
    (= is-wide (not is-wide))
  )
  (fn-do + toggle-stack _
    (= is-stack-open (not is-stack-open))
  )
  (fn-do + move-plain _
    (= is-right (not is-right))
  )
  (fn-do + move-scoped _
    (do-use (call motion $gui-motion-bouncy)
      (= is-right (not is-right))
    )
  )
)

(type + TileBox (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + tile GridTile)
  (prop + is-big _ (= false))
  (content
    (<> This (• grid-tile)
      (= background (call motion-glow (. tile hue)))
      (<> Label
        (= text (str (. tile id)))
      )
    )
  )
)

(type + ResizeColumn (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + title _ (= ""))
  (prop + mode _ (= (. ResizeContent reveal)))
  (prop + hue Index (= 0))
  (prop + blurb _ (= ""))
  (prop + is-wide _ (= false))
  (content
    (<> This (• flex-col)
      (<> Label (• motion-tag)
        (= text #title)
      )
      (<> Box (• resize-slot)
        (<> ResizeDemo
          (= resize-content #mode)
          (= is-wide #is-wide)
          (<> Box (• resize-strip)
            (= background (call motion-glow #hue))
          )
          (<> Label (text: "These words rewrap as it grows") (• resize-text))
          (<> Box (• resize-dots)
            (<> Box (• resize-dot)
              (= background-color (call motion-hue #hue))
            )
            (<> Box (• resize-dot)
              (= background-color (call motion-hue (+ #hue 1)))
            )
            (<> Box (• resize-dot)
              (= background-color (call motion-hue (+ #hue 2)))
            )
          )
        )
      )
      (<> Label (• resize-caption)
        (= text #blurb)
      )
    )
  )
)

(type + ResizeDemo (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + is-wide _ (= false))
  (content
    (<> This (• resize-demo) (• p 8))
  )
)

(type + StackBars (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + is-open _ (= false))
  (content
    (<> This (• flex-col) (• flex 1)
      (<> StackBar (text: "one")
        (= hue 0)
      )
      (<> StackBar (text: "two")
        (= hue 2)
        (= is-open #is-open)
      )
      (<> StackBar (text: "three")
        (= hue 4)
      )
      (<> StackBar (text: "four")
        (= hue 6)
      )
    )
  )
)

(type + StackBar (is Box)
  (using MotionKitTheme)
  (using LayoutMotionTheme)
  (prop + title _ (= ""))
  (prop + hue Index (= 0))
  (prop + is-open _ (= false))
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• stack-bar)
      (= background (call motion-glow #hue))
      (<> Label
        (= text #title)
      )
    )
  )
)

(fn-expr _ layout-tiles (list GridTile)
  (param count Index)
  (in (call GridTile each each) (.. 1 count))
)
