(import ./motion-kit)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /math/easing)
(import /math/motion)
(import /time/duration)
(import /units)

(style KeyframesTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxCursor)
  (using GUIBoxPaint)
  (using GUIBoxTransform)
  (using MotionKitTheme)
  (rule keyframe-row (• flex-row) (• flex 1) (• gap 14))
  (blank)
  (rule keyframe-tile (• motion-card) (• flex 1) (• p 12)
    (= cursor (. CursorStyle pointing-hand))
    (= motion gui-motion-quick)
    (blank)
    (when-style #is-hover-within
      (= border-color gui-accent-bright-color)
    )
  )
  (blank)
  (rule keyframe-stage (• motion-well) (• motion-clip) (• flex-row) (• items-center) (• justify-center) (• flex 1))
  (blank)
  (rule keyframe-shape
    (= corner-radius 14)
    (= shadow (call Shadow (call RGBA "#00000066") 10 0 6))
  )
  (blank)
  (keyframes heartbeat animation 1000ms
    (= repeat (call (. Repeat times) 2))
    (track scale
      (at 0% 1)
      (at 14% 1.3)
      (at 28% 1)
      (at 42% 1.22)
      (at 70% 1)
      (at 100% 1)
    )
  )
  (blank)
  (keyframes rubber animation 900ms
    (track scale
      (at 0% 1)
      (at 22% 1.32)
      (at 40% 0.8)
      (at 56% 1.14)
      (at 72% 0.94)
      (at 100% 1)
    )
    (track rotate
      (at 0% 0)
      (at 22% -0.14)
      (at 56% 0.08)
      (at 100% 0)
    )
  )
  (blank)
  (keyframes turn-over animation 640ms
    (= repeat (call (. Repeat times) 2))
    (= direction (. AnimationDirection alternate))
    (range rotate 0 π (:motion (call ease-in-out 640ms)))
    (track background-color
      (at 0% (call RGBA "#a855f7"))
      (at 49% (call RGBA "#a855f7"))
      (at 51% (call RGBA "#f59e0b"))
      (at 100% (call RGBA "#f59e0b"))
    )
  )
  (blank)
  (keyframes wiggle animation 700ms
    (track rotate
      (at 0% 0)
      (at 15% -0.4)
      (at 30% 0.34)
      (at 45% -0.24)
      (at 60% 0.16)
      (at 78% -0.07)
      (at 100% 0)
    )
  )
  (blank)
  (keyframes drop-in animation 1000ms
    (range translate (call Point 0 -120) _ (:motion (call spring 760ms 0.55)))
    (range opacity 0%% _ (:motion (call ease-out 180ms)))
  )
  (blank)
  (keyframes launch animation 1700ms
    (track translate
      (at 0% (call Point 0 0))
      (at 16% (call Point 0 12) (:easing (. Easing ease-out)))
      (at 52% (call Point 40 -170) (:easing (. Easing ease-in)))
      (at 53% (call Point -40 170))
      (at 100% (call Point 0 0) (:easing (. Easing ease-out)))
    )
    (track rotate
      (at 0% 0)
      (at 16% -0.18)
      (at 52% 0.6)
      (at 53% -0.6)
      (at 100% 0 (:easing (. Easing ease-out)))
    )
    (track opacity
      (at 0% 1%%)
      (at 42% 1%%)
      (at 52% 0%%)
      (at 60% 0%%)
      (at 80% 1%%)
      (at 100% 1%%)
    )
  )
  (blank)
  (keyframes swing animation 900ms
    (= repeat (. Repeat forever))
    (= direction (. AnimationDirection alternate))
    (range rotate -0.55 0.55 (:motion (call ease-in-out 900ms)))
  )
  (blank)
  (keyframes jelly animation 900ms
    (track transform
      (at 0% (call Matrix 1 0 0 1 0 0))
      (at 18% (call Matrix 1.25 0 0 0.78 0 0))
      (at 36% (call Matrix 0.84 0 0.22 1.18 0 0))
      (at 52% (call Matrix 1.1 0 -0.16 0.92 0 0))
      (at 68% (call Matrix 0.96 0 0.08 1.05 0 0))
      (at 84% (call Matrix 1.02 0 -0.03 0.99 0 0))
      (at 100% (call Matrix 1 0 0 1 0 0))
    )
  )
  (blank)
  (keyframes flip animation 700ms
    (= repeat (call (. Repeat times) 2))
    (= direction (. AnimationDirection alternate))
    (track transform
      (at 0% (call Matrix 1 0 0 1 0 0))
      (at 50% (call Matrix 0 0 0 1.1 0 0) (:easing (. Easing ease-in)))
      (at 100% (call Matrix 1 0 0 1 0 0) (:easing (. Easing ease-out)))
    )
    (track background-color
      (at 0% (call RGBA "#0ea5e9"))
      (at 49% (call RGBA "#0ea5e9"))
      (at 51% (call RGBA "#ec4899"))
      (at 100% (call RGBA "#ec4899"))
    )
  )
  (blank)
  (keyframes bounce animation 1300ms
    (track translate
      (at 0% (call Point 0 0))
      (at 28% (call Point 0 -38) (:easing (. Easing ease-out)))
      (at 56% (call Point 0 0) (:easing (. Easing ease-in)))
      (at 72% (call Point 0 -14) (:easing (. Easing ease-out)))
      (at 86% (call Point 0 0) (:easing (. Easing ease-in)))
      (at 100% (call Point 0 0))
    )
    (track transform
      (at 0% (call Matrix 1 0 0 1 0 0))
      (at 6% (call Matrix 1.2 0 0 0.8 0 5))
      (at 14% (call Matrix 0.86 0 0 1.16 0 -4))
      (at 28% (call Matrix 1 0 0 1 0 0))
      (at 50% (call Matrix 0.9 0 0 1.12 0 -3))
      (at 56% (call Matrix 1.26 0 0 0.74 0 7))
      (at 64% (call Matrix 1 0 0 1 0 0))
      (at 86% (call Matrix 1.12 0 0 0.88 0 3))
      (at 92% (call Matrix 1 0 0 1 0 0))
      (at 100% (call Matrix 1 0 0 1 0 0))
    )
  )
  (blank)
  (keyframes tint animation 2400ms
    (= repeat (. Repeat forever))
    (track background-color
      (at 0% (call RGBA "#f97316"))
      (at 25% (call RGBA "#eab308"))
      (at 50% (call RGBA "#22c55e"))
      (at 75% (call RGBA "#0ea5e9"))
      (at 100% (call RGBA "#f97316"))
    )
  )
)

(type + KeyframesPanel (is Box)
  (using MotionKitTheme)
  (using KeyframesTheme)
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Keyframe animations")
        (= lede "Declared in a style sheet as tracks of stops or ranges, and started with play(\$name). Click a tile to play it; click a looping one again to stop it.")
      )
      (<> Box (• keyframe-row) (• mt 18)
        (<> KeyframeTile (id: spin-tile)
          (= title "Spin")
          (= code "repeat forever")
          (= hue 0)
          (= animation $spin)
        )
        (<> KeyframeTile (id: shake-tile)
          (= title "Shake")
          (= code "shape shake:10")
          (= hue 1)
          (= animation (shape $shake 10))
        )
        (<> KeyframeTile (id: pop-tile)
          (= title "Pop in")
          (= code "per-track motion")
          (= hue 2)
          (= animation $pop-in)
        )
        (<> KeyframeTile (id: breathe-tile)
          (= title "Breathe")
          (= code "alternate, forever")
          (= hue 3)
          (= animation $breathe)
        )
        (<> KeyframeTile (id: jelly-tile)
          (= title "Jelly")
          (= code "transform stops")
          (= hue 7)
          (= animation $jelly)
        )
      )
      (<> Box (• keyframe-row) (• mt 14)
        (<> KeyframeTile (id: heartbeat-tile)
          (= title "Heartbeat")
          (= code "scale stops, twice")
          (= hue 7)
          (= animation $heartbeat)
        )
        (<> KeyframeTile (id: rubber-tile)
          (= title "Rubber")
          (= code "scale and rotate stops")
          (= hue 4)
          (= animation $rubber)
        )
        (<> KeyframeTile (id: turn-tile)
          (= title "Turn over")
          (= code "alternate, twice")
          (= hue 6)
          (= is-plain true)
          (= animation $turn-over)
        )
        (<> KeyframeTile (id: wiggle-tile)
          (= title "Wiggle")
          (= code "rotate stops")
          (= hue 5)
          (= animation $wiggle)
        )
        (<> KeyframeTile (id: flip-tile)
          (= title "Flip")
          (= code "matrix and color")
          (= hue 4)
          (= is-plain true)
          (= animation $flip)
        )
      )
      (<> Box (• keyframe-row) (• mt 14)
        (<> KeyframeTile (id: drop-tile)
          (= title "Drop in")
          (= code "lands on a spring")
          (= hue 2)
          (= animation $drop-in)
        )
        (<> KeyframeTile (id: launch-tile)
          (= title "Launch")
          (= code "three tracks")
          (= hue 0)
          (= animation $launch)
        )
        (<> KeyframeTile (id: swing-tile)
          (= title "Swing")
          (= code "eased range, forever")
          (= hue 4)
          (= is-tall true)
          (= animation $swing)
        )
        (<> KeyframeTile (id: tint-tile)
          (= title "Tint")
          (= code "color stops in OKLab")
          (= hue 0)
          (= is-plain true)
          (= animation $tint)
        )
        (<> KeyframeTile (id: bounce-tile)
          (= title "Bounce")
          (= code "squash and stretch")
          (= hue 1)
          (= animation $bounce)
        )
      )
    )
  )
)

(type + KeyframeTile (is Box)
  (using MotionKitTheme)
  (using KeyframesTheme)
  (prop + title _ (= ""))
  (prop + code _ (= ""))
  (prop + hue Index (= 0))
  (prop + is-plain _ (= false))
  (prop + is-tall _ (= false))
  (prop + animation (? KeyframeAnimation) (= null))
  (blank)
  (prop _ run (? KeyframeRun))
  (content
    (<> This (• keyframe-tile)
      (<> Box (• keyframe-stage)
        (<> Box (id: shape) (• keyframe-shape)
          (= min-width (call (. SizeSpec coord) (if-expr #is-tall 22 52)))
          (= max-width (call (. SizeSpec coord) (if-expr #is-tall 22 52)))
          (= min-height (call (. SizeSpec coord) (if-expr #is-tall 84 52)))
          (= max-height (call (. SizeSpec coord) (if-expr #is-tall 84 52)))
          (= corner-radius (if-expr #is-tall 11 14))
          (= transform-origin (if-expr #is-tall (call Point 0.5 0) (call Point 0.5 0.5)))
          (= translate (call Point 0 (if-expr #is-tall -20 0)))
          (= background (if-expr #is-plain null (call motion-glow #hue)))
          (= background-color (call motion-hue #hue))
        )
      )
      (<> Box (• flex-row) (• items-center) (• mt 8)
        (<> Label (• motion-label) (• flex 1)
          (= text #title)
        )
        (<> Label (• motion-tag)
          (= text #code)
        )
      )
    )
  )
  (subscribe-for (on event click)
    (call toggle)
  )
  (fn-do + toggle _
    (let running run)
    (if (and running (not (. running is-done)))
      (call (. running cancel))
      (= run null)
      (return)
    )
    (let chosen animation)
    (return-if (if (not chosen)))
    (= run (call (. shape play) chosen))
  )
)
