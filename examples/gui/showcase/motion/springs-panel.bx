(import ./motion-kit)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ lane-reach _ (= 420.0))

(type + SpringsLane (is Tuple)
  (prop + title String)
  (prop + code String)
  (prop + motion Motion)
)

(style SpringsTheme
  (using GUIDefaultTheme)
  (using MotionKitTheme)
  (rule springs-lane (• flex-row) (• items-center) (• mt 10))
  (blank)
  (rule springs-track (• motion-well) (• flex-row) (• items-center) (• w 476) (• h 48) (• px 6))
  (blank)
  (rule springs-puck (• w 36) (• h 36)
    (= corner-radius 18)
  )
  (blank)
  (rule chase-dot
    (= corner-radius 999)
  )
)

(type + SpringsPanel (is Box)
  (using MotionKitTheme)
  (using SpringsTheme)
  (prop + is-far _ (= false))
  (prop + lanes (list SpringsLane) (= (call springs-lanes)))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Every motion is a value")
        (= lede
          (paragraph
            "One target change, six motions. Press Go again while they travel: springs turn around with the speed they had, and curves blend into the new target."
          )
        )
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Same change, six motions")
          (for (in index (..< 0 (. lanes length)))
            (<> Box (• springs-lane)
              (<> Box (• flex-col) (• w 170)
                (<> Label (• motion-label)
                  (= text (. ([] lanes index) title))
                )
                (<> Label (• motion-tag) (• mt 2)
                  (= text (. ([] lanes index) code))
                )
              )
              (<> Box (• springs-track)
                (<> Box (• springs-puck)
                  (= background (call motion-glow index))
                  (= (. motion translate) (. ([] lanes index) motion))
                  (= translate (call Point (if-expr #is-far lane-reach 0) 0))
                )
              )
            )
          )
          (<> Box (• flex-row) (• mt 18)
            (<> Button (id: go-button) (text: "Go")
              (= action (=> () :do (call go)))
            )
          )
        )
        (<> MotionCard (text: "Chase the pointer") (• flex 1)
          (= note
            (paragraph
              "Each dot is animated(#target, spring(…)) with its own duration and bounce. Move the pointer through the field."
            )
          )
          (<> ChaseField (id: chase) (• motion-well) (• flex 1) (• mt 12))
        )
      )
    )
  )
  (fn-do + go _
    (= is-far (not is-far))
  )
)

(type + ChaseField (is Box)
  (using MotionKitTheme)
  (using SpringsTheme)
  (prop + target _ (= (call Point 160 140)))
  (content
    (<> This
      (<> Box (• chase-dot) (• absolute) (• w 34) (• h 34)
        (= background-color (call motion-hue 4))
        (= translate (call centered (call animated #target (call spring 240ms)) 17))
      )
      (<> Box (• chase-dot) (• absolute) (• w 26) (• h 26)
        (= background-color (call motion-hue 5))
        (= translate (call centered (call animated #target (call spring 600ms 0.25)) 13))
      )
      (<> Box (• chase-dot) (• absolute) (• w 18) (• h 18)
        (= background-color (call motion-hue 7))
        (= translate (call centered (call animated #target (call spring 1100ms 0.35)) 9))
      )
    )
  )
  (subscribe-for (on event pointer-move)
    (= target (. event point))
  )
)

(fn-expr _ centered Point
  (param point Point)
  (param radius Length)
  (call Point (- (. point x) radius) (- (. point y) radius))
)

(fn-expr _ springs-lanes (list SpringsLane)
  (item (call SpringsLane "Spring" "spring(320ms)" (call spring 320ms)))
  (item (call SpringsLane "Bouncy spring" "spring(600ms, 0.45)" (call spring 600ms 0.45)))
  (item (call SpringsLane "Ease in-out" "ease-in-out(700ms)" (call ease-in-out 700ms)))
  (item (call SpringsLane "Cubic bezier" "cubic-bezier(800ms, …)" (call cubic-bezier 800ms 0.68 -0.6 0.32 1.6)))
  (item (call SpringsLane "Steps" "steps(700ms, 7)" (call steps 700ms 7)))
  (item (call SpringsLane "Linear" "linear(700ms)" (call linear 700ms)))
)
