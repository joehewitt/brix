(import ./motion-kit)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ article-reach _ (= 649.0))
(prop _ article-width _ (= 518.0))
(prop _ comet-size _ (= 52.0))
(prop _ comet-inset _ (= 30.0))
(prop _ voyage-stops _ (= (list (call Point 0 250) (call Point 120 50) (call Point 240 200) (call Point 360 30) (call Point 470 190))))

(type + ArticleChapter (is Tuple)
  (prop + title String)
  (prop + copy String)
)

(style TimelinesTheme
  (using GUIDefaultTheme)
  (using MotionKitTheme)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxTransform)
  (keyframes hero-recede animation 1s
    (range translate (call Point 0 0) (call Point 0 90))
    (range scale 1 0.86)
    (range opacity 1%% 0%%)
  )
  (blank)
  (keyframes compact-in animation 1s
    (range translate (call Point 0 10) (call Point 0 0))
    (range opacity 0%% 1%%)
  )
  (blank)
  (keyframes divider-in animation 1s
    (range opacity 0%% 1%%)
  )
  (blank)
  (keyframes read-progress animation 1s
    (range translate (call Point (- article-width) 0) (call Point 0 0))
  )
  (blank)
  (keyframes voyage animation 1600ms
    (= repeat (. Repeat forever))
    (= direction (. AnimationDirection alternate))
    (track translate
      (at 0% ([] voyage-stops 0))
      (at 25% ([] voyage-stops 1))
      (at 50% ([] voyage-stops 2))
      (at 75% ([] voyage-stops 3))
      (at 100% ([] voyage-stops 4))
    )
    (range rotate 0 (* 2 π))
    (track scale
      (at 0% 0.7)
      (at 50% 1.3)
      (at 100% 0.8)
    )
    (track background-color
      (at 0% (call RGBA "#f97316"))
      (at 33% (call RGBA "#ec4899"))
      (at 66% (call RGBA "#6366f1"))
      (at 100% (call RGBA "#14b8a6"))
    )
    (track corner-radius
      (at 0% 8)
      (at 50% 26)
      (at 100% 8)
    )
  )
  (blank)
  (rule article-card (• motion-card) (• w 520) (• h 560) (• p 0))
  (blank)
  (rule article-scroller (• flex-col) (• flex 1) (• mt 53) (• px 14) (• pb 14)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule article-hero (• flex-col) (• justify-end) (• h 170) (• p 22)
    (= corner-radius 14)
    (= animation hero-recede)
    (= timeline (call scroll-timeline (.. 0 190)))
  )
  (blank)
  (rule article-hero-title (• text "#ffffff")
    (= font-size 30)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule article-hero-copy (• text "#ffffffd9") (• mt 4)
    (= font-size 14)
  )
  (blank)
  (rule article-section (• flex-row) (• h 72) (• mt 12) (• p 16) (• bg gui-well-color)
    (= corner-radius 12)
  )
  (blank)
  (rule article-badge (• w 10) (• h 10) (• mt 4) (• mr 14)
    (= corner-radius 5)
  )
  (blank)
  (rule article-section-copy (• text gui-muted-text-color) (• mt 6)
    (= font-size 13)
    (= line-spacing 3)
    (= text-wrap (. TextWrap word))
  )
  (blank)
  (rule article-header (• absolute) (• flex-row) (• items-center) (• h 52) (• px 20))
  (blank)
  (rule article-compact (• motion-card-title)
    (= animation compact-in)
  )
  (blank)
  (rule article-rule (• absolute) (• motion-clip) (• h 3))
  (blank)
  (rule article-divider (• absolute) (• h 1) (• bg gui-border-color)
    (= animation divider-in)
  )
  (blank)
  (rule article-progress (• absolute) (• h 3) (• w 518)
    (= animation read-progress)
  )
  (blank)
  (rule voyage-stage (• motion-well) (• motion-clip) (• flex 1) (• mt 14))
  (blank)
  (rule voyage-stop (• absolute) (• w 12) (• h 12) (• bg gui-border-color)
    (= corner-radius 6)
  )
  (blank)
  (rule voyage-comet (• absolute) (• w 52) (• h 52) (• bg "#f97316")
    (= animation voyage)
    (= shadow (call Shadow (call RGBA "#00000066") 18 0 6))
  )
  (blank)
  (rule voyage-readout (• motion-label) (• w 56) (• ml 14)
    (= text-alignment (. TextAlignment right))
  )
)

(type + TimelinesPanel (is Box)
  (using MotionKitTheme)
  (using TimelinesTheme)
  (prop + amount _ (= 0.0))
  (prop + is-playing _ (= false))
  (prop + chapters (list ArticleChapter) (= (call article-chapters)))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Animations that follow something other than time")
        (= lede "A timeline drives an animation by progress instead of the clock. Scroll the article, or drag the slider to scrub a keyframe animation back and forth.")
      )
      (<> Box (• motion-row)
        (<> Box (• article-card)
          (<> Box (id: article) (• article-scroller)
            (<> Box (• article-hero)
              (= background (call MotionGradient (call motion-hue 5) (call motion-hue 7)))
              (<> Label (text: "Motion, made of values") (• article-hero-title))
              (<> Label (text: "Scroll to watch this header recede.") (• article-hero-copy))
            )
            (for (in index (..< 0 (. chapters length)))
              (<> Box (• article-section)
                (<> Box (• article-badge)
                  (= background-color (call motion-hue index))
                )
                (<> Box (• flex-col) (• flex 1)
                  (<> Label (• motion-card-title)
                    (= text (. ([] chapters index) title))
                  )
                  (<> Label (• article-section-copy)
                    (= text (. ([] chapters index) copy))
                  )
                )
              )
            )
          )
          (<> Box (• article-header)
            (= left (call (. PositionOffset coord) 0))
            (= right (call (. PositionOffset coord) 0))
            (= top (call (. PositionOffset coord) 0))
            (<> Label (text: "Motion, made of values") (• article-compact)
              (= timeline (call scroll-timeline (.. 150 210) article))
            )
            (<> Box (• flex 1))
            (<> Label (text: "8 chapters") (• motion-tag))
          )
          (<> Box (• article-rule)
            (= left (call (. PositionOffset coord) 0))
            (= right (call (. PositionOffset coord) 0))
            (= top (call (. PositionOffset coord) 51))
            (<> Box (• article-divider)
              (= left (call (. PositionOffset coord) 0))
              (= right (call (. PositionOffset coord) 0))
              (= top (call (. PositionOffset coord) 1))
              (= timeline (call scroll-timeline (.. 170 230) article))
            )
            (<> Box (• article-progress)
              (= left (call (. PositionOffset coord) 0))
              (= top (call (. PositionOffset coord) 0))
              (= background (call MotionGradient (call motion-hue 4) (call motion-hue 7)))
              (= timeline (call scroll-timeline (.. 0 article-reach) article))
            )
          )
        )
        (<> MotionCard (text: "Scrub a keyframe animation") (• flex 1)
          (= note "One animation with translate, rotate, scale, color and corner tracks. progress-timeline(#amount) samples all of them at the slider's value. Play hands it back to the clock.")
          (<> Box (• voyage-stage)
            (<> VoyagePath (• absolute) (• cover .parent))
            (for (in index (..< 0 (. voyage-stops length)))
              (<> Box (• voyage-stop)
                (= left (call (. PositionOffset coord) (- (. (call stop-center index) x) 6)))
                (= top (call (. PositionOffset coord) (- (. (call stop-center index) y) 6)))
              )
            )
            (<> Box (id: comet) (• voyage-comet)
              (= left (call (. PositionOffset coord) comet-inset))
              (= top (call (. PositionOffset coord) comet-inset))
              (= timeline (call scrub-timeline #is-playing #amount))
            )
          )
          (<> Box (• flex-row) (• items-center) (• mt 14)
            (<> Slider (id: scrubber) (• flex 1) (• h 24)
              (= minimum 0)
              (= maximum 1)
              (= value #amount)
              (for (on event value-changing)
                (call scrub (. event value))
              )
              (for (on event value-changed)
                (call scrub (. event value))
              )
            )
            (<> Label (• voyage-readout)
              (= text (str (as (call round (* #amount 100)) Int) "%"))
            )
            (<> Button (id: play-button) (text: "Play") (• ml 14)
              (= action (=> () :do (call play)))
            )
          )
        )
      )
    )
  )
  (fn-do + scrub _
    (param value F64)
    (= is-playing false)
    (= amount value)
  )
  (fn-do + play _
    (= is-playing true)
  )
)

(type + VoyagePath (is Box)
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call RGBA "#ffffff2e"))
      (= (. canvas stroke-width) 2)
      (= (. canvas stroke-dash) 6)
      (call (. canvas begin))
      (let first (call stop-center 0))
      (call (. canvas move) (+ (. bounds x) (. first x)) (+ (. bounds y) (. first y)))
      (for (in index (..< 1 (. voyage-stops length)))
        (let next (call stop-center index))
        (call (. canvas line) (+ (. bounds x) (. next x)) (+ (. bounds y) (. next y)))
      )
      (call (. canvas end))
    )
  )
)

(fn-expr _ stop-center Point
  (param index Index)
  (call Point
    (block
      (arg (+ comet-inset (/ comet-size 2) (. ([] voyage-stops index) x)))
      (arg (+ comet-inset (/ comet-size 2) (. ([] voyage-stops index) y)))
    )
  )
)

(fn-expr _ scrub-timeline (? AnimationTimeline)
  (param is-playing Bool)
  (param amount F64)
  (only-if (call progress-timeline amount) (if (not is-playing)))
)

(fn-expr _ article-chapters (list ArticleChapter)
  (bullet (call ArticleChapter "Springs" "Targets change and springs carry their speed into the new one, so an interrupted motion turns around instead of restarting."))
  (bullet (call ArticleChapter "Keyframes" "A theme declares an animation with tracks and stops. A rule names it, and code can play it and wait for it to finish."))
  (bullet (call ArticleChapter "Enter and leave" "Removed nodes stay until their leave has played. Siblings close the gap under their own size motion."))
  (bullet (call ArticleChapter "Layout motion" "A box that layout moves travels from its old frame. The scene re-composites it without repainting a pixel."))
  (bullet (call ArticleChapter "Shared elements" "Two boxes with one match key hand off: the new one flies from where the old one was, above every clip."))
  (bullet (call ArticleChapter "Drag to reorder" "A carried item follows the pointer while its siblings make room, then lands at the speed it was thrown."))
  (bullet (call ArticleChapter "Timelines" "This article: the header, the title above and the bar at the top are all sampled from the scroll offset."))
  (bullet (call ArticleChapter "Animated values" "A computed number moves with animated(target, motion), right in the markup attribute that shows it."))
)
