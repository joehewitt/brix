(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/painter)
(import /math)
(import /units)
(blank)
(prop + motion-hues _
  (=
    (call List
      (block
        (item (call RGBA "#f97316"))
        (item (call RGBA "#f59e0b"))
        (item (call RGBA "#22c55e"))
        (item (call RGBA "#14b8a6"))
        (item (call RGBA "#0ea5e9"))
        (item (call RGBA "#6366f1"))
        (item (call RGBA "#a855f7"))
        (item (call RGBA "#ec4899"))
      )
    )
  )
)

(style MotionKitTheme
  (using GUIDefaultTheme)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxTransform)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxPlacement)
  (using GUIBoxScroll)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextPaint)
  (rule motion-page (• flex-col) (• flex 1) (• p 28)
    (= font-size 13)
  )
  (blank)
  (rule motion-row (• flex-row) (• flex 1) (• mt 20) (• gap 18))
  (blank)
  (rule motion-title (• text gui-strong-text-color)
    (= font-size 26)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule motion-lede (• text gui-muted-text-color) (• mt 6)
    (= font-size 14)
    (= text-wrap (. TextWrap word))
  )
  (blank)
  (rule motion-card (• flex-col) (• bg gui-panel-color) (• p 18)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 16)
  )
  (blank)
  (rule motion-card-title (• text gui-strong-text-color)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule motion-note (• text gui-muted-text-color)
    (= font-size 12)
    (= text-wrap (. TextWrap word))
  )
  (blank)
  (rule motion-caption (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule motion-label (• text gui-strong-text-color)
    (= font-size 13)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule motion-well (• bg gui-well-color)
    (= corner-radius 12)
  )
  (blank)
  (rule motion-clip
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (rule motion-tag (• text gui-muted-text-color)
    (= font-size 11)
    (= font-weight (. FontWeight bold))
  )
)

(type + MotionHeader (is Box)
  (using MotionKitTheme)
  (prop + title _ (= ""))
  (prop + lede _ (= ""))
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• flex-row) (• items-end)
      (<> Box (• flex-col) (• flex 1)
        (<> Label (• motion-title)
          (= text #title)
        )
        (<> Label (• motion-lede)
          (= text #lede)
        )
      )
    )
  )
)

(type + MotionCard (is Box)
  (using MotionKitTheme)
  (prop + title _ (= ""))
  (prop + note _ (= ""))
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• motion-card)
      (<> Label (• motion-card-title)
        (= text #title)
      )
      (if (!= #note "")
        (<> Label (• motion-note) (• mt 4)
          (= text #note)
        )
      )
    )
  )
)

(type + MotionGradient (is Painter)
  (prop + from RGBA)
  (prop + to RGBA)
  (fn-do + This _
    (param from _)
    (param to _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (call (. canvas fill-gradient)
      (block
        (arg rect)
        (arg (call linear-gradient (call Point (. rect x) (. rect y)) (call Point (. rect right) (. rect bottom)) from to))
      )
    )
  )
)

(fn-expr + motion-hue RGBA
  (param index Index)
  ([] motion-hues (% index (. motion-hues length)))
)

(fn-expr + motion-glow MotionGradient
  (param index Index)
  (call MotionGradient (call motion-hue index) (call motion-hue (+ index 1)))
)
