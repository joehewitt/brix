(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ shared-track-names _ (= (list "Undertow" "Glass Hours" "Satellite Hearts" "Fold" "Warm Static" "Night Bus" "Afterglow" "Small Weather" "Kites" "Halflight" "Vapor Trail" "Lantern")))

(type + SharedAlbum (is Tuple)
  (prop + id Int)
  (prop + title String)
  (prop + artist String)
  (prop + year Int)
  (prop + hue Index)
)

(style SharedTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (prop + shared-flight Motion (= (call spring 560ms 0.16)))
  (blank)
  (rule album-grid (• gap 22)
    (= layout
      (call GridLayout
        (block
          (arg (list (call (. GridTrack flex) 1) (call (. GridTrack flex) 1) (call (. GridTrack flex) 1) (call (. GridTrack flex) 1)))
        )
      )
    )
  )
  (blank)
  (rule album-tile (• flex-col)
    (= (. motion translate) gui-motion-quick)
    (blank)
    (when-style #is-hovered
      (= translate (call Point 0 -4))
    )
  )
  (blank)
  (rule album-art
    (= corner-radius 14)
    (= shadow (call Shadow (call RGBA "#00000059") 16 0 6))
    (= (. motion layout) shared-flight)
  )
  (blank)
  (rule album-title (• text gui-strong-text-color)
    (= font-size 14)
    (= font-weight (. FontWeight semibold))
    (= align-x (. Alignment start))
    (= resize-content (. ResizeContent scale))
    (= match-content (. MatchContent crossfade))
    (= (. motion layout) shared-flight)
  )
  (blank)
  (rule AlbumTile
    (when-style #is-picked
      (rule album-art
        (= opacity 0%%)
      )
      (blank)
      (rule album-title
        (= opacity 0%%)
      )
    )
  )
  (blank)
  (rule AlbumRow
    (when-style #is-picked
      (rule album-art
        (= opacity 0%%)
      )
      (blank)
      (rule album-title
        (= opacity 0%%)
      )
    )
  )
  (blank)
  (rule album-artist (• motion-caption)
    (= (. motion opacity) (call ease-out 260ms))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
    )
  )
  (blank)
  (rule album-list (• flex-col))
  (blank)
  (rule album-row (• flex-row) (• items-center) (• h 60) (• mb 6) (• px 6)
    (= corner-radius 12)
    (= (. motion background-color) gui-motion-quick)
    (blank)
    (when-style #is-hovered
      (• bg gui-hover-color)
    )
  )
  (blank)
  (rule album-year (• motion-caption) (• mr 10)
    (= (. motion opacity) (call ease-out 260ms))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
    )
  )
  (blank)
  (rule album-scrim (• bg gui-panel-color)
    (= corner-radius 16)
    (= (. motion opacity) (call ease-out 220ms))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
    )
  )
  (blank)
  (rule detail-art
    (= corner-radius 26)
    (= shadow (call Shadow (call RGBA "#0000008c") 34 0 14))
    (= (. motion layout) shared-flight)
  )
  (blank)
  (rule detail-title (• text gui-strong-text-color)
    (= font-size 34)
    (= font-weight (. FontWeight bold))
    (= align-x (. Alignment start))
    (= resize-content (. ResizeContent scale))
    (= match-content (. MatchContent crossfade))
    (= (. motion layout) shared-flight)
  )
  (blank)
  (rule detail-fade
    (= motion gui-motion-smooth)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 0 10))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= (. motion opacity) (call ease-out 120ms))
    )
  )
  (blank)
  (rule detail-tracks (• flex-col)
    (= motion-stagger 45ms)
  )
  (blank)
  (rule detail-track (• flex-row) (• items-center) (• h 36)
    (= border-color gui-border-color)
    (= border-bottom-width 1)
    (= motion gui-motion-smooth)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 24 0))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= (. motion opacity) (call ease-out 100ms))
    )
  )
  (blank)
  (rule detail-track-title (• text gui-text-color) (• flex 1)
    (= font-size 14)
  )
)

(type + SharedPanel (is Box)
  (using MotionKitTheme)
  (using SharedTheme)
  (prop + albums (list SharedAlbum) (= (call shared-albums)))
  (prop + open-id _ (= -1))
  (prop + shown-id _ (= 0))
  (prop + is-list _ (= false))
  (prop + is-open _ (= (>= #open-id 0)))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Shared elements")
        (= lede
          (paragraph
            "Two boxes with one match key: when one goes and the other arrives in the same frame, the new one flies from where the old one was. Open an album, or switch the layout."
          )
        )
        (<> (of SegmentedControl Bool) (• ml 24)
          (<-> selected is-list)
          (<> (of Segment Bool) (id: grid-segment) (text: "Grid")
            (= value false)
          )
          (<> (of Segment Bool) (id: list-segment) (text: "List")
            (= value true)
          )
        )
      )
      (<> Box (• motion-card) (• flex 1) (• mt 18)
        (if #is-list
          (<> Box (• album-list)
            (for (in album #albums (keyed-by (. album id)))
              (<> AlbumRow
                (= album album)
                (= open-id #open-id)
              )
            )
          )
          (else
            (<> Box (• album-grid)
              (for (in album #albums (keyed-by (. album id)))
                (<> AlbumTile
                  (= album album)
                  (= open-id #open-id)
                )
              )
            )
          )
        )
        (if #is-open
          (<> Box (• album-scrim) (• absolute) (• cover .parent))
          (<> AlbumDetail (id: detail) (• absolute) (• cover .parent)
            (= album (call album-of #shown-id))
          )
        )
      )
    )
  )
  (fn-do + open _
    (param id Int)
    (= shown-id id)
    (= open-id id)
  )
  (fn-do + dismiss _
    (= open-id -1)
  )
  (fn-do + album-of SharedAlbum
    (param id Int)
    (for (in album albums)
      (return-if album (if (== (. album id) id)))
    )
    (return ([] albums 0))
  )
)

(type + AlbumTile (is Box)
  (using MotionKitTheme)
  (using SharedTheme)
  (prop + album SharedAlbum)
  (prop + open-id _ (= -1))
  (prop + is-picked _ (= (== #open-id (. #album id))))
  (blank)
  (prop _ owner (of Ancestor SharedPanel))
  (content
    (<> This (• album-tile)
      (<> Box (id: art) (• album-art) (• h 168)
        (= background (call motion-glow (. #album hue)))
        (= match (if-expr #is-picked null (str "art-" (. #album id))))
      )
      (<> Label (• album-title) (• mt 10)
        (= text (. #album title))
        (= match (if-expr #is-picked null (str "title-" (. #album id))))
      )
      (<> Label (• album-artist) (• mt 2)
        (= text (. #album artist))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. owner open) (. album id))
  )
)

(type + AlbumRow (is Box)
  (using MotionKitTheme)
  (using SharedTheme)
  (prop + album SharedAlbum)
  (prop + open-id _ (= -1))
  (prop + is-picked _ (= (== #open-id (. #album id))))
  (blank)
  (prop _ owner (of Ancestor SharedPanel))
  (content
    (<> This (• album-row)
      (<> Box (id: art) (• album-art) (• w 48) (• h 48)
        (= background (call motion-glow (. #album hue)))
        (= corner-radius 10)
        (= match (if-expr #is-picked null (str "art-" (. #album id))))
      )
      (<> Box (• flex-col) (• flex 1) (• ml 14)
        (<> Label (• album-title)
          (= text (. #album title))
          (= match (if-expr #is-picked null (str "title-" (. #album id))))
        )
        (<> Label (• album-artist) (• mt 2)
          (= text (. #album artist))
        )
      )
      (<> Label (• album-year)
        (= text (str (. #album year)))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. owner open) (. album id))
  )
)

(type + AlbumDetail (is Box)
  (using MotionKitTheme)
  (using SharedTheme)
  (prop + album SharedAlbum)
  (blank)
  (prop _ owner (of Ancestor SharedPanel))
  (content
    (<> This (• flex-row) (• p 28)
      (<> Box (• detail-art) (• w 360) (• h 360)
        (= background (call motion-glow (. #album hue)))
        (= match (str "art-" (. #album id)))
      )
      (<> Box (• flex-col) (• flex 1) (• ml 34)
        (<> Box (• flex-row) (• items-center)
          (<> Label (text: "ALBUM") (• motion-tag) (• detail-fade) (• flex 1))
          (<> Button (id: close-button) (text: "Close") (• detail-fade)
            (= action (=> () :do (call (?. owner dismiss))))
          )
        )
        (<> Label (• detail-title) (• mt 6)
          (= text (. #album title))
          (= match (str "title-" (. #album id)))
        )
        (<> Label (• motion-lede) (• detail-fade) (• mt 4)
          (= text (str (. #album artist) " · " (. #album year) " · 6 songs"))
        )
        (<> Box (• detail-tracks) (• mt 22)
          (for (in index (..< 0 6))
            (<> Box (• detail-track)
              (<> Label (• motion-caption) (• w 30)
                (= text (str (+ index 1)))
              )
              (<> Label (• detail-track-title)
                (= text (call shared-track #album index))
              )
              (<> Label (• motion-note)
                (= text (call shared-length #album index))
              )
            )
          )
        )
      )
    )
  )
)

(fn-expr + shared-track String
  (param album SharedAlbum)
  (param index Index)
  ([] shared-track-names (% (+ (* (. album id) 5) (* index 7)) (. shared-track-names length)))
)

(fn-expr + shared-length String
  (param album SharedAlbum)
  (param index Index)
  (str (+ 2 (% (+ (. album id) (* index 3)) 4)) ":" (+ 10 (% (+ (* (. album id) 13) (* index 17)) 50)))
)

(fn-expr _ shared-albums (list SharedAlbum)
  (item (call SharedAlbum 0 "Night Swim" "Harbor Lights" 2021 4))
  (item (call SharedAlbum 1 "Paper Planes" "June Atlas" 2019 0))
  (item (call SharedAlbum 2 "Glasshouse" "Mira Vale" 2023 2))
  (item (call SharedAlbum 3 "Slow Orbit" "The Long Dark" 2018 5))
  (item (call SharedAlbum 4 "Coral" "Seaside Choir" 2022 3))
  (item (call SharedAlbum 5 "Neon Rain" "Static Ghosts" 2020 6))
  (item (call SharedAlbum 6 "Static Bloom" "Pollen" 2024 7))
  (item (call SharedAlbum 7 "Low Tide" "Ferns & Fog" 2017 1))
)
