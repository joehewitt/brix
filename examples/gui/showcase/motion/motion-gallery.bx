(import ./motion-kit)
(import ./motion-stage)
(import /graphics/text)
(import /gui)

(style MotionGalleryTheme
  (using GUIDefaultTheme)
  (using MotionKitTheme)
  (rule motion-toolbar (• flex-row) (• items-center) (• h 44) (• px 16)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule motion-toolbar-label (• text gui-muted-text-color)
    (= font-size 12)
  )
)

(type + MotionGallery (is Box)
  (using MotionKitTheme)
  (using MotionGalleryTheme)
  (prop + current _ (= "springs"))
  (prop + speed _ (= 1.0))
  (prop + reduces-motion _ (= false))
  (prop + entries (list MotionEntry) (= (call motion-entries)))
  (content
    (<> This (• flex-row)
      (<> Sidebar (• w 220)
        (= state-key "motion-gallery")
        (<> SidebarSection (text: "Motion") (• pt 10)
          (for (in entry entries)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
      )
      (<> Box (• flex-col) (• flex 1)
        (<> Box (• motion-toolbar)
          (<> Label (text: "Speed") (• motion-toolbar-label))
          (<> (of SegmentedControl F64) (• ml 8)
            (= selected #speed)
            (for (on event selection-changed)
              (call set-speed (. event value))
            )
            (<> (of Segment F64) (text: "1×")
              (= value 1.0)
            )
            (<> (of Segment F64) (text: "½×")
              (= value 0.5)
            )
            (<> (of Segment F64) (text: "¼×")
              (= value 0.25)
            )
            (<> (of Segment F64) (text: "⅒×")
              (= value 0.1)
            )
          )
          (<> Switch (text: "Reduce motion") (• ml 24)
            (= is-on #reduces-motion)
            (for (on event value-changed)
              (call set-reduces-motion (. event value))
            )
          )
        )
        (<> MotionStage (id: stage) (• flex 1)
          (= current #current)
        )
      )
    )
  )
  (fn-do + show _
    (param id String)
    (= current id)
  )
  (fn-do + set-speed _
    (param value F64)
    (= speed value)
    (let clock frame-clock)
    (if clock
      (= (. clock time-scale) value)
    )
  )
  (fn-do + set-reduces-motion _
    (param value Bool)
    (= reduces-motion value)
    (call (. stage set-theme-tag) "reduce-motion" value)
  )
)
