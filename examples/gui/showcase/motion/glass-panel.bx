(import ./gallery-shaders)
(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/text)
(import /gui)
(import /math/motion)

(style GlassTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule glass-stage (• motion-clip) (• flex 1) (• mt 18)
    (= corner-radius 22)
    (= background-fill (call Stripes (call RGBA "#2f6bff") (call RGBA "#ff5fa8") (:width 18) (:speed 26)))
  )
  (blank)
  (rule glass-art (• absolute) (• cover .parent) (• flex-col) (• items-center) (• justify-center))
  (blank)
  (rule glass-word
    (= font-size 128)
    (= font-weight (. FontWeight heavy))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule glass-layer (• absolute) (• cover .parent) (• flex-col) (• items-center) (• justify-between) (• p 28))
  (blank)
  (rule glass-surface
    (= shadow (call Shadow (call RGBA "#00000038") 18 0 8))
    (= (. motion backdrop) gui-motion-smooth)
  )
  (blank)
  (rule glass-bar (• glass-surface) (• flex-row) (• items-center) (• h 56) (• px 8) (• gap 4)
    (= corner-radius 28)
    (= backdrop-blur 6)
    (= backdrop (call LiquidGlass 28 (:tint (call RGBA "#ffffff2e"))))
  )
  (blank)
  (rule glass-tab (• flex-row) (• items-center) (• h 40) (• px 18)
    (= corner-radius 20)
  )
  (blank)
  (rule glass-tab-on (• bg (call RGBA "#ffffff4d")))
  (blank)
  (rule glass-tab-text
    (= font-size 14)
    (= font-weight (. FontWeight semibold))
    (= color (call RGBA "#0b1530"))
  )
  (blank)
  (rule glass-row (• flex-row) (• gap 24))
  (blank)
  (rule glass-pane (• glass-surface) (• flex-col) (• justify-end) (• w 230) (• h 170) (• p 18)
    (= corner-radius 30)
  )
  (blank)
  (rule glass-clear
    (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#00000014"))))
    (blank)
    (when-style #is-hover-within
      (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#00000014")) (:refraction 16) (:highlight 1)))
    )
  )
  (blank)
  (rule glass-regular
    (= backdrop-blur 12)
    (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#ffffff54"))))
    (blank)
    (when-style #is-hover-within
      (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#ffffff54")) (:refraction 16) (:highlight 1)))
    )
  )
  (blank)
  (rule glass-tinted
    (= backdrop-blur 8)
    (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#0a84ff80")) (:saturation 1.7)))
    (blank)
    (when-style #is-hover-within
      (= backdrop (call LiquidGlass 30 (:tint (call RGBA "#0a84ff80")) (:saturation 1.7) (:refraction 16) (:highlight 1)))
    )
  )
  (blank)
  (rule glass-pane-name
    (= font-size 17)
    (= font-weight (. FontWeight bold))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule glass-pane-hint (• mt 3)
    (= font-size 12)
    (= color (call RGBA "#ffffffd9"))
  )
  (blank)
  (rule glass-pane-dark
    (= color (call RGBA "#0b1530"))
  )
  (blank)
  (rule glass-button (• glass-surface) (• flex-row) (• items-center) (• justify-center) (• w 72) (• h 72)
    (= corner-radius 36)
    (= backdrop-blur 4)
    (= backdrop (call LiquidGlass 36 (:bevel 24) (:tint (call RGBA "#ffffff26"))))
    (= (. motion scale) gui-motion-bouncy)
    (blank)
    (when-style #is-hover-within
      (= backdrop (call LiquidGlass 36 (:bevel 24) (:tint (call RGBA "#ffffff40")) (:highlight 0.9)))
    )
    (blank)
    (when-style #is-press-within
      (= scale 1.15)
      (= backdrop (call LiquidGlass 36 (:bevel 24) (:tint (call RGBA "#ffffff66")) (:refraction 18) (:highlight 1.2)))
    )
  )
  (blank)
  (rule glass-button-text
    (= font-size 30)
    (= font-weight (. FontWeight medium))
    (= color (call RGBA "#0b1530"))
  )
)

(type + LiquidGlassPanel (is Box)
  (using MotionKitTheme)
  (using GlassTheme)
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Liquid glass")
        (= lede "A backdrop shader that bends what's behind it through a rounded bevel, splits its colors at the rim and lights the edge, stacked on backdrop-blur for frost. Hover the panes, and press the button to swell it.")
      )
      (<> Box (• glass-stage)
        (<> Box (• glass-art)
          (<> Label (text: "LIQUID") (• glass-word))
          (<> Label (text: "GLASS") (• glass-word))
        )
        (<> Box (• glass-layer)
          (<> Box (• glass-bar)
            (<> Box (• glass-tab) (• glass-tab-on)
              (<> Label (text: "Library") (• glass-tab-text))
            )
            (<> Box (• glass-tab)
              (<> Label (text: "For You") (• glass-tab-text))
            )
            (<> Box (• glass-tab)
              (<> Label (text: "Browse") (• glass-tab-text))
            )
            (<> Box (• glass-tab)
              (<> Label (text: "Search") (• glass-tab-text))
            )
          )
          (<> Box (• glass-row)
            (<> Box (• glass-pane) (• glass-clear)
              (<> Label (text: "Clear") (• glass-pane-name))
              (<> Label (text: "No blur, a faint shade.") (• glass-pane-hint))
            )
            (<> Box (• glass-pane) (• glass-regular)
              (<> Label (text: "Regular") (• glass-pane-name) (• glass-pane-dark))
              (<> Label (text: "Frosted with a white tint.") (• glass-pane-hint) (• glass-pane-dark))
            )
            (<> Box (• glass-pane) (• glass-tinted)
              (<> Label (text: "Tinted") (• glass-pane-name))
              (<> Label (text: "Frost, accent tint, more saturation.") (• glass-pane-hint))
            )
          )
          (<> Box (• glass-button)
            (<> Label (text: "+") (• glass-button-text))
          )
        )
      )
    )
  )
)
