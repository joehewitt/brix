(import ./motion-kit)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/plus)
(import /gui/icons/lucide/x)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ note-limit _ (= 6))

(type + MotionNote (is Tuple)
  (prop + id Index)
  (prop + title String)
  (prop + body String)
  (prop + hue Index)
)

(type + MotionSwatch (is Tuple)
  (prop + name String)
  (prop + hue RGBA)
  (prop + is-warm Bool)
)

(style EnterLeaveTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule note-stack (• flex-col) (• mt 14)
    (= gap 8)
    (= motion-stagger 60ms)
  )
  (blank)
  (rule note-card (• flex-row) (• items-center) (• bg gui-field-color) (• px 12) (• py 10)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 12)
    (= motion gui-motion-smooth)
    (= (. motion size) gui-motion-smooth)
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= scale 0.92)
      (= translate (call Point 0 -18))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= translate (call Point 48 0))
      (= motion (call spring 520ms))
      (= (. motion size) (call spring 520ms))
    )
  )
  (blank)
  (rule note-icon (• w 34) (• h 34)
    (= corner-radius 10)
  )
  (blank)
  (rule swatch-list (• flex-col) (• mt 14)
    (= gap 6)
    (= motion-stagger 40ms)
  )
  (blank)
  (rule swatch-row (• flex-row) (• items-center) (• bg gui-field-color) (• h 36) (• px 10)
    (= corner-radius 10)
    (= motion (call spring 460ms))
    (= (. motion size) (call spring 460ms))
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point -24 0))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= translate (call Point 24 0))
    )
  )
  (blank)
  (rule swatch-dot (• w 16) (• h 16)
    (= corner-radius 8)
  )
  (blank)
  (rule profile (• flex-col) (• bg gui-field-color) (• mt 14)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 14)
  )
  (blank)
  (rule profile-head (• flex-row) (• items-center) (• p 14))
  (blank)
  (rule avatar (• w 46) (• h 46)
    (= corner-radius 23)
  )
  (blank)
  (rule profile-details (• flex-col) (• px 14) (• pb 6)
    (= motion gui-motion-smooth)
    (= (. motion size) (call spring 560ms 0.3))
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 0 -10))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
    )
  )
  (blank)
  (rule profile-row (• flex-row) (• items-center) (• h 30)
    (= border-color gui-border-color)
    (= border-top-width 1)
  )
  (blank)
  (rule profile-footer (• flex-row) (• items-center) (• bg gui-well-color) (• h 38) (• px 14)
    (= corner-radius 13)
  )
)

(type + EnterLeavePanel (is Box)
  (using MotionKitTheme)
  (using EnterLeaveTheme)
  (prop + notes (list MotionNote) (= ([] (call enter-leave-seed) (..< 0 3))))
  (prop + restorable (list MotionNote))
  (prop + serial Index (= 3))
  (prop + filter _ (= "all"))
  (prop + swatches (list MotionSwatch) (= (call enter-leave-swatches)))
  (prop + is-detail-shown _ (= true))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Things arrive and leave")
        (= lede
          (paragraph
            "Removing a node from markup plays its #is-leaving rules before it goes, and its siblings close the gap. Bring a key back while it leaves and the same node revives."
          )
        )
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Notifications") (• flex 1.3)
          (<> Box (• flex-row) (• mt 12)
            (<> Button (id: add-button) (text: "Add") (• icon-plus)
              (= action (=> () :do (call add)))
            )
            (<> Button (id: clear-button) (text: "Clear all") (• ml 8)
              (= action (=> () :do (call clear)))
            )
            (<> Button (id: undo-button) (text: "Undo") (• ml 8)
              (= action (=> () :do (call undo)))
            )
          )
          (<> Box (• note-stack)
            (for (in note #notes (keyed-by (. note id)))
              (<> NoteCard
                (= note note)
              )
            )
          )
        )
        (<> MotionCard (text: "Filtered list") (• flex 1)
          (<> (of SegmentedControl String) (• mt 12)
            (<-> selected filter)
            (<> (of Segment String) (id: all-segment) (text: "All")
              (= value "all")
            )
            (<> (of Segment String) (id: warm-segment) (text: "Warm")
              (= value "warm")
            )
            (<> (of Segment String) (id: cool-segment) (text: "Cool")
              (= value "cool")
            )
          )
          (<> Box (• swatch-list)
            (for (in swatch (call shown-swatches #swatches #filter) (keyed-by (. swatch name)))
              (<> Box (• swatch-row)
                (<> Box (• swatch-dot)
                  (= background-color (. swatch hue))
                )
                (<> Label (• ml 10)
                  (= text (. swatch name))
                )
              )
            )
          )
        )
        (<> MotionCard (text: "Display") (• flex 1)
          (<> Box (• flex-row) (• mt 12)
            (<> Button (id: detail-button)
              (= title (if-expr #is-detail-shown "Hide details" "Show details"))
              (= action (=> () :do (call toggle-details)))
            )
          )
          (<> Box (• profile)
            (<> Box (• profile-head)
              (<> Box (• avatar)
                (= background (call motion-glow 5))
              )
              (<> Box (• flex-col) (• ml 12) (• flex 1)
                (<> Label (text: "Ada Okafor") (• motion-card-title))
                (<> Label (text: "Motion designer") (• motion-note) (• mt 2))
              )
            )
            (<> Box (• profile-details)
              (= display (if-expr #is-detail-shown (. Display visible) (. Display hidden)))
              (<> ProfileRow
                (= key "Email")
                (= value "ada@example.com")
              )
              (<> ProfileRow
                (= key "Studio")
                (= value "Lagos · Remote")
              )
              (<> ProfileRow
                (= key "Projects")
                (= value "Springs, Flights, Reels")
              )
              (<> ProfileRow
                (= key "Joined")
                (= value "March 2024")
              )
            )
            (<> Box (• profile-footer)
              (<> Box (• w 8) (• h 8)
                (= corner-radius 4)
                (= background-color (call motion-hue 2))
              )
              (<> Label (text: "Active 2 minutes ago") (• motion-note) (• ml 8))
            )
          )
        )
      )
    )
  )
  (fn-do + add _
    (+= serial 1)
    (let seeds (call enter-leave-seed))
    (let seed ([] seeds (% serial (. seeds length))))
    (let made (call MotionNote serial (. seed title) (. seed body) serial))
    (let next (call (of List MotionNote)))
    (+= next made)
    (for (in note notes)
      (if (< (. next length) note-limit)
        (+= next note)
      )
    )
    (= restorable (call (of List MotionNote)))
    (= notes next)
  )
  (fn-do + dismiss _
    (param id Index)
    (= restorable notes)
    (let next (call (of List MotionNote)))
    (for (in note notes)
      (if (!= (. note id) id)
        (+= next note)
      )
    )
    (= notes next)
  )
  (fn-do + clear _
    (= restorable notes)
    (= notes (call (of List MotionNote)))
  )
  (fn-do + undo _
    (return-if (if (== (. restorable length) 0)))
    (blank)
    (= notes restorable)
    (= restorable (call (of List MotionNote)))
  )
  (fn-do + toggle-details _
    (= is-detail-shown (not is-detail-shown))
  )
)

(type + NoteCard (is Box)
  (using MotionKitTheme)
  (using EnterLeaveTheme)
  (prop + note MotionNote)
  (blank)
  (prop _ owner (of Ancestor EnterLeavePanel))
  (content
    (<> This (• note-card)
      (<> Box (• note-icon)
        (= background (call motion-glow (. note hue)))
      )
      (<> Box (• flex-col) (• flex 1) (• ml 12)
        (<> Label (• motion-label)
          (= text (. note title))
        )
        (<> Label (• motion-note) (• mt 2)
          (= text (. note body))
        )
      )
      (<> IconButton (id: dismiss) (• icon-x) (• w 24) (• h 24) (• ml 8)
        (= action (=> () :do (call (?. owner dismiss) (. note id))))
      )
    )
  )
)

(type + ProfileRow (is Box)
  (using MotionKitTheme)
  (using EnterLeaveTheme)
  (prop + key _ (= ""))
  (prop + value _ (= ""))
  (content
    (<> This (• profile-row)
      (<> Label (• motion-caption) (• w 90)
        (= text #key)
      )
      (<> Label (• flex 1)
        (= text #value)
      )
    )
  )
)

(fn-expr _ shown-swatches (list MotionSwatch)
  (param swatches (list MotionSwatch))
  (param filter String)
  (spread swatches)
  (pipe ?> (or (== filter "all") (== (== filter "warm") (. each is-warm))))
  (pipe |> List)
)

(fn-expr _ enter-leave-seed (list MotionNote)
  (item (call MotionNote 1 "Build finished" "motion-app compiled in 14.2s" 0))
  (item (call MotionNote 2 "3 new comments" "On “Layout motion, phase 8”" 4))
  (item (call MotionNote 3 "Deploy to staging" "Rolling out to 12 hosts" 6))
  (item (call MotionNote 4 "Tests passed" "5,605 of 5,605 in 21.5s" 2))
  (item (call MotionNote 5 "Low disk space" "Only 18 GB left on Macintosh HD" 7))
  (item (call MotionNote 6 "Meeting in 5 minutes" "Animation review with the GUI team" 5))
)

(fn-expr _ enter-leave-swatches (list MotionSwatch)
  (item (call MotionSwatch "Tangerine" (call RGBA "#f97316") true))
  (item (call MotionSwatch "Teal" (call RGBA "#14b8a6") false))
  (item (call MotionSwatch "Saffron" (call RGBA "#f59e0b") true))
  (item (call MotionSwatch "Sky" (call RGBA "#0ea5e9") false))
  (item (call MotionSwatch "Rose" (call RGBA "#f43f5e") true))
  (item (call MotionSwatch "Indigo" (call RGBA "#6366f1") false))
  (item (call MotionSwatch "Coral" (call RGBA "#fb7185") true))
  (item (call MotionSwatch "Mint" (call RGBA "#34d399") false))
  (item (call MotionSwatch "Amber" (call RGBA "#fbbf24") true))
  (item (call MotionSwatch "Violet" (call RGBA "#a855f7") false))
)
