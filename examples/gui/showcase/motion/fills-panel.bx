(import ./motion-kit)
(import /graphics/color)
(import /graphics/shader)
(import /graphics/shader-fills)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)

(style FillsTheme
  (using GUIDefaultTheme)
  (using MotionKitTheme)
  (rule fills-strip (• motion-well) (• flex-row) (• items-center) (• h 64) (• px 18) (• mt 12))
  (blank)
  (rule fills-waiting
    (= font-size 20)
    (= color gui-muted-text-color)
    (= text-fill (call Shimmer gui-muted-text-color gui-strong-text-color))
  )
  (blank)
  (rule fills-done
    (= font-size 20)
    (= color gui-strong-text-color)
  )
  (blank)
  (rule fills-quiet
    (= font-size 13)
    (= color gui-muted-text-color)
    (= text-fill (call Shimmer gui-muted-text-color gui-strong-text-color (:band 24) (:speed 80)))
  )
  (blank)
  (rule fills-skeleton (• flex-col) (• p 16) (• gap 10)
    (= corner-radius 12)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule fills-bone (• h 12)
    (= corner-radius 6)
    (= background-fill (call Shimmer gui-divider-color gui-field-color (:band 80) (:speed 220)))
  )
  (blank)
  (rule fills-alert (• flex-row) (• items-center) (• h 64) (• px 18) (• mt 12)
    (= corner-radius 14)
    (= (. motion background-fill) (call ease-in-out 700ms))
  )
  (blank)
  (rule fills-alert-label
    (= font-size 14)
    (= font-weight (. FontWeight semibold))
    (= color (call RGBA "#ffffff"))
  )
  (blank)
  (rule fills-ring (• flex-row) (• items-center) (• h 64) (• px 18) (• mt 12)
    (= corner-radius 14)
    (= border-width 3)
    (= border-fill (call Shimmer gui-accent-color (call RGBA "#8cc8ff") (:band 70) (:speed 180)))
  )
)

(type + FillsPanel (is Box)
  (using MotionKitTheme)
  (using FillsTheme)
  (prop + is-waiting _ (= true))
  (prop + is-urgent _ (= false))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Shader fills")
        (= lede "Text, backgrounds and borders can be filled by a shader. A live fill reads the window's fill clock on the GPU, so each frame repaints only its own rect and records nothing.")
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Shimmer while waiting") (• flex 1)
          (= note "Shimmer sweeps a highlight across the text at 30 frames a second. Turn it off and the label records once, as plain text, and the window stops asking for frames.")
          (<> Box (• fills-strip)
            (if #is-waiting
              (<> Label (text: "Thinking about your question…") (• fills-waiting) (• flex 1))
              (else
                (<> Label (text: "Here is what I found.") (• fills-done) (• flex 1))
              )
            )
            (<> Switch (text: "Waiting") (• ml 12)
              (<-> is-on is-waiting)
            )
          )
        )
        (<> MotionCard (text: "Slower and smaller") (• flex 1)
          (= note "The same shader with a narrower band and a slower sweep.")
          (<> Box (• fills-strip)
            (<> Label (text: "Indexing 1,204 files") (• fills-quiet) (• flex 1))
          )
        )
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Loading placeholders") (• flex 1)
          (= note "Backgrounds take fills too. Each bar stands in for content that has not loaded yet, and each sweeps its own highlight within its rounded shape.")
          (<> Box (• fills-skeleton) (• mt 12)
            (<> Box (• fills-bone) (• w 180))
            (<> Box (• fills-bone))
            (<> Box (• fills-bone) (• w 120))
          )
        )
        (<> MotionCard (text: "A working border") (• flex 1)
          (= note "A border fill paints the ring between the box's outer and inner edges, so the sweep crosses the top and bottom edges together and leaves the inside alone.")
          (<> Box (• fills-ring)
            (<> Label (text: "Searching the web") (• motion-label) (• flex 1))
          )
        )
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Animated parameters") (• flex 1)
          (= note "A fill's parameters follow the box's motion when they change. Here the colors and the band width ease over 700ms while the highlight keeps sweeping. Colors travel as RGBA does, other numbers mix, and whole numbers and flags switch at the start. A fill of another shader replaces it at once.")
          (<> Box (• fills-alert)
            (= background-fill (call alert-fill #is-urgent))
            (<> Label (text: "Deploying to production") (• fills-alert-label) (• flex 1))
            (<> Switch (text: "Urgent") (• ml 12)
              (<-> is-on is-urgent)
            )
          )
        )
      )
    )
  )
)

(fn-expr _ alert-fill ShaderFill
  (param urgent Bool)
  (case? urgent
    (call Shimmer (call RGBA "#b4232a") (call RGBA "#ffc861") (:band 160) (:speed 180))
  )
  (default
    (call Shimmer (call RGBA "#1d4ed8") (call RGBA "#8cc8ff") (:band 60) (:speed 180))
  )
)
