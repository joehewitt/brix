(import ./motion-kit)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)

(type + StyleMood (is U32)
  (variant dawn (= 0))
  (variant ocean (= 1))
  (variant neon (= 2))
)

(style StyleTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxCursor)
  (using MotionKitTheme)
  (rule lift-card (• flex-col) (• bg gui-field-color) (• w 128) (• h 146) (• p 12) (• mr 16)
    (= corner-radius 14)
    (= shadow (call Shadow (call RGBA "#00000030") 3 0 1))
    (= cursor (. CursorStyle pointing-hand))
    (= motion gui-motion-smooth)
    (= (. motion translate) gui-motion-bouncy)
    (= (. motion scale) gui-motion-bouncy)
    (blank)
    (when-style #is-hover-within
      (= translate (call Point 0 -10))
      (= scale 1.04)
      (= shadow (call Shadow (call RGBA "#00000090") 26 0 16))
    )
    (blank)
    (when-style #is-press-within
      (= translate (call Point 0 -3))
      (= scale 0.95)
      (= shadow (call Shadow (call RGBA "#00000060") 8 0 4))
      (= (. motion scale) gui-motion-quick)
    )
  )
  (blank)
  (rule lift-art (• h 76)
    (= corner-radius 10)
  )
  (blank)
  (rule lift-title (• motion-label) (• mt 10))
  (blank)
  (rule mood-tile (• w 64) (• h 64) (• mr 14)
    (= motion gui-motion-smooth)
    (= (. motion rotate) gui-motion-bouncy)
    (= (. motion scale) gui-motion-bouncy)
  )
  (blank)
  (rule mood-name
    (= font-size 30)
    (= font-weight (. FontWeight bold))
    (= motion gui-motion-smooth)
  )
  (blank)
  (rule ticket (• flex-col) (• w 150) (• h 84) (• p 14)
    (= corner-radius 16)
    (= shadow (call Shadow (call RGBA "#00000070") 18 0 10))
    (= (. motion transform) (call spring 560ms 0.42))
  )
  (blank)
  (rule ticket-title (• text (call RGBA "#ffffff"))
    (= font-size 18)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule ticket-note (• text (call RGBA "#ffffffcc")) (• mt 4)
    (= font-size 12)
  )
  (blank)
  (rule control-row (• flex-row) (• items-center) (• h 34))
  (blank)
  (rule disclosure-row (• flex-row) (• items-center) (• h 34)
    (= cursor (. CursorStyle pointing-hand))
  )
  (blank)
  (rule disclosure-detail (• motion-note) (• pl 22)
    (= motion gui-motion-smooth)
  )
)

(type + StylePanel (is Box)
  (using MotionKitTheme)
  (using StyleTheme)
  (prop + mood _ (= (. StyleMood dawn)))
  (prop + is-turned _ (= false))
  (prop + is-grown _ (= false))
  (prop + is-slid _ (= false))
  (prop + shows-advanced _ (= false))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Style motion")
        (= lede "Rules say what a state looks like; motion says how to get there. Hover, press and mood changes all animate from the style sheet, with no code stepping values.")
      )
      (<> Box (• motion-row)
        (<> MotionCard (text: "Hover and press") (• flex 1)
          (= note "when #is-hover-within lifts the card on a bouncy spring; when #is-press-within dips it at once.")
          (<> Box (• flex-row) (• items-end) (• flex 1) (• mt 12)
            (<> Box (id: lift-a) (• lift-card)
              (<> Box (• lift-art)
                (= background (call motion-glow 0))
              )
              (<> Label (text: "Sunrise") (• lift-title))
              (<> Label (text: "lifts on hover") (• motion-tag) (• mt 2))
            )
            (<> Box (id: lift-b) (• lift-card)
              (<> Box (• lift-art)
                (= background (call motion-glow 3))
              )
              (<> Label (text: "Lagoon") (• lift-title))
              (<> Label (text: "spring(420ms, 0.3)") (• motion-tag) (• mt 2))
            )
            (<> Box (id: lift-c) (• lift-card)
              (<> Box (• lift-art)
                (= background (call motion-glow 6))
              )
              (<> Label (text: "Orchid") (• lift-title))
              (<> Label (text: "instant on press") (• motion-tag) (• mt 2))
            )
          )
        )
        (<> MotionCard (text: "One state, many properties") (• flex 1)
          (= note "The mood changes each tile's color, corner radius, rotation and scale together. Colors blend through OKLab, and each tile's spring is a little slower than the last.")
          (<> (of SegmentedControl StyleMood) (id: mood-picker) (• mt 12)
            (= selected #mood)
            (for (on event selection-changed)
              (= mood (. event value))
            )
            (<> (of Segment StyleMood) (id: dawn-segment) (text: "Dawn")
              (= value (. StyleMood dawn))
            )
            (<> (of Segment StyleMood) (id: ocean-segment) (text: "Ocean")
              (= value (. StyleMood ocean))
            )
            (<> (of Segment StyleMood) (id: neon-segment) (text: "Neon")
              (= value (. StyleMood neon))
            )
          )
          (<> Label (• mood-name) (• mt 14)
            (= text (call mood-label #mood))
            (= color (call mood-color #mood 2))
            (= (. motion color) (call spring 700ms))
          )
          (<> Box (• flex-row) (• items-center) (• flex 1)
            (for (in index (..< 0 6))
              (<> Box (• mood-tile)
                (= background-color (call mood-color #mood index))
                (= corner-radius (call mood-radius #mood))
                (= rotate (call mood-rotate #mood index))
                (= scale (call mood-scale #mood index))
                (= (. motion background-color) (call spring (+ 360ms (* 110ms index))))
                (= (. motion corner-radius) (call spring (+ 360ms (* 110ms index))))
              )
            )
          )
        )
      )
      (<> Box (• motion-row) (• mt 18)
        (<> MotionCard (text: "Transforms on a spring") (• flex 1)
          (= note "translate, scale and rotate share motion.transform = spring(560ms, 0.42). Toggle them in any order, even mid-flight: each one turns around from where it is.")
          (<> Box (• flex-row) (• flex 1) (• mt 12)
            (<> Box (• motion-well) (• flex-row) (• items-center) (• justify-center) (• flex 1)
              (<> Box (• ticket)
                (= background (call motion-glow 4))
                (= rotate (if-expr #is-turned 0.3rad 0rad))
                (= scale (if-expr #is-grown 1.2 1))
                (= translate (call Point (if-expr #is-slid 120 -60) 0))
                (<> Label (text: "Boarding") (• ticket-title))
                (<> Label (text: "Gate 12 · Seat 4A") (• ticket-note))
              )
            )
            (<> Box (• flex-col) (• w 120) (• ml 16) (• justify-center)
              (<> Button (id: turn-button) (text: "Turn") (• mb 10)
                (= is-on #is-turned)
                (= action (=> () :do (= is-turned (not is-turned))))
              )
              (<> Button (id: grow-button) (text: "Grow") (• mb 10)
                (= is-on #is-grown)
                (= action (=> () :do (= is-grown (not is-grown))))
              )
              (<> Button (id: slide-button) (text: "Slide")
                (= is-on #is-slid)
                (= action (=> () :do (= is-slid (not is-slid))))
              )
            )
          )
        )
        (<> MotionCard (text: "Built-in controls") (• w 330)
          (= note "Stdlib controls declare their motion in the default theme.")
          (<> Box (• flex-col) (• mt 12)
            (<> Box (• control-row)
              (<> Switch (id: wifi-switch) (text: "Wi-Fi")
                (= is-on true)
              )
            )
            (<> Box (• control-row)
              (<> Switch (id: sync-switch) (text: "Sync photos"))
            )
            (<> Box (• control-row)
              (<> Switch (id: focus-switch) (text: "Focus mode"))
            )
            (<> Box (• disclosure-row)
              (<> DisclosureButton (id: disclosure) (• icon-chevron-right) (• w 20) (• h 20) (• mr 6)
                (= is-open #shows-advanced)
                (= action (=> () :do (= shows-advanced (not shows-advanced))))
              )
              (<> Label (text: "Advanced"))
            )
            (<> Label (• disclosure-detail)
              (= text "The chevron rotates by π/2 with gui-motion-quick.")
              (= opacity (if-expr #shows-advanced 1%% 0%%))
              (= translate (call Point 0 (if-expr #shows-advanced 0 -6)))
            )
          )
        )
      )
    )
  )
)

(fn-expr _ mood-color RGBA
  (param mood StyleMood)
  (param index Index)
  (match mood
    (case= .dawn
      ([] (list (call RGBA "#fbbf24") (call RGBA "#fb923c") (call RGBA "#f97316") (call RGBA "#f43f5e") (call RGBA "#ec4899") (call RGBA "#fde047")) index)
    )
    (case= .ocean
      ([] (list (call RGBA "#22d3ee") (call RGBA "#06b6d4") (call RGBA "#0ea5e9") (call RGBA "#3b82f6") (call RGBA "#6366f1") (call RGBA "#14b8a6")) index)
    )
    (default
      ([] (list (call RGBA "#a3e635") (call RGBA "#d946ef") (call RGBA "#22c55e") (call RGBA "#a855f7") (call RGBA "#facc15") (call RGBA "#f43f5e")) index)
    )
  )
)

(fn-expr _ mood-radius Length
  (param mood StyleMood)
  (match mood
    (case= .dawn
      32
    )
    (case= .ocean
      14
    )
    (default
      4
    )
  )
)

(fn-expr _ mood-rotate Radians
  (param mood StyleMood)
  (param index Index)
  (match mood
    (case= .dawn
      0rad
    )
    (case= .ocean
      (as (/ π 4) Radians)
    )
    (default
      (as (if-expr (== (% index 2) 0) 0.3 -0.3) Radians)
    )
  )
)

(fn-expr _ mood-scale F64
  (param mood StyleMood)
  (param index Index)
  (match mood
    (case= .dawn
      1.0
    )
    (case= .ocean
      0.82
    )
    (default
      (if-expr (== (% index 2) 0) 1.12 0.88)
    )
  )
)

(fn-expr _ mood-label String
  (param mood StyleMood)
  (match mood
    (case= .dawn
      "Dawn"
    )
    (case= .ocean
      "Ocean"
    )
    (default
      "Neon"
    )
  )
)
