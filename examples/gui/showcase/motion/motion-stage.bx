(import ./effects-panel)
(import ./enter-leave-panel)
(import ./fills-panel)
(import ./glass-panel)
(import ./keyframes-panel)
(import ./layout-panel)
(import ./motion-kit)
(import ./reorder-panel)
(import ./shaders-panel)
(import ./shared-panel)
(import ./springs-panel)
(import ./style-panel)
(import ./timelines-panel)
(import ./values-panel)
(import /graphics/point)
(import /gui)
(import /units)

(type + MotionEntry (is Tuple)
  (prop + id String)
  (prop + title String)
)

(style MotionStageTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using MotionKitTheme)
  (rule motion-stage-panel
    (= motion gui-motion-smooth)
    (= leave-space (. LeaveSpace release))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 0 18))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= translate (call Point 0 -10))
    )
  )
)

(type + MotionStage (is Box)
  (using MotionKitTheme)
  (using MotionStageTheme)
  (prop + current _ (= "springs"))
  (content
    (<> This (• flex-col)
      (if (== #current "springs")
        (<> SpringsPanel (• motion-stage-panel) (• flex 1))
        (else-if (== #current "style")
          (<> StylePanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "keyframes")
          (<> KeyframesPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "enter-leave")
          (<> EnterLeavePanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "layout")
          (<> LayoutPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "shared")
          (<> SharedPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "reorder")
          (<> ReorderPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "timelines")
          (<> TimelinesPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "fills")
          (<> FillsPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "shaders")
          (<> ShadersPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "effects")
          (<> ShaderEffectsPanel (• motion-stage-panel) (• flex 1))
        )
        (else-if (== #current "glass")
          (<> LiquidGlassPanel (• motion-stage-panel) (• flex 1))
        )
        (else
          (<> ValuesPanel (• motion-stage-panel) (• flex 1))
        )
      )
    )
  )
)

(fn-expr + motion-entries (list MotionEntry)
  (item (call MotionEntry "springs" "Motion values"))
  (item (call MotionEntry "style" "Style motion"))
  (item (call MotionEntry "keyframes" "Keyframes"))
  (item (call MotionEntry "enter-leave" "Enter & leave"))
  (item (call MotionEntry "layout" "Layout motion"))
  (item (call MotionEntry "shared" "Shared elements"))
  (item (call MotionEntry "reorder" "Drag to reorder"))
  (item (call MotionEntry "timelines" "Timelines"))
  (item (call MotionEntry "values" "Animated values"))
  (item (call MotionEntry "fills" "Shader fills"))
  (item (call MotionEntry "shaders" "Shader gallery"))
  (item (call MotionEntry "effects" "Shader effects"))
  (item (call MotionEntry "glass" "Liquid glass"))
)
