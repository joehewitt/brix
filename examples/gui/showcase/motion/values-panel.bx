(import ./motion-kit)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ stat-names _ (= (list "VISITORS" "REVENUE" "CONVERSION" "LATENCY")))
(prop _ bar-count _ (= 12))
(prop _ bar-reach _ (= 230.0))
(prop _ ring-width _ (= 14.0))
(prop _ spark-gravity _ (= 900.0))

(style ValuesTheme
  (using GUIDefaultTheme)
  (using MotionKitTheme)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (rule stat-card (• motion-card) (• flex 1) (• py 16))
  (blank)
  (rule stat-name (• motion-tag))
  (blank)
  (rule stat-value (• text gui-strong-text-color) (• mt 8)
    (= font-size 30)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule stat-delta (• mt 6)
    (= font-size 12)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule chart (• flex-row) (• items-end) (• flex 1) (• mt 14) (• px 4))
  (blank)
  (rule chart-bar (• flex 1) (• mx 5)
    (= corner-radius 6)
    (= (. motion layout) (call spring 700ms 0.4))
  )
  (blank)
  (rule ring-stage (• flex-col) (• items-center) (• justify-center) (• w 190) (• h 190) (• mt 14))
  (blank)
  (rule ring-score (• text gui-strong-text-color)
    (= font-size 40)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule ring-caption (• motion-tag) (• mt 2))
)

(type + ValuesPanel (is Box)
  (using MotionKitTheme)
  (using ValuesTheme)
  (prop + stats (list F64) (= (list 18240 48210 3.4 182)))
  (prop + changes (list F64) (= (list 4.2 7.8 -0.6 -3.1)))
  (prop + bars (list F64) (= (list 0.42 0.55 0.38 0.61 0.72 0.5 0.66 0.81 0.58 0.7 0.88 0.64)))
  (prop + score _ (= 0.62))
  (content
    (<> This (• motion-page)
      (<> MotionHeader (text: "Numbers that move themselves")
        (= lede
          (paragraph
            "Every figure here is animated(#value, spring(…)) in the attribute that shows it. Press Randomize twice quickly: each value turns toward its new target with the speed it had."
          )
        )
        (<> Button (id: randomize-button) (text: "Randomize") (• ml 20)
          (= action (=> () :do (call randomize)))
        )
      )
      (<> Box (• flex-row) (• h 122) (• mt 20) (• gap 16)
        (for (in index (..< 0 (. stat-names length)))
          (<> Box (• stat-card)
            (<> Label (• stat-name)
              (= text ([] stat-names index))
            )
            (<> Label (• stat-value)
              (= text (call stat-text index (call animated ([] #stats index) (call spring (+ 900ms (* 150ms index))))))
            )
            (<> Label (• stat-delta)
              (= text (call delta-text index (call animated ([] #changes index) (call spring 900ms))))
              (= color (if-expr (>= ([] #changes index) 0) (call motion-hue 2) (call motion-hue 7)))
            )
          )
        )
      )
      (<> Box (• motion-row) (• mt 18)
        (<> MotionCard (text: "Sessions by month") (• flex 1)
          (= note "Bars change height by layout motion, under spring(700ms, 0.4).")
          (<> Box (• chart)
            (for (in index (..< 0 bar-count))
              (<> Box (• chart-bar)
                (= background (call motion-glow index))
                (= min-height (call (. SizeSpec coord) (* ([] #bars index) bar-reach)))
                (= max-height (call (. SizeSpec coord) (* ([] #bars index) bar-reach)))
              )
            )
          )
        )
        (<> MotionCard (text: "Health score") (• items-center) (• w 250)
          (<> Box (• ring-stage)
            (<> ScoreRing (• absolute) (• cover .parent)
              (= amount (call animated #score (call spring 1400ms 0.3)))
            )
            (<> Label (• ring-score)
              (= text (str (as (call round (* (call animated #score (call spring 1400ms 0.3)) 100)) Int)))
            )
            (<> Label (text: "OUT OF 100") (• ring-caption))
          )
        )
        (<> MotionCard (text: "Sparks") (• w 280)
          (= note "A frames loop that runs only while sparks are in the air.")
          (<> BurstField (id: burst) (• motion-well) (• flex 1) (• mt 12))
          (<> Button (id: burst-button) (text: "Burst") (• mt 12)
            (= action (=> () :do (call (. burst burst))))
          )
        )
      )
    )
  )
  (fn-do + randomize _
    (let next-stats (call (of List F64)))
    (let next-changes (call (of List F64)))
    (for (in index (..< 0 (. stats length)))
      (let base ([] stats index))
      (let factor (+ 0.7 (* 0.6 (call next-random))))
      (let value (if-expr (== index 2) (/ (call round (* base factor 10)) 10) (call round (* base factor))))
      (+= next-stats value)
      (+= next-changes (* (/ (- value base) base) 100))
    )
    (= stats next-stats)
    (= changes next-changes)
    (let next-bars (call (of List F64)))
    (for (in index (..< 0 bar-count))
      (+= next-bars (+ 0.15 (* 0.85 (call next-random))))
    )
    (= bars next-bars)
    (= score (+ 0.2 (* 0.78 (call next-random))))
    (call (. burst burst))
  )
)

(type + ScoreRing (is Box)
  (prop + amount _ (= 0.0))
  (blank)
  (depends amount-changed amount)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let center (call Point (+ (. bounds x) (/ (. bounds width) 2)) (+ (. bounds y) (/ (. bounds height) 2))))
    (let radius (- (/ (call min (. bounds width) (. bounds height)) 2) (/ ring-width 2)))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) null)
      (= (. canvas stroke-width) ring-width)
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-color) (call RGBA "#ffffff14"))
      (call (. canvas circle) (. center x) (. center y) radius)
      (let sweep (call clamp amount 0.0 1.0))
      (return-if (if (<= sweep 0)))
      (= (. canvas stroke-color) (call ring-color sweep))
      (let steps (call max 2 (as (call round (* sweep 96)) Int)))
      (call (. canvas begin))
      (for (in index (.. 0 steps))
        (let angle (+ (/ (- π) 2) (/ (* 2 π sweep (as index F64)) (as steps F64))))
        (let point (call Point (+ (. center x) (* (call cos angle) radius)) (+ (. center y) (* (call sin angle) radius))))
        (if (== index 0)
          (call (. canvas move) (. point x) (. point y))
          (else
            (call (. canvas line) (. point x) (. point y))
          )
        )
      )
      (call (. canvas end))
    )
  )
  (fn-do _ amount-changed _
    (call invalidate-paint)
  )
)

(type _ Spark
  (prop + place Point)
  (prop + speed Point)
  (prop + life F64)
  (prop + color RGBA)
  (prop + size Length)
  (fn-do + This _
    (param place _)
    (param speed _)
    (param life _)
    (param color _)
    (param size _)
  )
)

(type + BurstField (is Box)
  (using MotionKitTheme)
  (prop _ sparks _ (= (call (of List Spark))))
  (event _ flights Bool)
  (blank)
  (rule This (• motion-clip))
  (prop _ flight _
    (machine
      (state is-resting
        (then is-flying (trigger on flights each))
      )
      (blank)
      (state is-flying
        (for (on tick frames)
          (call advance (. tick delta))
        )
        (blank)
        (then is-resting (trigger on flights (not each)))
      )
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (for (in spark sparks)
        (let fade (call clamp (. spark life) 0.0 1.0))
        (= (. canvas fill-color) (call (. spark color with-alpha) fade))
        (call (. canvas circle)
          (block
            (arg (+ (. bounds x) (. spark place x)))
            (arg (+ (. bounds y) (. spark place y)))
            (arg (* (. spark size) (+ 0.4 (* 0.6 fade))))
          )
        )
      )
    )
  )
  (fn-do + burst _
    (let origin (call Point (/ (. bounds width) 2) (* (. bounds height) 0.78)))
    (for (in index (..< 0 90))
      (let angle (+ (/ (- π) 2) (* (- (call next-random) 0.5) 1.6)))
      (let pace (+ 260 (* 520 (call next-random))))
      (let speed (call Point (* (call cos angle) pace) (* (call sin angle) pace)))
      (+= sparks
        (call Spark
          (block
            (arg origin)
            (arg speed)
            (arg (+ 0.9 (* 0.8 (call next-random))))
            (arg (call motion-hue index))
            (arg (+ 2.5 (* 3.5 (call next-random))))
          )
        )
      )
    )
    (<- flights true)
  )
  (fn-do _ advance _
    (param delta Nanoseconds)
    (let seconds (as (as delta Seconds) F64))
    (let kept (call (of List Spark)))
    (for (in spark sparks)
      (= (. spark speed) (call Point (* (. spark speed x) 0.99) (+ (. spark speed y) (* spark-gravity seconds))))
      (= (. spark place)
        (call Point
          (block
            (arg (+ (. spark place x) (* (. spark speed x) seconds)))
            (arg (+ (. spark place y) (* (. spark speed y) seconds)))
          )
        )
      )
      (-= (. spark life) seconds)
      (if (> (. spark life) 0)
        (+= kept spark)
      )
    )
    (= sparks kept)
    (call invalidate-paint)
    (if (== (. sparks length) 0)
      (<- flights false)
    )
  )
)

(fn-do _ next-random F64
  (return (/ (call random 0 1000000) 1000000.0))
)

(fn-expr _ stat-text String
  (param index Index)
  (param value F64)
  (case? (== index 0)
    (call grouped value)
  )
  (case? (== index 1)
    (str "\$" (call grouped value))
  )
  (case? (== index 2)
    (str (/ (call round (* value 10)) 10) "%")
  )
  (default
    (str (as (call round value) Int) " ms")
  )
)

(fn-expr _ delta-text String
  (param index Index)
  (param change F64)
  (str (if-expr (>= change 0) "▲" "▼") " " (/ (call round (* (call abs change) 10)) 10) "% vs last week")
)

(fn-expr _ grouped String
  (param value F64)
  (case? (< whole 1000)
    (str whole)
  )
  (default
    (str (call grouped (as high F64)) "," tail)
  )
  (where
    (lazy whole (as (call round (call abs value)) Int))
    (lazy high (/ whole 1000))
    (lazy low (% whole 1000))
    (lazy tail (if-expr (< low 10) (str "00" low) (if-expr (< low 100) (str "0" low) (str low))))
  )
)

(fn-expr _ ring-color RGBA
  (param amount F64)
  (case? (< amount 0.4)
    (call motion-hue 7)
  )
  (case? (< amount 0.7)
    (call motion-hue 1)
  )
  (default
    (call motion-hue 2)
  )
)
