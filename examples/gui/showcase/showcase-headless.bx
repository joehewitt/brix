(import ./showcase-panel)
(import /graphics/canvas)
(import /graphics/primitives)
(import /gui)
(import /gui/metal)
(import /gui/scene)
(import /os/cli)
(import /os/path)
(blank)
(prop _ output-directory _ (= ".tmp/examples"))
(prop _ command _ (:= (call cmdline)))
(blank)

(main
  (for (in path (list ".tmp" output-directory))
    (let directory (call Path path))
    (if (not (. directory is-dir))
      (call (. directory make-directory))
    )
  )
  (blank)
  (<> HeadlessShowcaseWindow (id: window) (• flex-col)
    (= size (tuple 1400 880))
    (blank)
    (<> ShowcasePanel (id: panel) (• flex 1))
  )
  (blank)
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (call (. window open))
  (blank)
  (let ids (call headless-ids panel (. command args)))
  (let appearances (call headless-appearances (?? ([] (. command options) "appearance") "both")))
  (let uses-metal (call (. command has-flag) "metal"))
  (let size (?? ([] (. command options) "size") "regular"))
  (call (. panel set-size) (call headless-size size))
  (for (in appearance appearances)
    (call (. panel set-appearance) appearance)
    (for (in id ids)
      (call (. panel show) id)
      (call settle window)
      (let image-path (str output-directory "/showcase-" id "-" (call appearance-name appearance) "-" size ".png"))
      (if uses-metal
        (call render-metal window image-path)
        (else
          (call render-core-graphics window image-path)
        )
      )
      (print (str "showcase image=" image-path))
    )
  )
)

(type _ HeadlessShowcaseWindow (is Window)
  ; ╌╌╌╌╌╌╌╌╌╌ is Window ╌╌╌╌╌╌╌╌╌╌
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do _ settle _
  (param window Window)
  (let root (. window markup-batch-root))
  (if root
    (catch (call (. root markup-batch-queue checkpoint)))
  )
  (call (. window layout))
)

(fn-do _ render-core-graphics _
  (param window Window)
  (param path String)
  (let canvas (call RasterCanvas 1400 880 1))
  (do-use canvas
    (call (. canvas erase) (. window $gui-window-color))
    (call (. window paint) canvas)
    (call (. canvas write) path)
  )
)

(fn-do _ render-metal _
  (param window Window)
  (param path String)
  (let background (. window $gui-window-color))
  (let renderer (call MetalOffscreenRenderer 1400 880 2 background))
  (let scene (call DisplayScene 2 background renderer))
  (do-use renderer
    (do-use scene
      (for (in pass (..< 0 8))
        (call (. scene maintain) window 2 background)
        (call (. scene damage-pending-textures))
        (call (. scene add-damage) (call Rect 0 0 1400 880))
        (call (. scene frame-metal) renderer)
        (call (. renderer finish))
        (if (and (not (. renderer has-pending-fill-frames)) (not (. scene has-pending-textures)))
          (break)
        )
      )
      (call (. renderer write) path)
    )
  )
)

(fn-do _ headless-ids (list String)
  (param panel ShowcasePanel)
  (param args (list String))
  (if (or (!= (. args length) 1) (!= ([] args 0) "all"))
    (return args)
  )
  (let ids (call (of List String)))
  (for (in entry (. panel controls))
    (+= ids (. entry id))
  )
  (for (in entry (. panel components))
    (+= ids (. entry id))
  )
  (for (in section (. panel popups))
    (+= ids (. section id))
  )
  (for (in entry (. panel painting))
    (+= ids (. entry id))
  )
  (for (in entry (. panel layout))
    (+= ids (. entry id))
  )
  (for (in entry (. panel interaction))
    (+= ids (. entry id))
  )
  (for (in entry (. panel motion))
    (+= ids (. entry id))
  )
  (return ids)
)

(fn-expr _ headless-appearances (list WindowAppearance)
  (param choice String)
  (match choice
    (case= "light"
      (list (. WindowAppearance light))
    )
    (case= "dark"
      (list (. WindowAppearance dark))
    )
    (default
      (list (. WindowAppearance light) (. WindowAppearance dark))
    )
  )
)

(fn-expr _ headless-size ControlSize
  (param choice String)
  (match choice
    (case= "small"
      (. ControlSize small)
    )
    (case= "large"
      (. ControlSize large)
    )
    (default
      (. ControlSize regular)
    )
  )
)

(fn-expr _ appearance-name String
  (param appearance WindowAppearance)
  (if-expr (== appearance (. WindowAppearance dark)) "dark" "light")
)
