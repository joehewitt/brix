(import ./components/color-picker/color-picker-panel)
(import ./components/controls/buttons-panel)
(import ./components/controls/choices-panel)
(import ./components/controls/fields-panel)
(import ./components/icons/icons-panel)
(import ./components/popups/popups-panel)
(import ./components/rich-text/rich-text-panel)
(import ./components/sidebar/sidebar-panel)
(import ./components/tree-box/tree-box-panel)
(import ./components/virtual-lists/virtual-lists-panel)
(import ./effects/canvas-effects/canvas-effects-panel)
(import ./effects/clipboard/clipboard-panel)
(import ./effects/drag-drop/drag-drop-panel)
(import ./effects/flex-flow/flex-flow-panel)
(import ./effects/opacity/opacity-panel)
(import ./effects/painters/painters-panel)
(import ./effects/paragraphs/paragraphs-panel)
(import ./effects/pointer/pointer-panel)
(import ./effects/scrolling/scrolling-panel)
(import ./effects/styles/styles-panel)
(import ./effects/text-lines/text-lines-panel)
(import ./motion/motion-stage)
(import /gui)
(import /stream/aggregate)

(style ShowcaseTheme
  (using GUIDefaultTheme)
  (rule showcase-stage
    (= layout (call FlowLayout (. Orientation vertical)))
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule showcase-scroller (• flex-col) (• flex 1)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule showcase-toolbar (• flex-row) (• h 44) (• px 16)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule showcase-toolbar-label (• text gui-muted-text-color)
    (= font-size 12)
  )
)

(type + ShowcaseEntry (is Tuple)
  (prop + id String)
  (prop + title String)
)

(type + ShowcasePanel (is Box)
  (using ShowcaseTheme)
  (prop + current _ (= "buttons"))
  (prop + appearance _ (= (. WindowAppearance system)))
  (prop + control-size _ (= (. ControlSize regular)))
  (prop + controls (list ShowcaseEntry) (= (call showcase-controls)))
  (prop + components (list ShowcaseEntry) (= (call showcase-components)))
  (prop + popups (list PopupsSection) (= (call popups-sections)))
  (prop + painting (list ShowcaseEntry) (= (call showcase-painting)))
  (prop + layout (list ShowcaseEntry) (= (call showcase-layout)))
  (prop + interaction (list ShowcaseEntry) (= (call showcase-interaction)))
  (prop + motion (list MotionEntry) (= (call motion-entries)))
  (content
    (<> This (• flex-row)
      (<> Sidebar (• w 232)
        (<> SidebarSection (text: "Controls") (• pt 10)
          (for (in entry controls)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
        (<> SidebarSection (text: "Components")
          (for (in entry components)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
        (<> SidebarSection (text: "Popups")
          (for (in section popups)
            (<> SidebarItem
              (= title (. section title))
              (= is-on (== #current (. section id)))
              (= action (=> () :do (call show (. section id))))
            )
          )
        )
        (<> SidebarSection (text: "Painting")
          (for (in entry painting)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
        (<> SidebarSection (text: "Layout")
          (for (in entry layout)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
        (<> SidebarSection (text: "Interaction")
          (for (in entry interaction)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
        (<> SidebarSection (text: "Motion")
          (for (in entry motion)
            (<> SidebarItem
              (= title (. entry title))
              (= is-on (== #current (. entry id)))
              (= action (=> () :do (call show (. entry id))))
            )
          )
        )
      )
      (<> Box (• flex-col) (• flex 1)
        (<> Box (• showcase-toolbar) (• items-center)
          (<> Label (text: "Appearance") (• showcase-toolbar-label))
          (<> (of SegmentedControl WindowAppearance) (• ml 8)
            (= selected #appearance)
            (for (on event selection-changed)
              (call set-appearance (. event value))
            )
            (<> (of Segment WindowAppearance) (text: "System")
              (= value (. WindowAppearance system))
            )
            (<> (of Segment WindowAppearance) (text: "Light")
              (= value (. WindowAppearance light))
            )
            (<> (of Segment WindowAppearance) (text: "Dark")
              (= value (. WindowAppearance dark))
            )
          )
          (<> Label (text: "Control size") (• showcase-toolbar-label) (• ml 24))
          (<> (of SegmentedControl ControlSize) (• ml 8)
            (= selected #control-size)
            (for (on event selection-changed)
              (call set-size (. event value))
            )
            (<> (of Segment ControlSize) (text: "Small")
              (= value (. ControlSize small))
            )
            (<> (of Segment ControlSize) (text: "Regular")
              (= value (. ControlSize regular))
            )
            (<> (of Segment ControlSize) (text: "Large")
              (= value (. ControlSize large))
            )
          )
        )
        (<> Box (id: stage) (• flex-col) (• flex 1)
          (if (== #current "buttons")
            (<> Box (• showcase-scroller)
              (<> ButtonsPanel)
            )
            (else-if (== #current "fields")
              (<> Box (• showcase-scroller)
                (<> FieldsPanel)
              )
            )
            (else-if (== #current "choices")
              (<> Box (• showcase-scroller)
                (<> ChoicesPanel)
              )
            )
            (else-if (call popups-has-section #current)
              (<> PopupsPanel (• flex 1)
                (= section #current)
              )
            )
            (else-if (== #current "rich-text")
              (<> RichTextPanel (• flex 1))
            )
            (else-if (== #current "icons")
              (<> IconsPanel (• flex 1))
            )
            (else-if (== #current "color-picker")
              (<> Box (• showcase-stage) (• flex 1)
                (<> Box (• flex-row) (• h 430)
                  (<> ColorPickerPanel (• w 640))
                )
              )
            )
            (else-if (== #current "tree-box")
              (<> TreeBoxPanel (• flex 1))
            )
            (else-if (== #current "virtual-lists")
              (<> VirtualListsPanel (• flex 1))
            )
            (else-if (== #current "sidebar")
              (<> SidebarPanel (• flex 1))
            )
            (else-if (== #current "styles")
              (<> Box (• showcase-stage) (• flex 1)
                (<> StylesPanel)
              )
            )
            (else-if (== #current "painters")
              (<> Box (• showcase-stage) (• flex 1)
                (<> PaintersPanel)
              )
            )
            (else-if (== #current "opacity")
              (<> Box (• showcase-stage) (• flex 1)
                (<> OpacityPanel)
              )
            )
            (else-if (== #current "canvas-effects")
              (<> Box (• showcase-stage) (• flex 1)
                (<> CanvasEffectsPanel)
              )
            )
            (else-if (== #current "flex-flow")
              (<> FlexFlowPanel (• flex 1))
            )
            (else-if (== #current "scrolling")
              (<> ScrollingPanel (• flex 1))
            )
            (else-if (== #current "text-lines")
              (<> Box (• showcase-stage) (• flex 1)
                (<> TextLinesPanel)
              )
            )
            (else-if (== #current "paragraphs")
              (<> ParagraphsPanel (• flex 1))
            )
            (else-if (== #current "pointer")
              (<> Box (• showcase-stage) (• flex 1)
                (<> PointerPanel)
              )
            )
            (else-if (== #current "clipboard")
              (<> ClipboardPanel (• flex 1))
            )
            (else-if (call is-motion #current)
              (<> MotionStage (• flex 1)
                (= current #current)
              )
            )
            (else
              (<> DragDropPanel (• flex 1))
            )
          )
        )
      )
    )
  )
  (fn-do + show _
    (param id String)
    (= current id)
  )
  (fn-expr + is-motion Bool
    (param id String)
    (call some motion (:where (== (. each id) id)))
  )
  (fn-do + set-appearance _
    (param next WindowAppearance)
    (= appearance next)
    (let host window)
    (if host
      (= (. (as host Window) appearance) next)
    )
  )
  (fn-do + set-size _
    (param next ControlSize)
    (= control-size next)
    (call (. stage set-control-size) next)
  )
)

(fn-expr _ showcase-controls (list ShowcaseEntry)
  (item (call ShowcaseEntry "buttons" "Buttons"))
  (item (call ShowcaseEntry "fields" "Fields"))
  (item (call ShowcaseEntry "choices" "Choices"))
)

(fn-expr _ showcase-components (list ShowcaseEntry)
  (item (call ShowcaseEntry "rich-text" "Rich text"))
  (item (call ShowcaseEntry "icons" "Icons"))
  (item (call ShowcaseEntry "color-picker" "Color picker"))
  (item (call ShowcaseEntry "tree-box" "TreeBox"))
  (item (call ShowcaseEntry "virtual-lists" "Virtual lists"))
  (item (call ShowcaseEntry "sidebar" "Sidebar"))
)

(fn-expr _ showcase-painting (list ShowcaseEntry)
  (item (call ShowcaseEntry "styles" "Styles"))
  (item (call ShowcaseEntry "painters" "Painters"))
  (item (call ShowcaseEntry "opacity" "Opacity"))
  (item (call ShowcaseEntry "canvas-effects" "Canvas effects"))
)

(fn-expr _ showcase-layout (list ShowcaseEntry)
  (item (call ShowcaseEntry "flex-flow" "Flex & flow"))
  (item (call ShowcaseEntry "scrolling" "Scrolling"))
  (item (call ShowcaseEntry "text-lines" "Text lines"))
  (item (call ShowcaseEntry "paragraphs" "Paragraphs"))
)

(fn-expr _ showcase-interaction (list ShowcaseEntry)
  (item (call ShowcaseEntry "pointer" "Pointer"))
  (item (call ShowcaseEntry "drag-drop" "Drag & drop"))
  (item (call ShowcaseEntry "clipboard" "Clipboard"))
)
