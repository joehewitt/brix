(import ./showcase-panel)
(import /gui)
(import /os/cli)
(blank)

(main
  (lazy arguments (call cmdline-args))
  (<> App
    (<> Window (• flex-col)
      (= title "Yumi GUI: Showcase")
      (= size (tuple 1400 880))
      (= allows-zoom true)
      (blank)
      (<> MenuBar
        (<> MenuBarItem (text: "View")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole zoom-in))
            )
            (<> MenuItem
              (= role (. MenuRole zoom-out))
            )
            (<> MenuItem
              (= role (. MenuRole actual-size))
            )
          )
        )
      )
      (<> ShowcasePanel (• flex 1)
        (= current (if-expr (> (. arguments length) 1) ([] arguments 1) "buttons"))
      )
    )
  )
)
