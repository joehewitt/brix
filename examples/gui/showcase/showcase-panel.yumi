/gui
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
• ShowcaseTheme
    using GUIDefaultTheme

• showcase-stage
    layout = FlowLayout(Orientation.vertical)
    overflow-x = ScrollOverflow.auto
    overflow-y = ScrollOverflow.auto

• showcase-scroller • flex-col flex:1
    overflow-y = ScrollOverflow.auto

• showcase-toolbar • flex-row h:44 px:16
    border-color = gui-divider-color
    border-bottom-width = 1

• showcase-toolbar-label • text:gui-muted-text-color
    font-size = 12

━━━━━━━━━━━━━━━━━━━━
+ ShowcaseEntry is Tuple

+ id String
+ title String

━━━━━━━━━━━━━━━━━━━━
+ ShowcasePanel is Box
    using ShowcaseTheme

+ current = "buttons"
+ appearance = WindowAppearance.system
+ control-size = ControlSize.regular
+ controls [ShowcaseEntry] = showcase-controls()
+ components [ShowcaseEntry] = showcase-components()
+ popups [PopupsSection] = popups-sections()
+ painting [ShowcaseEntry] = showcase-painting()
+ layout [ShowcaseEntry] = showcase-layout()
+ interaction [ShowcaseEntry] = showcase-interaction()
+ motion [MotionEntry] = motion-entries()

────────────────────

<This • flex-row
    <Sidebar • w:232
        <SidebarSection "Controls" • pt:10
            for entry in controls
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
        <SidebarSection "Components"
            for entry in components
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
        <SidebarSection "Popups"
            for section in popups
                <SidebarItem
                    title = section.title
                    is-on = #current == section.id
                    action = => do show(section.id)
        <SidebarSection "Painting"
            for entry in painting
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
        <SidebarSection "Layout"
            for entry in layout
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
        <SidebarSection "Interaction"
            for entry in interaction
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
        <SidebarSection "Motion"
            for entry in motion
                <SidebarItem
                    title = entry.title
                    is-on = #current == entry.id
                    action = => do show(entry.id)
    <Box • flex-col flex:1
        <Box • showcase-toolbar items-center
            <Label "Appearance" • showcase-toolbar-label
            <SegmentedControl'WindowAppearance • ml:8
                selected = #appearance
                for event on selection-changed
                    set-appearance(event.value)
                <Segment'WindowAppearance "System"
                    value = WindowAppearance.system
                <Segment'WindowAppearance "Light"
                    value = WindowAppearance.light
                <Segment'WindowAppearance "Dark"
                    value = WindowAppearance.dark
            <Label "Control size" • showcase-toolbar-label ml:24
            <SegmentedControl'ControlSize • ml:8
                selected = #control-size
                for event on selection-changed
                    set-size(event.value)
                <Segment'ControlSize "Small"
                    value = ControlSize.small
                <Segment'ControlSize "Regular"
                    value = ControlSize.regular
                <Segment'ControlSize "Large"
                    value = ControlSize.large
        <Box stage • flex-col flex:1
            if #current == "buttons"
                <Box • showcase-scroller
                    <ButtonsPanel
            else if #current == "fields"
                <Box • showcase-scroller
                    <FieldsPanel
            else if #current == "choices"
                <Box • showcase-scroller
                    <ChoicesPanel
            else if popups-has-section(#current)
                <PopupsPanel • flex:1
                    section = #current
            else if #current == "rich-text"
                <RichTextPanel • flex:1
            else if #current == "icons"
                <IconsPanel • flex:1
            else if #current == "color-picker"
                <Box • showcase-stage flex:1
                    <Box • flex-row h:430
                        <ColorPickerPanel • w:640
            else if #current == "tree-box"
                <TreeBoxPanel • flex:1
            else if #current == "column-tree"
                <ColumnTreePanel • flex:1
            else if #current == "virtual-lists"
                <VirtualListsPanel • flex:1
            else if #current == "sidebar"
                <SidebarPanel • flex:1
            else if #current == "styles"
                <Box • showcase-stage flex:1
                    <StylesPanel
            else if #current == "painters"
                <Box • showcase-stage flex:1
                    <PaintersPanel
            else if #current == "opacity"
                <Box • showcase-stage flex:1
                    <OpacityPanel
            else if #current == "canvas"
                <Box • showcase-stage flex:1
                    <CanvasPanel
            else if #current == "canvas-effects"
                <Box • showcase-stage flex:1
                    <CanvasEffectsPanel
            else if #current == "flex-flow"
                <FlexFlowPanel • flex:1
            else if #current == "scrolling"
                <ScrollingPanel • flex:1
            else if #current == "text-lines"
                <Box • showcase-stage flex:1
                    <TextLinesPanel
            else if #current == "paragraphs"
                <ParagraphsPanel • flex:1
            else if #current == "focus-keys"
                <Box • showcase-stage flex:1
                    <FocusKeysPanel
            else if #current == "pointer"
                <Box • showcase-stage flex:1
                    <PointerPanel
            else if #current == "clipboard"
                <ClipboardPanel • flex:1
            else if is-motion(#current)
                <MotionStage • flex:1
                    current = #current
            else
                <DragDropPanel • flex:1

────────────────────
+ do show
    - id String

current = id

────────────────────
+ is-motion Bool
    - id String

some(motion) • where each.id == id

────────────────────
+ do set-appearance
    - next WindowAppearance

appearance = next
. host = window
if host
    (host as Window).appearance = next

────────────────────
+ do set-size
    - next ControlSize

control-size = next
stage.set-control-size(next)

