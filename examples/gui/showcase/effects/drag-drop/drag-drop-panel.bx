(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/file-text)
(import /gui/icons/lucide/layers)
(import /gui/icons/lucide/spline)
(import /math)
(import /ui/selection)
(blank)
(prop + task-pitch Length (= 42))

(style DragDropTheme
  (using GUIDefaultTheme)
  (rule gallery-panel (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule panel-title
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule panel-note (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule panel-status (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule swatch-chip (• text "#ffffff")
    (= font-weight (. FontWeight bold))
    (= cursor (. CursorStyle open-hand))
  )
  (blank)
  (rule swatch-face
    (= corner-radius 6)
  )
  (blank)
  (rule drop-well (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
    (blank)
    (when-style #is-armed
      (• bg gui-hover-color)
      (= border-color gui-accent-bright-color)
    )
  )
  (blank)
  (rule file-row (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 6)
    (= cursor (. CursorStyle open-hand))
  )
  (blank)
  (rule file-icon (• text gui-muted-text-color))
  (blank)
  (rule file-badge (• bg gui-pressed-color) (• text gui-strong-text-color)
    (= corner-radius 13)
    (= font-size 12)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule task-card (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 6)
    (= cursor (. CursorStyle open-hand))
  )
  (blank)
  (rule task-gap (• bg gui-accent-color)
    (= border-color gui-accent-bright-color)
    (= border-width 1)
    (= corner-radius 6)
  )
  (blank)
  (rule board-tree
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule board-group
    (= font-weight (. FontWeight bold))
  )
)

(type + DragDropPanel (is Box)
  (using DragDropTheme)
  (content
    (<> This (• flex-row) (• p 16)
      (<> Box (• gallery-panel) (• flex-col) (• flex 1) (• p 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Drop targets")
        )
        (<> Label (• panel-note) (• h 34)
          (= text
            (call (. "" join)
              (block
                (item "Drag a swatch onto a well. ")
                (item "The warm well refuses cool colors and the cursor says so.")
              )
            )
          )
          (= text-wrap (. TextWrap word))
        )
        (<> SwatchTray (id: swatches) (• flex-col) (• mt 6))
        (blank)
        (<> Label (• panel-title) (• h 22) (• mt 18)
          (= text "Pictured ghost")
        )
        (<> Label (• panel-note) (• h 34)
          (= text "These rows drag as a badge that is never shown in the window itself.")
          (= text-wrap (. TextWrap word))
        )
        (<> FileShelf (id: shelf) (• flex-col) (• flex 1) (• mt 6))
      )
      (blank)
      (<> Box (• gallery-panel) (• flex-col) (• flex 1) (• p 12) (• mx 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Reordered list")
        )
        (<> Label (• panel-note) (• h 34)
          (= text
            (call (. "" join)
              (block
                (item "The card leaves the list while it is held, ")
                (item "and a placeholder shows where it will land.")
              )
            )
          )
          (= text-wrap (. TextWrap word))
        )
        (<> TaskList (id: tasks) (• flex-col) (• flex 1) (• mt 6))
      )
      (blank)
      (<> Box (• gallery-panel) (• flex-col) (• flex 1) (• p 12)
        (<> Label (• panel-title) (• h 22)
          (= text "TreeBox rows")
        )
        (<> Label (• panel-note) (• h 34)
          (= text
            (call (. "" join)
              (block
                (item "Rows restack and move between groups. ⌘-click selects several. ")
                (item "Background stays put.")
              )
            )
          )
          (= text-wrap (. TextWrap word))
        )
        (<> OutlineBoard (id: board) (• flex-col) (• flex 1) (• mt 6))
      )
    )
  )
)

(type + Swatch (is Tuple)
  (implements DragPayload)
  (prop + name String)
  (prop + color RGBA)
  (prop + is-warm Bool)
  (blank)
  (fn-expr + drag-kind _ :get
    "gallery.swatch"
  )
)

(type + SwatchTray (is Box)
  (content
    (<> This
      (<> Box (• flex-row) (• h 36)
        (for (in swatch (call gallery-swatches))
          (<> SwatchChip (• swatch-chip) (• w 72) (• h 36) (• mr 8)
            (= swatch swatch)
          )
        )
      )
      (<> Box (• flex-row) (• h 84) (• mt 10)
        (<> SwatchWell (id: any-well) (• drop-well) (• flex-col) (• flex 1) (• p 10) (• mr 8)
          (= title "Any color")
        )
        (<> SwatchWell (id: warm-well) (• drop-well) (• flex-col) (• flex 1) (• p 10)
          (= title "Warm colors only")
          (= warm-only true)
        )
      )
    )
  )
)

(type + SwatchChip (is Box)
  (prop + swatch Swatch)
  (content
    (<> This (• flex-col)
      (<> SwatchFace (• absolute) (• cover .parent)
        (= swatch swatch)
      )
      (<> Label (• flex 1)
        (= text (. swatch name))
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event drag-start)
    (call (. event begin) swatch)
  )
)

(type + SwatchFace (is Box)
  (prop + swatch Swatch)
  (content
    (<> This
      (<> Box (• swatch-face) (• absolute) (• cover .parent) (• bg (. swatch color)))
    )
  )
)

(type + SwatchWell (is Box)
  (prop + title String)
  (prop + warm-only _ (= false))
  (prop + is-armed _ (= false))
  (prop + contents (list Swatch))
  (prop + caption _ (= "Empty"))
  (content
    (<> This
      (<> Label (• panel-status) (• h 18)
        (= text title)
      )
      (<> Label (• h 20)
        (= text #caption)
      )
      (<> Box (• flex-row) (• h 24) (• mt 2)
        (for (in swatch #contents (keyed-by (. swatch name)))
          (<> SwatchFace (• w 48) (• h 24)
            (= swatch swatch)
          )
        )
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (call takes (. event payload))
      (= is-armed true)
      (call (. event accept))
    )
  )
  (subscribe-for (on event drag-leave)
    (= is-armed false)
  )
  (subscribe-for (on event drop)
    (let swatch (as (. event payload) Swatch))
    (= is-armed false)
    (= contents (list swatch))
    (= caption (str "Holding " (. swatch name)))
  )
  (fn-expr _ takes _
    (param payload DragPayload)
    (case? (is payload Swatch)
      (or (not warm-only) (. (as payload Swatch) is-warm))
    )
    (default
      false
    )
  )
)

(type + FilePayload (is Tuple)
  (implements DragPayload)
  (prop + name String)
  (blank)
  (fn-expr + drag-kind _ :get
    "gallery.file"
  )
)

(type + FileShelf (is Box)
  (prop + files (list String) (= (call gallery-files)))
  (prop + archived (list String))
  (prop + archive-caption _ (= "Empty"))
  (prop + carried _ (= ""))
  (prop + row-owner _ (=> this))
  (content
    (<> This
      (for (in name #files (keyed-by name))
        (<> FileRow (• file-row) (• flex-row) (• h 30) (• px 10) (• mb 6)
          (= shelf row-owner)
          (= name name)
        )
      )
      (<> FileArchive (id: archive) (• drop-well) (• flex-col) (• h 58) (• p 10) (• mt 4)
        (= shelf row-owner)
      )
      (<> Box (• flex-row) (• h 30) (• mt 8)
        (<> Button (text: "Put the files back")
          (= action (=> () :do (call restore)))
        )
      )
      (<> Box (id: badge) (• file-badge) (• absolute) (• flex-col) (• w 150) (• h 26)
        (= display (. Display invisible))
        (= left (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (<> Label (• flex 1)
          (= text #carried)
          (= text-alignment (. TextAlignment center))
        )
      )
    )
  )
  (fn-do + file-away _
    (param name String)
    (= files (call (of List String) (in each files (when (!= each name)))))
    (+= archived name)
    (= archive-caption (call (. ", " join) (in each archived)))
  )
  (fn-do + restore _
    (= files (call gallery-files))
    (= archived (call (of List String)))
    (= archive-caption "Empty")
  )
)

(type + FileRow (is Box)
  (prop + shelf FileShelf)
  (prop + name String)
  (content
    (<> This
      (<> LucideFileText (• icon) (• file-icon) (• w 14) (• h 14) (• mr 6)
        (= align-y (. Alignment center))
      )
      (<> Label (• flex 1)
        (= text name)
        (= align-y (. Alignment center))
      )
    )
  )
  (subscribe-for (on event drag-start)
    (= (. shelf carried) name)
    (call (. event begin) (call FilePayload name) (. shelf badge))
  )
)

(type + FileArchive (is Box)
  (prop + shelf FileShelf)
  (prop + is-armed _ (= false))
  (content
    (<> This
      (<> Label (• panel-status) (• h 18)
        (= text "Archive")
      )
      (<> Label (• h 20)
        (= text (. shelf #archive-caption))
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (is (. event payload) FilePayload)
      (= is-armed true)
      (call (. event accept))
    )
  )
  (subscribe-for (on event drag-leave)
    (= is-armed false)
  )
  (subscribe-for (on event drop)
    (= is-armed false)
    (call (. shelf file-away) (. (as (. event payload) FilePayload) name))
  )
)

(type + TaskPayload (is Tuple)
  (implements DragPayload)
  (prop + id Size)
  (blank)
  (fn-expr + drag-kind _ :get
    "gallery.task"
  )
)

(type + TaskList (is Box)
  (prop + titles (list String) (= (call gallery-tasks)))
  (prop + ids (list Size) (= (list 0 1 2 3 4 5)))
  (prop + order (list Size) (= (list 0 1 2 3 4 5)))
  (prop + lifted (? Size))
  (prop + gap (? Index))
  (prop + story _ (= "Nothing moved yet"))
  (prop + row-owner _ (=> this))
  (content
    (<> This
      (<> Box (id: cards) (• flex 1)
        (for (in id ids)
          (<> TaskCard (• task-card) (• absolute) (• flex-row) (• h 36) (• px 10)
            (= list row-owner)
            (= id id)
            (= title ([] titles id))
            (= left (call (. PositionOffset coord) 0))
            (= right (call (. PositionOffset coord) 0))
            (= top (call task-top id #order #lifted #gap))
            (= display (call task-display id #lifted))
          )
        )
        (if (!= #gap null)
          (<> Box (• task-gap) (• absolute) (• h 36)
            (= left (call (. PositionOffset coord) 0))
            (= right (call (. PositionOffset coord) 0))
            (= top (call task-gap-top #gap))
          )
        )
      )
      (<> Label (• panel-status) (• h 20) (• mt 6)
        (= text #story)
      )
    )
  )
  (subscribe-for (on event (. cards drag-over))
    (if (and (is (. event payload) TaskPayload) (!= lifted null))
      (= gap (call slot-at (. event root-point)))
      (call (. event accept))
    )
  )
  (subscribe-for (on event (. cards drag-leave))
    (= gap null)
  )
  (subscribe-for (on event (. cards drop))
    (let id (. (as (. event payload) TaskPayload) id))
    (let next (call (of List Size) (in each order (when (!= each id)))))
    (let slot Index (?? gap (. next length)))
    (call (. next insert) id slot)
    (= order next)
    (= story (str ([] titles id) " is now number " (+ slot 1)))
  )
  (fn-do + lift _
    (param id Size)
    (let slot Index 0)
    (for (in other order)
      (if (== other id)
        (= gap slot)
      )
      (+= slot 1)
    )
    (= lifted id)
  )
  (fn-do + settle _
    (= lifted null)
    (= gap null)
  )
  (fn-expr + slot-at _
    (param point Point)
    (if-expr (< row last) row last)
    (where
      (lazy local (call (. cards point-in-box) point))
      (lazy reach (call max 0 (. local y)))
      (lazy row (as (call floor (/ reach task-pitch)) Index))
      (lazy last Index (- (. order length) 1))
    )
  )
  (fn-expr + arrangement _ :get
    (call (. ", " join) (in ([] titles each) order))
  )
)

(type + TaskCard (is Box)
  (prop + list TaskList)
  (prop + id Size)
  (prop + title String)
  (content
    (<> This
      (<> Label (• flex 1)
        (= text title)
        (= align-y (. Alignment center))
      )
    )
  )
  (subscribe-for (on event drag-start)
    (call (. event begin) (call TaskPayload id))
    (call (. list lift) id)
  )
  (subscribe-for (on event drag-end)
    (call (. list settle))
  )
)

(type + OutlineBoard (is Box)
  (prop + model _ (= (call board-fixture)))
  (prop + story _ (= "Nothing moved yet"))
  (content
    (<> This
      (<> (of TreeBox BoardNode) (id: tree) (• board-tree) (• flex 1)
        (= root-node model)
        (= load-children board-children)
        (= key-builder board-key)
        (= auto-expand board-is-group)
        (= selection-mode (. SelectionMode multiple))
        (= can-drag (=> (node) (!= (. node name) "Background")))
        (= drag-items (=> (node) (call carried node)))
        (= can-drop (=> (drop) (call board-is-group (. drop parent))))
        (blank)
        (<> BoardRow (slot: row) (param: row)
          (= item (!! (. row #item)))
        )
      )
      (<> Label (• panel-status) (• h 20) (• mt 6)
        (= text #story)
      )
    )
  )
  (subscribe-for (on event (. tree dropped))
    (for (in node (. event items))
      (call board-detach model node)
    )
    (let siblings (!! (. event parent children)))
    (let offset Index (?? (. event index) (. siblings length)))
    (for (in node (. event items))
      (call (. siblings insert) node offset)
      (+= offset 1)
    )
    (let names (call (. ", " join) (in (. each name) (. event items))))
    (= story (str "Moved " names " into " (. event parent name)))
    (call (. tree reload))
  )
  (fn-do + carried _
    (param node BoardNode)
    (return-if (list node) (if (not (call (. tree is-key-selected) (call board-key node)))))
    (let result (list BoardNode))
    (let covered (? Index) null)
    (for (in entry (. tree entries))
      (if (and (!= covered null) (<= (. entry depth) covered))
        (= covered null)
      )
      (if (and (== covered null) (call (. tree is-key-selected) (. entry key)))
        (+= result (. entry item))
        (= covered (. entry depth))
      )
    )
    (return result)
  )
  (fn-expr + arrangement _ :get
    (call board-outline model)
  )
)

(type + BoardRow (is Box)
  (prop + item BoardNode)
  (content
    (<> This (• flex-row) (• flex 1)
      (if (call board-is-group item)
        (<> LucideLayers (• icon) (• w 14) (• h 14) (• mr 6)
          (= align-y (. Alignment center))
        )
        (<> Label (• board-group) (• flex 1)
          (= text (. item name))
          (= align-y (. Alignment center))
        )
        (else
          (<> LucideSpline (• icon) (• w 14) (• h 14) (• mr 6)
            (= align-y (. Alignment center))
          )
          (<> Label (• flex 1)
            (= text (. item name))
            (= align-y (. Alignment center))
          )
        )
      )
    )
  )
)

(type + BoardNode
  (prop + id Size)
  (prop + name String)
  (prop + children (? (list BoardNode)))
  (fn-do + This _
    (param id _)
    (param name _)
    (param children (? (list BoardNode)) (= null))
  )
)

(fn-expr _ gallery-swatches (list Swatch)
  (item (call Swatch "Coral" (call RGBA "#f97316") true))
  (item (call Swatch "Amber" (call RGBA "#d97706") true))
  (item (call Swatch "Ocean" (call RGBA "#2563eb") false))
)

(fn-expr _ gallery-files (list String)
  (item "Budget.xlsx")
  (item "Roadmap.md")
  (item "Launch photos")
)

(fn-expr _ gallery-tasks (list String)
  (item "Sketch the idea")
  (item "Collect references")
  (item "Block in shapes")
  (item "Refine the curves")
  (item "Choose colors")
  (item "Export")
)

(fn-do _ task-top _
  (param id Size)
  (param order (list Size))
  (param lifted (? Size))
  (param gap (? Index))
  (let slot Index 0)
  (for (in other order)
    (if (== other id)
      (if (and (!= gap null) (>= slot gap))
        (+= slot 1)
      )
      (return (call (. PositionOffset coord) (* (as slot Length) task-pitch)))
    )
    (if (or (== lifted null) (!= other lifted))
      (+= slot 1)
    )
  )
  (return (call (. PositionOffset coord) 0))
)

(fn-expr _ task-gap-top _
  (param gap (? Index))
  (call (. PositionOffset coord) (* (as (?? gap 0) Length) task-pitch))
)

(fn-expr _ task-display _
  (param id Size)
  (param lifted (? Size))
  (case? (and (!= lifted null) (== lifted id))
    (. Display hidden)
  )
  (default
    (. Display visible)
  )
)

(fn-expr _ board-fixture _
  (call BoardNode 0 "Document" layers)
  (where
    (lazy figure
      (call (of List BoardNode)
        (block
          (item (call BoardNode 2 "Head"))
          (item (call BoardNode 3 "Body"))
          (item (call BoardNode 4 "Shadow"))
        )
      )
    )
    (lazy scenery
      (call (of List BoardNode)
        (block
          (item (call BoardNode 6 "Sun"))
          (item (call BoardNode 7 "Hills"))
        )
      )
    )
    (lazy layers
      (call (of List BoardNode)
        (block
          (item (call BoardNode 1 "Figure" figure))
          (item (call BoardNode 5 "Scenery" scenery))
          (item (call BoardNode 8 "Empty group" (call (of List BoardNode))))
          (item (call BoardNode 9 "Signature"))
          (item (call BoardNode 10 "Background"))
        )
      )
    )
  )
)

(fn-expr _ board-children _
  (param node BoardNode)
  (. node children)
)

(fn-expr _ board-is-group _
  (param node BoardNode)
  (!= (. node children) null)
)

(fn-expr _ board-key _
  (param node BoardNode)
  (str (. node id))
)

(fn-do _ board-detach _
  (param parent BoardNode)
  (param node BoardNode)
  (let children (. parent children))
  (return-if (if (not children)))
  (for (in index (..< 0 (. children length)))
    (if (== (. ([] children index) id) (. node id))
      (call (. children remove) index)
      (return)
    )
  )
  (for (in child children)
    (call board-detach child node)
  )
)

(fn-expr _ board-outline String
  (param node BoardNode)
  (case? (not (. node children))
    (. node name)
  )
  (default
    (str (. node name) "(" inner ")")
  )
  (where
    (lazy inner (call (. " " join) (in (call board-outline each) (!! (. node children)))))
  )
)
