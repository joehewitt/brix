(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(style ScrollingTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFocusRingStyle)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (using GUIBoxScroll)
  (rule showcase-shell
    (= font-size 14)
  )
  (blank)
  (rule showcase-header (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule showcase-title
    (= font-size 22)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule showcase-subtitle (• text gui-muted-text-color))
  (blank)
  (rule showcase-body
    (= font-size 13)
  )
  (blank)
  (rule showcase-panel (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule panel-kicker (• group-heading))
  (blank)
  (rule panel-title (• text gui-strong-text-color)
    (= font-size 18)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule panel-copy (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule viewport (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 2)
  )
  (blank)
  (rule status-chip (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 12)
  )
  (blank)
  (rule control-row
    (= font-size 12)
  )
  (blank)
  (rule showcase-button (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-weight (. FontWeight bold))
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
    )
  )
  (blank)
  (rule clip-note (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule clipped-example (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule nested-column (• bg "#eef2ff") (• text "#0f172a")
    (= border-color "#818cf8")
    (= border-width 1)
  )
)

(type + ScrollingPanel (is Box)
  (using ScrollingTheme)
  (content
    (<> This (• showcase-shell) (• flex-col) (• p 18)
      (<> Box (• showcase-header) (• flex-col) (• h 78) (• px 18) (• py 12)
        (<> Label (• showcase-title)
          (= text "Box scrolling playground")
        )
        (blank)
        (<> Label (• showcase-subtitle) (• mt 5)
          (= text "Wheel, trackpad, nested axes, containment, and button controls")
        )
      )
      (blank)
      (<> Box (• showcase-body) (• flex-row) (• flex 1) (• mt 14)
        (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• p 14)
          (<> Label (• panel-kicker)
            (= text "VERTICAL · AUTO")
          )
          (blank)
          (<> Label (• panel-title) (• mt 4)
            (= text "Fractional pixel scrolling")
          )
          (blank)
          (<> Label (• panel-copy) (• mt 5)
            (= text "At either edge, unused vertical motion can continue to an ancestor.")
          )
          (blank)
          (<> VerticalAutoPane (id: vertical) (• viewport) (• flex 1) (• mt 12)
            (<> ShowcaseRow (text: "01 · Box owns the viewport"))
            (<> ShowcaseRow (text: "02 · Layout stays unscrolled"))
            (<> ShowcaseRow (text: "03 · Content translates in paint"))
            (<> ShowcaseRow (text: "04 · Hit testing inverts motion"))
            (<> ShowcaseRow (text: "05 · Fractions remain fractions"))
            (<> ShowcaseRow (text: "06 · Large deltas report remainder"))
            (<> ShowcaseRow (text: "07 · Focus can reveal descendants"))
            (<> ShowcaseRow (text: "08 · State clamps after layout"))
            (<> ShowcaseRow (text: "09 · Background stays stationary"))
            (<> ShowcaseRow (text: "10 · Border stays stationary"))
            (<> ShowcaseRow (text: "11 · Native geometry follows"))
            (<> ShowcaseRow (text: "12 · Every Box has the API"))
          )
          (blank)
          (<> Label (id: vertical-label) (• status-chip) (• mt 10)
            (= text "position x 0 · y 0")
          )
          (blank)
          (<> Box (• control-row) (• flow-row) (• mt 9)
            (<> ScrollShowcaseButton (text: "vertical-up"))
            (<> ScrollShowcaseButton (text: "vertical-down") (• ml 7))
            (<> ScrollShowcaseButton (text: "vertical-start") (• ml 7))
            (<> ScrollShowcaseButton (text: "vertical-end") (• ml 7))
          )
        )
        (blank)
        (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• ml 14) (• p 14)
          (<> Label (• panel-kicker)
            (= text "HORIZONTAL · CONTAIN")
          )
          (blank)
          (<> Label (• panel-title) (• mt 4)
            (= text "A self-contained strip")
          )
          (blank)
          (<> Label (• panel-copy) (• mt 5)
            (= text "Pan sideways. At either edge, remainder stops here.")
          )
          (blank)
          (<> HorizontalContainedPane (id: horizontal) (• viewport) (• h 188) (• mt 12)
            (<> ShowcaseCard (text: "Alpha"))
            (<> ShowcaseCard (text: "Beta"))
            (<> ShowcaseCard (text: "Gamma"))
            (<> ShowcaseCard (text: "Delta"))
            (<> ShowcaseCard (text: "Epsilon"))
            (<> ShowcaseCard (text: "Zeta"))
          )
          (blank)
          (<> Label (id: horizontal-label) (• status-chip) (• mt 10)
            (= text "position x 0 · y 0 · contained")
          )
          (blank)
          (<> Box (• control-row) (• flow-row) (• mt 9)
            (<> ScrollShowcaseButton (text: "horizontal-left"))
            (<> ScrollShowcaseButton (text: "horizontal-right") (• ml 7))
            (<> ScrollShowcaseButton (text: "horizontal-start") (• ml 7))
            (<> ScrollShowcaseButton (text: "horizontal-end") (• ml 7))
          )
          (blank)
          (<> Box (• clip-note) (• flex-col) (• flex 1) (• mt 14) (• p 12)
            (<> Label (• panel-kicker)
              (= text "CLIP · NOT SCROLLABLE")
            )
            (blank)
            (<> Label (• panel-copy) (• mt 6)
              (= text "Tall content is clipped, but this Box consumes no scrolling.")
            )
            (blank)
            (<> ClippedExample (• clipped-example) (• flex 1) (• mt 8)
              (<> ShowcaseRow (text: "Visible beginning"))
              (<> ShowcaseRow (text: "Still visible"))
              (<> ShowcaseRow (text: "Clipped below"))
              (<> ShowcaseRow (text: "Never a wheel sink"))
            )
          )
        )
        (blank)
        (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• ml 14) (• p 14)
          (<> Label (• panel-kicker)
            (= text "NESTED · INDEPENDENT AXES")
          )
          (blank)
          (<> Label (• panel-title) (• mt 4)
            (= text "Horizontal deck, vertical columns")
          )
          (blank)
          (<> Label (• panel-copy) (• mt 5)
            (= text "Diagonal input moves a column and its deck in one event.")
          )
          (blank)
          (<> NestedHorizontalPane (id: nested) (• viewport) (• flex 1) (• mt 12)
            (<> NestedVerticalPane (• nested-column)
              (<> ColumnRow (text: "A · one"))
              (<> ColumnRow (text: "A · two"))
              (<> ColumnRow (text: "A · three"))
              (<> ColumnRow (text: "A · four"))
              (<> ColumnRow (text: "A · five"))
              (<> ColumnRow (text: "A · six"))
              (<> ColumnRow (text: "A · seven"))
              (<> ColumnRow (text: "A · eight"))
            )
            (blank)
            (<> NestedVerticalPane (• nested-column) (• ml 10)
              (<> ColumnRow (text: "B · amber"))
              (<> ColumnRow (text: "B · blue"))
              (<> ColumnRow (text: "B · coral"))
              (<> ColumnRow (text: "B · denim"))
              (<> ColumnRow (text: "B · emerald"))
              (<> ColumnRow (text: "B · fuchsia"))
              (<> ColumnRow (text: "B · gold"))
              (<> ColumnRow (text: "B · haze"))
            )
            (blank)
            (<> NestedVerticalPane (• nested-column) (• ml 10)
              (<> ColumnRow (text: "C · north"))
              (<> ColumnRow (text: "C · east"))
              (<> ColumnRow (text: "C · south"))
              (<> ColumnRow (text: "C · west"))
              (<> ColumnRow (text: "C · inner"))
              (<> ColumnRow (text: "C · outer"))
              (<> ColumnRow (text: "C · start"))
              (<> ColumnRow (text: "C · end"))
            )
          )
          (blank)
          (<> Label (id: nested-label) (• status-chip) (• mt 10)
            (= text "deck x 0 · y 0")
          )
          (blank)
          (<> Box (• control-row) (• flow-row) (• mt 9)
            (<> ScrollShowcaseButton (text: "nested-left"))
            (<> ScrollShowcaseButton (text: "nested-right") (• ml 7))
            (<> ScrollShowcaseButton (text: "nested-start") (• ml 7))
            (<> ScrollShowcaseButton (text: "nested-end") (• ml 7))
          )
        )
      )
    )
  )
  (fn-do + perform-scroll _
    (param action String)
    (if (== action "vertical-up")
      (call (. vertical scroll-by) (call Point 0 -48))
      (else-if (== action "vertical-down")
        (call (. vertical scroll-by) (call Point 0 48))
      )
      (else-if (== action "vertical-start")
        (call (. vertical scroll-to-start) (. Orientation vertical))
      )
      (else-if (== action "vertical-end")
        (call (. vertical scroll-to-end) (. Orientation vertical))
      )
      (else-if (== action "horizontal-left")
        (call (. horizontal scroll-by) (call Point -80 0))
      )
      (else-if (== action "horizontal-right")
        (call (. horizontal scroll-by) (call Point 80 0))
      )
      (else-if (== action "horizontal-start")
        (call (. horizontal scroll-to-start) (. Orientation horizontal))
      )
      (else-if (== action "horizontal-end")
        (call (. horizontal scroll-to-end) (. Orientation horizontal))
      )
      (else-if (== action "nested-left")
        (call (. nested scroll-by) (call Point -100 0))
      )
      (else-if (== action "nested-right")
        (call (. nested scroll-by) (call Point 100 0))
      )
      (else-if (== action "nested-start")
        (call (. nested scroll-to-start) (. Orientation horizontal))
      )
      (else-if (== action "nested-end")
        (call (. nested scroll-to-end) (. Orientation horizontal))
      )
    )
  )
  (subscribe-for (on event (. vertical scroll-changed))
    (= (. vertical-label text) (str "position x " (. vertical scroll-x) " · y " (. vertical scroll-y)))
  )
  (subscribe-for (on event (. horizontal scroll-changed))
    (= (. horizontal-label text) (str "position x " (. horizontal scroll-x) " · y " (. horizontal scroll-y) " · contained"))
  )
  (subscribe-for (on event (. nested scroll-changed))
    (= (. nested-label text) (str "deck x " (. nested scroll-x) " · y " (. nested scroll-y)))
  )
)

(type + VerticalAutoPane (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation vertical)))
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow auto))
    (= overscroll-behavior-y (. OverscrollBehavior auto))
  )
)

(type + HorizontalContainedPane (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation horizontal)))
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow clip))
    (= overscroll-behavior-x (. OverscrollBehavior contain))
    (= scroll-indicator-x (. ScrollIndicatorVisibility always))
    (= scroll-indicator-gutter (. ScrollIndicatorGutter stable))
  )
)

(type + NestedHorizontalPane (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation horizontal)))
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow clip))
    (= scroll-indicator-x (. ScrollIndicatorVisibility hidden))
  )
)

(type + NestedVerticalPane (is Box)
  (rule This (• w 230) (• h 318)
    (= layout (call FlowLayout (. Orientation vertical)))
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow auto))
  )
)

(type + ClippedExample (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation vertical)))
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + ShowcaseRow (is Box)
  (prop + title String)
  (blank)
  (rule This (• h 48) (• mb 7) (• px 12) (• bg "#e0f2fe") (• text "#0f172a")
    (= border-color "#cbd5e1")
    (= border-width 1)
  )
  (fn-do + This _
    (param title _)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= text title)
      )
    )
  )
)

(type + ShowcaseCard (is Box)
  (prop + title String)
  (blank)
  (rule This (• w 154) (• h 152) (• mr 9) (• p 12) (• bg "#ccfbf1") (• text "#0f172a")
    (= border-color "#94a3b8")
    (= border-width 1)
  )
  (fn-do + This _
    (param title _)
  )
  (content
    (<> This (• flex-col)
      (<> Box (• flex 1))
      (<> Label (• h 28)
        (= text title)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
)

(type + ColumnRow (is Box)
  (prop + title String)
  (blank)
  (rule This (• h 45) (• mb 6) (• px 11) (• bg "#ffffff") (• text "#0f172a")
    (= border-color "#c7d2fe")
    (= border-width 1)
  )
  (fn-do + This _
    (param title _)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= text title)
      )
    )
  )
)

(type + ScrollShowcaseButton (is Box)
  (prop + action String)
  (prop + title _ (=> (call scroll-showcase-button-title action)))
  (blank)
  (rule This (• showcase-button) (• w 72) (• h 30)
    (= focus-mode (. FocusMode press))
  )
  (fn-do + This _
    (param action _)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= text title)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. (call (of ancestor ScrollingPanel)) perform-scroll) action)
  )
)

(fn-expr _ scroll-showcase-button-title String
  (param action String)
  (match action
    (case= "vertical-up"
      "− 48"
    )
    (case= "vertical-down"
      "+ 48"
    )
    (case= "horizontal-left"
      "← 80"
    )
    (case= "horizontal-right"
      "80 →"
    )
    (case= "nested-left"
      "← Deck"
    )
    (case= "nested-right"
      "Deck →"
    )
    (case= "vertical-start"
      "Start"
    )
    (case= "horizontal-start"
      "Start"
    )
    (case= "nested-start"
      "Start"
    )
    (default
      "End"
    )
  )
)
