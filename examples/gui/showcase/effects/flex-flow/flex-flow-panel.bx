(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/boxes)
(import /gui/icons/lucide/columns-3)
(import /gui/icons/lucide/move)
(import /gui/icons/lucide/panels-top-left)
(import /gui/icons/lucide/rows-3)

(style FlexFlowTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (rule gallery-header (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule gallery-title
    (= font-size 22)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule gallery-subtitle (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule header-pill (• bg gui-field-color) (• px 9) (• py 6)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 11)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule sidebar (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule section-title (• text gui-strong-text-color)
    (= font-size 17)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule section-note (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule field-label
    (= font-size 12)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule live-status (• text gui-accent-bright-color)
    (= font-size 11)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule sidebar-legend (• bg gui-field-color) (• text gui-muted-text-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 11)
  )
  (blank)
  (rule legend-swatch
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule swatch-flex (• bg "#3b82f6"))
  (blank)
  (rule swatch-flow (• bg "#8b5cf6"))
  (blank)
  (rule swatch-absolute (• bg "#f59e0b"))
  (blank)
  (rule sidebar-footer (• text gui-muted-text-color)
    (= font-size 10)
  )
  (blank)
  (rule specimen (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule constrained-specimen
    (= border-color "#86efac")
  )
  (blank)
  (rule flow-specimen
    (= border-color "#d8b4fe")
  )
  (blank)
  (rule specimen-kicker (• text gui-muted-text-color)
    (= font-size 10)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule specimen-title (• text gui-strong-text-color)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule allocation-cell (• text "#ffffff")
    (= font-size 18)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule allocation-a (• bg "#2563eb"))
  (blank)
  (rule allocation-b (• bg "#7c3aed"))
  (blank)
  (rule allocation-c (• bg "#db2777"))
  (blank)
  (rule allocation-caption
    (= font-size 10)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule weighted-cell
    (= border-width 1)
  )
  (blank)
  (rule weighted-one (• bg "#e0f2fe") (• text "#075985")
    (= border-color "#7dd3fc")
  )
  (blank)
  (rule weighted-two (• bg "#ede9fe") (• text "#5b21b6")
    (= border-color "#c4b5fd")
  )
  (blank)
  (rule weighted-three (• bg "#ffe4e6") (• text "#9f1239")
    (= border-color "#fda4af")
  )
  (blank)
  (rule constraint-meter (• bg "#dcfce7") (• text "#166534")
    (= border-color "#86efac")
    (= border-width 1)
  )
  (blank)
  (rule constraint-note (• text "#15803d")
    (= font-size 9)
  )
  (blank)
  (rule flow-readout (• text gui-muted-text-color)
    (= font-size 11)
  )
  (blank)
  (rule flow-chip (• bg "#ede9fe") (• text "#5b21b6") (• px 10) (• py 7)
    (= border-color "#c4b5fd")
    (= border-width 1)
    (= font-size 12)
  )
  (blank)
  (rule icon-chip (• bg "#dbeafe")
    (= border-color "#93c5fd")
    (= border-width 1)
  )
  (blank)
  (rule changing-chip (• bg "#fff7ed") (• text "#9a3412") (• px 10) (• py 7)
    (= border-color "#fdba74")
    (= border-width 1)
    (= font-size 12)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule optional-chip (• bg "#ecfdf5") (• text "#047857")
    (= border-color "#6ee7b7")
  )
  (blank)
  (rule column-item (• bg "#eff6ff") (• text "#1e40af") (• px 9) (• py 6)
    (= border-color "#bfdbfe")
    (= border-width 1)
  )
  (blank)
  (rule mini-chip (• bg gui-pressed-color) (• px 7) (• py 4)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 10)
  )
  (blank)
  (rule nested-stage (• bg gui-well-color) (• p 10)
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule mini-flex
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule mini-flex-a (• bg "#38bdf8"))
  (blank)
  (rule mini-flex-b (• bg "#8b5cf6"))
  (blank)
  (rule mini-flex-c (• bg "#fb7185"))
  (blank)
  (rule display-caption (• text gui-muted-text-color)
    (= font-size 10)
  )
  (blank)
  (rule participation-chip (• px 7) (• py 5)
    (= border-width 1)
    (= font-size 9)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule visible-chip (• bg "#dcfce7") (• text "#166534")
    (= border-color "#86efac")
  )
  (blank)
  (rule invisible-chip (• bg "#fef3c7") (• text "#92400e")
    (= border-color "#fcd34d")
  )
  (blank)
  (rule hidden-chip (• bg "#fee2e2") (• text "#991b1b")
    (= border-color "#fca5a5")
  )
  (blank)
  (rule trailing-chip (• bg "#dbeafe") (• text "#1d4ed8")
    (= border-color "#93c5fd")
  )
  (blank)
  (rule overlay-badge (• bg "#fef3c7") (• text "#92400e")
    (= border-color "#f59e0b")
    (= border-width 1)
    (= font-size 9)
    (= font-weight (. FontWeight bold))
  )
)

(type + FlexFlowPanel (is Box)
  (using FlexFlowTheme)
  (prop + level F64 (= 24))
  (blank)
  (rule This
    (= font-size 14)
  )
  (content
    (<> This (• flex-col) (• p 18)
      (<> Box (• gallery-header) (• flex-row) (• h 66) (• px 18) (• py 10)
        (<> Box (• flex-col) (• flex 1)
          (<> Label (• gallery-title)
            (= text "Flex + Flow layout gallery")
          )
          (blank)
          (<> Label (• gallery-subtitle) (• mt 4)
            (= text "Nested axes · intrinsic controls · constraints · live reflow")
          )
        )
        (blank)
        (<> Box (• flow-row)
          (<> Label (• header-pill)
            (= text "FLEX")
          )
          (<> Label (• header-pill) (• ml 8)
            (= text "FLOW")
          )
          (<> Label (• header-pill) (• ml 8)
            (= text "REFLOW")
          )
        )
      )
      (blank)
      (<> Box (• flex-row) (• flex 1) (• mt 14)
        ; Fixed-width column containing a vertically flexed and vertically flowing mix.
        (<> Box (• sidebar) (• flex-col) (• w 238) (• p 14)
          (<> Box (• flow-row)
            (<> LucidePanelsTopLeft (• icon) (• w 24) (• h 24) (• text gui-accent-bright-color))
            (<> Label (• section-title) (• ml 9)
              (= text "Content types")
            )
          )
          (blank)
          (<> Label (• section-note) (• mt 6)
            (= text "A fixed flex column")
          )
          (blank)
          (<> Box (• flow-col) (• flex 1) (• mt 16)
            (<> Label (• field-label)
              (= text "Intrinsic native input")
            )
            (blank)
            (<> TextInput (• mt 6)
              (= placeholder "Type to change fitting content")
            )
            (blank)
            (<> Label (• field-label) (• mt 14)
              (= text "Canvas Slider drives live flow")
            )
            (blank)
            (<> Slider (• mt 6)
              (= minimum 0)
              (= maximum 100)
              (= value 24)
              (for (on event value-changed)
                (= level (. event value))
              )
            )
            (blank)
            (<> Label (• live-status) (• mt 8)
              (= text (call flex-flow-status #level))
            )
            (blank)
            (<> Box (• sidebar-legend) (• flow-col) (• mt 18) (• p 10)
              (<> Box (• flow-row)
                (<> Box (• legend-swatch) (• swatch-flex) (• w 12) (• h 12))
                (<> Label (• ml 8)
                  (= text "Flex distributes space")
                )
              )
              (blank)
              (<> Box (• flow-row) (• mt 8)
                (<> Box (• legend-swatch) (• swatch-flow) (• w 12) (• h 12))
                (<> Label (• ml 8)
                  (= text "Flow keeps natural size")
                )
              )
              (blank)
              (<> Box (• flow-row) (• mt 8)
                (<> Box (• legend-swatch) (• swatch-absolute) (• w 12) (• h 12))
                (<> Label (• ml 8)
                  (= text "Absolute leaves the slot")
                )
              )
            )
          )
          (blank)
          (<> Label (• sidebar-footer)
            (= text "Resize the window and move the slider")
          )
        )
        (blank)
        ; The main column combines fixed-height specimens with a flexible lower region.
        (<> Box (• flex-col) (• flex 1) (• ml 14)
          ; Three constrained flex children: 1fr, 2fr, and a max-width 1fr child.
          (<> Box (• flex-row) (• h 190)
            (<> Box (• specimen) (• flex-col) (• flex 1) (• p 14)
              (<> Label (• specimen-kicker)
                (= text "FLEX ROW")
              )
              (<> Label (• specimen-title) (• mt 4)
                (= text "Equal weights")
              )
              (blank)
              (<> Box (• flex-row) (• flex 1) (• mt 14)
                (<> Box (• allocation-cell) (• allocation-a) (• flow-col) (• flex 1) (• p 9)
                  (<> Label
                    (= text "1")
                  )
                  (<> Label (• allocation-caption) (• mt 3)
                    (= text "one part")
                  )
                )
                (blank)
                (<> Box (• allocation-cell) (• allocation-b) (• flow-col) (• flex 1) (• ml 6) (• p 9)
                  (<> Label
                    (= text "1")
                  )
                  (<> Label (• allocation-caption) (• mt 3)
                    (= text "one part")
                  )
                )
                (blank)
                (<> Box (• allocation-cell) (• allocation-c) (• flow-col) (• flex 1) (• ml 6) (• p 9)
                  (<> Label
                    (= text "1")
                  )
                  (<> Label (• allocation-caption) (• mt 3)
                    (= text "remainder")
                  )
                )
              )
            )
            (blank)
            (<> Box (• specimen) (• flex-col) (• flex 2) (• ml 12) (• p 14)
              (<> Label (• specimen-kicker)
                (= text "NESTED FLEX")
              )
              (<> Label (• specimen-title) (• mt 4)
                (= text "Weighted content panels")
              )
              (blank)
              (<> Box (• flex-row) (• flex 1) (• mt 14)
                (<> Box (• weighted-cell) (• weighted-one) (• flex-col) (• flex 1) (• p 9)
                  (<> LucideColumnsN3 (• w 25) (• h 25)
                    (= stroke "#0369a1")
                  )
                  (<> Label (• allocation-caption) (• mt 7)
                    (= text "1×")
                  )
                )
                (blank)
                (<> Box (• weighted-cell) (• weighted-two) (• flex-col) (• flex 2) (• ml 7) (• p 9)
                  (<> LucideRowsN3 (• w 25) (• h 25)
                    (= stroke "#6d28d9")
                  )
                  (<> Label (• allocation-caption) (• mt 7)
                    (= text "2× receives twice the remainder")
                  )
                )
                (blank)
                (<> Box (• weighted-cell) (• weighted-three) (• flex-col) (• flex 1) (• ml 7) (• p 9)
                  (<> LucideMove (• w 25) (• h 25)
                    (= stroke "#be123c")
                  )
                  (<> Label (• allocation-caption) (• mt 7)
                    (= text "1×")
                  )
                )
              )
            )
            (blank)
            (<> Box (• specimen) (• constrained-specimen) (• flex-col) (• flex 1) (• ml 12) (• p 14) (• max-w 238)
              (<> Label (• specimen-kicker)
                (= text "MAX WIDTH")
              )
              (<> Label (• specimen-title) (• mt 4)
                (= text "Frozen flex child")
              )
              (blank)
              (<> Box (• constraint-meter) (• flex-col) (• flex 1) (• mt 14) (• p 10)
                (<> LucideBoxes (• w 30) (• h 30)
                  (= stroke "#047857")
                )
                (<> Label (• allocation-caption) (• mt 8)
                  (= text "Caps at 238 pt")
                )
                (<> Label (• constraint-note) (• mt 4)
                  (= text "Unused weight is redistributed")
                )
              )
            )
          )
          (blank)
          ; Horizontal flow mixes text, vector art, and controls at natural sizes.
          (<> Box (• specimen) (• flow-specimen) (• flex-col) (• h 130) (• mt 12) (• p 14)
            (<> Box (• flex-row)
              (<> Box (• flex-col) (• flex 1)
                (<> Label (• specimen-kicker)
                  (= text "FLOW ROW")
                )
                (<> Label (• specimen-title) (• mt 4)
                  (= text "Natural content, no space distribution")
                )
              )
              (blank)
              (<> Label (• flow-readout)
                (= text "intrinsic → sequential")
              )
            )
            (blank)
            (<> Box (• flow-row) (• mt 14)
              (<> Label (• flow-chip)
                (= text "Label + padding")
              )
              (blank)
              (<> LucideMove (• icon-chip) (• w 34) (• h 34) (• ml 8) (• p 5)
                (= stroke "#2563eb")
              )
              (blank)
              (<> Label (• changing-chip) (• ml 8)
                (= text (if-expr (>= #level 50) "A much longer intrinsically measured Label" "Short label"))
              )
              (blank)
              (<> LayoutVisibilityChip (• flow-chip) (• optional-chip) (• ml 8)
                (= text "Optional slot")
                (= is-layout-hidden (>= #level 82))
              )
              (blank)
              (<> TextInput (• w 170) (• ml 8)
                (= text "Native input")
              )
              (blank)
              (<> Slider (• w 140) (• ml 8)
                (= minimum 0)
                (= maximum 1)
                (= value 0.62)
              )
            )
          )
          (blank)
          (<> Box (• flex-row) (• flex 1) (• mt 12)
            ; Vertical flow stretches every outer box across this panel's content width.
            (<> Box (• specimen) (• flex-col) (• flex 1) (• p 14)
              (<> Label (• specimen-kicker)
                (= text "FLOW COLUMN")
              )
              (<> Label (• specimen-title) (• mt 4)
                (= text "Mixed natural heights")
              )
              (blank)
              (<> Box (• flow-col) (• flex 1) (• mt 12)
                (<> Label (• column-item)
                  (= text "Canvas Label — natural text height")
                )
                (blank)
                (<> TextInput (• mt 7)
                  (= placeholder "Native control — natural fitting height")
                )
                (blank)
                (<> Slider (• mt 7)
                  (= minimum 0)
                  (= maximum 10)
                  (= value 6)
                )
                (blank)
                (<> Box (• flow-row) (• mt 8)
                  (<> Label (• mini-chip)
                    (= text "nested")
                  )
                  (<> Label (• mini-chip) (• ml 6)
                    (= text "flow row")
                  )
                  (<> Label (• mini-chip) (• ml 6)
                    (= text "inside flow col")
                  )
                )
              )
            )
            (blank)
            ; This panel layers nested flex, display participation, and an overlay.
            (<> Box (• specimen) (• flex-col) (• flex 1) (• ml 12) (• p 14)
              (<> Label (• specimen-kicker)
                (= text "NESTING + POSITION")
              )
              (<> Label (• specimen-title) (• mt 4)
                (= text "Flex, display filtering, absolute anchor")
              )
              (blank)
              (<> Box (• nested-stage) (• flex-col) (• flex 1) (• mt 12)
                (<> Box (• flex-row) (• h 48)
                  (<> Box (• mini-flex) (• mini-flex-a) (• flex 1))
                  (<> Box (• mini-flex) (• mini-flex-b) (• flex 2) (• ml 6))
                  (<> Box (• mini-flex) (• mini-flex-c) (• flex 1) (• ml 6))
                )
                (blank)
                (<> Label (• display-caption) (• mt 12)
                  (= text "visible · invisible gap · hidden closes · trailing")
                )
                (blank)
                (<> Box (• flow-row) (• mt 7)
                  (<> Label (• participation-chip) (• visible-chip)
                    (= text "VISIBLE")
                  )
                  (<> Label (• participation-chip) (• invisible-chip) (• ml 7)
                    (= text "INVISIBLE")
                    (= display (. Display invisible))
                  )
                  (<> Label (• participation-chip) (• hidden-chip) (• ml 7)
                    (= text "HIDDEN")
                    (= display (. Display hidden))
                  )
                  (<> Label (• participation-chip) (• trailing-chip) (• ml 7)
                    (= text "TRAILING")
                  )
                )
              )
              (blank)
              (<> Box (• overlay-badge) (• absolute) (• flow-row) (• px 9) (• py 6)
                (= right (call (. PositionOffset coord) 12))
                (= top (call (. PositionOffset coord) 12))
                (blank)
                (<> Label
                  (= text "ABSOLUTE")
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + LayoutVisibilityChip (is Label)
  (prop + is-layout-hidden _ (= false))
  (blank)
  (rule This
    (when-style #is-layout-hidden
      (= display (. Display hidden))
    )
  )
)

(fn-expr + flex-flow-status String
  (param level F64)
  (case? (>= level 82)
    "Long label · optional chip hidden"
  )
  (case? (>= level 50)
    "Long label · optional chip visible"
  )
  (default
    "Short label · optional chip visible"
  )
)
