(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shader)
(import /graphics/text)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ canvas-effects-photo-image (? RasterCanvas))
(prop _ canvas-effects-badge-image (? RasterCanvas))
(prop _ canvas-effects-shader-list (list Shader))

(style CanvasEffectsTheme
  (using GUIDefaultTheme)
  (rule canvas-effects-tile (• bg white) (• px 12) (• pt 10) (• pb 12) (• mr 16)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 16)
  )
  (blank)
  (rule canvas-effects-control (• mr 28))
)

(type + CanvasEffectsTile (is Tuple)
  (prop + kind String)
  (prop + heading String)
  (prop + detail String)
  (prop + width Length (= 220))
)

(type + CanvasEffectsPanel (is Box)
  (using CanvasEffectsTheme)
  (prop + angle F64)
  (prop + spin F64)
  (prop + zoom F64 (= 1))
  (prop + blur-radius F64 (= 8))
  (prop + blend-code I32 (= 2))
  (prop + time F64)
  (blank)
  (rule This (• w 1224) (• h 722))
  (content
    (<> This (• flex-col) (• px 22) (• pt 20)
      (<> Label (• h 34)
        (= text "Canvas effects")
        (= font-size 25)
        (= font-weight (. FontWeight bold))
      )
      (blank)
      (<> Label (• h 22) (• text gui-muted-text-color)
        (= text
          (call join
            (:stream
              (block
                (item "Gradients, path shadows, blend modes, masks, clips, images, strokes, groups, ")
                (item "layer blur, and MSL shaders, drawn through the canvas API.")
              )
            )
          )
        )
        (= font-size 14)
      )
      (blank)
      (<> Box (• flex-row) (• h 58) (• mt 14)
        (<> Box (• canvas-effects-control) (• flex-col) (• w 210)
          (<> Label (• h 20)
            (= text (str "Rotate " (call round #angle) "°"))
            (= font-size 13)
            (= font-weight (. FontWeight bold))
          )
          (<> Slider (• h 28) (• mt 4)
            (= minimum -180)
            (= maximum 180)
            (<-> value angle)
          )
        )
        (blank)
        (<> Box (• canvas-effects-control) (• flex-col) (• w 210)
          (<> Label (• h 20)
            (= text (str "Zoom " (call round (* #zoom 100)) "%"))
            (= font-size 13)
            (= font-weight (. FontWeight bold))
          )
          (<> Slider (• h 28) (• mt 4)
            (= minimum 0.5)
            (= maximum 1.6)
            (<-> value zoom)
          )
        )
        (blank)
        (<> Box (• canvas-effects-control) (• flex-col) (• w 210)
          (<> Label (• h 20)
            (= text (str "Blur " (call round #blur-radius)))
            (= font-size 13)
            (= font-weight (. FontWeight bold))
          )
          (<> Slider (• h 28) (• mt 4)
            (= minimum 0)
            (= maximum 24)
            (<-> value blur-radius)
          )
        )
        (blank)
        (<> Box (• canvas-effects-control) (• flex-col) (• w 250)
          (<> Label (• h 20)
            (= text (str "Blend mode: " (call canvas-effects-mode-name #blend-code)))
            (= font-size 13)
            (= font-weight (. FontWeight bold))
          )
          (<> Slider (• h 28) (• mt 4)
            (= minimum 0)
            (= maximum 27)
            (= step 1)
            (= value 2)
            (for (on event value-changed)
              (= blend-code (as (call round (. event value)) I32))
            )
          )
        )
      )
      (blank)
      (for (in row (..< 0 2))
        (<> Box (• flex-row) (• mt 18)
          (for (in tile (call canvas-effects-tiles row))
            (<> Box (• canvas-effects-tile) (• flex-col) (• h 254) (• w (. tile width))
              (<> Label (• h 22) (• text "#0f172a")
                (= text (. tile heading))
                (= font-size 15)
                (= font-weight (. FontWeight bold))
              )
              (<> CanvasEffectArt (• h 170) (• mt 6) (• w (. tile width))
                (= kind (. tile kind))
                (= angle (+ #angle #spin))
                (= zoom #zoom)
                (= blur-radius #blur-radius)
                (= blend-code #blend-code)
                (= time #time)
              )
              (<> Label (• h 48) (• mt 8) (• text "#475569")
                (= text (. tile detail))
                (= font-size 12)
                (= text-wrap (. TextWrap word))
              )
            )
          )
        )
      )
    )
  )
)

(type + CanvasEffectArt (is Box)
  (prop + kind _ (= "gradients"))
  (prop + angle F64 (= 0))
  (prop + zoom F64 (= 1))
  (prop + blur-radius F64 (= 8))
  (prop + blend-code I32 (= 2))
  (prop + time F64 (= 0))
  (blank)
  (depends invalidate-paint kind angle zoom blur-radius blend-code time)
  (blank)
  (rule This (• bg "#f1f5f9")
    (= corner-radius 12)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect content-bounds)
    (let center (call Point (/ (. rect width) 2) (/ (. rect height) 2)))
    (let mode (as blend-code BlendMode))
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. rect x) (. rect y))
      (call (. canvas transform) (call canvas-effects-matrix angle zoom center))
      (do
        (inline
          (match kind
            (case= "gradients"
              (call paint-effect-gradients canvas)
            )
            (case= "shadows"
              (call paint-effect-shadows canvas blur-radius)
            )
            (case= "blend"
              (call paint-effect-blend canvas mode)
            )
            (case= "masks"
              (call paint-effect-masks canvas)
            )
            (case= "clips"
              (call paint-effect-clips canvas)
            )
            (case= "images"
              (call paint-effect-images canvas)
            )
            (case= "strokes"
              (call paint-effect-strokes canvas)
            )
            (case= "shaders"
              (call paint-effect-shaders canvas mode time)
            )
            (default
              (call paint-effect-groups canvas mode blur-radius)
            )
          )
        )
      )
    )
  )
)

(fn-expr + canvas-effects-tiles _
  (param row Size)
  (if-expr (== row 0) (call canvas-effects-first-row) (call canvas-effects-second-row))
)

(fn-expr _ canvas-effects-first-row (list CanvasEffectsTile)
  (item
    (call CanvasEffectsTile
      (block
        (arg "gradients")
        (arg "Gradients")
        (arg "Linear, radial, and conic gradients, clipped to rounded shapes.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "shadows")
        (arg "Path shadows")
        (arg "shadow-path on a card, a star, and a heart with a coloured glow.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "blend")
        (arg "Blend modes")
        (arg "Three circles drawn with the chosen mode over a photo and a grey ramp.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "masks")
        (arg "Masks")
        (arg "begin-mask with a radial fade, and clip-mask with an image's alpha.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "clips")
        (arg "Clips")
        (arg "A speech-bubble outline clip and an even-odd ring path clip.")
      )
    )
  )
)

(fn-expr _ canvas-effects-second-row (list CanvasEffectsTile)
  (item
    (call CanvasEffectsTile
      (block
        (arg "images")
        (arg "Images")
        (arg "A tilted photo in a shadowed frame, and a badge tinted as a template.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "strokes")
        (arg "Strokes")
        (arg "Caps, joins, a dashed curve, and hairlines.")
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "groups")
        (arg "Groups and blur")
        (arg
          (call join
            (:stream
              (block
                (item "Left: a 60% opacity group blurred by the Blur slider. ")
                (item "Right: a group composited with the chosen mode.")
              )
            )
          )
        )
      )
    )
  )
  (item
    (call CanvasEffectsTile
      (block
        (arg "shaders")
        (arg "Shaders")
        (arg
          (call join
            (:stream
              (block
                (item "MSL fill shaders: plasma in a rounded clip, translucent ripples, and light bands ")
                (item "drawn over a photo with the chosen mode. Animate runs them.")
              )
            )
          )
        )
        (arg 456)
      )
    )
  )
)

(fn-expr + canvas-effects-mode-name _
  (param code I32)
  ([] (call canvas-effects-mode-names) code)
)

(fn-expr _ canvas-effects-mode-names (list String)
  (item "Normal")
  (item "Multiply")
  (item "Screen")
  (item "Overlay")
  (item "Darken")
  (item "Lighten")
  (item "Color dodge")
  (item "Color burn")
  (item "Soft light")
  (item "Hard light")
  (item "Difference")
  (item "Exclusion")
  (item "Hue")
  (item "Saturation")
  (item "Color")
  (item "Luminosity")
  (item "Clear")
  (item "Copy")
  (item "Source in")
  (item "Source out")
  (item "Source atop")
  (item "Destination over")
  (item "Destination in")
  (item "Destination out")
  (item "Destination atop")
  (item "XOR")
  (item "Plus darker")
  (item "Plus lighter")
)

(fn-expr _ canvas-effects-matrix _
  (param angle F64)
  (param zoom F64)
  (param center Point)
  (call (. (call (. (call (. rotated translate) center) scale) (call Dimensions zoom zoom)) translate) (call Point (- (. center x)) (- (. center y))))
  (where
    (lazy rotated (call (. (call Matrix) rotate) (as angle Degrees) center))
  )
)

(fn-expr _ canvas-effects-rainbow (list GradientStop)
  (item (call GradientStop 0%% (call RGBA "#ef4444")))
  (item (call GradientStop 0.17%% (call RGBA "#f59e0b")))
  (item (call GradientStop 0.33%% (call RGBA "#84cc16")))
  (item (call GradientStop 0.5%% (call RGBA "#06b6d4")))
  (item (call GradientStop 0.67%% (call RGBA "#6366f1")))
  (item (call GradientStop 0.83%% (call RGBA "#d946ef")))
  (item (call GradientStop 1%% (call RGBA "#ef4444")))
)

(fn-do + canvas-effects-photo _
  (return-if (!! canvas-effects-photo-image) (if canvas-effects-photo-image))
  (let photo (call RasterCanvas 160 110 2 (call RGBA "#0f172a")))
  (call (. photo fill-gradient)
    (block
      (arg (call Rect 0 0 160 110))
      (arg (call linear-gradient (call Point 0 0) (call Point 0 80) (call RGBA "#1e3a8a") (call RGBA "#fb923c")))
    )
  )
  (call (. photo fill-gradient)
    (block
      (arg (call Rect 0 0 160 110))
      (arg (call radial-gradient (call Point 112 56) 26 (call RGBA 1 0.95 0.7 1) (call RGBA 1 0.6 0.3 0)))
    )
  )
  (= (. photo fill-color) (call RGBA "#312e81"))
  (call (. photo begin))
  (call (. photo move) 0 84)
  (call (. photo line) 34 50)
  (call (. photo line) 58 70)
  (call (. photo line) 92 36)
  (call (. photo line) 132 74)
  (call (. photo line) 160 60)
  (call (. photo line) 160 110)
  (call (. photo line) 0 110)
  (call (. photo end) true)
  (= (. photo fill-color) (call RGBA "#0f766e"))
  (call (. photo begin))
  (call (. photo move) 0 96)
  (call (. photo curve) 40 80 90 104 160 88)
  (call (. photo line) 160 110)
  (call (. photo line) 0 110)
  (call (. photo end) true)
  (= canvas-effects-photo-image photo)
  (return photo)
)

(fn-do + canvas-effects-badge _
  (return-if (!! canvas-effects-badge-image) (if canvas-effects-badge-image))
  (let badge (call RasterCanvas 96 96 2 transparent))
  (= (. badge fill-color) null)
  (= (. badge stroke-color) (call RGBA 0 0 0 1))
  (= (. badge stroke-width) 8)
  (call (. badge oval) (call Rect 6 6 84 84))
  (= (. badge stroke-color) null)
  (= (. badge fill-color) (call RGBA 0 0 0 1))
  (call trace-effect-star badge (call Point 48 50) 30 13)
  (call (. badge end))
  (= canvas-effects-badge-image badge)
  (return badge)
)

(fn-do _ trace-effect-star _
  (param canvas Canvas)
  (param center Point)
  (param outer Length)
  (param inner Length)
  (call (. canvas begin))
  (for (in index (..< 0 10))
    (let radius (if-expr (== (% index 2) 0) outer inner))
    (let turn (as (- (* (as index F64) 36) 90) Degrees))
    (let x (+ (. center x) (* radius (call cos turn))))
    (let y (+ (. center y) (* radius (call sin turn))))
    (if (== index 0)
      (call (. canvas move) x y)
      (else
        (call (. canvas line) x y)
      )
    )
  )
  (call (. canvas enclose))
)

(fn-do _ trace-effect-heart _
  (param canvas Canvas)
  (param center Point)
  (param size Length)
  (let x (. center x))
  (let y (. center y))
  (call (. canvas begin))
  (call (. canvas move) x (+ y (* size 0.5)))
  (call (. canvas curve)
    (block
      (arg (- x (* size 0.15)))
      (arg (+ y (* size 0.35)))
      (arg (- x (* size 0.5)))
      (arg (+ y (* size 0.15)))
      (arg (- x (* size 0.5)))
      (arg (- y (* size 0.1)))
    )
  )
  (call (. canvas curve)
    (block
      (arg (- x (* size 0.5)))
      (arg (- y (* size 0.45)))
      (arg (- x (* size 0.05)))
      (arg (- y (* size 0.5)))
      (arg x)
      (arg (- y (* size 0.22)))
    )
  )
  (call (. canvas curve)
    (block
      (arg (+ x (* size 0.05)))
      (arg (- y (* size 0.5)))
      (arg (+ x (* size 0.5)))
      (arg (- y (* size 0.45)))
      (arg (+ x (* size 0.5)))
      (arg (- y (* size 0.1)))
    )
  )
  (call (. canvas curve)
    (block
      (arg (+ x (* size 0.5)))
      (arg (+ y (* size 0.15)))
      (arg (+ x (* size 0.15)))
      (arg (+ y (* size 0.35)))
      (arg x)
      (arg (+ y (* size 0.5)))
    )
  )
  (call (. canvas enclose))
)

(fn-do _ paint-effect-gradients _
  (param canvas Canvas)
  (let sunset
    (block
      (item (call GradientStop 0%% (call RGBA "#f97316")))
      (item (call GradientStop 0.5%% (call RGBA "#ec4899")))
      (item (call GradientStop 1%% (call RGBA "#6366f1")))
    )
  )
  (let card (call Rect 14 16 116 66))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) (call Outline card 16))
    (call (. canvas fill-gradient) card (call LinearGradient (. card top-left) (. card bottom-right) sunset))
  )
  (let ball (call Rect 144 14 66 66))
  (let gold
    (block
      (item (call GradientStop 0%% (call RGBA "#fef9c3")))
      (item (call GradientStop 0.35%% (call RGBA "#facc15")))
      (item (call GradientStop 1%% (call RGBA "#854d0e")))
    )
  )
  (do-use (. canvas saved-state)
    (call (. canvas begin))
    (call (. canvas outline-path) (call Outline ball 33))
    (call (. canvas clip-path))
    (call (. canvas fill-gradient)
      (block
        (arg ball)
        (arg (call RadialGradient (call Point (+ (. ball x) 22) (+ (. ball y) 20)) 2 (. ball center) 44 gold))
      )
    )
  )
  (let wheel (call Rect 18 92 68 68))
  (do-use (. canvas saved-state)
    (call (. canvas begin))
    (call (. canvas outline-path) (call Outline wheel 34))
    (call (. canvas clip-path))
    (call (. canvas fill-gradient)
      (block
        (arg wheel)
        (arg (call ConicGradient (. wheel center) -90° (call canvas-effects-rainbow)))
      )
    )
  )
  (let bar (call Rect 102 106 108 40))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) (call Outline bar 20))
    (call (. canvas fill-gradient)
      (block
        (arg bar)
        (arg
          (call linear-gradient
            (block
              (arg (. bar left-center))
              (arg (. bar right-center))
              (arg (call RGBA 0.05 0.65 0.9 0.15))
              (arg (call RGBA 0.05 0.65 0.9 1))
            )
          )
        )
      )
    )
  )
)

(fn-do _ paint-effect-shadows _
  (param canvas Canvas)
  (param blur F64)
  (let card (call Outline (call Rect 16 20 92 62) 14))
  (call (. canvas begin))
  (call (. canvas outline-path) card)
  (call (. canvas shadow-path) (call Shadow (call RGBA 0.06 0.09 0.16 0.35) blur 0 6))
  (= (. canvas fill-color) white)
  (call (. canvas outline) card)
  (call trace-effect-star canvas (call Point 162 54) 40 17)
  (call (. canvas shadow-path) (call Shadow (call RGBA 0.4 0.1 0.5 0.45) blur 4 8))
  (= (. canvas fill-color) (call RGBA "#f59e0b"))
  (call trace-effect-star canvas (call Point 162 54) 40 17)
  (call (. canvas end))
  (call trace-effect-heart canvas (call Point 70 128) 54)
  (call (. canvas shadow-path) (call Shadow (call RGBA 0.95 0.2 0.35 0.9) blur 0 0))
  (= (. canvas fill-color) (call RGBA "#f43f5e"))
  (call trace-effect-heart canvas (call Point 70 128) 54)
  (call (. canvas end))
)

(fn-do _ paint-effect-blend _
  (param canvas Canvas)
  (param mode BlendMode)
  (call (. canvas draw-image) (call canvas-effects-photo) (call Rect 10 10 200 120))
  (call (. canvas fill-gradient)
    (block
      (arg (call Rect 10 132 200 28))
      (arg (call linear-gradient (call Point 10 0) (call Point 210 0) (call RGBA 0 0 0 1) (call RGBA 1 1 1 1)))
    )
  )
  (do-use (. canvas saved-state)
    (= (. canvas blend-mode) mode)
    (= (. canvas fill-color) (call RGBA "#ef4444"))
    (call (. canvas oval) (call Rect 44 22 76 76))
    (= (. canvas fill-color) (call RGBA "#22c55e"))
    (call (. canvas oval) (call Rect 100 22 76 76))
    (= (. canvas fill-color) (call RGBA "#3b82f6"))
    (call (. canvas oval) (call Rect 72 70 76 76))
  )
)

(fn-do _ paint-effect-masks _
  (param canvas Canvas)
  (let left (call Rect 8 26 106 118))
  (do-use (. canvas saved-state)
    (call (. canvas begin-mask))
    (call (. canvas fill-gradient) left (call radial-gradient (. left center) 58 (call RGBA 0 0 0 1) (call RGBA 0 0 0 0)))
    (call (. canvas end-mask))
    (call (. canvas draw-image) (call canvas-effects-photo) left)
  )
  (let right (call Rect 118 36 96 96))
  (do-use (. canvas saved-state)
    (call (. canvas clip-mask) (call canvas-effects-badge) right)
    (call (. canvas fill-gradient) right (call ConicGradient (. right center) 0rad (call canvas-effects-rainbow)))
  )
)

(fn-do _ paint-effect-clips _
  (param canvas Canvas)
  (let bubble (call Outline (call Rect 10 16 104 84) 18 (call OutlineArrow (. Side bottom) 28 16)))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) bubble)
    (= (. canvas fill-color) (call RGBA "#fde68a"))
    (call (. canvas rect) (call Rect 0 0 130 130))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (call RGBA "#f97316"))
    (= (. canvas stroke-width) 6)
    (for (in index (..< 0 12))
      (let x (- (* (as index F64) 16) 60))
      (call (. canvas line) x 0 (+ x 90) 130)
    )
  )
  (do-use (. canvas saved-state)
    (call (. canvas begin))
    (call (. canvas outline-path) (call Outline (call Rect 122 32 90 90) 45))
    (call (. canvas outline-path) (call Outline (call Rect 148 58 38 38) 19))
    (call (. canvas clip-path) (. FillRule even-odd))
    (call (. canvas draw-image) (call canvas-effects-photo) (call Rect 104 26 140 100))
  )
)

(fn-do _ paint-effect-images _
  (param canvas Canvas)
  (let photo (call canvas-effects-photo))
  (let badge (call canvas-effects-badge))
  (do-use (. canvas saved-state)
    (call (. canvas transform) (call (. (call Matrix) rotate) -0.16rad (call Point 72 82)))
    (let frame (call Outline (call Rect 16 22 112 112) 4))
    (call (. canvas begin))
    (call (. canvas outline-path) frame)
    (call (. canvas shadow-path) (call Shadow (call RGBA 0 0 0 0.3) 6 0 4))
    (= (. canvas fill-color) white)
    (call (. canvas outline) frame)
    (call (. canvas draw-image) photo (call Rect 24 30 96 66))
  )
  (= (. canvas fill-color) (call RGBA "#0ea5e9"))
  (call (. canvas draw-image) badge (call Rect 152 18 48 48) true)
  (= (. canvas fill-color) (call RGBA "#a855f7"))
  (call (. canvas draw-image) badge (call Rect 140 80 74 74) true)
)

(fn-do _ paint-effect-strokes _
  (param canvas Canvas)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) (call RGBA "#0f172a"))
  (= (. canvas stroke-width) 10)
  (for (in index (..< 0 3))
    (let y (+ 22 (* (as index F64) 20)))
    (= (. canvas stroke-cap)
      (match index
        (case= 0
          (. LineCap butt)
        )
        (case= 1
          (. LineCap round)
        )
        (default
          (. LineCap square)
        )
      )
    )
    (call (. canvas line) 22 y 92 y)
  )
  (= (. canvas stroke-cap) (. LineCap butt))
  (= (. canvas stroke-width) 8)
  (= (. canvas stroke-color) (call RGBA "#0d9488"))
  (for (in index (..< 0 3))
    (let x (+ 118 (* (as index F64) 32)))
    (= (. canvas stroke-join)
      (match index
        (case= 0
          (. LineJoin miter)
        )
        (case= 1
          (. LineJoin round)
        )
        (default
          (. LineJoin bevel)
        )
      )
    )
    (call (. canvas begin))
    (call (. canvas move) x 66)
    (call (. canvas line) (+ x 12) 18)
    (call (. canvas line) (+ x 24) 66)
    (call (. canvas end))
  )
  (= (. canvas stroke-join) (. LineJoin miter))
  (= (. canvas stroke-color) (call RGBA "#6366f1"))
  (= (. canvas stroke-width) 3)
  (= (. canvas stroke-cap) (. LineCap round))
  (= (. canvas stroke-dash) 7)
  (call (. canvas curve) 16 150 50 80 110 170 150 96)
  (= (. canvas stroke-dash) 0)
  (= (. canvas stroke-color) (call RGBA "#475569"))
  (= (. canvas stroke-width) 0.5)
  (for (in index (..< 0 9))
    (let x (+ 160 (* (as index F64) 6)))
    (call (. canvas line) 186 160 x 104)
  )
)

(fn-do _ paint-effect-groups _
  (param canvas Canvas)
  (param mode BlendMode)
  (param blur F64)
  (for (in index (..< 0 11))
    (= (. canvas fill-color) (if-expr (== (% index 2) 0) (call RGBA "#e2e8f0") (call RGBA "#94a3b8")))
    (call (. canvas rect) (call Rect (* (as index F64) 20) 0 20 170))
  )
  (call (. canvas begin-opacity) 0.6)
  (call (. canvas begin-blur) blur)
  (= (. canvas fill-color) (call RGBA "#2563eb"))
  (call (. canvas oval) (call Rect 10 30 66 66))
  (= (. canvas fill-color) (call RGBA "#f97316"))
  (call (. canvas oval) (call Rect 40 66 66 66))
  (call (. canvas end-blur))
  (call (. canvas end-opacity))
  (do-use (. canvas saved-state)
    (= (. canvas blend-mode) mode)
    (call (. canvas begin-opacity) 0.9)
    (= (. canvas fill-color) (call RGBA "#2563eb"))
    (call (. canvas oval) (call Rect 116 30 66 66))
    (= (. canvas fill-color) (call RGBA "#f97316"))
    (call (. canvas oval) (call Rect 146 66 66 66))
    (call (. canvas end-opacity))
  )
)

(fn-do _ paint-effect-shaders _
  (param canvas Canvas)
  (param mode BlendMode)
  (param time F64)
  (let shaders (call canvas-effects-shaders))
  (let plasma (call Rect 14 14 132 142))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) (call Outline plasma 18))
    (call (. canvas fill-shader) plasma ([] shaders 0) (list time))
  )
  (call (. canvas fill-shader) (call Rect 160 14 142 142) ([] shaders 1) (list time 26))
  (let photo (call Rect 316 14 126 142))
  (do-use (. canvas saved-state)
    (call (. canvas clip-outline) (call Outline photo 12))
    (call (. canvas draw-image) (call canvas-effects-photo) photo)
    (= (. canvas blend-mode) mode)
    (call (. canvas fill-shader) photo ([] shaders 2) (list time))
  )
)

(fn-do + canvas-effects-shaders _
  (if (not canvas-effects-shader-list)
    (= canvas-effects-shader-list
      (block
        (item (call Shader (call canvas-effects-plasma-source)))
        (item (call Shader (call canvas-effects-ripple-source)))
        (item (call Shader (call canvas-effects-band-source)))
      )
    )
  )
  (return canvas-effects-shader-list)
)

(fn-expr _ canvas-effects-plasma-source _
  (call (. "\n" join)
    (block
      (item "float4 shade(float2 position, float2 size, ShaderArgs args) {")
      (item "    float2 uv = position / size;")
      (item "    float t = args[0];")
      (item "    float v = sin(uv.x * 10.0 + t) + sin((uv.y * 8.0 - t) * 1.3)")
      (item "        + sin((uv.x + uv.y) * 7.0 + t * 0.7);")
      (item "    float2 c = uv - 0.5 + 0.35 * float2(sin(t * 0.5), cos(t * 0.3));")
      (item "    v += sin(sqrt(dot(c, c) * 160.0) - t * 2.0);")
      (item "    return float4(0.5 + 0.5 * cos(float3(0.0, 2.1, 4.2) + v * 1.1), 1.0);")
      (item "}")
    )
  )
)

(fn-expr _ canvas-effects-ripple-source _
  (call (. "\n" join)
    (block
      (item "float4 shade(float2 position, float2 size, ShaderArgs args) {")
      (item "    float r = length(position - size * 0.5) / (0.5 * min(size.x, size.y));")
      (item "    float wave = 0.5 + 0.5 * sin(r * args[1] - args[0] * 4.0);")
      (item "    float fade = 1.0 - smoothstep(0.82, 1.0, r);")
      (item "    float3 color = mix(float3(0.05, 0.2, 0.55), float3(0.4, 0.9, 1.0), wave);")
      (item "    return float4(color, fade * (0.55 + 0.45 * wave));")
      (item "}")
    )
  )
)

(fn-expr _ canvas-effects-band-source _
  (call (. "\n" join)
    (block
      (item "float4 shade(float2 position, float2 size, ShaderArgs args) {")
      (item "    float2 uv = position / size;")
      (item "    float band = sin(uv.y * 24.0 + sin(uv.x * 6.0 + args[0]) * 3.0);")
      (item "    float glow = smoothstep(0.1, 1.0, band);")
      (item "    float3 color = 0.5 + 0.5 * cos(float3(0.0, 2.0, 4.0) + uv.x * 3.0 + args[0]);")
      (item "    return float4(color, 0.2 + 0.6 * glow);")
      (item "}")
    )
  )
)
