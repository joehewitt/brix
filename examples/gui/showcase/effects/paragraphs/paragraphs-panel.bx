(import ./paragraphs-atlas)
(import /graphics/text)
(import /gui)

(type + ParagraphsPanel (is Box)
  (using ParagraphsTheme)
  (prop + font-family-name String (= "Noto Sans"))
  (prop + status _ (= "width 360 · word · left · guides true"))
  (content
    (<> This (• flex-col)
      (<> Box (• h 116)
        (<> Label (• absolute) (• w 120) (• h 20)
          (= left (call (. PositionOffset coord) 24))
          (= top (call (. PositionOffset coord) 16))
          (= text "Paragraph text")
        )
        (blank)
        (<> TextInput (• absolute) (• w 490) (• h 28)
          (= left (call (. PositionOffset coord) 24))
          (= top (call (. PositionOffset coord) 40))
          (= text
            (call (. "" join)
              (block
                (bullet "Live paragraph text wraps through the production Label path: ")
                (bullet "é · 👩🏽‍💻 · 日本語.")
              )
            )
          )
          (for (on event input)
            (= (. atlas sample-text) (. event text))
            (call refresh-status)
          )
        )
        (blank)
        (<> Label (• absolute) (• w 150) (• h 20)
          (= left (call (. PositionOffset coord) 534))
          (= top (call (. PositionOffset coord) 16))
          (= text "Constraint width")
        )
        (blank)
        (<> Slider (• absolute) (• w 180) (• h 28)
          (= left (call (. PositionOffset coord) 534))
          (= top (call (. PositionOffset coord) 40))
          (= minimum 0)
          (= maximum 560)
          (= value 360)
          (for (on event value-changed)
            (= (. atlas sample-width) (. event value))
            (= (. atlas sample-bubble-width) (+ (. event value) 18))
            (call refresh-status)
          )
        )
        (blank)
        (<> ParagraphLabButton (text: "Wrap") (• absolute) (• w 90) (• h 32)
          (= left (call (. PositionOffset coord) 734))
          (= top (call (. PositionOffset coord) 36))
        )
        (blank)
        (<> ParagraphLabButton (text: "Align") (• absolute) (• w 90) (• h 32)
          (= left (call (. PositionOffset coord) 836))
          (= top (call (. PositionOffset coord) 36))
        )
        (blank)
        (<> ParagraphLabButton (text: "Sizing") (• absolute) (• w 90) (• h 32)
          (= left (call (. PositionOffset coord) 938))
          (= top (call (. PositionOffset coord) 36))
        )
        (blank)
        (<> ParagraphLabButton (text: "Guides") (• absolute) (• w 90) (• h 32)
          (= left (call (. PositionOffset coord) 1040))
          (= top (call (. PositionOffset coord) 36))
        )
        (blank)
        (<> Label (• absolute) (• w 700) (• h 28)
          (= left (call (. PositionOffset coord) 24))
          (= top (call (. PositionOffset coord) 78))
          (= text #status)
        )
      )
      (blank)
      (<> ParagraphLabViewport (• flex 1) (• ml 40)
        (<> ParagraphsAtlas (id: atlas) (• w 1200) (• h 1560)
          (= font-family-name #font-family-name)
        )
      )
    )
  )
  (fn-do + press _
    (param action String)
    (if (== action "Wrap")
      (if (== (. atlas sample-wrap) (. TextWrap no-wrap))
        (= (. atlas sample-wrap) (. TextWrap word))
        (else
          (= (. atlas sample-wrap) (. TextWrap no-wrap))
        )
      )
      (else-if (== action "Align")
        (= (. atlas sample-alignment)
          (match (. atlas sample-alignment)
            (case (. TextAlignment left)
              (. TextAlignment center)
            )
            (case (. TextAlignment center)
              (. TextAlignment right)
            )
            (case (. TextAlignment right)
              (. TextAlignment left)
            )
          )
        )
      )
      (else-if (== action "Sizing")
        (if (== (. atlas sample-wrap-sizing) (. TextWrapSizing available))
          (= (. atlas sample-wrap-sizing) (. TextWrapSizing tight))
          (else
            (= (. atlas sample-wrap-sizing) (. TextWrapSizing available))
          )
        )
      )
      (else-if (== action "Guides")
        (= (. atlas guides-visible) (not (. atlas guides-visible)))
      )
    )
    (call refresh-status)
  )
  (fn-do _ refresh-status _
    (= status (. atlas control-summary))
  )
)

(type + ParagraphLabViewport (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation vertical)))
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow auto))
    (= scroll-indicator-y (. ScrollIndicatorVisibility always))
    (= scroll-indicator-gutter (. ScrollIndicatorGutter stable))
  )
)

(type + ParagraphLabButton (is Box)
  (prop + action String)
  (blank)
  (rule This (• bg gui-field-color)
    (= focus-mode (. FocusMode press))
    (= border-color gui-border-color)
    (= border-width 2)
    (= font-weight (. FontWeight bold))
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
  )
  (fn-do + This _
    (param action _)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= text action)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. (call (of ancestor ParagraphsPanel)) press) action)
  )
)
