  )
  (fn-expr + control-summary String :get
    (call (. "" join)
      (block
        (item (str "width " sample-width " · " (call paragraph-lab-wrap-name sample-wrap) " · "))
        (item (str (call paragraph-lab-wrap-sizing-name sample-wrap-sizing) " · "))
        (item (str (call paragraph-lab-alignment-name sample-alignment) " · guides " guides-visible))
      )
    )
  )
  (fn-expr + manifest _
    (call (. "" join)
      (block
        (item "paragraphs-manifest v1\nrender-scales=1,2\n")
        (spread
          (block
            children
            (pipe ?*>
              (match? each
                (case (: label ParagraphLabSampleLabel)
                  (call paragraph-lab-manifest-line (. label sample-name) label)
                )
                (case (: bubble ParagraphLabBubble)
                  (call paragraph-lab-bubble-manifest-line bubble)
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + ParagraphLabSampleLabel (is Label)
  (prop + sample-name String (= "sample"))
)

(type + ParagraphLabControlledLabel (is ParagraphLabSampleLabel)
  (prop + controlled-width Length (= 360))
  (prop + controlled-wrap TextWrap (= (. TextWrap word)))
  (prop + controlled-alignment TextAlignment (= (. TextAlignment left)))
  (blank)
  (rule This (• paragraph-lab-sample)
    (= min-width (call (. SizeSpec coord) #controlled-width))
    (= max-width (call (. SizeSpec coord) #controlled-width))
    (= text-wrap #controlled-wrap)
    (= text-alignment #controlled-alignment)
  )
)

(type + ParagraphLabBubble (is Box)
  (prop + sample-name String (= "bubble"))
  (prop + text String (= ""))
  (prop + text-cap Length (= 300))
  (prop + bubble-cap Length (= 318))
  (prop + wrap-sizing TextWrapSizing (= (. TextWrapSizing tight)))
  (blank)
  (rule This
    (= layout (call FlowLayout (. Orientation horizontal)))
    (= max-width (call (. SizeSpec coord) #bubble-cap))
    (= background-color "#e0f2fe")
    (= border-color "#0284c7")
    (= border-width 1)
    (= padding-left 9)
    (= padding-right 9)
    (= padding-top 7)
    (= padding-bottom 7)
  )
  (content
    (<> This
      (<> ParagraphLabBubbleLabel (id: label)
        (= sample-name #sample-name)
        (= text #text)
        (= maximum-width #text-cap)
        (= requested-wrap-sizing #wrap-sizing)
      )
    )
  )
  (fn-do + measured-content-size Dimensions
    (param query MeasureQuery)
    (let ignored query)
    (let label (as (!! %first-child) ParagraphLabBubbleLabel))
    (return (. (call (. label measure) (call measure-fit-query text-cap)) outer-size))
  )
)

(type + ParagraphLabBubbleLabel (is ParagraphLabSampleLabel)
  (prop + maximum-width Length (= 300))
  (prop + requested-wrap-sizing TextWrapSizing (= (. TextWrapSizing tight)))
  (blank)
  (rule This
    (= max-width (call (. SizeSpec coord) #maximum-width))
    (= text-wrap (. TextWrap word))
    (= text-wrap-sizing #requested-wrap-sizing)
  )
)

(type + ParagraphLabGuides (is Box)
  (prop + guides-visible _ (= true))
  (blank)
  (depends invalidate-paint guides-visible)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (not guides-visible)))
    (call (. canvas push))
    (let guide-origin content-bounds)
    (call (. canvas translate) (. guide-origin x) (. guide-origin y))
    (let atlas (as (!! %parent) ParagraphsAtlas))
    (for (in child (. atlas children))
      (if (is child ParagraphLabSampleLabel)
        (call draw-paragraph-label-guides (as child ParagraphLabSampleLabel) guide-origin canvas)
        (else-if (is child ParagraphLabBubble)
          (call draw-paragraph-bubble-guides (as child ParagraphLabBubble) guide-origin canvas)
        )
      )
    )
    (call (. canvas pop))
  )
  (fn-do _ draw-paragraph-bubble-guides _
    (param bubble ParagraphLabBubble)
    (param guide-origin Rect)
    (param canvas Canvas)
    (let label (as (!! (. bubble %first-child)) ParagraphLabBubbleLabel))
    (call draw-paragraph-label-guides label guide-origin canvas)
    (let content (. label content-bounds))
    (let x (- (. content x) (. guide-origin x)))
    (let y (- (. content y) (. guide-origin y)))
    (let chosen-width (. content width))
    (let wasted (call max 0 (- (. bubble text-cap) chosen-width)))
    (call (. canvas push))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) 1)
    (= (. canvas stroke-color) "#0891b2")
    (call (. canvas rect) (call Rect x y (. bubble text-cap) (. content height)))
    (if (> wasted 0)
      (= (. canvas stroke-color) "#db2777")
      (call (. canvas line) (+ x chosen-width) (- y 3) (+ x (. bubble text-cap)) (- y 3))
    )
    (call (. canvas pop))
  )
  (fn-do _ draw-paragraph-label-guides _
    (param label Label)
    (param guide-origin Rect)
    (param canvas Canvas)
    (let snapshot (. label text-layout-snapshot))
    (return-if (if (not snapshot)))
    (let content (. label content-bounds))
    (let x (- (. content x) (. guide-origin x)))
    (let y (- (. content y) (. guide-origin y)))
    (let text-y (+ y (/ (- (. content height) (. snapshot size height)) 2)))
    (blank)
    (call (. canvas push))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) 1)
    (= (. canvas stroke-color) "#dc2626")
    (call (. canvas rect) (call Rect x y (. content width) (. content height)))
    (= (. canvas stroke-color) "#0891b2")
    (call (. canvas line) (+ x (. content width)) y (+ x (. content width)) (+ y (. content height)))
    (= (. canvas stroke-color) "#7c3aed")
    (call (. canvas line) (+ x (. snapshot natural-width)) y (+ x (. snapshot natural-width)) (+ y (. content height)))
    (for (in line (. snapshot lines))
      (let alignment-offset
        (call paragraph-lab-alignment-offset
          (block
            (arg (. label $text-alignment))
            (arg (. content width))
            (arg (. line typographic-bounds width))
          )
        )
      )
      (let text-x (+ x alignment-offset))
      (let typographic
        (call Rect
          (block
            (arg (+ text-x (. line typographic-bounds x)))
            (arg (+ text-y (. line typographic-bounds y)))
            (arg (. line typographic-bounds width))
            (arg (. line typographic-bounds height))
          )
        )
      )
      (let ink
        (call Rect
          (block
            (arg (+ text-x (. line ink-bounds x)))
            (arg (+ text-y (. line ink-bounds y)))
            (arg (. line ink-bounds width))
            (arg (. line ink-bounds height))
          )
        )
      )
      (= (. canvas stroke-color) "#2563eb")
      (call (. canvas line) x (+ text-y (. line baseline)) (+ x (. content width)) (+ text-y (. line baseline)))
      (= (. canvas stroke-color) "#16a34a")
      (call (. canvas rect) typographic)
      (= (. canvas stroke-color) "#ea580c")
      (call (. canvas rect) ink)
    )
    (call (. canvas pop))
  )
)

(fn-expr _ paragraph-lab-alignment-offset Length
  (param alignment TextAlignment)
  (param available Length)
  (param occupied Length)
  (match alignment
    (case (. TextAlignment left)
      0
    )
    (case (. TextAlignment center)
      (/ (- available occupied) 2)
    )
    (case (. TextAlignment right)
      (- available occupied)
    )
  )
)

(fn-expr _ paragraph-lab-manifest-line String
  (param name String)
  (param label Label)
  (case? (not (. label text-layout-snapshot))
    (str name "=unpainted\n")
  )
  (default
    (str name "=" (. snapshot normalized) "\n")
  )
  (where
    (lazy snapshot (!! (. label text-layout-snapshot)))
  )
)

(fn-expr _ paragraph-lab-bubble-manifest-line String
  (param bubble ParagraphLabBubble)
  (case? (not (. label text-layout-snapshot))
    (str (. bubble sample-name) "=unpainted\n")
  )
  (default
    (call (. "" join)
      (block
        (item (str (. bubble sample-name) "=A:" (. bubble text-cap) ",W:" chosen-width ",wasted:" wasted ","))
        (item (str "sizing:" (call paragraph-lab-wrap-sizing-name (. label $text-wrap-sizing)) ","))
        (item (str (. snapshot normalized) "\n"))
      )
    )
  )
  (where
    (lazy label (as (!! (. bubble %first-child)) ParagraphLabBubbleLabel))
    (lazy snapshot (!! (. label text-layout-snapshot)))
    (lazy chosen-width (. label content-bounds width))
    (lazy wasted (call max 0 (- (. bubble text-cap) chosen-width)))
  )
)

(fn-expr + paragraph-lab-wrap-name String
  (param wrap TextWrap)
  (match wrap
    (case (. TextWrap no-wrap)
      "no-wrap"
    )
    (case (. TextWrap word)
      "word"
    )
  )
)

(fn-expr + paragraph-lab-wrap-sizing-name String
  (param sizing TextWrapSizing)
  (match sizing
    (case (. TextWrapSizing available)
      "available"
    )
    (case (. TextWrapSizing tight)
      "tight"
    )
  )
)

(fn-expr + paragraph-lab-alignment-name String
  (param alignment TextAlignment)
  (match alignment
    (case (. TextAlignment left)
      "left"
    )
    (case (. TextAlignment center)
      "center"
    )
    (case (. TextAlignment right)
      "right"
    )
  )
)
