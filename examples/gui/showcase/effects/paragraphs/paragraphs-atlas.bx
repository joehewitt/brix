(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)

(style ParagraphsTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (rule paragraph-lab-atlas
    (= background-color "#f8fafc")
    (= color "#0f172a")
    (= font-size 13)
  )
  (blank)
  (rule paragraph-lab-title
    (= color "#172554")
    (= font-size 23)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule paragraph-lab-caption
    (= color "#475569")
    (= font-size 11)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule paragraph-lab-sample
    (= background-color "#ffffff")
    (= border-color "#cbd5e1")
    (= border-width 1)
    (= padding-left 9)
    (= padding-right 9)
    (= padding-top 7)
    (= padding-bottom 7)
    (= text-overflow (. TextOverflow clip))
  )
)

(type + ParagraphsAtlas (is Box)
  (implements MarkupRootElement)
  (using ParagraphsTheme)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + font-family-name String (= "Noto Sans"))
