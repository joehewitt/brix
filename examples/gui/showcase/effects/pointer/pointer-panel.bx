(import /graphics/color)
(import /graphics/text)
(import /gui)

(style PointerTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (rule overflow-host (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 3)
  )
  (blank)
  (rule trace-panel (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 2)
    (= font-size 15)
  )
  (blank)
  (rule cursor-sample (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 2)
    (= corner-radius 10)
    (= font-size 12)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule cursor-sample-label
    (= corner-radius 8)
    (blank)
    (when-style #is-hovered
      (• bg gui-hover-color)
    )
  )
)

(type + PointerPanel (is Box)
  (using PointerTheme)
  (prop + trace _ (= "Press, drag outside a tile, release, click, scroll, or select a cursor sample."))
  (prop + count _ (= "Primary clicks: 0"))
  (prop + total-clicks Size (= 0))
  (blank)
  (rule This (• w 1020) (• h 700))
  (content
    (<> This
      (<> Label (• absolute) (• w 920) (• h 32)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 28))
        (= text "Canvas Boxes · routed events · cursor styles")
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 300) (• h 24)
        (= left (call (. PositionOffset coord) 70))
        (= top (call (. PositionOffset coord) 82))
        (= text "Overlapping routed targets")
      )
      (blank)
      (<> ShowcaseTile (text: "blue") (• absolute) (• w 220) (• h 170)
        (= left (call (. PositionOffset coord) 70))
        (= top (call (. PositionOffset coord) 116))
      )
      (blank)
      ; Painted later, this tile wins inside the overlap.
      (<> ShowcaseTile (text: "violet") (• absolute) (• w 220) (• h 170)
        (= left (call (. PositionOffset coord) 210))
        (= top (call (. PositionOffset coord) 176))
      )
      (blank)
      (<> Label (• absolute) (• w 260) (• h 24)
        (= left (call (. PositionOffset coord) 620))
        (= top (call (. PositionOffset coord) 82))
        (= text "Visible overflow remains interactive")
      )
      (blank)
      (<> Box (• overflow-host) (• absolute) (• w 120) (• h 150)
        (= left (call (. PositionOffset coord) 610))
        (= top (call (. PositionOffset coord) 116))
        (blank)
        (<> ShowcaseTile (text: "overflow") (• absolute) (• w 210) (• h 100)
          (= left (call (. PositionOffset coord) 72))
          (= top (call (. PositionOffset coord) 24))
        )
      )
      (blank)
      (<> Label (• absolute) (• w 920) (• h 28)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 370))
        (= text #count)
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 900) (• h 24) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 60))
        (= top (call (. PositionOffset coord) 410))
        (= text "Move across each nested label to see its inherited CursorStyle")
        (= font-size 13)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 60))
        (= top (call (. PositionOffset coord) 446))
        (= name "Automatic")
        (= role (. CursorStyle automatic))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 210))
        (= top (call (. PositionOffset coord) 446))
        (= name "Arrow")
        (= role (. CursorStyle arrow))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 360))
        (= top (call (. PositionOffset coord) 446))
        (= name "Pointing hand")
        (= role (. CursorStyle pointing-hand))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 510))
        (= top (call (. PositionOffset coord) 446))
        (= name "Text")
        (= role (. CursorStyle text))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 660))
        (= top (call (. PositionOffset coord) 446))
        (= name "Crosshair")
        (= role (. CursorStyle crosshair))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 810))
        (= top (call (. PositionOffset coord) 446))
        (= name "Move")
        (= role (. CursorStyle move))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 60))
        (= top (call (. PositionOffset coord) 506))
        (= name "Open hand")
        (= role (. CursorStyle open-hand))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 210))
        (= top (call (. PositionOffset coord) 506))
        (= name "Closed hand")
        (= role (. CursorStyle closed-hand))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 360))
        (= top (call (. PositionOffset coord) 506))
        (= name "Not allowed")
        (= role (. CursorStyle not-allowed))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 510))
        (= top (call (. PositionOffset coord) 506))
        (= name "Horizontal resize")
        (= role (. CursorStyle resize-horizontal))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 660))
        (= top (call (. PositionOffset coord) 506))
        (= name "Vertical resize")
        (= role (. CursorStyle resize-vertical))
      )
      (blank)
      (<> CursorStyleSample (• absolute) (• w 140) (• h 50)
        (= left (call (. PositionOffset coord) 810))
        (= top (call (. PositionOffset coord) 506))
        (= name "Hidden")
        (= role (. CursorStyle hidden))
      )
      (blank)
      (<> Label (• trace-panel) (• absolute) (• w 920) (• h 76)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 590))
        (= text #trace)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (fn-do + show-trace _
    (param text String)
    (= trace text)
  )
  (fn-do + count-click _
    (param name String)
    (param native-count String)
    (+= total-clicks 1)
    (= count (str "Primary clicks: " total-clicks " · " name " · native count: " native-count))
  )
)

(type + ShowcaseTile (is Box)
  (prop + name String)
  (blank)
  (rule This
    (= background-color "#3b82f6")
    (= border-color "#1e3a8a")
    (= border-width 5)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-hovered
      (= background-color "#22c55e")
      (= border-color "#14532d")
      (= border-width 8)
    )
    (blank)
    (when-style #is-pressed
      (= background-color "#f97316")
      (= border-color "#7c2d12")
      (= border-width 12)
      (= cursor (. CursorStyle closed-hand))
    )
  )
  (fn-do + This _
    (param name _)
  )
  (subscribe-for (on event pointer-down)
    (call pointer-trace this "down" name event)
  )
  (subscribe-for (on event pointer-drag)
    (call pointer-trace this "captured drag" name event)
  )
  (subscribe-for (on event pointer-up)
    (call pointer-trace this "up" name event)
  )
  (subscribe-for (on event scroll)
    (call (?. (call (of ancestor PointerPanel)) show-trace)
      (block
        (arg (str "scroll " name " · (" (. event delta-x) ", " (. event delta-y) ") · no default"))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. (call (of ancestor PointerPanel)) count-click) name (str (. event click-count)))
    (call pointer-trace this "click" name event)
  )
)

(fn-do + pointer-trace _
  (param box Box)
  (param action String)
  (param name String)
  (param event GUIEvent)
  (let local (. event point))
  (let root (. event root-point))
  (call (?. (call (of (. box ancestor) PointerPanel)) show-trace)
    (block
      (arg (str action " " name " · local (" (. local x) ", " (. local y) ") · root (" (. root x) ", " (. root y) ")"))
    )
  )
)

(type + CursorStyleSample (is Box)
  (prop + name String (= ""))
  (prop + role _ (= (. CursorStyle automatic)))
  (blank)
  (rule This (• cursor-sample)
    (= cursor #role)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• cursor-sample-label) (• flex 1)
        (= text #name)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. (call (of ancestor PointerPanel)) show-trace) (str "Cursor sample · " name " · inherited by the nested Label"))
  )
)
