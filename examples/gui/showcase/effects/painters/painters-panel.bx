(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/border)
(import /gui/painter)

(type + PaintersPanel (is Box)
  (rule This (• w 980) (• h 540))
  (content
    (<> This
      (<> Label (• absolute) (• w 900) (• h 34)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 28))
        (= text "Background & border painters")
        (= font-size 25)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 900) (• h 24) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 68))
        (= text "Painters receive the Box and its full bounds; border painters also define layout insets.")
        (= font-size 14)
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> PainterCard (• absolute) (• w 280) (• h 350)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 124))
        (= heading "Built-in painters")
        (= detail "Solid background, uniform border, and rounded clipping come from the default painters.")
      )
      (blank)
      (<> PainterCard (• absolute) (• w 280) (• h 350)
        (= left (call (. PositionOffset coord) 350))
        (= top (call (. PositionOffset coord) 124))
        (= heading "Custom background")
        (= detail "A Painter can draw any canvas content while the Box keeps ownership of clipping.")
        (= background-painter (call PatternBackgroundPainter))
      )
      (blank)
      (<> PainterCard (• absolute) (• w 280) (• h 350)
        (= left (call (. PositionOffset coord) 660))
        (= top (call (. PositionOffset coord) 124))
        (= heading "Custom border")
        (= detail "A BorderPainter supplies asymmetric insets and paints each edge independently.")
        (= background-painter (call PatternBackgroundPainter))
        (= border-painter (call AccentBorderPainter))
      )
    )
  )
)

(type + PainterCard (is Box)
  (prop + heading String (= ""))
  (prop + detail String (= ""))
  (prop + background-painter (? Painter))
  (prop + border-painter BorderPainter (= (call DefaultBorderPainter)))
  (blank)
  (rule This
    (= background #background-painter)
    (= border #border-painter)
    (= background-color "#0f172a")
    (= border-color "#6366f1")
    (= border-width 6)
    (= corner-radius 28)
    (= padding-left 24)
    (= padding-top 28)
    (= padding-right 24)
    (= padding-bottom 24)
    (= gap 18)
    (= color white)
  )
  (content
    (<> This (• flex-col)
      (<> Label (• w 210) (• h 34)
        (= text #heading)
        (= font-size 18)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• w 210) (• h 106)
        (= text #detail)
        (= color "#e2e8f0")
        (= font-size 14)
        (= text-wrap (. TextWrap word))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> PainterSwatch (• w 210) (• h 92))
    )
  )
)

(type + PainterSwatch (is Box)
  (rule This
    (= background-color "#f8fafc")
    (= border-color "#cbd5e1")
    (= border-width 2)
    (= corner-radius 18)
  )
  (content
    (<> This
      (<> Box (• absolute) (• w 64) (• h 64) (• bg "#22c55e")
        (= left (call (. PositionOffset coord) 24))
        (= top (call (. PositionOffset coord) 14))
        (= corner-radius 32)
      )
      (blank)
      (<> Box (• absolute) (• w 88) (• h 48) (• bg "#f59e0b")
        (= left (call (. PositionOffset coord) 98))
        (= top (call (. PositionOffset coord) 22))
        (= corner-radius 16)
      )
    )
  )
)

(type + PatternBackgroundPainter (is Painter)
  ; ╌╌╌╌╌╌╌╌╌╌ is Painter ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (= (. canvas fill-color) (. node $background-color))
    (= (. canvas stroke-color) null)
    (call (. canvas rect) rect)
    (= (. canvas fill-color) (call RGBA "#312e81"))
    (call (. canvas circle) (+ (. rect x) 36) (+ (. rect y) 38) 92)
    (= (. canvas fill-color) (call RGBA "#0e7490"))
    (call (. canvas circle) (- (. rect right) 24) (+ (. rect y) 130) 116)
    (= (. canvas fill-color) (call RGBA "#7c3aed"))
    (call (. canvas rect) (call Rect (+ (. rect x) 34) (- (. rect bottom) 94) (- (. rect width) 68) 56))
  )
)

(type + AccentBorderPainter (is BorderPainter)
  ; ╌╌╌╌╌╌╌╌╌╌ is BorderPainter ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + border-insets _
    (param node Box)
    (call Insets 8 16 12 6)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (let edges (. node border-edges))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (. node $border-color))
    (call (. canvas rect) (call Rect (. rect x) (. rect y) (. rect width) (. edges top)))
    (= (. canvas fill-color) (call RGBA "#f97316"))
    (call (. canvas rect) (call Rect (- (. rect right) (. edges right)) (. rect y) (. edges right) (. rect height)))
    (= (. canvas fill-color) (call RGBA "#22c55e"))
    (call (. canvas rect) (call Rect (. rect x) (- (. rect bottom) (. edges bottom)) (. rect width) (. edges bottom)))
    (= (. canvas fill-color) (call RGBA "#38bdf8"))
    (call (. canvas rect) (call Rect (. rect x) (. rect y) (. edges left) (. rect height)))
  )
)
