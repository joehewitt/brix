(import /graphics/image)
(import /graphics/text)
(import /gui)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop + pasted-max-pixel-size I32 (= 640))

(style ClipboardTheme
  (using GUIDefaultTheme)
  (rule gallery-panel (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule panel-title
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule panel-note (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule paste-well (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
    (= overflow-x (. ScrollOverflow auto))
    (blank)
    (when-style #is-focused
      (= border-color gui-accent-bright-color)
    )
    (blank)
    (when-style #is-armed
      (• bg gui-hover-color)
      (= border-color gui-accent-bright-color)
    )
  )
  (blank)
  (rule paste-hint (• text gui-muted-text-color)
    (= font-size 14)
  )
  (blank)
  (rule pasted-tile (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 6)
    (blank)
    (when-style #is-selected
      (= border-color gui-accent-bright-color)
      (= border-width 2)
    )
  )
  (blank)
  (rule pasted-caption (• text gui-muted-text-color)
    (= font-size 11)
  )
)

(type + PastedImage (is Tuple)
  (prop + id Size)
  (prop + image Image)
  (prop + source ClipboardItem)
  (prop + caption String)
)

(type + ClipboardPanel (is Box)
  (using ClipboardTheme)
  (prop + pasted (list PastedImage))
  (prop + selected (? Size))
  (prop + status _ (= "Nothing pasted yet"))
  (prop + inspected (list String))
  (prop _ next-id Size (= 0))
  (content
    (<> This (• flex-row) (• p 16)
      (<> Box (• gallery-panel) (• flex-col) (• flex 1) (• p 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Paste and drop images")
        )
        (<> Label (• panel-note) (• h 34)
          (= text
            (call (. "" join)
              (block
                (item "Copy an image or an image file, click the well and press ⌘V, or drag images onto it ")
                (item "from Finder, Photos or a browser. Select a picture and press ⌘C to copy it or ⌘X to cut it.")
              )
            )
          )
          (= text-wrap (. TextWrap word))
        )
        (<> PasteWell (id: well) (• paste-well) (• flex-row) (• flex 1) (• mt 6) (• p 10)
          (if (== (. #pasted length) 0)
            (<> Label (• paste-hint) (• flex 1)
              (= text "Click here and press ⌘V, or drop images here")
              (= align-x (. Alignment center))
            )
          )
          (for (in item #pasted (keyed-by (. item id)))
            (<> PastedTile (• pasted-tile) (• flex-col) (• w 180) (• h 170) (• mr 10) (• p 6)
              (= item item)
              (= is-selected (== #selected (. item id)))
              (blank)
              (for (on event pointer-down)
                (= selected (. item id))
              )
            )
          )
        )
        (<> Label (• panel-note) (• h 18) (• mt 8)
          (= text #status)
        )
      )
      (blank)
      (<> Box (• gallery-panel) (• flex-col) (• w 340) (• p 12) (• ml 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Last clipboard")
        )
        (<> Label (• panel-note) (• h 18)
          (= text "Each item on the pasteboard and the types it offers")
        )
        (<> Box (• flex-col) (• flex 1) (• mt 6)
          (for (in line #inspected)
            (<> Label (• panel-note) (• h 18)
              (= text line)
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. well paste))
    (let clipboard (. event clipboard))
    (= inspected (call clipboard-lines clipboard))
    (let entries (. clipboard images))
    (if (. entries length)
      (call (. event cancel))
      (= status (str "Reading " (. entries length) " image(s)…"))
      (do-new
        (inline (call add-images entries (call (of List Path)) "Pasted"))
      )
      (else
        (let text (call (. clipboard read-text)))
        (= status (if-expr text (str "The clipboard holds text, not an image: “" text "”") "The clipboard holds no image"))
      )
    )
  )
  (subscribe-for (on event (. well copy))
    (let item selected-item)
    (if (and item (call (. event clipboard write) (list (. item source))))
      (= status (str "Copied " (. item caption)))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event (. well cut))
    (let item selected-item)
    (if (and item (call (. event clipboard write) (list (. item source))))
      (call remove (. item id))
      (= status (str "Cut " (. item caption)))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event (. well drag-over))
    (if (call takes-drop (. event payload))
      (= (. well is-armed) true)
      (call (. event accept))
    )
  )
  (subscribe-for (on event (. well drag-leave))
    (= (. well is-armed) false)
  )
  (subscribe-for (on event (. well drop))
    (= (. well is-armed) false)
    (let drag (as (. event payload) ClipboardDrag))
    (= inspected (call clipboard-lines (. drag clipboard)))
    (= status "Reading dropped images…")
    (do-new
      (inline (call drop-images drag))
    )
  )
  (fn-expr + selected-item (? PastedImage) :get
    (call first (in each pasted (when (== (. each id) selected))))
  )
  (fn-do _ drop-images _
    (param drag ClipboardDrag)
    (let items (. drag clipboard items))
    (let entries (call dropped-entries items))
    (let promised (call some items (:where (. each is-promised-image))))
    (let files (if-expr promised (call (. drag receive-promised-files)) (call (of List Path))))
    (call add-images entries files "Dropped")
  )
  (fn-do _ add-images _
    (param entries (list ClipboardEntry))
    (param files (list Path))
    (param verb String)
    (let existing (. pasted length))
    (for (in entry entries)
      (call add (catch? (call read-pasted-image entry next-id)))
    )
    (for (in file files)
      (call add (catch? (call read-pasted-file file next-id)))
    )
    (= status (str verb " " (- (. pasted length) existing) " of " (+ (. entries length) (. files length)) " image(s)"))
  )
  (fn-do _ add _
    (param item (? PastedImage))
    (return-if (if (not item)))
    (+= next-id 1)
    (+= pasted item)
    (= selected (. item id))
  )
  (fn-do _ remove _
    (param id Size)
    (let item (call first (in each pasted (when (== (. each id) id)))))
    (return-if (if (not item)))
    (= pasted (call pasted-without pasted id))
    (call (. item image release))
    (= selected null)
  )
)

(type + PasteWell (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + is-armed _ (= false))
  (subscribe-for (on event pointer-down)
    (call request-focus)
  )
)

(type + PastedTile (is Box)
  (prop + item PastedImage)
  (prop + is-selected _ (= false))
  (content
    (<> This
      (<> ImageView (• flex 1)
        (= image (. item image))
      )
      (<> Label (• pasted-caption) (• h 16) (• mt 4)
        (= text (. item caption))
      )
    )
  )
)

(fn-do _ read-pasted-image PastedImage (?! IOError)
  (param entry ClipboardEntry)
  (param id Size)
  (let file (. entry path))
  (return-if (call read-pasted-file file id) (if file))
  (let type (?? (call (. entry conforming-type) clipboard-image-type) ""))
  (let bytes (call (. entry read-data) type))
  (throw (call IOError (str "The pasteboard item has no " type " data")) (if (not bytes)))
  (let decoded (call decode-image bytes 1 pasted-max-pixel-size))
  (return (call PastedImage id decoded (call clipboard-data-item type bytes) (str type " · " (call pasted-size decoded))))
)

(fn-do _ read-pasted-file PastedImage (?! IOError)
  (param file Path)
  (param id Size)
  (let loaded (call load-image file pasted-max-pixel-size))
  (return (call PastedImage id loaded (call clipboard-file-item file) (str (. file name) " · " (call pasted-size loaded))))
)

(fn-expr _ takes-drop Bool
  (param payload DragPayload)
  (case? (is payload ClipboardDrag)
    (call some (. (as payload ClipboardDrag) clipboard items) (:where (or (. each is-image) (. each is-promised-image))))
  )
  (default
    false
  )
)

(fn-expr _ dropped-entries (list ClipboardEntry)
  (param items (list ClipboardEntry))
  (spread items)
  (pipe ?> (and (. each is-image) (== (. each promised-type) null)))
  (pipe |> List)
)

(fn-expr _ pasted-without (list PastedImage)
  (param items (list PastedImage))
  (param id Size)
  (spread items)
  (pipe ?> (!= (. each id) id))
  (pipe |> List)
)

(fn-expr _ pasted-size String
  (param image Image)
  (str (. image pixel-width) "×" (. image pixel-height))
)

(fn-do _ clipboard-lines (list String)
  (param clipboard Clipboard)
  (let lines (list String))
  (for (in entry (. clipboard items))
    (let file (. entry path))
    (+= lines (if-expr file (str "Item " (+ (. entry index) 1) ": " (. file name)) (str "Item " (+ (. entry index) 1))))
    (for (in type (. entry types))
      (+= lines (str "    " type))
    )
  )
  (return lines)
)
