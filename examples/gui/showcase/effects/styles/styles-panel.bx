(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)

(style StylesTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (rule showcase-panel
    (= background-color "#dbeafe")
    (= border-color "#2563eb")
    (= border-width 6)
    (= color "#1d4ed8")
    (= font-size 17)
    (= font-weight (. FontWeight bold))
    (blank)
    (when-style #is-accented
      (= background-color "#4c1d95")
      (= border-color "#f59e0b")
      (= border-width 12)
      (= color "#fbbf24")
    )
  )
)

(type + StylesPanel (is Box)
  (using StylesTheme)
  (prop + accented _ (= false))
  (blank)
  (rule This (• w 820) (• h 520))
  (content
    (<> This
      (<> Label (• absolute) (• w 740) (• h 24)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 28))
        (= text "Theme rule · inline override · inherited color · reactive when condition")
      )
      (blank)
      (<> AccentPanel (• showcase-panel) (• absolute) (• w 340) (• h 300)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 92))
        (= is-accented #accented)
        (blank)
        (<> Label (• absolute) (• w 280) (• h 30)
          (= left (call (. PositionOffset coord) 30))
          (= top (call (. PositionOffset coord) 26))
          (= text "Inherited canvas text")
          (= text-alignment (. TextAlignment center))
        )
        (blank)
        (<> ForegroundSwatch (• absolute) (• w 130) (• h 130)
          (= left (call (. PositionOffset coord) 105))
          (= top (call (. PositionOffset coord) 78))
        )
      )
      (blank)
      (<> AccentPanel (• showcase-panel) (• absolute) (• w 340) (• h 300) (• bg "#fff7ed")
        (= left (call (. PositionOffset coord) 440))
        (= top (call (. PositionOffset coord) 92))
        (blank)
        (<> Label (• absolute) (• w 280) (• h 30)
          (= left (call (. PositionOffset coord) 30))
          (= top (call (. PositionOffset coord) 26))
          (= text "Inline panel, inherited text")
          (= text-alignment (. TextAlignment center))
        )
        (blank)
        (<> ForegroundSwatch (• absolute) (• w 130) (• h 130)
          (= left (call (. PositionOffset coord) 105))
          (= top (call (. PositionOffset coord) 78))
        )
      )
      (blank)
      (<> Label (• absolute) (• w 500) (• h 22)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 420))
        (= text "Move the slider across the midpoint and back")
      )
      (blank)
      (<> Slider (• absolute) (• w 740) (• h 30)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 454))
        (= minimum 0)
        (= maximum 1)
        (= value 0)
        (for (on event value-changed)
          (= accented (>= (. event value) 0.5))
        )
      )
    )
  )
)

(type + AccentPanel (is Box)
  (prop + is-accented _ (= false))
)

(type + ForegroundSwatch (is Box)
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint-self _
    (param canvas Canvas)
    (call (. canvas push))
    (let content content-bounds)
    (call (. canvas translate) (. content x) (. content y))
    (= (. canvas fill-color) $color)
    (= (. canvas stroke-color) null)
    (call (. canvas circle) (/ width 2) (/ height 2) (/ (call min width height) 2))
    (call (. canvas pop))
  )
)
