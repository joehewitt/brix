(import ./text-lines-atlas)
(import /graphics/text)
(import /gui)

(type + TextLinesPanel (is Box)
  (using TextLinesTheme)
  (prop + font-family-name String (= "Noto Sans"))
  (prop + status _ (= "width 300.500 · size 17.500 · regular · truncate-tail · left · guides true"))
  (blank)
  (rule This (• w 1040) (• h 720))
  (content
    (<> This
      (<> Label (• absolute) (• w 120) (• h 20)
        (= left (call (. PositionOffset coord) 24))
        (= top (call (. PositionOffset coord) 16))
        (= text "Sample text")
      )
      (blank)
      (<> TextInput (• absolute) (• w 370) (• h 28)
        (= left (call (. PositionOffset coord) 24))
        (= top (call (. PositionOffset coord) 40))
        (= text "A deliberately long label: é · 👩🏽‍💻 · 日本語 · العربية")
        (for (on event input)
          (= (. atlas sample-text) (. event text))
          (call refresh-status)
        )
      )
      (blank)
      (<> Label (• absolute) (• w 150) (• h 20)
        (= left (call (. PositionOffset coord) 414))
        (= top (call (. PositionOffset coord) 16))
        (= text "Constraint width")
      )
      (blank)
      (<> Slider (• absolute) (• w 150) (• h 28)
        (= left (call (. PositionOffset coord) 414))
        (= top (call (. PositionOffset coord) 40))
        (= minimum 0)
        (= maximum 400)
        (= value 300.5)
        (for (on event value-changed)
          (= (. atlas sample-width) (. event value))
          (call refresh-status)
        )
      )
      (blank)
      (<> Label (• absolute) (• w 120) (• h 20)
        (= left (call (. PositionOffset coord) 584))
        (= top (call (. PositionOffset coord) 16))
        (= text "Font size")
      )
      (blank)
      (<> Slider (• absolute) (• w 120) (• h 28)
        (= left (call (. PositionOffset coord) 584))
        (= top (call (. PositionOffset coord) 40))
        (= minimum 8)
        (= maximum 38)
        (= value 17.5)
        (for (on event value-changed)
          (= (. atlas sample-size) (. event value))
          (call refresh-status)
        )
      )
      (blank)
      (<> TextLabButton (text: "Weight") (• absolute) (• w 88) (• h 32)
        (= left (call (. PositionOffset coord) 724))
        (= top (call (. PositionOffset coord) 36))
      )
      (blank)
      (<> TextLabButton (text: "Overflow") (• absolute) (• w 88) (• h 32)
        (= left (call (. PositionOffset coord) 820))
        (= top (call (. PositionOffset coord) 36))
      )
      (blank)
      (<> TextLabButton (text: "Align") (• absolute) (• w 84) (• h 32)
        (= left (call (. PositionOffset coord) 916))
        (= top (call (. PositionOffset coord) 36))
      )
      (blank)
      (<> TextLabButton (text: "Guides") (• absolute) (• w 88) (• h 32)
        (= left (call (. PositionOffset coord) 24))
        (= top (call (. PositionOffset coord) 78))
      )
      (blank)
      (<> Label (• absolute) (• w 880) (• h 28)
        (= left (call (. PositionOffset coord) 128))
        (= top (call (. PositionOffset coord) 80))
        (= text #status)
        (= text-alignment (. TextAlignment right))
      )
      (blank)
      (<> TextLinesAtlas (id: atlas) (• absolute) (• w 960) (• h 560)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 124))
        (= font-family-name #font-family-name)
      )
    )
  )
  (fn-do + press _
    (param action String)
    (if (== action "Weight")
      (if (== (. atlas sample-weight) (. FontWeight regular))
        (= (. atlas sample-weight) (. FontWeight bold))
        (else
          (= (. atlas sample-weight) (. FontWeight regular))
        )
      )
      (else-if (== action "Overflow")
        (if (== (. atlas sample-overflow) (. TextOverflow clip))
          (= (. atlas sample-overflow) (. TextOverflow truncate-tail))
          (else
            (= (. atlas sample-overflow) (. TextOverflow clip))
          )
        )
      )
      (else-if (== action "Align")
        (= (. atlas sample-alignment)
          (match (. atlas sample-alignment)
            (case (. TextAlignment left)
              (. TextAlignment center)
            )
            (case (. TextAlignment center)
              (. TextAlignment right)
            )
            (case (. TextAlignment right)
              (. TextAlignment left)
            )
          )
        )
      )
      (else-if (== action "Guides")
        (= (. atlas overlays-visible) (not (. atlas overlays-visible)))
      )
    )
    (call refresh-status)
  )
  (fn-do _ refresh-status _
    (= status (. atlas control-summary))
  )
)

(type + TextLabButton (is Box)
  (prop + action String)
  (blank)
  (rule This (• bg gui-field-color)
    (= focus-mode (. FocusMode press))
    (= border-color gui-border-color)
    (= border-width 2)
    (= font-weight (. FontWeight bold))
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
  )
  (fn-do + This _
    (param action _)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= text action)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. (call (of ancestor TextLinesPanel)) press) action)
  )
)
