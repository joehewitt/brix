(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(style TextLinesTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (rule text-lab-atlas
    (= background-color "#f8fafc")
    (= color "#0f172a")
    (= font-size 13)
  )
  (blank)
  (rule text-lab-title
    (= color "#172554")
    (= font-size 22)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule text-lab-caption
    (= color "#475569")
    (= font-size 12)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule text-lab-sample
    (= background-color "#ffffff")
    (= border-color "#cbd5e1")
    (= border-width 1)
    (= padding-left 10)
    (= padding-right 10)
    (= padding-top 7)
    (= padding-bottom 7)
  )
)

(type + TextLinesAtlas (is Box)
  (implements MarkupRootElement)
  (using TextLinesTheme)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + sample-text String (= "A deliberately long label: é · 👩🏽‍💻 · 日本語 · العربية"))
  (prop + font-family-name String (= "Noto Sans"))
  (prop + sample-width Length (= 300.5))
  (prop + sample-size Length (= 17.5))
  (prop + sample-weight FontWeight (= (. FontWeight regular)))
  (prop + sample-overflow TextOverflow (= (. TextOverflow truncate-tail)))
  (prop + sample-alignment TextAlignment (= (. TextAlignment left)))
  (prop + overlays-visible _ (= true))
  (content
    (<> This (• text-lab-atlas)
      (= font-family #font-family-name)
      (blank)
      (<> Label (• text-lab-title) (• absolute) (• w 880) (• h 32)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 20))
        (= text "Phase 0 · canonical single-line text layout")
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 400) (• h 18)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 72))
        (= text "EMPTY STRING · STILL ONE TYPOGRAPHIC LINE")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 400) (• h 54)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 94))
        (= sample-name "empty")
        (= text "")
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 420) (• h 18)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 72))
        (= text "LIVE WIDTH · FONT · WEIGHT · OVERFLOW · ALIGNMENT")
      )
      (blank)
      (<> TextLabControlledLabel (• absolute) (• h 54)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 94))
        (= sample-name "controlled")
        (= text #sample-text)
        (= controlled-width #sample-width)
        (= controlled-font-size #sample-size)
        (= controlled-font-weight #sample-weight)
        (= controlled-overflow #sample-overflow)
        (= controlled-alignment #sample-alignment)
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 400) (• h 18)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 176))
        (= text "GRAPHEMES · EMOJI · COMBINING MARKS")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 400) (• h 54)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 198))
        (= sample-name "grapheme")
        (= text "👩🏽‍💻  é  🇯🇵  family 👨‍👩‍👧‍👦  trailing text")
        (= font-size 18.5)
        (= text-overflow (. TextOverflow truncate-tail))
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 420) (• h 18)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 176))
        (= text "CJK · ARABIC · HEBREW · BIDI")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 420) (• h 54)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 198))
        (= sample-name "international")
        (= text "日本語 العربية עברית · ABC 123 · نهاية")
        (= font-size 18.5)
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 400) (• h 18)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 280))
        (= text "SPACES · TABS · HARD BREAKS REMAIN ONE LINE")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 400) (• h 54)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 302))
        (= sample-name "hard-break")
        (= text "spaces   tabs\tline one\nline two\r\nline three")
        (= font-size 15.5)
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 420) (• h 18)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 280))
        (= text "ZERO AND SUB-ELLIPSIS WIDTHS")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• h 54)
        (= left (call (. PositionOffset coord) 500))
        (= top (call (. PositionOffset coord) 302))
        (= sample-name "subellipsis")
        (= min-width (call (. SizeSpec coord) 10))
        (= max-width (call (. SizeSpec coord) 10))
        (= text "Cannot fit an ellipsis")
        (= font-size 18)
        (= text-overflow (. TextOverflow truncate-tail))
      )
      (blank)
      (<> Label (• text-lab-caption) (• absolute) (• w 880) (• h 18)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 384))
        (= text "ALIGNMENT IS PAINT-ONLY · SHAPING SNAPSHOT IS REUSED")
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 270) (• h 54)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 406))
        (= sample-name "left")
        (= text "left aligned")
        (= font-size 16.5)
        (= text-alignment (. TextAlignment left))
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 270) (• h 54)
        (= left (call (. PositionOffset coord) 345))
        (= top (call (. PositionOffset coord) 406))
        (= sample-name "center")
        (= text "center aligned")
        (= font-size 16.5)
        (= text-alignment (. TextAlignment center))
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> TextLabSampleLabel (• text-lab-sample) (• absolute) (• w 270) (• h 54)
        (= left (call (. PositionOffset coord) 650))
        (= top (call (. PositionOffset coord) 406))
        (= sample-name "right")
        (= text "right aligned")
        (= font-size 16.5)
        (= text-alignment (. TextAlignment right))
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> Label (• absolute) (• w 880) (• h 38)
        (= left (call (. PositionOffset coord) 40))
        (= top (call (. PositionOffset coord) 496))
        (= text
          (paragraph
            "Overlay: red content bounds · blue baseline · green typographic bounds · orange ink bounds · violet natural width"
          )
        )
        (= color "#334155")
        (= text-alignment (. TextAlignment center))
        (= text-overflow (. TextOverflow clip))
      )
      (blank)
      (<> TextLabGuides (• absolute) (• cover .parent)
        (= overlays-visible #overlays-visible)
      )
    )
  )
  (fn-expr + control-summary String :get
    (str "width " sample-width " · size " sample-size " · " sample-weight " · " (call text-lab-overflow-name sample-overflow) " · " (call text-lab-alignment-name sample-alignment) " · guides " overlays-visible)
  )
  (fn-expr + manifest _
    (call (. "" join)
      (block
        (item "text-lines-manifest v1\nscale=2\n")
        (spread
          (block
            children
            (pipe ?*>
              (match? each
                (case (: label TextLabSampleLabel)
                  (call text-lab-manifest-line (. label sample-name) label)
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + TextLabSampleLabel (is Label)
  (prop + sample-name String (= "sample"))
)

(type + TextLabControlledLabel (is TextLabSampleLabel)
  (prop + controlled-width Length (= 300.5))
  (prop + controlled-font-size Length (= 17.5))
  (prop + controlled-font-weight FontWeight (= (. FontWeight regular)))
  (prop + controlled-overflow TextOverflow (= (. TextOverflow truncate-tail)))
  (prop + controlled-alignment TextAlignment (= (. TextAlignment left)))
  (blank)
  (rule This (• text-lab-sample)
    (= min-width (call (. SizeSpec coord) #controlled-width))
    (= max-width (call (. SizeSpec coord) #controlled-width))
    (= font-size #controlled-font-size)
    (= font-weight #controlled-font-weight)
    (= text-overflow #controlled-overflow)
    (= text-alignment #controlled-alignment)
  )
)

(type + TextLabGuides (is Box)
  (prop + overlays-visible _ (= true))
  (blank)
  (depends invalidate-paint overlays-visible)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (not overlays-visible)))
    (call (. canvas push))
    (let content content-bounds)
    (call (. canvas translate) (. content x) (. content y))
    (let atlas (as (!! %parent) TextLinesAtlas))
    (for (in child (. atlas children))
      (if (is child TextLabSampleLabel)
        (call draw-label-guides (as child TextLabSampleLabel) canvas)
      )
    )
    (call (. canvas pop))
  )
  (fn-do _ draw-label-guides _
    (param label Label)
    (param canvas Canvas)
    (let snapshot (. label text-layout-snapshot))
    (return-if (if (not snapshot)))
    (let line ([] (. snapshot lines) 0))
    (let guide-origin content-bounds)
    (let content (. label content-bounds))
    (let x (- (. content x) (. guide-origin x)))
    (let y (- (. content y) (. guide-origin y)))
    (let text-x (+ x (call text-lab-alignment-offset (. label $text-alignment) (. content width) (. snapshot size width))))
    (let text-y (+ y (/ (- (. content height) (. snapshot size height)) 2)))
    (let typographic
      (call Rect
        (block
          (arg (+ text-x (. line typographic-bounds x)))
          (arg (+ text-y (. line typographic-bounds y)))
          (arg (. line typographic-bounds width))
          (arg (. line typographic-bounds height))
        )
      )
    )
    (let ink
      (call Rect
        (block
          (arg (+ text-x (. line ink-bounds x)))
          (arg (+ text-y (. line ink-bounds y)))
          (arg (. line ink-bounds width))
          (arg (. line ink-bounds height))
        )
      )
    )
    (blank)
    (call (. canvas push))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) 1)
    (= (. canvas stroke-color) "#dc2626")
    (call (. canvas rect) (call Rect x y (. content width) (. content height)))
    (= (. canvas stroke-color) "#2563eb")
    (call (. canvas line)
      (block
        (arg x)
        (arg (+ text-y (. snapshot first-baseline)))
        (arg (+ x (. content width)))
        (arg (+ text-y (. snapshot first-baseline)))
      )
    )
    (= (. canvas stroke-color) "#16a34a")
    (call (. canvas rect) typographic)
    (= (. canvas stroke-color) "#ea580c")
    (call (. canvas rect) ink)
    (= (. canvas stroke-color) "#7c3aed")
    (call (. canvas line) (+ x (. snapshot natural-width)) y (+ x (. snapshot natural-width)) (+ y (. content height)))
    (call (. canvas pop))
  )
)

(fn-expr _ text-lab-alignment-offset Length
  (param alignment TextAlignment)
  (param available Length)
  (param occupied Length)
  (match alignment
    (case (. TextAlignment left)
      0
    )
    (case (. TextAlignment center)
      (/ (- available occupied) 2)
    )
    (case (. TextAlignment right)
      (- available occupied)
    )
  )
)

(fn-expr _ text-lab-manifest-line String
  (param name String)
  (param label Label)
  (case? (not (. label text-layout-snapshot))
    (str name "=unpainted\n")
  )
  (default
    (str name "=" (. snapshot normalized) "\n")
  )
  (where
    (lazy snapshot (!! (. label text-layout-snapshot)))
  )
)

(fn-expr + text-lab-overflow-name String
  (param overflow TextOverflow)
  (match overflow
    (case (. TextOverflow clip)
      "clip"
    )
    (case (. TextOverflow truncate-tail)
      "truncate-tail"
    )
    (case (. TextOverflow truncate-head)
      "truncate-head"
    )
  )
)

(fn-expr + text-lab-alignment-name String
  (param alignment TextAlignment)
  (match alignment
    (case (. TextAlignment left)
      "left"
    )
    (case (. TextAlignment center)
      "center"
    )
    (case (. TextAlignment right)
      "right"
    )
  )
)
