(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /units)

(type + OpacityPanel (is Box)
  (prop + level F64 (= 0.65))
  (blank)
  (rule This (• w 980) (• h 680))
  (content
    (<> This
      (<> Label (• absolute) (• w 880) (• h 34)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 24))
        (= text "Subtree opacity")
        (= font-size 25)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 880) (• h 24) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 62))
        (= text
          (paragraph
            "One composited group preserves opaque overlap; per-item opacity blends every overlap."
          )
        )
        (= font-size 14)
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 400) (• h 24) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 55))
        (= top (call (. PositionOffset coord) 108))
        (= text "GROUP OPACITY")
        (= font-size 12)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Label (• absolute) (• w 400) (• h 24) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 525))
        (= top (call (. PositionOffset coord) 108))
        (= text "THE SAME OPACITY ON EACH ITEM")
        (= font-size 12)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> OpacityCheckerboard (• absolute) (• w 400) (• h 250)
        (= left (call (. PositionOffset coord) 55))
        (= top (call (. PositionOffset coord) 138))
      )
      (blank)
      (<> GroupedOpacityArtwork (• absolute) (• w 400) (• h 250)
        (= left (call (. PositionOffset coord) 55))
        (= top (call (. PositionOffset coord) 138))
        (= alpha (as #level Ratio))
      )
      (blank)
      (<> OpacityCheckerboard (• absolute) (• w 400) (• h 250)
        (= left (call (. PositionOffset coord) 525))
        (= top (call (. PositionOffset coord) 138))
      )
      (blank)
      (<> ItemizedOpacityArtwork (• absolute) (• w 400) (• h 250)
        (= left (call (. PositionOffset coord) 525))
        (= top (call (. PositionOffset coord) 138))
        (= alpha (as #level Ratio))
      )
      (blank)
      (<> Label (• absolute) (• w 880) (• h 24)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 420))
        (= text (str "Opacity " (call round (* #level 100)) "% · nested child effective " (call round (* #level 75)) "%"))
        (= font-size 14)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> Slider (• absolute) (• w 760) (• h 30)
        (= left (call (. PositionOffset coord) 110))
        (= top (call (. PositionOffset coord) 454))
        (= minimum 0)
        (= maximum 1)
        (<-> value level)
      )
      (blank)
      (<> Label (• absolute) (• w 880) (• h 20) (• text gui-muted-text-color)
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 510))
        (= text "NESTED OPACITY · 75% PARENT × LIVE CHILD OPACITY")
        (= font-size 12)
        (= font-weight (. FontWeight bold))
        (= text-alignment (. TextAlignment center))
      )
      (blank)
      (<> OpacityCheckerboard (• absolute) (• w 760) (• h 92)
        (= left (call (. PositionOffset coord) 110))
        (= top (call (. PositionOffset coord) 540))
      )
      (blank)
      (<> NestedOpacityArtwork (• absolute) (• w 760) (• h 92)
        (= left (call (. PositionOffset coord) 110))
        (= top (call (. PositionOffset coord) 540))
        (= child-alpha (as #level Ratio))
      )
    )
  )
)

(type + OpacityCheckerboard (is Box)
  (rule This (• bg "#f8fafc")
    (= border-color gui-border-color)
    (= border-width 2)
    (= corner-radius 22)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (= (. canvas fill-color) (call RGBA "#e2e8f0"))
    (= (. canvas stroke-color) null)
    (for (in row (..< 0 14))
      (for (in column (..< 0 44))
        (if (== (% (+ row column) 2) 0)
          (call (. canvas rect) (call Rect (+ (. bounds x) (* column 18)) (+ (. bounds y) (* row 18)) 18 18))
        )
      )
    )
  )
)

(type + OpacityPiece (is Box)
  (prop + caption String)
  (prop + alpha Ratio (= 1%%))
  (blank)
  (rule This (• text white)
    (= opacity #alpha)
    (= corner-radius 28)
    (= font-size 17)
    (= font-weight (. FontWeight bold))
  )
  (fn-do + This _
    (param caption _)
  )
  (content
    (<> This (• flex-col)
      (<> Label (• flex 1)
        (= text #caption)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
)

(type + GroupedOpacityArtwork (is Box)
  (prop + alpha Ratio (= 1%%))
  (blank)
  (rule This
    (= opacity #alpha)
  )
  (content
    (<> This
      (<> OpacityPiece (text: "BLUE") (• absolute) (• w 245) (• h 142) (• bg "#2563eb")
        (= left (call (. PositionOffset coord) 34))
        (= top (call (. PositionOffset coord) 30))
      )
      (blank)
      (<> OpacityPiece (text: "ORANGE") (• absolute) (• w 225) (• h 132) (• bg "#f97316")
        (= left (call (. PositionOffset coord) 140))
        (= top (call (. PositionOffset coord) 86))
      )
    )
  )
)

(type + ItemizedOpacityArtwork (is Box)
  (prop + alpha Ratio (= 1%%))
  (content
    (<> This
      (<> OpacityPiece (text: "BLUE") (• absolute) (• w 245) (• h 142) (• bg "#2563eb")
        (= left (call (. PositionOffset coord) 34))
        (= top (call (. PositionOffset coord) 30))
        (= alpha #alpha)
      )
      (blank)
      (<> OpacityPiece (text: "ORANGE") (• absolute) (• w 225) (• h 132) (• bg "#f97316")
        (= left (call (. PositionOffset coord) 140))
        (= top (call (. PositionOffset coord) 86))
        (= alpha #alpha)
      )
    )
  )
)

(type + NestedOpacityArtwork (is Box)
  (prop + child-alpha Ratio (= 1%%))
  (blank)
  (rule This
    (= opacity 0.75%%)
  )
  (content
    (<> This
      (<> OpacityPiece (text: "PARENT 75%") (• absolute) (• w 660) (• h 58) (• bg "#7c3aed")
        (= left (call (. PositionOffset coord) 50))
        (= top (call (. PositionOffset coord) 17))
      )
      (blank)
      (<> OpacityPiece (text: "CHILD × LIVE") (• absolute) (• w 250) (• h 58) (• bg "#06b6d4")
        (= left (call (. PositionOffset coord) 460))
        (= top (call (. PositionOffset coord) 17))
        (= alpha #child-alpha)
      )
    )
  )
)
