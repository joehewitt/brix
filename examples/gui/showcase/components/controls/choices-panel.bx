(import ./controls-kit)
(import /graphics/color)
(import /gui)

(type + ChoicesPanel (is Box)
  (using ControlsTheme)
  (prop + alignment _ (= "left"))
  (prop + view _ (= "list"))
  (prop + document _ (= "notes"))
  (content
    (<> This (• controls-page)
      (<> ControlsCard (text: "Check boxes and switches")
        (<> CheckBox (text: "Show hidden files") (• mb 10)
          (= is-on true)
        )
        (<> CheckBox (text: "Wrap lines") (• mb 10))
        (<> CheckBox (text: "Some selected") (• mb 10)
          (= is-mixed true)
        )
        (<> CheckBox (text: "Disabled") (• mb 14)
          (= is-on true)
          (= is-enabled false)
        )
        (<> Switch (text: "Snap to grid") (• mb 10)
          (= is-on true)
        )
        (<> Switch (text: "Show rulers") (• mb 10))
        (<> Switch (text: "Disabled")
          (= is-enabled false)
        )
      )
      (<> ControlsCard (text: "Segmented controls")
        (<> (of SegmentedControl String) (• mb 10)
          (= selected #alignment)
          (for (on event selection-changed)
            (= alignment (. event value))
          )
          (<> (of Segment String) (text: "Left")
            (= value "left")
          )
          (<> (of Segment String) (text: "Center")
            (= value "center")
          )
          (<> (of Segment String) (text: "Right")
            (= value "right")
          )
          (<> (of Segment String) (text: "Justify")
            (= value "justify")
            (= is-enabled false)
          )
        )
        (<> (of SegmentedControl String)
          (= selected #view)
          (for (on event selection-changed)
            (= view (. event value))
          )
          (<> (of Segment String) (text: "List") (• flex 1)
            (= value "list")
          )
          (<> (of Segment String) (text: "Board") (• flex 1)
            (= value "board")
          )
          (<> (of Segment String) (text: "Timeline") (• flex 1)
            (= value "timeline")
          )
        )
      )
      (<> ControlsCard (text: "Sliders, progress and color wells")
        (<> Slider (• h 24) (• mb 6)
          (= minimum 0)
          (= maximum 100)
          (= value 40)
        )
        (<> Slider (• h 24) (• mb 6)
          (= minimum 0)
          (= maximum 100)
          (= step 25)
          (= value 50)
        )
        (<> Slider (• h 24) (• mb 10)
          (= value 0.3)
          (= is-enabled false)
        )
        (<> ProgressBar (• mb 10)
          (= minimum 0)
          (= value 0.35)
        )
        (<> ProgressBar (• mb 14)
          (= minimum 0)
          (= is-indeterminate true)
        )
        (<> Box (• controls-row)
          (<> ColorWell
            (= color (call RGBA "#3b82f6"))
          )
          (<> ColorWell
            (= color (call RGBA "#f59e0b"))
          )
          (<> ColorWell
            (= color (call RGBA "#22c55e80"))
          )
        )
      )
      (<> ControlsCard (text: "Tabs")
        (<> (of TabBar String)
          (= selected #document)
          (for (on event selection-changed)
            (= document (. event value))
          )
          (<> TabStrip
            (<> (of Tab String)
              (= title "Notes")
              (= value "notes")
              (= is-closable false)
            )
            (<> (of Tab String)
              (= title "Sketch")
              (= value "sketch")
              (= is-renamable true)
            )
            (<> (of Tab String)
              (= title "Budget")
              (= value "budget")
            )
          )
        )
      )
    )
  )
)
