(import /graphics/text)
(import /gui)

(style ControlsTheme
  (using GUIDefaultTheme)
  (rule controls-page (• p 24)
    (= layout (call GridLayout (list (call (. GridTrack flex) 1) (call (. GridTrack flex) 1))))
    (= gap 16)
  )
  (blank)
  (rule controls-card (• bg gui-panel-color) (• flex-col) (• p 16)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
  )
  (blank)
  (rule controls-card-title (• h 20) (• mb 12)
    (= font-size 14)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule controls-row (• flex-row) (• mb 10)
    (= gap 8)
  )
)

(type + ControlsCard (is Box)
  (using ControlsTheme)
  (prop + title _ (= ""))
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• controls-card)
      (<> Label (• controls-card-title)
        (= text #title)
      )
    )
  )
)
