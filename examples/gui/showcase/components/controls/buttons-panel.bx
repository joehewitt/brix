(import ./controls-kit)
(import /gui)
(import /gui/icons/lucide/download)
(import /gui/icons/lucide/inbox)
(import /gui/icons/lucide/plus)
(import /gui/icons/lucide/search)
(import /gui/icons/lucide/settings)
(import /gui/icons/lucide/star)

(type + ButtonsPanel (is Box)
  (using ControlsTheme)
  (prop + is-starred _ (= true))
  (content
    (<> This (• controls-page)
      (<> ControlsCard (text: "Push buttons")
        (<> Box (• controls-row)
          (<> Button (text: "Cancel"))
          (<> Button (text: "Save")
            (= role (. ButtonRole default))
          )
        )
        (<> Box (• controls-row)
          (<> Button (text: "Delete")
            (= role (. ButtonRole destructive))
          )
          (<> Button (text: "Starred") (• icon-star)
            (= is-on #is-starred)
            (= action (=> () :do (call toggle-star)))
          )
        )
        (<> Box (• controls-row)
          (<> Button (text: "Disabled")
            (= is-enabled false)
          )
          (<> Button (text: "Default")
            (= role (. ButtonRole default))
            (= is-enabled false)
          )
        )
      )
      (<> ControlsCard (text: "Icons, hints and badges")
        (<> Box (• controls-row)
          (<> Button (text: "Add") (• icon-plus))
          (<> Button (• icon-settings))
        )
        (<> Box (• controls-row)
          (<> Button (text: "Search") (• icon-search)
            (<> Label (slot: trailing) (text: "⌘K") (• button-hint))
          )
          (<> Button (text: "Inbox") (• icon-inbox)
            (<> Label (slot: trailing) (text: "12") (• button-badge))
          )
        )
      )
      (<> ControlsCard (text: "Icon buttons")
        (<> Box (• controls-row)
          (<> IconButton (• icon-plus))
          (<> IconButton (• icon-search))
          (<> IconButton (• icon-star)
            (= is-on true)
          )
          (<> IconButton (• icon-settings))
          (<> IconButton (• icon-download)
            (= is-enabled false)
          )
        )
      )
      (<> ControlsCard (text: "Menus and selects")
        (<> MenuButton (text: "Sort by Name") (• mb 10)
          (<> Menu
            (<> MenuItem (text: "Name"))
            (<> MenuItem (text: "Date Modified"))
            (<> MenuItem (text: "Size"))
          )
        )
        (<> (of Select String) (• mb 10)
          (= options (call controls-fonts))
          (= selected "Helvetica")
        )
        (<> (of Select String) (• mb 10)
          (= options (call controls-fonts))
          (= placeholder "Choose a font")
        )
        (<> (of Select String)
          (= options (call controls-fonts))
          (= selected "Menlo")
          (= is-enabled false)
        )
      )
    )
  )
  (fn-do _ toggle-star _
    (= is-starred (not is-starred))
  )
)

(fn-expr _ controls-fonts (list String)
  (list "Avenir" "Baskerville" "Futura" "Helvetica" "Menlo" "Palatino")
)
