(import ./files)
(import ./theme)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/box)
(import /gui/icons/lucide/download)
(import /gui/icons/lucide/inbox)
(import /gui/icons/lucide/map)
(import /gui/icons/lucide/palette)
(import /gui/icons/lucide/plus)
(import /gui/icons/lucide/rocket)
(import /gui/icons/lucide/search)
(import /gui/icons/lucide/settings)
(import /gui/icons/lucide/square-pen)
(import /gui/icons/lucide/star)

(type + SidebarPanel (is Box)
  (using SidebarTheme)
  (prop + current _ (= "Roadmap"))
  (prop + current-title _ (= "Roadmap"))
  (prop + last-action _ (= "Nothing yet"))
  (prop + is-starred _ (= false))
  (prop + projects _ (= (list "Compiler" "Runtime" "Standard library" "Website")))
  (prop + teams _ (= (list "Language" "Graphics" "Tooling")))
  (prop + files-root _ (= (call file-fixture)))
  (content
    (<> This (• flex-row)
      (<> Sidebar (• w 264)
        (<> SidebarSection (• pt 10)
          (<> SidebarItem (text: "New chat") (• icon-square-pen)
            (= action (=> () :do (call run "New chat")))
          )
          (<> SidebarItem (text: "Search") (• icon-search)
            (= action (=> () :do (call run "Search")))
            (<> Label (slot: trailing) (text: "⌘K") (• button-hint))
          )
          (<> SidebarItem (text: "Inbox") (• icon-inbox)
            (= is-on (== #current "Inbox"))
            (= action (=> () :do (call go "Inbox")))
            (<> Label (slot: trailing) (text: "12") (• button-badge))
          )
        )
        (blank)
        (<> SidebarSection (text: "Favorites")
          (<> SidebarItem (text: "Roadmap") (• icon-map)
            (= is-on (== #current "Roadmap"))
            (= action (=> () :do (call go "Roadmap")))
          )
          (<> SidebarItem (text: "Launch plan") (• icon-rocket)
            (= is-on (== #current "Launch plan"))
            (= action (=> () :do (call go "Launch plan")))
          )
          (<> SidebarItem (text: "Design system") (• icon-palette)
            (= is-on (== #current "Design system"))
            (= action (=> () :do (call go "Design system")))
          )
        )
        (blank)
        (<> SidebarSection (text: "Projects")
          (for (in project #projects (keyed-by project))
            (<> SidebarItem (• icon-box)
              (= title project)
              (= is-on (== #current project))
              (= action (=> () :do (call go project)))
            )
          )
        )
        (blank)
        (<> SidebarSection (text: "Teams")
          (= is-expanded false)
          (blank)
          (for (in team #teams (keyed-by team))
            (<> SidebarItem
              (= title team)
              (= is-on (== #current team))
              (= action (=> () :do (call go team)))
            )
          )
        )
        (blank)
        (<> SidebarSection (text: "Files")
          (<> (of TreeBox FileNode) (id: file-tree)
            (= root-node files-root)
            (= load-children file-children)
            (= key-builder file-key)
            (= auto-expand file-is-folder)
            (= selected-keys (list #current))
            (= can-drag (=> (node) true))
            (= can-drop (=> (drop) (!= (. drop parent children) null)))
            (blank)
            (for (on event selection-changed)
              (call open-selected-file)
            )
            (blank)
            (for (on event dropped)
              (call move-files event)
            )
            (blank)
            (<> FileRow (slot: row) (param: row)
              (= item (!! (. row #item)))
            )
          )
        )
        (blank)
        (<> Box (slot: footer) (• h 52) (• px 12) (• items-center)
          (<> Box (• avatar) (• flex-row)
            (<> Label (text: "AL") (• flex 1)
              (= text-alignment (. TextAlignment center))
            )
          )
          (<> Label (text: "Ada Lovelace") (• account-name) (• flex 1))
          (<> IconButton (• icon-settings)
            (= action (=> () :do (call run "Settings")))
          )
        )
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• p 32)
        (<> Label (• content-title)
          (= text #current-title)
        )
        (<> Label (• content-note)
          (= text (str "Last action: " #last-action))
        )
        (blank)
        (<> Label (text: "PUSH BUTTONS") (• content-heading))
        (<> Box (• flex-row) (• h 28)
          (<> Button (text: "Save") (• mr 8)
            (= action (=> () :do (call run "Save")))
          )
          (<> Button (text: "New file") (• mr 8) (• icon-plus)
            (= action (=> () :do (call run "New file")))
          )
          (<> Button (text: "Starred") (• mr 8) (• icon-star)
            (= is-on #is-starred)
            (= action (=> () :do (call toggle-star)))
          )
          (<> Button (text: "Download") (• mr 8) (• icon-download)
            (= is-enabled false)
          )
          (<> Button (• icon-settings)
            (= action (=> () :do (call run "Settings")))
          )
        )
      )
    )
  )
  (fn-do _ run _
    (param name String)
    (= last-action name)
  )
  (fn-do _ go _
    (param page String)
    (= current page)
    (= current-title page)
    (= last-action (str "Opened " page))
  )
  (fn-do _ open-selected-file _
    (let node (. file-tree selected-item))
    (return-if (if (not node)))
    (blank)
    (= current (. node id))
    (= current-title (?? (call file-path files-root (. node id)) (. node name)))
    (= last-action (str "Opened " (. node name)))
  )
  (fn-do _ move-files _
    (param drop (of TreeBoxDrop FileNode))
    (let siblings (. drop parent children))
    (return-if (if (not siblings)))
    (blank)
    (for (in node (. drop items))
      (call detach-file files-root node)
    )
    (let offset Index (?? (. drop index) (. siblings length)))
    (for (in node (. drop items))
      (call (. siblings insert) node offset)
      (+= offset 1)
    )
    (call (?. (. drop source) reload))
    (= last-action (str "Moved " (. ([] (. drop items) 0) name) " into " (. drop parent name)))
    (let path (call file-path files-root current))
    (if path
      (= current-title path)
    )
  )
  (fn-do _ toggle-star _
    (= is-starred (not is-starred))
    (= last-action (if-expr is-starred "Starred" "Unstarred"))
  )
)
