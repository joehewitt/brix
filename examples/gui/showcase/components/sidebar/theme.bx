(import /graphics/color)
(import /graphics/text)
(import /gui)

(style SidebarTheme
  (using GUIDefaultTheme)
  (rule Sidebar
    (rule TreeBox
      (when-style #is-focused
        (rule ListItem
          (when-style #is-selected
            (rule file-icon (• text gui-accent-text-color))
            (blank)
            (rule folder-icon (• text gui-accent-text-color))
          )
        )
      )
    )
  )
  (blank)
  (rule file-icon (• text gui-muted-text-color))
  (blank)
  (rule folder-icon (• text "#d8a657"))
  (blank)
  (rule avatar (• bg gui-accent-color) (• text gui-accent-text-color) (• w 26) (• h 26)
    (= corner-radius 13)
    (= font-size 11)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule account-name (• text gui-strong-text-color) (• ml 10)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule content-title (• h 32)
    (= font-size 24)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule content-note (• text gui-muted-text-color) (• h 20) (• mt 4))
  (blank)
  (rule content-heading (• group-heading) (• h 16) (• mt 32) (• mb 10))
)
