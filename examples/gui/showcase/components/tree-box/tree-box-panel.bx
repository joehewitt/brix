(import /graphics/color)
(import /graphics/style)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/circle)
(import /gui/icons/lucide/file-code)
(import /gui/icons/lucide/file-json)
(import /gui/icons/lucide/file-text)
(import /gui/icons/lucide/folder)
(import /gui/icons/lucide/layers)
(import /gui/icons/lucide/spline)
(import /ui/selection)

(style TreeBoxTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (rule showcase-panel (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule panel-title
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule panel-note (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule panel-status (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule showcase-tree
    (= border-color gui-border-color)
    (= border-width 1)
    (blank)
    (when-style #is-focused
      (rule ListItem
        (when-style #is-selected
          (rule file-icon (• text gui-accent-text-color))
          (blank)
          (rule folder-icon (• text gui-accent-text-color))
        )
      )
    )
  )
  (blank)
  (rule showcase-action (• px 0)
    (= font-size 12)
  )
  (blank)
  (rule outline-group (• text gui-strong-text-color)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule file-icon (• text gui-muted-text-color))
  (blank)
  (rule folder-icon (• text "#d8a657"))
)

(type + TreeBoxPanel (is Box)
  (using TreeBoxTheme)
  (prop + explorer-root _ (= (call explorer-fixture)))
  (prop + explorer-activated _ (= "Nothing opened yet"))
  (prop + outline _ (= (call OutlineModel)))
  (prop + outline-reloads _ (= 0))
  (prop + lazy-loads _ (= 0))
  (content
    (<> This (• flex-row) (• p 16)
      (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• p 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Project explorer")
        )
        (<> Label (• panel-note) (• h 34)
          (= text "Arrows move · → opens · ← closes or climbs · Enter or double-click opens a file")
          (= text-wrap (. TextWrap word))
        )
        (blank)
        (<> (of TreeBox ExplorerNode) (id: explorer) (• showcase-tree) (• flex 1) (• mt 6)
          (= root-node explorer-root)
          (= load-children explorer-children)
          (= key-builder explorer-key)
          (blank)
          (<> ExplorerRow (slot: row) (param: row)
            (= item (!! (. row #item)))
          )
        )
        (blank)
        (<> Label (• panel-status) (• h 20) (• mt 6)
          (= text (str "Selected: " (?? (?. (. #explorer #selected-item) path) "none")))
        )
        (<> Label (• panel-status) (• h 20)
          (= text (str "Opened: " #explorer-activated))
        )
        (<> Box (• flex-row) (• h 28) (• mt 6)
          (<> Button (text: "Expand all") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call (. explorer expand-all))))
          )
          (<> Button (text: "Collapse all") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call (. explorer collapse-all))))
          )
          (<> Button (text: "Reveal chevron") (• showcase-action) (• flex 1)
            (= action (=> () :do (call reveal-chevron)))
          )
        )
      )
      (blank)
      (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• p 12) (• mx 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Live outline")
        )
        (<> Label (• panel-note) (• h 34)
          (= text "Click · ⌘-click toggles · ⇧-click selects a range · edits call reload() and keep expansion")
          (= text-wrap (. TextWrap word))
        )
        (blank)
        (<> (of TreeBox OutlineNode) (id: outline-tree) (• showcase-tree) (• flex 1) (• mt 6)
          (= root-node (. outline root))
          (= load-children outline-children)
          (= key-builder outline-key)
          (= selection-mode (. SelectionMode multiple))
          (blank)
          (<> OutlineRow (slot: row) (param: row)
            (= item (!! (. row #item)))
          )
        )
        (blank)
        (<> Label (• panel-status) (• h 20) (• mt 6)
          (= text (str "Selected: " (. #outline-tree #selected-keys length) " · rows: " (. #outline-tree #entries length) " · reloads: " #outline-reloads))
        )
        (<> Box (• flex-row) (• h 28) (• mt 6)
          (<> Button (text: "Add shape") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call add-outline-node false)))
          )
          (<> Button (text: "Add group") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call add-outline-node true)))
          )
          (<> Button (text: "Rename") (• showcase-action) (• flex 1)
            (= action (=> () :do (call rename-outline-node)))
          )
        )
        (<> Box (• flex-row) (• h 28) (• mt 6)
          (<> Button (text: "Move up") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call move-outline-node-up)))
          )
          (<> Button (text: "Delete selected") (• showcase-action) (• flex 1)
            (= action (=> () :do (call delete-outline-node)))
          )
        )
      )
      (blank)
      (<> Box (• showcase-panel) (• flex-col) (• flex 1) (• p 12)
        (<> Label (• panel-title) (• h 22)
          (= text "Lazy stress tree")
        )
        (<> Label (• panel-note) (• h 34)
          (= text "Twelve children per folder, six levels deep; folders load only when opened")
          (= text-wrap (. TextWrap word))
        )
        (blank)
        (<> (of TreeBox String) (id: lazy-tree) (• showcase-tree) (• flex 1) (• mt 6)
          (= root-node "")
          (= load-children (=> (id) (call load-lazy-children id)))
          (= item-has-children lazy-has-children)
          (= key-builder lazy-key)
          (blank)
          (<> LazyRow (slot: row) (param: row)
            (= item (!! (. row #item)))
          )
        )
        (blank)
        (<> Label (• panel-status) (• h 20) (• mt 6)
          (= text (str "Folders loaded: " #lazy-loads " · visible rows: " (. #lazy-tree #entries length)))
        )
        (<> Box (• flex-row) (• h 28) (• mt 6)
          (<> Button (text: "Expand 2 levels") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call (. lazy-tree expand-all) 2)))
          )
          (<> Button (text: "Expand 3 levels") (• showcase-action) (• flex 1) (• mr 6)
            (= action (=> () :do (call (. lazy-tree expand-all) 3)))
          )
          (<> Button (text: "Collapse all") (• showcase-action) (• flex 1)
            (= action (=> () :do (call (. lazy-tree collapse-all))))
          )
        )
      )
    )
  )
  (subscribe-for (on event (. explorer item-activated))
    (= explorer-activated (?? (?. (. explorer selected-item) name) "Nothing opened yet"))
  )
  (fn-do _ reveal-chevron _
    (let ignored
      (call (. explorer reveal-key-path)
        (block
          (arg
            (call explorer-key-path
              (block
                (arg "stdlib")
                (arg "stdlib/gui")
                (arg "stdlib/gui/icons")
                (arg "stdlib/gui/icons/lucide")
                (arg "stdlib/gui/icons/lucide/chevron-right.bx")
              )
            )
          )
        )
      )
    )
    (call (. explorer request-focus))
  )
  (fn-do _ add-outline-node _
    (param is-group Bool)
    (let node (call (. outline add) (call outline-insertion-group) is-group))
    (call reload-outline)
    (let ignored (call (. outline-tree reveal-key-path) (call (. outline key-path) node)))
    (call (. outline-tree select-key) (call outline-key node))
    (call (. outline-tree request-focus))
  )
  (fn-do _ rename-outline-node _
    (let node (. outline-tree selected-item))
    (return-if (if (not node)))
    (= (. node name) (call (. outline next-name) (. node is-group)))
    (call reload-outline)
  )
  (fn-do _ move-outline-node-up _
    (let node (. outline-tree selected-item))
    (return-if (if (not node)))
    (call (. outline move-up) node)
    (call reload-outline)
  )
  (fn-do _ delete-outline-node _
    (let doomed (. outline-tree selected-items))
    (return-if (if (not doomed)))
    (for (in node doomed)
      (call (. outline remove) node)
    )
    (call reload-outline)
    (call (. outline-tree select-key) (?. (. outline-tree selected-entry) key))
    (call (. outline-tree request-focus))
  )
  (fn-do _ reload-outline _
    (call (. outline-tree reload))
    (+= outline-reloads 1)
  )
  (fn-expr _ outline-insertion-group OutlineNode
    (case? (not node)
      (. outline root)
    )
    (case? (. node is-group)
      node
    )
    (default
      (?? (. node parent) (. outline root))
    )
    (where
      (lazy node (. outline-tree selected-item))
    )
  )
  (fn-do _ load-lazy-children (? (list String))
    (param id String)
    (+= lazy-loads 1)
    (let result (list String))
    (let index 0)
    (while (< index 12)
      (+= result (if-expr (. id length) (str id "/" index) (str index)))
      (+= index 1)
    )
    (return result)
  )
)

(type + ExplorerRow (is Box)
  (prop + item ExplorerNode)
  (content
    (<> This (• flex-row) (• flex 1)
      (if (!= (. #item children) null)
        (<> LucideFolder (• icon) (• folder-icon) (• w 15) (• h 15) (• mr 6)
          (= align-y (. Alignment center))
        )
      )
      (if (and (== (. #item children) null) (call (. #item name ends-with) ".bx"))
        (<> LucideFileCode (• icon) (• file-icon) (• w 15) (• h 15) (• mr 6)
          (= align-y (. Alignment center))
        )
      )
      (if (and (== (. #item children) null) (call (. #item name ends-with) ".json"))
        (<> LucideFileJson (• icon) (• file-icon) (• w 15) (• h 15) (• mr 6)
          (= align-y (. Alignment center))
        )
      )
      (if (and (== (. #item children) null) (call (. #item name ends-with) ".md"))
        (<> LucideFileText (• icon) (• file-icon) (• w 15) (• h 15) (• mr 6)
          (= align-y (. Alignment center))
        )
      )
      (<> Label (• flex 1)
        (= text (. #item name))
        (= align-y (. Alignment center))
      )
    )
  )
)

(type + OutlineRow (is Box)
  (prop + item OutlineNode)
  (content
    (<> This (• flex-row) (• flex 1)
      (if (. #item is-group)
        (<> LucideLayers (• icon) (• w 14) (• h 14) (• mr 6)
          (= align-y (. Alignment center))
        )
        (<> Label (• outline-group) (• flex 1)
          (= text (. #item #name))
          (= align-y (. Alignment center))
        )
      )
      (if (not (. #item is-group))
        (<> LucideSpline (• icon) (• w 14) (• h 14) (• mr 6)
          (= align-y (. Alignment center))
        )
        (<> Label (• flex 1)
          (= text (. #item #name))
          (= align-y (. Alignment center))
        )
      )
    )
  )
)

(type + LazyRow (is Box)
  (prop + item String)
  (content
    (<> This (• flex-row) (• flex 1)
      (if (call lazy-has-children #item)
        (<> LucideFolder (• icon) (• folder-icon) (• w 14) (• h 14) (• mr 6)
          (= align-y (. Alignment center))
        )
      )
      (if (not (call lazy-has-children #item))
        (<> LucideCircle (• file-icon) (• w 8) (• h 8) (• mx 3) (• mr 9)
          (= align-y (. Alignment center))
          (= stroke (. Stroke inherit))
          (= stroke-width 2.5)
        )
      )
      (<> Label (• flex 1)
        (= text (call lazy-title #item))
        (= align-y (. Alignment center))
      )
    )
  )
)

(type + ExplorerNode
  (prop + path String)
  (prop + name String)
  (prop + children (? (list ExplorerNode)))
  (fn-do + This _
    (param path _)
    (param name _)
    (param children (? (list ExplorerNode)) (= null))
  )
)

(type + OutlineNode
  (prop + id Size)
  (prop + name String)
  (prop + is-group Bool)
  (prop + parent (? OutlineNode))
  (prop + children (list OutlineNode))
  (fn-do + This _
    (param id _)
    (param name _)
    (param is-group _)
    (param parent (? OutlineNode) (= null))
  )
)

(type + OutlineModel
  (prop + root OutlineNode)
  (blank)
  (prop _ next-id Size (= 1))
  (prop _ shape-count Size (= 0))
  (prop _ group-count Size (= 0))
  (fn-do + This _
    (lazy root (call OutlineNode 0 "Document" true))
    (let background (call add root true "Background"))
    (let ignored-sky (call add background false "Sky"))
    (let ignored-hills (call add background false "Hills"))
    (let figure (call add root true "Figure"))
    (let head (call add figure true "Head"))
    (let ignored-eyes (call add head false "Eyes"))
    (let ignored-smile (call add head false "Smile"))
    (let ignored-body (call add figure false "Body"))
    (let ignored-signature (call add root false "Signature"))
  )
  (fn-do + add OutlineNode
    (param parent OutlineNode)
    (param is-group Bool)
    (param name (? String) (= null))
    (let node (call OutlineNode next-id (?? name (call next-name is-group)) is-group parent))
    (+= next-id 1)
    (+= (. parent children) node)
    (return node)
  )
  (fn-do + next-name String
    (param is-group Bool)
    (if is-group
      (+= group-count 1)
      (return (str "Group " group-count))
    )
    (+= shape-count 1)
    (return (str "Shape " shape-count))
  )
  (fn-do + remove _
    (param node OutlineNode)
    (let parent (. node parent))
    (return-if (if (not parent)))
    (let index (call index-in-parent node))
    (if (!= index null)
      (call (. parent children remove) index)
    )
  )
  (fn-do + move-up _
    (param node OutlineNode)
    (let parent (. node parent))
    (return-if (if (not parent)))
    (let index (call index-in-parent node))
    (return-if (if (or (== index null) (== index 0))))
    (let siblings (. parent children))
    (let previous ([] siblings (- index 1)))
    (= ([] siblings (- index 1)) node)
    (= ([] siblings index) previous)
  )
  (fn-do + key-path (list String)
    (param node OutlineNode)
    (let reversed (list String))
    (let current (? OutlineNode) node)
    (while (and current (. current parent))
      (+= reversed (call outline-key current))
      (= current (. current parent))
    )
    (let result (list String))
    (let index (. reversed length))
    (while (> index 0)
      (-= index 1)
      (+= result ([] reversed index))
    )
    (return result)
  )
  (fn-do _ index-in-parent (? Index)
    (param node OutlineNode)
    (let parent (. node parent))
    (return-if (if (not parent)))
    (let index Index 0)
    (for (in child (. parent children))
      (return-if index (if (== (. child id) (. node id))))
      (+= index 1)
    )
  )
)

(fn-expr _ explorer-children (? (list ExplorerNode))
  (param node ExplorerNode)
  (. node children)
)

(fn-expr _ explorer-key String
  (param node ExplorerNode)
  (. node path)
)

(fn-expr _ explorer-key-path (list String)
  (param ... keys (list String))
  keys
)

(fn-expr _ outline-children (? (list OutlineNode))
  (param node OutlineNode)
  (. node children)
)

(fn-expr _ outline-key String
  (param node OutlineNode)
  (str (. node id))
)

(fn-expr _ lazy-has-children Bool
  (param id String)
  (< (call lazy-depth id) 6)
)

(fn-expr _ lazy-key String
  (param id String)
  id
)

(fn-do _ lazy-depth Size
  (param id String)
  (return-if 0 (if (not (. id length))))
  (let depth Size 1)
  (for (in char id)
    (if (== char '/')
      (+= depth 1)
    )
  )
  (return depth)
)

(fn-expr _ lazy-title String
  (param id String)
  (str "Node " (call (. "." join) (call (. id split) "/")))
)

(fn-expr _ file ExplorerNode
  (param path String)
  (call ExplorerNode path (call explorer-leaf-name path))
)

(fn-expr _ folder ExplorerNode
  (param path String)
  (param ... children (list ExplorerNode))
  (call ExplorerNode path (call explorer-leaf-name path) children)
)

(fn-expr _ explorer-leaf-name String
  (param path String)
  (if-expr (== slash null) path ([] path (..< (+ (as slash Index) 1) (. path length))))
  (where
    (lazy slash (call (. path find-reverse) "/"))
  )
)

(fn-expr _ explorer-fixture ExplorerNode
  (call folder
    (block
      (arg "workspace")
      (arg
        (call folder
          (block
            (arg "docs")
            (arg
              (call folder
                (block
                  (arg "docs/style")
                  (arg (call file "docs/style/agent-brix-style-gui.md"))
                  (arg (call file "docs/style/agent-brix-style-markup.md"))
                )
              )
            )
            (arg (call file "docs/README.md"))
          )
        )
      )
      (arg
        (call folder
          (block
            (arg "examples")
            (arg
              (call folder
                (block
                  (arg "examples/graphics")
                  (arg (call file "examples/graphics/boolean-grid.bx"))
                  (arg (call file "examples/graphics/stroke-grid.bx"))
                  (arg (call file "examples/graphics/vector-scene.bx"))
                )
              )
            )
            (arg
              (call folder
                (block
                  (arg "examples/gui")
                  (arg (call file "examples/gui/column-tree.bx"))
                  (arg (call file "examples/gui/tree-box-showcase.bx"))
                )
              )
            )
          )
        )
      )
      (arg
        (call folder
          (block
            (arg "stdlib")
            (arg
              (call folder
                (block
                  (arg "stdlib/graphics")
                  (arg (call file "stdlib/graphics/network.bx"))
                  (arg (call file "stdlib/graphics/path.bx"))
                )
              )
            )
            (arg
              (call folder
                (block
                  (arg "stdlib/gui")
                  (arg
                    (call folder
                      (block
                        (arg "stdlib/gui/icons")
                        (arg
                          (call folder
                            (block
                              (arg "stdlib/gui/icons/lucide")
                              (arg (call file "stdlib/gui/icons/lucide/chevron-down.bx"))
                              (arg (call file "stdlib/gui/icons/lucide/chevron-right.bx"))
                              (arg (call file "stdlib/gui/icons/lucide/folder.bx"))
                            )
                          )
                        )
                      )
                    )
                  )
                  (arg (call file "stdlib/gui/column-tree.bx"))
                  (arg (call file "stdlib/gui/list-box.bx"))
                  (arg (call file "stdlib/gui/tree-box.bx"))
                )
              )
            )
            (arg
              (call folder
                (block
                  (arg "stdlib/tui")
                  (arg (call file "stdlib/tui/columntree.bx"))
                  (arg (call file "stdlib/tui/treebox.bx"))
                )
              )
            )
          )
        )
      )
      (arg (call file "package.json"))
      (arg (call file "README.md"))
    )
  )
)
