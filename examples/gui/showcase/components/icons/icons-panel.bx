(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vector)
(import /gui)
(import /gui/icons/lucide/bell)
(import /gui/icons/lucide/calendar-days)
(import /gui/icons/lucide/camera)
(import /gui/icons/lucide/cloud-sun)
(import /gui/icons/lucide/coffee)
(import /gui/icons/lucide/compass)
(import /gui/icons/lucide/heart)
(import /gui/icons/lucide/house)
(import /gui/icons/lucide/mail)
(import /gui/icons/lucide/map-pin)
(import /gui/icons/lucide/music)
(import /gui/icons/lucide/rocket)
(import /gui/icons/lucide/search)
(import /gui/icons/lucide/settings)
(import /gui/icons/lucide/sparkles)
(import /gui/icons/lucide/star)

(style IconsTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (rule showcase-shell
    (= font-size 14)
  )
  (blank)
  (rule showcase-header (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 20)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule icon-card (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= font-size 13)
  )
)

(type + IconsPanel (is Box)
  (using IconsTheme)
  (content
    (<> This (• showcase-shell) (• flex-col) (• p 22)
      (<> Box (• showcase-header) (• flex-col) (• h 74) (• px 18) (• py 12)
        (<> Label
          (= text "Vector icon showcase")
        )
        (blank)
        (<> Label (• mt 5)
          (= text "Flow stacks the rows · flex shares each row evenly")
        )
      )
      (blank)
      (<> Box (• icon-grid) (• flow-col) (• flex 1) (• mt 16)
        (<> Box (• icon-row) (• flex-row) (• h 108)
          (<> IconCard (text: "Home")
            (<> LucideHouse (id: home-icon)
              (= stroke "#2563eb")
            )
          )
          (blank)
          (<> IconCard (text: "Search") (• ml 12)
            (<> LucideSearch (id: search-icon)
              (= stroke "#7c3aed")
            )
          )
          (blank)
          (<> IconCard (text: "Bell") (• ml 12)
            (<> LucideBell (id: bell-icon)
              (= stroke "#d97706")
            )
          )
          (blank)
          (<> IconCard (text: "Calendar") (• ml 12)
            (<> LucideCalendarDays (id: calendar-icon)
              (= stroke "#059669")
            )
          )
        )
        (blank)
        (<> Box (• icon-row) (• flex-row) (• h 108) (• mt 12)
          (<> IconCard (text: "Camera")
            (<> LucideCamera (id: camera-icon)
              (= stroke "#db2777")
            )
          )
          (blank)
          (<> IconCard (text: "Heart") (• ml 12)
            (<> LucideHeart (id: heart-icon)
              (= stroke "#e11d48")
            )
          )
          (blank)
          (<> IconCard (text: "Star") (• ml 12)
            (<> LucideStar (id: star-icon)
              (= stroke "#ca8a04")
            )
          )
          (blank)
          (<> IconCard (text: "Compass") (• ml 12)
            (<> LucideCompass (id: compass-icon)
              (= stroke "#0891b2")
            )
          )
        )
        (blank)
        (<> Box (• icon-row) (• flex-row) (• h 108) (• mt 12)
          (<> IconCard (text: "Mail")
            (<> LucideMail (id: mail-icon)
              (= stroke "#4f46e5")
            )
          )
          (blank)
          (<> IconCard (text: "Map pin") (• ml 12)
            (<> LucideMapPin (id: map-pin-icon)
              (= stroke "#dc2626")
            )
          )
          (blank)
          (<> IconCard (text: "Music") (• ml 12)
            (<> LucideMusic (id: music-icon)
              (= stroke "#9333ea")
            )
          )
          (blank)
          (<> IconCard (text: "Settings") (• ml 12)
            (<> LucideSettings (id: settings-icon)
              (= stroke "#94a3b8")
            )
          )
        )
        (blank)
        (<> Box (• icon-row) (• flex-row) (• h 108) (• mt 12)
          (<> IconCard (text: "Sparkles")
            (<> LucideSparkles (id: sparkles-icon)
              (= stroke "#c026d3")
            )
          )
          (blank)
          (<> IconCard (text: "Weather") (• ml 12)
            (<> LucideCloudSun (id: weather-icon)
              (= stroke "#0284c7")
            )
          )
          (blank)
          (<> IconCard (text: "Coffee") (• ml 12)
            (<> LucideCoffee (id: coffee-icon)
              (= stroke "#a16207")
            )
          )
          (blank)
          (<> IconCard (text: "Rocket") (• ml 12)
            (<> LucideRocket (id: rocket-icon)
              (= stroke "#ea580c")
            )
          )
        )
      )
    )
  )
)

(type + IconCard (is Box)
  (prop + name String)
  (fn-do + This _
    (param name _)
  )
  (content
    (<> This (• icon-card) (• flex-col) (• flex 1) (• p 10)
      (+<> VectorImage (• flex 1))
      (blank)
      (<> Label (• h 22) (• mt 5)
        (= text name)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
)
