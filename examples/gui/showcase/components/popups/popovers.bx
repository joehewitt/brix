(import ./popups-panel)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + PopoversSection (is Box)
  (prop + color RGBA (= "#3b82f6"))
  (prop + layer-name _ (= "Background layer"))
  (prop + section-self _ (=> this))
  (content
    (<> This (• flex-col)
      (<> Box (• flow-row)
        (<> DemoCard (text: "Arrows follow the side") (• w 306) (• h 260)
          (= caption
            (call join
              (:stream
                (block
                  (bullet "Each popover prefers a side. Its arrow is drawn on whichever side it actually ")
                  (bullet "lands, including after a flip.")
                )
              )
            )
          )
          (<> Box (• flex-col) (• flex 1)
            (<> Box (• flex-row) (• h 28) (• ml 84)
              (<> Button (text: "Top") (• w 80)
                (= action (=> () :do (call (. top-popover toggle))))
                (<> Popover (id: top-popover)
                  (= placement (call AnchoredPlacement (. Side top) (. AnchorPoint center) 0))
                  (<> Label (text: "Above the button"))
                )
              )
            )
            (<> Box (• flex-row) (• h 28) (• mt 26)
              (<> Button (text: "Left") (• w 80)
                (= action (=> () :do (call (. left-popover toggle))))
                (<> Popover (id: left-popover)
                  (= placement (call AnchoredPlacement (. Side left) (. AnchorPoint center) 0))
                  (<> Label (text: "Left, and flipped if needed"))
                )
              )
              (<> Button (text: "Right") (• w 80) (• ml 62)
                (= action (=> () :do (call (. right-popover toggle))))
                (<> Popover (id: right-popover)
                  (= placement (call AnchoredPlacement (. Side right) (. AnchorPoint center) 0))
                  (<> Label (text: "To the right"))
                )
              )
            )
            (<> Box (• flex-row) (• h 28) (• mt 26) (• ml 84)
              (<> Button (text: "Bottom") (• w 80)
                (= action (=> () :do (call (. bottom-popover toggle))))
                (<> Popover (id: bottom-popover)
                  (<> Label (text: "Below the button"))
                )
              )
            )
          )
        )
        (<> DemoCard (text: "Color picker") (• w 236) (• h 260)
          (= caption "A popover of swatches. Choosing one applies it and closes the popover.")
          (<> Box (• flex-row) (• h 40)
            (<> Box (• swatch) (• w 40) (• h 40)
              (= background-color #color)
            )
            (<> Button (text: "Choose color…") (• w 150) (• ml 12) (• mt 6)
              (= action (=> () :do (call (. picker toggle))))
              (<> Popover (id: picker)
                (for (in row (call showcase-swatch-rows))
                  (<> Box (• flex-row) (• mb 6)
                    (for (in swatch row)
                      (<> SwatchButton (• w 28) (• h 28) (• mr 6)
                        (= section section-self)
                        (= color swatch)
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (<> DemoCard (text: "Native text field in a popup") (• w 286) (• h 260)
          (= caption
            (call join
              (:stream
                (block
                  (bullet "The field is a real AppKit text field. It sits inside the popup panel, so it ")
                  (bullet "layers above everything and receives typing.")
                )
              )
            )
          )
          (<> Label (• h 20)
            (= text (str "Layer: " #layer-name))
          )
          (<> Button (text: "Rename…") (• w 120) (• mt 8)
            (= action (=> () :do (call (. rename toggle))))
            (<> Popover (id: rename) (• w 240)
              (<> Label (• card-title) (• h 20)
                (= text "Rename layer")
              )
              (<> TextInput (id: name-field) (• mt 8)
                (= text #layer-name)
              )
              (<> Box (• flex-row) (• mt 10)
                (<> Button (text: "Cancel") (• flex 1)
                  (= action (=> () :do (call (. rename dismiss))))
                )
                (<> Button (text: "Rename") (• flex 1) (• ml 8)
                  (= action (=> () :do (call apply-rename)))
                )
              )
            )
          )
        )
      )
      (<> Box (• flow-row)
        (<> DemoCard (text: "Shapes and shadows on any box") (• w 790) (• h 196)
          (= caption
            (call join
              (:stream
                (block
                  (bullet "Shapes and drop shadows are ordinary box styles. Bubbles and cards use the GPU ")
                  (bullet "outline and shadow primitives the popups use; the tag is a custom BoxShape that ")
                  (bullet "only describes its path.")
                )
              )
            )
          )
          (<> Box (• flex-row) (• flex 1) (• pt 8)
            (<> Box (• flex-col) (• w 280)
              (<> Box (• flex-row) (• h 34) (• px 12) (• ml 10) (• bg gui-field-color)
                (= shape (call CalloutShape 8 (. Side left) 17))
                (= corner-radius 12)
                (= shadow (call Shadow gui-shadow-color 6 0 2))
                (<> Label (text: "Did the popups land?") (• flex 1))
              )
              (<> Box (• flex-row) (• h 34) (• px 12) (• mt 14) (• ml 70) (• mr 10) (• bg gui-accent-color) (• text gui-accent-text-color) (• items-center)
                (= shape (call CalloutShape 8 (. Side right) 17))
                (= corner-radius 12)
                (= shadow (call Shadow gui-shadow-color 8 0 3))
                (<> Label (text: "Arrows, shadows, all of it.") (• flex 1))
              )
            )
            (for (in level (call showcase-elevations))
              (<> Box (• flex-row) (• w 88) (• h 88) (• ml 22) (• mt 4) (• bg gui-field-color) (• items-center)
                (= align-y (. Alignment start))
                (= corner-radius 14)
                (= shadow (call Shadow $gui-shadow-color (. level blur) 0 (. level y) (. level spread)))
                (<> Label (• flex 1) (• card-caption)
                  (= text (. level title))
                  (= text-alignment (. TextAlignment center))
                )
              )
            )
            (<> Box (• flex-row) (• w 104) (• h 36) (• ml 28) (• mt 30) (• pl 14) (• text "#ffffff")
              (= align-y (. Alignment start))
              (= shape (call ShowcaseTagShape))
              (= background-color "#16a34a")
              (= shadow (call Shadow "#14532d59" 8 0 3))
              (<> Label (text: "Custom path") (• flex 1))
            )
          )
        )
      )
    )
  )
  (fn-do + choose-color _
    (param swatch RGBA)
    (= color swatch)
    (call (. picker dismiss) (. DismissReason chosen))
    (call popups-report this "Color picked from a popover")
  )
  (fn-do + apply-rename _
    (= layer-name (. name-field text))
    (call (. rename dismiss) (. DismissReason chosen))
    (call popups-report this (str "Renamed to “" layer-name "” from a native field inside a popup"))
  )
  (subscribe-for (on event (. name-field submit))
    (call apply-rename)
  )
)

(type + SwatchButton (is Box)
  (prop + section PopoversSection)
  (prop + color RGBA)
  (blank)
  (rule This (• swatch)
    (= focus-mode (. FocusMode press))
  )
  (content
    (<> This
      (= background-color #color)
    )
  )
  (subscribe-for (on event click)
    (call (. section choose-color) color)
    (call (. event cancel))
  )
)

(fn-expr + showcase-swatch-rows (list (list RGBA))
  (bullet (list (call RGBA "#ef4444") (call RGBA "#f97316") (call RGBA "#f59e0b") (call RGBA "#84cc16")))
  (bullet (list (call RGBA "#10b981") (call RGBA "#06b6d4") (call RGBA "#3b82f6") (call RGBA "#6366f1")))
  (bullet (list (call RGBA "#a855f7") (call RGBA "#ec4899") (call RGBA "#78716c") (call RGBA "#111827")))
)

(type + ShowcaseElevation (is (tuple (: title String) (: blur Length) (: y Coord) (: spread Length))))

(fn-expr + showcase-elevations (list ShowcaseElevation)
  (bullet (call ShowcaseElevation "Resting" 4 1 0))
  (bullet (call ShowcaseElevation "Raised" 14 5 0))
  (bullet (call ShowcaseElevation "Floating" 30 12 -2))
)

(type + ShowcaseTagShape (is BoxShape)
  ; ╌╌╌╌╌╌╌╌╌╌ is BoxShape ╌╌╌╌╌╌╌╌╌╌
  (fn-do + path _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (let point (/ (. rect height) 2))
    (let corner 5)
    (call (. canvas move) (+ (. rect x) corner) (. rect y))
    (call (. canvas line) (- (. rect right) point) (. rect y))
    (call (. canvas line) (. rect right) (+ (. rect y) point))
    (call (. canvas line) (- (. rect right) point) (. rect bottom))
    (call (. canvas line) (+ (. rect x) corner) (. rect bottom))
    (call (. canvas curve) (. rect x) (. rect bottom) (. rect x) (. rect bottom) (. rect x) (- (. rect bottom) corner))
    (call (. canvas line) (. rect x) (+ (. rect y) corner))
    (call (. canvas curve) (. rect x) (. rect y) (. rect x) (. rect y) (+ (. rect x) corner) (. rect y))
    (call (. canvas enclose))
  )
)
