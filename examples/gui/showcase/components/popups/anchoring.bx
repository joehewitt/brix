(import ./popups-panel)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + AnchoringSection (is Box)
  (content
    (<> This (• flow-row)
      (<> DemoCard (text: "Anchors in a scroll view") (• w 330) (• h 420)
        (= caption
          (call join
            (:stream
              (block
                (item "Open a row’s details, then scroll. The popover tracks its row and closes once the ")
                (item "row scrolls out of view.")
              )
            )
          )
        )
        (<> Box (• demo-well) (• flex-col) (• flex 1)
          (= overflow-y (. ScrollOverflow auto))
          (for (in index (.. 1 30))
            (<> ScrollRow (• h 34)
              (= index index)
            )
          )
        )
      )
      (<> DemoCard (text: "Placement playground") (• w 560) (• h 420)
        (= caption
          (call join
            (:stream
              (block
                (item "Drag the anchor. The popover stays open and flips or shifts at the edges of the ")
                (item "screen. Drag the window near a screen edge to push it off the window.")
              )
            )
          )
        )
        (<> PlaygroundArea (• flex 1)
          (<> DraggableAnchor (id: anchor) (• absolute) (• w 96) (• h 36)
            (= left (call (. PositionOffset coord) 200))
            (= top (call (. PositionOffset coord) 120))
          )
        )
      )
    )
  )
)

(type + ScrollRow (is Box)
  (prop + index Int)
  (blank)
  (rule This (• pl 12)
    (= border-color gui-border-color)
    (= border-bottom-width 1)
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text (str "Row " index))
      )
      (<> Button (text: "Details") (• w 76) (• mr 6)
        (= align-y (. Alignment center))
        (= action (=> () :do (call (. details toggle))))
        (<> Popover (id: details) (• w 200)
          (<> Label (• card-title) (• h 20)
            (= text (str "Row " index))
          )
          (<> Label (• card-caption) (• h 18)
            (= text "Scroll to watch me follow.")
          )
        )
      )
    )
  )
)

(type + PlaygroundArea (is Box)
  (rule This (• demo-well)
    (= corner-radius 8)
  )
)

(type + DraggableAnchor (is Box)
  (prop + offset Point)
  (prop + side-name _ (= "bottom"))
  (prop + window-draggable _ (=> false))
  (blank)
  (rule This (• bg gui-accent-color) (• text gui-accent-text-color)
    (= corner-radius 18)
    (= cursor (. CursorStyle open-hand))
    (= drag-cursor (. CursorStyle closed-hand))
    (= font-weight (. FontWeight bold))
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text "Drag me")
        (= text-alignment (. TextAlignment center))
      )
      (<> PlaygroundPopover (id: follower) (• w 210))
    )
  )
  (subscribe-for (on event pointer-down)
    (= offset (call Point (- (. event root-point x) (. bounds x)) (- (. event root-point y) (. bounds y))))
    (call (. follower show))
  )
  (subscribe-for (on event pointer-drag)
    (let parent-bounds (?? (?. layout-parent content-bounds) bounds))
    (= left (call (. PositionOffset coord) (- (. event root-point x) (. offset x) (. parent-bounds x))))
    (= top (call (. PositionOffset coord) (- (. event root-point y) (. offset y) (. parent-bounds y))))
  )
)

(type + PlaygroundPopover (is Popover)
  (rule This
    (= popup-stacking (. PopupStacking manual))
    (= outside-press-dismiss false)
  )
  (content
    (<> This
      (<> Label (• card-title) (• h 20)
        (= text (str "Placed on the " (call placement-side-name #placed-side)))
      )
      (<> Label (• card-caption) (• h 36)
        (= text "Prefers the bottom; flips to the top, shifts along the edge.")
      )
      (<> Button (text: "Close") (• mt 8)
        (= action (=> () :do (call dismiss)))
      )
    )
  )
)

(fn-expr + placement-side-name _
  (param side (? Side))
  (match side
    (case (. Side top)
      "top"
    )
    (case (. Side bottom)
      "bottom"
    )
    (case (. Side left)
      "left"
    )
    (case (. Side right)
      "right"
    )
    (default
      "screen"
    )
  )
)
