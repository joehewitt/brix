(import ./popups-panel)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/align-left)
(import /gui/icons/lucide/bold)
(import /gui/icons/lucide/image)
(import /gui/icons/lucide/italic)
(import /gui/icons/lucide/share)
(import /gui/icons/lucide/trash)
(import /gui/icons/lucide/type)
(import /gui/icons/lucide/underline)

(type + HoverSection (is Box)
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row)
        (<> DemoCard (text: "Tooltips") (• w 440) (• h 190)
          (= caption
            (call join
              (:stream
                (block
                  (item "Rest on a tool for a moment. Once one tooltip is showing, moving along the ")
                  (item "toolbar switches instantly; after a pause the delay returns.")
                )
              )
            )
          )
          (<> Box (• flex-row) (• h 40)
            (<> ToolButton (• icon-bold) (• w 40) (• h 40)
              (<> Tooltip (text: "Bold  ⌘B"))
            )
            (<> ToolButton (• icon-italic) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Italic  ⌘I"))
            )
            (<> ToolButton (• icon-underline) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Underline  ⌘U"))
            )
            (<> ToolButton (• icon-align-left) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Align text"))
            )
            (<> ToolButton (• icon-image) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Insert image"))
            )
            (<> ToolButton (• icon-type) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Text style")
                (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint center) 6))
              )
            )
            (<> ToolButton (• icon-share) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Share (below, by request)")
                (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint center) 6))
              )
            )
            (<> ToolButton (• icon-trash) (• w 40) (• h 40) (• ml 4)
              (<> Tooltip (text: "Delete"))
            )
          )
        )
        (<> DemoCard (text: "Hover cards") (• w 440) (• h 190)
          (= caption
            (call join
              (:stream
                (block
                  (item "Hover a person. The card is interactive: move into it and it stays open; its ")
                  (item "button works.")
                )
              )
            )
          )
          (<> Box (• flex-row) (• h 44)
            (for (in person (call showcase-people))
              (<> PersonChip (• w 44) (• h 44) (• mr 10)
                (= person person)
              )
            )
          )
        )
      )
      (<> Box (• flex-row)
        (<> DemoCard (text: "Tooltips never block") (• w 440) (• h 150)
          (= caption
            (call join
              (:stream
                (block
                  (item "Tooltips pass the pointer through and close on any press, so they never steal a ")
                  (item "click from what is under them.")
                )
              )
            )
          )
          (<> Button (text: "Click me through a tooltip") (• w 230)
            (= action
              (=> () :do
                (block
                  (call popups-report this "The click reached the button under the tooltip")
                )
              )
            )
            (<> Tooltip (text: "I sit right on top of the button")
              (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint center) -14))
            )
          )
        )
      )
    )
  )
)

(type + ToolButton (is Box)
  (rule This (• flex-col) (• text gui-muted-text-color)
    (= focus-mode (. FocusMode press))
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
      (• text gui-text-color)
    )
    (blank)
    (rule icon
      (= align-y (. Alignment center))
    )
  )
  (content
    (<> This
      (<> Box (• icon-host) (• flex-row) (• flex 1)
        (= align-x (. Alignment center))
      )
    )
  )
)

(type + ShowcasePerson (is (tuple (: name String) (: role String) (: initials String) (: color RGBA))))

(fn-expr + showcase-people _
  (item (call ShowcasePerson "Ada Lovelace" "Analytical engines" "AL" "#f59e0b"))
  (item (call ShowcasePerson "Grace Hopper" "Compilers" "GH" "#3b82f6"))
  (item (call ShowcasePerson "Alan Kay" "Objects and messages" "AK" "#10b981"))
  (item (call ShowcasePerson "Barbara Liskov" "Abstraction" "BL" "#ef4444"))
)

(type + PersonChip (is Box)
  (prop + person ShowcasePerson)
  (prop + following _ (= false))
  (blank)
  (rule This
    (= corner-radius 22)
    (= color "#ffffff")
    (= font-weight (. FontWeight bold))
  )
  (content
    (<> This (• flex-row)
      (= background-color (. person color))
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text (. person initials))
        (= text-alignment (. TextAlignment center))
      )
      (<> HoverCard (• w 240)
        (<> Box (• flex-row) (• h 40)
          (<> Box (• flex-row) (• w 40) (• h 40)
            (= background-color (. person color))
            (= corner-radius 20)
            (<> Label (• flex 1) (• text "#ffffff")
              (= text (. person initials))
              (= text-alignment (. TextAlignment center))
            )
          )
          (<> Box (• flex-col) (• flex 1) (• ml 10)
            (<> Label (• h 18)
              (= text (. person name))
              (= font-weight (. FontWeight bold))
            )
            (<> Label (• h 16) (• text gui-muted-text-color)
              (= text (. person role))
            )
          )
        )
        (<> Button (• mt 12)
          (= title (if-expr #following "Unfollow" "Follow"))
          (= is-on #following)
          (= action (=> () :do (call toggle-follow)))
        )
      )
    )
  )
  (fn-do + toggle-follow _
    (= following (not following))
    (call popups-report this (str (if-expr following "Following" "Unfollowed") " " (. person name)))
  )
)
