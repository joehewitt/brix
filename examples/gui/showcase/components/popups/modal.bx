(import ./popups-panel)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + ModalSection (is Box)
  (prop + file-count _ (= 3))
  (prop + notification-count _ (= 0))
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row)
        (<> DemoCard (text: "Confirmation") (• w 330) (• h 200)
          (= caption
            (call join
              (:stream
                (block
                  (item "A modal dialog blocks the window, keeps Tab inside, closes with Esc, and ")
                  (item "accepts with Return.")
                )
              )
            )
          )
          (<> Button (• w 170)
            (= title (str "Delete " #file-count " files…"))
            (= action (=> () :do (call (. confirm show))))
          )
          (<> Dialog (id: confirm)
            (= title (str "Delete " #file-count " files?"))
            (<> Label (slot: body) (• w 300) (• card-caption)
              (= text "This removes the files from the project. You can’t undo this action.")
            )
            (<> Box (slot: actions) (• flex-row)
              (<> Box (• flex 1))
              (<> Button (text: "Cancel") (• w 90)
                (= action (=> () :do (call (. confirm dismiss))))
              )
              (<> Button (text: "Delete") (• w 90) (• ml 8)
                (= is-on true)
                (= action (=> () :do (call delete-files)))
              )
            )
          )
        )
        (<> DemoCard (text: "Forms in a dialog") (• w 330) (• h 200)
          (= caption "Menus and selects open above the dialog and stay inside its modal scope.")
          (<> Button (text: "New project…") (• w 170)
            (= action (=> () :do (call (. project show))))
          )
          (<> Dialog (id: project) (text: "New project")
            (<> Box (slot: body) (• flex-col) (• w 300)
              (<> TextInput (id: project-name)
                (= placeholder "Project name")
              )
              (<> Box (• flex-row) (• h 26) (• mt 10)
                (<> Label (• w 80)
                  (= text "Template")
                )
                (<> (of Select String) (• flex 1)
                  (= options (list "Blank" "Document" "Presentation" "Spreadsheet"))
                  (= selected "Blank")
                )
              )
              (<> Box (• flex-row) (• h 26) (• mt 10)
                (<> Label (• w 80)
                  (= text "Location")
                )
                (<> MenuButton (text: "~/Projects") (• flex 1)
                  (<> Menu
                    (<> MenuItem (text: "~/Projects"))
                    (<> MenuItem (text: "~/Desktop"))
                    (<> MenuItem (text: "Other…"))
                  )
                )
              )
            )
            (<> Box (slot: actions) (• flex-row)
              (<> Box (• flex 1))
              (<> Button (text: "Cancel") (• w 90)
                (= action (=> () :do (call (. project dismiss))))
              )
              (<> Button (text: "Create") (• w 90) (• ml 8)
                (= role (. ButtonRole default))
                (= action (=> () :do (call create-project)))
              )
            )
          )
        )
      )
      (<> Box (• flex-row)
        (<> DemoCard (text: "Toasts") (• w 330) (• h 200)
          (= caption
            (call join
              (:stream
                (block
                  (item "Notifications stack in the window corner, never take focus, ignore outside ")
                  (item "clicks, and expire on their own. Click one to dismiss it.")
                )
              )
            )
          )
          (<> Button (text: "Post a notification") (• w 190)
            (= action (=> () :do (call post)))
          )
        )
        (<> DemoCard (text: "Command palette") (• w 330) (• h 200)
          (= caption
            (call join
              (:stream
                (block
                  (item "The command palette is a modal popup centered near the top of the window, with ")
                  (item "a native search field.")
                )
              )
            )
          )
          (<> Button (text: "Open palette  ⌘K") (• w 190)
            (= action (=> () :do (call open-palette)))
          )
        )
      )
      (<> Toaster (id: toaster))
    )
  )
  (fn-do + delete-files _
    (call (. confirm dismiss) (. DismissReason chosen))
    (call popups-report this (str "Deleted " file-count " files"))
    (+= file-count 1)
  )
  (fn-do + create-project _
    (let name (if-expr (. project-name text) (. project-name text) "Untitled"))
    (call (. project dismiss) (. DismissReason chosen))
    (call popups-report this (str "Created project “" name "”"))
  )
  (fn-do + post _
    (+= notification-count 1)
    (call (. toaster post) (str "Notification " notification-count ": saved a copy to the cloud"))
  )
  (fn-do + open-palette _
    (call (?. (call (of ancestor PopupsPanel)) open-palette))
  )
  (subscribe-for (on accepted (. confirm accepted))
    (call delete-files)
  )
  (subscribe-for (on accepted (. project accepted))
    (call create-project)
  )
)
