(import ./popups-panel)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + MenusSection (is Box)
  (prop + show-grid _ (= true))
  (prop + show-rulers _ (= false))
  (prop + alignment _ (= "Left"))
  (prop + fonts (list String) (= (call showcase-font-names)))
  (content
    (<> This (• flex-col)
      (<> MenuBar (• demo-card) (• mb 14)
        (= is-native false)
        (<> MenuBarItem (text: "File")
          (<> Menu
            (<> MenuItem
              (= command new-document-shortcut)
            )
            (<> MenuItem
              (= command open-document-shortcut)
            )
            (<> MenuItem (text: "Open Recent")
              (<> Menu
                (<> MenuItem (text: "Quarterly plan.bx")
                  (= action (=> () :do (call report "File ▸ Open Recent ▸ Quarterly plan")))
                )
                (<> MenuItem (text: "Roadmap.bx")
                  (= action (=> () :do (call report "File ▸ Open Recent ▸ Roadmap")))
                )
                (<> MenuSeparator)
                (<> MenuItem (text: "Clear Menu")
                  (= action (=> () :do (call report "File ▸ Open Recent ▸ Clear Menu")))
                )
              )
            )
            (<> MenuSeparator)
            (<> MenuItem (text: "Export")
              (<> Menu
                (<> MenuItem (text: "PNG Image")
                  (= action (=> () :do (call report "File ▸ Export ▸ PNG")))
                )
                (<> MenuItem (text: "SVG Drawing")
                  (= action (=> () :do (call report "File ▸ Export ▸ SVG")))
                )
                (<> MenuItem (text: "More Formats")
                  (<> Menu
                    (<> MenuItem (text: "PDF Document")
                      (= action (=> () :do (call report "File ▸ Export ▸ More ▸ PDF")))
                    )
                    (<> MenuItem (text: "TIFF Image")
                      (= action (=> () :do (call report "File ▸ Export ▸ More ▸ TIFF")))
                    )
                  )
                )
              )
            )
            (<> MenuItem (text: "Print…")
              (= key (call KeyCombo "Cmd+P"))
              (= is-enabled false)
            )
          )
        )
        (<> MenuBarItem (text: "Edit")
          (<> Menu
            (<> MenuItem
              (= command undo-shortcut)
            )
            (<> MenuItem
              (= command redo-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command cut-shortcut)
            )
            (<> MenuItem
              (= command copy-shortcut)
            )
            (<> MenuItem
              (= command paste-shortcut)
            )
          )
        )
        (<> MenuBarItem (text: "View")
          (<> Menu
            (<> MenuItem (text: "Show Grid")
              (= is-on #show-grid)
              (= action (=> () :do (call toggle-grid)))
            )
            (<> MenuItem (text: "Show Rulers")
              (= is-on #show-rulers)
              (= action (=> () :do (call toggle-rulers)))
            )
            (<> MenuSeparator)
            (<> MenuItem (text: "Appearance")
              (<> Menu
                (<> MenuItem (text: "Light")
                  (= action (=> () :do (call report "View ▸ Appearance ▸ Light")))
                )
                (<> MenuItem (text: "Dark")
                  (= action (=> () :do (call report "View ▸ Appearance ▸ Dark")))
                )
                (<> MenuItem (text: "Match System")
                  (= is-on true)
                  (= action (=> () :do (call report "View ▸ Appearance ▸ Match System")))
                )
              )
            )
          )
        )
      )
      (<> Box (• flow-row) (• flex 1)
        (<> DemoCard (text: "Menu buttons") (• w 276) (• h 170)
          (= caption
            (call join
              (:stream
                (block
                  (item "Click, or press and drag to an item and release. Use ↑ ↓ → ← Return and Esc ")
                  (item "from the keyboard.")
                )
              )
            )
          )
          (<> Box (• flex-row)
            (<> MenuButton (text: (str "Align: " #alignment)) (• w 150)
              (<> Menu
                (for (in choice (list "Left" "Center" "Right" "Justify"))
                  (<> MenuItem
                    (= title choice)
                    (= is-on (== #alignment choice))
                    (= action (=> () :do (call align choice)))
                  )
                )
              )
            )
            (<> MenuButton (text: "Insert") (• w 110) (• ml 10)
              (<> Menu
                (<> MenuItem (text: "Image…")
                  (= action (=> () :do (call report "Insert ▸ Image")))
                )
                (<> MenuItem (text: "Table")
                  (<> Menu
                    (for (in size (list "2 × 2" "3 × 3" "4 × 4" "Custom…"))
                      (<> MenuItem
                        (= title size)
                        (= action (=> () :do (call report (str "Insert ▸ Table ▸ " size))))
                      )
                    )
                  )
                )
                (<> MenuItem (text: "Chart")
                  (= is-enabled false)
                )
              )
            )
          )
        )
        (<> DemoCard (text: "Long menus fit the screen") (• w 276) (• h 170)
          (= caption
            (call join
              (:stream
                (block
                  (item "Forty fonts: the menu is clamped to the space on screen and scrolls, even ")
                  (item "beyond the window.")
                )
              )
            )
          )
          (<> MenuButton (text: "Choose a font") (• w 180)
            (<> Menu
              (for (in font #fonts)
                (<> MenuItem
                  (= title font)
                  (= action (=> () :do (call report (str "Font ▸ " font))))
                )
              )
            )
          )
        )
        (<> DemoCard (text: "Keyboard shortcuts") (• w 276) (• h 170)
          (= caption
            (call join
              (:stream
                (block
                  (item "Edit menu items read their titles and shortcuts from the same KeyShortcut ")
                  (item "commands the window runs. Try ⌘Z.")
                )
              )
            )
          )
          (<> Label (• h 20)
            (= text "The command palette (⌘K) lists them too.")
          )
        )
      )
      (<> KeyShortcut (id: new-document-shortcut) (text: "New Document")
        (= key (call KeyCombo "Cmd+N"))
        (= action (=> () :do (call report "New Document")))
      )
      (<> KeyShortcut (id: open-document-shortcut) (text: "Open…")
        (= key (call KeyCombo "Cmd+O"))
        (= action (=> () :do (call report "Open…")))
      )
      (<> KeyShortcut (id: undo-shortcut) (text: "Undo")
        (= key (call KeyCombo "Cmd+Z"))
        (= action (=> () :do (call report "Undo")))
      )
      (<> KeyShortcut (id: redo-shortcut) (text: "Redo")
        (= key (call KeyCombo "Cmd+Shift+Z"))
        (= action (=> () :do (call report "Redo")))
      )
      (<> KeyShortcut (id: cut-shortcut) (text: "Cut")
        (= key (call KeyCombo "Cmd+X"))
        (= action (=> () :do (call report "Cut")))
      )
      (<> KeyShortcut (id: copy-shortcut) (text: "Copy")
        (= key (call KeyCombo "Cmd+C"))
        (= action (=> () :do (call report "Copy")))
      )
      (<> KeyShortcut (id: paste-shortcut) (text: "Paste")
        (= key (call KeyCombo "Cmd+V"))
        (= action (=> () :do (call report "Paste")))
      )
    )
  )
  (fn-do + report _
    (param text String)
    (call popups-report this text)
  )
  (fn-do + toggle-grid _
    (= show-grid (not show-grid))
    (call report (str "View ▸ Show Grid is " (if-expr show-grid "on" "off")))
  )
  (fn-do + toggle-rulers _
    (= show-rulers (not show-rulers))
    (call report (str "View ▸ Show Rulers is " (if-expr show-rulers "on" "off")))
  )
  (fn-do + align _
    (param choice String)
    (= alignment choice)
    (call report (str "Align ▸ " choice))
  )
)

(fn-expr + showcase-font-names _
  (spread (..< 0 40))
  (pipe *> (str ([] font-families (% each (. font-families length))) " " (+ (/ each (. font-families length)) 1)))
  (pipe |> List)
  (where
    (lazy font-families (call showcase-font-families))
  )
)

(fn-expr _ showcase-font-families (list String)
  (item "Avenir")
  (item "Baskerville")
  (item "Futura")
  (item "Gill Sans")
  (item "Helvetica")
  (item "Menlo")
  (item "Optima")
  (item "Palatino")
)
