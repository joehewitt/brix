(import ./popups-panel)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + FormsSection (is Box)
  (prop + family-name _ (= "Futura"))
  (prop + size-name _ (= "12"))
  (prop + weight-name _ (= "Regular"))
  (content
    (<> This (• flow-row)
      (<> DemoCard (text: "Selects") (• w 276) (• h 250)
        (= caption
          (call join
            (:stream
              (block
                (bullet "The open list lines the chosen row up with the field, then shifts to stay on screen ")
                (bullet "near an edge.")
              )
            )
          )
        )
        (<> FormRow (text: "Family")
          (<> (of Select String) (id: family) (• w 180)
            (= options (list "Avenir" "Baskerville" "Futura" "Helvetica" "Menlo" "Palatino"))
            (= selected #family-name)
          )
        )
        (<> FormRow (text: "Size") (• mt 10)
          (<> (of Select String) (id: size) (• w 180)
            (= options (list "9" "10" "11" "12" "13" "14" "18" "24" "36" "48" "72"))
            (= selected #size-name)
          )
        )
        (<> FormRow (text: "Weight") (• mt 10)
          (<> (of Select String) (id: weight) (• w 180)
            (= options (list "Regular" "Medium" "Bold" "Black"))
            (= selected #weight-name)
          )
        )
      )
      (<> DemoCard (text: "Autocomplete") (• w 276) (• h 250)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Type a city. Suggestions follow the field width, ↑ ↓ and Return pick one, and focus ")
                (bullet "never leaves the native text field.")
              )
            )
          )
        )
        (<> ComboBox (id: city) (• w 260)
          (= placeholder "Search cities")
          (= suggestions (call showcase-cities))
        )
      )
      (<> DemoCard (text: "Nested inside a popover") (• w 276) (• h 250)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Popups can open other popups. The select below lives inside a popover; choosing ")
                (bullet "keeps the popover open.")
              )
            )
          )
        )
        (<> Button (text: "Text settings…") (• w 170)
          (= action (=> () :do (call (. settings toggle))))
          (<> Popover (id: settings) (• w 260)
            (<> Label (• card-title) (• h 20)
              (= text "Text settings")
            )
            (<> FormRow (text: "Case") (• mt 10)
              (<> (of Select String) (• w 140)
                (= options (list "Sentence" "Title" "Upper" "Lower"))
                (= selected "Sentence")
              )
            )
            (<> FormRow (text: "Spacing") (• mt 10)
              (<> (of Select String) (• w 140)
                (= options (list "Tight" "Normal" "Loose"))
                (= selected "Normal")
              )
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. family selection-changed))
    (= family-name (. event value))
    (call popups-report this (str "Family ▸ " (. event value)))
  )
  (subscribe-for (on event (. size selection-changed))
    (= size-name (. event value))
    (call popups-report this (str "Size ▸ " (. event value)))
  )
  (subscribe-for (on event (. weight selection-changed))
    (= weight-name (. event value))
    (call popups-report this (str "Weight ▸ " (. event value)))
  )
  (subscribe-for (on event (. city value-changed))
    (call popups-report this (str "City ▸ " (. event value)))
  )
)

(type + FormRow (is Box)
  (prop + label _ (= ""))
  (fn-do + This _
    (param label _ (= ""))
  )
  (content
    (<> This (• flex-row) (• h 26)
      (<> Label (• w 70)
        (= align-y (. Alignment center))
        (= text #label)
      )
    )
  )
)

