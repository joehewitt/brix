(import ./popups-panel)
(import /graphics/canvas)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /graphics/text)
(import /gui)
(import /math)

(type + CreativeSection (is Box)
  (prop + drops _ (= 0))
  (prop + section-self _ (=> this))
  (content
    (<> This (• flow-row)
      (<> DemoCard (text: "Radial menu") (• w 276) (• h 300)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Right-click in the dark area. A custom Placement centers the popup on the pointer ")
                (bullet "and a custom Layout arranges items on a ring. Press, drag to a slice, and release.")
              )
            )
          )
        )
        (<> Box (• demo-well) (• flex 1)
          (<> RadialMenu
            (<> RadialItem (text: "Copy") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Copy")))
            )
            (<> RadialItem (text: "Paste") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Paste")))
            )
            (<> RadialItem (text: "Undo") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Undo")))
            )
            (<> RadialItem (text: "Redo") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Redo")))
            )
            (<> RadialItem (text: "Share") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Share")))
            )
            (<> RadialItem (text: "Delete") (• w 64) (• h 64)
              (= action (=> () :do (call popups-report this "Radial ▸ Delete")))
            )
          )
        )
      )
      (<> DemoCard (text: "Drag ghost") (• w 276) (• h 300)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Drag a chip. A pointer-transparent popup follows the pointer, even outside the ")
                (bullet "window, and the drop target lights up.")
              )
            )
          )
        )
        (<> Box (• flex-row) (• h 36)
          (for (in chip (list "Photo" "Song" "Note"))
            (<> DragChip (• w 80) (• h 32) (• mr 8)
              (= title chip)
              (= section section-self)
            )
          )
        )
        (<> DropBin (id: bin) (• h 120) (• mt 20)
          (= drops #drops)
        )
      )
      (<> DemoCard (text: "Spotlight tour") (• w 276) (• h 300)
        (= caption
          (call join
            (:stream
              (block
                (bullet "A modal popup paints a dimmed window with a hole around its target, and a popover ")
                (bullet "anchored to a box it does not own explains each step.")
              )
            )
          )
        )
        (<> Box (• flex-row) (• h 30)
          (<> Button (id: tour-first) (text: "Toolbar") (• w 58))
          (<> Button (id: tour-second) (text: "Search") (• w 58) (• ml 8))
          (<> Button (id: tour-third) (text: "Profile") (• w 58) (• ml 8))
        )
        (<> Button (text: "Start tour") (• w 120) (• mt 24)
          (= action (=> () :do (call (. spotlight start) tour-first tour-second tour-third)))
        )
        (<> Spotlight (id: spotlight))
      )
    )
  )
  (fn-do + hover-bin _
    (param point Point)
    (return (call (. bin hover-check) point))
  )
  (fn-do + accept-drop _
    (param title String)
    (+= drops 1)
    (call popups-report this (str "Dropped “" title "” in the bin"))
  )
)

(type + CenterOnPointPlacement (is Placement)
  ; ╌╌╌╌╌╌╌╌╌╌ is Placement ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + place _
    (param request PlacementRequest)
    (call PlacementResult (call Rect x y (. size width) (. size height)))
    (where
      (lazy size (call placement-natural-size (. request popup) (. request boundary)))
      (lazy center (. request anchor top-left))
      (lazy x (call placement-clamp (- (. center x) (/ (. size width) 2)) (. boundary x) (. boundary width) (. size width)))
      (lazy y (call placement-clamp (- (. center y) (/ (. size height) 2)) (. boundary y) (. boundary height) (. size height)))
      (lazy boundary (. request boundary))
    )
  )
)

(type + RadialLayout (is Layout)
  (prop + radius Length)
  (fn-do + This _
    (param radius _ (= 70))
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is Layout ╌╌╌╌╌╌╌╌╌╌
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call Dimensions (+ (* radius 2) 72) (+ (* radius 2) 72))
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (let content (. box content-bounds))
    (let center (. content center))
    (let children (list Box))
    (for (in child (. box active-children))
      (+= children child)
    )
    (let count (. children length))
    (return-if (if (== count 0)))
    (for (in index (..< 0 count))
      (let child ([] children index))
      (let size (. (call (. child measure)) outer-size))
      (let angle (* π (- (/ (* 2.0 index) count) 0.5)))
      (let x (- (+ (. center x) (* (call cos angle) radius)) (/ (. size width) 2)))
      (let y (- (+ (. center y) (* (call sin angle) radius)) (/ (. size height) 2)))
      (call (. child arrange-outer-bounds) (call Rect x y (. size width) (. size height)))
    )
  )
)

(type + RadialMenu (is Popup)
  (rule This (• transient)
    (= focus-mode (. FocusMode keys))
    (= context-trigger true)
    (= outside-press-passes false)
    (= placement (call CenterOnPointPlacement))
    (= layout (call RadialLayout 78))
  )
  (blank)
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint-background _
    (param canvas Canvas)
    (let ring (. bounds center))
    (call (. canvas push))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) $gui-popup-color)
    (call (. canvas circle) (. ring x) (. ring y) (/ (call min (. bounds width) (. bounds height)) 2))
    (= (. canvas fill-color) $gui-border-color)
    (call (. canvas circle) (. ring x) (. ring y) 20)
    (call (. canvas pop))
  )
)

(type + RadialItem (is Box)
  (prop + title _ (= ""))
  (prop + action (? Doer))
  (blank)
  (rule This (• bg gui-field-color)
    (= corner-radius 32)
    (= font-size 12)
    (blank)
    (when-style #is-hover-within
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
  )
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text #title)
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (let callback action)
    (if callback
      (call callback)
    )
    (call (?. (call (of ancestor RadialMenu)) dismiss) (. DismissReason chosen))
    (call (. event cancel))
  )
)

(type + DragChip (is Box)
  (prop + title _ (= ""))
  (prop + section CreativeSection)
  (prop + window-draggable _ (=> false))
  (blank)
  (rule This (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 16)
    (= cursor (. CursorStyle open-hand))
    (= drag-cursor (. CursorStyle closed-hand))
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text #title)
        (= text-alignment (. TextAlignment center))
      )
      (<> DragGhostPopup (id: ghost) (• w 96) (• h 36)
        (= title #title)
      )
    )
  )
  (subscribe-for (on event pointer-drag)
    (if (not (. ghost is-open))
      (call (. ghost show))
    )
    (call (. section hover-bin) (. event root-point))
  )
  (subscribe-for (on event pointer-up)
    (if (. ghost is-open)
      (call (. ghost dismiss))
      (if (call (. section hover-bin) (. event root-point))
        (call (. section accept-drop) title)
      )
    )
    (call (. section hover-bin) (call Point -100000 -100000))
  )
)

(type + DragGhostPopup (is Popup)
  (prop + title _ (= ""))
  (blank)
  (rule This (• passive) (• follow-pointer) (• bg gui-accent-color) (• text gui-accent-text-color)
    (= corner-radius 18)
    (= font-weight (. FontWeight bold))
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text (str "↗ " #title))
        (= text-alignment (. TextAlignment center))
      )
    )
  )
)

(type + DropBin (is Box)
  (prop + drops _ (= 0))
  (prop + is-targeted _ (= false))
  (blank)
  (rule This (• bg gui-well-color) (• text gui-muted-text-color)
    (= border-color gui-border-color)
    (= border-width 2)
    (= corner-radius 12)
    (blank)
    (when-style #is-targeted
      (• bg gui-hover-color)
      (• text gui-text-color)
      (= border-color gui-accent-bright-color)
    )
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text (str "Drop here · " #drops " dropped"))
        (= text-alignment (. TextAlignment center))
      )
    )
  )
  (fn-do + hover-check _
    (param point Point)
    (let targeted (call (. (call presentation-rect bounds) contains) point))
    (if (!= targeted is-targeted)
      (= is-targeted targeted)
    )
    (return targeted)
  )
)

(type + Spotlight (is Popup)
  (prop + step Size (= 0))
  (prop + targets (list Box))
  (prop + titles _ (= (list "Toolbar" "Search" "Profile")))
  (prop + spotlight-self _ (=> this))
  (blank)
  (rule This (• fill-window) (• modal)
    (= popup-stacking (. PopupStacking manual))
  )
  (content
    (<> This
      (<> Popover (id: coach) (• w 240)
        (= popup-stacking (. PopupStacking manual))
        (= outside-press-dismiss false)
        (= escape-dismiss false)
        (<> Label (• card-title) (• h 20)
          (= text (str "Step " (+ #step 1) " of 3: " ([] #titles #step)))
        )
        (<> Label (• card-caption) (• h 36)
          (= text "This popover is anchored to a box it does not own.")
        )
        (<> Box (• flex-row) (• mt 10)
          (<> Button (text: "Skip") (• flex 1)
            (= action (=> () :do (call dismiss)))
          )
          (<> Button (• flex 1) (• ml 8)
            (= title (if-expr (== #step 2) "Done" "Next"))
            (= is-on true)
            (= action (=> () :do (call advance)))
          )
        )
      )
    )
  )
  (fn-do + start _
    (param first Box)
    (param second Box)
    (param third Box)
    (= targets (list first second third))
    (= step 0)
    (call show (. PopupAnchor window))
    (call focus-step)
  )
  (fn-do + advance _
    (if (>= step 2)
      (call dismiss (. DismissReason chosen))
      (call popups-report this "Tour finished")
      (return)
    )
    (+= step 1)
    (call focus-step)
  )
  (fn-do + focus-step _
    (let target ([] targets step))
    (call (. coach dismiss))
    (call (. coach show) (call (. PopupAnchor box) target))
    (call invalidate-paint)
  )
  ; ╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) $gui-scrim-color)
    (call (. canvas begin))
    (call (. (call RoundedRect bounds 0 0 0 0) outline) canvas)
    (if (< step (. targets length))
      (let target ([] targets step))
      (let hole (call (. (call (. target presentation-rect) (. target bounds)) pad) -8))
      (call (. (call RoundedRect hole 12 12 12 12) outline) canvas)
    )
    (call (. canvas end) false (. FillRule even-odd))
    (call (. canvas pop))
  )
)
