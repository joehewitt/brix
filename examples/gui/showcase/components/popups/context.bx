(import ./popups-panel)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)

(type + ContextSection (is Box)
  (prop + canvas-color RGBA (= "#f7f8fb"))
  (content
    (<> This (• flow-row)
      (<> DemoCard (text: "Canvas and shapes") (• w 520) (• h 360)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Right-click the background or a shape. Each shape carries its own menu; the ")
                (bullet "background menu is the fallback.")
              )
            )
          )
        )
        (<> ShapeArea (• flex 1)
          (= background-color #canvas-color)
          (<> ContextMenu
            (<> MenuItem (text: "Paste")
              (= action (=> () :do (call report "Canvas ▸ Paste")))
            )
            (<> MenuItem (text: "Select All")
              (= action (=> () :do (call report "Canvas ▸ Select All")))
            )
            (<> MenuSeparator)
            (<> MenuItem (text: "Background")
              (<> Menu
                (for (in color (list "#f7f8fb" "#fff4e0" "#e8f6ee" "#eaf0ff"))
                  (<> MenuItem
                    (= title color)
                    (= is-on (== #canvas-color (call RGBA color)))
                    (= action (=> () :do (call set-canvas color)))
                  )
                )
              )
            )
          )
          (<> ShapeChip (text: "Circle") (• absolute) (• w 120) (• h 70)
            (= left (call (. PositionOffset coord) 40))
            (= top (call (. PositionOffset coord) 40))
            (= fill "#ffb35c")
          )
          (<> ShapeChip (text: "Square") (• absolute) (• w 120) (• h 70)
            (= left (call (. PositionOffset coord) 220))
            (= top (call (. PositionOffset coord) 90))
            (= fill "#64b5f6")
          )
          (<> ShapeChip (text: "Star") (• absolute) (• w 120) (• h 70)
            (= left (call (. PositionOffset coord) 110))
            (= top (call (. PositionOffset coord) 170))
            (= fill "#81c784")
          )
        )
      )
      (<> DemoCard (text: "Press, drag, release") (• w 330) (• h 360)
        (= caption
          (call join
            (:stream
              (block
                (bullet "Hold the right button (or Control and the left button) over the list, drag onto an ")
                (bullet "item, and release to choose it without a second click.")
              )
            )
          )
        )
        (<> Box (• demo-well) (• flex-col) (• flex 1) (• p 8)
          (for (in row (list "Inbox" "Drafts" "Sent" "Archive" "Trash"))
            (<> ContextRow (• h 30) (• mb 4)
              (= title row)
            )
          )
        )
      )
    )
  )
  (fn-do + report _
    (param text String)
    (call popups-report this text)
  )
  (fn-do + set-canvas _
    (param color String)
    (= canvas-color (call RGBA color))
    (call report (str "Canvas ▸ Background ▸ " color))
  )
)

(type + ShapeArea (is Box))

(type + ShapeChip (is Box)
  (prop + title _ (= ""))
  (prop + fill RGBA (= "#cccccc"))
  (prop + is-locked _ (= false))
  (blank)
  (rule This
    (= corner-radius 12)
    (= color "#1d1d24")
    (= font-weight (. FontWeight bold))
    (blank)
    (when-style #is-hover-within
      (= border-color "#1d1d2466")
      (= border-width 2)
    )
  )
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• flex-row)
      (= background-color #fill)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text (str #title (if-expr #is-locked " 🔒" "")))
        (= text-alignment (. TextAlignment center))
      )
      (<> ContextMenu
        (<> MenuItem (text: "Bring to Front")
          (= action (=> () :do (call report (str title " ▸ Bring to Front"))))
        )
        (<> MenuItem (text: "Send to Back")
          (= action (=> () :do (call report (str title " ▸ Send to Back"))))
        )
        (<> MenuSeparator)
        (<> MenuItem (text: "Fill")
          (<> Menu
            (for (in color (list "#ffb35c" "#64b5f6" "#81c784" "#e57373" "#ba68c8"))
              (<> MenuItem
                (= title color)
                (= is-on (== #fill (call RGBA color)))
                (= action (=> () :do (call recolor color)))
              )
            )
          )
        )
        (<> MenuItem (text: "Lock")
          (= is-on #is-locked)
          (= action (=> () :do (call toggle-lock)))
        )
        (<> MenuSeparator)
        (<> MenuItem (text: "Delete")
          (= is-enabled (not #is-locked))
          (= action (=> () :do (call report (str title " ▸ Delete"))))
        )
      )
    )
  )
  (fn-do + report _
    (param text String)
    (call popups-report this text)
  )
  (fn-do + recolor _
    (param color String)
    (= fill (call RGBA color))
    (call report (str title " ▸ Fill ▸ " color))
  )
  (fn-do + toggle-lock _
    (= is-locked (not is-locked))
    (call report (str title " ▸ " (if-expr is-locked "Locked" "Unlocked")))
  )
)

(type + ContextRow (is Box)
  (prop + title _ (= ""))
  (blank)
  (rule This (• pl 10)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
  )
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text #title)
      )
      (<> ContextMenu
        (<> MenuItem (text: "Open")
          (= action (=> () :do (call report (str title " ▸ Open"))))
        )
        (<> MenuItem (text: "Mark as Read")
          (= action (=> () :do (call report (str title " ▸ Mark as Read"))))
        )
        (<> MenuItem (text: "Move to")
          (<> Menu
            (for (in folder (list "Inbox" "Archive" "Trash"))
              (<> MenuItem
                (= title folder)
                (= action (=> () :do (call report (str title " ▸ Move to ▸ " folder))))
              )
            )
          )
        )
      )
    )
  )
  (fn-do + report _
    (param text String)
    (call popups-report this text)
  )
)
