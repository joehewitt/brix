(import /graphics/color)
(import /graphics/text)
(import /gui)

(style ColorPickerTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (rule showcase-panel (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 14)
  )
  (blank)
  (rule showcase-heading (• text gui-strong-text-color)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule showcase-caption (• text gui-muted-text-color)
    (= font-size 12)
  )
  (blank)
  (rule showcase-swatch
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 10)
  )
  (blank)
  (rule PlaneSlider
    (= corner-radius 10)
  )
)

(type + ColorPickerPanel (is Box)
  (using ColorPickerTheme)
  (prop + chosen _ (= (call RGBA "#e8641c")))
  (prop + gesture _ (= "Drag, or type a hex code"))
  (content
    (<> This (• flex-row) (• p 24)
      (<> Box (• showcase-panel) (• flex-col) (• w 300) (• p 18)
        (<> ColorPicker (id: picker) (• flex 1)
          (= color #chosen)
          (= checker-light $gui-border-color)
          (= checker-dark $gui-field-color)
          (for (on event value-changed)
            (call choose event)
          )
        )
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• ml 24)
        (<> Label (• showcase-heading) (• h 22)
          (= text "Color")
        )
        (<> Label (• showcase-caption) (• h 18) (• mt 4)
          (= text "Drags report each gesture phase")
        )
        (<> Box (• showcase-swatch) (• h 150) (• mt 16)
          (= background (call ColorSwatchPainter #chosen $gui-border-color $gui-field-color))
        )
        (<> Label (• h 22) (• mt 14)
          (= font-size 14)
          (= text (str "#" (call hex-text #chosen) " · " (call opacity-text (. #chosen alpha)) " opacity"))
        )
        (<> Label (• showcase-caption) (• h 18) (• mt 4)
          (= text #gesture)
        )
        (<> Box (• flex-row) (• h 30) (• mt 18)
          (for (in preset (call showcase-presets))
            (<> ColorPresetButton (• w 30) (• h 30) (• mr 6)
              (= preset preset)
              (for (on event click)
                (call apply-preset preset)
                (call (. event cancel))
              )
            )
          )
        )
      )
    )
  )
  (fn-do + choose _
    (param event (of ValueChange RGBA))
    (= chosen (. event value))
    (= gesture (call showcase-phase-label (. event phase)))
  )
  (fn-do + apply-preset _
    (param preset RGBA)
    (= chosen preset)
    (= gesture "Preset assigned")
  )
)

(type + ColorPresetButton (is Box)
  (prop + preset RGBA)
  (blank)
  (rule This (• showcase-swatch)
    (= focus-mode (. FocusMode press))
    (= window-draggable false)
  )
  (content
    (<> This
      (= background (call ColorSwatchPainter #preset $gui-border-color $gui-field-color))
    )
  )
)

(fn-expr _ showcase-presets _
  (item (call RGBA "#e8641c"))
  (item (call RGBA "#2563eb"))
  (item (call RGBA "#16a34a"))
  (item (call RGBA "#f5d90a"))
  (item (call RGBA 0.86 0.15 0.47 0.5))
  (item (call RGBA "#ffffff"))
)

(fn-expr + showcase-phase-label _
  (param phase ValueChangePhase)
  (match phase
    (case= (. ValueChangePhase began)
      "Gesture began"
    )
    (case= (. ValueChangePhase changed)
      "Gesture changing"
    )
    (case= (. ValueChangePhase ended)
      "Gesture ended"
    )
    (default
      "Discrete change"
    )
  )
)
