(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ billion-row-count VirtualCoord (= 1000000000vcoord))
(prop _ billion-row-height VirtualCoord (= 28vcoord))
(prop _ timeline-day-count VirtualCoord (= 1000000000vcoord))
(prop _ timeline-column-width VirtualCoord (= 132vcoord))

(style VirtualListsTheme
  (using GUIDefaultTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (rule billion-toolbar (• bg gui-panel-color)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule billion-status (• text gui-muted-text-color))
  (blank)
  (rule billion-number
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule billion-detail (• text gui-muted-text-color))
  (blank)
  (rule timeline-toolbar (• bg gui-panel-color)
    (= border-color gui-divider-color)
    (= border-top-width 1)
    (= border-bottom-width 1)
  )
  (blank)
  (rule timeline-status (• text gui-muted-text-color))
  (blank)
  (rule day-number
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule day-detail (• text gui-muted-text-color))
  (blank)
  (rule day-bar (• bg "#38bdf8"))
)

(type + VirtualListsPanel (is Box)
  (using VirtualListsTheme)
  (content
    (<> This (• flex-col)
      (<> BillionRows (• flex 1))
      (<> BillionDays (• h 320))
    )
  )
)

(type + BillionRows (is Box)
  (prop + source _ (:= (call VirtualRangeSource billion-row-count)))
  (content
    (<> This (• flex-col)
      (<> Box (• billion-toolbar) (• flex-row) (• h 56) (• px 14) (• py 12)
        (<> Button (id: top-button) (text: "Top") (• w 72))
        (<> Button (id: million-button) (text: "Row 1,000,000") (• ml 8) (• w 128))
        (<> Button (id: middle-button) (text: "Middle") (• ml 8) (• w 80))
        (<> Button (id: bottom-button) (text: "Bottom") (• ml 8) (• w 80))
        (blank)
        (<> TextInput (id: go-to) (• ml 16) (• w 180)
          (= placeholder "Go to row…")
        )
        (blank)
        (<> Label (id: status) (• billion-status) (• flex 1) (• ml 16)
          (= text "Scroll, jump, or type a row number")
        )
      )
      (blank)
      (<> (of VirtualRegion I64) (id: region) (• flex 1) (• bg gui-well-color)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout billion-row-height))
        (= overscan (call VirtualInsets 112vcoord 0vcoord 112vcoord 0vcoord))
        (blank)
        (<> BillionRow (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + jump-to _
    (param address I64)
    (let last (- (as billion-row-count I64) 1))
    (let target (if-expr (< address 0) 0 (if-expr (> address last) last address)))
    (let ignored (call (. region scroll-to-address) target))
  )
  (fn-do + refresh-status _
    (let viewport (. region content-bounds height))
    (= (. status text) (call billion-range-text (. region scroll-y) viewport))
  )
  (subscribe-for (on event (. region scroll-changed))
    (call refresh-status)
  )
  (subscribe-for (on event (. top-button click))
    (call jump-to 0)
  )
  (subscribe-for (on event (. million-button click))
    (call jump-to 999999)
  )
  (subscribe-for (on event (. middle-button click))
    (call jump-to 499999999)
  )
  (subscribe-for (on event (. bottom-button click))
    (call jump-to 999999999)
  )
  (subscribe-for (on event (. go-to submit))
    (let requested (call billion-parse-row (. event text)))
    (if requested
      (call jump-to (- requested 1))
    )
  )
)

(type + BillionRow (is Box)
  (prop + address I64)
  (blank)
  (rule This (• flex-row) (• px 16)
    (= background-color (if-expr (== (% #address 2) 0) $gui-well-color $gui-window-color))
  )
  (content
    (<> This
      (<> Label (• billion-number) (• w 180)
        (= text (str "Row " (call billion-format (+ #address 1))))
      )
      (blank)
      (<> Label (• billion-detail) (• flex 1)
        (= text (call billion-detail-text #address))
      )
    )
  )
)

(fn-expr + billion-detail-text _
  (param address I64)
  (str "Item " (% address 9973) " · shard " (% address 64) " · checksum " (% (* address 2654435761) 1000003))
)

(fn-expr + billion-range-text _
  (param scroll-y F64)
  (param viewport F64)
  (str "Rows " (call billion-format (+ first 1)) "–" (call billion-format last) " of " (call billion-format total))
  (where
    (lazy height (as (as billion-row-height I64) F64))
    (lazy first (as (/ scroll-y height) I64))
    (lazy visible (as (/ viewport height) I64))
    (lazy total (as billion-row-count I64))
    (lazy last (if-expr (< (+ first visible) total) (+ first visible) total))
  )
)

(fn-expr + billion-format String
  (param value I64)
  (case? (< value 1000)
    (str value)
  )
  (default
    (str head "," pad tail)
  )
  (where
    (lazy head (call billion-format (/ value 1000)))
    (lazy tail (% value 1000))
    (lazy pad (if-expr (< tail 10) "00" (if-expr (< tail 100) "0" "")))
  )
)

(fn-do + billion-parse-row (? I64)
  (param text String)
  (let value I64)
  (let digits Size 0)
  (for (in index (..< 0 (. text length)))
    (let char ([] text index))
    (if (and (>= char '0') (<= char '9'))
      (return-if (if (> value 100000000000)))
      (= value (+ (* value 10) (as (- char '0') I64)))
      (+= digits 1)
      (else-if (and (!= char ',') (!= char (char " ")) (!= char '_'))
        (return null)
      )
    )
  )
  (return-if (if (== digits 0)))
  (return value)
)

(type + BillionDays (is Box)
  (prop + source _ (:= (call VirtualRangeSource timeline-day-count)))
  (content
    (<> This (• flex-col)
      (<> Box (• timeline-toolbar) (• flex-row) (• h 56) (• px 14) (• py 12)
        (<> Button (id: start-button) (text: "Start") (• w 80))
        (<> Button (id: middle-button) (text: "Middle") (• ml 8) (• w 80))
        (<> Button (id: end-button) (text: "End") (• ml 8) (• w 80))
        (blank)
        (<> Label (id: status) (• timeline-status) (• flex 1) (• ml 16)
          (= text "Scroll sideways across a billion days")
        )
      )
      (blank)
      (<> (of VirtualRegion I64) (id: region) (• flex 1) (• bg gui-well-color)
        (= source #source)
        (= virtual-layout (call HorizontalFixedLayout timeline-column-width))
        (= overscan (call VirtualInsets 0vcoord 264vcoord 0vcoord 264vcoord))
        (blank)
        (<> DayColumn (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + jump-to _
    (param address I64)
    (let last (- (as timeline-day-count I64) 1))
    (let target (if-expr (< address 0) 0 (if-expr (> address last) last address)))
    (let ignored (call (. region scroll-to-address) target))
  )
  (fn-do + refresh-status _
    (let viewport (. region content-bounds width))
    (= (. status text) (call timeline-range-text (. region scroll-x) viewport))
  )
  (subscribe-for (on event (. region scroll-changed))
    (call refresh-status)
  )
  (subscribe-for (on event (. start-button click))
    (call jump-to 0)
  )
  (subscribe-for (on event (. middle-button click))
    (call jump-to 499999999)
  )
  (subscribe-for (on event (. end-button click))
    (call jump-to 999999999)
  )
)

(type + DayColumn (is Box)
  (prop + address I64)
  (blank)
  (rule This (• flex-col) (• p 10)
    (= background-color (if-expr (< (% #address 7) 5) $gui-field-color $gui-panel-color))
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (content
    (<> This
      (<> Label (• day-number) (• h 22)
        (= text (str "Day " (call timeline-format (+ #address 1))))
      )
      (blank)
      (<> Label (• day-detail) (• h 18)
        (= text (call timeline-weekday #address))
      )
      (blank)
      (<> Box (• flex 1))
      (blank)
      (<> Box (• day-bar) (• h (call timeline-bar-height #address)))
    )
  )
)

(fn-expr + timeline-bar-height _
  (param address I64)
  (as (+ 16 (% (* address 7919) 180)) F64)
)

(fn-expr + timeline-weekday _
  (param address I64)
  (match (% address 7)
    (case= 0
      "Monday"
    )
    (case= 1
      "Tuesday"
    )
    (case= 2
      "Wednesday"
    )
    (case= 3
      "Thursday"
    )
    (case= 4
      "Friday"
    )
    (case= 5
      "Saturday"
    )
    (default
      "Sunday"
    )
  )
)

(fn-expr + timeline-range-text _
  (param scroll-x F64)
  (param viewport F64)
  (str "Days " (call timeline-format (+ first 1)) "–" (call timeline-format last) " of " (call timeline-format total))
  (where
    (lazy width (as (as timeline-column-width I64) F64))
    (lazy first (as (/ scroll-x width) I64))
    (lazy visible (as (/ viewport width) I64))
    (lazy total (as timeline-day-count I64))
    (lazy last (if-expr (< (+ first visible) total) (+ first visible) total))
  )
)

(fn-expr + timeline-format String
  (param value I64)
  (case? (< value 1000)
    (str value)
  )
  (default
    (str head "," pad tail)
  )
  (where
    (lazy head (call timeline-format (/ value 1000)))
    (lazy tail (% value 1000))
    (lazy pad (if-expr (< tail 10) "00" (if-expr (< tail 100) "0" "")))
  )
)
