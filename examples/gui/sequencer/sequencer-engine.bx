(import ./sequencer-groove)
(import /math)
(import /media/audio-output)
(import /media/mixer)
(import /media/synth)
(import /media/wave-file)
(import /time/duration)
(import /units)
(blank)
(prop _ lead Seconds (= 40ms))
(prop _ lookahead Seconds (= 90ms))
(prop _ bounce-bars _ (= 4))
(prop _ bounce-tail Seconds (= 2s))
(prop _ bounce-chunk I64 (= 2048))

(type + StepStart (is (tuple (: frame I64) (: step Index))))

(type + Cue (is (tuple (: frame I64) (: note Note))))

(type + StepClock
  (prop + groove Groove)
  (prop + rate F64)
  (prop + frame F64)
  (prop + step Index (= 0))
  (fn-do + This _
    (param groove _)
    (param rate _)
    (param frame _)
  )
  (fn-do + advance StepStart
    (let start (call StepStart (as (+ frame (call (. groove offset) step rate)) I64) (% step step-count)))
    (+= frame (call (. groove step-frames) rate))
    (+= step 1)
    (return start)
  )
)

(type + Sequencer
  (implements Closable)
  (prop + groove Groove)
  (prop + bank SoundBank)
  (prop + mixer Mixer)
  (prop + playhead (? Index))
  (prop + is-unavailable _ (= false))
  (prop _ output (? AudioOutput))
  (prop _ clock (? StepClock))
  (prop _ starts (list StepStart))
  (fn-do + This _
    (param groove _)
    (lazy bank (call sound-bank groove))
    (lazy mixer (call Mixer bank))
  )
  (fn-expr + rate F64 :get
    (. bank rate)
  )
  (fn-do + start _
    (return-if (if (not (call is-open))))
    (blank)
    (= clock (call StepClock groove rate (+ (as (. mixer frames) F64) (* (as lead F64) rate))))
  )
  (fn-do + stop _
    (= clock null)
    (call (. starts clear))
    (= playhead null)
  )
  (fn-do + schedule _
    (let running clock)
    (return-if (if (not running)))
    (blank)
    (let horizon (+ (as (. mixer frames) F64) (* (as lookahead F64) rate)))
    (while (< (. running frame) horizon)
      (let start (call (. running advance)))
      (for (in note (call (. groove notes) (. start step)))
        (call (. mixer play) (. note voice) (. note level) 0 (. note pitch) (. start frame))
      )
      (+= starts start)
    )
  )
  (fn-do + follow _
    (let heard (?? (?. output frames-heard) 0))
    (while (and (> (. starts length) 0) (<= (. (. starts head) frame) heard))
      (= playhead (. (call (. starts pop-first)) step))
    )
  )
  (fn-do + audition _
    (param track Track)
    (param at Index)
    (let note (call (. track note) at (. groove scale)))
    (if (and note (call is-open))
      (call (. mixer play) (. note voice) (. note level) 0 (. note pitch))
    )
  )
  (fn-do + listen _
    (param samples ([] F64))
    (call (?. output listen) samples)
  )
  (fn-do + bounce String
    (param path String)
    (let cues (call List (call score)))
    (let ending (as (+ (* (as (* bounce-bars step-count) F64) (call (. groove step-frames) rate)) (* (as bounce-tail F64) rate)) I64))
    (let sounds bank)
    (let outcome
      (call (of await String)
        (=> ()
          (match (catch (call write-score sounds cues ending path))
            (case (: seconds F64)
              (str "Saved " (call (. seconds places) 1) " seconds to " path)
            )
            (case (: problem Error)
              (str "Could not save " path ": " (. problem message))
            )
          )
        )
      )
    )
    (return (?? outcome (str "Could not save " path)))
  )
  (fn-do _ score (stream Cue)
    (let step-frames (call (. groove step-frames) rate))
    (for (in at (..< 0 (* bounce-bars step-count)))
      (let frame (as (+ (* (as at F64) step-frames) (call (. groove offset) at rate)) I64))
      (for (in note (call (. groove notes) (% at step-count)))
        (yield (call Cue frame note))
      )
    )
  )
  (fn-do + close _
    (call (?. output close))
    (= output null)
    (call (. mixer cues close))
  )
  (fn-do _ is-open Bool
    (return-if false (if is-unavailable))
    (return-if true (if output))
    (blank)
    (= output
      (call AudioOutput mixer
        (block
          (on-error (: problem Error)
            (= is-unavailable true)
            (return false)
          )
        )
      )
    )
    (return true)
  )
)

(fn-do + sound-bank SoundBank
  (param groove Groove)
  (let bank (call SoundBank))
  (for (in track (. groove tracks))
    (= (. track voice) (call (. bank add) (. track patch)))
  )
  (return bank)
)

(fn-do _ write-score F64 (?! Error)
  (param bank SoundBank)
  (param cues (list Cue))
  (param ending I64)
  (param path String)
  (let mixer (call Mixer bank))
  (let tape (use (call WaveWriter path (. bank rate))))
  (for (in cue cues)
    (call record mixer tape (. cue frame))
    (call (. mixer play) (. cue note voice) (. cue note level) 0 (. cue note pitch))
  )
  (call record mixer tape ending)
  (return (. tape seconds))
)

(fn-do _ record _
  (param mixer Mixer)
  (param tape WaveWriter)
  (param until I64)
  (while (< (. mixer frames) until)
    (let count (call min (- until (. mixer frames)) bounce-chunk))
    (call (. mixer render) (. tape buffer) count)
    (call (. tape add-frames) count)
  )
)
