(import ./sequencer-engine)
(import ./sequencer-groove)
(import ./sequencer-theme)
(import /graphics/color)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ drag-reach _ (= 7.0))

(type + TrackRow (is Box)
  (using SequencerTheme)
  (prop + sequencer Sequencer)
  (prop + track Track)
  (content
    (<> This (• track-row)
      (<> Toggle (• track-name) (• flex-row) (• items-center)
        (= is-on (not (. #track #is-muted)))
        (for (on event value-changed)
          (= (. track is-muted) (not (. event value)))
        )
        (<> Box (• track-dot) (• bg (. track color)))
        (<> Label
          (= text (. track name))
        )
      )
      (<> Box (• pad-row)
        (for (in at (..< 0 step-count))
          (<> StepPad
            (= sequencer sequencer)
            (= track track)
            (= step ([] (. track steps) at))
            (= at at)
            (= is-current (== (. sequencer #playhead) at))
          )
        )
      )
    )
  )
)

(type + StepPad (is Box)
  (using SequencerTheme)
  (prop + sequencer Sequencer)
  (prop + track Track)
  (prop + step Step)
  (prop + at Index)
  (prop + is-current _ (= false))
  (prop + is-lit _ (= (. #step #is-on)))
  (prop + is-muted _ (= (. #track #is-muted)))
  (prop + is-hit _ (= (and #is-current #is-lit (not #is-muted))))
  (prop + is-beat-start _ (= (and (> #at 0) (== (% #at steps-per-beat) 0))))
  (prop + fill _ (= (* 100% (/ (as (+ (. #step #level) 1) F64) (+ top-level 1)))))
  (prop _ is-pressed _ (= false))
  (prop _ press-y _ (= 0.0))
  (prop _ press-level _ (= 0))
  (prop _ has-dragged _ (= false))
  (content
    (<> This (• step-pad) (• bg (call (. (. track color) with-alpha) 16%))
      (if #is-lit
        (<> Box (• pad-fill) (• bg (. track color))
          (= min-height (call (. SizeSpec percent) #fill))
          (= max-height (call (. SizeSpec percent) #fill))
        )
      )
      (<> Box (• pad-glow))
      (if (and (. track is-tonal) #is-lit)
        (<> Label (• pad-note)
          (= text (call note-name (. sequencer groove #scale) (. #step #level)))
        )
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (= is-pressed true)
      (= press-y (. event point y))
      (= press-level (. step level))
      (= has-dragged false)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-drag)
    (if is-pressed
      (let lift (as (call round (/ (- press-y (. event point y)) drag-reach)) Int))
      (if (or has-dragged (!= lift 0))
        (= has-dragged true)
        (call lift-to (call clamp (+ press-level lift) 0 top-level))
      )
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-up)
    (if is-pressed
      (if (not (or has-dragged (. event is-interrupted)))
        (call toggle)
      )
      (= is-pressed false)
      (call (. event cancel))
    )
  )
  (fn-do _ toggle _
    (= (. step is-on) (not (. step is-on)))
    (call (. sequencer audition) track at)
  )
  (fn-do _ lift-to _
    (param level Int)
    (return-if (if (and (. step is-on) (== level (. step level)))))
    (blank)
    (= (. step is-on) true)
    (= (. step level) level)
    (call (. sequencer audition) track at)
  )
)
