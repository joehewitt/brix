(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop + pad-height _ (= 40.0))
(prop + pad-gap _ (= 5.0))
(prop + beat-gap _ (= 12.0))
(prop + track-name-width _ (= 112.0))

(style SequencerTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (prop + sequencer-backdrop RGBA (= (call RGBA "#0e0f14")))
  (prop + sequencer-well RGBA (= (call RGBA "#ffffff0a")))
  (prop + sequencer-current RGBA (= (call RGBA "#ffffff1c")))
  (prop + sequencer-hit RGBA (= (call RGBA "#ffffffa6")))
  (prop + pad-release Motion (= (call ease-out 480ms)))
  (blank)
  (style-domains sequencer-backdrop (domain paint))
  (style-domains sequencer-well (domain paint))
  (style-domains sequencer-current (domain paint))
  (style-domains sequencer-hit (domain paint))
  (blank)
  (rule sequencer-stage (• flex-col) (• flex 1) (• px 22) (• pt 18) (• pb 18) (• bg sequencer-backdrop)
    (= gap 10)
  )
  (blank)
  (rule sequencer-tracks (• flex-col) (• flex 1)
    (= gap 8)
  )
  (blank)
  (rule track-row (• flex-row) (• items-center)
    (= gap 14)
  )
  (blank)
  (rule track-name (• w track-name-width) (• h 30)
    (= motion gui-motion-quick)
    (blank)
    (when-style (not #is-on)
      (= opacity 40%%)
    )
    (blank)
    (rule Label (• text gui-strong-text-color)
      (= font-size 13)
    )
  )
  (blank)
  (rule track-dot (• w 8) (• h 8) (• mr 8)
    (= corner-radius 4)
  )
  (blank)
  (rule pad-row (• flex-row) (• flex 1)
    (= gap pad-gap)
  )
  (blank)
  (rule step-pad (• flex-col) (• justify-end) (• flex 1) (• h pad-height)
    (= corner-radius 7)
    (= cursor (. CursorStyle pointing-hand))
    (= motion gui-motion-quick)
    (blank)
    (when-style #is-beat-start
      (= margin-left beat-gap)
    )
    (blank)
    (when-style #is-hovered
      (= scale 1.06)
    )
    (blank)
    (when-style #is-muted
      (= opacity 35%%)
    )
    (blank)
    (when-style #is-current
      (rule pad-glow (• bg sequencer-current)
        (= motion instant)
      )
    )
    (blank)
    (when-style #is-hit
      (= scale 1.1)
      (= motion instant)
      (rule pad-glow (• bg sequencer-hit)
        (= motion instant)
      )
    )
  )
  (blank)
  (rule pad-fill
    (= corner-radius 7)
    (= (. motion size) gui-motion-smooth)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= scale 0.6)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= scale 0.6)
    )
  )
  (blank)
  (rule pad-glow (• absolute) (• cover .parent)
    (= corner-radius 7)
    (= motion pad-release)
  )
  (blank)
  (rule pad-note (• absolute) (• cover .parent) (• text gui-strong-text-color)
    (= font-size 11)
    (= font-weight (. FontWeight semibold))
    (= text-alignment (. TextAlignment center))
    (= align-y (. Alignment center))
  )
  (blank)
  (rule spectrum-well (• h 116) (• bg sequencer-well)
    (= corner-radius 12)
  )
  (blank)
  (rule tempo-label (• text gui-muted-text-color) (• w 66) (• pl 10)
    (= font-size 12)
    (= align-y (. Alignment center))
  )
  (blank)
  (rule sequencer-status (• text gui-muted-text-color) (• px 8)
    (= font-size 12)
    (= align-y (. Alignment center))
  )
)

(style SequencerLightTheme (is SequencerTheme) (for light)
  (prop + sequencer-backdrop _ (= (call RGBA "#f4f2ed")))
  (prop + sequencer-well _ (= (call RGBA "#0000000a")))
  (prop + sequencer-current _ (= (call RGBA "#00000014")))
)

(style SequencerStillTheme (is SequencerTheme) (for reduce-motion)
  (prop + pad-release _ (= (call ease-out 120ms)))
)
