(import ./sequencer-engine)
(import ./sequencer-grid)
(import ./sequencer-groove)
(import ./sequencer-spectrum)
(import ./sequencer-theme)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/dices)
(import /gui/icons/lucide/download)
(import /gui/icons/lucide/eraser)
(import /gui/icons/lucide/play)
(import /gui/icons/lucide/square)
(import /math)
(import /time/duration)
(import /time/timer)
(import /units)
(blank)
(prop _ bounce-path _ (= "sequencer.wav"))
(prop _ scales _ (= (list (. Scale minor) (. Scale dorian) (. Scale major) (. Scale pentatonic))))
(prop _ schedule-interval _ (= 10ms))

(type + SequencerWindow (is Window)
  (using SequencerTheme)
  (prop + sequencer Sequencer)
  (prop + groove _ (= (. #sequencer groove)))
  (prop + status _ (= ""))
  (event + toggles Bool)
  (prop + transport _
    (machine
      (state is-stopped
        (then is-playing (trigger on toggles))
      )
      (blank)
      (state is-playing
        (lazy ticker (call Timer schedule-interval))
        (do
          (call (. sequencer start))
        )
        (blank)
        (finally
          (call (. sequencer stop))
        )
        (blank)
        (for (on elapsed ticker)
          (call (. sequencer schedule))
        )
        (for (on tick frames)
          (call (. sequencer follow))
        )
        (blank)
        (then is-stopped (trigger on toggles))
      )
    )
  )
  (prop + is-playing _ (= (is #transport .is-playing)))
  (content
    (<> This (• flex-col)
      (= title "Sequencer")
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= size (call Dimensions 1180 600))
      (= state-key "sequencer")
      (blank)
      (<> Toolbar
        (= is-title-bar true)
        (<> ToolbarTitle (text: "Sequencer"))
        (<> ToolbarGroup
          (if #is-playing
            (<> ToolbarButton (• icon-square)
              (= is-on true)
              (= action (=> () :do (<- toggles true)))
            )
            (else
              (<> ToolbarButton (• icon-play)
                (= action (=> () :do (<- toggles true)))
              )
            )
          )
        )
        (<> ToolbarGroup
          (<> Label (• tempo-label)
            (= text (str (as (call round (as (. #groove #tempo) F64)) Int) " BPM"))
          )
          (<> Slider (• w 120)
            (= minimum (as slowest-tempo F64))
            (= maximum (as fastest-tempo F64))
            (= step 1)
            (= value (as (. #groove #tempo) F64))
            (for (on event value-changed)
              (= (. groove tempo) (as (. event value) BeatsPerMinute))
            )
          )
        )
        (<> ToolbarGroup
          (<> Label (• tempo-label)
            (= text (str "Swing " (as (call round (* (as (. #groove #swing) F64) 100)) Int) "%"))
          )
          (<> Slider (• w 90)
            (= maximum (as widest-swing F64))
            (= step 0.01)
            (= value (as (. #groove #swing) F64))
            (for (on event value-changed)
              (= (. groove swing) (as (. event value) Ratio))
            )
          )
        )
        (<> ToolbarGroup
          (<> (of SegmentedControl Scale)
            (= selected (. #groove #scale))
            (for (on event selection-changed)
              (= (. groove scale) (. event value))
            )
            (for (in scale scales)
              (<> (of Segment Scale) (text: (. scale title))
                (= value scale)
              )
            )
          )
        )
        (<> ToolbarSpace)
        (<> Label (• sequencer-status)
          (= text (if-expr (. #sequencer #is-unavailable) "Sound unavailable" #status))
        )
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-dices)
            (= action (=> () :do (call (. groove spark))))
            (<> Tooltip
              (= text "New groove")
            )
          )
          (<> ToolbarButton (• icon-eraser)
            (= action (=> () :do (call (. groove clear))))
            (<> Tooltip
              (= text "Clear")
            )
          )
          (<> ToolbarButton (• icon-download)
            (= action (=> () :do (do-new (inline (call bounce)))))
            (<> Tooltip
              (= text (str "Save four bars to " bounce-path))
            )
          )
        )
      )
      (blank)
      (<> Box (• sequencer-stage)
        (<> Box (• sequencer-tracks)
          (for (in track (. groove tracks))
            (<> TrackRow
              (= sequencer sequencer)
              (= track track)
            )
          )
        )
        (<> SpectrumView (• spectrum-well)
          (= sequencer sequencer)
          (= is-live #is-playing)
        )
      )
      (blank)
      (<> KeyShortcut (text: "Play")
        (= key .space)
        (= repeat false)
        (= action (=> () :do (<- toggles true)))
      )
    )
  )
  (fn-do _ bounce _
    (= status (str "Saving " bounce-path "…"))
    (= status (call (. sequencer bounce) bounce-path))
  )
)
