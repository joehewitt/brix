(import ./sequencer-groove)
(import /graphics/color)
(import /media/synth)
(import /time/duration)
(import /units)

(fn-expr + sequencer-groove Groove
  (<> Groove
    (<> Track (text: "Kick")
      (= color (call RGBA "#ff5d5d"))
      (= patch (call kick))
      (= steps (call steps-from "7...7...7...7..5"))
    )
    (<> Track (text: "Snare")
      (= color (call RGBA "#ff9a3c"))
      (= pulse 2)
      (= anchor 4)
      (= patch (call snare))
      (= steps (call steps-from ".......2.....3.."))
    )
    (<> Track (text: "Clap")
      (= color (call RGBA "#ffd23f"))
      (= pulse 2)
      (= anchor 4)
      (= patch (call clap))
      (= steps (call steps-from "....7.......7..."))
    )
    (<> Track (text: "Hat")
      (= color (call RGBA "#3ddc97"))
      (= pulse 8)
      (= patch (call closed-hat))
      (= steps (call steps-from "2.6.2.6.2.6.2.63"))
    )
    (<> Track (text: "Open hat")
      (= color (call RGBA "#2ec4d6"))
      (= pulse 2)
      (= anchor 2)
      (= patch (call open-hat))
      (= steps (call steps-from "..............5."))
    )
    (<> Track (text: "Bass")
      (= color (call RGBA "#8b7bff"))
      (= is-tonal true)
      (= pulse 5)
      (= patch (call bass))
      (= steps (call steps-from "..0...0..2.0..4."))
    )
    (<> Track (text: "Pluck")
      (= color (call RGBA "#e36bff"))
      (= is-tonal true)
      (= pulse 6)
      (= patch (call pluck))
      (= steps (call steps-from "4..2..4...7..5.."))
    )
    (<> Track (text: "Bell")
      (= color (call RGBA "#5aa9ff"))
      (= is-tonal true)
      (= pulse 3)
      (= patch (call bell))
      (= steps (call steps-from "........4......."))
    )
  )
)

(fn-expr _ kick SoundPatch
  (<> SoundPatch (text: "kick")
    (= polyphony 2)
    (<> SoundLayer (• sine)
      (= pitch 150hz)
      (= pitch-end 46hz)
      (= glide 28ms)
      (= attack 1ms)
      (= decay 420ms)
      (= level 82%)
      (= reverb 0%)
    )
    (<> SoundLayer (• white-noise) (• high-pass)
      (= cutoff 3khz)
      (= attack 1ms)
      (= decay 9ms)
      (= level 14%)
      (= reverb 0%)
    )
  )
)

(fn-expr _ snare SoundPatch
  (<> SoundPatch (text: "snare")
    (= polyphony 2)
    (<> SoundLayer (• triangle)
      (= pitch 200hz)
      (= pitch-end 165hz)
      (= glide 40ms)
      (= attack 1ms)
      (= decay 110ms)
      (= level 40%)
      (= reverb 12%)
    )
    (<> SoundLayer (• white-noise) (• high-pass)
      (= cutoff 1800hz)
      (= attack 1ms)
      (= decay 170ms)
      (= level 34%)
      (= reverb 22%)
    )
  )
)

(fn-expr _ clap SoundPatch
  (<> SoundPatch (text: "clap")
    (= polyphony 2)
    (<> SoundLayer (• white-noise) (• band-pass)
      (= cutoff 1400hz)
      (= attack 1ms)
      (= decay 9ms)
      (= echoes 2)
      (= echo-gap 8ms)
      (= level 42%)
      (= reverb 25%)
    )
    (<> SoundLayer (• white-noise) (• band-pass)
      (= cutoff 1200hz)
      (= delay 26ms)
      (= attack 1ms)
      (= decay 150ms)
      (= level 40%)
      (= reverb 35%)
    )
  )
)

(fn-expr _ closed-hat SoundPatch
  (<> SoundPatch (text: "hat")
    (= polyphony 3)
    (= level-spread 8%)
    (<> SoundLayer (• white-noise) (• high-pass)
      (= cutoff 8khz)
      (= attack 1ms)
      (= decay 45ms)
      (= level 24%)
      (= pan 18%)
      (= reverb 8%)
    )
  )
)

(fn-expr _ open-hat SoundPatch
  (<> SoundPatch (text: "open hat")
    (= polyphony 2)
    (<> SoundLayer (• white-noise) (• high-pass)
      (= cutoff 7khz)
      (= attack 2ms)
      (= decay 340ms)
      (= level 18%)
      (= pan -18%)
      (= reverb 18%)
    )
  )
)

(fn-expr _ bass SoundPatch
  (<> SoundPatch (text: "bass")
    (= polyphony 2)
    (<> SoundLayer (• saw) (• low-pass)
      (= pitch 55hz)
      (= cutoff 1500hz)
      (= cutoff-end 240hz)
      (= sweep-time 110ms)
      (= resonance 1.6)
      (= attack 3ms)
      (= decay 360ms)
      (= level 34%)
      (= reverb 4%)
    )
    (<> SoundLayer (• sine)
      (= pitch 55hz)
      (= attack 3ms)
      (= decay 380ms)
      (= level 30%)
      (= reverb 0%)
    )
  )
)

(fn-expr _ pluck SoundPatch
  (<> SoundPatch (text: "pluck")
    (= polyphony 4)
    (<> SoundLayer (• square) (• low-pass)
      (= pitch 220hz)
      (= cutoff 3200hz)
      (= cutoff-end 600hz)
      (= sweep-time 140ms)
      (= attack 2ms)
      (= decay 320ms)
      (= echoes 2)
      (= echo-gap 200ms)
      (= echo-level 40%)
      (= level 15%)
      (= pan 22%)
      (= reverb 30%)
    )
  )
)

(fn-expr _ bell SoundPatch
  (<> SoundPatch (text: "bell")
    (= polyphony 3)
    (<> SoundLayer (• sine)
      (= pitch 440hz)
      (= attack 3ms)
      (= decay 1600ms)
      (= fm-ratio 3.5)
      (= fm-depth 1.3)
      (= fm-depth-end 0.15)
      (= level 15%)
      (= pan -24%)
      (= reverb 45%)
    )
  )
)
