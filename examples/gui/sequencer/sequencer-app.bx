; A step sequencer. Eight tracks of drums and synths loop over sixteen steps: click a pad to
; turn it on, and drag it up or down to change how hard it hits or which note it plays. Space
; plays and stops, the dice deal a new groove, and the download button saves four bars to
; sequencer.wav in the working directory. Notes are scheduled a little ahead on the audio clock,
; so each one lands on its exact sample. It needs macOS and a sound output.
(import ./sequencer-engine)
(import ./sequencer-kit)
(import ./sequencer-window)
(import /gui)
(import /lang/product/mac-app)
(blank)

(main
  (let sequencer (use (call Sequencer (call sequencer-groove))))
  (blank)
  (<> MacApp
    (= id "com.yumi.sequencer")
    (= name "Sequencer")
  )
  (blank)
  (<> App
    (<> SequencerWindow
      (= sequencer sequencer)
    )
  )
)
