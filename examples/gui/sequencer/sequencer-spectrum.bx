(import ./sequencer-engine)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /gui)
(import /math)
(import /media/spectrum)
(import /media/synth)
(import /stream/aggregate)
(import /time/duration)
(import /units)
(blank)
(prop _ window-size _ (= 1024))
(prop _ band-count _ (= 56))
(prop _ lowest-band Hertz (= 40hz))
(prop _ highest-band Hertz (= 16khz))
(prop _ quietest _ (= -66.0))
(prop _ fall-rate _ (= 1.4))
(prop _ silence _ (= 0.01))
(prop _ bar-gap _ (= 3.0))

(type + SpectrumView (is Box)
  (prop + sequencer Sequencer)
  (prop + is-live _ (= false))
  (prop _ is-ringing _ (= false))
  (prop _ samples _ (= ([] F64 window-size)))
  (prop _ spectrum _ (= (call SoundSpectrum window-size)))
  (prop _ levels _ (= ([] F64 band-count)))
  (subscribe-for (on tick frames (whenever (or #is-live #is-ringing)))
    (call listen (. tick delta))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let width (/ (- (. area width) (* bar-gap (- band-count 1))) band-count))
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (for (in band (..< 0 band-count))
        (let level ([] levels band))
        (let height (call max width (* level (. area height))))
        (let x (+ (. area x) (* band (+ width bar-gap))))
        (let bar (call Rect x (- (. area bottom) height) width height))
        (= (. canvas fill-color) (call band-color band level))
        (call (. canvas begin))
        (call (. (call RoundedRect bar (/ width 2) (/ width 2) (/ width 2) (/ width 2)) outline) canvas)
        (call (. canvas end))
      )
    )
  )
  (fn-do _ listen _
    (param delta Nanoseconds)
    (call (. sequencer listen) samples)
    (let heard (call (. spectrum magnitudes) samples 0))
    (let fall (* fall-rate (as (as delta Seconds) F64)))
    (for (in band (..< 0 band-count))
      (= ([] levels band) (call max (call band-level heard band (. sequencer rate)) (- ([] levels band) fall)))
    )
    (= is-ringing (> (call max (in each levels)) silence))
    (call invalidate-paint)
  )
)

(fn-expr _ band-level F64
  (param heard ([] F64))
  (param band Index)
  (param rate F64)
  (call clamp (- 1 (/ (call decibels loudest) quietest)) 0.0 1.0)
  (where
    (lazy low (call bin-of (call band-edge band) rate))
    (lazy high (call max (+ low 1) (call bin-of (call band-edge (+ band 1)) rate)))
    (lazy loudest (call max (in ([] heard each) (..< low (call min high (. heard length))))))
  )
)

(fn-expr _ band-edge Hertz
  (param band Index)
  (* lowest-band (%% (/ highest-band lowest-band) (/ (as band F64) band-count)))
)

(fn-expr _ bin-of Index
  (param frequency Hertz)
  (param rate F64)
  (as (call round (/ (* (as frequency F64) window-size) rate)) Index)
)

(fn-expr _ decibels F64
  (param magnitude F64)
  (* 20 (/ (call log (call max magnitude 0.000001)) (call log 10.0)))
)

(fn-expr _ band-color RGBA
  (param band Index)
  (param level F64)
  (as (call HSVA hue 0.62 0.98 (+ 0.35 (* 0.65 level))) RGBA)
  (where
    (lazy hue (* 0.8 (/ (as band F64) band-count)))
  )
)
