━━━━━━━━━━━━━━━━━━━━
+ do run-city-pulse

. launcher-app = App()
. launcher-window = CityPulseLauncherWindow()
launcher-app += launcher-window
active-city-pulse-app = launcher-app
launcher-app.run()
=? if !city-pulse-launch-choice-made

. next-metal = city-pulse-relaunch-metal
city-pulse-relaunch-requested = true
while city-pulse-relaunch-requested
    city-pulse-relaunch-requested = false
    . dashboard-app = App()
    . dashboard-window = CityPulseWindow(next-metal)
    dashboard-app += dashboard-window
    active-city-pulse-app = dashboard-app
    active-city-pulse-window = dashboard-window
    dashboard-app.run()
    if city-pulse-relaunch-requested
        next-metal = city-pulse-relaunch-metal

active-city-pulse-app = null
active-city-pulse-window = null

━━━━━━━━━━━━━━━━━━━━
+ do choose-city-pulse-mode
    - mode String

city-pulse-launch-choice-made = true
city-pulse-relaunch-metal = mode == "metal"
active-city-pulse-app?.stop()

━━━━━━━━━━━━━━━━━━━━
+ do relaunch-city-pulse
    - use-metal Bool

city-pulse-relaunch-metal = use-metal
city-pulse-relaunch-requested = true
active-city-pulse-app?.stop()

