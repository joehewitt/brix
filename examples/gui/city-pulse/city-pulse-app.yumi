text = title
if action == "pause"
    city-pulse-pause-label = this
else if action == "scroll"
    city-pulse-scroll-label = this

────────────────────
for event on click

. dashboard = active-city-pulse-window
if dashboard
    if action == "pause"
        dashboard.toggle-playing()
    else if action == "low"
        dashboard.set-load("LOW", 32)
    else if action == "normal"
        dashboard.set-load("NORMAL", 160)
    else if action == "high"
        dashboard.set-load("HIGH", 640)
    else if action == "scroll"
        dashboard.toggle-auto-scroll()
    else if action == "metal"
        relaunch-city-pulse(true)
    else if action == "core-graphics"
        relaunch-city-pulse(false)

━━━━━━━━━━━━━━━━━━━━
+ CityPulseFilterInput is TextInput

────────────────────
for event on input

city-pulse-filter-label?.text = "Press Return to apply ‘${event.text.lowercased}’"

────────────────────
for event on submit

active-city-pulse-window?.apply-filter(event.text)

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-cell-color RGBA
    - index Size
    - tick Size

match (index * 17 + tick * 3) % 9
    | 0
        "#0e7490"
    | 1
        "#0891b2"
    | 2
        "#0284c7"
    | 3
        "#2563eb"
    | 4
        "#4f46e5"
    | 5
        "#7c3aed"
    | 6
        "#c026d3"
    | 7
        "#e11d48"
    ??
        "#f97316"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-incident-color RGBA
    - index Size

match index % 5
    | 0
        "#7f1d1d"
    | 1
        "#78350f"
    | 2
        "#164e63"
    | 3
        "#1e3a8a"
    ??
        "#3b0764"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-spark-color RGBA
    - tone Size

match tone % 4
    | 0
        "#2dd4bf"
    | 1
        "#38bdf8"
    | 2
        "#fb7185"
    ??
        "#c084fc"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-stat-title String
    - kind String

match kind
    | "active"
        "ACTIVE CELLS"
    | "rows"
        "SCROLL ROWS"
    | "events"
        "LIVE EVENTS"
    ??
        "SHARED PINS"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-stat-value String
    - kind String

match kind
    | "active"
        "1,000"
    | "rows"
        "480"
    | "events"
        "2,418"
    ??
        "12"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-stat-tone Size
    - kind String

match kind
    | "active"
        0
    | "rows"
        1
    | "events"
        2
    ??
        3

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-action-title String
    - action String

match action
    | "pause"
        "PAUSE"
    | "low"
        "LOW · 32"
    | "normal"
        "NORMAL · 160"
    | "high"
        "HIGH · 640"
    | "scroll"
        "AUTO-SCROLL ON"
    | "metal"
        "RESTART IN METAL"
    ??
        "RESTART IN CORE GRAPHICS"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-category String
    - index Size

match index % 5
    | 0
        "FIRE"
    | 1
        "MEDICAL"
    | 2
        "TRAFFIC"
    | 3
        "TRANSIT"
    ??
        "UTILITY"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-district String
    - index Size

match (index * 7) % 8
    | 0
        "North Loop"
    | 1
        "Harbor"
    | 2
        "Market"
    | 3
        "Civic"
    | 4
        "Union"
    | 5
        "SOMA"
    | 6
        "Mission"
    ??
        "Sunset"

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
_ city-pulse-duration String
    - nanoseconds U64

match nanoseconds
    |= 0
        "—"
    ??
        "${tenths / 10}.${tenths % 10}ms"

.. tenths = round((nanoseconds as F64) / 100000) as U64
