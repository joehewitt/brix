+ do apply-filter
    - next-query String

for row in rows
    . category = city-pulse-category(row.index)
    . district = city-pulse-district(row.index)
    . searchable = "$category $district".lowercased
    row.is-filtered-out = next-query && searchable.find(next-query) == null

