╌╌╌╌╌╌╌╌╌╌ is Window ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do render Bool

. started = monotonic-time-nanoseconds()
if is-playing
    advance-city-pulse-frame()
. did-render = super.render()
. elapsed = monotonic-time-nanoseconds() - started

if did-render
    cpu-samples += elapsed
    collect-city-pulse-gpu-sample()
    if frame-index > 0 && frame-index % 120 == 0
        cpu-p99 = city-pulse-percentile(cpu-samples, 99)
        gpu-p99 = city-pulse-percentile(gpu-samples, 99)
        cpu-samples.clear()
        gpu-samples.clear()

    if frame-index == 30 && is-metal-rendering
        mark-metal-renderer-allocations()
        allocation-marked = true

    if frame-index % 30 == 0
        update-city-pulse-telemetry()

if is-playing
    schedule-render()
= did-render

────────────────────
_ do advance-city-pulse-frame

frame-index += 1
active-city-pulse-map?.advance(frame-index, updates-per-frame)

if auto-scroll
    feed-offset += if load-name == "LOW" then 0.65 else if load-name == "NORMAL" then 1.1 else 2.2
    . maximum = active-city-pulse-feed?.scroll-axis-maximum(Orientation.vertical) ?? 0
    if feed-offset > maximum
        feed-offset = 0
    active-city-pulse-feed?.scroll-to(Point(0, feed-offset))

if frame-index % 30 == 0
    city-pulse-live-value?.text = "${2418 + (frame-index / 30) % 317}"
    . scene-text = "$load-name · $updates-per-frame cell mutations/frame"
    city-pulse-scene-label?.text = "$scene-text · tick $frame-index"

────────────────────
_ do collect-city-pulse-gpu-sample

=? if !is-metal-rendering
. completed-frame = last-metal-frame-id - 3
=? if completed-frame < 0
. gpu = metal-frame-gpu-nanos(completed-frame)
if gpu >= 0
    last-gpu-nanos = gpu
    gpu-samples += gpu as U64

────────────────────
_ do update-city-pulse-telemetry

. renderer = if is-metal-rendering then "METAL" else "CORE GRAPHICS"
if requested-metal && !is-metal-rendering
    city-pulse-mode-label?.text = "METAL FALLBACK · $metal-fallback-reason"
else
    city-pulse-mode-label?.text = "$renderer · $load-name · ${if is-playing then "RUNNING" else "PAUSED"}"

. hertz U64
if last-frame-refresh-interval > 0ns
    hertz = (1s / last-frame-refresh-interval) as U64

. gpu-text = city-pulse-duration(gpu-p99)
if !is-metal-rendering
    gpu-text = "n/a"
. allocations = if allocation-marked then metal-renderer-allocations else -1
. cpu-text = city-pulse-duration(cpu-p99)
city-pulse-performance-label?.text = "".join
    * "${hertz}Hz · CPU p99 $cpu-text · GPU p99 $gpu-text"
    * " · presents $metal-present-count · allocs $allocations"

────────────────────
+ do toggle-playing

is-playing = !is-playing
city-pulse-pause-label?.text = if is-playing then "PAUSE" else "RESUME"
if is-playing
    city-pulse-scene-label?.text = "$load-name · resuming display-linked animation"
    schedule-render()
else
    city-pulse-scene-label?.text = "PAUSED · no animation frames are being requested"
update-city-pulse-telemetry()

────────────────────
+ do set-load
    - name String
    - mutations Size

load-name = name
updates-per-frame = mutations
city-pulse-scene-label?.text = "$name · $mutations cell mutations/frame"
schedule-render()

────────────────────
+ do toggle-auto-scroll

auto-scroll = !auto-scroll
city-pulse-scroll-label?.text = if auto-scroll then "AUTO-SCROLL ON" else "AUTO-SCROLL OFF"
if auto-scroll
    city-pulse-filter-label?.text = "Feed animation resumed"
else
    city-pulse-filter-label?.text = "Feed released for manual scrolling"
schedule-render()

────────────────────
+ do user-took-feed-scroll

=? if !auto-scroll
auto-scroll = false
city-pulse-scroll-label?.text = "AUTO-SCROLL OFF"
city-pulse-filter-label?.text = "Manual scroll owns the feed · use Auto-scroll to resume"

────────────────────
+ do apply-filter
    - query String

. normalized = query.lowercased
active-city-pulse-feed?.apply-filter(normalized)
if !normalized
    city-pulse-filter-label?.text = "Showing all 480 incidents"
else
    city-pulse-filter-label?.text = "Filter applied: ‘$normalized’"
schedule-render()

