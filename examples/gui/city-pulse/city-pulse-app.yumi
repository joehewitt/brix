━━━━━━━━━━━━━━━━━━━━
+ CitySparkline is Box

+ tone Size
+ phase Size

. invalidate-paint < phase

────────────────────
+ This

city-pulse-sparklines += this

────────────────────
+ do paint-self
    - canvas Canvas

canvas.push()
canvas.clip(bounds)
canvas.fill-color = null
canvas.stroke-color = city-pulse-spark-color(tone)
canvas.stroke-width = 2
canvas.begin()
for index in 0 .. < 42
    . x = bounds.x + ((index as F64) / 41) * bounds.width
    . wave = sin(((index * 3 + phase + tone * 11) as F64) * 0.17)
    . ripple = cos(((index + phase * 2 + tone * 7) as F64) * 0.11) * 0.35
    . y = bounds.center.y - (wave + ripple) * bounds.height * 0.28
    if index == 0
        canvas.move(x, y)
    else
        canvas.line(x, y)
canvas.end()
canvas.pop()

━━━━━━━━━━━━━━━━━━━━
+ CityPulseMap is Box

+ cells [CityPulseMapCell]
+ sparklines [CitySparkline]

• This
    layout = flow-col

────────────────────
+ This

active-city-pulse-map = this
cells.reserve(1000)
for row-index in 0 .. < 25
    . row = CityPulseMapRow()
    markup-append(this, row)
    for column-index in 0 .. < 40
        . index = row-index * 40 + column-index
        . cell = CityPulseMapCell(index)
        cells += cell
        markup-append(row, cell)

────────────────────
+ do advance
    - tick Size
    - mutation-count Size

for update in 0 .. < mutation-count
    . index = (tick * 29 + update * 137) % cells.length
    cells[index].color = city-pulse-cell-color(index, tick + update)

if tick % 240 == 0
    for index in 0 .. < cells.length
        cells[index].color = city-pulse-cell-color(index, tick + index * 3)

for sparkline in city-pulse-sparklines
    sparkline.phase = tick

