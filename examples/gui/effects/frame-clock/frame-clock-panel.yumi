+ TransformCard is Box
    is FrameAnimation
    using MotionKitTheme

+ clicks-text = "Not clicked yet"

_ clicks = 0

────────────────────

<This • motion-card p:12 w:220
    <Label "Still live" • motion-card-title

    <TextInput • mt:8
        placeholder = "Type while it turns"

    <Box • flex-row items-center mt:8
        <Button "Click me"
            action = => do count-click()
        <Label • motion-caption ml:8 flex:1
            text = #clicks-text

────────────────────
+ do shake

animate(this)

────────────────────
_ do count-click

clicks += 1
clicks-text = if clicks == 1 then "Clicked once" else "Clicked $clicks times"

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

. seconds = (tick.elapsed as Seconds) as F64
=? false if seconds >= shake-span
. reach = shake-reach * (1 - seconds / shake-span)
translate = Point(reach * sin(seconds * shake-rate * 2 * π), 0)
= true

────────────────────
+ do finish

translate = Point(0, 0)

━━━━━━━━━━━━━━━━━━━━
+ WaveReport is (frames Size, tiles Size, items Size)

━━━━━━━━━━━━━━━━━━━━
+ TileWave is Box
    is FrameAnimation
    using MotionKitTheme

+ event waved WaveReport

_ frame-count Size = 0
_ items-before Size = 0

• This • motion-clip

────────────────────

<This • flex-col items-center justify-center
    for line in 0 .. < wave-rows
        <Box • flex-row
            for place in 0 .. < wave-columns
                <WaveTile
                    row = line
                    column = place

────────────────────
+ do launch

frame-count = 0
animate(this)

────────────────────
_ items-recorded Size

|? !host
    0
??
    (host as Window).scene-items-built

.. host = window

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

frame-count += 1
if frame-count == 2
    items-before = items-recorded()
. seconds = (tick.elapsed as Seconds) as F64
for line in children
    for node in line.children
        (node as WaveTile).sway(seconds)
= tick.elapsed < wave-span

────────────────────
+ do finish

for line in children
    for node in line.children
        (node as WaveTile).settle()
. items = if frame-count >= 2 then items-recorded() - items-before else 0
waved <- WaveReport(frame-count, wave-rows * wave-columns, items)

━━━━━━━━━━━━━━━━━━━━
+ WaveTile is Box

+ row = 0
+ column = 0

• This • w:14 h:14 m:3
    corner-radius = 3

────────────────────

<This
    background-color = wave-colors[(#row + #column) % wave-colors.length]

────────────────────
+ do sway
    - seconds F64

. phase = seconds * 3.2 - ((row + column) as F64) * 0.38
. swell = 0.5 + 0.5 * sin(phase)
scale = 0.45 + 0.75 * swell
rotate = (0.9 * sin(phase * 0.5)) as Radians
opacity = (0.3 + 0.7 * swell) as Ratio

────────────────────
+ do settle

scale = 1.0
rotate = 0rad
opacity = 1%%

