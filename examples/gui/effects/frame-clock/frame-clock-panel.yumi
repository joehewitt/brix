_ bounce-span = 6s
_ ball-radius = 18.0
_ glide-spring = spring(900ms)
_ glide-curve = ease-in-out(1200ms)
_ pager-colors = [RGBA("#f97316"), RGBA("#eab308"), RGBA("#22c55e"), RGBA("#0ea5e9"), RGBA("#a855f7")]
_ shake-span = 0.6
_ shake-reach = 12.0
_ shake-rate = 7.0
_ wave-span = 8s
_ wave-rows = 8
_ wave-columns = 24
_ wave-colors = [RGBA("#2563eb"), RGBA("#4f46e5"), RGBA("#7c3aed"), RGBA("#c026d3"), RGBA("#db2777"), RGBA("#0891b2")]

━━━━━━━━━━━━━━━━━━━━
+ FrameClockPanel is Box
    using MotionKitTheme

+ display-text = "Start the ball to read the display's rate."
+ tick-text = "now – · delta – · elapsed –"
+ steps-text = "steps per frame –"
+ scale-text = "Time scale 1.0×"
+ sequence-text = "Not run yet"
+ sequence-color = RGBA("#94a3b8")
+ pager-text = "Page 1 of 5"
+ rotate-text = "Rotate 0°"
+ zoom-text = "Scale 1.0×"
+ fade-text = "Opacity 100%"
+ wave-text = "Press Wave to start."

_ is-sequencing = false

────────────────────

<This • motion-page p:18
    <MotionHeader "Frame clock playground"
        lede = "Everything here runs on the window's frame clock. Drag the time scale to slow it all down."

    <Box • flex-row items-center mt:12
        <Label • w:130
            text = #scale-text
        <Slider • w:280 h:24
            minimum = 0.1
            maximum = 1
            value = 1
            for event on value-changed
                set-time-scale(event.value)

    <Box • flex-row flex:1 mt:14 gap:14
        <MotionCard "A FrameAnimation" • flex:1 p:14
            note = "Bounces for six seconds of clock time. Restart re-registers the same animation, so elapsed starts over and it still steps once per frame."

            <BouncingBall ball • motion-well flex:1 mt:10

            <Label • motion-caption mt:8
                text = #display-text

            <Label • motion-caption mt:2
                text = #tick-text

            <Label • motion-caption mt:2
                text = #steps-text

            <Box • flex-row mt:10
                <Button "Start / restart"
                    action = => do ball.launch()

            <Label "Waiting on the clock" • motion-card-title mt:18

            <Label • motion-note mt:4
                text = "Three steps with frame-clock?.wait(700ms) between them. The time scale slows the waits too."

            <Box • flex-row items-center mt:10
                <Box • w:28 h:28
                    corner-radius = 14
                    background-color = #sequence-color
                <Label • ml:10 flex:1
                    text = #sequence-text
                <Button "Run sequence"
                    action = => do run-sequence()

        <MotionCard "Scroll glides" • flex:1 p:14
            note = "A glide is a motion channel on the scroller. Press another button mid-glide: a spring turns around without losing speed, and a curve blends into the new target."

            <GlideList glides • motion-well flex:1 mt:10
                for index in 0 .. < 40
                    <GlideRow
                        index = index

            <Box • flex-row items-center mt:10
                <Label "Spring" • motion-caption w:64
                <Button "Top"
                    action = => do glides.scroll-to(Point(0, 0), glide-spring)
                <Button "Bottom" • ml:8
                    action = => do glides.scroll-to(Point(0, glides.scroll-max.y), glide-spring)
                <Button "Stop" • ml:8
                    action = => do glides.stop-gliding()

            <Box • flex-row items-center mt:6
                <Label "Ease" • motion-caption w:64
                <Button "Top"
                    action = => do glides.scroll-to(Point(0, 0), glide-curve)
                <Button "Bottom" • ml:8
                    action = => do glides.scroll-to(Point(0, glides.scroll-max.y), glide-curve)

        <MotionCard "Swipe settling" • flex:1 p:14
            note = "Swipe sideways with two fingers on a trackpad. Release settles on a spring; touch again mid-settle to catch it."

            <SwipePager pager • motion-well flex:1 mt:10

            <Label • motion-caption mt:8
                text = #pager-text

    <Box • flex-row h:300 mt:14 gap:14
        <MotionCard "Transforms" • flex:1 p:14
            note = "Turn, scale and fade the card. Its text field and button stay live through the transform, and Shake carries the field's native text along with its box."

            <Box • flex-row flex:1 mt:10
                <Box • motion-well motion-clip flex-row items-center justify-center flex:1
                    <TransformCard card

                <Box • flex-col ml:14 w:200
                    <Label • motion-caption
                        text = #rotate-text
                    <Slider rotate-slider • h:24 mt:2
                        minimum = -0.8
                        maximum = 0.8
                        value = 0
                        for event on value-changed
                            turn-card(event.value)

                    <Label • motion-caption mt:8
                        text = #zoom-text
                    <Slider zoom-slider • h:24 mt:2
                        minimum = 0.5
                        maximum = 1.5
                        value = 1
                        for event on value-changed
                            zoom-card(event.value)

                    <Label • motion-caption mt:8
                        text = #fade-text
                    <Slider fade-slider • h:24 mt:2
                        minimum = 0
                        maximum = 1
                        value = 1
                        for event on value-changed
                            fade-card(event.value)

                    <Box • flex-row mt:12
                        <Button "Shake"
                            action = => do card.shake()
                        <Button "Reset" • ml:8
                            action = => do reset-card()

        <MotionCard "A wave of tiles" • flex:1 p:14
            note = "Every frame sets scale, rotate and opacity on all 192 tiles. None of them repaint: the scene re-composites what it recorded once."

            <TileWave wave • motion-well flex:1 mt:10

            <Box • flex-row items-center mt:10
                <Label • motion-caption flex:1
                    text = #wave-text
                <Button "Wave"
                    action = => do wave.launch()

────────────────────
for tick on ball.stepped

. interval = frame-clock?.interval ?? 0ns
. hertz = if interval > 0ns then round(1000000000.0 / (interval as F64)) else 0.0
. scale = frame-clock?.time-scale ?? 1.0
display-text = "Display ${hertz as Int} Hz · frame interval ${clock-ms(interval)} ms · time scale ${scale}"
tick-text = "now ${clock-ms(tick.now)} ms · delta ${clock-ms(tick.delta)} ms · elapsed ${clock-ms(tick.elapsed)} ms"
steps-text = "steps per frame ${ball.steps-per-frame}"

────────────────────
for page on pager.paged

pager-text = "Page ${page + 1} of ${pager-colors.length}"

────────────────────
for report on wave.waved

wave-text = "Last wave: ${report.frames} frames, ${report.tiles} tiles moved each frame, ${report.items} items recorded"

────────────────────
_ do turn-card
    - value F64

card.rotate = value as Radians
rotate-text = "Rotate ${round(value * 180 / π) as Int}°"

────────────────────
_ do zoom-card
    - value F64

card.scale = value
zoom-text = "Scale ${round(value * 100) / 100}×"

────────────────────
_ do fade-card
    - value F64

card.opacity = value as Ratio
fade-text = "Opacity ${round(value * 100) as Int}%"

────────────────────
_ do reset-card

rotate-slider.value = 0
zoom-slider.value = 1
fade-slider.value = 1
turn-card(0)
zoom-card(1)
fade-card(1)

────────────────────
_ do set-time-scale
    - value F64

. clock = frame-clock
=? if !clock
clock.time-scale = value
scale-text = "Time scale ${round(value * 10) / 10}×"

────────────────────
_ do run-sequence

=? if is-sequencing
is-sequencing = true
do new play-sequence()

────────────────────
_ do play-sequence

sequence-text = "1 · red"
sequence-color = RGBA("#ef4444")
frame-clock?.wait(700ms)
sequence-text = "2 · amber"
sequence-color = RGBA("#f59e0b")
frame-clock?.wait(700ms)
sequence-text = "3 · green"
sequence-color = RGBA("#22c55e")
frame-clock?.wait(700ms)
sequence-text = "Done"
sequence-color = RGBA("#94a3b8")
is-sequencing = false

━━━━━━━━━━━━━━━━━━━━
+ BouncingBall is Box
    is FrameAnimation
    using MotionKitTheme

+ steps-per-frame Size = 0
+ event stepped FrameTick

_ ball = Point(60, 60)
_ velocity = Point(420, 300)
_ stepped-at Nanoseconds?

• This • motion-clip

────────────────────
+ do launch

animate(this)

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

steps-per-frame = if stepped-at == tick.now then steps-per-frame + 1 else 1
stepped-at = tick.now
. seconds = (tick.delta as Seconds) as F64
. right = bounds.width - ball-radius
. bottom = bounds.height - ball-radius
. x = ball.x + velocity.x * seconds
. y = ball.y + velocity.y * seconds
if (x < ball-radius && velocity.x < 0) || (x > right && velocity.x > 0)
    velocity = Point(-velocity.x, velocity.y)
if (y < ball-radius && velocity.y < 0) || (y > bottom && velocity.y > 0)
    velocity = Point(velocity.x, -velocity.y)
ball = Point
    - clamp(x, ball-radius, max(ball-radius, right))
    - clamp(y, ball-radius, max(ball-radius, bottom))
invalidate-paint()
stepped <- tick
= tick.elapsed < bounce-span

────────────────────
+ do finish

invalidate-paint()

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

canvas.fill-color = RGBA("#f97316")
canvas.stroke-color = null
canvas.circle(bounds.x + ball.x, bounds.y + ball.y, ball-radius)

