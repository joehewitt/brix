━━━━━━━━━━━━━━━━━━━━
+ SwipePager is Box
    using MotionKitTheme

+ page = 0
+ event paged Int

_ swipe := SwipeTracker(this)

• This • motion-clip

────────────────────
for event on scroll

prepare-swipe()
if swipe.handle(event)
    event.cancel()

────────────────────
for _ on swipe.moved

invalidate-paint()

────────────────────
for event on swipe.turned

page = clamp(page + event.step, 0, pager-colors.length - 1)
invalidate-paint()
paged <- page

────────────────────
_ do prepare-swipe

swipe.page = Dimensions(bounds.width, bounds.height)
swipe.has-previous-x = page > 0
swipe.has-next-x = page < pager-colors.length - 1

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

canvas.stroke-color = null
for index in 0 .. < pager-colors.length
    . left = bounds.x + (index - page) * bounds.width + swipe.offset.x
    canvas.fill-color = pager-colors[index]
    canvas.rect(Rect(left + 16, bounds.y + 16, bounds.width - 32, bounds.height - 32))

