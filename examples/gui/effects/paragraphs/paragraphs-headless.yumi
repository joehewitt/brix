./paragraphs-atlas
/core/markup
/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/text
/os/file
/os/path

_ image-path = ".tmp/examples/paragraphs-2x.png"
_ one-x-image-path = ".tmp/examples/paragraphs-1x.png"
_ manifest-path = ".tmp/examples/paragraphs-manifest.txt"

ensure-paragraph-lab-output-directory()
. font-catalog = FontCatalog()
. regular-font = font-catalog.register
    - "stdlib/gui/tests/fixtures/tight-paragraph/noto-sans/NotoSans-Regular.ttf"
. atlas = ParagraphsAtlas()
atlas.font-family-name = regular-font.family
markup-mount-root(atlas, atlas)
atlas.markup-batch-queue.checkpoint()
atlas.layout(Rect(0, 0, 1200, 1560))

. one-x = RasterCanvas(1200, 1560, 1)
do use one-x
    one-x.erase("#f8fafc")
    atlas.paint(one-x)
    one-x.write(one-x-image-path)

. two-x = RasterCanvas(1200, 1560, 2)
do use two-x
    two-x.erase("#f8fafc")
    atlas.paint(two-x)
    two-x.write(image-path)

write-paragraph-lab-manifest(manifest-path, atlas.manifest())

atlas.close()
regular-font.close()
-- "paragraphs image=$image-path manifest=$manifest-path"

━━━━━━━━━━━━━━━━━━━━
_ do write-paragraph-lab-manifest
    - path String
    - manifest String

. file = File(path, FileFlags.create-mode + FileFlags.write-mode + FileFlags.truncate-mode)
file.write(manifest)
file.close()

━━━━━━━━━━━━━━━━━━━━
_ do ensure-paragraph-lab-output-directory

for path in [".tmp", ".tmp/examples"]
    . directory = Path(path)
    if !directory.is-dir
        directory.make-directory()
