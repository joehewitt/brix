+ get control-summary String

"".join
    * "width $sample-width · ${paragraph-lab-wrap-name(sample-wrap)} · "
    * "${paragraph-lab-wrap-sizing-name(sample-wrap-sizing)} · "
    * "${paragraph-lab-alignment-name(sample-alignment)} · guides $guides-visible"

────────────────────
+ manifest

"".join
    * "paragraphs-manifest v1\nrender-scales=1,2\n"
    **
        children
        ?*> match? each
            | label ParagraphLabSampleLabel
                paragraph-lab-manifest-line(label.sample-name, label)
            | bubble ParagraphLabBubble
                paragraph-lab-bubble-manifest-line(bubble)

