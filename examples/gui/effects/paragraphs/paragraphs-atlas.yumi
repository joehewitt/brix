+ ParagraphLabGuides is Box

+ guides-visible = true

. invalidate-paint < guides-visible

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

=? if !guides-visible
canvas.push()
. guide-origin = content-bounds
canvas.translate(guide-origin.x, guide-origin.y)
. atlas = %parent! as ParagraphsAtlas
for child in atlas.children
    if child is ParagraphLabSampleLabel
        draw-paragraph-label-guides(child as ParagraphLabSampleLabel, guide-origin, canvas)
    else if child is ParagraphLabBubble
        draw-paragraph-bubble-guides(child as ParagraphLabBubble, guide-origin, canvas)
canvas.pop()

────────────────────
_ do draw-paragraph-bubble-guides
    - bubble ParagraphLabBubble
    - guide-origin Rect
    - canvas Canvas

. label = bubble.%first-child! as ParagraphLabBubbleLabel
draw-paragraph-label-guides(label, guide-origin, canvas)
. content = label.content-bounds
. x = content.x - guide-origin.x
. y = content.y - guide-origin.y
. chosen-width = content.width
. wasted = max(0, bubble.text-cap - chosen-width)
canvas.push()
canvas.fill-color = null
canvas.stroke-width = 1
canvas.stroke-color = "#0891b2"
canvas.rect(Rect(x, y, bubble.text-cap, content.height))
if wasted > 0
    canvas.stroke-color = "#db2777"
    canvas.line(x + chosen-width, y - 3, x + bubble.text-cap, y - 3)
canvas.pop()

────────────────────
_ do draw-paragraph-label-guides
    - label Label
    - guide-origin Rect
    - canvas Canvas

. snapshot = label.text-layout-snapshot
=? if !snapshot
. content = label.content-bounds
. x = content.x - guide-origin.x
. y = content.y - guide-origin.y
. text-y = y + (content.height - snapshot.size.height) / 2

canvas.push()
canvas.fill-color = null
canvas.stroke-width = 1
canvas.stroke-color = "#dc2626"
canvas.rect(Rect(x, y, content.width, content.height))
canvas.stroke-color = "#0891b2"
canvas.line(x + content.width, y, x + content.width, y + content.height)
canvas.stroke-color = "#7c3aed"
canvas.line(x + snapshot.natural-width, y, x + snapshot.natural-width, y + content.height)
for line in snapshot.lines
    . alignment-offset = paragraph-lab-alignment-offset
        - label.$text-alignment
        - content.width
        - line.typographic-bounds.width
    . text-x = x + alignment-offset
    . typographic = Rect
        - text-x + line.typographic-bounds.x
        - text-y + line.typographic-bounds.y
        - line.typographic-bounds.width
        - line.typographic-bounds.height
    . ink = Rect
        - text-x + line.ink-bounds.x
        - text-y + line.ink-bounds.y
        - line.ink-bounds.width
        - line.ink-bounds.height
    canvas.stroke-color = "#2563eb"
    canvas.line(x, text-y + line.baseline, x + content.width, text-y + line.baseline)
    canvas.stroke-color = "#16a34a"
    canvas.rect(typographic)
    canvas.stroke-color = "#ea580c"
    canvas.rect(ink)
canvas.pop()

━━━━━━━━━━━━━━━━━━━━
_ paragraph-lab-alignment-offset Length
    - alignment TextAlignment
    - available Length
    - occupied Length

match alignment
    | TextAlignment.left
        0
    | TextAlignment.center
        (available - occupied) / 2
    | TextAlignment.right
        available - occupied

━━━━━━━━━━━━━━━━━━━━
_ paragraph-lab-manifest-line String
    - name String
    - label Label

|? !label.text-layout-snapshot
    "$name=unpainted\n"
??
    "$name=${snapshot.normalized}\n"

.. snapshot = label.text-layout-snapshot!

━━━━━━━━━━━━━━━━━━━━
_ paragraph-lab-bubble-manifest-line String
    - bubble ParagraphLabBubble

|? !label.text-layout-snapshot
    "${bubble.sample-name}=unpainted\n"
??
    "".join
        * "${bubble.sample-name}=A:${bubble.text-cap},W:$chosen-width,wasted:$wasted,"
        * "sizing:${paragraph-lab-wrap-sizing-name(label.$text-wrap-sizing)},"
        * "${snapshot.normalized}\n"

.. label = bubble.%first-child! as ParagraphLabBubbleLabel
.. snapshot = label.text-layout-snapshot!
.. chosen-width = label.content-bounds.width
.. wasted = max(0, bubble.text-cap - chosen-width)

━━━━━━━━━━━━━━━━━━━━
+ paragraph-lab-wrap-name String
    - wrap TextWrap

match wrap
    | TextWrap.no-wrap
        "no-wrap"
    | TextWrap.word
        "word"

━━━━━━━━━━━━━━━━━━━━
+ paragraph-lab-wrap-sizing-name String
    - sizing TextWrapSizing

match sizing
    | TextWrapSizing.available
        "available"
    | TextWrapSizing.tight
        "tight"

━━━━━━━━━━━━━━━━━━━━
+ paragraph-lab-alignment-name String
    - alignment TextAlignment

match alignment
    | TextAlignment.left
        "left"
    | TextAlignment.center
        "center"
    | TextAlignment.right
        "right"
