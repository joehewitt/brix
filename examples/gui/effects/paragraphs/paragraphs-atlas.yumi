+ ParagraphsAtlas is Box
    is MarkupRootElement
    using ParagraphsTheme

+ markup-batch-queue := MarkupBatchQueue(this as MarkupRootElement)
+ font-family-name String = "Noto Sans"
+ sample-text String = "".join
    * "Live paragraph text wraps through the production Label path: "
    * "e\u0301 · 👩🏽‍💻 · 日本語."
+ sample-width Length = 360
+ sample-bubble-width Length = 378
+ sample-wrap TextWrap = TextWrap.word
+ sample-wrap-sizing TextWrapSizing = TextWrapSizing.tight
+ sample-alignment TextAlignment = TextAlignment.left
+ guides-visible = true

