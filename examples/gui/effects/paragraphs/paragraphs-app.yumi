./paragraphs-panel
/graphics/text
/gui

. font-catalog = FontCatalog()
. regular-font = use font-catalog.register
    - "stdlib/gui/tests/fixtures/tight-paragraph/noto-sans/NotoSans-Regular.ttf"

<App
    <Window • flex-col
        title = "Yumi GUI: Paragraphs"
        size = (1280, 1180)

        <ParagraphsPanel panel • flex:1

panel.font-family-name = regular-font.family
