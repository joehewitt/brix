━━━━━━━━━━━━━━━━━━━━
+ ScrollingPanel is Box
    using ScrollingTheme

────────────────────

<This • showcase-shell flex-col p:18
    <Box • showcase-header flex-col h:78 px:18 py:12
        <Label • showcase-title
            text = "Box scrolling playground"

        <Label • showcase-subtitle mt:5
            text = "Wheel, trackpad, nested axes, containment, and button controls"

    <Box • showcase-body flex-row flex:1 mt:14
        <Box • showcase-panel flex-col flex:1 p:14
            <Label • panel-kicker
                text = "VERTICAL · AUTO"

            <Label • panel-title mt:4
                text = "Fractional pixel scrolling"

            <Label • panel-copy mt:5
                text = "At either edge, unused vertical motion can continue to an ancestor."

            <VerticalAutoPane vertical • viewport flex:1 mt:12
                <ShowcaseRow "01 · Box owns the viewport"
                <ShowcaseRow "02 · Layout stays unscrolled"
                <ShowcaseRow "03 · Content translates in paint"
                <ShowcaseRow "04 · Hit testing inverts motion"
                <ShowcaseRow "05 · Fractions remain fractions"
                <ShowcaseRow "06 · Large deltas report remainder"
                <ShowcaseRow "07 · Focus can reveal descendants"
                <ShowcaseRow "08 · State clamps after layout"
                <ShowcaseRow "09 · Background stays stationary"
                <ShowcaseRow "10 · Border stays stationary"
                <ShowcaseRow "11 · Native geometry follows"
                <ShowcaseRow "12 · Every Box has the API"

            <Label vertical-label • status-chip mt:10
                text = "position x 0 · y 0"

            <Box • control-row flow-row mt:9
                <ScrollShowcaseButton "vertical-up"
                <ScrollShowcaseButton "vertical-down" • ml:7
                <ScrollShowcaseButton "vertical-start" • ml:7
                <ScrollShowcaseButton "vertical-end" • ml:7

        <Box • showcase-panel flex-col flex:1 ml:14 p:14
            <Label • panel-kicker
                text = "HORIZONTAL · CONTAIN"

            <Label • panel-title mt:4
                text = "A self-contained strip"

            <Label • panel-copy mt:5
                text = "Pan sideways. At either edge, remainder stops here."

            <HorizontalContainedPane horizontal • viewport h:188 mt:12
                <ShowcaseCard "Alpha"
                <ShowcaseCard "Beta"
                <ShowcaseCard "Gamma"
                <ShowcaseCard "Delta"
                <ShowcaseCard "Epsilon"
                <ShowcaseCard "Zeta"

            <Label horizontal-label • status-chip mt:10
                text = "position x 0 · y 0 · contained"

            <Box • control-row flow-row mt:9
                <ScrollShowcaseButton "horizontal-left"
                <ScrollShowcaseButton "horizontal-right" • ml:7
                <ScrollShowcaseButton "horizontal-start" • ml:7
                <ScrollShowcaseButton "horizontal-end" • ml:7

            <Box • clip-note flex-col flex:1 mt:14 p:12
                <Label • panel-kicker
                    text = "CLIP · NOT SCROLLABLE"

                <Label • panel-copy mt:6
                    text = "Tall content is clipped, but this Box consumes no scrolling."

                <ClippedExample • clipped-example flex:1 mt:8
                    <ShowcaseRow "Visible beginning"
                    <ShowcaseRow "Still visible"
                    <ShowcaseRow "Clipped below"
                    <ShowcaseRow "Never a wheel sink"

        <Box • showcase-panel flex-col flex:1 ml:14 p:14
            <Label • panel-kicker
                text = "NESTED · INDEPENDENT AXES"

            <Label • panel-title mt:4
                text = "Horizontal deck, vertical columns"

            <Label • panel-copy mt:5
                text = "Diagonal input moves a column and its deck in one event."

            <NestedHorizontalPane nested • viewport flex:1 mt:12
                <NestedVerticalPane • nested-column
                    <ColumnRow "A · one"
                    <ColumnRow "A · two"
                    <ColumnRow "A · three"
                    <ColumnRow "A · four"
                    <ColumnRow "A · five"
                    <ColumnRow "A · six"
                    <ColumnRow "A · seven"
                    <ColumnRow "A · eight"

                <NestedVerticalPane • nested-column ml:10
                    <ColumnRow "B · amber"
                    <ColumnRow "B · blue"
                    <ColumnRow "B · coral"
                    <ColumnRow "B · denim"
                    <ColumnRow "B · emerald"
                    <ColumnRow "B · fuchsia"
                    <ColumnRow "B · gold"
                    <ColumnRow "B · haze"

                <NestedVerticalPane • nested-column ml:10
                    <ColumnRow "C · north"
                    <ColumnRow "C · east"
                    <ColumnRow "C · south"
                    <ColumnRow "C · west"
                    <ColumnRow "C · inner"
                    <ColumnRow "C · outer"
                    <ColumnRow "C · start"
                    <ColumnRow "C · end"

            <Label nested-label • status-chip mt:10
                text = "deck x 0 · y 0"

            <Box • control-row flow-row mt:9
                <ScrollShowcaseButton "nested-left"
                <ScrollShowcaseButton "nested-right" • ml:7
                <ScrollShowcaseButton "nested-start" • ml:7
                <ScrollShowcaseButton "nested-end" • ml:7

────────────────────
+ do perform-scroll
    - action String

if action == "vertical-up"
    vertical.scroll-by(Point(0, -48))
else if action == "vertical-down"
    vertical.scroll-by(Point(0, 48))
else if action == "vertical-start"
    vertical.scroll-to-start(Orientation.vertical)
else if action == "vertical-end"
    vertical.scroll-to-end(Orientation.vertical)
else if action == "horizontal-left"
    horizontal.scroll-by(Point(-80, 0))
else if action == "horizontal-right"
    horizontal.scroll-by(Point(80, 0))
else if action == "horizontal-start"
    horizontal.scroll-to-start(Orientation.horizontal)
else if action == "horizontal-end"
    horizontal.scroll-to-end(Orientation.horizontal)
else if action == "nested-left"
    nested.scroll-by(Point(-100, 0))
else if action == "nested-right"
    nested.scroll-by(Point(100, 0))
else if action == "nested-start"
    nested.scroll-to-start(Orientation.horizontal)
else if action == "nested-end"
    nested.scroll-to-end(Orientation.horizontal)

────────────────────
for event on vertical.scroll-changed

vertical-label.text = "position x ${vertical.scroll-x} · y ${vertical.scroll-y}"

────────────────────
for event on horizontal.scroll-changed

horizontal-label.text = "position x ${horizontal.scroll-x} · y ${horizontal.scroll-y} · contained"

────────────────────
for event on nested.scroll-changed

nested-label.text = "deck x ${nested.scroll-x} · y ${nested.scroll-y}"

