────────────────────
for event on click

ancestor'ScrollingPanel()?.perform-scroll(action)

━━━━━━━━━━━━━━━━━━━━
_ scroll-showcase-button-title String
    - action String

match action
    |= "vertical-up"
        "− 48"
    |= "vertical-down"
        "+ 48"
    |= "horizontal-left"
        "← 80"
    |= "horizontal-right"
        "80 →"
    |= "nested-left"
        "← Deck"
    |= "nested-right"
        "Deck →"
    |= "vertical-start"
        "Start"
    |= "horizontal-start"
        "Start"
    |= "nested-start"
        "Start"
    ??
        "End"
