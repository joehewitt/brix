────────────────────
+ do show-trace
    - text String

trace = text

────────────────────
+ do count-click
    - name String
    - native-count String

total-clicks += 1
count = "Primary clicks: $total-clicks · $name · native count: $native-count"

━━━━━━━━━━━━━━━━━━━━
+ ShowcaseTile is Box

+ name String

• This
    background-color = "#3b82f6"
    border-color = "#1e3a8a"
    border-width = 5
    cursor = CursorStyle.pointing-hand

    when #is-hovered
        background-color = "#22c55e"
        border-color = "#14532d"
        border-width = 8

    when #is-pressed
        background-color = "#f97316"
        border-color = "#7c2d12"
        border-width = 12
        cursor = CursorStyle.closed-hand

────────────────────
+ This
    - name

────────────────────
for event on pointer-down

pointer-trace(this, "down", name, event)

────────────────────
for event on pointer-drag

pointer-trace(this, "captured drag", name, event)

────────────────────
for event on pointer-up

pointer-trace(this, "up", name, event)

────────────────────
for event on scroll

ancestor'PointerPanel()?.show-trace
    - "scroll $name · (${event.delta-x}, ${event.delta-y}) · no default"

────────────────────
for event on click

ancestor'PointerPanel()?.count-click(name, "${event.click-count}")
pointer-trace(this, "click", name, event)

━━━━━━━━━━━━━━━━━━━━
+ do pointer-trace
    - box Box
    - action String
    - name String
    - event GUIEvent

. local = event.point
. root = event.root-point
box.ancestor'PointerPanel()?.show-trace
    - "$action $name · local (${local.x}, ${local.y}) · root (${root.x}, ${root.y})"

━━━━━━━━━━━━━━━━━━━━
+ CursorStyleSample is Box

+ name String = ""
+ role = CursorStyle.automatic

• This • cursor-sample
    cursor = #role

────────────────────

<This • flex-row
    <Label • cursor-sample-label flex:1
        text = #name
        text-alignment = TextAlignment.center

────────────────────
for event on click

ancestor'PointerPanel()?.show-trace("Cursor sample · $name · inherited by the nested Label")
