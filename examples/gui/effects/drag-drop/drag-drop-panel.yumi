    <Box • gallery-panel flex-col flex:1 p:12 mx:12
        <Label • panel-title h:22
            text = "Reordered list"
        <Label • panel-note h:34
            text = "".join
                * "The card leaves the list while it is held, "
                * "and a placeholder shows where it will land."
