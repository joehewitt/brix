+ SwatchWell is Box

+ title String
+ warm-only = false
+ is-armed = false
+ contents [Swatch]
+ caption = "Empty"

────────────────────

<This
    <Label • panel-status h:18
        text = title
    <Label • h:20
        text = #caption
    <Box • flex-row h:24 mt:2
        for swatch in #contents keyed by swatch.name
            <SwatchFace • w:48 h:24
                swatch = swatch

────────────────────
for event on drag-over

if takes(event.payload)
    is-armed = true
    event.accept()

────────────────────
for event on drag-leave

is-armed = false

────────────────────
for event on drop

. swatch = event.payload as Swatch
is-armed = false
contents = [swatch]
caption = "Holding ${swatch.name}"

────────────────────
_ takes
    - payload DragPayload

|? payload is Swatch
    !warm-only || (payload as Swatch).is-warm
??
    false

