━━━━━━━━━━━━━━━━━━━━
+ FileShelf is Box

+ files [String] = gallery-files()
+ archived [String]
+ archive-caption = "Empty"
+ carried = ""
+ row-owner => this

────────────────────

<This
    for name in #files keyed by name
        <FileRow • file-row flex-row h:30 px:10 mb:6
            shelf = row-owner
            name = name
    <FileArchive archive • drop-well flex-col h:58 p:10 mt:4
        shelf = row-owner
    <Box • flex-row h:30 mt:8
        <Button "Put the files back"
            action = => do restore()
    <Box badge • file-badge absolute flex-col w:150 h:26
        display = Display.invisible
        left = PositionOffset.coord(0)
        top = PositionOffset.coord(0)
        <Label • flex:1
            text = #carried
            text-alignment = TextAlignment.center

────────────────────
+ do file-away
    - name String

files = List'String(each in files when each != name)
archived += name
archive-caption = ", ".join(each in archived)

────────────────────
+ do restore

files = gallery-files()
archived = List'String()
archive-caption = "Empty"

