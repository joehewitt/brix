+ get drag-kind

"gallery.task"

━━━━━━━━━━━━━━━━━━━━
+ TaskList is Box

+ titles [String] = gallery-tasks()
+ ids [Size] = [0, 1, 2, 3, 4, 5]
+ order [Size] = [0, 1, 2, 3, 4, 5]
+ lifted Size?
+ gap Index?
+ story = "Nothing moved yet"
+ row-owner => this

────────────────────

<This
    <Box cards • flex:1
        for id in ids
            <TaskCard • task-card absolute flex-row h:36 px:10
                list = row-owner
                id = id
                title = titles[id]
                left = PositionOffset.coord(0)
                right = PositionOffset.coord(0)
                top = task-top(id, #order, #lifted, #gap)
                display = task-display(id, #lifted)
        if #gap != null
            <Box • task-gap absolute h:36
                left = PositionOffset.coord(0)
                right = PositionOffset.coord(0)
                top = task-gap-top(#gap)
    <Label • panel-status h:20 mt:6
        text = #story

────────────────────
for event on cards.drag-over

if event.payload is TaskPayload && lifted != null
    gap = slot-at(event.root-point)
    event.accept()

────────────────────
for event on cards.drag-leave

gap = null

────────────────────
for event on cards.drop

. id = (event.payload as TaskPayload).id
. next = List'Size(each in order when each != id)
. slot Index = gap ?? next.length
next.insert(id, slot)
order = next
story = "${titles[id]} is now number ${slot + 1}"

────────────────────
+ do lift
    - id Size

. slot Index = 0
for other in order
    if other == id
        gap = slot
    slot += 1
lifted = id

────────────────────
+ do settle

lifted = null
gap = null

────────────────────
+ slot-at
    - point Point

if row < last then row else last

.. local = cards.point-in-box(point)
.. reach = max(0, local.y)
.. row = floor(reach / task-pitch) as Index
.. last Index = order.length - 1

────────────────────
+ get arrangement

", ".join(titles[each] in order)

━━━━━━━━━━━━━━━━━━━━
+ TaskCard is Box

+ list TaskList
+ id Size
+ title String

────────────────────

<This
    <Label • flex:1
        text = title
        align-y = Alignment.center

────────────────────
for event on drag-start

event.begin(TaskPayload(id))
list.lift(id)

────────────────────
for event on drag-end

list.settle()

━━━━━━━━━━━━━━━━━━━━
+ OutlineBoard is Box

+ model = board-fixture()
+ story = "Nothing moved yet"

────────────────────

<This
    <TreeBox'BoardNode tree • board-tree flex:1
        root-node = model
        load-children = board-children
        key-builder = board-key
        auto-expand = board-is-group
        selection-mode = SelectionMode.multiple
        can-drag = :: node => node.name != "Background"
        drag-items = :: node => carried(node)
        can-drop = :: drop => board-is-group(drop.parent)

        <BoardRow (row) - row
            item = row.#item!
    <Label • panel-status h:20 mt:6
        text = #story

────────────────────
for event on tree.dropped

for node in event.items
    board-detach(model, node)
. siblings = event.parent.children!
. offset Index = event.index ?? siblings.length
for node in event.items
    siblings.insert(node, offset)
    offset += 1
. names = ", ".join(each.name in event.items)
story = "Moved $names into ${event.parent.name}"
tree.reload()

────────────────────
+ do carried
    - node BoardNode

=? [node] if !tree.is-key-selected(board-key(node))
. result [BoardNode]
. covered Index? = null
for entry in tree.entries
    if covered != null && entry.depth <= covered
        covered = null
    if covered == null && tree.is-key-selected(entry.key)
        result += entry.item
        covered = entry.depth
= result

────────────────────
+ get arrangement

board-outline(model)

━━━━━━━━━━━━━━━━━━━━
+ BoardRow is Box

+ item BoardNode

────────────────────

<This • flex-row flex:1
    if board-is-group(item)
        <LucideLayers • icon w:14 h:14 mr:6
            align-y = Alignment.center
        <Label • board-group flex:1
            text = item.name
            align-y = Alignment.center
    else
        <LucideSpline • icon w:14 h:14 mr:6
            align-y = Alignment.center
        <Label • flex:1
            text = item.name
            align-y = Alignment.center

