+ children [BoardNode]?

────────────────────
+ This
    - id
    - name
    - children [BoardNode]? = null

━━━━━━━━━━━━━━━━━━━━
_ gallery-swatches [Swatch]

* Swatch("Coral", RGBA("#f97316"), true)
* Swatch("Amber", RGBA("#d97706"), true)
* Swatch("Ocean", RGBA("#2563eb"), false)

━━━━━━━━━━━━━━━━━━━━
_ gallery-files [String]

* "Budget.xlsx"
* "Roadmap.md"
* "Launch photos"

━━━━━━━━━━━━━━━━━━━━
_ gallery-tasks [String]

* "Sketch the idea"
* "Collect references"
* "Block in shapes"
* "Refine the curves"
* "Choose colors"
* "Export"

━━━━━━━━━━━━━━━━━━━━
_ do task-top
    - id Size
    - order [Size]
    - lifted Size?
    - gap Index?

. slot Index = 0
for other in order
    if other == id
        if gap != null && slot >= gap
            slot += 1
        = PositionOffset.coord((slot as Length) * task-pitch)
    if lifted == null || other != lifted
        slot += 1
= PositionOffset.coord(0)

━━━━━━━━━━━━━━━━━━━━
_ task-gap-top
    - gap Index?

PositionOffset.coord(((gap ?? 0) as Length) * task-pitch)

━━━━━━━━━━━━━━━━━━━━
_ task-display
    - id Size
    - lifted Size?

|? lifted != null && lifted == id
    Display.hidden
??
    Display.visible

━━━━━━━━━━━━━━━━━━━━
_ board-fixture

BoardNode(0, "Document", layers)

.. figure = List'BoardNode
    * BoardNode(2, "Head")
    * BoardNode(3, "Body")
    * BoardNode(4, "Shadow")
.. scenery = List'BoardNode
    * BoardNode(6, "Sun")
    * BoardNode(7, "Hills")
.. layers = List'BoardNode
    * BoardNode(1, "Figure", figure)
    * BoardNode(5, "Scenery", scenery)
    * BoardNode(8, "Empty group", List'BoardNode())
    * BoardNode(9, "Signature")
    * BoardNode(10, "Background")

━━━━━━━━━━━━━━━━━━━━
_ board-children
    - node BoardNode

node.children

━━━━━━━━━━━━━━━━━━━━
_ board-is-group
    - node BoardNode

node.children != null

━━━━━━━━━━━━━━━━━━━━
_ board-key
    - node BoardNode

"${node.id}"

━━━━━━━━━━━━━━━━━━━━
_ do board-detach
    - parent BoardNode
    - node BoardNode

. children = parent.children
=? if !children
for index in 0 .. < children.length
    if children[index].id == node.id
        children.remove(index)
        =
for child in children
    board-detach(child, node)

━━━━━━━━━━━━━━━━━━━━
_ board-outline String
    - node BoardNode

|? !node.children
    node.name
??
    "${node.name}(${inner})"

.. inner = " ".join(board-outline(each) in node.children!)
