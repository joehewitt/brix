• DragDropTheme
    using GUIDefaultTheme

• gallery-panel • bg:gui-panel-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 8

• panel-title
    font-size = 15
    font-weight = FontWeight.bold

• panel-note • text:gui-muted-text-color
    font-size = 12

• panel-status • text:gui-muted-text-color
    font-size = 12

• swatch-chip • text:"#ffffff"
    font-weight = FontWeight.bold
    cursor = CursorStyle.open-hand

• swatch-face
    corner-radius = 6

• drop-well • bg:gui-well-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 8

    when #is-armed
        • bg:gui-hover-color
        border-color = gui-accent-bright-color

• file-row • bg:gui-field-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 6
    cursor = CursorStyle.open-hand

• file-icon • text:gui-muted-text-color

• file-badge • bg:gui-pressed-color text:gui-strong-text-color
    corner-radius = 13
    font-size = 12
    font-weight = FontWeight.bold

• task-card • bg:gui-field-color
    border-color = gui-border-color
    border-width = 1
    corner-radius = 6
