./text-lines-panel
/graphics/text
/gui

. font-catalog = FontCatalog()
. regular-font = use font-catalog.register
    - "stdlib/gui/tests/fixtures/tight-paragraph/noto-sans/NotoSans-Regular.ttf"
use font-catalog.register
    - "stdlib/gui/tests/fixtures/tight-paragraph/noto-sans/NotoSans-Bold.ttf"

<App
    <Window • flex-col
        title = "Yumi GUI: Text Lines"
        size = (1040, 720)

        <TextLinesPanel panel

panel.font-family-name = regular-font.family
