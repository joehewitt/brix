+ TextLinesAtlas is Box
    is MarkupBatch
    using TextLinesTheme

+ markup-batch-queue := MarkupBatchQueue(this as MarkupBatch)
+ sample-text String = "A deliberately long label: e\u0301 · 👩🏽‍💻 · 日本語 · العربية"
+ font-family-name String = "Noto Sans"
+ sample-width Length = 300.5
+ sample-size Length = 17.5
+ sample-weight FontWeight = FontWeight.regular
+ sample-overflow TextOverflow = TextOverflow.truncate-tail
+ sample-alignment TextAlignment = TextAlignment.left
+ overlays-visible = true

