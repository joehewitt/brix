. invalidate-paint < overlays-visible

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

=? if !overlays-visible
canvas.push()
. content = content-bounds
canvas.translate(content.x, content.y)
. atlas = %parent! as TextLinesAtlas
for child in atlas.children
    if child is TextLabSampleLabel
        draw-label-guides(child as TextLabSampleLabel, canvas)
canvas.pop()

────────────────────
_ do draw-label-guides
    - label Label
    - canvas Canvas

. snapshot = label.text-layout-snapshot
=? if !snapshot
. line = snapshot.lines[0]
. guide-origin = content-bounds
. content = label.content-bounds
. x = content.x - guide-origin.x
. y = content.y - guide-origin.y
. text-x = x + text-lab-alignment-offset(label.$text-alignment, content.width, snapshot.size.width)
. text-y = y + (content.height - snapshot.size.height) / 2
. typographic = Rect
    - text-x + line.typographic-bounds.x
    - text-y + line.typographic-bounds.y
    - line.typographic-bounds.width
    - line.typographic-bounds.height
. ink = Rect
    - text-x + line.ink-bounds.x
    - text-y + line.ink-bounds.y
    - line.ink-bounds.width
    - line.ink-bounds.height

canvas.push()
canvas.fill-color = null
canvas.stroke-width = 1
canvas.stroke-color = "#dc2626"
canvas.rect(Rect(x, y, content.width, content.height))
canvas.stroke-color = "#2563eb"
canvas.line
    - x
    - text-y + snapshot.first-baseline
    - x + content.width
    - text-y + snapshot.first-baseline
canvas.stroke-color = "#16a34a"
canvas.rect(typographic)
canvas.stroke-color = "#ea580c"
canvas.rect(ink)
canvas.stroke-color = "#7c3aed"
canvas.line(x + snapshot.natural-width, y, x + snapshot.natural-width, y + content.height)
canvas.pop()

━━━━━━━━━━━━━━━━━━━━
_ text-lab-alignment-offset Length
    - alignment TextAlignment
    - available Length
    - occupied Length

match alignment
    | TextAlignment.left
        0
    | TextAlignment.center
        (available - occupied) / 2
    | TextAlignment.right
        available - occupied

━━━━━━━━━━━━━━━━━━━━
_ text-lab-manifest-line String
    - name String
    - label Label

|? !label.text-layout-snapshot
    "$name=unpainted\n"
??
    "$name=${snapshot.normalized}\n"

.. snapshot = label.text-layout-snapshot!

━━━━━━━━━━━━━━━━━━━━
+ text-lab-overflow-name String
    - overflow TextOverflow

match overflow
    | TextOverflow.clip
        "clip"
    | TextOverflow.truncate-tail
        "truncate-tail"
    | TextOverflow.truncate-head
        "truncate-head"

━━━━━━━━━━━━━━━━━━━━
+ text-lab-alignment-name String
    - alignment TextAlignment

match alignment
    | TextAlignment.left
        "left"
    | TextAlignment.center
        "center"
    | TextAlignment.right
        "right"
