────────────────────
+ do show-focus
    - text String

focus-status = text

────────────────────
+ do show-event
    - text String

event-status = text

────────────────────
+ do show-value
    - text String

value-status = text

────────────────────
for event on key-press

. key-name = focus-keys-key-name(event.key)
. native-code = event.native-key-code
. repeat = event.is-repeat
event-status = "KeyPress: $key-name · native $native-code · repeat $repeat"

━━━━━━━━━━━━━━━━━━━━
+ FocusKeysButton is Box

+ name String

• This • showcase-button
    focus-mode = FocusMode.press

────────────────────
+ This
    - name

────────────────────

<This • flex-col
    <Label • flex:1
        text = name
        text-alignment = TextAlignment.center

────────────────────
for event on focus

ancestor'FocusKeysPanel()?.show-focus("Focus: $name (canvas press control)")

────────────────────
for event on blur

if !focus-keys-has-focus(this)
    ancestor'FocusKeysPanel()?.show-focus("Focus: none")

────────────────────
for event on click

ancestor'FocusKeysPanel()?.show-event("Click: $name")

━━━━━━━━━━━━━━━━━━━━
+ FocusKeysTextInput is TextInput

────────────────────
for event on focus

ancestor'FocusKeysPanel()?.show-focus("Focus: native TextInput")

────────────────────
for event on blur

if !focus-keys-has-focus(this)
    ancestor'FocusKeysPanel()?.show-focus("Focus: none")

────────────────────
for event on input

ancestor'FocusKeysPanel()?.show-event("Input: ‘${event.text}’")

────────────────────
for event on change

ancestor'FocusKeysPanel()?.show-event("Change: ‘${event.old-text}’ → ‘${event.text}’")

────────────────────
for event on submit

ancestor'FocusKeysPanel()?.show-event("Submit: ‘${event.text}’")

━━━━━━━━━━━━━━━━━━━━
+ FocusKeysSlider is Slider

────────────────────
for event on focus

ancestor'FocusKeysPanel()?.show-focus("Focus: Slider (canvas keys control)")

────────────────────
for event on value-changed

. old-value = event.old-value
. value = event.value
ancestor'FocusKeysPanel()?.show-value("ValueChanged: $old-value → $value · range $minimum…$maximum")

━━━━━━━━━━━━━━━━━━━━
_ focus-keys-has-focus Bool
    - box Box

|? !host
    false
??
    (host as Window).focused-box != null

.. host = box.window

━━━━━━━━━━━━━━━━━━━━
_ focus-keys-key-name String
    - key Key

match key
    | Key.tab
        "Tab"
    | Key.enter
        "Enter"
    | Key.escape
        "Escape"
    | Key.space
        "Space"
    | Key.arrow-up
        "Arrow Up"
    | Key.arrow-down
        "Arrow Down"
    | Key.arrow-left
        "Arrow Left"
    | Key.arrow-right
        "Arrow Right"
    | Key.function-key(index)
        "F$index"
    | Key.unknown(native-code)
        "Unknown ($native-code)"
    ??
        "Navigation"
