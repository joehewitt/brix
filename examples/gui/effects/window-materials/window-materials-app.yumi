/graphics/text
/gui

<App
    <WindowMaterialsWindow

━━━━━━━━━━━━━━━━━━━━
+ WindowMaterialsWindow is Window

────────────────────

<This • flex-row
    title = "Yumi GUI: Window Materials"
    size = (920, 600)
    background = null

    <Box • flex-col w:220 p:18
        window-material = WindowMaterial.sidebar
        <Label "Sidebar" • h:22
        <Label "A sidebar material in a transparent window." • h:40
            text-wrap = TextWrap.word

    <Box • flex-col flex:1 p:24
        window-material = WindowMaterial.hud
        <Box • flex-row h:30
            <Button "Open popover" • w:150
                action = => do popover.toggle()
                <Popover popover • w:260 bg:RGBA(1, 1, 1, 0.04)
                    window-material = WindowMaterial.popover
                    <Label "Popover material" • h:20
                    <Label "The windows behind it show through, blurred." • h:40
                        text-wrap = TextWrap.word

        <WindowMaterialsStripes • flex-col h:220 mt:24 p:28
            <Box • w:300 h:150 bg:RGBA(1, 1, 1, 0.18)
                corner-radius = 18
                backdrop-blur = 14
                shadow = Shadow(RGBA(0, 0, 0, 0.3), 14, 0, 6)

        <Box • flex-row mt:24
            <Box • flex-col w:240 h:140 p:16
                corner-radius = 16
                window-material = WindowMaterial.popover
                <Label "Popover material" • h:20
            <Box • flex-col w:240 h:140 p:16 ml:24 bg:RGBA(0.2, 0.5, 1, 0.12)
                corner-radius = 16
                window-material = WindowMaterial.menu
                <Label "Menu material, tinted" • h:20

━━━━━━━━━━━━━━━━━━━━
_ WindowMaterialsStripes is Box

────────────────────
+ do paint-self
    - canvas Canvas

. rect = bounds
for stripe in 0 .. < 24
    . hue = ((stripe % 6) as F64) / 6
    . x = rect.x + (stripe as F64) * rect.width / 24
    canvas.fill-color = RGBA(0.95 - hue * 0.7, 0.3 + hue * 0.5, 0.4 + (1 - hue) * 0.5, 1)
    canvas.rect(Rect(x, rect.y, rect.width / 48, rect.height))
canvas.fill-color = RGBA(0.1, 0.1, 0.15, 1)
canvas.oval(Rect(rect.x + 120, rect.y + 40, 140, 140))
