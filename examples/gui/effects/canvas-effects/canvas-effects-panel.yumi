+ do canvas-effects-photo

=? canvas-effects-photo-image! if canvas-effects-photo-image
. photo = RasterCanvas(160, 110, 2, RGBA("#0f172a"))
photo.fill-gradient
    - Rect(0, 0, 160, 110)
    - linear-gradient(Point(0, 0), Point(0, 80), RGBA("#1e3a8a"), RGBA("#fb923c"))
photo.fill-gradient
    - Rect(0, 0, 160, 110)
    - radial-gradient(Point(112, 56), 26, RGBA(1, 0.95, 0.7, 1), RGBA(1, 0.6, 0.3, 0))
photo.fill-color = RGBA("#312e81")
photo.begin()
photo.move(0, 84)
photo.line(34, 50)
photo.line(58, 70)
photo.line(92, 36)
photo.line(132, 74)
photo.line(160, 60)
photo.line(160, 110)
photo.line(0, 110)
photo.end(true)
photo.fill-color = RGBA("#0f766e")
photo.begin()
photo.move(0, 96)
photo.curve(40, 80, 90, 104, 160, 88)
photo.line(160, 110)
photo.line(0, 110)
photo.end(true)
canvas-effects-photo-image = photo
= photo

