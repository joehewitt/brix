+ do canvas-effects-badge

=? canvas-effects-badge-image! if canvas-effects-badge-image
. badge = RasterCanvas(96, 96, 2, transparent)
badge.fill-color = null
badge.stroke-color = RGBA(0, 0, 0, 1)
badge.stroke-width = 8
badge.oval(Rect(6, 6, 84, 84))
badge.stroke-color = null
badge.fill-color = RGBA(0, 0, 0, 1)
trace-effect-star(badge, Point(48, 50), 30, 13)
badge.end()
canvas-effects-badge-image = badge
= badge

━━━━━━━━━━━━━━━━━━━━
_ do trace-effect-star
    - canvas Canvas
    - center Point
    - outer Length
    - inner Length

canvas.begin()
for index in 0 .. < 10
    . radius = if index % 2 == 0 then outer else inner
    . turn = ((index as F64) * 36 - 90) as Degrees
    . x = center.x + radius * cos(turn)
    . y = center.y + radius * sin(turn)
    if index == 0
        canvas.move(x, y)
    else
        canvas.line(x, y)
canvas.enclose()

━━━━━━━━━━━━━━━━━━━━
_ do trace-effect-heart
    - canvas Canvas
    - center Point
    - size Length

. x = center.x
. y = center.y
canvas.begin()
canvas.move(x, y + size * 0.5)
canvas.curve
    - x - size * 0.15
    - y + size * 0.35
    - x - size * 0.5
    - y + size * 0.15
    - x - size * 0.5
    - y - size * 0.1
canvas.curve
    - x - size * 0.5
    - y - size * 0.45
    - x - size * 0.05
    - y - size * 0.5
    - x
    - y - size * 0.22
canvas.curve
    - x + size * 0.05
    - y - size * 0.5
    - x + size * 0.5
    - y - size * 0.45
    - x + size * 0.5
    - y - size * 0.1
canvas.curve
    - x + size * 0.5
    - y + size * 0.15
    - x + size * 0.15
    - y + size * 0.35
    - x
    - y + size * 0.5
canvas.enclose()

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-gradients
    - canvas Canvas

. sunset =
    * GradientStop(0%%, RGBA("#f97316"))
    * GradientStop(0.5%%, RGBA("#ec4899"))
    * GradientStop(1%%, RGBA("#6366f1"))
. card = Rect(14, 16, 116, 66)
do use canvas.saved-state
    canvas.clip-outline(Outline(card, 16))
    canvas.fill-gradient(card, LinearGradient(card.top-left, card.bottom-right, sunset))
. ball = Rect(144, 14, 66, 66)
. gold =
    * GradientStop(0%%, RGBA("#fef9c3"))
    * GradientStop(0.35%%, RGBA("#facc15"))
    * GradientStop(1%%, RGBA("#854d0e"))
do use canvas.saved-state
    canvas.begin()
    canvas.outline-path(Outline(ball, 33))
    canvas.clip-path()
    canvas.fill-gradient
        - ball
        - RadialGradient(Point(ball.x + 22, ball.y + 20), 2, ball.center, 44, gold)
. wheel = Rect(18, 92, 68, 68)
do use canvas.saved-state
    canvas.begin()
    canvas.outline-path(Outline(wheel, 34))
    canvas.clip-path()
    canvas.fill-gradient
        - wheel
        - ConicGradient(wheel.center, -90°, canvas-effects-rainbow())
. bar = Rect(102, 106, 108, 40)
do use canvas.saved-state
    canvas.clip-outline(Outline(bar, 20))
    canvas.fill-gradient
        - bar
        - linear-gradient
            - bar.left-center
            - bar.right-center
            - RGBA(0.05, 0.65, 0.9, 0.15)
            - RGBA(0.05, 0.65, 0.9, 1)

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-shadows
    - canvas Canvas
    - blur F64

. card = Outline(Rect(16, 20, 92, 62), 14)
canvas.begin()
canvas.outline-path(card)
canvas.shadow-path(Shadow(RGBA(0.06, 0.09, 0.16, 0.35), blur, 0, 6))
canvas.fill-color = white
canvas.outline(card)
trace-effect-star(canvas, Point(162, 54), 40, 17)
canvas.shadow-path(Shadow(RGBA(0.4, 0.1, 0.5, 0.45), blur, 4, 8))
canvas.fill-color = RGBA("#f59e0b")
trace-effect-star(canvas, Point(162, 54), 40, 17)
canvas.end()
trace-effect-heart(canvas, Point(70, 128), 54)
canvas.shadow-path(Shadow(RGBA(0.95, 0.2, 0.35, 0.9), blur, 0, 0))
canvas.fill-color = RGBA("#f43f5e")
trace-effect-heart(canvas, Point(70, 128), 54)
canvas.end()

