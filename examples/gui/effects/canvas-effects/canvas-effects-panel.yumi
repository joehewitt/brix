_ do paint-effect-masks
    - canvas Canvas

. left = Rect(8, 26, 106, 118)
do use canvas.saved-state
    canvas.begin-mask()
    canvas.fill-gradient(left, radial-gradient(left.center, 58, RGBA(0, 0, 0, 1), RGBA(0, 0, 0, 0)))
    canvas.end-mask()
    canvas.draw-image(canvas-effects-photo(), left)
. right = Rect(118, 36, 96, 96)
do use canvas.saved-state
    canvas.clip-mask(canvas-effects-badge(), right)
    canvas.fill-gradient(right, ConicGradient(right.center, 0rad, canvas-effects-rainbow()))

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-clips
    - canvas Canvas

. bubble = Outline(Rect(10, 16, 104, 84), 18, OutlineArrow(Side.bottom, 28, 16))
do use canvas.saved-state
    canvas.clip-outline(bubble)
    canvas.fill-color = RGBA("#fde68a")
    canvas.rect(Rect(0, 0, 130, 130))
    canvas.fill-color = null
    canvas.stroke-color = RGBA("#f97316")
    canvas.stroke-width = 6
    for index in 0 .. < 12
        . x = (index as F64) * 16 - 60
        canvas.line(x, 0, x + 90, 130)
do use canvas.saved-state
    canvas.begin()
    canvas.outline-path(Outline(Rect(122, 32, 90, 90), 45))
    canvas.outline-path(Outline(Rect(148, 58, 38, 38), 19))
    canvas.clip-path(FillRule.even-odd)
    canvas.draw-image(canvas-effects-photo(), Rect(104, 26, 140, 100))

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-images
    - canvas Canvas

. photo = canvas-effects-photo()
. badge = canvas-effects-badge()
do use canvas.saved-state
    canvas.transform(Matrix().rotate(-0.16rad, Point(72, 82)))
    . frame = Outline(Rect(16, 22, 112, 112), 4)
    canvas.begin()
    canvas.outline-path(frame)
    canvas.shadow-path(Shadow(RGBA(0, 0, 0, 0.3), 6, 0, 4))
    canvas.fill-color = white
    canvas.outline(frame)
    canvas.draw-image(photo, Rect(24, 30, 96, 66))
canvas.fill-color = RGBA("#0ea5e9")
canvas.draw-image(badge, Rect(152, 18, 48, 48), true)
canvas.fill-color = RGBA("#a855f7")
canvas.draw-image(badge, Rect(140, 80, 74, 74), true)

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-strokes
    - canvas Canvas

canvas.fill-color = null
canvas.stroke-color = RGBA("#0f172a")
canvas.stroke-width = 10
for index in 0 .. < 3
    . y = 22 + (index as F64) * 20
    canvas.stroke-cap = match index
        |= 0
            LineCap.butt
        |= 1
            LineCap.round
        ??
            LineCap.square
    canvas.line(22, y, 92, y)
canvas.stroke-cap = LineCap.butt
canvas.stroke-width = 8
canvas.stroke-color = RGBA("#0d9488")
for index in 0 .. < 3
    . x = 118 + (index as F64) * 32
    canvas.stroke-join = match index
        |= 0
            LineJoin.miter
        |= 1
            LineJoin.round
        ??
            LineJoin.bevel
    canvas.begin()
    canvas.move(x, 66)
    canvas.line(x + 12, 18)
    canvas.line(x + 24, 66)
    canvas.end()
canvas.stroke-join = LineJoin.miter
canvas.stroke-color = RGBA("#6366f1")
canvas.stroke-width = 3
canvas.stroke-cap = LineCap.round
canvas.stroke-dash = 7
canvas.curve(16, 150, 50, 80, 110, 170, 150, 96)
canvas.stroke-dash = 0
canvas.stroke-color = RGBA("#475569")
canvas.stroke-width = 0.5
for index in 0 .. < 9
    . x = 160 + (index as F64) * 6
    canvas.line(186, 160, x, 104)

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-groups
    - canvas Canvas
    - mode BlendMode
    - blur F64

for index in 0 .. < 11
    canvas.fill-color = if index % 2 == 0 then RGBA("#e2e8f0") else RGBA("#94a3b8")
    canvas.rect(Rect((index as F64) * 20, 0, 20, 170))
canvas.begin-opacity(0.6)
canvas.begin-blur(blur)
canvas.fill-color = RGBA("#2563eb")
canvas.oval(Rect(10, 30, 66, 66))
canvas.fill-color = RGBA("#f97316")
canvas.oval(Rect(40, 66, 66, 66))
canvas.end-blur()
canvas.end-opacity()
do use canvas.saved-state
    canvas.blend-mode = mode
    canvas.begin-opacity(0.9)
    canvas.fill-color = RGBA("#2563eb")
    canvas.oval(Rect(116, 30, 66, 66))
    canvas.fill-color = RGBA("#f97316")
    canvas.oval(Rect(146, 66, 66, 66))
    canvas.end-opacity()

━━━━━━━━━━━━━━━━━━━━
_ do paint-effect-shaders
    - canvas Canvas
    - mode BlendMode
    - time F64

. shaders = canvas-effects-shaders()
. plasma = Rect(14, 14, 132, 142)
do use canvas.saved-state
    canvas.clip-outline(Outline(plasma, 18))
    canvas.fill-shader(plasma, shaders[0], [time])
canvas.fill-shader(Rect(160, 14, 142, 142), shaders[1], [time, 26])
. photo = Rect(316, 14, 126, 142)
do use canvas.saved-state
    canvas.clip-outline(Outline(photo, 12))
    canvas.draw-image(canvas-effects-photo(), photo)
    canvas.blend-mode = mode
    canvas.fill-shader(photo, shaders[2], [time])

━━━━━━━━━━━━━━━━━━━━
+ do canvas-effects-shaders

if !canvas-effects-shader-list
    canvas-effects-shader-list =
        * Shader(canvas-effects-plasma-source())
        * Shader(canvas-effects-ripple-source())
        * Shader(canvas-effects-band-source())
= canvas-effects-shader-list

━━━━━━━━━━━━━━━━━━━━
_ canvas-effects-plasma-source

"\n".join
    * "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    * "    float2 uv = position / size;"
    * "    float t = args[0];"
    * "    float v = sin(uv.x * 10.0 + t) + sin((uv.y * 8.0 - t) * 1.3)"
    * "        + sin((uv.x + uv.y) * 7.0 + t * 0.7);"
    * "    float2 c = uv - 0.5 + 0.35 * float2(sin(t * 0.5), cos(t * 0.3));"
    * "    v += sin(sqrt(dot(c, c) * 160.0) - t * 2.0);"
    * "    return float4(0.5 + 0.5 * cos(float3(0.0, 2.1, 4.2) + v * 1.1), 1.0);"
    * "}"

━━━━━━━━━━━━━━━━━━━━
_ canvas-effects-ripple-source

"\n".join
    * "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    * "    float r = length(position - size * 0.5) / (0.5 * min(size.x, size.y));"
    * "    float wave = 0.5 + 0.5 * sin(r * args[1] - args[0] * 4.0);"
    * "    float fade = 1.0 - smoothstep(0.82, 1.0, r);"
    * "    float3 color = mix(float3(0.05, 0.2, 0.55), float3(0.4, 0.9, 1.0), wave);"
    * "    return float4(color, fade * (0.55 + 0.45 * wave));"
    * "}"

