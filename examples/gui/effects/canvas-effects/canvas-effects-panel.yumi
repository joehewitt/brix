────────────────────
+ do paint-self
    - canvas Canvas

. rect = content-bounds
. center = Point(rect.width / 2, rect.height / 2)
. mode = blend-code as BlendMode
do use canvas.saved-state
    canvas.translate(rect.x, rect.y)
    canvas.transform(canvas-effects-matrix(angle, zoom, center))
    do match kind
        |= "gradients"
            paint-effect-gradients(canvas)
        |= "shadows"
            paint-effect-shadows(canvas, blur-radius)
        |= "blend"
            paint-effect-blend(canvas, mode)
        |= "masks"
            paint-effect-masks(canvas)
        |= "clips"
            paint-effect-clips(canvas)
        |= "images"
            paint-effect-images(canvas)
        |= "strokes"
            paint-effect-strokes(canvas)
        |= "shaders"
            paint-effect-shaders(canvas, mode, time)
        ??
            paint-effect-groups(canvas, mode, blur-radius)

