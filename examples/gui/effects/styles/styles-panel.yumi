+ do paint-self
    - canvas Canvas

canvas.push()
. content = content-bounds
canvas.translate(content.x, content.y)
canvas.fill-color = $color
canvas.stroke-color = null
canvas.circle(width / 2, height / 2, min(width, height) / 2)
canvas.pop()
