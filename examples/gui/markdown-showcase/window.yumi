./exemplars
./theme
/graphics/primitives
/gui
/gui/chat
/gui/icons/lucide/chevron-left
/gui/icons/lucide/chevron-right
/gui/icons/lucide/code-xml
/gui/markdown

━━━━━━━━━━━━━━━━━━━━
+ MarkdownShowcaseWindow is Window
    using MarkdownShowcaseTheme

+ exemplars = markdown-exemplars()
+ index Index = 0
+ shows-source = false
+ current = exemplars[#index]
+ position-label = markdown-showcase-position(#index, exemplars.length)

────────────────────

<This • flex-row
    title = "Markdown Showcase"
    size = Dimensions(1180, 800)

    <KeyShortcut "Previous exemplar"
        key = .arrow-left
        action = => do show-previous()
    <KeyShortcut "Next exemplar"
        key = .arrow-right
        action = => do show-next()
    <KeyShortcut "Toggle source"
        key = KeyCombo("s")
        repeat = false
        action = => do toggle-source()

    <Sidebar • w:260
        <SidebarSection "Markdown" • pt:10
            for exemplar in exemplars
                <MarkdownExemplarRow
                    exemplar = exemplar
                    title = exemplar.title
                    is-on = #index == exemplar.index
                    for event on click
                        show-exemplar(exemplar.index)
                        event.cancel()
    <Box • flex-col flex:1
        <Box • markdown-showcase-bar flex-row h:56 pl:12 pr:14
            <IconButton previous-button • icon-chevron-left w:30 h:30
                align-y = Alignment.center
            <IconButton next-button • icon-chevron-right w:30 h:30 ml:2
                align-y = Alignment.center
            <Box • flex-col flex:1 mx:12
                align-y = Alignment.center
                <Label • markdown-showcase-title
                    text = #current.title
                <Label • markdown-showcase-summary mt:2
                    text = #current.summary
            <Label • markdown-showcase-position mr:12
                align-y = Alignment.center
                text = #position-label
            <IconButton source-button • icon-code-xml w:30 h:30
                align-y = Alignment.center
                is-on = #shows-source
        for exemplar in [#current] keyed by exemplar.index
            <Box • flex-row flex:1
                if #shows-source
                    <MarkdownShowcaseSource • flex:1
                        exemplar = exemplar
                <MarkdownShowcasePage • flex:1
                    exemplar = exemplar

────────────────────
for event on previous-button.click

show-previous()
event.cancel()

────────────────────
for event on next-button.click

show-next()
event.cancel()

────────────────────
for event on source-button.click

toggle-source()
event.cancel()

────────────────────
+ do show-exemplar
    - position Index

index = position

────────────────────
+ do show-next

index = if index + 1 >= exemplars.length then 0 else index + 1

────────────────────
+ do show-previous

index = if index == 0 then exemplars.length - 1 else index - 1

────────────────────
+ do toggle-source

shows-source = !shows-source

━━━━━━━━━━━━━━━━━━━━
+ MarkdownExemplarRow is SidebarItem

+ exemplar MarkdownExemplar

━━━━━━━━━━━━━━━━━━━━
+ MarkdownShowcasePage is Box

+ exemplar MarkdownExemplar

────────────────────

<This • chat-transcript flex-col
    <Box • chat-column flex-col px:24 pt:24 pb:32
        <MarkdownView
            text = exemplar.source

━━━━━━━━━━━━━━━━━━━━
+ MarkdownShowcaseSource is Box

+ exemplar MarkdownExemplar

────────────────────

<This • markdown-showcase-source flex-col
    <Box • flex-col px:20 pt:24 pb:32
        <Text • markdown-code
            <Span
                text = exemplar.source

━━━━━━━━━━━━━━━━━━━━
_ markdown-showcase-position
    - index Index
    - count Size

"${index + 1} / $count"
