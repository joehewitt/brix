━━━━━━━━━━━━━━━━━━━━
• MarkdownShowcaseTheme
    using GUIDefaultTheme

• markdown-showcase-bar
    border-color = gui-divider-color
    border-bottom-width = 1

• markdown-showcase-title
    font-size = 15
    font-weight = FontWeight.bold
    text-overflow = TextOverflow.truncate-tail

• markdown-showcase-summary • text:gui-muted-text-color
    font-size = 12
    text-overflow = TextOverflow.truncate-tail

• markdown-showcase-position • text:gui-muted-text-color
    font-size = 12

• markdown-showcase-source • bg:gui-well-color
    border-color = gui-divider-color
    border-right-width = 1
    overflow-y = ScrollOverflow.auto
