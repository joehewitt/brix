(import ./weather-forecast)
(import ./weather-parts)
(import ./weather-scene)
(import ./weather-sky)
(import ./weather-text)
(import ./weather-theme)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/refresh-cw)
(import /math)
(import /math/motion)
(import /time/duration)
(import /time/timer)
(import /time/zone)
(import /units)
(blank)
(prop _ strip-length _ (= 48))
(prop _ humidity-stops _ (= (list (call GradientStop 0% (call RGBA "#bfe6ff")) (call GradientStop 100% (call RGBA "#4f9dff")))))
(prop _ uv-stops _ (= (list (call GradientStop 0% (call RGBA "#7ddc7a")) (call GradientStop 30% (call RGBA "#ffd84d")) (call GradientStop 55% (call RGBA "#ff9a3d")) (call GradientStop 78% (call RGBA "#ff5a5a")) (call GradientStop 100% (call RGBA "#c07cff")))))
(prop _ cities _ (= (list (call City "San Francisco" 37.77° -122.42°) (call City "New York" 40.71° -74.01°) (call City "London" 51.51° -0.13°) (call City "Reykjavík" 64.15° -21.94°) (call City "Cairo" 30.04° 31.24°) (call City "Singapore" 1.35° 103.82°) (call City "Tokyo" 35.68° 139.69°) (call City "Sydney" -33.87° 151.21°))))

(type + WeatherWindow (is Window)
  (using WeatherTheme)
  (prop + stations (list Station) (= (call List (in (call Station each) cities))))
  (prop + chosen _ (= 0))
  (prop + scrub (? F64))
  (prop + uses-fahrenheit _ (= false))
  (prop + clock Seconds (= (. utc now)))
  (prop + station _ (= ([] stations #chosen)))
  (prop + forecast (? Forecast) (= (. #station #forecast)))
  (prop + moment Moment (= (call shown-moment #forecast #scrub)))
  (prop + sun Sun (= (call shown-sun #forecast #moment)))
  (prop + start Int (= (call strip-start #forecast)))
  (prop + hours (list Hour) (= (call strip-hours #forecast)))
  (prop + days (list Day) (= (call shown-days #forecast)))
  (prop + details Details (= (call details-for #forecast #moment #uses-fahrenheit)))
  (prop + glass LiquidGlass (= (call glass-for #sun)))
  (prop + frost Length (= (call frost-for #moment)))
  (prop + wet F64 (= (. #moment condition rain)))
  (prop + is-scrubbing _ (= (!= #scrub null)))
  (content
    (<> This (• flex-row)
      (= title "Weather")
      (= size (call Dimensions 1180 820))
      (= titlebar-visible false)
      (= appearance (. WindowAppearance dark))
      (= state-key "weather")
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (blank)
      (<> Box (• weather-stage)
        (= background-fill (call sky-for #moment #sun))
        (<> Toolbar (• weather-toolbar)
          (= is-title-bar true)
          (<> ToolbarSpace)
          (if #is-scrubbing
            (<> ToolbarGroup (• now-group)
              (<> ToolbarButton (text: "Back to now")
                (= action (=> () :do (= scrub null)))
              )
            )
          )
          (<> ToolbarGroup
            (<> ToolbarButton (• icon-refresh-cw)
              (= action (=> () :do (call reload)))
              (<> Tooltip
                (= text "Refresh")
              )
            )
          )
          (<> ToolbarGroup
            (<> (of SegmentedControl Bool)
              (<-> selected uses-fahrenheit)
              (<> (of Segment Bool) (text: "°C")
                (= value false)
              )
              (<> (of Segment Bool) (text: "°F")
                (= value true)
              )
            )
          )
        )
        (<> Box (• weather-body)
          (<> Box (• weather-sidebar)
            (= backdrop #glass)
            (= backdrop-blur #frost)
            (<> RainLayer
              (= wet #wet)
            )
            (for (in index (..< 0 (. stations length)))
              (<> CityRow
                (= name (. ([] stations index) city name))
                (= note (. ([] stations index) #note))
                (= forecast (. ([] stations index) #forecast))
                (= is-chosen (== #chosen index))
                (= uses-fahrenheit #uses-fahrenheit)
                (for (on event click)
                  (call choose index)
                )
              )
            )
            (<> Box (• flex 1))
            (<> Label (text: "Weather data by Open-Meteo.com") (• sidebar-foot))
          )
          (<> Box (• weather-main)
            (<> Headline
              (= city-name (. #station city name))
              (= caption (call shown-caption #forecast #scrub #clock))
              (= moment #moment)
              (= summary (call shown-summary #forecast #moment #uses-fahrenheit))
              (= uses-fahrenheit #uses-fahrenheit)
            )
            (<> Box (• card)
              (= backdrop #glass)
              (= backdrop-blur #frost)
              (<> RainLayer
                (= wet #wet)
              )
              (<> Box (• flex-row) (• items-center)
                (<> Label (text: "NEXT 48 HOURS") (• card-title) (• flex 1))
                (<> Label (text: "Drag across the hours to move the sky") (• hint))
              )
              (<> HourStrip
                (= hours #hours)
                (= offset (call shown-offset #forecast))
                (= chosen (call strip-place #scrub #start))
                (= uses-fahrenheit #uses-fahrenheit)
                (for (on place scrubbed)
                  (= scrub (+ start place))
                )
                (for (on place settled)
                  (call settle place)
                )
              )
            )
            (<> Box (• weather-lower)
              (<> Box (• card) (• flex 5)
                (= backdrop #glass)
                (= backdrop-blur #frost)
                (<> RainLayer
                  (= wet #wet)
                )
                (<> DayList (• flex 1)
                  (= days #days)
                  (= offset (call shown-offset #forecast))
                  (= uses-fahrenheit #uses-fahrenheit)
                )
              )
              (<> Box (• tile-grid) (• flex 4)
                (<> Box (• tile-row)
                  (<> Box (• tile)
                    (= backdrop #glass)
                    (= backdrop-blur #frost)
                    (<> RainLayer
                      (= wet #wet)
                    )
                    (<> Box (• tile-head)
                      (<> Label (text: "WIND") (• card-title) (• flex 1))
                      (<> WindDial (• text weather-ink)
                        (= heading (. #details heading))
                      )
                    )
                    (<> Label (• card-figure)
                      (= text (. #details wind))
                    )
                    (<> Label (• card-note)
                      (= text (. #details wind-note))
                    )
                  )
                  (<> Box (• tile)
                    (= backdrop #glass)
                    (= backdrop-blur #frost)
                    (<> RainLayer
                      (= wet #wet)
                    )
                    (<> Box (• tile-head)
                      (<> Label (text: "HUMIDITY") (• card-title))
                    )
                    (<> Label (• card-figure)
                      (= text (. #details humidity))
                    )
                    (<> Label (• card-note)
                      (= text (. #details humidity-note))
                    )
                    (<> Box (• flex 1))
                    (<> Meter (• h 14)
                      (= stops humidity-stops)
                      (= level (. #details humidity-level))
                    )
                  )
                )
                (<> Box (• tile-row)
                  (<> Box (• tile)
                    (= backdrop #glass)
                    (= backdrop-blur #frost)
                    (<> RainLayer
                      (= wet #wet)
                    )
                    (<> Box (• tile-head)
                      (<> Label (text: "UV INDEX") (• card-title))
                    )
                    (<> Label (• card-figure)
                      (= text (. #details uv))
                    )
                    (<> Label (• card-note)
                      (= text (. #details uv-note))
                    )
                    (<> Box (• flex 1))
                    (<> Meter (• h 14)
                      (= stops uv-stops)
                      (= level (. #details uv-level))
                      (= is-scale true)
                    )
                  )
                  (<> Box (• tile)
                    (= backdrop #glass)
                    (= backdrop-blur #frost)
                    (<> RainLayer
                      (= wet #wet)
                    )
                    (<> Box (• tile-head)
                      (<> Label (text: "SUN") (• card-title))
                    )
                    (<> SunArc (• flex 1)
                      (= across (. #sun across))
                      (= elevation (. #sun height))
                    )
                    (<> Box (• flex-row)
                      (<> Label (• card-note) (• flex 1)
                        (= text (. #details sunrise))
                      )
                      (<> Label (• card-note)
                        (= text (. #details sunset))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (subscribe-for (on tick (call Timer 20s))
    (= clock (. utc now))
  )
  (fn-do + choose _
    (param index Index)
    (= chosen index)
    (= scrub null)
  )
  (fn-do + reload _
    (for (in each stations)
      (<- (. each reloads) true)
    )
  )
  (fn-do + settle _
    (param place F64)
    (if (< place 0.5)
      (= scrub null)
      (else
        (= scrub (+ start place))
      )
    )
  )
)

(type + Details (is Tuple)
  (prop + wind String)
  (prop + wind-note String)
  (prop + heading Degrees)
  (prop + humidity String)
  (prop + humidity-level F64)
  (prop + humidity-note String)
  (prop + uv String)
  (prop + uv-level F64)
  (prop + uv-note String)
  (prop + sunrise String)
  (prop + sunset String)
)

(type + CityRow (is Box)
  (using WeatherTheme)
  (prop + name _ (= ""))
  (prop + note _ (= ""))
  (prop + forecast (? Forecast))
  (prop + is-chosen _ (= false))
  (prop + uses-fahrenheit _ (= false))
  (content
    (<> This (• city-row)
      (= background-fill (call station-sky #forecast))
      (<> Box (• flex-col) (• flex 1)
        (<> Label (• city-name)
          (= text #name)
        )
        (<> Label (• city-note)
          (= text (call station-note #forecast #note))
        )
      )
      (<> Label (• city-degrees)
        (= text (call station-degrees #forecast #uses-fahrenheit))
      )
    )
  )
)

(type + Headline (is Box)
  (using WeatherTheme)
  (prop + city-name _ (= ""))
  (prop + caption _ (= ""))
  (prop + moment Moment (= calm-moment))
  (prop + summary _ (= ""))
  (prop + uses-fahrenheit _ (= false))
  (content
    (<> This (• headline)
      (<> Label (• headline-city)
        (= text #city-name)
      )
      (<> Label (• headline-caption)
        (= text #caption)
      )
      (<> Label (• headline-degrees)
        (= text (call degrees-label (call animated (call shown-degrees (. #moment temperature) #uses-fahrenheit) (call spring 700ms))))
      )
      (<> Label (• headline-condition)
        (= text (. #moment condition title))
      )
      (<> Label (• headline-detail)
        (= text #summary)
      )
    )
  )
)

(fn-expr + shown-moment Moment
  (param forecast (? Forecast))
  (param scrub (? F64))
  (match forecast
    (case= null
      calm-moment
    )
    (case? (== scrub null)
      (. forecast now)
    )
    (default
      (call (. forecast moment-at) scrub)
    )
  )
)

(fn-expr + shown-sun Sun
  (param forecast (? Forecast))
  (param moment Moment)
  (match forecast
    (case= null
      calm-sun
    )
    (default
      (call (. forecast sun-at) (. moment time))
    )
  )
)

(fn-expr + shown-caption String
  (param forecast (? Forecast))
  (param scrub (? F64))
  (param clock Seconds)
  (match forecast
    (case= null
      ""
    )
    (case? (== scrub null)
      (str "Now · " (call clock-label (as (as clock F64) Int) (. forecast offset)))
    )
    (default
      (call moment-label (. (call (. forecast moment-at) scrub) time) (. forecast offset))
    )
  )
)

(fn-expr + shown-offset Int
  (param forecast (? Forecast))
  (match forecast
    (case= null
      0
    )
    (default
      (. forecast offset)
    )
  )
)

(fn-expr + shown-days (list Day)
  (param forecast (? Forecast))
  (match forecast
    (case= null
      (call (of List Day))
    )
    (default
      (. forecast days)
    )
  )
)

(fn-expr + strip-start Int
  (param forecast (? Forecast))
  (match forecast
    (case= null
      0
    )
    (default
      (call clamp (as (call floor (. forecast now-position)) Int) 0 (- (. forecast hours length) 2))
    )
  )
)

(fn-do + strip-hours (list Hour)
  (param forecast (? Forecast))
  (let shown (call (of List Hour)))
  (if forecast
    (let first (call strip-start forecast))
    (let now (. forecast current))
    (let hour ([] (. forecast hours) first))
    (+= shown (call Hour (. hour time) (. now temperature) (. now condition) (. now cover) (. hour rain-chance) (. now is-day)))
    (for (in index (..< (+ first 1) (call min (+ first strip-length) (. forecast hours length))))
      (+= shown ([] (. forecast hours) index))
    )
  )
  (return shown)
)

(fn-expr + strip-place F64
  (param scrub (? F64))
  (param start Int)
  (match scrub
    (case= null
      0.0
    )
    (default
      (- scrub start)
    )
  )
)

(fn-expr + details-for Details
  (param forecast (? Forecast))
  (param moment Moment)
  (param uses-fahrenheit Bool)
  (match forecast
    (case= null
      (call Details "–" "" 0° "–" 0.0 "" "–" 0.0 "" "" "")
    )
    (default
      (call Details
        (block
          (arg (call speed-label (. now wind) uses-fahrenheit))
          (arg (str "Gusts " (call speed-label (. now gusts) uses-fahrenheit) " · from " (call compass-label (. now wind-from))))
          (arg (. now wind-from))
          (arg (call percent-label (. now humidity)))
          (arg (/ (as (. now humidity) F64) 100))
          (arg (str "Dew point " (call temperature-label (. now dew-point) uses-fahrenheit)))
          (arg (str (as (call round (. day uv)) Int)))
          (arg (/ (. day uv) 11))
          (arg (call uv-label (. day uv)))
          (arg (str "↑ " (call clock-label (. day sunrise) (. forecast offset))))
          (arg (str "↓ " (call clock-label (. day sunset) (. forecast offset))))
        )
      )
      (lazy now (. forecast current))
      (lazy day (call (. forecast day-at) (. moment time)))
    )
  )
)

(fn-expr + shown-summary String
  (param forecast (? Forecast))
  (param moment Moment)
  (param uses-fahrenheit Bool)
  (match forecast
    (case= null
      "Fetching the forecast…"
    )
    (default
      (str "H " (call temperature-label (. day high) uses-fahrenheit) "   L " (call temperature-label (. day low) uses-fahrenheit) "   Feels like " (call temperature-label (. forecast current feels-like) uses-fahrenheit))
      (lazy day (call (. forecast day-at) (. moment time)))
    )
  )
)

(fn-expr + station-sky Sky
  (param forecast (? Forecast))
  (match forecast
    (case= null
      (call sky-for calm-moment calm-sun)
    )
    (default
      (call sky-for (. forecast now) (call (. forecast sun-at) (. forecast current time)))
    )
  )
)

(fn-expr + station-note String
  (param forecast (? Forecast))
  (param note String)
  (match forecast
    (case= null
      note
    )
    (default
      (str (. forecast current condition title) " · " (call clock-label (. forecast current time) (. forecast offset)))
    )
  )
)

(fn-expr + station-degrees String
  (param forecast (? Forecast))
  (param uses-fahrenheit Bool)
  (match forecast
    (case= null
      "–"
    )
    (default
      (call temperature-label (. forecast current temperature) uses-fahrenheit)
    )
  )
)
