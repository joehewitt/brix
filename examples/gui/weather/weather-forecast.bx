(import /data/json)
(import /math)
(import /net/http)
(import /net/url)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)
(import /units)
(blank)
(prop _ forecast-root _ (= "https://api.open-meteo.com/v1/forecast"))
(prop _ current-fields _
  (=
    (paragraph
      "temperature_2m,apparent_temperature,relative_humidity_2m,is_day,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m,wind_gusts_10m,dew_point_2m"
    )
  )
)
(prop _ hourly-fields _ (= "temperature_2m,precipitation_probability,weather_code,cloud_cover,is_day"))
(prop _ daily-fields _
  (=
    (paragraph
      "weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,precipitation_probability_max,uv_index_max"
    )
  )
)
(prop _ refresh-interval _ (= 15minutes))
(prop _ retry-interval _ (= 30s))
(prop _ hour-length _ (= 3600))
(prop _ day-length _ (= 86400))
(prop + calm-moment _ (= (call Moment 0 12 (. Condition clear) 0.15)))
(prop + calm-sun _ (= (call Sun 0.1 0.25)))
(blank)
(type-line + Celsius (alias °C) (is F64))
(type-line + Fahrenheit (alias °F) (is F64))
(type-line + KilometersPerHour (alias kph) (is F64))
(type-line + MilesPerHour (alias mph) (is 1.609344kph))

(type + Condition (is (tuple (: title String) (: rain F64) (: snow F64) (: fog F64) (: storm F64) (: gloom F64)))
  (variant clear (= (tuple "Clear" 0 0 0 0 0)))
  (variant mostly-clear (= (tuple "Mostly clear" 0 0 0 0 0)))
  (variant partly-cloudy (= (tuple "Partly cloudy" 0 0 0 0 0.1)))
  (variant overcast (= (tuple "Overcast" 0 0 0 0 0.55)))
  (variant fog (= (tuple "Fog" 0 0 0.9 0 0.6)))
  (variant drizzle (= (tuple "Drizzle" 0.3 0 0.1 0 0.6)))
  (variant rain (= (tuple "Rain" 0.65 0 0.1 0 0.75)))
  (variant heavy-rain (= (tuple "Heavy rain" 1 0 0.2 0 0.9)))
  (variant sleet (= (tuple "Freezing rain" 0.5 0.3 0.1 0 0.8)))
  (variant snow (= (tuple "Snow" 0 0.6 0.15 0 0.6)))
  (variant heavy-snow (= (tuple "Heavy snow" 0 1 0.3 0 0.75)))
  (variant showers (= (tuple "Showers" 0.55 0 0 0 0.5)))
  (variant thunderstorm (= (tuple "Thunderstorm" 0.9 0 0.1 1 1)))
)

(type + City (is Tuple)
  (prop + name String)
  (prop + latitude Degrees)
  (prop + longitude Degrees)
)

(type + Hour (is Tuple)
  (prop + time Int)
  (prop + temperature Celsius)
  (prop + condition Condition)
  (prop + cover Ratio)
  (prop + rain-chance Percent)
  (prop + is-day Bool)
)

(type + Day (is Tuple)
  (prop + time Int)
  (prop + condition Condition)
  (prop + low Celsius)
  (prop + high Celsius)
  (prop + sunrise Int)
  (prop + sunset Int)
  (prop + rain-chance Percent)
  (prop + uv F64)
)

(type + Current (is Tuple)
  (prop + time Int)
  (prop + temperature Celsius)
  (prop + feels-like Celsius)
  (prop + humidity Percent)
  (prop + condition Condition)
  (prop + cover Ratio)
  (prop + wind KilometersPerHour)
  (prop + gusts KilometersPerHour)
  (prop + wind-from Degrees)
  (prop + dew-point Celsius)
  (prop + is-day Bool)
)

(type + Moment (is Tuple)
  (prop + time Int)
  (prop + temperature Celsius)
  (prop + condition Condition)
  (prop + cover Ratio)
)

(type + Sun (is Tuple)
  (prop + height F64)
  (prop + across F64)
)

(type + Forecast (is Tuple)
  (prop + offset Int)
  (prop + current Current)
  (prop + hours (list Hour))
  (prop + days (list Day))
  (fn-expr + now-position F64 :get
    (/ (as (- (. current time) (. ([] hours 0) time)) F64) hour-length)
  )
  (fn-expr + now Moment :get
    (call Moment (. current time) (. current temperature) (. current condition) (. current cover))
  )
  (fn-expr + moment-at Moment
    (param position F64)
    (call Moment
      (block
        (arg (+ (. before time) (as (* blend hour-length) Int)))
        (arg (+ (. before temperature) (* (- (. after temperature) (. before temperature)) blend)))
        (arg (. (if-expr (< blend 0.5) before after) condition))
        (arg (+ (. before cover) (* (- (. after cover) (. before cover)) blend)))
      )
    )
    (where
      (lazy index (call clamp (as (call floor position) Int) 0 (- (. hours length) 2)))
      (lazy blend (call clamp (- position index) 0.0 1.0))
      (lazy before ([] hours index))
      (lazy after ([] hours (+ index 1)))
    )
  )
  (fn-expr + day-at Day
    (param time Int)
    (?? (call last (?> days (<= (. each time) time))) ([] days 0))
  )
  (fn-expr + sun-at Sun
    (param time Int)
    (match time
      (case? (< it rise)
        (call night (- set day-length) rise time)
      )
      (case? (> it set)
        (call night set (+ rise day-length) time)
      )
      (default
        (call Sun (call sin (* π passed)) passed)
      )
    )
    (where
      (lazy day (call day-at time))
      (lazy rise (. day sunrise))
      (lazy set (. day sunset))
      (lazy passed (/ (as (- time rise) F64) (call max 1 (- set rise))))
    )
  )
)

(type + ForecastUpdate (is Union)
  (variant loaded Forecast)
  (variant failed String)
)

(type + Station
  (prop + city City)
  (prop + forecast (? Forecast))
  (prop + note _ (= "Loading…"))
  (event + reloads Bool)
  (prop + phase _
    (machine
      (state loading
        (then showing (trigger for (call .loaded found) outcome)
          (= forecast found)
          (= note "")
        )
        (blank)
        (then (call failed message) (trigger for (call .failed message) outcome)
          (= note "Unavailable")
        )
        (blank)
        (lazy outcome (call load-forecast city))
      )
      (blank)
      (state showing
        (then loading (trigger on reloads))
        (then loading (trigger on (call Timer refresh-interval)))
      )
      (blank)
      (state (call failed message)
        (then loading (trigger on reloads))
        (then loading (trigger on (call Timer retry-interval)))
      )
    )
  )
  (fn-do + This _
    (param city _)
  )
)

(fn-do + load-forecast (of AsyncBufferedChannel ForecastUpdate)
  (param city City)
  (let updates (call (of AsyncBufferedChannel ForecastUpdate)))
  (do-new
    (let update
      (match (catch (call fetch-forecast city))
        (case (: found Forecast)
          (call (. ForecastUpdate loaded) found)
        )
        (case (: error Error)
          (call (. ForecastUpdate failed) (str error))
        )
      )
    )
    (<- updates update)
    (call (. updates close))
  )
  (return updates)
)

(fn-do + fetch-forecast Forecast (?! Error)
  (param city City)
  (let response (call http-get (call URL (call forecast-address city))))
  (throw (call Error (str "Open-Meteo answered " (. response status))) (if (!= (. response status) (. HTTPStatus ok))))
  (return (call forecast-in (call parse-json (. response text))))
)

(fn-do + forecast-in Forecast (?! Error)
  (param document JSON)
  (let root (call (. (call JSONReader "forecast" document) object)))
  (let offset (call (. ([] root "utc_offset_seconds") int)))
  (let current (call (. ([] root "current") object)))
  (let hourly (call (. ([] root "hourly") object)))
  (let daily (call (. ([] root "daily") object)))
  (return (call Forecast offset (call current-in current) (call hours-in hourly) (call days-in daily)))
)

(fn-expr _ night Sun
  (param dusk Int)
  (param dawn Int)
  (param time Int)
  (call Sun (- (call sin (* π passed))) passed)
  (where
    (lazy passed (call clamp (/ (as (- time dusk) F64) (call max 1 (- dawn dusk))) 0.0 1.0))
  )
)

(fn-expr _ forecast-address String
  (param city City)
  (str forecast-root "?latitude=" (as (. city latitude) F64) "&longitude=" (as (. city longitude) F64) "&current=" current-fields "&hourly=" hourly-fields "&daily=" daily-fields "&timezone=auto&forecast_days=7&timeformat=unixtime")
)

(fn-expr _ current-in Current (?! Error)
  (param table JSONObjectReader)
  (call Current
    (block
      (arg (as (call field table "time") Int))
      (arg (as (call field table "temperature_2m") Celsius))
      (arg (as (call field table "apparent_temperature") Celsius))
      (arg (as (call field table "relative_humidity_2m") Percent))
      (arg (call condition-for (as (call field table "weather_code") Int)))
      (arg (as (/ (call field table "cloud_cover") 100) Ratio))
      (arg (as (call field table "wind_speed_10m") KilometersPerHour))
      (arg (as (call field table "wind_gusts_10m") KilometersPerHour))
      (arg (as (call field table "wind_direction_10m") Degrees))
      (arg (as (call field table "dew_point_2m") Celsius))
      (arg (!= (call field table "is_day") 0))
    )
  )
)

(fn-do _ hours-in (list Hour) (?! Error)
  (param table JSONObjectReader)
  (let times (call column table "time"))
  (let temperatures (call column table "temperature_2m"))
  (let codes (call column table "weather_code"))
  (let covers (call column table "cloud_cover"))
  (let chances (call column table "precipitation_probability"))
  (let days (call column table "is_day"))
  (return
    (call List
      (*> (..< 0 (. times length))
        (call Hour
          (block
            (arg (as ([] times each) Int))
            (arg (as ([] temperatures each) Celsius))
            (arg (call condition-for (as ([] codes each) Int)))
            (arg (as (/ ([] covers each) 100) Ratio))
            (arg (as ([] chances each) Percent))
            (arg (!= ([] days each) 0))
          )
        )
      )
    )
  )
)

(fn-do _ days-in (list Day) (?! Error)
  (param table JSONObjectReader)
  (let times (call column table "time"))
  (let codes (call column table "weather_code"))
  (let lows (call column table "temperature_2m_min"))
  (let highs (call column table "temperature_2m_max"))
  (let rises (call column table "sunrise"))
  (let sets (call column table "sunset"))
  (let chances (call column table "precipitation_probability_max"))
  (let rays (call column table "uv_index_max"))
  (return
    (call List
      (*> (..< 0 (. times length))
        (call Day
          (block
            (arg (as ([] times each) Int))
            (arg (call condition-for (as ([] codes each) Int)))
            (arg (as ([] lows each) Celsius))
            (arg (as ([] highs each) Celsius))
            (arg (as ([] rises each) Int))
            (arg (as ([] sets each) Int))
            (arg (as ([] chances each) Percent))
            (arg ([] rays each))
          )
        )
      )
    )
  )
)

(fn-expr _ column (list F64) (?! Error)
  (param table JSONObjectReader)
  (param name String)
  (call List (*> (call (. ([] table name) array)) (call number each)))
)

(fn-expr _ field F64
  (param table JSONObjectReader)
  (param name String)
  (call number (. ([] table name) value))
)

(fn-expr _ number F64
  (param value JSON)
  (match value
    (case (: float Float)
      float
    )
    (case (: int Int)
      (as int F64)
    )
    (default
      0.0
    )
  )
)

(fn-expr + condition-for Condition
  (param code Int)
  (match code
    (case= 0
      (. Condition clear)
    )
    (case= 1
      (. Condition mostly-clear)
    )
    (case= 2
      (. Condition partly-cloudy)
    )
    (case= 3
      (. Condition overcast)
    )
    (case? (<= it 48)
      (. Condition fog)
    )
    (case? (<= it 55)
      (. Condition drizzle)
    )
    (case? (<= it 57)
      (. Condition sleet)
    )
    (case? (<= it 63)
      (. Condition rain)
    )
    (case= 65
      (. Condition heavy-rain)
    )
    (case? (<= it 67)
      (. Condition sleet)
    )
    (case? (<= it 73)
      (. Condition snow)
    )
    (case? (<= it 77)
      (. Condition heavy-snow)
    )
    (case? (<= it 81)
      (. Condition showers)
    )
    (case= 82
      (. Condition heavy-rain)
    )
    (case? (<= it 86)
      (. Condition snow)
    )
    (default
      (. Condition thunderstorm)
    )
  )
)
