(import /graphics/primitives)
(import /graphics/style)
(import /gui)
(import /gui/icons/lucide/cloud)
(import /gui/icons/lucide/cloud-drizzle)
(import /gui/icons/lucide/cloud-fog)
(import /gui/icons/lucide/cloud-hail)
(import /gui/icons/lucide/cloud-lightning)
(import /gui/icons/lucide/cloud-moon)
(import /gui/icons/lucide/cloud-rain)
(import /gui/icons/lucide/cloud-snow)
(import /gui/icons/lucide/cloud-sun)
(import /gui/icons/lucide/moon)
