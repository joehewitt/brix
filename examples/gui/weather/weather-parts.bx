(import /units)
(blank)
(prop _ cold-color _ (= (call RGBA "#7cc4ff")))
(prop _ mild-color _ (= (call RGBA "#9fe3a1")))
(prop _ warm-color _ (= (call RGBA "#ffd166")))
(prop _ hot-color _ (= (call RGBA "#ff8a5c")))

(type + Glyph (is U8)
  (variant sun)
  (variant moon)
  (variant cloud-sun)
  (variant cloud-moon)
  (variant cloud)
  (variant fog)
  (variant drizzle)
  (variant rain)
  (variant sleet)
  (variant snow)
  (variant storm)
)

(type + ConditionIcon (is Box)
  (prop + glyph _ (= (. Glyph sun)))
  (content
    (<> This (• flex-row) (• items-center) (• justify-center)
      (if (== #glyph (. Glyph sun))
        (<> LucideSun (• icon) (• flex 1))
        (else-if (== #glyph (. Glyph moon))
          (<> LucideMoon (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph cloud-sun))
          (<> LucideCloudSun (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph cloud-moon))
          (<> LucideCloudMoon (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph cloud))
          (<> LucideCloud (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph fog))
          (<> LucideCloudFog (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph drizzle))
          (<> LucideCloudDrizzle (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph rain))
          (<> LucideCloudRain (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph sleet))
          (<> LucideCloudHail (• icon) (• flex 1))
        )
        (else-if (== #glyph (. Glyph snow))
          (<> LucideCloudSnow (• icon) (• flex 1))
        )
        (else
          (<> LucideCloudLightning (• icon) (• flex 1))
        )
      )
    )
  )
)

(type + HourStrip (is Box)
  (using WeatherTheme)
  (prop + hours (list Hour))
  (prop + offset _ (= 0))
  (prop + chosen _ (= 0.0))
  (prop + uses-fahrenheit _ (= false))
  (event + scrubbed F64)
  (event + settled F64)
  (content
    (<> This (• hour-scroller)
      (<> Box (• hour-track)
        (= min-width (call (. SizeSpec coord) (* (as (. #hours length) F64) hour-width)))
        (<> Box (• hour-pill)
          (= left (call (. PositionOffset coord) (+ (* #chosen hour-width) 3)))
          (= top (call (. PositionOffset coord) 0))
          (= bottom (call (. PositionOffset coord) 0))
          (= min-width (call (. SizeSpec coord) (- hour-width 6)))
        )
        (<> Box (• flex-row)
          (for (in hour #hours (keyed-by (. hour time)))
            (<> Box (• hour-cell)
              (= min-width (call (. SizeSpec coord) hour-width))
              (<> Label (• hour-time)
                (= text (if-expr (== (. hour time) (. ([] #hours 0) time)) "Now" (call hour-label (. hour time) #offset)))
              )
              (<> ConditionIcon (• w 20) (• h 20) (• text weather-ink)
                (= glyph (call glyph-for (. hour condition) (. hour is-day)))
              )
              (<> Label (• hour-degrees)
                (= text (call temperature-label (. hour temperature) #uses-fahrenheit))
              )
              (<> Label (• hour-chance)
                (= text (call chance-label (. hour rain-chance)))
              )
            )
          )
        )
        (<> HourCurve (• h 46)
          (= hours #hours)
          (= chosen #chosen)
        )
        (for (on event pointer-down)
          (<- scrubbed (call strip-position (. event point x) (. hours length)))
        )
        (for (on event pointer-drag)
          (<- scrubbed (call strip-position (. event point x) (. hours length)))
        )
        (for (on event pointer-up)
          (<- settled (call round (call strip-position (. event point x) (. hours length))))
        )
      )
    )
  )
)

(type + HourCurve (is Box)
  (prop + hours (list Hour))
  (prop + chosen _ (= 0.0))
  (blank)
  (depends invalidate-paint hours chosen)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (< (. hours length) 2)))
    (do-use (. canvas saved-state)
      (let content content-bounds)
      (call (. canvas translate) (. content x) (. content y))
      (let height (. content height))
      (let low (call min (*> hours (as (. each temperature) F64))))
      (let span (call max 1.0 (- (call max (*> hours (as (. each temperature) F64))) low)))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call RGBA "#ffffffa6"))
      (= (. canvas stroke-width) 1.5)
      (= (. canvas stroke-cap) (. LineCap round))
      (call (. canvas begin))
      (call trace canvas low span height)
      (call (. canvas end))
      (let index (call clamp (as (call floor chosen) Int) 0 (- (. hours length) 2)))
      (let part (call clamp (- chosen index) 0.0 1.0))
      (let from (call curve-height ([] hours index) low span height))
      (let to (call curve-height ([] hours (+ index 1)) low span height))
      (let spot (call Point (* (+ chosen 0.5) hour-width) (+ from (* (- to from) part part (- 3 (* 2 part))))))
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (call RGBA "#ffffff40"))
      (call (. canvas circle) (. spot x) (. spot y) 8)
      (= (. canvas fill-color) (call RGBA "#ffffff"))
      (call (. canvas circle) (. spot x) (. spot y) 4)
    )
  )
  (fn-do _ trace _
    (param canvas Canvas)
    (param low F64)
    (param span F64)
    (param height F64)
    (call (. canvas move) (* 0.5 hour-width) (call curve-height ([] hours 0) low span height))
    (for (in index (..< 1 (. hours length)))
      (let x (* (+ index 0.5) hour-width))
      (let y (call curve-height ([] hours index) low span height))
      (let before (call curve-height ([] hours (- index 1)) low span height))
      (call (. canvas curve) (- x (* hour-width 0.667)) before (- x (* hour-width 0.333)) y x y)
    )
  )
)

(type + RainLayer (is Box)
  (using WeatherTheme)
  (prop + wet _ (= 0.0))
  (prop + is-wet _ (= (> #wet 0.004)))
  (content
    (<> This (• rain-layer)
      (if #is-wet
        (<> Box (• rain-drops)
          (= backdrop (call RainDrops #wet))
        )
      )
    )
  )
)

(type + DayList (is Box)
  (using WeatherTheme)
  (prop + days (list Day))
  (prop + offset _ (= 0))
  (prop + uses-fahrenheit _ (= false))
  (prop + coldest Celsius (= (call min (*> #days (. each low)))))
  (prop + warmest Celsius (= (call max (*> #days (. each high)))))
  (content
    (<> This (• flex-col)
      (<> Label (text: "7-DAY FORECAST") (• card-title) (• mb 6))
      (for (in day #days (keyed-by (. day time)))
        (<> Box (• day-row)
          (<> Label (• day-name)
            (= text (if-expr (== (. day time) (. ([] #days 0) time)) "Today" (call weekday-label (. day time) #offset)))
          )
          (<> ConditionIcon (• w 20) (• h 20) (• text weather-ink)
            (= glyph (call glyph-for (. day condition) true))
          )
          (<> Label (• day-chance)
            (= text (call chance-label (. day rain-chance)))
          )
          (<> Label (• day-low)
            (= text (call temperature-label (. day low) #uses-fahrenheit))
          )
          (<> RangeBar (• flex 1) (• h 12)
            (= low (. day low))
            (= high (. day high))
            (= coldest #coldest)
            (= warmest #warmest)
          )
          (<> Label (• day-high)
            (= text (call temperature-label (. day high) #uses-fahrenheit))
          )
        )
      )
    )
  )
)

(type + RangeBar (is Box)
  (prop + low Celsius)
  (prop + high Celsius)
  (prop + coldest Celsius)
  (prop + warmest Celsius)
  (blank)
  (depends invalidate-paint low high coldest warmest)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (let content content-bounds)
      (call (. canvas translate) (. content x) (. content y))
      (let middle (/ (. content height) 2))
      (let reach (- (. content width) 4))
      (let span (call max 1.0 (as (- warmest coldest) F64)))
      (let start (+ 2 (* reach (/ (as (- low coldest) F64) span))))
      (let end (call max (+ start 4) (+ 2 (* reach (/ (as (- high coldest) F64) span)))))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-width) 4)
      (= (. canvas stroke-color) (call RGBA "#ffffff2e"))
      (call (. canvas line) 2 middle (+ 2 reach) middle)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (call warmth-color low))
      (call (. canvas circle) start middle 2)
      (= (. canvas fill-color) (call warmth-color high))
      (call (. canvas circle) end middle 2)
      (call (. canvas fill-gradient)
        (block
          (arg (call Rect start (- middle 2) (- end start) 4))
          (arg
            (call LinearGradient
              (block
                (arg (call Point start 0))
                (arg (call Point end 0))
                (arg (list (call GradientStop 0% (call warmth-color low)) (call GradientStop 100% (call warmth-color high))))
              )
            )
          )
        )
      )
    )
  )
)

(type + WindDial (is Box)
  (using WeatherTheme)
  (prop + heading Degrees)
  (content
    (<> This (• flex-row) (• items-center) (• justify-center)
      (<> LucideNavigationN2 (• icon) (• w 22) (• h 22)
        (= rotate (as (+ #heading 180°) Radians))
        (= (. motion rotate) gui-motion-bouncy)
      )
    )
  )
)

(type + SunArc (is Box)
  (prop + across _ (= 0.0))
  (prop + elevation _ (= 1.0))
  (blank)
  (depends invalidate-paint across elevation)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (let content content-bounds)
      (call (. canvas translate) (. content x) (. content y))
      (let base (* (. content height) 0.74))
      (let rise (- base 7))
      (let dip (- (. content height) base 6))
      (let reach (- (. content width) 16))
      (let is-up (> elevation 0))
      (let along (if-expr is-up across (- 1 across)))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call RGBA "#ffffff38"))
      (= (. canvas stroke-width) 1)
      (call (. canvas line) 0 base (. content width) base)
      (= (. canvas stroke-color) (call RGBA "#ffffff99"))
      (= (. canvas stroke-width) 1.5)
      (= (. canvas stroke-cap) (. LineCap round))
      (call (. canvas begin))
      (call (. canvas move) 8 base)
      (for (in step (.. 1 32))
        (call (. canvas line) (+ 8 (* reach (/ step 32.0))) (- base (* rise (call sin (* π (/ step 32.0))))))
      )
      (call (. canvas end))
      (let lift (if-expr is-up (* rise (call sin (* π along))) (* (- dip) (call sin (* π along)))))
      (let spot (call Point (+ 8 (* reach along)) (- base lift)))
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (if-expr is-up (call RGBA "#ffe9a84d") (call RGBA "#c8d4ff33")))
      (call (. canvas circle) (. spot x) (. spot y) 9)
      (= (. canvas fill-color) (if-expr is-up (call RGBA "#ffe9a8") (call RGBA "#c8d4ffb3")))
      (call (. canvas circle) (. spot x) (. spot y) 4.5)
    )
  )
)

(type + Meter (is Box)
  (prop + level _ (= 0.0))
  (prop + stops (list GradientStop))
  (prop + is-scale _ (= false))
  (blank)
  (depends invalidate-paint level stops is-scale)
  (blank)
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (< (. stops length) 2)))
    (do-use (. canvas saved-state)
      (let content content-bounds)
      (call (. canvas translate) (. content x) (. content y))
      (let middle (/ (. content height) 2))
      (let reach (- (. content width) 6))
      (let spot (+ 3 (* reach (call clamp level 0.0 1.0))))
      (let end (if-expr is-scale (+ 3 reach) (call max spot 4.0)))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-width) 4)
      (= (. canvas stroke-color) (call RGBA "#ffffff2e"))
      (call (. canvas line) 3 middle (+ 3 reach) middle)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (. ([] stops 0) color))
      (call (. canvas circle) 3 middle 2)
      (call (. canvas fill-gradient)
        (block
          (arg (call Rect 3 (- middle 2) (- end 3) 4))
          (arg (call LinearGradient (call Point 3 0) (call Point (+ 3 reach) 0) stops))
        )
      )
      (if is-scale
        (= (. canvas fill-color) (. ([] stops (- (. stops length) 1)) color))
        (call (. canvas circle) end middle 2)
        (= (. canvas fill-color) (call RGBA "#00000040"))
        (call (. canvas circle) spot middle 6.5)
        (= (. canvas fill-color) (call RGBA "#ffffff"))
        (call (. canvas circle) spot middle 5)
      )
    )
  )
)

(fn-expr + glyph-for Glyph
  (param condition Condition)
  (param is-day Bool)
  (match condition
    (case? (> (. it storm) 0)
      (. Glyph storm)
    )
    (case? (and (> (. it snow) 0) (> (. it rain) 0))
      (. Glyph sleet)
    )
    (case? (> (. it snow) 0)
      (. Glyph snow)
    )
    (case? (> (. it rain) 0.4)
      (. Glyph rain)
    )
    (case? (> (. it rain) 0)
      (. Glyph drizzle)
    )
    (case? (> (. it fog) 0.5)
      (. Glyph fog)
    )
    (case? (> (. it gloom) 0.3)
      (. Glyph cloud)
    )
    (case? (> (. it gloom) 0)
      (if-expr is-day (. Glyph cloud-sun) (. Glyph cloud-moon))
    )
    (default
      (if-expr is-day (. Glyph sun) (. Glyph moon))
    )
  )
)

(fn-expr + chance-label String
  (param chance Percent)
  (if-expr (>= chance 20%) (call percent-label chance) "")
)

(fn-expr + warmth-color RGBA
  (param temperature Celsius)
  (match (as temperature F64)
    (case? (< it 8)
      (call blend cold-color mild-color (call ramp -6 8 it))
    )
    (case? (< it 22)
      (call blend mild-color warm-color (call ramp 8 22 it))
    )
    (default
      (call blend warm-color hot-color (call ramp 22 34 it))
    )
  )
)

(fn-expr _ strip-position F64
  (param x F64)
  (param count Size)
  (call clamp (- (/ x hour-width) 0.5) 0.0 (as (- count 1) F64))
)

(fn-expr _ curve-height F64
  (param hour Hour)
  (param low F64)
  (param span F64)
  (param height F64)
  (- (- height 14) (* (- height 24) (/ (- (as (. hour temperature) F64) low) span)))
)
