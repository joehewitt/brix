(import ./weather-forecast)
(import ./weather-sky)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/glass)
(import /math)
(import /units)
(blank)
(prop _ night-tone _ (= (call SkyTone (call RGBA "#050a1a") (call RGBA "#16244a") (call RGBA "#8fa6ff") (call RGBA "#3b4668") (call RGBA "#0e1426"))))
(prop _ dusk-tone _ (= (call SkyTone (call RGBA "#1f2f66") (call RGBA "#f08f5f") (call RGBA "#ffb070") (call RGBA "#f6b79a") (call RGBA "#4b4470"))))
(prop _ golden-tone _ (= (call SkyTone (call RGBA "#2a5aa6") (call RGBA "#f4c491") (call RGBA "#ffe0a8") (call RGBA "#fff0dc") (call RGBA "#8b8fae"))))
(prop _ day-tone _ (= (call SkyTone (call RGBA "#1754b0") (call RGBA "#6fb0ee") (call RGBA "#fff4d2") (call RGBA "#f4f8ff") (call RGBA "#8e9cb8"))))
(prop _ gray-day-tone _ (= (call SkyTone (call RGBA "#3d4a5e") (call RGBA "#7d8a9b") (call RGBA "#d3dbe4") (call RGBA "#a7b1bf") (call RGBA "#525e70"))))
(prop _ gray-night-tone _ (= (call SkyTone (call RGBA "#0a0d14") (call RGBA "#1f2530") (call RGBA "#5a6478") (call RGBA "#2b3240") (call RGBA "#10141c"))))
(prop _ storm-tone _ (= (call SkyTone (call RGBA "#1d232d") (call RGBA "#4c5562") (call RGBA "#aab4c4") (call RGBA "#7c8694") (call RGBA "#2c333e"))))
(prop _ snow-tone _ (= (call SkyTone (call RGBA "#7d8a9c") (call RGBA "#cfd6de") (call RGBA "#ffffff") (call RGBA "#eef1f5") (call RGBA "#a2acb9"))))
(prop _ sun-color _ (= (call RGBA "#fffbe6")))
(prop _ moon-color _ (= (call RGBA "#e8edff")))
(prop _ glass-tint _ (= (call RGBA "#0b162a")))

(type + SkyTone (is Tuple)
  (prop + zenith RGBA)
  (prop + horizon RGBA)
  (prop + glow RGBA)
  (prop + cloud RGBA)
  (prop + shade RGBA)
  (fn-expr + toward SkyTone
    (param other SkyTone)
    (param amount F64)
    (call SkyTone
      (block
        (arg (call blend zenith (. other zenith) amount))
        (arg (call blend horizon (. other horizon) amount))
        (arg (call blend glow (. other glow) amount))
        (arg (call blend cloud (. other cloud) amount))
        (arg (call blend shade (. other shade) amount))
      )
    )
  )
)

(fn-expr + sky-for Sky
  (param moment Moment)
  (param sun Sun)
  (call Sky (. tone zenith) (. tone horizon)
    (block
      (:glow (call (. tone glow with-alpha) (if-expr is-up (+ 0.55 (* 0.45 (- 1 daylight))) (* 0.4 moonlight))))
      (:orb (call (. (if-expr is-up sun-color moon-color) with-alpha) (if-expr is-up (call ramp 0 0.1 height) moonlight)))
      (:orb-center (call Point (+ 0.46 (* 0.46 (. sun across))) (- 0.47 (* 0.37 (call sqrt (call abs height))))))
      (:orb-radius (if-expr is-up 0.036 0.021))
      (:cloud (. tone cloud))
      (:shade (. tone shade))
      (:cover (call max (as (. moment cover) F64) (* (. condition gloom) 0.9)))
      (:stars (* (call ramp 0.05 0.4 (- height)) (- 1 (* gloom 0.85))))
      (:rain (. condition rain))
      (:snow (. condition snow))
      (:fog (. condition fog))
      (:storm (. condition storm))
    )
  )
  (where
    (lazy condition (. moment condition))
    (lazy height (. sun height))
    (lazy is-up (> height 0))
    (lazy daylight (call ramp -0.15 0.2 height))
    (lazy moonlight (call ramp 0 0.12 (- height)))
    (lazy gloom (call max (. condition gloom) (* (%% (as (. moment cover) F64) 2) 0.5)))
    (lazy clear-tone
      (match height
        (case? (< it 0)
          (call (. dusk-tone toward) night-tone (call ramp 0 0.35 (- height)))
        )
        (case? (< it 0.2)
          (call (. dusk-tone toward) golden-tone (/ height 0.2))
        )
        (default
          (call (. golden-tone toward) day-tone (call ramp 0.2 0.5 height))
        )
      )
    )
    (lazy gray-tone (call (. gray-night-tone toward) gray-day-tone daylight))
    (lazy dull-tone (call (. clear-tone toward) gray-tone gloom))
    (lazy stormy-tone (call (. dull-tone toward) storm-tone (* (. condition storm) daylight 0.8)))
    (lazy tone (call (. stormy-tone toward) snow-tone (* (. condition snow) daylight 0.6)))
  )
)

(fn-expr + glass-for LiquidGlass
  (param sun Sun)
  (call LiquidGlass 22
    (block
      (:bevel 28)
      (:refraction 30)
      (:dispersion 0.2)
      (:saturation 1.15)
      (:tint (call (. glass-tint with-alpha) (+ 0.2 (* 0.22 (call ramp -0.1 0.25 (. sun height))))))
      (:highlight 0.4)
      (:sheen 0.04)
      (:rim 0.6)
    )
  )
)

(fn-expr + frost-for Length
  (param moment Moment)
  (+ 2 (* 7 (. moment condition rain)) (* 14 (call max (. moment condition fog) (. moment condition snow))))
)

(fn-expr + ramp F64
  (param low F64)
  (param high F64)
  (param value F64)
  (* amount amount (- 3 (* 2 amount)))
  (where
    (lazy amount (call clamp (/ (- value low) (- high low)) 0.0 1.0))
  )
)

(fn-expr + blend RGBA
  (param from RGBA)
  (param to RGBA)
  (param amount F64)
  (call RGBA
    (block
      (arg (+ (. from red) (* (- (. to red) (. from red)) amount)))
      (arg (+ (. from green) (* (- (. to green) (. from green)) amount)))
      (arg (+ (. from blue) (* (- (. to blue) (. from blue)) amount)))
      (arg (+ (. from alpha) (* (- (. to alpha) (. from alpha)) amount)))
    )
  )
)
