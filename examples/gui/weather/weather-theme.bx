(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop + hour-width Length (= 58))

(style WeatherTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIBoxTransform)
  (using GUIFontStyle)
  (using GUITextPaint)
  (prop + weather-ink RGBA (= (call RGBA "#ffffff")))
  (prop + weather-soft-ink RGBA (= (call RGBA "#ffffffc2")))
  (prop + weather-faint-ink RGBA (= (call RGBA "#ffffff85")))
  (prop + weather-wet-ink RGBA (= (call RGBA "#b9deff")))
  (blank)
  (rule weather-stage (• flex-col) (• flex 1)
    (= (. motion background-fill) (call ease-in-out 1400ms))
  )
  (blank)
  (rule weather-toolbar (• bg transparent)
    (= backdrop-blur null)
    (= border-bottom-width 0)
  )
  (blank)
  (rule weather-body (• flex-row) (• flex 1))
  (blank)
  (rule weather-glass
    (= corner-radius 22)
    (= shadow (call Shadow (call RGBA "#00000030") 30 0 12))
    (= (. motion backdrop) (call ease-in-out 1400ms))
    (= (. motion backdrop-blur) (call ease-in-out 1400ms))
  )
  (blank)
  (rule rain-layer (• absolute) (• cover .parent))
  (blank)
  (rule rain-drops (• absolute) (• cover .parent)
    (= corner-radius 22)
    (= motion gui-motion-smooth)
    (= (. motion backdrop) (call ease-in-out 1400ms))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
    )
  )
  (blank)
  (rule weather-sidebar (• weather-glass) (• flex-col) (• w 236) (• ml 10) (• mb 10) (• p 10) (• gap 8))
  (blank)
  (rule city-row (• flex-row) (• items-center) (• h 68) (• px 14)
    (= corner-radius 15)
    (= border-width 1)
    (= border-color (call RGBA "#ffffff24"))
    (= motion gui-motion-quick)
    (= (. motion background-fill) (call ease-in-out 1400ms))
    (blank)
    (when-style #is-hover-within
      (= scale 1.02)
    )
    (blank)
    (when-style #is-press-within
      (= scale 0.985)
    )
    (blank)
    (when-style #is-chosen
      (= border-color (call RGBA "#ffffffe0"))
      (= border-width 1.5)
    )
  )
  (blank)
  (rule city-name (• text weather-ink)
    (= font-size 14)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule city-note (• text weather-soft-ink) (• mt 2)
    (= font-size 11)
  )
  (blank)
  (rule city-degrees (• text weather-ink)
    (= font-size 26)
    (= font-weight (. FontWeight light))
  )
  (blank)
  (rule weather-main (• flex-col) (• flex 1) (• pr 10) (• pb 10) (• pl 14) (• gap 14))
  (blank)
  (rule headline (• flex-col) (• pl 10))
  (blank)
  (rule headline-city (• text weather-ink)
    (= font-size 24)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule headline-caption (• text weather-soft-ink) (• mt 2)
    (= font-size 13)
    (= font-weight (. FontWeight medium))
  )
  (blank)
  (rule headline-degrees (• text weather-ink)
    (= font-size 104)
    (= font-weight (. FontWeight thin))
  )
  (blank)
  (rule headline-condition (• text weather-ink)
    (= font-size 20)
    (= font-weight (. FontWeight medium))
  )
  (blank)
  (rule headline-detail (• text weather-soft-ink) (• mt 4)
    (= font-size 14)
  )
  (blank)
  (rule weather-tools (• absolute) (• flex-row) (• items-center) (• gap 10))
  (blank)
  (rule card (• weather-glass) (• flex-col) (• p 16))
  (blank)
  (rule card-title (• text weather-faint-ink)
    (= font-size 11)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule card-figure (• text weather-ink) (• mt 8)
    (= font-size 28)
    (= font-weight (. FontWeight light))
  )
  (blank)
  (rule card-note (• text weather-soft-ink) (• mt 2)
    (= font-size 12)
  )
  (blank)
  (rule now-group
    (= motion gui-motion-quick)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= scale 0.8)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= scale 0.8)
    )
  )
  (blank)
  (rule hour-scroller (• flex-col) (• mt 10)
    (= overflow-x (. ScrollOverflow auto))
  )
  (blank)
  (rule hour-track (• flex-col))
  (blank)
  (rule hour-pill (• absolute) (• bg (call RGBA "#ffffff24"))
    (= corner-radius 16)
    (= border-width 1)
    (= border-color (call RGBA "#ffffff3d"))
    (= (. motion position) gui-motion-bouncy)
  )
  (blank)
  (rule hour-cell (• flex-col) (• items-center) (• py 10) (• gap 6))
  (blank)
  (rule hour-time (• text weather-soft-ink)
    (= font-size 11)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule hour-degrees (• text weather-ink)
    (= font-size 15)
    (= font-weight (. FontWeight medium))
  )
  (blank)
  (rule hour-chance (• text weather-wet-ink) (• h 12)
    (= font-size 10)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule weather-lower (• flex-row) (• flex 1) (• gap 14))
  (blank)
  (rule day-row (• flex-row) (• items-center) (• flex 1) (• gap 10)
    (= border-color (call RGBA "#ffffff1f"))
    (= border-top-width 1)
  )
  (blank)
  (rule day-name (• text weather-ink) (• w 92)
    (= font-size 14)
    (= font-weight (. FontWeight medium))
  )
  (blank)
  (rule day-chance (• text weather-wet-ink) (• w 34)
    (= font-size 11)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule day-low (• text weather-soft-ink) (• w 34)
    (= font-size 14)
    (= text-alignment (. TextAlignment right))
  )
  (blank)
  (rule day-high (• text weather-ink) (• w 34)
    (= font-size 14)
    (= font-weight (. FontWeight medium))
    (= text-alignment (. TextAlignment right))
  )
  (blank)
  (rule tile-grid (• flex-col) (• flex 1) (• gap 14))
  (blank)
  (rule tile-row (• flex-row) (• flex 1) (• gap 14))
  (blank)
  (rule tile (• card) (• flex 1))
  (blank)
  (rule tile-head (• flex-row) (• items-center) (• h 22))
  (blank)
  (rule hint (• text weather-faint-ink)
    (= font-size 11)
  )
  (blank)
  (rule sidebar-foot (• text weather-faint-ink) (• mb 4)
    (= font-size 10)
    (= text-alignment (. TextAlignment center))
  )
)
