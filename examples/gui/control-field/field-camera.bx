(import ./field-cards)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ closest-cards _ (= 1.75))
(prop _ farthest-cards _ (= 500000.0))
(prop _ smallest-cell _ (= 3.0))
(prop _ zoom-ease _ (= 0.075))

(type + FieldCamera
  (prop + center _ (= (call Point (/ cell-width 2) (/ cell-height 2))))
  (prop + scale _ (= 1.0))
  (prop + goal _ (= 1.0))
  (prop + low _ (= 0.01))
  (prop + high _ (= 4.0))
  (prop + view _ (= (call Dimensions 0 0)))
  (prop + is-placed _ (= false))
  (prop _ anchor _ (= (call Point 0 0)))
  (fn-expr + world-width F64 :get
    (/ (. view width) scale)
  )
  (fn-expr + world-height F64 :get
    (/ (. view height) scale)
  )
  (fn-expr + world-bounds Rect :get
    (call Rect (- (. center x) (/ world-width 2)) (- (. center y) (/ world-height 2)) world-width world-height)
  )
  (fn-expr + world-point Point
    (param point Point)
    (call Point (+ (. center x) (/ (- (. point x) (/ (. view width) 2)) scale)) (+ (. center y) (/ (- (. point y) (/ (. view height) 2)) scale)))
  )
  (fn-do + fit _
    (param size Dimensions)
    (param pixel-scale F64)
    (return-if (if (or (<= (. size width) 0) (<= (. size height) 0))))
    (blank)
    (= view size)
    (let area (* (. size width) (. size height)))
    (= low (call max (/ smallest-cell (* cell-width pixel-scale)) (call sqrt (/ area (* farthest-cards cell-width cell-height)))))
    (if (not is-placed)
      (= high (call sqrt (/ area (* closest-cards cell-width cell-height))))
      (= scale high)
      (= goal high)
      (= is-placed true)
    )
    (= high (call max high (* low 2)))
    (= goal (call clamp goal low high))
  )
  (fn-do + zoom-by _
    (param factor F64)
    (param point Point)
    (= anchor point)
    (= goal (call clamp (* goal factor) low high))
  )
  (fn-do + pinch _
    (param factor F64)
    (param point Point)
    (= anchor point)
    (= goal (call clamp (* goal factor) low high))
    (call zoom-to goal)
  )
  (fn-do + pan _
    (param delta Point)
    (= center (call Point (- (. center x) (/ (. delta x) scale)) (- (. center y) (/ (. delta y) scale))))
  )
  (fn-do + step _
    (param seconds F64)
    (return-if (if (== scale goal)))
    (blank)
    (let blend (- 1 (call exp (/ (- seconds) zoom-ease))))
    (let next (call exp (+ (call log scale) (* (- (call log goal) (call log scale)) blend))))
    (call zoom-to (if-expr (< (call abs (- (/ next goal) 1)) 0.0005) goal next))
  )
  (fn-do _ zoom-to _
    (param next F64)
    (let held (call world-point anchor))
    (= scale next)
    (let moved (call world-point anchor))
    (= center (call Point (+ (. center x) (- (. held x) (. moved x))) (+ (. center y) (- (. held y) (. moved y)))))
  )
)
