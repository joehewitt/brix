(import ./field-cards)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ wave-limit _ (= 12))
(prop _ wave-room _ (= 16))
(prop _ wave-crossing _ (= 3.2))
(prop _ wave-span _ (= 1.6))
(prop _ wave-life _ (= (+ (* wave-crossing wave-span) wave-reach)))
(prop _ wave-fade _ (= 0.3))
(prop _ hurried-fade _ (= 0.5))
(prop _ shortest-gap _ (= 1.6))
(prop _ longest-gap _ (= 3.4))

(type + FieldWaves
  (prop + waves (list FieldWave))
  (prop _ next-at _ (= 0.4))
  (fn-do + spawn _
    (param point Point)
    (param time F64)
    (param world Rect)
    (return-if (if (>= (. waves length) wave-room)))
    (blank)
    (if (>= (. (call alive waves time) length) wave-limit)
      (call hurry-oldest time)
    )
    (let reach (/ (call sqrt (+ (* (. world width) (. world width)) (* (. world height) (. world height)))) 2))
    (let color (call palette-at wave-palette (call random)))
    (+= waves (call FieldWave (. point x) (. point y) time (/ reach wave-crossing) (* reach wave-span) (+ time wave-life) wave-fade color))
  )
  (fn-do + advance _
    (param time F64)
    (param world Rect)
    (= waves (call unfinished waves time))
    (return-if (if (< time next-at)))
    (blank)
    (= next-at (+ time shortest-gap (* (- longest-gap shortest-gap) (call random))))
    (let x (+ (. world x) (* (. world width) (call random))))
    (let y (+ (. world y) (* (. world height) (call random))))
    (call spawn (call Point x y) time world)
  )
  (fn-expr + live (list LiveWave)
    (param time F64)
    (in (call live-wave each time) waves)
  )
  (fn-do _ hurry-oldest _
    (param time F64)
    (for (in wave waves)
      (if (> (. wave ends) time)
        (= (. wave ends) time)
        (= (. wave fade) hurried-fade)
        (return)
      )
    )
  )
)

(fn-expr _ alive (list FieldWave)
  (param waves (list FieldWave))
  (param time F64)
  (spread waves)
  (pipe ?> (> (. each ends) time))
  (pipe |> List)
)

(fn-expr _ unfinished (list FieldWave)
  (param waves (list FieldWave))
  (param time F64)
  (spread waves)
  (pipe ?> (<= time (+ (. each ends) (. each fade))))
  (pipe |> List)
)

(fn-expr _ live-wave LiveWave
  (param wave FieldWave)
  (param time F64)
  (call LiveWave (. wave x) (. wave y) (. wave start) (/ 1 (. wave speed)) (. wave span) strength (. wave color))
  (where
    (lazy strength (- 1 (call smooth-step (. wave ends) (+ (. wave ends) (. wave fade)) time)))
  )
)

(fn-expr + smooth-step F64
  (param low F64)
  (param high F64)
  (param value F64)
  (* amount amount (- 3 (* 2 amount)))
  (where
    (lazy amount (call clamp (/ (- value low) (- high low)) 0.0 1.0))
  )
)
