(import ./field-cards)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ wave-limit _ (= 80))
(prop _ wave-room _ (= 96))
(prop _ wave-crossing _ (= 3.2))
(prop _ wave-span _ (= 1.6))
(prop _ smallest-drop _ (= 0.5))
(prop _ largest-drop _ (= 1.3))
(prop _ wave-fade _ (= 0.3))
(prop _ hurried-fade _ (= 0.5))
(prop _ faintest _ (= 0.004))
(prop _ shortest-gap _ (= 0.035))
(prop _ longest-gap _ (= 0.11))

(type + FieldWaves
  (prop + waves (list FieldWave))
  (prop _ speed _ (= 0.0))
  (prop _ last _ (= 0.0))
  (prop _ next-at _ (= 0.4))
  (fn-do + spawn _
    (param point Point)
    (param time F64)
    (param size F64 (= wave-span))
    (return-if (if (>= (. waves length) wave-room)))
    (blank)
    (if (>= (. (call alive waves time) length) wave-limit)
      (call hurry-oldest time)
    )
    (let color (call palette-at wave-palette (call random)))
    (+= waves (call FieldWave (. point x) (. point y) time size (+ time (* wave-crossing size)) wave-fade color))
  )
  (fn-do + advance _
    (param time F64)
    (param world Rect)
    (let elapsed (- time last))
    (= last time)
    (= speed (/ (call sqrt (+ (* (. world width) (. world width)) (* (. world height) (. world height)))) (* 2 wave-crossing)))
    (for (in wave waves)
      (= (. wave front) (+ (. wave front) (* speed elapsed)))
    )
    (= waves (call unfinished waves time))
    (return-if (if (< time next-at)))
    (blank)
    (= next-at (+ time shortest-gap (* (- longest-gap shortest-gap) (call random))))
    (let x (+ (. world x) (* (. world width) (call random))))
    (let y (+ (. world y) (* (. world height) (call random))))
    (call spawn (call Point x y) time (+ smallest-drop (* (- largest-drop smallest-drop) (call random))))
  )
  (fn-expr + live (list LiveWave)
    (param time F64)
    (spread waves)
    (pipe *> (call live-wave each time speed))
    (pipe ?> (> (. each strength) faintest))
    (pipe |> List)
  )
  (fn-do _ hurry-oldest _
    (param time F64)
    (for (in wave waves)
      (if (> (. wave ends) time)
        (= (. wave ends) time)
        (= (. wave fade) hurried-fade)
        (return)
      )
    )
  )
)

(fn-expr _ alive (list FieldWave)
  (param waves (list FieldWave))
  (param time F64)
  (spread waves)
  (pipe ?> (> (. each ends) time))
  (pipe |> List)
)

(fn-expr _ unfinished (list FieldWave)
  (param waves (list FieldWave))
  (param time F64)
  (spread waves)
  (pipe ?> (<= time (+ (. each ends) (. each fade))))
  (pipe |> List)
)

(fn-expr _ live-wave LiveWave
  (param wave FieldWave)
  (param time F64)
  (param speed F64)
  (call LiveWave
    (block
      (arg (. wave x))
      (arg (. wave y))
      (arg (/ 1 (call max speed 1e-9)))
      (arg (. wave front))
      (arg (if-expr (> back 0) (* back back) -1.0))
      (arg (* (. wave front) (. wave front)))
      (arg (* remaining remaining (- 1 (call smooth-step (. wave ends) (+ (. wave ends) (. wave fade)) time))))
      (arg (. wave color))
    )
  )
  (where
    (lazy back (- (. wave front) (* wave-reach speed)))
    (lazy remaining (- 1 (call clamp (/ (- time (. wave start)) (* wave-crossing (. wave size))) 0.0 1.0)))
  )
)

(fn-expr + smooth-step F64
  (param low F64)
  (param high F64)
  (param value F64)
  (* amount amount (- 3 (* 2 amount)))
  (where
    (lazy amount (call clamp (/ (- value low) (- high low)) 0.0 1.0))
  )
)
