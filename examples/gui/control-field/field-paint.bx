(import ./field-cards)
(import ./field-camera)
(import ./field-waves)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/quad)
(import /math)
(blank)
(prop + field-ground _ (= (call Shade 0.035 0.04 0.05)))
(prop _ tile-ground _ (= (call Shade 0.1 0.11 0.13)))
(prop _ switch-ground _ (= (call Shade 0.24 0.25 0.28)))
(prop _ slider-ground _ (= (call Shade 0.17 0.18 0.21)))
(prop _ knob-shade _ (= (call Shade 0.96 0.96 0.97)))
(prop _ digit-shade _ (= (call Shade 0.93 0.94 0.96)))
(prop _ tile-tint _ (= 0.26))
(prop _ groove-tint _ (= 0.3))
(prop _ digit-tint _ (= 0.25))
(prop _ tile-radius _ (= 22.0))
(prop _ corner-loss _ (= 0.8584073464102069))
(prop _ tile-area _ (= (- (* tile-width tile-height) (* corner-loss tile-radius tile-radius))))
(prop _ switch-area _ (= (- (* 56.0 32.0) (* corner-loss 256.0))))
(prop _ knob-area _ (= 452.3893421169302))
(prop _ slider-area _ (= (- (* 44.0 144.0) (* corner-loss 196.0))))
(prop _ digit-masks _ (= (list 0x3f 0x06 0x5b 0x4f 0x66 0x6d 0x7d 0x07 0x7f 0x6f)))
(prop _ segment-boxes _
  (=
    (list
      (call Rect 1.5 0 15 4)
      (call Rect 14 5 4 12)
      (call Rect 14 23 4 12)
      (call Rect 1.5 36 15 4)
      (call Rect 0 23 4 12)
      (call Rect 0 5 4 12)
      (call Rect 1.5 18 15 4)
    )
  )
)
(prop _ lit-areas _ (= (call lit-table)))

(type + CardDetail (is (tuple (: switch F64) (: slider F64) (: digits F64)))
  (fn-do + This _
    (param pixels F64)
    (= switch (call smooth-step 1.0 2.5 (* 24 pixels)))
    (= slider (call smooth-step 1.0 2.2 (* 44 pixels)))
    (= digits (call smooth-step 0.3 0.8 (* 4 pixels)))
  )
  (fn-expr + is-flat Bool :get
    (and (<= switch 0) (<= slider 0) (<= digits 0))
  )
)

(type + FieldView (is Tuple)
  (prop + left F64)
  (prop + top F64)
  (prop + unit F64)
  (prop + first-column Int)
  (prop + columns Int)
  (prop + first-row Int)
  (prop + rows Int)
  (prop + detail CardDetail)
  (fn-do + This _
    (param camera FieldCamera)
    (param pixel-scale F64)
    (let world (. camera world-bounds))
    (= left (. world left))
    (= top (. world top))
    (= unit (. camera scale))
    (= first-column (as (call floor (/ left cell-width)) Int))
    (= first-row (as (call floor (/ top cell-height)) Int))
    (= columns (+ (- (as (call floor (/ (. world right) cell-width)) Int) first-column) 1))
    (= rows (+ (- (as (call floor (/ (. world bottom) cell-height)) Int) first-row) 1))
    (= detail (call CardDetail (* unit pixel-scale)))
  )
)

(fn-do + paint-rows _
  (param quads (list Quad))
  (param moment FieldMoment)
  (param view FieldView)
  (param from Int)
  (param until Int)
  (call (. quads clear))
  (let unit (. view unit))
  (for (in down (..< from until))
    (let row (+ (. view first-row) down))
    (let top (* (- (+ (* (as row F64) cell-height) tile-inset) (. view top)) unit))
    (for (in across (..< 0 (. view columns)))
      (let column (+ (. view first-column) across))
      (let left (* (- (+ (* (as column F64) cell-width) tile-inset) (. view left)) unit))
      (call emit-card quads (call (. moment sample) column row) left top unit (. view detail))
    )
  )
)

(fn-do _ emit-card _
  (param quads (list Quad))
  (param card CardSample)
  (param left F64)
  (param top F64)
  (param unit F64)
  (param detail CardDetail)
  (let fill (. card color))
  (let level (call clamp (. card slider) 0.0 1.0))
  (let toggle (call clamp (. card switch) -0.15 1.15))
  (let tile (call (. tile-ground mixed) fill tile-tint))
  (let track (call (. switch-ground mixed) fill (call clamp toggle 0.0 1.0)))
  (let groove (call (. slider-ground mixed) fill groove-tint))
  (let digit (call (. digit-shade mixed) fill digit-tint))
  (let reading (as (+ (* level 999) 0.5) Int))
  (let lit ([] lit-areas reading))
  (let height (* level 144))
  (let filled (call max 0.0 (- (* 44 height) (* corner-loss (call min 196.0 (* height height 0.25))))))
  (let bare (- tile-area switch-area slider-area lit))
  (let mean (call (. tile scaled) bare))
  (= mean (call (. mean add) track (- switch-area knob-area)))
  (= mean (call (. mean add) knob-shade knob-area))
  (= mean (call (. mean add) groove (- slider-area filled)))
  (= mean (call (. mean add) fill filled))
  (= mean (call (. mean add) digit lit))
  (if (. detail is-flat)
    (call emit-round quads (call (. mean scaled) (/ 1 tile-area)) 1 left top unit 0 0 tile-width tile-height tile-radius)
    (return)
  )
  (let w (. detail switch))
  (let s (. detail slider))
  (let d (. detail digits))
  (let drawn (call (. track scaled) (* w (- switch-area (* w knob-area)))))
  (= drawn (call (. drawn add) knob-shade (* w knob-area)))
  (= drawn (call (. drawn add) groove (* s (- slider-area (* s filled)))))
  (= drawn (call (. drawn add) fill (* s filled)))
  (= drawn (call (. drawn add) digit (* d lit)))
  (let weight (+ bare (* (- 1 w) (- switch-area (* w knob-area))) (* (- 1 s) (- slider-area (* s filled))) (* (- 1 d) lit)))
  (call emit-round quads (call (. (call (. mean add) drawn -1) scaled) (/ 1 weight)) 1 left top unit 0 0 tile-width tile-height tile-radius)
  (if (> w 0)
    (call emit-round quads track w left top unit 16 16 56 32 16)
    (call emit-round quads knob-shade w left top unit (+ 20 (* 24 toggle)) 20 24 24 12)
  )
  (if (> s 0)
    (call emit-round quads groove s left top unit 92 16 44 144 14)
    (if (> height 0.5)
      (call emit-round quads fill s left top unit 92 (- 160 height) 44 height (call min 14.0 (/ height 2)))
    )
  )
  (if (> d 0)
    (let color (call packed digit d))
    (for (in place (..< 0 3))
      (let mask (as ([] digit-masks (call digit-of reading place)) Int))
      (let x (+ 16 (* 23 (as place F64))))
      (for (in segment (..< 0 7))
        (if (!= (/and/ mask (/lshift/ 1 segment)) 0)
          (let box ([] segment-boxes segment))
          (+= quads
            (call Quad
              (block
                (arg (as (+ left (* (+ x (. box x)) unit)) F32))
                (arg (as (+ top (* (+ 120 (. box y)) unit)) F32))
                (arg (as (* (. box width) unit) F32))
                (arg (as (* (. box height) unit) F32))
                (arg (as unit F32))
                (arg color)
              )
            )
          )
        )
      )
    )
  )
)

(fn-do _ emit-round _ @inline
  (param quads (list Quad))
  (param shade Shade)
  (param alpha F64)
  (param left F64)
  (param top F64)
  (param unit F64)
  (param x F64)
  (param y F64)
  (param width F64)
  (param height F64)
  (param radius F64)
  (+= quads
    (call Quad
      (block
        (arg (as (+ left (* x unit)) F32))
        (arg (as (+ top (* y unit)) F32))
        (arg (as (* width unit) F32))
        (arg (as (* height unit) F32))
        (arg (as (* radius unit) F32))
        (arg (call packed shade alpha))
      )
    )
  )
)

(fn-expr _ channel U32 @inline
  (param value F64)
  (as (+ (* (call clamp value 0.0 1.0) 255) 0.5) U32)
)

(fn-expr _ packed U32 @inline
  (param shade Shade)
  (param alpha F64)
  (/or/ (call channel (. shade red)) (/lshift/ (call channel (. shade green)) 8) (/lshift/ (call channel (. shade blue)) 16) (/lshift/ (call channel alpha) 24))
)

(fn-expr _ digit-of Int
  (param reading Int)
  (param place Int)
  (match place
    (case= 0
      (/ reading 100)
    )
    (case= 1
      (% (/ reading 10) 10)
    )
    (default
      (% reading 10)
    )
  )
)

(fn-do _ lit-table (list F64)
  (let table (list F64))
  (for (in reading (..< 0 1000))
    (let area 0.0)
    (for (in place (..< 0 3))
      (let mask (as ([] digit-masks (call digit-of reading place)) Int))
      (for (in segment (..< 0 7))
        (if (!= (/and/ mask (/lshift/ 1 segment)) 0)
          (let box ([] segment-boxes segment))
          (+= area (* (. box width) (. box height)))
        )
      )
    )
    (+= table area)
  )
  (return table)
)
