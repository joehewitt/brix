(import /graphics/color)
(import /math)
(blank)
(prop + cell-width _ (= 176.0))
(prop + cell-height _ (= 200.0))
(prop + tile-inset _ (= 12.0))
(prop + tile-width _ (= 152.0))
(prop + tile-height _ (= 176.0))
(prop _ spring-rate _ (= 1000.0))
(prop _ spring-span _ (= 3000))
(prop _ event-jitter _ (= 0.35))
(prop _ palette-size _ (= 1024))
(prop _ smallest-card _ (= 0.5))
(prop _ slowest-spin _ (= 0.08))
(prop _ fastest-spin _ (= 0.3))
(prop _ wave-hold _ (= 0.2))
(prop _ wave-taper _ (= 0.3))
(prop + wave-reach _ (= (+ wave-hold wave-taper)))
(prop _ slider-spring _ (= (call SpringCurve 0.42 8.5)))
(prop _ switch-spring _ (= (call SpringCurve 0.5 15.0)))
(prop _ wave-pulse _ (= (call WavePulse (call SpringCurve 0.6 22.0))))
(prop _ card-palette _ (= (call rainbow 0.78 0.95)))
(prop _ card-gray _ (= (call mean-shade card-palette)))
(prop + wave-palette _ (= (call rainbow 0.6 1.0)))

(type + Shade (is (tuple (: red F64) (: green F64) (: blue F64)))
  (fn-expr + mixed Shade @inline
    (param other Shade)
    (param amount F64)
    (call Shade
      (block
        (arg (+ red (* (- (. other red) red) amount)))
        (arg (+ green (* (- (. other green) green) amount)))
        (arg (+ blue (* (- (. other blue) blue) amount)))
      )
    )
  )
  (fn-expr + scaled Shade @inline
    (param amount F64)
    (call Shade (* red amount) (* green amount) (* blue amount))
  )
  (fn-expr + add Shade @inline
    (param other Shade)
    (param amount F64)
    (call Shade
      (block
        (arg (+ red (* (. other red) amount)))
        (arg (+ green (* (. other green) amount)))
        (arg (+ blue (* (. other blue) amount)))
      )
    )
  )
  (fn-expr + rgba RGBA
    (param alpha F64)
    (call RGBA (call clamp-unit red) (call clamp-unit green) (call clamp-unit blue) alpha)
  )
)

(type + CardSample (is (tuple (: switch F64) (: slider F64) (: color Shade) (: size F64))))

(type + FieldWave
  (prop + x F64)
  (prop + y F64)
  (prop + start F64)
  (prop + size F64)
  (prop + front F64)
  (prop + ends F64)
  (prop + fade F64)
  (prop + color Shade)
  (fn-do + This _
    (param x _)
    (param y _)
    (param start _)
    (param size _)
    (param ends _)
    (param fade _)
    (param color _)
  )
)

(type + LiveWave (is (tuple (: x F64) (: y F64) (: pace F64) (: front F64) (: inner F64) (: outer F64) (: strength F64) (: color Shade))))

(type + RingSpan (is (tuple (: start Int) (: stop Int) (: ring Int))))

(type + RingSweep
  (prop + active (list RingSpan))
  (prop _ spans (list RingSpan))
  (prop _ next _ (= 0))
  (prop _ soonest _ (= 0))
  (fn-do + begin-row _
    (param waves (list LiveWave))
    (param row Int)
    (call (. spans clear))
    (call (. active clear))
    (= next 0)
    (= soonest (. Int max))
    (let center-y (* (+ (as row F64) 0.5) cell-height))
    (for (in index (..< 0 (. waves length)))
      (let wave ([] waves index))
      (let dy (- center-y (. wave y)))
      (let across (- (. wave outer) (* dy dy)))
      (if (> across 0)
        (let far (call sqrt across))
        (let hollow (- (. wave inner) (* dy dy)))
        (if (> hollow 0)
          (let near (call sqrt hollow))
          (call add-span (- (. wave x) far) (- (. wave x) near) index)
          (call add-span (+ (. wave x) near) (+ (. wave x) far) index)
          (else
            (call add-span (- (. wave x) far) (+ (. wave x) far) index)
          )
        )
      )
    )
  )
  (fn-do + reach-column _
    (param column Int)
    (while (and (< next (. spans length)) (<= (. ([] spans next) start) column))
      (call enter ([] spans next))
      (= next (+ next 1))
    )
    (return-if (if (>= soonest column)))
    (blank)
    (= soonest (. Int max))
    (let kept 0)
    (for (in index (..< 0 (. active length)))
      (let span ([] active index))
      (if (>= (. span stop) column)
        (= ([] active kept) span)
        (= kept (+ kept 1))
        (= soonest (call min soonest (. span stop)))
      )
    )
    (while (> (. active length) kept)
      (call (. active pop))
    )
  )
  (fn-do _ enter _
    (param span RingSpan)
    (= soonest (call min soonest (. span stop)))
    (let place (. active length))
    (while (and (> place 0) (> (. ([] active (- place 1)) ring) (. span ring)))
      (= place (- place 1))
    )
    (call (. active insert) span place)
  )
  (fn-do _ add-span _
    (param low F64)
    (param high F64)
    (param ring Int)
    (let start (as (call ceil (- (/ low cell-width) 0.5)) Int))
    (let stop (as (call floor (- (/ high cell-width) 0.5)) Int))
    (return-if (if (> start stop)))
    (blank)
    (let place (. spans length))
    (while (and (> place 0) (> (. ([] spans (- place 1)) start) start))
      (= place (- place 1))
    )
    (call (. spans insert) (call RingSpan start stop ring) place)
  )
)

(type + WavePulse
  (prop + samples ([] F64))
  (fn-do + This _
    (param spring SpringCurve)
    (let count (+ (as (* wave-reach spring-rate) Int) 2))
    (= samples ([] F64 count))
    (for (in index (..< 0 count))
      (let age (/ (as index F64) spring-rate))
      (let settle (call clamp (/ (- wave-reach age) (- wave-taper 0.1)) 0.0 1.0))
      (= ([] samples index) (* settle settle (- 3 (* 2 settle)) (- (call (. spring at) age) (call (. spring at) (- age wave-hold)))))
    )
  )
  (fn-expr + at F64 @inline
    (param age F64)
    (+ low (* (- high low) (- position (as index F64))))
    (where
      (lazy position (* age spring-rate))
      (lazy index (as position Int))
      (lazy low ([] samples index))
      (lazy high ([] samples (+ index 1)))
    )
  )
)

(type + SpringCurve
  (prop + samples ([] F64))
  (fn-do + This _
    (param damping F64)
    (param frequency F64)
    (let decay (* damping frequency))
    (let ringing (* frequency (call sqrt (- 1 (* damping damping)))))
    (= samples ([] F64 (+ spring-span 2)))
    (for (in index (..< 0 (+ spring-span 2)))
      (let age (/ (as index F64) spring-rate))
      (let swing (+ (call cos (* ringing age)) (* (/ decay ringing) (call sin (* ringing age)))))
      (= ([] samples index) (- 1 (* (call exp (* (- decay) age)) swing)))
    )
  )
  (fn-expr + at F64 @inline
    (param age F64)
    (case? (<= age 0)
      0.0
    )
    (case? (>= position (as spring-span F64))
      1.0
    )
    (default
      (+ low (* (- high low) (- position (as index F64))))
    )
    (where
      (lazy position (* age spring-rate))
      (lazy index (as position Int))
      (lazy low ([] samples index))
      (lazy high ([] samples (+ index 1)))
    )
  )
)

(type + FieldMoment
  (prop + time F64)
  (prop + waves (list LiveWave))
  (prop + vivid F64)
  (fn-do + This _
    (param time _)
    (param waves _)
    (param vivid _)
  )
  (fn-do + sample CardSample
    (param column Int)
    (param row Int)
    (param hits (list RingSpan))
    (let seed (call card-seed column row))
    (let traits (call scramble (/xor/ seed 0x68e31da4)))
    (let more (call scramble (/xor/ seed 0xb5297a4d)))
    (let tint (call scramble (/xor/ seed 0x2c1b3c6d)))
    (let spin (- (* 2 (call low-unit tint)) 1))
    (let rate (* (if-expr (< spin 0) -1.0 1.0) (+ slowest-spin (* (- fastest-spin slowest-spin) (call abs spin)))))
    (let hue (+ (call high-unit tint) (* time rate)))
    (let color (call (. card-gray mixed) (call palette-at card-palette hue) vivid))
    (let kick 0.0)
    (let center-x (* (+ (as column F64) 0.5) cell-width))
    (let center-y (* (+ (as row F64) 0.5) cell-height))
    (for (in hit hits)
      (let wave ([] waves (. hit ring)))
      (let dx (- center-x (. wave x)))
      (let dy (- center-y (. wave y)))
      (let age (* (- (. wave front) (call sqrt (+ (* dx dx) (* dy dy)))) (. wave pace)))
      (if (and (> age 0) (< age wave-reach))
        (let weight (* (. wave strength) (call (. wave-pulse at) age)))
        (= color (call (. color mixed) (. wave color) (call clamp weight -0.3 1.3)))
        (= kick (call max kick weight))
      )
    )
    (let slider-period (+ 1.8 (* 2.4 (call low-unit traits))))
    (let switch-period (+ 1.0 (* 3.0 (call high-unit traits))))
    (let level (call scheduled (/xor/ seed 0x3c6ef372) time slider-period (call low-unit seed) slider-spring false))
    (let toggle (call scheduled (/xor/ seed 0xa54ff53a) time switch-period (call high-unit seed) switch-spring true))
    (let lifted (call max level (+ 0.9 (* 0.08 (call high-unit more)))))
    (return (call CardSample (+ toggle (* (- 1 toggle) kick)) (+ level (* (- lifted level) kick)) color (+ smallest-card (* (- 1 smallest-card) (call low-unit more)))))
  )
)

(fn-expr + card-seed U32 @inline
  (param column Int)
  (param row Int)
  (call scramble (/xor/ (* (as column U32) 0x9e3779b1) (call scramble (+ (as row U32) 0x632be5ab))))
)

(fn-expr _ scramble U32 @inline
  (param value U32)
  (/xor/ second (/zrshift/ second 16))
  (where
    (lazy first (* (/xor/ value (/zrshift/ value 16)) 0x7feb352d))
    (lazy second (* (/xor/ first (/zrshift/ first 15)) 0x846ca68b))
  )
)

(fn-expr _ low-unit F64 @inline
  (param hash U32)
  (/ (as (/and/ hash 0xffff) F64) 65536.0)
)

(fn-expr _ high-unit F64 @inline
  (param hash U32)
  (/ (as (/zrshift/ hash 16) F64) 65536.0)
)

(fn-expr _ event-hash U32 @inline
  (param seed U32)
  (param event Int)
  (call scramble (+ seed (* (as event U32) 0x9e3779b9)))
)

(fn-expr _ event-start F64 @inline
  (param hash U32)
  (param event Int)
  (param period F64)
  (param phase F64)
  (* (+ (- (as event F64) phase) (* event-jitter (call low-unit hash))) period)
)

(fn-expr _ event-value F64 @inline
  (param hash U32)
  (param is-toggle Bool)
  (if-expr is-toggle (if-expr (< (/zrshift/ hash 16) 32768) 0.0 1.0) (+ 0.04 (* 0.92 (call high-unit hash))))
)

(fn-do _ scheduled F64
  (param seed U32)
  (param time F64)
  (param period F64)
  (param phase F64)
  (param curve SpringCurve)
  (param is-toggle Bool)
  (let guess (as (call floor (+ (/ time period) phase)) Int))
  (let guess-hash (call event-hash seed guess))
  (let guess-start (call event-start guess-hash guess period phase))
  (let is-early (< time guess-start))
  (let event (if-expr is-early (- guess 1) guess))
  (let hash (if-expr is-early (call event-hash seed event) guess-hash))
  (let start (if-expr is-early (call event-start hash event period phase) guess-start))
  (let prior-hash (call event-hash seed (- event 1)))
  (let before (call event-start prior-hash (- event 1) period phase))
  (let current (call event-value hash is-toggle))
  (let prior (call event-value prior-hash is-toggle))
  (let older (call event-value (call event-hash seed (- event 2)) is-toggle))
  (return (+ older (* (- prior older) (call (. curve at) (- time before))) (* (- current prior) (call (. curve at) (- time start)))))
)

(fn-expr + palette-at Shade @inline
  (param ring (list Shade))
  (param tone F64)
  (call (. low mixed) high (- spot (as index F64)))
  (where
    (lazy spot (* (- tone (call floor tone)) (as palette-size F64)))
    (lazy index (call min (as spot Int) (- palette-size 1)))
    (lazy low ([] ring index))
    (lazy high ([] ring (% (+ index 1) palette-size)))
  )
)

(fn-expr _ rainbow (list Shade)
  (param saturation F64)
  (param value F64)
  (spread (..< 0 palette-size))
  (pipe *> (call rainbow-shade (/ (as each F64) (as palette-size F64)) saturation value))
  (pipe |> List)
)

(fn-expr _ rainbow-shade Shade
  (param hue F64)
  (param saturation F64)
  (param value F64)
  (call Shade (. color red) (. color green) (. color blue))
  (where
    (lazy color (as (call HSVA hue saturation value 1) RGBA))
  )
)

(fn-do _ mean-shade Shade
  (param ring (list Shade))
  (let total (call Shade 0 0 0))
  (for (in shade ring)
    (= total (call (. total add) shade 1))
  )
  (return (call (. total scaled) (/ 1 (as (. ring length) F64))))
)
