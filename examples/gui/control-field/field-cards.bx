(import /graphics/color)
(import /math)
(blank)
(prop + cell-width _ (= 176.0))
(prop + cell-height _ (= 200.0))
(prop + tile-inset _ (= 12.0))
(prop + tile-width _ (= 152.0))
(prop + tile-height _ (= 176.0))
(prop _ spring-rate _ (= 1000.0))
(prop _ spring-span _ (= 3000))
(prop _ event-jitter _ (= 0.35))
(prop _ palette-size _ (= 1024))
(prop _ wave-hold _ (= 1.3))
(prop _ wave-reach _ (= 4.3))
(prop _ broad-spacing _ (= 56.0))
(prop _ fine-spacing _ (= 14.0))
(prop _ slider-spring _ (= (call SpringCurve 0.42 8.5)))
(prop _ switch-spring _ (= (call SpringCurve 0.5 15.0)))
(prop _ wave-spring _ (= (call SpringCurve 0.55 9.0)))
(prop _ card-palette _ (= (call hue-ring 0.76 0.15)))
(prop + wave-palette _ (= (call hue-ring 0.84 0.17)))

(type + Shade (is (tuple (: red F64) (: green F64) (: blue F64)))
  (fn-expr + mixed Shade @inline
    (param other Shade)
    (param amount F64)
    (call Shade
      (block
        (arg (+ red (* (- (. other red) red) amount)))
        (arg (+ green (* (- (. other green) green) amount)))
        (arg (+ blue (* (- (. other blue) blue) amount)))
      )
    )
  )
  (fn-expr + scaled Shade @inline
    (param amount F64)
    (call Shade (* red amount) (* green amount) (* blue amount))
  )
  (fn-expr + add Shade @inline
    (param other Shade)
    (param amount F64)
    (call Shade
      (block
        (arg (+ red (* (. other red) amount)))
        (arg (+ green (* (. other green) amount)))
        (arg (+ blue (* (. other blue) amount)))
      )
    )
  )
  (fn-expr + rgba RGBA
    (param alpha F64)
    (call RGBA (call clamp-unit red) (call clamp-unit green) (call clamp-unit blue) alpha)
  )
)

(type + CardSample (is (tuple (: switch F64) (: slider F64) (: color Shade))))

(type + FieldWave
  (prop + x F64)
  (prop + y F64)
  (prop + start F64)
  (prop + speed F64)
  (prop + ends F64)
  (prop + fade F64)
  (prop + color Shade)
  (fn-do + This _
    (param x _)
    (param y _)
    (param start _)
    (param speed _)
    (param ends _)
    (param fade _)
    (param color _)
  )
)

(type + LiveWave (is (tuple (: x F64) (: y F64) (: start F64) (: pace F64) (: strength F64) (: color Shade))))

(type + SpringCurve
  (prop + samples ([] F64))
  (fn-do + This _
    (param damping F64)
    (param frequency F64)
    (let decay (* damping frequency))
    (let ringing (* frequency (call sqrt (- 1 (* damping damping)))))
    (= samples ([] F64 (+ spring-span 2)))
    (for (in index (..< 0 (+ spring-span 2)))
      (let age (/ (as index F64) spring-rate))
      (let swing (+ (call cos (* ringing age)) (* (/ decay ringing) (call sin (* ringing age)))))
      (= ([] samples index) (- 1 (* (call exp (* (- decay) age)) swing)))
    )
  )
  (fn-expr + at F64 @inline
    (param age F64)
    (case? (<= age 0)
      0.0
    )
    (case? (>= position (as spring-span F64))
      1.0
    )
    (default
      (+ low (* (- high low) (- position (as index F64))))
    )
    (where
      (lazy position (* age spring-rate))
      (lazy index (as position Int))
      (lazy low ([] samples index))
      (lazy high ([] samples (+ index 1)))
    )
  )
)

(type + NoiseOctave
  (prop + columns (list Int))
  (prop + column-weights (list F64))
  (prop + rows (list Int))
  (prop + row-weights (list F64))
  (prop + stride Int)
  (prop + lattice (list F64))
  (fn-do + This _
    (param first-column Int)
    (param column-count Int)
    (param first-row Int)
    (param row-count Int)
    (param spacing F64)
    (param drift-x F64)
    (param drift-y F64)
    (param salt U32)
    (let left (as (call floor (+ (/ (as first-column F64) spacing) drift-x)) Int))
    (let top (as (call floor (+ (/ (as first-row F64) spacing) drift-y)) Int))
    (for (in index (..< 0 column-count))
      (let place (+ (/ (as (+ first-column index) F64) spacing) drift-x))
      (let cell (call floor place))
      (+= columns (- (as cell Int) left))
      (+= column-weights (call smooth (- place cell)))
    )
    (for (in index (..< 0 row-count))
      (let place (+ (/ (as (+ first-row index) F64) spacing) drift-y))
      (let cell (call floor place))
      (+= rows (- (as cell Int) top))
      (+= row-weights (call smooth (- place cell)))
    )
    (= stride (+ ([] columns (- (. columns length) 1)) 2))
    (for (in down (..< 0 (+ ([] rows (- (. rows length) 1)) 2)))
      (for (in across (..< 0 stride))
        (+= lattice (call high-unit (call scramble (/xor/ (call card-seed (+ left across) (+ top down)) salt))))
      )
    )
  )
  (fn-expr + at F64 @inline
    (param across Int)
    (param down Int)
    (+ upper (* (- lower upper) ([] row-weights down)))
    (where
      (lazy spot (+ (* ([] rows down) stride) ([] columns across)))
      (lazy blend ([] column-weights across))
      (lazy upper (+ ([] lattice spot) (* (- ([] lattice (+ spot 1)) ([] lattice spot)) blend)))
      (lazy lower (+ ([] lattice (+ spot stride)) (* (- ([] lattice (+ spot stride 1)) ([] lattice (+ spot stride))) blend)))
    )
  )
)

(type + FieldMoment
  (prop + time F64)
  (prop + waves (list LiveWave))
  (prop + first-column Int)
  (prop + first-row Int)
  (prop + broad NoiseOctave)
  (prop + fine NoiseOctave)
  (fn-do + This _
    (param time _)
    (param waves _)
    (param first-column _)
    (param first-row _)
    (param columns Int)
    (param rows Int)
    (= broad (call NoiseOctave first-column columns first-row rows broad-spacing (* time 0.021) (* time -0.013) 0x51ed27))
    (= fine (call NoiseOctave first-column columns first-row rows fine-spacing (* time -0.047) (* time 0.031) 0x2c1b3c6d))
  )
  (fn-do + sample CardSample
    (param column Int)
    (param row Int)
    (let seed (call card-seed column row))
    (let traits (call scramble (/xor/ seed 0x68e31da4)))
    (let more (call scramble (/xor/ seed 0xb5297a4d)))
    (let across (- column first-column))
    (let down (- row first-row))
    (let tone (+ 0.6 (* 0.9 (- (call (. broad at) across down) 0.5)) (* 0.3 (- (call (. fine at) across down) 0.5)) (* 0.07 (- (call low-unit more) 0.5))))
    (let color (call palette-at card-palette tone))
    (let kick 0.0)
    (let center-x (* (+ (as column F64) 0.5) cell-width))
    (let center-y (* (+ (as row F64) 0.5) cell-height))
    (for (in wave waves)
      (let dx (- center-x (. wave x)))
      (let dy (- center-y (. wave y)))
      (let age (- time (. wave start) (* (call sqrt (+ (* dx dx) (* dy dy))) (. wave pace))))
      (if (and (> age 0) (< age wave-reach))
        (let weight (* (. wave strength) (- (call (. wave-spring at) age) (call (. wave-spring at) (- age wave-hold)))))
        (= color (call (. color mixed) (. wave color) (call clamp weight -0.3 1.3)))
        (= kick (call max kick weight))
      )
    )
    (let slider-period (+ 1.8 (* 2.4 (call low-unit traits))))
    (let switch-period (+ 1.0 (* 3.0 (call high-unit traits))))
    (let level (call scheduled (/xor/ seed 0x3c6ef372) time slider-period (call low-unit seed) slider-spring false))
    (let toggle (call scheduled (/xor/ seed 0xa54ff53a) time switch-period (call high-unit seed) switch-spring true))
    (let lifted (call max level (+ 0.9 (* 0.08 (call high-unit more)))))
    (return (call CardSample (+ toggle (* (- 1 toggle) kick)) (+ level (* (- lifted level) kick)) color))
  )
)

(fn-expr + card-seed U32 @inline
  (param column Int)
  (param row Int)
  (call scramble (/xor/ (* (as column U32) 0x9e3779b1) (call scramble (+ (as row U32) 0x632be5ab))))
)

(fn-expr _ scramble U32 @inline
  (param value U32)
  (/xor/ second (/zrshift/ second 16))
  (where
    (lazy first (* (/xor/ value (/zrshift/ value 16)) 0x7feb352d))
    (lazy second (* (/xor/ first (/zrshift/ first 15)) 0x846ca68b))
  )
)

(fn-expr _ low-unit F64 @inline
  (param hash U32)
  (/ (as (/and/ hash 0xffff) F64) 65536.0)
)

(fn-expr _ high-unit F64 @inline
  (param hash U32)
  (/ (as (/zrshift/ hash 16) F64) 65536.0)
)

(fn-expr _ event-hash U32 @inline
  (param seed U32)
  (param event Int)
  (call scramble (+ seed (* (as event U32) 0x9e3779b9)))
)

(fn-expr _ event-start F64 @inline
  (param hash U32)
  (param event Int)
  (param period F64)
  (param phase F64)
  (* (+ (- (as event F64) phase) (* event-jitter (call low-unit hash))) period)
)

(fn-expr _ event-value F64 @inline
  (param hash U32)
  (param is-toggle Bool)
  (if-expr is-toggle (if-expr (< (/zrshift/ hash 16) 32768) 0.0 1.0) (+ 0.04 (* 0.92 (call high-unit hash))))
)

(fn-do _ scheduled F64
  (param seed U32)
  (param time F64)
  (param period F64)
  (param phase F64)
  (param curve SpringCurve)
  (param is-toggle Bool)
  (let guess (as (call floor (+ (/ time period) phase)) Int))
  (let guess-hash (call event-hash seed guess))
  (let guess-start (call event-start guess-hash guess period phase))
  (let is-early (< time guess-start))
  (let event (if-expr is-early (- guess 1) guess))
  (let hash (if-expr is-early (call event-hash seed event) guess-hash))
  (let start (if-expr is-early (call event-start hash event period phase) guess-start))
  (let prior-hash (call event-hash seed (- event 1)))
  (let before (call event-start prior-hash (- event 1) period phase))
  (let current (call event-value hash is-toggle))
  (let prior (call event-value prior-hash is-toggle))
  (let older (call event-value (call event-hash seed (- event 2)) is-toggle))
  (return (+ older (* (- prior older) (call (. curve at) (- time before))) (* (- current prior) (call (. curve at) (- time start)))))
)

(fn-expr _ smooth F64 @inline
  (param amount F64)
  (* amount amount (- 3 (* 2 amount)))
)

(fn-expr + palette-at Shade @inline
  (param ring (list Shade))
  (param tone F64)
  (call (. low mixed) high (- spot (as index F64)))
  (where
    (lazy spot (* (- tone (call floor tone)) (as palette-size F64)))
    (lazy index (call min (as spot Int) (- palette-size 1)))
    (lazy low ([] ring index))
    (lazy high ([] ring (% (+ index 1) palette-size)))
  )
)

(fn-expr _ hue-ring (list Shade)
  (param lightness F64)
  (param chroma F64)
  (spread (..< 0 palette-size))
  (pipe *> (call ring-shade lightness chroma (* (/ (as each F64) (as palette-size F64)) 2 π)))
  (pipe |> List)
)

(fn-expr _ ring-shade Shade
  (param lightness F64)
  (param chroma F64)
  (param angle Radians)
  (call Shade (. color red) (. color green) (. color blue))
  (where
    (lazy color (call RGBA (list lightness (* chroma (call cos angle)) (* chroma (call sin angle)) 1.0)))
  )
)
