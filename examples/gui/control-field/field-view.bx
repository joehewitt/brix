(import ./field-camera)
(import ./field-cards)
(import ./field-paint)
(import ./field-waves)
(import /core/channel)
(import /graphics/canvas)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/quad)
(import /gui)
(import /math)
(import /time/duration)
(blank)
(prop _ precise-zoom-rate _ (= 0.01))
(prop _ line-zoom-rate _ (= 0.15))
(prop _ wheel-line _ (= 40.0))
(prop _ click-slop _ (= 4.0))
(prop _ longest-step _ (= 0.1))
(prop _ band-count _ (= (* (call usable-core-count) 3)))

(type + FieldFrame
  (prop + bands (list (list Quad)))
  (fn-do + This _
    (for (in _ (..< 0 band-count))
      (+= bands (call (of List Quad)))
    )
  )
)

(type + ControlField (is Box)
  (prop + clock _ (= 0.0))
  (prop + camera _ (= (call FieldCamera)))
  (prop + waves _ (= (call FieldWaves)))
  (prop + frames-built _ (= 0))
  (prop _ shown _ (= (call FieldFrame)))
  (prop _ spare _ (= (call FieldFrame)))
  (prop _ done _ (= (call (of SyncBufferedChannel Int))))
  (prop _ pending _ (= 0))
  (prop _ pressed-at (? Point) (= null))
  (prop _ is-panning _ (= false))
  (depends invalidate-paint frames-built)
  (prop _ running _
    (machine
      (state live
        (for (on tick frames)
          (call advance (call min longest-step (as (as (. tick delta) Seconds) F64)))
        )
      )
    )
  )
  (content
    (<> This
      (for (on event scroll)
        (let modifiers (. event modifiers))
        (if (or (. modifiers command) (. modifiers control) (. modifiers option))
          (let rate (if-expr (. event is-precise) precise-zoom-rate line-zoom-rate))
          (call (. camera zoom-by) (call exp (* (- (. event delta-y)) rate)) (. event point))
          (else
            (let line (if-expr (. event is-precise) 1.0 wheel-line))
            (call (. camera pan) (call Point (* (- (. event delta-x)) line) (* (- (. event delta-y)) line)))
          )
        )
        (call (. event cancel))
      )
      (for (on event magnify)
        (call (. camera pinch) (. event scale) (. event point))
        (call (. event cancel))
      )
      (for (on event pointer-down)
        (if (== (. event button) (. PointerButton primary))
          (= pressed-at (. event point))
          (= is-panning false)
          (call (. event cancel))
        )
      )
      (for (on event pointer-drag)
        (let origin pressed-at)
        (if origin
          (if (or is-panning (>= (call (. origin distance) (. event point)) click-slop))
            (= is-panning true)
            (call (. camera pan) (. event delta))
          )
          (call (. event cancel))
        )
      )
      (for (on event pointer-up)
        (let origin pressed-at)
        (if (and origin (not is-panning) (not (. event is-interrupted)))
          (call (. waves spawn) (call (. camera world-point) (. event point)) clock (. camera world-bounds))
        )
        (= pressed-at null)
        (= is-panning false)
      )
    )
  )
  (fn-do + advance _
    (param seconds F64)
    (= clock (+ clock seconds))
    (call (. camera fit) (. bounds size) device-scale)
    (return-if (if (not (. camera is-placed))))
    (blank)
    (call finish-render)
    (call (. camera step) seconds)
    (call (. waves advance) clock (. camera world-bounds))
    (call start-render clock device-scale)
  )
  (fn-do _ start-render _
    (param time F64)
    (param pixel-scale F64)
    (call (. camera fit) (. bounds size) pixel-scale)
    (let view (call FieldView camera pixel-scale))
    (let moment (call FieldMoment time (call (. waves live) time) (. view first-column) (. view first-row) (. view columns) (. view rows)))
    (let bands (. spare bands))
    (let count (. bands length))
    (for (in index (..< 0 count))
      (let quads ([] bands index))
      (let from (/ (* (. view rows) index) count))
      (let until (/ (* (. view rows) (+ index 1)) count))
      (do-new-thread
        (call paint-rows quads moment view from until)
        (<- done index)
      )
    )
    (= pending count)
  )
  (fn-do _ finish-render _
    (return-if (if (== pending 0)))
    (blank)
    (while (> pending 0)
      (let finished (<- done))
      (= pending (- pending 1))
    )
    (let next spare)
    (= spare shown)
    (= shown next)
    (= frames-built (+ frames-built 1))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (= (. canvas fill-color) (call (. field-ground rgba) 1))
    (call (. canvas rect) (call Rect 0 0 width height))
    (for (in band (. shown bands))
      (call (. canvas quads) band)
    )
  )
)
