./gallery-shaders
./motion-kit
/graphics/color
/graphics/outline
/graphics/text
/gui
/math/motion

━━━━━━━━━━━━━━━━━━━━
• GlassTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

• glass-stage • motion-clip flex:1 mt:18
    corner-radius = 22
    background-fill = Stripes(RGBA("#2f6bff"), RGBA("#ff5fa8")) • width 18 • speed 26

• glass-art • absolute cover:.parent flex-col items-center justify-center

• glass-word
    font-size = 128
    font-weight = FontWeight.heavy
    color = RGBA("#ffffff")

• glass-layer • absolute cover:.parent flex-col items-center justify-between p:28

• glass-surface
    shadow = Shadow(RGBA("#00000038"), 18, 0, 8)
    motion.backdrop = gui-motion-smooth

• glass-bar • glass-surface flex-row items-center h:56 px:8 gap:4
    corner-radius = 28
    backdrop-blur = 6
    backdrop = LiquidGlass(28) • tint RGBA("#ffffff2e")

• glass-tab • flex-row items-center h:40 px:18
    corner-radius = 20

• glass-tab-on • bg:RGBA("#ffffff4d")

• glass-tab-text
    font-size = 14
    font-weight = FontWeight.semibold
    color = RGBA("#0b1530")

• glass-row • flex-row gap:24

• glass-pane • glass-surface flex-col justify-end w:230 h:170 p:18
    corner-radius = 30

• glass-clear
    backdrop = LiquidGlass(30) • tint RGBA("#00000014")

    when #is-hover-within
        backdrop = LiquidGlass(30) • tint RGBA("#00000014") • refraction 16 • highlight 1

• glass-regular
    backdrop-blur = 12
    backdrop = LiquidGlass(30) • tint RGBA("#ffffff54")

    when #is-hover-within
        backdrop = LiquidGlass(30) • tint RGBA("#ffffff54") • refraction 16 • highlight 1

• glass-tinted
    backdrop-blur = 8
    backdrop = LiquidGlass(30) • tint RGBA("#0a84ff80") • saturation 1.7

    when #is-hover-within
        backdrop = LiquidGlass(30) • tint RGBA("#0a84ff80") • saturation 1.7 • refraction 16 • highlight 1

• glass-pane-name
    font-size = 17
    font-weight = FontWeight.bold
    color = RGBA("#ffffff")

• glass-pane-hint • mt:3
    font-size = 12
    color = RGBA("#ffffffd9")

• glass-pane-dark
    color = RGBA("#0b1530")

• glass-button • glass-surface flex-row items-center justify-center w:72 h:72
    corner-radius = 36
    backdrop-blur = 4
    backdrop = LiquidGlass(36) • bevel 24 • tint RGBA("#ffffff26")
    motion.scale = gui-motion-bouncy

    when #is-hover-within
        backdrop = LiquidGlass(36) • bevel 24 • tint RGBA("#ffffff40") • highlight 0.9

    when #is-press-within
        scale = 1.15
        backdrop = LiquidGlass(36) • bevel 24 • tint RGBA("#ffffff66") • refraction 18 • highlight 1.2

• glass-button-text
    font-size = 30
    font-weight = FontWeight.medium
    color = RGBA("#0b1530")

━━━━━━━━━━━━━━━━━━━━
+ LiquidGlassPanel is Box
    using MotionKitTheme
    using GlassTheme

────────────────────

<This • motion-page
    <MotionHeader "Liquid glass"
        lede = "A backdrop shader that bends what's behind it through a rounded bevel, splits its colors at the rim and lights the edge, stacked on backdrop-blur for frost. Hover the panes, and press the button to swell it."
    <Box • glass-stage
        <Box • glass-art
            <Label "LIQUID" • glass-word
            <Label "GLASS" • glass-word
        <Box • glass-layer
            <Box • glass-bar
                <Box • glass-tab glass-tab-on
                    <Label "Library" • glass-tab-text
                <Box • glass-tab
                    <Label "For You" • glass-tab-text
                <Box • glass-tab
                    <Label "Browse" • glass-tab-text
                <Box • glass-tab
                    <Label "Search" • glass-tab-text
            <Box • glass-row
                <Box • glass-pane glass-clear
                    <Label "Clear" • glass-pane-name
                    <Label "No blur, a faint shade." • glass-pane-hint
                <Box • glass-pane glass-regular
                    <Label "Regular" • glass-pane-name glass-pane-dark
                    <Label "Frosted with a white tint." • glass-pane-hint glass-pane-dark
                <Box • glass-pane glass-tinted
                    <Label "Tinted" • glass-pane-name
                    <Label "Frost, accent tint, more saturation." • glass-pane-hint
            <Box • glass-button
                <Label "+" • glass-button-text
