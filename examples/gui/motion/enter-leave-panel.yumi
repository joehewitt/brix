━━━━━━━━━━━━━━━━━━━━
• EnterLeaveTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

• note-stack • flex-col mt:14
    gap = 8
    motion-stagger = 60ms

• note-card • flex-row items-center bg:gui-field-color px:12 py:10
    border-color = gui-border-color
    border-width = 1
    corner-radius = 12
    motion = gui-motion-smooth
    motion.size = gui-motion-smooth
    enter-space = EnterSpace.expand
    leave-space = LeaveSpace.collapse

    when #is-entering
        opacity = 0%%
        scale = 0.92
        translate = Point(0, -18)

    when #is-leaving
        opacity = 0%%
        translate = Point(48, 0)
        motion = spring(520ms)
        motion.size = spring(520ms)

• note-icon • w:34 h:34
    corner-radius = 10

• swatch-list • flex-col mt:14
    gap = 6
    motion-stagger = 40ms

• swatch-row • flex-row items-center bg:gui-field-color h:36 px:10
    corner-radius = 10
    motion = spring(460ms)
    motion.size = spring(460ms)
    enter-space = EnterSpace.expand
    leave-space = LeaveSpace.collapse

    when #is-entering
        opacity = 0%%
        translate = Point(-24, 0)

    when #is-leaving
        opacity = 0%%
        translate = Point(24, 0)

• swatch-dot • w:16 h:16
