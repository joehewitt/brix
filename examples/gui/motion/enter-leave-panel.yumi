━━━━━━━━━━━━━━━━━━━━
+ EnterLeavePanel is Box
    using MotionKitTheme
    using EnterLeaveTheme

+ notes [MotionNote] = enter-leave-seed()[0 .. < 3]
+ restorable [MotionNote]
+ serial Index = 3
+ filter = "all"
+ swatches [MotionSwatch] = enter-leave-swatches()
+ is-detail-shown = true

────────────────────

<This • motion-page
    <MotionHeader "Things arrive and leave"
        lede = "Removing a node from markup plays its #is-leaving rules before it goes, and its siblings close the gap. Bring a key back while it leaves and the same node revives."
    <Box • motion-row
        <MotionCard "Notifications" • flex:1.3
            <Box • flex-row mt:12
                <Button add-button "Add" • icon-plus
                    action = => do add()
                <Button clear-button "Clear all" • ml:8
                    action = => do clear()
                <Button undo-button "Undo" • ml:8
                    action = => do undo()
            <Box • note-stack
                for note in #notes keyed by note.id
                    <NoteCard
                        note = note
        <MotionCard "Filtered list" • flex:1
            <SegmentedControl'String • mt:12
                selected = #filter
                for event on selection-changed
                    filter = event.value
                <Segment'String all-segment "All"
                    value = "all"
                <Segment'String warm-segment "Warm"
                    value = "warm"
                <Segment'String cool-segment "Cool"
                    value = "cool"
            <Box • swatch-list
                for swatch in shown-swatches(#swatches, #filter) keyed by swatch.name
                    <Box • swatch-row
                        <Box • swatch-dot
                            background-color = swatch.hue
                        <Label • ml:10
                            text = swatch.name
        <MotionCard "Display" • flex:1
            <Box • flex-row mt:12
                <Button detail-button
                    title = if #is-detail-shown then "Hide details" else "Show details"
                    action = => do toggle-details()
            <Box • profile
                <Box • profile-head
                    <Box • avatar
                        background = motion-glow(5)
                    <Box • flex-col ml:12 flex:1
                        <Label "Ada Okafor" • motion-card-title
                        <Label "Motion designer" • motion-note mt:2
                <Box • profile-details
                    display = if #is-detail-shown then Display.visible else Display.hidden
                    <ProfileRow
                        key = "Email"
                        value = "ada@example.com"
                    <ProfileRow
                        key = "Studio"
                        value = "Lagos · Remote"
                    <ProfileRow
                        key = "Projects"
                        value = "Springs, Flights, Reels"
                    <ProfileRow
                        key = "Joined"
                        value = "March 2024"
                <Box • profile-footer
                    <Box • w:8 h:8
                        corner-radius = 4
                        background-color = motion-hue(2)
                    <Label "Active 2 minutes ago" • motion-note ml:8

────────────────────
+ do add

serial += 1
. seeds = enter-leave-seed()
. seed = seeds[serial % seeds.length]
. made = MotionNote(serial, seed.title, seed.body, serial)
. next = List'MotionNote()
next += made
for note in notes
    if next.length < note-limit
        next += note
restorable = List'MotionNote()
notes = next

────────────────────
+ do dismiss
    - id Index

restorable = notes
. next = List'MotionNote()
for note in notes
    if note.id != id
        next += note
notes = next

────────────────────
+ do clear

restorable = notes
notes = List'MotionNote()

────────────────────
+ do undo

=? if restorable.length == 0
notes = restorable
restorable = List'MotionNote()

────────────────────
+ do toggle-details

is-detail-shown = !is-detail-shown

━━━━━━━━━━━━━━━━━━━━
+ NoteCard is Box
    using MotionKitTheme
    using EnterLeaveTheme

+ note MotionNote

_ owner Ancestor'EnterLeavePanel

────────────────────

<This • note-card
    <Box • note-icon
        background = motion-glow(note.hue)
    <Box • flex-col flex:1 ml:12
        <Label • motion-label
            text = note.title
        <Label • motion-note mt:2
            text = note.body
    <IconButton dismiss • icon-x w:24 h:24 ml:8
        action = => do owner?.dismiss(note.id)

━━━━━━━━━━━━━━━━━━━━
+ ProfileRow is Box
    using MotionKitTheme
    using EnterLeaveTheme

+ key = ""
+ value = ""

────────────────────

<This • profile-row
    <Label • motion-caption w:90
        text = #key
    <Label • flex:1
        text = #value

━━━━━━━━━━━━━━━━━━━━
_ shown-swatches [MotionSwatch]
    - swatches [MotionSwatch]
    - filter String

** swatches
?> filter == "all" || (filter == "warm") == each.is-warm
|> List

