━━━━━━━━━━━━━━━━━━━━
• ReorderTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

+ reorder-settle Motion = spring(420ms, 0.22)

• playlist-row • bg:gui-well-color flex-row items-center h:54 px:12 mb:8
    corner-radius = 12
    motion.position = reorder-settle
    motion.scale = gui-motion-quick

    when #is-carried
        • bg:gui-field-color
        shadow = gui-lifted-shadow
        scale = 1.03

• playlist-grip • text:gui-muted-text-color w:16 h:16 mr:10

• playlist-art • w:36 h:36 mr:12
    corner-radius = 8

• mood-strip • flow-row h:48

• mood-chip • flex-row items-center h:40 px:15 mr:8
    corner-radius = 20
    motion.position = reorder-settle
    motion.scale = gui-motion-quick

    when #is-carried
        shadow = gui-lifted-shadow
        scale = 1.08

• mood-name • text:gui-strong-text-color
    font-size = 14
    font-weight = FontWeight.semibold

• mood-bar • flex-row h:170
    corner-radius = 18

• mood-segment • flex-col justify-end p:12
    motion.position = reorder-settle
    motion.size = reorder-settle

• mood-segment-name • text:gui-strong-text-color
    font-size = 13
    font-weight = FontWeight.bold

• order-readout • text:gui-muted-text-color
    font-size = 13
    text-wrap = TextWrap.word

━━━━━━━━━━━━━━━━━━━━
+ ReorderPanel is Box
    using MotionKitTheme
    using ReorderTheme

────────────────────

<This • motion-page
    <MotionHeader "Drag to reorder"
        lede = "A drag started with event.carry(payload) lifts the item itself. Its siblings make room under their own motion.position, and on drop it settles into its new slot at the speed it was thrown."
    <Box • motion-row
        <MotionCard "Playlist" • w:520
            note = "Drag a row by any part of it. #is-carried lifts it with a shadow."
            <PlaylistView playlist • flex-col flex:1 mt:12
        <MotionCard "Moods" • flex:1
            note = "A flow row projects the carried chip's slot the same way. The mix below follows the model, so its segments slide when a drop reorders it."
            <MoodStrip moods • flex-col flex:1 mt:14

━━━━━━━━━━━━━━━━━━━━
+ PlaylistView is Box
    using MotionKitTheme
    using ReorderTheme

+ songs [ReorderSong] = reorder-songs()

────────────────────

<This
    <Box rows • flex-col
        for song in #songs keyed by song.id
            <PlaylistRow
                song = song

────────────────────
for event on drag-over

if event.payload is PlaylistDrag
    . drag = event.payload as PlaylistDrag
    if drag.view == this
        event.accept(this)

────────────────────
for event on drop

if event.payload is PlaylistDrag
    . drag = event.payload as PlaylistDrag
    . index = drag.row.carry-slot
    if drag.view == this && index != null
        move(drag.row.song.id, index)

────────────────────
+ do move
    - id Int
    - index Index

. moving = List'ReorderSong(each in songs when each.id == id)
=? if moving.length == 0
. rest = List'ReorderSong(each in songs when each.id != id)
. split = if index < rest.length then index else rest.length
songs = List'ReorderSong(rest[0 .. < split]) ++ moving ++ rest[split .. < rest.length]

━━━━━━━━━━━━━━━━━━━━
+ PlaylistRow is Box
    using MotionKitTheme
    using ReorderTheme

+ song ReorderSong

_ view Ancestor'PlaylistView

────────────────────

<This • playlist-row
    <LucideGripVertical • icon playlist-grip
    <Box • playlist-art
        background = motion-glow(#song.hue)
    <Box • flex-col flex:1
        <Label • motion-label
            text = #song.title
        <Label • motion-note mt:2
            text = #song.artist
    <Label • motion-caption
        text = #song.length

────────────────────
for event on drag-start

. owner = view
if owner
    . ignored = event.carry(PlaylistDrag(owner, this))

━━━━━━━━━━━━━━━━━━━━
+ MoodStrip is Box
    using MotionKitTheme
    using ReorderTheme

+ moods [ReorderMood] = reorder-moods()

────────────────────

<This
    <Box chips • mood-strip
        for mood in #moods keyed by mood.id
            <MoodChip
                mood = mood
    <Label "THE MIX" • motion-tag mt:26 mb:8
    <Box • mood-bar
        for mood in #moods keyed by mood.id
            <Box • mood-segment
                flex = mood.share
                background = motion-glow(mood.hue)
                <Label • mood-segment-name
                    text = mood.name
    <Label • order-readout mt:12
        text = mood-order(#moods)

────────────────────
for event on drag-over

if event.payload is MoodDrag
    . drag = event.payload as MoodDrag
    if drag.view == this
        event.accept(this)

────────────────────
for event on drop

if event.payload is MoodDrag
    . drag = event.payload as MoodDrag
    . index = drag.chip.carry-slot
    if drag.view == this && index != null
        move(drag.chip.mood.id, index)

────────────────────
+ do move
    - id Int
    - index Index

. moving = List'ReorderMood(each in moods when each.id == id)
=? if moving.length == 0
. rest = List'ReorderMood(each in moods when each.id != id)
. split = if index < rest.length then index else rest.length
moods = List'ReorderMood(rest[0 .. < split]) ++ moving ++ rest[split .. < rest.length]

━━━━━━━━━━━━━━━━━━━━
+ MoodChip is Box
    using MotionKitTheme
    using ReorderTheme

+ mood ReorderMood

_ view Ancestor'MoodStrip

────────────────────

<This • mood-chip
    background = motion-glow(#mood.hue)
    <Label • mood-name
        text = #mood.name

────────────────────
for event on drag-start

. owner = view
if owner
    . ignored = event.carry(MoodDrag(owner, this))

━━━━━━━━━━━━━━━━━━━━
+ mood-order String
    - moods [ReorderMood]

"Order: ${" → ".join(List'String(each.name in moods))}"

