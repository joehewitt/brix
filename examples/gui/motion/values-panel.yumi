. amount-changed < amount

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

. center = Point(bounds.x + bounds.width / 2, bounds.y + bounds.height / 2)
. radius = min(bounds.width, bounds.height) / 2 - ring-width / 2
do use canvas.saved-state
    canvas.fill-color = null
    canvas.stroke-width = ring-width
    canvas.stroke-cap = LineCap.round
    canvas.stroke-color = RGBA("#ffffff14")
    canvas.circle(center.x, center.y, radius)
    . sweep = clamp(amount, 0.0, 1.0)
    =? if sweep <= 0
    canvas.stroke-color = ring-color(sweep)
    . steps = max(2, round(sweep * 96) as Int)
    canvas.begin()
    for index in 0 .. steps
        . angle = -π / 2 + 2 * π * sweep * (index as F64) / (steps as F64)
        . point = Point(center.x + cos(angle) * radius, center.y + sin(angle) * radius)
        if index == 0
            canvas.move(point.x, point.y)
        else
            canvas.line(point.x, point.y)
    canvas.end()

────────────────────
_ do amount-changed

invalidate-paint()

