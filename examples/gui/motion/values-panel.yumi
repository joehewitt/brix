_ stat-text String
    - index Index
    - value F64

|? index == 0
    grouped(value)
|? index == 1
    "\$${grouped(value)}"
|? index == 2
    "${round(value * 10) / 10}%"
??
    "${round(value) as Int} ms"

━━━━━━━━━━━━━━━━━━━━
_ delta-text String
    - index Index
    - change F64

"${if change >= 0 then "▲" else "▼"} ${round(abs(change) * 10) / 10}% vs last week"

━━━━━━━━━━━━━━━━━━━━
_ grouped String
    - value F64

|? whole < 1000
    "$whole"
??
    "${grouped(high as F64)},$tail"

.. whole = round(abs(value)) as Int
.. high = whole / 1000
.. low = whole % 1000
.. tail = if low < 10 then "00$low" else if low < 100 then "0$low" else "$low"

━━━━━━━━━━━━━━━━━━━━
_ ring-color RGBA
    - amount F64

|? amount < 0.4
    motion-hue(7)
|? amount < 0.7
    motion-hue(1)
??
    motion-hue(2)
