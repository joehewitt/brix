+ BurstField is Box
    using MotionKitTheme

_ sparks = List'Spark()
_ event flights Bool

• This • motion-clip

────────────────────
_ flight ~>

~> is-resting
    then is-flying on flights when each

~> is-flying
    for tick on frames
        advance(tick.delta)

    then is-resting on flights when !each

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

do use canvas.saved-state
    canvas.stroke-color = null
    for spark in sparks
        . fade = clamp(spark.life, 0.0, 1.0)
        canvas.fill-color = spark.color.with-alpha(fade)
        canvas.circle
            - bounds.x + spark.place.x
            - bounds.y + spark.place.y
            - spark.size * (0.4 + 0.6 * fade)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do burst

. origin = Point(bounds.width / 2, bounds.height * 0.78)
for index in 0 .. < 90
    . angle = -π / 2 + (next-random() - 0.5) * 1.6
    . pace = 260 + 520 * next-random()
    . speed = Point(cos(angle) * pace, sin(angle) * pace)
    sparks += Spark
        - origin
        - speed
        - 0.9 + 0.8 * next-random()
        - motion-hue(index)
        - 2.5 + 3.5 * next-random()
flights <- true

────────────────────
_ do advance
    - delta Nanoseconds

. seconds = (delta as Seconds) as F64
. kept = List'Spark()
for spark in sparks
    spark.speed = Point(spark.speed.x * 0.99, spark.speed.y + spark-gravity * seconds)
    spark.place = Point
        - spark.place.x + spark.speed.x * seconds
        - spark.place.y + spark.speed.y * seconds
    spark.life -= seconds
    if spark.life > 0
        kept += spark
sparks = kept
invalidate-paint()
if sparks.length == 0
    flights <- false

