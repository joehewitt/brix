────────────────────

<This • motion-page
    <MotionHeader "Numbers that move themselves"
        lede = "Every figure here is animated(#value, spring(…)) in the attribute that shows it. Press Randomize twice quickly: each value turns toward its new target with the speed it had."
        <Button randomize-button "Randomize" • ml:20
            action = => do randomize()
    <Box • flex-row h:122 mt:20 gap:16
        for index in 0 .. < stat-names.length
            <Box • stat-card
                <Label • stat-name
                    text = stat-names[index]
                <Label • stat-value
                    text = stat-text(index, animated(#stats[index], spring(900ms + 150ms * index)))
                <Label • stat-delta
                    text = delta-text(index, animated(#changes[index], spring(900ms)))
                    color = if #changes[index] >= 0 then motion-hue(2) else motion-hue(7)
    <Box • motion-row mt:18
        <MotionCard "Sessions by month" • flex:1
            note = "Bars change height by layout motion, under spring(700ms, 0.4)."
            <Box • chart
                for index in 0 .. < bar-count
                    <Box • chart-bar
                        background = motion-glow(index)
                        min-height = SizeSpec.coord(#bars[index] * bar-reach)
                        max-height = SizeSpec.coord(#bars[index] * bar-reach)
        <MotionCard "Health score" • items-center w:250
            <Box • ring-stage
                <ScoreRing • absolute cover:.parent
                    amount = animated(#score, spring(1400ms, 0.3))
                <Label • ring-score
                    text = "${round(animated(#score, spring(1400ms, 0.3)) * 100) as Int}"
                <Label "OUT OF 100" • ring-caption
        <MotionCard "Sparks" • w:280
            note = "A frames loop that runs only while sparks are in the air."
            <BurstField burst • motion-well flex:1 mt:12
            <Button burst-button "Burst" • mt:12
                action = => do burst.burst()

────────────────────
+ do randomize

. next-stats = List'F64()
. next-changes = List'F64()
for index in 0 .. < stats.length
    . base = stats[index]
    . factor = 0.7 + 0.6 * next-random()
    . value = if index == 2 then round(base * factor * 10) / 10 else round(base * factor)
    next-stats += value
    next-changes += (value - base) / base * 100
stats = next-stats
changes = next-changes
. next-bars = List'F64()
for index in 0 .. < bar-count
    next-bars += 0.15 + 0.85 * next-random()
bars = next-bars
score = 0.2 + 0.78 * next-random()
burst.burst()

