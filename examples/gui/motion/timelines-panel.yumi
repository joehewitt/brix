━━━━━━━━━━━━━━━━━━━━
+ TimelinesPanel is Box
    using MotionKitTheme
    using TimelinesTheme

+ amount = 0.0
+ is-playing = false
+ chapters [ArticleChapter] = article-chapters()

────────────────────

<This • motion-page
    <MotionHeader "Animations that follow something other than time"
        lede = "A timeline drives an animation by progress instead of the clock. Scroll the article, or drag the slider to scrub a keyframe animation back and forth."
    <Box • motion-row
        <Box • article-card
            <Box article • article-scroller
                <Box • article-hero
                    background = MotionGradient(motion-hue(5), motion-hue(7))
                    <Label "Motion, made of values" • article-hero-title
                    <Label "Scroll to watch this header recede." • article-hero-copy
                for index in 0 .. < chapters.length
                    <Box • article-section
                        <Box • article-badge
                            background-color = motion-hue(index)
                        <Box • flex-col flex:1
                            <Label • motion-card-title
                                text = chapters[index].title
                            <Label • article-section-copy
                                text = chapters[index].copy
            <Box • article-header
                left = PositionOffset.coord(0)
                right = PositionOffset.coord(0)
                top = PositionOffset.coord(0)
                <Label "Motion, made of values" • article-compact
                    timeline = scroll-timeline(150 .. 210, article)
                <Box • flex:1
                <Label "8 chapters" • motion-tag
            <Box • article-rule
                left = PositionOffset.coord(0)
                right = PositionOffset.coord(0)
                top = PositionOffset.coord(51)
                <Box • article-divider
                    left = PositionOffset.coord(0)
                    right = PositionOffset.coord(0)
                    top = PositionOffset.coord(1)
                    timeline = scroll-timeline(170 .. 230, article)
                <Box • article-progress
                    left = PositionOffset.coord(0)
                    top = PositionOffset.coord(0)
                    background = MotionGradient(motion-hue(4), motion-hue(7))
                    timeline = scroll-timeline(0 .. article-reach, article)
        <MotionCard "Scrub a keyframe animation" • flex:1
            note = "One animation with translate, rotate, scale, color and corner tracks. progress-timeline(#amount) samples all of them at the slider's value. Play hands it back to the clock."
            <Box • voyage-stage
                <VoyagePath • absolute cover:.parent
                for index in 0 .. < voyage-stops.length
                    <Box • voyage-stop
                        left = PositionOffset.coord(stop-center(index).x - 6)
                        top = PositionOffset.coord(stop-center(index).y - 6)
                <Box comet • voyage-comet
                    left = PositionOffset.coord(comet-inset)
                    top = PositionOffset.coord(comet-inset)
                    timeline = scrub-timeline(#is-playing, #amount)
            <Box • flex-row items-center mt:14
                <Slider scrubber • flex:1 h:24
                    minimum = 0
                    maximum = 1
                    value = #amount
                    for event on value-changing
                        scrub(event.value)
                    for event on value-changed
                        scrub(event.value)
                <Label • voyage-readout
                    text = "${round(#amount * 100) as Int}%"
                <Button play-button "Play" • ml:14
                    action = => do play()

────────────────────
+ do scrub
    - value F64

is-playing = false
amount = value

────────────────────
+ do play

is-playing = true

━━━━━━━━━━━━━━━━━━━━
+ VoyagePath is Box

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-self
    - canvas Canvas

do use canvas.saved-state
    canvas.fill-color = null
    canvas.stroke-color = RGBA("#ffffff2e")
    canvas.stroke-width = 2
    canvas.stroke-dash = 6
    canvas.begin()
    . first = stop-center(0)
    canvas.move(bounds.x + first.x, bounds.y + first.y)
    for index in 1 .. < voyage-stops.length
        . next = stop-center(index)
        canvas.line(bounds.x + next.x, bounds.y + next.y)
    canvas.end()

━━━━━━━━━━━━━━━━━━━━
_ stop-center Point
    - index Index

Point
    - comet-inset + comet-size / 2 + voyage-stops[index].x
    - comet-inset + comet-size / 2 + voyage-stops[index].y

━━━━━━━━━━━━━━━━━━━━
_ scrub-timeline AnimationTimeline?
    - is-playing Bool
    - amount F64

progress-timeline(amount) if !is-playing

━━━━━━━━━━━━━━━━━━━━
_ article-chapters [ArticleChapter]

* ArticleChapter("Springs", "Targets change and springs carry their speed into the new one, so an interrupted motion turns around instead of restarting.")
* ArticleChapter("Keyframes", "A theme declares an animation with tracks and stops. A rule names it, and code can play it and wait for it to finish.")
* ArticleChapter("Enter and leave", "Removed nodes stay until their leave has played. Siblings close the gap under their own size motion.")
* ArticleChapter("Layout motion", "A box that layout moves travels from its old frame. The scene re-composites it without repainting a pixel.")
* ArticleChapter("Shared elements", "Two boxes with one match key hand off: the new one flies from where the old one was, above every clip.")
* ArticleChapter("Drag to reorder", "A carried item follows the pointer while its siblings make room, then lands at the speed it was thrown.")
* ArticleChapter("Timelines", "This article: the header, the title above and the bar at the top are all sampled from the scroll offset.")
* ArticleChapter("Animated values", "A computed number moves with animated(target, motion), right in the markup attribute that shows it.")
