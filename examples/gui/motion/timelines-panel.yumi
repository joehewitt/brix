• hero-recede animation 1s
    translate = Point(0, 0) .. Point(0, 90)
    scale = 1 .. 0.86
    opacity = 1%% .. 0%%

• compact-in animation 1s
    translate = Point(0, 10) .. Point(0, 0)
    opacity = 0%% .. 1%%

• divider-in animation 1s
    opacity = 0%% .. 1%%

• read-progress animation 1s
    translate = Point(-article-width, 0) .. Point(0, 0)

• voyage animation 1600ms
    repeat = Repeat.forever
    direction = AnimationDirection.alternate
    translate
        at 0% = voyage-stops[0]
        at 25% = voyage-stops[1]
        at 50% = voyage-stops[2]
        at 75% = voyage-stops[3]
        at 100% = voyage-stops[4]
    rotate = 0 .. 2 * π
    scale
        at 0% = 0.7
        at 50% = 1.3
        at 100% = 0.8
    background-color
        at 0% = RGBA("#f97316")
        at 33% = RGBA("#ec4899")
        at 66% = RGBA("#6366f1")
        at 100% = RGBA("#14b8a6")
    corner-radius
        at 0% = 8
        at 50% = 26
        at 100% = 8

