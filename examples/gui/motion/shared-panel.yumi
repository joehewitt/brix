./motion-kit
/graphics/color
/graphics/outline
/graphics/point
/graphics/primitives
/graphics/text
/gui
/math
/math/motion
/time/duration
/units

_ shared-track-names = ["Undertow", "Glass Hours", "Satellite Hearts", "Fold", "Warm Static", "Night Bus", "Afterglow", "Small Weather", "Kites", "Halflight", "Vapor Trail", "Lantern"]

━━━━━━━━━━━━━━━━━━━━
+ SharedAlbum is Tuple

+ id Int
+ title String
+ artist String
+ year Int
+ hue Index

━━━━━━━━━━━━━━━━━━━━
• SharedTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

+ shared-flight Motion = spring(560ms, 0.16)

• album-grid • gap:22
    layout = GridLayout
        - [GridTrack.flex(1), GridTrack.flex(1), GridTrack.flex(1), GridTrack.flex(1)]

• album-tile • flex-col
    motion.translate = gui-motion-quick

    when #is-hovered
        translate = Point(0, -4)

• album-art
    corner-radius = 14
    shadow = Shadow(RGBA("#00000059"), 16, 0, 6)
    motion.layout = shared-flight

• album-title • text:gui-strong-text-color
    font-size = 14
    font-weight = FontWeight.semibold
    align-x = Alignment.start
    resize-content = ResizeContent.scale
    match-content = MatchContent.crossfade
    motion.layout = shared-flight

• AlbumTile
    when #is-picked
        • album-art
            opacity = 0%%

        • album-title
            opacity = 0%%

• AlbumRow
    when #is-picked
        • album-art
            opacity = 0%%

        • album-title
            opacity = 0%%

• album-artist • motion-caption
    motion.opacity = ease-out(260ms)

    when #is-entering
        opacity = 0%%

• album-list • flex-col

• album-row • flex-row items-center h:60 mb:6 px:6
    corner-radius = 12
    motion.background-color = gui-motion-quick

    when #is-hovered
        • bg:gui-hover-color

• album-year • motion-caption mr:10
    motion.opacity = ease-out(260ms)

    when #is-entering
        opacity = 0%%

• album-scrim • bg:gui-panel-color
    corner-radius = 16
    motion.opacity = ease-out(220ms)

    when #is-entering
        opacity = 0%%

    when #is-leaving
        opacity = 0%%

• detail-art
    corner-radius = 26
    shadow = Shadow(RGBA("#0000008c"), 34, 0, 14)
    motion.layout = shared-flight

• detail-title • text:gui-strong-text-color
    font-size = 34
    font-weight = FontWeight.bold
    align-x = Alignment.start
    resize-content = ResizeContent.scale
    match-content = MatchContent.crossfade
    motion.layout = shared-flight

• detail-fade
    motion = gui-motion-smooth

    when #is-entering
        opacity = 0%%
        translate = Point(0, 10)

    when #is-leaving
        opacity = 0%%
        motion.opacity = ease-out(120ms)

• detail-tracks • flex-col
    motion-stagger = 45ms

• detail-track • flex-row items-center h:36
    border-color = gui-border-color
    border-bottom-width = 1
    motion = gui-motion-smooth

    when #is-entering
        opacity = 0%%
        translate = Point(24, 0)

    when #is-leaving
        opacity = 0%%
        motion.opacity = ease-out(100ms)

• detail-track-title • text:gui-text-color flex:1
    font-size = 14

━━━━━━━━━━━━━━━━━━━━
+ SharedPanel is Box
    using MotionKitTheme
    using SharedTheme

+ albums [SharedAlbum] = shared-albums()
+ open-id = -1
+ shown-id = 0
+ is-list = false
+ is-open = #open-id >= 0

────────────────────

<This • motion-page
    <MotionHeader "Shared elements"
        lede = "Two boxes with one match key: when one goes and the other arrives in the same frame, the new one flies from where the old one was. Open an album, or switch the layout."
        <SegmentedControl'Bool • ml:24
            selected = #is-list
            for event on selection-changed
                is-list = event.value
            <Segment'Bool grid-segment "Grid"
                value = false
            <Segment'Bool list-segment "List"
                value = true
    <Box • motion-card flex:1 mt:18
        if #is-list
            <Box • album-list
                for album in #albums keyed by album.id
                    <AlbumRow
                        album = album
                        open-id = #open-id
        else
            <Box • album-grid
                for album in #albums keyed by album.id
                    <AlbumTile
                        album = album
                        open-id = #open-id
        if #is-open
            <Box • album-scrim absolute cover:.parent
            <AlbumDetail detail • absolute cover:.parent
                album = album-of(#shown-id)

────────────────────
+ do open
    - id Int

shown-id = id
open-id = id

────────────────────
+ do dismiss

open-id = -1

────────────────────
+ do album-of SharedAlbum
    - id Int

for album in albums
    =? album if album.id == id
= albums[0]

━━━━━━━━━━━━━━━━━━━━
+ AlbumTile is Box
    using MotionKitTheme
    using SharedTheme

+ album SharedAlbum
+ open-id = -1
+ is-picked = #open-id == #album.id

_ owner Ancestor'SharedPanel

────────────────────

<This • album-tile
    <Box art • album-art h:168
        background = motion-glow(#album.hue)
        match = if #is-picked then null else "art-${#album.id}"
    <Label • album-title mt:10
        text = #album.title
        match = if #is-picked then null else "title-${#album.id}"
    <Label • album-artist mt:2
        text = #album.artist

────────────────────
for event on click

owner?.open(album.id)

━━━━━━━━━━━━━━━━━━━━
+ AlbumRow is Box
    using MotionKitTheme
    using SharedTheme

+ album SharedAlbum
+ open-id = -1
+ is-picked = #open-id == #album.id

_ owner Ancestor'SharedPanel

────────────────────

<This • album-row
    <Box art • album-art w:48 h:48
        background = motion-glow(#album.hue)
        corner-radius = 10
        match = if #is-picked then null else "art-${#album.id}"
    <Box • flex-col flex:1 ml:14
        <Label • album-title
            text = #album.title
            match = if #is-picked then null else "title-${#album.id}"
        <Label • album-artist mt:2
            text = #album.artist
    <Label • album-year
        text = "${#album.year}"

────────────────────
for event on click

owner?.open(album.id)

━━━━━━━━━━━━━━━━━━━━
+ AlbumDetail is Box
    using MotionKitTheme
    using SharedTheme

+ album SharedAlbum

_ owner Ancestor'SharedPanel

────────────────────

<This • flex-row p:28
    <Box • detail-art w:360 h:360
        background = motion-glow(#album.hue)
        match = "art-${#album.id}"
    <Box • flex-col flex:1 ml:34
        <Box • flex-row items-center
            <Label "ALBUM" • motion-tag detail-fade flex:1
            <Button close-button "Close" • detail-fade
                action = => do owner?.dismiss()
        <Label • detail-title mt:6
            text = #album.title
            match = "title-${#album.id}"
        <Label • motion-lede detail-fade mt:4
            text = "${#album.artist} · ${#album.year} · 6 songs"
        <Box • detail-tracks mt:22
            for index in 0 .. < 6
                <Box • detail-track
                    <Label • motion-caption w:30
                        text = "${index + 1}"
                    <Label • detail-track-title
                        text = shared-track(#album, index)
                    <Label • motion-note
                        text = shared-length(#album, index)

━━━━━━━━━━━━━━━━━━━━
+ shared-track String
    - album SharedAlbum
    - index Index

shared-track-names[(album.id * 5 + index * 7) % shared-track-names.length]

━━━━━━━━━━━━━━━━━━━━
+ shared-length String
    - album SharedAlbum
    - index Index

"${2 + (album.id + index * 3) % 4}:${10 + (album.id * 13 + index * 17) % 50}"

