━━━━━━━━━━━━━━━━━━━━
+ MotionHeader is Box
    using MotionKitTheme

+ title = ""
+ lede = ""

────────────────────
+ This
    - title = ""

────────────────────

<This • flex-row items-end
    <Box • flex-col flex:1
        <Label • motion-title
            text = #title
        <Label • motion-lede
            text = #lede

━━━━━━━━━━━━━━━━━━━━
+ MotionCard is Box
    using MotionKitTheme

+ title = ""
+ note = ""

────────────────────
+ This
    - title = ""

────────────────────

<This • motion-card
    <Label • motion-card-title
        text = #title
    if #note != ""
        <Label • motion-note mt:4
            text = #note

