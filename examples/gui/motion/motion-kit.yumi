• motion-page • flex-col flex:1 p:28
    font-size = 13

• motion-row • flex-row flex:1 mt:20 gap:18

• motion-title • text:gui-strong-text-color
    font-size = 26
    font-weight = FontWeight.bold

• motion-lede • text:gui-muted-text-color mt:6
    font-size = 14
    text-wrap = TextWrap.word

• motion-card • flex-col bg:gui-panel-color p:18
    border-color = gui-border-color
    border-width = 1
    corner-radius = 16

• motion-card-title • text:gui-strong-text-color
    font-size = 15
    font-weight = FontWeight.bold

• motion-note • text:gui-muted-text-color
    font-size = 12
    text-wrap = TextWrap.word

• motion-caption • text:gui-muted-text-color
    font-size = 12

• motion-label • text:gui-strong-text-color
    font-size = 13
    font-weight = FontWeight.semibold

• motion-well • bg:gui-well-color
    corner-radius = 12

• motion-clip
    overflow-x = ScrollOverflow.clip
    overflow-y = ScrollOverflow.clip

