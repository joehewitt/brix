+ Iris is MaskShader

+ opening F64
+ time FrameTime

────────────────────
+ This
    - opening = 0.45

────────────────────
+ ¶ metal

float mask(float2 position, float2 size, IrisArgs args) {
    float2 p = position - size * 0.5;
    float reach = length(size) * 0.5;
    float angle = atan2(p.y, p.x);
    float petals = 1.0 + 0.07 * sin(angle * 6.0 + args.time * 1.4) + 0.03 * sin(angle * 11.0 - args.time * 2.3);
    float radius = args.opening * reach * petals;
    return 1.0 - smoothstep(radius - 16.0, radius, length(p));
}

