+ Puddle is BackdropShader

+ strength F64
+ time FrameTime

────────────────────
+ This
    - strength = 3

────────────────────
+ ¶ metal

float4 backdrop(float2 position, ShaderLayer layer, PuddleArgs args) {
    float2 center = layer.size * 0.5;
    float2 delta = position - center;
    float distance = length(delta);
    float2 direction = distance > 0.0 ? delta / distance : float2(0.0);
    float wave = sin(distance * 0.09 - args.time * 3.0) * exp(-distance * 0.006);
    float2 offset = direction * wave * args.strength;
    float4 color = layer.sample(clamp(position + offset, float2(0.5), layer.size - 0.5));
    float glint = pow(max(0.0, wave), 6.0) * 0.3;
    return float4(color.rgb * float3(0.9, 0.97, 1.08) + glint, color.a);
}

━━━━━━━━━━━━━━━━━━━━
+ Dissolve is TransitionShader

+ glow RGBA
+ grain F64

────────────────────
+ This
    - glow = RGBA("#ffb347")
    - grain = 28

────────────────────
+ ¶ metal

float dissolveHash(float2 p) {
    return fract(sin(dot(p, float2(41.3, 289.1))) * 43758.5453);
}

float dissolveNoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = dissolveHash(i);
    float b = dissolveHash(i + float2(1.0, 0.0));
    float c = dissolveHash(i + float2(0.0, 1.0));
    float d = dissolveHash(i + float2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float4 transition(float2 position, ShaderImage from, ShaderLayer to, float progress, DissolveArgs args) {
    float n = dissolveNoise(position / args.grain) * 0.65 + dissolveNoise(position / (args.grain * 0.3)) * 0.35;
    float edge = progress * 1.2 - 0.1;
    float old = smoothstep(edge - 0.015, edge + 0.015, n);
    float burn = (1.0 - smoothstep(0.0, 0.07, abs(n - edge))) * sin(progress * 3.14159);
    float4 color = mix(to.sample(position), from.sample(position), old);
    return float4(mix(color.rgb, args.glow.rgb, burn * args.glow.a), max(color.a, burn));
}

