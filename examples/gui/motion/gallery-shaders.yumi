+ Portal is TransitionShader

+ ring RGBA

────────────────────
+ This
    - ring = RGBA("#9be8ff")

────────────────────
+ ¶ metal

float4 transition(float2 position, ShaderImage from, ShaderLayer to, float progress, PortalArgs args) {
    float2 center = to.size * 0.5;
    float reach = length(to.size) * 0.5 + 24.0;
    float d = length(position - center);
    float radius = progress * reach;
    float inside = 1.0 - smoothstep(radius - 3.0, radius, d);
    float ring = (1.0 - smoothstep(0.0, 12.0, abs(d - radius))) * sin(progress * 3.14159);
    float2 pull = (position - center) * (1.0 - 0.08 * sin(progress * 3.14159));
    float4 color = mix(from.sample(center + pull), to.sample(position), inside);
    return float4(mix(color.rgb, args.ring.rgb, ring * args.ring.a), max(color.a, ring));
}

━━━━━━━━━━━━━━━━━━━━
+ Swirl is TransitionShader

+ turns F64

────────────────────
+ This
    - turns = 0.6

────────────────────
+ ¶ metal

float2 swirlAround(float2 p, float2 center, float amount, float reach) {
    float2 d = p - center;
    float a = amount * (1.0 - smoothstep(0.0, reach, length(d)));
    float s = sin(a);
    float c = cos(a);
    return center + float2(c * d.x - s * d.y, s * d.x + c * d.y);
}

float4 transition(float2 position, ShaderImage from, ShaderLayer to, float progress, SwirlArgs args) {
    float2 center = to.size * 0.5;
    float reach = length(to.size) * 0.5;
    float angle = args.turns * 6.28318;
    float4 a = from.sample(swirlAround(position, center, angle * progress, reach));
    float4 b = to.sample(swirlAround(position, center, -angle * (1.0 - progress), reach));
    return mix(a, b, smoothstep(0.3, 0.7, progress));
}

━━━━━━━━━━━━━━━━━━━━
+ Mosaic is TransitionShader

+ cells F64

────────────────────
+ This
    - cells = 36

────────────────────
+ ¶ metal

float4 transition(float2 position, ShaderImage from, ShaderLayer to, float progress, MosaicArgs args) {
    float amount = 1.0 - abs(progress * 2.0 - 1.0);
    float cell = max(1.0, floor(amount * args.cells));
    float2 p = cell > 1.0 ? (floor(position / cell) + 0.5) * cell : position;
    return mix(from.sample(p), to.sample(p), smoothstep(0.4, 0.6, progress));
}
