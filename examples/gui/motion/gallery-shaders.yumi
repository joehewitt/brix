+ ¶ metal

float4 fill(float2 position, float2 size, SpectrumArgs args) {
    float phase = (position.x + position.y * 0.4 - args.time * args.speed) / max(size.x, 1.0) * 1.5;
    float3 hue = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + phase));
    float3 color = mix(float3(1.0), hue, 0.85) * args.lightness;
    return float4(color * color, 1.0);
}

