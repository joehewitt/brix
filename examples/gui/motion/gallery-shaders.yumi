+ Ripples is FillShader

+ water RGBA
+ crest RGBA
+ center Point
+ wavelength F64
+ time FrameTime

────────────────────
+ This
    - water
    - crest
    - center = Point(0.5, 0.5)
    - wavelength = 22

────────────────────
+ ¶ metal

float4 fill(float2 position, float2 size, RipplesArgs args) {
    float t = args.time;
    float2 first = args.center * size;
    float2 second = size * 0.5 + float2(cos(t * 0.6), sin(t * 0.8)) * size * float2(0.3, 0.25);
    float k = 6.28318 / max(args.wavelength, 2.0);
    float a = sin(distance(position, first) * k - t * 4.0);
    float b = sin(distance(position, second) * k - t * 4.0 + 1.3);
    float height = (a + b) * 0.5;
    float light = pow(saturate(height * 0.5 + 0.5), 3.0);
    float3 color = mix(args.water.rgb, args.crest.rgb, light);
    color += args.crest.rgb * pow(saturate(height), 12.0) * 0.6;
    return float4(color, 1.0);
}

━━━━━━━━━━━━━━━━━━━━
+ Lava is FillShader

+ base RGBA
+ hot RGBA
+ blobs I32
+ time FrameTime

────────────────────
+ This
    - base
    - hot
    - blobs = 7

────────────────────
+ ¶ metal

float4 fill(float2 position, float2 size, LavaArgs args) {
    float2 p = position / size.y;
    float aspect = size.x / size.y;
    float t = args.time * 0.6;
    float field = 0.0;
    for (int index = 0; index < args.blobs; index++) {
        float seed = float(index) * 1.618;
        float2 center = float2(
            aspect * (0.5 + 0.42 * sin(t * (0.7 + 0.13 * seed) + seed * 2.0)),
            0.5 + 0.4 * cos(t * (0.5 + 0.11 * seed) + seed * 3.1)
        );
        float radius = 0.13 + 0.05 * sin(seed * 5.0);
        float2 offset = p - center;
        field += radius * radius / max(dot(offset, offset), 0.0001);
    }
    float inside = smoothstep(0.97, 1.03, field);
    float rim = smoothstep(0.55, 1.0, field) * (1.0 - inside);
    float core = saturate((field - 1.0) * 0.2);
    float3 molten = mix(args.hot.rgb * 0.75, mix(args.hot.rgb, float3(1.0), 0.3), core);
    float3 color = args.base.rgb * (0.5 + 0.5 * p.y);
    color = mix(color, molten, inside);
    color += args.hot.rgb * rim * rim * 0.4;
    return float4(color, 1.0);
}

