+ Plasma is FillShader

+ deep RGBA
+ bright RGBA
+ scale F64
+ time FrameTime

────────────────────
+ This
    - deep
    - bright
    - scale = 1

────────────────────
+ ¶ metal

float4 fill(float2 position, float2 size, PlasmaArgs args) {
    float2 p = (position - size * 0.5) / (min(size.x, size.y) * 0.5) * args.scale;
    float t = args.time * 0.8;
    float v = sin(p.x * 2.4 + t);
    v += sin(p.y * 2.8 - t * 1.2);
    v += sin((p.x + p.y) * 1.8 + t * 0.6);
    float2 orbit = p + float2(sin(t * 0.5), cos(t * 0.3)) * 1.5;
    v += sin(length(orbit) * 3.0 - t * 1.4);
    float k = 0.5 + 0.5 * sin(v * 1.5);
    float3 color = mix(args.deep.rgb, args.bright.rgb, smoothstep(0.15, 0.85, k));
    float3 tint = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + v * 0.08 + t * 0.05));
    color += tint * tint * 0.12 * k;
    color += pow(k, 10.0) * 0.5;
    return float4(color, 1.0);
}

━━━━━━━━━━━━━━━━━━━━
+ Aurora is FillShader

+ sky RGBA
+ glow RGBA
+ fringe RGBA
+ time FrameTime

────────────────────
+ This
    - sky
    - glow
    - fringe

────────────────────
+ ¶ metal

float auroraHash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float auroraNoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = auroraHash(i);
    float b = auroraHash(i + float2(1.0, 0.0));
    float c = auroraHash(i + float2(0.0, 1.0));
    float d = auroraHash(i + float2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float4 fill(float2 position, float2 size, AuroraArgs args) {
    float2 uv = position / size;
    float t = args.time;
    float3 color = args.sky.rgb * (0.35 + 0.65 * uv.y);
    float star = step(0.995, auroraHash(floor(position / 2.0))) * (0.5 + 0.5 * sin(t * 3.0 + auroraHash(floor(position / 2.0) + 7.0) * 40.0));
    color += star * (1.0 - uv.y) * 0.8;
    for (int band = 0; band < 3; band++) {
        float shift = float(band) * 1.7;
        float wave = 0.28 + float(band) * 0.13 + 0.09 * sin(uv.x * 3.0 + t * 0.5 + shift) + 0.07 * (auroraNoise(float2(uv.x * 4.0 + t * 0.3, shift)) - 0.5);
        float above = wave - uv.y;
        float curtain = smoothstep(0.0, 0.03, above + 0.03) * exp(-max(above, 0.0) * 9.0);
        float rays = 0.55 + 0.45 * auroraNoise(float2(uv.x * 38.0 + shift * 5.0, t * 0.8));
        float3 tint = mix(args.glow.rgb, args.fringe.rgb, smoothstep(0.0, 0.25, above) + float(band) * 0.2);
        color += tint * curtain * rays * (1.1 - float(band) * 0.25);
    }
    return float4(color, 1.0);
}

