+ Lens is BackdropShader

+ power F64

────────────────────
+ This
    - power = 0.35

────────────────────
+ ¶ metal

float4 backdrop(float2 position, ShaderLayer layer, LensArgs args) {
    float2 center = layer.size * 0.5;
    float2 d = (position - center) / (min(layer.size.x, layer.size.y) * 0.5);
    float r = length(d);
    float bend = clamp(1.0 - args.power * (1.0 - min(r * r, 1.0)), 0.2, 1.0);
    float2 base = center + (position - center) * bend;
    float2 fringe = (position - center) * 0.02 * args.power;
    float4 green = layer.sample(base);
    float red = layer.sample(base + fringe).r;
    float blue = layer.sample(base - fringe).b;
    float rim = smoothstep(0.7, 1.0, r);
    float3 color = float3(red, green.g, blue) * (1.0 + 0.18 * (1.0 - min(r, 1.0))) + rim * 0.1;
    return float4(color, green.a);
}

