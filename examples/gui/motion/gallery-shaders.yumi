+ This
    - first
    - second
    - turns = 0.4

────────────────────
+ ¶ metal

float4 fill(float2 position, float2 size, SpinArgs args) {
    float2 offset = (position - size * 0.5) / size;
    float angle = fract(atan2(offset.y, offset.x) / 6.28318 - args.time * args.turns);
    float sweep = smoothstep(0.0, 0.5, angle) * smoothstep(1.0, 0.5, angle);
    float3 color = mix(args.first.rgb, args.second.rgb, sweep);
    color += float3(1.0) * pow(sweep, 8.0) * 0.6;
    return float4(color, 1.0);
}

