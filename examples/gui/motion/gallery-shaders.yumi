+ Flames is FillShader

+ ember RGBA
+ flame RGBA
+ core RGBA
+ height F64
+ time FrameTime

────────────────────
+ This
    - ember
    - flame
    - core
    - height = 1

────────────────────
+ ¶ metal

float flamesHash(float2 p) {
    return fract(sin(dot(p, float2(41.3, 289.1))) * 15731.7431);
}

float flamesNoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(flamesHash(i), flamesHash(i + float2(1.0, 0.0)), f.x),
        mix(flamesHash(i + float2(0.0, 1.0)), flamesHash(i + float2(1.0, 1.0)), f.x),
        f.y
    );
}

float flamesTurbulence(float2 p) {
    float total = 0.0;
    float weight = 0.5;
    for (int octave = 0; octave < 5; octave++) {
        total += flamesNoise(p) * weight;
        p = p * 2.03 + float2(1.7, 9.2);
        weight *= 0.5;
    }
    return total;
}

float4 fill(float2 position, float2 size, FlamesArgs args) {
    float2 uv = float2(position.x / size.y, 1.0 - position.y / size.y);
    float t = args.time;
    float n = flamesTurbulence(float2(uv.x * 3.0, uv.y * 2.4 - t * 1.6));
    float rise = uv.y / max(args.height, 0.1);
    float heat = saturate(1.15 - rise * 1.25 + (n - 0.5) * 1.1);
    heat = heat * heat;
    float3 color = mix(float3(0.0), args.ember.rgb, smoothstep(0.0, 0.3, heat));
    color = mix(color, args.flame.rgb, smoothstep(0.25, 0.6, heat));
    color = mix(color, args.core.rgb, smoothstep(0.6, 0.95, heat));
    return float4(color, 1.0);
}

