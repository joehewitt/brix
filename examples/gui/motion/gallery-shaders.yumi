+ Warp is FillShader

+ space RGBA
+ star RGBA
+ warp F64
+ time FrameTime

────────────────────
+ This
    - space
    - star
    - warp = 1

────────────────────
+ ¶ metal

float warpHash(float value) {
    return fract(sin(value * 78.233) * 43758.5453);
}

float4 fill(float2 position, float2 size, WarpArgs args) {
    float2 offset = position - size * 0.5;
    float radius = length(offset) / (length(size) * 0.5);
    float angle = atan2(offset.y, offset.x) / 6.28318 + 0.5;
    float3 color = args.space.rgb * (1.0 - radius * 0.5);
    float speed = 0.25 + args.warp * 0.35;
    float trail = 0.01 + args.warp * 0.045;
    for (int layer = 0; layer < 3; layer++) {
        float lanes = 90.0 + float(layer) * 70.0;
        float lane = floor(angle * lanes);
        float within = fract(angle * lanes) - 0.5;
        float seed = warpHash(lane + float(layer) * 131.0);
        float head = fract(seed * 7.0 + args.time * speed * (0.6 + seed));
        float distanceToHead = head - radius;
        float streak = smoothstep(trail, 0.0, distanceToHead) * step(0.0, distanceToHead);
        float width = smoothstep(0.5, 0.1, abs(within) * (1.5 + radius * 3.0));
        color += args.star.rgb * streak * width * head * step(0.55, seed) * 1.6;
    }
    return float4(color, 1.0);
}

