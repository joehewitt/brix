+ Stripes is FillShader

+ color RGBA
+ shade RGBA
+ width F64
+ speed F64
+ time FrameTime

────────────────────
+ This
    - color
    - shade
    - width = 12
    - speed = 24

────────────────────
+ ¶ metal

float4 fill(float2 position, float2 size, StripesArgs args) {
    float span = max(args.width, 2.0) * 2.0;
    float along = fract((position.x + position.y - args.time * args.speed) / span);
    float edge = 1.0 / span;
    float band = smoothstep(0.5 - edge, 0.5 + edge, along) - smoothstep(1.0 - edge * 2.0, 1.0, along);
    float3 color = mix(args.color.rgb, args.shade.rgb, band);
    float gloss = 1.0 - smoothstep(0.0, size.y, position.y) * 0.25;
    return float4(color * gloss, 1.0);
}

