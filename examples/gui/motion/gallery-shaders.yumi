float mask(float2 position, float2 size, BlindsArgs args) {
    float2 direction = float2(cos(args.angle), sin(args.angle));
    float band = fract(dot(position, direction) / 28.0 + args.time * 0.12);
    float slat = abs(band - 0.5) * 2.0;
    return 1.0 - smoothstep(args.open - 0.08, args.open, slat);
}

