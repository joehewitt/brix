━━━━━━━━━━━━━━━━━━━━
+ LayoutPanel is Box
    using MotionKitTheme
    using LayoutMotionTheme

+ tiles [GridTile] = layout-tiles(12)
+ big-id Index = -1
+ serial Index = 12
+ is-wide = false
+ is-stack-open = false
+ is-right = false

────────────────────

<This • motion-page
    <MotionHeader "Layout moves itself"
        lede = "When a write changes layout, each box slides and resizes from where it was under motion.position and motion.size. Nobody measures anything."
    <Box • motion-row
        <MotionCard "A flow of tiles" • flex:1.25
            <Box • flex-row mt:12
                <Button shuffle-button "Shuffle"
                    action = => do shuffle()
                <Button sort-button "Sort" • ml:8
                    action = => do sort-tiles()
                <Button add-button "Add" • ml:8
                    action = => do add()
                <Button remove-button "Remove" • ml:8
                    action = => do remove()
                <Button grow-button "Grow" • ml:8
                    action = => do grow()
            <Box • tile-grid
                for tile in #tiles keyed by tile.id
                    <TileBox
                        tile = tile
                        is-big = #big-id == tile.id
        <Box • motion-card flex:1
            <Box • flex-row items-center
                <Label "resize-content" • motion-card-title flex:1
                <Button resize-button "Resize"
                    action = => do resize()
            <Box • flex-row mt:10
                <ResizeColumn
                    title = "reveal"
                    mode = ResizeContent.reveal
                    hue = 0
                    blurb = "Final layout, clipped"
                    is-wide = #is-wide
                <ResizeColumn • ml:8
                    title = "reflow"
                    mode = ResizeContent.reflow
                    hue = 3
                    blurb = "Laid out every frame"
                    is-wide = #is-wide
                <ResizeColumn • ml:8
                    title = "scale"
                    mode = ResizeContent.scale
                    hue = 5
                    blurb = "Stretched in its transform"
                    is-wide = #is-wide
    <Box • flex-row h:300 mt:18 gap:18
        <Box • motion-card flex:1.25
            <Box • flex-row items-center
                <Label "Coupled stacks" • motion-card-title flex:1
                <Button stack-button "Toggle"
                    action = => do toggle-stack()
            <Box • flex-row mt:4
                <Box • flex-col
                    <Label "free" • motion-tag mt:6
                    <Box • stack-well
                        <StackBars
                            is-open = #is-stack-open
                <Box • flex-col ml:16
                    <Label "stack-motion = coupled" • motion-tag mt:6
                    <Box • stack-well
                        <StackBars
                            stack-motion = StackMotion.coupled
                            is-open = #is-stack-open
                <Label • motion-note ml:16 flex:1 mt:28
                    text = "The second bar grows on a slow spring while its siblings move on a quick one. A coupled stack places them from the presented sizes every frame, so they stay touching."
        <MotionCard "Motion scopes" • flex:1
            note = "The ball declares no motion at all. Move snaps it. Move in scope writes the same change inside do use motion(gui-motion-bouncy)."
            <Box scope-well • scope-well
                justify = if #is-right then Justify.end else Justify.start
                <Box • scope-ball
                    background-color = if #is-right then motion-hue(7) else motion-hue(4)
            <Box • flex-row mt:14
                <Button plain-button "Move"
                    action = => do move-plain()
                <Button scope-button "Move in scope" • ml:8
                    action = => do move-scoped()

────────────────────
+ do shuffle

. next = List'GridTile(tiles)
for index in 0 .. < next.length
    . other = index + random(0, next.length - index)
    . held = next[index]
    next[index] = next[other]
    next[other] = held
tiles = next

────────────────────
+ do sort-tiles

tiles = sort(tiles) • using :: left, right => if left.id < right.id then .lesser else .greater

────────────────────
+ do add

serial += 1
. next = List'GridTile(tiles)
next.insert(GridTile(serial, serial), random(0, next.length + 1))
tiles = next

────────────────────
+ do remove

=? if tiles.length == 0
. next = List'GridTile(tiles)
next.remove(random(0, next.length))
tiles = next

────────────────────
+ do grow

=? if tiles.length == 0
. candidate = tiles[random(0, tiles.length)].id
big-id = if candidate == big-id then -1 else candidate

────────────────────
+ do resize

is-wide = !is-wide

────────────────────
+ do toggle-stack

is-stack-open = !is-stack-open

────────────────────
+ do move-plain

is-right = !is-right

────────────────────
+ do move-scoped

do use motion($gui-motion-bouncy)
    is-right = !is-right

