+ ResizeColumn is Box
    using MotionKitTheme
    using LayoutMotionTheme

+ title = ""
+ mode = ResizeContent.reveal
+ hue Index = 0
+ blurb = ""
+ is-wide = false

────────────────────

<This • flex-col
    <Label • motion-tag
        text = #title
    <Box • resize-slot
        <ResizeDemo
            resize-content = #mode
            is-wide = #is-wide
            <Box • resize-strip
                background = motion-glow(#hue)
            <Label "These words rewrap as it grows" • resize-text
            <Box • resize-dots
                <Box • resize-dot
                    background-color = motion-hue(#hue)
                <Box • resize-dot
                    background-color = motion-hue(#hue + 1)
                <Box • resize-dot
                    background-color = motion-hue(#hue + 2)
    <Label • resize-caption
        text = #blurb

