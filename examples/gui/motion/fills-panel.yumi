./motion-kit
/graphics/color
/graphics/shader
/graphics/shader-fills
/graphics/text
/gui
/math/motion
/time/duration

━━━━━━━━━━━━━━━━━━━━
• FillsTheme
    using GUIDefaultTheme
    using MotionKitTheme

• fills-strip • motion-well flex-row items-center h:64 px:18 mt:12

• fills-waiting
    font-size = 20
    color = gui-muted-text-color
    text-fill = Shimmer(gui-muted-text-color, gui-strong-text-color)

• fills-done
    font-size = 20
    color = gui-strong-text-color

• fills-quiet
    font-size = 13
    color = gui-muted-text-color
    text-fill = Shimmer(gui-muted-text-color, gui-strong-text-color) • band 24 • speed 80

• fills-skeleton • flex-col p:16 gap:10
    corner-radius = 12
    border-color = gui-border-color
    border-width = 1

• fills-bone • h:12
    corner-radius = 6
    background-fill = Shimmer(gui-divider-color, gui-field-color) • band 80 • speed 220

• fills-alert • flex-row items-center h:64 px:18 mt:12
    corner-radius = 14
    motion.background-fill = ease-in-out(700ms)

• fills-alert-label
    font-size = 14
    font-weight = FontWeight.semibold
    color = RGBA("#ffffff")

• fills-ring • flex-row items-center h:64 px:18 mt:12
    corner-radius = 14
    border-width = 3
    border-fill = Shimmer(gui-accent-color, RGBA("#8cc8ff")) • band 70 • speed 180

━━━━━━━━━━━━━━━━━━━━
+ FillsPanel is Box
    using MotionKitTheme
    using FillsTheme

+ is-waiting = true
+ is-urgent = false

────────────────────

<This • motion-page
    <MotionHeader "Shader fills"
        lede = "Text, backgrounds and borders can be filled by a shader. A live fill reads the window's fill clock on the GPU, so each frame repaints only its own rect and records nothing."
    <Box • motion-row
        <MotionCard "Shimmer while waiting" • flex:1
            note = "Shimmer sweeps a highlight across the text at 30 frames a second. Turn it off and the label records once, as plain text, and the window stops asking for frames."
            <Box • fills-strip
                if #is-waiting
                    <Label "Thinking about your question…" • fills-waiting flex:1
                else
                    <Label "Here is what I found." • fills-done flex:1
                <Switch "Waiting" • ml:12
                    is-on = #is-waiting
                    for event on value-changed
                        is-waiting = event.value
        <MotionCard "Slower and smaller" • flex:1
            note = "The same shader with a narrower band and a slower sweep."
            <Box • fills-strip
                <Label "Indexing 1,204 files" • fills-quiet flex:1
    <Box • motion-row
        <MotionCard "Loading placeholders" • flex:1
            note = "Backgrounds take fills too. Each bar stands in for content that has not loaded yet, and each sweeps its own highlight within its rounded shape."
            <Box • fills-skeleton mt:12
                <Box • fills-bone w:180
                <Box • fills-bone
                <Box • fills-bone w:120
        <MotionCard "A working border" • flex:1
            note = "A border fill paints the ring between the box's outer and inner edges, so the sweep crosses the top and bottom edges together and leaves the inside alone."
            <Box • fills-ring
                <Label "Searching the web" • motion-label flex:1
    <Box • motion-row
        <MotionCard "Animated parameters" • flex:1
            note = "A fill's parameters follow the box's motion when they change. Here the colors and the band width ease over 700ms while the highlight keeps sweeping. Colors travel as RGBA does, other numbers mix, and whole numbers and flags switch at the start. A fill of another shader replaces it at once."
            <Box • fills-alert
                background-fill = alert-fill(#is-urgent)
                <Label "Deploying to production" • fills-alert-label flex:1
                <Switch "Urgent" • ml:12
                    is-on = #is-urgent
                    for event on value-changed
                        is-urgent = event.value

━━━━━━━━━━━━━━━━━━━━
_ alert-fill ShaderFill
    - urgent Bool

|? urgent
    Shimmer(RGBA("#b4232a"), RGBA("#ffc861")) • band 160 • speed 180
??
    Shimmer(RGBA("#1d4ed8"), RGBA("#8cc8ff")) • band 60 • speed 180
