./gallery-shaders
./motion-kit
/graphics/color
/graphics/outline
/graphics/point
/graphics/text
/gui
/math/motion
/time/duration

━━━━━━━━━━━━━━━━━━━━
• ShadersTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

• shader-grid • flex-row flex:1 mt:18 gap:18

• shader-tile • flex-col justify-end flex:1 p:16
    corner-radius = 18
    shadow = Shadow(RGBA("#00000040"), 10, 0, 4)
    motion = gui-motion-smooth
    motion.background-fill = ease-in-out(900ms)
    motion.scale = gui-motion-bouncy

    when #is-hover-within
        scale = 1.03
        shadow = Shadow(RGBA("#00000080"), 28, 0, 14)

• tile-name
    font-size = 17
    font-weight = FontWeight.bold
    color = RGBA("#ffffff")

• tile-hint • mt:3
    font-size = 12
    color = RGBA("#ffffffc0")

• plasma-tile
    background-fill = Plasma(RGBA("#1b0b4d"), RGBA("#ff4fa3"))

    when #is-hover-within
        background-fill = Plasma(RGBA("#00303a"), RGBA("#9dffd0")) • scale 2.4

• aurora-tile
    background-fill = Aurora(RGBA("#06112b"), RGBA("#3dff9e"), RGBA("#2f6bff"))

    when #is-hover-within
        background-fill = Aurora(RGBA("#16061f"), RGBA("#ff5ad1"), RGBA("#ffb347"))

• ripples-tile
    background-fill = Ripples(RGBA("#04364f"), RGBA("#9be8ff"))

    when #is-hover-within
        background-fill = Ripples(RGBA("#2b0f45"), RGBA("#ffd36e")) • center Point(0.2, 0.3) • wavelength 9

• lava-tile
    background-fill = Lava(RGBA("#2a0610"), RGBA("#ff7a1a"))

    when #is-hover-within
        background-fill = Lava(RGBA("#04152e"), RGBA("#36e4ff"))

• flames-tile
    background-fill = Flames(RGBA("#7a0c02"), RGBA("#ff7b00"), RGBA("#fff1a8")) • height 0.7

    when #is-hover-within
        background-fill = Flames(RGBA("#1d0a6b"), RGBA("#5b6bff"), RGBA("#e8f6ff")) • height 1.5

• warp-tile
    background-fill = Warp(RGBA("#05060f"), RGBA("#bcd7ff")) • warp 0.4

    when #is-hover-within
        background-fill = Warp(RGBA("#0b0420"), RGBA("#ffffff")) • warp 4

• shader-strip • flex-row mt:18 gap:18 h:120

• spectrum-card • motion-card flex-col justify-center flex:1

• spectrum-title
    font-size = 40
    font-weight = FontWeight.heavy
    text-fill = Spectrum()

• spin-card • flex-col justify-center flex:1 bg:gui-panel-color p:18
    corner-radius = 18
    border-width = 3
    border-fill = Spin(RGBA("#2a1d6b"), RGBA("#7df9ff"))
    motion.border-fill = ease-in-out(700ms)

    when #is-hover-within
        border-fill = Spin(RGBA("#4a1020"), RGBA("#ffcf5a")) • turns 1.2

• progress-card • motion-card flex-col justify-center flex:1

• progress-track • flex-row mt:12 h:16 bg:gui-well-color
    corner-radius = 8

• progress-bar • h:16
    corner-radius = 8
    background-fill = Stripes(RGBA("#2f7bff"), RGBA("#5b9dff"))
    motion = gui-motion-smooth
    motion.background-fill = ease-in-out(600ms)

    when #is-hover-within
        background-fill = Stripes(RGBA("#16a34a"), RGBA("#4ade80")) • width 6 • speed 60

━━━━━━━━━━━━━━━━━━━━
+ ShadersPanel is Box
    using MotionKitTheme
    using ShadersTheme

────────────────────

<This • motion-page
    <MotionHeader "Shader gallery"
        lede = "Each fill below is a Yumi class with a Metal body, running live on the GPU from the window's fill clock. Hover one and its parameters ease to new values while it keeps moving."
    <Box • shader-grid
        <Box • shader-tile plasma-tile
            <Label "Plasma" • tile-name
            <Label "Hover to zoom and recolor" • tile-hint
        <Box • shader-tile aurora-tile
            <Label "Aurora" • tile-name
            <Label "Hover for a different sky" • tile-hint
        <Box • shader-tile ripples-tile
            <Label "Ripples" • tile-name
            <Label "Hover to move the source and tighten the waves" • tile-hint
    <Box • shader-grid
        <Box • shader-tile lava-tile
            <Label "Lava" • tile-name
            <Label "Hover to cool it down" • tile-hint
        <Box • shader-tile flames-tile
            <Label "Flames" • tile-name
            <Label "Hover to turn up the gas" • tile-hint
        <Box • shader-tile warp-tile
            <Label "Warp" • tile-name
            <Label "Hover to jump to lightspeed" • tile-hint
    <Box • shader-strip
        <Box • spectrum-card
            <Label "Spectrum" • spectrum-title
            <Label "A text fill sweeping through the hues" • motion-note mt:4
        <Box • spin-card
            <Label "Spinning border" • motion-card-title
            <Label "A border fill that turns. Hover to spin it faster and warm it up." • motion-note mt:4
        <Box • progress-card
            <Label "Barber stripes" • motion-card-title
            <Box • progress-track
                <Box • progress-bar w:240
            <Label "Hover the bar to turn it green and speed it up" • motion-note mt:8
