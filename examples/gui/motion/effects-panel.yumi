━━━━━━━━━━━━━━━━━━━━
• EffectsTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using MotionKitTheme

• effects-row • flex-row flex:1 mt:18 gap:18

• effect-frame • motion-clip flex-col flex:1
    corner-radius = 18
    shadow = Shadow(RGBA("#00000040"), 10, 0, 4)

• effect-body • flex-col justify-end flex:1 p:16

• effect-name
    font-size = 17
    font-weight = FontWeight.bold
    color = RGBA("#ffffff")

• effect-hint • mt:3
    font-size = 12
    color = RGBA("#ffffffc8")

• effect-banner • flex:1
    font-size = 30
    font-weight = FontWeight.heavy
    color = RGBA("#ffffff")

• crt-body
    background-fill = Aurora(RGBA("#06112b"), RGBA("#3dff9e"), RGBA("#2f6bff"))
    filters = [CRT()]

    when #is-hover-within
        filters = [CRT(0.22)]

• wave-body
    background-fill = Plasma(RGBA("#1b0b4d"), RGBA("#ff4fa3"))
    filters = [Wave(6), Pixelate(5)]

    when #is-hover-within
        filters = [Wave(14), Pixelate(10)]

• thermal-body
    background-fill = Lava(RGBA("#04152e"), RGBA("#36e4ff"))
    filters = [Thermal()]

    when #is-hover-within
        filters = [Thermal(), Glitch(1.4)]

• mask-art • flex:1

• mask-caption • flex-col p:16 bg:RGBA("#141821")

• mask-caption-name • text:gui-strong-text-color
    font-size = 17
    font-weight = FontWeight.bold

• mask-caption-hint • text:gui-muted-text-color mt:3
    font-size = 12

• iris-body
    background-fill = Ripples(RGBA("#2b0f45"), RGBA("#ffd36e"))
    mask = Iris()
    motion.mask = ease-in-out(800ms)

    when #is-hover-within
        mask = Iris(1.2)

• blinds-body
    background-fill = Flames(RGBA("#7a0c02"), RGBA("#ff7b00"), RGBA("#fff1a8"))
    mask = Blinds()
    motion.mask = ease-in-out(700ms)

    when #is-hover-within
        mask = Blinds(1.1, 0)

• lens-stage • flex-row items-center gap:22 p:22
    background-fill = Stripes(RGBA("#2f7bff"), RGBA("#ffcf5a")) • width 14 • speed 30

• lens-pane • flex-col justify-end flex:1 p:14 h:150
    corner-radius = 22
    border-width = 1
    border-color = RGBA("#ffffff70")
    motion.backdrop = ease-in-out(600ms)

• lens-pane-lens
    backdrop = Lens()

    when #is-hover-within
        backdrop = Lens(0.75)

• lens-pane-puddle
    backdrop = Puddle()

    when #is-hover-within
        backdrop = Puddle(10)

• lens-pane-name
    font-size = 15
    font-weight = FontWeight.bold
    color = RGBA("#ffffff")

• swap-card • motion-card flex:1

• swap-row • flex-row mt:18 gap:18
    flex = 1.35

• swap-controls • flex-row items-center mt:12

• swap-stage • motion-clip flex-col flex:1 mt:14
    corner-radius = 14
    motion.swap-transition = ease-in-out(1100ms)

• swap-page • flex-col justify-end flex:1 p:18

• plasma-page
    background-fill = Plasma(RGBA("#1b0b4d"), RGBA("#ff4fa3"))

• aurora-page
    background-fill = Aurora(RGBA("#16061f"), RGBA("#ff5ad1"), RGBA("#ffb347"))

• ripples-page
    background-fill = Ripples(RGBA("#04364f"), RGBA("#9be8ff"))

• swap-title
    font-size = 34
    font-weight = FontWeight.heavy
    color = RGBA("#ffffff")

• swap-caption • mt:2
    font-size = 13
    color = RGBA("#ffffffc8")

━━━━━━━━━━━━━━━━━━━━
+ ShaderEffectsPanel is Box
    using MotionKitTheme
    using EffectsTheme

+ page = 0
+ transition-name = "dissolve"

────────────────────

<This • motion-page
    <MotionHeader "Shader effects"
        lede = "Each kind of shader in action. Layer filters rework a box's rendered content, masks shape its alpha, backdrops bend whatever sits behind it, and swap transitions blend one branch of markup into the next. Hover the tiles to change their parameters."
    <Box • effects-row
        <Box • effect-frame
            <Box • effect-body crt-body
                <Label "CHANNEL 3" • effect-banner
                <Label "CRT" • effect-name
                <Label "A layer filter. Hover to bend the glass." • effect-hint
        <Box • effect-frame
            <Box • effect-body wave-body
                <Label "UNDERWATER" • effect-banner
                <Label "Wave, then pixelate" • effect-name
                <Label "Two filters stacked in a list. Hover for more of both." • effect-hint
        <Box • effect-frame
            <Box • effect-body thermal-body
                <Label "HEAT" • effect-banner
                <Label "Thermal" • effect-name
                <Label "Hover to stack a glitch on top." • effect-hint
    <Box • effects-row
        <Box • effect-frame bg:RGBA("#0b0d14")
            <Box • mask-art iris-body
            <Box • mask-caption
                <Label "Iris mask" • mask-caption-name
                <Label "A mask shader with a breathing edge. Hover to open it." • mask-caption-hint
        <Box • effect-frame bg:RGBA("#0b0d14")
            <Box • mask-art blinds-body
            <Box • mask-caption
                <Label "Blinds mask" • mask-caption-name
                <Label "Hover and the slats ease open." • mask-caption-hint
        <Box • effect-frame flex:1.6
            <Box • lens-stage flex:1
                <Box • lens-pane lens-pane-lens
                    <Label "Lens" • lens-pane-name
                    <Label "A backdrop shader magnifying what's behind it. Hover to push it." • effect-hint
                <Box • lens-pane lens-pane-puddle
                    <Label "Puddle" • lens-pane-name
                    <Label "Live ripples over the stripes. Hover to stir them." • effect-hint
    <Box • swap-row
        <Box • swap-card
            <Label "Swap transitions" • motion-card-title
            <Label "The box below switches between the arms of an if. Its swap-transition snapshots the old arm and blends it into the new one as progress runs from 0 to 1." • motion-note mt:4
            <Box • swap-controls
                <SegmentedControl'String
                    selected = #transition-name
                    for event on selection-changed
                        transition-name = event.value
                    <Segment'String dissolve-segment "Dissolve"
                        value = "dissolve"
                    <Segment'String portal-segment "Portal"
                        value = "portal"
                    <Segment'String swirl-segment "Swirl"
                        value = "swirl"
                    <Segment'String mosaic-segment "Mosaic"
                        value = "mosaic"
                <Button next-button "Next page" • ml:12
                    action = => do next-page()
            <Box • swap-stage
                swap-transition = effect-transition(#transition-name)
                if #page == 0
                    <Box • swap-page plasma-page
                        <Label "Plasma" • swap-title
                        <Label "Page one of three" • swap-caption
                else if #page == 1
                    <Box • swap-page aurora-page
                        <Label "Aurora" • swap-title
                        <Label "Page two of three" • swap-caption
                else
                    <Box • swap-page ripples-page
                        <Label "Ripples" • swap-title
                        <Label "Page three of three" • swap-caption

────────────────────
+ do next-page

page = (page + 1) % 3

━━━━━━━━━━━━━━━━━━━━
+ effect-transition ShaderTransition
    - name String

match name
    |= "portal"
        Portal()
    |= "swirl"
        Swirl()
    |= "mosaic"
        Mosaic()
    ??
        Dissolve()
