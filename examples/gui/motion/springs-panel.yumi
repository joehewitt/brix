./motion-kit
/graphics/color
/graphics/point
/graphics/primitives
/gui
/math
/math/motion
/time/duration
/units

_ lane-reach = 420.0

━━━━━━━━━━━━━━━━━━━━
+ SpringsLane is Tuple

+ title String
+ code String
+ motion Motion

━━━━━━━━━━━━━━━━━━━━
• SpringsTheme
    using GUIDefaultTheme
    using MotionKitTheme

• springs-lane • flex-row items-center mt:10

• springs-track • motion-well flex-row items-center w:476 h:48 px:6

• springs-puck • w:36 h:36
    corner-radius = 18

• chase-dot
    corner-radius = 999

━━━━━━━━━━━━━━━━━━━━
+ SpringsPanel is Box
    using MotionKitTheme
    using SpringsTheme

+ is-far = false
+ lanes [SpringsLane] = springs-lanes()

────────────────────

<This • motion-page
    <MotionHeader "Every motion is a value"
        lede = "One target change, six motions. Press Go again while they travel: springs turn around with the speed they had, and curves blend into the new target."
    <Box • motion-row
        <MotionCard "Same change, six motions"
            for index in 0 .. < lanes.length
                <Box • springs-lane
                    <Box • flex-col w:170
                        <Label • motion-label
                            text = lanes[index].title
                        <Label • motion-tag mt:2
                            text = lanes[index].code
                    <Box • springs-track
                        <Box • springs-puck
                            background = motion-glow(index)
                            motion.translate = lanes[index].motion
                            translate = Point(if #is-far then lane-reach else 0, 0)
            <Box • flex-row mt:18
                <Button go-button "Go"
                    action = => do go()
        <MotionCard "Chase the pointer" • flex:1
            note = "Each dot is animated(#target, spring(…)) with its own duration and bounce. Move the pointer through the field."
            <ChaseField chase • motion-well flex:1 mt:12

────────────────────
+ do go

is-far = !is-far

━━━━━━━━━━━━━━━━━━━━
+ ChaseField is Box
    using MotionKitTheme
    using SpringsTheme

+ target = Point(160, 140)

────────────────────

<This
    <Box • chase-dot absolute w:34 h:34
        background-color = motion-hue(4)
        translate = centered(animated(#target, spring(240ms)), 17)
    <Box • chase-dot absolute w:26 h:26
        background-color = motion-hue(5)
        translate = centered(animated(#target, spring(600ms, 0.25)), 13)
    <Box • chase-dot absolute w:18 h:18
        background-color = motion-hue(7)
        translate = centered(animated(#target, spring(1100ms, 0.35)), 9)

────────────────────
for event on pointer-move

target = event.point

━━━━━━━━━━━━━━━━━━━━
_ centered Point
    - point Point
    - radius Length

Point(point.x - radius, point.y - radius)

━━━━━━━━━━━━━━━━━━━━
_ springs-lanes [SpringsLane]

* SpringsLane("Spring", "spring(320ms)", spring(320ms))
* SpringsLane("Bouncy spring", "spring(600ms, 0.45)", spring(600ms, 0.45))
* SpringsLane("Ease in-out", "ease-in-out(700ms)", ease-in-out(700ms))
* SpringsLane("Cubic bezier", "cubic-bezier(800ms, …)", cubic-bezier(800ms, 0.68, -0.6, 0.32, 1.6))
* SpringsLane("Steps", "steps(700ms, 7)", steps(700ms, 7))
* SpringsLane("Linear", "linear(700ms)", linear(700ms))
