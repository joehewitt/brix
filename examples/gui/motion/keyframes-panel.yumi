━━━━━━━━━━━━━━━━━━━━
+ KeyframesPanel is Box
    using MotionKitTheme
    using KeyframesTheme

────────────────────

<This • motion-page
    <MotionHeader "Keyframe animations"
        lede = "Declared in a style sheet as tracks of stops or ranges, and started with play(\$name). Click a tile to play it; click a looping one again to stop it."
    <Box • keyframe-row mt:18
        <KeyframeTile spin-tile
            title = "Spin"
            code = "repeat forever"
            hue = 0
            animation = $spin
        <KeyframeTile shake-tile
            title = "Shake"
            code = "shape shake:10"
            hue = 1
            animation = $shake:10
        <KeyframeTile pop-tile
            title = "Pop in"
            code = "per-track motion"
            hue = 2
            animation = $pop-in
        <KeyframeTile breathe-tile
            title = "Breathe"
            code = "alternate, forever"
            hue = 3
            animation = $breathe
        <KeyframeTile jelly-tile
            title = "Jelly"
            code = "transform stops"
            hue = 7
            animation = $jelly
    <Box • keyframe-row mt:14
        <KeyframeTile heartbeat-tile
            title = "Heartbeat"
            code = "scale stops, twice"
            hue = 7
            animation = $heartbeat
        <KeyframeTile rubber-tile
            title = "Rubber"
            code = "scale and rotate stops"
            hue = 4
            animation = $rubber
        <KeyframeTile turn-tile
            title = "Turn over"
            code = "alternate, twice"
            hue = 6
            is-plain = true
            animation = $turn-over
        <KeyframeTile wiggle-tile
            title = "Wiggle"
            code = "rotate stops"
            hue = 5
            animation = $wiggle
        <KeyframeTile flip-tile
            title = "Flip"
            code = "matrix and color"
            hue = 4
            is-plain = true
            animation = $flip
    <Box • keyframe-row mt:14
        <KeyframeTile drop-tile
            title = "Drop in"
            code = "lands on a spring"
            hue = 2
            animation = $drop-in
        <KeyframeTile launch-tile
            title = "Launch"
            code = "three tracks"
            hue = 0
            animation = $launch
        <KeyframeTile swing-tile
            title = "Swing"
            code = "eased range, forever"
            hue = 4
            is-tall = true
            animation = $swing
        <KeyframeTile tint-tile
            title = "Tint"
            code = "color stops in OKLab"
            hue = 0
            is-plain = true
            animation = $tint
        <KeyframeTile bounce-tile
            title = "Bounce"
            code = "squash and stretch"
            hue = 1
            animation = $bounce

━━━━━━━━━━━━━━━━━━━━
+ KeyframeTile is Box
    using MotionKitTheme
    using KeyframesTheme

+ title = ""
+ code = ""
+ hue Index = 0
+ is-plain = false
+ is-tall = false
+ animation KeyframeAnimation? = null

_ run KeyframeRun?

────────────────────

<This • keyframe-tile
    <Box • keyframe-stage
        <Box shape • keyframe-shape
            min-width = SizeSpec.coord(if #is-tall then 22 else 52)
            max-width = SizeSpec.coord(if #is-tall then 22 else 52)
            min-height = SizeSpec.coord(if #is-tall then 84 else 52)
            max-height = SizeSpec.coord(if #is-tall then 84 else 52)
            corner-radius = if #is-tall then 11 else 14
            transform-origin = if #is-tall then Point(0.5, 0) else Point(0.5, 0.5)
            translate = Point(0, if #is-tall then -20 else 0)
            background = if #is-plain then null else motion-glow(#hue)
            background-color = motion-hue(#hue)
    <Box • flex-row items-center mt:8
        <Label • motion-label flex:1
            text = #title
        <Label • motion-tag
            text = #code

────────────────────
for event on click

toggle()

────────────────────
+ do toggle

. running = run
if running && !running.is-done
    running.cancel()
    run = null
    =
. chosen = animation
=? if !chosen
run = shape.play(chosen)
