• KeyframesTheme
    using GUIDefaultTheme
    using GUIMotionTheme
    using GUIBoxCursor
    using GUIBoxPaint
    using GUIBoxTransform
    using MotionKitTheme

• keyframe-row • flex-row flex:1 gap:14

• keyframe-tile • motion-card flex:1 p:12
    cursor = CursorStyle.pointing-hand
    motion = gui-motion-quick

    when #is-hover-within
        border-color = gui-accent-bright-color

• keyframe-stage • motion-well motion-clip flex-row items-center justify-center flex:1

• keyframe-shape
    corner-radius = 14
    shadow = Shadow(RGBA("#00000066"), 10, 0, 6)

• heartbeat animation 1000ms
    repeat = Repeat.times(2)
    scale
        at 0% = 1
        at 14% = 1.3
        at 28% = 1
        at 42% = 1.22
        at 70% = 1
        at 100% = 1

• rubber animation 900ms
    scale
        at 0% = 1
