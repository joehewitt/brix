        at 40% = 0.8
        at 56% = 1.14
        at 72% = 0.94
        at 100% = 1
    rotate
        at 0% = 0
        at 22% = -0.14
        at 56% = 0.08
        at 100% = 0

• turn-over animation 640ms
    repeat = Repeat.times(2)
    direction = AnimationDirection.alternate
    rotate = 0 .. π • motion ease-in-out(640ms)
    background-color
        at 0% = RGBA("#a855f7")
        at 49% = RGBA("#a855f7")
        at 51% = RGBA("#f59e0b")
        at 100% = RGBA("#f59e0b")

• wiggle animation 700ms
    rotate
        at 0% = 0
        at 15% = -0.4
        at 30% = 0.34
        at 45% = -0.24
        at 60% = 0.16
        at 78% = -0.07
        at 100% = 0

• drop-in animation 1000ms
    translate = Point(0, -120) .. • motion spring(760ms, 0.55)
    opacity = 0%% .. • motion ease-out(180ms)

• launch animation 1700ms
    translate
        at 0% = Point(0, 0)
        at 16% = Point(0, 12) • easing Easing.ease-out
        at 52% = Point(40, -170) • easing Easing.ease-in
        at 53% = Point(-40, 170)
        at 100% = Point(0, 0) • easing Easing.ease-out
    rotate
        at 0% = 0
        at 16% = -0.18
        at 52% = 0.6
        at 53% = -0.6
        at 100% = 0 • easing Easing.ease-out
    opacity
        at 0% = 1%%
        at 42% = 1%%
        at 52% = 0%%
        at 60% = 0%%
        at 80% = 1%%
        at 100% = 1%%

• swing animation 900ms
    repeat = Repeat.forever
    direction = AnimationDirection.alternate
    rotate = -0.55 .. 0.55 • motion ease-in-out(900ms)

• jelly animation 900ms
    transform
        at 0% = Matrix(1, 0, 0, 1, 0, 0)
        at 18% = Matrix(1.25, 0, 0, 0.78, 0, 0)
        at 36% = Matrix(0.84, 0, 0.22, 1.18, 0, 0)
        at 52% = Matrix(1.1, 0, -0.16, 0.92, 0, 0)
        at 68% = Matrix(0.96, 0, 0.08, 1.05, 0, 0)
        at 84% = Matrix(1.02, 0, -0.03, 0.99, 0, 0)
        at 100% = Matrix(1, 0, 0, 1, 0, 0)

• flip animation 700ms
    repeat = Repeat.times(2)
