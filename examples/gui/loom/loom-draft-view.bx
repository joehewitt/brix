(import ./loom-cloth)
(import ./loom-draft)
(import ./loom-session)
(import ./loom-theme)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /ui/value-change-phase)

(type + DraftGrid (is Box)
  (using LoomTheme)
  (prop + session LoomSession)
  (prop + cell Float)
  (prop + columns Size)
  (prop + rows Size)
  (prop + bottom-up _ (= false))
  (prop + current (? Index))
  (prop + title _ (= "Edit draft"))
  (prop _ stroke (? Bool))
  (prop _ last-column Index)
  (prop _ last-row Index)
  (rule This (• draft-paper)
    (= cursor (. CursorStyle pointing-hand))
    (= window-draggable false)
  )
  (depends invalidate-paint cell columns rows current)
  (content
    (<> This
      (= min-width (call (. SizeSpec coord) (* #columns #cell)))
      (= max-width (call (. SizeSpec coord) (* #columns #cell)))
      (= min-height (call (. SizeSpec coord) (* #rows #cell)))
      (= max-height (call (. SizeSpec coord) (* #rows #cell)))
    )
  )
  (whenever-rule (. #session #draft)
    (call invalidate-paint)
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (let (tuple column row) (call cell-at (. event point)))
      (let marking (not (call is-marked column row)))
      (= stroke marking)
      (= last-column column)
      (= last-row row)
      (call mark column row marking (. ValueChangePhase began))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-drag)
    (let marking stroke)
    (if (!= marking null)
      (let (tuple column row) (call cell-at (. event point)))
      (for (in (tuple across down) (call path-to column row))
        (call mark across down marking (. ValueChangePhase changed))
      )
      (= last-column column)
      (= last-row row)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-up)
    (if (!= stroke null)
      (= stroke null)
      (call (. session finish-gesture) title)
      (call (. event cancel))
    )
  )
  (fn-expr _ cell-at (tuple Index Index)
    (param point Point)
    (tuple (call clamp (as (call floor (/ (. point x) cell)) Index) 0 (- columns 1)) (call clamp (as (call floor (/ (. point y) cell)) Index) 0 (- rows 1)))
  )
  (fn-expr _ path-to (list (tuple Index Index))
    (param column Index)
    (param row Index)
    (call List (in (tuple each (call row-at each column row)) (call steps-to column)))
  )
  (fn-expr _ steps-to (list Index)
    (param column Index)
    (if-expr (== column last-column) (list column) (call List (in (+ last-column (* each direction)) (.. 1 (call abs (- column last-column))))))
    (where
      (lazy direction (if-expr (> column last-column) 1 -1))
    )
  )
  (fn-expr _ row-at Index
    (param across Index)
    (param column Index)
    (param row Index)
    (if-expr (== column last-column) row (+ last-row (as (call round (/ (* (- row last-row) (- across last-column)) (as (- column last-column) Float))) Index)))
  )
  (fn-expr + flipped Index
    (param row Index)
    (- rows 1 row)
  )
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return false)
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
  )
  (fn-do + cell-color (? RGBA)
    (param column Index)
    (param row Index)
    (return (only-if $loom-ink (if (call is-marked column row))))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (do-use (. canvas saved-state)
      (call (. canvas clip) area)
      (call paint-paper canvas area $loom-paper)
      (let lit current)
      (if lit
        (= (. canvas fill-color) $loom-mark)
        (call (. canvas rect) (call Rect (. area x) (+ (. area y) (* lit cell)) (. area width) cell))
      )
      (for (in column (..< 0 columns))
        (for (in row (..< 0 rows))
          (let color (call cell-color column row))
          (if color
            (= (. canvas fill-color) color)
            (call (. canvas rect) (call Rect (+ (. area x) (* column cell) 1) (+ (. area y) (* row cell) 1) (- cell 2) (- cell 2)))
          )
        )
      )
      (call paint-rules canvas area columns rows cell (call Rules $loom-rule $loom-bold-rule bottom-up))
    )
  )
)

(type + ThreadingGrid (is DraftGrid)
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return ([] ([] (. session draft threading) column) (call flipped row)))
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
    (let heddles (if-expr on (call (of bits-of Shafts) (list (+ (call flipped row) 1))) (call Shafts)))
    (call (. session apply) (call with-threading (. session draft) column heddles) title phase)
  )
)

(type + TieUpGrid (is DraftGrid)
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return ([] ([] (. session draft tie-up) column) (call flipped row)))
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
    (let lifted ([] (. session draft tie-up) column))
    (= ([] lifted (call flipped row)) on)
    (call (. session apply) (call with-tie-up (. session draft) column lifted) title phase)
  )
)

(type + TreadlingGrid (is DraftGrid)
  (prop + first Index)
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return ([] (call (. session draft treads) (+ first row)) column))
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
    (let draft (. session draft))
    (let pick (% (+ first row) (. draft picks)))
    (let treads (call (. draft treads) pick))
    (= ([] treads column) on)
    (call (. session apply) (call with-treadling draft pick treads) title phase)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (call (. super paint-self) canvas)
    (let area content-bounds)
    (let draft (. session draft))
    (= (. canvas fill-color) $loom-bold-rule)
    (for (in row (..< 1 rows) (when (== (% (+ first row) (. draft picks)) 0)))
      (call (. canvas rect) (call Rect (. area x) (- (+ (. area y) (* row cell)) 1) (. area width) 2))
    )
  )
)

(type + WarpStrip (is DraftGrid)
  (prop + color Index)
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return (== ([] (. session draft warp-colors) column) color))
  )
  (fn-do + cell-color (? RGBA)
    (param column Index)
    (param row Index)
    (return (call (. session draft warp-color) column))
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
    (call (. session apply) (call with-warp-color (. session draft) column color) title phase)
  )
)

(type + WeftStrip (is DraftGrid)
  (prop + first Index)
  (prop + color Index)
  (fn-do + is-marked Bool
    (param column Index)
    (param row Index)
    (return (== ([] (. session draft weft-colors) (% (+ first row) (. session draft picks))) color))
  )
  (fn-do + cell-color (? RGBA)
    (param column Index)
    (param row Index)
    (return (call (. session draft weft-color) (+ first row)))
  )
  (fn-do + mark _
    (param column Index)
    (param row Index)
    (param on Bool)
    (param phase ValueChangePhase)
    (let draft (. session draft))
    (call (. session apply) (call with-weft-color draft (% (+ first row) (. draft picks)) color) title phase)
  )
)

(type + PaletteBar (is Box)
  (using LoomTheme)
  (prop + session LoomSession)
  (prop + chosen Index (= 0))
  (prop + current _ (= (call min #chosen (- (. #session #draft palette length) 1))))
  (content
    (<> This (• palette-bar)
      (for (in yarn (call slots (. #session #draft palette length)))
        (<> Button (• palette-swatch)
          (= is-on (== #current yarn))
          (= action (=> () :do (= chosen yarn)))
          (<> Box (• yarn-dot)
            (= background-color ([] (. #session #draft palette) yarn))
          )
          (<> Tooltip (text: "Paint the colour strips with this yarn"))
        )
      )
      (<> ColorWell (• yarn-well)
        (= color ([] (. #session #draft palette) #current))
        (for (on event value-changed)
          (call (. session apply) (call with-palette-color (. session draft) current (. event value)) "Change yarn" (. event phase))
        )
        (<> Tooltip (text: "Change the chosen yarn"))
      )
    )
  )
)
