(import ./loom-draft)
(import ./loom-theme)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /gui)
(import /math)
(import /os/path)
(import /units)
(blank)
(prop _ export-cell _ (= 12.0))
(prop _ export-shadow _ (= (call RGBA "#2a221c")))
(prop _ thumbnail-picks _ (= 10))

(type + LoomView (is U8)
  (variant draft)
  (variant cloth)
)

(type + Rules (is Tuple)
  (prop + thin RGBA)
  (prop + bold RGBA)
  (prop + bottom-up Bool)
)

(type + ClothView (is Box)
  (using LoomTheme)
  (prop + draft Draft)
  (prop + view _ (= (. LoomView cloth)))
  (prop + first Index (= 0))
  (prop + count Size (= 0))
  (prop + cell Float (= 12))
  (prop + is-planned _ (= false))
  (prop _ rows _ (= (call drawdown #draft (..< #first (+ #first #count)))))
  (depends invalidate-paint rows view cell is-planned)
  (content
    (<> This
      (= min-width (call (. SizeSpec coord) (* (. #draft ends) #cell)))
      (= max-width (call (. SizeSpec coord) (* (. #draft ends) #cell)))
      (= min-height (call (. SizeSpec coord) (* #count #cell)))
      (= max-height (call (. SizeSpec coord) (* #count #cell)))
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (do-use (. canvas saved-state)
      (call (. canvas clip) area)
      (do
        (inline
          (match view
            (case= (. LoomView draft)
              (call paint-paper canvas area $loom-paper)
              (call paint-marks canvas rows (. area top-left) cell (if-expr is-planned $loom-plan $loom-ink))
              (call paint-rules canvas area (. draft ends) count cell (call Rules $loom-rule $loom-bold-rule false))
            )
            (case= (. LoomView cloth)
              (if is-planned
                (call paint-warp canvas draft area cell $loom-shadow)
                (else
                  (call paint-cloth canvas draft rows first (. area top-left) cell $loom-shadow)
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + FellRow (is ClothView)
  (prop + is-laid _ (= true))
)

(type + Shed (is Box)
  (prop + is-right _ (= false))
)

(type + Beater (is Box)
  (prop + is-beating _ (= false))
)

(type + ClothStage (is Box)
  (using LoomTheme)
  (prop + draft Draft)
  (prop + view LoomView)
  (prop + woven Size)
  (prop + first Index)
  (prop + shown Size)
  (prop + cell Float)
  (prop + is-throwing _ (= false))
  (prop + is-beating _ (= false))
  (content
    (<> This (• cloth-stage) (• flex-col)
      (= min-height (call (. SizeSpec coord) (* #shown #cell)))
      (= max-height (call (. SizeSpec coord) (* #shown #cell)))
      (<> ClothView (• absolute)
        (= left (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 0))
        (= draft #draft)
        (= view #view)
        (= first #first)
        (= count #shown)
        (= cell #cell)
        (= is-planned true)
      )
      (<> ClothView
        (= draft #draft)
        (= view #view)
        (= first #first)
        (= count (call max 0 (- #woven #first 1)))
        (= cell #cell)
      )
      (for (in pick (call fell #woven) (keyed-by pick))
        (<> FellRow (• fell-row)
          (= draft #draft)
          (= view #view)
          (= first pick)
          (= count 1)
          (= cell #cell)
          (= is-laid (not #is-throwing))
        )
      )
      (<> Shed (• shed)
        (= is-right (== (% #woven 2) 1))
        (<> Box (• shuttle))
        (<> Beater (• beater)
          (= is-beating #is-beating)
        )
      )
    )
  )
)

(type + DraftThumbnail (is Box)
  (prop + draft Draft)
  (prop _ rows _ (= (call drawdown #draft (..< 0 thumbnail-picks))))
  (depends invalidate-paint rows)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (do-use (. canvas saved-state)
      (call (. canvas clip) area)
      (call paint-cloth canvas draft rows 0 (. area top-left) (/ (. area height) thumbnail-picks) export-shadow)
    )
  )
)

(fn-expr _ fell (list Index)
  (param woven Size)
  (if-expr (> woven 0) (list (- woven 1)) (call (of List Index)))
)

(fn-do + paint-paper _
  (param canvas Canvas)
  (param area Rect)
  (param paper RGBA)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) paper)
  (call (. canvas rect) area)
)

(fn-do + paint-rules _
  (param canvas Canvas)
  (param area Rect)
  (param columns Size)
  (param rows Size)
  (param cell Float)
  (param rules Rules)
  (let width (* columns cell))
  (let height (* rows cell))
  (= (. canvas stroke-color) null)
  (for (in column (.. 0 columns))
    (= (. canvas fill-color) (if-expr (== (% column 4) 0) (. rules bold) (. rules thin)))
    (call (. canvas rect) (call Rect (- (+ (. area x) (* column cell)) 0.5) (. area y) 1 height))
  )
  (for (in row (.. 0 rows))
    (= (. canvas fill-color) (if-expr (== (% row 4) 0) (. rules bold) (. rules thin)))
    (call (. canvas rect) (call Rect (. area x) (- (if-expr (. rules bottom-up) (- (+ (. area y) height) (* row cell)) (+ (. area y) (* row cell))) 0.5) width 1))
  )
)

(fn-do + paint-marks _
  (param canvas Canvas)
  (param rows (list (list Bool)))
  (param origin Point)
  (param cell Float)
  (param ink RGBA)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) ink)
  (for (in row (..< 0 (. rows length)))
    (for (in end (..< 0 (. ([] rows row) length)) (when ([] ([] rows row) end)))
      (call (. canvas rect) (call Rect (+ (. origin x) (* end cell) 1) (+ (. origin y) (* row cell) 1) (- cell 2) (- cell 2)))
    )
  )
)

(fn-do + paint-cloth _
  (param canvas Canvas)
  (param draft Draft)
  (param rows (list (list Bool)))
  (param first Index)
  (param origin Point)
  (param cell Float)
  (param shadow RGBA)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) shadow)
  (call (. canvas rect) (call Rect (. origin x) (. origin y) (* (. draft ends) cell) (* (. rows length) cell)))
  (for (in row (..< 0 (. rows length)))
    (let threads ([] rows row))
    (let weft (call (. draft weft-color) (+ first row)))
    (for (in end (..< 0 (. threads length)))
      (let up ([] threads end))
      (let before (if-expr up (and (> row 0) ([] ([] rows (- row 1)) end)) (and (> end 0) (not ([] threads (- end 1))))))
      (let after (if-expr up (and (< (+ row 1) (. rows length)) ([] ([] rows (+ row 1)) end)) (and (< (+ end 1) (. threads length)) (not ([] threads (+ end 1))))))
      (let place (call Rect (+ (. origin x) (* end cell)) (+ (. origin y) (* row cell)) cell cell))
      (call paint-crossing canvas place up (call (. draft warp-color) end) weft before after)
    )
  )
)

(fn-do + paint-warp _
  (param canvas Canvas)
  (param draft Draft)
  (param area Rect)
  (param cell Float)
  (param shadow RGBA)
  (= (. canvas stroke-color) null)
  (call paint-paper canvas area shadow)
  (for (in end (..< 0 (. draft ends)))
    (let place (call Rect (+ (. area x) (* end cell) (* cell 0.18)) (. area y) (* cell 0.64) (. area height)))
    (= (. canvas fill-color) (call shaded (call (. draft warp-color) end) 0.12))
    (call (. canvas rect) place)
    (call (. canvas fill-gradient) place (call sheen place true))
  )
)

(fn-do _ paint-crossing _
  (param canvas Canvas)
  (param place Rect)
  (param warp-up Bool)
  (param warp RGBA)
  (param weft RGBA)
  (param before Bool)
  (param after Bool)
  (let side (* (. place width) 0.13))
  (let gap (* (. place width) 0.08))
  (let lead (if-expr before 0.0 gap))
  (let trail (if-expr after 0.0 gap))
  (let under
    (if-expr warp-up (call Rect (. place x) (+ (. place y) side) (. place width) (- (. place height) (* side 2))) (call Rect (+ (. place x) side) (. place y) (- (. place width) (* side 2)) (. place height)))
  )
  (let over
    (if-expr warp-up (call Rect (+ (. place x) side) (+ (. place y) lead) (- (. place width) (* side 2)) (- (. place height) lead trail)) (call Rect (+ (. place x) lead) (+ (. place y) side) (- (. place width) lead trail) (- (. place height) (* side 2))))
  )
  (= (. canvas fill-color) (call shaded (if-expr warp-up weft warp) 0.62))
  (call (. canvas rect) under)
  (= (. canvas fill-color) (if-expr warp-up warp weft))
  (call (. canvas begin))
  (call (. (call RoundedRect over (if-expr before 0.0 side) (if-expr before 0.0 side) (if-expr after 0.0 side) (if-expr after 0.0 side)) outline) canvas)
  (call (. canvas end))
  (call (. canvas fill-gradient) over (call sheen over warp-up))
)

(fn-expr _ sheen Gradient
  (param over Rect)
  (param across Bool)
  (call LinearGradient (. over top-left) (if-expr across (call Point (. over right) (. over y)) (call Point (. over x) (. over bottom)))
    (list (call GradientStop 0% (call (. black with-alpha) 0.3)) (call GradientStop 40% (call (. white with-alpha) 0.2)) (call GradientStop 60% (call (. white with-alpha) 0.0)) (call GradientStop 100% (call (. black with-alpha) 0.36)))
  )
)

(fn-expr + shaded RGBA
  (param color RGBA)
  (param amount Float)
  (call (. (call (. black with-alpha) amount) over) color)
)

(fn-do + export-cloth _ (?! Error)
  (param draft Draft)
  (param picks Size)
  (param destination Path)
  (let canvas (use (call RasterCanvas (as (* (. draft ends) export-cell) I32) (as (* picks export-cell) I32) 2)))
  (call paint-cloth canvas draft (call drawdown draft (..< 0 picks)) 0 (call Point) export-cell export-shadow)
  (call (. canvas write) destination)
)
