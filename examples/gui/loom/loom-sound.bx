(import /media/audio-output)
(import /media/mixer)
(import /media/synth)
(import /time/duration)
(import /units)
(blank)
(prop _ lead Seconds (= 20ms))
(prop _ beat-delay Seconds (= 90ms))

(fn-expr + loom-sounds SoundBank
  (<> SoundBank
    (<> SoundPatch (text: "clack")
      (= min-gap 30ms)
      (= polyphony 3)
      (blank)
      (<> SoundLayer (• white-noise) (• band-pass)
        (= cutoff 2300hz)
        (= attack 1ms)
        (= decay 34ms)
        (= level 38%)
        (= reverb 12%)
      )
      (<> SoundLayer (• triangle)
        (= pitch 640hz)
        (= pitch-end 470hz)
        (= glide 18ms)
        (= attack 1ms)
        (= decay 42ms)
        (= level 10%)
        (= reverb 8%)
      )
    )
    (blank)
    (<> SoundPatch (text: "thump")
      (= min-gap 40ms)
      (= polyphony 2)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 94hz)
        (= pitch-end 52hz)
        (= glide 60ms)
        (= attack 2ms)
        (= decay 210ms)
        (= level 58%)
        (= reverb 6%)
      )
      (<> SoundLayer (• brown-noise) (• low-pass)
        (= cutoff 420hz)
        (= attack 2ms)
        (= decay 90ms)
        (= level 24%)
        (= reverb 4%)
      )
    )
  )
)

(type + LoomSound
  (implements Closable)
  (prop + mixer Mixer)
  (prop + is-unavailable Bool)
  (prop _ output (? AudioOutput))
  (fn-do + This _
    (param bank SoundBank)
    (lazy mixer (call Mixer bank))
  )
  (fn-do + beat _
    (param side Float)
    (return-if (if (not (call is-open))))
    (blank)
    (let soon (+ (. mixer frames) (call frames-in lead)))
    (call (. mixer play) (call patch "clack") 1 side 1 soon)
    (call (. mixer play) (call patch "thump") 1 0 1 (+ soon (call frames-in beat-delay)))
  )
  (fn-expr _ frames-in I64
    (param span Seconds)
    (as (* (as span F64) (. mixer rate)) I64)
  )
  (fn-expr _ patch Size
    (param name String)
    (!! (call (. mixer bank find) name))
  )
  (fn-do _ is-open Bool
    (return-if false (if is-unavailable))
    (return-if true (if output))
    (blank)
    (= output
      (call AudioOutput mixer
        (block
          (on-error (: problem Error)
            (= is-unavailable true)
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do + close _
    (call (?. output close))
    (= output null)
    (call (. mixer cues close))
  )
)
