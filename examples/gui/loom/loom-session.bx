(import ./loom-draft)
(import ./loom-library)
(import /math)
(import /ui/command-history)
(import /ui/undo-target)
(import /ui/value-change-phase)
(blank)
(prop + half-woven Size (= 18))

(type + LoomSession
  (implements UndoTarget)
  (prop + draft _ (= (call opening-draft)))
  (prop + woven Size (= half-woven))
  (prop + history _ (= (call CommandHistory)))
  (prop _ gesture-start (? Draft))
  (prop + can-undo _ (= (or (. history #can-undo) (and #gesture-start (!= #gesture-start #draft)))))
  (prop + can-redo _ (= (. history #can-redo)))
  (prop + undo-title _ (= (. history #undo-title)))
  (prop + redo-title _ (= (. history #redo-title)))
  (fn-do + undo _
    (call finish-gesture)
    (call (. history undo))
  )
  (fn-do + redo _
    (call finish-gesture)
    (call (. history redo))
  )
  (fn-do + apply _
    (param next Draft)
    (param title String)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (if (or (== phase (. ValueChangePhase began)) (== phase (. ValueChangePhase discrete)))
      (call finish-gesture)
      (= gesture-start draft)
    )
    (= draft next)
    (if (or (== phase (. ValueChangePhase ended)) (== phase (. ValueChangePhase discrete)))
      (call finish-gesture title)
    )
  )
  (fn-do + finish-gesture _
    (param title String (= "Edit draft"))
    (let before gesture-start)
    (= gesture-start null)
    (if (and before (!= before draft))
      (call (. history record) title (call DraftEdit this before draft))
    )
  )
  (fn-do + restore _
    (param next Draft)
    (= gesture-start null)
    (= draft next)
  )
  (fn-do + open _
    (param next Draft)
    (param title String)
    (call apply next title)
    (= woven half-woven)
  )
  (fn-do + weave Treadles
    (param held Treadles)
    (if (!= held (call Treadles))
      (call apply (call with-treadling draft woven held) "Record treadling")
    )
    (+= woven 1)
    (return (call (. draft treads) (- woven 1)))
  )
  (fn-do + unweave _
    (= woven (call max 0 (- woven 1)))
  )
)

(type _ DraftEdit (is Tuple)
  (implements CommandHistoryEntry)
  (prop + session LoomSession)
  (prop + before Draft)
  (prop + after Draft)
  (fn-do + undo _
    (call (. session restore) before)
  )
  (fn-do + redo _
    (call (. session restore) after)
  )
)
