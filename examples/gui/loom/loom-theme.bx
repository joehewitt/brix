(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/text)
(import /gui)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop + throw-time Duration (= 320ms))
(prop + beat-time Duration (= 220ms))
(prop + library-width _ (= 232.0))
(prop + loom-gap _ (= 8.0))

(style LoomTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIMetrics)
  (using GUIBoxCursor)
  (using GUIBoxTransform)
  (prop + loom-backdrop RGBA (= (call RGBA "#e6dece")))
  (prop + loom-paper RGBA (= (call RGBA "#fbf8ef")))
  (prop + loom-rule RGBA (= (call RGBA "#b7cdcb")))
  (prop + loom-bold-rule RGBA (= (call RGBA "#7fa2a3")))
  (prop + loom-ink RGBA (= (call RGBA "#211e1b")))
  (prop + loom-plan RGBA (= (call RGBA "#211e1b38")))
  (prop + loom-mark RGBA (= (call RGBA "#c2552b26")))
  (prop + loom-shadow RGBA (= (call RGBA "#2a221c")))
  (prop + loom-wood RGBA (= (call RGBA "#9b6a40")))
  (prop + loom-wood-edge RGBA (= (call RGBA "#6e4526")))
  (prop + loom-glow Shadow (= (call Shadow (call RGBA "#3b2a1a40") 18 0 6)))
  (prop + shuttle-flight Motion (= (call ease-in-out throw-time)))
  (prop + beat-swing Motion (= (call ease-in 90ms)))
  (blank)
  (style-domains loom-paper (domain paint))
  (style-domains loom-rule (domain paint))
  (style-domains loom-bold-rule (domain paint))
  (style-domains loom-ink (domain paint))
  (style-domains loom-plan (domain paint))
  (style-domains loom-mark (domain paint))
  (style-domains loom-shadow (domain paint))
  (blank)
  (rule loom-window (• bg loom-backdrop) (• text gui-text-color)
    (= keeps-focus true)
  )
  (blank)
  (rule loom-library (• glass-panel) (• w library-width) (• m 10)
    (rule sidebar-body (• py 8))
  )
  (blank)
  (rule library-row (• h 44)
    (= font-size 13)
  )
  (blank)
  (rule library-swatch (• w 30) (• h 30) (• mr 10)
    (= corner-radius 6)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (rule loom-stage (• flex-col) (• flex 1) (• items-center) (• justify-center))
  (blank)
  (rule loom-frame (• flex-col) (• items-start)
    (= gap loom-gap)
  )
  (blank)
  (rule draft-band (• flex-row) (• items-end)
    (= gap loom-gap)
  )
  (blank)
  (rule draft-paper
    (= shadow loom-glow)
  )
  (blank)
  (rule cloth-stage
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
    (= shadow loom-glow)
  )
  (blank)
  (rule fell-row
    (= motion beat-swing)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 0 10))
    )
    (when-style (not #is-laid)
      (= opacity 70%%)
      (= translate (call Point 0 7))
    )
  )
  (blank)
  (rule shed (• flex-row) (• items-center) (• h 18)
    (when-style #is-right
      (= justify (. Justify end))
    )
  )
  (blank)
  (rule shuttle (• w 46) (• h 11) (• mx 2) (• bg loom-wood)
    (= corner-radius 5.5)
    (= border-width 1)
    (= border-color loom-wood-edge)
    (= shadow gui-lifted-shadow)
    (= (. motion position) shuttle-flight)
  )
  (blank)
  (rule beater (• absolute) (• h 5) (• bg loom-wood-edge)
    (= left (call (. PositionOffset coord) -6))
    (= right (call (. PositionOffset coord) -6))
    (= bottom (call (. PositionOffset coord) -2))
    (= corner-radius 2)
    (= motion gui-motion-quick)
    (when-style #is-beating
      (= translate (call Point 0 -15))
      (= motion beat-swing)
    )
  )
  (blank)
  (rule treadle-bank (• flex-row) (• items-start) (• h 92)
    (= gap 6)
  )
  (blank)
  (rule pedal (• flex-col) (• items-center) (• w 26) (• h 86) (• bg transparent)
    (= shadow null)
    (= border-width 0)
    (= cursor (. CursorStyle pointing-hand))
    (rule button-content
      (= display (. Display hidden))
    )
    (rule pedal-slat (• w 22) (• h 64) (• bg loom-wood)
      (= corner-radius 4)
      (= border-width 1)
      (= border-color loom-wood-edge)
      (= shadow gui-lifted-shadow)
      (= motion gui-motion-quick)
    )
    (rule pedal-number (• text gui-muted-text-color) (• mt 4)
      (= font-size 11)
      (= font-weight (. FontWeight semibold))
    )
    (when-style #is-hover-within (• bg transparent))
    (when-style #is-press-within (• bg transparent))
    (when-style #is-hovered
      (rule pedal-slat
        (= border-color loom-ink)
      )
    )
    (when-style #is-down
      (rule pedal-slat (• bg loom-wood-edge)
        (= translate (call Point 0 7))
        (= shadow null)
      )
      (rule pedal-number (• text gui-text-color))
    )
  )
  (blank)
  (rule palette-bar (• flex-row) (• items-center) (• h 30)
    (= gap 6)
  )
  (blank)
  (rule palette-swatch (• w 26) (• h 26) (• px 0) (• bg transparent) (• items-center) (• justify-center)
    (= shadow null)
    (rule button-content
      (= display (. Display hidden))
    )
    (rule yarn-dot (• w 20) (• h 20)
      (= corner-radius 10)
      (= border-width 1)
      (= border-color loom-plan)
      (= shadow gui-control-shadow)
      (= motion gui-motion-quick)
    )
    (when-style #is-hover-within (• bg transparent))
    (when-style #is-press-within (• bg transparent))
    (when-style #is-accent-pressed (• bg transparent))
    (when-style #is-on (• bg transparent)
      (rule yarn-dot
        (= border-width 2)
        (= border-color loom-ink)
        (= scale 1.15)
      )
    )
  )
  (blank)
  (rule yarn-well (• w 22) (• h 22) (• ml 10)
    (= corner-radius 6)
  )
  (blank)
  (rule toolbar-note (• text gui-muted-text-color) (• shrink 1)
    (= font-size 12)
  )
  (blank)
  (rule help-button (• absolute) (• w 28) (• h 28) (• bg gui-field-color)
    (= right (call (. PositionOffset coord) 16))
    (= bottom (call (. PositionOffset coord) 16))
    (= corner-radius 14)
    (= shadow gui-control-shadow)
  )
  (blank)
  (rule help-sheet (• w 380) (• flex-col)
    (= gap 4)
  )
  (blank)
  (rule help-title (• text gui-strong-text-color)
    (= font-size 13)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule help-counts (• text gui-muted-text-color) (• mb 8)
    (= font-size 12)
  )
  (blank)
  (rule help-row (• flex-row) (• items-center) (• h 20)
    (= font-size 12)
  )
  (blank)
  (rule help-key (• w 96) (• text gui-muted-text-color)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule help-note (• text gui-muted-text-color) (• mt 8)
    (= font-size 12)
    (= text-wrap (. TextWrap word))
  )
)

(style LoomDarkTheme (is LoomTheme) (for dark)
  (prop + loom-backdrop _ (= (call RGBA "#15110e")))
  (prop + loom-paper _ (= (call RGBA "#221d19")))
  (prop + loom-rule _ (= (call RGBA "#3a322b")))
  (prop + loom-bold-rule _ (= (call RGBA "#5d4f42")))
  (prop + loom-ink _ (= (call RGBA "#f1e8d6")))
  (prop + loom-plan _ (= (call RGBA "#f1e8d630")))
  (prop + loom-mark _ (= (call RGBA "#e0894f2e")))
  (prop + loom-shadow _ (= (call RGBA "#120e0b")))
  (prop + loom-wood _ (= (call RGBA "#7a4f2c")))
  (prop + loom-wood-edge _ (= (call RGBA "#3f2716")))
  (prop + loom-glow _ (= (call Shadow (call RGBA "#ffc47a38") 46 0 0)))
)

(style LoomStillTheme (is LoomTheme) (for reduce-motion)
  (prop + shuttle-flight _ (= instant))
  (prop + beat-swing _ (= instant))
)
