(import ./loom-draft)
(import /graphics/color)
(import /math)
(import /stream/aggregate)
(blank)
(prop _ twill (list String) (= (list "12" "23" "34" "41")))
(prop _ linen _ (= "#ece3cc"))
(prop _ cream _ (= "#f3ecdc"))
(prop _ indigo _ (= "#26395f"))
(prop _ madder _ (= "#9b2f2f"))
(prop _ charcoal _ (= "#2b2a2e"))
(prop _ ash _ (= "#b9b2a4"))
(prop _ walnut _ (= "#4b3425"))

(fn-expr + loom-library (list Draft)
  (call List
    (block
      (item (call draft "Plain weave" 48 "12" (list "1" "2") "12" (list cream madder) "0" "1"))
      (item (call draft "2/2 twill" 48 "1234" twill "1234" (list indigo cream) "0" "1"))
      (item (call draft "Herringbone" 64 "1234123421432143" twill "1234" (list charcoal ash) "0" "1"))
      (item (call draft "Goose eye" 56 "12341234321432" twill "12341234321432" (list walnut cream) "0" "1"))
      (item (call draft "Rosepath" 56 "12341432" twill "12341432" (list linen madder) "0" "1"))
      (item (call draft "Houndstooth" 48 "1234" twill "1234" (list charcoal cream) "00001111" "00001111"))
      (item
        (call draft
          (block
            (arg "Log cabin")
            (arg 48)
            (arg "12")
            (arg (list "1" "2"))
            (arg "12")
            (arg (list charcoal cream))
            (arg "0101010110101010")
            (arg "0101010110101010")
          )
        )
      )
      (item
        (call draft
          (block
            (arg "Monk's belt")
            (arg 64)
            (arg "12121212343412121212343434343434")
            (arg (list "12" "34" "13" "24"))
            (arg "23242324131423242324131413141314")
            (arg (list linen madder))
            (arg "0")
            (arg "10")
          )
        )
      )
      (item
        (call draft
          (block
            (arg "Star coverlet")
            (arg 84)
            (arg "12121212323232343414141414143434323232")
            (arg (list "34" "14" "12" "23" "13" "24"))
            (arg "1516151615161516252625262526353635364546454645464546454635363536252625262526")
            (arg (list linen indigo))
            (arg "0")
            (arg "10")
          )
        )
      )
    )
  )
)

(fn-expr + opening-draft Draft
  ([] (call loom-library) 1)
)

(fn-expr _ draft Draft
  (param name String)
  (param ends Size)
  (param threading String)
  (param tie-up (list String))
  (param treadling String)
  (param colors (list String))
  (param warp String)
  (param weft String)
  (call Draft name shafts (. tie-up length) heddles lifts treads palette warp-colors weft-colors)
  (where
    (lazy unit (call digits threading))
    (lazy steps (call digits treadling))
    (lazy picks (call max (. steps length) (. weft length)))
    (lazy shafts (as (call max (in each (call digits (++ threading (call (. "" join) tie-up))))) Size))
    (lazy heddles (call List (in (call (of bits-of Shafts) (list ([] unit (% each (. unit length))))) (..< 0 ends))))
    (lazy lifts (call List (in (call (of bits-of Shafts) (call digits each)) tie-up)))
    (lazy treads (call List (in (call (of bits-of Treadles) (list ([] steps (% each (. steps length))))) (..< 0 picks))))
    (lazy palette (call List (in (call RGBA each) colors)))
    (lazy warp-colors (call cycled (call digits warp) ends))
    (lazy weft-colors (call cycled (call digits weft) picks))
  )
)

(fn-expr _ digits (list Int)
  (param marks String)
  (call List (in (- (as each Int) (as (char "0") Int)) marks))
)

(fn-expr _ cycled (list Index)
  (param marks (list Int))
  (param count Size)
  (call List (in ([] marks (% each (. marks length))) (..< 0 count)))
)
