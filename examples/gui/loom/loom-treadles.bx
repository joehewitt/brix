(import ./loom-draft)
(import ./loom-theme)
(import /gui)
(import /math)
(import /ui/key-combo)
(blank)
(prop _ treadle-keys _ (= 8))

(type + TreadleBank (is Box)
  (using LoomTheme)
  (prop + count Size)
  (prop + pressed _ (= (call Treadles)))
  (prop + held _ (= (call Treadles)))
  (event + treadled Treadles)
  (content
    (<> This (• treadle-bank)
      (for (in treadle (call slots #count))
        (<> Pedal
          (= number (+ treadle 1))
          (= is-down (or ([] #held treadle) ([] #pressed treadle)))
          (= action (=> () :do (<- treadled (call (of bits-of Treadles) (list (+ treadle 1))))))
        )
      )
      (for (in treadle (call slots (call min #count treadle-keys)))
        (<> TreadleKey
          (= bank this)
          (= treadle treadle)
          (= key (call KeyCombo (str (+ treadle 1))))
        )
      )
    )
  )
  (fn-do + hold _
    (param treadle Index)
    (param down Bool)
    (= ([] held treadle) down)
  )
)

(type + Pedal (is Button)
  (using LoomTheme)
  (prop + number Int)
  (prop + is-down _ (= false))
  (content
    (<> This (• pedal)
      (<> Box (• pedal-slat))
      (<> Label (• pedal-number)
        (= text (str #number))
      )
    )
  )
)

(type + TreadleKey (is KeyBinding)
  (prop + bank TreadleBank)
  (prop + treadle Index)
  (prop _ code U32)
  (fn-do + press _
    (param event KeyPressEvent)
    (return-if (if (. event is-repeat)))
    (= code (. event native-key-code))
    (call (. bank hold) treadle true)
  )
  (fn-do + release _
    (param event KeyReleaseEvent)
    (if (and (!= code 0) (== (. event native-key-code) code))
      (call release-active)
    )
  )
  (fn-do + release-active _
    (= code 0)
    (call (. bank hold) treadle false)
  )
)
