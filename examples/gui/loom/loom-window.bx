(import ./loom-cloth)
(import ./loom-draft)
(import ./loom-draft-view)
(import ./loom-library)
(import ./loom-session)
(import ./loom-sound)
(import ./loom-theme)
(import ./loom-treadles)
(import ./loom-wif)
(import /graphics/primitives)
(import /gui)
(import /gui/file-dialogs)
(import /gui/icons/lucide/circle-question-mark)
(import /gui/icons/lucide/download)
(import /gui/icons/lucide/folder-open)
(import /gui/icons/lucide/redo-2)
(import /gui/icons/lucide/save)
(import /gui/icons/lucide/undo-2)
(import /math)
(import /os/file)
(import /os/path)
(import /time/timer)
(blank)
(prop _ cloth-width _ (= 840.0))
(prop _ stage-height _ (= 640.0))
(prop _ fell-margin _ (= 4))
(prop _ loom-keys _
  (=
    (list
      (tuple "Space" "Weave the next pick from the treadling")
      (tuple "1–8 + Space" "Weave with the treadles held, and record them")
      (tuple "⌫" "Unweave the last pick")
      (tuple "⌘Z  ⇧⌘Z" "Undo and redo")
      (tuple "⌘O  ⌘S  ⌘E" "Open, save, and export the cloth")
    )
  )
)

(type + LoomWindow (is Window)
  (using LoomTheme)
  (prop + sound LoomSound)
  (prop + session _ (= (call LoomSession)))
  (prop + view _ (= (. LoomView cloth)))
  (prop + undo-target _ (=> session))
  (prop _ file-path (? Path))
  (prop _ status _ (= ""))
  (event + throws Index)
  (prop + stroke _
    (machine
      (state resting)
      (state (call throwing pick) (trigger for pick throws)
        (then (call beating pick) (trigger on (call Timer throw-time)))
      )
      (state (call beating pick)
        (call (. sound beat) (if-expr (== (% pick 2) 0) 0.5 -0.5))
        (then resting (trigger on (call Timer beat-time)))
      )
    )
  )
  (prop _ draft _ (= (. #session #draft)))
  (prop _ woven _ (= (. #session #woven)))
  (prop _ cell _ (= (call cell-size #draft)))
  (prop _ shown _ (= (call shown-picks #draft #cell)))
  (prop _ first _ (= (call max 0 (- (+ #woven fell-margin) #shown))))
  (prop _ pressed _ (= (if-expr (or (is #stroke .resting) (== #woven 0)) (call Treadles) (call (. #draft treads) (- #woven 1)))))
  (whenever-rule #draft
    (= status "")
  )
  (content
    (<> This (• loom-window) (• flex-col)
      (= title (str (. #draft name) " — Loom"))
      (= size (call Dimensions 1380 900))
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= state-key "loom")
      (<> Toolbar
        (= is-title-bar true)
        (<> ToolbarTitle
          (= text (. #draft name))
        )
        (if (!= #status "")
          (<> Label (• toolbar-note)
            (= text #status)
          )
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> (of SegmentedControl LoomView)
            (<-> selected view)
            (<> (of Segment LoomView) (text: "Draft")
              (= value (. LoomView draft))
            )
            (<> (of Segment LoomView) (text: "Cloth")
              (= value (. LoomView cloth))
            )
          )
        )
        (<> ToolbarSpace)
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-undo-2)
            (= is-enabled (. #session #can-undo))
            (= action (=> () :do (call (. session undo))))
            (<> Tooltip
              (= text (. #session #undo-title))
            )
          )
          (<> ToolbarButton (• icon-redo-2)
            (= is-enabled (. #session #can-redo))
            (= action (=> () :do (call (. session redo))))
            (<> Tooltip
              (= text (. #session #redo-title))
            )
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (• icon-folder-open)
            (= action (=> () :do (call open-draft)))
            (<> Tooltip (text: "Open a WIF draft · ⌘O"))
          )
          (<> ToolbarButton (• icon-save)
            (= action (=> () :do (call save-draft)))
            (<> Tooltip (text: "Save as WIF · ⌘S"))
          )
        )
        (<> ToolbarGroup
          (<> ToolbarButton (text: "Export PNG") (• icon-download)
            (= is-default true)
            (= action (=> () :do (call export-draft)))
          )
        )
      )
      (<> Box (• flex-row) (• flex 1)
        (<> LoomLibrary
          (= session session)
        )
        (<> Box (• loom-stage)
          (<> Box (• loom-frame)
            (<> Box (• draft-band)
              (<> Box (• flex-col)
                (= gap loom-gap)
                (<> WarpStrip
                  (= session session)
                  (= cell #cell)
                  (= columns (. #draft ends))
                  (= rows 1)
                  (= color (. palette #current))
                  (= title "Colour warp")
                )
                (<> ThreadingGrid
                  (= session session)
                  (= cell #cell)
                  (= columns (. #draft ends))
                  (= rows (. #draft shafts))
                  (= bottom-up true)
                  (= title "Thread")
                )
              )
              (<> TieUpGrid
                (= session session)
                (= cell #cell)
                (= columns (. #draft treadles))
                (= rows (. #draft shafts))
                (= bottom-up true)
                (= title "Tie up")
              )
            )
            (<> Box (• draft-band) (• items-start)
              (<> ClothStage
                (= draft #draft)
                (= view #view)
                (= woven #woven)
                (= first #first)
                (= shown #shown)
                (= cell #cell)
                (= is-throwing (is #stroke .throwing))
                (= is-beating (is #stroke .beating))
              )
              (<> TreadlingGrid
                (= session session)
                (= cell #cell)
                (= columns (. #draft treadles))
                (= rows #shown)
                (= first #first)
                (= current (- #woven #first))
                (= title "Treadle")
              )
              (<> WeftStrip
                (= session session)
                (= cell #cell)
                (= columns 1)
                (= rows #shown)
                (= first #first)
                (= color (. palette #current))
                (= title "Colour weft")
              )
            )
            (<> Box (• draft-band) (• items-start)
              (<> PaletteBar (id: palette)
                (= session session)
                (= min-width (call (. SizeSpec coord) (* (. #draft ends) #cell)))
              )
              (<> TreadleBank (id: bank)
                (= count (. #draft treadles))
                (= pressed #pressed)
                (for (on treads treadled)
                  (call weave treads)
                )
              )
            )
          )
        )
        (<> IconButton (• icon-circle-question-mark) (• help-button)
          (= action (=> () :do (call (. help toggle))))
          (<> Popover (id: help) (• help-sheet)
            (= placement (call AnchoredPlacement (. Side top) (. AnchorPoint end) 0))
            (<> Label (• help-title)
              (= text (str "Row " #woven " of " (. #draft name)))
            )
            (<> Label (• help-counts)
              (= text (str (. #draft ends) " ends · " (. #draft shafts) " shafts · " (. #draft treadles) " treadles · " (. #draft picks) " picks to repeat"))
            )
            (for (in (tuple keys meaning) loom-keys)
              (<> Box (• help-row)
                (<> Label (text: keys) (• help-key))
                (<> Label (text: meaning) (• flex 1))
              )
            )
            (<> Label (text: "Click the threading, tie-up and treadling to change them, and drag along the threading to draw a run. Choose a yarn under the cloth, then click the colour strips to paint with it.") (• help-note))
          )
        )
      )
      (<> KeyShortcut (text: "Weave")
        (= key .space)
        (= repeat false)
        (= action (=> () :do (call weave (. bank held))))
      )
      (<> KeyShortcut (text: "Unweave")
        (= key .backspace)
        (= action (=> () :do (call (. session unweave))))
      )
      (<> KeyShortcut (text: "Open draft")
        (= key (call KeyCombo "Cmd+O"))
        (= action (=> () :do (call open-draft)))
      )
      (<> KeyShortcut (text: "Save draft")
        (= key (call KeyCombo "Cmd+S"))
        (= action (=> () :do (call save-draft)))
      )
      (<> KeyShortcut (text: "Export PNG")
        (= key (call KeyCombo "Cmd+E"))
        (= action (=> () :do (call export-draft)))
      )
    )
  )
  (fn-do + weave _
    (param held Treadles)
    (call (. session weave) held)
    (<- throws (- (. session woven) 1))
  )
  (fn-do _ open-draft _
    (let path (call choose-open-path this (list "wif")))
    (return-if (if (not path)))
    (let draft (call read-wif (call read-file-text path) (. path base-name)))
    (on-error (: error Error)
      (= status (str error))
      (return)
    )
    (call (. session open) draft "Open draft")
    (= file-path path)
    (= status (str "Opened " (. path name)))
  )
  (fn-do _ save-draft _
    (call (. session finish-gesture))
    (let path (?? file-path (call choose-save-path this (str (. session draft name) ".wif") (list "wif"))))
    (return-if (if (not path)))
    (call write-file-atomically path (call wif-text (. session draft)))
    (on-error (: error Error)
      (= status (str error))
      (return)
    )
    (= file-path path)
    (call (. session history mark-saved))
    (= status (str "Saved " (. path name)))
  )
  (fn-do _ export-draft _
    (let draft (. session draft))
    (let path (call choose-save-path this (str (. draft name) ".png") (list "png")))
    (return-if (if (not path)))
    (call export-cloth draft (call max (. session woven) (. draft picks)) path)
    (on-error (: error Error)
      (= status (str error))
      (return)
    )
    (= status (str "Exported " (. path name)))
  )
)

(type + LoomLibrary (is Sidebar)
  (using LoomTheme)
  (prop + session LoomSession)
  (content
    (<> This (• loom-library)
      (<> SidebarSection (text: "Drafts")
        (for (in draft (call loom-library))
          (<> SidebarItem (• library-row)
            (= title (. draft name))
            (= is-on (== (. #session #draft name) (. draft name)))
            (= action (=> () :do (call (. session open) draft (str "Open " (. draft name)))))
            (<> DraftThumbnail (slot: leading) (• library-swatch)
              (= draft draft)
            )
          )
        )
      )
    )
  )
)

(fn-expr + cell-size Float
  (param draft Draft)
  (call clamp (call floor (/ cloth-width (. draft ends))) 5.0 16.0)
)

(fn-expr + shown-picks Size
  (param draft Draft)
  (param cell Float)
  (call max 12 (as (call floor (/ (- stage-height (* (+ (. draft shafts) 1) cell)) cell)) Size))
)
