; Units: a percentage is a unit like any other, a hundredth of a ratio. A type
; that knows its own range can be made from a ratio, as an hour is from a slider.
(import /time/datetime)
(import /units)
(blank)

(main
  (let discount 25%)
  (let price 80.0)
  (print (str (as discount UnitString) " is the ratio " (as (as discount Ratio) UnitString)))
  ; The left side is a ratio, so the percentage is converted before it is subtracted.
  (print (str "the jacket costs " (call (. (* price (- 1%% discount)) places) 2)))
  (print (str "half off is a better deal: " (> 50% discount)))
  (blank)
  ; `Hour` runs from 0 to 23, so a slider position converts straight to an hour.
  (for (in position (list 0%% 0.25%% 0.5%% 0.75%%))
    (let hour (as position Hour))
    (print (str "slider at " (as (as position Percent) UnitString) " picks " (as hour UnitString)))
  )
)
