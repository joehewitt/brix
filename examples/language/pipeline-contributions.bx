; Pipelines begin with contributions: each row gives one item, every item of a
; source, or nothing at all. The rows read like the sequence they make.
(main
  (print (str "guest: " (call (. ", " join) (call file-menu false null))))
  (let recent (list "notes.txt" "todo.txt"))
  (print (str "editor: " (call (. ", " join) (call file-menu true recent))))
  (blank)
  ; `bullet` gives its value as one item, even when that value is a list.
  (let rows List
    (block
      (bullet (list "Mon" "Tue"))
      (bullet (list "Wed"))
    )
  )
  ; `bullet*` gives each item of its value.
  (let days List
    (block
      (bullet* (list "Mon" "Tue"))
      (bullet* (list "Wed"))
    )
  )
  (print (str (. rows length) " rows, " (. days length) " days"))
  (blank)
  ; Rows can be written where a function takes a stream, with no list made first.
  (print
    (call (. " > " join)
      (block
        (bullet "Home")
        (bullet* (list "Documents" "Recipes"))
        (bullet ([] recent 0))
      )
    )
  )
)

(fn-expr + file-menu (list String)
  (param can-edit Bool)
  (param recent (? (list String)))
  ; The body of this function is the menu it gives, top to bottom.
  (bullet "Open")
  ; `bullet*?` gives every recent file, or nothing when there is no list.
  (bullet*? recent)
  ; `bullet?` leaves its row out when the value is null.
  (bullet? (only-if "Save" (if can-edit)))
  (bullet? (only-if "Delete" (if can-edit)))
  (bullet* (list "Print" "Close"))
)
