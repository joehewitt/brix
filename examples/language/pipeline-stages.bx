; Pipeline stages: rows under a source that filter, map and pass on its items.
; Each stage reads the item as `each` and works on what the stage above it gives,
; so the order of the rows is the order of the work.
(import /stream/aggregate)
(blank)

(main
  (let orders (list 40 55 60 80 120))
  (blank)
  ; `*>` maps and `?>` keeps. Here the coupon comes off before the shipping test.
  (let coupon-first
    (block
      (bullet* orders)
      (pipe *> (- each 10))
      (pipe ?> (>= each 50))
    )
  )
  (print (str "coupon, then free shipping: " (call (. ", " join) coupon-first)))
  (blank)
  ; The same two stages the other way round let the 55 order through.
  (let shipping-first
    (block
      (bullet* orders)
      (pipe ?> (>= each 50))
      (pipe *> (- each 10))
    )
  )
  (print (str "free shipping, then coupon: " (call (. ", " join) shipping-first)))
  (blank)
  ; `?*>` maps and keeps in one stage: a null result is left out.
  (let points
    (block
      (bullet* orders)
      (pipe ?*> (only-if (/ each 10) (if (>= each 60))))
    )
  )
  (print (str "points: " (call (. ", " join) points)))
  (blank)
  ; A stage can follow any stream directly, with no rows above it.
  (print (str "double points day: " (call (. ", " join) (*> orders (* each 2)))))
  (blank)
  ; `*|>` runs a step for each item and passes the item on. `|>` hands the whole
  ; stream to a function, here the library's `sum`.
  (let revenue
    (block
      (bullet* orders)
      (pipe *|> (call audit each))
      (pipe *> (- each 10))
      (pipe |> sum)
    )
  )
  (print (str "revenue after coupons: " revenue))
  (blank)
  ; `|=>` hands the value above it to an expression, which reads it as `it`.
  (let summary
    (block
      (bullet* orders)
      (pipe ?> (>= each 100))
      (pipe |> List)
      (pipe |=> (str "orders of 100 or more: " (. it length) " of " (. orders length)))
    )
  )
  (print summary)
  (blank)
  ; `*->` ends a pipeline by writing each item to a target, here a list.
  (let packed (call (of List Int)))
  (*-> (?> orders (< each 60)) packed)
  (print (str "packed first: " (call (. ", " join) packed)))
)

(fn-do + audit _
  (param order Int)
  (if (> order 100)
    (print (str "  (audit: an order of " order ")"))
  )
)
