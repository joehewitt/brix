; Answer first: the body of a function is its result, and the lazy bindings
; under `where` say how the parts of that result are made. A binding is worked
; out only when something reads it.
(main
  (print (call invoice "Studio rental" 6 120 false))
  (blank)
  ; An exempt invoice never reads `tax`, so the rate is never looked up.
  (print (call invoice "Charity workshop" 3 120 true))
)

(fn-expr + invoice String
  (param label String)
  (param hours Int)
  (param rate Int)
  (param is-exempt Bool)
  ; The answer stands first and uses names that are bound below it.
  (str label ": " hours " hours, " total " due" detail)
  (where
    ; The order of the bindings does not matter: each runs when it is first read.
    (lazy total (if-expr is-exempt subtotal (+ subtotal tax)))
    (lazy detail (if-expr is-exempt " (tax exempt)" (str " (includes " tax " tax)")))
    (lazy subtotal (* hours rate))
    ; `total` and `detail` both read `tax`, and it is still worked out once.
    (lazy tax (call tax-on subtotal))
  )
)

(fn-expr + tax-on Int
  (param amount Int)
  (before
    ; This print runs ahead of the value, so it shows when the call happens.
    (print "  (looking up the tax rate)")
  )
  (/ amount 5)
)
