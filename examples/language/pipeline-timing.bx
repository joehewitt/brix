; Pipelines are lazy: writing one runs none of its stages. Each item passes
; through every stage when a reader asks for it, and an item nobody asks for
; is never worked on.
; `*|>` runs a step for each item and passes the item on. `*>` maps it.
(main
  (let cups
    (block
      (bullet* (list "espresso" "latte" "mocha"))
      (pipe *|> (call grind each))
      (pipe *> (str "a cup of " each))
    )
  )
  (print "orders taken, nothing ground yet")
  (blank)
  ; The loop pulls one cup at a time, so grinding and serving take turns.
  (for (in cup cups)
    (print (str "  served " cup))
    (if (== cup "a cup of latte")
      (break)
    )
  )
  (print "closed early: the mocha was never ground")
  (blank)
  ; `List` asks for every item at once, so all the grinding comes first.
  (let teas
    (block
      (bullet "green tea")
      (bullet "chai")
      (pipe *|> (call steep each))
    )
  )
  (print (str "  served " (call (. " and " join) teas)))
)

(fn-do + grind _
  (param order String)
  (print (str "  grinding beans for " order))
)

(fn-do + steep _
  (param order String)
  (print (str "  steeping " order))
)
