; Interfaces: an interface names a capability, a type says it provides it, and
; a function can ask for the capability without knowing the type behind it.
(main
  ; Three unrelated types, held as the one thing they share.
  (let shapes (call (of List Shape) (call Rect 4 3) (call Square 5) (call Triangle 6 4)))
  (for (in each shapes)
    (print (call describe each))
  )
  (print (str "largest: " (call (. (call largest shapes) name))))
)

(type + Shape (is Interface)
  ; The interface says only what a shape can answer, not how it is stored.
  (fn-expr + name String)
  (fn-expr + area Float)
)

(type + Rect (is Tuple)
  (implements Shape)
  ; `(implements Shape)` is the whole promise. The compiler checks that `name` and `area` exist.
  (blank)
  (prop + width Float)
  (prop + height Float)
  (fn-expr + name _
    "rectangle"
  )
  (fn-expr + area _
    (* width height)
  )
)

(type + Square (is Tuple)
  (implements Shape)
  (prop + side Float)
  (fn-expr + name _
    "square"
  )
  (fn-expr + area _
    (* side side)
  )
)

(type + Triangle (is Tuple)
  (implements Shape)
  (prop + base Float)
  (prop + height Float)
  (fn-expr + name _
    "triangle"
  )
  (fn-expr + area _
    (/ (* base height) 2)
  )
)

(fn-expr + describe String
  (param shape Shape)
  ; These two functions take any Shape, including one written after them.
  (str (call (. shape name)) " covers " (call (. shape area)))
)

(fn-do + largest Shape
  (param shapes (list Shape))
  (let best ([] shapes 0))
  (for (in each shapes)
    (if (> (call (. each area)) (call (. best area)))
      (= best each)
    )
  )
  (return best)
)
