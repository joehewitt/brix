; Enums: named values of one type. Every member has the same fields and the
; same methods, so no test is needed before reading them.
(main
  (let planets
    (call List
      (block
        (bullet (. Planet mercury))
        (bullet (. Planet earth))
        (bullet (. Planet jupiter))
      )
    )
  )
  (for (in planet planets)
    (print (str (. planet name) " has " (. planet moon-count)))
    (print (str "  a 70 kg suitcase weighs " (call (. planet weigh) 70) " kg there"))
  )
  (blank)
  (print (str "leaving from " (call origin (. Planet earth))))
  (print (str "leaving from " (call origin (. Planet jupiter))))
)

(type + Planet (is (tuple (: name String) (: gravity Float) (: moons Int)))
  ; The type gives the shape that every member shares.
  (blank)
  ; Each member is a named value of that shape.
  (variant mercury (= (tuple "Mercury" 3.7 0)))
  (variant earth (= (tuple "Earth" 9.8 1)))
  (variant jupiter (= (tuple "Jupiter" 24.8 95)))
  (fn-expr + weigh Int
    (param mass Float)
    ; A method can read another member: Earth's gravity is the yardstick here.
    (as (/ (* mass gravity) (. Planet earth gravity)) Int)
  )
  (fn-expr + moon-count String :get
    (if-expr (== moons 0) "no moons" (str "a moon count of " moons))
  )
)

(fn-expr + origin String
  (param planet Planet)
  ; A member is matched as a value, with `case=`. It has no payload to take apart.
  (match planet
    (case= (. Planet earth)
      "home"
    )
    (default
      (str "far away, on " (. planet name))
    )
  )
)
