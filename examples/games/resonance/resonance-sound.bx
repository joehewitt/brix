(import ./resonance-game)
(import /math)
(import /media/audio-output)
(import /media/mixer)
(import /media/synth)
(import /time/duration)
(import /units)
(blank)
(prop _ scale _ (= (list 0st 2st 4st 7st 9st 12st 14st)))

(fn-expr + resonance-sounds SoundBank
  (<> SoundBank
    (<> SoundPatch (text: "strand")
      (= min-gap 50ms)
      (= polyphony 16)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 220hz)
        (= attack 3ms)
        (= decay 1500ms)
        (= fm-ratio 2)
        (= fm-depth 1.2)
        (= fm-depth-end 0.05)
        (= level 28%)
        (= reverb 38%)
      )
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 660hz)
        (= attack 2ms)
        (= decay 380ms)
        (= level 5%)
        (= reverb 30%)
      )
    )
    (blank)
    (<> SoundPatch (text: "bell")
      (= min-gap 80ms)
      (= polyphony 6)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 440hz)
        (= attack 4ms)
        (= decay 2400ms)
        (= fm-ratio 3.5)
        (= fm-depth 1.4)
        (= fm-depth-end 0.2)
        (= level 24%)
        (= reverb 45%)
        (= echoes 1)
        (= echo-gap 180ms)
        (= echo-level 30%)
      )
    )
  )
)

(type + ResonanceSound
  (implements Closable)
  (prop + is-muted Bool)
  (prop + is-unavailable Bool)
  (prop + mixer Mixer)
  (prop _ output (? AudioOutput))
  (fn-do + This _
    (param bank SoundBank)
    (lazy mixer (call Mixer bank))
  )
  (fn-do + play _
    (param note ResonanceNote)
    (return-if (if (or is-muted (not (call is-open)))))
    (blank)
    (let patch (!! (call (. mixer bank find) (if-expr (. note is-bell) "bell" "strand"))))
    (let pitch (call pitch-ratio ([] scale (% (. note voice) (. scale length)))))
    (call (. mixer play) patch (* (. note strength) 0.7) (* (. note pan) 0.75) pitch)
  )
  (fn-do + toggle _
    (= is-muted (not is-muted))
    (call (. mixer set-volume) (if-expr is-muted 0 1))
    (call hush)
  )
  (fn-do + hush _
    (call (. mixer hush))
  )
  (fn-do _ is-open Bool
    (return-if false (if is-unavailable))
    (return-if true (if output))
    (blank)
    (= output
      (call AudioOutput mixer
        (block
          (on-error (: problem Error)
            (= is-unavailable true)
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do + close _
    (call (?. output close))
    (= output null)
    (call (. mixer cues close))
  )
)
