(import ./resonance-string)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop + resonance-stage-size _ (= (call Dimensions 1000 800)))
(prop + resonance-center _ (= (call Point 500 410)))
(prop + resonance-radius _ (= 318.0))
(prop + resonance-voices _ (= 7))
(prop + resonance-bloom-length Seconds (= 3s))
(prop _ anchor-radius _ (= 238.0))
(prop _ bell-radius _ (= 288.0))
(prop _ bell-count _ (= 3))
(prop _ phrase-turn Radians (= 0.18rad))
(prop _ hover-reach _ (= 24.0))
(prop _ pull-limit _ (= 115.0))
(prop _ mote-limit _ (= 18))
(prop _ ripple-limit _ (= 20))
(prop _ trail-length _ (= 18))
(prop _ trail-interval Seconds (= 16ms))
(prop _ mote-lifetime Seconds (= 12s))
(prop + resonance-ripple-lifetime Seconds (= 2.2s))
(prop _ ring-gap Seconds (= 120ms))
(prop _ launch-guard Seconds (= 150ms))
(prop _ bounce-guard Seconds (= 45ms))
(prop _ mote-radius _ (= 5.5))
(prop _ bell-reach _ (= 27.0))
(prop _ top-speed _ (= 850.0))
(prop _ wall-bounce _ (= 1.9))
(prop _ strand-bounce _ (= 1.7))
(prop _ pan-width _ (= 400.0))
(prop _ longest-frame Seconds (= 50ms))
(prop _ substeps-per-second _ (= 240.0))

(type + ResonanceNote (is (tuple (: voice Int) (: strength Float) (: pan Float) (: is-bell Bool))))

(type + StrandTouch (is (tuple (: voice Int) (: node Int))))

(type + LightMote
  (prop + place Point)
  (prop + velocity Point)
  (prop + voice Int)
  (prop + expires-at Seconds)
  (prop + ready-at Seconds)
  (prop + sampled-at Seconds)
  (prop + trail _ (= (call (of List Point))))
  (fn-do + This _
    (param place _)
    (param velocity _)
    (param voice _)
    (param born Seconds)
    (= expires-at (+ born mote-lifetime))
    (= ready-at (+ born launch-guard))
    (= sampled-at born)
  )
)

(type + ResonanceBell
  (prop + point Point)
  (prop + voice Int)
  (prop + is-lit Bool)
  (prop + rang-at (? Seconds))
  (fn-do + This _
    (param point _)
    (param voice _)
  )
)

(type + ResonanceRipple
  (prop + point Point)
  (prop + voice Int)
  (prop + born Seconds)
  (fn-do + This _
    (param point _)
    (param voice _)
    (param born _)
  )
)

(type + ResonanceGame
  (event + notes ResonanceNote)
  (event + blooms Bool)
  (prop + strings _ (= (call (of List ResonanceString))))
  (prop + bells _ (= (call (of List ResonanceBell))))
  (prop + motes _ (= (call (of List LightMote))))
  (prop + ripples _ (= (call (of List ResonanceRipple))))
  (prop + clock Seconds)
  (prop + phrase Int)
  (prop + bloomed-at (? Seconds))
  (prop + hover (? StrandTouch))
  (prop + held (? StrandTouch))
  (fn-do + This _
    (call reset)
  )
  (fn-expr + bloom-progress Float :get
    (match bloomed-at
      (case= null
        0.0
      )
      (default
        (call clamp-unit (/ (- clock bloomed-at) resonance-bloom-length))
      )
    )
  )
  (fn-expr + is-touched Bool
    (param voice Int)
    (or (== (?. hover voice) voice) (== (?. held voice) voice))
  )
  (fn-do + reset _
    (= phrase 1)
    (= clock 0)
    (call arrange)
  )
  (fn-do + advance-phrase _
    (+= phrase 1)
    (call arrange)
  )
  (fn-do + aim _
    (param point Point)
    (let touch held)
    (if touch
      (let strand ([] strings (. touch voice)))
      (let offset (call (. (- point (call (. strand rest) (. touch node))) dot) (. strand normal)))
      (call (. strand pull) (. touch node) (call clamp offset (- pull-limit) pull-limit))
      (return)
    )
    (= hover (call nearest-touch point))
  )
  (fn-do + grab _
    (param point Point)
    (call aim point)
    (let touch hover)
    (return-if (if (not touch)))
    (= held touch)
    (= (. ([] strings (. touch voice)) glow) 1)
  )
  (fn-do + release _
    (let touch held)
    (return-if (if (not touch)))
    (= held null)
    (let strand ([] strings (. touch voice)))
    (let origin (call (. strand point) (. touch node)))
    (let pull (call (. strand displacement-at) (. touch node)))
    (let is-tap (< (call abs pull) 8))
    (if is-tap
      (call (. strand excite) (. touch node) -180)
    )
    (let speed (if-expr is-tap -120.0 (* pull -6)))
    (if (>= (. motes length) mote-limit)
      (call (. motes pop-first))
    )
    (+= motes (call LightMote origin (* (. strand normal) speed) (. strand voice) clock))
    (call ring strand (call min 1.0 (+ 0.25 (/ (call abs pull) pull-limit))) origin)
  )
  (fn-do + cancel _
    (= held null)
    (= hover null)
  )
  (fn-do + pulse _
    (for (in strand strings)
      (call (. strand excite) 12 (if-expr (== (% (. strand voice) 2) 0) 190 -190))
      (call ring strand 0.38 (call (. strand point) 12))
    )
  )
  (fn-do + play _
    (param elapsed Seconds)
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
      (for (in mote motes)
        (call fly mote dt)
      )
      (if (call all bells (:where (. each is-lit)))
        (call bloom)
        (call expire)
        (return)
      )
    )
    (call expire)
  )
  (fn-do + resonate _
    (param elapsed Seconds)
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
    )
    (call expire)
  )
  (fn-do _ arrange _
    (call (. strings clear))
    (call (. bells clear))
    (call (. motes clear))
    (call (. ripples clear))
    (call cancel)
    (= bloomed-at null)
    (let turn (* phrase-turn (- phrase 1)))
    (for (in voice (..< 0 resonance-voices))
      (let start (+ (/ π -2) (/ (* π 2 voice) resonance-voices) turn))
      (let end (+ start (/ (* π 6) resonance-voices)))
      (let head (call resonance-orbit start anchor-radius))
      (+= strings (call ResonanceString head (call resonance-orbit end anchor-radius) voice))
    )
    (for (in index (..< 0 bell-count))
      (let angle (+ (/ π -2) (/ (* π 2 index) bell-count)))
      (+= bells (call ResonanceBell (call resonance-orbit angle bell-radius) (* index 2)))
    )
  )
  (fn-do _ nearest-touch (? StrandTouch)
    (param point Point)
    (let found (? StrandTouch))
    (let nearest hover-reach)
    (for (in strand strings)
      (for (in node (..< 2 (- strand-segments 1)))
        (let distance (call (. point distance) (call (. strand point) node)))
        (if (< distance nearest)
          (= nearest distance)
          (= found (call StrandTouch (. strand voice) node))
        )
      )
    )
    (return found)
  )
  (fn-do _ bloom _
    (= bloomed-at clock)
    (call cancel)
    (for (in strand strings)
      (call (. strand excite) 12 220)
      (call ring strand 0.5 (call (. strand point) 12))
    )
    (<- blooms true)
  )
  (fn-do _ tick _
    (param dt Float)
    (+= clock dt)
    (for (in strand strings)
      (call (. strand step) dt (call held-node (. strand voice)))
    )
  )
  (fn-expr _ held-node (? Int)
    (param voice Int)
    (case? (not touch)
      null
    )
    (case? (!= (. touch voice) voice)
      null
    )
    (default
      (. touch node)
    )
    (where
      (lazy touch held)
    )
  )
  (fn-do _ fly _
    (param mote LightMote)
    (param dt Float)
    (+= (. mote place) (* (. mote velocity) dt))
    (call sample-trail mote)
    (call contain mote)
    (return-if (if (call chime mote)))
    (return-if (if (< clock (. mote ready-at))))
    (for (in strand strings)
      (for (in node (..< 0 strand-segments))
        (if (call collide mote strand node)
          (if (call is-quiet strand)
            (call ring strand 0.23 (. mote place))
          )
          (return)
        )
      )
    )
  )
  (fn-do _ sample-trail _
    (param mote LightMote)
    (return-if (if (< (- clock (. mote sampled-at)) trail-interval)))
    (= (. mote sampled-at) clock)
    (+= (. mote trail) (. mote place))
    (if (> (. mote trail length) trail-length)
      (call (. mote trail pop-first))
    )
  )
  (fn-do _ contain _
    (param mote LightMote)
    (let offset (- (. mote place) resonance-center))
    (let distance (. offset length))
    (return-if (if (<= distance resonance-radius)))
    (let normal (/ offset distance))
    (= (. mote place) (+ resonance-center (* normal resonance-radius)))
    (let approach (call (. mote velocity dot) normal))
    (if (> approach 0)
      (-= (. mote velocity) (* normal (* wall-bounce approach)))
    )
  )
  (fn-do _ chime Bool
    (param mote LightMote)
    (for (in bell bells)
      (if (and (not (. bell is-lit)) (< (call (. bell point distance) (. mote place)) bell-reach))
        (= (. bell is-lit) true)
        (= (. bell rang-at) clock)
        (= (. mote expires-at) clock)
        (<- notes (call ResonanceNote (. bell voice) 0.8 (call pan-of (. bell point)) true))
        (call ripple (. bell point) (. bell voice))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ collide Bool
    (param mote LightMote)
    (param strand ResonanceString)
    (param node Int)
    (let start (call (. strand point) node))
    (let span (- (call (. strand point) (+ node 1)) start))
    (let along (call (. (- (. mote place) start) dot) span))
    (let t (call clamp (/ along (call max 1.0 (call (. span dot) span))) 0.0 1.0))
    (let offset (- (. mote place) (+ start (* span t))))
    (let distance (. offset length))
    (return-if false (if (or (>= distance mote-radius) (< distance 0.001))))
    (let normal (/ offset distance))
    (let relative (- (. mote velocity) (* (. strand normal) (call (. strand velocity-at) node t))))
    (let approach (call (. relative dot) normal))
    (return-if false (if (>= approach 0)))
    (+= (. mote place) (* normal (- (+ mote-radius 0.1) distance)))
    (-= (. mote velocity) (* normal (* strand-bounce approach)))
    (let speed (. mote velocity length))
    (if (> speed top-speed)
      (= (. mote velocity) (* (. mote velocity) (/ top-speed speed)))
    )
    (= (. mote ready-at) (+ clock bounce-guard))
    (= (. mote voice) (. strand voice))
    (call (. strand excite) (call clamp node 1 (- strand-segments 1)) (* approach -0.45))
    (return true)
  )
  (fn-expr _ is-quiet Bool
    (param strand ResonanceString)
    (match (. strand rang-at)
      (case= null
        true
      )
      (default
        (>= (- clock (. strand rang-at)) ring-gap)
      )
    )
  )
  (fn-do _ ring _
    (param strand ResonanceString)
    (param strength Float)
    (param point Point)
    (= (. strand glow) (call max (. strand glow) strength))
    (= (. strand rang-at) clock)
    (<- notes (call ResonanceNote (. strand voice) strength (call pan-of point) false))
    (call ripple point (. strand voice))
  )
  (fn-do _ ripple _
    (param point Point)
    (param voice Int)
    (if (>= (. ripples length) ripple-limit)
      (call (. ripples pop-first))
    )
    (+= ripples (call ResonanceRipple point voice clock))
  )
  (fn-do _ expire _
    (= motes (call (of List LightMote) (in each motes (when (< clock (. each expires-at))))))
    (= ripples (call (of List ResonanceRipple) (in each ripples (when (< (- clock (. each born)) resonance-ripple-lifetime)))))
  )
)

(fn-expr + resonance-orbit Point
  (param angle Radians)
  (param radius Float)
  (+ resonance-center (* (call Point (call cos angle) (call sin angle)) radius))
)

(fn-expr + resonance-fade Float
  (param now Seconds)
  (param since (? Seconds))
  (param length Seconds)
  (match since
    (case= null
      0.0
    )
    (default
      (call clamp-unit (- 1 (as (/ (- now since) length) Float)))
    )
  )
)

(fn-expr _ pan-of Float
  (param point Point)
  (call clamp (/ (- (. point x) (. resonance-center x)) pan-width) -1.0 1.0)
)

(fn-expr _ frame-steps (list Float)
  (param elapsed Seconds)
  (call (of List Float) (in (/ dt count) (..< 0 count)))
  (where
    (lazy dt (as (call min elapsed longest-frame) Float))
    (lazy count (call max 1 (as (call ceil (* dt substeps-per-second)) Int)))
  )
)
