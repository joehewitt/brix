(import ./resonance-art)
(import ./resonance-game)
(import ./resonance-sound)
(import ./resonance-theme)
(import ./resonance-title)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /time/duration)

(type + ResonancePanel (is Box)
  (using ResonanceTheme)
  (event + pauses Bool)
  (event + interruptions Bool)
  (event + restarts Bool)
  (prop + game _ (= (call ResonanceGame)))
  (prop + sound (? ResonanceSound))
  (prop _ owner-window (of Ancestor Window))
  (prop _ is-window-active _ (= (?? (?. #owner-window #is-active) false)))
  (prop _ sound-hint _
    (=
      (block
        (case? (?? (?. #sound #is-unavailable) false)
          "Sound unavailable"
        )
        (case? (?? (?. #sound #is-muted) false)
          "M  Sound off"
        )
        (default
          "M  Sound on"
        )
      )
    )
  )
  (prop + phase _
    (machine
      (state running
        (then running (trigger on restarts)
          (do
            (call (. game reset))
            (call (. heading clear))
            (call (?. sound hush))
          )
        )
        (blank)
        (state playing
          (finally
            (call (. game cancel))
          )
          (blank)
          (for (on tick frames)
            (call (. game play) (. tick delta))
          )
          (for (on event pointer-move)
            (call (. game aim) (call (. board stage-point) (. event point)))
          )
          (for (on event pointer-drag)
            (call (. game aim) (call (. board stage-point) (. event point)))
          )
          (for (on event pointer-down)
            (if (== (. event button) (. PointerButton primary))
              (call (. game grab) (call (. board stage-point) (. event point)))
              (call (. event cancel))
            )
          )
          (for (on event pointer-up)
            (if (== (. event button) (. PointerButton primary))
              (if (. event is-interrupted)
                (call (. game cancel))
                (else
                  (call (. game release))
                )
              )
              (call (. event cancel))
            )
          )
          (blank)
          (then blooming (trigger on (. game blooms)))
          (then paused (trigger on pauses))
          (then paused (trigger on interruptions))
        )
        (blank)
        (state blooming
          (for (on tick frames)
            (call (. game resonate) (. tick delta))
          )
          (blank)
          (then playing (trigger on frames (>= (. game bloom-progress) 1))
            (do
              (call (. game advance-phrase))
            )
          )
        )
        (blank)
        (state paused
          (do
            (call (?. sound hush))
          )
          (blank)
          (then playing (trigger on pauses))
        )
      )
    )
  )
  (content
    (<> This (• resonance-panel)
      (<> ResonanceBoard (id: board) (• resonance-board)
        (= game game)
      )
      (<> ResonanceTitle (id: heading) (• resonance-title)
        (= clock (. #game #clock))
        (<> Label (text: "RESONANCE"))
      )
      (<> Box (• resonance-help)
        (<> Label (text: "Drag a strand · release to pluck") (• resonance-caption))
        (<> Label (text: "Space  Pulse · R  Restart · Esc  Pause") (• resonance-caption))
        (<> Label (• resonance-caption)
          (= text #sound-hint)
        )
      )
      (if (is #phase .paused)
        (<> Label (text: "Paused") (• resonance-banner))
      )
      (blank)
      (<> KeyShortcut (text: "Pulse")
        (= key .space)
        (= repeat false)
        (= enabled (is #phase .playing))
        (= action (=> () :do (call (. game pulse))))
      )
      (<> KeyShortcut (text: "Pause")
        (= key .escape)
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key (char "p"))
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Restart")
        (= key (char "r"))
        (= repeat false)
        (= action (=> () :do (<- restarts true)))
      )
      (<> KeyShortcut (text: "Sound")
        (= key (char "m"))
        (= repeat false)
        (= action (=> () :do (call (?. sound toggle))))
      )
    )
  )
  (whenever-rule #is-window-active
    (if (not is-window-active)
      (<- interruptions true)
    )
  )
  (subscribe-for (on note (. game notes))
    (call (?. sound play) note)
    (call (. heading strike) note)
  )
)

(type + ResonanceBoard (is Box)
  (prop + game ResonanceGame)
  (prop _ clock _ (= (. #game #clock)))
  (depends invalidate-paint clock)
  (fn-expr + stage-point Point
    (param point Point)
    (/ (- point (. stage-rect top-left)) (/ (. stage-rect width) (. resonance-stage-size width)))
    (where
      (lazy stage-rect stage)
    )
  )
  (fn-expr _ stage Rect :get
    (call image-fit-rect resonance-stage-size content-bounds (. ImageFit contain) center center)
    (where
      (lazy center (. AnchorPoint center))
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect stage)
    (return-if (if (<= (. stage-rect width) 0)))
    (let scale (/ (. stage-rect width) (. resonance-stage-size width)))
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. stage-rect x) (. stage-rect y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (call paint-resonance-stage canvas game)
    )
  )
)
