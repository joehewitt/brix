(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop + jelly-node-count _ (= 9))
(prop _ grid-columns _ (= 3))
(prop _ node-pull _ (= 24.0))
(prop _ node-damping _ (= 2.3))
(prop _ edge-stiffness _ (= 120.0))
(prop _ shear-stiffness _ (= 90.0))
(prop _ spring-damping _ (= 1.2))
(prop _ area-relaxation _ (= 0.4))
(prop _ relaxation-passes _ (= 3))
(prop _ node-speed-limit _ (= (call Point 400 400)))

(type _ JellyNode
  (prop + place _ (= (call Point 0 0)))
  (prop + previous _ (= (call Point 0 0)))
  (prop + velocity _ (= (call Point 0 0)))
  (prop + force _ (= (call Point 0 0)))
)

(type + JellySupport (is Tuple)
  (prop + left Point)
  (prop + middle Point)
  (prop + right Point)
  (fn-expr + height-at (? Float)
    (param x Float)
    (only-if (+ (. a y) (* (- (. b y) (. a y)) t)) (if (and (>= x (. left x)) (<= x (. right x)))))
    (where
      (lazy a (if-expr (<= x (. middle x)) left middle))
      (lazy b (if-expr (<= x (. middle x)) middle right))
      (lazy t (call clamp (/ (- x (. a x)) (call max 0.001 (- (. b x) (. a x)))) 0.0 1.0))
    )
  )
)

(type + JellyBody
  (prop _ nodes _ (= (call (of List JellyNode) (in (call JellyNode) (..< 0 jelly-node-count)))))
  (fn-expr + offset Point
    (param index Int)
    (. ([] nodes index) place)
  )
  (fn-do + impact _
    (param strength Float)
    (param side Float)
    (for (in index (..< 0 jelly-node-count))
      (let weight (- 1 (* (call row-of index) 0.4)))
      (let lateral (as (- (call column-of index) 1) Float))
      (let push-x (* strength (+ (* lateral 0.35) (* side weight 0.35))))
      (let push-y (* strength weight (+ 1 (* side lateral 0.35))))
      (+= (. ([] nodes index) velocity) (call Point push-x push-y))
    )
  )
  (fn-do + land _
    (param strength Float)
    (param left Float)
    (param right Float)
    (call impact strength (call clamp (- (- left) right) -1.0 1.0))
  )
  (fn-do + sway _
    (param acceleration Float)
    (param dt Float)
    (for (in index (..< 0 jelly-node-count))
      (let weight (- 1 (* (call row-of index) 0.3)))
      (-= (. ([] nodes index) velocity) (call Point (* acceleration dt weight 0.22) 0))
    )
  )
  (fn-do + advance _
    (param dt Float)
    (param size Dimensions)
    (param support (? JellySupport))
    (param floor (? Float))
    (return-if (if (<= dt 0)))
    (for (in node nodes)
      (= (. node previous) (. node place))
      (= (. node force) (- (* (. node place) (- node-pull)) (* (. node velocity) node-damping)))
    )
    (call pull-springs size)
    (for (in node nodes)
      (+= (. node velocity) (* (. node force) dt))
      (+= (. node place) (* (. node velocity) dt))
    )
    (for (in _ (..< 0 relaxation-passes))
      (for (in corner (list 0 1 3 4))
        (call preserve-area corner size)
      )
      (call constrain size support floor)
    )
    (let reach (call Point (* (. size width) 0.2) (* (. size height) 0.35)))
    (for (in node nodes)
      (= (. node place) (call clamp-point (. node place) reach))
    )
    (call constrain size support floor)
    (for (in node nodes)
      (= (. node velocity) (call clamp-point (/ (- (. node place) (. node previous)) dt) node-speed-limit))
    )
  )
  (fn-do + constrain _
    (param size Dimensions)
    (param support (? JellySupport))
    (param floor (? Float))
    (if support
      (for (in segment (..< 0 2))
        (call rest-on support ([] nodes (+ 6 segment)) ([] nodes (+ 7 segment)) segment size)
      )
    )
    (if floor
      (for (in index (..< 0 jelly-node-count))
        (let node ([] nodes index))
        (let lowest (- floor (/ (* (- (call row-of index) 1) (. size height)) 2)))
        (= (. node place) (call Point (. node place x) (call min (. node place y) lowest)))
      )
    )
  )
  (fn-do _ rest-on _
    (param support JellySupport)
    (param a JellyNode)
    (param b JellyNode)
    (param segment Int)
    (param size Dimensions)
    (for (in sample (..< 0 5))
      (let t (/ sample 4.0))
      (let weight (- 1 t))
      (let x (+ (/ (* (+ (- segment 1) t) (. size width)) 2) (* (. a place x) weight) (* (. b place x) t)))
      (let limit (call (. support height-at) x))
      (if limit
        (let y (+ (/ (. size height) 2) (* (. a place y) weight) (* (. b place y) t)))
        (let correction (/ (call max 0.0 (- y limit)) (+ (* weight weight) (* t t))))
        (-= (. a place) (call Point 0 (* correction weight)))
        (-= (. b place) (call Point 0 (* correction t)))
      )
    )
  )
  (fn-do _ pull-springs _
    (param size Dimensions)
    (let across (call Point (/ (. size width) 2) 0))
    (let down (call Point 0 (/ (. size height) 2)))
    (for (in index (..< 0 jelly-node-count))
      (let has-right (< (call column-of index) 2))
      (let has-below (< (call row-of index) 2))
      (if has-right
        (call spring index (+ index 1) across edge-stiffness)
      )
      (if has-below
        (call spring index (+ index 3) down edge-stiffness)
      )
      (if (and has-right has-below)
        (call spring index (+ index 4) (+ across down) shear-stiffness)
        (call spring (+ index 1) (+ index 3) (- down across) shear-stiffness)
      )
    )
  )
  (fn-do _ spring _
    (param from Int)
    (param to Int)
    (param rest Point)
    (param stiffness Float)
    (let a ([] nodes from))
    (let b ([] nodes to))
    (let delta (- (+ rest (. b place)) (. a place)))
    (let length (call max 0.001 (. delta length)))
    (let closing (/ (call (. (- (. b velocity) (. a velocity)) dot) delta) length))
    (let strength (+ (* (- length (. rest length)) stiffness) (* closing spring-damping)))
    (let force (* delta (/ strength length)))
    (+= (. a force) force)
    (-= (. b force) force)
  )
  (fn-do _ preserve-area _
    (param corner Int)
    (param size Dimensions)
    (let indices (list corner (+ corner 1) (+ corner 4) (+ corner 3)))
    (let points (call (of List Point) (in (call grid-point each size) indices)))
    (let area Float)
    (let denominator Float)
    (let gradients (call (of List Point)))
    (for (in index (..< 0 4))
      (let point ([] points index))
      (let next ([] points (% (+ index 1) 4)))
      (let previous ([] points (% (+ index 3) 4)))
      (let gradient (/ (call Point (- (. next y) (. previous y)) (- (. previous x) (. next x))) 2))
      (+= area (/ (call (. point cross) next) 2))
      (+= denominator (call (. gradient dot) gradient))
      (+= gradients gradient)
    )
    (let rest-area (/ (* (. size width) (. size height)) 4))
    (let correction (/ (* (- rest-area area) area-relaxation) (call max 1.0 denominator)))
    (for (in index (..< 0 4))
      (+= (. ([] nodes ([] indices index)) place) (* ([] gradients index) correction))
    )
  )
  (fn-expr _ grid-point Point
    (param index Int)
    (param size Dimensions)
    (+ rest (. ([] nodes index) place))
    (where
      (lazy rest (call Point (/ (* (call column-of index) (. size width)) 2) (/ (* (call row-of index) (. size height)) 2)))
    )
  )
)

(fn-expr + row-of Int
  (param index Int)
  (/ index grid-columns)
)

(fn-expr + column-of Int
  (param index Int)
  (% index grid-columns)
)

(fn-expr _ clamp-point Point
  (param point Point)
  (param limit Point)
  (call Point (call clamp (. point x) (- (. limit x)) (. limit x)) (call clamp (. point y) (- (. limit y)) (. limit y)))
)
