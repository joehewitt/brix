(import ./jelly-body)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /time/duration)
(blank)
(prop + jelly-stage-size _ (= (call Dimensions 568 526)))
(prop + jelly-floor-y _ (= 478.0))
(prop + jelly-flavors _ (= 6))
(prop _ stage-middle _ (= (/ (. jelly-stage-size width) 2)))
(prop _ sway-reach _ (= 185.0))
(prop _ start-travel _ (= -1.35))
(prop _ hover-top _ (= 116.0))
(prop _ hover-gap _ (= 95.0))
(prop _ hover-bob _ (= 4.0))
(prop _ camera-line _ (= 234.0))
(prop _ camera-ease _ (= 5.0))
(prop _ drop-speed _ (= 80.0))
(prop _ drop-gravity _ (= 1600.0))
(prop _ debris-gravity _ (= 1250.0))
(prop _ spark-gravity _ (= 480.0))
(prop _ perfect-margin _ (= 12.0))
(prop _ least-overlap _ (= 12.0))
(prop _ longest-frame Seconds (= 50ms))
(prop _ substeps-per-second _ (= 120.0))

(type + JellyLanding (is Union)
  (variant stacked)
  (variant leaning)
  (variant missed)
)

(type + Jelly
  (prop + place Point)
  (prop + size Dimensions)
  (prop + flavor Int)
  (prop + velocity _ (= (call Point 0 0)))
  (prop + angle Radians)
  (prop + spin Float)
  (prop + is-resting _ (= false))
  (prop + body _ (= (call JellyBody)))
  (fn-do + This _
    (param place _)
    (param size _)
    (param flavor _)
  )
  (fn-expr + left Float :get
    (- (. place x) (/ (. size width) 2))
  )
  (fn-expr + right Float :get
    (+ (. place x) (/ (. size width) 2))
  )
  (fn-expr + top Float :get
    (- (. place y) (/ (. size height) 2))
  )
  (fn-expr + bottom Float :get
    (+ (. place y) (/ (. size height) 2))
  )
  (fn-expr + is-falling Bool :get
    (> (. velocity y) 0)
  )
  (fn-expr + shape-point Point
    (param index Int)
    (+ rest (call (. body offset) index))
    (where
      (lazy column (- (call column-of index) 1))
      (lazy row (- (call row-of index) 1))
      (lazy rest (call Point (/ (* column (. size width)) 2) (/ (* row (. size height)) 2)))
    )
  )
  (fn-expr + contains Bool
    (param point Point)
    (and (< (call abs (. offset x)) (/ (. size width) 2)) (< (call abs (. offset y)) (/ (. size height) 2)))
    (where
      (lazy offset (- point place))
    )
  )
  (fn-expr + side-of Float
    (param point Point)
    (call clamp (/ (- (. point x) (. place x)) (/ (. size width) 2)) -1.0 1.0)
  )
)

(type + JellySpark
  (prop + place Point)
  (prop + velocity Point)
  (prop + turn Radians)
  (prop + size Float)
  (prop + flavor Int)
  (prop + born Seconds)
  (prop + lifetime Seconds)
  (fn-do + This _
    (param place _)
    (param velocity _)
    (param turn _)
    (param size _)
    (param flavor _)
    (param born _)
    (param lifetime _)
  )
)

(type + JellyGame
  (event + landings JellyLanding)
  (event + jolts Length)
  (prop + blocks _ (= (call (of List Jelly))))
  (prop + sparks _ (= (call (of List JellySpark))))
  (prop + current (? Jelly))
  (prop + clock Seconds)
  (prop + camera Float)
  (prop + score Int)
  (prop + best Int)
  (prop + risk Float)
  (prop + is-toppled Bool)
  (blank)
  (prop _ combo Int)
  (prop _ travel Float)
  (prop _ lean Int)
  (fn-do + This _
    (call reset)
  )
  (fn-expr + surface Float :get
    (if-expr (== (. blocks length) 0) jelly-floor-y (. blocks tail top))
  )
  (fn-expr + target-x Float :get
    (if-expr (== (. blocks length) 0) stage-middle (. blocks tail place x))
  )
  (fn-do + reset _
    (call (. blocks clear))
    (call (. sparks clear))
    (= camera 0)
    (= score 0)
    (= combo 0)
    (= risk 0)
    (= lean 0)
    (= is-toppled false)
    (= travel start-travel)
    (call spawn)
  )
  (fn-do + spawn _
    (let count (. blocks length))
    (let width (call max 104.0 (+ (- 170.0 (* count 1.7)) (call random -21.0 21.0))))
    (let size (call Dimensions width (call random 54.0 69.0)))
    (let place (call Point (+ stage-middle (* (call sin travel) sway-reach)) (call hover-y size)))
    (= current (call Jelly place size (% count jelly-flavors)))
  )
  (fn-do + aim _
    (param elapsed Seconds)
    (let block current)
    (return-if (if (not block)))
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
      (call sway block dt)
    )
    (call expire)
  )
  (fn-do + drop _
    (let block current)
    (return-if (if (not block)))
    (= (. block velocity) (call Point 0 drop-speed))
    (call (. block body impact) -65 0)
  )
  (fn-do + fall _
    (param elapsed Seconds)
    (let block current)
    (return-if (if (not block)))
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
      (+= (. block velocity) (call Point 0 (* drop-gravity dt)))
      (+= (. block place) (* (. block velocity) dt))
      (if (>= (. block bottom) surface)
        (call expire)
        (call land block)
        (return)
      )
      (call rest-on-floor block)
    )
    (call expire)
  )
  (fn-do + settle _
    (param elapsed Seconds)
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
    )
    (call expire)
  )
  (fn-do + topple _
    (let block current)
    (if block
      (+= blocks block)
      (= current null)
    )
    (let side (if-expr (< lean 0) -1.0 1.0))
    (= is-toppled true)
    (= risk 1)
    (= combo 0)
    (<- jolts 7)
    (for (in index (..< 0 (. blocks length)))
      (let item ([] blocks index))
      (let push (+ (* side (+ 80 (* index 22))) (call random -40.0 40.0)))
      (= (. item velocity) (call Point push (call random -260.0 -90.0)))
      (= (. item spin) (* side (call random 0.6 3.1)))
      (call (. item body impact) 80 side)
    )
    (let top (. blocks tail))
    (call burst (call Point (. top place x) (. top bottom)) (. top flavor) true)
  )
  (fn-do + collapse _
    (param elapsed Seconds)
    (for (in dt (call frame-steps elapsed))
      (call tick dt)
      (for (in block blocks)
        (call tumble block dt)
      )
    )
    (call expire)
  )
  (fn-do + poke _
    (param point Point)
    (for (in block blocks)
      (if (call (. block contains) point)
        (call (. block body impact) 105 (call (. block side-of) point))
        (return)
      )
    )
    (let block current)
    (if block
      (if (call (. block contains) point)
        (call (. block body impact) 95 (call (. block side-of) point))
      )
    )
  )
  (fn-expr _ hover-y Float
    (param size Dimensions)
    (call min (- hover-top camera) (- surface hover-gap (/ (. size height) 2)))
  )
  (fn-do _ tick _
    (param dt Float)
    (+= clock dt)
    (for (in index (..< 0 (. blocks length)))
      (let block ([] blocks index))
      (call jiggle block dt (call support-under index block))
    )
    (let block current)
    (if block
      (call jiggle block dt null)
    )
    (for (in spark sparks)
      (+= (. spark velocity) (call Point 0 (* spark-gravity dt)))
      (+= (. spark place) (* (. spark velocity) dt))
      (+= (. spark turn) (* dt 4))
    )
    (if (not is-toppled)
      (let wanted (call max 0.0 (- camera-line surface)))
      (+= camera (* (- wanted camera) (call min 1.0 (* dt camera-ease))))
    )
  )
  (fn-do _ sway _
    (param block Jelly)
    (param dt Float)
    (let rate (call min 2.9 (+ 1.12 (* (. blocks length) 0.065))))
    (+= travel (* dt rate))
    (call (. block body sway) (* (- sway-reach) (call sin travel) rate rate) dt)
    (let bob (* (call sin (* (as clock Float) 3)) hover-bob))
    (= (. block place) (call Point (+ stage-middle (* (call sin travel) sway-reach)) (+ (call hover-y (. block size)) bob)))
    (call rest-on-floor block)
  )
  (fn-do _ jiggle _
    (param block Jelly)
    (param dt Float)
    (param support (? JellySupport))
    (let is-settled (and (. block is-resting) (not is-toppled)))
    (let floor (- jelly-floor-y (. block place y)))
    (call (. block body advance) dt (. block size) (only-if support (if is-settled)) (only-if floor (if is-settled)))
  )
  (fn-do _ rest-on-floor _
    (param block Jelly)
    (call (. block body constrain) (. block size) null (- jelly-floor-y (. block place y)))
  )
  (fn-do _ land _
    (param block Jelly)
    (let index (. blocks length))
    (let low (call max (call ledge-left index) (. block left)))
    (let high (call min (call ledge-right index) (. block right)))
    (if (< (- high low) least-overlap)
      (= lean (if-expr (< (. block place x) target-x) -1 1))
      (<- landings .missed)
      (return)
    )
    (let offset (- (. block place x) target-x))
    (let is-perfect (<= (call abs offset) perfect-margin))
    (let x (if-expr is-perfect target-x (. block place x)))
    (= (. block place) (call Point x (- surface (/ (. block size height) 2))))
    (let impact (call clamp (* (. block velocity y) 0.17) 105.0 175.0))
    (= (. block velocity) (call Point 0 0))
    (= (. block is-resting) true)
    (let half (/ (. block size width) 2))
    (call (. block body land) impact (/ (- low x) half) (/ (- high x) half))
    (call (. block body constrain) (. block size) (call support-under index block) (- jelly-floor-y (. block place y)))
    (+= blocks block)
    (= current null)
    (for (in below (..< 0 index))
      (let strength (/ 1.0 (- (+ index 1) below)))
      (call (. ([] blocks below) body impact) (* impact strength 0.85) (call clamp (/ offset 65) -1.0 1.0))
    )
    (= lean (call balance-direction))
    (if (!= lean 0)
      (<- landings .leaning)
      (return)
    )
    (= combo (if-expr is-perfect (+ combo 1) 0))
    (+= score (+ 10 (* combo 5)))
    (= best (call max best score))
    (<- jolts (if-expr is-perfect 2.8 1.8))
    (call burst (call Point x (. block bottom)) (. block flavor) is-perfect)
    (<- landings .stacked)
  )
  (fn-do _ balance-direction Int
    (let mass Float)
    (let moment Float)
    (= risk 0)
    (for (in index (.. (- (. blocks length) 1) 0))
      (let block ([] blocks index))
      (let weight (* (. block size width) (. block size height)))
      (+= mass weight)
      (+= moment (* (. block place x) weight))
      (let low (call max (call ledge-left index) (. block left)))
      (let high (call min (call ledge-right index) (. block right)))
      (let half (call max 1.0 (- (/ (- high low) 2) 3)))
      (let displacement (/ (- (/ moment mass) (/ (+ low high) 2)) half))
      (= risk (call max risk (call abs displacement)))
      (return-if (if-expr (< displacement 0) -1 1) (if (>= (call abs displacement) 1)))
    )
    (return 0)
  )
  (fn-expr _ ledge-left Float
    (param index Int)
    (if-expr (== index 0) 0.0 (. ([] blocks (- index 1)) left))
  )
  (fn-expr _ ledge-right Float
    (param index Int)
    (if-expr (== index 0) (. jelly-stage-size width) (. ([] blocks (- index 1)) right))
  )
  (fn-expr _ support-under (? JellySupport)
    (param index Int)
    (param block Jelly)
    (only-if (call support-for block ([] blocks (- index 1))) (if (> index 0)))
  )
  (fn-expr _ support-for JellySupport
    (param block Jelly)
    (param below Jelly)
    (call JellySupport (+ ledge (call Point (- half) 0) a) (+ ledge b) (+ ledge (call Point half 0) c))
    (where
      (lazy ledge (call Point (- (. below place x) (. block place x)) (- (. below top) (. block place y))))
      (lazy half (/ (. below size width) 2))
      (lazy a (call (. below body offset) 0))
      (lazy b (call (. below body offset) 1))
      (lazy c (call (. below body offset) 2))
    )
  )
  (fn-do _ tumble _
    (param block Jelly)
    (param dt Float)
    (+= (. block velocity) (call Point 0 (* debris-gravity dt)))
    (+= (. block place) (* (. block velocity) dt))
    (+= (. block angle) (* (. block spin) dt))
    (let sink (- (call lowest-point block) jelly-floor-y))
    (return-if (if (<= sink 0)))
    (-= (. block place) (call Point 0 sink))
    (if (> (. block velocity y) 80)
      (call (. block body impact) (call min 100.0 (* (. block velocity y) 0.12)) 0)
    )
    (= (. block velocity) (call Point (* (. block velocity x) 0.85) (* (- (call max 0.0 (. block velocity y))) 0.22)))
    (*= (. block spin) 0.7)
  )
  (fn-do _ expire _
    (= sparks (call (of List JellySpark) (in each sparks (when (< (- clock (. each born)) (. each lifetime))))))
  )
  (fn-do _ burst _
    (param origin Point)
    (param flavor Int)
    (param is-perfect Bool)
    (for (in index (..< 0 (if-expr is-perfect 32 18)))
      (let angle (call random (- π) 0rad))
      (let speed (call random 60.0 280.0))
      (let velocity (- (* (call Point (call cos angle) (call sin angle)) speed) (call Point 0 70)))
      (+= sparks
        (call JellySpark
          (block
            (arg (+ origin (call Point (call random -40.0 40.0) 0)))
            (arg velocity)
            (arg (call random 0rad π))
            (arg (call random 2.0 7.0))
            (arg (if-expr is-perfect (% index jelly-flavors) flavor))
            (arg clock)
            (arg (call random 500ms 1100ms))
          )
        )
      )
    )
  )
)

(fn-do _ lowest-point Float
  (param block Jelly)
  (let bottom (. block place y))
  (for (in index (..< 0 jelly-node-count))
    (let point (call (. (call (. block shape-point) index) rotate) (. block angle)))
    (= bottom (call max bottom (+ (. block place y) (. point y))))
  )
  (return bottom)
)

(fn-expr _ frame-steps (list Float)
  (param elapsed Seconds)
  (call (of List Float) (in (/ dt count) (..< 0 count)))
  (where
    (lazy dt (as (call min elapsed longest-frame) Float))
    (lazy count (call max 1 (as (call ceil (* dt substeps-per-second)) Int)))
  )
)
