(import ./prism-art)
(import ./prism-game)
(import ./prism-theme)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ clear-pause Seconds (= 1100ms))

(type + PrismPanel (is Box)
  (using PrismTheme)
  (event + activations Bool)
  (event + pauses Bool)
  (event + interruptions Bool)
  (event + restarts Bool)
  (prop + game _ (= (call PrismGame)))
  (prop _ owner-window (of Ancestor Window))
  (prop _ is-window-active _ (= (?? (?. #owner-window #is-active) false)))
  (prop _ steering-left _ (= false))
  (prop _ steering-right _ (= false))
  (prop _ action-hint _
    (=
      (block
        (case? (is #phase .ready)
          "Click or Space  Launch"
        )
        (case? (is #phase .paused)
          "Click or Space  Resume"
        )
        (case? (is #phase .over)
          "Click or Space  Play again"
        )
        (default
          ""
        )
      )
    )
  )
  (prop + phase _
    (machine
      (state running
        (call (. game reset))
        (blank)
        (then running (trigger on restarts))
        (blank)
        (state ready
          (for (on tick frames)
            (call (. game hold) (. tick delta))
          )
          (blank)
          (then playing (trigger on activations)
            (call (. game launch))
          )
        )
        (blank)
        (state playing
          (for (on tick frames)
            (call (. game play) (. tick delta))
          )
          (blank)
          (then clearing (trigger for .cleared (. game endings))
            (call (. game advance-level))
          )
          (then ready (trigger for .missed (. game endings))
            (call (. game serve))
          )
          (then over (trigger for .lost (. game endings)))
          (then paused (trigger on pauses))
          (then paused (trigger on interruptions))
        )
        (blank)
        (state paused
          (then playing (trigger on pauses))
          (then playing (trigger on activations))
        )
        (blank)
        (state clearing
          (for (on tick frames)
            (call (. game hold) (. tick delta))
          )
          (blank)
          (then ready (trigger on (call Timer clear-pause)))
        )
        (blank)
        (state over
          (for (on tick frames)
            (call (. game drift) (. tick delta))
          )
          (blank)
          (then running (trigger on activations))
        )
      )
    )
  )
  (content
    (<> This (• prism-panel)
      (<> Box (• prism-header)
        (<> Box (• prism-side))
        (<> Label (text: "PRISM BREAK") (• prism-title))
        (<> Box (• prism-side)
          (<> Label (• prism-score)
            (= text (call score-text (call animated (. #game #score) $gui-motion-smooth)))
          )
          (<> Label (• prism-caption)
            (= text (str "BEST " (. #game #best)))
          )
        )
      )
      (blank)
      (<> PrismBoard (id: board) (• prism-board)
        (= game game)
        (= is-aiming (is #phase .ready))
        (= is-dimmed (or (is #phase .paused) (is #phase .clearing) (is #phase .over)))
      )
      (blank)
      (<> Box (• prism-footer)
        (<> Box (• prism-lives)
          (for (in index (..< 0 prism-lives))
            (<> Label (text: "▲") (• prism-life)
              (= color (if-expr (< index (. #game #lives)) prism-cyan prism-dim))
            )
          )
        )
        (<> Box (• flex 1))
        (<> Box (• prism-help)
          (<> Label (• prism-caption)
            (= text #action-hint)
          )
          (<> Label (text: "Mouse or ← →  Move") (• prism-caption))
          (<> Label (text: "P or Esc  Pause") (• prism-caption))
          (<> Label (text: "R  Restart") (• prism-caption))
        )
      )
      (blank)
      (if (is #phase .paused)
        (<> PrismBanner (text: "Paused"))
      )
      (if (is #phase .clearing)
        (<> PrismBanner (text: "Clear")
          (= detail (str "Level " (. game level)))
        )
      )
      (if (is #phase .over)
        (<> PrismBanner (text: "Game over")
          (= detail (str (. game score)))
        )
      )
      (blank)
      (<> KeyShortcut (text: "Launch")
        (= key .space)
        (= repeat false)
        (= action (=> () :do (<- activations true)))
      )
      (<> KeyShortcut (text: "Launch")
        (= key .enter)
        (= repeat false)
        (= action (=> () :do (<- activations true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key .escape)
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key 'p')
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Restart")
        (= key 'r')
        (= repeat false)
        (= action (=> () :do (<- restarts true)))
      )
    )
  )
  (whenever-rule #is-window-active
    (if (not is-window-active)
      (call interrupt)
    )
  )
  (subscribe-for (on jolt (. game jolts))
    (call (. board play) (shape $shake jolt))
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (<- activations true)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event key-press)
    (if (call steer (. event key) (. event characters) true)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event key-release)
    (if (call steer (. event key) (. event characters) false)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event blur)
    (call interrupt)
  )
  (fn-do _ steer Bool
    (param key Key)
    (param characters String)
    (param held Bool)
    (let side (call steering-side key (. characters lowercased)))
    (return-if false (if (== side 0)))
    (if (< side 0)
      (= steering-left held)
      (else
        (= steering-right held)
      )
    )
    (= (. game steer) (- (if-expr steering-right 1 0) (if-expr steering-left 1 0)))
    (return true)
  )
  (fn-do _ interrupt _
    (= steering-left false)
    (= steering-right false)
    (= (. game steer) 0)
    (<- interruptions true)
  )
)

(type + PrismBoard (is Box)
  (prop + game PrismGame)
  (prop + is-aiming _ (= false))
  (prop + is-dimmed _ (= false))
  (prop _ clock _ (= (. #game #clock)))
  (depends invalidate-paint clock is-aiming)
  (subscribe-for (on event pointer-move)
    (call aim (. event point))
  )
  (subscribe-for (on event pointer-drag)
    (call aim (. event point))
  )
  (fn-do _ aim _
    (param point Point)
    (let stage-point (- (+ point (. bounds top-left)) (. stage top-left)))
    (call (. game aim) (/ (. stage-point x) scale))
  )
  (fn-expr _ stage Rect :get
    (call image-fit-rect prism-board-size content-bounds (. ImageFit contain) center center)
    (where
      (lazy center (. AnchorPoint center))
    )
  )
  (fn-expr _ scale Float :get
    (/ (. stage width) (. prism-board-size width))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect stage)
    (return-if (if (<= (. stage-rect width) 0)))
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. stage-rect x) (. stage-rect y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (call paint-prism-board canvas game is-aiming)
    )
  )
)

(type + PrismBanner (is Box)
  (using PrismTheme)
  (prop + title String)
  (prop + detail _ (= ""))
  (fn-do + This _
    (param title _)
  )
  (content
    (<> This (• prism-banner)
      (<> Label (• prism-banner-title)
        (= text #title)
      )
      (if #detail
        (<> Label (• prism-banner-detail)
          (= text #detail)
        )
      )
    )
  )
)

(fn-expr _ score-text String
  (param value Float)
  (str (as (call round value) Int))
)

(fn-expr _ steering-side Int
  (param key Key)
  (param letter String)
  (case? (or (== key (. Key arrow-left)) (== letter "a"))
    -1
  )
  (case? (or (== key (. Key arrow-right)) (== letter "d"))
    1
  )
  (default
    0
  )
)
