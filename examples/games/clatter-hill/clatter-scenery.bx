(import ./clatter-brush)
(import ./clatter-run)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ tree-x _ (= 712.0))
(prop _ day-top RGBA (= "#84cbee"))
(prop _ day-low RGBA (= "#e6f5ef"))
(prop _ night-top RGBA (= "#0a1330"))
(prop _ night-low RGBA (= "#2c396b"))
(prop _ sun RGBA (= "#ffd862"))
(prop _ moon RGBA (= "#f2edd5"))
(prop _ far-hill RGBA (= "#b0d6b6"))
(prop _ near-hill RGBA (= "#9ccb98"))
(prop _ root RGBA (= "#6c4630"))
(prop _ cloud RGBA (= "#ffffff"))
(prop _ cloud-shade RGBA (= "#d3e3ef"))
(prop _ puffs (list Point) (= (list (call Point -46 8) (call Point -20 -6) (call Point 12 -12) (call Point 42 -2) (call Point 64 9))))
(prop _ puff-sizes (list Float) (= (list 19.0 27.0 31.0 24.0 16.0)))
(prop _ peg RGBA (= "#ebca93"))
(prop _ worm RGBA (= "#e8a096"))
(prop _ bone RGBA (= "#f0e7d2"))
(prop _ shell RGBA (= "#dcbd8f"))
(prop _ mud RGBA (= "#5c402c"))
(prop _ reed RGBA (= "#73a04d"))
(prop _ cattail RGBA (= "#7b5031"))
(prop _ daisy RGBA (= "#ffffff"))
(prop _ buttercup RGBA (= "#f7d040"))
(prop _ apple RGBA (= "#e24b3b"))
(prop _ pebble RGBA (= "#9a8f86"))
(prop _ soils (list RGBA) (= (list "#8d603f" "#9e6e49" "#b38255" "#aa9074")))
(prop _ soil-tops (list Float) (= (list 0.0 330.0 470.0 612.0)))
(prop _ stone-tones (list RGBA) (= (list "#c2b199" "#b1a28c" "#cdc1ab")))
(prop _ sun-point _ (= (call Point 905 72)))
(prop _ golden _ (= 0.618034))

(fn-do + paint-clatter-sky _
  (param canvas Canvas)
  (param night Float)
  (call paint-sky (call HillBrush canvas night))
)

(fn-do + paint-clatter-weather _
  (param canvas Canvas)
  (param clock Float)
  (param night Float)
  (let b (call HillBrush canvas night))
  (if (> night 0.5)
    (call paint-stars b clock)
  )
  (call paint-clouds b clock)
)

(fn-do + paint-clatter-scenery _
  (param canvas Canvas)
  (param night Float)
  (let b (call HillBrush canvas night))
  (call paint-far-hills b)
  (call paint-tree b)
  (call paint-ground b)
  (call paint-finds b)
  (call paint-roots b)
  (call paint-crest b)
  (call paint-stones b)
  (call paint-pegs b)
  (call paint-turf b)
  (call paint-tower b)
  (call paint-pot b)
  (call paint-crate-back b)
  (call paint-stream-bed b)
)

(fn-expr _ crest-y Float
  (param x Float)
  (- 198 (* 48 (call exp (- (* hump hump)))) (* 5 (call sin (* x 0.021))))
  (where
    (lazy hump (/ (- x 640) 380))
  )
)

(fn-do _ paint-sky _
  (param b HillBrush)
  (let night (. b night))
  (let top (call (. (call (. night-top with-alpha) night) over) day-top))
  (let low (call (. (call (. night-low with-alpha) night) over) day-low))
  (call (. b canvas fill-gradient) (call Rect clatter-stage-size) (call linear-gradient (call Point 0 0) (call Point 0 230) top low))
  (if (> night 0.5)
    (call (. b glow) moon 0.05)
    (call (. b dot) sun-point 74)
    (call (. b glow) moon 0.09)
    (call (. b dot) sun-point 46)
    (call (. b glow) (call shade moon) 1)
    (call (. b dot) sun-point 27)
    (call (. b glow) moon 1)
    (call (. b dot) (+ sun-point (* hill-light 3.5)) 23.5)
    (call (. b glow) (call shade moon) 0.35)
    (call (. b shape) (call blob (+ sun-point (call Point 7 5)) 6 5 1 0.15))
    (call (. b shape) (call blob (+ sun-point (call Point -9 -6)) 4 3.5 2 0.15))
    (call (. b shape) (call blob (+ sun-point (call Point -2 11)) 3 2.5 3 0.15))
    (else
      (call (. b glow) sun 0.12)
      (call (. b dot) sun-point 82)
      (call (. b glow) sun 0.2)
      (call (. b dot) sun-point 56)
      (call (. b glow) (call shade sun) 1)
      (call (. b dot) sun-point 31)
      (call (. b glow) sun 1)
      (call (. b dot) (+ sun-point (* hill-light 3.5)) 27)
      (call (. b glow) cream 0.55)
      (call (. b dot) (+ sun-point (call Point -10 -10)) 7)
    )
  )
)

(fn-do _ paint-stars _
  (param b HillBrush)
  (param clock Float)
  (for (in index (..< 0 70))
    (let spot (call Point (* 1200 (% (* index golden) 1.0)) (* 205 (% (* index 0.754878) 1.0))))
    (let twinkle (+ 0.62 (* 0.38 (call sin (+ (* clock (+ 0.8 (call rand index 7))) (* index 2.1))))))
    (call (. b glow) moon (* twinkle (+ 0.25 (* 0.55 (call rand index 3)))))
    (call (. b dot) spot (+ 0.6 (* 1.1 (call rand index 5))))
    (if (== (% index 9) 0)
      (= (. b canvas stroke-color) (call (. moon with-alpha) (* twinkle 0.5)))
      (= (. b canvas fill-color) null)
      (= (. b canvas stroke-width) 0.8)
      (call (. b line) (- spot (call Point 5 0)) (+ spot (call Point 5 0)))
      (call (. b line) (- spot (call Point 0 5)) (+ spot (call Point 0 5)))
    )
  )
)

(fn-do _ paint-clouds _
  (param b HillBrush)
  (param clock Float)
  (call puff b (call Point (call drift 250 clock 7) 74) 1.0)
  (call puff b (call Point (call drift 486 clock 4.5) 40) 0.7)
  (call puff b (call Point (call drift 1092 clock 6) 94) 0.8)
)

(fn-do _ puff _
  (param b HillBrush)
  (param at Point)
  (param size Float)
  (let alpha (- 1 (* (. b night) 0.7)))
  (call (. b tint) cloud-shade alpha)
  (for (in index (..< 0 (. puffs length)))
    (call (. b dot) (+ at (* (+ ([] puffs index) (call Point 2 5)) size)) (* ([] puff-sizes index) size))
  )
  (call (. b quad) (list (+ at (* (call Point -62 8) size)) (+ at (* (call Point 78 8) size)) (+ at (* (call Point 74 26) size)) (+ at (* (call Point -58 26) size))) (* 9 size))
  (call (. b tint) cloud alpha)
  (for (in index (..< 0 (. puffs length)))
    (call (. b dot) (+ at (* (- ([] puffs index) (call Point 1.5 1.5)) size)) (* ([] puff-sizes index) size 0.92))
  )
)

(fn-do _ paint-far-hills _
  (param b HillBrush)
  (call (. b fill) far-hill)
  (call ridge b 152 22 0.0053 1.3)
  (call (. b fill) near-hill)
  (call ridge b 172 16 0.0083 4.1)
)

(fn-do _ ridge _
  (param b HillBrush)
  (param base Float)
  (param height Float)
  (param rate Float)
  (param phase Float)
  (call (. b canvas begin))
  (call (. b trace) (call (of List Point) (in (call Point (* each 50.0) (- base (* height (call sin (+ (* each 50.0 rate) phase))) (* 7 (call sin (+ (* each 50.0 rate 3.1) phase))))) (..< 0 25))) false)
  (call (. b canvas line) 1200 420)
  (call (. b canvas line) 0 420)
  (call (. b canvas end) true)
)

(fn-do _ paint-tree _
  (param b HillBrush)
  (let ground (call crest-y tree-x))
  (let fork (call Point (+ tree-x 4) (- ground 74)))
  (call (. b tube) (call Point tree-x (+ ground 16)) (call Point (- tree-x 2) (- ground 30)) fork 30 15 bark)
  (call (. b tube) fork (call Point (- tree-x 18) (- ground 96)) (call Point (- tree-x 42) (- ground 114)) 13 5 bark)
  (call (. b tube) fork (call Point (+ tree-x 22) (- ground 98)) (call Point (+ tree-x 46) (- ground 110)) 12 5 bark)
  (call (. b stroke) (call shade bark) 1.2)
  (call (. b path) (list (call Point (- tree-x 6) (- ground 2)) (call Point (- tree-x 4) (- ground 22)) (call Point (- tree-x 5) (- ground 44))))
  (call (. b path) (list (call Point (+ tree-x 6) (- ground 10)) (call Point (+ tree-x 7) (- ground 34)) (call Point (+ tree-x 5) (- ground 56))))
  (let crown (call Point (+ tree-x 2) (- ground 102)))
  (let back (call shade leaf))
  (call clump b crown -46 12 26 back 1)
  (call clump b crown 46 15 26 back 2)
  (call clump b crown -19 -18 28 back 3)
  (call clump b crown 24 -20 27 back 4)
  (call clump b crown -32 4 29 leaf 5)
  (call clump b crown 36 6 29 leaf 6)
  (call clump b crown 0 -10 33 leaf 7)
  (call clump b crown -10 20 26 leaf 8)
  (call clump b crown 18 18 24 leaf 9)
  (call (. b fill) (call lit leaf))
  (for (in index (..< 0 16))
    (let spot (+ crown (call Point (- (* 96 (call rand index 11)) 50) (- (* 58 (call rand index 13)) 38))))
    (call (. b shape) (call blob spot (+ 3 (* 3 (call rand index 17))) 2.4 (as index Float) 0.2))
  )
  (for (in index (..< 0 5))
    (let spot (+ crown (call Point (- (* 80 (call rand index 21)) 40) (- (* 34 (call rand index 23)) 2))))
    (call (. b ball) spot 5.5 5.5 apple (as index Float))
    (call (. b tint) cream 0.7)
    (call (. b dot) (+ spot (call Point -1.8 -2)) 1.3)
    (call (. b stroke) bark 1)
    (call (. b line) (- spot (call Point 0 5)) (- spot (call Point -1 8)))
  )
)

(fn-do _ clump _
  (param b HillBrush)
  (param crown Point)
  (param dx Float)
  (param dy Float)
  (param radius Float)
  (param color RGBA)
  (param seed Float)
  (call (. b fill) (call shade color))
  (call (. b shape) (call blob (+ crown (call Point dx dy)) radius (* radius 0.86) seed 0.08))
  (call (. b fill) color)
  (call (. b shape) (call blob (+ crown (call Point (- dx 3) (- dy 5))) (* radius 0.84) (* radius 0.72) seed 0.08))
)

(fn-do _ paint-ground _
  (param b HillBrush)
  (for (in index (..< 0 (. soils length)))
    (let color ([] soils index))
    (let edge (call soil-edge index))
    (call (. b fill) color)
    (call (. b canvas begin))
    (call (. b trace) edge false)
    (call (. b canvas line) 1200 800)
    (call (. b canvas line) 0 800)
    (call (. b canvas end) true)
    (if (> index 0)
      (call (. b stroke) (call shade color) 2.5)
      (call (. b path) edge)
      (call (. b stroke) (call (. (call lit color) with-alpha) 0.45) 3)
      (call (. b path) (call (of List Point) (in (+ each (call Point 0 4)) edge)))
    )
    (let floor (if-expr (< index 3) ([] soil-tops (+ index 1)) 726.0))
    (for (in speck (..< 0 70))
      (let x (* 1200 (call rand speck (+ index 1))))
      (let top (+ (call soil-y x index) 8))
      (let y (+ top (* (call max 0.0 (- floor top 14)) (call rand speck (+ index 7)))))
      (if (== (% speck 3) 0)
        (call (. b tint) (call lit color) 0.7)
        (else
          (call (. b tint) (call shade color) 0.6)
        )
      )
      (call (. b dot) (call Point x y) (+ 0.7 (* 1.7 (call rand speck (+ index 13)))))
    )
  )
)

(fn-do _ paint-crest _
  (param b HillBrush)
  (call (. b fill) grass)
  (call (. b shape) (call (of List Point) (in (call band-point each 26) (..< 0 66))))
  (call (. b stroke) (call lit grass) 3)
  (call (. b path) (call crest-line 4))
  (call (. b stroke) (call shade grass) 4)
  (call (. b path) (call crest-line 24))
  (call (. b stroke) (call (. soot with-alpha) 0.35) 3)
  (call (. b path) (call crest-line 28))
  (call (. b fill) (call shade ([] soils 0)))
  (for (in index (..< 0 70))
    (let x (+ 8 (* index 17.0)))
    (let top (+ (call crest-y x) 27))
    (let hang (+ 6 (* 9 (call rand index 31))))
    (call (. b taper) (call Point x top) (call Point (+ x 1.5) (+ top (* hang 0.5))) (call Point (+ x (* 3 (call sway index 33))) (+ top hang)) 1.6 1.1 0.4)
  )
)

(fn-do _ paint-finds _
  (param b HillBrush)
  (let shell-at (call Point 318 552))
  (call (. b ball) shell-at 11 10 shell 4)
  (call (. b stroke) (call shade shell) 1.4)
  (call (. b path) (call (of List Point) (in (+ shell-at (* (call Point (call cos (* each 0.7)) (call sin (* each 0.7))) (- 9 (* each 0.55)))) (..< 0 15))))
  (let bone-at (call Point 1012 690))
  (call (. b tube) (- bone-at (call Point 16 2)) bone-at (+ bone-at (call Point 16 -3)) 6 6 bone)
  (for (in end (list (call Point -18 -5) (call Point -18 1) (call Point 18 -6) (call Point 18 0)))
    (call (. b ball) (+ bone-at end) 4.2 4.2 bone 2)
  )
  (let worm-at (call Point 470 270))
  (call (. b tube) worm-at (+ worm-at (call Point 16 -8)) (+ worm-at (call Point 34 -2)) 6 4.5 worm)
  (call (. b stroke) (call shade worm) 0.8)
  (for (in ring (..< 1 5))
    (let spot (+ worm-at (call Point (* ring 7.0) (- (* ring -2.2) 0.5))))
    (call (. b line) (- spot (call Point 1 2.5)) (+ spot (call Point 1 2.5)))
  )
  (call (. b tint) soot 0.25)
  (call (. b shape) (call blob (+ worm-at (call Point -10 6)) 8 6 5 0.1))
)

(fn-do _ paint-roots _
  (param b HillBrush)
  (let ground (+ (call crest-y tree-x) 12))
  (for (in index (..< 0 5))
    (let lean (* (- index 2) 42.0))
    (let reach (+ 92 (* 70 (call rand index 2))))
    (let spine (call (of List Point) (in (call root-point index lean reach ground (/ (as each Float) 5)) (..< 0 6))))
    (call strand b spine (- 16.0 (* 3 (call abs (- index 2)))) 1.6)
    (let way (if-expr (< index 2) -1.0 1.0))
    (let fork ([] spine 2))
    (call strand b (list fork (+ fork (call Point (* way 12) 9)) (+ fork (call Point (* way 22) 22)) (+ fork (call Point (* way 26) 38))) 4.5 1.2)
    (let late ([] spine 4))
    (call strand b (list late (+ late (call Point (* way -9) 8)) (+ late (call Point (* way -13) 19))) 3 1)
  )
)

(fn-do _ strand _
  (param b HillBrush)
  (param spine (list Point))
  (param wide Float)
  (param thin Float)
  (let count (. spine length))
  (let outline (call (of List Point) (in (call strand-edge spine (if-expr (< each count) each (- (* count 2) 1 each)) (if-expr (< each count) 0.5 -0.5) wide thin) (..< 0 (* count 2)))))
  (call (. b fill) (call shade root))
  (call (. b shape) (call (of List Point) (in (+ each (call Point 1.2 1.8)) outline)))
  (call (. b fill) root)
  (call (. b shape) outline)
  (call (. b stroke) (call (. (call lit root) with-alpha) 0.45) (call max 0.8 (* wide 0.14)))
  (call (. b path) (call (of List Point) (in (+ ([] spine each) (call Point (* wide -0.14) (* wide -0.08))) (..< 0 (- count 1)))))
)

(fn-do _ paint-stones _
  (param b HillBrush)
  (for (in index (..< 0 24))
    (let x (call cell-middle (+ 40 (* 1120 (% (* index golden) 1.0))) (. peg-origin x) (* 8 (call sway index 61))))
    (let y (call cell-middle (+ 250 (* 450 (% (* index 0.754878) 1.0))) (. peg-origin y) (* 6 (call sway index 63))))
    (let size (+ 7 (* 10 (call rand index 3))))
    (let tone ([] stone-tones (% index 3)))
    (let seed (as index Float))
    (call (. b tint) soot 0.22)
    (call (. b shape) (call blob (call Point (+ x 1.5) (+ y 3)) size (* size 0.66) seed 0.18))
    (call (. b mass) (call blob (call Point x y) size (* size 0.66) seed 0.18) tone (* size 0.22))
    (call (. b stroke) (call shade tone) 1)
    (call (. b path) (list (call Point (- x (* size 0.3)) (- y (* size 0.3))) (call Point (- x (* size 0.05)) (- y (* size 0.05))) (call Point (+ x (* size 0.1)) (+ y (* size 0.25)))))
    (call (. b tint) cream 0.35)
    (call (. b shape) (call blob (call Point (- x (* size 0.35)) (- y (* size 0.28))) (* size 0.3) (* size 0.16) seed 0.1))
  )
  (for (in index (..< 0 12))
    (let center (call Point (call cell-middle (+ 60 (* 1080 (call rand index 41))) (. peg-origin x) 0) (call cell-middle (+ 260 (* 440 (call rand index 43))) (. peg-origin y) 14)))
    (for (in grit (..< 0 3))
      (let spot (+ center (call Point (* 9 (call sway index (+ grit 45))) (* 5 (call sway index (+ grit 47))))))
      (call (. b ball) spot (+ 2.4 (* 1.6 (call rand index grit))) (+ 2 (* 1.2 (call rand index grit))) pebble (as grit Float))
    )
  )
)

(fn-do _ paint-pegs _
  (param b HillBrush)
  (for (in row (..< 0 peg-rows))
    (for (in column (..< 0 peg-columns))
      (let spot (call peg-point column row))
      (call (. b tint) soot 0.3)
      (call (. b dot) (+ spot (call Point 1.5 2.2)) 7)
      (call (. b fill) soot)
      (call (. b dot) spot 6.2)
      (call (. b ball) spot 4.9 4.9 peg (as (+ (* row 17) column) Float))
      (call (. b stroke) (call (. (call shade peg) with-alpha) 0.5) 0.8)
      (call (. b dot) spot 2.3)
      (call (. b tint) cream 0.85)
      (call (. b dot) (- spot (call Point 1.6 1.8)) 1.1)
    )
  )
)

(fn-do _ paint-turf _
  (param b HillBrush)
  (for (in index (..< 0 48))
    (let x (+ 6 (* index 25.0) (* 8 (call rand index 1))))
    (let base (+ (call crest-y x) 4))
    (for (in blade (..< 0 4))
      (let spread (* (- blade 1.5) 2.4))
      (let lean (+ (* (- blade 1.5) 3.4) (* 3 (call sway index (+ blade 2)))))
      (let tall (+ 9 (* 9 (call rand index (+ blade 6)))))
      (call (. b fill) (if-expr (== (% blade 2) 0) (call shade grass) (call lit grass)))
      (call (. b taper) (call Point (+ x spread) base) (call Point (+ x spread (* lean 0.5)) (- base (* tall 0.55))) (call Point (+ x spread lean) (- base tall)) 2.6 1.7 0.3)
    )
    (if (== (% index 3) 1)
      (call paint-flower b (call Point (+ x 9) (- base 11)) (% index 2) (as index Float))
    )
  )
)

(fn-do _ paint-flower _
  (param b HillBrush)
  (param at Point)
  (param kind Int)
  (param seed Float)
  (call (. b fill) (call shade grass))
  (call (. b taper) (+ at (call Point 0 13)) (+ at (call Point 1 6)) at 1.5 1.2 1)
  (let petal (if-expr (== kind 0) daisy buttercup))
  (for (in index (..< 0 5))
    (let angle (+ seed (* index 1.2566)))
    (call (. b ball) (+ at (* (call Point (call cos angle) (call sin angle)) 3.1)) 2.3 2.3 petal (+ seed index))
  )
  (call (. b ball) at 1.8 1.8 (if-expr (== kind 0) buttercup (call shade buttercup)) seed)
)

(fn-do _ paint-tower _
  (param b HillBrush)
  (let top (- lift-top 22))
  (let bottom (+ water-line 14))
  (for (in index (..< 0 5))
    (let y (+ top 30 (* index 112.0)))
    (call (. b bar) (call Point (- lift-x 19) y) (call Point (+ lift-x 19) (+ y 100)) 5 (call shade oak) 1.5)
    (call (. b bar) (call Point (- lift-x 21) (- y 4)) (call Point (+ lift-x 21) (- y 4)) 5 oak 1.5)
  )
  (call (. b bar) (call Point (- lift-x 21) top) (call Point (- lift-x 21) bottom) 8 oak 2)
  (call (. b bar) (call Point (+ lift-x 21) top) (call Point (+ lift-x 21) bottom) 8 oak 2)
  (call (. b fill) soot)
  (for (in index (..< 0 5))
    (let y (+ top 26 (* index 112.0)))
    (call (. b dot) (call Point (- lift-x 21) y) 1.6)
    (call (. b dot) (call Point (+ lift-x 21) y) 1.6)
  )
  (call (. b bar) (call Point (- lift-x 30) top) (call Point (+ lift-x 30) top) 9 oak 2)
  (call (. b block) (list (call Point (- lift-x 38) (- top 3)) (call Point lift-x (- top 28)) (call Point (+ lift-x 38) (- top 3))) paint-red 2.5 3)
  (call (. b stroke) rope 2.6)
  (call (. b line) (call Point lift-x lift-top) (call Point lift-x lift-bottom))
  (call (. b stroke) (call shade rope) 0.9)
  (for (in index (..< 0 (as (/ (- lift-bottom lift-top) 7) Int)))
    (let y (+ lift-top (* index 7.0)))
    (call (. b line) (call Point (- lift-x 1.2) y) (call Point (+ lift-x 1.2) (+ y 3)))
  )
  (call (. b bar) (call Point (+ lift-x 10) (- lift-top 8)) (call Point (- (. hopper-point x) 30) (- (. hopper-point y) 30)) 7 oak 2)
)

(fn-do _ paint-pot _
  (param b HillBrush)
  (let at hopper-point)
  (let ground (call crest-y (. at x)))
  (call (. b tint) soot 0.2)
  (call (. b canvas oval) (call Rect (- (. at x) 34) (- ground 1) 76 12))
  (call (. b bar) (+ at (call Point -14 26)) (call Point (- (. at x) 19) (+ ground 6)) 6 oak 2)
  (call (. b bar) (+ at (call Point 14 26)) (call Point (+ (. at x) 19) (+ ground 6)) 6 oak 2)
  (call (. b bar) (+ at (call Point -24 27)) (+ at (call Point 24 27)) 7 oak 2)
  (call (. b bar) (+ at (call Point 18 16)) (+ at (call Point 52 35)) 9 oak 2)
  (call (. b stroke) (call shade oak) 1.5)
  (call (. b line) (+ at (call Point 20 11)) (+ at (call Point 54 30)))
  (call (. b mass) (call (of List Point) (in (+ at each) (list (call Point -34 -24) (call Point -46 -4) (call Point -42 16) (call Point -24 30) (call Point 24 30) (call Point 42 16) (call Point 46 -4) (call Point 34 -24)))) clay 6)
  (call (. b fill) (call lit clay))
  (call (. b taper) (+ at (call Point -31 -12)) (+ at (call Point -34 4)) (+ at (call Point -24 20)) 5 4.5 2)
  (call (. b stroke) cream 2)
  (call (. b path) (call (of List Point) (in (+ at (call Point (- (* each 8.0) 36) (if-expr (== (% each 2) 0) -4.0 4.0))) (..< 0 10))))
  (call (. b tint) cream 0.9)
  (for (in index (..< 0 8))
    (call (. b dot) (+ at (call Point (- (* index 9.0) 31) 15)) 1.6)
  )
  (call (. b block) (list (+ at (call Point -41 -36)) (+ at (call Point 41 -36)) (+ at (call Point 38 -22)) (+ at (call Point -38 -22))) clay 2 5)
  (call (. b fill) soot)
  (call (. b canvas oval) (call Rect (- (. at x) 33) (- (. at y) 36) 66 9))
)

(fn-do _ paint-crate-back _
  (param b HillBrush)
  (let at crate-point)
  (call (. b tint) soot 0.2)
  (call (. b canvas oval) (call Rect (- (. at x) 116) (+ (. at y) 16) 236 18))
  (call (. b fill) (call shade (call shade oak)))
  (call (. b quad) (list (+ at (call Point -106 -22)) (+ at (call Point 106 -22)) (+ at (call Point 106 26)) (+ at (call Point -106 26))) 2)
  (call (. b stroke) (call shade (call shade (call shade oak))) 1.5)
  (call (. b line) (+ at (call Point -104 -8)) (+ at (call Point 104 -8)))
)

(fn-do _ paint-stream-bed _
  (param b HillBrush)
  (let surface (- water-line 6))
  (call (. b canvas fill-gradient) (call Rect 0 surface 1200 (- 800 surface)) (call linear-gradient (call Point 0 surface) (call Point 0 800) (call (. b ink) (call lit water)) (call (. b ink) (call shade (call shade water)))))
  (for (in index (..< 0 30))
    (let spot (call Point (* 1200 (call rand index 51)) (+ 764 (* 34 (call rand index 53)))))
    (call (. b ball) spot (+ 4 (* 6 (call rand index 55))) (+ 3 (* 3 (call rand index 57))) (call (. (call (. water with-alpha) 0.55) over) pebble) (as index Float))
  )
  (call (. b fill) mud)
  (call (. b canvas begin))
  (call (. b trace) (call (of List Point) (in (call Point (* each 40.0) (+ surface -3 (* 2.5 (call sin (* each 1.7))))) (.. 0 30))) false)
  (call (. b trace) (call (of List Point) (in (call Point (- 1200 (* each 40.0)) (+ surface 5 (* 2 (call sin (* each 2.3))))) (.. 0 30))) false)
  (call (. b canvas end) true)
  (for (in clump (list 330.0 770.0 1140.0))
    (call paint-reeds b clump)
  )
)

(fn-do _ paint-reeds _
  (param b HillBrush)
  (param x Float)
  (for (in index (..< 0 6))
    (let foot (call Point (+ x (* (- index 2.5) 5)) (+ water-line 8)))
    (let lean (* (- index 2.5) 6))
    (let tall (+ 34 (* 26 (call hash x (as index Float)))))
    (call (. b fill) (if-expr (== (% index 2) 0) (call shade reed) reed))
    (call (. b taper) foot (+ foot (call Point (* lean 0.4) (* tall -0.55))) (+ foot (call Point lean (- tall))) 4.5 3.4 0.5)
  )
  (for (in index (..< 0 2))
    (let top (call Point (+ x (* (- index 0.5) 14)) (- water-line (+ 44 (* index 10.0)))))
    (call (. b stroke) (call shade reed) 1.6)
    (call (. b line) (+ top (call Point 0 6)) (call Point (. top x) (+ water-line 8)))
    (call (. b tube) top (+ top (call Point 0 7)) (+ top (call Point 0 14)) 6 6 cattail)
    (call (. b stroke) (call shade reed) 1.2)
    (call (. b line) top (- top (call Point 0 7)))
  )
)

(fn-expr _ crest-line (list Point)
  (param drop Float)
  (call (of List Point) (in (call Point (* each 40.0) (+ (call crest-y (* each 40.0)) drop)) (.. 0 30)))
)

(fn-expr _ soil-edge (list Point)
  (param band Int)
  (call (of List Point) (in (call Point (* each 40.0) (call soil-y (* each 40.0) band)) (.. 0 30)))
)

(fn-expr _ soil-y Float
  (param x Float)
  (param band Int)
  (call max (+ (call crest-y x) 20) (+ ([] soil-tops band) (* 9 (call sin (+ (* x 0.011) (* band 1.7)))) (* 5 (call sin (+ (* x 0.029) band)))))
)

(fn-expr _ root-point Point
  (param index Int)
  (param lean Float)
  (param reach Float)
  (param ground Float)
  (param t Float)
  (call Point (+ tree-x (* lean 0.12) (* lean 1.25 t (- 1.6 (* 0.6 t))) (* 9 t (call sin (+ (* t 4) index)))) (+ ground (* reach t)))
)

(fn-expr _ strand-edge Point
  (param spine (list Point))
  (param index Int)
  (param side Float)
  (param wide Float)
  (param thin Float)
  (+ point (* (call side-of behind ahead) (* side width)))
  (where
    (lazy count (. spine length))
    (lazy point ([] spine index))
    (lazy ahead ([] spine (call min (+ index 1) (- count 1))))
    (lazy behind ([] spine (call max (- index 1) 0)))
    (lazy width (+ wide (* (- thin wide) (/ (as index Float) (as (- count 1) Float)))))
  )
)

(fn-expr _ drift Float
  (param start Float)
  (param clock Float)
  (param speed Float)
  (- (% (+ start 160 (* clock speed)) 1560) 160)
)

(fn-expr _ cell-middle Float
  (param value Float)
  (param origin Float)
  (param jitter Float)
  (if-expr (< value (- origin 20)) value (+ origin (* peg-pitch (as (as (/ (- value origin) peg-pitch) Int) Float)) (* peg-pitch 0.5) jitter))
)

(fn-expr _ rand Float
  (param a Int)
  (param b Int)
  (call hash (as a Float) (as b Float))
)

(fn-expr _ sway Float
  (param a Int)
  (param b Int)
  (call jitter (as a Float) (as b Float))
)

(fn-expr _ band-point Point
  (param index Int)
  (param drop Float)
  (call Point x (+ (call crest-y x) (if-expr (< index 33) 0.0 drop)))
  (where
    (lazy x (- (* (as (if-expr (< index 33) index (- 65 index)) Float) 40) 40))
  )
)
