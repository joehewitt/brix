(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop + clatter-stage-size _ (= (call Dimensions 1200 800)))
(prop + marble-radius _ (= 11.0))
(prop + peg-columns _ (= 17))
(prop + peg-rows _ (= 8))
(prop + peg-pitch _ (= 60.0))
(prop + peg-origin _ (= (call Point 180 222)))
(prop + water-line _ (= 732.0))
(prop + lift-x _ (= 62.0))
(prop + lift-top _ (= 100.0))
(prop + lift-bottom _ (= 760.0))
(prop + bucket-count _ (= 8))
(prop + hopper-point _ (= (call Point 132 150)))
(prop + crate-point _ (= (call Point 1070 158)))
(prop _ hopper-mouth _ (= (call Point 176 184)))
(prop _ marble-count _ (= 12))
(prop _ gravity _ (= 1100.0))
(prop _ top-speed _ (= 1200.0))
(prop _ roll-drag _ (= 0.35))
(prop _ current _ (= 150.0))
(prop _ lift-speed _ (= 80.0))
(prop _ cup-tilt _ (= 2.1))
(prop _ seesaw-tilt _ (= 0.34))
(prop _ drum-kick _ (= 430.0))
(prop _ drum-grip _ (= 0.55))
(prop _ snap-reach _ (= 90.0))
(prop _ grab-reach _ (= 18.0))
(prop _ click-slop _ (= 6.0))
(prop _ release-gap Seconds (= 700ms))
(prop _ burst-gap Seconds (= 150ms))
(prop _ sound-gap Seconds (= 60ms))
(prop _ seesaw-settle Seconds (= 250ms))
(prop _ cup-hold Seconds (= 900ms))
(prop _ cup-rest Seconds (= 1800ms))
(prop _ longest-frame Seconds (= 50ms))
(prop _ substeps-per-second _ (= 240.0))

(type + PieceKind (is Union)
  (variant ramp)
  (variant chime)
  (variant seesaw)
  (variant cup)
  (variant drum)
)

(type + MarbleMode (is Union)
  (variant rolling)
  (variant floating)
  (variant lifted)
  (variant waiting)
  (variant held)
)

(type + ClatterTone (is Union)
  (variant wood)
  (variant chime)
  (variant drum)
  (variant clack)
  (variant click)
  (variant plop)
  (variant tick)
)

(type + ClatterNote (is (tuple (: tone ClatterTone) (: degree Int) (: strength Float) (: pan Float))))

(type + PieceEdge (is (tuple (: from Point) (: to Point) (: radius Float))))

(type + PegSpot (is (tuple (: column Int) (: row Int))))

(type + ClatterPiece
  (prop + kind PieceKind)
  (prop + column Int)
  (prop + row Int)
  (prop + facing Float)
  (prop + is-placed Bool)
  (prop + slot Int)
  (prop + lifted (? Point))
  (prop + tilt Float)
  (prop + side Float)
  (prop + wobble Float)
  (prop + tipped-at (? Seconds))
  (prop + edges _ (= (call (of List PieceEdge))))
  (prop + touched-at Seconds)
  (fn-do + This _
    (param kind _)
    (param column _)
    (param row _)
    (param facing _)
    (= is-placed true)
    (= side facing)
  )
  (fn-expr + span Int :get
    (match kind
      (case .ramp
        3
      )
      (case .seesaw
        3
      )
      (case .cup
        1
      )
      (default
        2
      )
    )
  )
  (fn-expr + home Point :get
    (+ (call peg-point column row) (call Point (* 30.0 (- span 1)) 0))
  )
  (fn-expr + center Point :get
    (?? lifted (if-expr is-placed home (call crate-spot slot)))
  )
  (fn-expr + bounce Float :get
    (match kind
      (case .chime
        0.5
      )
      (case .drum
        0.85
      )
      (default
        0.2
      )
    )
  )
  (fn-expr + tone ClatterTone :get
    (match kind
      (case .chime
        .chime
      )
      (case .drum
        .drum
      )
      (case .seesaw
        .clack
      )
      (case .cup
        .click
      )
      (default
        .wood
      )
    )
  )
  (fn-expr + degree Int :get
    (- peg-rows 1 row)
  )
  (fn-expr + is-solid Bool :get
    (and is-placed (not lifted))
  )
  (fn-expr + outline (list PieceEdge) :get
    (match kind
      (case .ramp
        (call List
          (block
            (item (call PieceEdge (call Point -86 (* -14 facing)) (call Point 86 (* 14 facing)) 5.0))
            (item (call PieceEdge (call Point (* -86 facing) -14) (call Point (* -86 facing) -46) 4.0))
          )
        )
      )
      (case .chime
        (list (call PieceEdge (call Point -50 (* -6 facing)) (call Point 50 (* 6 facing)) 4.0))
      )
      (case .seesaw
        (list (call PieceEdge (call Point -84 0) (call Point 84 0) 5.0))
      )
      (case .cup
        (call List
          (block
            (item (call PieceEdge (call Point -26 8) (call Point -22 52) 4.0))
            (item (call PieceEdge (call Point -22 52) (call Point 22 52) 4.0))
            (item (call PieceEdge (call Point 22 52) (call Point 26 8) 4.0))
          )
        )
      )
      (case .drum
        (list (call PieceEdge (call Point -46 (* -5 facing)) (call Point 46 (* 5 facing)) 4.0))
      )
    )
  )
  (fn-expr + place Point
    (param point Point)
    (+ center (call turned point tilt))
  )
  (fn-expr + local Point
    (param point Point)
    (call turned (- point center) (- tilt))
  )
  (fn-expr + reach Float
    (param point Point)
    (call min (in (call edge-distance point each) edges))
  )
  (fn-expr + holds Bool
    (param point Point)
    (and (< (call abs (. inside x)) 22) (> (. inside y) 8) (< (. inside y) 52))
    (where
      (lazy inside (call local point))
    )
  )
  (fn-do + shape _
    (= edges (call (of List PieceEdge) (in (call PieceEdge (call place (. each from)) (call place (. each to)) (. each radius)) outline)))
  )
  (fn-do + flip _
    (= facing (- facing))
    (= side (- side))
    (call shape)
  )
)

(type + Marble
  (prop + place Point)
  (prop + velocity Point)
  (prop + hue Int)
  (prop + mode MarbleMode)
  (prop + bucket Int)
  (prop + spin Float)
  (prop + sounded-at Seconds)
  (fn-do + This _
    (param hue _)
    (param mode _)
  )
)

(type + ClatterRun
  (event + notes ClatterNote)
  (prop + pieces _ (= (call (of List ClatterPiece))))
  (prop + marbles _ (= (call (of List Marble))))
  (prop + hopper _ (= (call (of List Marble))))
  (prop + loads _ (= (call (of List (? Marble)))))
  (prop + clock Seconds)
  (prop + lift Float)
  (prop + rolling Float)
  (prop + held-piece (? ClatterPiece))
  (prop + held-marble (? Marble))
  (prop + drop-spot (? PegSpot))
  (prop _ grip _ (= (call Point 0 0)))
  (prop _ pointer _ (= (call Point 0 0)))
  (prop _ pressed-at _ (= (call Point 0 0)))
  (prop _ is-dragging Bool)
  (prop _ is-bursting Bool)
  (prop _ released-at Seconds)
  (prop _ rolled Float)
  (fn-do + This _
    (call reset)
  )
  (fn-expr + bucket-point Point
    (param index Int)
    (call Point lift-x (- lift-bottom (% (+ lift (* index bucket-gap)) lift-length)))
  )
  (fn-do + reset _
    (= clock 0)
    (= lift 0)
    (= rolling 0)
    (= released-at 0)
    (= is-bursting false)
    (call cancel)
    (= pieces (call starting-run))
    (for (in piece (call spare-pieces))
      (+= pieces piece)
      (call stow piece)
    )
    (for (in piece pieces)
      (call (. piece shape))
    )
    (= marbles (call (of List Marble) (in (call Marble (% each 3) .waiting) (..< 0 marble-count))))
    (= hopper (call (of List Marble)))
    (= loads (call (of List (? Marble)) (in null (..< 0 bucket-count))))
    (for (in index (..< 0 marble-count))
      (let marble ([] marbles index))
      (if (== (% index 3) 0)
        (+= hopper marble)
        (else-if (== (% index 3) 1)
          (= (. marble mode) .floating)
          (= (. marble place) (call Point (+ 260 (* index 70.0)) water-line))
        )
        (else
          (= (. marble mode) .lifted)
          (= (. marble bucket) (% index bucket-count))
          (= ([] loads (. marble bucket)) marble)
        )
      )
    )
  )
  (fn-do + burst _
    (= is-bursting (> (. hopper length) 0))
  )
  (fn-do + press _
    (param point Point)
    (call cancel)
    (= pressed-at point)
    (= pointer point)
    (= held-marble (call marble-at point))
    (return-if (if held-marble))
    (= held-piece (call piece-at point))
    (= grip (- (?? (?. held-piece center) point) point))
  )
  (fn-do + drag _
    (param point Point)
    (= pointer point)
    (return-if (if (or is-dragging (<= (call (. point distance) pressed-at) click-slop))))
    (= is-dragging true)
    (let marble held-marble)
    (if marble
      (= (. marble mode) .held)
      (= (. marble velocity) (call Point 0 0))
      (call free-bucket marble)
    )
    (let piece held-piece)
    (if piece
      (= (. piece lifted) (+ point grip))
    )
  )
  (fn-do + release _
    (param point Point)
    (= pointer point)
    (if is-dragging
      (call drop)
      (else
        (call click point)
      )
    )
    (call cancel)
  )
  (fn-do + cancel _
    (if is-dragging
      (call drop)
    )
    (= is-dragging false)
    (= held-marble null)
    (= held-piece null)
    (= drop-spot null)
  )
  (fn-do + play _
    (param elapsed Seconds)
    (let steps (call frame-steps elapsed))
    (call carry (call sum (in each steps)))
    (= rolled 0)
    (for (in dt steps)
      (call tick dt)
    )
    (let level (call clamp (/ rolled (* (. steps length) 1800.0)) 0.0 1.0))
    (+= rolling (* (- level rolling) 0.2))
  )
  (fn-do _ carry _
    (param dt Float)
    (return-if (if (not is-dragging)))
    (let marble held-marble)
    (if marble
      (let moved (/ (- pointer (. marble place)) (call max dt 0.001)))
      (= (. marble velocity) (+ (* (. marble velocity) 0.4) (* moved 0.6)))
      (= (. marble place) pointer)
    )
    (let piece held-piece)
    (if piece
      (= (. piece lifted) (+ pointer grip))
      (= drop-spot (call snap-spot piece))
    )
  )
  (fn-do _ tick _
    (param dt Float)
    (+= clock dt)
    (call run-lift dt)
    (call release-next)
    (for (in piece pieces (when (. piece is-solid)))
      (call settle piece dt)
    )
    (for (in marble marbles)
      (if (is (. marble mode) .rolling)
        (call roll marble dt)
        (else-if (is (. marble mode) .floating)
          (call drift marble dt)
        )
        (else-if (is (. marble mode) .lifted)
          (= (. marble place) (- (call bucket-point (. marble bucket)) (call Point 0 9)))
        )
      )
    )
    (let count (. marbles length))
    (for (in first (..< 0 count))
      (for (in second (..< (+ first 1) count))
        (call knock ([] marbles first) ([] marbles second))
      )
    )
  )
  (fn-do _ run-lift _
    (param dt Float)
    (let before lift)
    (+= lift (* lift-speed dt))
    (for (in index (..< 0 bucket-count))
      (let start (% (+ before (* index bucket-gap)) lift-length))
      (let height (% (+ lift (* index bucket-gap)) lift-length))
      (if (< height start)
        (call tip index)
        (else-if (< height 18)
          (call load index)
        )
      )
    )
    (= lift (% lift lift-length))
  )
  (fn-do _ tip _
    (param index Int)
    (let marble ([] loads index))
    (return-if (if (not marble)))
    (= ([] loads index) null)
    (= (. marble mode) .waiting)
    (+= hopper marble)
    (<- notes (call ClatterNote .tick 4 0.5 (call pan-of hopper-point)))
  )
  (fn-do _ load _
    (param index Int)
    (return-if (if ([] loads index)))
    (let marble (call first (in each marbles (when (and (is (. each mode) .floating) (<= (. each place x) (+ lift-x 26)))))))
    (return-if (if (not marble)))
    (= (. marble mode) .lifted)
    (= (. marble bucket) index)
    (= ([] loads index) marble)
  )
  (fn-do _ free-bucket _
    (param marble Marble)
    (for (in index (..< 0 bucket-count))
      (if (== ([] loads index) marble)
        (= ([] loads index) null)
      )
    )
    (= hopper (call (of List Marble) (in each hopper (when (!= each marble)))))
  )
  (fn-do _ release-next _
    (return-if (if (== (. hopper length) 0)))
    (return-if (if (< (- clock released-at) (if-expr is-bursting burst-gap release-gap))))
    (return-if (if (call some marbles (:where (and (is (. each mode) .rolling) (< (call (. (. each place) distance) hopper-mouth) 26))))))
    (let marble (call (. hopper pop-first)))
    (= (. marble mode) .rolling)
    (= (. marble place) hopper-mouth)
    (= (. marble velocity) (call Point 60 0))
    (= released-at clock)
    (if (== (. hopper length) 0)
      (= is-bursting false)
    )
  )
  (fn-do _ settle _
    (param piece ClatterPiece)
    (param dt Float)
    (= (. piece wobble) (call max 0.0 (- (. piece wobble) (* dt 2.5))))
    (if (is (. piece kind) .seesaw)
      (+= (. piece tilt) (* (- (* (. piece side) seesaw-tilt) (. piece tilt)) (call min 1.0 (* dt 16))))
      (call (. piece shape))
      (else-if (is (. piece kind) .cup)
        (call pour piece)
        (let target (if-expr (call is-pouring piece) (* (. piece facing) cup-tilt) 0.0))
        (+= (. piece tilt) (* (- target (. piece tilt)) (call min 1.0 (* dt 7))))
        (call (. piece shape))
      )
    )
  )
  (fn-do _ rock _
    (param piece ClatterPiece)
    (let is-arrival (> (- clock (. piece touched-at)) seesaw-settle))
    (= (. piece touched-at) clock)
    (return-if (if (not is-arrival)))
    (= (. piece side) (- (. piece side)))
    (<- notes (call ClatterNote .clack (. piece degree) 0.45 (call pan-of (. piece center))))
  )
  (fn-do _ pour _
    (param piece ClatterPiece)
    (let tipped (. piece tipped-at))
    (if tipped
      (if (> (- clock tipped) cup-rest)
        (= (. piece tipped-at) null)
      )
      (return)
    )
    (let inside (call count (in each marbles (when (and (is (. each mode) .rolling) (call (. piece holds) (. each place)))))))
    (if (>= inside 3)
      (= (. piece tipped-at) clock)
      (<- notes (call ClatterNote .clack (. piece degree) 0.7 (call pan-of (. piece center))))
    )
  )
  (fn-expr _ is-pouring Bool
    (param piece ClatterPiece)
    (match (. piece tipped-at)
      (case= null
        false
      )
      (default
        (< (- clock (. piece tipped-at)) cup-hold)
      )
    )
  )
  (fn-do _ roll _
    (param marble Marble)
    (param dt Float)
    (+= (. marble velocity) (call Point 0 (* gravity dt)))
    (let speed (. marble velocity length))
    (if (> speed top-speed)
      (= (. marble velocity) (* (. marble velocity) (/ top-speed speed)))
    )
    (+= (. marble place) (* (. marble velocity) dt))
    (for (in piece pieces (when (. piece is-solid)))
      (for (in edge (. piece edges))
        (call collide marble piece edge dt)
      )
    )
    (call bound marble)
    (+= (. marble spin) (/ (* (. marble velocity x) dt) marble-radius))
    (if (> (. marble place y) water-line)
      (= (. marble mode) .floating)
      (<- notes (call ClatterNote .plop (% (. marble hue) 3) (call clamp (/ (. marble velocity y) 900) 0.2 1.0) (call pan-of (. marble place))))
      (= (. marble velocity) (call Point 0 0))
    )
  )
  (fn-do _ bound _
    (param marble Marble)
    (let low marble-radius)
    (let high (- (. clatter-stage-size width) marble-radius))
    (if (< (. marble place x) low)
      (= (. marble place) (call Point low (. marble place y)))
      (= (. marble velocity) (call Point (* (call abs (. marble velocity x)) 0.5) (. marble velocity y)))
    )
    (if (> (. marble place x) high)
      (= (. marble place) (call Point high (. marble place y)))
      (= (. marble velocity) (call Point (* (call abs (. marble velocity x)) -0.5) (. marble velocity y)))
    )
  )
  (fn-do _ collide _
    (param marble Marble)
    (param piece ClatterPiece)
    (param edge PieceEdge)
    (param dt Float)
    (let span (- (. edge to) (. edge from)))
    (let along (/ (call (. (- (. marble place) (. edge from)) dot) span) (call max 0.001 (call (. span dot) span))))
    (let offset (- (. marble place) (+ (. edge from) (* span (call clamp along 0.0 1.0)))))
    (let distance (. offset length))
    (let reach (+ marble-radius (. edge radius)))
    (return-if (if (or (>= distance reach) (< distance 0.001))))
    (let normal (/ offset distance))
    (+= (. marble place) (* normal (- reach distance)))
    (let approach (call (. (. marble velocity) dot) normal))
    (return-if (if (>= approach 0)))
    (let slide (* (- (. marble velocity) (* normal approach)) (- 1 (* roll-drag dt))))
    (let rebound (* approach (- (. piece bounce))))
    (let is-drum (is (. piece kind) .drum))
    (let kick (if-expr is-drum (call max rebound drum-kick) rebound))
    (= (. marble velocity) (+ (* slide (if-expr is-drum drum-grip 1.0)) (* normal kick)))
    (if (is (. piece kind) .seesaw)
      (call rock piece)
    )
    (if (> approach -60)
      (+= rolled (. slide length))
      (return)
    )
    (return-if (if (< (- clock (. marble sounded-at)) sound-gap)))
    (= (. marble sounded-at) clock)
    (= (. piece wobble) 1)
    (<- notes (call ClatterNote (. piece tone) (. piece degree) (call clamp (/ (- approach) 700) 0.15 1.0) (call pan-of (. marble place))))
  )
  (fn-do _ drift _
    (param marble Marble)
    (param dt Float)
    (let foot (+ lift-x 22))
    (let x (. marble place x))
    (let is-blocked
      (call some
        (block
          (arg marbles)
          (:where (and (is (. each mode) .floating) (< (. each place x) x) (< (- x (. each place x)) (+ (* marble-radius 2) 3))))
        )
      )
    )
    (let moved (if-expr is-blocked x (call max foot (- x (* current dt)))))
    (let bob (* (call sin (+ (* (as clock Float) 3) (. marble hue))) 1.5))
    (= (. marble place) (call Point moved (+ water-line 2 bob)))
    (+= (. marble spin) (/ (* (- moved x) 0.5) marble-radius))
  )
  (fn-do _ knock _
    (param first Marble)
    (param second Marble)
    (return-if (if (or (is-not (. first mode) .rolling) (is-not (. second mode) .rolling))))
    (let offset (- (. second place) (. first place)))
    (let distance (. offset length))
    (return-if (if (or (>= distance (* marble-radius 2)) (< distance 0.001))))
    (let normal (/ offset distance))
    (let push (* normal (/ (- (* marble-radius 2) distance) 2)))
    (-= (. first place) push)
    (+= (. second place) push)
    (let approach (call (. (- (. second velocity) (. first velocity)) dot) normal))
    (return-if (if (>= approach 0)))
    (let impulse (* normal (* approach 0.9)))
    (+= (. first velocity) impulse)
    (-= (. second velocity) impulse)
    (return-if (if (or (> approach -90) (< (- clock (. first sounded-at)) sound-gap))))
    (= (. first sounded-at) clock)
    (<- notes (call ClatterNote .click (+ 5 (. first hue)) (call clamp (/ (- approach) 600) 0.1 0.8) (call pan-of (. first place))))
  )
  (fn-do _ drop _
    (let marble held-marble)
    (if marble
      (if (< (call (. (. marble place) distance) hopper-point) 46)
        (= (. marble mode) .waiting)
        (+= hopper marble)
        (else
          (= (. marble mode) .rolling)
        )
      )
    )
    (let piece held-piece)
    (if piece
      (let spot (call snap-spot piece))
      (= (. piece lifted) null)
      (if spot
        (= (. piece column) (. spot column))
        (= (. piece row) (. spot row))
        (= (. piece is-placed) true)
        (= (. piece tipped-at) null)
        (= (. piece tilt) 0)
        (call (. piece shape))
        (<- notes (call ClatterNote .clack (. piece degree) 0.5 (call pan-of (. piece center))))
        (else
          (call stow piece)
        )
      )
    )
    (= is-dragging false)
  )
  (fn-do _ click _
    (param point Point)
    (let piece held-piece)
    (if piece
      (if (. piece is-placed)
        (call (. piece flip))
        (<- notes (call ClatterNote .clack (. piece degree) 0.4 (call pan-of (. piece center))))
      )
      (return)
    )
    (if (< (call (. point distance) hopper-point) 46)
      (call burst)
    )
  )
  (fn-do _ stow _
    (param piece ClatterPiece)
    (= (. piece slot) (call first-free-slot))
    (= (. piece is-placed) false)
    (= (. piece tilt) 0)
  )
  (fn-do _ first-free-slot Int
    (let taken (call (of List Int) (in (. each slot) pieces (when (not (. each is-placed))))))
    (for (in slot (..< 0 (+ (. taken length) 1)))
      (return-if slot (if (not-in slot taken)))
    )
    (return 0)
  )
  (fn-do + snap-spot (? PegSpot)
    (param piece ClatterPiece)
    (let center (. piece center))
    (return-if null (if (< (call (. center distance) crate-point) 70)))
    (let found (? PegSpot))
    (let nearest snap-reach)
    (for (in row (..< 0 peg-rows))
      (for (in column (..< 0 (- (+ peg-columns 1) (. piece span))))
        (let spot (+ (call peg-point column row) (call Point (* 30.0 (- (. piece span) 1)) 0)))
        (let distance (call (. spot distance) center))
        (if (and (< distance nearest) (call is-free piece column row))
          (= nearest distance)
          (= found (call PegSpot column row))
        )
      )
    )
    (return found)
  )
  (fn-expr _ is-free Bool
    (param piece ClatterPiece)
    (param column Int)
    (param row Int)
    (not (call some pieces (:where (and (!= each piece) (. each is-placed) (== (. each row) row) (< column (+ (. each column) (. each span))) (< (. each column) (+ column (. piece span)))))))
  )
  (fn-expr _ marble-at (? Marble)
    (param point Point)
    (call first (in each marbles (when (and (or (is (. each mode) .rolling) (is (. each mode) .floating)) (< (call (. (. each place) distance) point) (+ marble-radius 6))))))
  )
  (fn-do _ piece-at (? ClatterPiece)
    (param point Point)
    (for (in piece pieces)
      (if (. piece is-placed)
        (return-if piece (if (or (< (call (. piece reach) point) grab-reach) (and (is (. piece kind) .cup) (call (. piece holds) point)))))
        (else
          (return-if piece (if (< (call (. (. piece center) distance) point) 22)))
        )
      )
    )
    (return null)
  )
)

(fn-expr + peg-point Point
  (param column Int)
  (param row Int)
  (+ peg-origin (call Point (* column peg-pitch) (* row peg-pitch)))
)

(fn-expr + crate-spot Point
  (param slot Int)
  (+ crate-point (call Point (* (- (% slot 5) 2) 30.0) (- -16 (* 14.0 (/ slot 5)))))
)

(fn-expr + turned Point
  (param point Point)
  (param angle Float)
  (call Point (- (* (. point x) cosine) (* (. point y) sine)) (+ (* (. point y) cosine) (* (. point x) sine)))
  (where
    (lazy cosine (call cos angle))
    (lazy sine (call sin angle))
  )
)

(fn-expr + edge-distance Float
  (param point Point)
  (param edge PieceEdge)
  (- (call (. point distance) (+ (. edge from) (* span (call clamp along 0.0 1.0)))) (. edge radius))
  (where
    (lazy span (- (. edge to) (. edge from)))
    (lazy along (/ (call (. (- point (. edge from)) dot) span) (call max 0.001 (call (. span dot) span))))
  )
)

(fn-expr _ lift-length Float :get
  (- lift-bottom lift-top)
)

(fn-expr _ bucket-gap Float :get
  (/ lift-length bucket-count)
)

(fn-expr _ pan-of Float
  (param point Point)
  (call clamp (/ (- (. point x) 600) 750) -0.8 0.8)
)

(fn-expr _ frame-steps (list Float)
  (param elapsed Seconds)
  (call (of List Float) (in (/ dt count) (..< 0 count)))
  (where
    (lazy dt (as (call min elapsed longest-frame) Float))
    (lazy count (call max 1 (as (call ceil (* dt substeps-per-second)) Int)))
  )
)

(fn-expr _ starting-run (list ClatterPiece)
  (call List
    (block
      (item (call ClatterPiece .ramp 0 0 1.0))
      (item (call ClatterPiece .chime 3 1 1.0))
      (item (call ClatterPiece .ramp 5 2 1.0))
      (item (call ClatterPiece .drum 8 3 1.0))
      (item (call ClatterPiece .ramp 12 4 -1.0))
      (item (call ClatterPiece .seesaw 9 5 1.0))
      (item (call ClatterPiece .drum 7 6 -1.0))
      (item (call ClatterPiece .chime 11 6 1.0))
      (item (call ClatterPiece .cup 4 7 -1.0))
      (item (call ClatterPiece .chime 13 7 1.0))
    )
  )
)

(fn-expr _ spare-pieces (list ClatterPiece)
  (call List
    (block
      (item (call ClatterPiece .ramp 0 0 1.0))
      (item (call ClatterPiece .ramp 0 0 -1.0))
      (item (call ClatterPiece .chime 0 0 1.0))
      (item (call ClatterPiece .drum 0 0 1.0))
      (item (call ClatterPiece .seesaw 0 0 1.0))
    )
  )
)
