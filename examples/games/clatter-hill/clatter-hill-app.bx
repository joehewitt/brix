; A marble run built into a hillside. Marbles tumble from a clay pot down ramps, chimes, a
; seesaw, drums and a tipping cup, splash into the stream, and ride a waterwheel's buckets back
; up to the pot. Drag pieces between the pegs to rebuild the run, click a piece to turn it
; around, and toss marbles by hand. Every hit plays a note: the higher the peg row, the higher
; the note. Space pours out the pot, R rebuilds the starting run, M mutes and Esc pauses. In dark
; mode it is night on the hill. It needs macOS and a sound output.
(import ./clatter-panel)
(import ./clatter-sound)
(import /graphics/primitives)
(import /gui)
(import /lang/product/mac-app)
(blank)

(main
  (<> MacApp
    (= id "com.yumi.clatter-hill")
    (= name "Clatter Hill")
  )
  (blank)
  (let sound (use (call ClatterSound (call clatter-sounds))))
  (blank)
  (<> App
    (<> Window (• flex-col)
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= title "Clatter Hill")
      (= size (call Dimensions 1200 800))
      (blank)
      (<> ClatterPanel (• flex 1)
        (= sound sound)
      )
    )
  )
)
