(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)

(style ClatterTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIBoxTransform)
  (using GUIBoxWindowDrag)
  (prop + clatter-night Float)
  (prop + clatter-ground RGBA (= (call RGBA "#6e4b31")))
  (prop + clatter-title-color RGBA (= (call RGBA "#2f5d7a")))
  (blank)
  (style-domains clatter-night (domain paint))
  (style-domains clatter-ground (domain paint))
  (blank)
  (rule clatter-panel (• bg clatter-ground)
    (= focus-mode (. FocusMode keys))
    (= focus-default true)
    (= focus-home true)
  )
  (rule clatter-backdrop (• absolute) (• cover .parent))
  (rule clatter-board (• absolute) (• cover .parent)
    (= window-draggable true)
  )
  (rule clatter-help (• absolute) (• w 30) (• h 30)
    (= top 8)
    (= right 10)
  )
  (rule clatter-help-title (• h 26)
    (= font-size 15)
    (= font-weight (. FontWeight bold))
  )
  (rule clatter-help-line (• h 20)
    (= font-size 13)
  )
  (rule clatter-help-keys (• text gui-muted-text-color) (• h 20) (• mt 6)
    (= font-size 12)
  )
  (rule clatter-banner (• absolute) (• center .parent) (• w 200) (• h 50) (• text clatter-title-color)
    (= font-size 30)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment center))
    (when-style #is-entering
      (= animation pop-in)
    )
    (when-style #is-leaving
      (= animation popup-out)
    )
  )
)

(style ClatterNightTheme (is ClatterTheme) (for dark)
  (prop + clatter-night _ (= 1.0))
  (prop + clatter-ground _ (= (call RGBA "#2b1e16")))
  (prop + clatter-title-color _ (= (call RGBA "#e9e2c4")))
)
