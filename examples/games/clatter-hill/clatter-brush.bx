(import /graphics/canvas)
(import /graphics/color)
(import /graphics/media)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /stream/aggregate)
(blank)
(prop + oak RGBA (= "#dba468"))
(prop + brass RGBA (= "#e7c15a"))
(prop + tin RGBA (= "#b8c7d0"))
(prop + glass RGBA (= "#d6eef3"))
(prop + paint-red RGBA (= "#d95a48"))
(prop + drum-blue RGBA (= "#3f80c4"))
(prop + drum-skin RGBA (= "#f4e6c6"))
(prop + clay RGBA (= "#cf7b4d"))
(prop + rope RGBA (= "#d2b88e"))
(prop + soot RGBA (= "#3b2719"))
(prop + cream RGBA (= "#fff7e4"))
(prop + grass RGBA (= "#8cc063"))
(prop + leaf RGBA (= "#5e9e48"))
(prop + bark RGBA (= "#7d573a"))
(prop + stone RGBA (= "#c0b097"))
(prop + water RGBA (= "#63bad9"))
(prop + foam RGBA (= "#e6f7fb"))
(prop + firefly RGBA (= "#ffe28a"))
(prop + hill-light _ (= (call Point -0.45 -0.9)))

(type + HillBrush
  (prop + canvas Canvas)
  (prop + night Float)
  (fn-do + This _
    (param canvas _)
    (param night _)
    (= (. canvas fill-paint) (call gouache-paint 0.35 1.2 0.45 2))
  )
  (fn-expr + ink RGBA
    (param color RGBA)
    (call RGBA
      (block
        (arg (* (. color red) (- 1 (* night 0.62))))
        (arg (* (. color green) (- 1 (* night 0.56))))
        (arg (* (. color blue) (- 1 (* night 0.34))))
        (arg (. color alpha))
      )
    )
  )
  (fn-do + fill _
    (param color RGBA)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call ink color))
  )
  (fn-do + tint _
    (param color RGBA)
    (param alpha Float)
    (call fill (call (. color with-alpha) alpha))
  )
  (fn-do + glow _
    (param color RGBA)
    (param alpha Float)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call (. color with-alpha) alpha))
  )
  (fn-do + stroke _
    (param color RGBA)
    (param width Float)
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) (call ink color))
    (= (. canvas stroke-width) width)
    (= (. canvas stroke-cap) (. LineCap round))
    (= (. canvas stroke-join) (. LineJoin round))
  )
  (fn-do + dot _
    (param center Point)
    (param radius Float)
    (call (. canvas circle) (. center x) (. center y) radius)
  )
  (fn-do + line _
    (param from Point)
    (param to Point)
    (call (. canvas line) from to)
  )
  (fn-do + trace _
    (param points (list Point))
    (param is-closed Bool)
    (let count (. points length))
    (let spans (if-expr is-closed count (- count 1)))
    (call (. canvas move) (. ([] points 0) x) (. ([] points 0) y))
    (for (in index (..< 0 spans))
      (let start ([] points index))
      (let end ([] points (% (+ index 1) count)))
      (let before (if-expr (or is-closed (> index 0)) ([] points (% (- (+ index count) 1) count)) start))
      (let after (if-expr (or is-closed (< (+ index 2) count)) ([] points (% (+ index 2) count)) end))
      (let first (+ start (/ (- end before) 6)))
      (let second (- end (/ (- after start) 6)))
      (call (. canvas curve) (. first x) (. first y) (. second x) (. second y) (. end x) (. end y))
    )
  )
  (fn-do + shape _
    (param points (list Point))
    (call (. canvas begin))
    (call trace points true)
    (call (. canvas end) true)
  )
  (fn-do + path _
    (param points (list Point))
    (call (. canvas begin))
    (call trace points false)
    (call (. canvas end))
  )
  (fn-do + quad _
    (param points (list Point))
    (param round Float)
    (let count (. points length))
    (call (. canvas begin))
    (for (in index (..< 0 count))
      (let corner ([] points index))
      (let back ([] points (% (- (+ index count) 1) count)))
      (let ahead ([] points (% (+ index 1) count)))
      (let enter (+ corner (* (- back corner) (/ (call min round (* (call (. corner distance) back) 0.45)) (call max 0.001 (call (. corner distance) back))))))
      (let leave (+ corner (* (- ahead corner) (/ (call min round (* (call (. corner distance) ahead) 0.45)) (call max 0.001 (call (. corner distance) ahead))))))
      (if (== index 0)
        (call (. canvas move) (. enter x) (. enter y))
        (else
          (call (. canvas line) (. enter x) (. enter y))
        )
      )
      (let first (+ enter (* (- corner enter) 0.55)))
      (let second (+ leave (* (- corner leave) 0.55)))
      (call (. canvas curve) (. first x) (. first y) (. second x) (. second y) (. leave x) (. leave y))
    )
    (call (. canvas end) true)
  )
  (fn-do + mass _
    (param points (list Point))
    (param color RGBA)
    (param shift Float)
    (call fill (call shade color))
    (call shape points)
    (call fill color)
    (call shape (call inset points shift))
  )
  (fn-do + block _
    (param points (list Point))
    (param color RGBA)
    (param shift Float)
    (param round Float)
    (call fill (call shade color))
    (call quad points round)
    (call fill color)
    (call quad (call inset points shift) round)
  )
  (fn-do + bar _
    (param from Point)
    (param to Point)
    (param width Float)
    (param color RGBA)
    (param round Float)
    (let side (* (call side-of from to) (/ width 2)))
    (call block (list (+ from side) (+ to side) (- to side) (- from side)) color (* width 0.18) round)
  )
  (fn-do + ball _
    (param center Point)
    (param rx Float)
    (param ry Float)
    (param color RGBA)
    (param seed Float)
    (call fill (call shade color))
    (call shape (call blob center rx ry seed 0.05))
    (call fill color)
    (call shape
      (block
        (arg
          (call blob
            (block
              (arg (+ center (call Point (* (. hill-light x) rx 0.16) (* (. hill-light y) ry 0.16))))
              (arg (* rx 0.84))
              (arg (* ry 0.84))
              (arg seed)
              (arg 0.05)
            )
          )
        )
      )
    )
  )
  (fn-do + taper _
    (param a Point)
    (param b Point)
    (param c Point)
    (param wa Float)
    (param wb Float)
    (param wc Float)
    (let na (call side-of a b))
    (let nb (call side-of a c))
    (let nc (call side-of b c))
    (call shape
      (list
        (+ a (* na (/ wa 2)))
        (+ b (* nb (/ wb 2)))
        (+ c (* nc (/ wc 2)))
        (+ c (* (call along b c) (* wc 0.4)))
        (- c (* nc (/ wc 2)))
        (- b (* nb (/ wb 2)))
        (- a (* na (/ wa 2)))
        (- a (* (call along a b) (* wa 0.4)))
      )
    )
  )
  (fn-do + tube _
    (param a Point)
    (param b Point)
    (param c Point)
    (param wa Float)
    (param wc Float)
    (param color RGBA)
    (let wb (/ (+ wa wc) 2))
    (call fill (call shade color))
    (call taper a b c wa wb wc)
    (let shift (* (call min wa wc) 0.2))
    (let nudge (* hill-light shift))
    (call fill color)
    (call taper (+ a nudge) (+ b nudge) (+ c nudge) (- wa (* shift 1.2)) (- wb (* shift 1.2)) (- wc (* shift 1.2)))
  )
  (fn-do + inset (list Point)
    (param points (list Point))
    (param shift Float)
    (let count (as (. points length) Float))
    (let middle (call Point 0 0))
    (for (in point points)
      (+= middle (/ point count))
    )
    (let reach 0.0)
    (for (in point points)
      (+= reach (/ (. (- point middle) length) count))
    )
    (let keep (call max 0.2 (- 1 (/ shift (call max 0.001 reach)))))
    (return (call (of List Point) (in (+ middle (* (- each middle) keep) (* hill-light shift)) points)))
  )
)

(fn-expr + shade RGBA
  (param color RGBA)
  (call RGBA
    (block
      (arg (* (+ gray (* (- (. color red) gray) 1.3)) 0.8))
      (arg (* (+ gray (* (- (. color green) gray) 1.3)) 0.79))
      (arg (* (+ gray (* (- (. color blue) gray) 1.3)) 0.82))
      (arg (. color alpha))
    )
  )
  (where
    (lazy gray (/ (+ (. color red) (. color green) (. color blue)) 3))
  )
)

(fn-expr + lit RGBA
  (param color RGBA)
  (call RGBA
    (block
      (arg (+ (. color red) (* (- 1 (. color red)) 0.34)))
      (arg (+ (. color green) (* (- 0.98 (. color green)) 0.32)))
      (arg (+ (. color blue) (* (- 0.88 (. color blue)) 0.24)))
      (arg (. color alpha))
    )
  )
)

(fn-expr + blob (list Point)
  (param center Point)
  (param rx Float)
  (param ry Float)
  (param seed Float)
  (param wobble Float)
  (call (of List Point) (in (+ center (* (call Point (* (call cos (* each (/ π 4))) rx) (* (call sin (* each (/ π 4))) ry)) (+ 1 (* wobble (call jitter seed (as each Float)))))) (..< 0 8)))
)

(fn-expr + jitter Float
  (param seed Float)
  (param index Float)
  (- (* (call hash seed index) 2) 1)
)

(fn-expr + hash Float
  (param a Float)
  (param b Float)
  (% (call abs (* (call sin (+ (* a 12.9898) (* b 78.233))) 43758.5453)) 1.0)
)

(fn-expr + side-of Point
  (param from Point)
  (param to Point)
  (/ (call Point (- (. delta y)) (. delta x)) (call max 0.0001 (. delta length)))
  (where
    (lazy delta (- to from))
  )
)

(fn-expr + along Point
  (param from Point)
  (param to Point)
  (/ (- to from) (call max 0.0001 (. (- to from) length)))
)
