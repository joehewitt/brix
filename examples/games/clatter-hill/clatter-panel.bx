(import ./clatter-art)
(import ./clatter-run)
(import ./clatter-scenery)
(import ./clatter-sound)
(import ./clatter-theme)
(import /graphics/canvas)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/circle-help)
(import /math)
(import /time/duration)
(blank)
(prop _ titlebar-height _ (= 32.0))

(type + ClatterPanel (is Box)
  (using ClatterTheme)
  (event + pauses Bool)
  (event + interruptions Bool)
  (event + returns Bool)
  (event + restarts Bool)
  (prop + run _ (= (call ClatterRun)))
  (prop + sound (? ClatterSound))
  (prop _ owner-window (of Ancestor Window))
  (prop _ is-window-active _ (= (?? (?. #owner-window #is-active) false)))
  (prop + phase _
    (machine
      (state running
        (then running (trigger on restarts)
          (do
            (call (. run reset))
            (call (?. sound hush))
          )
        )
        (blank)
        (state playing
          (finally
            (call (. run cancel))
          )
          (blank)
          (for (on tick frames)
            (call (. run play) (. tick delta))
            (call (?. sound roll) (. run rolling))
          )
          (blank)
          (then paused (trigger on pauses))
          (then away (trigger on interruptions))
        )
        (blank)
        (state paused
          (do
            (call (?. sound hush))
          )
          (blank)
          (then playing (trigger on pauses))
          (then playing (trigger on (. board wakes)))
        )
        (blank)
        (state away
          (do
            (call (?. sound hush))
          )
          (blank)
          (then playing (trigger on returns))
        )
      )
    )
  )
  (content
    (<> This (• clatter-panel)
      (<> ClatterSky (• clatter-backdrop))
      (<> ClatterWeather (• clatter-backdrop)
        (= run run)
      )
      (<> ClatterBackdrop (• clatter-backdrop))
      (<> ClatterBoard (id: board) (• clatter-board)
        (= run run)
        (= is-playing (is #phase .playing))
      )
      (<> IconButton (• icon-circle-help) (• clatter-help)
        (= action (=> () :do (call (. help toggle))))
        (<> Popover (id: help) (• w 300)
          (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint end) 6))
          (<> Label (text: "Clatter Hill") (• clatter-help-title))
          (<> Label (text: "Drag a piece onto the pegs to move it.") (• clatter-help-line))
          (<> Label (text: "Click a piece to turn it around.") (• clatter-help-line))
          (<> Label (text: "Take spares from the crate.") (• clatter-help-line))
          (<> Label (text: "Drop a piece off the hill to put it back.") (• clatter-help-line))
          (<> Label (text: "Grab a marble and toss it anywhere.") (• clatter-help-line))
          (<> Label (text: "Click the pot or press Space to pour.") (• clatter-help-line))
          (<> Label (text: "Higher pegs play higher notes.") (• clatter-help-line))
          (<> Label (text: "R rebuilds · M mutes · Esc pauses") (• clatter-help-keys))
        )
      )
      (if (is #phase .paused)
        (<> Label (text: "Paused") (• clatter-banner))
      )
      (blank)
      (<> KeyShortcut (text: "Pour")
        (= key .space)
        (= repeat false)
        (= enabled (is #phase .playing))
        (= action (=> () :do (call (. run burst))))
      )
      (<> KeyShortcut (text: "Pause")
        (= key .escape)
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Pause")
        (= key (char "p"))
        (= repeat false)
        (= action (=> () :do (<- pauses true)))
      )
      (<> KeyShortcut (text: "Rebuild")
        (= key (char "r"))
        (= repeat false)
        (= action (=> () :do (<- restarts true)))
      )
      (<> KeyShortcut (text: "Sound")
        (= key (char "m"))
        (= repeat false)
        (= action (=> () :do (call (?. sound toggle))))
      )
    )
  )
  (whenever-rule #is-window-active
    (if is-window-active
      (<- returns true)
      (else
        (<- interruptions true)
      )
    )
  )
  (subscribe-for (on note (. run notes))
    (call (?. sound play) note)
  )
)

(type + ClatterBoard (is Box)
  (using ClatterTheme)
  (event + wakes Bool)
  (prop + run ClatterRun)
  (prop + is-playing Bool)
  (prop _ clock _ (= (. #run #clock)))
  (depends invalidate-paint clock)
  (content
    (<> This
      (for (on event pointer-down)
        (if (and (== (. event button) (. PointerButton primary)) (>= (. event point y) titlebar-height))
          (call (. event cancel))
          (if is-playing
            (call (. run press) (call stage-point (. event point)))
            (else
              (<- wakes true)
            )
          )
        )
      )
      (for (on event pointer-drag)
        (if is-playing
          (call (. run drag) (call stage-point (. event point)))
        )
      )
      (for (on event pointer-up)
        (if (and is-playing (== (. event button) (. PointerButton primary)))
          (call (. event cancel))
          (if (. event is-interrupted)
            (call (. run cancel))
            (else
              (call (. run release) (call stage-point (. event point)))
            )
          )
        )
      )
    )
  )
  (fn-expr + stage-point Point
    (param point Point)
    (/ (- point (. stage-rect top-left)) (/ (. stage-rect width) (. clatter-stage-size width)))
    (where
      (lazy stage-rect (call stage-of content-bounds))
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect (call stage-of content-bounds))
    (return-if (if (<= (. stage-rect width) 0)))
    (do-use (. canvas saved-state)
      (call enter-stage canvas stage-rect)
      (call paint-clatter-run canvas run $clatter-night)
    )
  )
)

(type + ClatterSky (is Box)
  (using ClatterTheme)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect (call stage-of content-bounds))
    (return-if (if (<= (. stage-rect width) 0)))
    (do-use (. canvas saved-state)
      (call enter-stage canvas stage-rect)
      (call paint-clatter-sky canvas $clatter-night)
    )
  )
)

(type + ClatterWeather (is Box)
  (using ClatterTheme)
  (prop + run ClatterRun)
  (prop _ clock _ (= (. #run #clock)))
  (depends invalidate-paint clock)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect (call stage-of content-bounds))
    (return-if (if (<= (. stage-rect width) 0)))
    (do-use (. canvas saved-state)
      (call enter-stage canvas stage-rect)
      (call paint-clatter-weather canvas (as (. run clock) Float) $clatter-night)
    )
  )
)

(type + ClatterBackdrop (is Box)
  (using ClatterTheme)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let stage-rect (call stage-of content-bounds))
    (return-if (if (<= (. stage-rect width) 0)))
    (do-use (. canvas saved-state)
      (call enter-stage canvas stage-rect)
      (call paint-clatter-scenery canvas $clatter-night)
    )
  )
)

(fn-expr _ stage-of Rect
  (param bounds Rect)
  (call image-fit-rect clatter-stage-size bounds (. ImageFit contain) (. AnchorPoint center) (. AnchorPoint center))
)

(fn-do _ enter-stage _
  (param canvas Canvas)
  (param stage-rect Rect)
  (let scale (/ (. stage-rect width) (. clatter-stage-size width)))
  (call (. canvas translate) (. stage-rect x) (. stage-rect y))
  (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
  (call (. canvas clip) (call Rect clatter-stage-size))
)
