(import ./clatter-run)
(import /media/audio-output)
(import /media/mixer)
(import /media/synth)
(import /time/duration)
(import /units)
(blank)
(prop _ roll-control _ (= 0))
(prop _ scale _ (= (list 0st 2st 4st 7st 9st 12st 14st 16st 19st 21st)))

(fn-expr + clatter-sounds SoundBank
  (<> SoundBank
    (<> SoundPatch (text: "wood")
      (= min-gap 30ms)
      (= polyphony 10)
      (= pitch-spread 0.1st)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 523hz)
        (= attack 2ms)
        (= decay 320ms)
        (= fm-ratio 4)
        (= fm-depth 0.7)
        (= fm-depth-end 0)
        (= level 30%)
        (= reverb 22%)
      )
      (<> SoundLayer (• band-pass) (• white-noise)
        (= cutoff 1800hz)
        (= attack 1ms)
        (= decay 25ms)
        (= level 6%)
      )
    )
    (blank)
    (<> SoundPatch (text: "chime")
      (= min-gap 50ms)
      (= polyphony 8)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 1047hz)
        (= attack 2ms)
        (= decay 1800ms)
        (= fm-ratio 3.5)
        (= fm-depth 1.1)
        (= fm-depth-end 0.1)
        (= level 15%)
        (= reverb 42%)
        (= echoes 1)
        (= echo-gap 210ms)
        (= echo-level 25%)
      )
    )
    (blank)
    (<> SoundPatch (text: "drum")
      (= min-gap 50ms)
      (= polyphony 6)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 196hz)
        (= pitch-end 120hz)
        (= glide 140ms)
        (= attack 2ms)
        (= decay 420ms)
        (= level 48%)
        (= reverb 20%)
      )
      (<> SoundLayer (• low-pass) (• white-noise)
        (= cutoff 1400hz)
        (= attack 1ms)
        (= decay 60ms)
        (= level 10%)
      )
    )
    (blank)
    (<> SoundPatch (text: "clack")
      (= min-gap 40ms)
      (= polyphony 6)
      (blank)
      (<> SoundLayer (• triangle)
        (= pitch 784hz)
        (= attack 1ms)
        (= decay 80ms)
        (= level 22%)
        (= reverb 18%)
      )
      (<> SoundLayer (• band-pass) (• white-noise)
        (= cutoff 2600hz)
        (= attack 1ms)
        (= decay 35ms)
        (= level 10%)
      )
    )
    (blank)
    (<> SoundPatch (text: "click")
      (= min-gap 25ms)
      (= polyphony 8)
      (= pitch-spread 0.4st)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 2093hz)
        (= attack 1ms)
        (= decay 70ms)
        (= fm-ratio 2.7)
        (= fm-depth 0.8)
        (= level 9%)
        (= reverb 30%)
      )
    )
    (blank)
    (<> SoundPatch (text: "plop")
      (= min-gap 40ms)
      (= polyphony 6)
      (= pitch-spread 1st)
      (blank)
      (<> SoundLayer (• sine)
        (= pitch 330hz)
        (= pitch-end 880hz)
        (= glide 70ms)
        (= attack 2ms)
        (= decay 140ms)
        (= level 26%)
        (= reverb 35%)
      )
    )
    (blank)
    (<> SoundPatch (text: "tick")
      (= min-gap 60ms)
      (= polyphony 3)
      (blank)
      (<> SoundLayer (• triangle)
        (= pitch 262hz)
        (= attack 1ms)
        (= decay 110ms)
        (= level 12%)
        (= reverb 20%)
      )
    )
    (blank)
    (<> SoundPatch (text: "roll")
      (= polyphony 1)
      (blank)
      (<> SoundLayer (• brown-noise) (• band-pass) (• sustained)
        (= cutoff 700hz)
        (= attack 200ms)
        (= release 400ms)
        (= level 40%)
        (= reverb 10%)
        (= level-control roll-control)
      )
    )
    (blank)
    (<> SoundPatch (text: "brook")
      (= polyphony 1)
      (blank)
      (<> SoundLayer (• pink-noise) (• low-pass) (• sustained)
        (= cutoff 1100hz)
        (= attack 1500ms)
        (= release 600ms)
        (= level 5%)
        (= tremolo-rate 0.4hz)
        (= tremolo-depth 35%)
        (= reverb 30%)
      )
    )
  )
)

(type + ClatterSound
  (implements Closable)
  (prop + is-muted Bool)
  (prop + is-unavailable Bool)
  (prop + mixer Mixer)
  (prop _ output (? AudioOutput))
  (prop _ is-flowing Bool)
  (fn-do + This _
    (param bank SoundBank)
    (lazy mixer (call Mixer bank))
  )
  (fn-do + play _
    (param note ClatterNote)
    (return-if (if (or is-muted (not (call is-open)))))
    (blank)
    (let pitch (call pitch-ratio ([] scale (% (. note degree) (. scale length)))))
    (call (. mixer play) (call patch (. note tone name)) (. note strength) (. note pan) pitch)
  )
  (fn-do + roll _
    (param level Float)
    (return-if (if (or is-muted (not (call is-open)))))
    (blank)
    (if (not is-flowing)
      (call (. mixer play) (call patch "roll"))
      (call (. mixer play) (call patch "brook"))
      (= is-flowing true)
    )
    (call (. mixer control) roll-control level)
  )
  (fn-do + toggle _
    (= is-muted (not is-muted))
    (call (. mixer set-volume) (if-expr is-muted 0 1))
    (call hush)
  )
  (fn-do + hush _
    (call (. mixer hush))
    (= is-flowing false)
  )
  (fn-expr _ patch Size
    (param name String)
    (!! (call (. mixer bank find) name))
  )
  (fn-do _ is-open Bool
    (return-if false (if is-unavailable))
    (return-if true (if output))
    (blank)
    (= output
      (call AudioOutput mixer
        (block
          (on-error (: problem Error)
            (= is-unavailable true)
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do + close _
    (call (?. output close))
    (= output null)
    (call (. mixer cues close))
  )
)
