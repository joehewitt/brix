(import ./clatter-brush)
(import ./clatter-run)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ marble-hues (list RGBA) (= (list "#e8604f" "#3d8fdc" "#5fb84c")))
(prop _ marble-swirls (list RGBA) (= (list "#ffe2bd" "#dff6ff" "#f4f290")))
(prop _ pail RGBA (= "#c98c52"))
(prop _ shadow-offset _ (= (call Point 4 7)))
(prop _ lifted-offset _ (= (call Point 13 20)))
(prop _ jar-points (list Point) (= (list (call Point -28 6) (call Point 28 6) (call Point 24 55) (call Point -24 55))))
(prop _ pot-spots (list Point)
  (=
    (call List
      (block
        (item (call Point -22.5 -30))
        (item (call Point -7.5 -30))
        (item (call Point 7.5 -30))
        (item (call Point 22.5 -30))
        (item (call Point -15 -36))
        (item (call Point 0 -36))
        (item (call Point 15 -36))
      )
    )
  )
)

(fn-do + paint-clatter-run _
  (param canvas Canvas)
  (param run ClatterRun)
  (param night Float)
  (call (. (call RunPainter (call HillBrush canvas night) run) paint))
)

(type _ RunPainter
  (prop + b HillBrush)
  (prop + run ClatterRun)
  (prop _ clock Float)
  (fn-do + This _
    (param b _)
    (param run _)
    (= clock (as (. run clock) Float))
  )
  (fn-expr _ canvas Canvas :get
    (. b canvas)
  )
  (fn-do + paint _
    (call paint-pulley)
    (call paint-buckets)
    (call paint-pot)
    (call paint-crate)
    (call paint-shadows)
    (for (in piece (. run pieces) (when (. piece is-solid)))
      (call paint-piece piece (. piece center) 1.0)
    )
    (call paint-ghost)
    (for (in marble (. run marbles) (when (is (. marble mode) .rolling)))
      (call paint-marble marble 0)
    )
    (for (in piece (. run pieces) (when (and (. piece is-solid) (is (. piece kind) .cup))))
      (call paint-jar-front piece (. piece center) 1.0)
    )
    (call paint-stream)
    (let piece (. run held-piece))
    (if (and piece (. piece lifted))
      (call (. canvas begin-opacity) 0.16)
      (call paint-silhouette piece (+ (. piece center) lifted-offset) 1.06)
      (call (. canvas end-opacity))
      (call paint-piece piece (. piece center) 1.06)
      (if (is (. piece kind) .cup)
        (call paint-jar-front piece (. piece center) 1.06)
      )
    )
    (let marble (. run held-marble))
    (if (and marble (is (. marble mode) .held))
      (call paint-marble marble 9)
    )
    (if (> (. b night) 0.5)
      (call paint-fireflies)
    )
  )
  (fn-do _ paint-pulley _
    (let center (call Point lift-x lift-top))
    (let turn (/ (. run lift) 13))
    (call (. b ball) center 13 13 oak 3)
    (call (. b stroke) (call shade oak) 2)
    (call (. b dot) center 9)
    (for (in index (..< 0 4))
      (let way (call Point (call cos (+ turn (* index (/ π 2)))) (call sin (+ turn (* index (/ π 2))))))
      (call (. b line) (+ center (* way 3.5)) (+ center (* way 8.5)))
    )
    (call (. b ball) center 3.6 3.6 brass 1)
  )
  (fn-do _ paint-buckets _
    (for (in index (..< 0 bucket-count))
      (let spot (call (. run bucket-point) index))
      (let fade (call clamp (/ (- (. spot y) lift-top) 26) 0.0 1.0))
      (if (> fade 0.02)
        (if (< fade 1)
          (call (. canvas begin-opacity) fade)
        )
        (call paint-pail spot ([] (. run loads) index))
        (if (< fade 1)
          (call (. canvas end-opacity))
        )
      )
    )
  )
  (fn-do _ paint-pail _
    (param spot Point)
    (param load (? Marble))
    (call (. b stroke) (call shade tin) 1.6)
    (call (. b path)
      (block
        (arg
          (call List
            (block
              (item (+ spot (call Point -12 -4)))
              (item (+ spot (call Point -8 -18)))
              (item (+ spot (call Point 0 -24)))
              (item (+ spot (call Point 8 -18)))
              (item (+ spot (call Point 12 -4)))
            )
          )
        )
      )
    )
    (call (. b fill) (call shade (call shade pail)))
    (call (. canvas oval) (call Rect (- (. spot x) 12) (- (. spot y) 9) 24 6))
    (if load
      (call paint-glass (. load place) (. load hue) (. load spin) marble-radius)
    )
    (call (. b block)
      (block
        (arg
          (call List
            (block
              (item (+ spot (call Point -12.5 -6)))
              (item (+ spot (call Point 12.5 -6)))
              (item (+ spot (call Point 9.5 10)))
              (item (+ spot (call Point -9.5 10)))
            )
          )
        )
        (arg pail)
        (arg 2)
        (arg 2.5)
      )
    )
    (call (. b stroke) (call (. (call shade pail) with-alpha) 0.6) 1)
    (call (. b line) (+ spot (call Point -4 -4)) (+ spot (call Point -3 8)))
    (call (. b line) (+ spot (call Point 4 -4)) (+ spot (call Point 3 8)))
    (call (. b bar) (+ spot (call Point -12.2 -3.5)) (+ spot (call Point 12.2 -3.5)) 2.6 tin 1)
    (call (. b bar) (+ spot (call Point -10.2 6)) (+ spot (call Point 10.2 6)) 2.6 tin 1)
  )
  (fn-do _ paint-pot _
    (let at hopper-point)
    (for (in index (..< 0 (call min (. pot-spots length) (. run hopper length))))
      (let marble ([] (. run hopper) index))
      (call paint-glass (+ at ([] pot-spots index)) (. marble hue) (. marble spin) 8)
    )
    (call (. b block)
      (block
        (arg (list (+ at (call Point -41 -30)) (+ at (call Point 41 -30)) (+ at (call Point 38 -22)) (+ at (call Point -38 -22))))
        (arg clay)
        (arg 1.5)
        (arg 3)
      )
    )
    (call (. b stroke) (call (. (call lit clay) with-alpha) 0.8) 1.4)
    (call (. b line) (+ at (call Point -35 -28.5)) (+ at (call Point 35 -28.5)))
  )
  (fn-do _ paint-crate _
    (let at crate-point)
    (for (in piece (. run pieces) (when (and (not (. piece is-placed)) (not (. piece lifted)))))
      (call paint-piece piece (. piece center) 0.5)
      (if (is (. piece kind) .cup)
        (call paint-jar-front piece (. piece center) 0.5)
      )
    )
    (call plank (+ at (call Point -106 1)) (+ at (call Point 106 1)) 14 oak)
    (call plank (+ at (call Point -106 17)) (+ at (call Point 106 17)) 14 (call shade (call lit oak)))
    (for (in side (list -104.0 104.0))
      (call (. b block)
        (block
          (arg
            (call List
              (block
                (item (+ at (call Point (- side 7) -9)))
                (item (+ at (call Point (+ side 7) -9)))
                (item (+ at (call Point (+ side 7) 26)))
                (item (+ at (call Point (- side 7) 26)))
              )
            )
          )
          (arg (call shade oak))
          (arg 2)
          (arg 2)
        )
      )
      (call nail (+ at (call Point side -2)))
      (call nail (+ at (call Point side 18)))
    )
    (for (in index (..< 0 3))
      (call (. b ball) (+ at (call Point (* (- index 1) 13.0) 1)) 4 4 ([] marble-hues index) (as index Float))
    )
  )
  (fn-do _ paint-shadows _
    (call (. canvas begin-opacity) 0.2)
    (for (in piece (. run pieces) (when (. piece is-solid)))
      (call paint-silhouette piece (+ (. piece center) shadow-offset) 1.0)
    )
    (call (. canvas end-opacity))
  )
  (fn-do _ paint-silhouette _
    (param piece ClatterPiece)
    (param center Point)
    (param scale Float)
    (let facing (. piece facing))
    (call (. b fill) soot)
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. center x) (. center y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (if (is (. piece kind) .seesaw)
        (call (. b quad) (list (call Point 0 -3) (call Point 21 30) (call Point -21 30)) 4)
      )
      (call (. canvas transform) (call matrix-from-rotation (as (. piece tilt) Radians) (call Point 0 0)))
      (if (is (. piece kind) .ramp)
        (call (. b quad) (call slab (call Point -88 (* -14 facing)) (call Point 88 (* 14 facing)) 12) 5)
        (call (. b quad) (call slab (call Point (* -86 facing) -4) (call Point (* -86 facing) -55) 10) 4)
        (else-if (is (. piece kind) .chime)
          (call (. b quad) (call slab (call Point -52 (* -6 facing)) (call Point 52 (* 6 facing)) 11) 5)
        )
        (else-if (is (. piece kind) .seesaw)
          (call (. b quad) (call slab (call Point -87 0) (call Point 87 0) 13) 5)
        )
        (else-if (is (. piece kind) .cup)
          (call (. b quad) jar-points 7)
        )
        (else
          (call (. canvas transform) (call matrix-from-rotation (as (call atan (/ (* 5 facing) 46.0)) Radians) (call Point 0 0)))
          (call (. b quad) (list (call Point -47 -7) (call Point 47 -7) (call Point 47 29) (call Point -47 29)) 6)
        )
      )
    )
  )
  (fn-do _ paint-piece _
    (param piece ClatterPiece)
    (param center Point)
    (param scale Float)
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. center x) (. center y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (if (is (. piece kind) .seesaw)
        (call paint-stand)
      )
      (call (. canvas transform) (call matrix-from-rotation (as (. piece tilt) Radians) (call Point 0 0)))
      (if (is (. piece kind) .ramp)
        (call paint-ramp (. piece facing))
        (else-if (is (. piece kind) .chime)
          (call paint-chime piece)
        )
        (else-if (is (. piece kind) .seesaw)
          (call paint-seesaw)
        )
        (else-if (is (. piece kind) .cup)
          (call paint-jar)
        )
        (else
          (call paint-drum piece)
        )
      )
    )
  )
  (fn-do _ paint-ramp _
    (param facing Float)
    (let post (* -86 facing))
    (call plank (call Point post -4) (call Point post -50) 9 oak)
    (call (. b ball) (call Point post -51) 6 3.6 (call shade oak) 2)
    (call plank (call Point -86 (* -14 facing)) (call Point 86 (* 14 facing)) 12 oak)
    (call screw (call Point -60 (* -60 (/ (* 14 facing) 86))))
    (call screw (call Point 60 (* 60 (/ (* 14 facing) 86))))
  )
  (fn-do _ paint-chime _
    (param piece ClatterPiece)
    (let facing (. piece facing))
    (let wobble (. piece wobble))
    (let shake (* (call sin (* clock 42)) wobble 2.5))
    (let left (call Point -50 (+ (* -6 facing) shake)))
    (let right (call Point 50 (- (* 6 facing) shake)))
    (for (in x (list -30.0 30.0))
      (let y (+ (. left y) (* (- (. right y) (. left y)) (/ (+ x 50) 100))))
      (call (. b bar) (call Point x -9) (call Point x y) 5 tin 2)
      (call nail (call Point x -6))
    )
    (if (> wobble 0.05)
      (call (. b glow) brass (* wobble 0.3))
      (call (. b quad) (call slab left right (+ 12 (* 14 wobble))) 12)
    )
    (call (. b bar) left right 11 brass 5)
    (call (. b stroke) (call (. cream with-alpha) (+ 0.55 (* wobble 0.4))) 2)
    (call (. b line) (+ left (call Point 10 -2.6)) (+ (* (+ left right) 0.5) (call Point 4 -2.6)))
    (call (. b stroke) (call shade brass) 1.6)
    (for (in place (list 0.13 0.87))
      (let spot (+ left (* (- right left) place)))
      (call (. b line) (+ spot (call Point 0 -4.6)) (+ spot (call Point 0 4.6)))
    )
    (call (. b ball) left 2.4 5 (call shade brass) 1)
    (call (. b ball) right 2.4 5 (call shade brass) 2)
  )
  (fn-do _ paint-stand _
    (call plank (call Point -16 27) (call Point 0 0) 6 oak)
    (call plank (call Point 0 0) (call Point 16 27) 6 oak)
    (call plank (call Point -21 28) (call Point 21 28) 5 (call shade oak))
  )
  (fn-do _ paint-seesaw _
    (call plank (call Point -86 0) (call Point 86 0) 13 paint-red)
    (call (. b fill) cream)
    (for (in x (list -77.0 -68.0 62.0 71.0))
      (call (. b quad) (list (call Point x -4.4) (call Point (+ x 5) -4.4) (call Point (+ x 5) 4) (call Point x 4)) 1)
    )
    (call (. b ball) (call Point 0 0) 7.5 7.5 oak 3)
    (call (. b ball) (call Point 0 0) 3.4 3.4 brass 1)
  )
  (fn-do _ paint-jar _
    (call (. b stroke) tin 2)
    (call (. b path) (list (call Point -28 9) (call Point -20 -3) (call Point 0 -6) (call Point 20 -3) (call Point 28 9)))
    (call (. b stroke) (call shade brass) 1.6)
    (call (. b dot) (call Point 0 0) 3.4)
    (call (. b tint) glass 0.36)
    (call (. b quad) jar-points 7)
    (call (. b tint) (call shade glass) 0.3)
    (call (. b quad) (list (call Point -24 34) (call Point 24 34) (call Point 22.5 53) (call Point -22.5 53)) 5)
  )
  (fn-do _ paint-jar-front _
    (param piece ClatterPiece)
    (param center Point)
    (param scale Float)
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. center x) (. center y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (call (. canvas transform) (call matrix-from-rotation (as (. piece tilt) Radians) (call Point 0 0)))
      (call (. b tint) glass 0.5)
      (call (. b quad) (list (call Point -24 48) (call Point 24 48) (call Point 24 55) (call Point -24 55)) 3)
      (call (. b stroke) (call (. (call shade glass) with-alpha) 0.9) 2)
      (call (. b quad) jar-points 7)
      (call (. b stroke) (call (. cream with-alpha) 0.75) 3)
      (call (. b line) (call Point -20 15) (call Point -17.5 45))
      (call (. b stroke) (call (. cream with-alpha) 0.5) 2)
      (call (. b line) (call Point 18.5 15) (call Point 17.5 23))
      (call plank (call Point -30 7) (call Point 30 7) 6 tin)
    )
  )
  (fn-do _ paint-drum _
    (param piece ClatterPiece)
    (let facing (. piece facing))
    (let thump (* (call sin (* clock 55)) (. piece wobble) 2))
    (call (. canvas transform) (call matrix-from-rotation (as (call atan (/ (* 5 facing) 46.0)) Radians) (call Point 0 0)))
    (call (. b block) (list (call Point -44 2) (call Point 44 2) (call Point 44 26) (call Point -44 26)) drum-blue 3 3)
    (call (. b tint) soot 0.16)
    (call (. b quad) (list (call Point -43 17) (call Point 43 17) (call Point 43 25) (call Point -43 25)) 2)
    (call (. b tint) cream 0.2)
    (call (. b quad) (list (call Point -40 6) (call Point 40 6) (call Point 40 9) (call Point -40 9)) 1.5)
    (call (. b stroke) drum-skin 1.5)
    (for (in index (..< 0 8))
      (let x (+ -40 (* index 10.0)))
      (call (. b line) (call Point x 6) (call Point (+ x 5) 21))
      (call (. b line) (call Point (+ x 5) 21) (call Point (+ x 10) 6))
    )
    (for (in index (..< 0 8))
      (call (. b block)
        (block
          (arg
            (call List
              (block
                (item (call Point (+ -37.5 (* index 10.0)) 19))
                (item (call Point (+ -32.5 (* index 10.0)) 19))
                (item (call Point (+ -32.5 (* index 10.0)) 24))
                (item (call Point (+ -37.5 (* index 10.0)) 24))
              )
            )
          )
          (arg oak)
          (arg 0.6)
          (arg 1)
        )
      )
    )
    (call plank (call Point -46 3) (call Point 46 3) 5.5 oak)
    (call plank (call Point -46 25) (call Point 46 25) 5.5 oak)
    (call (. b ball) (call Point 0 (- -1 (* thump 0.5))) 45 (+ 5 (* thump 0.5)) drum-skin 2)
    (call (. b tint) soot 0.1)
    (call (. canvas oval) (call Rect -12 (- -3 (* thump 0.5)) 24 4))
  )
  (fn-do _ paint-ghost _
    (let piece (. run held-piece))
    (let spot (. run drop-spot))
    (return-if (if (or (not piece) (not spot))))
    (blank)
    (let center (+ (call peg-point (. spot column) (. spot row)) (call Point (* 30.0 (- (. piece span) 1)) 0)))
    (call (. canvas begin-opacity) 0.4)
    (call paint-piece piece center 1.0)
    (if (is (. piece kind) .cup)
      (call paint-jar-front piece center 1.0)
    )
    (call (. canvas end-opacity))
  )
  (fn-do _ paint-marble _
    (param marble Marble)
    (param height Float)
    (let spot (. marble place))
    (call (. b tint) soot (if-expr (> height 0) 0.15 0.22))
    (call (. b dot) (+ spot (call Point (+ 2.5 height) (+ 4 (* height 1.5)))) (* marble-radius 0.95))
    (call paint-glass spot (. marble hue) (. marble spin) marble-radius)
  )
  (fn-do _ paint-glass _
    (param spot Point)
    (param hue Int)
    (param spin Float)
    (param radius Float)
    (let color ([] marble-hues (% hue (. marble-hues length))))
    (let swirl ([] marble-swirls (% hue (. marble-swirls length))))
    (if (> (. b night) 0.5)
      (call (. b glow) color 0.18)
      (call (. b dot) spot (* radius 1.8))
    )
    (call (. b fill) (call shade color))
    (call (. b dot) spot radius)
    (call (. b fill) color)
    (call (. b dot) (+ spot (* hill-light (* radius 0.1))) (* radius 0.87))
    (call (. b tint) swirl 0.8)
    (call (. b taper)
      (block
        (arg (+ spot (call turned (call Point (* radius -0.62) (* radius 0.12)) spin)))
        (arg (+ spot (call turned (call Point 0 (* radius -0.18)) spin)))
        (arg (+ spot (call turned (call Point (* radius 0.6) (* radius 0.2)) spin)))
        (arg (* radius 0.08))
        (arg (* radius 0.3))
        (arg (* radius 0.06))
      )
    )
    (call (. b tint) swirl 0.45)
    (call (. b taper)
      (block
        (arg (+ spot (call turned (call Point (* radius -0.4) (* radius 0.45)) spin)))
        (arg (+ spot (call turned (call Point (* radius 0.05) (* radius 0.3)) spin)))
        (arg (+ spot (call turned (call Point (* radius 0.45) (* radius 0.5)) spin)))
        (arg (* radius 0.05))
        (arg (* radius 0.16))
        (arg (* radius 0.04))
      )
    )
    (call (. b tint) (call lit color) 0.75)
    (call (. b taper)
      (block
        (arg (+ spot (call Point (* radius 0.62) (* radius 0.12))))
        (arg (+ spot (call Point (* radius 0.42) (* radius 0.5))))
        (arg (+ spot (call Point (* radius 0.02) (* radius 0.66))))
        (arg (* radius 0.04))
        (arg (* radius 0.2))
        (arg (* radius 0.04))
      )
    )
    (call (. b tint) cream 0.95)
    (call (. b shape) (call blob (+ spot (call Point (* radius -0.36) (* radius -0.4))) (* radius 0.24) (* radius 0.17) 1 0))
    (call (. b tint) cream 0.6)
    (call (. b dot) (+ spot (call Point (* radius 0.2) (* radius -0.58))) (* radius 0.08))
  )
  (fn-do _ paint-stream _
    (call paint-waterwheel)
    (for (in marble (. run marbles) (when (is (. marble mode) .floating)))
      (call paint-glass (. marble place) (. marble hue) (. marble spin) marble-radius)
    )
    (let surface
      (call (of List Point)
        (block
          (arg (in (call Point (- (* each 40.0) 40) (+ water-line -1 (* 1.6 (call sin (+ (* each 0.9) (* clock 2.4)))))) (..< 0 33)))
        )
      )
    )
    (call (. b tint) water 0.52)
    (call (. canvas begin))
    (call (. b trace) surface false)
    (call (. canvas line) 1240 800)
    (call (. canvas line) -40 800)
    (call (. canvas end) true)
    (call (. b stroke) (call (. (call shade water) with-alpha) 0.3) 1.5)
    (call (. b path) (call (of List Point) (in (+ each (call Point 0 5)) surface)))
    (call (. b stroke) (call (. foam with-alpha) 0.85) 2.2)
    (call (. b path) surface)
    (call (. b stroke) (call (. foam with-alpha) 0.35) 1.6)
    (for (in index (..< 0 22))
      (let drift (- (% (- (* index 97.0) (* clock 60)) 1300) 50))
      (let x (if-expr (< drift -50) (+ drift 1300) drift))
      (let y (+ water-line 13 (* (% index 5) 12.0)))
      (call (. b line) (call Point x y) (call Point (+ x 14 (* (% index 3) 8.0)) y))
    )
    (call (. b stroke) (call (. foam with-alpha) 0.5) 1.2)
    (for (in marble (. run marbles) (when (is (. marble mode) .floating)))
      (call (. canvas oval) (call Rect (- (. marble place x) 15) (+ water-line 1) 30 6))
    )
    (call (. b tint) foam 0.85)
    (for (in index (..< 0 6))
      (let phase (% (+ (* clock 1.6) (* index 0.37)) 1.0))
      (call (. b dot)
        (block
          (arg (call Point (+ lift-x 26 (* 12 phase) (* index 2.0)) (- water-line 2 (* 14 (call sin (* phase π))))))
          (arg (+ 0.8 (* 1.8 (- 1 phase))))
        )
      )
    )
  )
  (fn-do _ paint-waterwheel _
    (let center (call Point lift-x (- water-line 6)))
    (let turn (/ (. run lift) -34))
    (for (in index (..< 0 8))
      (let way (call Point (call cos (+ turn (* index (/ π 4)))) (call sin (+ turn (* index (/ π 4))))))
      (call (. b bar) (+ center (* way 7)) (+ center (* way 30)) 4 (call shade oak) 1.5)
    )
    (call (. b stroke) (call shade oak) 5)
    (call (. b dot) center 26)
    (call (. b stroke) oak 2.5)
    (call (. b dot) center 25.5)
    (for (in index (..< 0 8))
      (let way (call Point (call cos (+ turn (* index (/ π 4)))) (call sin (+ turn (* index (/ π 4))))))
      (call (. b bar) (+ center (* way 20)) (+ center (* way 40)) 11 oak 2)
    )
    (call (. b ball) center 8 8 oak 3)
    (call (. b ball) center 3.5 3.5 brass 1)
  )
  (fn-do _ paint-fireflies _
    (for (in index (..< 0 12))
      (let spot
        (call Point
          (block
            (arg (+ 200 (* index 80.0) (* 26 (call sin (+ (* clock 0.6) index)))))
            (arg (+ 110 (* 30 (call sin (+ (* clock 0.45) (* index 1.7))))))
          )
        )
      )
      (let pulse (+ 0.3 (* 0.7 (call max 0.0 (call sin (+ (* clock 2.1) (* index 2.3)))))))
      (call (. b glow) firefly (* pulse 0.16))
      (call (. b dot) spot 9)
      (call (. b glow) firefly (* pulse 0.35))
      (call (. b dot) spot 4)
      (call (. b glow) cream pulse)
      (call (. b dot) spot 1.8)
    )
  )
  (fn-do _ plank _
    (param from Point)
    (param to Point)
    (param width Float)
    (param color RGBA)
    (let way (call along from to))
    (let length (call (. from distance) to))
    (let up (* (call side-of from to) (/ width -2)))
    (call (. b bar) from to width color (* width 0.3))
    (call (. b stroke) (call (. (call lit color) with-alpha) 0.85) (* width 0.14))
    (call (. b line) (+ from (* way (* width 0.5)) (* up 0.6)) (- (+ to (* up 0.6)) (* way (* width 0.5))))
    (call (. b stroke) (call (. (call shade color) with-alpha) 0.45) 0.9)
    (call (. b line) (+ from (* way (* length 0.1)) (* up 0.12)) (+ from (* way (* length 0.52)) (* up 0.12)))
    (call (. b line) (+ from (* way (* length 0.4)) (* up -0.32)) (+ from (* way (* length 0.86)) (* up -0.32)))
  )
  (fn-do _ screw _
    (param spot Point)
    (call (. b ball) spot 2.6 2.6 brass 1)
    (call (. b stroke) (call shade brass) 0.8)
    (call (. b line) (+ spot (call Point -1.6 1)) (+ spot (call Point 1.6 -1)))
  )
  (fn-do _ nail _
    (param spot Point)
    (call (. b fill) soot)
    (call (. b dot) spot 1.6)
    (call (. b tint) cream 0.6)
    (call (. b dot) (+ spot (call Point -0.5 -0.6)) 0.6)
  )
)

(fn-expr _ slab (list Point)
  (param from Point)
  (param to Point)
  (param width Float)
  (list (+ from side) (+ to side) (- to side) (- from side))
  (where
    (lazy side (* (call side-of from to) (/ width 2)))
  )
)
