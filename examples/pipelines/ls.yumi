
/core/patterns
/os/file
/os/process

** use Process("ls")
    - "-la"
~> \total-line? entry \ls-entry
    entry

    .. total-line ~
        ~ "total" // \num'I64 \nl

    .. ls-entry ~
        ~ access \ls-access // ownership \ls-ownership // details \ls-details // name \ls-name \nl?
            "$access $ownership $details $name"

    .. ls-access ~
        ~ permissions \ls-word // links \num'I64
            "$permissions $links"

    .. ls-ownership ~
        ~ owner \ls-word // group \ls-word
            "$owner $group"

    .. ls-details ~
        ~ size \num'I64 // month \ls-word // day \num'I64 // modified \ls-word
            "$size $month $day $modified"

    .. ls-word ~
        ~ (!\ws .)+

    .. ls-name ~
        ~ (!\nl .)+
|> print-all
