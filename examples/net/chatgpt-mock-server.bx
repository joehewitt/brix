; A stand-in for the OpenAI chat completions API, served on a port for any client: curl, a
; browser, or chatgpt.bx with OPENAI_BASE_URL set to http://localhost:8787/v1. HOST and PORT
; choose where it listens, MOCK_DELAY_MS the pause between streamed chunks, and
; MOCK_CHATGPT_API_KEY, when set, the bearer token it requires.
(import ./chatgpt-mock)
(import /net/dns)
(import /os/env)
(import /time/duration)
(blank)

(main
  (let delay (as (?? (call env "MOCK_DELAY_MS") "25") Milliseconds))
  (let port (as (?? (call env "PORT") "8787") Port))
  (let server (call mock-chatgpt-server (?? (call env "HOST") "localhost") port delay (?? (call env "MOCK_CHATGPT_API_KEY") "")))
  (call (. server start))
  (print (str "Mock ChatGPT server on http://" (. server host) ":" (. server port) ", chat completions at http://localhost:" (. server port) completions-path ", " delay "ms between chunks"))
  (call (. server run))
)
