(import /data/json)
(import /net/dns)
(import /net/http)
(import /net/http-server)
(import /net/sse)
(import /os/env)
(import /stream/aggregate)
(import /time/clock)
(import /time/duration)
(blank)
(prop _ completions-path _ (= "/v1/chat/completions"))
(blank)

(main
  (<> HTTPServer (id: server)
    (= service mock)
    (= host (?? (call env "HOST") "localhost"))
    (= port (as (?? (call env "PORT") "8787") Port))
    (= max-body-size 1000000)
    (blank)
    (<> Route (text: "/health")
      (= get (. mock health))
    )
    (blank)
    (<> Route (text: completions-path)
      (= post (. mock complete))
    )
  )
  (blank)
  (lazy mock (call MockChatGPT delay key))
  (lazy delay (as (?? (call env "MOCK_DELAY_MS") "25") Milliseconds))
  (lazy key (?? (call env "MOCK_CHATGPT_API_KEY") ""))
  (blank)
  (call (. server start))
  (print (str "Mock ChatGPT server on http://" (. server host) ":" (. server port) ", chat completions at http://localhost:" (. server port) completions-path ", " delay "ms between chunks"))
  (call (. server run))
)

(type + MockChatGPT (is HTTPService)
  (prop + delay Milliseconds)
  (prop + key String)
  (prop _ served Int)
  (fn-do + This _
    (param delay _)
    (param key _)
  )
  (fn-do + respond HTTPResponse (?! Error)
    (param request HTTPRequest)
    (return-if (call preflight) (if (== (. request method) (. HTTPMethod options))))
    (blank)
    (let response (call (. super respond) request))
    (return
      (match (. response status)
        (case= (. HTTPStatus not-found)
          (call refuse (call Refusal (. HTTPStatus not-found) (str "No mock route for " (. request method) " " (. request path))))
        )
        (case= (. HTTPStatus method-not-allowed)
          (call refuse (call Refusal (. HTTPStatus method-not-allowed) (str "Only " (. (!! (. request route)) allowed-methods) " is supported for " (. request path))))
        )
        (default
          response
        )
      )
    )
  )
  (fn-expr + health HTTPResponse
    (param request HTTPRequest)
    (call json-response (. HTTPStatus ok) payload)
    (where
      (lazy payload
        (call (of Map String JSON)
          (block
            (entry "ok" true)
            (entry "server" "brix-chatgpt-mock")
          )
        )
      )
    )
  )
  (fn-expr + complete HTTPResponse (?! Error)
    (param request HTTPRequest)
    (match (catch (call read-chat request (. request text)))
      (case (: refusal Refusal)
        (call refuse refusal)
      )
      (case (: chat ChatRequest)
        (call answer chat)
      )
    )
  )
  (fn-expr _ read-chat ChatRequest (?! Refusal)
    (param request HTTPRequest)
    (param text String)
    (before
      (throw (call Refusal (. HTTPStatus unauthorized) "Missing Authorization bearer token" "authentication_error") (if (not (call (. authorization starts-with) "Bearer "))))
      (throw (call Refusal (. HTTPStatus unauthorized) "Authorization bearer token did not match MOCK_CHATGPT_API_KEY" "authentication_error") (if (and (!= key "") (!= authorization (str "Bearer " key)))))
      (throw (call Refusal (. HTTPStatus unsupported-media-type) "Content-Type must be application/json") (if (not (call (. content-type find) "application/json"))))
    )
    (call chat-request body)
    (where
      (lazy content-type (?? (call (. request header) "Content-Type") ""))
      (lazy body
        (call parse-json (if-expr text text "{}")
          (block
            (on-error Error
              (throw (call Refusal (. HTTPStatus bad-request) "Invalid JSON body"))
            )
          )
        )
      )
      (lazy authorization (?? (call (. request header) "Authorization") ""))
    )
  )
  (fn-do _ answer HTTPResponse
    (param chat ChatRequest)
    (let count (. chat messages length))
    (print (str "POST " completions-path "  " (. chat model) ", " count " message" (if-expr (== count 1) "" "s") (if-expr (. chat stream) ", streaming" "")))
    (blank)
    (+= served 1)
    (let now (call clock))
    (let id (str "chatcmpl-mock-" (call base36 (as (- now (call ClockTime 0 0)) Int)) "-" (call base36 served)))
    (let completion (call Completion id (as (. now s) Int) chat))
    (return (if-expr (. chat stream) (call stream-response completion) (call json-response (. HTTPStatus ok) (. completion reply))))
  )
  (fn-expr _ stream-response HTTPResponse
    (param completion Completion)
    (call HTTPResponse (. HTTPStatus ok) (call events completion) headers)
    (where
      (lazy headers (list HTTPHeader)
        (block
          (bullet (tuple "Content-Type" "text/event-stream; charset=utf-8"))
          (bullet (tuple "Cache-Control" "no-cache, no-transform"))
          (bullet (tuple "Connection" "keep-alive"))
          (bullet (tuple "X-Request-Id" (. completion id)))
          (bullet (tuple "OpenAI-Processing-Ms" "1"))
          (bullet (tuple "Access-Control-Allow-Origin" "*"))
        )
      )
    )
  )
  (fn-do _ events (stream ServerSentEvent)
    (param completion Completion)
    (for (in choice (. completion stream-choices))
      (yield (call ServerSentEvent (call to-json (call (. completion chunk) (list choice) null))))
      (call (. delay wait))
    )
    (if (. completion chat include-usage)
      (yield (call ServerSentEvent (call to-json (call (. completion chunk) (call (of List JSON)) (. completion usage)))))
      (call (. delay wait))
    )
    (yield (call ServerSentEvent "[DONE]"))
    (print (str "streamed " (. completion pieces length) " chunks for " (. completion id)))
  )
  (fn-do _ refuse HTTPResponse
    (param refusal Refusal)
    (print (str (. refusal status) " " (. refusal message)))
    (return (. refusal response))
  )
)

(type + Refusal (is Error)
  (prop + status HTTPStatus)
  (prop + kind String)
  (fn-do + This _
    (param status _)
    (param reason String)
    (param kind _ (= "invalid_request_error"))
    (= message reason)
  )
  (fn-expr + response HTTPResponse :get
    (call json-response status payload)
    (where
      (lazy payload
        (call (of Map String JSON)
          (block
            (entry "error" detail)
          )
        )
      )
      (lazy detail
        (call (of Map String JSON)
          (block
            (entry "message" message)
            (entry "type" kind)
            (entry "param" null)
            (entry "code" null)
          )
        )
      )
    )
  )
)

(type + ChatRequest (is Tuple)
  (prop + model String)
  (prop + messages (list ChatMessage))
  (prop + stream Bool)
  (prop + include-usage Bool)
  (fn-expr + last-user-text String :get
    (?? (?. (call last (?> messages (== (. each role) "user"))) text) "")
  )
)

(type + ChatMessage (is Tuple)
  (prop + role String)
  (prop + text String)
)

(type + Completion (is Tuple)
  (prop + id String)
  (prop + created Int)
  (prop + chat ChatRequest)
  (fn-expr + content String :get
    (str "Mock ChatGPT " (if-expr (. chat stream) "streaming" "non-streaming") " OK. I received: " (call to-json (. chat last-user-text)))
  )
  (fn-expr + pieces (list String) :get
    (call (of List String) (~> content \piece))
  )
  (fn-expr + reply JSON :get
    (call json "chat.completion" choices usage)
    (where
      (lazy choices (list JSON)
        (block
          (bullet (call choice "message" message "stop"))
        )
      )
      (lazy message
        (call (of Map String JSON)
          (block
            (entry "role" "assistant")
            (entry "content" content)
          )
        )
      )
    )
  )
  (fn-expr + stream-choices (list JSON) :get
    (bullet (call choice "delta" role null))
    (bullet* (in (call choice "delta" (call content-delta each) null) pieces))
    (bullet (call choice "delta" (call (of Map String JSON)) "stop"))
    (where
      (lazy role
        (call (of Map String JSON)
          (block
            (entry "role" "assistant")
          )
        )
      )
    )
  )
  (fn-expr + chunk JSON
    (param choices (list JSON))
    (param usage JSON)
    (call json "chat.completion.chunk" choices usage)
  )
  (fn-expr + usage JSON :get
    (call (of Map String JSON)
      (block
        (entry "prompt_tokens" prompt)
        (entry "completion_tokens" completion)
        (entry "total_tokens" (+ prompt completion))
      )
    )
    (where
      (lazy prompt (call sum (in (call token-count (. each text)) (. chat messages))))
      (lazy completion (call token-count content))
    )
  )
  (fn-expr _ json JSON
    (param object String)
    (param choices (list JSON))
    (param usage JSON)
    (call (of Map String JSON)
      (block
        (entry "id" id)
        (entry "object" object)
        (entry "created" created)
        (entry "model" (. chat model))
        (entry "service_tier" "default")
        (entry "system_fingerprint" "fp_brix_mock")
        (entry "choices" choices)
        (entry "usage" usage)
      )
    )
  )
)

(fn-expr _ chat-request ChatRequest (?! Refusal)
  (param body JSON)
  (match body
    (case (list (= "model" (all (: model String) ({} (!= it "")))) (= "messages" (: items (list JSON))))
      (call ChatRequest model (call read-messages items) stream include-usage)
    )
    (case (list (= "model" (all String ({} (!= it "")))))
      (throw (call Refusal (. HTTPStatus bad-request) "Request body must include a messages array"))
    )
    (default
      (throw (call Refusal (. HTTPStatus bad-request) "Request body must include a string model"))
    )
  )
  (where
    (lazy stream (is body (list (= "stream" (all Bool ({} it))))))
    (lazy include-usage (is body (map "stream_options" (map "include_usage" (all Bool ({} it))))))
  )
)

(fn-expr _ read-messages (list ChatMessage) (?! Refusal)
  (param items (list JSON))
  (call (of List ChatMessage) (in (call read-message ([] items each) each) (..< 0 (. items length))))
)

(fn-expr _ read-message ChatMessage (?! Refusal)
  (param value JSON)
  (param index Index)
  (match value
    (case (list (= "role" (: role String)) (= "content" (: text String)))
      (call ChatMessage role text)
    )
    (case (list (= "role" (: role String)) (= "content" (: parts (list JSON))))
      (call ChatMessage role (call (. "" join) (in (call part-text each) parts)))
    )
    (case (list (= "role" String))
      (throw (call Refusal (. HTTPStatus bad-request) (str "messages[" index "].content must be a string or content array")))
    )
    (default
      (throw (call Refusal (. HTTPStatus bad-request) (str "messages[" index "].role must be a string")))
    )
  )
)

(fn-expr _ part-text String
  (param part JSON)
  (match part
    (case (list (= "text" (: text String)))
      text
    )
    (default
      ""
    )
  )
)

(fn-expr _ choice JSON
  (param field String)
  (param value JSON)
  (param finish (? String))
  (call (of Map String JSON)
    (block
      (entry "index" 0)
      (entry field value)
      (entry "logprobs" null)
      (entry "finish_reason" finish)
    )
  )
)

(fn-expr _ content-delta JSON
  (param text String)
  (call (of Map String JSON)
    (block
      (entry "content" text)
    )
  )
)

(fn-expr _ piece String (over: Char)
  (~ (: run (| (+ \wsnl) (+ (seq (! \wsnl) .))))
    run
  )
)

(fn-expr _ word String (over: Char)
  (~ (seq (* \wsnl) (: word (+ (seq (! \wsnl) .))))
    word
  )
)

(fn-expr _ token-count Int
  (param text String)
  (call count (~> text \word))
)

(fn-expr _ base36 String
  (param number Int)
  (str (if-expr (>= number 36) (call base36 (/ number 36)) "") ([] digits (% number 36)))
  (where
    (lazy digits "0123456789abcdefghijklmnopqrstuvwxyz")
  )
)

(fn-expr _ json-response HTTPResponse
  (param status HTTPStatus)
  (param payload JSON)
  (call HTTPResponse status (call to-json payload) headers)
  (where
    (lazy headers (list HTTPHeader)
      (block
        (bullet (tuple "Content-Type" "application/json; charset=utf-8"))
        (bullet (tuple "Cache-Control" "no-store"))
        (bullet (tuple "Access-Control-Allow-Origin" "*"))
      )
    )
  )
)

(fn-expr _ preflight HTTPResponse
  (call HTTPResponse (. HTTPStatus no-content) null headers)
  (where
    (lazy headers (list HTTPHeader)
      (block
        (bullet (tuple "Access-Control-Allow-Origin" "*"))
        (bullet (tuple "Access-Control-Allow-Headers" "authorization, content-type"))
        (bullet (tuple "Access-Control-Allow-Methods" "GET, POST, OPTIONS"))
      )
    )
  )
)
