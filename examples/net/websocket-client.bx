(import /net/url)
(import /net/websocket)
(blank)

(main
  (let socket (call WebSocket (call URL "ws://localhost:8765")))
  (blank)
  (call (. socket send) "hello from yumi")
  (blank)
  (for (in message socket)
    (print (str "client received: " message))
    (break)
  )
  (blank)
  (call (. socket close))
)
