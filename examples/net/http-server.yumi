/net/http
/net/http-server

.. site = SiteService()

<HTTPServer server
    service = site
    port = 8080

    <Route "/"
        get = site.home

    <Route "/notes"
        get = site.notes-page
        post = site.add-note

        <Route "{id}"
            get = site.note

    <Route "/about"
        get = site.about

-- "Serving on http://${server.host}:${server.port} (Ctrl-C to stop)"
server.run()

━━━━━━━━━━━━━━━━━━━━
+ SiteService is HTTPService

+ notes [String]

────────────────────
+ This

notes += "Buy milk"
notes += "Water the plants"

────────────────────
+ do respond HTTPResponse ?! Error
    - request HTTPRequest

. response = super.respond(request)
-- "${request.method} ${request.target} ${response.status}"
=? response if response.status != HTTPStatus.not-found
. content [String] =
    * "<p>Nothing lives at <code>${html-escape(request.path)}</code>.</p>"
= html-page("Not Found", content, HTTPStatus.not-found)

────────────────────
+ home HTTPResponse
    - request HTTPRequest

html-page("Yumi HTTP Server", content)

.. content [String]
    * "<p>A small site served from markup routes.</p>"
    * "<ul>"
    * "<li><a href=\"/notes\">Browse ${notes.length} notes</a></li>"
    * "<li><a href=\"/about\">About this request</a></li>"
    * "</ul>"

────────────────────
+ notes-page HTTPResponse
    - request HTTPRequest

html-page("Notes", content)

.. content [String]
    * "<ul>"
    ** "<li><a href=\"/notes/$each\">${html-escape(notes[each])}</a></li>" in 0 .. < notes.length
    * "</ul>"
    * "<p>Add one with <code>curl -L -d 'Call mom' http://localhost:8080/notes</code></p>"

────────────────────
+ do add-note HTTPResponse ?! Error
    - request HTTPRequest

. text = request.text
=? HTTPStatus.bad-request if text.length == 0
notes += text
. location [HTTPHeader] =
    * "Location", "/notes/${notes.length - 1}"
= HTTPResponse(HTTPStatus.see-other, null, location)

────────────────────
+ note HTTPResponse
    - request HTTPRequest

|? index == null || index >= notes.length
    HTTPStatus.not-found
??
    html-page("Note ${index + 1}", content)

.. index = note-index(request.params["id"]!)
.. content [String] =
    * "<p>${html-escape(notes[index])}</p>"
    * "<p><a href=\"/notes\">All notes</a></p>"

────────────────────
+ about HTTPResponse
    - request HTTPRequest

html-page("About", content)

.. content [String]
    * "<p>You asked for <code>${html-escape(request.target)}</code> with these headers:</p>"
    * "<dl>"
    ** "<dt>${html-escape(each.name)}</dt><dd>${html-escape(each.value)}</dd>" in request.headers
    * "</dl>"

━━━━━━━━━━━━━━━━━━━━
_ html-page HTTPResponse
    - title String
    - content [String]
    - status HTTPStatus = HTTPStatus.ok

HTTPResponse(status, "\n".join(lines), headers)

.. lines [String]
    * "<!doctype html>"
    * "<html>"
    * "<head><meta charset=\"utf-8\"><title>${html-escape(title)}</title></head>"
    * "<body>"
    * "<nav><a href=\"/\">Home</a> · <a href=\"/notes\">Notes</a> · <a href=\"/about\">About</a></nav>"
    * "<h1>${html-escape(title)}</h1>"
    ** content
    * "</body>"
    * "</html>"
.. headers [HTTPHeader]
    * "Content-Type", "text/html; charset=utf-8"

━━━━━━━━━━━━━━━━━━━━
_ note-index Index?
    - text String

match? text
    ~ index \num'Index !.
        index

━━━━━━━━━━━━━━━━━━━━
_ html-escape
    - text String

"".join(html-escaped(each) in text)

━━━━━━━━━━━━━━━━━━━━
_ html-escaped
    - c Char

match c
    |= '&'
        "&amp;"
    |= '<'
        "&lt;"
    |= '>'
        "&gt;"
    |= '"'
        "&quot;"
    |= '\''
        "&#39;"
    ??
        "$c"
