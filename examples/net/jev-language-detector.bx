(import /ai)
(import /ai/jev/jev)
(import /data/json)
(import /os/env)
(import /time)
(import /time/timer)
(import /tui)
(import /tui/colors)
(blank)
(prop _ api-key _ (= (call env "JEV_API_KEY")))

(main
  (throw (call Error "Set JEV_API_KEY before running this example") (if (not api-key)))
  (blank)
  (<> Window (id: win) (• flex-col) (• bg black)
    (<> Box (• flex 1))
    (blank)
    (<> Box (• flex-row)
      (<> Box (• flex 1))
      (<> LanguageDetector (id: detector)
        (= min-width (call (. SizeSpec coord) 48))
        (= max-width (call (. SizeSpec coord) 48))
      )
      (<> Box (• flex 1))
    )
    (blank)
    (<> Box (• flex 1))
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. win close))))
    )
  )
  (blank)
  (call (. win open))
)

(type + LanguageDetector (is Box)
  (prop + client _ (:= (call Jev (!! api-key))))
  (prop + language _ (= ""))
  (prop + revision Size (= 0))
  (event + text-changed Bool)
  (event + detection-finished Bool)
  (prop + is-detecting _ (= (or (is #phase .waiting) (is #phase .detecting))))
  (prop + phase _
    (machine
      (state idle)
      (state waiting (trigger on text-changed)
        (lazy timer (call Timer 350ms))
        (blank)
        (then detecting (trigger on timer))
        (then idle (trigger on detection-finished))
      )
      (blank)
      (state detecting
        (do
          (let text (call (. editor text trim)))
          (if text
            (do-new
              (inline (call detect-language text revision))
            )
            (else
              (= language "")
              (<- detection-finished true)
            )
          )
        )
        (blank)
        (then waiting (trigger on text-changed))
        (then idle (trigger on detection-finished))
      )
    )
  )
  (content
    (<> This (• flex-col)
      (<> TextEditor (id: editor) (text: "") (• border-rounded) (• border white) (• px 1)
        (= placeholder "Type in any language")
      )
      (blank)
      (<> Box (• flex-row) (• h 1) (• mt 1)
        (<> Box (• flex 1))
        (<> Label (• text lightgray)
          (= text (if-expr #is-detecting "" #language))
        )
        (<> Box (• flex 1))
      )
    )
  )
  (when-rule (. editor #text)
    (let text (call (. editor text trim)))
    (+= revision 1)
    (if text
      (<- text-changed true)
      (else
        (= language "")
        (<- detection-finished true)
      )
    )
  )
  (fn-do + detect-language _
    (param text String)
    (param request-revision Size)
    (let detected
      (call classify-language text
        (block
          (on-error Error
            ""
          )
        )
      )
    )
    (if (== revision request-revision)
      (= language detected)
      (<- detection-finished true)
    )
  )
  (fn-expr + classify-language _ (?! AIError)
    (param text String)
    (. answer choice)
    (where
      (lazy questions
        (call (of Map String JevQuestion)
          (block
            (:language
              (call JevChoiceQuestion
                (block
                  (arg "Which language is this text written in?")
                  (arg
                    (block
                      (bullet "Arabic")
                      (bullet "Chinese")
                      (bullet "Dutch")
                      (bullet "English")
                      (bullet "French")
                      (bullet "German")
                      (bullet "Hindi")
                      (bullet "Italian")
                      (bullet "Japanese")
                      (bullet "Korean")
                      (bullet "Polish")
                      (bullet "Portuguese")
                      (bullet "Russian")
                      (bullet "Spanish")
                      (bullet "Turkish")
                      (bullet "Other")
                      (pipe *> (tuple each each))
                      (pipe |> Map)
                    )
                  )
                )
              )
            )
          )
        )
      )
      (lazy answer
        (scope (as (!! ([] (. response answers) "language")) JevChoiceAnswer)
          (lazy response (call (. client evaluate) text questions))
        )
      )
    )
  )
)
