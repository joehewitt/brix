(import /ai/mcp)
(import /data/json)
(import /net/http-server)
(import /time/duration)
(blank)

(main
  (<> HTTPServer (id: server)
    (= port 8765)
    (blank)
    (<> MCPEndpoint (text: "/mcp")
      (= name "brix-notes")
      (= instructions "Keeps a list of notes in memory while the server runs.")
      (blank)
      (<> MCPTool (text: "add_note")
        (= description "Add a note to the list.")
        (= input-schema add-schema)
        (= call (. notes add))
      )
      (blank)
      (<> MCPTool (text: "list_notes")
        (= description "List every note, numbered from 1.")
        (= call (. notes all))
      )
      (blank)
      (<> MCPTool (text: "count_slowly")
        (= description "Count up to a number, one step every 100 ms, reporting progress.")
        (= input-schema count-schema)
        (= call (. notes count))
      )
    )
  )
  (blank)
  (lazy notes (call NotesTools))
  (lazy add-schema
    (call (of Map String JSON)
      (block
        (:type "object")
        (:properties add-properties)
        (:required add-required)
      )
    )
  )
  (lazy add-properties
    (call (of Map String JSON)
      (block
        (:text text-property)
      )
    )
  )
  (lazy text-property
    (call (of Map String JSON)
      (block
        (:type "string")
        (:description "The note text")
      )
    )
  )
  (lazy add-required (list JSON)
    (block
      (item "text")
    )
  )
  (blank)
  (lazy count-schema
    (call (of Map String JSON)
      (block
        (:type "object")
        (:properties count-properties)
        (:required count-required)
      )
    )
  )
  (lazy count-properties
    (call (of Map String JSON)
      (block
        (:to to-property)
      )
    )
  )
  (lazy to-property
    (call (of Map String JSON)
      (block
        (:type "integer")
        (:description "The number to count to, from 1 to 50")
      )
    )
  )
  (lazy count-required (list JSON)
    (block
      (item "to")
    )
  )
  (blank)
  (print (str "MCP server on http://" (. server host) ":" (. server port) "/mcp (Ctrl-C to stop)"))
  (call (. server run))
)

(type + NotesTools
  (prop + notes (list String))
  (fn-do + add MCPToolResult (?! Error)
    (param call MCPToolCall)
    (let text (call (. ([] call "text") string)))
    (+= notes text)
    (return (str "Added note " (. notes length) ": " text))
  )
  (fn-expr + all MCPToolResult
    (param call MCPToolCall)
    (case? (not notes)
      "There are no notes."
    )
    (default
      (call (. "\n" join) (in (str (+ each 1) ". " ([] notes each)) (..< 0 (. notes length))))
    )
  )
  (fn-do + count MCPToolResult (?! Error)
    (param call MCPToolCall)
    (let target (call (. ([] call "to") int)))
    (throw (call Error "\"to\" must be between 1 and 50") (if (or (< target 1) (> target 50))))
    (blank)
    (for (in step (..< 0 target))
      (call (. 100ms wait))
      (call (. call progress) (as (+ step 1) Float) (as target Float) (str "Counted to " (+ step 1)))
    )
    (let result JSON
      (call (of Map String JSON)
        (block
          (:counted target)
        )
      )
    )
    (return result)
  )
)
