(import /net/http)
(import /net/http-server)
(blank)

(main
  (<> HTTPServer (id: server)
    (= service site)
    (= port 8080)
    (blank)
    (<> Route (text: "/")
      (= get (. site home))
    )
    (blank)
    (<> Route (text: "/notes")
      (= get (. site notes-page))
      (= post (. site add-note))
      (blank)
      (<> Route (text: "{id}")
        (= get (. site note))
      )
    )
    (blank)
    (<> Route (text: "/about")
      (= get (. site about))
    )
  )
  (blank)
  (lazy site (call SiteService))
  (blank)
  (print (str "Serving on http://" (. server host) ":" (. server port) " (Ctrl-C to stop)"))
  (call (. server run))
)

(type + SiteService (is HTTPService)
  (prop + notes (list String)
    (=
      (block
        (item "Buy milk")
        (item "Water the plants")
      )
    )
  )
  (fn-do + respond HTTPResponse (?! Error)
    (param request HTTPRequest)
    (let response (call (. super respond) request))
    (print (str (. request method) " " (. request target) " " (. response status)))
    (return-if response (if (!= (. response status) (. HTTPStatus not-found))))
    (blank)
    (let content (list String)
      (block
        (item (str "<p>Nothing lives at <code>" (call html-escape (. request path)) "</code>.</p>"))
      )
    )
    (return (call html-page "Not Found" content (. HTTPStatus not-found)))
  )
  (fn-expr + home HTTPResponse
    (param request HTTPRequest)
    (call html-page "Brix HTTP Server" content)
    (where
      (lazy content (list String)
        (block
          (item "<p>A small site served from markup routes.</p>")
          (item "<ul>")
          (item (str "<li><a href=\"/notes\">Browse " (. notes length) " notes</a></li>"))
          (item "<li><a href=\"/about\">About this request</a></li>")
          (item "</ul>")
        )
      )
    )
  )
  (fn-expr + notes-page HTTPResponse
    (param request HTTPRequest)
    (call html-page "Notes" content)
    (where
      (lazy content (list String)
        (block
          (item "<ul>")
          (spread (in (str "<li><a href=\"/notes/" each "\">" (call html-escape ([] notes each)) "</a></li>") (..< 0 (. notes length))))
          (item "</ul>")
          (item "<p>Add one with <code>curl -L -d 'Call mom' http://localhost:8080/notes</code></p>")
        )
      )
    )
  )
  (fn-do + add-note HTTPResponse (?! Error)
    (param request HTTPRequest)
    (let text (. request text))
    (return-if (. HTTPStatus bad-request) (if (== (. text length) 0)))
    (blank)
    (+= notes text)
    (let location (list HTTPHeader)
      (block
        (item (tuple "Location" (str "/notes/" (- (. notes length) 1))))
      )
    )
    (return (call HTTPResponse (. HTTPStatus see-other) null location))
  )
  (fn-expr + note HTTPResponse
    (param request HTTPRequest)
    (case? (or (== index null) (>= index (. notes length)))
      (. HTTPStatus not-found)
    )
    (default
      (call html-page (str "Note " (+ index 1)) content)
    )
    (where
      (lazy index (call note-index (!! ([] (. request params) "id"))))
      (lazy content (list String)
        (block
          (item (str "<p>" (call html-escape ([] notes index)) "</p>"))
          (item "<p><a href=\"/notes\">All notes</a></p>")
        )
      )
    )
  )
  (fn-expr + about HTTPResponse
    (param request HTTPRequest)
    (call html-page "About" content)
    (where
      (lazy content (list String)
        (block
          (item (str "<p>You asked for <code>" (call html-escape (. request target)) "</code> with these headers:</p>"))
          (item "<dl>")
          (spread (in (str "<dt>" (call html-escape (. each name)) "</dt><dd>" (call html-escape (. each value)) "</dd>") (. request headers)))
          (item "</dl>")
        )
      )
    )
  )
)

(fn-expr _ html-page HTTPResponse
  (param title String)
  (param content (list String))
  (param status HTTPStatus (= (. HTTPStatus ok)))
  (call HTTPResponse status (call (. "\n" join) lines) headers)
  (where
    (lazy lines (list String)
      (block
        (item "<!doctype html>")
        (item "<html>")
        (item (str "<head><meta charset=\"utf-8\"><title>" (call html-escape title) "</title></head>"))
        (item "<body>")
        (item
          (paragraph
            "<nav><a href=\"/\">Home</a> · <a href=\"/notes\">Notes</a> · <a href=\"/about\">About</a></nav>"
          )
        )
        (item (str "<h1>" (call html-escape title) "</h1>"))
        (spread content)
        (item "</body>")
        (item "</html>")
      )
    )
    (lazy headers (list HTTPHeader)
      (block
        (item (tuple "Content-Type" "text/html; charset=utf-8"))
      )
    )
  )
)

(fn-expr _ note-index (? Index)
  (param text String)
  (match? text
    (~ (seq (: index (of \num Index)) (! .))
      index
    )
  )
)

(fn-expr _ html-escape _
  (param text String)
  (call (. "" join) (in (call html-escaped each) text))
)

(fn-expr _ html-escaped _
  (param c Char)
  (match c
    (case= '&'
      "&amp;"
    )
    (case= '<'
      "&lt;"
    )
    (case= '>'
      "&gt;"
    )
    (case= (char "\"")
      "&quot;"
    )
    (case= (char "'")
      "&#39;"
    )
    (default
      (str c)
    )
  )
)
