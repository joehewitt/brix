; Ink strokes. A drag feeds an `InkStroke` its points and times: `preview` shows
; the stroke as it grows, and `finish` tapers both ends, removes overlaps and fits
; curves. Fast strokes run thin. Every stroke keeps the samples it was drawn from,
; so the sliders ink the whole page again with the new pen. Pick a colour and draw.
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/ink)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ paper RGBA (= (call RGBA "#f7f2e8")))
(prop _ ruling RGBA (= (call RGBA "#d5dfe8")))
(prop _ margin RGBA (= (call RGBA "#ebbcb4")))
(prop _ navy RGBA (= (call RGBA "#1f3a5f")))
(prop _ vermilion RGBA (= (call RGBA "#e4572e")))
(prop _ amber RGBA (= (call RGBA "#f3a712")))
(prop _ leaf RGBA (= (call RGBA "#3f8f5f")))
(prop _ plum RGBA (= (call RGBA "#7b2cbf")))
(prop _ inks (list RGBA) (= (list navy vermilion amber leaf plum)))

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Ink")
      (= size (tuple 960 640))
      (blank)
      (<> InkPanel (• flex 1))
    )
  )
)

(type + InkMark (is Tuple)
  (prop + samples (list (tuple Point F64)))
  (prop + color RGBA)
  (prop + weight F64 (= 1))
  (fn-do + inked Path
    (param pen InkPen)
    (let size (* (. pen size) weight))
    (let stroke (call InkStroke (call InkPen size (. pen thinning) (. pen smoothing) (* (. pen taper-start) weight) (* (. pen taper-end) weight))))
    (for (in (tuple point at) samples)
      (call (. stroke add) point at)
    )
    (return (call (. stroke finish)))
  )
)

(type + InkPanel (is Box)
  (prop + marks (list InkMark) (= (call sketch)))
  (prop + ink RGBA (= navy))
  (prop + size F64 (= 10))
  (prop + thinning F64 (= 0.6))
  (prop + taper F64 (= 36))
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row) (• items-center) (• px 16) (• py 10) (• bg gui-panel-color)
        (= gap 12)
        (for (in color inks)
          (<> InkSwatch
            (= color color)
            (= is-selected (== #ink color))
            (for (on event click)
              (= ink color)
              (call (. event cancel))
            )
          )
        )
        (<> Label (text: "Size") (• ml 12))
        (<> Slider (• w 110)
          (= minimum 2)
          (= maximum 30)
          (<-> value size)
        )
        (<> Label (text: "Thinning"))
        (<> Slider (• w 110)
          (= minimum 0)
          (= maximum 1)
          (<-> value thinning)
        )
        (<> Label (text: "Taper"))
        (<> Slider (• w 110)
          (= minimum 0)
          (= maximum 120)
          (<-> value taper)
        )
        (<> Box (• flex 1))
        (<> Button (text: "Clear")
          (= is-enabled (> (. #marks length) 0))
          (= action (=> () :do (= marks (call (of List InkMark)))))
        )
      )
      (<> InkPage (id: page) (• flex 1) (• bg paper)
        (<-> marks marks)
        (= ink #ink)
        (= pen (call InkPen #size (:thinning #thinning) (:taper-start #taper) (:taper-end #taper)))
      )
    )
  )
)

(type + InkSwatch (is Box)
  (prop + color RGBA)
  (prop + is-selected _ (= false))
  (rule This (• w 22) (• h 22)
    (= corner-radius 14)
    (= border-width 3)
    (= border-color transparent)
    (= cursor (. CursorStyle pointing-hand))
    (= motion gui-motion-quick)
    (when-style #is-selected
      (= border-color gui-strong-text-color)
      (= scale 1.15)
    )
  )
  (content
    (<> This
      (= background-color color)
    )
  )
)

(type + InkPage (is Box)
  (prop + marks (list InkMark) (= (call (of List InkMark))))
  (prop + pen InkPen (= (call InkPen 10)))
  (prop + ink RGBA (= navy))
  (prop _ inked _ (= (call List (in (tuple (call (. each inked) #pen) (. each color)) #marks))))
  (prop _ stroke (? InkStroke))
  (prop _ samples (list (tuple Point F64)))
  (prop _ live (? Path))
  (rule This
    (= cursor (. CursorStyle crosshair))
    (= window-draggable false)
  )
  (depends invalidate-paint inked live)
  (subscribe-for (on event pointer-down)
    (call begin (. event point) (. event ordering-time))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call extend (. event point) (. event ordering-time))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-up)
    (call end (not (. event is-interrupted)))
    (call (. event cancel))
  )
  (fn-do + begin _
    (param point Point)
    (param at F64)
    (= stroke (call InkStroke pen))
    (= samples (call (of List (tuple Point F64))))
    (call extend point at)
  )
  (fn-do + extend _
    (param point Point)
    (param at F64)
    (let drawing stroke)
    (return-if (if (not drawing)))
    (blank)
    (call (. drawing add) point at)
    (+= samples (tuple point at))
    (= live (call (. drawing preview)))
  )
  (fn-do + end _
    (param keep Bool)
    (if (and keep stroke)
      (= marks (++ marks (list (call InkMark samples ink))))
    )
    (= stroke null)
    (= live null)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let shown live)
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. bounds x) (. bounds y))
      (= (. canvas fill-color) null)
      (= (. canvas stroke-width) 1px)
      (= (. canvas stroke-color) ruling)
      (for (in y (..< 72 (. bounds height) (by: 32)))
        (call (. canvas line) 0 y (. bounds width) y)
      )
      (= (. canvas stroke-color) margin)
      (call (. canvas line) 56 0 56 (. bounds height))
      (= (. canvas stroke-color) null)
      (for (in (tuple path color) inked)
        (= (. canvas fill-color) color)
        (call (. path outline) canvas)
      )
      (if shown
        (= (. canvas fill-color) ink)
        (call (. shown outline) canvas)
      )
    )
  )
)

(fn-do + sketch (list InkMark)
  (let marks (call (of List InkMark)))
  (+= marks (call trail plum 0.7 (call spiral (call Point 200 150) 3.2 74)))
  (for (in (tuple x y span) (list (tuple 372.0 116.0 22.0) (tuple 436.0 152.0 16.0) (tuple 482.0 100.0 13.0)))
    (let body (call Point x y))
    (let tip (- y 4))
    (let crest (- y span))
    (+= marks (call trail navy 0.5 (call bend (call Point (- x span) tip) (call Point (- x (/ span 2)) crest) body 10)))
    (+= marks (call trail navy 0.5 (call bend body (call Point (+ x (/ span 2)) crest) (call Point (+ x span) tip) 10)))
  )
  (+= marks (call trail navy 0.8 (call flourish (call Point 100 330) 5 30)))
  (+= marks (call trail navy 1.2 (call bend (call Point 84 412) (call Point 300 452) (call Point 540 384) 40)))
  (let bloom (call Point 720 196))
  (+= marks (call trail leaf 0.8 (call bend (call Point 718 280) (call Point 680 430) (call Point 706 620) 90)))
  (+= marks (call trail leaf 2.6 (call bend (call Point 702 470) (call Point 648 424) (call Point 590 446) 36)))
  (+= marks (call trail leaf 2.4 (call bend (call Point 700 400) (call Point 768 358) (call Point 822 382) 36)))
  (for (in index (..< 0 12))
    (let angle (* (as index F64) (/ π 6)))
    (+= marks (call trail vermilion 2.4 (call petal bloom angle 18 98)))
  )
  (for (in index (..< 0 12))
    (let angle (* (+ (as index F64) 0.5) (/ π 6)))
    (+= marks (call trail amber 1.7 (call petal bloom angle 12 58)))
  )
  (+= marks (call trail navy 0.6 (call spiral bloom 2.2 14)))
  (for (in index (..< 0 30))
    (let f (as index F64))
    (let root (call Point (+ 66 (* f 30) (* (call sin (* f 3.1)) 8)) 612))
    (let lean (* (call sin (* f 1.7)) 26))
    (let tall (+ 84 (* (call cos (* f 2.3)) 30)))
    (let middle (+ root (call Point (/ lean 3) (/ tall -2))))
    (+= marks (call trail leaf 0.8 (call bend (+ root (call Point lean (- tall))) middle root 16)))
  )
  (return marks)
)

(fn-do + trail InkMark
  (param color RGBA)
  (param weight F64)
  (param points (list Point))
  (let samples (call (of List (tuple Point F64))))
  (let at 0.0)
  (for (in index (..< 0 (. points length)))
    (let point ([] points index))
    (if (> index 0)
      (let step (- point ([] points (- index 1))))
      (let length (call max (. step length) 0.001))
      (+= at (/ length (* 520 (- 1.25 (/ (. step y) length)))))
    )
    (+= samples (tuple point at))
  )
  (return (call InkMark samples color weight))
)

(fn-expr + bend (list Point)
  (param from Point)
  (param via Point)
  (param to Point)
  (param count Index)
  (in (call quadratic from via to (/ (as each F64) (as count F64))) (.. 0 count))
)

(fn-expr + quadratic Point
  (param from Point)
  (param via Point)
  (param to Point)
  (param t F64)
  (+ (* from (* (- 1 t) (- 1 t))) (* via (* 2 t (- 1 t))) (* to (* t t)))
)

(fn-expr + petal (list Point)
  (param center Point)
  (param angle F64)
  (param inner Length)
  (param outer Length)
  (call bend (call polar center angle inner) (call polar center (+ angle 0.22) (/ (+ inner outer) 2)) (call polar center angle outer) 28)
)

(fn-expr + spiral (list Point)
  (param center Point)
  (param turns F64)
  (param reach Length)
  (in (call polar center (* (/ (as each F64) 48) 2 π) (* reach (/ (as each F64) count))) (.. 0 count))
  (where
    (lazy count (as (* turns 48) Index))
  )
)

(fn-expr + polar Point
  (param center Point)
  (param angle F64)
  (param radius Length)
  (+ center (* (call Point (call cos angle) (call sin angle)) radius))
)

(fn-expr + flourish (list Point)
  (param start Point)
  (param loops Index)
  (param height Length)
  (in (call cursive start height (+ π (* (as each F64) 0.12))) (.. 0 (* loops 52)))
)

(fn-expr + cursive Point
  (param start Point)
  (param height Length)
  (param t F64)
  (+ start (call Point (- (* 13 t) (* swell (call sin t))) (- (* swell (call cos t)))))
  (where
    (lazy swell (* height (+ 0.8 (* 0.3 (call sin (* t 0.5))))))
  )
)
