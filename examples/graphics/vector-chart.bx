; A style sheet for a drawing. The chart is vector markup made from a tracked
; list of days, and it says nothing about color. The sheet holds the palette,
; and its rules give each shape a fill or a stroke, so when Next Week brings new
; numbers, the bars move and the tallest one takes the accent on its own.
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /graphics/vector-group)
(import /gui)
(import /gui/vector-image)
(import /math)
(import /stream/aggregate)
(import /units)
(blank)

(main
  (<> App
    (<> Window (• flex-col) (• p 16)
      (= title "Sales")
      (= size (tuple 520 380))
      (= gap 12)
      (blank)
      (<> Chart (id: chart) (• flex 1))
      (<> Box (• flex-row) (• justify-end)
        (<> Button (text: "Next Week")
          (= role (. ButtonRole default))
          (= action (=> () :do (call (. chart next-week))))
        )
      )
    )
  )
)

(type + Day (is Tuple)
  (prop + index Float)
  (prop + name String)
  (prop + sales Float)
  (fn-expr + bar Rect :get
    (call Rect (call Point (+ 45 (* 80 index)) (- 220 sales)) (call Point (+ 105 (* 80 index)) 220))
  )
)

(fn-expr + week (list Day)
  (item (call Day 0 "Mon" (call random 40.0 190.0)))
  (item (call Day 1 "Tue" (call random 40.0 190.0)))
  (item (call Day 2 "Wed" (call random 40.0 190.0)))
  (item (call Day 3 "Thu" (call random 40.0 190.0)))
)

(style ChartTheme
  (using VectorPaintStyle)
  (blank)
  (prop + paper RGBA (= (call RGBA "#f3ede2")))
  (prop + ink RGBA (= (call RGBA "#2b2622")))
  (prop + accent RGBA (= (call RGBA "#c2410c")))
  (blank)
  (rule backdrop
    (= fill paper)
  )
  (blank)
  (rule axis
    (= stroke ink)
    (= stroke-width 2px)
  )
  (blank)
  (rule Column
    (= fill ink)
    (blank)
    (when-style #is-best
      (= fill accent)
    )
  )
)

(type + Column (is VectorGroup)
  (prop + is-best _ (= false))
)

(type + Chart (is VectorImage)
  (using ChartTheme)
  (prop + days _ (= (call week)))
  (prop + top _ (= (call max (in (. each sales) #days))))
  (fn-do + This _
    (= view-box (call Rect 0 0 400 240))
  )
  (fn-do + next-week _
    (= days (call week))
  )
  (content
    (<> This
      (<> Rectangle (• backdrop)
        (= rect (call Rect 0 0 400 240))
      )
      (<> VectorGroup
        (for (in day #days)
          (<> Column
            (= is-best (== (. day sales) #top))
            (<> Rectangle
              (= rect (. day bar))
            )
          )
        )
      )
      (<> Line (• axis)
        (= start (call Point 30 220))
        (= end (call Point 370 220))
      )
    )
  )
)
