; Geometry asked of paths. Two waves, a Lissajous figure and a spiral are each a
; `Path`. `path-crossings` rings every place two of them cross, and a ring lights as
; the beads riding the curves pass through it. Move the pointer: `path-nearest` finds
; each curve's closest point, with its tangent and normal, and a dashed line marks
; where `intersect-path-line` meets each curve. Drift moves them; Waves adds turns.
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/crossings)
(import /graphics/intersection)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /gui)
(import /math)
(import /time/duration)
(import /units)
(blank)
(prop _ night RGBA (= (call RGBA "#0f1526")))
(prop _ chalk RGBA (= (call RGBA "#f4efe4")))

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Crossings")
      (= size (tuple 920 620))
      (blank)
      (<> CrossingsPanel (• flex 1))
    )
  )
)

(type _ Strand (is Tuple)
  (prop + path Path)
  (prop + color RGBA)
  (prop + speed Float)
  (fn-expr + bead Length
    (param phase Float)
    (call fmod (* phase speed 140) (. path length))
  )
  (fn-expr + lights Float
    (param phase Float)
    (param along Length)
    (call clamp (- 1 (/ (call abs (- (call bead phase) along)) 40)) 0.0 1.0)
  )
)

(type + CrossingsPanel (is Box)
  (prop + drifting Bool (= true))
  (prop + waves F64 (= 2.5))
  (content
    (<> This (• flex-col)
      (<> CrossingsArt (• flex 1) (• bg night)
        (= drifting #drifting)
        (= waves #waves)
      )
      (<> Box (• flex-row) (• items-center) (• p 12)
        (= gap 12)
        (<> Switch (text: "Drift")
          (<-> is-on drifting)
        )
        (<> Label (text: "Waves"))
        (<> Slider (• w 160)
          (= minimum 1)
          (= maximum 5)
          (<-> value waves)
        )
      )
    )
  )
)

(type + CrossingsArt (is Box)
  (prop + drifting Bool (= true))
  (prop + waves F64 (= 2.5))
  (prop + phase Float (= 1.4))
  (prop + probe Point (= (call Point 0.62 0.75)))
  (depends invalidate-paint phase probe waves)
  (subscribe-for (on tick frames (whenever #drifting))
    (+= phase (as (as (. tick delta) Seconds) F64))
  )
  (subscribe-for (on event pointer-move)
    (call follow (. event point))
  )
  (subscribe-for (on event pointer-drag)
    (call follow (. event point))
    (call (. event cancel))
  )
  (fn-do _ follow _
    (param point Point)
    (= probe (call Point (/ (. point x) (. bounds width)) (/ (. point y) (. bounds height))))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let strands (call weave area phase waves))
    (let spot (+ (. area top-left) (call Point (* (. probe x) (. area width)) (* (. probe y) (. area height)))))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) null)
      (= (. canvas stroke-cap) (. LineCap round))
      (call (. canvas begin-blur) 6)
      (= (. canvas stroke-width) 7px)
      (for (in strand strands)
        (= (. canvas stroke-color) (call (. (. strand color) with-alpha) 45%))
        (call (. (. strand path) outline) canvas)
      )
      (call (. canvas end-blur))
      (= (. canvas stroke-width) 2.5px)
      (for (in strand strands)
        (= (. canvas stroke-color) (. strand color))
        (call (. (. strand path) outline) canvas)
      )
      (call scan canvas strands spot area)
      (for (in first (..< 0 (. strands length)))
        (for (in second (..< (+ first 1) (. strands length)))
          (let a ([] strands first))
          (let b ([] strands second))
          (for (in crossing (call path-crossings (. a path) (. b path)))
            (let glow (call max (call (. a lights) phase (. crossing along)) (call (. b lights) phase (. crossing across))))
            (call ring canvas (. crossing point) glow)
          )
        )
      )
      (for (in strand strands)
        (call probe-strand canvas strand spot)
        (let bead (call (. (. strand path) get-point-at-distance) (call (. strand bead) phase)))
        (= (. canvas stroke-color) null)
        (= (. canvas fill-color) (call (. (. strand color) with-alpha) 30%))
        (call (. (call circle bead 11) outline) canvas)
        (= (. canvas fill-color) (. strand color))
        (call (. (call circle bead 5.5) outline) canvas)
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) chalk)
      (= (. canvas stroke-width) 2px)
      (call (. (call circle spot 8) outline) canvas)
    )
  )
)

(fn-do _ scan _
  (param canvas Canvas)
  (param strands (list Strand))
  (param spot Point)
  (param area Rect)
  (let top (call Point (. spot x) (. area y)))
  (let bottom (call Point (. spot x) (. area bottom)))
  (= (. canvas stroke-color) (call (. chalk with-alpha) 22%))
  (= (. canvas stroke-width) 1px)
  (= (. canvas stroke-dash) 5)
  (call (. canvas line) top bottom)
  (= (. canvas stroke-dash) 0)
  (= (. canvas stroke-width) 2px)
  (= (. canvas fill-color) night)
  (for (in strand strands)
    (= (. canvas stroke-color) (. strand color))
    (for (in hit (call intersect-path-line (. strand path) top bottom))
      (call (. (call circle (call (. (. strand path) get-point-at) (. hit t1)) 4) outline) canvas)
    )
  )
)

(fn-do _ probe-strand _
  (param canvas Canvas)
  (param strand Strand)
  (param spot Point)
  (let path (. strand path))
  (let found (call path-nearest path spot))
  (return-if (if (not found)))
  (blank)
  (let foot (. found point))
  (let t (. found parameter))
  (let outward (call (. path get-normal-at) t 16))
  (if (< (call (. outward distance) spot) (call (. foot distance) spot))
    (= outward (call (. path get-normal-at) t -16))
  )
  (= (. canvas stroke-color) (call (. (. strand color) with-alpha) 70%))
  (= (. canvas stroke-width) 1.5px)
  (= (. canvas stroke-dash) 4)
  (call (. canvas line) spot foot)
  (= (. canvas stroke-dash) 0)
  (= (. canvas stroke-color) chalk)
  (call (. canvas line) foot outward)
  (= (. canvas stroke-width) 2px)
  (call (. canvas line) (call (. path get-tangent-at) t -26) (call (. path get-tangent-at) t 26))
  (= (. canvas fill-color) (. strand color))
  (call (. (call circle foot 4.5) outline) canvas)
)

(fn-do _ ring _
  (param canvas Canvas)
  (param point Point)
  (param glow Float)
  (if (> glow 0)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call (. chalk with-alpha) (* glow 0.3)))
    (call (. (call circle point (+ 6 (* glow 9))) outline) canvas)
  )
  (= (. canvas fill-color) (call (. (call (. chalk with-alpha) glow) over) night))
  (= (. canvas stroke-color) chalk)
  (= (. canvas stroke-width) 1.6px)
  (call (. (call circle point 5) outline) canvas)
)

(fn-do _ weave (list Strand)
  (param area Rect)
  (param phase Float)
  (param waves Float)
  (let reach (* (call min (. area width) (. area height)) 0.16))
  (return
    (list
      (call Strand (call wave-path area waves (* phase 0.7) 0.3 -0.06) (call RGBA "#ff6b5a") 1.0)
      (call Strand (call wave-path area (* waves 0.62) (* phase -0.45) 0.22 0.08) (call RGBA "#3ad6c4") 1.3)
      (call Strand (call lissajous-path area phase) (call RGBA "#ffc145") 0.8)
      (call Strand (call spiral (. area center) reach 2.5 7 (as (* phase 0.6) Radians)) (call RGBA "#a78bfa") 1.1)
    )
  )
)

(fn-expr _ wave-path Path
  (param area Rect)
  (param waves Float)
  (param shift Float)
  (param height Float)
  (param lift Float)
  (call smooth-path steps false
    (=> (index)
      (block
        (call Point (+ (. area x) (* along (. area width))) (+ (. area center y) (* (. area height) (+ lift (* height (call sin angle))))))
        (lazy along (/ (as index Float) steps))
        (lazy angle (as (+ (* along waves 2 π) shift) Radians))
      )
    )
  )
  (where
    (lazy steps (as (call ceil (* waves 6)) Int))
  )
)

(fn-expr _ lissajous-path Path
  (param area Rect)
  (param phase Float)
  (call smooth-path 24 true
    (=> (index)
      (block
        (+ (. area center) (call Point (* 0.38 (. area width) (call sin (as (+ (* angle 3) (* phase 0.35)) Radians))) (* 0.4 (. area height) (call sin (as (* angle 2) Radians)))))
        (lazy angle (/ (* (as index Float) 2 π) 24))
      )
    )
  )
)

(fn-do _ smooth-path Path
  (param count Int)
  (param closed Bool)
  (param sample (fn-type Point (param index Int)))
  (let path (call Path))
  (call (. path move-to) (call sample 0))
  (for (in index (..< 0 count))
    (let start (call sample index))
    (let end (call sample (+ index 1)))
    (call (. path cubic-curve-to) (+ start (/ (- end (call sample (- index 1))) 6)) (- end (/ (- (call sample (+ index 2)) start) 6)) end)
  )
  (if closed
    (call (. path close))
  )
  (return path)
)
