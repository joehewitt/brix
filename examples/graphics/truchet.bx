; Truchet tiling: quarter-circle tiles cut from one circle path, set down in a grid
; and turned by a seeded hash, so the same seed draws the same picture. It is
; saved as `truchet.png` in the working directory.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/intersection)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/style)
(import /graphics/vector)
(import /graphics/vector-group)
(import /gui/generated-vector-image)
(import /math)
(import /units)
(blank)

(main
  (let scene (call truchet-scene (call TruchetParams)))
  (call (. scene render) "truchet.png")
)

(type + TruchetParams
  (prop + size _ (= (call Dimensions 850 850)))
  (prop + tile-radius Length (= 20px))
  (prop + stroke-width Length (= 1))
  (prop + seed U32 (= 17u32))
  (prop + mix F64 (= 0.5))
  (prop + fill-color (? RGBA) (= "#000"))
  (prop + stroke-color (? RGBA))
  (prop + background (? RGBA) (= "#333333"))
)

(type + TruchetTiles
  (prop + seed U32 (= 0u32))
  (prop + mix F64 (= 0.5))
  (prop + tile-radius Length (= 20px))
  (prop + filled Bool (= true))
  (fn-do + get-tiles-stroked _
    (param tile1 Path)
    (let bbox (. tile1 bounding-box))
    (let tile2 (call Path tile1))
    (call (. tile2 translate) (call Point (. bbox width) (. bbox height)))
    (blank)
    (let quarter (/ (. tile1 curve-count) 4.0))
    (let half (/ (. tile1 curve-count) 2.0))
    (let tile3 (call (. tile1 split-at-range) half (+ half quarter)))
    (let arc2 (call (. tile2 split-at-range) 0 quarter))
    (call append-path-commands tile3 arc2)
    (blank)
    (= bbox (. tile3 bounding-box))
    (let tile4 (call Path tile3))
    (call (. tile4 rotate) 90deg (. bbox center))
    (call (. tile3 translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (call (. tile4 translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (blank)
    (return (tuple tile3 tile4))
  )
  (fn-do + get-tiles-filled _
    (param tile1 Path)
    (let bbox (. tile1 bounding-box))
    (let tile2 (call Path tile1))
    (call (. tile2 translate) (call Point (. bbox width) (. bbox height)))
    (blank)
    (let quarter (/ (. tile1 curve-count) 4.0))
    (let half (/ (. tile1 curve-count) 2.0))
    (let arc1 (call (. tile1 split-at-range) half (+ half quarter)))
    (let arc2 (call (. tile2 split-at-range) 0 quarter))
    (blank)
    (let top-left (. bbox center))
    (let bottom-right (+ top-left (. bbox size)))
    (let top-right (call Point (. bottom-right x) (. top-left y)))
    (let bottom-left (call Point (. top-left x) (. bottom-right y)))
    (blank)
    (let tile3 (call Path))
    (call (. tile3 move-to) top-left)
    (call (. tile3 line-to) (. arc1 first-point))
    (call append-path-curves tile3 arc1)
    (call (. tile3 line-to) top-left)
    (blank)
    (call (. tile3 move-to) bottom-right)
    (call (. tile3 line-to) (. arc2 first-point))
    (call append-path-curves tile3 arc2)
    (call (. tile3 line-to) bottom-right)
    (blank)
    (let tile4 (call Path))
    (call (. tile4 move-to) (. arc1 first-point))
    (call (. tile4 line-to) top-right)
    (call (. tile4 line-to) (. arc2 last-point))
    (blank)
    (let arc2r (call (. arc2 reverse)))
    (call append-path-curves tile4 arc2r)
    (blank)
    (call (. tile4 line-to) bottom-left)
    (call (. tile4 line-to) (. arc1 last-point))
    (blank)
    (let arc1r (call (. arc1 reverse)))
    (call append-path-curves tile4 arc1r)
    (blank)
    (call (. tile4 line-to) (. arc1 first-point))
    (blank)
    (= bbox (call Rect top-left (. bbox size)))
    (blank)
    (let tile3b (call Path tile3))
    (call (. tile3b rotate) 90deg (. bbox center))
    (let tile4b (call Path tile4))
    (call (. tile4b rotate) 90deg (. bbox center))
    (blank)
    (call (. tile3 translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (call (. tile4 translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (call (. tile3b translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (call (. tile4b translate) (call Point (- (. bbox x)) (- (. bbox y))))
    (blank)
    (return (tuple tile3 tile4 tile3b tile4b))
  )
  (fn-do + generate VectorGroup
    (param bounds Rect)
    (let source (call circle (tuple tile-radius tile-radius) tile-radius))
    (let paths (list Path))
    (if filled
      (let (tuple tile1 tile2 tile1b tile2b) (call get-tiles-filled source))
      (let bbox (. tile1 bounding-box))
      (let tile-size (call Dimensions (call max (. bbox width) (. bbox height)) (call max (. bbox width) (. bbox height))))
      (for (in (tuple row col offset) (call iterate-tiles tile-size (. bounds size)))
        (let tile
          (block
            (case? (== (% (+ row col) 2) 0)
              (if-expr (call truchet-choice row col seed mix) tile1 tile2b)
            )
            (default
              (if-expr (call truchet-choice row col seed mix) tile2 tile1b)
            )
          )
        )
        (let placed (call Path tile))
        (call (. placed translate) (+ (. bounds top-left) offset))
        (+= paths placed)
      )
      (else
        (let (tuple tile1 tile2) (call get-tiles-stroked source))
        (let bbox (. tile1 bounding-box))
        (let tile-size (call Dimensions (call max (. bbox width) (. bbox height)) (call max (. bbox width) (. bbox height))))
        (for (in (tuple row col offset) (call iterate-tiles tile-size (. bounds size)))
          (let tile (if-expr (call truchet-choice row col seed mix) tile1 tile2))
          (let placed (call Path tile))
          (call (. placed translate) (+ (. bounds top-left) offset))
          (+= paths placed)
        )
      )
    )
    (return (call VectorGroup paths))
  )
)

(type + VectorScene (is VectorGroup)
  (prop + size Dimensions)
  (prop + background (? RGBA))
  (fn-do + render _
    (param path String)
    (let canvas
      (block
        (case? (call (. path ends-with) ".svg")
          (call SVGCanvas (as (. size width) I32) (as (. size height) I32))
        )
        (default
          (call RasterCanvas (as (. size width) I32) (as (. size height) I32))
        )
      )
    )
    (blank)
    (do-use canvas
      (call render canvas)
      (call (. canvas write) path)
    )
    (blank)
    (call print (str "Saved to " path))
  )
  (fn-do + render _
    (param canvas Canvas)
    (call next-frame)
    (if background
      (call (. canvas erase) background)
    )
    (let area (only-if (call Rect 0 0 (. size width) (. size height)) (if (and (> (. size width) 0) (> (. size height) 0)))))
    (call paint-vector canvas null true null area)
  )
)

(fn-do + truchet-scene _
  (param params TruchetParams)
  (let scene (call VectorScene))
  (= (. scene size) (. params size))
  (= (. scene background) (. params background))
  (blank)
  (let generator (call TruchetTiles))
  (= (. generator seed) (. params seed))
  (= (. generator mix) (. params mix))
  (= (. generator tile-radius) (. params tile-radius))
  (= (. generator filled) (not (not (. params fill-color))))
  (blank)
  (let tiles (call GeneratedVectorImage (. generator generate)))
  (= (. tiles fill) (if-expr (. params fill-color) (. params fill-color) (. Fill none)))
  (= (. tiles stroke) (?? (. params stroke-color) (. params fill-color) (. Stroke none)))
  (= (. tiles stroke-width) (. params stroke-width))
  (+= scene tiles)
  (blank)
  (return scene)
)

(fn-do + iterate-tiles _
  (param tile-size Dimensions)
  (param container-size Dimensions)
  (let x Coord 0)
  (let y Coord 0)
  (let row 0)
  (let col 0)
  (while (< y (. container-size height))
    (= x 0)
    (= col 0)
    (blank)
    (while (< x (. container-size width))
      (if (< x (. container-size width))
        (yield (tuple row col (call Point x y)))
      )
      (+= x (. tile-size width))
      (+= col 1)
    )
    (blank)
    (+= y (. tile-size height))
    (+= row 1)
  )
)

(fn-expr + truchet-choice _
  (param row _)
  (param col _)
  (param seed U32)
  (param mix F64)
  (< (call truchet-score (as row U32) (as col U32) seed) threshold)
  (where
    (lazy threshold (as (* clamped-mix 1024.0) U32))
    (lazy clamped-mix (call max 0.0 (call min 1.0 mix)))
  )
)

(fn-expr + truchet-score _
  (param row U32)
  (param col U32)
  (param seed U32)
  (/and/ (/xor/ hash (/rshift/ hash 16)) 1023)
  (where
    (lazy hash
      (block
        (* (/xor/ mixed (/rshift/ mixed 13)) 1274126177)
      )
    )
    (blank)
    (lazy mixed (+ (* row 374761393) (* col 668265263) (* seed 2246822519)))
  )
)

(fn-do + append-path-commands _
  (param target Path)
  (param source Path)
  (let reader (. source command-reader))
  (while (call (. reader next))
    (if (== (. reader verb) .path-verb-move)
      (call (. target move-to) (call (. reader coord) 0) (call (. reader coord) 1))
      (else-if (== (. reader verb) .path-verb-line)
        (call (. target line-to) (call (. reader coord) 0) (call (. reader coord) 1))
      )
      (else-if (== (. reader verb) .path-verb-cubic)
        (call (. target cubic-curve-to)
          (block
            (arg (call (. reader coord) 0))
            (arg (call (. reader coord) 1))
            (arg (call (. reader coord) 2))
            (arg (call (. reader coord) 3))
            (arg (call (. reader coord) 4))
            (arg (call (. reader coord) 5))
          )
        )
      )
      (else-if (== (. reader verb) .path-verb-close)
        (call (. target close))
      )
    )
  )
)

(fn-do + append-path-curves _
  (param target Path)
  (param source Path)
  (let reader (. source curve-reader))
  (while (call (. reader next))
    (call (. target add-curve) (. reader curve))
  )
)
