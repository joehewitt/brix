; Interlace from vector networks. Each strand is a lobed loop drawn as a `Path` and
; made a `VectorNetwork`; `network-weave` cuts the strands between their crossings so
; that they pass over and under in turn, and `network-stroke` makes every strand and
; piece a band to fill. The sliders weave the knot again, it turns slowly with the
; frame clock, and the strand under the pointer lights up.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/network)
(import /graphics/network-combine)
(import /graphics/network-stroke)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /time/duration)
(import /units)
(blank)
(prop _ night RGBA (= (call RGBA "#0e1820")))
(prop _ ink RGBA (= (call RGBA "#04090d")))
(prop _ shade RGBA (= (call RGBA 0% 0% 0% 45%)))
(prop _ glow RGBA (= (call RGBA 100% 100% 100% 35%)))
(prop _ shine RGBA (= (call RGBA 100% 100% 100% 30%)))
(prop _ design-size _ (= 400.0))
(prop _ knot-radius _ (= 126.0))
(prop _ palette _
  (=
    (list
      (call RGBA "#e9b949")
      (call RGBA "#3fb8af")
      (call RGBA "#e4572e")
      (call RGBA "#f1e6c8")
    )
  )
)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Woven Knot")
      (= size (tuple 720 780))
      (blank)
      (<> KnotPanel (• flex 1))
    )
  )
)

(type + KnotPanel (is Box)
  (prop + strands F64 (= 4))
  (prop + lobes F64 (= 5))
  (prop + swell F64 (= 0.25))
  (prop + band F64 (= 0.3))
  (content
    (<> This (• flex-col)
      (<> Knot (• flex 1) (• bg night)
        (= bands (call weave-knot (as #strands Int) (as #lobes Int) #swell #band))
      )
      (<> Box (• flex-row) (• items-center) (• p 12)
        (= gap 10)
        (<> Label (text: "Strands"))
        (<> Slider (• w 90)
          (= minimum 2)
          (= maximum 4)
          (= step 1)
          (<-> value strands)
        )
        (<> Label (text: "Lobes"))
        (<> Slider (• w 90)
          (= minimum 3)
          (= maximum 6)
          (= step 1)
          (<-> value lobes)
        )
        (<> Label (text: "Swell"))
        (<> Slider (• w 90)
          (= minimum 0.12)
          (= maximum 0.28)
          (<-> value swell)
        )
        (<> Label (text: "Band"))
        (<> Slider (• w 90)
          (= minimum 0.15)
          (= maximum 0.36)
          (<-> value band)
        )
      )
    )
  )
)

(type + Knot (is Box)
  (prop + bands (list KnotBand))
  (prop + turn Float (= 0))
  (prop + pointer _ (= (call Point 0 0)))
  (depends invalidate-paint bands turn pointer is-hovered)
  (subscribe-for (on tick frames)
    (+= turn (* 0.05 (as (as (. tick delta) Seconds) F64)))
  )
  (subscribe-for (on event pointer-move)
    (= pointer (+ (. event point) (. bounds top-left)))
  )
  (fn-expr _ view Matrix :get
    (call (. placed rotate) (as turn Radians) (call Point 0 0))
    (where
      (lazy placed (call (. (call matrix-from-translation (. area center)) scale) (call Dimensions fit fit)))
      (lazy fit (/ (call min (. area width) (. area height)) design-size))
      (lazy area content-bounds)
    )
  )
  (fn-do _ strand-at (? Index)
    (param point Point)
    (for (in band bands)
      (return-if (. band strand) (if (call (. band over body contains) point (. FillRule nonzero))))
    )
    (for (in index (..< 0 (. bands length)))
      (let band ([] bands (- (. bands length) index 1)))
      (return-if (. band strand) (if (call (. band whole edge contains) point (. FillRule nonzero))))
    )
    (return null)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let matrix view)
    (let spot (call (. matrix inverse-transform) pointer))
    (let lit (? Index))
    (if (and is-hovered spot)
      (= lit (call strand-at spot))
    )
    (do-use (. canvas saved-state)
      (call (. canvas transform) matrix)
      (= (. canvas stroke-color) null)
      (do-use (. canvas saved-state)
        (call (. canvas translate) 3 6)
        (= (. canvas fill-color) shade)
        (for (in band bands)
          (call (. band whole edge outline) canvas)
        )
      )
      (for (in band bands)
        (call paint-paths canvas (. band whole) (. band strand) (== (. band strand) lit))
      )
      (for (in band bands)
        (call paint-paths canvas (. band over) (. band strand) (== (. band strand) lit))
      )
    )
  )
)

(type + KnotPaths (is Tuple)
  (prop + edge Path)
  (prop + body Path)
  (prop + thread Path)
)

(type + KnotBand (is Tuple)
  (prop + strand Index)
  (prop + whole KnotPaths)
  (prop + over KnotPaths)
)

(fn-do + paint-paths _
  (param canvas Canvas)
  (param paths KnotPaths)
  (param strand Index)
  (param lit Bool)
  (let color ([] palette strand))
  (let body (if-expr lit (call (. glow over) color) color))
  (= (. canvas fill-color) ink)
  (call (. paths edge outline) canvas)
  (= (. canvas fill-color) body)
  (call (. paths body outline) canvas)
  (= (. canvas fill-color) (call (. shine over) body))
  (call (. paths thread outline) canvas)
)

(fn-do + weave-knot (list KnotBand)
  (param strands Int)
  (param lobes Int)
  (param swell Float)
  (param band Float)
  (let spacing (call min (/ (* 2 (as π F64) knot-radius) (* strands lobes)) (* 1.3 knot-radius swell)))
  (let width (call min 16.0 (* band spacing)))
  (let networks (call (of List VectorNetwork) (in (call network-from-path (call strand-path each strands lobes swell)) (..< 0 strands))))
  (let overs (call (of List KnotPaths) (in (call KnotPaths (call Path) (call Path) (call Path)) (..< 0 strands))))
  (for (in piece (call network-weave networks) (when (. piece over)))
    (let paths (call knot-paths (. piece network) width))
    (let into ([] overs (. piece source)))
    (call (. into edge add-path) (?? (call subtract (. paths edge) (. paths body)) (call Path)))
    (call (. into body add-path) (. paths body))
    (call (. into thread add-path) (. paths thread))
  )
  (return (call (of List KnotBand) (in (call KnotBand each (call knot-paths ([] networks each) width) ([] overs each)) (..< 0 strands))))
)

(fn-expr + knot-paths KnotPaths
  (param network VectorNetwork)
  (param width Float)
  (call KnotPaths (call outline (+ 3 (* width 1.3))) (call outline width) (call outline (* width 0.18)))
  (where
    (lazy outline (=> (across) (call network-stroke network across .round-join-type .butt)))
  )
)

(fn-do + strand-path Path
  (param strand Int)
  (param strands Int)
  (param lobes Int)
  (param swell Float)
  (let path (call Path))
  (let count (* lobes 4))
  (let step (/ (* 2 (as π F64)) count))
  (let phase (/ (* 2 (as π F64) strand) strands))
  (let start (/ (+ phase (/ (as π F64) (* 4 strands))) lobes))
  (for (in index (..< 0 count))
    (let (tuple from leaving) (call loop-at (+ start (* step index)) lobes swell phase))
    (let (tuple to arriving) (call loop-at (+ start (* step (+ index 1))) lobes swell phase))
    (if (== index 0)
      (call (. path move-to) from)
    )
    (call (. path cubic-curve-to) (+ from (* leaving (/ step 3))) (- to (* arriving (/ step 3))) to)
  )
  (call (. path close))
  (return path)
)

(fn-expr + loop-at (tuple Point Point)
  (param angle Float)
  (param lobes Int)
  (param swell Float)
  (param phase Float)
  (tuple (* outward radius) (+ (* outward growth) (* along radius)))
  (where
    (lazy outward (call Point (call cos (as angle Radians)) (call sin (as angle Radians))))
    (lazy along (call Point (- (. outward y)) (. outward x)))
    (lazy wave (as (- (* lobes angle) phase) Radians))
    (lazy radius (* knot-radius (+ 1 (* swell (call cos wave)))))
    (lazy growth (* knot-radius swell lobes -1 (call sin wave)))
  )
)
