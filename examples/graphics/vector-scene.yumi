/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/vector-group
/os/path

━━━━━━━━━━━━━━━━━━━━
+ VectorScene is VectorGroup

+ size Dimensions
+ output String
+ background RGBA?

────────────────────
+ do render

. canvas =
    |? Path(output).extension == "svg"
        SVGCanvas(size.width as I32, size.height as I32)
    ??
        RasterCanvas(size.width as I32, size.height as I32)

do use canvas
    render(canvas)
    canvas.write(output)

print("Saved to $output")

────────────────────
+ do render
    - canvas Canvas

next-frame()
if background
    canvas.erase(background)
. area = Rect(0, 0, size.width, size.height) if size.width > 0 && size.height > 0
paint-vector(canvas, null, true, null, area)
