/graphics/tests/support/offset-grid-cells
/graphics/vector-group
/math
/units

<VectorScene scene
    size = (1280, 900)
    output = "/private/tmp/yumi-offset-join-grid.svg"
    background = RGBA(96%, 98%, 100%)

    <OffsetJoinGridImage

scene.render()

━━━━━━━━━━━━━━━━━━━━
+ OffsetJoinGridImage is VectorGroup

+ columns = 4
+ rows = 5
+ margin = 30px
+ gap = 16px

╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-vector
    - canvas Canvas
    - inherited VectorAppearance? = null
    - apply-opacity = true
    - outer-effects VectorEffects? = null
    - area Rect? = null

. scene-size = Dimensions(canvas.width, canvas.height)
. cell-width = (scene-size.width - margin * 2 - gap * (columns - 1)) / columns
. cell-height = (scene-size.height - margin * 2 - gap * (rows - 1)) / rows

for row in 0 .. < rows
    for col in 0 .. < columns
        . cell = Rect()
            - margin + (cell-width + gap) * col
            - margin + (cell-height + gap) * row
            - cell-width
            - cell-height
        paint-offset-join-cell(canvas, row, col, cell)

━━━━━━━━━━━━━━━━━━━━
_ do paint-offset-join-cell
    - canvas Canvas
    - row
    - col
    - cell Rect

canvas.fill-color = RGBA(100%, 100%, 100%, 72%)
canvas.stroke-color = RGBA(3%, 7%, 14%, 10%)
canvas.stroke-width = 1
canvas.rect(cell)

. source = offset-join-grid-source-path(row, cell)
. result = offset-join-grid-result-path()
    - source
    - offset-join-grid-distance(row)
    - offset-join-grid-join-type(col)

if source.is-closed
    canvas.fill-color = offset-join-grid-fill-color(row)
    canvas.stroke-color = null
else
    canvas.fill-color = null
    canvas.stroke-color = offset-join-grid-fill-color(row)
    canvas.stroke-width = 5
if result.count
    result.outline(canvas)

canvas.fill-color = null
canvas.stroke-color = offset-grid-source-stroke-color()
canvas.stroke-width = 1.5
source.outline(canvas)

━━━━━━━━━━━━━━━━━━━━
_ do offset-join-grid-result-path Path
    - source Path
    - distance Length
    - join-type JoinType

. layer = offset-path(PathSet([source]), distance, join-type, 5)
. result Path
for path in layer.paths
    if result.count
        result.add-path(path)
    else
        result = path

= result

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-source-path Path
    - row
    - cell Rect

match row
    |= 0
        offset-join-grid-open-crown(center, radius)
    ??
        offset-grid-cell-shape(offset-join-grid-shape-kind(row), center, radius)

.. inset = min(cell.width, cell.height) * 0.09
.. drawing = cell.inflate(-inset * 2, -inset * 2)
.. center = drawing.center
.. radius = min(drawing.width, drawing.height) * offset-join-grid-radius-scale(row)

━━━━━━━━━━━━━━━━━━━━
_ do offset-join-grid-open-crown Path
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 1.15, radius * 0.36))
path.line-to(center + (-radius * 0.55, -radius * 0.42))
path.line-to(center + (0, -radius * 0.58))
path.line-to(center + (radius * 0.55, -radius * 0.42))
path.line-to(center + (radius * 1.15, radius * 0.36))
= path

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-shape-kind Index
    - row

match row
    |= 0
        1
    |= 1
        5
    |= 2
        9
    |= 3
        11
    ??
        12

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-radius-scale Float
    - row

match row
    |= 0
        0.38
    |= 1
        0.34
    |= 2
        0.32
    |= 3
        0.31
    ??
        0.28

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-distance Length
    - row

match row
    |= 0
        10
    |= 1
        8
    |= 2
        8
    |= 3
        7
    ??
        3

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-join-type JoinType
    - col

match col
    |= 0
        .bevel-join-type
    |= 1
        .square-join-type
    |= 2
        .miter-join-type
    ??
        .round-join-type

━━━━━━━━━━━━━━━━━━━━
_ offset-join-grid-fill-color RGBA
    - row

match row
    |= 0
        RGBA(4%, 61%, 66%, 62%)
    |= 1
        RGBA(20%, 57%, 34%, 62%)
    |= 2
        RGBA(18%, 63%, 42%, 58%)
    |= 3
        RGBA(44%, 34%, 78%, 58%)
    ??
        RGBA(73%, 23%, 15%, 58%)
