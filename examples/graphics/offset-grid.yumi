./vector-scene
/graphics/appearance
/graphics/canvas
/graphics/color
/graphics/effect
/graphics/primitives
/graphics/tests/support/offset-grid-cells
/graphics/vector-group
/units

<VectorScene scene
    size = (1280, 960)
    output = "/private/tmp/yumi-offset-grid.svg"
    background = RGBA(96%, 98%, 100%)

    <OffsetGridImage

scene.render()

━━━━━━━━━━━━━━━━━━━━
+ OffsetGridImage is VectorGroup

+ group-columns = 2
+ group-rows = 2
+ margin = 28px
+ group-gap = 30px

╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-vector
    - canvas Canvas
    - inherited VectorAppearance? = null
    - apply-opacity = true
    - outer-effects VectorEffects? = null
    - area Rect? = null

. scene-size = Dimensions(canvas.width, canvas.height)
. group-width = (scene-size.width - margin * 2 - group-gap * (group-columns - 1)) / group-columns
. group-height = (scene-size.height - margin * 2 - group-gap * (group-rows - 1)) / group-rows

for row in 0 .. < group-rows
    for col in 0 .. < group-columns
        paint-group()
            - canvas
            - row
            - col
            - Rect()
                - margin + (group-width + group-gap) * col
                - margin + (group-height + group-gap) * row
                - group-width
                - group-height

━━━━━━━━━━━━━━━━━━━━
_ offset-grid-example-cell-index Index
    - group-row
    - group-col
    - row
    - col

match group-row
    |= 1
        kind + 16
    ??
        kind

.. local = row * 4 + col
.. kind = if group-col == 0 then local else 8 + local

━━━━━━━━━━━━━━━━━━━━
_ do paint-group
    - canvas Canvas
    - group-row
    - group-col
    - group Rect

canvas.fill-color = RGBA(100%, 100%, 100%, 35%)
canvas.stroke-color = RGBA(3%, 7%, 14%, 14%)
canvas.stroke-width = 1
canvas.rect(group)

. padding = 16px
. gap = 12px
. columns = 4
. rows = 2
. cell-width = (group.width - padding * 2 - gap * (columns - 1)) / columns
. cell-height = (group.height - padding * 2 - gap * (rows - 1)) / rows

for row in 0 .. < rows
    for col in 0 .. < columns
        . index = offset-grid-example-cell-index(group-row, group-col, row, col)
        paint-cell()
            - canvas
            - index
            - Rect()
                - group.x + padding + (cell-width + gap) * col
                - group.y + padding + (cell-height + gap) * row
                - cell-width
                - cell-height

━━━━━━━━━━━━━━━━━━━━
_ do paint-cell
    - canvas Canvas
    - index
    - cell Rect

canvas.fill-color = RGBA(100%, 100%, 100%, 72%)
canvas.stroke-color = RGBA(3%, 7%, 14%, 10%)
canvas.stroke-width = 1
canvas.rect(cell)

. result = offset-grid-cell-result-path(index, cell)
if offset-grid-cell-source-is-closed(index)
    canvas.fill-color = offset-grid-cell-fill-color(index)
    canvas.stroke-color = null
else
    canvas.fill-color = null
    canvas.stroke-color = offset-grid-cell-fill-color(index)
    canvas.stroke-width = 4
if result.count
    result.outline(canvas)

. source = offset-grid-cell-source-path(index, cell)
canvas.fill-color = null
canvas.stroke-color = offset-grid-source-stroke-color()
canvas.stroke-width = 1.5
source.outline(canvas)
