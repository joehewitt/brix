; Circle packing. `pack-circles` drops circles at random inside a `Path` and grows
; each until it meets the outline or a neighbor: a heart, a star, a moon cut with
; `subtract` and a cloud joined with `union`, each circle colored by its size. Click
; to pack again, rippling out from the pointer, which lights the circles near it. The
; sliders set the radius range, and Around packs the space outside the path instead.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/pack)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/text)
(import /gui)
(import /math)
(import /math/easing)
(import /stream/aggregate)
(import /time/duration)
(import /units)
(blank)
(prop _ night RGBA (= (call RGBA "#0f1724")))
(prop _ haze RGBA (= (call RGBA 100% 100% 100% 5%)))
(prop _ shine RGBA (= (call RGBA 100% 100% 100% 22%)))
(prop _ chalk RGBA (= (call RGBA "#fff6e0")))
(prop _ board _ (= (call Dimensions 1000 640)))
(prop _ middle _ (= (call Point 500 320)))
(prop _ pop _ (= (call CubicBezier 0.34 1.56 0.64 1)))
(prop _ figures _ (= (list (. Figure heart) (. Figure star) (. Figure moon) (. Figure cloud))))
(prop _ palette _
  (=
    (list
      (call RGBA "#ffe8a3")
      (call RGBA "#ffc145")
      (call RGBA "#ff8552")
      (call RGBA "#f2545b")
      (call RGBA "#c33c86")
      (call RGBA "#6a4c93")
    )
  )
)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Circle Packing")
      (= size (tuple 960 700))
      (blank)
      (<> PackingPanel (• flex 1))
    )
  )
)

(type + Figure (is (tuple (: title String)))
  (variant heart (= (tuple "Heart")))
  (variant star (= (tuple "Star")))
  (variant moon (= (tuple "Moon")))
  (variant cloud (= (tuple "Cloud")))
  (fn-expr + path Path :get
    (match this
      (case= .heart
        (call heart-path)
      )
      (case= .star
        (call star-path)
      )
      (case= .moon
        (!! (call subtract (call circle (call Point 520 320) 300) (call circle (call Point 660 215) 250)))
      )
      (default
        (call cloud-path)
      )
    )
  )
)

(type + PackingPanel (is Box)
  (prop + figure Figure (= (. Figure heart)))
  (prop + around Bool (= false))
  (prop + smallest F64 (= 4))
  (prop + largest F64 (= 36))
  (prop + region Path)
  (prop + circles (list Circ))
  (prop + origin Point (= middle))
  (prop + grown F64 (= 1))
  (depends reshape figure around)
  (fn-do + This _
    (= region (. figure path))
    (= circles (call pack-circles board region smallest largest))
  )
  (subscribe-for (on tick frames (whenever (< #grown 1)))
    (= grown (call min 1.0 (+ grown (* (as (as (. tick delta) Seconds) F64) 0.8))))
  )
  (fn-do + reshape _
    (= region (. figure path))
    (call repack middle)
  )
  (fn-do + repack _
    (param from Point)
    (= circles (call pack-circles board region smallest largest 1 around))
    (= origin from)
    (= grown 0)
  )
  (content
    (<> This (• flex-col)
      (<> PackingArt (id: art) (• flex 1) (• bg night)
        (= region #region)
        (= circles #circles)
        (= origin #origin)
        (= grown #grown)
        (for (on event click)
          (call repack (call (. art to-board) (. event point)))
          (call (. event cancel))
        )
      )
      (<> Box (• flex-row) (• items-center) (• p 12)
        (= gap 12)
        (<> (of SegmentedControl Figure)
          (<-> selected figure)
          (for (in choice figures)
            (<> (of Segment Figure) (text: (. choice title))
              (= value choice)
            )
          )
        )
        (<> Label (text: "Smallest"))
        (<> Slider (• w 110)
          (= minimum 3)
          (= maximum 12)
          (= step 1)
          (<-> value smallest)
          (for (on event value-changed (when (call settles (. event phase))))
            (call repack middle)
          )
        )
        (<> Label (text: "Largest"))
        (<> Slider (• w 110)
          (= minimum 16)
          (= maximum 64)
          (= step 1)
          (<-> value largest)
          (for (on event value-changed (when (call settles (. event phase))))
            (call repack middle)
          )
        )
        (<> Switch (text: "Around")
          (<-> is-on around)
        )
        (<> Label (• flex 1)
          (= text (str (. #circles length) " circles"))
          (= text-alignment (. TextAlignment right))
        )
      )
    )
  )
)

(type + PackingArt (is Box)
  (prop + region Path)
  (prop + circles (list Circ))
  (prop + origin Point (= middle))
  (prop + grown F64 (= 1))
  (prop + spot Point (= (call Point -1000 -1000)))
  (depends invalidate-paint region circles grown spot is-hovered)
  (subscribe-for (on event pointer-move)
    (= spot (call to-board (. event point)))
  )
  (fn-expr + fit Float :get
    (call min (/ (. content-bounds width) (. board width)) (/ (. content-bounds height) (. board height)))
  )
  (fn-expr + corner Point :get
    (- (. content-bounds center) (* (call Point (. board width) (. board height)) (/ fit 2)))
  )
  (fn-expr + to-board Point
    (param point Point)
    (/ (- (+ (. bounds top-left) point) corner) fit)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (not (. circles length))))
    (blank)
    (let biggest (call max (in (. each radius) circles)))
    (do-use (. canvas saved-state)
      (call (. canvas transform) (call Matrix fit 0 0 fit (. corner x) (. corner y)))
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) haze)
      (call (. region outline) canvas)
      (for (in circ circles)
        (let grow (call (. pop eased) (- (* grown 2.2) (/ (call (. origin distance) (. circ pt)) 1000))))
        (let glow (call glow-at (. circ pt)))
        (if (> grow 0)
          (call bead canvas (. circ pt) (* (. circ radius) grow (+ 0.9 (* glow 0.15))) (call tint circ biggest glow))
        )
      )
    )
  )
  (fn-expr _ glow-at F64
    (param point Point)
    (if-expr is-hovered (call max 0.0 (- 1 (/ (call (. spot distance) point) 170))) 0.0)
  )
  (fn-expr _ tint RGBA
    (param circ Circ)
    (param biggest Length)
    (param glow F64)
    (call (. (call (. chalk with-alpha) (* glow 0.55)) over) base)
    (where
      (lazy base ([] palette (call min (- (. palette length) 1) (as (* share (. palette length)) Index))))
      (lazy share (/ (. circ radius) biggest))
    )
  )
)

(fn-do _ bead _
  (param canvas Canvas)
  (param center Point)
  (param radius Length)
  (param color RGBA)
  (= (. canvas fill-color) color)
  (call (. canvas circle) (. center x) (. center y) radius)
  (= (. canvas fill-color) shine)
  (call (. canvas circle) (- (. center x) (* radius 0.3)) (- (. center y) (* radius 0.32)) (* radius 0.42))
)

(fn-expr _ settles Bool
  (param phase ValueChangePhase)
  (or (== phase (. ValueChangePhase ended)) (== phase (. ValueChangePhase discrete)))
)

(fn-do _ heart-path Path
  (let path (call Path))
  (call (. path move-to) (call heart-point 50 92))
  (call (. path cubic-curve-to) (call heart-point 22 72) (call heart-point 0 52) (call heart-point 0 30))
  (call (. path cubic-curve-to) (call heart-point 0 12) (call heart-point 13 0) (call heart-point 28 0))
  (call (. path cubic-curve-to) (call heart-point 40 0) (call heart-point 48 8) (call heart-point 50 18))
  (call (. path cubic-curve-to) (call heart-point 52 8) (call heart-point 60 0) (call heart-point 72 0))
  (call (. path cubic-curve-to) (call heart-point 87 0) (call heart-point 100 12) (call heart-point 100 30))
  (call (. path cubic-curve-to) (call heart-point 100 52) (call heart-point 78 72) (call heart-point 50 92))
  (call (. path close))
  (return path)
)

(fn-expr _ heart-point Point
  (param x Float)
  (param y Float)
  (call Point (+ 190 (* x 6.2)) (+ 35 (* y 6.2)))
)

(fn-do _ star-path Path
  (let path (call Path))
  (call (. path move-to) 500 15)
  (for (in index (..< 1 10))
    (let reach (if-expr (== (% index 2) 0) 330 140))
    (let angle (as (- (* 36deg index) 90deg) Radians))
    (call (. path line-to) (+ 500 (* reach (call cos angle))) (+ 345 (* reach (call sin angle))))
  )
  (call (. path close))
  (return path)
)

(fn-do _ cloud-path Path
  (let cloud (call rectangle (call Rect 265 380 500 150)))
  (let puffs
    (list
      (call circle (call Point 265 400) 130)
      (call circle (call Point 435 290) 190)
      (call circle (call Point 625 330) 160)
      (call circle (call Point 765 430) 100)
    )
  )
  (for (in puff puffs)
    (= cloud (!! (call union cloud puff)))
  )
  (return cloud)
)
