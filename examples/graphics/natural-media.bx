; Natural media: a line-and-wash landscape where every element is laid down in a
; different paint or brush: watercolor sky and hills on grain paper, gouache meadows, a
; crayon sun, a hatched shadow and a stippled canopy; charcoal trunk, ink outlines and
; birds, a marker fence, pencil grass and crayon flowers. Drag to move the sun and its
; light, Pressure loads the paints, and Repaint paints a new scene stroke by stroke.
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/media)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shader)
(import /gui)
(import /math)
(import /time/duration)
(import /units)
(blank)
(prop _ sky-blue RGBA (= (call RGBA 52% 72% 88% 45%)))
(prop _ dusk RGBA (= (call RGBA 97% 78% 58% 35%)))
(prop _ glow RGBA (= (call RGBA 100% 93% 74% 16%)))
(prop _ cloud RGBA (= (call RGBA 100% 98% 94% 35%)))
(prop _ ink RGBA (= (call RGBA "#2c3a40")))
(prop _ bark RGBA (= (call RGBA "#4a3628")))
(prop _ blooms (list RGBA) (= (list "#d2483a" "#f0c23b" "#8a5bb0" "#f4f1ea")))
(prop _ gull (list Point) (= (list (tuple -1 -0.3) (tuple -0.6 -0.55) (tuple -0.25 -0.45) (tuple 0 0) (tuple 0.25 -0.45) (tuple 0.6 -0.55) (tuple 1 -0.3))))

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Natural Media")
      (= size (tuple 960 660))
      (blank)
      (<> MediaPanel (• flex 1))
    )
  )
)

(type + MediaPanel (is Box)
  (prop + seed F64 (= 1))
  (prop + pressure F64 (= 0.6))
  (prop + progress F64 (= 1))
  (subscribe-for (on tick frames (whenever (< #progress 1)))
    (= progress (call min 1.0 (+ progress (/ (as (as (. tick delta) Seconds) F64) 3.5))))
  )
  (content
    (<> This (• flex-col)
      (<> Landscape (• flex 1) (• bg "#f6f0e2")
        (= seed #seed)
        (= pressure #pressure)
        (= progress #progress)
      )
      (<> Box (• flex-row) (• items-center) (• p 12)
        (= gap 12)
        (<> Button (text: "Repaint")
          (for (on event click)
            (+= seed 1)
            (= progress 0)
            (call (. event cancel))
          )
        )
        (<> Label (text: "Pressure"))
        (<> Slider (• w 180)
          (= minimum 0.3)
          (= maximum 1)
          (<-> value pressure)
        )
      )
    )
  )
)

(type + Landscape (is Box)
  (prop + seed F64 (= 1))
  (prop + pressure F64 (= 0.6))
  (prop + progress F64 (= 1))
  (prop + sun Point (= (call Point 0.8 0.2)))
  (depends invalidate-paint seed pressure progress sun)
  (subscribe-for (on event pointer-down)
    (call follow (. event point))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call follow (. event point))
    (call (. event cancel))
  )
  (fn-do _ follow _
    (param point Point)
    (let u (call clamp-unit (/ (. point x) (. bounds width))))
    (= sun (call Point u (call clamp (/ (. point y) (. bounds height)) 0.06 0.5)))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let art (call Painter canvas content-bounds seed pressure progress sun))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content-bounds)
      (call (. art paint))
    )
  )
)

(type + Painter (is Tuple)
  (prop + canvas Canvas)
  (prop + area Rect)
  (prop + seed F64)
  (prop + pressure F64)
  (prop + progress F64)
  (prop + sun Point)
  (fn-expr + unit Float :get
    (call min (. area width) (. area height))
  )
  (fn-expr + light Point :get
    (call at (. sun x) (. sun y))
  )
  (fn-do + paint _
    (let sky (call watercolor-paint (:granulation pressure) (:seed seed)))
    (let hills (call gouache-paint (:seed seed)))
    (call wash "#e6dcc4" (call grain-paint (:amount 0.6)) -1 (call to-edge (call ridge 1 0 0) 0))
    (for (in index (..< 0 4))
      (let order (* index 0.02))
      (call wash sky-blue sky order (call to-edge (call ridge (+ 0.2 (* index 0.12)) 0.02 index) 0))
      (call wash dusk sky order (call to-edge (call ridge (+ 0.3 (* index 0.1)) 0.02 (+ 10 index)) 1))
    )
    (for (in index (..< 0 8))
      (let reach (* unit (+ 0.075 (* index 0.02))))
      (call wash glow sky 0.1 (call ring light reach reach 0.02 index))
    )
    (let crayon (call crayon-paint (:pressure pressure) (:seed seed)))
    (call wash "#ee9b2f" crayon 0.15 (call ring light (* unit 0.065) (* unit 0.065) 0.04 1))
    (for (in index (..< 0 12))
      (let group (% index 3))
      (let u (+ 0.08 (* 0.25 group) (* 0.08 (call chance (+ 60 group)))))
      (let size (* unit (+ 0.025 (* 0.025 (call chance (+ 70 index))))))
      (let shift (call Point (* unit 0.04 (- (/ index 3) 1.5)) (* size -0.3 (% index 2))))
      (let puff (+ (call at u (+ 0.1 (* 0.08 (call chance (+ 65 group))))) shift))
      (call wash cloud sky 0.08 (call ring puff (* size 1.5) size 0.12 index))
    )
    (let far (call ridge 0.46 0.12 1))
    (let near (call ridge 0.56 0.08 2))
    (call wash "#8199b6" sky 0.2 (call to-edge far 1))
    (call draw ink (call ink-brush) (* unit 0.005) 0.3 far)
    (call wash "#6f9a8c" sky 0.3 (call to-edge near 1))
    (call draw ink (call ink-brush) (* unit 0.004) 0.4 near)
    (call wash "#97b85c" hills 0.4 (call to-edge (call ridge 0.68 0.05 3) 1))
    (call wash "#6e9a45" hills 0.5 (call to-edge (call ridge 0.82 0.03 4) 1))
    (call tree (call at (+ 0.16 (* 0.2 (call chance 9))) 0.78))
    (call fence)
    (call meadow)
    (call birds)
  )
  (fn-do + tree _
    (param base Point)
    (let crown (- base (call Point 0 (* unit 0.36))))
    (let lean (* (- (. base x) (. light x)) 0.3))
    (let middle (+ base (call Point (* lean 0.6) (* unit 0.008))))
    (let shadow (call ring middle (+ (* unit 0.07) (* (call abs lean) 0.5)) (* unit 0.02) 0.05 5))
    (call wash "#3f5a35" (call hatch-paint (:tone pressure) (:seed seed)) 0.6 shadow)
    (let charcoal (call charcoal-brush (:seed seed)))
    (for (in index (..< 0 3))
      (let side (* unit 0.012 (- index 1)))
      (let top (+ crown (call Point (* side 0.3) (* unit 0.08))))
      (let via (+ (/ (+ base top) 2) (call Point (* side 1.5) 0)))
      (let stem (call bend (+ base (call Point side 0)) via top))
      (call draw bark charcoal (* unit 0.016) (+ 0.5 (* index 0.04)) stem)
    )
    (let beam (- light crown))
    (let toward (* beam (/ (* unit 0.03) (call max (. beam length) 1))))
    (let leaves (call gouache-paint (:angle 1.2) (:seed seed)))
    (let shade (call stipple-paint (:tone pressure) (:seed seed)))
    (for (in index (..< 0 7))
      (let (tuple spot size) (call puff crown index))
      (call wash "#4f7d3a" leaves 0.62 (call ring spot size size 0.12 index))
    )
    (for (in index (..< 0 7))
      (let (tuple spot size) (call puff crown index))
      (let dark (call ring (- spot (* toward 0.5)) (* size 0.7) (* size 0.65) 0.12 index))
      (call wash "#1f3b1c" shade 0.68 dark)
    )
    (for (in index (..< 0 7))
      (let (tuple spot size) (call puff crown index))
      (if (> (call (. (- spot crown) dot) toward) 0)
        (call wash "#86b35a" leaves 0.75 (call ring (+ spot toward) (* size 0.55) (* size 0.45) 0.12 index))
      )
    )
  )
  (fn-do + fence _
    (let marker (call marker-brush (:seed seed)))
    (let tops (call (of List Point)))
    (for (in index (..< 0 6))
      (let foot (call at (+ 0.6 (* index 0.07)) (+ 0.8 (* index 0.012))))
      (let top (- foot (call Point 0 (* unit (+ 0.08 (* index 0.006))))))
      (+= tops top)
      (call draw "#5e4c3a" marker (* unit 0.018) (+ 0.6 (* index 0.03)) (list foot top))
    )
    (for (in drop (list 0.015 0.05))
      (let rail (call (of List Point) (in (+ each (call Point 0 (* unit drop))) tops)))
      (call draw "#7a6550" marker (* unit 0.014) 0.8 rail)
    )
  )
  (fn-do + meadow _
    (let pencil (call pencil-brush (:seed seed)))
    (for (in index (..< 0 90))
      (let foot (call at (call chance (+ 100 index)) (+ 0.85 (* 0.15 (call chance (+ 200 index))))))
      (let tall (* unit (+ 0.025 (* 0.04 (call chance (+ 300 index))))))
      (let lean (* tall (- (call chance (+ 400 index)) 0.5)))
      (let tip (+ foot (call Point lean (- tall))))
      (let blade (call bend foot (- tip (call Point lean (* tall -0.5))) tip))
      (call draw "#3f5a34" pencil (* unit 0.004) (+ 0.7 (* 0.2 (call chance (+ 500 index)))) blade)
    )
    (for (in index (..< 0 28))
      (let spot (call at (call chance (+ 600 index)) (+ 0.86 (* 0.12 (call chance (+ 700 index))))))
      (let bloom (call ring spot (* unit 0.008) (* unit 0.008) 0.2 index))
      (let crayon (call crayon-brush (:seed (+ seed index))))
      (let color ([] blooms (% index (. blooms length))))
      (call draw color crayon (* unit 0.012) (+ 0.85 (* 0.15 (call chance (+ 800 index)))) bloom)
    )
  )
  (fn-do + birds _
    (for (in index (..< 0 5))
      (let u (+ 0.08 (* index 0.07) (* 0.04 (call chance (+ 900 index)))))
      (let spot (call at u (+ 0.12 (* 0.1 (call chance (+ 950 index))))))
      (let span (* unit (+ 0.018 (* 0.012 (call chance (+ 980 index))))))
      (let bird (call (of List Point) (in (+ spot (* each span)) gull)))
      (call draw ink (call ink-brush) (* unit 0.004) (+ 0.88 (* index 0.02)) bird)
    )
  )
  (fn-expr + at Point
    (param u Float)
    (param v Float)
    (+ (. area top-left) (call Point (* u (. area width)) (* v (. area height))))
  )
  (fn-expr + chance Float
    (param index (similar Float))
    (% (call abs (* (call sin (+ (* seed 12.9898) (* index 78.233))) 43758.5453)) 1.0)
  )
  (fn-expr + share Float
    (param order Float)
    (call clamp-unit (/ (- progress (* order 0.7)) 0.3))
  )
  (fn-expr + puff (tuple Point Float)
    (param crown Point)
    (param index Int)
    (tuple (+ crown (* (call Point (* 0.075 (call cos angle)) (* 0.055 (call sin angle))) unit)) size)
    (where
      (lazy angle (* index 0.9))
      (lazy size (* unit (+ 0.06 (* 0.03 (call chance (+ 20 index))))))
    )
  )
  (fn-expr + ridge (list Point)
    (param base Float)
    (param rise Float)
    (param index (similar Float))
    (call (of List Point) (in (call at (/ each 48.0) (- base (* rise (call wave (/ each 48.0) index)))) (.. 0 48)))
  )
  (fn-expr + wave Float
    (param u Float)
    (param index (similar Float))
    (+ (* 0.6 (call sin (+ (* u swell) phase))) (* 0.4 (call sin (+ (* u 13) ripple))))
    (where
      (lazy swell (+ 4 (* 3 (call chance index))))
      (lazy phase (* 6.28 (call chance (+ index 0.5))))
      (lazy ripple (* 6.28 (call chance (+ index 0.25))))
    )
  )
  (fn-expr + to-edge (list Point)
    (param ridge (list Point))
    (param edge Float)
    (++ ridge (list (call at 1 edge) (call at 0 edge)))
  )
  (fn-expr + ring (list Point)
    (param center Point)
    (param rx Float)
    (param ry Float)
    (param wobble Float)
    (param index (similar Float))
    (call (of List Point) (in (call rim center rx ry wobble index (* each 0.157)) (..< 0 40)))
  )
  (fn-expr + rim Point
    (param center Point)
    (param rx Float)
    (param ry Float)
    (param wobble Float)
    (param index (similar Float))
    (param angle Float)
    (+ center (* (call Point (* rx (call cos angle)) (* ry (call sin angle))) swell))
    (where
      (lazy swell (+ 1 (* wobble (call sin (+ (* angle 3) (* 6.28 (call chance (+ 30 index))))))))
    )
  )
  (fn-expr + bend (list Point)
    (param from Point)
    (param via Point)
    (param to Point)
    (call (of List Point) (in (call curve-at from via to (/ each 12.0)) (.. 0 12)))
  )
  (fn-expr + curve-at Point
    (param from Point)
    (param via Point)
    (param to Point)
    (param t Float)
    (+ (* from (* (- 1 t) (- 1 t))) (* via (* 2 t (- 1 t))) (* to (* t t)))
  )
  (fn-do + wash _
    (param color RGBA)
    (param paint Paint)
    (param order Float)
    (param points (list Point))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call (. color with-alpha) (* (. color alpha) (call share order))))
    (= (. canvas fill-paint) paint)
    (call trace points true)
  )
  (fn-do + draw _
    (param color RGBA)
    (param brush Brush)
    (param width Float)
    (param order Float)
    (param points (list Point))
    (= (. canvas fill-color) null)
    (= (. canvas fill-paint) null)
    (= (. canvas stroke-color) color)
    (= (. canvas stroke-width) width)
    (= (. canvas stroke-brush) (= (. brush reveal) (call share order)))
    (call trace points false)
  )
  (fn-do + trace _
    (param points (list Point))
    (param closed Bool)
    (call (. canvas begin))
    (call (. canvas move) (. ([] points 0) x) (. ([] points 0) y))
    (for (in point ([] points (..< 1 (. points length))))
      (call (. canvas line) (. point x) (. point y))
    )
    (call (. canvas end) closed)
  )
)
