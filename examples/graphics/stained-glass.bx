; Stained glass from one `VectorNetwork`. The leads cross wherever they like, and a
; `NetworkRegionWorkspace` finds every pane they close off and, after each edit, which
; panes each new one came from. Click a pane to change its glass, drag a joint to move
; it or a lead to bend it: panes keep their glass as they reshape, and a pane that
; splits gives its glass to both halves.
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/matrix)
(import /graphics/network)
(import /graphics/network-regions)
(import /graphics/network-stroke)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /gui)
(import /math)
(import /stream/aggregate)
(import /units)
(blank)
(prop _ stone RGBA (= (call RGBA "#1c1920")))
(prop _ lead RGBA (= (call RGBA "#141217")))
(prop _ solder RGBA (= (call RGBA "#57525c")))
(prop _ parchment RGBA (= (call RGBA "#d9cfbf")))
(prop _ masonry RGBA (= (call RGBA "#3d3842")))
(prop _ daylight RGBA (= (call RGBA 1 0.8 0.55 0.14)))
(prop _ design _ (= (call Dimensions 400 610)))
(prop _ jewels (list RGBA)
  (=
    (list
      (call RGBA "#b3122e")
      (call RGBA "#1747a6")
      (call RGBA "#0f7a4a")
      (call RGBA "#e09a1a")
      (call RGBA "#6d2f9c")
      (call RGBA "#0f8b8d")
      (call RGBA "#d2602a")
      (call RGBA "#9fc3c9")
    )
  )
)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Stained Glass")
      (= size (tuple 540 820))
      (blank)
      (<> GlassPanel (• flex 1))
    )
  )
)

(type + GlassPanel (is Box)
  (prop + glazing _ (= (call Glazing)))
  (prop + lead-width Float (= 7))
  (content
    (<> This (• flex-col) (• bg stone)
      (<> GlassArt (• flex 1) (• p 20)
        (= glazing glazing)
        (= lead-width #lead-width)
      )
      (<> Box (• flex-row) (• items-center) (• px 20) (• pb 16) (• gap 12)
        (<> Label (• flex 1) (• text parchment)
          (= text (str (. #glazing #panes regions length) " panes"))
        )
        (<> Label (text: "Lead") (• text parchment))
        (<> Slider (• w 120)
          (= minimum 3)
          (= maximum 14)
          (<-> value lead-width)
        )
        (<> Button (text: "Reglaze")
          (for (on event click)
            (call (. glazing reglaze))
            (call (. event cancel))
          )
        )
      )
    )
  )
)

(type + GlassArt (is Box)
  (prop + glazing Glazing)
  (prop + lead-width Float (= 7))
  (prop _ joint (? Index))
  (prop _ lead-hit (? NetworkHit))
  (prop _ last _ (= (call Point 0 0)))
  (depends invalidate-paint lead-width)
  (whenever-rule (. #glazing #edits)
    (call invalidate-paint)
  )
  (subscribe-for (on event pointer-down)
    (call press (call to-design (. event point)))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call drag-to (call to-design (. event point)))
    (call (. event cancel))
  )
  (fn-do + press _
    (param point Point)
    (= last point)
    (= joint (call (. glazing joint-near) point (/ 12 fit-scale)))
    (= lead-hit (only-if (call (. glazing network pick) point (+ (/ lead-width 2) (/ 4 fit-scale))) (if (not joint))))
    (if (not (or joint lead-hit))
      (call (. glazing cycle) point)
    )
  )
  (fn-do + drag-to _
    (param point Point)
    (let target (call Point (call clamp (. point x) 0.0 (. design width)) (call clamp (. point y) 0.0 (. design height))))
    (let held joint)
    (let hit lead-hit)
    (if held
      (call (. glazing move-joint) held target)
      (else-if hit
        (call (. glazing bend-lead) hit (- target last))
      )
    )
    (= last target)
  )
  (fn-expr _ fit-scale Float :get
    (call min (/ (. content-bounds width) (. design width)) (/ (. content-bounds height) (. design height)))
  )
  (fn-expr _ fit-origin Point :get
    (- (. content-bounds center) (call Point (* (. design width) fit-scale 0.5) (* (. design height) fit-scale 0.5)))
  )
  (fn-expr _ to-design Point
    (param point Point)
    (/ (- (+ point (. bounds top-left)) fit-origin) fit-scale)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let origin fit-origin)
    (let scale fit-scale)
    (return-if (if (<= scale 0)))
    (blank)
    (call (. canvas fill-gradient) bounds (call radial-gradient (. content-bounds center) (* (. design height) scale 0.5) daylight (call (. daylight with-alpha) 0%%)))
    (do-use (. canvas saved-state)
      (call (. canvas translate) (. origin x) (. origin y))
      (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) masonry)
      (call (. (call (. glazing casing-outline) (+ lead-width 18)) outline) canvas)
      (for (in pane (. glazing panes regions))
        (let box (. pane path bounding-box))
        (do-use (. canvas saved-state)
          (call (. pane path clip) canvas)
          (call (. canvas fill-gradient) box (call glow (call (. glazing glass-of) pane) box))
        )
      )
      (= (. canvas fill-color) lead)
      (call (. (call (. glazing lead-outline) lead-width) outline) canvas)
      (= (. canvas fill-color) solder)
      (for (in vertex (. glazing network vertices))
        (call (. canvas circle) (. vertex position x) (. vertex position y) (* lead-width 0.42))
      )
    )
  )
)

(type + Glazing
  (prop + network _ (= (call tracery)))
  (prop + panes _ (= (call NetworkRegions)))
  (prop + edits Int)
  (prop _ glass _ (= (call (of Map Index Int))))
  (prop _ regions _ (= (call NetworkRegionWorkspace)))
  (prop _ leads _ (= (call NetworkStrokeWorkspace)))
  (prop _ casing _ (= (call NetworkStrokeWorkspace)))
  (prop _ seed Int)
  (fn-do + This _
    (call reglaze)
  )
  (fn-do + reglaze _
    (+= seed 1)
    (call (. glass clear))
    (call reshape)
  )
  (fn-do + reshape _
    (let before panes)
    (= panes (call (. regions resolve) network))
    (for (in pane (. panes regions))
      (if (not (has glass (. pane id)))
        (= ([] glass (. pane id)) (call inherit pane before))
      )
    )
    (for (in id (. panes retired))
      (-= ([] glass id))
    )
    (+= edits 1)
  )
  (fn-do + cycle _
    (param point Point)
    (let pane (call (. panes pick) point))
    (return-if (if (not pane)))
    (blank)
    (= ([] glass (. pane id)) (% (+ (?? ([] glass (. pane id)) 0) 1) (. jewels length)))
    (+= edits 1)
  )
  (fn-do + move-joint _
    (param id Index)
    (param point Point)
    (call (. network move-vertex) id point)
    (call reshape)
  )
  (fn-do + bend-lead _
    (param hit NetworkHit)
    (param displacement Point)
    (call (. network bend) (. hit segment) (call clamp (. hit parameter) 0.05 0.95) displacement)
    (call reshape)
  )
  (fn-do + joint-near (? Index)
    (param point Point)
    (param reach Float)
    (let best (? Index))
    (let nearest reach)
    (for (in vertex (. network vertices))
      (let gap (call (. vertex position distance) point))
      (if (< gap nearest)
        (= best (. vertex id))
        (= nearest gap)
      )
    )
    (return best)
  )
  (fn-expr + glass-of RGBA
    (param pane NetworkRegion)
    ([] jewels (?? ([] glass (. pane id)) 0))
  )
  (fn-do + lead-outline Path
    (param width Float)
    (return (call (. leads resolve) network width))
  )
  (fn-do + casing-outline Path
    (param width Float)
    (return (call (. casing resolve) network width))
  )
  (fn-do _ inherit Int
    (param pane NetworkRegion)
    (param before NetworkRegions)
    (let best (? Int))
    (let most 0.0)
    (for (in old (. before regions))
      (let known ([] glass (. old id)))
      (let shared (call overlap pane old true))
      (if (and known (call network-has-id (. pane predecessors) (. old id)) (or (not best) (> shared most)))
        (= best known)
        (= most shared)
      )
    )
    (return-if best (if best))
    (let start (% (+ (* (. pane id) 5) (* seed 3)) (. jewels length)))
    (for (in step (..< 0 (. jewels length)))
      (let choice (% (+ start step) (. jewels length)))
      (let taken (call some (. panes regions) (:where (and (== ([] glass (. each id)) choice) (> (call overlap pane each false) 0)))))
      (return-if choice (if (not taken)))
    )
    (return start)
  )
)

(fn-do + overlap Float
  (param a NetworkRegion)
  (param b NetworkRegion)
  (param same-way Bool)
  (let total 0.0)
  (for (in x (. a boundaries))
    (for (in y (. b boundaries))
      (let low (call max (call min (. x start) (. x end)) (call min (. y start) (. y end))))
      (let high (call min (call max (. x start) (. x end)) (call max (. y start) (. y end))))
      (if (and (== (. x source) (. y source)) (== (== (. x along) (. y along)) same-way) (< low high))
        (+= total (- high low))
      )
    )
  )
  (return total)
)

(fn-expr + glow Gradient
  (param color RGBA)
  (param box Rect)
  (call RadialGradient
    (block
      (arg (+ (. box center) (call Point (* (. box width) -0.18) (* (. box height) -0.22))))
      (arg 0)
      (arg (. box center))
      (arg (* (call max (. box width) (. box height)) 0.75))
      (arg
        (list
          (call GradientStop 0%% (call (. (call RGBA 1 1 1 0.55) over) color))
          (call GradientStop 0.5%% color)
          (call GradientStop 1%% (call (. (call RGBA 0 0 0 0.45) over) color))
        )
      )
    )
  )
)

(fn-do + tracery VectorNetwork
  (let net (call VectorNetwork))
  (let rim (list Index))
  (for (in point (call (of List Point) (tuple 40 250) (tuple 40 365) (tuple 40 480) (tuple 40 570) (tuple 200 570) (tuple 360 570) (tuple 360 480) (tuple 360 365) (tuple 360 250)))
    (+= rim (call (. net add-vertex) point))
  )
  (for (in i (..< 1 (. rim length)))
    (call (. net connect) ([] rim (- i 1)) ([] rim i))
  )
  (let apex (call (. net add-vertex) (tuple 200 40)))
  (let east (call (. net split) (call (. net connect) ([] rim 8) apex (tuple 0 -98) (tuple 94 26)) 0.5))
  (let west (call (. net split) (call (. net connect) apex ([] rim 0) (tuple -94 26) (tuple 0 -98)) 0.5))
  (let left (call (. net add-vertex) (tuple 136 250)))
  (let right (call (. net add-vertex) (tuple 264 250)))
  (call (. net connect) ([] rim 0) left)
  (call (. net connect) left right)
  (call (. net connect) right ([] rim 8))
  (call (. net connect) ([] rim 4) apex)
  (let rose (call Point 200 150))
  (for (in radius (list 66.0 26.0))
    (let disc (call circle rose radius))
    (call (. disc rotate) 45deg rose)
    (call (. net add-network) (call network-from-path disc))
  )
  (call (. net connect) west east (tuple 70 45) (tuple -70 45))
  (call (. net connect) ([] rim 4) ([] rim 0) (tuple -70 -130) (tuple 60 40))
  (call (. net connect) ([] rim 4) left (tuple -28 -150) (tuple 30 60))
  (call (. net connect) ([] rim 4) right (tuple 28 -150) (tuple -30 60))
  (call (. net connect) ([] rim 4) ([] rim 8) (tuple 70 -130) (tuple -60 40))
  (call (. net connect) ([] rim 1) ([] rim 7) (tuple 90 160) (tuple -90 160))
  (call (. net connect) ([] rim 2) ([] rim 6) (tuple 90 -160) (tuple -90 -160))
  (return net)
)
