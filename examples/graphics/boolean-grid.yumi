./vector-scene
/graphics/appearance
/graphics/canvas
/graphics/color
/graphics/effect
/graphics/primitives
/graphics/shapes
/graphics/tests/support/boolean-grid-cells
/graphics/vector-group
/stream/combine
/units

<VectorScene scene
    size = (1180, 1120)
    output = "/private/tmp/yumi-boolean-grid.svg"
    background = RGBA(96%, 98%, 100%)

    <BooleanGridImage

scene.render()

━━━━━━━━━━━━━━━━━━━━
+ BooleanGridImage is VectorGroup

+ columns = 4
+ rows = 5
+ margin = 28px
+ gap = 16px

╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-vector
    - canvas Canvas
    - inherited VectorAppearance? = null
    - apply-opacity = true
    - outer-effects VectorEffects? = null
    - area Rect? = null

. scene-size = Dimensions(canvas.width, canvas.height)
. cell-width = (scene-size.width - margin * 2 - gap * (columns - 1)) / columns
. cell-height = (scene-size.height - margin * 2 - gap * (rows - 1)) / rows
for index, cell in indexed(product(0 .. < rows, 0 .. < columns))
    paint-cell()
        - canvas
        - index
        - Rect()
            - margin + (cell-width + gap) * cell[1]
            - margin + (cell-height + gap) * cell[0]
            - cell-width
            - cell-height

━━━━━━━━━━━━━━━━━━━━
_ do paint-cell
    - canvas Canvas
    - index
    - cell Rect

canvas.fill-color = RGBA(100%, 100%, 100%, 74%)
canvas.stroke-color = boolean-grid-cell-border-color()
canvas.stroke-width = 1
rectangle(cell).outline(canvas)

paint-operation-band(canvas, index, cell)
paint-source-fills(canvas, index, cell)
paint-result(canvas, index, cell)
paint-source-outlines(canvas, index, cell)
paint-cell-frame(canvas, cell)

━━━━━━━━━━━━━━━━━━━━
_ do paint-operation-band
    - canvas Canvas
    - index
    - cell Rect

canvas.fill-color = boolean-grid-cell-result-fill-color(index)
canvas.stroke-color = null
rectangle(Rect(cell.x + 1px, cell.y + 1px, cell.width - 2px, 5px)).outline(canvas)

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-fills
    - canvas Canvas
    - index
    - cell Rect

. a = boolean-grid-cell-source-a(index, cell)
. b = boolean-grid-cell-source-b(index, cell)

canvas.stroke-color = null
if is-clip-cell(index)
    canvas.fill-color = boolean-grid-clip-source-a-fill-color()
    a.outline(canvas)
else if !is-subtract-cell(index)
    canvas.fill-color = boolean-grid-source-a-fill-color()
    a.outline(canvas)

    canvas.fill-color = boolean-grid-source-b-fill-color()
    b.outline(canvas)

━━━━━━━━━━━━━━━━━━━━
_ do paint-result
    - canvas Canvas
    - index
    - cell Rect

. result = boolean-grid-cell-result(index, cell)
if result
    if result.count
        canvas.fill-color = boolean-grid-cell-result-fill-color(index)
        canvas.stroke-color = RGBA(3%, 7%, 14%, 20%)
        canvas.stroke-width = 1.25
        result.outline(canvas)

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-outlines
    - canvas Canvas
    - index
    - cell Rect

. a = boolean-grid-cell-source-a(index, cell)
. b = boolean-grid-cell-source-b(index, cell)

canvas.fill-color = null
canvas.stroke-width = 1.5

if is-clip-cell(index)
    canvas.stroke-color = boolean-grid-clip-source-a-stroke-color()
else
    canvas.stroke-color = boolean-grid-source-a-stroke-color()
a.outline(canvas)

if is-subtract-cell(index)
    canvas.stroke-color = RGBA(78%, 15%, 27%, 86%)
    canvas.stroke-width = 2.25
else if is-clip-cell(index)
    canvas.stroke-color = boolean-grid-clip-window-stroke-color()
    canvas.stroke-width = 2.25
else
    canvas.stroke-color = boolean-grid-source-b-stroke-color()
b.outline(canvas)

━━━━━━━━━━━━━━━━━━━━
_ is-subtract-cell Bool
    - index

index % 4 == 2

━━━━━━━━━━━━━━━━━━━━
_ is-clip-cell Bool
    - index

index % 4 == 3

━━━━━━━━━━━━━━━━━━━━
_ do paint-cell-frame
    - canvas Canvas
    - cell Rect

canvas.fill-color = null
canvas.stroke-color = boolean-grid-cell-border-color()
canvas.stroke-width = 1
rectangle(cell).outline(canvas)
