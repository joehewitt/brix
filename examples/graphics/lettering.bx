; Sign lettering from a typed word. `text-path` turns the word into one `Path`
; of glyph outlines, and every layer is geometry made from it: a stroke of the
; outline united with the letters grows a rim, shifted copies of the rim stack
; into a block shadow, a gradient fills the letters as a clip, and the letters
; less a stroke of their outline give the line inside them, counters and all.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/stroke)
(import /graphics/text)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ night RGBA (= (call RGBA "#141b2d")))
(prop _ dusk RGBA (= (call RGBA "#2a3a5c")))
(prop _ cream RGBA (= (call RGBA "#f7ead0")))
(prop _ brick RGBA (= (call RGBA "#8f2d1f")))
(prop _ gold RGBA (= (call RGBA "#ffd166")))
(prop _ ember RGBA (= (call RGBA "#f0712c")))

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Lettering")
      (= size (tuple 820 460))
      (blank)
      (<> LetteringPanel (• flex 1))
    )
  )
)

(type + LetteringPanel (is Box)
  (prop + word _ (= "Brix"))
  (content
    (<> This (• flex-col) (• bg night)
      (<> Box (• flex-row) (• p 16)
        (<> TextInput (• flex 1)
          (= placeholder "Type a word")
          (<-> text word)
        )
      )
      (<> Lettering (• flex 1)
        (= word #word)
      )
    )
  )
)

(type + Lettering (is Box)
  (prop + word String (= ""))
  (depends invalidate-paint word)
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (do-use (. canvas saved-state)
      (call (. canvas fill-gradient) area (call radial-gradient (. area center) (. area width) dusk night))
    )
    (let letters (call fitted (call text-path word (call Font "Avenir Next" 160 (. FontWeight black))) area))
    (return-if (if (not letters)))
    (blank)
    (let depth (* (. (. letters bounding-box) height) 0.08))
    (let rim (?? (call union letters (call band letters (* depth 2.2))) letters))
    (let core (?? (call subtract letters (call band letters (* depth 0.9))) letters))
    (let inline (call band core (* depth 0.18)))
    (let box (. letters bounding-box))
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) brick)
      (for (in step (..< 1 12))
        (let block (call Path rim))
        (call (. block translate) (call Point (* step depth 0.12) (* step depth 0.12)))
        (call (. block outline) canvas)
      )
      (= (. canvas fill-color) cream)
      (call (. rim outline) canvas)
      (call (. letters clip) canvas)
      (call (. canvas fill-gradient) box (call linear-gradient (. box top-left) (call Point (. box x) (. box bottom)) gold ember))
    )
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (call RGBA 100% 97% 88% 85%))
      (call (. inline outline) canvas)
    )
  )
)

(fn-do + band Path
  (param path Path)
  (param width Length)
  (return (call stroke path width (. StrokeAlignment center) (. JoinType round-join-type) (. LineCap round)))
)

(fn-do + fitted (? Path)
  (param path Path)
  (param area Rect)
  (let box (. path bounding-box))
  (return-if null (if (or (<= (. box width) 0) (<= (. box height) 0))))
  (blank)
  (let scale (call min (/ (* (. area width) 0.8) (. box width)) (/ (* (. area height) 0.62) (. box height))))
  (call (. path translate) (call Point (- (. box center x)) (- (. box center y))))
  (call (. path scale) scale)
  (call (. path translate) (- (. area center) (call Point (* (. box width) scale 0.03) (* (. box height) scale 0.05))))
  (return path)
)
