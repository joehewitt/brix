; Contour lines from path offsets. Three hills are merged into one coastline with
; `union`, and an `OffsetPlan` of it is offset again and again: outward into rings
; of water, inward into tiers of land that part into separate peaks as they climb.
; Drag a hill to reshape the island, or into a ring around a lagoon, whose water
; deepens toward its middle. Pick the join that turns each contour's corners, set
; the spacing between contours, and raise the sea to drown the lowlands and split
; the island at its saddles.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ sea RGBA (= (call RGBA "#163851")))
(prop _ coast-ink RGBA (= (call RGBA "#1f2a30")))
(prop _ water-line RGBA (= (call RGBA 100% 100% 100% 30%)))
(prop _ land-line RGBA (= (call RGBA 14% 12% 10% 35%)))
(prop _ water-ramp (list RGBA) (= (in (call RGBA each) (list "#a7dbe0" "#4f97b3" "#1d4a68"))))
(prop _ land-ramp (list RGBA) (= (in (call RGBA each) (list "#6da665" "#a9c672" "#e6d48c" "#c8955a" "#94705a" "#f2eee8"))))
(prop _ water-rings _ (= 7))
(prop _ highest-tier _ (= 80))
(prop _ sharpest-miter Length (= 4))
(prop _ joins (list (tuple String JoinType))
  (=
    (list
      (tuple "Round" .round-join-type)
      (tuple "Bevel" .bevel-join-type)
      (tuple "Miter" .miter-join-type)
      (tuple "Square" .square-join-type)
    )
  )
)

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Contours")
      (= size (tuple 900 660))
      (blank)
      (<> ContourPanel (• flex 1))
    )
  )
)

(type + ContourPanel (is Box)
  (prop + spacing F64 (= 12))
  (prop + tide F64 (= 0))
  (prop + join JoinType (= .round-join-type))
  (content
    (<> This (• flex-col)
      (<> ContourMap (• flex 1) (• bg sea)
        (= spacing #spacing)
        (= tide #tide)
        (= join #join)
      )
      (<> Box (• flex-row) (• items-center) (• p 12)
        (= gap 12)
        (<> (of SegmentedControl JoinType)
          (<-> selected join)
          (for (in (tuple title kind) joins)
            (<> (of Segment JoinType) (text: title)
              (= value kind)
            )
          )
        )
        (<> Label (text: "Spacing"))
        (<> Slider (• w 160)
          (= minimum 5)
          (= maximum 30)
          (<-> value spacing)
        )
        (<> Label (text: "Sea level"))
        (<> Slider (• w 160)
          (= minimum -40)
          (= maximum 90)
          (<-> value tide)
        )
      )
    )
  )
)

(type + Hill (is Tuple)
  (prop + spot Point)
  (prop + reach Float)
  (prop + points Int)
  (fn-expr + moved Hill
    (param to Point)
    (call Hill to reach points)
  )
  (fn-expr + center Point
    (param area Rect)
    (+ (. area top-left) (call Point (* (. spot x) (. area width)) (* (. spot y) (. area height))))
  )
  (fn-expr + shape Path
    (param area Rect)
    (param unit Length)
    (if-expr (== points 0) (call circle middle radius) (call star-path middle radius (* radius 0.58) points))
    (where
      (lazy middle (call center area))
      (lazy radius (* reach unit))
    )
  )
)

(type + ContourMap (is Box)
  (prop + spacing F64 (= 12))
  (prop + tide F64 (= 0))
  (prop + join JoinType (= .round-join-type))
  (prop + hills (list Hill)
    (=
      (call List
        (block
          (item (call Hill (call Point 0.36 0.5) 0.33 6))
          (item (call Hill (call Point 0.62 0.6) 0.24 0))
          (item (call Hill (call Point 0.66 0.3) 0.15 0))
        )
      )
    )
  )
  (prop _ grabbed Index (= 0))
  (rule This
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (depends invalidate-paint spacing tide hills join)
  (subscribe-for (on event pointer-down)
    (= grabbed (call nearest-hill (. event point)))
    (call follow (. event point))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call follow (. event point))
    (call (. event cancel))
  )
  (fn-do _ nearest-hill Index
    (param point Point)
    (let frame (call Rect 0 0 (. bounds width) (. bounds height)))
    (let best Index 0)
    (let best-gap (call (. point distance) (call (. ([] hills 0) center) frame)))
    (for (in index (..< 1 (. hills length)))
      (let gap (call (. point distance) (call (. ([] hills index) center) frame)))
      (if (< gap best-gap)
        (= best index)
        (= best-gap gap)
      )
    )
    (return best)
  )
  (fn-do _ follow _
    (param point Point)
    (let spot (call Point (/ (. point x) (. bounds width)) (/ (. point y) (. bounds height))))
    (let next (list Hill))
    (for (in index (..< 0 (. hills length)))
      (let hill ([] hills index))
      (+= next (if-expr (== index grabbed) (call (. hill moved) spot) hill))
    )
    (= hills next)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let unit (call min (. area width) (. area height)))
    (let coast (call coastline hills area unit))
    (return-if (if (not coast)))
    (blank)
    (let plan (call offset-plan coast))
    (do-use (. canvas saved-state)
      (for (in ring (..< 0 water-rings))
        (let depth (- water-rings ring))
        (let fill (call ramp water-ramp (/ (- depth 1) (- water-rings 1.0))))
        (call paint-level canvas (call offset-plan-path plan (- (* depth spacing) tide) join sharpest-miter) fill water-line 2px)
      )
      (call paint-level canvas (call offset-plan-path plan (- tide) join sharpest-miter) (call ramp land-ramp (/ tide (* unit 0.16))) coast-ink 3.5px)
      (for (in tier (..< (+ (as (call floor (/ tide spacing)) Int) 1) highest-tier))
        (let level (call offset-plan-path plan (* tier (- spacing)) join sharpest-miter))
        (if (not (. level count))
          (break)
        )
        (let fill (call ramp land-ramp (/ (* tier spacing) (* unit 0.16))))
        (call paint-level canvas level fill land-line (if-expr (== (% tier 5) 0) 3.5px 1.8px))
      )
    )
  )
)

(fn-do + coastline (? Path)
  (param hills (list Hill))
  (param area Rect)
  (param unit Length)
  (let coast (? Path) null)
  (for (in hill hills)
    (let shape (call (. hill shape) area unit))
    (= coast (if-expr coast (call union coast shape) shape))
  )
  (return coast)
)

(fn-do + paint-level _
  (param canvas Canvas)
  (param path Path)
  (param fill RGBA)
  (param line RGBA)
  (param weight Length)
  (return-if (if (not (. path count))))
  (blank)
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) line)
  (= (. canvas stroke-width) weight)
  (call (. path outline) canvas)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) fill)
  (call (. path outline) canvas)
)

(fn-expr + ramp RGBA
  (param stops (list RGBA))
  (param t Float)
  (call blend ([] stops index) ([] stops (call min (+ index 1) last)) (- scaled index))
  (where
    (lazy last (- (. stops length) 1))
    (lazy scaled (* (call clamp t 0.0 1.0) last))
    (lazy index (as scaled Index))
  )
)

(fn-expr + blend RGBA
  (param from RGBA)
  (param to RGBA)
  (param t Float)
  (call RGBA (call mix (. from red) (. to red)) (call mix (. from green) (. to green)) (call mix (. from blue) (. to blue)))
  (where
    (lazy mix (=> (a b) (+ a (* (- b a) t))))
  )
)

(fn-do + star-path Path
  (param center Point)
  (param outer Length)
  (param inner Length)
  (param points Int)
  (let path (call Path))
  (for (in index (..< 0 (* points 2)))
    (let radius (if-expr (== (% index 2) 0) outer inner))
    (let angle (as (- (/ (* 180deg index) points) 90deg) Radians))
    (let point (+ center (call Point (* radius (call cos angle)) (* radius (call sin angle)))))
    (if (== index 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (call (. path close))
  (return path)
)
