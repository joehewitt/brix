; Booleans on paths. A star and a ring are two `Path`s, and `union`, `subtract`
; and `intersect` each make a new path from them, curves and holes included. The
; fourth tile combines them: what either covers, less what both cover. Drag in
; any tile to move the ring, and all four results are worked out again.
(import /graphics/boolean)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(import /units)
(blank)
(prop _ paper RGBA (= (call RGBA "#f4f1ea")))
(prop _ ink RGBA (= (call RGBA "#28323c")))
(prop _ accent RGBA (= (call RGBA "#e0603a")))
(prop _ ghost RGBA (= (call RGBA 16% 20% 24% 35%)))

(main
  (<> App
    (<> Window (• flex-col)
      (= title "Booleans")
      (= size (tuple 960 340))
      (blank)
      (<> BooleanPanel (• flex 1))
    )
  )
)

(type + BooleanPanel (is Box)
  (prop + spot _ (= (call Point 0.66 0.4)))
  (content
    (<> This (• flex-row) (• p 16) (• bg paper)
      (= gap 16)
      (for (in operation (list "union" "subtract" "intersect" "exclude"))
        (<> Box (• flex-col) (• flex 1)
          (= gap 8)
          (<> BooleanArt (• flex 1)
            (= operation operation)
            (<-> spot spot)
          )
          (<> Label (text: operation)
            (= color ink)
            (= text-alignment (. TextAlignment center))
          )
        )
      )
    )
  )
)

(type + BooleanArt (is Box)
  (prop + operation String (= "union"))
  (prop + spot Point (= (call Point 0.5 0.5)))
  (depends invalidate-paint spot)
  (subscribe-for (on event pointer-down)
    (call follow (. event point))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call follow (. event point))
    (call (. event cancel))
  )
  (fn-do _ follow _
    (param point Point)
    (= spot (call Point (/ (. point x) (. bounds width)) (/ (. point y) (. bounds height))))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let area content-bounds)
    (let reach (* (call min (. area width) (. area height)) 0.4))
    (let middle (. area center))
    (let star (call star-path middle reach (* reach 0.45) 6))
    (let ring (call ring-path (+ (. area top-left) (call Point (* (. spot x) (. area width)) (* (. spot y) (. area height)))) (* reach 0.62) (* reach 0.3)))
    (let result (call combine operation star ring))
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) accent)
      (if result
        (call (. result outline) canvas)
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) ghost)
      (= (. canvas stroke-width) 1.5px)
      (call (. star outline) canvas)
      (call (. ring outline) canvas)
    )
  )
)

(fn-expr + combine (? Path)
  (param operation String)
  (param a Path)
  (param b Path)
  (match operation
    (case= "union"
      (call union a b)
    )
    (case= "subtract"
      (call subtract a b)
    )
    (case= "intersect"
      (call intersect a b)
    )
    (default
      (call exclude a b)
    )
  )
)

(fn-do + exclude (? Path)
  (param a Path)
  (param b Path)
  (let both (call union a b))
  (let shared (call intersect a b))
  (return-if both (if (not shared)))
  (return-if null (if (not both)))
  (return (call subtract both shared))
)

(fn-do + star-path Path
  (param center Point)
  (param outer Length)
  (param inner Length)
  (param points Int)
  (let path (call Path))
  (for (in index (..< 0 (* points 2)))
    (let radius (if-expr (== (% index 2) 0) outer inner))
    (let angle (as (- (/ (* 180deg index) points) 90deg) Radians))
    (let point (+ center (call Point (* radius (call cos angle)) (* radius (call sin angle)))))
    (if (== index 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (call (. path close))
  (return path)
)

(fn-do + ring-path Path
  (param center Point)
  (param outer Length)
  (param inner Length)
  (let path (call Path))
  (call (. path append-circle) center outer)
  (let hole (call Path))
  (call (. hole append-circle) center inner)
  (call (. path add-path-reverse) hole)
  (return path)
)
