./vector-scene
/graphics/appearance
/graphics/canvas
/graphics/color
/graphics/effect
/graphics/primitives
/graphics/tests/support/stroke-grid-cells
/graphics/vector-group
/units

<VectorScene scene
    size = (1120, 840)
    output = "/private/tmp/yumi-stroke-grid.svg"
    background = RGBA(96%, 98%, 100%)

    <StrokeGridImage

scene.render()

━━━━━━━━━━━━━━━━━━━━
+ StrokeGridImage is VectorGroup

+ columns = 4
+ rows = 3
+ margin = 28px
+ gap = 20px

╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-vector
    - canvas Canvas
    - inherited VectorAppearance? = null
    - apply-opacity = true
    - outer-effects VectorEffects? = null
    - area Rect? = null

. scene-size = Dimensions(canvas.width, canvas.height)
. cell-width = (scene-size.width - margin * 2 - gap * (columns - 1)) / columns
. cell-height = (scene-size.height - margin * 2 - gap * (rows - 1)) / rows
. index = 0

for row in 0 .. < rows
    for col in 0 .. < columns
        paint-cell()
            - canvas
            - index
            - Rect()
                - margin + (cell-width + gap) * col
                - margin + (cell-height + gap) * row
                - cell-width
                - cell-height
        index += 1

━━━━━━━━━━━━━━━━━━━━
_ do paint-cell
    - canvas Canvas
    - index
    - cell Rect

canvas.fill-color = RGBA(100%, 100%, 100%, 72%)
canvas.stroke-color = RGBA(3%, 7%, 14%, 10%)
canvas.stroke-width = 1
canvas.rect(cell)

. stroked = stroke-grid-cell-stroked-path(index, cell)

canvas.fill-color = stroke-grid-cell-fill-color(index)
canvas.stroke-color = null
stroked.outline(canvas)
