; Tuple patterns: a match can decide on two values at once. Arms are tried in
; order, and `_` stands for a value the arm does not care about.
(main
  (for (in n (.. 1 15))
    (print (call fizzbuzz n))
  )
)

(fn-expr + fizzbuzz String
  (param n Int)
  ; The subject is a tuple made on the spot from the two remainders.
  (match (tuple (% n 3) (% n 5))
    (case (tuple 0 0)
      "FizzBuzz"
    )
    (case (tuple 0 _)
      "Fizz"
    )
    (case (tuple _ 0)
      "Buzz"
    )
    ; `default` takes whatever no arm above it did.
    (default
      (str n)
    )
  )
)
