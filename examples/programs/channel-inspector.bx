(import /core/channel)
(import /time)
(blank)
(type-line + Order (is (tuple (: id Int) (: sku String) (: quantity Int))))
(type-line + Status (is (tuple (: order-id Int) (: step String))))
(blank)

(main
  (let orders (of SyncChannel Order))
  (let statuses (call (of SyncBufferedChannel Status)))
  (let alerts (call (of AsyncChannel String)))
  (blank)
  (probe-group + channel.inspector (text: "Channel inspector showcase"))
  (probe-log _ (text: "This demo creates three kinds of channel traffic for the probe inspector."))
  (probe-log _ (text: "Open these first; they are the stable handles for the rest of the run."))
  (probe-log _ (text: "orders: sync rendezvous channel " (snapshot orders)))
  (probe-log _ (text: "statuses: buffered backlog channel " (snapshot statuses)))
  (probe-log _ (text: "alerts: async broadcast channel " (snapshot alerts)))
  (blank)
  (probe-group + _ (text: "SyncChannel rendezvous: the reader waits, then each write wakes it"))
  (blank)
  (do-new
    (probe-log _ (text: "orders worker is waiting " (snapshot orders)))
    (for (in order orders)
      (probe-log _ (text: "orders worker received " order " with channel state " (snapshot orders)))
      (call (. 0.45s wait))
    )
  )
  (blank)
  (for (in i (..< 0 14))
    (call (. 0.45s wait))
    (let order (call Order (+ 100 i) "apples" (+ i 1)))
    (probe-log _ (text: "orders producer writes " order))
    (<- orders order)
  )
  (blank)
  (call (. 1.2s wait))
  (call (. orders close))
  (probe-group - _ (text: "orders channel closed " (snapshot orders)))
  (blank)
  (probe-group + _ (text: "SyncBufferedChannel backlog: writes pile up before a consumer drains them"))
  (blank)
  (do-new
    (call (. 3s wait))
    (for (in update statuses)
      (probe-log _ (text: "status consumer drained " update " and sees " (snapshot statuses)))
      (call (. 0.5s wait))
    )
  )
  (blank)
  (for (in i (..< 0 24))
    (call (. 0.3s wait))
    (let update (call Status (+ 200 (% i 6)) "queued"))
    (<- statuses update)
    (probe-log _ (text: "status producer wrote " update " with channel state " (snapshot statuses)))
  )
  (blank)
  (call (. 3s wait))
  (call (. statuses close))
  (probe-group - _ (text: "status channel closed " (snapshot statuses)))
  (blank)
  (probe-group + _ (text: "AsyncChannel broadcast: two subscribers receive the same writes"))
  (blank)
  (for (on alert alerts)
    (probe-log _ (text: "subscriber A saw alert \"" alert "\" with " (snapshot alerts)))
  )
  (blank)
  (for (on alert alerts)
    (probe-log _ (text: "subscriber B saw alert \"" alert "\" with " (snapshot alerts)))
  )
  (blank)
  (call (. 1.5s wait))
  (probe-log _ (text: "alert channel has two subscribers " (snapshot alerts)))
  (blank)
  (for (in i (..< 0 16))
    (call (. 0.5s wait))
    (let alert (str "alert " i))
    (probe-log _ (text: "alert producer broadcasts \"" alert "\" with channel state " (snapshot alerts)))
    (<- alerts alert)
  )
  (blank)
  (call (. 1.5s wait))
  (call (. alerts close))
  (probe-group - _ (text: "alert channel closed " (snapshot alerts)))
  (blank)
  (probe-log _ (text: "Channel inspector showcase complete"))
  (call (. 4s wait))
  (probe-group - channel.inspector)
)
