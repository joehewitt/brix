; Text bodies: a function whose body is the text it gives, one row for each
; line. Values go into a line with `str`, and the bindings under `where` supply
; the lines that repeat or may be missing.
(import /stream/aggregate)
(blank)

(main
  (let order
    (call List
      (block
        (bullet (call Item "Coffee" 2 4))
        (bullet (call Item "Bagel" 1 3))
        (bullet (call Item "Juice" 3 5))
      )
    )
  )
  (print (call receipt "Ada" order true))
  (print "")
  (print (call receipt "Grace" order false))
)

(type + Item (is Tuple)
  (prop + name String)
  (prop + quantity Int)
  (prop + price Int)
)

; The rows of `paragraph` are laid out as the receipt prints.
(fn-expr + receipt _
  (param customer String)
  (param items (list Item))
  (param is-member Bool)
  (paragraph
    (str "Receipt for " customer)
    "====================="
    (str rows)
    "---------------------"
    (str "Total: " total " dollars" thanks)
  )
  (where
    ; Repeated lines: one text for each item, joined with newlines.
    (lazy rows (call (. "\n" join) lines))
    (lazy lines (in (call item-line each) items))
    (lazy total (call sum (in (* (. each quantity) (. each price)) items)))
    ; A line that may be missing is a value that is the line or an empty text.
    (lazy thanks (if-expr is-member "\nThank you for being a member!" ""))
  )
)

; A text function is called like any other, here once for each item.
(fn-expr + item-line _
  (param item Item)
  (paragraph
    (str (. item quantity) " x " (. item name) " at " (. item price) " each")
  )
)
