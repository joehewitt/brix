(import /time)
(blank)

(main
  (print "Ometer profile demo")
  (print "Open the Console, click the profile button, then run this file.")
  (print "Timers update while it runs; counters appear after the program exits.")
  (blank)
  (let batches (list Int))
  (blank)
  (probe-group + demo.profile.run (text: "profile demo run"))
  (for (in batch (..< 0 6))
    (+= batches batch)
    (probe-count (: batches demo.profile.objects.batches))
    (probe-count demo.profile.batches)
    (probe-group + demo.profile.batch (text: "batch " batch))
    (print (str "batch " (+ batch 1)))
    (call parse-batch batch)
    (call render-batch batch)
    (call (. 0.25s wait))
    (probe-group - demo.profile.batch (text: "batch " batch " done"))
  )
  (blank)
  (probe-group - demo.profile.run (text: "profile demo run done"))
  (blank)
  (print "Done. Save this stopped run from the profile panel to test comparisons.")
)

(fn-do + parse-batch _
  (param batch Int)
  (probe-group + demo.profile.parse (text: "parse batch " batch))
  (let tokens (+ 12 batch))
  (for (in token (..< 0 tokens))
    (probe-count demo.profile.parse.tokens)
    (if (== (% token 4) 0)
      (probe-group + demo.profile.parse.slow-token (text: "slow token"))
      (call (. 0.08s wait))
      (probe-group - demo.profile.parse.slow-token (text: "slow token done"))
      (else
        (call (. 0.015s wait))
      )
    )
  )
  (probe-group - demo.profile.parse (text: "parse batch " batch " done"))
)

(fn-do + render-batch _
  (param batch Int)
  (probe-group + demo.profile.render (text: "render batch " batch))
  (for (in pass (..< 0 3))
    (probe-group + demo.profile.render.pass (text: "render pass " pass))
    (let pixels (+ 18 (* batch 2)))
    (for (in pixel (..< 0 pixels))
      (probe-count demo.profile.render.pixels 2)
      (if (== (% pixel 9) 0)
        (call (. 0.02s wait))
      )
    )
    (probe-group - demo.profile.render.pass (text: "render pass " pass " done"))
  )
  (probe-group - demo.profile.render (text: "render batch " batch " done"))
)
