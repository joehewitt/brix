; Generators: a function that yields gives its values one at a time, and only
; as far as its reader asks. This one never ends, so each reader says where
; to stop.
(import /stream/aggregate)
(blank)

(main
  ; `while` ends the reading at the first prime that fails the test.
  (let small (in each (call primes) (while (< each 40))))
  (print (str "below 40: " (call (. ", " join) small)))
  (blank)
  ; `when` skips items, and `break` leaves the generator where it stands.
  (for (in prime (call primes) (when (> prime 1000)))
    (print (str "first above 1000: " prime))
    (break)
  )
  (blank)
  ; A generator kept in a local remembers its place between reads.
  (let source (call primes))
  (print (str "one at a time: " (<- source) ", " (<- source) ", " (<- source)))
)

(fn-do + primes _
  (let found (of List Int))
  (let candidate 2)
  ; The loop has no end. It runs only up to the next `yield` each time a reader asks.
  (while true
    (if (call all found (:where (!= (% candidate each) 0)))
      (+= found candidate)
      (yield candidate)
    )
    (+= candidate 1)
  )
)
