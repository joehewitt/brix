; Units: a unit can be declared as a product or a quotient of others. Lengths
; multiply into an area, an area's square root is a length, and a rate per area
; times an area is an amount.
(import /math)
(import /units)
(blank)
(type-line + SquareMeters (alias sqm) (is F64))
(unit + 1sqm (* 1meters 1meters))
(blank)
(type-line + Grams (alias g) (is F64))
(type-line + Kilograms (alias kg) (is 1000g))
(type-line + Feed (alias gpsm) (is F64))
(unit + 1gpsm (/ 1g 1sqm))
(blank)

(main
  ; Meters times centimeters is an area, in the unit declared as meters squared.
  (let bed (* 4meters 225cm))
  (print (str "the bed covers " (as bed UnitString)))
  ; A percentage scales the area and keeps its unit.
  (let planted (* 75% bed))
  (print (str "75% planted is " (as planted UnitString)))
  (blank)
  ; Grams per square meter times square meters leaves grams.
  (let feed (* 40gpsm planted))
  (print (str "at 40 g per square meter it takes " (as (as feed Kilograms) UnitString)))
  (print (str "a 2 kg bag feeds " (call (. (/ 2kg 40gpsm) places) 1) " sqm"))
  (blank)
  ; The square root of an area is the side of a square that size.
  (let side (call sqrt bed))
  (print (str "a square bed that size has " (as side UnitString) " sides"))
  (print (str "with sides twice as long it covers " (as (%% (* side 2) 2) UnitString)))
)
