; Units: a pace is declared as minutes per kilometer, so a time divided by a
; distance is a pace, and a pace times a distance is a time, whatever units each
; is written in.
(import /time/duration)
(import /units/distance)
(blank)
(type-line + Pace (alias mpk) (is F64))
(unit + 1mpk (/ 1minutes 1km))
(blank)

(main
  (let marathon 26.2188miles)
  (let finish (+ 3hours 30minutes))
  (blank)
  (print (str "the course is " (call (. (as marathon Kilometers) places) 1) " km"))
  ; Hours over miles come out in minutes per kilometer.
  (print (str "pace: " (call (. (/ finish marathon) places) 2) " minutes per km"))
  (for (in mark (list 10km 21.1km 30km 42.2km))
    (let reached (call split mark marathon finish))
    (print (str (as mark UnitString) " after " (call (. reached places) 0) " minutes"))
  )
  (blank)
  ; A pace times miles leaves minutes, which convert to hours.
  (let steady (as (* 6mpk marathon) Hours))
  (print (str "at 6 minutes per km the course takes " (call (. steady places) 2) " hours"))
)

(fn-expr + split Minutes
  (param mark Kilometers)
  (param distance Kilometers)
  (param time Minutes)
  ; Two distances divide to a plain fraction, which scales the time.
  (* time (/ mark distance))
)
