; Stream grammars: over bytes, a pattern decodes a binary format. A number
; type reads as many bytes as it holds, and a field already read can say how
; many times a later part repeats.
; Two frames back to back: a station, a count, then that many two-byte readings.
(main
  (let wire (list Byte) (list 7 3 0 215 0 198 1 4 9 1 0 180))
  (blank)
  ; Nothing marks where a frame ends. Each count says how far its frame runs.
  (for (in report (~> wire \report))
    (print (str "station " (. report station) ": " (call degrees (. report readings))))
  )
)

(type + Report (is Tuple)
  (prop + station U8)
  (prop + readings (list U16))
)

(fn-expr + report Report (over: Byte)
  ; `U16` takes two bytes, the high one first, and `count` repeats it.
  (~ (seq (: station U8) (: count U8) (: readings ({} U16 count)))
    (call Report station readings)
  )
)

(fn-expr + degrees String
  (param readings (list U16))
  ; A reading is a temperature in tenths of a degree.
  (call (. ", " join) (in (/ (as each Float) 10) readings))
)
