; The Mandelbrot set as text. A comprehension over a range builds each row,
; and a function whose body is one value picks each character.
(blank)

(main
  (for (in row (.. -10 10))
    ; `each` is the column: the comprehension gives one character for each item of the range.
    (print (call (. "" join) (in (call shade (/ each 28.0) (/ row 10.0)) (.. -58 20))))
  )
)

(fn-expr + shade Char
  (param cx Float)
  (param cy Float)
  ; The answer stands first, and the names it reads are worked out below it.
  ([] palette level)
  (where
    (lazy level (/ (call escape-time cx cy) 3))
    (lazy palette " .:-=+*#%@")
  )
)

(fn-do + escape-time Int
  (param cx Float)
  (param cy Float)
  (let x 0.0)
  (let y 0.0)
  (for (in step (..< 0 27))
    (return-if step (if (> (+ (* x x) (* y y)) 4)))
    (blank)
    ; Both sides are tuples, so x and y change together, each from the old values.
    (= (tuple x y) (tuple (+ (- (* x x) (* y y)) cx) (+ (* 2 x y) cy)))
  )
  (return 27)
)
