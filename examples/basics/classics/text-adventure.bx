; A grammar and a state machine together: the grammar turns each typed line into
; a command, and the room the player is in decides what that command does.
(main
  (let game (call Game))
  (let typed
    (call List
      (block
        (item "go down")
        (item "take lamp")
        (item "dance")
        (item "go down")
        (item "take gold")
      )
    )
  )
  (for (in line typed)
    (print (str "> " line))
    ; A line the grammar does not accept gives null.
    (let command
      (match? line
        (~ \command)
      )
    )
    (if command
      (<- (. game commands) command)
      (else
        (print "You can't do that.")
      )
    )
  )
)

(type + Command (is Union)
  (variant go String)
  (variant take String)
)

(fn-expr + command Command (over: Char)
  (~ (seq "go " (: place \word))
    (call (. Command go) place)
  )
  (~ (seq "take " (: item \word))
    (call (. Command take) item)
  )
  (where
    (lazy word String
      (pattern
        (~ (+ (chars "a-z")))
      )
    )
  )
)

(type + Game
  (event + commands Command)
  (prop + has-lamp _ (= false))
  (prop + room _
    (machine
      (state hall
        (print "A dusty hall. Stairs lead down. A lamp sits on a shelf.")
        (blank)
        ; A loop in a case hears commands only while its room is the active one.
        (for (on (| (call .take "lamp")) commands)
          (= has-lamp true)
          (print "You take the lamp.")
        )
        (for (on (| (call .go "down")) commands (when (not has-lamp)))
          (print "It is too dark to go down.")
        )
        (blank)
        (then cellar (trigger for (call .go "down") commands has-lamp))
      )
      (blank)
      (state cellar
        (print "The lamp shows a cellar and a heap of gold.")
        (blank)
        (then rich (trigger for (call .take "gold") commands))
      )
      (blank)
      (state rich
        (print "You are rich. The end.")
      )
    )
  )
)
