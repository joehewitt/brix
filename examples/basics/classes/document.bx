; Document keeps its text in this file. Its facets, in the files beside it, add
; undo and search to the same objects.
(import ./document.history)
(import ./document.search)
(blank)

(type + Document
  (prop + text String (= ""))
  (fn-do + This _
    (param text _)
  )
  (fn-do + type-text _
    (param more String)
    (call record)
    (= text (++ text more))
  )
)
