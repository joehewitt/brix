; Undo is a facet of Document. The texts it keeps are stored in each Document,
; and only this file reaches them. `record` is shared with Document's file
; family, so the owner and the facets that see this one can call it.
(import ./document)
(blank)

(type + DocumentHistory (facet-of Document)
  (prop _ earlier (list String) (= (call (of List String))))
  (fn-do ^ record _
    (+= earlier text)
  )
  (fn-do + undo _
    (= text (?? (call (. earlier pop)) text))
  )
)
