; Extensions: `extend` adds members to a type declared elsewhere, even a
; built-in one. Here every Int learns to write itself as a Roman numeral, and
; every String learns to read one.
(prop + numerals _
  (=
    (call List
      (block
        (item (tuple 1000 "M"))
        (item (tuple 900 "CM"))
        (item (tuple 500 "D"))
        (item (tuple 400 "CD"))
        (item (tuple 100 "C"))
        (item (tuple 90 "XC"))
        (item (tuple 50 "L"))
        (item (tuple 40 "XL"))
        (item (tuple 10 "X"))
        (item (tuple 9 "IX"))
        (item (tuple 5 "V"))
        (item (tuple 4 "IV"))
        (item (tuple 1 "I"))
      )
    )
  )
)
(blank)
; `roman` reads like a property Int always had, on a name and on a sum alike.
(main
  (for (in year (list 4 9 14 40 1994 2024))
    (print (str year " is " (. year roman)))
  )
  (print (str "1000 + 66 is " (. (+ 1000 66) roman)))
  (print (str "MCMXCIV is " (. "MCMXCIV" from-roman)))
)

(extend + Int
  (fn-do + roman String :get
    ; `:get` makes this a property, read without a call. `this` is the number itself.
    (let rest this)
    (let text "")
    (for (in (tuple value numeral) numerals)
      (while (>= rest value)
        (+= text numeral)
        (-= rest value)
      )
    )
    (return text)
  )
)

(extend + String
  ; The same table read the other way, on another built-in type.
  (fn-do + from-roman Int :get
    (let rest this)
    (let total 0)
    (for (in (tuple value numeral) numerals)
      (while (call (. rest starts-with) numeral)
        (+= total value)
        (= rest ([] rest (... (. numeral length))))
      )
    )
    (return total)
  )
)
