; Pipelines and the stream library: a library function can be the source of a
; pipeline, a stage in the middle, or the reader at the end. The functions in
; `/stream` are generators written in the language, so they fit anywhere a row does.
(import /stream/aggregate)
(import /stream/coincidence)
(import /stream/combine)
(import /stream/filter)
(import /stream/sort)
(blank)

(main
  (let days (list "Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"))
  (let km (list 12 0 30 30 8 55 0))
  (blank)
  ; As a source: `zip` pairs each day with its distance, and the stages take it from there.
  (let rides
    (block
      (spread (call zip days km))
      (pipe ?> (> ([] each 1) 0))
      (pipe *> (str ([] each 0) " " ([] each 1) "km"))
    )
  )
  (print (str "rides: " (call (. ", " join) rides)))
  (blank)
  ; As the reader: `|>` hands the stream to `max`, which reads it to the end.
  (let longest
    (block
      (spread km)
      (pipe ?> (> each 0))
      (pipe |> max)
    )
  )
  (print (str "longest ride: " longest "km"))
  (blank)
  ; A function that takes a callback: `scan` gives the running total after each day.
  (let behind
    (block
      (spread (call scan 0 km (:using (=> (total day) (+ total day)))))
      (pipe ?> (>= each 50))
    )
  )
  (print (str "days with 50km behind me: " (call count behind)))
  (blank)
  ; In the middle: `pairwise` gives each day with the next, and `sort` orders what is kept.
  (let gains
    (block
      (spread (call pairwise km))
      (pipe ?*> (only-if (- (. each b) (. each a)) (if (> (. each b) (. each a)))))
      (pipe |> sort)
    )
  )
  (print (str "gains from one day to the next: " (call (. ", " join) gains)))
  (blank)
  ; Several library stages in a row, each reading the one above it.
  (let lengths
    (block
      (spread km)
      (pipe ?> (> each 0))
      (pipe |> distinct)
      (pipe |> sort)
    )
  )
  (print (str "distinct distances: " (call (. ", " join) lengths)))
  (blank)
  ; A library test reads `each` in its `where`, as a stage does.
  (print (str "a ride over 50km: " (call some km (:where (> each 50)))))
  (print (str "rode every day: " (call all km (:where (> each 0)))))
)
