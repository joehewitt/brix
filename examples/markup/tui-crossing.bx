; A state machine drives a tree in `main`. The crossing below is a plain object
; with three states. The lamps, the sign and even which keys exist all read the
; state that is active, so there is no code that updates the screen.
(import /time/duration)
(import /time/timer)
(import /tui)
(blank)

(main
  (let crossing (call Crossing))
  (blank)
  (<> Window (id: win) (• flex-col) (• bg black)
    (<> Label (text: " Pedestrian crossing ") (• bg blue) (• text white))
    (<> Box (• flex-col) (• p 1)
      ; Each state reads as true while it is active, and `#` keeps the color current.
      (<> Label (text: "● stop")
        (= color (if-expr (. crossing #is-stopped) red grey))
      )
      (<> Label (text: "● slow")
        (= color (if-expr (. crossing #is-slowing) yellow grey))
      )
      (<> Label (text: "● go")
        (= color (if-expr (. crossing #is-flowing) lime grey))
      )
    )
    (if (. crossing #is-stopped)
      (<> Label (text: " WALK ") (• bg green) (• text black))
      (else
        (<> Label (text: " WAIT ") (• bg maroon) (• text white))
      )
    )
    ; A shortcut is an element like any other, so a branch can add and remove it.
    ; The button can only be pressed while the cars are moving.
    (if (. crossing #is-flowing)
      (<> Shortcut (text: "Press the button")
        (= key .space)
        (= action (=> () :do (<- (. crossing presses) true)))
      )
    )
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. win close))))
    )
    (<> StatusBar)
  )
  (blank)
  (call (. win open))
)

(type + Crossing
  ; The crossing knows nothing about the screen. Cars flow until someone presses
  ; the button, and a timer that belongs to a state runs only while it is active.
  (blank)
  (event + presses Bool)
  (content
    (state is-flowing
      (then is-slowing (trigger on presses))
    )
    (state is-slowing
      (then is-stopped (trigger on (call Timer 1s)))
    )
    (state is-stopped
      (then is-flowing (trigger on (call Timer 3s)))
    )
  )
)
