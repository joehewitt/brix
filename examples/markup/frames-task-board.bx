; Live markup with no window. The tree in `main` reads a tracked list with `#`,
; so changing the list is all it takes to change the picture. Each frame is laid
; out and painted off screen by the terminal library, then printed.
(import /stream/aggregate)
(import /tui)
(blank)

(main
  (let tasks
    (call List
      (block
        (bullet (call Task "buy flour" false))
        (bullet (call Task "bake bread" false))
      )
    )
  )
  (blank)
  (<> Board (id: screen) (• flex-col)
    (<> Label (text: " Today ") (• title))
    ; A branch that reads tracked state comes and goes as the state changes.
    (if (== (. #tasks length) 0)
      (<> Label (text: "nothing left to do"))
    )
    ; The key says which row is which, so a changed task updates its own row.
    (for (in task #tasks (keyed-by (. task name)))
      (<> TaskRow (• task)
        (= text (str (if-expr (. task is-done) "x" " ") " " (. task name)))
        (= is-done (. task is-done))
      )
    )
    (<> Label
      (= text (str (call finished #tasks) " of " (. #tasks length) " done"))
    )
  )
  (print (call (. screen frame) 30 5))
  (blank)
  ; Nothing below touches a label. The rows follow the list.
  (+= tasks (call Task "water the basil" false))
  (= ([] tasks 0) (call Task "buy flour" true))
  (print (call (. screen frame) 30 5))
  (blank)
  (= tasks (call (of List Task)))
  (print (call (. screen frame) 30 5))
)

(type + Task (is Tuple)
  (prop + name String)
  (prop + is-done Bool)
)

(fn-expr + finished Int
  (param tasks (list Task))
  (call count (?> tasks (. each is-done)))
)

(style BoardTheme
  ; A style sheet names its rules. An element takes one with `•`.
  (blank)
  (rule title
    (= background-color blue)
    (= color white)
  )
  (blank)
  (rule task
    (= color white)
    ; These values apply while the element the rule is on has `is-done` set.
    (when-style #is-done
      (= color grey)
    )
  )
)

(type + TaskRow (is Label)
  ; A row is a label with one more property, for the rule above to wait on.
  (blank)
  (prop + is-done _ (= false))
)

(type + Board (is Screen)
  (using BoardTheme)
  ; The terminal library's `Screen` paints a tree to a string. This one brings the
  ; sheet to everything inside it. None of the markup lives here.
)
