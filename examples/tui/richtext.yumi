────────────────────

<Label " Rich Text / MarkdownText Demo " • demo-title
<Label status " Press U to show link/image URLs, C to cycle colors, Escape to quit. " • demo-status

<Box • flex-row flex:1 bg:black
    <Box • sidebar-pane
        <Label " Features " • feature-title
        <MarkdownText sidebar • markdown-default flex:1 bg:navy
            text = feature-markdown()

    <Box • article-pane
        <MarkdownText article • markdown-default flex:1 bg:black
            text = article-markdown()

<Shortcut "Quit"
    key = .escape
    action = => do root.close()

<Shortcut "Toggle URLs"
    key = 'u'
    action = => do toggle-urls()

<Shortcut "Cycle colors"
    key = 'c'
    action = => do cycle-colors()

────────────────────
for event on click

if article.hovered-link-url
    show-link(article.hovered-link-url)
    event.cancel()
else if sidebar.hovered-link-url
    show-link(sidebar.hovered-link-url)
    event.cancel()

────────────────────
+ do toggle-urls

show-urls = !show-urls
article.show-link-urls = show-urls
article.show-image-urls = show-urls
sidebar.show-link-urls = show-urls
sidebar.show-image-urls = show-urls
status.text =
    |? show-urls
        " URLs are visible. Press U to hide them, C to cycle colors, Escape to quit. "
    ??
        " URLs are hidden. Press U to show them, C to cycle colors, Escape to quit. "

────────────────────
+ do cycle-colors

warm-theme = !warm-theme
status.text =
    |? warm-theme
        " Warm theme enabled. Press C to return to the default colors. "
    ??
        " Default colors restored. Press U for URLs, C for colors, Escape to quit. "

────────────────────
+ do show-link
    - url String

status.text = " Link clicked: $url "

