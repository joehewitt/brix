    <Box • flex-row h:1
        <Label " sweep " • bg:blue text:white
        <Box • flex:1 bg:black
    <Box • flex-row flex:1 bg:black
        <Box • flex-col flex:1
            <Label " lane 1" • bg:navy text:white
            <Box • flex:1
