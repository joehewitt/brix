    text = " latest-from-stream "

<Shortcut "Quit"
    key = .escape
    action = => do close-lab()

<Shortcut "Quit"
    key = 'q'
    action = => do close-lab()

────────────────────
+ do close-lab

box-left-stream.close()
root.close()

━━━━━━━━━━━━━━━━━━━━
+ do left-loop AsyncChannel'Coord

. channel = AsyncChannel'Coord()
do new
    28ms.wait()

    while !channel.is-closed
        for position in bounce-pass(2, 56)
            if channel.is-closed
                break

            channel <- position
            28ms.wait()
= channel

━━━━━━━━━━━━━━━━━━━━
+ bounce-pass @inline
    - first Coord
    - last Coord

** first .. last
**? (last - 1 .. first + 1) if last - first > 1
