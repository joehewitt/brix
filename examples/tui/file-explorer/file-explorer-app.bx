(import /os/env)
(import /os/path)
(import /tui)
(import /tui/file-browsing)
(blank)

(main
  (<> App
    (<> Window (id: win) (• flex-col)
      (<> FileExplorer (id: explorer) (• flex-col) (• flex 1) (• bg black))
      (blank)
      (<> Shortcut (text: "Quit")
        (= key "Ctrl+C")
        (= action (=> () :do (call (. win close))))
      )
      (blank)
      (<> StatusBar
        (= message (. explorer #status-message))
      )
    )
  )
)

(type + FileExplorer (is Box)
  (prop + files _ (= (call FileTree (call Path (?? (call env "HOME") "/")))))
  (prop + session _ (= (call FileSession)))
  (prop + is-tree-mode _ (= false))
  (prop + query _ (= (if-expr #is-tree-mode (. #tree #query) (. #columns #query))))
  (prop + status-message _ (= (call file-explorer-status (. #session #current) #query)))
  (blank)
  (rule This (• flex-row) (• flex 1) (• bg black)
    (= focus-mode (. FocusMode inside))
  )
  (content
    (<> Shortcut (text: "Switch view")
      (= key "Ctrl+T")
      (= action (=> () :do (call toggle-view)))
    )
    (blank)
    (if (and (not (. preview #is-open)) (not (?? (?. (. #session #current) is-directory) true)))
      (<> Shortcut (text: "Preview")
        (= key .space)
        (= action (=> () :do (call toggle-preview)))
      )
    )
    (blank)
    (<> FileColumnTree (id: columns) (• flex 1) (• bg black)
      (= display (if-expr #is-tree-mode (. Display hidden) (. Display visible)))
      (= files files)
      (= session session)
    )
    (blank)
    (<> FileTreeBox (id: tree) (• flex 1) (• bg black)
      (= display (if-expr #is-tree-mode (. Display visible) (. Display hidden)))
      (= files files)
      (= session session)
    )
    (blank)
    (<> FilePreview (id: preview))
  )
  (subscribe-for (on node (. session opened))
    (<- (. preview open-requests) (. node path))
  )
  (subscribe-for (on event (. preview closed))
    (call focus-view)
  )
  (whenever-rule (. session #current)
    (let node (. session current))
    (if (. preview is-open)
      (if (and node (not (. node is-directory)))
        (<- (. preview refresh-requests) (. node path))
        (else
          (<- (. preview close-requests) true)
        )
      )
    )
  )
  (fn-do + toggle-view _
    (= is-tree-mode (not is-tree-mode))
    (call focus-view)
  )
  (fn-do + focus-view _
    (if is-tree-mode
      (call (. tree follow-current))
      (call (. tree focus-list))
      (else
        (call (. columns follow-current))
        (call (. columns focus-list))
      )
    )
  )
  (fn-do + toggle-preview _
    (if (. preview is-open)
      (<- (. preview close-requests) true)
      (return)
    )
    (let node (. session current))
    (if (and node (not (. node is-directory)))
      (<- (. preview open-requests) (. node path))
    )
  )
)

(fn-expr + file-explorer-status String
  (param node (? FileNode))
  (param query String)
  (case? (> (. query length) 0)
    (str "Search " query)
  )
  (case? node
    (str (. node path))
  )
  (default
    "Empty directory"
  )
)
