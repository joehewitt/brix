/os/env
/os/path
/tui
/tui/file-browsing

<Window win • flex-col
    <FileExplorer app • flex-col flex:1 bg:black

    <StatusBar
        message = app.#status-message

win.open()

━━━━━━━━━━━━━━━━━━━━
+ FileExplorer is Box

+ files = FileTree(Path(env("HOME") ?? "/"))
+ session = FileSession()
+ is-tree-mode = false
+ query = if #is-tree-mode then #tree.#query else #columns.#query
+ status-message = file-explorer-status(#session.#current, #query)

• This • flex-row flex:1 bg:black
    focus-mode = FocusMode.inside

────────────────────

<Shortcut "Switch view"
    key = "Ctrl+T"
    action = => do toggle-view()

if !preview.#is-open && !(#session.#current?.is-directory ?? true)
    <Shortcut "Preview"
        key = .space
        action = => do toggle-preview()

<FileColumnTree columns • flex:1 bg:black
    display = if #is-tree-mode then Display.hidden else Display.visible
    files = files
    session = session

<FileTreeBox tree • flex:1 bg:black
    display = if #is-tree-mode then Display.visible else Display.hidden
    files = files
    session = session

<FilePreview preview

────────────────────
for node on session.opened

preview.open-requests <- node.path

────────────────────
for event on preview.closed

focus-view()

────────────────────
whenever session.#current

. node = session.current
if preview.is-open
    if node && !node.is-directory
        preview.refresh-requests <- node.path
    else
        preview.close-requests <- true

────────────────────
+ do toggle-view

is-tree-mode = !is-tree-mode
focus-view()

────────────────────
+ do focus-view

if is-tree-mode
    tree.follow-current()
    tree.focus-list()
else
    columns.follow-current()
    columns.focus-list()

────────────────────
+ do toggle-preview

if preview.is-open
    preview.close-requests <- true
    =
. node = session.current
if node && !node.is-directory
    preview.open-requests <- node.path

━━━━━━━━━━━━━━━━━━━━
+ file-explorer-status String
    - node FileNode?
    - query String

|? query.length > 0
    "Search $query"
|? node
    "${node.path} | Ctrl+T switch view | Space preview"
??
    "Empty directory"
