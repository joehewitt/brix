━━━━━━━━━━━━━━━━━━━━
+ GroupPanelDemo is Box
    using GroupPanelDemoTheme

• This
    focus-mode = FocusMode.keys

────────────────────

<This • flex-col flex:1 bg:black
    <Label " GroupPanel " • bg:blue text:white

    <Box • flex-row flex:1 bg:black
        <GroupPanel • jobs-panel flex:1 m:1
            <Box (header) • flex-row
                <Label "Jobs" • text:aqua
                <Spinner
                    frames = SpinnerFrames.braille

            <Box • flex-col
                <TextBox "queued"
                <TextBox "running"
                <TextBox "blocked"

        <GroupPanel • metrics-panel flex:1 m:1
            <Label (header) "Metrics" • text:yellow

            <Box • flex-col
                <TextBox "latency     42ms"
                <TextBox "throughput  1.2k/s"
                <TextBox "errors      0"

    <GroupPanel • log-panel flex:1 m:1
        <Box (header) • flex-col
            <Label "Deploy"
                color = lime
            <Label "rollout"
                color = mutedgray

        <Box • flex-col
            <TextBox "10:41 build finished"
            <TextBox "10:42 health checks passed"
            <TextBox "10:43 traffic shifted"
