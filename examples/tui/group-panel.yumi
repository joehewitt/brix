
/time/duration
/tui

<Window win • flex-col bg:black
    <GroupPanelDemo app • flex-col flex:1 bg:black p:1

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <Shortcut "Quit"
        key = 'q'
        action = => do win.close()

    <StatusBar
        message = "Q quits."

win.open()

