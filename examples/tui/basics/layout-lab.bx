(import /tui)
(blank)

(main
  (<> App
    (<> Window (id: win) (• flex-col)
      (<> LayoutLab (id: demo) (• flex-col) (• flex 1) (• bg black))
      (<> Shortcut (text: "Quit")
        (= key 'q')
        (= action (=> () :do (call (. win close))))
      )
      (<> Shortcut (text: "Quit")
        (= key .escape)
        (= show-in-status false)
        (= action (=> () :do (call (. win close))))
      )
      (<> StatusBar)
    )
  )
)

(type + LayoutLab (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + hide-extra _ (= false))
  (prop + ghost-extra _ (= true))
  (prop + wide-panel _ (= false))
  (content
    (<> Label (• bg blue) (• text white)
      (= text (call layout-lab-title #hide-extra #ghost-extra #wide-panel))
    )
    (<> Box (• flex-row) (• flex 1) (• p 1)
      (<> Box (• flow-col) (• border) (• p 1) (• mr 1)
        (= min-width (if-expr #wide-panel (call (. SizeSpec coord) 46) (. SizeSpec auto)))
        (<> Label (text: " Flow"))
        (<> Label (text: " one") (• border) (• p 1) (• mb 1))
        (<> Label (text: " two") (• border) (• p 1) (• mb 1))
        (<> Label (text: " hidden toggled row") (• border) (• p 1) (• mb 1)
          (= display (if-expr #hide-extra (. Display hidden) (. Display visible)))
        )
        (<> Label (text: " invisible toggled row") (• border) (• p 1)
          (= display (if-expr #ghost-extra (. Display invisible) (. Display visible)))
        )
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• border) (• p 1)
        (<> Label (text: " Flex"))
        (<> Box (• flex-row) (• flex 1) (• mt 1)
          (<> Box (• flex 1) (• bg red) (• mr 1))
          (<> Box (• flex 2) (• bg green) (• mr 1))
          (<> Box (• flex 1) (• bg yellow))
        )
        (<> Box (• flow-row) (• mt 1)
          (<> Label (text: " A ") (• bg grey) (• mr 1))
          (<> Label (text: " B ") (• bg grey) (• mr 1))
          (<> Label (text: " C ") (• bg grey))
        )
      )
      (blank)
      (<> Box (• flow-col) (• absolute) (• border) (• p 1) (• bg navy)
        (= anchor .parent)
        (= left .anchor-end)
        (= top .anchor-start)
        (= min-width 14)
        (<> Label (text: " absolute"))
        (<> Label (text: " overlay"))
      )
    )
    (blank)
    (<> Shortcut (text: "Hide extra")
      (= key 'h')
      (= action (=> () :do (= hide-extra (not hide-extra))))
    )
    (blank)
    (<> Shortcut (text: "Ghost extra")
      (= key 'g')
      (= action (=> () :do (= ghost-extra (not ghost-extra))))
    )
    (blank)
    (<> Shortcut (text: "Wide panel")
      (= key 'w')
      (= action (=> () :do (= wide-panel (not wide-panel))))
    )
  )
)

(fn-expr + layout-lab-title String
  (param hidden Bool)
  (param ghost Bool)
  (param wide Bool)
  (str " Layout Lab  H:" hidden-state "  G:" ghost-state "  W:" width-state)
  (where
    (lazy hidden-state (if-expr hidden "hidden" "visible"))
    (lazy ghost-state (if-expr ghost "invisible" "visible"))
    (lazy width-state (if-expr wide "wide" "natural"))
  )
)
