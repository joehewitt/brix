(import /tui)
(import /tui/virtual)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ billion-row-count VirtualCoord (= 1000000000vcoord))
(blank)

(main
  (<> App
    (<> Window (id: win) (• flex-col) (• bg black)
      (<> BillionRowsDemo (id: demo) (• flex 1))
      (blank)
      (<> Shortcut (text: "Previous row")
        (= key .arrow-up)
        (= show-in-status false)
        (= action (=> () :do (call (. demo move) -1)))
      )
      (blank)
      (<> Shortcut (text: "Next row")
        (= key .arrow-down)
        (= show-in-status false)
        (= action (=> () :do (call (. demo move) 1)))
      )
      (blank)
      (<> Shortcut (text: "Page up")
        (= key (call KeyCombo (. Key page-up)))
        (= show-in-status false)
        (= action (=> () :do (call (. demo move) -10)))
      )
      (blank)
      (<> Shortcut (text: "Page down")
        (= key (call KeyCombo (. Key page-down)))
        (= show-in-status false)
        (= action (=> () :do (call (. demo move) 10)))
      )
      (blank)
      (<> Shortcut (text: "First row")
        (= key (call KeyCombo (. Key home)))
        (= show-in-status false)
        (= action (=> () :do (call (. demo go-to) 0)))
      )
      (blank)
      (<> Shortcut (text: "Last row")
        (= key (call KeyCombo (. Key end)))
        (= show-in-status false)
        (= action (=> () :do (call (. demo go-to) 999999999)))
      )
      (blank)
      (<> Shortcut (text: "Jump to row 100,000,000")
        (= key 'j')
        (= action (=> () :do (call (. demo go-to) 99999999)))
      )
      (blank)
      (<> Shortcut (text: "Quit")
        (= key 'q')
        (= action (=> () :do (call (. win close))))
      )
      (blank)
      (<> Shortcut (text: "Quit")
        (= key .escape)
        (= show-in-status false)
        (= action (=> () :do (call (. win close))))
      )
      (blank)
      (<> StatusBar
        (= message (. demo #status-message))
      )
    )
  )
)

(type + BillionRowsDemo (is Box)
  (implements MarkupRootElement)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + source _ (:= (call VirtualRangeSource billion-row-count)))
  (prop + selected-address I64)
  (prop + status-message _ (= "Row 1 of 1,000,000,000"))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col) (• bg black)
      (<> (of VirtualRegion I64) (id: region) (• flex 1) (• bg black)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout 1vcoord))
        (= overscan (call VirtualInsets 2vcoord 0vcoord 2vcoord 0vcoord))
        (blank)
        (<> BillionRow (slot: row) (param: slot)
          (= address (. slot #address))
          (= text (str " Row " (+ (. slot #address) 1)))
        )
      )
    )
  )
  (fn-do + move _
    (param rows I64)
    (call go-to (+ selected-address rows))
  )
  (fn-do + go-to _
    (param requested I64)
    (let address requested)
    (if (< address 0)
      (= address 0)
    )
    (if (>= address (as billion-row-count I64))
      (= address (- (as billion-row-count I64) 1))
    )
    (= selected-address address)
    (= status-message (str "Row " (+ address 1) " of 1,000,000,000"))
    (= (. region virtual-scroll) (call VirtualPoint 0vcoord address))
    (call (. region invalidate-layout))
    (call (. region invalidate-paint))
  )
)

(type + BillionRow (is Label)
  (prop + address I64)
  (blank)
  (rule This (• flex 1) (• text white)
    (= background-color (call billion-row-background #address))
  )
)

(fn-expr _ billion-row-background _
  (param address I64)
  (if-expr (== (% address 2) 0) navy black)
)
