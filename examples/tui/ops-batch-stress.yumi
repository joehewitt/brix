────────────────────
+ do advance
    - cycle Int
    - index Index

latency = ((latency + (cycle * 7) + (index * 13)) % 640) + 25
backlog = ((backlog + latency + cycle + (index * 11)) % 1200) + 5
severity = pressure-level(latency, backlog, cycle, index)
status-text = status-for(severity, latency, backlog)

━━━━━━━━━━━━━━━━━━━━
