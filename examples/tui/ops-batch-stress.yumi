    - message
    - severity

━━━━━━━━━━━━━━━━━━━━
+ service-name String
    - index Int

match bucket
    |= 0
        "auth"
    |= 1
        "checkout"
    |= 2
        "catalog"
    |= 3
        "search"
    |= 4
        "profile"
    |= 5
        "billing"
    |= 6
        "orders"
    |= 7
        "queue"
    |= 8
        "email"
    |= 9
        "cdn"
    |= 10
        "warehouse"
    ??
        "routing"

.. bucket = index % 12

━━━━━━━━━━━━━━━━━━━━
+ region-name String
    - index Int

match bucket
    |= 0
        "edge-us"
    |= 1
        "edge-eu"
    |= 2
        "payments"
    ??
        "search"

.. bucket = index % 4

━━━━━━━━━━━━━━━━━━━━
+ owner-name String
    - index Int

match bucket
    |= 0
        "ana"
    |= 1
        "sam"
    |= 2
        "mei"
    |= 3
        "jo"
    |= 4
        "ivy"
    |= 5
        "li"
    |= 6
        "noor"
    ??
        "max"

.. bucket = index % 8

━━━━━━━━━━━━━━━━━━━━
+ pressure-level Int
    - latency Int
    - backlog Int
    - cycle Int
    - index Index

|? score > 4
    4
|? score < 0
    0
??
    score

.. score = latency / 110 + backlog / 260 + ((cycle + index) % 3)

━━━━━━━━━━━━━━━━━━━━
+ status-for String
    - severity Int
    - latency Int
    - backlog Int

|? severity >= 4
    "mitigate-now"
|? severity >= 3
    "paging"
|? latency > 420
    "latency"
|? backlog > 800
    "backlog"
??
    "steady"
