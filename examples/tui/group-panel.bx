(import /time/duration)
(import /tui)
(blank)

(main
  (<> Window (id: win) (• flex-col) (• bg black)
    (<> GroupPanelDemo (id: app) (• flex-col) (• flex 1) (• bg black) (• p 1))
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> StatusBar
      (= message "Q quits.")
    )
  )
  (blank)
  (call (. win open))
)

(style GroupPanelDemoTheme
  (using BoxBorder)
  (using BoxPaint)
  (using TextPaint)
  (rule jobs-panel
    (rule group-panel-frame
      (= border-color aqua)
      (= background-color navy)
    )
    (blank)
    (rule group-panel-header
      (= background-color navy)
    )
  )
  (blank)
  (rule metrics-panel
    (rule group-panel-frame
      (= border-color gold)
      (= background-color maroon)
    )
    (blank)
    (rule group-panel-header
      (= background-color maroon)
    )
  )
  (blank)
  (rule log-panel
    (rule group-panel-frame
      (= border-color lime)
    )
  )
)

(type + GroupPanelDemo (is Box)
  (using GroupPanelDemoTheme)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (content
    (<> This (• flex-col) (• flex 1) (• bg black)
      (<> Label (text: " GroupPanel ") (• bg blue) (• text white))
      (blank)
      (<> Box (• flex-row) (• flex 1) (• bg black)
        (<> GroupPanel (• jobs-panel) (• flex 1) (• m 1)
          (<> Box (slot: header) (• flex-row)
            (<> Label (text: "Jobs") (• text aqua))
            (<> Spinner
              (= frames (. SpinnerFrames braille))
            )
          )
          (blank)
          (<> Box (• flex-col)
            (<> TextBox (text: "queued"))
            (<> TextBox (text: "running"))
            (<> TextBox (text: "blocked"))
          )
        )
        (blank)
        (<> GroupPanel (• metrics-panel) (• flex 1) (• m 1)
          (<> Label (slot: header) (text: "Metrics") (• text yellow))
          (blank)
          (<> Box (• flex-col)
            (<> TextBox (text: "latency     42ms"))
            (<> TextBox (text: "throughput  1.2k/s"))
            (<> TextBox (text: "errors      0"))
          )
        )
      )
      (blank)
      (<> GroupPanel (• log-panel) (• flex 1) (• m 1)
        (<> Box (slot: header) (• flex-col)
          (<> Label (text: "Deploy")
            (= color lime)
          )
          (<> Label (text: "rollout")
            (= color mutedgray)
          )
        )
        (blank)
        (<> Box (• flex-col)
          (<> TextBox (text: "10:41 build finished"))
          (<> TextBox (text: "10:42 health checks passed"))
          (<> TextBox (text: "10:43 traffic shifted"))
        )
      )
    )
  )
)
