(import /tui)
(import /tui/listbox)
(import /stream/sort)
(import ./pulse-data)
(import ./pulse-visuals)

(type + PulseProcessTable (is (of Table PulseProcess))
  (prop + wide Bool)
  (content
    (<> This
      (= column-gap 1)
      (= show-header false)
      (= key-builder (=> (process) (str (. process pid))))
      (= sort-column-id "cpu")
      (= sort-direction (. TableSortDirection descending))
      (<> Box (slot: cell) (param: cell)
        (if (== (. cell column id) "selection")
          (<> Label (• flex 1) (• text pulse-cyan)
            (= text (if-expr (. cell #is-selected) "▸" " "))
          )
          (else-if (== (. cell column id) "activity")
            (<> PulseMeter (• flex 1)
              (= level (/ (. cell #item cpu) 100))
            )
          )
          (else
            (<> Label (• flex 1)
              (= color (call pulse-cell-color (. cell column id) (. cell #item) (. cell #is-selected)))
              (= text (. cell #text))
            )
          )
        )
      )
    )
  )
  (depends refresh-columns wide)
  (fn-do + This _
    (call refresh-columns)
  )
  (fn-do _ refresh-columns _
    (= columns (call pulse-process-columns wide))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (if (not (call valid-row selected-row))
      (call select-first-row)
      (on-error (: error Error)
        (call unhandled-error error)
      )
    )
  )
)

(fn-do + pulse-process-row (? (of TableRow PulseProcess))
  (param row (? ListItem))
  (if (is row (of TableRow PulseProcess))
    (return (as row (of TableRow PulseProcess)))
  )
  (return null)
)

(fn-expr _ pulse-cell-color AnsiColor
  (param column String)
  (param process PulseProcess)
  (param selected Bool)
  (case? (== column "pid") (if-expr selected pulse-cyan pulse-muted))
  (case? (== column "cpu") (if-expr (> (. process cpu) 75) pulse-gold pulse-cyan))
  (case? (== column "memory") pulse-purple)
  (default pulse-ink)
)

(fn-do _ pulse-process-columns (list (of TableColumn PulseProcess))
  (param wide Bool)
  (let marker (call (of TableColumn PulseProcess) ""))
  (= (. marker id) "selection")
  (= (. marker column-width) (call (. TableWidth fixed) 1))
  (let pid (call pulse-column "pid" "PID" (call (. TableWidth fixed) 6) (. TableAlign right)))
  (= (. pid value) (=> (process) (str (. process pid))))
  (= (. pid compare) (=> (a b) (call compare-basic (. a pid) (. b pid))))
  (let name (call pulse-column "name" "COMMAND" (call (. TableWidth flex) 1) (. TableAlign left)))
  (= (. name min-width) 1)
  (= (. name value) (=> (process) (. process name)))
  (let cpu (call pulse-column "cpu" "CPU %" (call (. TableWidth fixed) 7) (. TableAlign right)))
  (= (. cpu value) (=> (process) (call decimal (. process cpu))))
  (= (. cpu compare) (=> (a b) (call compare-basic (. a cpu) (. b cpu))))
  (let memory (call pulse-column "memory" "RSS" (call (. TableWidth fixed) 10) (. TableAlign right)))
  (= (. memory value) (=> (process) (call byte-label (. process memory))))
  (= (. memory compare) (=> (a b) (call compare-basic (. a memory) (. b memory))))
  (let columns (list marker pid name cpu memory))
  (if wide
    (let activity (call pulse-column "activity" "ACTIVITY" (call (. TableWidth fixed) 12) (. TableAlign left)))
    (+= columns activity)
  )
  (return columns)
)

(fn-do _ pulse-column (of TableColumn PulseProcess)
  (param id String)
  (param title String)
  (param width TableWidth)
  (param align TableAlign)
  (let column (call (of TableColumn PulseProcess) title))
  (= (. column id) id)
  (= (. column column-width) width)
  (= (. column align) align)
  (return column)
)
