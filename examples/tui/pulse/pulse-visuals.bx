(import /graphics/color)
(import /math)
(import /stream/aggregate)
(import /stream/combine)
(import /tui)
(import ./pulse-data)
(blank)
(prop + pulse-night _ (= (call RGBA "#080d19")))
(prop + pulse-panel _ (= (call RGBA "#101929")))
(prop + pulse-raised _ (= (call RGBA "#19263b")))
(prop + pulse-selection _ (= (call RGBA "#17384d")))
(prop + pulse-ink _ (= (call AnsiColor 255)))
(prop + pulse-muted _ (= (call AnsiColor 103)))
(prop + pulse-line _ (= (call AnsiColor 60)))
(prop + pulse-cyan _ (= (call AnsiColor 87)))
(prop + pulse-purple _ (= (call AnsiColor 141)))
(prop + pulse-green _ (= (call AnsiColor 120)))
(prop + pulse-gold _ (= (call AnsiColor 222)))

(style PulseTheme
  (using TUIShorthandsTheme)
  (using BoxPaint)
  (using TextPaint)
  (using BoxBorder)
  (using BoxSpacing)
  (rule GroupPanel
    (rule group-panel-frame (• border pulse-line) (• border-rounded) (• bg pulse-panel))
    (rule group-panel-body (• flex-col) (• px 1) (• py 0))
    (rule group-panel-header
      (= display (. Display hidden))
    )
  )
  (rule TableRow (• bg pulse-panel)
    (when-style #is-selected
      (• bg pulse-selection)
    )
  )
  (rule pulse-caption (• text pulse-muted))
  (rule pulse-heading (• text pulse-ink) (• h 1))
)

(type + PulseGraph (is Box)
  (prop + values (list Float))
  (prop + secondary (list Float))
  (prop + ceiling Float (= 100))
  (prop + violet Bool)
  (prop + sample-lag Float)
  (content
    (<> This
      (= background (call PulseGraphPainter #values #secondary #ceiling #violet #sample-lag))
    )
  )
)

(type + PulseGraphPainter (is Painter)
  (prop + values (list Float))
  (prop + secondary (list Float))
  (prop + ceiling Float)
  (prop + violet Bool)
  (prop + sample-lag Float)
  (fn-do + This _
    (param values _)
    (param secondary _)
    (param ceiling _)
    (param violet _)
    (param sample-lag _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (call (. canvas paint-background) pulse-panel rect)
      (call (. canvas clip) rect)
      (for (in y (..< 0 (. rect height)))
        (for (in x (..< 0 (. rect width)))
          (let position (- (. values length) 1 (call min sample-lag (as (call max 0 (- (. values length) 1)) Float)) (/ (as (- (. rect width) 1 x) Float) 3)))
          (let value (call pulse-interpolate values position))
          (let level (* (/ value (call max 1 ceiling)) (as (. rect height) Float)))
          (let portion (call max 0 (call min 1 (- level (- (. rect height) y 1)))))
          (let glyph (as ([] " ▁▂▃▄▅▆▇█" (as (call ceil (* portion 8)) Int)) String))
          (let lower (call pulse-interpolate secondary position))
          (let in-secondary (< (- (. rect height) y 1) (* (/ lower (call max 1 ceiling)) (. rect height))))
          (= (. canvas text-color) (if-expr (or violet in-secondary) (call ansi-rgb (if-expr (< y (/ (. rect height) 2)) 4 2) 2 5) (call ansi-rgb 0 (if-expr (< y (/ (. rect height) 2)) 5 3) 5)))
          (if (and (== portion 0) (== (% x 8) 0) (== (% y 2) 0))
            (= glyph "·")
            (= (. canvas text-color) pulse-line)
          )
          (call (. canvas move) (tuple (+ (. rect x) x) (+ (. rect y) y)))
          (call (. canvas print) glyph)
        )
      )
    )
  )
)

(fn-do + pulse-interpolate Float
  (param values (list Float))
  (param position Float)
  (return-if 0 (if (or (< position 0) (== (. values length) 0))))
  (let index (call min (- (. values length) 1) (as (call floor position) Int)))
  (let next (call min (- (. values length) 1) (+ index 1)))
  (let fraction (call min 1 (- position index)))
  (return (+ ([] values index) (* (- ([] values next) ([] values index)) fraction)))
)

(type + PulseMeter (is ProgressBar)
  (prop + level Float)
  (prop + violet Bool)
  (content
    (<> This
      (= value (as (* #level 10000) Int))
      (= total 10000)
      (= bar-prefix "")
      (= bar-suffix "")
      (= show-percent false)
      (<> Box (slot: track)
        (= background (call PulseMeterPainter #progress #violet))
      )
    )
  )
)

(type + PulseMeterPainter (is Painter)
  (prop + level Float)
  (prop + violet Bool)
  (fn-do + This _
    (param level _)
    (param violet _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (call (. canvas paint-background) pulse-panel rect)
      (call (. canvas clip) rect)
      (for (in x (..< 0 (. rect width)))
        (let filled (< (as x Float) (* level (. rect width))))
        (= (. canvas text-color) (if-expr filled (if-expr violet (call ansi-rgb (+ 2 (/ (* x 3) (call max 1 (. rect width)))) 2 5) (call ansi-rgb 0 (+ 2 (/ (* x 3) (call max 1 (. rect width)))) 5)) pulse-line))
        (call (. canvas move) (tuple (+ (. rect x) x) (. rect y)))
        (call (. canvas print) (if-expr filled "━" "╌"))
      )
    )
  )
)

(type + PulseRing (is Box)
  (prop + level Float)
  (content
    (<> This
      (= background (call PulseRingPainter #level))
      (<> Box (• absolute) (• center .parent) (• w 8) (• h 2) (• flex-col)
        (<> Label (• text pulse-ink)
          (= text (call padded (str (as (* #level 100) Int) "%") 6))
        )
        (<> Label (text: " in use ") (• text pulse-muted))
      )
    )
  )
)

(type + PulseRingPainter (is Painter)
  (prop + level Float)
  (fn-do + This _
    (param level _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (call (. canvas paint-background) pulse-panel rect)
      (call (. canvas clip) rect)
      (let dots (list 1 8 2 16 4 32 64 128))
      (for (in y (..< 0 (. rect height)))
        (for (in x (..< 0 (. rect width)))
          (let mask 0)
          (let active-mask 0)
          (for (in dot (..< 0 8))
            (let dx (- (/ (+ (* (as x Float) 2) (% dot 2) 0.5) (call max 1 (. rect width))) 1))
            (let dy (- (/ (+ (* (as y Float) 4) (/ dot 2) 0.5) (* 2 (call max 1 (. rect height)))) 1))
            (let distance (+ (* dx dx) (* dy dy)))
            (if (and (> distance 0.48) (< distance 0.92))
              (+= mask ([] dots dot))
              (let angle (+ (as (call atan2 dx (- dy)) Float) 6.283185307))
              (let progress (/ (if-expr (>= angle 6.283185307) (- angle 6.283185307) angle) 6.283185307))
              (if (< progress level)
                (+= active-mask ([] dots dot))
              )
            )
          )
          (= (. canvas text-color) (if-expr (> active-mask 0) pulse-purple pulse-line))
          (call (. canvas move) (tuple (+ (. rect x) x) (+ (. rect y) y)))
          (call (. canvas print)
            (block
              (arg (as (as (+ 10240 (if-expr (> active-mask 0) active-mask mask)) Char) String))
            )
          )
        )
      )
    )
  )
)

(fn-expr + pulse-peak Float
  (param values (list Float))
  (call max 1024 (call max values))
)

(fn-expr + peak-label String
  (param values (list Float))
  (if-expr (== (. values length) 0) "—" (call byte-label (call max values)))
)
