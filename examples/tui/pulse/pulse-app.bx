(import /os/cli)
(import /math)
(import /math/motion)
(import /stream/aggregate)
(import /stream/combine)
(import /time)
(import /time/timer)
(import /tui)
(import ./pulse-data)
(import ./pulse-visuals)
(import ./pulse-processes)
(blank)

(main
  (<> Window (id: win) (• flex-col) (• bg pulse-night)
    (<> PulseDashboard (id: dashboard) (• flex 1)
      (= demo (has (call cmdline-args) "--demo"))
    )
  )
  (blank)
  (= (. dashboard viewport) (. win terminal view-size))
  (for (on size (. win terminal resized))
    (= (. dashboard viewport) size)
  )
  (call (. dashboard start))
  (call (. win open))
)

(type + PulseDashboard (is Box)
  (using PulseTheme)
  (prop + demo Bool)
  (prop + viewport PSize)
  (prop + running Bool)
  (prop _ collector _ (= (call PulseCollector)))
  (prop _ updates _ (= (call (of AsyncBufferedChannel PulseSample))))
  (prop _ sample _ (= (call PulseSample)))
  (prop _ ready Bool)
  (prop _ paused Bool)
  (prop _ motion Bool (= true))
  (prop _ help Bool)
  (prop _ inspector Bool)
  (prop _ query String)
  (prop _ chosen-row (? (of TableRow PulseProcess)) (= (call pulse-process-row (. process-list #selected-row))))
  (prop _ demo-tick Int (= 119))
  (prop _ demo-elapsed Float)
  (prop _ clock-timer _ (= (call Timer 1seconds)))
  (prop _ frame-pending Bool)
  (prop _ frame-time U64)
  (prop _ motion-time Duration (= 0ns))
  (prop _ download-motion _ (= (call MotionChannel (list 1024.0))))
  (prop _ upload-motion _ (= (call MotionChannel (list 1024.0))))
  (prop _ sample-lag Float)
  (prop _ sample-interval Float (= 2))
  (prop _ sampled-at U64)
  (prop _ download-ceiling Float (= 1024))
  (prop _ upload-ceiling Float (= 1024))
  (prop _ time String (= (call pulse-time)))
  (prop _ notice String (= "Connecting to the workstation…"))
  (prop _ failure String)
  (prop _ cpu-history (list Float))
  (prop _ system-history (list Float))
  (prop _ download-history (list Float))
  (prop _ upload-history (list Float))
  (prop _ wide Bool (= (>= (. #viewport width) 108)))
  (prop _ tall Bool (= (>= (. #viewport height) 34)))
  (prop _ rows (list PulseProcess) (= (call filtered-processes (. #sample processes) #query)))
  (prop _ chosen (? PulseProcess) (= (?. #chosen-row #item)))
  (blank)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (content
    (<> This (• flex-col) (• bg pulse-night) (• text pulse-ink) (• px 1)
      (<> Box (• flex-row) (• h (if-expr #tall 2 1)) (• pt (if-expr #tall 1 0))
        (<> Label (text: " ▰ P U L S E ") (• text pulse-cyan))
        (<> Label (• flex 1) (• text pulse-muted)
          (= text (if-expr #wide " /  WORKSTATION OBSERVATORY" " /  SYSTEM MONITOR"))
        )
        (<> Label (• text pulse-purple)
          (= text (if-expr #demo " DEMO · simulated " " LIVE · macOS "))
        )
        (if (and #motion (not #paused))
          (<> Spinner (• w 3) (• text pulse-green)
            (= interval 125ms)
            (= colorful false)
          )
          (else
            (<> Label (• w 3) (• text pulse-green)
              (= text (if-expr #paused "Ⅱ " "●"))
            )
          )
        )
        (<> Label (• text pulse-ink)
          (= text #time)
        )
      )
      (if (or (< (. #viewport width) 64) (< (. #viewport height) 22))
        (<> GroupPanel (• flex-col) (• flex 1) (• mt 1)
          (<> Box (• flex 1) (• flex-col)
            (<> Label (text: "A little more room for Pulse") (• text pulse-cyan))
            (<> Label (text: "Resize to at least 64 columns × 22 rows."))
            (<> Label (text: "108 × 34 unlocks the full dashboard.") (• text pulse-muted))
            (<> Label (text: "Q quit  ·  D live/demo"))
          )
        )
      )
      (<> Box (• flex-col) (• flex 1)
        (= display (if-expr (or (< (. #viewport width) 64) (< (. #viewport height) 22)) (. Display hidden) (. Display visible)))
        (<> Box (• flex-row) (• mt 1) (• h (if-expr #tall 11 8))
          (<> GroupPanel (• flex 3)
            (<> Box (• flex 1) (• flex-col)
              (<> Box (• flex-row) (• h 1)
                (<> Label (text: "01  PROCESSOR") (• text pulse-cyan) (• flex 1))
                (<> Label (• text pulse-cyan)
                  (= text (if-expr #ready (str (call decimal (. #sample cpu)) "%") "warming up"))
                )
              )
              (<> Box (• flex-row) (• h 1)
                (<> Label (• flex 1) (• text pulse-muted)
                  (= text (str (. #sample cores) " logical cores  ·  " (. #sample threads) " threads"))
                )
                (if #wide
                  (<> Label (text: "100%") (• text pulse-muted))
                )
              )
              (<> PulseGraph (• flex 1)
                (= values #cpu-history)
                (= secondary #system-history)
                (= sample-lag #sample-lag)
              )
              (<> Box (• flex-row) (• h 1)
                (<> Label (• text pulse-cyan) (• flex 1)
                  (= text (str "● user " (call decimal (call max 0 (- (. #sample cpu) (. #sample system)))) "%"))
                )
                (<> Label (• text pulse-purple)
                  (= text (str "● system " (call decimal (. #sample system)) "%"))
                )
              )
              (if #tall
                (<> Label (• text pulse-muted)
                  (= text (str "load  " (. #sample load) "   /   1 · 5 · 15 min"))
                )
              )
            )
          )
          (<> GroupPanel (• flex 2) (• ml 1)
            (<> Box (• flex 1) (• flex-col)
              (<> Box (• flex-row) (• h 1)
                (<> Label (text: "02  MEMORY") (• flex 1) (• text pulse-purple))
                (<> Label (• text pulse-purple)
                  (= text (if-expr #ready (str (as (* 100 (/ (. #sample memory) (. #sample total-memory))) Int) "%") "—"))
                )
              )
              (<> Box (• flex-row) (• flex 1)
                (if (and #wide #tall)
                  (<> PulseRing (• w 16) (• mr 1)
                    (= level (/ (. #sample memory) (. #sample total-memory)))
                  )
                )
                (<> Box (• flex-col) (• flex 1)
                  (<> Label (• text pulse-ink)
                    (= text (if-expr #ready (str (call byte-label (. #sample memory)) " used") "Awaiting sample…"))
                  )
                  (<> PulseMeter
                    (= level (/ (. #sample memory) (. #sample total-memory)))
                    (= violet true)
                  )
                  (<> Label (• text pulse-muted)
                    (= text (str (call byte-label (. #sample total-memory)) " installed"))
                  )
                  (if #tall
                    (<> Label (• text pulse-purple)
                      (= text (str "wired       " (call byte-label (. #sample wired))))
                    )
                    (<> Label (• text pulse-purple)
                      (= text (str "compressed  " (call byte-label (. #sample compressed))))
                    )
                    (<> Label (• text pulse-green)
                      (= text (str "unused      " (call byte-label (call max 0 (- (. #sample total-memory) (. #sample memory))))))
                    )
                  )
                  (if (not #wide)
                    (<> Label (• text pulse-cyan)
                      (= text (if-expr (. #sample rate-ready) (str "↓ " (call byte-label (. #sample download)) "/s") "↓ measuring…"))
                    )
                    (<> Label (• text pulse-purple)
                      (= text (if-expr (. #sample rate-ready) (str "↑ " (call byte-label (. #sample upload)) "/s") "↑ measuring…"))
                    )
                  )
                )
              )
            )
          )
        )
        (<> Box (• flex-row) (• flex 1) (• mt 1)
          (<> GroupPanel (• flex 3)
            (<> Box (• flex 1) (• flex-col)
              (<> Box (• flex-row) (• h 1)
                (<> Label (text: "03  PROCESSES") (• text pulse-cyan) (• flex 1))
                (<> Label (• text pulse-muted)
                  (= text (str (. #rows length) " / " (. #sample processes length)))
                )
              )
              (<> Box (• flex-row) (• h 1) (• bg pulse-raised)
                (<> Label (text: " / ") (• text pulse-cyan))
                (<> TextEditor (id: search) (• flex 1) (• bg pulse-raised) (• text pulse-ink)
                  (= placeholder "filter processes…")
                  (= placeholder-color pulse-muted)
                  (for (on event submitted)
                    (call focus-dashboard)
                  )
                )
              )
              (if #help
                (<> Box (• flex-col) (• flex 1) (• pt 1)
                  (<> Label (text: "MAKE YOURSELF AT HOME") (• text pulse-cyan))
                  (<> Label (text: "↑ ↓ / J K  select     Enter  inspect"))
                  (<> Label (text: "C CPU sort   M memory sort   / filter"))
                  (<> Label (text: "Space pause   D live/demo   A motion"))
                  (<> Label (text: "Esc leave filter / close detail   Q quit"))
                  (<> Label (text: "? closes help") (• text pulse-gold))
                  (if #tall
                    (<> Label (text: "CPU: interval sample. Process CPU: ps average.") (• text pulse-muted))
                    (<> Label (text: "Network: physical en* interfaces, excluding loopback.") (• text pulse-muted))
                    (<> Label (text: "Charts retain 120 samples; newest at the right.") (• text pulse-muted))
                    (<> Label (text: "Memory used includes compressed memory.") (• text pulse-muted))
                    (<> Label (text: "Read only. Selecting a process never sends a signal.") (• text pulse-muted))
                  )
                )
              )
              (<> Box (• flex-col) (• flex 1)
                (= display (if-expr (or #help (and #inspector (not #tall))) (. Display hidden) (. Display visible)))
                (<> PulseProcessTable (id: process-list) (• flex 1) (• mt 1) (• bg pulse-panel)
                  (= rows #rows)
                  (= wide #wide)
                  (for (on _ activated)
                    (= inspector (not inspector))
                  )
                )
                (<> (of TableHeaderRow PulseProcess) (• absolute) (• h 1) (• text pulse-muted) (• bg pulse-panel)
                  (= left (call (. PositionOffset coord) 0))
                  (= right (call (. PositionOffset coord) 0))
                  (= top (call (. PositionOffset coord) 0))
                  (= table process-list)
                  (= scroll-x (. process-list #scroll-x))
                )
                (if (== (. #rows length) 0)
                  (<> Label (• text pulse-muted)
                    (= text (if-expr #ready "No matching processes." "Collecting the first live sample…"))
                  )
                )
              )
              (if (and (not #help) #inspector #chosen)
                (<> Box (• flex-col) (• h (if-expr #tall 5 4)) (• bg pulse-raised) (• px 1)
                  (<> Label (• text pulse-cyan)
                    (= text (str "INSPECT  " (?? (?. #chosen name) "") "  ·  PID " (?? (?. #chosen pid) 0)))
                  )
                  (<> Label (• text pulse-muted)
                    (= text (?? (?. #chosen command) ""))
                  )
                  (<> Label (• text pulse-purple)
                    (= text (str "resident " (call byte-label (?? (?. #chosen memory) 0)) "  ·  CPU " (call decimal (?? (?. #chosen cpu) 0)) "%"))
                  )
                  (<> Label (• text pulse-ink)
                    (= text (str "state " (?? (?. #chosen state) "") "  ·  " (call process-state (?? (?. #chosen state) ""))))
                  )
                  (if #tall
                    (<> Label (text: "Enter / Esc close  ·  ↑ ↓ browse") (• text pulse-muted))
                  )
                )
              )
            )
          )
          (if #wide
            (<> Box (• flex-col) (• flex 2) (• ml 1)
              (<> GroupPanel (• flex 1)
                (<> Box (• flex 1) (• flex-col)
                  (<> Box (• flex-row) (• h 1)
                    (<> Label (text: "04  NETWORK") (• flex 1) (• text pulse-cyan))
                    (<> Label (• text pulse-muted)
                      (= text (if-expr (. #sample network-ready) "en*" "unavailable"))
                    )
                  )
                  (<> Label (• text pulse-cyan)
                    (= text (if-expr (. #sample rate-ready) (str "↓ " (call byte-label (. #sample download)) "/s  ·  peak " (call peak-label #download-history)) "↓ measuring transfer rate…"))
                  )
                  (<> PulseGraph (• flex 1)
                    (= values #download-history)
                    (= ceiling #download-ceiling)
                    (= sample-lag #sample-lag)
                  )
                  (<> Label (• text pulse-purple)
                    (= text (if-expr (. #sample rate-ready) (str "↑ " (call byte-label (. #sample upload)) "/s  ·  peak " (call peak-label #upload-history)) "↑ measuring transfer rate…"))
                  )
                  (<> PulseGraph (• flex 1)
                    (= values #upload-history)
                    (= ceiling #upload-ceiling)
                    (= sample-lag #sample-lag)
                    (= violet true)
                  )
                  (if #tall
                    (<> Label (• text pulse-muted)
                      (= text (str "since boot  ↓ " (call byte-label (. #sample received)) "  ↑ " (call byte-label (. #sample sent))))
                    )
                  )
                )
              )
              (if #tall
                (<> GroupPanel (• h 8) (• mt 1)
                  (<> Box (• flex 1) (• flex-col)
                    (<> Box (• flex-row) (• h 1)
                      (<> Label (text: "05  WORKSPACE VOLUME") (• flex 1) (• text pulse-gold))
                      (<> Label (• text pulse-gold)
                        (= text (if-expr (. #sample disk-ready) (str (as (* 100 (/ (. #sample disk-used) (. #sample disk-total))) Int) "%") "—"))
                      )
                    )
                    (<> PulseMeter
                      (= level (/ (. #sample disk-used) (. #sample disk-total)))
                      (= violet true)
                    )
                    (<> Label (• text pulse-ink)
                      (= text (str (call byte-label (. #sample disk-used)) " used"))
                    )
                    (<> Label (• text pulse-muted)
                      (= text (str (call byte-label (- (. #sample disk-total) (. #sample disk-used))) " available"))
                    )
                  )
                )
              )
            )
          )
        )
      )
      (<> Box (• flex-row) (• h 1) (• mt 1)
        (<> Label (• flex 1)
          (= color (if-expr (!= #failure "") pulse-gold pulse-muted))
          (= text (if-expr (!= #failure "") (str "! " #failure) (if-expr #paused "Ⅱ PAUSED · measurements frozen; Space resumes" (str "● " (. #sample host) "  /  " #notice))))
        )
        (if #wide
          (<> Label (• text pulse-muted)
            (= text (str (. #cpu-history length) "/120 samples"))
          )
        )
      )
      (<> StatusBar (• h 1) (• bg pulse-night) (• text pulse-cyan))
      (blank)
      (<> Shortcut (text: "Quit")
        (= show-in-status true)
        (= key (char "q"))
        (= action (=> () :do (call (. root close))))
      )
      (<> Shortcut (text: "Back")
        (= show-in-status false)
        (= key .escape)
        (= allow-while-input true)
        (= action (=> () :do (call back)))
      )
      (<> Shortcut (text: "Filter")
        (= show-in-status true)
        (= key (char "/"))
        (= action (=> () :do (call (. (as root Window) focus) search)))
      )
      (<> Shortcut (text: "Pause")
        (= show-in-status true)
        (= key .space)
        (= action (=> () :do (= paused (not paused))))
      )
      (<> Shortcut (text: "Live / demo")
        (= show-in-status false)
        (= key (char "d"))
        (= action (=> () :do (call switch-mode)))
      )
      (<> Shortcut (text: "Motion")
        (= show-in-status false)
        (= key (char "a"))
        (= action (=> () :do (call toggle-motion)))
      )
      (<> Shortcut (text: "Help")
        (= show-in-status true)
        (= key (char "?"))
        (= action (=> () :do (= help (not help))))
      )
      (<> Shortcut (text: "Inspect")
        (= show-in-status true)
        (= key .enter)
        (= action (=> () :do (= inspector (not inspector))))
      )
      (<> Shortcut (text: "Sort by CPU")
        (= show-in-status false)
        (= key (char "c"))
        (= action (=> () :do (block (= (. process-list sort-column-id) "cpu") (= (. process-list sort-direction) (. TableSortDirection descending)))))
      )
      (<> Shortcut (text: "Sort by memory")
        (= show-in-status false)
        (= key (char "m"))
        (= action (=> () :do (block (= (. process-list sort-column-id) "memory") (= (. process-list sort-direction) (. TableSortDirection descending)))))
      )
      (<> Shortcut (text: "Next process")
        (= show-in-status false)
        (= key .arrow-down)
        (= action (=> () :do (call (. process-list select-relative) (. Direction down))))
      )
      (<> Shortcut (text: "Previous process")
        (= show-in-status false)
        (= key .arrow-up)
        (= action (=> () :do (call (. process-list select-relative) (. Direction up))))
      )
      (<> Shortcut (text: "Next process")
        (= show-in-status false)
        (= key (char "j"))
        (= action (=> () :do (call (. process-list select-relative) (. Direction down))))
      )
      (<> Shortcut (text: "Previous process")
        (= show-in-status false)
        (= key (char "k"))
        (= action (=> () :do (call (. process-list select-relative) (. Direction up))))
      )
      (<> Shortcut (text: "First process")
        (= show-in-status false)
        (= key .home)
        (= action (=> () :do (call (. process-list select-first-row))))
      )
      (<> Shortcut (text: "Last process")
        (= show-in-status false)
        (= key .end)
        (= action (=> () :do (call (. process-list select-last-row))))
      )
      (<> Shortcut (text: "Next page")
        (= show-in-status false)
        (= key .page-down)
        (= action (=> () :do (call (. process-list select-page) (. Direction down))))
      )
      (<> Shortcut (text: "Previous page")
        (= show-in-status false)
        (= key .page-up)
        (= action (=> () :do (call (. process-list select-page) (. Direction up))))
      )
    )
  )
  (whenever-rule (. search #text)
    (= query (. search text))
  )
  (subscribe-for (on next updates)
    (if (and (not demo) running)
      (if (== (. next failure) "")
        (let now (call monotonic-time-nanoseconds))
        (if (!= sampled-at 0)
          (let interval (/ (as (- now sampled-at) Float) 1000000000))
          (= sample-interval (call max 0.25 (call min 10 (+ (* sample-interval 0.75) (* interval 0.25)))))
        )
        (= sampled-at now)
      )
      (if (not paused)
        (call accept next)
      )
    )
  )
  (fn-do + start _
    (if demo
      (call seed-demo)
      (else
        (= (. collector updates) updates)
        (call (. collector start))
      )
    )
    (= running true)
    (call request-motion)
  )
  (subscribe-for (on _ clock-timer)
    (if running
      (= time (call pulse-time))
      (if (and demo (not paused))
        (+= demo-elapsed 1)
        (if (>= demo-elapsed 2)
          (-= demo-elapsed 2)
          (+= demo-tick 1)
          (call accept (call demo-sample demo-tick))
        )
      )
    )
  )
  (depends motion-state-changed running motion paused)
  (fn-do _ motion-state-changed _
    (= frame-time (call monotonic-time-nanoseconds))
    (return-if (if (or (not running) paused)))
    (if motion
      (call request-motion)
      (else
        (call settle-motion)
      )
    )
  )
  (fn-do _ request-motion _
    (return-if (if (or (not running) (not motion) paused frame-pending)))
    (= frame-pending true)
    (= frame-time (call monotonic-time-nanoseconds))
    (call request-animation-frame advance-motion)
  )
  (fn-do _ advance-motion _
    (= frame-pending false)
    (return-if (if (or (not running) (not motion) paused)))
    (let now (call monotonic-time-nanoseconds))
    (let elapsed (as (- now frame-time) Nanoseconds))
    (let seconds (as (as elapsed Seconds) Float))
    (= frame-time now)
    (+= motion-time elapsed)
    (= sample-lag (call max 0 (- sample-lag (* (/ seconds sample-interval) (call max 1 sample-lag)))))
    (call (. download-motion update) motion-time)
    (call (. upload-motion update) motion-time)
    (= download-ceiling ([] (. download-motion value) 0))
    (= upload-ceiling ([] (. upload-motion value) 0))
    (if (or (> sample-lag 0) (. download-motion is-moving) (. upload-motion is-moving))
      (= frame-pending true)
      (call request-animation-frame advance-motion)
    )
  )
  (fn-do + close _
    (call stop)
    (call (. super close))
  )
  (fn-do + stop _
    (= running false)
    (call (. clock-timer end-using))
    (call (. collector stop))
  )
  (fn-do _ seed-demo _
    (= demo-tick 119)
    (for (in index (..< 0 120))
      (call accept (call demo-sample index))
    )
    (call settle-motion)
    (if motion
      (= sample-lag 1)
    )
  )
  (fn-do _ switch-mode _
    (call (. collector stop))
    (= demo (not demo))
    (= paused false)
    (= demo-elapsed 0)
    (= sample-interval 2)
    (= sampled-at 0)
    (= ready false)
    (= failure "")
    (= sample (call PulseSample))
    (= cpu-history (call (of List Float)))
    (= system-history (call (of List Float)))
    (= download-history (call (of List Float)))
    (= upload-history (call (of List Float)))
    (call settle-motion)
    (= notice "Connecting to the workstation…")
    (if demo
      (call seed-demo)
      (else
        (= collector (call PulseCollector))
        (= (. collector updates) updates)
        (call (. collector start))
      )
    )
  )
  (fn-do _ accept _
    (param next PulseSample)
    (= failure (. next failure))
    (return-if (if (!= failure "")))
    (let animate (and ready motion))
    (= sample next)
    (= ready true)
    (= cpu-history (call remember cpu-history (. sample cpu)))
    (= system-history (call remember system-history (. sample system)))
    (if (. sample rate-ready)
      (= download-history (call remember download-history (. sample download)))
      (= upload-history (call remember upload-history (. sample upload)))
    )
    (if animate
      (+= sample-lag 1)
      (let download-target (call pulse-peak download-history))
      (let upload-target (call pulse-peak upload-history))
      (= (. download-motion precision) (* 0.001 download-target))
      (= (. upload-motion precision) (* 0.001 upload-target))
      (call (. download-motion retarget) (list download-target) (call follow (/ 1.0 0.35)) motion-time)
      (call (. upload-motion retarget) (list upload-target) (call follow (/ 1.0 0.35)) motion-time)
      (call request-motion)
      (else
        (call settle-motion)
      )
    )
    (= notice (if-expr demo "simulated workload · D switches to live" (str "sampled " (. sample stamp))))
  )
  (fn-do _ settle-motion _
    (= sample-lag 0)
    (= download-ceiling (call pulse-peak download-history))
    (= upload-ceiling (call pulse-peak upload-history))
    (call (. download-motion jump) (list download-ceiling))
    (call (. upload-motion jump) (list upload-ceiling))
  )
  (fn-do _ toggle-motion _
    (= motion (not motion))
  )
  (fn-do _ back _
    (if (. search is-focused)
      (call (. (as root Window) focus) this)
      (else-if help
        (= help false)
      )
      (else-if inspector
        (= inspector false)
      )
      (else
        (= (. search text) "")
      )
    )
  )
  (fn-do _ focus-dashboard _
    (call (. (as root Window) focus) this)
  )
)

(fn-do + remember (list Float)
  (param history (list Float))
  (param value Float)
  (let next (call (of List Float) ([] history (... (call max 0 (- (. history length) 119))))))
  (+= next value)
  (return next)
)

(fn-expr _ process-state String
  (param state String)
  (case? (call (. state starts-with) "R")
    "running"
  )
  (case? (call (. state starts-with) "S")
    "sleeping"
  )
  (case? (call (. state starts-with) "I")
    "idle"
  )
  (case? (call (. state starts-with) "T")
    "stopped"
  )
  (case? (call (. state starts-with) "Z")
    "zombie"
  )
  (default
    "system state"
  )
)
