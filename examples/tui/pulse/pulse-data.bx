(import /math)
(import /os/process)
(import /os/env)
(import /stream/sort)
(import /stream/aggregate)
(import /stream/combine)
(import /time)

(type + PulseProcess (is Tuple)
  (prop + pid Int)
  (prop + name String)
  (prop + cpu Float)
  (prop + memory Float)
  (prop + state String)
  (prop + command String)
)

(type + PulseSample
  (prop + cpu Float)
  (prop + system Float)
  (prop + memory Float)
  (prop + total-memory Float (= 1))
  (prop + wired Float)
  (prop + compressed Float)
  (prop + received Float)
  (prop + sent Float)
  (prop + download Float)
  (prop + upload Float)
  (prop + network-ready Bool)
  (prop + rate-ready Bool)
  (prop + disk-used Float)
  (prop + disk-total Float (= 1))
  (prop + disk-ready Bool)
  (prop + load String (= "—"))
  (prop + threads String (= "—"))
  (prop + processes (list PulseProcess))
  (prop + host String (= "workstation"))
  (prop + cores Int)
  (prop + stamp String (= ""))
  (prop + failure String (= ""))
)

(type + PulseCollector
  (prop + updates _ (= (call (of AsyncBufferedChannel PulseSample))))
  (prop + running Bool (= true))
  (prop + active (? Process))
  (prop _ previous (? PulseSample))
  (prop _ previous-time _ (= (call clock)))
  (prop _ host String (= "workstation"))
  (prop _ cores Int)
  (prop _ total-memory Float (= 1))
  (fn-do + start _
    (do-new
      (let setup (catch (call configure)))
      (if (is setup Error)
        (call failed (. setup message))
        (return)
      )
      (while running
        (let result (catch (call collect)))
        (if (not running)
          (break)
        )
        (if (is result Error)
          (call failed (. result message))
          (else
            (<- updates result)
          )
        )
        (call (. 1s wait))
      )
    )
  )
  (fn-do + stop _
    (= running false)
    (if active
      (call (. active terminate))
    )
  )
  (fn-do _ failed _
    (param message String)
    (return-if (if (not running)))
    (let sample (call PulseSample))
    (= (. sample failure) message)
    (<- updates sample)
  )
  (fn-do _ command String (?! Error)
    (param name String)
    (param arguments (list String))
    (throw (call Error "Sampler stopped") (if (not running)))
    (let variables (call environment))
    (= ([] variables "LC_ALL") "C")
    (let process (use (call Process name (. ProcessStderr discard) arguments (:variables variables))))
    (= active process)
    (finally
      (= active null)
    )
    (let output (as process String))
    (let status (?? (call (. process wait) null) 1))
    (throw (call Error (str name " exited with status " status)) (if (!= status 0)))
    (return output)
  )
  (fn-do _ configure _ (?! Error)
    (let platform (call (. (call command "/usr/bin/uname" (list "-s")) trim)))
    (throw (call Error "Live collection requires macOS. Press D for the demo.") (if (!= platform "Darwin")))
    (= host (call (. (call command "/bin/hostname" (list "-s")) trim)))
    (= cores (as (call (. (call command "/usr/sbin/sysctl" (list "-n" "hw.ncpu")) trim)) Int))
    (= total-memory (as (call (. (call command "/usr/sbin/sysctl" (list "-n" "hw.memsize")) trim)) Float))
  )
  (fn-do _ collect PulseSample (?! Error)
    (let sample (call parse-top (call command "/usr/bin/top" (list "-l" "2" "-s" "1" "-n" "0"))))
    (= (. sample total-memory) total-memory)
    (= (. sample host) host)
    (= (. sample cores) cores)
    (= (. sample processes) (call parse-processes (call command "/bin/ps" (list "-axo" "pid=,pcpu=,rss=,state=,comm="))))
    (let network (catch? (call command "/usr/sbin/netstat" (list "-ibn"))))
    (if network
      (call read-network sample network)
    )
    (let disk (catch? (call command "/bin/df" (list "-k" "."))))
    (if disk
      (call read-disk sample disk)
    )
    (let instant (call clock))
    (let elapsed (call max 0.001 (/ (as (- instant previous-time) Float) 1000)))
    (if (and previous (. sample network-ready) (. previous network-ready))
      (= (. sample rate-ready) true)
      (= (. sample download) (/ (call max 0 (- (. sample received) (. previous received))) elapsed))
      (= (. sample upload) (/ (call max 0 (- (. sample sent) (. previous sent))) elapsed))
    )
    (= previous sample)
    (= previous-time instant)
    (return sample)
  )
)

(fn-do + words (list String)
  (param text String)
  (let result (call (of List String)))
  (let word "")
  (for (in ch text)
    (if (or (== ch (char " ")) (== ch (char "\t")) (== ch (char "\r")))
      (if (!= word "")
        (+= result word)
        (= word "")
      )
      (else
        (+= word ch)
      )
    )
  )
  (if (!= word "")
    (+= result word)
  )
  (return result)
)

(fn-do + numeric Float
  (param text String)
  (let digits "")
  (for (in ch text)
    (if (or (and (>= ch '0') (<= ch '9')) (== ch '.'))
      (+= digits ch)
    )
  )
  (return (if-expr (== digits "") 0 (as digits Float)))
)

(fn-expr + sized-number Float
  (param text String)
  (* (call numeric text) factor)
  (where
    (lazy factor
      (block
        (case? (!= (call (. text find) "T") null)
          1099511627776.0
        )
        (case? (!= (call (. text find) "G") null)
          1073741824.0
        )
        (case? (!= (call (. text find) "M") null)
          1048576.0
        )
        (case? (!= (call (. text find) "K") null)
          1024.0
        )
        (default
          1.0
        )
      )
    )
  )
)

(fn-do + parse-top PulseSample (?! Error)
  (param output String)
  (let sample (call PulseSample))
  (let found false)
  (for (in line (call (. output split) "\n"))
    (let parts (call words line))
    (if (and (call (. line starts-with) "CPU usage:") (>= (. parts length) 7))
      (= (. sample cpu) (call min 100 (+ (call numeric ([] parts 2)) (call numeric ([] parts 4)))))
      (= (. sample system) (call numeric ([] parts 4)))
      (= found true)
    )
    (if (and (call (. line starts-with) "PhysMem:") (>= (. parts length) 8))
      (= (. sample memory) (call sized-number ([] parts 1)))
      (= (. sample wired) (call sized-number ([] parts 3)))
      (= (. sample compressed) (call sized-number ([] parts 5)))
    )
    (if (call (. line starts-with) "Load Avg:")
      (= (. sample load) (call (. ([] line (... 10)) trim)))
    )
    (if (and (call (. line starts-with) "Processes:") (>= (. parts length) 2))
      (= (. sample threads) ([] parts (- (. parts length) 2)))
    )
    (if (and (>= (. line length) 19) (== ([] line 4) '/'))
      (= (. sample stamp) ([] line (... 11)))
    )
  )
  (throw (call Error "System sampler returned no CPU measurements.") (if (not found)))
  (return sample)
)

(fn-do + parse-processes (list PulseProcess)
  (param output String)
  (let result (call (of List PulseProcess)))
  (for (in line (call (. output split) "\n"))
    (let parts (call words line))
    (if (>= (. parts length) 5)
      (let command (call (. " " join) ([] parts (... 4))))
      (let path (call (of List String) (call (. command split) "/")))
      (+= result (call PulseProcess (as ([] parts 0) Int) ([] path (- (. path length) 1)) (as ([] parts 1) Float) (* (as ([] parts 2) Float) 1024) ([] parts 3) command))
    )
  )
  (return result)
)

(fn-do _ read-network _
  (param sample PulseSample)
  (param output String)
  (for (in line (call (. output split) "\n"))
    (let parts (call words line))
    (if (and (>= (. parts length) 10) (call (. ([] parts 0) starts-with) "en") (call (. ([] parts 2) starts-with) "<Link"))
      (+= (. sample received) (as ([] parts (- (. parts length) 5)) Float))
      (+= (. sample sent) (as ([] parts (- (. parts length) 2)) Float))
      (= (. sample network-ready) true)
    )
  )
)

(fn-do _ read-disk _
  (param sample PulseSample)
  (param output String)
  (for (in line (call (. output split) "\n"))
    (let parts (call words line))
    (if (and (>= (. parts length) 6) (call (. ([] parts 0) starts-with) "/"))
      (= (. sample disk-used) (* (as ([] parts 2) Float) 1024))
      (= (. sample disk-total) (* (+ (as ([] parts 2) Float) (as ([] parts 3) Float)) 1024))
      (= (. sample disk-ready) true)
    )
  )
)

(fn-do + demo-sample PulseSample
  (param tick Int)
  (let sample (call PulseSample))
  (let t (* (as tick Float) 0.16))
  (= (. sample cpu) (+ 35 (* 18 (call sin t)) (* 10 (call sin (* t 2.7)))))
  (= (. sample system) (+ 8 (* 4 (call sin (+ t 1)))))
  (= (. sample total-memory) 34359738368.0)
  (= (. sample memory) (* (. sample total-memory) (+ 0.62 (* 0.035 (call sin (* t 0.3))))))
  (= (. sample wired) 3221225472.0)
  (= (. sample compressed) 2147483648.0)
  (= (. sample download) (* 1048576 (+ 3.5 (* 2.3 (call sin (* t 0.7))) (* 0.8 (call sin (* t 3))))))
  (= (. sample upload) (* 1048576 (+ 0.9 (* 0.6 (call sin (+ t 2))))))
  (= (. sample received) 8922793984.0)
  (= (. sample sent) 1288490188.0)
  (= (. sample network-ready) true)
  (= (. sample rate-ready) true)
  (= (. sample disk-total) 1000000000000.0)
  (= (. sample disk-used) 612000000000.0)
  (= (. sample disk-ready) true)
  (= (. sample host) "studio.local")
  (= (. sample cores) 12)
  (= (. sample threads) "2486")
  (= (. sample load) "2.41, 2.08, 1.76")
  (= (. sample stamp) (call pulse-time))
  (let names (list "yumi" "WindowServer" "Safari" "language-server" "postgres" "node" "Docker" "Music" "Terminal" "mdworker" "kernel_task" "launchd" "git" "ruby" "python3" "watchman" "redis-server" "sshd"))
  (for (in index (..< 0 (. names length)))
    (let name ([] names index))
    (let cpu (/ (* (. sample cpu) (+ 2 (call sin (+ t (as index Float))))) (+ 1 (* (as index Float) 0.7))))
    (+= (. sample processes) (call PulseProcess (+ 1042 (* index 137)) name cpu (* 1048576 (+ 48 (/ 1500 (+ 1 (as index Float))))) (if-expr (< index 3) "R" "S") (str "/usr/local/bin/" name)))
  )
  (return sample)
)

(fn-expr + pulse-time String
  (str (call padded (str (as (. time hour) Int)) 2 "0") ":" (call padded (str (as (. time minute) Int)) 2 "0") ":" (call padded (str (as (. time second) Int)) 2 "0"))
  (where
    (lazy time (call now))
  )
)

(fn-expr + padded String
  (param text String)
  (param width Int)
  (param fill String (= " "))
  (str (* fill (call max 0 (- width (. text length)))) text)
)

(fn-expr + decimal String
  (param value Float)
  (str (/ rounded 10) "." (% rounded 10))
  (where
    (lazy rounded (as (call round (* (call max 0 value) 10)) Int))
  )
)

(fn-expr + byte-label String
  (param value Float)
  (case? (>= value 1099511627776.0)
    (str (call decimal (/ value 1099511627776.0)) " TiB")
  )
  (case? (>= value 1073741824.0)
    (str (call decimal (/ value 1073741824.0)) " GiB")
  )
  (case? (>= value 1048576.0)
    (str (call decimal (/ value 1048576.0)) " MiB")
  )
  (case? (>= value 1024.0)
    (str (call decimal (/ value 1024.0)) " KiB")
  )
  (default
    (str (as value Int) " B")
  )
)

(fn-expr + filtered-processes (list PulseProcess)
  (param rows (list PulseProcess))
  (param query String)
  (call List (?> rows (!= (call (. each name lowercased find) (. query lowercased)) null)))
)
