/ai
/ai/jev/jev
/data/json
/os/env
/time
/time/timer
/tui
/tui/colors

_ api-key = env("JEV_API_KEY")
?! Error("Set JEV_API_KEY before running this example")
    if !api-key

<Window win • flex-col bg:black
    <Box • flex:1

    <Box • flex-row
        <Box • flex:1
        <LanguageDetector detector
            min-width = SizeSpec.coord(48)
            max-width = SizeSpec.coord(48)
        <Box • flex:1

    <Box • flex:1

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

win.open()

━━━━━━━━━━━━━━━━━━━━
+ LanguageDetector is Box

+ client := Jev(api-key!)
+ language = ""
+ revision Size = 0
+ event text-changed Bool
+ event detection-finished Bool
+ is-detecting = #phase is .waiting || #phase is .detecting

────────────────────
+ phase ~>

~> idle
~> waiting on text-changed
    .. timer = Timer(350ms)

    then detecting on timer
    then idle on detection-finished

~> detecting
    do
        . text = editor.text.trim()
        if text
            do new detect-language(text, revision)
        else
            language = ""
            detection-finished <- true

    then waiting on text-changed
    then idle on detection-finished

────────────────────

<This • flex-col
    <TextEditor editor "" • border-rounded border:white px:1
        placeholder = "Type in any language"

    <Box • flex-row h:1 mt:1
        <Box • flex:1
        <Label • text:lightgray
            text = if #is-detecting then "" else #language
        <Box • flex:1

────────────────────
when editor.#text

. text = editor.text.trim()
revision += 1
if text
    text-changed <- true
else
    language = ""
    detection-finished <- true

────────────────────
+ do detect-language
    - text String
    - request-revision Size

. detected = classify-language(text)
    catch Error
        ""
if revision == request-revision
    language = detected
    detection-finished <- true

────────────────────
+ classify-language ?! AIError
    - text String

answer.choice

.. questions = Map'String'JevQuestion
    • language JevChoiceQuestion
        - "Which language is this text written in?"
        -
            * "Arabic"
            * "Chinese"
            * "Dutch"
            * "English"
            * "French"
            * "German"
            * "Hindi"
            * "Italian"
            * "Japanese"
            * "Korean"
            * "Polish"
            * "Portuguese"
            * "Russian"
            * "Spanish"
            * "Turkish"
            * "Other"
            *> (each, each)
            |> Map
.. answer = response.answers["language"]! as JevChoiceAnswer
    .. response = client.evaluate(text, questions)
