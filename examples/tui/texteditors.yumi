/tui
/tui/colors

<Window win • flex-col bg:black
    <TextEditorGallery demo • flex-col flex:1 bg:black

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <Shortcut "Quit"
        key = 'q'
        action = => do win.close()

    <StatusBar
        message = demo.#status-message

win.open()

━━━━━━━━━━━━━━━━━━━━
+ TextEditorGallery is Box

+ status-message = "Ready"

────────────────────

<This • flex-col flex:1 bg:black p:1
    <Label " TextEditor Configurations " • bg:white text:black

    <Box • flex-row flex:1 bg:black
        <Box • flex-col flex:1 m:1 p:1 border-rounded border:aqua bg:charcoal
            <Label " Single line " • bg:aqua text:black
            <TextEditor search "release notes"
                placeholder = "Search"

        <Box • flex-col flex:1 m:1 p:1 border-rounded border:rose bg:maroon
            <Label " Masked " • bg:rose text:black
            <TextEditor password "hunter2"
                placeholder = "Password"
                mask = '*'

    <Box • flex-row flex:1 bg:black
        <Box • flex-col flex:1 m:1 p:1 border-rounded border:lime bg:green
            <Label " Composer " • bg:lime text:black
            <TextEditor composer ""
                multiline = true
                max-height = 5
                placeholder = "Message"

        <Box • flex-col flex:1 m:1 p:1 border-rounded border:sky bg:deepblue
            <Label " Submit composer " • bg:sky text:black
            <TextEditor submitter ""
                multiline = true
                max-height = 5
                placeholder = "Enter sends"

        <Box • flex-col flex:1 m:1 p:1 border-rounded border:yellow bg:olive
            <Label " Wrapped notes " • bg:yellow text:black
            <TextEditor notes
                text = notes-seed()
                multiline = true
                max-height = 7
                placeholder = "Notes"

    <Box • flex-col flex:1 m:1 p:1 border-rounded border:sky bg:deepblue
        <Label " No wrap " • bg:sky text:black
        <TextEditor log
            text = log-seed()
            multiline = true
            wrap = TextEditorWrap.none
            max-height = 4

────────────────────
for event on search.submitted

status-message = "Search submitted: ${search.text}"

────────────────────
for event on password.submitted

status-message = "Masked submitted: ${password.text.length} chars"

────────────────────
for event on composer.submitted

composer.insert-text("\n")
status-message = "Composer: ${composer.text.length} chars"

────────────────────
for event on submitter.submitted

. submitted-text = submitter.text
submitter.text = ""
status-message = "Submit composer sent: ${submitted-text.length} chars"

────────────────────
for event on notes.submitted

status-message = "Notes submitted: ${notes.text.length} chars"

────────────────────
for event on log.submitted

status-message = "No-wrap submitted: ${log.text.length} chars"

━━━━━━━━━━━━━━━━━━━━
+ ¶ notes-seed

Design a single editor that feels like an input at one line, grows for chat composition, and still handles paragraph editing without changing components.

