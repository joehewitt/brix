+ FilesShortcutPanel is Box

+ demo ShortcutGridDemo

• This • flex-col m:1 pt:1 pr:2 pb:0 pl:2 border-rounded
    focus-mode = FocusMode.keys
    color = lightgray
    border-color = if #is-focused then white else teal
    background-color = if #is-focused then slate else charcoal

    • shortcut-panel-title
        background-color = teal
        color = white

────────────────────

<This
    <Shortcut "Previous file"
        key = .arrow-up
        action = => do announce("previous file")

    <Shortcut "Next file"
        key = .arrow-down
        action = => do announce("next file")

    <Shortcut "Open"
        key = .enter
        action = => do announce("open")

    <Shortcut "Preview"
        key = .space
        action = => do announce("preview")

    <Label " Files " • shortcut-panel-title
    <Label " Up      Previous file"
    <Label " Down    Next file"
    <Label " Enter   Open"
    <Label " Space   Preview"

