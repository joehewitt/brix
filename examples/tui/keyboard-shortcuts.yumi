+ ShortcutGridDemo is Box

+ demo-self ShortcutGridDemo?
+ status-message = "Tab cycles the shortcut panels."

────────────────────

<This • flex-col flex:1 bg:black p:1
    <Label " Keyboard Shortcuts " • bg:blue text:white

    <Box • flex-row flex:1 bg:black
        <FilesShortcutPanel • flex-col flex:1
            demo = demo-self!
        <EditingShortcutPanel • flex-col flex:1
            demo = demo-self!

    <Box • flex-row flex:1 bg:black
        <SearchShortcutPanel • flex-col flex:1
            demo = demo-self!
        <ViewShortcutPanel • flex-col flex:1
            demo = demo-self!

────────────────────
+ This

demo-self = this

────────────────────
+ do note
    - panel String
    - action String

status-message = "$panel: $action"

