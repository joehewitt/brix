/tui

<Window win • flex-col bg:black
    <ShortcutGridDemo demo • flex-col flex:1 bg:black

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <Shortcut "Quit"
        key = 'q'
        action = => do win.close()

    <StatusBar
        message = demo.#status-message

win.open()

