
/tui

<Window win • flex-col
    <MarkupLoopDemo app • flex-col flex:1 bg:black

win.open()

━━━━━━━━━━━━━━━━━━━━
+ MarkupLoopDemo is Box

• This
    focus-mode = FocusMode.keys

+ cells [RowData]
+ target = MutationTarget.middle
+ next-id = 5

────────────────────

<Label " Markup Loop " • bg:blue text:white
<Label status " I insert, D delete, R replace. B/M/E choose target. Escape quits. " • bg:grey text:black

<Box • flex-row h:1 bg:black
    <Button " Insert [I] " • bg:green text:black
        for event on click
            insert-cell()
            event.cancel()

    <Button " Delete [D] " • bg:red text:white
        for event on click
            delete-cell()
            event.cancel()

    <Button " Replace [R] " • bg:yellow text:black
        for event on click
            replace-cell()
            event.cancel()

    <Box • flex:1

<Box • flex-row h:1 bg:black
    <Button " Beginning [B] " • bg:navy text:white
        for event on click
            choose-target(MutationTarget.beginning)
            event.cancel()

    <Button " Middle [M] " • bg:navy text:white
        for event on click
            choose-target(MutationTarget.middle)
            event.cancel()

    <Button " End [E] " • bg:navy text:white
        for event on click
            choose-target(MutationTarget.end)
            event.cancel()

    <Box • flex:1

<Box • flex-col flex:1 bg:black
    for cell in #cells keyed by cell.id
        <CellRow = cell

<Shortcut "Quit"
    key = .escape
    action = => do root.close()

<Shortcut "Insert cell"
    key = 'i'
    action = => do insert-cell()

<Shortcut "Delete cell"
    key = 'd'
    action = => do delete-cell()

<Shortcut "Replace cell"
    key = 'r'
    action = => do replace-cell()

<Shortcut "Target beginning"
    key = 'b'
    action = => do choose-target(MutationTarget.beginning)

<Shortcut "Target middle"
    key = 'm'
    action = => do choose-target(MutationTarget.middle)

<Shortcut "Target end"
    key = 'e'
    action = => do choose-target(MutationTarget.end)

────────────────────
+ This

cells += RowData("cell-1", "Alpha")
cells += RowData("cell-2", "Bravo")
cells += RowData("cell-3", "Charlie")
cells += RowData("cell-4", "Delta")

────────────────────
+ get insertion-index

match target
    |= MutationTarget.beginning
        0
    |= MutationTarget.end
        cells.length
    ??
        cells.length / 2

────────────────────
+ get existing-index

match target
    |= MutationTarget.beginning
        0
    |= MutationTarget.end
        cells.length - 1
    ??
        cells.length / 2

────────────────────
+ do choose-target
    - new-target MutationTarget

target = new-target
set-status("Target: ${target-label()}.")

────────────────────
+ do insert-cell

. index = insertion-index
. cell = RowData("cell-$next-id", "New $next-id")
cells.insert(cell, index)
next-id += 1
set-status("Inserted ${cell.text} at ${target-label()}.")

────────────────────
+ do delete-cell

if !cells
    set-status("Nothing to delete.")
    =
. index = existing-index
. removed = cells[index]
cells.remove(index)
set-status("Deleted ${removed.text} from ${target-label()}.")

────────────────────
+ do replace-cell

if !cells
    set-status("Nothing to replace.")
    =
. index = existing-index
. cell = RowData("cell-$next-id", "Replacement $next-id")
cells[index] = cell
next-id += 1
set-status("Replaced row at ${target-label()} with ${cell.text}.")

────────────────────
+ do set-status
    - message String

status.text = " $message "

────────────────────
+ target-label String

match target
    |= MutationTarget.beginning
        "beginning"
    |= MutationTarget.end
        "end"
    ??
        "middle"

