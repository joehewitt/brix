(import /time)
(import /tui)
(blank)

(main
  (<> Window (id: win) (• flex-col)
    (<> SpinnerDemo (id: app) (• flex-col) (• flex 1) (• bg black))
  )
  (blank)
  (call (. win open))
)

(type + SpinnerDemo (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + selected-index _ (= 0))
  (content
    (<> Label (text: " Spinners ") (• bg blue) (• text white))
    (<> Label (text: " Press Space or T to toggle type. Press Q or Escape to quit. ") (• bg grey) (• text black))
    (blank)
    (<> Box (• flex-col) (• flex 1) (• bg black) (• p 2)
      (<> Box (• flex 1))
      (blank)
      (<> Box (• flex-row) (• h 1)
        (<> Box (• flex 1))
        (<> Spinner
          (= frames (call spinner-demo-frames #selected-index))
          (= interval 90ms)
        )
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-row) (• h 1) (• mt 1)
        (<> Box (• flex 1))
        (<> Label (• text lightgray)
          (= text (call spinner-demo-title #selected-index))
        )
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-row) (• h 1)
        (<> Box (• flex 1))
        (<> Label (• text mutedgray)
          (= text (call spinner-demo-count-text #selected-index))
        )
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex 1))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. root close))))
    )
    (blank)
    (<> Shortcut (text: "Select next spinner")
      (= key .space)
      (= action (=> () :do (call select-next-spinner)))
    )
    (blank)
    (<> Shortcut (text: "Select next spinner")
      (= key 't')
      (= action (=> () :do (call select-next-spinner)))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. root close))))
    )
  )
  (fn-do + select-next-spinner _
    (= selected-index
      (block
        (case? (>= (+ selected-index 1) (call spinner-demo-count))
          0
        )
        (default
          (+ selected-index 1)
        )
      )
    )
  )
)

(fn-expr + spinner-demo-count Int
  6
)

(fn-expr + spinner-demo-frames SpinnerFrames
  (param index Int)
  (match index
    (case 1
      (. SpinnerFrames dots)
    )
    (case 2
      (. SpinnerFrames circle)
    )
    (case 3
      (. SpinnerFrames arc)
    )
    (case 4
      (. SpinnerFrames quadrant)
    )
    (case 5
      (. SpinnerFrames arrows)
    )
    (default
      (. SpinnerFrames braille)
    )
  )
)

(fn-expr + spinner-demo-title String
  (param index Int)
  (match index
    (case 1
      "Dots"
    )
    (case 2
      "Circle"
    )
    (case 3
      "Arc"
    )
    (case 4
      "Quadrant"
    )
    (case 5
      "Arrows"
    )
    (default
      "Braille"
    )
  )
)

(fn-expr + spinner-demo-count-text String
  (param index Int)
  (str (+ index 1) " / " (call spinner-demo-count))
)
