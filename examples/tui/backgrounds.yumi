<Shortcut "Quit"
    key = .escape
    action = => do root.close()

────────────────────
+ do start-profile-if-needed

profile-frames-remaining = background-profile-frame-count()
=? if profile-frames-remaining <= 0

is-profile-running = true
do new run-profile-session()

────────────────────
+ do run-profile-session

//+backgrounds.profile.run
request-animation-frame(this.profile-frame)
while is-profile-running
    1ms.wait()
1ms.wait()
//-backgrounds.profile.run
root.close()

────────────────────
+ do profile-frame

=? if !is-profile-running

if profile-frames-remaining <= 0
    finish-profile()
    =
profile-frames-remaining -= 1
if profile-frames-remaining <= 0
    finish-profile()
else
    invalidate-paint()
    request-animation-frame(this.profile-frame)

────────────────────
+ do finish-profile

=? if !is-profile-running

is-profile-running = false

