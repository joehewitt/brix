(import /time/duration)
(import /time/timer)
(import /tui)
(blank)

(main
  (<> Window (id: win) (• flex-col)
    (<> ProgressBarsDemo (id: app) (• flex-col) (• flex 1) (• bg black))
  )
  (blank)
  (call (. win open))
)

(style ProgressBarsTheme
  (using BoxPaint)
  (using TextPaint)
  (rule default-bar
    (rule progress-fill
      (= background-color emerald)
      (= color white)
    )
    (blank)
    (rule progress-empty
      (= background-color slate)
      (= color grey)
    )
  )
  (blank)
  (rule warning-bar
    (rule progress-fill
      (= background-color gold)
      (= color black)
    )
    (blank)
    (rule progress-empty
      (= background-color olive)
      (= color grey)
    )
  )
  (blank)
  (rule compact-bar
    (rule progress-fill
      (= background-color sky)
      (= color black)
    )
    (blank)
    (rule progress-empty
      (= background-color deepblue)
      (= color grey)
    )
  )
  (blank)
  (rule framed-bar
    (rule progress-fill
      (= background-color rose)
      (= color white)
    )
    (blank)
    (rule progress-empty
      (= background-color indigo)
      (= color grey)
    )
  )
  (blank)
  (rule unknown-bar
    (rule progress-fill
      (= background-color aqua)
      (= color black)
    )
    (blank)
    (rule progress-empty
      (= background-color navy)
      (= color grey)
    )
  )
)

(type + ProgressBarsDemo (is Box)
  (using ProgressBarsTheme)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop _ ticker _ (= (call Timer 90ms)))
  (content
    (<> Label (text: " Progress Bars ") (• bg blue) (• text white))
    (blank)
    (<> Box (• flex-col) (• flex 1) (• bg black) (• p 2)
      (<> ProgressBar (• default-bar)
        (= label "Default")
        (= value (call progress-demo-value (## ticker) 100))
        (= total 100)
      )
      (blank)
      (<> ProgressBar (• warning-bar)
        (= label "Warning")
        (= value (call progress-demo-value (## ticker) 64))
        (= total 64)
        (= fill-character "#")
        (= empty-character ".")
      )
      (blank)
      (<> Box (• flex-row) (• h 1)
        (<> ProgressBar (• compact-bar) (• flex 1)
          (= label "Compact")
          (= value (call progress-demo-value (## ticker) 10))
          (= total 10)
          (= bar-prefix "")
          (= bar-suffix "")
          (= show-percent false)
          (= fill-character "|")
          (= empty-character ".")
        )
        (<> Box (• flex 2))
      )
      (blank)
      (<> ProgressBar (• framed-bar)
        (= label "Framed")
        (= value 72)
        (= total 100)
        (= bar-prefix "<")
        (= bar-suffix ">")
        (= fill-character "+")
        (= empty-character ".")
      )
      (blank)
      (<> ProgressBar (• unknown-bar)
        (= label "Unknown")
        (= total null)
        (= fill-character "*")
        (= empty-character ".")
        (= interval 120ms)
      )
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. root close))))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. root close))))
    )
  )
  (fn-do + close _
    (call (. super close))
    (call (. ticker end-using))
  )
)

(fn-expr + progress-demo-value Int
  (param elapsed Microseconds)
  (param total Int)
  (% (as (/ elapsed 90ms) Int) (+ total 1))
)
