
/tui/box
/tui/colors
/tui/events
/tui/layout
/tui/primitives
/tui/texteditor
/tui/window

. count = 0

<Window win • flex-row
    ` <Box • flex:2 bg:blue

    <Box • flex:1 bg:red
    <Box • flex:1 bg:yellow
    <Box • flex-col flex:1

        `  <Box • flex:1 bg:red
        `     for event on mouse-down
        `         input.text = "UP"
        `         input.invalidate-paint()

        <TextEditor input "foo" • bg:blue
            for event on key-input
                count += 1
        `  <Box • flex:1 bg:white
        `     for event on mouse-down
        `         input.text = "DOWN"
        `         input.invalidate-paint()

win.open()
` -- count
` -- input.text
