(import /tui)
(import /tui/colors)
(blank)

(main
  (<> Window (id: win) (• flex-col) (• bg black)
    (<> TextEditorGallery (id: demo) (• flex-col) (• flex 1) (• bg black))
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> StatusBar
      (= message (. demo #status-message))
    )
  )
  (blank)
  (call (. win open))
)

(type + TextEditorGallery (is Box)
  (prop + status-message _ (= "Ready"))
  (content
    (<> This (• flex-col) (• flex 1) (• bg black) (• p 1)
      (<> Label (text: " TextEditor Configurations ") (• bg white) (• text black))
      (blank)
      (<> Box (• flex-row) (• flex 1) (• bg black)
        (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border aqua) (• bg charcoal)
          (<> Label (text: " Single line ") (• bg aqua) (• text black))
          (<> TextEditor (id: search) (text: "release notes")
            (= placeholder "Search")
          )
        )
        (blank)
        (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border rose) (• bg maroon)
          (<> Label (text: " Masked ") (• bg rose) (• text black))
          (<> TextEditor (id: password) (text: "hunter2")
            (= placeholder "Password")
            (= mask '*')
          )
        )
      )
      (blank)
      (<> Box (• flex-row) (• flex 1) (• bg black)
        (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border lime) (• bg green)
          (<> Label (text: " Composer ") (• bg lime) (• text black))
          (<> TextEditor (id: composer) (text: "")
            (= multiline true)
            (= max-height 5)
            (= placeholder "Message")
          )
        )
        (blank)
        (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border sky) (• bg deepblue)
          (<> Label (text: " Submit composer ") (• bg sky) (• text black))
          (<> TextEditor (id: submitter) (text: "")
            (= multiline true)
            (= max-height 5)
            (= placeholder "Enter sends")
          )
        )
        (blank)
        (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border yellow) (• bg olive)
          (<> Label (text: " Wrapped notes ") (• bg yellow) (• text black))
          (<> TextEditor (id: notes)
            (= text (call notes-seed))
            (= multiline true)
            (= max-height 7)
            (= placeholder "Notes")
          )
        )
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• m 1) (• p 1) (• border-rounded) (• border sky) (• bg deepblue)
        (<> Label (text: " No wrap ") (• bg sky) (• text black))
        (<> TextEditor (id: log)
          (= text (call log-seed))
          (= multiline true)
          (= wrap (. TextEditorWrap none))
          (= max-height 4)
        )
      )
    )
  )
  (subscribe-for (on event (. search submitted))
    (= status-message (str "Search submitted: " (. search text)))
  )
  (subscribe-for (on event (. password submitted))
    (= status-message (str "Masked submitted: " (. password text length) " chars"))
  )
  (subscribe-for (on event (. composer submitted))
    (call (. composer insert-text) "\n")
    (= status-message (str "Composer: " (. composer text length) " chars"))
  )
  (subscribe-for (on event (. submitter submitted))
    (let submitted-text (. submitter text))
    (= (. submitter text) "")
    (= status-message (str "Submit composer sent: " (. submitted-text length) " chars"))
  )
  (subscribe-for (on event (. notes submitted))
    (= status-message (str "Notes submitted: " (. notes text length) " chars"))
  )
  (subscribe-for (on event (. log submitted))
    (= status-message (str "No-wrap submitted: " (. log text length) " chars"))
  )
)

(fn-expr + notes-seed _
  (paragraph
    "Design a single editor that feels like an input at one line, grows for chat composition, and still handles paragraph editing without changing components."
  )
)

(fn-expr + log-seed _
  (paragraph
    "2026-06-21T09:12:44Z service=worker region=iad stage=deploy message=\"this deliberately long diagnostic line stays horizontal\""
  )
)
