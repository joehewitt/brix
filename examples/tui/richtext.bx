(import /tui)
(import /tui/text)
(blank)

(main
  (<> App
    (<> Window (id: win) (• flex-col)
      (<> RichTextDemo (id: demo))
      (<> Shortcut (text: "Quit")
        (= key 'q')
        (= action (=> () :do (call (. win close))))
      )
      (<> Shortcut (text: "Quit")
        (= key .escape)
        (= show-in-status false)
        (= action (=> () :do (call (. win close))))
      )
      (<> StatusBar)
    )
  )
)

(type + RichTextDemo (is Box)
  (using RichTextPaint)
  (prop + show-urls _ (= false))
  (prop + warm-theme _ (= false))
  (blank)
  (rule This (• flex-col) (• flex 1) (• bg black)
    (= focus-mode (. FocusMode keys))
    (rule demo-title
      (= background-color blue)
      (= color white)
    )
    (blank)
    (rule demo-status
      (= background-color grey)
      (= color black)
    )
    (blank)
    (rule sidebar-pane
      (= layout flex-col)
      (= width 29)
      (= background-color navy)
    )
    (blank)
    (rule feature-title
      (= background-color aqua)
      (= color black)
    )
    (blank)
    (rule article-pane
      (= layout flex-col)
      (= flex 1)
      (= background-color black)
    )
    (blank)
    (rule markdown-default
      (= color silver)
      (= header-color aqua)
      (= strong-color white)
      (= em-color yellow)
      (= link-color aqua)
      (= image-color purple)
      (= quote-color grey)
      (= code-color lime)
      (= divider-color grey)
      (= bullet-color yellow)
    )
    (blank)
    (when-style #warm-theme
      (rule markdown-default
        (= header-color yellow)
        (= strong-color lime)
        (= em-color fuchsia)
        (= image-color red)
        (= bullet-color olive)
      )
    )
  )
  (content
    (<> Label (text: " Rich Text / MarkdownText Demo ") (• demo-title))
    (<> Label (id: status) (text: " Press U to show link/image URLs, C to cycle colors, Escape to quit. ") (• demo-status))
    (blank)
    (<> Box (• flex-row) (• flex 1) (• bg black)
      (<> Box (• sidebar-pane)
        (<> Label (text: " Features ") (• feature-title))
        (<> MarkdownText (id: sidebar) (• markdown-default) (• flex 1) (• bg navy)
          (= text (call feature-markdown))
        )
      )
      (blank)
      (<> Box (• article-pane)
        (<> MarkdownText (id: article) (• markdown-default) (• flex 1) (• bg black)
          (= text (call article-markdown))
        )
      )
    )
    (blank)
    (<> Shortcut (text: "Toggle URLs")
      (= key 'u')
      (= action (=> () :do (call toggle-urls)))
    )
    (blank)
    (<> Shortcut (text: "Cycle colors")
      (= key 'c')
      (= action (=> () :do (call cycle-colors)))
    )
  )
  (subscribe-for (on event click)
    (if (. article hovered-link-url)
      (call show-link (. article hovered-link-url))
      (call (. event cancel))
      (else-if (. sidebar hovered-link-url)
        (call show-link (. sidebar hovered-link-url))
        (call (. event cancel))
      )
    )
  )
  (fn-do + toggle-urls _
    (= show-urls (not show-urls))
    (= (. article show-link-urls) show-urls)
    (= (. article show-image-urls) show-urls)
    (= (. sidebar show-link-urls) show-urls)
    (= (. sidebar show-image-urls) show-urls)
    (= (. status text)
      (block
        (case? show-urls
          " URLs are visible. Press U to hide them, C to cycle colors, Escape to quit. "
        )
        (default
          " URLs are hidden. Press U to show them, C to cycle colors, Escape to quit. "
        )
      )
    )
  )
  (fn-do + cycle-colors _
    (= warm-theme (not warm-theme))
    (= (. status text)
      (block
        (case? warm-theme
          " Warm theme enabled. Press C to return to the default colors. "
        )
        (default
          " Default colors restored. Press U for URLs, C for colors, Escape to quit. "
        )
      )
    )
  )
  (fn-do + show-link _
    (param url String)
    (= (. status text) (str " Link clicked: " url " "))
  )
)

(fn-expr + feature-markdown _
  (paragraph
    "# Features"
    (blank)
    "* Paragraph wrapping"
    "* Headers"
    "* **Strong** spans"
    "* *Emphasis* spans"
    "* [Docs](https://yumi.dev/docs)"
    "* [Repository](https://github.com/joehewitt/brix)"
    "* ![Images](yumi://asset/logo)"
    "* Nested list indentation"
    "* Thematic color overrides"
    (blank)
    "Hover a link to highlight it, then click to show its URL in the status bar."
  )
)

(fn-expr + article-markdown _
  (paragraph
    "# Rich Text in a TUI"
    (blank)
    "MarkdownText turns a Markdown document into terminal text runs. It keeps normal prose readable by wrapping paragraphs to the current box width, while still giving individual token types their own colors."
    (blank)
    "The component supports **strong text**, *emphasis*, [project links](https://github.com/joehewitt/brix), [sample code](https://github.com/joehewitt/brix/tree/main/examples), and ![inline image labels](yumi://images/rich-text). Press U to reveal where links and images point."
    (blank)
    "---"
    (blank)
    "* Layout is recalculated when the box width changes."
    "* Long words split safely when they exceed the available column width."
    "* List bullets and nested content keep their own indentation."
    "    * Child items inherit the wrapped content width."
    "    * The bullet color can be styled separately."
    "    * Links like [MarkdownText](https://yumi.dev/tui/markdown-text) remain clickable inside nested content."
    "* Color properties can be changed live without rebuilding the document."
    (blank)
    "Try narrowing the terminal until this paragraph wraps across several lines. The rich text layout should continue to preserve inline colors, line breaks, and indentation while the surrounding flex layout gives the article whatever space remains."
  )
)
