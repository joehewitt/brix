    - message ChatMessage

message.author == "You"

━━━━━━━━━━━━━━━━━━━━
+ is-assistant-message
    - message ChatMessage

message.author == "ChatGPT"

━━━━━━━━━━━━━━━━━━━━
+ message-leading-flex Flex
    - message ChatMessage

if is-user-message(message) then 1 else 0

━━━━━━━━━━━━━━━━━━━━
+ message-foreground-color AnsiColor
    - message ChatMessage

if message.author == "Status" then mutedgray else lightgray

━━━━━━━━━━━━━━━━━━━━
+ message-background-color BackgroundColor?
    - message ChatMessage

dimgray if is-user-message(message)

━━━━━━━━━━━━━━━━━━━━
+ message-horizontal-padding Coord
    - message ChatMessage

if is-user-message(message) then 1 else 0

━━━━━━━━━━━━━━━━━━━━
+ message-text-width Coord
    - message ChatMessage

if is-user-message(message) then 55 else 80

━━━━━━━━━━━━━━━━━━━━
+ message-box-width SizeSpec
    - message ChatMessage

SizeSpec.coord(message-text-width(message))

━━━━━━━━━━━━━━━━━━━━
+ wrapped-message-lines
    - text String
    - width Coord

if result.length > 0 then result else [""]

.. result =
    ** text.split("\n")
    *> wrap-message-line(each, safe-width)
    |> flat-map
    |> List
.. safe-width = (if width > 0 then width else 1) as Size

━━━━━━━━━━━━━━━━━━━━
+ wrap-message-line @inline
    - source-line String
    - width Size

*? "" if !source-line
**
    0 .. < source-line.length by width
    *> source-line[each .. < end]
        .. proposed-end = each + width
        .. end = if proposed-end < source-line.length then proposed-end else source-line.length

━━━━━━━━━━━━━━━━━━━━
+ chatgpt-request
    - chat-messages [ChatMessage]

* AIMessage(AIMessageRole.system, system-prompt)
**
    ** chat-messages 
    ?> each.body.length > 0
    ?*> match? each.author
        |= "You"
            AIMessage(AIMessageRole.user, each.body)
        |= "ChatGPT"
            AIMessage(AIMessageRole.assistant, each.body)
|> List

.. system-prompt = "".join
    * "You are ChatGPT inside Yumi's terminal chat UI. "
    * "Answer in clear, concise Markdown."

━━━━━━━━━━━━━━━━━━━━
+ do refresh-transcript
    - transcript Box
    - should-scroll-to-bottom = true

. batch-root = transcript.markup-batch-root
if batch-root
    batch-root.markup-batch-queue.checkpoint()

transcript.update-layout()
if should-scroll-to-bottom && transcript.has-overflow
    transcript.scroll(1000, Direction.down)
else if !transcript.has-overflow
    transcript.scroll((0, 0))

━━━━━━━━━━━━━━━━━━━━
+ is-transcript-at-bottom
    - transcript Box

transcript.scroll-y <= transcript-bottom-scroll-y(transcript)

━━━━━━━━━━━━━━━━━━━━
+ transcript-bottom-scroll-y Coord
    - transcript Box

if bottom < 0 then bottom else 0

.. bottom = transcript.content-bounds.height - transcript.inner-height
