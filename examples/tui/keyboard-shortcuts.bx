(import /tui)
(blank)

(main
  (<> Window (id: win) (• flex-col) (• bg black)
    (<> ShortcutGridDemo (id: demo) (• flex-col) (• flex 1) (• bg black))
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> Shortcut (text: "Quit")
      (= key 'q')
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> StatusBar
      (= message (. demo #status-message))
    )
  )
  (blank)
  (call (. win open))
)

(type + ShortcutGridDemo (is Box)
  (prop + demo-self (? ShortcutGridDemo))
  (prop + status-message _ (= "Tab cycles the shortcut panels."))
  (content
    (<> This (• flex-col) (• flex 1) (• bg black) (• p 1)
      (<> Label (text: " Keyboard Shortcuts ") (• bg blue) (• text white))
      (blank)
      (<> Box (• flex-row) (• flex 1) (• bg black)
        (<> FilesShortcutPanel (• flex-col) (• flex 1)
          (= demo (!! demo-self))
        )
        (<> EditingShortcutPanel (• flex-col) (• flex 1)
          (= demo (!! demo-self))
        )
      )
      (blank)
      (<> Box (• flex-row) (• flex 1) (• bg black)
        (<> SearchShortcutPanel (• flex-col) (• flex 1)
          (= demo (!! demo-self))
        )
        (<> ViewShortcutPanel (• flex-col) (• flex 1)
          (= demo (!! demo-self))
        )
      )
    )
  )
  (fn-do + This _
    (= demo-self this)
  )
  (fn-do + note _
    (param panel String)
    (param action String)
    (= status-message (str panel ": " action))
  )
)

(type + FilesShortcutPanel (is Box)
  (prop + demo ShortcutGridDemo)
  (blank)
  (rule This (• flex-col) (• m 1) (• pt 1) (• pr 2) (• pb 0) (• pl 2) (• border-rounded)
    (= focus-mode (. FocusMode keys))
    (= color lightgray)
    (= border-color (if-expr #is-focused white teal))
    (= background-color (if-expr #is-focused slate charcoal))
    (blank)
    (rule shortcut-panel-title
      (= background-color teal)
      (= color white)
    )
  )
  (content
    (<> This
      (<> Shortcut (text: "Previous file")
        (= key .arrow-up)
        (= action (=> () :do (call announce "previous file")))
      )
      (blank)
      (<> Shortcut (text: "Next file")
        (= key .arrow-down)
        (= action (=> () :do (call announce "next file")))
      )
      (blank)
      (<> Shortcut (text: "Open")
        (= key .enter)
        (= action (=> () :do (call announce "open")))
      )
      (blank)
      (<> Shortcut (text: "Preview")
        (= key .space)
        (= action (=> () :do (call announce "preview")))
      )
      (blank)
      (<> Label (text: " Files ") (• shortcut-panel-title))
      (<> Label (text: " Up      Previous file"))
      (<> Label (text: " Down    Next file"))
      (<> Label (text: " Enter   Open"))
      (<> Label (text: " Space   Preview"))
    )
  )
  (fn-do + announce _
    (param action String)
    (call (. demo note) "Files" action)
  )
)

(type + EditingShortcutPanel (is Box)
  (prop + demo ShortcutGridDemo)
  (blank)
  (rule This (• flex-col) (• m 1) (• pt 1) (• pr 2) (• pb 0) (• pl 2) (• border-rounded)
    (= focus-mode (. FocusMode keys))
    (= color lightgray)
    (= border-color (if-expr #is-focused white rose))
    (= background-color (if-expr #is-focused slate charcoal))
    (blank)
    (rule shortcut-panel-title
      (= background-color rose)
      (= color white)
    )
  )
  (content
    (<> This
      (<> Shortcut (text: "Command palette")
        (= key "Ctrl+K")
        (= action (=> () :do (call announce "command palette")))
      )
      (blank)
      (<> Shortcut (text: "Toggle bold")
        (= key "Ctrl+B")
        (= action (=> () :do (call announce "bold toggled")))
      )
      (blank)
      (<> Shortcut (text: "Cut line")
        (= key 'x')
        (= action (=> () :do (call announce "cut line")))
      )
      (blank)
      (<> Shortcut (text: "Paste")
        (= key 'p')
        (= action (=> () :do (call announce "paste")))
      )
      (blank)
      (<> Label (text: " Editing ") (• shortcut-panel-title))
      (<> Label (text: " Ctrl+K  Command palette"))
      (<> Label (text: " Ctrl+B  Toggle bold"))
      (<> Label (text: " X       Cut line"))
      (<> Label (text: " P       Paste"))
    )
  )
  (fn-do + announce _
    (param action String)
    (call (. demo note) "Editing" action)
  )
)

(type + SearchShortcutPanel (is Box)
  (prop + demo ShortcutGridDemo)
  (blank)
  (rule This (• flex-col) (• m 1) (• pt 1) (• pr 2) (• pb 0) (• pl 2) (• border-rounded)
    (= focus-mode (. FocusMode keys))
    (= color lightgray)
    (= border-color (if-expr #is-focused white amber))
    (= background-color (if-expr #is-focused slate charcoal))
    (blank)
    (rule shortcut-panel-title
      (= background-color amber)
      (= color black)
    )
  )
  (content
    (<> This
      (<> Shortcut (text: "Find")
        (= key '/')
        (= action (=> () :do (call announce "find")))
      )
      (blank)
      (<> Shortcut (text: "Next match")
        (= key 'n')
        (= action (=> () :do (call announce "next match")))
      )
      (blank)
      (<> Shortcut (text: "Previous match")
        (= key "Shift+N")
        (= action (=> () :do (call announce "previous match")))
      )
      (blank)
      (<> Shortcut (text: "Replace")
        (= key 'r')
        (= action (=> () :do (call announce "replace")))
      )
      (blank)
      (<> Label (text: " Search ") (• shortcut-panel-title))
      (<> Label (text: " /       Find"))
      (<> Label (text: " N       Next match"))
      (<> Label (text: " Shift+N Previous match"))
      (<> Label (text: " R       Replace"))
    )
  )
  (fn-do + announce _
    (param action String)
    (call (. demo note) "Search" action)
  )
)

(type + ViewShortcutPanel (is Box)
  (prop + demo ShortcutGridDemo)
  (blank)
  (rule This (• flex-col) (• m 1) (• pt 1) (• pr 2) (• pb 0) (• pl 2) (• border-rounded)
    (= focus-mode (. FocusMode keys))
    (= color lightgray)
    (= border-color (if-expr #is-focused white sky))
    (= background-color (if-expr #is-focused slate charcoal))
    (blank)
    (rule shortcut-panel-title
      (= background-color sky)
      (= color black)
    )
  )
  (content
    (<> This
      (<> Shortcut (text: "Previous tab")
        (= key .arrow-left)
        (= action (=> () :do (call announce "previous tab")))
      )
      (blank)
      (<> Shortcut (text: "Next tab")
        (= key .arrow-right)
        (= action (=> () :do (call announce "next tab")))
      )
      (blank)
      (<> Shortcut (text: "Help")
        (= key "F1")
        (= action (=> () :do (call announce "help")))
      )
      (blank)
      (<> Shortcut (text: "Inspector")
        (= key "Shift+F4")
        (= action (=> () :do (call announce "inspector")))
      )
      (blank)
      (<> Label (text: " View ") (• shortcut-panel-title))
      (<> Label (text: " Left    Previous tab"))
      (<> Label (text: " Right   Next tab"))
      (<> Label (text: " F1      Help"))
      (<> Label (text: " Shift+F4 Inspector"))
    )
  )
  (fn-do + announce _
    (param action String)
    (call (. demo note) "View" action)
  )
)
