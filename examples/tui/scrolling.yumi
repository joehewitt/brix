/tui

<Window win • flex-col bg:black
    <ScrollDemo demo • flex-col flex:1 bg:black

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <Shortcut "Quit"
        key = 'q'
        action = => do win.close()

    <StatusBar
        message = "Wheel over a pane. Horizontal wheel moves sideways; vertical wheel moves vertically. Q quits."

win.open()

━━━━━━━━━━━━━━━━━━━━
+ ScrollDemo is Box

• This
    focus-mode = FocusMode.keys

────────────────────

<This • flex-col flex:1 bg:black p:1
    <Label " Scrolling demo " • bg:white text:black

    <Box • flex-row flex:1 mt:1 bg:black
        <Box vertical-pane • flex-col flex:1 border-solid border:aqua bg:black p:1 mr:1
            <Label " vertical " • bg:aqua text:black

            <Box • flex-col flex:1 bg:black
                for row in 1 .. 80
                    <Label
                        text = vertical-line(row)
                        color = vertical-color(row)
                        background-color = black

        <Box horizontal-pane • flex-col flex:1 border-solid border:yellow bg:black p:1 mr:1
            <Label " horizontal " • bg:yellow text:black

            <Box • flex-row flex:1 bg:black
                for column in 1 .. 36
                    <Label
                        text = horizontal-cell(column)
                        color = horizontal-color(column)
                        background-color = black

        <Box both-pane • flex-col flex:1 border-solid border:lime bg:black p:1
            <Label " both axes " • bg:lime text:black

            <Box • flow-row flex:1 bg:black
                for column in 1 .. 18
                    <Box • flex-col bg:black mr:1
                        min-width = SizeSpec.coord(22)
                        max-width = SizeSpec.coord(22)

                        for row in 1 .. 48
                            <Label
                                text = both-cell(column, row)
                                color = both-color(column, row)
                                background-color = black

━━━━━━━━━━━━━━━━━━━━
+ vertical-line String
    - row Int

" row ${padded-number(row)}  vertical content continues downward"

━━━━━━━━━━━━━━━━━━━━
+ horizontal-cell String
    - column Int

" ${padded-number(column)} horizontal-cell-with-wide-label "

━━━━━━━━━━━━━━━━━━━━
+ both-cell String
    - column Int
    - row Int

" c${padded-number(column)} r${padded-number(row)} both-axis"

━━━━━━━━━━━━━━━━━━━━
+ padded-number String
    - number Int

if number < 10 then "0$number" else "$number"

━━━━━━━━━━━━━━━━━━━━
+ vertical-color AnsiColor
    - row Int

if row % 2 == 0 then white else silver

━━━━━━━━━━━━━━━━━━━━
+ horizontal-color AnsiColor
    - column Int

if column % 2 == 0 then yellow else white

━━━━━━━━━━━━━━━━━━━━
+ both-color AnsiColor
    - column Int
    - row Int

if (column + row) % 2 == 0 then lime else aqua
