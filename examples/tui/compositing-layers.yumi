────────────────────
+ do close-demo

is-running = false
overlay-opacity-stream.close()
root.close()

────────────────────
+ do start-animation

is-running = true
request-animation-frame(this.animation-frame)

────────────────────
+ do animation-frame

=? if !is-running

frame += 1
advance-overlay()
request-animation-frame(this.animation-frame)

────────────────────
+ do advance-overlay

. panel-width = overlay-panel-width(bounds)
. panel-height = overlay-panel-height(bounds)
. half-width = panel-width / 2
. half-height = panel-height / 2
. min-center-x = half-width
. min-center-y = half-height
. max-center-x = max(min-center-x, (bounds.width - (panel-width - half-width)))
. max-center-y = max(min-center-y, (bounds.height - (panel-height - half-height)))

center-x += velocity-x
center-y += velocity-y

if center-x <= min-center-x || center-x >= max-center-x
    velocity-x = -velocity-x
    center-x = clipped-coordinate(center-x, min-center-x, max-center-x)

if center-y <= min-center-y || center-y >= max-center-y
    velocity-y = -velocity-y
    center-y = clipped-coordinate(center-y, min-center-y, max-center-y)

if overlay-width != panel-width
    overlay-width = panel-width
if overlay-height != panel-height
    overlay-height = panel-height

latest-left = center-x - half-width
latest-top = center-y - half-height

