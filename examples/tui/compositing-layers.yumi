do use canvas
    for y in rect.y .. < rect.bottom
        for x in rect.x .. < rect.right
            canvas.paint-background-cell(gradient-color(x, y, rect), (x, y))

━━━━━━━━━━━━━━━━━━━━
+ do slow-opacity-loop AsyncChannel'Ratio

. channel = AsyncChannel'Ratio()
do new
    30ms.wait()

    while !channel.is-closed
        for opacity in slow-opacity-pass()
            if channel.is-closed
                break

            channel <- opacity
            30ms.wait()
= channel

━━━━━━━━━━━━━━━━━━━━
+ do slow-opacity-pass <Ratio>

for step in 0 .. 360 by 0.05
    . phase Radians = (step as Float) * 1deg
    . wave = (sin(phase) + 1) / 2
    <= 0.2%% + 0.7%% * wave

━━━━━━━━━━━━━━━━━━━━
_ gradient-color RGBA
    - x Coord
    - y Coord
    - rect Rect

RGBA(red, green, blue)

.. red = 0.05 + 0.5 * x-ratio + 0.2 * y-ratio
.. green = 0.12 + 0.25 * inverse-x + 0.45 * y-ratio
.. blue = 0.35 + 0.5 * inverse-y + 0.1 * x-ratio
.. inverse-x = 1 - x-ratio
.. inverse-y = 1 - y-ratio
.. x-ratio = ((x - rect.x) as Float) / ((width - 1) as Float)
.. y-ratio = ((y - rect.y) as Float) / ((height - 1) as Float)
.. width = if rect.width > 1 then rect.width else 2
.. height = if rect.height > 1 then rect.height else 2

━━━━━━━━━━━━━━━━━━━━
_ do clipped-coordinate Coord
    - value Coord
    - minimum Coord
    - maximum Coord

. result = value
if result < minimum
    result = minimum
if result > maximum
    result = maximum
= result

