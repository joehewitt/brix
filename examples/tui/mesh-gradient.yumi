━━━━━━━━━━━━━━━━━━━━
+ MeshGradient

+ columns Int
+ rows Int
+ vertices [MeshGradientVertex]

────────────────────
+ This
    - columns
    - rows
    - vertices

────────────────────
+ get is-valid Bool

columns >= 2 && rows >= 2 && vertices.length == columns * rows

────────────────────
+ vertex-at MeshGradientVertex
    - column Int
    - row Int

vertices[row * columns + column]

────────────────────
+ do move-vertex
    - index Index
    - point MeshGradientPoint

=? if index >= vertices.length

. vertex = vertices[index]
. clamped-point = edge-clamped-point(index, point)
vertices[index] = MeshGradientVertex(clamped-point, vertex.color)

────────────────────
+ insert-edge-vertex Index?
    - hit MeshGradientEdgeHit

match hit.direction
    | MeshGradientEdgeDirection.horizontal
        insert-column-after(hit.column, hit.ratio, hit.row)
    ??
        insert-row-after(hit.row, hit.ratio, hit.column)

────────────────────
+ do insert-column-after Index?
    - left-column Int
    - ratio Ratio
    - selected-row Int

=? if left-column < 0 || left-column >= columns - 1

vertices =
    ** product(0 .. < rows, 0 .. < columns)
    *>
        * vertex-at(column, row)
        *? interpolated if column == left-column
            .. interpolated = mesh-interpolated-vertex()
                - vertex-at(column, row)
                - vertex-at(column + 1, row)
                - ratio
        .. row, column = each
    |> flat-map

columns += 1

= selected-row * columns + (left-column + 1)

────────────────────
+ do insert-row-after Index?
    - top-row Int
    - ratio Ratio
    - selected-column Int

=? if top-row < 0 || top-row >= rows - 1

vertices =
    ** product(0 .. < rows, 0 .. < columns)
    *>
        * vertex-at(column, row)
        *? interpolated if row == top-row
            .. interpolated = mesh-interpolated-vertex()
                - vertex-at(column, row)
                - vertex-at(column, row + 1)
                - ratio
        .. row, column = each
    |> flat-map

rows += 1

= (top-row + 1) * columns + selected-column

────────────────────
+ delete-vertex Bool
    - index Index

|? index >= vertices.length || is-corner-index(index)
    false
|? row <= 0 || row >= rows - 1
    delete-column(column)
|? column <= 0 || column >= columns - 1
    delete-row(row)
|? columns > 2
    delete-column(column)
|? rows > 2
    delete-row(row)
??
    false

.. column = (index as Int) % columns
.. row = (index as Int) / columns

────────────────────
+ do delete-column Bool
    - removed-column Int

=? if removed-column <= 0 || removed-column >= columns - 1 || columns <= 2

vertices =
    ** product(0 .. < rows, kept-columns)
        .. kept-columns
            ** 0 .. < columns
            ?> each != removed-column
    *> vertex-at(column, row)
        .. row, column = each

columns -= 1

= true

────────────────────
+ do delete-row Bool
    - removed-row Int

=? if removed-row <= 0 || removed-row >= rows - 1 || rows <= 2

vertices =
    ** product(kept-rows, 0 .. < columns)
        .. kept-rows
            ** 0 .. < rows
            ?> each != removed-row
    *> vertex-at(column, row)
        .. row, column = each

rows -= 1

= true

────────────────────
+ edge-clamped-point MeshGradientPoint
    - index Index
    - point MeshGradientPoint

MeshGradientPoint(edge-clamped-x(column, point.x), edge-clamped-y(row, point.y))

.. column = (index as Int) % columns
.. row = (index as Int) / columns

────────────────────
+ edge-clamped-x Ratio
    - column Int
    - value Ratio

|? column <= 0
    0%%
|? column >= columns - 1
    1%%
??
    clamped-ratio(value)

────────────────────
+ edge-clamped-y Ratio
    - row Int
    - value Ratio

|? row <= 0
    0%%
|? row >= rows - 1
    1%%
??
    clamped-ratio(value)

────────────────────
+ is-corner-index Bool
    - index Index

|? columns <= 0 || rows <= 0
    false
??
    (column <= 0 || column >= columns - 1) && (row <= 0 || row >= rows - 1)

.. column = (index as Int) % columns
.. row = (index as Int) / columns

────────────────────
+ do color-at RGBA
    - point MeshGradientPoint

=? RGBA(0, 0, 0)
    if !vertices
=? nearest-color(point)
    if !is-valid

for row in 0 .. < rows - 1
    for column in 0 .. < columns - 1
        . top-left = vertex-at(column, row)
        . top-right = vertex-at(column + 1, row)
        . bottom-left = vertex-at(column, row + 1)
        . bottom-right = vertex-at(column + 1, row + 1)

        =? triangle-color(point, top-left, top-right, bottom-left)
        =? triangle-color(point, top-right, bottom-right, bottom-left)

= nearest-color(point)

────────────────────
+ nearest-color RGBA
    - point MeshGradientPoint

best[0].color

.. best = reduce • seed (vertices[0], mesh-distance-squared(point, vertices[0].point)) • stream candidates
    • using :: current, candidate =>
        if candidate[1] < current[1] then candidate else current
.. candidates =
    ** vertices
    *> (each, mesh-distance-squared(point, each.point))

