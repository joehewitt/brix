━━━━━━━━━━━━━━━━━━━━
+ MeshGradientEditor is Box

• This
    focus-mode = FocusMode.keys

+ mesh MeshGradient = demo-mesh-gradient()
+ active-vertex Index?
+ selected-vertex Index?

────────────────────

<This
    background = MeshGradientEditorBackground(mesh, #selected-vertex)

────────────────────
for event on mouse-down

. point = event.point
active-vertex = handle-index-at(point)
if active-vertex != null
    select-vertex(active-vertex)
    move-active-handle(point)
else
    select-vertex(add-vertex-at(point))

────────────────────
for event on mouse-drag

if active-vertex != null
    move-active-handle(event.point)
    event.cancel()

────────────────────
for event on mouse-up

if active-vertex != null
    move-active-handle(event.point)

active-vertex = null

────────────────────
for event on key-press

if event.key == Key.delete || event.key == Key.backspace
    if delete-selected-vertex()
        event.cancel()

────────────────────
+ handle-index-at Index?
    - point Point

mesh-handle-index-at(mesh, point, bounds)

────────────────────
+ do add-vertex-at Index?
    - point Point

. hit = edge-hit-at(point)
=? if !hit

. index = mesh.insert-edge-vertex(hit)
if index != null
    invalidate-paint()

= index

────────────────────
+ edge-hit-at MeshGradientEdgeHit?
    - point Point

mesh-edge-hit-at(mesh, point, bounds)

────────────────────
+ do select-vertex
    - index Index?

if selected-vertex != index
    selected-vertex = index
    invalidate-paint()

────────────────────
+ do move-active-handle
    - point Point

=? if !active-vertex

mesh.move-vertex(active-vertex, mesh-point-from-canvas(point, bounds))
invalidate-paint()

────────────────────
+ do delete-selected-vertex Bool

=? if !selected-vertex

if mesh.delete-vertex(selected-vertex)
    selected-vertex = null
    active-vertex = null
    invalidate-paint()
    = true

= false

