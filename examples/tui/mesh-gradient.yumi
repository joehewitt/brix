╌╌╌╌╌╌╌╌╌╌ is Painter ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint
    - node Box
    - rect Rect
    - canvas Canvas

do use canvas
    paint-mesh-gradient(mesh, rect, canvas)
    paint-mesh-control-lines(mesh, rect, canvas)
    paint-mesh-control-handles(mesh, rect, canvas, selected-vertex)

━━━━━━━━━━━━━━━━━━━━
_ do paint-mesh-gradient
    - mesh MeshGradient
    - rect Rect
    - canvas Canvas

for y in rect.y .. < rect.bottom
    for x in rect.x .. < rect.right
        . mesh-point = mesh-point-for-cell(x, y, rect)
        . cell-color = mesh.color-at(mesh-point)
        canvas.paint-background-cell(cell-color, (x, y))

━━━━━━━━━━━━━━━━━━━━
_ do paint-mesh-control-lines
    - mesh MeshGradient
    - rect Rect
    - canvas Canvas

=? if !mesh.is-valid

for row in 0 .. < mesh.rows
    for column in 0 .. < mesh.columns - 1
        . start = mesh.vertex-at(column, row).point
        . end = mesh.vertex-at(column + 1, row).point
        draw-mesh-dashed-line(start, end, rect, canvas)

for column in 0 .. < mesh.columns
    for row in 0 .. < mesh.rows - 1
        . start = mesh.vertex-at(column, row).point
        . end = mesh.vertex-at(column, row + 1).point
        draw-mesh-dashed-line(start, end, rect, canvas)

━━━━━━━━━━━━━━━━━━━━
_ do paint-mesh-control-handles
    - mesh MeshGradient
    - rect Rect
    - canvas Canvas
    - selected-vertex Index?

. index Index = 0
for vertex in mesh.vertices
    if !mesh.is-corner-index(index)
        draw-mesh-handle()
            - vertex
            - mesh-handle-is-selected(index, selected-vertex)
            - rect
            - canvas
    index += 1

━━━━━━━━━━━━━━━━━━━━
_ do draw-mesh-dashed-line
    - a MeshGradientPoint
    - b MeshGradientPoint
    - rect Rect
    - canvas Canvas

. start = mesh-point-to-canvas(a, rect)
. end = mesh-point-to-canvas(b, rect)
. dx Int = end.x - start.x
. dy Int = end.y - start.y
. steps = max(abs(dx), abs(dy))

if steps <= 0
    draw-mesh-line-cell(start, canvas)
    =
for step in 0 .. steps
    if step % 2 == 0
        . ratio = (step as Float) / (steps as Float)
        . x = round((start.x as Float) + (dx as Float) * ratio) as Coord
        . y = round((start.y as Float) + (dy as Float) * ratio) as Coord
        . point = Point(x, y)
        draw-mesh-line-cell(point, canvas)

━━━━━━━━━━━━━━━━━━━━
_ do draw-mesh-line-cell
    - point Point
    - canvas Canvas

canvas.background = null
canvas.text-color = lightgray
canvas.move(point)
canvas.print(".")

━━━━━━━━━━━━━━━━━━━━
_ do draw-mesh-handle
    - vertex MeshGradientVertex
    - is-selected Bool
    - rect Rect
    - canvas Canvas

. canvas-point = mesh-point-to-canvas(vertex.point, rect)
canvas.background = null
canvas.text-color = mesh-handle-color(vertex.color)
canvas.move(canvas-point)
canvas.print(mesh-handle-glyph(is-selected))

