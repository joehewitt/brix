━━━━━━━━━━━━━━━━━━━━
_ mesh-vertex MeshGradientVertex
    - x Ratio
    - y Ratio
    - color RGBA

MeshGradientVertex(MeshGradientPoint(x, y), color)

━━━━━━━━━━━━━━━━━━━━
_ mesh-point-for-cell MeshGradientPoint
    - x Coord
    - y Coord
    - rect Rect

MeshGradientPoint(x-ratio, y-ratio)

.. x-ratio = (((x - rect.x) as Float) + 0.5) / (width as Float)
    .. width = if rect.width > 0 then rect.width else 1
.. y-ratio = (((y - rect.y) as Float) + 0.5) / (height as Float)
    .. height = if rect.height > 0 then rect.height else 1

━━━━━━━━━━━━━━━━━━━━
_ mesh-point-to-canvas Point
    - point MeshGradientPoint
    - rect Rect

Point(x, y)

.. x = min(max-x, (max(rect.x, raw-x)))
    .. max-x = max(rect.x, (rect.right - 1))
    .. raw-x = rect.x + (round(point.x * ((width - 1) as Float)) as Coord)
        .. width = if rect.width > 1 then rect.width else 1
.. y = min(max-y, (max(rect.y, raw-y)))
    .. max-y = max(rect.y, (rect.bottom - 1))
    .. raw-y = rect.y + (round(point.y * ((height - 1) as Float)) as Coord)
        .. height = if rect.height > 1 then rect.height else 1

━━━━━━━━━━━━━━━━━━━━
_ mesh-point-from-canvas MeshGradientPoint
    - point Point
    - rect Rect

MeshGradientPoint(clamped-ratio(x-ratio), clamped-ratio(y-ratio))

.. x-ratio = ((point.x - rect.x) as Float) / ((width - 1) as Float)
    .. width = if rect.width > 1 then rect.width else 2
.. y-ratio = ((point.y - rect.y) as Float) / ((height - 1) as Float)
    .. height = if rect.height > 1 then rect.height else 2

━━━━━━━━━━━━━━━━━━━━
_ mesh-handle-index-at Index?
    - mesh MeshGradient
    - point Point
    - rect Rect

best[0]

.. best = reduce • seed (null as Index?, 2) • stream candidates
    • using :: current, candidate =>
        if candidate[1] < current[1] then candidate else current
.. candidates =
    ** indexed(mesh.vertices)
    ?> !mesh.is-corner-index(each[0])
    ?*> (each[0] as Index?, distance) if distance <= 1
        .. handle = mesh-point-to-canvas(each[1].point, rect)
        .. dx Int = point.x - handle.x
        .. dy Int = point.y - handle.y
        .. distance = max(abs(dx), abs(dy))

━━━━━━━━━━━━━━━━━━━━
_ mesh-edge-hit-at MeshGradientEdgeHit?
    - mesh MeshGradient
    - point Point
    - rect Rect

reduce • seed (null as MeshGradientEdgeHit?) • stream candidates
    • using :: current, candidate =>
        if !current || candidate.distance < current.distance then candidate else current

.. candidates =
    **
        product(0 .. < mesh.rows, 0 .. < mesh.columns - 1)
        ?*> mesh-edge-hit-candidate(.horizontal, each[1], each[0], point, start, end)
            .. start = mesh-point-to-canvas(mesh.vertex-at(each[1], each[0]).point, rect)
            .. end = mesh-point-to-canvas(mesh.vertex-at(each[1] + 1, each[0]).point, rect)
    **
        product(0 .. < mesh.columns, 0 .. < mesh.rows - 1)
        ?*> mesh-edge-hit-candidate(.vertical, each[0], each[1], point, start, end)
            .. start = mesh-point-to-canvas(mesh.vertex-at(each[0], each[1]).point, rect)
            .. end = mesh-point-to-canvas(mesh.vertex-at(each[0], each[1] + 1).point, rect)
    ?> each.distance < 2

━━━━━━━━━━━━━━━━━━━━
_ mesh-edge-hit-candidate MeshGradientEdgeHit?
    - direction MeshGradientEdgeDirection
    - column Int
    - row Int
    - point Point
    - start Point
    - end Point

|? !mesh-edge-insert-ratio(ratio)
    MeshGradientEdgeHit?()
|? distance > 1.0
    MeshGradientEdgeHit?()
??
    MeshGradientEdgeHit(direction, column, row, ratio, distance)

.. ratio = mesh-canvas-segment-ratio(point, start, end)
.. distance = mesh-canvas-segment-distance(point, start, end, ratio)

━━━━━━━━━━━━━━━━━━━━
_ mesh-edge-insert-ratio Bool
    - ratio Ratio

ratio > 5% && ratio < 95%

━━━━━━━━━━━━━━━━━━━━
_ mesh-canvas-segment-ratio Ratio
    - point Point
    - start Point
    - end Point

|? length-squared <= 0.000001
    0%%
??
    clamped-ratio(numerator / length-squared)

.. dx = (end.x - start.x) as Float
.. dy = (end.y - start.y) as Float
.. length-squared = dx * dx + dy * dy
.. numerator = x-component + y-component
    .. x-component = (point-x - start-x) * dx
        .. point-x = point.x as Float
        .. start-x = start.x as Float
    .. y-component = (point-y - start-y) * dy
        .. point-y = point.y as Float
        .. start-y = start.y as Float

━━━━━━━━━━━━━━━━━━━━
_ mesh-canvas-segment-distance Float
    - point Point
    - start Point
    - end Point
    - ratio Ratio

sqrt(dx * dx + dy * dy)

.. dx = point-x - nearest-x
    .. point-x = point.x as Float
    .. nearest-x = start-x + segment-x * ratio
        .. start-x = start.x as Float
        .. segment-x = (end.x - start.x) as Float
.. dy = point-y - nearest-y
    .. point-y = point.y as Float
    .. nearest-y = start-y + segment-y * ratio
        .. start-y = start.y as Float
        .. segment-y = (end.y - start.y) as Float

━━━━━━━━━━━━━━━━━━━━
_ mesh-segment-ratio Ratio
    - point MeshGradientPoint
    - a MeshGradientPoint
    - b MeshGradientPoint

|? length-squared <= 0.000001
    0.5%%
??
    clamped-ratio(numerator / length-squared)

.. dx = b.x - a.x
.. dy = b.y - a.y
.. length-squared = dx * dx + dy * dy
.. numerator = x-component + y-component
    .. x-component = (point.x - a.x) * dx
    .. y-component = (point.y - a.y) * dy

━━━━━━━━━━━━━━━━━━━━
_ mesh-interpolated-vertex MeshGradientVertex
    - a MeshGradientVertex
    - b MeshGradientVertex
    - ratio Ratio

MeshGradientVertex(point, color)

.. point = mesh-interpolated-point(a.point, b.point, ratio)
.. color = mesh-interpolated-color(a.color, b.color, ratio)

━━━━━━━━━━━━━━━━━━━━
_ mesh-interpolated-point MeshGradientPoint
    - a MeshGradientPoint
    - b MeshGradientPoint
    - ratio Ratio

MeshGradientPoint(x, y)

.. x = mesh-interpolate(a.x, b.x, ratio)
.. y = mesh-interpolate(a.y, b.y, ratio)

━━━━━━━━━━━━━━━━━━━━
_ mesh-interpolated-color RGBA
    - a RGBA
    - b RGBA
    - ratio Ratio

RGBA(red, green, blue, alpha)

.. red = mesh-interpolate(a.red, b.red, ratio)
.. green = mesh-interpolate(a.green, b.green, ratio)
.. blue = mesh-interpolate(a.blue, b.blue, ratio)
.. alpha = mesh-interpolate(a.alpha, b.alpha, ratio)

━━━━━━━━━━━━━━━━━━━━
_ mesh-interpolate Ratio
    - a Ratio
    - b Ratio
    - ratio Ratio

a + (b - a) * ratio

━━━━━━━━━━━━━━━━━━━━
_ mesh-handle-is-selected Bool
    - index Index
    - selected-vertex Index?

|? selected-vertex == null
    false
??
    selected-vertex == index

━━━━━━━━━━━━━━━━━━━━
_ mesh-handle-glyph String
    - is-selected Bool

|? is-selected
    "●"
??
    "o"

━━━━━━━━━━━━━━━━━━━━
_ mesh-handle-color AnsiColor
    - color RGBA

|? mesh-color-luminance(color) > 0.58
    black
??
    white

━━━━━━━━━━━━━━━━━━━━
_ mesh-color-luminance Ratio
    - color RGBA

color.red * 0.299 + color.green * 0.587 + color.blue * 0.114

━━━━━━━━━━━━━━━━━━━━
_ clamped-ratio Ratio
    - value Ratio

min(1%%, (max(0%%, value)))

━━━━━━━━━━━━━━━━━━━━
_ triangle-color RGBA?
    - point MeshGradientPoint
    - a MeshGradientVertex
    - b MeshGradientVertex
    - c MeshGradientVertex

|? abs(denominator) < 0.000001
    RGBA?()
|? a-weight < -0.001 || b-weight < -0.001 || c-weight < -0.001
    RGBA?()
??
    mesh-weighted-color(colors, weights)

.. colors = (a.color, b.color, c.color)
.. weights = (a-weight, b-weight, c-weight)
.. c-weight = 1 - a-weight - b-weight
.. b-weight = b-numerator / denominator
    .. b-numerator = triangle-barycentric-numerator(point, c.point, a.point)
.. a-weight = a-numerator / denominator
    .. a-numerator = triangle-barycentric-numerator(point, b.point, c.point)
.. denominator = triangle-barycentric-numerator(a.point, b.point, c.point)

━━━━━━━━━━━━━━━━━━━━
_ triangle-barycentric-numerator Ratio
    - point MeshGradientPoint
    - edge-a MeshGradientPoint
    - edge-b MeshGradientPoint

x-component + y-component

.. x-component = (edge-a.y - edge-b.y) * (point.x - edge-b.x)
.. y-component = (edge-b.x - edge-a.x) * (point.y - edge-b.y)

━━━━━━━━━━━━━━━━━━━━
_ mesh-weighted-color RGBA
    - colors (a RGBA, b RGBA, c RGBA)
    - weights (a Ratio, b Ratio, c Ratio)

RGBA(red, green, blue, alpha)

.. red = mesh-weighted-channel(red-values, weights)
    .. red-values = (colors.a.red, colors.b.red, colors.c.red)
.. green = mesh-weighted-channel(green-values, weights)
    .. green-values = (colors.a.green, colors.b.green, colors.c.green)
.. blue = mesh-weighted-channel(blue-values, weights)
    .. blue-values = (colors.a.blue, colors.b.blue, colors.c.blue)
.. alpha = mesh-weighted-channel(alpha-values, weights)
    .. alpha-values = (colors.a.alpha, colors.b.alpha, colors.c.alpha)

━━━━━━━━━━━━━━━━━━━━
_ mesh-weighted-channel Ratio
    - values (a Ratio, b Ratio, c Ratio)
    - weights (a Ratio, b Ratio, c Ratio)

values.a * weights.a + values.b * weights.b + values.c * weights.c

━━━━━━━━━━━━━━━━━━━━
_ mesh-distance-squared Float
    - a MeshGradientPoint
    - b MeshGradientPoint

dx * dx + dy * dy

.. dx = a.x - b.x
.. dy = a.y - b.y
