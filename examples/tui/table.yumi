/tui

<Window win • flex-col bg:black
    <TableDemo demo • flex-col flex:1 bg:black

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <Shortcut "Quit"
        key = 'q'
        action = => do win.close()

    <StatusBar
        message = demo.#status-message

win.open()

━━━━━━━━━━━━━━━━━━━━
+ TableDemo is Box

+ status-message = "Arrows select rows. Enter activates. Click headers to sort."

────────────────────

<This • flex-col flex:1 bg:black
    <Label " Deployments " • bg:blue text:white

    <Table'DeployRow table • flex:1 bg:black pr:1 pl:1
        columns = deploy-columns()
        rows = deploy-rows()
        key-builder = deploy-row-key

────────────────────
for event on table.selected

status-message = selected-deploy-message(table.selected-item)

────────────────────
for event on table.activated

status-message = activated-deploy-message(table.selected-item)

────────────────────
for event on table.sorted

status-message = sorted-deploy-message(table.sort-column-id, table.sort-direction)

━━━━━━━━━━━━━━━━━━━━
+ DeployRow is Tuple

+ id String
+ service String
+ owner String
+ status String
+ region String
+ age String

━━━━━━━━━━━━━━━━━━━━
+ deploy-rows [DeployRow]

* DeployRow("1024", "api-gateway", "Mira", "healthy", "iad", "12m")
* DeployRow("1025", "billing-worker", "Jon", "queued", "sfo", "4m")
* DeployRow("1026", "image-resizer", "Nia", "warning", "ams", "31m")
* DeployRow("1027", "search-index", "Ari", "healthy", "fra", "8m")
* DeployRow("1028", "web-frontend", "Sol", "deploying", "hnd", "1m")
* DeployRow("1029", "report-export", "Bea", "healthy", "gru", "45m")
* DeployRow("1030", "edge-cache", "Kai", "warning", "syd", "22m")

━━━━━━━━━━━━━━━━━━━━
+ deploy-columns [TableColumn'DeployRow]

* deploy-column("id", "ID", TableWidth.fixed(5), TableAlign.right, deploy-id)
* deploy-column("service", "Service", TableWidth.flex(2), TableAlign.left, deploy-service)
* deploy-column("owner", "Owner", TableWidth.flex(1), TableAlign.left, deploy-owner)
* deploy-column("status", "Status", TableWidth.fixed(10), TableAlign.left, deploy-status)
* deploy-column("region", "Region", TableWidth.percent(18%), TableAlign.left, deploy-region)
* deploy-column("age", "Age", TableWidth.auto, TableAlign.right, deploy-age)

━━━━━━━━━━━━━━━━━━━━
+ do deploy-column TableColumn'DeployRow
    - id String
    - title String
    - width TableWidth
    - align TableAlign
    - value TableTextProvider'DeployRow

. column = TableColumn'DeployRow(title)
column.id = id
column.column-width = width
column.align = align
column.value = value
= column

━━━━━━━━━━━━━━━━━━━━
+ deploy-row-key String
    - row DeployRow

row.id

━━━━━━━━━━━━━━━━━━━━
+ deploy-id String
    - row DeployRow

row.id

━━━━━━━━━━━━━━━━━━━━
+ deploy-service String
    - row DeployRow

row.service

━━━━━━━━━━━━━━━━━━━━
+ deploy-owner String
    - row DeployRow

row.owner

━━━━━━━━━━━━━━━━━━━━
+ deploy-status String
    - row DeployRow

row.status

━━━━━━━━━━━━━━━━━━━━
+ deploy-region String
    - row DeployRow

row.region

━━━━━━━━━━━━━━━━━━━━
+ deploy-age String
    - row DeployRow

row.age

━━━━━━━━━━━━━━━━━━━━
+ selected-deploy-message String
    - row DeployRow?

|? !row
    "No deployment selected."
??
    "Selected ${row.id}: ${row.service} in ${row.region} (${row.status})."

━━━━━━━━━━━━━━━━━━━━
+ activated-deploy-message String
    - row DeployRow?

|? !row
    "No deployment to activate."
??
    "Activated ${row.service}; owner ${row.owner}, age ${row.age}."

━━━━━━━━━━━━━━━━━━━━
+ sorted-deploy-message String
    - column String?
    - direction TableSortDirection = TableSortDirection.none

|? !column || direction == TableSortDirection.none
    "Sort cleared."
??
    "Sorted by ${column} ${table-sort-direction-label(direction)}."

━━━━━━━━━━━━━━━━━━━━
+ table-sort-direction-label String
    - direction TableSortDirection

match direction
    | TableSortDirection.descending
        "descending"
    ??
        "ascending"
