
/tui

<Window win • flex-col
    <DialogDemo app • flex-col flex:1 bg:navy

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <StatusBar
        message = app.#status-message

win.open()

━━━━━━━━━━━━━━━━━━━━
• DemoTheme

• ModalDialog
    • dialog-button
        background-color = red

        when #is-focused
            background-color = blue

━━━━━━━━━━━━━━━━━━━━
+ DialogDemo is Box
    using DemoTheme

• This
    focus-mode = FocusMode.keys

+ status-message = "no dialog has been answered yet."
+ show-alert-dialog = false
+ show-confirm-dialog = false

────────────────────

<Label " Modal Dialogs" • bg:blue text:white

<AlertDialog alert-dialog
    title = "Alert"
    message = "This is a canned alert dialog."
    display = if #show-alert-dialog then Display.visible else Display.hidden

<ConfirmDialog confirm-dialog
    title = "Confirm"
    message = "Do you want to keep exploring dialogs?"
    display = if #show-confirm-dialog then Display.visible else Display.hidden

<Shortcut "Alert"
    key = 'a'
    action = => do show-alert()

<Shortcut "Confirm"
    key = 'c'
    action = => do show-confirm()

────────────────────
for alert-event on alert-dialog.accepted

alert-accepted()

────────────────────
for alert-event on alert-dialog.dismissed

close-dialog()

────────────────────
for confirm-event on confirm-dialog.accepted

confirm-accepted()

────────────────────
for confirm-event on confirm-dialog.canceled

confirm-canceled()

────────────────────
for confirm-event on confirm-dialog.dismissed

close-dialog()

────────────────────
+ do close-dialog

show-alert-dialog = false
show-confirm-dialog = false

────────────────────
+ do alert-accepted

status-message = "alert accepted."
close-dialog()

────────────────────
+ do confirm-accepted

status-message = "confirm accepted."
close-dialog()

────────────────────
+ do confirm-canceled

status-message = "confirm canceled."
close-dialog()

────────────────────
+ do show-alert

status-message = "alert opened."
show-confirm-dialog = false
show-alert-dialog = true

────────────────────
+ do show-confirm

status-message = "confirm opened."
show-alert-dialog = false
show-confirm-dialog = true
