(import /ai)
(import /ai/openai/completions)
(import /net/url)
(import /os/env)
(import /stream/inspect)
(import /tui)
(import /tui/colors)
(import /tui/text)
(blank)

(main
  (<> Window (id: win) (• flex-row)
    (<> Box (• flex 1))
    (<> ChatShell (id: app) (• flex-col)
      (= min-width (call (. SizeSpec coord) 80))
      (= max-width (call (. SizeSpec coord) 80))
    )
    (<> Box (• flex 1))
  )
  (blank)
  (call (. win open))
)

(type + ChatShell (is Form)
  (prop + messages (list ChatMessage)
    (block
      (bullet (call ChatMessage "message-0" "Status" "Welcome to ChatGPT"))
    )
  )
  (prop + next-message-id _ (= 1))
  (prop + pending-stream-chunks (list ChatStreamChunk))
  (prop + is-transcript-flush-pending _ (= false))
  (prop + should-auto-scroll-transcript _ (= true))
  (blank)
  (rule This
    (= color lightgray)
    (= min-width (call (. SizeSpec coord) 80))
    (= max-width (call (. SizeSpec coord) 80))
    (blank)
    (rule transcript
      (= color lightgray)
      (= padding-top 1)
      (= padding-bottom 1)
    )
    (blank)
    (rule prompt-shell
      (= border-style (. BorderStyle rounded))
      (= border-color midgray)
      (= padding-left 1)
      (= padding-right 1)
    )
    (blank)
    (rule composer
      (= color lightgray)
      (= background-color null)
      (blank)
      (when-style #is-focused
        (= background-color null)
      )
      (when-style (not #is-effectively-enabled)
        (= background-color null)
      )
    )
  )
  (content
    (<> This
      (<> Box (id: transcript) (• flow-col) (• flex 1)
        (for (in chat-message #messages (keyed-by (. chat-message id)))
          (<> ChatMessageRow
            (= message chat-message)
          )
        )
      )
      (blank)
      (<> Box (id: prompt-shell) (• flex-row) (• mb 1)
        (<> TextEditor (id: composer) (text: "") (• flex 1)
          (= multiline true)
          (= max-height 6)
        )
      )
      (blank)
      (<> Shortcut (text: "Quit")
        (= key .escape)
        (= action (=> () :do (call (. root close))))
      )
    )
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key arrow-up))
      (call scroll-transcript (. Direction up))
      (call (. event cancel))
      (else-if (== (. event key) (. Key arrow-down))
        (call scroll-transcript (. Direction down))
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event scrolled)
    (call scroll-transcript (. event direction))
    (call (. event cancel))
  )
  (subscribe-for (on event submitted)
    (let prompt (call (. composer text trim)))
    (if (> (. prompt length) 0)
      (= (. composer text) "")
      (= should-auto-scroll-transcript true)
      (blank)
      (let user-message (call next-chat-message "You" prompt))
      (let reply (call next-chat-message "ChatGPT" ""))
      (= (. reply is-pending) true)
      (blank)
      (+= messages user-message)
      (let request (call chatgpt-request messages))
      (let reply-index (. messages length))
      (+= messages reply)
      (call refresh-transcript transcript should-auto-scroll-transcript)
      (blank)
      (do-new
        (inline (call stream-response request reply-index))
      )
    )
  )
  (fn-do + next-chat-message ChatMessage
    (param author String)
    (param body String)
    (let id (str "message-" next-message-id))
    (+= next-message-id 1)
    (return (call ChatMessage id author body))
  )
  (fn-do + stream-response _
    (param request (list AIMessage))
    (param output-index Index)
    (call stream-chatgpt-response request output-index
      (block
        (on-error (: err Error)
          (call handle-stream-response-error err output-index)
        )
      )
    )
  )
  (fn-do + handle-stream-response-error _
    (param error Error)
    (param output-index Index)
    (call set-message-at output-index "Status" (str "API error: " error) false)
    (call refresh-transcript transcript should-auto-scroll-transcript)
    (return false)
  )
  (fn-do + stream-chatgpt-response _
    (param request (list AIMessage))
    (param output-index Index)
    (let api-key (?? (call env "OPENAI_API_KEY") (call env "MOCK_CHATGPT_API_KEY") "mock-api-key"))
    (let model (?? (call env "CHATGPT_MODEL") (call env "OPENAI_MODEL") (call env "MOCK_CHATGPT_MODEL") "gpt-5.2"))
    (let base-url (?? (call env "CHATGPT_BASE_URL") (call env "OPENAI_BASE_URL") (call env "MOCK_CHATGPT_BASE_URL")))
    (let client
      (scope (if-expr base-url (call OpenAICompletions api-key (call URL base-url)) default-client)
        (lazy default-client (call OpenAICompletions api-key))
      )
    )
    (let ai-request (call AIRequest model request))
    (blank)
    (let did-receive-content false)
    (for (in event (call (. client stream) ai-request))
      (if (and (is event AIPartDeltaEvent) (is (. (as event AIPartDeltaEvent) delta) AITextDelta))
        (let content (. (as (. (as event AIPartDeltaEvent) delta) AITextDelta) text))
        (call queue-message-content output-index content (not did-receive-content))
        (= did-receive-content true)
      )
    )
    (blank)
    (if (not did-receive-content)
      (call set-message-at output-index "ChatGPT" "" false)
      (call refresh-transcript transcript should-auto-scroll-transcript)
    )
    (return true)
  )
  (fn-do + queue-message-content _
    (param index Index)
    (param content String)
    (param is-first-content Bool)
    (+= pending-stream-chunks (call ChatStreamChunk index content is-first-content))
    (if (not is-transcript-flush-pending)
      (call request-animation-frame (. this flush-transcript))
    )
    (= is-transcript-flush-pending true)
  )
  (fn-do + flush-transcript _
    (return-if (if (not is-transcript-flush-pending)))
    (blank)
    (let chunks pending-stream-chunks)
    (= pending-stream-chunks (call (of List ChatStreamChunk)))
    (= is-transcript-flush-pending false)
    (blank)
    (for (in chunk chunks)
      (call append-message-content (. chunk index) (. chunk content) (. chunk is-first-content))
    )
    (blank)
    (if chunks
      (call refresh-transcript transcript should-auto-scroll-transcript)
    )
  )
  (fn-do + set-message-at _
    (param index Index)
    (param author String)
    (param body String)
    (param is-pending Bool)
    (return-if (if (>= index (. messages length))))
    (blank)
    (let current ([] messages index))
    (= ([] messages index) (call chat-message-state current author body is-pending))
  )
  (fn-do + chat-message-state ChatMessage
    (param current ChatMessage)
    (param author String)
    (param body String)
    (param is-pending Bool)
    (let next (call ChatMessage (. current id) author body))
    (= (. next is-pending) is-pending)
    (return next)
  )
  (fn-do + scroll-transcript _
    (param direction Direction)
    (call (. transcript update-layout))
    (call (. transcript scroll) 3 direction)
    (= should-auto-scroll-transcript
      (block
        (case? (== direction (. Direction up))
          false
        )
        (case? (call is-transcript-at-bottom transcript)
          true
        )
        (default
          should-auto-scroll-transcript
        )
      )
    )
  )
  (fn-do _ append-message-content _
    (param index Index)
    (param content String)
    (param is-first-content Bool)
    (return-if (if (>= index (. messages length))))
    (blank)
    (let current ([] messages index))
    (let body (. current body))
    (if is-first-content
      (= body "")
    )
    (+= body content)
    (= ([] messages index) (call chat-message-state current (. current author) body false))
  )
)

(type + ChatMessageRow (is Box)
  (prop + message ChatMessage)
  (blank)
  (rule This
    (= layout flow-col)
    (= margin-bottom 1)
  )
  (content
    (<> This
      (<> Box (• flex-row)
        (<> Box
          (= flex (call message-leading-flex #message))
        )
        (blank)
        (<> Box (• flex-col)
          (= background-color (call message-background-color #message))
          (= color (call message-foreground-color #message))
          (= padding-left (call message-horizontal-padding #message))
          (= padding-right (call message-horizontal-padding #message))
          (= min-width (call message-box-width #message))
          (= max-width (call message-box-width #message))
          (blank)
          (if (. #message is-pending)
            (<> Spinner
              (= frames (. SpinnerFrames braille))
            )
          )
          (blank)
          (if (and (not (. #message is-pending)) (call is-assistant-message #message))
            (<> MarkdownText
              (= text (. #message body))
              (= color lightgray)
              (= header-color (call ansi-cyan))
              (= strong-color white)
              (= em-color gold)
              (= link-color sky)
              (= image-color pink)
              (= quote-color mutedgray)
              (= code-color chartreuse)
              (= divider-color mutedgray)
              (= bullet-color gold)
              (= max-width (call message-box-width #message))
            )
          )
          (blank)
          (if (and (not (. #message is-pending)) (not (call is-assistant-message #message)))
            (for (in line (call wrapped-message-lines (. #message body) (call message-text-width #message)))
              (<> Label
                (= text line)
                (= background-color (call message-background-color #message))
                (= color (call message-foreground-color #message))
              )
            )
          )
        )
      )
    )
  )
  (fn-do + This _
    (param message _)
  )
)

(type + ChatMessage
  (prop + id String)
  (prop + author String)
  (prop + body String)
  (prop + is-pending _ (= false))
  (fn-do + This _
    (param id _)
    (param author _)
    (param body _)
  )
)

(type + ChatStreamChunk (is Tuple)
  (prop + index Index)
  (prop + content String)
  (prop + is-first-content Bool)
)

(fn-expr + is-user-message _
  (param message ChatMessage)
  (== (. message author) "You")
)

(fn-expr + is-assistant-message _
  (param message ChatMessage)
  (== (. message author) "ChatGPT")
)

(fn-expr + message-leading-flex Flex
  (param message ChatMessage)
  (if-expr (call is-user-message message) 1 0)
)

(fn-expr + message-foreground-color AnsiColor
  (param message ChatMessage)
  (if-expr (== (. message author) "Status") mutedgray lightgray)
)

(fn-expr + message-background-color (? BackgroundColor)
  (param message ChatMessage)
  (only-if dimgray (if (call is-user-message message)))
)

(fn-expr + message-horizontal-padding Coord
  (param message ChatMessage)
  (if-expr (call is-user-message message) 1 0)
)

(fn-expr + message-text-width Coord
  (param message ChatMessage)
  (if-expr (call is-user-message message) 55 80)
)

(fn-expr + message-box-width SizeSpec
  (param message ChatMessage)
  (call (. SizeSpec coord) (call message-text-width message))
)

(fn-expr + wrapped-message-lines _
  (param text String)
  (param width Coord)
  (if-expr (> (. result length) 0) result (list ""))
  (where
    (lazy result
      (block
        (bullet* (call (. text split) "\n"))
        (pipe *> (call wrap-message-line each safe-width))
        (pipe |> flat-map)
        (pipe |> List)
      )
    )
    (lazy safe-width (as (if-expr (> width 0) width 1) Size))
  )
)

(fn-expr + wrap-message-line _ @inline
  (param source-line String)
  (param width Size)
  (bullet? (only-if "" (if (not source-line))))
  (bullet*
    (block
      (..< 0 (. source-line length) (by: width))
      (pipe *>
        (scope ([] source-line (..< each end))
          (lazy proposed-end (+ each width))
          (lazy end (if-expr (< proposed-end (. source-line length)) proposed-end (. source-line length)))
        )
      )
    )
  )
)

(fn-expr + chatgpt-request _
  (param chat-messages (list ChatMessage))
  (bullet (call AIMessage (. AIMessageRole system) system-prompt))
  (bullet*
    (block
      (bullet* chat-messages)
      (pipe ?> (> (. each body length) 0))
      (pipe ?*>
        (match? (. each author)
          (case= "You"
            (call AIMessage (. AIMessageRole user) (. each body))
          )
          (case= "ChatGPT"
            (call AIMessage (. AIMessageRole assistant) (. each body))
          )
        )
      )
    )
  )
  (pipe |> List)
  (where
    (lazy system-prompt
      (call (. "" join)
        (block
          (bullet "You are ChatGPT inside Yumi's terminal chat UI. ")
          (bullet "Answer in clear, concise Markdown.")
        )
      )
    )
  )
)

(fn-do + refresh-transcript _
  (param transcript Box)
  (param should-scroll-to-bottom _ (= true))
  (let batch-root (. transcript markup-batch-root))
  (if batch-root
    (call (. batch-root markup-batch-queue checkpoint))
  )
  (blank)
  (call (. transcript update-layout))
  (if (and should-scroll-to-bottom (. transcript has-overflow))
    (call (. transcript scroll) 1000 (. Direction down))
    (else-if (not (. transcript has-overflow))
      (call (. transcript scroll) (tuple 0 0))
    )
  )
)

(fn-expr + is-transcript-at-bottom _
  (param transcript Box)
  (<= (. transcript scroll-y) (call transcript-bottom-scroll-y transcript))
)

(fn-expr + transcript-bottom-scroll-y Coord
  (param transcript Box)
  (if-expr (< bottom 0) bottom 0)
  (where
    (lazy bottom (- (. transcript content-bounds height) (. transcript inner-height)))
  )
)
