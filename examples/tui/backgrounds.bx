(import /units)
(import /graphics/color)
(import /os/env)
(import /time)
(import /tui)
(blank)

(main
  (<> App
    (<> Window (id: win) (• flex-col)
      (<> BackgroundGallery (id: gallery) (• flex-col) (• flex 1))
      (<> Shortcut (text: "Quit")
        (= key 'q')
        (= action (=> () :do (call (. win close))))
      )
      (<> Shortcut (text: "Quit")
        (= key .escape)
        (= show-in-status false)
        (= action (=> () :do (call (. win close))))
      )
      (<> StatusBar)
    )
  )
  (blank)
  (call (. gallery start-profile-if-needed))
)

(type + BackgroundGallery (is Box)
  (prop + profile-frames-remaining _ (= 0))
  (prop + is-profile-running _ (= false))
  (content
    (<> Label (text: " Background Gallery ") (• bg white) (• text black))
    (<> Box (• flex-row) (• flex 1) (• bg black)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (<> Label (text: " unset ") (• bg grey) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• bg blue) (• text white)
        (<> Label (text: " ansi blue ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• bg vermillion) (• text white)
        (<> Label (text: " ansi vermillion ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (= background-color (call RGBA "#336699"))
        (<> Label (text: " rgba hex ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
    )
    (blank)
    (<> Box (• flex-row) (• flex 1) (• bg navy)
      (<> Box (• flex-col) (• flex 1) (• text black)
        (= background-color (call RGBA 12% 68% 58%))
        (<> Label (text: " rgba ") (• bg white) (• text black))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (= background-color (call RGBA 100% 55% 10% 45%))
        (<> Label (text: " rgba alpha ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text black)
        (= background-color (call HSVA 62% 70% 95%))
        (<> Label (text: " hsva ") (• bg white) (• text black))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (= background (call GradientBackground (call RGBA 5% 35% 95%) (call RGBA 100% 35% 65%)))
        (<> Label (text: " painter gradient ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
    )
    (blank)
    (<> Box (• flex-row) (• flex 1) (• bg black)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (= background (call CheckerBackground deepblue (call RGBA 0% 78% 82%)))
        (<> Label (text: " painter checker ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text white)
        (= background (call RibbonBackground (call RGBA 8% 12% 28%) (call RGBA 100% 85% 20% 42%)))
        (<> Label (text: " painter ribbons ") (• bg black) (• text white))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text black)
        (= background (call SpectrumBackground))
        (<> Label (text: " painter spectrum ") (• bg white) (• text black))
        (<> Box (• flex 1))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• text black)
        (= background (call GradientBackground (call RGBA 10% 90% 38%) (call RGBA 100% 80% 0%)))
        (<> Label (text: " painter glow ") (• bg white) (• text black))
        (<> Box (• flex 1))
      )
    )
  )
  (fn-do + start-profile-if-needed _
    (= profile-frames-remaining (call background-profile-frame-count))
    (return-if (if (<= profile-frames-remaining 0)))
    (blank)
    (= is-profile-running true)
    (do-new
      (inline (call run-profile-session))
    )
  )
  (fn-do + run-profile-session _
    (probe-group + backgrounds.profile.run)
    (call request-animation-frame (. this profile-frame))
    (while is-profile-running
      (call (. 1ms wait))
    )
    (call (. 1ms wait))
    (probe-group - backgrounds.profile.run)
    (call (. root close))
  )
  (fn-do + profile-frame _
    (return-if (if (not is-profile-running)))
    (blank)
    (if (<= profile-frames-remaining 0)
      (call finish-profile)
      (return)
    )
    (-= profile-frames-remaining 1)
    (if (<= profile-frames-remaining 0)
      (call finish-profile)
      (else
        (call invalidate-paint)
        (call request-animation-frame (. this profile-frame))
      )
    )
  )
  (fn-do + finish-profile _
    (return-if (if (not is-profile-running)))
    (blank)
    (= is-profile-running false)
  )
)

(type + GradientBackground (is Painter)
  (prop + start RGBA)
  (prop + end RGBA)
  (fn-do + This _
    (param start _)
    (param end _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (for (in y (..< (. rect y) (. rect bottom)))
      (for (in x (..< (. rect x) (. rect right)))
        (do-use canvas
          (= (. canvas background) (call color-at x rect))
          (call (. canvas fill) (call Rect x y 1 1))
        )
      )
    )
  )
  (fn-expr _ color-at RGBA
    (param x Coord)
    (param rect Rect)
    (call RGBA red green blue)
    (where
      (lazy red (+ (* (. start red) inverse) (* (. end red) ratio)))
      (lazy green (+ (* (. start green) inverse) (* (. end green) ratio)))
      (lazy blue (+ (* (. start blue) inverse) (* (. end blue) ratio)))
      (lazy inverse (- 1 ratio))
      (lazy ratio (/ (as (- x (. rect x)) Float) (as (- width 1) Float)))
      (lazy width (if-expr (> (. rect width) 1) (. rect width) 2))
    )
  )
)

(type + CheckerBackground (is Painter)
  (prop + even BackgroundColor)
  (prop + odd BackgroundColor)
  (fn-do + This _
    (param even _)
    (param odd _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (for (in y (..< (. rect y) (. rect bottom)))
      (for (in x (..< (. rect x) (. rect right)))
        (do-use canvas
          (= (. canvas background)
            (block
              (case? (call checker-is-even x y rect)
                even
              )
              (default
                odd
              )
            )
          )
          (call (. canvas fill) (call Rect x y 1 1))
        )
      )
    )
  )
  (fn-expr _ checker-is-even _
    (param x Coord)
    (param y Coord)
    (param rect Rect)
    (== (% (- (+ (/ (- x (. rect x)) 2) y) (. rect y)) 2) 0)
  )
)

(type + RibbonBackground (is Painter)
  (prop + base RGBA)
  (prop + stripe RGBA)
  (fn-do + This _
    (param base _)
    (param stripe _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (= (. canvas background) base)
      (call (. canvas fill) rect)
    )
    (blank)
    (for (in y (..< (. rect y) (. rect bottom)))
      (for (in x (..< (. rect x) (. rect right)))
        (if (call is-ribbon x y rect)
          (do-use canvas
            (= (. canvas background) stripe)
            (call (. canvas fill) (call Rect x y 1 1))
          )
        )
      )
    )
  )
  (fn-expr _ is-ribbon _
    (param x Coord)
    (param y Coord)
    (param rect Rect)
    (< (% (+ (- x (. rect x)) (* (- y (. rect y)) 2)) 9) 3)
  )
)

(type + SpectrumBackground (is Painter)
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (for (in y (..< (. rect y) (. rect bottom)))
      (for (in x (..< (. rect x) (. rect right)))
        (do-use canvas
          (= (. canvas background) (call spectrum-color x y rect))
          (call (. canvas fill) (call Rect x y 1 1))
        )
      )
    )
  )
  (fn-expr _ spectrum-color HSVA
    (param x Coord)
    (param y Coord)
    (param rect Rect)
    (call HSVA hue saturation value)
    (where
      (lazy hue (/ (as (- x (. rect x)) Float) (as (- width 1) Float)))
      (lazy saturation (+ 0.72 (* y-ratio 0.24)))
      (lazy value (- 0.82 (* y-ratio 0.24)))
      (lazy y-ratio (/ (as (- y (. rect y)) Float) (as (- height 1) Float)))
      (lazy width (if-expr (> (. rect width) 1) (. rect width) 2))
      (lazy height (if-expr (> (. rect height) 1) (. rect height) 2))
    )
  )
)

(fn-expr _ background-profile-frame-count Int
  (call Int (?? (call env "YUMI_BACKGROUND_PROFILE_FRAMES") "0"))
)
