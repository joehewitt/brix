/tui

<Window win • flex-col
    <ShortcutDemo demo • flex-col flex:1 bg:black

    <Shortcut "Quit"
        key = .escape
        action = => do win.close()

    <StatusBar
        message = demo.#status-message

win.open()

━━━━━━━━━━━━━━━━━━━━
+ ShortcutDemo is Box

• This
    focus-mode = FocusMode.keys

+ show-extra = false
+ status-message = "Ready"

────────────────────

<This • flex-col flex:1 bg:black
    <Shortcut "Toggle branch"
        key = .space
        action = => do toggle-extra()

    if #show-extra
        <Shortcut "Expanded action"
            key = 'e'
            action = => do use-extra()

    <Box • flex-col flex:1 p:1 bg:black
        <Label " Shortcut scope demo" • bg:navy
            color = white

        <Label
            text = demo-mode-text(#show-extra)
            color = lightgray
            background-color = black

        if #show-extra
            <Label " Expanded branch is mounted." • bg:black
                color = green
        else
            <Label " Expanded branch is absent." • bg:black
                color = yellow

        <Label
            text = " Last action: ${#status-message}"
            color = white
            background-color = black

────────────────────
+ do toggle-extra

show-extra = !show-extra
status-message = demo-mode-text(show-extra)

────────────────────
+ do use-extra

status-message = "Expanded action fired"

━━━━━━━━━━━━━━━━━━━━
+ demo-mode-text String
    - is-expanded Bool

if is-expanded then "Mode: expanded" else "Mode: compact"
