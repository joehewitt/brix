━━━━━━━━━━━━━━━━━━━━
+ ProgressBarsDemo is Box
    using ProgressBarsTheme

• This
    focus-mode = FocusMode.keys

_ ticker = Timer(90ms)

────────────────────

<Label " Progress Bars " • bg:blue text:white

<Box • flex-col flex:1 bg:black p:2
    <ProgressBar • default-bar
        label = "Default"
        value = progress-demo-value((##ticker), 100)
        total = 100

    <ProgressBar • warning-bar
        label = "Warning"
        value = progress-demo-value((##ticker), 64)
        total = 64
        fill-character = "#"
        empty-character = "."

    <Box • flex-row h:1
        <ProgressBar • compact-bar flex:1
            label = "Compact"
            value = progress-demo-value((##ticker), 10)
            total = 10
            bar-prefix = ""
            bar-suffix = ""
            show-percent = false
            fill-character = "|"
            empty-character = "."
        <Box • flex:2

    <ProgressBar • framed-bar
        label = "Framed"
        value = 72
        total = 100
        bar-prefix = "<"
        bar-suffix = ">"
        fill-character = "+"
        empty-character = "."

    <ProgressBar • unknown-bar
        label = "Unknown"
        total = null
        fill-character = "*"
        empty-character = "."
        interval = 120ms

<Shortcut "Quit"
    key = .escape
    action = => do root.close()

<Shortcut "Quit"
    key = 'q'
    action = => do root.close()

╌╌╌╌╌╌╌╌╌╌ is Closable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

super.close()
ticker.end-using()

━━━━━━━━━━━━━━━━━━━━
+ progress-demo-value Int
    - elapsed Microseconds
    - total Int

((elapsed / 90ms) as Int) % (total + 1)
