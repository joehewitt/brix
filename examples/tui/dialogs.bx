(import /tui)
(blank)

(main
  (<> Window (id: win) (• flex-col)
    (<> DialogDemo (id: app) (• flex-col) (• flex 1) (• bg navy))
    (blank)
    (<> Shortcut (text: "Quit")
      (= key .escape)
      (= action (=> () :do (call (. win close))))
    )
    (blank)
    (<> StatusBar
      (= message (. app #status-message))
    )
  )
  (blank)
  (call (. win open))
)

(style DemoTheme
  (rule ModalDialog
    (rule dialog-button
      (= background-color red)
      (blank)
      (when-style #is-focused
        (= background-color blue)
      )
    )
  )
)

(type + DialogDemo (is Box)
  (using DemoTheme)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + status-message _ (= "no dialog has been answered yet."))
  (prop + show-alert-dialog _ (= false))
  (prop + show-confirm-dialog _ (= false))
  (content
    (<> Label (text: " Modal Dialogs") (• bg blue) (• text white))
    (blank)
    (<> AlertDialog (id: alert-dialog)
      (= title "Alert")
      (= message "This is a canned alert dialog.")
      (= display (if-expr #show-alert-dialog (. Display visible) (. Display hidden)))
    )
    (blank)
    (<> ConfirmDialog (id: confirm-dialog)
      (= title "Confirm")
      (= message "Do you want to keep exploring dialogs?")
      (= display (if-expr #show-confirm-dialog (. Display visible) (. Display hidden)))
    )
    (blank)
    (<> Shortcut (text: "Alert")
      (= key 'a')
      (= action (=> () :do (call show-alert)))
    )
    (blank)
    (<> Shortcut (text: "Confirm")
      (= key 'c')
      (= action (=> () :do (call show-confirm)))
    )
  )
  (subscribe-for (on alert-event (. alert-dialog accepted))
    (call alert-accepted)
  )
  (subscribe-for (on alert-event (. alert-dialog dismissed))
    (call close-dialog)
  )
  (subscribe-for (on confirm-event (. confirm-dialog accepted))
    (call confirm-accepted)
  )
  (subscribe-for (on confirm-event (. confirm-dialog canceled))
    (call confirm-canceled)
  )
  (subscribe-for (on confirm-event (. confirm-dialog dismissed))
    (call close-dialog)
  )
  (fn-do + close-dialog _
    (= show-alert-dialog false)
    (= show-confirm-dialog false)
  )
  (fn-do + alert-accepted _
    (= status-message "alert accepted.")
    (call close-dialog)
  )
  (fn-do + confirm-accepted _
    (= status-message "confirm accepted.")
    (call close-dialog)
  )
  (fn-do + confirm-canceled _
    (= status-message "confirm canceled.")
    (call close-dialog)
  )
  (fn-do + show-alert _
    (= status-message "alert opened.")
    (= show-confirm-dialog false)
    (= show-alert-dialog true)
  )
  (fn-do + show-confirm _
    (= status-message "confirm opened.")
    (= show-alert-dialog false)
    (= show-confirm-dialog true)
  )
)
