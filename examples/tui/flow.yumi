
/os/env
/os/file
/stream/combine
/tui/box
/tui/colors
/tui/layout
/tui/primitives
/tui/text
/tui/window

. quotes-file = use File("${env("HOME") ?? ""}/Desktop/quotes.txt")
. quotes =
    quotes-file
    |> repeat(5)
    |> List

<Window win • flex-row
    <Box • flex-col flex:1 bg:blue
        for quote in quotes
            <TextBox = quote as String • text:white
    <Box • flex-col flex:1 bg:grey
        for quote in quotes
            <TextBox = quote as String • text:yellow

win.open()
