(import /data/json)
(import /math)
(import /stream/combine)
(blank)
(prop + sprite-width Int (= 24))
(prop + sprite-height Int (= 20))
(prop + cel-size Int (= (* sprite-width sprite-height)))
(prop + chromatic-colors (list String) (= (list "#00000000" "#10182c" "#303050" "#5f5faf" "#875fff" "#af87ff" "#ff5faf" "#ff87af" "#ffaf5f" "#ffd787" "#008787" "#00afaf" "#00d7d7" "#5fffff" "#afffaf" "#ffffff")))
(prop + chromatic-names (list String) (= (list "Transparent" "Midnight" "Slate" "Indigo" "Electric violet" "Lavender" "Hot pink" "Rose" "Tangerine" "Butter" "Deep teal" "Lagoon" "Cyan" "Ice" "Mint" "Paper")))

(type + SpriteFrame
  (prop + pixels (list Int) (= (call blank-pixels)))
  (fn-do + copy SpriteFrame
    (let result (call SpriteFrame))
    (= (. result pixels) (call (of List Int) pixels))
    (return result)
  )
)

(type + SpriteDocument
  (prop + frames (list SpriteFrame))
  (prop + fps Int (= 8))
  (prop + lower-visible Bool (= true))
  (prop + upper-visible Bool (= true))
  (fn-do + copy SpriteDocument
    (let result (call SpriteDocument))
    (= (. result fps) fps)
    (= (. result lower-visible) lower-visible)
    (= (. result upper-visible) upper-visible)
    (for (in frame frames)
      (+= (. result frames) (call (. frame copy)))
    )
    (return result)
  )
  (fn-do + color-at Int
    (param frame Int)
    (param x Int)
    (param y Int)
    (return-if 0 (if (or (< x 0) (< y 0) (>= x sprite-width) (>= y sprite-height))))
    (let pixels (. ([] frames frame) pixels))
    (let index (+ (* y sprite-width) x))
    (let upper ([] pixels (+ cel-size index)))
    (return-if upper (if (and upper-visible (!= upper 0))))
    (return (if-expr lower-visible ([] pixels index) 0))
  )
  (fn-expr + encode String
    (str "{\"format\":\"chromatic\",\"version\":1,\"width\":24,\"height\":20,\"fps\":" fps ",\"visible\":[" lower-visible "," upper-visible "],\"frames\":" (call to-json (call List (*> frames (. each pixels)))) "}\n")
  )
)

(type + SpriteSnapshot (is Tuple)
  (prop + document SpriteDocument)
  (prop + frame Int)
  (prop + layer Int)
)

(fn-do + blank-pixels (list Int)
  (let pixels (call (of List Int)))
  (for (in _ (..< 0 (* cel-size 2)))
    (+= pixels 0)
  )
  (return pixels)
)

(fn-do + decode-sprite SpriteDocument (?! Error)
  (param text String)
  (let parsed (call parse-json text))
  (do
    (inline
      (match parsed
        (case (list (= "format" "chromatic") (= "version" 1) (= "width" 24) (= "height" 20) (= "fps" (: fps Int)) (= "visible" (list (: lower Bool) (: upper Bool))) (= "frames" (: frames (list JSON))))
          (throw (call Error "Projects need 1–32 frames and a frame rate of 1–24 fps.") (if (or (< (. frames length) 1) (> (. frames length) 32) (< fps 1) (> fps 24))))
          (let result (call SpriteDocument))
          (= (. result fps) fps)
          (= (. result lower-visible) lower)
          (= (. result upper-visible) upper)
          (for (in raw frames)
            (do
              (inline
                (match raw
                  (case (: values (list JSON))
                    (throw (call Error "A frame must contain two 24 × 20 layers.") (if (!= (. values length) (* cel-size 2))))
                    (let frame (call SpriteFrame))
                    (for (in index (..< 0 (. values length)))
                      (do
                        (inline
                          (match ([] values index)
                            (case (: color Int)
                              (throw (call Error "A pixel uses a color outside the palette.") (if (or (< color 0) (> color 15))))
                              (= ([] (. frame pixels) index) color)
                            )
                            (default
                              (throw (call Error "Pixel colors must be integers."))
                            )
                          )
                        )
                      )
                    )
                    (+= (. result frames) frame)
                  )
                  (default
                    (throw (call Error "A frame must be an array of pixels."))
                  )
                )
              )
            )
          )
          (return result)
        )
        (default
          (throw (call Error "This is not a supported Chromatic project."))
        )
      )
    )
  )
)

(fn-do + starter-sprite SpriteDocument
  (let document (call SpriteDocument))
  (for (in tick (..< 0 8))
    (let frame (call SpriteFrame))
    (let phase (/ (* (as tick Float) 6.283185307) 8))
    (let bob (as (call round (call sin phase)) Int))
    (for (in y (..< 0 sprite-height))
      (for (in x (..< 0 sprite-width))
        (let dx (- (as x Float) 11.5))
        (let dy (- y 7 bob))
        (let distance (+ (/ (* dx dx) 64) (/ (as (* dy dy) Float) 30)))
        (if (and (< distance 1.35) (< dy 4) (> dy -6))
          (= ([] (. frame pixels) (+ (* y sprite-width) x)) (if-expr (< distance 0.9) 3 2))
        )
        (if (and (< distance 0.95) (<= dy 2))
          (let color (if-expr (< dy -1) (if-expr (< dx -2) 13 12) (if-expr (< dx -2) 5 4)))
          (if (and (>= dy 1) (== (% x 3) 0))
            (= color 6)
          )
          (= ([] (. frame pixels) (+ cel-size (* y sprite-width) x)) color)
        )
        (if (and (>= dy -3) (<= dy -2) (>= dx -5) (<= dx -3))
          (= ([] (. frame pixels) (+ cel-size (* y sprite-width) x)) 15)
        )
      )
    )
    (for (in tendril (..< 0 5))
      (for (in step (..< 0 (+ 5 (% tendril 3))))
        (let x (+ 6 (* tendril 3) (as (call round (* 1.5 (call sin (+ phase (* step 0.6) tendril)))) Int)))
        (let y (+ 10 bob step))
        (= ([] (. frame pixels) (+ cel-size (* y sprite-width) x)) (if-expr (== (% (+ step tick tendril) 4) 0) 13 (if-expr (== (% tendril 2) 0) 5 6)))
      )
    )
    (for (in star (..< 0 7))
      (let x (% (+ (* star 7) 2) sprite-width))
      (let y (% (+ (* star 5) tick) sprite-height))
      (let index (+ (* y sprite-width) x))
      (if (== ([] (. frame pixels) index) 0)
        (= ([] (. frame pixels) index) (if-expr (== (% (+ tick star) 4) 0) 9 3))
      )
    )
    (+= (. document frames) frame)
  )
  (return document)
)

(fn-do + fill-cel Bool
  (param pixels (list Int))
  (param layer Int)
  (param x Int)
  (param y Int)
  (param color Int)
  (let offset (* layer cel-size))
  (let start (+ (* y sprite-width) x))
  (let original ([] pixels (+ offset start)))
  (return-if false (if (== original color)))
  (let pending (list start))
  (= ([] pixels (+ offset start)) color)
  (while (> (. pending length) 0)
    (let point (call (. pending pop)))
    (let px (% point sprite-width))
    (let py (/ point sprite-width))
    (for (in direction (list (tuple -1 0) (tuple 1 0) (tuple 0 -1) (tuple 0 1)))
      (let nx (+ px ([] direction 0)))
      (let ny (+ py ([] direction 1)))
      (if (and (>= nx 0) (< nx sprite-width) (>= ny 0) (< ny sprite-height))
        (let index (+ (* ny sprite-width) nx))
        (if (== ([] pixels (+ offset index)) original)
          (= ([] pixels (+ offset index)) color)
          (+= pending index)
        )
      )
    )
  )
  (return true)
)
