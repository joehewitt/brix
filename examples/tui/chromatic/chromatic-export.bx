(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /os/file)
(import /os/path)
(import ./chromatic-document)

(fn-do + export-sprites _ (?! Error)
  (param document SpriteDocument)
  (param selected Int)
  (param directory Path)
  (call (. directory make-directories))
  (let sheet (call RasterCanvas (as (* sprite-width (. document frames length)) I32) (as sprite-height I32)))
  (do-use sheet
    (call (. sheet erase) null)
    (for (in frame (..< 0 (. document frames length)))
      (call render-frame document frame sheet (* frame sprite-width))
    )
    (call (. sheet write) (str (/ directory "sheet.png")))
  )
  (let still (call RasterCanvas (as sprite-width I32) (as sprite-height I32)))
  (do-use still
    (call (. still erase) null)
    (call render-frame document selected still 0)
    (call (. still write) (str (/ directory "frame.png")))
  )
  (call write-file-atomically (/ directory "project.chromatic.json") (call (. document encode)))
  (let manifest (str "{\"image\":\"sheet.png\",\"frameWidth\":24,\"frameHeight\":20,\"frames\":"
    (. document frames length) ",\"fps\":" (. document fps) ",\"layout\":\"horizontal\",\"loop\":true}\n"))
  (call write-file-atomically (/ directory "sheet.json") manifest)
)

(fn-do _ render-frame _
  (param document SpriteDocument)
  (param frame Int)
  (param canvas RasterCanvas)
  (param offset Int)
  (for (in y (..< 0 sprite-height))
    (for (in x (..< 0 sprite-width))
      (let color (call (. document color-at) frame x y))
      (if (!= color 0)
        (= (. canvas fill-color) (call RGBA ([] chromatic-colors color)))
        (call (. canvas rect) (call Rect (as (+ offset x) Float) (as y Float) 1 1))
      )
    )
  )
)
