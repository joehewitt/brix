(import /graphics/color)
(import /math)
(import /stream/combine)
(import /tui)
(import ./chromatic-document)
(blank)
(prop + studio-night _ (= (call RGBA "#090d18")))
(prop + studio-panel _ (= (call RGBA "#111827")))
(prop + studio-raised _ (= (call RGBA "#1c273b")))
(prop + studio-selected _ (= (call RGBA "#283858")))
(prop + studio-ink _ (= (call AnsiColor 255)))
(prop + studio-muted _ (= (call AnsiColor 103)))
(prop + studio-line _ (= (call AnsiColor 60)))
(prop + studio-cyan _ (= (call AnsiColor 87)))
(prop + studio-pink _ (= (call AnsiColor 211)))
(prop + studio-violet _ (= (call AnsiColor 141)))
(prop + studio-gold _ (= (call AnsiColor 222)))
(prop + sprite-rgb (list RGBA) (= (call List (*> chromatic-colors (call RGBA each)))))
(prop + sprite-ansi (list Int) (= (list 0 234 60 61 99 141 205 211 215 222 30 37 44 87 157 231)))

(style ChromaticTheme
  (using TUIShorthandsTheme)
  (using BoxPaint)
  (using TextPaint)
  (using BoxBorder)
  (using BoxSpacing)
  (rule GroupPanel
    (rule group-panel-frame (• border studio-line) (• border-rounded) (• bg studio-panel))
    (rule group-panel-body (• flex-col) (• px 1) (• py 0))
    (rule group-panel-header
      (= display (. Display hidden))
    )
  )
  (rule ModalDialog
    (rule dialog-panel (• bg studio-panel) (• border studio-line) (• border-rounded) (• px 1))
    (rule dialog-title (• bg studio-panel) (• text studio-cyan) (• h 2))
    (rule dialog-body (• bg studio-panel) (• p 0))
    (rule dialog-actions (• bg studio-panel) (• h 1))
  )
  (rule DialogButton (• bg studio-raised) (• text studio-ink) (• px 1)
    (when-style #is-focused
      (• bg studio-selected)
      (• text studio-cyan)
    )
    (when-style #is-hovered
      (• bg studio-selected)
      (• text studio-cyan)
    )
  )
  (rule help-dialog
    (rule dialog-panel (• w 76) (• h 24))
  )
  (rule pending-dialog
    (rule dialog-panel (• w 62) (• h 9))
  )
  (rule action (• bg studio-raised) (• text studio-ink) (• px 1)
    (= focus-mode (. FocusMode none))
    (when-style #is-hovered
      (• bg studio-selected)
      (• text studio-cyan)
    )
  )
)

(type + PixelCanvas (is Box)
  (prop + document SpriteDocument)
  (prop + frame Int)
  (prop + revision Int)
  (prop + onion Bool)
  (prop + grid Bool)
  (prop + cursor-x Int (= 12))
  (prop + cursor-y Int (= 10))
  (content
    (<> This
      (= background (call PixelCanvasPainter #document #frame #revision #onion #grid #cursor-x #cursor-y))
    )
  )
  (fn-expr + pixel-at (? Point)
    (param point Point)
    (only-if (call cell-point (/ (- (. point x) left) (* scale 2)) (/ (- (. point y) top) scale)) (if (and (>= (. point x) left) (< (. point x) (+ left (* sprite-width scale 2))) (>= (. point y) top) (< (. point y) (+ top (* sprite-height scale))))))
    (where
      (lazy scale (call canvas-scale bounds))
      (lazy left (+ (. bounds x) (/ (- (. bounds width) (* sprite-width scale 2)) 2)))
      (lazy top (+ (. bounds y) (/ (- (. bounds height) (* sprite-height scale)) 2)))
    )
  )
)

(fn-expr + canvas-scale Int
  (param rect Rect)
  (call max 1 (call min (/ (. rect width) (* sprite-width 2)) (/ (. rect height) sprite-height)))
)

(type + PixelCanvasPainter (is Painter)
  (prop + document SpriteDocument)
  (prop + frame Int)
  (prop + revision Int)
  (prop + onion Bool)
  (prop + grid Bool)
  (prop + cursor-x Int)
  (prop + cursor-y Int)
  (fn-do + This _
    (param document _)
    (param frame _)
    (param revision _)
    (param onion _)
    (param grid _)
    (param cursor-x _)
    (param cursor-y _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (call (. canvas clip) rect)
      (call (. canvas paint-background) studio-panel rect)
      (let scale (call canvas-scale rect))
      (let left (+ (. rect x) (/ (- (. rect width) (* sprite-width scale 2)) 2)))
      (let top (+ (. rect y) (/ (- (. rect height) (* sprite-height scale)) 2)))
      (let count (. document frames length))
      (for (in y (..< 0 sprite-height))
        (for (in x (..< 0 sprite-width))
          (let index (call (. document color-at) frame x y))
          (let color (if-expr (== (% (+ x y) 2) 0) (call RGBA "#1b2536") (call RGBA "#202c40")))
          (if (!= index 0)
            (= color ([] sprite-rgb index))
            (else-if (and onion (> count 1))
              (let previous (call (. document color-at) (% (+ frame count -1) count) x y))
              (let next (call (. document color-at) (% (+ frame 1) count) x y))
              (if (!= previous 0)
                (= color (call RGBA "#58324f"))
              )
              (if (!= next 0)
                (= color (if-expr (!= previous 0) (call RGBA "#454568") (call RGBA "#234c59")))
              )
            )
          )
          (let px (+ left (* x scale 2)))
          (let py (+ top (* y scale)))
          (call (. canvas paint-background) color (call cell-rect px py (* scale 2) scale))
          (if grid
            (= (. canvas text-color) (call AnsiColor 60))
            (call (. canvas move) (call cell-point px py))
            (call (. canvas print) "·")
          )
        )
      )
      (= (. canvas text-color) studio-ink)
      (call (. canvas move) (call cell-point (+ left (* cursor-x scale 2)) (+ top (* cursor-y scale))))
      (call (. canvas print) "▏")
      (call (. canvas move) (call cell-point (+ left (* (+ cursor-x 1) scale 2) -1) (+ top (* cursor-y scale))))
      (call (. canvas print) "▕")
    )
  )
)

(type + SpritePreview (is Box)
  (prop + document SpriteDocument)
  (prop + frame Int)
  (prop + revision Int)
  (content
    (<> This
      (= background (call SpritePreviewPainter #document #frame #revision))
    )
  )
)

(type + SpritePreviewPainter (is Painter)
  (prop + document SpriteDocument)
  (prop + frame Int)
  (prop + revision Int)
  (fn-do + This _
    (param document _)
    (param frame _)
    (param revision _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (do-use canvas
      (call (. canvas clip) rect)
      (call (. canvas paint-background) studio-panel rect)
      (let stride (call max 1 (call max (/ (+ sprite-width (. rect width) -1) (call max 1 (. rect width))) (/ (+ sprite-height (* (. rect height) 2) -1) (call max 1 (* (. rect height) 2))))))
      (let width (/ (+ sprite-width stride -1) stride))
      (let height (/ (+ sprite-height (* stride 2) -1) (* stride 2)))
      (let left (+ (. rect x) (/ (- (. rect width) width) 2)))
      (let top (+ (. rect y) (/ (- (. rect height) height) 2)))
      (for (in y (..< 0 height))
        (for (in x (..< 0 width))
          (let upper (call (. document color-at) frame (* x stride) (* y stride 2)))
          (let lower (call (. document color-at) frame (* x stride) (+ (* y stride 2) stride)))
          (= (. canvas text-color) (call AnsiColor ([] sprite-ansi (if-expr (== upper 0) 1 upper))))
          (= (. canvas background) ([] sprite-rgb (if-expr (== lower 0) 1 lower)))
          (call (. canvas move) (call cell-point (+ left x) (+ top y)))
          (call (. canvas print) "▀")
        )
      )
    )
  )
)

(fn-expr + cell-point Point
  (param x Int)
  (param y Int)
  (call Point (as x Coord) (as y Coord))
)

(fn-expr + cell-rect Rect
  (param x Int)
  (param y Int)
  (param width Int)
  (param height Int)
  (call Rect (as x Coord) (as y Coord) (as width Coord) (as height Coord))
)
