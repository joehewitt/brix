(import /math)
(import /os/cli)
(import /os/file)
(import /os/path)
(import /stream/combine)
(import /time)
(import /time/timer)
(import /tui)
(import /ui/command-history)
(import ./chromatic-document)
(import ./chromatic-paint)
(import ./chromatic-export)

(main
  (lazy arguments (call cmdline-args))
  (<> Window (id: win) (• flex-col) (• bg studio-night)
    (<> ChromaticStudio (id: studio) (• flex 1)
      (= output (call Path (if-expr (> (. arguments length) 1) ([] arguments 1) "chromatic-output")))
    )
  )
  (= (. studio viewport) (. win terminal view-size))
  (for (on size (. win terminal resized))
    (= (. studio viewport) size)
  )
  (call (. studio start))
  (call (. win open))
)

(type + ChromaticStudio (is Box)
  (using ChromaticTheme)
  (prop + viewport PSize)
  (prop + output Path)
  (prop _ document _ (= (call starter-sprite)))
  (prop _ revision Int)
  (prop _ history _ (= (call CommandHistory)))
  (prop _ selected Int)
  (prop _ layer Int (= 1))
  (prop _ ink Int (= 13))
  (prop _ tool Int)
  (prop _ onion Bool (= true))
  (prop _ grid Bool)
  (prop _ mirror Bool)
  (prop _ playing Bool (= true))
  (prop _ playhead Int)
  (prop _ play-time Float)
  (prop _ running Bool)
  (prop _ frame-pending Bool)
  (prop _ frame-time U64)
  (prop _ cursor-x Int (= 12))
  (prop _ cursor-y Int (= 10))
  (prop _ drawing Bool)
  (prop _ stroke-saved Bool)
  (prop _ stroke-color Int)
  (prop _ last-x Int)
  (prop _ last-y Int)
  (prop _ frame-count Int (= 8))
  (prop _ pending String)
  (prop _ help Bool)
  (prop _ notice String (= "LUMEN / a tiny bioluminescent loop. Paint something into its world."))
  (prop _ roomy Bool (= (>= (. #viewport height) 44)))
  (prop _ fits Bool (= (and (>= (. #viewport width) 96) (>= (. #viewport height) 40))))
  (prop _ visible-frames Int (= (call max 1 (/ (- (as (. #viewport width) Int) 6) 12))))
  (prop _ page-start Int (= (* (/ #selected #visible-frames) #visible-frames)))
  (rule This (= focus-mode (. FocusMode keys)))
  (content
    (<> This (• flex-col) (• px 1) (• bg studio-night) (• text studio-ink)
      (<> Box (• flex-row) (• h 1) (• pt 1)
        (<> Label (text: " ▧ ") (• text studio-cyan))
        (for (in index (..< 0 9))
          (<> Label (• text (call AnsiColor ([] sprite-ansi (+ 4 (% index 4)))))
            (= text (str (as ([] "CHROMATIC" index) String) " "))
          )
        )
        (<> Label (text: " / PIXEL MOTION STUDIO") (• flex 1) (• text studio-muted))
        (<> Label (• text studio-gold)
          (= text (if-expr (. history #is-modified) "● unsaved  " "○ clean  "))
        )
        (<> Label (text: "24 × 20  /  16 colors ") (• text studio-violet))
      )
      (if (not #fits)
        (<> GroupPanel (• flex 1) (• mt 1)
          (<> Box (• flex 1) (• flex-col)
            (<> Label (text: "Give your pixels a little room") (• text studio-cyan))
            (<> Label (text: "Chromatic needs 96 columns × 40 rows."))
            (<> Label (text: "132 × 44 is a comfortable studio. Q quits.") (• text studio-muted))
          )
        )
      )
      (<> Box (• flex-col) (• flex 1)
        (= display (if-expr #fits (. Display visible) (. Display hidden)))
        (<> Box (• flex-row) (• h 1) (• mt 1)
          (for (in index (..< 0 4))
            (<> Button (• action) (• mr 1)
              (= text ([] (list "B Pencil" "E Eraser" "F Fill" "I Pick") index))
              (= background-color (if-expr (== #tool index) studio-selected studio-raised))
              (= color (if-expr (== #tool index) studio-cyan studio-muted))
              (for (on _ click) (call choose-tool index))
            )
          )
          (<> Box (• flex 1))
          (<> Button (text: "Z Undo") (• action) (• mr 1) (for (on _ click) (call undo)))
          (<> Button (text: "Y Redo") (• action) (• mr 1) (for (on _ click) (call redo)))
          (<> Button (text: "S Save") (• action) (• mr 1) (for (on _ click) (call save)))
          (<> Button (text: "X Export") (• action) (for (on _ click) (call export)))
        )
        (<> Box (• flex-row) (• flex 1) (• mt 1)
          (<> GroupPanel (• flex 1)
            (<> Box (• flex 1) (• flex-col)
              (<> Box (• flex-row) (• h 1)
                (<> Label (• text studio-cyan) (• flex 1)
                  (= text (str "01  CANVAS  /  " (if-expr (== #layer 1) "INK" "GLOW") "  /  FRAME " (+ #selected 1)))
                )
                (<> Label (• text studio-muted) (= text (str #cursor-x "," #cursor-y)))
              )
              (<> PixelCanvas (id: drawing-canvas) (• flex 1)
                (= document #document)
                (= frame #selected)
                (= revision #revision)
                (= onion #onion)
                (= grid #grid)
                (= cursor-x #cursor-x)
                (= cursor-y #cursor-y)
                (for (on event mouse-down)
                  (call begin-stroke (. event point) (== (. event button) (. PointerButton secondary)))
                )
                (for (on event mouse-drag)
                  (call drag-stroke (. event point))
                  (call (. event cancel))
                )
                (for (on event mouse-up)
                  (call drag-stroke (. event point))
                  (= drawing false)
                  (call (. event cancel))
                )
                (for (on event mouse-move)
                  (call hover-pixel (. event point))
                )
              )
            )
          )
          (<> Box (• flex-col) (• w 30) (• ml 1)
            (<> GroupPanel (• h (if-expr #roomy 13 9))
              (<> Box (• flex 1) (• flex-col)
                (<> Box (• flex-row) (• h 1)
                  (<> Label (text: "02  LIVE PREVIEW") (• text studio-violet) (• flex 1))
                  (<> Button (• action)
                    (= text (if-expr #playing "Ⅱ" "▶"))
                    (for (on _ click) (call toggle-play))
                  )
                )
                (<> SpritePreview (• flex 1)
                  (= document #document) (= frame #playhead) (= revision #revision)
                )
              )
            )
            (<> GroupPanel (• h 6) (• mt 1)
              (<> Box (• flex 1) (• flex-col)
                (<> Label (text: "03  PALETTE") (• h 1) (• text studio-pink))
                (for (in row (..< 0 2))
                  (<> Box (• flex-row) (• h 1)
                    (for (in column (..< 0 8))
                      (let index (+ (* row 8) column))
                      (<> Button (• w 3) (• h 1)
                        (= focus-mode (. FocusMode none))
                        (= background-color ([] sprite-rgb index))
                        (= color (if-expr (< index 6) studio-ink (call AnsiColor 16)))
                        (= text (if-expr (== #ink index) " ◆ " (if-expr (== index 0) " ▧ " "   ")))
                        (for (on _ click) (= ink index) (call focus-studio))
                      )
                    )
                  )
                )
                (<> Label (• text studio-muted)
                  (= text (str ([] chromatic-names #ink) "  " ([] chromatic-colors #ink)))
                )
              )
            )
            (<> GroupPanel (• flex 1) (• mt 1)
              (<> Box (• flex 1) (• flex-col)
                (<> Label (text: "04  LAYERS") (• h 1) (• text studio-violet))
                (for (in which (list 1 0))
                  (<> Box (• flex-row) (• h 1)
                    (<> Button (• action) (• flex 1)
                      (= text (str (if-expr (== #layer which) "▸ " "  ") (if-expr (== which 1) "1  Ink" "2  Glow")))
                      (= color (if-expr (== #layer which) studio-cyan studio-muted))
                      (for (on _ click) (= layer which) (call focus-studio))
                    )
                    (<> Button (• action)
                      (= text (if-expr (if-expr (== which 1) (. #document upper-visible) (. #document lower-visible)) "●" "○"))
                      (for (on _ click) (call toggle-layer which))
                    )
                  )
                )
                (<> Box (• flex-row) (• h 1)
                  (<> Button (text: "−") (• action) (for (on _ click) (call change-rate -1)))
                  (<> Label (• flex 1) (• text studio-muted) (= text (str "  " (. #document fps) " fps / loop")))
                  (<> Button (text: "+") (• action) (for (on _ click) (call change-rate 1)))
                )
                (if #roomy
                  (<> Box (• flex 1))
                )
              )
            )
          )
        )
        (<> GroupPanel (• h 8) (• mt 1)
          (<> Box (• flex 1) (• flex-col)
            (<> Box (• flex-row) (• h 1)
              (<> Label (text: "05  TIMELINE") (• text studio-cyan) (• flex 1))
              (<> Button (• action) (• mr 1)
                (= text (if-expr #onion "O Onion ●" "O Onion ○"))
                (for (on _ click) (= onion (not onion)))
              )
              (<> Button (• action) (• mr 1)
                (= text (if-expr #grid "G Grid ●" "G Grid ○"))
                (for (on _ click) (= grid (not grid)))
              )
              (<> Button (• action) (• mr 1)
                (= text (if-expr #mirror "M Mirror ●" "M Mirror ○"))
                (for (on _ click) (= mirror (not mirror)))
              )
              (<> Button (text: "N New") (• action) (• mr 1) (for (on _ click) (call add-frame false)))
              (<> Button (text: "D Duplicate") (• action) (for (on _ click) (call add-frame true)))
            )
            (<> Box (• flex-row) (• flex 1)
              (for (in index (..< #page-start (call min #frame-count (+ #page-start #visible-frames))))
                (<> Box (• flex-col) (• w 12)
                  (= background-color (if-expr (== #selected index) studio-selected studio-panel))
                  (for (on _ click) (call select-frame index))
                  (<> SpritePreview (• flex 1)
                    (= document #document) (= frame index) (= revision #revision)
                  )
                  (<> Label (• h 1)
                    (= text (str (if-expr (== #selected index) " ▰ " "   ") (+ index 1) (if-expr (and #playing (== #playhead index)) "  ●" "")))
                    (= color (if-expr (== #selected index) studio-cyan studio-muted))
                  )
                )
              )
            )
          )
        )
      )
      (<> Label (• h 1) (• mt 1) (• text studio-muted) (= text (str " " #notice)))
      (<> StatusBar (• h 1) (• bg studio-night) (• text studio-cyan)
        (= message "Drag paint · right-drag erase")
      )
      (if #help
        (<> ModalDialog (• help-dialog)
          (= title "CHROMATIC / THE SHORT TOUR")
          (for (on _ dismissed) (call close-overlay))
          (<> Box (slot: body)
            (<> Label (text: "Paint on the large canvas. The preview plays independently."))
            (<> Label (text: "Pink onion pixels are the previous frame; teal is the next.") (• text studio-muted))
            (<> Label (text: ""))
            (<> Label (text: "B / E / F / I     Pencil, eraser, flood fill, eyedropper"))
            (<> Label (text: "Drag / right-drag Paint / erase, one undo step per stroke"))
            (<> Label (text: "Arrows + Enter   Move the pixel cursor and apply the tool"))
            (<> Label (text: ", / .            Previous / next palette color"))
            (<> Label (text: "O / G / M        Onion skins / pixel grid / mirrored brush"))
            (<> Label (text: "1 / 2 / L        Select Ink / Glow / toggle selected layer"))
            (<> Label (text: "[ / ]            Previous / next animation frame"))
            (<> Label (text: "N / D / Delete   Insert blank / duplicate / delete frame"))
            (<> Label (text: "C                Clear the selected layer (undoable)"))
            (<> Label (text: "Space / − / +    Play or pause preview / adjust frame rate"))
            (<> Label (text: "Z / Y            Undo / redo (64 steps)"))
            (<> Label (text: "S / R            Save project / reload project"))
            (<> Label (text: "X                Export sheet.png, frame.png, sheet.json"))
            (<> Label (text: ""))
            (<> Label (• text studio-gold) (= text (str "Files: " output)))
            (<> Label (text: "Projects retain both layers. PNGs use the visible layers.") (• text studio-muted))
            (<> Label (text: ""))
          )
          (<> Box (slot: actions)
            (<> DialogButton (text: " Close / Escape ") (for (on _ click) (call close-overlay)))
          )
          (<> Shortcut (text: "Close help") (= show-in-status false) (= key (char "?")) (= action (=> () :do (call close-overlay))))
        )
      )
      (if (!= #pending "")
        (<> ModalDialog (• pending-dialog)
          (= title "KEEP YOUR PIXELS?")
          (for (on _ canceled) (call close-overlay))
          (for (on _ accepted) (call resolve-pending true))
          (<> Box (slot: body)
            (<> Label (text: "This project has unsaved changes."))
            (<> Label (• text studio-muted) (= text (str "Save to " output)))
            (<> Label (text: ""))
          )
          (<> Box (slot: actions) (• flex-row) (• h 1)
              (<> DialogButton (text: "S Save & continue") (• mr 1) (for (on _ click) (call resolve-pending true)))
              (<> DialogButton (text: "D Discard") (• mr 1) (for (on _ click) (call resolve-pending false)))
              (<> DialogButton (text: "Esc Cancel") (for (on _ click) (call close-overlay)))
          )
          (<> Shortcut (text: "Save changes") (= show-in-status false) (= key (char "s")) (= action (=> () :do (call resolve-pending true))))
          (<> Shortcut (text: "Discard changes") (= show-in-status false) (= key (char "d")) (= action (=> () :do (call resolve-pending false))))
        )
      )
      (<> Shortcut (text: "Quit") (= show-in-status true)
        (= key (char "q"))
        (= action (=> () :do (call request-action "quit")))
      )
      (<> Shortcut (text: "Help") (= show-in-status true)
        (= key (char "?"))
        (= action (=> () :do (= help true)))
      )
      (<> Shortcut (text: "Pause preview") (= show-in-status true)
        (= key .space)
        (= action (=> () :do (call toggle-play)))
      )
      (<> Shortcut (text: "Pencil") (= show-in-status false)
        (= key (char "b"))
        (= action (=> () :do (call choose-tool 0)))
      )
      (<> Shortcut (text: "Eraser") (= show-in-status false)
        (= key (char "e"))
        (= action (=> () :do (call choose-tool 1)))
      )
      (<> Shortcut (text: "Fill") (= show-in-status false)
        (= key (char "f"))
        (= action (=> () :do (call choose-tool 2)))
      )
      (<> Shortcut (text: "Pick") (= show-in-status false)
        (= key (char "i"))
        (= action (=> () :do (call choose-tool 3)))
      )
      (<> Shortcut (text: "Onion") (= show-in-status false)
        (= key (char "o"))
        (= action (=> () :do (= onion (not onion))))
      )
      (<> Shortcut (text: "Grid") (= show-in-status false)
        (= key (char "g"))
        (= action (=> () :do (= grid (not grid))))
      )
      (<> Shortcut (text: "Mirror") (= show-in-status false)
        (= key (char "m"))
        (= action (=> () :do (= mirror (not mirror))))
      )
      (<> Shortcut (text: "Ink layer") (= show-in-status false)
        (= key (char "1"))
        (= action (=> () :do (= layer 1)))
      )
      (<> Shortcut (text: "Glow layer") (= show-in-status false)
        (= key (char "2"))
        (= action (=> () :do (= layer 0)))
      )
      (<> Shortcut (text: "Visibility") (= show-in-status false)
        (= key (char "l"))
        (= action (=> () :do (call toggle-layer layer)))
      )
      (<> Shortcut (text: "Previous frame") (= show-in-status false)
        (= key (char "["))
        (= action (=> () :do (call select-frame (% (+ selected frame-count -1) frame-count))))
      )
      (<> Shortcut (text: "Next frame") (= show-in-status false)
        (= key (char "]"))
        (= action (=> () :do (call select-frame (% (+ selected 1) frame-count))))
      )
      (<> Shortcut (text: "New frame") (= show-in-status false)
        (= key (char "n"))
        (= action (=> () :do (call add-frame false)))
      )
      (<> Shortcut (text: "Duplicate") (= show-in-status false)
        (= key (char "d"))
        (= action (=> () :do (call add-frame true)))
      )
      (<> Shortcut (text: "Delete frame") (= show-in-status false)
        (= key .delete)
        (= action (=> () :do (call delete-frame)))
      )
      (<> Shortcut (text: "Clear layer") (= show-in-status false)
        (= key (char "c"))
        (= action (=> () :do (call clear-layer)))
      )
      (<> Shortcut (text: "Undo") (= show-in-status false)
        (= key (char "z"))
        (= action (=> () :do (call undo)))
      )
      (<> Shortcut (text: "Redo") (= show-in-status false)
        (= key (char "y"))
        (= action (=> () :do (call redo)))
      )
      (<> Shortcut (text: "Save") (= show-in-status false)
        (= key (char "s"))
        (= action (=> () :do (call save)))
      )
      (<> Shortcut (text: "Reload") (= show-in-status false)
        (= key (char "r"))
        (= action (=> () :do (call request-action "load")))
      )
      (<> Shortcut (text: "Export") (= show-in-status false)
        (= key (char "x"))
        (= action (=> () :do (call export)))
      )
      (<> Shortcut (text: "Slower") (= show-in-status false)
        (= key (char "-"))
        (= action (=> () :do (call change-rate -1)))
      )
      (<> Shortcut (text: "Faster") (= show-in-status false)
        (= key (char "+"))
        (= action (=> () :do (call change-rate 1)))
      )
      (<> Shortcut (text: "Previous color") (= show-in-status false)
        (= key (char ","))
        (= action (=> () :do (= ink (% (+ ink 15) 16))))
      )
      (<> Shortcut (text: "Next color") (= show-in-status false)
        (= key (char "."))
        (= action (=> () :do (= ink (% (+ ink 1) 16))))
      )
      (<> Shortcut (text: "Left") (= show-in-status false)
        (= key .arrow-left)
        (= action (=> () :do (call move-cursor -1 0)))
      )
      (<> Shortcut (text: "Right") (= show-in-status false)
        (= key .arrow-right)
        (= action (=> () :do (call move-cursor 1 0)))
      )
      (<> Shortcut (text: "Up") (= show-in-status false)
        (= key .arrow-up)
        (= action (=> () :do (call move-cursor 0 -1)))
      )
      (<> Shortcut (text: "Down") (= show-in-status false)
        (= key .arrow-down)
        (= action (=> () :do (call move-cursor 0 1)))
      )
      (<> Shortcut (text: "Paint") (= show-in-status false)
        (= key .enter)
        (= action (=> () :do (call keyboard-paint)))
      )
    )
  )
  (fn-do + start _
    (= (. history limit) 64)
    (if (. (/ output "project.chromatic.json") exists)
      (call load-project)
    )
    (= running true)
  )
  (whenever-rule (and #running #playing (== #pending "") (not #help))
    (= frame-time (call monotonic-time-nanoseconds))
    (call request-preview)
  )
  (fn-do _ request-preview _
    (return-if (if (or (not running) (not playing) (!= pending "") help frame-pending)))
    (= frame-pending true)
    (call request-animation-frame advance-preview)
  )
  (fn-do _ advance-preview _
    (= frame-pending false)
    (return-if (if (or (not running) (not playing) (!= pending "") help)))
    (let now (call monotonic-time-nanoseconds))
    (+= play-time (/ (as (- now frame-time) Float) 1000000000))
    (= frame-time now)
    (let steps (as (* play-time (. document fps)) Int))
    (if (> steps 0)
      (= playhead (% (+ playhead steps) frame-count))
      (-= play-time (/ (as steps Float) (. document fps)))
    )
    (call request-preview)
  )
  (fn-do + close _
    (= running false)
    (call (. super close))
  )
  (fn-do _ focus-studio _
    (call (. (as root Window) focus) this)
  )
  (fn-do _ choose-tool _
    (param next Int)
    (= drawing false)
    (= tool next)
    (= notice ([] (list "Pencil · drag to paint. M mirrors the stroke." "Eraser · reveal the layer underneath." "Fill · replace a connected area on the selected layer." "Eyedropper · click any visible pixel to pick its color.") tool))
    (call focus-studio)
  )
  (fn-do _ hover-pixel _
    (param point Point)
    (let pixel (call (. drawing-canvas pixel-at) point))
    (if pixel
      (= cursor-x (. pixel x))
      (= cursor-y (. pixel y))
    )
  )
  (fn-do _ begin-stroke _
    (param point Point)
    (param erase Bool)
    (call focus-studio)
    (= drawing false)
    (= stroke-saved false)
    (let pixel (call (. drawing-canvas pixel-at) point))
    (return-if (if (not pixel)))
    (= cursor-x (. pixel x))
    (= cursor-y (. pixel y))
    (if (and (== tool 3) (not erase))
      (= ink (call (. document color-at) selected cursor-x cursor-y))
      (call choose-tool 0)
      (return)
    )
    (return-if (if (not (call editable-layer))))
    (= stroke-color (if-expr (or erase (== tool 1)) 0 ink))
    (if (and (== tool 2) (not erase))
      (let index (+ (* layer cel-size) (* cursor-y sprite-width) cursor-x))
      (if (!= ([] (. ([] (. document frames) selected) pixels) index) stroke-color)
        (call checkpoint)
        (call fill-cel (. ([] (. document frames) selected) pixels) layer cursor-x cursor-y stroke-color)
        (+= revision 1)
        (= notice "Filled a connected area. Z undoes it.")
      )
      (return)
    )
    (= drawing true)
    (= last-x cursor-x)
    (= last-y cursor-y)
    (call stroke-to cursor-x cursor-y)
  )
  (fn-do _ drag-stroke _
    (param point Point)
    (return-if (if (not drawing)))
    (let pixel (call (. drawing-canvas pixel-at) point))
    (if pixel
      (= cursor-x (. pixel x))
      (= cursor-y (. pixel y))
      (call stroke-to cursor-x cursor-y)
    )
  )
  (fn-do _ stroke-to _
    (param x Int) (param y Int)
    (let steps (call max (call abs (- x last-x)) (call abs (- y last-y))))
    (for (in step (.. 0 steps))
      (let amount (/ (as step Float) (call max 1 steps)))
      (let px (as (call round (+ last-x (* (- x last-x) amount))) Int))
      (let py (as (call round (+ last-y (* (- y last-y) amount))) Int))
      (call put-pixel px py)
      (if mirror (call put-pixel (- sprite-width 1 px) py))
    )
    (= last-x x)
    (= last-y y)
  )
  (fn-do _ put-pixel _
    (param x Int) (param y Int)
    (let index (+ (* layer cel-size) (* y sprite-width) x))
    (return-if (if (== ([] (. ([] (. document frames) selected) pixels) index) stroke-color)))
    (if (not stroke-saved)
      (call checkpoint)
      (= stroke-saved true)
    )
    (= ([] (. ([] (. document frames) selected) pixels) index) stroke-color)
    (+= revision 1)
  )
  (fn-do _ editable-layer Bool
    (let visible (if-expr (== layer 1) (. document upper-visible) (. document lower-visible)))
    (if (not visible)
      (= notice "That layer is hidden. Press L to show it before painting.")
    )
    (return visible)
  )
  (fn-do _ move-cursor _
    (param x Int) (param y Int)
    (= cursor-x (call max 0 (call min (- sprite-width 1) (+ cursor-x x))))
    (= cursor-y (call max 0 (call min (- sprite-height 1) (+ cursor-y y))))
  )
  (fn-do _ keyboard-paint _
    (let bounds (. drawing-canvas bounds))
    (let scale (call canvas-scale bounds))
    (let x (+ (. bounds x) (/ (- (. bounds width) (* sprite-width scale 2)) 2) (* cursor-x scale 2)))
    (let y (+ (. bounds y) (/ (- (. bounds height) (* sprite-height scale)) 2) (* cursor-y scale)))
    (call begin-stroke (call cell-point x y) false)
    (= drawing false)
  )
  (fn-do _ checkpoint _
    (let before (call snapshot))
    (= document (call (. document copy)))
    (call (. history record) "edit" (call SpriteEdit this before))
  )
  (fn-expr + snapshot SpriteSnapshot
    (call SpriteSnapshot document selected layer)
  )
  (fn-do _ undo _
    (= drawing false)
    (return-if (if (not (. history can-undo))))
    (call (. history undo))
    (= notice "Undid the last edit. Y redoes it.")
  )
  (fn-do _ redo _
    (= drawing false)
    (return-if (if (not (. history can-redo))))
    (call (. history redo))
    (= notice "Redid the edit.")
  )
  (fn-do + restore _
    (param snapshot SpriteSnapshot)
    (= document (. snapshot document))
    (= selected (. snapshot frame))
    (= layer (. snapshot layer))
    (= frame-count (. document frames length))
    (= playhead selected)
    (= play-time 0)
    (+= revision 1)
  )
  (fn-do _ select-frame _
    (param index Int)
    (= drawing false)
    (= selected index)
    (if (not playing) (= playhead selected))
    (call focus-studio)
  )
  (fn-do _ add-frame _
    (param duplicate Bool)
    (= drawing false)
    (if (>= frame-count 32)
      (= notice "This studio holds up to 32 frames. Delete a frame to make room.")
      (return)
    )
    (call checkpoint)
    (let next (if-expr duplicate (call (. ([] (. document frames) selected) copy)) (call SpriteFrame)))
    (call (. document frames insert) next (+ selected 1))
    (+= selected 1)
    (= frame-count (. document frames length))
    (= playhead selected)
    (+= revision 1)
    (= notice (if-expr duplicate "Duplicated both layers into a new frame." "Blank frame inserted. Start drawing, or use onion skins to trace."))
  )
  (fn-do _ delete-frame _
    (= drawing false)
    (if (== frame-count 1)
      (= notice "Keep at least one frame. C clears the selected layer.")
      (return)
    )
    (call checkpoint)
    (call (. document frames remove) selected)
    (= frame-count (. document frames length))
    (= selected (call min selected (- frame-count 1)))
    (= playhead selected)
    (+= revision 1)
    (= notice "Frame deleted. Z brings it back.")
  )
  (fn-do _ clear-layer _
    (= drawing false)
    (return-if (if (not (call editable-layer))))
    (call checkpoint)
    (for (in index (..< (* layer cel-size) (* (+ layer 1) cel-size)))
      (= ([] (. ([] (. document frames) selected) pixels) index) 0)
    )
    (+= revision 1)
    (= notice "Layer cleared in this frame. Z brings the pixels back.")
  )
  (fn-do _ toggle-layer _
    (param which Int)
    (= drawing false)
    (call checkpoint)
    (if (== which 1)
      (= (. document upper-visible) (not (. document upper-visible)))
      (else (= (. document lower-visible) (not (. document lower-visible))))
    )
    (+= revision 1)
  )
  (fn-do _ change-rate _
    (param delta Int)
    (= drawing false)
    (let next (call max 1 (call min 24 (+ (. document fps) delta))))
    (return-if (if (== next (. document fps))))
    (call checkpoint)
    (= (. document fps) next)
    (= play-time 0)
    (+= revision 1)
  )
  (fn-do _ toggle-play _
    (= playing (not playing))
    (= playhead selected)
    (= play-time 0)
  )
  (fn-do _ save Bool
    (= drawing false)
    (let directory-result (catch (call (. output make-directories))))
    (if (is directory-result Error)
      (= notice (str "Could not create output directory: " (. directory-result message)))
      (return false)
    )
    (let result (catch (call write-file-atomically (/ output "project.chromatic.json") (call (. document encode)))))
    (if (is result Error)
      (= notice (str "Save failed: " (. result message)))
      (return false)
    )
    (call (. history mark-saved))
    (= notice (str "Saved both layers and all frames to " output "/project.chromatic.json"))
    (return true)
  )
  (fn-do _ export _
    (= drawing false)
    (let result (catch (call export-sprites document selected output)))
    (if (is result Error)
      (= notice (str "Export failed: " (. result message)))
      (return)
    )
    (call (. history mark-saved))
    (= notice (str "Exported PNG sheet + current frame + metadata + project → " output))
  )
  (fn-do _ load-project _
    (let loaded (catch (call decode-sprite (call read-file-text (/ output "project.chromatic.json")))))
    (if (is loaded Error)
      (= notice (str "Load failed: " (. loaded message)))
      (return)
    )
    (= document loaded)
    (= selected 0)
    (= playhead 0)
    (= play-time 0)
    (= frame-count (. document frames length))
    (call (. history clear))
    (+= revision 1)
    (call (. history mark-saved))
    (= notice (str "Opened " output "/project.chromatic.json"))
  )
  (fn-do _ request-action _
    (param action String)
    (= drawing false)
    (if (. history is-modified)
      (= pending action)
      (else (call perform-action action))
    )
  )
  (fn-do _ perform-action _
    (param action String)
    (if (== action "quit")
      (call (. root close))
      (else (call load-project))
    )
  )
  (fn-do _ resolve-pending _
    (param keep Bool)
    (return-if (if (and keep (not (call save)))))
    (let action pending)
    (= pending "")
    (call focus-studio)
    (call perform-action action)
  )
  (fn-do _ close-overlay _
    (= pending "")
    (= help false)
    (call focus-studio)
  )
)

(type + SpriteEdit
  (implements CommandHistoryEntry)
  (prop _ studio ChromaticStudio)
  (prop _ before SpriteSnapshot)
  (prop _ after (? SpriteSnapshot))
  (fn-do + This _
    (param studio _)
    (param before _)
  )
  (implements CommandHistoryEntry)
  (fn-do + undo _
    (= after (call (. studio snapshot)))
    (call (. studio restore) before)
  )
  (fn-do + redo _
    (if after
      (call (. studio restore) after)
    )
  )
)
