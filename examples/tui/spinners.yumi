
/time
/tui

<Window win • flex-col
    <SpinnerDemo app • flex-col flex:1 bg:black

win.open()

━━━━━━━━━━━━━━━━━━━━
+ SpinnerDemo is Box

• This
    focus-mode = FocusMode.keys

+ selected-index = 0

────────────────────

<Label " Spinners " • bg:blue text:white
<Label " Press Space or T to toggle type. Press Q or Escape to quit. " • bg:grey text:black

<Box • flex-col flex:1 bg:black p:2
    <Box • flex:1

    <Box • flex-row h:1
        <Box • flex:1
        <Spinner
            frames = spinner-demo-frames(#selected-index)
            interval = 90ms
        <Box • flex:1

    <Box • flex-row h:1 mt:1
        <Box • flex:1
        <Label • text:lightgray
            text = spinner-demo-title(#selected-index)
        <Box • flex:1

    <Box • flex-row h:1
        <Box • flex:1
        <Label • text:mutedgray
            text = spinner-demo-count-text(#selected-index)
        <Box • flex:1

    <Box • flex:1

<Shortcut "Quit"
    key = .escape
    action = => do root.close()

<Shortcut "Select next spinner"
    key = .space
    action = => do select-next-spinner()

<Shortcut "Select next spinner"
    key = 't'
    action = => do select-next-spinner()

<Shortcut "Quit"
    key = 'q'
    action = => do root.close()

────────────────────
+ do select-next-spinner

selected-index =
    |? selected-index + 1 >= spinner-demo-count()
        0
    ??
        selected-index + 1

━━━━━━━━━━━━━━━━━━━━
+ spinner-demo-count Int

6

━━━━━━━━━━━━━━━━━━━━
+ spinner-demo-frames SpinnerFrames
    - index Int

match index
    | 1
        SpinnerFrames.dots
    | 2
        SpinnerFrames.circle
    | 3
        SpinnerFrames.arc
    | 4
        SpinnerFrames.quadrant
    | 5
        SpinnerFrames.arrows
    ??
        SpinnerFrames.braille

━━━━━━━━━━━━━━━━━━━━
+ spinner-demo-title String
    - index Int

match index
    | 1
        "Dots"
    | 2
        "Circle"
    | 3
        "Arc"
    | 4
        "Quadrant"
    | 5
        "Arrows"
    ??
        "Braille"

━━━━━━━━━━━━━━━━━━━━
+ spinner-demo-count-text String
    - index Int

"${index + 1} / ${spinner-demo-count()}"
