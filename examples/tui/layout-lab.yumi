
/tui

<Window win • flex-col
    <LayoutLab app • flex-col flex:1 bg:black

win.open()

━━━━━━━━━━━━━━━━━━━━
+ LayoutLab is Box

• This
    focus-mode = FocusMode.keys

+ hide-extra = false
+ ghost-extra = true
+ wide-panel = false

────────────────────

<Label • bg:blue text:white
    text = layout-lab-title(#hide-extra, #ghost-extra, #wide-panel)
<Box • flex-row flex:1 p:1
    <Box • flow-col border p:1 mr:1
        min-width = if #wide-panel then SizeSpec.coord(46) else SizeSpec.auto
        <Label " Flow"
        <Label " one" • border p:1 mb:1
        <Label " two" • border p:1 mb:1
        <Label " hidden toggled row" • border p:1 mb:1
            display = if #hide-extra then Display.hidden else Display.visible
        <Label " invisible toggled row" • border p:1
            display = if #ghost-extra then Display.invisible else Display.visible

    <Box • flex-col flex:1 border p:1
        <Label " Flex"
        <Box • flex-row flex:1 mt:1
            <Box • flex:1 bg:red mr:1
            <Box • flex:2 bg:green mr:1
            <Box • flex:1 bg:yellow
        <Box • flow-row mt:1
            <Label " A " • bg:grey mr:1
            <Label " B " • bg:grey mr:1
            <Label " C " • bg:grey

    <Box • flow-col absolute border p:1 bg:navy
        anchor = .parent
        left = .anchor-end
        top = .anchor-start
        min-width = 14
        <Label " absolute"
        <Label " overlay"

<Shortcut "Quit"
    key = .escape
    action = => do root.close()

<Shortcut "Hide extra"
    key = 'h'
    action = => do hide-extra = !hide-extra

<Shortcut "Ghost extra"
    key = 'g'
    action = => do ghost-extra = !ghost-extra

<Shortcut "Wide panel"
    key = 'w'
    action = => do wide-panel = !wide-panel

<Shortcut "Quit"
    key = 'q'
    action = => do root.close()

━━━━━━━━━━━━━━━━━━━━
+ layout-lab-title String
    - hidden Bool
    - ghost Bool
    - wide Bool

" Layout Lab  H:$hidden-state  G:$ghost-state  W:$width-state  Q:quit"

.. hidden-state = if hidden then "hidden" else "visible"
.. ghost-state = if ghost then "invisible" else "visible"
.. width-state = if wide then "wide" else "natural"
