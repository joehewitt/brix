(import /math)
(import /stream/aggregate)
(import /stream/sort)
(import ./delve-world)
(import ./delve-creatures)
(blank)

(prop + deepest _ (= 5))
(prop + level-width _ (= 54))
(prop + level-height _ (= 19))

(type + Action (is Union)
  (variant step Spot)
  (variant rest)
  (variant descend)
)

(type + Fate (is Union)
  (variant delving)
  (variant slain Breed)
  (variant escaped)
)

(type + Occupant (is Union)
  (variant foe Creature)
  (variant open)
  (variant blocked)
)

(type + Expedition
  (prop + seed U64)
  (prop + depth _ (= 1))
  (prop + level Level)
  (prop + at Spot)
  (prop + health _ (= 20))
  (prop + max-health _ (= 20))
  (prop + blade _ (= 0))
  (prop + gold _ (= 0))
  (prop + creatures (list Creature))
  (prop + loot (list Loot))
  (prop + in-sight (list Creature))
  (prop + log (list String))
  (prop + turn _ (= 0))
  (prop + fate _ (= (. Fate delving)))
  (prop _ depth-dice (list Random))
  (prop _ fortune Random)
  (fn-do + This _
    (param seed _)
    (let dice (call Random seed))
    (= depth-dice (call List (in (call (. dice split)) (..< 0 deepest))))
    (= fortune (call (. dice split)))
    (call enter 1)
    (call note "You light your torch and step into the dark.")
  )
  (fn-do + act _
    (param action Action)
    (return-if (if (is-not fate .delving)))
    (let spent
      (match action
        (case (call .step heading)
          (call advance (+ at heading))
        )
        (case .rest
          true
        )
        (case .descend
          (call climb-down)
        )
      )
    )
    (if spent
      (call world-turn)
    )
  )
  (fn-expr + creature-at (? Creature)
    (param spot Spot)
    (call first (in each creatures (when (== (. each at) spot))))
  )
  (fn-expr + loot-at (? Loot)
    (param spot Spot)
    (call first (in each loot (when (== (. each at) spot))))
  )
  (fn-expr + occupant Occupant
    (param spot Spot)
    (case? creature
      (call (. Occupant foe) creature)
    )
    (case? (. ([] level spot) is-open)
      (. Occupant open)
    )
    (default
      (. Occupant blocked)
    )
    (where
      (lazy creature (call creature-at spot))
    )
  )
  (fn-expr + is-free Bool
    (param spot Spot)
    (and (. ([] level spot) is-open) (!= spot at) (not (call creature-at spot)))
  )
  (fn-do _ enter _
    (param next Int)
    (= depth next)
    (let dice ([] depth-dice (- depth 1)))
    (= level (call carve level-width level-height dice))
    (let rooms (. level rooms))
    (let far (. ([] rooms (- (. rooms length) 1)) center))
    (= at (. ([] rooms 0) center))
    (= creatures (call (of List Creature)))
    (= loot (call (of List Loot)))
    (if (< depth deepest)
      (= ([] level far) (. Tile stairs))
      (else
        (+= loot (call Loot far (. Item ember)))
      )
    )
    (let breeds (call breeds-for depth))
    (for (in count (..< 0 (+ 2 (* 2 depth))))
      (+= creatures (call Creature ([] breeds (call (. dice random) 0 (. breeds length))) (call vacant dice)))
    )
    (for (in count (..< 0 5))
      (+= loot (call Loot (call vacant dice) (call trinket depth dice)))
    )
    (call look)
  )
  (fn-do _ vacant Spot
    (param dice Random)
    (let rooms (. level rooms))
    (while true
      (let spot (call (. ([] rooms (call (. dice random) 1 (. rooms length))) random-spot) dice))
      (if (and (call is-free spot) (is ([] level spot) .floor) (not (call loot-at spot)))
        (return spot)
      )
    )
  )
  (fn-do _ note _
    (param message String)
    (+= log message)
  )
  (fn-do _ look _
    (call (. level illuminate) at)
    (= in-sight (call List (in each creatures (when (> (call (. level light-at) (. each at)) 0.0)))))
  )
  (fn-do _ advance Bool
    (param target Spot)
    (match (call occupant target)
      (case (call .foe creature)
        (call strike creature)
        (return true)
      )
      (case .open
        (= at target)
        (call gather)
        (return true)
      )
      (case .blocked
        (return false)
      )
    )
  )
  (fn-do _ strike _
    (param foe Creature)
    (call (. foe suffer) (call (. fortune random) 2 (+ 5 blade)) at)
    (if (. foe is-alive)
      (call note (str "You hit the " (. foe name) "."))
      (else
        (call note (str "You slay the " (. foe name) "."))
        (= creatures (call List (in each creatures (when (. each is-alive)))))
      )
    )
  )
  (fn-do _ gather _
    (for (in found loot (when (== (. found at) at)))
      (call take (. found item))
    )
    (= loot (call List (in each loot (when (!= (. each at) at)))))
  )
  (fn-do _ take _
    (param item Item)
    (match item
      (case .tonic
        (= health (call min max-health (+ health 8)))
        (call note "You drink a tonic. Warmth returns.")
      )
      (case (call .gold amount)
        (+= gold amount)
        (call note (str "You pocket " amount " gold."))
      )
      (case .blade
        (+= blade 1)
        (call note "A keener blade. Your strikes cut deeper.")
      )
      (case .ember
        (= fate (. Fate escaped))
        (call note "You lift the Ember, and the dark lets you go.")
      )
    )
  )
  (fn-do _ climb-down Bool
    (if (is-not ([] level at) .stairs)
      (call note "There are no stairs here.")
      (return false)
    )
    (call enter (+ depth 1))
    (call note (str "You descend to depth " depth "."))
    (return true)
  )
  (fn-do _ world-turn _
    (+= turn 1)
    (if (== (% turn 10) 0)
      (= health (call min max-health (+ health 1)))
    )
    (call look)
    (for (in creature creatures)
      (<- (. creature turns) 1.0)
      (if (> (call (. level light-at) (. creature at)) 0.0)
        (<- (. creature sightings) at)
      )
      (call creature-turn creature)
      (return-if (if (is-not fate .delving)))
    )
    (call look)
  )
  (fn-do _ creature-turn _
    (param creature Creature)
    (let from (. creature at))
    (match (. creature mind)
      (case .asleep)
      (case (call .hunting target)
        (if (== (call (. from steps) at) 1)
          (call bitten-by creature)
          (else
            (=? (. creature at) (call first (call nearer from target)))
          )
        )
      )
      (case .wandering
        (let choices (call openings from))
        (if choices
          (= (. creature at) ([] choices (call (. fortune random) 0 (. choices length))))
        )
      )
      (case (call .fleeing threat)
        (let away (call farther from threat))
        (if away
          (= (. creature at) ([] away 0))
          (else-if (== (call (. from steps) at) 1)
            (call bitten-by creature)
          )
        )
      )
    )
  )
  (fn-expr _ openings (list Spot)
    (param from Spot)
    (call List (in each (. from neighbors) (when (call is-free each))))
  )
  (fn-expr _ nearer (list Spot)
    (param from Spot)
    (param target Spot)
    (call sort closer (:using (=> (a b) (call compare-basic (call (. a distance) target) (call (. b distance) target)))))
    (where
      (lazy closer (in each (call openings from) (when (< (call (. each distance) target) (call (. from distance) target)))))
    )
  )
  (fn-expr _ farther (list Spot)
    (param from Spot)
    (param threat Spot)
    (call sort safer (:using (=> (a b) (call compare-basic (call (. b distance) threat) (call (. a distance) threat)))))
    (where
      (lazy safer (in each (call openings from) (when (> (call (. each distance) threat) (call (. from distance) threat)))))
    )
  )
  (fn-do _ bitten-by _
    (param creature Creature)
    (= health (call max 0 (- health (call (. creature bite) fortune))))
    (if (> health 0)
      (call note (str "The " (. creature name) " bites you."))
      (else
        (= fate (call (. Fate slain) (. creature breed)))
        (call (. level snuff))
        (call note (str "The " (. creature name) " bites you, and your torch gutters out."))
      )
    )
  )
)

(fn-do + trinket Item
  (param depth Int)
  (param dice Random)
  (return
    (match (call (. dice random) 0 20)
      (case ({} (< it 8))
        (. Item tonic)
      )
      (case ({} (< it 17))
        (call (. Item gold) (call (. dice random) 5 (+ 10 (* depth 8))))
      )
      (default
        (. Item blade)
      )
    )
  )
)

(fn-expr + epitaph String
  (param fate Fate)
  (param depth Int)
  (param gold Int)
  (match fate
    (case .delving
      ""
    )
    (case (call .slain breed)
      (str "Slain by a " (. breed name) " on depth " depth ", with " gold " gold.")
    )
    (case .escaped
      (str "You escaped with the Ember and " gold " gold.")
    )
  )
)
