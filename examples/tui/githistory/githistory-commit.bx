(import /git/changes)
(import /git/diffs)
(import /git/log)
(import /git/stats)
(import /math)
(import /stream/aggregate)
(import /tui)
(import /tui/virtual)
(import /ui/virtual)
(import /ui/virtual-layout)
(import ./githistory-diff)
(import ./githistory-theme)
(blank)
(prop _ bar-width _ (= 6))

(type + CommitView (is Tuple)
  (prop + details GitCommitDetails)
  (prop + changes GitChangeSet)
  (prop + counts GitLineCounts)
  (prop + largest I64)
  (fn-expr + files (list GitLineCount) :get
    (. counts files)
  )
)

(type + PaneRow (is Union)
  (variant heading GitCommitDetails)
  (variant subject (tuple (: text String) (: has-body Bool)))
  (variant body String)
  (variant summary GitLineCounts)
  (variant file GitLineCount)
  (variant gap)
  (fn-expr + is-selectable Bool :get
    (or (is this .subject) (is this .summary) (is this .file))
  )
)

(type + CommitPane (is Box)
  (using HistoryTheme)
  (prop + directory String)
  (prop + commit (? GitCommit))
  (prop + shown CommitView)
  (prop + is-ready Bool)
  (prop + is-open Bool)
  (prop + rows (list PaneRow))
  (prop + chosen I64)
  (prop + problem String)
  (prop _ source _ (:= (call (of VirtualListSource PaneRow))))
  (prop _ requests _ (= (call (of AsyncBufferedChannel GitCommit))))
  (prop _ stats (? GitStatsReader))
  (event + opened DiffRequest)
  (event + dismissed Bool)
  (blank)
  (rule This (• flex-col) (• bg history-panel) (• px 1) (• pt 1)
    (= focus-mode (. FocusMode keys))
  )
  (content
    (if (not #is-ready)
      (<> Label (• text history-muted)
        (= text (call pane-notice #commit #problem))
      )
    )
    (<> (of VirtualRegion PaneRow) (id: region) (• flex 1)
      (= source source)
      (= virtual-layout (call VerticalFixedLayout 1vcoord))
      (blank)
      (<> PaneLine (slot: row) (param: slot)
        (= row (. slot #item))
        (= largest (. #shown largest))
        (= is-open #is-open)
        (= is-selected (== (. slot #address) #chosen))
        (= is-current (and (== (. slot #address) #chosen) #is-focused))
      )
    )
    (<> Shortcut (text: "Next")
      (= key .arrow-down)
      (= show-in-status false)
      (= action (=> () :do (call move 1)))
    )
    (<> Shortcut (text: "Previous")
      (= key .arrow-up)
      (= show-in-status false)
      (= action (=> () :do (call move -1)))
    )
    (<> Shortcut (text: "Open")
      (= key .enter)
      (= action (=> () :do (call activate)))
    )
    (<> Shortcut (text: "Message")
      (= key 'm')
      (= action (=> () :do (call toggle-message)))
    )
    (<> Shortcut (text: "Commits")
      (= key .escape)
      (= action (=> () :do (<- dismissed true)))
    )
  )
  (when-rule #commit
    (let wanted commit)
    (if wanted
      (<- requests wanted)
    )
  )
  (subscribe-for (on wanted requests)
    (if (== (. wanted id) (?. commit id))
      (call show wanted
        (block
          (on-error (: failure Error)
            (= problem (. failure message))
          )
        )
      )
    )
  )
  (fn-do _ show _ (?! Error)
    (param wanted GitCommit)
    (if (not stats)
      (= stats (call GitStatsReader directory))
    )
    (let details (call git-commit-details directory (. wanted id)))
    (let changes (call git-commit-changes directory wanted))
    (let counts (call (. (!! stats) read) wanted))
    (return-if (if (!= (. wanted id) (?. commit id))))
    (let largest (?? (call max (in (+ (. each additions) (. each deletions)) (. counts files))) 1))
    (= shown (call CommitView details changes counts (call max 1 largest)))
    (= is-ready true)
    (= is-open false)
    (= problem "")
    (call rebuild)
    (= chosen (call first-file rows))
    (let ignored (call (. region scroll-to-address) 0))
  )
  (fn-do + close _
    (call (. requests close))
    (call (?. stats close))
    (call (. super close))
  )
  (fn-do + move _
    (param step I64)
    (let index (+ chosen step))
    (while (and (>= index 0) (< index (. rows length)) (not (. ([] rows index) is-selectable)))
      (+= index (if-expr (< step 0) -1 1))
    )
    (if (and (>= index 0) (< index (. rows length)))
      (= chosen index)
      (call reveal)
    )
  )
  (fn-do + activate _
    (return-if (if (not is-ready)))
    (let row ([] rows chosen))
    (if (is row .subject)
      (call toggle-message)
      (else-if (= (| (call .file count)) row)
        (<- opened (call DiffRequest (. shown changes) (. count path)))
      )
      (else
        (<- opened (call DiffRequest (. shown changes) ""))
      )
    )
  )
  (fn-do + toggle-message _
    (return-if (if (not is-ready)))
    (let kept ([] rows chosen))
    (= is-open (not is-open))
    (call rebuild)
    (= chosen (?? (call (. rows find) kept) (call first-file rows)))
    (call reveal)
  )
  (fn-do _ rebuild _
    (= rows (call pane-rows shown is-open))
    (call (. source replace) rows)
  )
  (fn-do _ reveal _
    (let address (if-expr (is ([] rows chosen) .subject) 0 chosen))
    (let ignored (call (. region scroll-to-address) address (. ScrollAlignment nearest)))
  )
)

(type + PaneLine (is Box)
  (using HistoryTheme)
  (prop + row PaneRow)
  (prop + largest I64)
  (prop + is-open Bool)
  (prop + is-selected Bool)
  (prop + is-current Bool)
  (blank)
  (rule This (• flex-row) (• flex 1) (• history-row))
  (content
    (if (= (| (call .heading details)) #row)
      (<> Label (• text history-gold)
        (= text (str (. details short-id) "  "))
      )
      (<> Label (• flex 1) (• text history-muted)
        (= text (str (. details author-name) " · " (. details author-date)))
      )
      (else-if (= (| (call .subject text has-body)) #row)
        (<> Label (• w 2) (• text history-accent)
          (= text (call disclosure has-body #is-open))
        )
        (<> Label (• flex 1) (• text history-ink)
          (= text text)
        )
      )
      (else-if (= (| (call .body text)) #row)
        (<> Label (• flex 1) (• text history-muted) (• pl 2)
          (= text text)
        )
      )
      (else-if (= (| (call .summary counts)) #row)
        (<> Label (• text history-muted)
          (= text (call file-count (. counts files length)))
        )
        (<> Label (• text history-added)
          (= text (str "+" (. counts additions) " "))
        )
        (<> Label (• flex 1) (• text history-removed)
          (= text (str "−" (. counts deletions)))
        )
      )
      (else-if (= (| (call .file count)) #row)
        (<> FileRow (• flex 1)
          (= entry count)
          (= largest #largest)
        )
      )
    )
  )
)

(type + FileRow (is Box)
  (using HistoryTheme)
  (prop + entry GitLineCount)
  (prop + largest I64)
  (blank)
  (rule This (• flex-row))
  (content
    (<> Label (• w 2)
      (= text (. #entry status))
      (= color (call status-color (. #entry status)))
    )
    (<> Label (• text history-ink)
      (= text (call name-part (. #entry path)))
    )
    (<> Label (• text history-faint) (• flex 1) (• pl 1)
      (= text (call folder-part (. #entry path)))
    )
    (<> Label (• text history-added)
      (= text (str " +" (. #entry additions)))
    )
    (<> Label (• text history-removed)
      (= text (str " −" (. #entry deletions) " "))
    )
    (<> Label (• text history-added)
      (= text (call bar (. #entry additions) #largest))
    )
    (<> Label (• text history-removed) (• w (+ 1 bar-width (- 0 (call bar-length (. #entry additions) #largest))))
      (= text (call bar (. #entry deletions) #largest))
    )
  )
)

(fn-expr + pane-rows (list PaneRow)
  (param view CommitView)
  (param is-open Bool)
  (call (of List PaneRow)
    (block
      (bullet (call (. PaneRow heading) (. view details)))
      (bullet (. PaneRow gap))
      (bullet (call (. PaneRow subject) (. view details subject) (> (. lines length) 0)))
      (bullet* (in (call (. PaneRow body) each) lines (when is-open)))
      (bullet (. PaneRow gap))
      (bullet (call (. PaneRow summary) (. view counts)))
      (bullet* (in (call (. PaneRow file) each) (. view files)))
    )
  )
  (where
    (lazy lines (call body-lines (. view details body)))
  )
)

(fn-expr _ first-file I64
  (param rows (list PaneRow))
  (?? (call first (in each (..< 0 (. rows length)) (when (is ([] rows each) .file)))) (- (. rows length) 1))
)

(fn-expr _ disclosure String
  (param has-body Bool)
  (param is-open Bool)
  (case? (not has-body)
    " "
  )
  (case? is-open
    "▾"
  )
  (default
    "▸"
  )
)

(fn-expr _ bar String
  (param lines I64)
  (param largest I64)
  (* "■" (call bar-length lines largest))
)

(fn-expr _ bar-length Int
  (param lines I64)
  (param largest I64)
  (as (call ceil (/ (* (as lines Float) bar-width) (as largest Float))) Int)
)

(fn-expr + folder-part String
  (param path String)
  (if-expr slash ([] path (..< 0 slash)) "")
  (where
    (lazy slash (call (. path find-reverse) "/"))
  )
)

(fn-expr + name-part String
  (param path String)
  (if-expr slash ([] path (... (+ slash 1))) path)
  (where
    (lazy slash (call (. path find-reverse) "/"))
  )
)

(fn-expr _ pane-notice String
  (param commit (? GitCommit))
  (param problem String)
  (case? (> (. problem length) 0)
    problem
  )
  (case? (not commit)
    "No commits yet"
  )
  (default
    "Reading the commit…"
  )
)

(fn-expr _ file-count String
  (param count Int)
  (if-expr (== count 1) "1 file  " (str count " files  "))
)

(fn-expr _ body-lines (list String)
  (param body String)
  (if-expr (> (. body length) 0) (call List (call (. body split) "\n")) (call (of List String)))
)
