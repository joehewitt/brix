(import /graphics/color)
(import /tui)
(blank)
(prop + history-night _ (= (call RGBA "#0b0f17")))
(prop + history-panel _ (= (call RGBA "#111827")))
(prop + history-raised _ (= (call RGBA "#1a2234")))
(prop + history-selection _ (= (call RGBA "#1d3557")))
(prop + history-dull-selection _ (= (call RGBA "#1a2436")))
(prop + history-added-wash _ (= (call RGBA "#0f2a1d")))
(prop + history-removed-wash _ (= (call RGBA "#33161c")))
(prop + history-ink _ (= (call AnsiColor 255)))
(prop + history-muted _ (= (call AnsiColor 246)))
(prop + history-faint _ (= (call AnsiColor 240)))
(prop + history-gold _ (= (call AnsiColor 179)))
(prop + history-accent _ (= (call AnsiColor 75)))
(prop + history-added _ (= (call AnsiColor 114)))
(prop + history-removed _ (= (call AnsiColor 210)))
(prop _ lane-colors _ (= (list (call AnsiColor 75) (call AnsiColor 176) (call AnsiColor 214) (call AnsiColor 114) (call AnsiColor 210) (call AnsiColor 147) (call AnsiColor 80))))

(style HistoryTheme
  (using TUIShorthandsTheme)
  (using BoxPaint)
  (using TextPaint)
  (using BoxBorder)
  (using BoxSpacing)
  (rule history-row
    (when-style #is-selected (• bg history-dull-selection))
    (when-style #is-current (• bg history-selection))
  )
)

(fn-expr + lane-color AnsiColor
  (param tone Int)
  ([] lane-colors (% tone (. lane-colors length)))
)
