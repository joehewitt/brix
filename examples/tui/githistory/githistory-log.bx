(import /git/log)
(import /git/repository)
(import /git/status)
(import /git/watch)
(import /math)
(import /time/duration)
(import /time/zone)
(import /ui/virtual)
(import ./githistory-graph)
(blank)
(prop _ log-page-size _ (= 400))

(type + LogEntry (is Tuple)
  (prop + commit GitCommit)
  (prop + cells (list GraphCell))
)

(type + HistoryLog
  (implements Closable)
  (prop + directory String)
  (prop _ watch GitWorktreeWatch)
  (prop + entries (list LogEntry))
  (prop + count Int)
  (prop + lane-count Int)
  (prop + branch String)
  (prop + is-loading Bool)
  (prop + problem String)
  (prop + source _ (:= (call (of VirtualListSource LogEntry))))
  (prop _ positions (map String Index))
  (prop _ loading (? Task))
  (blank)
  (fn-do + This _
    (param directories GitDirectories)
    (= directory (. directories top))
    (= watch (call GitWorktreeWatch directory (. directories git-dir) (. directories common-dir)))
  )
  (subscribe-for (on change (. watch changed) (when (. change is-git-changed)))
    (call load)
  )
  (fn-do + load _
    (call (?. loading cancel))
    (= is-loading true)
    (= problem "")
    (= loading
      (do-new
        (call read-pages
          (block
            (on-error (: failure Error)
              (= problem (. failure message))
            )
          )
        )
        (= is-loading false)
      )
    )
  )
  (fn-do + close _
    (call (?. loading cancel))
    (call (. watch close))
  )
  (fn-expr + position-of (? Index)
    (param id String)
    ([] positions id)
  )
  (fn-expr + entry-for (? LogEntry)
    (param shown (list LogEntry))
    (param id String)
    (only-if ([] shown (?? ([] positions id) 0)) (if (> (. shown length) 0)))
  )
  (fn-expr + entry-at (? LogEntry)
    (param index Index)
    (only-if ([] entries index) (if (and (>= index 0) (< index (. entries length)))))
  )
  (fn-do _ read-pages _ (?! Error)
    (= branch (?? (. (call git-status directory) branch) "detached"))
    (let graph (call HistoryGraph))
    (let reader (use (call GitLogReader directory "HEAD" true)))
    (let fresh (call (of List LogEntry)))
    (let places (call (of Map String Index)))
    (let widest 1)
    (while true
      (let page (call (. reader next) log-page-size))
      (for (in commit page)
        (let cells (call (. graph place) commit))
        (= ([] places (. commit id)) (. fresh length))
        (+= fresh (call LogEntry commit cells))
        (= widest (call max widest (. cells length)))
      )
      (= entries fresh)
      (= positions places)
      (= count (. fresh length))
      (= lane-count widest)
      (call (. source replace) fresh)
      (return-if (if (< (. page length) log-page-size)))
    )
  )
)

(fn-expr + age-text String
  (param time I64)
  (case? (< age 1minutes)
    "now"
  )
  (case? (< age 1hours)
    (str (as (as age Minutes) Int) "m")
  )
  (case? (< age 1days)
    (str (as (as age Hours) Int) "h")
  )
  (case? (< age 8weeks)
    (str (as (as age Days) Int) "d")
  )
  (case? (< age 1years)
    (str (as (as age Months) Int) "mo")
  )
  (default
    (str (as (as age Years) Int) "y")
  )
  (where
    (lazy age (as (- (as (. utc now) I64) time) Seconds))
  )
)
