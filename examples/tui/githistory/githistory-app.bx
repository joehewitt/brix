; githistory: a Git history browser for the terminal. It draws the commit graph of
; the current branch, shows each commit's files and diffs, and follows new commits
; as they land. It needs `git` on the PATH. Run it inside a repository, or give it
; a path: yumi examples/tui/githistory/githistory-app.bx -o .tmp/build/githistory -- ~/src/app
(import /git/repository)
(import /math)
(import /os/cli)
(import /os/env)
(import /os/exit)
(import /os/path)
(import /tui)
(import /tui/virtual)
(import /ui/virtual)
(import /ui/virtual-layout)
(import ./githistory-commit)
(import ./githistory-diff)
(import ./githistory-graph)
(import ./githistory-log)
(import ./githistory-theme)
(blank)
(prop _ widest-graph _ (= 8))
(blank)

(main
  (<> CommandLine (id: cli)
    (= name "githistory")
    (= about "Browse the commit history of a Git repository.")
    (<> Argument (id: folder) (text: "folder")
      (= about "a folder inside the repository, or the current one")
    )
  )
  (call (. cli run))
  (blank)
  (let path (?? (. folder value) (call cwd)))
  (let found (call git-find-directories path))
  (if (not found)
    (call fail (str path " is not inside a Git repository"))
  )
  (blank)
  (let log (call HistoryLog found))
  (blank)
  (<> App
    (<> Window (id: win) (• flex-col) (• bg history-night)
      (<> HistoryBrowser (id: browser) (• flex 1)
        (= log log)
        (blank)
      )
      (<> Shortcut (text: "Quit")
        (= key 'q')
        (= action (=> () :do (call (. win close))))
      )
      (blank)
      (<> StatusBar
        (= message (. browser #status))
      )
    )
  )
  (blank)
  (call (. log load))
)

(type + HistoryBrowser (is Box)
  (using HistoryTheme)
  (prop + log HistoryLog)
  (prop + opened (? DiffRequest))
  (prop + status _ (= (call log-status (. #log #count) (. #log #is-loading) (. #log #problem))))
  (prop _ window (of Ancestor Window))
  (blank)
  (rule This (• flex-col))
  (content
    (<> Box (• flex-row) (• h 1) (• bg history-raised) (• px 1)
      (<> Label (text: "◆ ") (• text history-accent))
      (<> Label (• text history-ink)
        (= text (. (call Path (. #log directory)) name))
      )
      (<> Label (• flex 1) (• text history-muted)
        (= text (str "  ⎇ " (. #log #branch)))
      )
      (if (. #log #is-loading)
        (<> Spinner (• w 2) (• text history-accent)
          (= colorful false)
        )
      )
      (<> Label (• text history-muted)
        (= text (call commit-count (. #log #count)))
      )
    )
    (<> Box (• flex-row) (• flex 1)
      (<> CommitList (id: list) (• flex 3)
        (= log #log)
      )
      (<> CommitPane (id: pane) (• flex 2)
        (= directory (. #log directory))
        (= commit (?. (. list #chosen-entry) commit))
      )
    )
    (if #opened
      (<> DiffView (id: diff)
        (= request #opened)
      )
      (<> Shortcut (text: "Back")
        (= key .escape)
        (= action (=> () :do (call close-diff)))
      )
    )
  )
  (subscribe-for (on _ (. list activated))
    (call (?. window focus) pane)
  )
  (subscribe-for (on _ (. pane dismissed))
    (call (?. window focus) list)
  )
  (subscribe-for (on request (. pane opened))
    (= opened request)
  )
  (fn-do + close _
    (call (. log close))
    (call (. super close))
  )
  (fn-do + close-diff _
    (= opened null)
    (call (?. window focus) pane)
  )
)

(type + CommitList (is Box)
  (using HistoryTheme)
  (prop + log HistoryLog)
  (prop + chosen String)
  (prop + chosen-entry (? LogEntry) (= (call (. log entry-for) (. #log #entries) #chosen)))
  (event + activated Bool)
  (blank)
  (rule This (• flex-col)
    (= focus-mode (. FocusMode keys))
  )
  (content
    (if (> (. (. #log #problem) length) 0)
      (<> Label (• text history-removed) (• px 1)
        (= text (. #log #problem))
      )
    )
    (<> (of VirtualRegion LogEntry) (id: region) (• flex 1)
      (= source (. log source))
      (= virtual-layout (call VerticalFixedLayout 1vcoord))
      (blank)
      (<> CommitRow (slot: row) (param: slot)
        (= entry (. slot #item))
        (= lane-count (. #log #lane-count))
        (= is-selected (== (. slot #item commit id) (?. #chosen-entry commit id)))
        (= is-current (and (== (. slot #item commit id) (?. #chosen-entry commit id)) #is-focused))
      )
    )
    (<> Shortcut (text: "Next")
      (= key .arrow-down)
      (= show-in-status false)
      (= action (=> () :do (call move 1)))
    )
    (<> Shortcut (text: "Previous")
      (= key .arrow-up)
      (= show-in-status false)
      (= action (=> () :do (call move -1)))
    )
    (<> Shortcut (text: "Page down")
      (= key (call KeyCombo (. Key page-down)))
      (= show-in-status false)
      (= action (=> () :do (call move (. region content-bounds height))))
    )
    (<> Shortcut (text: "Page up")
      (= key (call KeyCombo (. Key page-up)))
      (= show-in-status false)
      (= action (=> () :do (call move (- 0 (. region content-bounds height)))))
    )
    (<> Shortcut (text: "Files")
      (= key .enter)
      (= action (=> () :do (<- activated true)))
    )
  )
  (fn-do + move _
    (param step I64)
    (let here (?? (call (. log position-of) (?? (?. chosen-entry commit id) "")) 0))
    (let next (call (. log entry-at) (call clamp (+ here step) 0 (- (. log count) 1))))
    (if next
      (= chosen (. next commit id))
      (let ignored (call (. region scroll-to-address) (?? (call (. log position-of) chosen) 0) (. ScrollAlignment nearest)))
    )
  )
)

(type + CommitRow (is Box)
  (using HistoryTheme)
  (prop + entry LogEntry)
  (prop + lane-count Int)
  (prop + is-selected Bool)
  (prop + is-current Bool)
  (blank)
  (rule This (• flex-row) (• flex 1) (• history-row))
  (content
    (<> Box (• flex-row) (• w (+ 1 (* 2 (call min #lane-count widest-graph)))) (• pl 1) (• mr 1)
      (for (in cell (. #entry cells))
        (<> LaneCell
          (= cell cell)
        )
      )
    )
    (<> Label (• text history-gold) (• w 9)
      (= text (. #entry commit short-id))
    )
    (<> Label (• text history-ink) (• flex 1)
      (= text (. #entry commit subject))
    )
    (<> Label (• text history-muted) (• w 16) (• pl 1)
      (= text (. #entry commit author))
    )
    (<> Label (• text history-faint) (• w 5)
      (= text (str " " (call age-text (. #entry commit time))))
    )
  )
)

(type + LaneCell (is Box)
  (prop + cell GraphCell)
  (blank)
  (rule This (• flex-row) (• w 2))
  (content
    (<> Label (• w 1)
      (= text (. #cell glyph))
      (= color (call lane-color (. #cell glyph-tone)))
    )
    (<> Label (• w 1)
      (= text (. #cell link))
      (= color (call lane-color (. #cell link-tone)))
    )
  )
)

(fn-expr + commit-count String
  (param count Int)
  (if-expr (== count 1) "1 commit" (str count " commits"))
)

(fn-expr + log-status String
  (param count Int)
  (param is-loading Bool)
  (param problem String)
  (case? (> (. problem length) 0)
    problem
  )
  (case? is-loading
    (str "Reading history… " count)
  )
  (default
    ""
  )
)
