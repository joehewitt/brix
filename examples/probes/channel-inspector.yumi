
/core/channel
/time

+ Order is (id Int, sku String, quantity Int)
+ Status is (order-id Int, step String)

. orders SyncChannel'Order
. statuses = SyncBufferedChannel'Status()
. alerts = AsyncChannel'String()

//+channel.inspector// Channel inspector showcase
// This demo creates three kinds of channel traffic for the probe inspector.
// Open these first; they are the stable handles for the rest of the run.
// orders: sync rendezvous channel $!orders
// statuses: buffered backlog channel $!statuses
// alerts: async broadcast channel $!alerts

//+ SyncChannel rendezvous: the reader waits, then each write wakes it

do new
    // orders worker is waiting $!orders
    for order in orders
        // orders worker received $order with channel state $!orders
        0.45s.wait()

for i in 0 .. < 14
    0.45s.wait()
    . order = Order(100 + i, "apples", i + 1)
    // orders producer writes $order
    orders <- order

1.2s.wait()
orders.close()
//- orders channel closed $!orders

//+ SyncBufferedChannel backlog: writes pile up before a consumer drains them

do new
    3s.wait()
    for update in statuses
        // status consumer drained $update and sees $!statuses
        0.5s.wait()

for i in 0 .. < 24
    0.3s.wait()
    . update = Status(200 + (i % 6), "queued")
    statuses <- update
    // status producer wrote $update with channel state $!statuses

3s.wait()
statuses.close()
//- status channel closed $!statuses

//+ AsyncChannel broadcast: two subscribers receive the same writes

for alert on alerts
    // subscriber A saw alert "$alert" with $!alerts

for alert on alerts
    // subscriber B saw alert "$alert" with $!alerts

1.5s.wait()
// alert channel has two subscribers $!alerts

for i in 0 .. < 16
    0.5s.wait()
    . alert = "alert $i"
    // alert producer broadcasts "$alert" with channel state $!alerts
    alerts <- alert

1.5s.wait()
alerts.close()
//- alert channel closed $!alerts

// Channel inspector showcase complete
4s.wait()
//-channel.inspector
