
/time

-- "Ometer profile demo"
-- "Open the Console, click the profile button, then run this file."
-- "Timers update while it runs; counters appear after the program exits."

. batches [Int]

//+demo.profile.run// profile demo run
for batch in 0 .. < 6
    batches += batch
    //batches:demo.profile.objects.batches ++
    //demo.profile.batches ++
    //+demo.profile.batch// batch $batch
    -- "batch ${batch + 1}"
    parse-batch(batch)
    render-batch(batch)
    0.25s.wait()
    //-demo.profile.batch// batch $batch done

//-demo.profile.run// profile demo run done

-- "Done. Save this stopped run from the profile panel to test comparisons."

━━━━━━━━━━━━━━━━━━━━
+ do parse-batch
    - batch Int

//+demo.profile.parse// parse batch $batch
. tokens = 12 + batch
for token in 0 .. < tokens
    //demo.profile.parse.tokens ++
    if token % 4 == 0
        //+demo.profile.parse.slow-token// slow token
        0.08s.wait()
        //-demo.profile.parse.slow-token// slow token done
    else
        0.015s.wait()
//-demo.profile.parse// parse batch $batch done

━━━━━━━━━━━━━━━━━━━━
+ do render-batch
    - batch Int

//+demo.profile.render// render batch $batch
for pass in 0 .. < 3
    //+demo.profile.render.pass// render pass $pass
    . pixels = 18 + batch * 2
    for pixel in 0 .. < pixels
        //demo.profile.render.pixels += 2
        if pixel % 9 == 0
            0.02s.wait()
    //-demo.profile.render.pass// render pass $pass done
//-demo.profile.render// render batch $batch done
