#!/usr/bin/env python3
import json
import os
import sys

REPORT_SUFFIX = '.run.json'


def main(arguments):
    if not arguments:
        fail('usage: yumi-run artifact [args...]', 2)
    artifact = arguments[0]
    command = run_command(artifact)
    try:
        os.execvp(command[0], command + arguments[1:])
    except OSError as error:
        fail('Unable to run %s: %s' % (command[0], error.strerror), 127)


def run_command(artifact):
    report = artifact + REPORT_SUFFIX
    try:
        with open(report) as file:
            command = json.load(file)['run']
    except FileNotFoundError:
        return [artifact]
    except (OSError, ValueError, KeyError, TypeError) as error:
        fail('%s is not a run report: %s' % (report, error), 2)
    if not isinstance(command, list) or not command or not all(isinstance(part, str) for part in command):
        fail('%s names no command to run' % report, 2)
    return command


def fail(message, status):
    sys.stderr.write('%s\n' % message)
    sys.exit(status)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
