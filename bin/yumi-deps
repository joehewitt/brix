#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'toolchain'))

import deps
from common import run_main


def main(names):
    for name in names:
        print(deps.ensure_dependency(name))


sys.exit(run_main(main))
