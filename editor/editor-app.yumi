./editor-window
./examples
./workspace
/gui
/lang/product/mac-app
/os/cli
/os/path
/os/shell
/ui/app-state
/unistd.h

if C:isatty(1) != 1
    adopt-login-shell-environment()

<MacApp product
    id = "com.brix-lang.editor"
    name = "Brix Editor"
    <DocumentType
        name = "Brix Source"
        extensions = ["bx"]
        rank = "owner"
    <DocumentType
        name = "Yumi Source"
        extensions = ["yumi"]
        rank = "alternate"
    <DocumentType
        name = "Text"
        content-types = ["public.text"]
        rank = "alternate"
    <DocumentType
        name = "Folder"
        content-types = ["public.folder"]
        rank = "alternate"

. state = AppState("Brix Editor")
<App app
    state = state

. shell = use EditorShell(app, state)
shell.start(List'Path(Path(each, 0) in cmdline().args))
for paths on app.open-requested
    shell.open-paths(paths)

━━━━━━━━━━━━━━━━━━━━
+ EditorShell
    is Closable

+ app App
+ state AppState
+ workspace Workspace
+ window EditorWindow

────────────────────
+ This
    - app
    - state

workspace = Workspace(state)
window = EditorWindow(workspace)
app += window
for event on window.closed
    if !app.is-quitting
        app.stop()
for event on window.runner.toolchain-installed
    set-up-examples()

────────────────────
+ do start
    - paths [Path]

if paths.length > 0
    window.open-paths(paths)
    =
. examples = BundledExamples(state, examples-toolchain())
update-examples(examples)
workspace.restore()
if !workspace.folder && workspace.documents.length == 0
    open-examples(examples)

────────────────────
+ do open-paths
    - paths [Path]

window.open-paths(paths)
window.bring-to-front()

────────────────────
+ do close

workspace.close()

────────────────────
_ do update-examples
    - examples BundledExamples

. kept = examples.update()
    catch error Error
        workspace.failed <- "Unable to update the examples: ${error.message}"
        =
if kept
    workspace.remember-folder(kept)

────────────────────
_ do set-up-examples

. examples = BundledExamples(state, examples-toolchain())
. installed = examples.install()
    catch error Error
        workspace.failed <- "Unable to set up the examples: ${error.message}"
        =
=? if !installed
if !workspace.folder && workspace.documents.length == 0
    workspace.open-folder(installed)
else
    workspace.remember-folder(installed)

────────────────────
_ do open-examples
    - examples BundledExamples

. installed = examples.install()
    catch error Error
        workspace.failed <- "Unable to set up the examples: ${error.message}"
        =
if installed
    workspace.open-folder(installed)
