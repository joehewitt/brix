./brix-file
./runner
/code/code-document
/code/structure/document
/graphics/point
/lang/brix/brix
/os/path

━━━━━━━━━━━━━━━━━━━━
+ FindAction is Union

| find
| replace
| next
| previous
| selection

━━━━━━━━━━━━━━━━━━━━
+ FoldAction is Union

| fold
| unfold
| fold-all
| unfold-all

━━━━━━━━━━━━━━━━━━━━
+ EditorJump is Tuple

+ line Size
+ column Size?

━━━━━━━━━━━━━━━━━━━━
+ EditorDocument
    is Closable

+ id U64
+ path Path
+ code CodeDocument?
+ brix BrixFile?
+ is-modified = false
+ status = ""
+ scroll = Point(0, 0)
+ jump EditorJump?
+ can-run = false
+ event find-requested FindAction
+ event fold-requested FoldAction
+ event save-requested EditorDocument

────────────────────
+ This
    - id
    - path
    - text String

can-run = runner-can-run(path, text)
if path.extension == "bx"
    . read = catch brix-document-read(text)
    if read is Error
        status = "Not readable as Brix: ${(read as Error).message}"
        code = CodeDocument(path, text)
    else
        brix = BrixFile(path, text, read as SourceDocument)
else
    code = CodeDocument(path, text)
catch code?.watch()
catch brix?.watch()

────────────────────
+ get title String

path.name

────────────────────
+ get is-brix Bool

brix != null

────────────────────
+ get is-changed-on-disk Bool

code?.is-changed-on-disk ?? brix?.is-changed-on-disk ?? false

────────────────────
+ get is-missing Bool

code?.is-missing ?? brix?.is-missing ?? false

────────────────────
+ get language String

if brix != null then "Brix" else ""

────────────────────
+ do save ?! Error

. active = code
if active
    active.save()
    is-modified = active.is-modified
    status = ""
    =
. file = brix
?! Error("Unable to write $path") if file != null && !file.save()
is-modified = false
status = ""

────────────────────
+ do revert

code?.reload(true)
brix?.reload(true)
is-modified = false

────────────────────
+ do note-modified
    - modified Bool

is-modified = modified

────────────────────
+ do jump-to
    - line Size
    - column Size? = null

jump = EditorJump(line, column)

────────────────────
+ do close

code?.close()
brix?.close()

━━━━━━━━━━━━━━━━━━━━
+ do open-editor-document EditorDocument ?! Error
    - id U64
    - path Path

. text = code-read-text(path)
?! Error("${path.name} is not a text file") if text == null
= EditorDocument(id, path, text)
