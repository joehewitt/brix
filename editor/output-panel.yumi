━━━━━━━━━━━━━━━━━━━━
• extend EditorTheme

• output-panel • flex-col bg:editor-document-color
    border-color = gui-divider-color
    border-width = 0
    border-top-width = 1

• output-bar • flex-row items-center h:34 px:8

• output-status • text:gui-muted-text-color ml:10

• output-filter • w:200 mr:6

• output-note • text:gui-muted-text-color
    font-size = gui-footnote-font-size

━━━━━━━━━━━━━━━━━━━━
+ OutputMode is Union

| output
| probes

━━━━━━━━━━━━━━━━━━━━
+ OutputPanel is Box
    using EditorTheme

+ workspace Workspace
+ runner Runner
+ mode = OutputMode.output
+ status = runner-status(runner.#state, runner.#exit-code)
+ feed = runner.#feed
+ revision = #feed?.#revision ?? 0u64
+ is-recording = #feed?.#is-recording ?? false
+ probe-status = if #feed then probe-feed-status(#revision, #is-recording, #feed) else ""
+ counters = probe-feed-counters(#revision, #feed)
+ filter-text = ""
+ event closed Bool

────────────────────

<This • output-panel
    <Box • output-bar
        <SegmentedControl'OutputMode
            selected = #mode
            for event on selection-changed
                mode = event.value
            <Segment'OutputMode
                title = "Output"
                value = OutputMode.output
            <Segment'OutputMode
                title = "Probes"
                value = OutputMode.probes
        <Label • output-status flex:1
            text = if #mode == OutputMode.probes && #probe-status.length > 0 then #probe-status else #status
        if #mode == OutputMode.probes
            <TextInput • output-filter
                placeholder = "Filter text or key"
                live-edit-delay = probe-filter-delay
                for event on text-edited
                    filter-text = event.text
                for event on change
                    filter-text = event.text
        <IconButton • icon-x w:24 h:22
            action = => do closed <- true
            <Tooltip "Hide Output (⇧⌘Y)"
    <TerminalView terminal • flex:1 p:6
        session = runner.session
        display = if #mode == OutputMode.output then Display.visible else Display.hidden
        for link on path-opened
            open-link(link)
    <Box • flex-col flex:1
        display = if #mode == OutputMode.probes then Display.visible else Display.hidden
        if #feed != null
            <ProbeLines • flex:1
                feed = #feed!
                filter = #filter-text
                for line on opened
                    open-probe(line)
        else
            <Box • flex:1 items-center
                justify = Justify.center
                <Label • output-note
                    text = "Run a Brix program to see the probes it records."
        if #counters.length > 0
            <Label • output-note px:10 py:4
                text = #counters
    <Resizer
        edge = Side.top
        min-size = 90
        max-size = 700
        state-key = "editor.output"

────────────────────
_ do open-link
    - link TerminalPathLink

. line = link.line
if line != null && line > 0
    workspace.open-path(Path(link.path, 0), EditorJump(line - 1, if (link.column ?? 0) > 0 then link.column! - 1 else null))
else
    workspace.open-path(Path(link.path, 0))

────────────────────
_ do open-probe
    - line ProbeLine

=? if line.path.length == 0
. path = if line.path.starts-with("/") then Path(line.path, 0) else (runner.source?.parent ?? Path("/", 0)) / line.path
workspace.open-path(path, EditorJump(if line.line > 0 then (line.line - 1) as Size else 0, null))
