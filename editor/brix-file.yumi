/code/code-document
/code/structure/document
/code/structure/session
/lang/brix/brix
/os/file
/os/path
/time/debounced
/time/duration

+ brix-file-watch-delay = 100ms

━━━━━━━━━━━━━━━━━━━━
+ BrixFile
    is Closable

+ path Path
+ session SourceSession
+ is-changed-on-disk = false
+ is-missing = false

_ disk-text String
_ watcher Closable?
_ watched-path = ""
_ schedule-reload := throttled(brix-file-watch-delay, this.reload)

────────────────────
+ This
    - path
    - text String
    - document SourceDocument

.. session = SourceSession(document)
disk-text = text

────────────────────
+ do save Bool

if is-missing
    catch path.parent?.make-directories()
=? false if !source-write-text(session, "$path")
disk-text = session.document.text()
is-changed-on-disk = false
is-missing = false
= true

────────────────────
+ do reload
    - discards = false

if !path.exists
    is-missing = true
    =
is-missing = false
. text = code-read-text(path)
if text == null
    is-changed-on-disk = true
    =
if !discards && session.is-modified
    is-changed-on-disk = text != disk-text
    =
=? if !discards && text == disk-text
. read = catch brix-document-read(text)
if read is Error
    is-changed-on-disk = true
    =
. next = SourceSession(read as SourceDocument)
next.place(session.row, session.column)
. previous = session
session = next
disk-text = text
is-changed-on-disk = false
previous.document.release()

────────────────────
+ do watch ?! Error

=? if watcher
. resolved = catch? path.resolved ?? path
watched-path = "$resolved"
. folder = resolved.parent ?? resolved
watcher = listen-for-changes(folder.watch() as Broadcastable'PathWatchEvent, this.note)

────────────────────
+ do close

. stream = watcher
watcher = null
if stream
    stream.close()
session.document.release()

────────────────────
_ do note
    - event PathWatchEvent

if event.must-rescan || "${event.path}" == watched-path
    schedule-reload()
