(import /net/http)
(import /net/http-server)
(import /net/url)
(blank)

(main
  (<> HTTPServer (id: server)
    (= port 0)
    (blank)
    (<> Route (text: "/greeting")
      (= get greeting)
    )
  )
  (blank)
  (call (. server start))
  (let response (call http-get (call URL (str "http://127.0.0.1:" (. server port) "/greeting"))))
  (print (. response status))
  (print (. response text))
  (call (. server close))
)

(fn-expr _ greeting HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) (str "hello from " (. request path)))
)
