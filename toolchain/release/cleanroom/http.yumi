/net/http
/net/http-server
/net/url

<HTTPServer server
    port = 0

    <Route "/greeting"
        get = greeting

server.start()
. response = http-get(URL("http://127.0.0.1:${server.port}/greeting"))
-- response.status
-- response.text
server.close()

━━━━━━━━━━━━━━━━━━━━
_ greeting HTTPResponse
    - request HTTPRequest

HTTPResponse(HTTPStatus.ok, "hello from ${request.path}")
