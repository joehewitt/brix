{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyDeletes",
            "Effect": "Deny",
            "Principal": "*",
            "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
            "Resource": "arn:aws:s3:::joehewitt-brix-releases/*"
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": ["arn:aws:s3:::joehewitt-brix-releases", "arn:aws:s3:::joehewitt-brix-releases/*"],
            "Condition": {"Bool": {"aws:SecureTransport": "false"}}
        }
    ]
}
