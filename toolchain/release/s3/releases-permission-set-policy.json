{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListReleases",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::joehewitt-brix-releases"
        },
        {
            "Sid": "ReadAndAddReleases",
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject"],
            "Resource": "arn:aws:s3:::joehewitt-brix-releases/*"
        }
    ]
}
