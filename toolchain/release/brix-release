    status, output = vm.run_in(name, ['python3', '%s/%s' % (GATE_ROOT, os.path.basename(LINUX_GATE)), GATE_ROOT,
                                      version], capture=True)
    log_path = os.path.join(logs, 'linux-gate.log')
    with open(log_path, 'w') as log:
        log.write(output)
    vm.limactl('stop', name)
    lines = [line for line in output.splitlines() if line.startswith('{')]
    if status != 0 or not lines:
        raise Failure('The Linux checks in %s failed:\n%s\nSee %s' % (name, log_tail(log_path), log_path))
    return json.loads(lines[-1])


def store(version, assembled):
    archives = os.path.join(BRIX_HOME, 'archives')
    releases = os.path.join(BRIX_HOME, 'releases')
    seeds = os.path.join(BRIX_HOME, 'seeds')
    for directory in (archives, releases, seeds):
        os.makedirs(directory, exist_ok=True)
        if os.path.exists(os.path.join(directory, version)):
            raise Failure('%s already exists; a release is never replaced' % os.path.join(directory, version))

    staged = launcher.staging_directory(archives, version)
    for path in assembled['files']:
        shutil.copy2(path, os.path.join(staged, os.path.basename(path)))
    launcher.publish(staged, os.path.join(archives, version))
    with open(assembled['release']) as file:
        release = json.load(file)
    launcher.install_toolchain(version, release)
    launcher.install_seed(version, release)

    current = os.path.join(BRIX_HOME, 'current')
    link = '%s.%d' % (current, os.getpid())
    os.symlink(os.path.join('releases', version), link)
    os.replace(link, current)


def update_manifests(version, release_hash):
    paths = [os.path.join(ROOT, MANIFEST_NAME)]
    config = launcher.read_config()
    paths += [os.path.join(os.path.expanduser(repo), MANIFEST_NAME) for repo in config.get('followLatest', [])]
    updated = []
    for path in paths:
        if not os.path.isfile(path):
            continue
        with open(path) as file:
            pinned = json.load(file).get('version')
        if pinned and version_key(pinned) > version_key(version):
            continue
        write_manifest(path, version, release_hash)
        updated.append(path)
    return updated


def write_manifest(path, version, release_hash, use=None):
    existing = {}
    if os.path.isfile(path):
        with open(path) as file:
            existing = json.load(file)
    manifest = {
        'version': version,
        'release': release_hash,
        'use': use or existing.get('use', 'toolchain'),
    }
    for name, value in existing.items():
        manifest.setdefault(name, value)
    launcher.write_json(path, manifest)
    return manifest


def setup():
    for name in ('archives', 'releases', 'seeds', 'bin'):
        os.makedirs(os.path.join(BRIX_HOME, name), exist_ok=True)
    installed = os.path.join(BRIX_HOME, 'bin', 'brix')
    temporary = '%s.%d' % (installed, os.getpid())
    shutil.copyfile(LAUNCHER_SOURCE, temporary)
    os.chmod(temporary, 0o755)
    os.replace(temporary, installed)
    lines = ['Installed the launcher as %s' % installed]
    config_path = launcher.config_path()
    if os.path.isfile(config_path):
        lines.append('Kept %s' % config_path)
    else:
        launcher.write_json(config_path, {'followLatest': []})
        lines.append('Wrote %s' % config_path)
    directories = [os.path.realpath(part) for part in os.environ.get('PATH', '').split(':') if part]
    if os.path.dirname(installed) not in directories:
        lines.append('Add %s to PATH to run the launcher as brix' % os.path.dirname(installed))
    say('\n'.join(lines))


def pin(version, use, repo):
    release = archived_release(version)
    release_path = os.path.join(launcher.archives_path(), version, 'release.json')
    path = os.path.join(os.path.realpath(repo), MANIFEST_NAME)
    manifest = write_manifest(path, version, file_digest(release_path), use)
    say('Pinned %s to %s, for %s' % (path, version, manifest['use']))


def archived_release(version):
    if not launcher.VERSION_PATTERN.fullmatch(version):
        raise Failure('%s is not a version; versions look like 2026.10.23-1' % version)
    release_path = os.path.join(launcher.archives_path(), version, 'release.json')
    if not os.path.isfile(release_path):
        launcher.fetch_release(version, recorded_release(version))
    with open(release_path) as file:
        return json.load(file)


def upload(version):
    archive = os.path.join(launcher.archives_path(), version)
    release_path = os.path.join(archive, 'release.json')
    if not os.path.isfile(release_path):
        raise Failure('Release %s is not in %s' % (version, launcher.archives_path()))
    with open(release_path) as file:
        release = json.load(file)
    commit = release['source']['commit']
    if not is_on_main(commit):
        raise Failure('%s was built from %s, which is not on %s/%s, so it is not uploaded' % (
            version, commit[:12], MAIN_REMOTE, MAIN_BRANCH))
    release_hash = file_digest(release_path)
    files = []
    for host in release['hosts'].values():
        files += [(package['file'], package['sha256'], package['size']) for package in host['packages']]
    for name in (LAUNCHER_FILE, INSTALLER_FILE):
        path = os.path.join(archive, name)
        files.append((name, file_digest(path), os.path.getsize(path)))
    files.append(('release.json', release_hash, os.path.getsize(release_path)))
    try:
        for host in release['hosts'].values():
            for kit in host['kits'] + host['sourceKits']:
                say('Uploading the %s kit' % kit['file'])
                put_once('%s/%s' % (launcher.KITS_PREFIX, kit['file']), launcher.kit_archive(kit['file']), kit['sha256'])
        for name, digest, size in files:
            say('Uploading %s' % name)
            put_once(launcher.release_key(version, name), os.path.join(archive, name), digest)
        say('Reading back %s from S3' % version)
        for name, digest, size in files:
            if launcher.s3_download(launcher.release_key(version, name)) != (digest, size):
                raise Failure('%s in S3 does not match the archive' % name)
        say('Recording %s' % version)
        record_release(version, release, release_hash)
        update_latest(LAUNCHER_KEY, LAUNCHER_SOURCE, 'text/x-python')
        update_latest(INSTALLER_KEY, os.path.join(archive, INSTALLER_FILE), 'text/x-python')
    except (Failure, launcher.LaunchError, OSError) as error:
        raise Failure('%s\n%s is stored in %s but its upload is incomplete; rerun: toolchain/release/brix-release '
                           'upload %s' % (error, version, archive, version))
    return release, release_hash


def update_latest(key, path, kind):
    with open(path, 'rb') as file:
        source = file.read()
    existing = launcher.s3_head(key, {'x-amz-checksum-mode': 'ENABLED'}) or {}
    if existing.get('x-amz-checksum-sha256') != base64.b64encode(hashlib.sha256(source).digest()).decode():
        say('Uploading the latest %s' % key)
        launcher.s3_put(key, source, kind)


def put_once(key, path, digest):
    with open(path, 'rb') as file:
        body = file.read()
    try:
        launcher.s3_put(key, body, content_type(path), {'if-none-match': '*'})
    except launcher.S3Error as error:
        if error.status != 412:
            raise
        existing = launcher.s3_head(key, {'x-amz-checksum-mode': 'ENABLED'}) or {}
        if existing.get('x-amz-checksum-sha256') != base64.b64encode(bytes.fromhex(digest)).decode():
            raise Failure('A different s3://%s/%s already exists; a release is never replaced'
                               % (launcher.RELEASES_BUCKET, key))


def content_type(path):
    if path.endswith('.json'):
        return 'application/json'
    if path.endswith('.xz'):
        return 'application/x-xz'
    return 'application/octet-stream'


def record_release(version, release, release_hash):
    try:
        body, etag = launcher.s3_read(INDEX_KEY)
        index = json.loads(body)
        condition = {'if-match': etag}
    except launcher.S3Error as error:
        if error.status != 404:
            raise
        index = {'releases': []}
        condition = {'if-none-match': '*'}
    recorded = [entry for entry in index['releases'] if entry['version'] == version]
    if recorded and recorded[0]['release'] != release_hash:
        raise Failure('The S3 index records a different %s (%s)' % (version, recorded[0]['release']))
    if not recorded:
        index['releases'].append(index_entry(version, release, release_hash))
        index['releases'].sort(key=lambda entry: version_key(entry['version']))
        launcher.s3_put(INDEX_KEY, (json.dumps(index, indent=4) + '\n').encode(), 'application/json', condition)
    launcher.write_json(RELEASES_RECORD, index)


def version_key(version):
    date, counter = version.rsplit('-', 1)
    return date, int(counter)


def recorded_releases():
    if not os.path.isfile(RELEASES_RECORD):
        return []
    with open(RELEASES_RECORD) as file:
        return json.load(file)['releases']


def recorded_release(version):
    for entry in recorded_releases():
        if entry['version'] == version:
            return entry['release']
    if os.path.isfile(MANIFEST):
        manifest = launcher.read_manifest(MANIFEST)
        if manifest['version'] == version:
            return manifest['release']
    raise Failure('%s is not recorded in %s or pinned in %s' % (version, RELEASES_RECORD, MANIFEST))


def fetch(version):
    archive = os.path.join(launcher.archives_path(), version)
    if os.path.isdir(archive):
        say('%s is already in %s' % (version, launcher.archives_path()))
        return
    launcher.fetch_release(version, recorded_release(version))
    say('Fetched %s into %s' % (version, archive))


def relink(version):
    release = archived_release(version)
    host = launcher.release_host(release)
    toolchain = launcher.package_path(version, release, 'toolchain')
    kit = launcher.package_path(version, release, 'relink')
    kits = [(entry, launcher.fetch_kit(entry['file'], entry['sha256'])) for entry in host['kits']]
    launcher.install_toolchain(version, release)
    launcher.install_seed(version, release)
    logs = tempfile.mkdtemp(prefix='brix-relink-logs-')
    with temporary_directory('brix-relink-') as room:
        say('Relinking %s from its relink kit' % version)
        output = relink_binary(toolchain, kit, kits, room, denied_paths(), logs)
        if file_digest(os.path.join(room, 'obj', 'brix.o')) != host['hashes']['obj/brix.o']:
            raise Failure('The relink kit of %s holds an object that release.json does not record' % version)
        relinked = file_digest(output)
        expected = host['hashes']['bin/brix']
        if relinked == expected:
            restored = restore_binaries(version, output, expected)
            lines = ['Relinked %s into the released binary, sha256 %s' % (version, relinked)]
            lines += ['  restored %s' % path for path in restored] or ['  both copies were intact']
        else:
            installed = install_relinked(version, release, output, relinked)
            lines = ['Relinked %s with today\'s linker into a new binary, sha256 %s, not %s' % (
                version, relinked, expected)]
            lines += ['  installed %s, which the launcher now runs' % path for path in installed]
            lines.append('  the originals are kept')
    launcher.remove_tree(logs)
    say('\n'.join(lines))


def release_binaries(version):
    return [
        (os.path.join(BRIX_HOME, 'releases', version), os.path.join('bin', 'brix')),
        (os.path.join(BRIX_HOME, 'seeds', version), 'brix'),
    ]


def restore_binaries(version, output, expected):
    restored = []
    with launcher.install_lock():
        for directory, name in release_binaries(version):
            path = os.path.join(directory, name)
            if os.path.isfile(path) and file_digest(path) == expected:
                continue
            with writable(os.path.dirname(path)):
                temporary = '%s.%d' % (path, os.getpid())
                shutil.copyfile(output, temporary)
                os.chmod(temporary, 0o555)
                os.replace(temporary, path)
            restored.append(path)
    return restored


def install_relinked(version, release, output, digest):
    record = {
        'sha256': digest,
        'object': launcher.release_host(release)['hashes']['obj/brix.o'],
        'toolchain': toolchain_versions(),
        'relinked': time.strftime(launcher.TIME_FORMAT, time.gmtime()),
    }
    installed = []
    with launcher.install_lock():
        for directory, name in release_binaries(version):
            relinked = os.path.join(directory, 'relinked')
            with writable(directory):
                launcher.remove_tree(relinked)
                os.makedirs(relinked)
                shutil.copyfile(output, os.path.join(relinked, 'brix'))
                os.chmod(os.path.join(relinked, 'brix'), 0o755)
                launcher.write_json(os.path.join(relinked, 'relink.json'), record)
                launcher.make_read_only(relinked)
            installed.append(os.path.join(relinked, 'brix'))
    return installed


@contextlib.contextmanager
def writable(directory):
    mode = stat.S_IMODE(os.stat(directory).st_mode)
    os.chmod(directory, mode | stat.S_IWUSR)
    try:
        yield
    finally:
        os.chmod(directory, mode)


def verify(versions):
    archives = launcher.archives_path()
    if not versions and os.path.isdir(archives):
        names = [name for name in os.listdir(archives) if launcher.VERSION_PATTERN.fullmatch(name)]
        versions = sorted(names, key=version_key)
    if not versions:
        say('No releases in %s' % archives)
        return
    failed = []
    for version in versions:
        try:
            problems, hints, checked = verify_release(version)
        except launcher.LaunchError as error:
            say('%s: not checked: %s' % (version, error))
            continue
        if problems:
            failed.append(version)
            say('%s: %d problem%s' % (version, len(problems), '' if len(problems) == 1 else 's'))
            say('\n'.join('  %s' % line for line in problems + hints))
        else:
            say('%s: ok, %s' % (version, ', '.join(checked)))
    if failed:
        raise Failure('%s failed verification' % ', '.join(failed))


def verify_release(version):
    archive = os.path.join(launcher.archives_path(), version)
    release_path = os.path.join(archive, 'release.json')
    if not os.path.isfile(release_path):
        return ['%s is missing' % release_path], ['refill it with: toolchain/release/brix-release fetch %s' % version], []
    problems = []
    hints = []
    checked = []
    digest = file_digest(release_path)
    try:
        recorded = recorded_release(version)
    except Failure:
        recorded = None
    if recorded is None:
        checked.append('release.json unrecorded')
    elif recorded != digest:
        problems.append('%s has sha256 %s, but the record says %s' % (release_path, digest, recorded))
    else:
        checked.append('release.json as recorded')
    with open(release_path) as file:
        release = json.load(file)
    host = launcher.release_host(release)
    for package in host['packages']:
        problems += file_problems(os.path.join(archive, launcher.package_file(package)), package['sha256'],
                                  package['size'])
    checked.append('%d packages' % len(host['packages']))
    if problems:
        hints.append('move %s aside, then refill it with: toolchain/release/brix-release fetch %s' % (archive, version))
        return problems, hints, checked
    for directory, name in release_binaries(version):
        if not os.path.isdir(directory):
            continue
        found = []
        if name == 'brix':
            found += file_problems(os.path.join(directory, name), host['hashes']['bin/brix'])
            checked.append('the seed')
        else:
            found += file_problems(os.path.join(directory, 'release.json'), digest)
            count, unpacked = unpacked_problems(launcher.package_path(version, release, 'toolchain'), directory)
            found += unpacked
            checked.append('%d unpacked files' % count)
        record_path = os.path.join(directory, 'relinked', 'relink.json')
        if os.path.isfile(record_path):
            with open(record_path) as file:
                record = json.load(file)
            if record['object'] != host['hashes']['obj/brix.o']:
                found.append('%s relinked a different object, %s' % (record_path, record['object']))
            found += file_problems(os.path.join(directory, 'relinked', 'brix'), record['sha256'])
            checked.append('the relinked %s' % ('seed' if name == 'brix' else 'toolchain binary'))
        if found:
            problems += found
            hints.append('move %s aside, and the launcher unpacks it again' % directory)
    return problems, hints, checked


def unpacked_problems(package, root):
    problems = []
    count = 0
    with tarfile.open(package, 'r:xz') as archive:
        for member in archive:
            if member.isfile():
                count += 1
                problems += file_problems(os.path.join(root, member.name),
                                          launcher.stream_digest(archive.extractfile(member)))
    return count, problems


def file_problems(path, digest, size=None):
    if not os.path.isfile(path):
        return ['%s is missing' % path]
    if size is not None and os.path.getsize(path) != size:
        return ['%s is %d bytes, not %d' % (path, os.path.getsize(path), size)]
    found = file_digest(path)
    if found != digest:
        return ['%s has sha256 %s, not %s' % (path, found, digest)]
    return []


def report(version, assembled, updated, commit):
    lines = ['Released %s' % version]
    lines.append('  release.json %s' % assembled['hash'])
    archive = os.path.join(BRIX_HOME, 'archives', version)
    for path in assembled['files']:
        stored = os.path.join(archive, os.path.basename(path))
        lines.append('  %s (%.1f MB)' % (os.path.basename(path), os.path.getsize(stored) / 1e6))
    for entry, archive_path in assembled['kits']:
        lines.append('  kit %s (%.1f MB)' % (entry['file'], entry['size'] / 1e6))
    lines.append('  stored in %s' % archive)
    say('\n'.join(lines + published_lines(version, updated, commit)))


def published_lines(version, updated, commit):
    lines = ['  uploaded to s3://%s/%s/%s/' % (launcher.RELEASES_BUCKET, launcher.RELEASES_PREFIX, version)]
    if updated:
        lines += ['  updated %s' % path for path in updated]
    else:
        lines.append('  no manifests to update')
    if commit:
        lines.append('  committed as %s "Release %s", tagged %s, and pushed %s' % (
            commit[:12], version, release_tag(version), MAIN_BRANCH))
    else:
        lines.append('  nothing to commit')
    return lines


