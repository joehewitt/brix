DOWNLOADS = os.path.join(BRIX_HOME, 'downloads')
RECORD_NAME = 'download.json'
EDITOR = 'editor'
UPLOAD = 'upload'
EDITOR_SOURCE = os.path.join(ROOT, 'apps', 'editor', 'editor-app.yumi')
EDITOR_NAME = 'Brix Editor'
EDITOR_FILE = 'Brix-Editor'
EDITOR_PREFIX = launcher.RELEASES_PREFIX + '/editor'
LATEST_KEY = EDITOR_PREFIX + '/latest.json'
IMAGE_TYPE = 'application/x-apple-diskimage'
NOTARY_PROFILE = 'brix-notary'
LICENSE_SOURCE = os.path.join(ROOT, 'LICENSE')
NOTICES_NAME = 'THIRD-PARTY-NOTICES'
LICENSE_FILE = re.compile(r'^(LICEN[CS]E|COPYING|COPYRIGHT|NOTICE)', re.IGNORECASE)
LSREGISTER = ('/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/'
              'lsregister')
DEVELOPER_ID = 'Developer ID Application'
IDENTITY_LINE = re.compile(r'^\s*\d+\) [0-9A-F]{40} "(.+)"$')
MINIMUM_SYSTEM = re.compile(r'^\s*minos (\S+)$', re.MULTILINE)
THIN_MAGICS = (b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe')
FAT_MAGIC = b'\xca\xfe\xba\xbe'
FAT_MAGIC_64 = b'\xca\xfe\xba\xbf'
SIGNED_FILE_TYPES = (2, 6, 8)
MOST_FAT_SLICES = 16
IMAGE_FORMAT = 'ULMO'
IMAGE_FILE_SYSTEM = 'HFS+'
WINDOW_ORIGIN = (200, 200)
WINDOW_SIZE = (640, 400)
ICON_SIZE = 128
TEXT_SIZE = 13
ICON_ROW = 170
APP_COLUMN = 170
APPLICATIONS_COLUMN = 470
STORE_NAME = '.DS_Store'
STORE_PREFIX = b'\0\0\0\1'
STORE_MAGIC = b'Bud1'
STORE_HEADER_TAIL = 0x100c
STORE_INFO = (0x2000, 11)
STORE_DIRECTORY = (0x40, 5)
STORE_NODE = (0x1000, 12)
STORE_FREE = {5: (0x20, 0x60), 7: (0x80,), 8: (0x100,), 9: (0x200,), 10: (0x400,), 11: (0x800, 0x2800), 12: (0x3000,)}
STORE_FREE.update((size, (1 << size,)) for size in range(14, 31))
STORE_FREE_LISTS = 32
STORE_ADDRESSES = 256
STORE_PAGE = 0x1000
ICON_LOCATION_TAIL = b'\xff' * 6 + b'\0\0'


def main(arguments):
    parser = argparse.ArgumentParser(
        prog='brix-downloads',
        description='Package the downloads the website offers, into %s' % DOWNLOADS)
    commands = parser.add_subparsers(dest='command', required=True)
    editor_command = commands.add_parser(
        EDITOR, help='Build %s, sign and notarize it, and make its disk image' % EDITOR_NAME)
    editor_command.add_argument(
        '--identity', help='the signing identity; the one "%s" identity in the keychain by default, or ad hoc '
                           'when there is none' % DEVELOPER_ID)
    editor_command.add_argument(
        '--notary-profile', metavar='PROFILE', default=NOTARY_PROFILE,
        help='the notarytool keychain profile to notarize and staple the disk image with (default: %(default)s)')
    editor_command.add_argument(
        '--no-notarize', dest='notarizes', action='store_false', help='sign but do not notarize, for testing')
    editor_command.add_argument(
        '--allow-changes', action='store_true', help='package a checkout with uncommitted changes, for testing')
    upload_command = commands.add_parser(
        UPLOAD, help='Upload a packaged %s and make it the latest, which editors offer as an update' % EDITOR_NAME)
    upload_command.add_argument(
        'version', nargs='?', help='the package to upload; the newest in %s by default' % os.path.join(DOWNLOADS, EDITOR))
    options = parser.parse_args(arguments)
    try:
        if options.command == EDITOR:
            package_editor(options)
        elif options.command == UPLOAD:
            upload_editor(options)
    except launcher.LaunchError as error:
        raise Failure(str(error))


def package_editor(options):
    os.makedirs(DOWNLOADS, exist_ok=True)
    with open(os.path.join(DOWNLOADS, '.lock'), 'w') as file:
        if not lock(file, wait=False):
            raise Failure('Another download is being packaged (%s is locked)' % file.name)
        source = source_state(options.allow_changes)
        identity = signing_identity(options.identity)
        notary_profile = options.notary_profile if options.notarizes and identity != '-' else None
        version = next_version(os.path.join(DOWNLOADS, EDITOR))
        work = os.path.join(TMP, 'downloads', '%s-%s' % (EDITOR, version))
        launcher.remove_tree(work)
        os.makedirs(work)
        say('Packaging %s %s from %s%s, signed %s' % (
            EDITOR_NAME, version, source['commit'][:12], ' and uncommitted changes' if source['changed'] else '',
            'ad hoc' if identity == '-' else 'by ' + identity))
        try:
            record = assemble_editor(version, source, identity, notary_profile, work)
        except (Failure, launcher.LaunchError, OSError) as error:
            raise Failure('%s\nThe work is kept in %s' % (error, work))
        launcher.remove_tree(work)
    report(record)


def assemble_editor(version, source, identity, notary_profile, work):
    logs = os.path.join(work, 'logs')
    os.makedirs(logs)
    stage = os.path.join(work, 'image')
    os.makedirs(stage)
    app = os.path.join(stage, EDITOR_NAME + '.app')
    say('Building %s' % EDITOR_NAME)
    os.rename(build_editor(work, logs), app)
    strip_debug(app)
    add_licenses(app)
    minimum_system = stamp_bundle(app, version)
    say('Signing')
    sign_bundle(app, identity)
    os.symlink('/Applications', os.path.join(stage, 'Applications'))
    folder = os.path.join(DOWNLOADS, EDITOR, version)
    image = os.path.join(folder, '%s-%s.dmg' % (EDITOR_FILE, version))
    os.makedirs(folder)
    try:
        say('Making the disk image')
        write_image(stage, image)
        notarized = False
        if identity != '-':
            command_output(['/usr/bin/codesign', '--force', '--timestamp', '--sign', identity, image])
            if notary_profile:
                say('Notarizing')
                notarize(image, notary_profile)
                notarized = True
        record = {
            'name': EDITOR_NAME,
            'version': version,
            'file': os.path.basename(image),
            'size': os.path.getsize(image),
            'sha256': file_digest(image),
            'built': datetime.datetime.now(datetime.timezone.utc).strftime(launcher.TIME_FORMAT),
            'source': source,
            'minimumSystem': minimum_system,
            'signature': 'ad hoc' if identity == '-' else identity,
            'notarized': notarized,
        }
        launcher.write_json(os.path.join(folder, RECORD_NAME), record)
    except BaseException:
        launcher.remove_tree(folder)
        raise
    record['path'] = image
    return record


def source_state(allow_changes):
    changes = git('status', '--porcelain', '--untracked-files=all', '--', '.')
    if changes and not allow_changes:
        listed = '\n'.join(changes.splitlines()[:20])
        raise Failure('The checkout has uncommitted changes; commit them, or pass --allow-changes to package '
                      'them for testing:\n%s' % listed)
    return {'commit': git('rev-parse', 'HEAD'), 'tree': git('rev-parse', 'HEAD^{tree}'), 'changed': bool(changes)}


def git(*arguments):
    result = subprocess.run(['git'] + list(arguments), cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True)
    if result.returncode != 0:
        raise Failure('git %s failed:\n%s' % (' '.join(arguments), result.stderr.strip()))
    return result.stdout.rstrip()


def version_key(version):
    date, counter = version.rsplit('-', 1)
    return date, int(counter)


def next_version(folder):
    date = datetime.date.today().strftime('%Y.%m.%d')
    taken = os.listdir(folder) if os.path.isdir(folder) else []
    published = published_editor()
    if published:
        taken.append(published['version'])
    counters = [int(name[len(date) + 1:]) for name in taken
                if name.startswith(date + '-') and name[len(date) + 1:].isdigit()]
    return '%s-%d' % (date, max(counters, default=0) + 1)


def published_editor():
    with tempfile.TemporaryDirectory() as directory:
        path = os.path.join(directory, 'latest.json')
        try:
            launcher.fetch_object(LATEST_KEY, path)
        except launcher.DownloadError as error:
            if error.status == 404:
                return None
            raise Failure('Cannot read the published %s: %s' % (LATEST_KEY, error))
        with open(path) as file:
            return json.load(file)


def signing_identity(identity):
    if identity:
        return identity
    listed = command_output(['/usr/bin/security', 'find-identity', '-v', '-p', 'codesigning'])
    found = []
    for line in listed.splitlines():
        match = IDENTITY_LINE.match(line)
        if match and match.group(1).startswith(DEVELOPER_ID + ':') and match.group(1) not in found:
            found.append(match.group(1))
    if len(found) > 1:
        raise Failure('The keychain holds several %s identities; pass one with --identity:\n%s' % (
            DEVELOPER_ID, '\n'.join(found)))
    return found[0] if found else '-'


def build_editor(work, logs):
    output = os.path.join(work, 'build', 'editor-app')
    os.makedirs(os.path.dirname(output))
    log = os.path.join(logs, 'build.log')
    with open(log, 'w') as file:
        result = subprocess.run(
            [os.path.join(ROOT, 'bin', 'brix'), EDITOR_SOURCE, '--compile', '--claims-documents', '-o', output],
            cwd=ROOT, stdout=file, stderr=subprocess.STDOUT)
    bundle = os.path.join(os.path.dirname(output), EDITOR_NAME + '.app')
    if os.path.isdir(bundle):
        subprocess.run([LSREGISTER, '-u', bundle], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if result.returncode != 0:
        raise Failure('Building %s failed:\n%s' % (EDITOR_NAME, log_tail(log)))
    if not os.path.isdir(bundle):
        raise Failure('Building %s made no %s' % (EDITOR_NAME, bundle))
    return bundle


def stamp_bundle(app, version):
    info_path = os.path.join(app, 'Contents', 'Info.plist')
    with open(info_path, 'rb') as file:
        info = plistlib.load(file)
    executable = os.path.join(app, 'Contents', 'MacOS', info['CFBundleExecutable'])
    found = MINIMUM_SYSTEM.search(command_output(['/usr/bin/xcrun', 'vtool', '-show-build', executable]))
    if not found:
        raise Failure('%s names no minimum macOS version' % executable)
    info['CFBundleShortVersionString'] = version
    info['CFBundleVersion'] = version
    info['LSMinimumSystemVersion'] = found.group(1)
    with open(info_path, 'wb') as file:
        plistlib.dump(info, file)
    return found.group(1)


def add_licenses(app):
    resources = os.path.join(app, 'Contents', 'Resources')
    os.makedirs(resources, exist_ok=True)
    shutil.copyfile(LICENSE_SOURCE, os.path.join(resources, 'LICENSE'))
    with open(os.path.join(resources, NOTICES_NAME), 'w') as file:
        file.write(third_party_notices())


def third_party_notices():
    sections = ['%s is built with the third-party software below, under the licenses that follow.' % EDITOR_NAME]
    for name in deps.recipe_order(deps.default_recipe_names()):
        kit, key = deps.dependency_kit(name)
        found = sorted(entry for entry in os.listdir(kit)
                       if LICENSE_FILE.match(entry) and os.path.isfile(os.path.join(kit, entry)))
        if not found:
            raise Failure('The %s kit at %s holds no license file' % (name, kit))
        license = deps.read_recipe(name).get('license', 'see below')
        for entry in found:
            with open(os.path.join(kit, entry), errors='replace') as source:
                text = source.read().strip()
            sections.append('%s\n%s (%s): %s\n%s\n\n%s' % ('=' * 78, name, license, entry, '=' * 78, text))
    return '\n\n'.join(sections) + '\n'


def strip_debug(app):
    for path in signed_files(os.path.join(app, 'Contents')):
        command_output(['/usr/bin/xcrun', 'strip', '-S', path])


def sign_bundle(app, identity):
    timestamp = '--timestamp=none' if identity == '-' else '--timestamp'
    arguments = ['/usr/bin/codesign', '--force', '--options', 'runtime', timestamp, '--sign', identity]
    with open(os.path.join(app, 'Contents', 'Info.plist'), 'rb') as file:
        executable = os.path.join(app, 'Contents', 'MacOS', plistlib.load(file)['CFBundleExecutable'])
    nested = [path for path in signed_files(os.path.join(app, 'Contents')) if path != executable]
    if nested:
        command_output(arguments + nested)
    command_output(arguments + [app])
    command_output(['/usr/bin/codesign', '--verify', '--deep', '--strict', app])


def signed_files(root):
    found = []
    for directory, directories, names in os.walk(root):
        directories.sort()
        for name in sorted(names):
            path = os.path.join(directory, name)
            if not os.path.islink(path) and mach_file_type(path) in SIGNED_FILE_TYPES:
                found.append(path)
    return found


def mach_file_type(path):
    with open(path, 'rb') as file:
        header = file.read(8)
        if header[:4] in THIN_MAGICS:
            return thin_file_type(file, 0)
        if header[:4] not in (FAT_MAGIC, FAT_MAGIC_64) or len(header) < 8:
            return None
        count = struct.unpack('>I', header[4:8])[0]
        if count == 0 or count > MOST_FAT_SLICES:
            return None
        if header[:4] == FAT_MAGIC:
            slice = file.read(20)
            offset = struct.unpack('>I', slice[8:12])[0] if len(slice) == 20 else None
        else:
            slice = file.read(32)
            offset = struct.unpack('>Q', slice[8:16])[0] if len(slice) == 32 else None
        return None if offset is None else thin_file_type(file, offset)


def thin_file_type(file, offset):
    file.seek(offset)
    header = file.read(16)
    if len(header) < 16 or header[:4] not in THIN_MAGICS:
        return None
    return struct.unpack('<I', header[12:16])[0]


def write_image(stage, image):
    with open(os.path.join(stage, STORE_NAME), 'wb') as file:
        file.write(window_store(EDITOR_NAME + '.app'))
    command_output(['/usr/bin/hdiutil', 'create', '-quiet', '-volname', EDITOR_NAME, '-fs', IMAGE_FILE_SYSTEM,
                    '-format', IMAGE_FORMAT, '-srcfolder', stage, image])


def window_store(app_name):
    left, top = WINDOW_ORIGIN
    width, height = WINDOW_SIZE
    window = {
        'ContainerShowSidebar': False,
        'ShowSidebar': False,
        'ShowStatusBar': False,
        'ShowTabView': False,
        'ShowToolbar': False,
        'WindowBounds': '{{%d, %d}, {%d, %d}}' % (left, top, width, height),
    }
    icons = {
        'arrangeBy': 'none',
        'backgroundColorBlue': 1.0,
        'backgroundColorGreen': 1.0,
        'backgroundColorRed': 1.0,
        'backgroundType': 0,
        'gridOffsetX': 0.0,
        'gridOffsetY': 0.0,
        'gridSpacing': 100.0,
        'iconSize': float(ICON_SIZE),
        'labelOnBottom': True,
        'showIconPreview': True,
        'showItemInfo': False,
        'textSize': float(TEXT_SIZE),
        'viewOptionsVersion': 1,
    }
    records = [
        ('.', b'bwsp', b'blob', plistlib.dumps(window, fmt=plistlib.FMT_BINARY)),
        ('.', b'icvp', b'blob', plistlib.dumps(icons, fmt=plistlib.FMT_BINARY)),
        ('.', b'vSrn', b'long', struct.pack('>I', 1)),
        ('.', b'vstl', b'type', b'icnv'),
        ('Applications', b'Iloc', b'blob', icon_location(APPLICATIONS_COLUMN, ICON_ROW)),
        (app_name, b'Iloc', b'blob', icon_location(APP_COLUMN, ICON_ROW)),
    ]
    records.sort(key=lambda record: (record[0].lower(), record[1]))
    node = struct.pack('>II', 0, len(records)) + b''.join(store_record(*record) for record in records)
    if len(node) > 1 << STORE_NODE[1]:
        raise Failure('The disk image\'s %s outgrew its one node' % STORE_NAME)
    blocks = [STORE_INFO, STORE_DIRECTORY, STORE_NODE]
    info = struct.pack('>II', len(blocks), 0)
    info += b''.join(struct.pack('>I', offset | size) for offset, size in blocks).ljust(4 * STORE_ADDRESSES, b'\0')
    info += struct.pack('>IB', 1, 4) + b'DSDB' + struct.pack('>I', 1)
    for size in range(STORE_FREE_LISTS):
        free = STORE_FREE.get(size, ())
        info += struct.pack('>I%dI' % len(free), len(free), *free)
    store = bytearray(STORE_INFO[0] + (1 << STORE_INFO[1]))
    store[:20] = STORE_MAGIC + struct.pack('>IIII', STORE_INFO[0], 1 << STORE_INFO[1], STORE_INFO[0], STORE_HEADER_TAIL)
    place(store, STORE_DIRECTORY, struct.pack('>5I', 2, 0, len(records), 1, STORE_PAGE))
    place(store, STORE_NODE, node)
    place(store, STORE_INFO, info)
    return STORE_PREFIX + bytes(store)


def store_record(name, code, kind, value):
    encoded = name.encode('utf-16-be')
    data = struct.pack('>I', len(value)) + value if kind == b'blob' else value
    return struct.pack('>I', len(encoded) // 2) + encoded + code + kind + data


def icon_location(x, y):
    return struct.pack('>II', x, y) + ICON_LOCATION_TAIL


def place(store, block, data):
    offset, size = block
    if len(data) > 1 << size:
        raise Failure('A block of the disk image\'s %s outgrew its %d bytes' % (STORE_NAME, 1 << size))
    store[offset:offset + len(data)] = data


def notarize(image, profile):
    result = subprocess.run(
        ['/usr/bin/xcrun', 'notarytool', 'submit', image, '--keychain-profile', profile, '--wait',
         '--output-format', 'json'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        submitted = json.loads(result.stdout)
    except ValueError:
        raise Failure('notarytool failed:\n%s' % (result.stderr.strip() or result.stdout.strip()))
    if submitted.get('status') != 'Accepted':
        log = subprocess.run(
            ['/usr/bin/xcrun', 'notarytool', 'log', submitted.get('id', ''), '--keychain-profile', profile],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True).stdout.strip()
        raise Failure('Notarization ended %s:\n%s' % (submitted.get('status'), log))
    command_output(['/usr/bin/xcrun', 'stapler', 'staple', image])
    command_output(['/usr/sbin/spctl', '--assess', '--type', 'open', '--context', 'context:primary-signature',
                    image])


def report(record):
    lines = [
        'Packaged %s %s' % (record['name'], record['version']),
        '  %s' % record['path'],
        '  %.1f MB, sha256 %s, macOS %s or later' % (record['size'] / 1e6, record['sha256'], record['minimumSystem']),
    ]
    if record['signature'] == 'ad hoc':
        lines.append('Signed ad hoc, so macOS will refuse to open it once downloaded on another Mac. Add a '
                     '%s certificate to the keychain to sign a download.' % DEVELOPER_ID)
    elif not record['notarized']:
        lines.append('Signed by %s but not notarized, so it cannot be uploaded.' % record['signature'])
    if record['source']['changed']:
        lines.append('Packaged with uncommitted changes, for testing only.')
    elif record['notarized']:
        lines.append('Upload it with: toolchain/release/brix-downloads %s %s' % (UPLOAD, record['version']))
    say('\n'.join(lines))


def upload_editor(options):
    folder = os.path.join(DOWNLOADS, EDITOR)
    version = options.version or newest_package(folder)
    path = os.path.join(folder, version, RECORD_NAME)
    if not os.path.isfile(path):
        raise Failure('There is no %s package %s in %s' % (EDITOR_NAME, version, folder))
    with open(path) as file:
        record = json.load(file)
    if record['signature'] == 'ad hoc' or not record['notarized']:
        raise Failure('%s %s is not signed with a %s certificate and notarized, so it is not uploaded' % (
            EDITOR_NAME, version, DEVELOPER_ID))
    if record['source']['changed']:
        raise Failure('%s %s was packaged with uncommitted changes, so it is not uploaded' % (EDITOR_NAME, version))
    image = os.path.join(folder, version, record['file'])
    if file_digest(image) != record['sha256']:
        raise Failure('%s no longer matches the sha256 in %s' % (image, path))
    published = published_editor()
    if published and version_key(published['version']) >= version_key(version):
        raise Failure('%s %s is already published, so %s would not be an update' % (
            EDITOR_NAME, published['version'], version))
    key = '%s/%s/%s' % (EDITOR_PREFIX, version, record['file'])
    say('Uploading %s' % key)
    put_once(key, image, record['sha256'])
    if launcher.s3_download(key) != (record['sha256'], record['size']):
        raise Failure('s3://%s/%s does not match %s after uploading' % (launcher.RELEASES_BUCKET, key, image))
    url = '%s/%s' % (launcher.RELEASES_SITE, key)
    latest = {
        'version': version,
        'url': url,
        'page': url,
        'size': record['size'],
        'sha256': record['sha256'],
        'minimumSystem': record['minimumSystem'],
    }
    launcher.s3_put(LATEST_KEY, (json.dumps(latest, indent=4) + '\n').encode(), 'application/json')
    say('%s %s is the latest, at %s\nEditors offer it as an update within a day of their next check.' % (
        EDITOR_NAME, version, url))


def newest_package(folder):
    found = [name for name in (os.listdir(folder) if os.path.isdir(folder) else [])
             if os.path.isfile(os.path.join(folder, name, RECORD_NAME))]
    if not found:
        raise Failure('There are no %s packages in %s' % (EDITOR_NAME, folder))
    return max(found, key=version_key)


def put_once(key, path, digest):
    with open(path, 'rb') as file:
        body = file.read()
    try:
        launcher.s3_put(key, body, IMAGE_TYPE, {'if-none-match': '*'})
    except launcher.S3Error as error:
        if error.status != 412:
            raise
        existing = launcher.s3_head(key, {'x-amz-checksum-mode': 'ENABLED'}) or {}
        if existing.get('x-amz-checksum-sha256') != base64.b64encode(bytes.fromhex(digest)).decode():
            raise Failure('A different s3://%s/%s already exists; a download is never replaced'
                          % (launcher.RELEASES_BUCKET, key))


if __name__ == '__main__':
    sys.exit(run_main(main))
