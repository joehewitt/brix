
+ ./distance

` Used to convert a number from one range to another
`
` Examples:
` 200px * Scale(100px, 500px) / percent = 25%
` 200px * Scale(100px, 500px) / percent = 25%
` 25% * Scale(100px, 500px) / percent = 200px

+ percent = Scale(0%, 100%)

━━━━━━━━━━━━━━━━━━━━
+ Scalable'Num is Interface

+ scale => Scale'Num()

────────────────────
+ from ratio Ratio

scale * ratio

────────────────────
+ to Ratio

scale * this

────────────────────
+ to Scalable''OtherNum

this * (scale / Scalable'OtherNum.scale)

━━━━━━━━━━━━━━━━━━━━
+ Scale'Num is (minimum Num, maximum Num)

────────────────────
+ this / other

ScalePair(this, other)

────────────────────
+ this * value Num

positive / (value as Float)

────────────────────
+ this Ratio * value Num

positive / total

.. positive = (value as Float) - minimum
.. total = maximum - minimum

────────────────────
+ this Num * ratio Ratio

(minimum + (ratio * total)) as Num

.. total = (maximum - minimum) + 1

━━━━━━━━━━━━━━━━━━━━
+ ScalePair is (scale1 Scale''Num1, scale2 Scale''Num2)

────────────────────
+ this Num1 * value Num2

scale1 * ratio

.. ratio = scale2 * value

────────────────────
+ this Num2 * value Num1

scale2 * ratio

.. ratio = scale1 * value

━━━━━━━━━━━━━━━━━━━━

+ Ratio (%%) is F64
+ Percent (%) is 0.01%%
