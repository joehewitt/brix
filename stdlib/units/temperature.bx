(type-line + Kelvins (alias kelvins) (is F64))
(type-line + Rankines (alias rankines) (is F64))
(unit + 9rankines 5kelvins)

(type + Celsius (alias °c) (is F64)
  (fn-to-expr + Fahrenheit
    (as (+ (/ (* (as this F64) 9.0) 5.0) 32.0) Fahrenheit)
  )
  (fn-to-expr + Kelvin
    (as (+ (as this F64) 273.15) Kelvin)
  )
  (fn-expr + (infix this + (param amount Kelvins)) Celsius
    (as (+ (as this F64) (as amount F64)) Celsius)
  )
  (fn-expr + (infix this - (param amount Kelvins)) Celsius
    (as (- (as this F64) (as amount F64)) Celsius)
  )
  (fn-expr + (infix this - (param other Celsius)) Kelvins
    (as (- (as this F64) (as other F64)) Kelvins)
  )
)

(type + Fahrenheit (alias °f) (is F64)
  (fn-to-expr + Celsius
    (as (/ (* (- (as this F64) 32.0) 5.0) 9.0) Celsius)
  )
  (fn-to-expr + Kelvin
    (as (+ (/ (* (- (as this F64) 32.0) 5.0) 9.0) 273.15) Kelvin)
  )
  (fn-expr + (infix this + (param amount Rankines)) Fahrenheit
    (as (+ (as this F64) (as amount F64)) Fahrenheit)
  )
  (fn-expr + (infix this - (param amount Rankines)) Fahrenheit
    (as (- (as this F64) (as amount F64)) Fahrenheit)
  )
  (fn-expr + (infix this - (param other Fahrenheit)) Rankines
    (as (- (as this F64) (as other F64)) Rankines)
  )
)

(type + Kelvin (alias kelvin) (is F64)
  (fn-to-expr + Celsius
    (as (- (as this F64) 273.15) Celsius)
  )
  (fn-to-expr + Fahrenheit
    (as (+ (/ (* (- (as this F64) 273.15) 9.0) 5.0) 32.0) Fahrenheit)
  )
  (fn-expr + (infix this + (param amount Kelvins)) Kelvin
    (as (+ (as this F64) (as amount F64)) Kelvin)
  )
  (fn-expr + (infix this - (param amount Kelvins)) Kelvin
    (as (- (as this F64) (as amount F64)) Kelvin)
  )
  (fn-expr + (infix this - (param other Kelvin)) Kelvins
    (as (- (as this F64) (as other F64)) Kelvins)
  )
)
