(import /lang/ast/module)
(import /lang/ast/module-resolver)
(import /lang/ast/program)
(import /lang/ast/program-builder)
(import /lang/ast/syntax-program)
(import /lang/check/edit-typing)
(import /lang/check/session)
(import /lang/check/typing)
(import /lang/constants)
(import /os/file)
(import /os/path)

(type + ProgramStore
  (implements (of Usable Void))
  (prop + search-paths (list Path))
  (prop + parse-worker-count _ (= default-worker-count))
  (prop + failures (map String String))
  (prop + resolver ModuleResolver)
  (prop _ cache ModuleCache)
  (prop _ view ModuleView)
  (prop _ c-module-paths (map String (list Path)))
  (prop _ sources (map String String))
  (prop _ assembled (? Program))
  (prop _ previous (? Program))
  (prop _ typed (? Session))
  (prop _ opened (list String))
  (prop _ entry-path (? String))
  (prop _ released Bool)
  (fn-do + This _
    (param search-paths (list Path))
    (param cache ModuleCache)
    (lazy resolver (call ModuleResolver search-paths c-module-paths))
    (lazy view (call (. cache view)))
  )
  (fn-do + has Bool
    (param path String)
    (let built (call program))
    (return (if-expr built (!= (call (. built module-by-path) path) null) false))
  )
  (fn-do + open _
    (param path String)
    (return-if (if (!= (call (. opened find) path) null)))
    (if (and entry-path (not assembled))
      (call program)
    )
    (+= opened path)
    (if (call holds path)
      (call release-typing)
      (return)
    )
    (= entry-path path)
    (call discard)
  )
  (fn-do + update _
    (param path String)
    (param text (? String))
    (if text
      (= ([] sources path) text)
      (else
        (-= ([] sources path))
      )
    )
    (return-if (if (and (not (call holds path)) (not ([] failures path)))))
    (call invalidate)
  )
  (fn-do + changed _
    (param path (? String))
    (if path
      (return-if (if (has sources path)))
      (return-if (if (and (not (call holds path)) (not ([] failures path)))))
    )
    (call invalidate)
  )
  (fn-do + program (? Program)
    (let current assembled)
    (return-if current (if current))
    (let entry entry-path)
    (throw (call Panic "ProgramStore has no modules") (if (not entry)))
    (let roots (list (tuple String String)))
    (+= roots (tuple entry (call module-name entry)))
    (for (in path opened)
      (if (!= path entry)
        (+= roots (tuple path (call module-name path)))
      )
    )
    (let syntax (use (call SyntaxProgram search-paths c-module-paths)))
    (call (. syntax use-modules) view)
    (= (. syntax keeps-going) true)
    (= (. syntax sources) sources)
    (call (. syntax parse-modules) roots parse-worker-count)
    (= failures (. syntax failures))
    (if (not (call (. syntax has-module) (. syntax source-path)))
      (call discard)
      (call (. view settle))
      (return null)
    )
    (call (. syntax materialize-c-headers))
    (let builder (call ProgramBuilder (. cache atoms)))
    (= (. builder shares-atoms) true)
    (let built (call (. builder build) syntax))
    (= assembled built)
    (let superseded previous)
    (if superseded
      (= previous null)
      (let kept typed)
      (if kept
        (let refusal (call retype-edit kept built false))
        (probe-log analysis.retype (text: "retyped " (?? refusal "in place")))
        (if refusal
          (call release-typing)
        )
      )
      (call (. superseded release))
    )
    (call (. view settle))
    (return built)
  )
  (fn-do + take-inputs (map String ParseStamp)
    (return (call (. view take-inputs)))
  )
  (fn-do + session Session
    ; The program typed as an editor reads it: from the main of every module, and every function of
    ; each module opened that takes no type parameters, with the methods of each class of one that
    ; takes none, so that what no main reaches is typed too. A generic function is typed only for the
    ; types a call gives it. An edit to the body of one function retypes the session in place.
    (let built (!! (call program)))
    (let current typed)
    (return-if current (if current))
    (let made (call Session built))
    (call seed-mains made)
    (for (in position (..< 0 (. built modules length)))
      (if (!= (call (. opened find) (. ([] (. built modules) position) path)) null)
        (call seed-functions made (as position ModuleId))
      )
    )
    (call check-program made)
    (= typed made)
    (return made)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (call discard)
      (call (. view release))
      (= released true)
    )
  )
  (fn-do + text-of (? String)
    (param path String)
    (let unsaved ([] sources path))
    (return-if unsaved (if unsaved))
    (return (catch? (call file-text path)))
  )
  (fn-do _ holds Bool
    (param path String)
    (let current assembled)
    (if (not current)
      (= current previous)
    )
    (return-if false (if (not current)))
    (return (!= (call (. current module-by-path) path) null))
  )
  (fn-do _ invalidate _
    (if (not typed)
      (call discard)
      (return)
    )
    (let current assembled)
    (if current
      (= previous current)
      (= assembled null)
    )
  )
  (fn-do _ discard _
    (call release-typing)
    (let current assembled)
    (if current
      (call (. current release))
      (= assembled null)
    )
    (let superseded previous)
    (if superseded
      (call (. superseded release))
      (= previous null)
    )
  )
  (fn-do _ release-typing _
    (let session typed)
    (if session
      (call (. session release))
      (= typed null)
    )
  )
  (fn-do _ module-name String
    (param path String)
    (let extension (. (call Path path) ext))
    (let stem (if-expr (!= (. extension length) 0) ([] path (..< 0 (- (. path length) (. extension length) 1))) path))
    (for (in root (. resolver search-paths))
      (let prefix (str root "/"))
      (return-if ([] stem (... (. prefix length))) (if (call (. stem starts-with) prefix)))
    )
    (return (. (call Path stem) name))
  )
)

(fn-do _ file-text String (?! Error)
  (param path String)
  (let file (use (call File path)))
  (return (as file String))
)
