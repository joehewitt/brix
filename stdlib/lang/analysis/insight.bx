(import ./program-store)
(import /core/parsing)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/session)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/report/explain)
(import /lang/report/facts-text)
(import /lang/report/header)

(type + InsightKind (is Union)
  (variant raise)
  (variant convert)
)

(type + InsightMark (is Tuple)
  (prop + line U32)
  (prop + start U32)
  (prop + end U32)
  (prop + kind InsightKind)
  (prop + detail String)
  (prop + caption (? String))
  (prop + errors (list String))
)

(type + InsightFill (is Tuple)
  (prop + line U32)
  (prop + type String)
  (prop + errors (list String))
)

(type + InsightNote (is Tuple)
  (prop + line U32)
  (prop + kind String)
  (prop + label String)
  (prop + text String)
)

(type + FileInsight (is Tuple)
  (prop + marks (list InsightMark))
  (prop + unknown (list U32))
  (prop + fills (list InsightFill))
  (prop + notes (list InsightNote))
)

(fn-do + file-insight (? FileInsight)
  (param store ProgramStore)
  (param path String)
  (param target (? String) (= null))
  (if target
    (call (. store open) target)
  )
  (call (. store open) path)
  (return-if null (if (not (call (. store has) path))))
  (let program (!! (call (. store program))))
  (let found (call (. program module-by-path) path))
  (return-if null (if (not found)))
  (let module (as found ModuleId))
  (let targeted (only-if (call (. program module-by-path) target) (if target)))
  (let root (if-expr targeted (as targeted ModuleId) module))
  (let session (call (. store session)))
  (let text (?? (call (. store text-of) path) ""))
  (return (call (. (call InsightScan session module root (call (. text split) "\n")) scan)))
)

(type _ InsightScan
  (prop + session Session)
  (prop + module ModuleId)
  (prop + root ModuleId)
  (prop + lines (list String))
  (blank)
  (prop _ reached (list Bool))
  (prop _ marks (list InsightMark))
  (prop _ fills (list InsightFill))
  (prop _ notes (list InsightNote))
  (prop _ seen (map String Bool))
  (fn-do + This _
    (param session _)
    (param module _)
    (param root _)
    (param lines _)
  )
  (fn-do + scan FileInsight
    (call reach)
    (let instances (. session instances))
    (let decls (. ([] (. session program modules) module) decls))
    (let tree (. ([] (. session program modules) module) tree))
    (let copies (list (list InstanceId)))
    (for (in _ (..< 0 (. decls length)))
      (+= copies (call (of List InstanceId)))
    )
    (for (in position (..< 0 (. instances length)))
      (let row ([] (. instances rows) position))
      (let id (as position InstanceId))
      (if (and (== (. row module) module) ([] reached position) (!= id (. instances dead)))
        (+= ([] copies (. row decl)) id)
        (call mark-calls id)
        (call mark-conversions id)
      )
    )
    (let unknown (list U32))
    (for (in index (..< 0 (. decls length)))
      (let syntax (call function-syntax ([] decls index)))
      (if (and (!= syntax 0) (not (call is-unlocated ([] (. tree nodes loc) syntax))))
        (if (== (. ([] copies index) length) 0)
          (+= unknown (. ([] (. tree nodes loc) syntax) begin line))
          (else-if (call is-headed ([] decls index))
            (call fill (as index DeclId) syntax ([] copies index))
          )
        )
      )
    )
    (return (call FileInsight marks unknown fills notes))
  )
  (fn-do _ fill _
    (param decl DeclId)
    (param syntax SyntaxId)
    (param found (list InstanceId))
    (let tree (. ([] (. session program modules) module) tree))
    (let head (. ([] (. tree nodes loc) syntax) begin line))
    (for (in note (call explain-notes session root (call DeclRef module decl) found))
      (+= notes (call InsightNote head (. note kind) (. note label) (. note text)))
    )
    (let header (call inferred-header session module decl found))
    (return-if (if (or (not header) (. header is-empty))))
    (if (or (. header returns) (!= (. header errors length) 0))
      (+= fills (call InsightFill head (?? (. header returns) "") (. header errors)))
    )
    (for (in param (. header params))
      (let loc ([] (. tree nodes loc) (. param syntax)))
      (if (not (call is-unlocated loc))
        (+= fills (call InsightFill (. loc begin line) (. param type) (call (of List String))))
      )
    )
  )
  (fn-do _ reach _
    (let instances (. session instances))
    (let facts (. session facts))
    (let program (. session program))
    (let runs (call loaded-modules))
    (let enclosed (map InstanceId (list InstanceId)))
    (let queue (list InstanceId))
    (for (in position (..< 0 (. instances length)))
      (+= reached false)
      (let row ([] (. instances rows) position))
      (let id (as position InstanceId))
      (if (!= (. row enclosing) no-instance)
        (call link enclosed (. row enclosing) id)
        (else-if (and ([] runs (. row module)) (== (. row decl) (. ([] (. program modules) (. row module)) main-decl)))
          (+= queue id)
        )
      )
    )
    (let answered (map InstanceId (list InstanceId)))
    (for (in fact (. facts overrides))
      (if (!= (. fact override) no-instance)
        (call link answered (. fact base) (. fact override))
      )
    )
    (for (in slot (. facts witness-slots))
      (if (and (!= (. slot proto) no-instance) (!= (. slot callee) no-instance))
        (call link answered (. slot proto) (. slot callee))
      )
    )
    (for (in id queue)
      (= ([] reached id) true)
    )
    (let next Size 0)
    (while (< next (. queue length))
      (let id ([] queue next))
      (+= next 1)
      (let targets (list InstanceId))
      (for (in call (call (. facts instance-calls) id))
        (+= targets (. ([] (. facts calls) call) callee))
      )
      (for (in conversion (call (. facts instance-conversions) id))
        (call converted ([] (. facts conversions) conversion) targets)
      )
      (++= targets (?? ([] enclosed id) (call (of List InstanceId))))
      (++= targets (?? ([] answered id) (call (of List InstanceId))))
      (for (in target targets)
        (if (and (!= target no-instance) (not ([] reached target)))
          (= ([] reached target) true)
          (+= queue target)
        )
      )
    )
  )
  (fn-do _ loaded-modules (list Bool)
    (let program (. session program))
    (let count (. program modules length))
    (let loaded (list Bool))
    (for (in _ (..< 0 count))
      (+= loaded false)
    )
    (= ([] loaded root) true)
    (let queue (list ModuleId))
    (+= queue root)
    (let next Size 0)
    (while (< next (. queue length))
      (let from ([] queue next))
      (+= next 1)
      (for (in position (..< 0 count))
        (let other (as position ModuleId))
        (if (and (not ([] loaded other)) (call (. program sees) from other))
          (= ([] loaded other) true)
          (+= queue other)
        )
      )
    )
    (return loaded)
  )
  (fn-do _ link _
    (param edges (map InstanceId (list InstanceId)))
    (param from InstanceId)
    (param to InstanceId)
    (let found (?? ([] edges from) (call (of List InstanceId))))
    (+= found to)
    (= ([] edges from) found)
  )
  (fn-do _ converted _
    (param fact ConversionFact)
    (param targets (list InstanceId))
    (+= targets (. fact callee))
    (+= targets (. fact runs))
    (let part (. fact parts))
    (while (!= part no-fact)
      (let inner ([] (. session facts conversion-parts) part))
      (call converted inner targets)
      (= part (. inner next))
    )
  )
  (fn-do _ mark-calls _
    (param instance InstanceId)
    (let instances (. session instances))
    (let facts (. session facts))
    (for (in id (call (. facts instance-calls) instance))
      (let fact ([] (. facts calls) id))
      (let callee (. fact callee))
      (if (and (!= callee no-instance) (not (. fact is-partial)) (!= (. fact form) .call-converter) (call is-written-form (. fact form)))
        (let count (. ([] (. instances signatures) callee) errors count))
        (if (!= count 0)
          (let fate
            (block
              (case? (. fact propagates)
                "which leave this function"
              )
              (default
                "which this function handles"
              )
            )
          )
          (let given (if-expr (. fact propagates) (call error-names callee) (call (of List String))))
          (call add
            (block
              (arg (. fact syntax))
              (arg (. InsightKind raise))
              (arg (str (call callee-name callee) " can raise " (call errors-text callee) ", " fate))
              (arg null)
              (arg given)
            )
          )
        )
      )
    )
  )
  (fn-do _ mark-conversions _
    (param instance InstanceId)
    (let facts (. session facts))
    (for (in id (call (. facts instance-conversions) instance))
      (let fact ([] (. facts conversions) id))
      (if (call is-marked fact)
        (let source (call type-source (. session types) (. fact from)))
        (let target (call type-source (. session types) (if-expr (== (. fact asked) no-type) (. fact to) (. fact asked))))
        (let by (if-expr (!= (. fact callee) no-instance) (str " with " (call callee-name (. fact callee))) ""))
        (let detail (str "Converts " source " to " target by))
        (let caption (? String) null)
        (let given (list String))
        (if (== (. fact raise) .raise-leaves)
          (let errors (call errors-text (. fact callee)))
          (= detail (str detail ", and its errors " errors " leave this function"))
          (= caption (str "can raise " errors))
          (= given (call error-names (. fact callee)))
          (else-if (== (. fact raise) .raise-panics)
            (= detail (str detail ", and panics if the text does not convert"))
            (= caption "panics if the text does not convert")
          )
        )
        (call add (. fact syntax) (. InsightKind convert) detail caption given)
      )
    )
  )
  (fn-expr _ is-marked Bool
    (param fact ConversionFact)
    (and shown (not texts) (or runs scales (!= (. fact raise) .raise-unsettled)))
    (where
      (lazy texts (== (if-expr (== (. fact asked) no-type) (. fact to) (. fact asked)) (. session types string-type)))
      (lazy reason (. fact reason))
      (lazy shown (or written (== reason .reason-operand) (== reason .reason-receiver) (== reason .reason-default) (== reason .reason-piped) (== reason .reason-operator) (== reason .reason-result)))
      (lazy written (or (== reason .reason-argument) (== reason .reason-assignment) (== reason .reason-declaration) (== reason .reason-return) (== reason .reason-join) (== reason .reason-element)))
      (lazy runs (or (== (. fact kind) .relation-converter) (== (. fact kind) .relation-fromverter) (== (. fact kind) .relation-common-converter)))
      (lazy scales (and (not (. fact ratio is-none)) (!= (. fact ratio multiplier) (. fact ratio divisor))))
    )
  )
  (fn-do _ add _
    (param syntax SyntaxId)
    (param kind InsightKind)
    (param detail String)
    (param caption (? String))
    (param errors (list String))
    (return-if (if (== syntax 0)))
    (let loc ([] (. ([] (. session program modules) module) tree nodes loc) syntax))
    (return-if (if (call is-unlocated loc)))
    (let line (. loc begin line))
    (let start (. loc begin column))
    (let end (if-expr (== (. loc end line) line) (+ (. loc end column) 1) (call line-end line)))
    (let key (str line ":" start ":" end ":" (if-expr (== kind (. InsightKind raise)) "raise" "convert")))
    (return-if (if (!= ([] seen key) null)))
    (= ([] seen key) true)
    (+= marks (call InsightMark line start end kind detail caption errors))
  )
  (fn-expr _ line-end U32
    (param line U32)
    (if-expr (< line (. lines length)) (as (. ([] lines line) length) U32) 0)
  )
  (fn-do _ errors-text String
    (param callee InstanceId)
    (return (call (. " | " join) (call error-names callee)))
  )
  (fn-do _ error-names (list String)
    (param callee InstanceId)
    (let instances (. session instances))
    (let names (list String))
    (return-if names (if (== callee no-instance)))
    (for (in position (..< 0 (. ([] (. instances signatures) callee) errors count)))
      (+= names (call type-source (. session types) (call (. instances error-type) callee position)))
    )
    (return names)
  )
  (fn-do _ callee-name String
    (param callee InstanceId)
    (let row ([] (. session instances rows) callee))
    (let decls (. ([] (. session program modules) (. row module)) decls))
    (match? ([] decls (. row decl))
      (case (call .decl-function fn)
        (let name (. fn name))
        (return-if (. name text) (if name))
        (return-if (str "the constructor of " (call class-name decls (. fn owner))) (if (== (. fn kind) .constructor-decl)))
      )
      (case (call .decl-converter converter)
        (return (str "the converter of " (call class-name decls (. converter owner))))
      )
      (case (call .decl-fromverter fromverter)
        (return (str "the fromverter of " (call class-name decls (. fromverter owner))))
      )
    )
    (return "the call")
  )
)

(fn-expr _ class-name String
  (param decls (of ImmutableTable Decl))
  (param owner DeclId)
  (match ([] decls owner)
    (case (call .decl-class owned)
      (. owned name text)
    )
    (default
      "its class"
    )
  )
)

(fn-expr _ function-syntax SyntaxId
  (param decl Decl)
  (match decl
    (case (call .decl-function fn)
      (if-expr (call is-boxed fn) (. fn syntax) 0)
    )
    (case (call .decl-converter converter)
      (. converter syntax)
    )
    (case (call .decl-fromverter fromverter)
      (. fromverter syntax)
    )
    (default
      0
    )
  )
)

(fn-expr _ is-headed Bool
  (param decl Decl)
  (match decl
    (case (call .decl-function fn)
      (or (!= (. fn name) null) (== (. fn kind) .constructor-decl))
    )
    (default
      false
    )
  )
)

(fn-expr _ is-boxed Bool
  (param fn FunctionDecl)
  (and (not (. fn is-generated)) (or (== kind .function-decl) (== kind .getter-decl) (== kind .setter-decl) (== kind .constructor-decl) (== kind .iterator-decl)))
  (where
    (lazy kind (. fn kind))
  )
)
