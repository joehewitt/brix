(import ./catalog)
(import ./insight)
(import ./navigation)
(import ./program-store)
(import /data/json)
(import /data/jsonrpc)
(import /lang/ast/module)
(import /lang/report/explain)

(type + AnalysisService
  (prop + store ProgramStore)
  (fn-do + This _
    (param store ProgramStore)
  )
  (fn-expr + answers Bool
    (param method String)
    (or is-sync-method (== method "definition") (== method "hover") (== method "catalog") (== method "insight") (== method "explain"))
    (where
      (lazy is-sync-method (or (== method "update") (== method "changed") (== method "open")))
    )
  )
  (fn-do + perform JSON (?! Error)
    (param method String)
    (param params JSON)
    (let fields (call (. (call JSONReader "params" params) object)))
    (if (== method "update")
      (let text ([] fields "text"))
      (call (. store update) (call (. ([] fields "path") string)) (only-if (call (. text string)) (if (. text is-present))))
      (return true)
    )
    (if (== method "changed")
      (let path ([] fields "path"))
      (call (. store changed) (only-if (call (. path string)) (if (. path is-present))))
      (return true)
    )
    (if (== method "open")
      (call (. store open) (call (. ([] fields "path") string)))
      (return true)
    )
    (if (== method "definition")
      (let path (call (. ([] fields "path") string)))
      (let link (call link-at store path (as (call (. ([] fields "line") int)) U32) (as (call (. ([] fields "column") int)) U32)))
      (return-if null (if (not link)))
      (blank)
      (let origin
        (call (of Map String JSON)
          (block
            (:line (as (. link line) Int))
            (:start (as (. link start) Int))
            (:end (as (. link end) Int))
          )
        )
      )
      (let signature (. link signature))
      (let found
        (call (of Map String JSON)
          (block
            (:path (. link target path))
            (:line (as (. link target line) Int))
            (:column (as (. link target column) Int))
            (:origin origin)
          )
        )
      )
      (if signature
        (= ([] found "signature") signature)
      )
      (return found)
    )
    (if (== method "hover")
      (let path (call (. ([] fields "path") string)))
      (let shown (call hover-at store path (as (call (. ([] fields "line") int)) U32) (as (call (. ([] fields "column") int)) U32)))
      (return-if null (if (not shown)))
      (return
        (call (of Map String JSON)
          (block
            (:line (as (. shown line) Int))
            (:start (as (. shown start) Int))
            (:end (as (. shown end) Int))
            (:text (. shown text))
          )
        )
      )
    )
    (if (== method "catalog")
      (let names (list String))
      (for (in item (call (. ([] fields "interfaces") items)))
        (+= names (call (. item string)))
      )
      (return (call catalog-json (call program-catalog store (call (. ([] fields "path") string)) names)))
    )
    (if (== method "insight")
      (let target ([] fields "target"))
      (let shown (call file-insight store (call (. ([] fields "path") string)) (only-if (call (. target string)) (if (. target is-present)))))
      (return-if null (if (not shown)))
      (return (call insight-json shown))
    )
    (if (== method "explain")
      (let name ([] fields "name"))
      (let line ([] fields "line"))
      (return
        (call explained-text
          (block
            (arg (call (. ([] fields "path") string)))
            (arg (only-if (call (. name string)) (if (. name is-present))))
            (arg (only-if (call (. line int)) (if (. line is-present))))
          )
        )
      )
    )
    (throw (call JSONRPCError .method-not-found (str "Unknown method " method)))
  )
  (fn-do _ explained-text String
    (param path String)
    (param name (? String))
    (param line (? Int))
    (call (. store open) path)
    (return-if (str "Nothing could be read from " path) (if (not (call (. store has) path))))
    (blank)
    (let program (!! (call (. store program))))
    (let module (as (!! (call (. program module-by-path) path)) ModuleId))
    (let session (call (. store session)))
    (if name
      (let named
        (call explained-function program module name
          (block
            (on-error (: error ExplainError)
              (return (. error message))
            )
          )
        )
      )
      (return
        (call explain-function
          (block
            (arg session)
            (arg module)
            (arg named)
            (arg (?? (call (. store text-of) (. ([] (. program modules) (. named module)) path)) ""))
          )
        )
      )
    )
    (let at (call function-at-line program module (as (- (?? line 1) 1) U32)))
    (return-if (str "No function is written at " path ":" (?? line 0)) (if (not at)))
    (return (call explain-function session module at (?? (call (. store text-of) (. ([] (. program modules) (. at module)) path)) "")))
  )
)

(fn-do _ insight-json JSON
  (param shown FileInsight)
  (let marks (list JSON))
  (for (in mark (. shown marks))
    (let entry
      (call (of Map String JSON)
        (block
          (:line (as (. mark line) Int))
          (:start (as (. mark start) Int))
          (:end (as (. mark end) Int))
          (:kind (if-expr (== (. mark kind) (. InsightKind raise)) "raise" "convert"))
          (:detail (. mark detail))
        )
      )
    )
    (let caption (. mark caption))
    (if caption
      (= ([] entry "caption") caption)
    )
    (if (!= (. mark errors length) 0)
      (= ([] entry "errors") (call names-json (. mark errors)))
    )
    (+= marks entry)
  )
  (let unknown (list JSON))
  (for (in line (. shown unknown))
    (+= unknown (as line Int))
  )
  (let fills (list JSON))
  (for (in fill (. shown fills))
    (let entry
      (call (of Map String JSON)
        (block
          (:line (as (. fill line) Int))
          (:type (. fill type))
          (:errors (call names-json (. fill errors)))
        )
      )
    )
    (+= fills entry)
  )
  (let notes (list JSON))
  (for (in note (. shown notes))
    (+= notes
      (call (of Map String JSON)
        (block
          (:line (as (. note line) Int))
          (:kind (. note kind))
          (:label (. note label))
          (:text (. note text))
        )
      )
    )
  )
  (return
    (call (of Map String JSON)
      (block
        (:marks marks)
        (:unknown unknown)
        (:fills fills)
        (:notes notes)
      )
    )
  )
)

(fn-do _ names-json JSON
  (param names (list String))
  (let found (list JSON))
  (for (in name names)
    (+= found name)
  )
  (return found)
)

(fn-expr _ catalog-json JSON
  (param classes (list CatalogClass))
  (in (call class-json each) classes)
)

(fn-do _ class-json JSON
  (param entry CatalogClass)
  (let interfaces (list JSON))
  (for (in name (. entry interfaces))
    (+= interfaces name)
  )
  (let kinds (list JSON))
  (for (in name (. entry kinds))
    (+= kinds name)
  )
  (let properties (list JSON))
  (for (in property (. entry properties))
    (+= properties
      (call (of Map String JSON)
        (block
          (:name (. property name))
          (:type (. property type))
          (:value (. property value))
          (:line (as (. property line) Int))
          (:is-public (. property is-public))
        )
      )
    )
  )
  (let machines (list JSON))
  (for (in machine (. entry machines))
    (let steps (list JSON))
    (for (in step (. machine steps))
      (+= steps
        (call (of Map String JSON)
          (block
            (:name (. step name))
            (:trigger (. step trigger))
            (:depth (as (. step depth) Int))
            (:line (as (. step line) Int))
            (:is-then (. step is-then))
          )
        )
      )
    )
    (+= machines
      (call (of Map String JSON)
        (block
          (:name (. machine name))
          (:line (as (. machine line) Int))
          (:steps steps)
        )
      )
    )
  )
  (return
    (call (of Map String JSON)
      (block
        (:name (. entry name))
        (:path (. entry path))
        (:line (as (. entry line) Int))
        (:base (. entry base))
        (:is-public (. entry is-public))
        (:interfaces interfaces)
        (:kinds kinds)
        (:properties properties)
        (:machines machines)
      )
    )
  )
)
