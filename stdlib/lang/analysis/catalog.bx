(import ./program-store)
(import /core/parsing)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/binding)
(import /lang/check/types)
(import /math)

(type + CatalogProperty (is Tuple)
  (prop + name String)
  (prop + type String)
  (prop + value String)
  (prop + line U32)
  (prop + is-public Bool)
)

(type + CatalogStep (is Tuple)
  (prop + name String)
  (prop + trigger String)
  (prop + depth U32)
  (prop + line U32)
  (prop + is-then Bool)
)

(type + CatalogMachine (is Tuple)
  (prop + name String)
  (prop + line U32)
  (prop + steps (list CatalogStep))
)

(type + CatalogClass (is Tuple)
  (prop + name String)
  (prop + path String)
  (prop + line U32)
  (prop + base String)
  (prop + is-public Bool)
  (prop + interfaces (list String))
  (prop + kinds (list String))
  (prop + properties (list CatalogProperty))
  (prop + machines (list CatalogMachine))
)

(fn-do + program-catalog (list CatalogClass)
  (param store ProgramStore)
  (param path String)
  (param interfaces (list String))
  (call (. store open) path)
  (let built (call (. store program)))
  (return-if (call (of List CatalogClass)) (if (not built)))
  (let reader (call CatalogReader store built))
  (return (call (. reader classes) interfaces))
)

(type _ CatalogReader
  (prop + store ProgramStore)
  (prop + program Program)
  (prop _ texts (map String (list String)))
  (fn-do + This _
    (param store _)
    (param program _)
  )
  (fn-do + classes (list CatalogClass)
    (param wanted (list String))
    (let found (list CatalogClass))
    (for (in index (..< 0 (. program modules length)))
      (let module ([] (. program modules) index))
      (for (in decl (..< 1 (. module decls length)))
        (match? ([] (. module decls) decl)
          (case (call .decl-class row)
            (let ref (call DeclRef (as index ModuleId) (as decl DeclId)))
            (let kinds (call kinds-of ref wanted))
            (if (> (. kinds length) 0)
              (+= found (call describe ref row kinds))
            )
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ kinds-of (list String)
    (param ref DeclRef)
    (param wanted (list String))
    (let kinds (list String))
    (let current (? DeclRef) ref)
    (let depth Size 0)
    (while (and current (< depth 64))
      (let module ([] (. program modules) (. current module)))
      (let next (? DeclRef) null)
      (match? ([] (. module decls) (. current decl))
        (case (call .decl-class row)
          (for (in interface ([] (. module syntax-pool) (. row interfaces)))
            (let head (call type-head-name (. module tree) interface))
            (if head
              (let name (. head text))
              (if (and (!= (call (. wanted find) name) null) (== (call (. kinds find) name) null))
                (+= kinds name)
              )
            )
          )
          (if (!= (. row base) 0)
            (let head (call type-head-name (. module tree) (. row base)))
            (if head
              (= next (call class-named (. current module) head))
            )
          )
        )
      )
      (= current next)
      (+= depth 1)
    )
    (return kinds)
  )
  (fn-do _ class-named (? DeclRef)
    (param caller ModuleId)
    (param name Atom)
    (for (in candidate (call (. program lookup) caller name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case .decl-class
          (return (call DeclRef (. candidate module) (. candidate decl)))
        )
      )
    )
    (return null)
  )
  (fn-do _ describe CatalogClass
    (param ref DeclRef)
    (param row ClassDecl)
    (param kinds (list String))
    (let module ([] (. program modules) (. ref module)))
    (let tree (. module tree))
    (let base "")
    (if (!= (. row base) 0)
      (let head (call type-head-name tree (. row base)))
      (if head
        (= base (. head text))
      )
    )
    (let interfaces (list String))
    (for (in interface ([] (. module syntax-pool) (. row interfaces)))
      (let head (call type-head-name tree interface))
      (if head
        (+= interfaces (. head text))
      )
    )
    (let properties (list CatalogProperty))
    (let machines (list CatalogMachine))
    (for (in member ([] (. module member-pool) (. row members)))
      (match? ([] (. module decls) member)
        (case (call .decl-property property)
          (let name (if-expr (. property name) (. property name text) ""))
          (let line (+ (. ([] (. tree nodes loc) (. property syntax)) begin line) 1))
          (if (call is-machine tree (. property value))
            (+= machines (call CatalogMachine name line (call machine-steps module (. property value))))
            (else
              (+= properties
                (call CatalogProperty
                  (block
                    (arg name)
                    (arg (call text-of module (. property type-syntax)))
                    (arg (call text-of module (. property value)))
                    (arg line)
                    (arg (== (. property access) .public-access))
                  )
                )
              )
            )
          )
        )
      )
    )
    (let line (+ (. ([] (. tree nodes loc) ([] (. module decls syntax) (. ref decl))) begin line) 1))
    (return
      (call CatalogClass
        (block
          (arg (. row name text))
          (arg (. module path))
          (arg line)
          (arg base)
          (arg (== (. row access) .public-access))
          (arg interfaces)
          (arg kinds)
          (arg properties)
          (arg machines)
        )
      )
    )
  )
  (fn-do _ is-machine Bool
    (param tree AST)
    (param syntax SyntaxId)
    (return-if false (if (== syntax 0)))
    (match? ([] (. tree nodes) syntax)
      (case .node-state-machine
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ machine-steps (list CatalogStep)
    (param module Module)
    (param machine SyntaxId)
    (let steps (list CatalogStep))
    (match? ([] (. module tree nodes) machine)
      (case (call .node-state-machine row)
        (call add-steps module (. row body) 0 steps)
      )
    )
    (return steps)
  )
  (fn-do _ add-steps _
    (param module Module)
    (param body (of RowRange SyntaxId))
    (param depth U32)
    (param steps (list CatalogStep))
    (let tree (. module tree))
    (for (in child ([] (. tree children) body))
      (let line (+ (. ([] (. tree nodes loc) child) begin line) 1))
      (match? ([] (. tree nodes) child)
        (case (call .node-state-case row)
          (+= steps (call CatalogStep (. row name text) (call text-of module (. row trigger)) depth line false))
          (call add-steps module (. row body) (+ depth 1) steps)
        )
        (case (call .node-state-continuation row)
          (+= steps (call CatalogStep (. row name text) (call text-of module (. row trigger)) depth line true))
          (call add-steps module (. row body) (+ depth 1) steps)
        )
      )
    )
  )
  (fn-do _ text-of String
    (param module Module)
    (param syntax SyntaxId)
    (return-if "" (if (== syntax 0)))
    (let lines (call lines-of (. module path)))
    (let loc ([] (. module tree nodes loc) syntax))
    (let first (as (. loc begin line) Size))
    (let last (as (. loc end line) Size))
    (return-if "" (if (or (< last first) (>= last (. lines length)))))
    (let parts (list String))
    (for (in number (.. first last))
      (let text ([] lines number))
      (let start (if-expr (== number first) (as (. loc begin column) Size) 0))
      (let end (if-expr (== number last) (+ (as (. loc end column) Size) 1) (. text length)))
      (+= parts ([] text (..< (call min start (. text length)) (call min end (. text length)))))
    )
    (return (call (. (call (. " " join) parts) trim)))
  )
  (fn-do _ lines-of (list String)
    (param path String)
    (let cached ([] texts path))
    (return-if cached (if cached))
    (let text (?? (call (. store text-of) path) ""))
    (let lines (list String) (call (. text split) "\n"))
    (= ([] texts path) lines)
    (return lines)
  )
)
