(import ./program-store)
(import /core/parsing)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/binder)
(import /lang/check/binding)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/session)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/check/typing-scratch)
(import /lang/target)

(type + DefinitionSite (is Tuple)
  (prop + path String)
  (prop + line U32)
  (prop + column U32)
)

(type + DefinitionLink (is Tuple)
  (prop + line U32)
  (prop + start U32)
  (prop + end U32)
  (prop + target DefinitionSite)
  (prop + signature (? String))
)

(type + HoverText (is Tuple)
  (prop + line U32)
  (prop + start U32)
  (prop + end U32)
  (prop + text String)
)

(fn-expr + link-at (? DefinitionLink)
  (param store ProgramStore)
  (param path String)
  (param line U32)
  (param column U32)
  (case? (not place)
    null
  )
  (case? (not target)
    null
  )
  (default
    (call DefinitionLink (. span begin line) (. span begin column) (+ (. span end column) 1) target signature)
  )
  (where
    (lazy place (call place-at store path line column))
    (lazy navigator (. place navigator))
    (lazy target (call (. navigator definition) (. place syntax)))
    (lazy span (. place span))
    (lazy signature (call (. navigator shown-text) (. place syntax)))
  )
)

(fn-do + hover-at (? HoverText)
  (param store ProgramStore)
  (param path String)
  (param line U32)
  (param column U32)
  ; What an editor shows over a name: the header of the function it names, or else its name and the
  ; type the type pass gave its value.
  (let place (call place-at store path line column))
  (return-if null (if (not place)))
  (let navigator (. place navigator))
  (call (. navigator definition) (. place syntax))
  (let text (call (. navigator shown-text) (. place syntax)))
  (return-if null (if (not text)))
  (let span (. place span))
  (return (call HoverText (. span begin line) (. span begin column) (+ (. span end column) 1) text))
)

(type _ NamePlace (is Tuple)
  (prop + navigator Navigator)
  (prop + syntax SyntaxId)
  (prop + span MatchLocation)
)

(fn-do _ place-at (? NamePlace)
  (param store ProgramStore)
  (param path String)
  (param line U32)
  (param column U32)
  ; The name a position in a module is on, with a navigator for its module.
  (call (. store open) path)
  (return-if null (if (not (call (. store has) path))))
  (let program (!! (call (. store program))))
  (let found (call (. program module-by-path) path))
  (return-if null (if (not found)))
  (let module (as found ModuleId))
  (let tree (. ([] (. program modules) module) tree))
  (let text (call (. store text-of) path))
  (return-if null (if (not text)))
  (let source (list String) (call (. text split) "\n"))
  (let syntax (call syntax-at tree source line column))
  (if (and (== syntax 0) (> column 0))
    (= syntax (call syntax-at tree source line (- column 1)))
  )
  (return-if null (if (== syntax 0)))
  (return (call NamePlace (call Navigator store program module) syntax (!! (call navigable-span tree source syntax))))
)

(fn-do _ signature-of (? String)
  (param store ProgramStore)
  (param program Program)
  (param ref (? DeclRef))
  (return-if null (if (not ref)))
  (let holder ([] (. program modules) (. ref module)))
  (let function
    (match? ([] (. holder decls) (. ref decl))
      (case (call .decl-function row)
        row
      )
    )
  )
  (return-if null (if (or (not function) (. function is-generated) (call (. holder path ends-with) ".h"))))
  (let text (call (. store text-of) (. holder path)))
  (return-if null (if (not text)))
  (let first (as (. ([] (. holder tree nodes loc) ([] (. holder decls syntax) (. ref decl))) begin line) Size))
  (let lines (list String) (call (. text split) "\n"))
  (return-if null (if (>= first (. lines length))))
  (let last first)
  (let is-brix (call (. holder path ends-with) brix-extension))
  (while (and (< (+ last 1) (. lines length)) (call is-header-row ([] lines (+ last 1)) is-brix))
    (+= last 1)
  )
  (return (call (. "\n" join) ([] lines (.. first last))))
)

(fn-expr _ is-header-row Bool
  (param line String)
  (param is-brix Bool)
  (if-expr is-brix (call (. (call (. line trim)) starts-with) "(param ") is-indented)
  (where
    (lazy is-indented
      (block
        (and (!= (. line length) 0) (or (call (. line starts-with) " ") (call (. line starts-with) "\t")) (!= (. (call (. line trim)) length) 0))
      )
    )
  )
)

(fn-do _ syntax-at SyntaxId
  (param tree AST)
  (param source (list String))
  (param line U32)
  (param column U32)
  ; The narrowest name on one line at a position whose place in the source holds it.
  (let best SyntaxId 0)
  (let best-size (. U64 max))
  (for (in id (..< 1u32 (. tree nodes length)))
    (let span (call navigable-span tree source (as id SyntaxId)))
    (if (and span (== (. span begin line) (. span end line)) (call covers span line column))
      (let size (call span-size span))
      (if (and (< size best-size) (call is-spelled tree source (as id SyntaxId) span))
        (= best (as id SyntaxId))
        (= best-size size)
      )
    )
  )
  (return best)
)

(fn-do _ is-spelled Bool
  (param tree AST)
  (param source (list String))
  (param id SyntaxId)
  (param span MatchLocation)
  ; Whether a node's name is written in the source where its span is. A node the compiler makes
  ; has a place that does not hold its name, and an import has no one name to compare.
  (let name
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (. row name)
      )
      (case (call .node-ref-identifier row)
        (. row name)
      )
      (case (call .node-type-identifier row)
        (. row name)
      )
      (case (call .node-get-expression row)
        (. row name)
      )
      (case (call .node-anonymous-case row)
        (. row name)
      )
    )
  )
  (return-if true (if (not name)))
  (let row (as (. span begin line) Index))
  (return-if false (if (>= row (as (. source length) Index))))
  (let text ([] source row))
  (let begin (as (. span begin column) Index))
  (let end (+ (as (. span end column) Index) 1))
  (return-if false (if (or (>= begin end) (> end (as (. text length) Index)))))
  (return (!= (call (. ([] text (..< begin end)) find) (. name text)) null))
)

(fn-do _ navigable-span (? MatchLocation)
  (param tree AST)
  (param source (list String))
  (param id SyntaxId)
  (let loc ([] (. tree nodes loc) id))
  (match? ([] (. tree nodes) id)
    (case .node-identifier
      (return loc)
    )
    (case .node-ref-identifier
      (return loc)
    )
    (case .node-type-identifier
      (return loc)
    )
    (case .node-import-syntax
      (return loc)
    )
    (case (call .node-get-expression row)
      (return (call member-span source (. ([] (. tree nodes loc) (. row object)) end) (. row name)))
    )
    (case (call .node-anonymous-case row)
      (let offset (if-expr (. row owner) (+ (as (. row owner text length) U32) 1) 1u32))
      (return (call name-span (. loc begin line) (+ (. loc begin column) offset) (. row name)))
    )
  )
  (return null)
)

(fn-do _ member-span (? MatchLocation)
  (param source (list String))
  (param after TokenLocation)
  (param name Atom)
  ; Where a member's name is written after the end of the value it is read from: the first `.`
  ; and the name on that line past it. The place recorded for the value can end before the value
  ; as written, as in a member read of its own or inside parentheses.
  (let row (as (. after line) Index))
  (return-if null (if (>= row (as (. source length) Index))))
  (let text ([] source row))
  (let dotted (str "." (. name text)))
  (let length (as (. name text length) Index))
  (let cursor (+ (as (. after column) Index) 1))
  (while (< cursor (as (. text length) Index))
    (let found (call (. ([] text (... cursor)) find) dotted))
    (return-if null (if (not found)))
    (let begin (+ cursor found 1))
    (let end (+ begin length))
    (if (or (>= end (as (. text length) Index)) (not (call is-name-char ([] text end))))
      (return (call name-span (. after line) (as begin U32) name))
    )
    (= cursor begin)
  )
  (return null)
)

(fn-expr _ is-name-char Bool
  (param char Char)
  (or letter digit (== char '-') (== char '_'))
  (where
    (lazy letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
    (lazy digit (and (>= char '0') (<= char '9')))
  )
)

(fn-expr _ name-span MatchLocation
  (param line U32)
  (param column U32)
  (param name Atom)
  (call MatchLocation
    (block
      (arg (call TokenLocation line column))
      (arg (call TokenLocation line (- (+ column (as (. name text length) U32)) 1)))
    )
  )
)

(fn-expr _ covers Bool
  (param loc MatchLocation)
  (param line U32)
  (param column U32)
  (and after-begin before-end)
  (where
    (lazy after-begin (or (> line (. loc begin line)) (and (== line (. loc begin line)) (>= column (. loc begin column)))))
    (lazy before-end (or (< line (. loc end line)) (and (== line (. loc end line)) (<= column (. loc end column)))))
  )
)

(fn-expr _ span-size U64
  (param loc MatchLocation)
  (case? (> (. loc end line) (. loc begin line))
    (/lshift/ (as (- (. loc end line) (. loc begin line)) U64) 32)
  )
  (default
    (as (- (. loc end column) (. loc begin column)) U64)
  )
)

(type _ Navigator
  (prop + store ProgramStore)
  (prop + program Program)
  (prop + module ModuleId)
  (prop + resolved (? DeclRef))
  (prop + tree AST)
  (prop _ owner Module)
  (prop _ builtins BuiltinClasses)
  (fn-do + This _
    (param store ProgramStore)
    (param program Program)
    (param module ModuleId)
    (lazy owner ([] (. program modules) module))
    (lazy tree (. owner tree))
    (lazy builtins (call builtin-classes-of program))
  )
  (fn-do + definition (? DefinitionSite)
    (param syntax SyntaxId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-identifier row)
        (return (?? (call typed-call-site syntax) (call name-site syntax (. row name))))
      )
      (case (call .node-ref-identifier row)
        (return (call name-site syntax (. row name)))
      )
      (case (call .node-type-identifier row)
        (return (call type-site syntax (. row name)))
      )
      (case (call .node-get-expression row)
        (return (?? (call typed-member-site syntax (. row object) (. row name)) (call member-site (. row object) (. row name))))
      )
      (case (call .node-import-syntax row)
        (return (call import-site row))
      )
      (case (call .node-anonymous-case row)
        (return (call case-site (. row name) (. row owner)))
      )
    )
    (return null)
  )
  (fn-do _ name-site (? DefinitionSite)
    (param syntax SyntaxId)
    (param name Atom)
    (let function (call bindable-owner syntax))
    (if (!= function 0)
      (let bindings (use (call Bindings)))
      (let binder (call Binder bindings program builtins))
      (let binding (call (. binder bind) module function))
      (let resolved (call resolution-site bindings (call (. bindings resolution-of) binding syntax)))
      (return-if resolved (if resolved))
    )
    (return (call named-site name))
  )
  (fn-expr + shown-text (? String)
    (param syntax SyntaxId)
    ; What an editor shows for a node once its definition is found: the header of the function it
    ; names, or else its name and the type of its value (`typed-text`).
    (?? (call signature-of store program resolved) (call typed-text syntax))
  )
  (fn-expr _ typed-call-site (? DefinitionSite)
    (param syntax SyntaxId)
    ; The function a call of a name runs, as the type pass chose it among those of that name.
    (case? (== instance no-instance)
      null
    )
    (case? (== callee no-instance)
      null
    )
    (case? (not (call is-written (. row module) (. row decl)))
      null
    )
    (default
      (call decl-site (. row module) (. row decl))
    )
    (where
      (lazy session (call (. store session)))
      (lazy instance (call instance-at session syntax))
      (lazy callee (call callee-at session instance syntax))
      (lazy row ([] (. session instances rows) callee))
    )
  )
  (fn-expr + typed-text (? String)
    (param syntax SyntaxId)
    ; A node's name and the type the type pass gave its value, as an editor shows it, or nothing
    ; where the pass typed no value there.
    (case? (not name)
      null
    )
    (case? (== instance no-instance)
      null
    )
    (case? (or (== type no-type) (== type invalid-type))
      null
    )
    (default
      (str (. name text) " " (call shown-type (. session types) type))
    )
    (where
      (lazy name
        (match? ([] (. tree nodes) syntax)
          (case (call .node-identifier row)
            (. row name)
          )
          (case (call .node-ref-identifier row)
            (. row name)
          )
          (case (call .node-get-expression row)
            (. row name)
          )
        )
      )
      (lazy session (call (. store session)))
      (lazy instance (call instance-at session syntax))
      (lazy type (call value-type session instance syntax))
    )
  )
  (fn-do _ value-type TypeId
    (param session Session)
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; For a name a declaration declares, the type the instance keeps for the local it declares;
    ; otherwise the type the type pass gave the node's value, or the declaration's, or else that of
    ; what the declaration declares.
    (let chain (list SyntaxId))
    (+= chain syntax)
    (let holder (call (. tree holder-of) syntax))
    (match? ([] (. tree nodes) holder)
      (case (call .node-type-capture row)
        (if (== (. row id) syntax)
          (+= chain holder)
          (= holder (call (. tree holder-of) holder))
        )
      )
    )
    (let right SyntaxId 0)
    (match? ([] (. tree nodes) holder)
      (case (call .node-declare row)
        (if (== (. row left) ([] chain (- (. chain length) 1)))
          (+= chain holder)
          (= right (. row right))
        )
      )
    )
    (for (in node chain)
      (let local (call local-type session instance node))
      (return-if local (if (!= local no-type)))
    )
    (for (in node chain)
      (let type (call (. session facts node-type) instance node))
      (return-if type (if (!= type no-type)))
    )
    (return (if-expr (!= right 0) (call (. session facts node-type) instance right) no-type))
  )
  (fn-do _ local-type TypeId
    (param session Session)
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The type an instance keeps for the local a node declares, or none.
    (let row ([] (. session instances rows) instance))
    (return-if no-type (if (== (. row binding) no-binding)))
    (let slots (. ([] (. session bindings bindings) (. row binding)) slots))
    (for (in offset (..< 0 (. slots count)))
      (if (== (. ([] (. session bindings slots) (+ (. slots start) offset)) syntax) syntax)
        (return (call (. session facts slot-type) instance offset))
      )
    )
    (return no-type)
  )
  (fn-do _ typed-member-site (? DefinitionSite)
    (param syntax SyntaxId)
    (param object SyntaxId)
    (param name Atom)
    ; The member a node reads of the value of `object`, as the type pass chose it: the function a
    ; call of it runs, or else the member of that name of the class of the value's type.
    (let session (call (. store session)))
    (let instance (call instance-at session syntax))
    (return-if null (if (== instance no-instance)))
    (let callee (call callee-at session instance syntax))
    (if (!= callee no-instance)
      (let row ([] (. session instances rows) callee))
      (if (call is-written (. row module) (. row decl))
        (return (call decl-site (. row module) (. row decl)))
      )
    )
    (let held (call (. session facts node-type) instance object))
    (return-if null (if (== held no-type)))
    (let type (call (. session types optional-inner) held))
    (return-if null (if (== type invalid-type)))
    (let owner
      (match? ([] (. session types rows) type)
        (case (call .type-class row)
          (call DeclRef (. row module) (. row decl))
        )
      )
    )
    (return-if null (if (not owner)))
    (let bindings (use (call Bindings)))
    (let binder (call Binder bindings program builtins))
    (let member (call (. binder member-of-class) (. owner module) (. owner decl) name))
    (if (or (not member) (and (== (. member module) (. owner module)) (== (. member decl) (. owner decl))))
      (let field (call written-field owner name))
      (return (only-if (call site (. owner module) field) (if (!= field 0))))
    )
    (return (call decl-site (. member module) (. member decl)))
  )
  (fn-do _ written-field SyntaxId
    (param owner DeclRef)
    (param name Atom)
    ; A field a class writes in its own declaration, as a tuple written in one line names its fields,
    ; or none.
    (let holder ([] (. program modules) (. owner module)))
    (let root ([] (. holder decls syntax) (. owner decl)))
    (for (in id (..< (call (. holder tree subtree-start) root) root))
      (match? ([] (. holder tree nodes) id)
        (case (call .node-identifier row)
          (return-if id (if (== (. row name) name)))
        )
      )
    )
    (return 0)
  )
  (fn-do _ instance-at InstanceId
    (param session Session)
    (param syntax SyntaxId)
    ; The instance innermost around a node of the module the type pass typed that gave the node a
    ; type, or else the innermost around it, or none. The source of a generator is typed by the
    ; function it is written in, not by the body of the generator around it.
    (let best no-instance)
    (let size (. U32 max))
    (let typed no-instance)
    (let typed-size (. U32 max))
    (for (in position (..< 0 (. session instances length)))
      (let row ([] (. session instances rows) position))
      (let end (+ (. row subtree start) (. row subtree count)))
      (let around (and (>= syntax (. row subtree start)) (< syntax end)))
      (if (and (== (. row module) module) (!= (. row node-start) (. U32 max)) around)
        (let id (as position InstanceId))
        (if (< (. row subtree count) size)
          (= best id)
          (= size (. row subtree count))
        )
        (if (and (< (. row subtree count) typed-size) (!= (call (. session facts node-type) id syntax) no-type))
          (= typed id)
          (= typed-size (. row subtree count))
        )
      )
    )
    (return (if-expr (!= typed no-instance) typed best))
  )
  (fn-do _ callee-at InstanceId
    (param session Session)
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The function the type pass chose to run a member a node reads: a getter or a method read at
    ; the node, or what a call of it runs.
    (let found (call called session instance syntax))
    (return-if found (if (!= found no-instance)))
    (let holder (call (. tree holder-of) syntax))
    (match? ([] (. tree nodes) holder)
      (case (call .node-call-expression row)
        (if (== (. row callable) syntax)
          (return (call called session instance holder))
        )
      )
    )
    (return no-instance)
  )
  (fn-do _ called InstanceId
    (param session Session)
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The first function a call recorded at a node runs that the source names there: one run as a
    ; function, a method, a static method, a constructor, a getter or a setter.
    (let facts (. session facts))
    (let cursor (call (. facts first-call) instance syntax))
    (while (!= cursor no-fact)
      (let call ([] (. facts calls) cursor))
      (= cursor (. call next))
      (let named (or (== (. call form) .call-function) (== (. call form) .call-method) (== (. call form) .call-static)))
      (let accessed (or (== (. call form) .call-getter) (== (. call form) .call-setter)))
      (if (and (!= (. call callee) no-instance) (or named accessed (== (. call form) .call-constructor)))
        (return (. call callee))
      )
    )
    (return no-instance)
  )
  (fn-expr _ is-written Bool
    (param target ModuleId)
    (param decl DeclId)
    ; Whether a function is written in its module's source, and so has a place to go to.
    (match ([] (. ([] (. program modules) target) decls) decl)
      (case (call .decl-function row)
        (not (. row is-generated))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ resolution-site (? DefinitionSite)
    (param bindings Bindings)
    (param resolution Resolution)
    (case? (== kind .resolve-slot)
      (call site module (. ([] (. bindings slots) (. resolution slot)) syntax))
    )
    (case? (or (== kind .resolve-none) (== kind .resolve-unresolved))
      null
    )
    (default
      (call decl-site (. resolution module) (. resolution decl))
    )
    (where
      (lazy kind (. resolution kind))
    )
  )
  (fn-expr _ type-site (? DefinitionSite)
    (param syntax SyntaxId)
    (param name Atom)
    (case? (!= parameter 0)
      (call site module parameter)
    )
    (case? found
      (call decl-site (. found module) (. found decl))
    )
    (default
      (call named-site name)
    )
    (where
      (lazy parameter (call type-parameter syntax name))
      (lazy found (call class-named name))
    )
  )
  (fn-do _ member-site (? DefinitionSite)
    (param object SyntaxId)
    (param name Atom)
    (let receiver-name
      (match? ([] (. tree nodes) object)
        (case (call .node-identifier row)
          (. row name)
        )
        (case (call .node-type-identifier row)
          (. row name)
        )
      )
    )
    (return-if null (if (not receiver-name)))
    (let receiver (call class-named receiver-name))
    (return-if null (if (not receiver)))
    (let bindings (use (call Bindings)))
    (let binder (call Binder bindings program builtins))
    (let function (call bindable-owner object))
    (if (!= function 0)
      (call (. binder bind) module function)
    )
    (let member (call (. binder member-of-class) (. receiver module) (. receiver decl) name))
    (if (or (not member) (and (== (. member module) (. receiver module)) (== (. member decl) (. receiver decl))))
      (let case-syntax (call enum-case receiver name))
      (return-if (call site (. receiver module) case-syntax) (if (!= case-syntax 0)))
    )
    (return-if null (if (not member)))
    (return (call decl-site (. member module) (. member decl)))
  )
  (fn-expr _ case-site (? DefinitionSite)
    (param name Atom)
    (param owner (? Atom))
    (case? (not owner)
      null
    )
    (case? (not receiver)
      null
    )
    (case? (!= case-syntax 0)
      (call site (. receiver module) case-syntax)
    )
    (default
      (call decl-site (. receiver module) (. receiver decl))
    )
    (where
      (lazy receiver (call class-named owner))
      (lazy case-syntax (call enum-case receiver name))
    )
  )
  (fn-do _ enum-case SyntaxId
    (param receiver DeclRef)
    (param name Atom)
    (let holder ([] (. program modules) (. receiver module)))
    (let root ([] (. holder decls syntax) (. receiver decl)))
    (for (in id (..< (call (. holder tree subtree-start) root) root))
      (match? ([] (. holder tree nodes) id)
        (case (call .node-enum-declaration row)
          (return-if id (if (== (. row name) name)))
        )
        (case (call .node-type-case row)
          (return-if id (if (== (. row name) name)))
        )
      )
    )
    (return 0)
  )
  (fn-do _ import-site (? DefinitionSite)
    (param row ASTImport)
    (let name "")
    (for (in offset (..< 0 (. row paths count)))
      (if offset
        (+= name "/")
      )
      (+= name (. ([] (. tree atoms) (+ (. row paths start) offset)) text))
    )
    (return
      (match? (call (. store resolver find-module) name (. owner name) (. owner path))
        (case (tuple _ module-path)
          (call DefinitionSite (str module-path) 0 0)
        )
      )
    )
  )
  (fn-do _ named-site (? DefinitionSite)
    (param name Atom)
    (for (in candidate (call (. program lookup) module name))
      (return (call decl-site (. candidate module) (. candidate decl)))
    )
    (return null)
  )
  (fn-do _ class-named (? DeclRef)
    (param name Atom)
    (for (in candidate (call (. program lookup) module name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case .decl-class
          (return (call DeclRef (. candidate module) (. candidate decl)))
        )
      )
    )
    (return null)
  )
  (fn-do _ type-parameter SyntaxId
    (param syntax SyntaxId)
    (param name Atom)
    (for (in decl (..< 1 (. owner decls length)))
      (match? ([] (. owner decls) decl)
        (case (call .decl-function row)
          (if (call encloses (. row syntax) syntax)
            (let found (call parameter-named (. row type-args) name))
            (return-if found (if (!= found 0)))
          )
        )
        (case (call .decl-class row)
          (if (call encloses (. row syntax) syntax)
            (let found (call parameter-named (. row type-args) name))
            (return-if found (if (!= found 0)))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ parameter-named SyntaxId
    (param args (of RowRange SyntaxId))
    (param name Atom)
    (for (in arg ([] (. tree children) args))
      (match? ([] (. tree nodes) arg)
        (case (call .node-type-identifier row)
          (return-if arg (if (== (. row name) name)))
        )
        (case (call .node-identifier row)
          (return-if arg (if (== (. row name) name)))
        )
      )
    )
    (return 0)
  )
  (fn-do _ bindable-owner DeclId
    (param syntax SyntaxId)
    (let best DeclId 0)
    (let best-start SyntaxId 0)
    (for (in decl (..< 1 (. owner decls length)))
      (let range (call bindable-range ([] (. owner decls) decl)))
      (if (and (!= (. range count) 0) (>= syntax (. range start)) (< syntax (+ (. range start) (. range count))))
        (if (or (== best 0) (>= (. range start) best-start))
          (= best (as decl DeclId))
          (= best-start (. range start))
        )
      )
    )
    (return best)
  )
  (fn-expr _ bindable-range SyntaxRange
    (param decl Decl)
    (match decl
      (case (call .decl-function row)
        (if-expr is-bindable (. row subtree) (call SyntaxRange 0 0))
        (lazy is-bindable (and (or (not (. row is-generated)) (== (. row kind) .main-decl)) (not (call is-nested-kind (. row kind)))))
      )
      (case (call .decl-converter row)
        (call subtree-of (. row syntax))
      )
      (case (call .decl-fromverter row)
        (call subtree-of (. row syntax))
      )
      (default
        (call SyntaxRange 0 0)
      )
    )
  )
  (fn-expr _ subtree-of SyntaxRange
    (param syntax SyntaxId)
    (call SyntaxRange start (+ (- syntax start) 1))
    (where
      (lazy start (call (. tree subtree-start) syntax))
    )
  )
  (fn-expr _ encloses Bool
    (param root SyntaxId)
    (param syntax SyntaxId)
    (and (<= (call (. tree subtree-start) root) syntax) (<= syntax root))
  )
  (fn-do _ decl-site DefinitionSite
    (param target ModuleId)
    (param decl DeclId)
    (= resolved (call DeclRef target decl))
    (return (call site target ([] (. ([] (. program modules) target) decls syntax) decl)))
  )
  (fn-expr _ site DefinitionSite
    (param target ModuleId)
    (param syntax SyntaxId)
    (call DefinitionSite (. holder path) (. loc begin line) (. loc begin column))
    (where
      (lazy holder ([] (. program modules) target))
      (lazy loc ([] (. holder tree nodes loc) syntax))
    )
  )
)

(fn-expr _ shown-type String
  (param types Types)
  (param type TypeId)
  ; A type as an editor shows it: by the names of its class and arguments, an optional by what it
  ; holds with `?`.
  (case? (call (. types is-optional) type)
    (str (call shown-type types (call (. types optional-inner) type)) "?")
  )
  (default
    (call type-short-name types type)
  )
)

(fn-do _ builtin-classes-of BuiltinClasses
  (param program Program)
  ; The classes of core whose members the binder answers itself, as the type pass binds them.
  (let types (use (call Types program (call TypingScratch))))
  (call (. types bind-types))
  (return (. types builtin-classes))
)
