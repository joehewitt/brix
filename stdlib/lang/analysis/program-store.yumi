/lang/ast/module
/lang/ast/module-resolver
/lang/ast/program
/lang/ast/program-builder
/lang/ast/syntax-program
/lang/check/edit-typing
/lang/check/session
/lang/check/typing
/lang/constants
/os/file
/os/path

━━━━━━━━━━━━━━━━━━━━
+ ProgramStore
    is Usable'Void

+ search-paths [Path]
+ parse-worker-count = default-worker-count
+ failures [String = String]
+ resolver ModuleResolver
_ cache ModuleCache
_ view ModuleView
_ c-module-paths [String = [Path]]
_ sources [String = String]
_ assembled Program?
_ previous Program?
_ typed Session?
_ opened [String]
_ entry-path String?
_ released Bool

────────────────────
+ This
    - search-paths [Path]
    - cache ModuleCache

.. resolver = ModuleResolver(search-paths, c-module-paths)
.. view = cache.view()

────────────────────
+ do has Bool
    - path String

. built = program()
= if built then built.module-by-path(path) != null else false

────────────────────
+ do open
    - path String

=? if opened.find(path) != null
if entry-path && !assembled
    program()
opened += path
if holds(path)
    release-typing()
    =
entry-path = path
discard()

────────────────────
+ do update
    - path String
    - text String?

if text
    sources[path] = text
else
    -= sources[path]
=? if !holds(path) && !failures[path]
invalidate()

────────────────────
+ do changed
    - path String?

if path
    =? if sources has path
    =? if !holds(path) && !failures[path]
invalidate()

────────────────────
+ do program Program?

. current = assembled
=? current if current
. entry = entry-path
?! Panic("ProgramStore has no modules")
    if !entry
. roots [(String, String)]
roots += (entry, module-name(entry))
for path in opened
    if path != entry
        roots += (path, module-name(path))
. syntax = use SyntaxProgram(search-paths, c-module-paths)
syntax.use-modules(view)
syntax.keeps-going = true
syntax.sources = sources
syntax.parse-modules(roots, parse-worker-count)
failures = syntax.failures
if !syntax.has-module(syntax.source-path)
    discard()
    view.settle()
    = null
. builder = ProgramBuilder(cache.atoms)
builder.shares-atoms = true
. built = builder.build(syntax)
assembled = built
. superseded = previous
if superseded
    previous = null
    . kept = typed
    if kept
        . refusal = retype-edit(kept, built, false)
        //analysis.retype// retyped ${refusal ?? "in place"}
        if refusal
            release-typing()
    superseded.release()
view.settle()
= built

────────────────────
+ do take-inputs [String = ParseStamp]

= view.take-inputs()

────────────────────
+ do session Session

` The program typed as an editor reads it: from the main of every module, and every function of
` each module opened that takes no type parameters, with the methods of each class of one that
` takes none, so that what no main reaches is typed too. A generic function is typed only for the
` types a call gives it. An edit to the body of one function retypes the session in place.
. built = program()!
. current = typed
=? current if current
. made = Session(built)
seed-mains(made)
for position in 0 .. < built.modules.length
    if opened.find(built.modules[position].path) != null
        seed-functions(made, position as ModuleId)
check-program(made)
typed = made
= made

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    discard()
    view.release()
    released = true

────────────────────
+ do text-of String?
    - path String

. unsaved = sources[path]
=? unsaved if unsaved
= catch? file-text(path)

────────────────────
_ do holds Bool
    - path String

. current = assembled
if !current
    current = previous
=? false if !current
= current.module-by-path(path) != null

────────────────────
_ do invalidate

if !typed
    discard()
    =
. current = assembled
if current
    previous = current
    assembled = null

────────────────────
_ do discard

release-typing()
. current = assembled
if current
    current.release()
    assembled = null
. superseded = previous
if superseded
    superseded.release()
    previous = null

────────────────────
_ do release-typing

. session = typed
if session
    session.release()
    typed = null

────────────────────
_ do module-name String
    - path String

. extension = Path(path).ext
. stem = if extension.length != 0 then path[0 .. < path.length - extension.length - 1] else path
for root in resolver.search-paths
    . prefix = "$root/"
    =? stem[prefix.length ...] if stem.starts-with(prefix)
= Path(stem).name

━━━━━━━━━━━━━━━━━━━━
_ do file-text String ?! Error
    - path String

. file = use File(path)
= file as String
