/lang/check/type-store
/lang/check/type-text
/lang/check/types
/lang/check/typing-scratch
/lang/target

━━━━━━━━━━━━━━━━━━━━
+ DefinitionSite is Tuple

+ path String
+ line U32
+ column U32

━━━━━━━━━━━━━━━━━━━━
