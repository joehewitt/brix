/math

━━━━━━━━━━━━━━━━━━━━
+ CatalogProperty is Tuple

+ name String
+ type String
+ value String
+ line U32
+ is-public Bool

━━━━━━━━━━━━━━━━━━━━
+ CatalogStep is Tuple

+ name String
+ trigger String
+ depth U32
+ line U32
+ is-then Bool

━━━━━━━━━━━━━━━━━━━━
