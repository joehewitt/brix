+ name String
+ line U32
+ steps [CatalogStep]

━━━━━━━━━━━━━━━━━━━━
+ CatalogClass is Tuple

+ name String
+ path String
+ line U32
+ base String
+ is-public Bool
+ interfaces [String]
+ kinds [String]
+ properties [CatalogProperty]
+ machines [CatalogMachine]

━━━━━━━━━━━━━━━━━━━━
+ do program-catalog [CatalogClass]
    - store ProgramStore
    - path String
    - interfaces [String]

store.open(path)
. built = store.program()
=? List'CatalogClass() if !built
. reader = CatalogReader(store, built)
= reader.classes(interfaces)

━━━━━━━━━━━━━━━━━━━━
_ CatalogReader

+ store ProgramStore
+ program Program
_ texts [String = [String]]

────────────────────
+ This
    - store
    - program

────────────────────
+ do classes [CatalogClass]
    - wanted [String]

. found [CatalogClass]
for index in 0 .. < program.modules.length
    . module = program.modules[index]
    for decl in 1 .. < module.decls.length
        match? module.decls[decl]
            | .decl-class(row)
                . ref = DeclRef(index as ModuleId, decl as DeclId)
                . kinds = kinds-of(ref, wanted)
                if kinds.length > 0
                    found += describe(ref, row, kinds)
= found

────────────────────
_ do kinds-of [String]
    - ref DeclRef
    - wanted [String]

. kinds [String]
. current DeclRef? = ref
. depth Size = 0
while current && depth < 64
    . module = program.modules[current.module]
    . next DeclRef? = null
    match? module.decls[current.decl]
        | .decl-class(row)
            for interface in module.syntax-pool[row.interfaces]
                . head = type-head-name(module.tree, interface)
                if head
                    . name = head.text
                    if wanted.find(name) != null && kinds.find(name) == null
                        kinds += name
            if row.base != 0
                . head = type-head-name(module.tree, row.base)
                if head
                    next = class-named(current.module, head)
    current = next
    depth += 1
= kinds

────────────────────
_ do class-named DeclRef?
    - caller ModuleId
    - name Atom

for candidate in program.lookup(caller, name)
    match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-class
            = DeclRef(candidate.module, candidate.decl)
= null

────────────────────
_ do describe CatalogClass
    - ref DeclRef
    - row ClassDecl
    - kinds [String]

. module = program.modules[ref.module]
. tree = module.tree
. base = ""
if row.base != 0
    . head = type-head-name(tree, row.base)
    if head
        base = head.text
. interfaces [String]
for interface in module.syntax-pool[row.interfaces]
    . head = type-head-name(tree, interface)
    if head
        interfaces += head.text
. properties [CatalogProperty]
. machines [CatalogMachine]
for member in module.member-pool[row.members]
    match? module.decls[member]
        | .decl-property(property)
            . name = if property.name then property.name.text else ""
            . line = tree.nodes.loc[property.syntax].begin.line + 1
            if is-machine(tree, property.value)
                machines += CatalogMachine(name, line, machine-steps(module, property.value))
            else
                properties += CatalogProperty
                    - name
                    - text-of(module, property.type-syntax)
                    - text-of(module, property.value)
                    - line
                    - property.access == .public-access
. line = tree.nodes.loc[module.decls.syntax[ref.decl]].begin.line + 1
= CatalogClass
    - row.name.text
    - module.path
    - line
    - base
    - row.access == .public-access
    - interfaces
    - kinds
    - properties
    - machines

────────────────────
_ do is-machine Bool
    - tree AST
    - syntax SyntaxId

=? false if syntax == 0
match? tree.nodes[syntax]
    | .node-state-machine
        = true
= false

────────────────────
_ do machine-steps [CatalogStep]
    - module Module
    - machine SyntaxId

. steps [CatalogStep]
match? module.tree.nodes[machine]
    | .node-state-machine(row)
        add-steps(module, row.body, 0, steps)
= steps

────────────────────
_ do add-steps
    - module Module
    - body RowRange'SyntaxId
    - depth U32
    - steps [CatalogStep]

. tree = module.tree
for child in tree.children[body]
    . line = tree.nodes.loc[child].begin.line + 1
    match? tree.nodes[child]
        | .node-state-case(row)
            steps += CatalogStep(row.name.text, text-of(module, row.trigger), depth, line, false)
            add-steps(module, row.body, depth + 1, steps)
        | .node-state-continuation(row)
            steps += CatalogStep(row.name.text, text-of(module, row.trigger), depth, line, true)
            add-steps(module, row.body, depth + 1, steps)

────────────────────
_ do text-of String
    - module Module
    - syntax SyntaxId

=? "" if syntax == 0
. lines = lines-of(module.path)
. loc = module.tree.nodes.loc[syntax]
. first = loc.begin.line as Size
. last = loc.end.line as Size
=? "" if last < first || last >= lines.length
. parts [String]
for number in first .. last
    . text = lines[number]
    . start = if number == first then loc.begin.column as Size else 0
    . end = if number == last then (loc.end.column as Size) + 1 else text.length
    parts += text[min(start, text.length) .. < min(end, text.length)]
= " ".join(parts).trim()

────────────────────
_ do lines-of [String]
    - path String

. cached = texts[path]
=? cached if cached
. text = store.text-of(path) ?? ""
. lines [String] = text.split("\n")
texts[path] = lines
= lines
