./catalog
./insight
./navigation
./program-store
/data/json
/data/jsonrpc
/lang/ast/module
/lang/report/explain

━━━━━━━━━━━━━━━━━━━━
+ AnalysisService

+ store ProgramStore

────────────────────
+ This
    - store ProgramStore

────────────────────
+ answers Bool
    - method String

is-sync-method || method == "definition" || method == "hover" || method == "catalog" || method == "insight" || method == "explain"

.. is-sync-method = method == "update" || method == "changed" || method == "open"

────────────────────
+ do perform JSON ?! Error
    - method String
    - params JSON

. fields = JSONReader("params", params).object()
if method == "update"
    . text = fields["text"]
    store.update(fields["path"].string(), text.string() if text.is-present)
    = true
if method == "changed"
    . path = fields["path"]
    store.changed(path.string() if path.is-present)
    = true
if method == "open"
    store.open(fields["path"].string())
    = true
if method == "definition"
    . path = fields["path"].string()
    . link = link-at(store, path, fields["line"].int() as U32, fields["column"].int() as U32)
    =? null if !link
    . origin = Map'String'JSON
        • line link.line as Int
        • start link.start as Int
        • end link.end as Int
    . signature = link.signature
    . found = Map'String'JSON
        • path link.target.path
        • line link.target.line as Int
        • column link.target.column as Int
        • origin origin
    if signature
        found["signature"] = signature
    = found
if method == "hover"
    . path = fields["path"].string()
    . shown = hover-at(store, path, fields["line"].int() as U32, fields["column"].int() as U32)
    =? null if !shown
    = Map'String'JSON
        • line shown.line as Int
        • start shown.start as Int
        • end shown.end as Int
        • text shown.text
if method == "catalog"
    . names [String]
    for item in fields["interfaces"].items()
        names += item.string()
    = catalog-json(program-catalog(store, fields["path"].string(), names))
if method == "insight"
    . target = fields["target"]
    . shown = file-insight(store, fields["path"].string(), target.string() if target.is-present)
    =? null if !shown
    = insight-json(shown)
if method == "explain"
    . name = fields["name"]
    . line = fields["line"]
    = explained-text(fields["path"].string(), name.string() if name.is-present, line.int() if line.is-present)
?! JSONRPCError(.method-not-found, "Unknown method $method")

────────────────────
_ do explained-text String
    - path String
    - name String?
    - line Int?

store.open(path)
=? "Nothing could be read from $path" if !store.has(path)
. program = store.program()!
. module = program.module-by-path(path)! as ModuleId
. session = store.session()
if name
    . named = explained-function(program, module, name)
        catch error ExplainError
            = error.message
    = explain-function(session, module, named, store.text-of(program.modules[named.module].path) ?? "")
. at = function-at-line(program, module, ((line ?? 1) - 1) as U32)
=? "No function is written at $path:${line ?? 0}" if !at
= explain-function(session, module, at, store.text-of(program.modules[at.module].path) ?? "")

━━━━━━━━━━━━━━━━━━━━
_ do insight-json JSON
    - shown FileInsight

. marks [JSON]
for mark in shown.marks
    . entry = Map'String'JSON
        • line mark.line as Int
        • start mark.start as Int
        • end mark.end as Int
        • kind if mark.kind == InsightKind.raise then "raise" else "convert"
        • detail mark.detail
    . caption = mark.caption
    if caption
        entry["caption"] = caption
    if mark.errors.length != 0
        entry["errors"] = names-json(mark.errors)
    marks += entry
. unknown [JSON]
for line in shown.unknown
    unknown += line as Int
. fills [JSON]
for fill in shown.fills
    . entry = Map'String'JSON
        • line fill.line as Int
        • type fill.type
        • errors names-json(fill.errors)
    fills += entry
. notes [JSON]
for note in shown.notes
    notes += Map'String'JSON
        • line note.line as Int
        • kind note.kind
        • label note.label
        • text note.text
= Map'String'JSON
    • marks marks
    • unknown unknown
    • fills fills
    • notes notes

━━━━━━━━━━━━━━━━━━━━
_ do names-json JSON
    - names [String]

. found [JSON]
for name in names
    found += name
= found

━━━━━━━━━━━━━━━━━━━━
_ catalog-json JSON
    - classes [CatalogClass]

class-json(each) in classes

━━━━━━━━━━━━━━━━━━━━
_ do class-json JSON
    - entry CatalogClass

. interfaces [JSON]
for name in entry.interfaces
    interfaces += name
. kinds [JSON]
for name in entry.kinds
    kinds += name
. properties [JSON]
for property in entry.properties
    properties += Map'String'JSON
        • name property.name
        • type property.type
        • value property.value
        • line property.line as Int
        • is-public property.is-public
. machines [JSON]
for machine in entry.machines
    . steps [JSON]
    for step in machine.steps
        steps += Map'String'JSON
            • name step.name
            • trigger step.trigger
            • depth step.depth as Int
            • line step.line as Int
            • is-then step.is-then
    machines += Map'String'JSON
        • name machine.name
        • line machine.line as Int
        • steps steps
= Map'String'JSON
    • name entry.name
    • path entry.path
    • line entry.line as Int
    • base entry.base
    • is-public entry.is-public
    • interfaces interfaces
    • kinds kinds
    • properties properties
    • machines machines
