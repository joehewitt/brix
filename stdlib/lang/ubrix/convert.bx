(import ./layout)
(import ./parse)
(import ./ubrix)
(import /code/structure/document)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)

(fn-do + brix-to-ubrix String (?! SexpError)
  (param source String)
  (let document (use (call brix-document-read source)))
  (return (call (. "\n" join) (call (. document view-lines))))
)

(fn-do + ubrix-to-brix String (?! UBrixSyntaxError)
  (param source String)
  (let language (call UBrixLanguage))
  (let store (use (. language store)))
  (return (call sexp-text store (call ubrix-woven language source) (call UBrixLayout store)))
)
