(import /core/parsing)
(import /core/table)
(import /data/source-tree)
(import /stream/aggregate)

(type + UBrixSpans
  (prop _ base U32)
  (prop _ entries (list UBrixSpan))
  (fn-do + This _
    (param store SourceStore)
    (lazy base (. store latest-id))
  )
  (fn-expr + start Index
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (!= slot null) (. ([] entries slot) start) 0)
    (where
      (lazy slot (call find node))
    )
  )
  (fn-expr + end Index
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (!= slot null) (. ([] entries slot) end) 0)
    (where
      (lazy slot (call find node))
    )
  )
  (fn-do + set _
    (param node (of ImmutableTableRow SourceNode))
    (param start Index)
    (param end Index)
    (let id (. node id))
    (return-if (if (<= id base)))
    (let slot (as (- id base 1) Index))
    (while (< (. entries length) slot)
      (+= entries (call UBrixSpan 0 0))
    )
    (if (== slot (. entries length))
      (+= entries (call UBrixSpan start end))
      (else
        (= ([] entries slot) (call UBrixSpan start end))
      )
    )
  )
  (fn-do + extend _
    (param node (of ImmutableTableRow SourceNode))
    (param end Index)
    (call set node (call start node) end)
  )
  (fn-expr _ find (? Index)
    (param node (of ImmutableTableRow SourceNode))
    (case? (<= id base)
      null
    )
    (case? (>= slot (. entries length))
      null
    )
    (default
      slot
    )
    (where
      (lazy id (. node id))
      (lazy slot (as (- id base 1) Index))
    )
  )
)

(type + UBrixBuilder
  (prop + store SourceStore)
  (blank)
  (prop _ spans (? UBrixSpans))
  (fn-do + This _
    (param store _)
    (param spans _ (= null))
  )
  (fn-do + place (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (call span node (+ (as (. location begin line) Index) 1) (+ (as (. location end line) Index) 1))
    (return node)
  )
  (fn-do + atom (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param text String)
    (return (call place location (call (. store atom) text)))
  )
  (fn-do + text (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param value String)
    (return (call place location (call (. store string) value)))
  )
  (fn-do + splice (of ImmutableTableRow SourceNode)
    (param items (list (of ImmutableTableRow SourceNode)))
    (return (call (. store group) 0 items))
  )
  (fn-do + add _
    (param items (list (of ImmutableTableRow SourceNode)))
    (param node (? (of ImmutableTableRow SourceNode)))
    (return-if (if (not node)))
    (if (call is-spliced node)
      (for (in part (call (. store items) node))
        (call add items part)
      )
      (else
        (+= items node)
      )
    )
  )
  (fn-do + many (of ImmutableTableRow SourceNode)
    (param nodes (? (of ImmutableArray (of ImmutableTableRow SourceNode))))
    (let items (list (of ImmutableTableRow SourceNode)))
    (let present (?? nodes (call (of ImmutableArray (of ImmutableTableRow SourceNode)))))
    (for (in node present)
      (call add items node)
    )
    (return (call splice items))
  )
  (fn-do + some (of ImmutableTableRow SourceNode)
    (param nodes (of ImmutableArray (? (of ImmutableTableRow SourceNode))))
    (let items (list (of ImmutableTableRow SourceNode)))
    (for (in node nodes)
      (call add items node)
    )
    (return (call splice items))
  )
  (fn-do + seq (of ImmutableTableRow SourceNode)
    (param a (? (of ImmutableTableRow SourceNode)) (= null))
    (param b (? (of ImmutableTableRow SourceNode)) (= null))
    (param c (? (of ImmutableTableRow SourceNode)) (= null))
    (param d (? (of ImmutableTableRow SourceNode)) (= null))
    (param e (? (of ImmutableTableRow SourceNode)) (= null))
    (param f (? (of ImmutableTableRow SourceNode)) (= null))
    (let items (list (of ImmutableTableRow SourceNode)))
    (call add items a)
    (call add items b)
    (call add items c)
    (call add items d)
    (call add items e)
    (call add items f)
    (return (call splice items))
  )
  (fn-expr + only (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (case? (not (call is-spliced node))
      node
    )
    (case? (!= (call (. store count) node) 1)
      null
    )
    (default
      (call only (call (. store item) node 0))
    )
  )
  (fn-expr + count Size
    (param node (? (of ImmutableTableRow SourceNode)))
    (case? (not node)
      0
    )
    (case? (call is-spliced node)
      (call (. store count) node)
    )
    (default
      1
    )
  )
  (fn-do + form (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param head String)
    (param a (? (of ImmutableTableRow SourceNode)) (= null))
    (param b (? (of ImmutableTableRow SourceNode)) (= null))
    (param c (? (of ImmutableTableRow SourceNode)) (= null))
    (param d (? (of ImmutableTableRow SourceNode)) (= null))
    (param e (? (of ImmutableTableRow SourceNode)) (= null))
    (param f (? (of ImmutableTableRow SourceNode)) (= null))
    (param g (? (of ImmutableTableRow SourceNode)) (= null))
    (param h (? (of ImmutableTableRow SourceNode)) (= null))
    (let first (+ (call count a) (call count b) (call count c) (call count d)))
    (let items (list (of ImmutableTableRow SourceNode)))
    (call (. items reserve) (+ 1 first (call count e) (call count f) (call count g) (call count h)))
    (+= items (call (. store atom) head))
    (call add items a)
    (call add items b)
    (call add items c)
    (call add items d)
    (call add items e)
    (call add items f)
    (call add items g)
    (call add items h)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + group (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param a (? (of ImmutableTableRow SourceNode)) (= null))
    (param b (? (of ImmutableTableRow SourceNode)) (= null))
    (let items (list (of ImmutableTableRow SourceNode)))
    (call add items a)
    (call add items b)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + blank-slot (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (? (of ImmutableTableRow SourceNode)))
    (return (?? node (call atom location "_")))
  )
  (fn-do + flag (? (of ImmutableTableRow SourceNode))
    (param location MatchLocation)
    (param name String)
    (param is-set Bool)
    (return-if null (if (not is-set)))
    (return (call atom location name))
  )
  (fn-do + pair (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param op String)
    (param right (of ImmutableTableRow SourceNode))
    (param helper (? (of ImmutableTableRow SourceNode)) (= null))
    (let items (list (of ImmutableTableRow SourceNode)))
    (+= items (call mark op))
    (+= items right)
    (call add items helper)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + chain (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param left (of ImmutableTableRow SourceNode))
    (param tails (of ImmutableArray (of ImmutableTableRow SourceNode)))
    (let result left)
    (let previous "")
    (for (in tail tails)
      (let op (call (. store text) (call (. store item) tail 0)))
      (let items (list (of ImmutableTableRow SourceNode)))
      (if (== op previous)
        (++= items (call (. store listed) result))
        (else
          (+= items (call (. store atom) op))
          (+= items result)
        )
      )
      (for (in item (call (. store listed) tail 1))
        (call add items item)
      )
      (= result (call place location (call (. store list) items)))
      (= previous op)
    )
    (return result)
  )
  (fn-do + prefixed (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param ops (of ImmutableArray String))
    (param operand (of ImmutableTableRow SourceNode))
    (let result operand)
    (let index (. ops length))
    (while (> index 0)
      (-= index 1)
      (let op ([] ops index))
      (if (and (== op "-") (call (. store is-atom) result) (call ubrix-is-number (call (. store text) result)))
        (= result (call atom location (str "-" (call (. store text) result))))
        (else
          (= result (call form location op result))
        )
      )
    )
    (return result)
  )
  (fn-do + suffixed (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (param suffix (? String))
    (return-if node (if (not suffix)))
    (return
      (match suffix
        (case= "?"
          (call form location "?" node)
        )
        (case= "[]?"
          (call form location "?" (call form location "[]" node))
        )
        (case= "[]"
          (call form location "[]" node)
        )
        (default
          (call form location "channel" node)
        )
      )
    )
  )
  (fn-do + applied (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (param params (? (of ImmutableTableRow SourceNode)))
    (return-if node (if (== (call count params) 0)))
    (return (call form location "of" node params))
  )
  (fn-expr + is-call Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-form) node "call") (not (call is-part node)))
  )
  (fn-do + call (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param callee (of ImmutableTableRow SourceNode))
    (param params (? (of ImmutableTableRow SourceNode)) (= null))
    (param args (? (of ImmutableTableRow SourceNode)) (= null))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "call") (call applied location callee params)))
    (call add items args)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + auto-call (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param target (of ImmutableTableRow SourceNode))
    (param params (? (of ImmutableTableRow SourceNode)) (= null))
    (param args (? (of ImmutableTableRow SourceNode)) (= null))
    (return-if target (if (and (== (call count params) 0) (== (call count args) 0))))
    (if (and (== (call count params) 0) (call is-call target))
      (let items (call (. store listed) target))
      (call add items args)
      (return (call place location (call (. store list) items)))
    )
    (let rows (only-if (call only args) (if (and (!= args null) (== (call count params) 0)))))
    (return-if (call form location "scope" target (call body rows)) (if (and (!= rows null) (call ubrix-is-scope store rows))))
    (return (call call location target params args))
  )
  (fn-do + member (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param left (of ImmutableTableRow SourceNode))
    (param op String)
    (param name (of ImmutableTableRow SourceNode))
    (return-if (call form location op left name) (if (or (!= op ".") (not (call (. store is-form) left ".")) (call is-part left))))
    (let items (call (. store listed) left))
    (+= items name)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + named (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param name String)
    (param is-optional Bool)
    (param value (? (of ImmutableTableRow SourceNode)) (= null))
    (return (call form location (str ":" name (if-expr is-optional "?" "")) value))
  )
  (fn-do + body (? (of ImmutableTableRow SourceNode))
    (param node (? (of ImmutableTableRow SourceNode)))
    (return-if null (if (not node)))
    (return-if node (if (not (call (. store is-form) node "block"))))
    (return (call splice (call (. store listed) node 1)))
  )
  (fn-do + inline-body (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (return-if (call seq (call body node)) (if (or (call (. store is-form) node "block") (call (. store is-form) node "inline"))))
    (return (call form location "inline" node))
  )
  (fn-do + rehead (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param head String)
    (let parts (call (. store items) node))
    (if (and (call is-spliced node) (> (. parts length) 0))
      (let spread (call (of List (of ImmutableTableRow SourceNode)) (call rehead ([] parts 0) head)))
      (for (in index (..< 1 (. parts length)))
        (+= spread ([] parts index))
      )
      (return (call splice spread))
    )
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) head)))
    (for (in index (..< 1 (. parts length)))
      (+= items ([] parts index))
    )
    (let next (call (. store list) items))
    (call span next (call start-of node) (call end-of node))
    (return next)
  )
  (fn-do + wrap (? (of ImmutableTableRow SourceNode))
    (param location MatchLocation)
    (param head String)
    (param node (? (of ImmutableTableRow SourceNode)))
    (return-if null (if (not node)))
    (return (call form location head node))
  )
  (fn-do + under (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (param head (? String))
    (return-if node (if (not head)))
    (return (call form location head node))
  )
  (fn-do + joined (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param head String)
    (param first (of ImmutableTableRow SourceNode))
    (param rest (? (of ImmutableArray (of ImmutableTableRow SourceNode))))
    (let present (?? rest (call (of ImmutableArray (of ImmutableTableRow SourceNode)))))
    (return-if first (if (== (. present length) 0)))
    (return (call form location head first (call many present)))
  )
  (fn-do + loop (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param clauses (of ImmutableTableRow SourceNode))
    (param block (? (of ImmutableTableRow SourceNode)))
    (return-if (call form location "for" clauses (call body block)) (if (not (call (. store is-form) clauses "and-for"))))
    (let made (list (of ImmutableTableRow SourceNode)))
    (let parts (call (. store listed) clauses))
    (let last (- (. parts length) 1))
    (for (in index (..< 1 (. parts length)))
      (let clause ([] parts index))
      (let items
        (call (of List (of ImmutableTableRow SourceNode))
          (block
            (arg (call (. store atom) (if-expr (== index 1) "for" "and-for")))
            (arg clause)
          )
        )
      )
      (if (== index last)
        (call add items (call body block))
      )
      (let next (call (. store list) items))
      (let end (if-expr (== index last) (+ (as (. location end line) Index) 1) (call end-of clause)))
      (call span next (call start-of clause) end)
      (+= made next)
    )
    (return (call splice made))
  )
  (fn-do + arms (of ImmutableTableRow SourceNode)
    (param clauses (of ImmutableTableRow SourceNode))
    (return-if clauses (if (not (call (. store is-form) clauses "and-for"))))
    (let parts (call (. store listed) clauses))
    (let made (call (of List (of ImmutableTableRow SourceNode)) ([] parts 1)))
    (for (in index (..< 2 (. parts length)))
      (let clause ([] parts index))
      (let next (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "and-for") clause)))
      (call span next (call start-of clause) (call end-of clause))
      (+= made next)
    )
    (return (call splice made))
  )
  (fn-do + armed (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param head (of ImmutableTableRow SourceNode))
    (param arms (? (of ImmutableTableRow SourceNode)) (= null))
    (let parts (list (of ImmutableTableRow SourceNode)))
    (call add parts head)
    (call add parts arms)
    (return-if ([] parts 0) (if (== (. parts length) 1)))
    (let items (call (. store listed) ([] parts 0)))
    (for (in index (..< 1 (. parts length)))
      (+= items ([] parts index))
    )
    (return (call place location (call (. store list) items)))
  )
  (fn-do + bracket (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param items (of ImmutableTableRow SourceNode))
    (let first (only-if (call (. store item) items 0) (if (== (call (. store count) items) 1))))
    (return-if (call form location "list" items) (if (or (not first) (not (call (. store is-form) first "=")) (!= (call (. store count) first) 3))))
    (return (call form location "map" (call (. store item) first 1) (call (. store item) first 2)))
  )
  (fn-do + tuple (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param values (of ImmutableArray (of ImmutableTableRow SourceNode)))
    (return-if ([] values 0) (if (== (. values length) 1)))
    (return (call form location "tuple" (call many values)))
  )
  (fn-do + invoke (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param callee (of ImmutableTableRow SourceNode))
    (param args (? (of ImmutableTableRow SourceNode)))
    (return-if callee (if (not args)))
    (return (call call location callee null args))
  )
  (fn-do + caught (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param previous (of ImmutableTableRow SourceNode))
    (param capture (? (of ImmutableTableRow SourceNode)))
    (return-if (call blank-slot location capture) (if (== (call count previous) 0)))
    (return (call form location "caught" (call blank-slot location capture) previous))
  )
  (fn-do + function-head String
    (param is-imperative Bool)
    (param key (of ImmutableTableRow SourceNode))
    (return-if (call ubrix-callable-head store key is-imperative) (if (not (call is-spliced key))))
    (for (in item (call (. store items) key))
      (return-if (if-expr is-imperative "fn-do" "fn-expr") (if (call (. store is-form) item "over:")))
    )
    (return (call ubrix-callable-head store (call (. store item) key 0) is-imperative))
  )
  (fn-do + declared (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param word String)
    (param left (of ImmutableTableRow SourceNode))
    (param right (? (of ImmutableTableRow SourceNode)) (= null))
    (let parts (call (. store items) left))
    (let is-typed (and (call (. store is-form) left ":") (== (. parts length) 3) (call (. store is-atom) ([] parts 1)) (not (call ubrix-is-pattern-form store ([] parts 2)))))
    (return-if (call form location word ([] parts 1) ([] parts 2) right) (if (and is-typed (or (!= right null) (call ubrix-is-type-form store ([] parts 2))))))
    (return-if (call form location word left (call atom location "_") right) (if (and right (call (. store is-atom) left) (call ubrix-is-type-form store right))))
    (return (call form location word left right))
  )
  (fn-do + capture (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param id (of ImmutableTableRow SourceNode))
    (param type (? (of ImmutableTableRow SourceNode)))
    (param prefix String (= ""))
    (let named id)
    (if (> (. prefix length) 0)
      (= named (call atom location (str prefix (call (. store text) id))))
    )
    (return-if named (if (not type)))
    (return (call form location ":" named type))
  )
  (fn-do + case-pattern (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param name String)
    (param owner (? (of ImmutableTableRow SourceNode)) (= null))
    (param value (? (of ImmutableTableRow SourceNode)) (= null))
    (let callee (call atom location (str "." name)))
    (if owner
      (= callee (call form location "." owner (call atom location name)))
    )
    (return-if callee (if (not value)))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "call") callee))
    (if (call (. store is-form) value "tuple")
      (++= items (call (. store listed) value 1))
      (else
        (+= items value)
      )
    )
    (return (call place location (call (. store list) items)))
  )
  (fn-do + param (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param parts (of ImmutableTableRow SourceNode))
    (param marker (? (of ImmutableTableRow SourceNode)) (= null))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "param")))
    (call add items marker)
    (call add items parts)
    (return (call place location (call (. store list) items)))
  )
  (fn-do + partial (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param params (? (of ImmutableTableRow SourceNode)) (= null))
    (param args (? (of ImmutableTableRow SourceNode)) (= null))
    (param is-bare Bool (= false))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (?? params (call seq)) (?? args (call seq))))
    (if is-bare
      (+= items (call (. store atom) "bare"))
    )
    (return (call place location (call (. store list) items)))
  )
  (fn-do + completed (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param left (of ImmutableTableRow SourceNode))
    (param right (? (of ImmutableTableRow SourceNode)))
    (return-if left (if (not right)))
    (return-if (call auto-call location left (call (. store item) right 0) (call (. store item) right 1)) (if (call is-args right)))
    (return (call form location (call (. store text) (call (. store item) right 0)) left (call (. store item) right 1)))
  )
  (fn-do + access (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param head (of ImmutableTableRow SourceNode))
    (param tails (of ImmutableArray (of ImmutableTableRow SourceNode)))
    (let result head)
    (for (in tail tails)
      (let next result)
      (if (call is-args tail)
        (if (> (call (. store count) tail) 2)
          (= next (call applied location result (call (. store item) tail 0)))
          (else
            (= next (call call location result (call (. store item) tail 0) (call (. store item) tail 1)))
          )
        )
        (else
          (let op (call (. store text) (call (. store item) tail 0)))
          (if (== op "!!")
            (= next (call form location "!!" result))
            (else-if (or (== op "[]") (== op "?[]"))
              (= next (call form location op result (call (. store item) tail 1)))
            )
            (else
              (= next (call member location result op (call (. store item) tail 1)))
            )
          )
        )
      )
      (call span next (call start-of next) (call end-of tail))
      (= result next)
    )
    (return result)
  )
  (fn-do + forced (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (param ops (? (of ImmutableArray String)))
    (let result node)
    (let present (?? ops (call (of ImmutableArray String))))
    (for (in index (..< 0 (. present length)))
      (= result (call form location "!!" result))
    )
    (return result)
  )
  (fn-do + owned (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param node (of ImmutableTableRow SourceNode))
    (param members (of ImmutableArray (of ImmutableTableRow SourceNode)))
    (let result node)
    (for (in item members)
      (= result (call member location result "." item))
    )
    (return result)
  )
  (fn-do + char (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param value String)
    (let bytes (call byte-view value))
    (if (== (. bytes length) 1)
      (let byte ([] bytes 0))
      (let is-visible (and (> byte 32) (< byte 127)))
      (let is-special (or (== byte 34) (== byte 39) (== byte 40) (== byte 41) (== byte 59) (== byte 92)))
      (if (and is-visible (not is-special))
        (return (call atom location (str "'" value "'")))
      )
    )
    (return (call form location "char" (call text location value)))
  )
  (fn-do + string (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param head String)
    (param parts (of ImmutableTableRow SourceNode))
    (let items (list (of ImmutableTableRow SourceNode)))
    (let run (list String))
    (let has-embed false)
    (for (in part (call (. store items) parts))
      (if (call (. store is-text) part)
        (+= run (call (. store text) part))
        (else
          (if (> (. run length) 0)
            (+= items (call (. store string) (call (. "" join) run)))
            (= run (call (of List String)))
          )
          (+= items part)
          (= has-embed true)
        )
      )
    )
    (if (and (not has-embed) (== head "str"))
      (return (call text location (call (. "" join) run)))
    )
    (if (> (. run length) 0)
      (+= items (call (. store string) (call (. "" join) run)))
    )
    (return (call form location head (call splice items)))
  )
  (fn-do + embed (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param expr (of ImmutableTableRow SourceNode))
    (return-if expr (if (not (call (. store is-text) expr))))
    (return (call form location "str" expr))
  )
  (fn-do + paragraph (of ImmutableTableRow SourceNode)
    (param location MatchLocation)
    (param parts (of ImmutableTableRow SourceNode))
    (let lines (list (of ImmutableTableRow SourceNode)))
    (let line (list (of ImmutableTableRow SourceNode)))
    (for (in part (call (. store items) parts))
      (if (not (call (. store is-text) part))
        (+= line part)
        (continue)
      )
      (let pieces (list String))
      (for (in piece (call (. (call (. store text) part) split) "\n"))
        (+= pieces piece)
      )
      (for (in index (..< 0 (. pieces length)))
        (if (> index 0)
          (+= lines (call paragraph-line line))
          (= line (call (of List (of ImmutableTableRow SourceNode))))
        )
        (if (> (. ([] pieces index) length) 0)
          (if (and (> (. line length) 0) (call (. store is-text) ([] line (- (. line length) 1))))
            (let joined (call (. line pop)))
            (+= line (call (. store string) (++ (call (. store text) joined) ([] pieces index))))
            (else
              (+= line (call (. store string) ([] pieces index)))
            )
          )
        )
      )
    )
    (if (> (. line length) 0)
      (+= lines (call paragraph-line line))
    )
    (while (and (> (. lines length) 0) (call (. store is-blank) ([] lines (- (. lines length) 1))))
      (call (. lines pop))
    )
    (return (call form location "paragraph" (call splice lines)))
  )
  (fn-do _ span _
    (param node (of ImmutableTableRow SourceNode))
    (param start Index)
    (param end Index)
    (let kept spans)
    (if kept
      (call (. kept set) node start end)
    )
  )
  (fn-expr _ start-of Index
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (!= kept null) (call (. kept start) node) 0)
    (where
      (lazy kept spans)
    )
  )
  (fn-expr _ end-of Index
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (!= kept null) (call (. kept end) node) 0)
    (where
      (lazy kept spans)
    )
  )
  (fn-expr _ is-args Bool
    (param node (of ImmutableTableRow SourceNode))
    (match (call (. store items) node)
      (case (list (call .list 0 _ _) ...)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-spliced Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list 0 _ _)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-part Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (call is-spliced node) is-led)
    (where
      (lazy is-led
        (match (call (. store items) node)
          (case (list (call .atom 0 _) ...)
            true
          )
          (case (list (call .list 0 _ _) ...)
            true
          )
          (default
            false
          )
        )
      )
    )
  )
  (fn-do _ mark (of ImmutableTableRow SourceNode)
    (param text String)
    (return (call (. store place) (call (. SourceNode atom) 0 (call (. store name) text))))
  )
  (fn-do _ paragraph-line (of ImmutableTableRow SourceNode)
    (param parts (list (of ImmutableTableRow SourceNode)))
    (return-if (call (. store blank)) (if (== (. parts length) 0)))
    (return-if ([] parts 0) (if (and (== (. parts length) 1) (call (. store is-text) ([] parts 0)))))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "str")))
    (++= items parts)
    (return (call (. store list) items))
  )
)

(fn-expr + ubrix-is-number Bool
  (param text String)
  (and (> (. bytes length) 0) (or is-digit is-fraction))
  (where
    (lazy bytes (call byte-view text))
    (lazy first ([] bytes 0))
    (lazy is-digit (and (>= first 48) (<= first 57)))
    (lazy is-fraction (and (== first 46) (> (. bytes length) 1) (>= ([] bytes 1) 48) (<= ([] bytes 1) 57)))
  )
)

(fn-do + ubrix-is-scope Bool
  (param store SourceStore)
  (param block (of ImmutableTableRow SourceNode))
  (return-if false (if (not (call (. store is-form) block "block"))))
  (let items (call (. store items) block))
  (return (call all (..< 1 (. items length)) (:where (call ubrix-is-scope-row store ([] items each)))))
)

(fn-expr + ubrix-is-arm Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (or (== head "else-if") (== head "else") (== head "and-for") (== head "or-for") (== head "on-failure"))
  (where
    (lazy head (?? (call (. store head) node) ""))
  )
)

(fn-expr + ubrix-takes-arm Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param arm (of ImmutableTableRow SourceNode))
  (case? (== head "and-for")
    (or is-loop (call (. store is-form) node "subscribe-for"))
  )
  (case? (== head "or-for")
    is-loop
  )
  (case? (== head "on-failure")
    (or (call (. store is-form) node "do-new") (call (. store is-form) node "do-new-thread"))
  )
  (default
    (call (. store is-form) node "if")
  )
  (where
    (lazy head (?? (call (. store head) arm) ""))
    (lazy is-loop (or (call (. store is-form) node "for") (call (. store is-form) node "iterate")))
  )
)

(fn-expr + ubrix-callable-head String
  (param store SourceStore)
  (param name (of ImmutableTableRow SourceNode))
  (param is-imperative Bool)
  (if-expr (or is-imperative is-made) "fn-do" "fn-expr")
  (where
    (lazy made (if-expr (and (call (. store is-form) name "of") (> (call (. store count) name) 1)) (call (. store item) name 1) name))
    (lazy is-made (and (call (. store is-atom) made) (== (call (. store text) made) "This")))
  )
)

(fn-do + ubrix-is-type-form Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (if (call (. store is-atom) node)
    (let text (call (. store text) node))
    (return
      (scope (or (and (not (< text "A")) (< text "[") (not (call (. text starts-with) "C:"))) is-quoted)
        (lazy is-quoted (and (> (. text length) 2) (call (. text starts-with) "''")))
      )
    )
  )
  (let head (?? (call (. store head) node) ""))
  (return-if true (if (has (list "channel" "fn-type" "c-fn-type" "c-struct" "exact" "similar") head)))
  (return-if false (if (< (call (. store count) node) 2)))
  (return-if false (if (not (has (list "list" "?" "of" "map" "tuple" "[]" "stream" ".") head))))
  (for (in index (..< 1 (call (. store count) node)))
    (let item (call (. store item) node index))
    (let is-field
      (scope (and (== head "tuple") (call (. store is-form) item ":") (== (call (. store count) item) 3) is-named)
        (lazy is-named (call (. store is-atom) (call (. store item) item 1)))
      )
    )
    (return-if false (if (not (call ubrix-is-type-form store (if-expr is-field (call (. store item) item 2) item)))))
  )
  (return true)
)

(fn-expr + ubrix-is-pattern-form Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (case? (call (. store is-atom) node)
    (call (. (call (. store text) node) starts-with) "..")
  )
  (default
    (has (list "all" "|" "{}" "~") (?? (call (. store head) node) ""))
  )
)

(fn-do + ubrix-iterate-body Size
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (let items (call (. store items) node))
  (for (in index (..< 1 (. items length)))
    (return-if index (if (call (. store is-form) ([] items index) "block")))
  )
  (return (. items length))
)

(fn-do + ubrix-arm-start Size
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (let items (call (. store items) node))
  (let index (. items length))
  (while (and (> index 0) (call ubrix-is-arm store ([] items (- index 1))) (call ubrix-takes-arm store node ([] items (- index 1))))
    (-= index 1)
  )
  (return index)
)

(fn-expr + ubrix-is-scope-row Bool
  (param store SourceStore)
  (param row (of ImmutableTableRow SourceNode))
  (or is-comment (call (. store is-blank) row) (== head "lazy") (== head "on-error") (== head "throw"))
  (where
    (lazy head (?? (call (. store head) row) ""))
    (lazy is-comment (call (. store is-comment) row))
  )
)

(fn-expr + ubrix-unescape String
  (param c Char)
  (match c
    (case= 't'
      "\t"
    )
    (case= 'n'
      "\n"
    )
    (case= 'r'
      "\r"
    )
    (case= 'b'
      "\x08"
    )
    (case= 'f'
      "\x0c"
    )
    (case= 'v'
      "\x0b"
    )
    (case= '/'
      "/"
    )
    (case= (char "\\")
      "\\"
    )
    (case= '$'
      "\$"
    )
    (case= (char "\"")
      "\""
    )
    (case= (char "'")
      "'"
    )
    (default
      ""
    )
  )
)

(type _ UBrixSpan (is Tuple)
  (prop + start Index)
  (prop + end Index)
)
