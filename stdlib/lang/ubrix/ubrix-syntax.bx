(import ./build)
(import ./grammar)
(import ./parse)
(import /code/structure/rows)
(import /core/table)
(import /data/source-tree)
(import /stream/aggregate)
(blank)
(prop _ ubrix-keywords List
  (block
    (item "if")
    (item "else")
    (item "while")
    (item "for")
    (item "in")
    (item "on")
    (item "do")
    (item "match")
    (item "is")
    (item "as")
    (item "has")
    (item "not")
    (item "and")
    (item "or")
    (item "use")
    (item "catch")
    (item "with")
    (item "without")
    (item "by")
    (item "of")
    (item "to")
    (item "from")
    (item "into")
    (item "when")
    (item "whenever")
    (item "until")
    (item "new")
    (item "static")
    (item "get")
    (item "extend")
    (item "event")
    (item "keyed")
    (item "throws")
    (item "break")
    (item "continue")
    (item "true")
    (item "false")
    (item "this")
    (item "This")
    (item "using")
    (item "sees")
    (item "each")
    (item "then")
    (item "finally")
    (item "where")
  )
)

(fn-expr + ubrix-highlight (list SourceSpan)
  (param text String)
  (match text
    (~ (: spans (call \ubrix-highlight-grammar text false))
      (call ubrix-joined (call List spans))
    )
    (default
      (inline (call (of List SourceSpan) (call SourceSpan .plain text)))
    )
  )
)

(fn-expr + ubrix-highlight-line (list SourceSpan)
  (param text String)
  (match text
    (~ (: spans (call \ubrix-highlight-grammar text true))
      (call ubrix-joined (call List spans))
    )
    (default
      (inline (call (of List SourceSpan) (call SourceSpan .string text)))
    )
  )
)

(fn-do + ubrix-joined (list SourceSpan)
  (param spans (list SourceSpan))
  (let is-next-joined false)
  (let index (- (. spans length) 1))
  (while (> index 0)
    (-= index 1)
    (let sigil (. ([] spans index) text))
    (let next ([] spans (+ index 1)))
    (let is-joined (and (!= (. ([] spans index) kind) (. SourceSpanKind string)) (call ubrix-is-sigil sigil) (or is-next-joined (call ubrix-starts-name (. next text))) (call ubrix-is-prefix spans index)))
    (if is-joined
      (let kind (if-expr (== sigil "#") (. SourceSpanKind tracked) (. next kind)))
      (= ([] spans index) (call SourceSpan kind sigil))
      (= ([] spans (+ index 1)) (call SourceSpan kind (. next text) (. next is-optional)))
    )
    (= is-next-joined is-joined)
  )
  (for (in at (..< 0 (. spans length)))
    (if (call ubrix-is-optional spans at)
      (let span ([] spans at))
      (= ([] spans at) (call SourceSpan (. span kind) (. span text) true))
    )
  )
  (return spans)
)

(fn-expr _ ubrix-is-sigil Bool
  (param text String)
  (and (== (. text length) 1) (or (== first '#') (== first '@') (== first '$') (== first '%') (== first '&') (== first '!') (== first '.')))
  (where
    (lazy first ([] text 0))
  )
)

(fn-do _ ubrix-is-optional Bool
  (param spans (list SourceSpan))
  (param index Index)
  (let span ([] spans index))
  (return-if false (if (and (not (call ubrix-starts-name (. span text))) (!= (. span text) "?") (!= (. span text) "."))))
  (let before (if-expr (> index 0) ([] spans (- index 1)) (call SourceSpan .plain "")))
  (let next (if-expr (< (+ index 1) (. spans length)) (. ([] spans (+ index 1)) text) ""))
  (return-if (== (. span kind) (. SourceSpanKind identifier)) (if (== (. span text) "null")))
  (return-if (or (== (. before kind) (. SourceSpanKind type-name)) (== next ".") (== next "[")) (if (== (. span text) "?")))
  (return-if (== (. before text) "?") (if (== (. span text) ".")))
  (return-if (or (call ubrix-is-chain spans (+ index 1)) (and (== next "?") (== (. span kind) (. SourceSpanKind type-name)))) (if (call ubrix-starts-name (. span text))))
  (return false)
)

(fn-expr _ ubrix-is-chain Bool
  (param spans (list SourceSpan))
  (param index Index)
  (and (< index (. spans length)) (== (. ([] spans index) text) "?") (< (+ index 1) (. spans length)) (or (== (. ([] spans (+ index 1)) text) ".") (== (. ([] spans (+ index 1)) text) "[")))
)

(fn-expr _ ubrix-starts-name Bool
  (param text String)
  (and (> (. text length) 0) (or (and (>= first 'a') (<= first 'z')) (and (>= first 'A') (<= first 'Z'))))
  (where
    (lazy first ([] text 0))
  )
)

(fn-do _ ubrix-is-prefix Bool
  (param spans (list SourceSpan))
  (param index Index)
  (return-if true (if (or (== index 0) (== (. ([] spans index) text) "\$"))))
  (let before (. ([] spans (- index 1)) text))
  (return-if true (if (== (. before length) 0)))
  (let last ([] before (- (. before length) 1)))
  (return-if false (if (or (call ubrix-starts-name (str last)) (and (>= last '0') (<= last '9')))))
  (return-if false (if (or (== last (char ")")) (== last ']') (== last '}') (== last (char "\"")) (== last (char "'")) (== last '_'))))
  (return (or (!= (. ([] spans index) text) ".") (not (or (== last '?') (== last '!') (== last '*')))))
)

(fn-do + ubrix-highlight-head (list SourceSpan)
  (param text String)
  (let spans (list SourceSpan))
  (let is-named false)
  (for (in span (call ubrix-head-spans text))
    (let is-word (or (== (. span kind) (. SourceSpanKind identifier)) (== (. span kind) (. SourceSpanKind type-name))))
    (if (and is-word (not is-named))
      (+= spans (call SourceSpan (if-expr (== (. span kind) (. SourceSpanKind type-name)) (. SourceSpanKind type-definition) (. SourceSpanKind definition)) (. span text)))
      (= is-named true)
      (else
        (+= spans span)
      )
    )
  )
  (return spans)
)

(fn-do _ ubrix-head-spans (list SourceSpan)
  (param text String)
  (let mark (call ubrix-text-body-mark text))
  (return-if (call ubrix-highlight text) (if (not mark)))
  (return (++ (call ubrix-highlight ([] text (..< 0 mark))) (call (of List SourceSpan) (call SourceSpan .string "\"")) (call ubrix-highlight ([] text (... (+ mark 1))))))
)

(fn-do _ ubrix-text-body-mark (? Index)
  (param text String)
  (let at Index 0)
  (while (and (< at (. text length)) (== ([] text at) (char " ")))
    (+= at 1)
  )
  (return-if (if (or (>= at (. text length)) (and (!= ([] text at) '+') (!= ([] text at) '_')))))
  (+= at 1)
  (let spaces at)
  (while (and (< at (. text length)) (== ([] text at) (char " ")))
    (+= at 1)
  )
  (return-if (if (or (== at spaces) (>= (+ at 1) (. text length)) (!= ([] text at) (char "\"")) (!= ([] text (+ at 1)) (char " ")))))
  (return at)
)

(fn-expr _ ubrix-highlight-grammar (of ImmutableArray SourceSpan) (over: Char)
  (param source String)
  (param is-text Bool)
  (~ (seq (& (\{} is-text)) (* (| (: ...spans \text-run) (call \text-name (into spans)) (call \text-code (into spans)))) (! .))
    spans
  )
  (~ (seq (? (: ...spans \space)) (? (call \row-pattern (into spans))) (* (| (call \code-item (into spans)) (call \stray (into spans)))) (! .))
    spans
  )
  (where
    (lazy text-name Bool
      (pattern
        (~ (seq (& (seq "\$" (chars "a-z"))) (: ...spans \text-mark) (: ...spans \text-word) (* (seq (& (seq (? "?") "." (chars "a-zA-Z_"))) (? (seq (& "?") (: ...spans \loose))) (: ...spans \loose) (: ...spans \text-word))))
          true
        )
      )
    )
    (blank)
    (lazy text-code Bool
      (pattern
        (~ (seq (& "\${") (: ...spans \text-mark) (* (| (call \code-item (into spans)) (seq (! "}") (call \stray (into spans))))) (? (seq (& "}") (: ...spans \text-mark))))
          true
        )
      )
    )
    (blank)
    (lazy code-item Bool
      (pattern
        (~ (seq (: ...spans \space) (? (call \pattern (into spans))))
          true
        )
        (~ (seq (: ...spans \joined) (? (: ...spans \tick)))
          true
        )
        (~ (seq (: ...spans \opener) (? (call \pattern (into spans))) (* (call \code-item (into spans))) (? (call \stray (into spans))))
          true
        )
        (~ (call \quoted (into spans))
          true
        )
        (~ (: ...spans \loose)
          true
        )
      )
    )
    (blank)
    (lazy quoted Bool
      (pattern
        (~ (seq (: ...spans \quote) (* (| (: ...spans \quoted-run) (call \text-name (into spans)) (call \text-code (into spans)))) (? (: ...spans \quote)))
          true
        )
      )
    )
    (blank)
    (lazy stray Bool
      (pattern
        (~ (seq (: ...spans \closer) (? (: ...spans \tick)))
          true
        )
      )
    )
    (blank)
    (lazy row-pattern Bool
      (pattern
        (~ (seq (call \pattern (into spans)) (* (seq (| (call \stray (into spans)) (seq (& ",") (: ...spans \loose))) (* (call \pattern-item (into spans))))))
          true
        )
      )
    )
    (blank)
    (lazy pattern Bool
      (pattern
        (~ (seq (& "~ ") (: ...spans \loose) (* (call \pattern-item (into spans))))
          true
        )
      )
    )
    (blank)
    (lazy pattern-item Bool
      (pattern
        (~ (: ...spans \space)
          true
        )
        (~ (seq (: ...spans \pattern-word) (? (: ...spans \tick)))
          true
        )
        (~ (seq (& "\\{") (: ...spans \pattern-leaf) (call \pattern-code (into spans)))
          true
        )
        (~ (seq (: ...spans \rule-name) (* (seq (: ...spans \tick) (? (: ...spans \joined)))) (? (call \pattern-arguments (into spans))))
          true
        )
        (~ (seq (& "\$") (: ...spans \pattern-leaf) (? (: ...spans \joined)))
          true
        )
        (~ (seq (& "(") (: ...spans \opener) (* (call \pattern-item (into spans))) (? (call \stray (into spans))))
          true
        )
        (~ (call \pattern-code (into spans))
          true
        )
        (~ (call \quoted (into spans))
          true
        )
        (~ (: ...spans \pattern-leaf)
          true
        )
      )
    )
    (blank)
    (lazy pattern-arguments Bool
      (pattern
        (~ (seq (& "(") (: ...spans \opener) (? (call \pattern-argument (into spans))) (* (seq (& ",") (: ...spans \loose) (? (call \pattern-argument (into spans))))) (? (call \stray (into spans))))
          true
        )
      )
    )
    (blank)
    (lazy pattern-argument Bool
      (pattern
        (~ (seq (? (: ...spans \space)) (? (| (call \pattern (into spans)) (call \collector (into spans)))) (* (seq (! ",") (call \code-item (into spans)))))
          true
        )
      )
    )
    (blank)
    (lazy collector Bool
      (pattern
        (~ (seq (& "into ") (: ...spans \joined) (* (call \pattern-item (into spans))))
          true
        )
      )
    )
    (blank)
    (lazy pattern-code Bool
      (pattern
        (~ (seq (& "{") (: ...spans \opener) (* (call \code-item (into spans))) (? (call \stray (into spans))))
          true
        )
      )
    )
    (blank)
    (lazy space SourceSpan
      (pattern
        (~ (+ " ")
          (call ubrix-span source location .plain)
        )
      )
    )
    (blank)
    (lazy joined SourceSpan
      (pattern
        (~ \numeral
          (call ubrix-span source location .number)
        )
        (~ \word
          (call ubrix-word-span source location .identifier)
        )
      )
    )
    (blank)
    (lazy tick SourceSpan
      (pattern
        (~ "'"
          (call ubrix-span source location .punctuation)
        )
      )
    )
    (blank)
    (lazy opener SourceSpan
      (pattern
        (~ (| "(" "[" "{")
          (call ubrix-span source location .punctuation)
        )
      )
    )
    (blank)
    (lazy closer SourceSpan
      (pattern
        (~ (| ")" "]" "}")
          (call ubrix-span source location .punctuation)
        )
      )
    )
    (blank)
    (lazy loose SourceSpan
      (pattern
        (~ \comment
          (call ubrix-span source location .comment)
        )
        (~ \character
          (call ubrix-span source location .string)
        )
        (~ (| "," "." ":" "'")
          (call ubrix-span source location .punctuation)
        )
        (~ \symbol
          (call ubrix-span source location .operator)
        )
      )
    )
    (blank)
    (lazy pattern-word SourceSpan
      (pattern
        (~ (seq (! (seq (| "in" "on") (! (chars "a-zA-Z0-9_-")))) \word)
          (call ubrix-word-span source location .capture)
        )
      )
    )
    (blank)
    (lazy rule-name SourceSpan
      (pattern
        (~ (seq "\\" (? \word))
          (call ubrix-span source location .rule)
        )
      )
    )
    (blank)
    (lazy pattern-leaf SourceSpan
      (pattern
        (~ \character
          (call ubrix-span source location .string)
        )
        (~ \class
          (call ubrix-span source location .string)
        )
        (~ \numeral
          (call ubrix-span source location .number)
        )
        (~ (| "//" "/")
          (call ubrix-span source location .keyword)
        )
        (~ "..."
          (call ubrix-span source location .operator)
        )
        (~ (seq (! (chars "a-zA-Z)},=@`\\u005D")) .)
          (call ubrix-span source location .operator)
        )
      )
    )
    (blank)
    (lazy text-run SourceSpan
      (pattern
        (~ (+ (| (seq "\\" .) (seq (! (| "\${" (seq "\$" (chars "a-z")))) .)))
          (call ubrix-span source location .string)
        )
      )
    )
    (blank)
    (lazy quoted-run SourceSpan
      (pattern
        (~ (+ (| (seq "\\" .) (seq (! (| "\"" "\${" (seq "\$" (chars "a-z")))) .)))
          (call ubrix-span source location .string)
        )
      )
    )
    (blank)
    (lazy quote SourceSpan
      (pattern
        (~ "\""
          (call ubrix-span source location .string)
        )
      )
    )
    (blank)
    (lazy text-mark SourceSpan
      (pattern
        (~ (| "\${" "\$" "}")
          (call ubrix-span source location .operator)
        )
      )
    )
    (blank)
    (lazy text-word SourceSpan
      (pattern
        (~ \word
          (call ubrix-span source location .identifier)
        )
      )
    )
    (blank)
    (lazy comment
      (pattern
        (~ (seq "`" (* .)))
      )
    )
    (blank)
    (lazy character
      (pattern
        (~ (seq "'" "\\" . ({} (seq (! (| "'" " ")) .) 0 8) "'"))
        (~ (seq "'" (! "\\") . ({} (seq (! (| "'" " ")) .) 0 9) "'"))
      )
    )
    (blank)
    (lazy numeral
      (pattern
        (~ (seq (chars "0-9") (* (| (chars "a-zA-Z0-9_") \wide (seq (chars "-.'") (chars "0-9"))))))
      )
    )
    (blank)
    (lazy word
      (pattern
        (~ (seq (| (chars "a-zA-Z_") \wide) (* (| (chars "a-zA-Z0-9_") \wide (seq "-" (| (chars "a-zA-Z0-9_") \wide))))))
      )
    )
    (blank)
    (lazy wide
      (pattern
        (~ (seq (! (chars "\\u0000-~")) (! (chars "•→…═─━«»")) .))
      )
    )
    (blank)
    (lazy class
      (pattern
        (~ (seq "[" (* (seq (! "]") .)) (? "]")))
      )
    )
    (blank)
    (lazy symbol
      (pattern
        (~ (seq (! (chars ")}\\u005D")) . (* (chars "-+*/%<>!=?|&~^"))))
      )
    )
  )
)

(fn-expr _ ubrix-span SourceSpan
  (param source String)
  (param location MatchLocation)
  (param kind SourceSpanKind)
  (call SourceSpan kind ([] source (..< (. location begin column) (+ (. location end column) 1))))
)

(fn-expr _ ubrix-word-span SourceSpan
  (param source String)
  (param location MatchLocation)
  (param named SourceSpanKind)
  (call SourceSpan kind text)
  (where
    (lazy text ([] source (..< (. location begin column) (+ (. location end column) 1))))
    (lazy word-kind (call ubrix-word-kind text))
    (lazy kind (if-expr (== word-kind (. SourceSpanKind identifier)) named word-kind))
  )
)

(fn-expr _ ubrix-word-kind SourceSpanKind
  (param text String)
  (case? (or (== text "_") (== text "^"))
    (. SourceSpanKind operator)
  )
  (case? (has ubrix-keywords text)
    (. SourceSpanKind keyword)
  )
  (case? (and (>= ([] text 0) 'A') (<= ([] text 0) 'Z'))
    (. SourceSpanKind type-name)
  )
  (default
    (. SourceSpanKind identifier)
  )
)

(fn-do + ubrix-parse-text (of ImmutableTableRow SourceNode)
  (param text String)
  (param store SourceStore)
  (return-if (call (. store blank)) (if (== (. text length) 0)))
  (let made (call ubrix-parse-prose text store))
  (return-if (call (. store item) made 1) (if (and made (call (. store is-form) made "paragraph") (== (call (. store count) made) 2))))
  (return (call (. store string) text))
)

(fn-do + ubrix-is-import Bool
  (param text String)
  (return-if false (if (not (or (call (. text starts-with) "/") (call (. text starts-with) "./") (call (. text starts-with) "../")))))
  (return (call all (. text codepoints) (:where (and (!= each (char " ")) (!= each (char "(")) (!= each (char "\""))))))
)

(fn-do + ubrix-parse-statement (? (of ImmutableTableRow SourceNode))
  (param text String)
  (param store SourceStore)
  (param scope UBrixEntry)
  (let body (call ubrix-trimmed text))
  (return-if (call (. store blank)) (if (== (. body length) 0)))
  (if (call (. body starts-with) "`")
    (let note ([] body (... 1)))
    (return (call (. store comment) (if-expr (call (. note starts-with) " ") ([] note (... 1)) note)))
  )
  (let parsed (call ubrix-parse-row body store scope))
  (return-if null (if (not parsed)))
  (return (call ubrix-prune store parsed))
)

(fn-do + ubrix-parse-declaration (? (of ImmutableTableRow SourceNode))
  (param text String)
  (param store SourceStore)
  (return (call ubrix-parse-row (call ubrix-trimmed text) store (. UBrixEntry head-row)))
)

(fn-do + ubrix-parse-line (? (of ImmutableTableRow SourceNode))
  (param text String)
  (param store SourceStore)
  (return (call ubrix-parse-row (call ubrix-trimmed text) store (. UBrixEntry header-row)))
)

(fn-do + ubrix-trimmed String
  (param text String)
  (let chars (. text codepoints))
  (let start Index 0)
  (while (and (< start (. chars length)) (== ([] chars start) (char " ")))
    (+= start 1)
  )
  (let last (. chars length))
  (while (and (> last start) (== ([] chars (- last 1)) (char " ")))
    (-= last 1)
  )
  (return ([] text (..< start last)))
)

(fn-expr + ubrix-takes-block Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (or is-keyword (has heads head) (has probes head))
  (where
    (lazy head (?? (call (. store head) node) ""))
    (lazy is-keyword (and (call (. head starts-with) ":") (not (call (. head ends-with) ":")) (> (. head length) 1)))
    (lazy heads (list "prop" "entry" "entry?" "return"))
    (lazy probes (list "probe" "probe-log" "probe-count" "probe-group" "probe-assign"))
  )
)

(fn-do + ubrix-prune (of ImmutableTableRow SourceNode)
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param is-bare Bool (= false))
  (let count (call (. store count) node))
  (return-if node (if (== count 0)))
  (return-if (call (. store with-id) (call (. store item) node 1) (. node id)) (if (and (call (. store is-form) node "scope") (== count 2))))
  (let last (call (. store item) node (- count 1)))
  (let is-binding (or (call (. store is-form) node "let") (call (. store is-form) node "lazy")))
  (if (not (and (call (. store is-form) last "block") (== (call (. store count) last) 1)))
    (let next (call ubrix-prune store last is-bare))
    (return-if node (if (== (. next index) (. last index))))
    (let pruned (call (. store appended) (call (. store trimmed) node (- count 1)) next))
    (let is-named (and is-binding (== count 3) (call (. store is-atom) (call (. store item) node 1))))
    (let becomes-type (and (call ubrix-is-type-form store next) (not (call ubrix-is-type-form store last))))
    (return (if-expr (and is-named becomes-type) (call (. store inserted) pruned 2 (call (. store atom) "_")) pruned))
  )
  (return-if node (if (< count 2)))
  (return-if (call (. store trimmed) node 2) (if (and is-binding (== count 3))))
  (return-if (call (. store trimmed) node (- count 1)) (if (call ubrix-takes-block store node)))
  (return-if node (if (not (call (. store is-form) node "call"))))
  (let target (call (. store item) node 1))
  (return-if (call (. store with-id) target (. node id)) (if (and (== count 3) is-bare (== (. target id) 0))))
  (return (call (. store trimmed) node (- count 1)))
)
