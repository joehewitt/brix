(import ./build)
(import ./layout)
(import /core/table)
(import /data/source-sexp)
(import /data/source-tree)
(import /stream/aggregate)
(blank)
(prop _ ubrix-level-tuple _ (= 1))
(prop _ ubrix-level-closure _ (= 2))
(prop _ ubrix-level-print _ (= 3))
(prop _ ubrix-level-coalesce _ (= 4))
(prop _ ubrix-level-if _ (= 5))
(prop _ ubrix-level-named _ (= 6))
(prop _ ubrix-level-assign _ (= 7))
(prop _ ubrix-level-select _ (= 8))
(prop _ ubrix-level-pipe _ (= 9))
(prop _ ubrix-level-prefix _ (= 23))
(prop _ ubrix-level-postfix _ (= 24))
(prop _ ubrix-level-primary _ (= 26))

(type + UBrixTagKind (is Union)
  (variant name)
  (variant setting)
  (variant exit)
  (variant raise)
  (variant markup)
  (variant binder)
)

(type + UBrixTag (is Tuple)
  (prop + start Size)
  (prop + end Size)
  (prop + kind UBrixTagKind)
)

(type + UBrixMarked (is Tuple)
  (prop + text String)
  (prop + start Size)
  (prop + end Size)
)

(type + UBrixPrinter
  (prop + holder (? (of ImmutableTableRow SourceNode)))
  (prop + start Size)
  (prop + armed (? (of ImmutableTableRow SourceNode)))
  (prop + tail (? (of ImmutableTableRow SourceNode)))
  (prop + has-text Bool)
  (prop + is-arguing Bool)
  (prop + tags (list UBrixTag))
  (prop + targets (list U32))
  (prop + target-start Size)
  (prop + target-end Size)
  (blank)
  (prop _ target-depth Index)
  (blank)
  (prop _ store SourceStore)
  (prop _ layout UBrixLayout)
  (prop _ parts (list String))
  (prop _ no-prep Bool)
  (prop _ is-quiet Bool)
  (prop _ binds-clause Bool)
  (prop _ column Size)
  (prop _ is-field Bool)
  (prop _ is-setting Bool)
  (prop _ is-binding Bool)
  (prop _ is-stream Bool)
  (prop _ is-elided Bool)
  (fn-do + This _
    (param store _)
    (lazy layout (call UBrixLayout store))
  )
  (fn-do + row String
    (param node (of ImmutableTableRow SourceNode))
    (call begin false)
    (call statement node)
    (return (call (. "" join) parts))
  )
  (fn-do + heading String
    (param node (of ImmutableTableRow SourceNode))
    (call begin false)
    (call declaration node)
    (return (call (. "" join) parts))
  )
  (fn-do + line String
    (param node (of ImmutableTableRow SourceNode))
    (call begin false)
    (call text-line node)
    (return (call (. "" join) parts))
  )
  (fn-do + argument String
    (param node (of ImmutableTableRow SourceNode))
    (call begin false)
    (call argument-row node)
    (return (call (. "" join) parts))
  )
  (fn-do + scan-row _
    (param node (of ImmutableTableRow SourceNode))
    (call begin true)
    (call statement node)
  )
  (fn-do + scan-argument _
    (param node (of ImmutableTableRow SourceNode))
    (call begin true)
    (call argument-row node)
  )
  (fn-do + scan-heading _
    (param node (of ImmutableTableRow SourceNode))
    (call begin true)
    (call declaration node)
  )
  (fn-do + scan-line _
    (param node (of ImmutableTableRow SourceNode))
    (call begin true)
    (call text-line node)
  )
  (fn-expr + header-count Size
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (or (== count null) (> count total)) total count)
    (where
      (lazy total (call (. store count) node))
      (lazy count (call (. layout header-count) node))
    )
  )
  (fn-do + text-body (? (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (let end (. items length))
    (while (and (> end 0) (or (call (. store is-form) ([] items (- end 1)) "lazy") (call (. store is-form) ([] items (- end 1)) "blank") (call (. store is-form) ([] items (- end 1)) "where")))
      (-= end 1)
    )
    (return-if null (if (== end 0)))
    (return (only-if ([] items (- end 1)) (if (call (. store is-form) ([] items (- end 1)) "paragraph"))))
  )
  (fn-expr _ is-looped Bool
    (param node (of ImmutableTableRow SourceNode))
    (case? (and (or (== head "and") (== head "and-for")) (> (call (. store count) node) 1))
      (call is-looped (call (. store item) node 1))
    )
    (default
      (or (== head "in") (== head "on") (== head "each") (== head "block") (call ubrix-is-clause-head head))
    )
    (where
      (lazy head (?? (call (. store head) node) ""))
    )
  )
  (fn-do _ begin _
    (param quiet Bool)
    (if (not quiet)
      (= parts (call (of List String)))
      (= tags (call (of List UBrixTag)))
    )
    (= holder null)
    (= armed null)
    (= tail null)
    (= start 0)
    (= no-prep false)
    (= has-text false)
    (= is-quiet quiet)
    (= column 0)
    (= is-field false)
    (= is-setting false)
    (= is-binding false)
    (= is-stream false)
    (= is-elided false)
    (= is-arguing false)
    (= target-start 0)
    (= target-end 0)
    (= target-depth (. targets length))
  )
  (fn-do _ streaming Bool
    (param next Bool)
    (let outer is-stream)
    (= is-stream next)
    (return outer)
  )
  (fn-do _ elide _
    (param text String)
    (= is-elided true)
    (call put text)
  )
  (fn-do _ note _
    (param node (of ImmutableTableRow SourceNode))
    (param before Size)
    (return-if (if (<= column before)))
    (blank)
    (let depth (call (. targets find) (. node id)))
    (return-if (if (or (== depth null) (> depth target-depth))))
    (return-if (if (and (== depth target-depth) (> before target-start))))
    (blank)
    (= target-depth depth)
    (= target-start before)
    (= target-end column)
  )
  (fn-do _ put _
    (param text String)
    (return-if (if (== (. text size) 0)))
    (blank)
    (= has-text true)
    (if (not is-quiet)
      (+= parts text)
      (+= column (. text length))
    )
  )
  (fn-do _ quoted _
    (param text String)
    (= has-text true)
    (if (not is-quiet)
      (let shown (call ubrix-quoted text))
      (+= parts shown)
      (+= column (. shown length))
    )
  )
  (fn-do _ tagged _
    (param text String)
    (param kind UBrixTagKind)
    (if (and (not is-quiet) (!= (. text size) 0))
      (+= tags (call UBrixTag column (+ column (. text length)) kind))
    )
    (call put text)
  )
  (fn-do _ hold _
    (param node (of ImmutableTableRow SourceNode))
    (param origin Size)
    (let count (call (. store count) node))
    (= holder node)
    (= armed null)
    (= is-arguing false)
    (= start (if-expr (< origin count) origin count))
  )
  (fn-expr _ is-word Bool
    (param node (of ImmutableTableRow SourceNode))
    (param text String)
    (match node
      (case (call .atom _ held)
        (== held text)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-blank-slot Bool
    (param node (of ImmutableTableRow SourceNode))
    (call is-word node "_")
  )
  (fn-expr _ is-bare-shape Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .string _ _)
        true
      )
      (default
        (or (call is-number-atom node) (call (. store is-form) node "list"))
      )
    )
  )
  (fn-expr _ is-number-atom Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .atom _ text)
        (call ubrix-is-number (if-expr (call (. text starts-with) "-") ([] text (... 1)) text))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-attribute Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .atom _ text)
        (call (. text starts-with) "@")
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-ticked Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .atom _ text)
        (call (. text starts-with) "''")
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-bare-argument Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list _ _ _)
        (has (list "tuple" "list" "map" "stream") (?? (call (. store head) node) ""))
      )
      (default
        true
      )
    )
  )
  (fn-expr _ continues Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .string _ text)
        (call ubrix-continues-name text)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ has-flag Bool
    (param items (of ImmutableTableSpan SourceNode))
    (param flag String)
    (call some items (:where (call is-word each flag)))
  )
  (fn-expr _ called (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (and (call (. store is-form) node "scope") (> (call (. store count) node) 1)) (call (. store item) node 1) node)
  )
  (fn-expr _ is-guard Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-form) node "if") (== (call (. store count) node) 2))
  )
  (fn-expr _ unguarded (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (call is-guard node) (call (. store item) node 1) node)
  )
  (fn-expr _ is-unbound-source Bool
    (param items (of ImmutableTableSpan SourceNode))
    (or (== (. items length) 2) (call ubrix-is-clause-head (?? (call (. store head) ([] items 2)) "")) is-keyed)
    (where
      (lazy is-keyed (call (. store is-form) ([] items 2) "keyed-by"))
    )
  )
  (fn-expr _ is-stream-match Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-form) node "~") (== (call (. store count) node) 2))
  )
  (fn-expr _ is-stream-source Bool
    (param node (of ImmutableTableRow SourceNode))
    (match (call (. store items) node)
      (case (list (call .atom _ ({} (or (== it "in") (== it "on")))) first _ ...)
        (call is-stream-match first)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-closed Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (has literals head) (has ranges head))
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy literals (list "[]" "?[]" "!!" "list" "map" "tuple" "str" "char" "chars"))
      (lazy ranges (list ".." "..<" "..." "{}" "stream" "select"))
    )
  )
  (fn-expr _ ends-tail Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .comment _ _)
        false
      )
      (case (call .list _ _ _)
        (call is-closed node)
      )
      (default
        true
      )
    )
  )
  (fn-expr _ holds-rows Bool
    (param node (of ImmutableTableRow SourceNode))
    (case? (call (. store is-form) node "scope")
      true
    )
    (case? (call (. store is-form) node "call")
      (call some ([] (call (. store items) node) (... 2)) (:where (!= (call argument-kind each) (. UBrixArgument positional))))
    )
    (default
      false
    )
  )
  (fn-expr _ argument-kind U8
    (param node (of ImmutableTableRow SourceNode))
    (case? (call is-bullet-argument head)
      (. UBrixArgument named)
    )
    (case? (or (== head "block") (== head "inline"))
      (. UBrixArgument extra)
    )
    (default
      (. UBrixArgument positional)
    )
    (where
      (lazy head (?? (call (. store head) node) ""))
    )
  )
  (fn-do _ text-line _
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .string _ text)
        (if (call ubrix-starts-divider text)
          (call put "\\")
        )
        (call put (call ubrix-line-escaped text))
      )
      (case (call .list _ start count)
        (call text-form node ([] (. store nodes) (..< start (+ start count))))
      )
      (default
        (call statement node)
      )
    )
  )
  (fn-do _ text-form _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (match items
      (case (list (call .atom _ "str") (call .string _ ({} (call ubrix-starts-divider it))) ...)
        (call put "\\")
        (call interpolated items 1 false)
      )
      (case (list (call .atom _ "str") ...)
        (call interpolated items 1 false)
      )
      (case (list (call .atom _ ({} (== it source-blank-head))))
        (return)
      )
      (default
        (call statement node)
      )
    )
  )
  (fn-do _ argument-row _
    (param node (of ImmutableTableRow SourceNode))
    (call put "- ")
    (let before column)
    (call payload node)
    (if (!= (. targets length) 0)
      (call note node before)
    )
  )
  (fn-do _ statement _
    (param node (of ImmutableTableRow SourceNode))
    (let before column)
    (match node
      (case (call .comment _ text)
        (call put (if-expr (> (. text length) 0) (str "` " text) "`"))
      )
      (case (call .list _ start count)
        (call form node ([] (. store nodes) (..< start (+ start count))))
      )
      (default
        (call expression node 0 true)
      )
    )
    (if (!= (. targets length) 0)
      (call note node before)
    )
  )
  (fn-do _ form _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (match items
      (case (list (call .atom _ ({} (== it source-blank-head))))
        (return)
      )
      (case (list (call .atom _ ({} (== it source-raw-head))) (call .string _ raw) ...)
        (call put raw)
        (call hold node 2)
      )
      (case (list (call .atom _ "import") path)
        (call put (call (. store text) path))
      )
      (case (list (call .atom _ "export") name)
        (call put (str "+ " (call (. store text) name)))
      )
      (case (list (call .atom _ "let") target ...)
        (call binding items false target)
      )
      (case (list (call .atom _ "lazy") target ...)
        (call binding items true target)
      )
      (case (list (call .atom _ "return"))
        (call tagged "=" .exit)
      )
      (case (list (call .atom _ "return") value ...)
        (call tagged "=" .exit)
        (if (not (call (. store is-form) value "block"))
          (call put " ")
        )
        (call payload value)
      )
      (case (list (call .atom _ (: mark ({} (call ubrix-is-yield it)))) ...)
        (call put (call ubrix-return-mark mark))
        (if (>= (. items length) 2)
          (call put " ")
          (call payload ([] items 1))
        )
      )
      (case (list (call .atom _ "return-if") _ ...)
        (let test ([] items (- (. items length) 1)))
        (if (or (not (call is-guard test)) (> (. items length) 3))
          (call put (call sexp-inline-text store node))
          (else
            (call tagged "=?" .exit)
            (if (== (. items length) 3)
              (call put " ")
              (call expression ([] items 1) ubrix-level-named false)
            )
            (call put " if ")
            (call expression (call unguarded test) 0 false)
          )
        )
      )
      (case (list (call .atom _ (: word ({} (or (== it "break") (== it "continue"))))) ...)
        (call tagged word .exit)
      )
      (case (list (call .atom _ "print"))
        (call put "--")
      )
      (case (list (call .atom _ "throw") raised)
        (call tagged "?!" .exit)
        (if (not (call (. store is-form) raised "block"))
          (call put " ")
        )
        (call payload raised)
      )
      (case (list (call .atom _ "throw") raised ...)
        (call tagged "?!" .exit)
        (call put " ")
        (call expression raised 0 false)
        (call hold node 2)
      )
      (case (list (call .atom _ (: word ({} (or (== it "on-error") (== it "on-failure"))))) handler ...)
        (call put "catch")
        (if (call (. store is-form) handler "caught")
          (call caught handler 1)
          (else-if (not (call is-blank-slot handler))
            (call put " ")
            (call expression handler 0 false)
          )
        )
        (call hold node 2)
      )
      (case (list (call .atom _ (: word ({} (or (== it "if") (== it "while"))))) _ ...)
        (call put word)
        (call put " ")
        (call condition node items)
      )
      (case (list (call .atom _ "else-if") _ ...)
        (call put "else if ")
        (call condition node items)
      )
      (case (list (call .atom _ "else") ...)
        (call put "else")
        (call inline-body node items 1)
      )
      (case (list (call .atom _ (: word ({} (or (== it "for") (== it "or-for") (== it "and-for"))))) clause ...)
        (call put (if-expr (== word "for") "for " (if-expr (== word "or-for") "or " "and ")))
        (call loop-clause clause)
        (call inline-body node items 2)
      )
      (case (list (call .atom _ (: word ({} (call ubrix-is-do-head it)))) ...)
        (call do-block node items word)
      )
      (case (list (call .atom _ "do-with") name value ...)
        (call put (str "do with " (call (. store text) name) " = "))
        (call expression value 0 false)
        (call hold node 3)
      )
      (case (list (call .atom _ (: word ({} (or (== it "do-use") (== it "do-use?"))))) resource ...)
        (call put (if-expr (== word "do-use") "do use " "do use? "))
        (call expression resource 0 false)
        (if (and (== (. items length) 3) (call (. store is-form) ([] items 2) "inline"))
          (call hold ([] items 2) 1)
          (else
            (call hold node 2)
          )
        )
      )
      (case (list (call .atom _ "default") ...)
        (call put "??")
        (call inline-body node items 1)
      )
      (case (list (call .atom _ (: mark ({} (call ubrix-is-case it)))) subject ...)
        (call put (call ubrix-case-mark mark))
        (call put " ")
        (call expression subject 0 false)
        (call inline-body node items 2)
      )
      (case (list (call .atom _ "case-each") subject ...)
        (call put "<* ")
        (call expression subject 0 false)
        (call inline-body node items 2)
      )
      (case (list (call .atom _ "~") _ ...)
        (call alternative node items true)
      )
      (case (list (call .atom _ "pipe") op value ...)
        (let mark (call (. store text) op))
        (call put (str mark " "))
        (if (== mark "~>")
          (let outer (call streaming true))
          (call expression value 0 false)
          (= is-stream outer)
          (call hold node 3)
          (else
            (call expression value 0 true)
          )
        )
      )
      (case (list (call .atom _ (: mark ({} (call ubrix-is-feed it)))) value)
        (call put (str "*" (if-expr (call (. mark starts-with) "spread") "*" "") (if-expr (call (. mark ends-with) "?") "?" "") " "))
        (call payload value)
      )
      (case (list (call .atom _ "arg") value)
        (call put "- ")
        (call payload value)
      )
      (case (list (call .atom _ (: word ({} (or (== it "entry") (== it "entry?"))))) key ...)
        (call put (if-expr (== word "entry") "• " "•? "))
        (if (call (. store is-text) key)
          (call expression key 0 false)
          (else
            (call put "(")
            (call expression key ubrix-level-closure false)
            (call put ")")
          )
        )
        (if (>= (. items length) 3)
          (call assigned ([] items 2))
        )
      )
      (case (list (call .atom _ ({} (call ubrix-is-keyword-head it))) ...)
        (call named node items true)
      )
      (case (list (call .atom _ "with") value)
        (call put "with ")
        (call expression value 0 false)
      )
      (case (list (call .atom _ "header") value)
        (if (call (. store is-list) value)
          (call plain value)
          (else
            (call expression value 0 false)
          )
        )
      )
      (case (list (call .atom _ (: word ({} (or (== it "state") (== it "then") (== it "else-state"))))) ...)
        (call state node items word)
      )
      (case (list (call .atom _ "when-style") state ...)
        (call put "when ")
        (call expression state 0 false)
        (call inline-body node items 2)
      )
      (case (list (call .atom _ "style-set") domain name value)
        (call put (str (call (. store text) domain) ":" (call (. store text) name) " = "))
        (call expression value 0 false)
      )
      (case (list (call .atom _ "prop") _ _ _ ...)
        (call property items)
      )
      (case (list (call .atom _ "variant") _ ...)
        (call variant items)
      )
      (case (list (call .atom _ "event") access name kind ...)
        (call put (str (call (. store text) access) " event " (call (. store text) name) " "))
        (call expression kind ubrix-level-primary false)
        (if (>= (. items length) 5)
          (call put " keyed by ")
          (call expression ([] items 4) ubrix-level-primary false)
        )
      )
      (case (list (call .atom _ "unit") access name value)
        (call put (str (call (. store text) access) " " (call (. store text) name) " = "))
        (call expression value 0 true)
      )
      (case (list (call .atom _ "delegate") ...)
        (call put "as ")
        (call list items 1 ", " ubrix-level-closure)
        (call put " for")
      )
      (case (list (call .atom _ "style-domains") name ...)
        (call put (str ". " (call (. store text) name) " -> "))
        (for (in index (..< 2 (. items length)))
          (if (> index 2)
            (call put ", ")
          )
          (let fields (call (. store items) ([] items index)))
          (call put (call (. store text) ([] fields 1)))
          (if (> (. fields length) 2)
            (call put (str " on " (call (. store text) ([] fields 2))))
          )
        )
      )
      (case (list (call .atom _ "depends") name ...)
        (call put (str ". " (call (. store text) name) " < "))
        (call list items 2 ", " ubrix-level-closure)
      )
      (case (list (call .atom _ (: word ({} (or (== it "rule") (== it "own-rule"))))) name ...)
        (call put (if-expr (== word "own-rule") "• own " "• "))
        (call tagged (call (. store text) name) .binder)
        (let origin Size 2)
        (if (and (< origin (. items length)) (call (. store is-form) ([] items origin) "param"))
          (call put ":")
          (call parameter ([] items origin) false)
          (+= origin 1)
        )
        (= origin (call rules items origin))
        (call hold node origin)
      )
      (case (list (call .atom _ "keyframes") name ...)
        (call put "• ")
        (call tagged (call (. store text) name) .binder)
        (let origin Size 2)
        (if (and (< origin (. items length)) (call (. store is-form) ([] items origin) "param"))
          (call put ":")
          (call parameter ([] items origin) false)
          (+= origin 1)
        )
        (if (< (+ origin 1) (. items length))
          (call put (str " " (call (. store text) ([] items origin)) " "))
          (call guarded ([] items (+ origin 1)) ubrix-level-closure false)
        )
        (call hold node (+ origin 2))
      )
      (case (list (call .atom _ "range") property from to ...)
        (call put (str (call (. store text) property) " = "))
        (if (not (call is-blank-slot from))
          (call expression from 18 false)
          (call put " ")
        )
        (call put "..")
        (if (not (call is-blank-slot to))
          (call put " ")
          (call expression to 18 false)
        )
        (call keyframe-options items 4)
      )
      (case (list (call .atom _ "track") property ...)
        (call put (call (. store text) property))
        (call hold node (call keyframe-options items 2))
      )
      (case (list (call .atom _ "at") at value ...)
        (call put "at ")
        (call expression at 18 false)
        (call put " = ")
        (call expression value 18 false)
        (call keyframe-options items 3)
      )
      (case (list (call .atom _ ({} (call ubrix-is-header-head it))) ...)
        (call header-line node items)
      )
      (case (list (call .atom _ ({} (or (== it "type-line") (== it "extend-line")))) ...)
        (call declaration node)
      )
      (case (list (call .atom _ (: word ({} (call ubrix-is-probe it)))) ...)
        (call probe items word)
      )
      (case (list (call .atom _ "•") _ ...)
        (call put "• ")
        (call rule-use items)
      )
      (default
        (call plain node)
      )
    )
  )
  (fn-do _ binding _
    (param items (of ImmutableTableSpan SourceNode))
    (param is-lazy Bool)
    (param target (of ImmutableTableRow SourceNode))
    (call tagged "." .binder)
    (if is-lazy
      (call tagged "." .binder)
    )
    (call put " ")
    (= is-binding true)
    (call expression target 0 false)
    (= is-binding false)
    (let is-flat
      (scope (and (>= (. items length) 3) (call (. store is-atom) target) is-typed-binding)
        (lazy is-typed-binding (or (>= (. items length) 4) (call ubrix-is-type-form store ([] items 2))))
      )
    )
    (if (and is-flat (not (and (call (. store is-atom) ([] items 2)) (== (call (. store text) ([] items 2)) "_"))))
      (call put " ")
      (call expression ([] items 2) ubrix-level-primary false)
    )
    (let spot Size (if-expr is-flat 3 2))
    (return-if (if (<= (. items length) spot)))
    (blank)
    (let value ([] items spot))
    (let fields (call (. store items) value))
    (match fields
      (case (list (call .atom _ "block") ...)
        (call put " =")
        (call hold value 1)
      )
      (case (list (call .atom _ "machine") ...)
        (call put " ~>")
        (call hold value 1)
      )
      (case (list (call .atom _ "pattern") ...)
        (call put " ~")
        (let origin Size 1)
        (while (and (< origin (. fields length)) (call (. store is-atom) ([] fields origin)))
          (call put (str " " (call (. store text) ([] fields origin))))
          (+= origin 1)
        )
        (call hold value origin)
      )
      (default
        (call put " = ")
        (call payload value)
      )
    )
  )
  (fn-do _ plain _
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store items) node))
    (let head (?? (call (. store head) node) ""))
    (let level (if-expr (>= (. items length) 3) (call ubrix-precedence head) 0))
    (if (and (== level ubrix-level-assign) (== (. items length) 3))
      (= is-setting true)
      (call expression ([] items 1) (+ ubrix-level-assign 1) false)
      (= is-setting false)
      (call put " ")
      (call put (call ubrix-operator-text head))
      (if (not (call (. store is-form) ([] items 2) "block"))
        (call put " ")
      )
      (call payload ([] items 2))
      (return)
    )
    (let shown (call called node))
    (let outer (?? (call (. store head) shown) ""))
    (= no-prep (or (== outer "tuple") (and (>= (call (. store count) shown) 3) (> (call ubrix-precedence outer) 0))))
    (call expression node 0 true)
    (= no-prep false)
  )
  (fn-do _ payload _
    (param node (of ImmutableTableRow SourceNode))
    (call expression node (if-expr (call (. store is-form) (call called node) "tuple") ubrix-level-closure 0) true)
  )
  (fn-do _ condition _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (call expression ([] items 1) 0 false)
    (call inline-body node items 2)
  )
  (fn-do _ inline-body _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (let end (call ubrix-arm-start store node))
    (if (and (== end (+ origin 1)) (call (. store is-form) ([] items origin) "inline"))
      (call put (if-expr (> origin 1) ": " " "))
      (let body (call (. store item) ([] items origin) 1))
      (call expression body (if-expr (call (. store is-form) body "tuple") ubrix-level-closure 0) false)
      (if (< end (. items length))
        (call hold node end)
      )
      (else
        (call hold node origin)
      )
    )
  )
  (fn-do _ assigned _
    (param value (of ImmutableTableRow SourceNode))
    (if (call (. store is-form) value "block")
      (call hold value 1)
      (else
        (call put " ")
        (call expression value 0 true)
      )
    )
  )
  (fn-do _ caught _
    (param node (of ImmutableTableRow SourceNode))
    (param origin Size)
    (let items (call (. store items) node))
    (if (and (< origin (. items length)) (not (call is-blank-slot ([] items origin))))
      (call put " ")
      (call expression ([] items origin) 0 false)
    )
    (for (in index (..< (+ origin 1) (. items length)))
      (call put " <- ")
      (call expression ([] items index) 0 false)
    )
  )
  (fn-do _ do-block _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param head String)
    (call put (if-expr (== head "finally") "do finally" "do"))
    (let origin Size 1)
    (if (and (< origin (. items length)) (call (. store is-form) ([] items origin) "worker:"))
      (call put " (")
      (call expression (call (. store item) ([] items origin) 1) 0 false)
      (call put ")")
      (+= origin 1)
    )
    (call put (call ubrix-do-suffix head))
    (let attributed (and (< origin (. items length)) (call is-attribute ([] items origin))))
    (while (and (< origin (. items length)) (call is-attribute ([] items origin)))
      (call put (str " " (call (. store text) ([] items origin))))
      (+= origin 1)
    )
    (let scopes origin)
    (if (and (== head "do") (< origin (. items length)) (call is-scope ([] items origin)))
      (= origin (call scope-parts items origin))
    )
    (= attributed (or attributed (> origin scopes)))
    (let end (call ubrix-arm-start store node))
    (let inline (and (== end (+ origin 1)) (call (. store is-form) ([] items origin) "inline")))
    (if (and inline (not attributed))
      (call put " ")
      (call expression (call (. store item) ([] items origin) 1) 0 true)
      (if (< end (. items length))
        (call hold node end)
      )
      (else-if inline
        (call hold ([] items origin) 1)
        (= armed node)
      )
      (else
        (call hold node origin)
      )
    )
  )
  (fn-do _ alternative _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param is-tail Bool)
    (call put "~ ")
    (let outer (call streaming true))
    (call expression ([] items 1) 0 false)
    (= is-stream outer)
    (let origin Size 2)
    (while (and (< origin (. items length)) (call alternative-part ([] items origin)))
      (+= origin 1)
    )
    (if is-tail
      (call hold node origin)
      (else-if (< origin (. items length))
        (call elide " {…}")
      )
    )
  )
  (fn-do _ alternative-part Bool
    (param item (of ImmutableTableRow SourceNode))
    (let fields (call (. store items) item))
    (match fields
      (case (list (call .atom _ "of:") value ...)
        (call put " = ")
        (call expression value 0 false)
        (return true)
      )
      (case (list (call .atom _ (: word ({} (or (== it "in:") (== it "on:"))))) ...)
        (call put (if-expr (== word "in:") " in " " on "))
        (call list fields 1 " " 0)
        (return true)
      )
      (default
        (return-if false (if (not (call is-word item "@rollback"))))
        (blank)
        (call put " @rollback")
        (return true)
      )
    )
  )
  (fn-do _ state _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param head String)
    (call put (if-expr (== head "state") "~> " (if-expr (== head "then") "then " "?? ")))
    (if (> (. items length) 1)
      (let target ([] items 1))
      (let fields (call (. store items) target))
      (if (and (call (. store is-form) target "call") (> (. fields length) 1))
        (call put (call (. store text) ([] fields 1)))
        (call put "(")
        (call list fields 2 ", " ubrix-level-closure)
        (call put ")")
        (else
          (call put (call (. store text) target))
        )
      )
    )
    (let origin Size 2)
    (if (and (< origin (. items length)) (call (. store is-form) ([] items origin) "trigger"))
      (call put " ")
      (call trigger ([] items origin))
      (+= origin 1)
    )
    (call hold node origin)
  )
  (fn-do _ trigger _
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store items) node))
    (match items
      (case (list _ (call .atom _ "for") subject source ...)
        (call put "for ")
        (call expression subject 0 false)
        (call put " on ")
        (call expression source ubrix-level-assign false)
        (if (> (. items length) 4)
          (call put " when ")
          (call expression ([] items 4) ubrix-level-select false)
        )
      )
      (case (list _ (call .atom _ "when-on") test source)
        (call put "when ")
        (call expression test ubrix-level-select false)
        (call put " on ")
        (call expression source ubrix-level-assign false)
      )
      (case (list _ (call .atom _ "on") source ...)
        (call put "on ")
        (call expression source ubrix-level-assign false)
        (if (> (. items length) 3)
          (call put " when ")
          (call expression ([] items 3) ubrix-level-select false)
        )
      )
      (case (list _ (call .atom _ "if-match") shape value)
        (call put "if | ")
        (call expression shape 0 false)
        (call put " = ")
        (call expression value ubrix-level-assign false)
      )
      (case (list _ kind operand)
        (let word (call (. store text) kind))
        (let is-axis (or (== word "children") (== word "descendants") (== word "ancestor")))
        (call put (str word " "))
        (call expression operand (if-expr is-axis ubrix-level-primary ubrix-level-assign) false)
      )
      (default
        (call put (call sexp-inline-text store node))
      )
    )
  )
  (fn-do _ property _
    (param items (of ImmutableTableSpan SourceNode))
    (let count (. items length))
    (let last ([] items (- count 1)))
    (call put (call (. store text) ([] items 1)))
    (let origin Size 4)
    (while (and (< origin count) (call is-attribute ([] items origin)))
      (call put (str " " (call (. store text) ([] items origin))))
      (+= origin 1)
    )
    (if (not (call is-blank-slot ([] items 2)))
      (call put " ")
      (call expression ([] items 2) ubrix-level-primary false)
    )
    (if (not (call is-blank-slot ([] items 3)))
      (call put " ")
      (call expression ([] items 3) ubrix-level-primary false)
    )
    (return-if (if (>= origin count)))
    (blank)
    (let fields (call (. store items) last))
    (match fields
      (case (list (call .atom _ "block") ...)
        (call hold last 1)
      )
      (case (list (call .atom _ "machine") ...)
        (call put " ~>")
        (call hold last 1)
      )
      (case (list (call .atom _ "=>") _ ...)
        (call put (if-expr (> (. fields length) 2) " => do" " =>"))
        (call assigned ([] fields (- (. fields length) 1)))
      )
      (case (list mark value)
        (call put (str " " (call (. store text) mark)))
        (call assigned value)
      )
      (default
        (call put " ")
        (call put (call sexp-inline-text store last))
      )
    )
  )
  (fn-do _ variant _
    (param items (of ImmutableTableSpan SourceNode))
    (call put "| ")
    (call expression ([] items 1) ubrix-level-primary false)
    (for (in index (..< 2 (. items length)))
      (let item ([] items index))
      (let is-payload (and (== index 2) (call (. store is-atom) ([] items 1))))
      (match (call (. store items) item)
        (case (list (call .atom _ "=") value)
          (call put " = ")
          (call expression value 0 true)
        )
        (case (list (call .atom _ ({} (and (== it "tuple") is-payload))) ...)
          (= is-field true)
          (call expression item ubrix-level-primary false)
          (= is-field false)
        )
        (default
          (call put " ")
          (call expression item ubrix-level-primary false)
        )
      )
    )
  )
  (fn-do _ header-line _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (let raw (only-if (call (. store raw-text) ([] items 1)) (if (== (. items length) 2))))
    (if (!= raw null)
      (call put raw)
      (return)
    )
    (match items
      (case (list (call .atom _ "param") ...)
        (call parameter node true)
      )
      (case (list (call .atom _ "claim") name)
        (call put (str "- " (call (. store text) name)))
      )
      (case (list (call .atom _ "constraint") op left right)
        (call put "- ")
        (call expression left ubrix-level-primary false)
        (call put (str " " (call (. store text) op) " "))
        (call expression right 0 false)
      )
      (case (list (call .atom _ "iterates") name source)
        (call put (str "= " (call (. store text) name) " "))
        (call expression source 0 false)
      )
      (case (list (call .atom _ word) value)
        (call put (str (call ubrix-binding-word word) " "))
        (call expression value 0 false)
      )
      (default
        (call put (call sexp-inline-text store node))
      )
    )
  )
  (fn-do _ parameter _
    (param node (of ImmutableTableRow SourceNode))
    (param is-line Bool)
    (let items (call (. store items) node))
    (let lead (only-if (call ubrix-parameter-mark (call (. store text) ([] items 1))) (if (and (> (. items length) 1) (call (. store is-atom) ([] items 1))))))
    (let origin Size (if-expr (!= lead null) 2 1))
    (call put (?? lead (if-expr is-line "- " "")))
    (let wrote false)
    (for (in index (..< origin (. items length)))
      (let item ([] items index))
      (if (and (== (- index origin) 2) (call (. store is-form) item "=") (== (call (. store count) item) 2))
        (call put " = ")
        (call expression (call (. store item) item 1) ubrix-level-closure false)
        (else-if (not (call is-blank-slot item))
          (if wrote
            (call put " ")
          )
          (call expression item ubrix-level-primary false)
          (= wrote true)
        )
      )
    )
  )
  (fn-do _ declaration _
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store items) node))
    (let raw (only-if (call (. store raw-text) ([] items 1)) (if (>= (. items length) 2))))
    (if (!= raw null)
      (call put raw)
      (return)
    )
    (match items
      (case (list (call .atom _ (: word ({} (or (== it "fn-do") (== it "fn-expr"))))) access key result ...)
        (call put (str (call (. store text) access) " "))
        (if (call has-flag items ":static")
          (call put "static ")
        )
        (if (and (== word "fn-do") (not (call is-constructor key)))
          (call put "do ")
        )
        (if (call has-flag items ":set")
          (call expression key ubrix-level-primary false)
          (call put " = ")
          (for (in index (..< 4 (. items length)))
            (if (call (. store is-form) ([] items index) "param")
              (call parameter ([] items index) false)
              (break)
            )
          )
          (return)
        )
        (if (!= (call text-body items) null)
          (call put "\" ")
        )
        (if (call has-flag items ":get")
          (call put "get ")
          (call expression key ubrix-level-primary false)
          (if (not (call is-blank-slot result))
            (call put " ")
            (call expression result ubrix-level-primary false)
          )
          (call signature-tail items 4)
          (return)
        )
        (let spread (? (of ImmutableTableRow SourceNode)) null)
        (for (in index (..< 4 (call header-count node)))
          (if (call (. store is-form) ([] items index) "over:")
            (= spread ([] items index))
          )
        )
        (call function-key key result spread)
        (call signature-tail items 4)
      )
      (case (list (call .atom _ (: word ({} (or (call (. it starts-with) "fn-from-") (call (. it starts-with) "fn-to-"))))) access other ...)
        (let is-from (call (. word starts-with) "fn-from-"))
        (call put (str (call (. store text) access) " "))
        (if (call (. word ends-with) "-do")
          (call put "do ")
        )
        (if (!= (call text-body items) null)
          (call put "\" ")
        )
        (call put (if-expr is-from "from " "to "))
        (call expression other (if-expr is-from 0 ubrix-level-primary) false)
        (call signature-tail items 3)
      )
      (case (list (call .atom _ "effect") access name ...)
        (call put (str (call (. store text) access) " effect " (call (. store text) name)))
      )
      (case (list (call .atom _ "when-rule") test ...)
        (call put "when ")
        (call expression test 0 false)
      )
      (case (list (call .atom _ "whenever-rule") test ...)
        (call put "whenever ")
        (if (call (. store is-form) test "trigger")
          (call trigger test)
          (else
            (call expression test 0 false)
          )
        )
      )
      (case (list (call .atom _ "subscribe-for") source ...)
        (call put "for ")
        (call loop-clause source)
      )
      (case (list (call .atom _ "subscribe") source ...)
        (call expression source 0 false)
      )
      (case (list (call .atom _ ({} (or (== it "type") (== it "type-line")))) access name ...)
        (call put (str (call (. store text) access) " "))
        (call expression name ubrix-level-primary false)
        (let index Size 3)
        (while (and (< index (. items length)) (call type-clause ([] items index)))
          (+= index 1)
        )
      )
      (case (list (call .atom _ ({} (or (== it "extend") (== it "extend-line")))) access name ...)
        (call put (str (call (. store text) access) " extend "))
        (call expression name ubrix-level-primary false)
        (let index Size 3)
        (while (and (< index (. items length)) (call extend-clause ([] items index)))
          (+= index 1)
        )
      )
      (case (list (call .atom _ "style") name ...)
        (call put (str "• " (call (. store text) name)))
        (let index Size 2)
        (while (and (< index (. items length)) (call type-clause ([] items index)))
          (+= index 1)
        )
      )
      (case (list (call .atom _ "style-extend") name ...)
        (call put "• extend ")
        (call expression name ubrix-level-primary false)
      )
      (case (list (call .atom _ "prop") _ _ _ ...)
        (call property items)
      )
      (default
        (call put (call sexp-inline-text store node))
      )
    )
  )
  (fn-do _ type-clause Bool
    (param item (of ImmutableTableRow SourceNode))
    (let fields (call (. store items) item))
    (match fields
      (case (list (call .atom _ "alias") ...)
        (call put " (")
        (call list fields 1 ", " 0)
        (call put ")")
        (return true)
      )
      (case (list (call .atom _ "facet-of") owner)
        (call put " is facet of ")
        (call expression owner ubrix-level-primary false)
        (return true)
      )
      (case (list (call .atom _ "is") ...)
        (call put " is ")
        (call list fields 1 " || " ubrix-level-primary)
        (return true)
      )
      (case (list (call .atom _ "for") ...)
        (call put " for ")
        (call list fields 1 ", " 0)
        (return true)
      )
      (default
        (return false)
      )
    )
  )
  (fn-do _ extend-clause Bool
    (param item (of ImmutableTableRow SourceNode))
    (let fields (call (. store items) item))
    (match fields
      (case (list (call .atom _ "as") ...)
        (call put " as ")
        (call list fields 1 ", " ubrix-level-primary)
        (return true)
      )
      (case (list (call .atom _ "where") ...)
        (call put " where ")
        (for (in position (..< 1 (. fields length)))
          (if (> position 1)
            (call put ", ")
          )
          (let constraint (call (. store items) ([] fields position)))
          (if (== (. constraint length) 4)
            (call expression ([] constraint 2) ubrix-level-primary false)
            (call put (str " " (call (. store text) ([] constraint 1)) " "))
            (call expression ([] constraint 3) ubrix-level-closure false)
          )
        )
        (return true)
      )
      (default
        (return false)
      )
    )
  )
  (fn-expr _ is-constructor Bool
    (param key (of ImmutableTableRow SourceNode))
    (and (call (. store is-atom) name) (== (call (. store text) name) "This"))
    (where
      (lazy name (if-expr (and (call (. store is-form) key "of") (> (call (. store count) key) 1)) (call (. store item) key 1) key))
    )
  )
  (fn-do _ signature-tail _
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (let index origin)
    (while (< index (. items length))
      (if (call is-scope ([] items index))
        (= index (call scope-parts items index))
        (else-if (call signature-part ([] items index) (!= origin 4))
          (+= index 1)
        )
        (else
          (break)
        )
      )
    )
  )
  (fn-expr _ is-scope-with Bool
    (param item (of ImmutableTableRow SourceNode))
    (and (call (. store is-form) item "with") (== (call (. store count) item) 3))
  )
  (fn-expr _ is-scope Bool
    (param item (of ImmutableTableRow SourceNode))
    (or (call is-scope-with item) (call (. store is-form) item "without"))
  )
  (fn-do _ scope-parts Size
    (param items (of ImmutableTableSpan SourceNode))
    (param first Size)
    ; Puts the `without` and `with` parts that begin at `first` as one section of each, in the order
    ; the first of each comes, and answers where they end.
    (let end first)
    (while (and (< end (. items length)) (call is-scope ([] items end)))
      (+= end 1)
    )
    (if (call is-scope-with ([] items first))
      (call put-withs items first end)
      (call put-withouts items first end)
      (else
        (call put-withouts items first end)
        (call put-withs items first end)
      )
    )
    (return end)
  )
  (fn-do _ put-withouts _
    (param items (of ImmutableTableSpan SourceNode))
    (param first Size)
    (param end Size)
    (let named false)
    (for (in index (..< first end))
      (if (call (. store is-form) ([] items index) "without")
        (for (in position (..< 1 (call (. store count) ([] items index))))
          (call put (if-expr named ", " " without "))
          (call put (call (. store text) (call (. store item) ([] items index) position)))
          (= named true)
        )
      )
    )
  )
  (fn-do _ put-withs _
    (param items (of ImmutableTableSpan SourceNode))
    (param first Size)
    (param end Size)
    (let bound false)
    (for (in index (..< first end))
      (if (call is-scope-with ([] items index))
        (call put (if-expr bound ", " " with "))
        (call put (call (. store text) (call (. store item) ([] items index) 1)))
        (call put " = ")
        (call expression (call (. store item) ([] items index) 2) 0 false)
        (= bound true)
      )
    )
  )
  (fn-do _ signature-part Bool
    (param item (of ImmutableTableRow SourceNode))
    (param shows-spread Bool)
    (match item
      (case (call .atom _ text)
        (if (call (. text starts-with) "@")
          (call put (str " " text))
          (else-if (== text ":throws")
            (call put " throws")
          )
        )
        (return true)
      )
      (case (call .list _ start count)
        (match ([] (. store nodes) (..< start (+ start count)))
          (case (list (call .atom _ "over:") spread ...)
            (if shows-spread
              (call put " ~ ")
              (call expression spread ubrix-level-primary false)
            )
            (return true)
          )
          (case (list (call .atom _ "door") effect)
            (call put (str " @door(" (call (. store text) effect) ")"))
            (return true)
          )
          (case (list (call .atom _ "?!") raised ...)
            (call put " ")
            (call tagged "?!" .raise)
            (call put " ")
            (if (call (. store is-atom) raised)
              (call tagged (call (. store text) raised) .raise)
              (else
                (call expression raised ubrix-level-primary false)
              )
            )
            (return true)
          )
          (default
            (return false)
          )
        )
      )
      (default
        (return false)
      )
    )
  )
  (fn-do _ function-key _
    (param key (of ImmutableTableRow SourceNode))
    (param result (of ImmutableTableRow SourceNode))
    (param spread (? (of ImmutableTableRow SourceNode)))
    (let has-result (not (call is-blank-slot result)))
    (let items (call (. store items) key))
    (match items
      (case (list (call .atom _ "infix") left op right)
        (call expression left ubrix-level-primary false)
        (if has-result
          (call put " ")
          (call expression result ubrix-level-primary false)
        )
        (call put (str " " (call ubrix-operator-text (call (. store text) op)) " "))
        (call parameter right false)
        (return)
      )
      (case (list (call .atom _ "index-delete") target slot)
        (call put "-= ")
        (call expression target ubrix-level-primary false)
        (call put "[")
        (call parameter slot false)
        (call put "]")
        (return)
      )
      (case (list (call .atom _ ({} (or (== it "index-get") (== it "index-set")))) target slot ...)
        (call expression target ubrix-level-primary false)
        (call put "[")
        (call parameter slot false)
        (call put "]")
        (if (== (. items length) 4)
          (call put " = ")
          (call parameter ([] items 3) false)
        )
      )
      (case (list (call .atom _ "prefix") op operand)
        (let mark (call (. store text) op))
        (call put mark)
        (if (and (!= mark "!") (!= mark "-"))
          (call put " ")
        )
        (call expression operand ubrix-level-primary false)
      )
      (default
        (call expression key ubrix-level-primary false)
      )
    )
    (if spread
      (call put " ~ ")
      (call expression (call (. store item) spread 1) ubrix-level-primary false)
    )
    (if has-result
      (call put " ")
      (call expression result ubrix-level-primary false)
    )
  )
  (fn-do _ probe _
    (param items (of ImmutableTableSpan SourceNode))
    (param head String)
    (let is-grouped (and (== head "probe-group") (> (. items length) 1)))
    (let origin Size (if-expr is-grouped 2 1))
    (call put (if-expr (== head "probe") "//!" (if-expr is-grouped (str "//" (call (. store text) ([] items 1))) "//")))
    (if (and (< origin (. items length)) (not (call is-blank-slot ([] items origin))))
      (call selector ([] items origin))
    )
    (+= origin 1)
    (for (in index (..< origin (. items length)))
      (let item ([] items index))
      (let fields (call (. store items) item))
      (match fields
        (case (list (call .atom _ "block") ...)
          (call hold item 1)
        )
        (case (list (call .atom _ "items:") ...)
          (call put " -> ")
          (call list fields 1 ", " ubrix-level-closure)
        )
        (case (list (call .atom _ "text:") ...)
          (call put (if-expr (and (> origin 1) (not (call is-blank-slot ([] items (- origin 1))))) "// " " "))
          (call interpolated fields 1 false)
        )
        (default
          (call probe-value item head)
        )
      )
    )
    (if (and (== head "probe-count") (== (. items length) 2))
      (call put " ++")
    )
  )
  (fn-do _ probe-value _
    (param item (of ImmutableTableRow SourceNode))
    (param head String)
    (match head
      (case= "probe-count"
        (call put " += ")
        (call expression item 0 false)
      )
      (case= "probe-assign"
        (call put " = ")
        (call expression item 0 false)
      )
      (default
        (call put " ")
        (call statement-inline item)
      )
    )
  )
  (fn-do _ statement-inline _
    (param node (of ImmutableTableRow SourceNode))
    (let saved-holder holder)
    (let saved-start start)
    (call statement node)
    (if (== holder null)
      (= holder saved-holder)
      (= start saved-start)
    )
  )
  (fn-do _ selector _
    (param node (of ImmutableTableRow SourceNode))
    (match (call (. store items) node)
      (case (list (call .atom _ ":") target name)
        (call expression target ubrix-level-closure false)
        (call put (str ":" (call (. store text) name)))
      )
      (default
        (call put (call (. store text) node))
      )
    )
  )
  (fn-do _ list _
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (param separator String)
    (param minimum Int)
    (for (in index (..< origin (. items length)))
      (if (> index origin)
        (call put separator)
      )
      (call expression ([] items index) minimum false)
    )
  )
  (fn-do _ keyframe-options Size
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (let index origin)
    (while (and (< index (. items length)) (call ubrix-is-keyword-head (?? (call (. store head) ([] items index)) "")))
      (call put " ")
      (call named ([] items index) (call (. store items) ([] items index)) false)
      (+= index 1)
    )
    (return index)
  )
  (fn-do _ rules Size
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (let index origin)
    (while (and (< index (. items length)) (call (. store is-form) ([] items index) "•"))
      (call put (if-expr (== index origin) " • " " "))
      (call rule-use (call (. store items) ([] items index)))
      (+= index 1)
    )
    (return index)
  )
  (fn-do _ rule-use _
    (param rule (of ImmutableTableSpan SourceNode))
    (call put (if-expr (> (. rule length) 1) (call (. store text) ([] rule 1)) ""))
    (let last (. rule length))
    (let guard (? (of ImmutableTableRow SourceNode)) null)
    (if (and (> last 2) (call (. store is-form) ([] rule (- last 1)) "if:"))
      (= guard ([] rule (- last 1)))
      (-= last 1)
    )
    (let barred no-prep)
    (= no-prep false)
    (if (== last 3)
      (call put ":")
      (call expression ([] rule 2) ubrix-level-prefix false)
      (else-if (> last 3)
        (call put "(")
        (for (in position (..< 2 last))
          (if (> position 2)
            (call put ", ")
          )
          (call expression ([] rule position) ubrix-level-closure false)
        )
        (call put ")")
      )
    )
    (if guard
      (call put " = ")
      (call expression (call (. store item) guard 1) ubrix-level-assign false)
    )
    (= no-prep barred)
  )
  (fn-do _ markup _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param is-tail Bool)
    (let head (?? (call (. store head) node) ""))
    (if (and (== head "<+") (== (. items length) 2))
      (call put (str "<+ (" (call (. store text) ([] items 1)) ")"))
      (return)
    )
    (if (!= head "<>")
      (call put "+ ")
    )
    (call tagged "<" .markup)
    (if (call (. store is-atom) ([] items 1))
      (call tagged (call (. store text) ([] items 1)) .markup)
      (else
        (call expression ([] items 1) ubrix-level-primary false)
      )
    )
    (let origin Size 2)
    (let has-id false)
    (while (< origin (. items length))
      (let fields (call (. store items) ([] items origin)))
      (match fields
        (case (list (call .atom _ "id:") name ...)
          (call put " ")
          (call tagged (call (. store text) name) .binder)
          (= has-id true)
        )
        (case (list (call .atom _ "slot:") name ...)
          (call put (if-expr has-id (str "(" (call (. store text) name) ")") (str " (" (call (. store text) name) ")")))
        )
        (case (list (call .atom _ "param:") name ...)
          (call put (str " - " (call (. store text) name)))
          (if (> (. fields length) 2)
            (call put " ")
            (call expression ([] fields 2) ubrix-level-primary false)
          )
        )
        (case (list (call .atom _ "value:") value ...)
          (call put " = ")
          (call guarded value ubrix-level-named false)
        )
        (case (list (call .atom _ "text:") value ...)
          (if (or (call (. store is-text) value) (call (. store is-form) value "str"))
            (call put " ")
            (call expression value ubrix-level-primary false)
            (else
              (call put " = ")
              (call guarded value ubrix-level-named false)
            )
          )
        )
        (default
          (break)
        )
      )
      (+= origin 1)
    )
    (= origin (call rules items origin))
    (let tag-start origin)
    (while (and (< origin (. items length)) (call (. store is-form) ([] items origin) "for:"))
      (+= origin 1)
    )
    (for (in position (..< tag-start origin))
      (let binding (call (. store items) ([] items position)))
      (call put (if-expr (== position tag-start) " for " ", "))
      (call put (if-expr (> (. binding length) 1) (call (. store text) ([] binding 1)) ""))
      (if (> (. binding length) 2)
        (call put " = ")
        (call expression ([] binding 2) ubrix-level-assign false)
      )
    )
    (if is-tail
      (call hold node origin)
      (else-if (< origin (. items length))
        (call elide " {…}")
      )
    )
  )
  (fn-do _ named _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param is-line Bool)
    (let head (?? (call (. store head) node) ""))
    (let is-optional (call (. head ends-with) "?"))
    (let name (if-expr is-optional ([] head (..< 1 (- (. head length) 1))) ([] head (... 1))))
    (let mark (if-expr is-optional "?" ""))
    (let value (? (of ImmutableTableRow SourceNode)) (only-if ([] items 1) (if (> (. items length) 1))))
    (let least (if-expr is-line ubrix-level-closure ubrix-level-print))
    (if (not value)
      (call put (str "•" mark " " name))
      (return)
    )
    (let ability (call ubrix-ability name))
    (let flag (if-expr (call (. store is-atom) value) (call (. store text) value) ""))
    (if (and (!= ability null) (or (== flag "true") (== flag "false")) (not is-optional))
      (let rest ([] name (... (+ (. ability length) 1))))
      (call put (if-expr (== flag "true") (str "• " ability " " rest) (str "• " ability " !" rest)))
      (return)
    )
    (call put (str "•" mark " " name))
    (if (and (call (. store is-form) value "block") is-line)
      (call hold value 1)
      (else
        (call put " ")
        (call guarded value least is-line)
      )
    )
  )
  (fn-do _ guarded _
    (param node (of ImmutableTableRow SourceNode))
    (param minimum Int)
    (param is-tail Bool)
    (let barred no-prep)
    (= no-prep true)
    (call expression node minimum is-tail)
    (= no-prep barred)
  )
  (fn-do _ free _
    (param node (of ImmutableTableRow SourceNode))
    (param minimum Int)
    (param is-tail Bool)
    (let barred no-prep)
    (= no-prep false)
    (call expression node minimum is-tail)
    (= no-prep barred)
  )
  (fn-do _ call _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (param minimum Int)
    (param is-tail Bool)
    (let named Size 0)
    (let extra Size 0)
    (let positional Size 0)
    (for (in index (..< (+ origin 1) (. items length)))
      (match (call argument-kind ([] items index))
        (case= (. UBrixArgument named)
          (+= named 1)
        )
        (case= (. UBrixArgument extra)
          (+= extra 1)
        )
        (default
          (+= positional 1)
        )
      )
    )
    (let has-named (> named 0))
    (let has-extra (> extra 0))
    (let is-tight (> minimum ubrix-level-named))
    (let last ([] items (- (. items length) 1)))
    (let is-flat (and (== extra 1) (not has-named) (or is-tight (not is-tail)) (call is-argued last)))
    (let is-wrapped
      (block
        (and (not is-flat) (or (and has-named (or no-prep is-tight)) (and has-extra (not has-named) is-tight)))
      )
    )
    (if is-wrapped
      (call put "(")
      (else-if (and is-tail (== tail null))
        (= tail node)
      )
    )
    (let outer (call streaming false))
    (let is-rowed (and is-tail (> positional 0) (not has-named) (not has-extra) (call elides items (+ origin 1))))
    (call expression ([] items origin) ubrix-level-primary false)
    (if is-rowed
      (call hold node (+ origin 1))
      (= is-arguing true)
      (else-if is-flat
        (call put "(")
        (for (in index (..< (+ origin 1) (- (. items length) 1)))
          (call free ([] items index) ubrix-level-closure false)
          (call put ", ")
        )
        (let given (call (. store items) last))
        (for (in index (..< 1 (. given length)))
          (if (> index 1)
            (call put ", ")
          )
          (call free (call (. store item) ([] given index) 1) ubrix-level-closure false)
        )
        (call put ")")
      )
      (else
        (if (or (> positional 0) (not (or has-named (and has-extra (call is-bare ([] items (- (. items length) 1)))))))
          (call put "(")
          (let wrote false)
          (for (in index (..< (+ origin 1) (. items length)))
            (let item ([] items index))
            (if (== (call argument-kind item) (. UBrixArgument positional))
              (if wrote
                (call put ", ")
              )
              (call free item ubrix-level-closure false)
              (= wrote true)
            )
          )
          (call put ")")
        )
        (for (in index (..< (+ origin 1) (. items length)))
          (call trailing ([] items index) (and is-tail (not is-wrapped) (== (+ index 1) (. items length))))
        )
      )
    )
    (= is-stream outer)
    (if is-wrapped
      (call put ")")
    )
  )
  (fn-do _ is-argued Bool
    (param node (of ImmutableTableRow SourceNode))
    (return-if false (if (or (not (call (. store is-form) node "block")) (< (call (. store count) node) 2))))
    (blank)
    (for (in item (call (. store listed) node 1))
      (return-if false (if (or (not (call (. store is-form) item "arg")) (!= (call (. store count) item) 2))))
    )
    (return true)
  )
  (fn-do _ elides Bool
    (param items (of ImmutableTableSpan SourceNode))
    (param first Size)
    (let quiet is-quiet)
    (let elided is-elided)
    (let texted has-text)
    (let field is-field)
    (let setting is-setting)
    (let binding is-binding)
    (let binder binds-clause)
    (= is-quiet true)
    (= is-elided false)
    (for (in index (..< first (. items length)))
      (call free ([] items index) ubrix-level-closure false)
    )
    (let found is-elided)
    (= is-quiet quiet)
    (= is-elided elided)
    (= has-text texted)
    (= is-field field)
    (= is-setting setting)
    (= is-binding binding)
    (= binds-clause binder)
    (return found)
  )
  (fn-expr _ is-bare Bool
    (param last (of ImmutableTableRow SourceNode))
    (or (call (. store is-form) last "inline") (and (call (. store is-form) last "block") (not (call ubrix-is-scope store last))))
  )
  (fn-do _ trailing _
    (param item (of ImmutableTableRow SourceNode))
    (param is-line Bool)
    (let fields (call (. store items) item))
    (match fields
      (case (list (call .atom _ ({} (call ubrix-is-keyword-head it))) ...)
        (call put " ")
        (call named item fields is-line)
      )
      (case (list (call .atom _ (: word ({} (or (== it "entry") (== it "entry?"))))) key ...)
        (call put (if-expr (== word "entry") " • (" " •? ("))
        (call expression key ubrix-level-closure false)
        (call put ")")
        (if (>= (. fields length) 3)
          (call put " ")
          (call guarded ([] fields 2) (if-expr is-line ubrix-level-closure ubrix-level-print) is-line)
        )
      )
      (case (list (call .atom _ "inline") body)
        (call put ": ")
        (call free body 0 is-line)
      )
      (case (list (call .atom _ "block") ...)
        (if is-line
          (call hold item 1)
          (else
            (call elide " {…}")
          )
        )
      )
      (default
        (return)
      )
    )
  )
  (fn-do _ binary _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param level Int)
    (param minimum Int)
    (param is-tail Bool)
    (let is-wrapped (< level minimum))
    (if is-wrapped
      (call put "(")
      (else-if (and is-tail (== tail null) (!= level ubrix-level-assign))
        (= tail node)
      )
    )
    (let head (call (. store text) ([] items 0)))
    (let op (call ubrix-operator-text head))
    (let inner (if-expr (== op "||") ubrix-level-prefix level))
    (let count (. items length))
    (for (in index (..< 1 count))
      (let item ([] items index))
      (if (and (== head "only-if") (> index 1))
        (= item (call unguarded item))
      )
      (let held (?? (call (. store head) item) ""))
      (let least (if-expr (== index 1) level (+ level 1)))
      (if (and (== held "and") (== op "||"))
        (= least inner)
      )
      (if (and (== index 1) (== held head))
        (= least (+ level 1))
      )
      (let is-left (or (< (+ index 1) count) (>= level ubrix-level-coalesce)))
      (if (and is-left (<= level ubrix-level-named) (call ends-named item))
        (= least ubrix-level-primary)
      )
      (if (and (> index 1) (call (. head starts-with) "is") (or (== held "all") (== held "|")))
        (= least 0)
      )
      (if (and (== index 1) (== head "=") (call is-stream-match item))
        (= least 0)
      )
      (let inner-level (if-expr (>= (call (. store count) item) 3) (call ubrix-precedence held) 0))
      (let is-custom (and (>= inner-level 18) (<= inner-level 20)))
      (if (and (== index 1) (== head "as") (> inner-level 0) (!= held "as"))
        (= least ubrix-level-primary)
      )
      (if (and (or (== level 12) (== level 13)) is-custom)
        (= least ubrix-level-primary)
      )
      (if (and (>= level 18) (<= level 20) (> inner-level 0) (!= held head))
        (= least ubrix-level-primary)
      )
      (if (and (== inner-level ubrix-level-assign) (!= level ubrix-level-assign))
        (= least ubrix-level-primary)
      )
      (if (and (== level ubrix-level-assign) (> index 1) (== (+ index 1) count) (call holds-rows item))
        (= least ubrix-level-named)
      )
      (if (and (> index 2) (== head "~>") (== held "with") (== (call (. store count) item) 2))
        (call put " with ")
        (call expression
          (block
            (arg ([] (call (. store items) item) 1))
            (arg (call ubrix-precedence "or"))
            (arg (and is-tail (not is-wrapped) (== (+ index 1) count)))
          )
        )
        (continue)
      )
      (if (> index 1)
        (call put (?? (call ubrix-glued-operator op) (str " " op " ")))
      )
      (let is-last (and is-tail (not is-wrapped) (== (+ index 1) count)))
      (if (and is-last (== level ubrix-level-assign) (== tail null))
        (= tail item)
      )
      (let outer (call streaming (and (== head "~>") (== index 2))))
      (call expression item least is-last)
      (= is-stream outer)
    )
    (if is-wrapped
      (call put ")")
    )
  )
  (fn-expr _ choice-level Int
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (or (== level ubrix-level-assign) (call ends-named node)) ubrix-level-primary ubrix-level-coalesce)
    (where
      (lazy level (if-expr (>= (call (. store count) node) 3) (call ubrix-precedence (?? (call (. store head) node) "")) 0))
    )
  )
  (fn-do _ ends-named Bool
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store items) node))
    (let count (. items length))
    (return-if false (if (< count 2)))
    (blank)
    (let head (?? (call (. store head) node) ""))
    (return-if (call ends-named ([] items 1)) (if (and (or (== head "catch") (== head "catch?")) (== count 2))))
    (blank)
    (let level (call ubrix-precedence head))
    (return-if (call ends-named (call unguarded ([] items (- count 1)))) (if (and (> level 0) (<= level ubrix-level-named) (>= count 3))))
    (return-if false (if (or (> level 0) (!= head "call"))))
    (return (call some (..< 2 count) (:where (call is-bullet-argument (?? (call (. store head) ([] items each)) "")))))
  )
  (fn-expr _ is-bullet-argument Bool
    (param head String)
    (or (call ubrix-is-keyword-head head) (== head "entry") (== head "entry?"))
  )
  (fn-do _ prefix _
    (param text String)
    (param node (of ImmutableTableRow SourceNode))
    (param level Int)
    (param minimum Int)
    (param is-tail Bool)
    (param whole (? (of ImmutableTableRow SourceNode)) (= null))
    (let is-wrapped (< level minimum))
    (if is-wrapped
      (call put "(")
      (else-if (and is-tail (== tail null) (!= whole null))
        (= tail whole)
      )
    )
    (call put text)
    (call expression node level (and is-tail (not is-wrapped)))
    (if is-wrapped
      (call put ")")
    )
  )
  (fn-do _ closure _
    (param items (of ImmutableTableSpan SourceNode))
    (param minimum Int)
    (param is-tail Bool)
    (let is-wrapped (> minimum ubrix-level-closure))
    (if is-wrapped
      (call put "(")
    )
    (let params (call (. store items) ([] items 1)))
    (if (> (. params length) 0)
      (call put ":: ")
      (for (in index (..< 0 (. params length)))
        (if (> index 0)
          (call put ", ")
        )
        (let param ([] params index))
        (let spread (call spread-name param))
        (if spread
          (call put (str "... " spread))
          (if (call (. store is-form) param ":")
            (call put " ")
            (call expression ([] (call (. store items) param) 2) ubrix-level-primary false)
          )
          (else
            (call expression param (if-expr (call (. store is-form) param ":") 0 ubrix-level-primary) false)
          )
        )
      )
      (call put " =>")
      (else
        (call put "=>")
      )
    )
    (let origin Size 2)
    (if (and (< origin (. items length)) (call is-word ([] items origin) ":do"))
      (call put " do")
      (+= origin 1)
    )
    (if (< origin (. items length))
      (let body ([] items origin))
      (if (not (call (. store is-form) body "block"))
        (call put " ")
        (call expression body ubrix-level-closure (and is-tail (not is-wrapped)))
        (else-if (and is-tail (not is-wrapped))
          (call hold body 1)
        )
        (else
          (call elide " {…}")
        )
      )
    )
    (if is-wrapped
      (call put ")")
    )
  )
  (fn-do _ spread-name (? String)
    (param param (of ImmutableTableRow SourceNode))
    (let name (if-expr (call (. store is-form) param ":") ([] (call (. store items) param) 1) param))
    (return-if null (if (not (call (. store is-atom) name))))
    (blank)
    (let text (call (. store text) name))
    (return-if null (if (or (not (call (. text starts-with) "...")) (<= (. text length) 3))))
    (blank)
    (let rest "")
    (let column 0)
    (for (in c text)
      (++=? rest (only-if c (if (>= column 3))))
      (+= column 1)
    )
    (return rest)
  )
  (fn-do _ quoted-lines _
    (param items (of ImmutableTableSpan SourceNode))
    (call put "\"")
    (for (in index (..< 1 (. items length)))
      (if (> index 1)
        (call put "\\n")
      )
      (let line ([] items index))
      (match line
        (case (call .string _ text)
          (call put (call ubrix-escaped text))
        )
        (case (call .list _ start count)
          (if (call (. store is-form) line "str")
            (call interpolated-parts ([] (. store nodes) (..< start (+ start count))) 1 true)
          )
        )
        (default
          (call braced line)
        )
      )
    )
    (call put "\"")
  )
  (fn-do _ interpolated _
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (param is-quoted Bool)
    (if is-quoted
      (call put "\"")
    )
    (call interpolated-parts items origin is-quoted)
    (if is-quoted
      (call put "\"")
    )
  )
  (fn-do _ interpolated-parts _
    (param items (of ImmutableTableSpan SourceNode))
    (param origin Size)
    (param is-quoted Bool)
    (for (in index (..< origin (. items length)))
      (let part ([] items index))
      (let is-joined (and (< (+ index 1) (. items length)) (call continues ([] items (+ index 1)))))
      (match part
        (case (call .string _ text)
          (call put (if-expr is-quoted (call ubrix-escaped text) (call ubrix-line-escaped text)))
        )
        (case (call .atom _ name)
          (if (and (call ubrix-is-name name) (not is-joined))
            (call put "\$")
            (let before column)
            (call tagged name .name)
            (if (!= (. targets length) 0)
              (call note part before)
            )
            (else
              (call braced part)
            )
          )
        )
        (case (call .list _ start count)
          (call embedded part ([] (. store nodes) (..< start (+ start count))) is-joined)
        )
        (default
          (call braced part)
        )
      )
    )
  )
  (fn-do _ embedded _
    (param part (of ImmutableTableRow SourceNode))
    (param fields (of ImmutableTableSpan SourceNode))
    (param is-joined Bool)
    (match fields
      (case (list (call .atom _ (: word ({} (or (== it "preview") (== it "snapshot"))))) shown ...)
        (let mark (if-expr (== word "preview") "\$?" "\$!"))
        (let name (if-expr (call (. store is-atom) shown) (call (. store text) shown) ""))
        (if (and (call ubrix-is-name name) (not is-joined))
          (call put (str mark name))
          (else
            (call put (str mark "{"))
            (call expression shown 0 false)
            (call put "}")
          )
        )
      )
      (default
        (call braced part)
      )
    )
  )
  (fn-do _ braced _
    (param part (of ImmutableTableRow SourceNode))
    (call put "\${")
    (call expression part 0 false)
    (call put "}")
  )
  (fn-do _ range _
    (param items (of ImmutableTableSpan SourceNode))
    (param head String)
    (param minimum Int)
    (let is-wrapped (> minimum 17))
    (if is-wrapped
      (call put "(")
    )
    (let operands (list (of ImmutableTableRow SourceNode)))
    (let step (? (of ImmutableTableRow SourceNode)) null)
    (for (in index (..< 1 (. items length)))
      (if (call (. store is-form) ([] items index) "by:")
        (= step ([] items index))
        (else
          (+= operands ([] items index))
        )
      )
    )
    (if (== head "...")
      (call open-range operands)
      (else-if (== (. operands length) 2)
        (call expression ([] operands 0) 18 false)
        (call put (if-expr (== head "..") " .. " " .. < "))
        (call expression ([] operands 1) 18 false)
      )
    )
    (if step
      (call put " by ")
      (call expression (call (. store item) step 1) 18 false)
    )
    (if is-wrapped
      (call put ")")
    )
  )
  (fn-do _ open-range _
    (param operands (list (of ImmutableTableRow SourceNode)))
    (match (. operands length)
      (case= 2
        (call put "... ")
        (call expression ([] operands 1) 18 false)
      )
      (case= 1
        (call expression ([] operands 0) 18 false)
        (call put " ...")
      )
      (default
        (call put "...")
      )
    )
  )
  (fn-do _ expression _
    (param node (of ImmutableTableRow SourceNode))
    (param minimum Int)
    (param is-tail Bool)
    (if (and is-tail (== tail null) (<= minimum ubrix-level-named) (call ends-tail node))
      (= tail node)
    )
    (let before column)
    (match node
      (case (call .comment _ text)
        (call put (str "` " text))
      )
      (case (call .string _ text)
        (call quoted text)
      )
      (case (call .atom _ text)
        (if (or is-field (not (call ubrix-is-name text)))
          (call put text)
          (else
            (call tagged text (if-expr is-setting (. UBrixTagKind setting) (if-expr is-binding (. UBrixTagKind binder) (. UBrixTagKind name))))
          )
        )
        (= is-setting false)
      )
      (case (call .list _ start count)
        (call operation node ([] (. store nodes) (..< start (+ start count))) minimum is-tail)
      )
    )
    (if (!= (. targets length) 0)
      (call note node before)
    )
  )
  (fn-do _ operation _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param minimum Int)
    (param is-tail Bool)
    (match items
      (case (list)
        (call put "()")
      )
      (case (list (call .atom _ "call") _ ...)
        (call call node items 1 minimum is-tail)
      )
      (case (list (call .atom _ "paragraph") ...)
        (if is-tail
          (call put "\"")
          (call hold node 1)
          (else
            (call quoted-lines items)
          )
        )
      )
      (case (list (call .atom _ "scope") value ...)
        (let is-wrapped (> minimum ubrix-level-named))
        (if is-wrapped
          (call put "(")
        )
        (call expression value minimum false)
        (if (and is-tail (not is-wrapped))
          (call hold node 2)
          (else
            (call elide " {…}")
          )
        )
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it ".") (== it "?.") (== it "*."))))) target _ ...)
        (if (and is-tail (== tail null))
          (= tail node)
        )
        (let is-number (call is-number-atom target))
        (if is-number
          (call put "(")
        )
        (call expression target ubrix-level-primary false)
        (if is-number
          (call put ")")
        )
        (for (in index (..< 2 (. items length)))
          (call put op)
          (= is-field true)
          (call expression ([] items index) ubrix-level-primary false)
          (= is-field false)
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "[]") (== it "?[]"))))) target slot)
        (call expression target ubrix-level-primary false)
        (call put (if-expr (== op "[]") "[" "?["))
        (call free slot 0 false)
        (call put "]")
      )
      (case (list (call .atom _ "[]") target)
        (call expression target ubrix-level-primary false)
        (call put "[]")
      )
      (case (list (call .atom _ "!!") target)
        (call expression target ubrix-level-postfix false)
        (call put "!")
      )
      (case (list (call .atom _ "shape") shape value)
        (call expression shape ubrix-level-primary false)
        (call put ":")
        (let is-bare (call is-bare-shape value))
        (if (not is-bare)
          (call put "(")
        )
        (call expression value (if-expr is-bare ubrix-level-primary 0) false)
        (if (not is-bare)
          (call put ")")
        )
      )
      (case (list (call .atom _ "of") target ...)
        (if (and is-tail (== tail null))
          (= tail node)
        )
        (call expression target ubrix-level-primary false)
        (for (in index (..< 2 (. items length)))
          (let argument ([] items index))
          (if (not (call is-ticked argument))
            (call put "'")
          )
          (if (call is-bare-argument argument)
            (call expression argument ubrix-level-primary false)
            (else
              (call put "(")
              (call expression argument ubrix-level-closure false)
              (call put ")")
            )
          )
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "?") (== it "*") (== it "+"))))) target)
        (if (or is-stream (== op "?"))
          (call expression target ubrix-level-primary false)
          (call put op)
          (else
            (call expression target minimum is-tail)
          )
        )
      )
      (case (list (call .atom _ "channel") target)
        (call expression target ubrix-level-primary false)
        (call put "<>")
      )
      (case (list (call .atom _ (: op ({} (or (== it "exact") (== it "similar"))))) target)
        (call expression target ubrix-level-primary false)
        (call put (if-expr (== op "exact") "!" "~"))
      )
      (case (list (call .atom _ (: op ({} (or (== it "!") (== it "-") (== it "&"))))) operand)
        (call prefix op operand ubrix-level-prefix minimum is-tail node)
      )
      (case (list (call .atom _ "not") operand)
        (call prefix "!" operand ubrix-level-prefix minimum is-tail node)
      )
      (case (list (call .atom _ (: op ({} (call ubrix-is-word-prefix it)))) operand)
        (call prefix (str op " ") operand ubrix-level-prefix minimum is-tail)
      )
      (case (list (call .atom _ "~") operand)
        (let outer (call streaming true))
        (call prefix "~ " operand ubrix-level-closure minimum is-tail)
        (= is-stream outer)
      )
      (case (list (call .atom _ "~") _ _ ...)
        (let is-wrapped (> minimum ubrix-level-closure))
        (if is-wrapped
          (call put "(")
        )
        (call alternative node items (and is-tail (not is-wrapped)))
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "|") (== it "<*"))))) operand)
        (call prefix (str op " ") operand ubrix-level-select minimum is-tail)
      )
      (case (list (call .atom _ "list") ...)
        (call put "[")
        (let barred no-prep)
        (= no-prep false)
        (call list items 1 ", " ubrix-level-closure)
        (= no-prep barred)
        (call put "]")
      )
      (case (list (call .atom _ "map") key value)
        (call put "[")
        (call expression key ubrix-level-primary false)
        (call put " = ")
        (call expression value ubrix-level-primary false)
        (call put "]")
      )
      (case (list (call .atom _ "stream") item)
        (call put "<")
        (call expression item ubrix-level-closure false)
        (call put ">")
      )
      (case (list (call .atom _ "tuple") ...)
        (let is-wrapped (or (> minimum ubrix-level-tuple) (== (. items length) 2)))
        (let barred no-prep)
        (if is-wrapped
          (call put "(")
          (= no-prep false)
        )
        (call list items 1 ", " ubrix-level-closure)
        (= no-prep barred)
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ ":") left right)
        (let is-wrapped (>= minimum ubrix-level-prefix))
        (if is-wrapped
          (call put "(")
        )
        (call expression left ubrix-level-primary false)
        (call put " ")
        (call expression right ubrix-level-primary false)
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ ({} (or (== it "all") (== it "seq")))) ...)
        (let is-wrapped (> minimum 2))
        (if is-wrapped
          (call put "(")
        )
        (call list items 1 " " 3)
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ "|") _ _ ...)
        (let is-wrapped (> minimum 3))
        (if is-wrapped
          (call put "(")
        )
        (call list items 1 " | " 4)
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ "str") ...)
        (call interpolated items 1 true)
      )
      (case (list (call .atom _ "char") value)
        (call put (str "'" (call ubrix-char-escaped (call (. store text) value)) "'"))
      )
      (case (list (call .atom _ "chars") value)
        (call put (str "[" (call (. store text) value) "]"))
      )
      (case (list (call .atom _ "{}") body)
        (call put "{ ")
        (let outer (call streaming false))
        (call expression body 0 false)
        (= is-stream outer)
        (call put " }")
      )
      (case (list (call .atom _ "{}") target _ ...)
        (call expression target ubrix-level-primary false)
        (call put "{")
        (let outer (call streaming false))
        (call list items 2 ", " ubrix-level-closure)
        (= is-stream outer)
        (call put "}")
      )
      (case (list (call .atom _ "\\{}") body)
        (call put "\\{ ")
        (let outer (call streaming false))
        (call expression body 0 false)
        (= is-stream outer)
        (call put " }")
      )
      (case (list (call .atom _ "into") ...)
        (call put "into ")
        (call list items 1 ": " ubrix-level-primary)
      )
      (case (list (call .atom _ "=>") _ ...)
        (call closure items minimum is-tail)
      )
      (case (list (call .atom _ "if-expr") test value otherwise)
        (let is-wrapped (> minimum ubrix-level-closure))
        (if is-wrapped
          (call put "(")
          (else-if (and is-tail (== tail null))
            (= tail node)
          )
        )
        (call put "if ")
        (call expression test (call choice-level test) false)
        (call put " then ")
        (call expression value (call choice-level value) false)
        (call put " else ")
        (let is-named (call ends-named otherwise))
        (call expression
          (block
            (arg otherwise)
            (arg (if-expr is-named ubrix-level-primary ubrix-level-closure))
            (arg (and is-tail (not is-wrapped) (not is-named)))
          )
        )
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "catch") (== it "catch?"))))) operand)
        (let is-wrapped (> minimum ubrix-level-pipe))
        (if is-wrapped
          (call put "(")
          (else-if (and is-tail (== tail null))
            (= tail node)
          )
        )
        (call put (str op " "))
        (call expression operand ubrix-level-named (and is-tail (not is-wrapped)))
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "print") (== it "print?"))))) operand)
        (call prefix
          (block
            (arg (if-expr (call (. op ends-with) "?") "--? " "-- "))
            (arg operand)
            (arg ubrix-level-print)
            (arg minimum)
            (arg is-tail)
          )
        )
      )
      (case (list (call .atom _ "##") operand)
        (call prefix "##" operand ubrix-level-tuple minimum is-tail)
      )
      (case (list (call .atom _ (: op ({} (or (== it "use") (== it "use?"))))) operand)
        (call prefix (str op " ") operand ubrix-level-tuple minimum is-tail)
      )
      (case (list (call .atom _ (: op ({} (or (== it "in") (== it "on"))))) _ ...)
        (call sourced items op minimum)
      )
      (case (list (call .atom _ "each") _ ...)
        (call list items 1 " " ubrix-level-select)
      )
      (case (list (call .atom _ (: op ({} (call ubrix-is-clause-head it)))) operand)
        (call put (str op " "))
        (call expression operand ubrix-level-assign false)
      )
      (case (list (call .atom _ "keyed-by") operand)
        (call put "keyed by ")
        (call expression operand ubrix-level-assign false)
      )
      (case (list (call .atom _ "by:") operand)
        (call put "by ")
        (call expression operand 18 false)
      )
      (case (list (call .atom _ (: word ({} (or (== it "and") (== it "and-for"))))) first ...)
        (if (call is-looped first)
          (call list items 1 " and " ubrix-level-assign)
          (else
            (call binary node items (call ubrix-precedence word) minimum is-tail)
          )
        )
      )
      (case (list (call .atom _ (: word ({} (or (== it "or") (== it "or-for"))))) ...)
        (if (or (< (. items length) 3) (call is-looped ([] items 1)))
          (call put "or ")
          (call list items 1 " " 0)
          (else
            (call binary node items (call ubrix-precedence word) minimum is-tail)
          )
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "..") (== it "..<") (== it "..."))))) ...)
        (call range items op minimum)
      )
      (case (list (call .atom _ "select") source choice)
        (let is-wrapped (> minimum ubrix-level-select))
        (if is-wrapped
          (call put "(")
        )
        (call expression source ubrix-level-pipe false)
        (call put " ")
        (call expression choice (if-expr (call is-stream-match choice) 0 ubrix-level-select) false)
        (if is-wrapped
          (call put ")")
        )
      )
      (case (list (call .atom _ (: op ({} (or (== it "match") (== it "match?"))))) subject ...)
        (call put (str op " "))
        (call expression subject 0 false)
        (if is-tail
          (call hold node 2)
          (else
            (call elide " {…}")
          )
        )
      )
      (case (list (call .atom _ "block") ...)
        (if is-tail
          (call hold node 1)
          (else
            (call elide "{…}")
          )
        )
      )
      (case (list (call .atom _ "inline") body)
        (call put ": ")
        (call expression body 0 is-tail)
      )
      (case (list (call .atom _ ({} (or (== it "<>") (== it "+<>") (== it "<+")))) ...)
        (call markup node items is-tail)
      )
      (case (list (call .atom _ (: op ({} (or (== it "fn-type") (== it "c-fn-type"))))) result ...)
        (call put (if-expr (== op "fn-type") "() " "(*C) "))
        (call expression result ubrix-level-primary false)
        (call signature-tail items 2)
      )
      (case (list (call .atom _ "c-struct") ...)
        (call put "C:(")
        (call list items 1 ", " ubrix-level-closure)
        (call put ")")
      )
      (case (list (call .atom _ "iterate") _ ...)
        (call iteration node items is-tail)
      )
      (case (list (call .atom _ (: op ({} (or (== it "preview") (== it "snapshot"))))) body)
        (call put (if-expr (== op "preview") "\$?{" "\$!{"))
        (call free body 0 false)
        (call put "}")
      )
      (case (list (call .atom _ (: op ({} (call ubrix-is-do-head it)))) ...)
        (call do-block node items op)
      )
      (case (list (call .atom _ (: op ({} (or (== it "if") (== it "while"))))) _ ...)
        (call put (str op " "))
        (call condition node items)
      )
      (case (list (call .atom _ ({} (call ubrix-is-keyword-head it))) ...)
        (call named node items false)
      )
      (case (list (call .atom _ ({} (call ubrix-is-inline-statement it))) ...)
        (call statement-inline node)
      )
      (case (list (call .atom _ "only-if") value ...)
        (if (or (call is-guard value) (not (call is-guard ([] items (- (. items length) 1)))))
          (call put (call sexp-inline-text store node))
          (else
            (call binary node items ubrix-level-if minimum is-tail)
          )
        )
      )
      (case (list (call .atom _ (: op ({} (> (call ubrix-precedence it) 0)))) _ _ ...)
        (call binary node items (call ubrix-precedence op) minimum is-tail)
      )
      (default
        (call put (call sexp-inline-text store node))
      )
    )
  )
  (fn-do _ sourced _
    (param items (of ImmutableTableSpan SourceNode))
    (param op String)
    (param minimum Int)
    (let first ([] items 1))
    (let is-binder binds-clause)
    (= binds-clause false)
    (let is-wrapped (> minimum ubrix-level-assign))
    (if is-wrapped
      (call put "(")
    )
    (let origin (if-expr (call is-unbound-source items) 1 2))
    (if (and (== origin 2) (call (. store is-form) first "tuple") (> (call (. store count) first) 2))
      (let is-listed (or (not is-binder) (>= minimum ubrix-level-closure)))
      (call put (if-expr is-listed "(" ""))
      (call list (call (. store items) first) 1 ", " ubrix-level-closure)
      (call put (if-expr is-listed ") " " "))
      (else-if (== origin 2)
        (call expression first (if-expr (call is-stream-match first) 0 ubrix-level-select) false)
        (call put " ")
      )
    )
    (call put op)
    (for (in index (..< origin (. items length)))
      (call put " ")
      (call expression
        (block
          (arg ([] items index))
          (arg (if-expr (call is-stream-source ([] items index)) 0 ubrix-level-select))
          (arg false)
        )
      )
    )
    (if is-wrapped
      (call put ")")
    )
    (= binds-clause is-binder)
  )
  (fn-do _ loop-clause _
    (param node (of ImmutableTableRow SourceNode))
    (= binds-clause true)
    (call expression node 0 false)
    (= binds-clause false)
  )
  (fn-do _ iteration _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param is-tail Bool)
    (let count (. items length))
    (if is-tail
      (let body (call ubrix-iterate-body store node))
      (for (in index (..< 1 count))
        (if (and (!= index body) (not (call ubrix-takes-arm store node ([] items index))))
          (if (> index 1)
            (call put " ")
          )
          (call loop-clause ([] items index))
        )
      )
      (call hold (if-expr (< body count) ([] items body) node) (if-expr (< body count) 1 count))
      (= armed node)
      (return)
    )
    (let last ([] items (- count 1)))
    (let shown (if-expr (call (. store is-form) last "block") (- count 1) count))
    (for (in index (..< 1 shown))
      (if (> index 1)
        (call put " ")
      )
      (call loop-clause ([] items index))
    )
    (if (< shown count)
      (call elide " {…}")
    )
  )
)

(fn-expr + ubrix-is-keyword-head Bool
  (param head String)
  (and (> (. head length) 1) (call (. head starts-with) ":") (not (call (. head ends-with) ":")))
)

(fn-expr + ubrix-is-case Bool
  (param head String)
  (or (== head "case") (== head "case?") (== head "case=") is-union)
  (where
    (lazy is-union (or (== head "case-union") (== head "case-union?") (== head "case-union=")))
  )
)

(fn-expr + ubrix-operator-text String
  (param head String)
  (match head
    (case= "only-if"
      "if"
    )
    (case= "is-in"
      "is in"
    )
    (case= "not-in"
      "not in"
    )
    (case= "has-not"
      "has not"
    )
    (case= "is-not"
      "is not"
    )
    (case= "is!-not"
      "is! not"
    )
    (case= "is~-not"
      "is~ not"
    )
    (case= "and"
      "&&"
    )
    (case= "or"
      "||"
    )
    (default
      head
    )
  )
)

(fn-expr + ubrix-precedence Int
  (param head String)
  (case? (== head "??")
    ubrix-level-coalesce
  )
  (case? (== head "only-if")
    ubrix-level-if
  )
  (case? is-assign
    ubrix-level-assign
  )
  (case? is-pipe
    ubrix-level-pipe
  )
  (case? (== head "or")
    10
  )
  (case? (== head "and")
    11
  )
  (case? (or (== head "<") (== head ">") (== head "<=") (== head ">="))
    12
  )
  (case? (or (== head "==") (== head "!="))
    13
  )
  (case? (== head "as")
    14
  )
  (case? is-test
    15
  )
  (case? is-shift
    16
  )
  (case? is-additive
    21
  )
  (case? (or (== head "*") (== head "/") (== head "%") (== head "%%"))
    22
  )
  (case? (or (< (. bytes length) 3) (!= ([] bytes 0) 47) (!= ([] bytes (- (. bytes length) 1)) 47))
    0
  )
  (case? (call (. head starts-with) "///")
    18
  )
  (case? (call (. head starts-with) "//")
    19
  )
  (default
    20
  )
  (where
    (lazy is-assign
      (scope (or is-update is-guarded (== head "=") (== head "++=") (== head "<-*") (== head "<->"))
        (lazy is-update (or (== head "+=") (== head "-=") (== head "*=") (== head "/=") is-modulo))
        (lazy is-modulo (or (== head "%=") (== head "%%=")))
        (lazy is-guarded
          (scope (or is-guarded-update (== head "=?") (== head "++=?") (== head "<-*?"))
            (lazy is-guarded-update
              (block
                (or (== head "+=?") (== head "-=?") (== head "*=?") (== head "/=?") is-guarded-modulo)
              )
            )
            (lazy is-guarded-modulo (or (== head "%=?") (== head "%%=?")))
          )
        )
      )
    )
    (lazy is-pipe
      (scope (or is-stage is-flow (== head "|>") (== head "|=>") (== head "<|"))
        (lazy is-stage (or (== head "*>") (== head "?>") (== head "*|>") (== head "?*>")))
        (lazy is-flow (or (== head "*->") (== head "->") (== head "~>")))
      )
    )
    (lazy is-test
      (scope (or is-membership is-kind (== head "is") (== head "is-not"))
        (lazy is-membership (or (== head "is-in") (== head "not-in") (== head "has") (== head "has-not")))
        (lazy is-kind (or (== head "is!") (== head "is!-not") (== head "is~") (== head "is~-not")))
      )
    )
    (lazy is-shift
      (scope (or is-move (== head "?>>") (== head "?<<") (== head "?<-"))
        (lazy is-move (or (== head ">>") (== head "<<") (== head "<-")))
      )
    )
    (lazy is-additive
      (scope (or is-sum (== head "\\") (== head "*\\") (== head "*/"))
        (lazy is-sum (or (== head "+") (== head "-") (== head "++") (== head "--")))
      )
    )
    (lazy bytes (call byte-view head))
  )
)

(fn-expr _ ubrix-glued-operator (? String)
  (param op String)
  (case? (== op "?<-")
    "? <- "
  )
  (case? (== op "?>>")
    "? >> "
  )
  (case? (== op "?<<")
    "? << "
  )
)

(fn-do + ubrix-is-name Bool
  (param text String)
  (let bytes (call byte-view text))
  (return-if false (if (or (== (. bytes length) 0) (< ([] bytes 0) 97) (> ([] bytes 0) 122))))
  (return (call all bytes (:where (or (== each 45) (and (>= each 48) (<= each 57)) (and (>= each 97) (<= each 122))))))
)

(fn-expr + ubrix-quoted String
  (param value String)
  (str "\"" (call ubrix-escaped value) "\"")
)

(fn-expr + ubrix-escaped String
  (param value String)
  (call (. "" join) (in (call ubrix-escaped-char each) value))
)

(fn-do + ubrix-line-escaped String
  (param value String)
  (let chars (. value codepoints))
  (let parts (list String))
  (for (in index (..< 0 (. chars length)))
    (let c ([] chars index))
    (let next (if-expr (< (+ index 1) (. chars length)) ([] chars (+ index 1)) (char " ")))
    (if (and (== c '$') (call ubrix-leads-embed next))
      (+= parts (str "\\" c))
      (else-if (or (== c '$') (== c (char "\"")))
        (+= parts (str c))
      )
      (else
        (+= parts (call ubrix-escaped-char c))
      )
    )
  )
  (return (call (. "" join) parts))
)

(type _ UBrixArgument (is U8)
  (variant positional)
  (variant named)
  (variant extra)
)

(fn-expr _ ubrix-do-suffix String
  (param head String)
  (match head
    (case= "do-new"
      " new"
    )
    (case= "do-new-thread"
      " new thread"
    )
    (default
      ""
    )
  )
)

(fn-expr _ ubrix-parameter-mark (? String)
  (param text String)
  (case? (== text "...")
    "... "
  )
  (default
    null
  )
)

(fn-expr _ ubrix-is-word-prefix Bool
  (param head String)
  (or (== head "-=") (== head "<-") (== head "type-of") (== head "facts-of"))
)

(fn-expr _ ubrix-is-clause-head Bool
  (param head String)
  (or (== head "when") (== head "whenever") (== head "while") (== head "until"))
)

(fn-expr _ ubrix-is-inline-statement Bool
  (param head String)
  (or (call ubrix-is-case head) (== head "case-each") (== head "default") is-plain)
  (where
    (lazy is-plain
      (block
        (or (== head "throw") (== head "return") (== head "let") (== head "lazy") (== head "for"))
      )
    )
  )
)

(fn-expr _ ubrix-is-yield Bool
  (param head String)
  (or (== head "return?") (== head "yield") (== head "yield?") is-yield-all)
  (where
    (lazy is-yield-all (or (== head "yield-all") (== head "yield-all?")))
  )
)

(fn-expr _ ubrix-is-do-head Bool
  (param head String)
  (or (== head "do") (== head "do-new") (== head "do-new-thread") (== head "finally"))
)

(fn-expr _ ubrix-is-feed Bool
  (param head String)
  (or (== head "item") (== head "item?") (== head "spread") (== head "spread?"))
)

(fn-expr _ ubrix-binding-word String
  (param head String)
  (if-expr (== head "implements") "is" head)
)

(fn-expr _ ubrix-is-header-head Bool
  (param head String)
  (or (== head "param") (== head "constraint") (== head "iterates") (== head "claim") is-binding)
  (where
    (lazy is-binding (or (== head "implements") (== head "using") (== head "sees")))
  )
)

(fn-expr _ ubrix-is-probe Bool
  (param head String)
  (or (== head "probe") (== head "probe-count") (== head "probe-group") is-probe-write)
  (where
    (lazy is-probe-write (or (== head "probe-assign") (== head "probe-log")))
  )
)

(fn-expr _ ubrix-case-mark String
  (param head String)
  (match head
    (case= "case"
      "|"
    )
    (case= "case?"
      "|?"
    )
    (case= "case="
      "|="
    )
    (case= "case-union"
      "||"
    )
    (case= "case-union?"
      "||?"
    )
    (default
      "||="
    )
  )
)

(fn-expr _ ubrix-return-mark String
  (param head String)
  (match head
    (case= "return?"
      "=?"
    )
    (case= "yield"
      "<="
    )
    (case= "yield?"
      "<=?"
    )
    (case= "yield-all"
      "<<="
    )
    (default
      "<<=?"
    )
  )
)

(fn-expr _ ubrix-starts-divider Bool
  (param text String)
  (and (> (. chars length) 0) (or (== first (char "━")) (== first (char "─")) (== first (char "═"))))
  (where
    (lazy chars (. text codepoints))
    (lazy first ([] chars 0))
  )
)

(fn-expr _ ubrix-continues-name Bool
  (param text String)
  (and (> (. bytes length) 0) (or (== byte 45) (== byte 46) is-digit is-lower))
  (where
    (lazy bytes (call byte-view text))
    (lazy byte ([] bytes 0))
    (lazy is-digit (and (>= byte 48) (<= byte 57)))
    (lazy is-lower (and (>= byte 97) (<= byte 122)))
  )
)

(fn-expr _ ubrix-escaped-char String
  (param c Char)
  (case? (or (== c (char "\\")) (== c (char "\"")) (== c '$'))
    (str "\\" c)
  )
  (case? (== c (char "\n"))
    "\\n"
  )
  (case? (== c (char "\t"))
    "\\t"
  )
  (case? (== c (char "\r"))
    "\\r"
  )
  (case? (!= short null)
    short
  )
  (case? (call ubrix-is-control c)
    (call ubrix-unicode-escape c)
  )
  (default
    (as c String)
  )
  (where
    (lazy short (call ubrix-short-escape c))
  )
)

(fn-expr _ ubrix-leads-embed Bool
  (param c Char)
  (or (== c '{') (== c (char "°")) (and (>= c 'a') (<= c 'z')) is-greek)
  (where
    (lazy code (as c U32))
    (lazy is-greek (or (and (>= code 913) (<= code 937)) (and (>= code 945) (<= code 969))))
  )
)

(fn-expr _ ubrix-char-escaped String
  (param value String)
  (call (. "" join) (in (call ubrix-char-escaped-char each) value))
)

(fn-expr _ ubrix-char-escaped-char String
  (param c Char)
  (case? (or (== c (char "\\")) (== c (char "'")))
    (str "\\" c)
  )
  (case? (== c (char "\n"))
    "\\n"
  )
  (case? (== c (char "\t"))
    "\\t"
  )
  (case? (== c (char "\r"))
    "\\r"
  )
  (case? (!= short null)
    short
  )
  (case? (call ubrix-is-control c)
    (call ubrix-unicode-escape c)
  )
  (default
    (as c String)
  )
  (where
    (lazy short (call ubrix-short-escape c))
  )
)

(fn-expr _ ubrix-short-escape (? String)
  (param c Char)
  (match? (as c U32)
    (case= 8
      "\\b"
    )
    (case= 11
      "\\v"
    )
    (case= 12
      "\\f"
    )
  )
)

(fn-expr _ ubrix-is-control Bool
  (param c Char)
  (or (< code 32) (== code 127) (== code 133) (== code 8232) (== code 8233) (== code 64976))
  (where
    (lazy code (as c U32))
  )
)

(fn-expr _ ubrix-unicode-escape String
  (param c Char)
  (case? (== code 0)
    "\\0"
  )
  (case? (>= code 256)
    (str "\\u" high low)
  )
  (default
    (str "\\x" low)
  )
  (where
    (lazy code (as c U32))
    (lazy digits (. "0123456789abcdef" codepoints))
    (lazy high (str ([] digits (% (/ code 4096) 16)) ([] digits (% (/ code 256) 16))))
    (lazy low (str ([] digits (% (/ code 16) 16)) ([] digits (% code 16))))
  )
)

(fn-do _ ubrix-ability (? String)
  (param name String)
  (for (in ability (list "is" "has" "can" "does" "should" "must"))
    (return-if ability (if (and (call (. name starts-with) (str ability "-")) (> (. name length) (+ (. ability length) 1)))))
  )
  (return null)
)
