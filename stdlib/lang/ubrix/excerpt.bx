(import ./ubrix)
(import /code/structure/document)
(import /code/structure/rows)

(type + UBrixExcerpt (is Tuple)
  (prop + text String)
  (prop + start Size)
  (prop + width Size)
)

(type + UBrixExcerpts
  (prop + source String)
  (blank)
  (prop _ language UBrixLanguage)
  (prop _ document (? SourceDocument))
  (prop _ line-starts (list Index))
  (fn-do + This _
    (param source _)
    (lazy language (call UBrixLanguage))
    (= document (catch? (call source-document-read language source)))
    (let bytes (call byte-view source))
    (+= line-starts 0)
    (for (in index (..< 0 (. bytes size)))
      (if (== ([] bytes index) 10)
        (+= line-starts (+ index 1))
      )
    )
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call (. language store release))
  )
  (fn-do + at (? UBrixExcerpt)
    (param place MatchLocation)
    (let held document)
    (return-if null (if (not held)))
    (let first (call offset (. place begin)))
    (let last (call offset (. place end)))
    (return-if null (if (or (== first null) (== last null))))
    (let trail (call (. held trail-around) first (if-expr (< last first) first last)))
    (return-if null (if (== (. trail length) 0)))
    (let row (call (. held row-of-node) ([] trail 0)))
    (return-if null (if (== row null)))
    (let index (call (. held declaration-at) row))
    (let shown ([] (call (. held rows-of) index) (- row (call (. held first-row) index))))
    (let marked (call (. language marked-row) shown trail))
    (return-if null (if (not marked)))
    (let indent (. shown content-start))
    (return (call UBrixExcerpt (++ (* " " indent) (. marked text)) (+ indent (. marked start)) (- (. marked end) (. marked start))))
  )
  (fn-do _ offset (? Index)
    (param place TokenLocation)
    (let line (as (. place line) Index))
    (return-if null (if (>= line (. line-starts length))))
    (let bytes (call byte-view source))
    (let column U32 0)
    (for (in position (..< ([] line-starts line) (. bytes size)))
      (let byte ([] bytes position))
      (if (or (< byte 128) (>= byte 192))
        (return-if position (if (== column (. place column))))
        (+= column 1)
      )
    )
    (return null)
  )
)
