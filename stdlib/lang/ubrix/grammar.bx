(import ./build)
(import /core/parsing)
(import /core/table)
(import /data/source-tree)

(type + UBrixEntry (is Union)
  (variant whole-file)
  (variant statement-row)
  (variant member-row)
  (variant rule-row)
  (variant use-row)
  (variant state-row)
  (variant keyframe-row)
  (variant prose-row)
  (variant head-row)
  (variant header-row)
)

(fn-expr + ubrix-grammar _ (over: Char)
  (param bx UBrixBuilder)
  (param entry UBrixEntry)
  (~ (seq (! (\{} (!= entry (. UBrixEntry whole-file)))) / (: v \statements) /)
    (call (. bx form) location "file" v)
  )
  (~ (seq / (: v \row))
    v
  )
  (where
    (lazy row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (& (\{} (== entry (. UBrixEntry statement-row)))) (: v \statement-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry member-row)))) (: v \member-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry rule-row)))) (: v \rule-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry use-row)))) (: v \use-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry state-row)))) (: v \state-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry keyframe-row)))) (: v \keyframe-statement) \row-end)
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry prose-row)))) (: v \string-block) \row-end)
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry head-row)))) (: v \head-row))
          v
        )
        (~ (seq (& (\{} (== entry (. UBrixEntry header-row)))) (: v \header-row))
          v
        )
      )
    )
    (blank)
    (lazy statement-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \else-if-branch) \row-end)
          v
        )
        (~ (seq (: v \else-branch) \row-end)
          v
        )
        (~ (seq (: v \catch) \row-end)
          v
        )
        (~ (seq (: v \or-loop) \row-end)
          v
        )
        (~ (seq (: v \and-loop) \row-end)
          v
        )
        (~ (seq (: v \statement) \row-end)
          v
        )
      )
    )
    (blank)
    (lazy member-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \keyframe-member) \row-end)
          v
        )
        (~ (seq (: v \own-rule-row) \row-end)
          v
        )
        (~ (seq (: v \style-rule-member) \row-end)
          v
        )
        (~ (seq (: v \member) \row-end)
          v
        )
        (~ \statement-row)
      )
    )
    (blank)
    (lazy rule-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \own-rule-row) \row-end)
          v
        )
        (~ (seq (: v \style-rule-member) \row-end)
          v
        )
        (~ \statement-row)
      )
    )
    (blank)
    (lazy own-rule-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "•" // "own" // (: name \style-selector-name) (: arg (? \style-rule-inline-argument)) (: rules (? \style-rule-applications)))
          (call (. bx form) location "own-rule" (call (. bx atom) location name) arg rules)
        )
      )
    )
    (blank)
    (lazy use-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "•" // (! (seq "own" //)) (: v \style-rule-application) \row-end)
          v
        )
        (~ \rule-row)
      )
    )
    (blank)
    (lazy state-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \state-case) \row-end)
          v
        )
        (~ (seq (: v \state-continuation) \row-end)
          v
        )
        (~ (seq (: v \state-fallback) \row-end)
          v
        )
        (~ \statement-row)
      )
    )
    (blank)
    (lazy head-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \extension-block) \row-end)
          v
        )
        (~ (seq (: v \style-sheet-extension-block) \row-end)
          v
        )
        (~ (seq (: v \style-sheet-block) \row-end)
          v
        )
        (~ (seq (: v \class-block) \row-end)
          v
        )
        (~ (seq (: v \function-block) \row-end)
          v
        )
      )
    )
    (blank)
    (lazy header-row (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: v \class-header-declaration) \row-end)
          v
        )
        (~ (seq (: v \argument) \row-end)
          v
        )
      )
    )
    (blank)
    (lazy row-end
      (pattern
        (~ (seq / (* \nl) (! .)))
      )
    )
    (blank)
    (lazy row-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ \block)
        (~ \unwritten-block)
      )
    )
    (blank)
    (lazy unwritten-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (& (\{} (!= entry (. UBrixEntry whole-file)))) (& \row-end))
          (call (. bx form) location "block")
        )
      )
    )
    (blank)
    (lazy open
      (pattern
        (~ "{")
        (~ "≤")
      )
    )
    (blank)
    (lazy open-string
      (pattern
        (~ "Æ")
      )
    )
    (blank)
    (lazy open-header
      (pattern
        (~ "═")
      )
    )
    (blank)
    (lazy close
      (pattern
        (~ "}")
        (~ "≥")
      )
    )
    (blank)
    (lazy statements (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (* \nl) (: lines (* \statement-line)) / (? \nl))
          (call (. bx some) lines)
        )
      )
    )
    (blank)
    (lazy statement-line (? (of ImmutableTableRow SourceNode))
      (pattern
        (~ (seq / (: s \statement) / (| \nl (& \close)))
          s
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy block (of ImmutableTableRow SourceNode)
      (pattern
        (~ \indented-block-expression)
        (~ \inline-block-expression)
      )
    )
    (blank)
    (lazy indented-block-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open (: s \statements) / \close)
          (call (. bx form) location "block" s)
        )
      )
    )
    (blank)
    (lazy inline-block-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq ":" / (: expr \print-block))
          (call (. bx form) location "inline" expr)
        )
        (~ (seq ":" / (: expr \multi-line-expression))
          (call (. bx form) location "inline" expr)
        )
      )
    )
    (blank)
    (lazy block-statements (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (* \nl) (: lines (+ \statement-line)) / (? \nl))
          (call (. bx some) lines)
        )
      )
    )
    (blank)
    (lazy block-or-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // (: expr \multi-line-expression))
          expr
        )
        (~ (seq / (: blk \row-block))
          blk
        )
      )
    )
    (blank)
    (lazy block-or-expression-no-prep (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // (: expr \multi-line-expression-no-prep))
          expr
        )
        (~ (seq / (: blk \row-block))
          blk
        )
      )
    )
    (blank)
    (lazy block-or-inline-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // (: expr \print-block))
          expr
        )
        (~ (seq // (: expr \inline-expression))
          expr
        )
        (~ (seq / (: blk \row-block))
          blk
        )
      )
    )
    (blank)
    (lazy statement (of ImmutableTableRow SourceNode)
      (pattern
        (~ \import-statement)
        (~ \string-block)
        (~ \header-block)
        (~ \extension-block)
        (~ \style-sheet-extension-block)
        (~ \style-sheet-block)
        (~ \effect-declaration)
        (~ \class-block)
        (~ \function-block)
        (~ \state-machine-declaration)
        (~ \property-declaration)
        (~ \unit-declaration)
        (~ \if-block)
        (~ \while-block)
        (~ \style-when-statement)
        (~ \for-block)
        (~ \do-block)
        (~ \return-statement)
        (~ \pipeline-statement)
        (~ \feed-statement)
        (~ \pattern-helper-clause)
        (~ \call-argument-line)
        (~ \declaration)
        (~ \assertion)
        (~ \probe)
        (~ \state-case)
        (~ \attached-catch)
        (~ \print-block)
        (~ \multi-line-expression)
        (~ \noop)
        (~ \return-statement-final)
      )
    )
    (blank)
    (lazy state-machine-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open (: statements \state-machine-statements) / \close)
          (call (. bx form) location "machine" statements)
        )
      )
    )
    (blank)
    (lazy machine-row-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ \state-machine-block)
        (~ (seq (& (\{} (!= entry (. UBrixEntry whole-file)))) (& \row-end))
          (call (. bx form) location "machine")
        )
      )
    )
    (blank)
    (lazy state-machine-statements (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (* \nl) (: head \state-machine-first-line) (: tail (* \state-machine-line)) / (? \nl))
          (call (. bx seq) head (call (. bx some) tail))
        )
      )
    )
    (blank)
    (lazy state-machine-first-line (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq / (: statement \state-case) / (| \nl (& \close)))
          statement
        )
      )
    )
    (blank)
    (lazy state-machine-line (? (of ImmutableTableRow SourceNode))
      (pattern
        (~ (seq / (: statement \state-machine-item) / (| \nl (& \close)))
          statement
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy state-machine-item (of ImmutableTableRow SourceNode)
      (pattern
        (~ \state-case)
        (~ \state-fallback)
      )
    )
    (blank)
    (lazy state-body-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open (: statements \state-body-statements) / \close)
          statements
        )
      )
    )
    (blank)
    (lazy state-body-statements (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (* \nl) (: lines (+ \state-body-line)) / (? \nl))
          (call (. bx some) lines)
        )
      )
    )
    (blank)
    (lazy state-body-line (? (of ImmutableTableRow SourceNode))
      (pattern
        (~ (seq / (: statement \state-body-statement) / (| \nl (& \close)))
          statement
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy state-body-statement (of ImmutableTableRow SourceNode)
      (pattern
        (~ \state-case)
        (~ \state-continuation)
        (~ \state-fallback)
        (~ \statement)
      )
    )
    (blank)
    (lazy state-case (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "◊" // (: n \name) (: values (? \state-target-values)) (: trigger (? \state-trigger)) (: body (? \state-body-block)))
          (call (. bx form) location "state" (call (. bx invoke) location (call (. bx atom) location n) values) trigger body)
        )
      )
    )
    (blank)
    (lazy state-continuation (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "then" // (: n \name) (: values (? \state-target-values)) (: trigger (? \state-trigger)) (: body (? \state-body-block)))
          (call (. bx form) location "then" (call (. bx invoke) location (call (. bx atom) location n) values) trigger body)
        )
      )
    )
    (blank)
    (lazy state-fallback (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "??" // (: n \name) (: values (? \state-target-values)))
          (call (. bx form) location "else-state" (call (. bx invoke) location (call (. bx atom) location n) values))
        )
      )
    )
    (blank)
    (lazy state-target-values (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "(" / (: values (? (call \delimited "," (~ \inline-expression-no-comma)))) / ")")
          (call (. bx many) values)
        )
      )
    )
    (blank)
    (lazy state-trigger (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "whenever" // (: watched \bulleted-expression))
          (call (. bx form) location "trigger" (call (. bx atom) location "whenever") watched)
        )
        (~ (seq // "for" // (: pattern \structure-pattern) // "on" // (: stream \bulleted-expression) (: guard (? \state-when-guard)))
          (call (. bx form) location "trigger" (call (. bx atom) location "for") pattern stream guard)
        )
        (~ (seq // "when" // (: guard \state-guard-expression) // "on" // (: stream \bulleted-expression))
          (call (. bx form) location "trigger" (call (. bx atom) location "when-on") guard stream)
        )
        (~ (seq // "on" // (: stream \bulleted-expression) (: guard (? \state-when-guard)))
          (call (. bx form) location "trigger" (call (. bx atom) location "on") stream guard)
        )
        (~ (seq // "if" // (: pattern \structure-match) // "=" // (: subject \bulleted-expression))
          (call (. bx form) location "trigger" (call (. bx atom) location "if-match") pattern subject)
        )
        (~ (seq // "if" // (: condition \bulleted-expression))
          (call (. bx form) location "trigger" (call (. bx atom) location "if") condition)
        )
        (~ (seq // "when" // (: stream \bulleted-expression))
          (call (. bx form) location "trigger" (call (. bx atom) location "when") stream)
        )
      )
    )
    (blank)
    (lazy state-when-guard (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "when" // (: guard \state-guard-expression))
          guard
        )
      )
    )
    (blank)
    (lazy state-guard-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ \apply-expression)
      )
    )
    (blank)
    (lazy multi-line-expression (of ImmutableTableRow SourceNode)
      (pattern
        (~ \block-construct)
        (~ \call-block)
      )
    )
    (blank)
    (lazy multi-line-expression-no-prep (of ImmutableTableRow SourceNode)
      (pattern
        (~ \block-construct)
        (~ \inline-expression-no-prep)
      )
    )
    (blank)
    (lazy block-construct (of ImmutableTableRow SourceNode)
      (pattern
        (~ \task-block)
        (~ \match-block)
        (~ \iterator-block)
        (~ \structure-match-block)
        (~ \stream-match-block)
        (~ \for-block)
        (~ \use-block)
        (~ \closure-block)
        (~ \latest-block)
        (~ \slot-outlet)
        (~ \markup)
      )
    )
    (blank)
    (lazy extension-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open \nl (: acc \access) // "extend" // (: receiver \type) (: as-types (? \extension-as)) (: constraints (? \extension-where)) (: body (? \class-body)) / (* \nl) / \close)
          (call (. bx form) location "extend" (call (. bx atom) location acc) receiver as-types constraints body)
        )
        (~ (seq (: acc \access) // "extend" // (: receiver \type) (: as-types (? \extension-as)) (: constraints (? \extension-where)))
          (call (. bx form) location "extend-line" (call (. bx atom) location acc) receiver as-types constraints)
        )
      )
    )
    (blank)
    (lazy extension-as (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "as" // (: types (call \delimited "," (~ \type))))
          (call (. bx form) location "as" (call (. bx many) types))
        )
      )
    )
    (blank)
    (lazy extension-where (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "where" // (: constraints (call \delimited "," (~ \type-constraint-declaration))))
          (call (. bx form) location "where" (call (. bx many) constraints))
        )
      )
    )
    (blank)
    (lazy style-sheet-extension-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open \nl "•" // "extend" // (: receiver \type) (: header (? \class-header-block)) (: body (? \class-body)) / (* \nl) / \close)
          (call (. bx form) location "style-extend" receiver header body)
        )
      )
    )
    (blank)
    (lazy style-sheet-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open \nl "•" // (: id \type-name) (: derived (? \sheet-derivation)) (: header (? \class-header-block)) (: body (? \class-body)) / (* \nl) / \close)
          (call (. bx form) location "style" (call (. bx atom) location id) derived header body)
        )
      )
    )
    (blank)
    (lazy sheet-derivation (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "is" // (: base \type) (: tags (? \sheet-tags)))
          (call (. bx seq)
            (block
              (arg (call (. bx form) location "is" base))
              (arg tags)
            )
          )
        )
      )
    )
    (blank)
    (lazy sheet-tags (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "for" // (: tags (call \delimited "," (~ \sheet-tag))))
          (call (. bx form) location "for" (call (. bx many) tags))
        )
      )
    )
    (blank)
    (lazy sheet-tag (of ImmutableTableRow SourceNode)
      (pattern
        (~ (: n \name)
          (call (. bx atom) location n)
        )
      )
    )
    (blank)
    (lazy class-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open \nl (: header \class-line) (: body (? \class-body)) / (* \nl) / \close)
          (call (. bx form) location "type" header body)
        )
        (~ (: header \class-line)
          (call (. bx form) location "type-line" header)
        )
      )
    )
    (blank)
    (lazy class-line (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: acc \access) // (: id \type-name) (: type-args (* \type-argument)) (: aliases (? \class-aliases)) (: owner (? \class-facet-of)) (: inherits (? \class-inherits)) (: header (? \class-header-block)))
          (call (. bx seq)
            (block
              (arg (call (. bx atom) location acc))
              (arg (call (. bx applied) location (call (. bx atom) location id) (call (. bx many) type-args)))
              (arg aliases)
              (arg owner)
              (arg inherits)
              (arg header)
            )
          )
        )
      )
    )
    (blank)
    (lazy class-aliases (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "(" / (: aliases \alias-list) / ")")
          (call (. bx form) location "alias" aliases)
        )
      )
    )
    (blank)
    (lazy alias-list (of ImmutableTableRow SourceNode)
      (pattern
        (~ (: names (call \delimited "," (~ \alias)))
          (call (. bx many) names)
        )
      )
    )
    (blank)
    (lazy alias (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: n \name) (! (chars "a-zA-Z0-9")))
          (call (. bx atom) location n)
        )
        (~ (: n \type-name)
          (call (. bx atom) location n)
        )
        (~ (: n \unit)
          (call (. bx atom) location n)
        )
      )
    )
    (blank)
    (lazy class-facet-of (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "is" // "facet" // "of" // (: owner \type))
          (call (. bx form) location "facet-of" owner)
        )
      )
    )
    (blank)
    (lazy class-inherits (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq // "is" // (: types \class-or-list))
          (call (. bx form) location "is" types)
        )
      )
    )
    (blank)
    (lazy class-or-list (of ImmutableTableRow SourceNode)
      (pattern
        (~ (: bases (call \delimited "||" (~ \class-base)))
          (call (. bx many) bases)
        )
      )
    )
    (blank)
    (lazy class-base-list (of ImmutableTableRow SourceNode)
      (pattern
        (~ (: bases (call \delimited "," (~ \class-base)))
          (call (. bx many) bases)
        )
      )
    )
    (blank)
    (lazy class-base (of ImmutableTableRow SourceNode)
      (pattern
        (~ \class-tuple-base)
        (~ \type)
        (~ \numeric-literal)
      )
    )
    (blank)
    (lazy class-tuple-base (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "(" / (: id \identifier) // (: ty \type) / ")")
          (call (. bx form) location "tuple" (call (. bx form) location ":" id ty))
        )
      )
    )
    (blank)
    (lazy class-header-block (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq \open (: lines \class-header-lines) / \close)
          lines
        )
      )
    )
    (blank)
    (lazy class-header-lines (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (* \nl) (: head \class-header-declaration-line) (: tail (* \class-header-line)) / (* \nl))
          (call (. bx seq) head (call (. bx some) tail))
        )
      )
    )
    (blank)
    (lazy class-header-declaration-line (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq / (: arg \class-header-declaration) / (| \nl (& \close)))
          arg
        )
      )
    )
    (blank)
    (lazy class-header-line (? (of ImmutableTableRow SourceNode))
      (pattern
        (~ (seq / (: arg \class-header-declaration) / (| \nl (& \close)))
          arg
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy class-header-declaration (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq "-" // (: arg \type-constraint-declaration))
          arg
        )
        (~ (seq "is" // (: t \type))
          (call (. bx form) location "implements" t)
        )
        (~ (seq "using" // (: t \type))
          (call (. bx form) location "using" t)
        )
        (~ (seq "sees" // (: t \type))
          (call (. bx form) location "sees" t)
        )
      )
    )
    (blank)
    (lazy class-body (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq / (+ \nl) (: items \members))
          items
        )
      )
    )
    (blank)
    (lazy member (of ImmutableTableRow SourceNode)
      (pattern
        (~ \event-declaration)
        (~ \property-declaration)
        (~ \enum-declaration)
        (~ \implements-declaration)
        (~ \style-annotation-declaration)
        (~ \dependency-declaration)
        (~ \function-block)
        (~ \content-block)
      )
    )
    (blank)
    (lazy event-declaration (of ImmutableTableRow SourceNode)
      (pattern
        (~ (seq (: acc \access) // "event" // (: name \name) // (: ty \type) (? (seq // "keyed" // "by" // (: keyed \type))))
