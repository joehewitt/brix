    (param parent (of ImmutableTableRow SourceNode))
    (param children (list (of ImmutableTableRow SourceNode)))
    (let current parent)
    (let refused (list Index))
    (let index Index 0)
    (while (< index (. children length))
      (if (not (call accepts current 0 ([] children index)))
        (+= refused index)
        (+= index 1)
        (continue)
      )
      (let holder (call holder-of current))
      (let owner arm-owner)
      (let armed (call arm-holder current holder ([] children index)))
      (if (call is-armed armed ([] children index))
        (= current
          (scope (?? (call (. store swapped) current armed (call armed-joined armed holder child)) current)
            (lazy child (call task-arm ([] children index)))
          )
        )
        (+= index 1)
        (continue)
      )
      (let signature (call signature-of current))
      (let is-line (and (!= signature null) (call is-header-line ([] children index))))
      (let target (if-expr is-line (?? signature holder) holder))
      (if (not target)
        (let is-scope (call all ([] children (... index)) (:where (call ubrix-is-scope-row store each))))
        (let grown (call wrapped current ([] children index) is-scope))
        (if grown
