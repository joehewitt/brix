        (+= index 1)
        (continue)
      )
      (let run (list (of ImmutableTableRow SourceNode)))
      (while (and (< index (. children length)) (not (call is-armed armed ([] children index))))
        (if (!= (and (!= signature null) (call is-header-line ([] children index))) is-line)
          (break)
        )
        (if (not (call accepts current (. run length) ([] children index)))
          (break)
        )
        (+= run (call settled current ([] children index)))
        (+= index 1)
      )
      (let grown
        (block
          (case? (and (!= owner null) (== (. target index) (. owner index)))
            (call (. store appended) target (call blocked run))
          )
          (default
            (call (. store extended) target run)
