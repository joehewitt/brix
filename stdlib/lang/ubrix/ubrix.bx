(import ./build)
(import ./grammar)
(import ./layout)
(import ./parse)
(import ./trivia)
(import ./ubrix-names)
(import ./ubrix-print)
(import ./ubrix-syntax)
(import /code/structure/document)
(import /code/structure/language)
(import /code/structure/rows)
(import /core/table)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(import /stream/aggregate)
(blank)
(prop + ubrix-mode-head SourceRowMode (= 1))
(prop + ubrix-mode-parameter SourceRowMode (= 2))
(prop + ubrix-mode-statement SourceRowMode (= 3))
(prop + ubrix-mode-function SourceRowMode (= 4))
(prop + ubrix-mode-type SourceRowMode (= 5))
(prop + ubrix-mode-member SourceRowMode (= 6))
(prop + ubrix-mode-separator SourceRowMode (= 7))
(prop + ubrix-mode-tail SourceRowMode (= 8))
(prop + ubrix-mode-note SourceRowMode (= 9))
(prop + ubrix-mode-main SourceRowMode (= 10))
(prop + ubrix-mode-text SourceRowMode (= 11))
(prop + ubrix-mode-titled SourceRowMode (= 12))
(prop + ubrix-mode-method SourceRowMode (= 13))
(prop + ubrix-mode-state SourceRowMode (= 14))
(prop + ubrix-mode-style SourceRowMode (= 15))
(prop + ubrix-mode-rule SourceRowMode (= 16))
(prop + ubrix-mode-styled SourceRowMode (= 17))
(prop + ubrix-mode-unparsed SourceRowMode (= 18))
(prop + ubrix-mode-keyframe SourceRowMode (= 19))
(prop + ubrix-mode-argument SourceRowMode (= 20))
(prop + ubrix-unparsed-head _ (= "unparsed"))
(blank)
(prop _ ubrix-thick-divider _ (= "━━━━━━━━━━━━━━━━━━━━"))
(prop _ ubrix-thin-divider _ (= "────────────────────"))
(prop _ ubrix-ruler _ (= "════════════════════"))
(prop _ ubrix-lazy-mark _ (= ".. "))
(prop _ ubrix-main-head _ (= ""))
(prop _ ubrix-section-head _ (= "━"))
(prop _ ubrix-part-statement U8 (= 1))
(prop _ ubrix-part-method U8 (= 2))
(prop _ ubrix-part-content U8 (= 3))
(prop _ ubrix-part-note U8 (= 4))
(prop _ ubrix-part-machine U8 (= 5))
(prop _ ubrix-part-scans Size (= 128))
(prop _ ubrix-read-repairs Size (= 32))
(prop _ ubrix-repair-mark _ (= "brix-unread-"))

(type + UBrixLanguage
  (implements SourceLanguage)
  (prop + store SourceStore)
  (blank)
  (prop _ printer UBrixPrinter)
  (prop _ layout UBrixLayout)
  (prop _ names UBrixNames)
  (prop _ held-start Size)
  (prop _ arm-owner (? (of ImmutableTableRow SourceNode)))
  (prop _ spare (? (of ImmutableTableRow SourceNode)))
  (fn-do + This _
    (lazy store (call SourceStore))
    (lazy printer (call UBrixPrinter store))
    (lazy layout (call UBrixLayout store))
    (lazy names (call UBrixNames store))
  )
  (fn-expr + comment-marker String :get
    "` "
  )
  (fn-expr + divider-line U8
    (param text String)
    (case? (and (> (. trimmed length) 0) (== trimmed (* "━" (. trimmed length))))
      source-divider-thick
    )
    (case? (and (> (. trimmed length) 0) (== trimmed (* "─" (. trimmed length))))
      source-divider-thin
    )
    (default
      0
    )
    (where
      (lazy trimmed (call ubrix-trimmed text))
    )
  )
  (fn-do + outline SourceOutline
    (param declaration (of ImmutableTableRow SourceNode))
    (param previous (? SourceOutline))
    (let build (call UBrixOutlineBuild (as (. declaration index) U32) previous))
    (let result (. build rows))
    (if (or (call is-main declaration) (call (. store is-form) declaration "content"))
      (let items (call (. store items) declaration))
      (let is-content (call (. store is-form) declaration "content"))
      (let zone (if-expr is-content (. SourceRowZone body) (. SourceRowZone loose)))
      (if (not (call (. store is-form) declaration ubrix-main-head))
        (+= result
          (call ubrix-divider-row
            (block
              (arg source-divider-thick)
              (arg declaration)
              (arg (if-expr is-content .leaf .none))
            )
          )
        )
        (+= result (call ubrix-lead declaration (and is-content (> (. items length) 1))))
      )
      (for (in index (..< 1 (. items length)))
        (call part build ([] items index) ubrix-part-statement ubrix-mode-main declaration zone)
      )
      (+= result (if-expr is-content (call ubrix-gap ubrix-mode-tail declaration) (call ubrix-blank-line ubrix-mode-tail declaration)))
      (else-if (call is-function declaration)
        (call function-rows declaration source-divider-thick result build)
      )
      (else-if (call is-type declaration)
        (call type-rows declaration build)
      )
      (else-if (call (. store is-form) declaration ubrix-unparsed-head)
        (for (in line (call (. store listed) declaration 1))
          (+= result
            (call SourceOutlineRow
              (block
                (arg (as (. line index) U32))
                (arg ubrix-mode-unparsed)
                (arg 0)
                (arg true)
                (arg 0)
                (arg (as (. declaration index) U32))
                (arg false)
                (arg (. SourceRowZone loose))
              )
            )
          )
        )
      )
      (else
        (call statement-rows declaration 0 declaration ubrix-mode-note (. SourceRowZone loose) result)
      )
    )
    (return (call SourceOutline (. build place) (call ubrix-spaced result) result (. build parts) (. build reused)))
  )
  (fn-expr + render SourceRow
    (param row SourceOutlineRow)
    (call SourceRow
      (block
        (arg (. row node))
        (arg (. row mode))
        (arg (. row indent))
        (arg spans)
        (arg (. row is-invalid))
        (arg (. row divider))
        (arg (. row owner))
        (arg (call (. store id-at) (. row node)))
        (arg (call (. store id-at) (. row owner)))
        (arg (. row zone))
        (arg (. row block))
        (arg (== (. row mode) ubrix-mode-text))
        (arg (. row is-padding))
        (arg (. row is-private))
        (arg (. row is-open-end))
      )
    )
    (where
      (lazy spans (call spans-of row (call (. store node-at) (. row node))))
    )
  )
  (fn-do + marked-row (? UBrixMarked)
    (param row SourceOutlineRow)
    (param trail (list U32))
    (let node (call (. store node-at) (. row node)))
    (return-if null (if (or (not node) (. row is-divider) (== (. row mode) ubrix-mode-unparsed))))
    (blank)
    (= (. printer targets) trail)
    (let text (call printed row node))
    (let found (> (. printer target-end) (. printer target-start)))
    (let marked
      (call UBrixMarked
        (block
          (arg text)
          (arg (if-expr found (. printer target-start) 0))
          (arg (if-expr found (. printer target-end) (. text length)))
        )
      )
    )
    (= (. printer targets) (call (of List U32)))
    (return marked)
  )
  (fn-expr _ printed String
    (param row SourceOutlineRow)
    (param node (of ImmutableTableRow SourceNode))
    (case? (call ubrix-is-head-mode (. row mode))
      (call (. printer heading) node)
    )
    (case? (== (. row mode) ubrix-mode-text)
      (call (. printer line) node)
    )
    (case? (== (. row mode) ubrix-mode-argument)
      (call (. printer argument) node)
    )
    (default
      (call (. printer row) node)
    )
  )
  (fn-expr + mode-name String
    (param mode SourceRowMode)
    (match mode
      (case= ubrix-mode-head
        "head"
      )
      (case= ubrix-mode-parameter
        "parameter"
      )
      (case= ubrix-mode-statement
        "statement"
      )
      (case= ubrix-mode-function
        "function"
      )
      (case= ubrix-mode-type
        "type"
      )
      (case= ubrix-mode-member
        "member"
      )
      (case= ubrix-mode-note
        "note"
      )
      (case= ubrix-mode-main
        "main"
      )
      (case= ubrix-mode-text
        "text"
      )
      (case= ubrix-mode-titled
        "titled"
      )
      (case= ubrix-mode-method
        "method"
      )
      (case= ubrix-mode-state
        "state"
      )
      (case= ubrix-mode-style
        "style"
      )
      (case= ubrix-mode-rule
        "rule"
      )
      (case= ubrix-mode-styled
        "styled"
      )
      (case= ubrix-mode-unparsed
        "unparsed"
      )
      (case= ubrix-mode-keyframe
        "keyframe"
      )
      (case= ubrix-mode-argument
        "argument"
      )
      (default
        "decoration"
      )
    )
  )
  (fn-expr + is-editable Bool
    (param mode SourceRowMode)
    (and (!= mode source-row-decoration) (!= mode ubrix-mode-separator) (!= mode ubrix-mode-tail))
  )
  (fn-expr + is-flow Bool
    (param mode SourceRowMode)
    (or is-code is-prose is-nested)
    (where
      (lazy is-code (or (== mode ubrix-mode-statement) (== mode ubrix-mode-member) (== mode ubrix-mode-main)))
      (lazy is-prose (or (== mode ubrix-mode-titled) (== mode ubrix-mode-text)))
      (lazy is-nested
        (scope (or is-styling (== mode ubrix-mode-state))
          (lazy is-styling
            (scope (or (== mode ubrix-mode-style) (== mode ubrix-mode-rule) (== mode ubrix-mode-styled) is-keyframe)
              (lazy is-keyframe (== mode ubrix-mode-keyframe))
            )
          )
        )
      )
    )
  )
  (fn-expr + highlight (list SourceSpan)
    (param text String)
    (param mode SourceRowMode)
    (case? (call ubrix-is-head-mode mode)
      (call ubrix-highlight-head text)
    )
    (case? (== mode ubrix-mode-text)
      (call ubrix-highlight-line text)
    )
    (case? (and (== mode ubrix-mode-main) (call ubrix-is-import (if-expr (call (. text starts-with) "+ ") ([] text (... 2)) text)))
      (call ubrix-import-spans text)
    )
    (default
      (call ubrix-highlight text)
    )
  )
  (fn-do + parse (? (of ImmutableTableRow SourceNode))
    (param text String)
    (param mode SourceRowMode)
    (return-if (call parse-head text mode) (if (call ubrix-is-head-mode mode)))
    (return-if (call parse-line text) (if (== mode ubrix-mode-parameter)))
    (return-if (call ubrix-parse-text text store) (if (== mode ubrix-mode-text)))
    (return-if null (if (or (== mode ubrix-mode-separator) (== mode ubrix-mode-tail) (== mode source-row-decoration))))
    (return-if null (if (== mode ubrix-mode-unparsed)))
    (blank)
    (let parsed (call opening (call ubrix-parse-statement text store (call ubrix-scope mode)) text))
    (if (and (== mode ubrix-mode-argument) parsed (call (. store is-form) parsed "arg") (== (call (. store count) parsed) 2))
      (return (call (. store item) parsed 1))
    )
    (return-if null (if (and parsed (call (. store is-form) parsed "import") (!= mode ubrix-mode-main))))
    (return-if (call member-line text) (if (and (not parsed) (== mode ubrix-mode-member))))
    (return-if parsed (if (or is-untitled (not parsed) (call (. store is-blank) parsed) (call (. store is-comment) parsed))))
    (blank)
    (lazy is-untitled (!= mode ubrix-mode-titled))
    (return (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "header") parsed)))
  )
  (fn-do + read (list (of ImmutableTableRow SourceNode))
    (param text String)
    (return (call ubrix-read this text))
  )
  (fn-expr + is-unparsed Bool
    (param mode SourceRowMode)
    (== mode ubrix-mode-unparsed)
  )
  (fn-expr + is-invalid Bool
    (param node (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (or (!= (call (. store raw-text) node) null) is-raw-head is-raw-line)
    (where
      (lazy is-raw-head (and (call ubrix-is-head-mode mode) (call has-raw-head node)))
      (lazy is-raw-line (and (== mode ubrix-mode-parameter) (call has-raw-line node)))
    )
  )
  (fn-do + rereads Bool
    (param node (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (param text String)
    (return-if false (if (or (not (call ubrix-is-head-mode mode)) (not (call is-function node)))))
    (blank)
    (let parsed (call ubrix-parse-declaration text store))
    (return-if false (if (or (not parsed) (not (call is-function parsed)))))
    (return (!= (call is-text parsed) (call is-text node)))
  )
  (fn-do + lead-for (? String)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (param text String)
    (let mode (. row mode))
    (return-if null (if (> (. row indent) 0)))
    (blank)
    (let in-type (call is-type declaration))
    (let thick (str ubrix-thick-divider "\n"))
    (let thin (str ubrix-thin-divider "\n"))
    (if (call ubrix-is-head-mode mode)
      (let node (call (. store node-at) (. row node)))
      (return-if null (if (or (not in-type) (not node) (not (call has-raw-head node)))))
      (blank)
      (let parsed (call ubrix-parse-statement text store (call ubrix-scope ubrix-mode-statement)))
      (return (only-if "\n" (if (and parsed (call (. store is-form) parsed "<>")))))
    )
    (return-if null (if (and (!= mode ubrix-mode-statement) (!= mode ubrix-mode-main) (!= mode ubrix-mode-member))))
    (return-if thin (if (and in-type (has (list "+ This" "_ This") (call ubrix-trimmed text)))))
    (blank)
    (let parsed (call parse text mode))
    (if (and parsed (not (call is-invalid parsed mode)))
      (let form (?? (call (. store head) parsed) ""))
      (let is-member (and in-type (== mode ubrix-mode-member)))
      (return-if (str thin "\n") (if (and is-member (== form "<>"))))
      (return-if thin (if (and is-member (== form "for"))))
      (return-if thick (if (or (== form "type-line") (== form "extend-line"))))
      (return null)
    )
    (let head (call ubrix-parse-declaration text store))
    (return-if null (if (not head)))
    (return-if thick (if (call is-type head)))
    (return-if null (if (not (call is-function head))))
    (return-if thin (if in-type))
    (return (only-if thick (if (call ubrix-is-callable (?? (call (. store head) head) "")))))
  )
  (fn-do + open-below (? SourceOpened)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let owner (call current declaration row))
    (return-if null (if (not owner)))
    (blank)
    (let mode (. row mode))
    (if (== (. row divider) source-divider-thin)
      (let added (call raw-head "fn-expr" "+ "))
      (let slot (call item-index declaration (. owner id)))
      (return (call SourceOpened (call (. store inserted) declaration slot added) (. added id)))
    )
    (return-if null (if (. row is-divider)))
    (blank)
    (let is-head (call ubrix-is-head-mode mode))
    (let is-edge (or (== mode ubrix-mode-separator) (== mode ubrix-mode-tail)))
    (if (or (call is-main owner) (call (. store is-form) owner "content"))
      (return-if null (if (not is-edge)))
      (return (call opened declaration owner (== mode ubrix-mode-tail) 1))
    )
    (return-if null (if (and (not (call is-function owner)) (not (call is-type owner)))))
    (blank)
    (let text (call paragraph-of owner))
    (return-if (call opened declaration text false 1) (if (and (!= text null) (== mode ubrix-mode-separator))))
    (blank)
    (if (and (call takes-lines owner) (or is-head (== mode ubrix-mode-parameter)))
      (return (call line-opened declaration owner row))
    )
    (let is-leading (or is-head (== mode ubrix-mode-separator) (== mode ubrix-mode-parameter)))
    (case? is-leading
      (return (call opened declaration owner false (call body-start owner)))
    )
    (case? (!= mode ubrix-mode-tail)
      (return null)
    )
    (case? (call is-type owner)
      (return (call opened declaration owner false (call member-start owner)))
    )
    (default
      (return (call opened declaration owner true 0))
    )
  )
  (fn-do + open-end (? SourceOpened)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let owner (call current declaration row))
    (return-if null (if (not owner)))
    (return-if (call lazy-opened declaration owner) (if (not (call is-type owner))))
    (blank)
    (let is-style (or (call (. store is-form) declaration "style") (call (. store is-form) declaration "style-extend")))
    (return-if (call opened declaration declaration true 0) (if is-style))
    (blank)
    (let added (call raw-head "fn-expr" "+ "))
    (return (call SourceOpened (call (. store appended) declaration added) (. added id)))
  )
  (fn-do + close-row SourceClosed
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let node (call (. store node-at) (. row node)))
    (return-if (. SourceClosed kept) (if (or (not node) (== (. row owner) null))))
    (blank)
    (let is-empty-note
      (scope (and is-note (or (call (. store is-blank) node) (== (call (. store comment-text) node) "")))
        (lazy is-note (== (. row mode) ubrix-mode-note))
      )
    )
    (return-if (. SourceClosed declaration) (if is-empty-note))
    (return (call leave-row declaration row))
  )
  (fn-do + leave-row SourceClosed
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let node (call (. store node-at) (. row node)))
    (return-if (. SourceClosed kept) (if (or (not node) (== (. row owner) null))))
    (blank)
    (let dropped (call drop-row declaration row))
    (return-if (call (. SourceClosed row) dropped) (if dropped))
    (return-if (. SourceClosed kept) (if (not (call ubrix-is-head-mode (. row mode)))))
    (blank)
    (let is-written (or (not (call is-unwritten node "+")) (> (call (. store count) node) (call (. printer header-count) node))))
    (return-if (. SourceClosed kept) (if is-written))
    (return-if (. SourceClosed declaration) (if (== (. node id) (. declaration id))))
    (return (call (. SourceClosed row) (call (. store without) declaration (call item-index declaration (. node id)))))
  )
  (fn-do + drop-row (? (of ImmutableTableRow SourceNode))
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let node (call (. store node-at) (. row node)))
    (return-if null (if (not node)))
    (return-if (call lazy-dropped declaration row node) (if (or (call is-unwritten-lazy node) (call (. store is-blank) node))))
    (return-if null (if (or (!= (. row mode) ubrix-mode-parameter) (not (call is-unwritten node "-")))))
    (return (call (. store removed) declaration (. row node-id)))
  )
  (fn-do _ lazy-opened (? SourceOpened)
    (param declaration (of ImmutableTableRow SourceNode))
    (param owner (of ImmutableTableRow SourceNode))
    (return-if null (if (== (call paragraph-of owner) null)))
    (blank)
    (let added (call (. store raw) ubrix-lazy-mark (call (of List (of ImmutableTableRow SourceNode)))))
    (let section (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "where") added)))
    (return (call placed declaration owner (call (. store appended) owner section) (. added id)))
  )
  (fn-do _ lazy-dropped (? (of ImmutableTableRow SourceNode))
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (param node (of ImmutableTableRow SourceNode))
    (let owner (call current declaration row))
    (return-if null (if (or (not owner) (not (call is-function owner)))))
    (blank)
    (let items (call (. store listed) owner))
    (return-if null (if (== (. items length) 0)))
    (blank)
    (let section ([] items (- (. items length) 1)))
    (if (call (. store is-form) section "where")
      (return-if null (if (== (call (. store find) section (. node id)) null)))
      (blank)
      (if (call all (call (. store listed) section 1) (:where (call is-leftover each)))
        (return (call (. store removed) declaration (. section id)))
      )
      (return-if null (if (call (. store is-blank) node)))
      (return (call (. store removed) declaration (. node id)))
    )
    (let start (. items length))
    (let is-held false)
    (while (and (> start 0) (call is-leftover ([] items (- start 1))))
      (-= start 1)
      (= is-held (or is-held (== (. ([] items start) id) (. node id))))
    )
    (return-if null (if (or (not is-held) (== start 0) (not (call (. store is-form) ([] items (- start 1)) "paragraph")))))
    (return (call (. store swapped) declaration owner (call (. store trimmed) owner start)))
  )
  (fn-expr _ is-leftover Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (call (. store is-blank) node) (call is-unwritten-lazy node))
  )
  (fn-expr _ is-unwritten-lazy Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (!= raw null) (or (== (. text length) 0) (== text (call ubrix-trimmed ubrix-lazy-mark))))
    (where
      (lazy raw (call (. store raw-text) node))
      (lazy text (call ubrix-trimmed (?? raw "")))
    )
  )
  (fn-do + adopt (? (of ImmutableTableRow SourceNode))
    (param upper (of ImmutableTableRow SourceNode))
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (return-if null (if (or (not (call is-type upper)) (not (call is-function declaration)))))
    (blank)
    (let is-head (and (!= (. row node) null) (== (. row node-id) (. declaration id))))
    (return-if null (if (and (!= (. row divider) source-divider-thick) (not is-head))))
    (return (call (. store appended) upper declaration))
  )
  (fn-do + release (? SourceReleased)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (let owner (call current declaration row))
    (return-if null (if (or (not owner) (== (. owner id) (. declaration id)))))
    (return-if null (if (or (not (call is-type declaration)) (not (call is-function owner)))))
    (blank)
    (let is-head (and (!= (. row node) null) (== (. row node-id) (. owner id))))
    (return-if null (if (and (!= (. row divider) source-divider-thin) (not is-head))))
    (blank)
    (let slot (call item-index declaration (. owner id)))
    (return-if null (if (>= slot (call (. store count) declaration))))
    (return (call SourceReleased (call (. store without) declaration slot) (call (. store item) declaration slot)))
  )
  (fn-do + children (list (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (let held (list (of ImmutableTableRow SourceNode)))
    (let signature (call signature-of node))
    (if signature
      (let lines (call (. store items) signature))
      (for (in index (..< 0 (. lines length)))
        (if (call is-header-line ([] lines index))
          (+= held ([] lines index))
        )
      )
    )
    (let holder (call holder-of node))
    (return-if held (if (not holder)))
    (blank)
    (let start held-start)
    (let armed arm-owner)
    (if armed
      (for (in item (call (. store listed) armed 1))
        (if (== (. item index) (. holder index))
          (++= held (call (. store listed) holder start))
          (else-if (call is-armed armed item)
            (+= held item)
          )
        )
      )
      (return held)
    )
    (++= held (call (. store listed) holder start))
    (return held)
  )
  (fn-do + detach (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (let bare (call unsigned node))
    (let holder (call holder-of bare))
    (return-if bare (if (not holder)))
    (blank)
    (if (and (call (. store is-form) holder "machine") (call (. store is-form) bare "prop"))
      (let count (call (. store count) bare))
      (return-if (call (. store trimmed) bare (- count 1)) (if (call (. store is-form) (call (. store item) bare (- count 1)) "machine")))
    )
    (let armed arm-owner)
    (let next bare)
    (let is-bare (and (call (. store is-form) holder "block") (not (call ubrix-is-scope store holder))))
    (if armed
