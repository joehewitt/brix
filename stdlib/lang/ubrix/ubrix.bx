              (arg ubrix-mode-note)
              (arg 1)
              (arg false)
              (arg 0)
              (arg owner)
              (arg is-empty)
              (arg (. SourceRowZone header))
            )
          )
        )
        (continue)
      )
      (+= rows
        (call SourceOutlineRow
          (block
            (arg (as (. item index) U32))
            (arg ubrix-mode-parameter)
            (arg 1)
            (arg (call has-raw-line item))
            (arg 0)
            (arg owner)
            (arg is-empty)
            (arg (. SourceRowZone header))
          )
        )
      )
      (call signature-rows item 2 owner rows)
    )
    (return last)
  )
  (fn-expr _ has-raw-line Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (== (call (. store count) node) 2) (!= (call (. store raw-text) (call (. store item) node 1)) null))
  )
  (fn-do _ signature-rows _
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (param owner U32)
    (param rows (list SourceOutlineRow))
    (let signature (call signature-of node))
    (return-if (if (not signature)))
    (blank)
    (let lines (call (. store items) signature))
    (for (in index (..< 0 (. lines length)))
      (let inner ([] lines index))
      (if (call is-header-line inner)
        (call (. printer scan-row) inner)
        (+= rows
          (call SourceOutlineRow
            (block
              (arg (as (. inner index) U32))
              (arg ubrix-mode-parameter)
              (arg indent)
              (arg false)
              (arg 0)
              (arg owner)
              (arg (not (. printer has-text)))
              (arg (. SourceRowZone header))
            )
          )
        )
        (call signature-rows inner (+ indent 1) owner rows)
      )
    )
  )
  (fn-do _ statement-rows _
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (param owner (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (param zone SourceRowZone)
    (param rows (list SourceOutlineRow))
    (if (and (call (. store is-form) node "paragraph") is-text-body)
      (call line-rows node indent zone rows)
      (return)
    )
    (if (or (call (. store is-form) node "before") (call (. store is-form) node "where"))
      (call section-rows node indent owner mode zone rows)
      (return)
    )
    (let held (as (. owner index) U32))
    (let shown mode)
    (if (and (call (. store is-form) node "header") (== (call (. store count) node) 2) (call is-flow mode))
      (+= rows
        (call SourceOutlineRow
          (block
            (arg null)
            (arg source-row-decoration)
            (arg indent)
            (arg false)
            (arg source-divider-double)
            (arg held)
            (arg false)
          )
        )
      )
      (= shown ubrix-mode-titled)
    )
    (if (== mode ubrix-mode-argument)
      (call (. printer scan-argument) node)
      (else
        (call (. printer scan-row) node)
      )
    )
    (let holder (. printer holder))
    (let start (. printer start))
    (let armed (. printer armed))
    (let is-arguing (. printer is-arguing))
    (if (and (== mode ubrix-mode-styled) (!= holder null) (< start (call (. store count) holder)))
      (= shown ubrix-mode-rule)
    )
    (let is-preamble (and (== zone (. SourceRowZone loose)) (call is-import node)))
    (+= rows
      (call SourceOutlineRow
        (block
          (arg (as (. node index) U32))
          (arg shown)
          (arg indent)
          (arg (!= (call (. store raw-text) node) null))
          (arg 0)
          (arg held)
          (arg (not (. printer has-text)))
          (arg (if-expr is-preamble (. SourceRowZone preamble) zone))
        )
      )
    )
    (return-if (if (not holder)))
    (blank)
    (if (call (. store is-form) holder "paragraph")
      (for (in line (call (. store listed) holder start))
        (call (. printer scan-line) line)
        (+= rows
          (call SourceOutlineRow
            (block
              (arg (as (. line index) U32))
              (arg ubrix-mode-text)
              (arg (+ indent 1))
              (arg false)
              (arg 0)
              (arg held)
              (arg (not (. printer has-text)))
              (arg zone)
            )
          )
        )
      )
      (return)
    )
    (let inner (if-expr is-arguing ubrix-mode-argument (call nested-mode node holder mode)))
    (if armed
      (for (in item (call (. store listed) armed 1))
        (if (== (. item index) (. holder index))
          (for (in child (call (. store listed) holder start))
            (call statement-rows child (+ indent 1) owner inner zone rows)
          )
          (else-if (call is-armed armed item)
            (call statement-rows item indent owner mode zone rows)
          )
        )
      )
      (return)
    )
    (let items (call (. store items) holder))
    (let tasked (or (call (. store is-form) holder "do-new") (call (. store is-form) holder "do-new-thread")))
    (for (in index (..< start (. items length)))
      (let item ([] items index))
      (if (and (or (== (. holder index) (. node index)) tasked) (call is-armed holder item))
        (call statement-rows item indent owner mode zone rows)
        (else
          (call statement-rows item (+ indent 1) owner inner zone rows)
        )
      )
    )
    (blank)
    (lazy is-text-body (== (?. (call (. printer text-body) (call (. store items) owner)) index) (. node index)))
  )
  (fn-do _ section-rows _
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (param owner (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (param zone SourceRowZone)
    (param rows (list SourceOutlineRow))
    (let is-foot (call (. store is-form) node "where"))
    (if (and is-foot (or (== (. rows length) 0) (!= (. ([] rows (- (. rows length) 1)) divider) source-divider-dashed)))
      (+= rows (call ubrix-gap source-row-decoration owner))
    )
    (for (in item (call (. store listed) node 1))
      (call statement-rows item indent owner mode zone rows)
    )
    (if (not is-foot)
      (+= rows (call ubrix-gap source-row-decoration owner))
    )
  )
  (fn-expr _ nested-mode SourceRowMode
    (param node (of ImmutableTableRow SourceNode))
    (param holder (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (case? (or is-machine (== head "else-state"))
      ubrix-mode-state
    )
    (case? (or (== head "rule") (== head "own-rule"))
      ubrix-mode-rule
    )
    (case? (or (== head "keyframes") (== head "track"))
      ubrix-mode-keyframe
    )
    (case? (== head "when-style")
      ubrix-mode-styled
    )
    (case? (or is-nested (== mode ubrix-mode-member) (== mode ubrix-mode-main) (== mode ubrix-mode-argument))
      ubrix-mode-statement
    )
    (default
      mode
    )
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy is-machine (or (call (. store is-form) holder "machine") (== head "state") (== head "then")))
      (lazy is-styling (or (== mode ubrix-mode-style) (== mode ubrix-mode-rule) (== mode ubrix-mode-styled)))
      (lazy is-nested (or is-styling (== mode ubrix-mode-state)))
    )
  )
  (fn-do _ line-rows _
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (param zone SourceRowZone)
    (param rows (list SourceOutlineRow))
    (let items (call (. store items) node))
    (let owner (as (. node index) U32))
    (for (in index (..< 1 (. items length)))
      (let item ([] items index))
      (call (. printer scan-line) item)
      (+= rows
        (call SourceOutlineRow
          (block
            (arg (as (. item index) U32))
            (arg ubrix-mode-text)
            (arg indent)
            (arg false)
            (arg 0)
            (arg owner)
            (arg (not (. printer has-text)))
            (arg zone)
          )
        )
      )
    )
  )
  (fn-expr _ spans-of (list SourceSpan)
    (param row SourceOutlineRow)
    (param node (? (of ImmutableTableRow SourceNode)))
    (case? (== (. row divider) source-divider-thick)
      (call (of List SourceSpan) (call SourceSpan .decoration ubrix-thick-divider))
    )
    (case? (or (== (. row divider) source-divider-double) (== (. row divider) source-divider-dashed))
      (call (of List SourceSpan) (call SourceSpan .decoration ubrix-ruler))
    )
    (case? (. row is-divider)
      (call (of List SourceSpan) (call SourceSpan .decoration ubrix-thin-divider))
    )
    (case? (not node)
      (call (of List SourceSpan))
    )
    (case? (call ubrix-is-head-mode (. row mode))
      (call resolved-head row node)
    )
    (case? (== (. row mode) ubrix-mode-text)
      (call ubrix-highlight-line (call (. printer line) node))
    )
    (case? (== (. row mode) ubrix-mode-unparsed)
      (call highlight (?? (call (. store raw-text) node) "") (. row mode))
    )
    (default
      (call resolved-spans row node)
    )
  )
  (fn-do _ resolved-spans (list SourceSpan)
    (param row SourceOutlineRow)
    (param node (of ImmutableTableRow SourceNode))
    (let text (call printed row node))
    (return (call (. names resolved) (call highlight text (. row mode)) (. printer tags) (. row owner)))
  )
  (fn-do _ resolved-head (list SourceSpan)
    (param row SourceOutlineRow)
    (param node (of ImmutableTableRow SourceNode))
    (let text (call (. printer heading) node))
    (return (call (. names resolved) (call ubrix-highlight-head text) (. printer tags) (. row owner)))
  )
)

(fn-do + brix-document-read SourceDocument (?! SexpError)
  (param text String)
  (let language (call UBrixLanguage))
  (let document
    (call source-document-read language text
      (block
        (on-error (: failure SexpError)
          (call (. language store release))
          (throw failure)
        )
      )
    )
  )
  (return document)
)

(fn-do + ubrix-read (list (of ImmutableTableRow SourceNode))
  (param language UBrixLanguage)
  (param text String)
  (let forms (list (of ImmutableTableRow SourceNode)))
  (let lines (list String))
  (for (in line (call (. text split) "\n"))
    (if (and (> (. lines length) 0) (call (. line starts-with) "━"))
      (++= forms (call ubrix-read-chunk language lines))
      (= lines (call (of List String)))
    )
    (+= lines line)
  )
  (++= forms (call ubrix-read-chunk language lines))
  (return forms)
)

(fn-do + ubrix-woven (list (of ImmutableTableRow SourceNode)) (?! UBrixSyntaxError)
  (param language UBrixLanguage)
  (param source String)
  (let store (. language store))
  (let spans (call UBrixSpans store))
  (let root (call ubrix-build source (call UBrixBuilder store spans)))
  (let woven (call (. (call UBrixTrivia store spans source) weave) root))
  (let nodes (list (of ImmutableTableRow SourceNode)))
  (for (in node (call (. store listed) woven 1))
    (if (call (. store is-form) node "content")
      (for (in item (call (. store listed) node 1))
        (+= nodes (call (. language converted) item))
      )
      (else
        (+= nodes (call (. language converted) node))
      )
    )
  )
  (return nodes)
)

(type _ UBrixOutlineBuild
  (prop + place U32)
  (prop + rows (list SourceOutlineRow))
  (prop + parts (list SourceOutlinePart))
  (prop + reused Size)
  (blank)
  (prop _ previous (? SourceOutline))
  (prop _ cursor Index)
  (prop _ budget Size)
  (fn-do + This _
    (param place _)
    (param previous _)
    (= budget (* (?? (. (?. previous parts) length) 0) ubrix-part-scans))
  )
  (fn-do + reuse Bool
    (param store SourceStore)
    (param item (of ImmutableTableRow SourceNode))
    (param kind U8)
    (param mode SourceRowMode)
    (param zone SourceRowZone)
    (let old previous)
    (return-if false (if (not old)))
    (blank)
    (let known (. old parts))
    (let id (. item id))
    (for (in step (..< 0 (. known length)))
      (return-if false (if (== budget 0)))
      (blank)
      (-= budget 1)
      (let position (% (+ cursor step) (. known length)))
      (let part ([] known position))
      (if (!= (. part id) id)
        (continue)
      )
      (= cursor (+ position 1))
      (if (or (!= (. part kind) kind) (!= (. part mode) mode) (!= (. part zone) zone) (not (call (. store shares) item part-node)))
        (return false)
      )
      (lazy part-node (call (. store node) (. part place)))
      (let now (as (. item index) U32))
      (for (in index (..< (. part first) (+ (. part first) (. part count))))
        (let row ([] (. old plain) index))
        (+= rows
          (call SourceOutlineRow
            (block
              (arg (call moved (. part place) now (. old place) (. row node)))
              (arg (. row mode))
              (arg (. row indent))
              (arg (. row is-invalid))
              (arg (. row divider))
              (arg (call moved (. part place) now (. old place) (. row owner)))
              (arg (. row is-empty))
              (arg (. row zone))
              (arg (. row block))
              (arg (. row is-text-only))
              (arg (. row is-padding))
              (arg (. row is-private))
              (arg (. row is-open-end))
            )
          )
        )
      )
      (+= reused (. part count))
      (return true)
    )
    (return false)
  )
  (fn-expr _ moved (? U32)
    (param was U32)
    (param now U32)
    (param from U32)
    (param position (? U32))
    (case? (== position null)
      null
    )
    (case? (== position was)
      now
    )
    (case? (== position from)
      place
    )
    (default
      position
    )
  )
)

(fn-expr _ ubrix-scope UBrixEntry
  (param mode SourceRowMode)
  (match mode
    (case= ubrix-mode-member
      (. UBrixEntry member-row)
    )
    (case= ubrix-mode-state
      (. UBrixEntry state-row)
    )
    (case= ubrix-mode-style
      (. UBrixEntry member-row)
    )
    (case= ubrix-mode-rule
      (. UBrixEntry rule-row)
    )
    (case= ubrix-mode-styled
      (. UBrixEntry use-row)
    )
    (case= ubrix-mode-keyframe
      (. UBrixEntry keyframe-row)
    )
    (default
      (. UBrixEntry statement-row)
    )
  )
)

(fn-expr _ ubrix-is-head-mode Bool
  (param mode SourceRowMode)
  (or is-declaration (== mode ubrix-mode-head) (== mode ubrix-mode-method))
  (where
    (lazy is-declaration (or (== mode ubrix-mode-function) (== mode ubrix-mode-type)))
  )
)

(fn-do _ ubrix-spaced (list SourceOutlineRow)
  (param rows (list SourceOutlineRow))
  (return-if rows (if (not (call some rows (:where (== (. each mode) ubrix-mode-titled))))))
  (blank)
  (let spaced (list SourceOutlineRow))
  (for (in index (..< 0 (. rows length)))
    (let row ([] rows index))
    (if (and (call ubrix-is-ruler row) (> (. spaced length) 0) (not (. ([] spaced (- (. spaced length) 1)) is-empty)))
      (+= spaced (call ubrix-spacer row))
    )
    (+= spaced row)
    (if (and (== (. row mode) ubrix-mode-titled) (< (+ index 1) (. rows length)) (not (. ([] rows (+ index 1)) is-empty)))
      (+= spaced (call ubrix-spacer row))
    )
  )
  (return spaced)
)

(fn-expr _ ubrix-is-ruler Bool
  (param row SourceOutlineRow)
  (== (. row divider) source-divider-double)
)

(fn-expr _ ubrix-import-spans (list SourceSpan)
  (param text String)
  (case? (or (== cut null) (>= (+ cut 1) (. text length)))
    (call (of List SourceSpan) (call SourceSpan .string text))
  )
  (default
    (call (of List SourceSpan)
      (block
        (arg (call SourceSpan .string ([] text (... _ (+ cut 1)))))
        (arg (call SourceSpan .definition ([] text (... (+ cut 1)))))
      )
    )
  )
  (where
    (lazy cut (call (. text find-reverse) "/"))
  )
)

(fn-expr _ ubrix-spacer SourceOutlineRow
  (param row SourceOutlineRow)
  (call SourceOutlineRow null source-row-decoration (. row indent) false 0 (. row owner) true)
)

(fn-expr _ ubrix-ruler-row SourceOutlineRow
  (param owner (of ImmutableTableRow SourceNode))
  (call SourceOutlineRow
    (block
      (arg null)
      (arg source-row-decoration)
      (arg 0)
      (arg false)
      (arg source-divider-dashed)
      (arg (as (. owner index) U32))
      (arg false)
    )
  )
)

(fn-expr _ ubrix-divider-row SourceOutlineRow
  (param divider U8)
  (param owner (of ImmutableTableRow SourceNode))
  (param block SourceRowBlock)
  (param is-private _ (= false))
  (call SourceOutlineRow
    (block
      (arg null)
      (arg source-row-decoration)
      (arg 0)
      (arg false)
      (arg divider)
      (arg (as (. owner index) U32))
      (arg false)
      (arg .none)
      (arg block)
      (:is-private is-private)
    )
  )
)

(fn-expr _ ubrix-blank-line SourceOutlineRow
  (param mode SourceRowMode)
  (param owner (of ImmutableTableRow SourceNode))
  (call SourceOutlineRow null mode 0 false 0 (as (. owner index) U32) true (. SourceRowZone body))
)

(fn-expr _ ubrix-lead SourceOutlineRow
  (param owner (of ImmutableTableRow SourceNode))
  (param is-text-only Bool)
  (call SourceOutlineRow
    (block
      (arg null)
      (arg ubrix-mode-separator)
      (arg 0)
      (arg false)
      (arg 0)
      (arg (as (. owner index) U32))
      (arg true)
      (arg (. SourceRowZone none))
      (arg (. SourceRowBlock none))
      (arg is-text-only)
    )
  )
)

(fn-expr _ ubrix-gap SourceOutlineRow
  (param mode SourceRowMode)
  (param owner (of ImmutableTableRow SourceNode))
  (param is-open-end _ (= false))
  (call SourceOutlineRow null mode 0 false 0 (as (. owner index) U32) true (:is-open-end is-open-end))
)

(fn-expr _ ubrix-padding SourceOutlineRow
  (param owner (of ImmutableTableRow SourceNode))
  (call SourceOutlineRow null ubrix-mode-separator 0 false 0 (as (. owner index) U32) true (:is-padding true))
)

(fn-do _ ubrix-read-chunk (list (of ImmutableTableRow SourceNode))
  (param language UBrixLanguage)
  (param lines (list String))
  (let store (. language store))
  (let trial (call (of List String) lines))
  (let marks (call (of Map String Size)))
  (let tries Size 0)
  (while (< tries ubrix-read-repairs)
    (let read (catch (call ubrix-woven language (call (. "\n" join) trial))))
    (if (is read UBrixSyntaxError)
      (let line (call ubrix-repair-line trial (. (as read UBrixSyntaxError) line)))
      (if (== line null)
        (break)
      )
      (+= tries 1)
      (let mark (str ubrix-repair-mark line))
      (let lead ([] ([] trial line) (... _ (call ubrix-lead ([] trial line)))))
      (if (!= ([] marks mark) null)
        (= ([] trial line) (str lead "` " mark))
        (else
          (= ([] marks mark) line)
          (= ([] trial line) (if-expr (call ubrix-opens trial line) (str lead "while " mark) (str lead mark)))
        )
      )
      (continue)
    )
    (let forms (list (of ImmutableTableRow SourceNode)))
    (let restored (call (of Map U32 Size)))
    (for (in node (as read (list (of ImmutableTableRow SourceNode))))
      (++= forms (call (. language unpacked) (call ubrix-restored store node lines marks restored)))
    )
    (return-if forms (if (and (== (. restored length) (. marks length)) (call ubrix-faithful language forms lines restored))))
    (blank)
    (break)
  )
  (let held (list (of ImmutableTableRow SourceNode)))
  (+= held (call (. store atom) ubrix-unparsed-head))
  (for (in line lines)
    (+= held (call (. store raw) line (call (of List (of ImmutableTableRow SourceNode)))))
  )
  (return (call (of List (of ImmutableTableRow SourceNode)) (call (. store list) held)))
)

(fn-do _ ubrix-opens Bool
  (param lines (list String))
  (param line Index)
  (let depth (call ubrix-lead ([] lines line)))
  (for (in next (..< (+ line 1) (. lines length)))
    (if (> (. (call (. ([] lines next) trim)) length) 0)
      (return (> (call ubrix-lead ([] lines next)) depth))
    )
  )
  (return false)
)

(fn-do _ ubrix-faithful Bool
  (param language UBrixLanguage)
  (param forms (list (of ImmutableTableRow SourceNode)))
  (param lines (list String))
  (param restored (map U32 Size))
  (let store (. language store))
  (let seen Size 0)
  (for (in form forms)
    (for (in row (. (call (. language outline) form null) rows))
      (let line (only-if ([] restored (call (. store id-at) (. row node))) (if (!= (. row node) null))))
      (if (!= line null)
        (+= seen 1)
        (return-if false (if (!= (* (. row indent) source-indent-columns) (call ubrix-lead ([] lines line)))))
      )
    )
  )
  (return (== seen (. restored length)))
)

(fn-do _ ubrix-repair-line (? Index)
  (param lines (list String))
  (param reported Size)
  (let last (if-expr (> reported (. lines length)) (. lines length) reported))
  (let found (? Index) null)
  (for (in line (..< 0 last))
    (if (call ubrix-is-repairable ([] lines line))
      (= found line)
    )
  )
  (return found)
)

(fn-expr _ ubrix-is-repairable Bool
  (param text String)
  (and (> (. body length) 0) (not (call (. body starts-with) "`")) (not is-boxed))
  (where
    (lazy body (call (. text trim)))
    (lazy is-boxed (or (call (. body starts-with) "━") (call (. body starts-with) "─") (call (. body starts-with) "═")))
  )
)

(fn-do _ ubrix-lead Size
  (param text String)
  (let count Size 0)
  (for (in c (. text codepoints))
    (if (and (!= c (char " ")) (!= c (char "\t")))
      (break)
    )
    (+= count 1)
  )
  (return count)
)

(fn-do _ ubrix-restored (of ImmutableTableRow SourceNode)
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param lines (list String))
  (param marks (map String Size))
  (param restored (map U32 Size))
  (let key (call ubrix-repair-key store node))
  (let line (only-if ([] marks key) (if (!= key null))))
  (if (!= line null)
    (let held (list (of ImmutableTableRow SourceNode)))
    (if (and (call (. store is-list) node) (not (call (. store is-comment) node)))
      (for (in item (call (. store listed) node 2))
        (+= held (call ubrix-restored store item lines marks restored))
      )
    )
    (let text ([] lines line))
    (let made (call (. store raw) ([] text (... (call ubrix-lead text))) held))
    (= ([] restored (. made id)) line)
    (return made)
  )
  (return-if node (if (not (call (. store is-list) node))))
  (blank)
  (let items (call (. store listed) node))
  (let changed false)
  (for (in index (..< 0 (. items length)))
    (let next (call ubrix-restored store ([] items index) lines marks restored))
    (if (!= (. next index) (. ([] items index) index))
      (= ([] items index) next)
      (= changed true)
    )
  )
  (return (if-expr changed (call (. store with-items) node items) node))
)

(fn-expr _ ubrix-repair-key (? String)
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (case? (call (. store is-comment) node)
    (call (. store comment-text) node)
  )
  (case? (call (. store is-atom) node)
    (call (. store text) node)
  )
  (case? (and (call (. store is-form) node "while") (> (call (. store count) node) 1) (call (. store is-atom) (call (. store item) node 1)))
    (call (. store text) (call (. store item) node 1))
  )
  (default
    null
  )
)
