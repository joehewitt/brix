    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . y = 3"
    "if c"
    "    . z = 4"
    "    if d"
    "        . w = 5"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
)

