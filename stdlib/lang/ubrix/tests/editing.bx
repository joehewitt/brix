    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . q = 5"
    "if r"
    "    . s = 6"
    "    . y = 3"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
)

(fn-expr _ two-space _
