  (paragraph
    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . y = 3"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do ("
    "    - by Int"
    (blank)
    ". q = 1"
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
