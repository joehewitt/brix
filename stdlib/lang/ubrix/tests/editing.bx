(fn-expr _ nested-arguments _
  (paragraph
    "(main"
    "  (let readers (call (of List (of Getter Int))))"
    ")"
  )
)

(fn-expr _ nested-text _
  (paragraph
    ". readers = List'(Getter'Int)()"
    (blank)
    (str thick)
  )
)

(fn-expr _ facet-brix _
  (paragraph
    "(type + BoxScroll (facet-of Box)"
    "  (sees BoxMeasure)"
    "  (sees BoxFocus)"
    "  (prop _ offset _ (= 0))"
    "  (prop ^ pinned _ (= false))"
    ")"
  )
)

(fn-expr _ facet-text _
  (paragraph
    (str thick)
    "+ BoxScroll is facet of Box"
    "    sees BoxMeasure"
    "    sees BoxFocus"
    (blank)
    "_ offset = 0"
    "^ pinned = false"
    (blank)
    (str thick)
  )
)

(fn-expr _ scoped-brix _
  (paragraph
    "(fn-do + step _ @inline (without heap suspend) (with depth 2) (with scope \"step\")"
    "  (do (without gc) (with depth 3)"
    "    (call tick)"
    "  )"
    ")"
  )
)

(fn-expr _ scoped-text _
  (paragraph
    (str thick)
    "+ do step @inline without heap, suspend with depth = 2, scope = \"step\""
    (blank)
    "do without gc with depth = 3"
    "    tick()"
    (blank)
    (str thick)
  )
)

(fn-expr _ caught-task _
  (paragraph
    (str thick)
    "+ do walk Int"
    (blank)
    ". a = 1"
    "do new"
    "    work()"
    "catch failed"
    "    print(failed)"
    ". c = 3"
    "= a"
  )
)

(fn-expr _ caught-kept-task _
  (paragraph
    (str thick)
    "+ do walk Int"
    (blank)
    ". a = 1"
    ". t = do new"
    "    work()"
    "catch failed"
    "    print(failed)"
    ". c = 3"
    "= a"
  )
)

(fn-expr _ caught-call _
  (paragraph
    (str thick)
    "+ do walk Int"
    (blank)
    ". a = 1"
    "work()"
    "catch failed"
    "    print(failed)"
    ". c = 3"
    "= a"
  )
)
