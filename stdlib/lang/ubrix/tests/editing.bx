  (paragraph
    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . y = 3"
    (blank)
    (str thick)
    "+ do mid Int"
    (blank)
    ". m = 1"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
)

