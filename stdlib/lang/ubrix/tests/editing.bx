    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . y = 3"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do mid Int"
    (blank)
    ". m = 1"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
)

(fn-expr _ end-pasted _
  (paragraph
    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    . y = 3"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
    (blank)
    (str thick)
    "+ do last Int"
    (blank)
    ". n = 1"
  )
)

(fn-expr _ moved-in _
  (paragraph
    (str thick)
    "+ do walk Int"
    "    - by Int"
    (blank)
    ". a = 1"
    "if b"
    "    . x = 2"
    "    if c"
    "        . z = 4"
    "    . y = 3"
    ". c = 3"
    "= a"
    (blank)
    (str thick)
    "+ do other Int"
    (blank)
    ". d = 4"
    "= d"
  )
)

(fn-expr _ moved-out _
