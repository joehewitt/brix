
./host.linux
./host.macos
/data/json
/os/env
/os/file
/os/path

+ brix-runtime-path Path := runtime-source-root()

+ brix-build-path Path := build-root()

+ toolchain-root Path := find-toolchain-root()

+ toolchain-config-name = "libs/build.json"

+ project-folder-name = ".brix"

_ git-folder-name = ".git"

+ project-root Path := find-project-root()

+ brix-probes-path Path := project-root / ".tmp/build/probes"

+ sdk-root Path := apple-sdk-path(null)

+ diagnostic-status = 2

+ diagnostic-limit Index = 10

+ default-worker-count = usable-core-count()

+ runtime-c-paths [String = [Path]] := configured-c-paths()

` These modules are automatically imported into every C module
+ builtin-c-module-names List
    * "core"
    * "core/number"

` These modules are automatically imported into every Brix module
+ builtin-module-names List
    * "core"
    * "core/error"
    * "core/number"
    * "core/string"
    * "core/type"
    * "core/backing"
    * "core/array"
    * "core/function"
    * "core/collection"
    * "core/list"
    * "core/map"
    * "core/range"
    * "core/stream"
    * "core/channel"
    * "core/event"
    * "core/tracker"
    * "core/parsing"
    * "core/task"

` These modules are imported into every module that uses grammar syntax
+ stream-module-names List
    * "core/tokenstream"
    * "core/patterns"

` This module is imported into every module that writes markup
+ markup-module-name = "core/markup"

` This module is imported into every module that declares or extends a style sheet with `•`
+ style-module-name = "core/style"

` This module is imported into the entry module, and every module outside the core library that
` writes a probe, where probes compile
+ probes-module-name = "core/probes"

` These modules have functions the compiler can call via brix.core.x
+ core-module-names List
    * "BxCore/BxCore.h"
    * "BxGC/BxGC.h"
    * "BxCore/BxBatchTest.h"
    * "BxCore/BxString.h"
    * "BxCore/BxPanic.h"
    * "BxEvents/BxEvents.h"
    * "math.h"

` The instrumented benchmark runtime builds into "bench" under the build root;
` fall back to it when the root itself carries no runtime source tree.
━━━━━━━━━━━━━━━━━━━━
_ runtime-source-root Path

|? root-sources.is-dir
    root
|? bench-sources.is-dir
    bench-root
??
    root

.. root = brix-build-path
.. root-sources = root / "brix/libs/core"
.. bench-root = root / "bench"
.. bench-sources = bench-root / "brix/libs/core"

━━━━━━━━━━━━━━━━━━━━
_ build-root Path

configured-build-root() ?? toolchain-root / "build"

━━━━━━━━━━━━━━━━━━━━
_ configured-build-root Path?

Path(resolved-path(configured, "")) if configured != ""

.. configured = env("BRIX_BUILD_PATH") ?? ""

━━━━━━━━━━━━━━━━━━━━
_ do find-toolchain-root Path

. start = configured-build-root() ?? executable-path().dir
. found = directory-holding(start, toolchain-config-name)
?! Error("No $toolchain-config-name above $start; set BRIX_BUILD_PATH to a runtime build")
    if !found
= found

━━━━━━━━━━━━━━━━━━━━
_ do find-project-root Path

. start = Path(cwd())
= directory-holding(start, git-folder-name) ?? directory-holding(start, project-folder-name, toolchain-home()) ?? start

━━━━━━━━━━━━━━━━━━━━
_ toolchain-home String

Path(env("BRIX_HOME") ?? "${env("HOME") ?? ""}/.brix").normalized

━━━━━━━━━━━━━━━━━━━━
_ do directory-holding Path?
    - start Path
    - name String
    - except String? = null

. directory = start
while directory
    . entry = directory / name
    if entry.exists && (entry as String) != except
        = directory
    . parent = directory.dir
    if (parent as String) == (directory as String)
        break
    directory = parent
= null

━━━━━━━━━━━━━━━━━━━━
+ do module-search-paths [Path]

. paths [Path]
. configured = env("BRIXPATH") ?? ""
if configured != ""
    paths ++= configured.split(":")
else
    paths += toolchain-root / "stdlib"
= paths

━━━━━━━━━━━━━━━━━━━━
+ resolved-path String
    - base Path
    - name String

resolved-path(base as String, name)

━━━━━━━━━━━━━━━━━━━━
+ do resolved-path String
    - base String
    - name String

` The absolute path `name` names in the directory `base`, as TypeScript's `path.resolve` gives it:
` a relative `base` is read from the current directory, and `.` and `..` segments are folded.
. whole =
    |? base.starts-with(separator)
        "$base$separator$name"
    ??
        "${cwd()}$separator$base$separator$name"
. parts [String]
for part in whole.split(separator)
    if part == ".."
        if parts.length != 0
            parts.pop()
    else if part && part != "."
        parts += part
. joined = separator.join(parts)
= "$separator$joined"

━━━━━━━━━━━━━━━━━━━━
_ do configured-c-paths [String = [Path]]

. paths [String = [Path]]
. config-path = toolchain-root / toolchain-config-name
. text = catch? read-file-text(config-path)
?! Error("Unable to read $config-path")
    if !text
. config = JSON(text)
if config is [String = JSON]
    . fields = config as [String = JSON]
    . projects = fields["runtimeProjects"]
    if projects && projects is [String = JSON]
        for _, project in projects as [String = JSON]
            if project is [String = JSON]
                . path = (project as [String = JSON])["path"]
                if path && path is String
                    add-export-roots(paths, project, brix-runtime-path / "brix" / (path as String))
    . externals = fields["externalLibraries"]
    if externals && externals is [String = JSON]
        for name, external in externals as [String = JSON]
            add-export-roots(paths, external, brix-runtime-path / "external" / name)
= paths

━━━━━━━━━━━━━━━━━━━━
_ do add-export-roots
    - paths [String = [Path]]
    - component JSON
    - root Path

if component is not [String = JSON]
    =
. exports = (component as [String = JSON])["exports"]
if !exports || exports is not [String = JSON]
    =
for _, shorthand in exports as [String = JSON]
    if shorthand is String
        . roots = paths[shorthand] ?? List'Path()
        roots += root
        paths[shorthand] = roots
