`benchmark.meta description: Parses a deterministic synthetic Yumi source file.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,compile-timing

/YuCore/YuCore.h
/lang/ast/ast
/lang/ast/ast-builder
/lang/ast/ast-nodes
/lang/ast/grammar

. source = synthetic-source()
. checksum = 0 as Size
for i in 0 .. < 8
    . tree = parse-yumi(source, "bench/synthetic-yumi")
    use tree
    checksum += root-statement-count(tree) * (i + 1)
    checksum += source.length

C:yumiBenchCollect()

-- "bench-result parser/synthetic-yumi checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ root-statement-count Size
    - tree ASTBuilder

match tree.nodes[tree.root]
    | .node-top-level-syntax(top)
        top.statements.count as Size
    ?! Panic("ASTBuilder root has the wrong syntax case")

━━━━━━━━━━━━━━━━━━━━
_ synthetic-source

"${synthetic-header()}\n\n" ++ "".join("${synthetic-unit(each)}\n\n" in 0 .. < 16)

━━━━━━━━━━━━━━━━━━━━
_ ¶ synthetic-header

\/data/json
\/net/sse
\/tui/text

━━━━━━━━━━━━━━━━━━━━
_ ¶ synthetic-unit
    - index Int

\━━━━━━━━━━━━━━━━━━━━
\+ BenchNode$index

\+ name = "node-$index"
\+ count = $index

\────────────────────
\+ This
    - seed Int

count = seed + $index

\────────────────────
\+ render String
    - prefix String

. values [String]
for i in 0 .. < 6
    values += prefix ++ "-" ++ name ++ "-" ++ (count as String) ++ "-" ++ (i as String)

"|".join(values)

\────────────────────
\+ parse-pair (String, String)
    - source String

match source
    ~ left \\identifier ":" right \\identifier
        (left, right)
    ?! Panic("pair parse failed")

.. identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*
