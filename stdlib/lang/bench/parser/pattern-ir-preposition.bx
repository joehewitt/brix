; benchmark.meta description: Replays the Tier-2 preposition miss path at production scale.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/tokenstream)
(blank)

(main
  (let stream (call (of ArrayTokenStream Char) (. "zzzzzzzz" codepoints)))
  (let checksum Size)
  (for (in i (..< 0 5000000))
    (= (. stream cursor) 0)
    (+= checksum (call probe-preposition stream))
  )
  (blank)
  (print (str "bench-result parser/pattern-ir-preposition checksum=" checksum))
)

(fn-do + probe-preposition Size
  (param stream (of TokenStream Char))
  (return
    (match stream
      (~ (: value \preposition)
        (. value length)
      )
      (default
        (inline 0)
      )
    )
  )
)

(fn-expr + preposition _ (over: Char)
  (~ "about")
  (~ "after")
  (~ "and")
  (~ "at")
  (~ "before")
  (~ "between")
  (~ "both")
  (~ "by")
  (~ "during")
  (~ "despite")
  (~ "except")
  (~ "every")
  (~ "from")
  (~ "into")
  (~ "like")
  (~ "near")
  (~ "of")
  (~ "onto")
  (~ "or")
  (~ "over")
  (~ "since")
  (~ "through")
  (~ "toward")
  (~ "to")
  (~ "using")
  (~ "whenever")
  (~ "when")
  (~ "where")
  (~ "within")
  (~ "without")
  (~ "with")
  (~ "unless")
  (~ "unlike")
  (~ "until")
  (~ "via")
)
