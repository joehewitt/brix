`benchmark.meta description: Parses the compiler's command-line module with one benchmark-selected parse worker.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,compile-timing,parser-queue

/lang/compiler
/os/env

. brix BrixCompiler
brix.parse-worker-count = 1

. paths = env("BRIXPATH")
if paths
    brix.search-paths ++= paths.split(":")

. source-path = brix.path-to-module("/../apps/compiler/brix-cli")
?! Panic("Unable to resolve /../apps/compiler/brix-cli")
    if !source-path

. program = use brix.source-to-syntax(source-path as String, "__source__")
. checksum = program.modules.length
if checksum == 0
    ?! Panic("The parser did not parse any modules")

-- "bench-result parser/compiler-source-1 checksum=$checksum"
