; benchmark.meta description: Runs the complete compiler pipeline, including C headers, linking, typing, and diagnostics.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,compile-timing,parser-queue,allocator
(blank)
(import /lang/compiler)
(import /os/env)
(blank)

(main
  (let brix BrixCompiler)
  (= (. brix parse-worker-count) 8)
  (blank)
  (let paths (call env "BRIXPATH"))
  (if paths
    (++= (. brix search-paths) (call (. paths split) ":"))
  )
  (blank)
  (let source-path (call (. brix path-to-module) "/../apps/compiler/brix-cli"))
  (throw (call Panic "Unable to resolve /../apps/compiler/brix-cli") (if (not source-path)))
  (blank)
  (let checksum (call (. brix compile-program) (as source-path String) "__source__"))
  (if (== checksum 0)
    (throw (call Panic "The compiler did not check any instances"))
  )
  (blank)
  (print (str "bench-result parser/compiler-pipeline checksum=" checksum))
)
