; benchmark.meta description: Parses a deterministic synthetic Yumi source file.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,compile-timing
(blank)
(import /BxCore/BxCore.h)
(import /lang/ast/ast)
(import /lang/ast/ast-builder)
(import /lang/ast/ast-nodes)
(import /lang/ast/grammar)
(blank)

(main
  (let source (call synthetic-source))
  (let checksum (as 0 Size))
  (for (in i (..< 0 8))
    (let tree (call parse-yumi source "bench/synthetic-yumi"))
    (use tree)
    (+= checksum (* (call root-statement-count tree) (+ i 1)))
    (+= checksum (. source length))
  )
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (print (str "bench-result parser/synthetic-yumi checksum=" checksum))
)

(fn-expr _ root-statement-count Size
  (param tree ASTBuilder)
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax top)
      (as (. top statements count) Size)
    )
    (throw (call Panic "ASTBuilder root has the wrong syntax case"))
  )
)

(fn-expr _ synthetic-source _
  (++ (str (call synthetic-header) "\n\n") (call (. "" join) (in (str (call synthetic-unit each) "\n\n") (..< 0 16))))
)

(fn-expr _ synthetic-header _
  (paragraph
    "/data/json"
    "/net/sse"
    "/tui/text"
  )
)

(fn-expr _ synthetic-unit _
  (param index Int)
  (paragraph
    "━━━━━━━━━━━━━━━━━━━━"
    (str "+ BenchNode" index)
    (blank)
    (str "+ name = \"node-" index "\"")
    (str "+ count = " index)
    (blank)
    "────────────────────"
    "+ This"
    "    - seed Int"
    (blank)
    (str "count = seed + " index)
    (blank)
    "────────────────────"
    "+ render String"
    "    - prefix String"
    (blank)
    ". values [String]"
    "for i in 0 .. < 6"
    "    values += prefix ++ \"-\" ++ name ++ \"-\" ++ (count as String) ++ \"-\" ++ (i as String)"
    (blank)
    "\"|\".join(values)"
    (blank)
    "────────────────────"
    "+ parse-pair (String, String)"
    "    - source String"
    (blank)
    "match source"
    "    ~ left \\identifier \":\" right \\identifier"
    "        (left, right)"
    "    ?! Panic(\"pair parse failed\")"
    (blank)
    ".. identifier String ~"
    "    ~ [a-zA-Z_] [a-zA-Z0-9_]*"
  )
)
