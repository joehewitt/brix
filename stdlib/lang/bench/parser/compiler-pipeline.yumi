`benchmark.meta description: Runs the complete compiler pipeline, including C headers, linking, typing, and diagnostics.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,compile-timing,parser-queue,allocator

/lang/compiler
/os/env

. brix BrixCompiler
brix.parse-worker-count = 8

. paths = env("BRIXPATH")
if paths
    brix.search-paths ++= paths.split(":")

. source-path = brix.path-to-module("/../compiler/brix-cli")
?! Panic("Unable to resolve /../compiler/brix-cli")
    if !source-path

. checksum = brix.compile-program(source-path as String, "__source__")
if checksum == 0
    ?! Panic("The compiler did not check any instances")

-- "bench-result parser/compiler-pipeline checksum=$checksum"
