`benchmark.meta description: Replays the Tier-2 preposition miss path at production scale.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/tokenstream

. stream = ArrayTokenStream'Char("zzzzzzzz".codepoints)
. checksum Size
for i in 0 .. < 5000000
    stream.cursor = 0
    checksum += probe-preposition(stream)

-- "bench-result parser/pattern-ir-preposition checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do probe-preposition Size
    - stream TokenStream'Char

= match stream
    ~ value \preposition
        value.length
    ?? 0

━━━━━━━━━━━━━━━━━━━━
+ preposition ~ Char

~ "about"
~ "after"
~ "and"
~ "at"
~ "before"
~ "between"
~ "both"
~ "by"
~ "during"
~ "despite"
~ "except"
~ "every"
~ "from"
~ "into"
~ "like"
~ "near"
~ "of"
~ "onto"
~ "or"
~ "over"
~ "since"
~ "through"
~ "toward"
~ "to"
~ "using"
~ "whenever"
~ "when"
~ "where"
~ "within"
~ "without"
~ "with"
~ "unless"
~ "unlike"
~ "until"
~ "via"
