`benchmark.meta description: Retains repeated parser results while named rules hand off capture spans.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/lang/ast/ast
/lang/ast/ast-builder
/lang/ast/ast-nodes
/lang/ast/grammar
/os/file
/os/path

. source-path = "stdlib/core/range.yumi"
. source = read-file-text(Path(source-path))
. trees [ASTBuilder]
. checksum = 0 as Size
for i in 0 .. < 128
    . tree = parse-yumi(source, source-path)
    trees += tree
    checksum += root-statement-count(tree)

for tree in trees
    use tree

-- "bench-result parser/capture-spans-retained checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ root-statement-count Size
    - tree ASTBuilder

match tree.nodes[tree.root]
    | .node-top-level-syntax(top)
        top.statements.count as Size
    ?! Panic("ASTBuilder root has the wrong syntax case")
