`benchmark.meta description: Measures the hot-path cost of one generated panic poll per leaf call.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. iteration-count = 50000000 as Size
. checksum = 0 as Size

for index in 0 .. < iteration-count
    checksum += panic-poll-leaf(index)

?! Panic("panic-poll checksum mismatch")
    if checksum != iteration-count * (iteration-count + 1) / 2

-- "bench-result compiler-shape/panic-poll checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ panic-poll-leaf Size @inline
    - value Size

?! Panic("panic-poll sentinel reached")
    if value == Size.max

value + 1
