; benchmark.meta description: Checks compilation scaling across eight sequential comprehensions.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let input (list 1 2 3 4 5 6 7 8))
  (let first (list Int) (case-each (in value input (when (> value 0)))))
  (let second (list Int) (case-each (in value input (when (> value 1)))))
  (let third (list Int) (case-each (in value input (when (> value 2)))))
  (let fourth (list Int) (case-each (in value input (when (> value 3)))))
  (let fifth (list Int) (case-each (in value input (when (> value 4)))))
  (let sixth (list Int) (case-each (in value input (when (> value 5)))))
  (let seventh (list Int) (case-each (in value input (when (> value 6)))))
  (let eighth (list Int) (case-each (in value input (when (> value 7)))))
  (let left (+ (. first length) (. second length) (. third length) (. fourth length)))
  (let right (+ (. fifth length) (. sixth length) (. seventh length) (. eighth length)))
  (let total (+ left right))
  (throw (call Panic "sequential comprehension checksum mismatch") (if (!= total 36)))
  (print (str "bench-result compiler-shape/sequential-comprehensions checksum=" total))
)
