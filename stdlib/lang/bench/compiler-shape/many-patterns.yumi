`benchmark.meta description: Compiles many small grammars to stress generated compiler shape.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. checksum = match compiler-shape-source()
    ~ \many-pattern-root
    ?! Panic("many-patterns did not parse")

-- "bench-result compiler-shape/many-patterns checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ many-pattern-root ~ Char

~ a \segment01 b \segment02 c \segment03 d \segment04 e \segment05 f \segment06 g \segment07 h \segment08 i \segment09 j \segment10
    a + b + c + d + e + f + g + h + i + j

━━━━━━━━━━━━━━━━━━━━
_ segment01 ~ Char

~ "s01(" value \word "," number \digits ")" \gap
    value.length + number.length

━━━━━━━━━━━━━━━━━━━━
_ segment02 ~ Char

~ "s02[" left \word ":" right \word "]" \gap
    left.length * 2 + right.length

━━━━━━━━━━━━━━━━━━━━
_ segment03 ~ Char

~ "s03{" first \word "|" second \word "|" third \word "}" \gap
    first.length + second.length + third.length

━━━━━━━━━━━━━━━━━━━━
_ segment04 ~ Char

~ "s04<" \word "-" value \digits ">" \gap
    value.length * 4

━━━━━━━━━━━━━━━━━━━━
_ segment05 ~ Char

~ "s05:" items \delimited(",", ~ \word) ";" \gap
    items.length * 5

━━━━━━━━━━━━━━━━━━━━
_ segment06 ~ Char

~ "s06:" items \delimited("|", ~ \digits) ";" \gap
    items.length * 6

━━━━━━━━━━━━━━━━━━━━
_ segment07 ~ Char

~ "s07(" head \word tail \tail-word* ")" \gap
    head.length + tail.length * 7

━━━━━━━━━━━━━━━━━━━━
_ segment08 ~ Char

~ "s08(" "true" "," name \word ")" \gap
    name.length + 32
~ "s08(" "false" "," name \word ")" \gap
    name.length + 40

━━━━━━━━━━━━━━━━━━━━
_ segment09 ~ Char

~ "s09:" quoted-text \quoted "@" path-text \path ";" \gap
    quoted-text.length + path-text.length * 2

━━━━━━━━━━━━━━━━━━━━
_ segment10 ~ Char

~ "s10:" key \word "=" value \digits ";" \gap?
    key.length + value.length * 10

━━━━━━━━━━━━━━━━━━━━
_ tail-word ~ Char

~ "." \word

━━━━━━━━━━━━━━━━━━━━
_ path ~ Char

~ "/" parts \delimited("/", ~ \word)
    "/".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ quoted ~ Char

~ "\"" text (!"\"" .)* "\""
    text

━━━━━━━━━━━━━━━━━━━━
_ word ~ Char

~ [a-zA-Z_] [a-zA-Z0-9_]*

━━━━━━━━━━━━━━━━━━━━
_ digits ~ Char

~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ gap ~ Char

~ (" " | "\n" | "\t")+

━━━━━━━━━━━━━━━━━━━━
_ " compiler-shape-source

s01(alpha,123) s02[left:right] s03{one|two|three} s04<word-456>
s05:a,b,c,d; s06:1|2|3|4|5; s07(root.branch.leaf) s08(true,name)
s09:"quoted text"@/alpha/beta/gamma; s10:key=98765;
