`benchmark.meta description: Runs one tight integer loop to expose MIR fallthrough branch redirects.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. upper-bound = 50000000 as Size
. checksum = fallthrough-checksum(upper-bound)
?! Panic("fallthrough-loop checksum mismatch")
    if checksum != upper-bound * (upper-bound + 1) / 2

-- "bench-result compiler-shape/fallthrough-loop checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do fallthrough-checksum Size
    - upper-bound Size

. total = 0 as Size
for index in 0 .. < upper-bound
    total += (index as Size) + 1
= total
