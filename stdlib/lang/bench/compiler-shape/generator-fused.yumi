`benchmark.meta description: Compares generator consumption with ordinary, fused, and handwritten loops.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. upper-bound = 5000000 as Size
. checksum = generator-checksum(upper-bound)
?! Panic("generator checksum mismatch")
    if checksum != upper-bound * (upper-bound + 1) / 2

-- "bench-result compiler-shape/generator-fused checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do generator-checksum Size
    - upper-bound Size

. total = 0 as Size
for value in generator-values(upper-bound)
    total += value
= total

━━━━━━━━━━━━━━━━━━━━
_ do generator-values @inline
    - upper-bound Size

for index in 0 .. < upper-bound
    <= (index as Size) + 1
