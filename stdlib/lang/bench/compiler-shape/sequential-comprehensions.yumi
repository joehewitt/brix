`benchmark.meta description: Checks compilation scaling across eight sequential comprehensions.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. input = [1, 2, 3, 4, 5, 6, 7, 8]
. first [Int] = <* value in input when value > 0
. second [Int] = <* value in input when value > 1
. third [Int] = <* value in input when value > 2
. fourth [Int] = <* value in input when value > 3
. fifth [Int] = <* value in input when value > 4
. sixth [Int] = <* value in input when value > 5
. seventh [Int] = <* value in input when value > 6
. eighth [Int] = <* value in input when value > 7
. left = first.length + second.length + third.length + fourth.length
. right = fifth.length + sixth.length + seventh.length + eighth.length
. total = left + right
?! Panic("sequential comprehension checksum mismatch")
    if total != 36
-- "bench-result compiler-shape/sequential-comprehensions checksum=$total"
