; benchmark.meta description: Producer-choice feed fusion scaling with 64 alternatives.
; benchmark.meta timing: recommended
(blank)
(import /core)
(blank)

(main
  (let values (call fusion-scale-64 63))
  (let checksum 0)
  (for (in value values)
    (+= checksum value)
  )
  (print (str "bench-result compiler-shape/fusion-scale-64 checksum=" checksum))
)

