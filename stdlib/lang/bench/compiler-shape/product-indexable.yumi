`benchmark.meta description: Product over integer ranges, stream helper.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/stream/combine

. checksum = range-checksum(100000, 24, 32)
?! Panic("range checksum mismatch")
    if checksum != 58022400000
-- "bench-result compiler-shape/product-indexable checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do range-checksum I64
    - rounds Int
    - rows Int
    - columns Int

. total = 0i64
for round in 0 .. < rounds
    for index, cell in indexed(product(0 .. < rows, 0 .. < columns))
        total += index + cell[0] * 31 + cell[1]
= total
