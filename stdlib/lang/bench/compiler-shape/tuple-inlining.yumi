`benchmark.meta description: Measures expansion of immutable tuple parameters and receivers in a hot loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. checksum = 0u64
for index in 0u64 .. < 5000000u64
    checksum += total(Quad(index, index + 1, index + 2, index + 3))

-- "bench-result compiler-shape/tuple-inlining checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ Quad is Tuple

+ a U64
+ b U64
+ c U64
+ d U64

────────────────────
+ sum U64 @inline

a + b + c + d

━━━━━━━━━━━━━━━━━━━━
+ total U64 @inline
    - value Quad

value.sum() + value.a
