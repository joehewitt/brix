`benchmark.meta description: Repeat over integer ranges, stream helper.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/stream/combine

. checksum = range-checksum(100000, 24, 32)
?! Panic("range checksum mismatch")
    if checksum != 1190400000
-- "bench-result compiler-shape/repeat-indexable checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do range-checksum I64
    - rounds Int
    - rows Int
    - columns Int

. total = 0i64
for round in 0 .. < rounds
    for column in (repeat(rows, 0 .. < columns))
        total += column
= total
