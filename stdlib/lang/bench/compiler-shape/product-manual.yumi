`benchmark.meta description: Product over integer ranges, manual loop reference.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/stream/combine

. checksum = range-checksum(100000, 24, 32)
?! Panic("range checksum mismatch")
    if checksum != 58022400000
-- "bench-result compiler-shape/product-manual checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do range-checksum I64
    - rounds Int
    - rows Int
    - columns Int

. total = 0i64
for round in 0 .. < rounds
    . index Index = 0
    for row in 0 .. < rows
        for column in 0 .. < columns
            total += index + row * 31 + column
            index += 1
= total
