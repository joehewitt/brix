; benchmark.meta description: Repeated feed map/filter pipelines consumed by a materialized list.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing,allocator
(blank)
(import /core)
(blank)

(main
  (let rounds 40000)
  (let upper-bound 256)
  (let checksum (call feed-checksum rounds upper-bound))
  (throw (call Panic "feed checksum mismatch") (if (!= checksum (* rounds 3 128 129))))
  (blank)
  (print (str "bench-result compiler-shape/feed-list checksum=" checksum))
)

(fn-do _ feed-checksum Int
  (param rounds Int)
  (param upper-bound Int)
  (let total 0)
  (for (in round (..< 0 rounds))
    (let values
      (block
        (spread (.. 1 upper-bound))
        (pipe *> (* each 3))
        (pipe ?> (== (% each 2) 0))
      )
    )
    (let items (call List values))
    (for (in value items)
      (+= total value)
    )
  )
  (return total)
)
