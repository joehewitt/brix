`benchmark.meta description: Repeated feed map/filter pipelines consumed by a loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/core

. rounds = 40000
. upper-bound = 256
. checksum = feed-checksum(rounds, upper-bound)
?! Panic("feed checksum mismatch")
    if checksum != rounds * 3 * 128 * 129

-- "bench-result compiler-shape/feed-loop checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do feed-checksum Int
    - rounds Int
    - upper-bound Int

. total = 0
for round in 0 .. < rounds
    . values =
        ** 1 .. upper-bound
        *> each * 3
        ?> each % 2 == 0
    for value in values
        total += value
= total

