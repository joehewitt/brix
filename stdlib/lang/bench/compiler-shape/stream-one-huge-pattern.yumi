`benchmark.meta description: Compiles one large grammar to stress lowering scale.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. checksum = match stream-one-huge-pattern-source()
    ~ \stream-one-huge-pattern
    ?! Panic("stream-one-huge-pattern did not parse")

-- "bench-result compiler-shape/stream-one-huge-pattern checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ stream-one-huge-pattern ~ Char

~ "s01:" a01 \huge-word "," b01 \huge-digits ";" "s02:" a02 \huge-word "," b02 \huge-digits ";" "s03:" a03 \huge-word "," b03 \huge-digits ";" "s04:" a04 \huge-word "," b04 \huge-digits ";" "s05:" a05 \huge-word "," b05 \huge-digits ";" "s06:" a06 \huge-word "," b06 \huge-digits ";" "s07:" a07 \huge-word "," b07 \huge-digits ";" "s08:" a08 \huge-word "," b08 \huge-digits ";" "s09:" a09 \huge-word "," b09 \huge-digits ";" "s10:" a10 \huge-word "," b10 \huge-digits ";" "s11:" a11 \huge-word "," b11 \huge-digits ";" "s12:" a12 \huge-word "," b12 \huge-digits ";"
    a01.length + b01.length + a02.length + b02.length + a03.length + b03.length + a04.length + b04.length + a05.length + b05.length + a06.length + b06.length + a07.length + b07.length + a08.length + b08.length + a09.length + b09.length + a10.length + b10.length + a11.length + b11.length + a12.length + b12.length

.. huge-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. huge-digits String ~
    ~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ stream-one-huge-pattern-source

"s01:alpha,101;s02:beta,202;s03:gamma,303;s04:delta,404;s05:epsilon,505;s06:zeta,606;s07:eta,707;s08:theta,808;s09:iota,909;s10:kappa,1010;s11:lambda,1111;s12:mu,1212;"
