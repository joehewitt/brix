; benchmark.meta description: Producer-choice feed fusion scaling with 128 alternatives.
; benchmark.meta timing: recommended
(blank)
(import /core)
(blank)

(main
  (let values (call fusion-scale-128 127))
  (let checksum 0)
  (for (in value values)
    (+= checksum value)
  )
  (print (str "bench-result compiler-shape/fusion-scale-128 checksum=" checksum))
)

