/data/json
/lang/worker-failure
/os/env
/os/file
/os/path
/os/process

+ bundle-directory-mode FilePermissions = 493
+ bundle-file-perms = user-read-perm /or/ user-write-perm /or/ group-read-perm /or/ other-read-perm
_ codesign = "/usr/bin/codesign"

━━━━━━━━━━━━━━━━━━━━
+ plist-string String
    - text String

"<string>${"".join(plist-escaped(each) in text)}</string>"

━━━━━━━━━━━━━━━━━━━━
_ plist-escaped String
    - c Char

match c
    |= '&'
        "&amp;"
    |= '<'
        "&lt;"
    |= '>'
        "&gt;"
    ??
        c as String

━━━━━━━━━━━━━━━━━━━━
+ do make-directories ?! Error
    - directory Path

if !directory || directory.is-dir
    =
make-directories(directory.dir)
directory.make-directory("", bundle-directory-mode)

━━━━━━━━━━━━━━━━━━━━
+ do prune ?! Error
    - directory Path
    - kept [String]

for entry in listed(directory)
    . path = directory / entry.name
    if entry.kind != PathKind.link && kept has (path as String)
        if entry.kind == PathKind.directory
            prune(path, kept)
    else
        remove-tree(path, entry.kind)

━━━━━━━━━━━━━━━━━━━━
+ do remove-tree ?! Error
    - path Path
    - kind PathKind

if kind == PathKind.directory
    for entry in listed(path)
        remove-tree(path / entry.name, entry.kind)
path.delete()

━━━━━━━━━━━━━━━━━━━━
+ listed [PathEntry] ?! Error
    - directory Path

each in directory.entries

━━━━━━━━━━━━━━━━━━━━
+ do write-if-changed Bool ?! Error
    - path Path
    - text String

if path.is-file && read-file-text(path) == text
    = false
write-file-atomically(path, text, bundle-file-perms)
= true

━━━━━━━━━━━━━━━━━━━━
+ do sign ?! Error
    - bundle Path

. identity = env("YUMI_SIGNING_IDENTITY") ?? ""
codesign-bundle(bundle, if identity == "" then "-" else identity, null)

━━━━━━━━━━━━━━━━━━━━
+ do codesign-bundle ?! Error
    - bundle Path
    - identity String
    - entitlements Path?

. arguments [String] = ["--force", "--timestamp=none", "--sign", identity]
if entitlements
    arguments += "--entitlements"
    arguments += entitlements as String
arguments += bundle as String
run-tool(codesign, arguments)

━━━━━━━━━━━━━━━━━━━━
+ do run-tool ?! Error
    - tool String
    - arguments [String]

. process = use Process(tool, ProcessStderr.capture, arguments)
. errors = process.stderr!
. drained = Semaphore'String()
. failure = WorkerFailure()
do new
    . text = errors as String
    drained.post(text)
catch failed
    failure.keep(failed)
    drained.post("")
. output = process as String
. status = process.wait(null) ?? 1
. message = drained.await() ?? ""
failure.raise-kept()
?! Error("${Path(tool).name} failed with status $status\n${"$output$message".trim()}")
    if status != 0

━━━━━━━━━━━━━━━━━━━━
+ do tool-output String? ?! Error
    - tool String
    - arguments [String]

` What a tool prints, or null when it fails.
. process = use Process(tool, ProcessStderr.discard, arguments)
. output = process as String
. status = process.wait(null) ?? 1
=? null if status != 0
= output

━━━━━━━━━━━━━━━━━━━━
+ json-field JSON?
    - name String
    - object JSON?

(object as [String = JSON])[name] if object && object is [String = JSON]

━━━━━━━━━━━━━━━━━━━━
+ json-text String
    - name String
    - object JSON?

if value && value is String then value as String else ""

.. value = json-field(name, object)

━━━━━━━━━━━━━━━━━━━━
+ do json-items [JSON]
    - value JSON?

. items [JSON]
if value && value is [JSON]
    for item in value as [JSON]
        items += item
= items
