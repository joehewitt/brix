(import ./bundle-files)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(blank)
(prop _ openssl _ (= "/usr/bin/openssl"))
(prop _ plutil _ (= "/usr/bin/plutil"))
(prop _ xcrun _ (= "/usr/bin/xcrun"))

(type + ProvisioningProfile (is Tuple)
  ; A provisioning profile that lets an app run on a team's devices: the file, its decoded property
  ; list, the team, the app id it grants, whether that id names the app exactly rather than every app
  ; of the team, and when it expires.
  (blank)
  (prop + path Path)
  (prop + decoded Path)
  (prop + team String)
  (prop + app-id String)
  (prop + is-exact Bool)
  (prop + expires String)
)

(fn-do + sign-for-device _ (?! Error)
  (param bundle Path)
  (param bundle-id String)
  (param work Path)
  ; Signs an app bundle to run on devices. It embeds the provisioning profile that grants the app's
  ; id, preferring one that names the app over one for every app of its team and then the latest to
  ; expire, and signs with the entitlements that profile grants, as the identity BRIX_SIGNING_IDENTITY
  ; names or else the Apple Development certificate.
  (let profile (call find-provisioning-profile bundle-id work))
  (let embedded (/ bundle "embedded.mobileprovision"))
  (if (. embedded exists)
    (call (. embedded delete))
  )
  (call (. profile path copy) embedded)
  (let entitlements (/ work "entitlements.plist"))
  (let extracted
    (call tool-output
      (block
        (arg plutil)
        (arg (list "-extract" "Entitlements" "xml1" "-o" "-" (as (. profile decoded) String)))
      )
    )
  )
  (throw (call Error (str "The provisioning profile " (. profile path) " grants no entitlements")) (if (not extracted)))
  (call write-if-changed entitlements extracted)
  (if (not (. profile is-exact))
    (call run-tool plutil (list "-replace" "application-identifier" "-string" (str (. profile team) "." bundle-id) (as entitlements String)))
  )
  (let identity (?? (call env "BRIX_SIGNING_IDENTITY") ""))
  (call codesign-bundle bundle (if-expr (== identity "") "Apple Development" identity) entitlements)
)

(type + IOSDevice (is Tuple)
  (prop + id String)
  (prop + name String)
  (prop + detail String)
)

(fn-do + connected-device String (?! Error)
  (param work Path)
  (param named (? String))
  ; The device a program runs on: the reachable device that `named` names by name or identifier, or
  ; else the first that `ios-devices` lists.
  (let found (call ios-devices work))
  (throw (call Error "No paired iOS device is reachable; connect one") (if (== (. found length) 0)))
  (return-if (. ([] found 0) id) (if (not named)))
  (for (in device found)
    (return-if (. device id) (if (or (== (. device id) named) (== (. device name) named))))
  )
  (throw (call Error (str "No reachable iOS device is named " named "; the reachable ones are " reachable)))
  (lazy reachable (call (. ", " join) (in (. each name) found)))
)

(fn-do + ios-devices (list IOSDevice) (?! Error)
  (param work Path)
  (call make-directories work)
  (let listing (/ work "devices.json"))
  (call run-tool xcrun (list "devicectl" "list" "devices" "--quiet" "--json-output" (as listing String)))
  (let connected (list IOSDevice))
  (let others (list IOSDevice))
  (for (in device (call json-items (call json-field "devices" (call json-field "result" (call JSON (call read-file-text listing))))))
    (let hardware (call json-field "hardwareProperties" device))
    (let connection (call json-field "connectionProperties" device))
    (let properties (call json-field "deviceProperties" device))
    (if (and (== (call json-text "platform" hardware) "iOS") is-paired has-tunnel)
      (let found
        (call IOSDevice
          (block
            (arg (call json-text "identifier" device))
            (arg (call json-text "name" properties))
            (arg
              (paragraph
                (str (call json-text "marketingName" hardware) " · iOS " (call json-text "osVersionNumber" properties))
              )
            )
          )
        )
      )
      (if (== (call json-text "tunnelState" connection) "connected")
        (+= connected found)
        (else
          (+= others found)
        )
      )
    )
    (lazy is-paired (== (call json-text "pairingState" connection) "paired"))
    (lazy has-tunnel (!= (call json-text "tunnelState" connection) "unavailable"))
  )
  (++= connected others)
  (return connected)
)

(fn-do + install-device-app _ (?! Error)
  (param device String)
  (param bundle Path)
  (call run-tool
    (block
      (arg xcrun)
      (arg (list "devicectl" "device" "install" "app" "--quiet" "--device" device (as bundle String)))
    )
  )
)

(fn-expr + device-launch-command (list String)
  (param device String)
  (param bundle-id String)
  (list xcrun "devicectl" "device" "process" "launch" "--console" "--terminate-existing" "--device" device bundle-id)
)

(fn-do _ find-provisioning-profile ProvisioningProfile (?! Error)
  (param bundle-id String)
  (param work Path)
  (call make-directories work)
  (let best (? ProvisioningProfile) null)
  (for (in directory (call profile-directories))
    (if (. directory is-dir)
      (for (in entry (call listed directory))
        (if (call (. entry name ends-with) ".mobileprovision")
          (let found (call read-profile (/ directory (. entry name)) bundle-id work))
          (if (and found (or (not best) (call ranks-above found best)))
            (= best found)
          )
        )
      )
    )
  )
  (if (not best)
    (throw
      (call Error
        (block
          (arg
            (paragraph
              (str "No provisioning profile grants " bundle-id " to iOS devices; create one in Xcode with your team, this bundle id and your device")
            )
          )
        )
      )
    )
  )
  (return best)
)

(fn-expr _ profile-directories (list Path)
  (list (/ home "Library/MobileDevice/Provisioning Profiles") (/ home "Library/Developer/Xcode/UserData/Provisioning Profiles"))
  (where
    (lazy home (call Path (?? (call env "HOME") "")))
  )
)

(fn-do _ read-profile (? ProvisioningProfile) (?! Error)
  (param path Path)
  (param bundle-id String)
  (param work Path)
  (let text
    (call tool-output
      (block
        (arg openssl)
        (arg (list "smime" "-verify" "-noverify" "-inform" "der" "-in" (as path String)))
      )
    )
  )
  (return-if null (if (not text)))
  (let decoded (/ work (str (. path name) ".plist")))
  (call write-if-changed decoded text)
  (let team (call plist-value decoded "TeamIdentifier.0"))
  (let app-id (call plist-value decoded "Entitlements.application-identifier"))
  (return-if null (if (or (!= (call plist-value decoded "Platform.0") "iOS") (== team ""))))
  (let is-exact (== app-id (str team "." bundle-id)))
  (return-if null (if (and (not is-exact) (!= app-id (str team ".*")))))
  (return (call ProvisioningProfile path decoded team app-id is-exact (call plist-value decoded "ExpirationDate")))
)

(fn-do _ plist-value String (?! Error)
  (param plist Path)
  (param key String)
  (let value (call tool-output plutil (list "-extract" key "raw" "-o" "-" (as plist String))))
  (return (if-expr value (call (. value trim)) ""))
)

(fn-expr _ ranks-above Bool
  (param found ProvisioningProfile)
  (param best ProvisioningProfile)
  (if-expr (!= (. found is-exact) (. best is-exact)) (. found is-exact) (> (. found expires) (. best expires)))
)
