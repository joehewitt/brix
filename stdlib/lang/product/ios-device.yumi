./bundle-files
/data/json
/lang/constants
/os/env
/os/file
/os/path

_ openssl = "/usr/bin/openssl"
_ plutil = "/usr/bin/plutil"
_ xcrun = "/usr/bin/xcrun"

━━━━━━━━━━━━━━━━━━━━
+ ProvisioningProfile is Tuple

` A provisioning profile that lets an app run on a team's devices: the file, its decoded property
` list, the team, the app id it grants, whether that id names the app exactly rather than every app
` of the team, and when it expires.

+ path Path
+ decoded Path
+ team String
+ app-id String
+ is-exact Bool
+ expires String

━━━━━━━━━━━━━━━━━━━━
+ do sign-for-device ?! Error
    - bundle Path
    - bundle-id String
    - work Path

` Signs an app bundle to run on devices. It embeds the provisioning profile that grants the app's
` id, preferring one that names the app over one for every app of its team and then the latest to
` expire, and signs with the entitlements that profile grants, as the identity BRIX_SIGNING_IDENTITY
` names or else the Apple Development certificate.
. profile = find-provisioning-profile(bundle-id, work)
. embedded = bundle / "embedded.mobileprovision"
if embedded.exists
    embedded.delete()
profile.path.copy(embedded)
. entitlements = work / "entitlements.plist"
. extracted = tool-output
    - plutil
    - ["-extract", "Entitlements", "xml1", "-o", "-", profile.decoded as String]
?! Error("The provisioning profile ${profile.path} grants no entitlements")
    if !extracted
write-if-changed(entitlements, extracted)
if !profile.is-exact
    run-tool(plutil, ["-replace", "application-identifier", "-string", "${profile.team}.${bundle-id}", entitlements as String])
. identity = toolchain-env("_SIGNING_IDENTITY") ?? ""
codesign-bundle(bundle, if identity == "" then "Apple Development" else identity, entitlements)

━━━━━━━━━━━━━━━━━━━━
+ IOSDevice is Tuple

+ id String
+ name String
+ detail String

━━━━━━━━━━━━━━━━━━━━
+ do connected-device String ?! Error
    - work Path
    - named String?

` The device a program runs on: the reachable device that `named` names by name or identifier, or
` else the first that `ios-devices` lists.
. found = ios-devices(work)
?! Error("No paired iOS device is reachable; connect one")
    if found.length == 0
=? found[0].id if !named
for device in found
    =? device.id if device.id == named || device.name == named
?! Error("No reachable iOS device is named ${named}; the reachable ones are ${reachable}")
.. reachable = ", ".join(each.name in found)

━━━━━━━━━━━━━━━━━━━━
+ do ios-devices [IOSDevice] ?! Error
    - work Path

make-directories(work)
. listing = work / "devices.json"
run-tool(xcrun, ["devicectl", "list", "devices", "--quiet", "--json-output", listing as String])
. connected [IOSDevice]
. others [IOSDevice]
for device in json-items(json-field("devices", json-field("result", JSON(read-file-text(listing)))))
    . hardware = json-field("hardwareProperties", device)
    . connection = json-field("connectionProperties", device)
    . properties = json-field("deviceProperties", device)
    if json-text("platform", hardware) == "iOS" && is-paired && has-tunnel
        . found = IOSDevice(json-text("identifier", device), json-text("name", properties), "${json-text("marketingName", hardware)} · iOS ${json-text("osVersionNumber", properties)}")
        if json-text("tunnelState", connection) == "connected"
            connected += found
        else
            others += found
    .. is-paired = json-text("pairingState", connection) == "paired"
    .. has-tunnel = json-text("tunnelState", connection) != "unavailable"
connected ++= others
= connected

━━━━━━━━━━━━━━━━━━━━
+ do install-device-app ?! Error
    - device String
    - bundle Path

run-tool
    - xcrun
    - ["devicectl", "device", "install", "app", "--quiet", "--device", device, bundle as String]

━━━━━━━━━━━━━━━━━━━━
+ device-launch-command [String]
    - device String
    - bundle-id String

[xcrun, "devicectl", "device", "process", "launch", "--console", "--terminate-existing", "--device", device, bundle-id]

━━━━━━━━━━━━━━━━━━━━
_ do find-provisioning-profile ProvisioningProfile ?! Error
    - bundle-id String
    - work Path

make-directories(work)
. best ProvisioningProfile? = null
for directory in profile-directories()
    if directory.is-dir
        for entry in listed(directory)
            if entry.name.ends-with(".mobileprovision")
                . found = read-profile(directory / entry.name, bundle-id, work)
                if found && (!best || ranks-above(found, best))
                    best = found
?! Error("No provisioning profile grants $bundle-id to iOS devices; create one in Xcode with your team, this bundle id and your device")
    if !best
= best

━━━━━━━━━━━━━━━━━━━━
_ profile-directories [Path]

[home / "Library/MobileDevice/Provisioning Profiles", home / "Library/Developer/Xcode/UserData/Provisioning Profiles"]

.. home = Path(env("HOME") ?? "")

━━━━━━━━━━━━━━━━━━━━
_ do read-profile ProvisioningProfile? ?! Error
    - path Path
    - bundle-id String
    - work Path

. text = tool-output
    - openssl
    - ["smime", "-verify", "-noverify", "-inform", "der", "-in", path as String]
=? null if !text
. decoded = work / "${path.name}.plist"
write-if-changed(decoded, text)
. team = plist-value(decoded, "TeamIdentifier.0")
. app-id = plist-value(decoded, "Entitlements.application-identifier")
=? null if plist-value(decoded, "Platform.0") != "iOS" || team == ""
. is-exact = app-id == "${team}.${bundle-id}"
=? null if !is-exact && app-id != "${team}.*"
= ProvisioningProfile(path, decoded, team, app-id, is-exact, plist-value(decoded, "ExpirationDate"))

━━━━━━━━━━━━━━━━━━━━
_ do plist-value String ?! Error
    - plist Path
    - key String

. value = tool-output(plutil, ["-extract", key, "raw", "-o", "-", plist as String])
= if value then value.trim() else ""

━━━━━━━━━━━━━━━━━━━━
_ ranks-above Bool
    - found ProvisioningProfile
    - best ProvisioningProfile

if found.is-exact != best.is-exact then found.is-exact else found.expires > best.expires
