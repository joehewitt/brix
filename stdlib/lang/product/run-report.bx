(import ./bundle-files)
(import ./ios-app-bundle)
(import ./ios-device)
(import ./ios-simulator)
(import ./mac-app-bundle)
(import /data/json)
(import /lang/emit/link)
(import /lang/emit/products)
(import /lang/target)
(import /os/file)
(import /os/path)

(type + ProgramRun (is Tuple)
  ; How a packaged program runs: the command that starts it once it is installed, the app bundle a
  ; simulator or device installs first, the executable it was packaged from, and the id its app
  ; launches by. A simulator's or device's command is empty, since it is chosen when the program runs.
  (blank)
  (prop + command (list String))
  (prop + bundle (? Path))
  (prop + executable Path)
  (prop + app-id (? String))
)

(fn-do + package-program ProgramRun (?! Error)
  (param output String)
  (param target Target)
  (param product (? AppProduct))
  (param claims-documents Bool)
  (let run (call packaged-run (call Path output) target product claims-documents))
  (call write-run-report output run target)
  (return run)
)

(fn-do _ packaged-run ProgramRun (?! Error)
  (param executable Path)
  (param target Target)
  (param product (? AppProduct))
  (param claims-documents Bool)
  (if (and (is (. target runner) .host) product)
    (let written (call write-mac-app-bundle product executable claims-documents))
    (return (call ProgramRun (list (as (. written executable) String)) (. written path) executable (. product id)))
  )
  (if (is (. target runner) .host)
    (return (call ProgramRun (list (as executable String)) null executable null))
  )
  (return-if (call ProgramRun (call (of List String)) null executable null) (if (not product)))
  (return
    (call ProgramRun
      (block
        (arg (call (of List String)))
        (arg (call write-ios-app-bundle product executable target))
        (arg executable)
        (arg (. product id))
      )
    )
  )
)

(fn-do + run-program Int (?! Error)
  (param run ProgramRun)
  (param target Target)
  (param arguments (list String))
  (param device (? String))
  (throw (call Error (str "A " (. target name) " program does not run on " (. (call host-target) name) "; build it with --compile -o PATH and run it on " (. target name))) (if (and (is (. target runner) .host) (not (. target runs-on-host)))))
  (let command (. run command))
  (if (is (. target runner) .simulator)
    (let simulator (call chosen-simulator device))
    (if (. run bundle)
      (call install-simulator-app simulator (. run bundle))
      (= command (call simulator-launch-command simulator (!! (. run app-id))))
      (else
        (= command (call simulator-spawn-command simulator (. run executable)))
      )
    )
  )
  (if (is (. target runner) .device)
    (let bundle (. run bundle))
    (throw (call Error (str "A program runs on an iOS device only as an app; declare an " app-class)) (if (not bundle)))
    (lazy app-class (!! (. target product-class-name)))
    (let connected (call connected-device (call device-work-path (. run executable)) device))
    (call install-device-app connected bundle)
    (= command (call device-launch-command connected (!! (. run app-id))))
  )
  (let command-arguments ([] command (... 1)))
  (++= command-arguments arguments)
  (return (call run-executable ([] command 0) command-arguments))
)

(fn-do + run-built-program Int (?! Error)
  (param output String)
  (param arguments (list String))
  (param device (? String))
  (let report-path (call Path (str output ".run.json")))
  (throw (call Error (str output " has no run report; build it with --compile -o " output)) (if (not (. report-path is-file))))
  (let report (call JSON (call read-file-text report-path)))
  (let target (call target-named (call json-text "target" report)))
  (throw (call Error (str report-path " names no target this compiler builds")) (if (not target)))
  (let command (list String))
  (if (is (. target runner) .host)
    (for (in part (call json-items (call json-field "run" report)))
      (+= command (call json-text-of part))
    )
  )
  (let bundle (call json-text "bundle" report))
  (let app-id (call json-text "app-id" report))
  (let run (call ProgramRun command (only-if (call Path bundle) (if (!= bundle ""))) (call Path output) (only-if app-id (if (!= app-id "")))))
  (return (call run-program run target arguments device))
)

(fn-do + device-records (list String) (?! Error)
  (param target Target)
  (param work Path)
  (let records (list String))
  (if (is (. target runner) .simulator)
    (for (in simulator (call ios-simulators))
      (+= records (call device-record (. simulator udid) (. simulator name) (. simulator detail)))
    )
    (else-if (is (. target runner) .device)
      (for (in device (call ios-devices work))
        (+= records (call device-record (. device id) (. device name) (. device detail)))
      )
    )
    (else
      (throw (call Error (str "A " (. target name) " program runs on this machine; --list-devices lists the simulators or devices of an iOS target")))
    )
  )
  (return records)
)

(fn-do _ device-record String
  (param id String)
  (param name String)
  (param detail String)
  (let record
    (call (of Map String JSON)
      (block
        (entry "id" (as id JSON))
        (entry "name" (as name JSON))
        (entry "detail" (as detail JSON))
      )
    )
  )
  (return (call to-json record))
)

(fn-do _ write-run-report _ (?! Error)
  (param output String)
  (param run ProgramRun)
  (param target Target)
  (let report
    (call (of Map String JSON)
      (block
        (entry "target" (as (. target name) JSON))
      )
    )
  )
  (let command (list JSON))
  (if (!= (. run command length) 0)
    (for (in argument (. run command))
      (+= command argument)
    )
    (= ([] command 0) (as (. (call Path ([] (. run command) 0)) resolved) String))
    (else
      (+= command (as (. (call executable-path) resolved) String))
      (+= command "--run")
      (+= command (as (. (call Path output) resolved) String))
      (+= command "--")
    )
  )
  (= ([] report "run") command)
  (if (. run bundle)
    (= ([] report "bundle") (as (. run bundle resolved) String))
  )
  (if (. run app-id)
    (= ([] report "app-id") (. run app-id))
  )
  (call write-file-atomically (call Path (str output ".run.json")) (call to-json report))
)

(fn-expr _ json-text-of String
  (param value JSON)
  (if-expr (is value String) (as value String) "")
)
