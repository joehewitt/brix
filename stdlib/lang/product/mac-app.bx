(import ./product)

(type + MacApp
  (implements Product)
  (prop + id String)
  (prop + name String)
  (prop + version (? String))
  (prop + icon (? String))
  (prop + shows-in-dock _ (= true))
  (prop + document-types (list DocumentType))
  (prop + exported-types (list ExportedType))
  (prop + imported-types (list ImportedType))
  (fn-do + (infix this += (param document-type DocumentType)) _
    (+= document-types document-type)
  )
  (fn-do + (infix this += (param exported-type ExportedType)) _
    (+= exported-types exported-type)
  )
  (fn-do + (infix this += (param imported-type ImportedType)) _
    (+= imported-types imported-type)
  )
)

(type + MacExtension
  (implements Product)
  (prop + id String)
  (prop + name String)
  (prop + version (? String))
  (prop + point String)
  (prop + principal-class String)
  (prop + supported-content-types (list String))
  (prop + sandbox _ (= true))
  (prop + exported-types (list ExportedType))
  (prop + imported-types (list ImportedType))
  (fn-do + (infix this += (param exported-type ExportedType)) _
    (+= exported-types exported-type)
  )
  (fn-do + (infix this += (param imported-type ImportedType)) _
    (+= imported-types imported-type)
  )
)

(type + DocumentType
  (prop + name String)
  (prop + extensions (list String))
  (prop + content-types (list String))
  (prop + rank (? String))
)

(type + ExportedType
  (prop + id String)
  (prop + description String)
  (prop + conforms-to (list String))
  (prop + extensions (list String))
)

(type + ImportedType
  (prop + id String)
  (prop + description String)
  (prop + conforms-to (list String))
  (prop + extensions (list String))
)
