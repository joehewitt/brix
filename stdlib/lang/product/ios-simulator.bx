(import ./bundle-files)
(import /data/json)
(import /os/path)
(import /stream/sort)
(blank)
(prop _ xcrun _ (= "/usr/bin/xcrun"))
(prop _ open _ (= "/usr/bin/open"))
(prop _ ios-runtime-prefix _ (= "com.apple.CoreSimulator.SimRuntime.iOS-"))

(type + IOSSimulator (is Tuple)
  (prop + udid String)
  (prop + name String)
  (prop + runtime String)
  (prop + is-booted Bool)
  (prop + last-booted String)
  (prop + is-ipad Bool)
  (fn-expr + detail String :get
    (if-expr is-booted (str runtime " · Booted") runtime)
  )
)

(fn-do + chosen-simulator String (?! Error)
  (param named (? String))
  (let listed (call ios-simulators))
  (throw (call Error "No iOS simulator is available; add one in Xcode") (if (== (. listed length) 0)))
  (if (not named)
    (return (call ready ([] listed 0)))
  )
  (for (in simulator listed)
    (if (or (== (. simulator udid) named) (== (. simulator name) named))
      (return (call ready simulator))
    )
  )
  (throw (call Error (str "No available iOS simulator is named " named)))
)

(fn-do + ios-simulators (list IOSSimulator) (?! Error)
  (let text (call tool-output xcrun (list "simctl" "list" "devices" "--json")))
  (throw (call Error "simctl could not list the iOS simulators") (if (not text)))
  (let found (list IOSSimulator))
  (let runtimes (call json-field "devices" (call JSON text)))
  (if (and runtimes (is runtimes (map String JSON)))
    (for (in (tuple runtime devices) (as runtimes (map String JSON)))
      (if (call (. runtime starts-with) ios-runtime-prefix)
        (let version (call (. "." join) (call (. ([] runtime (... (. ios-runtime-prefix length))) split) "-")))
        (for (in device (call json-items devices))
          (if (call json-flag "isAvailable" device)
            (+= found
              (call IOSSimulator
                (block
                  (arg (call json-text "udid" device))
                  (arg (call json-text "name" device))
                  (arg (str "iOS " version))
                  (arg (== (call json-text "state" device) "Booted"))
                  (arg (call json-text "lastBootedAt" device))
                  (arg (!= (call (. (call json-text "deviceTypeIdentifier" device) find) "iPad") null))
                )
              )
            )
          )
        )
      )
    )
  )
  (return (call sort found (:using (=> (a b) (call compare-simulators a b)))))
)

(fn-do + install-simulator-app _ (?! Error)
  (param simulator String)
  (param bundle Path)
  (call run-tool xcrun (list "simctl" "install" simulator (as bundle String)))
)

(fn-expr + simulator-launch-command (list String)
  (param simulator String)
  (param app-id String)
  (list xcrun "simctl" "launch" "--console-pty" "--terminate-running-process" simulator app-id)
)

(fn-expr + simulator-spawn-command (list String)
  (param simulator String)
  (param executable Path)
  (list xcrun "simctl" "spawn" simulator (as (. executable resolved) String))
)

(fn-do _ ready String (?! Error)
  (param simulator IOSSimulator)
  (return-if (. simulator udid) (if (. simulator is-booted)))
  (call run-tool xcrun (list "simctl" "bootstatus" (. simulator udid) "-b"))
  (call run-tool open (list "-a" "Simulator"))
  (return (. simulator udid))
)

(fn-expr _ compare-simulators Comparison
  (param a IOSSimulator)
  (param b IOSSimulator)
  (case? (!= (. a is-booted) (. b is-booted))
    (if-expr (. a is-booted) .lesser .greater)
  )
  (case? (!= (. a last-booted) (. b last-booted))
    (if-expr (> (. a last-booted) (. b last-booted)) .lesser .greater)
  )
  (case? (!= (. a is-ipad) (. b is-ipad))
    (if-expr (. a is-ipad) .lesser .greater)
  )
  (default
    .equal
  )
)

(fn-expr _ json-flag Bool
  (param name String)
  (param object (? JSON))
  (and (!= value null) (is value Bool) (as value Bool))
  (where
    (lazy value (call json-field name object))
  )
)
