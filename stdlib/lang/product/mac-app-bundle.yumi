./bundle-files
/lang/backend/mir-text
/lang/emit/products
/os/file
/os/path

_ lsregister = "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
_ sips = "/usr/bin/sips"
_ iconutil = "/usr/bin/iconutil"
_ icon-points [Int] = [16, 32, 128, 256, 512]

━━━━━━━━━━━━━━━━━━━━
+ MacAppBundle is Tuple

+ path Path
+ executable Path

━━━━━━━━━━━━━━━━━━━━
+ do write-mac-app-bundle MacAppBundle ?! Error
    - product AppProduct
    - executable Path
    - claims-documents Bool

. bundle = executable.dir / "${product.name}.app"
?! Error("-o $executable is where the app bundle goes; give the executable another name")
    if (bundle as String) == (executable as String)
. contents = bundle / "Contents"
. info = contents / "Info.plist"
. macos = contents / "MacOS"
. inner = macos / product.name
. resources = contents / "Resources"
. icon = resources / "AppIcon.icns"
. signature = contents / "_CodeSignature"
. kept [String] = [contents as String, info as String, macos as String, inner as String, signature as String, (signature / "CodeResources") as String]
if product.icon
    kept += resources as String
    kept += icon as String
make-directories(macos)
prune(bundle, kept)
. source = icon-source(Path("${executable}.icons"), product.icon)
. changed = false
if source
    make-directories(resources)
    changed = install-file(source, icon)
if write-if-changed(info, info-plist(product, claims-documents))
    changed = true
if inner.exists
    inner.delete()
executable.clone(inner)
sign(bundle)
if changed
    register(bundle)
= MacAppBundle(bundle, inner)

━━━━━━━━━━━━━━━━━━━━
_ ¶ info-plist
    - product AppProduct
    - claims-documents Bool

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
$document-types\
    <key>CFBundleExecutable</key>
    ${plist-string(product.name)}
$icon\
    <key>CFBundleIdentifier</key>
    ${plist-string(product.id)}
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    ${plist-string(product.name)}
    <key>CFBundlePackageType</key>
    <string>APPL</string>
$version\
$agent\
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>

════════════════════
.. document-types = if claims-documents && product.document-types then "$document-entries\n" else ""
.. document-entries = document-types-plist(product.document-types)
.. icon = if product.icon then "${icon-plist()}\n" else ""
.. version = if product.version then "${version-plist(product.version)}\n" else ""
.. agent = if product.shows-in-dock then "" else "${agent-plist()}\n"

━━━━━━━━━━━━━━━━━━━━
_ ¶ document-types-plist
    - document-types [AppDocumentType]

    <key>CFBundleDocumentTypes</key>
    <array>
$entries
    </array>

════════════════════
.. entries = "\n".join(document-type-plist(each) in document-types)

━━━━━━━━━━━━━━━━━━━━
_ ¶ document-type-plist
    - document-type AppDocumentType

        <dict>
$extensions\
            <key>CFBundleTypeName</key>
            ${plist-string(document-type.name)}
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
$rank\
$content-types\
        </dict>

════════════════════
.. extensions = plist-key-array("CFBundleTypeExtensions", document-type.extensions)
.. content-types = plist-key-array("LSItemContentTypes", document-type.content-types)
.. rank = if document-type.rank then "${document-rank-plist(document-type.rank)}\n" else ""

━━━━━━━━━━━━━━━━━━━━
_ plist-key-array String
    - key String
    - values [String]

if values.length == 0 then "" else "$header\n$items\n            </array>\n"

.. header = "            <key>$key</key>\n            <array>"
.. items = "\n".join("                ${plist-string(each)}" in values)

━━━━━━━━━━━━━━━━━━━━
_ ¶ document-rank-plist
    - rank String

            <key>LSHandlerRank</key>
            ${plist-string(rank[0 .. < 1].uppercased + rank[1 ...])}

━━━━━━━━━━━━━━━━━━━━
_ ¶ icon-plist

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

━━━━━━━━━━━━━━━━━━━━
_ ¶ version-plist
    - version String

    <key>CFBundleShortVersionString</key>
    ${plist-string(version)}
    <key>CFBundleVersion</key>
    ${plist-string(version)}

━━━━━━━━━━━━━━━━━━━━
_ ¶ agent-plist

    <key>LSUIElement</key>
    <true/>

━━━━━━━━━━━━━━━━━━━━
_ do icon-source Path? ?! Error
    - cache Path
    - icon Path?

if !icon || icon.ext != "png"
    if cache.is-dir
        remove-tree(cache, PathKind.directory)
    = icon
. bytes = read-file-bytes(icon)
. hex String = fnv-hash(bytes.data, bytes.length) as Hex
. name = hex[2 ...]
. converted = cache / "${name}.icns"
make-directories(cache)
prune(cache, [converted as String])
if !converted.is-file
    convert-icon(icon, cache, name)
= converted

━━━━━━━━━━━━━━━━━━━━
_ do convert-icon ?! Error
    - source Path
    - cache Path
    - name String

. iconset = cache / "${name}.iconset"
. partial = cache / "${name}.partial.icns"
make-directories(iconset)
for points in icon-points
    render-icon(source, iconset / "icon_${points}x${points}.png", points)
    render-icon(source, iconset / "icon_${points}x${points}@2x.png", points * 2)
run-tool(iconutil, ["-c", "icns", iconset as String, "-o", partial as String])
partial.move(cache / "${name}.icns")
remove-tree(iconset, PathKind.directory)

━━━━━━━━━━━━━━━━━━━━
_ do render-icon ?! Error
    - source Path
    - target Path
    - pixels Int

run-tool(sips, ["-s", "format", "png", "-z", "$pixels", "$pixels", source as String, "--out", target as String])

━━━━━━━━━━━━━━━━━━━━
_ do install-file Bool ?! Error
    - source Path
    - target Path

if target.is-file && same-bytes(read-file-bytes(source), read-file-bytes(target))
    = false
if target.exists
    target.delete()
source.copy(target)
= true

━━━━━━━━━━━━━━━━━━━━
_ do same-bytes Bool
    - first Byte[]
    - second Byte[]

if first.length != second.length
    = false
for index in 0 .. < first.length
    if first[index] != second[index]
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do register ?! Error
    - bundle Path

run-tool(lsregister, ["-f", bundle as String])
