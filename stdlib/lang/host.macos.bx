(import /os/path)
(import /os/process)
(blank)
(prop + host-target-name _ (= "macos"))

(fn-do + apple-sdk-path Path (?! Error)
  (param sdk (? String))
  ; The path of an Apple SDK, by its `xcrun` name, or of the default SDK when the name is null.
  (let arguments (list String))
  (if sdk
    (+= arguments "--sdk")
    (+= arguments sdk)
  )
  (+= arguments "--show-sdk-path")
  (let process (call Process "/usr/bin/xcrun" arguments))
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (throw (call Error (str "xcrun " (call (. " " join) arguments) " failed with status " status)) (if (or (!= status 0) (== (call (. output trim)) ""))))
  (return (call Path (call (. output trim))))
)

(fn-do + apple-linker-path String (?! Error)
  (let process (call Process "/usr/bin/xcrun" "--find" "ld"))
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (throw (call Error (str "xcrun --find ld failed with status " status)) (if (or (!= status 0) (== (call (. output trim)) ""))))
  (return (call (. output trim)))
)
