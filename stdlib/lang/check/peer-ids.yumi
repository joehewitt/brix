./binding
./instances
./stable-key
./type-store
./types
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ PeerIds

` What the ids another type pass over the same program gave its types, instances, properties,
` style contexts, bindings and their slots stand for in this pass, which interns each
` here the first time it is asked for. The peer `owns` an instance whose body it typed where no pass before it
` did: this pass takes what is known of that instance from the peer. Each id is checked against
` the stable key the peer gave it, so one that stands for something else here stops the compile.
` `calls` and `transforms` number here the peer's call and transform facts this pass takes in.

+ types Types
+ instances Instances
+ bindings Bindings
+ peer-types Types
+ peer-instances Instances
+ peer-bindings Bindings
+ owned [Bool]
+ calls [U32]
+ transforms [U32]
_ type-map [U32]
_ instance-map [U32]
_ binding-map [U32]
_ context-map [U32]
_ frame-map [U32]
_ property-owners [TypeId]

────────────────────
+ This
    - types Types
    - instances Instances
    - bindings Bindings
    - peer-types Types
    - peer-instances Instances
    - peer-bindings Bindings
    - owned [Bool]

for _ in 0 .. < peer-types.rows.length
    type-map += 0
for _ in 0 .. < peer-instances.rows.length
    instance-map += 0
for _ in 0 .. < peer-bindings.bindings.length
    binding-map += 0

────────────────────
+ owns Bool
    - instance InstanceId

` Whether this pass takes what is known of a peer's instance from the peer.
instance != no-instance && owned[instance]

────────────────────
+ do type TypeId
    - id TypeId

` The type here that is the peer's `id`.
if id == no-type || id == invalid-type
    = id
. known = type-map[id]
if known != 0
    = known - 1
. made = make-type(id)
?! Panic("A type of another type pass is another type here")
    if types.stable-keys[made] != peer-types.stable-keys[id]
type-map[id] = made + 1
= made

────────────────────
_ do make-type TypeId
    - id TypeId

. stack = types.scratch.types
do match peer-types.rows[id]
    | .type-invalid
        = invalid-type
    | .type-class(row)
        . mark = stack.mark
        push-range(row.args)
        . errors-mark = stack.mark
        push-range(row.errors)
        = types.intern-raising-class(row.module, row.decl, mark, errors-mark)
    | .type-variable(row)
        = types.intern-variable(row.module, row.decl, row.index, row.name)
    | .type-inference(row)
        = types.intern-inference(row.scope, row.ordinal)
    | .type-tuple(row)
        . mark = stack.mark
        . names-mark = types.scratch.names.mark
        push-fields(row.fields, row.names)
        = types.intern-tuple(mark, names-mark)
    | .type-struct(row)
        . mark = stack.mark
        . names-mark = types.scratch.names.mark
        push-fields(row.fields, row.names)
        = types.intern-struct(mark, names-mark)
    | .type-union(row)
        . mark = stack.mark
        push-range(row.cases)
        = types.intern-union(mark)
    | .type-named-union(row)
        . mark = stack.mark
        . names-mark = types.scratch.names.mark
        push-fields(row.cases, row.names)
        = types.intern-named-union(row.owner, mark, names-mark, row.made-in, row.made-at)
    | .type-function(row)
        . returns = type(row.return-type)
        . mark = stack.mark
        push-range(row.args)
        . errors-mark = stack.mark
        push-range(row.errors)
        = types.intern-function(returns, row.is-c, mark, errors-mark)
    | .type-result(row)
        . value = type(row.value)
        . mark = stack.mark
        push-range(row.errors)
        = types.intern-ordered-result(value, mark)
    | .type-associated(row)
        . owner = type(row.owner)
        . mark = stack.mark
        push-range(row.args)
        = types.intern-associated(owner, DeclRef(row.module, row.decl), row.name, mark)
    | .type-closure(row)
        . enclosing = instance(row.enclosing)
        = types.intern-closure(row.module, row.decl, enclosing, instances.stable-keys[enclosing])
    | .type-binding(row)
        . object = type(row.object)
        . mark = stack.mark
        push-range(row.items)
        = types.intern-binding
            - row.form
            - row.scope
            - row.module
            - row.decl
            - object
            - row.param-count
            - mark

────────────────────
_ do push-range
    - range RowRange'TypeId

for offset in 0 .. < range.count
    . child = type(peer-types.child-type(range, offset))
    types.scratch.types.push(child)

────────────────────
_ do push-fields
    - fields RowRange'TypeId
    - names RowRange'Atom

for offset in 0 .. < fields.count
    . child = type(peer-types.child-type(fields, offset))
    types.scratch.names.push(peer-types.child-name(names, offset))
    types.scratch.types.push(child)

────────────────────
+ do instance InstanceId
    - id InstanceId

` The instance here that is the peer's `id`, queued here where the peer queued it, unless it is
` typed only in the run of another (`runs-inline`). The value of a property made here is given
` the type the read that first asked for it there stated for it, as a read here would.
if id == no-instance
    = id
. known = instance-map[id]
if known != 0
    = known - 1
. made = make-instance(id)
?! Panic("An instance of another type pass is another instance here")
    if instances.stable-keys[made] != peer-instances.stable-keys[id]
. row = peer-instances.rows[id]
if row.queued && !runs-inline(row)
    instances.queue(made)
instance-map[id] = made + 1
= made

────────────────────
_ do make-instance InstanceId
    - id InstanceId

. row = peer-instances.rows[id]
?! Panic("An instance typed on trial cannot be shared between type passes")
    if row.probe != 0
. styled = style-context(row.context)
if row.root-values != 0
    = instances.intern-root-values(row.module, type(row.self-type), row.root-values, styled)
if row.initializer != 0
    . value = instances.intern-initializer
        - row.module
        - row.initializer
        - type(row.self-type)
        - type(row.element)
        - styled
    if instances.rows[value].state == .instance-unstarted
        instances.signatures[value].declared-returns = type
            - peer-instances.signatures[id].declared-returns
    = value
if row.compares
    = instances.intern-equality(row.module, type(row.self-type))
. self-type = type(row.self-type)
. enclosing = instance(row.enclosing)
. row-receiver = type(row.row-receiver)
. helper = type(row.helper)
. inherits = instance(row.inherits)
. signature = peer-instances.signatures[id]
. stack = types.scratch.types
. mark = stack.mark
for position in signature.args.start - signature.param-count .. < signature.args.start + signature.args.count
    . translated = type(peer-instances.signature-types[position])
    stack.push(translated)
. params = stack.span(mark, signature.param-count)
. args = stack.span(mark + signature.param-count, signature.args.count)
. words = types.scratch.words
. fills-mark = words.mark
for offset in 0 .. < row.fills.count
    . place = property(peer-instances.fill-places[row.fills.start + offset])
    words.push(place)
. fills = words.since(fills-mark)
. slots-mark = words.mark
for offset in 0 .. < row.slots.count
    . slot = peer-instances.slot-places[row.slots.start + offset]
    words.push(instances.slot-id(peer-instances.slot-atoms[slot]))
. slots = words.since(slots-mark)
. made = instances.intern
    - row.module
    - row.decl
    - self-type
    - row.effects
    - enclosing
    - params
    - args
    - false
    - row-receiver
    - row.row-case
    - row.row-validated
    - 0
    - helper
    - fills
    - slots
    - styled
    - row.zone
    - inherits
    - row.redefaults
    - row.spans
    - row.encoded
words.rewind(fills-mark)
stack.rewind(mark)
= made

────────────────────
+ do style-context U32
    - id U32

` The style context here that is the peer's context `id`: the same styles, style sheets and rules
` written in rules, in their order, with what each is given (`Instances.intern-context`).
if id == U32.max
    = id
while context-map.length <= id
    context-map += 0
. known = context-map[id]
if known != 0
    = known - 1
. given = peer-instances
. held = given.contexts[id]
. styles [TypeId]
. sheets [TypeId]
. levels [U32]
for position in held.first .. < held.first + held.styles
    styles += type(given.context-types[position])
for position in held.first + held.styles .. < held.first + held.styles + held.sheets
    sheets += type(given.context-types[position])
    levels += given.context-levels[position]
. scopes [RuleScope]
. cells [U32]
. valued [U32]
for position in held.scope-first .. < held.scope-first + held.scopes
    . scope = given.context-scopes[position]
    scopes += RuleScope(scope.module, scope.decl, type(scope.owner), frame(scope.frames), scope.own)
    cells += given.context-cells[position]
    valued += given.context-valued[position]
. value-types [TypeId]
for position in held.value-first .. < held.value-first + held.values
    value-types += type(given.context-value-types[position])
. made = instances.intern-context
    - styles
    - sheets
    - levels
    - scopes
    - cells
    - type(held.made)
    - held.layer
    - valued
    - value-types
context-map[id] = made + 1
= made

────────────────────
+ do frame U32
    - id U32

` The frame here of the style rule the peer's frame `id` applies, and of those around it.
if id == U32.max
    = id
while frame-map.length <= id
    frame-map += 0
. known = frame-map[id]
if known != 0
    = known - 1
. held = peer-instances.frames[id]
. made = instances.intern-frame
    - frame(held.outer)
    - held.module
    - held.decl
    - type(held.owner)
    - held.gate
frame-map[id] = made + 1
= made

────────────────────
+ do property U32
    - place U32

` The place here of the property at a peer's `place` among the properties of every type.
if place == U32.max
    = place
. owner = property-owner(place)
. master = type(owner)
types.complete(master)
. offset = place - peer-types.completions[owner].properties.start
. found = types.completions[master].properties.start + offset
?! Panic("A property of another type pass is another property here")
    if types.properties[found].name != peer-types.properties[place].name
= found

────────────────────
_ do property-owner TypeId
    - place U32

if property-owners.length == 0
    for _ in 0 .. < peer-types.properties.length
        property-owners += no-type
    for id in 0 .. < peer-types.completions.length
        . range = peer-types.completions[id].properties
        for offset in 0 .. < range.count
            property-owners[range.start + offset] = id as TypeId
. owner = property-owners[place]
?! Panic("A property of another type pass belongs to no type there")
    if owner == no-type
= owner

────────────────────
+ do binding BindingId
    - id BindingId

` The binding here of the declaration the peer's binding `id` binds, copied from the peer first
` (`Bindings.take`).
if id == no-binding
    = id
. known = binding-map[id]
if known != 0
    = known - 1
. made = bindings.take(peer-bindings, id)
binding-map[id] = made + 1
= made

────────────────────
+ do slot SlotId
    - id SlotId

` The slot here that is the peer's slot `id`, among the slots of the binding that declares it.
if id == no-slot
    = id
. low U32
. high U32 = peer-bindings.bindings.length as U32
while high - low > 1
    . middle = low + (high - low) / 2
    if peer-bindings.bindings[middle].slots.start <= id
        low = middle
    else
        high = middle
. peer = peer-bindings.bindings[low]
?! Panic("A slot of another type pass belongs to none of its bindings")
    if id < peer.slots.start || id >= peer.slots.start + peer.slots.count
. found = bindings.bindings[binding(low)].slots.start + id - peer.slots.start
?! Panic("A slot of another type pass is another slot here")
    if bindings.slots[found].name != peer-bindings.slots[id].name || bindings.slots[found].syntax != peer-bindings.slots[id].syntax
= found

━━━━━━━━━━━━━━━━━━━━
+ PeerNames

` Which of the types and instances of another type pass this pass can name: none typed on trial,
` nor any that names one through what it is made of, as a closure names the instance it is written
` in, or a style context the types it holds. Each is worked out the first time it is asked for.

_ types Types
_ instances Instances
_ type-states [U8]
_ instance-states [U8]

────────────────────
+ This
    - types Types
    - instances Instances

for _ in 0 .. < types.rows.length
    type-states += 0
for _ in 0 .. < instances.rows.length
    instance-states += 0

────────────────────
+ do type-named Bool
    - id TypeId

` Whether this pass can name the type. One met again while its parts are being looked at is
` taken to be.
if id == no-type || id == invalid-type
    = true
. state = type-states[id]
if state != 0
    = state != 2
type-states[id] = 1
. named = parts-named(id)
type-states[id] = if named then 1 else 2
= named

────────────────────
+ do instance-named Bool
    - id InstanceId

` Whether this pass can name the instance.
if id == no-instance
    = true
. state = instance-states[id]
if state != 0
    = state != 2
instance-states[id] = 1
. named = instance-parts-named(id)
instance-states[id] = if named then 1 else 2
= named

────────────────────
_ do parts-named Bool
    - id TypeId

do match? types.rows[id]
    | .type-class(row)
        = range-named(row.args) && range-named(row.errors)
    | .type-tuple(row)
        = range-named(row.fields)
    | .type-struct(row)
        = range-named(row.fields)
    | .type-union(row)
        = range-named(row.cases)
    | .type-named-union(row)
        = range-named(row.cases)
    | .type-function(row)
        = type-named(row.return-type) && range-named(row.args) && range-named(row.errors)
    | .type-result(row)
        = type-named(row.value) && range-named(row.errors)
    | .type-associated(row)
        = type-named(row.owner) && range-named(row.args)
    | .type-closure(row)
        = instance-named(row.enclosing)
    | .type-binding(row)
        = type-named(row.object) && range-named(row.items)
= true

────────────────────
_ do range-named Bool
    - range RowRange'TypeId

for offset in 0 .. < range.count
    if !type-named(types.child-type(range, offset))
        = false
= true

────────────────────
_ do instance-parts-named Bool
    - id InstanceId

. row = instances.rows[id]
if row.probe != 0 || !context-named(row.context)
    = false
if !type-named(row.self-type) || !type-named(row.element) || !type-named(row.row-receiver) || !type-named(row.helper)
    = false
if !instance-named(row.enclosing) || !instance-named(row.inherits)
    = false
. signature = instances.signatures[id]
for position in signature.args.start - signature.param-count .. < signature.args.start + signature.args.count
    if !type-named(instances.signature-types[position])
        = false
= true

────────────────────
_ do context-named Bool
    - id U32

if id == U32.max
    = true
. held = instances.contexts[id]
for position in held.first .. < held.first + held.styles + held.sheets
    if !type-named(instances.context-types[position])
        = false
for position in held.scope-first .. < held.scope-first + held.scopes
    . scope = instances.context-scopes[position]
    if !type-named(scope.owner)
        = false
    . frame = scope.frames
    while frame != U32.max
        if !type-named(instances.frames[frame].owner)
            = false
        frame = instances.frames[frame].outer
for position in held.value-first .. < held.value-first + held.values
    if !type-named(instances.context-value-types[position])
        = false
= type-named(held.made)
