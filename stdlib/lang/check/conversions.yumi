_ deepest-parts U32 = 64

━━━━━━━━━━━━━━━━━━━━
+ Conversions

+ frame Frame
+ host Demander? = null
+ fitter CallableFitter? = null
+ unsuffixed SyntaxId
_ types Types
_ instances Instances
_ relations Relations
_ facts Facts
