(import /stream/sort)

(type _ CursorBinding (is Tuple)
  ; The row cursor a pattern binds (`check-pattern`): whether it binds one, and the row it captures.
  (blank)
  (prop + binds Bool)
  (prop + capture RowCapture (= (call RowCapture no-type (. U32 max) false)))
)

(type _ MatchArms (facet-of Checker)
  (sees Streams)
  (sees Tables)
  (prop _ cursor-binding _ (= (call CursorBinding)))
  (fn-do _ arm-symbol TypeId
    (param expr SyntaxId)
    (param symbol Atom)
    (for (in position (..< (. arming start) (. scratch types length)))
      (let noted ([] (. scratch types) position))
      (if (and (!= noted no-type) (!= noted invalid-type) (call enum-case-decl types program noted symbol))
        (call note-enum-case noted symbol expr)
        (call (. facts set-node-type) instance expr noted)
        (return noted)
      )
    )
    (return no-type)
  )
  (fn-do _ note-switch _
    (param pattern SyntaxId)
    (param subject TypeId)
    (let arms (list SyntaxId))
    (if (not (call gather-switch-arms pattern arms))
      (return)
    )
    (let kind (call (. types intrinsic-of) subject))
    (let cases (or (== kind .union) (== kind .table-row) (== kind .immutable-table-row)))
    (if (and (not cases) (not (call is-integer-kind kind)))
      (return)
    )
    (let tested U32)
    (for (in position (..< 0 (. arms length)))
      (let arm ([] arms position))
      (if (== (call (. facts plan-of) instance arm) .plan-never)
        (return)
      )
      (match? ([] (. tree nodes) arm)
        (case (call .node-type-transform row)
          (if (or (== (. row pattern) 0) (is ([] (. tree nodes) (. row pattern)) .node-type-wildcard))
            (if (!= position (- (. arms length) 1))
              (return)
            )
            (continue)
          )
          (if (and cases (not (call names-switch-case (. row pattern))))
            (return)
          )
          (if (and (not cases) (not (call names-switch-number (. row pattern) subject)))
            (return)
          )
          (+= tested 1)
        )
      )
    )
    (if (< tested 2)
      (return)
    )
    (call (. facts set-constant)
      (block
        (arg instance)
        (arg pattern)
        (arg (call ConstantFact (if-expr cases 1 2) 0.0 null false))
        (arg .plan-switch)
      )
    )
  )
  (fn-do _ gather-switch-arms Bool
    (param pattern SyntaxId)
    (param arms (list SyntaxId))
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (return (and (call gather-switch-arms (. row left) arms) (call gather-switch-arms (. row right) arms)))
      )
      (case (call .node-type-transform row)
        (if (and (!= (. row pattern) 0) (is ([] (. tree nodes) (. row pattern)) .node-type-or))
          (return false)
        )
        (+= arms pattern)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ names-switch-case Bool
    (param pattern SyntaxId)
    (case? (or (!= (call (. facts plan-of) instance pattern) .plan-case) (== (call (. facts constant-of) instance pattern) no-fact))
      false
    )
    (default
      (is ([] (. tree nodes) pattern) .node-type-case)
    )
  )
  (fn-do _ names-switch-number Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-equality row)
        (if (or (. row is-contextual) (. ([] (. types completions) subject) has-equalities))
          (return false)
        )
        (match? ([] (. tree nodes) (. row expr))
          (case (call .node-integer-syntax literal)
            (if (. literal unit)
              (return false)
            )
            (let parsed (call parse-integer-literal (. literal value)))
            (return (and (not (. parsed negative)) (call literal-fits-target types parsed subject)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + infer-match TypeId
    (param id SyntaxId)
    (param subject-syntax SyntaxId)
    (param body SyntaxId)
    (param is-optional Bool)
    (param helper SyntaxId)
    (param is-block Bool)
    (param want Want (= (call Want)))
    (let expected arms-expected)
    (= arms-expected no-type)
    (let subject no-type)
    (if (!= subject-syntax 0)
      (= subject (call infer-unprojected subject-syntax))
    )
    (let saved-helper helping)
    (= helping (= (. helping helper) null))
    (= helping (= (. helping site) 0))
    (= helping (= (. helping rolls) false))
    (= helping (= (. helping explicit) false))
    (= helping (= (. helping body) 0))
    (if (and (!= helper 0) (not (call type-helper helper)))
      (= helping saved-helper)
      (return invalid-type)
    )
    (let own-matching matching)
    (= matching (= (. matching rows) (and (!= subject-syntax 0) (call reads-row subject-syntax))))
    (if (. matching rows)
      (call (. facts mark-checked-row) instance subject-syntax)
    )
    (= matching (= (. matching subject) subject))
    (= arms-expected expected)
    (= matching (= (. matching optional) is-optional))
    (= matching (= (. matching open) (== tested-match id)))
    (= tested-match 0)
    (= matching (= (. matching closed) (if-expr (and is-block (not is-optional) (!= subject-syntax 0)) body 0)))
    (= matching (= (. matching arms) (if-expr (and is-block (!= subject-syntax 0)) body 0)))
    (let saved-stream rule-streaming)
    (= matching (= (. matching case) subject-syntax))
    (= rule-streaming (= (. rule-streaming matched) 0))
    (if (and (!= subject-syntax 0) (!= (call (. tree stream-statement) body) 0))
      (= rule-streaming (= (. rule-streaming matched) (call (. tree stream-statement) body)))
      (= helping (= (. helping body) (. rule-streaming matched)))
      (let subject-slot (call arm-slot id .slot-it))
      (if (and (!= subject-slot no-slot) (!= subject no-type) (!= subject invalid-type))
        (call (. frame assign) subject-slot subject)
      )
    )
    (let result
      (call check-statement
        (block
          (arg body)
          (arg (if-expr (call (. want asks) .want-match-statement) (call (. (call Want) adding) .want-match-statement) (call Want)))
        )
      )
    )
    (if (and (!= result invalid-type) (. helping rolls) (== (. (!! (. helping helper)) rollback) no-type))
      (call (. frame diagnose)
        (block
          (arg (if-expr (!= (. rule-streaming matched) 0) (. rule-streaming matched) id))
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg "Pattern @rollback helper must implement PatternRollback with a concrete Mark type")
              )
            )
          )
        )
      )
      (= result invalid-type)
    )
    (= rule-streaming saved-stream)
    (= helping saved-helper)
    (= matching own-matching)
    (= arms-expected no-type)
    (if (and (!= expected no-type) (not is-optional))
      (let recorded (call (. facts node-type) instance body))
      (if (and (not (call (. types is-optional) expected)) (== recorded (call (. types optional-of) expected)))
        (call (. facts replace-node-type) instance id recorded)
        (else-if (!= recorded no-type)
          (call (. facts set-node-type) instance id recorded)
        )
      )
    )
    (if (== result no-type)
      (return invalid-type)
    )
    (if (and is-optional (!= arms-given no-type))
      (= arms-given (call (. types optional-of) arms-given))
    )
    (return (if-expr is-optional (call (. types optional-of) result) result))
  )
  (fn-do + infer-arms TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param want Want (= (call Want)))
    ; The type a match's arms give, joined, each arm checked against the subject. A match written
    ; as a statement is one for its own arms alone, and runs them as steps, so a match standing as
    ; a step in one of them is a statement too. Arms of conditions alone with no else,
    ; where a type is expected that is no optional, give an optional of it, as the reference's do,
    ; which whatever expects it converts. An integer an arm gives written with no suffix takes the
    ; type expected, or with none expected, the type of the first arm that gives one written with one.
    (let expected arms-expected)
    (= arms-expected no-type)
    (let subject (. matching subject))
    (let as-statement (call (. want asks) .want-match-statement))
    (let own-arming arming)
    (let arms-mark (. scratch types mark))
    (= arming
      (call Arming
        (block
          (arg as-statement)
          (arg arms-mark)
          (arg expected)
          (arg false)
          (arg (. arming union))
          (arg 0)
          (arg (call (. tree is-alternative) pattern))
          (arg no-slot)
          (arg 0)
        )
      )
    )
    (let narrow-mark (. scratch narrowings mark))
    (let first-arm (. arm-bodies length))
    (let first-value (. arm-values length))
    (let first-settled (. arm-settled length))
    (let first-raised (. raised-arms length))
    (if (and (!= (. matching arms) 0) (call closes (. matching arms) id))
      (call check-arm-reach pattern subject true)
    )
    (let has-else (call collect-arms pattern subject))
    (let possible (. arming possible))
    (let unites (and (. arming unite) (== expected no-type)))
    (let union-start (. arming union))
    (= arming own-arming)
    (if (and (!= (. matching closed) 0) (call closes (. matching closed) id))
      (call check-coverage id pattern subject)
    )
    (call (. frame pop-narrowing) narrow-mark)
    (if (and as-statement (not (. matching optional)))
      (call merge-arms first-arm)
    )
    (if (and as-statement (call stays-present first-arm))
      (call (. narrowing narrow-condition) (. matching case) true)
    )
    (let own-settled (list Narrowed))
    (for (in position (..< first-settled (. arm-settled length)))
      (+= own-settled ([] arm-settled position))
    )
    (-= ([] arm-settled (..< first-settled (. arm-settled length))))
    (call widen-settled own-settled)
    (-= ([] arm-bodies (..< first-arm (. arm-bodies length))))
    (-= ([] arm-present (..< first-arm (. arm-present length))))
    (-= ([] arm-starts (..< first-arm (. arm-starts length))))
    (-= ([] arm-ends (..< first-arm (. arm-ends length))))
    (let closed (and (!= (. matching closed) 0) (call closes (. matching closed) id)))
    (let absent
      (scope (and (!= subject no-type) (not (. matching optional)) (not (. matching open)) (not closed) conditional)
        (lazy conditional (call is-conditional pattern))
      )
    )
    (if (and absent (!= expected no-type) (not (call (. types is-optional) expected)))
      (call decline id)
    )
    (if (and (not has-else) (!= subject no-type) (not (. matching optional)) (. matching open))
      (call (. facts set-plan) instance id .plan-open)
      (else-if (and (not has-else) absent)
        (call (. facts set-plan) instance id .plan-unmatched-absent)
      )
      (else-if (and (not has-else) (!= subject no-type) (not (. matching optional)))
        (call (. instances mark-may-panic) instance)
        (call (. facts set-plan) instance id .plan-unmatched)
      )
    )
    (if (and (!= subject no-type) (!= subject invalid-type))
      (call note-switch pattern subject)
    )
    (let arms (call (. scratch types since) arms-mark))
    (let values (list SyntaxId))
    (for (in position (..< first-value (. arm-values length)))
      (+= values ([] arm-values position))
    )
    (-= ([] arm-values (..< first-value (. arm-values length))))
    (let givens (list TypeId))
    (for (in position (..< first-value (. arm-givens length)))
      (+= givens ([] arm-givens position))
    )
    (-= ([] arm-givens (..< first-value (. arm-givens length))))
    (let valued (== (. values length) (. arms length)))
    (let typed (list TypeId))
    (let peer
      (scope (if-expr (not valued) no-type (if-expr (!= expected no-type) expected-inner written-peer))
        (lazy expected-inner (call (. types optional-inner) expected))
        (lazy written-peer (call arms-peer arms values))
      )
    )
    (for (in position (..< 0 (. arms length)))
      (+= typed (if-expr (!= peer no-type) (call (. conversions adapted-literal) ([] values position) ([] arms position) peer) ([] arms position)))
    )
    (let raises (call gives-errors arms expected))
    (if (and raises (== (. frame surround catch-depth) 0))
      (for (in position (..< first-raised (. raised-arms length)))
        (call (. facts set-plan) instance ([] raised-arms position) .plan-raise)
      )
    )
    (-= ([] raised-arms (..< first-raised (. raised-arms length))))
    (let errors (list TypeId))
    (let mark (. scratch types mark))
    (let has-null false)
    (for (in arm typed)
      (if (== arm (. types null-type))
        (= has-null true)
        (else-if (and raises (call raises-at-arm arm expected))
          (if (== (call (. errors find) arm) null)
            (+= errors arm)
          )
        )
        (else-if (!= arm invalid-type)
          (call (. scratch types push) arm)
        )
      )
    )
    (if (and (== (. scratch types length) mark) has-null)
      (call (. scratch types push) (. types null-type))
    )
    (if (and (== (. scratch types length) mark) (== possible 0) (. matching optional) optional-expected)
      (call (. scratch types push) expected)
    )
    (lazy optional-expected (and (!= expected no-type) (call (. types is-optional) expected)))
    (if (and (== (. scratch types length) mark) (!= (. errors length) 0))
      (call (. scratch types rewind) arms-mark)
      (if (!= (. frame surround catch-depth) 0)
        (let raised (. scratch types mark))
        (for (in error errors)
          (call (. scratch types push) error)
        )
        (return (call result-type types (. types void-type) raised))
      )
      (for (in error errors)
        (call note-outgoing error id)
      )
      (return (. types void-type))
    )
    (if (== (. scratch types length) mark)
      (call (. scratch types rewind) arms-mark)
      (if (== possible 0)
        (call (. frame diagnose) pattern .no-possible-matches)
      )
      (return invalid-type)
    )
    (let joined (call (. relations join-arms) mark))
    (if unites
      (let united (. scratch types mark))
      (for (in position (..< union-start mark))
        (let arm ([] (. scratch types) position))
        (if (and (!= arm (. types null-type)) (!= arm invalid-type))
          (call (. scratch types push) arm)
        )
      )
      (= joined (call (. types intern-union) united))
    )
    (call (. scratch types rewind) mark)
    (let result joined)
    (let lacks
      (scope (or null-joined absent (and (not has-else) (== subject no-type)))
        (lazy null-joined (and has-null (!= joined (. types null-type)) (not (call holds-null joined))))
      )
    )
    (if (!= expected no-type)
      (let given (call given-join typed givens joined raises expected))
      (= arms-given (if-expr lacks (call (. types optional-of) given) given))
      (= result expected)
      (let missed (and (not has-else) (== subject no-type) (!= expected (. types void-type))))
      (if (and missed (not (call (. types is-optional) expected)))
        (= result (call (. types optional-of) expected))
        (call (. facts replace-node-type) instance id result)
        (else
          (call (. facts set-node-type) instance id joined)
        )
      )
      (else-if lacks
        (= result (call (. types optional-of) joined))
      )
    )
    (let joins (not as-statement))
    (for (in position (..< 0 (. arms length)))
      (let arm ([] typed position))
      (if (and joins (!= arm result) (!= arm invalid-type) (not (and raises (call raises-at-arm arm expected))))
        (call (. conversions convert) id (if-expr valued ([] values position) 0) arm result .reason-join)
      )
    )
    (call (. scratch types rewind) arms-mark)
    (if (and raises (!= (. frame surround catch-depth) 0))
      (let raised (. scratch types mark))
      (for (in error errors)
        (call (. scratch types push) error)
      )
      (return (call result-type types result raised))
    )
    (for (in error errors)
      (call note-outgoing error id)
    )
    (return result)
  )
  (fn-do _ given-join TypeId
    (param typed (list TypeId))
    (param givens (list TypeId))
    (param joined TypeId)
    (param raises Bool)
    (param expected TypeId)
    (return-if joined (if (or (!= (. givens length) (. typed length)) (call all givens (:where (== each no-type))))))
    (let mark (. scratch types mark))
    (for (in position (..< 0 (. typed length)))
      (let arm ([] typed position))
      (if (or (== arm (. types null-type)) (== arm invalid-type) (and raises (call raises-at-arm arm expected)))
        (continue)
      )
      (call (. scratch types push) (if-expr (!= ([] givens position) no-type) ([] givens position) arm))
    )
    (let given (if-expr (== (. scratch types length) mark) joined (call (. relations join-arms) mark)))
    (call (. scratch types rewind) mark)
    (return given)
  )
  (fn-do + literal-peer TypeId
    (param types-start ScratchMark)
    (param syntax-start ScratchMark)
    (param count Size)
    ; The type integers written with no suffix take among values joined: that of the first value
    ; written with none, what it holds where it is an optional, or where each is written with none,
    ; that of the first float, or where each is a tuple, the tuple they join to place by place. Where
    ; no value is written with one there is none.
    (let peer no-type)
    (let float no-type)
    (let places no-type)
    (let plain false)
    (for (in offset (..< 0 count))
      (let syntax ([] (. scratch syntax) (+ syntax-start offset)))
      (let type ([] (. scratch types) (+ types-start offset)))
      (if (== (call (. conversions literal-of) syntax) 0)
        (if (== peer no-type)
          (= peer (call (. types optional-inner) type))
        )
        (else
          (= plain true)
          (if (and (== float no-type) (is ([] (. tree nodes) syntax) .node-float-syntax))
            (= float type)
          )
          (if (is ([] (. tree nodes) syntax) .node-tuple-syntax)
            (= places
              (block
                (case? (== offset 0)
                  type
                )
                (case? (!= places no-type)
                  (call (. relations joined-places) places type)
                )
                (default
                  no-type
                )
              )
            )
            (else
              (= places no-type)
            )
          )
        )
      )
    )
    (case? (not plain)
      (return no-type)
    )
    (case? (!= peer no-type)
      (return peer)
    )
    (case? (!= float no-type)
      (return float)
    )
    (default
      (return places)
    )
  )
  (fn-do _ arms-peer TypeId
    (param arms (of ImmutableArray TypeId ArenaBacking))
    (param values (list SyntaxId))
    ; The type integers written with no suffix take among the values of a match's arms: that of the
    ; first arm that gives a value written with none other than a text, what it holds where it is an
    ; optional, or where each is written with none, that of the first that gives a float.
    (let float no-type)
    (for (in position (..< 0 (. arms length)))
      (let arm ([] arms position))
      (if (and (!= arm (. types null-type)) (!= arm invalid-type) non-literal (not text))
        (return (call (. types optional-inner) arm))
      )
      (lazy non-literal (== (call (. conversions literal-of) ([] values position)) 0))
      (lazy text (== (call (. types optional-inner) arm) (. types string-type)))
      (if (and (== float no-type) (!= ([] values position) 0) float-written)
        (= float arm)
      )
      (lazy float-written (is ([] (. tree nodes) ([] values position)) .node-float-syntax))
    )
    (return float)
  )
  (fn-expr + holds-null Bool
    (param type TypeId)
    ; Whether a type is a union with a case that holds `null`, which a `null` joined with it becomes.
    (and (== (call (. types intrinsic-of) type) .union) (call (. relations unnamed-case-holds) type (. types null-type)))
  )
  (fn-do _ merge-arms _
    (param first Size)
    ; After a match statement, a local every arm that falls through leaves holding the same value
    ; holds it: the arms agree, as the reference's flow facts merge them. Only an arm's own
    ; statements count.
    (let lead (. Size max))
    (for (in arm (..< first (. arm-bodies length)))
      (if (and (== lead (. Size max)) (not (call (. narrowing exits) ([] arm-bodies arm))))
        (= lead arm)
      )
    )
    (if (== lead (. Size max))
      (return)
    )
    (for (in position (..< ([] arm-starts lead) ([] arm-ends lead)))
      (let slot ([] (. frame assigned-slots) position))
      (let settled (call arm-settles lead slot))
      (if (or (== settled no-type) (== settled (call slot-known slot)))
        (continue)
      )
      (let agreed true)
      (for (in arm (..< first (. arm-bodies length)))
        (if (and (not (call (. narrowing exits) ([] arm-bodies arm))) (!= (call arm-settles arm slot) settled))
          (= agreed false)
        )
      )
      (if agreed
        (call (. frame push-assigned) (call slot-key slot) settled)
      )
    )
  )
  (fn-do _ stays-present Bool
    (param first Size)
    (if (== (. matching case) 0)
      (return false)
    )
    (let reached false)
    (for (in arm (..< first (. arm-bodies length)))
      (if (not (call (. narrowing exits) ([] arm-bodies arm)))
        (if (not ([] arm-present arm))
          (return false)
        )
        (= reached true)
      )
    )
    (return reached)
  )
  (fn-do _ arm-settles TypeId
    (param arm Size)
    (param slot SlotId)
    ; What an arm's own statements last assign a local, or no type when they assign it nothing.
    (let settled no-type)
    (for (in position (..< ([] arm-starts arm) ([] arm-ends arm)))
      (if (== ([] (. frame assigned-slots) position) slot)
        (if (call (. tree is-direct-statement) ([] arm-bodies arm) ([] (. frame assigned-syntax) position))
          (= settled ([] (. frame assigned-types) position))
        )
      )
    )
    (return settled)
  )
  (fn-expr + is-raised Bool
    (param arm TypeId)
    (and (!= arm invalid-type) (!= arm no-type) (call is-subtype types arm (. types error-type)))
  )
  (fn-do _ raises-at-arm Bool
    (param arm TypeId)
    (param expected TypeId)
    (return-if false (if (not (call is-raised arm))))
    (return-if true (if (== expected no-type)))
    (let held (call (. types optional-inner) (call result-value types expected)))
    (return-if false (if (call is-subtype types arm held)))
    (return-if true (if (!= (call (. types intrinsic-of) held) .union)))
    (return (call all (call (. types cases-of) held) (:where (not (call is-subtype types arm (. each type))))))
  )
  (fn-do _ gives-errors Bool
    (param arms (of ImmutableArray TypeId ArenaBacking))
    (param expected TypeId)
    ; Whether some arm gives an error the type the arms are expected to give does not hold: those
    ; errors then leave the function as errors, each at its arm, and the values alone are what the
    ; arms give, or nothing where every arm gives such an error.
    (for (in arm arms)
      (if (call raises-at-arm arm expected)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ closes Bool
    (param body SyntaxId)
    (param arms SyntaxId)
    ; Whether arms are the ones a match must cover its subject with: the body of the match, of a
    ; catch the body is, or a statement of a block the body is.
    (if (== body arms)
      (return true)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-catch-expression row)
        (return (call closes (. row body) arms))
      )
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (call closes statement arms)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-coverage _
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param subject TypeId)
    (let coverage (call Coverage frame this))
    (let gap (call (. coverage gap) pattern subject))
    (if gap
      (let site (if-expr (!= (. coverage site) 0) (. coverage site) id))
      (call (. frame diagnose) site .stated (call (. program store-atom) gap) subject)
      (call (. frame mention) (. coverage held))
    )
  )
  (fn-do _ check-arm-reach Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    (param is-last Bool)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (return (or (call check-arm-reach (. row left) subject false) (call check-arm-reach (. row right) subject is-last)))
      )
    )
    (let armed pattern)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-transform row)
        (= armed (. row pattern))
      )
    )
    (let shown (call (. tree takes-all) armed))
    (if (not shown)
      (return false)
    )
    (if (and (!= armed 0) (is ([] (. tree nodes) armed) .node-type-capture))
      (let bound (call (. (call Coverage frame this) bound-case) armed subject))
      (if bound
        (call (. frame diagnose) armed .stated (call (. program store-atom) bound) subject)
        (return true)
      )
    )
    (if is-last
      (return false)
    )
    (let site (if-expr (!= armed 0) armed pattern))
    (call (. frame diagnose)
      (block
        (arg site)
        (arg .stated)
        (arg (call (. program store-atom) (str "Arm \"" shown "\" takes every value, so the arms after it are never reached")))
      )
    )
    (return true)
  )
  (fn-do _ collect-arms Bool
    (param id SyntaxId)
    (param subject TypeId)
    ; Types the arms of a match, each alternative of an `or` in turn, and says whether one is the
    ; arm of what is left. An arm written `|?` with no body gives what its condition tested, forced,
    ; which the reference evaluates again: where the flow knows that by no key, the force takes the
    ; type the test gave, so what the condition calls is recorded once. An arm whose value is a case
    ; named by its symbol alone, where a type is expected of the match, gives the case of that type
    ; where it can (`armed-symbol`). The body of an arm that runs as markup content (`content-arms`)
    ; gives the element its lines, and the match nothing.
    (if (== id 0)
      (return false)
    )
    (match ([] (. tree nodes) id)
      (case (call .node-type-or row)
        (let left (call collect-arms (. row left) subject))
        (if (or (not (call fails-present (. row left))) untyped (not (call (. types is-optional) subject)))
          (let right (call collect-arms (. row right) subject))
          (return (or left right))
        )
        (lazy untyped (or (== subject no-type) (== subject invalid-type)))
        (call (. facts set-plan) instance id .plan-present-after)
        (call (. narrowing narrow-condition) (. matching case) true)
        (= arming (= (. arming present-depth) (+ (. arming present-depth) 1)))
        (let present (call collect-arms (. row right) (call (. types optional-inner) subject)))
        (= arming (= (. arming present-depth) (- (. arming present-depth) 1)))
        (return (or left present))
      )
      (case (call .node-type-transform row)
        (let is-else (call (. tree pattern-is-else) (. row pattern)))
        (let entered (call (. frame live-members)))
        (let unread SyntaxId 0)
        (if (and (. arming several) (!= subject no-type) (!= subject invalid-type))
          (= unread (call name-read (. row pattern)))
        )
        (if (!= unread 0)
          (call (. frame diagnose) unread .stated (call (. program store-atom) "Type not found"))
          (call (. facts set-plan) instance id .plan-never)
          (return false)
        )
        (if (and (not is-else) (not (call pattern-possible (. row pattern) subject)))
          (call (. facts set-plan) instance id .plan-never)
          (return false)
        )
        (= arming (= (. arming possible) (+ (. arming possible) 1)))
        (let subject-slot (call arm-slot id .slot-it))
        (if (and (!= subject-slot no-slot) (!= subject no-type) (!= subject invalid-type))
          (call (. frame assign) subject-slot subject)
          (call carry-subject subject-slot)
        )
        (let own-arm arm-typing)
        (= arm-typing (= (. arm-typing it) subject-slot))
        (call check-pattern (. row pattern) subject)
        (= arm-typing own-arm)
        (if (and (!= subject-slot no-slot) (!= subject no-type) (!= subject invalid-type))
          (let passed (call passed-type (. row pattern) subject))
          (if (!= passed subject)
            (call (. frame assign) subject-slot passed)
          )
        )
        (let predicate (call (. tree predicate-expr) (. row pattern)))
        (let mark (. scratch narrowings mark))
        (call (. narrowing narrow-condition) predicate true)
        (if (and (!= predicate 0) (== subject no-type))
          (let it-slot (call arm-slot id .slot-it))
          (let it-type (call (. facts node-type) instance predicate))
          (match? ([] (. tree nodes) predicate)
            (case .node-identifier
              (let resolution (call (. bindings resolution-of) (. frame binding) predicate))
              (if (== (. resolution kind) .resolve-slot)
                (= it-type (call (. frame slot-type) (. resolution slot)))
              )
            )
          )
          (if (and (!= it-slot no-slot) (!= it-type no-type))
            (call (. frame assign) it-slot it-type)
          )
        )
        (let value no-type)
        (let given no-type)
        (let symbol (call (. tree symbol-of) (. row expr)))
        (let assigned-start (. frame assigned-syntax length))
        (if (and symbol (== (. arming expected) no-type))
          (= value (call arm-symbol (. row expr) symbol))
        )
        (let diagnosed (. facts diagnostics length))
        (let known (call (. frame save-members)))
        (if (== value no-type)
          (let own-arm arm-typing)
          (= arm-typing (= (. arm-typing forced) (if-expr (and (!= predicate 0) (== (call (. narrowing condition-slot) predicate) null)) predicate 0)))
          (= arm-typing (= (. arm-typing symbol) (if-expr (!= (. arming expected) no-type) (call (. tree arm-value) (. row expr)) 0)))
          (let passed (call passes-expected (. row expr)))
          (if passed
            (call note-returned-match (call (. tree arm-value) (. row expr)) (. arming expected))
            (= arms-expected (. arming expected))
            (= arms-given no-type)
          )
          (if (!= (call content-parent (. row expr)) no-type)
            (call check-body (. row expr))
            (else-if (. arming statement)
              (= value (call check-steps (. row expr)))
            )
            (else
              (= value (call check-arm-value (. row expr)))
            )
          )
          (if passed
            (= given arms-given)
          )
          (= arm-typing own-arm)
        )
        (if (call (. narrowing exits) (. row expr))
          (call (. frame restore-members) known)
          (else-if (and (. known narrowed) (not (. frame members-narrowed)))
            (call (. frame keep-members) entered)
          )
        )
        (let silent (and (!= (. row expr) 0) (== (. facts diagnostics length) diagnosed)))
        (if (and silent (not (. arming statement)) (call lacks-value (. row expr) value) (not (call matches-row subject)))
          (let stated
            (block
              (case? (call in-steps)
                "Match arm gives no value"
              )
              (default
                "Match arm gives no value in a value body"
              )
            )
          )
          (call (. frame diagnose) (. row expr) .stated (call (. program store-atom) stated))
        )
        (+= arm-bodies (. row expr))
        (+= arm-present (!= (. arming present-depth) 0))
        (+= arm-starts assigned-start)
        (+= arm-ends (. frame assigned-syntax length))
        (if (not (call (. narrowing exits) (. row expr)))
          (for (in settled (call (. frame assigned-since) mark))
            (+= arm-settled settled)
          )
        )
        (call (. frame pop-narrowing) mark)
        (call (. narrowing narrow-condition) predicate false)
        (if (!= value no-type)
          (if (and (. row is-union) (not (. arming unite)))
            (= arming (= (. arming unite) true))
            (= arming (= (. arming union) (. scratch types mark)))
          )
          (call (. scratch types push) value)
          (+= arm-values (call (. tree arm-value) (. row expr)))
          (+= arm-givens given)
        )
        (if (call raises-at-arm value (. arming expected))
          (+= raised-arms id)
        )
        (return is-else)
      )
      (case (call .node-type-panic row)
        (return (call collect-panic (. row pattern) subject))
      )
      (default
        (let is-else (call (. tree pattern-is-else) id))
        (if (and (not is-else) (not (call pattern-possible id subject)))
          (call (. facts set-plan) instance id .plan-never)
          (return false)
        )
        (= arming (= (. arming possible) (+ (. arming possible) 1)))
        (call check-pattern id subject)
        (let value (call pattern-value id subject))
        (if (and (!= value no-type) (!= value invalid-type))
          (call (. scratch types push) value)
          (+= arm-values 0)
          (+= arm-givens no-type)
        )
        (return is-else)
      )
    )
  )
  (fn-do _ passes-expected Bool
    (param body SyntaxId)
    ; Whether the value of an arm is a match that nothing in the arm runs before, which is of the
    ; type the arms are expected to give as a returned match is, so that its own arms convert to it.
    (let value (call (. tree arm-value) body))
    (if (or (== (. arming expected) no-type) (== (. arming expected) (. types void-type)) (not (call (. tree is-match-syntax) value)))
      (return false)
    )
    (return-if false (if (call may-miss value (. arming expected))))
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (return-if true (if (== statement value)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-declare row)
              (if (. row is-lazy)
                (continue)
              )
            )
          )
          (return-if false (if (not (call is-comment-syntax tree statement))))
        )
      )
    )
    (return true)
  )
  (fn-expr _ is-conditional Bool
    (param pattern SyntaxId)
    ; Whether arms may match nothing, as the reference asks it of a match written on one line: its
    ; last arm has a pattern.
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (call is-conditional (. row right))
      )
      (case (call .node-type-transform row)
        (and (!= (. row pattern) 0) (call is-conditional (. row pattern)))
      )
      (case (call .node-type-panic row)
        (call is-conditional (. row pattern))
      )
      (default
        true
      )
    )
  )
  (fn-expr + lacks-value Bool
    (param body SyntaxId)
    (param value TypeId)
    ; The body of an arm gives the match its value or leaves the function itself. One that ends in
    ; a match whose every arm leaves does neither: that match is an expression with no value.
    (case? (call (. narrowing exits) body true)
      false
    )
    (default
      (or (== value no-type) (and (== value invalid-type) (call (. narrowing exits) body)))
    )
  )
  (fn-expr _ matches-row Bool
    (param subject TypeId)
    ; Whether a match is on a row of a table of unions, whose arms may run for their effect alone.
    (case? (or (== subject no-type) (== subject invalid-type))
      false
    )
    (default
      (!= (call (. calls union-row) subject) no-type)
    )
  )
  (fn-do _ carry-subject _
    (param slot SlotId)
    ; The subject of a match is one value under the `it` of each arm. What the arms before left
    ; known of it, by a condition that did not hold, is known of it in the arm that follows.
    (if (and (!= (. arming it) no-slot) (!= (. arming it) slot))
      (let carried (call (. frame narrowed-slot) (. arming it)))
      (if (!= carried no-type)
        (call (. frame push-narrowing) (call slot-key slot) carried (call (. frame narrowed-cases) (call slot-key (. arming it))))
      )
    )
    (= arming (= (. arming it) slot))
  )
  (fn-do _ collect-panic Bool
    (param id SyntaxId)
    (param subject TypeId)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-transform row)
        (let is-else (call (. tree pattern-is-else) (. row pattern)))
        (call check-pattern (. row pattern) subject)
        (let predicate (call (. tree predicate-expr) (. row pattern)))
        (call check-assertion id (. row expr) 0)
        (call (. narrowing narrow-condition) predicate false)
        (return is-else)
      )
    )
    (return false)
  )
  (fn-do + arm-slot SlotId
    (param arm SyntaxId)
    (param kind SlotKind)
    (let bound ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (let row ([] (. bindings slots) slot))
      (if (and (== (. row kind) kind) (== (. row syntax) arm))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-expr _ fails-present Bool
    (param pattern SyntaxId)
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (or (call fails-present (. row left)) (call fails-present (. row right)))
      )
      (case (call .node-type-transform row)
        (and (!= (. row pattern) 0) (call fails-present (. row pattern)))
      )
      (case (call .node-type-equality row)
        (call (. narrowing is-null-syntax) (. row expr))
      )
      (default
        false
      )
    )
  )
  (fn-do + check-pattern _
    (param pattern SyntaxId)
    (param subject TypeId)
    (if (== pattern 0)
      (return)
    )
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-predicate row)
        (call check-predicate pattern (. row expr) subject)
      )
      (case (call .node-type-equality row)
        (call plan-equality pattern subject (. row expr) (call infer-comparand (. row expr) subject))
      )
      (case (call .node-type-and row)
        (if (and (== subject (. types string-type)) (call check-text-pattern pattern))
          (return)
        )
        (call check-pattern (. row left) subject)
        (if (call reads-name (. row left))
          (call check-pattern (. row right) (call passed-type (. row left) subject))
          (else
            (call check-pattern (. row right) (call pattern-type (. row left) subject))
          )
        )
      )
      (case (call .node-type-or row)
        (call check-alternative (. row left) subject)
        (let left-slots (list SlotId))
        (let left-types (list TypeId))
        (call alternative-slots (. row left) left-slots)
        (for (in slot left-slots)
          (+= left-types (call (. frame known) slot))
        )
        (call check-alternative (. row right) subject)
        (let right-slots (list SlotId))
        (call alternative-slots (. row right) right-slots)
        (call check-alternative-names (. row left) left-slots left-types (. row right) right-slots)
      )
      (case (call .node-type-panic row)
        (call check-pattern (. row pattern) subject)
      )
      (case .node-type-arguments
        (call plan-type-pattern pattern subject no-type .similar)
      )
      (case .node-type-optional
        (call plan-type-pattern pattern subject no-type .similar)
      )
      (case (call .node-type-list row)
        (if (call is-collection-type tree pattern)
          (call plan-type-pattern pattern subject no-type .similar)
          (else
            (call check-list-pattern pattern (. row patterns) subject)
          )
        )
      )
      (case (call .node-type-map row)
        (if (call is-collection-type tree pattern)
          (call plan-type-pattern pattern subject no-type .similar)
          (else
            (call check-map-pattern pattern (. row patterns) subject)
          )
        )
      )
      (case (call .node-type-capture row)
        (if (and (!= (. row type) 0) (call reads-name (. row type)))
          (call check-pattern (. row type) subject)
          (let named (call declaring-slot pattern))
          (if (and named (!= subject no-type) (!= subject invalid-type))
            (call (. frame assign) named (call passed-type (. row type) subject))
          )
          (return)
        )
        (let captured subject)
        (if (!= (. row type) 0)
          (let annotation (call (. types evaluate-type) module tree (. row type) (. frame env)))
          (if (!= annotation invalid-type)
            (= captured (call completed-capture annotation subject))
            (else-if (or (call (. tree names-type) (. row type)) (call is-collection-type tree (. row type)))
              (call report-missing-type (. row type) (. frame env))
            )
          )
        )
        (let slot (call declaring-slot pattern))
        (if (and slot (!= captured no-type))
          (call (. frame assign) slot captured)
          (if (. cursor-binding binds)
            (+= row-cursors (call RowCursor slot (. cursor-binding capture)))
          )
        )
        (if (and (!= (. row type) 0) (or (call (. tree names-type) (. row type)) (call is-collection-type tree (. row type))))
          (call plan-capture (. row type) subject captured)
          (else-if (call (. tree matches-named) (. row type))
            (call check-pattern (. row type) subject)
          )
          (else
            (call check-pattern (. row type) captured)
          )
        )
      )
      (case (call .node-type-match row)
        (if (call (. tree names-type) (. row type))
          (call plan-type-pattern (. row type) subject no-type (call required-match (. row op)))
          (else
            (call check-pattern (. row type) subject)
          )
        )
      )
      (case (call .node-type-tuple row)
        (let whole (call held-subject subject))
        (let position 0u32)
        (let saved-cursor cursor-binding)
        (= cursor-binding (= (. cursor-binding binds) false))
        (for (in field ([] (. tree children) (. row field-types)))
          (let part (if-expr (!= whole no-type) (call field-of whole position) no-type))
          (call check-pattern field part)
          (+= position 1)
        )
        (= cursor-binding saved-cursor)
      )
      (case .node-type-wildcard
        (return)
      )
      (case .node-type-identifier
        (call plan-type-pattern pattern subject no-type .similar)
      )
      (case .node-identifier
        (let slot (call declaring-slot pattern))
        (if (and slot (!= subject no-type))
          (call (. frame assign) slot subject)
          (if (. cursor-binding binds)
            (+= row-cursors (call RowCursor slot (. cursor-binding capture)))
          )
        )
      )
      (case (call .node-type-remainder row)
        (call check-pattern (. row name) subject)
      )
      (case (call .node-type-property row)
        (if (and (!= subject no-type) (!= subject invalid-type))
          (let read (. (call read-property pattern pattern subject (. row name)) type))
          (if (!= read invalid-type)
            (call (. facts set-node-type) instance pattern read)
          )
          (let slot (call declaring-slot pattern))
          (if slot
            (call (. frame assign) slot read)
          )
        )
      )
      (case (call .node-type-case row)
        (let case-type subject)
        (if (!= (. row type) 0)
          (= case-type (call (. types evaluate-type) module tree (. row type) (. frame env)))
        )
        (let given subject)
        (if (and (!= given no-type) (!= given invalid-type) (call (. types is-optional) given))
          (= given (call (. types optional-inner) given))
        )
        (if (and (!= given no-type) (!= given invalid-type) (== (call (. types intrinsic-of) given) .union))
          (if (or (== (. row type) 0) (== case-type given))
            (call note-case pattern given (. row name))
            (else-if (call names-case given (. row name))
              (call decline pattern)
            )
          )
          (else-if (and (!= given no-type) (!= given invalid-type) (or (== (. row type) 0) (== case-type given)))
            (let given-kind (call (. types intrinsic-of) given))
            (if (or (== given-kind .table-row) (== given-kind .immutable-table-row))
              (call note-case pattern (call row-struct-of given) (. row name))
              (else-if (and (== (. row type) 0) (call names-nothing-case pattern (. row name) given))
                (call missing-case pattern (. row name) given)
                (return)
              )
            )
          )
        )
        (let payload (call case-payload (if-expr (== (. row type) 0) given case-type) (. row name)))
        (let refined no-type)
        (let known (and (!= given no-type) (!= given invalid-type)))
        (if (and (== (. row type) 0) known (not (call names-case given (. row name))))
          (= refined (call refined-payload given (. row name)))
        )
        (if (and (== refined invalid-type) (!= (. row value) 0))
          (call decline pattern)
        )
        (if (!= refined no-type)
          (call (. facts set-plan) instance pattern .plan-refined-case)
          (= payload
            (scope (if-expr refined-holds refined no-type)
              (lazy refined-holds (and (!= refined (. types void-type)) (!= refined invalid-type)))
            )
          )
        )
        (let case-kind
          (scope (if-expr (!= case-type no-type) case-intrinsic (. IntrinsicKind none))
            (lazy case-intrinsic (call (. types intrinsic-of) case-type))
          )
        )
        (let is-row (or (== case-kind .table-row) (== case-kind .immutable-table-row)))
        (let planned (call (. facts plan-of) instance pattern))
        (if (and known (not is-row) (!= planned .plan-case) (== refined no-type))
          (call (. facts set-plan) instance pattern .plan-never)
        )
        (let saved-cursor cursor-binding)
        (= cursor-binding (= (. cursor-binding binds) is-row))
        (if is-row
          (let validated
            (scope (or immutable-row (and (. matching rows) (== case-type (. matching subject))))
              (lazy immutable-row (== case-kind .immutable-table-row))
            )
          )
          (= cursor-binding
            (= (. cursor-binding capture)
              (call RowCapture
                (block
                  (arg case-type)
                  (arg (call case-number (call row-struct-of case-type) (. row name)))
                  (arg validated)
                )
              )
            )
          )
        )
        (call check-case-value (. row value) payload)
        (= cursor-binding saved-cursor)
      )
      (default
        (call (. instances mark-may-panic) instance)
        (call decline pattern)
      )
    )
  )
  (fn-expr _ name-read SyntaxId
    (param pattern SyntaxId)
    ; The pattern that reads a name from its subject in the pattern of an arm, or none. Where a
    ; match has several arms the reference asks of each whether it could match, and of such a
    ; pattern it has no answer: it looks for a type of that name.
    (case? (== pattern 0)
      0
    )
    (default
      (match ([] (. tree nodes) pattern)
        (case .node-type-property
          pattern
        )
        (case (call .node-type-and row)
          (if-expr (!= (call name-read (. row left)) 0) (call name-read (. row left)) (call name-read (. row right)))
        )
        (case (call .node-type-capture row)
          (call name-read (. row type))
        )
        (case (call .node-type-match row)
          (call name-read (. row type))
        )
        (default
          0
        )
      )
    )
  )
  (fn-do _ check-predicate _
    (param pattern SyntaxId)
    (param expr SyntaxId)
    (param subject TypeId)
    ; A pattern that is a condition. While the condition is typed, `it` is what the pattern is
    ; given: the pattern's own `it`, or the one of the arm it is written in, which holds what it
    ; did again after. The condition is tested as any other is.
    (let slot (call arm-slot pattern .slot-it))
    (let is-shared (and (== slot no-slot) (!= (. arm-typing it) no-slot)))
    (if is-shared
      (= slot (. arm-typing it))
      (else-if (== slot no-slot)
        (= slot (call it-read expr))
        (= is-shared (!= slot no-slot))
      )
    )
    (let is-given (and (!= slot no-slot) (!= subject no-type) (!= subject invalid-type)))
    (let held (if-expr (and is-given is-shared) (call (. frame slot-type) slot) no-type))
    (if is-given
      (call (. frame assign) slot subject)
    )
    (call note-truthiness expr expr (call infer expr))
    (if (and (!= held no-type) (!= held invalid-type) (!= held subject))
      (call (. frame assign) slot held)
    )
  )
  (fn-do _ check-alternative _
    (param pattern SyntaxId)
    (param subject TypeId)
    (if (and (is-not ([] (. tree nodes) pattern) .node-type-or) (not (call pattern-possible pattern subject)))
      (call (. facts set-plan) instance pattern .plan-never)
      (return)
    )
    (call check-pattern pattern subject)
  )
  (fn-do _ alternative-slots _
    (param pattern SyntaxId)
    (param slots (list SlotId))
    ; The locals an alternative of a pattern binds, each once.
    (for (in id (.. (call (. tree subtree-start) pattern) pattern))
      (let resolution (call (. bindings resolution-of) (. frame binding) id))
      (let declares (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-declares)) 0))
      (if (and (== (. resolution kind) .resolve-slot) declares (== (call (. slots find) (. resolution slot)) null))
        (+= slots (. resolution slot))
      )
    )
  )
  (fn-do _ check-alternative-names _
    (param left SyntaxId)
    (param left-slots (list SlotId))
    (param left-types (list TypeId))
    (param right SyntaxId)
    (param right-slots (list SlotId))
    ; The alternatives of `| a | b` bind the same names, each of one type, since the arm reads the
    ; names whichever alternative matched.
    (for (in position (..< 0 (. left-slots length)))
      (let slot ([] left-slots position))
      (let name (. ([] (. bindings slots) slot) name text))
      (if (== (call (. right-slots find) slot) null)
        (call (. frame diagnose)
          (block
            (arg right)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg
                    (paragraph
                      (str "\"" name "\" is bound by the alternative before this one but not by this one; bind it in each alternative")
                    )
                  )
                )
              )
            )
          )
        )
        (return)
      )
      (let before ([] left-types position))
      (let after (call (. frame known) slot))
      (if (and (call known-type before) (call known-type after) (!= before after))
        (let text
          (paragraph
            (str "\"" name "\" is " (call type-source types before) " in one alternative and " (call type-source types after) " in another; bind it to one type in each")
          )
        )
        (call (. frame diagnose) right .stated (call (. program store-atom) text))
        (return)
      )
    )
    (for (in slot right-slots)
      (if (== (call (. left-slots find) slot) null)
        (let name (. ([] (. bindings slots) slot) name text))
        (call (. frame diagnose)
          (block
            (arg left)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg
                    (paragraph
                      (str "\"" name "\" is bound by the alternative after this one but not by this one; bind it in each alternative")
                    )
                  )
                )
              )
            )
          )
        )
        (return)
      )
    )
  )
  (fn-do _ it-read SlotId
    (param expr SyntaxId)
    ; The slot a condition reads `it` through where its pattern declares none and no arm has
    ; one: that of an earlier pattern of the same block.
    (for (in id (.. (call (. tree subtree-start) expr) expr))
      (match? ([] (. tree nodes) id)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) id))
          (if (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-it))
            (return (. resolution slot))
          )
        )
      )
    )
    (return no-slot)
  )
  (fn-do _ plan-equality _
    (param pattern SyntaxId)
    (param subject TypeId)
    (param expr SyntaxId)
    (param value TypeId)
    ; Plans an equality pattern as `==` of its subject and its value, at the pattern's node,
    ; which stands for the subject as the left operand and has the type of the answer. A subject
    ; compared with `null` is asked whether it holds nothing. Values listed for a subject that is
    ; no tuple are an error that names how an arm takes any of several.
    (if (or (== subject no-type) (== subject invalid-type) (== value no-type) (== value invalid-type))
      (return)
    )
    (if (and (is ([] (. tree nodes) expr) .node-tuple-syntax) (not (call intrinsic-is-tuple-like (call (. types intrinsic-of) subject))))
      (let advice
        (paragraph
          "to take any of several, write a condition, as in \"(case? (or (== it .a) (== it .b)) …)\""
        )
      )
      (call (. frame diagnose)
        (block
          (arg expr)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "An arm written \"(case= …)\" compares the subject with one value, and this lists several; " advice)
                  )
                )
              )
            )
          )
        )
      )
      (return)
    )
    (if (and (call (. narrowing is-null-syntax) expr) (call (. types is-optional) subject))
      (call (. facts set-plan) instance pattern .plan-absent)
      (call (. facts set-node-type) instance pattern (. types bool-type))
      (return)
    )
    (let answer (call infer-binary-values pattern .equals-op pattern subject expr value))
    (if (and (!= answer invalid-type) (!= answer no-type))
      (call (. facts set-node-type) instance pattern answer)
    )
  )
  (fn-do _ plan-capture _
    (param pattern SyntaxId)
    (param subject TypeId)
    (param captured TypeId)
    ; A name declared with a type in a pattern holds what the type passes. An optional given to
    ; one declared an optional is captured whole where it converts, with no test.
    (if (or (== subject no-type) (== subject invalid-type) (== captured no-type) (== captured invalid-type))
      (return)
    )
    (if (and (call (. types is-optional) subject) (call (. types is-optional) captured))
      (let whole (call (. relations compare) subject captured false false null module))
      (if (call (. relations holds-as) whole .similar)
        (call (. conversions record-pattern) pattern whole (. U32 max))
        (return)
      )
    )
    (call plan-type-pattern pattern subject captured .similar)
  )
  (fn-do + plan-type-pattern _
    (param pattern SyntaxId)
    (param subject TypeId)
    (param named TypeId)
    (param kind Specificity)
    ; Records at a type named as a pattern what it does to the subject it is given, as the
    ; reference matches it: an optional as what it holds, and a union whole where it converts
    ; whole, else by each of its cases that converts. `named` is the type where the pattern's
    ; own syntax leaves some of it to the subject.
    (if (or (== subject no-type) (== subject invalid-type))
      (return)
    )
    (let target named)
    (if (== target no-type)
      (= target (call (. types evaluate-type) module tree pattern (. frame env)))
      (if (== target invalid-type)
        (call report-missing-type pattern (. frame env))
      )
    )
    (if (or (== target invalid-type) (== target no-type) (call refuses-facet-test pattern target))
      (return)
    )
    (if (. ([] (. types completions) target) has-variables)
      (= target (call complete-named target subject kind))
      (if (== target no-type)
        (call (. facts set-plan) instance pattern .plan-never)
        (return)
      )
    )
    (call plan-leaves pattern subject target kind (. U32 max))
    (call plan-exact pattern kind)
  )
  (fn-do + plan-exact _
    (param pattern SyntaxId)
    (param kind Specificity)
    (if (and (== kind .exact) (!= (call (. facts plan-of) instance pattern) .plan-never))
      (call (. facts set-plan) instance pattern .plan-exact-class)
    )
  )
  (fn-do + plan-leaves _
    (param pattern SyntaxId)
    (param held TypeId)
    (param target TypeId)
    (param kind Specificity)
    (param guard U32)
    (let intrinsic (call (. types intrinsic-of) held))
    (if (== intrinsic .optional)
      (call plan-leaves pattern (call (. types optional-inner) held) target kind guard)
      (return)
    )
    (let whole (call (. relations compare-pattern) held target module))
    (if (call (. relations holds-as) whole kind)
      (call (. conversions record-pattern) pattern whole guard)
      (return)
    )
    (if (!= intrinsic .union)
      (return)
    )
    (if (!= guard (. U32 max))
      (call (. conversions record-pattern) pattern whole guard)
      (return)
    )
    (let cases (call (. types cases-of) held))
    (for (in index (..< 0 (. cases length)))
      (let fact ([] cases index))
      (if (or (== (. fact type) no-type) (== (. fact type) invalid-type))
        (continue)
      )
      (if (call (. relations holds-as) (call (. relations compare-pattern) (. fact type) target module) kind)
        (call plan-leaves pattern (. fact type) target kind (as index U32))
      )
    )
  )
  (fn-expr _ held-subject TypeId
    (param subject TypeId)
    ; What fields in parentheses are matched against: what an optional holds, which is tested for
    ; first, as TypeScript matches any pattern, or else the subject.
    (if-expr plain-subject subject (call (. types optional-inner) subject))
    (where
      (lazy plain-subject (or (== subject no-type) (== subject invalid-type) (not (call (. types is-optional) subject))))
    )
  )
  (fn-do + passed-type TypeId
    (param pattern SyntaxId)
    (param subject TypeId)
    ; The type of what a pattern passes on where it matches, which `it` is in the body of its
    ; arm: the type a type named gives, also one of a list or a map written in brackets, for a case
    ; named what the pattern written for what it holds passes or else the union, for fields in
    ; parentheses what an optional holds, and else the subject. The sides of an alternative may
    ; pass different types: the subject stands for them.
    (if (or (== pattern 0) (== subject no-type) (== subject invalid-type))
      (return subject)
    )
    (match? ([] (. tree nodes) pattern)
      (case .node-type-tuple
        (return (call held-subject subject))
      )
      (case (call .node-type-case row)
        (let given (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
        (if (== (. row value) 0)
          (return given)
        )
        (let owner given)
        (if (!= (. row type) 0)
          (= owner (call (. types evaluate-type) module tree (. row type) (. frame env)))
        )
        (let payload (call case-payload owner (. row name)))
        (if (or (== payload no-type) (== payload invalid-type))
          (return subject)
        )
        (let part (. row value))
        (match? ([] (. tree nodes) (. row value))
          (case (call .node-type-tuple fields)
            (if (and (== (. fields field-types count) 1) (!= (call (. types intrinsic-of) payload) .tuple))
              (= part ([] ([] (. tree children) (. fields field-types)) 0))
            )
          )
        )
        (return (call passed-type part payload))
      )
      (case .node-type-identifier
        (let named (call (. types evaluate-type) module tree pattern (. frame env)))
        (return
          (scope (if-expr concrete-name named subject)
            (lazy concrete-name (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables))))
          )
        )
      )
      (case .node-type-arguments
        (let named (call (. types evaluate-type) module tree pattern (. frame env)))
        (return
          (scope (if-expr concrete-arguments named subject)
            (lazy concrete-arguments (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables))))
          )
        )
      )
      (case .node-type-optional
        (let named (call (. types evaluate-type) module tree pattern (. frame env)))
        (return
          (scope (if-expr concrete-optional named subject)
            (lazy concrete-optional (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables))))
          )
        )
      )
      (case .node-type-list
        (if (call is-collection-type tree pattern)
          (let named (call (. types evaluate-type) module tree pattern (. frame env)))
          (return
            (scope (if-expr concrete-list named subject)
              (lazy concrete-list (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables))))
            )
          )
        )
      )
      (case .node-type-map
        (if (call is-collection-type tree pattern)
          (let named (call (. types evaluate-type) module tree pattern (. frame env)))
          (return
            (scope (if-expr concrete-map named subject)
              (lazy concrete-map (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables))))
            )
          )
        )
      )
      (case (call .node-type-match row)
        (return (call passed-type (. row type) subject))
      )
      (case (call .node-type-and row)
        (return (call passed-type (. row right) (call passed-type (. row left) subject)))
      )
      (case .node-type-property
        (let read (call (. facts node-type) instance pattern))
        (return (if-expr (!= read no-type) read subject))
      )
      (case (call .node-type-panic row)
        (return (call passed-type (. row pattern) subject))
      )
      (case (call .node-type-capture row)
        (if (== (. row type) 0)
          (return subject)
        )
        (let slot (call declaring-slot pattern))
        (if slot
          (let captured (call (. frame slot-type) slot))
          (if (and (!= captured no-type) (!= captured invalid-type))
            (return captured)
          )
        )
        (return (call passed-type (. row type) subject))
      )
    )
    (return subject)
  )
  (fn-do + pattern-possible Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    (param inside Bool (= false))
    ; Whether a pattern could match a subject of this type at all. The reference compiles no arm
    ; whose pattern cannot, and a match none of whose arms can is an error. `inside` says the
    ; pattern is a field of one that takes a tuple apart.
    (if (or (== pattern 0) (== subject no-type) (== subject invalid-type))
      (return true)
    )
    (match? ([] (. tree nodes) pattern)
      (case .node-type-identifier
        (return (call type-possible pattern subject .similar))
      )
      (case .node-type-arguments
        (return (call type-possible pattern subject .similar))
      )
      (case (call .node-type-match row)
        (return (call type-possible (. row type) subject (call required-match (. row op))))
      )
      (case (call .node-type-or row)
        (return (or (call pattern-possible (. row left) subject inside) (call pattern-possible (. row right) subject inside)))
      )
      (case (call .node-type-and row)
        (if (not (call pattern-possible (. row left) subject inside))
          (return false)
        )
        (let passed
          (block
            (case? (call reads-name (. row left))
              (call passed-type (. row left) subject)
            )
            (default
              (call pattern-type (. row left) subject)
            )
          )
        )
        (return (call pattern-possible (. row right) passed inside))
      )
      (case (call .node-type-capture row)
        (return (call pattern-possible (. row type) subject inside))
      )
      (case (call .node-type-case row)
        (return (call case-possible pattern (. row type) (. row name) subject inside))
      )
      (case (call .node-type-tuple row)
        (return (call tuple-possible (. row field-types) subject))
      )
      (case (call .node-type-property row)
        (return (call answers subject (. row name)))
      )
      (case (call .node-type-list row)
        (if (call is-collection-type tree pattern)
          (return (call type-possible pattern subject .similar))
        )
        (let held (call sequence-case subject))
        (if (== held no-type)
          (return false)
        )
        (if (== held invalid-type)
          (return true)
        )
        (let item (call iterable-item held (. types indexable-decl)))
        (for (in element ([] (. tree children) (. row patterns)))
          (match ([] (. tree nodes) element)
            (case .node-type-remainder
              (continue)
            )
            (default
              (if (not (call pattern-possible element item))
                (return false)
              )
            )
          )
        )
      )
      (case (call .node-type-map row)
        (if (call is-collection-type tree pattern)
          (return (call type-possible pattern subject .similar))
        )
        (let held (call structured-case subject (. types map-decl)))
        (let map (call (. types ancestor-of) held (. types map-decl)))
        (if (== map no-type)
          (return false)
        )
        (for (in element ([] (. tree children) (. row patterns)))
          (match? ([] (. tree nodes) element)
            (case (call .node-type-map-item item)
              (if (not (call pattern-possible (. item value) (call class-arg types map 1)))
                (return false)
              )
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ tuple-possible Bool
    (param fields (of RowRange SyntaxId))
    (param subject TypeId)
    ; Whether a pattern that takes a tuple apart could match a subject: one that could be a
    ; tuple, and where it is one of as many fields, each field's pattern could match its field.
    (if (not (call destructures-some subject))
      (return false)
    )
    (let held (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (or (== (call (. types intrinsic-of) held) .union) (not (call destructures held (. fields count))))
      (return true)
    )
    (let position 0u32)
    (for (in field ([] (. tree children) fields))
      (if (not (call pattern-possible field (call field-of held position) true))
        (return false)
      )
      (+= position 1)
    )
    (return true)
  )
  (fn-do + missing-case _
    (param pattern SyntaxId)
    (param name Atom)
    (param subject TypeId)
    ; Reports a case a pattern names that no type has, where it tests a value of a union, which is
    ; named with its cases, or of a type with none.
    (if (or (== subject no-type) (== subject invalid-type))
      (call (. frame diagnose) pattern .stated (call (. program store-atom) "Type not found"))
      (return)
    )
    (let shown (call type-short-name types subject))
    (let message
      (block
        (case? (== (call (. types intrinsic-of) subject) .union)
          (str "Case \"." (. name text) "\" not found in " shown)
        )
        (default
          (str "Case \"." (. name text) "\" not found: " shown " has no cases")
        )
      )
    )
    (call (. frame diagnose) pattern .stated (call (. program store-atom) message))
  )
  (fn-do _ names-nothing-case Bool
    (param pattern SyntaxId)
    (param name Atom)
    (param subject TypeId)
    ; Whether a pattern names a case by its name alone that neither a value of the subject's enum
    ; nor any type the pattern could mean has.
    (if (call names-enum-value pattern 0 name subject)
      (return false)
    )
    (return (and (== (call anonymous-symbol pattern name) no-type) (== (call symbol-class types module name) invalid-type)))
  )
  (fn-do _ case-possible Bool
    (param pattern SyntaxId)
    (param type SyntaxId)
    (param name Atom)
    (param subject TypeId)
    (param inside Bool)
    ; Whether a pattern that names a case could match a subject: one that is a union with a case
    ; of that name, an optional of one, or a row. The reference compiles the arm of no other,
    ; and where the pattern names no type and no type it could mean has a case or a value of
    ; the name, it reports that. As a field of a tuple the pattern keeps its arm also where the
    ; type it means is the field's, or what a case of the field holds: it matches nothing there.
    (let given (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (let kind (call (. types intrinsic-of) given))
    (if (or (== kind .table-row) (== kind .immutable-table-row) (call names-case given name))
      (return true)
    )
    (if (and (== kind .union) (!= (call refined-payload given name) no-type))
      (return true)
    )
    (if (call names-enum-value pattern type name given)
      (return true)
    )
    (let meant no-type)
    (if (!= type 0)
      (= meant (call (. types evaluate-type) module tree type (. frame env)))
      (else
        (= meant (call anonymous-symbol pattern name))
        (if (== meant no-type)
          (= meant (call symbol-class types module name))
          (if (== meant invalid-type)
            (call missing-case pattern name given)
          )
        )
      )
    )
    (if (or (== meant no-type) (== meant invalid-type) (not inside))
      (return false)
    )
    (if (== meant given)
      (return true)
    )
    (if (== kind .union)
      (for (in fact (call (. types cases-of) given))
        (if (or (== (. fact type) meant) (call names-case (. fact type) name))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do + refined-payload TypeId
    (param union TypeId)
    (param name Atom)
    ; What a case holds that a refinement of the machine of a property of a class adds, where the
    ; machine's union is a type and the case is of a name, as the refinement's own union holds it:
    ; `Void` for nothing, or its values. Refinements typed so far are found, and else those of the property the
    ; subject reads for the class of the object it reads it from (`case-owner-of`), or of the
    ; machine's property for the class the function, or one it is written in, is typed for
    ; (`enclosing-self`), as the reference finds them, and
    ; the refinement being typed as it is written (`writing-payload`). No type where none adds the
    ; case.
    (let root (call refined-root union))
    (let found (if-expr root (call refining-payload root name) no-type))
    (if (!= found no-type)
      (return found)
    )
    (let owner (call case-owner-of (. matching case)))
    (let receiver (if-expr (!= owner no-type) owner (call enclosing-self)))
    (let property (only-if (call decl-property-name (. root module) (. root decl)) (if root)))
    (if (!= owner no-type)
      (= property (call (. tree subject-property) (. matching case)))
    )
    (let classed (and (!= receiver no-type) (== (call (. types intrinsic-of) receiver) .class)))
    (let place (only-if (call property-named receiver property) (if (and property classed))))
    (if (not place)
      (return no-type)
    )
    (let ref (call class-ref types (. ([] (. types properties) place) owner)))
    (let declared (call class-property ref (!! property)))
    (if (== declared 0)
      (return no-type)
    )
    (let unit (call (. instances intern-initializer) (. ref module) declared (call holding-type receiver ref)))
    (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
      (return (call writing-payload receiver (!! property) name))
    )
    (call demand-body unit)
    (let typed (call refined-root union))
    (return (if-expr typed (call refining-payload typed name) no-type))
  )
  (fn-do + enclosing-self TypeId
    ; The class the function is typed for, or the nearest function it is written in is, or none.
    (let current instance)
    (while (!= current no-instance)
      (if (!= (. ([] (. instances rows) current) self-type) no-type)
        (return (. ([] (. instances rows) current) self-type))
      )
      (= current (. ([] (. instances rows) current) enclosing))
    )
    (return no-type)
  )
  (fn-do _ writing-payload TypeId
    (param receiver TypeId)
    (param property Atom)
    (param name Atom)
    ; What a case of a name holds that a machine of a property of a name writes, of a class a
    ; receiver is or derives from, while those machines are typed for it: `Void` for a case written
    ; with no values, and invalid where what it holds is not typed yet; no type where none writes
    ; such a case.
    (let current receiver)
    (while (!= current no-type)
      (let level (call class-ref types current))
      (= current (?? (call (. types base-of) current) no-type))
      (let declared (if-expr (or (!= (. level module) 0) (!= (. level decl) 0)) (call class-property level property) 0))
      (if (== declared 0)
        (continue)
      )
      (let owner-tree (. ([] (. program modules) (. level module)) tree))
      (match? ([] (. ([] (. program modules) (. level module)) decls) declared)
        (case (call .decl-property found)
          (let machine (call (. owner-tree declared-machine) (. found value)))
          (let items
            (scope (if-expr (!= machine 0) machine-states (call (of List SyntaxId)))
              (lazy machine-states (call (. owner-tree state-items) (call (. owner-tree state-body) machine)))
            )
          )
          (let node (if-expr (!= machine 0) (call (. owner-tree find-case) items name) 0))
          (if (!= node 0)
            (return
              (scope (if-expr targetless (. types void-type) invalid-type)
                (lazy targetless (== (. (call (. owner-tree state-targets) node) count) 0))
              )
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ case-owner-of TypeId
    (param subject SyntaxId)
    ; The class of the object a subject reads a property from, as the reference finds the object a
    ; state machine's union is read from: the type of the object written before the property's
    ; name, or none.
    (if (== subject 0)
      (return no-type)
    )
    (match? ([] (. tree nodes) subject)
      (case (call .node-get-expression row)
        (let held (call (. facts node-type) instance (. row object)))
        (let inner (if-expr (call (. types is-optional) held) (call (. types optional-inner) held) held))
        (if (and (!= inner no-type) (!= inner invalid-type) (== (call (. types intrinsic-of) inner) .class))
          (return inner)
        )
      )
    )
    (return no-type)
  )
  (fn-do _ refined-root (? MachineFact)
    (param union TypeId)
    ; The machine of a property of a class whose union a type is, and that refines none.
    (for (in machine (. facts machines))
      (let member (and (== (. machine store) .store-member) (== (. machine outer) 0)))
      (if (and (== (. machine union) union) member (== (. machine refined) no-instance))
        (return machine)
      )
    )
    (return null)
  )
  (fn-do _ refining-payload TypeId
    (param root MachineFact)
    (param name Atom)
    ; What a case of a name holds that a refinement typed so far of a machine adds, `Void` where it
    ; holds nothing, or no type.
    (for (in machine (. facts machines))
      (if (or (== (. machine refined) no-instance) (!= (. machine outer) 0) (not (call names-case (. machine union) name)))
        (continue)
      )
      (let above (call (. facts root-machine) machine))
      (if (and (== (. above module) (. root module)) (== (. above syntax) (. root syntax)))
        (let held (call case-payload (. machine union) name))
        (return (if-expr (!= held no-type) held (. types void-type)))
      )
    )
    (return no-type)
  )
  (fn-do + decl-property-name (? Atom)
    (param owner ModuleId)
    (param property DeclId)
    ; The name of a property a module declares.
    (match? ([] (. ([] (. program modules) owner) decls) property)
      (case (call .decl-property row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-do + names-enum-value Bool
    (param pattern SyntaxId)
    (param type SyntaxId)
    (param name Atom)
    (param subject TypeId)
    ; Whether a pattern that names a case names a value of a whole number type instead, written
    ; alone or with that type. It is an error the reference reports at the pattern, wherever the
    ; pattern is, so the arm is kept for it.
    (if (or (not (. ([] (. types completions) subject) has-enums)) (not (call is-integer-kind (call (. types intrinsic-of) subject))))
      (return false)
    )
    (if (not (call enum-case-decl types program subject name))
      (return false)
    )
    (if (and (!= type 0) (!= (call (. types evaluate-type) module tree type (. frame env)) subject))
      (return false)
    )
    (let shown (call type-short-name types subject))
    (let member (str (if-expr (!= type 0) shown "") "." (. name text)))
    (let written (if-expr (!= type 0) (str "(. " shown " " (. name text) ")") member))
    (let message
      (paragraph
        (str shown "." (. name text) " is an enum value, not a union case; match it with \"(case= " written " …)\"")
      )
    )
    (call (. frame diagnose) pattern .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do + names-case Bool
    (param type TypeId)
    (param name Atom)
    ; Whether a type is a union with a case of a name.
    (if (or (== type no-type) (== type invalid-type) (!= (call (. types intrinsic-of) type) .union))
      (return false)
    )
    (for (in fact (call (. types cases-of) type))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ type-possible Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    (param kind Specificity)
    (case? (== target invalid-type)
      true
    )
    (default
      (call could-match subject target kind)
    )
    (where
      (lazy target (call (. types evaluate-type) module tree pattern (. frame env)))
    )
  )
  (fn-do _ destructures-some Bool
    (param subject TypeId)
    ; Whether a value of the subject's type could be a tuple a pattern takes apart.
    (let held (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (!= (call (. types intrinsic-of) held) .union)
      (return (!= (call tuple-arity held) (. U32 max)))
    )
    (for (in fact (call (. types cases-of) held))
      (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type) (!= (call tuple-arity (. fact type)) (. U32 max)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + pattern-value TypeId
    (param pattern SyntaxId)
    (param subject TypeId)
    ; What an arm with no body gives: the subject as its pattern matched it. Of patterns written
    ; one after another it is what the last type named among them made of it. A case named with
    ; nothing written for what it holds gives the union, what an optional holds.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-and row)
        (if (or (call (. tree names-type) (. row right)) (call (. tree matches-named) (. row right)))
          (return (call pattern-type (. row right) subject))
        )
        (return (call pattern-value (. row left) subject))
      )
      (case (call .node-type-match row)
        (return (call pattern-value (. row type) subject))
      )
      (case (call .node-type-capture row)
        (return (if-expr (!= (. row type) 0) (call pattern-value (. row type) subject) subject))
      )
      (case (call .node-type-case row)
        (if (== (. row value) 0)
          (return
            (scope (if-expr (and (!= subject no-type) (call (. types is-optional) subject)) inner-subject subject)
              (lazy inner-subject (call (. types optional-inner) subject))
            )
          )
        )
        (let owner subject)
        (if (!= (. row type) 0)
          (= owner (call (. types evaluate-type) module tree (. row type) (. frame env)))
        )
        (let payload (call case-payload owner (. row name)))
        (return (if-expr (!= payload no-type) payload subject))
      )
      (case .node-type-predicate
        (return subject)
      )
    )
    (let optional (and (!= subject no-type) (call (. types is-optional) subject)))
    (return (call pattern-type pattern (if-expr optional (call (. types optional-inner) subject) subject)))
  )
  (fn-do _ completed-capture TypeId
    (param annotation TypeId)
    (param subject TypeId)
    ; A capture that names a generic type without its parameters holds that type as the subject
    ; gives it: the subject itself, the value an optional holds, or the case of a union that is of
    ; the named type.
    (if (or (== subject no-type) (== subject invalid-type) (not (. ([] (. types completions) annotation) has-variables)))
      (return annotation)
    )
    (let relation (call (. relations compare) subject annotation false false null module))
    (if (and (call instance-relation relation .similar) (not (. ([] (. types completions) (. relation to)) has-variables)))
      (return (. relation to))
    )
    (let held (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (!= held subject)
      (return (call completed-capture annotation held))
    )
    (if (== (call (. types intrinsic-of) held) .union)
      (for (in fact (call (. types cases-of) held))
        (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type))
          (let given (call (. relations compare) (. fact type) annotation false false null module))
          (if (and (call instance-relation given .similar) (not (. ([] (. types completions) (. given to)) has-variables)))
            (return (. given to))
          )
        )
      )
    )
    (return annotation)
  )
  (fn-do _ pattern-type TypeId
    (param pattern SyntaxId)
    (param subject TypeId)
    ; The type a pattern narrows its subject to: a type named in the pattern, as the subject gives
    ; it where it names a generic type without its parameters (`completed-capture`), also one of a
    ; list or a map written in brackets, or by a name that captures what it matches, what an optional
    ; holds for fields in parentheses, else the subject. Patterns written one after another narrow
    ; in turn.
    (match? ([] (. tree nodes) pattern)
      (case .node-type-tuple
        (return (call held-subject subject))
      )
      (case .node-type-identifier
        (let named (call (. types evaluate-type) module tree pattern (. frame env)))
        (return (if-expr (!= named invalid-type) (call completed-capture named subject) subject))
      )
      (case .node-type-arguments
        (let named (call (. types evaluate-type) module tree pattern (. frame env)))
        (return (if-expr (!= named invalid-type) (call completed-capture named subject) subject))
      )
      (case .node-type-list
        (if (call is-collection-type tree pattern)
          (let named (call (. types evaluate-type) module tree pattern (. frame env)))
          (return (if-expr (!= named invalid-type) named subject))
        )
      )
      (case .node-type-map
        (if (call is-collection-type tree pattern)
          (let named (call (. types evaluate-type) module tree pattern (. frame env)))
          (return (if-expr (!= named invalid-type) named subject))
        )
      )
      (case (call .node-type-match row)
        (return (call pattern-type (. row type) subject))
      )
      (case (call .node-type-capture row)
        (return (if-expr (!= (. row type) 0) (call pattern-type (. row type) subject) subject))
      )
      (case (call .node-type-and row)
        (return (call pattern-type (. row right) (call pattern-type (. row left) subject)))
      )
    )
    (return subject)
  )
  (fn-do _ sequence-case TypeId
    (param subject TypeId)
    ; The type whose items a list pattern reads, as the reference finds it: of an optional what it
    ; holds, and of a union the case that has items to give. A text has none, nor has a type that
    ; is no `Indexable`: no type then, and the pattern can not match. Where more than one case
    ; of a union has items the reference matches each, which has no shape here: the type that
    ; is none.
    (if (or (== subject no-type) (== subject invalid-type))
      (return subject)
    )
    (let held (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (!= (call (. types intrinsic-of) held) .union)
      (return (if-expr (call has-items held) held no-type))
    )
    (let found no-type)
    (for (in fact (call (. types cases-of) held))
      (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type) (call has-items (. fact type)))
        (if (!= found no-type)
          (return invalid-type)
        )
        (= found (. fact type))
      )
    )
    (return found)
  )
  (fn-do _ structured-case TypeId
    (param subject TypeId)
    (param wanted DeclRef)
    ; A map pattern matches the value an optional holds, and of a union the case that is a map.
    (if (or (== subject no-type) (== subject invalid-type))
      (return subject)
    )
    (let held (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (!= (call (. types intrinsic-of) held) .union)
      (return held)
    )
    (for (in fact (call (. types cases-of) held))
      (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type))
        (if (!= (call (. types ancestor-of) (. fact type) wanted) no-type)
          (return (. fact type))
        )
      )
    )
    (return held)
  )
  (fn-do + check-text-pattern Bool
    (param pattern SyntaxId)
    ; A pattern of texts matched against a `String`, as the reference lowers one: the length is
    ; read and tested, then `starts-with` the texts before the rest and `ends-with` those after,
    ; each a call recorded at the pattern. A name given a text is bound to that text, and a rest
    ; with a name to what lies between, each a `String`. One with no rest or with several, or with
    ; a text that is not ASCII, whose length the reference counts in units of its own, is declined.
    (let parts (list SyntaxId))
    (call (. tree text-parts) pattern parts)
    (if (== (. parts length) 0)
      (return false)
    )
    (let rest SyntaxId 0)
    (let rests 0)
    (let leads false)
    (let trails false)
    (let plain true)
    (for (in part parts)
      (let text (call (. tree text-of) part))
      (if text
        (if (!= (. text size) (. text length))
          (= plain false)
        )
        (if (!= (. text length) 0)
          (= leads (or leads (== rests 0)))
          (= trails (or trails (!= rests 0)))
        )
        (else
          (+= rests 1)
          (= rest part)
        )
      )
    )
    (if (or (!= rests 1) (not plain))
      (call decline pattern)
      (return true)
    )
    (call (. facts set-plan) instance pattern .plan-text-pattern)
    (call (. calls demand-getter) (. types string-type) (!! (. types length-atom)) pattern)
    (if leads
      (call text-call pattern "starts-with")
    )
    (if trails
      (call text-call pattern "ends-with")
    )
    (for (in part parts)
      (if (is ([] (. tree nodes) part) .node-type-capture)
        (let slot (call declaring-slot part))
        (if slot
          (call (. frame assign) slot (. types string-type))
        )
      )
    )
    (match? ([] (. tree nodes) rest)
      (case (call .node-type-remainder row)
        (if (!= (. row name) 0)
          (let range (call range-construction rest .range-to-op (. types index-type) 0 0 0))
          (call check-pattern
            (block
              (arg (. row name))
              (arg (call (. calls operator-call) rest (. types string-type) (!! (. types index-op-atom)) 0 range))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ text-call _
    (param pattern SyntaxId)
    (param name String)
    ; Records at a pattern of texts a call of a method of `String` given one text, which the pattern
    ; makes of the texts it writes.
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false null))
    (call (. scratch types push) (. types string-type))
    (call (. scratch syntax push) pattern)
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (call (. calls method-call) pattern pattern (. types string-type) (call (. program store-atom) name) arguments)
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
  )
  (fn-do _ check-list-pattern _
    (param pattern SyntaxId)
    (param patterns (of RowRange SyntaxId))
    (param whole TypeId)
    ; A list pattern reads the length of its subject, each item by its index and a rest that has
    ; a name by a range, as the reference lowers it: the items take the type of an item and the
    ; rest what the range gives. The subject is what an optional holds and the case of a union
    ; that is a list, by the conversions recorded at the pattern as for a type named. The length
    ; is read by the getter recorded at the pattern, or is the field of an array a constant fact
    ; names. Of a table, a span of one or a view of a field's column, which the constant says,
    ; TypeScript answers the length and the rows or the items itself, which may raise the panics of
    ; a table, and makes a rest with a name the span or the view a range gives. The read of an item is the
    ; first call at its pattern; a rest with a name has the construction of its range and then
    ; the read.
    (let subject (call sequence-case whole))
    (if (and (== subject invalid-type) (!= whole invalid-type))
      (call decline pattern)
    )
    (if (or (== subject no-type) (== subject invalid-type))
      (for (in element ([] (. tree children) patterns))
        (call check-pattern element no-type)
      )
      (return)
    )
    (if (!= subject whole)
      (call plan-leaves pattern whole subject .similar (. U32 max))
    )
    (let viewed
      (scope (or (call is-column-receiver (call (. types intrinsic-of) subject)) field-view)
        (lazy field-view (call is-field-view (call (. types intrinsic-of) subject)))
      )
    )
    (if (call is-array-field subject (!! (. types length-atom)))
      (call (. facts set-constant) instance pattern (call ConstantFact 1 0 null false) .plan-list-pattern)
      (else-if viewed
        (call (. facts set-constant) instance pattern (call ConstantFact 2 0 null false) .plan-list-pattern)
        (call (. instances mark-may-panic) instance)
      )
      (else
        (call (. facts set-plan) instance pattern .plan-list-pattern)
        (call (. calls demand-getter) subject (!! (. types length-atom)) pattern)
      )
    )
    (for (in element ([] (. tree children) patterns))
      (match ([] (. tree nodes) element)
        (case (call .node-type-remainder row)
          (if (!= (. row name) 0)
            (let range (call range-construction element .range-to-op (. types index-type) 0 0 0))
            (let rest (call (. calls operator-call) element subject (!! (. types index-op-atom)) 0 range))
            (if (and (!= rest invalid-type) viewed)
              (if (not (call plan-table-index element 0 subject 0 range rest))
                (= rest invalid-type)
              )
            )
            (call check-pattern (. row name) rest)
          )
        )
        (default
          (let item (call (. calls index-item) subject element))
          (call note-item-read element)
          (call check-pattern element item)
        )
      )
    )
  )
  (fn-do _ note-item-read _
    (param element SyntaxId)
    ; Marks the call just recorded at the pattern written for an item as the read that gives the
    ; pattern what it is matched against, apart from the calls the pattern makes itself.
    (let fact (call (. facts latest-call) instance element))
    (if (and (!= fact no-fact) (== (. ([] (. facts calls) fact) form) .call-operator))
      (= (. ([] (. facts calls) fact) form) .call-item-read)
    )
  )
  (fn-do _ check-map-pattern _
    (param pattern SyntaxId)
    (param patterns (of RowRange SyntaxId))
    (param whole TypeId)
    ; A map pattern reads each key's value through the index operator, which gives nothing for a
    ; key the map lacks; a rest keeps the map. The subject is what an optional holds and the
    ; case of a union that is a map, by the conversions recorded at the pattern as for a type
    ; named. A rest with a name is the map without what matched, by the calls recorded there.
    (let subject (call structured-case whole (. types map-decl)))
    (let mapped
      (scope (and typed-subject (!= (call (. types ancestor-of) subject (. types map-decl)) no-type))
        (lazy typed-subject (and (!= subject no-type) (!= subject invalid-type)))
      )
    )
    (if mapped
      (if (!= subject whole)
        (call plan-leaves pattern whole subject .similar (. U32 max))
      )
      (call (. facts set-plan) instance pattern .plan-map-pattern)
    )
    (for (in element ([] (. tree children) patterns))
      (match ([] (. tree nodes) element)
        (case (call .node-type-map-item row)
          (let key (call infer (call (. tree key-expr) (. row key))))
          (let known (and mapped (!= key invalid-type)))
          (let value no-type)
          (if known
            (= value (call (. calls operator-call) element subject (!! (. types index-op-atom)) (. row key) key))
            (call note-item-read element)
          )
          (let held no-type)
          (if (and (!= value no-type) (!= value invalid-type))
            (= held (call (. types optional-inner) value))
          )
          (call check-pattern (. row value) held)
        )
        (case (call .node-type-remainder row)
          (if (and (!= (. row name) 0) mapped)
            (call plan-map-rest element subject)
          )
          (call check-pattern (. row name) subject)
        )
        (default
          (call check-pattern element no-type)
        )
      )
    )
  )
  (fn-do _ plan-map-rest _
    (param site SyntaxId)
    (param subject TypeId)
    ; What a rest of a map pattern with a name calls, as the reference lowers it: an empty map of
    ; the subject's type is made, each key matched is stored there with what it holds, and the
    ; rest is the subject less that map.
    (let map (call (. types ancestor-of) subject (. types map-decl)))
    (if (== map no-type)
      (return)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (call (. calls construction-on)
      (block
        (arg site)
        (arg subject)
        (arg (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
      )
    )
    (call (. calls index-assign-call) site subject 0 (call class-arg types map 0) 0 (call class-arg types map 1))
    (call (. calls operator-call) site subject (call (. program store-atom) "-") 0 subject)
  )
  (fn-do _ check-case-value _
    (param value SyntaxId)
    (param payload TypeId)
    (if (and (!= value 0) (!= payload no-type))
      (match? ([] (. tree nodes) value)
        (case (call .node-type-tuple row)
          (let payload-kind (call (. types intrinsic-of) payload))
          (if (and (== (. row field-types count) 1) (!= payload-kind .tuple))
            (call check-pattern ([] ([] (. tree children) (. row field-types)) 0) payload)
            (return)
          )
        )
      )
    )
    (call check-pattern value payload)
  )
  (fn-do + case-payload TypeId
    (param about TypeId)
    (param name Atom)
    (if (or (== about no-type) (== about invalid-type))
      (return no-type)
    )
    (let subject about)
    (let subject-kind (call (. types intrinsic-of) subject))
    (if (or (== subject-kind .table-row) (== subject-kind .immutable-table-row))
      (= subject (call row-struct-of subject))
      (if (== subject no-type)
        (return no-type)
      )
    )
    (let completion (call (. types completion-of) subject))
    (if (!= (. completion intrinsic) .union)
      (return no-type)
    )
    (for (in fact ([] (. types cases) (. completion cases)))
      (if (and (. fact name) (== (!! (. fact name)) name) (not (. fact is-default)))
        (return (. fact type))
      )
    )
    (return no-type)
  )
  (fn-do _ case-number U32
    (param union TypeId)
    (param name Atom)
    ; The number of the case of a union a name names.
    (let position U32)
    (for (in fact (call (. types cases-of) union))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (return position)
      )
      (+= position 1)
    )
    (return (. U32 max))
  )
  (fn-do _ reads-row Bool
    (param syntax SyntaxId)
    ; Whether a subject is the row `t[i]` reads of a table, a span or a selection, which TypeScript
    ; makes a cursor of whose storage it checked there, or a name a loop gives such a row by.
    (match? ([] (. tree nodes) syntax)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (return (and (== (. resolution kind) .resolve-slot) (!= (call (. checked-rows find) (. resolution slot)) null)))
      )
      (case .node-index-expression
        (let constant (call (. facts constant-of) instance syntax))
        (if (and table-planned (!= constant no-fact) (not (call optional-chained syntax)))
          (let op (as (as (/and/ (. ([] (. facts constants) constant) bits) 4294967295) U32) TableOp))
          (return (or (== op (. TableOp table-row)) (== op (. TableOp selection-row)) (== op (. TableOp proven-row))))
        )
        (lazy table-planned (== (call (. facts plan-of) instance syntax) .plan-table))
      )
    )
    (return false)
  )
)
