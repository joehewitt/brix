(import ./frame)
(import ./numeric)
(import ./type-relation)
(import ./type-store)
(import ./type-text)
(import ./types)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + CoverKind (is U32)
  (variant cover-bool (= 0))
  (variant cover-optional (= 1))
  (variant cover-union (= 2))
  (variant cover-result (= 3))
  (variant cover-enum (= 4))
)

(type + Coverage
  ; Whether the arms of a match that must take every value of its subject do. A subject has a
  ; closed set of cases when it is a boolean, an optional, a union, a result, or a number whose
  ; type names its values; any other subject is open and no match over it is checked.
  (blank)
  (prop + site SyntaxId (= 0))
  (prop _ frame Frame)
  (prop _ host Demander)
  (prop _ types Types)
  (prop _ relations Relations)
  (prop _ program Program)
  (prop _ tree AST)
  (prop _ kind CoverKind (= .cover-bool))
  (prop _ domain TypeId (= no-type))
  (prop _ label String)
  (prop _ labels (list String))
  (prop + held (list TypeId))
  (prop _ names (list (? Atom)))
  (prop _ plain (list Bool))
  (prop _ covered (list Bool))
  (prop _ listed-cases (list Size))
  (prop _ listed-patterns (list SyntaxId))
  (fn-do + This _
    (param frame Frame)
    (param host Demander)
    (lazy types (. frame types))
    (lazy relations (. frame relations))
    (lazy program (. frame program))
    (lazy tree (. frame tree))
  )
  (fn-do + gap (? String)
    (param pattern SyntaxId)
    (param subject TypeId)
    ; What the arms leave out of a closed subject, as the diagnostic says it, and nothing when
    ; they leave nothing out or the subject is open. `site` is where to say it when that is not
    ; the arms themselves.
    (if (or (== subject no-type) (== subject invalid-type) (not (call close subject)))
      (return null)
    )
    (call collect pattern)
    (for (in index (..< 0 (. held length)))
      (if (and (!= ([] held index) no-type) (call covers pattern ([] held index)))
        (= ([] covered index) true)
      )
      (if (and (not ([] covered index)) (call lists-cover index))
        (= ([] covered index) true)
      )
    )
    (let missing "")
    (for (in index (..< 0 (. labels length)))
      (if (not ([] covered index))
        (if (!= (. missing length) 0)
          (+= missing ", ")
        )
        (+= missing ([] labels index))
      )
    )
    (if (== (. missing length) 0)
      (return null)
    )
    (let misnamed (call enum-case pattern))
    (if misnamed
      (return misnamed)
    )
    (return (str "Non-exhaustive match for " label "; missing " missing))
  )
  (fn-do + bound-case (? String)
    (param pattern SyntaxId)
    (param subject TypeId)
    (let type subject)
    (if (and (!= type no-type) (!= type invalid-type) (call (. types is-optional) type))
      (= type (call (. types optional-inner) type))
    )
    (if (or (== type no-type) (== type invalid-type) (not (call close type)))
      (return null)
    )
    (if (and (!= kind .cover-union) (!= kind .cover-enum))
      (return null)
    )
    (let name (call bare-name pattern))
    (if (or (not name) (== (call (. names find) name) null))
      (return null)
    )
    (let member (str (call type-short-name types domain) "." (. name text)))
    (if (and (call (. tree is-brix)) (== kind .cover-enum))
      (return (str "Arm \"(case " (. name text) " …)\" binds a new name, not the value " member "; match the value with \"(case= ." (. name text) " …)\""))
    )
    (if (call (. tree is-brix))
      (return (str "Arm \"(case " (. name text) " …)\" binds a new name, not the case " member "; match the case with \"(case ." (. name text) " …)\""))
    )
    (if (== kind .cover-enum)
      (return (str "Arm '| " (. name text) "' binds a new name, not the value " member "; match the value with '|= " member "'"))
    )
    (return (str "Arm '| " (. name text) "' binds a new name, not the case " member "; match the case with '| " member "'"))
  )
  (fn-do _ bare-name (? Atom)
    (param pattern SyntaxId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (if (== (. row type) 0)
          (match? ([] (. tree nodes) (. row id))
            (case (call .node-identifier named)
              (return (. named name))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ add _
    (param shown String)
    (param type TypeId)
    (param name (? Atom))
    (param is-plain Bool (= false))
    ; A case, the type of what it holds, and its name. A plain case of a union holds nothing: it
    ; stands as the void type, which only a pattern that takes anything covers.
    (+= labels shown)
    (+= held type)
    (+= names name)
    (+= plain is-plain)
    (+= covered false)
  )
  (fn-do _ close Bool
    (param subject TypeId)
    (let type subject)
    (let row-kind (call (. types intrinsic-of) type))
    (if (or (== row-kind .table-row) (== row-kind .immutable-table-row))
      (let row (call class-arg types type 0))
      (if (and (!= row no-type) (== (call (. types intrinsic-of) row) .union))
        (= type row)
      )
    )
    (= domain type)
    (= label (call type-display types type))
    (if (== type (. types bool-type))
      (= kind .cover-bool)
      (call add "true" type null)
      (call add "false" type null)
      (return true)
    )
    (if (call (. types is-optional) type)
      (= kind .cover-optional)
      (call add "present" (call (. types optional-inner) type) null)
      (call add "null" no-type null)
      (return true)
    )
    (match? ([] (. types rows) type)
      (case (call .type-result row)
        (= kind .cover-result)
        (= label "Result")
        (if (!= (. row value) (. types void-type))
          (call add (call type-short-name types (. row value)) (. row value) null)
        )
        (for (in offset (..< 0 (. row errors count)))
          (let error (call (. types child-type) (. row errors) offset))
          (call add (call type-short-name types error) error null)
        )
        (return true)
      )
    )
    (if (== (call (. types intrinsic-of) type) .union)
      (= kind .cover-union)
      (for (in index (..< 0 (. (call (. types cases-of) type) length)))
        (let fact ([] (call (. types cases-of) type) index))
        (let payload (if-expr (. fact is-default) (. types void-type) (. fact type)))
        (if (. fact name)
          (call add (str "." (. (!! (. fact name)) text)) payload (. fact name) (. fact is-default))
          (else
            (call add (call type-display types (. fact type)) payload null (. fact is-default))
          )
        )
      )
      (return (!= (. labels length) 0))
    )
    (return (call close-enum type))
  )
  (fn-do _ close-enum Bool
    (param type TypeId)
    ; A type of whole numbers that names its values is closed when each name stands for its own
    ; plain integer. A class that names values of its own is open.
    (if (or (not (. ([] (. types completions) type) has-enums)) (not (call is-integer-kind (call (. types intrinsic-of) type))))
      (return false)
    )
    (let ref (call class-ref types type))
    (let owner ([] (. program modules) (. ref module)))
    (let shown (call type-short-name types type))
    (let values (list U64))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class class)
        (for (in member ([] (. owner member-pool) (. class members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-case case)
              (let value U64 (as (. values length) U64))
              (if (!= (. case value) 0)
                (match ([] (. owner tree nodes) (. case value))
                  (case (call .node-integer-syntax literal)
                    (if (. literal unit)
                      (return false)
                    )
                    (= value (. (call parse-integer-literal (. literal value)) value))
                  )
                  (default
                    (return false)
                  )
                )
              )
              (if (or (not (. case name)) (!= (call (. values find) value) null))
                (return false)
              )
              (let case-name (. case name))
              (+= values value)
              (call add (str shown "." (. case-name text)) type case-name)
            )
          )
        )
      )
    )
    (= kind .cover-enum)
    (return (!= (. labels length) 0))
  )
  (fn-do _ cover-all _
    (for (in index (..< 0 (. covered length)))
      (= ([] covered index) true)
    )
  )
  (fn-do _ collect _
    (param pattern SyntaxId)
    (if (== pattern 0)
      (call cover-all)
      (return)
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (call collect (. row left))
        (call collect (. row right))
        (return)
      )
      (case (call .node-type-transform row)
        (call collect (. row pattern))
        (return)
      )
      (case (call .node-type-panic row)
        (call collect (. row pattern))
        (return)
      )
    )
    (let whole (or (== kind .cover-bool) (== kind .cover-enum)))
    (if (and whole (call covers pattern domain))
      (call cover-all)
      (return)
    )
    (match kind
      (case= .cover-bool
        (let name (call equality-name pattern))
        (if (and name (== (. name text) "true"))
          (= ([] covered 0) true)
        )
        (if (and name (== (. name text) "false"))
          (= ([] covered 1) true)
        )
      )
      (case= .cover-optional
        (match? ([] (. tree nodes) pattern)
          (case .node-type-wildcard
            (call cover-all)
            (return)
          )
        )
        (let name (call equality-name pattern))
        (if (and name (== (. name text) "null"))
          (= ([] covered 1) true)
        )
        (if (call covers pattern ([] held 0))
          (= ([] covered 0) true)
        )
      )
      (case= .cover-union
        (call collect-union pattern)
      )
      (case= .cover-result
        (call cover-held pattern)
      )
      (case= .cover-enum
        (let name (call equality-name pattern))
        (let index (only-if (call (. names find) name) (if name)))
        (if (!= index null)
          (= ([] covered index) true)
        )
      )
    )
  )
  (fn-do _ collect-union _
    (param pattern SyntaxId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-case row)
        (let index (call (. names find) (. row name)))
        (if (and (!= index null) (or (== (. row value) 0) (call covers (. row value) ([] held index))))
          (= ([] covered index) true)
          (else-if (and (!= index null) (is ([] (. tree nodes) (. row value)) .node-type-list))
            (+= listed-cases index)
            (+= listed-patterns (. row value))
          )
        )
        (return)
      )
    )
    (let name (call equality-name pattern))
    (let index (only-if (call (. names find) name) (if name)))
    (if (and (!= index null) ([] plain index))
      (= ([] covered index) true)
      (return)
    )
    (call cover-held pattern)
  )
  (fn-do _ cover-held _
    (param pattern SyntaxId)
    (for (in index (..< 0 (. held length)))
      (if (and (!= ([] held index) no-type) (call covers pattern ([] held index)))
        (= ([] covered index) true)
      )
    )
  )
  (fn-do _ equality-name (? Atom)
    (param pattern SyntaxId)
    ; The name an equality arm compares its subject with: a bare name or symbol, or a value named
    ; under the subject's own type.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-equality row)
        (match? ([] (. tree nodes) (. row expr))
          (case (call .node-identifier named)
            (return (. named name))
          )
          (case (call .node-symbol named)
            (return (. named name))
          )
          (case (call .node-get-expression get)
            (let owner (call named-type (. get object)))
            (if (and (!= owner no-type) (== owner domain))
              (return (. get name))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ enum-case (? String)
    (param pattern SyntaxId)
    ; An arm that names a value of a number type as if it were the case of a union matches
    ; nothing: the message says how to write the arm, at the arm.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (let left (call enum-case (. row left)))
        (if left
          (return left)
        )
        (return (call enum-case (. row right)))
      )
      (case (call .node-type-transform row)
        (return (only-if (call enum-case (. row pattern)) (if (!= (. row pattern) 0))))
      )
      (case (call .node-type-panic row)
        (return (call enum-case (. row pattern)))
      )
      (case (call .node-type-case row)
        (if (or (!= kind .cover-enum) (== (call (. names find) (. row name)) null))
          (return null)
        )
        (if (and (!= (. row type) 0) (!= (call named-type (. row type)) domain))
          (return null)
        )
        (let shown (call type-short-name types domain))
        (let member (str "." (. row name text)))
        (let written (if-expr (!= (. row type) 0) (str "(. " shown " " (. row name text) ")") member))
        (if (!= (. row type) 0)
          (= member (++ shown member))
        )
        (= site pattern)
        (return (str shown "." (. row name text) " is an enum value, not a union case; match it with " (if-expr (call (. tree is-brix)) (str "\"(case= " written " …)\"") (str "'|= " member "'"))))
      )
    )
    (return null)
  )
  (fn-do _ covers Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    ; Whether a pattern takes every value of a type. A list pattern of a rest alone takes every
    ; value that has items.
    (if (== pattern 0)
      (return true)
    )
    (match? ([] (. tree nodes) pattern)
      (case .node-type-wildcard
        (return true)
      )
      (case (call .node-type-transform row)
        (return (call covers (. row pattern) subject))
      )
      (case (call .node-type-capture row)
        (return (call covers (. row type) subject))
      )
    )
    (match? ([] (. types rows) subject)
      (case (call .type-result row)
        (if (call covers-whole pattern subject)
          (return true)
        )
        (if (and (!= (. row value) (. types void-type)) (not (call covers pattern (. row value))))
          (return false)
        )
        (for (in offset (..< 0 (. row errors count)))
          (if (not (call covers pattern (call (. types child-type) (. row errors) offset)))
            (return false)
          )
        )
        (return true)
      )
    )
    (if (== (call (. types intrinsic-of) subject) .union)
      (if (call covers-whole pattern subject)
        (return true)
      )
      (for (in index (..< 0 (. (call (. types cases-of) subject) length)))
        (let fact ([] (call (. types cases-of) subject) index))
        (if (or (. fact is-default) (== (. fact type) no-type) (not (call covers pattern (. fact type))))
          (return false)
        )
      )
      (return (!= (. (call (. types cases-of) subject) length) 0))
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-tuple row)
        (return (call covers-fields (. row field-types) subject))
      )
      (case (call .node-type-list row)
        (if (not (call is-collection-type tree pattern))
          (return
            (scope (and (== (. row patterns count) 1) remainder (call (. host has-items) subject))
              (lazy remainder (call is-remainder ([] ([] (. tree children) (. row patterns)) 0)))
            )
          )
        )
      )
      (case (call .node-type-or row)
        (return (or (call covers (. row left) subject) (call covers (. row right) subject)))
      )
      (case (call .node-type-and row)
        (return (and (call covers (. row left) subject) (call covers (. row right) subject)))
      )
      (case .node-type-case
        (return false)
      )
      (case .node-type-equality
        (return false)
      )
      (case .node-type-panic
        (return false)
      )
      (case .node-type-predicate
        (return false)
      )
    )
    (let target (call named-type pattern))
    (if (== target no-type)
      (return false)
    )
    (let relation (call (. relations compare) subject target false false null (. frame module)))
    (let down (or (== (. relation kind) .relation-down-cast) (== (. relation kind) .relation-interface-down-cast)))
    (return (and (not down) (call (. relations holds-as) relation (call required pattern))))
  )
  (fn-do _ covers-whole Bool
    (param pattern SyntaxId)
    (param subject TypeId)
    ; Whether a pattern takes a union as the one type it is, rather than case by case.
    (if (== pattern 0)
      (return true)
    )
    (match? ([] (. tree nodes) pattern)
      (case .node-type-wildcard
        (return true)
      )
      (case (call .node-type-transform row)
        (return (call covers-whole (. row pattern) subject))
      )
      (case (call .node-type-capture row)
        (return (call covers-whole (. row type) subject))
      )
      (case (call .node-type-or row)
        (return (or (call covers-whole (. row left) subject) (call covers-whole (. row right) subject)))
      )
      (case .node-type-tuple
        (return false)
      )
      (case .node-type-and
        (return false)
      )
      (case .node-type-case
        (return false)
      )
      (case .node-type-equality
        (return false)
      )
      (case .node-type-panic
        (return false)
      )
      (case .node-type-predicate
        (return false)
      )
    )
    (let target (call named-type pattern))
    (if (== target no-type)
      (return false)
    )
    (let relation (call (. relations compare) subject target false false null (. frame module)))
    (let kind (. relation kind))
    (return (or (== kind .relation-same) (== kind .relation-equal) (== kind .relation-or-cast)))
  )
  (fn-do _ lists-cover Bool
    (param index Size)
    ; Whether the arms that match a case by the items of its list take every list together: one
    ; of some count of items and a rest, as `[first, ...rest]`, and one of each smaller count, as
    ; `[]`, where each item they name is taken whatever it is.
    (let exact (list Size))
    (let least (. Size max))
    (for (in position (..< 0 (. listed-cases length)))
      (if (== ([] listed-cases position) index)
        (match? ([] (. tree nodes) ([] listed-patterns position))
          (case (call .node-type-list row)
            (let rest false)
            (let open true)
            (for (in element ([] (. tree children) (. row patterns)))
              (if (call is-remainder element)
                (= rest true)
                (else-if (not (call takes-any element))
                  (= open false)
                )
              )
            )
            (let count (as (. row patterns count) Size))
            (if (and open rest (< (- count 1) least))
              (= least (- count 1))
              (else-if (and open (not rest))
                (+= exact count)
              )
            )
          )
        )
      )
    )
    (if (== least (. Size max))
      (return false)
    )
    (for (in length (..< 0 least))
      (if (== (call (. exact find) length) null)
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ takes-any Bool
    (param pattern SyntaxId)
    (match ([] (. tree nodes) pattern)
      (case .node-type-wildcard
        true
      )
      (case .node-identifier
        true
      )
      (case (call .node-type-capture row)
        (== (. row type) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-remainder Bool
    (param pattern SyntaxId)
    (match ([] (. tree nodes) pattern)
      (case .node-type-remainder
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ covers-fields Bool
    (param fields (of RowRange SyntaxId))
    (param subject TypeId)
    (let count (call (. host tuple-arity) subject))
    (if (or (== count (. U32 max)) (!= count (. fields count)))
      (return false)
    )
    (let position 0u32)
    (for (in field ([] (. tree children) fields))
      (if (not (call covers field (call (. host field-of) subject position)))
        (return false)
      )
      (+= position 1)
    )
    (return true)
  )
  (fn-do _ named-type TypeId
    (param pattern SyntaxId)
    ; The type a pattern names, and no type for a pattern that names none. A type written in
    ; brackets names the list or the map of it.
    (let syntax pattern)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-match row)
        (= syntax (. row type))
      )
    )
    (if (call is-collection-type tree syntax)
      (let named (call (. types evaluate-type) (. frame module) tree syntax (. frame env)))
      (return (if-expr (!= named invalid-type) named no-type))
    )
    (match? ([] (. tree nodes) syntax)
      (case .node-type-identifier
        (let named (call (. types evaluate-type) (. frame module) tree syntax (. frame env)))
        (return (if-expr (!= named invalid-type) named no-type))
      )
      (case .node-type-arguments
        (let named (call (. types evaluate-type) (. frame module) tree syntax (. frame env)))
        (return (if-expr (!= named invalid-type) named no-type))
      )
      (case .node-type-optional
        (let named (call (. types evaluate-type) (. frame module) tree syntax (. frame env)))
        (return (if-expr (!= named invalid-type) named no-type))
      )
    )
    (return no-type)
  )
  (fn-do _ required Specificity
    (param pattern SyntaxId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-match row)
        (return (call required-match (. row op)))
      )
    )
    (return .similar)
  )
)

(fn-expr + is-collection-type Bool
  (param tree AST)
  (param pattern SyntaxId)
  ; Whether a pattern written in brackets is a type and no pattern of items: one type named
  ; between them is the type of a list of it, and one named for a key with one for what it
  ; holds that of a map, which the reference matches as it matches any type named.
  (match ([] (. tree nodes) pattern)
    (case (call .node-type-list row)
      (and (== (. row patterns count) 1) (call types-item tree ([] (. tree children) (. row patterns start))))
    )
    (case (call .node-type-map row)
      (and (== (. row patterns count) 1) (call types-item tree ([] (. tree children) (. row patterns start))))
    )
    (case (call .node-type-map-item row)
      (and (call types-item tree (. row key)) (call types-item tree (. row value)))
    )
    (default
      false
    )
  )
)

(fn-expr _ types-item Bool
  (param tree AST)
  (param pattern SyntaxId)
  (or (call (. tree names-type) pattern) (call is-collection-type tree pattern))
)
