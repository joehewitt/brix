(import ./types)
(import /core/arena)
(import /core/map)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(blank)
(prop + no-binding BindingId (= (. U32 max)))
(prop + no-slot SlotId (= (. U32 max)))
(prop + member-chain-limit _ (= 32u32))
(prop + loop-state-count _ (= 4u32))
(blank)
(prop _ forgotten-module ModuleId (= (. U32 max)))
(blank)
(type-line + BindingId (is U32))
(type-line + SlotId (is U32))
(type-line + ScopeId (is U32))
(type-line + LazyUseId (is U32))
(type-line + SlotMask (is U32))
(type-line + CaptureMask (is U32))
(type-line + LazyUseMask (is U32))
(type-line + ResolutionMask (is U32))

(type + Binding (is Struct)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + subtree SyntaxRange)
  (prop + slots (of RowRange Slot))
  (prop + scopes (of RowRange Scope))
  (prop + resolution-base U32)
  (prop + diagnostics (of RowRange Diagnostic))
  (prop + nested (of RowRange NestedFunction))
  (prop + scans (of RowRange BodyScan))
  (prop + sites (of RowRange ScanSite))
  (prop + windows (of RowRange SlotWindow))
  (prop + lazy-uses (of RowRange LazyUse))
  (prop + captures (of RowRange Capture))
  (prop + machines (of RowRange MachineSlots))
  (prop + machine-reads (of RowRange MachineRead))
)

(type + SlotKind (is U32)
  (variant slot-argument (= 0))
  (variant slot-local (= 1))
  (variant slot-lazy (= 2))
  (variant slot-pattern (= 3))
  (variant slot-loop-item (= 4))
  (variant slot-this (= 5))
  (variant slot-it (= 6))
  (variant slot-each (= 7))
  (variant slot-super (= 8))
  (variant slot-closure-env (= 9))
  (variant slot-held (= 10))
  (variant slot-loop-state (= 11))
  (variant slot-location (= 12))
  (variant slot-subscribers (= 13))
  (variant slot-builder (= 14))
  (variant slot-machine (= 15))
  (variant slot-use (= 16))
)

(type + SlotFlag (is U32)
  (variant slot-none (= 0))
  (variant slot-constant (= 1))
  (variant slot-assigned (= 2))
  (variant slot-address-taken (= 4))
  (variant slot-tracked (= 8))
  (variant slot-captured (= 16))
  (variant slot-by-value (= 32))
  (variant slot-assigned-own (= 64))
  (variant slot-together (= 128))
  (variant slot-placed (= 256))
  (variant slot-shared-read (= 512))
  (variant slot-self-used (= 1024))
  (variant slot-raised (= 2048))
)

(type + Slot (is Struct)
  (prop + kind SlotKind)
  (prop + name Atom)
  (prop + syntax SyntaxId)
  (prop + scope ScopeId)
  (prop + owner DeclId)
  (prop + group SyntaxId)
  (prop + flags SlotMask)
  (prop + use LazyUseId (= (. U32 max)))
  (prop + property SyntaxId (= 0))
  (prop + getter SyntaxId (= 0))
  (prop + namesake SlotId (= no-slot))
)

(type + LazyUseFlag (is U32)
  (variant use-none (= 0))
  (variant declared-in-loop (= 1))
  (variant read-in-loop (= 2))
  (variant read-in-nested (= 4))
  (variant read-in-branch (= 8))
  (variant read-in-subscription (= 16))
  (variant read-in-state-machine (= 32))
  (variant read-in-lazy (= 64))
)

(type + LazyPolicy (is U8)
  ; Where a lazy local takes its value, settled from its uses.
  ; - `lazy-inline`: its one read evaluates the value, each time the read runs. One declared in
  ;   a loop is not read in a loop of its turn or in a nested function.
  ; - `lazy-first-read`: a local declared in a loop and read more than once is evaluated by the
  ;   first of its reads, each time that read runs, and the others read what it stored.
  ; - `lazy-memo`: the value is evaluated once in a run of the function, by whichever read
  ;   comes first, which a flag cleared where the function starts remembers. An assignment
  ;   stores its value and sets the flag, so the value declared is not evaluated after it.
  ;   One declared in a loop is evaluated once a turn: its flag is cleared again where the
  ;   block that declares it starts, since a read may come before the line that declares it. A
  ;   local read tracked, one whose value reads something tracked outside a loop, and one
  ;   referred to, whose address a read of the local evaluates and takes, are kept so too.
  ; - `lazy-shared`: nested functions capture the local. Its value and its flag live in the
  ;   environment of the function that declares it, and whichever function reads it first
  ;   evaluates it there, once for the environment. An assignment stores and sets the flag.
  ;   Where the program's tables find that the function that declares it can give it its value
  ;   before it makes each nested function that reads it, the environment holds the value alone,
  ;   as an eager local's, and that function keeps the flag (`holds-lazy`).
  ; - `lazy-unsettled`: no rule here yet: one read in a state machine or in a loop on a stream
  ;   that no nested function captures it for, or one captured that is declared with others or
  ;   referred to.
  ; The locals one declaration names together take their values together, once in a run of
  ; the function, by whichever read of any of them comes first: `lazy-memo` for each, or
  ; unsettled where one of them is assigned or would be unsettled alone.
  ; A local that gives a property its value is evaluated for the property apart from this, and
  ; its reads in the values of other such locals are settled as any local's. A constructor that
  ; builds its own class reads the property itself where its body names one.
  (blank)
  (variant lazy-unsettled (= 0))
  (variant lazy-inline (= 1))
  (variant lazy-first-read (= 2))
  (variant lazy-memo (= 3))
  (variant lazy-shared (= 4))
)

(type + LazyUse (is Struct)
  (prop + slot SlotId)
  (prop + reads U32)
  (prop + writes U32)
  (prop + refs U32)
  (prop + tracked U32)
  (prop + flags LazyUseMask)
  (prop + branch-base U32)
  (prop + loop-base U32)
  (prop + subscription-base U32)
  (prop + state-base U32)
  (prop + policy LazyPolicy (= .lazy-unsettled))
  (prop + inlines Bool)
  (prop + reads-once Bool)
  (prop + flagged Bool)
  (prop + settled Bool)
  (prop + undominated Bool)
)

(type + CaptureFlag (is U32)
  (variant capture-none (= 0))
  (variant capture-by-value (= 1))
  (variant capture-assigned (= 2))
)

(type + Capture (is Struct)
  (prop + slot SlotId)
  (prop + flags CaptureMask)
)

(type + MachineSlots (is Struct)
  ; What a state machine keeps: slots no program names, declared in the scope of the machine's
  ; own function, whose environment holds them for as long as anything the machine subscribed
  ; can run. Each is named for what it holds and declared at the case or the first transition
  ; of a group it holds it for. `bound` is the local a machine written as a declaration's value
  ; is kept in, which the machine writes as it moves, or none; such a machine's flags are
  ; declared in the scope `bound` is, first, where a case test of the local reads them.
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + decl DeclId)
  (prop + slots (of RowRange Slot))
  (prop + bound SlotId)
)

(type + MachineRead (is Struct)
  ; What a name a case keeps reads where a transition enters the case: the local of that name
  ; in reach there, or none.
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + name Atom)
  (prop + slot SlotId)
)

(type + NestedFunction (is Struct)
  (prop + decl DeclId)
  (prop + syntax SyntaxId)
  (prop + scope ScopeId)
  (prop + captures (of RowRange Capture))
)

(type + ScanKind (is U32)
  (variant scan-yield (= 0))
  (variant scan-tracked-read (= 1))
  (variant scan-latest (= 2))
  (variant scan-use-expression (= 3))
  (variant scan-use-block (= 4))
  (variant scan-do-finally (= 5))
  (variant scan-stack-local (= 6))
  (variant scan-nested-function (= 7))
  (variant scan-call (= 8))
  (variant scan-assertion (= 9))
  (variant scan-force (= 10))
  (variant scan-index (= 11))
)

(type + BodyScan (is Struct)
  (prop + decl DeclId)
  (prop + syntax SyntaxId)
  (prop + yields U32)
  (prop + tracked-reads U32)
  (prop + latests U32)
  (prop + use-expressions U32)
  (prop + use-blocks U32)
  (prop + do-finallys U32)
  (prop + stack-locals U32)
  (prop + nested-functions U32)
  (prop + calls U32)
  (prop + assertions U32)
  (prop + forces U32)
  (prop + indexes U32)
)

(type + ScanSite (is Struct)
  ; Where a body does something its scan row counts: the scan row it belongs to, what it is, and
  ; the node. Sites follow the source order of their binding.
  (blank)
  (prop + scan U32)
  (prop + kind ScanKind)
  (prop + syntax SyntaxId)
)

(type + ScopeKind (is U32)
  ; What opens a scope. A loop's body and the activation of a case or continuation of a state
  ; machine run anew each time, and keep the names declared in them that nested functions capture
  ; in an environment of their own each time, a turn.
  (blank)
  (variant scope-function (= 0))
  (variant scope-nested (= 1))
  (variant scope-block (= 2))
  (variant scope-loop (= 3))
  (variant scope-arm (= 4))
  (variant scope-catch (= 5))
  (variant scope-use (= 6))
  (variant scope-do (= 7))
  (variant scope-activation (= 8))
)

(type + Scope (is Struct)
  (prop + parent ScopeId)
  (prop + kind ScopeKind)
  (prop + syntax SyntaxId)
)

(type + ResolutionKind (is U32)
  (variant resolve-none (= 0))
  (variant resolve-slot (= 1))
  (variant resolve-member (= 2))
  (variant resolve-global (= 3))
  (variant resolve-function (= 4))
  (variant resolve-type (= 5))
  (variant resolve-unresolved (= 6))
)

(type + ResolutionFlag (is U32)
  (variant resolution-none (= 0))
  (variant resolution-declares (= 1))
  (variant resolution-write (= 2))
  (variant resolution-ref (= 4))
  (variant resolution-tracked (= 8))
  (variant resolution-received (= 16))
  (variant resolution-styled (= 32))
  (variant resolution-quiet (= 64))
)

(type + Resolution (is Struct)
  (prop + kind ResolutionKind)
  (prop + module ModuleId)
  (prop + slot SlotId (= no-slot))
  (prop + decl DeclId (= 0))
  (prop + flags ResolutionMask)
)

(type + DiagnosticKind (is U32)
  (variant name-not-found (= 0))
  (variant already-defined (= 1))
  (variant required-self (= 2))
  (variant context-not-found (= 3))
  (variant variable-not-declared (= 4))
  (variant stream-not-found (= 5))
  (variant lazy-defined (= 6))
  (variant stated (= 7))
  (variant redeclared (= 8))
)

(type + Diagnostic (is Struct)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + kind DiagnosticKind)
  (prop + name (? Atom))
  (prop + earlier SyntaxId (= 0))
)

(type + SlotWindow (is Struct)
  (prop + syntax SyntaxId)
  (prop + slots (of RowRange Slot))
)

(type + Bindings
  (implements (of Usable Void))
  (prop + bindings (of Table Binding))
  (prop + slots (of Table Slot))
  (prop + scopes (of Table Scope))
  (prop + resolutions (of Table Resolution))
  (prop + diagnostics (of Table Diagnostic))
  (prop + lazy-uses (of Table LazyUse))
  (prop + nested (of Table NestedFunction))
  (prop + captures (of Table Capture))
  (prop + scans (of Table BodyScan))
  (prop + scan-sites (of Table ScanSite))
  (prop + windows (of Table SlotWindow))
  (prop + machines (of Table MachineSlots))
  (prop + machine-reads (of Table MachineRead))
  (blank)
  (prop _ arena Arena)
  (prop _ by-decl (of Map Size U32 ArenaBacking))
  (prop _ copies (list BindingCopy))
  (prop _ ends Binding)
  (prop _ taking Bool)
  (prop _ copying (? TaskGroup))
  (fn-do + This _
    (lazy bindings (call (of Table Binding) arena 16))
    (lazy slots (call (of Table Slot) arena 16))
    (lazy scopes (call (of Table Scope) arena 16))
    (lazy resolutions (call (of Table Resolution) arena 16))
    (lazy diagnostics (call (of Table Diagnostic) arena 16))
    (lazy lazy-uses (call (of Table LazyUse) arena 16))
    (lazy nested (call (of Table NestedFunction) arena 16))
    (lazy captures (call (of Table Capture) arena 16))
    (lazy scans (call (of Table BodyScan) arena 16))
    (lazy scan-sites (call (of Table ScanSite) arena 16))
    (lazy windows (call (of Table SlotWindow) arena 16))
    (lazy machines (call (of Table MachineSlots) arena 4))
    (lazy machine-reads (call (of Table MachineRead) arena 4))
    (lazy by-decl (call (of Map Size U32) arena))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (call (. arena release))
  )
  (fn-expr + is-trackable Bool
    (param slot SlotId)
    ; Whether a local is one a tracked read tracks: a lazy local, one a declaration names, or an
    ; argument.
    (or (== kind .slot-local) (== kind .slot-lazy) (== kind .slot-argument))
    (where
      (lazy kind (. ([] slots slot) kind))
    )
  )
  (fn-do + function-scope ScopeId
    (param scope ScopeId)
    ; The scope of the function or the nested function a scope lies in.
    (let found scope)
    (while (and (!= (. ([] scopes found) kind) .scope-function) (!= (. ([] scopes found) kind) .scope-nested))
      (= found (. ([] scopes found) parent))
    )
    (return found)
  )
  (fn-expr + binding-for (? BindingId)
    (param module ModuleId)
    (param decl DeclId)
    ([] by-decl (. (call DeclRef module decl) key))
  )
  (fn-do + forget-module _
    (param module ModuleId)
    ; Forgets the bindings of a module's declarations, and the diagnostics and state machines it
    ; bound, so that binding the module again finds and counts only what it binds then.
    (let forgotten (list Size))
    (for (in (tuple key _) by-decl)
      (if (== (/rshift/ key 32) (as module Size))
        (+= forgotten key)
      )
    )
    (for (in key forgotten)
      (-= ([] by-decl key))
    )
    (for (in index (..< 0 (. machines length)))
      (if (== (. ([] machines index) module) module)
        (= (. ([] machines index) module) forgotten-module)
      )
    )
    (for (in index (..< 0 (. diagnostics length)))
      (if (== (. ([] diagnostics index) module) module)
        (= (. ([] diagnostics index) module) forgotten-module)
      )
    )
  )
  (fn-do + reports Bool
    (param skipped (? ModuleId) (= null))
    (for (in diagnostic diagnostics)
      (if (and (!= (. diagnostic module) forgotten-module) (!= (. diagnostic module) skipped) not-redeclared)
        (return true)
      )
      (lazy not-redeclared (!= (. diagnostic kind) .redeclared))
    )
    (return false)
  )
  (fn-do + reserve BindingId
    (param module ModuleId)
    (param decl DeclId)
    (param subtree SyntaxRange)
    (let row
      (call Binding
        (block
          (arg module)
          (arg decl)
          (arg subtree)
          (arg (call (of RowRange Slot) (as (. slots length) U32) 0))
          (arg (call (of RowRange Scope) (as (. scopes length) U32) 0))
          (arg (as (. resolutions length) U32))
          (arg (call (of RowRange Diagnostic) (as (. diagnostics length) U32) 0))
          (arg (call (of RowRange NestedFunction) (as (. nested length) U32) 0))
          (arg (call (of RowRange BodyScan) (as (. scans length) U32) 0))
          (arg (call (of RowRange ScanSite) (as (. scan-sites length) U32) 0))
          (arg (call (of RowRange SlotWindow) (as (. windows length) U32) 0))
          (arg (call (of RowRange LazyUse) (as (. lazy-uses length) U32) 0))
          (arg (call (of RowRange Capture) (as (. captures length) U32) 0))
          (arg (call (of RowRange MachineSlots) (as (. machines length) U32) 0))
          (arg (call (of RowRange MachineRead) (as (. machine-reads length) U32) 0))
        )
      )
    )
    (let id (as (call (. bindings append) row) BindingId))
    (= ([] by-decl (. (call DeclRef module decl) key)) id)
    (for (in _ (..< 0 (. subtree count)))
      (call (. resolutions append) (call Resolution .resolve-none 0 no-slot 0 0))
    )
    (return id)
  )
  (fn-do + finish _
    (param id BindingId)
    (param tree AST)
    ; Closes a binding's tables, settles the plan of each of its lazy locals, now that every use
    ; of them is counted, and links each local with its namesakes.
    (let row ([] bindings id))
    (let slot-count (as (- (. slots length) (. row slots start)) U32))
    (let scope-count (as (- (. scopes length) (. row scopes start)) U32))
    (let diagnostic-count (as (- (. diagnostics length) (. row diagnostics start)) U32))
    (let nested-count (as (- (. nested length) (. row nested start)) U32))
    (let scan-count (as (- (. scans length) (. row scans start)) U32))
    (let site-count (as (- (. scan-sites length) (. row sites start)) U32))
    (= (. ([] bindings id) slots) (call (of RowRange Slot) (. row slots start) slot-count))
    (= (. ([] bindings id) scopes) (call (of RowRange Scope) (. row scopes start) scope-count))
    (= (. ([] bindings id) diagnostics) (call (of RowRange Diagnostic) (. row diagnostics start) diagnostic-count))
    (= (. ([] bindings id) nested) (call (of RowRange NestedFunction) (. row nested start) nested-count))
    (= (. ([] bindings id) scans) (call (of RowRange BodyScan) (. row scans start) scan-count))
    (= (. ([] bindings id) sites) (call (of RowRange ScanSite) (. row sites start) site-count))
    (= (. ([] bindings id) windows)
      (call (of RowRange SlotWindow)
        (block
          (arg (. row windows start))
          (arg (as (- (. windows length) (. row windows start)) U32))
        )
      )
    )
    (= (. ([] bindings id) lazy-uses)
      (call (of RowRange LazyUse)
        (block
          (arg (. row lazy-uses start))
          (arg (as (- (. lazy-uses length) (. row lazy-uses start)) U32))
        )
      )
    )
    (= (. ([] bindings id) captures)
      (call (of RowRange Capture)
        (block
          (arg (. row captures start))
          (arg (as (- (. captures length) (. row captures start)) U32))
        )
      )
    )
    (= (. ([] bindings id) machines)
      (call (of RowRange MachineSlots)
        (block
          (arg (. row machines start))
          (arg (as (- (. machines length) (. row machines start)) U32))
        )
      )
    )
    (= (. ([] bindings id) machine-reads)
      (call (of RowRange MachineRead)
        (block
          (arg (. row machine-reads start))
          (arg (as (- (. machine-reads length) (. row machine-reads start)) U32))
        )
      )
    )
    (for (in slot (..< (. row slots start) (. slots length)))
      (if (!= (. ([] slots slot) kind) .slot-lazy)
        (continue)
      )
      (match? ([] (. tree nodes) (. ([] slots slot) group))
        (case (call .node-declare declaration)
          (if (and (not (. declaration is-pattern)) (call names-several tree (. declaration left)))
            (= (. ([] slots slot) flags) (/or/ (. ([] slots slot) flags) (. SlotFlag slot-together)))
          )
        )
      )
      (let use (. ([] slots slot) use))
      (if (!= use (. U32 max))
        (= (. ([] lazy-uses use) policy) (call policy-of tree (as slot SlotId)))
        (= (. ([] lazy-uses use) inlines) (call inlines-of tree (as slot SlotId)))
        (= (. ([] lazy-uses use) reads-once) (call reads-once-of tree (as slot SlotId)))
        (= (. ([] lazy-uses use) flagged) (call flagged-of tree (as slot SlotId)))
      )
    )
    (call link-namesakes (. row slots start))
  )
  (fn-do + take BindingId
    (param other Bindings)
    (param id BindingId)
    ; The binding here of the function that `other`'s binding `id` binds, taken from `other` the
    ; first time it is asked for, as binding the function here would make it: each slot, scope, lazy
    ; use, capture and scan its rows name is numbered here.
    (let row ([] (. other bindings) id))
    (let existing (call binding-for (. row module) (. row decl)))
    (if existing
      (return existing)
    )
    (throw (call Panic "Bindings takes a binding of another pass only while taking") (if (or (not taking) copying)))
    (blank)
    (let taken
      (call Binding
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row subtree))
          (arg (call (of RowRange Slot) (as (. slots length) U32) (. row slots count)))
          (arg (call (of RowRange Scope) (as (. scopes length) U32) (. row scopes count)))
          (arg (+ (. ends resolution-base) (. ends subtree count)))
          (arg (call (of RowRange Diagnostic) (. ends diagnostics end) (. row diagnostics count)))
          (arg (call (of RowRange NestedFunction) (. ends nested end) (. row nested count)))
          (arg (call (of RowRange BodyScan) (. ends scans end) (. row scans count)))
          (arg (call (of RowRange ScanSite) (. ends sites end) (. row sites count)))
          (arg (call (of RowRange SlotWindow) (. ends windows end) (. row windows count)))
          (arg (call (of RowRange LazyUse) (. ends lazy-uses end) (. row lazy-uses count)))
          (arg (call (of RowRange Capture) (. ends captures end) (. row captures count)))
          (arg (call (of RowRange MachineSlots) (. ends machines end) (. row machines count)))
          (arg (call (of RowRange MachineRead) (. ends machine-reads end) (. row machine-reads count)))
        )
      )
    )
    (let made (as (call (. bindings append) taken) BindingId))
    (= ([] by-decl (. (call DeclRef (. row module) (. row decl)) key)) made)
    (for (in offset (..< 0 (. row slots count)))
      (let slot (as ([] (. other slots) (+ (. row slots start) offset)) Slot))
      (= (. slot scope) (call moved (. slot scope) (. row scopes start) (. row scopes count) (. taken scopes start)))
      (if (!= (. slot use) (. U32 max))
        (= (. slot use) (call moved (. slot use) (. row lazy-uses start) (. row lazy-uses count) (. taken lazy-uses start)))
      )
      (if (!= (. slot namesake) no-slot)
        (= (. slot namesake) (call moved (. slot namesake) (. row slots start) (. row slots count) (. taken slots start)))
      )
      (call (. slots append) slot)
    )
    (for (in offset (..< 0 (. row scopes count)))
      (let scope (as ([] (. other scopes) (+ (. row scopes start) offset)) Scope))
      (if (!= offset 0)
        (= (. scope parent) (call moved (. scope parent) (. row scopes start) (. row scopes count) (. taken scopes start)))
      )
      (call (. scopes append) scope)
    )
    (= ends taken)
    (+= copies (call BindingCopy other id taken))
    (return made)
  )
  (fn-do + begin-taking _
    (throw (call Panic "Bindings is taking the bindings of other passes already") (if taking))
    (blank)
    (= taking true)
    (= ends
      (call Binding
        (block
          (arg 0)
          (arg 0)
          (arg (call SyntaxRange 0 0))
          (arg (call (of RowRange Slot) (as (. slots length) U32) 0))
          (arg (call (of RowRange Scope) (as (. scopes length) U32) 0))
          (arg (as (. resolutions length) U32))
          (arg (call (of RowRange Diagnostic) (as (. diagnostics length) U32) 0))
          (arg (call (of RowRange NestedFunction) (as (. nested length) U32) 0))
          (arg (call (of RowRange BodyScan) (as (. scans length) U32) 0))
          (arg (call (of RowRange ScanSite) (as (. scan-sites length) U32) 0))
          (arg (call (of RowRange SlotWindow) (as (. windows length) U32) 0))
          (arg (call (of RowRange LazyUse) (as (. lazy-uses length) U32) 0))
          (arg (call (of RowRange Capture) (as (. captures length) U32) 0))
          (arg (call (of RowRange MachineSlots) (as (. machines length) U32) 0))
          (arg (call (of RowRange MachineRead) (as (. machine-reads length) U32) 0))
        )
      )
    )
  )
  (fn-do + start-copying _
    (param pool Worker)
    (throw (call Panic "Bindings copies only the bindings it took") (if (or (not taking) copying)))
    (blank)
    (call (. resolutions reserve) (+ (. ends resolution-base) (. ends subtree count)))
    (call (. diagnostics reserve) (. ends diagnostics end))
    (call (. nested reserve) (. ends nested end))
    (call (. scans reserve) (. ends scans end))
    (call (. scan-sites reserve) (. ends sites end))
    (call (. windows reserve) (. ends windows end))
    (call (. lazy-uses reserve) (. ends lazy-uses end))
    (call (. captures reserve) (. ends captures end))
    (call (. machines reserve) (. ends machines end))
    (call (. machine-reads reserve) (. ends machine-reads end))
    (let pending copies)
    (let group (call TaskGroup))
    (= copying group)
    (let task
      (do-new (worker: pool)
        (for (in copy pending)
          (call copy-rows copy)
        )
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (fn-do + end-taking _
    (let group copying)
    (if group
      (call (. group settle))
    )
    (= copying null)
    (= copies (call (of List BindingCopy)))
    (= taking false)
    (if group
      (call (. group wait))
    )
  )
  (fn-do + machine-slots (? MachineSlots)
    (param module ModuleId)
    (param syntax SyntaxId)
    ; What the binder declared for a state machine written at a node of a module, if it bound one.
    (for (in index (..< 0 (. machines length)))
      (if (and (== (. ([] machines index) module) module) (== (. ([] machines index) syntax) syntax))
        (return ([] machines index))
      )
    )
    (return null)
  )
  (fn-do + machine-slot SlotId
    (param row MachineSlots)
    (param node SyntaxId)
    (param name Atom)
    ; The slot a machine keeps under a name for a case or a group, or none.
    (for (in slot (..< (. row slots start) (+ (. row slots start) (. row slots count))))
      (if (and (== (. ([] slots slot) syntax) node) (== (. ([] slots slot) name) name))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-expr + activation-tasks SlotId
    (param id BindingId)
    (param task SyntaxId)
    (param tasks Atom)
    ; The slot a machine keeps the `TaskOwner` of a case's activation in, under the name `tasks`,
    ; where the binder gave the task spawned at a node to that activation; or none.
    (case? (and (== (. resolution kind) .resolve-slot) (!= (. resolution slot) no-slot) (== (. ([] slots (. resolution slot)) name) tasks))
      (. resolution slot)
    )
    (default
      no-slot
    )
    (where
      (lazy resolution (call resolution-of id task))
    )
  )
  (fn-do + declared-at SlotId
    (param range (of RowRange Slot))
    (param node SyntaxId)
    (param name Atom)
    ; The slot of a name declared at a node among a range of slots, or none.
    (for (in slot (..< (. range start) (+ (. range start) (. range count))))
      (if (and (== (. ([] slots slot) syntax) node) (== (. ([] slots slot) name) name))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-do + declared-kind-at SlotId
    (param range (of RowRange Slot))
    (param node SyntaxId)
    (param kind SlotKind)
    ; The slot of a kind declared at a node among a range of slots, or none.
    (for (in slot (..< (. range start) (+ (. range start) (. range count))))
      (if (and (== (. ([] slots slot) syntax) node) (== (. ([] slots slot) kind) kind))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-do + window-of (of RowRange Slot)
    (param id BindingId)
    (param syntax SyntaxId)
    ; The locals the value of a property holds: those the binder declared for it, which are few
    ; beside all of its module's main. No locals for a property that declared none.
    (let row ([] bindings id))
    (let low (. row windows start))
    (let end (+ low (. row windows count)))
    (let high end)
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< (. ([] windows middle) syntax) syntax)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (if (and (< low end) (== (. ([] windows low) syntax) syntax))
      (return (. ([] windows low) slots))
    )
    (return (call (of RowRange Slot) (. row slots start) 0))
  )
  (fn-expr + resolution-of Resolution
    (param id BindingId)
    (param syntax SyntaxId)
    (case? (or (< syntax (. row subtree start)) (>= syntax (+ (. row subtree start) (. row subtree count))))
      (call Resolution .resolve-none 0 no-slot 0 0)
    )
    (default
      ([] resolutions (- (+ (. row resolution-base) syntax) (. row subtree start)))
    )
    (where
      (lazy row ([] bindings id))
    )
  )
  (fn-do + loop-state SlotId
    (param id BindingId)
    (param loop SyntaxId)
    ; The first of the slots that keep what a loop holds from one pass to the next, which no
    ; name reaches. The header of a loop resolves to the first slot declared for it: `each` or
    ; `it` where its body may read one, and these follow.
    (let first (call resolution-of id loop))
    (if (!= (. first kind) .resolve-slot)
      (return no-slot)
    )
    (let slot (. first slot))
    (while (and (< slot (. slots length)) (== (. ([] slots slot) syntax) loop) (!= (. ([] slots slot) kind) .slot-loop-state))
      (+= slot 1)
    )
    (if (and (< slot (. slots length)) (== (. ([] slots slot) syntax) loop))
      (return slot)
    )
    (return no-slot)
  )
  (fn-expr + using-slot SlotId
    (param id BindingId)
    (param use SyntaxId)
    ; The slot that keeps the object of a `use` where its end may run, which no name reaches.
    (case? (or (!= (. found kind) .resolve-slot) (>= (. found slot) (. slots length)) (!= (. ([] slots (. found slot)) kind) .slot-use))
      no-slot
    )
    (default
      (. found slot)
    )
    (where
      (lazy found (call resolution-of id use))
    )
  )
  (fn-do + set-resolution _
    (param id BindingId)
    (param syntax SyntaxId)
    (param resolution Resolution)
    (let row ([] bindings id))
    (if (or (< syntax (. row subtree start)) (>= syntax (+ (. row subtree start) (. row subtree count))))
      (return)
    )
    (= ([] resolutions (- (+ (. row resolution-base) syntax) (. row subtree start))) resolution)
  )
  (fn-do + record-lazy-use _
    (param slot SlotId)
    (param reads U32)
    (param writes U32)
    (param refs U32)
    (param tracked U32)
    (param flags U32)
    (if (== (. ([] slots slot) use) (. U32 max))
      (= (. ([] slots slot) use) (as (call (. lazy-uses append) (call LazyUse slot 0 0 0 0 0 0 0 0 0)) LazyUseId))
    )
    (let use (. ([] slots slot) use))
    (+= (. ([] lazy-uses use) reads) reads)
    (+= (. ([] lazy-uses use) writes) writes)
    (+= (. ([] lazy-uses use) refs) refs)
    (+= (. ([] lazy-uses use) tracked) tracked)
    (= (. ([] lazy-uses use) flags) (/or/ (. ([] lazy-uses use) flags) flags))
  )
  (fn-do + set-lazy-bases _
    (param slot SlotId)
    (param branch U32)
    (param loop U32)
    (param subscription U32)
    (param state U32)
    (let use (. ([] slots slot) use))
    (= (. ([] lazy-uses use) branch-base) branch)
    (= (. ([] lazy-uses use) loop-base) loop)
    (= (. ([] lazy-uses use) subscription-base) subscription)
    (= (. ([] lazy-uses use) state-base) state)
  )
  (fn-do + settle-lazy-read _
    (param slot SlotId)
    ; Notes a read of a lazy local in the function that declares it that runs each time the scope
    ; that declares it runs, outside any loop, branch or value of a lazy local of its own.
    (= (. ([] lazy-uses (. ([] slots slot) use)) settled) true)
  )
  (fn-do + note-lazy-capture _
    (param slot SlotId)
    (param within-lazy Bool)
    ; Notes a nested function written in the function that declares a lazy local, which reads the
    ; local: one written in the value of a lazy local, or before any read `settle-lazy-read` noted,
    ; is not sure to be made after the local has its value.
    (let use (. ([] slots slot) use))
    (if (or within-lazy (not (. ([] lazy-uses use) settled)))
      (= (. ([] lazy-uses use) undominated) true)
    )
  )
  (fn-expr + lazy-dominated Bool
    (param slot SlotId)
    ; Whether each nested function written in the function that declares a lazy local, which reads
    ; the local, is made after a read of it that its scope always runs.
    (and (!= (. ([] slots slot) use) (. U32 max)) (not (. ([] lazy-uses (. ([] slots slot) use)) undominated)))
  )
  (fn-expr + lazy-use-of LazyUse
    (param slot SlotId)
    ([] lazy-uses (. ([] slots slot) use))
  )
  (fn-expr + lazy-inlines Bool
    (param slot SlotId)
    ; Whether a lazy local's one read evaluates it, as its binding settled.
    (and (!= (. ([] slots slot) use) (. U32 max)) (. ([] lazy-uses (. ([] slots slot) use)) inlines))
  )
  (fn-expr + lazy-reads-once Bool
    (param slot SlotId)
    ; Whether a lazy local is read in one place that runs no more than once each time the value
    ; it is declared under is evaluated, as its binding settled.
    (and (!= (. ([] slots slot) use) (. U32 max)) (. ([] lazy-uses (. ([] slots slot) use)) reads-once))
  )
  (fn-expr + lazy-flagged Bool
    (param slot SlotId)
    ; Whether a lazy local is kept behind a flag, as its binding settled.
    (and (!= (. ([] slots slot) use) (. U32 max)) (. ([] lazy-uses (. ([] slots slot) use)) flagged))
  )
  (fn-expr + lazy-policy LazyPolicy
    (param slot SlotId)
    ; Where a lazy local takes its value, as its binding settled.
    (case? (!= (. ([] slots slot) use) (. U32 max))
      (. ([] lazy-uses (. ([] slots slot) use)) policy)
    )
    (default
      (. LazyPolicy lazy-unsettled)
    )
  )
  (fn-expr + lazy-together Bool
    (param slot SlotId)
    ; Whether a lazy local is declared together with others, which take their values with it.
    (!= (/and/ (. ([] slots slot) flags) (. SlotFlag slot-together)) 0)
