./facts
./instances
./session
./stable-key
/core/table
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/stream/sort

+ no-edge U32 = U32.max

━━━━━━━━━━━━━━━━━━━━
+ CallEdgeKind is U32

| edge-call = 0
| edge-convert = 1
| edge-answer = 2
| edge-made = 3
| edge-value = 4

━━━━━━━━━━━━━━━━━━━━
+ CallEdge is Tuple

` How one instance reaches another, at a node of the one that reaches it: a call, with the fact
` that records it; a conversion that runs a function, with its fact; the answer an interface's
` function or a method a class declares again is given by a function that answers for it, at no
` node; a nested function, where the function it is written in makes it; or a function that
` becomes a value of a function type, where it becomes one.

+ caller InstanceId
+ callee InstanceId
+ syntax SyntaxId
+ kind CallEdgeKind
+ fact FactId = no-fact

━━━━━━━━━━━━━━━━━━━━
+ EdgeStep is U32

| step-skip = 0
| step-follow = 1
| step-reach = 2

━━━━━━━━━━━━━━━━━━━━
_ KeyedEdge is Tuple

+ key StableKey
+ index U32

━━━━━━━━━━━━━━━━━━━━
_ compare-keyed Comparison
    - left KeyedEdge
    - right KeyedEdge

|? left.key != right.key
    compare-basic(left.key, right.key)
??
    compare-basic(left.index, right.index)

━━━━━━━━━━━━━━━━━━━━
+ CallPaths

` How instances reach one another once typing ends, and the shortest chain from one to another,
` found breadth first. The edges are indexed both ways when first asked for, in the order of the
` stable keys of the instances they leave, so a chain is the same in any order of typing.

_ session Session
_ indexed = false
_ edges [CallEdge]
_ out-heads [U32]
_ out-links [U32]
_ in-heads [U32]
_ in-links [U32]

────────────────────
+ This
    - session

────────────────────
+ do chain-to [CallEdge]?
    - target InstanceId
    - step

` The shortest chain that ends at an instance, walked back from it. `step` says of each edge
` reached whether the walk goes on to the instance it leaves, ends there with the chain, or
` leaves it. None where no edge ends the walk.
index()
. parent [InstanceId = U32]
. queue [InstanceId]
queue += target
parent[target] = no-edge
. next Size = 0
while next < queue.length
    . current = queue[next]
    next += 1
    . link = in-heads[current]
    while link != no-edge
        . edge = edges[link]
        . chosen EdgeStep = step(edge)
        if chosen == .step-reach
            = forward-chain(parent, link, target)
        if chosen == .step-follow && parent[edge.caller] == null
            parent[edge.caller] = link
            queue += edge.caller
        link = in-links[link]
= null

────────────────────
+ do chain-from [CallEdge]?
    - start InstanceId
    - follows
    - reaches

` The shortest chain from an instance to the first one `reaches` accepts, along the edges
` `follows` accepts: empty where the instance itself is accepted, none where no instance is.
index()
. parent [InstanceId = U32]
. queue [InstanceId]
queue += start
parent[start] = no-edge
. next Size = 0
while next < queue.length
    . current = queue[next]
    next += 1
    if reaches(current)
        = backward-chain(parent, current, start)
    . link = out-heads[current]
    while link != no-edge
        . edge = edges[link]
        if parent[edge.callee] == null && follows(edge)
            parent[edge.callee] = link
            queue += edge.callee
        link = out-links[link]
= null

────────────────────
+ do edges-into [CallEdge]
    - target InstanceId

` The edges that reach an instance, in the order of the stable keys of the instances they leave.
index()
. found [CallEdge]
. link = in-heads[target]
while link != no-edge
    found += edges[link]
    link = in-links[link]
= found

────────────────────
+ do names [String]
    - chain [CallEdge]

= List'String(name-of(each.callee) in chain)

────────────────────
+ do name-of String
    - instance InstanceId

` The name a chain shows for an instance: a function's, a method's with its class, a class's
` for its constructor, the code of a module for its statements, or the function a nested one
` is written in.
. row = session.instances.rows[instance]
. owner-module = session.program.modules[row.module]
=? "main" if owner-module.main-decl == row.decl
. decls = owner-module.decls
do match? decls[row.decl]
    | .decl-function(fn)
        . owner = class-named(decls, fn.owner)
        =? owner if fn.kind == .constructor-decl && owner.length != 0
        . name = fn.name
        if name
            =? "${owner}.${name.text}" if owner.length != 0
            = name.text
        =? "a function in ${name-of(row.enclosing)}" if row.enclosing != no-instance
    | .decl-converter(converter)
        = "the converter of ${class-named(decls, converter.owner)}"
    | .decl-fromverter(fromverter)
        = "the fromverter of ${class-named(decls, fromverter.owner)}"
= "a function"

────────────────────
_ do forward-chain [CallEdge]
    - parent [InstanceId = U32]
    - first U32
    - target InstanceId

. chain [CallEdge]
chain += edges[first]
. cursor = edges[first].callee
while cursor != target
    . link = parent[cursor] ?? no-edge
    =? chain if link == no-edge
    chain += edges[link]
    cursor = edges[link].callee
= chain

────────────────────
_ do backward-chain [CallEdge]
    - parent [InstanceId = U32]
    - end InstanceId
    - start InstanceId

. chain [CallEdge]
. cursor = end
while cursor != start
    . link = parent[cursor] ?? no-edge
    =? chain if link == no-edge
    chain.insert(edges[link], 0)
    cursor = edges[link].caller
= chain

────────────────────
_ do index

=? if indexed
indexed = true
. instances = session.instances
. facts = session.facts
. found [CallEdge]
for position in 0 .. < facts.calls.length
    . call = facts.calls[position]
    if call.callee != no-instance && call.instance != instances.dead
        found += CallEdge(call.instance, call.callee, call.syntax, .edge-call, position as FactId)
for slot in facts.witness-slots
    if slot.proto != no-instance && slot.callee != no-instance
        found += CallEdge(slot.proto, slot.callee, 0, .edge-answer)
for fact in facts.overrides
    if fact.override != no-instance
        found += CallEdge(fact.base, fact.override, 0, .edge-answer)
for position in 0 .. < facts.conversions.length
    . fact = facts.conversions[position]
    if fact.instance != instances.dead
        if fact.callee != no-instance
            found += CallEdge(fact.instance, fact.callee, fact.syntax, .edge-convert, position as FactId)
        if fact.runs != no-instance
            found += CallEdge(fact.instance, fact.runs, fact.syntax, .edge-value)
for fact in facts.conversion-parts
    if fact.instance != instances.dead && fact.runs != no-instance
        found += CallEdge(fact.instance, fact.runs, fact.syntax, .edge-value)
for position in 0 .. < instances.length
    . row = instances.rows[position]
    . id = position as InstanceId
    if row.enclosing != no-instance && row.probe == 0 && id != instances.dead
        . made = made-at(id)
        if made != 0
            found += CallEdge(row.enclosing, id, made, .edge-made)
. keyed [KeyedEdge]
for position in 0 .. < found.length
    keyed += KeyedEdge(instances.stable-keys[found[position].caller], position as U32)
. sorted = sort(keyed) • using compare-keyed
for item in sorted
    edges += found[item.index]
    out-links += no-edge
    in-links += no-edge
for position in 0 .. < instances.length
    out-heads += no-edge
    in-heads += no-edge
. position = edges.length
while position > 0
    position -= 1
    . edge = edges[position]
    out-links[position] = out-heads[edge.caller]
    out-heads[edge.caller] = position as U32
    in-links[position] = in-heads[edge.callee]
    in-heads[edge.callee] = position as U32

────────────────────
_ do made-at SyntaxId
    - instance InstanceId

` Where a nested function is written in the function it is nested in, or none for any other.
. row = session.instances.rows[instance]
do match? session.program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        =? fn.syntax if is-nested-kind(fn.kind)
= 0

━━━━━━━━━━━━━━━━━━━━
_ class-named String
    - decls ImmutableTable'Decl
    - owner DeclId

match decls[owner]
    | .decl-class(owned)
        owned.name.text
    ??
        ""
