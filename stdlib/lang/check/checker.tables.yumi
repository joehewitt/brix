━━━━━━━━━━━━━━━━━━━━
_ Tables is facet of Checker

────────────────────
+ do row-case-field TypeId
    - id SyntaxId
    - receiver TypeId
    - name Atom

` The field every case of a union shares, which a table row over the union reads in place:
` one the cases inherit from one declaration is planned as a field of the row, kept in a
` column of its own.
. row = calls.union-row(receiver)
if row == no-type
    = no-type
. shared = shared-case-field-type(row, name)
if shared != no-type
    . held = types.cases-of(row)
    . first = property-named(held[0].type, name) if held.length != 0
    if first && is-common-field(types, row, types.properties[first])
        plan-table(id, .table-field, types.properties[first].slot)
= shared

────────────────────
+ row-answers Bool
    - receiver TypeId
    - name Atom

` Whether a row of a table reads a name as a field of its row, or of the case its row holds,
` where the row's own member of the name is private, as TypeScript reads one past a member it
` may not use.
|? kind != .table-row && kind != .immutable-table-row
    false
|? row == no-type
    false
|? types.intrinsic-of(row) == .union && has-case-getter(row, name)
    true
??
    property-named(row, name) != null

.. kind = types.intrinsic-of(receiver)
.. row = row-struct-of(receiver)

────────────────────
+ do array-views TypeId
    - receiver TypeId
    - name Atom

. is-rows = name.text == "rows"
if !is-rows && name.text != "fields"
    = no-type
. immutable = types.ancestor-of(receiver, types.immutable-array-decl)
. array = if immutable != no-type then immutable else types.ancestor-of(receiver, types.array-decl)
if array == no-type
    = no-type
. access = if immutable != no-type then types.array-read-access else types.array-write-access
. owner = if is-rows then types.array-rows-decl else types.array-fields-decl
= types.array-view-of(owner, row-struct-of(array), access)

────────────────────
+ do plan-view
    - id SyntaxId
    - slot U32 = U32.max

` A node the compiler answers for a view of an array, which may raise the panics of a view:
` with the place in the item's layout of the field a row or a view of fields is read at.
if slot == U32.max
    facts.set-plan(instance, id, .plan-view)
else
    facts.set-constant(instance, id, ConstantFact(slot, 0.0, null, false), .plan-view)
instances.mark-may-panic(instance)

────────────────────
+ do plan-table
    - id SyntaxId
    - op TableOp
    - slot U32 = 0

` A node the compiler answers for a table or a view of one, as TypeScript intercepts it before
` any method, which may raise the panics of a table: the operation, and the place in the row's
` layout of the field it reads or writes.
. bits = (op as U64) /or/ ((slot as U64) /lshift/ 32)
facts.set-constant(instance, id, ConstantFact(bits, 0.0, null, false), .plan-table)
instances.mark-may-panic(instance)

────────────────────
+ do plan-builder
    - id SyntaxId
    - builder TypeId
    - name String
    - count Size

` A member of an arena's builder that TypeScript answers where it is called, which may raise
` the panics of its growth: `append` of an item and `reserve`. The constant tells whether the
` arena traces the builder's items.
. item = types.builder-item(builder)
if item == no-type || item == invalid-type
    =
. appends = name == "append" && count == 1
if !appends && name != "reserve"
    =
. plan = if appends then OperatorPlan.plan-builder-append else OperatorPlan.plan-builder-reserve
. traces U64 = if calls.arena-traces(item) then 1 else 0
facts.set-constant(instance, id, ConstantFact(traces, 0.0, null, false), plan)
instances.mark-may-panic(instance)

────────────────────
+ do note-span-range

` The range the constructor of an index span is given is made forward where the constructor
` runs, as TypeScript makes it: the call is recorded at no node of the constructor, which may
` raise the panics of a range that does not fit.
. range = instances.argument-type(instance, 1)
. shapes = scratch.call-arguments.mark
. given = scratch.types.mark
. written = scratch.syntax.mark
. none = arguments-since(shapes, given, written, scratch.no-types)
calls.method-call(0, 0, range, program.store-atom("forward"), none)
instances.mark-may-panic(instance)

────────────────────
+ is-table-view Bool
    - receiver TypeId

` Whether an index of a value of the type may be one the compiler answers for a table or a view
` of one (`plan-table-index`), which says whether the index makes a call.
kind == .table || kind == .immutable-table || spans || columns || selects || kind == .index-span

.. kind = types.intrinsic-of(receiver)
.. spans = kind == .table-span || kind == .immutable-table-span
.. columns = kind == .table-column || kind == .immutable-table-column
.. selects = kind == .table-selection || kind == .immutable-table-selection

────────────────────
+ do plan-table-index Bool
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId
    - result TypeId

` Plans an index of a table or of a view of one that TypeScript answers itself: a row of a
` table or of a span at a single index, an item of a field's column, the span or the view of
` the items a range spans, the rows indices select, and an index or a row of an index span or
` a selection, or the span a range of one spans. A range is made forward by the calls recorded
` here. False where those calls cannot be made.
. kind = types.intrinsic-of(receiver)
. tabled = table-kind || kind == .table-span || kind == .immutable-table-span
    .. table-kind = kind == .table || kind == .immutable-table
. made = types.intrinsic-of(result)
. spans = tabled && (made == .table-span || made == .immutable-table-span)
. columns = kind == .table-column || kind == .immutable-table-column
. selects = kind == .table-selection || kind == .immutable-table-selection
. ranged = is-range-type(key)
if tabled && (made == .table-row || made == .immutable-table-row)
    plan-table(id, .table-row)
else if (kind == .table || kind == .immutable-table) && made-selection
    plan-table(id, .table-select)
else if columns && !ranged
    plan-table(id, .table-item)
else if (kind == .index-span || selects) && !ranged
    plan-table(id, if kind == .index-span then .span-item else .selection-row)
else if ranged && (spans || (columns && made == kind) || kind == .index-span || selects)
    if !note-view-range(id, object-syntax, receiver, key-syntax, key)
        = false
    . op = TableOp.table-span
    if kind == .index-span
        op = .span-range
    else if selects
        op = .selection-range
    plan-table(id, op)
.. made-selection = made == .table-selection || made == .immutable-table-selection
= true

────────────────────
+ do view-cell TypeId
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId

` What an index of a view of rows or of one field reads, which the compiler answers before any
` `[]` the view declares: a range gives the view of the rows or the items it spans, and any
` other key, made an `Index`, the row or the item at that index.
. kind = view-kind(receiver)
if kind == 0
    = no-type
plan-view(id)
if is-range-type(key)
    if !note-view-range(id, object-syntax, receiver, key-syntax, key)
        = invalid-type
    = if kind == 2 then receiver else types.array-view-of(types.array-row-range-decl, row-struct-of(receiver), class-arg(types, receiver, 1))
conversions.convert(key-syntax, key-syntax, key, types.index-type, .reason-argument)
= if kind == 2 then row-struct-of(receiver) else types.array-view-of(types.array-row-decl, row-struct-of(receiver), class-arg(types, receiver, 1))

────────────────────
+ do note-view-range Bool
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId

` Records at the index of a view the calls that make a range of it forward: a range of
` positions is first made one of indexes by its `normalize`, given the view.
. first FactId = facts.calls.length as FactId
. range = key
if class-arg(types, key, 0) == types.position-type
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
    scratch.types.push(receiver)
    scratch.syntax.push(object-syntax)
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    range = calls.method-call(id, key-syntax, key, program.store-atom("normalize"), arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
if range == invalid-type || range == no-type
    = false
. empty-shapes = scratch.call-arguments.mark
. empty-types = scratch.types.mark
. empty-syntax = scratch.syntax.mark
. none = arguments-since(empty-shapes, empty-types, empty-syntax, scratch.no-types)
. forward = calls.method-call(id, key-syntax, range, program.store-atom("forward"), none)
. fact = facts.latest-call-of(instance)
while fact != no-fact && fact >= first
    if facts.calls[fact].syntax == id
        facts.calls[fact].form = .call-view-range
    fact = facts.prior-call(fact)
= forward != invalid-type && forward != no-type

────────────────────
+ do is-view-item Bool
    - item TypeId

` An array's rows and fields are views of a concrete tuple or struct item.
if item == no-type || item == invalid-type || types.completions[item].has-variables
    = false
. kind = types.intrinsic-of(item)
if kind != .tuple && kind != .struct
    = false
= match types.rows[item]
    | .type-class(row)
        !same-decl(DeclRef(row.module, row.decl), types.array-decl)
    ??
        true

────────────────────
_ view-item TypeId
    - receiver TypeId
    - owner DeclRef

|? types.intrinsic-of(receiver) != .tuple
    no-type
|? view == no-type
    no-type
??
    row-struct-of(view)

.. view = types.ancestor-of(receiver, owner)

────────────────────
+ do view-field TypeId
    - receiver TypeId
    - name Atom

. row-item = view-item(receiver, types.array-row-decl)
. item = if row-item != no-type then row-item else view-item(receiver, types.array-fields-decl)
if item == no-type
    = no-type
. found = property-named(item, name)
if !found
    = no-type
. field = eager-type(item, types.properties[found])
if field == no-type || row-item != no-type
    = field
= field-view(receiver, field)

────────────────────
+ do view-index TypeId
    - receiver TypeId
    - key-syntax SyntaxId
    - rows-only Bool = false

. row-item = view-item(receiver, types.array-row-decl)
if rows-only && row-item == no-type
    = no-type
. item = if row-item != no-type then row-item else view-item(receiver, types.array-fields-decl)
if item == no-type
    = no-type
. field = eager-field(item, key-syntax)
if field == no-type || row-item != no-type
    = field
= field-view(receiver, field)

────────────────────
+ view-kind U32
    - receiver TypeId

` Whether a type is a view of an array's rows, 1, or of one of its fields, 2, and 0 for any
` other: a range of a view is assigned from a view of the same kind.
|? receiver == no-type || receiver == invalid-type
    0
|? same-decl(ref, types.array-field-decl)
    2
|? same-decl(ref, types.array-rows-decl) || same-decl(ref, types.array-row-range-decl)
    1
??
    0

.. ref = class-ref(types, receiver)

────────────────────
_ do field-view TypeId
    - fields TypeId
    - field TypeId

. view = types.ancestor-of(fields, types.array-fields-decl)
= match types.rows[view]
    | .type-class(row)
        types.array-view-of(types.array-field-decl, field, types.child-type(row.args, 1))
    ??
        no-type

────────────────────
+ do column-field-type TypeId
    - receiver TypeId
    - name Atom

. row = row-struct-of(receiver)
if row == no-type || row == invalid-type
    = no-type
if types.intrinsic-of(row) == .union
    = shared-case-field-type(row, name)
. column = property-named(row, name)
if !column
    = no-type
. field = types.properties[column]
if field.storage-kind != .storage-eager
    = no-type
if field.type == no-type
    = demand-member(field, row, name)
= field.type

────────────────────
_ do shared-case-field-type TypeId
    - union TypeId
    - name Atom

. first = first-case(union)
if first == no-type
    = no-type
. found = property-named(first, name)
if !found
    = no-type
. field = types.properties[found]
if !is-common-field(types, union, field)
    = no-type
= eager-type(first, field)

────────────────────
_ first-case TypeId
    - union TypeId

|? cases.length == 0
    no-type
|? first == invalid-type || cases[0].is-default
    no-type
??
    first

.. cases = types.cases-of(union)
.. first = cases[0].type

────────────────────
+ do has-case-getter Bool
    - union TypeId
    - name Atom

for fact in types.cases-of(union)
    if !fact.is-default && fact.type != no-type && fact.type != invalid-type
        . found = property-named(fact.type, name)
        if found && types.properties[found].storage-kind == .storage-getter
            = true
        if !found && calls.has-getter(fact.type, name)
            = true
= false

────────────────────
+ do column-at TypeId
    - receiver TypeId
    - position U32

` The field a table or span destructures to at a position, and no type past its last field.
. row = row-struct-of(receiver)
if row == no-type || row == invalid-type
    = no-type
. shared = types.intrinsic-of(row) == .union
. source = if shared then first-case(row) else row
if source == no-type
    = no-type
types.complete(source)
. range = types.completions[source].properties
. index = 0u32
for offset in 0 .. < range.count
    . property = types.properties[(range.start + offset) as Index]
    . counted = if shared then is-common-field(types, row, property) else eager-property
        .. eager-property = property.storage-kind == .storage-eager
    if counted
        if index == position
            = eager-type(source, property)
        index += 1
= no-type

────────────────────
+ do column-count U32
    - receiver TypeId

. count = 0u32
while column-at(receiver, count) != no-type
    count += 1
= count

────────────────────
+ row-struct-of TypeId
    - receiver TypeId

match types.rows[receiver]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
+ do is-row-table Bool
    - callable SyntaxId
    - arguments Arguments

` Whether a table named with its row type can lay that row out.
match? tree.nodes[callable]
    | .node-type-arguments
        . table = types.evaluate-type(module, tree, callable, frame.env)
        if table != invalid-type
            = check-table-row(table, arguments)
= true

────────────────────
+ do check-table-row Bool
    - table TypeId
    - arguments Arguments

` A table lays its rows out in columns, so a row is a struct of eager stored fields with no
` delegated behavior, or a union of such tuples. A table an arena holds cannot hold managed
` pointers, and neither can the packed cases of union rows a table makes storage for, which an
` `ImmutableTable` made over storage that exists does not. Says whether the row can be laid out.
. kind = types.intrinsic-of(table)
if kind != .table && kind != .immutable-table
    = true
. row = row-struct-of(table)
if row == no-type || row == invalid-type || types.completions[row].has-variables
    = true
types.complete(row)
. row-kind = types.intrinsic-of(row)
. held = arguments.types.length != 0 && types.is-arena(arguments.types[0])
. ref = class-ref(types, row)
. site = class-site(ref)
if row-kind == .union
    if !check-union-rows(row, kind == .table && !held)
        = false
    . found = managed-path(row, 0) if held
    if found
        . shown = type-short-name(types, row)
        . path = "${type-key(types, row)}${found}"
        . message = "Arena type $shown contains managed pointers through $path"
        = refuse-row(ref.module, site, message, row)
    = true
if row-kind != .struct
    = refuse-row(ref.module, site, "Table row types must be concrete fixed-layout structs")
if types.delegates-of(row).length != 0
    = refuse-row(ref.module, site, "Table row types cannot use delegated interface behavior")
for index in 0 .. < types.properties-of(row).length
    . property = types.properties-of(row)[index]
    if property.storage-kind != .storage-eager
        . owner = declaring-decl(types, property)
        . written = member-site(types, owner, property.name)
        = refuse-row(owner.module, written, "Table row fields must be eager stored fields")
if held
    . found = managed-path(row, 0)
    if found
        . shown = type-short-name(types, row)
        . message = "Arena type $shown contains managed pointers through $shown${found}"
        = refuse-row(ref.module, site, message)
= true

────────────────────
_ do refuse-row Bool
    - owner ModuleId
    - site SyntaxId
    - message String
    - mentioned TypeId = no-type

facts.record-diagnostic(instance, owner, site, .stated, program.store-atom(message), mentioned)
= false

────────────────────
_ do check-union-rows Bool
    - union TypeId
    - creates Bool

` A table of union rows keeps the fields every case shares in columns of their own and packs
` the rest of each case, which must be plain data where the table `creates` that storage itself.
. ref = class-ref(types, union)
. site = class-site(ref)
. count = types.cases-of(union).length
if count == 0
    = refuse-row(ref.module, site, "Table union row types must declare at least one case")
for index in 0 .. < count
    . fact = types.cases-of(union)[index]
    . shown = if fact.name then fact.name!.text else "$index"
    . tuple = !fact.is-default && fact.type != no-type && fact.type != invalid-type
    if !tuple || !intrinsic-is-tuple-like(types.intrinsic-of(fact.type))
        . message = "Table union case '$shown' must use a concrete fixed-layout tuple"
        = refuse-row(ref.module, site, message)
    if types.delegates-of(fact.type).length != 0
        = refuse-row(ref.module, site, "Table union case '$shown' cannot use delegated storage")
    for position in 0 .. < types.properties-of(fact.type).length
        . property = types.properties-of(fact.type)[position]
        if property.storage-kind == .storage-lazy
            . owner = declaring-decl(types, property)
            . written = member-site(types, owner, property.name)
            . message = "Table union case '$shown' cannot use lazy stored fields"
            = refuse-row(owner.module, written, message)
. first = types.cases-of(union)[0].type
for position in 0 .. < types.properties-of(first).length
    . property = types.properties-of(first)[position]
    if is-common-field(types, union, property) && is-hot-field(types, property)
        . owner = declaring-decl(types, property)
        . named = type-short-name(types, union)
        . message = "Table union '$named' common field '${property.name.text}' cannot be @hot "
        message ++= "because it already has a dedicated common column"
        = refuse-row(owner.module, member-site(types, owner, property.name), message)
if !creates
    = true
for index in 0 .. < count
    . fact = types.cases-of(union)[index]
    . shown = if fact.name then fact.name!.text else "$index"
    for position in 0 .. < types.properties-of(fact.type).length
        . property = types.properties-of(fact.type)[position]
        if property.storage-kind != .storage-eager || is-common-field(types, union, property)
            continue
        . stored = eager-type(fact.type, property)
        if stored != no-type && stored != invalid-type && is-managed(stored, 0)
            . owner = declaring-decl(types, property)
            . message = "Table union case '$shown' field '${property.name.text}' contains managed "
            message ++= "pointers through ${type-key(types, stored)}"
            = refuse-row(owner.module, member-site(types, owner, property.name), message, stored)
= true

────────────────────
_ do managed-path String?
    - type TypeId
    - depth U32

` The path from a value an arena holds to the first managed pointer it would carry, and none
` when it carries none. A string and a foreign pointer are the arena's own to hold. The path
` is put together on the way back from the pointer, so a value without one builds no text.
if depth > 16 || type == no-type || type == invalid-type
    = null
types.complete(type)
. kind = types.intrinsic-of(type)
if kind == .string || kind == .cpointer || kind == .table-mark
    = null
if intrinsic-is-tuple-like(kind) || types.is-plain-tuple(type)
    for index in 0 .. < types.properties-of(type).length
        . property = types.properties-of(type)[index]
        if property.storage-kind != .storage-eager
            continue
        . found = managed-path(eager-type(type, property), depth + 1)
        if found
            = ".${property.name.text}${found}"
    = null
if kind == .optional
    . found = managed-path(types.optional-inner(type), depth + 1)
    if found
        = ".value${found}"
    = null
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        . found = managed-path(fact.type, depth + 1)
        if found
            . shown = if fact.name then fact.name!.text else "$index"
            = ".$shown${found}"
    = null
if is-managed(type, depth)
    = ""
= null

────────────────────
+ do zip-columns TypeId
    - lhs TypeId
    - rhs TypeId

` Mutable table fields add into the tuple of fields a table span is cast from.
. mark = scratch.types.mark
. names-mark = scratch.names.mark
if !push-columns(lhs, mark) || !push-columns(rhs, mark)
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = no-type
= types.intern-tuple(mark, names-mark)

────────────────────
_ do push-columns Bool
    - value TypeId
    - mark ScratchMark

if types.intrinsic-of(value) == .table-column
    scratch.names.push(types.index-atom(scratch.types.length - mark))
    scratch.types.push(value)
    = true
. fields = RowRange'TypeId()
match? types.rows[value]
    | .type-tuple(row)
        fields = row.fields
for offset in 0 .. < fields.count
    . field = types.child-type(fields, offset)
    if types.intrinsic-of(field) != .table-column
        = false
    scratch.names.push(types.index-atom(scratch.types.length - mark))
    scratch.types.push(field)
= fields.count != 0
