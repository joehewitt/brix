(import ./ban-sites)
(import ./call-paths)
(import ./facts)
(import ./instances)
(import ./session)
(import ./type-text)
(import ./types)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)

(fn-expr + restricting-effects EffectMask
  (/or/ (. CompilationEffect gc-free) (. CompilationEffect no-heap) (. CompilationEffect no-safepoint) (. CompilationEffect no-suspend))
)

(type + Restrictions
  ; A restriction broken is reported with the chain from where it is placed to where it is broken,
  ; once typing has found every call: from a function that declares it, or from one whose `do` block
  ; enters it, through each function typed again under it, to the code that breaks it. The report
  ; is then `reached`: stated with its chain, and shown however many its function has. Bans and
  ; fakes are checked by walking the calls of one function each from where each is written
  ; (`walk-site`): a door of an effect banned there, with no fake bound inside the ban, is
  ; reported at each call of it with the chain, and so is a door the fake bound there cannot
  ; answer. Past any other call, a door checks its effect's slot where it runs, and panics.
  (blank)
  (prop _ session Session)
  (prop _ paths CallPaths)
  (prop _ sites (list EffectSite))
  (prop _ instance-sites (map InstanceId (list U32)))
  (prop _ states (list (list HeldEffect)))
  (prop _ state-keys (map String U32))
  (prop _ forwarders (map U64 InstanceId))
  (prop _ forwards (map InstanceId SwapForward))
  (fn-do + This _
    (param session _)
    (param paths _)
  )
  (fn-do + chain-reports _
    (let facts (. session facts))
    (for (in position (..< 0 (. facts diagnostics length)))
      (let row ([] (. facts diagnostics) position))
      (if (== (. row kind) .restricted)
        (let name (. row name))
        (if name
          (let need (/and/ (call dispatch-effects (. ([] (. session instances rows) (. row instance)) effects)) (call restricting-effects)))
          (let chain (call chain-text (. row instance) (. row module) (. row syntax) need (call restricting-effects)))
          (let text (if-expr (== (. chain length) 0) (. name text) (str (. name text) ": " chain)))
          (= (. ([] (. facts diagnostics) position) name) (call (. session program store-atom) text))
        )
        (= (. ([] (. facts diagnostics) position) kind) .reached)
      )
    )
    (call report-sites)
  )
  (fn-do _ report-sites _
    (return-if (if (== (. session program effects count) 0)))
    (blank)
    (call gather-sites)
    (let reported (map String Bool))
    (for (in index (..< 0 (. sites length)))
      (call walk-site (as index U32) reported)
    )
  )
  (fn-do _ gather-sites _
    (let program (. session program))
    (let instances (. session instances))
    (for (in site (call ban-sites program instances))
      (let row ([] (. instances rows) (. site instance)))
      (let tree (. ([] (. program modules) (. row module)) tree))
      (let low (if-expr (== (. site block) 0) 0u32 (call (. tree subtree-start) (. site block))))
      (let high (if-expr (== (. site block) 0) (. U32 max) (. site block)))
      (call add-site (call EffectSite (. site instance) low high (. site bans) 0 no-type))
    )
    (for (in scope (. session facts stack-scopes))
      (if (and (!= (. scope entry) 0) (!= (. scope instance) (. instances dead)))
        (let held ([] (. instances swap-entries) (- (. scope entry) 1)))
        (call add-site (call EffectSite (. scope instance) (. scope first) (. scope last) 0 (. held effect) (. held fake)))
      )
    )
    (for (in dispatch (. session facts swap-dispatches))
      (if (!= (. dispatch instance) (. instances dead))
        (= ([] forwarders (call pair (. dispatch instance) (as (. dispatch fake) U64))) (. dispatch forwarder))
      )
    )
    (for (in forward (. session facts swap-forwards))
      (if (!= (. forward instance) (. instances dead))
        (= ([] forwards (. forward instance)) forward)
      )
    )
  )
  (fn-do _ add-site _
    (param site EffectSite)
    (let known (?? ([] instance-sites (. site instance)) (call (of List U32))))
    (for (in index known)
      (let held ([] sites index))
      (return-if (if (and (== (. held low) (. site low)) (== (. held high) (. site high)) (== (. held bans) (. site bans)) (== (. held effect) (. site effect)) (== (. held fake) (. site fake)))))
    )
    (+= known (as (. sites length) U32))
    (+= sites site)
    (= ([] instance-sites (. site instance)) known)
  )
  (fn-expr _ pair U64
    (param instance InstanceId)
    (param other U64)
    (/or/ (/lshift/ (as instance U64) 32) other)
  )
  (fn-do _ walk-site _
    (param index U32)
    (param reported (map String Bool))
    (let instances (. session instances))
    (let table (. session program effects))
    (let site ([] sites index))
    (let edges (list CallEdge))
    (let parents (list U32))
    (let held (list U32))
    (let seen (map U64 Bool))
    (let own (call intern-state (call held-by site true)))
    (for (in edge (call (. paths edges-from) (. site instance)))
      (if (and (call follows edge) (>= (. edge syntax) (. site low)) (<= (. edge syntax) (. site high)))
        (let state (call entered own (. site instance) (. edge syntax) index))
        (if state
          (+= edges edge)
          (+= parents (. U32 max))
          (+= held state)
        )
      )
    )
    (let next Size 0)
    (while (< next (. edges length))
      (let at next)
      (+= next 1)
      (let callee (. ([] edges at) callee))
      (let state ([] held at))
      (let entries ([] states state))
      (let row ([] (. instances rows) callee))
      (let door (call (. table door-of) (. row module) (. row decl)))
      (if (and door (< door (call most-effects)))
        (let top (call innermost entries door))
        (if top
          (let entry ([] entries top))
          (if (== (. entry fake) no-type)
            (if (. entry own)
              (call report-reached site edges parents at door reported)
            )
            (continue)
          )
          (let forwarder (?? ([] forwarders (call pair callee (as (. entry fake) U64))) no-instance))
          (let forward ([] forwards forwarder))
          (if (or (not forward) (!= (. forward miss) .swap-answered))
            (if (and forward (. entry own))
              (call report-miss site edges parents at forward reported)
            )
            (continue)
          )
          (let outside (call without entries top))
          (if outside
            (+= edges (call answer-edge forwarder (. forward callee)))
            (+= parents (as at U32))
            (+= held outside)
          )
          (continue)
        )
      )
      (let key (call pair callee (as state U64)))
      (if (?? ([] seen key) false)
        (continue)
      )
      (= ([] seen key) true)
      (for (in onward (call (. paths edges-from) callee))
        (if (and (call follows onward) (== (call swap-set-of (. ([] (. instances rows) (. onward callee)) effects)) 0))
          (let next-state (call entered state callee (. onward syntax) (. U32 max)))
          (if next-state
            (+= edges onward)
            (+= parents (as at U32))
            (+= held next-state)
          )
        )
      )
    )
  )
  (fn-expr _ follows Bool
    (param edge CallEdge)
    (and (!= (. edge syntax) 0) (or (== (. edge kind) .edge-call) (== (. edge kind) .edge-convert) (== (. edge kind) .edge-made)))
  )
  (fn-do _ held-by (list HeldEffect)
    (param site EffectSite)
    (param own Bool)
    (let entries (list HeldEffect))
    (if (== (. site bans) 0)
      (+= entries (call HeldEffect (. site effect) (. site fake) own))
      (return entries)
    )
    (for (in effect (..< 0 (call most-effects)))
      (if (!= (/and/ (. site bans) (call ban-bit (as effect U32))) 0)
        (+= entries (call HeldEffect (as effect U32) no-type own))
      )
    )
    (return entries)
  )
  (fn-do _ entered (? U32)
    (param state U32)
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param within U32)
    (let candidates ([] instance-sites instance))
    (return-if state (if (not candidates)))
    (blank)
    (let found (list U32))
    (for (in candidate candidates)
      (let site ([] sites candidate))
      (if (and (<= (. site low) syntax) (<= syntax (. site high)) (call is-inside candidate within))
        (let place (. found length))
        (while (and (> place 0) (call is-narrower ([] found (- place 1)) candidate))
          (-= place 1)
        )
        (call (. found insert) candidate place)
      )
    )
    (return-if state (if (== (. found length) 0)))
    (blank)
    (let entries (call (of List HeldEffect)))
    (++= entries ([] states state))
    (for (in candidate found)
      (++= entries (call held-by ([] sites candidate) false))
    )
    (return-if null (if (> (. entries length) 12)))
    (return (call intern-state entries))
  )
  (fn-do _ is-inside Bool
    (param candidate U32)
    (param within U32)
    (return-if true (if (== within (. U32 max))))
    (return-if false (if (== candidate within)))
    (blank)
    (let site ([] sites candidate))
    (let outer ([] sites within))
    (return (and (>= (. site low) (. outer low)) (<= (. site high) (. outer high))))
  )
  (fn-expr _ is-narrower Bool
    (param first U32)
    (param second U32)
    (< (- (. ([] sites first) high) (. ([] sites first) low)) (- (. ([] sites second) high) (. ([] sites second) low)))
  )
  (fn-do _ innermost (? Size)
    (param entries (list HeldEffect))
    (param effect U32)
    (let position (. entries length))
    (while (> position 0)
      (-= position 1)
      (return-if position (if (== (. ([] entries position) effect) effect)))
    )
    (return null)
  )
  (fn-do _ without (? U32)
    (param entries (list HeldEffect))
    (param position Size)
    (let kept (call (of List HeldEffect)))
    (for (in index (..< 0 (. entries length)))
      (if (!= index position)
        (+= kept ([] entries index))
      )
    )
    (return-if null (if (== (. kept length) 0)))
    (return (call intern-state kept))
  )
  (fn-do _ intern-state U32
    (param entries (list HeldEffect))
    (let parts (list String))
    (for (in entry entries)
      (+= parts (str (. entry effect) "/" (. entry fake) "/" (if-expr (. entry own) 1 0)))
    )
    (let key (call (. ";" join) parts))
    (let known (?? ([] state-keys key) (. U32 max)))
    (return-if known (if (!= known (. U32 max))))
    (blank)
    (let id (as (. states length) U32))
    (+= states entries)
    (= ([] state-keys key) id)
    (return id)
  )
  (fn-do _ answer-edge CallEdge
    (param forwarder InstanceId)
    (param method InstanceId)
    (for (in edge (call (. paths edges-from) forwarder))
      (return-if edge (if (== (. edge callee) method)))
    )
    (return (call CallEdge forwarder method 0 .edge-call))
  )
  (fn-do _ chain-of (list CallEdge)
    (param edges (list CallEdge))
    (param parents (list U32))
    (param at Size)
    (let chain (list CallEdge))
    (let cursor ([] parents at))
    (while (!= cursor (. U32 max))
      (call (. chain insert) ([] edges cursor) 0)
      (= cursor ([] parents cursor))
    )
    (return chain)
  )
  (fn-do _ report-reached _
    (param site EffectSite)
    (param edges (list CallEdge))
    (param parents (list U32))
    (param at Size)
    (param effect U32)
    (param reported (map String Bool))
    (let door ([] edges at))
    (let key (str (. door caller) ":" (. door syntax) ":" effect))
    (return-if (if (?? ([] reported key) false)))
    (blank)
    (= ([] reported key) true)
    (let chain (call chain-of edges parents at))
    (let caller ([] (. session instances rows) (. door caller)))
    (let parts (list String))
    (+= parts (call placed (. site instance) (if-expr (== (. chain length) 0) (. door syntax) (. ([] chain 0) syntax))))
    (++= parts (call (. paths names) chain))
    (let shown (call site-text (. caller module) (. door syntax)))
    (if (!= (. shown length) 0)
      (+= parts shown)
    )
    (let name (. ([] (. session program effects names) effect) text))
    (let text (str "cannot reach a door of '" name "' under 'without " name "': " (call (. " → " join) parts)))
    (call (. session facts record-diagnostic) (. door caller) (. caller module) (. door syntax) .reached (call (. session program store-atom) text))
  )
  (fn-do _ report-miss _
    (param site EffectSite)
    (param edges (list CallEdge))
    (param parents (list U32))
    (param at Size)
    (param forward SwapForward)
    (param reported (map String Bool))
    ; Reports a door a fake cannot answer where the walk from the `do with` that binds it reaches
    ; it, with the chain from there.
    (let door ([] edges at))
    (let key (str "fake:" (. door caller) ":" (. door syntax) ":" (. forward effect)))
    (return-if (if (?? ([] reported key) false)))
    (blank)
    (= ([] reported key) true)
    (let chain (call chain-of edges parents at))
    (let caller ([] (. session instances rows) (. door caller)))
    (let parts (list String))
    (let bound (. ([] (. session program effects names) (. forward effect)) text))
    (+= parts (str (call (. paths name-of) (. site instance)) " (with " bound ")"))
    (++= parts (call (. paths names) chain))
    (let shown (call site-text (. caller module) (. door syntax)))
    (if (!= (. shown length) 0)
      (+= parts shown)
    )
    (let text (call swap-text forward (call (. " → " join) parts)))
    (call (. session facts record-diagnostic) (. door caller) (. caller module) (. door syntax) .reached (call (. session program store-atom) text))
  )
  (fn-do _ swap-text String
    (param forward SwapForward)
    (param chain String)
    ; What a fake lacks to answer a door, with the chain to the door.
    (let effects (. session program effects))
    (let name (. ([] (. effects names) (. forward effect)) text))
    (let row ([] (. session instances rows) (. forward instance)))
    (let fake (call (. session instances fake-of) (. row effects) (. forward effect)))
    (let fake-name (call type-short-name (. session types) fake))
    (let door (call (. paths name-of) (. forward instance)))
    (let said
      (match (. forward miss)
        (case= .swap-missing
          (str fake-name " has no method '" door "' to answer the door of '" name "'")
        )
        (case= .swap-mismatched
          (str fake-name "." door " does not take and give what the door of '" name "' does")
        )
        (default
          (str "a fake answers only a door of '" name "' that is a function of its module, and " door " is not")
        )
      )
    )
    (return-if said (if (== (. chain length) 0)))
    (return (str said ": " chain))
  )
  (fn-do _ chain-text String
    (param broken InstanceId)
    (param module ModuleId)
    (param site SyntaxId)
    (param need EffectMask)
    (param placing EffectMask)
    ; The chain from where what `need` names is placed to the site that breaks it: the function that
    ; breaks it, where its own header writes what `placing` names or it holds none of `need` and a
    ; `do` block of its own places it.
    (let parts (list String))
    (if (or (== need 0) (!= (/and/ (call written-effects broken) placing) 0))
      (+= parts (call placed broken site))
      (else
        (let found (call (. paths chain-to) broken (=> ((: edge CallEdge)) (call step edge need))))
        (return-if "" (if (or (not found) (== (. found length) 0))))
        (blank)
        (+= parts (call placed (. ([] found 0) caller) (. ([] found 0) syntax)))
        (++= parts (call (. paths names) found))
      )
    )
    (let shown (call site-text module site))
    (if (!= (. shown length) 0)
      (+= parts shown)
    )
    (return (call (. " → " join) parts))
  )
  (fn-do _ step EdgeStep
    (param edge CallEdge)
    (param need EffectMask)
    ; Each function a restriction reaches is typed again under it, so the walk goes back through
    ; those that have it and stops at the one that places it.
    (let held (/and/ (call dispatch-effects (. ([] (. session instances rows) (. edge caller)) effects)) need))
    (return-if .step-reach (if (or (!= held need) (!= (/and/ (call written-effects (. edge caller)) need) 0))))
    (return .step-follow)
  )
  (fn-do _ placed String
    (param root InstanceId)
    (param at SyntaxId)
    ; A function that places a restriction, with what it writes: its own `without` section, or that of
    ; the `do` block around where the chain leaves it. The body of a `do without gc` block is the
    ; function it is written in.
    (let row ([] (. session instances rows) root))
    (let written (/and/ (call written-effects root) (call shown-effects)))
    (let names (. session program effects names))
    (if (and (call is-region root) (!= (. row enclosing) no-instance))
      (return (str (call (. paths name-of) (. row enclosing)) " (do " (call without-text written names) ")"))
    )
    (if (!= written 0)
      (return (str (call (. paths name-of) root) " (" (call without-text written names) ")"))
    )
    (let block (call block-effects root at))
    (return-if (str (call (. paths name-of) root) " (do " (call without-text block names) ")") (if (!= block 0)))
    (return (call (. paths name-of) root))
  )
  (fn-do _ written-effects EffectMask
    (param instance InstanceId)
    (let row ([] (. session instances rows) instance))
    (match? ([] (. ([] (. session program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (/or/ (. fn effects) (call (. session program effects bans-of) (. row module) (. row decl))))
      )
    )
    (return 0)
  )
  (fn-expr _ shown-effects EffectMask
    ; What a chain shows of a `without` section: the restrictions, and the bans.
    (/or/ (call restricting-effects) (call ban-bits))
  )
  (fn-do _ is-region Bool
    (param instance InstanceId)
    (let row ([] (. session instances rows) instance))
    (match? ([] (. ([] (. session program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (== (. fn kind) .region-decl))
      )
    )
    (return false)
  )
  (fn-do _ block-effects EffectMask
    (param instance InstanceId)
    (param at SyntaxId)
    ; What the innermost `do` block of an instance that restricts code writes, among those around a
    ; node.
    (return-if 0 (if (== at 0)))
    (blank)
    (let row ([] (. session instances rows) instance))
    (let tree (. ([] (. session program modules) (. row module)) tree))
    (let found EffectMask 0)
    (let narrowest SyntaxId 0)
    (for (in offset (..< 0 (. row subtree count)))
      (let id (as (+ (. row subtree start) offset) SyntaxId))
      (match? ([] (. tree nodes) id)
        (case (call .node-do-block block)
          (let written (/or/ (as (. block compilation-effects) EffectMask) (call (. session program bans-named) (. row module) (. block bans))))
          (let effects (/and/ written (call shown-effects)))
          (if (and (!= effects 0) (<= (call (. tree subtree-start) id) at) (<= at id) (or (== narrowest 0) (< id narrowest)))
            (= found effects)
            (= narrowest id)
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ site-text String
    (param module ModuleId)
    (param site SyntaxId)
    ; The code that breaks a restriction as written, where it is short and on one line, or the first
    ; line of a block that does, closed with an ellipsis where it opens a form.
    (return-if "" (if (== site 0)))
    (blank)
    (let tree (. ([] (. session program modules) module) tree))
    (let loc ([] (. tree nodes loc) site))
    (let line (call source-line (. tree source) (. loc begin line)))
    (let first (as (. loc begin column) Size))
    (if (and (!= (. loc begin line) (. loc end line)) (call is-block ([] (. tree nodes) site)))
      (return-if "" (if (> (- (. line length) first) 40)))
      (blank)
      (let opening (call (. ([] line (... first)) trim)))
      (return (if-expr (call (. opening starts-with) "(") (str opening " …)") opening))
    )
    (return-if "" (if (or (!= (. loc begin line) (. loc end line)) (< (. loc end column) (. loc begin column)))))
    (blank)
    (let last (+ (as (. loc end column) Size) 1))
    (return-if "" (if (or (> last (. line length)) (> (- last first) 40))))
    (return ([] line (..< first last)))
  )
)

(type _ EffectSite (is Struct)
  (prop + instance InstanceId)
  (prop + low SyntaxId)
  (prop + high SyntaxId)
  (prop + bans EffectMask)
  (prop + effect U32)
  (prop + fake TypeId)
)

(type _ HeldEffect (is Struct)
  (prop + effect U32)
  (prop + fake TypeId)
  (prop + own Bool)
)

(fn-expr _ is-block Bool
  (param node Syntax)
  (match node
    (case .node-do-block
      true
    )
    (case .node-do-task-block
      true
    )
    (default
      false
    )
  )
)

(fn-do _ without-text String
  (param effects EffectMask)
  (param names (list Atom))
  ; Restrictions and bans as a `without` section writes them, leaving out the names another one
  ; implies, the bans after the restrictions.
  (let parts (list String))
  (if (!= (/and/ effects (. CompilationEffect gc-free)) 0)
    (+= parts "gc")
    (else
      (if (!= (/and/ effects (. CompilationEffect no-heap)) 0)
        (+= parts "heap")
      )
      (if (!= (/and/ effects (. CompilationEffect no-safepoint)) 0)
        (+= parts "safepoints")
        (else-if (!= (/and/ effects (. CompilationEffect no-suspend)) 0)
          (+= parts "suspend")
        )
      )
    )
  )
  (for (in index (..< 0 (. names length)))
    (if (and (< index (call most-effects)) (!= (/and/ effects (call ban-bit (as index U32))) 0))
      (+= parts (. ([] names index) text))
    )
  )
  (return (str "without " (call (. ", " join) parts)))
)
