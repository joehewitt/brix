(import ./constructors)
(import ./conversions)
(import ./facts)
(import ./frame)
(import ./instances)
(import ./ranking-cache)
(import ./session)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/viability)
(import /stream/aggregate)

(type + CaseOwnerNote (is Tuple)
  ; A type candidates took an argument that is a case named by its symbol alone as a case of, at
  ; the argument's place among the call's arguments, with the case's name, and whether the
  ; candidate chosen takes it.
  (blank)
  (prop + fill U32)
  (prop + name Atom)
  (prop + owner TypeId)
  (prop + chosen Bool)
)

(type + Hit (is Tuple)
  ; One viable candidate of a dispatch: the declaration, the receiver it was matched on, its
  ; inferred type parameters, the expected type per argument slot, which call argument fills each
  ; slot, the relation of each filled slot, and the variadic tail's fills and relations. A member
  ; an extension adds keeps the type it extends as its `level`, where the receiver it runs on is
  ; derived from that type.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + receiver TypeId)
  (prop + params (of ImmutableArray TypeId ArenaBacking))
  (prop + args (of ImmutableArray TypeId ArenaBacking))
  (prop + fills (of ImmutableArray U32 ArenaBacking))
  (prop + relations (of ImmutableArray Relation ArenaBacking))
  (prop + tail-fills (of ImmutableArray U32 ArenaBacking))
  (prop + tail-relations (of ImmutableArray Relation ArenaBacking))
  (prop + is-extension Bool)
  (prop + level TypeId (= no-type))
)

(type + RankKind (is U32)
  (variant rank-plain (= 0))
  (variant rank-constructor (= 1))
  (variant rank-static (= 2))
)

(type + DispatchRequest (is U32)
  (variant request-none (= 0))
  (variant request-function (= 1))
  (variant request-c-function (= 2))
  (variant request-method (= 3))
  (variant request-getter (= 4))
  (variant request-setter (= 5))
  (variant request-static (= 6))
  (variant request-constructor (= 7))
  (variant request-module-getter (= 8))
  (variant request-module-setter (= 9))
)

(type + Ranking
  (implements CallableFitter)
  (prop + types Types)
  (prop + program Program)
  (prop + relations Relations)
  (prop + caller ModuleId)
  (prop _ scratch TypingScratch)
  (prop + host (? Demander) (= null))
  (prop + conversions (? Conversions) (= null))
  (prop + best (? Hit) (= null))
  (prop + partial (? Hit) (= null))
  (prop + bound-call Bool)
  (prop + row-case TypeId (= no-type))
  (prop + delegated TypeId (= no-type))
  (prop + texts Bool)
  (prop + asked Bool)
  (prop _ kind RankKind (= .rank-plain))
  (prop _ extension-ranking Bool)
  (prop _ extension-level TypeId (= no-type))
  (prop _ is-partial Bool)
  (prop _ ambiguous-constructor Bool)
  (prop _ ambiguous-static Bool)
  (prop _ ambiguous-extension Bool)
  (prop _ conflicting Bool)
  (prop _ c-only Bool)
  (prop _ pattern-self Bool)
  (prop _ adapted TypeId (= no-type))
  (prop _ tail-default TypeId (= no-type))
  (prop _ lenders (list TypeId))
  (prop + active Bool)
  (prop + missing-module ModuleId (= 0))
  (prop + missing-site SyntaxId (= 0))
  (prop _ args (of ImmutableArray TypeId ArenaBacking))
  (prop _ ranked-shapes (of ImmutableArray CallArgument ArenaBacking))
  (prop _ explicit (of ImmutableArray TypeId ArenaBacking))
  (prop + request DispatchRequest (= .request-none))
  (prop + request-receiver TypeId (= no-type))
  (prop + request-name (? Atom) (= null))
  (prop _ request-by-name Bool)
  (prop _ incumbent (list Relation))
  (prop _ incumbent-variadic Bool)
  (prop _ incumbent-params (list TypeId))
  (prop _ ranked (list Relation))
  (prop _ ranked-params (list TypeId))
  (prop _ items-mark ScratchMark (= 0))
  (prop _ names-mark ScratchMark (= 0))
  (prop _ words-mark ScratchMark (= 0))
  (prop _ relations-mark ScratchMark (= 0))
  (prop _ calls (list CallArgument))
  (prop _ slots (list U32))
  (prop _ candidates (list ConstructorCandidate))
  (prop _ symbol-fills (list U32))
  (prop _ symbol-starts (list U32))
  (prop _ symbol-options (list TypeId))
  (prop _ symbol-choices (list U32))
  (prop _ symbol-attempts U32)
  (prop _ facts Facts)
  (prop _ symbol-accepted (list TypeId))
  (prop _ symbol-accepted-fills (list U32))
  (prop _ consulted Bool)
  (fn-do + This _
    (param session Session)
    (param caller ModuleId)
    (lazy types (. session types))
    (lazy relations (. session relations))
    (lazy program (. session program))
    (lazy scratch (. session scratch))
    (lazy facts (. session facts))
  )
  (fn-do + rebind _
    (param module ModuleId)
    ; Hands the ranking to another function's calls, as if it were new.
    (= caller module)
    (= host null)
    (= conversions null)
    (= best null)
    (= partial null)
    (= active false)
    (= c-only false)
    (= pattern-self false)
    (= adapted no-type)
  )
  (fn-do + begin _
    (param shapes (of ImmutableArray CallArgument ArenaBacking))
    (param given (of ImmutableArray TypeId ArenaBacking))
    (= best null)
    (= partial null)
    (= bound-call false)
    (= row-case no-type)
    (= delegated no-type)
    (= active true)
    (= missing-module 0)
    (= missing-site 0)
    (= kind .rank-plain)
    (= extension-ranking false)
    (= extension-level no-type)
    (= is-partial false)
    (= ambiguous-constructor false)
    (= ambiguous-static false)
    (= ambiguous-extension false)
    (= conflicting false)
    (call (. incumbent clear))
    (= incumbent-variadic false)
    (call (. incumbent-params clear))
    (call (. ranked clear))
    (call (. ranked-params clear))
    (= explicit (. scratch no-types))
    (= args given)
    (= ranked-shapes shapes)
    (= request .request-none)
    (= items-mark (. scratch types mark))
    (= names-mark (. scratch names mark))
    (= words-mark (. scratch words mark))
    (= relations-mark (. scratch relations mark))
    (call (. calls clear))
    (for (in shape shapes)
      (+= calls shape)
    )
    (call (. symbol-fills clear))
  )
  (fn-do _ note-request _
    (param made DispatchRequest)
    (param receiver TypeId)
    (param name (? Atom))
    (= request made)
    (= request-receiver receiver)
    (= request-name name)
  )
  (fn-do _ recall Bool
    ; Restores what ranking this call chose before, where the call was ranked as it is now.
    (= consulted false)
    (return-if false (if (not (call rememberable))))
    (blank)
    (call open-ranking-key)
    (let cache (. scratch rankings))
    (let found (. cache found))
    (return-if false (if (not found)))
    (blank)
    (let row ([] (. cache rankings) found))
    (= best (call cached-hit (. row best)))
    (= partial (call cached-hit (. row partial)))
    (= ambiguous-constructor (. row ambiguous-constructor))
    (= ambiguous-static (. row ambiguous-static))
    (= ambiguous-extension (. row ambiguous-extension))
    (= conflicting (. row conflicting))
    (= missing-module (. row missing-module))
    (= missing-site (. row missing-site))
    (return true)
  )
  (fn-do _ remember _
    ; Keeps what ranking this call chose, where ranking it asked nothing of the checker.
    (return-if (if (or consulted (not (call rememberable)))))
    (blank)
    (call open-ranking-key)
    (let row
      (call CachedRanking
        (block
          (arg (call kept-hit best))
          (arg (call kept-hit partial))
          (arg ambiguous-constructor)
          (arg ambiguous-static)
          (arg ambiguous-extension)
          (arg conflicting)
          (arg missing-module)
          (arg missing-site)
        )
      )
    )
    (call (. scratch rankings keep) row)
  )
  (fn-expr _ whole-unit-literal Bool
    (param shape CallArgument)
    (param param TypeId)
    (and (!= (. shape unit-literal) 0) (!= conversions null) (call (. conversions fitting-literal) (. shape unit-literal) param))
  )
  (fn-do _ rememberable Bool
    ; Whether what ranking chooses for this call is told by what the call gives alone: no argument
    ; is a case named by its symbol alone or an integer written with no suffix, and no type given
    ; holds a variable or a closure.
    (for (in shape calls)
      (return-if false (if (or (. shape symbol) (!= (. shape literal) 0) (!= (. shape unit-literal) 0))))
    )
    (return-if false (if (or (not (call plain-type request-receiver)) (not (call plain-type row-case)) (not (call plain-type delegated)))))
    (blank)
    (for (in type args)
      (return-if false (if (not (call plain-type type))))
    )
    (return (call all explicit (:where (call plain-type each))))
  )
  (fn-expr _ plain-type Bool
    (param type TypeId)
    (or (== type no-type) (and (not (. completion has-variables)) (not (. completion has-closures))))
    (where
      (lazy completion ([] (. types completions) type))
    )
  )
  (fn-do _ open-ranking-key _
    (let cache (. scratch rankings))
    (call (. cache open-key))
    (call (. cache add-key) request)
    (call (. cache add-key) request-receiver)
    (call add-atom-key request-name)
    (call (. cache add-key) caller)
    (let flags 0u32)
    (if bound-call
      (+= flags 1)
    )
    (if host
      (+= flags 2)
    )
    (if c-only
      (+= flags 4)
    )
    (if (and (== request .request-constructor) request-by-name)
      (+= flags 8)
    )
    (call (. cache add-key) flags)
    (call (. cache add-key) row-case)
    (call (. cache add-key) delegated)
    (call (. cache add-key) (as (. explicit length) U32))
    (for (in type explicit)
      (call (. cache add-key) type)
    )
    (call (. cache add-key) (as (. args length) U32))
    (for (in type args)
      (call (. cache add-key) type)
    )
    (call (. cache add-key) (as (. calls length) U32))
    (for (in shape calls)
      (call add-atom-key (. shape name))
      (let shape-flags 0u32)
      (if (. shape is-optional)
        (+= shape-flags 1)
      )
      (if (. shape is-variadic-list)
        (+= shape-flags 2)
      )
      (if (. shape is-property)
        (+= shape-flags 4)
      )
      (if (. shape is-skipped)
        (+= shape-flags 8)
      )
      (call (. cache add-key) shape-flags)
    )
  )
  (fn-do _ add-atom-key _
    (param name (? Atom))
    (let address Size (as (if-expr name (. name address) 0) Size))
    (call (. scratch rankings add-key) (as (/and/ address (as (. U32 max) Size)) U32))
    (call (. scratch rankings add-key) (as (/rshift/ address 32) U32))
  )
  (fn-expr _ cached-hit (? Hit)
    (param place U32)
    (case? (== place (. U32 max))
      null
    )
    (default
      (call Hit
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row receiver))
          (arg (call (. cache types span) (. row params) (. row param-count)))
          (arg (call (. cache types span) (. row args) (. row arg-count)))
          (arg (call (. cache words span) (. row fills) (. row fill-count)))
          (arg (call (. cache relations span) (. row relations) (. row relation-count)))
          (arg (call (. cache words span) (. row tail-fills) (. row tail-fill-count)))
          (arg (call (. cache relations span) (. row tail-relations) (. row tail-relation-count)))
          (arg (. row is-extension))
          (arg (. row level))
        )
      )
    )
    (where
      (lazy cache (. scratch rankings))
      (lazy row ([] (. cache hits) place))
    )
  )
  (fn-do _ kept-hit U32
    (param hit (? Hit))
    (return-if (. U32 max) (if (not hit)))
    (blank)
    (let kept hit)
    (let cache (. scratch rankings))
    (let params U32 (as (. cache types length) U32))
    (for (in type (. kept params))
      (call (. cache types push) type)
    )
    (let args U32 (as (. cache types length) U32))
    (for (in type (. kept args))
      (call (. cache types push) type)
    )
    (let fills U32 (as (. cache words length) U32))
    (for (in fill (. kept fills))
      (call (. cache words push) fill)
    )
    (let tail-fills U32 (as (. cache words length) U32))
    (for (in fill (. kept tail-fills))
      (call (. cache words push) fill)
    )
    (let relations U32 (as (. cache relations length) U32))
    (for (in relation (. kept relations))
      (call (. cache relations push) relation)
    )
    (let tail-relations U32 (as (. cache relations length) U32))
    (for (in relation (. kept tail-relations))
      (call (. cache relations push) relation)
    )
    (let place U32 (as (. cache hits length) U32))
    (let made
      (call CachedHit
        (block
          (arg (. kept module))
          (arg (. kept decl))
          (arg (. kept receiver))
          (arg (. kept level))
          (arg (. kept is-extension))
          (arg params)
          (arg (as (. kept params length) U32))
          (arg args)
          (arg (as (. kept args length) U32))
          (arg fills)
          (arg (as (. kept fills length) U32))
          (arg relations)
          (arg (as (. kept relations length) U32))
          (arg tail-fills)
          (arg (as (. kept tail-fills length) U32))
          (arg tail-relations)
          (arg (as (. kept tail-relations length) U32))
        )
      )
    )
    (call (. cache hits append) made)
    (return place)
  )
  (fn-do + replay (? Hit)
    (param other Ranking)
    (param given (of ImmutableArray TypeId ArenaBacking))
    (param literal-at U32 (= (. U32 max)))
    (param literal SyntaxId (= 0))
    ; Ranks again what another ranking last ranked, as it was ranked, with other types given for
    ; its arguments, and the argument at `literal-at` taken as the number `literal` is written. The
    ; ranking is then released as any other.
    (= caller (. other caller))
    (= host (. other host))
    (= conversions (. other conversions))
    (call begin (. other ranked-shapes) given)
    (if (< literal-at (. calls length))
      (let shape ([] calls literal-at))
      (= ([] calls literal-at) (= (. shape literal) literal))
    )
    (= explicit (. other explicit))
    (= bound-call (. other bound-call))
    (= row-case (. other row-case))
    (let receiver (. other request-receiver))
    (let name (. other request-name))
    (match? (. other request)
      (case= .request-function
        (return (call dispatch-function receiver (!! name)))
      )
      (case= .request-c-function
        (return (call dispatch-c-function (!! name)))
      )
      (case= .request-method
        (return (call dispatch-method receiver (!! name)))
      )
      (case= .request-getter
        (return (call dispatch-getter receiver (!! name)))
      )
      (case= .request-setter
        (return (call dispatch-setter receiver (!! name)))
      )
      (case= .request-module-getter
        (return (call dispatch-module-getter (!! name)))
      )
      (case= .request-module-setter
        (return (call dispatch-module-setter (!! name)))
      )
      (case= .request-static
        (return (call dispatch-static receiver (!! name)))
      )
      (case= .request-constructor
        (return (call dispatch-constructor receiver (. other request-by-name)))
      )
    )
    (return null)
  )
  (fn-expr + shape-at CallArgument
    (param fill U32)
    ([] calls fill)
  )
  (fn-expr + shape-count Size :get
    (. calls length)
  )
  (fn-expr + given-at TypeId
    (param fill U32)
    ([] args fill)
  )
  (fn-do + explicit-params _
    (param params (of ImmutableArray TypeId ArenaBacking))
    (= explicit params)
  )
  (fn-do + release _
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
    (call (. scratch words rewind) words-mark)
    (call (. scratch relations rewind) relations-mark)
    (= best null)
    (= active false)
  )
  (fn-do _ open-symbols _
    ; Lists, for each argument that is a case named by its symbol alone, the types it may be a
    ; case of: first the one a symbol alone names, and then the others in their order. A call is
    ; ranked with the first of each, and where nothing answers it, again with the next
    ; combination, as the reference retries it.
    (call (. symbol-fills clear))
    (call (. symbol-starts clear))
    (call (. symbol-options clear))
    (call (. symbol-choices clear))
    (= symbol-attempts 0)
    (call (. symbol-accepted clear))
    (call (. symbol-accepted-fills clear))
    (let found (list TypeId))
    (for (in fill (..< 0 (. calls length)))
      (let symbol (. ([] calls fill) symbol))
      (if (not symbol)
        (continue)
      )
      (call (. found clear))
      (call symbol-owners types caller symbol found)
      (let other (. ([] calls fill) other-symbol))
      (let kept 0)
      (while (and other host (< kept (. found length)))
        (if (== (call symbol-type types program ([] found kept) other) invalid-type)
          (-= ([] found (..< kept (+ kept 1))))
          (else
            (+= kept 1)
          )
        )
      )
      (if (== (. found length) 0)
        (continue)
      )
      (+= symbol-fills (as fill U32))
      (+= symbol-starts (as (. symbol-options length) U32))
      (+= symbol-options ([] found (- (. found length) 1)))
      (for (in position (..< 0 (- (. found length) 1)))
        (+= symbol-options ([] found position))
      )
      (+= symbol-choices 0)
    )
    (+= symbol-starts (as (. symbol-options length) U32))
  )
  (fn-do _ next-symbols Bool
    ; Moves to the next combination of types for the arguments that are symbols, and says whether
    ; there is one to rank the call with. Nothing is left of the ranking before.
    (if (or best partial (== (. symbol-fills length) 0) (>= symbol-attempts 64))
      (return false)
    )
    (+= symbol-attempts 1)
    (let position 0)
    (while (< position (. symbol-choices length))
      (+= ([] symbol-choices position) 1)
      (if (< ([] symbol-choices position) (- ([] symbol-starts (+ position 1)) ([] symbol-starts position)))
        (break)
      )
      (= ([] symbol-choices position) 0)
      (+= position 1)
    )
    (if (== position (. symbol-choices length))
      (return false)
    )
    (call (. incumbent clear))
    (= incumbent-variadic false)
    (call (. incumbent-params clear))
    (= is-partial false)
    (= ambiguous-constructor false)
    (= ambiguous-static false)
    (= ambiguous-extension false)
    (= conflicting false)
    (return true)
  )
  (fn-do _ note-symbol-owners _
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param declared (of ImmutableArray TypeId ArenaBacking))
    ; Notes, for each argument that is a case named by its symbol alone, the types it may be a case
    ; of that a candidate's parameters take, optional or not, as the reference notes them for each
    ; candidate the arguments fit as it ranks the call with the type a symbol alone names.
    (if (or (not (. facts traces-lint)) (!= symbol-attempts 0))
      (return)
    )
    (for (in position (..< 0 (. fills length)))
      (if (>= position (. declared length))
        (break)
      )
      (if (and (< ([] fills position) (. calls length)) (. ([] calls ([] fills position)) other-symbol))
        (continue)
      )
      (let owner (call symbol-option ([] fills position) (call (. types optional-inner) ([] declared position))))
      (if (== owner no-type)
        (continue)
      )
      (let noted false)
      (for (in offset (..< 0 (. symbol-accepted length)))
        (if (and (== ([] symbol-accepted-fills offset) ([] fills position)) (== ([] symbol-accepted offset) owner))
          (= noted true)
        )
      )
      (if (not noted)
        (+= symbol-accepted owner)
        (+= symbol-accepted-fills ([] fills position))
      )
    )
  )
  (fn-do _ symbol-option TypeId
    (param fill U32)
    (param type TypeId)
    ; A type an argument that is a case named by its symbol alone may be a case of, where it is
    ; `type`, or no type.
    (for (in position (..< 0 (. symbol-fills length)))
      (if (== ([] symbol-fills position) fill)
        (for (in option (..< ([] symbol-starts position) ([] symbol-starts (+ position 1))))
          (if (== ([] symbol-options option) type)
            (return type)
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do + symbol-owners-noted _
    (param hit Hit)
    (param noted (list CaseOwnerNote))
    ; Adds to `noted` the types candidates took each argument that is a case named by its symbol
    ; alone as a case of, where they took it as one of more than one, with whether the one `hit`
    ; takes is that type, as the reference traces such a call it ranked with the type a symbol alone
    ; names. Nothing is noted for an argument the hit takes as a case of none of them.
    (if (!= symbol-attempts 0)
      (return)
    )
    (for (in position (..< 0 (. hit fills length)))
      (if (>= position (. hit args length))
        (break)
      )
      (let fill ([] (. hit fills) position))
      (let chosen (call symbol-option fill (call (. types optional-inner) ([] (. hit args) position))))
      (let count 0)
      (for (in offset (..< 0 (. symbol-accepted length)))
        (if (== ([] symbol-accepted-fills offset) fill)
          (+= count 1)
        )
      )
      (if (or (== chosen no-type) (< count 2))
        (continue)
      )
      (for (in offset (..< 0 (. symbol-accepted length)))
        (if (== ([] symbol-accepted-fills offset) fill)
          (let owner ([] symbol-accepted offset))
          (+= noted (call CaseOwnerNote fill (!! (. ([] calls fill) symbol)) owner (== owner chosen)))
        )
      )
    )
  )
  (fn-do _ symbol-owner TypeId
    (param fill U32)
    ; The type an argument that is a symbol is ranked as a case of, or no type for one the call
    ; lists no types for.
    (for (in position (..< 0 (. symbol-fills length)))
      (if (== ([] symbol-fills position) fill)
        (return ([] symbol-options (+ ([] symbol-starts position) ([] symbol-choices position))))
      )
    )
    (return no-type)
  )
  (fn-do + dispatch-function (? Hit)
    (param receiver TypeId)
    (param name Atom)
    (call note-request .request-function receiver name)
    (return-if best (if (call recall)))
    (blank)
    (call open-symbols)
    (call rank-functions receiver name)
    (while (call next-symbols)
      (call rank-functions receiver name)
    )
    (call remember)
    (return best)
  )
  (fn-do _ rank-functions _
    (param receiver TypeId)
    (param name Atom)
    (if (!= receiver no-type)
      (call rank-methods receiver name .function-decl)
    )
    (call rank-module-functions name .function-decl)
  )
  (fn-do _ rank-module-functions _
    (param name Atom)
    (param kind DeclKind)
    (let ordered (. scratch words mark))
    (for (in candidate (call (. program lookup) caller name))
      (call (. scratch words push) (. candidate module))
      (call (. scratch words push) (. candidate decl))
    )
    (let end (. scratch words mark))
    (let position ordered)
    (while (< position end)
      (let module ([] (. scratch words) position))
      (let run-end position)
      (while (and (< run-end end) (== ([] (. scratch words) run-end) module))
        (+= run-end 2)
      )
      (let cursor run-end)
      (while (> cursor position)
        (-= cursor 2)
        (call rank-module-function module ([] (. scratch words) (+ cursor 1)) kind)
      )
      (= position run-end)
    )
  )
  (fn-do _ rank-module-function _
    (param module ModuleId)
    (param decl DeclId)
    (param kind DeclKind)
    (let target ([] (. program modules) module))
    (if (!= (call (. target name ends-with) ".h") c-only)
      (return)
    )
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (if (and (== (. fn owner) 0) (== (. fn kind) kind) (call visible-from module (. fn access)))
          (call accept (call rank-function module decl no-type (call no-type-arguments types)))
        )
      )
    )
  )
  (fn-expr _ visible-from Bool
    (param module ModuleId)
    (param access Access)
    ; Whether a declaration of a module is visible to the caller, as `reaches-access` says.
    (call (. program reaches-access) caller module access)
  )
  (fn-do + dispatch-c-function (? Hit)
    (param name Atom)
    (= c-only true)
    (let hit (call dispatch-function no-type name))
    (= c-only false)
    (= request .request-c-function)
    (return hit)
  )
  (fn-do + dispatch-method (? Hit)
    (param receiver TypeId)
    (param name Atom)
    (call note-request .request-method receiver name)
    (return-if best (if (call recall)))
    (blank)
    (call open-symbols)
    (call rank-methods receiver name .function-decl)
    (while (call next-symbols)
      (call rank-methods receiver name .function-decl)
    )
    (call remember)
    (return best)
  )
  (fn-do + dispatch-getter (? Hit)
    (param receiver TypeId)
    (param name Atom)
    (call note-request .request-getter receiver name)
    (return-if best (if (call recall)))
    (blank)
    (call rank-methods receiver name .getter-decl)
    (call remember)
    (return best)
  )
  (fn-do + dispatch-setter (? Hit)
    (param receiver TypeId)
    (param name Atom)
    (call note-request .request-setter receiver name)
    (return-if best (if (call recall)))
    (blank)
    (call rank-methods receiver name .setter-decl)
    (call remember)
    (return best)
  )
  (fn-do + dispatch-module-getter (? Hit)
    (param name Atom)
    (call note-request .request-module-getter no-type name)
    (return-if best (if (call recall)))
    (blank)
    (call rank-module-functions name .getter-decl)
    (call remember)
    (return best)
  )
  (fn-do + dispatch-module-setter (? Hit)
    (param name Atom)
    (call note-request .request-module-setter no-type name)
    (return-if best (if (call recall)))
    (blank)
    (call rank-module-functions name .setter-decl)
    (call remember)
    (return best)
  )
  (fn-do + dispatch-static (? Hit)
    (param owner TypeId)
    (param name Atom)
    (call note-request .request-static owner name)
    (= kind .rank-static)
    (return-if best (if (call recall)))
    (blank)
    (call (. types complete) owner)
    (let ref (call DeclRef (. U32 max) (. U32 max)))
    (match? ([] (. types rows) owner)
      (case (call .type-class row)
        (= ref (call DeclRef (. row module) (. row decl)))
      )
    )
    (if (== (. ref module) (. U32 max))
      (return null)
    )
    (let target ([] (. program modules) (. ref module)))
    (match? ([] (. target decls) (. ref decl))
      (case (call .decl-class row)
        (call open-symbols)
        (call rank-statics (. ref module) target (. row members) name owner)
        (while (call next-symbols)
          (call rank-statics (. ref module) target (. row members) name owner)
        )
        (call remember)
      )
    )
    (return best)
  )
  (fn-do + dispatch-constructor (? Hit)
    (param receiver TypeId)
    (param by-name Bool (= true))
    ; The constructor a call of a type names. Where the type's parameters are not known and the
    ; call holds nothing, it is the default constructor, unless the type writes one of its own.
    ; Where the call gives type parameters of the constructor's own, only a constructor written
    ; with its own can be named. A type of alternatives, as `Int || String`, is made only from a
    ; value of one of them.
    (call note-request .request-constructor receiver null)
    (= request-by-name by-name)
    (= kind .rank-constructor)
    (= pattern-self by-name)
    (return-if best (if (call recall)))
    (blank)
    (let first (if-expr (!= (. args length) 0) ([] args 0) no-type))
    (call constructor-candidates relations receiver calls candidates caller first (call sole-field receiver))
    (let written false)
    (let alternatives (== (. ([] (. types completions) receiver) intrinsic) .or))
    (for (in candidate candidates)
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case (call .decl-function fn)
          (if (== (. fn kind) .constructor-decl)
            (= written true)
          )
        )
      )
    )
    (for (in candidate candidates)
      (let target ([] (. program modules) (. candidate module)))
      (match? ([] (. target decls) (. candidate decl))
        (case (call .decl-function fn)
          (let generic (. ([] (. types completions) receiver) has-variables))
          (if (and (!= (. explicit length) 0) (!= (. fn kind) .constructor-decl))
            (continue)
          )
          (if (and (== (. fn kind) .default-constructor-decl) alternatives)
            (continue)
          )
          (if (and (== (. fn kind) .default-constructor-decl) (not generic))
            (call accept (call constrained (call rank-default (. candidate module) (. candidate decl) receiver)))
            (else-if (== (. fn kind) .default-constructor-decl)
              (let defaulted (call with-defaults receiver))
              (if (!= defaulted no-type)
                (call accept (call constrained (call rank-default (. candidate module) (. candidate decl) defaulted)))
                (else-if (and (== (. args length) 0) (not written))
                  (let open (call rank-default (. candidate module) (. candidate decl) receiver))
                  (= is-partial true)
                  (call accept open)
                )
              )
            )
            (else-if (and (== (. fn kind) .cast-constructor-decl) (not generic))
              (call accept (call rank-cast (. candidate module) (. candidate decl) receiver))
            )
            (else-if (== (. fn kind) .tuple-constructor-decl)
              (call accept (call rank-tuple (. candidate module) (. candidate decl) receiver))
            )
            (else-if (or (== (. fn kind) .constructor-decl) (call is-table-constructor-kind (. fn kind)))
              (let plain (call no-type-arguments types))
              (let ranked (call rank-function (. candidate module) (. candidate decl) receiver plain))
              (call accept (call constrained ranked))
            )
          )
        )
        (case .decl-fromverter
          (if (== (. explicit length) 0)
            (call accept (call rank-fromverter (. candidate module) (. candidate decl) receiver))
          )
        )
      )
    )
    (call remember)
    (return best)
  )
  (fn-do _ sole-field TypeId
    (param receiver TypeId)
    ; The type of the one field a tuple or a struct called with one value stores, worked out
    ; where the type does not write it, which tells whether the value is the field or one to
    ; convert; no type for any other call.
    (let kind (. ([] (. types completions) receiver) intrinsic))
    (if (or (!= (. args length) 1) (and (!= kind .tuple) (!= kind .struct)))
      (return no-type)
    )
    (let found (? TypeProperty) null)
    (let count 0u32)
    (for (in fact ([] (. types properties) (. ([] (. types completions) receiver) properties)))
      (if (!= (. fact slot) (. U32 max))
        (= found fact)
        (+= count 1)
      )
    )
    (if (or (!= count 1) (!= (. (!! found) type) no-type))
      (return no-type)
    )
    (return (call field-type (!! found) receiver))
  )
  (fn-do _ constrained (? Hit)
    (param hit (? Hit))
    ; A constructor constructs only a class whose parameters meet the constraints the class
    ; declares for them.
    (if (not hit)
      (return null)
    )
    (let receiver (. hit receiver))
    (if (or (== receiver no-type) (. ([] (. types completions) receiver) has-variables))
      (return hit)
    )
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (let target ([] (. program modules) (. row module)))
        (match? ([] (. target decls) (. row decl))
          (case (call .decl-class class)
            (if (== (. class param-constraints count) 0)
              (return hit)
            )
            (let owner Index (. row module))
            (let env (call (. types class-env-for) (. row module) (. row decl) (. row args) receiver))
            (let holds true)
            (for (in id ([] (. target tree children) (. class param-constraints)))
              (match? ([] (. target tree nodes) id)
                (case (call .node-param-constraint constraint)
                  (let left
                    (call (. types evaluate-type)
                      (block
                        (arg (as owner ModuleId))
                        (arg (. target tree))
                        (arg (. constraint left))
                        (arg env)
                      )
                    )
                  )
                  (let right
                    (call (. types evaluate-type)
                      (block
                        (arg (as owner ModuleId))
                        (arg (. target tree))
                        (arg (. constraint right))
                        (arg env)
                      )
                    )
                  )
                  (if (and (!= left invalid-type) (!= right invalid-type))
                    (let required (call required-match (. constraint op)))
                    (let met (call (. relations compare) left right false false null caller))
                    (if (not (call (. relations holds-as) met required true))
                      (= holds false)
                    )
                  )
                )
              )
            )
            (call (. types env-release) env)
            (if (not holds)
              (return null)
            )
          )
        )
      )
    )
    (return hit)
  )
  (fn-do _ with-defaults TypeId
    (param receiver TypeId)
    ; A class named without its parameters, each of which its declaration assigns a type, is the
    ; class of those types.
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (let mark (. scratch types mark))
        (for (in position (..< 0 (. row args count)))
          (let arg (call (. types child-type) (. row args) position))
          (if (. ([] (. types completions) arg) has-variables)
            (break)
          )
          (call (. scratch types push) arg)
        )
        (let filled (call (. types class-with-args) (. row module) (. row decl) mark))
        (if (and (!= filled invalid-type) (not (. ([] (. types completions) filled) has-variables)))
          (return filled)
        )
      )
    )
    (return no-type)
  )
  (fn-do + rank-fromverter (? Hit)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (= is-partial false)
    (if (!= (. calls length) 1)
      (return null)
    )
    (let items-start (. scratch types mark))
    (let names-start (. scratch names mark))
    (let words-start (. scratch words mark))
    (let relations-start (. scratch relations mark))
    (let signature (call signature-into types module decl (call no-type-arguments types) receiver true))
    (let fills-start (. scratch words mark))
    (call (. scratch words push) 0)
    (let fills (call (. scratch words since) fills-start))
    (let expected-start (. scratch types mark))
    (call (. scratch types push) ([] (. signature args) 0))
    (let expected (call (. scratch types since) expected-start))
    (let scope (call (. relations scope-open)))
    (let tails (call TailMatch (. scratch no-fills) (. scratch no-relations)))
    (let relations-mark (. scratch relations mark))
    (let args-mark (. scratch types mark))
    (let was-asked asked)
    (= asked true)
    (let ranked
      (call rank-slots
        (block
          (arg scope)
          (arg false)
          (arg fills)
          (arg expected)
          (arg expected)
          (arg (. scratch no-fills))
          (arg (. scratch no-fills))
          (arg (. U32 max))
          (arg tails)
          (arg (. scratch no-fills))
        )
      )
    )
    (= asked was-asked)
    (call (. relations scope-release) scope)
    (if (not ranked)
      (call (. scratch types rewind) items-start)
      (call (. scratch names rewind) names-start)
      (call (. scratch words rewind) words-start)
      (call (. scratch relations rewind) relations-start)
      (return null)
    )
    (let args (call (. scratch types since) args-mark))
    (let slot-relations (call (. scratch relations since) relations-mark))
    (return
      (call Hit
        (block
          (arg module)
          (arg decl)
          (arg receiver)
          (arg (. scratch no-types))
          (arg args)
          (arg fills)
          (arg slot-relations)
          (arg (. tails fills))
          (arg (. tails relations))
          (arg false)
        )
      )
    )
  )
  (fn-do _ accept _
    (param hit (? Hit))
    (if (not hit)
      (call (. ranked clear))
      (call (. ranked-params clear))
      (return)
    )
    (if is-partial
      (if (not partial)
        (= partial hit)
      )
      (call (. ranked clear))
      (return)
    )
    (if (and best (!= (. best receiver) no-type) (== (. hit receiver) no-type))
      (call (. ranked clear))
      (return)
    )
    (if (!= (. ranked length) (. hit relations length))
      (call (. ranked clear))
      (for (in relation (. hit relations))
        (+= ranked relation)
      )
    )
    (if best
      (let equal (call equal-ranking best hit))
      (let same (and (== (. (!! best) module) (. hit module)) (== (. (!! best) decl) (. hit decl))))
      (let constructors (and (== kind .rank-constructor) (not (call is-generated (!! best))) (not (call is-generated hit))))
      (if (and constructors equal (call equal-specificity (!! best) hit) (call different-params (!! best) hit))
        (= ambiguous-constructor true)
        (else-if (and (== kind .rank-static) equal (not same) (call equal-specificity (!! best) hit))
          (= ambiguous-static true)
        )
        (else-if (and (not same) (. (!! best) is-extension) (. hit is-extension))
          (let preferred (call row-case-preference (!! best) hit))
          (if (< preferred 0)
            (call (. ranked clear))
            (call (. ranked-params clear))
            (return)
          )
          (= ambiguous-extension (== preferred 0))
        )
        (else-if (and (not same) (!= (. (!! best) is-extension) (. hit is-extension)) (call same-signature (!! best) hit))
          (= conflicting (or conflicting (not (or (call is-facet-member (!! best)) (call is-facet-member hit)))))
        )
      )
      (if (not equal)
        (= ambiguous-constructor false)
        (= ambiguous-static false)
      )
    )
    (= best hit)
    (call (. incumbent clear))
    (for (in relation ranked)
      (+= incumbent relation)
    )
    (= incumbent-variadic (or (!= (. hit tail-fills length) 0) (call is-variadic (. hit module) (. hit decl))))
    (call (. incumbent-params clear))
    (for (in param ranked-params)
      (+= incumbent-params param)
    )
    (call (. ranked clear))
    (call (. ranked-params clear))
  )
  (fn-expr + ambiguity (? TypeDiagnosticKind)
    (case? (not best)
      null
    )
    (case? (and (. best is-extension) ambiguous-extension)
      .ambiguous-extension
    )
    (case? ambiguous-constructor
      .ambiguous-constructor
    )
    (case? ambiguous-static
      .ambiguous-static
    )
    (case? conflicting
      .extension-conflict
    )
    (default
      null
    )
  )
  (fn-expr _ row-case-preference I32
    (param kept Hit)
    (param next Hit)
    ; Which of two extensions' members a name that stands for the case of a row (`row-case`) takes,
    ; as TypeScript's `preferNarrowedTableRowExtension` does: the one that extends the case itself
    ; over one that extends a base of it, -1 for `kept`, 1 for `next`, or 0 for neither.
    (case? (or (== row-case no-type) (== (== (. kept level) row-case) (== (. next level) row-case)))
      0
    )
    (case? (== (. kept level) row-case)
      -1
    )
    (default
      1
    )
  )
  (fn-do _ equal-ranking Bool
    (param left Hit)
    (param right Hit)
    ; Whether a candidate ranks as the one chosen so far does, slot by slot, by what each has
    ; compared its arguments to: `incumbent` for the one chosen, `ranked` for the new one.
    (if (or (!= (. left fills length) (. right fills length)) (!= (. left tail-fills length) (. right tail-fills length)))
      (return false)
    )
    (if (!= (. incumbent length) (. ranked length))
      (return false)
    )
    (for (in position (..< 0 (. incumbent length)))
      (if (!= (. ([] incumbent position) rank) (. ([] ranked position) rank))
        (return false)
      )
    )
    (for (in position (..< 0 (. left tail-relations length)))
      (if (!= (. ([] (. left tail-relations) position) rank) (. ([] (. right tail-relations) position) rank))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ is-generated Bool
    (param hit Hit)
    (match? ([] (. ([] (. program modules) (. hit module)) decls) (. hit decl))
      (case (call .decl-function fn)
        (return (. fn is-generated))
      )
    )
    (return false)
  )
  (fn-do _ equal-specificity Bool
    (param left Hit)
    (param right Hit)
    (let mine ([] (. program modules) (. left module)))
    (let theirs ([] (. program modules) (. right module)))
    (let count (. U32 max))
    (let start Index 0)
    (let variadic (. U32 max))
    (match? ([] (. mine decls) (. left decl))
      (case (call .decl-function fn)
        (= count (. fn args count))
        (= start (. fn args start))
        (= variadic (. fn variadic-index))
      )
    )
    (match? ([] (. theirs decls) (. right decl))
      (case (call .decl-function fn)
        (let plain (== (. fn variadic-index) (. U32 max)))
        (if (or (!= (. fn args count) count) (!= plain (== variadic (. U32 max))))
          (return false)
        )
        (let other Index (. fn args start))
        (let offset 0u32)
        (while (< offset count)
          (let spec (. ([] (. mine arg-pool) (+ start offset)) specificity))
          (if (!= spec (. ([] (. theirs arg-pool) (+ other offset)) specificity))
            (return false)
          )
          (+= offset 1)
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ different-params Bool
    (param left Hit)
    (param right Hit)
    (if (!= (. left params length) (. right params length))
      (return false)
    )
    (for (in offset (..< 0 (. left params length)))
      (if (!= ([] (. left params) offset) ([] (. right params) offset))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-facet-member Bool
    (param hit Hit)
    ; Whether a candidate is a member of a facet, which a class below the facet's own declares again
    ; to override it, as it would a member of the class, and which answers an interface's function as
    ; the class's own member would.
    (return-if false (if (or (not (. hit is-extension)) (== (. program facets count) 0))))
    (blank)
    (match? ([] (. ([] (. program modules) (. hit module)) decls) (. hit decl))
      (case (call .decl-function fn)
        (return (!= (call (. program facets index-of) (. hit module) (. fn owner)) null))
      )
    )
    (return false)
  )
  (fn-do _ same-signature Bool
    (param left Hit)
    (param right Hit)
    (let mine ([] (. program modules) (. left module)))
    (let theirs ([] (. program modules) (. right module)))
    (let count (. U32 max))
    (let start Index 0)
    (match? ([] (. mine decls) (. left decl))
      (case (call .decl-function fn)
        (= count (. fn args count))
        (= start (. fn args start))
      )
    )
    (match? ([] (. theirs decls) (. right decl))
      (case (call .decl-function fn)
        (if (or (!= (. fn args count) count) (!= (. left fills length) (. right fills length)))
          (return false)
        )
        (let other Index (. fn args start))
        (let offset 0u32)
        (while (< offset count)
          (let called (. ([] (. mine arg-pool) (+ start offset)) name))
          (if (!= called (. ([] (. theirs arg-pool) (+ other offset)) name))
            (return false)
          )
          (+= offset 1)
        )
        (for (in position (..< 0 (. left fills length)))
          (if (!= ([] (. left args) position) ([] (. right args) position))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-variadic Bool
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (!= (. fn variadic-index) (. U32 max)))
      )
    )
    (return false)
  )
  (fn-do _ rank-methods _
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    (let viewed (call (. types facet-of-type) receiver))
    (if viewed
      (call rank-facet-members viewed name kind)
      (return)
    )
    (let receiver-kind (call (. types intrinsic-of) receiver))
    (let base (call (. types base-of) receiver))
    (if (!= receiver-kind .interface)
      (call rank-default-methods receiver receiver name kind)
    )
    (call rank-delegates receiver name kind)
    (if base
      (call rank-bases base receiver name kind)
    )
    (if (== receiver-kind .interface)
      (call rank-parent-interfaces receiver receiver name kind)
    )
    (call rank-methods-at receiver receiver name kind)
    (if (or (== receiver-kind .table-row) (== receiver-kind .immutable-table-row))
      (call rank-logical receiver name kind)
    )
  )
  (fn-do _ rank-facet-members _
    (param facet U32)
    (param name Atom)
    (param kind DeclKind)
    ; Ranks what a facet's value answers: the members of the facet and of its ancestor facets that
    ; the caller sees, the nearest last, each run on the facet's owner, so that a class below that
    ; declares one again answers for it.
    (let facets (. program facets))
    (let owner (call (. types facet-owner) facet))
    (let chain (list U32))
    (let current facet)
    (while (and (!= current (. U32 max)) (<= (. chain length) (. facets count)))
      (+= chain current)
      (= current ([] (. facets parents) current))
    )
    (for (in offset (..< 0 (. chain length)))
      (let held ([] chain (- (. chain length) 1 offset)))
      (if (not (call (. program sees-facet) caller held))
        (continue)
      )
      (let module ([] (. facets modules) held))
      (let target ([] (. program modules) module))
      (match? ([] (. target decls) ([] (. facets decls) held))
        (case (call .decl-extension body)
          (= extension-ranking true)
          (= extension-level owner)
          (call rank-members module target (. body members) name owner (call no-type-arguments types) kind)
          (= extension-ranking false)
          (= extension-level no-type)
        )
      )
    )
  )
  (fn-do _ rank-bases _
    (param level TypeId)
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    ; Ranks what a base class answers. Its interfaces and delegates are ranked on the way to the
    ; root and its own members on the way back, so that of two candidates that rank alike the
    ; one declared nearest the receiver stands.
    (if (!= (call (. types intrinsic-of) receiver) .interface)
      (call rank-default-methods level receiver name kind)
    )
    (call rank-delegates level name kind)
    (let base (call (. types base-of) level))
    (if base
      (call rank-bases base receiver name kind)
    )
    (call rank-methods-at level receiver name kind)
  )
  (fn-do _ rank-logical _
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    ; A table row over a union also answers the extension methods and getters of the union, and
    ; the extension methods of each base all of its cases share, which run with the row itself as
    ; the receiver, as TypeScript's rows answer them. A getter of such a base is each case's own.
    (let union (call class-arg types receiver 0))
    (if (or (== union no-type) (!= (call (. types intrinsic-of) union) .union) (== kind .setter-decl))
      (return)
    )
    (= adapted receiver)
    (call rank-extensions union name kind)
    (let shared (if-expr (== kind .function-decl) (call (. types shared-case-base) union) no-type))
    (while (!= shared no-type)
      (call rank-extensions shared name kind)
      (= shared (call (. types shared-case-base) union shared))
    )
    (= adapted no-type)
  )
  (fn-expr _ readdress (? Hit)
    (param hit (? Hit))
    (case? (or (not hit) (== adapted no-type))
      hit
    )
    (default
      (call Hit
        (block
          (arg (. hit module))
          (arg (. hit decl))
          (arg adapted)
          (arg (. hit params))
          (arg (. hit args))
          (arg (. hit fills))
          (arg (. hit relations))
          (arg (. hit tail-fills))
          (arg (. hit tail-relations))
          (arg true)
          (arg (. hit level))
        )
      )
    )
  )
  (fn-do + has-extension-getter Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether an extension in scope adds a getter of this name to the receiver or to a base of it.
    (let level (? TypeId) receiver)
    (while level
      (let ref (call DeclRef (. U32 max) (. U32 max)))
      (match? ([] (. types rows) level)
        (case (call .type-class row)
          (= ref (call DeclRef (. row module) (. row decl)))
        )
      )
      (if (!= (. ref module) (. U32 max))
        (for (in extension (call (. program extensions-for) caller (. ref module) (. ref decl)))
          (if (call extends-getter (. extension module) (. extension decl) level name)
            (return true)
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do + extension-functions (list DeclRef)
    (param receiver TypeId)
    (param name Atom)
    (let found (list DeclRef))
    (let level (? TypeId) receiver)
    (while level
      (match? ([] (. types rows) level)
        (case (call .type-class row)
          (for (in extension (call (. program extensions-for) caller (. row module) (. row decl)))
            (let matched (call (. relations match-extension) (. extension module) (. extension decl) level))
            (if matched
              (call (. types env-release) (. matched env))
              (call add-named-functions (. extension module) (. extension decl) name found)
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return found)
  )
  (fn-do _ add-named-functions _
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (param found (list DeclRef))
    (let target ([] (. program modules) module))
    (match? ([] (. target decls) decl)
      (case (call .decl-extension body)
        (for (in member (call (. target members-named) (. body members) name))
          (match? ([] (. target decls) member)
            (case (call .decl-function row)
              (if (and (. row name) (== (. row name) name) (== (. row kind) .function-decl))
                (+= found (call DeclRef module member))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ extends-getter Bool
    (param module ModuleId)
    (param decl DeclId)
    (param level TypeId)
    (param name Atom)
    (let target ([] (. program modules) module))
    (match? ([] (. target decls) decl)
      (case (call .decl-extension body)
        (let named false)
        (for (in member (call (. target members-named) (. body members) name))
          (match? ([] (. target decls) member)
            (case (call .decl-function row)
              (if (and (== (. row kind) .getter-decl) (. row name) (== (. row name) name))
                (= named true)
              )
            )
          )
        )
        (if (not named)
          (return false)
        )
        (let matched (call (. relations match-extension) module decl level))
        (if matched
          (call (. types env-release) (. matched env))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ rank-delegates _
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    ; A class that implements an interface through a property answers that interface's methods
    ; with the property's own.
    (let delegates (call (. types delegates-of) receiver))
    (for (in offset (..< 0 (/ (. delegates length) 2)))
      (if (call skips-delegate receiver offset)
        (continue)
      )
      (if (call declares-method ([] delegates (* offset 2)) name kind)
        (let held (call delegate-type receiver offset))
        (if (call lends receiver held)
          (call rank-methods held name kind)
          (call lent)
        )
      )
    )
  )
  (fn-do _ skips-delegate Bool
    (param level TypeId)
    (param offset Size)
    (return-if false (if (or (== delegated no-type) (call delegates-for level offset))))
    (return (call some (..< 0 (/ (. (call (. types delegates-of) level) length) 2)) (:where (call delegates-for level each))))
  )
  (fn-expr _ delegates-for Bool
    (param level TypeId)
    (param offset Size)
    (call reaches-interface ([] (call (. types delegates-of) level) (* offset 2)) delegated)
  )
  (fn-do _ reaches-interface Bool
    (param interface TypeId)
    (param wanted TypeId)
    (return-if true (if (== interface wanted)))
    (return (call some (call (. types interfaces-of) interface) (:where (call reaches-interface each wanted))))
  )
  (fn-do _ lends Bool
    (param level TypeId)
    (param held TypeId)
    ; Whether a search goes on from a class into what a property it delegates to holds, which
    ; it then leaves by `lent`. It does not where that is the class itself or a type the search
    ; has come through: a delegation that leads back to its own class ends there.
    (if (or (== held no-type) (== held invalid-type) (== held level))
      (return false)
    )
    (for (in lender lenders)
      (if (== lender held)
        (return false)
      )
    )
    (+= lenders level)
    (+= lenders held)
    (return true)
  )
  (fn-do _ lent _
    (call (. lenders pop))
    (call (. lenders pop))
  )
  (fn-do + delegate-type TypeId
    (param receiver TypeId)
    (param offset Size)
    ; The type of the property a class delegates an interface to, typing its initializer when the
    ; property declares no type.
    (let held ([] (call (. types delegates-of) receiver) (+ (* offset 2) 1)))
    (if (!= held no-type)
      (return held)
    )
    (let name (call (. types delegate-name) receiver offset))
    (let found (call (. types property-named) receiver name))
    (if (or (not found) (not host))
      (return no-type)
    )
    (= consulted true)
    (return (call (. host demand-member) ([] (. types properties) found) receiver name))
  )
  (fn-do _ declares-method Bool
    (param interface TypeId)
    (param name Atom)
    (param kind DeclKind)
    (let ref (call DeclRef (. U32 max) (. U32 max)))
    (match? ([] (. types rows) interface)
      (case (call .type-class row)
        (= ref (call DeclRef (. row module) (. row decl)))
      )
    )
    (if (== (. ref module) (. U32 max))
      (return false)
    )
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class row)
        (for (in member (call (. owner members-named) (. row members) name))
          (match? ([] (. owner decls) member)
            (case (call .decl-function fn)
              (if (and (. fn name) (== (. fn name) name) (== (. fn kind) kind))
                (return true)
              )
            )
          )
        )
      )
    )
    (for (in parent (call (. types interfaces-of) interface))
      (if (call declares-method parent name kind)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + delegates-to Bool
    (param receiver TypeId)
    (param held TypeId)
    ; Whether a class answers for a type through a property it delegates to, directly, through
    ; that property's own delegates, or through a base class's. A property of a class derived
    ; from the type answers for it too.
    (let current receiver)
    (while (!= current no-type)
      (for (in offset (..< 0 (/ (. (call (. types delegates-of) current) length) 2)))
        (let delegate (call delegate-type current offset))
        (if (call answers-as delegate held)
          (return true)
        )
        (if (call lends current delegate)
          (let answers (call delegates-to delegate held))
          (call lent)
          (if answers
            (return true)
          )
        )
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do _ answers-as Bool
    (param delegate TypeId)
    (param held TypeId)
    ; Whether what a property holds answers as a type: it is of that type, or of a class derived
    ; from it, whose members the type declares.
    (let current delegate)
    (while (and (!= current no-type) (!= current invalid-type))
      (if (== current held)
        (return true)
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do + delegate-path Bool
    (param receiver TypeId)
    (param held TypeId)
    (param places (list U32))
    ; The properties read from a value of a class to reach what answers for it as `held`, as
    ; `delegates-to` finds it: the place of each is appended in the order they are read.
    ; Nothing is appended where the class does not answer so.
    (let current receiver)
    (while (!= current no-type)
      (for (in offset (..< 0 (/ (. (call (. types delegates-of) current) length) 2)))
        (if (call skips-delegate current offset)
          (continue)
        )
        (let delegate (call delegate-type current offset))
        (let found (call (. types property-named) current (call (. types delegate-name) current offset)))
        (if (or (not found) (== delegate no-type) (== delegate invalid-type))
          (continue)
        )
        (let mark (. places length))
        (+= places (as found U32))
        (if (call answers-as delegate held)
          (return true)
        )
        (if (call lends current delegate)
          (let reaches (call delegate-path delegate held places))
          (call lent)
          (if reaches
            (return true)
          )
        )
        (while (> (. places length) mark)
          (call (. places pop))
        )
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do + interface-holder TypeId
    (param receiver TypeId)
    (param interface TypeId)
    (param places (list U32))
    ; What a class delegates an interface to: the type of the property it names for it, or one of
    ; its bases names, whose place is appended. No type where the class implements it itself.
    (let current receiver)
    (while (!= current no-type)
      (let delegates (call (. types delegates-of) current))
      (for (in offset (..< 0 (/ (. delegates length) 2)))
        (if (!= ([] delegates (* offset 2)) interface)
          (continue)
        )
        (let delegate (call delegate-type current offset))
        (let found (call (. types property-named) current (call (. types delegate-name) current offset)))
        (if (and found (!= delegate no-type) (!= delegate invalid-type))
          (+= places (as found U32))
          (return delegate)
        )
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return no-type)
  )
  (fn-do + delegated-holder TypeId
    (param receiver TypeId)
    (param name Atom)
    (param places (list U32))
    ; The type that answers a name for a class through the properties it delegates interfaces
    ; to, where the class holds no property of the name: what a search of its bases, from the
    ; first of them, reaches. A class asks each property it delegates an interface that declares
    ; the name to, which answers where its type holds the property or reaches one so, and then
    ; its own interfaces, where one that declares the name ends the search. The place of each
    ; property read to reach the answer is appended in the order they are read; none is where
    ; an interface of the class answers, or nothing does.
    (let current receiver)
    (while (and (!= current no-type) (== (. (call (. types delegates-of) current) length) 0))
      (= current (?? (call (. types base-of) current) no-type))
    )
    (if (== current no-type)
      (return no-type)
    )
    (return (call seek-holder receiver name places))
  )
  (fn-do _ seek-holder TypeId
    (param receiver TypeId)
    (param name Atom)
    (param places (list U32))
    (let levels (list TypeId))
    (let current receiver)
    (while (!= current no-type)
      (+= levels current)
      (= current (?? (call (. types base-of) current) no-type))
    )
    (for (in back (..< 0 (. levels length)))
      (let level ([] levels (- (. levels length) 1 back)))
      (for (in offset (..< 0 (/ (. (call (. types delegates-of) level) length) 2)))
        (if (or (call skips-delegate level offset) (not (call declares-property ([] (call (. types delegates-of) level) (* offset 2)) name)))
          (continue)
        )
        (let delegate (call delegate-type level offset))
        (let read (call (. types property-named) level (call (. types delegate-name) level offset)))
        (if (or (not read) (== delegate no-type) (== delegate invalid-type))
          (continue)
        )
        (let mark (. places length))
        (+= places (as read U32))
        (if (call (. types property-named) delegate name)
          (return delegate)
        )
        (if (call lends level delegate)
          (let reached (call seek-holder delegate name places))
          (call lent)
          (if (!= reached no-type)
            (return reached)
          )
        )
        (while (> (. places length) mark)
          (call (. places pop))
        )
      )
      (for (in interface (call (. types interfaces-of) level))
        (if (call declares-property interface name)
          (return level)
        )
      )
    )
    (return no-type)
  )
  (fn-do _ declares-property Bool
    (param interface TypeId)
    (param name Atom)
    ; Whether an interface declares a property of a name, itself or one it is derived from.
    (if (call (. types property-named) interface name)
      (return true)
    )
    (for (in parent (call (. types interfaces-of) interface))
      (if (call declares-property parent name)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ rank-default-methods _
    (param level TypeId)
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    (for (in interface (call (. types interfaces-of) level))
      (call rank-default-methods interface receiver name kind)
      (let ref (call DeclRef (. U32 max) (. U32 max)))
      (match? ([] (. types rows) interface)
        (case (call .type-class row)
          (= ref (call DeclRef (. row module) (. row decl)))
        )
      )
      (if (== (. ref module) (. U32 max))
        (continue)
      )
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class row)
          (call rank-defaults (. ref module) owner (. row members) name receiver kind)
        )
      )
    )
  )
  (fn-do _ rank-defaults _
    (param module ModuleId)
    (param target Module)
    (param members (of RowRange DeclId))
    (param name Atom)
    (param receiver TypeId)
    (param kind DeclKind)
    (for (in member (call (. target members-named) members name))
      (match? ([] (. target decls) member)
        (case (call .decl-function row)
          (let named (and (. row name) (== (. row name) name)))
          (if (and named (== (. row kind) kind) (not (. row is-static)) (!= (. row body) 0))
            (call accept (call rank-function module member receiver (call no-type-arguments types)))
          )
        )
      )
    )
  )
  (fn-do _ rank-parent-interfaces _
    (param level TypeId)
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    ; An interface answers the methods of the interfaces it extends, such as `<-read` on an
    ; Iterable through Readable.
    (for (in parent (call (. types interfaces-of) level))
      (call rank-parent-interfaces parent receiver name kind)
      (call rank-methods-at parent receiver name kind)
    )
  )
  (fn-do _ rank-methods-at _
    (param level TypeId)
    (param receiver TypeId)
    (param name Atom)
    (param kind DeclKind)
    (let ref (call DeclRef (. U32 max) (. U32 max)))
    (match? ([] (. types rows) level)
      (case (call .type-class row)
        (= ref (call DeclRef (. row module) (. row decl)))
      )
    )
    (if (== (. ref module) (. U32 max))
      (return)
    )
    (let held (. ([] (. types completions) receiver) intrinsic))
    (call rank-extensions level name kind (if-expr (call intrinsic-is-class held) level receiver))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class row)
        (let self (if-expr (call intrinsic-is-class held) level receiver))
        (call rank-members (. ref module) owner (. row members) name self (call no-type-arguments types) kind)
      )
    )
  )
  (fn-do _ rank-extensions _
    (param level TypeId)
    (param name Atom)
    (param kind DeclKind)
    (param receiver TypeId (= no-type))
    ; Ranks the members extensions add to a type. A value that is not an object of a class, such
    ; as a tuple, a struct or a number, is the receiver of what an extension of its base adds, as it
    ; is of what its base declares.
    (let ref (call DeclRef (. U32 max) (. U32 max)))
    (match? ([] (. types rows) level)
      (case (call .type-class row)
        (= ref (call DeclRef (. row module) (. row decl)))
      )
    )
    (if (== (. ref module) (. U32 max))
      (return)
    )
    (for (in extension (call (. program extensions-for) caller (. ref module) (. ref decl)))
      (let matched (call (. relations match-extension) (. extension module) (. extension decl) level))
      (if matched
        (let names-start (. scratch names mark))
        (let items-start (. scratch types mark))
        (call env-bindings (. matched env))
        (let bound-names (call (. scratch names since) names-start))
        (let bindings (call TypeArguments bound-names (call (. scratch types since) items-start)))
        (call (. types env-release) (. matched env))
        (let extended ([] (. program modules) (. extension module)))
        (match? ([] (. extended decls) (. extension decl))
          (case (call .decl-extension body)
            (= extension-ranking true)
            (= extension-level level)
            (call rank-members
              (block
                (arg (. extension module))
                (arg extended)
                (arg (. body members))
                (arg name)
                (arg (if-expr (!= receiver no-type) receiver level))
                (arg bindings)
                (arg kind)
              )
            )
            (= extension-ranking false)
            (= extension-level no-type)
          )
        )
      )
    )
  )
  (fn-do _ rank-members _
    (param module ModuleId)
    (param target Module)
    (param members (of RowRange DeclId))
    (param name Atom)
    (param receiver TypeId)
    (param bindings TypeArguments)
    (param kind DeclKind)
    (for (in member (call (. target members-named) members name))
      (match? ([] (. target decls) member)
        (case (call .decl-function row)
          (let named (and (. row name) (== (. row name) name)))
          (if (and named (== (. row kind) kind) (not (. row is-static)) (call visible-from module (. row access)))
            (call accept (call readdress (call rank-function module member receiver bindings)))
          )
        )
      )
    )
  )
  (fn-do _ rank-statics _
    (param module ModuleId)
    (param target Module)
    (param members (of RowRange DeclId))
    (param name Atom)
    (param owner TypeId)
    (for (in member (call (. target members-named) members name))
      (match? ([] (. target decls) member)
        (case (call .decl-function row)
          (let named (and (. row name) (== (. row name) name)))
          (let open (call visible-from module (. row access)))
          (if (and named (== (. row kind) .function-decl) (. row is-static) open)
            (call accept (call rank-function module member owner (call no-type-arguments types)))
          )
        )
      )
    )
  )
  (fn-do _ env-bindings Size
    (param env TypeEnv)
    (let names-start (. scratch names mark))
    (let count 0)
    (for (in position (..< (. env start) (. env end)))
      (let name (call (. types env-name) position))
      (if (not (call name-in-range names-start count name))
        (let type (call (. types env-lookup) env name))
        (if type
          (call (. scratch names push) name)
          (call (. scratch types push) type)
          (+= count 1)
        )
      )
    )
    (return count)
  )
  (fn-do _ name-in-range Bool
    (param start Size)
    (param count Size)
    (param name Atom)
    (for (in offset (..< 0 count))
      (if (== ([] (. scratch names) (+ start offset)) name)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + rank-default (? Hit)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (= is-partial false)
    (for (in call calls)
      (if (not (. call is-property))
        (return null)
      )
    )
    (let params-start (. scratch types mark))
    (call push-class-params receiver)
    (let params (call (. scratch types since) params-start))
    (let none (. scratch no-relations))
    (return
      (call Hit
        (block
          (arg module)
          (arg decl)
          (arg receiver)
          (arg params)
          (arg (. scratch no-types))
          (arg (. scratch no-fills))
          (arg none)
          (arg (. scratch no-fills))
          (arg none)
          (arg false)
        )
      )
    )
  )
  (fn-do _ push-class-params _
    (param receiver TypeId)
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (for (in position (..< 0 (. row args count)))
          (call (. scratch types push) (call (. types child-type) (. row args) position))
        )
      )
    )
  )
  (fn-do + rank-cast (? Hit)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    ; A type called with one value, which converts as `as` does: a type of alternatives gives the
    ; value as the alternative it converts to, and any other type casts the value to itself.
    (= is-partial false)
    (if (!= (. calls length) 1)
      (return null)
    )
    (let items-start (. scratch types mark))
    (let words-start (. scratch words mark))
    (let relations-start (. scratch relations mark))
    (let fills-start (. scratch words mark))
    (call (. scratch words push) 0)
    (let fills (call (. scratch words since) fills-start))
    (let expected-start (. scratch types mark))
    (call (. scratch types push) receiver)
    (let expected (call (. scratch types since) expected-start))
    (let scope (call (. relations scope-open)))
    (let tails (call TailMatch (. scratch no-fills) (. scratch no-relations)))
    (let relations-mark (. scratch relations mark))
    (let args-mark (. scratch types mark))
    (let was-asked asked)
    (= asked true)
    (let ranked
      (call rank-slots
        (block
          (arg scope)
          (arg false)
          (arg fills)
          (arg expected)
          (arg expected)
          (arg (. scratch no-fills))
          (arg (. scratch no-fills))
          (arg (. U32 max))
          (arg tails)
          (arg (. scratch no-fills))
        )
      )
    )
    (= asked was-asked)
    (call (. relations scope-release) scope)
    (if (not ranked)
      (call (. scratch types rewind) items-start)
      (call (. scratch words rewind) words-start)
      (call (. scratch relations rewind) relations-start)
      (return null)
    )
    (let args (call (. scratch types since) args-mark))
    (let slot-relations (call (. scratch relations since) relations-mark))
    (let alternative (and (== (call (. types intrinsic-of) receiver) .or) (== (. slot-relations length) 1)))
    (return
      (call Hit
        (block
          (arg module)
          (arg decl)
          (arg (if-expr alternative (. ([] slot-relations 0) to) receiver))
          (arg (. scratch no-types))
          (arg args)
          (arg fills)
          (arg slot-relations)
          (arg (. tails fills))
          (arg (. tails relations))
          (arg false)
        )
      )
    )
  )
  (fn-do + rank-tuple (? Hit)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (= is-partial false)
    (let items-start (. scratch types mark))
    (let words-start (. scratch words mark))
    (let relations-start (. scratch relations mark))
    (let scope (call (. relations scope-open)))
    (let hit (call rank-fields scope module decl receiver))
    (call (. relations scope-release) scope)
    (if (not hit)
      (call (. scratch types rewind) items-start)
      (call (. scratch words rewind) words-start)
      (call (. scratch relations rewind) relations-start)
    )
    (return hit)
  )
  (fn-do _ field-type TypeId
    (param fact TypeProperty)
    (param receiver TypeId)
    (if (!= (. fact type) no-type)
      (return (. fact type))
    )
    (if (not host)
      (return invalid-type)
    )
    (= consulted true)
    (return (call (. host demand-member) fact receiver (. fact name)))
  )
  (fn-do _ field-has-default Bool
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (let owner-module ([] (. program modules) module))
    (let members (call (of RowRange DeclId)))
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-class row)
        (= members (. row members))
      )
    )
    (for (in member (call (. owner-module members-named) members name))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-property row)
          (if (and (. row name) (== (. row name) name))
            (return (!= (. row value) 0))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ rank-fields (? Hit)
    (param scope MatchScope)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (let generic (call (. types is-generic) receiver))
    (let class-args (call (of RowRange TypeId)))
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (= class-args (. row args))
