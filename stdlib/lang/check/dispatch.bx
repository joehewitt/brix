    (blank)
    (let owner 0u32)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (= owner (. fn owner))
      )
    )
    (blank)
    (let type-args (call (. types class-type-args) module owner))
    (let tree (. ([] (. program modules) module) tree))
    (blank)
    (if generic
      (for (in position (..< 0 (. class-args count)))
        (let name (call (. types class-param-name) tree type-args position))
        (if name
          (let bound (call (. types child-type) class-args position))
          (let declared (call (. relations scope-declare) scope name false bound))
          (if (not declared)
            (return null)
          )
          (= scope declared)
        )
      )
    )
    (blank)
    (let fields (. ([] (. types completions) receiver) properties))
    (let expected-start (. scratch types mark))
    (let names-start (. scratch names mark))
    (let count 0)
    (for (in fact ([] (. types properties) fields))
      (if (!= (. fact slot) (. U32 max))
        (call (. scratch types push) (call field-type fact receiver))
        (call (. scratch names push) (. fact name))
        (+= count 1)
      )
    )
    (let expected (call (. scratch types since) expected-start))
    (let names (call (. scratch names since) names-start))
    (blank)
    (let empty U32 (. ArgumentFill fill-empty))
    (let fills-start (. scratch words mark))
    (for (in _ (..< 0 count))
      (call (. scratch words push) empty)
    )
    (blank)
    (let next 0)
    (let index 0u32)
    (for (in call calls)
      (if (and (not (. call is-skipped)) (not (. call is-property)))
        (let target (. Size max))
        (if (. call name)
          (let call-name (. call name))
          (for (in offset (..< 0 count))
            (if (== ([] names offset) call-name)
              (= target offset)
            )
          )
          (else
            (while (and (< next count) (!= ([] (. scratch words) (+ fills-start next)) empty))
              (+= next 1)
            )
            (= target next)
          )
        )
        (if (or (>= target count) (!= ([] (. scratch words) (+ fills-start target)) empty))
          (return null)
        )
        (= ([] (. scratch words) (+ fills-start target)) index)
      )
      (+= index 1)
    )
    (let fills (call (. scratch words since) fills-start))
    (blank)
    (let compared expected)
    (if generic
      (if (not (call infer-fields scope fills expected class-args type-args module decl))
        (return null)
      )
      (let compared-start (. scratch types mark))
      (for (in field expected)
        (call (. scratch types push) (call substitute field scope))
      )
      (= compared (call (. scratch types since) compared-start))
    )
    (let tails (call TailMatch (. scratch no-fills) (. scratch no-relations)))
    (let relations-start (. scratch relations mark))
    (let args-start (. scratch types mark))
    (if (not (call rank-slots scope generic fills compared expected (. scratch no-fills) (. scratch no-fills) (. U32 max) tails (. scratch no-fills)))
      (return null)
    )
    (let args (call (. scratch types since) args-start))
    (let slot-relations (call (. scratch relations since) relations-start))
    (blank)
    (let params-start (. scratch types mark))
    (let constructed receiver)
    (if (not generic)
      (for (in position (..< 0 (. class-args count)))
        (call (. scratch types push) (call (. types child-type) class-args position))
      )
    )
    (let params (call (. scratch types since) params-start))
    (blank)
    (if generic
      (let env (call (. types env-frame)))
      (for (in position (..< 0 (. class-args count)))
        (let name (call (. types class-param-name) tree type-args position))
        (if (not name)
          (call (. types env-release) env)
          (return null)
        )
        (let evaluated (call (. relations scope-evaluate) scope name env null))
        (if (not evaluated)
          (call (. types env-release) env)
          (return null)
        )
        (call (. scratch types push) evaluated)
      )
      (call (. types env-release) env)
      (= params (call (. scratch types since) params-start))
      (let mark (. scratch types mark))
      (for (in type params)
        (call (. scratch types push) type)
      )
      (= constructed (call (. types class-with-args) module owner mark))
      (= args (call bound-fields constructed fills args))
    )
    (blank)
    (return
      (call Hit
        (block
          (arg module)
          (arg decl)
          (arg constructed)
          (arg params)
          (arg args)
          (arg fills)
          (arg slot-relations)
          (arg (. tails fills))
          (arg (. tails relations))
          (arg false)
        )
      )
    )
  )
  (fn-do _ infer-fields Bool
    (param scope MatchScope)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param fields (of ImmutableArray TypeId ArenaBacking))
    (param class-args (of RowRange TypeId))
    (param type-args (of RowRange SyntaxId))
    (param module ModuleId)
    (param decl DeclId)
    ; Binds a generic tuple's type parameters from the values given its fields, as a function's are
    ; bound from its arguments.
    (let tree (. ([] (. program modules) module) tree))
    (let names-start (. scratch names mark))
    (let variables-start (. scratch types mark))
    (for (in position (..< 0 (. class-args count)))
      (let name (call (. types class-param-name) tree type-args position))
      (if name
        (call (. scratch names push) name)
        (call (. scratch types push) (call (. types child-type) class-args position))
      )
    )
    (let variables (call (. scratch types since) variables-start))
    (let fielded
      (call Signature
        (block
          (arg (call (. scratch names since) names-start))
          (arg variables)
          (arg fields)
          (arg no-type)
          (arg (. scratch no-types))
        )
      )
    )
    (let env (call (. types env-frame)))
    (let bound (call infer-params scope env fills fielded module decl))
    (call (. types env-release) env)
    (return bound)
  )
  (fn-do _ bound-fields (of ImmutableArray TypeId ArenaBacking)
    (param constructed TypeId)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param args (of ImmutableArray TypeId ArenaBacking))
    ; What a generic tuple's fields take once its parameters are bound, as a function's arguments
    ; are rebound: each argument given plainly takes its field's type, and converts to it.
    (call (. types complete) constructed)
    (let empty U32 (. ArgumentFill fill-empty))
    (let start (. scratch types mark))
    (let position 0u32)
    (for (in fact ([] (. types properties) (. ([] (. types completions) constructed) properties)))
      (if (== (. fact slot) (. U32 max))
        (continue)
      )
      (if (>= position (. args length))
        (break)
      )
      (let recorded ([] args position))
      (let field (call field-type fact constructed))
      (let fill ([] fills position))
      (let settled (and (!= field invalid-type) (not (. ([] (. types completions) field) has-variables))))
      (if (== fill empty)
        (if settled
          (= recorded field)
        )
        (else-if (and settled (!= (call (. types intrinsic-of) field) .or) (not (call (. relations holds-alternatives) field)))
          (let shape ([] calls fill))
          (if (and (not (. shape symbol)) (!= (. ([] (. types completions) recorded) intrinsic) .closure))
            (= recorded field)
          )
        )
      )
      (call (. scratch types push) recorded)
      (+= position 1)
    )
    (if (!= position (. args length))
      (call (. scratch types rewind) start)
      (return args)
    )
    (return (call (. scratch types since) start))
  )
  (fn-do + rank-function (? Hit)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param bindings TypeArguments)
    (let items-start (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let words-start (. scratch words mark))
    (let relations-start (. scratch relations mark))
    (let scope (call (. relations scope-open)))
    (let env (call (. types env-frame)))
    (let hit (call rank-declaration scope env module decl receiver bindings))
    (call (. types env-release) env)
    (call (. relations scope-release) scope)
    (if (not hit)
      (call (. scratch types rewind) items-start)
      (call (. scratch names rewind) names-mark)
      (call (. scratch words rewind) words-start)
      (call (. scratch relations rewind) relations-start)
    )
    (return hit)
  )
  (fn-do _ note-missing-type _
    (param target Module)
    (param module ModuleId)
    (param decl DeclId)
    (param bindings TypeArguments)
    (param receiver TypeId)
    ; Notes the first type the parameters of a function a call may take write that names nothing,
    ; where TypeScript stops the call with "Type not found" as it reads them (`missing-site`). The
    ; types are read as the function's signature reads them, with its class's and its own.
    (let function (call function-env types module decl bindings receiver true))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (for (in shape ([] (. target arg-pool) (. fn args)))
          (if (!= (. shape type-syntax) 0)
            (let found (call (. types missing-type) module (. target tree) (. shape type-syntax) (. function env)))
            (if (!= found 0)
              (= missing-module module)
              (= missing-site found)
              (break)
            )
          )
        )
      )
    )
    (call (. types env-release) (. function env))
  )
  (fn-do _ rank-declaration (? Hit)
    (param opened MatchScope)
    (param env TypeEnv)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param bindings TypeArguments)
    (let target ([] (. program modules) module))
    (let variadic-index (. U32 max))
    (let constraints (call (of RowRange SyntaxId)))
    (let assignments (call (of RowRange SyntaxId)))
    (let specs-start (. scratch words mark))
    (let owner 0u32)
    (let declarer 0u32)
    (let own-params (call (of RowRange SyntaxId)))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (= variadic-index (. fn variadic-index))
        (= constraints (. fn param-constraints))
        (= assignments (. fn param-assignments))
        (= declarer (. fn owner))
        (= own-params (. fn type-args))
        (if (call is-constructor-kind (. fn kind))
          (= owner (. fn owner))
        )
        (for (in shape ([] (. target arg-pool) (. fn args)))
          (call (. scratch words push) (. shape specificity))
        )
      )
    )
    (let specs (call (. scratch words since) specs-start))
    (let extended false)
    (if (and (!= declarer 0) (== owner 0))
      (match? ([] (. target decls) declarer)
        (case .decl-extension
          (= extended true)
        )
      )
    )
    (let untyped-start (. scratch words mark))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (for (in shape ([] (. target arg-pool) (. fn args)))
          (let written (call written-argument-type types module (. target tree) owner shape))
          (call (. scratch words push) (if-expr (== written 0) 1 0))
        )
      )
    )
    (let untyped (call (. scratch words since) untyped-start))
    (let defaults-start (. scratch words mark))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (for (in shape ([] (. target arg-pool) (. fn args)))
          (call (. scratch words push) (if-expr (. shape has-default) 1 0))
        )
      )
    )
    (let defaults (call (. scratch words since) defaults-start))
    (blank)
    (let viability (call viable target decl calls slots))
    (= is-partial (or (== (. viability kind) .partially-viable) (and bound-call (< (. calls length) (. specs length)))))
    (if (== (. viability kind) .not-viable)
      (return null)
    )
    (blank)
    (let fills-start (. scratch words mark))
    (for (in fill slots)
      (call (. scratch words push) fill)
    )
    (let fills (call (. scratch words since) fills-start))
    (blank)
    (let signature (call signature-into types module decl bindings receiver true))
    (call note-symbol-owners fills (. signature args))
    (if (and (not is-partial) (== missing-site 0) (== (. own-params count) 0))
      (for (in arg (. signature args))
        (if (== arg invalid-type)
          (call note-missing-type target module decl bindings receiver)
          (break)
        )
      )
    )
    (let implicit (as (call implicit-argument-count types module decl) Size))
    (if (or (> (+ (. explicit length) implicit) (. signature params length)) own-overflow)
      (return null)
    )
    (lazy own-overflow (and extended (> (. explicit length) (. own-params count))))
    (blank)
    (let scope opened)
    (let all-explicit true)
    (for (in offset (..< 0 (. signature params length)))
      (let variable ([] (. signature variables) offset))
      (if (== variable invalid-type)
        (return null)
      )
      (let name ([] (. signature params) offset))
      (let is-explicit (not (call is-variable-row types variable)))
      (let given variable)
      (let written (call explicit-place (. target tree) own-params extended offset name))
      (if (< written (. explicit length))
        (= is-explicit true)
        (= given ([] explicit written))
      )
      (let declared (call (. relations scope-declare) scope name is-explicit given))
      (if (not declared)
        (return null)
      )
      (= scope declared)
      (if (not is-explicit)
        (= all-explicit false)
      )
    )
    (blank)
    (call declare-assignments scope module owner assignments)
    (if (not (call infer-params scope env fills signature module decl))
      (return null)
    )
    (= tail-default no-type)
    (call bind-defaults scope env module decl receiver fills signature)
    (blank)
    (let tails (call TailMatch (. scratch no-fills) (. scratch no-relations)))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (for (in position (..< 0 (. fills length)))
      (if (== ([] fills position) variadic)
        (let declared ([] (. signature args) position))
        (let item (call list-item declared))
        (let settled all-explicit)
        (let listed RelationRank -1)
        (if (call is-unbound scope env signature declared)
          (= settled false)
          (= item (call tail-item fills variadic-index))
          (if (or (== item no-type) (== item invalid-type))
            (return null)
          )
          (call legal-in-scope (call list-type-of item) declared scope)
          (else-if (not settled)
            (let joined (call tail-item fills variadic-index))
            (if (and (!= joined no-type) (!= joined invalid-type))
              (let whole (call compare-argument (call list-type-of joined) (call substitute declared scope) scope))
              (if (call relation-legal whole)
                (= listed (. whole rank))
              )
            )
          )
        )
        (if (== item invalid-type)
          (return null)
        )
        (let tail-fills (. scratch words mark))
        (let tail-relations (. scratch relations mark))
        (if (== (call rank-tail scope fills variadic-index item) (. Size max))
          (return null)
        )
        (= tails
          (call TailMatch
            (block
              (arg (call (. scratch words since) tail-fills))
              (arg (call (. scratch relations since) tail-relations))
              (arg settled)
              (arg listed)
            )
          )
        )
      )
    )
    (blank)
    (let relations-start (. scratch relations mark))
    (let generic (!= (. signature params length) 0))
    (let compared
      (block
        (case? generic
          (call inferred-args scope module decl receiver signature)
        )
        (default
          (. signature args)
        )
      )
    )
    (let args-start (. scratch types mark))
    (if (not (call rank-slots scope generic fills compared (. signature args) specs untyped variadic-index tails defaults))
      (return null)
    )
    (let args (call (. scratch types since) args-start))
    (let slot-relations (call (. scratch relations since) relations-start))
    (blank)
    (let params-start (. scratch types mark))
    (for (in offset (..< 0 (. signature params length)))
      (let name ([] (. signature params) offset))
      (let evaluated (call (. relations scope-evaluate) scope name env null))
      (if (not evaluated)
        (return null)
      )
      (let chosen evaluated)
      (if (and (!= owner 0) (call is-variable-row types chosen))
        (let fallback (call class-default scope env module owner name))
        (if fallback
          (= chosen fallback)
        )
      )
      (if (not (call constraints-hold scope module declarer (. target tree) constraints name chosen receiver))
        (return null)
      )
      (call (. scratch types push) chosen)
    )
    (let params (call (. scratch types since) params-start))
    (blank)
    (if (not (call (. relations scope-resolved) scope))
      (= is-partial true)
      (else-if generic
        (let arguments (call TypeArguments (. signature params) params))
        (let bound (call signature-into types module decl arguments receiver true))
        (if (== (. bound args length) (. args length))
          (let rebound-relations (. scratch relations mark))
          (let rebound-args (. scratch types mark))
          (for (in position (..< 0 (. fills length)))
            (let fill ([] fills position))
            (let expected ([] (. bound args) position))
            (let relation ([] slot-relations position))
            (let recorded ([] args position))
            (if (or (== fill (. ArgumentFill fill-empty)) (== fill variadic))
              (if (not (. ([] (. types completions) expected) has-variables))
                (= recorded expected)
              )
              (else-if (and (!= (call (. types intrinsic-of) expected) .or) (not (call (. relations holds-alternatives) expected)))
                (let shape ([] calls fill))
                (let plain (and (not (. shape symbol)) (!= (. ([] (. types completions) recorded) intrinsic) .closure)))
                (if (and plain (not (. ([] (. types completions) expected) has-variables)))
                  (= recorded expected)
                )
              )
            )
            (call (. scratch relations push) relation)
            (call (. scratch types push) recorded)
          )
          (= args (call (. scratch types since) rebound-args))
          (= slot-relations (call (. scratch relations since) rebound-relations))
        )
      )
    )
    (blank)
    (let constructed (call constructed-receiver module decl receiver (. signature params) params))
    (return
      (call Hit
        (block
          (arg module)
          (arg decl)
          (arg constructed)
          (arg params)
          (arg args)
          (arg fills)
          (arg slot-relations)
          (arg (. tails fills))
          (arg (. tails relations))
          (arg extension-ranking)
          (arg (if-expr extension-ranking extension-level no-type))
        )
      )
    )
  )
  (fn-do _ inferred-args (of ImmutableArray TypeId ArenaBacking)
    (param scope MatchScope)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param signature Signature)
    ; What a generic candidate's arguments are under what the call's arguments have bound of its
    ; type parameters, as the reference evaluates each argument's type in the scope it inferred
    ; before it compares the argument to it. A parameter nothing has bound stays a variable.
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature params length)))
      (let held (call (. relations scope-lookup) scope ([] (. signature params) offset)))
      (call (. scratch types push) (?? held ([] (. signature variables) offset)))
    )
    (let arguments (call TypeArguments (. signature params) (call (. scratch types since) mark)))
    (return (. (call signature-into types module decl arguments receiver true) args))
  )
  (fn-do _ constructed-receiver TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param names (of ImmutableArray Atom ArenaBacking))
    (param params (of ImmutableArray TypeId ArenaBacking))
    (if (or (== receiver no-type) (not (. ([] (. types completions) receiver) has-variables)))
      (return receiver)
    )
    (let target ([] (. program modules) module))
    (let owner 0u32)
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (if (call is-constructor-kind (. fn kind))
          (= owner (. fn owner))
        )
      )
    )
    (if (== owner 0)
      (return receiver)
    )
    (match? ([] (. target decls) owner)
      (case (call .decl-extension row)
        (let env (call extension-env types module owner))
        (for (in offset (..< 0 (. names length)))
          (= env (call (. types env-bind) env ([] names offset) ([] params offset)))
        )
        (let extended (call (. types evaluate-type) module (. target tree) (. row receiver) env))
        (call (. types env-release) env)
        (return extended)
      )
    )
    (let count (. (call (. types class-type-args) module owner) count))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 count))
      (call (. scratch types push) ([] params offset))
    )
    (return (call (. types class-with-args) module owner mark))
  )
  (fn-do _ class-default (? TypeId)
    (param scope MatchScope)
    (param env TypeEnv)
    (param module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (let bound (call (. relations scope-env) scope env))
    (let fallback (call (. types class-param-default) module owner name bound))
    (call (. types env-truncate) env)
    (if (not fallback)
      (return null)
    )
    (if (not (call (. relations scope-declare) scope name false fallback))
      (return null)
    )
    (return fallback)
  )
  (fn-do _ declare-assignments _
    (param scope MatchScope)
    (param module ModuleId)
    (param owner DeclId)
    (param assignments (of RowRange SyntaxId))
    (let tree (. ([] (. program modules) module) tree))
    (for (in id ([] (. tree children) assignments))
      (match? ([] (. tree nodes) id)
        (case (call .node-param-assignment row)
          (let left (call (. types type-syntax-name) tree (. row left)))
          (if left
            (let flag (. row is-specificity))
            (let selects (call owner-param module owner left))
            (call (. relations scope-set-assignment) scope left module (. row right) flag selects)
          )
        )
      )
    )
  )
  (fn-do _ owner-param Bool
    (param module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (if (== owner 0)
      (return false)
    )
    (let tree (. ([] (. program modules) module) tree))
    (let type-args (call (. types class-type-args) module owner))
    (for (in position (..< 0 (. type-args count)))
      (let param (call (. types class-param-name) tree type-args position))
      (if (and param (== param name))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ infer-params Bool
    (param scope MatchScope)
    (param env TypeEnv)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param signature Signature)
    (param module ModuleId)
    (param decl DeclId)
    ; Binds a candidate's type parameters from the arguments that fill parameters naming them, one
    ; parameter at a time. An argument of a function type given a parameter that names one is
    ; compared once every parameter is evaluated, and a closure or a binding last of those, since
    ; what it is given depends on the others, wherever it is written among the arguments. A number
    ; written with no suffix binds a parameter only after the other arguments, an integer after a
    ; float, and one given for a parameter that is the type they bound holds it as that type. A tuple
    ; written with such integers among its items binds by its other items where those bind a type
    ; that holds the integers.
    (let empty U32 (. ArgumentFill fill-empty))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (for (in position (..< 0 (. fills length)))
      (let fill ([] fills position))
      (if (and (!= fill empty) (!= fill variadic) (< position (. signature args length)))
        (let expected ([] (. signature args) position))
        (for (in name (. signature params))
          (if (call mentions-variable expected name)
            (call (. relations scope-link) scope name (as position U32))
          )
        )
      )
    )
    (let delayed-start (. scratch words mark))
    (for (in name (. signature params))
      (let links (call (. relations scope-links) scope name))
      (for (in pass (..< 0u32 3))
        (for (in linked (..< 0 (. fills length)))
          (if (and (!= (/and/ links (/lshift/ 1u64 (as linked U64))) 0) in-pass)
            (let given (call inferred-given fills linked module decl))
            (let expected ([] (. signature args) linked))
            (if (call should-delay-compare types given expected)
              (call (. scratch words push) (as linked U32))
              (else-if (and (not fill-holds) (not places-hold) (not (call legal-in-scope given expected scope)))
                (return false)
              )
            )
            (lazy fill-holds (call holds-literal-fill fills linked expected name scope))
            (lazy places-hold (call holds-literal-places fills linked given expected scope))
          )
          (lazy in-pass (== (call literal-pass fills linked) pass))
        )
      )
      (call (. relations scope-clear-links) scope name)
      (if (not (call (. relations scope-defers) scope name))
        (if (not (call (. relations scope-evaluate) scope name env null))
          (return false)
        )
      )
    )
    (for (in name (. signature params))
      (if (call (. relations scope-has-assignment) scope name)
        (if (not (call (. relations scope-evaluate) scope name env null))
          (return false)
        )
      )
    )
    (let fitted (list Size))
    (for (in delayed (call (. scratch words since) delayed-start))
      (let linked Size delayed)
      (let given (call inferred-given fills linked module decl))
      (let expected ([] (. signature args) linked))
      (if (call is-callable-value scope given expected)
        (+= fitted linked)
        (else-if (not (call legal-in-scope given expected scope))
          (return false)
        )
      )
    )
    (call (. scratch words rewind) delayed-start)
    (for (in linked fitted)
      (if (not (call closure-fits (call inferred-given fills linked module decl) ([] (. signature args) linked) scope))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ literal-fill SyntaxId
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    ; The integer written with no suffix that fills a parameter, or none.
    (case? (or (== fill empty) (== fill variadic))
      0
    )
    (default
      (. ([] calls fill) literal)
    )
    (where
      (lazy fill ([] fills position))
      (lazy empty U32 (. ArgumentFill fill-empty))
      (lazy variadic U32 (. ArgumentFill fill-variadic))
    )
  )
  (fn-expr _ literal-pass U32
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    ; When an argument binds the parameters it fills: first where it is no number written with no
    ; suffix, then where it is one but no integer, and last where it is an integer.
    (case? (== literal 0)
      0
    )
    (case? (and (!= conversions null) (call (. conversions is-plain-integer) literal))
      2
    )
    (default
      1
    )
    (where
      (lazy literal (call literal-fill fills position))
    )
  )
  (fn-expr _ holds-literal-fill Bool
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    (param expected TypeId)
    (param name Atom)
    (param scope MatchScope)
    ; Whether an integer written with no suffix fills a parameter that is a type parameter the
    ; other arguments bound to a type that holds it.
    (case? (or (== literal 0) (== conversions null) (!= (call variable-of expected) name))
      false
    )
    (default
      (and (!= bound null) (not (call is-variable-row types bound)) (call (. (!! conversions) fitting-literal) literal bound))
    )
    (where
      (lazy literal (call literal-fill fills position))
      (lazy bound (call (. relations scope-lookup) scope name))
    )
  )
  (fn-expr _ holds-literal-places Bool
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    (param given TypeId)
    (param expected TypeId)
    (param scope MatchScope)
    ; Whether a tuple written with integers with no suffix among its items fills a parameter whose
    ; type parameters its other items bind to types that hold those integers.
    (case? (or (== loose no-type) (not (call legal-in-scope loose expected scope)))
      false
    )
    (default
      (call (. (!! conversions) fitting-literal) (call literal-fill fills position) (call substitute expected scope))
    )
    (where
      (lazy loose (call loose-places fills position given expected))
    )
  )
  (fn-do _ loose-places TypeId
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    (param given TypeId)
    (param expected TypeId)
    ; The tuple a tuple written with integers with no suffix among its items binds type parameters
    ; by: each such item's place has the type expected there, so only the other items bind them.
    (let literal (call literal-fill fills position))
    (return-if no-type (if (or (== literal 0) (== conversions null))))
    (blank)
    (let fields (call (of RowRange TypeId)))
    (let names (call (of RowRange Atom)))
    (match? ([] (. types rows) given)
      (case (call .type-tuple row)
        (= fields (. row fields))
        (= names (. row names))
      )
    )
    (return-if no-type (if (== (. fields count) 0)))
    (blank)
    (call (. types complete) expected)
    (let wanted-mark (. types scratch types mark))
    (call push-fields types expected)
    (if (!= (- (. types scratch types length) wanted-mark) (. fields count))
      (call (. types scratch types rewind) wanted-mark)
      (return no-type)
    )
    (let mark (. types scratch types mark))
    (let names-mark (. types scratch names mark))
    (let loosened false)
    (for (in offset (..< 0 (. fields count)))
      (let plain (call (. (!! conversions) plain-item) literal offset))
      (= loosened (or loosened plain))
      (call (. types scratch types push) (if-expr plain wanted-field (call (. types child-type) fields offset))
        (block
          (lazy wanted-field ([] (. types scratch types) (+ wanted-mark offset)))
        )
      )
      (call (. types scratch names push) (call (. types child-name) names offset))
    )
    (let loose (if-expr loosened (call (. types intern-tuple) mark names-mark) no-type))
    (call (. types scratch types rewind) wanted-mark)
    (call (. types scratch names rewind) names-mark)
    (return loose)
  )
  (fn-expr _ variable-of (? Atom)
    (param type TypeId)
    (match? ([] (. types rows) type)
      (case (call .type-variable row)
        (. row name)
      )
    )
  )
  (fn-do _ inferred-given TypeId
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    (param module ModuleId)
    (param decl DeclId)
    ; What an argument a call gives binds type parameters as: its own type, or, for a case named
    ; by its symbol alone, the type whose case the default of an untyped parameter names by its
    ; symbol, as the reference reads the symbol against the default, or else the type the
    ; argument is ranked as a case of.
    (let fill ([] fills position))
    (if (not (. ([] calls fill) symbol))
      (return ([] args fill))
    )
    (let target ([] (. program modules) module))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (if (< position (. fn args count))
          (let start Index (. fn args start))
          (let shape ([] (. target arg-pool) (+ start position)))
          (if (and (== (. shape type-syntax) 0) (!= (. shape default-syntax) 0))
            (match? ([] (. target tree nodes) (. shape default-syntax))
              (case (call .node-symbol row)
                (let named (call symbol-class types module (. row name)))
                (if (!= named invalid-type)
                  (return named)
                )
              )
            )
          )
        )
      )
    )
    (let owner (call symbol-owner fill))
    (return (if-expr (!= owner no-type) owner ([] args fill)))
  )
  (fn-do _ bind-defaults _
    (param scope MatchScope)
    (param env TypeEnv)
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param signature Signature)
    ; An argument that declares no type and is not given takes the type of its default, typed
    ; under the type parameters the call has bound. A variadic tail that declares no type, given
    ; no argument, takes the type of its default, which `tail-default` keeps, and binds the type
    ; parameter its name declares to it.
    (if (not host)
      (return)
    )
    (let empty U32 (. ArgumentFill fill-empty))
    (let target ([] (. program modules) module))
    (match? ([] (. target decls) decl)
      (case (call .decl-function fn)
        (let position 0)
        (for (in shape ([] (. target arg-pool) (. fn args)))
          (let open (and (< position (. fills length)) (< position (. signature args length))))
          (if (and open (== ([] fills position) empty) (!= (. shape default-syntax) 0))
            (let expected ([] (. signature args) position))
            (let tail (== (as position U32) (. fn variadic-index)))
            (let anonymous
              (scope (and untyped-tail (. ([] (. types completions) expected) has-variables))
                (lazy untyped-tail (and tail (== (. shape type-syntax) 0)))
              )
            )
            (if (or anonymous (call is-unbound scope env signature checked-type))
              (let mark (. scratch types mark))
              (for (in param (. signature params))
                (let current (call (. relations scope-evaluate) scope param env null))
                (call (. scratch types push) (?? current invalid-type))
              )
              (let bound (call (. scratch types since) mark))
              (let syntax (. shape default-syntax))
              (= consulted true)
              (let given (call (. (!! host) default-type) module decl receiver syntax bound))
              (call (. scratch types rewind) mark)
              (if (and (!= given no-type) (!= given invalid-type) anonymous)
                (= tail-default given)
                (if (call is-unbound scope env signature expected)
                  (call legal-in-scope given expected scope)
                )
                (else-if (and (!= given no-type) (!= given invalid-type))
                  (call legal-in-scope given expected scope)
                )
              )
            )
            (lazy checked-type (if-expr tail (call list-item expected) expected))
          )
          (+= position 1)
        )
      )
    )
  )
  (fn-do _ is-unbound Bool
    (param scope MatchScope)
    (param env TypeEnv)
    (param signature Signature)
    (param expected TypeId)
    ; Whether an argument's type is a type parameter the call has not bound yet.
    (if (not (call is-variable-row types expected))
      (return false)
    )
    (for (in offset (..< 0 (. signature params length)))
      (if (== ([] (. signature variables) offset) expected)
        (let current (call (. relations scope-evaluate) scope ([] (. signature params) offset) env null))
        (return (and (!= current null) (call is-variable-row types current)))
      )
    )
    (return false)
  )
  (fn-expr _ argument-at TypeId
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param position Size)
    ([] args ([] fills position))
  )
  (fn-do + fit-callable (? TypeId)
    (param given TypeId)
    (param expected TypeId)
    (param scope (? MatchScope))
    ; Fits a closure or a binding to a function type, as `as` asks where the relations are asking,
    ; which the closure's own body is typed without.
    (let asked (. relations asking))
    (= (. relations asking) false)
    (let fit (call closure-fits given expected scope asked))
    (= (. relations asking) asked)
    (return (only-if (. fit to) (if fit)))
  )
  (fn-do _ closure-fits (? Relation)
    (param given TypeId)
    (param expected TypeId)
    (param scope (? MatchScope))
    (param asked Bool (= false))
    ; A closure or a binding fits a function type where it takes each argument the type gives and
    ; gives what the type returns, each converted unasked as a call converts them, unless asked. A
    ; filter's condition gives its truth.
    (blank)
    (call (. types complete) expected)
    (let fn (call function-row types expected))
    (if (== fn no-type)
      (return null)
    )
    (let args (call (of RowRange TypeId)))
    (let returns no-type)
    (let errors (call (of RowRange TypeId)))
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= args (. row args))
        (= returns (. row return-type))
        (= errors (. row errors))
      )
    )
    (let args-start (. scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (let open (call (. types child-type) args offset))
      (let arg (call substitute open scope))
      (let unbound (. ([] (. types completions) arg) has-variables))
      (if (or unbound (== (. ([] (. types completions) given) intrinsic) .closure))
        (let declared (call declared-argument types given offset))
        (if (!= declared no-type)
          (if unbound
            (call legal-in-scope declared arg scope)
            (else-if (and (not asked) (not (call (. relations implicit) (call (. relations compare) arg declared false false null caller))))
              (call (. scratch types rewind) args-start)
              (return null)
            )
          )
          (= arg declared)
        )
      )
      (if (. ([] (. types completions) arg) has-variables)
        (call (. scratch types rewind) args-start)
        (return null)
      )
      (call (. scratch types push) arg)
    )
    (if (not host)
      (call (. scratch types rewind) args-start)
      (return null)
    )
    (= consulted true)
    (let returned invalid-type)
    (let bound no-instance)
    (if (== (. ([] (. types completions) given) intrinsic) .binding)
      (let answered (call (. host binding-return) given (call (. scratch types since) args-start)))
      (= returned (. answered type))
      (= bound (. answered callee))
      (else
        (= returned (call (. host lambda-fit) given (call (. scratch types since) args-start)))
      )
    )
    (if (== returned invalid-type)
      (call (. scratch types rewind) args-start)
      (return null)
    )
    (let taken (call (. scratch types since) args-start))
    (if (and (!= returns no-type) (!= returns (. types void-type)) (call is-unbound-return returns scope))
      (= returned (call (. (!! host) whole-answer) given returned taken errors bound))
    )
    (if (and (!= returns no-type) (!= returns (. types void-type)) (not (call is-inference-row returns)))
      (let wanted (call substitute returns scope))
      (let open (. ([] (. types completions) wanted) has-variables))
      (let binds (only-if scope (if open)))
      (let relation
        (call (. relations compare)
          (block
            (arg returned)
            (arg (if-expr open returns wanted))
            (arg false)
            (arg false)
            (arg binds)
            (arg caller)
          )
        )
      )
      (let truth (and (== wanted (. types bool-type)) (call is-filter-condition types program given)))
      (if (or (not (call relation-legal relation)) (and (not asked) (not truth) (not (call (. relations implicit) relation))))
        (call (. scratch types rewind) args-start)
        (return null)
      )
    )
    (let settled (call settle-callable (call substitute expected scope) returns returned args taken))
    (call (. scratch types rewind) args-start)
    (return (call side-cast-relation given settled))
  )
  (fn-expr _ is-unbound-return Bool
    (param returns TypeId)
    (param scope (? MatchScope))
    ; Whether what a function type returns is a parameter nothing has bound: one of the type
    ; left out where the type is named, or one of the call's still open. Such a parameter takes
    ; the whole of what a callable answers, its errors too.
    (or (call is-inference-row returns) (and variable-return (call is-variable-row types (call substitute returns scope))))
    (where
      (lazy variable-return (call is-variable-row types returns))
    )
  )
  (fn-do _ settle-callable TypeId
    (param target TypeId)
    (param returns TypeId)
    (param returned TypeId)
    (param args (of RowRange TypeId))
    (param taken (of ImmutableArray TypeId ArenaBacking))
    ; A function type named without all of its parameters takes the open ones from the callable
    ; it is given: what the callable returns, and the argument types it was typed with.
    (if (not (. ([] (. types completions) target) has-variables))
      (return target)
    )
    (match? ([] (. types rows) target)
      (case (call .type-class row)
        (let mark (. scratch types mark))
        (for (in position (..< 0 (. row args count)))
          (let arg (call (. types child-type) (. row args) position))
          (let bound arg)
          (if (and (call is-inference-row arg) (== arg returns))
            (= bound returned)
            (else-if (call is-inference-row arg)
              (for (in offset (..< 0 (. args count)))
                (if (== (call (. types child-type) args offset) arg)
                  (= bound ([] taken offset))
                )
              )
            )
          )
          (call (. scratch types push) bound)
        )
        (return (call (. types intern-class) (. row module) (. row decl) mark))
      )
    )
    (return target)
  )
  (fn-do _ is-callable-value Bool
    (param scope MatchScope)
    (param given TypeId)
    (param expected TypeId)
    ; A closure or binding fits a parameter of a function type by what it returns for that
    ; type's arguments. A parameter of any other type takes it as the value it is.
    (if (>= given (. types completions length))
      (return false)
    )
    (let kind (. ([] (. types completions) given) intrinsic))
    (if (and (!= kind .closure) (!= kind .binding))
      (return false)
    )
    (let target (call substitute expected scope))
    (call (. types complete) target)
    (return (!= (call function-row types target) no-type))
  )
  (fn-expr _ is-inference-row Bool
    (param id TypeId)
    (match ([] (. types rows) id)
      (case .type-inference
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ substitute TypeId
    (param id TypeId)
    (param scope (? MatchScope))
    (if (or (not scope) (not (. ([] (. types completions) id) has-variables)))
      (return id)
    )
    (return
      (match ([] (. types rows) id)
        (case (call .type-variable row)
          (?? (call (. relations scope-lookup) scope (. row name)) id)
        )
        (case (call .type-class row)
          (call substitute-class (. row module) (. row decl) (. row args) scope)
        )
        (default
          id
        )
      )
    )
  )
  (fn-do _ substitute-class TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param args (of RowRange TypeId))
    (param scope (? MatchScope))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (let arg (call substitute (call (. types child-type) args offset) scope))
      (call (. scratch types push) arg)
    )
    (return (call (. types intern-class) module decl mark))
  )
  (fn-expr _ legal-in-scope Bool
    (param given TypeId)
    (param expected TypeId)
    (param scope (? MatchScope))
    (call relation-legal (call compare-argument given expected scope))
  )
  (fn-do _ compare-argument Relation
    (param given TypeId)
    (param expected TypeId)
    (param scope (? MatchScope))
    (param requested Bool (= false))
    ; Relates an argument to what a candidate expects with this ranking fitting the closures the
    ; argument holds, such as a field of a tuple. A conversion `requested` holds whether or not it
    ; would be made unasked: one a `~` parameter takes, or one of an optional given only where it is
    ; present, whose value is related on its own. A C function takes whatever a cast would convert
    ; to its parameter, as C does, except a number, a `Bool` or a `Char` for a pointer, which it takes
    ; only when asked.
    (let previous (. relations callables))
    (= (. relations callables) this)
    (let relation (call (. relations compare) given expected false false scope caller))
    (let c-loose (and c-only (not (call addresses-number given expected))))
    (let held (if-expr (or c-loose asked requested) relation (call (. relations implicitly) relation texts)))
    (= (. relations callables) previous)
    (return held)
  )
  (fn-expr _ addresses-number Bool
    (param given TypeId)
    (param expected TypeId)
    (and (== (. (call (. types completion-of) expected) intrinsic) .cpointer) (!= from .cpointer) numeric-from)
    (where
      (lazy from (. (call (. types completion-of) given) intrinsic))
      (lazy numeric-from (call intrinsic-is-numeric from))
    )
  )
  (fn-do _ explicit-place Size
    (param tree AST)
    (param own-params (of RowRange SyntaxId))
    (param extended Bool)
    (param offset Size)
    (param name Atom)
    ; Which of the parameters written at a call a parameter of the callee takes. They are the
    ; callee's in order, except that a method of an extension is written only its own, after
    ; which the extension's are inferred from the receiver.
    (if (not extended)
      (return offset)
    )
    (let position 0u32)
    (for (in child ([] (. tree children) own-params))
      (let own (call (. types type-syntax-name) tree child))
      (if (and own (== own name))
        (return position)
      )
      (+= position 1)
    )
    (return (. Size max))
  )
  (fn-do _ constraints-hold Bool
    (param scope MatchScope)
    (param module ModuleId)
    (param declarer DeclId)
    (param tree AST)
    (param constraints (of RowRange SyntaxId))
    (param name Atom)
    (param evaluated TypeId)
    (param receiver TypeId)
    ; Whether the type chosen for a type parameter meets what the function requires of it. A
    ; requirement is read where the function is declared: the parameters of its class or
    ; extension are those of the receiver, `This` is the receiver, and the function's own are
    ; those of the match.
    (for (in id ([] (. tree children) constraints))
      (match? ([] (. tree nodes) id)
        (case (call .node-param-constraint row)
          (let left (call (. types type-syntax-name) tree (. row left)))
          (if (and left (== left name))
            (let frame (call owner-env types module declarer))
            (let owned frame)
            (if (and (!= declarer 0) (!= receiver no-type))
              (let extended (call extended-class-env types module declarer receiver frame))
              (= owned (call bind-receiver types module declarer receiver extended))
            )
            (let scoped (call (. types env-with-this) (call (. relations scope-env) scope owned) receiver))
            (let right (call (. types evaluate-type) module tree (. row right) scoped))
            (call (. types env-release) frame)
            (if (not (call meets-constraint scope evaluated right (call required-match (. row op))))
              (return false)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ meets-constraint Bool
    (param scope MatchScope)
    (param evaluated TypeId)
    (param right TypeId)
    (param required Specificity)
    (return (call (. relations holds-as) relation required true))
    (blank)
    (lazy relation (call (. relations compare) evaluated right false false scope caller))
  )
  (fn-expr _ mentions-variable Bool
    (param id TypeId)
    (param name Atom)
    (case? (not (. ([] (. types completions) id) has-variables))
      false
    )
    (default
      (match ([] (. types rows) id)
        (case (call .type-variable row)
          (== (. row name) name)
        )
        (case (call .type-class row)
          (call range-mentions (. row args) name)
        )
        (case (call .type-tuple row)
          (call range-mentions (. row fields) name)
        )
        (case (call .type-struct row)
          (call range-mentions (. row fields) name)
        )
        (case (call .type-union row)
          (call range-mentions (. row cases) name)
        )
        (case (call .type-named-union row)
          (call range-mentions (. row cases) name)
        )
        (case (call .type-function row)
          (call function-mentions (. row return-type) (. row args) (. row errors) name)
        )
        (case (call .type-result row)
          (or (call mentions-variable (. row value) name) (call range-mentions (. row errors) name))
        )
        (case (call .type-associated row)
          (or (call mentions-variable (. row owner) name) (call range-mentions (. row args) name))
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr _ function-mentions Bool
    (param returns TypeId)
    (param args (of RowRange TypeId))
    (param errors (of RowRange TypeId))
    (param name Atom)
    (or (call mentions-variable returns name) (call range-mentions args name) (call range-mentions errors name))
  )
  (fn-do _ range-mentions Bool
    (param range (of RowRange TypeId))
    (param name Atom)
    (for (in offset (..< 0 (. range count)))
      (if (call mentions-variable (call (. types child-type) range offset) name)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ rank-slots Bool
    (param scope MatchScope)
    (param generic Bool)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param expected (of ImmutableArray TypeId ArenaBacking))
    (param declared (of ImmutableArray TypeId ArenaBacking))
    (param specs (of ImmutableArray U32 ArenaBacking))
    (param untyped (of ImmutableArray U32 ArenaBacking))
    (param variadic-index U32)
    (param tails TailMatch)
    (param defaults (of ImmutableArray U32 ArenaBacking))
    ; Relates every filled slot's argument to its expected type, recording the relation and the
    ; type the slot settles on, and rejects the candidate as soon as one slot loses to the incumbent.
    ; A generic candidate's slots relate to what its parameters are bound to, and two that tie
    ; are told apart by what each declares, with its parameters unbound, as in the reference.
    ; A parameter with no type written compares its argument to nothing, as in the reference: the
    ; slot keeps what the candidate chosen so far compared there, and a later candidate that
    ; writes a type takes the slot whatever its relation.
    ; A variadic slot ranks as the reference ranks it, which relates one list to the list
    ; declared. Where every parameter was known before the arguments were looked at, the tail
    ; is typed as the list declared, and the slot ranks as the same type. Where the list
    ; declared is known and a parameter is not, the tail is a list of what its arguments unify
    ; to, and the slot ranks as that list related to the one declared. Where the list was
    ; inferred from the tail, the slot ranks as the worst of the tail.
    (let empty U32 (. ArgumentFill fill-empty))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (let is-variadic (!= variadic-index (. U32 max)))
    (call (. ranked clear))
    (call (. ranked-params clear))
    (for (in position (..< 0 (. fills length)))
      (let fill ([] fills position))
      (let param ([] expected position))
      (let compares (or (>= position (. untyped length)) (== ([] untyped position) 0)))
      (let open (and (not generic) (!= param invalid-type) (. ([] (. types completions) param) has-variables)))
      (if (or (== param invalid-type) (and open (or (== fill empty) (== fill variadic))))
        (return false)
      )
      (let relation (call same-relation param))
      (if (== fill variadic)
        (if (not (. tails settled))
          (for (in tail (. tails relations))
            (if (> (. tail rank) (. relation rank))
              (= relation tail)
            )
          )
          (if (>= (. tails listed) 0)
            (= (. relation rank) (. tails listed))
          )
        )
        (else-if (!= fill empty)
          (let given ([] args fill))
          (let shape ([] calls fill))
          (if (or (== given invalid-type) (== given no-type))
            (return false)
          )
          (if (. shape symbol)
            (let resolved (call symbol-owner fill))
            (if (== resolved no-type)
              (= consulted true)
              (= resolved (call symbols-type types program param shape))
            )
            (if (== resolved invalid-type)
              (return false)
            )
            (= relation (call (. relations compare) resolved param false false scope caller))
            (else-if (call is-callable-value scope given param)
              (let fit (call closure-fits given param scope))
              (if (not fit)
                (return false)
              )
              (= relation fit)
            )
            (else
              (let defaulted (and (< position (. defaults length)) (!= ([] defaults position) 0)))
              (let present
                (scope (and omittable (call (. types is-optional) given) (not (call (. types is-optional) param)))
                  (lazy omittable (or (. shape is-optional) defaulted))
                )
              )
              (let literal
                (scope (or (and has-literal fits-literal) (call whole-unit-literal shape param))
                  (lazy has-literal (!= (. shape literal) 0))
                  (lazy fits-literal (and (!= conversions null) (call (. conversions fitting-literal) (. shape literal) param)))
                )
              )
              (let requested
                (scope (or present literal similar-spec)
                  (lazy similar-spec (and (< position (. specs length)) (== ([] specs position) (. Specificity similar))))
                )
              )
              (= relation (call compare-argument given param scope requested))
              (if (and present (not (call relation-legal (call compare-argument given-inner param scope))))
                (return false)
              )
              (lazy given-inner (call (. types optional-inner) given))
              (if (== (. relation kind) .relation-converter)
                (= consulted true)
              )
              (let answer (if-expr conversions (call (. conversions answer-of) relation) no-type))
              (if (!= answer no-type)
                (= (. relation to) answer)
                (= (. relation unified) answer)
              )
            )
          )
          (if (or (not (call relation-legal relation)) (== (. relation kind) .relation-interface-down-cast))
            (return false)
          )
          (if (and open (. ([] (. types completions) (. relation to)) has-variables))
            (return false)
          )
          (let specificity (if-expr (< position (. specs length)) ([] specs position) 0u32))
          (let written (or (and (!= (. shape literal) 0) (!= conversions null) (call (. conversions fitting-literal) (. shape literal) param)) (call whole-unit-literal shape param)))
          (if (and (not (call meets-specificity relation specificity)) (not written))
            (return false)
          )
        )
      )
      (if (and compared-fill (not (call beats-incumbent position relation is-variadic ([] declared position))))
        (return false)
      )
      (lazy compared-fill (and (!= fill empty) compares))
      (call (. scratch relations push) relation)
      (if compares
        (+= ranked relation)
        (+= ranked-params ([] declared position))
        (else
          (+= ranked (if-expr (< position (. incumbent length)) ([] incumbent position) (call uncompared)))
          (+= ranked-params (call incumbent-declared position))
        )
      )
      (let chosen param)
      (let completes (call (. relations holds-alternatives) param))
      (let chooses (or open completes (== (. ([] (. types completions) param) intrinsic) .or)))
      (if (and chooses (!= fill empty) (!= fill variadic))
        (= chosen (. relation to))
      )
      (let unified
        (scope (and unifies (not (and completes (!= fill empty) (!= fill variadic))))
          (lazy unifies (and generic (!= (. relation unified) no-type)))
        )
      )
      (let recorded (if-expr unified (. relation unified) chosen))
      (if (and (== fill variadic) generic (!= (. tails fills length) 0))
        (= recorded (call list-type-of (. relation unified)))
      )
      (if (and (== fill empty) (== (as position U32) variadic-index) (!= tail-default no-type))
        (= recorded tail-default)
      )
      (call (. scratch types push) recorded)
    )
    (return true)
  )
  (fn-do _ list-type-of TypeId
    (param item TypeId)
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (return (call (. types class-with-args) (. types list-decl module) (. types list-decl decl) mark))
  )
  (fn-expr _ meets-specificity Bool
    (param relation Relation)
    (param specificity U32)
    (case? (== specificity (. Specificity similar))
      (call validate-relation relation .similar)
    )
    (case? (== specificity (. Specificity exact))
      (call validate-relation relation .exact)
    )
    (default
      true
    )
  )
  (fn-expr _ beats-incumbent Bool
    (param position Size)
    (param relation Relation)
    (param is-variadic Bool)
    (param declared TypeId)
    ; Whether the relation of a candidate's slot keeps it in the running against the candidate
    ; chosen so far, as the reference's `matchArg` decides. A candidate with fixed slots takes
    ; the place of a variadic one where its relation ranks under a converter and narrows
    ; nothing. Any other is kept where its relation is preferred, and where neither is
    ; preferred unless it is variadic: of two that tie, the fixed one and the earlier variadic
    ; one win.
    (case? (>= position (. incumbent length))
      true
    )
    (case? (not (call relation-legal current))
      true
    )
    (case? (and incumbent-variadic (not is-variadic) (not narrows) below-converter)
      true
    )
    (case? (!= preference 0)
      (> preference 0)
    )
    (default
      (not is-variadic)
    )
    (where
      (lazy current ([] incumbent position))
      (lazy narrows (or (== (. relation kind) .relation-unwrap-cast) (== (. relation kind) .relation-down-cast)))
      (lazy preference (call slot-preference current relation position declared))
      (lazy below-converter (< (. relation rank) (call relation-rank .relation-converter)))
    )
  )
  (fn-do _ slot-preference I32
    (param current Relation)
    (param relation Relation)
    (param position Size)
    (param declared TypeId)
    ; Which of two relations of one argument is preferred, that of the candidate chosen so far
    ; or a new one: above zero for the new one, under it for the chosen one, in the reference's
    ; order. A lambda is given to a function type declared before a type parameter. Of two side
    ; casts of one type, the one that lifts it to a base is. Else the lower rank is. Of two final
    ; casts of one tuple, the one whose fields are, each field by what the two candidates
    ; declare for it: `declared` is what the new one declares for the slot.
    (if (and (== (. relation from) (. current from)) (call is-closure-type (. relation from)))
      (let chosen (call incumbent-declared position))
      (if (and (call is-type-variable chosen) (!= (call function-row types declared) no-type))
        (return 1)
      )
      (if (and (call is-type-variable declared) (!= (call function-row types chosen) no-type))
        (return -1)
      )
    )
    (let side-pair (and (== (. relation kind) .relation-side-cast) (== (. current kind) .relation-side-cast)))
    (if (and side-pair (== (. relation from) (. current from)))
      (let lifts (call in-base-chain types (. relation from) (. relation to)))
      (let current-lifts (call in-base-chain types (. current from) (. current to)))
      (if (!= lifts current-lifts)
        (return (if-expr lifts 1 -1))
      )
    )
    (if (!= (. relation rank) (. current rank))
      (return (if-expr (< (. relation rank) (. current rank)) 1 -1))
    )
    (let final (and (== (. relation kind) .relation-final-cast) (== (. current kind) .relation-final-cast)))
    (if (and final (== (. relation from) (. current from)))
      (return
        (call (. relations tuple-field-preference)
          (block
            (arg (. relation from))
            (arg (. current to))
            (arg (. relation to))
            (arg (call incumbent-declared position))
            (arg declared)
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr _ is-closure-type Bool
    (param type TypeId)
    (case? (== type no-type)
      false
    )
    (default
      (match ([] (. types rows) type)
        (case .type-closure
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr _ is-type-variable Bool
    (param type TypeId)
    (case? (== type no-type)
      false
    )
    (default
      (match ([] (. types rows) type)
        (case .type-variable
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr _ uncompared Relation
    (call Relation
      (block
        (arg .relation-illegal)
        (arg -1i32)
        (arg .convertible)
        (arg no-type)
        (arg no-type)
        (arg no-type)
        (arg (. U32 max))
        (arg no-type)
        (arg (call no-ratio))
        (arg .reason-none)
      )
    )
  )
  (fn-expr _ incumbent-declared TypeId
    (param position Size)
    ; What the candidate chosen so far declares for a slot, with its parameters unbound, where
    ; its slots were ranked one by one.
    (if-expr (>= position (. incumbent-params length)) no-type ([] incumbent-params position))
  )
  (fn-do _ rank-tail Size
    (param scope MatchScope)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param variadic-index U32)
    (param item TypeId)
    (let count 0)
    (let index 0u32)
    (for (in _ (..< 0 (. calls length)))
      (if (and (>= index variadic-index) (not (call slot-holds fills index)))
        (let given (call tail-given index))
        (let literal (. ([] calls index) literal))
        (let fits (and (!= literal 0) (!= conversions null) (call (. conversions fitting-literal) literal (call substitute item scope))))
        (let relation (call compare-argument given item scope fits))
        (if (not (call relation-legal relation))
          (return (. Size max))
        )
        (call (. scratch words push) index)
        (call (. scratch relations push) relation)
        (+= count 1)
      )
      (+= index 1)
    )
    (return count)
  )
  (fn-do _ tail-item TypeId
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param variadic-index U32)
    ; The one type the arguments of a variadic tail that declares no type unify to, where those
    ; written as numbers with no suffix join the others place by place, as the items of a list do.
    (let joined no-type)
    (let written true)
    (let index 0u32)
    (for (in _ (..< 0 (. calls length)))
      (if (and (>= index variadic-index) (not (call slot-holds fills index)))
        (let given (call tail-given index))
        (let literal (!= (. ([] calls index) literal) 0))
        (if (== joined no-type)
          (= joined given)
          (else
            (let relation (call (. relations unify) joined given caller))
            (if (call relation-legal relation)
              (= joined (. relation unified))
              (else
                (let places (call (. relations joined-places) joined given))
                (return-if invalid-type (if (or (== places no-type) misplaced)))
                (blank)
                (lazy misplaced (or (not (or written (== places joined))) (not (or literal (== places given)))))
                (= joined places)
              )
            )
          )
        )
        (= written (and written literal))
      )
      (+= index 1)
    )
    (return joined)
  )
  (fn-do _ tail-given TypeId
    (param index U32)
    ; What an argument of a variadic tail gives the list, as TypeScript gives it: its value, or
    ; the tuple of its name and its value where it has a name. With a bullet `•?` it gives what
    ; it holds where it is present: the value an optional holds, and of the tuple of a key and
    ; a value, the key and what the value holds.
    (let given ([] args index))
    (let shape ([] calls index))
    (if (and (. shape is-optional) (. shape name))
      (return (call key-value-type (if-expr (call (. types is-optional) given) (call (. types optional-inner) given) given)))
    )
    (if (. shape is-optional)
      (return (call present-pair given))
    )
    (if (. shape name)
      (return (call key-value-type given))
    )
    (return given)
  )
  (fn-do _ present-pair TypeId
    (param pair TypeId)
    ; The tuple of a key and what an optional value after it holds.
    (if (!= (call (. types intrinsic-of) pair) .tuple)
      (return pair)
    )
    (let fields (. ([] (. types completions) pair) properties))
    (if (!= (. fields count) 2)
      (return pair)
    )
    (let held (. ([] (. types properties) (+ (. fields start) 1)) type))
    (if (not (call (. types is-optional) held))
      (return pair)
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (call (. scratch names push) (call (. types index-atom) 0))
    (call (. scratch types push) (. ([] (. types properties) (. fields start)) type))
    (call (. scratch names push) (call (. types index-atom) 1))
    (call (. scratch types push) (call (. types optional-inner) held))
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ key-value-type TypeId
    (param value TypeId)
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (call (. scratch names push) (call (. types index-atom) 0))
    (call (. scratch types push) (. types string-type))
    (call (. scratch names push) (call (. types index-atom) 1))
    (call (. scratch types push) value)
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ slot-holds Bool
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param index U32)
    (for (in fill fills)
      (if (== fill index)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ list-item TypeId
    (param param TypeId)
    (match ([] (. types rows) param)
      (case (call .type-class row)
        (if-expr (call is-list (. row module) (. row decl) (. row args count)) item invalid)
        (lazy item (call (. types child-type) (. row args) 0))
      )
      (default
        invalid
      )
    )
    (where
      (lazy invalid invalid-type)
    )
  )
  (fn-expr _ is-list Bool
    (param module ModuleId)
    (param decl DeclId)
    (param count U32)
    (and (== module (. types list-decl module)) (== decl (. types list-decl decl)) (>= count 1))
  )
)

(type + TailMatch (is Tuple)
  (prop + fills (of ImmutableArray U32 ArenaBacking))
  (prop + relations (of ImmutableArray Relation ArenaBacking))
  (prop + settled Bool)
  (prop + listed RelationRank (= -1))
)

(fn-expr + symbols-type TypeId
  (param types Types)
  (param program Program)
  (param expected TypeId)
  (param shape CallArgument)
  (if-expr (or (== found invalid-type) (not (. shape other-symbol))) found (call symbol-type types program expected (. shape other-symbol)))
  (where
    (lazy found (call symbol-type types program expected (!! (. shape symbol))))
  )
)

(fn-do + symbol-type TypeId
  (param types Types)
  (param program Program)
  (param expected TypeId)
  (param name Atom)
  ; The type a case named by its symbol alone is of where a type is expected of it that has the
  ; case: the expected type, a union with a case of the name or a class with an enum case of it.
  ; The invalid type where it has none.
  (if (or (== expected invalid-type) (== expected no-type))
    (return invalid-type)
  )
  (let completion (call (. types completion-of) expected))
  (if (== (. completion intrinsic) .union)
    (for (in fact ([] (. types cases) (. completion cases)))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (return expected)
      )
    )
    (return invalid-type)
  )
  (if (and (. completion has-enums) (call enum-case-decl types program expected name))
    (return expected)
  )
  (return invalid-type)
)

(fn-do + contextual-symbol TypeId
  (param types Types)
  (param relations Relations)
  (param expected TypeId)
  (param name Atom)
  (param home ModuleId)
  ; The type a case named by its symbol alone is of where a type is expected of it, as the
  ; reference settles it: the expected type where it has the case, else the type the name alone
  ; gives where that converts, else the first other type with the case that converts.
  (if (or (== expected invalid-type) (== expected no-type))
    (return invalid-type)
  )
  (let target (if-expr (call (. types is-optional) expected) (call (. types optional-inner) expected) expected))
  (if (!= (call symbol-type types (. types program) target name) invalid-type)
    (return target)
  )
  (let primary (call symbol-class types home name))
  (if (or (== primary invalid-type) (== primary target))
    (return primary)
  )
  (if (call relation-legal (call (. relations compare) primary target false false null home))
    (return primary)
  )
  (let owners (list TypeId))
  (call symbol-owners types home name owners)
  (for (in owner owners)
    (if (!= owner primary)
      (if (call relation-legal (call (. relations compare) owner target false false null home))
        (return owner)
      )
    )
  )
  (return primary)
)

(fn-do + enum-case-decl (? DeclId)
  (param types Types)
  (param program Program)
  (param about TypeId)
  (param name Atom)
  ; The enum case a class declares by a name, or none.
  (let ref (call class-ref types about))
  (if (== (. ref module) (. U32 max))
    (return null)
  )
  (let owner-module ([] (. program modules) (. ref module)))
  (let members (call (of RowRange DeclId)))
  (match? ([] (. owner-module decls) (. ref decl))
    (case (call .decl-class row)
      (= members (. row members))
    )
  )
  (for (in member (call (. owner-module members-named) members name))
    (match? ([] (. owner-module decls) member)
      (case (call .decl-case row)
        (if (and (. row name) (== (. row name) name))
          (return member)
        )
      )
    )
  )
  (return null)
)
