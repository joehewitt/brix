━━━━━━━━━━━━━━━━━━━━
_ Loops is facet of Checker
    sees Assignments
    sees Comprehensions
    sees LiveActions
    sees Markup
    sees MatchArms
    sees Streams
    sees Tables

_ place-base SyntaxId = 0

────────────────────
+ do check-while
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId

frame.forget-members()
reset-assigned-paths(body)
note-poll()
loop-marks += scratch.narrowings.mark
tested-match = tree.tested(condition)
. runs = if tested-match != 0 then condition else body
note-truthiness(condition, condition, infer-tested(condition))
tested-match = 0
. mark = scratch.narrowings.mark
narrowing.narrow-condition(condition, true)
loop-depth += 1
discarding-block = body
check-statement(body)
loop-depth -= 1
frame.pop-narrowing(mark)
widen-assigned(id, runs)

────────────────────
+ do note-poll

` A loop polls on each pass, unless it is where no safepoint is allowed.
if (dispatch-effects(frame.surround.effects) /and/ CompilationEffect.no-safepoint) == 0
    instances.mark-polls(instance)

────────────────────
_ do reset-assigned-paths
    - body SyntaxId

if body == 0
    =
for id in tree.subtree-start(body) .. body
    do match? tree.nodes[id]
        | .node-assign(row)
            reset-target-paths(row.lhs)

────────────────────
_ do reset-target-paths
    - target SyntaxId

do match? tree.nodes[target]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, target)
        if resolution.kind == .resolve-slot
            frame.reset-stable-paths(slot-key(resolution.slot))
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            reset-target-paths(item)

────────────────────
_ do widen-assigned
    - loop SyntaxId
    - body SyntaxId

` A loop runs any number of times, so a local it assigns is afterwards what its declaration
` says, unless every assignment in the loop leaves it as it was known before the loop. What
` was known before the loop cannot be relied on in the body ahead of an assignment that
` breaks it: the body runs again after that assignment.
if body == 0
    leave-loop()
    =
for id in tree.subtree-start(body) .. body
    do match? tree.nodes[id]
        | .node-assign(row)
            . slot = narrowing.condition-slot(row.lhs)
            if !slot
                continue
            . declared = slot-known(slot)
            . settled = declared
            if row.op == .eq-op
                settled = assigned-narrowing(declared, facts.node-type(instance, row.rhs))
            . carried = frame.slot-type(slot)
            . typed = declared != no-type && declared != invalid-type
            if typed && settled != carried
                if carried != declared && relies-on(slot, id, row.lhs)
                    . name = identifier-name(tree, row.lhs)
                    . shown = if name then name.text else ""
                    . message = "Narrowing of '$shown' is used in the loop but does not hold when "
                    frame.diagnose(loop, .stated, program.store-atom(message ++ "the loop repeats"))
                frame.push-assigned(slot-key(slot), declared)
leave-loop()

────────────────────
_ do relies-on Bool
    - slot SlotId
    - assignment SyntaxId
    - target SyntaxId

` Whether the innermost loop reads a local as what was known of it before the loop, ahead of
` an assignment to it.
. loop = loop-marks.length - 1
for position in 0 .. < carried-sites.length
    . site = carried-sites[position]
    if carried-slots[position] == slot && carried-loops[position] == loop
        if site < assignment && site != target
            = true
= false

────────────────────
_ do leave-loop

. loop = loop-marks.length - 1
. kept = 0
for position in 0 .. < carried-sites.length
    if carried-loops[position] != loop
        carried-slots[kept] = carried-slots[position]
        carried-loops[kept] = carried-loops[position]
        carried-sites[kept] = carried-sites[position]
        kept += 1
-= carried-slots[kept .. < carried-slots.length]
-= carried-loops[kept .. < carried-loops.length]
-= carried-sites[kept .. < carried-sites.length]
loop-marks.pop()

────────────────────
+ do check-for
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId
    - next SyntaxId

` A `for` block. One on a stream subscribes where it is written, and its subscriber runs the
` body; one on a stream joined to another source, by a header chained after it or an `or`
` arm, is an error. Any other loop runs its headers and its body.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if row.is-subscriber && tree.is-stream-pattern(row.pattern)
            report-pattern-on(row.pattern)
            =
        if row.is-subscriber && (row.next != 0 || next != 0)
            . text = "A loop on a stream subscribes to one source, so it cannot be joined to another; write a loop for each source"
            frame.diagnose(loop, .stated, program.store-atom(text))
            =
        . subscriber = if row.is-subscriber then nested-decl-of(id) else 0u32
        if subscriber != 0 && frame.declaration.syntax == id
            check-subscriber(loop, body)
        else if subscriber != 0
            check-subscription(id, loop, row.container, row.clause, subscriber)
        if subscriber != 0
            if next != 0
                check-statement(next)
            =
        . simple = row.next == 0 && is-simple-loop-pattern(row.pattern)
        . container = loop-container(row.container, simple, stated-item(row.pattern))
        frame.forget-members()
        reset-assigned-paths(body)
        . alone = row.next == 0 && !row.is-subscriber && !row.is-match
        if container.item != no-type && alone
            facts.set-plan(instance, loop, .plan-range-loop)
        note-poll()
        loop-marks += scratch.narrowings.mark
        check-loop(loop, container, body, false, row.next == 0)
        if container.item != no-type && alone
            if counts-from-zero(row.container)
                facts.set-constant
                    - instance
                    - loop
                    - ConstantFact(1, 0.0, null, false)
                    - .plan-range-loop
            note-proven-rows(loop, row.pattern, row.container, row.clause, body)
            note-proven-items(row.pattern, row.container, row.clause, body)
        widen-assigned(id, body)
if next != 0
    check-statement(next)

────────────────────
+ do check-loop
    - loop SyntaxId
    - container LoopContainer
    - body SyntaxId
    - yields Bool
    - alone Bool = false
    - given Bool = false

` One loop header over a container typed by the caller, then its chained headers and the body,
` which a comprehension yields and a `for` block runs. A `for` block's header `alone` in it
` gives the rows of a table as TypeScript gives them. A comprehension's header is `given` its
` container, which a loop over the rows of a table keeps until it begins. A pattern written as a match with no arms
` gives the item as it fitted, but one that names a case of a union leaves it the union. A
` `keyed by` keys only the rows of a markup loop region, which is not checked here.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if !row.is-subscriber
            reject-keyed-clause(row.clause)
        if tree.is-stream-pattern(row.pattern)
            if check-pattern-header(loop, row.pattern, container.type)
                check-loop-rest(loop, tested-clause(loop, row.clause), row.next, body, yields)
            =
        . item = container.item
        . iterated = container.type
        if item == no-type
            if !row.is-subscriber
                iterated = iteration-container(container.type, row.container)
            item = loop-item-type(iterated, loop, slice-through-call(row.container))
            . given = iterated != invalid-type && iterated != no-type
            if item == invalid-type && given && !row.is-subscriber
                frame.diagnose(row.container, .stated, program.store-atom("Object is not iterable"))
        . yielded = item
        . pattern = row.pattern
        . transformed = false
        . matched = row.is-match
        . fitted = false
        do match? tree.nodes[pattern]
            | .node-structure-match(inner)
                transformed = has-arms(inner.pattern)
                pattern = inner.pattern
                matched = true
                fitted = !transformed
        if transformed
            item = match-item(row.pattern, pattern, item)
        else if matched
            check-pattern(pattern, item)
            if fitted && typed-item && !(tree.nodes[pattern] is .node-type-case)
                item = pattern-value(pattern, item)
            .. typed-item = item != no-type && item != invalid-type
        else
            declare(pattern, item, row.container)
        facts.set-loop-take(instance, loop, loop-take(pattern, transformed, matched))
        if itemless && (counts-rows(iterated) || counts-indices(iterated, row.container))
            facts.set-plan(instance, loop, .plan-table-loop)
            instances.mark-may-panic(instance)
            . kind = types.intrinsic-of(iterated)
            . held = kind == .table-selection || kind == .immutable-table-selection || spans-index
                .. spans-index = kind == .index-span
            keep-loop(loop, if held then iterated else yielded, types.size-type, types.size-type)
            if given
                keep-loop-given(loop, iterated)
            if alone && !yields && checks-rows(row.pattern, iterated, body, row.clause)
                note-checked-rows(loop, row.pattern)
        else if container.item == no-type
            note-container-iteration(loop, iterated, false, loop)
            if facts.plan-of(instance, loop) == .plan-cursor-loop
                note-place(loop, row.container, iterated, .plan-cursor-place-loop)
            if is-indexed(iterated, slice-through-call(row.container))
                facts.set-plan(instance, loop, .plan-index-loop)
                if is-array-field(iterated, types.length-atom!)
                    facts.set-constant
                        - instance
                        - loop
                        - ConstantFact(1, 0, null, false)
                        - .plan-index-loop
                keep-loop(loop, iterated, types.size-type, types.size-type)
                note-place(loop, row.container, iterated, .plan-index-place-loop)
        else
            keep-loop(loop, container.item, container.item, types.bool-type)
        .. itemless = container.item == no-type
        keep-loop-item(loop, if transformed then item else yielded)
        assign-loop-slots(loop, item, row.pattern != 0 && !transformed && !fitted)
        check-loop-rest(loop, tested-clause(loop, row.clause), row.next, body, yields)
        if alone && !yields && !row.is-match && !row.is-subscriber && table-looped
            if proves-rows(row.pattern, iterated, body, row.clause)
                facts.set-constant
                    - instance
                    - loop
                    - ConstantFact(1, 0.0, null, false)
                    - .plan-table-loop
        .. table-looped = facts.plan-of(instance, loop) == .plan-table-loop
        . selects = types.intrinsic-of(iterated) == .table-selection || immutable-selection
            .. immutable-selection = types.intrinsic-of(iterated) == .immutable-table-selection
        if selects && facts.plan-of(instance, loop) == .plan-table-loop
            . reads = selection-reads
                - row.container
                - iterated
                - body
                - row.clause
                - row.next != 0 || yields
            facts.set-constant
                - instance
                - loop
                - ConstantFact(reads, 0, null, false)
                - .plan-table-loop

────────────────────
_ do reject-keyed-clause
    - clause SyntaxId

. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if row.op == .keyed-by-clause
                frame.diagnose
                    - current
                    - .stated
                    - program.store-atom("keyed by is only valid on markup loops")
            next = row.next
    current = next

────────────────────
_ tested-clause SyntaxId
    - loop SyntaxId
    - clause SyntaxId

` The clauses of a loop header that are tested: those after the first of a loop on an event
` whose first clause says which publications it hears. A `whenever` among them says whether
` the loop is subscribed and is not tested.
if facts.event-clause-of(module, loop) then next-clause(clause) else clause

────────────────────
_ do check-loop-rest
    - loop SyntaxId
    - clause SyntaxId
    - next SyntaxId
    - body SyntaxId
    - yields Bool

` What follows a loop's header: its clause, which holds wherever the body runs, then the
` headers chained after it, or the body.
. clause-mark = scratch.narrowings.mark
if clause != 0
    check-clause(clause, body)
if next != 0
    do match? tree.nodes[next]
        | .node-loop-syntax(following)
            check-loop
                - next
                - loop-container(following.container, false, stated-item(following.pattern))
                - body
                - yields
else if yields && is-subscriber-body()
    note-broadcast(body, infer(body))
else if yields
    note-yield(infer(body))
else
    loop-depth += 1
    check-body(body)
    loop-depth -= 1
frame.pop-narrowing(clause-mark)

────────────────────
_ do check-body
    - body SyntaxId

` The body of a loop that runs it. One written as one line that is content of a markup element
` runs as a block of that line would: the elements it names are made first, and the element
` takes the line's value.
. parent = content-parent(body)
if parent == no-type || tree.nodes[body] is .node-block
    check-statement(body)
    =
if names-elements(body)
    raise-line(body)
. hosted = content-blocks.length
host-content(body, parent)
. produced = check-line(body, parent, Want().adding(.want-content-line))
while content-blocks.length != hosted
    content-blocks.pop()
    content-parents.pop()
    content-names.pop()
if !leaves-line(body)
    link-content(body, produced, parent)
else
    frame.diagnose(body, .stated, program.store-atom("Illegal return"))

────────────────────
_ do check-pattern-header Bool
    - loop SyntaxId
    - written SyntaxId
    - container TypeId

` A loop's header written as a stream pattern, as the reference runs it: the container is
` read through the stream a match would read it through, made once, by the calls recorded at
` the header, and each pass matches the pattern from where the last left the stream, as a
` rule's arms match, without reading the rest. The loop ends where the stream has no more or
` the pattern fails, and a pattern that may match without reading, where the reference knows
` what it reads first, is an error, as it is in a pipe. Its item, `each`
` and `it`, is what the pattern gives, and the names it captures are the body's. One whose
` item is optional is an error: the reference gives what the optional holds, or a value it
` can not print. One whose names are not each what one part gave has no shape. A container the
` reference finds no iterator for is read through its stream all the same, as the reference's
` `StreamSourceIterator` lets it be, and one it makes no stream of is its error at the pattern.
` False where the header was declined.
. pattern = written
do match? tree.nodes[written]
    | .node-stream-match(row)
        pattern = row.pattern
if container == invalid-type || container == no-type
    = false
if !iterates(container) && natural-item(container) == no-type
    frame.diagnose(written, .stated, program.store-atom("Can't convert to iterable"))
    = false
if first-set(pattern) == 3 || tree.never-reads(pattern)
    frame.diagnose(written, .stated, program.store-atom("Stream pattern loop must consume input"))
    = false
. buffer = stream-view
. read = record-stream-protocol(loop, container)
. made = stream-view.type
. typed = if read then type-stream-arms(pattern, true) else invalid-type
stream-view = buffer
if !read || (typed != invalid-type && !plain-captures(pattern))
    decline(loop)
    = false
if typed == invalid-type
    = false
if types.is-optional(typed)
    frame.diagnose(written, .stated, program.store-atom(optional-match-text("loop")))
    = false
if calls.protocol-getter(made, program.store-atom("has-more"), loop) != types.bool-type
    decline(loop)
    = false
facts.set-plan(instance, loop, .plan-pattern-loop)
facts.set-loop-take(instance, loop, .take-whole)
keep-loop(loop, container, made)
keep-loop-item(loop, typed)
assign-loop-slots(loop, typed, false)
= true

────────────────────
+ do iterates Bool
    - container TypeId

` Whether the reference finds an iterator for the container of a loop over a stream, as it
` does before it makes the stream, though it uses none: a generator, or a value `supported` as
` a `CursorIterable`, an `Iterable`, an `Indexable` or a `Stream`.
if same-decl(class-ref(types, container), types.generator-decl)
    = true
for decl in [types.cursor-iterable-decl, types.iterable-decl, types.indexable-decl, types.stream-decl]
    if supported(container, decl) != no-type
        = true
= false

────────────────────
_ do plain-captures Bool
    - id SyntaxId
    - repeated Bool = false

` Whether each name a stream pattern captures holds what one part of it gave, as the
` reference gives the body of a loop the names its header captures: none captured in a
` repeat or a count, nor one that accumulates, which the reference can not compile there,
` nor one that may hold nothing, which it gives the body as a value it can not read.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        if repeated || row.accumulating || types.is-optional(facts.node-type(instance, row.name))
            = false
        = plain-captures(row.pattern, repeated)
    | .node-stream-and(row)
        = plain-captures(row.left, repeated) && plain-captures(row.right, repeated)
    | .node-stream-or(row)
        = plain-captures(row.left, repeated) && plain-captures(row.right, repeated)
    | .node-stream-transform(row)
        = plain-captures(row.pattern, repeated)
    | .node-stream-panic(row)
        = plain-captures(row.pattern, repeated)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        = plain-captures(row.operand, repeated || repeat)
    | .node-stream-length(row)
        = plain-captures(row.operand, true)
= true

────────────────────
_ do checks-rows Bool
    - pattern SyntaxId
    - iterated TypeId
    - body SyntaxId
    - clause SyntaxId

` Whether a loop gives each row of a table or a span of one as `t[i]` gives it, a row whose
` storage TypeScript checked: where the rows are of a union, the loop names its row alone, no
` nested function reads it, and neither the body nor the clause calls a local.
. kind = types.intrinsic-of(iterated)
if kind == .table-selection || kind == .immutable-table-selection || complex-pattern
    = false
.. complex-pattern = !is-simple-loop-pattern(pattern)
if types.intrinsic-of(row-struct-of(iterated)) != .union
    = false
. blocked [Atom]
. effects = SelectionEffects()
scan-effects(body, blocked, effects)
if clause != 0
    scan-effects(clause, blocked, effects)
= !effects.table

────────────────────
_ proves-rows Bool
    - pattern SyntaxId
    - iterated TypeId
    - body SyntaxId
    - clause SyntaxId

|? (kind != .table && kind != .table-span) || pattern == 0 || !is-simple-loop-pattern(pattern)
    false
|? !named || (bindings.slots[named].flags /and/ SlotFlag.slot-captured) != 0
    false
??
    keeps-table(body) && (clause == 0 || keeps-table(clause))

.. kind = types.intrinsic-of(iterated)
.. named = declaring-slot(pattern)

────────────────────
_ do keeps-table Bool
    - root SyntaxId

for node in tree.subtree-start(root) .. < root + 1
    if !keeps-table-node(node)
        = false
= true

────────────────────
_ do keeps-table-node Bool
    - node SyntaxId

. op = planned-table-op(node)
if has-call && op != TableOp.table-field && op != TableOp.table-row
    = false
.. has-call = facts.first-call(instance, node) != no-fact
do match? tree.nodes[node]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, node)
        = resolution.kind != .resolve-slot || bindings.slots[resolution.slot].kind != .slot-lazy
    | .node-unary-expression(unary)
        = unary.op == .negative-op || unary.op == .not-op
    | .node-get-expression(get)
        = !get.is-tracked
    | .node-assign(assign)
        = assigns-number(assign.lhs)
    | .node-type-capture(capture)
        = capture.type == 0
    | .node-type-predicate(predicate)
        = !predicate.is-contextual
    | .node-type-equality(equality)
        = !equality.is-contextual
    | .node-clause(clause)
        = clause.op != .whenever-clause
    | .node-match-expression(matched)
        = matched.helper == 0
= match tree.nodes[node]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-binary-expression
        true
    | .node-cast-expression
        true
    | .node-declare
        true
    | .node-block
        true
    | .node-if-block
        true
    | .node-break
        true
    | .node-continue
        true
    | .node-return
        true
    | .node-structure-match
        true
    | .node-type-or
        true
    | .node-type-transform
        true
    | .node-type-case
        true
    | .node-type-tuple
        true
    | .node-type-wildcard
        true
    | .node-type-identifier
        true
    ??
        false

────────────────────
_ do assigns-number Bool
    - lhs SyntaxId

do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        . local = resolution.kind == .resolve-slot && local-slot
            .. local-slot = bindings.slots[resolution.slot].kind == .slot-local
        . type = facts.node-type(instance, lhs)
        if (!local && resolution.kind != .resolve-global) || type == no-type || type == invalid-type
            = false
        = intrinsic-is-numeric(types.intrinsic-of(type))
= false

────────────────────
_ do note-checked-rows
    - loop SyntaxId
    - pattern SyntaxId

` Keeps the names a loop gives its rows by as reading rows whose storage was checked, unless a
` nested function reads one of them.
. slots [SlotId]
if pattern != 0
    . named = declaring-slot(pattern)
    if named
        slots += named
. first = bindings.resolution-of(frame.binding, loop)
if first.kind == .resolve-slot
    . bound = bindings.bindings[frame.binding]
    . slot = first.slot
    while slot < bound.slots.start + bound.slots.count
        . row = bindings.slots[slot]
        if (row.kind != .slot-it && row.kind != .slot-each) || row.syntax != loop
            break
        slots += slot
        slot += 1
for slot in slots
    if (bindings.slots[slot].flags /and/ SlotFlag.slot-captured) != 0
        =
for slot in slots
    checked-rows += slot

────────────────────
_ do note-proven-rows
    - loop SyntaxId
    - pattern SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

. view = counted-view(container)
if !view || pattern == 0
    =
. counter = declaring-slot(pattern)
if !counter
    =
if !keeps-rows(body, view, counter) || (clause != 0 && !keeps-rows(clause, view, counter))
    =
mark-proven-rows(loop, body, view, counter)
if clause != 0
    mark-proven-rows(loop, clause, view, counter)

────────────────────
_ counts-from-zero Bool
    - container SyntaxId

match tree.nodes[container]
    | .node-range-expression(range)
        range.op == .range-to-op && range.increment == 0 && is-zero-literal(range.left)
    ??
        false

────────────────────
_ do note-proven-items
    - pattern SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

. array = counted-array(container)
if !array || pattern == 0
    =
. counter = declaring-slot(pattern)
if !counter
    =
if !uses-as-items(body, array) || (clause != 0 && !uses-as-items(clause, array))
    =
mark-proven-items(body, array, counter)
if clause != 0
    mark-proven-items(clause, array, counter)

────────────────────
_ do counted-array SlotId?
    - container SyntaxId

if !counts-from-zero(container)
    = null
do match? tree.nodes[container]
    | .node-range-expression(range)
        do match? tree.nodes[range.right]
            | .node-get-expression(get)
                if get.is-tracked || get.is-optional || uncounted
                    = null
                .. uncounted = get.name.text != "length" && get.name.text != "size"
                if !is-array-type(facts.node-type(instance, get.object))
                    = null
                = plain-local(get.object)
= null

────────────────────
_ do uses-as-items Bool
    - root SyntaxId
    - array SlotId

. named U32
. used U32
for node in tree.subtree-start(root) .. < root + 1
    if names-slot(node, array)
        named += 1
    do match? tree.nodes[node]
        | .node-index-expression(index)
            if names-slot(index.object, array)
                used += 1
        | .node-get-expression(get)
            if names-slot(get.object, array) && plain-get && counted-name
                used += 1
            .. plain-get = !get.is-tracked && !get.is-optional
            .. counted-name = get.name.text == "length" || get.name.text == "size"
= named == used

────────────────────
_ do mark-proven-items
    - root SyntaxId
    - array SlotId
    - counter SlotId

for node in tree.subtree-start(root) .. < root + 1
    if facts.plan-of(instance, node) == .plan-array-item && is-counted-row(node, array, counter)
        facts.set-constant(instance, node, ConstantFact(1, 0.0, null, false), .plan-array-item)

────────────────────
_ do mark-proven-rows
    - loop SyntaxId
    - root SyntaxId
    - view SlotId
    - counter SlotId

. proven = (TableOp.proven-row as U64) /or/ ((loop as U64) /lshift/ 32)
for node in tree.subtree-start(root) .. < root + 1
    if is-counted-row(node, view, counter)
        if facts.plan-of(instance, node) == .plan-view
            facts.set-plan(instance, node, .plan-proven-row)
        else if planned-table-op(node) == TableOp.table-row
            facts.set-constant(instance, node, ConstantFact(proven, 0.0, null, false), .plan-table)

────────────────────
_ planned-table-op TableOp?
    - node SyntaxId

|? constant == no-fact || facts.plan-of(instance, node) != .plan-table
    null
??
    ((facts.constants[constant].bits /and/ 4294967295) as U32) as TableOp

.. constant = facts.constant-of(instance, node)

────────────────────
_ do counted-view SlotId?
    - container SyntaxId

do match? tree.nodes[container]
    | .node-range-expression(range)
        if range.op != .range-to-op || range.increment != 0 || !is-zero-literal(range.left)
            = null
        do match? tree.nodes[range.right]
            | .node-get-expression(get)
                if get.is-tracked || get.is-optional || uncounted
                    = null
                .. uncounted = get.name.text != "length" && get.name.text != "size"
                if view-kind(facts.node-type(instance, get.object)) != 1 && not-length
                    = null
                .. not-length = planned-table-op(range.right) != TableOp.table-length
                = plain-local(get.object)
= null

────────────────────
_ is-zero-literal Bool
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-integer-syntax(literal)
        literal.value == "0" && !literal.unit
    ??
        false

────────────────────
_ do plain-local SlotId?
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-identifier(named)
        if named.is-tracked
            = null
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind != .resolve-slot
            = null
        . slot = bindings.slots[resolution.slot]
        if slot.kind != .slot-local && slot.kind != .slot-argument
            = null
        if (slot.flags /and/ SlotFlag.slot-captured) != 0 || address-taken
            = null
        .. address-taken = (slot.flags /and/ SlotFlag.slot-address-taken) != 0
        = resolution.slot
= null

────────────────────
_ do names-slot Bool
    - syntax SyntaxId
    - slot SlotId

do match? tree.nodes[syntax]
    | .node-identifier(named)
        if named.is-tracked
            = false
        . resolution = bindings.resolution-of(frame.binding, syntax)
        = resolution.kind == .resolve-slot && resolution.slot == slot
= false

────────────────────
_ do is-counted-row Bool
    - node SyntaxId
    - view SlotId
    - counter SlotId

do match? tree.nodes[node]
    | .node-index-expression(index)
        = !index.is-optional && names-slot(index.object, view) && names-slot(index.index, counter)
= false

────────────────────
_ do keeps-rows Bool
    - root SyntaxId
    - view SlotId
    - counter SlotId

for node in tree.subtree-start(root) .. < root + 1
    if !keeps-row(node, view, counter)
        = false
= true

────────────────────
_ do keeps-row Bool
    - node SyntaxId
    - view SlotId
    - counter SlotId

. answered = planned-table-op(node) == TableOp.table-row || field-op
    .. field-op = planned-table-op(node) == TableOp.table-field
if facts.first-call(instance, node) != no-fact && !answered
    = false
do match? tree.nodes[node]
    | .node-unary-expression(unary)
        = unary.op == .negative-op || unary.op == .not-op
    | .node-get-expression(get)
        if get.is-tracked || get.is-optional || (unviewed && not-field)
            = false
        .. unviewed = facts.plan-of(instance, node) != .plan-view
        .. not-field = planned-table-op(node) != TableOp.table-field
        = is-counted-row(get.object, view, counter) && intrinsic-is-numeric(node-kind)
            .. node-kind = types.intrinsic-of(facts.node-type(instance, node))
    | .node-assign(assign)
        = keeps-assigned(assign.lhs, view, counter)
    | .node-type-capture(capture)
        = capture.type == 0
    | .node-type-predicate(predicate)
        = !predicate.is-contextual
    | .node-clause(clause)
        = clause.op != .whenever-clause
= match tree.nodes[node]
    | .node-identifier
        true
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-binary-expression
        true
    | .node-cast-expression
        true
    | .node-index-expression
        true
    | .node-declare
        true
    | .node-block
        true
    | .node-if-block
        true
    | .node-break
        true
    | .node-continue
        true
    ??
        false

────────────────────
_ do keeps-assigned Bool
    - lhs SyntaxId
    - view SlotId
    - counter SlotId

do match? tree.nodes[lhs]
    | .node-get-expression(get)
        = facts.plan-of(instance, lhs) == .plan-view && is-counted-row(get.object, view, counter)
    | .node-identifier
        if names-slot(lhs, view) || names-slot(lhs, counter)
            = false
        = intrinsic-is-numeric(types.intrinsic-of(facts.node-type(instance, lhs)))
= false

────────────────────
_ do selection-reads U64
    - container SyntaxId
    - selection TypeId
    - body SyntaxId
    - clause SyntaxId
    - chained Bool

` How a loop over a selection of a table's rows reads its indices, as TypeScript's loop over
` rows decides from what its body and its clause may change: 1 where the indices are found
` again on each pass, and 2 where TypeScript leaves the loop to the selection's own iteration,
` or where what the body changes cannot be told. A name assigned or declared is changed, and
` so is each name in a place assigned, which may change indices; a call of a local may change
` a table or indices, and a call of a member each name its receiver and arguments are written
` with, and indices through a builder or an arena, or a table through a table that grows.
. blocked [Atom]
. effects = SelectionEffects()
scan-effects(body, blocked, effects)
if clause != 0
    scan-effects(clause, blocked, effects)
if chained || effects.unknown
    = 2
. roots [Atom]
. subject = subject-roots(container, roots)
. stable = types.intrinsic-of(selection) == .immutable-table-selection
. source-blocked = subject && roots.length != 0 && has-atom(blocked, roots[0])
if !stable && (source-blocked || effects.table || effects.selected-table)
    = 2
. again = effects.table || effects.indices
if subject
    for position in 1 .. < roots.length
        if roots[position] != roots[0] && has-atom(blocked, roots[position])
            again = true
= if again then 1 else 0

────────────────────
_ do has-atom Bool
    - names [Atom]
    - name Atom

` Whether a list of names holds a name.
for held in names
    if held == name
        = true
= false

────────────────────
_ do scan-effects
    - root SyntaxId
    - blocked [Atom]
    - effects SelectionEffects

` Notes what the nodes under a node may change, as TypeScript's loop over rows notes it.
for node in tree.subtree-start(root) .. < root + 1
    do match? tree.nodes[node]
        | .node-assign(row)
            do match tree.nodes[row.lhs]
                | .node-identifier(named)
                    blocked += named.name
                ??
                    block-names(row.lhs, blocked)
                    effects.indices = true
        | .node-call-expression(row)
            do match tree.nodes[row.callable]
                | .node-identifier
                    if bindings.resolution-of(frame.binding, row.callable).kind == .resolve-slot
                        effects.table = true
                        effects.indices = true
                ??
                    block-names(row.callable, blocked)
                    do match? tree.nodes[row.callable]
                        | .node-get-expression(get)
                            note-call-effect(get.object, effects)
            for operand in tree.children[row.operands]
                . expression = operand
                do match? tree.nodes[operand]
                    | .node-argument(argument)
                        expression = argument.expr
                block-names(expression, blocked)
                note-call-effect(expression, effects)
        | .node-declare(row)
            . named = pattern-name(types, tree, row.left)
            if named
                blocked += named

────────────────────
_ do block-names
    - root SyntaxId
    - blocked [Atom]

` Notes each name written under a node as changed.
for node in tree.subtree-start(root) .. < root + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            blocked += row.name

────────────────────
_ do note-call-effect
    - expression SyntaxId
    - effects SelectionEffects

` Notes what a call may change through a value it is given: indices through a builder or an
` arena, and a table through a table that grows. A value whose type is not known here leaves
` what the call changes unknown.
. type = facts.node-type(instance, expression)
if type == no-type || type == invalid-type
    effects.unknown = true
    =
. kind = types.intrinsic-of(type)
if kind == .array-builder || types.is-arena(type)
    effects.indices = true
if kind == .table
    effects.selected-table = true

────────────────────
_ do subject-roots Bool
    - expression SyntaxId
    - roots [Atom]

` The names a loop's container is read through, as TypeScript's flow facts root it: the name
` it is read from first, then those of the indices it is read at. False where it is not read
` from names alone, or from literal indices.
do match? tree.nodes[expression]
    | .node-identifier(row)
        roots += row.name
        = true
    | .node-get-expression(row)
        = subject-roots(row.object, roots)
    | .node-index-expression(row)
        if !subject-roots(row.object, roots)
            = false
        do match? tree.nodes[row.index]
            | .node-integer-syntax(literal)
                = literal.unit == null
            | .node-string-syntax
                = true
        = subject-roots(row.index, roots)
= false

────────────────────
_ do note-place
    - loop SyntaxId
    - written SyntaxId
    - container TypeId
    - plan OperatorPlan

` Plans a loop that counts or steps through a tuple or a struct as one that reads it where
` it is kept, where its container is written as such a place and is iterated as it is.
if container == no-type || container == invalid-type
    =
. kind = types.intrinsic-of(container)
if (kind != .tuple && kind != .struct) || facts.node-type(instance, written) != container
    =
place-base = 0
. shape = place-shape(written)
if shape != 0
    facts.set-loop-place(instance, loop, plan, if shape == 1 then place-base else U32.max)

────────────────────
_ do place-shape U32
    - node SyntaxId

` How the reference holds what an expression of a tuple or struct type gives: 0 as a value
` of its own, 1 by the address of where it is kept, and 2 in a way that has no shape here.
` A place is a local, an argument, a global or a stored property read by its name, and a
` stored field or property of one. A lazy local is a place where a flag says it has its
` value, and a value of its own where a read evaluates it. `place-base` is left as the
` object such a property is read from where that is no receiver: it is evaluated once.
do match? tree.nodes[node]
    | .node-identifier(row)
        . resolution = bindings.resolution-of(frame.binding, node)
        if resolution.kind == .resolve-global
            = 1
        if resolution.kind == .resolve-slot
            if bindings.slots[resolution.slot].kind != .slot-lazy
                = 1
            . policy = bindings.lazy-policy(resolution.slot)
            if policy == .lazy-inline || policy == .lazy-first-read
                = 0
            = if policy == .lazy-unsettled then 2 else 1
        if resolution.kind == .resolve-member
            = stored-shape(node, frame.self-type, row.name)
        = 0
    | .node-get-expression(row)
        if row.is-tracked || row.is-optional || row.is-loop
            = 2
        if facts.plan-of(instance, node) == .plan-view
            = 0
        . held = facts.node-type(instance, row.object)
        if held == no-type || held == invalid-type
            = 2
        . stored = stored-shape(node, held, row.name)
        if stored != 1
            = stored
        . kind = types.intrinsic-of(held)
        if kind == .tuple || kind == .struct
            = place-shape(row.object)
        if kind != .class
            = 2
        if !names-receiver(row.object)
            place-base = row.object
        = 1
    | .node-index-expression(row)
        if row.is-optional
            = 2
        if facts.plan-of(instance, node) != .plan-field
            = 0
        = place-shape(row.object)
    | .node-call-expression
        = 0
    | .node-tuple-syntax
        = 0
    | .node-range-expression
        = 0
    | .node-binary-expression
        = 0
    | .node-unary-expression
        = 0
    | .node-cast-expression
        = 0
    | .node-iterable-expression
        = 0
= 2

────────────────────
_ stored-shape U32
    - node SyntaxId
    - owner TypeId
    - name Atom

` How a property read by its name is held: where it is kept for one the owner stores, and
` as a value of its own for one a function answers.
|? found
    if types.properties[found].storage-kind == .storage-getter then 0 else 1
|? facts.first-call(instance, node) != no-fact
    0
??
    if facts.plan-of(instance, node) == .plan-field then 1 else 2

.. found = property-named(owner, name)

────────────────────
+ do demand-materialized
    - declaration CheckedDecl

` A member that runs on a row's case and reads its cells with no check runs on the case
` gathered from the row instead where it may move the row's storage before it reads the row
` again, as TypeScript's `table-row-receiver-materialized` function does. That function is the
` member's instance on the case itself. One that writes its receiver has none.
. own = instances.rows[instance]
if own.row-receiver == no-type || !own.row-validated || writes-receiver(declaration)
    =
. signature = instances.signatures[instance]
. param-count = signature.param-count
. start = signature.args.start - param-count
. mark = scratch.types.mark
for offset in 0 .. < param-count + signature.args.count
    scratch.types.push(instances.signature-types[start + offset])
. params = scratch.types.span(mark, param-count)
. args = scratch.types.span(mark + param-count, signature.args.count)
. materialized = instances.intern
    - own.module
    - own.decl
    - own.self-type
    - own.effects
    - own.enclosing
    - params
    - args
scratch.types.rewind(mark)
instances.rows[instance].materialized = materialized

────────────────────
_ do writes-receiver Bool
    - declaration CheckedDecl

` Whether a body may write its receiver: it assigns to a place reached from `this` or a
` member, calls a member of either, or holds a function of its own.
if declaration.body == 0
    = false
for node in tree.subtree-start(declaration.body) .. < declaration.body + 1
    do match? tree.nodes[node]
        | .node-function-syntax
            = true
        | .node-assign(row)
            if reaches-receiver(row.lhs)
                = true
        | .node-call-expression(row)
            if reaches-receiver(row.callable)
                = true
= false

────────────────────
_ do reaches-receiver Bool
    - node SyntaxId

` Whether a place or a callee is `this` or a member, or is reached from either.
. current = node
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, current)
            if resolution.kind == .resolve-member
                = true
            = resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-this
        | .node-get-expression(row)
            next = row.object
        | .node-index-expression(row)
            next = row.object
    current = next
= false

────────────────────
+ do names-receiver Bool
    - node SyntaxId

do match? tree.nodes[node]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, node)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == .slot-this
= false

────────────────────
_ do loop-take LoopTake
    - pattern SyntaxId
    - transformed Bool
    - matched Bool

` What a header does with its item, from the pattern it writes: the arms of a match, a
` pattern written as one, or one a declaration is written with.
if transformed
    = .take-arms
if names-whole(pattern)
    = .take-whole
if matched
    = .take-fitted
if has-arms(pattern)
    = .take-unshaped
do match? tree.nodes[pattern]
    | .node-type-tuple(row)
        if row.field-types.count != 0
            = .take-fields
    | .node-tuple-syntax(row)
        if row.items.count != 0
            = .take-fields
    | .node-type-capture(capture)
        if !reads-name(capture.type)
            = .take-converted
= .take-declared

────────────────────
_ names-whole Bool
    - pattern SyntaxId

` Whether a pattern of a loop is its item whole under a name, or is not written.
|? pattern == 0
    true
??
    match tree.nodes[pattern]
        | .node-identifier
            true
        | .node-type-capture(capture)
            capture.type == 0
        ??
            false

────────────────────
_ has-arms Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-or
        true
    | .node-type-transform
        true
    ??
        false

────────────────────
_ do match-item TypeId
    - id SyntaxId
    - arms SyntaxId
    - item TypeId

` A loop whose pattern is the arms of a match runs them on each item: `each` is what the arm an
` item matches gives, and an item no arm matches is passed over. The pattern is typed as what
` the arms give, for emission.
if item == invalid-type || item == no-type
    = invalid-type
. own-matching = matching
matching = matching.subject = item
matching = matching.optional = true
matching = matching.case = 0
. result = infer-arms(id, arms)
matching = own-matching
if result != no-type && result != invalid-type
    facts.set-node-type(instance, id, result)
= if types.is-optional(result) then types.optional-inner(result) else result

────────────────────
+ do plan-range-at
    - planned SyntaxId
    - item TypeId

` A loop at a node that heads none, over a range literal of whole numbers: it counts, with
` no range, and polls.
facts.set-plan(instance, planned, .plan-range-loop)
keep-loop(planned, item, item, types.bool-type)
note-poll()

────────────────────
+ do plan-iteration-at
    - planned SyntaxId
    - site SyntaxId
    - iterated TypeId
    - item TypeId
    - is-bullet Bool

` A loop at a node that heads none, over any other container: by the container's protocol,
` whose calls are kept at `site`, by its indexes where it has them, and polling.
note-container-iteration(site, iterated, is-bullet, planned)
if is-indexed(iterated, false)
    facts.set-plan(instance, planned, .plan-index-loop)
    if is-array-field(iterated, types.length-atom!)
        facts.set-constant(instance, planned, ConstantFact(1, 0, null, false), .plan-index-loop)
    keep-loop(planned, iterated, types.size-type, types.size-type)
keep-loop-item(planned, item)
note-poll()

────────────────────
+ do note-container-iteration
    - site SyntaxId
    - container TypeId
    - is-bullet Bool
    - planned SyntaxId

` The iteration protocol the reference's generic loop lowering calls on a container that is
` neither a range literal nor a table, by the first it finds of these: a generator begins,
` reads, and ends iterating; a cursor iterable reads its initial state and steps it, the step
` called as any call is, whose errors leave the function; and anything else iterable, a value
` of an interface or an object of a class of one, begins, reads, and ends iterating. The
` instances and the witnesses of their implementors follow. A class that delegates the
` interface to a property is iterated by what the property holds, whose items are converted
` to the interface's at the loop, as the `as` that delegates it asks. A type iterated by an
` interface must answer the functions the interface requires, as where it is made one.
` A multi bullet over a table also keeps the index cast of its counter at the bullet. The
` loop is planned at `planned`, the header of a loop or the bullet, where the slots of the
` loop are.
if container == invalid-type || container == no-type
    =
. cursor = iterable-item(container, types.cursor-iterable-decl) != no-type
. iterable = iterable-item(container, types.iterable-decl) != no-type
. generated = same-decl(class-ref(types, container), types.generator-decl)
if is-bullet && !cursor && !iterable && implements(container, types.indexable-decl)
    conversions.convert(site, site, types.size-type, types.index-type, .reason-argument)
if cursor && !generated
    . cursor-interface = interface-of(container, types.cursor-iterable-decl)
    if types.intrinsic-of(container) != .interface && cursor-interface != no-type
        conform-members(container, cursor-interface)
    . state = calls.protocol-getter(container, program.store-atom("initial-iterator-state"), site)
    if state != invalid-type
        calls.protocol-call(container, program.store-atom("next-iterator"), site, state, true)
        if planned != 0
            facts.set-plan(instance, planned, .plan-cursor-loop)
            keep-loop(planned, container, state)
    =
if generated || iterable
    . places [U32]
    . interface = if iterable && !generated then iterable-interface else no-type
        .. iterable-interface = interface-of(container, types.iterable-decl)
    if interface != no-type && types.intrinsic-of(container) != .interface
        conform-members(container, interface)
    . holder = if interface != no-type then calls.ranking.interface-holder(container, interface, places) else no-type
    . receiver = if holder != no-type then holder else container
    calls.keep-protocol-through(calls.protocol-call(receiver, program.store-atom("begin-iterating"), site).fact, places)
    . read-call = calls.protocol-call(receiver, program.store-atom("<-read"), site, no-type, true)
    calls.keep-protocol-through(read-call.fact, places)
    . read = read-call.answer
    calls.keep-protocol-through(calls.protocol-call(receiver, program.store-atom("end-iterating"), site).fact, places)
    . item = if holder != no-type then first-arg(interface) else no-type
    if item != no-type && read != invalid-type && types.is-optional(read) && other-item
        conversions.convert
            - site
            - site
            - types.optional-inner(read)
            - item
            - .reason-element
            - true
            - places.length != 0
    .. other-item = types.optional-inner(read) != item
    if planned != 0
        facts.set-plan(instance, planned, .plan-stream-loop)
        keep-loop(planned, container)

────────────────────
+ is-indexed Bool
    - container TypeId
    - through-call Bool

` Whether a loop over a container counts through its indexes, as `loop-item-type` found its
` item: the container is neither kind of iterable, and no table the loop reads by its rows.
|? container == invalid-type || container == no-type
    false
|? iterable-item(container, types.cursor-iterable-decl) != no-type
    false
|? plain-iterable || !implements(container, types.indexable-decl)
    false
??
    through-call || !is-table-container(types.intrinsic-of(container))

.. plain-iterable = iterable-item(container, types.iterable-decl) != no-type

────────────────────
+ do keep-loop
    - loop SyntaxId
    - first TypeId
    - second TypeId = no-type
    - third TypeId = no-type

` Types what a loop keeps from one pass to the next, in the slots the binder declared for
` its header: for a range its index, its end and whether it counts down; for a container
` the container, and then its length and the count of items read, or the state of its
` cursor.
. slot = bindings.loop-state(frame.binding, loop)
if slot == no-slot
    =
frame.assign(slot, first)
if second != no-type
    frame.assign(slot + 1, second)
if third != no-type
    frame.assign(slot + 2, third)

────────────────────
_ do keep-loop-given
    - loop SyntaxId
    - container TypeId

` Types the slot after a loop's item, which the binder declared for a header given its
` container: there the loop of a comprehension over the rows of a table keeps the container
` until the loop begins and finds its rows, as TypeScript's loop over its argument does.
. slot = bindings.loop-state(frame.binding, loop)
if slot != no-slot
    frame.assign(slot + loop-state-count, container)

────────────────────
+ do keep-loop-item
    - loop SyntaxId
    - item TypeId

` Types the last of a loop's slots, which keeps the item of the pass.
. slot = bindings.loop-state(frame.binding, loop)
if slot != no-slot && item != no-type && item != invalid-type
    frame.assign(slot + loop-state-count - 1, item)

────────────────────
_ do next-clause SyntaxId
    - clause SyntaxId

` The clause written after a clause, or none.
do match? tree.nodes[clause]
    | .node-clause(row)
        = row.next
= 0

────────────────────
_ do check-clause
    - id SyntaxId
    - body SyntaxId

` A clause is tested as a condition. It holds wherever the loop's body runs, so what it tests
` is narrowed there.
do match? tree.nodes[id]
    | .node-clause(row)
        if row.op != .whenever-clause
            note-truthiness(row.expr, row.expr, infer-tested(row.expr))
        do match? row.op
            | .when-clause
                narrowing.narrow-condition(row.expr, true)
            | .while-clause
                narrowing.narrow-condition(row.expr, true)
            | .until-clause
                narrowing.narrow-condition(row.expr, false)
        if row.next != 0
            check-clause(row.next, body)

────────────────────
_ do assign-loop-slots
    - loop SyntaxId
    - item TypeId
    - wrap Bool

` `it` and `each` are the optional item under a pattern and the item itself without one, as
` the reference's loop lowering defines them; under a pattern written as a match they are
` the item as the pattern fitted it. The loop's header resolves to the first of the two the
` binder declared for it, and the other follows it.
. wrapped = if wrap && item != invalid-type then types.optional-of(item) else item
. first = bindings.resolution-of(frame.binding, loop)
if first.kind != .resolve-slot
    =
. bound = bindings.bindings[frame.binding]
. slot = first.slot
while slot < bound.slots.start + bound.slots.count
    . row = bindings.slots[slot]
    if (row.kind != .slot-it && row.kind != .slot-each) || row.syntax != loop
        =
    frame.assign(slot, wrapped)
    slot += 1

────────────────────
+ do stated-item TypeId
    - pattern SyntaxId

` The type a loop's pattern states for its item, when it states one and names no value.
if pattern != 0
    do match? tree.nodes[pattern]
        | .node-type-capture(row)
            if row.type != 0 && !reads-name(row.type)
                = types.evaluate-type(module, tree, row.type, frame.env)
= no-type

────────────────────
+ do loop-container LoopContainer
    - syntax SyntaxId
    - simple Bool = true
    - stated TypeId = no-type

` The container of a loop's header, typed. A range written there whose sides are integers
` written with no suffix is of the integer type the header's pattern states.
do match? tree.nodes[syntax]
    | .node-range-expression(row)
        if row.increment == 0
            . item = range-item(syntax, row.left, row.right, 0, stated)
            if item == invalid-type
                = LoopContainer(invalid-type, no-type)
            if is-integer(item) && simple
                . mark = scratch.types.mark
                scratch.types.push(item)
                . range = types.class-named-with-args(module, types.range-atom!, mark)
                facts.set-node-type(instance, syntax, range)
                = LoopContainer(range, item)
            . constructed = range-construction(syntax, row.op, item, row.left, row.right, 0)
            if constructed != no-type
                facts.set-node-type(instance, syntax, constructed)
            = LoopContainer(constructed, no-type)
= LoopContainer(infer(syntax), no-type)

────────────────────
_ is-simple-loop-pattern Bool
    - pattern SyntaxId

|? pattern == 0
    true
??
    match tree.nodes[pattern]
        | .node-identifier
            true
        | .node-type-capture(capture)
            capture.type == 0
        ??
            false

────────────────────
+ do iteration-container TypeId
    - container TypeId
    - site SyntaxId

` A container that is not iterable itself is iterated as the first iterable type it declares a
` conversion to, in the reference's order of iteration protocols.
if container == invalid-type || container == no-type
    = container
if interface-of(container, types.cursor-iterable-decl) != no-type
    = container
if interface-of(container, types.iterable-decl) != no-type
    = container
if implements(container, types.indexable-decl)
    = container
. converted = converted-iterable(container, types.generator-decl)
if converted == no-type
    converted = converted-iterable(container, types.cursor-iterable-decl)
if converted == no-type
    converted = converted-iterable(container, types.iterable-decl)
if converted == no-type
    converted = converted-iterable(container, types.indexable-decl)
if converted == no-type
    converted = converted-iterable(container, types.stream-decl)
if converted == no-type
    = container
= conversions.convert(site, site, container, converted, .reason-operand)

────────────────────
_ converted-iterable TypeId
    - container TypeId
    - protocol DeclRef

relations.converted-class(container, protocol.module, protocol.decl)

────────────────────
+ do loop-item-type TypeId
    - container TypeId
    - site SyntaxId
    - through-call Bool = false

if container == invalid-type || container == no-type
    = invalid-type
. container-kind = types.intrinsic-of(container)
. streamed = iterable-item(container, types.cursor-iterable-decl)
if streamed != no-type && container-kind == .interface
    . cursor = interface-of(container, types.cursor-iterable-decl)
    note-iterator-witness(cursor, program.store-atom("initial-iterator-state"), .getter-decl)
    note-iterator-witness(cursor, program.store-atom("next-iterator"), .function-decl)
if streamed == no-type
    streamed = iterable-item(container, types.iterable-decl)
if streamed != no-type
    = streamed
if implements(container, types.indexable-decl)
    if !is-array-field(container, types.length-atom!)
        calls.demand-getter(container, types.length-atom!, site)
    if is-table-container(container-kind) && !through-call
        = calls.index-item-type(container)
    = calls.index-item(container, site)
= invalid-type

────────────────────
_ do slice-through-call Bool
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-index-expression
        . fact = facts.first-call(instance, syntax)
        if fact == no-fact
            = false
        . callee = facts.calls[fact].callee
        if callee == no-instance
            = false
        = instances.rows[callee].module != types.table-module
= false

────────────────────
_ counts-rows Bool
    - container TypeId

` Whether a loop over a container counts through the rows of a table, of a span of one or of
` a selection of them, as TypeScript does by the container's type alone, rather than through a
` method of it. Its rows are structs or unions.
|? !is-column-receiver(kind) && !selects
    false
??
    row == .struct || row == .union

.. kind = types.intrinsic-of(container)
.. selects = kind == .table-selection || kind == .immutable-table-selection
.. row = types.intrinsic-of(row-struct-of(container))

────────────────────
_ counts-indices Bool
    - container TypeId
    - syntax SyntaxId

` Whether a loop over a container counts through the indices of an index span, as
` TypeScript's loop over what is indexable does, by its length and its `[]`.
types.intrinsic-of(container) == .index-span && !slice-through-call(syntax)

────────────────────
+ is-index-reader Bool
    - kind IntrinsicKind

` Whether a value reads indices: an index span, or a selection of a table's rows by one.
kind == .index-span || kind == .table-selection || kind == .immutable-table-selection

────────────────────
_ is-table-container Bool
    - kind IntrinsicKind

table || spans || .immutable-table-selection == kind || .index-span == kind

.. table = kind == .table || kind == .immutable-table
.. spans = kind == .table-span || kind == .immutable-table-span

────────────────────
_ do note-iterator-witness
    - interface TypeId
    - name Atom
    - kind DeclKind

. ref = class-ref(types, interface)
if ref.module == 0 && ref.decl == 0
    =
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
for member in owner-module.members-named(members, name)
    do match? owner-module.decls[member]
        | .decl-function(fn)
            if fn.kind == kind && fn.name && fn.name == name
                facts.record-witness-func(interface, ref.module, member)
                =
for parent in types.interfaces-of(interface)
    note-iterator-witness(parent, name, kind)
