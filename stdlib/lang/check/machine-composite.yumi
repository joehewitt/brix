./facts
./instances
/lang/ast/ast
/lang/ast/ast-nodes
/lang/ast/module
/lang/ast/program
/lang/ast/state-machines

━━━━━━━━━━━━━━━━━━━━
+ MachineComposite

` The machine of a property of a class merged with the refinements of it, as the reference merges
` them (`mergeStateMachineRefinement`): its `pieces`, the machine none refines first, then each
` refinement from the base's down to one piece, each typed for the class that declares it, so
` that every class below shares it; and their cases. The cases each piece adds come after those
` of the pieces before it, so a case has the same place in the composite of every piece below
` the one that adds it; among those of one piece, each comes before those written in it. Each
` case has the case it is written in, or none at the root, the piece that writes it, and the
` node each piece names it at, or none, `pieces.length` to a case in `nodes`.

+ pieces [MachineFact]
+ names [Atom]
+ parents [U32]
+ owners [U32]
+ nodes [SyntaxId]

────────────────────
+ This
    - merged [MachineFact]

.. pieces = merged

────────────────────
+ do case-named U32
    - name Atom

` The case of a name, or none.
for place in 0 .. < names.length
    if names[place] == name
        = place as U32
= U32.max

────────────────────
+ node SyntaxId
    - case U32
    - piece U32

` The node a piece names a case at, or none.
nodes[(case as Size) * pieces.length + (piece as Size)]

────────────────────
+ children [U32]
    - case U32

` The cases written in a case, or at the root for none, in order.
each as U32 in 0 .. < parents.length when parents[each] == case

────────────────────
+ do descendants [U32]
    - case U32

` The cases written in a case, or at the root for none, and in the cases written there, each
` before those written in it.
. found [U32]
for child in children(case)
    found += child
    for inner in descendants(child)
        found += inner
= found

────────────────────
+ do path-to [U32]
    - case U32

` The cases from the root down to a case, the case last.
. found [U32]
. current = case
while current != U32.max
    found.insert(current, 0)
    current = parents[current]
= found

────────────────────
+ do piece-of U32
    - instance InstanceId

` The place of the piece an instance types, or none.
for place in 0 .. < pieces.length
    if pieces[place].instance == instance
        = place as U32
= U32.max

━━━━━━━━━━━━━━━━━━━━
+ do compose-machine MachineComposite?
    - program Program
    - facts Facts
    - machine MachineFact

` The composite of a machine of a property of a class and each machine it refines, up to the one
` none refines, which is the machine's last piece; or none where it refines none and none
` refines it.
if machine.outer != 0
    = null
. pieces [MachineFact]
. current MachineFact? = machine
while current
    pieces.insert(current, 0)
    current = facts.machine-of(current.refined) if current.refined != no-instance
if pieces.length == 1 && !refined-by(facts, machine)
    = null
. composite = MachineComposite(pieces)
. above [SyntaxId]
for piece in pieces
    above += piece.syntax
add-composite-level(program, composite, U32.max, above)
order-by-piece(composite)
= composite

━━━━━━━━━━━━━━━━━━━━
+ do refined-by Bool
    - facts Facts
    - machine MachineFact

` Whether a machine of a property of a class is refined by another.
for fact in facts.machines
    if fact.refined == machine.instance && fact.outer == 0
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do order-by-piece
    - composite MachineComposite

` Places the cases of a composite by the piece that writes them, each piece's in the order they
` were found.
. count = composite.pieces.length
. order [U32]
for piece in 0 .. < count
    for place in 0 .. < composite.names.length
        if composite.owners[place] == piece as U32
            order += place as U32
. moved [U32]
for _ in 0 .. < composite.names.length
    moved += 0
for place in 0 .. < order.length
    moved[order[place] as Size] = place as U32
. names [Atom]
. parents [U32]
. owners [U32]
. nodes [SyntaxId]
for place in order
    names += composite.names[place]
    . parent = composite.parents[place]
    parents += if parent == U32.max then U32.max else moved[parent as Size]
    owners += composite.owners[place]
    for piece in 0 .. < count
        nodes += composite.nodes[(place as Size) * count + piece]
composite.names = names
composite.parents = parents
composite.owners = owners
composite.nodes = nodes

━━━━━━━━━━━━━━━━━━━━
_ do add-composite-level
    - program Program
    - composite MachineComposite
    - parent U32
    - above [SyntaxId]

` Adds the cases written in a case, or at the root, by the node each piece names it at: those
` the first piece that writes the case writes, then those each piece after it adds, each followed
` by the cases written in it.
. count = composite.pieces.length
. names [Atom]
. owners [U32]
. found [SyntaxId]
for piece in 0 .. < count
    if above[piece] == 0
        continue
    . tree = program.modules[composite.pieces[piece].module].tree
    for child in tree.child-cases(tree.state-items(tree.state-body(above[piece])))
        . name = tree.state-name(child)!
        . known = names.find(name)
        if known == null
            names += name
            owners += piece as U32
            for _ in 0 .. < count
                found += 0
            found[(names.length - 1) * count + piece] = child
        else
            found[known * count + piece] = child
for position in 0 .. < names.length
    . place = composite.names.length as U32
    composite.names += names[position]
    composite.parents += parent
    composite.owners += owners[position]
    . below [SyntaxId]
    for piece in 0 .. < count
        composite.nodes += found[position * count + piece]
        below += found[position * count + piece]
    add-composite-level(program, composite, place, below)

