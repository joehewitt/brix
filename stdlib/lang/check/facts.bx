    ; Adds to `cells` the state cells a link of `scope-links` holds, the outermost first.
    (if (== link (. U32 max))
      (return)
    )
    (call link-cells (. ([] scope-links link) outer) cells)
    (+= cells (. ([] scope-links link) cell))
