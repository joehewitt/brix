      (call (. style-projections pop))
    )
    (call (. projection-tags clear))
    (for (in tag tags)
      (+= projection-tags tag)
    )
    (for (in position (..< 0 (. style-declarations length)))
      (let projection (. ([] style-declarations position) projection))
      (if (< projection (- (. U32 max) 1))
        (= (. ([] style-declarations position) projection) ([] places projection))
      )
    )
    (for (in position (..< 0 (. rule-slots length)))
      (let projection (. ([] rule-slots position) projection))
      (if (< projection (- (. U32 max) 1))
        (= (. ([] rule-slots position) projection) ([] places projection))
      )
    )
  )
  (fn-expr _ applies-live Bool
    (param retired (list Bool))
    (param dead InstanceId)
    (param application U32)
    ; Whether an application of a style rule is made by an instance an edit neither retires nor has
    ; retired before, so the slots and values its lines take stand.
    (or (>= (as application Size) (. style-applications length)) applier-live)
    (where
      (lazy applier-live (call live retired dead (. ([] style-applications application) instance)))
    )
  )
  (fn-do _ place-theme-reads _
    (call (. theme-read-places clear))
    (for (in position (..< 0 (. theme-reads length)))
      (let row ([] theme-reads position))
      (= ([] theme-read-places (/or/ (/lshift/ (as (. row instance) Size) 32) read-site)) (as position U32))
      (lazy read-site (as (. row site) Size))
    )
  )
  (fn-do _ place-rule-rows _
    (call (. rule-slot-places clear))
    (for (in position (..< 0 (. rule-slots length)))
      (let row ([] rule-slots position))
      (= ([] rule-slot-places (/or/ (/lshift/ (as (. row application) Size) 32) slot-site)) (as position U32))
      (lazy slot-site (as (. row site) Size))
    )
    (call (. rule-theme-places clear))
    (for (in position (..< 0 (. rule-themes length)))
      (let row ([] rule-themes position))
      (= ([] rule-theme-places (/or/ (/lshift/ (as (. row application) Size) 32) theme-site)) (as position U32))
      (lazy theme-site (as (. row site) Size))
    )
  )
  (fn-do _ (of purge-placed Value) _
    (param map (of Map Size Value ArenaBacking))
    (param retired (list Bool))
    (param shift Size)
    (let gone (list Size))
    (for (in (tuple key _) map)
      (if (call held-by retired (as (/rshift/ key shift) InstanceId))
        (+= gone key)
      )
    )
    (for (in key gone)
      (-= ([] map key))
    )
  )
  (fn-do + move-syntax (? String)
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param instances Instances)
    (param retired (list Bool))
    (param dead InstanceId)
    ; Moves the nodes of an edited module that facts name to where the edit puts them, as `moved`
    ; maps them. An edit typed in place leaves the nodes outside the bodies it changes as they were,
    ; but numbers them anew where it adds or removes nodes before them, and instances of other modules
    ; it does not retire name them: the rules and `when`s of styles they apply, the markup and
    ; sections of classes they make, and where they enter a zone. So do the state machines of
    ; instances it retires, which stand for them until they are typed again (`replace-machines`), as
    ; refinements typed again find them. Gives why an edit cannot be typed in place where an instance
    ; it does not retire names a node of a body it changes, or nothing.
    (return-if "moved cells" (if (call moves-cells module moved instances retired dead)))
    (return-if "moved applications" (if (call moves-applications module moved instances retired dead)))
    (blank)
    (for (in position (..< 0 (. style-users length)))
      (if (== (. ([] style-users position) module) module)
        (return-if "moved users" (if (and user-live (call unmoved moved (. ([] style-users position) site)))))
        (blank)
        (lazy user-live (call live retired dead (. ([] style-users position) instance)))
        (= (. ([] style-users position) site) (call moved-node moved (. ([] style-users position) site)))
      )
    )
    (for (in position (..< 0 (. style-static-values length)))
      (if (== (. ([] style-static-values position) module) module)
        (return-if "moved values" (if (and value-live (call unmoved moved (. ([] style-static-values position) site)))))
        (blank)
        (lazy value-live (call live retired dead (. ([] style-static-values position) instance)))
        (= (. ([] style-static-values position) site) (call moved-node moved (. ([] style-static-values position) site)))
      )
    )
    (return? (call move-domain-users domain-users module moved retired dead))
    (return? (call move-domain-users domain-places module moved retired dead))
    (blank)
    (for (in position (..< 0 (. style-sites length)))
      (if (== (. ([] style-sites position) module) module)
        (return-if "moved sites" (if (and site-live (call unmoved moved (. ([] style-sites position) site)))))
        (blank)
        (lazy site-live (call live retired dead (. ([] style-sites position) instance)))
        (= (. ([] style-sites position) site) (call moved-node moved (. ([] style-sites position) site)))
      )
    )
    (for (in position (..< 0 (. style-applications length)))
      (let row (as ([] style-applications position) StyleApplication))
      (if (== (. row module) module)
        (= (. ([] style-applications position) site) (call moved-node moved (. row site)))
        (= (. ([] style-applications position) written) (call moved-node moved (. row written)))
      )
      (if (and (!= (. row outer) (. U32 max)) (== (. ([] (. instances rows) (. ([] style-applications (. row outer)) unit)) module) module))
        (= (. ([] style-applications position) within) (call moved-node moved (. row within)))
      )
    )
    (for (in position (..< 0 (. style-gate-whens length)))
      (if (== (. ([] style-gate-whens position) module) module)
        (= (. ([] style-gate-whens position) syntax) (call moved-node moved (. ([] style-gate-whens position) syntax)))
      )
    )
    (for (in position (..< 0 (. scope-cells length)))
      (let row (as ([] scope-cells position) ScopeCell))
      (if (== (. row module) module)
        (= (. ([] scope-cells position) when) (call moved-node moved (. row when)))
      )
      (if (and (!= (. row instance) no-instance) (== (. ([] (. instances rows) (. row instance)) module) module))
        (= (. ([] scope-cells position) site) (call moved-node moved (. row site)))
      )
    )
    (for (in position (..< 0 (. scope-values length)))
      (if (== (. ([] scope-values position) module) module)
        (return-if "moved scope values" (if (and scope-live (call unmoved moved (. ([] scope-values position) site)))))
        (blank)
        (lazy scope-live (call live retired dead (. ([] scope-values position) instance)))
        (= (. ([] scope-values position) site) (call moved-node moved (. ([] scope-values position) site)))
      )
    )
    (for (in position (..< 0 (. typed-sections length)))
      (if (== (. ([] typed-sections position) module) module)
        (return-if "moved sections" (if (and section-live (call unmoved moved (. ([] typed-sections position) syntax)))))
        (blank)
        (lazy section-live (call live retired dead (. ([] typed-sections position) instance)))
        (= (. ([] typed-sections position) syntax) (call moved-node moved (. ([] typed-sections position) syntax)))
      )
    )
    (for (in position (..< 0 (. markup-queries length)))
      (if (== (. ([] markup-queries position) module) module)
        (= (. ([] markup-queries position) site) (call moved-node moved (. ([] markup-queries position) site)))
      )
    )
    (for (in position (..< 0 (. event-clauses length)))
      (if (== (. ([] event-clauses position) module) module)
        (= (. ([] event-clauses position) loop) (call moved-node moved (. ([] event-clauses position) loop)))
      )
    )
    (for (in position (..< 0 (. lowered-handlers length)))
      (if (== (. ([] lowered-handlers position) module) module)
        (= (. ([] lowered-handlers position) syntax) (call moved-node moved (. ([] lowered-handlers position) syntax)))
      )
    )
    (call move-sections subscribed-sections module moved)
    (call move-sections lowered-sections module moved)
    (call move-sections rebinding-sections module moved)
    (for (in position (..< 0 (. machines length)))
      (let row (as ([] machines position) MachineFact))
      (if (== (. row module) module)
        (= (. row syntax) (call moved-node moved (. row syntax)))
        (= (. row outer) (call moved-node moved (. row outer)))
        (= (. row parent) (call moved-node moved (. row parent)))
        (= ([] machines position) row)
        (for (in group (..< (. row groups start) (+ (. row groups start) (. row groups count))))
          (let held (as ([] machine-groups group) MachineGroup))
          (= (. held head) (call moved-node moved (. held head)))
          (= (. held owner) (call moved-node moved (. held owner)))
          (= ([] machine-groups group) held)
        )
      )
    )
    (for (in position (..< 0 (. early-unions length)))
      (if (== (. ([] early-unions position) module) module)
        (= (. ([] early-unions position) syntax) (call moved-node moved (. ([] early-unions position) syntax)))
      )
    )
    (for (in position (..< 0 (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (== (. row module) module)
        (= (. ([] diagnostics position) syntax) (call moved-node moved (. row syntax)))
      )
      (if (== (. row related-module) module)
        (return-if "moved diagnostics" (if (and diagnostic-live (call unmoved moved (. row related-syntax)))))
        (blank)
        (lazy diagnostic-live (call live retired dead (. row instance)))
        (= (. ([] diagnostics position) related-syntax) (call moved-node moved (. row related-syntax)))
      )
    )
    (return? (call move-themes module moved instances retired dead))
    (return null)
  )
  (fn-do _ move-themes (? String)
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param instances Instances)
    (param retired (list Bool))
    (param dead InstanceId)
    ; Moves the nodes of an edited module that the slots of style sheets read there, the lines of
    ; style rules applied with slots and the values evaluated from slots name. The reads and rule
    ; lines of the instances an edit retires are gone (`retire`). A value whose line the edit changes
    ; is left to the dead instance, unless an instance the edit does not retire evaluates it. Gives why
    ; an edit cannot be typed in place, or nothing.
    (for (in position (..< 0 (. theme-reads length)))
      (let row ([] theme-reads position))
      (if (== (. row module) module)
        (return-if "moved theme reads" (if (call unmoved moved (. row site))))
        (blank)
        (= (. ([] theme-reads position) site) (call moved-node moved (. row site)))
      )
    )
    (for (in position (..< 0 (. rule-slots length)))
      (let row ([] rule-slots position))
      (if (== (call rule-module (. row application) instances) module)
        (return-if "moved rule slots" (if (call unmoved moved (. row site))))
        (blank)
        (= (. ([] rule-slots position) site) (call moved-node moved (. row site)))
      )
    )
    (for (in position (..< 0 (. rule-themes length)))
      (let row ([] rule-themes position))
      (if (== (call rule-module (. row application) instances) module)
        (return-if "moved rule themes" (if (call unmoved moved (. row site))))
        (blank)
        (= (. ([] rule-themes position) site) (call moved-node moved (. row site)))
      )
    )
    (call place-theme-reads)
    (call place-rule-rows)
    (let referenced (? (list Bool)) null)
    (for (in position (..< 0 (. style-themed-values length)))
      (let row ([] style-themed-values position))
      (if (or (!= (. row module) module) (== (. row instance) dead))
        (continue)
      )
      (if (not (call unmoved moved (. row site)))
        (= (. ([] style-themed-values position) site) (call moved-node moved (. row site)))
        (continue)
      )
      (return-if "moved themed values" (if (call live retired dead (. row instance))))
      (blank)
      (if (not referenced)
        (= referenced (call themed-references retired dead))
      )
      (return-if "moved themed values" (if ([] referenced position)))
      (blank)
      (= (. ([] style-themed-values position) instance) dead)
      (= (. ([] style-themed-values position) site) 0)
    )
    (return null)
  )
  (fn-expr _ rule-module ModuleId
    (param application U32)
    (param instances Instances)
    ; The module that writes the lines of the rule an application of a style rule applies.
    (if-expr (>= (as application Size) (. style-applications length)) (as (. U32 max) ModuleId) unit-module)
    (where
      (lazy unit-module (. ([] (. instances rows) (. ([] style-applications application) unit)) module))
    )
  )
  (fn-do _ themed-references (list Bool)
    (param retired (list Bool))
    (param dead InstanceId)
    ; Which values evaluated from slots of style sheets a declaration or an applied rule line of an
    ; instance an edit does not retire evaluates.
    (let referenced (list Bool))
    (for (in _ (..< 0 (. style-themed-values length)))
      (+= referenced false)
    )
    (for (in row style-declarations)
      (if (and (!= (. row themed) (. U32 max)) (call live retired dead (. row instance)))
        (= ([] referenced (. row themed)) true)
      )
    )
    (for (in row rule-themes)
      (if (and (!= (. row themed) (. U32 max)) (call applies-live retired dead (. row application)))
        (= ([] referenced (. row themed)) true)
      )
    )
    (return referenced)
  )
  (fn-do + unmoved-namers (list InstanceId)
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param instances Instances)
    ; The instances whose facts name a node of a body an edit to a module changes, as `moved` maps
    ; them: those of other modules typed in a context the module's markup gives, such as the
    ; constructor of a class an element makes, whose state cells are made at the element. Retired
    ; with the module's own, they are typed again in the edited one.
    (let found (list InstanceId))
    (for (in row scope-cells)
      (if (or (and (== (. row module) module) (call unmoved moved (. row when))) (and known-key unmoved-key))
        (+= found (. row instance))
      )
      (lazy known-key (< (as (. row key) Size) (. instances state-keys length)))
      (lazy unmoved-key (call key-unmoved ([] (. instances state-keys) (. row key)) module moved))
    )
    (for (in row style-applications)
      (if (and (== (. row module) module) (or (call unmoved moved (. row site)) (call unmoved moved (. row written))))
        (+= found (. row instance))
        (else-if (and (!= (. row outer) (. U32 max)) outer-in-module (call unmoved moved (. row within)))
          (+= found (. row instance))
        )
      )
      (lazy outer-in-module (== (. ([] (. instances rows) (. ([] style-applications (. row outer)) unit)) module) module))
    )
    (for (in row style-users)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row style-static-values)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row style-sites)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row scope-values)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row typed-sections)
      (if (and (== (. row module) module) (call unmoved moved (. row syntax)))
        (+= found (. row instance))
      )
    )
    (for (in row domain-users)
      (if (or (and (== (. row module) module) (call unmoved moved (. row site))) line-unmoved)
        (+= found (. row instance))
      )
      (lazy line-unmoved (and (== (. row line-module) module) (call unmoved moved (. row line))))
    )
    (for (in row diagnostics)
      (if (and (== (. row related-module) module) (call unmoved moved (. row related-syntax)))
        (+= found (. row instance))
      )
    )
    (for (in row theme-reads)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row rule-slots)
      (if (and (== (call rule-module (. row application) instances) module) (call unmoved moved (. row site)))
        (+= found (. ([] style-applications (. row application)) instance))
      )
    )
    (for (in row rule-themes)
      (if (and (== (call rule-module (. row application) instances) module) (call unmoved moved (. row site)))
        (+= found (. ([] style-applications (. row application)) instance))
      )
    )
    (for (in row style-themed-values)
      (if (and (== (. row module) module) (call unmoved moved (. row site)))
        (+= found (. row instance))
      )
    )
    (for (in row style-declarations)
      (if (and (!= (. row themed) (. U32 max)) (< (as (. row themed) Size) (. style-themed-values length)))
        (let value ([] style-themed-values (. row themed)))
        (if (and (== (. value module) module) (call unmoved moved (. value site)))
          (+= found (. row instance))
        )
      )
    )
    (return found)
  )
  (fn-do _ moves-cells Bool
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param instances Instances)
    (param retired (list Bool))
    (param dead InstanceId)
    ; Whether a state cell an edit does not retire names a node of a body the edit changes: its
    ; `when`, its site, or where it is made.
    (for (in row scope-cells)
      (if (call live retired dead (. row instance))
        (return-if true (if (and (== (. row module) module) (call unmoved moved (. row when)))))
        (return-if true (if (and (!= (. row instance) no-instance) in-module (call unmoved moved (. row site)))))
        (blank)
        (lazy in-module (== (. ([] (. instances rows) (. row instance)) module) module))
        (return-if true (if (and (< (as (. row key) Size) (. instances state-keys length)) unmoved-key)))
        (blank)
        (lazy unmoved-key (call key-unmoved ([] (. instances state-keys) (. row key)) module moved))
      )
    )
    (return false)
  )
  (fn-expr _ key-unmoved Bool
    (param key StateKey)
    (param module ModuleId)
    (param moved (list SyntaxId))
    (or site-unmoved (and (== (. key when-module) module) (call unmoved moved (. key when))))
    (where
      (lazy site-unmoved (and (== (. key module) module) (call unmoved moved (. key site))))
    )
  )
  (fn-do _ moves-applications Bool
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param instances Instances)
    (param retired (list Bool))
    (param dead InstanceId)
    ; Whether a style rule applied by an instance an edit does not retire names a node of a body the
    ; edit changes: its site, the values written for it, or the `when` of the rule around it.
    (for (in row style-applications)
      (if (call live retired dead (. row instance))
        (return-if true (if (and (== (. row module) module) (or (call unmoved moved (. row site)) (call unmoved moved (. row written))))))
        (return-if true (if (and (!= (. row outer) (. U32 max)) outer-in-module (call unmoved moved (. row within)))))
        (blank)
        (lazy outer-in-module (== (. ([] (. instances rows) (. ([] style-applications (. row outer)) unit)) module) module))
      )
    )
    (return false)
  )
  (fn-expr _ live Bool
    (param retired (list Bool))
    (param dead InstanceId)
    (param instance InstanceId)
    (and (!= instance dead) (not (call held-by retired instance)))
  )
  (fn-do _ move-domain-users (? String)
    (param users (of List DomainUser ArenaBacking))
    (param module ModuleId)
    (param moved (list SyntaxId))
    (param retired (list Bool))
    (param dead InstanceId)
    (for (in position (..< 0 (. users length)))
      (let row (as ([] users position) DomainUser))
      (if (== (. row module) module)
        (return-if "moved domains" (if (and site-kept (call unmoved moved (. row site)))))
        (blank)
        (lazy site-kept (and (call live retired dead (. row instance)) (!= (. row instance) no-instance)))
        (= (. ([] users position) site) (call moved-node moved (. row site)))
      )
      (if (== (. row line-module) module)
        (return-if "moved domains" (if (and line-kept (call unmoved moved (. row line)))))
        (blank)
        (lazy line-kept (and (call live retired dead (. row instance)) (!= (. row instance) no-instance)))
        (= (. ([] users position) line) (call moved-node moved (. row line)))
      )
    )
    (return null)
  )
  (fn-do _ move-sections _
    (param refs (of List SectionRef ArenaBacking))
    (param module ModuleId)
    (param moved (list SyntaxId))
    (for (in position (..< 0 (. refs length)))
      (if (== (. ([] refs position) module) module)
        (= (. ([] refs position) syntax) (call moved-node moved (. ([] refs position) syntax)))
      )
    )
  )
  (fn-expr _ held-by Bool
    (param retired (list Bool))
    (param instance InstanceId)
    (and (< (as instance Size) (. retired length)) ([] retired instance))
  )
  (fn-do + replace-machines (? String)
    (param retired (list Bool))
    (param machine-count Size)
    (param union-count Size)
    ; Removes the state machines that instances an edit retired had typed, from the first
    ; `machine-count`, with their groups of event transitions, and the unions they made early, from
    ; the first `union-count`, once typing those instances again has made them anew. Until then they
    ; stand for them, as typing found them before the edit. Gives why the edit cannot be kept where
    ; an instance makes other machines or another union for one.
    (for (in position (..< 0 machine-count))
      (let old (as ([] machines position) MachineFact))
      (if (call held-by retired (. old instance))
        (let rank (call machines-of (. old instance) 0 position))
        (let made (call machine-place (. old instance) machine-count rank))
        (return-if (str "machine " (. old instance)) (if (or (== made (. U32 max)) (!= (. ([] machines made) union) (. old union)))))
        (blank)
        (if (== rank 0)
          (let typed (call machines-of (. old instance) 0 machine-count))
          (return-if (str "machines " (. old instance)) (if (!= retyped typed)))
          (blank)
          (lazy retyped (call machines-of (. old instance) machine-count (. machines length)))
        )
      )
    )
    (let kept Size 0)
    (let grouped Size 0)
    (for (in position (..< 0 (. machines length)))
      (let row (as ([] machines position) MachineFact))
      (if (and (< position machine-count) (call held-by retired (. row instance)))
        (continue)
      )
      (let start grouped)
      (for (in group (..< (. row groups start) (+ (. row groups start) (. row groups count))))
        (= ([] machine-groups grouped) (as ([] machine-groups group) MachineGroup))
        (+= grouped 1)
      )
      (= (. row groups) (call (of RowRange MachineGroup) (as start U32) (. row groups count)))
      (= ([] machines kept) row)
      (+= kept 1)
    )
    (call (. machines truncate) kept)
    (call (. machine-groups truncate) grouped)
    (let unions Size 0)
    (for (in position (..< 0 (. early-unions length)))
      (if (or (>= position union-count) (not (call held-by retired (. ([] early-unions position) instance))))
        (= ([] early-unions unions) ([] early-unions position))
        (+= unions 1)
      )
    )
    (call (. early-unions remove) unions (- (. early-unions length) unions))
    (return null)
  )
  (fn-do _ machines-of Size
    (param instance InstanceId)
    (param from Size)
    (param to Size)
    ; How many of the machines from one place to another an instance typed.
    (let count Size 0)
    (for (in position (..< from to))
      (if (== (. ([] machines position) instance) instance)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do _ machine-place U32
    (param instance InstanceId)
    (param from Size)
    (param rank Size)
    ; The place, from one on, of the machine an instance typed after `rank` others there, or none.
    (let seen Size 0)
    (for (in position (..< from (. machines length)))
      (if (== (. ([] machines position) instance) instance)
        (return-if (as position U32) (if (== seen rank)))
        (blank)
        (+= seen 1)
      )
    )
    (return (. U32 max))
  )
  (fn-expr + unshared-weight I64
    ; How much these facts hold that another type pass cannot take in: the rows retiring an instance
    ; removes (`retirable-weight`), what an edit retyped in place keeps (`kept-weight`) and the rest
    ; (`unretirable-weight`), but for what the merge takes in (`absorbed-weight`). A type pass takes in
    ; the properties reads track from each pass (`absorb-shared`), the instances that use styles and the
    ; sites and applications of style rules with their instances (`absorb-owned`, `absorb-applications`),
    ; and lists the style rules and extensions of style sheets before typing
    ; (`Checker.list-declarations`), so none of those counts. A type pass that types on many workers
    ; types again each instance whose typing changed it (`merge-sessions`).
    (- (+ (call retirable-weight) (call kept-weight) (call unretirable-weight)) (call absorbed-weight))
  )
  (fn-do + absorbed-weight I64
    ; What of those weights the merge takes in from the pass that typed an instance: what each
    ; instance records of markup, of the queries it registers, of tracked values and of the events it
    ; uses (`absorb-markup`), and of the styles it declares, reads and writes, the values evaluated
    ; once for every making it types, the codings, gates and domains it uses and the arguments of
    ; markup elements it stores (`absorb-styles`), the slots of style sheets it reads and those the
    ; lines of rules it applies take or compute with, with the projections and the values evaluated
    ; from slots they name (`absorb-themes`), the state cells of `when`s and the values of rules it
    ; makes, keeps and carries, with the content style rules generate (`absorb-scopes`,
    ; `absorb-contents`), and the sections it types (`absorb-plans`); and what it takes in from every
    ; pass: the targets of descendant queries, the markup queries, the rules that run once markup has,
    ; the event runtime's functions that close an object's events and register a lowered section, the
    ; styles with their properties, the style sheets with their slots and the members of their
    ; families (`absorb-sheets`), the codings, the gates and the domains, the links between state
    ; cells, and the plans of the event handlers of the classes made, each by its key; and the state
    ; machines each instance types, with the unions they make early (`absorb-machines`).
    (let markup
      (scope (+ change-test-count (. markup-reads length) (. row-item-reads length) (. collection-reads length))
        (lazy change-test-count (. change-tests length))
      )
    )
    (+= markup (+ (. element-roots length) (. named-stores length) (. slot-outlets length) (. raised-elements length)))
    (+= markup (. slot-choices length))
    (+= markup
      (scope (+ (. loop-regions length) (. branch-regions length) trigger-count (. deferred-values length))
        (lazy trigger-count (. markup-triggers length))
      )
    )
    (+= markup (+ (. region-roots length) (. whenever-calls length) (. query-targets length)))
    (+= markup (+ (. markup-queries length) (. query-registrations length) (. markup-rules length)))
    (let tracked
      (scope (+ (. live-statements length) subscriptions (. tracked-locals length) (. latest-reads length))
        (lazy subscriptions (. owned-subscriptions length))
      )
    )
    (+= tracked (. pulled-sites length))
    (let events (+ (. event-uses length) (. event-closers length)))
    (+= events (+ (if-expr (!= event-close no-instance) 1u32 0u32) (if-expr (!= event-register no-instance) 1u32 0u32)))
    (+= events (if-expr (!= event-register-arrival no-instance) 1u32 0u32))
    (let styles
      (scope (+ declaration-count (. style-authors length) (. style-writes length) (. style-reads length))
        (lazy declaration-count (. style-declarations length))
      )
    )
    (+= styles
      (scope (+ (. style-flags length) (. element-stores length) (. rule-updates length) static-value-count)
        (lazy static-value-count (. style-static-values length))
      )
    )
    (+= styles (+ (. coding-users length) (. gate-users length) (. domain-users length)))
    (let registries
      (scope (+ (. style-codings length) (. style-gates length) (. style-uses length) property-count)
        (lazy property-count (. style-properties length))
      )
    )
    (+= registries (+ (. style-domains length) (. property-domains length)))
    (+= registries
      (scope (+ (. style-sheet-uses length) (. sheet-slots length) (. sheet-members length) member-slots)
        (lazy member-slots (. sheet-member-slots length))
      )
    )
    (let sheets
      (scope (+ (. style-projections length) (. rule-slots length) (. rule-themes length) themed-value-count)
        (lazy themed-value-count (. style-themed-values length))
      )
    )
    (+= sheets (as (+ (. themed-givens length) (. theme-reads length) (+ family-gates sheet-reads lookups)) Size))
    (let plans (+ (. lowered-handlers length) (. lowered-types length) (. subscribed-sections length)))
    (+= plans (+ (. lowered-sections length) (. rebinding-sections length)))
    (let scopes (+ (. scope-cells length) (. scope-links length) (. scope-values length) (. carried-values length)))
    (+= scopes (+ (. carried-cells length) (. outlet-cells length) (. slot-forwards length) (. style-contents length)))
    (let machined (+ (. machines length) (. early-unions length)))
    (return (+ markup tracked events styles registries sheets plans scopes machined))
  )
  (fn-do + kept-weight I64
    ; What an edit retyped in place keeps and finds again as it types the edited module: each lookup
    ; that finds by its key a style sheet another instance may have made, which a type pass cannot
    ; take in (`lookups`), the plans of the event handlers of the classes made
    ; (`Checker.plan-event-handlers`), which `retype-edit` refuses an edit that would change, the
    ; codings of style values and the gates of style declarations, which program tables emit only
    ; while some instance uses them (`coding-users`, `gate-users`), the styles and style sheets,
    ; with their properties and slots, which program tables place and register only where a function
    ; they reach uses them (`style-users`), with the domains changes to properties raise
    ; (`property-domains`), the domains of invalidation, placed, numbered and registered only while
    ; some instance names them (`domain-users`), and what markup and events keep once for the
    ; program: the markup queries, found by their class and property and emitted only for a
    ; registration reached, the rules that run once markup has, a function of the rule alone, and the
    ; event runtime's functions that close an object's events and register a lowered section, reached
    ; only from a closer or a section reached; and the values evaluated from slots of style sheets,
    ; found by their lines, whose sites an edit moves (`move-themes`).
    (let plans (+ (. lowered-handlers length) (. lowered-types length) (. subscribed-sections length)))
    (+= plans (+ (. lowered-sections length) (. rebinding-sections length)))
    (let styles (+ (. style-codings length) (. style-gates length) (. style-uses length) (. style-sheet-uses length)))
    (+= styles
      (scope (+ property-count (. sheet-slots length) (. style-domains length) (. property-domains length))
        (lazy property-count (. style-properties length))
      )
    )
    (+= styles (+ (. sheet-members length) (. sheet-member-slots length)))
    (+= styles (+ (. style-themed-values length) (. themed-givens length)))
    (let markup (+ (. markup-queries length) (. markup-rules length)))
    (let events (+ (if-expr (!= event-close no-instance) 1u32 0u32) (if-expr (!= event-register no-instance) 1u32 0u32)))
    (+= events (if-expr (!= event-register-arrival no-instance) 1u32 0u32))
    (return (+ (as (+ plans styles markup events) I64) (as lookups I64)))
  )
  (fn-do + retirable-weight I64
    (let markup (+ (. collection-reads length) (. event-uses length) (. markup-reads length) (. element-roots length)))
    (+= markup (+ (. slot-outlets length) (. branch-regions length) (. loop-regions length) (. row-item-reads length)))
    (+= markup (. slot-choices length))
    (+= markup (+ (. region-roots length) (. query-registrations length) (. markup-triggers length)))
    (+= markup
      (scope (+ whenever-call-count (. raised-elements length) (. named-stores length) (. event-closers length))
        (lazy whenever-call-count (. whenever-calls length))
      )
    )
    (+= markup (. deferred-values length))
    (let tracked (+ (. change-tests length) (. owned-subscriptions length) (. latest-reads length)))
    (+= tracked (+ (. live-statements length) (. tracked-locals length) (. pulled-sites length)))
    (let styles (+ (. style-declarations length) (. style-authors length) (. style-writes length)))
    (+= styles (+ (. style-static-values length) (. scope-cells length) (. scope-values length)))
    (+= styles (+ (. carried-values length) (. carried-cells length) (. outlet-cells length) (. slot-forwards length)))
    (+= styles (+ (. style-contents length) (. rule-updates length) (. style-reads length) (. style-flags length)))
    (+= styles (+ (. element-stores length) (. coding-users length) (. gate-users length) (. domain-users length)))
    (+= styles (+ (. theme-reads length) (. rule-slots length) (. rule-themes length) (. style-projections length)))
    (let settled
      (scope (+ machined (. raising-rules length) (. stack-needs length) (. stack-holds length))
        (lazy machined (+ (. machines length) (. early-unions length)))
      )
    )
    (return (+ markup tracked styles settled))
  )
  (fn-expr + unretirable-weight I64
    (+ held (* (as revised I64) 65536))
    (where
      (lazy markup (+ (. query-targets length) (. event-clauses length)))
      (lazy styles (. scope-links length))
      (lazy settled (+ (. overrides length) (. witness-slots length)))
      (lazy held (as (+ markup styles settled family-gates sheet-reads) I64))
    )
  )
  (fn-do _ keyed-conversions (list Bool)
    ; Which conversions are kept by what they convert rather than where they are written: those of
    ; what a function is passed, and those of a function made for two function types.
    (let keyed (list Bool))
    (for (in _ (..< 0 (. conversions length)))
      (+= keyed false)
    )
    (for (in head (. passed-heads values))
      (let fact head)
      (while (!= fact no-fact)
        (= ([] keyed fact) true)
        (= fact (. ([] conversions fact) next))
      )
    )
    (for (in head (. cast-heads values))
      (let fact head)
      (while (!= fact no-fact)
        (= ([] keyed fact) true)
        (= fact (. ([] conversions fact) next))
      )
    )
    (return keyed)
  )
  (fn-do _ moved FactId
    (param taken (list FactId))
    (param id FactId)
    ; The number here of a fact the peer numbered `id`, which is one taken in.
    (if (== id no-fact)
      (return no-fact)
    )
    (throw (call Panic "A fact of another type pass that this pass leaves is named by one it takes in") (if (== ([] taken id) no-fact)))
    (return ([] taken id))
  )
  (fn-do _ absorb-machines _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    (param events Size)
    ; Takes in the state machines the peer's instances that this pass takes from it typed, each with
    ; its groups of event transitions after the groups here, and the unions they made early, with
    ; their types, instances and facts as they are here. A group's event use is among those
    ; `absorb-markup` took in from `events` on, in the peer's order.
    (let event-ids (list U32))
    (let next-event (as events U32))
    (for (in row (. peer event-uses))
      (+= event-ids (if-expr (call (. ids owns) (. row instance)) next-event (. U32 max)))
      (+= next-event (as (if-expr (call (. ids owns) (. row instance)) 1 0) U32))
    )
    (for (in row (. peer machines))
      (if (call (. ids owns) (. row instance))
        (let start (. machine-groups length))
        (for (in group (..< (. row groups start) (+ (. row groups start) (. row groups count))))
          (let taken (as ([] (. peer machine-groups) group) MachineGroup))
          (= (. taken stream) (call (. ids type) (. taken stream)))
          (= (. taken item) (call (. ids type) (. taken item)))
          (= (. taken subscriber) (call (. ids type) (. taken subscriber)))
          (= (. taken subscribe) (call moved call-ids (. taken subscribe)))
          (= (. taken unsubscribe) (call moved call-ids (. taken unsubscribe)))
          (= (. taken event) (if-expr (!= (. taken event) (. U32 max)) ([] event-ids (. taken event)) (. U32 max)))
          (= (. taken enqueue) (call (. ids instance) (. taken enqueue)))
          (= (. taken port) (call (. ids instance) (. taken port)))
          (= (. taken post) (call (. ids instance) (. taken post)))
          (= (. taken attach) (call (. ids instance) (. taken attach)))
          (= (. taken detach) (call (. ids instance) (. taken detach)))
          (call (. machine-groups append) taken)
        )
        (let fact (as row MachineFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact union) (call (. ids type) (. row union)))
        (= (. fact groups) (call (of RowRange MachineGroup) (as start U32) (. row groups count)))
        (= (. fact refined) (call (. ids instance) (. row refined)))
        (call (. machines append) fact)
      )
    )
    (for (in row (. peer early-unions))
      (if (call (. ids owns) (. row instance))
        (+= early-unions
          (call EarlyUnion
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row module))
              (arg (. row syntax))
              (arg (call (. ids type) (. row union)))
            )
          )
        )
      )
    )
  )
  (fn-do _ absorb-steps (of RowRange U32)
    (param peer Facts)
    (param ids PeerIds)
    (param range (of RowRange U32))
    (if (== (. range count) 0)
      (return (call (of RowRange U32)))
    )
    (let start U32 (as (. steps length) U32))
    (for (in offset (..< 0 (. range count)))
      (let place (call (. ids property) ([] (. peer steps) (+ (. range start) offset))))
      (let getter (call (. ids instance) ([] (. peer step-callees) (+ (. range start) offset))))
      (+= steps place)
      (+= step-callees getter)
    )
    (return (call (of RowRange U32) start (. range count)))
  )
  (fn-do _ absorb-actions (of RowRange U32)
    (param peer Facts)
    (param ids PeerIds)
    (param range (of RowRange U32))
    (if (== (. range count) 0)
      (return (call (of RowRange U32) (as (. action-slots length) U32) 0))
    )
    (let start U32 (as (. action-slots length) U32))
    (for (in offset (..< 0 (. range count)))
      (let slot (call (. ids slot) ([] (. peer action-slots) (+ (. range start) offset))))
      (let type (call (. ids type) ([] (. peer action-types) (+ (. range start) offset))))
      (call (. action-slots append) slot)
      (call (. action-types append) type)
    )
    (return (call (of RowRange U32) start (. range count)))
  )
  (fn-do _ absorb-calls _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    (for (in position (..< 0 (. peer calls length)))
      (if (== ([] call-ids position) no-fact)
        (continue)
      )
      (let fact (as ([] (. peer calls) position) CallFact))
      (let instance (call (. ids instance) (. fact instance)))
      (let callee (call (. ids instance) (. fact callee)))
      (let walked (call absorb-steps peer ids (. fact through)))
      (let start U32 (as (. call-fills length) U32))
      (for (in offset (..< 0 (. fact fills count)))
        (+= call-fills ([] (. peer call-fills) (+ (. fact fills start) offset)))
      )
      (= (. fact instance) instance)
      (= (. fact callee) callee)
      (= (. fact fills) (call (of RowRange ArgumentFill) start (. fact fills count)))
      (= (. fact through) walked)
      (= (. fact next) (call moved call-ids (. fact next)))
      (let id FactId (as (. calls length) FactId))
      (throw (call Panic "The calls taken in from another type pass are numbered out of order") (if (!= id ([] call-ids position))))
      (blank)
      (call (. calls append) fact)
      (call chain-fact call-lasts call-priors instance id)
    )
  )
  (fn-do _ absorb-conversion ConversionFact
    (param peer Facts)
    (param ids PeerIds)
    (param fact ConversionFact)
    ; A conversion of the peer's with its types and instances as they are here and its parts taken
    ; in, but for the conversion it leads to.
    (let moved fact)
    (= (. moved instance) (call (. ids instance) (. fact instance)))
    (= (. moved from) (call (. ids type) (. fact from)))
    (= (. moved to) (call (. ids type) (. fact to)))
    (= (. moved callee) (call (. ids instance) (. fact callee)))
    (= (. moved runs) (call (. ids instance) (. fact runs)))
    (= (. moved asked) (call (. ids type) (. fact asked)))
    (= (. moved parts) (call absorb-parts peer ids (. fact parts)))
    (return moved)
  )
  (fn-do _ absorb-parts FactId
    (param peer Facts)
    (param ids PeerIds)
    (param first FactId)
    ; Takes in a chain of the parts of a conversion, each with parts of its own, and gives the first.
    (let head no-fact)
    (let last no-fact)
    (let cursor first)
    (while (!= cursor no-fact)
      (let part (call absorb-conversion peer ids ([] (. peer conversion-parts) cursor)))
      (= (. part next) no-fact)
      (let id FactId (as (. conversion-parts length) FactId))
      (call (. conversion-parts append) part)
      (if (== last no-fact)
        (= head id)
        (else
          (= (. ([] conversion-parts last) next) id)
        )
      )
      (= last id)
      (= cursor (. ([] (. peer conversion-parts) cursor) next))
    )
    (return head)
  )
  (fn-do _ absorb-conversions _
    (param peer Facts)
    (param ids PeerIds)
    (param keyed (list Bool))
    (param conversion-ids (list FactId))
    (for (in position (..< 0 (. peer conversions length)))
      (if (== ([] conversion-ids position) no-fact)
        (continue)
      )
      (let fact (call absorb-conversion peer ids ([] (. peer conversions) position)))
      (= (. fact next) (call moved conversion-ids (. fact next)))
      (let id FactId (as (. conversions length) FactId))
      (throw (call Panic "The conversions taken in from another type pass are numbered out of order") (if (!= id ([] conversion-ids position))))
      (blank)
      (call (. conversions append) fact)
      (call chain-fact conversion-lasts conversion-priors (. fact instance) id)
    )
  )
  (fn-do _ absorb-keyed-conversions _
    (param peer Facts)
    (param ids PeerIds)
    (param keyed (list Bool))
    ; Takes in each conversion the peer keeps by what it converts that this pass lacks, in the order
    ; the peer recorded them.
    (for (in (tuple callee head) (. peer passed-heads))
      (let runs (call (. ids instance) (as callee InstanceId)))
      (for (in fact (call (. peer chain-order) head))
        (let row (as ([] (. peer conversions) fact) ConversionFact))
        (if (!= (call passed-conversion runs (. row reason) (call (. ids type) (. row from)) (call (. ids type) (. row to))) no-fact)
          (continue)
        )
        (let moved (call absorb-conversion peer ids row))
        (= (. moved next) (call first-passed runs))
        (let id FactId (as (. conversions length) FactId))
        (call (. conversions append) moved)
        (call chain-fact conversion-lasts conversion-priors (. moved instance) id)
        (= ([] passed-heads runs) id)
      )
    )
    (for (in (tuple key head) (. peer cast-heads))
      (let source (call (. ids type) (as (/rshift/ key 32) TypeId)))
      (let target (call (. ids type) (as (/and/ key (as (. U32 max) Size)) TypeId)))
      (for (in fact (call (. peer chain-order) head))
        (let row (as ([] (. peer conversions) fact) ConversionFact))
        (if (!= (call cast-conversion source target (. row reason) (call (. ids type) (. row from)) (call (. ids type) (. row to))) no-fact)
          (continue)
        )
        (let moved (call absorb-conversion peer ids row))
        (= (. moved next) (call first-cast source target))
        (let id FactId (as (. conversions length) FactId))
        (call (. conversions append) moved)
        (call chain-fact conversion-lasts conversion-priors (. moved instance) id)
        (= ([] cast-heads (call cast-key source target)) id)
      )
    )
  )
  (fn-do _ chain-order (list FactId)
    (param head FactId)
    ; The conversions of a chain kept by what they convert, first recorded first.
    (let order (list FactId))
    (let fact head)
    (while (!= fact no-fact)
      (+= order fact)
      (= fact (. ([] conversions fact) next))
    )
    (let reversed (list FactId))
    (let position (. order length))
    (while (!= position 0)
      (-= position 1)
      (+= reversed ([] order position))
    )
    (return reversed)
  )
  (fn-do _ absorb-forces _
    (param peer Facts)
    (param ids PeerIds)
    (param force-ids (list FactId))
    (for (in position (..< 0 (. peer forces length)))
      (if (== ([] force-ids position) no-fact)
        (continue)
      )
      (let fact (as ([] (. peer forces) position) ForceFact))
      (= (. fact instance) (call (. ids instance) (. fact instance)))
      (= (. fact operand) (call (. ids type) (. fact operand)))
      (= (. fact result) (call (. ids type) (. fact result)))
      (= (. fact next) (call moved force-ids (. fact next)))
      (call (. forces append) fact)
    )
  )
  (fn-do _ absorb-transforms _
    (param peer Facts)
    (param ids PeerIds)
    (param transform-ids (list U32))
    (for (in position (..< 0 (. peer transforms length)))
      (if (== ([] transform-ids position) (. U32 max))
        (continue)
      )
      (let fact (as ([] (. peer transforms) position) TransformFact))
      (let start U32 (as (. transform-chains length) U32))
      (for (in offset (..< 0 (. fact chain count)))
        (let link (call (. ids type) ([] (. peer transform-chains) (+ (. fact chain start) offset))))
        (+= transform-chains link)
      )
      (= (. fact chain) (call (of RowRange TypeId) start (. fact chain count)))
      (= (. fact instance) (call (. ids instance) (. fact instance)))
      (= (. fact source) (call (. ids type) (. fact source)))
      (= (. fact raised) (call (. ids type) (. fact raised)))
      (call (. transforms append) fact)
    )
  )
  (fn-do _ absorb-nodes _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    (param conversion-ids (list FactId))
    (param force-ids (list FactId))
    ; Gives each instance taken from the peer nodes of its own, filled as the peer filled them, and
    ; keeps the types its locals hold.
    (let queue node-copies)
    (throw (call Panic "Facts takes in the nodes of another type pass only while copying them") (if (not queue)))
    (blank)
    (let first U32 (as (. node-types length) U32))
    (let ranges (list (of RowRange U32)))
    (let peer-rows (. peer instances rows))
    (for (in id (..< 0 (. peer-rows length)))
      (if (not (call (. ids owns) (as id InstanceId)))
        (continue)
      )
      (let row (as ([] peer-rows id) Instance))
      (let instance (call (. ids instance) (as id InstanceId)))
      (if (!= (. row slot-start) (. U32 max))
        (= (. ([] (. instances rows) instance) slot-start) (as (. slot-types length) U32))
        (= (. ([] (. instances rows) instance) slot-count) (. row slot-count))
        (= (. ([] (. instances rows) instance) slot-base) (. row slot-base))
        (for (in offset (..< 0 (. row slot-count)))
          (let held (call (. ids type) ([] (. peer slot-types) (+ (. row slot-start) offset))))
          (+= slot-types held)
        )
      )
      (if (== (. row node-start) (. U32 max))
        (continue)
      )
      (throw (call Panic "An instance taken from another type pass has nodes here already") (if (!= (. ([] (. instances rows) instance) node-start) (. U32 max))))
      (blank)
      (= (. ([] (. instances rows) instance) binding) (call (. ids binding) (. row binding)))
      (= (. ([] (. instances rows) instance) node-start) (as (. node-types length) U32))
      (= (. ([] (. instances rows) instance) subtree) (. row subtree))
      (+= ranges (call (of RowRange U32) (. row node-start) (. row subtree count)))
      (for (in source (..< (. row node-start) (+ (. row node-start) (. row subtree count))))
        (+= node-types (call (. ids type) ([] (. peer node-types) source)))
        (let constant ([] (. peer node-constants) source))
        (if (== constant no-fact)
          (+= node-constants no-fact)
          (else
            (+= node-constants (as (. constants length) FactId))
            (call (. constants append)
              (block
                (arg (call absorb-constant peer ids ([] (. peer constants) constant) ([] (. peer node-plans) source)))
              )
            )
          )
        )
      )
    )
    (<- queue (call NodeCopy peer first ranges call-ids conversion-ids force-ids))
  )
  (fn-do + start-copying-nodes _
    (param pool Worker)
    (param count Size)
    (throw (call Panic "Facts copies the nodes of other type passes already") (if node-copies))
    (blank)
    (let room (+ (. node-types length) count))
    (call (. node-types reserve) room)
    (call (. node-calls reserve) room)
    (call (. node-conversions reserve) room)
    (call (. node-conversion-tails reserve) room)
    (call (. node-forces reserve) room)
    (call (. node-plans reserve) room)
    (call (. node-chains reserve) room)
    (call (. node-constants reserve) room)
    (let queue (of SyncBufferedChannel NodeCopy))
    (let group (call TaskGroup))
    (= node-copies queue)
    (= node-copying group)
    (let task
      (do-new (worker: pool)
        (for (in copy queue)
          (call copy-nodes copy)
        )
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (fn-do + end-copying-nodes _
    (let queue node-copies)
    (let group node-copying)
    (if queue
      (call (. queue close))
    )
    (if group
      (call (. group settle))
    )
    (= node-copies null)
    (= node-copying null)
    (if group
      (call (. group wait))
    )
  )
  (fn-do _ copy-nodes _
    (param copy NodeCopy)
    (throw (call Panic "The nodes taken in from other type passes are copied out of order") (if (!= (. node-calls length) (as (. copy first) Size))))
    (blank)
    (let peer (. copy peer))
    (for (in range (. copy ranges))
      (for (in source (..< (. range start) (. range end)))
        (+= node-calls (call moved (. copy call-ids) ([] (. peer node-calls) source)))
        (+= node-conversions (call moved (. copy conversion-ids) ([] (. peer node-conversions) source)))
        (+= node-conversion-tails (call moved (. copy conversion-ids) ([] (. peer node-conversion-tails) source)))
        (+= node-forces (call moved (. copy force-ids) ([] (. peer node-forces) source)))
        (+= node-plans ([] (. peer node-plans) source))
        (+= node-chains ([] (. peer node-chains) source))
      )
    )
  )
  (fn-do _ absorb-constant ConstantFact
    (param peer Facts)
    (param ids PeerIds)
    (param constant ConstantFact)
    (param plan U8)
    ; A node's constant as it is here: the type a C call that allocates is described by, the class
    ; an `is` tests for, and the steps a read through a delegated property takes, are numbered here.
    (let moved constant)
    (let kind (as (/and/ plan plan-bits) OperatorPlan))
    (if (or (== kind .plan-described) (== kind .plan-class-test))
      (= (. moved bits) (as (call (. ids type) (as (. constant bits) TypeId)) U64))
      (else-if (== kind .plan-through)
        (let range (call (of RowRange U32) (as (% (. constant bits) 4294967296) U32) (as (/ (. constant bits) 4294967296) U32)))
        (let kept (call absorb-steps peer ids range))
        (= (. moved bits) (+ (as (. kept start) U64) (* (as (. kept count) U64) 4294967296)))
      )
    )
    (return moved)
  )
  (fn-do _ absorb-owned _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    (param conversion-ids (list FactId))
    (param force-ids (list FactId))
    ; Takes in the facts of the peer's instances that this pass takes from it, which no other fact
    ; names by its place.
    (for (in row (. peer pairs))
      (if (call (. ids owns) (. row instance))
        (let fact (as row PairFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact from) (call (. ids type) (. row from)))
        (= (. fact to) (call (. ids type) (. row to)))
        (= (. fact unified) (call (. ids type) (. row unified)))
        (call (. pairs append) fact)
      )
    )
    (for (in row (. peer relations))
      (if (call (. ids owns) (. row instance))
        (let fact (as row RelationFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact from) (call (. ids type) (. row from)))
        (= (. fact to) (call (. ids type) (. row to)))
        (call (. relations append) fact)
      )
    )
    (for (in row (. peer unwrapped))
      (if (call (. ids owns) (. row instance))
        (let fact (as row UnwrappedFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact type) (call (. ids type) (. row type)))
        (call (. unwrapped append) fact)
      )
    )
    (for (in row (. peer chains))
      (if (call (. ids owns) (. row instance))
        (let fact (as row ChainFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (call (. chains append) fact)
      )
    )
    (for (in row (. peer declared-values))
      (if (call (. ids owns) (. row instance))
        (let fact (as row DeclaredValueFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact declared) (call (. ids type) (. row declared)))
        (= (. fact found) (call (. ids type) (. row found)))
        (call (. declared-values append) fact)
      )
    )
    (for (in row (. peer context-casts))
      (if (call (. ids owns) (. row instance))
        (let fact (as row ContextCastFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact target) (call (. ids type) (. row target)))
        (call (. context-casts append) fact)
      )
    )
    (for (in row (. peer payload-effects))
      (if (call (. ids owns) (. row instance))
        (let fact (as row PayloadEffectFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (call (. payload-effects append) fact)
      )
    )
    (for (in row (. peer case-owners))
      (if (call (. ids owns) (. row instance))
        (let fact (as row CaseOwnerFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact owner) (call (. ids type) (. row owner)))
        (call (. case-owners append) fact)
      )
    )
    (for (in row (. peer fills))
      (if (call (. ids owns) (. row instance))
        (let fact (as row FillFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact slot) (call (. ids slot) (. row slot)))
        (call record-fill fact)
      )
    )
    (for (in row (. peer stack-reads))
      (if (call (. ids owns) (. row instance))
        (call (. stack-reads append) (call StackRead (call (. ids instance) (. row instance)) (. row syntax) (. row module) (. row decl)))
      )
    )
    (for (in row (. peer local-global-uses))
      (if (call (. ids owns) (. row instance))
        (call (. local-global-uses append)
          (block
            (arg (call LocalGlobalUse (call (. ids instance) (. row instance)) (. row syntax) (. row module) (. row decl)))
          )
        )
      )
    )
    (for (in row (. peer stack-scopes))
      (if (call (. ids owns) (. row instance))
        (call (. stack-scopes append)
          (block
            (arg
              (call StackScope
                (block
                  (arg (call (. ids instance) (. row instance)))
                  (arg (. row first))
                  (arg (. row last))
                  (arg (. row module))
                  (arg (. row decl))
                  (arg (call (. ids swap-entry) (. row entry)))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer swap-forwards))
      (if (call (. ids owns) (. row instance))
        (let fact (as row SwapForward))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact callee) (call (. ids instance) (. row callee)))
        (call (. swap-forwards append) fact)
      )
    )
    (for (in row (. peer global-uses))
      (if (call (. ids owns) (. row instance))
        (call (. global-uses append) (call GlobalUse (call (. ids instance) (. row instance)) (. row syntax) (. row module) (. row decl)))
      )
    )
    (for (in row (. peer value-reads))
      (if (call (. ids owns) (. row instance))
        (call (. value-reads append) (call ValueRead (call (. ids instance) (. row instance)) (. row name) (. row syntax) (. row surely)))
      )
    )
    (for (in row (. peer diagnostics))
      (if (call (. ids owns) (. row instance))
        (call absorb-diagnostic peer ids row)
      )
    )
    (for (in row (. peer loose-calls))
      (if (call (. ids owns) (. row instance))
        (call add-loose-call (call LooseFact (call (. ids instance) (. row instance)) (call moved call-ids (. row fact)) (. row apart)))
      )
    )
    (for (in row (. peer loose-conversions))
      (if (call (. ids owns) (. row instance))
        (call (. loose-conversions append)
          (block
            (arg (call LooseFact (call (. ids instance) (. row instance)) (call moved conversion-ids (. row fact)) (. row apart)))
          )
        )
      )
    )
    (for (in row (. peer loose-forces))
      (if (call (. ids owns) (. row instance))
        (call (. loose-forces append)
          (block
            (arg (call LooseFact (call (. ids instance) (. row instance)) (call moved force-ids (. row fact)) (. row apart)))
          )
        )
      )
    )
    (for (in row (. peer loose-types))
      (if (call (. ids owns) (. row instance))
        (call (. loose-types append) (call LooseType (call (. ids instance) (. row instance)) (. row syntax) (call (. ids type) (. row type))))
      )
    )
    (for (in row (. peer answer-types))
      (if (call (. ids owns) (. row instance))
        (call (. answer-types append) (call LooseType (call (. ids instance) (. row instance)) (. row syntax) (call (. ids type) (. row type))))
      )
    )
    (for (in row (. peer forwards))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (= ([] key-scratch 0) instance)
        (= ([] key-scratch 1) (. row syntax))
        (call (. forward-keys store) (. key-scratch data) 2)
        (call (. forwards append)
          (block
            (arg
              (call ForwardFact
                (block
                  (arg instance)
                  (arg (. row syntax))
                  (arg (call (. ids type) (. row value)))
                  (arg (call (. ids type) (. row result)))
                  (arg (. row given))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer const-arrays))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (= ([] key-scratch 0) instance)
        (= ([] key-scratch 1) (. row syntax))
        (call (. const-array-keys store) (. key-scratch data) 2)
        (let first U32 (as (. const-items length) U32))
        (for (in offset (..< 0 (. row count)))
          (call (. const-items append) ([] (. peer const-items) (+ (. row first) offset)))
        )
        (call (. const-arrays append)
          (block
            (arg (call ConstArrayFact instance (. row syntax) (call (. ids type) (. row type)) first (. row count)))
          )
        )
      )
    )
    (for (in row (. peer leaves))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (let start U32 (as (. leave-tried length) U32))
        (for (in offset (..< 0 (. row tried count)))
          (let transform ([] (. ids transforms) ([] (. peer leave-tried) (+ (. row tried start) offset))))
          (throw (call Panic "A leave taken in from another type pass names a transform it leaves") (if (== transform (. U32 max))))
          (blank)
          (+= leave-tried transform)
        )
        (let key (call leave-key instance (. row syntax)))
        (let id FactId (as (. leaves length) FactId))
        (call (. leaves append)
          (block
            (arg
              (call LeaveFact
                (block
                  (arg instance)
                  (arg (. row syntax))
                  (arg (call (. ids type) (. row error)))
                  (arg (call (of RowRange U32) start (. row tried count)))
                  (arg (?? ([] leave-heads key) no-fact))
                )
              )
            )
          )
        )
        (= ([] leave-heads key) id)
      )
    )
    (for (in row (. peer outlined))
      (if (call (. ids owns) (. row instance))
        (let fact (as row OutlinedAction))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact params) (call absorb-actions peer ids (. row params)))
        (= (. fact result) (call (. ids type) (. row result)))
        (call (. outlined append) fact)
      )
    )
    (for (in row (. peer pattern-arguments))
      (if (call (. ids owns) (. row instance))
        (let fact (as row PatternArgument))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact result) (call (. ids type) (. row result)))
        (= (. fact answer) (call (. ids type) (. row answer)))
        (= (. fact stream) (call (. ids type) (. row stream)))
        (= (. fact buffer) (call (. ids type) (. row buffer)))
        (= (. fact rule) (call (. ids instance) (. row rule)))
        (= (. fact helper) (call (. ids type) (. row helper)))
        (= (. fact params) (call absorb-actions peer ids (. row params)))
        (= (. fact raised) (call (. ids type) (. row raised)))
        (call (. pattern-arguments append) fact)
      )
    )
    (for (in row (. peer self-actions))
      (if (call (. ids owns) (. row instance))
        (+= self-actions
          (call SelfAction
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids instance) (. row maker)))
              (arg (. row rooted))
            )
          )
        )
      )
    )
    (for (in row (. peer address-claims))
      (if (call (. ids owns) (. row instance))
        (+= address-claims
          (call AddressClaim
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids instance) (. row closer)))
            )
          )
        )
      )
    )
    (for (in row (. peer wavering))
      (if (call (. ids owns) (. row instance))
        (call (. wavering append) (call WaveringLazy (call (. ids instance) (. row instance)) (call (. ids slot) (. row slot))))
      )
    )
    (for (in row (. peer unheld-lazies))
      (if (call (. ids owns) (. row instance))
        (call (. unheld-lazies append) (call WaveringLazy (call (. ids instance) (. row instance)) (call (. ids slot) (. row slot))))
      )
    )
    (for (in fact (. peer unheld-transforms))
      (let transform ([] (. ids transforms) fact))
      (if (!= transform (. U32 max))
        (+= unheld-transforms transform)
      )
    )
    (for (in body (. peer task-bodies))
      (if (call (. ids owns) body)
        (+= task-bodies (call (. ids instance) body))
      )
    )
    (for (in body (. peer region-bodies))
      (if (call (. ids owns) body)
        (+= region-bodies (call (. ids instance) body))
      )
    )
    (for (in row (. peer style-users))
      (if (call (. ids owns) (. row instance))
        (+= style-users
          (call StyleUser
            (block
              (arg (call (. ids type) (. row type)))
              (arg (call (. ids instance) (. row instance)))
              (arg (. row module))
              (arg (. row site))
              (arg (. row constructed))
            )
          )
        )
      )
    )
  )
  (fn-do _ absorb-applications (list U32)
    (param peer Facts)
    (param ids PeerIds)
    (param sheets (list U32))
    ; Takes in the style sites and the applications of style rules of the peer's instances that this
    ; pass takes from it, each application's `outer` and the style sheet of its family numbered here,
    ; with the state cells of `when`s and the values of rules the peer's instances made
    ; (`absorb-scope-cells`, `absorb-scope-values`) and what names them (`absorb-contents`). An
    ; application names its cells, the link of those further out, and the values around it, as they
    ; stand here. Says where each of the peer's applications stands here, or `U32.max` where it was
    ; not taken in.
    (for (in row (. peer style-sites))
      (if (call (. ids owns) (. row instance))
        (+= style-sites (call StyleSite (call (. ids instance) (. row instance)) (. row module) (. row site)))
      )
    )
    (let cells (call absorb-scope-cells peer ids))
    (let values (call absorb-scope-values peer ids))
    (let moved (list U32))
    (for (in row (. peer style-applications))
      (if (not (call (. ids owns) (. row instance)))
        (+= moved (. U32 max))
        (continue)
      )
      (let fact (as row StyleApplication))
      (= (. fact instance) (call (. ids instance) (. row instance)))
      (= (. fact unit) (call (. ids instance) (. row unit)))
      (= (. fact action) (call (. ids instance) (. row action)))
      (= (. fact made) (call (. ids type) (. row made)))
      (= (. fact values) (call (. ids instance) (. row values)))
      (= (. fact updater) (call (. ids instance) (. row updater)))
      (= (. fact cell) (call moved-scope cells (. row cell)))
      (= (. fact outer-cells) (call moved-link peer cells (. row outer-cells)))
      (= (. fact around-values) (call moved-scope values (. row around-values)))
      (= (. fact family) (call moved-sheet sheets (. row family)))
      (if (!= (. row outer) (. U32 max))
        (if (== ([] moved (. row outer)) (. U32 max))
          (throw
            (call Panic
              (block
                (arg
                  (paragraph
                    "An application of a style rule of another type pass is applied by one not taken in"
                  )
                )
              )
            )
          )
        )
        (= (. fact outer) ([] moved (. row outer)))
      )
      (+= moved (as (. style-applications length) U32))
      (+= style-applications fact)
    )
    (call absorb-contents peer ids cells values moved)
    (return moved)
  )
  (fn-do _ absorb-scope-cells (list U32)
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in the state cells of `when`s the peer's instances that this pass takes from it made,
    ; kept, read and were given, in the order the peer made them, which is the order their code holds
    ; them in, and each the peer made on the way to a slot outlet, which no instance holds, where this
    ; pass lacks it (`Checker.scope-cell`). Says where each of the peer's cells stands here, or
    ; `U32.max` where it was not taken in. A cell kept of the function an instance is written in
    ; names that one's, which this pass takes from the same peer (`Instance.with-enclosing`). First
    ; it takes in each place the peer keyed a cell by, as a pass alone keys every place it makes one,
    ; though it drops the cell again (`Checker.prune-cells`), and the runtime numbers them all
    ; (`ProgramTables.state-key-number`).
    (for (in held (. ids peer-instances state-keys))
      (call (. ids instances state-key) (. held module) (. held site) (. held when-module) (. held when))
    )
    (let cells (list U32))
    (for (in row (. peer scope-cells))
      (let key (call moved-state-key ids (. row key)))
      (if (== (. row instance) no-instance)
        (let found (. U32 max))
        (for (in index (..< 0 (. scope-cells length)))
          (let held ([] scope-cells index))
          (if (and (== found (. U32 max)) (== (. held instance) no-instance) same-place same-key)
            (= found (as index U32))
          )
          (lazy same-place (and (== (. held site) (. row site)) (== (. held module) (. row module))))
          (lazy same-key (and (== (. held when) (. row when)) (== (. held key) key)))
        )
        (if (== found (. U32 max))
          (let fact row)
          (= (. fact owner) (call (. ids type) (. row owner)))
          (= (. fact key) key)
          (= found (as (. scope-cells length) U32))
          (+= scope-cells fact)
        )
        (+= cells found)
        (else-if (call (. ids owns) (. row instance))
          (let fact row)
          (= (. fact instance) (call (. ids instance) (. row instance)))
          (= (. fact owner) (call (. ids type) (. row owner)))
          (= (. fact key) key)
          (if (!= (. row source) (. U32 max))
            (= (. fact source) (call moved-scope cells (. row source)))
          )
          (+= cells (as (. scope-cells length) U32))
          (+= scope-cells fact)
        )
        (else
          (+= cells (. U32 max))
        )
      )
    )
    (return cells)
  )
  (fn-do _ absorb-scope-values (list U32)
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in the values of rules around rules written in rules that the peer's instances that this
    ; pass takes from it give, are given and keep, in the order the peer made them, with their frames
    ; and types as they stand here. Says where each of the peer's stands here, or `U32.max` where it
    ; was not taken in.
    (let values (list U32))
    (for (in row (. peer scope-values))
      (if (not (call (. ids owns) (. row instance)))
        (+= values (. U32 max))
        (continue)
      )
      (let fact row)
      (= (. fact instance) (call (. ids instance) (. row instance)))
      (= (. fact frame) (call (. ids frame) (. row frame)))
      (if (!= (. row source) (. U32 max))
        (= (. fact source) (call moved-scope values (. row source)))
      )
      (= (. fact type-first) (as (. scope-value-types length) U32))
      (for (in position (..< (. row type-first) (+ (. row type-first) (. row count))))
        (+= scope-value-types (call (. ids type) ([] (. peer scope-value-types) position)))
      )
      (+= values (as (. scope-values length) U32))
      (+= scope-values fact)
    )
    (return values)
  )
  (fn-do _ absorb-contents _
    (param peer Facts)
    (param ids PeerIds)
    (param cells (list U32))
    (param values (list U32))
    (param applications (list U32))
    ; Takes in what the peer's instances that this pass takes from it record of the state cells and
    ; the values of rules they carry: those a markup element gives its constructor, those a slot
    ; outlet holds, the lines that forward a slot, and the content style rules generate, with the
    ; application that generates it and the values and cells it keeps, all as they stand here.
    (for (in row (. peer carried-cells))
      (if (call (. ids owns) (. row instance))
        (+= carried-cells
          (call CarriedCell
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call moved-scope cells (. row cell)))
            )
          )
        )
      )
    )
    (for (in row (. peer carried-values))
      (if (call (. ids owns) (. row instance))
        (+= carried-values
          (call CarriedValues
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call moved-scope values (. row values)))
            )
          )
        )
      )
    )
    (for (in row (. peer outlet-cells))
      (if (call (. ids owns) (. row instance))
        (+= outlet-cells
          (call OutletCell
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row outlet))
              (arg (call moved-scope cells (. row cell)))
            )
          )
        )
      )
    )
    (for (in row (. peer slot-forwards))
      (if (call (. ids owns) (. row instance))
        (+= slot-forwards
          (call SlotForward
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row line))
              (arg (call (. ids type) (. row builder)))
              (arg (call (. ids type) (. row item)))
            )
          )
        )
      )
    )
    (for (in row (. peer style-contents))
      (if (not (call (. ids owns) (. row instance)))
        (continue)
      )
      (let fact row)
      (= (. fact instance) (call (. ids instance) (. row instance)))
      (= (. fact application) (call moved-scope applications (. row application)))
      (= (. fact builder) (call (. ids instance) (. row builder)))
      (= (. fact closure) (call (. ids type) (. row closure)))
      (= (. fact value-first) (as (. content-values length) U32))
      (for (in position (..< (. row value-first) (+ (. row value-first) (. row values))))
        (+= content-values (call moved-scope values ([] (. peer content-values) position)))
      )
      (= (. fact cell-first) (as (. content-cells length) U32))
      (for (in position (..< (. row cell-first) (+ (. row cell-first) (. row cells))))
        (+= content-cells (call moved-scope cells ([] (. peer content-cells) position)))
      )
      (+= style-contents fact)
    )
  )
  (fn-do _ moved-scope U32
    (param moved (list U32))
    (param index U32)
    ; Where a row the peer numbered `index` stands here, of its state cells, its values of rules or its
    ; applications of style rules, which is one taken in; one past those, none or one not here
    ; (`U32.max - 1`), stays.
    (if (>= index (- (. U32 max) 1))
      (return index)
    )
    (throw (call Panic "A fact of another type pass names a state cell, values or an application not taken in") (if (or (>= (as index Size) (. moved length)) (== ([] moved index) (. U32 max)))))
    (return ([] moved index))
  )
  (fn-do _ moved-link U32
    (param peer Facts)
    (param cells (list U32))
    (param link U32)
    ; The link here of the peer's link of state cells `link`, made once (`scope-link`).
    (if (== link (. U32 max))
      (return link)
    )
    (let held ([] (. peer scope-links) link))
    (let outer (call moved-link peer cells (. held outer)))
    (return (call scope-link (call moved-scope cells (. held cell)) outer))
  )
  (fn-do _ moved-state-key U32
    (param ids PeerIds)
    (param key U32)
    ; Where the peer's state key `key` stands here, made where this pass lacks it.
    (if (== key (. U32 max))
      (return key)
    )
    (let held ([] (. ids peer-instances state-keys) key))
    (return (call (. ids instances state-key) (. held module) (. held site) (. held when-module) (. held when)))
  )
  (fn-do _ absorb-style-runtime _
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in each function of the style runtime a peer typed that this pass has none of yet, as the
    ; instances that demanded them may be taken in rather than typed here.
    (let given (. peer style-runtime))
    (if (== (. style-runtime info-for) no-instance)
      (= (. style-runtime info-for) (call (. ids instance) (. given info-for)))
    )
    (if (== (. style-runtime info) no-instance)
      (= (. style-runtime info) (call (. ids instance) (. given info)))
    )
    (if (== (. style-runtime register-property) no-instance)
      (= (. style-runtime register-property) (call (. ids instance) (. given register-property)))
    )
    (if (== (. style-runtime register) no-instance)
      (= (. style-runtime register) (call (. ids instance) (. given register)))
    )
    (if (== (. style-runtime register-domain) no-instance)
      (= (. style-runtime register-domain) (call (. ids instance) (. given register-domain)))
    )
    (if (== (. style-runtime intern-holder) no-instance)
      (= (. style-runtime intern-holder) (call (. ids instance) (. given intern-holder)))
    )
    (if (== (. style-runtime held) no-type)
      (= (. style-runtime held) (call (. ids type) (. given held)))
    )
    (if (== (. style-runtime info-required) no-instance)
      (= (. style-runtime info-required) (call (. ids instance) (. given info-required)))
    )
    (if (== (. style-runtime site-static) no-instance)
      (= (. style-runtime site-static) (call (. ids instance) (. given site-static)))
    )
    (if (== (. style-runtime template-static) no-instance)
      (= (. style-runtime template-static) (call (. ids instance) (. given template-static)))
    )
    (if (== (. style-runtime associate) no-instance)
      (= (. style-runtime associate) (call (. ids instance) (. given associate)))
    )
    (if (== (. style-runtime site-ready) no-instance)
      (= (. style-runtime site-ready) (call (. ids instance) (. given site-ready)))
    )
    (if (== (. style-runtime open-block) no-instance)
      (= (. style-runtime open-block) (call (. ids instance) (. given open-block)))
    )
    (if (== (. style-runtime close-block) no-instance)
      (= (. style-runtime close-block) (call (. ids instance) (. given close-block)))
    )
    (if (== (. style-runtime dynamic) no-instance)
      (= (. style-runtime dynamic) (call (. ids instance) (. given dynamic)))
    )
    (if (== (. style-runtime block-enabled) no-instance)
      (= (. style-runtime block-enabled) (call (. ids instance) (. given block-enabled)))
    )
    (if (== (. style-runtime author-dynamic) no-instance)
      (= (. style-runtime author-dynamic) (call (. ids instance) (. given author-dynamic)))
    )
    (if (== (. style-runtime site-inherit) no-instance)
      (= (. style-runtime site-inherit) (call (. ids instance) (. given site-inherit)))
    )
    (if (== (. style-runtime template-object) no-instance)
      (= (. style-runtime template-object) (call (. ids instance) (. given template-object)))
    )
    (if (== (. style-runtime site-cached) no-instance)
      (= (. style-runtime site-cached) (call (. ids instance) (. given site-cached)))
    )
    (if (== (. style-runtime site-recording) no-instance)
      (= (. style-runtime site-recording) (call (. ids instance) (. given site-recording)))
    )
    (if (== (. style-runtime site-recorded) no-instance)
      (= (. style-runtime site-recorded) (call (. ids instance) (. given site-recorded)))
    )
    (if (== (. style-runtime author-object) no-instance)
      (= (. style-runtime author-object) (call (. ids instance) (. given author-object)))
    )
    (if (== (. style-runtime object-pointer) no-instance)
      (= (. style-runtime object-pointer) (call (. ids instance) (. given object-pointer)))
    )
    (if (== (. style-runtime imperative) no-instance)
      (= (. style-runtime imperative) (call (. ids instance) (. given imperative)))
    )
    (if (== (. style-runtime imperative-object) no-instance)
      (= (. style-runtime imperative-object) (call (. ids instance) (. given imperative-object)))
    )
    (if (== (. style-runtime sheet-info-for) no-instance)
      (= (. style-runtime sheet-info-for) (call (. ids instance) (. given sheet-info-for)))
    )
    (if (== (. style-runtime sheet-info) no-instance)
      (= (. style-runtime sheet-info) (call (. ids instance) (. given sheet-info)))
    )
    (if (== (. style-runtime sheet-register-slot) no-instance)
      (= (. style-runtime sheet-register-slot) (call (. ids instance) (. given sheet-register-slot)))
    )
    (if (== (. style-runtime sheet-register) no-instance)
      (= (. style-runtime sheet-register) (call (. ids instance) (. given sheet-register)))
    )
    (if (== (. style-runtime sheet-info-required) no-instance)
      (= (. style-runtime sheet-info-required) (call (. ids instance) (. given sheet-info-required)))
    )
    (if (== (. style-runtime sheet-register-member) no-instance)
      (= (. style-runtime sheet-register-member) (call (. ids instance) (. given sheet-register-member)))
    )
    (if (== (. style-runtime sheet-member-slot) no-instance)
      (= (. style-runtime sheet-member-slot) (call (. ids instance) (. given sheet-member-slot)))
    )
    (if (== (. style-runtime sheet-member-tag) no-instance)
      (= (. style-runtime sheet-member-tag) (call (. ids instance) (. given sheet-member-tag)))
    )
    (if (== (. style-runtime site-themed) no-instance)
      (= (. style-runtime site-themed) (call (. ids instance) (. given site-themed)))
    )
    (if (== (. style-runtime themed-slot) no-instance)
      (= (. style-runtime themed-slot) (call (. ids instance) (. given themed-slot)))
    )
    (if (== (. style-runtime themed-none) no-instance)
      (= (. style-runtime themed-none) (call (. ids instance) (. given themed-none)))
    )
    (if (== (. style-runtime themed-made) no-type)
      (= (. style-runtime themed-made) (call (. ids type) (. given themed-made)))
    )
    (if (== (. style-runtime site-family) no-instance)
      (= (. style-runtime site-family) (call (. ids instance) (. given site-family)))
    )
    (if (== (. style-runtime site-family-end) no-instance)
      (= (. style-runtime site-family-end) (call (. ids instance) (. given site-family-end)))
    )
    (if (== (. style-runtime site-sheet) no-instance)
      (= (. style-runtime site-sheet) (call (. ids instance) (. given site-sheet)))
    )
    (if (== (. style-runtime site-projected) no-instance)
      (= (. style-runtime site-projected) (call (. ids instance) (. given site-projected)))
    )
    (if (== (. style-runtime remap-tags) no-type)
      (= (. style-runtime remap-tags) (call (. ids type) (. given remap-tags)))
    )
    (if (== (. style-runtime scope-state) no-instance)
      (= (. style-runtime scope-state) (call (. ids instance) (. given scope-state)))
    )
    (if (== (. style-runtime template-content) no-instance)
      (= (. style-runtime template-content) (call (. ids instance) (. given template-content)))
    )
    (if (== (. style-runtime content-enabled) no-instance)
      (= (. style-runtime content-enabled) (call (. ids instance) (. given content-enabled)))
    )
    (if (== (. style-runtime outlet-mark) no-instance)
      (= (. style-runtime outlet-mark) (call (. ids instance) (. given outlet-mark)))
    )
    (if (== (. style-runtime outlet-push) no-instance)
      (= (. style-runtime outlet-push) (call (. ids instance) (. given outlet-push)))
    )
    (if (== (. style-runtime outlet-release) no-instance)
      (= (. style-runtime outlet-release) (call (. ids instance) (. given outlet-release)))
    )
    (if (== (. style-runtime outlet-state) no-instance)
      (= (. style-runtime outlet-state) (call (. ids instance) (. given outlet-state)))
    )
  )
  (fn-do _ absorb-rules _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    ; Takes in the facts of the peer's instances that this pass takes from it that are found by the
    ; instance and the node they are recorded at.
    (for (in row (. peer local-rules))
      (if (call (. ids owns) (. row instance))
        (let fact (as row LocalRule))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact answer) (call (. ids type) (. row answer)))
        (= (. fact result) (call (. ids type) (. row result)))
        (= (. fact stream) (call (. ids type) (. row stream)))
        (= (. fact buffer) (call (. ids type) (. row buffer)))
        (= (. fact adapted) (call (. ids type) (. row adapted)))
        (= (. fact relayed) (call (. ids type) (. row relayed)))
        (= ([] local-rule-rows (/or/ instance-bits (as (. fact syntax) Size))) (as (. local-rules length) U32))
        (lazy instance-bits (/lshift/ (as (. fact instance) Size) 32))
        (call (. local-rules append) fact)
      )
    )
    (for (in row (. peer rule-calls))
      (if (call (. ids owns) (. row instance))
        (call note-rule-call (call (. ids instance) (. row instance)) (. row from) (. row to))
      )
    )
    (for (in row (. peer content-links))
      (if (call (. ids owns) (. row instance))
        (let link (as row ContentLink))
        (= (. link instance) (call (. ids instance) (. row instance)))
        (= (. link parent) (call (. ids type) (. row parent)))
        (= (. link taken) (call (. ids type) (. row taken)))
        (= (. link call) (call moved call-ids (. row call)))
        (= (. link answers) (call (. ids type) (. row answers)))
        (= (. link append) (call (. ids instance) (. row append)))
        (= (. link close) (call moved call-ids (. row close)))
        (call note-content-link link)
      )
    )
    (for (in row (. peer filler-calls))
      (if (call (. ids owns) (. row instance))
        (call note-filler (call (. ids instance) (. row instance)) (call moved call-ids (. row call)))
      )
    )
    (for (in row (. peer materials))
      (if (call (. ids owns) (. row instance))
        (let fact (as row MaterialFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact slot) (call (. ids slot) (. row slot)))
        (= (. fact type) (call (. ids type) (. row type)))
        (= (. fact interface) (call (. ids type) (. row interface)))
        (= (. fact call) (call moved call-ids (. row call)))
        (= (. fact next) (. U32 max))
        (call record-material fact)
      )
    )
    (for (in row (. peer rollback-bodies))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (let mark (call moved call-ids (. row mark)))
        (let rewind (call moved call-ids (. row rewind)))
        (call add-rollback-body
          (block
            (arg
              (call RollbackBody
                (block
                  (arg instance)
                  (arg (. row syntax))
                  (arg mark)
                  (arg rewind)
                  (arg (call (. ids type) (. row held)))
                  (arg (call (. ids type) (. row kept)))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer storage-bodies))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (let walked (call absorb-steps peer ids (. row through)))
        (call add-storage-body (call StorageBody instance (. row syntax) walked (call (. ids type) (. row context))))
      )
    )
    (for (in row (. peer observer-bodies))
      (if (call (. ids owns) (. row instance))
        (call add-observer-body
          (block
            (arg
              (call ObserverBody
                (block
                  (arg (call (. ids instance) (. row instance)))
                  (arg (. row syntax))
                  (arg (call moved call-ids (. row record)))
                  (arg (call moved call-ids (. row rewind)))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ absorb-shared _
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in the facts that belong to no one instance, each that this pass lacks.
    (for (in type (. peer equalities))
      (call require-equality (call (. ids type) type))
    )
    (for (in row (. peer tracked-properties))
      (call note-tracked (. row module) (. row decl) (. row name))
    )
    (for (in row (. peer constant-globals))
      (let known false)
      (for (in held constant-globals)
        (if (and (== (. held module) (. row module)) (== (. held decl) (. row decl)))
          (= known true)
        )
      )
      (if (not known)
        (call (. constant-globals append) (call ConstantGlobal (. row module) (. row decl)))
      )
    )
    (for (in row (. peer witness-tables))
      (throw (call Panic "A witness table of another type pass holds an equality") (if (!= (. row equality) no-instance)))
      (blank)
      (call record-witness-table (call (. ids type) (. row value)) (call (. ids type) (. row interface)))
    )
    (for (in row (. peer dynamic-witnesses))
      (call record-dynamic-witness (call (. ids type) (. row value)) (call (. ids type) (. row interface)))
    )
    (for (in row (. peer witness-funcs))
      (call record-witness-func (call (. ids type) (. row interface)) (. row module) (. row decl))
    )
    (for (in row (. peer witness-calls))
      (call record-witness-call (call (. ids type) (. row interface)) (. row module) (. row decl))
    )
    (for (in proto (. peer witness-protos))
      (call record-witness-proto (call (. ids instance) proto))
    )
    (for (in type (. peer asked-marks))
      (call note-asked-mark (call (. ids type) type))
    )
    (for (in type (. peer property-reads))
      (call note-properties-read (call (. ids type) type))
    )
    (for (in (tuple function result) (. peer carried-heads))
      (call note-carried (call (. ids type) (as function TypeId)) (call (. ids type) result))
    )
    (for (in (tuple key place) (. peer cast-places))
      (let source (call (. ids type) (as (/rshift/ key 32) TypeId)))
      (let target (call (. ids type) (as (/and/ key (as (. U32 max) Size)) TypeId)))
      (let owner (as (/rshift/ place 32) InstanceId))
      (let held (call cast-key source target))
      (if (== owner no-instance)
        (= ([] cast-places held) (/lshift/ (as no-instance U64) 32))
        (else
          (let instance (call (. ids instance) owner))
          (let known ([] cast-places held))
          (let moved (/or/ (/lshift/ (as instance U64) 32) (/and/ place (as (. U32 max) U64))))
          (if (== known null)
            (= ([] cast-places held) moved)
            (else-if (!= (/rshift/ known 32) (as instance U64))
              (= ([] cast-places held) (/lshift/ (as no-instance U64) 32))
            )
            (else-if (!= known moved)
              (= ([] shared-casts held) true)
            )
          )
        )
      )
    )
    (for (in (tuple key shared) (. peer shared-casts))
      (let source (call (. ids type) (as (/rshift/ key 32) TypeId)))
      (let target (call (. ids type) (as (/and/ key (as (. U32 max) Size)) TypeId)))
      (= ([] shared-casts (call cast-key source target)) shared)
    )
    (if (== unhandled-error null)
      (= unhandled-error (. peer unhandled-error))
    )
  )
  (fn-do _ absorb-places _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    ; Takes in what the peer keeps of the nodes of the instances this pass takes from it, by the
    ; place of the node among all nodes or by its instance.
    (let starts (call (. peer owned-starts) ids))
    (for (in (tuple slot bits) (. peer feed-sites))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] feed-sites place) bits)
      )
    )
    (for (in (tuple slot call) (. peer protocol-starts))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] protocol-starts place) (call moved call-ids call))
      )
    )
    (for (in (tuple slot take) (. peer loop-takes))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] loop-takes place) take)
      )
    )
    (for (in (tuple slot flag) (. peer replacing))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] replacing place) flag)
      )
    )
    (for (in (tuple slot flag) (. peer leaving))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] leaving place) flag)
      )
    )
    (for (in (tuple slot flag) (. peer checked-rows))
      (let place (call (. peer node-place) ids starts slot))
      (if (!= place (. U32 max))
        (= ([] checked-rows place) flag)
      )
    )
    (for (in (tuple key flag) (. peer marking-arms))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (= ([] marking-arms (/or/ (/lshift/ (as (call (. ids instance) owner) Size) 32) arm-syntax)) flag)
        (lazy arm-syntax (/and/ key (as (. U32 max) Size)))
      )
    )
    (for (in (tuple key flag) (. peer inside-reads))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (= ([] inside-reads (/or/ (/lshift/ (as (call (. ids instance) owner) Size) 32) inside-syntax)) flag)
        (lazy inside-syntax (/and/ key (as (. U32 max) Size)))
      )
    )
    (for (in (tuple key flag) (. peer dominated-reads))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (= ([] dominated-reads (/or/ (/lshift/ (as (call (. ids instance) owner) Size) 32) dominated-syntax)) flag)
        (lazy dominated-syntax (/and/ key (as (. U32 max) Size)))
      )
    )
    (for (in (tuple key flag) (. peer spanning-arms))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (= ([] spanning-arms (/or/ (/lshift/ (as (call (. ids instance) owner) Size) 32) spanning-syntax)) flag)
        (lazy spanning-syntax (/and/ key (as (. U32 max) Size)))
      )
    )
    (for (in (tuple key span) (. peer spanning-its))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (= ([] spanning-its (/or/ (/lshift/ (as (call (. ids instance) owner) Size) 32) span-syntax)) (call (. ids type) span))
        (lazy span-syntax (/and/ key (as (. U32 max) Size)))
      )
    )
  )
  (fn-do _ absorb-styles _
    (param peer Facts)
    (param ids PeerIds)
    (param domains (list U32))
    (param sheeted PeerSheets)
    ; Takes in the domains of invalidation, the codings, the styles and the gates the peer made, each
    ; that this pass lacks, by its key: a domain by its name, a coding by its type, a style by its type
    ; with its properties in order and the domains changes to them raise, and a gate by its type, its
    ; `when`s and whether it gates content. A coding's holder of objects is taken where only the peer
    ; made one. Then takes in what the peer's instances that this pass takes from it recorded of
    ; styles and of the arguments of markup elements they store, each row of those it names numbered
    ; here: a style sheet by `absorb-sheets`, and a projection and a value evaluated from the slots of
    ; a sheet the first time one is named (`PeerSheets`). A value evaluated once for every making is
    ; kept for the instance whose stable key is least, as typing keeps it (`note-static-value`).
    (for (in row (. peer style-codings))
      (let type (call (. ids type) (. row type)))
      (let found (. U32 max))
      (for (in position (..< 0 (. style-codings length)))
        (if (== (. ([] style-codings position) type) type)
          (= found (as position U32))
        )
      )
      (if (== found (. U32 max))
        (+= style-codings
          (call StyleCoding
            (block
              (arg type)
              (arg (call (. ids instance) (. row intern)))
              (arg (call (. ids instance) (. row holder)))
              (arg (call (. ids type) (. row taken)))
              (arg (call (. ids instance) (. row value-holder)))
            )
          )
        )
        (else-if (== (. ([] style-codings found) value-holder) no-instance)
          (= (. ([] style-codings found) value-holder) (call (. ids instance) (. row value-holder)))
        )
      )
    )
    (let properties (list U32))
    (for (in _ (..< 0 (. peer style-properties length)))
      (+= properties (. U32 max))
    )
    (for (in row (. peer style-uses))
      (let type (call (. ids type) (. row type)))
      (let first (. U32 max))
      (for (in held style-uses)
        (if (== (. held type) type)
          (throw (call Panic "A style of another type pass has other properties here") (if (!= (. held count) (. row count))))
          (blank)
          (= first (. held first))
        )
      )
      (if (== first (. U32 max))
        (= first (as (. style-properties length) U32))
        (for (in offset (..< 0 (. row count)))
          (let property (as ([] (. peer style-properties) (+ (. row first) offset)) StyleProperty))
          (= (. property type) (call (. ids type) (. property type)))
          (+= style-properties property)
        )
        (for (in held (. peer property-domains))
          (if (and (>= (. held property) (. row first)) (< (. held property) (+ (. row first) (. row count))))
            (+= property-domains
              (call PropertyDomain
                (block
                  (arg (- (+ first (. held property)) (. row first)))
                  (arg ([] domains (. held domain)))
                  (arg (. held parent))
                )
              )
            )
          )
        )
        (+= style-uses (call StyleUse type (call (. ids instance) (. row singleton)) first (. row count)))
      )
      (for (in offset (..< 0 (. row count)))
        (= ([] properties (+ (. row first) offset)) (+ first offset))
      )
    )
    (let gates (list U32))
    (for (in row (. peer style-gates))
      (let whens (list StyleWhen))
      (for (in offset (..< 0 (. row count)))
        (let held (as ([] (. peer style-gate-whens) (+ (. row first) offset)) StyleWhen))
        (= (. held test) (call (. ids instance) (. held test)))
        (+= whens held)
      )
      (let type (call (. ids type) (. row type)))
      (let found (call gate-of type whens (. row content)))
      (if (== found (. U32 max))
        (= found (as (. style-gates length) U32))
        (+= style-gates
          (call StyleGate
            (block
              (arg type)
              (arg (as (. style-gate-whens length) U32))
              (arg (. row count))
              (arg (call (. ids instance) (. row action)))
              (arg (. row content))
            )
          )
        )
        (for (in held whens)
          (+= style-gate-whens held)
        )
      )
      (+= gates found)
    )
    (for (in row (. peer style-declarations))
      (if (call (. ids owns) (. row instance))
        (let fact (as row StyleDeclaration))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact style) (call (. ids type) (. row style)))
        (= (. fact property) (call moved-row properties (. row property)))
        (= (. fact sheet) (call moved-sheet (. sheeted sheets) (. row sheet)))
        (= (. fact projection) (call moved-projection peer sheeted (. row projection)))
        (= (. fact themed) (call moved-themed peer ids sheeted (. row themed)))
        (call add-style-declaration fact)
      )
    )
    (for (in row (. peer style-authors))
      (if (call (. ids owns) (. row instance))
        (+= style-authors (call StyleAuthor (call (. ids instance) (. row instance)) (. row site)))
      )
    )
    (for (in row (. peer style-static-values))
      (if (call (. ids owns) (. row instance))
        (call note-static-value (. row module) (. row site) (call (. ids instance) (. row instance)) (call (. ids type) (. row type)))
      )
    )
    (for (in row (. peer style-writes))
      (if (call (. ids owns) (. row instance))
        (+= style-writes
          (call StyleWrite
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids type) (. row style)))
              (arg (call moved-row properties (. row property)))
            )
          )
        )
      )
    )
    (for (in row (. peer style-reads))
      (if (call (. ids owns) (. row instance))
        (let fact (as row StyleRead))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact style) (call (. ids type) (. row style)))
        (= (. fact reader) (call (. ids instance) (. row reader)))
        (= (. fact type) (call (. ids type) (. row type)))
        (if (== (. row sheet) (. U32 max))
          (= (. fact property) (call moved-row properties (. row property)))
          (else
            (= (. fact sheet) (call moved-sheet (. sheeted sheets) (. row sheet)))
          )
        )
        (+= style-reads fact)
      )
    )
    (for (in row (. peer style-flags))
      (if (call (. ids owns) (. row instance))
        (+= style-flags
          (call StyleFlag
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call moved-row domains (. row domain)))
              (arg (call (. ids instance) (. row call)))
            )
          )
        )
      )
    )
    (for (in row (. peer rule-updates))
      (if (call (. ids owns) (. row instance))
        (+= rule-updates
          (call RuleUpdate
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids property) (. row property)))
              (arg (. row reads-given))
            )
          )
        )
      )
    )
    (for (in row (. peer element-stores))
      (if (call (. ids owns) (. row instance))
        (let instance (call (. ids instance) (. row instance)))
        (call note-element-store
          (block
            (arg
              (call ElementStore
                (block
                  (arg instance)
                  (arg (. row site))
                  (arg (. row argument))
                  (arg (call (. ids property) (. row property)))
                  (arg (. row converted))
                  (arg (. row setter))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer coding-users))
      (if (call (. ids owns) (. row instance))
        (+= coding-users (call CodingUser (call (. ids instance) (. row instance)) (call (. ids type) (. row type)) (. row holds)))
      )
    )
    (for (in row (. peer gate-users))
      (if (call (. ids owns) (. row instance))
        (+= gate-users (call GateUser (call (. ids instance) (. row instance)) (call moved-row gates (. row gate))))
      )
    )
    (for (in row (. peer domain-users))
      (if (call (. ids owns) (. row instance))
        (let user (as row DomainUser))
        (= (. user instance) (call (. ids instance) (. row instance)))
        (= (. user domain) (call moved-row domains (. row domain)))
        (+= domain-users user)
      )
    )
  )
  (fn-expr _ moved-row U32
    (param taken (list U32))
    (param row U32)
    (before
      ; The place here of a row of a registry the peer numbered `row`, which is one taken in.
      (throw (call Panic "A fact of another type pass names a row of a registry not taken in") (if (or (>= (as row Size) (. taken length)) (== ([] taken row) (. U32 max)))))
    )
    ([] taken row)
  )
  (fn-do _ absorb-domains (list U32)
    (param peer Facts)
    (let domains (list U32))
    (for (in row (. peer style-domains))
      (let found (. U32 max))
      (for (in position (..< 0 (. style-domains length)))
        (if (== (. ([] style-domains position) name) (. row name))
          (= found (as position U32))
        )
      )
      (if (== found (. U32 max))
        (= found (as (. style-domains length) U32))
        (+= style-domains (call StyleDomain (. row name)))
      )
      (+= domains found)
    )
    (return domains)
  )
  (fn-do _ absorb-sheets (list U32)
    (param peer Facts)
    (param ids PeerIds)
    (param domains (list U32))
    (let sheets (list U32))
    (for (in row (. peer style-sheet-uses))
      (let type (call (. ids type) (. row type)))
      (let found (. U32 max))
      (for (in position (..< 0 (. style-sheet-uses length)))
        (if (== (. ([] style-sheet-uses position) type) type)
          (= found (as position U32))
        )
      )
      (if (== found (. U32 max))
        (let first (as (. sheet-slots length) U32))
        (for (in offset (..< 0 (. row count)))
          (let slot (as ([] (. peer sheet-slots) (+ (. row first) offset)) SheetSlot))
          (= (. slot type) (call (. ids type) (. slot type)))
          (= (. slot domains) (call moved-domains domains (. slot domains)))
          (+= sheet-slots slot)
        )
        (for (in member (. peer sheet-members))
          (if (== (. member root) (. row type))
            (let start (as (. sheet-member-slots length) U32))
            (for (in position (..< (. member first) (+ (. member first) (. member count))))
              (+= sheet-member-slots ([] (. peer sheet-member-slots) position))
            )
            (+= sheet-members
              (call SheetMember
                (block
                  (arg type)
                  (arg (call (. ids type) (. member type)))
                  (arg (call (. ids instance) (. member singleton)))
                  (arg start)
                  (arg (. member count))
                )
              )
            )
          )
        )
        (= found (as (. style-sheet-uses length) U32))
        (+= style-sheet-uses (call StyleSheetUse type (call (. ids instance) (. row singleton)) first (. row count)))
      )
      (+= sheets found)
    )
    (return sheets)
  )
  (fn-do _ moved-domains U32
    (param domains (list U32))
    (param mask U32)
    (let moved 0u32)
    (for (in position (..< 0 (. domains length)))
      (if (and (< position 32) selected (< ([] domains position) 32))
        (= moved (/or/ moved (/lshift/ 1u32 (as ([] domains position) Size))))
      )
      (lazy selected (!= (/and/ mask (/lshift/ 1u32 (as position Size))) 0))
    )
    (return moved)
  )
  (fn-expr _ moved-sheet U32
    (param sheets (list U32))
    (param sheet U32)
    (if-expr (>= sheet (- (. U32 max) 1)) sheet ([] sheets sheet))
  )
  (fn-do _ unmoved-rows (list U32)
    (param count Size)
    (let rows (list U32))
    (for (in _ (..< 0 count))
      (+= rows (. U32 max))
    )
    (return rows)
  )
  (fn-do _ moved-projection U32
    (param peer Facts)
    (param sheeted PeerSheets)
    (param projection U32)
    (return-if projection (if (>= projection (- (. U32 max) 1))))
    (blank)
    (let held ([] (. sheeted projections) projection))
    (return-if held (if (!= held (. U32 max))))
    (blank)
    (let row (as ([] (. peer style-projections) projection) StyleProjection))
    (if (== (. row kind) 2)
      (let first (as (. projection-tags length) U32))
      (for (in offset (..< (. row first) (+ (. row first) (. row count))))
        (+= projection-tags ([] (. peer projection-tags) offset))
      )
      (= (. row first) first)
    )
    (let place (as (. style-projections length) U32))
    (+= style-projections row)
    (= ([] (. sheeted projections) projection) place)
    (return place)
  )
  (fn-do _ moved-themed U32
    (param peer Facts)
    (param ids PeerIds)
    (param sheeted PeerSheets)
    (param row U32)
    (return-if row (if (== row (. U32 max))))
    (blank)
    (let held ([] (. sheeted themed) row))
    (return-if held (if (!= held (. U32 max))))
    (blank)
    (let value ([] (. peer style-themed-values) row))
    (let instance (call (. ids instance) (. value instance)))
    (let type (call (. ids type) (. value type)))
    (let sheet (call moved-sheet (. sheeted sheets) (. value sheet)))
    (let place (. U32 max))
    (if (== (. value given) (. U32 max))
      (= place (call note-themed-value (. value module) (. value site) instance type sheet))
      (else
        (let givens (list ThemedGiven))
        (for (in position (..< (. value given) (+ (. value given) (. value given-count))))
          (let given ([] (. peer themed-givens) position))
          (+= givens (call ThemedGiven (call (. ids slot) (. given param)) (. given slot)))
        )
        (= place (call note-given-themed-value (. value module) (. value site) instance type sheet givens))
      )
    )
    (= ([] (. sheeted themed) row) place)
    (return place)
  )
  (fn-do _ absorb-themes _
    (param peer Facts)
    (param ids PeerIds)
    (param sheeted PeerSheets)
    (param applications (list U32))
    (for (in row (. peer theme-reads))
      (if (call (. ids owns) (. row instance))
        (call add-theme-read
          (block
            (arg
              (call ThemeRead
                (block
                  (arg (call (. ids instance) (. row instance)))
                  (arg (. row module))
                  (arg (. row site))
                  (arg (call moved-sheet (. sheeted sheets) (. row sheet)))
                  (arg (. row slot))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer rule-slots))
      (let application ([] applications (. row application)))
      (if (!= application (. U32 max))
        (call add-rule-slot
          (block
            (arg
              (call RuleSlot
                (block
                  (arg application)
                  (arg (. row site))
                  (arg (call moved-sheet (. sheeted sheets) (. row sheet)))
                  (arg (. row slot))
                  (arg (call moved-projection peer sheeted (. row projection)))
                )
              )
            )
          )
        )
      )
    )
    (for (in row (. peer rule-themes))
      (let application ([] applications (. row application)))
      (if (!= application (. U32 max))
        (call add-rule-theme
          (block
            (arg (call RuleTheme application (. row site) (call moved-themed peer ids sheeted (. row themed))))
          )
        )
      )
    )
  )
  (fn-do _ absorb-markup _
    (param peer Facts)
    (param ids PeerIds)
    (param call-ids (list FactId))
    (param conversion-ids (list FactId))
    ; Takes in what the peer's instances that this pass takes from it recorded of markup, of tracked
    ; values and of the events they use, with the event runtime's functions that close an object's
    ; events and register a lowered section where this pass has none yet. A markup trigger's target
    ; is numbered here, among the targets of descendant queries this pass took in first
    ; (`merge-sessions`). Each markup query the peer recorded that this pass lacks is taken in by its
    ; class and property, with its target numbered so and the conversion of an object of the class
    ; to its markup host: the one taken in with the instance that recorded it, or else a copy no node
    ; leads to. A registration names the query here. Each rule the peer runs once markup has, and this
    ; pass does not, is taken in by its instance.
    (let queries (list U32))
    (for (in row (. peer markup-queries))
      (let level (call (. ids type) (. row level)))
      (let place (call (. ids property) (. row place)))
      (let found (. U32 max))
      (for (in offset (..< 0 (. markup-queries length)))
        (if (and (== (. ([] markup-queries offset) level) level) (== (. ([] markup-queries offset) place) place))
          (= found (as offset U32))
        )
      )
      (if (== found (. U32 max))
        (let fact (as row MarkupQuery))
        (= (. fact level) level)
        (= (. fact place) place)
        (= (. fact target) (call (. ids type) (. row target)))
        (if (!= (. row target-id) 0)
          (= (. fact target-id) (as (+ (!! (call (. query-targets find) (. fact target))) 1) U32))
        )
        (= (. fact hosted) ([] conversion-ids (. row hosted)))
        (if (== (. fact hosted) no-fact)
          (let moved (call absorb-conversion peer ids ([] (. peer conversions) (. row hosted))))
          (= (. moved next) no-fact)
          (let hosted FactId (as (. conversions length) FactId))
          (call (. conversions append) moved)
          (call chain-fact conversion-lasts conversion-priors (. moved instance) hosted)
          (= (. fact hosted) hosted)
        )
        (= (. fact parent) (call (. ids instance) (. row parent)))
        (= (. fact add) (call (. ids instance) (. row add)))
        (= (. fact remove) (call (. ids instance) (. row remove)))
        (= found (as (. markup-queries length) U32))
        (+= markup-queries fact)
      )
      (+= queries found)
    )
    (for (in row (. peer query-registrations))
      (if (call (. ids owns) (. row instance))
        (let query (if-expr (!= (. row query) (. U32 max)) (call moved-row queries (. row query)) (. U32 max)))
        (+= query-registrations
          (call QueryRegistration
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids type) (. row level)))
              (arg query)
              (arg (call (. ids instance) (. row register)))
            )
          )
        )
      )
    )
    (for (in row (. peer change-tests))
      (if (call (. ids owns) (. row instance))
        (call note-change-test (call (. ids instance) (. row instance)) (call (. ids instance) (. row tester)) (. row hosted))
      )
    )
    (for (in row (. peer markup-reads))
      (if (call (. ids owns) (. row instance))
        (+= markup-reads
          (call MarkupRead
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids instance) (. row reader)))
              (arg (call (. ids type) (. row target)))
            )
          )
        )
      )
    )
    (for (in row (. peer row-item-reads))
      (if (call (. ids owns) (. row instance))
        (+= row-item-reads (call RowItemRead (call (. ids instance) (. row instance)) (. row site) (call (. ids type) (. row held))))
      )
    )
    (for (in row (. peer collection-reads))
      (if (call (. ids owns) (. row instance))
        (+= collection-reads (call CollectionRead (call (. ids instance) (. row instance)) (. row site)))
      )
    )
    (for (in row (. peer pulled-sites))
      (if (call (. ids owns) (. row instance))
        (+= pulled-sites (call PulledSite (call (. ids instance) (. row instance)) (. row site)))
      )
    )
    (for (in row (. peer event-uses))
      (if (call (. ids owns) (. row instance))
        (let fact (as row EventUse))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact owner) (call (. ids type) (. row owner)))
        (= (. fact first) (call (. ids instance) (. row first)))
        (= (. fact second) (call (. ids instance) (. row second)))
        (= (. fact callback) (call (. ids instance) (. row callback)))
        (+= event-uses fact)
      )
    )
    (for (in row (. peer element-roots))
      (if (call (. ids owns) (. row instance))
        (+= element-roots
          (call ElementRoot
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids instance) (. row ensure)))
              (arg (call (. ids instance) (. row mount)))
              (arg (. row owns))
            )
          )
        )
      )
    )
    (for (in row (. peer named-stores))
      (if (call (. ids owns) (. row instance))
        (call note-named-store
          (block
            (arg (call NamedStore (call (. ids instance) (. row instance)) (. row site) (call (. ids property) (. row property))))
          )
        )
      )
    )
    (for (in row (. peer slot-outlets))
      (if (call (. ids owns) (. row instance))
        (let fact (as row SlotOutlet))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact content) (call (. ids type) (. row content)))
        (= (. fact held) (call (. ids slot) (. row held)))
        (= (. fact chosen) (call (. ids instance) (. row chosen)))
        (= (. fact picks) (call (. ids type) (. row picks)))
        (= (. fact arm) (call (. ids type) (. row arm)))
        (+= slot-outlets fact)
      )
    )
    (for (in row (. peer slot-choices))
      (if (call (. ids owns) (. row instance))
        (+= slot-choices
          (call SlotChoice
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (. row line))
              (arg (call (. ids type) (. row choice)))
              (arg (call (. ids instance) (. row create)))
              (arg (call (. ids instance) (. row fill)))
              (arg (call (. ids type) (. row selector)))
            )
          )
        )
      )
    )
    (for (in row (. peer raised-elements))
      (if (call (. ids owns) (. row instance))
        (call note-raised (call (. ids instance) (. row instance)) (. row block) (. row element))
      )
    )
    (for (in (tuple key element) (. peer raised-sites))
      (let owner (as (/rshift/ key 32) InstanceId))
      (if (call (. ids owns) owner)
        (let block (!! ([] (. peer raised-blocks) (/or/ (/lshift/ (as owner Size) 32) (as element Size)))))
        (call note-raised (call (. ids instance) owner) block element (as (/and/ key (as (. U32 max) Size)) SyntaxId))
      )
    )
    (for (in row (. peer loop-regions))
      (if (call (. ids owns) (. row instance))
        (let fact (as row LoopRegion))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact host) (call (. ids type) (. row host)))
        (= (. fact content) (call (. ids type) (. row content)))
        (= (. fact source) (call (. ids type) (. row source)))
        (= (. fact create) (call (. ids instance) (. row create)))
        (= (. fact updater) (call (. ids instance) (. row updater)))
        (= (. fact action) (call (. ids instance) (. row action)))
        (= (. fact structural) (call (. ids instance) (. row structural)))
        (= (. fact ensure) (call (. ids instance) (. row ensure)))
        (= (. fact replace) (call (. ids instance) (. row replace)))
        (= (. fact adapts) (call (. ids instance) (. row adapts)))
        (+= loop-regions fact)
      )
    )
    (for (in row (. peer branch-regions))
      (if (call (. ids owns) (. row instance))
        (let fact (as row BranchRegion))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact host) (call (. ids type) (. row host)))
        (= (. fact content) (call (. ids type) (. row content)))
        (= (. fact list) (call (. ids type) (. row list)))
        (= (. fact selected) (call (. ids type) (. row selected)))
        (= (. fact create) (call (. ids instance) (. row create)))
        (= (. fact updater) (call (. ids instance) (. row updater)))
        (= (. fact action) (call (. ids instance) (. row action)))
        (= (. fact structural) (call (. ids instance) (. row structural)))
        (= (. fact keeps) (call (. ids instance) (. row keeps)))
        (= (. fact select) (call (. ids instance) (. row select)))
        (= (. fact ensure) (call (. ids instance) (. row ensure)))
        (+= branch-regions fact)
      )
    )
    (for (in row (. peer markup-triggers))
      (if (call (. ids owns) (. row instance))
        (let fact (as row MarkupTrigger))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact target) (call (. ids type) (. row target)))
        (if (!= (. row target-id) 0)
          (= (. fact target-id) (as (+ (!! (call (. query-targets find) (. fact target))) 1) U32))
        )
        (= (. fact found) (call (. ids type) (. row found)))
        (= (. fact host) (call (. ids type) (. row host)))
        (= (. fact changes) (call (. ids type) (. row changes)))
        (= (. fact made) (call (. ids instance) (. row made)))
        (= (. fact clear) (call (. ids instance) (. row clear)))
        (= (. fact record) (call (. ids instance) (. row record)))
        (= (. fact register) (call (. ids instance) (. row register)))
        (= (. fact parent) (call (. ids instance) (. row parent)))
        (= (. fact schedule) (call (. ids instance) (. row schedule)))
        (+= markup-triggers fact)
      )
    )
    (for (in row (. peer deferred-values))
      (if (call (. ids owns) (. row instance))
        (let places (list U32))
        (for (in position (..< (. row start) (+ (. row start) (. row count))))
          (+= places (call (. ids property) ([] (. peer deferred-places) position)))
        )
        (call note-deferred (call (. ids instance) (. row instance)) places)
      )
    )
    (for (in row (. peer region-roots))
      (if (call (. ids owns) (. row instance))
        (+= region-roots
          (call RegionRoot
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids slot) (. row slot)))
              (arg (call (. ids type) (. row batch)))
              (arg (call (. ids instance) (. row ensure)))
            )
          )
        )
      )
    )
    (for (in row (. peer whenever-calls))
      (if (call (. ids owns) (. row instance))
        (+= whenever-calls
          (call WheneverCalls
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row owns))
              (arg (call moved call-ids (. row subscribe)))
              (arg (call moved call-ids (. row unsubscribe)))
            )
          )
        )
      )
    )
    (for (in row (. peer live-statements))
      (if (call (. ids owns) (. row instance))
        (let fact (as row LiveStatement))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact rerun) (call (. ids instance) (. row rerun)))
        (= (. fact property) (call (. ids property) (. row property)))
        (= (. fact owned) (call (. ids instance) (. row owned)))
        (= (. fact holder) (call (. ids type) (. row holder)))
        (+= live-statements fact)
      )
    )
    (for (in row (. peer owned-subscriptions))
      (if (call (. ids owns) (. row instance))
        (+= owned-subscriptions
          (call OwnedSubscription
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids instance) (. row subscription)))
              (arg (call (. ids instance) (. row tracker)))
            )
          )
        )
      )
    )
    (for (in row (. peer tracked-locals))
      (if (call (. ids owns) (. row instance))
        (call note-tracked-local (call (. ids instance) (. row instance)) (. row site))
      )
    )
    (for (in row (. peer latest-reads))
      (if (call (. ids owns) (. row instance))
        (+= latest-reads
          (call LatestRead
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg (. row site))
              (arg (call (. ids type) (. row stream)))
              (arg (call (. ids instance) (. row tracker)))
              (arg (call (. ids instance) (. row publisher)))
            )
          )
        )
      )
    )
    (for (in closer (. peer event-closers))
      (if (call (. ids owns) closer)
        (+= event-closers (call (. ids instance) closer))
      )
    )
    (if (== event-close no-instance)
      (= event-close (call (. ids instance) (. peer event-close)))
    )
    (if (== event-register no-instance)
      (= event-register (call (. ids instance) (. peer event-register)))
    )
    (if (== event-register-arrival no-instance)
      (= event-register-arrival (call (. ids instance) (. peer event-register-arrival)))
    )
    (if (== machine-own no-instance)
      (= machine-own (call (. ids instance) (. peer machine-own)))
    )
    (if (== machine-stop no-instance)
      (= machine-stop (call (. ids instance) (. peer machine-stop)))
    )
    (if (== machine-close no-instance)
      (= machine-close (call (. ids instance) (. peer machine-close)))
    )
    (if (== task-owner-make no-instance)
      (= task-owner-make (call (. ids instance) (. peer task-owner-make)))
    )
    (for (in unit (. peer markup-rules))
      (let rule (call (. ids instance) unit))
      (if (not (call waits-for-markup rule))
        (+= markup-rules rule)
      )
    )
  )
  (fn-do _ absorb-plans _
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in the plans of the event handlers of the classes the peer planned that this pass has not:
    ; each class with its handlers, in the order the peer planned them, and each section a plan
    ; subscribes or a branch of the markup subscribes again, once. Then takes in the sections the
    ; peer's instances that this pass takes from it typed, those typed as run from tables among the
    ; sections so typed. Those it takes are typed as the plans of every peer together say
    ; (`merge-sessions`).
    (for (in receiver (. peer lowered-types))
      (let type (call (. ids type) receiver))
      (let known false)
      (for (in planned lowered-types)
        (= known (or known (== planned type)))
      )
      (if known
        (continue)
      )
      (+= lowered-types type)
      (for (in row (. peer lowered-handlers))
        (if (== (. row type) receiver)
          (+= lowered-handlers
            (call LoweredHandler
              (block
                (arg type)
                (arg (call (. ids type) (. row level)))
                (arg (. row module))
                (arg (. row decl))
                (arg (. row syntax))
                (arg (call (. ids type) (. row owner)))
                (arg (. row name))
                (arg (. row order))
                (arg (. row arrives))
              )
            )
          )
        )
      )
    )
    (for (in row (. peer subscribed-sections))
      (let level (call (. ids type) (. row level)))
      (if (not (call holds-section subscribed-sections level (. row module) (. row syntax)))
        (+= subscribed-sections (call SectionRef level (. row module) (. row syntax)))
      )
    )
    (for (in row (. peer rebinding-sections))
      (let level (call (. ids type) (. row level)))
      (if (not (call holds-section rebinding-sections level (. row module) (. row syntax)))
        (+= rebinding-sections (call SectionRef level (. row module) (. row syntax)))
      )
    )
    (for (in row (. peer typed-sections))
      (if (call (. ids owns) (. row instance))
        (let level (call (. ids type) (. row level)))
        (+= typed-sections
          (call TypedSection
            (block
              (arg (call (. ids instance) (. row instance)))
              (arg level)
              (arg (. row module))
              (arg (. row syntax))
              (arg (. row lowered))
            )
          )
        )
        (if (and (. row lowered) (not (call holds-section lowered-sections level (. row module) (. row syntax))))
          (+= lowered-sections (call SectionRef level (. row module) (. row syntax)))
        )
      )
    )
  )
  (fn-do _ owned-starts (list U64)
    (param ids PeerIds)
    ; The first node of each instance of this pass that a peer takes from it, above the instance,
    ; in the order of their first nodes. An instance that holds no nodes is left out: its first node
    ; would be that of the instance whose nodes come next.
    (let starts (list U64))
    (for (in id (..< 0 (. instances rows length)))
      (let row ([] (. instances rows) id))
      (if (and (!= (. row node-start) (. U32 max)) (!= (. row subtree count) 0) (call (. ids owns) (as id InstanceId)))
        (+= starts (/or/ (/lshift/ (as (. row node-start) U64) 32) (as id U64)))
      )
    )
    (return (call sort starts))
  )
  (fn-do _ node-place U32
    (param ids PeerIds)
    (param starts (list U64))
    (param slot Size)
    ; The place among the nodes of the pass that takes from this one of the node at `slot` here, or
    ; `U32.max` where the node is of an instance that pass does not take.
    (let low Size 0)
    (let high Size (. starts length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= (as (/rshift/ ([] starts middle) 32) Size) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (if (== low 0)
      (return (. U32 max))
    )
    (let found ([] starts (- low 1)))
    (let instance (as (/and/ found (as (. U32 max) U64)) InstanceId))
    (let row ([] (. instances rows) instance))
    (if (>= slot (as (+ (. row node-start) (. row subtree count)) Size))
      (return (. U32 max))
    )
    (return (- (+ (. ([] (. ids instances rows) (call (. ids instance) instance)) node-start) (as slot U32)) (. row node-start)))
  )
)

(fn-expr + table-member TableOp
  (param name String)
  ; The operation of a member of an arena's table that the compiler answers where it is called or
  ; read, as TypeScript answers it, or `table-row` for one it leaves to its body.
  (match name
    (case= "append"
      (. TableOp table-append)
    )
    (case= "reserve"
      (. TableOp table-reserve)
    )
    (case= "extend"
      (. TableOp table-extend)
    )
    (case= "truncate"
      (. TableOp table-truncate)
    )
    (case= "clear"
      (. TableOp table-clear)
    )
    (case= "copy-from"
      (. TableOp table-copy-from)
    )
    (case= "finish"
      (. TableOp table-finish)
    )
    (case= "view"
      (. TableOp table-view)
    )
    (case= "rewind"
      (. TableOp table-rewind)
    )
    (case= "storage-checkpoint"
      (. TableOp table-storage-checkpoint)
    )
    (case= "validate-storage-restore"
      (. TableOp table-validate-restore)
    )
    (case= "restore-storage"
      (. TableOp table-restore-storage)
    )
    (case= "mark"
      (. TableOp table-mark)
    )
    (case= "capacity"
      (. TableOp table-capacity)
    )
    (default
      (. TableOp table-row)
    )
  )
)

(fn-expr + compares-in-place Bool
  (param plan OperatorPlan)
  ; Whether a comparison is one the reference makes with no call of its own: of tuples, structs
  ; or unions field by field, of objects or atoms by identity, of an optional with `null`, of
  ; values never equal, or a test of an object's class. The calls a field-by-field comparison
  ; makes are recorded, and the frame sees them.
  (or structural (== plan .plan-absent) (== plan .plan-unlike) (== plan .plan-class-test))
  (where
    (lazy structural (or (== plan .plan-fields) (== plan .plan-not-fields) (== plan .plan-identity)))
  )
)

(fn-expr + is-float-math Bool
  (param plan OperatorPlan)
  (or (== plan .plan-f64-sqrt) (== plan .plan-f64-abs) (== plan .plan-f64-min) (== plan .plan-f64-max))
)

(fn-expr + is-applied Bool
  (param reason ConversionReason)
  ; Whether some shape here applies the conversions recorded for a reason. Generated content
  ; applies the object of its markup element made a `MarkupElement`, and the function that builds
  ; it made a `MarkupSlotBuilder`, at the line that builds it (`generate-content`). A write to an
  ; event that bubbles applies its object made an `EventNode` (`emit-publish`, `emit-route`).
  (case? (or (== reason .reason-argument) (== reason .reason-print) (== reason .reason-operand))
    true
  )
  (case? (or (== reason .reason-markup-host) (== reason .reason-markup-slot) (== reason .reason-markup-arm))
    true
  )
  (case? (or (== reason .reason-explicit) (== reason .reason-return) (== reason .reason-join))
    true
  )
  (case? (== reason .reason-literal-return)
    true
  )
  (case? (or (== reason .reason-promotion) (== reason .reason-result))
    true
  )
  (case? (or (== reason .reason-assignment) (== reason .reason-declaration) (== reason .reason-element))
    true
  )
  (case? (or (== reason .reason-receiver) (== reason .reason-default) (== reason .reason-relation))
    true
  )
  (case? (or (== reason .reason-own-receiver) (== reason .reason-event-node))
    true
  )
  (default
    (or (== reason .reason-operator) (== reason .reason-step) (== reason .reason-piped))
  )
)
