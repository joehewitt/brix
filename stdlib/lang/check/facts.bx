  (fn-do + note-const-array _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param type TypeId)
    (param items (list ConstItem))
    ; Records the items of a ConstArray made at a node of an instance, once for each node.
    (= ([] key-scratch 0) instance)
    (= ([] key-scratch 1) syntax)
    (call (. const-array-keys store) (. key-scratch data) 2)
    (if (not (. const-array-keys last-inserted))
      (return)
    )
    (let first U32 (as (. const-items length) U32))
