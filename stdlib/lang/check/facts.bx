    (let row found)
    (let key (/or/ (/lshift/ (as application Size) 32) (as site Size)))
    (let place ([] rule-slot-places key))
    (if place
      (let slot ([] rule-slots place))
      (= (. row sheet) (. slot sheet))
      (= (. row sheet-slot) (. slot slot))
      (= (. row projection) (. slot projection))
      (return row)
    )
    (let themed ([] rule-theme-places key))
    (if themed
      (= (. row themed) (. ([] rule-themes themed) themed))
      (return row)
