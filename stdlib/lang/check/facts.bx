  (fn-do + note-transform U32
    (param instance InstanceId)
    (param catcher SyntaxId)
    (param site SyntaxId)
    (param exception SyntaxId)
    (param source TypeId)
    (param chain (list TypeId))
    (param raised TypeId)
    ; Records an error transformer an instance declares, and answers its place.
