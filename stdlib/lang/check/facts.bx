  (fn-do + style-declaration-of (? StyleDeclaration)
    (param instance InstanceId)
    (param site SyntaxId)
    ; The style declaration an attribute line of an instance makes, or none.
    (let place (call first-style-declaration instance))
    (while (!= place (. U32 max))
      (if (== (. ([] style-declarations place) site) site)
        (return ([] style-declarations place))
