    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The place among `element-stores` of the first argument of a markup element that is stored
    ; in a property once the object is made, or `U32.max` where none is.
    (?? ([] element-store-rows (/or/ (/lshift/ (as instance Size) 32) (as syntax Size))) (. U32 max))
  )
  (fn-expr + is-recursive-rule Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Whether a local rule of an instance calls itself.
