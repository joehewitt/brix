  (fn-do + record-pair _
    (param instance InstanceId)
    (param from TypeId)
    (param to TypeId)
    (param relation Relation)
    (let fact
      (call PairFact
        (block
          (arg instance)
          (arg from)
          (arg to)
          (arg (. relation kind))
          (arg (. relation rank))
          (arg (. relation match))
          (arg (. relation unified))
          (arg (. relation ratio))
        )
      )
    )
    (call (. pairs append) fact)
  )
  (fn-do + require-equality _
    (param interface TypeId)
    ; Notes an interface whose values are compared: every type that implements it needs the
    ; function that compares two of its own.
    (for (in known equalities)
      (if (== known interface)
        (return)
      )
    )
    (+= equalities interface)
  )
  (fn-do + record-relation _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param from TypeId)
    (param to TypeId)
    (param unifies Bool)
    (call (. relations append) (call RelationFact instance syntax from to unifies))
  )
  (fn-do + relation-at FactId
    (param instance InstanceId)
    (param syntax SyntaxId)
    (for (in reverse (..< 0 (. relations length)))
      (let position (- (. relations length) 1 reverse))
      (if (and (== (. ([] relations position) instance) instance) (== (. ([] relations position) syntax) syntax))
        (return (as position FactId))
      )
    )
    (return no-fact)
  )
  (fn-do + record-conversion FactId
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param relation Relation)
    (param reason ConversionReason)
    (param callee InstanceId (= no-instance))
    (let fact
      (call ConversionFact
        (block
          (arg instance)
          (arg syntax)
          (arg (. relation from))
          (arg (. relation to))
          (arg (. relation kind))
          (arg (. relation rank))
          (arg reason)
          (arg (. relation ratio))
          (arg callee)
        )
      )
    )
    (let id FactId (as (. conversions length) FactId))
    (call (. conversions append) fact)
    (call chain-fact conversion-lasts conversion-priors instance id)
    (= (. ([] conversions id) case-index) (. relation case-index))
    (call link-conversion instance syntax id)
    (return id)
  )
  (fn-do + record-part FactId
    (param instance InstanceId)
    (param relation Relation)
    (param reason ConversionReason)
    (param callee InstanceId)
    ; Adds the conversion of one field of a tuple or struct. No node leads to it: the conversion
    ; of the whole does, through its `parts`, and each part leads to the next field's.
    (let fact
      (call ConversionFact
        (block
          (arg instance)
          (arg 0)
          (arg (. relation from))
          (arg (. relation to))
          (arg (. relation kind))
          (arg (. relation rank))
          (arg reason)
          (arg (. relation ratio))
          (arg callee)
        )
      )
    )
    (let id FactId (as (. conversion-parts length) FactId))
    (call (. conversion-parts append) fact)
    (= (. ([] conversion-parts id) case-index) (. relation case-index))
    (return id)
  )
  (fn-do + dispatches-to Bool
    (param caller InstanceId)
    (param callee InstanceId)
    ; Whether a door calls the door typed under a fake where its effect's slot holds one
    ; (`SwapDispatch`).
    (for (in dispatch swap-dispatches)
      (return-if true (if (and (== (. dispatch instance) caller) (== (. dispatch forwarder) callee))))
    )
    (return false)
  )
  (fn-do + record-call U32
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param callee InstanceId)
    (param form CallForm)
    (param fills (of ImmutableArray U32 ArenaBacking))
    (param is-partial Bool)
    (param links Bool (= true))
    ; Keeps a call, among those of its node unless it is made apart from them, as a value a helper
    ; makes is: such a call is kept with those at no node of the instance's body, and found through
    ; the fact that names it.
    (let start U32 (as (. call-fills length) U32))
    (for (in fill fills)
      (+= call-fills (as fill ArgumentFill))
    )
    (let range (call (of RowRange ArgumentFill) start (as (. fills length) U32)))
    (let fact (call CallFact instance syntax callee form range is-partial))
    (let id FactId (as (. calls length) FactId))
    (call (. calls append) fact)
    (call chain-fact call-lasts call-priors instance id)
    (if links
      (call link-call instance syntax id)
      (else
        (call add-loose-call (call LooseFact instance id true))
      )
    )
    (return id)
  )
  (fn-do + keep-steps (of RowRange U32)
    (param places (list U32))
    (param getters (list InstanceId))
    ; Keeps the places of the properties read from a receiver to what a property it delegates
    ; to holds, in the order they are read, each with the getter that answers it where the type
    ; stores no such property, which emission calls each time the way is read. With no getters
    ; given, they are set later.
    (let start U32 (as (. steps length) U32))
    (for (in position (..< 0 (. places length)))
      (+= steps ([] places position))
      (+= step-callees (if-expr (< position (. getters length)) ([] getters position) no-instance))
    )
    (return (call (of RowRange U32) start (as (. places length) U32)))
  )
  (fn-do + set-loop-place _
    (param instance InstanceId)
    (param loop SyntaxId)
    (param plan OperatorPlan)
    (param base U32)
    ; Plans a loop over a container read where it is kept, with the expression evaluated once
    ; beside what the node's constant already names.
    (let kept U64)
    (let found (call constant-of instance loop))
    (if (!= found no-fact)
      (= kept (% (. ([] constants found) bits) 4294967296))
    )
    (let high U64 base)
    (call set-constant instance loop (call ConstantFact (+ kept (* high 4294967296)) 0.0 null false) plan)
  )
  (fn-expr + loop-base U32
    (param instance InstanceId)
    (param loop SyntaxId)
    ; The expression a loop planned over a place evaluates once, none, or all bits set.
    (as (/ (. ([] constants (call constant-of instance loop)) bits) 4294967296) U32)
  )
  (fn-do + mark-replacing _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Says a node stores an array over an array, which tells the runtime first that the storage of
    ; the old is replaced.
    (let slot (call node-slot instance syntax))
    (if slot
      (= ([] replacing slot) true)
    )
  )
  (fn-expr + is-replacing Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Whether a node stores an array over an array.
    (and (!= slot null) (!= ([] replacing slot) null))
    (where
      (lazy slot (call node-slot instance syntax))
    )
  )
  (fn-do + mark-checked-row _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Says the subject of a match reads a row of a table of unions whose storage TypeScript
    ; checked where it read it: `t[i]`, or a name a loop gives such a row by. The cases a pattern
    ; binds there are read from the columns found then.
    (let slot (call node-slot instance syntax))
    (if slot
      (= ([] checked-rows slot) true)
    )
  )
  (fn-expr + is-checked-row Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Whether the subject of a match reads a row whose storage was checked where it was read.
    (and (!= slot null) (!= ([] checked-rows slot) null))
    (where
      (lazy slot (call node-slot instance syntax))
    )
  )
  (fn-do + mark-leaving _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Says a statement, or a block by its last statement, leaves where it stands and so gives no
    ; value: it raises under no condition, returns, or goes on to a loop's next turn or out of it.
    (let slot (call node-slot instance syntax))
    (if slot
      (= ([] leaving slot) true)
    )
  )
  (fn-expr + is-leaving Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Whether a statement or a block leaves where it stands.
    (and (!= slot null) (!= ([] leaving slot) null))
    (where
      (lazy slot (call node-slot instance syntax))
    )
  )
  (fn-do + set-feed-site _
    (param instance InstanceId)
    (param feed SyntaxId)
    (param site SyntaxId)
    (param below Bool)
    ; Keeps where the facts of a feed are recorded: what converts what it yields, and for one
    ; that gives every item of a container the calls of the container's protocol. The reference
    ; keeps those of the first feed of a list apart from it, beside others. `below` says the
    ; reference locates the loop of a spread on the line under it.
    (let slot (call node-slot instance feed))
    (if slot
      (= ([] feed-sites slot) (+ (as site U64) (if-expr below 4294967296u64 0u64)))
    )
  )
  (fn-do + set-protocol-start _
    (param instance InstanceId)
    (param feed SyntaxId)
    (param site SyntaxId)
    (param mark Size)
    ; Keeps the first call of a container's protocol for a spread of the
    ; container: the first recorded at `site` for the function since `mark`, where the calls of
    ; the protocol follow it beside others.
    (let slot (call node-slot instance feed))
    (if (not slot)
      (return)
    )
    (for (in position (..< mark (. calls length)))
      (let call ([] calls position))
      (if (and (== (. call instance) instance) (== (. call syntax) site))
        (= ([] protocol-starts slot) (as position U32))
        (return)
      )
    )
  )
  (fn-expr + protocol-start FactId
    (param instance InstanceId)
    (param feed SyntaxId)
    ; The first call of the protocol of the container a feed gives every item of, or none.
    (if-expr (not slot) no-fact (?? ([] protocol-starts slot) no-fact))
    (where
      (lazy slot (call node-slot instance feed))
    )
  )
  (fn-do + set-loop-take _
    (param instance InstanceId)
    (param loop SyntaxId)
    (param take LoopTake)
    ; Keeps what the header of a loop does with an item it has read.
    (let slot (call node-slot instance loop))
    (if slot
      (= ([] loop-takes slot) take)
    )
  )
  (fn-expr + loop-take LoopTake
    (param instance InstanceId)
    (param loop SyntaxId)
    ; What the header of a loop does with an item it has read: no more than keep it where the
    ; type pass kept nothing.
    (case? (or (not slot) (not kept))
      .take-whole
    )
    (default
      (as kept LoopTake)
    )
    (where
      (lazy slot (call node-slot instance loop))
      (lazy kept ([] loop-takes slot))
    )
  )
  (fn-expr + feed-site SyntaxId
    (param instance InstanceId)
    (param loop SyntaxId)
    ; Where the facts of a feed are recorded, as `set-feed-site` kept it, and those of any
    ; other node, such as the header of a loop, at the node.
    (case? (or (not slot) (not kept))
      loop
    )
    (default
      (as (% kept 4294967296) SyntaxId)
    )
    (where
      (lazy slot (call node-slot instance loop))
      (lazy kept ([] feed-sites slot))
    )
  )
  (fn-expr + is-feed-below Bool
    (param instance InstanceId)
    (param feed SyntaxId)
    ; Whether the loop of a spread of a container is located on the line
    ; under the feed.
    (case? (not slot)
      false
    )
    (default
      (and (!= kept null) (>= kept 4294967296))
    )
    (where
      (lazy slot (call node-slot instance feed))
      (lazy kept ([] feed-sites slot))
    )
  )
  (fn-do + set-through _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param places (list U32))
    (param getters (list InstanceId))
    ; Plans a node as a read through the properties its object delegates to, and keeps their
    ; places and the getters that answer them.
    (let kept (call keep-steps places getters))
    (let start U64 (. kept start))
    (let count U64 (. kept count))
    (let bits (+ start (* count 4294967296)))
    (call set-constant instance syntax (call ConstantFact bits 0.0 null false) .plan-through)
  )
  (fn-expr + through-of (of RowRange U32)
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The properties a node planned with `plan-through` reads from its object, in the order
    ; they are read.
    (call (of RowRange U32) (as (% bits 4294967296) U32) (as (/ bits 4294967296) U32))
    (where
      (lazy bits (. ([] constants (call constant-of instance syntax)) bits))
    )
  )
  (fn-do + replay-call _
    (param fact CallFact)
    (param instance InstanceId)
    (let id FactId (as (. calls length) FactId))
    (call (. calls append) (call CallFact instance (. fact syntax) (. fact callee) (. fact form) (. fact fills) (. fact is-partial)))
    (call chain-fact call-lasts call-priors instance id)
    (= (. ([] calls id) is-swapped) (. fact is-swapped))
    (= (. ([] calls id) through) (. fact through))
    (call link-call instance (. fact syntax) id)
  )
  (fn-do + replay-calls _
    (param from InstanceId)
    (param into InstanceId)
    ; Records every call of one instance again under another, in syntax order.
    (let row ([] (. instances rows) from))
    (if (!= (. row node-start) (. U32 max))
      (for (in offset (..< 0 (. row subtree count)))
        (let cursor ([] node-calls (+ (. row node-start) offset)))
        (while (!= cursor no-fact)
          (let fact (as ([] calls cursor) CallFact))
          (call replay-call fact into)
          (= cursor (. fact next))
        )
      )
    )
    (let positions (list U32))
    (let loose (call latest-of loose-call-lasts from))
    (while (!= loose no-fact)
      (+= positions loose)
      (= loose (call prior-of loose-call-priors loose))
    )
    (let position (. positions length))
    (while (!= position 0)
      (-= position 1)
      (let fact (as ([] calls (. ([] loose-calls ([] positions position)) fact)) CallFact))
      (call replay-call fact into)
    )
  )
  (fn-do + chain-loose-calls _
    ; Makes the calls an instance recorded at one node outside its body follow each other in the
    ; order they were recorded, as those at a node of a body do. Run once, when every call is
    ; recorded and those of initializers are folded.
    (let tails (call (of Map Size U32) arena))
    (for (in loose loose-calls)
      (let key (+ (* (as (. loose instance) Size) 4294967296) (. ([] calls (. loose fact)) syntax)))
      (let tail ([] tails key))
      (if tail
        (= (. ([] calls tail) next) (. loose fact))
      )
      (= ([] tails key) (. loose fact))
    )
  )
  (fn-do + fold-initializers _
    (param bindings Bindings)
    (param scope (list Bool))
    ; Moves the facts of the value of every global and of every case of an enum to the main of
    ; its module, where emission and the dumps read them: the types and facts at its nodes, the
    ; locals it retained, and every row that names it. A node the main typed itself keeps the
    ; main's type, and gets the initializer's calls, conversions and forces after its own. A
    ; function written in the value, a list of feeds or a lambda, is then written in the main,
    ; which runs the value as the module starts. The value of a class's property keeps its facts,
    ; which differ for each receiver; only what it diagnosed is its main's, so that two receivers
    ; say a thing once.
    (let total (. instances rows length))
    (let mains (list InstanceId))
    (let any false)
    (for (in id (..< 0 total))
      (let row ([] (. instances rows) id))
      (if (or (== (. row initializer) 0) (and (!= (. scope length) 0) (or (>= id (. scope length)) (not ([] scope id)))))
        (+= mains no-instance)
        (else
          (+= mains (call (. instances intern) (. row module) (. row decl) no-type 0 no-instance))
          (= any true)
        )
      )
    )
    (if (not any)
      (return)
    )
    (for (in position (..< 0 (. diagnostics length)))
      (if (!= ([] mains (. ([] diagnostics position) instance)) no-instance)
        (= (. ([] diagnostics position) instance) ([] mains (. ([] diagnostics position) instance)))
      )
    )
    (for (in id (..< 0 total))
      (if (and (!= ([] mains id) no-instance) (call (. instances keeps-facts) (as id InstanceId)))
        (= ([] mains id) no-instance)
      )
    )
    (for (in id (..< 0 total))
      (let enclosing (. ([] (. instances rows) id) enclosing))
      (if (and (!= enclosing no-instance) (!= ([] mains enclosing) no-instance))
        (= (. ([] (. instances rows) id) enclosing) ([] mains enclosing))
      )
    )
    (for (in id (..< 0 total))
      (if (!= ([] mains id) no-instance)
        (let row ([] (. instances rows) id))
        (if (!= (. row binding) no-binding)
          (call reserve-nodes ([] mains id) (. row binding) (. ([] (. bindings bindings) (. row binding)) subtree))
        )
      )
    )
    (call fold-loose mains)
    (for (in id (..< 0 total))
      (if (!= ([] mains id) no-instance)
        (let binding (. ([] (. instances rows) id) binding))
        (let slot-count (if-expr (!= binding no-binding) (. ([] (. bindings bindings) binding) slots count) 0))
        (call fold-nodes (as id InstanceId) ([] mains id) slot-count)
      )
    )
    (for (in position (..< 0 (. calls length)))
      (if (!= ([] mains (. ([] calls position) instance)) no-instance)
        (= (. ([] calls position) instance) ([] mains (. ([] calls position) instance)))
      )
    )
    (for (in position (..< 0 (. conversions length)))
      (if (!= ([] mains (. ([] conversions position) instance)) no-instance)
        (= (. ([] conversions position) instance) ([] mains (. ([] conversions position) instance)))
      )
    )
    (for (in position (..< 0 (. forces length)))
      (if (!= ([] mains (. ([] forces position) instance)) no-instance)
        (= (. ([] forces position) instance) ([] mains (. ([] forces position) instance)))
      )
    )
    (for (in position (..< 0 (. pairs length)))
      (if (!= ([] mains (. ([] pairs position) instance)) no-instance)
        (= (. ([] pairs position) instance) ([] mains (. ([] pairs position) instance)))
      )
    )
    (for (in position (..< 0 (. relations length)))
      (if (!= ([] mains (. ([] relations position) instance)) no-instance)
        (= (. ([] relations position) instance) ([] mains (. ([] relations position) instance)))
      )
    )
    (for (in position (..< 0 (. unwrapped length)))
      (if (!= ([] mains (. ([] unwrapped position) instance)) no-instance)
        (= (. ([] unwrapped position) instance) ([] mains (. ([] unwrapped position) instance)))
      )
    )
    (for (in position (..< 0 (. chains length)))
      (if (!= ([] mains (. ([] chains position) instance)) no-instance)
        (= (. ([] chains position) instance) ([] mains (. ([] chains position) instance)))
      )
    )
    (for (in position (..< 0 (. declared-values length)))
      (if (!= ([] mains (. ([] declared-values position) instance)) no-instance)
        (= (. ([] declared-values position) instance) ([] mains (. ([] declared-values position) instance)))
      )
    )
    (for (in position (..< 0 (. context-casts length)))
      (if (!= ([] mains (. ([] context-casts position) instance)) no-instance)
        (= (. ([] context-casts position) instance) ([] mains (. ([] context-casts position) instance)))
      )
    )
    (for (in position (..< 0 (. payload-effects length)))
      (if (!= ([] mains (. ([] payload-effects position) instance)) no-instance)
        (= (. ([] payload-effects position) instance) ([] mains (. ([] payload-effects position) instance)))
      )
    )
    (for (in position (..< 0 (. case-owners length)))
      (if (!= ([] mains (. ([] case-owners position) instance)) no-instance)
        (= (. ([] case-owners position) instance) ([] mains (. ([] case-owners position) instance)))
      )
    )
    (for (in position (..< 0 (. fills length)))
      (if (!= ([] mains (. ([] fills position) instance)) no-instance)
        (= (. ([] fills position) instance) ([] mains (. ([] fills position) instance)))
      )
    )
    (for (in position (..< 0 (. stack-reads length)))
      (if (!= ([] mains (. ([] stack-reads position) instance)) no-instance)
        (= (. ([] stack-reads position) instance) ([] mains (. ([] stack-reads position) instance)))
      )
    )
    (for (in position (..< 0 (. stack-scopes length)))
      (if (!= ([] mains (. ([] stack-scopes position) instance)) no-instance)
        (= (. ([] stack-scopes position) instance) ([] mains (. ([] stack-scopes position) instance)))
      )
    )
    (for (in position (..< 0 (. swap-forwards length)))
      (if (!= ([] mains (. ([] swap-forwards position) instance)) no-instance)
        (= (. ([] swap-forwards position) instance) ([] mains (. ([] swap-forwards position) instance)))
      )
      (if (and (!= (. ([] swap-forwards position) callee) no-instance) (!= ([] mains (. ([] swap-forwards position) callee)) no-instance))
        (= (. ([] swap-forwards position) callee) ([] mains (. ([] swap-forwards position) callee)))
      )
    )
    (for (in position (..< 0 (. global-uses length)))
      (if (!= ([] mains (. ([] global-uses position) instance)) no-instance)
        (= (. ([] global-uses position) instance) ([] mains (. ([] global-uses position) instance)))
      )
    )
    (for (in position (..< 0 (. const-arrays length)))
      (if (!= ([] mains (. ([] const-arrays position) instance)) no-instance)
        (= (. ([] const-arrays position) instance) ([] mains (. ([] const-arrays position) instance)))
      )
    )
  )
  (fn-do _ fold-nodes _
    (param from InstanceId)
    (param into InstanceId)
    (param slot-count U32)
    ; The locals of an initializer are a few of its main's, which begin at its base among them.
    (let row ([] (. instances rows) from))
    (if (. row may-panic)
      (call (. instances mark-may-panic) into)
    )
    (if (!= (. row slot-start) (. U32 max))
      (for (in offset (..< 0 (. row slot-count)))
        (call retain-slot into slot-count (+ (. row slot-base) offset) ([] slot-types (+ (. row slot-start) offset)))
      )
      (= (. ([] (. instances rows) from) slot-start) (. U32 max))
      (= (. ([] (. instances rows) from) slot-count) 0)
    )
    (if (== (. row node-start) (. U32 max))
      (return)
    )
    (for (in offset (..< 0 (. row subtree count)))
      (let syntax (+ (. row subtree start) offset))
      (let slot (+ (. row node-start) offset))
      (if (!= ([] node-types slot) no-type)
        (call set-node-type into syntax ([] node-types slot))
      )
      (if (!= (/and/ ([] node-plans slot) plan-bits) (. OperatorPlan plan-none))
        (call set-plan into syntax (as (/and/ ([] node-plans slot) plan-bits) OperatorPlan))
      )
      (if (!= (/and/ ([] node-plans slot) plain-bit) 0)
        (call mark-plain into syntax)
      )
      (let target (call node-slot into syntax))
      (if (and target (!= ([] node-constants slot) no-fact))
        (= ([] node-constants target) ([] node-constants slot))
      )
      (if (and target (!= ([] node-chains slot) .chain-tested))
        (= ([] node-chains target) ([] node-chains slot))
      )
      (let call ([] node-calls slot))
      (= ([] node-calls slot) no-fact)
      (call fold-calls into syntax call)
      (let conversion ([] node-conversions slot))
      (= ([] node-conversions slot) no-fact)
      (= ([] node-conversion-tails slot) no-fact)
      (call fold-conversions into syntax conversion)
      (let force ([] node-forces slot))
      (= ([] node-forces slot) no-fact)
      (call fold-forces into syntax force)
    )
    (= (. ([] (. instances rows) from) node-start) (. U32 max))
  )
  (fn-do _ fold-calls _
    (param into InstanceId)
    (param syntax SyntaxId)
    (param first FactId)
    ; Gives a main the calls its initializer recorded at a node, in order. A main that typed the
    ; node itself recorded its own there: each of the initializer's that repeats one of those,
    ; not repeated before, is dropped, so that the node has each call once.
    (let own (list FactId))
    (let slot (call node-slot into syntax))
    (if (and slot (!= first no-fact))
      (let cursor ([] node-calls slot))
      (while (!= cursor no-fact)
        (+= own cursor)
        (= cursor (. ([] calls cursor) next))
      )
    )
    (let call first)
    (while (!= call no-fact)
      (let next (. ([] calls call) next))
      (= (. ([] calls call) next) no-fact)
      (let repeated false)
      (for (in position (..< 0 (. own length)))
        (if (and (not repeated) (!= ([] own position) no-fact) (call same-call ([] calls ([] own position)) ([] calls call)))
          (= ([] own position) no-fact)
          (= repeated true)
        )
      )
      (if (not repeated)
        (call link-call into syntax call)
      )
      (= call next)
    )
  )
  (fn-do _ fold-conversions _
    (param into InstanceId)
    (param syntax SyntaxId)
    (param first FactId)
    ; Gives a main the conversions its initializer recorded at a node, as it is given the calls.
    (let own (list FactId))
    (let slot (call node-slot into syntax))
    (if (and slot (!= first no-fact))
      (let cursor ([] node-conversions slot))
      (while (!= cursor no-fact)
        (+= own cursor)
        (= cursor (. ([] conversions cursor) next))
      )
    )
    (let conversion first)
    (while (!= conversion no-fact)
      (let next (. ([] conversions conversion) next))
      (= (. ([] conversions conversion) next) no-fact)
      (let repeated false)
      (for (in position (..< 0 (. own length)))
        (if (and (not repeated) (!= ([] own position) no-fact) alike)
          (= ([] own position) no-fact)
          (= repeated true)
        )
        (lazy alike (call same-conversion ([] conversions ([] own position)) ([] conversions conversion)))
      )
      (if (not repeated)
        (call link-conversion into syntax conversion)
      )
      (= conversion next)
    )
  )
  (fn-do _ fold-forces _
    (param into InstanceId)
    (param syntax SyntaxId)
    (param first FactId)
    ; Gives a main the forces its initializer recorded at a node, as it is given the calls.
    (let own (list FactId))
    (let slot (call node-slot into syntax))
    (if (and slot (!= first no-fact))
      (let cursor ([] node-forces slot))
      (while (!= cursor no-fact)
        (+= own cursor)
        (= cursor (. ([] forces cursor) next))
      )
    )
    (let force first)
    (while (!= force no-fact)
      (let next (. ([] forces force) next))
      (= (. ([] forces force) next) no-fact)
      (let repeated false)
      (for (in position (..< 0 (. own length)))
        (let held ([] own position))
        (if (and (not repeated) (!= held no-fact))
          (let alike
            (scope (and same-operand (== (. ([] forces held) result) (. ([] forces force) result)))
              (lazy same-operand (== (. ([] forces held) operand) (. ([] forces force) operand)))
            )
          )
          (if (and alike (== (. ([] forces held) is-narrowed) (. ([] forces force) is-narrowed)))
            (= ([] own position) no-fact)
            (= repeated true)
          )
        )
      )
      (if (not repeated)
        (call link-force into syntax force)
      )
      (= force next)
    )
  )
  (fn-do _ same-call Bool
    (param first CallFact)
    (param other CallFact)
    ; Whether two calls recorded at one node are the same call: of one callee, in one form, with
    ; its parameters filled alike.
    (if (or (!= (. first callee) (. other callee)) (!= (. first form) (. other form)) fills-differ)
      (return false)
    )
    (lazy fills-differ (!= (. first fills count) (. other fills count)))
    (if (or (!= (. first is-partial) (. other is-partial)) (!= (. first is-swapped) (. other is-swapped)))
      (return false)
    )
    (for (in position (..< 0 (. first fills count)))
      (if (!= ([] call-fills (+ (. first fills start) position)) ([] call-fills (+ (. other fills start) position)))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ same-conversion Bool
    (param first ConversionFact)
    (param other ConversionFact)
    ; Whether two conversions recorded at one site are the same conversion.
    (and same-kind (== (. first callee) (. other callee)) (== (. first ratio) (. other ratio)))
    (where
      (lazy same-kind (and same-types (== (. first kind) (. other kind)) (== (. first reason) (. other reason))))
      (lazy same-types (and (== (. first from) (. other from)) (== (. first to) (. other to))))
    )
  )
  (fn-do _ fold-loose _
    (param mains (list InstanceId))
    ; What an initializer recorded at a node outside its own declaration is recorded for its main
    ; instead, at the node when the main holds it. A call kept apart from those of its node stays
    ; apart, made by the main.
    (let types (list LooseType))
    (let kept Size 0)
    (for (in position (..< 0 (. loose-types length)))
      (let held (as ([] loose-types position) LooseType))
      (if (== ([] mains (. held instance)) no-instance)
        (= ([] loose-types kept) held)
        (+= kept 1)
        (else
          (+= types held)
        )
      )
    )
    (call (. loose-types truncate) kept)
    (for (in held types)
      (call set-node-type ([] mains (. held instance)) (. held syntax) (. held type))
    )
    (blank)
    (let moved (list LooseFact))
    (= kept 0)
    (for (in position (..< 0 (. loose-calls length)))
      (let loose (as ([] loose-calls position) LooseFact))
      (if (== ([] mains (. loose instance)) no-instance)
        (= ([] loose-calls kept) loose)
        (+= kept 1)
        (else-if (. loose apart)
          (= ([] loose-calls kept) (call LooseFact ([] mains (. loose instance)) (. loose fact) true))
          (+= kept 1)
        )
        (else
          (+= moved loose)
        )
      )
    )
    (call (. loose-calls truncate) kept)
    (call (. loose-call-lasts clear))
    (call (. loose-call-priors clear))
    (for (in position (..< 0 (. loose-calls length)))
      (call link-loose-call position)
    )
    (for (in loose moved)
      (call link-call ([] mains (. loose instance)) (. ([] calls (. loose fact)) syntax) (. loose fact))
    )
    (blank)
    (call (. moved clear))
    (= kept 0)
    (for (in position (..< 0 (. loose-conversions length)))
      (let loose (as ([] loose-conversions position) LooseFact))
      (if (== ([] mains (. loose instance)) no-instance)
        (= ([] loose-conversions kept) loose)
        (+= kept 1)
        (else
          (+= moved loose)
        )
      )
    )
    (call (. loose-conversions truncate) kept)
    (for (in loose moved)
      (call link-conversion ([] mains (. loose instance)) (. ([] conversions (. loose fact)) syntax) (. loose fact))
    )
    (blank)
    (call (. moved clear))
    (= kept 0)
    (for (in position (..< 0 (. loose-forces length)))
      (let loose (as ([] loose-forces position) LooseFact))
      (if (== ([] mains (. loose instance)) no-instance)
        (= ([] loose-forces kept) loose)
        (+= kept 1)
        (else
          (+= moved loose)
        )
      )
    )
    (call (. loose-forces truncate) kept)
    (for (in loose moved)
      (call link-force ([] mains (. loose instance)) (. ([] forces (. loose fact)) syntax) (. loose fact))
    )
  )
  (fn-do + add-style-rule _
    (param ref DeclRef)
    (param name Atom)
    ; Lists a style rule written outside any rule, after those of its name listed before it.
    (let position (as (. style-rules length) U32))
    (+= style-rules ref)
    (+= style-rule-nexts (. U32 max))
    (let last ([] style-rule-lasts name))
    (if last
      (= ([] style-rule-nexts last) position)
      (else
        (= ([] style-rule-firsts name) position)
      )
    )
    (= ([] style-rule-lasts name) position)
  )
  (fn-expr + first-style-rule U32
    (param name Atom)
    ; The place of the first style rule of a name written outside any rule, or U32.max when none is;
    ; each leads to the next of its name (`style-rule-nexts`).
    (?? ([] style-rule-firsts name) (. U32 max))
  )
  (fn-expr + latest-call-of FactId
    (param instance InstanceId)
    ; The last call an instance recorded, at any node or none, or no fact.
    (call latest-of call-lasts instance)
  )
  (fn-expr + prior-call FactId
    (param id FactId)
    ; The call the instance of one recorded before it, or no fact.
    (call prior-of call-priors id)
  )
  (fn-do + record-fill _
    (param fact FillFact)
    ; Adds a value an instance gives a property, linked to the one it gave before.
    (let id FactId (as (. fills length) FactId))
    (call (. fills append) fact)
    (call chain-fact fill-lasts fill-priors (. fact instance) id)
  )
  (fn-expr + latest-fill-of FactId
    (param instance InstanceId)
    ; The last value an instance gave a property, or no fact. Instances keep their own fills until
    ; typing ends and those of initializers are folded.
    (call latest-of fill-lasts instance)
  )
  (fn-expr + prior-fill FactId
    (param id FactId)
    ; The value the instance of one gave a property before it, or no fact.
    (call prior-of fill-priors id)
  )
  (fn-expr + latest-conversion-of FactId
    (param instance InstanceId)
    ; The last conversion an instance recorded, or no fact.
    (call latest-of conversion-lasts instance)
  )
  (fn-expr + prior-conversion FactId
    (param id FactId)
    ; The conversion the instance of one recorded before it, or no fact.
    (call prior-of conversion-priors id)
  )
  (fn-do _ add-loose-call _
    (param loose LooseFact)
    ; Records a call at a node its instance's body did not reserve.
    (let position (. loose-calls length))
    (call (. loose-calls append) loose)
    (call link-loose-call position)
  )
  (fn-do _ link-loose-call _
    (param position Size)
    ; Links a loose call to the one its instance recorded before it, as the last its instance made.
    (call chain-fact loose-call-lasts loose-call-priors (. ([] loose-calls position) instance) (as position U32))
  )
  (fn-do _ chain-fact _
    (param lasts (of List U32 ArenaBacking))
    (param priors (of List U32 ArenaBacking))
    (param instance InstanceId)
    (param id U32)
    ; Links the place of a fact to that of the one of its kind its instance recorded before it, as
    ; the last its instance made. Each holds one past the place, and zero for none.
    (let place (as instance Size))
    (while (<= (. lasts length) place)
      (+= lasts 0)
    )
    (+= priors ([] lasts place))
    (= ([] lasts place) (+ id 1))
  )
  (fn-expr _ latest-of U32
    (param lasts (of List U32 ArenaBacking))
    (param instance InstanceId)
    ; The place of the last fact of a kind an instance recorded, or no fact.
    (case? (or (>= place (. lasts length)) (== ([] lasts place) 0))
      no-fact
    )
    (default
      (- ([] lasts place) 1)
    )
    (where
      (lazy place (as instance Size))
    )
  )
  (fn-expr _ prior-of U32
    (param priors (of List U32 ArenaBacking))
    (param id U32)
    ; The place of the fact of a kind the instance of one recorded before it, or no fact.
    (if-expr (== prior 0) no-fact (- prior 1))
    (where
      (lazy prior ([] priors id))
    )
  )
  (fn-do _ link-call _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param id FactId)
    (let slot (call node-slot instance syntax))
    (if (not slot)
      (call add-loose-call (call LooseFact instance id))
      (return)
    )
    (let head ([] node-calls slot))
    (if (== head no-fact)
      (= ([] node-calls slot) id)
      (return)
    )
    (let cursor head)
    (while (!= (. ([] calls cursor) next) no-fact)
      (= cursor (. ([] calls cursor) next))
    )
    (= (. ([] calls cursor) next) id)
  )
  (fn-do _ link-conversion _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param id FactId)
    (let slot (call node-slot instance syntax))
    (if (not slot)
      (call (. loose-conversions append) (call LooseFact instance id))
      (return)
    )
    (let tail ([] node-conversion-tails slot))
    (if (== tail no-fact)
      (= ([] node-conversions slot) id)
      (else
        (= (. ([] conversions tail) next) id)
      )
    )
    (= ([] node-conversion-tails slot) id)
  )
  (fn-do _ link-force _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param id FactId)
    (let slot (call node-slot instance syntax))
    (if (not slot)
      (call (. loose-forces append) (call LooseFact instance id))
      (return)
    )
    (let head ([] node-forces slot))
    (if (== head no-fact)
      (= ([] node-forces slot) id)
      (return)
    )
    (let cursor head)
    (while (!= (. ([] forces cursor) next) no-fact)
      (= cursor (. ([] forces cursor) next))
    )
    (= (. ([] forces cursor) next) id)
  )
  (fn-do + record-force _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param operand TypeId)
    (param result TypeId)
    (param is-narrowed Bool)
    (let id FactId (as (. forces length) FactId))
    (call (. forces append) (call ForceFact instance syntax operand result is-narrowed))
    (call link-force instance syntax id)
  )
  (fn-do + record-diagnostic _
    (param instance InstanceId)
    (param module ModuleId)
    (param syntax SyntaxId)
    (param kind TypeDiagnosticKind)
    (param name (? Atom) (= null))
    (param source TypeId (= no-type))
    (param target TypeId (= no-type))
    ; A type's own declaration is checked where the type is first used, so what it gets wrong is
    ; recorded ahead of anything found afterwards.
    (if initializer
      (call (. initializer initialize-classes))
    )
    (call (. diagnostics append) (call TypeDiagnostic instance module syntax kind name source target))
  )
  (fn-do + mention-types _
    (param mentioned (list TypeId))
    (let start (as (. diagnostic-mentions length) U32))
    (++= diagnostic-mentions mentioned)
    (= (. ([] diagnostics (- (. diagnostics length) 1)) mentions) (call (of RowRange TypeId) start (as (. mentioned length) U32)))
  )
  (fn-do + note-members _
    (param members (list DeclRef))
    (let start (as (. diagnostic-members length) U32))
    (++= diagnostic-members members)
    (= (. ([] diagnostics (- (. diagnostics length) 1)) members) (call (of RowRange DeclRef) start (as (. members length) U32)))
  )
  (fn-do + inset-diagnostic _
    (param columns U32)
    (param width U32 (= 0))
    ; Starts the diagnostic just recorded some columns into its node: at the part of a literal
    ; it is about, or, given a `width`, at a part of that many columns that may run past it.
    (= (. ([] diagnostics (- (. diagnostics length) 1)) inset) columns)
    (= (. ([] diagnostics (- (. diagnostics length) 1)) width) width)
  )
  (fn-do + relate-diagnostic _
    (param label Atom)
    (param module ModuleId)
    (param syntax SyntaxId)
    ; Points the diagnostic just recorded at a second place in the source, under a label.
    (let last (- (. diagnostics length) 1))
    (= (. ([] diagnostics last) related-label) label)
    (= (. ([] diagnostics last) related-module) module)
    (= (. ([] diagnostics last) related-syntax) syntax)
  )
  (fn-do + restate _
    (param mark Size)
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param from TypeDiagnosticKind)
    (param to TypeDiagnosticKind)
    (param message (? Atom) (= null))
    ; What an attempt reported at a place since a mark is said in the words of whoever made the
    ; attempt, who knows more about why it failed.
    (for (in position (..< mark (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (and (== (. row instance) instance) (== (. row syntax) syntax) (== (. row kind) from))
        (= (. ([] diagnostics position) kind) to)
        (= (. ([] diagnostics position) name) message)
      )
    )
  )
  (fn-do + has-diagnostic Bool
    (param instance InstanceId)
    (for (in row diagnostics)
      (if (and (== (. row instance) instance) (!= (. row kind) .not-supported))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + resite _
    (param mark Size)
    (param instance InstanceId)
    (param from SyntaxId)
    (param to SyntaxId)
    ; What was reported at one place since a mark is reported at another: the whole expression a
    ; failed part of it belongs to.
    (for (in position (..< mark (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (and (== (. row instance) instance) (== (. row syntax) from))
        (= (. ([] diagnostics position) syntax) to)
      )
    )
  )
  (fn-do + declined-since Bool
    (param mark Size)
    (param instance InstanceId)
    ; Whether an instance was refused since a mark.
    (for (in position (..< mark (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (and (== (. row instance) instance) (== (. row kind) .not-supported))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + drop-diagnostics Bool
    (param mark Size)
    (param instance InstanceId)
    ; Drops the diagnostics recorded for one instance since a mark, and says whether any were.
    (let kept mark)
    (for (in position (..< mark (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (!= (. row instance) instance)
        (= ([] diagnostics kept) row)
        (+= kept 1)
      )
    )
    (let dropped (!= kept (. diagnostics length)))
    (call (. diagnostics truncate) kept)
    (return dropped)
  )
  (fn-do + drop-trial-diagnostics _
    (param mark Size)
    (param trial InstanceId)
    (let kept mark)
    (for (in position (..< mark (. diagnostics length)))
      (let row (as ([] diagnostics position) TypeDiagnostic))
      (if (not (call written-in (. row instance) trial))
        (= ([] diagnostics kept) row)
        (+= kept 1)
      )
    )
    (call (. diagnostics truncate) kept)
  )
  (fn-do _ written-in Bool
    (param instance InstanceId)
    (param around InstanceId)
    (let current instance)
    (while (!= current no-instance)
      (if (== current around)
        (return true)
      )
      (= current (. ([] (. instances rows) current) enclosing))
    )
    (return false)
  )
  (fn-do + record-witness-table _
    (param value TypeId)
    (param interface TypeId)
    (= ([] key-scratch 0) value)
    (= ([] key-scratch 1) interface)
    (call (. witness-keys store) (. key-scratch data) 2)
    (if (. witness-keys last-inserted)
      (call (. witness-tables append) (call WitnessTable value interface))
    )
  )
  (fn-do + record-dynamic-witness _
    (param value TypeId)
    (param interface TypeId)
    ; A class cast to an interface it does not declare, which classes declared below it do: the
    ; table of the class keeps a slot for the interface, which holds the table of each class
    ; below it that has one, and nothing for the others.
    (for (in row dynamic-witnesses)
      (if (and (== (. row value) value) (== (. row interface) interface))
        (return)
      )
    )
    (call (. dynamic-witnesses append) (call WitnessTable value interface))
  )
  (fn-do + equality-of InstanceId
    (param value TypeId)
    (param interface TypeId)
    ; The comparison the function a type's table for an interface holds for equality runs, or
    ; none where the table holds none.
    (= ([] key-scratch 0) value)
    (= ([] key-scratch 1) interface)
    (let found (call (. witness-keys find) (. key-scratch data) 2))
    (return (if-expr found (. ([] witness-tables found) equality) no-instance))
  )
  (fn-do + record-witness-func _
    (param interface TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (= ([] key-scratch 0) interface)
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (call (. witness-func-keys store) (. key-scratch data) 3)
    (if (. witness-func-keys last-inserted)
      (call (. witness-funcs append) (call WitnessFunc interface module decl))
    )
  )
  (fn-do + record-witness-call _
    (param receiver TypeId)
    (param module ModuleId)
    (param decl DeclId)
    ; Notes that a call through a value of the interface `receiver` has been dispatched to a function
    ; it or an interface it is derived from declares (`record-witness-proto`).
    (= ([] key-scratch 0) receiver)
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (call (. witness-call-keys store) (. key-scratch data) 3)
    (if (. witness-call-keys last-inserted)
      (call (. witness-calls append) (call WitnessFunc receiver module decl))
    )
  )
  (fn-do + record-witness-proto _
    (param proto InstanceId)
    ; Notes an instance of an interface's function that a call names, where a call through a
    ; value of the interface has been dispatched to the function (`record-witness-call`): it has a
    ; slot of its own in the interface's witness tables.
    (let row ([] (. instances rows) proto))
    (= ([] key-scratch 0) (. row self-type))
    (= ([] key-scratch 1) (. row module))
    (= ([] key-scratch 2) (. row decl))
    (if (not (call (. witness-call-keys find) (. key-scratch data) 3))
      (return)
    )
    (= ([] key-scratch 0) no-type)
    (= ([] key-scratch 1) proto)
    (call (. witness-slot-keys store) (. key-scratch data) 2)
    (if (. witness-slot-keys last-inserted)
      (+= witness-protos proto)
    )
  )
  (fn-do + record-witness-slot _
    (param value TypeId)
    (param proto InstanceId)
    (param callee InstanceId)
    (param property U32 (= (. U32 max)))
    (param through (of RowRange U32) (= (call (of RowRange U32))))
    (param based Bool (= false))
    (param converts Bool (= false))
    (= ([] key-scratch 0) value)
    (= ([] key-scratch 1) proto)
    (= ([] key-scratch 2) 1)
    (call (. witness-slot-keys store) (. key-scratch data) (if-expr based 3 2))
    (if (. witness-slot-keys last-inserted)
      (call (. witness-slots append) (call WitnessSlot value proto callee property through based converts))
    )
  )
  (fn-do + absorb _
    (param peer Facts)
    (param ids PeerIds)
    ; Takes in what another type pass over the program recorded: every fact of each instance this
    ; pass takes from it (`PeerIds.owns`), and each fact that no one instance owns and this pass
    ; lacks, once. A fact of an instance this pass does not take from the peer is left: the pass that
    ; owns the instance holds it. The peer's call and transform facts are numbered here in
    ; `PeerIds.calls` and `PeerIds.transforms`. What `unshared-weight` counts is left: the instances
    ; whose typing changed it are typed again here.
    (let call-ids (list FactId))
    (let next-call FactId (as (. calls length) FactId))
    (for (in row (. peer calls))
      (+= call-ids (if-expr (call (. ids owns) (. row instance)) next-call no-fact))
      (+= next-call (as (if-expr (call (. ids owns) (. row instance)) 1 0) FactId))
    )
    (let keyed (call (. peer keyed-conversions)))
    (let conversion-ids (list FactId))
    (let next-conversion FactId (as (. conversions length) FactId))
    (for (in position (..< 0 (. peer conversions length)))
      (let taken (and (not ([] keyed position)) (call (. ids owns) (. ([] (. peer conversions) position) instance))))
      (+= conversion-ids (if-expr taken next-conversion no-fact))
      (+= next-conversion (as (if-expr taken 1 0) FactId))
    )
    (let force-ids (list FactId))
    (let next-force FactId (as (. forces length) FactId))
    (for (in row (. peer forces))
      (+= force-ids (if-expr (call (. ids owns) (. row instance)) next-force no-fact))
      (+= next-force (as (if-expr (call (. ids owns) (. row instance)) 1 0) FactId))
    )
    (let transform-ids (list U32))
    (let next-transform U32 (as (. transforms length) U32))
    (for (in row (. peer transforms))
      (+= transform-ids (if-expr (call (. ids owns) (. row instance)) next-transform (. U32 max)))
      (+= next-transform (as (if-expr (call (. ids owns) (. row instance)) 1 0) U32))
    )
    (= (. ids calls) call-ids)
    (= (. ids transforms) transform-ids)
    (call absorb-calls peer ids call-ids)
    (call absorb-conversions peer ids keyed conversion-ids)
    (call absorb-forces peer ids force-ids)
    (call absorb-transforms peer ids transform-ids)
    (call absorb-nodes peer ids call-ids conversion-ids force-ids)
    (call absorb-keyed-conversions peer ids keyed)
    (call absorb-owned peer ids call-ids conversion-ids force-ids)
    (let domains (call absorb-domains peer))
    (let sheets (call absorb-sheets peer ids domains))
    (let sheeted
      (call PeerSheets
        (block
          (arg sheets)
          (arg (call unmoved-rows (. peer style-projections length)))
          (arg (call unmoved-rows (. peer style-themed-values length)))
        )
      )
    )
    (let applications (call absorb-applications peer ids sheets))
    (call absorb-themes peer ids sheeted applications)
    (call absorb-style-runtime peer ids)
    (call absorb-rules peer ids call-ids)
    (call absorb-shared peer ids)
    (call absorb-places peer ids call-ids)
    (call absorb-styles peer ids domains sheeted)
    (let events (. event-uses length))
    (call absorb-markup peer ids call-ids conversion-ids)
    (call absorb-plans peer ids)
    (call absorb-machines peer ids call-ids events)
  )
  (fn-do + absorb-diagnostics _
    (param peer Facts)
    (param ids PeerIds)
    (param taken (list Bool))
    ; Takes in what the peer reported of each of its instances `taken` flags, which no pass typed:
