  (fn-do + mark-propagates _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Marks the most recent call recorded at a node as propagating its errors.
    (let fact (call latest-call instance syntax))
    (if (!= fact no-fact)
      (= (. ([] calls fact) propagates) true)
    )
  )
  (fn-do + mark-swapped _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Marks the most recent call recorded at an operator's node as one whose receiver is the
    ; operator's right operand.
    (let fact (call latest-call instance syntax))
    (if (!= fact no-fact)
      (= (. ([] calls fact) is-swapped) true)
