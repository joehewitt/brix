  (fn-do + latest-call FactId
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The most recent call recorded at a node, or no fact.
    (let slot (call node-slot instance syntax))
    (if slot
      (let cursor ([] node-calls slot))
      (if (== cursor no-fact)
        (return no-fact)
      )
      (while (!= (. ([] calls cursor) next) no-fact)
        (= cursor (. ([] calls cursor) next))
      )
      (return cursor)
    )
    (let position (call latest-of loose-call-lasts instance))
    (while (!= position no-fact)
      (let loose ([] loose-calls position))
      (if (== (. ([] calls (. loose fact)) syntax) syntax)
        (return (. loose fact))
      )
      (= position (call prior-of loose-call-priors position))
    )
    (return no-fact)
