      (if (== (. ([] element-stores row) argument) (. store argument))
        (return)
      )
      (= row (. ([] element-stores row) next))
    )
    (let added (as (. element-stores length) U32))
    (let tail ([] element-store-tails key))
    (if (== tail null)
      (= ([] element-store-rows key) added)
      (else
        (= (. ([] element-stores tail) next) added)
