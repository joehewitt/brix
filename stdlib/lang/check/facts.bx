  (fn-do + gate-of U32
    (param type TypeId)
    (param whens (list StyleWhen))
    (param content _ (= false))
    ; The row of `style-gates` the `when`s given gate an object of a type by, in order, a block of
    ; declarations or else `content`, or `U32.max`.
    (for (in index (..< 0 (. style-gates length)))
      (let row ([] style-gates index))
      (if (and (== (. row type) type) (== (. row count) (. whens length)) (== (. row content) content))
        (let same true)
        (for (in position (..< 0 (. whens length)))
          (let held ([] style-gate-whens (+ (. row first) position)))
          (if (or other-module other-syntax other-cell (!= (. held test) (. ([] whens position) test)))
            (= same false)
          )
          (lazy other-module (!= (. held module) (. ([] whens position) module)))
          (lazy other-syntax (!= (. held syntax) (. ([] whens position) syntax)))
          (lazy other-cell (!= (== (. held cell) (. U32 max)) (== (. ([] whens position) cell) (. U32 max))))
        )
        (if same
          (return (as index U32))
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do + rule-update-of (? RuleUpdate)
    (param instance InstanceId)
    (param site SyntaxId)
    ; The property a line of a style rule sets, typed by an instance, or none.
    (for (in row rule-updates)
      (if (and (== (. row instance) instance) (== (. row site) site))
        (return row)
      )
    )
    (return null)
  )
  (fn-do + updates-properties Bool
    (param unit InstanceId)
    ; Whether the instance that types a style rule sets a property of the class.
    (for (in row rule-updates)
      (if (== (. row instance) unit)
        (return true)
      )
    )
    (return false)
