(type + TableOp (is U32)
  ; What a node planned `plan-table` does to a table or a view of one, as TypeScript answers it
  ; before any method: `t[i]` makes a row, a field of a row is read or written in its column,
  ; `t[i] = v` scatters a row into the columns, `t.f` makes a view of a field's column,
  ; `length` and `size` count the rows or the items, `t[a .. < b]` makes a span of the rows or
  ; the items a range spans, `f[i]` reads an item of a field's column and `f[i] = v` writes one,
  ; `f.data` is where the column's items start, `f + g` makes the tuple of the views of fields'
  ; columns that a span is cast from, and `t[a .. < b] = s` copies the rows or the items of a
  ; span or a view into those a range spans. The members of an arena's table are answered where
  ; they are called: `append`, `reserve`, `extend`, `truncate`, `clear`, `copy-from`, `finish`,
  ; `view`, `rewind`, `storage-checkpoint`, `validate-storage-restore` and `restore-storage`, and the
  ; getters `mark` and `capacity`. `t[ids]` selects rows by indices; `s[i]` and `s[a .. < b]` of
  ; an index span read an index and span some, and of a selection read a row and span some.
  ; `t.layout` is the text of how a table keeps its rows. The
  ; node's constant holds the operation in its low half and the place of the field in the row's
  ; layout in its high half.
  (blank)
  (variant table-row (= 0))
  (variant table-field (= 1))
  (variant table-store (= 2))
  (variant table-column (= 3))
  (variant table-length (= 4))
  (variant table-span (= 5))
  (variant table-item (= 6))
  (variant table-item-store (= 7))
  (variant table-data (= 8))
  (variant table-zip (= 9))
  (variant table-range-store (= 10))
  (variant table-append (= 11))
  (variant table-reserve (= 12))
  (variant table-extend (= 13))
  (variant table-truncate (= 14))
  (variant table-clear (= 15))
  (variant table-copy-from (= 16))
  (variant table-finish (= 17))
  (variant table-rewind (= 18))
  (variant table-storage-checkpoint (= 19))
  (variant table-validate-restore (= 20))
  (variant table-restore-storage (= 21))
  (variant table-mark (= 22))
  (variant table-capacity (= 23))
  (variant table-select (= 24))
  (variant span-item (= 25))
  (variant span-range (= 26))
  (variant selection-row (= 27))
  (variant selection-range (= 28))
  (variant table-view (= 29))
  (variant table-layout (= 30))
  (variant proven-row (= 31))
)

(fn-expr + is-place-loop-plan Bool
  (param plan OperatorPlan)
  ; Whether a plan is of a loop that reads its container where it is kept.
  (or (== plan .plan-index-place-loop) (== plan .plan-cursor-place-loop))
)

(fn-expr + is-index-loop-plan Bool
  (param plan OperatorPlan)
  ; Whether a plan is of a loop that counts through the indexes of its container.
  (or (== plan .plan-index-loop) (== plan .plan-index-place-loop))
)

(fn-expr + is-cursor-loop-plan Bool
  (param plan OperatorPlan)
  ; Whether a plan is of a loop that steps a cursor through its container.
  (or (== plan .plan-cursor-loop) (== plan .plan-cursor-place-loop))
)

(fn-expr + is-intrinsic-plan Bool
  (param plan OperatorPlan)
  ; Whether a plan is that of a call the compiler answers itself: a table's or a view's access
  ; answers itself too, whatever method of the library the type pass found for it.
  (or (== plan .plan-store-untraced) (== plan .plan-table) relates sides objects numeric)
  (where
    (lazy relates (or (== plan .plan-relation) (== plan .plan-relation-cast)))
    (lazy sides (or (== plan .plan-side-payload) (== plan .plan-publish-side-payload)))
    (lazy objects (or built (== plan .plan-builder-reserve) (== plan .plan-invoke-lowered) witnesses))
    (lazy built (or (== plan .plan-object-from-pointer) (== plan .plan-builder-append)))
    (lazy witnesses (or (== plan .plan-witness-pointer) (== plan .plan-interface-from-pointer)))
    (lazy code (as plan U8))
    (lazy first (as (. OperatorPlan plan-count-leading-zeros) U8))
    (lazy last (as (. OperatorPlan plan-f64-max) U8))
    (lazy numeric (and (>= code first) (<= code last)))
  )
)

(fn-expr + is-in-place-plan Bool
  (param plan OperatorPlan)
  ; Whether a plan is that of a call the compiler answers with no call of its own: a count of
  ; leading zeros, a float operation of the math module, or a pointer read as an object or an
  ; interface, or the witnesses of an interface read.
  (or (and (>= code first) (<= code last)) (== plan .plan-object-from-pointer) witnesses)
  (where
    (lazy witnesses (or (== plan .plan-witness-pointer) (== plan .plan-interface-from-pointer)))
    (lazy code (as plan U8))
    (lazy first (as (. OperatorPlan plan-count-leading-zeros) U8))
    (lazy last (as (. OperatorPlan plan-f64-max) U8))
  )
)

(type + ConstantFact (is Struct)
  ; A constant the type pass worked out for a node: what a property of a type answers. An
  ; integer is the 64 bits of a value of the node's type, extended by its sign. A float is the
  ; number. Text is an atom.
  (blank)
  (prop + bits U64)
  (prop + float F64)
  (prop + text (? Atom))
  (prop + is-float Bool)
)

(type + HeldPlan (is Struct)
  ; How `==` compares operands as what they hold: the plan of the `==` of what they hold, which
  ; is recorded at the node as the plan of any `==` is; which operands are optionals; whether
  ; two that hold nothing are equal; whether the `==` of what they hold has the operands
  ; exchanged, the right one first; and for a union on the left, the number of the case whose
  ; value is compared, or no case.
  (blank)
  (prop + plan OperatorPlan)
  (prop + left Bool)
  (prop + right Bool)
  (prop + alike Bool)
  (prop + exchanged Bool)
  (prop + case-index U32 (= (. U32 max)))
)

(type + TypeDiagnosticKind (is U32)
  (variant function-not-found (= 0))
  (variant constructor-not-found (= 1))
  (variant property-not-found (= 2))
  (variant literal-does-not-fit (= 3))
  (variant illegal-cast (= 4))
  (variant return-after-recursion (= 5))
  (variant illegal-operation (= 6))
  (variant circular-reference (= 7))
  (variant not-supported (= 8))
  (variant ambiguous-constructor (= 9))
  (variant ambiguous-static (= 10))
  (variant ambiguous-extension (= 11))
  (variant extension-conflict (= 12))
  (variant unable-to-unify-returns (= 13))
  (variant invalid-bang-return (= 14))
  (variant error-leaves-function (= 15))
  (variant non-void-return (= 17))
  (variant explicit-return-requires-do (= 18))
  (variant no-possible-matches (= 19))
  (variant stated (= 20))
  (variant error-not-carried (= 21))
  (variant error-leaves-generator (= 22))
  (variant stated-unplaced (= 23))
  (variant unasked-unwrap (= 24))
  (variant unasked-text (= 25))
  (variant unasked-narrowing (= 26))
  (variant unasked-conversion (= 27))
  (variant restricted (= 28))
  (variant reached (= 29))
)

(type + ForceFact (is Struct)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + operand TypeId)
  (prop + result TypeId)
  (prop + is-narrowed Bool)
  (prop + is-tested Bool)
  (prop + next FactId (= no-fact))
)

(type + TypeDiagnostic (is Struct)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + kind TypeDiagnosticKind)
  (prop + name (? Atom))
  (prop + from TypeId (= no-type))
  (prop + to TypeId (= no-type))
  (prop + related-label (? Atom) (= null))
  (prop + related-module ModuleId (= 0))
  (prop + related-syntax SyntaxId (= 0))
  (prop + inset U32)
  (prop + width U32)
  (prop + mentions (of RowRange TypeId) (= (call (of RowRange TypeId))))
  (prop + members (of RowRange DeclRef) (= (call (of RowRange DeclRef))))
)

(type + LooseFact (is Struct)
  ; A fact recorded at a node its instance's body did not reserve: a synthesized feed or
  ; pipeline node past the function's range, or a member initializer typed under another
  ; instance; or a call a helper of a grammar makes, kept `apart` from its node's. The
  ; per-node index cannot hold it, so the readers merge these in.
  (blank)
  (prop + instance InstanceId)
  (prop + fact FactId)
  (prop + apart Bool)
)

(type + LooseType (is Struct)
  ; A type kept for a node apart from the per-node index: of a node its instance's body did not
  ; reserve, or what a node answers where the type of another value is kept as the node's.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + type TypeId)
)

(type + WitnessTable (is Struct)
  ; The table of a type for an interface it is converted to. `equality` is the comparison of
  ; two values of the type that the function the table holds for equality runs, where the
  ; interface, or one it is derived from, has its values compared.
  (blank)
  (prop + value TypeId)
  (prop + interface TypeId)
  (prop + equality InstanceId (= no-instance))
)

(type + WitnessFunc (is Struct)
  (prop + interface TypeId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + WitnessSlot (is Struct)
  ; The instance that answers a function of an interface for the values of a type: a function
  ; of the type's, or the interface's own where the type declares none. A getter or a setter
  ; a type answers with a property it stores has no instance: `property` is the property's
  ; place. A type that answers through a property it delegates to has the function of what
  ; the property holds, and `through` the places of the properties read from the value to it.
  ; `based` is the answer in the table of an interface derived from the prototype's, where the
  ; interface's own function answers in its own table: the function as the type runs it.
  ; `converts` says the type's function takes an argument as another type than the
  ; interface's gives, converted as recorded at the type's function.
  (blank)
  (prop + value TypeId)
  (prop + proto InstanceId)
  (prop + callee InstanceId)
  (prop + property U32 (= (. U32 max)))
  (prop + through (of RowRange U32))
  (prop + based Bool (= false))
  (prop + converts Bool (= false))
)

(type + ConstItem (is Struct)
  ; An item of a ConstArray as it is laid down: the bits of a number, cut to the width of the
  ; item, or the string literal written at `text`.
  (blank)
  (prop + bits U64)
  (prop + text SyntaxId (= 0))
)

(type + ConstArrayFact (is Struct)
  ; A ConstArray of a type made at a node of an instance, of `count` items of `const-items` from
  ; `first`.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + type TypeId)
  (prop + first U32)
  (prop + count U32)
)

(type + ForwardFact (is Struct)
  ; A member a union forwards to each case, at a node of an instance: `value` is what it gives,
  ; and `result` what the function made for it answers with where a case's call lets errors
  ; out of it: the value or one of the errors of every case, in key order, made as the types
  ; are sealed. No type where none leaves. `given` is the value assigned to a setter, and none
  ; for any other member.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + value TypeId)
  (prop + result TypeId (= no-type))
  (prop + given SyntaxId (= 0))
)

(type + TransformFact (is Struct)
  ; An error transformer an instance declares: the catcher naming the error it takes, the raise
  ; it is written with at `site`, whose exception it raises in the error's place, the error it
  ; takes, the errors it tests the chain of `previous` against, nearest first, and what it
  ; raises.
  (blank)
  (prop + instance InstanceId)
  (prop + catcher SyntaxId)
  (prop + site SyntaxId)
  (prop + exception SyntaxId)
  (prop + source TypeId)
  (prop + chain (of RowRange TypeId))
  (prop + raised TypeId)
)

(type + LeaveFact (is Struct)
  ; An error leaving an instance at a node, and the transformers it is tried with there in
  ; order, as places among the transformers. Each leads to the next error leaving at the node.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + error TypeId)
  (prop + tried (of RowRange U32))
  (prop + next FactId (= no-fact))
)

(type + LocalRule (is Struct)
  ; A local rule, typed where it is first called: the instance, the rule's declaration, the
  ; optional of what it gives, which a function the reference makes of the rule answers, and
  ; where the instance raises errors, what that function returns instead, the optional or one of
  ; them. `recursive` says the rule calls itself, directly or through other local rules, so the
  ; reference runs it as a function of its own rather than where it is called. One beside a
  ; match that calls itself keeps the stream it runs on, the stream's buffer, the optional
  ; `CaptureResult` the function the reference calls there answers, and where the instance
  ; raises errors, what that function returns instead.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + answer TypeId (= no-type))
  (prop + result TypeId (= no-type))
  (prop + recursive Bool)
  (prop + stream TypeId (= no-type))
  (prop + buffer TypeId (= no-type))
  (prop + adapted TypeId (= no-type))
  (prop + relayed TypeId (= no-type))
)

(type + PatternArgument (is Struct)
  ; A pattern given to a rule as an argument, `~ p`, which the reference passes as a function
  ; the rule calls with its stream: the instance the call is in, the argument, what the
  ; pattern gives and the optional of it the function answers, the types of the stream and of
  ; its buffer, and the instance of the rule a pattern that is a call of one alone calls, whose
  ; function is passed, or none where a function is made of the pattern where it is written.
  ; One written under a helper is typed for it, and its function is given the helper after
  ; where it keeps the farthest cursor. A function made of a pattern is given, where the pattern
  ; is passed, what the names from `params` on in `action-slots` and `action-types` hold: the
  ; arguments and locals of the function it is written in that the pattern reads, and the
  ; arguments of a rule whose local rule it calls. `local` is the local rule a pattern that is a
  ; call of one alone calls, and where the instance raises errors, `raised` is what a function
  ; made of such a pattern returns where it runs the rule as a function: its answer or one of
  ; the errors.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + result TypeId)
  (prop + answer TypeId)
  (prop + stream TypeId)
  (prop + buffer TypeId)
  (prop + rule InstanceId)
  (prop + helper TypeId (= no-type))
  (prop + params (of RowRange U32) (= (call (of RowRange U32))))
  (prop + local SyntaxId (= 0))
  (prop + raised TypeId (= no-type))
)

(type + RuleCall (is Struct)
  ; A call of a local rule from the arms of another, or of itself: the instance, the rule whose
  ; arms hold the call, and the rule called.
  (blank)
  (prop + instance InstanceId)
  (prop + from SyntaxId)
  (prop + to SyntaxId)
)

(type + ContentLink (is Struct)
  ; A line of a markup element's body whose value the element takes: the instance, the line,
  ; the type of the element, the type the method that takes the value is given, and the call
  ; of that method, which no call in the source writes. A line that is an attribute is kept
  ; with no call: its value went to the element's constructor, and the line runs nothing. A
  ; line that is an element a name is declared for, taken by a method that answers a value,
  ; gives the name that value: `answers` is its type, and the conversion of it as a value
  ; assigned to the name is recorded at the line. A line taken by a markup host's
  ; `markup-content` is then linked by the markup runtime's `append`. A line a live action gives
  ; again in place of what the element took is put in place by `append`, the markup runtime's
  ; `markup-replace`, where the element is a markup host, and what was taken is then closed by
  ; the call `close`, or by closing the actions it owns where there is none.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + parent TypeId)
  (prop + taken TypeId)
  (prop + call FactId)
  (prop + answers TypeId (= no-type))
  (prop + append InstanceId (= no-instance))
  (prop + close FactId (= no-fact))
)

(type + FillerCall (is Struct)
  ; The call of the function that fills an object with the markup written in its class, made
  ; by a constructor of the class once its body has run, or by the function of a class below
  ; before its own lines: the instance that calls, and the call, which no call in the source
  ; writes.
  (blank)
  (prop + instance InstanceId)
  (prop + call FactId)
)

(type + DeferredValues (is Struct)
  ; The properties a constructor gives their first values only once the markup of its class has
  ; run, in the order it gives them: a range of `deferred-places`, each a place among all
  ; properties.
  (blank)
  (prop + instance InstanceId)
  (prop + start U32)
  (prop + count U32)
)

(type + TrackedProperty (is Struct)
  ; A property some read tracks, by the class that declares it and its name: every store to it,
  ; through that class or one below it, runs the actions that read it.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + name Atom)
)

(type + OwnedSubscription (is Struct)
  ; A subscription to a stream that an object owns, for the instance that types the loop or the
  ; comprehension that makes it, at that node: the constructors of the `Subscription` that wraps
  ; the subscriber and of the `SubscriptionTracker` that subscribes it when the live action that
  ; holds it is made.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + subscription InstanceId)
  (prop + tracker InstanceId)
)

(type + LatestRead (is Struct)
  ; A read of the latest item of a stream, `##` of it, for the instance that types it, at its
  ; node: the `Broadcastable` the stream is made, the constructor of the `BroadcasterTracker`
  ; that holds the latest item, and `publisher` where the stream only iterates.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + stream TypeId)
  (prop + tracker InstanceId)
  (prop + publisher InstanceId)
)

(type + LiveStatement (is Struct)
  ; An assignment or a lazy declaration whose value reads something tracked, for the instance
  ; that types it, at that node: a live action runs it again through `rerun`, the instance of
  ; the function written for it, which types the statement again as a closure does. A
  ; declaration's value is evaluated at whichever read runs first; `read` is its first read in
  ; the order written. The `whenever` clause of a loop on a stream is one too, at the clause, which
  ; its function tests again. So is an argument of a markup element given by position, whose
  ; function stores it again in `property`, the place of the property its parameter names. The
  ; action of an attribute or an argument of an element of a markup host is made by `owned`:
  ; with the batch in force where `rooted` says so, else for the element as its host. That of a
  ; declaration is owned by the object of `holder` in force where it is first read, none where
  ; that is none, and is made by `owned`, given the object as the batch where `rooted` says so,
  ; else as its host, or as a plain one where `owned` is none.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + rerun InstanceId)
  (prop + read SyntaxId (= 0))
  (prop + property U32 (= (. U32 max)))
  (prop + owned InstanceId (= no-instance))
  (prop + rooted Bool)
  (prop + holder TypeId (= no-type))
)

(type + EventUseKind (is U32)
  ; How a node uses the event it names: it publishes to it, subscribes to it, makes it a
  ; `Broadcastable`, publishes a `RoutedEvent` along its route of owners, or gives the address of
  ; a keyed event a new key or gives it up.
  (variant event-publish (= 0))
  (variant event-subscribe (= 1))
  (variant event-escape (= 2))
  (variant event-route (= 3))
  (variant event-rekey (= 4))
  (variant event-release (= 5))
)

(type + ElementRoot (is Struct)
  ; What a markup element whose class is a markup host does under a batch of markup, where one
  ; is in force: `ensure` puts it under the batch before its body runs, and `mount` mounts it
  ; as a root of the batch once it is made, where it is no line of another element. `owns` says
  ; the batch is the element itself, else the batch is the one the enclosing element runs under.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + ensure InstanceId (= no-instance))
  (prop + mount InstanceId (= no-instance))
  (prop + owns Bool)
)

(type + SlotOutlet (is Struct)
  ; A slot outlet of the markup written in a class, as the function that fills an object of the
  ; class mounts it: the node the function that builds the slot gives, which the filling function
  ; takes as its argument at `argument`, or which a function written in it reads from the local
  ; `held`, or else, where it is given none, the one `fallback`, the element its body writes,
  ; makes; `content` is the type of the slot, to which that node is cast. Nothing is mounted where
  ; neither is. Where the slot repeats, `item` is the name of what the function is given. The
  ; lines of its body that assign give the node their properties after.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + argument U32 (= (. U32 max)))
  (prop + fallback SyntaxId (= 0))
  (prop + content TypeId (= no-type))
  (prop + held SlotId (= no-slot))
  (prop + item SyntaxId (= 0))
  (prop + chosen InstanceId (= no-instance))
  (prop + picks TypeId (= no-type))
  (prop + arm TypeId (= no-type))
)

(type + SlotChoice (is Struct)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + line SyntaxId)
  (prop + choice TypeId)
  (prop + create InstanceId)
  (prop + fill InstanceId)
  (prop + selector TypeId)
)

(type + BranchRegion (is Struct)
  ; An `if` written as a line of markup content whose conditions read something tracked, which the
  ; reference makes a region of the host it is content of: `content` is the host's content type, which
  ; the arms' functions are given and the region is, made by `create` from the list (`list`) of the
  ; arms made `MarkupBranchBuilder`s and the index of the arm whose condition holds, an optional
  ; (`selected`). The action that selects the arm again is made by `action` with the host as its owner
  ; and marked structural by `structural`; its function, `updater`, asks `keeps` whether the region
  ; keeps the arm, and else closes what the region owns and selects it with `select`. Where a batch is
  ; found for the host, the host itself where `hosted` says so and else the one in force, `ensure`
  ; puts the region under it and the action is made with it. `rooted` says a batch is in force where
  ; the region is written, which the arms are built under.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + host TypeId)
  (prop + content TypeId)
  (prop + list TypeId)
  (prop + selected TypeId)
  (prop + create InstanceId)
  (prop + updater InstanceId)
  (prop + action InstanceId)
  (prop + structural InstanceId)
  (prop + keeps InstanceId)
  (prop + select InstanceId)
  (prop + ensure InstanceId (= no-instance))
  (prop + hosted Bool (= false))
  (prop + rooted Bool (= false))
)

(type + LoopRegion (is Struct)
  ; A `for` written as a line of markup content whose container reads something tracked, which
  ; the reference makes a region of the host it is content of: `content` is the host's content
  ; type, which the function that builds each row gives, made a `MarkupRowBuilder` at the `for`,
  ; and `source` the type of the container, which `create` makes the region of with the host and
  ; the builder. The action that reads the container again is made by `action` with the region as
  ; its owner and marked structural by `structural`; its function is `updater`, which gives the
  ; region what the container gives by `replace`, the runtime's replacer for the source.
  ; Where a batch is found for the host, the host itself where `hosted` says so and else the
  ; one in force, `ensure` puts the region under it. `rooted` says a batch is in force where
  ; the region is written: the rows are built under it, and the action is made with it. A `source`
  ; that is optional is made a region by the runtime's optional variants of `create` and
  ; `replace`, with no rows while it holds none. A row that is a region of its own is built by a
  ; function given the item and the region, which `adapts` makes the builder `create` takes of.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + host TypeId)
  (prop + content TypeId)
  (prop + source TypeId)
  (prop + create InstanceId)
  (prop + updater InstanceId)
  (prop + action InstanceId)
  (prop + structural InstanceId)
  (prop + ensure InstanceId (= no-instance))
  (prop + hosted Bool (= false))
  (prop + rooted Bool (= false))
  (prop + replace InstanceId (= no-instance))
  (prop + adapts InstanceId (= no-instance))
)

(type + SelfAction (is Struct)
  ; How a constructor, or the function that fills an object with its class's markup, an
  ; instance, makes the live actions the object owns as it is made, where its class is a markup
  ; host or batch: by `maker`, the markup runtime's `make-owner-markup-action`, given the object as
  ; its host, or `make-markup-action` where it is a batch and no host (`rooted`), given it as the
  ; batch, converted at `site`. None where the object makes none.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + maker InstanceId)
  (prop + rooted Bool)
)

(type + MarkupQuery (is Struct)
  ; A property a class, `level`, declares with a type that queries the markup its object is in,
  ; `Ancestor'T` or `Descendants'T`, at `place` among all properties and written at `site` of
  ; `module`, as the functions made for it read it: `target` is `T`, and `target-id` the number of `T`
  ; among the targets of descendant queries, or none for an ancestor query. `hosted` is the conversion
  ; of an object of the class to its markup host, and the runtime functions those functions call are
  ; `parent` (`markup-query-parent-host`) for an ancestor query, and `add` and `remove`
  ; (`markup-query-add-descendant'T`, `markup-query-remove-descendant'T`) for a descendant one.
  (blank)
  (prop + level TypeId)
  (prop + place U32)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + target TypeId)
  (prop + target-id U32)
  (prop + hosted FactId)
  (prop + parent InstanceId)
  (prop + add InstanceId)
  (prop + remove InstanceId)
)

(type + QueryRegistration (is Struct)
  ; A registration a constructor, `instance`, makes once the rules of `level`, a class of its
  ; object, have run, by `register`, with the object as its markup host as converted at `site`:
  ; of a markup query, a row of `markup-queries`, or where `query` is none, of the object as a
  ; target of each descendant query that looks for `level` or a class above it, which program
  ; tables find once typing has numbered them all (`ProgramTables.target-ids-of`).
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + level TypeId)
  (prop + query U32)
  (prop + register InstanceId)
)

(type + MarkupTrigger (is Struct)
  ; A `whenever` rule of a class that runs where the markup an object is in changes, typed by
  ; `instance` for the class that writes it: `target` is the class it looks for, `target-id` the
  ; number of `target` among the targets of descendant queries, or none for an ancestor one, for
  ; which `found` is the optional of `target` that keeps the ancestor found last, and `host` the
  ; markup host the object is converted to. `changes` is the type of the set of
  ; changes its `- changes` names, or none, made by `made` and emptied by `clear`, whose lists
  ; take an object by `record`. The rule registers with `register`, finds a parent host with
  ; `parent`, and runs its live action by `schedule`.
  (blank)
  (prop + instance InstanceId)
  (prop + target TypeId)
  (prop + target-id U32)
  (prop + found TypeId)
  (prop + host TypeId)
  (prop + changes TypeId)
  (prop + made InstanceId)
  (prop + clear InstanceId)
  (prop + record InstanceId)
  (prop + register InstanceId)
  (prop + parent InstanceId)
  (prop + schedule InstanceId)
)

(type + RegionRoot (is Struct)
  ; The batch in force where a markup region is written, which the function that builds an arm
  ; or a row of the region, an instance, is built under, read at the body from `slot`, the local
  ; no name reaches that keeps it, as a `batch`. `ensure` puts an arm's region under it.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + slot SlotId)
  (prop + batch TypeId)
  (prop + ensure InstanceId (= no-instance))
)

(type + RowItemRead (is Struct)
  ; A name the row of a keyed markup loop region gives its item by, read at a node of an
  ; instance: `held` is the `MarkupRowItem` the name reads the item of.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + held TypeId)
)

(type + MarkupRead (is Struct)
  ; A read of a markup link at a node of an instance: `reader` is the markup runtime's function
  ; that answers the linked host, given the subject as a `MarkupElement`, and `target` the class the
  ; read gives the host as, or none where it gives the host itself.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + reader InstanceId)
  (prop + target TypeId (= no-type))
)

(type + EventUse (is Struct)
  ; An event a node uses, for the instance that types it: the class that declares it, as the
  ; object's type has it, and its name. `reference` names the event. A write publishes with
  ; `first`, which says whether anything listens, and `second`, which publishes; a loop
  ; subscribes to the endpoint `first` gives with the subscription `second` makes of its
  ; subscriber, `callback`; a value made a `Broadcastable` is the endpoint `first` gives; and a
  ; routed write publishes with `first` alone. A keyed event is named at `address`, the node
  ; that indexes it with its key: a write asks with `first` for the generation of the address,
  ; and publishes with `second` where it has one; `first` gives the endpoint at the address,
  ; which the receiver claims (see `AddressClaim`); and `first` gives the address a new key, the
  ; call's argument, or gives it up. A write that `bubbles` publishes along the parents of the
  ; object, which is converted at `reference` into an `EventNode` (`reason-event-node`).
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + reference SyntaxId)
  (prop + owner TypeId)
  (prop + name Atom)
  (prop + kind EventUseKind)
  (prop + first InstanceId)
  (prop + second InstanceId (= no-instance))
  (prop + callback InstanceId (= no-instance))
  (prop + address SyntaxId (= 0))
  (prop + bubbles Bool)
)

(type + StyleSheetUse (is Struct)
  ; A style sheet some declaration takes its value from one of the slots of, as the reference
  ; registers one the first time a declaration does, numbered by its place among them. `type` is
  ; the sheet. `singleton` is the constructor of the object whose properties give the slots' first
  ; values, and `count` of its slots are in `sheet-slots` from `first`, in the order the sheet
  ; declares them. Program tables place its registration (`ProgramTables.keep-reached-styles`).
  (blank)
  (prop + type TypeId)
  (prop + singleton InstanceId)
  (prop + first U32)
  (prop + count U32)
)

(type + StyleProjection (is Struct)
  ; How the runtime makes the bits of a style property's value of those of a slot of a style sheet
  ; of another type, as the reference's `styleSheetProjectionPlan` says: `kind` 0 copies them, and
  ; 1 wraps them as case `tag` of a union. Kind 2 gives a union's case the number of the case of
  ; the property's union that takes its value as it is: `count` of `projection-tags` from `first`,
  ; one for each of the slot's `tag` cases, a table the runtime registers by the number program
  ; tables give it (`ProgramTables.remap-number`). `preserves-none` says an optional slot that holds
  ; nothing gives the optional property nothing.
  (blank)
  (prop + kind U32)
  (prop + tag U32)
  (prop + preserves-none Bool)
  (prop + first U32)
  (prop + count U32)
)

(type + RuleSlot (is Struct)
  ; The slot of a style sheet a line of a style rule a class writes takes its value from where
  ; the rule is applied: the line at `site` of the instance that types the rule, as the
  ; application in `style-applications` numbered `application` resolves its name, the sheet by
  ; its number, the slot by its place among the sheet's slots and the projection as a
  ; `StyleDeclaration`'s.
  (blank)
  (prop + application U32)
  (prop + site SyntaxId)
  (prop + sheet U32)
  (prop + slot U32)
  (prop + projection U32)
)

(type + RuleTheme (is Struct)
  ; The value a line of a style rule a class writes declares where the rule is applied with slots
  ; of a style sheet that the line computes with: the line at `site` of the instance that types
  ; the rule, as the application in `style-applications` numbered `application` gives its values,
  ; evaluated by the row of `style-themed-values` numbered `themed`.
  (blank)
  (prop + application U32)
  (prop + site SyntaxId)
  (prop + themed U32)
)

(type + SheetSlot (is Struct)
  ; A slot of a style sheet: its property `name` of type `type`, kept in stored property `slot` of
  ; the sheet's object, with `flags` 2 where its bits encode a value (a union, or neither a number
  ; nor an object), as the reference's `styleEncodedFlagBits` says.
  (blank)
  (prop + name Atom)
  (prop + type TypeId)
  (prop + slot U32)
  (prop + flags U32)
  (prop + domains U32 (= 0))
)

(type + SheetMember (is Struct)
  (prop + root TypeId)
  (prop + type TypeId)
  (prop + singleton InstanceId)
  (prop + first U32)
  (prop + count U32)
)

(type + SheetExtension (is Struct)
  ; An extension of a style sheet the program declares, the declaration `decl` of `module`, and the
  ; style sheet it extends, the class `sheet` of `sheet-module`; `next` is the next extension of
  ; the same sheet, in the order the modules are declared, or none.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + sheet-module ModuleId)
  (prop + sheet DeclId)
  (prop + next U32 (= (. U32 max)))
)

(type + EarlyUnion (is Struct)
  ; The union of a state machine a module's or a class's property holds, made before its cases were
  ; typed, which a read of the property while they are typed gives, with the instance whose typing
  ; made it.
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + union TypeId)
)

(type + AddressClaim (is Struct)
  ; The endpoint at the address of a keyed event that the receiver claims, for the instance
  ; that types it: closed with the receiver by a `ClosableTracker`, made with `closer`, that a
  ; live action of the receiver holds. `site` names the event, where the endpoint is converted to
  ; a `Closable` and the tracker to a `Tracker`. A closable value a lazy declaration holds is
  ; claimed so by the object that owns what is made where it is evaluated, at the declaration.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + closer InstanceId)
)

(type + StyleUse (is Struct)
  ; A style some instance uses. `type` is the style. `singleton` is the constructor of the object
  ; whose properties give the style's first values, and `count` of its properties are in
  ; `style-properties` from `first`, base first. Program tables number the styles the program
  ; registers and place their registrations (`ProgramTables.keep-reached-styles`).
  (blank)
  (prop + type TypeId)
  (prop + singleton InstanceId)
  (prop + first U32)
  (prop + count U32)
)

(type + StyleUser (is Struct)
  ; An instance that uses a style or a style sheet, `type`: `module` and `site` are the first place
  ; it does in source order, a constructor's declaration before any other, which `constructed`
  ; says it is.
  (blank)
  (prop + type TypeId)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + constructed Bool)
)

(type + StyleProperty (is Struct)
  ; A property of a style, by `name` and `type`, kept at `slot` in the object the style's
  ; constructor makes. `flags` say it is inherited and that its bits encode more than a number;
  ; the domains a change to it raises are its rows of `property-domains`; `wide-shift` and
  ; `wide-tags` say which bits of its value name a boxed value.
  (blank)
  (prop + name Atom)
  (prop + type TypeId)
  (prop + slot U32)
  (prop + flags U32)
  (prop + wide-shift U32)
  (prop + wide-tags U64)
)

(type + StyleCoding (is Struct)
  ; How a style value of a type that is no number becomes the bits of a slot as styles register:
  ; an object of a class is interned by `intern`, which takes it as the optional `taken`, and a
  ; value of any other type is boxed by the constructor `holder` and the box interned by the
  ; program's `style-intern-holder`. An object a declaration holds is held by the constructor
  ; `value-holder` of the runtime's `StyleValueHolder`, which takes it as `taken`.
  (blank)
  (prop + type TypeId)
  (prop + intern InstanceId (= no-instance))
  (prop + holder InstanceId (= no-instance))
  (prop + taken TypeId (= no-type))
  (prop + value-holder InstanceId (= no-instance))
)

(type + CodingUser (is Struct)
  ; An instance whose typing turns style values of `type` into bits by its row of `style-codings`,
  ; or, where `holds`, holds an object a declaration holds by the row's `value-holder`. Program
  ; tables reach only what some instance uses.
  (blank)
  (prop + instance InstanceId)
  (prop + type TypeId)
  (prop + holds Bool)
)

(type + StyleStaticValue (is Struct)
  ; The value of a style declaration the reference evaluates once for every making of the
  ; element or application of the rule that writes it, at `site` in `module`, typed by `instance`
  ; for the property's type: a function of its own evaluates it and gives its bits. Of the instances
  ; that type the line, `instance` is the one whose stable key is least (`Facts.note-static-value`).
  (blank)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + instance InstanceId)
  (prop + type TypeId)
)

(type + StyleThemedValue (is Struct)
  ; A value of a style declaration the runtime evaluates from the slots of style sheet `sheet` it
  ; reads, as the line at `site` of a module writes it, typed by `instance`. Of a line of a style
  ; rule, `given-count` of `themed-givens` from `given` are the values the rule takes as slots.
  (blank)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + instance InstanceId)
  (prop + type TypeId)
  (prop + sheet U32)
  (prop + given U32 (= (. U32 max)))
  (prop + given-count U32)
)

(type + ThemedGiven (is Struct)
  ; A value a style rule takes as a slot of a style sheet where it is applied: the rule's local
  ; `param` and the slot by its place among the sheet's slots.
  (blank)
  (prop + param SlotId)
  (prop + slot U32)
)

(type + ThemeRead (is Struct)
  ; A slot of a style sheet an instance reads by name at `site`, a node of `module`: its own, or
  ; the module whose markup or style rules it types as written there (`Checker.enter-module`).
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + sheet U32)
  (prop + slot U32)
)

(type + StyleDomain (is Struct)
  ; A domain of invalidation, by its name, numbered by its place among them as it is first named.
  ; Program tables register it where the instances that name it say (`DomainUser`).
  (blank)
  (prop + name Atom)
)

(type + DomainUser (is Struct)
  ; An instance that names a domain of invalidation, `domain` by its place among `style-domains`:
  ; `site`, in `module`, is the first place it does in source order, which the reference would
  ; register the domain at were it the program's first, and `line`, in `line-module`, the first
  ; line that names it there: a line of a style, or the read or write of its flag. Each domain is
  ; registered at the first of its users' places, and numbered by those places
  ; (`Typing.number-domains`).
  (blank)
  (prop + instance InstanceId)
  (prop + domain U32)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + line-module ModuleId)
  (prop + line SyntaxId)
)

(type + PropertyDomain (is Struct)
  ; A domain of invalidation a change to the property `property` of `style-properties` raises, on
  ; the node or, where `parent`, on its parent: `domain` by its place among `style-domains`.
  (blank)
  (prop + property U32)
  (prop + domain U32)
  (prop + parent Bool)
)

(type + StyleSite (is Struct)
  ; A place of an instance that declares styles for an object, numbered by its place among such
  ; sites in source order, as the program's generated names are numbered: a markup element
  ; `site` of the instance's module, or the defaults rule `• This` of a class a constructor
  ; applies, `site` of the module that writes the rule.
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + number U32)
)

(type + StyleDeclaration (is Struct)
  ; An attribute of a markup element that names a property of a style the element's vocabulary
  ; holds, not one of its class: the line `site` of the element `element`, giving property
  ; `property` of `style-properties` of the style `style`, at `layer` and `order`, its
  ; value converted at the line to the property's type. `fixed` says the value reads no name, no
  ; style and nothing tracked, which the reference declares once for the site. `inherits` says
  ; the value is `inherit`, which the runtime takes from the parent as it settles. `cached` says
  ; the value is one the runtime holds a handle to and reads no local, member, style or anything
  ; tracked, which the reference evaluates once for every making (`StyleStaticValue`). `sheet` is
  ; the place among `style-sheet-uses` of the style sheet whose slot `sheet-slot` the value names,
  ; which the runtime reads as it settles, or `U32.max`; `projection` the place among
  ; `style-projections` of how the runtime makes the property's bits of the slot's, where their
  ; types differ, or `U32.max`. A line of a style rule is one of the instance that types the rule,
  ; with `element` the rule: its layer and order are those of the application, its order counted
  ; from the application's first. `reads-given` says the value of such a line reads a value the
  ; rule takes.
  (blank)
  (prop + instance InstanceId)
  (prop + element SyntaxId)
  (prop + site SyntaxId)
  (prop + style TypeId)
  (prop + property U32)
  (prop + layer U32)
  (prop + order U32)
  (prop + fixed Bool)
  (prop + inherits Bool)
  (prop + cached Bool)
  (prop + sheet U32 (= (. U32 max)))
  (prop + sheet-slot U32)
  (prop + projection U32 (= (. U32 max)))
  (prop + fixed-given Bool)
  (prop + once-given Bool)
  (prop + once Bool)
  (prop + themed U32 (= (. U32 max)))
  (prop + reads-given Bool)
)

(type + StyleApplication (is Struct)
  ; A style rule applied to an object at a site of an instance, as `StyleSite` names sites: the
  ; instance `unit` that types the rule for the class that writes it, whose declarations take
  ; `layer` and orders from `order` on. A rule that declares no style has no site of its own
  ; (`RuleUpdate`). `written` is the application written after `•` that gives the rule its
  ; values, each converted at its node to the type the rule takes it as, or none. `outer` is
  ; the application of the rule that applies this one, which comes before it among them, or
  ; `U32.max` for one the site applies; such an application's values are written in that rule,
  ; and `within` is the `when` of that rule whose body applies it, or none. The orders of the
  ; declarations of one the site applies start from `order`. A `shared` one is a rule matched by
  ; name that the reference compiles into a function every element of the class `made` it matches
  ; calls, given the object's association with the site, the site's number and the order to
  ; start from; its declarations, with those of the rules it applies, take `span` orders.
  ; `action` makes the action of each declaration of the rule whose value reads something
  ; tracked (`StyleAuthor`) for the element's object, or is none. `cell` is the state cell of the
  ; `when` around a rule written in a rule, which gates it and what it applies, or none, and
  ; `outer-cells` those of the `when`s further out that gate it too (`ScopeLink`), or none. `values`
  ; is the instance that types the values `written` gives, where that is not the one applying the
  ; rule (`Instances.intern-root-values`), or none. `around-values` are the values of the rule
  ; around a rule written in a rule, which it reads (`ScopeValues`), or none. A `prepared` one gives
  ; values that call a function, which the reference evaluates once more, and lets go, as it
  ; prepares the markup element the site is, before its object is made. `updater` makes the live
  ; action of each line of the rule that sets a property of the class again (`LiveStatement`),
  ; given the batch in force where `rooted` says so and else the object as its host, or is none
  ; where those are plain ones (`plain-updates`). One with `live-values` gives values that read
  ; something tracked, or names those of an application around it that has them: each declaration
  ; of the rule that reads them is declared again by `action` as they change (`reads-given`).
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + unit InstanceId)
  (prop + layer U32)
  (prop + order U32)
  (prop + written SyntaxId (= 0))
  (prop + outer U32 (= (. U32 max)))
  (prop + within SyntaxId (= 0))
  (prop + shared Bool)
  (prop + action InstanceId (= no-instance))
  (prop + made TypeId (= no-type))
  (prop + span U32)
  (prop + cell U32 (= (. U32 max)))
  (prop + values InstanceId (= no-instance))
  (prop + around-values U32 (= (. U32 max)))
  (prop + outer-cells U32 (= (. U32 max)))
  (prop + updater InstanceId (= no-instance))
  (prop + rooted Bool)
  (prop + plain-updates Bool)
  (prop + prepared Bool)
  (prop + fixed-values Bool)
  (prop + static-values Bool)
  (prop + family U32 (= (. U32 max)))
  (prop + members U64)
  (prop + live-values Bool)
)

(type + StyleWrite (is Struct)
  ; An assignment at `site` of an instance to a name no member of the object answers, which
  ; declares property `property` of `style-properties` of the style `style` for the object.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + style TypeId)
  (prop + property U32)
)

(type + StyleAuthor (is Struct)
  ; A declaration of a style rule whose value reads something tracked, the line `site` of the
  ; instance that types the rule: where the rule is applied, a live action declares its value
  ; again for the object as what it read changes.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
)

(type + StyleWhen (is Struct)
  ; A `when` of a style rule, written in `module`: its state read on the object, or, where
  ; `cell` is not `U32.max`, the state cell of `scope-cells` that holds whether it holds, as the
  ; reference's `styleScopeStateConditions` reads it around a rule written in its body. Where
  ; `test` is an instance, it is instead the condition written at `syntax` that a style rule
  ; written on a markup element is applied under, tested where the gate is made in the instance
  ; that writes it, and again by `test`, the function written for it, in what it captured there.
  (blank)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + cell U32 (= (. U32 max)))
  (prop + test InstanceId (= no-instance))
)

(type + ScopeCell (is Struct)
  ; The state cell the reference makes for a `when` of a style rule that holds rules written in
  ; it (`bindStyleRuleScopeStates`), at a site of an instance: a markup element, or none for the
  ; content of a class. It holds whether the state holds on the object, read as of class `owner`,
  ; which a live action keeps so once the object is made. `checked` says the state was checked.
  ; One the function that builds what a line gives a slot makes for the rules the slot's outlet
  ; applies, which it binds to what it builds, is at the site `U32.max - 1`.
  ; One the instance is given by the markup that made its object, the state cells its context
  ; gives, is at no site: it is the instance's `argument`th, counted among those cells. So is one a
  ; function that builds markup keeps from where it is made, as the reference's closures capture
  ; the values of frames: its `kept`th, the cell `source` of the instance it is written in; and one
  ; it reads from those the slot outlet that mounts what it builds holds (`read`). `key` is where
  ; the cell was made, among `Instances.state-keys`. One of no instance stands for a cell the
  ; function that builds what a line gives a slot reads from its outlet, found on the way there.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + module ModuleId)
  (prop + when SyntaxId)
  (prop + owner TypeId)
  (prop + checked Bool (= false))
  (prop + argument U32 (= (. U32 max)))
  (prop + key U32 (= (. U32 max)))
  (prop + kept U32 (= (. U32 max)))
  (prop + source U32 (= (. U32 max)))
  (prop + read Bool)
)

(type + ScopeLink (is Struct)
  ; The state cells of the `when`s around a rule written in a rule further out than the innermost,
  ; as the reference's frames each hold the cell bound where their rule was applied: the cell of
  ; the next `when` out among `scope-cells`, and the link of those further out still, or `U32.max`.
  (blank)
  (prop + cell U32)
  (prop + outer U32 (= (. U32 max)))
)

(type + OutletCell (is Struct)
  ; A state cell a slot outlet of an instance holds while the function that builds what it mounts
  ; runs, as the reference's `withMarkupOutletStyleStates` pushes the cells of the `when`s around
  ; the rules written in rules the outlet sees, by where each was made, the first of each.
  (blank)
  (prop + instance InstanceId)
  (prop + outlet SyntaxId)
  (prop + cell U32)
)

(type + SlotForward (is Struct)
  ; A line at `line` of an instance that forwards a slot whose markup sees state cells of `when`s
  ; around rules written in rules, which it holds while the builder it forwards runs
  ; (`OutletCell`), as the reference's `forwardedMarkupSlotBuilder` wraps it: the `builder` type,
  ; and the item it takes where the slot repeats, or none.
  (blank)
  (prop + instance InstanceId)
  (prop + line SyntaxId)
  (prop + builder TypeId)
  (prop + item TypeId)
)

(type + ScopeValues (is Struct)
  ; The values a style rule written after `•` at a markup element gives, which the rules written in
  ; it read where markup under the element applies them, as the reference's `MarkupStyleRuleFrame`
  ; holds the values of the rule applied: those `site` gives in `module`, at the element of an
  ; instance, kept where they are converted for the rule of the frame `frame`. Those an instance is
  ; given by the markup that made its object are at no site: they are its `argument`th on, counted
  ; among the values its context gives. So are those a function that builds markup keeps from
  ; where it is made, as the reference's closures capture the values of frames: its `kept`th, the
  ; values `source` of the instance it is written in, `count` of them of the types from
  ; `type-first` among `scope-value-types`. Those the function that builds content a style rule
  ; generates keeps are its `argument`th on among the values its context names, and have no
  ; source: each markup element the content is generated at gives its own (`StyleContent`).
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + module ModuleId)
  (prop + frame U32)
  (prop + argument U32 (= (. U32 max)))
  (prop + kept U32 (= (. U32 max)))
  (prop + source U32 (= (. U32 max)))
  (prop + type-first U32)
  (prop + count U32)
)

(type + CarriedValues (is Struct)
  ; The values of a rule around rules written in rules (`ScopeValues`) that a markup element at
  ; `site` of an instance gives its constructor, after the state cells, in the order the
  ; constructor takes them, as the reference's `markupStyleContextValues` gives its frames' values.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + values U32)
)

(type + CarriedCell (is Struct)
  ; A state cell a markup element at `site` of an instance gives its constructor, in the order the
  ; constructor takes them: that of each rule written in a rule the element sees whose `when`'s
  ; cell is given with it, as the reference's `markupStyleContextValues` gives its frames' values.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + cell U32)
)

(type + StyleContent (is Struct)
  ; A line of a style rule that generates content, applied to the markup element at `site` of an
  ; instance by the application `application` of `style-applications`, as the reference's
  ; `compileGuardedContent` makes it: the line, written in the module of the instance that types the
  ; rule, the slot it fills, 0 to 3 for before, after, first-child and last-child, and the function
  ; that builds it, `builder`, a value of the closure type `closure`, which runs it. The values of
  ; the rules around rules written in rules it keeps are those from `value-first` among
  ; `content-values`, `values` of them (`ScopeValues`) of the instance, in the order it keeps them,
  ; and the state cells of the `when`s around them it keeps those from `cell-first` among
  ; `content-cells`, `cells` of them, cells of `scope-cells` of the instance, in the order it keeps
  ; them.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + application U32)
  (prop + line SyntaxId)
  (prop + slot U32)
  (prop + builder InstanceId)
  (prop + closure TypeId)
  (prop + value-first U32 (= 0))
  (prop + values U32 (= 0))
  (prop + cell-first U32 (= 0))
  (prop + cells U32 (= 0))
)

(type + StyleGate (is Struct)
  ; The conditions a block of style declarations at a site is gated by, as the reference gates
  ; those of a `when` of a style rule: the states the `when`s from `first` in `style-gate-whens`
  ; name, `count` of them, the outermost first, each true, or false where it is negated, of an
  ; object of `type`. A function of its own evaluates them again as they change, which the
  ; action `action` constructs runs. One that gates `content` a style rule generates enables its
  ; record instead.
  (blank)
  (prop + type TypeId)
  (prop + first U32)
  (prop + count U32)
  (prop + action InstanceId)
  (prop + content Bool (= false))
)

(type + GateUser (is Struct)
  ; An instance whose typing gates a block of declarations or content by the row `gate` of
  ; `style-gates`. Program tables declare only the rows some instance uses.
  (blank)
  (prop + instance InstanceId)
  (prop + gate U32)
)

(type + RuleUpdate (is Struct)
  ; A line of a style rule that names a property of the class that writes it, which sets the
  ; property where the rule is applied: the instance that types the rule, the line, and the
  ; place of the property among all properties, its value converted at the line as one assigned.
  ; `reads-given` says the value reads a value the rule takes.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + property U32)
  (prop + reads-given Bool (= false))
)

(type + StyleRead (is Struct)
  ; A read of a style property, `$name`, at a node of an instance: property `property` of
  ; `style-properties` of the style `style`, read from the subject converted at the node to the
  ; runtime's pointer by `reader`.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + style TypeId)
  (prop + property U32)
  (prop + reader InstanceId)
  (prop + hosted Bool (= false))
  (prop + sheet U32 (= (. U32 max)))
  (prop + offset U32)
  (prop + type TypeId (= no-type))
  (prop + component U32 (= (. U32 max)))
  (prop + is-reference Bool)
)

(type + StyleFlag (is Struct)
  ; A read or a write of the flag of a domain, `$is-X-invalid` or `$is-X-invalid-below`, at a
  ; node of an instance: the domain's number, and the function of the style runtime that reads
  ; or writes the flag, none for one a `MarkupBatchFlush` reports.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + domain U32)
  (prop + call InstanceId)
)

(type + StyleRuntime (is Struct)
  ; The functions of the style runtime that registering styles and domains calls, and the
  ; optional of the class of boxes `intern-holder` takes; then those a markup element that
  ; declares styles calls: the record of a style by its number, the declaration of a value for
  ; the element's site or for its association, the association, and the site made ready; then
  ; those a gated block of declarations calls: its opening and closing, the action that gates
  ; it, and what that action calls; then the declaration a live action makes again for an object;
  ; then the declarations of `inherit` for a site and for an association; then those of a value
  ; the runtime holds a handle to: by its holder, for a site and for an association once for
  ; every making, and again by a live action; then what resolves the bits of a handle to the
  ; object the runtime holds; then the declarations an assignment makes for an object, of bits
  ; and by a holder; then those registering style sheets calls, the record of a style sheet by its
  ; number, and the declarations of a slot of one for a site and for an association, as it is and
  ; projected to another type, with the optional of the table a projection that remaps cases takes;
  ; then the constructor of the state cell of a `when` around rules written in a rule; then the
  ; record of content a style rule generates, and what enables it; then what a slot outlet calls
  ; to hold state cells while what it mounts is built, and what reads one of them.
  (blank)
  (prop + info-for InstanceId (= no-instance))
  (prop + info InstanceId (= no-instance))
  (prop + register-property InstanceId (= no-instance))
  (prop + register InstanceId (= no-instance))
  (prop + register-domain InstanceId (= no-instance))
  (prop + intern-holder InstanceId (= no-instance))
  (prop + held TypeId (= no-type))
  (prop + info-required InstanceId (= no-instance))
  (prop + site-static InstanceId (= no-instance))
  (prop + template-static InstanceId (= no-instance))
  (prop + associate InstanceId (= no-instance))
  (prop + site-ready InstanceId (= no-instance))
  (prop + open-block InstanceId (= no-instance))
  (prop + close-block InstanceId (= no-instance))
  (prop + dynamic InstanceId (= no-instance))
  (prop + block-enabled InstanceId (= no-instance))
  (prop + author-dynamic InstanceId (= no-instance))
  (prop + site-inherit InstanceId (= no-instance))
  (prop + template-object InstanceId (= no-instance))
  (prop + site-cached InstanceId (= no-instance))
  (prop + site-recording InstanceId (= no-instance))
  (prop + site-recorded InstanceId (= no-instance))
  (prop + author-object InstanceId (= no-instance))
  (prop + object-pointer InstanceId (= no-instance))
  (prop + imperative InstanceId (= no-instance))
  (prop + imperative-object InstanceId (= no-instance))
  (prop + sheet-info-for InstanceId (= no-instance))
  (prop + sheet-info InstanceId (= no-instance))
  (prop + sheet-register-slot InstanceId (= no-instance))
  (prop + sheet-register InstanceId (= no-instance))
  (prop + sheet-info-required InstanceId (= no-instance))
  (prop + sheet-register-member InstanceId (= no-instance))
  (prop + sheet-member-slot InstanceId (= no-instance))
  (prop + sheet-member-tag InstanceId (= no-instance))
  (prop + site-themed InstanceId (= no-instance))
  (prop + themed-slot InstanceId (= no-instance))
  (prop + themed-none InstanceId (= no-instance))
  (prop + themed-made TypeId (= no-type))
  (prop + site-family InstanceId (= no-instance))
  (prop + site-family-end InstanceId (= no-instance))
  (prop + site-sheet InstanceId (= no-instance))
  (prop + site-projected InstanceId (= no-instance))
  (prop + remap-tags TypeId (= no-type))
  (prop + scope-state InstanceId (= no-instance))
  (prop + template-content InstanceId (= no-instance))
  (prop + content-enabled InstanceId (= no-instance))
  (prop + outlet-mark InstanceId (= no-instance))
  (prop + outlet-push InstanceId (= no-instance))
  (prop + outlet-release InstanceId (= no-instance))
  (prop + outlet-state InstanceId (= no-instance))
)

(type + LoweredHandler (is Struct)
  ; A section of a class on an event of the object itself that the reference runs from a table
  ; of the class constructed, `type`, rather than subscribing it for each object: the section
  ; `syntax` of the rule `decl` that `level` writes in `module`, the event, as the class that
  ; declares it has it, and its name, and where the handler falls among those of the event.
  ; One that `arrives` hears only the publications its object is the target of.
  (blank)
  (prop + type TypeId)
  (prop + level TypeId)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + syntax SyntaxId)
  (prop + owner TypeId)
  (prop + name Atom)
  (prop + order U32)
  (prop + arrives Bool (= false))
)

(type + EventClause (is Struct)
  ; A loop on an event in `module` whose first clause, `when arrival` or `when bubbling`, says
  ; which publications it hears rather than being tested: with `arrival`, only those the object
  ; is the target of.
  (blank)
  (prop + module ModuleId)
  (prop + loop SyntaxId)
  (prop + arrival Bool)
)

(type + WheneverCalls (is Struct)
  ; The calls the function that tests a `whenever` clause again makes as the clause's value
  ; changes, for its instance: the broadcaster's `subscribe` and `unsubscribe`, each given the
  ; subscription, kept apart from the calls of the clause's nodes. One whose subscription an
  ; object `owns` makes neither: it adds the tracker that subscribes it to the trackers of the
  ; action that runs it, where the clause holds.
  (blank)
  (prop + instance InstanceId)
  (prop + owns Bool)
  (prop + subscribe FactId (= no-fact))
  (prop + unsubscribe FactId (= no-fact))
)

(type + SectionRef (is Struct)
  ; A section of a class typed for `level`: the section `syntax` written in `module`.
  (blank)
  (prop + level TypeId)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
)

(type + TypedSection (is Struct)
  ; A section of a class an instance typed for `level`: the section `syntax` written in `module`,
  ; typed as one run from the table of each class planned then that runs it (`lowered`), or as a
  ; subscription. A type pass that types on many workers takes the instance in only where the plans
  ; of every worker together type it the same (`merge-sessions`).
  (blank)
  (prop + instance InstanceId)
  (prop + level TypeId)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + lowered Bool)
)

(type + CollectionRead (is Struct)
  ; A tracked read in an instance whose value is a collection, whose changes the action the read
  ; runs in follows too.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
)

(type + PulledSite (is Struct)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
)

(type + TrackedLocals (is Struct)
  ; The first node of an instance that reads one of its locals tracked, where the reference
  ; makes the function's list of subscribers: a store to a tracked local after it runs the
  ; actions that read the local.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
)

(type + ChangeTest (is Struct)
  ; The runtime function a rule of a class calls, for the instance that types the rule: the one
  ; that tells whether the value of a `whenever` rule has changed, or the one that subscribes
  ; a dependency's method to a property, which for an object of a markup host is given the
  ; object as its host too (`hosted`).
  (blank)
  (prop + instance InstanceId)
  (prop + tester InstanceId)
  (prop + hosted Bool (= false))
)

(type + NamedStore (is Struct)
  ; A markup element written with a name, in a function run on an object whose class has a
  ; property of that name: once the element's line has run, the property holds what the name
  ; holds. The instance, the element, and the place of the property among all properties. The
  ; conversion of the value as one the property is declared with is recorded at the element.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + property U32)
)

(type + ElementStore (is Struct)
  ; A value a markup element is given that the reference stores in a property once the object
  ; is made, whatever the constructor stored there: an attribute that names no parameter of the
  ; constructor, or an argument whose parameter has the name of a property. The instance, the
  ; element, the place of the value among the arguments written and then the attributes the
  ; constructor is given, the place of the property among all properties, and where the
  ; conversion of the value as one assigned is recorded: nowhere for an attribute, which is
  ; converted before the constructor takes it. An attribute a setter answers is no argument: the
  ; setter, chosen at the attribute's name, the `setter`, is given the value, the `argument`-th
  ; such attribute of the element, and `property` is none. The stores of one element are linked
  ; by `next`, in the order the reference makes them: the attributes, then the arguments.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + argument U32)
  (prop + property U32)
  (prop + converted SyntaxId)
  (prop + setter SyntaxId (= 0))
  (prop + next U32 (= (. U32 max)))
)

(type + RaisedElement (is Struct)
  ; A markup element that is given a name, whose object is made where the block that declares
  ; the name starts: the instance, that block, and the element. Those of one block are linked
  ; by `next`, in the order they are made.
  (blank)
  (prop + instance InstanceId)
  (prop + block SyntaxId)
  (prop + element SyntaxId)
  (prop + next U32 (= (. U32 max)))
)

(type + RaisingRule (is Struct)
  ; A rule given a pattern whose function may raise errors, for which the reference makes a
  ; function of the rule that carries them: the rule's instance, what the pattern's function
  ; returns, and what the rule's function then returns, its answer or one of the errors. One
  ; with a `rule` is of a local rule of that rule, for the function made of it in turn.
  (blank)
  (prop + instance InstanceId)
  (prop + given TypeId)
  (prop + result TypeId)
  (prop + rule SyntaxId (= 0))
)

(type + MachineStore (is U8)
  ; Where a state machine keeps its value as it moves: nowhere a program reads it, in the local
  ; of the function it is written in that it is declared into, in a global of its module, in a
  ; property of the object it is written for, nowhere but in the flags of the object whose
  ; markup it is a line of, a property named after each case, or in the machine around it, as a
  ; named machine written in one of its cases.
  (variant store-none (= 0))
  (variant store-local (= 1))
  (variant store-global (= 2))
  (variant store-member (= 3))
  (variant store-content (= 4))
  (variant store-nested (= 5))
)

(type + MachineFact (is Struct)
  ; A state machine the type pass typed: the instance of its own function, its node, the union
  ; its value is, where it keeps its value (`MachineStore`), with the module and the declaration
  ; of the global or the property, and its groups of event transitions, from `groups` on in
  ; `machine-groups`. A named machine written in a case of another is part of the function of
  ; the machine around it, `outer`, and the case it is written in is its `parent`. The machine of
  ; a property of a class that refines the machine of its base's property of that name is
  ; `refined`: the instance of that machine's function.
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + union TypeId)
  (prop + store MachineStore)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + groups (of RowRange MachineGroup))
  (prop + outer SyntaxId (= 0))
  (prop + parent SyntaxId (= 0))
  (prop + refined InstanceId (= no-instance))
)

(type + MachineGroup (is Struct)
  ; A group of a machine's event transitions: its first transition, the case or continuation
  ; whose body holds it, or none at the root, the `Broadcastable` its stream is made, the item it
  ; gives, and the `Subscriber` the machine gives it; and the calls of the broadcaster's
  ; `subscribe` and `unsubscribe` the machine makes, kept apart from those of any node. One on an
  ; event of an object has its place among `event-uses`, and is `lowered` where the event
  ; runtime runs it from the table of the class whose object it is written for. One on a stream
  ; that is only iterable is `iterated`: `stream` is the container, read at once. `enqueue` is the
  ; event runtime's `event-machine-enqueue` of the item, which a group on a stream that is no event
  ; gives its activation, or none. A group on an event keeps one port of the event runtime for
  ; the machine, which queues what arrives: one `lowered` is made by `port` where the machine
  ; starts and given what the table runs it with by `post`; any other is made where it is first
  ; subscribed, and subscribed and unsubscribed, by `attach` and `detach`.
  (prop + head SyntaxId)
  (prop + owner SyntaxId)
  (prop + stream TypeId)
  (prop + item TypeId)
  (prop + subscriber TypeId)
  (prop + subscribe FactId)
  (prop + unsubscribe FactId)
  (prop + event U32 (= (. U32 max)))
  (prop + lowered Bool (= false))
  (prop + iterated Bool (= false))
  (prop + enqueue InstanceId (= no-instance))
  (prop + port InstanceId (= no-instance))
  (prop + post InstanceId (= no-instance))
  (prop + attach InstanceId (= no-instance))
  (prop + detach InstanceId (= no-instance))
)

(type + OutlinedAction (is Struct)
  ; An action of a grammar that the reference runs in a function of its own,
  ; `stream-action`: the instance it is in, the arm, and the names it is given, from `params`
  ; on in `action-slots` and `action-types`: its `location`, its `it` and the names its match
  ; captures, in the order it first reads them. Where the instance raises errors, `result` is
  ; what the function returns: the action's value or one of them. `unsure` says the type pass
  ; cannot tell whether the reference runs the action so: a stack trace through it may show a
  ; frame the reference's does not, and its function is refused.
  (blank)
  (prop + instance InstanceId)
  (prop + arm SyntaxId)
  (prop + params (of RowRange U32))
  (prop + result TypeId (= no-type))
  (prop + unsure Bool (= false))
)

(type + MaterialKind (is U8)
  ; How a helper given a stream match with `with` makes a value, as the reference does:
  ; - `material-text`: the text a part matched, where it is the value of an arm or `it`, made by
  ;   the helper's capture materializer from the stream's buffer and the cursors the part began
  ;   and ended at, in place of the slice.
  ; - `material-capture`: what a name captured over text, made where an action that
  ;   materializes starts, by a capture materializer, from its cursors; for an optional name,
  ;   only where it holds a value.
  ; - `material-value`: what a name captured over a value, given to a value materializer where
  ;   such an action starts; for an optional name, only where it holds one.
  ; - `material-result`: what such an action gives, given to a value materializer after it ran.
  ; - `material-ranges`: a name captured over text in a repeat that such an action makes, which
  ;   keeps a `PatternCaptureRange` of the cursors of each pass, in a list of the type given;
  ;   the action makes the list it reads of them, one by one, in a collector the call of the
  ;   `material-grow` after its `material-capture` grows.
  ; - `material-span-text`: what a name that holds a `CaptureSpan` reads as in an action, with a
  ;   helper or none: the text of the items it spans, made where the action starts by
  ;   `slice-string` of them.
  ; - `material-eager`: what a part a name captures makes of the text it matched where it
  ;   passes, by a capture materializer, which the reference makes there though nothing reads
  ;   it: an optional part captured as a whole, or a call of a rule that gives its text where
  ;   nothing in the pattern makes a value through the helper.
  (blank)
  (variant material-text (= 0))
  (variant material-capture (= 1))
  (variant material-value (= 2))
  (variant material-result (= 3))
  (variant material-ranges (= 4))
  (variant material-grow (= 5))
  (variant material-span-text (= 6))
  (variant material-eager (= 7))
)

(type + MaterialFact (is Struct)
  ; A value a helper makes for a grammar: the instance, the part or action it is made
  ; at, how, the slot of the name it is made for, the type it gives, the materializer interface
  ; whose method makes it, which the helper answers for itself or through properties it
  ; delegates that interface to, and the call of that method. The facts of one place are
  ; linked by `next`, in the order the reference makes them.
  (blank)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + kind MaterialKind)
  (prop + slot SlotId)
  (prop + type TypeId)
  (prop + interface TypeId)
  (prop + call FactId)
  (prop + next U32 (= (. U32 max)))
)

(type + RollbackBody (is Struct)
  ; A body of a grammar that holds a rollback mark: a match's pattern, a rule's, or a
  ; pattern given as an argument, with the calls of `mark` and `rewind` on the helper the marks
  ; are asked of and given back to, the type of a mark, and the type the body keeps one as,
  ; where it may hold none: an integer as itself, none being zero, as the reference keeps it,
  ; and any other as an optional.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + mark FactId)
  (prop + rewind FactId)
  (prop + held TypeId)
  (prop + kept TypeId)
)

(type + StorageBody (is Struct)
  ; A body of a grammar whose collectors keep their items where the helper says: a
  ; match's pattern, a rule's, or a pattern given as an argument, with the properties read from
  ; the helper to the context its `pattern-collector-context` gives, and that context's type.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + through (of RowRange U32))
  (prop + context TypeId)
)

(type + ObserverBody (is Struct)
  ; A body of a grammar whose helper observes the literal words it matches: a match's
  ; pattern, a rule's, or a pattern given as an argument, with the calls of
  ; `record-pattern-literal` and `rewind-pattern-literals` on the helper.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + record FactId)
  (prop + rewind FactId)
)

(type + WaveringLazy (is Struct)
  ; A lazy local of an instance read where a local its value reads is known otherwise than
  ; where the first read typed the value.
  (blank)
  (prop + instance InstanceId)
  (prop + slot SlotId)
)

(type + OverrideFact (is Struct)
  ; A method or a converter a subclass declares again: `override` answers for objects of
  ; `receiver` where `base`, that of a class it is derived from, would be called. A getter or a
  ; setter of an interface that a class below the one it is called for stores as a property is
  ; answered by the `property` the class stores, with no override.
  (blank)
  (prop + base InstanceId)
  (prop + receiver TypeId)
  (prop + override InstanceId)
  (prop + property U32 (= (. U32 max)))
)

(type + ClassInitializer (is Interface)
  (fn-do + initialize-classes _)
)

(type _ NodeCopy (is Tuple)
  (prop + peer Facts)
  (prop + first U32)
  (prop + ranges (list (of RowRange U32)))
  (prop + call-ids (list FactId))
  (prop + conversion-ids (list FactId))
  (prop + force-ids (list FactId))
)

(type _ PeerSheets
  (prop + sheets (list U32))
  (prop + projections (list U32))
  (prop + themed (list U32))
  (fn-do + This _
    (param sheets (list U32))
    (param projections (list U32))
    (param themed (list U32))
  )
)

(type + Facts
  (prop + instances Instances)
  (prop + initializer (? ClassInitializer) (= null))
  (prop + node-types (of List TypeId ArenaBacking))
  (prop + slot-types (of List TypeId ArenaBacking))
  (prop + node-calls (of List FactId ArenaBacking))
  (prop + node-conversions (of List FactId ArenaBacking))
  (prop _ node-conversion-tails (of List FactId ArenaBacking))
  (prop + node-forces (of List FactId ArenaBacking))
  (prop + node-plans (of List U8 ArenaBacking))
  (prop + node-chains (of List ChainForm ArenaBacking))
  (prop + node-constants (of List FactId ArenaBacking))
  (prop _ node-copies (? (of SyncBufferedChannel NodeCopy)))
  (prop _ node-copying (? TaskGroup))
  (prop + calls (of Table CallFact))
  (prop + call-fills (of List ArgumentFill ArenaBacking))
  (prop + steps (of List U32 ArenaBacking))
  (prop + step-callees (of List InstanceId ArenaBacking))
  (prop + conversions (of Table ConversionFact))
  (prop + conversion-parts (of Table ConversionFact))
  (prop + constants (of Table ConstantFact))
  (prop + pairs (of Table PairFact))
  (prop + forces (of Table ForceFact))
  (prop + relations (of Table RelationFact))
  (prop + unwrapped (of Table UnwrappedFact))
  (prop + chains (of Table ChainFact))
