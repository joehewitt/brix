  (fn-do _ loose-type TypeId
    (param instance InstanceId)
    (param syntax SyntaxId)
    (for (in reverse (..< 0 (. loose-types length)))
      (let held ([] loose-types (- (. loose-types length) 1 reverse)))
      (if (and (== (. held instance) instance) (== (. held syntax) syntax))
        (return (. held type))
      )
    )
    (return no-type)
  )
  (fn-do + replace-node-type _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param type TypeId)
    (if (== syntax 0)
      (return)
    )
    (let row ([] (. instances rows) instance))
    (let end (+ (. row subtree start) (. row subtree count)))
    (if (or (== (. row node-start) (. U32 max)) (< syntax (. row subtree start)) (>= syntax end))
      (return)
    )
    (= ([] node-types (- (+ (. row node-start) syntax) (. row subtree start))) type)
