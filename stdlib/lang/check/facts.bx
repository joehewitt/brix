(import ./binding)
(import ./idmap)
(import ./instances)
(import ./narrowing-key)
(import ./peer-ids)
(import ./types)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/row-range)
(import /stream/sort)
(blank)
(type-line + FactId (is U32))
(prop + no-fact FactId (= (. U32 max)))
(prop + plan-bits U8 (= 127))
(prop + plain-bit U8 (= 128))

(type + CallForm (is U32)
  ; How a call is made. `call-truth` is the call of the function that says a value is empty,
  ; made to test the node's own value as a condition. `call-operand-truth` is the same call
  ; made on an operand of the node, and its `is-swapped` says that the operand is the right one.
  ; `call-list-make` is the call a list written, or the variadic tail of a call, recorded at
  ; the call, makes of the constructor of the empty list,
  ; `call-list-reserve` the call it then makes of the function that reserves room for its
  ; items, and `call-list-data` the call of the function that answers where the array the
  ; list keeps its items in holds them. `call-store-through` is the call of `[]=` on the object
  ; an inner index reads from, which stores what `[]=` answered for the item the inner index
  ; gave; it is recorded at the inner index. `call-enum-default` is the construction of an enum
  ; with nothing given, recorded at a node whose value a number converts to the enum from: the
  ; number is the place of a value among those the enum declares, counted from zero, and the
  ; construction answers for a number that is no value's place. None is written in the source.
  ; `call-item-read` is the read of an item by a pattern of a list, or of what a key holds by
  ; a pattern of a map, recorded at the pattern written for the item: it gives what that
  ; pattern is matched against, and is no call of the pattern's own. `call-task` is the body of
  ; a task spawned where it is recorded, which runs in a task of its own, and `call-owned-task` that
  ; of one an object owns, which its `close` cancels. `call-view-range` is
  ; a call the compiler makes of a range that indexes a view of an array or a table, recorded at
  ; the index: its `normalize` for a range of positions, then its `forward`. `call-replaced` is
  ; the read of what an index holds before an array is stored there, recorded at the index
  ; assigned. `call-probe` is a call a probe that compiles makes of the probes module, recorded at
  ; the probe in the order it makes them, and `call-probe-head` one that starts a record of it.
  ; `call-probe-metric`, which calls nothing, marks a probe that compiles only as a metric of the
  ; profile, or a grammar whose results the profile counts, which the emitter counts or times
  ; through the runtime. `call-store-setter` is the call of the setter that an assigning operator
  ; stores its new value through, recorded at the property it assigns beside the getter that reads it.
  (blank)
  (variant call-function (= 0))
  (variant call-constructor (= 1))
  (variant call-method (= 2))
  (variant call-operator (= 3))
  (variant call-static (= 4))
  (variant call-getter (= 5))
  (variant call-setter (= 6))
  (variant call-closure (= 7))
  (variant call-this-constructor (= 8))
  (variant call-converter (= 9))
  (variant call-truth (= 10))
  (variant call-operand-truth (= 11))
  (variant call-list-make (= 12))
  (variant call-list-reserve (= 13))
  (variant call-list-data (= 14))
  (variant call-store-through (= 15))
  (variant call-enum-default (= 16))
  (variant call-item-read (= 17))
  (variant call-task (= 18))
  (variant call-view-range (= 19))
  (variant call-replaced (= 20))
  (variant call-probe (= 21))
  (variant call-probe-head (= 22))
  (variant call-probe-metric (= 23))
  (variant call-store-setter (= 24))
  (variant call-list-append (= 25))
  (variant call-owned-task (= 26))
)

(fn-expr + spawns-task Bool
  (param form CallForm)
  ; Whether a call of a form is the body of a spawned task, owned or not.
  (or (== form .call-task) (== form .call-owned-task))
)

(fn-expr + answers-node Bool
  (param form CallForm)
  ; Whether a call of a form gives the value of the node it is recorded at. The calls that test
  ; a value as a condition do not, nor do the calls that store through an inner index or through
  ; a setter, nor the construction of an enum for a number converted to it, nor the read of an
  ; item for a pattern, nor a task spawned, nor the calls that make a list.
  (and (!= form .call-truth) (!= form .call-operand-truth) (not made) (not listed))
  (where
    (lazy made (or unprobed (== form .call-probe) (== form .call-probe-head) (== form .call-probe-metric)))
    (lazy unprobed (or untasked (call spawns-task form) (== form .call-view-range) (== form .call-replaced)))
    (lazy untasked (or stores (== form .call-enum-default) (== form .call-item-read)))
    (lazy stores (or (== form .call-store-through) (== form .call-store-setter)))
    (lazy listed (or made-list (== form .call-list-data) (== form .call-list-append)))
    (lazy made-list (or (== form .call-list-make) (== form .call-list-reserve)))
  )
)

(type + CallFact (is Struct)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + callee InstanceId)
  (prop + form CallForm)
  (prop + fills (of RowRange ArgumentFill))
  (prop + is-partial Bool)
  (prop + propagates Bool)
  (prop + is-swapped Bool)
  (prop + through (of RowRange U32))
  (prop + next FactId (= no-fact))
)

(type + PairFact (is Struct)
  (prop + instance InstanceId)
  (prop + from TypeId)
  (prop + to TypeId)
  (prop + kind RelationKind)
  (prop + rank RelationRank)
  (prop + match Specificity)
  (prop + unified TypeId)
  (prop + ratio UnitRatio)
)

(type + RelationFact (is Struct)
  ; The relation a `compare` call names: the two types, and whether it is asked for the type that
  ; unifies them.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + from TypeId)
  (prop + to TypeId)
  (prop + unifies Bool)
)

(type + UnwrappedFact (is Struct)
  ; The value an optional chain reads from: its receiver without the optional, a value no node of
  ; the source stands for.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + type TypeId)
)

(type + ChainForm (is U8)
  (variant chain-tested (= 0))
  (variant chain-plain (= 1))
  (variant chain-absent (= 2))
)

(type + ChainFact (is Struct)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + needed Bool)
)

(type + DeclaredValueFact (is Struct)
  ; A value written with the type it is declared as: a local's, where `pattern` names it, or the
  ; value of `property` of the instance's module. `declared` is the type as written, and `found`
  ; the type of the value.
  (blank)
  (prop + instance InstanceId)
  (prop + pattern SyntaxId)
  (prop + property DeclId)
  (prop + value SyntaxId)
  (prop + annotation SyntaxId)
  (prop + declared TypeId)
  (prop + found TypeId)
)

(type + ContextCastKind (is U32)
  (variant cast-argument (= 0))
  (variant cast-return (= 1))
  (variant cast-assignment (= 2))
  (variant cast-pattern (= 3))
  (variant cast-operand (= 4))
)

(type + ContextCastFact (is Struct)
  ; A cast to the type the place it is written already takes it as: the value of a return, of an
  ; assignment to a variable or of a declaration written with that type, or an argument a call
  ; takes as that type, where the call chooses the same function without the cast (`kind`).
  ; `target` is the type cast to. A number written with a suffix is such a cast where the place,
  ; or the other operand of an operation (`cast-operand`), gives the number that type unsuffixed.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + kind ContextCastKind)
  (prop + target TypeId)
)

(type + PayloadEffectKind (is U32)
  (variant effect-call (= 0))
  (variant effect-assignment (= 1))
  (variant effect-channel-write (= 2))
)

(type + PayloadEffectFact (is Struct)
  ; An effect the payload of an event has where it is published (`payload`), as the reference finds
  ; it as it makes the payload, which it does only where something listens.
  (blank)
  (prop + instance InstanceId)
  (prop + payload SyntaxId)
  (prop + event Atom)
  (prop + kind PayloadEffectKind)
)

(type + CaseOwnerFact (is Struct)
  ; A type of which a case given to a call by its symbol alone (`syntax`) is taken by a function
  ; the call may choose, where functions it may choose take it as a case of more than one type, and
  ; whether that type is the one the function chosen takes.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + name Atom)
  (prop + owner TypeId)
  (prop + chosen Bool)
)

(type + FillFact (is Struct)
  ; A property a constructor gives its value itself: from its argument, or its lazy local, of
  ; the property's name. The property is the constructed class's own or one a base declares.
  ; `site` is where the conversion of the value to the property's type is recorded. A value a
  ; markup element gives for the property is an argument no name declares, at the place
  ; `argument`, and arrives converted.
  (blank)
  (prop + instance InstanceId)
  (prop + name Atom)
  (prop + slot SlotId)
  (prop + site SyntaxId)
  (prop + argument U32 (= (. U32 max)))
)

(type + StackRead (is Struct)
  ; A read of a global that each `do with` binds anew.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + StackNeed (is Struct)
  ; A global each `do with` binds that a function reads outside its own bindings of it, itself
  ; or through a function it calls outside one. A spawned task's body that calls the function
  ; writes the state of the global it captured into the global's slot around the call.
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + StackHold (is Struct)
  ; A global each `do with` binds whose state a nested function holds from where it is made:
  ; one it reads outside its own bindings of it, itself or through what it calls, or one a
  ; function nested in it holds where no binding of its own is open where that one is made.
  (blank)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + LocalGlobalUse (is Struct)
  ; A read or a write of a global each task or each thread holds its own of, in the order the
  ; type pass met them. TypeScript makes the value of one where it first compiles a use of it.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + ConstantGlobal (is Struct)
  ; A global the type pass holds as a constant: its value is a literal laid down before anything
  ; runs, so no read of it is checked and it keeps no state.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + GlobalUse (is Struct)
  ; A checked read of a global: the instance that reads it, the node that reads it, and the
  ; global.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + ValueRead (is Struct)
  ; A property of the receiver that the value a class writes for another property reads, by a
  ; name the binder resolved to a member or after the receiver: the instance that types the
  ; value, the property's name, where it is read, and whether the value evaluates the read
  ; whenever it is evaluated. With these emission orders the first values of an object's
  ; properties, and knows which an initializer evaluates again. The instance's row says the
  ; rest: `reads-self` that the value names the receiver, so it may read any property, and
  ; `branches` that it may evaluate a part of itself and not another.
  (blank)
  (prop + instance InstanceId)
  (prop + name Atom)
  (prop + syntax SyntaxId)
  (prop + surely Bool)
)

(type + StackScope (is Struct)
  ; The statements one `do with` runs under its binding of such a global, and the fake it binds
  ; to an effect, by its number among `Instances.swap-entries`, or 0 for none.
  (blank)
  (prop + instance InstanceId)
  (prop + first SyntaxId)
  (prop + last SyntaxId)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + entry U32)
)

(type + SwapForward (is Struct)
  ; A door typed under a `do with` that binds a fake to its effect, which calls the fake's method
  ; that answers it, the `callee`, with the fake its effect's slot holds; or none, and why
  ; (`miss`), where the fake answers it with no method.
  (blank)
  (prop + instance InstanceId)
  (prop + callee InstanceId)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + effect U32)
  (prop + miss SwapMiss)
)

(type + SwapDispatch (is Struct)
  ; A door reached where no `do with` binds a fake to its effect, as code a function value runs is,
  ; in a program that binds one somewhere: where its effect's slot holds a fake of the class `fake`,
  ; numbered `kind` there (`Instances.fake-kind`), it calls the `forwarder`, the door typed under a
  ; binding of that fake, in place of its body.
  (blank)
  (prop + instance InstanceId)
  (prop + fake TypeId)
  (prop + kind U32)
  (prop + forwarder InstanceId)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + SwapMiss (is Union)
  (variant swap-answered)
  (variant swap-missing)
  (variant swap-mismatched)
  (variant swap-unanswerable)
)

(type + ConversionReason (is U32)
  ; Why a value is converted, which also says whose value it is:
  ; - `reason-operand`: the value of the node itself, for the operator above it.
  ; - `reason-operator`: an operand the operator converts at its own node: the left one of `++`
  ;   into text, and the right one of arithmetic on a unit into the unit, by its ratio.
  ; - `reason-promotion`: an operand, at its own node, into the machine type its operator works
  ;   in. The reference makes this cast without recording it.
  ; - `reason-result`: the result of an operator, at its node, back into a unit.
  ; - `reason-own-receiver`: the receiver of the function a call is in, for a call that writes
  ;   no receiver, at the call, into the class that declares the function called. It is kept
  ;   apart from the receiver of a call whose receiver is written, which may be this call.
  ; - `reason-join`: one side of a join, at the join's node. A side takes the conversion that
  ;   starts at its own type; sides of one type convert alike.
  ; - `reason-default`: the default a parameter declares, into the parameter's type. It is at
  ;   the call for an argument the call leaves out, and at an argument that is an optional,
  ;   which takes the default when it holds no value.
  ; - `reason-relation`: the value a relation of two types is asked to `cast` or to `unify`, at
  ;   the value's own node, into the type the relation leads to. The reference makes this cast
  ;   without recording it.
  ; - `reason-pattern`: the value a type named as a pattern is given, at the type's node, into
  ;   that type. A kind that can fail is a test first, and a value that fails it does not match:
  ;   nothing panics. An optional given to the pattern is tested for a value first and
  ;   converted as what it holds, where no row starts at the optional itself. A union is
  ;   converted whole where a row starts at the union, and else case by case: `guard` is the
  ;   number of the case a row converts what is held of.
  ; - `reason-literal-return`: a text written in source that a function returns, into the type
  ;   the function declares: a function of that type converts it, or it is held as a case of a
  ;   union. The reference makes this cast without recording it.
  ; - `reason-step`: the one a range steps by where it writes no step, at the range's node, into
  ;   the range's item where that is no number. The reference makes this cast without recording
  ;   it.
  ; - `reason-piped`: what a pipe gives the function on its right as its last argument, where
  ;   that is kept at the pipe itself, apart from the pipe's own value: a list of one feed,
  ;   whose facts land where the reference shifts its feed.
  ; - `reason-markup-host`: the object of a markup element, at the element's type, into the
  ;   `MarkupElement` the markup runtime takes as it puts the element under a batch.
  ; - `reason-markup-root`: the batch in force, a `MarkupRootElement`, into the `MarkupRootElement?` the
  ;   markup runtime takes as the root of what it batches: at a markup element's type, at the
  ;   `if` or `for` of a region, and at the body of an arm.
  ; - `reason-markup-batch`: an object that is a batch, the object of a markup element at the
  ;   element's type or the host of a region at the `if` or `for`, into the `MarkupRootElement` that
  ;   what is made under it is put under and makes its actions with.
  ; - `reason-markup-region`: the region a markup branch or loop region makes, at the `if` or
  ;   `for`, into the `MarkupElement` the markup runtime puts under a batch.
  ; - `reason-markup-structural`: the host that owns the action of a markup region, the parent of
  ;   a branch or the region of a loop, at the `if` or `for`, from the `MarkupElement` it is into the
  ;   `MarkupElement?` the markup runtime orders structural actions by.
  ; - `reason-markup-arm`: the function that builds an arm of a markup branch region, at the
  ;   arm, into the `MarkupBranchBuilder` the region takes.
  ; - `reason-markup-row`: the function that builds a row of a markup loop region, at the `for`,
  ;   into the `MarkupRowBuilder` or `MarkupCollectionRowBuilder` the region takes.
  ; - `reason-markup-key`: the function that keys a row of a markup loop region, at its `keyed by`
  ;   clause, into the `MarkupKeyBuilder` the region takes.
  ; - `reason-markup-slot`: the function that builds what a markup element gives a slot, at the
  ;   element that binds the slot, into the `MarkupSlotBuilder` the host's constructor takes.
  ; - `reason-event-node`: the object an event bubbles from, at the node that names the event,
  ;   into the `EventNode` the event runtime walks the object's parents with.
  (blank)
  (variant reason-argument (= 0))
  (variant reason-assignment (= 1))
  (variant reason-declaration (= 2))
  (variant reason-return (= 3))
  (variant reason-join (= 4))
  (variant reason-element (= 5))
  (variant reason-print (= 6))
  (variant reason-explicit (= 7))
  (variant reason-operand (= 8))
  (variant reason-receiver (= 9))
  (variant reason-promotion (= 10))
  (variant reason-result (= 11))
  (variant reason-operator (= 12))
  (variant reason-default (= 13))
  (variant reason-relation (= 14))
  (variant reason-pattern (= 15))
  (variant reason-literal-return (= 16))
  (variant reason-step (= 17))
  (variant reason-piped (= 18))
  (variant reason-markup-host (= 19))
  (variant reason-markup-root (= 20))
  (variant reason-markup-arm (= 21))
  (variant reason-markup-row (= 22))
  (variant reason-markup-key (= 23))
  (variant reason-markup-batch (= 24))
  (variant reason-markup-region (= 25))
  (variant reason-markup-structural (= 26))
  (variant reason-markup-slot (= 27))
  (variant reason-own-receiver (= 28))
  (variant reason-event-node (= 29))
)

(type + ConversionRaise (is U8)
  ; What becomes of an error given by the function a conversion calls:
  ; - `raise-unsettled`: the function gives none, or the type pass settled nothing, and
  ;   emission has no shape for a function that gives one.
  ; - `raise-leaves`: the error leaves the function the conversion is written in, as the error
  ;   of a call there would.
  ; - `raise-panics`: the value is a text written in source, and the error is a panic with the
  ;   error's text as its message.
  (blank)
  (variant raise-unsettled (= 0))
  (variant raise-leaves (= 1))
  (variant raise-panics (= 2))
)

(type + LoopTake (is U8)
  ; What the header of a loop does with an item it has read:
  ; - `take-whole`: it writes no pattern, or a name for the item whole, and does no more.
  ; - `take-arms`: its pattern is the arms of a match, and the arm an item fits gives the item
  ;   of the turn; an item none fits is passed over.
  ; - `take-fitted`: its pattern is written as a match, and an item that does not fit is passed
  ;   over.
  ; - `take-fields`: it writes names for the fields of a tuple, and takes the item apart.
  ; - `take-converted`: it writes a name with a type, which the item is converted to.
  ; - `take-declared`: it writes a pattern a declaration is written with, which panics where
  ;   the item does not fit.
  ; - `take-unshaped`: it writes the arms of a match not written as one, which has no shape.
  (blank)
  (variant take-whole (= 0))
  (variant take-arms (= 1))
  (variant take-fitted (= 2))
  (variant take-fields (= 3))
  (variant take-converted (= 4))
  (variant take-declared (= 5))
  (variant take-unshaped (= 6))
)

(type + ConversionFact (is Struct)
  ; A conversion recorded where a value is used. Where the type asked for is one of several
  ; alternatives, `to` is the alternative the value converts to and `asked` the type asked
  ; for. `casts` says the value is of a function type and becomes one of another, by a
  ; function made for the two types.
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + from TypeId)
  (prop + to TypeId)
  (prop + kind RelationKind)
  (prop + rank RelationRank)
  (prop + reason ConversionReason)
  (prop + ratio UnitRatio)
  (prop + callee InstanceId (= no-instance))
  (prop + next FactId (= no-fact))
  (prop + parts FactId (= no-fact))
  (prop + case-index U32 (= (. U32 max)))
  (prop + guard U32 (= (. U32 max)))
  (prop + raise ConversionRaise (= .raise-unsettled))
  (prop + runs InstanceId (= no-instance))
  (prop + asked TypeId (= no-type))
  (prop + casts Bool)
)

(type + OperatorPlan (is U8)
  ; How a node is answered where its syntax does not say. Emission follows the plan and decides
  ; nothing itself. A node the body of its instance did not reserve has no plan.
  ; - `plan-builtin`: the machine operation. Both operands arrive in one type by the conversions
  ;   recorded at them, the right one after the conversion the node records with
  ;   `reason-operator`. A conversion recorded at the node with `reason-result` gives the result
  ;   its type. `!` of an optional has this plan too: it is true when the optional holds no
  ;   value.
  ; - `plan-sign-checked-left`, `plan-sign-checked-right`: a comparison of a signed integer
  ;   with an unsigned one at least as wide. The named operand is the signed one, and it is
  ;   tested for negative before the two are compared as unsigned.
  ; - `plan-call`: the function recorded at the node answers.
  ; - `plan-negated-call`: that function's answer, negated: `!=` through `==`, `<=` through `>`.
  ; - `plan-neither-call`: two functions recorded at the node; the answer is that neither holds:
  ;   `<` through `>` and `==`.
  ; - `plan-not-or-call`: two functions recorded at the node; the answer is that the first
  ;   does not hold or the second does: `<=` through `>=` and `==`.
  ; - `plan-unit-name`: the node reads `unit` of a number: the name the number's type is
  ;   written with.
  ; - `plan-range-loop`: the node is the header of a loop that counts through a range of
  ;   integers itself.
  ; - `plan-index-loop`: the node is the header of a loop that counts through the indexes of
  ;   its container. The calls recorded at the node are the getter of its length and then its
  ;   `[]`. An array has no getter recorded: a constant fact names the field that is its
  ;   length.
  ; - `plan-cursor-loop`: the node is the header of a loop that steps a cursor through its
  ;   container. The calls recorded at the node are the getter of the state it starts at and
  ;   the function that takes a state and gives the next with an item, or with none at the end.
  ; - `plan-stream-loop`: the node is the header of a loop that reads its container as a
  ;   stream. The calls recorded at the node are the function that begins, the one that reads
  ;   an item, or none at the end, and the one that ends, which runs however the loop is left.
  ;   A header with no plan has no shape yet. What a loop keeps from one pass to the next is in
  ;   the slots the binder declared for it, typed as its plan needs them.
  ; - `plan-table-loop`: the node is the header of a loop over a table, a span or a selection of
  ;   one, or an index span, which counts through its items as TypeScript does: the rows are
  ;   found once, checked where the table grows, and each item is the row at the next index; an
  ;   index span's length is read once, and each item is read as `s[i]` reads it. No call is
  ;   recorded. The loop keeps the first row, the selection or the index span, and the count of
  ;   items, then the count read; a selection's constant tells how it reads its indices.
  ; - `plan-step`: the node calls a generator for its next item: the code the value holds is
  ;   given the data it holds and answers the node's type, an optional of an item, which holds
  ;   nothing once the generator has finished.
  ; - `plan-index-place-loop`, `plan-cursor-place-loop`: as `plan-index-loop` and
  ;   `plan-cursor-loop`, over a tuple or a struct read from where it is kept. The reference
  ;   holds such a container by its address, so a function that does not yield reads it anew
  ;   at each item and sees what the body stored there. The upper half of the constant fact
  ;   at the node names the expression evaluated once, the object a property of which the
  ;   container is, or none; all its bits are set where the container has no shape so.
  ; - `plan-through`: the node reads a property its object stores in a property it delegates
  ;   an interface to. A constant fact holds where the places of the properties read from the
  ;   object to reach the one that stores it are kept, in the order they are read.
  ; - `plan-pointer-add`: the node adds a count of items to a pointer.
  ; - `plan-count-leading-zeros`, `plan-f64-sqrt`, `plan-f64-abs`, `plan-f64-min`,
  ;   `plan-f64-max`: the node calls a function the compiler answers itself, which has no body.
  ; - `plan-constant`: the node is a constant the type pass worked out, which a constant fact
  ;   holds.
  ; - `plan-field`: the node names a field of a tuple or struct by a constant index. A constant
  ;   fact holds the field's place among those stored, which for an assignment may be the one
  ;   past the last. A read of `size`, `length` or `data` of an array has the plan too: no
  ;   getter is called, and the constant is the place of the stored field that holds the answer.
  ; - `plan-extend`: the node gives a tuple with one more field: those of its left operand, and
  ;   the value.
  ; - `plan-truncate`: the node gives a tuple of the first fields of its object, as many as the
  ;   node's type has.
  ; - `plan-fields`, `plan-not-fields`: the node compares two tuples or structs field by field,
  ;   for equal or for not equal. Its call facts are the `==` of every pair that declares one,
  ;   in the order the fields are stored, and the getter read for each pair of interfaces; the
  ;   machine compares any other pair of one type that `compares-by-machine`. A pair with none of
  ;   one class, or of atoms, is equal when it is one object or one atom, and any other is two
  ;   tuples or structs compared the same way. Two unions of one type are compared so too: they
  ;   are equal where both hold the same case and what it holds is equal, each case that holds a
  ;   value of its own being a pair, in the order of the cases.
  ; - `plan-tuple`: the node is a call that writes a tuple: its arguments are the fields.
  ; - `plan-unlike`: the node compares two values that are never equal: tuples or structs that
  ;   store other numbers of fields, or fields under other names, or objects of two classes,
  ;   even where one is derived from the other, or an object and an interface, as the reference
  ;   compares them. Both are evaluated; the answer is false for equal and true for not equal.
  ; - `plan-identity`: the node compares two objects of one class, or two atoms, for equal or
  ;   for not equal: they are equal when they are one object, or one atom.
  ; - `plan-class-test`: the node tests whether an object is of a class or of one derived from
  ;   it, or for `is not` whether it is not. A constant fact holds the class, as the bits of
  ;   its type.
  ; - `plan-alike`: the node compares two types given as values that are one type. Both are
  ;   evaluated; the answer is true for equal and false for not equal. Two that are not one
  ;   type have `plan-unlike`. The `==` the type of such values declares is recorded at the
  ;   node, as the reference records it, and is never called.
  ; - `plan-guarded-read`: the node reads a global that may have no value yet where the read
  ;   stands, the property a markup element written in an `if` or a `match` of a class's
  ;   markup declares, which holds nothing until a branch makes the element, or the local of a
  ;   markup element of a function's markup that a closure made before the element reads: the
  ;   read is checked, and panics when it has none. An assigning operator has this plan at the
  ;   place it assigns.
  ; - `plan-type-base`: the node reads the base of a type given as a value: its answer is the
  ;   type the node has.
  ; - `plan-concrete-name`, `plan-concrete-key`: the node reads the name or the key of the
  ;   class an object was constructed as, which no constant gives: it is read from the value.
  ; - `plan-absent`: the node compares an optional with `null`, for equal or for not equal: the
  ;   two are equal when the optional holds nothing. An operand whose type is not an optional
  ;   reads a local the flow knows to hold a value, and the two are not equal.
  ; - `plan-address`: the node reads the address a pointer holds, as a number.
  ; - `plan-address-compare`: the node compares two C pointers by the addresses they hold, as
  ;   unsigned numbers, whatever they point to: TypeScript's C pointer is a `U64`.
  ; - `plan-object-from-pointer`: the node calls a function the compiler answers itself, which
  ;   gives the object of a class at the address a pointer holds, its bits as they are. The
  ;   caller vouches for the object's class.
  ; - `plan-invoke-lowered`: the node calls a function the compiler answers itself, which calls
  ;   the function at the address a pointer holds with an object's address and a payload, as a
  ;   function that may panic is called.
  ; - `plan-witness-pointer`: the node calls a function the compiler answers itself, which gives
  ;   the address of the witness table an interface value holds.
  ; - `plan-interface-from-pointer`: the node calls a function the compiler answers itself, which
  ;   makes a value of an interface from the address of an object and that of a witness table.
  ;   The caller vouches that the two belong together.
  ; - `plan-row-item`: the node names the item of a row of a keyed markup loop region, whose
  ;   function is given a `MarkupRowItem`: the name reads its `item`, tracked as `#item` is. The
  ;   type of the holder is `row-item-of` the node.
  ; - `plan-getter`: the node names a local of a row of a markup loop region that its row reads
  ;   again wherever it is named, as TypeScript does: the node gives the value its declaration
  ;   writes, made where the node is.
  ; - `plan-content-loop`: the node is a loop written with `in` as a line of markup content,
  ;   which runs its body as content as a `for` does.
  ; - `plan-element-property`: the node names a markup element of a class's markup, read in a
  ;   closure the markup makes before the element is made: the receiver's property of the name
  ;   is read when the closure runs, as the reference reads it, and panics where it holds nothing.
  ; - `plan-builder-append`, `plan-builder-reserve`: the node calls `append` of an item or
  ;   `reserve` of a builder an arena backs, which the compiler answers where it is called, as
  ;   TypeScript does: the storage grows in the arena, with the panics of its growth, and its
  ;   size and capacity are written behind the arena's header. The constant is 1 where the arena
  ;   traces the builder's items, and else 0.
  ; - `plan-type-size`: the node reads the size of a type given as a value, which the type
  ;   pass worked out no constant for: the bytes a value of the type is held in.
  ; - `plan-type-name`, `plan-type-key`: the node reads the name or the key of a type given as
  ;   a value, which the type pass recorded no constant for: the text is that of the type the
  ;   value is held as.
  ; - `plan-inlined-name`: the node reads the name of the type of a value of an interface as
  ;   inlining knows it: the name of the type the value was made from where that is known
  ;   through the calls inlined at the node, and otherwise the interface's.
  ; - `plan-item`: the node indexes a pointer: it reads the item that many items past where the
  ;   pointer points, or for an assignment stores there the value, converted as the node
  ;   records with `reason-assignment`. Nothing is checked.
  ; - `plan-array-item`: the node reads an item of an array of numbers by an index, as
  ;   TypeScript does: where the index is less than the array's size, the item is read where
  ;   the array's storage holds it, and anywhere else the call recorded at the node, of the
  ;   function that answers for an index the array does not hold, gives it.
  ; - `plan-described`: the node is a C call that allocates, resizes or copies the storage of
  ;   an array the collector owns, or one of an arena's own that reserves or copies storage for
  ;   items the arena traces. A constant fact gives the type of the items. Where an item holds
  ;   pointers the collector follows, the call is of the function of the same name that also
  ;   takes what describes the storage, which polls.
  ; - `plan-store-untraced`: the node calls the function, which has no body, that stores an
  ;   item past a pointer into memory the collector does not own: the receiver is the pointer,
  ;   and the arguments are the item and its index. Nothing is checked, and the collector is
  ;   told nothing. A constant fact is one where the item holds an object or a function, which
  ;   an arena must be told of, and else zero.
  ; - `plan-relation`: the node asks a type for its relation to another, with `compare` or
  ;   `compare-unified`. The function called is never run. The relation is known where the
  ;   program is compiled and nowhere else: a constant fact holds the text it is printed as.
  ; - `plan-relation-cast`: the node asks a relation written at it to `cast` or to `unify` a
  ;   value. The function called is never run: the answer is the argument, converted as
  ;   recorded at it with `reason-relation`.
  ; - `plan-case`: the node names a case of the union its type is, by a symbol or after the
  ;   type, alone or called. A constant fact holds the number of the case. Called with one
  ;   argument, the case holds that value, converted as recorded at it. Named alone, a case
  ;   with no value of its own holds its number.
  ; - `plan-case-fields`: the same, where the case holds a tuple or a struct and the call gives
  ;   its fields in their order, each converted as recorded at it.
  ; - `plan-case-read`: the node reads a name that holds a union, as the one case the name is
  ;   known to hold there, or as the case of a class that the classes of the others it may hold
  ;   derive from, whose value lies where theirs do. A constant fact holds the number of the
  ;   case, and the node's type is what the case holds.
  ; - `plan-never`: the node is an arm of a match whose pattern can not match its subject.
  ;   Nothing of it is typed, and nothing of it is emitted. A pattern that names a case its
  ;   subject is no union of has the plan too: it is typed, and matches nothing. So has an
  ;   `if` whose condition a type test in it can never let hold, whose body is neither typed
  ;   nor emitted, and a `&&` or `||` whose left operand decides it so, whose right one is not.
  ; - `plan-unmatched`: the node is the arms of a match on a subject with no arm that takes
  ;   whatever is left, or a pattern a declaration is written with that tests what it is
  ;   given. Where no arm matches, or the test fails, it panics.
  ; - `plan-unmatched-absent`: the node is the arms of a match on a subject written on one line,
  ;   whose last arm has a pattern. Where no arm matches, the match gives nothing.
  ; - `plan-open`: the node is the arms of the match that `if` or `while` written with a
  ;   pattern tests its value with: the arm runs the body and gives true, and where it does
  ;   not match the match gives false.
  ; - `plan-is`: the node is `is` or `is not` between a value and a pattern that is no test of
  ;   an object's class. Its right operand is planned as the pattern of an arm of a match is,
  ;   and has `plan-never` where it can not match the value.
  ; - `plan-enum-value`: the node names a value of an enum that is no union, or a case of a
  ;   union that is declared with a value, which the module that declares it makes as it
  ;   starts. A constant fact holds the module in its high 32 bits and the declaration of the
  ;   value in its low.
  ; - `plan-raise`: the node raises an error that is no panic, which leaves the function there
  ;   in place of its value.
  ; - `plan-caught-cast`: the node is a cast out of a union written under `catch`. Where the
  ;   union holds another case the cast gives the error of that in place of its value, and
  ;   nothing panics.
  ; - `plan-fused`: the node returns a value that may be an error. An error it holds leaves the
  ;   function in its place, and the function returns the value alone.
  ; - `plan-handled`: the node is an expression with handlers. A constant fact holds a bit for
  ;   each error the expression may give, in the order its type lists them, set where no
  ;   handler takes the error and it leaves the function.
  ; - `plan-reinterpret`: the node gives the value of its operand with its bits as they are, as
  ;   the node's type: an atom as the text it points at, read as `text` or by a cast, and a text
  ;   as an atom by a cast.
  ; - `plan-literal-conversion`: the node is a call of a type with one text written in source,
  ;   which a function of the type converts. An error that function gives is a panic with the
  ;   error's text as its message, not an error of the function the call is written in.
  ; - `plan-case-number`: the node reads `case` of a union, the number of the case it holds.
  ; - `plan-case-name`: the node reads `name` of a union, the name of the case it holds, which
  ;   is the empty text for a case with none.
  ; - `plan-case-type`: the node reads `type` of a union, the key of the type of the case it
  ;   holds.
  ; - `plan-case-value`: the node reads a union by the name of one of its cases. A constant
  ;   fact holds the number of the case. Where the union holds that case the node gives what
  ;   it holds, and where it holds another, the value a local of the case's type has when
  ;   nothing is written for it.
  ; - `plan-forward`: the node is a member of a union that each case answers with its own: a
  ;   call, a read or the place of an assignment. The calls recorded at the node are one for
  ;   each case, in the order of the cases; with none recorded, each case stores the property
  ;   read.
  ; - `plan-callee`: the node is the name of a local, an argument or a property that a call
  ;   calls, which holds an optional and is known there to hold a value: it is called as what
  ;   it holds.
  ; - `plan-held`: the node is `==` or `!=` of operands of which one or both are optionals,
  ;   compared as what they hold, or of a union on the left, which may be an optional, with a
  ;   value of the type one of its cases holds. A constant fact says how, as `held-of` reads
  ;   it. An optional that holds nothing equals nothing that holds a value, and a union that
  ;   holds another case than the one named equals no value. `!=` is the reverse of the whole.
  ; - `plan-list-member`: the node is `has`, `has not`, `is in` or `not in` of a list written in
  ;   place that core's `List` answers, answered as `List.has` answers it without making the
  ;   list. The operands are evaluated in the order they are written, each item converted as
  ;   recorded at it for the list and the value as recorded at it for the call of `has`
  ;   recorded at the node. Each item in turn is compared with the value, up to the first that
  ;   is equal, by the plan of `==` of two values of the list's item type recorded at the list:
  ;   `plan-builtin` or `plan-identity`, compared by the machine, or `plan-call`, the call of
  ;   `==` recorded at the list after those that make it.
  ; - `plan-list-pattern`: the node is a pattern of a list. Its subject is first what an
  ;   optional holds or the case of a union the conversions recorded at the node give. It tests
  ;   the length of the subject, which the getter recorded at the node reads, or a constant
  ;   fact names as the field of an array, or a constant of 2 says is the rows of a table or a
  ;   span of one, read as TypeScript reads `t.length`. The read of each item is the first
  ;   call recorded at the item's pattern, or of a table the row at the index as `t[i]` reads
  ;   it. A rest with a name has the construction of its range recorded and then the read by
  ;   that range.
  ; - `plan-map-pattern`: the node is a pattern of a map, with the subject found as for a list.
  ;   The read of each key is the first call recorded at its item, with the key converted as
  ;   recorded at the key. A rest with a name has three calls recorded: the construction of an
  ;   empty map of the subject's type, the store of a key into it, made once for each key
  ;   matched, and the difference of the subject and that map.
  ; - `plan-text-pattern`: the node is a pattern of texts and a rest joined by `and`, matched
  ;   against a `String` as TypeScript lowers it: the length is read by the getter recorded at
  ;   the node and tested, then `starts-with` the texts before the rest and `ends-with` those
  ;   after, each a call recorded at the node in that order where there are such texts. A name
  ;   given a text is bound to that text. A rest with a name has the construction of its range
  ;   recorded at the rest and then the read by that range, from the length read again.
  ; - `plan-interface-equal`: the node compares two values of interfaces, for equal or for not
  ;   equal. Where the types behind them differ, the getter recorded at the node says whether a
  ;   tracker is comparing for a change: the answer is then that they differ, and otherwise it
  ;   panics. Where they agree, the function the left value's table holds for equality answers.
  ; - `plan-interface-unlike`: the node compares a value of an interface with one of a type that
  ;   is no interface: both are evaluated, and it panics, naming the right operand's type.
  ; - `plan-stream-value`: the node is a part of a grammar whose value is what a rule it
  ;   calls gives, not the text it matched: a call of a rule, an optional one, a name captured
  ;   over one, or a sequence that ends in one and gives no text. An arm with no expression
  ;   gives that value, an expression of an arm whose pattern is planned so sees it as `it`,
  ;   and a name captured over the part holds it. In a stream of items that are not characters,
  ;   a test of one item gives the item, and a repeat of such tests the list of them.
  ; - `plan-pattern-call`: the node is `$name` in a grammar, whose name holds a pattern
  ;   given to a rule, a `PatternFunc` of the stream's items: it calls the function the name
  ;   holds as a rule is called, and gives what that gives, as a part planned
  ;   `plan-stream-value` does.
  ; - `plan-pattern-loop`: the node is the header of a loop written as a grammar, which
  ;   reads its container through the stream the calls recorded at the node make, as a match on
  ;   it does, and on each pass matches the pattern from where the last pass left the stream,
  ;   which need not read the rest. The loop ends where the pattern fails. Its slots keep the
  ;   container and the stream.
  ; - `plan-machine-path`: the node reads `path` of a value of a state machine's union, which is
  ;   no case's payload: the names of the machine's active cases, outermost first, made a list
  ;   with the constructor recorded at the node and given each name by its `append`, recorded
  ;   there as a method's call.
  ; - `plan-refined-case`: the node is a pattern that names a case a refinement of the machine of
  ;   a property of a class adds, which the union of the machine it refines does not have: it is
  ;   tested by the object's flag of the case, and what the case holds is read from what the
  ;   object keeps for the refinement.
  ; - `plan-pattern-helper`: the node is the helper a stream match is given with `with`, which
  ;   makes values or rolls back for the pattern: it is evaluated after the subject, and the
  ;   values recorded in `materials` for the pattern are made by it.
  ; - `plan-span-call`: the node is a call of a rule in a grammar under a helper, whose
  ;   pattern gives the text it matched. The rule runs without the helper, and the call gives no
  ;   value of its own: the part gives the text the call matched, as a part matching items does.
  ; - `plan-object-uid`: the node reads `uid` of an object, the number its header holds.
  ; - `plan-property-subscribers`: the node reads `property-subscribers` of an object, the list of
  ;   the subscribers of its properties, which is made where the object has none yet.
  ; - `plan-stream-slice`: the node is a name a grammar captures over items that are not
  ;   characters, which an action reads as the reference reads it: an `Array` over the part of
  ;   the stream's buffer the name matched, sharing its items.
  ; - `plan-outlined-panic`: the node is an action of a grammar that the reference runs
  ;   in a function of its own, which a panic in it would show, and its code or a call in it
  ;   may panic. It runs in that function, given what the arm binds that it reads.
  ; A pattern that names a case has `plan-case` with the number of the case of the union it is
  ; given, or of the union an optional it is given holds. An equality pattern has the plan of
  ; `==` between its subject and its value: its node stands for the subject as the left operand.
  ; An assigning operator has the plan of the operator it applies. Its left operand is the value
  ; of the place it assigns, and the conversion recorded at the node with `reason-assignment`
  ; gives the result the type of that place.
  ; An assigning operator that a function of its own name answers has the call recorded at the
  ; place it assigns, with the form of an operator's. Where the place holds an object or a
  ; number it has no plan, and nothing is stored. Where the place holds a struct or a tuple, a
  ; value and no reference, it has `plan-store-answer`: what the function answers is stored at
  ; the place, with the conversion recorded at the node with `reason-assignment`, and is the
  ; value of the assignment.
  ; An index assigned through the function that answers `[]=` has `plan-store-answer` at the
  ; index where the object is a struct or a number and the function answers one of its type:
  ; the answer is stored where the object was read from, and is the value of the assignment.
  ; `-=` of an item has `plan-store-answer` at the index where the function that answers `-=[]`
  ; answers a value of the object's type that is a tuple or a struct, as TypeScript stores it:
  ; the answer is stored where the object was read from.
  ; An assigning operator on an item that holds no struct or tuple, which a function of its own
  ; name answers, has `plan-answer-item` at the index: the item is read by the call of `[]`
  ; recorded there, and the operator's call after it is made on the item. Nothing is stored.
  ; A call fact of an operator says by `is-swapped` that its receiver is the right operand.
  (blank)
