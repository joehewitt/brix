        close()
        =
else if lines.length != 0
    decline(lines[0])
    finish-errors(frame)
    close()
    =
if above
    . call = calls.filler-call(base, site, slots, builders, content-context())
    if call == no-fact
        decline(site)
    else
        facts.note-filler(instance, call)
        conversions.convert(site, site, receiver, base, .reason-receiver)
. defaulted = names.find(program.store-atom("")) != null
. beside = tree.root-machines(frame.declaration.syntax, false).length + machines-after
    .. machines-after = tree.root-machines(frame.declaration.syntax, true).length
if beside != 0 && (defaulted || (body == 0 && given))
    decline(site)
if body != 0 || (beside != 0 && !defaulted && !given)
    if dropped != 0
        decline(dropped)
    else if defaulted
        do match? tree.nodes[body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    if !ruled || !tree.rule-part(statement)
                        facts.note-content-link
                            - ContentLink(instance, statement, receiver, no-type, no-fact)
    else if given || !is-plain-body(body, rooted, ruled)
        decline(body)
    else
        . bodied = body != 0 && (rooted || lines.length != 0)
        content-blocks += body
        content-parents += receiver
        content-names += true
        if bodied
            element-bodies += body
        rule-lines = if ruled then body else 0
        for machine in tree.root-machines(frame.declaration.syntax, false)
            check-statement(machine)
        if body != 0
            check-statement(body)
        for machine in tree.root-machines(frame.declaration.syntax, true)
            check-statement(machine)
        rule-lines = 0
        content-blocks.pop()
        content-parents.pop()
        content-names.pop()
        if bodied
            element-bodies.pop()
hand-off-outgoing(site)
finish-errors(frame)
close()

────────────────────
_ do clashes-element Bool
    - receiver TypeId
    - content SyntaxId

if content == 0 || no-receiver || types.intrinsic-of(receiver) != .class
    = false
.. no-receiver = receiver == no-type || receiver == invalid-type
. root = tree.root-this(content)
for node in tree.subtree-start(content) .. < content
    do match? tree.nodes[node]
        | .node-markup(row)
            if named-element && clashes-property(receiver, node, row.id, row.type-id)
                = true
            .. named-element = row.id != 0 && node != root && !enclosed-element(node, content)
= false

────────────────────
_ do clashes-property Bool
    - receiver TypeId
    - element SyntaxId
    - name SyntaxId
    - written SyntaxId

. text = identifier-name(tree, name)
. place = types.property-named(receiver, text) if text
if !place || names-element(types, types.properties[place])
    = false
. property = types.properties[place]
. held = property.type
if held == no-type
    held = demand-member(property, receiver, text!)
types.clear-fault()
. made = types.evaluate-type(module, tree, written, frame.env)
types.clear-fault()
if held == no-type || held == invalid-type || made == invalid-type || generic
    = false
.. generic = types.completions[made].has-variables
if holds-object(made, held)
    = false
. message = "Named markup element \"${text!.text}\" clashes with property \"${text!.text}\", which holds ${type-source(types, held)}, not ${type-source(types, made)}; rename the element"
frame.diagnose(element, .stated, program.store-atom(message))
= true

────────────────────
_ holds-object Bool
    - made TypeId
    - held TypeId

|? kind == .relation-side-cast && types.is-optional(held)
    holds-object(made, types.optional-inner(held))
??
    direct || interface-cast || kind == .relation-or-cast || kind == .relation-wrap-cast

.. kind = relations.compare(made, held).kind
.. direct = kind == .relation-same || kind == .relation-equal || kind == .relation-up-cast
.. interface-cast = kind == .relation-interface-cast

────────────────────
_ do hand-off-outgoing
    - site SyntaxId

` Gives what leaves the function being checked to the global `unhandled-error` (see
` `hands-off`), as the reference's function that fills an object with the markup of its class
` does, and its function a live action runs a statement again with: the function raises nothing,
` and each call that lets errors out lets them out to where they are given, a call whose
` callee's errors are not yet known too.
if scratch.outgoing.since(frame.outgoing-start).length == 0
    =
if !hands-off(instance)
    decline(site)
for row in scratch.outgoing.since(frame.outgoing-start)
    if row.call != U32.max
        facts.calls[row.call].propagates = true
scratch.outgoing.rewind(frame.outgoing-start)

────────────────────
_ do only-machines Bool
    - body SyntaxId

` Whether each line of the markup of the class whose object the function being checked fills
` is a state machine the object keeps, and there is one.
. content = frame.declaration.syntax
. machines = tree.content-machines(content)
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if tree.runs-line(content, statement) && machines.find(statement) == null
                = false
        = machines.length != 0
= false

────────────────────
_ kept-machine Bool
    - line SyntaxId

` Whether a line is a state machine written in the markup of the class whose object the
` function being checked fills, which the object keeps.
frame.declaration.is-content && tree.content-machines(frame.declaration.syntax).find(line) != null

────────────────────
_ do assigning-line SyntaxId
    - body SyntaxId

` The first line of a block that assigns, or none.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if tree.nodes[statement] is .node-assign
                = statement
= 0

────────────────────
_ do demand-filler
    - receiver TypeId
    - site SyntaxId

` A constructor of a class that writes markup, or is below one that does, runs the function
` that fills the object once its own body has: the call is kept for the constructor. The
` function is given the builder of each slot the constructor is given one for, which it passes
` on, but the function that gives an element's name its object, which the constructor runs
` itself, and for the styles and style sheets the constructor is made for.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
if !writes-content(receiver)
    =
. slots [Atom]
. builders [TypeId]
. given = instances.rows[instance].slots.count
. first = instances.signatures[instance].args.count - given
. passed = if instances.takes-binder(instance) then given - 1 else given
for offset in 0 .. < passed
    slots += instances.slot-name(instance, offset)
    builders += instances.argument-type(instance, first + offset)
. call = calls.filler-call(receiver, site, slots, builders, instances.rows[instance].context)
if call == no-fact
    decline(site)
    =
facts.note-filler(instance, call)
defer-values(receiver)

────────────────────
_ do demand-rules
    - receiver TypeId
    - site SyntaxId
    - body SyntaxId = 0

` Types the rules of a class being made and of the classes above it, each for the class that
` writes it as the receiver holds it: the constructor runs them once its body has run, or
` the function that fills the object with the markup of the class that writes one runs it once
` that markup has (`waits-for-markup`), so what they run may panic, and the errors a section
` lets out as it subscribes leave the constructor at `site`. A `when` or `whenever` rule the
` constructor runs gives the object a live action (`own-markup-actions`), and one on the markup
` the object is in registers the object as its markup host (`host-self`). The errors such a
` rule lets out the first time it runs leave the constructor at `site`, and those it lets out
` when its action runs it again are handed off (`hands-off`), as the reference does; one that
` runs on the markup, or once the markup of its class has, that lets out errors has no shape
` here. A dependency the
` class that writes it subscribes otherwise than the object's class would, as one is a markup
` host and the other is not, has no shape here, nor have rules where the
` constructor's body returns before its end, unless each is a section the event runtime runs
` from the table of the class, which no object subscribes. Which sections those are is
` planned first, since it decides how they are typed. One function fills the objects of
` every class below the one that writes the markup, while the reference makes one for each
` class it constructs: a section run there that some such class runs from its table and
` another subscribes has no shape here, and nor has one that lets out errors.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
plan-event-handlers(receiver, site)
. level TypeId? = receiver
. found = false
. ran = false
while level
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                . written SyntaxId = 0
                do match? owner.decls[member]
                    | .decl-rule(rule)
                        written = rule.syntax
                if written == 0
                    continue
                found = true
                . section = section-loop(ref.module, written)
                . tabled = facts.lowers(receiver, ref.module, section)
                . waits = waits-for-markup(level, ref.module, written)
                if waits && tabled && facts.holds-section(subscriptions, level, ref.module, section)
                    decline(site)
                    =
                .. subscriptions = facts.subscribed-sections
                if dependency-line && is-markup-host(receiver) != is-markup-host(level)
                    decline(site)
                    =
                .. dependency-line = owner.tree.nodes[written] is .node-dependency-declaration
                if !waits && is-live-rule(owner.tree, written)
                    live-owned = true
                if is-markup-trigger(owner.tree, written) && !host-self(receiver, site)
                    decline(site)
                    =
                if !ran && !tabled
                    ran = true
                    if body != 0 && leaves-early(body)
                        decline(body)
                        =
                . unit = instances.intern-initializer(ref.module, member, level)
                demand-body(unit)
                if waits && !facts.waits-for-markup(unit)
                    facts.markup-rules += unit
                if waits && section != 0 && !tabled
                    demand-errors(unit)
                    if instances.signatures[unit].errors.count != 0
                        decline(site)
                        =
                if section != 0
                    note-unit-errors(unit, site)
                else if is-live-rule(owner.tree, written)
                    demand-errors(unit)
                    if instances.signatures[unit].errors.count != 0
                        if waits || is-markup-trigger(owner.tree, written) || !hands-off(unit)
                            decline(site)
                            =
                        note-unit-errors(unit, site)
    level = types.base-of(level)
if found
    instances.mark-may-panic(instance)

────────────────────
_ do waits-for-markup Bool
    - level TypeId
    - module ModuleId
    - syntax SyntaxId

` Whether a rule a class writes runs once the markup of the class has, as the reference runs
` it, rather than once a constructor's body has: where the class, or one above it, writes
` markup, each section that subscribes to a stream does, and so does a `when` or `whenever`
` rule whose test reads a member of a name the markup gives an element, apart from the
` functions written there.
if !writes-content(level)
    = false
. tree = program.modules[module].tree
. test SyntaxId = 0
do match? tree.nodes[syntax]
    | .node-subscriber-syntax
        = true
    | .node-when-rule-syntax(rule)
        test = rule.expr
    | .node-whenever-rule-syntax(rule)
        test = rule.expr
if test == 0
    = false
. floor = tree.subtree-start(test)
. node = test + 1
while node > floor
    node -= 1
    do match? tree.nodes[node]
        | .node-function-syntax
            node = tree.subtree-start(node)
        | .node-get-expression(get)
            do match? tree.nodes[get.object]
                | .node-identifier(read)
                    . place = types.property-named(level, read.name)
                    if place && names-element(types, types.properties[place])
                        = true
= false

────────────────────
_ do is-live-rule Bool
    - tree AST
    - syntax SyntaxId

` Whether a rule a class writes runs as a live action of the object: a `when` or `whenever`
` rule.
do match? tree.nodes[syntax]
    | .node-when-rule-syntax
        = true
    | .node-whenever-rule-syntax
        = true
= false

────────────────────
_ do is-markup-trigger Bool
    - tree AST
    - syntax SyntaxId

` Whether a rule a class writes is a `whenever` rule on the markup an object is in.
do match? tree.nodes[syntax]
    | .node-whenever-rule-syntax(rule)
        = rule.kind.text != "value"
= false

────────────────────
_ do own-markup-actions
    - receiver TypeId
    - site SyntaxId

` How the function being typed makes the live actions the object it makes or fills owns, where
` its class is a markup host or batch, as the reference's `createMarkupAction` makes them with
` the object as owner: for a markup host, the markup runtime's `make-owner-markup-action`,
` given the object as its host, else `make-markup-action`, given it as the batch, each
` converted at `site`. It is noted only where a value or rule it runs is live
` (`live-owned`), and otherwise noted with none, so that a plain action is made for no such
` object. Either may raise.
if receiver == no-type || receiver == invalid-type || owns-plain-actions(receiver)
    =
if !live-owned
    facts.self-actions += SelfAction(instance, site, no-instance, false)
    =
. host = derived-interface(receiver, types.markup-host-decl)
. rooted = host == no-type
. wanted = if rooted then batch-type() else host
demand-live-runtime()
. live = instances.live
. mark = scratch.types.mark
scratch.types.push
    - if live.trackers != no-instance then instances.signatures[live.trackers].returns else no-type
scratch.types.push(live.callback)
scratch.types.push(wanted)
. action = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom(if rooted then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
if action == no-instance || live.has-actions == no-instance || wrong-return
    decline(site)
    =
.. wrong-return = instances.signatures[action].returns != types.live-action-type
if !raises-out(site, action)
    decline(site)
    =
if rooted
    conversions.convert(site, site, receiver, wanted, .reason-markup-batch)
else
    do host-self(receiver, site)
facts.self-actions += SelfAction(instance, site, action, rooted)

────────────────────
_ do waits-in-rule Bool

` Whether the instance types a rule of a class that runs once the markup of the class has.
. unit = instances.rows[instance]
if unit.initializer == 0 || frame.self-type == no-type
    = false
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-rule(row)
        = waits-for-markup(frame.self-type, unit.module, row.syntax)
= false

────────────────────
_ do runs-later Bool
    - id SyntaxId

` Whether a node is written in the body of a `whenever` rule of a class on a value, which the
` reference runs only where the value changes, never in the run the constructor makes, which
` takes the value alone: a member read there is read as it is, as the reference reads it.
. unit = instances.rows[instance]
if unit.initializer == 0
    = false
. tree = program.modules[unit.module].tree
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-rule(row)
        do match? tree.nodes[row.syntax]
            | .node-whenever-rule-syntax(rule)
                if rule.kind.text != "value" || rule.body == 0
                    = false
                = tree.subtree-start(rule.body) <= id && id <= rule.body
= false

────────────────────
_ do keeps-whole Bool
    - name Atom

` Whether a name is the whole value a `whenever` rule of a class keeps. The reference runs such
` a rule from the constructor, before the markup has, where an element not yet made reads as no
` object, and runs its body only once the element is written, so the rule may read that one.
. unit = instances.rows[instance]
if unit.initializer == 0
    = false
. tree = program.modules[unit.module].tree
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-rule(row)
        do match? tree.nodes[row.syntax]
            | .node-whenever-rule-syntax(rule)
                do match? tree.nodes[rule.expr]
                    | .node-identifier(read)
                        = read.name == name
= false

────────────────────
_ do plan-event-handlers
    - receiver TypeId
    - site SyntaxId

` The sections of a class being made, and of the classes above it, base first, that the
` reference runs from a table of the class rather than subscribing them for each object, as it
` plans them once for the class. Each section on an event of the object itself, its name alone
` or read from `this` in a loop of one header, counts among those of the event in order. One
` is run from the table where no section before it on the event was subscribed, the event is
` not published by key, no constructor of the class or of one above it subscribes to the event,
` its loop has no clause but one `when arrival` or `when bubbling`, and its body neither leaves
` it, writes a function, nor names an argument of a constructor of the class that writes it. The
` event runtime's `event-register-lowered` puts it in the table, or its
` `event-register-lowered-arrival` where it hears only what arrives at its object. A section run from the table for every class
` planned when it is typed is typed so alone; a class planned after that which subscribes it
` has no shape here. A class whose chain writes no section has nothing to plan. A class planned
` already is found by its type. An edit typed again in place keeps the plans, as long as it does
` not change what the constructors it edits subscribe to (`retype-edit`).
for planned in facts.lowered-types
    if planned == receiver
        =
. chain [TypeId]
. level TypeId? = receiver
while level
    chain += level
    level = types.base-of(level)
if !writes-sections(chain)
    =
facts.lowered-types += receiver
. heard = constructor-events(receiver, chain)
. owners [TypeId]
. names [Atom]
. counts [U32]
. closed [Bool]
for offset in 0 .. < chain.length
    . holder = chain[chain.length - 1 - offset]
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                . syntax SyntaxId = 0
                do match? owner.decls[member]
                    | .decl-rule(rule)
                        syntax = rule.syntax
                . found = section-event(receiver, ref.module, syntax) if syntax != 0
                if !found
                    continue
                . event = found
                . index = owners.length
                for position in 0 .. < owners.length
                    if owners[position] == event.owner && names[position] == event.name
                        index = position
                if index == owners.length
                    owners += event.owner
                    names += event.name
                    counts += 0
                    closed += false
                . order = counts[index]
                counts[index] = order + 1
                . subscribed = false
                for other in heard
                    if other.owner == event.owner && other.name == event.name
                        subscribed = true
                . iterator = section-loop(ref.module, syntax)
                . arrives = section-delivery(ref.module, syntax) == 1
                if open-event && lowerable-section && facts.event-register == no-instance
                    demand-event-register()
                .. open-event = event.key == no-type && !closed[index] && !subscribed
                .. lowerable-section = lowerable(ref.module, ref.decl, syntax)
                . registers = if arrives then facts.event-register-arrival else facts.event-register
                if closed-event || not-lowered || registers == no-instance
                    closed[index] = true
                    if facts.holds-section(facts.lowered-sections, holder, ref.module, iterator)
                        decline(site)
                    if !facts.holds-section(facts.subscribed-sections, holder, ref.module, iterator)
                        facts.subscribed-sections += SectionRef(holder, ref.module, iterator)
                    continue
                .. closed-event = event.key != no-type || closed[index] || subscribed
                .. not-lowered = !lowerable(ref.module, ref.decl, syntax)
                facts.lowered-handlers += LoweredHandler
                    - receiver
                    - holder
                    - ref.module
                    - member
                    - iterator
                    - event.owner
                    - event.name
                    - order
                    - arrives

────────────────────
_ do writes-sections Bool
    - chain [TypeId]

` Whether a class of a chain writes a section.
for holder in chain
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-rule(rule)
                        if section-loop(ref.module, rule.syntax) != 0
                            = true
= false

────────────────────
_ do constructor-events [NamedEvent]
    - receiver TypeId
    - chain [TypeId]

` Each event of the object itself that a loop in the body of a constructor of a class of the
` chain subscribes to, outside the functions written there.
. heard [NamedEvent]
for holder in chain
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    . tree = owner.tree
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-function(fn)
                        if fn.kind != .constructor-decl || fn.is-generated || fn.body == 0
                            continue
                        . floor = tree.subtree-start(fn.body)
                        . node = fn.body + 1
                        while node > floor
                            node -= 1
                            do match? tree.nodes[node]
                                | .node-function-syntax
                                    node = tree.subtree-start(node)
                                | .node-for-block(block)
                                    do match? tree.nodes[block.loop]
                                        | .node-loop-syntax(loop)
                                            if loop.is-subscriber
                                                . found = own-event
                                                    - receiver
                                                    - ref.module
                                                    - loop.container
                                                if found
                                                    heard += found
= heard

────────────────────
_ do section-loop SyntaxId
    - module ModuleId
    - syntax SyntaxId

` The loop a section of a class writes, or none.
. tree = program.modules[module].tree
do match? tree.nodes[syntax]
    | .node-subscriber-syntax(section)
        = section.iterator
= 0

────────────────────
_ do section-delivery U32
    - module ModuleId
    - syntax SyntaxId

` Which publications the loop a section of a class writes hears where its only clause says so:
` 1 for `when arrival`, 2 for `when bubbling`, and else 0.
. tree = program.modules[module].tree
do match? tree.nodes[section-loop(module, syntax)]
    | .node-for-block(block)
        do match? tree.nodes[block.loop]
            | .node-loop-syntax(loop)
                = clause-delivery(tree, loop.clause)
= 0

────────────────────
_ do clause-delivery U32
    - tree AST
    - clause SyntaxId

` Which publications a loop on an event hears where its only clause says so: 1 for
` `when arrival`, 2 for `when bubbling`, and else 0.
do match? tree.nodes[clause]
    | .node-clause(row)
        if row.op is .when-clause && row.next == 0
            do match? tree.nodes[row.expr]
                | .node-identifier(name)
                    if name.name.text == "arrival"
                        = 1
                    if name.name.text == "bubbling"
                        = 2
= 0

────────────────────
_ do section-event NamedEvent?
    - receiver TypeId
    - module ModuleId
    - syntax SyntaxId

` The event of the object itself a section of a class subscribes to in a loop of one header,
` or none.
. tree = program.modules[module].tree
. iterator = section-loop(module, syntax)
if iterator == 0
    = null
do match? tree.nodes[iterator]
    | .node-for-block(block)
        if block.next != 0
            = null
        do match? tree.nodes[block.loop]
            | .node-loop-syntax(loop)
                if loop.is-subscriber && loop.next == 0 && loop.container != 0
                    = own-event(receiver, module, loop.container)
= null

────────────────────
_ do own-event NamedEvent?
    - receiver TypeId
    - module ModuleId
    - container SyntaxId

` The event of the object itself a container names: its name alone, read from `this`, or read
` from the class that declares an event that bubbles.
. tree = program.modules[module].tree
do match? tree.nodes[container]
    | .node-identifier(row)
        = event-of(receiver, row.name, true)
    | .node-get-expression(get)
        do match? tree.nodes[get.object]
            | .node-identifier(row)
                if row.name.text == "this"
                    = event-of(receiver, get.name, true)
            | .node-type-identifier
                = bubbling-event-of(receiver, module, tree, get.object, get.name)
            | .node-type-arguments
                = bubbling-event-of(receiver, module, tree, get.object, get.name)
= null

────────────────────
_ do bubbling-event-of NamedEvent?
    - receiver TypeId
    - module ModuleId
    - tree AST
    - written SyntaxId
    - name Atom

` The event a class written in a section of `receiver`'s class declares, where it bubbles: one
` that is not private and is published by no key.
. declarer = invalid-type
do match? types.rows[receiver]
    | .type-class(row)
        . env = types.class-env-for(row.module, row.decl, row.args, receiver)
        declarer = types.evaluate-type(module, tree, written, env)
        types.env-release(env)
if declarer == invalid-type || declarer == no-type
    = null
if types.intrinsic-of(declarer) != .class && types.intrinsic-of(declarer) != .interface
    = null
. found = event-of(declarer, name, true)
if !found || found.is-private || found.key != no-type
    = null
= found

────────────────────
_ do lowerable Bool
    - module ModuleId
    - writer DeclId
    - syntax SyntaxId

` Whether the loop of a section has no clause but one `when arrival` or `when bubbling`, and its
` body has no `break`, no return, no function written in it, and no name of an argument of a
` constructor of the class that writes it, nor of the stream a loop is given.
. owner = program.modules[module]
. tree = owner.tree
. iterator = section-loop(module, syntax)
. body SyntaxId = 0
do match? tree.nodes[iterator]
    | .node-for-block(block)
        body = block.body
        do match? tree.nodes[block.loop]
            | .node-loop-syntax(loop)
                if loop.clause != 0 && clause-delivery(tree, loop.clause) == 0
                    = false
if body == 0
    = false
. arguments [Atom]
do match? owner.decls[writer]
    | .decl-class(class)
        for member in owner.member-pool[class.members]
            do match? owner.decls[member]
                | .decl-function(fn)
                    if fn.kind == .constructor-decl && !fn.is-generated
                        for shape in owner.arg-pool[fn.args]
                            if shape.name
                                arguments += shape.name
for node in tree.subtree-start(body) .. body
    do match? tree.nodes[node]
        | .node-break
            = false
        | .node-return
            = false
        | .node-return-if-true
            = false
        | .node-function-syntax
            = false
        | .node-identifier(row)
            if row.name.text == "(stream)"
                = false
            for name in arguments
                if name == row.name
                    = false
= true

────────────────────
_ do demand-styles
    - receiver TypeId
    - site SyntaxId

` Registers the styles a class being made uses, and those the classes above it use, base
` first, as the reference does as it compiles a constructor: each style is numbered as it is
` first used, and its registration placed at the declaration of the constructor. No two styles
` a class sees may name one property. Then the classes' defaults are applied
` (`apply-style-defaults`). A using of a style sheet has no shape here, nor has one that is
` wrong in a class of another module, nor a property of an optional of a type that queries the
` markup the object is in.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
. chain [TypeId]
. level TypeId? = receiver
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
. visible [TypeId]
for position in 0 .. < chain.length
    . ref = class-ref(types, chain[chain.length - 1 - position])
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-property(property)
                        if property.type-syntax != 0 && queries-markup(ref, property.type-syntax) && query-type(ref, property.type-syntax) == no-type
                            decline(site)
                            =
                    | .decl-using(using)
                        if using-sheet(ref, using) != no-type
                            continue
                        . used = using-style(ref, using, site)
                        if used == no-type
                            =
                        . index = style-index(used, site, true)
                        if index == U32.max
                            =
                        if visible.find(used) == null
                            if !distinct-style(index, visible, ref.module, using.syntax, site)
                                =
                            visible += used
if program.module-by-name("core/style")
    apply-style-defaults(chain, site)

────────────────────
_ do apply-style-defaults
    - chain [TypeId]
    - site SyntaxId

` The defaults of the classes of an object being made, base first, as the reference applies
` them once a constructor's body and the rules of each class have run: the rule `• This` each
` class writes declares at the defaults layer, each class's at a site of its own, its orders
` from a band of its own (`style-defaults-band`), the states its `when`s name the class's
` (`gate-when`). A line whose value reads something tracked is declared again by the action
` the object's class makes, as at an element. A rule `• This` that applies rules after its name
` applies them as an element's would (`apply-rule`), at the defaults layer, under the style
` sheets of the markup that made the object, as the reference's constructor applies them. Then
` come the rules and style lines of the class's root `<This` (`apply-root-rules`), and the rules
` of the style sheets the chain uses that the class's name answers (`apply-themed-defaults`). Each
` application of the defaults is marked `made` by its class. A rule `• This` written in another
` module is applied in that module (`enter-module`). A rule `• This` that takes values is
` declined.
for position in 0 .. < chain.length
    . level = chain[chain.length - 1 - position]
    . order = (position as U32) * style-defaults-band
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        . applying = this-rule && applies-rules(owner.tree, rule.syntax)
                            .. this-rule = rule.name.text == "This"
                        if rule.name.text == "This" && !rule-takes-nothing(owner.tree, rule.syntax)
                            decline(site)
                            =
                        if rule.name.text == "This"
                            . unit = instances.intern-initializer(ref.module, member, level)
                            if instances.rows[unit].state == .instance-in-progress
                                decline(site)
                                =
                            demand-body(unit)
                            panics.note-inlined(instance, unit)
                            if !note-style-errors(unit, site)
                                =
                            if applying
                                . home = enter-module(ref.module)
                                . next = apply-defaults-rules
                                    - rule.syntax
                                    - level
                                    - chain[0]
                                    - unit
                                    - order
                                enter-module(home)
                                if next == U32.max
                                    =
                                if next != order
                                    facts.style-sites += StyleSite
                                        - instance
                                        - ref.module
                                        - rule.syntax
                                order = next
                                continue
                            . ungated [StyleWhen]
                            for branch in rule-whens(owner.tree, rule-body(owner.tree, rule.syntax))
                                if !gate-when(site, level, ref.module, branch, ungated)
                                    =
                            . count = facts.style-declaration-count(unit)
                            if count != 0 || facts.updates-properties(unit)
                                facts.style-applications += StyleApplication
                                    - instance
                                    - ref.module
                                    - rule.syntax
                                    - unit
                                    - 0
                                    - order
                                facts.style-applications[facts.style-applications.length - 1].made = level
                                revise-application((facts.style-applications.length - 1) as U32)
                                if !bind-defaults-slots(site, level, unit, last-application)
                                    =
                                .. last-application = (facts.style-applications.length - 1) as U32
                                if facts.authors-in(unit)
                                    facts.style-applications[facts.style-applications.length - 1].action = demand-style-gates(chain[0])
                                    revise-application((facts.style-applications.length - 1) as U32)
                                if !choose-updater(latest-application, site, level)
                                    =
                                .. latest-application = (facts.style-applications.length - 1) as U32
                                share-defaults(facts.style-applications.length - 1, [unit], count)
                            if count != 0
                                facts.style-sites += StyleSite(instance, ref.module, rule.syntax)
                                order += count
    order = apply-root-rules(level, ref, chain[0], order, site)
    if order == U32.max
        =
    if !apply-themed-defaults(level, chain[0], band-order, site)
        =
    .. band-order = (position as U32) * style-defaults-band + style-defaults-band / 2

────────────────────
_ do apply-themed-defaults Bool
    - level TypeId
    - made TypeId
    - order U32
    - site SyntaxId

` Applies the rules taking no values that the style sheets the chain of an object being made uses
` write by the name of its class `level`, among that class's defaults, as the reference's
` `styleThemeClass` finds them: those `sheet-rules` finds in the sheets of the chain and their
` variants, each as `apply-defaults-rules` applies a rule `• This`, in the module of the sheet
` that writes it, at a site of its own, from `order`, the upper half of the class's band, under
` the gates of the variants that write it (`gate-applications`). Where a class of the chain
` writes a rule of the name, an element applies that one instead, and none is applied here.
` Answers false where one is declined or reported.
. ref = class-ref(types, level)
. named = ""
. declared SyntaxId = 0
do match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        named = class.name.text
        declared = class.syntax
. name = program.store-atom(named)
. (owner, written, writes) = class-style-rule(made, name)
=? true if owner != no-type
. none [TypeId]
. sheets [TypeId]
. members [DeclRef]
. gates [U64]
. entered = enter-module(ref.module)
. (status, found, missed) = sheet-rules(made, name, none, declared, sheets, members, gates, U32.max, false, true)
enter-module(entered)
if status == 1
    decline(site)
=? false if status != 0
. next = order
for position in 0 .. < sheets.length
    . member = members[position]
    . syntax SyntaxId = 0
    do match? program.modules[member.module].decls[member.decl]
        | .decl-style-rule(rule)
            syntax = rule.syntax
    . home = enter-module(member.module)
    . unit = rule-unit(sheets[position], member, level, syntax)
    if unit == no-instance
        enter-module(home)
        decline(site)
        = false
    if !note-style-errors(unit, site)
        enter-module(home)
        = false
    . first = facts.style-applications.length
    . applied = apply-defaults-rules(syntax, level, made, unit, next)
    . gated = ordered && gate-applications(first as U32, sheets[position], gates[position], syntax)
        .. ordered = applied != U32.max
    if gated && applied != next
        facts.style-sites += StyleSite(instance, member.module, syntax)
    enter-module(home)
    =? false if !gated
    next = applied
= true

────────────────────
_ do bind-defaults-slots Bool
    - site SyntaxId
    - level TypeId
    - unit InstanceId
    - application U32

. sheeted = markup-sheets.length
. context = instances.rows[instance].context
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
. bound = bind-rule-slots(site, level, unit, application)
while markup-sheets.length > sheeted
    markup-sheets.pop()
    sheet-levels.pop()
= bound

────────────────────
_ do note-style-errors Bool
    - unit InstanceId
    - site SyntaxId

if facts.authors-in(unit)
    demand-errors(unit)
    if instances.signatures[unit].errors.count != 0 && !hands-off(unit)
        decline(site)
        = false
note-unit-errors(unit, site)
= true

────────────────────
_ do apply-defaults-rules U32
    - syntax SyntaxId
    - level TypeId
    - made TypeId
    - unit InstanceId
    - order U32

` Applies a rule `• This` that the class `level` of an object being made writes and applies
` rules, and the rules it applies, as an element's rules are applied (`apply-rule`) to an object
` of that class, as the reference resolves them, but at the defaults layer, seeing the style
` sheets of the markup that made the object, which the constructor is made for, before those of
` the class, and the rules written in its rules, as the root's are seen (`apply-root-rules`),
` generating no content. A declaration that reads something tracked is declared again
` by the action of the object's class. Answers the order the next takes, or `U32.max`.
. first = facts.style-applications.length
. context = instances.rows[instance].context
. sheeted = markup-sheets.length
. scoped = rule-scopes.length
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
    for position in held.scope-first .. < held.scope-first + held.scopes
        if instances.context-cells[position] == 0 && instances.context-valued[position] == U32.max
            rule-scopes += ScopeUse(instances.context-scopes[position])
. active [InstanceId]
. applied [InstanceId]
. ungated [StyleWhen]
. generates = preparing
preparing = preparing.content-off = true
preparing = preparing.values-once = true
preparing = preparing.site = 0
. framing = framed
. next = apply-rule(syntax, level, unit, order, 0, U32.max, 0, ungated, active, applied)
preparing = generates
while markup-sheets.length > sheeted
    markup-sheets.pop()
    sheet-levels.pop()
while rule-scopes.length > scoped
    rule-scopes.pop()
if next != U32.max
    for index in first .. < facts.style-applications.length
        facts.style-applications[index].layer = 0
        revise-application(index as U32)
        if facts.style-applications[index].outer == U32.max
            facts.style-applications[index].made = level
            revise-application(index as U32)
        if facts.style-applications[index].action != no-instance
            facts.style-applications[index].action = demand-style-gates(made)
            revise-application(index as U32)
    if framed == framing
        share-defaults(first, applied, next - order)
= next

────────────────────
_ do share-defaults
    - first Size
    - applied [InstanceId]
    - count U32

=? if count == 0 || first >= facts.style-applications.length || !shares-rule(applied, count)
. last = facts.style-applications.length
for index in first .. < last
    . application = facts.style-applications[index]
    =? if application.cell != U32.max || outer-held
    .. outer-held = application.outer-cells != U32.max || application.around-values != U32.max
    =? if written-values || application.prepared || application.updater != no-instance
    .. written-values = application.written != 0 || application.values != no-instance
for index in first .. < last
    . unit = facts.style-applications[index].unit
    demand-errors(unit)
    =? if instances.signatures[unit].errors.count != 0
facts.style-applications[first].shared = true
revise-application(first as U32)
facts.style-applications[first].span = count
revise-application(first as U32)

────────────────────
_ do apply-root-rules U32
    - level TypeId
    - ref DeclRef
    - made TypeId
    - order U32
    - site SyntaxId

` Applies the style rules the root `<This` of the markup the class `level` of an object being
` made writes after `•`, as the reference's constructor applies them once the class's rule
` `• This` has (`compileRootThisStyleDefaults`): each as an element's would to an object of that
` class (`apply-written-rules`), seeing none the others bring into view, at the defaults layer,
` at one site of the root's, from an order, under the style sheets of the markup that made the
` object and the rules written in its rules that no `when` or rule taking values holds. The
` rules written in the rules they apply come into view in the class's content (`root-scopes`),
` not here, so no state cell is kept for them, and a rule here that applies one under such a cell
` is declined. The values an application gives are typed by an instance of their own for the
` class, under the constructor's context (`check-root-values`), and those the rules it applies
` give the rules they apply are evaluated once, as the reference's constructor evaluates them
` (`values-once`). Then each line of the root that names no property of the class declares a
` style there, typed as an instance of its own (`check-root-style`). Content the rules' lines
` generate is declined (`content-refused`). A root written in another module is applied in that
` module (`enter-module`). A declaration that reads something tracked is declared again by the
` action of the object's class `made`. Answers the order the next takes, or `U32.max`.
. owner = program.modules[ref.module]
. content SyntaxId = 0
. members = RowRange'DeclId()
do match? owner.decls[ref.decl]
    | .decl-class(class)
        content = class.content
        members = class.members
if content == 0
    = order
. root = owner.tree.root-this(content)
. applications = RowRange'SyntaxId()
. lines [DeclId]
do match? owner.tree.nodes[root]
    | .node-markup(row)
        applications = row.style-rule-applications
        do match? owner.tree.nodes[row.body]
            | .node-block(block)
                for statement in owner.tree.children[block.body]
                    do match? owner.tree.nodes[statement]
                        | .node-assign(line)
                            . name = identifier-name(owner.tree, line.lhs)
                            if name && !types.property-named(level, name)
                                for member in owner.member-pool[members]
                                    do match? owner.decls[member]
                                        | .decl-property(property)
                                            if property.defaults-root && at-statement
                                                lines += member
                                            .. at-statement = property.syntax == statement
if applications.count == 0 && lines.length == 0
    = order
. home = enter-module(ref.module)
. next = apply-root-written(level, ref, made, order, site, root, applications, lines)
enter-module(home)
= next

────────────────────
_ do enter-module ModuleId
    - entered ModuleId

` Types what follows as written in a module, as the style rules a class of another module
` writes are applied to an object, the diagnostics there being that module's. Answers the
` module typed in before.
. home = module
module = entered
tree = program.modules[entered].tree
frame.module = entered
frame.tree = tree
= home

────────────────────
_ do apply-root-written U32
    - level TypeId
    - ref DeclRef
    - made TypeId
    - order U32
    - site SyntaxId
    - root SyntaxId
    - applications RowRange'SyntaxId
    - lines [DeclId]

` Applies the rules and style lines of the root `<This` of a class, in the module that writes
` it, as `apply-root-rules` says.
. first = facts.style-applications.length
. cells = facts.scope-cells.length as U32
. context = instances.rows[instance].context
. sheeted = markup-sheets.length
. scoped = rule-scopes.length
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
    for position in held.scope-first .. < held.scope-first + held.scopes
        if instances.context-cells[position] == 0 && instances.context-valued[position] == U32.max
            rule-scopes += ScopeUse(instances.context-scopes[position])
. seen [ScopeUse]
for use in element-scopes
    seen += use
. refused = preparing
preparing = preparing.content-refused = true
preparing = preparing.values-once = true
preparing = preparing.site = 0
. next = order
for position in 0 .. < applications.count
    element-scopes.clear()
    . application = tree.children[applications.start + position]
    . values = no-instance
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if applied.args.count != 0
                values = instances.intern-root-values(module, level, application, context)
                demand-body(values)
                panics.note-inlined(instance, values)
    next = apply-written-rules
        - root
        - level
        - RowRange'SyntaxId(applications.start + position, 1)
        - next
        - values
    if next == U32.max
        break
preparing = refused
element-scopes.clear()
for use in seen
    element-scopes += use
while markup-sheets.length > sheeted
    markup-sheets.pop()
    sheet-levels.pop()
while rule-scopes.length > scoped
    rule-scopes.pop()
if next == U32.max
    = U32.max
for index in first .. < facts.style-applications.length
    . cell = facts.style-applications[index].cell
    if cell >= cells && cell < U32.max - 1
        decline(site)
        = U32.max
. empty [ScopeUse]
do prune-cells(cells, empty)
for index in first .. < facts.style-applications.length
    facts.style-applications[index].layer = 0
    revise-application(index as U32)
    if facts.style-applications[index].outer == U32.max
        facts.style-applications[index].made = level
        revise-application(index as U32)
    if facts.style-applications[index].action != no-instance
        facts.style-applications[index].action = demand-style-gates(made)
        revise-application(index as U32)
for member in lines
    . unit = instances.intern-initializer(ref.module, member, level)
    if instances.rows[unit].state == .instance-in-progress
        decline(site)
        = U32.max
    demand-body(unit)
    panics.note-inlined(instance, unit)
    if !note-style-errors(unit, site)
        = U32.max
    . count = facts.style-declaration-count(unit)
    if count == 0
        decline(site)
        = U32.max
    facts.style-applications += StyleApplication(instance, ref.module, root, unit, 0, next)
    facts.style-applications[facts.style-applications.length - 1].made = level
    revise-application((facts.style-applications.length - 1) as U32)
    if facts.authors-in(unit)
        facts.style-applications[facts.style-applications.length - 1].action = demand-style-gates
            - made
        revise-application((facts.style-applications.length - 1) as U32)
    next += count
if next != order
    facts.style-sites += StyleSite(instance, ref.module, root)
= next

────────────────────
_ do check-root-style
    - receiver TypeId
    - row PropertyDecl

` Types a line of a root `<This` that names no property of its class as the declaration of a
` style property of the object, as the reference's constructor declares it among the class's
` defaults (`compileRootThisStyleDefaults`): as a line of the class's rule `• This` is
` (`declare-unit-style`), with `this` bound, at the root.
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, row.owner)))
. root = 0u32
do match? program.modules[module].decls[row.owner]
    | .decl-class(class)
        root = tree.root-this(class.content)
. styles = style-vocabulary(receiver, row.syntax)
if styles
    do declare-unit-style(row.syntax, root, receiver, styles, 0)
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do queries-markup Bool
    - ref DeclRef
    - written SyntaxId

` Whether the type a class writes for a property is a query of the markup an object is in,
` `Ancestor'T` or `Descendants'T` of the markup runtime, or the optional of one.
. owner = program.modules[ref.module]
. env = types.class-env(ref.module, ref.decl)
. type = types.evaluate-type(ref.module, owner.tree, written, env)
types.env-release(env)
. held = if types.is-optional(type) then types.optional-inner(type) else type
if held == invalid-type || types.intrinsic-of(held) != .class
    = false
. declared = class-ref(types, held)
. home = program.modules[declared.module]
if home.name != "core/markup"
    = false
do match? home.decls[declared.decl]
    | .decl-class(class)
        = class.name.text == "Ancestor" || class.name.text == "Descendants"
= false

────────────────────
_ do query-type TypeId
    - ref DeclRef
    - written SyntaxId
    - level TypeId = no-type

` The type a class writes for a property where it queries the markup an object is in,
` `Ancestor'T` or `Descendants'T` of the markup runtime with one argument, or no type: for the
` parameters a `level` of the class with type parameters gives it, where one is given.
do match? program.modules[ref.module].tree.nodes[written]
    | .node-type-arguments
    ??
        = no-type
. owner = program.modules[ref.module]
. env = types.class-env(ref.module, ref.decl)
if level != no-type
    do match? types.rows[level]
        | .type-class(row)
            if row.args.count != 0
                types.env-release(env)
                env = types.class-env-for(row.module, row.decl, row.args, level)
. type = types.evaluate-type(ref.module, owner.tree, written, env)
types.env-release(env)
do match? types.rows[type]
    | .type-class(row)
        if row.args.count == 1 && (ancestor-query || descendant-query)
            = type
        .. ancestor-query = types.ancestor-decl.refers-to(row.module, row.decl)
        .. descendant-query = types.descendants-decl.refers-to(row.module, row.decl)
= no-type

────────────────────
_ do is-query-property Bool
    - receiver TypeId
    - name Atom

` Whether a property of a class is declared as a query of the markup its object is in, which
` the markup runtime keeps and nothing assigns.
if types.intrinsic-of(receiver) != .class || types.property-named(receiver, name) == null
    = false
. ref = declaring-class(types, receiver, name)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(class)
        for member in owner.member-pool[class.members]
            do match? owner.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name && property.type-syntax != 0
                        = query-type(ref, property.type-syntax) != no-type
= false

────────────────────
_ do query-target TypeId
    - query TypeId

` The class a query of the markup an object is in looks for: its one argument.
do match? types.rows[query]
    | .type-class(row)
        = types.child-type(row.args, 0)
= no-type

────────────────────
_ do is-ancestor-query Bool
    - query TypeId

` Whether a query of the markup an object is in looks for an ancestor, `Ancestor'T`.
do match? types.rows[query]
    | .type-class(row)
        = types.ancestor-decl.refers-to(row.module, row.decl)
= false

────────────────────
_ do note-open-targets
    - ref DeclRef
    - members RowRange'DeclId

` Notes the classes a class with type parameters may look for among the descendants of its markup
` host once typing makes it for some (`note-class-targets`): the class of each `Descendants'T` it
` declares and of each `whenever children T` and `whenever descendants T` rule it writes, or any
` class, where `T` is not a class.
. owner = program.modules[ref.module]
. env = types.class-env(ref.module, ref.decl)
for member in owner.member-pool[members]
    . target = no-type
    do match? owner.decls[member]
        | .decl-property(property)
            . query = if typed then query-type(ref, property.type-syntax) else no-type
                .. typed = property.type-syntax != 0
            if query != no-type && !is-ancestor-query(query)
                target = query-target(query)
        | .decl-rule(rule)
            do match? owner.tree.nodes[rule.syntax]
                | .node-whenever-rule-syntax(written)
                    if written.kind.text == "children" || written.kind.text == "descendants"
                        target = types.evaluate-type
                            - ref.module
                            - owner.tree
                            - written.target-type
                            - env
    if target == no-type || target == invalid-type
        continue
    if types.intrinsic-of(target) == .class
        . key = class-ref(types, target).key
        if facts.open-targets.find(key) == null
            facts.open-targets += key
    else
        facts.opens-any-target = true
types.env-release(env)

────────────────────
_ do trigger-target TypeId
    - ref DeclRef
    - syntax SyntaxId

` The class a rule a class writes looks for among the children or descendants of the object's
` markup host, `whenever children T` or `whenever descendants T`, where it is a markup host,
` or no type.
. env = types.class-env(ref.module, ref.decl)
. type = rule-target(ref.module, syntax, env)
types.env-release(env)
= type

────────────────────
_ do rule-target TypeId
    - written ModuleId
    - syntax SyntaxId
    - env TypeEnv

` The class a `whenever children T` or `whenever descendants T` rule looks for, written in a
` module and evaluated with the type parameters an environment gives, where it is a markup
` host, or no type.
. owner = program.modules[written]
do match? owner.tree.nodes[syntax]
    | .node-whenever-rule-syntax(rule)
        if rule.kind.text != "children" && rule.kind.text != "descendants"
            = no-type
        . type = types.evaluate-type(written, owner.tree, rule.target-type, env)
        = if is-markup-host(type) then type else no-type
= no-type

────────────────────
_ do note-class-targets
    - receiver TypeId

` Numbers, after those of the program (`find-query-targets`), the classes each class of an
` object with type parameters looks for among the descendants of its markup host, for the
` parameters the object's class gives it, base first: those of the properties it declares as
` `Descendants'T`, then of its `whenever children T` and `whenever descendants T` rules, as the
` reference numbers them when it first makes the class for those parameters, before any of its
` objects is made.
find-query-targets()
. chain [TypeId]
. level TypeId? = receiver
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . current = chain[chain.length - 1 - position]
    do match? types.rows[current]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(class)
                    if class.type-args.count != 0
                        . ref = DeclRef(row.module, row.decl)
                        for member in owner.member-pool[class.members]
                            do match? owner.decls[member]
                                | .decl-property(property)
                                    . query = if property.type-syntax != 0 then query-type(ref, property.type-syntax, current) else no-type
                                    . target = if descends then query-target(query) else no-type
                                        .. descends = query != no-type && !is-ancestor-query(query)
                                    if target != no-type && facts.query-targets.find(target) == null
                                        facts.query-targets += target
                        . env = types.class-env-for(row.module, row.decl, row.args, current)
                        for member in owner.member-pool[class.members]
                            do match? owner.decls[member]
                                | .decl-rule(rule)
                                    . target = rule-target(row.module, rule.syntax, env)
                                    if target != no-type && facts.query-targets.find(target) == null
                                        facts.query-targets += target
                        types.env-release(env)

────────────────────
_ do register-queries
    - receiver TypeId
    - site SyntaxId

` The registrations a constructor makes once the rules of each class of its object have run,
` base first, as the reference makes them: each query of the markup the object is in that the
` class declares a property for (`markup-query`), given to the markup runtime's
` `register-markup-ancestor-query` or `register-markup-descendants-query` with the object as
` its host, then, where the class is a markup host that a descendant query may look for
` (`may-be-target`), the object as a target of each one whose target is the class or one above
` it (`register-markup-descendant-target`), which program tables find once typing has numbered
` them all. Each may panic.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
. markup = types.markup-host-decl
if markup.module == 0 && markup.decl == 0
    =
find-query-targets()
. chain [TypeId]
. level TypeId? = receiver
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . current = chain[chain.length - 1 - position]
    . ref = class-ref(types, current)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-property(property)
                        . query = if property.type-syntax != 0 then query-type(ref, property.type-syntax, current) else no-type
                        if query != no-type
                            . index = markup-query
                                - current
                                - query
                                - site
                                - ref.module
                                - property.syntax
                                - property.name
                            if index == U32.max || !register-query(receiver, current, index, site)
                                =
    if is-markup-host(current) && may-be-target(current)
        if !register-target(receiver, current, site)
            =

────────────────────
_ do may-be-target Bool
    - level TypeId

` Whether a descendant query may look for a class or one above it: one the program numbers
` before typing (`find-query-targets`), or one a class with type parameters may number as typing
` makes it for some (`note-open-targets`). Each class a class with type parameters may number is
` noted before typing, so this does not depend on the order instances are typed in.
=? true if facts.opens-any-target
. held TypeId? = level
while held && types.intrinsic-of(held) == .class
    =? true if facts.query-targets.find(held) != null
    =? true if facts.open-targets.find(class-ref(types, held).key) != null
    held = types.base-of(held)
= false

────────────────────
_ do markup-query U32
    - level TypeId
    - query TypeId
    - site SyntaxId
    - written-module ModuleId
    - written SyntaxId
    - name Atom?

` The row of `markup-queries` for a property a class declares as a query of the markup its
` object is in, recorded the first time a constructor registers it, and found by the class and
` the property after that, taking again where the property is written, which an edit typed again
` in place may move (`retype-edit`): the functions the reference makes for it read the object as
` one of the class, made its markup host as converted here, and call the markup runtime to find
` a parent host, or to add an object to a list kept in order or take one from it. The class and
` the class the query looks for must be markup hosts, which the reference reports, and the latter
` must declare no `==`, since a new answer is compared with the old as one object. Those have no
` shape here.
. place = types.property-named(level, name) if name
if !place
    decline(site)
    = U32.max
for offset in 0 .. < facts.markup-queries.length
    if same-level && facts.markup-queries[offset].place == place as U32
        facts.markup-queries[offset].module = written-module
        facts.markup-queries[offset].site = written
        = offset as U32
    .. same-level = facts.markup-queries[offset].level == level
. target = query-target(query)
. ancestor = is-ancestor-query(query)
if !is-markup-host(level) || !is-markup-host(target)
    decline(site)
    = U32.max
for token in ["==", "!="]
    if calls.has-operator(target, program.store-atom(token), target)
        decline(site)
        = U32.max
. host = derived-interface(level, types.markup-host-decl)
. held = types.properties[place].type
. module = types.markup-host-decl.module
. row = MarkupQuery
    - level
    - place as U32
    - written-module
    - written
    - target
    - 0
    - no-fact
    - no-instance
    - no-instance
    - no-instance
. mark = scratch.types.mark
if ancestor
    scratch.types.push(host)
    row.parent = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("markup-query-parent-host")
        - mark
    scratch.types.rewind(mark)
    if row.parent == no-instance || held != types.optional-of(target)
        decline(site)
        = U32.max
else
    . found = facts.query-targets.find(target)
    if !found
        decline(site)
        = U32.max
    row.target-id = (found + 1) as U32
    scratch.types.push(held)
    scratch.types.push(host)
    scratch.types.push(target)
    row.add = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("markup-query-add-descendant")
        - mark
    row.remove = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("markup-query-remove-descendant")
        - mark
    scratch.types.rewind(mark)
    if row.add == no-instance || row.remove == no-instance
        decline(site)
        = U32.max
. recorded = facts.conversions.length
conversions.convert(0, 0, level, host, .reason-markup-host)
if unrecorded || facts.conversions[recorded].from != level || facts.conversions[recorded].to != host
    decline(site)
    = U32.max
.. unrecorded = facts.conversions.length == recorded
row.hosted = recorded as FactId
facts.markup-queries += row
= (facts.markup-queries.length - 1) as U32

────────────────────
_ do register-query Bool
    - receiver TypeId
    - level TypeId
    - index U32
    - site SyntaxId

` Types the registration of a markup query by the constructor, as `register-queries` says, and
` says whether it has a shape here.
. row = facts.markup-queries[index]
. ancestor = row.target-id == 0
. callback = types.well-known-type
    - "core/markup"
    - if ancestor then "MarkupAncestorQueryRefresher" else "MarkupDescendantsQueryApplier"
if callback == invalid-type || !host-self(receiver, site)
    decline(site)
    = false
. mark = scratch.types.mark
scratch.types.push(derived-interface(receiver, types.markup-host-decl))
if !ancestor
    scratch.types.push(types.size-type)
    scratch.types.push(callback)
scratch.types.push(callback)
. register = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom
        - if ancestor then "register-markup-ancestor-query" else "register-markup-descendants-query"
    - mark
scratch.types.rewind(mark)
if register == no-instance || !raises-out(site, register)
    decline(site)
    = false
instances.mark-may-panic(instance)
facts.query-registrations += QueryRegistration(instance, site, level, index, register)
= true

────────────────────
_ do register-target Bool
    - receiver TypeId
    - level TypeId
    - site SyntaxId

` Types the registration by the constructor of the object as a target of the descendant queries
` that look for `level` or a class above it, as `register-queries` says, and says whether it has
` a shape here.
if !host-self(receiver, site)
    decline(site)
    = false
. mark = scratch.types.mark
scratch.types.push(derived-interface(receiver, types.markup-host-decl))
scratch.types.push(types.size-type)
. register = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("register-markup-descendant-target")
    - mark
scratch.types.rewind(mark)
if register == no-instance || !raises-out(site, register)
    decline(site)
    = false
instances.mark-may-panic(instance)
facts.query-registrations += QueryRegistration(instance, site, level, U32.max, register)
= true

────────────────────
_ do host-self Bool
    - receiver TypeId
    - site SyntaxId

` Converts the object a constructor or the function that fills it makes to its markup host at
` `site`, once, and says whether its class is one.
. host = if is-markup-host(receiver) then markup-host else no-type
    .. markup-host = derived-interface(receiver, types.markup-host-decl)
if host == no-type
    = false
if !converted-to-host
    converted-to-host = true
    conversions.convert(site, site, receiver, host, .reason-markup-host)
= true

────────────────────
_ do using-style TypeId
    - ref DeclRef
    - using UsingDecl
    - site SyntaxId

` The style a class, or an extension of a style sheet, names in a using, or none where the using
` is declined or reported. One of a style sheet is no style (`using-sheet`); `StyleSheet` itself
` is the reference's error.
. used = using-type(ref, using)
. root = types.intrinsic-of(used) == .style-sheet && used == types.type-row(.style-sheet)
if used == invalid-type || (types.intrinsic-of(used) == .style-sheet && !root)
    decline(if ref.module == module then using.syntax else site)
    = no-type
if types.intrinsic-of(used) != .style || used == types.type-row(.style)
    if ref.module != module
        decline(site)
    else
        frame.diagnose
            - using.syntax
            - .stated
            - program.store-atom("Using target must be a Style or StyleSheet")
    = no-type
= used

────────────────────
_ do using-sheet TypeId
    - ref DeclRef
    - using UsingDecl

` The style sheet a class names in a using, declared `• Name`, or none.
. used = using-type(ref, using)
types.clear-fault()
if used == invalid-type || types.intrinsic-of(used) != .style-sheet
    = no-type
. sheet = class-ref(types, used)
= if is-sheet-decl(sheet.module, sheet.decl) then family-root(used) else no-type

────────────────────
_ do using-type TypeId
    - ref DeclRef
    - using UsingDecl

` The type a using of a class or of an extension of a style sheet names, with the fault the
` type store gives where it names none. One it names is kept, and found again as it was.
. key = ((ref.module as Size) /lshift/ 32) /or/ (using.type-syntax as Size)
. known = session.scratch.using-types[key]
if known
    types.clear-fault()
    = known
. owner = program.modules[ref.module]
. env = holder-env(ref)
types.clear-fault()
. used = types.evaluate-type(ref.module, owner.tree, using.type-syntax, env)
types.env-release(env)
if used != invalid-type
    session.scratch.using-types[key] = used
= used

────────────────────
_ do add-sheet-groups
    - class TypeId
    - sheets [TypeId]
    - levels [U32]

` Adds the style sheets a class uses to those seen, each in its group, as the reference's
` `visibleStyleSheetUsingGroups` and `addStyleSheetVocabularyGroup` add them: the classes of its
` chain, base first, each a group of its own, higher than those before, each sheet only where it
` is first seen. The sheets of each class of the chain are found once (`chain-sheets`).
if class == no-type || class == invalid-type || types.intrinsic-of(class) != .class
    =
. place = chain-sheets(class) as Size
. position = U32.max
. group = 0u32
while facts.chain-sheets[place] != no-type
    . sheet = facts.chain-sheets[place]
    if facts.chain-sheet-positions[place] != position
        position = facts.chain-sheet-positions[place]
        group = if levels.length != 0 then levels[levels.length - 1] + 1 else 0
    if sheets.find(sheet) == null
        sheets += sheet
        levels += group
    place += 1

────────────────────
_ do chain-sheets U32
    - class TypeId

` Where the style sheets the classes of a chain use begin in `chain-sheets`, each with the place of
` its class in the chain, base first, in the order the classes name them, ended by none; found the
` first time they are asked for.
. held = facts.chain-sheet-places[class]
=? held if held
. start = facts.chain-sheets.length as U32
. chain [TypeId]
. level TypeId? = class
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . ref = class-ref(types, chain[chain.length - 1 - position])
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(declared)
            for member in owner.member-pool[declared.members]
                do match? owner.decls[member]
                    | .decl-using(using)
                        . sheet = using-sheet(ref, using)
                        if sheet != no-type
                            facts.chain-sheets += sheet
                            facts.chain-sheet-positions += position as U32
facts.chain-sheets += no-type
facts.chain-sheet-positions += U32.max
facts.chain-sheet-places[class] = start
= start

────────────────────
_ sheets-known Bool

` Whether the style sheets markup written here sees are known here: in the main code of a module,
` or a function or a property's getter or setter that is nested in none, as the reference starts
` such a function with none; in the function that makes a class's content, which is one of its
` own for those of the markup that makes the object (`load-context`); and in a function that
` builds markup the markup around it gives them to (`sheets-given`); and in a constructor, whose
` body the reference starts with none and whose defaults it applies under those of the markup
` that makes the object (`apply-style-defaults`). Another nested in one sees those of the markup
` around it.
|? frame.declaration.is-content || sheets-given
    true
??
    instances.rows[instance].enclosing == no-instance && (kind == .main-decl || kind == .function-decl || kind == .getter-decl || kind == .setter-decl || is-constructor-kind(kind))

.. kind = frame.declaration.kind

────────────────────
_ scopes-known Bool

` Whether the style rules written in rules that markup written here sees are known here
` (`rule-scopes`): where the style sheets it sees are (`sheets-known`), and in a function that
` builds markup the markup around it gives them to (`scopes-given`), as for one that builds what a
` line gives a slot, with those found on the way to its outlet (`outlet-scopes`), and one that
` builds content a style rule generates (`check-content`); not in another that builds what a line
` gives a slot.
|? frame.declaration.is-content || scopes-given
    true
|? kind == .slot-decl
    false
??
    instances.rows[instance].enclosing == no-instance && (kind == .main-decl || kind == .function-decl || kind == .getter-decl || kind == .setter-decl || is-constructor-kind(kind))

.. kind = frame.declaration.kind

────────────────────
_ do seen-sheets
    - sheets [TypeId]
    - levels [U32]

` The style sheets markup written here sees where no element is around it, in their groups,
` those of the class it is written in, or `sheet-self` while the way to a slot outlet is followed,
` where there are none.
for sheet in markup-sheets
    sheets += sheet
for level in sheet-levels
    levels += level
if sheets.length == 0
    add-sheet-groups(if keying.sheet-self != no-type then keying.sheet-self else frame.self-type, sheets, levels)

────────────────────
_ do element-context U32
    - class TypeId
    - id SyntaxId

` The styles and style sheets a markup element of a class sees, which the reference hands the
` constructor of a class whose markup is its content, to make it under them
` (`markupStyleContextFor`): the element's vocabulary (`style-vocabulary`), the sheets it sees
` (`visible-sheets`) and the rules written in rules it sees, with those its own rules bring into
` view (`push-scopes`), as a context among `instances.contexts`; the sheets alone for a class
` that writes none but whose defaults apply rules (`defaults-apply-rules`); none for any other
` class, or where there are none. Each rule written in a rule under the state cell of a `when`
` gives the constructor the cell (`CarriedCell`), in turn, and then the values of each rule
` around rules written in it that takes some, once each (`CarriedValues`). `U32.max - 1` where
` it is declined: where they are not known here, or a using is.
if types.intrinsic-of(class) != .class || !program.module-by-name("core/style")
    = U32.max
. content = writes-content(class)
if !content && !defaults-apply-rules(class)
    = U32.max
if !sheets-known()
    decline(id)
    = U32.max - 1
. styles [TypeId]
if content
    . seen = style-vocabulary(class, id)
    if !seen
        = U32.max - 1
    styles = seen
. sheets [TypeId]
. levels [U32]
if types.well-known-type("core/style", "StyleSheetInfo") != invalid-type
    visible-sheets(class, sheets, levels)
if !content && sheets.length == 0
    = U32.max
. scopes [RuleScope]
. cells [U32]
. carried [U32]
. valued [U32]
. value-types [TypeId]
. rows [U32]
if content
    if !scopes-known() && nested-any()
        decline(id)
        = U32.max - 1
    . seen = rule-scopes.length
    push-scopes(id)
    . next U32
    for use in rule-scopes
        scopes += use.scope
        . count = use-cells(use)
        cells += count
        if count != 0
            facts.link-cells(use.outer-cells, carried)
            carried += use.cell
            next += count
    . known = place-values(next, valued, value-types, rows)
    while rule-scopes.length > seen
        rule-scopes.pop()
    if !known
        decline(id)
        = U32.max - 1
. recorded = false
for held in facts.carried-cells
    recorded = recorded || (held.instance == instance && held.site == id)
for held in facts.carried-values
    recorded = recorded || (held.instance == instance && held.site == id)
if !recorded
    for cell in carried
        facts.carried-cells += CarriedCell(instance, id, cell)
    for row in rows
        facts.carried-values += CarriedValues(instance, id, row)
= instances.intern-context(styles, sheets, levels, scopes, cells, no-type, 0, valued, value-types)

────────────────────
_ do place-values Bool
    - first U32
    - valued [U32]
    - value-types [TypeId]
    - rows [U32]

` Places among the values a context gives, from the `first`th on, those of the rule around each
` rule written in a rule in view (`rule-scopes`) that takes some, once each: `valued` has where
` each rule's start, or `U32.max` for one around which none takes any, `value-types` their types
` and `rows` the values (`ScopeValues`) in turn. False where their types are not known here.
. next = first
. places [U32]
. known = true
for use in rule-scopes
    . place = U32.max
    if use.values == U32.max - 1
        known = false
    else if use.values != U32.max
        . found = rows.find(use.values)
        if found
            place = places[found]
        else
            . taken = frame-value-types(use.values)
            if !taken
                known = false
            else
                place = next
                rows += use.values
                places += next
                for type in taken
                    value-types += type
                next += taken.length as U32
    valued += place
= known

────────────────────
_ frame-value-types [TypeId]?
    - values U32

` The types of the values of the rule around rules written in it (`ScopeValues`), as the class or
` style sheet that writes it declares them (`frame-types`).
frame-types(facts.scope-values[values].frame)

────────────────────
_ do frame-types [TypeId]?
    - frame U32

` The types of the values of the rule of a frame, as the class or style sheet that writes it
` declares them; none where they are not known here.
. held = instances.frames[frame]
do match? program.modules[held.module].decls[held.decl]
    | .decl-style-rule(rule)
        = written-argument-types(held.module, rule.owner, held.decl)
= null

────────────────────
_ do given-values U32
    - scope RuleScope
    - place U32

` The values of the rule around a rule written in a rule that the markup that made the object
` gives the function that fills it, from its `place`th on among those its context gives, made
` once.
. frame = valued-frame(scope.frames)
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if held.instance == instance && held.argument == place && held.frame == frame
        = index as U32
facts.scope-values += ScopeValues(instance, 0, module, frame, place)
= (facts.scope-values.length - 1) as U32

────────────────────
_ do valued-frame U32
    - frames U32

` The frame of a rule that takes values among the rules applied around a rule written in a rule,
` or none.
. frame = frames
while frame != U32.max
    . held = instances.frames[frame]
    if held.gate == 0
        do match? program.modules[held.module].decls[held.decl]
            | .decl-style-rule(rule)
                if rule-takes(program.modules[held.module].tree, rule.syntax) != 0
                    = frame
    frame = held.outer
= U32.max

────────────────────
_ do defaults-apply-rules Bool
    - class TypeId

` Whether the rule `• This` of a class of a chain applies rules, as the reference's
` `styleDefaultsApplyRules` asks.
. level TypeId? = class
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(declared)
            for member in owner.member-pool[declared.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        if rule.name.text == "This" && applies-rules(owner.tree, rule.syntax)
                            = true
    level = types.base-of(level)
= false

────────────────────
_ do load-context Bool
    - receiver TypeId
    - site SyntaxId

` Takes, in the function that fills an object with its class's markup, the styles and style
` sheets of the markup that made the object, with those of the class after them, as the
` reference's `markupStyleContextWithClassUsings` makes the context its content is made under:
` the styles, the first to answer a name innermost, and the sheets in their groups; and the rules
` written in rules it sees, each under the state cells it is given with (`given-cell`), the
` outermost first, and those its own markup brings (`root-scopes`). A rule that reaches only the
` markup of the class of the element that brought it into view matches here where that element's
` object is the one filled (`scope-pending`), and not where it matched in the markup that made it
` (`scope-entered`), as the reference's `markupStyleContextEnteringContent` gives them. False where
` a using is declined.
. context = instances.rows[instance].context
. vocabulary [TypeId]
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first .. < held.first + held.styles
        vocabulary += instances.context-types[position]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
if program.module-by-name("core/style") && !add-visible-styles(receiver, vocabulary, site)
    = false
for position in 0 .. < vocabulary.length
    markup-styles += vocabulary[vocabulary.length - 1 - position]
if types.well-known-type("core/style", "StyleSheetInfo") != invalid-type
    add-sheet-groups(receiver, markup-sheets, sheet-levels)
. made = receiver
. known = false
if context != U32.max
    . held = instances.contexts[context]
    . argument U32
    for position in held.scope-first .. < held.scope-first + held.scopes
        . given = instances.context-scopes[position]
        . count = instances.context-cells[position]
        if given.own == .scope-entered
            argument += count
            continue
        . scope = entered-use(ScopeUse(given)).scope
        . place = instances.context-valued[position]
        . values = if place == U32.max then U32.max else given-values(scope, place)
        if count != 0
            . links = U32.max
            for depth in 0 .. < count - 1
                links = facts.scope-link
                    - given-cell(scope, argument + depth, count - 1 - depth)
                    - links
            rule-scopes += ScopeUse
                - scope
                - given-cell(scope, argument + count - 1, 0)
                - values
                - links
            argument += count
        else
            rule-scopes += ScopeUse(scope, U32.max, values)
    if held.made != no-type
        made = held.made
        known = true
incoming-scopes = rule-scopes.length as U32
= root-scopes(receiver, made, known, site)

────────────────────
_ do content-context U32

` The context the function that fills an object with its class's markup is made under, as
` `load-context` took it, which it hands the function of the class above: with the rules
` written in rules of the markup that made the object as it was given them, but not those its own
` markup brings into view, with the state cells it was given, which it gives on; and where a rule
` `• This` holds rules (`scoping-names`), the class of the object, which the class above brings
` those of its chain's rules `• This` into view for.
. styles [TypeId]
for position in 0 .. < markup-styles.length
    styles += markup-styles[markup-styles.length - 1 - position]
. scopes [RuleScope]
. cells [U32]
. valued [U32]
. context = instances.rows[instance].context
. value-types [TypeId]
if context != U32.max
    . held = instances.contexts[context]
    for position in held.scope-first .. < held.scope-first + held.scopes
        scopes += instances.context-scopes[position]
        cells += instances.context-cells[position]
        valued += instances.context-valued[position]
    for position in held.value-first .. < held.value-first + held.values
        value-types += instances.context-value-types[position]
. made = if context != U32.max then instances.contexts[context].made else no-type
if made == no-type && scoping-named(program.store-atom("This"))
    made = frame.self-type
= instances.intern-context
    - styles
    - markup-sheets
    - sheet-levels
    - scopes
    - cells
    - made
    - 0
    - valued
    - value-types

────────────────────
_ do root-scopes Bool
    - receiver TypeId
    - made TypeId
    - known Bool
    - site SyntaxId

` Brings into view, in the function that fills an object with its class's markup, after the
` rules written in rules of the markup that made the object, those the rules a root `<This`
` matches bring, each that is not in view already, under whatever state cell, as the reference's
` `classContentRootStyleRuleScopes` gathers them (`gather-scopes`), which binds the cells of only
` those it brings (`prune-cells`), made where the root is; then those of the rules `• This` of the
` chain of the object's class `made` (`default-scopes`), made where the class `receiver` is,
` `known` where the markup that made the object said which class it is. The states of the
` `when`s around them are then checked (`check-cells`). False where one is declined or reported.
. root = tree.root-this(frame.declaration.syntax)
do match? tree.nodes[root]
    | .node-markup(row)
        if may-scope(receiver, row)
            . names [Atom]
            for name in implicit-names(receiver, row.type-id, 0, tree)
                names += program.store-atom(name)
            . gathered [ScopeUse]
            . first = facts.scope-cells.length as U32
            . own-keying = keying
            keying = Keying(keying.discovering, keying.sheet-self, module, root)
            . gathering = gather-scopes
                - receiver
                - names
                - row.style-rule-applications
                - 0
                - made
                - gathered
                - tree
            keying = own-keying
            if !gathering
                decline(root)
                = false
            . added [ScopeUse]
            for gathered-use in gathered
                . use = entered-use(gathered-use)
                . shown = false
                for held in rule-scopes
                    shown = shown || instances.same-scope(held.scope, use.scope)
                for held in added
                    shown = shown || instances.same-scope(held.scope, use.scope)
                if !shown
                    added += use
            for use in prune-cells(first, added)
                rule-scopes += use
if scoping-any()
    . ref = class-ref(types, receiver)
    . own-keying = keying
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            keying = Keying(keying.discovering, keying.sheet-self, ref.module, class.syntax)
    default-scopes(made, 0, rule-scopes, true)
    keying = own-keying
= check-cells(0, site, made, known)

────────────────────
_ do base-scopes Bool
    - receiver TypeId
    - base TypeId
    - scopes [ScopeUse]
    - site SyntaxId

` Adds to `scopes` the rules written in rules that the functions building what the lines of a
` class's markup give the slots of the class above see after those of the markup that made the
` object, as the reference's `baseSlotOutletStyleContext` holds them: those the rules the root
` `<This` of the markup of the class above matches bring, seeing only those of the markup that
` made the object, each not in view already, under state cells made where that root is; then
` those of the rules `• This` of the chain of the class above, under state cells made where the
` class `receiver` is. False where one is declined or reported.
. ref = class-ref(types, base)
. written = program.modules[ref.module].tree
. root = written.root-this(class-content(base))
. context = instances.rows[instance].context
. made = receiver
. known = false
if context != U32.max && instances.contexts[context].made != no-type
    made = instances.contexts[context].made
    known = true
do match? written.nodes[root]
    | .node-markup(row)
        . names [Atom]
        for text in implicit-names(base, row.type-id, 0, written)
            names += program.store-atom(text)
        . later [ScopeUse]
        while rule-scopes.length > incoming-scopes
            later += rule-scopes.pop()
        . gathered [ScopeUse]
        . first = facts.scope-cells.length as U32
        . own-keying = keying
        keying = Keying(keying.discovering, keying.sheet-self, ref.module, root)
        . gathering = gather-scopes
            - base
            - names
            - row.style-rule-applications
            - 0
            - made
            - gathered
            - written
        keying = own-keying
        . added [ScopeUse]
        for gathered-use in gathered
            . use = entered-use(gathered-use)
            . shown = false
            for held in rule-scopes
                shown = shown || instances.same-scope(held.scope, use.scope)
            for held in added
                shown = shown || instances.same-scope(held.scope, use.scope)
            if !shown
                added += use
        while later.length != 0
            rule-scopes += later.pop()
        if !gathering
            decline(site)
            = false
        for use in prune-cells(first, added)
            scopes += use
. owner = class-ref(types, receiver)
. own-keying = keying
do match? program.modules[owner.module].decls[owner.decl]
    | .decl-class(class)
        keying = Keying(keying.discovering, keying.sheet-self, owner.module, class.syntax)
default-scopes(base, 0, scopes, true)
keying = own-keying
= check-cells(0, site, made, known)

────────────────────
_ do prune-cells [ScopeUse]
    - first U32
    - uses [ScopeUse]

` The rules written in rules given, with the state cells made from `first` on that none of them
` is under, innermost or further out, taken away again, and those kept renumbered.
. used [Bool]
for _ in first .. < (facts.scope-cells.length as U32)
    used += false
for use in uses
    . chain [U32]
    facts.link-cells(use.outer-cells, chain)
    if use.cell < U32.max - 1
        chain += use.cell
    for held in chain
        if held >= first
            used[held - first] = true
. moved [U32]
. next = first
for index in first .. < (facts.scope-cells.length as U32)
    if used[index - first]
        moved += next
        . holder = facts.scope-cells[index].instance
        if holder != instance && holder != no-instance
            facts.revised += 1
        facts.scope-cells[next] = facts.scope-cells[index]
        next += 1
    else
        moved += U32.max
while (facts.scope-cells.length as U32) > next
    facts.scope-cells.pop()
. kept [ScopeUse]
for use in uses
    . cell = if relocated then moved[use.cell - first] else use.cell
        .. relocated = use.cell >= first && use.cell < U32.max - 1
    . chain [U32]
    facts.link-cells(use.outer-cells, chain)
    . links = U32.max
    for held in chain
        links = facts.scope-link(if held >= first then moved[held - first] else held, links)
    kept += ScopeUse(use.scope, cell, use.values, links)
= kept

────────────────────
_ do sheet-has-slot Bool
    - sheet TypeId
    - name Atom

` Whether a style sheet declares a slot of a name.
. ref = class-ref(types, sheet)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name
                        = true
= false

────────────────────
_ do names-sheet-slot Bool
    - name Atom

` Whether any style sheet of the program declares a slot of a name, among the names gathered
` once (`list-sheet-slots`).
list-sheet-slots()
= facts.sheet-slot-names[name] != null

────────────────────
_ do list-sheet-slots

=? if facts.slot-names-listed
facts.slot-names-listed = true
for position in 0 .. < program.modules.length
    . owner = program.modules[position]
    for index in 0 .. < owner.decls.length
        do match? owner.decls[index]
            | .decl-property(property)
                if property.name && property.owner != 0 && in-sheet
                    facts.sheet-slot-names[property.name] = 1
                .. in-sheet = is-sheet-decl(position as ModuleId, property.owner)

────────────────────
_ do declare-sheet-slot U32
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - layer U32
    - order U32
    - value SyntaxId
    - made TypeId

` A style declaration whose value is a name alone that names a slot of a style sheet the element
` sees, as the reference's `compileStyleDeclaration` takes one: the runtime reads the slot's
` value as it settles. The sheets the element sees are in groups, lowest first: those the class
` the markup is written in uses, those of the elements it is in, outermost first, then those of
` the element's class (`add-sheet-groups`); the slot is that of the highest group that has one
` of the name, and two in one group are the reference's error. A name that is also a local, a
` global, or a member of the class the markup is written in or of an element it is in is the
` reference's error. Answers 0 where the value names no such slot, 1 where it is declared, and 2
` where it is reported or declined. Where the sheets the markup sees are not known here
` (`sheets-known`), a name that is a slot of any style sheet is declined, as is a slot of another
` type than the property's.
. name Atom? = null
do match? tree.nodes[value]
    | .node-identifier(row)
        if !row.is-tracked
            name = row.name
if !name || types.well-known-type("core/style", "StyleSheetInfo") == invalid-type
    = 0
if !sheets-known()
    if names-sheet-slot(name)
        decline(statement)
        = 2
    = 0
. (found, resolved) = resolve-slot(made, name, module, statement)
if !resolved
    = 2
if found == no-type
    = 0
. clashes = (resolution-flags /and/ ResolutionFlag.resolution-styled) == 0
    .. resolution-flags = bindings.resolution-of(frame.binding, value).flags
for parent in content-parents
    if types.property-named(parent, name) || declares-event(parent, name)
        clashes = true
if self-class && (self-property || declares-event(frame.self-type, name))
    clashes = true
.. self-property = types.property-named(frame.self-type, name)
.. self-class = frame.self-type != no-type && types.intrinsic-of(frame.self-type) == .class
if clashes
    . text = "\"${name.text}\" is ambiguous: it names both a StyleSheet slot of ${type-short-name(types, found)} and a lexical value"
    frame.diagnose(value, .stated, program.store-atom(text))
    = 2
= declare-slot(statement, element, index, position, layer, order, value, name, found)

────────────────────
_ do resolve-slot (TypeId, Bool)
    - made TypeId
    - name Atom
    - owner ModuleId
    - statement SyntaxId

` The style sheet whose slot of a name a markup element of a class sees, as the reference's
` `resolveStyleSheetSlot` resolves it: that of the highest group that has one, two in one group
` being its error at the line, written at `statement` in a module; or none. False where it is
` reported.
. sheets [TypeId]
. levels [U32]
visible-sheets(made, sheets, levels)
. found = no-type
. group = if levels.length != 0 then levels[levels.length - 1] + 1 else 0u32
while group > 0 && found == no-type
    group -= 1
    for place in 0 .. < sheets.length
        if levels[place] == group && sheet-has-slot(sheets[place], name)
            if found != no-type
                report-at(owner, statement, "StyleSheet slot \"${name.text}\" is ambiguous between visible style sheets ${type-short-name(types, found)} and ${type-short-name(types, sheets[place])}")
                = (no-type, false)
            found = sheets[place]
= (found, true)

────────────────────
_ do report-at
    - owner ModuleId
    - at SyntaxId
    - text String

` Reports the reference's error at a node of a module: of this one through its frame, of another
` as an error of a type's own declaration is.
if owner == module
    frame.diagnose(at, .stated, program.store-atom(text))
else
    facts.record-diagnostic
        - instance
        - owner
        - at
        - .stated
        - program.store-atom(text)
        - no-type
        - no-type

────────────────────
_ do bind-rule-slots Bool
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - application U32

` Resolves, where a style rule a class writes is applied to a markup element, each line whose
` value is a name alone that a style sheet may answer against the sheets the element sees, as
` the reference resolves it there (`resolve-slot`): a line whose name nothing else declares
` takes that slot's value (`rule-slots`), and one whose name is also a value the rule sees is
` the reference's error. Declined: such a name no sheet the element sees answers, and one
` where the sheets are not known here.
. owner = instances.rows[unit].module
. written = program.modules[owner].tree
. count = facts.style-declarations.length as U32
. place = facts.first-style-declaration(unit)
while place < count
    . row = facts.style-declarations[place]
    place = facts.next-style-declaration(place)
    if row.inherits
        continue
    . value SyntaxId = 0
    do match? written.nodes[row.site]
        | .node-assign(line)
            value = line.rhs
    . name Atom? = null
    do match? written.nodes[value]
        | .node-identifier(ident)
            if !ident.is-tracked
                name = ident.name
    . deferred = row.sheet == U32.max - 1
    if !name || !names-sheet-slot(name)
        if deferred
            decline(id)
            = false
        continue
    if !sheets-known()
        decline(id)
        = false
    . (found, resolved) = resolve-slot(made, name, owner, row.site)
    if !resolved
        = false
    if found == no-type
        if deferred
            decline(id)
            = false
        continue
    if !deferred
        report-at(owner, value, "\"${name.text}\" is ambiguous: it names both a StyleSheet slot of ${type-short-name(types, found)} and a lexical value")
        = false
    . (number, offset, projection) = slot-binding(owner, row.site, row.property, value, name, found, id)
    if number == U32.max
        = false
    revise-application(application)
    facts.add-rule-slot(RuleSlot(application, row.site, number, offset, projection))
= true

────────────────────
_ do defers-slot Bool
    - value SyntaxId

` Whether the value of a line of a style rule a class writes is a name alone that nothing
` declares and some style sheet has a slot of, which is resolved where the rule is applied
` (`bind-rule-slots`).
do match? tree.nodes[value]
    | .node-identifier(row)
        = !row.is-tracked && (bindings.resolution-of(frame.binding, value).flags /and/ ResolutionFlag.resolution-styled) != 0 && names-sheet-slot(row.name)
= false

────────────────────
_ do visible-sheets
    - made TypeId
    - sheets [TypeId]
    - levels [U32]

` The style sheets a markup element of a class sees, each in its group, lowest first, as the
` reference's `styleSheetVocabularyGroupsFor` gives them: those of the markup the element is
` in, or where there are none those the class the markup is written in uses, then those of the
` element's class (`add-sheet-groups`), but at a slot outlet (`overlaying`), where the reference
` adds none.
seen-sheets(sheets, levels)
if !preparing.overlaying
    add-sheet-groups(made, sheets, levels)

────────────────────
_ do declare-own-slot U32
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - order U32
    - value SyntaxId
    - sheet TypeId

` A line of a rule of a style sheet whose value is a name alone that names a slot of the sheet,
` which the reference resolves against that sheet alone: declared as `declare-slot` says.
` Answers as `declare-sheet-slot` does.
do match? tree.nodes[value]
    | .node-identifier(row)
        if !row.is-tracked && sheet-has-slot(sheet, row.name)
            = declare-slot(statement, element, index, position, 0, order, value, row.name, sheet)
= 0

────────────────────
_ do reads-sheet-member Bool
    - value SyntaxId
    - sheet TypeId

` Whether a value a rule of a style sheet declares names `this` or a member of the sheet that is
` no slot of it, which the reference compiles with no object of the sheet.
. root = family-root(sheet)
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.name.text == "this" || (types.property-named(sheet, row.name) && not-slot)
                = true
            .. not-slot = !sheet-has-slot(root, row.name)
= false

────────────────────
_ do enter-theme ThemeScope
    - made TypeId
    - sheet TypeId
    - statement SyntaxId

. outer = ThemeScope(theme-made, theme-sheet, theme-statement, theme-number)
theme-made = made
theme-sheet = sheet
theme-statement = statement
theme-number = U32.max
= outer

────────────────────
_ do leave-theme U32
    - outer ThemeScope

. number = theme-number
theme-made = outer.made
theme-sheet = outer.sheet
theme-statement = outer.statement
theme-number = outer.number
= number

────────────────────
_ do read-theme TypeId
    - id SyntaxId
    - name Atom

. found = no-type
if theme-sheet != no-type
    found = sheet-slot-owner(theme-sheet, name)
else
    if !sheets-known()
        decline(id)
        = invalid-type
    . (seen, resolved) = resolve-slot(theme-made, name, module, theme-statement)
    if !resolved
        = invalid-type
    found = seen
if found == no-type
    frame.diagnose(id, .stated, program.store-atom("Name not found"))
    = invalid-type
. number = sheet-index(family-root(found), module, theme-statement, id)
if number == U32.max
    = invalid-type
. use = facts.style-sheet-uses[number]
. offset = 0u32
while offset < use.count && facts.sheet-slots[use.first + offset].name != name
    offset += 1
if offset == use.count
    decline(id)
    = invalid-type
if theme-number != U32.max && theme-number != number
    . other = type-short-name(types, facts.style-sheet-uses[theme-number].type)
    frame.diagnose(id, .stated, program.store-atom("A style value reads slots of one StyleSheet: \"${name.text}\" is a slot of ${type-short-name(types, use.type)}, and others it reads are slots of $other"))
    = invalid-type
theme-number = number
facts.add-theme-read(ThemeRead(instance, module, id, number, offset))
= facts.sheet-slots[use.first + offset].type

────────────────────
_ do sheet-slot-owner TypeId
    - sheet TypeId
    - name Atom

. root = family-root(sheet)
=? root if sheet-has-slot(root, name)
for part in sheet-parts(class-ref(types, root))
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-using(using)
                . used = using-sheet(part, using)
                if used != no-type && sheet-has-slot(used, name)
                    = used
= no-type

────────────────────
_ do theme-static Bool
    - value SyntaxId

for node in tree.subtree-start(value) .. value
    if facts.theme-read-of(instance, node)
        continue
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . kind = bindings.resolution-of(frame.binding, node).kind
            if kind == .resolve-slot || kind == .resolve-member
                = false
= true

────────────────────
_ do declare-themed Bool
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - layer U32
    - order U32
    - value SyntaxId
    - number U32

. property = facts.style-properties[position]
if is-live-statement(statement) || !theme-static(value)
    frame.diagnose(value, .stated, program.store-atom("A style value that reads StyleSheet slots may read no local, member, style or tracked value; read a slot as \"\$name\" to compute with one"))
    = false
if !demand-themed-runtime()
    decline(statement)
    = false
. place = facts.note-themed-value(module, statement, instance, property.type, number)
. declaration = StyleDeclaration
    - instance
    - element
    - statement
    - facts.style-uses[index].type
    - position
    - layer
    - order
    - false
declaration.themed = place
facts.add-style-declaration(declaration)
= true

────────────────────
_ do demand-themed-runtime Bool

. runtime = facts.style-runtime
if runtime.site-themed != no-instance
    = true
if !demand-sheet-declarations()
    = false
runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleInfo")
. sheet = types.well-known-type("core/style", "StyleSheetInfo")
. record = types.well-known-type("core/style", "StyleSheetRecord")
. maker = types.well-known-type("core/style", "StyleThemedMaker")
. made = types.well-known-type("core/style", "StyleOptionalBits")
if info-missing || record == invalid-type || maker == invalid-type || made == invalid-type
    = false
.. info-missing = info == invalid-type || sheet == invalid-type
runtime.themed-made = made
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(info)
scratch.types.push(types.size-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(sheet)
scratch.types.push(types.size-type)
scratch.types.push(maker)
runtime.site-themed = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-template-site-themed")
    - mark
scratch.types.rewind(mark)
scratch.types.push(record)
scratch.types.push(types.size-type)
runtime.themed-slot = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-themed-slot")
    - mark
runtime.themed-none = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-themed-none")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= themed-ready && runtime.themed-none != no-instance
    .. themed-ready = runtime.site-themed != no-instance && runtime.themed-slot != no-instance

────────────────────
_ do demand-family-runtime Bool

. runtime = facts.style-runtime
if runtime.site-family != no-instance
    = true
if !demand-sheet-declarations()
    = false
runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
. sheet = types.well-known-type("core/style", "StyleSheetInfo")
if sheet == invalid-type
    = false
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(sheet)
scratch.types.push(types.type-row(.uint64))
runtime.site-family = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-template-site-family")
    - mark
scratch.types.rewind(mark)
scratch.types.push(types.size-type)
runtime.site-family-end = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-template-site-family-end")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= runtime.site-family != no-instance && runtime.site-family-end != no-instance

────────────────────
_ do declare-slot U32
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - layer U32
    - order U32
    - value SyntaxId
    - name Atom
    - found TypeId

` Records a declaration that takes its value from a slot of a style sheet (`slot-binding`).
` Answers as `declare-sheet-slot` does.
if layer == U32.max
    decline(statement)
    = 2
. (number, offset, projection) = slot-binding(module, statement, position, value, name, found, statement)
if number == U32.max
    = 2
facts.add-style-declaration
    - StyleDeclaration
        - instance
        - element
        - statement
        - facts.style-uses[index].type
        - position
        - layer
        - order
        - true
        - false
        - false
        - number
        - offset
        - projection
= 1

────────────────────
_ do slot-binding (U32, U32, U32)
    - owner ModuleId
    - statement SyntaxId
    - position U32
    - value SyntaxId
    - name Atom
    - found TypeId
    - at SyntaxId

` The number of the style sheet whose slot of a name a declaration of a style property takes
` its value from, written at `statement` in a module, the slot's place among the sheet's, and
` how its bits become the property's where their types differ (`sheet-projection`), or
` `U32.max`; with the reference's errors where they cannot, and declined at `at`. The number is
` `U32.max` where it is reported or declined.
. number = sheet-index(family-root(found), owner, statement, at)
if number == U32.max
    = (U32.max, 0, 0)
. use = facts.style-sheet-uses[number]
. offset = 0u32
while offset < use.count && facts.sheet-slots[use.first + offset].name != name
    offset += 1
. property = facts.style-properties[position]
if offset == use.count || !demand-style-sites() || !demand-sheet-declarations()
    decline(at)
    = (U32.max, 0, 0)
. slot = facts.sheet-slots[use.first + offset]
. projection = U32.max
if slot.type != property.type
    if !relation-legal(relations.compare(slot.type, property.type, false, false, null, owner))
        report-at(owner, value, "StyleSheet slot \"${name.text}\" has type ${type-display(types, slot.type)}, which cannot be converted to style property \"${property.name.text}\" type ${type-display(types, property.type)}")
        facts.mention-types([slot.type, property.type])
        = (U32.max, 0, 0)
    projection = sheet-projection(slot.type, property.type)
    if projection == U32.max - 1
        . shown = type-display(types, property.type)
        report-at(owner, value, "StyleSheet slot \"${name.text}\" can convert to $shown, but not as a zero-allocation style-sheet projection; declare the slot as $shown or assign a concrete value.")
        facts.mention-types([property.type])
        = (U32.max, 0, 0)
    if projection == U32.max
        decline(at)
        = (U32.max, 0, 0)
= (number, offset, projection)

────────────────────
_ do sheet-projection U32
    - source TypeId
    - target TypeId

` How the runtime makes the bits of a style property's value of those of a slot of a style sheet
` of another type, as the reference's `styleSheetProjectionPlan` says, recorded among
` `style-projections`: where the slot is no optional or the property is one, the bits of what an
` optional slot holds are copied where the property's type takes them as they are, or wrapped as
` the case of a union the property holds that takes them so (`reusable-case`), or of a union slot
` whose every case's value a case of the property's union takes so, given that case's number
` (`style-projection-union-remap`), whose table program tables number in source order
` (`ProgramTables.remap-number`). A case wraps the slot's bits only where they fit above its
` number: a whole number of at most 32 bits, or a handle; not a wider number such as a float.
` `U32.max - 1` where there is no such way, the reference's error.
if types.is-optional(source) && !types.is-optional(target)
    = U32.max - 1
. held = if types.is-optional(source) then types.optional-inner(source) else source
. wanted = if types.is-optional(target) then types.optional-inner(target) else target
. preserves = types.is-optional(source) && types.is-optional(target)
if !demand-sheet-projections()
    = U32.max
. index = facts.style-projections.length as U32
if reuses-style-bits(held, wanted)
    facts.style-projections += StyleProjection(0, 0, preserves)
    = index
if types.intrinsic-of(wanted) != .union
    = U32.max - 1
. found = reusable-case(held, wanted)
if found != U32.max
    . payload = types.cases-of(wanted)[found].type
    if !inline-style-case(payload) && !holds-handle(payload)
        = U32.max - 1
    facts.style-projections += StyleProjection(1, found, preserves)
    = index
if types.intrinsic-of(held) == .union
    . sources = types.cases-of(held)
    . first = facts.projection-tags.length as U32
    for position in 0 .. < sources.length
        . item = sources[position]
        . tag = if item.is-default then U32.max else reusable-case(item.type, wanted)
        if tag == U32.max
            -= facts.projection-tags[first .. < facts.projection-tags.length]
            = U32.max - 1
        facts.projection-tags += tag
    facts.style-projections += StyleProjection
        - 2
        - sources.length as U32
        - preserves
        - first
        - sources.length as U32
    = index
= U32.max - 1

────────────────────
_ reuses-style-bits Bool
    - source TypeId
    - target TypeId

` Whether the bits of a style value of one type are those of another's, as the reference's
` `styleProjectionCanReusePayloadBits` says: the same type, or an object of a class below the
` other's.
|? source == target
    true
??
    both-classes && in-base-chain(types, source, target)

.. both-classes = types.intrinsic-of(source) == .class && types.intrinsic-of(target) == .class

────────────────────
_ do reusable-case U32
    - source TypeId
    - union TypeId

` The case of a union whose value takes the bits of a style value of another type as they are,
` as the reference's `styleProjectionReusableUnionCase` chooses it: one of the same type before
` one of a class above it, the first of each. None where no case does.
. found = U32.max
. cases = types.cases-of(union)
for index in 0 .. < cases.length
    . item = cases[index]
    if item.is-default || item.type == no-type || item.type == types.void-type
        continue
    if item.type == source
        = index as U32
    if found == U32.max && reuses-style-bits(source, item.type)
        found = index as U32
= found

────────────────────
_ do demand-sheet-projections Bool

` The function of the style runtime that declares the slot of a style sheet as a style's value of
` another type for a site, typed once.
. runtime = facts.style-runtime
if runtime.site-projected != no-instance
    = true
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleInfo")
. sheet = types.well-known-type("core/style", "StyleSheetInfo")
. tags = types.well-known-type-of("core", "ConstArray", types.type-row(.uint8))
if tags == invalid-type
    = false
. remap = types.optional-of(tags)
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(info)
scratch.types.push(types.size-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(sheet)
scratch.types.push(types.size-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.int64))
scratch.types.push(types.size-type)
scratch.types.push(types.bool-type)
scratch.types.push(remap)
runtime.site-projected = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-template-site-style-sheet-projected")
    - mark
scratch.types.rewind(mark)
runtime.remap-tags = remap
facts.style-runtime = runtime
= runtime.site-projected != no-instance

────────────────────
_ do slot-domains U32
    - ref DeclRef
    - name Atom
    - home ModuleId
    - site SyntaxId

. owner = program.modules[ref.module]
. mask = 0u32
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-style-domains(domains)
                    do match? owner.tree.nodes[domains.syntax]
                        | .node-style-annotation(row)
                            if identifier-name(owner.tree, row.left) == name
                                for item in owner.tree.children[row.domains]
                                    do match? owner.tree.nodes[item]
                                        | .node-style-domain-item(domain)
                                            . named = identifier-name(owner.tree, domain.domain)
                                            if named && domain.target == 0
                                                . index = style-domain
                                                    - named
                                                    - home
                                                    - site
                                                    - ref.module
                                                    - item
                                                if index < 32
                                                    mask = mask /or/ (1u32 /lshift/ (index as Size))
= mask

────────────────────
_ do check-sheet-domains
    - index DeclId
    - class ClassDecl

. mark = scratch.types.mark
. sheet = types.intern-class(module, index, mark)
types.complete(sheet)
. base = types.base-of(sheet) ?? no-type
for member in program.modules[module].member-pool[class.members]
    do match? program.modules[module].decls[member]
        | .decl-style-domains(domains)
            do match? tree.nodes[domains.syntax]
                | .node-style-annotation(row)
                    . name = identifier-name(tree, row.left)
                    if is-sheet-type(base)
                        frame.diagnose(domains.syntax, .stated, program.store-atom("Derived StyleSheet \"${class.name.text}\" names no domains; its slots raise those ${type-short-name(types, family-root(sheet))} names"))
                    else if !name || !sheet-has-slot(sheet, name)
                        frame.diagnose(row.left, .stated, program.store-atom("StyleSheet slot \"${if name then name.text else ""}\" does not exist"))
                    else
                        for item in tree.children[row.domains]
                            do match? tree.nodes[item]
                                | .node-style-domain-item(domain)
                                    if domain.target != 0
                                        frame.diagnose(domain.target, .stated, program.store-atom("A StyleSheet slot raises its domains on the node that reads it, so they name no target"))

────────────────────
_ do sheet-index U32
    - sheet TypeId
    - home ModuleId
    - site SyntaxId
    - at SyntaxId

` The number of a style sheet among those the program registers, given when a declaration
` first takes a value from one of its slots, with its slots in the order the sheet declares
` them, each kept in a stored property of the object its constructor makes and becoming bits as
` a property of a style does; or none where it is declined, at `at`. The declaration is written
` at `site` in a module, and is noted as the instance's use of the sheet (`note-style-user`). Its
` constructor takes nothing.
for position in 0 .. < facts.style-sheet-uses.length
    if facts.style-sheet-uses[position].type == sheet
        facts.lookups += 1
        place-sheet-domains(sheet, home, site)
        note-style-user(sheet, home, site, false)
        = position as U32
. ref = class-ref(types, sheet)
. owner = program.modules[ref.module]
. first = facts.sheet-slots.length as U32
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-property(property)
                    if !property.name
                        continue
                    . named = property.name
                    . seen = false
                    . start Size = first
                    for place in start .. < facts.sheet-slots.length
                        if facts.sheet-slots[place].name == named
                            seen = true
                    if seen
                        continue
                    . found = types.property-named(sheet, named)
                    if !found
                        decline(at)
                        = U32.max
                    . row = types.properties[found]
                    . declared-type = if untyped then demand-member(row, sheet, named) else row.type
                        .. untyped = row.type == no-type
                    if row.storage-kind != .storage-eager || unresolved
                        decline(at)
                        = U32.max
                    .. unresolved = declared-type == invalid-type || declared-type == no-type
                    . flags = sheet-slot-flags(declared-type)
                    if flags == U32.max
                        decline(at)
                        = U32.max
                    facts.sheet-slots += SheetSlot
                        - named
                        - declared-type
                        - row.slot
                        - flags
                        - slot-domains(ref, named, home, site)
. mark = scratch.types.mark
. singleton = calls.demand-constructor(sheet, mark)
. last = facts.sheet-slots.length as U32
if singleton == no-instance || !demand-sheet-runtime() || !demand-sheet-members(sheet, first, last)
    decline(at)
    = U32.max
. index = facts.style-sheet-uses.length as U32
facts.style-sheet-uses += StyleSheetUse(sheet, singleton, first, last - first)
note-style-user(sheet, home, site, false)
= index

────────────────────
_ do place-sheet-domains
    - sheet TypeId
    - home ModuleId
    - site SyntaxId

` Places the domains the slots of a style sheet name, as a later use of the sheet at `site` in
` `home` names each (`place-style-domain`) as its first use does (`slot-domains`), so that the
` places noted do not depend on which instance used the sheet first.
. ref = class-ref(types, sheet)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-style-domains(domains)
                    do match? owner.tree.nodes[domains.syntax]
                        | .node-style-annotation(row)
                            for item in owner.tree.children[row.domains]
                                do match? owner.tree.nodes[item]
                                    | .node-style-domain-item(domain)
                                        . named = identifier-name(owner.tree, domain.domain)
                                        if named && domain.target == 0
                                            place-style-domain(named, home, site, ref.module, item)

────────────────────
_ do demand-sheet-members Bool
    - sheet TypeId
    - first U32
    - last U32

list-derived-sheets()
for derived in facts.derived-sheets
    if family-root(derived) != sheet
        continue
    . start = facts.sheet-member-slots.length as U32
    . level = derived
    while true
        . ref = class-ref(types, level)
        . owner = program.modules[ref.module]
        do match? owner.decls[ref.decl]
            | .decl-class(declared)
                for member in owner.member-pool[declared.members]
                    do match? owner.decls[member]
                        | .decl-property(property)
                            . named = property.name
                            if named && (level != sheet || (property.value != 0 && slot-reads))
                                add-member-slot(named, start, first, last)
                            .. slot-reads = reads-sheet-slots(owner.tree, property.value, sheet)
        if level == sheet
            break
        level = types.base-of(level) ?? sheet
    . mark = scratch.types.mark
    . singleton = calls.demand-constructor(derived, mark)
    if singleton == no-instance || !demand-sheet-member-runtime()
        = false
    facts.sheet-members += SheetMember
        - sheet
        - derived
        - singleton
        - start
        - (facts.sheet-member-slots.length as U32) - start
= true

────────────────────
_ do reads-sheet-slots Bool
    - written AST
    - value SyntaxId
    - sheet TypeId

for node in written.subtree-start(value) .. value
    do match? written.nodes[node]
        | .node-identifier(row)
            if row.name.text == "this" || sheet-has-slot(sheet, row.name)
                = true
= false

────────────────────
_ do add-member-slot
    - name Atom
    - start U32
    - first U32
    - last U32

for place in first .. < last
    if facts.sheet-slots[place].name == name
        . offset = place - first
        for held in (start as Size) .. < facts.sheet-member-slots.length
            if facts.sheet-member-slots[held] == offset
                =
        facts.sheet-member-slots += offset
        =

────────────────────
_ do demand-sheet-member-runtime Bool

. runtime = facts.style-runtime
if runtime.sheet-member-slot != no-instance
    = true
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleSheetInfo")
. record = types.well-known-type("core/style", "StyleSheetRecord")
if info == invalid-type || record == invalid-type
    = false
. mark = scratch.types.mark
scratch.types.push(info)
scratch.types.push(types.string-type)
scratch.types.push(types.string-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
runtime.sheet-register-member = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-register-member")
    - mark
scratch.types.rewind(mark)
scratch.types.push(record)
scratch.types.push(types.size-type)
scratch.types.push(types.type-row(.int64))
scratch.types.push(types.bool-type)
runtime.sheet-member-slot = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-member-slot")
    - mark
scratch.types.rewind(mark)
scratch.types.push(record)
scratch.types.push(types.string-type)
runtime.sheet-member-tag = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-member-tag")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= registers && runtime.sheet-member-slot != no-instance && runtime.sheet-member-tag != no-instance
    .. registers = runtime.sheet-register-member != no-instance

────────────────────
_ do sheet-slot-flags U32
    - type TypeId

` How the bits of a slot of a style sheet are flagged, as the reference's `styleEncodedFlagBits`
` says: 2 where they encode a value of a union, or one boxed, else 0; the values are made bits
` as those of a style's properties are. None for a type that has no such bits.
. held = if types.is-optional(type) then types.optional-inner(type) else type
. kind = types.intrinsic-of(held)
if kind == .union
    for item in types.cases-of(held)
        if style-case(item.type) == U32.max
            = U32.max
    = 2
if intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    = 0
if kind == .class
    = if demand-style-coding(held, true) then 0 else U32.max
if boxed-style(kind)
    = if demand-style-coding(held, false) then 2 else U32.max
= U32.max

────────────────────
_ do demand-sheet-runtime Bool

` The functions of the style runtime that registering style sheets calls, typed once.
. runtime = facts.style-runtime
if runtime.sheet-register != no-instance
    = true
if !demand-style-runtime() || !demand-style-sites()
    = false
runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleSheetInfo")
if info == invalid-type
    = false
. mark = scratch.types.mark
scratch.types.push(types.string-type)
runtime.sheet-info-for = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-info-for")
    - mark
scratch.types.push(types.string-type)
scratch.types.push(types.size-type)
runtime.sheet-info = calls.demand-constructor(info, mark)
scratch.types.rewind(mark)
scratch.types.push(info)
scratch.types.push(types.size-type)
scratch.types.push(types.string-type)
scratch.types.push(types.type-row(.int64))
scratch.types.push(types.bool-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
runtime.sheet-register-slot = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-register-slot")
    - mark
scratch.types.rewind(mark)
scratch.types.push(info)
scratch.types.push(types.type-row(.int64))
runtime.sheet-register = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-register")
    - mark
scratch.types.rewind(mark)
scratch.types.push(types.index-type)
runtime.sheet-info-required = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-sheet-info-required")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= runtime.sheet-info-for != no-instance && runtime.sheet-info != no-instance && runtime.sheet-register-slot != no-instance && runtime.sheet-register != no-instance && runtime.sheet-info-required != no-instance

────────────────────
_ do demand-sheet-declarations Bool

` The function of the style runtime that declares the slot of a style sheet as a style's value
` for a site, typed once.
. runtime = facts.style-runtime
if runtime.site-sheet != no-instance
    = true
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleInfo")
. sheet = types.well-known-type("core/style", "StyleSheetInfo")
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(info)
scratch.types.push(types.size-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(sheet)
scratch.types.push(types.size-type)
runtime.site-sheet = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-template-site-style-sheet")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= runtime.site-sheet != no-instance

────────────────────
_ do distinct-style Bool
    - index U32
    - visible [TypeId]
    - owner ModuleId
    - written SyntaxId
    - site SyntaxId

` Whether no property of a style is one a style seen before it names, which is reported.
. use = facts.style-uses[index]
for position in use.first .. < use.first + use.count
    . name = facts.style-properties[position].name
    for other in visible
        for seen in facts.style-uses
            if seen.type != other
                continue
            for place in seen.first .. < seen.first + seen.count
                if facts.style-properties[place].name == name
                    if owner != module
                        decline(site)
                    else
                        . message = "Style property \"${name.text}\" is declared by both ${type-short-name(types, other)} and ${type-short-name(types, use.type)}"
                        frame.diagnose(written, .stated, program.store-atom(message))
                    = false
= true

────────────────────
_ do style-index U32
    - used TypeId
    - site SyntaxId
    - constructs Bool

` The number of a style among those the program registers, given when it is first used, with
` its properties, base first, each kept in a stored property of the object its constructor
` makes; or none where the style is declined or reported. Each use is noted as the instance's,
` a constructor that `constructs` with it or a line that declares with it (`note-style-user`).
` A line of a style that names the domains a change to a property raises numbers each domain as
` it is first named, and each use names it (`place-style-domains`). The type of a property
` says how its value becomes the bits of a slot: a number is cast, an object is interned, a value
` of a union is its case's number below the bits its case's value becomes, and any other value is
` boxed and the box interned. Each use notes the codings of the properties
` (`note-style-codings`), so that what the instance records is the same whichever instance
` registered the style.
for position in 0 .. < facts.style-uses.length
    if facts.style-uses[position].type == used
        place-style-domains(used, site)
        note-style-codings(facts.style-uses[position])
        note-style-user(used, module, site, constructs)
        = position as U32
. chain [TypeId]
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    chain += level
    level = types.base-of(level)
. first = facts.style-properties.length as U32
for position in 0 .. < chain.length
    . ref = class-ref(types, chain[chain.length - 1 - position])
    . owner = program.modules[ref.module]
    . members = RowRange'DeclId()
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            members = class.members
    for member in owner.member-pool[members]
        do match? owner.decls[member]
            | .decl-property(property)
                if property.name && plain-member && style-property(first, property.name) == U32.max
                    if !add-style-property(used, property, ref.module, site)
                        = U32.max
                .. plain-member = !property.defaults-root && property.element == 0
    for member in owner.member-pool[members]
        do match? owner.decls[member]
            | .decl-style-domains(domains)
                if !add-style-domains(first, owner.tree, domains.syntax, ref.module, site)
                    = U32.max
. mark = scratch.types.mark
. singleton = calls.demand-constructor(used, mark)
if singleton == no-instance || !demand-style-runtime()
    decline(site)
    = U32.max
. index = facts.style-uses.length as U32
. last = facts.style-properties.length as U32
facts.style-uses += StyleUse(used, singleton, first, last - first)
note-style-user(used, module, site, constructs)
= index

────────────────────
_ do note-style-user
    - used TypeId
    - home ModuleId
    - site SyntaxId
    - constructs Bool

` Notes that the instance being checked uses a style or a style sheet at a place in a module,
` keeping the first such place, a constructor's before any other, among those it noted last.
. position = facts.style-users.length
while position > 0 && facts.style-users[position - 1].instance == instance
    position -= 1
    . user = facts.style-users[position]
    if user.type == used
        if (constructs == user.constructed && comes-first) || (constructs && !user.constructed)
            facts.style-users[position] = StyleUser(used, instance, home, site, constructs)
        .. comes-first = precedes(home, site, user.module, user.site)
        =
facts.style-users += StyleUser(used, instance, home, site, constructs)

────────────────────
_ do note-style-codings
    - use StyleUse

` Notes the instance being checked as using the codings the properties of a registered style
` turn values into bits by, as registering them does (`add-style-property`): an object's, a
` boxed value's, and those of the cases of a union that have one.
for position in use.first .. < use.first + use.count
    . declared = facts.style-properties[position].type
    . held = if types.is-optional(declared) then types.optional-inner(declared) else declared
    . kind = types.intrinsic-of(held)
    if kind == .union
        for item in types.cases-of(held)
            note-coding-user(item.type)
    else if kind == .class || boxed-style(kind)
        note-coding-user(held)

────────────────────
_ do note-coding-user
    - type TypeId

` Notes the instance being checked as using the coding of a type, where there is one.
for coding in facts.style-codings
    if coding.type == type
        facts.coding-users += CodingUser(instance, type)
        =

────────────────────
_ precedes Bool
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Whether a place in the program comes before another in source order: in a module loaded
` first, or earlier in the same module.
|? module != other-module
    module < other-module
??
    begin.line < other-begin.line || earlier-column

.. tree = program.modules[module].tree
.. begin = tree.nodes.loc[site].begin
.. other-begin = tree.nodes.loc[other].begin
.. earlier-column = begin.line == other-begin.line && begin.column < other-begin.column

────────────────────
_ do style-property U32
    - first U32
    - name Atom

` The place of a property among those of the style being registered, or none.
for position in first .. < (facts.style-properties.length as U32)
    if facts.style-properties[position].name == name
        = position
= U32.max

────────────────────
_ do add-style-property Bool
    - used TypeId
    - property PropertyDecl
    - owner ModuleId
    - site SyntaxId

` Adds a property of a style being registered. Its annotation says it is inherited; any other
` is reported, as is a type written for it that names nothing, which the reference meets as it
` registers. One that is not stored in the object, or whose type has no bits a slot holds,
` is declined.
. name = property.name!
. found = types.property-named(used, name)
if !found
    decline(site)
    = false
. row = types.properties[found]
if row.storage-kind != .storage-eager
    decline(site)
    = false
. declared = if row.type == no-type then demand-member(row, used, name) else row.type
if declared == invalid-type && owner == module && property.type-syntax != 0
    . env = types.class-env(owner, property.owner)
    . reported = report-missing-type(property.type-syntax, env)
    types.env-release(env)
    if reported
        = false
if declared == invalid-type || declared == no-type
    decline(site)
    = false
. held = if types.is-optional(declared) then types.optional-inner(declared) else declared
if types.intrinsic-of(held) == .style
    if owner != module
        decline(site)
    else
        . message = "Style property \"${name.text}\" cannot have a Style type; use an object-valued property with an ordinary descriptor class instead"
        frame.diagnose(property.syntax, .stated, program.store-atom(message))
    = false
. flags = 0u32
. written = program.modules[owner].tree
do match? written.nodes[property.syntax]
    | .node-property-syntax(row)
        for offset in 0 .. < row.annotations.count
            . annotation = written.atoms[row.annotations.start + offset]
            if annotation.text != "inherited"
                if owner != module
                    decline(site)
                else
                    . message = "Unknown style property annotation \"@${annotation.text}\"; only \"@inherited\" is supported"
                    frame.diagnose(property.syntax, .stated, program.store-atom(message))
                = false
            flags = 1
. shift = 0u32
. tags = 0u64
. kind = types.intrinsic-of(held)
if kind == .union
    shift = 8
    flags = flags /or/ 2
    . cases = types.cases-of(held)
    for index in 0 .. < cases.length
        . coded = style-case(cases[index].type)
        if coded == U32.max
            decline(site)
            = false
        if coded == 2 && index < 64
            tags = tags /or/ (1u64 /lshift/ (index as U64))
else if intrinsic-is-numeric(kind) || kind == .bool
    if kind == .cpointer || kind == .number
        decline(site)
        = false
    if intrinsic-is-float(kind)
        flags = flags /or/ 4
else if kind == .class
    if !demand-style-coding(held, true)
        decline(site)
        = false
    flags = flags /or/ 8
else if boxed-style(kind)
    flags = flags /or/ 2
    tags = 1
    if !demand-style-coding(held, false)
        decline(site)
        = false
else
    decline(site)
    = false
facts.style-properties += StyleProperty(name, declared, row.slot, flags, shift, tags)
= true

────────────────────
_ do style-case U32
    - type TypeId

` How a case of a union a style property holds becomes bits: 0 for a whole number of at most
` 32 bits, inline below its case's number, 1 for an object, interned, and 2 for any other
` value, boxed. None for one that has no such bits.
. kind = types.intrinsic-of(type)
if is-integer-kind(kind) && inline-bits
    = 0
.. inline-bits = types.completions[type].bit-size > 0 && types.completions[type].bit-size <= 32
if kind == .class
    = if demand-style-coding(type, true) then 1 else U32.max
if intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    = if demand-style-coding(type, false) then 2 else U32.max
if boxed-style(kind)
    = if demand-style-coding(type, false) then 2 else U32.max
= U32.max

────────────────────
_ boxed-style Bool
    - kind IntrinsicKind

` Whether a style value of a kind is kept in a box the runtime holds a handle to, as the
` reference's `styleValueClass` says of a value that is no number, object or union: a tuple, a
` struct or a string.
kind == .tuple || kind == .struct || kind == .string

────────────────────
_ do demand-style-coding Bool
    - type TypeId
    - object Bool

` Types how values of a type that is no number become bits as styles register: an object by
` the runtime's `style-intern-object` for the type, and any other value by the constructor of
` its box and the runtime's `style-intern-holder`. The instance typed is noted as using them
` (`Facts.coding-users`).
for coding in facts.style-codings
    if coding.type == type
        facts.coding-users += CodingUser(instance, type)
        = true
. runtime = class-ref(types, types.type-row(.style)).module
. mark = scratch.types.mark
if object
    . taken = types.optional-of(type)
    scratch.types.push(type)
    scratch.types.push(taken)
    . intern = calls.demand-runtime-call
        - runtime
        - no-type
        - program.store-atom("style-intern-object")
        - mark
        - 1
    scratch.types.rewind(mark)
    if intern == no-instance
        = false
    facts.style-codings += StyleCoding(type, intern, no-instance, taken)
    facts.coding-users += CodingUser(instance, type)
    = true
. box = types.well-known-type-of("core/style", "StyleWideHolder", type)
if box == invalid-type
    = false
scratch.types.push(type)
. holder = calls.demand-constructor(box, mark)
scratch.types.rewind(mark)
if holder == no-instance
    = false
if facts.style-runtime.intern-holder == no-instance
    facts.style-runtime.held = types.optional-of
        - types.well-known-type("core/style", "StyleObjectHolder")
    scratch.types.push(facts.style-runtime.held)
    facts.style-runtime.intern-holder = calls.demand-runtime-call
        - runtime
        - no-type
        - program.store-atom("style-intern-holder")
        - mark
    scratch.types.rewind(mark)
    if facts.style-runtime.intern-holder == no-instance
        = false
facts.style-codings += StyleCoding(type, no-instance, holder)
facts.coding-users += CodingUser(instance, type)
= true

────────────────────
_ do add-style-domains Bool
    - first U32
    - tree AST
    - id SyntaxId
    - owner ModuleId
    - site SyntaxId

` Adds the domains a line of a style names for one of its properties, each numbered as it is
` first named, raised on the node itself, or on its parent where the line says so. A line
` naming no property of the style, or a place other than the node or its parent, is reported.
do match? tree.nodes[id]
    | .node-style-annotation(row)
        . name = identifier-name(tree, row.left)
        . position = if name then style-property(first, name) else U32.max
        if position == U32.max
            . message = "Style property \"${if name then name.text else ""}\" does not exist"
            report-style(id, owner, site, message)
            = false
        for item in tree.children[row.domains]
            do match? tree.nodes[item]
                | .node-style-domain-item(domain)
                    . domain-name = identifier-name(tree, domain.domain)
                    . target = identifier-name(tree, domain.target) if domain.target != 0
                    if !domain-name
                        decline(site)
                        = false
                    . index = style-domain(domain-name, module, site, owner, item)
                    if !target || target.text == "self"
                        facts.property-domains += PropertyDomain(position, index, false)
                    else if target.text == "parent"
                        facts.property-domains += PropertyDomain(position, index, true)
                    else
                        . message = "Unknown style invalidation target \"${target.text}\"; expected \"self\" or \"parent\""
                        report-style(id, owner, site, message)
                        = false
        = true
decline(site)
= false

────────────────────
_ do report-style
    - id SyntaxId
    - owner ModuleId
    - site SyntaxId
    - message String

` Reports a style written wrong where it is written, or declines the constructor that uses it
` where that is in another module.
if owner != module
    decline(site)
else
    frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do style-domain U32
    - name Atom
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` The place of a domain of invalidation among `style-domains`, made as it is first named. The
` instance typed is noted as naming it at `site` in `home` by `line` (`note-domain-user`). The 32
` the runtime holds are counted once the program is typed (`Typing.number-domains`).
. known = place-style-domain(name, home, site, line-module, line)
if known != U32.max
    = known
facts.style-domains += StyleDomain(name)
. index = (facts.style-domains.length - 1) as U32
note-domain-user(index, home, site, line-module, line)
= index

────────────────────
_ do place-style-domain U32
    - name Atom
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` The number of a domain of invalidation already named, or none. The instance typed is noted as
` naming it at `site` in `home` by `line` (`note-domain-user`).
for position in 0 .. < facts.style-domains.length
    if facts.style-domains[position].name == name
        note-domain-user(position as U32, home, site, line-module, line)
        = position as U32
= U32.max

────────────────────
_ do note-domain-user
    - domain U32
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` Notes that the instance being checked names a domain of invalidation at `site` in `home`, by a
` line, keeping the first such place and line (`names-before`) among those it noted last.
` Program tables register the domain at the first of those of every instance, so the place is
` the same however instances are typed.
. user = DomainUser(instance, domain, home, site, line-module, line)
. position = facts.domain-users.length
while position > 0 && facts.domain-users[position - 1].instance == instance
    position -= 1
    if facts.domain-users[position].domain == domain
        if names-before(user, facts.domain-users[position])
            facts.domain-users[position] = user
        =
facts.domain-users += user

────────────────────
_ names-before Bool
    - user DomainUser
    - other DomainUser

` Whether an instance names a domain of invalidation before another does: at an earlier place,
` or at the same place by an earlier line, each in source order and then by its syntax, as
` program tables order the places of domains.
|? user.module != other.module || user.site != other.site
    placed-before(user.module, user.site, other.module, other.site)
??
    placed-before(user.line-module, user.line, other.line-module, other.line)

────────────────────
_ placed-before Bool
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Whether a place in the program comes before another in source order (`precedes`), or, where
` the two begin together in a module, has the lesser syntax.
|? precedes(module, site, other-module, other)
    true
|? precedes(other-module, other, module, site)
    false
??
    module == other-module && site < other

────────────────────
_ do place-style-domains
    - used TypeId
    - site SyntaxId

` Places the domains the lines of a style and of the styles above it name, as a use of the style
` at `site` names each (`place-style-domain`).
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-domains(domains)
                        do match? owner.tree.nodes[domains.syntax]
                            | .node-style-annotation(row)
                                for item in owner.tree.children[row.domains]
                                    do match? owner.tree.nodes[item]
                                        | .node-style-domain-item(domain)
                                            . name = identifier-name(owner.tree, domain.domain)
                                            if name
                                                place-style-domain(name, module, site, ref.module, item)
    level = types.base-of(level)

────────────────────
_ do style-name Atom?
    - written AST
    - id SyntaxId

do match? written.nodes[id]
    | .node-get-expression(row)
        =? null if row.is-tracked || row.is-optional || row.is-loop
        do match? written.nodes[row.object]
            | .node-identifier(head)
                =? program.store-atom("${head.name.text}.${row.name.text}") if !head.is-tracked
        = null
= identifier-name(written, id)

────────────────────
_ styles-attribute Bool
    - op Operator
    - class TypeId
    - name Atom?

` Whether an attribute of a markup element may name a property of a style rather than one of
` the element's class: a plain assignment of a name the class has no property of, where the
` style runtime is loaded.
|? !name || op != .eq-op || types.intrinsic-of(class) != .class || generic
    false
??
    !types.property-named(class, name) && !interface-accessor(class, name) && program.module-by-name("core/style") != null

.. generic = types.completions[class].has-variables

────────────────────
_ do add-visible-styles Bool
    - class TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles a class sees, each once: those its bases use, base first,
` then its own, as the reference's `visibleStyleUsings`, or those an interface and each it
` extends use (`add-interface-styles`), or a style sheet uses (`add-sheet-styles`). A using of
` a style sheet gives none. One that is wrong is declined or reported, and false. What a class
` or a style sheet sees is kept once found (`visible-styles`), and added again as it was, with
` the fault the type store gives cleared where reading its usings clears it.
if class != no-type && types.intrinsic-of(class) == .interface
    = add-interface-styles(class, styles, site)
if class == no-type || (types.intrinsic-of(class) != .class && not-sheet)
    = true
.. not-sheet = types.intrinsic-of(class) != .style-sheet
. known = scratch.visible-styles[class]
if known
    . start = (known / 4294967296) as Size
    . count = (known / 2 % 2147483648) as Size
    if known % 2 == 1
        types.clear-fault()
    for offset in 0 .. < count
        . used = scratch.visible-style-list[start + offset]
        if styles.find(used) == null
            styles += used
    = true
. found [TypeId]
. (kept, usings) = find-visible-styles(class, found, site)
for used in found
    if styles.find(used) == null
        styles += used
if !kept
    = false
. start = scratch.visible-style-list.length as U64
for used in found
    scratch.visible-style-list += used
scratch.visible-styles[class] = start * 4294967296 + found-count * 2 + (if usings then 1 else 0)
    .. found-count = found.length as U64
= true

────────────────────
_ do find-visible-styles (Bool, Bool)
    - class TypeId
    - styles [TypeId]
    - site SyntaxId

` The styles a class or a style sheet sees, each once, as `add-visible-styles` adds them;
` whether none was wrong, and whether a using was read.
if types.intrinsic-of(class) == .style-sheet
    = add-sheet-styles(class, styles, site)
. usings = false
. chain [TypeId]
. level TypeId? = class
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . ref = class-ref(types, chain[chain.length - 1 - position])
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(declared)
            for member in owner.member-pool[declared.members]
                do match? owner.decls[member]
                    | .decl-using(using)
                        usings = true
                        if using-sheet(ref, using) != no-type
                            continue
                        . used = using-style(ref, using, site)
                        if used == no-type
                            = (false, true)
                        if styles.find(used) == null
                            styles += used
= (true, usings)

────────────────────
_ do add-sheet-styles (Bool, Bool)
    - sheet TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles a style sheet uses, with those its extensions use
` (`sheet-parts`), which the rules it writes declare, after those of the sheet it derives from;
` whether none was wrong, and whether a using was read.
. usings = false
. base = types.base-of(sheet) ?? no-type
if is-sheet-type(base)
    . (kept, inherited) = add-sheet-styles(base, styles, site)
    =? (false, true) if !kept
    usings = inherited
for part in sheet-parts(class-ref(types, sheet))
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-using(using)
                usings = true
                if using-sheet(part, using) != no-type
                    continue
                . used = using-style(part, using, site)
                if used == no-type
                    = (false, true)
                if styles.find(used) == null
                    styles += used
= (true, usings)

────────────────────
_ do add-interface-styles Bool
    - interface TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles an interface uses, then those of each interface it extends,
` as the reference's `visibleStyleUsings` of an interface.
. ref = class-ref(types, interface)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-using(using)
                    . used = using-style(ref, using, site)
                    if used == no-type
                        = false
                    if styles.find(used) == null
                        styles += used
for extended in types.interfaces-of(interface)
    if !add-interface-styles(extended, styles, site)
        = false
= true

────────────────────
_ do conform-styles
    - class TypeId
    - interface TypeId

` A class whose objects are made values of an interface must use each style the interface and
` those it extends use, as the reference checks as it makes the witness; the first it does not
` is the reference's error, at the class's declaration. Each instance that makes the witness
` reports it, so that it is reported whichever of them a type pass types.
. key = ((class as U64) /lshift/ 32) /or/ (interface as U64)
. known = scratch.missing-styles[key]
. missing = if known then known else missing-style(class, interface)
scratch.missing-styles[key] = missing
if missing == no-type
    =
. ref = class-ref(types, class)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        . text = program.store-atom("${type-short-name(types, class)} must use ${type-short-name(types, missing)} to implement ${type-short-name(types, interface)}")
        facts.record-diagnostic
            - instance
            - ref.module
            - declared.syntax
            - .stated
            - text
            - no-type
            - no-type

────────────────────
_ do conform-members
    - value TypeId
    - interface TypeId

` A type whose values are made values of an interface must answer each function the interface
` and those it extends declare without a body and with a result: its table has nothing of the
` interface's to run for it. The first it does not answer is the error, at the type's
` declaration, as a call through the interface reports it. Each instance that makes the witness
` reports it, so that it is reported whichever of them a type pass types.
. ref = class-ref(types, value)
if ref.decl == 0
    =
. owner = program.modules[ref.module]
. site = match owner.decls[ref.decl]
    | .decl-class(declared)
        declared.syntax
    ??
        0u32
if site == 0
    =
. key = ((value as U64) /lshift/ 32) /or/ (interface as U64)
. known = scratch.missing-members[key]
. missing = if known then known else missing-member(value, interface)
scratch.missing-members[key] = missing
if missing == 0
    =
. module = (missing /rshift/ 32) as ModuleId
. decl = (missing /and/ 0xffffffff) as DeclId
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        . declaring = declaring-interface(interface, DeclRef(module, fn.owner))
        . text = program.store-atom(unanswered-text(types, value, declaring, fn.name!))
        facts.record-diagnostic(instance, ref.module, site, .stated, text)
        facts.relate-diagnostic(program.store-atom("Interface"), module, fn.syntax)

────────────────────
_ do missing-member U64
    - value TypeId
    - interface TypeId

` The first function an interface, then each it extends, declares without a body and with a
` result that a type does not answer, as its module above its declaration, or 0 where the type
` answers each. A function with type parameters of its own is left to the calls that give it
` arguments, which choose what answers it. A step function written with no steps has no body
` either: it is given an empty block only so that it has one to check.
. ref = class-ref(types, interface)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-function(fn)
                    . own-params = fn.type-args.count != 0
                    . bodiless = fn.body == 0 || is-module-empty-block(ref.module, fn.body)
                    if bodiless && fn.return-type != 0 && !fn.is-static && !own-params && fn.name
                        if !answers-required(value, interface, ref.module, member, fn.kind, fn.name)
                            = ((ref.module as U64) /lshift/ 32) /or/ (member as U64)
for extended in types.interfaces-of(interface)
    . missing = missing-member(value, extended)
    if missing != 0
        = missing
= 0

────────────────────
_ do answers-required Bool
    - value TypeId
    - interface TypeId
    - module ModuleId
    - decl DeclId
    - kind DeclKind
    - name Atom

` Whether a type answers a function an interface declares without a body, as the table of the
` type finds it: by a member of its own, of a class it is derived from or of an extension that
` takes the arguments the interface's function does, by a property it stores or one it
` delegates the name to for a getter or a setter, and by what it delegates the interface to.
` The signature is read onto the scratch stacks, and taken off them again.
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. signature = signature-into(types, module, decl, no-type-arguments(types), interface, true)
. answered = answers-signature(value, signature, module, decl, kind, name)
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
= answered

────────────────────
_ do answers-signature Bool
    - value TypeId
    - signature Signature
    - module ModuleId
    - decl DeclId
    - kind DeclKind
    - name Atom

for arg in signature.args
    if types.completions[arg].has-variables
        = true
if kind != .function-decl && types.property-named(value, name)
    = true
. busy = calls.suspend-ranking()
. ranking = calls.ranking
. caller = ranking.caller
ranking.caller = class-ref(types, value).module
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
for arg in signature.args
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(arg)
ranking.begin(scratch.call-arguments.since(shapes-start), scratch.types.since(types-start))
. hit Hit? = null
if kind == .getter-decl
    hit = ranking.dispatch-getter(value, name)
else if kind == .setter-decl
    hit = ranking.dispatch-setter(value, name)
else
    hit = ranking.dispatch-method(value, name)
. answered = hit && (hit.module != module || hit.decl != decl || ranking.ambiguity() != null)
. steps [U32]
if !answered && kind != .function-decl
    . holder = ranking.delegated-holder(value, name, steps)
    answered = holder != no-type && steps.length != 0 && types.property-named(holder, name) != null
ranking.release()
scratch.call-arguments.rewind(shapes-start)
scratch.types.rewind(types-start)
ranking.caller = caller
calls.resume-ranking(busy)
= answered

────────────────────
_ do declaring-interface TypeId
    - interface TypeId
    - declarer DeclRef

` The interface, of one and those it extends, that a declaration declares.
. ref = class-ref(types, interface)
if ref.module == declarer.module && ref.decl == declarer.decl
    = interface
for extended in types.interfaces-of(interface)
    . found = declaring-interface(extended, declarer)
    if found != no-type
        = found
= no-type

────────────────────
_ do missing-style TypeId
    - class TypeId
    - interface TypeId

` The first style an interface or one it extends uses that a class does not, or no type.
if !program.module-by-name("core/style")
    = no-type
. wanted [TypeId]
if !add-interface-styles(interface, wanted, 0) || wanted.length == 0
    = no-type
. seen [TypeId]
if !add-visible-styles(class, seen, 0)
    = no-type
for style in wanted
    if seen.find(style) == null
        = style
= no-type

────────────────────
_ do style-vocabulary [TypeId]?
    - class TypeId
    - site SyntaxId

` The styles a name written for an object of a class in markup may be a property of, in the
` order they answer it: the class's own, those of the elements the markup is in, innermost
` first, and those of the class the markup is written in, as the reference's
` `styleVocabularyFor`. None where a using is declined.
. styles [TypeId]
if !add-visible-styles(class, styles, site)
    = null
add-markup-styles(styles)
if !add-visible-styles(frame.self-type, styles, site)
    = null
= styles

────────────────────
_ do add-markup-styles
    - styles [TypeId]

` Adds to a vocabulary the styles of the elements the markup is in, innermost first, each that
` it does not hold yet, once. The stack of them holds a style again for each element that
` brings it into view, so what the vocabulary holds is marked by type rather than searched.
style-mark += 1
for style in styles
    mark-style(style)
for position in 0 .. < markup-styles.length
    . used = markup-styles[markup-styles.length - 1 - position]
    if mark-style(used)
        styles += used

────────────────────
_ do mark-style Bool
    - style TypeId

` Marks a style as one the vocabulary `add-markup-styles` gathers holds, and says whether it
` held it not yet.
while style-marks.length <= style
    style-marks += 0
if style-marks[style] == style-mark
    = false
style-marks[style] = style-mark
= true

────────────────────
_ do names-style-property Bool
    - used TypeId
    - name Atom

` Whether a style, or one above it, declares a property of a name.
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(declared)
            for member in owner.member-pool[declared.members]
                do match? owner.decls[member]
                    | .decl-property(property)
                        if property.name && property.name == name && plain-member
                            = true
                        .. plain-member = !property.defaults-root && property.element == 0
    level = types.base-of(level)
= false

────────────────────
_ do style-answering TypeId
    - styles [TypeId]
    - name Atom

` The style of a vocabulary that declares a property of a name: none where no style does, and
` the invalid type where two do, which the reference resolves by their types.
. found = no-type
for used in styles
    if names-style-property(used, name)
        if found != no-type
            = invalid-type
        found = used
= found

────────────────────
_ do first-answering TypeId
    - styles [TypeId]
    - name Atom
    - site SyntaxId

` The first style of a vocabulary that declares a property of a name where more than one does,
` as the reference resolves it where they give it one type; where two give it different types,
` the reference's error at the name `site` writes, and the invalid type.
. found = no-type
. held = no-type
. owner = no-type
. written = site
do match? tree.nodes[site]
    | .node-assign(line)
        written = line.lhs
for used in styles
    . (level, type) = declared-style-property(used, name)
    if level == no-type
        continue
    if type == invalid-type || type == no-type
        decline(site)
        = invalid-type
    if found == no-type
        found = used
        held = type
        owner = level
    else if type != held
        frame.diagnose(written, .stated, program.store-atom("Style property \"${name.text}\" has conflicting types in visible styles ${type-short-name(types, owner)} and ${type-short-name(types, level)}"))
        = invalid-type
= found

────────────────────
_ do declared-style-property (TypeId, TypeId)
    - used TypeId
    - name Atom

` The style that declares a property of a name, the one given or one above it, and the type it
` gives the property; none where none does.
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    if names-own-style-property(level, name)
        . place = types.property-named(level, name)
        if !place
            = (level, invalid-type)
        . property = types.properties[place]
        . declared = if typed then property.type else demand-member(property, level, name)
            .. typed = property.type != no-type
        = (level, declared)
    level = types.base-of(level)
= (no-type, no-type)

────────────────────
_ do names-own-style-property Bool
    - level TypeId
    - name Atom

` Whether a style itself, and not one above it, declares a property of a name.
. ref = class-ref(types, level)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name && plain-member
                        = true
                    .. plain-member = !property.defaults-root && property.element == 0
= false

────────────────────
_ do find-style-property (U32, U32)
    - styles [TypeId]
    - name Atom
    - site SyntaxId

` The number of the style of a vocabulary whose property of a name answers it, and the
` property's place in `style-properties`: the first style that declares one, as the reference
` resolves it, numbered as it is first used, where all that do give it one type
` (`first-answering`). Both are `U32.max` where no style declares one, and the place alone where
` the property is declined or reported.
. found = style-answering(styles, name)
if found == invalid-type
    found = first-answering(styles, name, site)
if found == invalid-type
    = (0, U32.max)
if found == no-type
    = (U32.max, U32.max)
. index = style-index(found, site, false)
if index == U32.max
    = (0, U32.max)
. use = facts.style-uses[index]
for position in use.first .. < use.first + use.count
    if facts.style-properties[position].name == name
        = (index, position)
decline(site)
= (0, U32.max)

────────────────────
_ do declare-styles Bool
    - id SyntaxId
    - made TypeId
    - body SyntaxId
    - first U32

` Types the attributes of a markup element that name a property of a style the element sees,
` its vocabulary, not one of its class: each declares the property's value for the object at
` the element's site, as the reference declares it after the constructor and before the
` properties are stored, in the order written, at the layer `markup-layer` says. The value is
` converted to the property's type as one assigned is. A name no style answers is the
` reference's error. A value that reads something tracked is declared again as it changes by a
` live action of the object's association with the site (`settle-attributes`). `inherit` takes
` the value from the parent (`declare-inherit`). A value the runtime holds a handle to is held
` by a holder of its own (`style-value-ready`), or where it reads nothing that differs from one
` making to the next, evaluated once for every making (`note-static-value`). A name alone that
` names a slot of a style sheet the element sees declares that slot (`declare-sheet-slot`).
` Their orders follow the `first` the rules the element applies took.
` The element is a site where any of them declares, where it applies a shared rule that
` declares nothing (`empty-shared`), which the reference calls at a site all the same.
. order = first
. sited = empty-shared
empty-shared = false
if body == 0 || !(tree.nodes[body] is .node-block)
    if order != 0 || sited
        facts.style-sites += StyleSite(instance, module, id)
    = true
. layer = markup-layer()
. styles [TypeId]? = null
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    . name = style-name(tree, attribute.lhs)
                    if !styles-attribute(attribute.op, made, name)
                        continue
                    if !styles
                        styles = style-vocabulary(made, statement)
                        if !styles
                            = false
                    . (index, position) = find-style-property(styles, name!, statement)
                    if position == U32.max
                        if index == U32.max
                            frame.diagnose
                                - attribute.lhs
                                - .stated
                                - program.store-atom("Property not found")
                        = false
                    . property = facts.style-properties[position]
                    if is-inherit(attribute.rhs)
                        if layer == U32.max
                            decline(statement)
                            = false
                        if !declare-inherit(statement, id, index, position, layer, order)
                            = false
                        order += 1
                        continue
                    . sheeted = declare-sheet-slot
                        - statement
                        - id
                        - index
                        - position
                        - layer
                        - order
                        - attribute.rhs
                        - made
                    if sheeted == 2
                        = false
                    if sheeted == 1
                        order += 1
                        continue
                    if !style-value-ready(property.type)
                        decline(statement)
                        = false
                    . scope = enter-theme(made, no-type, statement)
                    . written = style-value(attribute.rhs, property.type)
                    . themed = leave-theme(scope)
                    if written == invalid-type || written == no-type
                        = false
                    if conversions.convert(statement, attribute.rhs, written, property.type, .reason-assignment) == invalid-type
                        = false
                    if layer == U32.max || !demand-style-sites() || (is-live-statement(statement) && !demand-style-authors(made))
                        decline(statement)
                        = false
                    if themed != U32.max
                        if !declare-themed(statement, id, index, position, layer, order, attribute.rhs, themed)
                            = false
                        order += 1
                        continue
                    . fixed = fixed-style-value(attribute.rhs)
                    . cached = cacheable && declaration-static(attribute.rhs)
                        .. cacheable = !is-live-statement(statement) && holds-handle(property.type)
                    if cached
                        note-static-value(statement, property.type)
                    facts.add-style-declaration
                        - StyleDeclaration
                            - instance
                            - id
                            - statement
                            - facts.style-uses[index].type
                            - position
                            - layer
                            - order
                            - fixed
                            - false
                            - cached
                    order += 1
if order != 0 || sited
    facts.style-sites += StyleSite(instance, module, id)
= true

────────────────────
_ do apply-style-rules U32
    - id SyntaxId
    - made TypeId
    - row ASTMarkup

` The style rules a markup element applies, as the reference applies them once the object is
` made: first those that take no values whose name a class of the element, the type written
` or the element's id spelled as a selector matches (`implicit-names`), then those written
` after `•`, in order. Each is the rule the element's class, or the nearest class above it,
` writes by that name with no values; where none does, nothing is applied. Each is typed once
` for the class that writes it (`check-style-unit`) and declares at the rule layer, from the
` order the one before it ended at, with the rules it applies itself (`apply-rule`). Answers
` how many declarations they make, or `U32.max` where one is declined or reported. Rules
` apply without `core/style`, as their lines may set properties of the class. A rule matched
` by name that the reference makes a function shared by every element it matches
` (`shares-rule`) is marked `shared`. The values a written one is given are typed as they are
` written, with nothing expected, and the rule is chosen by them (`match-style-rule`); each is
` converted at its node to the type the rule takes it as. A written name some rule of the
` chain has but none takes such values by is the reference's `Type mismatch`. A written one with
` a condition is applied under it (`applied-gate`). Declined: a shared rule that declares
` nothing, which the reference makes a site for anyway, a name a rule written in a rule may
` answer (`overlay-rule`), and a
` rule whose properties the element's vocabulary answers with other styles than its class's
` does. Where no class of the chain answers a name, the style sheets the element sees may
` (`sheet-rules`), each group's rule applied in turn, lowest first. After those, each rule
` written in a rule that the element sees and that answers the name is applied over them
` (`scope-rules`), those the element's own rules applied before bring into view among them. The
` rules written in rules that its rules bring into view must be those the element was made
` seeing (`gather-scopes`), or it is declined.
if types.intrinsic-of(made) != .class
    if row.style-rule-applications.count != 0
        decline(id)
        = U32.max
    = 0
. styled = program.module-by-name("core/style") != null
. order U32
element-scopes.clear()
empty-shared = false
for name in implicit-names(made, row.type-id, row.id, tree)
    . atom = program.store-atom(name)
    if overlay-rule(atom)
        decline(id)
        = U32.max
    collecting = true
    collected.clear()
    order = apply-implicit(id, made, row.type-id, atom, order, styled)
    collecting = false
    if order == U32.max
        = U32.max
    for use in collected
        element-scopes += use
order = apply-written-rules(id, made, row.style-rule-applications, order, no-instance, true)
if order != U32.max && !same-scopes(id)
    decline(id)
    order = U32.max
element-scopes.clear()
= order

────────────────────
_ do apply-implicit U32
    - id SyntaxId
    - made TypeId
    - type-id SyntaxId
    - name Atom
    - order U32
    - styled Bool

` Applies the style rules taking no values that a markup element matches by a name, as
` `apply-style-rules` says. A rule of a style sheet the element's chain uses that a class of the
` chain matches by its name is one of that class's defaults, applied where the object is made
` (`apply-themed-defaults`), and not here (`themes-class`); the rules written in it still come
` into view for the element's body, as the element gathered them (`gather-rule`). Answers the
` order the next rule takes, or `U32.max`.
. next = order
. (level, member, named) = class-style-rule(made, name)
. none [TypeId]
if level != no-type
    next = apply-named(id, made, rule-unit(level, member, made, id), next, styled)
    if next == U32.max
        = U32.max
else
    . sheets [TypeId]
    . members [DeclRef]
    . gates [U64]
    . (status, writes, missed) = sheet-rules(made, name, none, written-name(type-id, name), sheets, members, gates, U32.max)
    if status == 1
        decline(id)
    if status != 0
        = U32.max
    for position in 0 .. < sheets.length
        if themes-class(made, name, sheets[position])
            . brought [ScopeUse]
            if !gather-rule(made, members[position].module, members[position].decl, sheets[position], U32.max, U32.max, element-scopes, id, made, brought, 0, U32.max, U32.max)
                decline(id)
                = U32.max
            for use in brought
                collected += use
            continue
        . unit = rule-unit(sheets[position], members[position], made, id)
        . first = facts.style-applications.length
        next = apply-named(id, made, unit, next, styled)
        if failed || !gate-applications(first as U32, sheets[position], gates[position], id)
            = U32.max
        .. failed = next == U32.max
. scoped [ScopeUse]
. (scoping, found, missed) = scope-rules(made, name, none, element-scopes, scoped, U32.max)
if scoping == 1
    decline(id)
if scoping != 0
    = U32.max
for use in scoped
    next = apply-named
        - id
        - made
        - scope-unit(use.scope, made)
        - next
        - styled
        - use.scope.frames
        - use.cell
        - use.values
        - use.outer-cells
    if next == U32.max
        = U32.max
= next

────────────────────
_ do themes-class Bool
    - made TypeId
    - name Atom
    - sheet TypeId

` Whether `sheet`, which writes a rule of `name`, is a style sheet the chain of a markup element's
` class uses (`add-sheet-groups`) and a class of the chain has the name, so that the rule is one
` of that class's defaults (`apply-themed-defaults`).
. own [TypeId]
. levels [U32]
add-sheet-groups(made, own, levels)
=? false if own.find(family-root(sheet)) == null
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            if program.store-atom(class.name.text) == name
                = true
    level = types.base-of(level)
= false

────────────────────
_ do apply-written-rules U32
    - id SyntaxId
    - made TypeId
    - applications RowRange'SyntaxId
    - first U32
    - values InstanceId = no-instance
    - gates Bool = false

` The style rules written after `•` that a markup element, or a slot outlet for what it mounts,
` applies, in order, from the order `first`, as `apply-style-rules` says, each bringing into view
` the rules written in the rules it applies (`element-scopes`). The values an application gives
` are typed here, but where the element typed them as it gathered what they bring
` (`gather-scopes`), or by the instance `values` where one types them (`check-root-values`),
` which converts them too. Where an element `gates` what its rules declare, a rule written with a
` condition is applied under it (`applied-gate`) once a rule answers its name; elsewhere it is
` declined. Answers the order the next declaration takes, or `U32.max`.
. order = first
for application in tree.children[applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if (conditional && (!gates || values != no-instance)) || overlay-rule(applied.name)
                decline(application)
                = U32.max
            .. conditional = applied.condition != 0
            . given [TypeId]
            for value in tree.children[applied.args]
                . held = if values != no-instance then values else instance
                . scope = enter-theme
                    - if values == no-instance then made else no-type
                    - no-type
                    - application
                . type = if answered then facts.answer-type(held, value) else infer(value)
                    .. answered = values != no-instance || pretyped.find(value) != null
                leave-theme(scope)
                if type == invalid-type || type == no-type
                    if values != no-instance
                        decline(application)
                    = U32.max
                given += type
            . levels [TypeId]
            . members [DeclRef]
            . gates [U64]
            . scoped [ScopeUse]
            if !choose-written-rule(made, application, given, levels, members, gates, scoped)
                = U32.max
            . gate [StyleWhen]
            if applied.condition != 0 && levels.length + scoped.length != 0
                . held = applied-gate(applied.condition, made)
                if !held
                    = U32.max
                gate += held
            collecting = true
            collected.clear()
            for chosen in 0 .. < levels.length + scoped.length
                . unit = if chosen < levels.length then rule-unit(levels[chosen], members[chosen], made, application) else scope-unit(scoped[chosen - levels.length].scope, made)
                if unit == no-instance || !answers-alike(unit, made, application)
                    collecting = false
                    decline(application)
                    = U32.max
                . wanted = if chosen < levels.length then rule-argument-types(members[chosen]) ?? scope-argument-types(scoped[chosen - levels.length].scope) else scope-argument-types(scoped[chosen - levels.length].scope)
                for position in 0 .. < given.length
                    . value = tree.children[applied.args.start + position]
                    if values == no-instance && chosen == 0 && conversions.convert(value, value, given[position], wanted![position], .reason-argument) == invalid-type
                        collecting = false
                        = U32.max
                . active [InstanceId]
                . applied [InstanceId]
                . gated [StyleWhen]
                for held in gate
                    gated += held
                . frames = if chosen >= levels.length then scoped-frames else U32.max
                    .. scoped-frames = scoped[chosen - levels.length].scope.frames
                . cell = if chosen >= levels.length then scoped-cell else U32.max
                    .. scoped-cell = scoped[chosen - levels.length].cell
                . around = if chosen >= levels.length then scoped-values else U32.max
                    .. scoped-values = scoped[chosen - levels.length].values
                . links = if chosen >= levels.length then scoped-links else U32.max
                    .. scoped-links = scoped[chosen - levels.length].outer-cells
                . recorded = facts.style-applications.length
                order = apply-rule
                    - id
                    - made
                    - unit
                    - order
                    - application
                    - U32.max
                    - 0
                    - gated
                    - active
                    - applied
                    - frames
                    - cell
                    - around
                    - values == no-instance && given.length != 0
                    - links
                if order == U32.max
                    collecting = false
                    = U32.max
                facts.style-applications[recorded].values = values
                revise-application(recorded as U32)
                if chosen < levels.length && !gate-applications(recorded as U32, levels[chosen], gates[chosen], application)
                    collecting = false
                    = U32.max
                if values == no-instance && given.length != 0
                    share-written-values(recorded as U32, tree, frame.binding)
                    if !bind-given-slots(recorded as U32, application, unit, module, instance)
                        collecting = false
                        = U32.max
            collecting = false
            for use in collected
                element-scopes += use
= order

────────────────────
_ do applied-gate StyleWhen?
    - condition SyntaxId
    - made TypeId

` The condition a style rule written after `•` on a markup element is applied under, which gates
` what the rule declares and the rules it applies, as the reference's `compileStyleGatedBlock`
` gates them: a name or a member read tracked, or the latest value of one, as the reference
` reports, of type `Bool`, tested where each gate is made and again by the function written for
` it (`check-gate-test`). The gate it makes alone is recorded once (`StyleGate`). None where it
` is reported or declined.
if !tree.is-condition-reference(condition)
    frame.diagnose(condition, .stated, program.store-atom("Style rule conditions must be a tracked boolean property reference (like #is-disabled)"))
    = null
. type = infer(condition)
if type == invalid-type
    = null
if type != types.bool-type
    frame.diagnose(condition, .stated, program.store-atom("Style rule conditions must be Bool, but this condition is ${type-display(types, type)}"), type)
    = null
. decl = nested-decl-of(condition)
. test = if decl != 0 then demand-lambda(intern-nested(decl), scratch.no-types) else no-instance
if test == no-instance || instances.signatures[test].errors.count != 0
    decline(condition)
    = null
facts.live-statements += LiveStatement(instance, condition, test)
instances.mark-may-panic(instance)
. action = demand-style-gates(made)
if action == no-instance || instances.live.track == no-instance
    decline(condition)
    = null
. held = StyleWhen(module, condition, U32.max, test)
. whens [StyleWhen]
whens += held
record-gate(made, whens, action)
= held

────────────────────
_ do choose-written-rule Bool
    - made TypeId
    - application SyntaxId
    - given [TypeId]
    - levels [TypeId]
    - members [DeclRef]
    - gates [U64]
    - scoped [ScopeUse]

` The rules a style rule written after `•` applies by its name, for an object of the class `made`
` and the types of the values it gives: the one the class's chain chooses, as the reference's
` `resolveMatch` does, or else those the style sheets in view choose, each with the class that
` writes it, in `levels` and `members`; then those of the rules written in rules in view
` (`element-scopes`) in `scoped`. A name that some rule takes but none for those values is the
` reference's error; more than one rule given values, a rule that matches ambiguously, and a
` choice the sheets or the rules in view cannot make here are declined. False where one is.
do match? tree.nodes[application]
    | .node-style-rule-application(applied)
        . (level, member, taken, mismatch) = match-style-rule(made, applied.name, given)
        if level == invalid-type
            if !report-argument-types(member)
                decline(application)
            = false
        . named = taken
        . missed = mismatch
        if level != no-type
            levels += level
            members += member
            gates += U64.max
        else
            . (status, writes, last) = sheet-rules(made, applied.name, given, application, levels, members, gates, mismatch)
            if status == 1
                decline(application)
            if status != 0
                = false
            named = named || writes
            missed = last
        . (scoping, found, place-missed) = scope-rules(made, applied.name, given, element-scopes, scoped, missed)
        if scoping == 1
            decline(application)
        if scoping != 0
            = false
        if levels.length == 0 && scoped.length == 0 && (named || found)
            . place = if place-missed != U32.max then missed-value else application
                .. missed-value = tree.children[applied.args.start + place-missed]
            frame.diagnose(place, .stated, program.store-atom("Type mismatch"))
            = false
        if several && given.length != 0 && (scoped.length != 0 || !variants-alike(levels, members))
            decline(application)
            = false
        .. several = levels.length + scoped.length > 1
        = true
decline(application)
= false

────────────────────
_ do variants-alike Bool
    - levels [TypeId]
    - members [DeclRef]

. wanted = rule-argument-types(members[0])
=? false if !wanted
for position in 1 .. < levels.length
    if family-root(levels[position]) != family-root(levels[0])
        = false
    . other = rule-argument-types(members[position])
    if !other || other.length != wanted.length
        = false
    for place in 0 .. < wanted.length
        if other[place] != wanted[place]
            = false
= true

────────────────────
_ do check-root-values

` Types the values a style rule applied on the root `<This` of a class's markup is given
` (`Instance.root-values`), for the class whose constructor applies the rule, as the reference's
` constructor evaluates them there: each typed with nothing expected, the rule chosen for them
` under the styles and style sheets of the instance's context as the constructor chooses it
` (`choose-written-rule`), and each converted at its node to the type that rule takes it as. It
` answers nothing.
prepare()
. receiver = instances.rows[instance].self-type
. application = instances.rows[instance].root-values
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, class-ref(types, receiver).decl)))
. context = instances.rows[instance].context
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
    for position in held.scope-first .. < held.scope-first + held.scopes
        if instances.context-cells[position] == 0 && instances.context-valued[position] == U32.max
            rule-scopes += ScopeUse(instances.context-scopes[position])
do match? tree.nodes[application]
    | .node-style-rule-application(applied)
        . given [TypeId]
        . typed = true
        for value in tree.children[applied.args]
            . type = infer(value)
            if type == invalid-type || type == no-type
                typed = false
                break
            given += type
        . levels [TypeId]
        . members [DeclRef]
        . gates [U64]
        . scoped [ScopeUse]
        if typed && choose-written-rule(receiver, application, given, levels, members, gates, scoped) && levels.length + scoped.length != 0
            . wanted = if levels.length != 0 then rule-argument-types(members[0]) ?? scope-argument-types(scoped[0].scope) else scope-argument-types(scoped[0].scope)
            for position in 0 .. < given.length
                . value = tree.children[applied.args.start + position]
                conversions.convert
                    - value
                    - value
                    - given[position]
                    - wanted![position]
                    - .reason-argument
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do written-name SyntaxId
    - type-id SyntaxId
    - name Atom

` The type a markup element is written with where it is spelled as a style rule's name, at which
` the reference reports an error of the rule it applies by that name; or none.
do match? tree.nodes[written-base(tree, type-id)]
    | .node-type-identifier(written)
        if !written.is-declare && written.name == name
            = written-base(tree, type-id)
= 0

────────────────────
_ do apply-named U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - order U32
    - styled Bool
    - frames U32 = U32.max
    - cell U32 = U32.max
    - values U32 = U32.max
    - outer-cells U32 = U32.max

` Applies a style rule taking no values that a markup element matches by name, written by a
` class of its chain, a style sheet it sees or a rule within the `frames`, state cells and `values`
` given, typed by the
` instance `unit`, from an order, as `apply-style-rules` says, marked `shared` where the
` reference makes it a function (`shares-rule`): one with no rules around it, which matches no
` rule that has any as it applies its own. One that declares nothing makes the element a site
` all the same (`empty-shared`). Answers the order the next rule takes, or `U32.max`.
if unit == no-instance || !answers-alike(unit, made, id)
    decline(id)
    = U32.max
. active [InstanceId]
. applied [InstanceId]
. ungated [StyleWhen]
. first = facts.style-applications.length
. framing = framed
. next = apply-rule
    - id
    - made
    - unit
    - order
    - 0
    - U32.max
    - 0
    - ungated
    - active
    - applied
    - frames
    - cell
    - values
    - false
    - outer-cells
if next == U32.max
    = U32.max
if styled && frames == U32.max && framed == framing && shares-rule(applied, next - order)
    if next == order
        empty-shared = true
    facts.style-applications[first].shared = true
    revise-application(first as U32)
    facts.style-applications[first].made = made
    revise-application(first as U32)
    facts.style-applications[first].span = next - order
    revise-application(first as U32)
= next

────────────────────
_ do sheet-rules (U32, Bool, U32)
    - made TypeId
    - name Atom
    - given [TypeId]
    - at SyntaxId
    - matched [TypeId]
    - members [DeclRef]
    - gates [U64]
    - mismatch U32
    - own Bool = false
    - chained Bool = false

` The rules of the style sheets a markup element of a class sees that an application of a name
` answers, where no class of its chain does, as the reference's `resolveMatch` adds them: in
` each group, lowest first, the rule of each sheet that takes the values given most closely
` (`match-rules-of`), and of those the one that takes them most closely, two alike being the
` reference's error at `at`, or declined where `at` is none, and one whose types are written
` wrong reported where it is written (`report-argument-types`). Each group's applies, the lowest
` first. Answers 0, 1 where it is to be declined and 2 where it is reported; whether a sheet
` it looks at writes a rule of the name; and the place of the last value found not to convert.
` Where the sheets the markup sees are not known here (`sheets-known`), a name a rule of any
` sheet has is declined. With `own`, the sheets are those the class uses alone, as a rule the
` class writes chooses for the values it gives the rules it applies. With `chained`, they are
` those the class's chain uses and their variants, as the defaults of a class find the rules of
` its name (`apply-themed-defaults`).
if !sheet-rule-name(name)
    = (0, false, mismatch)
if !own && !chained && !sheets-known()
    = (1, false, mismatch)
. sheets [TypeId]
. levels [U32]
if own || chained
    add-sheet-groups(made, sheets, levels)
else
    visible-sheets(made, sheets, levels)
. named = false
. missed = mismatch
. top = if levels.length != 0 then levels[levels.length - 1] + 1 else 0u32
for group in 0 .. < top
    . best = no-type
    . best-kind = 0u32
    . tied = no-type
    . chosen-sheets [TypeId]
    . chosen-rules [DeclRef]
    . chosen-gates [U64]
    for place in 0 .. < sheets.length
        if levels[place] != group
            continue
        . family = family-members(sheets[place], own)
        if family.length > 64
            = (1, named, missed)
        . found-sheets [TypeId]
        . found-rules [DeclRef]
        . found-gates [U64]
        . (found, kind, writes, last) = family-rules(family, name, given, missed, found-sheets, found-rules, found-gates)
        if writes
            named = true
        missed = last
        if found && kind == U32.max
            = (if report-argument-types(found-rules[0]) then 2u32 else 1u32, named, missed)
        if !found
            continue
        if best == no-type || kind > best-kind
            best = sheets[place]
            best-kind = kind
            tied = no-type
            chosen-sheets = found-sheets
            chosen-rules = found-rules
            chosen-gates = found-gates
        else if kind == best-kind && tied == no-type
            tied = sheets[place]
    if tied != no-type
        if at == 0
            = (1, named, missed)
        . text = "Style rule \"${name.text}\" is ambiguous between visible style sheets ${type-short-name(types, best)} and ${type-short-name(types, tied)}"
        frame.diagnose(at, .stated, program.store-atom(text))
        facts.inset-diagnostic(0, name.text.length as U32)
        = (2, named, missed)
    for position in 0 .. < chosen-sheets.length
        matched += chosen-sheets[position]
        members += chosen-rules[position]
        gates += chosen-gates[position]
= (0, named, missed)

────────────────────
_ do family-members [TypeId]
    - root TypeId
    - alone Bool = false

. family [TypeId]
family += root
=? family if alone
list-derived-sheets()
for derived in facts.derived-sheets
    if family-root(derived) == root
        family += derived
= family

────────────────────
_ do family-rules (Bool, U32, Bool, U32)
    - family [TypeId]
    - name Atom
    - given [TypeId]
    - mismatch U32
    - sheets [TypeId]
    - rules [DeclRef]
    - gates [U64]

if family.length == 1
    . (held, rule, kind, writes, last) = match-rules-of(family[0], name, given, mismatch)
    if held
        sheets += family[0]
        rules += rule
        gates += U64.max
    = (held, kind, writes, last)
. found [Bool]
. chosen [DeclRef]
. kinds [U32]
. named = false
. missed = mismatch
for sheet in family
    . (held, rule, kind, writes, last) = match-rules-of(sheet, name, given, missed)
    named = named || writes
    missed = last
    if held && kind == U32.max
        rules += rule
        = (true, U32.max, named, missed)
    found += held
    chosen += rule
    kinds += kind
. picks [U32]
for position in 0 .. < family.length
    . pick = U32.max
    . level = family[position]
    while true
        . place = family.find(level)
        if place && found[place] && (pick == U32.max || kinds[place] > kinds[pick])
            pick = place as U32
        if level == family[0]
            break
        level = types.base-of(level) ?? family[0]
    picks += pick
. full = if family.length == 64 then U64.max else (1u64 /lshift/ family.length) - 1
. any = false
. best = 0u32
for place in 0 .. < family.length
    . mask = 0u64
    for position in 0 .. < picks.length
        if picks[position] == place as U32
            mask = mask /or/ (1u64 /lshift/ position)
    if mask == 0
        continue
    sheets += family[place]
    rules += chosen[place]
    gates += if mask == full then U64.max else mask
    if !any || kinds[place] > best
        best = kinds[place]
    any = true
= (any, best, named, missed)

────────────────────
_ do gate-applications Bool
    - first U32
    - sheet TypeId
    - mask U64
    - at SyntaxId

=? true if mask == U64.max
. family = sheet-index(family-root(sheet), module, at, at)
if family == U32.max || !demand-family-runtime()
    decline(at)
    = false
facts.family-gates += 1
for index in first .. < (facts.style-applications.length as U32)
    . held = facts.style-applications[index]
    if held.family != U32.max && held.family != family
        decline(at)
        = false
    facts.style-applications[index].family = family
    revise-application(index)
    facts.style-applications[index].members = if held.family == family then masked else mask
        .. masked = held.members /and/ mask
    revise-application(index)
= true

────────────────────
_ do apply-rule U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - order U32
    - written SyntaxId
    - outer U32
    - within SyntaxId
    - gated [StyleWhen]
    - active [InstanceId]
    - applied [InstanceId]
    - frames U32 = U32.max
    - cell U32 = U32.max
    - values U32 = U32.max
    - gives Bool = false
    - outer-cells U32 = U32.max

` Records a style rule applied to a markup element at the rule layer from an order, with the
` rules it applies itself, as the reference applies them: each name the rule writes after its
` own, then each the body of each of its `when`s does, is resolved for the element's class as
` a name the element writes is, and applied in turn, recorded after this one with this one as
` its `outer` and the `when` as its `within`. The values the rule gives one were typed and
` converted with the rule (`type-applied-values`), for the rule its own class chooses, which
` must be the one the element's class does. `gated` holds the `when`s the rule is applied
` under, the outermost first, which gate its declarations as `gate-when` says; a rule so gated
` that sets a property of its class is the reference's error. Answers the order the next rule
` takes, or `U32.max` where one is declined or reported. A rule that comes to apply itself
` again is the reference's error, at the application that would. `active` holds the rules
` being applied, the outermost first, and `applied` gathers each rule applied. A rule with a
` declaration whose value reads something tracked is given the constructor of the action of
` the style runtime that declares it again for the element's object, and one with a line that
` sets a property of its class again the function that makes that line's live action, chosen
` where the rule is applied, as `owner-action` chooses one for an attribute. A line of a rule a
` class writes whose value names a slot of a style sheet takes the slot the element sees
` (`bind-rule-slots`). The rules applied around the rule are `frames`; with the rule they are
` those around the rules it applies after its name, and around the rules written in it, which it
` brings into view after those (`bring-scopes`). A rule written in the body of a `when` is
` applied under the state cell of the `when` (`cell`), and those of the `when`s further out
` (`outer-cells`), first of all the `when`s that gate it, unless they hold them already
` (`cell-whens`). The content its lines generate follows its own
` declarations, and that of each `when` its declarations, each taking an order
` (`generate-content`). A rule written in a rule reads the `values` of the rule around it that
` takes some; one the element `gives` values holds them for the rules written in it
` (`scope-values`), but not within another that does.
. row = instances.rows[unit]
. owner = program.modules[row.module]
. index = facts.style-applications.length as U32
facts.style-applications += StyleApplication
    - instance
    - module
    - id
    - unit
    - 2
    - order
    - written
    - outer
    - within
facts.style-applications[index].around-values = values
revise-application(index)
if types.intrinsic-of(row.self-type) == .class && !bind-rule-slots(id, made, unit, index)
    = U32.max
. whens = cell-whens(id, made, gated, cell, outer-cells, index)
if !whens
    = U32.max
. gates = whens
if facts.authors-in(unit)
    . action = demand-style-gates(made)
    if action == no-instance
        decline(id)
        = U32.max
    facts.style-applications[index].action = action
    revise-application(index)
if written != 0
    . (live, local) = values-live(written, outer)
    if live && local
        decline(id)
        = U32.max
    if live
        facts.style-applications[index].live-values = true
        revise-application(index)
    if live && facts.updates-given(unit)
        demand-live-runtime()
    if live && facts.reads-given-in(unit)
        . action = demand-style-gates(made)
        if action == no-instance || !demand-style-authors(made)
            decline(id)
            = U32.max
        facts.style-applications[index].action = action
        revise-application(index)
if !choose-updater(index, id, made)
    = U32.max
. next = order
active += unit
applied += unit
if gates.length != 0 && !gates-updates(unit)
    = U32.max
. around = instances.intern-frame(frames, row.module, row.initializer, row.self-type, 0)
. framed = values
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                if gives && holds-rules(owner.tree, rule.syntax)
                    if values != U32.max
                        decline(id)
                        = U32.max
                    framed = scope-values(written, around)
                for nested in owner.tree.children[declared.style-rule-applications]
                    next = apply-inner
                        - id
                        - made
                        - unit
                        - nested
                        - next
                        - index
                        - 0
                        - gates
                        - active
                        - applied
                        - around
                        - cell
                        - framed
                        - outer-cells
                    if next == U32.max
                        = U32.max
                if !declares-only(unit, declared.body, gates)
                    = U32.max
                if !bring-scopes(id, made, unit, around, gates, cell, framed, outer-cells)
                    = U32.max
                . generated = generate-content
                    - id
                    - made
                    - unit
                    - index
                    - rule-content(owner.tree, declared.body)
                    - gates
                if generated == U32.max
                    = U32.max
                next += generated
                for branch in rule-whens(owner.tree, declared.body)
                    . inner = gate-when(id, made, row.module, branch, gates)
                    if !inner
                        = U32.max
                    for nested in when-applications(owner.tree, branch)
                        next = apply-inner
                            - id
                            - made
                            - unit
                            - nested
                            - next
                            - index
                            - branch
                            - inner
                            - active
                            - applied
                            - U32.max
                        if next == U32.max
                            = U32.max
                    . gated-content = generate-content
                        - id
                        - made
                        - unit
                        - index
                        - when-content(owner.tree, branch)
                        - inner
                    if gated-content == U32.max
                        = U32.max
                    next += gated-content
active.pop()
= next + facts.style-declaration-count(unit)

────────────────────
_ do values-live (Bool, Bool)
    - written SyntaxId
    - outer U32

` Whether the values an application written after `•` gives read something tracked, or, for one
` a style rule applies, a value of the rule around it whose application has `live-values`: each
` declaration of the rule that reads them is declared again as they change. Then whether those
` of a markup element read a local of the function the element is written in, which the function
` that declares them again does not keep, so that the application is declined where they are live.
. around = outer != U32.max
. unit = if around then facts.style-applications[outer].unit else no-instance
. written-tree = if around then program.modules[instances.rows[unit].module].tree else tree
. binding = if around then instances.rows[unit].binding else frame.binding
. rooted = !around && roots-values(written-tree, written)
. live = false
. local = false
do match? written-tree.nodes[written]
    | .node-style-rule-application(applied)
        for value in written-tree.children[applied.args]
            for node in written-tree.subtree-start(value) .. value
                do match? written-tree.nodes[node]
                    | .node-get-expression(row)
                        live = live || row.is-tracked
                    | .node-identifier(row)
                        live = live || row.is-tracked
                        if !rooted
                            . resolution = bindings.resolution-of(binding, node)
                            if resolution.kind == .resolve-slot && not-this
                                if around
                                    live = live || facts.style-applications[outer].live-values
                                else if facts.row-item-of(instance, node) != no-type
                                    live = true
                                else
                                    local = true
                            .. not-this = bindings.slots[resolution.slot].kind != .slot-this
= (live, local)

────────────────────
_ do roots-values Bool
    - written AST
    - application SyntaxId

` Whether an application written after `•` is written on the root `<This` of a class's markup,
` whose values an instance of their own types (`check-root-values`).
do match? written.nodes[written.holder-of(application)]
    | .node-markup(row)
        = written.names-this(row.type-id)
= false

────────────────────
_ do declares-only Bool
    - unit InstanceId
    - body SyntaxId
    - gates [StyleWhen]

` Whether a style rule applied under the condition a rule written on a markup element gives
` declares styles alone, as the reference requires of a rule so applied: its error is at the
` first line of its body that is no declaration, `when`, rule or generated content, or else at
` the first rule written in its body, or else in the body of one of its `when`s. True where no
` such condition gates it.
. conditioned = false
for held in gates
    conditioned = conditioned || held.test != no-instance
if !conditioned || body == 0
    = true
. row = instances.rows[unit]
. written = program.modules[row.module].tree
. lines [SyntaxId]
do match? written.nodes[body]
    | .node-block(block)
        for line in written.children[block.body]
            lines += line
    ??
        lines += body
. found SyntaxId = 0
for line in lines
    . kind = written.nodes[line]
    if found == 0 && undeclared && !(kind is .node-rule-syntax) && !generates(written, line)
        found = line
    .. undeclared = !(kind is .node-assign) && !(kind is .node-style-when)
for line in lines
    if found == 0 && written.nodes[line] is .node-rule-syntax
        found = line
for branch in rule-whens(written, body)
    for line in when-lines(written, branch)
        if found == 0 && written.nodes[line] is .node-rule-syntax
            found = line
if found == 0
    = true
facts.record-diagnostic
    - instance
    - row.module
    - found
    - .stated
    - program.store-atom("Conditionally applied style rules may only contain style declarations")
    - no-type
    - no-type
= false

────────────────────
_ do holds-rules Bool
    - written AST
    - rule SyntaxId

` Whether a style rule applies rules after its name or holds rules written in it, in its body or
` in that of one of its `when`s.
do match? written.nodes[rule]
    | .node-rule-syntax(declared)
        if declared.style-rule-applications.count != 0
            = true
        . body = declared.body
        do match? written.nodes[body]
            | .node-block(block)
                for statement in written.children[block.body]
                    if written.nodes[statement] is .node-rule-syntax
                        = true
        for branch in rule-whens(written, body)
            for line in when-lines(written, branch)
                if written.nodes[line] is .node-rule-syntax
                    = true
= false

────────────────────
_ do apply-inner U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - nested SyntaxId
    - order U32
    - outer U32
    - within SyntaxId
    - gated [StyleWhen]
    - active [InstanceId]
    - applied [InstanceId]
    - around U32
    - cell U32 = U32.max
    - values U32 = U32.max
    - outer-cells U32 = U32.max

` Applies a rule a style rule applies, written at `nested` in the rule's module, from an order,
` as `apply-rule` says, those of the style sheets the element sees where no class of its chain
` answers the name (`sheet-rules`), within the rules applied `around` it, the state cells of the
` `when`s among them and the values of the one that takes some, and then those written in rules
` that the markup sees (`scope-rules`), each within its own. Declined: one with a
` condition, one a rule written in a rule may answer where those are not known, or that the
` rules the element applied before bring into view, which the reference sees as it gathers them
` but not as it applies them; a name some class or style sheet has but none takes the values
` given by, values given to rules of style sheets other than the one the rule's class chose for
` them (`sheet-values-alike`) or to a rule written in a rule, and a value that calls a function where
` the reference evaluates it once more but not here: it evaluates those the rules after the name
` of a rule a markup element applies give as it prepares the element, and again as the rule is
` applied, and the emitter does too (`prepared-rule`, marked on the rule's application). A
` constructor applying its rule `• This` or the rules of its root `<This` (`values-once`)
` evaluates them once.
. row = instances.rows[unit]
. owner = program.modules[row.module]
do match? owner.tree.nodes[nested]
    | .node-style-rule-application(inner)
        if conditional || overlay-rule(inner.name) || names-scope(element-scopes, inner.name)
            decline(id)
            = U32.max
        .. conditional = inner.condition != 0
        . given [TypeId]
        . evaluated = false
        for value in owner.tree.children[inner.args]
            . type = facts.node-type(unit, value)
            . runs = !preparing.values-once && runs-code(unit, owner.tree, value)
            if untyped || (runs && !prepared-rule(id, outer, within))
                decline(id)
                = U32.max
            .. untyped = type == no-type || type == invalid-type
            evaluated = evaluated || runs
            given += type
        . (level, member, taken, mismatch) = match-style-rule(made, inner.name, given)
        if level == invalid-type && report-argument-types(member)
            = U32.max
        . scoped [ScopeUse]
        . none [ScopeUse]
        . (scoping, found, missed) = scope-rules(made, inner.name, given, none, scoped, U32.max)
        if scoping == 2
            = U32.max
        if scoping != 0 || level == invalid-type || unscoped || scoped-given
            decline(id)
            = U32.max
        .. unscoped = taken && level == no-type && scoped.length == 0
        .. scoped-given = scoped.length != 0 && given.length != 0
        . next = order
        if level == no-type
            . sheets [TypeId]
            . members [DeclRef]
            . gates [U64]
            . (status, writes, last) = sheet-rules(made, inner.name, given, 0, sheets, members, gates, U32.max)
            if status != 0 || (given.length != 0 && (if sheets.length == 0 then writes else !sheet-values-alike(row.self-type, inner.name, given, sheets, members)))
                decline(id)
                = U32.max
            . gives = if given.length != 0 then nested else 0
            for position in 0 .. < sheets.length
                . recorded = facts.style-applications.length
                . inner-unit = rule-unit(sheets[position], members[position], made, id)
                next = apply-unit
                    - id
                    - made
                    - inner-unit
                    - next
                    - gives
                    - outer
                    - within
                    - gated
                    - active
                    - applied
                    - row.module
                    - nested
                    - around
                    - cell
                    - values
                    - outer-cells
                if next == U32.max || !gate-applications(recorded as U32, sheets[position], gates[position], id)
                    = U32.max
                if gives != 0 && !bind-given-slots(recorded as U32, nested, inner-unit, row.module, unit)
                    = U32.max
                facts.style-applications[recorded].prepared = evaluated
                revise-application(recorded as U32)
                if gives != 0
                    share-written-values(recorded as U32, owner.tree, row.binding)
        else
            if given.length != 0
                . (own, chosen, named, last) = match-style-rule(row.self-type, inner.name, given)
                if own != level || chosen.module != member.module || chosen.decl != member.decl
                    decline(id)
                    = U32.max
            . gives = if given.length != 0 then nested else 0
            . recorded = facts.style-applications.length
            next = apply-unit
                - id
                - made
                - rule-unit(level, member, made, id)
                - next
                - gives
                - outer
                - within
                - gated
                - active
                - applied
                - row.module
                - nested
                - around
                - cell
                - values
                - outer-cells
            if next == U32.max
                = U32.max
            facts.style-applications[recorded].prepared = evaluated
            revise-application(recorded as U32)
            if gives != 0
                share-written-values(recorded as U32, owner.tree, row.binding)
        for use in scoped
            if use.scope.frames != U32.max
                framed += 1
            next = apply-unit
                - id
                - made
                - scope-unit(use.scope, made)
                - next
                - 0
                - outer
                - within
                - gated
                - active
                - applied
                - row.module
                - nested
                - use.scope.frames
                - use.cell
                - use.values
                - use.outer-cells
            if next == U32.max
                = U32.max
        = next
decline(id)
= U32.max

────────────────────
_ do prepared-rule Bool
    - id SyntaxId
    - outer U32
    - within SyntaxId

` Whether a rule a style rule applies, by the application `outer`, is one the reference prepares
` as it prepares the markup element `id` whose rules are being applied (`preparing.site`), before
` its object is made (`nestedRuleScopesForPrepared`): one written after the name of a rule the
` element applies, or after that of one so prepared, but not in the body of a `when`.
if preparing.site == 0 || id != preparing.site || within != 0
    = false
. position = outer
while position != U32.max
    . held = facts.style-applications[position]
    if held.within != 0 || held.instance != instance
        = false
    position = held.outer
= true

────────────────────
_ sheet-values-alike Bool
    - class TypeId
    - name Atom
    - given [TypeId]
    - sheets [TypeId]
    - members [DeclRef]

` Whether the rules of the style sheets an element sees that values a style rule gives choose
` are one, and the one the class or sheet that writes the style rule chooses (`own-sheet-rule`),
` to whose types the values were converted where they are written (`type-applied-values`).
|? sheets.length != 1 && !variants-alike(sheets, members)
    false
??
    chosen.decl != 0 && chosen.module == members[0].module && chosen.decl == members[0].decl

.. chosen = own-sheet-rule(class, name, given)

────────────────────
_ do own-sheet-rule DeclRef
    - level TypeId
    - name Atom
    - given [TypeId]

` The rule of style sheets a class or a style sheet that writes a style rule chooses for the
` values it gives a rule it applies, where no class of its chain answers the name: the one of
` the sheets the class uses that they choose, or for a sheet, which uses none, the one sheet of
` the program with a rule they choose (`program-sheet-rule`). None where there is no one rule.
. sheets [TypeId]
. members [DeclRef]
. gates [U64]
. (status, writes, last) = sheet-rules(level, name, given, 0, sheets, members, gates, U32.max, true)
if status != 0 || sheets.length > 1
    = DeclRef(0, 0)
if sheets.length == 1
    = members[0]
if types.intrinsic-of(level) != .style-sheet
    = DeclRef(0, 0)
= program-sheet-rule(name, given)

────────────────────
_ do program-sheet-rule DeclRef
    - name Atom
    - given [TypeId]

` The rule of a name that values given choose among the style sheets of the program that write
` one (`match-rules-of`), in modules the module being typed shares a case with, where only one
` sheet has such a rule, or none where no sheet or more than one does, or the rule takes a type
` not known here.
. sheets [DeclRef]
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    if !program.shares-case(module, ref.module)
        continue
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-style-rule(rule)
            if rule.owner != 0 && is-sheet-decl(ref.module, rule.owner)
                . sheet = extended-sheet(owner-ref) ?? DeclRef(ref.module, rule.owner)
                    .. owner-ref = DeclRef(ref.module, rule.owner)
                . seen = false
                for held in sheets
                    if held.module == sheet.module && held.decl == sheet.decl
                        seen = true
                if !seen
                    sheets += sheet
. chosen = DeclRef(0, 0)
for sheet in sheets
    . level = types.class-with-args(sheet.module, sheet.decl, scratch.types.mark)
    if family-root(level) != level
        continue
    . (found, written, kind, named, last) = match-rules-of(level, name, given, U32.max)
    if found
        if chosen.decl != 0 || kind == U32.max
            = DeclRef(0, 0)
        chosen = written
= chosen

────────────────────
_ do apply-unit U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - order U32
    - gives SyntaxId
    - outer U32
    - within SyntaxId
    - gated [StyleWhen]
    - active [InstanceId]
    - applied [InstanceId]
    - owner ModuleId
    - nested SyntaxId
    - frames U32
    - cell U32 = U32.max
    - values U32 = U32.max
    - outer-cells U32 = U32.max

` Applies the rule a style rule applies at `nested` in a module, within the rules applied
` around it (`frames`), the state cells of the `when`s around it and the values of the rule around
` it that takes some, as `apply-rule` says, where the element's vocabulary answers its properties
` as the rule's does and it does not come to apply itself again, the reference's error.
if unit == no-instance || !answers-alike(unit, made, id)
    decline(id)
    = U32.max
. cycle = active.find(unit)
if cycle
    report-recursion(active, cycle, unit, owner, nested)
    = U32.max
= apply-rule
    - id
    - made
    - unit
    - order
    - gives
    - outer
    - within
    - gated
    - active
    - applied
    - frames
    - cell
    - values
    - false
    - outer-cells

────────────────────
_ do generate-content U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - index U32
    - lines [SyntaxId]
    - gates [StyleWhen]

` Types the content the lines of a style rule given generate where the rule is applied to the
` markup element `id`, by the application `index` of `style-applications`, under the `when`s
` `gates`, as the reference's `compileGuardedContent` makes it: each line is built by a function
` of its own, typed in the rule's module for what the element sees (`demand-content`), which a
` record of the style runtime holds for the element's object as a `MarkupElement`; under `when`s,
` an action of its own enables the record as they hold (`demand-style-content`), first where the
` element is made, where what enabling it raises leaves the function. None is
` generated where the reference generates none: by the rule `• This` (`content-off`), and by the
` rules the markup a function that builds generated content makes applies (`generating`).
` Answers how many lines generate content, each taking an order, or `U32.max` where one is
` declined or reported: by the rules a root `<This` applies in a constructor (`content-refused`),
` at a slot outlet, and where the element's object takes no content through the markup protocol,
` the reference's error. The values of the rules around rules written in rules the content sees
` are those the element holds, which the function keeps (`content-view`), and so are the state
` cells of the `when`s around them.
if lines.length != 0 && preparing.content-refused
    decline(id)
    = U32.max
if lines.length == 0 || preparing.content-off || !generating()
    = 0
if !(tree.nodes[id] is .node-markup)
    decline(id)
    = U32.max
if !is-markup-host(made)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Generated style content requires a MarkupElement target")
    = U32.max
. carried [U32]
. cells [U32]
. context = content-view(id, carried, cells)
. host = types.well-known-type("core/markup", "MarkupElement")
if context == U32.max || host == invalid-type || !demand-style-content(made, gates)
    decline(id)
    = U32.max
if conversions.convert(id, id, made, host, .reason-markup-host) == invalid-type
    = U32.max
if gates.length != 0 && !raises-out(id, facts.style-runtime.content-enabled)
    decline(id)
    = U32.max
. builder = builder-type(host, no-type)
. row = instances.rows[unit]
. written = program.modules[row.module].tree
. value-first = facts.content-values.length as U32
for held in carried
    facts.content-values += held
. cell-first = facts.content-cells.length as U32
for held in cells
    facts.content-cells += held
for line in lines
    . callee = demand-content(unit, line, context)
    if callee == no-instance || builder == invalid-type
        decline(id)
        = U32.max
    . closure = types.intern-closure
        - row.module
        - instances.rows[callee].decl
        - callee
        - instances.stable-keys[callee]
    conversions.record-made(callee, line, closure, builder)
    . slot = U32.max
    do match? written.nodes[line]
        | .node-markup(element)
            . name = identifier-name(written, element.slot-binding)
            slot = if name then slot-number(name.text) else U32.max
    facts.style-contents += StyleContent
        - instance
        - id
        - index
        - line
        - slot
        - callee
        - closure
        - value-first
        - carried.length as U32
        - cell-first
        - cells.length as U32
= lines.length as U32

────────────────────
_ do generating Bool

` Whether the rules markup written here applies generate content, as the reference's
` `markupStyleContentEnabled` says: not in a function that builds generated content, nor in one
` it encloses.
. around = instance
while around != no-instance
    . context = instances.rows[around].context
    if context != U32.max && instances.contexts[context].layer != 0
        = false
    around = instances.rows[around].enclosing
= true

────────────────────
_ do content-view U32
    - id SyntaxId
    - carried [U32]
    - cells [U32]

` The context of the function that builds content a style rule generates at a markup element,
` as the reference's `markupStyleContext` gives it there: the styles the markup written here sees,
` the first to answer a name first, the style sheets it sees in their groups, the rules written in
` rules it sees, with those the element's own rules bring into view (`push-scopes`), each with
` how many state cells of the `when`s around it it is seen under, which the function keeps, the
` outermost first, as `cells` gathers them, and where the values of the rule around it that
` takes some are among those it keeps, which are `carried` (`place-values`); and the layer its
` declarations take. `U32.max` where those are not known here, or a cell is not carried here.
if !sheets-known()
    = U32.max
if !scopes-known() && nested-any()
    = U32.max
. styles [TypeId]
for position in 0 .. < markup-styles.length
    styles += markup-styles[markup-styles.length - 1 - position]
. sheets [TypeId]
. levels [U32]
seen-sheets(sheets, levels)
. scopes [RuleScope]
. counts [U32]
. seen = rule-scopes.length
push-content-scopes(id)
. known = true
for use in rule-scopes
    scopes += use.scope
    counts += if use.cell == U32.max then 0u32 else 1 + facts.link-count(use.outer-cells)
    if use.cell == U32.max - 1
        known = false
    else if use.cell != U32.max
        facts.link-cells(use.outer-cells, cells)
        cells += use.cell
. valued [U32]
. value-types [TypeId]
known = known && place-values(0, valued, value-types, carried)
while rule-scopes.length > seen
    rule-scopes.pop()
if !known
    = U32.max
= instances.intern-context
    - styles
    - sheets
    - levels
    - scopes
    - counts
    - no-type
    - markup-layer()
    - valued
    - value-types

────────────────────
_ do demand-content InstanceId
    - unit InstanceId
    - line SyntaxId
    - context U32

` The function that builds the content a line of a style rule generates, the line's function in
` the frame of the instance `unit` that types the rule, typed once for each context
` (`check-content`). None where the line has no function, or its function captures.
. row = instances.rows[unit]
. decl = content-decl(row.module, line)
if decl == 0
    = no-instance
. effects = callee-effects(frame, row.module, decl)
. callee = instances.intern
    - row.module
    - decl
    - no-type
    - effects
    - unit
    - scratch.no-types
    - scratch.no-types
    - true
    - no-type
    - U32.max
    - false
    - 0
    - no-type
    - ImmutableArray'U32'ArenaBacking()
    - ImmutableArray'U32'ArenaBacking()
    - context
if instances.rows[callee].state == .instance-unstarted
    . writer = settled(unit)
    run-within(callee, writer)
    writer.dismiss()
= callee

────────────────────
_ do content-decl DeclId
    - module ModuleId
    - line SyntaxId

` The function of a line of a style rule that generates content, which the main code of its
` module declares, where it captures nothing; or none.
. binding = session.binder.bind(module, program.modules[module].main-decl)
. row = bindings.bindings[binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == line
        = if nested.captures.count == 0 then nested.decl else 0
= 0

────────────────────
_ slot-number U32
    - name String

` The number of a slot generated content fills, 0 to 3 for before, after, first-child and
` last-child, or `U32.max`.
|? name == "before"
    0
|? name == "after"
    1
|? name == "first-child"
    2
|? name == "last-child"
    3
??
    U32.max

────────────────────
_ do demand-style-content Bool
    - made TypeId
    - gates [StyleWhen]

` The functions of the style runtime generated content calls, typed once: the record of a line's
` content, made for an association, and what enables it; and, under `when`s, the row of
` `style-gates` that enables the record as they hold, with the action that runs its function.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
if runtime.template-content == no-instance
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . host = types.well-known-type("core/markup", "MarkupElement")
    . builder = if host != invalid-type then builder-type(host, no-type) else invalid-type
    if association == invalid-type || builder == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(association)
    scratch.types.push(host)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(builder)
    runtime.template-content = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-content")
        - mark
    scratch.types.rewind(mark)
    if runtime.template-content == no-instance
        = false
    scratch.types.push(instances.signatures[runtime.template-content].returns)
    scratch.types.push(types.bool-type)
    runtime.content-enabled = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-content-set-enabled")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
if runtime.template-content == no-instance || runtime.content-enabled == no-instance
    = false
if gates.length == 0
    = true
. action = demand-style-gates(made)
if action == no-instance
    = false
record-gate(made, gates, action, true)
= true

────────────────────
_ do scope-rules (U32, Bool, U32)
    - made TypeId
    - name Atom
    - given [TypeId]
    - extra [ScopeUse]
    - matched [ScopeUse]
    - mismatch U32

` The rules written in rules that markup sees (`rule-scopes`), and then those of `extra`, that
` an application of a name answers at an element of a class, as the reference's `resolveMatch`
` adds them after the rules of the classes and the style sheets, in the order they came into
` view: each of the name taking as many values as are given, each convertible to the type the
` rule takes it as, but none that reaches only the markup of an element not yet filled
` (`scope-pending`). Answers 0, 1 where one is declined and 2 where one is reported: declined
` where it has a rule around it that takes values, or around which the state cells of `when`s are
` not carried (`plain-frames`), or whose types are not known here, and reported where those types
` are written wrong (`report-argument-types`); whether one has the name; and the place of the
` last value found not to convert, or `mismatch`.
. named = false
. missed = mismatch
. count = rule-scopes.length + extra.length
for position in 0 .. < count
    . use = if position < rule-scopes.length then rule-scopes[position] else extra-use
        .. extra-use = extra[position - rule-scopes.length]
    . scope = use.scope
    if scope.own == .scope-pending
        continue
    . owner = program.modules[scope.module]
    do match? owner.decls[scope.decl]
        | .decl-style-rule(rule)
            if rule.name != name
                continue
            named = true
            if rule-takes(owner.tree, rule.syntax) != given.length
                continue
            . wanted = scope-argument-types(scope)
            if !wanted
                = (if report-argument-types(DeclRef(scope.module, scope.decl)) then 2u32 else 1u32, named, missed)
            . fits = true
            for place in 0 .. < given.length
                if !relation-legal(conversions.compare-held(given[place], wanted[place]))
                    missed = place as U32
                    fits = false
                    break
            if !fits
                continue
            if !plain-frames(use)
                = (1, named, missed)
            matched += use
= (0, named, missed)

────────────────────
_ do names-scope Bool
    - scopes [ScopeUse]
    - name Atom

` Whether a rule written in a rule among those given has a name, but for one that matches nothing
` yet (`scope-pending`).
for use in scopes
    if use.scope.own == .scope-pending
        continue
    do match? program.modules[use.scope.module].decls[use.scope.decl]
        | .decl-style-rule(rule)
            if rule.name == name
                = true
= false

────────────────────
_ do plain-frames Bool
    - use ScopeUse

` Whether the rules applied around a rule written in a rule hold it under `when`s whose state
` cells are here, one for each, and one of them at most takes values, which are here, which is
` all that is modeled of them.
if use.cell == U32.max - 1 || use.values == U32.max - 1
    = false
. gates U32
. valued U32
. frame = use.scope.frames
while frame != U32.max
    . held = instances.frames[frame]
    if held.gate != 0
        gates += 1
    . owner = program.modules[held.module]
    do match? owner.decls[held.decl]
        | .decl-style-rule(rule)
            if held.gate == 0 && rule-takes(owner.tree, rule.syntax) != 0
                if use.values == U32.max || facts.scope-values[use.values].frame != frame
                    = false
                valued += 1
    frame = held.outer
. cells = if use.cell == U32.max then 0u32 else 1 + facts.link-count(use.outer-cells)
= gates == cells && valued == (if use.values == U32.max then 0u32 else 1u32)

────────────────────
_ do scope-argument-types [TypeId]?
    - scope RuleScope

` The types a rule written in a rule takes its values as, as the class that writes it declares
` them (`written-argument-types`).
do match? program.modules[scope.module].decls[scope.decl]
    | .decl-style-rule(rule)
        = written-argument-types(scope.module, rule.owner, scope.decl)
= null

────────────────────
_ do scope-unit InstanceId
    - scope RuleScope
    - made TypeId

` The instance that types a rule written in a rule for an element of a class it is matched at,
` as the reference matches it (`targetOwner`): for its style sheet and the element's class where
` a sheet holds it, else for the element's class; typed now, or none where it is being typed
` already.
. sheet = types.intrinsic-of(scope.owner) == .style-sheet
. unit = instances.intern-initializer
    - scope.module
    - scope.decl
    - if sheet then scope.owner else made
    - if sheet then made else no-type
if instances.rows[unit].state == .instance-in-progress
    = no-instance
demand-body(unit)
panics.note-inlined(instance, unit)
= unit

────────────────────
_ do bring-scopes Bool
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - around U32
    - gated [StyleWhen]
    - cell U32
    - values U32
    - outer-cells U32

` Brings into view the rules written in a style rule applied to an element, which the markup
` its object makes and its body see (`collected`), as the reference's `styleRuleNestedScopes`
` gives them: those of its body, under the state cells the rule is applied under (`cell`, and
` `outer-cells` further out), then those of each of its `when`s, under its own (`when-cell`)
` within those (`outer-links`), each within the rules applied `around` them, under the `when` for
` those of one, and reading the `values` of the one that takes some. A rule applied under a
` `when` that is not a state cell may hold none, as the reference reports at the first.
. row = instances.rows[unit]
. owner = program.modules[row.module]
. scopes [ScopeUse]
. first SyntaxId = 0
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        . body = rule-body(owner.tree, rule.syntax)
        do match? owner.tree.nodes[body]
            | .node-block(block)
                for statement in owner.tree.children[block.body]
                    if owner.tree.nodes[statement] is .node-rule-syntax
                        if first == 0
                            first = statement
                        scopes += ScopeUse
                            - RuleScope
                                - row.module
                                - nested-decl(row.module, row.initializer, statement)
                                - row.self-type
                                - around
                                - scope-own(owner.tree, statement)
                            - cell
                            - values
                            - outer-cells
        for branch in rule-whens(owner.tree, body)
            . gate = U32.max
            . held = U32.max
            . links = U32.max
            for line in when-lines(owner.tree, branch)
                if owner.tree.nodes[line] is .node-rule-syntax
                    if first == 0
                        first = line
                    if gate == U32.max
                        gate = instances.intern-frame
                            - around
                            - row.module
                            - row.initializer
                            - row.self-type
                            - branch
                        held = if collecting then when-cell(cell, id, made, row.module, branch) else U32.max - 1
                        links = outer-links(held, cell, outer-cells)
                    scopes += ScopeUse
                        - RuleScope
                            - row.module
                            - nested-decl(row.module, row.initializer, line)
                            - row.self-type
                            - gate
                            - scope-own(owner.tree, line)
                        - held
                        - values
                        - links
if first == 0
    = true
for held in gated
    if held.cell == U32.max
        facts.record-diagnostic
            - instance
            - row.module
            - first
            - .stated
            - program.store-atom
                - "Conditionally applied style rules may only contain style declarations"
            - no-type
            - no-type
        = false
if collecting
    for use in scopes
        collected += use
= true

────────────────────
_ do when-cell U32
    - cell U32
    - site SyntaxId
    - owner TypeId
    - module ModuleId
    - branch SyntaxId

` The state cell of a `when` of a style rule whose body holds rules written in it, made at a site
` (`scope-cell`), as the reference binds the last frame around such a rule; `U32.max - 1`, a cell
` not carried, where the rule is applied under the state cell of a `when` that is not carried.
if cell == U32.max - 1
    = U32.max - 1
= scope-cell(site, owner, module, branch)

────────────────────
_ do outer-links U32
    - held U32
    - cell U32
    - outer-cells U32

` The state cells further out than that of a `when` (`held`) of a style rule applied under the
` cell `cell` and those further out, `outer-cells`: those with `cell` before them, where it is one;
` none where `held` is not carried.
if held >= U32.max - 1
    = U32.max
if cell >= U32.max - 1
    = outer-cells
= facts.scope-link(cell, outer-cells)

────────────────────
_ use-cells U32
    - use ScopeUse

` How many state cells of the `when`s around a rule written in a rule seen are carried with it:
` none where it is under none, or under one not carried.
if use.cell >= U32.max - 1 then 0 else 1 + facts.link-count(use.outer-cells)

────────────────────
_ do scope-cell U32
    - site SyntaxId
    - owner TypeId
    - module ModuleId
    - branch SyntaxId

` The state cell of a `when` at a site of this instance, made once, as the reference keeps one
` for each `when` an element or a class's content sees (`StyleScopeStateCells`), with where it is
` made (`cell-key`). While the way to a slot outlet is followed (`discovering`), one of no
` instance, which the function that builds what the outlet mounts reads from those it holds.
. holder = if keying.discovering then no-instance else instance
. key = cell-key(site, module, branch)
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if same-site && held.when == branch && held.key == key
        = index as U32
    .. same-site = held.instance == holder && held.site == site && held.module == module
facts.scope-cells += ScopeCell(holder, site, module, branch, owner, false, U32.max, key)
= (facts.scope-cells.length - 1) as U32

────────────────────
_ do cell-key U32
    - site SyntaxId
    - written ModuleId
    - branch SyntaxId

` Where the state cell of a `when`, written in `written`, made at a site of this instance is made,
` among `Instances.state-keys`, as the reference's `styleScopeStateKey` keys it: the markup element,
` or where `keying` names one, the root `<This`, class, or element of markup it names, in its
` module.
if keying.site != 0
    = instances.state-key(keying.module, keying.site, written, branch)
= instances.state-key(module, site, written, branch)

────────────────────
_ do take-scope ScopeUse
    - use ScopeUse

` A rule written in a rule that the function building markup sees as the markup it is written in
` sees it, as the reference's closures capture the values of its frames: under a state cell this
` function keeps of that one (`kept-cell`), or, for one found on the way to the slot outlet that
` mounts what it builds, reads from those the outlet holds (`read-cell`), and so for those of the
` `when`s further out (`take-links`); with the values of the rule around it that takes some this
` function keeps (`kept-values`).
. values = if use.values < U32.max - 1 then kept-values(use.values) else use.values
if use.cell >= U32.max - 1
    = ScopeUse(use.scope, use.cell, values)
= ScopeUse(use.scope, take-cell(use.cell), values, take-links(use.outer-cells))

────────────────────
_ do take-cell U32
    - cell U32

` A state cell the function building markup sees as the markup it is written in sees it, as
` `take-scope` says.
if facts.scope-cells[cell].instance == no-instance
    = read-cell(cell)
= kept-cell(cell)

────────────────────
_ do take-links U32
    - link U32

` The state cells of a link of `scope-links` the function building markup sees as the markup it
` is written in sees them (`take-cell`), made into a link again.
if link == U32.max
    = U32.max
. held = facts.scope-links[link]
. outer = take-links(held.outer)
= facts.scope-link(take-cell(held.cell), outer)

────────────────────
_ do kept-values U32
    - source U32

` The values of a rule around rules written in it that this function keeps of those of the
` function it is written in, made once, in the order kept; `U32.max - 1`, values not here, where
` their types are not known. It names that one's values, so this function is typed only with that
` one (`Instance.with-enclosing`).
instances.rows[instance].with-enclosing = true
. count U32
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if held.instance == instance && held.kept != U32.max
        if held.source == source
            = index as U32
        count += 1
. taken = frame-value-types(source)
if !taken
    = U32.max - 1
. first = facts.scope-value-types.length as U32
for type in taken
    facts.scope-value-types += type
facts.scope-values += ScopeValues
    - instance
    - 0
    - module
    - facts.scope-values[source].frame
    - U32.max
    - count
    - source
    - first
    - taken.length as U32
= (facts.scope-values.length - 1) as U32

────────────────────
_ do content-values U32
    - scope RuleScope
    - place U32

` The values of the rule around a rule written in a rule that the function that builds content a
` style rule generates keeps, from the `place`th on among those its context names, made once, in
` the order kept; the markup element it is generated at gives them (`StyleContent`). `U32.max - 1`,
` values not here, where their types are not known.
. frame = valued-frame(scope.frames)
. count U32
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if held.instance == instance && held.kept != U32.max
        if held.argument == place
            = index as U32
        count += 1
if frame == U32.max
    = U32.max - 1
. taken = frame-types(frame)
if !taken
    = U32.max - 1
. first = facts.scope-value-types.length as U32
for type in taken
    facts.scope-value-types += type
facts.scope-values += ScopeValues
    - instance
    - 0
    - module
    - frame
    - place
    - count
    - U32.max
    - first
    - taken.length as U32
= (facts.scope-values.length - 1) as U32

────────────────────
_ do kept-cell U32
    - source U32

` The state cell this function keeps of one of the function it is written in, made once, in the
` order kept. It names that one's cell, so this function is typed only with that one
` (`Instance.with-enclosing`).
instances.rows[instance].with-enclosing = true
. count U32
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance == instance && held.kept != U32.max
        if held.source == source
            = index as U32
        count += 1
. row = facts.scope-cells[source]
facts.scope-cells += ScopeCell
    - instance
    - U32.max
    - row.module
    - row.when
    - row.owner
    - true
    - U32.max
    - row.key
    - count
    - source
= (facts.scope-cells.length - 1) as U32

────────────────────
_ do read-cell U32
    - found U32

` The state cell this function reads from those the slot outlet that mounts what it builds holds,
` for one found on the way there, made once for each place a cell is made, as the reference's
` `markupStyleRuleScopesWithOutletStates` reads one. False where the runtime has no such read.
. row = facts.scope-cells[found]
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance == instance && held.read && held.key == row.key
        = index as U32
do demand-outlet-states()
facts.scope-cells += ScopeCell
    - instance
    - U32.max
    - row.module
    - row.when
    - row.owner
    - true
    - U32.max
    - row.key
    - U32.max
    - U32.max
    - true
= (facts.scope-cells.length - 1) as U32

────────────────────
_ do demand-outlet-states Bool

` The functions of the style runtime a slot outlet calls to hold state cells while what it mounts
` is built, and the one that reads them, typed once.
. runtime = facts.style-runtime
if runtime.outlet-state != no-instance
    = true
. cell = types.well-known-type("core/style", "StyleScopeState")
if cell == invalid-type
    = false
types.complete(cell)
. module-id = class-ref(types, cell).module
. mark = scratch.types.mark
runtime.outlet-mark = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-outlet-states-mark")
    - mark
if runtime.outlet-mark == no-instance
    = false
scratch.types.push(types.type-row(.uint32))
scratch.types.push(cell)
runtime.outlet-push = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-outlet-state-push")
    - mark
scratch.types.rewind(mark)
scratch.types.push(instances.signatures[runtime.outlet-mark].returns)
runtime.outlet-release = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-outlet-states-release")
    - mark
scratch.types.rewind(mark)
scratch.types.push(types.type-row(.uint32))
runtime.outlet-state = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-outlet-state")
    - mark
scratch.types.rewind(mark)
facts.style-runtime = runtime
= outlets-ready && runtime.outlet-state != no-instance
    .. outlets-ready = runtime.outlet-push != no-instance && runtime.outlet-release != no-instance

────────────────────
_ do hold-cells Bool
    - id SyntaxId
    - uses [ScopeUse]

` Keeps the state cells a slot outlet holds while the function that builds what it mounts runs, or
` a line that forwards a slot while the builder it forwards does (`OutletCell`), as the reference's
` `markupOutletStyleStateCells` takes them: of the rules written in rules `uses`, the cells of the
` `when`s around each, the outermost first, the first for each place cells are made, but those
` given with the context, which no place made. False where the runtime has none.
. keys [U32]
. cells [U32]
for use in uses
    if use.cell >= U32.max - 1
        continue
    . chain [U32]
    facts.link-cells(use.outer-cells, chain)
    chain += use.cell
    for held in chain
        . key = facts.scope-cells[held].key
        if key != U32.max && keys.find(key) == null
            keys += key
            cells += held
if cells.length == 0
    = true
if !demand-outlet-states()
    decline(id)
    = false
for held in facts.outlet-cells
    if held.instance == instance && held.outlet == id
        = true
for cell in cells
    facts.outlet-cells += OutletCell(instance, id, cell)
= true

────────────────────
_ do slot-scopes-for Bool
    - element SyntaxId
    - class TypeId
    - scopes [ScopeUse]

` The rules written in rules that the functions building what the lines of a markup element's
` body give the slots of its class see before those found on the way to each slot's outlet, as
` the reference's `slotOutletStyleContext` holds them: those the element sees, those its rules
` bring (`scopes-of`), and those of the rules `• This` of its class's chain, under state cells
` made at the element, but those that reach only the markup of its class's own
` (`scope-pending`). False where they are not known here.
if !scoping-any() || !scopes-known() || !sheets-known()
    = false
for use in rule-scopes
    scopes += use
. (start, end) = scopes-of(element)
for position in start .. < end
    if scoped-rows[position].scope.own != .scope-pending
        scopes += scoped-rows[position]
default-scopes(class, element, scopes, false)
= true

────────────────────
_ do slot-outlet (TypeId, SyntaxId)
    - class TypeId
    - name Atom

` The class of a chain whose markup declares the slot of a name, and its outlet there or the line
` that forwards it, as `level-slots` finds them; or no type.
. level TypeId? = class
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    . content SyntaxId = 0
    do match? owner.decls[ref.decl]
        | .decl-class(row)
            content = row.content
    if content != 0
        for node in owner.tree.subtree-start(content) .. < content
            do match? owner.tree.nodes[node]
                | .node-slot-outlet(row)
                    . named = program.store-atom("")
                    if row.name != 0
                        named = identifier-name(owner.tree, row.name) ?? named
                    if named == name && !inner-outlet(owner.tree, content, node)
                        = (level, node)
                | .node-markup-slot-forward(row)
                    if identifier-name(owner.tree, row.slot-binding) == name
                        = (level, node)
    level = types.base-of(level)
= (no-type, 0u32)

────────────────────
_ do inner-outlet Bool
    - written AST
    - content SyntaxId
    - outlet SyntaxId

` Whether a slot outlet of the markup written in a class is no slot's: one a line forwards, or one
` in the body of another, which is content the other mounts where it is given none.
for node in written.subtree-start(content) .. < content
    do match? written.nodes[node]
        | .node-markup-slot-forward(row)
            if row.outlet == outlet
                = true
        | .node-slot-outlet(row)
            if node != outlet && row.body != 0 && in-body
                = true
            .. in-body = written.subtree-start(row.body) <= outlet && outlet <= row.body
= false

────────────────────
_ do outlet-scopes U32
    - class TypeId
    - name Atom
    - content TypeId
    - applies Bool
    - base [ScopeUse]
    - sheets [TypeId]
    - levels [U32]
    - found [ScopeUse]
    - keeps-own Bool

` The rules written in rules that the function building what a line gives a slot of a class, of
` type `content`, sees after those of the markup that gives it (`base`, seeing the style sheets
` `sheets` in their `levels`), found on the way to the slot's outlet, as the reference's
` `markupSlotOutletRuleScopes` finds them (`follow-outlet`), the state cell of the `when` around
` each one the cell that outlet holds of those made there (`discovering`); then, where it
` `applies` them, as `markupSlotScopeAdditions` does, those the rules the outlet applies bring
` (`outlet-applications`). None are found on the way to an outlet being followed already. Answers
` 0, 2 where one is declined, or 3 where the rules the outlet applies bring rules under the state
` cells of `when`s, which the function that builds the content brings itself
` (`root-applications`); `found` is given those found for 0, and those but these for 3. The way
` sees of `base` those that match in the markup of the class being filled (`scope-entered`) only
` where that markup `keeps-own`, as the class's chain does, as the reference's
` `markupSlotScopeAdditions` leaves them, and none found reaches only the markup of an element's
` class (`scope-pending`), which what a line gives a slot is not.
. (owner, outlet) = slot-outlet(class, name)
if owner == no-type
    = 0
. ref = class-ref(types, owner)
. tag = ((ref.module as U64) /lshift/ 32) /or/ (outlet as U64)
. followed = discoveries.find(tag) != null
. written = program.modules[ref.module].tree
. markup SyntaxId = 0
do match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(declared)
        markup = declared.content
. root = written.root-this(markup)
. path [SyntaxId]
. node = written.holder-of(outlet)
while node != 0 && node != markup
    if node != root && written.nodes[node] is .node-markup
        path += node
    node = written.holder-of(node)
. saved-scopes [ScopeUse]
for use in rule-scopes
    saved-scopes += use
. saved-sheets [TypeId]
for sheet in markup-sheets
    saved-sheets += sheet
. saved-levels [U32]
for level in sheet-levels
    saved-levels += level
. own-keying = keying
rule-scopes.clear()
for use in base
    if keeps-own || use.scope.own != .scope-entered
        rule-scopes += use
. based = rule-scopes.length
markup-sheets.clear()
sheet-levels.clear()
for sheet in sheets
    markup-sheets += sheet
for level in levels
    sheet-levels += level
keying = keying.sheet-self = owner
keying = keying.discovering = true
. status = 1u32
if !followed
    discoveries += tag
    status = follow-outlet(owner, ref.module, written, root, path, outlet, name)
    discoveries.pop()
if status == 3
    status = 2
if status == 1
    status = 0
    while rule-scopes.length > based
        rule-scopes.pop()
if status == 0 && applies
    markup-sheets.clear()
    sheet-levels.clear()
    for sheet in sheets
        markup-sheets += sheet
    for level in levels
        sheet-levels += level
    status = outlet-applications(class, name, content)
if status == 0 || status == 3
    for position in based .. < rule-scopes.length
        if rule-scopes[position].scope.own != .scope-pending
            found += rule-scopes[position]
rule-scopes.clear()
for use in saved-scopes
    rule-scopes += use
markup-sheets.clear()
for sheet in saved-sheets
    markup-sheets += sheet
sheet-levels.clear()
for level in saved-levels
    sheet-levels += level
keying = own-keying
= status

────────────────────
_ do follow-outlet U32
    - owner TypeId
    - home ModuleId
    - written AST
    - root SyntaxId
    - path [SyntaxId]
    - outlet SyntaxId
    - name Atom

` Follows the way to a slot outlet of the markup written in the class `owner`, in `home`, through
` the markup elements `path` it is in, innermost first, bringing into view the rules written in
` rules seen on the way (`rule-scopes`), as `markupSlotOutletRuleScopes` does: where the class
` above writes markup, those of its root `<This` and those found on the way to the outlet of the
` slot the outermost element gives content, or the default one; else those of the class's root
` `<This` (`gather-root`). Then, for each element, outermost first, those its rules bring; where
` the next is content of a slot of the element's class, or the outlet forwards one of it, those of
` the rules `• This` of its chain, made at the element, and those found on the way to that slot's
` outlet in turn. Answers as `outlet-scopes` does.
. above = types.base-of(owner) ?? no-type
. entered = false
if above != no-type && writes-content(above)
    . first = if path.length != 0 then path[path.length - 1] else 0u32
    . slot = program.store-atom("")
    . bound = false
    do match? written.nodes[first]
        | .node-markup(row)
            if row.slot-binding != 0 && written.holder-of(first) == owner-lines
                bound = true
                slot = identifier-name(written, row.slot-binding) ?? slot
            .. owner-lines = written.content-lines(class-content(owner))
    . names [Atom]
    . wanted [TypeId]
    . items [TypeId]
    if !class-outlets(above, names, wanted, items)
        = 2
    . has = names.find(slot) != null
    if bound && !has
        = 1
    if has
        . base-written = program.modules[class-ref(types, above).module].tree
        . base-content = class-content(above)
        if gather-root(above, base-module, base-written, base-written.root-this(base-content)) != 0
            = 2
        .. base-module = class-ref(types, above).module
        . seen [ScopeUse]
        for use in rule-scopes
            seen += use
        . sheets [TypeId]
        for sheet in markup-sheets
            sheets += sheet
        . levels [U32]
        for level in sheet-levels
            levels += level
        . inner [ScopeUse]
        . status = outlet-scopes
            - above
            - slot
            - wanted[names.find(slot)!]
            - true
            - seen
            - sheets
            - levels
            - inner
            - true
        if status != 0
            = status
        for use in inner
            rule-scopes += use
        entered = true
if !entered && gather-root(owner, home, written, root) != 0
    = 2
. ref = class-ref(types, owner)
. args = RowRange'TypeId()
do match? types.rows[owner]
    | .type-class(row)
        args = row.args
. env = types.class-env-for(ref.module, ref.decl, args, owner)
. status = 0u32
for index in 0 .. < path.length
    . node = path[path.length - 1 - index]
    . next = if index + 1 < path.length then path[path.length - 2 - index] else 0u32
    do match? written.nodes[node]
        | .node-markup(row)
            types.clear-fault()
            . type = types.evaluate-type(home, written, row.type-id, env)
            types.clear-fault()
            if type == invalid-type || type == no-type || types.intrinsic-of(type) != .class
                status = 1
                break
            . names [Atom]
            for text in implicit-names(type, row.type-id, row.id, written)
                names += program.store-atom(text)
            . gathered [ScopeUse]
            . own-keying = keying
            keying = Keying(keying.discovering, keying.sheet-self, home, node)
            . gathering = gather-scopes
                - type
                - names
                - row.style-rule-applications
                - node
                - type
                - gathered
                - written
            keying = own-keying
            if !gathering
                status = 2
                break
            for use in gathered
                rule-scopes += use
            add-sheet-groups(type, markup-sheets, sheet-levels)
            . forwards = written.nodes[outlet] is .node-markup-slot-forward && last-step
                .. last-step = index == path.length - 1
            . bound SyntaxId = 0
            do match? written.nodes[next]
                | .node-markup(line)
                    if line.slot-binding != 0 && row.body != 0 && in-body
                        bound = next
                    .. in-body = written.holder-of(next) == row.body
            . slot = program.store-atom("")
            if forwards
                slot = name
            else if bound != 0
                do match? written.nodes[bound]
                    | .node-markup(line)
                        slot = identifier-name(written, line.slot-binding) ?? slot
            . slots [Atom]
            . wanted [TypeId]
            . items [TypeId]
            if !class-outlets(type, slots, wanted, items)
                status = 2
                break
            . has = slots.find(slot) != null
            if (bound != 0 || forwards) && !has
                status = 1
                break
            if !has
                continue
            . outer-keying = keying
            keying = Keying(keying.discovering, keying.sheet-self, home, node)
            default-scopes(type, node, rule-scopes, false)
            keying = outer-keying
            . seen [ScopeUse]
            for use in rule-scopes
                seen += use
            . sheets [TypeId]
            for sheet in markup-sheets
                sheets += sheet
            . levels [U32]
            for level in sheet-levels
                levels += level
            . inner [ScopeUse]
            . held = outlet-scopes
                - type
                - slot
                - wanted[slots.find(slot)!]
                - !forwards
                - seen
                - sheets
                - levels
                - inner
                - false
            if held != 0
                status = held
                break
            for use in inner
                rule-scopes += use
types.env-release(env)
= status

────────────────────
_ do gather-root U32
    - class TypeId
    - home ModuleId
    - written AST
    - root SyntaxId

` Brings into view, on the way to a slot outlet, the rules written in rules that the rules a root
` `<This` of the markup a class writes matches bring, each not in view already, as the reference's
` `classContentRootStyleRuleScopes` gathers them, the state cell of each made where the root is.
` Answers 0, or 2 where one is declined.
do match? written.nodes[root]
    | .node-markup(row)
        . names [Atom]
        for text in implicit-names(class, row.type-id, 0, written)
            names += program.store-atom(text)
        . gathered [ScopeUse]
        . own-keying = keying
        keying = Keying(keying.discovering, keying.sheet-self, home, root)
        . gathering = gather-scopes
            - class
            - names
            - row.style-rule-applications
            - root
            - class
            - gathered
            - written
        keying = own-keying
        if !gathering
            = 2
        . added [ScopeUse]
        for use in gathered
            . shown = false
            for held in rule-scopes
                shown = shown || instances.same-scope(held.scope, use.scope)
            for held in added
                shown = shown || instances.same-scope(held.scope, use.scope)
            if !shown
                added += use
        for use in added
            rule-scopes += use
= 0

────────────────────
_ do class-content SyntaxId
    - class TypeId

` The section of markup a class writes, or none.
. ref = class-ref(types, class)
do match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(declared)
        = declared.content
= 0

────────────────────
_ do outlet-applications U32
    - class TypeId
    - name Atom
    - content TypeId

` Brings into view the rules written in rules that the rules the outlet of the slot of a name of a
` class applies after `•` bring to what the slot is given, as the reference's
` `markupStyleRuleScopesForApplications` gathers them for the slot's type `content` there. Answers
` 0; 3, bringing none, where one is under the state cell of a `when`, which the function that
` builds the content binds to what it builds (`root-applications`); or 2 where one is declined:
` one with values, and the rules of an outlet a line forwards.
. (owner, outlet) = slot-outlet(class, name)
if owner == no-type
    = 0
. ref = class-ref(types, owner)
. written = program.modules[ref.module].tree
do match? written.nodes[outlet]
    | .node-slot-outlet(row)
        for application in written.children[row.style-rule-applications]
            do match? written.nodes[application]
                | .node-style-rule-application(applied)
                    if scoping-named(applied.name) && applied.args.count != 0
                        = 2
        . none [Atom]
        . gathered [ScopeUse]
        . own-keying = keying
        keying = Keying(true, keying.sheet-self, ref.module, outlet)
        . gathering = gather-scopes
            - content
            - none
            - row.style-rule-applications
            - outlet
            - content
            - gathered
            - written
        keying = own-keying
        if !gathering
            = 2
        for use in gathered
            if use.cell != U32.max
                = 3
        for use in gathered
            rule-scopes += use
    | .node-markup-slot-forward
        if outlet-applies(class, name)
            = 2
= 0

────────────────────
_ do outlet-applies Bool
    - class TypeId
    - name Atom

` Whether the outlet of the slot of a name of a class, or that of the class whose slot a line
` forwards it to, applies after `•` a rule whose name some rule that brings rules written in rules
` has, which brings them to what the slot is given, which is declined.
. (owner, outlet) = slot-outlet(class, name)
if owner == no-type
    = false
. ref = class-ref(types, owner)
. written = program.modules[ref.module].tree
do match? written.nodes[outlet]
    | .node-slot-outlet(row)
        for application in written.children[row.style-rule-applications]
            do match? written.nodes[application]
                | .node-style-rule-application(applied)
                    if scoping-named(applied.name)
                        = true
    | .node-markup-slot-forward
        . element = written.holder-of(written.holder-of(outlet))
        do match? written.nodes[element]
            | .node-markup(made)
                . args = RowRange'TypeId()
                do match? types.rows[owner]
                    | .type-class(row)
                        args = row.args
                . env = types.class-env-for(ref.module, ref.decl, args, owner)
                . host = types.evaluate-type(ref.module, written, made.type-id, env)
                types.env-release(env)
                if host == invalid-type || host == no-type || types.intrinsic-of(host) != .class
                    = true
                = outlet-applies(host, name)
= false

────────────────────
_ do given-cell U32
    - scope RuleScope
    - argument U32
    - depth U32

` The state cell this instance is given, its `argument`th, for a `when` around a rule written in
` a rule its context gives: the frame of the rule that is the `depth`th `when`'s from the
` innermost. It is made at no place a slot outlet holds it by, as the reference's
` `markupStyleContextWithRuntimeValues` drops the `stateKey` of the frames a function is given.
. frame = scope.frames
. passed U32
while frame != U32.max
    if instances.frames[frame].gate != 0
        if passed == depth
            break
        passed += 1
    frame = instances.frames[frame].outer
. module = if frame != U32.max then instances.frames[frame].module else 0u32
. branch = if frame != U32.max then instances.frames[frame].gate else 0u32
facts.scope-cells += ScopeCell(instance, U32.max, module, branch, no-type, true, argument)
= (facts.scope-cells.length - 1) as U32

────────────────────
_ do content-cell U32
    - scope RuleScope
    - kept U32
    - depth U32

` The state cell the function that builds generated content keeps, its `kept`th, for a `when`
` around a rule written in a rule its context gives: the frame of the rule that is the `depth`th
` `when`'s from the innermost, which the markup element the content is generated at holds
` (`StyleContent`).
. frame = scope.frames
. passed U32
while frame != U32.max
    if instances.frames[frame].gate != 0
        if passed == depth
            break
        passed += 1
    frame = instances.frames[frame].outer
. module = if frame != U32.max then instances.frames[frame].module else 0u32
. branch = if frame != U32.max then instances.frames[frame].gate else 0u32
facts.scope-cells += ScopeCell
    - instance
    - U32.max
    - module
    - branch
    - no-type
    - true
    - U32.max
    - U32.max
    - kept
= (facts.scope-cells.length - 1) as U32

────────────────────
_ do check-cells Bool
    - site SyntaxId
    - at SyntaxId
    - made TypeId
    - known Bool

` Checks the state each state cell made at a site names, once, as the reference binds them once
` the object is made (`compileStyleScopeStateBindings`): a property of the class of the object,
` `made`, of type `Bool`, as the reference reports, which is read tracked. Where the class was
` not `known` exactly, which is where the cell is made for a class's content that classes below
` may run, one the class has not is declined. False where one is reported or declined.
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != instance || held.site != site || held.checked
        continue
    facts.scope-cells[index].checked = true
    if !check-cell(held, at, made, known)
        = false
= true

────────────────────
_ do check-cell Bool
    - held ScopeCell
    - at SyntaxId
    - made TypeId
    - known Bool

` Checks the state a state cell names, as `check-cells` says, and types what keeps the cell: the
` constructor of `StyleScopeState`, whose `is-on` is read tracked, and the live action.
. written = program.modules[held.module].tree
. state = program.store-atom("")
do match? written.nodes[held.when]
    | .node-style-when(row)
        state = row.state
. place = types.property-named(made, state)
. shown = type-short-name(types, made)
if !place
    if !known
        decline(at)
        = false
    facts.record-diagnostic
        - instance
        - held.module
        - held.when
        - .stated
        - program.store-atom("Style state \"${state.text}\" is not a property of $shown")
        - no-type
        - no-type
    = false
. property = types.properties[place]
if property.storage-kind == .storage-getter
    decline(at)
    = false
. declared = property.type
if declared == no-type
    declared = demand-member(property, made, state)
if declared == invalid-type
    = false
if declared != types.bool-type
    facts.record-diagnostic(instance, held.module, held.when, .stated, program.store-atom("Style state \"${state.text}\" must be a boolean property, but $shown.${state.text} is ${type-display(types, declared)}"), declared, no-type)
    = false
instances.mark-may-panic(instance)
. key = panics.property-of(made, state)
if key
    panics.track(key)
. ref = class-ref(types, property.owner)
facts.note-tracked(ref.module, ref.decl, state)
demand-live-runtime()
. cell = types.well-known-type("core/style", "StyleScopeState")
if cell == invalid-type || instances.live.action == no-instance || no-track
    decline(at)
    = false
.. no-track = instances.live.track == no-instance
. runtime = facts.style-runtime
if runtime.scope-state == no-instance
    types.complete(cell)
    runtime.scope-state = calls.demand-constructor(cell, scratch.types.mark)
    facts.style-runtime = runtime
if runtime.scope-state == no-instance
    decline(at)
    = false
. is-on = program.store-atom("is-on")
. cell-key = panics.property-of(cell, is-on)
if cell-key
    panics.track(cell-key)
. cell-ref = class-ref(types, cell)
facts.note-tracked(cell-ref.module, cell-ref.decl, is-on)
= true

────────────────────
_ do cell-whens [StyleWhen]?
    - id SyntaxId
    - made TypeId
    - gated [StyleWhen]
    - cell U32
    - outer-cells U32
    - index U32

` The `when`s that gate a style rule applied under those given, as the reference's
` `styleScopeStateConditions` puts the state cells of the `when`s around a rule written in a rule
` before them, the outermost first, but those they hold already: its gate is recorded once
` (`StyleGate`) and the application of the rule is marked with the cells, the innermost as its
` `cell` and those further out as its `outer-cells`. None where it is declined.
if cell == U32.max
    = gated
. chain [U32]
facts.link-cells(outer-cells, chain)
chain += cell
. missing [U32]
for held in chain
    . holds = false
    for place in gated
        holds = holds || place.cell == held
    if !holds
        missing += held
if missing.length == 0
    = gated
. action = demand-style-gates(made)
if action == no-instance || instances.live.track == no-instance
    decline(id)
    = null
. whens [StyleWhen]
for held in missing
    . row = facts.scope-cells[held]
    whens += StyleWhen(row.module, row.when, held)
for held in gated
    whens += held
record-gate(made, whens, action)
facts.style-applications[index].cell = missing[missing.length - 1]
revise-application(index)
. links = U32.max
for position in 0 .. < missing.length - 1
    links = facts.scope-link(missing[position], links)
facts.style-applications[index].outer-cells = links
revise-application(index)
= whens

────────────────────
_ do nested-decl DeclId
    - owner ModuleId
    - outer DeclId
    - syntax SyntaxId

` The declaration of a style rule written at a node of the body of another, or of one of its
` `when`s: among those its module declares after the other, as it declares them, before the
` first that is written in none.
. decls = program.modules[owner].decls
. index = outer + 1
while index < decls.length
    do match? decls[index]
        | .decl-style-rule(rule)
            if rule.outer == 0
                = 0
            if rule.syntax == syntax
                = index
        ??
            = 0
    index += 1
= 0

────────────────────
_ do record-scopes
    - id SyntaxId
    - scopes [ScopeUse]

` Keeps the rules written in rules that the style rules a markup element applies bring into view,
` for the markup its object makes and its body.
scoped-sites += id
scoped-starts += scoped-rows.length as U32
for scope in scopes
    scoped-rows += scope
scoped-ends += scoped-rows.length as U32

────────────────────
_ do scopes-of (U32, U32)
    - id SyntaxId

` Where among `scoped-rows` the rules a markup element brings into view are kept, the last kept
` for it, or none.
. position = scoped-sites.length
while position != 0
    position -= 1
    if scoped-sites[position] == id
        = (scoped-starts[position], scoped-ends[position])
= (0u32, 0u32)

────────────────────
_ do same-scopes Bool
    - id SyntaxId

` Whether the rules written in rules that the style rules a markup element applies brought into
` view (`element-scopes`) are those it was made seeing.
. (start, end) = scopes-of(id)
if end - start != element-scopes.length
    = false
for position in 0 .. < element-scopes.length
    if !same-use(scoped-rows[start + position], element-scopes[position])
        = false
= true

────────────────────
_ same-use Bool
    - first ScopeUse
    - second ScopeUse

` Whether two rules written in rules seen are the same, under the same state cells, with the same
` values of the rules around.
same-cell && first.values == second.values && first.outer-cells == second.outer-cells

.. same-cell = instances.same-scope(first.scope, second.scope) && first.cell == second.cell

────────────────────
_ do push-scopes
    - id SyntaxId

` Brings into view, for the constructor of a markup element's object, the rules written in rules
` that the style rules the element applies do, those that reach only the markup of its class's
` own (`scope-pending`) with them.
. (start, end) = scopes-of(id)
for position in start .. < end
    rule-scopes += scoped-rows[position]

────────────────────
_ do push-body-scopes
    - id SyntaxId

` Brings into view, for the markup in a markup element's body, the rules written in rules that the
` style rules the element applies do, but those that reach only the markup of its class's own
` (`scope-pending`), as the reference's `withoutPendingOwnStyleRuleScopes` leaves them out.
. (start, end) = scopes-of(id)
for position in start .. < end
    if scoped-rows[position].scope.own != .scope-pending
        rule-scopes += scoped-rows[position]

────────────────────
_ do push-content-scopes
    - id SyntaxId

` Brings into view, for the content a style rule generates at a markup element, the rules written
` in rules that the style rules the element applies do, those that reach only the markup of its
` class's own matching there too (`scope-entered`), as the reference's
` `enteredOwnStyleRuleScopes` gives them.
. (start, end) = scopes-of(id)
for position in start .. < end
    rule-scopes += entered-use(scoped-rows[position])

────────────────────
_ entered-use ScopeUse
    - use ScopeUse

` A rule written in a rule as it is seen in the markup of the class of the element it was brought
` into view at: matching there where it reaches only that markup and matched nothing before.
|? use.scope.own != .scope-pending
    use
??
    ScopeUse
        - RuleScope(scope.module, scope.decl, scope.owner, scope.frames, .scope-entered)
        - use.cell
        - use.values
        - use.outer-cells

.. scope = use.scope

────────────────────
_ do scope-own ScopeOwn
    - written AST
    - line SyntaxId

` How a rule written in a rule, at a line of the module that writes it, is first brought into
` view: matching nothing until its element's object is filled where it is written `• own`.
do match? written.nodes[line]
    | .node-rule-syntax(row)
        =? .scope-pending if row.is-own
= .scope-plain

────────────────────
_ do may-scope Bool
    - class TypeId
    - row ASTMarkup

` Whether a style rule a markup element of a class applies may bring rules written in rules into
` view: whether a name it applies by has a rule that does (`scoping-names`).
if !scoping-any() || types.intrinsic-of(class) != .class
    = false
for name in implicit-names(class, row.type-id, row.id, tree)
    if scoping-named(program.store-atom(name))
        = true
for application in tree.children[row.style-rule-applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if scoping-named(applied.name)
                = true
= false

────────────────────
_ do gather-scopes Bool
    - made TypeId
    - names [Atom]
    - applications RowRange'SyntaxId
    - site SyntaxId
    - owner TypeId
    - scopes [ScopeUse]
    - written AST

` The rules written in rules that the style rules a markup element applies bring into view, as
` the reference prepares them before it makes the object (`prepareElementStyleRules`): for the
` rules each name it matches by answers, and then each written after `•` in `written`, those they
` bring (`gather-name`), each seeing those the ones before brought, with the state cells of the
` `when`s around them made at `site` for an object read as of class `owner`. The values a written
` one gives are typed here, as the reference evaluates them as it prepares the element, and the
` rules it brings read them as the element's rule takes them (`ScopeValues`). One an element
` writes with a condition brings none: the reference reports the rules written in what it
` applies (`declares-only`). False where one is declined: one written with a condition or with
` values where no element is (a root `<This`). While the way to a slot outlet is followed
` (`discovering`), one with values is passed over, as the reference leaves out what it brings
` there.
. none [TypeId]
for name in names
    if !gather-name(made, name, scopes, U32.max, U32.max, site, owner, scopes, none, 0, U32.max, U32.max)
        = false
for application in written.children[applications]
    do match? written.nodes[application]
        | .node-style-rule-application(applied)
            if !scoping-named(applied.name) || (applied.condition != 0 && site != 0)
                continue
            if applied.args.count != 0 && applied.condition == 0 && keying.discovering
                continue
            if applied.condition != 0 || (applied.args.count != 0 && site == 0)
                = false
            . given [TypeId]
            for value in written.children[applied.args]
                . type = infer(value)
                pretyped += value
                if type == invalid-type || type == no-type
                    = false
                given += type
            . gives = if given.length != 0 then application else 0
            if !gather-name(made, applied.name, scopes, U32.max, U32.max, site, owner, scopes, given, gives, U32.max, U32.max)
                = false
= true

────────────────────
_ do gather-name Bool
    - made TypeId
    - name Atom
    - seen [ScopeUse]
    - frames U32
    - cell U32
    - site SyntaxId
    - owner TypeId
    - scopes [ScopeUse]
    - given [TypeId]
    - gives SyntaxId
    - values U32
    - outer-cells U32

` Gathers into `scopes` the rules written in rules that the rules a name answers at an element
` of a class for values of the types `given` bring into view, as `apply-style-rules` resolves
` them: the class's, or else those of the style sheets the element sees, and then the rules
` written in rules that the element sees, with those `seen` after them; each within `frames`,
` the state cells `cell` and `outer-cells` and the `values` of the rules around, or its own. The
` application `gives` the values, or none does. Only a name some rule that brings any has is
` resolved. False where one is declined.
if !scoping-named(name)
    = true
. pending [ScopeUse]
. level = no-type
. member = DeclRef(0, 0)
if given.length == 0
    . (found, chosen, named) = class-style-rule(made, name)
    level = found
    member = chosen
else
    . (found, chosen, taken, mismatch) = match-style-rule(made, name, given)
    if found == invalid-type
        = false
    level = found
    member = chosen
if level != no-type
    if !gather-rule(made, member.module, member.decl, level, frames, cell, seen, site, owner, pending, gives, values, outer-cells)
        = false
else
    . sheets [TypeId]
    . members [DeclRef]
    . gates [U64]
    . (status, writes, missed) = sheet-rules(made, name, given, 0, sheets, members, gates, U32.max)
    if status != 0
        = false
    for position in 0 .. < sheets.length
        if !gather-rule(made, members[position].module, members[position].decl, sheets[position], frames, cell, seen, site, owner, pending, gives, values, outer-cells)
            = false
. scoped [ScopeUse]
. (scoping, found, missed) = scope-rules(made, name, given, seen, scoped, U32.max)
if scoping != 0
    = false
for use in scoped
    . holder = if types.intrinsic-of(use.scope.owner) == .style-sheet then use.scope.owner else made
    if !gather-rule(made, use.scope.module, use.scope.decl, holder, use.scope.frames, use.cell, seen, site, owner, pending, gives, use.values, use.outer-cells)
        = false
for use in pending
    scopes += use
= true

────────────────────
_ do gather-rule Bool
    - made TypeId
    - owner ModuleId
    - decl DeclId
    - holder TypeId
    - frames U32
    - cell U32
    - seen [ScopeUse]
    - site SyntaxId
    - read TypeId
    - scopes [ScopeUse]
    - gives SyntaxId
    - values U32
    - outer-cells U32

` Gathers the rules written in rules that a style rule matched for a class or style sheet
` (`holder`) brings into view, within `frames`, the state cells `cell` and `outer-cells` and the
` `values` of the rules around, as the reference's `nestedRuleScopesForMatch` gathers them: those
` the rules it applies after its name bring, within it, then its own (`bring-scopes`), with the
` state cells of its `when`s made at `site` for an object read as of class `read`, within those
` (`outer-links`), and the values the application `gives`, where one does (`scope-values`).
` False where one is declined: an
` application within it with a condition or values whose name has a rule that brings any, and
` values given within a rule around that takes some.
. around = instances.intern-frame(frames, owner, decl, holder, 0)
. framed = values
if gives != 0
    if values != U32.max
        = false
    framed = scope-values(gives, around)
. written = program.modules[owner].tree
do match? program.modules[owner].decls[decl]
    | .decl-style-rule(rule)
        do match? written.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for application in written.children[declared.style-rule-applications]
                    do match? written.nodes[application]
                        | .node-style-rule-application(applied)
                            if !scoping-named(applied.name)
                                continue
                            if applied.args.count != 0 && applied.condition == 0 && keying.discovering
                                continue
                            if applied.condition != 0 || applied.args.count != 0
                                = false
                            . none [TypeId]
                            if !gather-name(made, applied.name, seen, around, cell, site, read, scopes, none, 0, framed, outer-cells)
                                = false
                . body = declared.body
                do match? written.nodes[body]
                    | .node-block(block)
                        for statement in written.children[block.body]
                            if written.nodes[statement] is .node-rule-syntax
                                scopes += ScopeUse
                                    - RuleScope
                                        - owner
                                        - nested-decl(owner, decl, statement)
                                        - holder
                                        - around
                                        - scope-own(written, statement)
                                    - cell
                                    - framed
                                    - outer-cells
                for branch in rule-whens(written, body)
                    . gate = U32.max
                    . held = U32.max
                    . links = U32.max
                    for line in when-lines(written, branch)
                        if written.nodes[line] is .node-rule-syntax
                            if gate == U32.max
                                gate = instances.intern-frame(around, owner, decl, holder, branch)
                                held = when-cell(cell, site, read, owner, branch)
                                links = outer-links(held, cell, outer-cells)
                            scopes += ScopeUse
                                - RuleScope
                                    - owner
                                    - nested-decl(owner, decl, line)
                                    - holder
                                    - gate
                                    - scope-own(written, line)
                                - held
                                - framed
                                - links
= true

────────────────────
_ do scope-values U32
    - site SyntaxId
    - frame U32

` The values the application `site` of this instance gives the rule of a frame, which the rules
` written in it read, made once.
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if same-site && held.module == module && held.frame == frame
        = index as U32
    .. same-site = held.instance == instance && held.site == site
facts.scope-values += ScopeValues(instance, site, module, frame)
= (facts.scope-values.length - 1) as U32

────────────────────
_ do default-scopes
    - made TypeId
    - site SyntaxId
    - uses [ScopeUse]
    - takes-own Bool

` Adds to `uses` the rules written in the rule `• This` of each class of the chain of the class
` `made`, the base first, as the reference's `defaultMarkupStyleRuleScopes` gives them: those of
` its body, then those of each of its `when`s, with no rule around them but the `when`'s, under
` its state cell, made at a site, the markup element whose slots are given content or none for
` the markup a class's content makes. One written `• own` is added matching in the markup being
` filled (`scope-entered`) where the markup of the class's own `takes-own`, and else left out.
. chain [TypeId]
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . holder = chain[chain.length - 1 - position]
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        if rule.name.text != "This"
                            continue
                        . body = rule-body(owner.tree, rule.syntax)
                        do match? owner.tree.nodes[body]
                            | .node-block(block)
                                for statement in owner.tree.children[block.body]
                                    if nested && (takes-own || plain)
                                        uses += entered-use
                                            - ScopeUse
                                                - RuleScope
                                                    - ref.module
                                                    - nested-decl(ref.module, member, statement)
                                                    - holder
                                                    - U32.max
                                                    - scope-own(owner.tree, statement)
                                    .. nested = owner.tree.nodes[statement] is .node-rule-syntax
                                    .. plain = scope-own(owner.tree, statement) == .scope-plain
                        for branch in rule-whens(owner.tree, body)
                            . gate = U32.max
                            . held = U32.max
                            for line in when-lines(owner.tree, branch)
                                if nested-line && (takes-own || plain-line)
                                    if gate == U32.max
                                        gate = instances.intern-frame
                                            - U32.max
                                            - ref.module
                                            - member
                                            - holder
                                            - branch
                                        held = scope-cell(site, made, ref.module, branch)
                                    uses += entered-use
                                        - ScopeUse
                                            - RuleScope
                                                - ref.module
                                                - nested-decl(ref.module, member, line)
                                                - holder
                                                - gate
                                                - scope-own(owner.tree, line)
                                            - held
                                .. nested-line = owner.tree.nodes[line] is .node-rule-syntax
                                .. plain-line = scope-own(owner.tree, line) == .scope-plain
                        break

────────────────────
_ do gates-updates Bool
    - unit InstanceId

` Whether a style rule applied in the body of a `when` sets no property of its class, which
` the reference reports at the first line that does: a gated block of declarations may only
` declare styles.
for update in facts.rule-updates
    if update.instance == unit
        . row = instances.rows[unit]
        . written = program.modules[row.module].tree
        do match? written.nodes[update.site]
            | .node-assign(line)
                . name = identifier-name(written, line.lhs)
                if name
                    facts.record-diagnostic
                        - instance
                        - row.module
                        - line.lhs
                        - .stated
                        - conditional-update(name)
                        - no-type
                        - no-type
                    = false
        decline(update.site)
        = false
= true

────────────────────
_ do gate-when [StyleWhen]?
    - id SyntaxId
    - made TypeId
    - owner ModuleId
    - branch SyntaxId
    - gated [StyleWhen]

` The `when`s that gate the declarations of the body of a `when` of a style rule applied to an
` object of a class, the outermost first: those the rule is applied under, then this one. Its
` state must be a property of the class of type `Bool`, as the reference reports, which is
` read tracked, and the gate is recorded once (`StyleGate`), with the constructor of the
` action that runs it. None where it is reported or declined.
. written = program.modules[owner].tree
. state = program.store-atom("")
do match? written.nodes[branch]
    | .node-style-when(row)
        state = row.state
. place = types.property-named(made, state)
. shown = type-short-name(types, made)
if !place
    facts.record-diagnostic
        - instance
        - owner
        - branch
        - .stated
        - program.store-atom("Style state \"${state.text}\" is not a property of $shown")
        - no-type
        - no-type
    = null
. property = types.properties[place]
if property.storage-kind == .storage-getter
    decline(id)
    = null
. declared = property.type
if declared == no-type
    declared = demand-member(property, made, state)
if declared == invalid-type
    = null
if declared != types.bool-type
    facts.record-diagnostic(instance, owner, branch, .stated, program.store-atom("Style state \"${state.text}\" must be a boolean property, but $shown.${state.text} is ${type-display(types, declared)}"), declared, no-type)
    = null
instances.mark-may-panic(instance)
. key = panics.property-of(made, state)
if key
    panics.track(key)
. ref = class-ref(types, property.owner)
facts.note-tracked(ref.module, ref.decl, state)
demand-live-runtime()
. action = demand-style-gates(made)
if action == no-instance || instances.live.track == no-instance
    decline(id)
    = null
. whens [StyleWhen]
for held in gated
    whens += held
whens += StyleWhen(owner, branch)
record-gate(made, whens, action)
= whens

────────────────────
_ do record-gate
    - made TypeId
    - whens [StyleWhen]
    - action InstanceId
    - content = false

. found = facts.gate-of(made, whens, content)
if found != U32.max
    facts.gate-users += GateUser(instance, found)
    =
facts.gate-users += GateUser(instance, facts.style-gates.length as U32)
facts.style-gates += StyleGate
    - made
    - facts.style-gate-whens.length as U32
    - whens.length as U32
    - action
    - content
for held in whens
    facts.style-gate-whens += held

────────────────────
_ do demand-style-gates InstanceId
    - made TypeId

` The functions of the style runtime a gated block of declarations calls, typed once, and the
` constructor of the action that gates a block on an object of a class, `StyleDynamicAction`
` of the class, given the object, the trackers of the conditions and the callback that
` evaluates them again; or none.
demand-live-runtime()
if !demand-style-sites()
    = no-instance
. runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
. association = types.well-known-type("core/style", "StyleSiteAssociation")
. base = types.well-known-type("core/style", "StyleDynamicActionBase")
. pointer = types.well-known-type("core", "Pointer")
. live = types.live-action-type
if base == invalid-type || pointer == invalid-type || live == invalid-type
    = no-instance
. mark = scratch.types.mark
if runtime.open-block == no-instance
    scratch.types.push(association)
    runtime.open-block = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-open-block")
        - mark
    scratch.types.push(types.type-row(.int64))
    runtime.close-block = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-close-block")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(association)
    scratch.types.push(base)
    runtime.dynamic = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-dynamic")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.block-enabled = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-set-block-enabled")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
if blocks-missing || runtime.dynamic == no-instance || runtime.block-enabled == no-instance
    = no-instance
.. blocks-missing = runtime.open-block == no-instance || runtime.close-block == no-instance
scratch.types.push(made)
. action = types.class-named-with-args(module-id, program.store-atom("StyleDynamicAction"), mark)
scratch.types.rewind(mark)
if action == invalid-type
    = no-instance
types.complete(action)
scratch.types.push(made)
scratch.types.push
    - types.properties[types.property-named(live, program.store-atom("trackers"))!].type
scratch.types.push(instances.live.callback)
. made-action = calls.demand-constructor(action, mark)
scratch.types.rewind(mark)
= made-action

────────────────────
_ do demand-style-authors Bool
    - made TypeId

` The function of the style runtime a live action that declares a style again for an object
` calls, typed once, with those a gated block calls, whose action it is made by.
if demand-style-gates(made) == no-instance
    = false
. runtime = facts.style-runtime
if runtime.author-dynamic == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . pointer = types.well-known-type("core", "Pointer")
    if info == invalid-type || pointer == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.author-dynamic = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-dynamic")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.author-dynamic != no-instance

────────────────────
_ do runs-code Bool
    - unit InstanceId
    - written AST
    - value SyntaxId

` Whether a value an instance typed calls a function, but the constructor the program makes for
` a type that is no class, which makes the value and does nothing else.
for node in written.subtree-start(value) .. value
    . fact = facts.first-call(unit, node)
    if fact != no-fact && !makes-value(facts.calls[fact])
        = true
= false

────────────────────
_ do makes-value Bool
    - call CallFact

` Whether a call is of the constructor the program makes for a type that is no class.
if call.form != .call-constructor || call.next != no-fact
    = false
. row = instances.rows[call.callee]
if types.intrinsic-of(row.self-type) == .class
    = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.is-generated
= false

────────────────────
_ do report-recursion
    - active [InstanceId]
    - start Size
    - again InstanceId
    - owner ModuleId
    - at SyntaxId

` The reference's error for a style rule that comes to apply itself again: the names of the
` rules from the first time it was applied on, then its own, at the application that would.
. names = ""
for position in start .. < active.length
    names += "${rule-name(active[position])} -> "
names += rule-name(again)
. text = program.store-atom("Recursive style rule application: $names")
facts.record-diagnostic(instance, owner, at, .stated, text, no-type, no-type)

────────────────────
_ do rule-name String
    - unit InstanceId

` The name of the style rule an instance types.
. row = instances.rows[unit]
do match? program.modules[row.module].decls[row.initializer]
    | .decl-style-rule(rule)
        = rule.name.text
= ""

────────────────────
_ do rule-unit InstanceId
    - level TypeId
    - member DeclRef
    - made TypeId
    - site SyntaxId

` The instance that types a style rule a class or a style sheet writes, for the class or sheet
` `level`, and for a sheet's, the class `made` of the element it is applied to, as the reference
` resolves its names there; for a class's, under the styles of the element's vocabulary it
` reads (`rule-context`), applied at `site`. Typed now, or none where it is being typed already.
` The instance that applies it runs its code, and may panic where it does.
. element = if types.intrinsic-of(level) == .style-sheet then made else no-type
. context = if element == no-type then rule-context(level, member, made, site) else U32.max
. unit = instances.intern-initializer(member.module, member.decl, level, element, context)
if instances.rows[unit].state == .instance-in-progress
    = no-instance
demand-body(unit)
panics.note-inlined(instance, unit)
= unit

────────────────────
_ do rule-context U32
    - level TypeId
    - member DeclRef
    - made TypeId
    - site SyntaxId

` The styles a style rule a class writes is typed under beside those the class sees, where it is
` applied at `site` to an element of a class: each style the element sees, as `answers-alike`
` lists them, that declares a name a line of the rule declares which no style the class sees
` answers, in the order the element sees them, as the reference keys the function of a rule by
` the styles of the element's vocabulary it reads (`keyForMarkupStyleReads`); or none.
if types.intrinsic-of(level) != .class
    = U32.max
. written = program.modules[member.module].tree
. body SyntaxId = 0
do match? program.modules[member.module].decls[member.decl]
    | .decl-style-rule(rule)
        do match? written.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                body = declared.body
if body == 0
    = U32.max
. lines [SyntaxId]
do match? written.nodes[body]
    | .node-block(block)
        for statement in written.children[block.body]
            lines += statement
for branch in rule-whens(written, body)
    for statement in when-lines(written, branch)
        lines += statement
. own [TypeId]
. seen [TypeId]
if !add-visible-styles(level, own, site) || !add-visible-styles(made, seen, site)
    = U32.max
add-markup-styles(seen)
. wanted [Bool]
for _ in seen
    wanted += false
for statement in lines
    do match? written.nodes[statement]
        | .node-assign(line)
            . name = style-name(written, line.lhs)
            if line.op == .eq-op && name && !types.property-named(level, name) && style-answering(own, name) == no-type
                for position in 0 .. < seen.length
                    if names-style-property(seen[position], name)
                        wanted[position] = true
. extra [TypeId]
for position in 0 .. < seen.length
    if wanted[position] && own.find(seen[position]) == null
        extra += seen[position]
if extra.length == 0
    = U32.max
. sheets [TypeId]
. levels [U32]
. scopes [RuleScope]
. cells [U32]
. valued [U32]
= instances.intern-context(extra, sheets, levels, scopes, cells, no-type, 0, valued, sheets)

────────────────────
_ do unit-vocabulary [TypeId]?
    - named TypeId
    - syntax SyntaxId

` The styles the lines of a style rule an instance types declare names of: those `named` sees
` (`style-vocabulary`), then those of the context the instance is typed under (`rule-context`).
. styles = style-vocabulary(named, syntax)
. context = instances.rows[instance].context
if !styles || context == U32.max
    = styles
. held = instances.contexts[context]
. found = styles
for position in held.first .. < held.first + held.styles
    . used = instances.context-types[position]
    if found.find(used) == null
        found += used
= found

────────────────────
_ do shares-rule Bool
    - applied [InstanceId]
    - count U32

` Whether the reference compiles a rule matched by name into a function every element it
` matches calls, as `styleRuleIsShareable` says: one whose weight, with the rules it applies,
` is more than one, each style it declares and each `when` weighing one, and none of which
` sets a property of its class or generates content.
. weight = count
for unit in applied
    if facts.updates-properties(unit)
        = false
    . row = instances.rows[unit]
    . written = program.modules[row.module].tree
    do match? program.modules[row.module].decls[row.initializer]
        | .decl-style-rule(rule)
            do match? written.nodes[rule.syntax]
                | .node-rule-syntax(declared)
                    if rule-content(written, declared.body).length != 0
                        = false
                    for branch in rule-whens(written, declared.body)
                        if when-content(written, branch).length != 0
                            = false
                    weight += rule-whens(written, declared.body).length as U32
= weight > 1

────────────────────
_ do class-style-rule (TypeId, DeclRef, Bool)
    - made TypeId
    - name Atom

` The class of a chain, the most derived first, that writes a style rule of a name taking no
` values, and the rule, as the reference resolves a rule an element applies; and whether some
` class writes a rule of that name at all.
. named = false
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        if rule.name == name
                            named = true
                            if rule-takes-nothing(owner.tree, rule.syntax)
                                = (level, DeclRef(ref.module, member), true)
    level = types.base-of(level)
= (no-type, DeclRef(0, 0), named)

────────────────────
_ do match-style-rule (TypeId, DeclRef, Bool, U32)
    - made TypeId
    - name Atom
    - given [TypeId]

` The style rule a written application chooses by the types of its values, as the reference's
` `resolveMatch` chooses among the rules the classes of a chain write: in each class, the
` first rule of the name taking as many values, each convertible to the type the rule takes it
` as, that converts them most closely; then, of the classes, the most derived whose choice
` converts them most closely. Answers the class and the rule, or no type where none is chosen;
` whether some class writes a rule of the name; and the place of the last value found not to
` convert, at which the reference reports the mismatch, or `U32.max`. A type a rule takes that
` is not known here is answered as an invalid class with that rule, to be reported where it is
` written wrong (`report-argument-types`) or else declined.
. named = false
. mismatch = U32.max
. best = no-type
. best-member = DeclRef(0, 0)
. best-kind = 0u32
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . (found, chosen, kind, writes, missed) = match-rules-of(level, name, given, mismatch)
    if writes
        named = true
    mismatch = missed
    if found && kind == U32.max
        = (invalid-type, chosen, named, mismatch)
    if found && (best == no-type || kind > best-kind)
        best = level
        best-member = chosen
        best-kind = kind
    level = types.base-of(level)
= (best, best-member, named, mismatch)

────────────────────
_ do match-rules-of (Bool, DeclRef, U32, Bool, U32)
    - level TypeId
    - name Atom
    - given [TypeId]
    - mismatch U32

` The rule of a name a class or a style sheet writes that a written application chooses by the
` types of its values, as the reference's `matchRulesOf` chooses it: the first taking as many
` values, each convertible to the type the rule takes it as, that converts them most closely.
` A sheet writes the rules of its extensions after its own (`sheet-parts`). Answers whether
` there is one, the rule and how closely, `U32.max` for a type a rule takes that is not known
` here; whether the class writes a rule of the name; and the place of the last value found not
` to convert, or `mismatch` where none is.
. found = false
. named = false
. chosen = DeclRef(0, 0)
. kind = 0u32
. missed = mismatch
for part in sheet-parts(class-ref(types, level))
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-style-rule(rule)
                if rule.name != name
                    continue
                named = true
                if rule-takes(owner.tree, rule.syntax) != given.length
                    continue
                . written = DeclRef(part.module, member)
                . wanted = rule-argument-types(written)
                if !wanted
                    = (true, written, U32.max, named, missed)
                . fits = true
                . closeness = Specificity.exact as U32
                for position in 0 .. < given.length
                    . relation = conversions.compare-held(given[position], wanted[position])
                    if !relation-legal(relation)
                        missed = position as U32
                        fits = false
                        break
                    if (relation.match as U32) < closeness
                        closeness = relation.match
                if fits && (!found || closeness > kind)
                    found = true
                    chosen = written
                    kind = closeness
= (found, chosen, kind, named, missed)

────────────────────
_ rule-takes U32
    - written AST
    - syntax SyntaxId

match written.nodes[syntax]
    | .node-rule-syntax(row)
        row.args.count
    ??
        0

────────────────────
_ do rule-argument-types [TypeId]?
    - member DeclRef

` The types a style rule a class or a style sheet writes takes its values as, as it declares
` them, or none where one is not written or is not known without the class's type arguments.
do match? program.modules[member.module].decls[member.decl]
    | .decl-style-rule(rule)
        = written-argument-types(member.module, rule.owner, member.decl)
= null

────────────────────
_ do written-argument-types [TypeId]?
    - module ModuleId
    - class DeclId
    - member DeclId

` The types a style rule written in a class of a module, or in an extension of a style sheet,
` or in a rule of either, takes its values as, as `rule-argument-types` says.
. owner = program.modules[module]
. taken [TypeId]
do match? owner.decls[member]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(row)
                . env = holder-env(DeclRef(module, class))
                for arg in owner.tree.children[row.args]
                    . written = argument-type-syntax(owner.tree, arg)
                    . type = if written != 0 then types.evaluate-type(module, owner.tree, written, env) else invalid-type
                    if type == invalid-type || types.completions[type].has-variables
                        types.env-release(env)
                        = null
                    taken += type
                types.env-release(env)
= taken

────────────────────
_ do report-argument-types Bool
    - member DeclRef

` Reports a value a style rule takes whose type is written wrong, where it is written, as the
` reference's `resolveMatch` reports it as it matches the rule (`argument-type-error`). Says
` whether one was reported.
. owner = program.modules[member.module]
do match? owner.decls[member.decl]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(row)
                . env = holder-env(DeclRef(member.module, rule.owner))
                for arg in owner.tree.children[row.args]
                    . (at, message) = argument-type-error(member.module, arg, env)
                    if at != 0
                        types.env-release(env)
                        report-at(member.module, at, message)
                        = true
                types.env-release(env)
= false

────────────────────
_ do argument-type-error (SyntaxId, String)
    - owner ModuleId
    - argument SyntaxId
    - env TypeEnv

` Where a value a style rule takes is written wrong, and the reference's error there: a name
` written with no type, a type written that names nothing (`missing-type`), or a type written
` with no name, which the reference refuses as the rule binds it. None where it is written right.
. written = program.modules[owner].tree
do match? written.nodes[argument]
    | .node-argument-decl(row)
        do match? written.nodes[row.pattern]
            | .node-type-capture(capture)
                if capture.type == 0
                    = (argument, "Argument type not found")
                = (types.missing-type(owner, written, capture.type, env), "Type not found")
        . missing = types.missing-type(owner, written, row.pattern, env)
        if missing != 0
            = (missing, "Type not found")
        = (row.pattern, "Invalid argument")
= (0, "")

────────────────────
_ argument-type-syntax SyntaxId
    - written AST
    - argument SyntaxId

` The type written for a value a style rule takes, `name Type`, or none.
match written.nodes[argument]
    | .node-argument-decl(row)
        match written.nodes[row.pattern]
            | .node-type-capture(capture)
                capture.type
            ??
                0
    ??
        0

────────────────────
_ rule-takes-nothing Bool
    - written AST
    - syntax SyntaxId

match written.nodes[syntax]
    | .node-rule-syntax(row)
        row.args.count == 0
    ??
        false

────────────────────
_ do applies-rules Bool
    - written AST
    - syntax SyntaxId

` Whether a style rule applies rules, after its name or in the body of a `when`.
do match? written.nodes[syntax]
    | .node-rule-syntax(row)
        if row.style-rule-applications.count != 0
            = true
        for branch in rule-whens(written, row.body)
            if when-applications(written, branch).length != 0
                = true
= false

────────────────────
_ rule-body SyntaxId
    - written AST
    - syntax SyntaxId

match written.nodes[syntax]
    | .node-rule-syntax(row)
        row.body
    ??
        0

────────────────────
_ do rule-whens [SyntaxId]
    - written AST
    - body SyntaxId

` The `when`s of the body of a style rule, in the order written.
. whens [SyntaxId]
if body == 0
    = whens
do match? written.nodes[body]
    | .node-block(block)
        for statement in written.children[block.body]
            if written.nodes[statement] is .node-style-when
                whens += statement
= whens

────────────────────
_ do when-lines [SyntaxId]
    - written AST
    - branch SyntaxId

` The lines of the body of a `when` of a style rule, in the order written: the one line of a
` `when` written on one, or those of its block.
. lines [SyntaxId]
do match? written.nodes[branch]
    | .node-style-when(row)
        do match? written.nodes[row.body]
            | .node-block(block)
                for line in written.children[block.body]
                    lines += line
            ??
                lines += row.body
= lines

────────────────────
_ do rule-content [SyntaxId]
    - written AST
    - body SyntaxId

` The lines of the body of a style rule that generate content, in the order written: markup
` elements that bind a slot.
. lines [SyntaxId]
do match? written.nodes[body]
    | .node-block(block)
        for line in written.children[block.body]
            if generates(written, line)
                lines += line
= lines

────────────────────
_ when-content [SyntaxId]
    - written AST
    - branch SyntaxId

` The lines of the body of a `when` of a style rule that generate content, in the order written.
each in when-lines(written, branch) when generates(written, each)

────────────────────
_ generates Bool
    - written AST
    - line SyntaxId

` Whether a line of a style rule generates content: a markup element that binds a slot.
match written.nodes[line]
    | .node-markup(row)
        row.slot-binding != 0
    ??
        false

────────────────────
_ when-applications [SyntaxId]
    - written AST
    - branch SyntaxId

` The rules the body of a `when` of a style rule applies, in the order written.
each in when-lines(written, branch) when written.nodes[each] is .node-style-rule-application

────────────────────
_ do implicit-names [String]
    - made TypeId
    - type-id SyntaxId
    - element SyntaxId
    - written AST

` The names a style rule that takes no values matches a markup element by, as the reference
` applies one without its being written, each once, in its order: the name of each class of
` the element's chain, base first, the type written, and the element's id spelled as a
` selector, each capital a hyphen and its small letter, as `written`. `This` matches nothing.
. chain [String]
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            chain += class.name.text
    level = types.base-of(level)
. names [String]
for position in 0 .. < chain.length
    add-name(names, chain[chain.length - 1 - position])
do match? written.nodes[written-base(written, type-id)]
    | .node-type-identifier(typed)
        if !typed.is-declare
            add-name(names, typed.name.text)
do match? written.nodes[element]
    | .node-identifier(named)
        add-name(names, selector-name(named.name.text))
= names

────────────────────
_ do add-name
    - names [String]
    - name String

if name != "This" && names.find(name) == null
    names += name

────────────────────
_ written-base SyntaxId
    - written AST
    - id SyntaxId

` A type written with type arguments as the type they are given to.
match written.nodes[id]
    | .node-type-arguments(row)
        written-base(written, row.base)
    ??
        id

────────────────────
_ do overlay-rule Bool
    - name Atom

` Whether a style rule of a name may be answered other than by a class of the element that
` applies it, a style sheet it sees, or a rule written in a rule that it sees where those are
` known (`scopes-known`), as the reference also looks: by a rule written in a rule where they
` are not, or by one written at the top of a module. What answers is not modeled.
if !scopes-known() && nested-named(name)
    = true
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    if !program.shares-case(module, ref.module)
        continue
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-style-rule(rule)
            if rule.owner == 0
                = true
= false

────────────────────
_ do list-style-rules

` Lists, once, the style rules the program writes and the names of those written in rules; and
` the names of those that bring rules written in rules into view where they are applied
` (`scoping-names`): those with rules written in them, and those that apply one of those names
` after their own. Each name is listed with the module that writes the rule, and is seen only
` from the modules that share a case of a batch with it (`shares-case`), as one program sees all.
=? if facts.rules-listed
facts.rules-listed = true
for position in 0 .. < program.modules.length
    . owner = program.modules[position]
    . place = position as ModuleId
    . index = 0u32
    for decl in owner.decls
        do match? decl
            | .decl-style-rule(rule)
                if rule.outer != 0
                    facts.nested-rules += rule.name
                    facts.nested-modules += place
                    do match? owner.decls[rule.outer]
                        | .decl-style-rule(around)
                            if !lists-scoping(around.name, place)
                                facts.scoping-names += around.name
                                facts.scoping-modules += place
                else
                    facts.add-style-rule(DeclRef(place, index), rule.name)
        index += 1
. growing = facts.scoping-names.length != 0
while growing
    growing = false
    for position in 0 .. < program.modules.length
        . owner = program.modules[position]
        . place = position as ModuleId
        for decl in owner.decls
            do match? decl
                | .decl-style-rule(rule)
                    if lists-scoping(rule.name, place)
                        continue
                    do match? owner.tree.nodes[rule.syntax]
                        | .node-rule-syntax(written)
                            for application in owner.tree.children[written.style-rule-applications]
                                do match? owner.tree.nodes[application]
                                    | .node-style-rule-application(applied)
                                        if scoping-from(applied.name, place) && unlisted
                                            facts.scoping-names += rule.name
                                            facts.scoping-modules += place
                                            growing = true
                                        .. unlisted = !lists-scoping(rule.name, place)

────────────────────
_ do lists-scoping Bool
    - name Atom
    - owner ModuleId

` Whether `scoping-names` lists a name for a module that writes a rule of it.
for position in 0 .. < facts.scoping-names.length
    if facts.scoping-names[position] == name && facts.scoping-modules[position] == owner
        = true
= false

────────────────────
_ do scoping-from Bool
    - name Atom
    - from ModuleId

` Whether a module sees a name `scoping-names` lists: one a module it shares a case with writes.
for position in 0 .. < facts.scoping-names.length
    if facts.scoping-names[position] == name && case-shared
        = true
    .. case-shared = program.shares-case(from, facts.scoping-modules[position])
= false

────────────────────
_ scoping-named Bool
    - name Atom

` Whether the module being typed sees a name `scoping-names` lists.
scoping-from(name, module)

────────────────────
_ do scoping-any Bool

` Whether the module being typed sees any name `scoping-names` lists.
for owner in facts.scoping-modules
    if program.shares-case(module, owner)
        = true
= false

────────────────────
_ do nested-named Bool
    - name Atom

` Whether a module the module being typed shares a case with writes a rule of a name in a rule.
for position in 0 .. < facts.nested-rules.length
    if facts.nested-rules[position] == name && case-shared
        = true
    .. case-shared = program.shares-case(module, facts.nested-modules[position])
= false

────────────────────
_ do nested-any Bool

` Whether a module the module being typed shares a case with writes a rule in a rule.
for owner in facts.nested-modules
    if program.shares-case(module, owner)
        = true
= false

────────────────────
_ do sheet-rule-name Bool
    - name Atom

` Whether a style sheet writes a style rule of a name, in a module the module being typed shares
` a case with.
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    if !program.shares-case(module, ref.module)
        continue
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-style-rule(rule)
            if rule.owner != 0 && is-sheet-decl(ref.module, rule.owner)
                = true
= false

────────────────────
_ do selector-name String
    - name String

` An id as a style rule's name matches it: each capital is a hyphen and its small letter.
. spelled = ""
for char in name
    if char >= 'A' && char <= 'Z'
        spelled += "-"
        spelled += "$char".lowercased
    else
        spelled += char
= spelled

────────────────────
_ do answers-alike Bool
    - unit InstanceId
    - made TypeId
    - site SyntaxId

` Whether each property a style rule declares, typed for the class that writes it, is answered
` by the same style where the rule is applied to an element of a class: the reference resolves
` the names there, in the element's vocabulary, with that of a style sheet that writes the
` rule last.
. styles [TypeId]
if !add-visible-styles(made, styles, site)
    = false
add-markup-styles(styles)
. writer = instances.rows[unit].self-type
if types.intrinsic-of(writer) == .style-sheet && !add-visible-styles(writer, styles, site)
    = false
. owner = program.modules[instances.rows[unit].module].tree
. place = facts.first-style-declaration(unit)
while place != U32.max
    . row = facts.style-declarations[place]
    do match? owner.nodes[row.site]
        | .node-assign(line)
            . name = style-name(owner, line.lhs)
            if !name || style-answering(styles, name) != row.style
                = false
    place = facts.next-style-declaration(place)
= true

────────────────────
_ do check-style-unit
    - receiver TypeId
    - syntax SyntaxId
    - writer DeclId

` Types a style rule for the class that writes it, as a rule of the class is typed, with
` `this` bound and each value it takes of the type the class declares for it. Each line of its
` body, in the order written, sets a property of the class (`update-unit-property`) or names a
` property of a style the class sees and declares its value, typed and converted as an
` element's declaration is. A name no style answers is the reference's error. The lines of
` each `when` follow, which may only declare styles, as the reference reports. A declared
` value that reads something tracked is declared again as it changes where the rule is applied
` (`StyleAuthor`), and `inherit` takes the value from the parent (`declare-inherit`). A value the
` runtime holds a handle to is declared as an element's is. Any other line, and a declared
` value that reads a value the rule takes and something tracked, are declined. The rules a rule
` applies are resolved where
` it is applied. A rule answers nothing.
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, writer)))
if sheet-rule() && instances.rows[instance].element == no-type
    if !report-missing-type(syntax, frame.env) && assign-rule-arguments(syntax, true) && assign-outer-arguments(true)
        type-sheet-lines(receiver, syntax)
else if assign-rule-arguments(syntax) && assign-outer-arguments()
    declare-unit-styles(receiver, syntax)
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do type-sheet-lines
    - sheet TypeId
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        if rule.body == 0
            =
        . styles [TypeId]
        if !add-visible-styles(sheet, styles, syntax)
            =
        do match? tree.nodes[rule.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    type-sheet-line(statement, sheet, styles)
                for branch in rule-whens(tree, rule.body)
                    for statement in when-lines(tree, branch)
                        type-sheet-line(statement, sheet, styles)

────────────────────
_ do type-sheet-line
    - statement SyntaxId
    - sheet TypeId
    - styles [TypeId]

do match? tree.nodes[statement]
    | .node-rule-syntax
        type-nested-rule(statement, sheet)
    | .node-assign(line)
        . name = identifier-name(tree, line.lhs)
        if line.op != .eq-op || !name
            =
        . answering = style-answering(styles, name)
        if answering == no-type || answering == invalid-type
            =
        . (_, declared) = declared-style-property(answering, name)
        if untyped || !sheet-value-typed(line.rhs, sheet, declared)
            =
        .. untyped = declared == no-type || declared == invalid-type
        . written = style-value(line.rhs, declared)
        if written != no-type && written != invalid-type
            conversions.convert(statement, line.rhs, written, declared, .reason-assignment)

────────────────────
_ do sheet-value-typed Bool
    - value SyntaxId
    - sheet TypeId
    - declared TypeId

if is-inherit(value) || reads-tracked(value) || reads-slots(value) || reads-member
    = false
.. reads-member = reads-sheet-member(value, sheet)
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            . styled = (resolution-flags /and/ ResolutionFlag.resolution-styled) != 0
                .. resolution-flags = bindings.resolution-of(frame.binding, node).flags
            if styled && (node != value || !bare-case(declared, row.name))
                = false
= true

────────────────────
_ do type-nested-rule
    - syntax SyntaxId
    - sheet TypeId

=? if !sheet-rule()
. nested = nested-decl(module, instances.rows[instance].initializer, syntax)
=? if nested == 0
. unit = instances.intern-initializer(module, nested, sheet)
if instances.rows[unit].state == .instance-unstarted
    demand-body(unit)

────────────────────
_ do assign-rule-arguments Bool
    - syntax SyntaxId
    - quiet Bool = false

` Gives each value a style rule takes, `name Type`, the type the class declares for it.
do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        for arg in tree.children[rule.args]
            . declared = argument-type-syntax(tree, arg)
            . named SyntaxId = 0
            do match? tree.nodes[arg]
                | .node-argument-decl(row)
                    do match? tree.nodes[row.pattern]
                        | .node-type-capture(capture)
                            named = capture.id
            . resolution = bindings.resolution-of(frame.binding, named)
            if declared == 0 || named == 0 || resolution.kind != .resolve-slot
                if !quiet
                    decline(arg)
                = false
            . type = types.evaluate-type(module, tree, declared, frame.env)
            if type == invalid-type
                if !quiet
                    decline(arg)
                = false
            frame.assign(resolution.slot, type)
= true

────────────────────
_ do assign-outer-arguments Bool
    - quiet Bool = false

` Gives each value the rules around a rule written in a rule take the type the class declares
` for it, as the reference defines the values of the frames it is applied within
` (`withStyleRuleLexicalFrames`), which the rule reads as the frame gives them.
. decls = program.modules[module].decls
. outer DeclId = 0
do match? decls[instances.rows[instance].initializer]
    | .decl-style-rule(rule)
        outer = rule.outer
while outer != 0
    . next DeclId = 0
    do match? decls[outer]
        | .decl-style-rule(rule)
            if !assign-rule-arguments(rule.syntax, quiet)
                = false
            next = rule.outer
    outer = next
= true

────────────────────
_ do marks-up-class Bool
    - syntax SyntaxId

` Whether the lines of a style rule that are not its own (`rule-part`) are the markup of the
` class that writes it: the rule is that class's `• This`, which the class keeps as its content
` (`defaults-content`), so its markup function types them and the rule does not.
. decl = instances.rows[instance].initializer
do match? program.modules[module].decls[decl]
    | .decl-style-rule(rule)
        do match? program.modules[module].decls[rule.owner]
            | .decl-class(class)
                = class.content == syntax
= false

────────────────────
_ do sheet-rule Bool

` Whether the style rule an instance types is written in a style sheet, whose lines may only
` declare styles and generate content: any other line is the reference's error.
. decl = instances.rows[instance].initializer
do match? program.modules[module].decls[decl]
    | .decl-style-rule(rule)
        = is-sheet-decl(module, rule.owner)
= false

────────────────────
_ do declare-unit-styles
    - receiver TypeId
    - syntax SyntaxId

` Types the lines of a style rule's body, as `check-style-unit` says, for the class or style
` sheet that writes it. The names it declares are those of the styles the class sees, then those
` of the context it is typed under, or for a rule a style sheet writes, those the class of the
` element it is typed for sees, then the sheet's, as the reference resolves them where the rule
` is applied (`unit-vocabulary`).
do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        type-applied-values(receiver, rule)
        if rule.body == 0
            =
        . styles [TypeId]? = null
        . element = instances.rows[instance].element
        . named = if element != no-type then element else receiver
        . order U32
        . marks-up = marks-up-class(syntax)
        do match? tree.nodes[rule.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(line)
                            . name = identifier-name(tree, line.lhs)
                            if assigning && name && is-class && types.property-named(receiver, name)
                                if !update-unit-property(statement, line, receiver, name)
                                    =
                                continue
                            .. assigning = line.op == .eq-op
                            .. is-class = types.intrinsic-of(receiver) == .class
                        | .node-style-when
                            continue
                        | .node-rule-syntax
                            type-nested-rule(statement, receiver)
                            continue
                    if !tree.rule-part(statement)
                        if marks-up
                            continue
                        if sheet-rule()
                            frame.diagnose(statement, .stated, program.store-atom("StyleSheet style rules may only contain style declarations and generated content"))
                            =
                    do match? tree.nodes[statement]
                        | .node-markup
                            if content-slot(statement) == U32.max
                                =
                            continue
                        | .node-markup-slot-forward
                            do content-slot(statement)
                            =
                    if !styles
                        styles = unit-vocabulary(named, syntax)
                        if !styles
                            =
                    if !declare-unit-style(statement, syntax, receiver, styles, order)
                        =
                    order += 1
                for branch in rule-whens(tree, rule.body)
                    for statement in when-lines(tree, branch)
                        do match? tree.nodes[statement]
                            | .node-style-rule-application
                                continue
                            | .node-rule-syntax
                                type-nested-rule(statement, receiver)
                                continue
                            | .node-markup
                                if content-slot(statement) == U32.max
                                    =
                                continue
                            | .node-markup-slot-forward
                                do content-slot(statement)
                                =
                            | .node-assign(line)
                                . name = identifier-name(tree, line.lhs)
                                if name && types.property-named(receiver, name)
                                    frame.diagnose(line.lhs, .stated, conditional-update(name))
                                    =
                        if !styles
                            styles = unit-vocabulary(named, syntax)
                            if !styles
                                =
                        if !declare-unit-style(statement, syntax, receiver, styles, order)
                            =
                        order += 1
            ??
                decline(rule.body)

────────────────────
_ do rule-writer TypeId
    - receiver TypeId

` The class that writes the style rule an instance types, where it is no class of the receiver's
` chain, as a rule written in a rule of one class is typed for the class of the element it
` matches; the receiver otherwise, or where the writer takes type arguments the receiver does
` not give.
do match? program.modules[module].decls[instances.rows[instance].initializer]
    | .decl-style-rule(rule)
        do match? program.modules[module].decls[rule.owner]
            | .decl-class(class)
                if class.type-args.count == 0 && same-holder && not-owner
                    = types.intern-class(module, rule.owner, scratch.types.mark)
                .. same-holder = holding-type(receiver, DeclRef(module, rule.owner)) == receiver
                .. not-owner = !same-decl(class-ref(types, receiver), DeclRef(module, rule.owner))
= receiver

────────────────────
_ do content-slot U32
    - line SyntaxId

` The slot a line of a style rule that generates content fills, 0 to 3 for before, after,
` first-child and last-child, as the reference's `styleContentTemplateFor` reads it. A line that
` forwards a slot, one that names the item of a slot that repeats, and a slot of another name are
` the reference's errors, and a markup line that binds no slot is declined; each answers
` `U32.max`.
. binding SyntaxId = 0
. parameter SyntaxId = 0
do match? tree.nodes[line]
    | .node-markup(row)
        binding = row.slot-binding
        parameter = row.slot-parameter
    | .node-markup-slot-forward(row)
        frame.diagnose
            - row.slot-binding
            - .stated
            - program.store-atom("Style content slots cannot forward markup slots")
        = U32.max
. name = identifier-name(tree, binding) if binding != 0
if !name
    decline(line)
    = U32.max
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(written)
        frame.diagnose
            - written.name
            - .stated
            - program.store-atom("Style content slots cannot declare a repeated slot parameter")
        = U32.max
. text = name.text
if text == "before"
    = 0
if text == "after"
    = 1
if text == "first-child"
    = 2
if text == "last-child"
    = 3
frame.diagnose(binding, .stated, program.store-atom("Unknown style content slot \"${text}\"; expected before, after, first-child, or last-child"))
= U32.max

────────────────────
_ do conditional-update Atom
    - name Atom

` The reference's error for a line of a style rule that sets a property of its class where the
` rule's declarations are gated by a `when`.
= program.store-atom("Conditional style declarations may only set style properties, and \"${name.text}\" is an object property")

────────────────────
_ do type-applied-values
    - receiver TypeId
    - rule ASTRule

` Types the values a style rule gives each rule it applies, after its name and then in the
` body of each `when`, as written, with nothing expected, and converts each to the type the
` rule the class chooses by them takes it as (`match-style-rule`), or where no class of its
` chain answers the name, the rule of style sheets it chooses (`own-sheet-rule`). An element
` whose class or sheets choose another is declined where the rule is applied (`apply-rule`).
` A value names the slots of the style sheets the class that writes the rule sees
` (`rule-writer`), which a rule written in a rule matches against another class's elements.
. applications [SyntaxId]
. writer = rule-writer(receiver)
for nested in tree.children[rule.style-rule-applications]
    applications += nested
for branch in rule-whens(tree, rule.body)
    for nested in when-applications(tree, branch)
        applications += nested
for nested in applications
    do match? tree.nodes[nested]
        | .node-style-rule-application(applied)
            if applied.args.count == 0
                continue
            . given [TypeId]
            for value in tree.children[applied.args]
                . sheet = types.intrinsic-of(receiver) == .style-sheet
                . scope = enter-theme
                    - if sheet then no-type else writer
                    - if sheet then receiver else no-type
                    - nested
                . type = infer(value)
                leave-theme(scope)
                if type == invalid-type || type == no-type
                    =
                given += type
            . (level, member, taken, mismatch) = match-style-rule(receiver, applied.name, given)
            . chosen = if level != no-type && level != invalid-type then member else DeclRef(0, 0)
            if level == no-type && !taken
                chosen = own-sheet-rule(receiver, applied.name, given)
            if chosen.decl != 0
                . wanted = rule-argument-types(chosen)
                for position in 0 .. < given.length
                    . value = tree.children[applied.args.start + position]
                    conversions.convert
                        - value
                        - value
                        - given[position]
                        - wanted![position]
                        - .reason-argument

────────────────────
_ do update-unit-property Bool
    - statement SyntaxId
    - line ASTAssign
    - receiver TypeId
    - name Atom

` A line of a style rule that names a property of the class that writes it, which sets the
` property where the rule is applied, as an attribute of a markup element sets one: the value
` is converted to the property's type as one assigned is. A value that reads something
` tracked or a slot of a style sheet is set again as it changes by a function of its own, as an
` attribute's is (`settle-update`), and one that reads a value the rule takes where an application
` gives it values that do (`values-live`). A property a setter answers, a getter, and one of an array are declined.
. place = types.property-named(receiver, name)
. property = types.properties[place!]
. live = reads-tracked(line.rhs) || reads-slots(line.rhs)
if property.storage-kind == .storage-getter || is-hidden(property, name, .setter-decl)
    decline(statement)
    = false
. declared = property.type
if declared == no-type
    declared = demand-member(property, receiver, name)
if declared == no-type || declared == invalid-type || is-array-value(declared)
    decline(statement)
    = false
expect-bullets(line.rhs, declared)
. outer = unit-styling
unit-styling = unit-styling.updating = if live then statement else 0u32
. written = infer-with-expected(line.rhs, declared)
unit-styling = outer
if written == invalid-type || written == no-type
    = false
if conversions.convert(statement, line.rhs, written, declared, .reason-assignment) == invalid-type
    = false
. noted = panics.property-of(receiver, name)
if noted
    panics.note-write(instance, noted)
. given = !live && reads-rule-values(line.rhs)
facts.rule-updates += RuleUpdate(instance, statement, place! as U32, given)
if given
    owner-conversions(statement, receiver)
= !live || settle-update(statement, receiver, place! as U32)

────────────────────
_ do owner-conversions
    - statement SyntaxId
    - receiver TypeId

` Converts the object a line of a style rule that sets a property of its class is applied to, at
` the line, to the owner of the live action that sets it again: as its host where the class is a
` markup host, or as a batch where it is one.
. host = derived-interface(receiver, types.markup-host-decl)
if host != no-type
    conversions.convert(statement, statement, receiver, host, .reason-markup-host)
if is-batch(receiver)
    conversions.convert(statement, statement, receiver, batch-type(), .reason-markup-batch)

────────────────────
_ do settle-update Bool
    - statement SyntaxId
    - receiver TypeId
    - place U32

` Types the function that sets again the property a line of a style rule sets where its value
` read something tracked, as `settle-attributes` types an attribute's: the local no name
` reaches that keeps the object, declared at the line, holds one of the class. The action is
` made where the rule is applied (`rule-updater`), for the object as its host where the class
` is a markup host, to which it is converted at the line, or as a batch where it is one.
. position = facts.live-statements.length
while position != 0
    position -= 1
    . live = facts.live-statements[position]
    if live.instance != instance || live.site != statement || live.rerun != no-instance
        continue
    . resolution = bindings.resolution-of(frame.binding, statement)
    if resolution.kind != .resolve-slot || types.intrinsic-of(receiver) != .class
        decline(statement)
        = false
    frame.assign(resolution.slot, receiver)
    . rerun = demand-lambda(intern-nested(nested-decl-of(statement)), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(statement)
        = false
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement(instance, statement, rerun, 0, place)
    owner-conversions(statement, receiver)
    = true
. resolution = bindings.resolution-of(frame.binding, statement)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, receiver)
= true

────────────────────
_ do declare-unit-style Bool
    - statement SyntaxId
    - rule SyntaxId
    - receiver TypeId
    - styles [TypeId]
    - order U32

do match? tree.nodes[statement]
    | .node-assign(line)
        . name = style-name(tree, line.lhs)
        . sheet = types.intrinsic-of(receiver) == .style-sheet
        if line.op != .eq-op || !name || (!sheet && types.property-named(receiver, name))
            decline(statement)
            = false
        . (index, position) = find-style-property(styles, name, statement)
        if position == U32.max
            if (index == U32.max && program.module-by-name("core/style")) || sheet
                decline(statement)
            else if index == U32.max
                frame.diagnose(line.lhs, .stated, program.store-atom("Property not found"))
            = false
        . property = facts.style-properties[position]
        if sheet
            . slotted = declare-own-slot
                - statement
                - rule
                - index
                - position
                - order
                - line.rhs
                - receiver
            if slotted != 0
                = slotted == 1
            if reads-sheet-member(line.rhs, receiver)
                decline(statement)
                = false
        if is-inherit(line.rhs)
            = declare-inherit(statement, rule, index, position, 0, order)
        if !sheet && defers-slot(line.rhs)
            if !demand-style-sites() || !demand-sheet-declarations()
                decline(statement)
                = false
            facts.add-style-declaration
                - StyleDeclaration
                    - instance
                    - rule
                    - statement
                    - facts.style-uses[index].type
                    - position
                    - 0
                    - order
                    - true
                    - false
                    - false
                    - U32.max - 1
            = true
        if !style-value-ready(property.type) || !demand-style-sites()
            decline(statement)
            = false
        . live = reads-tracked(line.rhs) || reads-slots(line.rhs)
        if live && (reads-rule-values(line.rhs) || !demand-style-authors(receiver))
            decline(statement)
            = false
        . outer = unit-styling
        unit-styling = unit-styling.styling = if live then statement else 0u32
        . scope = enter-theme
            - if sheet then no-type else rule-writer(receiver)
            - if sheet then receiver else no-type
            - statement
        . written = style-value(line.rhs, property.type)
        . themed = leave-theme(scope)
        unit-styling = outer
        if written == invalid-type || written == no-type
            = false
        if conversions.convert(statement, line.rhs, written, property.type, .reason-assignment) == invalid-type
            = false
        if themed != U32.max
            = declare-themed(statement, rule, index, position, 0, order, line.rhs, themed)
        . cached = !live && holds-handle(property.type) && declaration-static(line.rhs)
        if cached
            note-static-value(statement, property.type)
        . declaration = StyleDeclaration
            - instance
            - rule
            - statement
            - facts.style-uses[index].type
            - position
            - 0
            - order
            - fixed-style-value(line.rhs)
            - false
            - cached
        declaration.reads-given = !live && reads-rule-values(line.rhs)
        if !live && !declaration.fixed && !cached
            . given = rule-value-slots(rule)
            if given.length != 0
                if holds-handle(property.type)
                    declaration.once-given = given-static(line.rhs, given)
                else
                    declaration.fixed-given = given-fixed(line.rhs, given)
        facts.add-style-declaration(declaration)
        if live
            facts.style-authors += StyleAuthor(instance, statement)
        = true
decline(statement)
= false

────────────────────
_ do declare-inherit Bool
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - layer U32
    - order U32

` A declaration of `inherit`, as the reference makes one: the runtime takes the property's value
` from the parent as it settles, for a property that is `@inherited`; for any other it is the
` reference's error.
. property = facts.style-properties[position]
if (property.flags /and/ 1) == 0
    frame.diagnose(statement, .stated, program.store-atom("Style property \"${property.name.text}\" is not @inherited, so it cannot be assigned \"inherit\""))
    = false
if !demand-style-inherits()
    decline(statement)
    = false
facts.add-style-declaration
    - StyleDeclaration
        - instance
        - element
        - statement
        - facts.style-uses[index].type
        - position
        - layer
        - order
        - true
        - true
= true

────────────────────
_ do style-value-ready Bool
    - type TypeId

` Whether the runtime has what declares a value of a style property's type: a number or a
` truth is its own bits, as is a union whose cases are each a whole number of at most 32 bits;
` an object, a value boxed, and any other union are held by the runtime's holders
` (`demand-style-holders`), each case of a union that is no such number by its own. A union
` nested in a union has no shape here.
if !holds-handle(type)
    = true
if !demand-style-holders()
    = false
. inner = if types.is-optional(type) then types.optional-inner(type) else type
if types.intrinsic-of(inner) != .union
    = style-holder-ready(inner)
for item in types.cases-of(inner)
    if !inline-style-case(item.type) && !style-holder-ready(item.type)
        = false
= true

────────────────────
_ do style-holder-ready Bool
    - type TypeId

` Whether a style value of a type that is no union has a holder of the runtime's: an object
` its `StyleValueHolder`, which takes it as its optional, and any other value its box. The
` instance typed is noted as holding an object so (`Facts.coding-users`).
if types.intrinsic-of(type) == .union
    = false
. object = types.intrinsic-of(type) == .class
if !demand-style-coding(type, object)
    = false
if !object
    = true
for position in 0 .. < facts.style-codings.length
    . coding = facts.style-codings[position]
    if coding.type == type && coding.intern != no-instance
        if coding.value-holder == no-instance
            . box = types.well-known-type-of("core/style", "StyleValueHolder", type)
            if box == invalid-type
                = false
            . mark = scratch.types.mark
            scratch.types.push(coding.taken)
            . holder = calls.demand-constructor(box, mark)
            scratch.types.rewind(mark)
            if holder == no-instance
                = false
            facts.style-codings[position].value-holder = holder
        facts.coding-users += CodingUser(instance, type, true)
        = true
= false

────────────────────
_ do holds-handle Bool
    - type TypeId

` Whether the runtime holds a handle to a value of a style property's type, as the reference's
` `styleValueNeedsHolder` says: an object, a value boxed, or a union with a case that is no
` whole number of at most 32 bits.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
if scalar-style(inner)
    = false
if types.intrinsic-of(inner) != .union
    = true
for item in types.cases-of(inner)
    if !inline-style-case(item.type)
        = true
= false

────────────────────
_ inline-style-case Bool
    - type TypeId

` Whether a case of a union style value is kept in the slot's bits above its number: a whole
` number of at most 32 bits.
size > 0 && size <= 32 && is-integer-kind(types.intrinsic-of(type))

.. size = types.completions[type].bit-size

────────────────────
_ do declaration-static Bool
    - value SyntaxId

` Whether a style value reads nothing that differs from one making of the element, or one
` application of the rule, to the next, as the reference's `styleExpressionIsDeclarationStatic`
` says: no style, no name tracked, no `this`, and no local, argument or member.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . kind = bindings.resolution-of(frame.binding, node).kind
            if kind == .resolve-slot || kind == .resolve-member
                = false
= true

────────────────────
_ do note-static-value
    - statement SyntaxId
    - type TypeId

` A value the reference evaluates once for every making of the declaration that writes it,
` which a function of its own evaluates (`Facts.note-static-value`).
facts.note-static-value(module, statement, instance, type)

────────────────────
_ do demand-style-holders Bool

` The functions of the style runtime a declaration of a value it holds a handle to calls, typed
` once: the declaration by a holder for an association and again by a live action, and the
` declaration of a value evaluated once for every making, for a site and for an association.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
if runtime.template-object == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . pointer = types.well-known-type("core", "Pointer")
    . maker = types.well-known-type("core/style", "StyleStaticMaker")
    . base = types.well-known-type("core/style", "StyleObjectHolder")
    if info-missing || pointer == invalid-type || maker == invalid-type || base == invalid-type
        = false
    .. info-missing = info == invalid-type || association == invalid-type
    if runtime.held == no-type
        runtime.held = types.optional-of(base)
    . mark = scratch.types.mark
    scratch.types.push(association)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.template-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-object")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.size-type)
    scratch.types.push(maker)
    runtime.site-cached = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-static-cached")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.author-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-dynamic-object")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= template-ready && runtime.author-object != no-instance
    .. template-ready = runtime.template-object != no-instance && runtime.site-cached != no-instance

────────────────────
_ do demand-style-inherits Bool

` The function of the style runtime a declaration of `inherit` calls, with those of a site,
` typed once.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
if runtime.site-inherit == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . mark = scratch.types.mark
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    runtime.site-inherit = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-inherit")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.site-inherit != no-instance

────────────────────
_ do reads-tracked Bool
    - value SyntaxId

` Whether a value reads something tracked.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked
                = true
        | .node-get-expression(row)
            if row.is-tracked
                = true
= false

────────────────────
_ do reads-slots Bool
    - value SyntaxId

` Whether a value reads a slot of a style sheet by `$name` (`read-variable`), which a theme
` switch changes: a name some sheet declares a slot of. A read of a style's property is not
` tracked.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression(row)
            if names-sheet-slot(row.name)
                = true
= false

────────────────────
_ do reads-rule-values Bool
    - value SyntaxId

` Whether a value of a style rule reads a value the rule takes.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot && not-this
                = true
            .. not-this = bindings.slots[resolution.slot].kind != .slot-this
= false

────────────────────
_ do markup-layer U32

` The layer at which the elements of markup written here declare styles: content, 1, in the
` function that makes a class's content, as the reference sets it there, and inline, 5,
` anywhere else. A function that builds markup takes that of the markup around it
` (`layer-given`), as the reference's builders carry it. None in another function nested in one
` that makes content, which the reference gives the layer of the function it is made in only in
` some ways of making it.
if layer-given != 0
    = layer-given
if frame.declaration.is-content
    = 1
. outer = instances.rows[instance].enclosing
while outer != no-instance
    . row = instances.rows[outer]
    . written = describe(program, row.module, row.decl)
    if written && written.is-content
        = U32.max
    outer = row.enclosing
= 5

────────────────────
_ do is-inherit Bool
    - value SyntaxId

` Whether a style value is the keyword `inherit`.
do match? tree.nodes[value]
    | .node-identifier(row)
        = row.name.text == "inherit"
= false

────────────────────
_ scalar-style Bool
    - type TypeId

` Whether a style property's value is kept in its slot as itself: a number, a truth or a
` character, not optional, as the reference's `NumberType` is.
intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    .. kind = types.intrinsic-of(type)

────────────────────
_ do style-value TypeId
    - value SyntaxId
    - declared TypeId

` The type of the value a style declaration gives a property of a type, as the reference's
` `compileStyleDeclarationExpression` reads it: a name alone, untracked, that names a case of the
` property's union that holds nothing is that case, before anything else the name may be, and is
` planned as `static-get` plans a case named on its union; any other value is typed as expected.
do match? tree.nodes[value]
    | .node-identifier(row)
        if !row.is-tracked && bare-case(declared, row.name)
            . union = if types.is-optional(declared) then inner else declared
                .. inner = types.optional-inner(declared)
            . cased = static-get(value, union, row.name)
            facts.replace-node-type(instance, value, cased)
            = cased
= infer-with-expected(value, declared)

────────────────────
_ do bare-case Bool
    - declared TypeId
    - name Atom

. union = if types.is-optional(declared) then types.optional-inner(declared) else declared
=? false if types.intrinsic-of(union) != .union
for fact in types.cases[types.completion-of(union).cases]
    if fact.name && fact.name! == name && (fact.is-default || fact.type == no-type)
        = true
= false

────────────────────
_ do fixed-style-value Bool
    - value SyntaxId

` Whether a style value reads nothing that can differ from one making of the element to the
` next, as the reference's `styleExpressionIsStatic` says: no style, no name tracked, no
` `this`, and no local, member or global but `true`, `false` and `null`.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot || resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-global && not-literal
                = false
            .. not-literal = !types.is-literal-global(resolution.module, resolution.decl)
= true

────────────────────
_ do rule-value-slots [SlotId]
    - rule SyntaxId

. slots [SlotId]
do match? tree.nodes[rule]
    | .node-rule-syntax(declared)
        for arg in tree.children[declared.args]
            do match? tree.nodes[arg]
                | .node-argument-decl(shape)
                    do match? tree.nodes[shape.pattern]
                        | .node-type-capture(capture)
                            . resolution = bindings.resolution-of(frame.binding, capture.id)
                            if resolution.kind == .resolve-slot
                                slots += resolution.slot
= slots

────────────────────
_ do given-fixed Bool
    - value SyntaxId
    - given [SlotId]

for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-slot && given.find(resolution.slot) == null
                = false
            if resolution.kind == .resolve-global && not-literal
                = false
            .. not-literal = !types.is-literal-global(resolution.module, resolution.decl)
= true

────────────────────
_ do given-static Bool
    - value SyntaxId
    - given [SlotId]

for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-slot && given.find(resolution.slot) == null
                = false
= true

────────────────────
_ do share-written-values
    - index U32
    - written AST
    - binding BindingId

. fixed = true
. static = true
do match? written.nodes[facts.style-applications[index].written]
    | .node-style-rule-application(applied)
        for value in written.children[applied.args]
            for node in written.subtree-start(value) .. value
                do match? written.nodes[node]
                    | .node-style-read-expression
                        fixed = false
                        static = false
                    | .node-get-expression(row)
                        if row.is-tracked
                            fixed = false
                            static = false
                    | .node-identifier(row)
                        . resolution = bindings.resolution-of(binding, node)
                        if tracked-or-this || resolution.kind == .resolve-slot || member-read
                            fixed = false
                            static = false
                        .. tracked-or-this = row.is-tracked || row.name.text == "this"
                        .. member-read = resolution.kind == .resolve-member
                        if resolution.kind == .resolve-global && !literal
                            fixed = false
                        .. literal = types.is-literal-global(resolution.module, resolution.decl)
    ??
        =
facts.style-applications[index].fixed-values = fixed
facts.style-applications[index].static-values = static
revise-application(index)

────────────────────
_ do bind-given-slots Bool
    - index U32
    - application SyntaxId
    - unit InstanceId
    - home ModuleId
    - reader InstanceId

` Binds the values a style rule is given as slots of style sheets where it is applied: a line
` that declares one alone takes the slot (`rule-slots`), and one that computes with them is
` evaluated from the slots by the runtime (`rule-themes`). Any other read of such a value is
` reported.
. written = program.modules[home].tree
. applied = match? written.nodes[application]
    | .node-style-rule-application(written)
        written
if !applied
    = true
. row = instances.rows[unit]
. owner = program.modules[row.module]
. names [SyntaxId]
. body SyntaxId = 0
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        body = rule.syntax
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for arg in owner.tree.children[declared.args]
                    do match? owner.tree.nodes[arg]
                        | .node-argument-decl(shape)
                            do match? owner.tree.nodes[shape.pattern]
                                | .node-type-capture(capture)
                                    names += capture.id
. params [SlotId]
. reads [ThemeRead]
. values [SyntaxId]
. positions [U32]
for position in 0 .. < applied.args.count
    . value = written.children[applied.args.start + position]
    . read = facts.theme-read-of(reader, value)
    if !read
        for node in written.subtree-start(value) .. value
            if facts.theme-read-of(reader, node)
                report-at(home, node, "A style rule takes a StyleSheet slot only alone, as in \"• bg:panel-color\", not in an expression")
                = false
        continue
    if position >= names.length || body == 0
        decline(application)
        = false
    params += bindings.resolution-of(row.binding, names[position]).slot
    reads += read
    values += value
    positions += position
=? true if params.length == 0
. covered [SyntaxId]
. count = facts.style-declarations.length as U32
. place = facts.first-style-declaration(unit)
while place < count
    . declared = facts.style-declarations[place]
    place = facts.next-style-declaration(place)
    . rhs SyntaxId = 0
    do match? owner.tree.nodes[declared.site]
        | .node-assign(line)
            rhs = line.rhs
    if rhs == 0
        continue
    if owner.tree.nodes[rhs] is .node-identifier
        . resolution = bindings.resolution-of(row.binding, rhs)
        . found = params.find(resolution.slot) if resolution.kind == .resolve-slot
        if found == null
            continue
        . read = reads[found]
        . use = facts.style-sheet-uses[read.sheet]
        . slot = facts.sheet-slots[use.first + read.slot]
        . (number, offset, projection) = slot-binding(row.module, declared.site, declared.property, rhs, slot.name, use.type, application)
        if number == U32.max
            = false
        revise-application(index)
        facts.add-rule-slot(RuleSlot(index, declared.site, number, offset, projection))
        covered += rhs
        continue
    . given = given-reads(unit, rhs, params)
    if !given || given.length == 0
        continue
    if !bind-given-theme(index, unit, declared, given, params, reads, values, positions, home, application, applied.name)
        = false
    for node in given
        covered += node
for node in owner.tree.subtree-start(body) .. body
    if names.find(node) != null || covered.find(node) != null || not-identifier
        continue
    .. not-identifier = !(owner.tree.nodes[node] is .node-identifier)
    . resolution = bindings.resolution-of(row.binding, node)
    . found = params.find(resolution.slot) if resolution.kind == .resolve-slot
    if found != null
        . read = reads[found]
        . slot = facts.sheet-slots[facts.style-sheet-uses[read.sheet].first + read.slot]
        report-at(home, values[found], "Style rule \"${applied.name.text}\" computes with what it is given, so it cannot take StyleSheet slot \"${slot.name.text}\"")
        = false
= true

────────────────────
_ do given-reads [SyntaxId]?
    - unit InstanceId
    - value SyntaxId
    - params [SlotId]

` The names by which a value a line of a style rule declares reads the values the rule takes as
` slots of style sheets (`params`); none where it also reads another local, a member, a style, a
` slot of a style sheet or anything tracked, which the runtime cannot evaluate from the slots.
. row = instances.rows[unit]
. source = program.modules[row.module].tree
. found [SyntaxId]
for node in source.subtree-start(value) .. value
    if facts.theme-read-of(unit, node)
        = null
    do match? source.nodes[node]
        | .node-style-read-expression
            = null
        | .node-identifier(ident)
            if ident.is-tracked || ident.name.text == "this"
                = null
            . resolution = bindings.resolution-of(row.binding, node)
            if resolution.kind == .resolve-member
                = null
            if resolution.kind == .resolve-slot
                if params.find(resolution.slot) == null
                    = null
                found += node
= found

────────────────────
_ do bind-given-theme Bool
    - index U32
    - unit InstanceId
    - declared StyleDeclaration
    - given [SyntaxId]
    - params [SlotId]
    - reads [ThemeRead]
    - values [SyntaxId]
    - positions [U32]
    - home ModuleId
    - application SyntaxId
    - name Atom

` Records that a line of a style rule applied at `application` computes its value with the values
` the rule takes as slots of one style sheet, read by the names `given`, as a value the runtime
` evaluates from the slots of the subtree's sheet (`rule-themes`). Each slot must have the type
` the rule takes its value as.
. row = instances.rows[unit]
. taken = rule-argument-types(DeclRef(row.module, row.initializer))
. givens [ThemedGiven]
. sheet = U32.max
for node in given
    . found = params.find(bindings.resolution-of(row.binding, node).slot)!
    . read = reads[found]
    . use = facts.style-sheet-uses[read.sheet]
    . slot = facts.sheet-slots[use.first + read.slot]
    if sheet != U32.max && sheet != read.sheet
        report-at(home, values[found], "A style value reads slots of one StyleSheet: \"${slot.name.text}\" is a slot of ${type-short-name(types, use.type)}, and others it reads are slots of ${type-short-name(types, facts.style-sheet-uses[sheet].type)}")
        = false
    sheet = read.sheet
    . wanted = if taken && place < taken.length then taken[positions[found] as Size] else no-type
        .. place = positions[found] as Size
    if wanted != slot.type
        report-at(home, values[found], "Style rule \"${name.text}\" takes ${type-display(types, wanted)}, so it can compute only with a StyleSheet slot of that type, not \"${slot.name.text}\" of type ${type-display(types, slot.type)}")
        = false
    . param = params[found]
    . seen = false
    for item in givens
        if item.param == param
            seen = true
    if !seen
        givens += ThemedGiven(param, read.slot)
if !demand-themed-runtime()
    decline(application)
    = false
. property = facts.style-properties[declared.property]
. themed = facts.note-given-themed-value
    - row.module
    - declared.site
    - unit
    - property.type
    - sheet
    - givens
revise-application(index)
facts.add-rule-theme(RuleTheme(index, declared.site, themed))
= true

────────────────────
_ do demand-style-sites Bool

` The functions of the style runtime a markup element that declares styles calls, typed once.
` The element's object is given to them as the `Pointer` the reference casts it to.
if !demand-style-runtime()
    = false
. runtime = facts.style-runtime
if runtime.info-required == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . pointer = types.well-known-type("core", "Pointer")
    if info == invalid-type || association == invalid-type || pointer == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(types.index-type)
    runtime.info-required = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-info-required")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.site-static = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-static")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(association)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.template-static = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-static")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(types.size-type)
    runtime.associate = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-associate")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    runtime.site-ready = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-ready")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    runtime.site-recording = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-recording")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    runtime.site-recorded = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-recorded")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.info-required != no-instance && runtime.site-static != no-instance && runtime.template-static != no-instance && runtime.associate != no-instance && runtime.site-ready != no-instance && runtime.site-recording != no-instance && runtime.site-recorded != no-instance

────────────────────
_ do infer-style-read Found
    - id SyntaxId
    - row ASTStyleReadExpression

` A read of a style property, `$name`, of an object or of `this`: the value the style runtime
` holds for the object, resolved against the styles the subject's class sees and those of the
` class the read is written in, as the reference resolves it, read by `style-read-bits` and
` taken as the property's type, the subject cast to a `Pointer` as the reference casts it. An
` optional is read with whether it holds nothing by `style-read-optional`, and a value the
` runtime holds a handle to is resolved from it (`style-read-ready`). A name no style answers
` that names the flag of a domain reads the flag; any other is the reference's error. A read
` written after `?` is a link of an optional chain, read from what the optional holds, as the
` reference's `pushChain` makes one. A read of an optional chain written in parentheses, of
` an optional otherwise, and of no class or interface, are declined. A read with no object where
` there is no `this` finds no property, the reference's error. The runtime's reader is a call,
` which ends what is known of properties.
if !program.module-by-name("core/style")
    frame.diagnose(id, .stated, program.store-atom("Style runtime is not loaded"))
    = Found(invalid-type)
. subject = frame.self-type
. chained = false
if row.object != 0
    if optional-chain-expr(row.object) != 0
        decline(id)
        = Found(invalid-type)
    . object-found = infer-found(row.object)
    . object = object-found.type
    . own = object-found.link
    if object == invalid-type
        = Found(invalid-type)
    . form = if row.is-optional then note-chain(id, id, object) else ChainForm.chain-plain
    if form == .chain-absent || absent-after(row.object, object)
        = Found(types.null-type)
    . optional = form == .chain-tested
    subject = link-receiver(row.object, object, own, optional)
    chained = (optional || optional-chained(row.object)) && types.is-optional(object)
    if chained && optional
        facts.unwrapped.append(UnwrappedFact(instance, row.object, subject))
if subject == no-type || subject == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Style property \"${row.name.text}\" not found"))
    = Found(invalid-type)
if types.is-optional(subject) || (types.intrinsic-of(subject) != .class && not-interface)
    decline(id)
    = Found(invalid-type)
.. not-interface = types.intrinsic-of(subject) != .interface
. styles [TypeId]
if !add-visible-styles(subject, styles, id) || !add-visible-styles(frame.self-type, styles, id)
    = Found(invalid-type)
. (index, position) = find-style-property(styles, row.name, id)
if position == U32.max
    if index != U32.max
        = Found(invalid-type)
    . text = row.name.text
    . (domain, below) = accessor-domain(text)
    if domain.length != 0
        = Found(flag-domain(id, domain, below, row.object == 0, false))
    . variable = read-variable(id, row.name, subject, chained)
    if variable.type != no-type
        = variable
    frame.diagnose(id, .stated, program.store-atom("Style property \"$text\" not found"))
    = Found(invalid-type)
. property = facts.style-properties[position]
if !demand-style-runtime() || !style-read-ready(property.type)
    decline(id)
    = Found(invalid-type)
. module-id = class-ref(types, types.type-row(.style)).module
. optional = types.is-optional(property.type)
. mark = scratch.types.mark
scratch.types.push(subject)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
. reader = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom(if optional then "style-read-host-optional" else "style-read-host-bits")
    - mark
scratch.types.rewind(mark)
. hosted = reader != no-instance
if !hosted
    . pointer = types.well-known-type("core", "Pointer")
    scratch.types.push(pointer)
    scratch.types.push(types.index-type)
    scratch.types.push(types.size-type)
    reader = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom(if optional then "style-read-optional" else "style-read-bits")
        - mark
    scratch.types.rewind(mark)
    if pointer == invalid-type
        reader = no-instance
if reader == no-instance
    decline(id)
    = Found(invalid-type)
facts.style-reads += StyleRead(instance, id, facts.style-uses[index].type, position, reader, hosted)
frame.forget-members()
= Found(if chained then types.optional-of(property.type) else property.type).linking(property.type)

────────────────────
_ do infer-style-property TypeId
    - id SyntaxId
    - row ASTStylePropertyExpression

if !program.module-by-name("core/style")
    frame.diagnose(id, .stated, program.store-atom("Style runtime is not loaded"))
    = invalid-type
. styles [TypeId]
if !add-visible-styles(frame.self-type, styles, id)
    = invalid-type
. (index, position) = find-style-property(styles, row.name, id)
if position == U32.max
    if index != U32.max
        = invalid-type
    frame.diagnose(id, .stated, program.store-atom("Style property \"${row.name.text}\" not found"))
    = invalid-type
. value = facts.style-properties[position].type
. component = U32.max
. part = row.component
if part
    if types.intrinsic-of(value) == .tuple
        . fields = types.properties-of(value)
        for field in 0 .. < fields.length
            if fields[field].name == part
                component = field as U32
    if component == U32.max
        frame.diagnose
            - id
            - .stated
            - program.store-atom
                - "Style property \"${row.name.text}\" has no component \"${part.text}\""
        = invalid-type
    value = types.properties-of(value)[component].type
if !demand-style-runtime()
    decline(id)
    = invalid-type
. module-id = class-ref(types, types.type-row(.style)).module
. mark = scratch.types.mark
scratch.types.push(value)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
if part
    scratch.types.push(types.index-type)
. maker = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom(if part then "style-property-component" else "style-property")
    - mark
    - 1
scratch.types.rewind(mark)
if maker == no-instance
    decline(id)
    = invalid-type
facts.style-reads += StyleRead
    - instance
    - id
    - facts.style-uses[index].type
    - position
    - maker
    - false
    - U32.max
    - 0
    - no-type
    - component
    - true
= instances.signatures[maker].returns

────────────────────
_ do read-variable Found
    - id SyntaxId
    - name Atom
    - subject TypeId
    - chained Bool

. sheets [TypeId]
. levels [U32]
add-sheet-groups(subject, sheets, levels)
add-sheet-groups(frame.self-type, sheets, levels)
. found = no-type
for sheet in sheets
    . root = family-root(sheet)
    if root != found && sheet-has-slot(root, name)
        if found != no-type
            frame.diagnose(id, .stated, program.store-atom("\"${name.text}\" is a slot of both ${type-short-name(types, found)} and ${type-short-name(types, root)}"))
            = Found(invalid-type)
        found = root
=? Found(no-type) if found == no-type
. number = sheet-index(found, module, id, id)
if number == U32.max
    = Found(invalid-type)
. use = facts.style-sheet-uses[number]
. offset = U32.max
for place in use.first .. < use.first + use.count
    if facts.sheet-slots[place].name == name
        offset = place - use.first
if offset == U32.max
    decline(id)
    = Found(invalid-type)
. type = facts.sheet-slots[use.first + offset].type
if !demand-style-runtime() || !style-read-ready(type)
    decline(id)
    = Found(invalid-type)
. module-id = class-ref(types, types.type-row(.style)).module
. optional = types.is-optional(type)
. mark = scratch.types.mark
scratch.types.push(subject)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
scratch.types.push(types.bool-type)
. reader = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom
        - if optional then "style-read-host-sheet-optional" else "style-read-host-sheet-bits"
    - mark
scratch.types.rewind(mark)
. hosted = reader != no-instance
if !hosted
    . pointer = types.well-known-type("core", "Pointer")
    scratch.types.push(pointer)
    scratch.types.push(types.index-type)
    scratch.types.push(types.size-type)
    scratch.types.push(types.bool-type)
    reader = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom
            - if optional then "style-read-sheet-optional" else "style-read-sheet-bits"
        - mark
    scratch.types.rewind(mark)
    if pointer == invalid-type
        reader = no-instance
if reader == no-instance || !demand-track-collection()
    decline(id)
    = Found(invalid-type)
facts.style-reads += StyleRead(instance, id, no-type, U32.max, reader, hosted, number, offset, type)
facts.sheet-reads += 1
if unit-styling.styling == 0 || tree.subtree-start(unit-styling.styling) > id || id > unit-styling.styling
    . context = live-context(read-site(id))
    if context == .live-value && is-eager-value()
        instances.mark-live(instance)
    else if context == .live-rule && is-rule-unit()
        instances.mark-live(instance)
    else if context == .live-statement
        note-live-statement(read-site(id))
frame.forget-members()
= Found(if chained then types.optional-of(type) else type).linking(type)

────────────────────
_ do infer-style-assign TypeId?
    - id SyntaxId
    - lhs SyntaxId
    - receiver TypeId
    - name Atom
    - op Operator
    - rhs SyntaxId
    - value TypeId

` An assignment of a name no member of an object of a class or an interface answers that names
` a property of a style the object sees, as the reference's `compileImperativeStyleWrite` makes
` one: the value, converted to the property's type as one assigned is, is declared for the
` object at the imperative layer, its bits by `style-author-imperative` or where the runtime
` holds a handle to it by a holder, the object cast to a `Pointer`. It gives the value converted.
` None where no style answers. Any operator but `=` is declined, as is a declaration that may
` raise an error, which the reference reports as unhandled.
. kind = types.intrinsic-of(receiver)
if (kind != .class && kind != .interface) || types.property-named(receiver, name) || no-style
    = null
.. no-style = !program.module-by-name("core/style")
. styles = style-vocabulary(receiver, lhs)
if !styles
    = invalid-type
. (index, position) = find-style-property(styles, name, lhs)
if position == U32.max
    if index != U32.max
        = invalid-type
    = null
. property = facts.style-properties[position]
if op != .eq-op || !style-value-ready(property.type) || !demand-style-writes()
    decline(id)
    = invalid-type
. runtime = facts.style-runtime
if instances.signatures[runtime.imperative].errors.count != 0 || object-errors
    decline(id)
    = invalid-type
.. object-errors = instances.signatures[runtime.imperative-object].errors.count != 0
if conversions.convert(id, rhs, value, property.type, .reason-assignment) == invalid-type
    = invalid-type
facts.style-writes += StyleWrite(instance, id, facts.style-uses[index].type, position)
= property.type

────────────────────
_ do infer-self-style-assign TypeId
    - id SyntaxId
    - lhs SyntaxId
    - op Operator
    - name Atom
    - rhs SyntaxId

` An assignment of a name nothing declares in a function that has `this`, which the reference
` makes a declaration of the property of a style the object sees that the name names, as
` `infer-style-assign` says, and otherwise reports as a variable that is not declared.
. value = stored-value(rhs, infer(rhs))
if value == invalid-type
    = invalid-type
. styled = infer-style-assign(id, lhs, frame.self-type, name, op, rhs, value) if frame.self-type != no-type
if styled
    = styled
frame.diagnose(id, .stated, program.store-atom("Variable not declared"))
= invalid-type

────────────────────
_ do demand-style-writes Bool

` The functions of the style runtime an assignment that declares a style for an object calls,
` typed once, with the record of a style by its number.
if !demand-style-sites() || !demand-style-holders()
    = false
. runtime = facts.style-runtime
if runtime.imperative == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . pointer = types.well-known-type("core", "Pointer")
    . mark = scratch.types.mark
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.imperative = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-imperative")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.imperative-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-imperative-object")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.imperative != no-instance && runtime.imperative-object != no-instance

────────────────────
_ do style-read-ready Bool
    - type TypeId

` Whether a value of a style property's type is read back from its bits: a number or a truth as
` it is, and a handle by the runtime's `style-object-pointer`, to the object it holds or the box
` of a value. A union nested in a union has no shape here.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
if scalar-style(inner)
    = true
if !holds-handle(inner)
    = true
if !demand-object-pointer()
    = false
if types.intrinsic-of(inner) != .union
    = style-holder-ready(inner)
for item in types.cases-of(inner)
    if !inline-style-case(item.type) && !style-holder-ready(item.type)
        = false
= true

────────────────────
_ do demand-object-pointer Bool

` The function of the style runtime that resolves the bits of a handle, typed once.
. runtime = facts.style-runtime
if runtime.object-pointer == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . mark = scratch.types.mark
    scratch.types.push(types.type-row(.int64))
    runtime.object-pointer = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-object-pointer")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.object-pointer != no-instance

────────────────────
_ accessor-domain (String, Bool)
    - text String

` The domain whose flag a name of a style read names, `is-X-invalid` or `is-X-invalid-below`,
` and whether it is the flag below, as the reference's `styleDomainAccessor` matches it: no
` domain where the name is neither.
|? !text.starts-with("is-")
    ("", false)
|? text.ends-with("-invalid-below") && text.length > 17
    (text[3 .. < text.length - 14], true)
|? text.ends-with("-invalid") && text.length > 11
    (text[3 .. < text.length - 8], false)
??
    ("", false)

────────────────────
_ do flag-domain TypeId
    - id SyntaxId
    - domain String
    - below Bool
    - bare Bool
    - writes Bool

` A read or a write of the flag of a domain: the domain numbered as it is first named, and the
` function of the style runtime that reads or writes the flag of the subject cast to a
` `Pointer`, `style-node-domain-invalid` or `style-node-domain-write`, or their `-below`
` forms, a call that ends what is known of properties. A read gives a `Bool`. A bare one in a
` nested function is declined.
if bare && instances.rows[instance].enclosing != no-instance
    decline(id)
    = invalid-type
. index = style-domain(program.store-atom(domain), module, id, module, id)
. pointer = types.well-known-type("core", "Pointer")
if pointer == invalid-type || !demand-style-runtime()
    decline(id)
    = invalid-type
. module-id = class-ref(types, types.type-row(.style)).module
. name = if writes then "style-node-domain-write" else "style-node-domain-invalid"
. mark = scratch.types.mark
scratch.types.push(pointer)
scratch.types.push(types.size-type)
if writes
    scratch.types.push(types.bool-type)
. call = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom(if below then "${name}-below" else name)
    - mark
scratch.types.rewind(mark)
if call == no-instance
    decline(id)
    = invalid-type
facts.style-flags += StyleFlag(instance, id, index, call)
frame.forget-members()
= types.bool-type

────────────────────
_ do infer-style-write TypeId
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - row ASTStyleReadExpression
    - rhs SyntaxId

` A write of the flag of a domain, `$is-X-invalid = on`, of an object or of `this`, as the
` reference writes it: the value, then the subject, given to the style runtime's writer. The
` value is what the write answers. A write of any other name is the reference's error. An
` assigning operator, a value that is no `Bool`, a value that reads something tracked, and a
` subject chained on an optional, of an optional or of no class are declined.
. written = infer-with-expected(rhs, types.bool-type)
if written == invalid-type || written == no-type
    = invalid-type
. text = row.name.text
. (domain, below) = accessor-domain(text)
if domain.length == 0
    frame.diagnose
        - lhs
        - .stated
        - program.store-atom("Style values are computed by settling; \"\$$text\" is not assignable")
    = invalid-type
if op != .eq-op || written != types.bool-type || is-live-statement(id) || no-style
    decline(id)
    = invalid-type
.. no-style = !program.module-by-name("core/style")
. subject = frame.self-type
if row.object != 0
    subject = infer(row.object)
    if subject == invalid-type
        = invalid-type
if row.is-optional || types.is-optional(subject) || types.intrinsic-of(subject) != .class
    decline(id)
    = invalid-type
if flag-domain(id, domain, below, row.object == 0, true) == invalid-type
    = invalid-type
= written

────────────────────
_ do demand-style-runtime Bool

` The functions of the style runtime that registering styles calls, typed once.
. runtime = facts.style-runtime
if runtime.register != no-instance
    = true
. module-id = class-ref(types, types.type-row(.style)).module
. info = types.well-known-type("core/style", "StyleInfo")
if info == invalid-type
    = false
. mark = scratch.types.mark
scratch.types.push(types.string-type)
runtime.info-for = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-info-for")
    - mark
scratch.types.push(types.string-type)
scratch.types.push(types.size-type)
runtime.info = calls.demand-constructor(info, mark)
scratch.types.rewind(mark)
scratch.types.push(info)
scratch.types.push(types.size-type)
scratch.types.push(types.string-type)
scratch.types.push(types.type-row(.int64))
scratch.types.push(types.bool-type)
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint32))
scratch.types.push(types.type-row(.uint64))
runtime.register-property = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-register-property")
    - mark
scratch.types.rewind(mark)
scratch.types.push(info)
scratch.types.push(types.type-row(.int64))
runtime.register = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-register")
    - mark
scratch.types.rewind(mark)
scratch.types.push(types.string-type)
scratch.types.push(types.size-type)
runtime.register-domain = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom("style-register-domain")
    - mark
scratch.types.rewind(mark)
runtime.intern-holder = facts.style-runtime.intern-holder
facts.style-runtime = runtime
= runtime.info-for != no-instance && runtime.info != no-instance && runtime.register-property != no-instance && runtime.register != no-instance && runtime.register-domain != no-instance

────────────────────
_ do demand-event-register

` The event runtime's `event-register-lowered`, which puts a section the reference runs from a
` table of its class in that table as the module of the class starts, and its
` `event-register-lowered-arrival`, which puts one that hears only what arrives at its object.
. matcher = types.well-known-alias("core/event", "EventLoweredOwnerMatcher")
if matcher == invalid-type
    =
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(matcher)
scratch.types.push(pointer-to(types.type-row(.uint8)))
scratch.types.push(types.size-type)
scratch.types.push(types.bool-type)
facts.event-register = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-register-lowered")
    - mark
facts.event-register-arrival = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-register-lowered-arrival")
    - mark
scratch.types.rewind(mark)

────────────────────
_ do defer-values
    - receiver TypeId

` The first values a constructor gives only once the markup of its class has run, as the
` reference puts them off: a stored property's value that reads by its name alone a property
` the markup declares for an element, outside the functions written in it, and then each
` that reads a property put off, unless the constructor gives the property its value itself.
` Each is given after those it reads, and a value that reads itself that way is reported, as is
` one whose type has no value to hold until then.
. range = types.completions[receiver].properties
. count = range.count
. values = SyntaxId[count]
. owners = ModuleId[count]
. sites = SyntaxId[count]
. deferred = Bool[count]
. given = Bool[count]
. fill = facts.latest-fill-of(instance)
while fill != no-fact
    . place = types.property-named(receiver, facts.fills[fill].name)
    if place && (place as U32) >= range.start && (place as U32) < range.start + count
        given[(place as U32) - range.start] = true
    fill = facts.prior-fill(fill)
. any = false
for position in 0 .. < count
    . property = types.properties[range.start + position]
    if property.storage-kind != .storage-eager || given[position] || names-element(types, property)
        continue
    . ref = declaring-class(types, property.owner, property.name)
    . member = valued-property(program, ref.module, ref.decl, property.name)
    do match? program.modules[ref.module].decls[member]
        | .decl-property(row)
            if member != 0 && !row.is-lazy
                values[position] = row.value
                owners[position] = ref.module
                sites[position] = row.syntax
    if values[position] != 0 && reads-element(receiver, ref-tree, values[position])
        deferred[position] = true
        any = true
    .. ref-tree = program.modules[ref.module].tree
if !any
    =
. grew = true
while grew
    grew = false
    for position in 0 .. < count
        if values[position] == 0 || deferred[position]
            continue
        . tree = program.modules[owners[position]].tree
        . value = values[position]
        for node in tree.subtree-start(value) .. value
            . read = read-place(receiver, tree, node)
            if read != U32.max && deferred[read]
                deferred[position] = true
                grew = true
                break
for position in 0 .. < count
    . property = types.properties[range.start + position]
    if deferred[position] && !has-empty-value(eager-type(receiver, property), 0)
        . message = "Property \"${property.name.text}\" initializes after its markup, so its type must be optional"
        facts.record-diagnostic
            - instance
            - owners[position]
            - sites[position]
            - .stated
            - program.store-atom(message)
        =
. states = U8[count]
. order [U32]
for position in 0 .. < count
    if !deferred[position]
        continue
    if !order-deferred(receiver, position, values, owners, sites, deferred, states, order)
        =
facts.note-deferred(instance, order)

────────────────────
_ do order-deferred Bool
    - receiver TypeId
    - position U32
    - values [SyntaxId]
    - owners [ModuleId]
    - sites [SyntaxId]
    - deferred [Bool]
    - states [U8]
    - order [U32]

` Places a value put off after the values put off that it reads, and then itself, by its
` property's place among all properties. A value reached again while those it reads are
` being placed depends on itself, and is reported at its property.
if states[position] == 2
    = true
. start = types.completions[receiver].properties.start
if states[position] == 1
    . name = types.properties[start + position].name
    . message = "Property \"${name.text}\" depends on itself through properties that initialize after its markup"
    facts.record-diagnostic
        - instance
        - owners[position]
        - sites[position]
        - .stated
        - program.store-atom(message)
    = false
states[position] = 1
. tree = program.modules[owners[position]].tree
. value = values[position]
for node in tree.subtree-start(value) .. value
    . read = read-place(receiver, tree, node)
    if read != U32.max && read != position && deferred[read]
        if !order-deferred(receiver, read, values, owners, sites, deferred, states, order)
            = false
states[position] = 2
order += start + position
= true

────────────────────
_ do read-place U32
    - receiver TypeId
    - tree AST
    - node SyntaxId

` The place among a class's own properties of the one a node of a value reads as the
` reference finds them: by a name alone, or after `this`. `U32.max` for any other node.
. name Atom? = null
do match? tree.nodes[node]
    | .node-identifier(row)
        name = row.name
    | .node-get-expression(row)
        do match? tree.nodes[row.object]
            | .node-identifier(object)
                if types.this-atom && object.name == types.this-atom
                    name = row.name
if !name
    = U32.max
. place = types.property-named(receiver, name)
. range = types.completions[receiver].properties
if !place || (place as U32) < range.start || (place as U32) >= range.start + range.count
    = U32.max
= (place as U32) - range.start

────────────────────
_ do reads-element Bool
    - receiver TypeId
    - tree AST
    - value SyntaxId

` Whether a value reads by its name alone a property the markup of a class declares for an
` element, apart from in the functions written in it.
. floor = tree.subtree-start(value)
. node = value + 1
while node > floor
    node -= 1
    do match? tree.nodes[node]
        | .node-function-syntax
            node = tree.subtree-start(node)
        | .node-identifier(row)
            . place = types.property-named(receiver, row.name)
            if place && names-element(types, types.properties[place])
                = true
= false

────────────────────
_ do tracks-reads Bool
    - tree AST
    - value SyntaxId

` Whether a value reads a name or a member that it tracks.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked
                = true
        | .node-get-expression(row)
            if row.is-tracked
                = true
= false

────────────────────
_ do writes-content Bool
    - type TypeId

` Whether a class, or one above it, has a section of markup.
. level TypeId? = type
while level
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            do match? owner.decls[class.content-function]
                | .decl-function(fn)
                    if fn.is-content && fn.syntax != 0
                        = true
    level = types.base-of(level)
= false

────────────────────
_ do leaves-early Bool
    - body SyntaxId

` Whether the body of a constructor leaves before its end by a return of its own, apart
` from those of the functions written in it.
if body == 0
    = false
. skip-from SyntaxId = 0
. skip-to SyntaxId = 0
. node = body
while node > tree.subtree-start(body)
    node -= 1
    do match? tree.nodes[node]
        | .node-function-syntax
            if !(node >= skip-from && node < skip-to)
                skip-from = tree.subtree-start(node)
                skip-to = node
        | .node-return
            if !(node >= skip-from && node < skip-to)
                = true
        | .node-return-if-true
            if !(node >= skip-from && node < skip-to)
                = true
= false

────────────────────
_ do check-rule
    - declaration CheckedDecl
    - matched SyntaxId

` A rule a module declares, typed for the stream and the arguments a pattern calls it with, as the
` reference types the function it makes of it: its pattern is typed as a match of its own over the
` buffer of the stream, which holds the stream's items, or the UTF-8 bytes of its characters where
` the rule is `encoded` for a pattern on a String, and its arms are joined and converted to the
` type the rule states. The function made of it returns an optional of that type, which holds
` nothing where no arm passed, and which a call of the rule from its own arms gives where the rule
` states its type; one that states none, called from its own arms before its type is known, reports
` that it cannot be typed, as the reference does. The type of the buffer is kept at the rule. A
` type's constructor that takes a stream is such a rule. Its pattern asks the stream for more input
` where it reads past the end of the buffer, through the calls `record-growth` keeps. One typed for
` the helper a pattern calls it under runs its pattern under that helper; one given an argument
` `ambient-position` finds, under that argument, whatever helper a pattern calls it under, and one
` whose helper observes literals or keeps collectors where its storages disagree has no shape here.
` A rule marked to roll back, or whose pattern has an arm that is, asks the helper for a mark before
` each action of its arms, as the reference does. Another rule that belongs to a type is an
` error, and one whose body holds more than its pattern and the lazy locals declared for it has
` no shape here.
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. declared = declared-return
. signature = instances.signatures[instance]
. item = if signature.param-count != 0 then instances.param-type(instance, 0) else no-type
. owned = frame.self-type != no-type && declaration.kind != .constructor-decl
. given = if item != no-type then class-over(types.token-stream-decl, item) else no-type
. grows = pattern == 0 || item == no-type || record-growth(given, matched, encodes)
    .. encodes = instances.rows[instance].encoded
. marked = false
do match? tree.nodes[declaration.syntax]
    | .node-function-syntax(row)
        marked = row.rollback
if pattern == 0 || item == no-type || owned || !grows || !lazies-beside(declaration.body, matched)
    if owned
        frame.diagnose(declaration.syntax, .stated, program.store-atom("A rule can't be a method; declare it at module level"))
    else
        decline(declaration.syntax)
    instances.set-returns(instance, invalid-type, no-type, .return-inferred)
    finish-errors(frame)
    close()
    =
if declared != no-type
    . stated = types.optional-around(declared)
    instances.set-returns(instance, stated, stated, .return-declared)
stream-view = stream-view.item = item
stream-view = stream-view.buffer = class-over
    - types.array-decl
    - if instances.rows[instance].encoded then types.type-row(.uint8) else item
stream-view = stream-view.type = given
if instances.rows[instance].helper != no-type
    helping = helping.helper = pattern-helper(types, instances.rows[instance].helper)
    if instances.rows[instance].spans
        helping = helping.helper = spanning-helper(helping.helper!)
        helping = helping.span-typing = true
    helping = helping.site = matched
    rule-helper-site = matched
else if ambient-position(types, instances, instance) != U32.max
    . resolved = pattern-helper
        - types
        - instances.argument-type(instance, ambient-position(types, instances, instance))
    if resolved.problem != null || resolved.observer != no-type || resolved.storage == invalid-type
        decline(declaration.syntax)
    helping = helping.helper = resolved
    helping = helping.site = matched
    rule-helper-site = matched
. closing = left-call(pattern, 0, List'SyntaxId())
if closing != 0
    report-left-recursion(closing)
    instances.set-returns(instance, invalid-type, no-type, .return-inferred)
    finish-errors(frame)
    close()
    =
rule-arming = rule-arming.capture-base = capture-sites.length
rule-arming = rule-arming.capture-root = pattern
rule-arming = rule-arming.texts = declared == types.string-type
. saved-target = rule-arming
rule-arming = rule-arming.target = declared
rule-arming = rule-arming.span = gives-source-span(declared)
helping = helping.explicit = marked || holds-rollback(pattern)
helping = helping.body = matched
. joined = arms-type(pattern)
helping = helping.explicit = false
helping = helping.body = 0
rule-arming = saved-target
rule-arming = rule-arming.texts = false
. result = declared
if result == no-type
    result = if joined == no-type then types.string-type else joined
if joined != invalid-type
    convert-stream-arms(pattern, result)
    if declared != no-type && declared != types.string-type
        note-arm-casts(pattern, declared)
    facts.set-node-type(instance, pattern, result)
    facts.set-node-type(instance, declaration.syntax, stream-view.buffer)
if declared == no-type
    if instances.signatures[instance].read-in-progress
        . reader = instances.signatures[instance].read-by
        if reader == no-instance || reader == instance || !facts.has-diagnostic(reader)
            facts.record-diagnostic
                - instance
                - frame.module
                - declaration.syntax
                - .return-after-recursion
        instances.set-returns(instance, invalid-type, no-type, .return-failed)
    else
        instances.set-returns(instance, types.optional-around(result), no-type, .return-inferred)
finish-errors(frame)
close()

────────────────────
_ do lazies-beside Bool
    - body SyntaxId
    - matched SyntaxId

` Whether the body of a rule holds nothing beside its pattern but lazy locals declared for
` it, as the reference's `where` holds them.
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if statement != matched && !narrowing.is-lazy-declaration(statement)
                = false
= true

────────────────────
_ lacks-result Bool
    - declaration CheckedDecl
    - declared TypeId
    - intrinsic TypeId

` A function written without a body and without `do` gives nothing, unless it declares a type
` to construct, states a requirement of an interface, or is one the compiler computes.
|? declaration.body != 0 || declaration.is-main || declaration.is-imperative
    false
|? declaration.is-generated || is-constructor-kind(declaration.kind) || intrinsic != no-type
    false
|? declared != no-type && declared != types.void-type
    false
|? self != no-type && self != invalid-type && types.intrinsic-of(self) == .interface
    false
??
    declaration.kind == .function-decl

.. self = frame.self-type

────────────────────
_ do unwritten-return SyntaxId
    - declaration CheckedDecl
    - declared TypeId
    - intrinsic TypeId

` The type a function written without a body and without `do` declares it returns, which
` it gives as made with nothing written, as a local declared with no value is, or nothing
` where it gives nothing so. A function the compiler computes is none of these.
if declaration.body != 0 || declaration.is-main || not-expression
    = 0
.. not-expression = declaration.is-imperative || declaration.is-generated
if module == types.intrinsics-module
    = 0
if declaration.kind != .function-decl || intrinsic != no-type || gives-nothing
    = 0
.. gives-nothing = declared == no-type || declared == types.void-type
. self = frame.self-type
if self != no-type && self != invalid-type && types.intrinsic-of(self) == .interface
    = 0
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        = fn.return-type
= 0

────────────────────
_ do refuses-unwritten Bool

do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.owner == 0 && fn.name && calls.intrinsic-plan(instance) == .plan-none
            . text = "Function \"${fn.name.text}\" has no body, and no compiler intrinsic supplies one"
            frame.diagnose(fn.syntax, .stated, program.store-atom(text))
            = true
= false

────────────────────
_ do evident-return TypeId
    - declaration CheckedDecl

` The type an expression function gives when its result constructs a type it names in full:
` a function that reads this one's return while it is still being checked reads that type.
if declaration.is-main || declaration.is-imperative || declaration.body == 0
    = no-type
. result = declaration.body
do match? tree.nodes[result]
    | .node-block(row)
        result = 0
        for statement in tree.children[row.body]
            if !is-lazy-declare(statement)
                result = statement
if result == 0
    = no-type
do match? tree.nodes[result]
    | .node-call-expression(call)
        do match? tree.nodes[call.callable]
            | .node-type-arguments
                . named = types.evaluate-type(module, tree, call.callable, frame.env)
                if named != invalid-type && !types.completions[named].has-variables
                    = named
= no-type

────────────────────
_ do check-unreturned
    - declared TypeId

` A `do` function that can run off its end must not finish on a value: a value it means to
` give back needs `=`. One that declares a type it must give cannot run off its end at all;
` nothing, a truth and an optional each have a value for the end to give. A function a C
` header declares has no end to run off, and neither has one an interface requires and
` gives no body.
. declaration = frame.declaration
. plain = declaration.kind == .function-decl || declaration.kind == .getter-decl
if !plain || !declaration.is-imperative || giving.yields
    =
if program.modules[module].name.ends-with(".h") || narrowing.exits(declaration.body, false, true)
    =
. owner = frame.self-type
if owner != no-type && owner != invalid-type && is-empty-block(declaration.body)
    if types.intrinsic-of(owner) == .interface
        =
. gives = declared != no-type && declared != types.void-type
. required = gives && declared != types.bool-type && !types.is-optional(declared)
if final-statement == 0 && !required
    =
. name = ""
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.name
            name = fn.name.text
    | .decl-converter(converter)
        . target = types.type-syntax-name(tree, converter.target-type)
        if target
            name = "to ${target.text}"
if final-statement != 0
    . gives-value = gives
    if declared == no-type
        for position in frame.returns-start .. < scratch.returns.length
            . returned = scratch.returns[position].type
            if returned != no-type && returned != types.void-type
                gives-value = true
    if gives-value
        . message = "Function $name ends with a value it does not return"
        frame.diagnose(final-statement, .stated, program.store-atom(message))
        =
    if is-bare-value(final-statement) && frame.self-type == no-type
        frame.diagnose(final-statement, .stated, program.store-atom(bare-value-text()))
        =
    instances.set-unreturned(instance, final-statement)
if required
    . shown = type-short-name(types, declared)
    . message = "Function $name can fall through without returning $shown"
    frame.diagnose(declaration.syntax, .stated, program.store-atom(message), declared)

────────────────────
_ bare-value-text String

"A value cannot stand alone as a step; use it, or remove it"

────────────────────
_ is-module-empty-block Bool
    - module ModuleId
    - id SyntaxId

match program.modules[module].tree.nodes[id]
    | .node-block(row)
        row.body.count == 0
    ??
        false

────────────────────
_ is-empty-block Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-block(row)
        row.body.count == 0
    ??
        false

────────────────────
_ discards-result Bool

` A tap's closure runs for its effect: the reference declares it to return nothing.
|? frame.declaration.kind != .pipeline-decl
    false
??
    match tree.nodes[frame.declaration.syntax]
        | .node-pipeline-expression(row)
            row.op == .pipe-repeat-op
        | .node-binary-expression(row)
            row.op == .pipe-repeat-op
        ??
            false

────────────────────
_ do math-intrinsic-return TypeId

` What a function the compiler computes gives, where it declares nothing: one of the four of
` the math module that take floats, or the intrinsic that calls an event's lowered handler.
. name = ""
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.name
            . atom = fn.name
            name = atom.text
if module == types.intrinsics-module && name == "event-invoke-lowered"
    = types.void-type
if program.modules[module].name != "math"
    = no-type
. signature = instances.signatures[instance]
if signature.args.count == 0
    = no-type
for position in 0 .. < signature.args.count
    if instances.argument-type(instance, position) != types.f64-type
        = no-type
if (name == "sqrt" || name == "abs") && signature.args.count == 1
    = types.f64-type
if (name == "min" || name == "max") && signature.args.count == 2
    = types.f64-type
= no-type

────────────────────
_ do generator-return TypeId
    - declared TypeId
    - raised RowRange'TypeId

` A generator body under a declared return type, its steps raising the errors in `raised`: a
` declared generator stays; a declared stream or iterable returns the iterable of its item,
` the case of the stream union a generator unifies with, unless the steps raise, when the
` reference keeps the concrete generator so its pull carries the errors.
if declared == invalid-type
    = declared
. ref = class-ref(types, declared)
if same-decl(ref, types.generator-decl)
    = declared
if !same-decl(ref, types.stream-decl) && !same-decl(ref, types.iterable-decl)
    = declared
. item = first-arg(declared)
if item == no-type
    = declared
if raised.count != 0
    = generator-of(item, raised)
= class-over(types.iterable-decl, item)

────────────────────
_ do read-return TypeId
    - declaration CheckedDecl
    - declared TypeId

` The return a call back to a function reads while its body is typed. A body that yields
` itself gives what `generator-return` settles its declared return to, its steps raising the
` errors it states, or none so far, as such a call reads those it infers; one that turns up
` later is reported as leaving a recursive generator.
if declared == invalid-type
    = declared
. ref = class-ref(types, declared)
. streams = same-decl(ref, types.stream-decl) || same-decl(ref, types.iterable-decl)
if !streams || !yields-itself(declaration)
    = declared
. signature = instances.signatures[instance]
. stated = if signature.error-state == .errors-stated then signature.errors else RowRange'TypeId()
= generator-return(declared, stated)

────────────────────
_ do yields-itself Bool
    - declaration CheckedDecl

` Whether a function's own statements yield, outside the functions nested in it.
. start = declaration.subtree.start
. position = declaration.syntax
while position > start
    position -= 1
    do match? tree.nodes[position]
        | .node-yield
            = true
        | .node-function-syntax
            position = tree.subtree-start(position)
= false

────────────────────
_ do note-generator

` Says what a function that yields makes and what a step of its body gives, for emission:
` the generator of the items it returns a generator or an iterable of, or else of what its
` yields unify to. Each yield a statement writes is converted to the type of the items
` where it gives another, at the statement, as the reference casts it once the body is
` compiled. A function declared to return anything else returns the generator converted to
` that, where it is called: the conversion is recorded at the declaration. A generator whose
` steps raise carries their errors, and a step gives its item or one of them.
. returned = instances.signatures[instance].returns
. ref = if returned != no-type && returned != invalid-type then returned-ref else DeclRef(0, 0)
    .. returned-ref = class-ref(types, returned)
. item = giving.yielded
if same-decl(ref, types.generator-decl) || same-decl(ref, types.iterable-decl)
    item = first-arg(returned)
if item == no-type || item == invalid-type
    =
convert-yields(item)
. makes = generator-of(item, instances.rows[instance].step-errors)
. yields = step-answer(types.optional-around(item))
types.complete(makes)
types.complete(yields)
. inferred = instances.signatures[instance].return-state == .return-inferred
if inferred && same-decl(ref, types.generator-decl) && returned != makes
    instances.set-returns(instance, makes, no-type, .return-inferred)
    returned = makes
if returned != no-type && returned != invalid-type && returned != makes && not-interface
    . site = frame.declaration.syntax
    if !relation-legal(conversions.compare-held(makes, returned))
        . message = program.store-atom("Generator return type does not match declared return type")
        frame.diagnose(site, .stated, message)
        =
    conversions.convert(site, site, makes, returned, .reason-return)
.. not-interface = types.intrinsic-of(returned) != .interface
instances.set-generator(instance, makes, yields, loops-yields && splits-yields)

────────────────────
_ do convert-yields
    - item TypeId

for position in frame.yields-start .. < scratch.yields.length
    . site = scratch.yields[position]
    if site.type != item
        . noted = position - frame.yields-start
        . literal = if noted < yield-literals.length then yield-literals[noted] else 0
        if literal != 0 && yield-fits(literal, item)
            conversions.convert(site.syntax, literal, site.type, item, .reason-return, true, true)
        else
            conversions.convert
                - site.syntax
                - yielded-syntax(site.syntax)
                - site.type
                - item
                - .reason-return

────────────────────
_ do settle-built-list

. item = if built-item != no-type then built-item else giving.yielded
if item == no-type || item == invalid-type
    instances.set-returns(instance, invalid-type, no-type, .return-failed)
    =
convert-yields(item)
. list = list-of(item)
instances.set-returns(instance, list, no-type, .return-inferred)
. head = frame.declaration.syntax
calls.note-list(head, list)
calls.note-append(head, list, item, .call-list-append)

────────────────────
_ do generator-of TypeId
    - item TypeId
    - raised RowRange'TypeId

` The generator a function that yields makes, of its items and of the errors in `raised`, which
` a step of its body raises.
if raised.count == 0
    = class-over(types.generator-decl, item)
. mark = scratch.types.mark
scratch.types.push(item)
. errors-mark = scratch.types.mark
for offset in 0 .. < raised.count
    scratch.types.push(instances.signature-types[raised.start + offset])
= types.intern-raising-class
    - types.generator-decl.module
    - types.generator-decl.decl
    - mark
    - errors-mark

────────────────────
_ do step-answer TypeId
    - optional TypeId

` What a step of a function that yields gives: the optional of an item, or that or one of
` the errors the step raises.
. raised = instances.rows[instance].step-errors
if raised.count == 0
    = optional
. mark = scratch.types.mark
for offset in 0 .. < raised.count
    scratch.types.push(instances.step-error-type(instance, offset))
= result-type(types, optional, mark)

────────────────────
_ do class-over TypeId
    - decl DeclRef
    - item TypeId

. mark = scratch.types.mark
scratch.types.push(item)
= types.class-with-args(decl.module, decl.decl, mark)

────────────────────
_ do super-type TypeId

. self = frame.self-type
if self == no-type || self == invalid-type
    = self
types.complete(self)
= types.base-of(self) ?? self

────────────────────
_ do owner-syntax SyntaxId

. owner = 0u32
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        owner = fn.owner
if owner == 0
    = frame.declaration.syntax
do match? program.modules[module].decls[owner]
    | .decl-class(class)
        = class.syntax
= frame.declaration.syntax

────────────────────
_ do states-type Bool
    - signature Signature
    - position U32

` Whether the argument at a position of the function being typed is written with a type
` that leaves nothing open.
. declared = signature.args[position]
if declared == invalid-type || types.completions[declared].has-variables
    = false
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if position < fn.args.count
            = program.modules[module].arg-pool[fn.args.start + position].type-syntax != 0
= false

────────────────────
_ do promise Bool
    - callee InstanceId

` Gives a rule that states its type what its function returns, the optional of that type,
` from its declaration alone, so that its body may wait in the queue. False for any other
` instance, whose body says what it returns.
. row = instances.rows[callee]
if row.self-type != no-type || row.enclosing != no-instance || row.holds-closure || no-rule
    = false
.. no-rule = rule-match(program, row.module, row.decl) == 0
. reported = facts.diagnostics.length
. checker = checker-for(session, callee)
. declared = no-type
if checker.described
    checker.prepare()
    declared = checker.declared-return
    checker.close()
checker.retire()
facts.diagnostics.truncate(reported)
if declared == no-type || declared == invalid-type
    = false
. stated = types.optional-around(declared)
instances.set-returns(callee, stated, stated, .return-declared)
= true

────────────────────
_ do demand-own-body
    - callee InstanceId

` Types a callee's body in this pass where nothing has typed it yet, for what it records of the
` state machines it types, which a pass of a parallel type pass takes in from the others only
` as they merge: taken in from another (`adopt`), the callee would have none here. Where one was
` taken in already, the parallel pass cannot stand (`SharedTyping.diverge`).
if instances.rows[callee].state == .instance-unstarted
    . checker = checker-for(session, callee)
    checker.run()
    checker.retire()
else if instances.rows[callee].imported && session.shared
    session.shared.diverge()

────────────────────
_ do check-initializer
    - property DeclId

` Types the value of one property in the frame of its module's main. A global whose type names
` a generic class without its arguments takes them from its value, or from the conversion its
` value is given, as a local does. A class's property is typed for one receiver, with `this`
` bound to it and the type parameters of the class that writes the value as the receiver gives
` them; a bullet list a root `<This` gives a list takes the list's item type. A case of an enum
` is typed for its enum. A line of a root `<This` that names no property is a style's
` declaration (`check-root-style`).
prepare()
. receiver = instances.rows[instance].self-type
do match? program.modules[module].decls[property]
    | .decl-case(row)
        if row.name
            check-case(receiver, row.name, row.value, row.syntax)
        instances.set-returns(instance, receiver, no-type, .return-inferred)
        finish-errors(frame)
        close()
        =
    | .decl-rule(row)
        check-class-rule(receiver, row.syntax, row.owner)
        =
    | .decl-style-rule(row)
        check-style-unit(receiver, row.syntax, row.owner)
        =
    | .decl-property(row)
        if row.defaults-root && row.name && received && !types.property-named(receiver, row.name)
            check-root-style(receiver, row)
            =
        .. received = receiver != no-type
. annotation = 0u32
. initializer = 0u32
. site = 0u32
. eager = false
. writer = 0u32
do match? program.modules[module].decls[property]
    | .decl-property(row)
        annotation = row.type-syntax
        initializer = row.value
        site = row.syntax
        eager = !row.is-lazy
        writer = row.owner
. result = no-type
if receiver == no-type
    . declared = no-type
    if annotation != 0
        declared = types.evaluate-type(module, tree, annotation, types.env-frame())
        if declared == invalid-type
            report-missing-type(annotation, types.env-frame())
    . value = no-type
    if initializer != 0
        initializing = if eager then property else 0
        value = infer-with-expected(initializer, declared)
        initializing = 0
        if declared != no-type
            note-declared-value(0, property, initializer, annotation, declared, value)
        if bare-generic-annotation(declared, value)
            declared = relations.complete-from(declared, value) ?? value
        if declared != no-type
            . chosen = conversions.convert(site, initializer, value, declared, .reason-declaration)
            if chosen != invalid-type
                declared = chosen
    else if declared != no-type
        construct-value(site, declared)
    result = if declared != no-type then declared else value
    if eager && is-constant-global(module, property)
        facts.constant-globals.append(ConstantGlobal(module, property))
else
    . declared = instances.signatures[instance].declared-returns
    frame.self-type = receiver
    bind-this(receiver)
    frame.close-env()
    open-class-env(holding-type(receiver, DeclRef(module, writer)))
    reading = reading.eager = eager
    if initializer == 0
        construct-value(site, declared)
        result = declared
    else
        if root-value() != 0
            expect-bullets(initializer, declared)
        result = infer-with-expected(initializer, declared)
        if declared != no-type
            conversions.convert(site, initializer, result, declared, .reason-declaration)
        note-value-shape(initializer)
if result == no-type
    result = invalid-type
. stated = instances.signatures[instance].declared-returns
instances.set-returns(instance, result, stated, .return-inferred)
finish-errors(frame)
close()

────────────────────
_ do check-class-rule
    - receiver TypeId
    - syntax SyntaxId
    - writer DeclId

` Types a rule of a class for the class that writes it, as the value of a property is typed:
` with `this` bound and the type parameters of that class as the receiver gives them. What a
` `when` rule tests is tested for truth, as a condition is, and the rule's value is what a
` `whenever` rule compares from one run to the next. A rule answers nothing. The reference
` reports one that reads nothing tracked where it runs it in a live action of its own: a
` `when` rule as it tests and runs its body, a `whenever` rule as it takes its value. A section
` that subscribes to a stream is typed as its loop, which the object owns; one on a stream of
` an element a branch of the markup makes is subscribed again as the branch makes the element
` again (`rebind-section`). How a section is typed is noted as the instance's (`TypedSection`).
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, writer)))
do match? tree.nodes[syntax]
    | .node-when-rule-syntax(rule)
        note-truthiness(rule.expr, rule.expr, infer(rule.expr))
        check-statement(rule.body)
        untracked-rule(rule.expr, "when rules must read at least one tracked property")
    | .node-whenever-rule-syntax(rule)
        if rule.kind.text != "value"
            check-markup-trigger(receiver, syntax, rule)
        else
            . value = infer(rule.expr)
            if untracked-rule(rule.expr, "whenever value triggers must read at least one tracked property (like #bar)")
                demand-change-test(rule.expr, value)
            check-statement(rule.body)
    | .node-dependency-declaration(dependency)
        check-dependency(receiver, syntax, dependency.left, dependency.right)
    | .node-subscriber-syntax(section)
        do match? tree.nodes[section.iterator]
            | .node-for-block(row)
                . root = branch-root(receiver, row.loop)
                if root == 0 || rebind-section(receiver, section.iterator, row.loop, root)
                    . lowered = facts.lowers-only(receiver, module, section.iterator)
                    if lowered
                        lowering = section.iterator
                        if !facts.holds-section(sections, receiver, module, section.iterator)
                            facts.lowered-sections += SectionRef(receiver, module, section.iterator)
                        .. sections = facts.lowered-sections
                    facts.typed-sections += TypedSection
                        - instance
                        - receiver
                        - module
                        - section.iterator
                        - lowered
                    rebound-root = root
                    check-for(section.iterator, row.loop, row.body, 0)
                    rebound-root = 0
                    lowering = 0
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do rebind-section Bool
    - receiver TypeId
    - iterator SyntaxId
    - loop SyntaxId
    - root SyntaxId

` A section on a stream of an element a branch of the markup makes, which the reference
` subscribes in a live action of its own that reads the element tracked, as its
` `loopAsRebindingSubscription` does: as the branch makes the element again, the action reads
` the stream again and the tracker of a new subscription to it takes the old one's place. The
` element's property is tracked so. A `whenever` clause there is the reference's error.
. clause = tree.whenever-clause(loop)
if clause != 0
    . message = "A whenever clause cannot follow a named element that a branch rebuilds"
    frame.diagnose(clause, .stated, program.store-atom(message))
    = false
. name = identifier-name(tree, root)!
. place = types.property-named(receiver, name)
if !place
    decline(root)
    = false
demand-live-runtime()
. live = instances.live
. runs = live.action != no-instance && live.previous != no-instance && live.next != no-instance
. adds = live.trackers != no-instance && live.add-tracker != no-instance
if !runs || !adds || live.track == no-instance || live.subscribers == no-instance
    decline(root)
    = false
instances.mark-may-panic(instance)
. key = panics.property-of(receiver, name)
if key
    panics.track(key)
. ref = class-ref(types, types.tracked-root(types.properties[place].owner, name))
facts.note-tracked(ref.module, ref.decl, name)
if !facts.holds-section(facts.rebinding-sections, receiver, module, iterator)
    facts.rebinding-sections += SectionRef(receiver, module, iterator)
= true

────────────────────
_ do branch-root SyntaxId
    - receiver TypeId
    - loop SyntaxId

` The name, read untracked, that the stream a loop of a class's section subscribes to is read
` from, where the markup of the class, or of one above it, gives that name an element written
` in an `if` or a `match` of that markup, outside its functions and loops, or none.
. root SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        root = row.container
. reached = false
while !reached
    do match tree.nodes[root]
        | .node-get-expression(get)
            root = get.object
        ??
            reached = true
. name Atom? = null
do match? tree.nodes[root]
    | .node-identifier(read)
        if !read.is-tracked
            name = read.name
if !name
    = 0
. level TypeId? = receiver
while level
    . ref = class-ref(types, level)
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            if class.content != 0 && branches-element(owner-tree, class.content, name)
                = root
            .. owner-tree = program.modules[ref.module].tree
    level = types.base-of(level)
= 0

────────────────────
_ do branches-element Bool
    - markup AST
    - content SyntaxId
    - name Atom

` Whether a class's markup gives an element of a name in an `if` or a `match` of it, outside
` its functions and loops.
for node in markup.subtree-start(content) .. < content
    do match? markup.nodes[node]
        | .node-markup(element)
            do match? markup.nodes[element.id]
                | .node-identifier(id)
                    if id.name == name && branched(markup, content, node)
                        = true
= false

────────────────────
_ do branched Bool
    - markup AST
    - content SyntaxId
    - element SyntaxId
    - outlets = false

` Whether an element of a class's markup is written in an `if` or a `match` of it, or with
` `outlets` in the default content of a slot, and in no function or loop of it.
. found = false
for node in element + 1 .. < content
    if markup.subtree-start(node) <= element
        do match? markup.nodes[node]
            | .node-function-syntax
                = false
            | .node-for-block
                = false
            | .node-if-block
                found = true
            | .node-match-expression
                found = true
            | .node-slot-outlet
                found = found || outlets
= found

────────────────────
_ do check-markup-trigger
    - receiver TypeId
    - syntax SyntaxId
    - rule ASTWheneverRule

` A `whenever` rule on the markup an object is in, typed as the reference compiles it: the
` object must be a markup host, and so must the class the rule looks for, which, for an
` ancestor, must declare no `==`, since a new ancestor is compared with the last as one object,
` which an optional of the class holds.
` Children and descendants are looked for by the number of the class among the targets of
` descendant queries; a class numbered only as the rule is typed, as one a class with type
` parameters looks for is, has no shape here. Where the rule names its changes, a
` `MarkupChangeSet` of that class is made for it, whose lists take each object added or
` removed and which is emptied after each run. The rule registers with the markup runtime,
` finds parent hosts there, and runs its live action by a call; its body runs in that action.
` The reference's errors for these, and runtime functions that raise, have no shape here.
. ancestor = rule.kind.text == "ancestor"
. host = if is-markup-host(receiver) then markup-host else no-type
    .. markup-host = derived-interface(receiver, types.markup-host-decl)
. target = types.evaluate-type(module, tree, rule.target-type, frame.env)
if host == no-type || target == invalid-type || !is-markup-host(target)
    decline(syntax)
    =
if ancestor
    for token in ["==", "!="]
        if calls.has-operator(target, program.store-atom(token), target)
            decline(syntax)
            =
. found = if ancestor then types.optional-of(target) else no-type
if found != no-type
    types.complete(found)
. trigger = MarkupTrigger
    - instance
    - target
    - 0
    - found
    - host
    - no-type
    - no-instance
    - no-instance
    - no-instance
    - no-instance
    - no-instance
    - no-instance
if !ancestor
    note-class-targets(receiver)
    . found = facts.query-targets.find(target)
    if !found
        decline(syntax)
        =
    trigger.target-id = (found + 1) as U32
demand-live-runtime()
. markup = types.markup-host-decl.module
. mark = scratch.types.mark
for arg in tree.children[rule.args]
    . named SyntaxId = 0
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            do match? tree.nodes[row.pattern]
                | .node-identifier
                    named = row.pattern
                | .node-type-capture(capture)
                    named = if capture.type == 0 then capture.id else 0
    . resolution = bindings.resolution-of(frame.binding, named)
    . name = identifier-atom(named) if named != 0
    trigger.changes = types.well-known-type-of("core/markup", "MarkupChangeSet", target)
    . added = types.property-named(trigger.changes, program.store-atom("added")) if trigger.changes != invalid-type
    if !name || name.text != "changes" || resolution.kind != .resolve-slot || !added
        decline(arg)
        =
    frame.assign(resolution.slot, trigger.changes)
    trigger.made = calls.demand-constructor(trigger.changes, mark)
    trigger.clear = calls.demand-method(trigger.changes, program.store-atom("clear"))
    scratch.types.push(target)
    trigger.record = calls.demand-runtime-call
        - markup
        - types.properties[added].type
        - program.store-atom("+=")
        - mark
    scratch.types.rewind(mark)
if rule.kind.text != "descendants"
    scratch.types.push(host)
    trigger.parent = calls.demand-runtime-call
        - markup
        - no-type
        - program.store-atom("markup-query-parent-host")
        - mark
    scratch.types.rewind(mark)
. callback = types.well-known-type
    - "core/markup"
    - if ancestor then "MarkupAncestorQueryRefresher" else "MarkupDescendantsQueryApplier"
scratch.types.push(host)
if !ancestor
    scratch.types.push(types.size-type)
    scratch.types.push(callback)
scratch.types.push(callback)
trigger.register = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom
        - if ancestor then "register-markup-ancestor-query" else "register-markup-descendants-query"
    - mark
scratch.types.rewind(mark)
trigger.schedule = if types.call-atom then calls.demand-method(types.live-action-type, types.call-atom) else no-instance
for callee in [trigger.made, trigger.clear, trigger.record, trigger.parent, trigger.register, trigger.schedule]
    if callee != no-instance
        demand-errors(callee)
. orphaned = trigger.parent == no-instance && rule.kind.text != "descendants"
. missing = orphaned || trigger.register == no-instance || trigger.schedule == no-instance
. unmade = trigger.changes != no-type && (set-missing || trigger.record == no-instance)
    .. set-missing = trigger.made == no-instance || trigger.clear == no-instance
if missing || unmade || callback == invalid-type
    decline(syntax)
    =
for callee in [trigger.made, trigger.clear, trigger.record, trigger.parent, trigger.register, trigger.schedule]
    if callee != no-instance && instances.signatures[callee].errors.count != 0
        decline(syntax)
        =
facts.markup-triggers += trigger
check-statement(rule.body)

────────────────────
_ do required-argument Atom?
    - receiver TypeId
    - method Atom

` The first argument a class's method of a name requires, where each method of that name the
` class declares requires one, which a dependency, calling it with nothing, cannot give; none
` where one requires none, or the class declares none.
. ref = class-ref(types, receiver)
. owner = program.modules[ref.module]
. required Atom? = null
do match? owner.decls[ref.decl]
    | .decl-class(row)
        for member in owner.member-pool[row.members]
            do match? owner.decls[member]
                | .decl-function(fn)
                    if fn.name && fn.name == method
                        . first = first-required(owner, fn)
                        if !first
                            = null
                        required = first
= required

────────────────────
_ do first-required Atom?
    - owner Module
    - fn FunctionDecl

` The name of the first argument a function requires: one with no default that is not variadic.
for offset in 0 .. < fn.args.count
    . shape = owner.arg-pool[fn.args.start + offset]
    if !shape.has-default && !shape.is-variadic
        = shape.name ?? program.store-atom("_")
= null

────────────────────
_ do check-dependency
    - receiver TypeId
    - syntax SyntaxId
    - left SyntaxId
    - right RowRange'SyntaxId

` A dependency `. m < p, q` of a class: each property it names is tracked, and the method is
` read as a value of the object being made, given as a `Doer` to `property-dependency-subscribe`
` once for each property, or for an object of a markup host to the markup runtime's
` `markup-property-dependency-subscribe`, given the object as its host too. The conversions are
` recorded at the dependency, where the reference places the call the `Doer` makes. The
` reference reports a property or a method the class does not have. A getter is never stored, so
` a dependency on it would never run, and is reported.
for name-syntax in tree.children[right]
    . name = identifier-atom(name-syntax)
    . place = types.property-named(receiver, name) if name
    if !place
        . shown = if name then name.text else ""
        frame.diagnose(syntax, .stated, program.store-atom("Property \"$shown\" does not exist"))
        =
    if types.properties[place].storage-kind == .storage-getter
        . text = "\"${name!.text}\" is a getter, which is never stored, so a dependency on it never runs; depend on the properties it reads"
        frame.diagnose(name-syntax, .stated, program.store-atom(text))
        =
    . ref = class-ref(types, types.tracked-root(types.properties[place].owner, name!))
    facts.note-tracked(ref.module, ref.decl, name!)
. method = identifier-atom(left)
. bound = if method then calls.method-binding(receiver, method, left) else no-type
if bound == invalid-type
    =
if bound == no-type
    . shown = if method then method.text else ""
    frame.diagnose(syntax, .stated, program.store-atom("Function \"$shown\" does not exist"))
    =
. required = required-argument(receiver, method!)
if required
    . text = "A dependency calls \"${method!.text}\" with nothing, but it takes \"${required.text}\"; give \"${required.text}\" a default, or name a method that takes nothing"
    frame.diagnose(left, .stated, program.store-atom(text))
    =
. doer = types.well-known-type("core/function", "Doer")
if doer == invalid-type
    decline(syntax)
    =
facts.set-node-type(instance, left, bound)
conversions.convert(syntax, left, bound, doer, .reason-argument)
demand-live-runtime()
. hosted = is-markup-host(receiver)
. host = if hosted then derived-interface(receiver, types.markup-host-decl) else no-type
. mark = scratch.types.mark
scratch.types.push(receiver)
if hosted
    scratch.types.push(host)
scratch.types.push(types.string-type)
scratch.types.push(doer)
. module = if hosted then types.markup-host-decl.module else live-module
    .. live-module = class-ref(types, types.live-action-type).module
. subscribe = calls.demand-runtime-call
    - module
    - no-type
    - program.store-atom
        - if hosted then "markup-property-dependency-subscribe" else "property-dependency-subscribe"
    - mark
scratch.types.rewind(mark)
if subscribe == no-instance
    decline(syntax)
    =
if hosted
    conversions.convert(syntax, syntax, receiver, host, .reason-markup-host)
facts.note-change-test(instance, subscribe, hosted)

────────────────────
_ do identifier-atom Atom?
    - id SyntaxId

` The name an identifier writes, or none for any other node.
do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name
= null

────────────────────
_ do untracked-rule Bool
    - expr SyntaxId
    - message String

` Reports a rule that has read nothing tracked so far, unless what it read has no shape here;
` whether it has read something.
if instances.rows[instance].is-live
    = true
if !facts.declined-since(0, instance)
    frame.diagnose(expr, .stated, program.store-atom(message))
= false

────────────────────
_ do demand-change-test
    - expr SyntaxId
    - value TypeId

` The function that tells whether a `whenever` rule's value has changed, given the value it
` had and the one it has: `value-changed` of the tracker's runtime, for the value's type.
if value == no-type || value == invalid-type
    =
. mark = scratch.types.mark
scratch.types.push(value)
scratch.types.push(value)
. module = class-ref(types, types.live-action-type).module
. tester = calls.demand-runtime-call(module, no-type, program.store-atom("value-changed"), mark)
scratch.types.rewind(mark)
if tester == no-instance
    decline(expr)
    =
facts.note-change-test(instance, tester)

────────────────────
_ do check-equality

` Types the comparison of two values of the instance's type, which the function a witness
` table holds for equality runs: `==` of two such values, planned in the frame of the type's
` module's main at the type's declaration, as anywhere else.
prepare()
. value = instances.rows[instance].self-type
. site = equality-site(types, program, value)
infer-binary-values(site, .equals-op, site, value, site, value)
instances.set-returns(instance, types.bool-type, types.bool-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do note-value-shape
    - value SyntaxId

` Records how the value a class writes for a property depends on the object it is evaluated
` for: each property it reads, by a name the binder resolved to a member or after the
` receiver, and whether the value evaluates the read whenever it is evaluated; whether it names
` the receiver, and so may read any property; and whether it may evaluate a part of itself and
` not another, which is every value but one made of names, literals, calls, reads and operators
` that test nothing.
if value == 0
    =
for node in tree.subtree-start(value) .. < value + 1
    if !tests-nothing(node)
        instances.rows[instance].branches = true
    do match? tree.nodes[node]
        | .node-identifier(row)
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot && this-slot
                instances.rows[instance].reads-self = true
            .. this-slot = bindings.slots[resolution.slot].kind == .slot-this
            if resolution.kind == .resolve-member
                facts.value-reads.append
                    - ValueRead(instance, row.name, node, evaluated-surely(value, node))
        | .node-get-expression(row)
            do match? tree.nodes[row.object]
                | .node-identifier
                    . resolution = bindings.resolution-of(frame.binding, row.object)
                    if resolution.kind == .resolve-slot && this-object
                        facts.value-reads.append
                            - ValueRead(instance, row.name, node, evaluated-surely(value, node))
                    .. this-object = bindings.slots[resolution.slot].kind == .slot-this

────────────────────
_ tests-nothing Bool
    - node SyntaxId

` Whether a node of a value evaluates all it holds whenever it is evaluated: a name, a literal,
` a call, a block, which evaluates its lines in order, a read or an operator that tests
` nothing.
match tree.nodes[node]
    | .node-integer-syntax
        true
    | .node-block
        true
    | .node-float-syntax
        true
    | .node-string-syntax
        true
    | .node-identifier
        true
    | .node-call-expression
        true
    | .node-argument
        true
    | .node-get-expression(row)
        !row.is-optional
    | .node-index-expression(row)
        !row.is-optional
    | .node-tuple-syntax
        true
    | .node-unary-expression
        true
    | .node-cast-expression
        true
    | .node-type-identifier
        true
    | .node-type-arguments
        true
    | .node-binary-expression(row)
        no-short-circuit && row.op != .if-op && row.op != .else-op

        .. no-short-circuit = row.op != .and-op && row.op != .or-op && row.op != .coalesce-op
    ??
        false

────────────────────
_ do evaluated-surely Bool
    - value SyntaxId
    - node SyntaxId

` Whether a node of a value is evaluated whenever the value is: each node around it that tests
` something holds it in the part evaluated before the test, the left side of `&&`, `||` or
` `??`, or the object an optional read or index reads from.
for around in node + 1 .. < value + 1
    if tree.subtree-start(around) > node || tests-nothing(around)
        continue
    . first = match tree.nodes[around]
        | .node-binary-expression(row)
            if row.op != .if-op then row.lhs else 0
        | .node-get-expression(row)
            row.object
        | .node-index-expression(row)
            row.object
        ??
            0
    if first == 0 || node < tree.subtree-start(first) || node > first
        = false
= true

────────────────────
_ do names-machine Bool
    - slot SlotId

` Whether a slot holds the value of a state machine, which its cases read before the machine's
` union is made where what a case holds is inferred (see `early-union`).
for row in bindings.machines
    if row.bound == slot
        = true
= false

────────────────────
_ do early-union-of TypeId
    - unit InstanceId

` The union made early of the state machine a property's value is, or none. A machine that
` refines another, read while the machines it refines are typed, is read as the union of the
` machine none refines, typed for the same class (`inherited-union`). Where the machine's union is
` made only once its cases are typed, invalid.
. owner = instances.rows[unit].module
. owner-tree = program.modules[owner].tree
do match? program.modules[owner].decls[instances.rows[unit].initializer]
    | .decl-property(found)
        . machine = owner-tree.declared-machine(found.value)
        if machine == 0
            = no-type
        for row in facts.early-unions
            if row.module == owner && row.syntax == machine
                = row.union
        . inherited = inherited-union(instances.rows[unit].self-type, found.name)
        = if inherited != no-type then inherited else invalid-type
= no-type

────────────────────
_ do inherited-union TypeId
    - receiver TypeId
    - name Atom?

` The union of the machine of a property of a name that refines none, typed for a class or for
` the class above it that declares it, where it is typed already, or none.
if !name || receiver == no-type
    = no-type
for fact in facts.machines
    if fact.refined != no-instance || fact.outer != 0 || fact.store != .store-member
        continue
    . held = decl-property-name(fact.module, fact.decl)
    . level = instances.rows[instances.rows[fact.instance].enclosing].self-type
    if held && held == name && holding-type(receiver, class-ref(types, level)) == level
        = fact.union
= no-type

────────────────────
_ do demand-initializer TypeId
    - unit InstanceId
    - written SyntaxId

` The type of a property's value, typed when the property is first read. A read that reaches
` the property again while its value is being typed is a circular reference, unless the value is
` a state machine whose union was made before its cases were typed (`early-union`).
. owner = instances.rows[unit].module
if instances.rows[unit].state == .instance-in-progress
    . early = early-union-of(unit)
    if early == invalid-type
        decline(written)
    if early != no-type
        = early
    facts.record-diagnostic(instance, owner, written, .circular-reference)
    = invalid-type
instances.intern(owner, program.modules[owner].main-decl, no-type, 0, no-instance)
demand-body(unit)
= instances.signatures[unit].returns

────────────────────
_ do note-value-errors
    - property DeclId
    - site SyntaxId

` A module gives its globals their values as it starts, so the errors a value lets out leave
` the module's main at the global's declaration.
. unit = instances.intern-initializer(module, property, no-type)
if instances.rows[unit].state != .instance-done
    =
note-unit-errors(unit, site)

────────────────────
_ do note-unit-errors
    - unit InstanceId
    - site SyntaxId

` The errors a unit the function runs lets out, which leave the function at a node.
if !instances.errors-known(unit)
    defer-outgoing(unit, site)
    =
. signature = instances.signatures[unit]
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], site)

────────────────────
_ do replay-member
    - unit InstanceId

` A constructor runs the values of the properties it is not given, so it may panic where they
` do, and makes the calls they make. The calls are those of the property's own module: a
` constructor in another module has no place in its own source to put them.
. value = instances.rows[unit]
. reader = instances.rows[instance]
if reader.initializer == 0 && reader.module == value.module && reader.decl == value.decl
    =
if value.may-panic
    instances.mark-may-panic(instance)
if value.polls
    instances.mark-polls(instance)
if value.module != (module)
    =
facts.replay-calls(unit, instance)

────────────────────
_ do check-field-default
    - position U32

` The value a tuple's type writes for a field a call of its constructor leaves out, typed where
` the call is, as `check-property-defaults` types every value for a constructor given no field.
` The constructor lets out the errors an eager one may raise, at its class.
. receiver = instances.rows[instance].self-type
if instances.signatures[instance].args.count == 0 || receiver == no-type || receiver == invalid-type
    =
frame.declaration = described!
conversions.attach(this)
calls.attach(this)
. opened = open-class-env(receiver)
frame.outgoing-start = scratch.outgoing.mark
types.complete(receiver)
. filled = 0u32
for property in types.properties-of(receiver)
    if property.slot == U32.max
        continue
    if filled == position && property.storage-kind != .storage-getter
        last-unit = no-instance
        demand-member(property, receiver, property.name, true)
        if property.storage-kind == .storage-eager && last-unit != no-instance && other-unit
            note-unit-errors(last-unit, owner-syntax())
            note-default-use(last-unit)
        .. other-unit = last-unit != instance
        if property.storage-kind == .storage-eager
            construct-default(property, receiver)
    filled += 1
if opened
    frame.close-env()
finish-errors(frame)
scratch.outgoing.rewind(frame.outgoing-start)

────────────────────
_ do type-written-defaults

` Types, as the function is checked, each default written as a constant (`written-constant`),
` which the reference evaluates as the function's module starts whether or not a call takes
` it. Any other default is typed where a call first takes it (`type-default`).
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        for position in 0 .. < fn.args.count
            . syntax = owner-module.arg-pool[fn.args.start + position].default-syntax
            if syntax != 0 && written-constant(syntax) && instances.type-default(instance, position)
                check-default(position)

────────────────────
_ do written-constant Bool
    - syntax SyntaxId

` Whether a default is written as a constant as the reference tells one: a number, a text, a
` symbol, a truth, null, an operator on one of those, or a member named on a type.
do match? tree.nodes[syntax]
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-symbol
        = true
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom || row.name == types.null-atom
    | .node-unary-expression(row)
        = written-constant(row.operand)
    | .node-get-expression(row)
        = !row.is-tracked && !row.is-optional && is-type-syntax(tree, row.object)
= false

────────────────────
_ do check-default
    - position U32

` Types the default a parameter declares, as the parameter's type expects it. A default that
` is no literal and gives another type is converted to the parameter's type where it is
` written, for the calls that take it; a literal is converted at each call. One that no
` conversion takes to the parameter's type is reported by no call that gives the argument.
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        if position >= fn.args.count
            =
        . shape = owner-module.arg-pool[fn.args.start + position]
        if shape.default-syntax == 0
            =
        . slot = argument-slot(position)
        . expected = if slot != no-slot then frame.slot-type(slot) else no-type
        if is-empty-list(shape.default-syntax) && list-expected
            facts.set-node-type(instance, shape.default-syntax, expected)
            calls.note-list(shape.default-syntax, expected)
            =
        .. list-expected = types.ancestor-of(expected, types.list-decl) != no-type
        . given = infer-with-expected(shape.default-syntax, expected)
        . literal = literal-type(types, module, tree, shape.default-syntax, frame.env)
        . converts = typed-default && given != expected && given != invalid-type
            .. typed-default = literal == invalid-type && expected != no-type
        if converts && relation-legal(conversions.compare-held(given, expected))
            conversions.convert
                - shape.default-syntax
                - shape.default-syntax
                - given
                - expected
                - .reason-default
                - true
                - true

────────────────────
_ is-empty-list Bool
    - syntax SyntaxId

` Whether an expression is a list written with no items, which takes the type of the
` parameter it is the default of and has no type anywhere else.
match tree.nodes[syntax]
    | .node-list-syntax(row)
        row.items.count == 0
    ??
        false

────────────────────
_ do argument-slot SlotId
    - position U32

. seen = 0u32
. bound = bindings.bindings[frame.binding]
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    if bindings.slots[slot].kind == .slot-argument
        if seen == position
            = slot
        seen += 1
= no-slot

────────────────────
_ do check-assertion
    - id SyntaxId
    - exception SyntaxId
    - condition SyntaxId

` A condition is typed first, and what is raised under what the condition finds. What typing
` the condition left known, as a lazy local it evaluated, holds after it.
if condition != 0
    note-truthiness(condition, condition, infer-tested(condition))
. mark = scratch.narrowings.mark
if condition != 0
    narrowing.narrow-condition(condition, true)
. saved = frame.surround
frame.surround = frame.surround.effects = exceptional-effects(saved.effects)
. known = frame.save-members()
. raised = infer(exception)
frame.surround = saved
if condition != 0
    frame.restore-members(known)
    pop-conditional(mark)
if raised == invalid-type || raised == no-type
    =
if is-subtype(types, raised, types.panic-type)
    instances.mark-may-panic(instance)
    =
if is-subtype(types, raised, types.error-type)
    note-outgoing(raised, id)
    facts.set-plan(instance, id, .plan-raise)
    =
frame.diagnose(id, .invalid-bang-return, null, raised)

────────────────────
_ do check-suspends
    - site SyntaxId

` A function that may not suspend does not yield, which TypeScript reports where it yields:
` in a GC-free zone, naming where it is entered, or under `@no-suspend` or `@no-safepoint`.
. effects = dispatch-effects(frame.surround.effects)
if (effects /and/ CompilationEffect.no-suspend) == 0
    =
if (effects /and/ CompilationEffect.gc-free) != 0
    frame.diagnose
        - site
        - .stated
        - program.store-atom
            - "cannot suspend inside a GC-free zone (entered at ${frame.zone-entry()})"
    =
frame.diagnose(site, .stated, program.store-atom("cannot suspend inside a @no-suspend context"))

────────────────────
_ do check-zone-store
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - value TypeId

` A GC-free zone stores no managed pointer anywhere but in a local of its own, which
` TypeScript reports where the assignment is: a property, a global or a captured local
` holds what the collector must be told of. A store of `null` holds nothing.
if outside-zone || narrowing.is-null-syntax(rhs) || !is-managed(value, 0)
    =
.. outside-zone = (frame.surround.effects /and/ CompilationEffect.gc-free) == 0
. held = false
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        held = resolution.kind != .resolve-slot || frame.is-captured(resolution.slot)
    | .node-get-expression
        held = true
if !held
    =
. text = "storing a managed pointer is not allowed in a GC-free zone (entered at ${frame.zone-entry()}); compute into a zone buffer and publish after the zone exits"
frame.diagnose(id, .stated, program.store-atom(text))

────────────────────
_ do check-top-level
    - id SyntaxId

` Checks what a module declares, then its statements. A declaration the module holds no row
` for is one no pass models, so it is declined where it is written: no program that holds one
` is taken for understood. One that is a member of a class waits for the class to be used, but
` a section with nothing written in it is the reference's error, and so are a section that
` follows the class's content (`follows-content`) and a member that takes a name the class took
` before (`declare-members`). A local the statements declare again is settled as a block's is
` (`settle-redeclared`).
. decls = program.modules[module].decls
. previous = facts.initializer
facts.initializer = this
. declaring = declaring-type-names()
. classes = Map'ClassName'Bool()
. suffixes = Map'Atom'Atom()
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-case(row)
            if row.value != 0 && is-enum-owner(row.owner)
                infer(row.value)
        | .decl-function(fn)
            if !fn.is-generated
                check-argument-shapes(fn.args)
                if declares-within(declaring, fn.subtree)
                    check-type-params(fn)
                check-duplicate(index as DeclId, fn)
                check-getter-annotations(fn.syntax)
                check-return-mode(index as DeclId, fn.return-type)
        | .decl-event(event)
            if event.owner != 0 && !is-class(event.owner)
                decline(event.syntax)
            else if event.owner != 0
                check-event-owner(event)
        | .decl-associated(associated)
            if associated.binding != 0 && !is-type-syntax(tree, associated.binding)
                . message = program.store-atom("Associated type binding must be a type")
                frame.diagnose(associated.binding, .stated, message)
        | .decl-extension(extension)
            check-extension(extension.syntax)
        | .decl-sheet-extension(extension)
            check-sheet-extension(index as DeclId, extension)
        | .decl-class(class)
            if redeclares-class(classes, class)
                decline(class.syntax)
            else if class.name.text == "This" && is-sheet-decl(module, index as DeclId)
                frame.diagnose
                    - class.syntax
                    - .stated
                    - program.store-atom("\"This\" is not a valid style sheet name")
            else
                declare-members(class)
                check-unit-base(class)
                check-suffixes(class, suffixes)
                if is-sheet-decl(module, index as DeclId)
                    check-derived-sheet(index as DeclId, class)
                    check-sheet-domains(index as DeclId, class)
        | .decl-style-rule(rule)
            if rule.outer == 0
                check-style-rule(index as DeclId, rule)
        | .decl-converter(converter)
            check-conversion-access(converter.syntax, converter.access)
            check-return-mode(index as DeclId, 0)
        | .decl-fromverter(fromverter)
            check-conversion-access(fromverter.syntax, fromverter.access)
            check-return-mode(index as DeclId, 0)
        | .decl-unit(unit)
            check-equality(unit)
        | .decl-property(property)
            if !is-class(property.owner)
                check-member-property(index as DeclId, property)
            . literal = core-literal-type(module, index as DeclId) != no-type
            if property.owner == 0 && property.value != 0 && !property.is-lazy && !literal
                initializing = index as DeclId
                if is-object-construction(property.value)
                    check-module-property(index as DeclId, property.value, property.type-syntax)
                else
                    demand-property(module, index as DeclId)
                    note-value-errors(index as DeclId, property.syntax)
                initializing = 0
do match? tree.nodes[id]
    | .node-top-level-syntax(row)
        . finals [SyntaxId]
        . limits [SyntaxId]
        . open = 0
        . awaiting = await-elements(row.statements)
        . redeclares = redeclares-in(id)
        . projected SyntaxId = 0
        for statement in tree.children[row.statements]
            if redeclares
                if projects()
                    projected = statement
                settle-redeclared(statement, projected)
            if is-finally(statement)
                finals += statement
                limits += 0
            else if !is-declaration-syntax(tree, statement)
                . calls-before U32 = facts.calls.length as U32
                . watches = open < finals.length
                if watches
                    watching-leaves += 1
                raise-statement(statement)
                check-called(statement, check-statement(statement, Want().adding(.want-unused)), true, row.statements)
                if watches
                    watching-leaves -= 1
                if watches && may-leave(calls-before)
                    for position in open .. < finals.length
                        limits[position] = statement
                    open = finals.length
        for position in 0 .. < finals.length
            check-finally(finals[position], limits[position])
        settle-elements(awaiting)
        if program.runs-main(module)
            note-main-end(id)
. undeclared = program.modules[module].undeclared
for position in 0 .. < undeclared.length
    . owner = program.modules[module].undeclared-owners[position]
    if owner == 0
        decline(undeclared[position])
    else if tree.is-empty-section(undeclared[position])
        frame.diagnose
            - undeclared[position]
            - .stated
            - program.store-atom("Empty content section not permitted")
    else if follows-content(undeclared[position], owner)
        frame.diagnose
            - undeclared[position]
            - .stated
            - program.store-atom("Only one content section permitted")
initialize-classes()
facts.initializer = previous

────────────────────
_ do note-main-end
    - id SyntaxId

` The program's main calls `end-main` of core where its statements end, before its cleanups run,
` as the reference does. The call is recorded at the main's node.
. found = program.module-by-name("core/task")
if !found
    decline(id)
    =
. mark = scratch.types.mark
. callee = calls.demand-runtime-call(found as ModuleId, no-type, program.store-atom("end-main"), mark)
scratch.types.rewind(mark)
if callee == no-instance
    decline(id)
    =
facts.record-call(frame.instance, id, callee, .call-function, scratch.no-fills, false)

────────────────────
_ do declare-members
    - class ClassDecl

` Checks each member of a class against those it declares before, as the reference does as it
` declares the class, whether or not the class is used: a property or a getter takes a name for
` a property, which a property or a getter of that name redefines, and an event or an associated
` type takes a name for a member, which nothing may take again. A setter takes the name for a
` property where nothing took it.
. owner = program.modules[module]
. properties [Atom]
. members [Atom]
for member in owner.member-pool[class.members]
    do match? owner.decls[member]
        | .decl-property(property)
            if property.name && !property.defaults-root && property.element == 0
                take-property-name(property.name, property.syntax, properties, members)
        | .decl-function(fn)
            if fn.name && !fn.is-generated && fn.kind == .getter-decl
                take-property-name(fn.name, fn.syntax, properties, members)
            if fn.name && plain-setter && properties.find(fn.name) == null
                take-property-name(fn.name, fn.syntax, properties, members)
            .. plain-setter = !fn.is-generated && fn.kind == .setter-decl
            if fn.name && plain-method && members.find(fn.name) != null
                frame.diagnose
                    - fn.syntax
                    - .stated
                    - program.store-atom("Redefinition of class member")
            .. plain-method = !fn.is-generated && !fn.is-static && fn.kind == .function-decl
        | .decl-event(event)
            take-member-name(event.name, event.syntax, properties, members)
        | .decl-associated(associated)
            take-member-name(associated.name, associated.syntax, properties, members)

────────────────────
_ do take-property-name
    - name Atom
    - site SyntaxId
    - properties [Atom]
    - members [Atom]

if members.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of class member"))
else if properties.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of property"))
else
    properties += name

────────────────────
_ do take-member-name
    - name Atom
    - site SyntaxId
    - properties [Atom]
    - members [Atom]

if members.find(name) != null || properties.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of class member"))
else
    members += name

────────────────────
_ do follows-content Bool
    - member SyntaxId
    - owner DeclId

` Whether a section written in a class follows the class's content: an earlier section, or a
` `• This` with lines that are not its own (`rule-part`), which the reference makes the content.
` The reference reports a second as it declares the class, used or not.
if !(tree.nodes[member] is .node-content-block)
    = false
do match? program.modules[module].decls[owner]
    | .decl-class(class)
        do match? tree.nodes[class.syntax]
            | .node-class-block(row)
                for written in tree.children[row.members]
                    if written == member
                        = false
                    if tree.nodes[written] is .node-content-block || holds-markup(written)
                        = true
= false

────────────────────
_ do holds-markup Bool
    - rule SyntaxId

` Whether a style rule is a `• This` with a line of its body that is not the rule's own.
do match? tree.nodes[rule]
    | .node-rule-syntax(row)
        if row.name.text != "This" || row.body == 0
            = false
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    if !tree.rule-part(statement)
                        = true
= false

────────────────────
_ do check-member-property
    - decl DeclId
    - property PropertyDecl

=? if !check-keyed-name(property)
check-annotations(property)
check-property(decl, property)
if property.owner != 0 && property.name
    check-union-member(property.owner, property.name, property.syntax, true)

────────────────────
_ do check-event-owner
    - event EventDecl

` Reports an event a struct or a tuple declares: an event belongs to an object, whose
` subscribers it keeps, and a value of a struct or a tuple is copied, so none would hear it.
do match? program.modules[module].decls[event.owner]
    | .decl-class(class)
        if class.base == 0
            =
        . base = types.evaluate-type(module, tree, class.base, frame.env)
        if base == invalid-type || base == no-type
            =
        . kind = types.intrinsic-of(base)
        if kind != .struct && kind != .tuple
            =
        . shape = if kind == .struct then "struct" else "tuple"
        . text = "Only a class can declare an event, which belongs to an object, and ${class.name.text} is a ${shape}, whose values are copied; declare ${class.name.text} as a class"
        frame.diagnose(event.syntax, .stated, program.store-atom(text))

────────────────────
_ is-class Bool
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-class
        decl != 0
    ??
        false

────────────────────
_ do check-default-cycles
    - decl DeclId
    - class ClassDecl

` A stored property's value cannot depend on itself through the values of the properties
` beside it. The values are followed once: a property is not reached yet, being followed, or
` done, and a value that reads one being followed closes a circle. Only then is the first
` property declared that is on a circle looked for, to be reported: as one that initializes
` after the class's markup where a value on the circle reads an element the markup names. A
` state machine is no such value: its cases run on the object, as the reference compiles them.
. owner = program.modules[module]
. count = class.members.count
. values = SyntaxId[count]
. sites = SyntaxId[count]
. states = U8[count]
. offset = 0u32
for member in owner.member-pool[class.members]
    do match? owner.decls[member]
        | .decl-property(property)
            if property.name && property.value != 0 && !property.is-lazy && no-machine
                values[offset] = property.value
                sites[offset] = property.syntax
            .. no-machine = tree.declared-machine(property.value) == 0
    offset += 1
. circular = false
. pending [U32]
. cursors [SyntaxId]
for start in 0 .. < count
    if values[start] == 0 || states[start] != 0 || circular
        continue
    states[start] = 1
    pending += start
    cursors += tree.subtree-start(values[start])
    while pending.length != 0 && !circular
        . current = pending[pending.length - 1]
        . id = cursors[cursors.length - 1]
        if id > values[current]
            states[current] = 2
            pending.pop()
            cursors.pop()
            continue
        cursors[cursors.length - 1] = id + 1
        . read = default-read(class, id)
        if read == U32.max || values[read] == 0
            continue
        if states[read] == 1
            circular = true
        else if states[read] == 0
            states[read] = 1
            pending += read
            cursors += tree.subtree-start(values[read])
if !circular
    =
for start in 0 .. < count
    if values[start] != 0 && reads-itself(class, values, start)
        if puts-off-circle(decl, class, values, start)
            . name = default-name(class, start)
            . message = "Property \"${name.text}\" depends on itself through properties that initialize after its markup"
            frame.diagnose(sites[start], .stated, program.store-atom(message))
        else
            frame.diagnose(sites[start], .circular-reference)
        =

────────────────────
_ do reads-itself Bool
    - class ClassDecl
    - values [SyntaxId]
    - start U32

` Whether the value of a stored property reads the property, by itself or through the values
` of the properties it reads.
. reached = Bool[values.length]
. pending [U32]
pending += start
while pending.length != 0
    . current = pending[pending.length - 1]
    pending.pop()
    for id in tree.subtree-start(values[current]) .. values[current]
        . read = default-read(class, id)
        if read == U32.max || values[read] == 0
            continue
        if read == start
            = true
        if !reached[read]
            reached[read] = true
            pending += read
= false

────────────────────
_ do puts-off-circle Bool
    - decl DeclId
    - class ClassDecl
    - values [SyntaxId]
    - start U32

` Whether a value on a circle, or one it reads, reads an element the markup of the class
` names, so that the reference puts the circle off until the markup has run.
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, decl, mark)
scratch.types.rewind(mark)
if owner == invalid-type || owner == no-type
    = false
types.complete(owner)
. reached = Bool[values.length]
. pending [U32]
pending += start
reached[start] = true
while pending.length != 0
    . current = pending[pending.length - 1]
    pending.pop()
    if reads-element(owner, tree, values[current])
        = true
    for id in tree.subtree-start(values[current]) .. values[current]
        . read = default-read(class, id)
        if read != U32.max && values[read] != 0 && !reached[read]
            reached[read] = true
            pending += read
= false

────────────────────
_ do default-name Atom
    - class ClassDecl
    - offset U32

. owner = program.modules[module]
do match? owner.decls[owner.member-pool[class.members.start + offset]]
    | .decl-property(property)
        = property.name!
?! Panic("A value on a circle belongs to no property")

────────────────────
_ do default-read U32
    - class ClassDecl
    - id SyntaxId

` The place among a class's members of the stored property with a value that a node names,
` or none.
. owner = program.modules[module]
do match? tree.nodes[id]
    | .node-identifier(row)
        . place = owner.first-member(class.members, row.name)
        while place != no-member
            do match? owner.decls[owner.member-pool[place]]
                | .decl-property(property)
                    if property.value != 0 && !property.is-lazy
                        = place - class.members.start
            place = owner.member-links[place]
= U32.max

────────────────────
_ do check-associated
    - decl DeclId
    - class ClassDecl

` A type binds every associated type the interfaces it implements require, as openly as the
` requirement and with as many parameters.
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, decl, mark)
if owner == invalid-type
    =
types.complete(owner)
if types.intrinsic-of(owner) == .interface
    =
. seen [TypeId]
. level TypeId? = owner
while level
    for interface in types.interfaces-of(level)
        if !check-requirements(owner, class, interface, seen)
            =
    level = types.base-of(level)

────────────────────
_ do check-requirements Bool
    - owner TypeId
    - class ClassDecl
    - interface TypeId
    - seen [TypeId]

if seen.find(interface) != null
    = true
seen += interface
types.complete(interface)
. ref = class-ref(types, interface)
. declaring = program.modules[ref.module]
do match? declaring.decls[ref.decl]
    | .decl-class(required)
        for member in declaring.member-pool[required.members]
            do match? declaring.decls[member]
                | .decl-associated(requirement)
                    if !check-binding(owner, class, requirement)
                        = false
for parent in types.interfaces-of(interface)
    if !check-requirements(owner, class, parent, seen)
        = false
. base = types.base-of(interface)
if base
    = check-requirements(owner, class, base, seen)
= true

────────────────────
_ do check-binding Bool
    - owner TypeId
    - class ClassDecl
    - requirement AssociatedDecl

. name = requirement.name
. level TypeId? = owner
while level
    . ref = class-ref(types, level)
    . declaring = program.modules[ref.module]
    do match? declaring.decls[ref.decl]
        | .decl-class(holder)
            for member in declaring.member-pool[holder.members]
                do match? declaring.decls[member]
                    | .decl-associated(binding)
                        if binding.name != name
                            continue
                        . message = ""
                        if is-public(requirement.access) && !is-public(binding.access)
                            message = "Associated type ${name.text} must be public"
                        else if binding.type-args.count != requirement.type-args.count
                            message = "Associated type ${name.text} has incompatible arity"
                        if message.length == 0
                            = true
                        facts.record-diagnostic
                            - instance
                            - ref.module
                            - binding.syntax
                            - .stated
                            - program.store-atom(message)
                        = false
    level = types.base-of(level)
. shown = type-short-name(types, owner)
. message = "Must implement associated type ${name.text} in $shown"
frame.diagnose(class.syntax, .stated, program.store-atom(message))
= false

────────────────────
_ do check-conversion-access
    - syntax SyntaxId
    - access Access

` A conversion applies wherever its types meet, so it cannot be private to a module.
if !is-public(access)
    frame.diagnose(syntax, .stated, program.store-atom("Converters must be public"))

────────────────────
_ do check-equality
    - unit UnitDecl

` An equality relates two units wherever they meet, so it is public, and each side of it
` measures in a unit of its own. The type store declared it before anything was typed; one
` it could not evaluate is not a constant, at the first operation that gives no number.
if !is-public(unit.access)
    frame.diagnose(unit.syntax, .stated, program.store-atom("Equalities must be public"))
    =
if misstates-unit(unit.number) || misstates-unit(unit.value)
    =
. offset = offset-of(unit.number)
. shifted = if offset != 0 then offset else offset-of(unit.value)
if shifted != 0
    . message = "An equality relates two units by a ratio alone, so a number with no unit cannot be added to or taken from one; write the ratio as one number in the unit"
    frame.diagnose(shifted, .stated, program.store-atom(message))
    =
. diagnosed = facts.diagnostics.length
. left = unit-of(unit.number)
. right = unit-of(unit.value)
if facts.diagnostics.length != diagnosed
    =
if left == no-type || right == no-type
    frame.diagnose(unit.syntax, .stated, program.store-atom("Ambiguous units"))
    =
for side in [left, right]
    if side != invalid-type && types.completions[side].is-builtin
        . shown = type-short-name(types, side)
        . message = "An equality relates units a program declares, and $shown is a number type of the language; write each side in a unit the program declares"
        frame.diagnose(unit.syntax, .stated, program.store-atom(message))
        =
for equality in types.equalities
    if equality.from == left && equality.to == right
        disagrees(unit.syntax, left, right)
        =
. unevaluated = unevaluated-operation(unit.number)
. failed = if unevaluated != 0 then unevaluated else unevaluated-operation(unit.value)
. place = if failed != 0 then failed else unit.syntax
frame.diagnose(place, .stated, program.store-atom("Invalid constant expression"))

────────────────────
_ do disagrees
    - id SyntaxId
    - left TypeId
    - right TypeId

` Reports an equality between two units that another written between them disagrees with: a
` number would convert by whichever is found first.
. ratios [F64]
for equality in types.equalities
    if equality.from == left && equality.to == right
        ratios += equality.ratio.multiplier / equality.ratio.divisor
for ratio in ratios
    . quotient = ratio / ratios[0]
    if quotient > 1.000000001 || quotient < 0.999999999
        . from = type-short-name(types, left)
        . to = type-short-name(types, right)
        . message = "Equalities between $from and $to disagree: one makes 1 $from ${ratios[0]} $to, another ${ratio} $to; keep one of them"
        frame.diagnose(id, .stated, program.store-atom(message))
        =

────────────────────
_ do check-suffixes
    - class ClassDecl
    - suffixes Map'Atom'Atom

` Reports a name written in parentheses after a class's own, as a unit's suffix is, that a class
` its module declares before it wrote already, which `suffixes` holds, and holds from now on, or
` that a class of a module it can name writes (`imported-suffix`), which it would hide there. It
` is reported at the class's base, written on the line of the name.
for offset in 0 .. < class.aliases.count
    . alias = tree.atoms[class.aliases.start + offset]
    . earlier = suffixes[alias] ?? imported-suffix(alias)
    if earlier
        . message = "\"${alias.text}\" already names ${earlier.text}; give ${class.name.text} a suffix of its own"
        frame.diagnose(if class.base != 0 then class.base else class.syntax, .stated, program.store-atom(message))
    else
        suffixes[alias] = class.name

────────────────────
_ do imported-suffix Atom?
    - alias Atom

` The name of a public class of another module this one can name that writes a name in
` parentheses after its own, as `Char` writes `c`, or none.
for candidate in program.lookup(module, alias)
    if candidate.module == module || program.listed-last(module, candidate.module) == U32.max
        continue
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-class(row)
            if row.name != alias && row.access == .public-access
                = row.name
= null

────────────────────
_ do offset-of SyntaxId
    - expr SyntaxId

` The first number with no unit a side of an equality adds to or takes from a number in a unit
` other than zero, which is no ratio, or none. Zero in a unit adds nothing, as in
` `(1 / 3) + 0foo`, which writes a third of foo.
do match? tree.nodes[expr]
    | .node-binary-expression(row)
        . inner = offset-of(row.lhs)
        if inner != 0
            = inner
        . right = offset-of(row.rhs)
        if right != 0
            = right
        if row.op != .add-op && row.op != .subtract-op
            = 0
        . left-unit = has-unit(row.lhs)
        . right-unit = has-unit(row.rhs)
        if left-unit && !right-unit && !zero-amount(row.lhs)
            = row.rhs
        if right-unit && !left-unit && !zero-amount(row.rhs)
            = row.lhs
= 0

────────────────────
_ has-unit Bool
    - expr SyntaxId

` Whether a side of an equality writes a number in a unit.
match tree.nodes[expr]
    | .node-integer-syntax(row)
        row.unit != null
    | .node-float-syntax(row)
        row.unit != null
    | .node-binary-expression(row)
        has-unit(row.lhs) || has-unit(row.rhs)
    ??
        false

────────────────────
_ zero-amount Bool
    - expr SyntaxId

` Whether a side of an equality is a number written as zero.
match tree.nodes[expr]
    | .node-integer-syntax(row)
        (row.value as F64) == 0.0
    | .node-float-syntax(row)
        (row.value as F64) == 0.0
    ??
        false

────────────────────
_ do check-unit-base
    - class ClassDecl

` A class declared as a number of a unit, as `Hours` is `60minutes`, is declared in a unit the
` program has, as `misstates-unit` says.
if class.base != 0
    do match? tree.nodes[class.base]
        | .node-type-numeric(numeric)
            do misstates-unit(numeric.value)

────────────────────
_ do misstates-unit Bool
    - id SyntaxId

` Reports a side of a unit's declaration written as a number in a unit that names nothing, or
` as zero of a unit, which relates no number of one to the other, and says whether it did.
. text = ""
. unit Atom? = null
do match? tree.nodes[id]
    | .node-integer-syntax(row)
        text = row.value
        unit = row.unit
    | .node-float-syntax(row)
        text = row.value
        unit = row.unit
if !unit
    = false
if literal-unit(id, text, unit) == invalid-type
    = true
if (text as F64) != 0.0
    = false
. message = "A unit cannot be declared as zero of another, which no number of it would convert from; write a number other than zero"
frame.diagnose(id, .stated, program.store-atom(message))
= true

────────────────────
_ do unevaluated-operation SyntaxId
    - expr SyntaxId

` The first operation of a side of an equality that gives no number, its operands before it and
` the left before the right, as the reference evaluates them, or none.
do match? tree.nodes[expr]
    | .node-binary-expression(row)
        . left = unevaluated-operation(row.lhs)
        if left != 0
            = left
        . right = unevaluated-operation(row.rhs)
        if right != 0
            = right
        if !is-constant-arithmetic(row.op)
            = expr
= 0

────────────────────
_ do unit-of TypeId
    - expr SyntaxId

` The unit an expression of an equality measures in, and no type for a bare number. Two
` units cannot meet in one operation.
do match? tree.nodes[expr]
    | .node-integer-syntax(row)
        = if row.unit then unit-class(row.unit) else no-type
    | .node-float-syntax(row)
        = if row.unit then unit-class(row.unit) else no-type
    | .node-binary-expression(row)
        . left = unit-of(row.lhs)
        . right = unit-of(row.rhs)
        if left != no-type && right != no-type
            frame.diagnose(expr, .stated, program.store-atom("Conflicting units"))
            = invalid-type
        = if left != no-type then left else right
= no-type

────────────────────
_ do check-extension
    - syntax SyntaxId

` An extension adds behavior to a type it does not own: it cannot yet make the type implement
` an interface, and it cannot add storage.
do match? tree.nodes[syntax]
    | .node-extension(row)
        if row.as-types.count != 0
            frame.diagnose(syntax, .stated, program.store-atom("Not yet implemented"))
            =
        for member in tree.children[row.body]
            do match? tree.nodes[member]
                | .node-property-syntax
                    . message = "Stored properties are not allowed in extensions"
                    frame.diagnose(member, .stated, program.store-atom(message))
                    =

────────────────────
_ do check-base
    - decl DeclId
    - class ClassDecl

` A type cannot derive from a function type by name, nor from a type no value is an instance
` of in its own right. A base written that names nothing, as one declared in a module this one
` does not import, is reported (`missing-type`); `check-derived-sheet` reports a style sheet's.
if class.base == 0
    =
. named = types.type-syntax-name(tree, class.base)
. illegal = named != null && (named == types.function-atom! || named == types.cfunction-atom!)
if !illegal
    . env = types.class-env(module, decl)
    . sole = class.or-bases.count == 0 && !is-sheet-decl(module, decl)
    . missing = sole && report-missing-type(class.base, env)
    for alternative in tree.children[class.or-bases]
        missing = missing || report-missing-type(alternative, env)
    . base = types.evaluate-type(module, tree, class.base, env)
    types.env-release(env)
    =? if missing
    illegal = base != invalid-type && is-illegal-base(types.intrinsic-of(base))
if illegal
    frame.diagnose(class.syntax, .stated, program.store-atom("Type has illegal base class"))

────────────────────
_ do check-interfaces
    - decl DeclId
    - class ClassDecl

` An interface written that names nothing, as one declared in a module this one does not import,
` is reported (`missing-type`). A row that names a class, a struct or a tuple names no interface:
` the type it is built on is written in its header, and it has one.
if class.interfaces.count == 0
    =
. env = types.class-env(module, decl)
for interface in program.modules[module].syntax-pool[class.interfaces]
    if !report-missing-type(interface, env)
        . named = types.evaluate-type(module, tree, interface, env)
        . kind = if named != invalid-type then types.intrinsic-of(named) else IntrinsicKind.none
        if kind == .class || kind == .struct || kind == .tuple
            . shown = type-short-name(types, named)
            . lead = "${class.name.text} cannot implement $shown, which is not an interface"
            . base = if class.base != 0 then types.evaluate-type(module, tree, class.base, env) else no-type
            . text = if base == no-type || base == invalid-type then "$lead; a type is built on one type, written in its header, as in \"+ ${class.name.text} is $shown\"" else "$lead; ${class.name.text} is built on ${type-short-name(types, base)}, and a type is built on one type"
            frame.diagnose(interface, .stated, program.store-atom(text))
types.env-release(env)

────────────────────
_ do check-content
    - decl DeclId
    - class ClassDecl

` A section of a type with markup written in it is the type's content, which only a class
` holds. A struct says that it holds none; in a type of any other kind the section is declined.
` A root `<This` is checked as the reference checks it.
if class.content == 0
    =
if class.or-bases.count != 0
    decline(class.content)
    =
if class.base != 0
    . env = types.class-env(module, decl)
    . base = types.evaluate-type(module, tree, class.base, env)
    types.env-release(env)
    if base == invalid-type
        =
    . kind = types.intrinsic-of(base)
    if kind == .struct
        . message = program.store-atom("Content is not supported on structs")
        frame.diagnose(class.syntax, .stated, message)
        =
    if kind != .class
        decline(class.content)
        =
check-root(decl, class)

────────────────────
_ do check-root
    - decl DeclId
    - class ClassDecl

` The root `<This` of the markup written in a class names no object, takes no argument and fills no
` slot, and every other line of the markup is written in it, but state machines. Each of its lines
` that assigns gives a property the class has from a class above its first value: a property stored
` in the object, given one value. One the class declares itself with a value is given two; one it
` declares with none takes this one. A name that is no property is one of a style, where a style
` could answer it, which the constructor declares (`apply-root-rules`), and else is no name at all.
` The style rules it applies are applied by the constructor (`apply-root-rules`), and are declined
` where the program has no style runtime.
. root = tree.root-this(class.content)
do match? tree.nodes[root]
    | .node-markup(row)
        if row.id != 0
            frame.diagnose(row.id, .stated, program.store-atom("Root <This> cannot have an id"))
            =
        if row.slot-binding != 0
            frame.diagnose
                - row.slot-binding
                - .stated
                - program.store-atom("Root <This> cannot bind a slot")
            =
        if row.args.count != 0
            . message = program.store-atom("Root <This> cannot pass constructor arguments")
            frame.diagnose(tree.children[row.args.start], .stated, message)
            =
        if row.slot-parameter != 0 || (row.style-rule-applications.count != 0 && no-style-module)
            decline(root)
            =
        .. no-style-module = !program.module-by-name("core/style")
        do match? tree.nodes[class.content]
            | .node-content-block(section)
                do match? tree.nodes[section.body]
                    | .node-block(block)
                        for statement in tree.children[block.body]
                            if statement == root || tree.nodes[statement] is .node-state-machine
                                continue
                            . message = program.store-atom
                                - "Root <This> must wrap all class content"
                            frame.diagnose(root, .stated, message)
                            =
        . mark = scratch.types.mark
        . owner = types.class-pattern-with-args(module, decl, mark)
        if owner == invalid-type
            =
        types.complete(owner)
        . seen [Atom]
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            . name = style-name(tree, attribute.lhs)
                            if !name || attribute.op != .eq-op
                                decline(statement)
                                =
                            . place = types.property-named(owner, name)
                            if !place
                                if program.module-by-name("core/style")
                                    continue
                                frame.diagnose
                                    - attribute.lhs
                                    - .stated
                                    - program.store-atom("Property not found")
                                =
                            if seen.find(name) != null
                                . message = program.store-atom
                                    - "Duplicate root <This> property default"
                                frame.diagnose(attribute.lhs, .stated, message)
                                =
                            seen += name
                            if types.properties[place].storage-kind != .storage-eager
                                . message = program.store-atom
                                    - "Root <This> can only default eager properties"
                                frame.diagnose(attribute.lhs, .stated, message)
                                =
                            . own = owner-property(program, module, decl, name)
                            do match? program.modules[module].decls[own]
                                | .decl-property(property)
                                    if own != 0 && !property.defaults-root && property.value != 0
                                        . message = "Root <This> property default duplicates property declaration"
                                        frame.diagnose
                                            - attribute.lhs
                                            - .stated
                                            - program.store-atom(message)
                                        =

────────────────────
_ is-illegal-base Bool
    - kind IntrinsicKind

match kind
    |= .bool
        true
    |= .optional
        true
    |= .void
        true
    |= .closure
        true
    |= .capture
        true
    |= .binding
        true
    |= .type-info
        true
    ??
        false

────────────────────
_ do check-property
    - decl DeclId
    - property PropertyDecl

` A property a type declares for itself has one declaration, a type or a value to take its
` type from, or a line of the class's markup that gives it one (`content-property`), and a way
` of being stored that the type's layout can hold. A type written for it that names nothing is
` reported (`missing-type`). The flag of a case of a machine that refines the machine of its
` base's property is the base's, and so is the projection of one that refines a machine of its
` base's markup. An interface stores nothing: what it requires of the types that are it is a
` getter.
if property.owner == 0 || !property.name
    =
. name = property.name
. storage = if property.is-lazy then StorageKind.storage-lazy else StorageKind.storage-eager
. typed = stated || property.context != 0 || property.line != 0
    .. stated = property.type-syntax != 0 || property.flag != 0
typed = typed || property.part != 0 || property.projection != 0
if !check-member(decl, property.owner, name, property.syntax, storage, plainly-typed)
    =
.. plainly-typed = typed && property.flag == 0 && property.projection == 0
if property.type-syntax != 0
    . env = types.class-env(module, property.owner)
    . reported = report-missing-type(property.type-syntax, env)
    types.env-release(env)
    =? if reported
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, property.owner, mark)
if owner == invalid-type
    =
. kind = types.intrinsic-of(owner)
if kind == .interface
    frame.diagnose(property.syntax, .stated, program.store-atom(stored-interface-text(property)))
    =
if kind == .struct && property.value != 0
    do match? tree.nodes[property.value]
        | .node-state-machine
            . message = "State machine properties are not supported on structs"
            frame.diagnose(property.syntax, .stated, program.store-atom(message))
            =
if !typed && property.value == 0
    . shown = type-short-name(types, owner)
    . message = "Property '${name.text}' of '$shown' needs either a type or a value"
    frame.diagnose(property.syntax, .stated, program.store-atom(message))

────────────────────
_ do stored-interface-text String
    - property PropertyDecl

` The error of a property an interface declares to store: one with no value is a getter the
` types that are the interface answer, and one with a value a getter that gives it. A state
` machine, or one of its cases, belongs in the types that are the interface.
. shown = match program.modules[module].decls[property.owner]
    | .decl-class(class)
        class.name.text
    ??
        "?"
. machine = property.value != 0 && tree.nodes[property.value] is .node-state-machine
if machine || tree.nodes[property.syntax] is .node-state-case
    = "$shown is an interface, so it cannot hold a state machine; declare the machine in the classes that are $shown"
. name = property.name!.text
. lead = "$shown is an interface, so it cannot store \"$name\""
if property.value != 0
    . written = if property.is-lazy then ":=" else "="
    = "$lead; declare a getter that gives the value, with \"=>\" in place of \"$written\""
if property.type-syntax == 0
    = "$lead; declare a getter for the types that are $shown to answer"
. env = types.class-env(module, property.owner)
. stated = types.evaluate-type(module, tree, property.type-syntax, env)
types.env-release(env)
= "$lead; declare a getter for the types that are $shown to answer, as in \"+ get $name ${type-source(types, stated)}\""

────────────────────
_ do check-union-member
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId
    - stored Bool

` A union holds one of its cases and nothing more, so it declares only getters, and none
` under a name every union already answers to.
. owned = match program.modules[module].decls[owner-decl]
    | .decl-class
        true
    ??
        false
if !owned
    =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type || types.intrinsic-of(owner) != .union
    =
if stored
    . message = program.store-atom("Unions can only declare getter properties")
    frame.diagnose(syntax, .stated, message)
    =
. label = name.text
if label == "case" || label == "name" || label == "type"
    . message = "Union property '$label' conflicts with reserved union property"
    frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-member Bool
    - decl DeclId
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId
    - storage StorageKind
    - typed Bool

` Checks a property or getter against the others of its name: one the same type declares
` before it, which `declare-members` reported, and one the type inherits, which it may restate
` only stored the same way and without a type of its own. A state case that restates an inherited
` case is a refinement's to check (`refines-shaped`). Says whether the member stands.
. decls = program.modules[module].decls
do match decls[owner-decl]
    | .decl-class(class)
        if storage != .storage-getter
            . place = program.modules[module].first-member(class.members, name)
            while place != no-member
                . member = program.modules[module].member-pool[place]
                place = program.modules[module].member-links[place]
                do match? decls[member]
                    | .decl-property(other)
                        if member < decl && other.name && other.name == name
                            = false
                    | .decl-event(other)
                        if member < decl && other.name == name
                            = false
    ??
        = true
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type
    = true
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && declares-event(base, name)
    . message = "Inherited event \"${name.text}\" cannot be redeclared as a property"
    frame.diagnose(syntax, .stated, program.store-atom(message))
    = false
. inherited = types.property-named(base, name) if base != no-type
if inherited && tree.nodes[syntax] is .node-state-case
    = true
if inherited
    if types.properties[inherited].storage-kind != storage
        . message = "Inherited properties must have same assignment type"
        frame.diagnose(syntax, .stated, program.store-atom(message))
        = false
    if typed && (storage != .storage-getter || states-getter-type(base, name))
        . message = "Illegal to redefine type of inherited property"
        frame.diagnose(syntax, .stated, program.store-atom(message))
        = false
    = true
. kind = types.intrinsic-of(owner)
. stores = storage != .storage-getter
. unsupported = stores && intrinsic-is-numeric(kind)
if storage == .storage-lazy && (kind == .tuple || kind == .struct)
    unsupported = true
if unsupported
    frame.diagnose(syntax, .stated, program.store-atom("Property not supported"))
    = false
= true

────────────────────
_ do check-inherited-method
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId

. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type
    =
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && declares-event(base, name)
    . message = "Inherited event \"${name.text}\" cannot be redeclared as a method"
    frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-inherited-event
    - event EventDecl

` An event may not take the name of a property or an event its class inherits, what it
` publishes is a type other than `Void`, and the key it is published by, where it has one, is
` an `EventKey` (see `event-key`). One whose class took its name before is checked no further,
` as `declare-members` reported it.
. decls = program.modules[module].decls
do match? decls[event.owner]
    | .decl-class(class)
        . place = program.modules[module].first-member(class.members, event.name)
        while place != no-member
            . member = program.modules[module].member-pool[place]
            place = program.modules[module].member-links[place]
            . earlier = match decls[member]
                | .decl-property(other)
                    other.syntax < event.syntax && other.name && other.name == event.name
                | .decl-event(other)
                    other.syntax < event.syntax && other.name == event.name
                | .decl-associated(other)
                    other.syntax < event.syntax && other.name == event.name
                ??
                    false
            if earlier
                =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, event.owner, mark)
if owner == invalid-type
    =
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && types.property-named(base, event.name) != null
    . message = "Inherited property \"${event.name.text}\" cannot be redeclared as an event"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
if base != no-type && declares-event(base, event.name)
    . message = "Inherited event \"${event.name.text}\" cannot be redeclared"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
if base != no-type && declares-method(base, event.name)
    . message = "Inherited method \"${event.name.text}\" cannot be redeclared as an event"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
. payload = declared-payload(owner, event.type-syntax)
if payload == no-type
    if !report-missing-type(event.type-syntax, frame.env)
        decline(event.syntax)
    =
if payload == types.void-type
    . message = "An event gives each subscriber a value, so it cannot carry Void; an event that only signals carries Bool, as in \"+ event ${event.name.text} Bool\""
    frame.diagnose(event.type-syntax, .stated, program.store-atom(message))
    =
if event.key-type == 0
    =
. key = declared-payload(owner, event.key-type)
if key == no-type
    if !report-missing-type(event.key-type, frame.env)
        decline(event.syntax)
    =
if !event-key(key)
    . message = "Keyed event keys must conform to EventKey: integer, Char, Bool, interned identity, or an integer (index, generation) handle; Float and user-defined equality/hash keys are not supported"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))

────────────────────
_ do event-key Bool
    - type TypeId

` Whether a type keys an event: an integer, a `Char` or a `Bool`, or a tuple of an integer
` `index` and an integer `generation`, or a type named for such a tuple.
if is-integer-kind(types.intrinsic-of(type))
    = true
. base = types.base-of(type) ?? no-type
if types.rows[type] is .type-class && base != no-type && types.rows[base] is .type-tuple
    = event-key(base)
do match? types.rows[type]
    | .type-tuple(row)
        if row.fields.count != 2 || row.names.count != 2
            = false
        if types.child-name(row.names, 0).text != "index" || not-generation
            = false
        .. not-generation = types.child-name(row.names, 1).text != "generation"
        = integer-index && is-integer-kind(types.intrinsic-of(types.child-type(row.fields, 1)))
            .. integer-index = is-integer-kind(types.intrinsic-of(types.child-type(row.fields, 0)))
= false

────────────────────
_ do check-getter-annotations
    - syntax SyntaxId

` A getter stores nothing, so no property annotation applies to it.
do match? tree.nodes[syntax]
    | .node-function-syntax(row)
        if row.property-annotations.count != 0
            report-annotation(row.property-site, tree.atoms[row.property-annotations.start])

────────────────────
_ do check-return-mode
    - decl DeclId
    - returns SyntaxId

` A function that is not `do` is one expression, which the reference checks as it declares the
` function, whether or not anything calls it: its body returns nowhere explicitly, and outside
` a `do` block it declares nothing immediately, loops nowhere and yields nothing, apart from
` in the functions, tasks and deferred blocks written in it. One written to give `Void` gives
` nothing. Closures are checked where they are typed (`require-do`).
. described = describe(program, module, decl)
if !described || !checks-at-declaration(described)
    =
. body = described.body
. returned = first-unexpressed(body, false)
if returned != 0
    frame.diagnose(returned, .explicit-return-requires-do)
    =
. statement = first-unexpressed(body, true)
if statement != 0
    frame.diagnose(statement, .stated, program.store-atom(requires-do-text(statement)))
    =
. stated = first-stated(body)
if stated != 0
    frame.diagnose(stated, .stated, program.store-atom(requires-do-text(stated)))
    =
do match? tree.nodes[returns]
    | .node-type-identifier(row)
        if row.name.text == "Void"
            frame.diagnose(described.syntax, .non-void-return)

────────────────────
_ checks-at-declaration Bool
    - declaration CheckedDecl

` Whether how a function returns is checked as the module declares it (`check-return-mode`):
` a function, getter, setter or conversion written in the module as one expression.
declared-plain && declaration.body != 0 && (function-or-getter || declaration.kind == .setter-decl)

.. declared-plain = !declaration.is-generated && !declaration.is-imperative && !declaration.is-main
.. function-or-getter = declaration.kind == .function-decl || declaration.kind == .getter-decl

────────────────────
_ do first-unexpressed SyntaxId
    - body SyntaxId
    - statements Bool

` The first node of a body, in the order the reference visits them, that a function written as
` one expression may not hold: an explicit return or, with `statements`, an immediate
` declaration, a loop or a yield outside a `do` block. Neither is looked for in the functions,
` tasks and deferred blocks written in the body.
. found SyntaxId = 0
. floor = tree.subtree-start(body)
. node = body + 1
while node > floor
    node -= 1
    do match? tree.nodes[node]
        | .node-function-syntax
            node = tree.subtree-start(node)
        | .node-do-task-block
            node = tree.subtree-start(node)
        | .node-do-finally-block
            node = tree.subtree-start(node)
        | .node-do-block
            if statements
                node = tree.subtree-start(node)
        | .node-return
            if !statements
                found = node
        | .node-return-if-true
            if !statements
                found = node
        | .node-declare(row)
            if statements && !row.is-lazy
                found = node
        | .node-for-block
            if statements
                found = node
        | .node-while-block
            if statements
                found = node
        | .node-yield
            if statements
                found = node
= found

────────────────────
_ do check-closure-rows
    - body SyntaxId

=? if first-unexpressed(body, false) != 0 || first-unexpressed(body, true) != 0
. stated = first-stated(body)
if stated != 0
    frame.diagnose(stated, .stated, program.store-atom(requires-do-text(stated)))

────────────────────
_ requires-do-text String
    - statement SyntaxId

match tree.nodes[statement]
    | .node-declare(row)
        if row.is-lazy then "Lazy before the value requires do" else "Immediate declaration requires do"
    | .node-yield
        "Yield requires do"
    | .node-assign
        "Assignment requires do"
    | .node-if-block
        "If statement requires do"
    | .node-call-expression
        "Call before the value requires do"
    ??
        "Loop requires do"

────────────────────
_ first-stated SyntaxId
    - body SyntaxId

match tree.nodes[body]
    | .node-block(row)
        first-stated-row(row.body)
    ??
        0

────────────────────
_ do first-stated-row SyntaxId
    - rows RowRange'SyntaxId

. result Index = rows.count
for position in 0 .. < rows.count
    if !is-trailing-row(tree.children[rows.start + position])
        result = position
for position in 0 .. < rows.count
    . statement = tree.children[rows.start + position]
    do match? tree.nodes[statement]
        | .node-assign
            = statement
        | .node-if-block
            = statement
        | .node-call-expression
            =? statement if (position as Index) < result
        | .node-declare(row)
            =? statement if row.is-lazy && result < rows.count && comes-first
            .. comes-first = precedes(module, statement, module, tree.children[rows.start + result])
= 0

────────────────────
_ is-trailing-row Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-declare(row)
        row.is-lazy
    | .node-pipeline-expression(row)
        row.left == 0
    ??
        false

────────────────────
_ do check-keyed-name Bool
    - property PropertyDecl

. name = property.name
=? true if !name || name.text.find(".") == null
if property.owner != 0
    . mark = scratch.types.mark
    . owner = types.class-pattern-with-args(module, property.owner, mark)
    =? true if owner == invalid-type || types.intrinsic-of(owner) == .style
. message = "Only a Style may declare a keyed property such as \"${name.text}\""
frame.diagnose(property.syntax, .stated, program.store-atom(message))
= false

────────────────────
_ do check-annotations
    - property PropertyDecl

` `@hot` marks an eager stored field of a tuple-layout type that does not hold a delegate;
` no other annotation is known outside a style.
. annotations = RowRange'Atom()
do match? tree.nodes[property.syntax]
    | .node-property-syntax(row)
        annotations = row.annotations
if annotations.count == 0
    =
if property.owner == 0
    report-annotation(property.syntax, tree.atoms[annotations.start])
    =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, property.owner, mark)
if owner == invalid-type
    =
. kind = types.intrinsic-of(owner)
. tuple-layout = intrinsic-is-tuple-like(kind)
for offset in 0 .. < annotations.count
    . annotation = tree.atoms[annotations.start + offset]
    if annotation.text == "hot"
        . eager = !property.is-lazy && property.delegates.count == 0
        if !tuple-layout || !eager
            report-annotation(property.syntax, annotation)
            =
    else if kind != .style
        report-annotation(property.syntax, annotation)
        =

────────────────────
_ do report-annotation
    - syntax SyntaxId
    - annotation Atom

. label = annotation.text
. message = "Unknown property annotation \"@$label\"; only \"@hot\" is supported on eager "
message ++= "tuple fields"
if label == "hot"
    message = "Property annotation \"@hot\" requires an eager stored field on a tuple-layout type"
frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-argument-shapes
    - args RowRange'ArgumentShape

` The shape rules of a declaration's arguments: nothing follows a variadic argument, and once
` an argument has a default every later one needs one.
. defaulted = false
. variadic = false
for shape in program.modules[module].arg-pool[args]
    if variadic
        . message = "Variadic arguments must be the last one"
        frame.diagnose(shape.pattern, .stated, program.store-atom(message))
        =
    variadic = shape.is-variadic
    if shape.has-default
        defaulted = true
    else if defaulted
        frame.diagnose(shape.pattern, .stated, program.store-atom("Default value required"))
        =

────────────────────
_ do check-duplicate
    - decl DeclId
    - fn FunctionDecl

` A module or a type defines a function of one name and one signature once.
if fn.body == 0 || !fn.name
    =
. fn-name = fn.name
. target = program.modules[module]
. repeated = false
if fn.owner == 0
    for candidate in program.lookup(module, fn-name)
        if candidate.module == module && candidate.decl < decl
            repeated = repeated || same-definition(candidate.decl, fn)
else
    do match? target.decls[fn.owner]
        | .decl-class(class)
            . place = target.first-member(class.members, fn-name)
            while place != no-member
                . member = target.member-pool[place]
                place = target.member-links[place]
                if member < decl
                    repeated = repeated || same-definition(member, fn)
if repeated
    . message = "Duplicate definition of ${fn-name.text} with the same signature"
    frame.diagnose(fn.syntax, .stated, program.store-atom(message))

────────────────────
_ do same-definition Bool
    - other DeclId
    - fn FunctionDecl

. target = program.modules[module]
do match? target.decls[other]
    | .decl-function(row)
        if row.body == 0 || !row.name || row.name != fn.name! || row.kind != fn.kind
            = false
        if row.owner != fn.owner || row.is-static != fn.is-static
            = false
        if row.type-args.count != fn.type-args.count || row.args.count != fn.args.count
            = false
        if !same-syntax(row.return-type, fn.return-type)
            = false
        if !same-syntaxes(row.param-constraints, fn.param-constraints)
            = false
        for offset in 0 .. < fn.args.count
            . mine = target.arg-pool[fn.args.start + offset]
            . theirs = target.arg-pool[row.args.start + offset]
            if mine.is-variadic != theirs.is-variadic || !same-atom(mine.name, theirs.name)
                = false
            if !same-syntax(mine.type-syntax, theirs.type-syntax)
                = false
        = true
= false

────────────────────
_ same-atom Bool
    - left Atom?
    - right Atom?

|? left == null || right == null
    left == null && right == null
??
    left == right

────────────────────
_ do same-syntaxes Bool
    - left RowRange'SyntaxId
    - right RowRange'SyntaxId

if left.count != right.count
    = false
for offset in 0 .. < left.count
    if !same-syntax(tree.children[left.start + offset], tree.children[right.start + offset])
        = false
= true

────────────────────
_ do redeclares-class Bool
    - classes Map'ClassName'Bool
    - class ClassDecl

` Whether a class has the name and the number of type parameters of one its module declares
` before it, which `classes` holds, and holds from now on. The reference takes the later of
` the two wherever the name is written, which is not modeled.
. key = ClassName(class.name, class.type-args.count)
if classes[key] ?? false
    = true
classes[key] = true
= false

────────────────────
_ do check-style-rule
    - index DeclId
    - rule StyleRuleDecl

` A class's style rules are told apart by name and by the type of what each takes: `• This`,
` the defaults rule, takes nothing, and no rule repeats one the class wrote before it. A style
` sheet has no defaults rule.
do match? tree.nodes[rule.syntax]
    | .node-rule-syntax(row)
        if rule.name.text == "This" && row.args.count != 0
            frame.diagnose
                - rule.syntax
                - .stated
                - program.store-atom("Style rule \"This\" must be parameterless")
            =
        . decls = program.modules[module].decls
        for earlier in 0 .. < index
            do match? decls[earlier]
                | .decl-style-rule(other)
                    if other.outer == 0 && namesake && repeats-rule(other.syntax, row.args)
                        frame.diagnose
                            - rule.syntax
                            - .stated
                            - program.store-atom("Redefinition of style rule")
                        =
                    .. namesake = other.owner == rule.owner && other.name == rule.name
        if rule.name.text == "This" && rule.owner != 0 && is-sheet-decl(module, rule.owner)
            frame.diagnose
                - rule.syntax
                - .stated
                - program.store-atom("StyleSheets may not declare a \"This\" defaults rule")

────────────────────
_ do is-sheet-decl Bool
    - owner-module ModuleId
    - decl DeclId

` Whether a class a module declares is a style sheet, declared `• Name`, or the declaration is
` an extension of one, `• extend Name`, whose members the sheet has.
. owner = program.modules[owner-module]
do match? owner.decls[decl]
    | .decl-class(class)
        do match? owner.tree.nodes[class.syntax]
            | .node-class-block(row)
                = row.is-style-sheet
    | .decl-sheet-extension
        = true
= false

────────────────────
_ is-sheet-type Bool
    - type TypeId

|? type == no-type || type == invalid-type || types.intrinsic-of(type) != .style-sheet
    false
??
    is-sheet-decl(ref.module, ref.decl)

.. ref = class-ref(types, type)

────────────────────
_ do family-root TypeId
    - sheet TypeId

. root = sheet
while true
    types.complete(root)
    . base = types.base-of(root) ?? no-type
    if !is-sheet-type(base)
        = root
    root = base

────────────────────
_ do list-derived-sheets

=? if facts.derived-listed
facts.derived-listed = true
for position in 0 .. < program.declare-order.length
    . home = program.declare-order[position] as ModuleId
    . owner = program.modules[home]
    for index in 0 .. < owner.decls.length
        if owner.decls[index] is .decl-class && is-sheet-decl(home, index as DeclId)
            . mark = scratch.types.mark
            . sheet = types.intern-class(home, index as DeclId, mark)
            types.complete(sheet)
            if is-sheet-type(types.base-of(sheet) ?? no-type)
                facts.derived-sheets += sheet

────────────────────
_ do check-derived-sheet
    - index DeclId
    - class ClassDecl

. mark = scratch.types.mark
. sheet = types.intern-class(module, index, mark)
types.complete(sheet)
. base = types.base-of(sheet) ?? no-type
. tags = match tree.nodes[class.syntax]
    | .node-class-block(row)
        row.tags
    ??
        RowRange'Atom()
if !is-sheet-type(base)
    if base == invalid-type || base == no-type
        do match? tree.nodes[class.base]
            | .node-type-identifier(ident)
                frame.diagnose
                    - class.base
                    - .stated
                    - program.store-atom("StyleSheet base \"${ident.name.text}\" not found")
    else if base != types.type-row(.style-sheet)
        frame.diagnose
            - class.base
            - .stated
            - program.store-atom
                - "StyleSheet base \"${type-short-name(types, base)}\" is not a StyleSheet"
    else if tags.count != 0
        frame.diagnose(class.syntax, .stated, program.store-atom("StyleSheet \"${class.name.text}\" takes tags only where it derives from another StyleSheet"))
    =
for offset in 0 .. < tags.count
    . tag = tree.atoms[tags.start + offset]
    for earlier in 0 .. < offset
        if tree.atoms[tags.start + earlier] == tag
            frame.diagnose
                - class.syntax
                - .stated
                - program.store-atom("StyleSheet tag \"${tag.text}\" is repeated")
            =
. owner = program.modules[module]
for member in owner.member-pool[class.members]
    do match? owner.decls[member]
        | .decl-property(property)
            . named = property.name
            if named
                . found = types.property-named(base, named)
                if !found || !is-sheet-type(types.properties[found].owner)
                    frame.diagnose(property.syntax, .stated, program.store-atom("Derived StyleSheet \"${class.name.text}\" can only override slots of ${type-short-name(types, base)}, which has no slot \"${named.text}\""))

────────────────────
_ do sheet-parts [DeclRef]
    - ref DeclRef

` The declarations whose members a class has: those of a style sheet are the sheet's, then each
` extension of it the program declares (`• extend Name`), as the reference declares them into
` the sheet: in the order the modules are declared and, in one, in the order written.
. parts [DeclRef]
parts += ref
if !is-sheet-decl(ref.module, ref.decl)
    = parts
. key = ((ref.module as Size) /lshift/ 32) /or/ (ref.decl as Size)
. next = facts.sheet-extension-heads[key] ?? U32.max
while next != U32.max
    . held = facts.sheet-extensions[next]
    parts += DeclRef(held.module, held.decl)
    next = held.next
= parts

────────────────────
_ part-members RowRange'DeclId
    - ref DeclRef

` The members a class, or an extension of a style sheet, declares.
match program.modules[ref.module].decls[ref.decl]
    | .decl-class(row)
        row.members
    | .decl-sheet-extension(row)
        row.members
    ??
        RowRange'DeclId()

────────────────────
_ do list-sheet-extensions

` Lists, once, each extension of a style sheet the program declares, with the sheet it extends,
` in the order the modules are declared, each sheet's in a chain of their own. One whose target
` is no style sheet extends nothing.
=? if facts.extensions-listed
facts.extensions-listed = true
. tails = Map'Size'U32(facts.arena)
for position in 0 .. < program.declare-order.length
    . home = program.declare-order[position] as ModuleId
    . owner = program.modules[home]
    for index in 0 .. < owner.decls.length
        do match? owner.decls[index]
            | .decl-sheet-extension(row)
                types.clear-fault()
                . target = types.evaluate-type(home, owner.tree, row.receiver, types.env-frame())
                types.clear-fault()
                if typed && (types.intrinsic-of(target) == .class || style-sheet)
                    . sheet = class-ref(types, target)
                    if program.modules[sheet.module].decls[sheet.decl] is .decl-class && sheet-decl
                        . key = ((sheet.module as Size) /lshift/ 32) /or/ (sheet.decl as Size)
                        . place = facts.sheet-extensions.length as U32
                        facts.sheet-extensions += SheetExtension
                            - home
                            - index as DeclId
                            - sheet.module
                            - sheet.decl
                        . last = tails[key] ?? U32.max
                        if last == U32.max
                            facts.sheet-extension-heads[key] = place
                        else
                            facts.sheet-extensions[last].next = place
                        tails[key] = place
                    .. sheet-decl = is-sheet-decl(sheet.module, sheet.decl)
                .. typed = target != invalid-type && target != no-type
                .. style-sheet = types.intrinsic-of(target) == .style-sheet

────────────────────
_ do extended-sheet DeclRef?
    - ref DeclRef

` The style sheet an extension of one extends, or none for any other declaration.
if !(program.modules[ref.module].decls[ref.decl] is .decl-sheet-extension)
    = null
for held in facts.sheet-extensions
    if held.module == ref.module && held.decl == ref.decl
        = DeclRef(held.sheet-module, held.sheet)
= null

────────────────────
_ do holder-env TypeEnv
    - ref DeclRef

` The types the members of a class, or of an extension of a style sheet, are written under:
` those of the class, or of the sheet it extends.
. sheet = extended-sheet(ref)
if sheet
    = types.class-env(sheet.module, sheet.decl)
= types.class-env(ref.module, ref.decl)

────────────────────
_ do check-sheet-extension
    - index DeclId
    - extension SheetExtensionDecl

` An extension of a style sheet, `• extend Name`, as the reference's `ASTStyleSheetExtension`
` declares one: its target must be a style sheet, and each rule it adds may repeat none the
` sheet has (`repeats-part`); it holds usings and rules alone, a slot being an error. The first
` that is wrong is the reference's error. The usings and rules it adds are the sheet's
` (`sheet-parts`).
. id = extension.syntax
. row = match? tree.nodes[id]
    | .node-style-sheet-extension(written)
        written
if !row
    =
. name = match? tree.nodes[row.receiver]
    | .node-type-identifier(ident)
        ident.name
if !name
    =
types.clear-fault()
. target = types.evaluate-type(module, tree, row.receiver, frame.env)
types.clear-fault()
if target == invalid-type || target == no-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" not found")
    =
if types.intrinsic-of(target) != .class && types.intrinsic-of(target) != .style-sheet
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" is not a StyleSheet")
    =
. ref = class-ref(types, target)
if !is-sheet-decl(ref.module, ref.decl)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" is not a StyleSheet")
    =
for member in tree.children[row.body]
    do match? tree.nodes[member]
        | .node-property-syntax
            frame.diagnose
                - member
                - .stated
                - program.store-atom("StyleSheet extensions may not declare slots")
            =
        | .node-rule-syntax(rule)
            if rule.name.text == "This"
                frame.diagnose
                    - member
                    - .stated
                    - program.store-atom("StyleSheets may not declare a \"This\" defaults rule")
                =
            . (repeats, known) = repeats-part(ref, DeclRef(module, index), rule)
            if !known
                decline(member)
                =
            if repeats
                frame.diagnose(member, .stated, program.store-atom("Redefinition of style rule"))
                =
        | .node-using-declaration
            continue
        ??
            frame.diagnose
                - member
                - .stated
                - program.store-atom
                    - "StyleSheet extensions may only declare using declarations and style rules"
            =

────────────────────
_ do repeats-part (Bool, Bool)
    - sheet DeclRef
    - extension DeclRef
    - rule ASTRule

` Whether a style rule an extension of a style sheet adds repeats one the sheet has before it, its
` own or one an extension declared earlier adds (`sheet-parts`), as the reference finds a rule it
` declares into the sheet again: of the same name, taking what it takes (`same-signature`); and
` whether that is known.
for part in sheet-parts(sheet)
    if part.module == extension.module && part.decl == extension.decl
        = (false, true)
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-style-rule(other)
                if other.name == rule.name
                    do match? owner.tree.nodes[other.syntax]
                        | .node-rule-syntax(written)
                            . (same, known) = same-signature(owner.tree, written.args, tree, rule.args)
                            if !known || same
                                = (same, known)
= (false, true)

────────────────────
_ do repeats-rule Bool
    - earlier SyntaxId
    - args RowRange'SyntaxId

` Whether an earlier rule of the same name takes what `args` takes, as `same-signature` tells.
` One whose types are written in a way not named here is declined.
do match? tree.nodes[earlier]
    | .node-rule-syntax(row)
        . (same, known) = same-signature(tree, row.args, tree, args)
        if !known
            decline(earlier)
            = false
        = same
= false

────────────────────
_ do same-signature (Bool, Bool)
    - left-tree AST
    - left RowRange'SyntaxId
    - right-tree AST
    - right RowRange'SyntaxId

` Whether two style rules take the same values, as the reference's `hasSameSignature` tells rules
` of one name apart: as many, each of a type written with the same name (`written-type-name`),
` the first that differs telling them apart; and whether that is known, false where a type it
` reaches is written in a way not named here.
if left.count != right.count
    = (false, true)
for offset in 0 .. < left.count
    . mine = written-type-name
        - left-tree
        - rule-argument-type(left-tree, left-tree.children[left.start + offset])
    . theirs = written-type-name
        - right-tree
        - rule-argument-type(right-tree, right-tree.children[right.start + offset])
    if !mine || !theirs
        = (false, false)
    if mine != theirs
        = (false, true)
= (true, true)

────────────────────
_ do written-type-name String?
    - written AST
    - id SyntaxId

` A type as the reference names it to tell style rules apart (`getTypeName`): an identifier by its
` name, followed by the names of the type arguments written after it; a tuple, a struct and a
` list by those of what they hold; nothing written as nothing. None for another way of writing
` one.
if id == 0
    = ""
do match? written.nodes[id]
    | .node-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        . base = written-type-name(written, row.base)
        if !base
            = null
        . text = base
        for arg in written.children[row.args]
            . held = written-type-name(written, arg)
            if !held
                = null
            text += "'${held}"
        = text
    | .node-type-tuple(row)
        . names = written-type-names(written, row.field-types)
        if !names
            = null
        = if row.is-struct then "struct(${names})" else "tuple(${names})"
    | .node-type-list(row)
        . names = written-type-names(written, row.patterns)
        if !names
            = null
        = "list(${names})"
    | .node-type-capture(row)
        = written-type-name(written, row.type)
= null

────────────────────
_ do written-type-names String?
    - written AST
    - ids RowRange'SyntaxId

` The names of types written in a row, as `written-type-name` names each, joined by commas.
. text = ""
for offset in 0 .. < ids.count
    . held = written-type-name(written, written.children[ids.start + offset])
    if !held
        = null
    if offset != 0
        text += ","
    text += held
= text

────────────────────
_ do rule-argument-type SyntaxId
    - written AST
    - argument SyntaxId

` The type written for a value a style rule takes, or the pattern that takes it where it is
` written with none.
. pattern = argument
do match? written.nodes[argument]
    | .node-argument-decl(row)
        pattern = row.pattern
do match? written.nodes[pattern]
    | .node-type-capture(capture)
        = capture.type
= pattern

────────────────────
_ do same-syntax Bool
    - left SyntaxId
    - right SyntaxId

` Whether two types are written the same way. A way of writing a type this does not know is
` never the same as another.
if left == 0 || right == 0
    = left == right
do match? tree.nodes[left]
    | .node-type-identifier(mine)
        do match? tree.nodes[right]
            | .node-type-identifier(theirs)
                = mine.name == theirs.name && mine.is-declare == theirs.is-declare
    | .node-type-arguments(mine)
        do match? tree.nodes[right]
            | .node-type-arguments(theirs)
                = same-syntax(mine.base, theirs.base) && same-syntaxes(mine.args, theirs.args)
    | .node-type-optional(mine)
        do match? tree.nodes[right]
            | .node-type-optional(theirs)
                = same-syntaxes(mine.field-types, theirs.field-types)
    | .node-type-tuple(mine)
        do match? tree.nodes[right]
            | .node-type-tuple(theirs)
                = same-syntaxes(mine.field-types, theirs.field-types)
    | .node-type-capture(mine)
        do match? tree.nodes[right]
            | .node-type-capture(theirs)
                = same-syntax(mine.id, theirs.id) && same-syntax(mine.type, theirs.type)
    | .node-identifier(mine)
        do match? tree.nodes[right]
            | .node-identifier(theirs)
                = mine.name == theirs.name
    | .node-param-constraint(mine)
        do match? tree.nodes[right]
            | .node-param-constraint(theirs)
                = same-syntax(mine.left, theirs.left) && same-syntax(mine.right, theirs.right)
= false

────────────────────
_ do check-type-params
    - fn FunctionDecl

` A type parameter an argument declares in passing cannot repeat one the function names.
. names [Atom]
for param in tree.children[fn.type-args]
    . named = types.type-syntax-name(tree, param)
    if named
        names += named
for shape in program.modules[module].arg-pool[fn.args]
    if shape.pattern != 0 && repeats-param(shape.pattern, names)
        =

────────────────────
_ do repeats-param Bool
    - id SyntaxId
    - names [Atom]

do match? tree.nodes[id]
    | .node-type-identifier(row)
        if row.is-declare
            if names.find(row.name) != null
                frame.diagnose(id, .stated, program.store-atom("Duplicate type parameter"))
                = true
            names += row.name
for child in tree.children-of(id)
    if repeats-param(child, names)
        = true
= false

────────────────────
_ do declaring-type-names [SyntaxId]

. found [SyntaxId]
for id in 1u32 .. < tree.nodes.length
    do match? tree.nodes[id]
        | .node-type-identifier(row)
            if row.is-declare
                found += id as SyntaxId
= found

────────────────────
_ do declares-within Bool
    - declaring [SyntaxId]
    - range SyntaxRange

. low = 0
. high = declaring.length
while low < high
    . middle = (low + high) / 2
    if declaring[middle] < range.start
        low = middle + 1
    else
        high = middle
= low < declaring.length && declaring[low] < range.start + range.count

────────────────────
_ do check-module-property
    - property DeclId
    - initializer SyntaxId
    - annotation SyntaxId

. value = infer(initializer)
if annotation == 0 || value == invalid-type || value == no-type
    =
. declared = types.evaluate-type(module, tree, annotation, frame.env)
note-declared-value(0, property, initializer, annotation, declared, value)
if declared != invalid-type && declared != value
    conversions.convert(initializer, initializer, value, declared, .reason-declaration)

────────────────────
_ do is-object-construction Bool
    - initializer SyntaxId

do match? tree.nodes[initializer]
    | .node-call-expression(call)
        . resolution = bindings.resolution-of(frame.binding, call.callable)
        if resolution.kind == .resolve-type
            = is-object-class(resolution.module, resolution.decl)
= false

────────────────────
_ do is-object-class Bool
    - class-module ModuleId
    - class-decl DeclId

do match? program.modules[class-module].decls[class-decl]
    | .decl-class(row)
        if row.type-args.count != 0
            . env = types.class-env(class-module, class-decl)
            . pattern = env.this-type
            types.env-release(env)
            = types.intrinsic-of(pattern) == .class
        . type = types.class-with-args(class-module, class-decl, scratch.types.mark)
        types.complete(type)
        = types.intrinsic-of(type) == .class
= false

────────────────────
_ is-enum-owner Bool
    - owner DeclId

match program.modules[module].decls[owner]
    | .decl-class(row)
        row.base != 0
    ??
        false

────────────────────
_ do check-statement TypeId
    - id SyntaxId
    - want Want = Want()

if id == 0
    = no-type
. stated = want.adding(.want-statement)
if is-leaving(id)
    facts.mark-leaving(instance, id)

do match tree.nodes[id]
    | .node-block(row)
        = check-block(id, row.body, id == quasi-free-block, want.asks(.want-match-statement))
    | .node-declare(row)
        if !row.is-lazy
            require-do(id, "Immediate declaration requires do")
        if declares-getter(row.left)
            = no-type
        if !row.is-lazy || !waits-for-read(row.left)
            check-declare(row.left, machine-or-value(row.left, row.right), row.is-lazy)
        if row.is-lazy || (!is-plain-name(row.left) && !is-typed-name(row.left))
            frame.doubt-members()
        = no-type
    | .node-return(row)
        note-explicit-return(id, row.expr)
        check-return(id, row.expr, false)
        = no-type
    | .node-return-if-true(row)
        note-explicit-return(id, row.expr)
        note-truthiness(row.condition, row.condition, infer-tested(row.condition))
        . mark = scratch.narrowings.mark
        narrowing.narrow-condition(row.condition, true)
        . known = frame.save-members()
        check-return(id, row.expr, true)
        frame.restore-members(known)
        pop-conditional(mark)
        narrowing.narrow-condition(row.condition, false)
        = no-type
    | .node-if-block(row)
        if is-region(id)
            decline(id)
            = no-type
        check-if(id, row.condition, row.body, row.next)
        = no-type
    | .node-while-block(row)
        require-do(id, "Loop requires do")
        check-while(id, row.condition, row.body)
        = no-type
    | .node-assertion-syntax(row)
        check-assertion(id, row.exception, row.condition)
        if row.condition != 0
            narrowing.narrow-condition(row.condition, false)
        = no-type
    | .node-yield(row)
        require-do(id, "Yield requires do")
        check-suspends(id)
        note-yield(yielded-value(id, row.expr), id, false, written-literal(row.expr))
        note-escape(row.expr)
        if cleans-up || loop-depth != 0
            frame.doubt-members()
        = no-type
    | .node-do-block(row)
        if nested-decl-of(id) != 0
            check-region(id, row.body)
            = no-type
        . saved = frame.surround
        frame.surround = frame.surround.effects = dispatch-effects(saved.effects /or/ row.compilation-effects)
        if (saved.effects /and/ CompilationEffect.gc-free) == 0 && enters-gc-free
            frame.surround = frame.surround.zone-site = id
        .. enters-gc-free = (row.compilation-effects /and/ CompilationEffect.gc-free) != 0
        do-depth += 1
        check-statement(row.body, if is-match-syntax(row.body) then Want().adding(.want-match-statement) else Want())
        do-depth -= 1
        frame.surround = saved
        = no-type
    | .node-noop
        = no-type
    | .node-probe-statement(row)
        if compiles-probe(id)
            check-statement(row.body)
        = no-type
    | .node-probe-scope(row)
        if compiles-probe(id)
            for statement in tree.children[row.body]
                check-statement(statement)
        = no-type
    | .node-probe(row)
        if compiles-probe(id)
            check-probe(id, row)
        = no-type
    | .node-probe-counter(row)
        if compiles-probe(id)
            check-probe-counter(id, row)
        = no-type
    | .node-probe-group(row)
        if compiles-probe(id)
            check-probe-group(id, row)
        = no-type
    | .node-probe-assign(row)
        if compiles-probe(id)
            check-probe-assign(id, row)
        = no-type
    | .node-probe-snapshot
        = no-type
    | .node-probe-preview
        = no-type
    | .node-break
        if leaves-cleanup()
            report-cleanup-leave(id, "break")
        else if loop-marks.length == 0 && is-subscriber-body()
            demand-unsubscribe(id)
        else if loop-marks.length == 0
            frame.diagnose(id, .stated, program.store-atom("`break` outside a loop"))
        = no-type
    | .node-continue
        if leaves-cleanup()
            report-cleanup-leave(id, "continue")
        else if loop-marks.length == 0 && !is-subscriber-body()
            frame.diagnose(id, .stated, program.store-atom("`continue` outside a loop"))
        = no-type
    | .node-for-block(row)
        require-do(id, "Loop requires do")
        check-for(id, row.loop, row.body, row.next)
        frame.forget-members()
        = no-type
    | .node-do-finally-block(row)
        cleans-up = true
        do-depth += 1
        frame.doubt-members()
        . finished = check-statement(row.body)
        frame.doubt-members()
        do-depth -= 1
        = finished
    | .node-use-block(row)
        check-use(id, row.subject)
        frame.doubt-members()
        discarding-block = row.body
        check-statement(row.body)
        frame.doubt-members()
        = no-type
    | .node-do-task-block(row)
        if row.worker != 0 && row.is-parallel
            frame.diagnose(id, .stated, program.store-atom(both-targets-text()))
        else if row.worker != 0
            check-worker(id, row.worker)
        frame.doubt-members()
        check-task(id)
        = no-type
    | .node-stack-local-binding-block(row)
        cleans-up = true
        frame.doubt-members()
        check-stack-binding(id, row.value, row.body)
        frame.doubt-members()
        = no-type
    | .node-iterator-expression(row)
        if frame.declaration.syntax == id && is-subscriber-body()
            check-broadcast(id, row.loop, row.body)
            = no-type
        if frame.declaration.syntax == id
            check-comprehension(row.loop, row.body)
            = no-type
        = infer(id, stated)
    | .node-pipeline-expression(row)
        if frame.declaration.syntax == id && row.op == .stream-pattern-pipe-op
            check-pattern-pipe(id, row.right)
            = no-type
        = infer(id, stated)
    | .node-binary-expression(row)
        if frame.declaration.syntax == id && row.op == .stream-pattern-pipe-op
            check-pattern-pipe(id, row.rhs)
            = no-type
        = infer(id, stated)
    | .node-bullet-expression
        if frame.declaration.syntax == id
            check-bullets(id)
            = no-type
        = infer(id, stated)
    | .node-state-machine
        do check-machine-site(id)
        = no-type
    ??
        = infer(id, stated)

────────────────────
_ do check-stack-binding
    - id SyntaxId
    - value-syntax SyntaxId
    - body SyntaxId

. resolution = bindings.resolution-of(frame.binding, id)
. declared = no-type
if resolution.kind == .resolve-global
    declared = demand-global(id, resolution.module, resolution.decl)
. value = infer(value-syntax)
if resolution.kind == .resolve-global && value != invalid-type
    conversions.convert(id, value-syntax, value, declared, .reason-assignment)
if resolution.kind == .resolve-global
    . first = tree.subtree-start(body)
    facts.stack-scopes.append(StackScope(instance, first, body, resolution.module, resolution.decl))
discarding-block = body
check-statement(body)

────────────────────
_ do redeclares-in Bool
    - block SyntaxId

` Whether a block declares a local again that it declared in an earlier statement, which the
` binder leaves to the type pass to settle.
if frame.binding == no-binding
    = false
. range = bindings.bindings[frame.binding].diagnostics
. start = tree.subtree-start(block)
for diagnostic in bindings.diagnostics[range.start .. < range.end]
    if diagnostic.kind == .redeclared && diagnostic.syntax >= start && diagnostic.syntax <= block
        = true
= false

────────────────────
_ do projects Bool

` Whether the reference opens a scope before a statement here (`pushFlowProjectionScope`). It
` does where a local that holds an optional, and that nothing assigns, is known by a test to hold
` a value, and makes a local of the value in that scope, which the blocks inside see as well
` (`materialized`): it opens none for that local again there. An optional of a tuple keeps its
` place.
. opens = false
for slot in frame.tested-locals()
    . known = slot-known(slot)
    if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 || !types.is-optional(known)
        continue
    . inner = types.optional-inner(known)
    if types.intrinsic-of(inner) == .tuple || frame.slot-type(slot) != inner || projected
        continue
    .. projected = materialized.find(slot) != null
    materialized += slot
    opens = true
= opens

────────────────────
_ do settle-redeclared
    - statement SyntaxId
    - projected SyntaxId

` A local a statement declares again, where an earlier statement of its block declared it, is
` a new one past a scope the reference opened after that statement (`projects`), as the
` reference declares it there. With no such scope it is declared twice in one scope.
. range = bindings.bindings[frame.binding].diagnostics
. start = tree.subtree-start(statement)
for diagnostic in bindings.diagnostics[range.start .. < range.end]
    if diagnostic.kind != .redeclared || diagnostic.syntax < start || diagnostic.syntax > statement
        continue
    if diagnostic.earlier >= start
        continue
    if projected == 0 || tree.subtree-start(projected) <= diagnostic.earlier
        frame.diagnose
            - diagnostic.syntax
            - .stated
            - program.store-atom("Redefining variable in same scope")

────────────────────
_ do check-block TypeId
    - block SyntaxId
    - body RowRange'SyntaxId
    - skips-quasi Bool
    - matched Bool = false

` The value of a block is that of its one statement that gives one. A block whose last
` statement leaves, by a raise under no condition, a return, `continue` or `break`, never
` ends, and gives none; the block and that statement are noted as leaving. The statements
` after one that leaves are not checked, but for lazy locals, as the reference compiles none of
` them; in markup content a statement that leaves is an error instead. A statement that
` names what it does not call is checked (`check-called`) unless it gives the block its value:
` the last of a block the reference keeps the value of, which a `discarding-block` is not. The
` arms of a block a match written as a statement runs (`matched`) are that match's.
. mark = scratch.narrowings.mark
. discards = block == discarding-block
. last = if body.count != 0 then tree.children[body.start + body.count - 1] else 0
. kept = kept-row(body)
. value = no-type
. values = 0
. leaves = false
. final-leave SyntaxId = 0
. finals [SyntaxId]
. limits [SyntaxId]
. open = 0
. parent = content-parent(block)
. attributes = parent != no-type && element-bodies.find(block) != null
. awaiting = if parent == no-type then await-elements(body) else unbuilt.length
if parent != no-type && names-elements(block)
    raise-elements(block, body)
. redeclares = redeclares-in(block)
. materialized-mark = materialized.length
. projected SyntaxId = 0
. dead = false
for statement in tree.children[body]
    if dead && !is-lazy-declare(statement)
        continue
    if redeclares
        if projects()
            projected = statement
        settle-redeclared(statement, projected)
    if block == rule-lines && tree.rule-part(statement)
        continue
    if is-finally(statement)
        finals += statement
        limits += 0
        continue
    if attributes && (tree.nodes[statement] is .node-assign || binds-slot(statement))
        facts.note-content-link(ContentLink(instance, statement, parent, no-type, no-fact))
        continue
    . hosted = content-blocks.length
    . reported = facts.diagnostics.length
    if parent != no-type
        host-content(statement, parent)
    else
        raise-statement(statement)
    . calls-before U32 = facts.calls.length as U32
    . declared = declared-return
    if skips-quasi && arms-line && declared != no-type && declared != types.void-type
        note-returned-match(statement, declared)
        arms-expected = declared
    .. arms-line = is-arms-syntax(statement)
    . named = skips-quasi && declared != no-type && symbolic
        .. symbolic = calls-symbol(statement) || symbol-of(statement) != null
    . watches = open < finals.length
    if watches
        watching-leaves += 1
    . want = Want()
    if parent != no-type
        want = want.adding(.want-content-line)
    if matched && is-arms-syntax(statement)
        want = want.adding(.want-match-statement)
    if skips-quasi
        want = want.adding(.want-quasi)
    if skips-quasi && choice-statement && declared != no-type && declared != types.void-type
        want = want.asking(.want-choice, declared)
    .. choice-statement = is-choice-syntax(statement)
    if discards || statement != last
        want = want.adding(.want-unused)
    . produced = if named then infer-with-expected(statement, declared, want) else check-line(statement, parent, want)
    if watches
        watching-leaves -= 1
    if parent != no-type
        while content-blocks.length != hosted
            content-blocks.pop()
            content-parents.pop()
            content-names.pop()
        if !leaves-line(statement)
            link-content(statement, produced, parent)
            . settles = if element-line then attributes else tree.content-line(statement)
                .. element-line = tree.content-element(statement) != 0
            if settles && is-live-statement(statement)
                settle-content(statement, parent, produced)
        else if facts.diagnostics.length == reported
            frame.diagnose(statement, .stated, program.store-atom("Illegal return"))
    else
        . named = named-element(statement)
        if named && produced != invalid-type && produced != no-type
            note-named(statement, frame.slot-type(named))
        if discards || statement != last
            check-called(statement, produced, is-step-position(statement, kept, discards), body)
    if watches && may-leave(calls-before)
        for position in open .. < finals.length
            limits[position] = statement
        open = finals.length
    . quasi = skips-quasi && is-quasi-syntax(statement)
    if produced != no-type && produced != types.void-type && !quasi
        value = produced
        value-syntax = statement
        values += 1
    else if produced == types.void-type && !quasi && (declared == no-type || declared == produced)
        values += 1
    if !is-lazy-declare(statement)
        . valued = produced != no-type && produced != types.void-type
        final-statement = if valued && !is-quasi-syntax(statement) then statement else 0
        leaves = is-leaving(statement)
        final-leave = statement
        dead = leaves && parent == no-type
for position in 0 .. < finals.length
    check-finally(finals[position], limits[position])
settle-elements(awaiting)
if leaves
    facts.mark-leaving(instance, block)
    facts.mark-leaving(instance, final-leave)
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
frame.keep-assigned(settled)
if materialized.length != materialized-mark
    -= materialized[materialized-mark .. < materialized.length]
= if values == 1 && !leaves then value else no-type

────────────────────
_ do check-called
    - statement SyntaxId
    - produced TypeId
    - is-step Bool = false
    - body RowRange'SyntaxId = RowRange'SyntaxId()

` A statement that only names a function, a closure or a method does nothing with it, and is
` the reference's error where nothing takes its value.
=? if produced == invalid-type
. named = tree.nodes[statement] is .node-identifier || tree.nodes[statement] is .node-get-expression
if named && produced != no-type
    . kind = types.intrinsic-of(produced)
    if kind == .function || kind == .closure || kind == .binding
        . written = description-of(tree, statement)
        frame.diagnose
            - statement
            - .stated
            - program.store-atom("$written is never called; write $written() to call it")
        =
if is-step && is-bare-value(statement) && !is-piped-row(body, statement)
    frame.diagnose(statement, .stated, program.store-atom(bare-value-text()))

────────────────────
_ is-step-position Bool
    - statement SyntaxId
    - kept SyntaxId
    - discards Bool

|? discards && is-constructor-kind(frame.declaration.kind)
    false
|? statement != kept
    true
|? !discards || frame.declaration.is-main
    false
??
    !(builds || frame.declaration.kind == .function-decl || frame.declaration.kind == .getter-decl)

.. builds = giving.yields || is-constructor-kind(frame.declaration.kind)

────────────────────
_ do kept-row SyntaxId
    - body RowRange'SyntaxId

. position = body.count
while position > 0
    position -= 1
    . row = tree.children[body.start + position]
    =? row if !is-lazy-declare(row)
= 0

────────────────────
_ do final-print SyntaxId
    - body SyntaxId

do match? tree.nodes[body]
    | .node-block(row)
        . kept = kept-row(row.body)
        = if kept != 0 && tree.nodes[kept] is .node-print then kept else 0
= if tree.nodes[body] is .node-print then body else 0

────────────────────
_ print-block-text String

"A print is a step and gives no value; end the block with its value"

────────────────────
_ do is-piped-row Bool
    - body RowRange'SyntaxId
    - statement SyntaxId

for position in 0 .. < body.count - 1
    if tree.children[body.start + position] == statement
        do match? tree.nodes[tree.children[body.start + position + 1]]
            | .node-pipeline-expression(row)
                = row.left == 0
        = false
= false

────────────────────
_ is-bare-value Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-identifier
        true
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-string-syntax
        true
    | .node-get-expression
        true
    | .node-index-expression
        true
    | .node-list-syntax
        true
    | .node-tuple-syntax
        true
    | .node-range-expression
        true
    | .node-cast-expression
        true
    | .node-binary-expression(row)
        is-arithmetic(row.op) || is-comparison(row.op) || valued-ops has row.op
    | .node-unary-expression(row)
        row.op == .not-op || row.op == .negative-op || row.op == .bitwise-not-op
    ??
        false

.. valued-ops = [Operator.concat-op, Operator.concat-string-op, Operator.and-op, Operator.or-op, Operator.is-op, Operator.is-not-op, Operator.is-exactly-op, Operator.is-not-exactly-op, Operator.is-similar-op, Operator.is-not-similar-op, Operator.is-in-op, Operator.not-in-op, Operator.has-op, Operator.has-not-op]

────────────────────
_ is-leaving Bool
    - statement SyntaxId

` Whether a statement leaves its block. `=? value` of an optional leaves only where the
` optional holds a value, so it does not.
match tree.nodes[statement]
    | .node-assertion-syntax(row)
        row.condition == 0
    | .node-return(row)
        !returns-present(row.expr)
    | .node-continue
        true
    | .node-break
        true
    ??
        false

────────────────────
_ do returns-present Bool
    - expr SyntaxId

` Whether a return gives `=? value` of an optional, which leaves only where it holds a value,
` as the reference returns what it holds and goes on where it holds none. Before the value is
` typed, any `=? value` may be one.
if expr == 0
    = false
do match? tree.nodes[expr]
    | .node-optional-chain
        . value = facts.node-type(instance, expr)
        = value == no-type || (value != invalid-type && types.is-optional(value))
= false

────────────────────
_ do may-leave Bool
    - calls-before U32

` Whether a statement just checked called something known to panic. A finally block runs
` wherever control leaves its block after it, so it sees only the locals declared before the
` first statement after it that may leave. A callee is
` known to panic once its body is typed, so a statement watched for this types the bodies of
` what it calls.
. position = facts.latest-call-of(instance)
while position != no-fact && position >= calls-before
    . callee = facts.calls[position].callee
    if callee != no-instance && instances.rows[callee].may-panic
        = true
    position = facts.prior-call(position)
= false

────────────────────
_ leaves-cleanup Bool

` Whether a `break` or `continue` here would leave a cleanup for a loop open around it.
finally.cleaning-up && loop-marks.length != 0 && loop-marks.length == finally.loops

────────────────────
_ do report-cleanup-leave
    - id SyntaxId
    - word String

` Reports a `break` or `continue` that would leave a cleanup, which runs however its block is
` left, for the loop around it.
. text = "A cleanup cannot \"$word\" the loop around it, as it runs however its block is left; write \"$word\" in the loop's body"
frame.diagnose(id, .stated, program.store-atom(text))

────────────────────
_ do check-finally
    - statement SyntaxId
    - limit SyntaxId

. saved = finally
finally = finally.limit = limit
finally = finally.loops = loop-marks.length
if saved.cleaning-up
    frame.diagnose(statement, .stated, program.store-atom("Illegal deferred statement"))
finally = finally.cleaning-up = true
check-statement(statement)
finally = saved

────────────────────
_ is-finally Bool
    - statement SyntaxId

` A finally block runs as its enclosing block ends, after every other statement of it.
match tree.nodes[statement]
    | .node-do-finally-block
        true
    ??
        false

────────────────────
_ is-lazy-declare Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-declare(row)
        row.is-lazy
    ??
        false

────────────────────
_ waits-for-read Bool
    - left SyntaxId

` A lazy local takes its value where it is first read, under what is known there, and one
` nothing reads is never computed. One that gives a property its value is computed with the
` object.
slot != null && bindings.slots[slot].property == 0

.. slot = declaring-slot(first-named(left))

────────────────────
_ declares-getter Bool
    - left SyntaxId

` Whether a declaration declares a local of a row of a markup loop region that the reference
` reads as a getter: its value is typed where it is read, and not where it is written.
slot != null && bindings.slots[slot].getter != 0

.. slot = declaring-slot(left)

────────────────────
_ do check-declare
    - left SyntaxId
    - right SyntaxId
    - is-lazy Bool

if is-lazy && lazy-known(left)
    =
. value = no-type
if right != 0
    . slot = declaring-slot(left) if is-lazy
    if slot
        frame.assign(slot, invalid-type)
        lazy-slots += slot
    own-anonymous-cases(left, right)
    . saved-eager = reading
    if slot && bindings.slots[slot].property != 0
        reading = reading.eager = true
    value = infer-declared(left, right)
    reading = saved-eager
    if slot
        lazy-slots.pop()
    if !is-lazy
        note-escape(right)
    if !is-lazy && !writes-type(left)
        note-loose(right)
else
    construct-declared(left)
declare(left, value, right)

────────────────────
_ writes-type Bool
    - pattern SyntaxId

` Whether a declaration's pattern writes the type of what it declares.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type != 0
    ??
        false

────────────────────
_ do own-anonymous-cases
    - pattern SyntaxId
    - root SyntaxId

` Gives the anonymous cases a declaration owns their union: every `..name` under its value
` that names this owner, payloads unified by case name, in source order. Payloads written as
` numbers with no suffix join others place by place, so `..value(1)` beside `..value(1.5)` holds
` a float.
. owner = identifier-name(tree, pattern-identifier(pattern))
if !owner || anonymous-union(owner) != no-type
    =
. sites [SyntaxId]
. held [TypeId]
hold-payloads(root, owner, owner, sites, held)
. names [Atom]
. payloads [TypeId]
. counts [U32]
. written [Bool]
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            . payload = held[position]
            . literal = written-payload(row.args)
            . known = names.find(row.name)
            if known != null && counts[known] != row.args.count
                report-arity(sites[position], row.name)
            else if known != null && payload != invalid-type
                . joined = relations.unify(payloads[known], payload, module)
                if relation-legal(joined)
                    payloads[known] = joined.unified
                else
                    . places = relations.joined-places(payloads[known], payload)
                    if places != no-type && kept-written && (literal || places == payload)
                        payloads[known] = places
                    .. kept-written = written[known] || places == payloads[known]
                written[known] = written[known] && literal
            else if known == null && payload != invalid-type
                names += row.name
                payloads += payload
                counts += row.args.count
                written += literal
if names.length == 0
    =
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < names.length
    scratch.names.push(names[position])
    scratch.types.push(payloads[position])
owner-names += owner
owner-unions += types.intern-named-union(owner, mark, names-mark)
owner-declared += true

────────────────────
_ do hold-payloads
    - root SyntaxId
    - owner Atom?
    - named Atom
    - sites [SyntaxId]
    - held [TypeId]

. declared = owner != null
. waits = false
for id in tree.subtree-start(root) .. root
    do match? tree.nodes[id]
        | .node-anonymous-case(row)
            if owns-case(owner, row.owner)
                . waiting = row.args.count != 0 && (!declared || reads-untyped(row.args))
                . reported = facts.diagnostics.length
                . payload = if waiting then no-type else anonymous-payload(row.args)
                if payload == invalid-type && facts.diagnostics.length == reported
                    report-unheld(id, row.name)
                sites += id
                held += payload
                waits = waits || waiting
if !waits
    =
foresee-payloads(root, named, declared, sites, held)
for position in 0 .. < sites.length
    if held[position] == invalid-type && unheld-cases.find(sites[position]) == null
        unheld-cases += sites[position]

────────────────────
_ do report-unheld
    - id SyntaxId
    - name Atom

. message = "Unable to infer payload type for anonymous case '..${name.text}'"
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do owns-case Bool
    - owner Atom?
    - written Atom?

if owner && written
    = owner == written
= !owner && !written

────────────────────
_ do reads-untyped Bool
    - args RowRange'SyntaxId

. followed [SlotId]
for arg in tree.children[args]
    if value-reads-untyped(arg, followed)
        = true
= false

────────────────────
_ do value-reads-untyped Bool
    - value SyntaxId
    - followed [SlotId]

for id in tree.subtree-start(value) .. value
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, id)
            if resolution.kind == .resolve-slot && awaits-flow(resolution.slot)
                = true
            if resolution.kind == .resolve-slot && lazy-reads-untyped(resolution.slot, followed)
                = true
= false

────────────────────
_ do lazy-reads-untyped Bool
    - slot SlotId
    - followed [SlotId]

. row = bindings.slots[slot]
. unread = row.kind == .slot-lazy && !frame.is-captured(slot) && frame.known(slot) == no-type
if !unread || row.group == 0 || followed.find(slot) != null
    = false
followed += slot
do match? tree.nodes[row.group]
    | .node-declare(declaration)
        = value-reads-untyped(declaration.right, followed)
= false

────────────────────
_ do awaits-flow Bool
    - slot SlotId

if frame.is-captured(slot) || frame.known(slot) != no-type
    = false
if bindings.slots[slot].getter != 0 || is-placed(slot)
    = false
. kind = bindings.slots[slot].kind
. named = kind == .slot-local || kind == .slot-pattern || kind == .slot-loop-item
= named || kind == .slot-it || kind == .slot-each

────────────────────
_ do foresee-payloads
    - root SyntaxId
    - named Atom
    - declared Bool
    - sites [SyntaxId]
    - held [TypeId]

. listed [Atom]
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            if listed.find(row.name) == null
                listed += row.name
                scratch.names.push(row.name)
                scratch.types.push(first-held(row.name, sites, held))
. provisional = types.intern-named-union(named, mark, names-mark)
. checker = trial-checker(root)
for position in 0 .. < owner-names.length
    checker.owner-names += owner-names[position]
    checker.owner-unions += owner-unions[position]
    checker.owner-declared += owner-declared[position]
checker.owner-names += named
checker.owner-unions += provisional
checker.owner-declared += declared
checker.foreseen-union = provisional
if root == frame.declaration.body
    checker.value-syntax = root
    checker.quasi-free-block = if frame.declaration.is-imperative then 0 else root
    checker.discarding-block = if imperative-body then root else 0
        .. imperative-body = frame.declaration.is-imperative || builds
        .. builds = frame.declaration.kind == .constructor-decl
. reported = facts.diagnostics.length
scratch.runners += checker
scratch.running += checker.instance
checker.check-statement(root)
scratch.runners.pop()
scratch.running.pop()
facts.drop-trial-diagnostics(reported, checker.instance)
for position in 0 .. < sites.length
    if held[position] == no-type
        held[position] = checker.foreseen-payload(sites[position])
checker.close()
checker.retire()

────────────────────
_ do foreseen-payload TypeId
    - site SyntaxId

. payload = invalid-type
for position in 0 .. < foreseen-sites.length
    if foreseen-sites[position] == site && foreseen-payloads[position] != invalid-type
        payload = foreseen-payloads[position]
= payload

────────────────────
_ do foreseer-of Checker?
    - union TypeId

if foreseen-union == union
    = this
if outer
    = outer.foreseer-of(union)
= null

────────────────────
_ do first-held TypeId
    - name Atom
    - sites [SyntaxId]
    - held [TypeId]

for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            if row.name == name && held[position] != no-type && held[position] != invalid-type
                = held[position]
= types.void-type

────────────────────
_ do written-payload Bool
    - args RowRange'SyntaxId

` Whether each value an anonymous case is given is written as a number with no suffix.
=? false if args.count == 0
= all(tree.children[args]) • where conversions.literal-of(each) != 0

────────────────────
_ do report-arity
    - id SyntaxId
    - name Atom

` One anonymous case holds the same number of values wherever its owner names it.
. message = "Anonymous case '..${name.text}' has conflicting arity"
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do anonymous-payload TypeId
    - args RowRange'SyntaxId

if args.count == 0
    = types.void-type
. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0u32
for arg in tree.children[args]
    . type = infer(arg)
    if type == invalid-type
        scratch.types.rewind(mark)
        scratch.names.rewind(names-mark)
        = invalid-type
    scratch.names.push(types.index-atom(position))
    scratch.types.push(type)
    position += 1
if position == 1
    . single = scratch.types[mark]
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = single
= types.intern-tuple(mark, names-mark)

────────────────────
_ do anonymous-union TypeId
    - owner Atom

for position in 0 .. < owner-names.length
    if owner-names[position] == owner
        = owner-unions[position]
if outer
    = outer.anonymous-union(owner)
= no-type

────────────────────
_ do symbol-unions
    - name Atom
    - found [TypeId]
    - owners [Atom]

` The unions of anonymous cases that have a case of a name, among those a declaration typed
` so far owns: those of the enclosing functions first, then this one's in the order typed.
if outer
    outer.symbol-unions(name, found, owners)
for position in 0 .. < owner-names.length
    if !owner-declared[position] || found.find(owner-unions[position]) != null
        continue
    for fact in types.cases-of(owner-unions[position])
        if fact.name && fact.name! == name
            found += owner-unions[position]
            owners += owner-names[position]
            break

────────────────────
_ do anonymous-symbol TypeId
    - id SyntaxId
    - name Atom

` The union a case named by its symbol alone is of where a declaration owns anonymous cases
` of that name: the one union that has it, as the reference picks before any declared type.
` Gives no type where none has it, and reports a name that two have.
. found [TypeId]
. owners [Atom]
symbol-unions(name, found, owners)
if found.length == 0
    = no-type
if found.length == 1
    = found[0]
. listed = ""
for owner in owners
    if listed.length != 0
        listed += ", "
    listed += "'${owner.text}'"
frame.diagnose
    - id
    - .stated
    - program.store-atom("Anonymous case '.${name.text}' is ambiguous between $listed")
= invalid-type

────────────────────
_ do function-union TypeId

` The union of the anonymous cases a function's body gives that no declaration in it owns:
` the function owns them, under its own name.
. name Atom? = null
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        name = fn.name
. body = frame.declaration.body
if !name || body == 0
    = no-type
. known = anonymous-union(name)
if known != no-type
    = known
. sites [SyntaxId]
. held [TypeId]
hold-payloads(body, null, name, sites, held)
. names [Atom]
. payloads [TypeId]
. counts [U32]
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            . payload = held[position]
            . found = names.find(row.name)
            if found != null && counts[found] != row.args.count
                report-arity(sites[position], row.name)
            else if found != null && payload != invalid-type
                . joined = relations.unify(payloads[found], payload, module)
                if relation-legal(joined)
                    payloads[found] = joined.unified
            else if found == null && payload != invalid-type
                names += row.name
                payloads += payload
                counts += row.args.count
if names.length == 0
    = no-type
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < names.length
    scratch.names.push(names[position])
    scratch.types.push(payloads[position])
. union = types.intern-named-union(name, mark, names-mark)
owner-names += name
owner-unions += union
owner-declared += false
= union

────────────────────
_ do infer-anonymous-case TypeId
    - id SyntaxId
    - name Atom
    - args RowRange'SyntaxId
    - owner Atom?

` An anonymous case is a case of the union its owner's cases make, planned by its number.
` Each value it is given converts to the field in its place of what the case holds, or one
` value to what the case holds. A value that does not convert is reported at the case. One
` value given for a case that holds a tuple or a struct is taken by the reference for the
` first field, which is reported where it does not convert and has no plan where it does.
. union = if owner then anonymous-union(owner) else function-union()
if union == no-type && !owner
    . message = "Anonymous match case '..${name.text}' needs a stable result owner"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if union == no-type
    decline(id)
    = invalid-type
. foreseer = foreseer-of(union)
if foreseer
    foreseer.foreseen-sites += id
    foreseer.foreseen-payloads += anonymous-payload(args)
    = union
. payload = no-type
. number = U32.max
. place = 0u32
for fact in types.cases-of(union)
    if fact.name && fact.name! == name
        number = place
        if !fact.is-default
            payload = fact.type
    place += 1
. shaped = false
if payload != no-type && payload != invalid-type
    shaped = types.intrinsic-of(payload) == .tuple || types.intrinsic-of(payload) == .struct
. position = 0u32
. typed = true
for arg in tree.children[args]
    . given = facts.node-type(instance, arg)
    if given == no-type
        given = infer(arg)
    typed = typed && given != invalid-type
    if given != invalid-type && payload != no-type
        . expected = if args.count > 1 || shaped then field-of(payload, position) else payload
        if expected == no-type || expected == invalid-type
            decline(id)
            = invalid-type
        . plain = types.intrinsic-of(given) != .closure && types.intrinsic-of(given) != .binding
        if plain && !relation-legal(conversions.compare-held(given, expected))
            frame.diagnose(id, .illegal-cast, null, given, expected)
            = invalid-type
        if args.count == 1 && shaped
            decline(id)
            = invalid-type
        conversions.convert(arg, arg, given, expected, .reason-argument)
    position += 1
if number == U32.max && typed && unheld-cases.find(id) != null
    report-unheld(id, name)
    = invalid-type
if number == U32.max && typed
    . message = "Anonymous case '..${name.text}' was not declared"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if number != U32.max
    . plan = if args.count > 1 then OperatorPlan.plan-case-fields else OperatorPlan.plan-case
    facts.set-constant(instance, id, ConstantFact(number, 0.0, null, false), plan)
= union

────────────────────
_ do infer-declared TypeId
    - left SyntaxId
    - right SyntaxId

. expected = no-type
do match? tree.nodes[left]
    | .node-type-capture(row)
        if row.type != 0
            expected = types.evaluate-type(module, tree, row.type, frame.env)
            if expected == invalid-type && report-missing-type(row.type, frame.env)
                = invalid-type
if expected != no-type && expected != invalid-type && is-async-channel(expected)
    . payload = published-payload(right)
    if payload != no-type
        . provided = "[Interface core/stream:Broadcastable'${type-display(types, payload)}]"
        . message = "Event endpoints provide $provided, not ${type-display(types, expected)}"
        frame.diagnose(left, .stated, program.store-atom(message), payload, expected)
        = invalid-type
. place = right
do match? tree.nodes[left]
    | .node-type-capture(row)
        if row.type != 0
            place = row.type
. arms = arms-value(right)
if expecting && is-arms-syntax(arms) && !may-miss(arms, expected)
    note-returned-match(arms, expected)
    arms-expected = expected
.. expecting = expected != no-type && expected != invalid-type
= infer-with-expected(right, expected, Want().escaping(expected, place))

────────────────────
_ do report-missing-signature
    - signature Signature

` Reports the first type written in the signature of the function being typed that names
` nothing, among its arguments and then its return.
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        . pool = program.modules[module].arg-pool
        for position in 0 .. < fn.args.count
            if position < signature.args.length && signature.args[position] == invalid-type
                . written = pool[fn.args.start + position].type-syntax
                if written != 0 && report-missing-type(written, frame.env)
                    =
        if fn.return-type != 0 && signature.returns == invalid-type
            report-missing-type(fn.return-type, frame.env)

────────────────────
_ do report-missing-type Bool
    - syntax SyntaxId
    - env TypeEnv

` Reports where a type written names nothing, as TypeScript reports it (`missing-type`). Says
` whether one was reported.
. missing = types.missing-type(module, program.modules[module].tree, syntax, env)
=? false if missing == 0
frame.diagnose(missing, .stated, program.store-atom("Type not found"))
= true

────────────────────
_ is-async-channel Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        types.async-channel-decl.refers-to(row.module, row.decl)
    ??
        false

────────────────────
_ do fitting-of TypeId
    - want Want

` The function type a value chosen by a condition is given as, where its context expects one of it
` (`want-fitting`).
= if want.asks(.want-fitting) then expected-function(want.type) else no-type

────────────────────
_ held-type TypeId
    - type TypeId

` A type, or what it holds where it is an optional.
if types.is-optional(type) then types.optional-inner(type) else type

────────────────────
_ armed-want Want
    - id SyntaxId
    - want Want

` What is asked of the value an arm gives where the match expects a type of its arms
` (`armed-symbol`) and the value is `if condition then value else other`: that its sides are
` joined at that type, unless the block it ends asks that of it already.
if id == arm-typing.symbol && !want.asks(.want-choice) && arming.expected != types.void-type && is-choice-syntax(id) then want.asking(.want-choice, arming.expected) else want

────────────────────
_ do expected-function TypeId
    - expected TypeId

` The function type a value is expected to be, written as it or as an optional of it; no type
` for any other.
. inner = if types.is-optional(expected) then types.optional-inner(expected) else expected
types.complete(inner)
= if function-row(types, inner) != no-type then inner else no-type

────────────────────
_ is-conditional-value Bool
    - expr SyntaxId

` Whether an expression is a value chosen by a condition, `x if c` or `if c then x else y`, or
` one with a fallback.
match tree.nodes[expr]
    | .node-binary-expression(row)
        row.op == .if-op || row.op == .coalesce-op || row.op == .else-op
    ??
        false

────────────────────
_ calls-symbol Bool
    - expr SyntaxId

` Whether an expression calls a case by its symbol alone, which the type expected of it names.
match tree.nodes[expr]
    | .node-call-expression(row)
        symbol-of(row.callable) != null
    ??
        false

────────────────────
_ do construct-declared
    - pattern SyntaxId

do match? tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0
            . declared = types.evaluate-type(module, tree, row.type, frame.env)
            if declared == invalid-type && report-missing-type(row.type, frame.env)
                =
            if declared != invalid-type && types.intrinsic-of(declared) == .interface
                frame.diagnose(row.type, .stated, program.store-atom("Type can't be null"))
                =
            construct-value(row.type, declared)
    | .node-type-tuple(row)
        for field in tree.children[row.field-types]
            construct-declared(field)

────────────────────
_ lazy-known Bool
    - pattern SyntaxId

|? slot
    frame.known(slot) != no-type
??
    false

.. slot = declaring-slot(first-named(pattern))

────────────────────
_ declaring-slot SlotId?
    - pattern SyntaxId

|? resolution.kind == .resolve-slot
    resolution.slot
??
    null

.. identifier = match tree.nodes[pattern]
    | .node-type-capture(row)
        row.id
    ??
        pattern
.. resolution = bindings.resolution-of(frame.binding, identifier)

────────────────────
_ do first-named SyntaxId
    - pattern SyntaxId

` The name a declaration declares, or the first of those it declares together: they are
` typed together, so what is known of the first is known of each.
do match? tree.nodes[pattern]
    | .node-type-capture(row)
        = row.id
    | .node-tuple-syntax(row)
        if row.items.count != 0
            = first-named(tree.children[row.items.start])
    | .node-type-tuple(row)
        if row.field-types.count != 0
            = first-named(tree.children[row.field-types.start])
= pattern

────────────────────
_ do declare
    - pattern SyntaxId
    - value TypeId
    - value-syntax SyntaxId

if pattern == 0
    =
do match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            plan-tested(row.type)
            check-pattern(pattern, value)
            =
        . declared = value
        if row.type != 0
            . annotation = types.evaluate-type(module, tree, row.type, frame.env)
            if value-syntax != 0 && value != no-type
                note-declared-value(pattern, 0, value-syntax, row.type, annotation, value)
            if bare-generic-annotation(annotation, value)
                annotation = relations.complete-from(annotation, value) ?? value
            declared = annotation
            if never-fits(value, annotation)
                frame.diagnose(pattern, .no-possible-matches)
            else if value != no-type
                calls.note-context-cast(value-syntax, annotation, .cast-pattern)
                . chosen = conversions.convert
                    - row.type
                    - value-syntax
                    - value
                    - annotation
                    - .reason-declaration
                if types.is-optional(annotation) || value != annotation
                    instances.mark-may-panic(instance)
                if !matches-in-place(value, annotation)
                    frame.forget-members()
                if chosen != invalid-type
                    declared = chosen
        . slot = declaring-slot(pattern)
        if slot
            frame.assign(slot, declared)
    | .node-identifier
        . slot = declaring-slot(pattern)
        if slot
            frame.assign(slot, value)
    | .node-type-tuple(row)
        . known = value != no-type && value != invalid-type
        . held = value
        if known && types.is-optional(value)
            held = types.optional-inner(value)
            instances.mark-may-panic(instance)
            facts.record-force(instance, pattern, value, held, false)
        if known && !destructures(held, row.field-types.count)
            frame.diagnose(pattern, .no-possible-matches)
        . position = 0u32
        for field in tree.children[row.field-types]
            . item = if held == no-type then no-type else field-of(held, position)
            declare(field, item, place-syntax(value-syntax, position, row.field-types.count))
            position += 1
    | .node-type-wildcard
        =
    | .node-type-list
        if value != no-type && !pattern-possible(pattern, value)
            frame.diagnose(pattern, .no-possible-matches)
            =
        plan-tested(pattern)
        check-pattern(pattern, value)
    | .node-type-and
        plan-tested(pattern)
        check-pattern(pattern, value)
    | .node-type-property
        if value != no-type && !pattern-possible(pattern, value)
            frame.diagnose(pattern, .no-possible-matches)
            =
        check-pattern(pattern, value)
    ??
        decline(pattern)

────────────────────
_ do place-syntax SyntaxId
    - value SyntaxId
    - position U32
    - count Size

` What a pattern of items declares a place with: the item at that place where it is declared
` with a tuple written with as many items, or else the value.
do match? tree.nodes[value]
    | .node-tuple-syntax(row)
        if row.items.count == count
            . offset = 0u32
            for item in tree.children[row.items]
                =? item if offset == position
                offset += 1
= value

────────────────────
_ do note-declared-value
    - pattern SyntaxId
    - property DeclId
    - value SyntaxId
    - annotation SyntaxId
    - declared TypeId
    - found TypeId

` Records a value written with the type it is declared as, for the rules that read how it is
` written (`DeclaredValueFact`).
. fact = DeclaredValueFact(instance, pattern, property, value, annotation, declared, found)
facts.declared-values.append(fact)

────────────────────
_ matches-in-place Bool
    - value TypeId
    - annotation TypeId

` Whether the reference takes a value declared with a type as it is, with no test that panics
` where it fails, which would end what is known of properties: a value of that type, of an equal
` one, or of an alternative of an `or`.
|? value == annotation
    true
??
    kind == .relation-same || kind == .relation-equal || kind == .relation-or-cast

.. kind = conversions.compare-held(value, annotation).kind

────────────────────
_ do plan-tested
    - pattern SyntaxId

` A pattern a declaration is written with that tests what it is given panics where the test
` fails: it is planned as arms that take nothing of what is left. A pattern of items keeps
` its own plan, and panics where it is declared with.
do match? tree.nodes[pattern]
    | .node-type-and
        instances.mark-may-panic(instance)
        facts.set-plan(instance, pattern, .plan-unmatched)
    | .node-type-list
        instances.mark-may-panic(instance)

────────────────────
_ do never-fits Bool
    - value TypeId
    - annotation TypeId

` Whether a value declared under a type can never be of it: the declaration is a pattern, and
` one nothing matches. A binding fits a function type, or an optional of one, where what it
` calls takes the type's arguments and gives its return.
if value == no-type || value == invalid-type || annotation == invalid-type || value == annotation
    = false
. kind = types.intrinsic-of(value)
if kind == .binding
    types.complete(annotation)
    . inner = types.optional-inner(annotation)
    types.complete(inner)
    = function-row(types, inner) != no-type && !conversions.binding-takes(value, inner)
if kind == .closure
    = false
= !relation-legal(conversions.compare-held(value, annotation))

────────────────────
_ do bare-generic-annotation Bool
    - annotation TypeId
    - value TypeId

if annotation == no-type || annotation == invalid-type || value == no-type || value == invalid-type
    = false
types.complete(annotation)
if !types.completions[annotation].has-variables && !has-inference-args(annotation)
    = false
. declared = class-ref(types, annotation)
. given = class-ref(types, value)
if declared.decl == 0 || given.decl == 0
    = false
= declared.module == given.module && declared.decl == given.decl

────────────────────
_ do has-inference-args Bool
    - id TypeId

do match? types.rows[id]
    | .type-class(row)
        for offset in 0 .. < row.args.count
            do match? types.rows[types.child-type(row.args, offset)]
                | .type-inference
                    = true
= false

────────────────────
_ destructures Bool
    - value TypeId
    - count U32

` A table or span gives exactly its fields; any other tuple gives its leading ones.
|? arity == U32.max
    false
|? is-column-receiver(types.intrinsic-of(value))
    count == arity
??
    count <= arity

.. arity = tuple-arity(value)

────────────────────
_ do struct-arity U32
    - value TypeId

` How many fields a named tuple or struct stores. What a getter answers is no field.
. kind = types.intrinsic-of(value)
if kind != .tuple && kind != .struct && kind != .array-builder
    = U32.max
. count U32
for field in types.properties-of(value)
    if field.slot != U32.max
        count += 1
= count

────────────────────
_ do struct-field-of TypeId
    - value TypeId
    - position U32

. properties = types.completions[value].properties
if position >= properties.count
    = invalid-type
. field = types.properties[properties.start + position]
if field.type == no-type
    = demand-member(field, value, field.name)
= field.type

────────────────────
_ slot-known TypeId
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.slot-known(slot)
??
    frame.known(slot)

────────────────────
_ key-declared TypeId
    - key NarrowingKey

` What a local, a property or a path holds before the flow knows more of it: a local its own
` type, and a property or a path the type it had where the flow first came to know something of
` it, or no type where the flow knows nothing of it.
|? !is-member-key(key)
    slot-known(key)
|? frame.is-stable-path(key)
    frame.path-declared-type(key)
??
    if index != null then frame.member-declared[index] else no-type

.. index = frame.narrowed-members.find(key)

────────────────────
_ lazy-pattern SyntaxId
    - slot SlotId

match tree.nodes[row.group]
    | .node-declare(declaration)
        pattern-identifier(declaration.left)
    ??
        row.group

.. row = bindings.slots[slot]

────────────────────
_ machine-or-value SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` What a declaration's value is checked as: the state machine it is, where it declares one
` name, or the value.
if tree.declared-local(pattern) != 0 then tree.declared-value(value) else value

────────────────────
_ pattern-identifier SyntaxId
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-capture(row)
        row.id
    ??
        pattern

────────────────────
_ do read-slot TypeId
    - slot SlotId
    - site SyntaxId = 0

` A lazy local of a function this one is written in may be evaluated here, by this read: what
` its value may do, this function may do. A lazy local's value is typed where it is first
` read, which `reading.lazy` keeps while it is, the outermost such read; a later read where a
` local the value reads is known otherwise makes it wavering. While the value is typed,
` `lazy-marks` keeps where the narrowings stood as it was entered, so that a read in it of a
` local a test the value made narrowed is noted as one that holds wherever the value is evaluated
` (`note-inside-read`). A later read evaluates nothing where every way to it passed an earlier
` one: for a local kept behind a flag, where the flow knows it has its value (`note-evaluated`),
` as the reference finds a read whose block an earlier one's dominates, and for any other, whose
` reads run in a straight line, always. Such a read neither types the value again nor makes it
` waver (`note-dominated-read`). The value of a local kept behind a flag is typed between
` `mask-tested` and `close-flagged-value`.
if outer && frame.is-captured(slot)
    . found = outer.read-slot(slot)
    if bindings.slots[slot].kind == .slot-lazy && instances.rows[outer!.instance].may-panic
        instances.mark-may-panic(instance)
    if bindings.slots[slot].kind == .slot-lazy
        let-out-lazy(slot, if site != 0 then site else bindings.slots[slot].group)
    = found
if lazy-slots.find(slot) != null
    frame.diagnose(lazy-pattern(slot), .circular-reference)
    = invalid-type
. current = frame.slot-type(slot)
. row = bindings.slots[slot]
. flagged = row.kind == .slot-lazy && site != 0 && bindings.lazy-flagged(slot)
if current != no-type
    if row.kind == .slot-lazy && site != 0 && evaluated-here
        facts.note-dominated-read(instance, site)
        = current
    .. evaluated-here = !bindings.lazy-flagged(slot) || frame.is-evaluated(slot)
    if row.kind == .slot-lazy && row.group != 0 && !settles(slot, row.group)
        facts.note-wavering(instance, slot)
        if bindings.lazy-flagged(slot)
            diagnose-retyped(row.group)
    if row.kind == .slot-lazy && !transforms-agree(slot)
        facts.note-unheld-lazy(instance, slot)
    if row.kind == .slot-lazy && bindings.lazy-flagged(slot)
        recheck-forces(slot)
        if forgetting-lazies.find(slot) != null
            frame.forget-members()
    if flagged
        note-evaluated(slot)
    = current
if row.kind == .slot-lazy && row.group != 0
    . busy = calls.suspend-ranking()
    . leaving = scratch.outgoing.mark
    . around = reading
    if reading.lazy == 0
        reading = reading.lazy = site
    . typed-mark = scratch.narrowings.mark
    if bindings.lazy-flagged(slot)
        mask-tested(row.group)
    lazy-marks += scratch.narrowings.mark
    typing-lazies += slot
    . forgotten = frame.forgotten
    do match? tree.nodes[row.group]
        | .node-declare(declaration)
            note-entered(slot, declaration.right)
            check-declare
                - declaration.left
                - machine-or-value(declaration.left, declaration.right)
                - true
            claim-lazy(slot, row.group, declaration.right)
            if facts.live-statements.length != 0
                settle-live-statement(row.group, declaration.left, declaration.right, no-type)
    if bindings.lazy-flagged(slot) && frame.forgotten != forgotten
        forgetting-lazies += slot
    typing-lazies.pop()
    lazy-marks.pop()
    if bindings.lazy-flagged(slot)
        close-flagged-value(typed-mark)
    if flagged
        note-evaluated(slot)
    reading = around
    calls.resume-ranking(busy)
    if scratch.outgoing.mark != leaving
        raising-lazies += slot
        lazy-transforms += frame.transforms.length
        raising-starts += raising-entries.length
        for entry in scratch.outgoing.since(leaving)
            raising-entries += entry
    = frame.known(slot)
= invalid-type

────────────────────
_ do diagnose-retyped
    - group SyntaxId

` The reference types the value of a lazy local kept behind a flag again at a read that no
` evaluation of it is passed before, under what is known there. A property the value reads from
` a local or a property of the receiver that the flow knew to hold a value where the value was
` typed, and not by a test the value made, but that may hold nothing here, is the reference's
` error there: the property is read from an optional.
. value SyntaxId = 0
do match? tree.nodes[group]
    | .node-declare(declaration)
        value = declaration.right
if value == 0
    =
for id in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[id]
        | .node-get-expression(row)
            if row.is-optional || facts.is-inside-read(instance, row.object) || retyped
                continue
            .. retyped = retyped-reads.find(id) != null
            . recorded = facts.node-type(instance, row.object)
            . here = known-here(row.object)
            if recorded == no-type || recorded == invalid-type || plain-here
                continue
            .. plain-here = here == no-type || !types.is-optional(here)
            if types.is-optional(recorded) || types.optional-inner(here) != recorded
                continue
            retyped-reads += id
            frame.diagnose(id, .property-not-found, row.name, here)

────────────────────
_ do known-here TypeId
    - syntax SyntaxId

` What a read of a local of this frame or of a stored property of the receiver would find
` here, or no type for any other read.
do match? tree.nodes[syntax]
    | .node-identifier(named)
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot && !frame.is-captured(resolution.slot)
            = frame.slot-type(resolution.slot)
        if resolution.kind == .resolve-member
            . key = member-key(resolution.decl)
            if frame.knows-member(key) && !frame.is-doubted(key)
                . held = frame.held-member(key)
                if held != no-type
                    = held
            = member-type(named.name)
= no-type

────────────────────
_ do note-evaluated
    - slot SlotId

` A read of a lazy local kept behind a flag that runs wherever what follows it runs gives the
` local its value there. One in a part of an expression that may not run, where nothing takes
` back what is known after it, or where an error may leave for a catch in this function before
` it ran, gives it nothing that follows.
if skippable-depth == 0 && frame.surround.catch-depth == 0
    frame.note-evaluated(slot)

────────────────────
_ do mask-tested
    - group SyntaxId

` Each local of this frame that the value of a lazy local kept behind a flag tests, which the
` flow knows more of than its type, is known as its type while the value is typed. The reference
` evaluates such a value at the first of its reads and types it again at each read that is not
` passed only after another, under what is known there; a value typed with what it tests as its
` type holds at each, whatever each knows of it.
. value SyntaxId = 0
do match? tree.nodes[group]
    | .node-declare(declaration)
        value = declaration.right
if value == 0
    =
. tested [SyntaxId]
for id in tree.subtree-start(value) .. < value + 1
    note-tested(id, tested)
for subject in tested
    if !(tree.nodes[subject] is .node-identifier)
        continue
    . resolution = bindings.resolution-of(frame.binding, subject)
    if resolution.kind != .resolve-slot || frame.is-captured(resolution.slot) || unnarrowed
        continue
    .. unnarrowed = !frame.is-narrowed(resolution.slot)
    frame.push-narrowing(slot-key(resolution.slot), frame.known(resolution.slot))

────────────────────
_ do note-tested
    - id SyntaxId
    - into [SyntaxId]

` The operands a condition at a node tests of what they hold: the sides of `&&` and `||`, the
` condition of `if`, what `!`, `?` and `is` test, and what is compared with `null`.
do match? tree.nodes[id]
    | .node-binary-expression(row)
        if row.op == .and-op || row.op == .or-op
            into += row.lhs
            into += row.rhs
        else if row.op == .if-op
            into += row.rhs
        else if (row.op == .equals-op || row.op == .not-equals-op) && narrowing.is-null-syntax(row.rhs)
            into += row.lhs
        else if (row.op == .equals-op || row.op == .not-equals-op) && narrowing.is-null-syntax(row.lhs)
            into += row.rhs
        else if is-type-test(row.op)
            into += row.lhs
    | .node-unary-expression(row)
        if row.op == .not-op
            into += row.operand
    | .node-type-predicate(row)
        into += row.expr
    | .node-if-block(row)
        if row.condition != 0
            into += row.condition

────────────────────
_ do close-flagged-value
    - mark ScratchMark

` What the value of a lazy local kept behind a flag, or `mask-tested` before it, left known holds
` only within it, since a read that comes after it may find the flag set and evaluate nothing.
` What an assignment in it settled is known after it.
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
for row in settled
    frame.push-assigned(row.key, row.type, row.cases)

────────────────────
_ do recheck-forces
    - slot SlotId

` The reference evaluates the value of a lazy local it keeps behind a flag again at each read,
` under what is known there, where this pass types it at the first: a force in the value that
` the flow narrowed before the value was entered is narrowed only where every read still knows
` what the force reads to hold a value, and a read that does not ends what is known of
` properties, as the reference's panic there makes calls. What the value itself tests it tests
` at each read.
for position in 0 .. < forcing-lazies.length
    if forcing-lazies[position] == slot
        . index = forcing-facts[position]
        if !known-present(force-operand(facts.forces[index].syntax))
            facts.forces[index].operand = forcing-declared[position]
            facts.forces[index].is-narrowed = false
            frame.forget-members()

────────────────────
_ force-operand SyntaxId
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-unary-expression(row)
        row.operand
    ??
        0

────────────────────
_ do known-present Bool
    - syntax SyntaxId

` Whether the flow knows here that a local, a property of the receiver or a path from one of
` those holds a value, as a read of it here would find.
do match? tree.nodes[syntax]
    | .node-type-predicate(row)
        = known-present(row.expr)
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot
            . known = frame.slot-type(resolution.slot)
            = known != no-type && known != invalid-type && !types.is-optional(known)
        if resolution.kind == .resolve-member
            = member-holds(member-key(resolution.decl))
    | .node-get-expression(row)
        if row.is-optional
            = false
        . key = narrowing.receiver-member(row.object, row.name)
        . base = narrowing.base-key(row.object)
        if !key && base
            key = frame.find-path-key(base, row.name)
        = key != null && member-holds(key)
= false

────────────────────
_ member-holds Bool
    - key NarrowingKey

` Whether the flow knows here that a property or a path holds a value, a read of it that is
` counted (`member-reads`).
|? !frame.knows-member(key) || frame.is-doubted(key)
    false
??
    held != no-type && held != invalid-type && !types.is-optional(held)

.. held = frame.narrowed-member(key)

────────────────────
_ do lazy-leaving Bool
    - slot SlotId
    - into [Outgoing]

` The errors the value of a lazy local lets out where its first read typed it, added to `into`
` by the function that declares it. False where transformers were declared there, which may
` take them.
for position in 0 .. < raising-lazies.length
    if raising-lazies[position] == slot
        if lazy-transforms[position] != 0
            = false
        . start = raising-starts[position]
        . end = raising-entries.length
        if position + 1 < raising-starts.length
            end = raising-starts[position + 1]
        for index in start .. < end
            into += raising-entries[index]
        = true
if outer && frame.is-captured(slot)
    = outer.lazy-leaving(slot, into)
= true

────────────────────
_ do let-out-lazy
    - slot SlotId
    - site SyntaxId

` A lazy local of a function this one is written in that this read evaluates lets its errors
` out of this function too, where its writer calls it in place, as they leave TypeScript's
` inline loop; the writer lets them out with the call. Those of a function called elsewhere,
` or that meet transformers declared on either side, stay in the writer, and an error that
` would leave here has no shape where emitted.
if !in-place || frame.transforms.length != 0
    =
. leaving [Outgoing]
if !outer!.lazy-leaving(slot, leaving)
    =
for entry in leaving
    scratch.outgoing.push(Outgoing(entry.type, site, entry.callee, U32.max, 0))

────────────────────
_ do transforms-agree Bool
    - slot SlotId

` Whether a lazy local whose value lets errors out is read again where the transformers
` declared are those declared where its first read typed it. TypeScript evaluates the value
` at each read, so an error leaving it is transformed by those declared there.
for position in 0 .. < raising-lazies.length
    if raising-lazies[position] == slot
        = lazy-transforms[position] == frame.transforms.length
= true

────────────────────
_ do hold-transforms
    - error TypeId
    - site SyntaxId

` TypeScript evaluates the exception of a transformer again where each error it takes
` leaves, with the names and the flow there, where the type pass typed it once where it is
` declared. A transformer that may take an error leaving here, an error not yet known taken
` by any, whose exception does not hold here, is marked, and emission refuses it.
for transform in frame.transforms
    if error != no-type && caught-rank(relations, error, transform.source) == null
        continue
    . row = facts.transforms[transform.fact]
    if !exception-holds(row.site, row.exception, site)
        facts.note-unheld-transform(transform.fact)

────────────────────
_ do exception-holds Bool
    - declared SyntaxId
    - exception SyntaxId
    - site SyntaxId

` Whether a transformer's exception, typed at the raise that declares it, means here what it
` meant there: each name it reads names nothing declared since that a scope here holds, a
` local it reads is in a scope here and known as it was there, and a property it reads by its
` name is known as it was there. The names the catchers bind are its own.
. first = tree.subtree-start(declared)
for id in tree.subtree-start(exception) .. < exception + 1
    do match? tree.nodes[id]
        | .node-identifier(name)
            . resolution = bindings.resolution-of(frame.binding, id)
            . recorded = facts.node-type(instance, id)
            if shadowed(name.name, declared, site)
                = false
            if resolution.kind == .resolve-slot
                . row = bindings.slots[resolution.slot]
                . own = row.syntax >= first && row.syntax <= declared
                if !own && !holds-scope(row.scope, site)
                    = false
                if !own && recorded != no-type && recorded != frame.slot-type(resolution.slot)
                    = false
            if member-recorded && recorded != member-type(name.name)
                = false
            .. member-recorded = resolution.kind == .resolve-member && recorded != no-type
= true

────────────────────
_ do shadowed Bool
    - name Atom
    - declared SyntaxId
    - site SyntaxId

` Whether a local of the function named so is declared after a node and before a site, in a
` scope that holds the site.
. bound = bindings.bindings[frame.binding]
for slot in bound.slots.start .. < bound.slots.start + bound.slots.count
    . row = bindings.slots[slot]
    if row.name == name && between && holds-scope(row.scope, site)
        = true
    .. between = row.syntax > declared && row.syntax < site
= false

────────────────────
_ holds-scope Bool
    - scope ScopeId
    - site SyntaxId

` Whether a site lies in a scope: a function's own holds all of it.
|? row.kind == .scope-function || row.kind == .scope-nested
    true
??
    site >= tree.subtree-start(row.syntax) && site <= row.syntax

.. row = bindings.scopes[scope]

────────────────────
_ do settles Bool
    - slot SlotId
    - group SyntaxId

` Whether the value of a lazy local, typed where it was first read, holds where it is read
` again: each local it reads, and each property it reads by its name, is known here as it was
` there, or read there as its type. A local the value itself learns more of, by a test it makes, is known there as the
` value left it; it holds here where the local is known as it was when the value was
` entered, which `note-entered` kept. One not known yet then, a lazy local the value is the
` first to read or one it declares, the value knows first as its type. A local the value read
` as its type holds anywhere.
do match? tree.nodes[group]
    | .node-declare(declaration)
        . value = declaration.right
        for id in tree.subtree-start(value) .. < value + 1
            do match? tree.nodes[id]
                | .node-identifier(name)
                    . recorded = facts.node-type(instance, id)
                    . resolution = bindings.resolution-of(frame.binding, id)
                    if recorded == no-type
                        continue
                    if resolution.kind == .resolve-slot
                        . known = frame.slot-type(resolution.slot)
                        . entered = entered-type(slot, resolution.slot)
                        . prior = if entered != no-type then entered else frame-known
                            .. frame-known = frame.known(resolution.slot)
                        if recorded != known && prior != known && stale-record
                            = false
                        .. stale-record = recorded != frame.known(resolution.slot)
                    if member-read && recorded != member-type(name.name) && moved-here
                        = false
                    .. member-read = resolution.kind == .resolve-member
                    .. moved-here = recorded != known-here(id)
= true

────────────────────
_ do note-entered
    - slot SlotId
    - value SyntaxId

` Keeps, where the value of a lazy local is first typed, what each local it reads is known as
` before it, for `settles`.
entered-lazies += slot
entered-starts += entered-slots.length
for id in tree.subtree-start(value) .. < value + 1
    if !(tree.nodes[id] is .node-identifier)
        continue
    . resolution = bindings.resolution-of(frame.binding, id)
    if resolution.kind != .resolve-slot
        continue
    . known = frame.slot-type(resolution.slot)
    if known != no-type
        entered-slots += resolution.slot
        entered-types += known

────────────────────
_ do entered-type TypeId
    - slot SlotId
    - read SlotId

` What a local a lazy local's value reads was known as when the value was first typed, or
` none where it was not known yet.
. position = entered-lazies.find(slot)
if !position
    = no-type
. end = if position + 1 < entered-lazies.length then entered-starts[position + 1] else slots-end
    .. slots-end = entered-slots.length
for index in entered-starts[position] .. < end
    if entered-slots[index] == read
        = entered-types[index]
= no-type

────────────────────
_ do member-type TypeId
    - name Atom

. found = types.property-named(frame.self-type, name) if frame.self-type != no-type
= if found then member-type(types.properties[found], frame.self-type) else no-type

────────────────────
_ do wavers Bool
    - slot SlotId

` Whether a local is read as more than its type where that may not hold: by its own
` function after a nested function that captures it was typed, or by a nested function at
` all, when something assigns it. In a loop the call that types the nested function may be
` written after the read and run before it, so there a local a nested function captures
` wavers wherever something assigns it. The body of a `do @no-gc` block runs where it is
` written, so a local it reads wavers only as the read would in the function around it.
if outer && frame.is-captured(slot) && in-zone-body
    = outer.wavers(slot)
if outer && frame.is-captured(slot)
    = outer.holds-narrowed(slot)
if frame.wavers(slot)
    = true
. shared = SlotFlag.slot-captured /or/ SlotFlag.slot-assigned
= loop-marks.length != 0 && shared-flags && frame.is-narrowed(slot) && closes-over(slot)
    .. shared-flags = (bindings.slots[slot].flags /and/ shared) == shared

────────────────────
_ do closes-over Bool
    - slot SlotId

` Whether a nested function of the binding captures a local, other than the body of a
` `do @no-gc` block, which runs where it is written.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if is-region-body(nested.decl)
        continue
    for index in 0 .. < nested.captures.count
        if bindings.captures[nested.captures.start + index].slot == slot
            = true
= false

────────────────────
_ is-region-body Bool
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-function(fn)
        fn.kind == .region-decl
    ??
        false

────────────────────
_ holds-narrowed Bool
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.holds-narrowed(slot)
??
    (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 && frame.is-narrowed(slot)

────────────────────
_ holds-tested Bool
    - slot SlotId

` Whether a local something assigns is held where the type pass stands as what a test found
` of it. The reference gives a nested function written there a copy of what the test found,
` so what the function assigns does not reach the local. What an assignment left a local as
` is no copy, there or here.
|? outer && frame.is-captured(slot)
    outer.holds-tested(slot)
??
    (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 && frame.is-tested(slot)

────────────────────
_ do share-captures
    - nested-decl DeclId

` A nested function written in this one is typed for the first time. Each local it
` captures that something assigns is shared from here, in the frame that declares it.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.decl != nested-decl
        continue
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0
            share(slot)

────────────────────
_ do share
    - slot SlotId

if outer && frame.is-captured(slot)
    outer.share(slot)
else
    frame.share(slot)

────────────────────
_ precedes-declaration Bool
    - slot SlotId

` A closure body is checked where the closure is first called, and a local that an enclosing
` function declares after that call does not exist yet.
|? !outer || !frame.is-captured(slot)
    false
??
    outer.awaits-declaration(slot)

────────────────────
_ awaits-declaration Bool
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.awaits-declaration(slot)
??
    bindings.slots[slot].kind == .slot-local && frame.known(slot) == no-type

────────────────────
_ awaits-element Bool
    - slot SlotId

` Whether a local an enclosing function declares is the name of a markup element it has not
` made yet. A closure made before then that reads it is declined: the reference reads the
` receiver's property of the name when the closure runs.
|? outer && frame.is-captured(slot)
    outer.awaits-element(slot)
??
    waited != null && awaited[waited] != 0

.. waited = unbuilt.find(slot)

────────────────────
_ constructs-element Bool
    - slot SlotId

` Whether a local an enclosing function declares is the name of a markup element whose object
` that function is making.
|? outer && frame.is-captured(slot)
    outer.constructs-element(slot)
??
    slot == building || held.find(slot) != null

────────────────────
_ assigns-early Bool
    - lhs SyntaxId

resolution.kind == .resolve-slot && precedes-declaration(resolution.slot)

.. resolution = bindings.resolution-of(frame.binding, lhs)

────────────────────
_ do stores-loop-constant Bool
    - lhs SyntaxId
    - op Operator
    - target TypeId
    - value TypeId
    - rhs SyntaxId

` Whether an assignment stores to the item of a loop that counts through its range itself,
` or to that loop's `it` or `each`. The loop gives them their value on each pass, and nothing
` else may. An assigning operator the type answers with a function of its own stores nothing.
` Whether the item of any other loop is a constant depends on how the loop is lowered.
. loop SyntaxId = 0
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        if resolution.kind == .resolve-slot
            . row = bindings.slots[resolution.slot]
            if row.kind == .slot-loop-item
                loop = bindings.scopes[row.scope].syntax
            else if row.kind == .slot-it || row.kind == .slot-each
                loop = row.syntax
if loop == 0 || facts.plan-of(instance, loop) != .plan-range-loop
    = false
= op == .eq-op || !(calls.has-operator(target, program.store-atom("$op"), value) • arg-syntax rhs)

────────────────────
_ do is-close-method Bool
    - declaration CheckedDecl

if frame.self-type == no-type || frame.self-type == invalid-type
    = false
if types.intrinsic-of(frame.self-type) != .class
    = false
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . atom = fn.name
            = atom.text == "close"
= false

────────────────────
_ do has-events Bool
    - type TypeId

` Whether a class declares an event or inherits one.
. cursor = type
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    for member in target.member-pool[class.members]
                        if target.decls[member] is .decl-event
                            = true
    cursor = types.base-of(cursor) ?? no-type
= false

────────────────────
_ do demand-event-close

` The event runtime's `event-close-owner`, which the `close` of a class with events calls as it
` leaves, so that what subscribes to the object's events no longer hears them.
if facts.event-close != no-instance
    =
. mark = scratch.types.mark
scratch.types.push(pointer-to(types.type-row(.uint8)))
facts.event-close = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-close-owner")
    - mark
scratch.types.rewind(mark)

────────────────────
_ do demand-live-action-cleanup

. action = types.live-action-type
if action == invalid-type
    =
. mark = scratch.types.mark
scratch.types.push(action)
. actions = types.class-named-with-args(module, types.list-atom!, mark)
calls.demand-method(actions, program.store-atom("!"))
calls.demand-method(actions, program.store-atom("pop"))
calls.demand-method(action, program.store-atom("close"))

────────────────────
_ do is-generator-end Bool
    - declaration CheckedDecl

` A generator's `end-iterating` closes the generator in the reference, which can panic.
if frame.self-type == no-type || frame.self-type == invalid-type
    = false
if !same-decl(class-ref(types, frame.self-type), types.generator-decl)
    = false
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . atom = fn.name
            = atom.text == "end-iterating"
= false

────────────────────
_ do note-explicit-return
    - id SyntaxId
    - expr SyntaxId

` Where an explicit return may be written. A cleanup and the body of `main` or of a loop on a
` stream have none, a task's body and a state machine's handler return no value, and a
` function that is not imperative states it needs `do`. In the body of a rule of a class one
` with no value leaves the body, and one with a value is reported, as a rule gives none.
if finally.cleaning-up
    frame.diagnose(id, .stated, program.store-atom("Illegal deferred statement"))
    =
if handling != 0 && expr != 0
    . text = "A state machine's handler gives no value, so it cannot return one with \"=\"; end it early with \"= alone\""
    frame.diagnose(id, .stated, program.store-atom(text))
    =
if is-rule-unit()
    if expr != 0
        . text = "A rule gives no value, so its body cannot return one with \"=\"; end it early with \"= alone\""
        frame.diagnose(id, .stated, program.store-atom(text))
    =
if is-subscriber-body()
    frame.diagnose(id, .stated, program.store-atom("Illegal return from subscriber"))
    =
if frame.declaration.kind == .task-decl && expr != 0
    . brix = tree.source-path.ends-with(".bx")
    . returning = if brix then "(return …)" else "="
    . ending = if brix then "(return)" else "= alone"
    . text = "A task gives no value, so its body cannot return one with \"$returning\"; end it with \"$ending\", or send the value on a channel"
    frame.diagnose(id, .stated, program.store-atom(text))
    =
if frame.declaration.is-main
    frame.diagnose(id, .stated, program.store-atom("Illegal return"))
    =
if frame.declaration.is-imperative || checks-at-declaration(frame.declaration)
    =
frame.diagnose(id, .explicit-return-requires-do)

────────────────────
_ do note-returned-match
    - expr SyntaxId
    - declared TypeId

` A match that is returned is the value of the declared return type, and so are its arms,
` and so is a stream pattern its body runs beside the lazy locals declared for it.
facts.set-node-type(instance, expr, declared)
do match? tree.nodes[expr]
    | .node-match-expression(row)
        facts.set-node-type(instance, row.body, declared)
        . streamed = tree.stream-statement(row.body)
        if streamed != 0 && streamed != row.body
            facts.set-node-type(instance, streamed, declared)

────────────────────
_ do may-miss Bool
    - expr SyntaxId
    - declared TypeId

` Whether a returned match runs a stream pattern no arm of which need pass, in a function
` that returns no optional. The reference types such a match as it does one that is not
` returned, an optional of what its arms give, and the return converts it as any optional,
` at the match and not at its arms.
if declared == no-type || declared == types.void-type || types.is-optional(declared)
    = false
do match? tree.nodes[expr]
    | .node-match-expression(row)
        do match? tree.nodes[tree.stream-statement(row.body)]
            | .node-stream-match(stream)
                = !always-passes(stream.pattern)
= false

────────────────────
_ do require-do
    - id SyntaxId
    - message String

` A function that is not `do` is one expression: it has no immediate declarations, loops or
` yields outside a `do` block. Generated closures run their own statements and are exempt, and
` one the module declares is checked as it is declared (`check-return-mode`).
if do-depth != 0 || frame.declaration.is-imperative || frame.declaration.is-main
    =
if frame.declaration.kind != .function-decl && frame.declaration.kind != .closure-decl
    =
if checks-at-declaration(frame.declaration)
    =
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do check-return
    - statement SyntaxId
    - expr SyntaxId
    - is-conditional Bool

if expr == 0
    if is-conditional
        giving = giving.defaulted = true
        if default-site == 0
            default-site = statement
    else
        giving = giving.empty = true
    =
. declared = declared-return
. missing = may-miss(expr, declared)
. matched = declared != no-type && declared != types.void-type && is-match-syntax(expr) && !missing
if matched
    note-returned-match(expr, declared)
    arms-expected = declared
. value = if declared == no-type then returned-symbol(expr) else no-type
if value == no-type
    expect-bullets(expr, declared)
    value = infer-with-expected(expr, declared, Want().escaping(declared, expr))
if !is-conditional
    value = returned-value(statement, value)
. noted = value
. whole = is-conditional && value != no-type && value != invalid-type && types.is-optional(value)
if whole
    noted = types.optional-inner(value)
do match? tree.nodes[expr]
    | .node-optional-chain
        if value != no-type && value != invalid-type && types.is-optional(value)
            noted = types.optional-inner(value)
` A conditional return of `null` from a function that returns an optional gives the null of the
` return type itself: nothing converts.
. returns-optional = declared != no-type && types.is-optional(declared)
. gives-null = is-conditional && narrowing.is-null-syntax(expr) && returns-optional
` A conditional return of an optional returns the optional itself: what it holds only counts
` toward the type the returns unify to.
if declared != no-type && declared != types.void-type && !gives-null
    calls.note-context-cast(expr, declared, .cast-return)
    . located = !is-string-syntax(expr) || types.is-optional(declared)
    conversions.convert
        - if missing then expr else return-site(expr)
        - expr
        - if whole then value else noted
        - declared
        - .reason-return
        - located
else if whole
    whole-returns += statement
    giving = giving.whole = true
frame.note-return(noted, statement)

────────────────────
_ do refuse-default
    - statement SyntaxId

` A return written with only its condition gives nothing, false or an optional that holds
` nothing: a function declared to return anything else has none of those to give. A
` constructor's leaves it with the object it has made, and a function that yields ends what
` it makes there, so the first such return is refused once the body is typed.
if frame.declaration.kind == .constructor-decl
    =
. declared = declared-return
if declared == no-type || declared == invalid-type || plain-return
    =
.. plain-return = declared == types.void-type || declared == types.bool-type
if types.is-optional(declared)
    =
. message = "Condition-only early return cannot return from ${type-display(types, declared)}; use an optional, Bool, or Void return type"
frame.diagnose(statement, .stated, program.store-atom(message), declared)

────────────────────
_ do returned-value TypeId
    - statement SyntaxId
    - value TypeId

` What a return gives of a value that may be an error: the value alone. Each error leaves the
` function at the return, in the place of its value.
if value == no-type || value == invalid-type
    = value
do match? types.rows[value]
    | .type-result(row)
        for offset in 0 .. < row.errors.count
            note-outgoing(types.child-type(row.errors, offset), statement)
        facts.set-plan(instance, statement, .plan-fused)
        = row.value
= value

────────────────────
_ do convert-returns
    - unified TypeId
    - final TypeId

` Converts what each return gives to the type the returns unify to, and then to the optional
` of it where the function may also return nothing. A conditional return of an optional gives
` the optional itself, which converts to the type the function returns in one step.
. wraps = final != unified && final != no-type && final != invalid-type && types.is-optional(final)
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . skipped = site.type == no-type || site.type == invalid-type || site.type == types.null-type
    if skipped
        continue
    if whole-returns.find(site.syntax) != null
        . given = types.optional-of(site.type)
        . target = if wraps then final else unified
        if given != target
            conversions.convert(site.syntax, site.syntax, given, target, .reason-return)
        continue
    if site.type != unified
        conversions.convert(site.syntax, site.syntax, site.type, unified, .reason-return)
    if wraps
        conversions.convert(site.syntax, site.syntax, unified, final, .reason-return)

────────────────────
_ do arm-symbol TypeId
    - expr SyntaxId
    - symbol Atom

for position in arming.start .. < scratch.types.length
    . noted = scratch.types[position]
    if noted != no-type && noted != invalid-type && enum-case-decl(types, program, noted, symbol)
        note-enum-case(noted, symbol, expr)
        facts.set-node-type(instance, expr, noted)
        = noted
= no-type

────────────────────
_ do returned-symbol TypeId
    - expr SyntaxId

. symbol = symbol-of(expr)
if !symbol
    = no-type
for position in frame.returns-start .. < types.scratch.returns.length
    . noted = types.scratch.returns[position].type
    if noted != no-type && noted != invalid-type && enum-case-decl(types, program, noted, symbol)
        note-enum-case(noted, symbol, expr)
        facts.set-node-type(instance, expr, noted)
        = noted
= no-type

────────────────────
_ do settle-symbol-returns

. symbolic = false
. candidates [TypeId]
. counts [U32]
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if symbol-of(returned-expr(site.syntax))
        symbolic = true
    if site.type == no-type || site.type == invalid-type || valueless
        continue
    .. valueless = site.type == types.null-type || site.type == types.void-type
    . found = U32.max
    for index in 0 .. < candidates.length
        if candidates[index] == site.type
            found = index as U32
    if found == U32.max
        candidates += site.type
        counts += 1
    else
        counts[found] += 1
if !symbolic || candidates.length < 2
    =
for index in 1 .. < candidates.length
    . place = index
    while place > 0 && counts[place - 1] < counts[place]
        . held = candidates[place]
        candidates[place] = candidates[place - 1]
        candidates[place - 1] = held
        . tally = counts[place]
        counts[place] = counts[place - 1]
        counts[place - 1] = tally
        place -= 1
for candidate in candidates
    if symbol-returns-fit(candidate)
        retype-symbol-returns(candidate)
        =

────────────────────
_ do settle-literal-returns TypeId
    - value TypeId

` Gives an integer a function returns written with no suffix the type of the first other value it
` returns, as an integer beside that value takes, so `= 0` beside `= count` returns the type of
` `count`, or where each is written with none, that of the first float, so `= 1` beside `= 2.5`
` returns a float. Returns what the value the body ends with now has.
. tail = if !frame.declaration.is-imperative && value != no-type then value-syntax else 0
. peer = no-type
. float = no-type
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . expr = returned-expr(site.syntax)
    if peer == no-type && returns-peer(site.type) && conversions.literal-of(expr) == 0
        peer = site.type
    if float == no-type && returns-peer(site.type) && float-literal
        float = site.type
    .. float-literal = conversions.literal-of(expr) != 0 && tree.nodes[expr] is .node-float-syntax
if peer == no-type && tail != 0 && returns-peer(value) && conversions.literal-of(tail) == 0
    peer = value
if float == no-type && tail != 0 && returns-peer(value) && float-tail
    float = value
.. float-tail = conversions.literal-of(tail) != 0 && tree.nodes[tail] is .node-float-syntax
if peer == no-type
    peer = float
=? value if peer == no-type
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . expr = returned-expr(site.syntax)
    if site.type != peer && returns-peer(site.type) && conversions.literal-of(expr) != 0
        scratch.returns[position] = TypedSite
            - conversions.adapted-literal(expr, site.type, peer)
            - site.syntax
= if literal-tail then conversions.adapted-literal(tail, value, peer) else value
    .. literal-tail = tail != 0 && conversions.literal-of(tail) != 0

────────────────────
_ returns-peer Bool
    - type TypeId

type != no-type && type != invalid-type && type != types.null-type && type != types.void-type

────────────────────
_ do symbol-returns-fit Bool
    - candidate TypeId

for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if no-value || site.type == types.void-type || site.type == candidate
        continue
    .. no-value = site.type == no-type || site.type == invalid-type || site.type == types.null-type
    . symbol = symbol-of(returned-expr(site.syntax))
    if symbol && enum-case-decl(types, program, candidate, symbol)
        continue
    if !relation-legal(relations.compare(site.type, candidate))
        = false
= true

────────────────────
_ do retype-symbol-returns
    - candidate TypeId

for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if site.type == candidate || site.type == no-type || site.type == invalid-type
        continue
    . expr = returned-expr(site.syntax)
    . symbol = symbol-of(expr)
    if symbol && enum-case-decl(types, program, candidate, symbol)
        note-enum-case(candidate, symbol, expr)
        facts.replace-node-type(instance, expr, candidate)
        scratch.returns[position] = TypedSite(candidate, site.syntax)

────────────────────
_ returned-expr SyntaxId
    - statement SyntaxId

match tree.nodes[statement]
    | .node-return(row)
        row.expr
    | .node-return-if-true(row)
        row.expr
    ??
        0

────────────────────
_ yielded-syntax SyntaxId
    - site SyntaxId

` What a yield written as a statement gives, so an integer it gives with no suffix converts to the
` items as that integer does; any other site is its own value.
match tree.nodes[site]
    | .node-yield(row)
        row.expr
    ??
        site

────────────────────
_ do yielded-value TypeId
    - id SyntaxId
    - expr SyntaxId

` `<=?` yields only a present value, so the optional it reads unwraps; the reference types the
` statement as the optional it tests.
. value = infer(expr)
do match? tree.nodes[expr]
    | .node-optional-chain
        if types.is-optional(value)
            facts.set-node-type(instance, id, value)
            = types.optional-inner(value)
= value

────────────────────
_ do note-yield
    - value TypeId
    - site SyntaxId = 0
    - looped Bool = false
    - literal SyntaxId = 0

` Notes a yield and what it gives. One a statement writes is kept with where it is
` written, to be converted to the type of the function's items once that is known. The
` items have the type the yields unify to in the order they are written, as the reference
` folds them: each with the type the relation before it converted to, so that of two
` tuples or two lists neither of which is the wider, the first stays. Nothing is unified
` where the function declares its items. The reference folds in the order of its blocks,
` which is the order written only outside loops: a fold that gives another type the other
` way round is noted, with whether any yield is in a loop (F12b-30). The yields of a list of
` bullets are kept until the list is typed, and folded in the order of its blocks, which
` visit each branch's failing successor first: a bullet that tests before it yields, a `**`
` by its loop and a `*?` by its test, yields after everything the bullets after it yield. A
` yield written as a number with no suffix, as such numbers or as a range of such integers, is
` kept with what it writes, which takes the type of the others as the items of a list do.
giving = giving.yields = true
if loop-depth != 0 || looped
    loops-yields = true
if value == invalid-type || value == no-type
    =
if site != 0
    frame.note-yielded(value, site)
    yield-literals += literal
if orders-yields
    ordered-yields += value
    ordered-sites += site
    ordered-literals += literal
    =
fold-yield(value, site, false, literal)

────────────────────
_ do fold-yield
    - value TypeId
    - site SyntaxId
    - ordered Bool
    - literal SyntaxId

` Folds a yield into what the yields so far unify to. One written as a number with no suffix
` that the others hold is of their type, and where each so far is written so, they are of the
` type of one they all fit, or of tuples such numbers write, the tuple they join to place by place.
if giving.yielded == no-type
    giving = giving.yielded = value
    folded-yield = value
    folded-literal = literal != 0
    =
if states-items()
    =
. relation = relations.unify(folded-yield, value)
if !relation-legal(relation) && literal != 0 && yield-fits(literal, folded-yield)
    =
if !relation-legal(relation) && folded-literal && literals-fit(value)
    folded-yield = value
    giving = giving.yielded = value
    folded-literal = literal != 0
    =
if !relation-legal(relation) && folded-literal && literal != 0
    . joined = relations.joined-places(folded-yield, value)
    if joined != no-type && literals-fit(joined)
        folded-yield = joined
        giving = giving.yielded = joined
        =
if literal == 0
    folded-literal = false
if relation-legal(relation)
    if folded-yield != value && !ordered
        . back = relations.unify(value, folded-yield)
        if !relation-legal(back) || back.unified != relation.unified
            splits-yields = true
    folded-yield = relation.to
    giving = giving.yielded = relation.unified
else if site != 0 && frame.yields-start < scratch.yields.length
    . first = scratch.yields[frame.yields-start].syntax
    do match? tree.nodes[first]
        | .node-yield(row)
            first = row.expr
    frame.diagnose(first, .stated, program.store-atom("Unable to unify generator yield types"))

────────────────────
_ do literals-fit Bool
    - target TypeId

` Whether each yield noted that is written as a number with no suffix is one a type holds.
= all(yield-literals) • where each == 0 || yield-fits(each, target)

────────────────────
_ do yield-fits Bool
    - literal SyntaxId
    - target TypeId

` Whether a yield written as a number with no suffix, as such numbers, or as a range of such
` integers is one a type holds.
do match? tree.nodes[literal]
    | .node-range-expression(row)
        = row.increment == 0 && conversions.fitting-literal(row.left, target) && right-fits
            .. right-fits = conversions.fitting-literal(row.right, target)
= conversions.fitting-literal(literal, target)

────────────────────
_ written-literal SyntaxId
    - syntax SyntaxId

` What a yield writes where it is a number with no suffix, such numbers, or a range of such
` integers, or none.
|? conversions.literal-of(syntax) != 0
    syntax
??
    match tree.nodes[syntax]
        | .node-range-expression(row)
            if row.increment == 0 && plain-left && plain-right then syntax else 0

            .. plain-left = conversions.is-plain-integer(row.left)
            .. plain-right = conversions.is-plain-integer(row.right)
        ??
            0

────────────────────
_ states-items Bool

` Whether the function declares what its yields give, as a generator, a stream, an iterable
` or an indexable of it.
|? declared == no-type || declared == invalid-type
    false
|? same-decl(ref, types.generator-decl) || same-decl(ref, types.stream-decl)
    true
??
    same-decl(ref, types.iterable-decl) || same-decl(ref, types.indexable-decl)

.. declared = declared-return
.. ref = class-ref(types, declared)

────────────────────
_ is-range-type Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        row.module == types.range-decl.module && row.decl == types.range-decl.decl
    ??
        false

────────────────────
_ is-array-type Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        row.module == types.array-decl.module && row.decl == types.array-decl.decl
    ??
        false

────────────────────
_ is-identifier-syntax Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-identifier
        true
    ??
        false

────────────────────
_ is-integer-literal Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-integer-syntax
        true
    ??
        false

────────────────────
_ is-match-syntax Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-match-expression
        true
    ??
        false

────────────────────
_ arms-value SyntaxId
    - expr SyntaxId

` The value a declaration gives where it is written alone in a block of its own, as arms are.
match tree.nodes[expr]
    | .node-block(row)
        if row.body.count == 1 then tree.children[row.body.start] else expr
    ??
        expr

────────────────────
_ is-arms-syntax Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-match-expression
        true
    | .node-structure-match
        true
    ??
        false

────────────────────
_ is-quasi-syntax Bool
    - expr SyntaxId

` Whether a statement gives no value though it is typed as an expression: an assignment, a line
` of markup that declares a property, a print, or a `do` block.
match tree.nodes[expr]
    | .node-assign
        true
    | .node-property-syntax
        true
    | .node-print
        true
    | .node-do-block
        true
    | .node-do-finally-block
        true
    ??
        false

────────────────────
_ assigns Bool
    - expr SyntaxId

` An arrow body that is an assignment gives the value assigned.
match tree.nodes[expr]
    | .node-assign
        true
    ??
        false

────────────────────
_ is-string-syntax Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-string-syntax
        true
    ??
        false

────────────────────
_ return-site SyntaxId
    - expr SyntaxId

match tree.nodes[expr]
    | .node-match-expression(row)
        row.body
    ??
        expr

────────────────────
_ do check-if
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId

if condition == 0
    check-statement(body)
    check-statement(next)
    =
tested-match = tested(condition)
note-truthiness(condition, condition, infer(condition))
tested-match = 0
. assigned-mark = frame.assigned-syntax.length
. body-mark = scratch.narrowings.mark
. dead = never-holds(condition, true)
. known = frame.save-members()
if dead
    facts.set-plan(instance, id, .plan-never)
else
    narrowing.narrow-condition(condition, true)
    check-statement(body)
. split = frame.assigned-syntax.length
. body-settled = frame.assigned-since(body-mark)
frame.pop-narrowing(body-mark)
. next-mark = scratch.narrowings.mark
. body-known = frame.save-members()
frame.restore-members(known)
narrowing.narrow-condition(condition, false)
check-statement(next)
. body-exits = !dead && narrowing.exits(body)
. next-exits = next != 0 && narrowing.exits(next)
if next-exits && !body-exits
    frame.restore-members(body-known)
else if !body-exits
    frame.merge-members(body-known)
if body-exits && !next-exits
    frame.forget-assignments(assigned-mark)
    =
. next-settled = frame.assigned-since(next-mark)
frame.pop-narrowing(next-mark)
if next-exits && !body-exits
    narrowing.narrow-condition(condition, true)
    frame.keep-assigned(body-settled)
else if next == 0 && !body-exits
    merge-assignments(condition, body, body-settled)
    widen-settled(body-settled)
else if !next-exits && !body-exits && !dead
    join-branches(condition, body, next, assigned-mark, split)
    widen-settled(body-settled)
    widen-settled(next-settled)
else if dead && !next-exits
    frame.keep-assigned(next-settled)
frame.forget-assignments(assigned-mark)

────────────────────
_ settled-now TypeId
    - key NarrowingKey

` What a key is known as where the type pass stands: the type of a local, or what a member
` or a path is narrowed to, which is no type for one that is not narrowed.
if is-member-key(key) then frame.held-member(key) else frame.slot-type(key)

────────────────────
_ do widen-settled
    - settled [Narrowed]

` After a region that may not have run, a key that an assignment in it left other than it is
` known now is known no longer: a local is what its declaration says, and a member or a path
` is not narrowed. What the paths through the region agree on is made known before this.
for row in settled
    . held = row.type
    . plain = no-type
    if !is-member-key(row.key)
        plain = slot-known(row.key)
        if held == no-type
            held = plain
    if held != settled-now(row.key)
        frame.push-assigned(row.key, plain)

────────────────────
_ do pop-conditional
    - mark ScratchMark

` Ends a region that runs under a condition, which is no statement of its own: what an
` assignment in it settled is known no longer where it differs from what was known before.
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
widen-settled(settled)

────────────────────
_ do join-branches
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId
    - mark Size
    - split Size

` After an `if` with an `else`, a local both branches leave as one type is that type: the
` branch that assigns it leaves what it assigned, and the other what the condition tells of it.
. other = next
do match? tree.nodes[next]
    | .node-if-block(row)
        if row.condition == 0
            other = row.body
. end = frame.assigned-syntax.length
. slots [SlotId]
for position in mark .. < end
    if slots.find(frame.assigned-slots[position]) == null
        slots += frame.assigned-slots[position]
for slot in slots
    . left = branch-end(slot, condition, true, body, mark, split)
    . right = branch-end(slot, condition, false, other, split, end)
    if left != no-type && left == right && left != frame.slot-type(slot)
        frame.push-assigned(slot-key(slot), left)

────────────────────
_ do branch-end TypeId
    - slot SlotId
    - condition SyntaxId
    - truth Bool
    - branch SyntaxId
    - from Size
    - to Size

` What a local is where a branch ends: what the branch's own statements last assigned it, or
` what the condition tells of it when nothing under the branch assigns it. No type when an
` assignment nested in the branch may or may not have run.
. last = no-type
. direct = 0
for position in from .. < to
    . written = frame.assigned-syntax[position]
    if frame.assigned-slots[position] == slot && is-direct-statement(branch, written)
        last = frame.assigned-types[position]
        direct += 1
. written = 0
for id in tree.subtree-start(branch) .. branch
    do match? tree.nodes[id]
        | .node-assign(row)
            . target = narrowing.condition-slot(row.lhs)
            if target && target == slot
                written += 1
if written != direct
    = no-type
if direct != 0
    = last
. probe = scratch.narrowings.mark
narrowing.narrow-condition(condition, truth)
. known = frame.slot-type(slot)
frame.pop-narrowing(probe)
= known

────────────────────
_ do never-holds Bool
    - condition SyntaxId
    - truth Bool

` Whether a condition can never take a truth value, because a type test in it asks a local
` for a type its own can never be. The reference compiles neither the branch such a condition
` guards nor the operand it short-circuits.
do match? tree.nodes[condition]
    | .node-type-predicate(row)
        = never-holds(row.expr, truth)
    | .node-unary-expression(row)
        if row.op == .not-op
            = never-holds(row.operand, !truth)
    | .node-binary-expression(row)
        if row.op == .and-op || row.op == .or-op
            . left = never-holds(row.lhs, truth)
            . right = never-holds(row.rhs, truth)
            = if (row.op == .and-op) == truth then left || right else left && right
        if is-type-test(row.op)
            . negated = is-negated-test(row.op)
            = negated != truth && impossible-test(row.op, row.lhs, row.rhs)
= false

────────────────────
_ is-negated-test Bool
    - op Operator

op == .is-not-op || op == .is-not-exactly-op || op == .is-not-similar-op

────────────────────
_ do impossible-test Bool
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

. subject = no-type
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        if resolution.kind == .resolve-slot
            subject = frame.slot-type(resolution.slot)
if subject == no-type || subject == invalid-type
    = false
. target = invalid-type
do match tree.nodes[rhs]
    | .node-symbol
        = false
    | .node-type-case
        = false
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    ??
        target = types.evaluate-type(module, tree, rhs, frame.env)
if target == invalid-type || types.completions[target].has-variables
    = false
= !could-match(subject, target, is-specificity(op))

────────────────────
_ is-specificity Specificity
    - op Operator

match op
    |= .is-exactly-op
        .exact
    |= .is-not-exactly-op
        .exact
    |= .is-similar-op
        .convertible
    |= .is-not-similar-op
        .convertible
    ??
        .similar

────────────────────
_ do could-match Bool
    - subject TypeId
    - target TypeId
    - kind Specificity

if types.completions[subject].has-variables
    = true
if relations.holds-as(relations.compare-pattern(subject, target), kind)
    = true
. intrinsic = types.intrinsic-of(subject)
if intrinsic == .optional
    = could-match(types.optional-inner(subject), target, kind)
if intrinsic == .table-row || intrinsic == .immutable-table-row
    = true
if intrinsic != .union
    = false
for fact in types.cases-of(subject)
    if fact.type != no-type && fact.type != invalid-type
        if relations.holds-as(relations.compare-pattern(fact.type, target), kind)
            = true
= false

────────────────────
_ do merge-assignments
    - condition SyntaxId
    - body SyntaxId
    - settled [Narrowed]

` After an `if` without an else whose body falls through and leaves an optional local holding
` a present value, the local stays present when the condition's false branch narrows it the
` same way: both paths agree, as the reference's flow facts merge them. What the body leaves a
` local as is what the last of its assignments settled, so a match whose arms that fall through
` agree counts, and an assignment in a nested branch that may not run, which was widened back,
` does not. A local that holds a union stays known to hold the case both paths leave it as.
. seen [NarrowingKey]
. position = settled.length
while position != 0
    position -= 1
    . row = settled[position]
    if is-member-key(row.key) || seen.find(row.key) != null
        continue
    seen += row.key
    . slot = row.key as SlotId
    if row.type == no-type || row.type == slot-known(slot)
        continue
    . probe = scratch.narrowings.mark
    narrowing.narrow-condition(condition, false)
    . narrowed = frame.slot-type(slot)
    . cases = frame.narrowed-cases(row.key)
    frame.pop-narrowing(probe)
    if narrowed == row.type
        frame.push-assigned(row.key, row.type, if cases == row.cases then cases else 0)

────────────────────
_ do is-direct-statement Bool
    - body SyntaxId
    - id SyntaxId

if body == id
    = true
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if statement == id
                = true
= false

────────────────────
_ do check-while
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId

frame.forget-members()
reset-assigned-paths(body)
note-poll()
loop-marks += scratch.narrowings.mark
tested-match = tested(condition)
. runs = if tested-match != 0 then condition else body
note-truthiness(condition, condition, infer-tested(condition))
tested-match = 0
. mark = scratch.narrowings.mark
narrowing.narrow-condition(condition, true)
loop-depth += 1
discarding-block = body
check-statement(body)
loop-depth -= 1
frame.pop-narrowing(mark)
widen-assigned(id, runs)

────────────────────
_ tested SyntaxId
    - condition SyntaxId

` The match a condition is, where `if` or `while` is written with a pattern: its arm runs
` the body, so what the body assigns is assigned under the condition. No node for any other
` condition.
match tree.nodes[condition]
    | .node-match-expression(row)
        if row.subject != 0 && !row.is-optional && !row.is-block then condition else 0
    ??
        0

────────────────────
_ do note-poll

` A loop polls on each pass, unless it is where no safepoint is allowed.
if (dispatch-effects(frame.surround.effects) /and/ CompilationEffect.no-safepoint) == 0
    instances.mark-polls(instance)

────────────────────
_ do reset-assigned-paths
    - body SyntaxId

if body == 0
    =
for id in tree.subtree-start(body) .. body
    do match? tree.nodes[id]
        | .node-assign(row)
            reset-target-paths(row.lhs)

────────────────────
_ do reset-target-paths
    - target SyntaxId

do match? tree.nodes[target]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, target)
        if resolution.kind == .resolve-slot
            frame.reset-stable-paths(slot-key(resolution.slot))
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            reset-target-paths(item)

────────────────────
_ do widen-assigned
    - loop SyntaxId
    - body SyntaxId

` A loop runs any number of times, so a local it assigns is afterwards what its declaration
` says, unless every assignment in the loop leaves it as it was known before the loop. What
` was known before the loop cannot be relied on in the body ahead of an assignment that
` breaks it: the body runs again after that assignment.
if body == 0
    leave-loop()
    =
for id in tree.subtree-start(body) .. body
    do match? tree.nodes[id]
        | .node-assign(row)
            . slot = narrowing.condition-slot(row.lhs)
            if !slot
                continue
            . declared = slot-known(slot)
            . settled = declared
            if row.op == .eq-op
                settled = assigned-narrowing(declared, facts.node-type(instance, row.rhs))
            . carried = frame.slot-type(slot)
            . typed = declared != no-type && declared != invalid-type
            if typed && settled != carried
                if carried != declared && relies-on(slot, id, row.lhs)
                    . name = identifier-name(tree, row.lhs)
                    . shown = if name then name.text else ""
                    . message = "Narrowing of '$shown' is used in the loop but does not hold when "
                    frame.diagnose(loop, .stated, program.store-atom(message ++ "the loop repeats"))
                frame.push-assigned(slot-key(slot), declared)
leave-loop()

────────────────────
_ do relies-on Bool
    - slot SlotId
    - assignment SyntaxId
    - target SyntaxId

` Whether the innermost loop reads a local as what was known of it before the loop, ahead of
` an assignment to it.
. loop = loop-marks.length - 1
for position in 0 .. < carried-sites.length
    . site = carried-sites[position]
    if carried-slots[position] == slot && carried-loops[position] == loop
        if site < assignment && site != target
            = true
= false

────────────────────
_ do note-carried
    - id SyntaxId
    - slot SlotId

` Notes a read of a local that relies on what was known of it before a loop around the read
` began: nothing in the loop has told more of it since. The body of a `do @no-gc` block notes
` a read of a local it captures for the function around it, where it runs.
if outer && frame.is-captured(slot) && in-zone-body
    outer.note-carried(id, slot)
    =
if loop-marks.length == 0 || (outer && frame.is-captured(slot))
    =
if frame.slot-type(slot) == frame.known(slot)
    =
for index in 0 .. < loop-marks.length
    if scratch.narrowed-since(loop-marks[index], slot-key(slot)) == no-type
        carried-slots += slot
        carried-loops += index
        carried-sites += id

────────────────────
_ do forget-carried
    - id SyntaxId

` A test of whether a local holds a value relies on nothing known of it.
if carried-sites.length == 0
    =
. kept = 0
for position in 0 .. < carried-sites.length
    if carried-sites[position] != id
        carried-slots[kept] = carried-slots[position]
        carried-loops[kept] = carried-loops[position]
        carried-sites[kept] = carried-sites[position]
        kept += 1
-= carried-slots[kept .. < carried-slots.length]
-= carried-loops[kept .. < carried-loops.length]
-= carried-sites[kept .. < carried-sites.length]

────────────────────
_ do leave-loop

. loop = loop-marks.length - 1
. kept = 0
for position in 0 .. < carried-sites.length
    if carried-loops[position] != loop
        carried-slots[kept] = carried-slots[position]
        carried-loops[kept] = carried-loops[position]
        carried-sites[kept] = carried-sites[position]
        kept += 1
-= carried-slots[kept .. < carried-slots.length]
-= carried-loops[kept .. < carried-loops.length]
-= carried-sites[kept .. < carried-sites.length]
loop-marks.pop()

────────────────────
_ do infer-found Found
    - id SyntaxId
    - want Want = Want()

` A node typed as `infer` types it, with what else typing it found (`Found`).
if id == 0
    = Found(no-type)
. found = found-node(id, want)
settle-typed(id, found.type)
= found

────────────────────
_ do settle-typed TypeId
    - id SyntaxId
    - inferred TypeId

` Keeps the type a node was found to have, where it has one, and ends what is known of
` properties where the node may change them (`unsettles`).
if frame.members-narrowed && unsettles(id)
    frame.doubt-members()
if inferred != no-type
    facts.set-node-type(instance, id, inferred)
= inferred

────────────────────
_ do found-node Found
    - id SyntaxId
    - want Want

` What typing a node finds, of the nodes that may find more than their type: names, reads of
` members, indexes and calls, which may be links of an optional chain or name events. Any other
` node finds its type alone.
do match? tree.nodes[id]
    | .node-identifier(row)
        note-plain(id, row.name)
        if row.is-tracked
            . tracked = infer-tracked-name(id, row.name, want)
            = tracked.typed(note-collection-read(id, tracked.type, want))
        = infer-identifier(id, row.name, want)
    | .node-call-expression(row)
        = infer-call(id, row.callable, row.params, row.args, row.is-curried, 0, no-type, want)
    | .node-get-expression(row)
        . got = infer-get(id, row.object, row.name, row.is-optional, want)
        if !row.is-tracked && !row.is-optional && got.type != invalid-type
            plan-array-field(id, row.object, row.name)
        if row.is-tracked && got.type != invalid-type
            note-collection-read(id, got.type, want)
            track-root(row.object)
            . held = facts.node-type(instance, row.object)
            track-read
                - id
                - if types.is-optional(held) then types.optional-inner(held) else held
                - row.name
        = got
    | .node-index-expression(row)
        = infer-index(id, row.object, row.index, row.is-optional, want)
    | .node-markup-read-expression(row)
        = infer-markup-read(id, row)
    | .node-style-read-expression(row)
        = infer-style-read(id, row)
= Found(infer-node(id, want))

────────────────────
_ do found-event U32
    - event NamedEvent

` Keeps an event a node names for what typed it to take (`Found.event`).
found-events += event
= (found-events.length - 1) as U32

────────────────────
_ found-event-of NamedEvent?
    - found Found

` The event a node was found to name, or none.
if found.event != U32.max then found-events[found.event] else null

────────────────────
_ do unsettles Bool
    - id SyntaxId

` Whether a node, once its parts are typed, does something that may end what the reference
` knows of a property where this pass keeps it. The reference forgets at every call it
` emits but a probe's, also the ones no source writes. This pass forgets at the calls it
` settles, and the frame sees the calls and conversions it records. What does none of these is
` listed here:
` among them a literal string or a nested function made, which the reference makes in place,
` a cast, whose conversion the frame sees, unless it is one under `catch` that gives an error
` where it fails, a `!` of what the flow knows holds a value, which the reference takes as it
` is, `type-of`, arithmetic the reference makes in place, division too, a comparison it makes
` in place (`compares-in-place`), also of optionals whose flags it tests around such a
` comparison of what they hold, a read of a field of a tuple or a struct by a constant index,
` a read or a write of a style, which ends what is known of properties as a call does, a call
` the compiler answers with no call of its own (`answers-in-place`), and a store to a property
` of an object read from a local or the receiver, which ends what the reference ends
` (`forget-store-root`). Anything else leaves the two in doubt, and a property
` read in doubt is declined.
do match? tree.nodes[id]
    | .node-integer-syntax
        = false
    | .node-cast-expression
        = facts.plan-of(instance, id) == .plan-caught-cast
    | .node-function-syntax
        = false
    | .node-float-syntax
        = false
    | .node-string-syntax
        = false
    | .node-identifier
        = false
    | .node-get-expression
        = false
    | .node-index-expression
        = facts.plan-of(instance, id) != .plan-field && !facts.answers-in-place(instance, id)
    | .node-style-read-expression
        = false
    | .node-tuple-syntax
        = false
    | .node-optional-chain
        = false
    | .node-type-predicate
        = false
    | .node-block
        = false
    | .node-assertion-syntax
        = false
    | .node-match-expression
        = false
    | .node-structure-match
        = false
    | .node-call-expression
        = !facts.answers-in-place(instance, id)
    | .node-binary-expression(row)
        if (row.op == .is-op || row.op == .is-not-op) && tree.nodes[row.rhs] is .node-symbol
            = false
        . branches = short-circuits || row.op == .if-op || row.op == .else-op
            .. short-circuits = row.op == .and-op || row.op == .or-op || row.op == .coalesce-op
        . plan = facts.plan-of(instance, id)
        . compared = if plan == .plan-held then facts.held-of(instance, id).plan else plan
        = !branches && compared != .plan-builtin && !compares-in-place(compared)
    | .node-unary-expression(row)
        if row.op == .optional-force-op && !types.is-optional(operand-type)
            = false
        .. operand-type = facts.node-type(instance, row.operand)
        if row.op == .type-of-op
            = false
        = row.op != .not-op && facts.plan-of(instance, id) != .plan-builtin
    | .node-assign(row)
        do match? tree.nodes[row.lhs]
            | .node-identifier
                . kind = bindings.resolution-of(frame.binding, row.lhs).kind
                = kind != .resolve-slot && kind != .resolve-member
            | .node-get-expression
                = settled-store != id
            | .node-style-read-expression
                = false
= true

────────────────────
_ compares-in-place Bool
    - plan OperatorPlan

` Whether a comparison is one the reference makes with no call of its own: of tuples, structs
` or unions field by field, of objects or atoms by identity, of an optional with `null`, of
` values never equal, or a test of an object's class. The calls a field-by-field comparison
` makes are recorded, and the frame sees them.
structural || plan == .plan-absent || plan == .plan-unlike || plan == .plan-class-test

.. structural = plan == .plan-fields || plan == .plan-not-fields || plan == .plan-identity

────────────────────
_ is-typed-name Bool
    - pattern SyntaxId

` Whether what a declaration declares is one name with the type written for it, which the
` declaration matches as `matches-in-place` says.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type != 0 && !reads-name(row.type)
    ??
        false

────────────────────
_ is-plain-name Bool
    - pattern SyntaxId

` Whether what a declaration declares is one name, with no type and no pattern.
match tree.nodes[pattern]
    | .node-identifier
        true
    | .node-type-capture(row)
        row.type == 0
    ??
        false

────────────────────
_ do infer-latest TypeId
    - id SyntaxId
    - value SyntaxId

` The latest item of a stream, `##` of it, as the reference reads it in a live action: the
` stream is made a `Broadcastable` where it is written, cast where it supports one and given
` to `publisher` where it only iterates, either converted at the stream's own node, apart from
` what converts the item where it is read, and a `BroadcasterTracker` is made of it and the empty
` value of its item, recorded at the node, which converts it to a `Tracker` there for the
` trackers of the action. The local the node declares keeps it for the function that runs the
` action again, which reads its `latest`. The node has the item's type. The statement it is
` read in runs in a live action as one a tracked read is in does. An event made a stream, and
` a read in any other live action, have no shape here.
demand-live-runtime()
. given = infer(value)
if given == invalid-type || given == no-type
    = invalid-type
if types.broadcastable-decl.module == 0
    decline(id)
    = invalid-type
. stream = supported(given, types.broadcastable-decl)
. mark = scratch.types.mark
. publisher = no-instance
if stream == no-type && !iterates(given)
    . shown = type-display(types, given)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Object is not a broadcastable or iterable: $shown")
        - given
    = invalid-type
if stream == no-type
    scratch.types.push(given)
    publisher = calls.demand-runtime-call
        - types.broadcastable-decl.module
        - no-type
        - program.store-atom("publisher")
        - mark
    scratch.types.rewind(mark)
    if publisher == no-instance
        decline(id)
        = invalid-type
    conversions.convert
        - value
        - value
        - given
        - instances.argument-type(publisher, 0)
        - .reason-argument
    do facts.record-call(instance, id, publisher, .call-function, scratch.no-fills, false)
    stream = instances.signatures[publisher].returns
else
    conversions.convert(value, value, given, stream, .reason-argument)
. item = first-arg(stream)
. tracking = if item != no-type then types.well-known-type-of("core/tracker", "BroadcasterTracker", item) else invalid-type
. tracker = types.well-known-type("core/tracker", "Tracker")
if tracking == invalid-type || tracker == invalid-type || instances.live.add-tracker == no-instance
    decline(id)
    = invalid-type
scratch.types.push(stream)
scratch.types.push(item)
. made = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if made == no-instance
    decline(id)
    = invalid-type
. kept = instances.signatures[made].returns
conversions.convert(id, id, kept, tracker, .reason-argument)
facts.latest-reads += LatestRead(instance, id, stream, made, publisher)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, kept)
instances.mark-may-panic(instance)
if frame.declaration.kind != .live-decl
    if live-context(read-site(id)) != .live-statement
        decline(id)
        = invalid-type
    note-live-statement(read-site(id))
= item

────────────────────
_ do infer-held TypeId
    - id SyntaxId
    - expr SyntaxId

` The middle of a chain of orderings has the type of its expression, which its slot keeps for
` the ordering that reads it.
. held = infer(expr)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, held)
= held

────────────────────
_ do infer-held-read TypeId
    - id SyntaxId

` The ordering after the middle of a chain reads the type the middle's slot keeps. A read
` that no middle was held for is declined.
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind != .resolve-slot
    decline(id)
    = invalid-type
= frame.slot-type(resolution.slot)

────────────────────
_ do infer-node TypeId
    - id SyntaxId
    - want Want

do match tree.nodes[id]
    | .node-integer-syntax(row)
        = infer-integer(id, row.value, row.unit)
    | .node-float-syntax(row)
        = if row.unit then infer-unit-float(id, row.value, row.unit) else types.f64-type
    | .node-symbol(row)
        if id == arm-typing.symbol
            = infer-armed-symbol(id, row.name)
        = infer-symbol(id, row.name)
    | .node-string-syntax
        = types.string-type
    | .node-identifier
        = found-node(id, want).type
    | .node-call-expression
        = found-node(id, want).type
    | .node-binary-expression(row)
        = infer-binary(id, row.op, row.lhs, row.rhs, armed-want(id, want))
    | .node-unary-expression(row)
        = infer-unary(id, row.op, row.operand)
    | .node-held-expression(row)
        = infer-held(id, row.expr)
    | .node-held-read
        = infer-held-read(id)
    | .node-latest-expression(row)
        = infer-latest(id, row.expr)
    | .node-use-expression(row)
        = check-use(id, row.expr)
    | .node-catch-optional-expression(row)
        = infer-catch-optional(id, row.body)
    | .node-catch-expression(row)
        = infer-catch(id, row.body, row.is-raw-result, row.catchers, want)
    | .node-cast-expression(row)
        = infer-cast(id, row.lhs, row.rhs)
    | .node-range-expression(row)
        = infer-range(id, row.op, row.left, row.right, row.increment)
    | .node-tuple-syntax(row)
        = infer-tuple(row.items)
    | .node-header-expression(row)
        = infer-header(id, row.expr, row.items)
    | .node-c-identifier(row)
        . constant = program.c-constant-text(module, row.name)
        if constant
            = infer-integer(id, constant, null)
        . bound = calls.c-binding(row.name)
        if bound == no-type
            frame.diagnose(id, .function-not-found, row.name)
            = invalid-type
        = bound
    | .node-list-syntax(row)
        = infer-list(id, row.items, want)
    | .node-get-expression
        = found-node(id, want).type
    | .node-print(row)
        = infer-print(id, row.body)
    | .node-match-expression(row)
        if is-region(id)
            decline(id)
            = invalid-type
        = infer-match(id, row.subject, row.body, row.is-optional, row.helper, row.is-block, want)
    | .node-stream-match(row)
        = infer-stream-match(id, row.pattern, row.is-root)
    | .node-structure-match(row)
        = infer-arms(id, row.pattern, want)
    | .node-assign(row)
        . assigned = infer-assign(id, row.op, row.lhs, row.rhs, want)
        if assigned != invalid-type && facts.live-statements.length != 0
            settle-live-statement(id, row.lhs, row.rhs, facts.node-type(instance, row.rhs))
        = assigned
    | .node-property-syntax(row) { frame.declaration.is-content || frame.declaration.kind == .live-decl }
        = infer-content-property(id, row.value, want)
    | .node-optional-chain(row)
        = infer(row.expr)
    | .node-type-predicate(row)
        = infer(row.expr)
    | .node-block(row)
        . diagnosed = facts.diagnostics.length
        . valued = check-block(id, row.body, false)
        if valued == no-type && facts.diagnostics.length == diagnosed
            . printed = final-print(id)
            if printed != 0
                frame.diagnose(printed, .stated, program.store-atom(print-block-text()))
            else
                frame.diagnose(id, .stated, program.store-atom("Illegal statement"))
            = invalid-type
        = valued
    | .node-function-syntax
        = closure-type(id)
    | .node-do-task-block(row)
        if row.worker != 0 && !row.is-parallel
            check-worker(id, row.worker)
        frame.doubt-members()
        check-task(id)
        = calls.demand-task-value(id)
    | .node-type-identifier
        . named = types.evaluate-type(module, tree, id, frame.env)
        if named == invalid-type && report-missing-type(id, frame.env)
            = invalid-type
        = type-info-of(id, named)
    | .node-core-type-identifier
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-assertion-syntax(row)
        check-assertion(id, row.exception, row.condition)
        if row.condition == 0
            facts.mark-leaving(instance, id)
        = no-type
    | .node-ref-identifier(row)
        . referred = infer-identifier(id, row.name, want).type
        if referred == types.void-type
            frame.diagnose(id, .stated, program.store-atom("Void has no physical address"))
            = invalid-type
        = pointer-to(referred)
    | .node-index-expression
        = found-node(id, want).type
    | .node-iterator-expression(row)
        = infer-comprehension(id, row.loop, row.body, row.next)
    | .node-iterable-expression(row)
        = infer-stream(id, row.expr)
    | .node-argument(row)
        = infer-argument-value(id, row)
    | .node-bullet-expression
        = infer-bullets(id, 0)
    | .node-pipeline-expression(row)
        = infer-pipeline(id, row.op, row.left, row.right)
    | .node-anonymous-case(row)
        = infer-anonymous-case(id, row.name, row.args, row.owner)
    | .node-type-arguments
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-type-associated
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-pattern-helper-syntax
        frame.diagnose
            - id
            - .stated
            - program.store-atom("with helper must be the first clause of a stream match")
        = invalid-type
    | .node-markup(row)
        = infer-markup(id, row, want)
    | .node-slot-outlet(row)
        = infer-outlet(id, row)
    | .node-markup-read-expression
        = found-node(id, want).type
    | .node-style-read-expression
        = found-node(id, want).type
    | .node-style-property-expression(row)
        = infer-style-property(id, row)
    | .node-style-when
        frame.diagnose
            - id
            - .stated
            - program.store-atom("\"when\" state branches are only allowed in style rule bodies")
        = invalid-type
    | .node-state-machine
        = check-machine-site(id)
    ??
        decline(id)
        = invalid-type

────────────────────
_ do infer-markup-read Found
    - id SyntaxId
    - row ASTMarkupReadExpression

` A read of a markup link, `%parent`, `%first-child`, `%last-child`, `%previous-sibling` or
` `%next-sibling`, of an object or of `this` whose class is a markup host: the optional of the
` host the markup runtime links it to. Where the class is a tree host of a concrete class of
` children, a child read gives that class, and so do a parent and a sibling read where the
` subject is one; else a sibling read gives the subject's class, and any other the host. The
` link is the host's object taken as that class, unchecked, as the reference takes it. A read
` written after `?` reads from what the optional before it holds, as a read of a member does. A
` link given as an interface has no shape here.
. name = row.name.text
. reader = "markup-structural-${name}-host"
if name != "parent" && name != "first-child" && name != "last-child" && no-sibling
    frame.diagnose(id, .stated, program.store-atom("Markup link \"%$name\" not found"))
    = Found(invalid-type)
.. no-sibling = name != "previous-sibling" && name != "next-sibling"
. subject = no-type
if row.object != 0
    if optional-chain-expr(row.object) != 0
        decline(id)
        = Found(invalid-type)
    . object-found = infer-found(row.object)
    . object = object-found.type
    . own = object-found.link
    if object == invalid-type
        = Found(invalid-type)
    . form = if row.is-optional then note-chain(id, id, object) else ChainForm.chain-plain
    if form == .chain-absent || absent-after(row.object, object)
        = Found(types.null-type)
    . optional = form == .chain-tested
    subject = link-receiver(row.object, object, own, optional)
    if optional
        facts.unwrapped.append(UnwrappedFact(instance, row.object, subject))
else
    subject = frame.self-type
if subject == no-type
    frame.diagnose(id, .stated, program.store-atom("Markup link \"%$name\" not found"))
    = Found(invalid-type)
if types.is-optional(subject)
    decline(id)
    = Found(invalid-type)
. host-decl = types.markup-host-decl
. host = if hostable then derived-interface(subject, host-decl) else no-type
    .. hostable = subject != no-type && (host-decl.module != 0 || host-decl.decl != 0)
if host == no-type
    frame.diagnose(id, .stated, program.store-atom("Markup link \"%$name\" not found"))
    = Found(invalid-type)
if types.intrinsic-of(subject) != .class && subject != host
    decline(id)
    = Found(invalid-type)
. tree = if tree-host then derived-interface(subject, types.markup-tree-host-decl) else no-type
    .. tree-host = types.markup-tree-host-decl.module != 0 || types.markup-tree-host-decl.decl != 0
. child = if tree != no-type then first-arg(tree) else no-type
. concrete = child != no-type && !types.completions[child].has-variables
. target = no-type
if name == "first-child" || name == "last-child"
    target = if concrete then child else no-type
else if concrete && derived-interface(subject, class-ref(types, child)) == child
    target = child
else if name == "previous-sibling" || name == "next-sibling"
    target = if !types.completions[subject].has-variables then subject else no-type
if target == host
    target = no-type
if target != no-type && types.intrinsic-of(target) != .class
    decline(id)
    = Found(invalid-type)
. mark = scratch.types.mark
scratch.types.push(host)
. read = calls.demand-runtime-call(host-decl.module, no-type, program.store-atom(reader), mark)
scratch.types.rewind(mark)
if read == no-instance
    decline(id)
    = Found(invalid-type)
conversions.convert(id, if row.object != 0 then row.object else id, subject, host, .reason-argument)
facts.markup-reads += MarkupRead(instance, id, read, target)
. link = types.optional-of(if target != no-type then target else host)
= Found(link).linking(link)

────────────────────
_ do infer-markup TypeId
    - id SyntaxId
    - row ASTMarkup
    - want Want = Want()

` A markup element: an object of its class, whose body runs with each of its lines as
` content of the object. A line that gives a value is taken by the element: by its `+=`, or
` else by its `++=`. An `if` and a `for` written as lines run their bodies as content of the
` same element; a `do` block runs as it would anywhere. The object of an element a block
` declares a name for was made where that block starts, and the name holds it, but where the
` name is placed (`is-placed`): the object is made here and the name given it, which a
` function written in another may not do. An element written with a name no block declares,
` where the name is one something else declared, is that thing's value to the reference and
` makes no object: it is declined, but where that is the property the markup of the class
` declares for the element (`names-content-property`), whose object is made here and given to
` the property once the line has run. A name placed so that the function building a slot an
` element is given declares it in a function the slot is written in is given the object
` there, as the reference's builder writes the local it captures (`places-across`). What
` makes a placed element reads its name only in a function of its own: read anywhere else, the
` name is the reference's error. An
` element that binds a slot is made only by the function
` that builds the slot; written as a line anywhere else it is the reference's error. An
` element of a markup host runs under the batch of markup in force, as `batch-element` says.
if row.slot-binding != 0 && !builds-slot(id)
    if want.asks(.want-content-line)
        frame.diagnose
            - row.slot-binding
            - .stated
            - program.store-atom("Slot binding is only valid directly inside markup body")
    else
        decline(id)
    = invalid-type
. slot = element-slot(id, row.id)
if row.id != 0 && !slot
    . resolution = bindings.resolution-of(frame.binding, row.id)
    . found = resolution.kind != .resolve-unresolved && resolution.kind != .resolve-none
    if (found && !names-content-property(id, row.id)) || received
        decline(id)
        = invalid-type
    .. received = (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
. placed = slot && is-placed(slot)
if placed && frame.is-captured(slot!) && !places-across(slot!)
    decline(id)
    = invalid-type
. made = if slot && !placed then frame.slot-type(slot) else no-type
if placed
    . first = unbuilt.length
    . around = building
    unbuilt += slot!
    awaited += 0
    building = slot!
    made = make-element(id, row)
    building = around
    while unbuilt.length > first
        unbuilt.pop()
        awaited.pop()
else if !slot
    made = make-element(id, row)
if made == invalid-type || made == no-type
    = invalid-type
if placed
    assign-placed(slot!, made)
if !keep-element(id, made)
    decline(id)
    = invalid-type
. rooted = batch-element(id, row, made, want.asks(.want-content-line))
if row.body != 0 && !wraps-default(row.body)
    . styled = markup-styles.length
    if program.module-by-name("core/style") && !add-visible-styles(made, markup-styles, id)
        = invalid-type
    . sheeted = markup-sheets.length
    if program.module-by-name("core/style")
        if markup-sheets.length == 0
            add-sheet-groups(frame.self-type, markup-sheets, sheet-levels)
        add-sheet-groups(made, markup-sheets, sheet-levels)
    . scoped = rule-scopes.length
    push-body-scopes(id)
    content-blocks += row.body
    content-parents += made
    content-names += false
    element-bodies += row.body
    batched += rooted
    check-statement(row.body)
    batched.pop()
    content-blocks.pop()
    content-parents.pop()
    content-names.pop()
    element-bodies.pop()
    while rule-scopes.length > scoped
        rule-scopes.pop()
    while markup-styles.length > styled
        markup-styles.pop()
    while markup-sheets.length > sheeted
        markup-sheets.pop()
        sheet-levels.pop()
= made

────────────────────
_ do batch-element Bool
    - id SyntaxId
    - row ASTMarkup
    - made TypeId
    - linked Bool

` Whether a batch of markup is in force in the body of a markup element: the element itself
` where its class is a batch, else the one in force where the element is written. An element
` of a markup host under one whose body gives it content (`gives-default`) is put under the
` batch by the markup runtime's `ensure-markup-root` before its body runs, and one that is no
` line of another element is mounted as a root of the batch by `markup-mount-root` once it is
` made, as the reference does, but for one the function that builds a row of a markup loop
` region or what a line gives a slot makes, which the reference builds with both put off. An
` element that is a batch is converted to the `MarkupRootElement` what is made under it is put under.
. owns = is-batch(made)
. rooted = owns || in-batch()
if !rooted
    = false
. root = ElementRoot(instance, id, no-instance, no-instance, owns)
. batch = batch-type()
if owns
    conversions.convert(row.type-id, row.type-id, made, batch, .reason-markup-batch)
. bodied = gives-default(row.body)
if is-markup-host(made) && !defers-roots() && (bodied || !linked)
    . markup = types.markup-host-decl.module
    . host = derived-interface(made, types.markup-host-decl)
    . optional = types.optional-of(batch)
    . mark = scratch.types.mark
    scratch.types.push(host)
    scratch.types.push(optional)
    if bodied
        root.ensure = calls.demand-runtime-call
            - markup
            - no-type
            - program.store-atom("ensure-markup-root")
            - mark
    if !linked
        root.mount = calls.demand-runtime-call
            - markup
            - no-type
            - program.store-atom("markup-mount-root")
            - mark
    scratch.types.rewind(mark)
    if (bodied && root.ensure == no-instance) || (!linked && root.mount == no-instance)
        decline(id)
        = rooted
    conversions.convert(row.type-id, row.type-id, made, host, .reason-markup-host)
    conversions.convert(row.type-id, row.type-id, batch, optional, .reason-markup-root)
if owns || root.ensure != no-instance || root.mount != no-instance
    facts.element-roots += root
= rooted

────────────────────
_ defers-roots Bool

` Whether the function being typed builds markup with its roots neither put under the batch in
` force nor mounted: one that builds a row of a markup loop region or what a line gives a slot,
` as the reference builds them.
frame.declaration.kind == .row-decl || frame.declaration.kind == .slot-decl

────────────────────
_ is-batch Bool
    - type TypeId

` Whether objects of a type are batches of markup.
if batch-declared then derived-interface(type, types.markup-batch-decl) != no-type else false

.. batch-declared = types.markup-batch-decl.module != 0 || types.markup-batch-decl.decl != 0

────────────────────
_ in-batch Bool

` Whether a batch of markup is in force where content is being typed.
batched.length != 0 && batched[batched.length - 1]

────────────────────
_ batch-type TypeId

` The `MarkupRootElement` of the markup runtime.
types.well-known-type("core/markup", "MarkupRootElement")

────────────────────
_ do make-element TypeId
    - id SyntaxId
    - row ASTMarkup

` The object of a markup element, made by the constructor its arguments choose. An argument
` whose parameter has the name of a property of the class is stored in that property once
` the object is made, as the reference binds the two.
` An attribute whose value reads something tracked is given again by a function of its own.
` An attribute that names a property of a style the element sees is a style declaration
` (`declare-styles`), after the style rules the element applies (`apply-style-rules`). An
` element whose body gives slots content gives its constructor the functions that build them
` (`supply-slots`). The constructor of a class whose markup is its content is one of its own
` for the styles and style sheets the element sees (`element-context`). The rules written in
` rules that the element's style rules bring into view are gathered first, for the class
` written, as the reference prepares them (`gather-scopes`); an element whose object is of
` another class is declined then. One whose class takes its content through the markup protocol
` or builds content of its own is declined, and so is a body that tracks what it reads
` elsewhere. The local that keeps the object for the functions of its body that read its members
` holds the class written while the body is typed (`keep-element`).
if !is-plain-body(row.body)
    decline(id)
    = invalid-type
types.clear-fault()
. class = types.evaluate-type(module, tree, row.type-id, frame.env)
if class == invalid-type
    if !report-circular() && !report-fault(row.type-id)
        frame.diagnose(row.type-id, .stated, program.store-atom("Type not found"))
    = invalid-type
. reported = facts.diagnostics.length
. scoping = may-scope(class, row)
if scoping
    . names [Atom]
    for name in implicit-names(class, row.type-id, row.id, tree)
        names += program.store-atom(name)
    . gathered [ScopeUse]
    if !gather-scopes(class, names, row.style-rule-applications, id, class, gathered, tree)
        decline(id)
        = invalid-type
    record-scopes(id, gathered)
. names-mark = scratch.names.mark
. builders-mark = scratch.types.mark
if !supply-slots(id, row.body, class)
    scratch.names.rewind(names-mark)
    scratch.types.rewind(builders-mark)
    = invalid-type
. slots = scratch.names.since(names-mark)
. builders = scratch.types.since(builders-mark)
. context = element-context(class, id)
if context == U32.max - 1
    scratch.names.rewind(names-mark)
    scratch.types.rewind(builders-mark)
    = invalid-type
do keep-element(id, class)
. made = infer-call(id, row.type-id, RowRange'SyntaxId(), row.args, false, row.body, class, Want(), slots, builders, context).type
scratch.names.rewind(names-mark)
scratch.types.rewind(builders-mark)
if made == invalid-type || made == no-type
    = invalid-type
if !fills-constructor(id, row, made)
    = invalid-type
if !accepts || (has-attributes(row.body) && made != class) || (scoping && made != class)
    decline(id)
    = invalid-type
.. accepts = takes-lines(made) || takes-hosted(made) || (holds-slot(made) && is-markup-host(made))
if !check-cells(id, id, made, true)
    = invalid-type
. outer-prepared = preparing
preparing = preparing.site = id
. applied = apply-style-rules(id, made, row)
preparing = outer-prepared
if applied == U32.max || !declare-styles(id, made, row.body, applied)
    = invalid-type
if !store-attributes(id, made, row.args, row.body) || !store-arguments(id, made, row.args)
    if facts.diagnostics.length == reported
        decline(id)
    = invalid-type
settle-attributes(row.body, made, row.type-id)
settle-arguments(id, row.args, made, row.type-id)
= made

────────────────────
_ do fills-constructor Bool
    - id SyntaxId
    - row ASTMarkup
    - made TypeId

. fact = facts.latest-call(instance, id)
if fact == no-fact || facts.calls[fact].callee == no-instance
    = true
. callee = instances.rows[facts.calls[fact].callee]
do match? program.modules[callee.module].decls[callee.decl]
    | .decl-function(fn)
        if fn.kind != .default-constructor-decl
            = true
. given [Atom]
do match? tree.nodes[row.body] if row.body != 0
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    . name = identifier-name(tree, attribute.lhs)
                    if name
                        given += name
. count = 0
. wanted Atom? = null
. ref = class-ref(types, made)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(class)
        if class.members.count != 0
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-function(fn)
                        if fn.kind == .constructor-decl && !fn.is-generated
                            count += 1
                            . fills = true
                            for shape in owner.arg-pool[fn.args]
                                if !shape.has-default && ungiven
                                    fills = false
                                    if !wanted
                                        wanted = shape.name
                                .. ungiven = !shape.name || given.find(shape.name) == null
                            if fills
                                = true
if count == 0
    = true
. shown = type-source(types, made)
. message = "Markup element <$shown gives none of the arguments the constructors of $shown require"
if count == 1 && wanted
    message = "Markup element <$shown gives no value for \"${wanted.text}\", which the constructor of $shown requires"
. named = identifier-name(tree, row.id) if row.id != 0
if named
    message = "$message; \"${named.text}\" after <$shown names the element"
frame.diagnose(row.type-id, .stated, program.store-atom(message))
= false

────────────────────
_ do settle-attributes
    - body SyntaxId
    - made TypeId
    - type-id SyntaxId

` Types the function that gives again each attribute of a markup element whose value read
` something tracked, once the element's object is typed, as the reference makes it: the
` local no name reaches that keeps the object for it, declared at the attribute, holds one of
` the element's class, and the action is made as `owner-action` says, or for a style the
` attribute declares is the style runtime's `StyleDynamicAction` of the class. The local holds
` one also where the value read nothing tracked after all, as where a name the module builder
` took for one of a keyed row's is a member of an element around it, and nothing gives it again.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if tree.nodes[statement] is .node-assign && is-live-statement(statement)
                . kept = bindings.resolution-of(frame.binding, statement)
                if kept.kind == .resolve-slot
                    frame.assign(kept.slot, made)
            . position = facts.live-statements.length
            while position != 0
                position -= 1
                . live = facts.live-statements[position]
                if live.instance != instance || live.site != statement || live.rerun != no-instance
                    continue
                . resolution = bindings.resolution-of(frame.binding, statement)
                if resolution.kind != .resolve-slot
                    decline(statement)
                    =
                . styled = facts.style-declaration-of(instance, statement) != null
                . owned InstanceId? = null
                if styled
                    owned = demand-style-gates(made)
                else
                    owned = owner-action(statement, made, type-id)
                if !owned
                    =
                frame.assign(resolution.slot, made)
                . rerun = demand-lambda(intern-nested(nested-decl-of(statement)), scratch.no-types)
                if rerun == no-instance || instances.signatures[rerun].errors.count != 0
                    decline(statement)
                    =
                instances.mark-may-panic(instance)
                facts.live-statements[position] = LiveStatement
                    - instance
                    - statement
                    - rerun
                    - 0
                    - U32.max
                    - owned
                    - !styled && owned != no-instance && owns-batch(made)
                break

────────────────────
_ do settle-content
    - statement SyntaxId
    - parent TypeId
    - produced TypeId

` Types the function that gives a line of a markup element's body again where its value read
` something tracked, once the element has taken it, as the reference makes it: an element of a
` markup host that absorbed the value by its `markup-absorb` absorbs it again, and one that took
` it another way replaces what it took (`replace-again`). The local no name reaches that keeps
` the element's object, declared at the line, holds one of the element's class, the one after it
` what the element took, and the action is made as `owner-action` says. A line of the body of an
` arm of a region is given so to what the arm's function is given, converted at the line.
. position = facts.live-statements.length
while position != 0
    position -= 1
    . live = facts.live-statements[position]
    if live.instance != instance || live.site != statement || live.rerun != no-instance
        continue
    . link = facts.content-link-of(instance, statement)
    . kept = line-keeper(statement)
    . absorbed = link != U32.max && is-markup-host(parent) && unappended && link-called
        .. unappended = facts.content-links[link].append == no-instance
        .. link-called = facts.content-links[link].call != no-fact
    . replaced = if absorbed || link == U32.max then no-type else taken-type
        .. taken-type = content-taken(facts.content-links[link], produced)
    if (!absorbed && replaced == no-type) || kept == no-slot
        decline(statement)
        =
    . type-id SyntaxId = statement
    do match? tree.nodes[tree.content-element(statement)]
        | .node-markup(row)
            type-id = row.type-id
    . owned = owner-action(statement, parent, type-id)
    if !owned
        =
    frame.assign(kept, parent)
    frame.assign(kept + 1, if absorbed then types.void-type else replaced)
    . rerun = demand-lambda(intern-nested(nested-decl-of(statement)), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(statement)
        =
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement
        - instance
        - statement
        - rerun
        - 0
        - U32.max
        - owned
        - owned != no-instance && owns-batch(parent)
    =

────────────────────
_ line-keeper SlotId
    - line SyntaxId

` The local no name reaches that keeps the object of the element a line of content is given to,
` declared at the line and found by its name, since the line may be a name its node resolves;
` the one after it keeps what the element took.
bindings.declared-at(frame.slots, line, program.store-atom("(element)"))

────────────────────
_ content-taken TypeId
    - row ContentLink
    - produced TypeId

` What a markup element took of a line of its body, which a function that gives the line again
` replaces: the node the markup runtime linked for a markup host, else what the element's
` method answered, or the value where it answers nothing, as the reference keeps it.
|? row.call == no-fact
    no-type
|? row.append != no-instance
    instances.argument-type(row.append, 1)
??
    if answered == types.void-type then produced else answered

.. answered = instances.signatures[facts.calls[row.call].callee].returns

────────────────────
_ do replace-again Bool
    - statement SyntaxId
    - made TypeId
    - previous TypeId

` Types a line of a markup element's body that a live action gives the element again in place
` of what it took before, kept where the element was made, as the reference's replacer gives it:
` a markup host makes the value its node by its `markup-content`, which the markup runtime's
` `markup-replace` puts in place of the one before; another element's `replace` is given the
` one before and the value, and what it answers, or the value where it answers nothing, is kept
` in place of the one before. That is then closed by its `close`, or where it has none, each
` live action it owns is. What is kept is of the type of what was kept before.
content-blocks += 0
content-parents += made
content-names += false
. produced = infer(statement)
content-blocks.pop()
content-parents.pop()
content-names.pop()
if produced == invalid-type || produced == no-type
    = false
. taken = produced
. call = no-fact
. replace = no-instance
. kept = produced
if is-markup-host(made)
    . content = calls.content-call(made, program.store-atom("markup-content"), statement, produced)
    taken = content.taken
    call = content.fact
    kept = content.answer
    if taken == no-type || call == no-fact || kept != previous
        = false
    . mark = scratch.types.mark
    scratch.types.push(made)
    scratch.types.push(previous)
    scratch.types.push(kept)
    replace = calls.demand-runtime-call
        - types.markup-host-decl.module
        - no-type
        - program.store-atom("markup-replace")
        - mark
    scratch.types.rewind(mark)
    if replace == no-instance
        = false
    conversions.convert(statement, statement, produced, taken, .reason-argument)
else
    . given [TypeId]
    given += previous
    given += produced
    . replacing = calls.protocol-call(made, program.store-atom("replace"), statement, given)
    call = replacing.fact
    if call == no-fact || replacing.answer == invalid-type
        = false
    if replacing.answer != no-type
        kept = replacing.answer
    if kept != previous
        = false
. nothing [TypeId]
. closed = calls.protocol-call(previous, program.store-atom("close"), statement, nothing).fact
if closed == no-fact
    demand-live-runtime()
    if instances.live.has-actions == no-instance
        = false
facts.note-content-link
    - ContentLink(instance, statement, made, taken, call, no-type, replace, closed)
= true

────────────────────
_ do absorb-again Bool
    - statement SyntaxId
    - made TypeId

` Types a line of a markup element's body that a live action gives the element again: its value,
` where a name of a member of the element is read from the element's object, kept where the
` element was made, is absorbed again by the element's `markup-absorb`, as where it is written.
content-blocks += 0
content-parents += made
content-names += false
. produced = infer(statement)
content-blocks.pop()
content-parents.pop()
content-names.pop()
if produced == invalid-type || produced == no-type
    = false
. absorbing = calls.content-call(made, program.store-atom("markup-absorb"), statement, produced)
. absorbed = absorbing.taken
if absorbed == no-type
    = false
conversions.convert(statement, statement, produced, absorbed, .reason-argument)
facts.note-content-link(ContentLink(instance, statement, made, absorbed, absorbing.fact))
= true

────────────────────
_ do owner-action InstanceId?
    - site SyntaxId
    - made TypeId
    - type-id SyntaxId

` The function that makes the live action a markup element owns where an attribute or an
` argument of it read something tracked, as the reference makes it: where a batch is found
` for the element, as `owns-batch` says, the markup runtime's `make-markup-action`, given the
` batch; else none where the element's actions are plain ones, and for an element of a markup
` host `make-owner-markup-action`, given the element as the host, to which it is converted at
` its type once, however many of its attributes read something tracked. Either may raise. One
` that has no shape here is declined, which is answered with nothing.
. rooted = owns-batch(made)
if owns-plain-actions(made) && !rooted
    = no-instance
. action = action-maker(site, made, rooted)
if !action
    = null
if !rooted && !converts-at(type-id, .reason-markup-host)
    conversions.convert
        - type-id
        - type-id
        - made
        - derived-interface(made, types.markup-host-decl)
        - .reason-markup-host
= action

────────────────────
_ do choose-updater Bool
    - index U32
    - site SyntaxId
    - made TypeId

` Gives the application `index` of a rule with a line that sets a property of its class again
` as what its value read changes the function that makes that line's live action for an object
` of the class `made`, as `owner-action` chooses one for an attribute where the rule is
` applied, or marks those actions plain ones, and so for one with `live-values` whose rule sets a
` property with a value that reads them. Says whether that has a shape here.
. unit = facts.style-applications[index].unit
if !facts.updates-live(unit) && !(live-given && facts.updates-given(unit))
    = true
.. live-given = facts.style-applications[index].live-values
. rooted = owns-batch(made)
if owns-plain-actions(made) && !rooted
    facts.style-applications[index].plain-updates = true
else
    . maker = action-maker(site, made, rooted)
    if !maker
        = false
    facts.style-applications[index].updater = maker
    facts.style-applications[index].rooted = rooted
revise-application(index)
= true

────────────────────
_ do action-maker InstanceId?
    - site SyntaxId
    - made TypeId
    - rooted Bool

` The markup runtime's function that makes the live action an object of a class owns, as
` `owner-action` says: `make-markup-action` given the batch in force where `rooted`, else
` `make-owner-markup-action` given the object as its host. One that has no shape here is
` declined, which is answered with nothing.
. host = if types.intrinsic-of(made) == .class then markup-host else no-type
    .. markup-host = derived-interface(made, types.markup-host-decl)
if types.intrinsic-of(made) != .class || (host == no-type && !rooted)
    decline(site)
    = null
demand-live-runtime()
. live = instances.live
. mark = scratch.types.mark
scratch.types.push
    - if live.trackers != no-instance then instances.signatures[live.trackers].returns else no-type
scratch.types.push(live.callback)
scratch.types.push(if rooted then batch-type() else host)
. action = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom(if rooted then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
if action == no-instance || live.has-actions == no-instance || other-return
    decline(site)
    = null
.. other-return = instances.signatures[action].returns != types.live-action-type
if !raises-out(site, action)
    decline(site)
    = null
= action

────────────────────
_ do converts-at Bool
    - site SyntaxId
    - reason ConversionReason

` Whether a conversion for a reason is recorded at a node of the instance being typed.
. fact = facts.first-conversion(instance, site)
while fact != no-fact
    if facts.conversions[fact].reason == reason
        = true
    fact = facts.conversions[fact].next
= false

────────────────────
_ owns-batch Bool
    - made TypeId

` Whether the live actions a markup element owns are made with a batch, as the reference's
` `createMarkupAction` makes them where it finds one for the element: the element itself where
` it is a batch, converted at its type as `batch-element` converts it, else the one in force.
is-batch(made) || in-batch()

────────────────────
_ do settle-arguments
    - id SyntaxId
    - args RowRange'SyntaxId
    - made TypeId
    - type-id SyntaxId

` Types the function that gives again each argument of a markup element, given by position,
` whose value read something tracked, once the element's object is typed, as the reference
` makes it: the parameter the argument fills must name a property of the element's class,
` which is the reference's error otherwise, and the local no name reaches that keeps the
` object, declared at the element, holds one of the element's class. The action is made as
` `owner-action` says.
for arg in tree.children[args]
    . position = facts.live-statements.length
    while position != 0
        position -= 1
        . live = facts.live-statements[position]
        if live.instance != instance || live.site != arg || live.rerun != no-instance
            continue
        . name = argument-name(arg, id, instance)
        . place = types.property-named(made, name) if name
        if !place
            frame.diagnose
                - arg
                - .stated
                - program.store-atom("Tracked markup constructor argument must match a property")
            =
        . resolution = bindings.resolution-of(frame.binding, id)
        if resolution.kind != .resolve-slot
            decline(arg)
            =
        . owned = owner-action(arg, made, type-id)
        if !owned
            =
        frame.assign(resolution.slot, made)
        . rerun = demand-lambda(intern-nested(nested-decl-of(arg)), scratch.no-types)
        if rerun == no-instance || instances.signatures[rerun].errors.count != 0
            decline(arg)
            =
        instances.mark-may-panic(instance)
        facts.live-statements[position] = LiveStatement
            - instance
            - arg
            - rerun
            - 0
            - place as U32
            - owned
            - owned != no-instance && owns-batch(made)
        break

────────────────────
_ do argument-name Atom?
    - arg SyntaxId
    - element SyntaxId
    - from InstanceId

` The name of the parameter an argument of a markup element, given by position, fills, as the
` instance that makes the element chose its constructor, or none.
. fact = facts.latest-call(from, element)
if fact == no-fact || facts.calls[fact].callee == no-instance
    = null
. callee = instances.rows[facts.calls[fact].callee]
. owner = program.modules[callee.module]
do match? tree.nodes[element]
    | .node-markup(row)
        do match? owner.decls[callee.decl]
            | .decl-function(fn)
                . position U32
                for written in tree.children[row.args]
                    if written == arg
                        if position >= fn.args.count
                            = null
                        = owner.arg-pool[fn.args.start + position].name
                    position += 1
= null

────────────────────
_ do argument-again TypeId
    - arg SyntaxId
    - made TypeId

` The type an argument of a markup element, given by position, is given again by its own
` function: that of the property its parameter names, to which the value is converted as one
` assigned is. A parameter that names no property stored in the object, as the instance that
` makes the element chose its constructor, is declined.
. element = tree.argument-element(arg)
. name = argument-name(arg, element, instances.rows[instance].enclosing)
. place = types.property-named(made, name) if name
if !place
    decline(arg)
    = invalid-type
. property = types.properties[place]
if property.storage-kind != .storage-eager
    decline(arg)
    = invalid-type
. declared = property.type
if declared == no-type
    declared = demand-member(property, made, name!)
if declared == no-type || declared == invalid-type
    decline(arg)
    = invalid-type
. written = infer(arg)
if written == invalid-type || written == no-type
    = invalid-type
if conversions.convert(arg, arg, written, declared, .reason-assignment) == invalid-type
    = invalid-type
= declared

────────────────────
_ do has-attributes Bool
    - body SyntaxId

` Whether the body of a markup element writes an attribute: a line that assigns.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if tree.nodes[statement] is .node-assign
                = true
= false

────────────────────
_ do push-attributes Bool
    - body SyntaxId
    - class TypeId

` Types the attributes of a markup element in the order written and pushes each as an
` argument of its constructor's call: one named as the property, marked as a property, of
` the property's type, to which the value is converted as one assigned is. One that may name a
` style property is left to `declare-styles`, and one a setter answers is no argument
` (`setter-attribute`). False where an attribute has no shape or names no property, which is
` reported.
. given = true
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    . name = style-name(tree, attribute.lhs)
                    if styles-attribute(attribute.op, class, name)
                        continue
                    if name && attribute-accessor(class, name)
                        if !setter-attribute(statement, attribute.op, attribute.lhs, attribute.rhs, class)
                            given = false
                        continue
                    . type = attribute-type
                        - statement
                        - attribute.op
                        - attribute.lhs
                        - attribute.rhs
                        - class
                    if type == invalid-type
                        given = false
                    else
                        scratch.call-arguments.push(CallArgument(name, false, false, true, false))
                        scratch.types.push(type)
                        scratch.syntax.push(statement)
= given

────────────────────
_ do setter-attribute Bool
    - statement SyntaxId
    - op Operator
    - target SyntaxId
    - value SyntaxId
    - class TypeId

` An attribute of a markup element that a setter answers, which the reference gives the object
` once it is made, as it updates any property the constructor does not fill: the value is typed
` by itself and the setter chosen for it as an assignment to the property chooses one, the
` reference's error where none answers. One of a setter private to another module, one written
` with an assigning operator, and one of a class with type variables are declined.
. name = identifier-name(tree, target)
. found = attribute-accessor(class, name!)
if op != .eq-op || !found || types.completions[class].has-variables || is-hidden(types.properties[found], name!, .setter-decl)
    decline(statement)
    = false
. given = stored-value(value, infer(value))
if given == invalid-type
    = false
. diagnosed = facts.diagnostics.length
if calls.setter-call(target, target, class, name!, value, given) == invalid-type
    facts.restate
        - diagnosed
        - instance
        - statement
        - .function-not-found
        - .stated
        - program.store-atom("Setter not found")
    = false
= true

────────────────────
_ do attribute-accessor Index?
    - class TypeId
    - name Atom

. found = types.property-named(class, name)
if found
    =? found if types.properties[found].storage-kind == .storage-getter
    = null
= interface-accessor(class, name)

────────────────────
_ do interface-accessor Index?
    - type TypeId
    - name Atom

types.complete(type)
. base = types.base-of(type)
if base
    . inherited = interface-accessor(base, name)
    =? inherited if inherited
for interface in types.interfaces-of(type)
    . place = types.property-named(interface, name)
    =? place if place && types.properties[place].storage-kind == .storage-getter
    . deeper = interface-accessor(interface, name)
    =? deeper if deeper
= null

────────────────────
_ do attribute-type TypeId
    - statement SyntaxId
    - op Operator
    - target SyntaxId
    - value SyntaxId
    - class TypeId

` The type an attribute of a markup element gives its constructor: that of the property it
` names, to which the value written is converted as a value assigned to the property is. A
` bullet list written for a list takes the list's item type, as the reference contextualizes it.
` A name that is no property of the class, or one private to another module, is the
` reference's error where no style could answer it. An attribute a setter answers, one of an
` array and one written with an assigning operator are declined. An event written is wanted as
` the property's type, as `use-event` says.
. name = identifier-name(tree, target)
if op != .eq-op || !name || types.intrinsic-of(class) != .class || generic
    decline(statement)
    = invalid-type
.. generic = types.completions[class].has-variables
. place = types.property-named(class, name)
if !place || is-hidden(types.properties[place], name, .setter-decl)
    if program.module-by-name("core/style")
        decline(statement)
    else
        frame.diagnose(target, .stated, program.store-atom("Property not found"))
    = invalid-type
. property = types.properties[place]
if property.storage-kind == .storage-getter
    decline(statement)
    = invalid-type
. declared = property.type
if declared == no-type
    declared = demand-member(property, class, name)
if declared == no-type || declared == invalid-type
    decline(statement)
    = invalid-type
if is-array-value(declared)
    decline(statement)
    = invalid-type
expect-bullets(value, declared)
. written = infer-with-expected(value, declared, Want().escaping(declared, value))
if written == invalid-type || written == no-type
    = invalid-type
if conversions.convert(statement, value, written, declared, .reason-assignment) == invalid-type
    = invalid-type
= declared

────────────────────
_ do store-attributes Bool
    - id SyntaxId
    - made TypeId
    - args RowRange'SyntaxId
    - body SyntaxId

` Keeps, for each attribute of a markup element that names no parameter of its constructor,
` that the value is stored in the property again once the object is made, as the reference
` does, or given to the setter that answers it. An attribute that names a parameter an
` argument fills is the reference's error. One that names another parameter fills it, as an
` argument by name does, and is not stored again; one a setter answers that names a parameter
` is declined.
. fact = facts.latest-call(instance, id)
if fact == no-fact || facts.calls[fact].callee == no-instance
    = !has-attributes(body)
. call = facts.calls[fact]
. callee = instances.rows[call.callee]
. owner = program.modules[callee.module]
do match? tree.nodes[body]
    | .node-block(row)
        do match? owner.decls[callee.decl]
            | .decl-function(fn)
                . given U32
                . setters U32
                for statement in tree.children[row.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            . name = identifier-name(tree, attribute.lhs)
                            . place = (types.property-named(made, name) ?? interface-accessor(made, name)) if name
                            if !place && facts.style-declaration-of(instance, statement)
                                continue
                            if !place
                                = false
                            . parameter = shape-index(owner, fn, name!)
                            if types.properties[place].storage-kind == .storage-getter
                                if parameter != U32.max
                                    decline(statement)
                                    = false
                                facts.note-element-store
                                    - ElementStore(instance, id, setters, U32.max, 0, attribute.lhs)
                                setters += 1
                                continue
                            if parameter != U32.max
                                . fill = if in-fills then kept else ArgumentFill.fill-empty
                                    .. in-fills = parameter < call.fills.count
                                    .. kept = facts.call-fills[call.fills.start + parameter] as U32
                                if fill < args.count + given
                                    . message = program.store-atom
                                        - "Redefining variable in same scope"
                                    frame.diagnose(statement, .stated, message)
                                    = false
                                if fill != args.count + given
                                    = false
                                given += 1
                                continue
                            if instances.fill-argument(call.callee, name!) == U32.max
                                = false
                            . written = panics.property-of(made, name!)
                            if written
                                panics.note-write(instance, written)
                            facts.note-element-store
                                - ElementStore(instance, id, args.count + given, place as U32, 0)
                            given += 1
                = true
= !has-attributes(body)

────────────────────
_ do raise-elements
    - block SyntaxId
    - statements RowRange'SyntaxId

` Makes, where a block of markup content starts, the object of each markup element the block
` declares a name for: one written as a line of the block, or as a line of the body of such an
` element, in the order they are written, as the reference does before it runs any line of the
` block. What makes one object may read the name of an element the block has not made yet,
` which makes that one first (`raise-early`); its own is the reference's error.
. first = await-elements(statements)
if unbuilt.length == first
    =
for statement in tree.children[statements]
    raise-element(block, statement)
settle-elements(first)

────────────────────
_ do await-elements Int
    - statements RowRange'SyntaxId

` Notes, where a block starts, each markup element the block declares a name for and has not
` made, and gives how many were noted before them, for `settle-elements` where the block ends.
. first = unbuilt.length
for statement in tree.children[statements]
    await-element(statement)
= first

────────────────────
_ do raise-statement
    - statement SyntaxId

` Makes the object of each markup element a statement of a block declares a name for, where the
` statement runs, as the reference does: the locals the statements above declare are in reach
` of what makes it. One a read of its name above made first is not made again.
=? if unbuilt.length == 0 || !(tree.nodes[statement] is .node-markup)
raise-element(statement, statement)

────────────────────
_ do settle-elements
    - first Int

` Forgets the markup elements a block noted it would make, where the block ends.
while unbuilt.length > first
    unbuilt.pop()
    awaited.pop()

────────────────────
_ do raise-line
    - line SyntaxId

` Makes the object of each markup element a body written as one line declares a name for, as
` `raise-elements` does for the lines of a block.
. first = unbuilt.length
await-element(line)
if unbuilt.length == first
    =
raise-element(line, line)
while unbuilt.length > first
    unbuilt.pop()
    awaited.pop()

────────────────────
_ do await-element
    - element SyntaxId

do match? tree.nodes[element]
    | .node-markup(row)
        . slot = element-slot(element, row.id)
        if slot && !is-placed(slot)
            unbuilt += slot
            awaited += element
        do match? tree.nodes[row.body]
            | .node-block(body)
                for statement in tree.children[body.body]
                    await-element(statement)

────────────────────
_ do raise-element
    - block SyntaxId
    - element SyntaxId

` Makes the object of a markup element that declares a name, then those of the lines of its
` body, under the styles and style sheets the class it names sees and the rules written in rules
` its style rules bring into view (`gather-scopes`), as the reference installs them before it
` evaluates the names a body declares. One a read made first is not made again.
do match? tree.nodes[element]
    | .node-markup(row)
        . slot = element-slot(element, row.id)
        if slot && !is-placed(slot) && unbuilt.find(slot) != null
            . around = building
            building = slot
            . made = make-element(element, row)
            building = around
            frame.assign(slot, made)
            . waited = unbuilt.find(slot)
            if waited != null
                unbuilt[waited] = no-slot
            facts.note-raised(instance, block, element)
        do match? tree.nodes[row.body]
            | .node-block(body)
                . styled = markup-styles.length
                . sheeted = markup-sheets.length
                if program.module-by-name("core/style")
                    types.clear-fault()
                    . written = types.evaluate-type(module, tree, row.type-id, frame.env)
                    types.clear-fault()
                    if written != invalid-type && types.intrinsic-of(written) == .class
                        do add-visible-styles(written, markup-styles, element)
                        if markup-sheets.length == 0
                            add-sheet-groups(frame.self-type, markup-sheets, sheet-levels)
                        add-sheet-groups(written, markup-sheets, sheet-levels)
                        . (start, end) = scopes-of(element)
                        if end == start && may-scope(written, row)
                            . names [Atom]
                            for name in implicit-names(written, row.type-id, row.id, tree)
                                names += program.store-atom(name)
                            . gathered [ScopeUse]
                            if !gather-scopes(written, names, row.style-rule-applications, element, written, gathered, tree)
                                decline(element)
                                =
                            record-scopes(element, gathered)
                . scoped = rule-scopes.length
                push-body-scopes(element)
                for statement in tree.children[body.body]
                    raise-element(block, statement)
                while rule-scopes.length > scoped
                    rule-scopes.pop()
                while markup-styles.length > styled
                    markup-styles.pop()
                while markup-sheets.length > sheeted
                    markup-sheets.pop()
                    sheet-levels.pop()

────────────────────
_ do names-elements Bool
    - block SyntaxId

` Whether a block whose lines are content of a markup element declares the names of the
` elements among them: the body of a `for` written as a line does, each turn.
. position = content-blocks.length
while position != 0
    position -= 1
    if content-blocks[position] == block
        = content-names[position]
= false

────────────────────
_ do is-plain-body Bool
    - body SyntaxId
    - rooted Bool = false
    - ruled Bool = false

` Whether the body of a markup element is one whose every line has a shape here: a block in which
` nothing tracks what it reads, apart from statements run again when it changes, values given rules
` applied where no live action of the reference is open, which read what they track plainly, markup
` branch and loop regions, whose arms and rows are checked where they are built, lines that give
` slots content, checked where the functions that build them are, in a root `<This`, the values its
` lines give properties, and state machines the object keeps; a line that holds another state
` machine, but in a region or a loop, has none. In the class's `• This` (`ruled`), the lines that
` are the rule's own are no lines of it. What the conditions of the style rules an element applies
` read is read by the gates that test them.
if body == 0
    = true
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if kept-machine(statement) || rule-line || binds-slot(statement)
                continue
            .. rule-line = ruled && tree.rule-part(statement)
            if !is-plain-line(statement, body, rooted)
                = false
        = true
= false

────────────────────
_ do is-plain-line Bool
    - line SyntaxId
    - body SyntaxId
    - rooted Bool

` Whether a line of the body of a markup element has a shape here, as `is-plain-body` says.
. gated [SyntaxId]
for node in tree.subtree-start(line) .. line
    do match? tree.nodes[node]
        | .node-style-rule-application(row)
            if row.condition != 0
                gated += row.condition
for node in tree.subtree-start(line) .. line
    if in-gated(node, gated)
        continue
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked && name-plain && name-live
                = false
            .. name-plain = !in-live-statement(node, body) && !(rooted && in-attribute(node, body))
            .. name-live = !in-region(node, body) && live-context(node) != .live-none
        | .node-get-expression(row)
            if row.is-tracked && get-plain && get-live
                = false
            .. get-plain = !in-live-statement(node, body) && !(rooted && in-attribute(node, body))
            .. get-live = !in-region(node, body) && live-context(node) != .live-none
        | .node-state-machine
            if !in-region(node, body) && !in-body-loop(node, body)
                = false
        | .node-markup-read-expression
            = false
= true

────────────────────
_ do in-body-loop Bool
    - node SyntaxId
    - body SyntaxId

` Whether a node is written in the body of a `for` within a body, which runs it each turn.
for around in node + 1 .. < body
    if tree.subtree-start(around) <= node && tree.nodes[around] is .node-for-block
        = true
= false

────────────────────
_ do in-gated Bool
    - node SyntaxId
    - conditions [SyntaxId]

` Whether a node is written in one of the conditions given.
for condition in conditions
    if tree.subtree-start(condition) <= node && node <= condition
        = true
= false

────────────────────
_ do in-attribute Bool
    - node SyntaxId
    - body SyntaxId

` Whether a node is written in a line of a block that assigns.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if tree.nodes[statement] is .node-assign && after-start && node < statement
                = true
            .. after-start = tree.subtree-start(statement) <= node
= false

────────────────────
_ do in-live-statement Bool
    - node SyntaxId
    - body SyntaxId

` Whether a node is written in an assignment, a declaration or an argument of a markup
` element within a body that a function of its own runs again.
for outer in node .. < body
    if tree.subtree-start(outer) <= node && is-live-statement(outer)
        = true
= false

────────────────────
_ do leaves-line Bool
    - statement SyntaxId

` Whether a line of a markup element's body leaves where it stands, which the reference
` reports as a return no element may hold: a return, under a condition or not, a raise
` under no condition, `continue`, `break`, or a `do` block whose last statement is one.
if is-leaving(statement) || tree.nodes[statement] is .node-return-if-true
    = true
do match? tree.nodes[statement]
    | .node-do-block(row)
        = facts.is-leaving(instance, row.body)
= false

────────────────────
_ is-markup-host Bool
    - type TypeId

` Whether objects of a type take their content through the markup protocol.
types.intrinsic-of(type) == .class && host-named && derived-interface(type, host) != no-type

.. host = types.markup-host-decl
.. host-named = host.module != 0 || host.decl != 0

────────────────────
_ takes-lines Bool
    - type TypeId

` Whether an element's lines are linked to it by its own `+=` and `++=`: it is an object of
` a class that does not take content through the markup protocol, and neither the class nor
` one it derives from writes markup that holds the default slot, which would take the lines.
|? types.intrinsic-of(type) != .class
    false
|? (host.module != 0 || host.decl != 0) && derived-interface(type, host) != no-type
    false
??
    !holds-slot(type)

.. host = types.markup-host-decl

────────────────────
_ takes-hosted Bool
    - type TypeId

` Whether an element's lines are linked to it through the markup protocol: it is an object of
` a markup host, and neither its class nor one it derives from writes markup that holds the
` default slot, which would take the lines.
is-markup-host(type) && !holds-slot(type)

────────────────────
_ do holds-slot Bool
    - type TypeId

` Whether a class or one it derives from writes markup that holds the default slot.
. level TypeId? = type
while level
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            if class.content != 0
                for node in owner.tree.subtree-start(class.content) .. < class.content
                    do match? owner.tree.nodes[node]
                        | .node-slot-outlet(row)
                            if row.name == 0
                                = true
    level = types.base-of(level)
= false

────────────────────
_ builds-slot Bool
    - element SyntaxId

` Whether this instance is the function that builds what a markup element, this one, gives a
` slot.
frame.declaration.kind == .slot-decl && frame.declaration.syntax == element

────────────────────
_ do binds-slot Bool
    - statement SyntaxId

` Whether a line is a markup element that gives a slot content, which a function of its own
` builds: one that binds a slot by name, or the one line of its body that gives the default slot
` content, element or value; or one that forwards a slot.
do match? tree.nodes[statement]
    | .node-markup
        = nested-decl-of(statement) != 0
    | .node-markup-slot-forward
        = true
= wraps-default(statement)

────────────────────
_ do check-slot
    - element SyntaxId

` The function that builds what a markup element gives a slot: the element made with its
` content, as it would be anywhere, cast to the type of the slot, which the element that gives
` it the function settled (`supply-slots`), under the styles that element sees and the rules
` written in rules it gives with those found on the way to the slot's outlet, under the state
` cells this function keeps or reads (`take-scope`). Where the slot
` repeats, it is given the item, which the name the element writes for it holds. It answers
` that type, and lets out what making the element raises. An element whose name is a property
` of the class the markup is run on gives the property the object, once made. The body of an
` element whose lines all give the default slot content builds them into a node (`wrap`). It
` runs under the batch in force where the line is written, read from the local that keeps it.
` Where the rules the slot's outlet applies bring rules under the state cells of `when`s, this
` function brings them (`root-applications`) and checks the states on what it built.
` One a style rule generates is typed as `check-content` says.
if instances.rows[instance].context != U32.max
    check-content(element)
    =
prepare()
. wanted = if outer then outer.slot-wanted else no-type
if wanted == no-type
    decline(element)
    finish-errors(frame)
    close()
    =
instances.set-returns(instance, wanted, wanted, .return-declared)
. rooted = if outer then outer.slot-batch else false
if rooted
    facts.region-roots += RegionRoot(instance, element, outer!.slot-root, batch-type())
do match? tree.nodes[element]
    | .node-markup(row)
        if row.slot-parameter != 0
            . resolution = bindings.resolution-of(frame.binding, row.slot-parameter)
            . item = instances.argument-type(instance, 0)
            if resolution.kind != .resolve-slot || item == no-type
                decline(element)
                finish-errors(frame)
                close()
                =
            frame.assign(resolution.slot, item)
. styled = markup-styles.length
for style in outer!.slot-styles
    markup-styles += style
for sheet in outer!.slot-sheets
    markup-sheets += sheet
for level in outer!.slot-levels
    sheet-levels += level
sheets-given = outer!.slot-sheets-known
for use in outer!.slot-scopes
    rule-scopes += take-scope(use)
. applied = outer!.slot-applying
if applied != 0 && !root-applications(outer!.slot-applying-module, applied, wanted)
    decline(element)
    finish-errors(frame)
    close()
    =
scopes-given = outer!.slot-scopes-known
layer-given = outer!.markup-layer()
batched += rooted
. made = if tree.nodes[element] is .node-block then wrap(element, wanted) else infer(element)
batched.pop()
if typed-made && applied != 0 && !check-cells(U32.max - 1, element, made, true)
    made = invalid-type
.. typed-made = made != invalid-type && made != no-type
if made != invalid-type && made != no-type
    conversions.convert(element, element, made, wanted, .reason-return)
    do match? tree.nodes[element]
        | .node-markup(row)
            if row.id != 0
                . place = named-place(element, row.id, made)
                if place
                    facts.note-named-store(NamedStore(instance, element, place))
while markup-styles.length > styled
    markup-styles.pop()
finish-errors(frame)
close()

────────────────────
_ do root-applications Bool
    - owner ModuleId
    - outlet SyntaxId
    - wanted TypeId

` Brings into view, in the function that builds what a line gives a slot, the rules written in
` rules that the rules the slot's outlet applies bring, as the reference's
` `markupSlotContentNodeWithRuleScopes` binds them: under state cells this function makes before
` it builds (at no element, `U32.max - 1`) and binds to what it built, read as of the slot's
` type. False where one is declined.
. written = program.modules[owner].tree
do match? written.nodes[outlet]
    | .node-slot-outlet(row)
        . none [Atom]
        . gathered [ScopeUse]
        if !gather-scopes(wanted, none, row.style-rule-applications, U32.max - 1, wanted, gathered, written)
            = false
        for use in gathered
            if use.scope.own != .scope-pending
                rule-scopes += use
        = true
= false

────────────────────
_ do check-content
    - element SyntaxId

` The function that builds what a line of a style rule generates where the rule is applied to a
` markup element, as the reference's `styleContentBuilderFunc` builds it: the element made with
` its content, as it would be anywhere, as a `MarkupElement`, under the styles, the style sheets and
` the rules written in rules its context holds, at the layer it holds, with no content generated
` by the rules the markup it makes applies (`generating`). A rule seen under the state cells of
` `when`s is seen under those it keeps (`content-cell`), and the values of the rule around one are
` kept (`content-values`), as the reference's closure captures its frames. It answers that type,
` and lets out what making the element raises. An element written with a name is declined.
prepare()
. host = types.well-known-type("core/markup", "MarkupElement")
. held = instances.contexts[instances.rows[instance].context]
. named = false
do match? tree.nodes[element]
    | .node-markup(row)
        named = row.id != 0
if host == invalid-type || named
    decline(element)
    finish-errors(frame)
    close()
    =
instances.set-returns(instance, host, host, .return-declared)
for position in 0 .. < held.styles
    markup-styles += instances.context-types[held.first + held.styles - 1 - position]
for position in held.first + held.styles .. < held.first + held.styles + held.sheets
    markup-sheets += instances.context-types[position]
    sheet-levels += instances.context-levels[position]
sheets-given = true
. kept U32
for position in held.scope-first .. < held.scope-first + held.scopes
    . scope = instances.context-scopes[position]
    . place = instances.context-valued[position]
    . values = if place == U32.max then U32.max else content-values(scope, place)
    . count = instances.context-cells[position]
    if count != 0
        . links = U32.max
        for depth in 0 .. < count - 1
            links = facts.scope-link(content-cell(scope, kept + depth, count - 1 - depth), links)
        rule-scopes += ScopeUse(scope, content-cell(scope, kept + count - 1, 0), values, links)
        kept += count
    else
        rule-scopes += ScopeUse(scope, U32.max, values)
scopes-given = true
layer-given = held.layer
batched += false
. made = infer(element)
batched.pop()
if made != invalid-type && made != no-type
    conversions.convert(element, element, made, host, .reason-return)
finish-errors(frame)
close()

────────────────────
_ do wrap TypeId
    - body SyntaxId
    - wanted TypeId

` The node the lines of a markup element's body, all content of its class's default slot, are
` built into, as the reference's `markupSlotContentWrapper` builds it: an object of the slot's
` type made with no arguments, of which the lines are the content. A type that is no markup
` host, or a batch, is declined.
if !is-markup-host(wanted) || is-batch(wanted)
    decline(body)
    = invalid-type
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. made = calls.construction-on(body, wanted, arguments)
if made == invalid-type || made == no-type
    = invalid-type
facts.set-node-type(instance, body, made)
content-blocks += body
content-parents += made
content-names += false
element-bodies += body
batched += in-batch()
check-statement(body)
batched.pop()
element-bodies.pop()
content-names.pop()
content-parents.pop()
content-blocks.pop()
= made

────────────────────
_ do check-binder
    - name SyntaxId

` The function a markup element whose body gives slots content gives its constructor, which
` the constructor runs once its own body has, before the markup of the element's class: it
` gives the local the element's name declares its one argument, the object, in the function
` that declares the local, so that what the slots are given reads it, as the reference's
` binder does, and where the name is a property of the class the markup is run on, gives the
` property the object too. A name no block declares a local for gives only the property. A local
` reached through functions other than those that build slots has no shape here.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. host = instances.argument-type(instance, 0)
. slot = declaring-slot(name)
. reached = if slot then outer && frame.is-captured(slot) && outer.places-across(slot) else member
    .. member = names-property(name)
if host == no-type || !reached
    decline(name)
    finish-errors(frame)
    close()
    =
if slot
    assign-placed(slot, host)
if names-property(name)
    . place = named-place(name, name, host)
    if place
        facts.note-named-store(NamedStore(instance, name, place))
finish-errors(frame)
close()

────────────────────
_ do binds-property Bool
    - statement SyntaxId

` Whether a markup element gives a function of its own its name's object, as one whose body
` gives slots content does, and the name is a property of the class the markup is run on.
do match? tree.nodes[statement]
    | .node-markup(row)
        = row.id != 0 && nested-decl-of(row.id) != 0 && names-property(row.id)
= false

────────────────────
_ names-property Bool
    - name SyntaxId

` Whether the name of a markup element is that of a property of the class of the object the
` function is run on.
|? self == no-type || self == invalid-type || types.intrinsic-of(self) != .class || lacks-self()
    false
??
    text != null && types.property-named(self, text) != null

.. self = frame.self-type
.. text = identifier-name(tree, name)

────────────────────
_ do give-binder Bool
    - element SyntaxId
    - name SyntaxId
    - class TypeId

` Types the function that gives a markup element's name its object, where its body gives
` slots content, as the `MarkupIdBinder` the constructor is given after the functions that
` build the slots: before those, so that what they are given reads the name as the object.
` The name must be one the element is made in place for, or, where no block declares it, as
` under an `if` written as a line, a property the markup of the class declares for it.
. slot = element-slot(element, name)
. decl = nested-decl-of(name)
. binds = types.well-known-type-of("core/markup", "MarkupIdBinder", class)
. held = if slot then is-placed(slot) else names-content-property(element, name)
if !held || decl == 0 || binds == invalid-type
    decline(element)
    = false
. callee = demand-nested(decl, class)
if callee == no-instance
    decline(element)
    = false
. closure = intern-nested(decl)
facts.set-node-type(instance, name, closure)
= conversions.convert(name, name, closure, binds, .reason-markup-slot) != invalid-type

────────────────────
_ do supply-slots Bool
    - element SyntaxId
    - body SyntaxId
    - class TypeId

` The slots of the markup written in a class that the lines of a markup element's body give
` content, each line an element that binds a slot by name, or the one line that is no attribute
` and binds none, which gives the default slot. Each is built by a function of its own, typed
` here for the type the slot's outlet declares, and made the `MarkupSlotBuilder` of that type
` the constructor is given, after its other arguments, in the order of the slots' names, the
` default one first, as the reference orders them. A name bound twice is the reference's error,
` as is one the class declares no slot of. Content the default slot is given in another shape,
` or which a class declaring none is given by a line the module builder took for it, is
` declined. What a slot is given is made under the styles the element's own body sees, as the
` reference makes it under the element's context. Slots of a class whose slots have no shape
` here (`class-outlets`) are declined, whose outlets are checked wherever an element of it is
` written, as the reference finds them there.
` An element written with a name gives its constructor last the function that gives the name
` the object (`give-binder`). The name of each slot is pushed on the names, and the type of its
` builder on the types. Answers false where the element is not made.
. lines [SyntaxId]
if wraps-default(body)
    lines += body
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if binds-slot(statement)
                lines += statement
. outlets = types.intrinsic-of(class) == .class && holds-outlets(class)
if lines.length == 0 && !outlets
    = true
if types.intrinsic-of(class) != .class || types.completions[class].has-variables
    decline(element)
    = false
. names [Atom]
. wanted [TypeId]
. items [TypeId]
. reported = facts.diagnostics.length
if !class-outlets(class, names, wanted, items)
    if facts.diagnostics.length == reported
        decline(element)
    = false
. defaulted = names.find(program.store-atom("")) != null
if defaulted && gives-default(body)
    decline(element)
    = false
if lines.length == 0
    = true
. name SyntaxId = 0
do match? tree.nodes[element]
    | .node-markup(row)
        name = row.id
. binder = if name != 0 then types.well-known-type-of("core/markup", "MarkupIdBinder", class) else no-type
if name != 0 && !give-binder(element, name, class)
    = false
. styles [TypeId]
if program.module-by-name("core/style")
    for style in markup-styles
        styles += style
    if !add-visible-styles(class, styles, element)
        = false
. sheets [TypeId]
. levels [U32]
visible-sheets(class, sheets, levels)
. given [Atom]
. builders [TypeId]
. scopes [ScopeUse]
. scoped = slot-scopes-for(element, class, scopes)
if !give-lines(lines, names, wanted, items, styles, sheets, levels, given, builders, class, scopes, scoped, false)
    = false
for offset in 0 .. < given.length
    scratch.names.push(given[offset])
    scratch.types.push(builders[offset])
if binder != no-type
    scratch.names.push(program.store-atom(binder-slot))
    scratch.types.push(binder)
= true

────────────────────
_ do give-lines Bool
    - lines [SyntaxId]
    - names [Atom]
    - wanted [TypeId]
    - items [TypeId]
    - styles [TypeId]
    - sheets [TypeId]
    - levels [U32]
    - given [Atom]
    - builders [TypeId]
    - class TypeId
    - scopes [ScopeUse]
    - scoped Bool
    - keeps-own Bool

` Types the function of each line that gives a slot content, under `styles` and the style
` `sheets` in their groups, and where `scoped`, the rules written in rules `scopes` and those found
` on the way to the outlet of the slot of `class` it gives (`outlet-scopes`, the way to which
` `keeps-own` those that match in the markup being filled where it is of that markup), made the
` builder of the slot (`builder-type`), as `names`, `wanted` and `items` hold them, and adds the
` slot to those `given`, with its builder (`add-slot`). The function of a slot that repeats takes
` the item, by the name the line writes for it. A line of a slot given already is not built: what
` gave it wins. A name bound twice is the reference's error, as is one no outlet declares, a
` slot that repeats given content that names no item, or default content, a line naming an item
` for a slot that does not repeat, and one that writes the item's type. A line that forwards a
` slot passes on the builder of that name the markup it is written in was given
` (`forward-slot`). The content given a slot whose items can be bound again is checked as the
` reference checks it (`reads-rebindable`). The function of each line is built under the batch
` in force where the line is written (`keep-root`). Answers false where a line has no shape here
` or is wrong.
. defaulted = names.find(program.store-atom("")) != null
. seen [Atom]
for line in lines
    . binding SyntaxId = 0
    . parameter SyntaxId = 0
    . forwarding SyntaxId = 0
    do match? tree.nodes[line]
        | .node-markup(row)
            binding = row.slot-binding
            parameter = row.slot-parameter
        | .node-markup-slot-forward(row)
            binding = row.slot-binding
            forwarding = row.outlet
    . bound = identifier-name(tree, binding)
    if (binding != 0 && !bound) || (binding == 0 && !defaulted)
        decline(line)
        = false
    . name = if binding != 0 then bound! else program.store-atom("")
    if seen.find(name) != null
        frame.diagnose(binding, .stated, program.store-atom("Duplicate slot content"))
        = false
    seen += name
    . position = names.find(name)
    if position == null
        frame.diagnose(binding, .stated, program.store-atom("Unknown slot"))
        = false
    . item = items[position]
    if item != no-type && binding == 0
        frame.diagnose
            - line
            - .stated
            - program.store-atom("Repeated default slot content requires a slot binding")
        = false
    do match? tree.nodes[parameter]
        | .node-markup-slot-parameter(written)
            if item == no-type
                frame.diagnose
                    - written.name
                    - .stated
                    - program.store-atom("Slot parameter requires a repeated slot")
                = false
            if written.type-id != 0
                frame.diagnose
                    - written.type-id
                    - .stated
                    - program.store-atom("Slot content parameter type belongs on the slot outlet")
                = false
        ??
            if item != no-type && forwarding == 0
                frame.diagnose
                    - binding
                    - .stated
                    - program.store-atom("Repeated slot content requires a slot parameter")
                = false
    . root = if forwarding == 0 then keep-root(line) else no-slot
    if given.find(name) != null
        continue
    if item != no-type && forwarding == 0 && rebinds(item) && !reads-rebindable(line, parameter)
        = false
    . content = wanted[position]
    . builder = builder-type(content, item)
    if forwarding != 0
        if forwards-nothing(name)
            continue
        if builder == invalid-type || !forward-slot(line, forwarding, name, builder)
            decline(line)
            = false
        . kept = facts.outlet-cells.length
        if !hold-cells(line, scopes)
            = false
        if facts.outlet-cells.length != kept
            facts.slot-forwards += SlotForward(instance, line, builder, item)
        add-slot(name, builder, given, builders)
        continue
    slot-scopes-known = scoped
    if scoped
        . seen [ScopeUse]
        for use in scopes
            seen += use
        . found [ScopeUse]
        . status = outlet-scopes(class, name, content, true, seen, sheets, levels, found, keeps-own)
        if status == 2
            slot-scopes-known = false
            decline(line)
            = false
        if status == 3
            . (owner, outlet) = slot-outlet(class, name)
            slot-applying = outlet
            slot-applying-module = class-ref(types, owner).module
        for use in scopes
            slot-scopes += use
        for use in found
            slot-scopes += use
    . decl = nested-decl-of(line)
    if builder == invalid-type || decl == 0
        decline(line)
        = false
    slot-wanted = content
    slot-root = root
    slot-batch = root != no-slot && in-batch()
    for style in styles
        slot-styles += style
    for sheet in sheets
        slot-sheets += sheet
    for level in levels
        slot-levels += level
    slot-sheets-known = sheets-known()
    . callee = demand-nested(decl, item)
    slot-wanted = no-type
    slot-root = no-slot
    slot-batch = false
    slot-styles.clear()
    slot-sheets.clear()
    slot-levels.clear()
    slot-sheets-known = false
    slot-scopes.clear()
    slot-scopes-known = false
    slot-applying = 0
    if callee == no-instance
        decline(line)
        = false
    . closure = intern-nested(decl)
    facts.set-node-type(instance, line, closure)
    if conversions.convert(line, line, closure, builder, .reason-markup-slot) == invalid-type
        = false
    add-slot(name, builder, given, builders)
= true

────────────────────
_ do keep-root SlotId
    - line SyntaxId

` The local no name reaches that keeps the batch of markup in force where a line that gives a
` slot content is written, which the function that builds the content captures: given the
` batch's type, which the line keeps there as it makes the function, or none where no batch is
` in force, as the reference captures the batch it finds.
. decl = nested-decl-of(line)
. root = if decl != 0 then captured-root(decl, line) else no-slot
if root == no-slot
    = no-slot
. rooted = in-batch()
frame.assign(root, if rooted then batch-type() else types.void-type)
if rooted
    facts.region-roots += RegionRoot(instance, line, root, batch-type())
= root

────────────────────
_ do captured-root SlotId
    - decl DeclId
    - line SyntaxId

` The local declared at a line that gives a slot content that the function the line declares
` captures, which keeps the batch in force there.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.decl == decl
        for index in 0 .. < nested.captures.count
            . slot = bindings.captures[nested.captures.start + index].slot
            if bindings.slots[slot].syntax == line && bindings.slots[slot].kind == .slot-local
                = slot
        = no-slot
= no-slot

────────────────────
_ do forward-slot Bool
    - line SyntaxId
    - outlet SyntaxId
    - name Atom
    - builder TypeId

` A line that forwards a slot passes on, as the builder of the slot of its name, the one the
` function that fills an object with the markup it is written in was given for that name, which
` a function written in that one reaches through the local that holds it, as the reference
` passes it on unwrapped. The forward's outlet keeps where it is read from. Where that function
` was given one of another type, it is declined. One given none gives nothing (`forwards-nothing`).
. filling = filling-checker()
if !filling
    = false
. argument = instances.slot-argument(filling.instance, name)
if argument == U32.max || instances.argument-type(filling.instance, argument) != builder
    = false
. held = no-slot
if !frame.declaration.is-content
    held = builder-slot(name)
    if held == no-slot
        = false
    argument = U32.max
facts.slot-outlets += SlotOutlet(instance, outlet, argument, 0, no-type, held, 0)
= true

────────────────────
_ forwards-nothing Bool
    - name Atom

` Whether a line that forwards the slot of a name gives nothing, as the function that fills an
` object with the markup it is written in was given no builder for that name.
filling != null && instances.slot-argument(filling.instance, name) == U32.max

.. filling = filling-checker()

────────────────────
_ do builder-type TypeId
    - content TypeId
    - item TypeId

` The type of the function that builds a slot of a content type: a `MarkupSlotBuilder`, or the
` `MarkupRowBuilder` that takes the item where the slot repeats.
if item == no-type
    = types.well-known-type-of("core/markup", "MarkupSlotBuilder", content)
= types.well-known-type-of("core/markup", "MarkupRowBuilder", item, content)

────────────────────
_ rebinds Bool
    - item TypeId

` Whether the items of a slot that repeats are ones a row can be bound to again, whose content
` the reference checks for reads that would outlive the binding.
|? scope == invalid-type
    false
??
    derived-interface(item, class-ref(types, scope)) != no-type

.. scope = types.well-known-type("core/markup", "MarkupRebindableScope")

────────────────────
_ do reads-rebindable Bool
    - line SyntaxId
    - parameter SyntaxId

` Checks the reads of the item a line gives a slot whose items can be bound again, by the name
` the line writes for it, as the reference checks them: outside a function or a `do` block, each
` read of a member of it must be tracked, and no local declared there with a value that reads
` it may be read in a function the line writes, by the names in reach as the reference finds
` them (`escaping-local`). Both are the reference's errors, the first at the member read, after
` the item's name. Answers false where one is reported.
. scope Atom? = null
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(written)
        scope = identifier-name(tree, written.name)
if !scope
    decline(line)
    = false
. read = untracked-read(line, scope)
if read != 0
    do match? tree.nodes[read]
        | .node-get-expression(row)
            . message = "Rebindable slot scope reads must be tracked as ${scope.text}.#${row.name.text}; use an explicit snapshot inside do for a stable value"
            . object = tree.nodes.loc[row.object]
            frame.diagnose(row.object, .stated, program.store-atom(message))
            facts.inset-diagnostic
                - object.end.column + 1 - object.begin.column
                - (row.name.text.length + 1) as U32
    = false
. derived [SyntaxId]
derive-locals(line, scope, derived)
if derived.length == 0
    = true
. names [Atom]
. held [Bool]
. escaping = escaping-local(line, derived, names, held, false)
if escaping != 0
    . name = identifier-name(tree, escaping)
    . message = "Local ${name!.text} derived from rebindable slot scope ${scope.text} cannot escape into a closure; read ${scope.text} directly in the closure or take an explicit snapshot inside do"
    frame.diagnose(escaping, .stated, program.store-atom(message))
    = false
= true

────────────────────
_ do untracked-read SyntaxId
    - id SyntaxId
    - scope Atom

` The first read, in the order written, of a member of what a name names that is not tracked,
` outside a function or a `do` block, or none.
do match? tree.nodes[id]
    | .node-function-syntax
        = 0
    | .node-do-block
        = 0
    | .node-get-expression(row)
        if !row.is-tracked && tree.nodes[row.object] is .node-identifier && reads-scope
            = id
        .. reads-scope = identifier-name(tree, row.object) == scope
for child in tree.children-of(id)
    . found = untracked-read(child, scope)
    if found != 0
        = found
= 0

────────────────────
_ do derive-locals
    - id SyntaxId
    - scope Atom
    - derived [SyntaxId]

` Adds each `.` written outside a function or a `do` block whose value reads a name there.
do match? tree.nodes[id]
    | .node-function-syntax
        =
    | .node-do-block
        =
    | .node-declare(row)
        if !row.is-lazy && row.right != 0 && reads-name(row.right, scope)
            derived += id
for child in tree.children-of(id)
    derive-locals(child, scope, derived)

────────────────────
_ do reads-name Bool
    - id SyntaxId
    - scope Atom

` Whether a name is read outside a function or a `do` block.
do match? tree.nodes[id]
    | .node-function-syntax
        = false
    | .node-do-block
        = false
    | .node-identifier(row)
        = row.name == scope
for child in tree.children-of(id)
    if reads-name(child, scope)
        = true
= false

────────────────────
_ do escaping-local SyntaxId
    - id SyntaxId
    - derived [SyntaxId]
    - names [Atom]
    - held [Bool]
    - closed Bool

` The first name read in a function, in the order written, that reaches a local one of the
` `derived` declarations declares, by the names in reach as the reference finds them, apart
` from what binds them: the names each declaration of a block around it declares, a lazy one's
` from the block's start and another's from after its value, which `held` marks where the
` declaration is derived, and the arguments of each function around it. None where there is
` none.
do match? tree.nodes[id]
    | .node-function-syntax(row)
        if row.body == 0
            = 0
        . mark = names.length
        for arg in tree.children[row.args]
            do match? tree.nodes[arg]
                | .node-argument-decl(shape)
                    bind-names(shape.pattern, false, names, held)
        . found = escaping-local(row.body, derived, names, held, true)
        unbind-names(mark, names, held)
        = found
    | .node-block(row)
        . mark = names.length
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-declare(declare)
                    if declare.is-lazy
                        bind-names(declare.left, derived.find(statement) != null, names, held)
        for statement in tree.children[row.body]
            . found = escaping-local(statement, derived, names, held, closed)
            if found != 0
                unbind-names(mark, names, held)
                = found
        unbind-names(mark, names, held)
        = 0
    | .node-declare(row)
        if row.is-lazy
            bind-names(row.left, derived.find(id) != null, names, held)
        if row.right != 0
            . found = escaping-local(row.right, derived, names, held, closed)
            if found != 0
                = found
        if !row.is-lazy
            bind-names(row.left, derived.find(id) != null, names, held)
        = 0
    | .node-identifier(row)
        if closed
            . place = names.length
            while place > 0
                place -= 1
                if names[place] == row.name
                    if held[place]
                        = id
                    = 0
        = 0
for child in tree.children-of(id)
    . found = escaping-local(child, derived, names, held, closed)
    if found != 0
        = found
= 0

────────────────────
_ do bind-names
    - pattern SyntaxId
    - derived Bool
    - names [Atom]
    - held [Bool]

` Puts in reach each name a pattern declares, marked `derived` or not.
do match? tree.nodes[pattern]
    | .node-identifier(row)
        names += row.name
        held += derived
        =
for child in tree.children-of(pattern)
    bind-names(child, derived, names, held)

────────────────────
_ do unbind-names
    - mark Size
    - names [Atom]
    - held [Bool]

` Takes out of reach the names put in reach since a mark.
while names.length > mark
    names.pop()
    held.pop()

────────────────────
_ do add-slot
    - name Atom
    - builder TypeId
    - given [Atom]
    - builders [TypeId]

` Adds a slot to those given, with its builder, in the order of their names, the default one
` first, as the reference orders them.
. spot = given.length
while spot != 0 && given[spot - 1].text > name.text
    spot -= 1
given.insert(name, spot)
builders.insert(builder, spot)

────────────────────
_ do wraps-default Bool
    - body SyntaxId

` Whether the body of a markup element is built by a function of its own into a node of its
` class's default slot type, every line of it content of that slot, or the one line that gives
` that content is built by one as a value of that type.
if body == 0
    = false
. decl = nested-decl-of(body)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .slot-decl
= false

────────────────────
_ do gives-default Bool
    - body SyntaxId
    - ruled Bool = false

` Whether a line of an element's body gives the default slot content that no function of its
` own builds: a line that neither assigns nor gives a slot content, nor is the rule's own in
` the body of a class's `• This` (`ruled`), where the body is not built by one.
if wraps-default(body)
    = false
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !assigning && !binds-slot(statement) && !(ruled && tree.rule-part(statement))
                = true
            .. assigning = tree.nodes[statement] is .node-assign
= false

────────────────────
_ do class-outlets Bool
    - class TypeId
    - names [Atom]
    - wanted [TypeId]
    - items [TypeId]

` The slots the markup written in a class declares by its outlets, each named, the default one
` by the empty text, with the type its outlet declares, and the type of the item it gives the
` function that builds it where the slot repeats, or no type: every outlet written in the
` markup but one in the body of another, which is content the other mounts where it is given
` none, those of the classes above it first, from the top. A name declared twice, in one class
` or two, and an outlet that repeats with no type for its item, are the reference's errors,
` reported where the class is written in this module and else declined. An outlet whose type
` names nothing is reported where the type is written, in whichever module that is, since the
` element fails before the class's own markup is checked. A slot its markup
` forwards is declared as `level-slots` says. The slots of a class are looked for with it, and
` then each class above it, marked as being looked for (`outlet-classes`), as the reference marks
` them (`recursing-class`). Slots of a class whose markup passes an outlet as an argument have
` no shape here: answers false.
outlet-classes += class
. base = types.base-of(class)
. complete = if base then class-outlets(base, names, wanted, items) else true
if complete
    complete = level-slots(class, names, wanted, items)
outlet-classes.pop()
= complete

────────────────────
_ do recursing-class TypeId
    - class TypeId

` The first of a class and those above it whose slots are being looked for, from the class up,
` which the reference reports looking for again, or no type.
. level TypeId? = class
while level
    if outlet-classes.find(level) != null
        = level
    level = types.base-of(level)
= no-type

────────────────────
_ do level-slots Bool
    - class TypeId
    - names [Atom]
    - wanted [TypeId]
    - items [TypeId]

` The slots the markup written in one class declares, not counting those of the classes above
` it, added to those found so far, as `class-outlets` finds them. A line of an element's body
` that forwards a slot declares the slot of that name the element's class declares, where it
` declares one, as the reference takes it. Where that class's slots are being looked for, it
` is the reference's error, at the element, reported where the class is written in this module
` and else declined.
. ref = class-ref(types, class)
. owner = program.modules[ref.module]
. content SyntaxId = 0
do match? owner.decls[ref.decl]
    | .decl-class(row)
        content = row.content
if content == 0
    = true
. found [SyntaxId]
for node in owner.tree.subtree-start(content) .. < content
    do match? owner.tree.nodes[node]
        | .node-slot-outlet(row)
            if owner.tree.argument-element(node) != 0
                = false
            found += node
        | .node-markup-slot-forward
            found += node
. forwarded [SyntaxId]
for node in found
    do match? owner.tree.nodes[node]
        | .node-markup-slot-forward(row)
            forwarded += row.outlet
. args = RowRange'TypeId()
do match? types.rows[class]
    | .type-class(row)
        args = row.args
. env = types.class-env-for(ref.module, ref.decl, args, class)
. complete = true
for outlet in found
    . inner = forwarded.find(outlet) != null
    for other in found
        do match? owner.tree.nodes[other]
            | .node-slot-outlet(row)
                if row.body != 0 && after-start && outlet <= row.body
                    inner = true
                .. after-start = owner.tree.subtree-start(row.body) <= outlet
    if inner
        continue
    do match? owner.tree.nodes[outlet]
        | .node-markup-slot-forward(row)
            . name = identifier-name(owner.tree, row.slot-binding)
            . element = owner.tree.holder-of(owner.tree.holder-of(outlet))
            . host = no-type
            do match? owner.tree.nodes[element]
                | .node-markup(made)
                    host = types.evaluate-type(ref.module, owner.tree, made.type-id, env)
            if !name || host == invalid-type
                complete = false
                break
            if host == no-type || types.intrinsic-of(host) != .class
                continue
            . recursing = recursing-class(host)
            if recursing != no-type
                if ref.module == module
                    frame.diagnose(element, .stated, program.store-atom("Recursive markup slot signature discovery for ${type-short-name(types, recursing)}"))
                complete = false
                break
            . held [Atom]
            . contents [TypeId]
            . kept [TypeId]
            if !class-outlets(host, held, contents, kept)
                complete = false
                break
            . position = held.find(name)
            if position == null
                continue
            if names.find(name) != null
                if ref.module == module
                    frame.diagnose
                        - row.slot-binding
                        - .stated
                        - program.store-atom("Duplicate slot outlet")
                complete = false
                break
            names += name
            wanted += contents[position]
            items += kept[position]
        | .node-slot-outlet(row)
            . name = program.store-atom("")
            if row.name != 0
                name = identifier-name(owner.tree, row.name) ?? name
            if names.find(name) != null
                if ref.module == module
                    frame.diagnose(outlet, .stated, program.store-atom("Duplicate slot outlet"))
                complete = false
                break
            types.clear-fault()
            . type = types.evaluate-type(ref.module, owner.tree, row.type-id, env)
            if type == invalid-type
                . message = types.fault ?? program.store-atom("Type not found")
                types.clear-fault()
                facts.record-diagnostic(instance, ref.module, row.type-id, .stated, message)
            if type == invalid-type || types.intrinsic-of(type) != .class
                complete = false
                break
            . item = no-type
            do match? owner.tree.nodes[row.slot-parameter]
                | .node-markup-slot-parameter(parameter)
                    if parameter.type-id == 0
                        if ref.module == module
                            frame.diagnose
                                - parameter.name
                                - .stated
                                - program.store-atom
                                    - "Repeated slot outlet requires a slot parameter type"
                        complete = false
                        break
                    item = types.evaluate-type(ref.module, owner.tree, parameter.type-id, env)
                    if item == invalid-type
                        complete = false
                        break
            names += name
            wanted += type
            items += item
types.env-release(env)
= complete

────────────────────
_ do holds-outlets Bool
    - class TypeId

` Whether the markup a class writes, or that of a class above it, holds a slot outlet or
` forwards a slot.
. level TypeId? = class
while level
    if writes-outlets(level)
        = true
    level = types.base-of(level)
= false

────────────────────
_ do writes-outlets Bool
    - class TypeId

` Whether the markup a class writes, not counting that of the classes above it, holds a slot
` outlet or forwards a slot.
. ref = class-ref(types, class)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(row)
        if row.content != 0
            for node in owner.tree.subtree-start(row.content) .. < row.content
                if owner.tree.nodes[node] is .node-slot-outlet || slot-forward
                    = true
                .. slot-forward = owner.tree.nodes[node] is .node-markup-slot-forward
= false

────────────────────
_ do infer-outlet TypeId
    - id SyntaxId
    - row ASTSlotOutlet

` A slot outlet of the markup written in a class, in the function that fills an object of it,
` or in a function written in that one, which reaches what the filling function was given
` through the local that holds it (`builder-slot`). Its node is of the type it declares: the one
` the function that builds the slot gives, which the filling function was given for the slot
` by the constructor; or else, where it was given none, the one the element its body writes
` makes, cast to that type, made where the outlet is and the line of no element. Nothing is
` mounted where it has neither. Where the slot repeats, the function that builds it is given
` the item the outlet names, as the type it declares for it. The local its name declares holds
` the node. Content of several lines, or one `if`, `match` or loop of content, is built into a
` node of the slot's type made with no arguments (`wrap`), as the reference builds it. Then each
` line of its body that assigns gives the node a property as an attribute gives an element's
` object one, and one whose value read something tracked is given again by a function of its
` own, owned by the node. The style rules the outlet applies after `•`, then the lines of its
` body that declare styles, declare them for the node at a site of the outlet's own, as the
` reference's `compileSlotOverlay` does, seeing the style sheets of the markup but none of the
` node's class (`overlaying`). An outlet anywhere but the markup of a class, one whose item is
` read again where the row it is in is bound to another, body content of one line that is no
` element, and content built into a node under a batch where roots are not put off, which the
` reference puts under the batch, are declined. A type that names nothing is reported where it
` is written, as an element's is. Where it is given a builder, the locals its
` content declares are built nowhere here (`leave-unbuilt`), nor, where it mounts nothing, those
` its attributes declare. One that is a markup branch region
` (`outlet-region`) is built by the function of its one arm, which reads the item plainly and
` gives its name nothing; one of those given no builder is declined.
. filling = filling-checker()
if !filling
    decline(id)
    = invalid-type
types.clear-fault()
. content = types.evaluate-type(module, tree, row.type-id, filling.frame.env)
if content == invalid-type
    if !report-circular() && !report-fault(row.type-id)
        frame.diagnose(row.type-id, .stated, program.store-atom("Type not found"))
    = invalid-type
if types.intrinsic-of(content) != .class
    decline(id)
    = invalid-type
. name = program.store-atom("")
if row.name != 0
    name = identifier-name(tree, row.name) ?? name
. item = no-type
. given SyntaxId = 0
do match? tree.nodes[row.slot-parameter]
    | .node-markup-slot-parameter(parameter)
        if parameter.type-id != 0
            item = types.evaluate-type(module, tree, parameter.type-id, filling.frame.env)
        given = parameter.name
        if item == invalid-type || item == no-type
            decline(id)
            = invalid-type
. lines [SyntaxId]
do match? tree.nodes[row.body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !(tree.nodes[statement] is .node-assign)
                lines += statement
. argument = instances.slot-argument(filling.instance, name)
. rebuilt = frame.declaration.kind == .branch-arm-decl && frame.declaration.syntax == id
if rebuilt && argument == U32.max
    decline(id)
    = invalid-type
. held = no-slot
. fallback SyntaxId = 0
if argument != U32.max
    . builder = instances.argument-type(filling.instance, argument)
    if !frame.declaration.is-content
        held = builder-slot(name)
        if held == no-slot
            decline(id)
            = invalid-type
        argument = U32.max
    if given != 0
        . value = infer(given)
        if value == invalid-type
            = invalid-type
        if !rebuilt && (facts.plan-of(instance, given) == .plan-row-item || reads-getter(given))
            decline(id)
            = invalid-type
        if conversions.convert(given, given, value, item, .reason-argument) == invalid-type
            = invalid-type
    . produced = calls.builder-call(id, builder, if given == 0 then 0 else 1)
    if produced == invalid-type
        = invalid-type
    if produced != content
        decline(id)
        = invalid-type
    if !hold-cells(id, rule-scopes)
        = invalid-type
    if row.body != 0
        leave-unbuilt(row.body)
else if lines.length == 0
    facts.slot-outlets += SlotOutlet(instance, id, U32.max, 0, content)
    if row.body != 0
        leave-unbuilt(row.body)
    = no-type
else if lines.length > 1 || is-control-line(lines[0])
    fallback = row.body
    if in-batch() && !defers-roots()
        decline(id)
        = invalid-type
    . made = wrap(fallback, content)
    if made == invalid-type
        = invalid-type
    if conversions.convert(fallback, fallback, made, content, .reason-assignment) == invalid-type
        = invalid-type
else
    fallback = lines[0]
    do match? tree.nodes[fallback]
        | .node-markup(element)
            if element.slot-binding != 0
                decline(fallback)
                = invalid-type
        ??
            decline(fallback)
            = invalid-type
    . made = infer(fallback)
    if made == invalid-type || made == no-type
        = invalid-type
    if conversions.convert(fallback, fallback, made, content, .reason-assignment) == invalid-type
        = invalid-type
facts.slot-outlets += SlotOutlet(instance, id, argument, fallback, content, held, given)
. named = declaring-slot(row.name) if row.name != 0 && !rebuilt
if named && bindings.slots[named].group == id
    frame.assign(named, content)
. outer-overlay = preparing
preparing = preparing.overlaying = true
preparing = preparing.site = 0
element-scopes.clear()
empty-shared = false
. applied = apply-written-rules(id, content, row.style-rule-applications, 0)
element-scopes.clear()
. declared = applied != U32.max && declare-styles(id, content, row.body, applied)
preparing = outer-overlay
if !declared
    = invalid-type
do match? tree.nodes[row.body]
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    if styles-attribute(attribute.op, content, style-name(tree, attribute.lhs))
                        continue
                    if attribute-type(statement, attribute.op, attribute.lhs, attribute.rhs, content) == invalid-type
                        = invalid-type
settle-attributes(row.body, content, row.type-id)
= content

────────────────────
_ do leave-unbuilt
    - body SyntaxId

` Gives each local a body declares, which nothing here runs, the void type, so that the
` environment that holds those a nested function would capture has room for none of them: the
` content an outlet mounts where it is given none, in a function given a builder for it.
. start = tree.subtree-start(body)
. range = bindings.bindings[frame.binding].slots
for offset in 0 .. < range.count
    . slot = range.start + offset
    . syntax = bindings.slots[slot].syntax
    if syntax >= start && syntax <= body && frame.known(slot) == no-type
        frame.assign(slot, types.void-type)

────────────────────
_ do is-control-line Bool
    - line SyntaxId

` Whether a line of markup content is an `if`, a `match`, or a loop that is no loop on a stream,
` as the reference's `isMarkupControlFlow` finds it.
do match? tree.nodes[line]
    | .node-if-block
        = true
    | .node-match-expression
        = true
    | .node-for-block(row)
        = !is-subscriber-loop(row.loop)
    | .node-iterator-expression(row)
        = !is-subscriber-loop(row.loop)
= false

────────────────────
_ do filling-checker Checker?

` The checker of the function that fills an object with the markup written in its class that
` this function is, or is written in; none where it is neither.
. level Checker? = this
while level
    if level.frame.declaration.is-content
        = level
    level = level.outer
= null

────────────────────
_ do builder-slot SlotId
    - name Atom

` The local that holds the function that builds the slot of a name, which the function that
` fills an object with the markup of its class was given, where a function written in that one
` reaches it.
. range = bindings.bindings[frame.binding].slots
for offset in 0 .. < range.count
    . slot = range.start + offset
    if bindings.slots[slot].kind == .slot-builder && bindings.slots[slot].name == name
        = slot
= no-slot

────────────────────
_ do hold-builders Bool
    - receiver TypeId
    - site SyntaxId

` Types the local that holds the function that builds each slot a function written in this one
` reaches through it, as the builder of the slot the class's markup declares, given or not.
` Answers false where the slots have no shape here or are wrong.
. range = bindings.bindings[frame.binding].slots
. names [Atom]
. wanted [TypeId]
. items [TypeId]
. read = false
for offset in 0 .. < range.count
    . slot = range.start + offset
    if bindings.slots[slot].kind != .slot-builder
        continue
    if !read
        read = true
        . reported = facts.diagnostics.length
        if !class-outlets(receiver, names, wanted, items)
            if facts.diagnostics.length == reported
                decline(site)
            = false
    . position = names.find(bindings.slots[slot].name)
    if position == null
        decline(site)
        = false
    . builder = builder-type(wanted[position], items[position])
    if builder == invalid-type
        decline(site)
        = false
    frame.assign(slot, builder)
= true

────────────────────
_ reads-getter Bool
    - id SyntaxId

` Whether a name reads a local of a row of a markup loop region that the reference reads as a
` getter.
resolution.kind == .resolve-slot && bindings.slots[resolution.slot].getter != 0

.. resolution = bindings.resolution-of(frame.binding, id)

────────────────────
_ do store-arguments Bool
    - id SyntaxId
    - made TypeId
    - args RowRange'SyntaxId

` Keeps, for each argument of a markup element whose parameter has the name of a property of
` the element's class, that the argument is stored in the property once the object is made,
` converted as a value assigned to the property is. False where such a store has no shape
` here: an argument written with a name or a `?`, or given to a variadic parameter, a
` property that is not stored in the object or is private to another module, or an array,
` whose storage the runtime is told is replaced.
. fact = facts.latest-call(instance, id)
if fact == no-fact || facts.calls[fact].callee == no-instance
    = args.count == 0
. callee = instances.rows[facts.calls[fact].callee]
. owner = program.modules[callee.module]
do match? owner.decls[callee.decl]
    | .decl-function(fn)
        . position U32
        for arg in tree.children[args]
            if tree.nodes[arg] is .node-argument
                = false
            if position < fn.args.count
                . shape = owner.arg-pool[fn.args.start + position]
                . place = types.property-named(made, shape.name) if shape.name
                if place
                    . property = types.properties[place]
                    . given = facts.node-type(instance, arg)
                    if shape.is-variadic || property.storage-kind != .storage-eager
                        = false
                    if is-hidden(property, shape.name!, .setter-decl)
                        = false
                    . declared = property.type
                    if declared == no-type
                        declared = demand-member(property, made, shape.name!)
                    if declared == no-type || declared == invalid-type
                        = false
                    if is-array-value(declared)
                        = false
                    if conversions.convert(arg, arg, given, declared, .reason-assignment) == invalid-type
                        = false
                    . written = panics.property-of(made, shape.name!)
                    if written
                        panics.note-write(instance, written)
                    facts.note-element-store
                        - ElementStore(instance, id, position, place as U32, arg)
            position += 1
        = true
= args.count == 0

────────────────────
_ do content-parent TypeId
    - block SyntaxId

` The type of the markup element a block's lines are content of, or no type for a block
` that is not such a one.
. position = content-blocks.length
while position != 0
    position -= 1
    if content-blocks[position] == block
        = content-parents[position]
= no-type

────────────────────
_ do check-line TypeId
    - statement SyntaxId
    - parent TypeId
    - want Want = Want()

` A line of a block: one of markup content that is a markup branch region, a slot outlet that
` is one (`outlet-region`), or a markup loop region makes the region, which is the line's value,
` one that is a loop written with `in` and no function of its own runs its body as content as a
` `for` does, and any other is checked as a statement.
if parent != no-type && is-region(statement)
    = check-branch(statement, parent)
if parent != no-type && outlet-region(statement) != 0
    = check-branch(outlet-region(statement), parent)
if parent != no-type && is-loop-region(statement)
    = check-loop-region(statement, parent)
if parent != no-type && nested-decl-of(statement) == 0
    do match? tree.nodes[statement]
        | .node-iterator-expression(row)
            facts.set-plan(instance, statement, .plan-content-loop)
            check-for(statement, row.loop, row.body, row.next)
            frame.forget-members()
            = no-type
= check-statement(statement, want)

────────────────────
_ do is-region Bool
    - id SyntaxId

` Whether an `if` or a `match` is a markup branch region, whose arm a function of its own
` selects again.
. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .branch-decl
= false

────────────────────
_ do outlet-region SyntaxId
    - outlet SyntaxId

` The parameter of a slot outlet that is a markup branch region of one arm, the outlet, at which
` the region is written, or none.
do match? tree.nodes[outlet]
    | .node-slot-outlet(row)
        = if row.slot-parameter != 0 && region-slot then row.slot-parameter else 0u32
            .. region-slot = is-region(row.slot-parameter)
= 0

────────────────────
_ do is-loop-region Bool
    - id SyntaxId

` Whether a `for` is a markup loop region, whose container a function of its own reads again.
. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .source-decl
= false

────────────────────
_ do in-container Bool
    - region SyntaxId
    - id SyntaxId

` Whether a node is written in the container of a markup loop region.
do match? tree.nodes[region]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                = loop.container != 0 && after-start && id <= loop.container
                    .. after-start = tree.subtree-start(loop.container) <= id
= false

────────────────────
_ do in-key Bool
    - region SyntaxId
    - id SyntaxId

` Whether a node is written in the `keyed by` clause of a markup loop region.
do match? tree.nodes[region]
    | .node-for-block(row)
        . clause = tree.keyed-clause(row.loop)
        = clause != 0 && tree.subtree-start(clause) <= id && id <= clause
= false

────────────────────
_ region-head SyntaxId
    - arm SyntaxId

` The `if` of the markup branch region an arm is one of, or none: a later arm resolves to the
` local that keeps the region's host, which the `if` declares.
|? is-region(arm)
    arm
|? resolution.kind != .resolve-slot
    0
|? head != arm && head < tree.nodes.length && tree.nodes[head] is .node-if-block && is-region(head)
    head
??
    0

.. resolution = bindings.resolution-of(frame.binding, arm)
.. head = bindings.slots[resolution.slot].syntax

────────────────────
_ do arm-line SyntaxId
    - region SyntaxId
    - id SyntaxId

` The line of the body of an arm of a markup branch or match region that gives content a node is
` written in, where a function of its own gives it again, or none.
for arm in tree.region-arms(region)
    do match? tree.nodes[tree.region-arm-body(arm)]
        | .node-block(block)
            for line in tree.children[block.body]
                if tree.subtree-start(line) <= id && id <= line
                    = if tree.content-line(line) && is-live-statement(line) then line else 0u32
= 0

────────────────────
_ matched-line SyntaxId
    - arm SyntaxId
    - id SyntaxId

` The line of an arm of a markup match region that gives content a node is written in, as
` `arm-line` says, or none. The arm is not written within its match, which follows it.
if region != 0 && is-region(region) then arm-line(region, id) else 0u32

.. region = tree.arm-match(arm)

────────────────────
_ do in-arm-body Bool
    - region SyntaxId
    - id SyntaxId

` Whether a node is written in the body of an arm of a markup branch or match region.
for arm in tree.region-arms(region)
    . body = tree.region-arm-body(arm)
    if tree.subtree-start(body) <= id && id <= body
        = true
= false

────────────────────
_ do in-region Bool
    - node SyntaxId
    - body SyntaxId

` Whether a node is written in a markup branch, match or loop region within a body: in one of
` its conditions, its subject, its patterns or its container, which the region reads in a live
` action of its own, or in an arm or the body of its loop, which a function of its own builds;
` or in a slot outlet that is such a region.
for around in node + 1 .. < body
    if tree.subtree-start(around) <= node && outlet-region(around) != 0
        = true
    if tree.subtree-start(around) <= node && if-region
        = true
    .. if-region = tree.nodes[around] is .node-if-block && region-head(around) != 0
    if tree.subtree-start(around) <= node && match-region
        = true
    .. match-region = tree.nodes[around] is .node-match-expression && is-region(around)
    if tree.subtree-start(around) <= node && loop-region
        = true
    .. loop-region = tree.nodes[around] is .node-for-block && is-loop-region(around)
= false

────────────────────
_ do check-branch TypeId
    - id SyntaxId
    - parent TypeId

` A markup branch region, as the reference compiles one:
` the host the `if` is content of must be a `MarkupElement`, whose `MarkupParent`
` gives the type of its content. Each arm is built by a function of its own given the
` region, made a `MarkupBranchBuilder` at the arm, and the builders are made a list at the
` `if`. The conditions are read in a live action of the region's own, and the index of the
` arm whose condition holds is what the markup runtime's `markup-create-branch-region` makes
` the region with; the region is the line's value, which the host takes. The host and the
` region are kept, in the two locals no name reaches declared at the `if`, for the function
` that selects the arm again, which the action runs: made by `make-owner-markup-action`,
` owned by the host and marked structural. Where a batch is found for the host, as
` `region-batch-of` says, the region is put under it by `ensure-markup-root` once made, and the
` action is made with it by `make-markup-action`. The batch in force where the region is
` written is kept in a third such local, which the arms are built under. A region whose
` content is no class or is a batch is declined, and one whose host makes no branch region, as
` `makes-region` says, is an error at the `if`. A region of a class with events, which the
` markup runtime makes, is kept as any other: the reference closes only its live actions. A
` match region selects the first arm whose pattern its subject matches (`read-patterns`), and
` its function selects again whatever arm the region holds, asking nothing of the region first,
` as the reference's `markupMatchBranch` does, and so does that of a slot outlet that is a region,
` written at its parameter, whose one arm is the outlet.
if !is-markup-host(parent)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup branch parent must implement MarkupElement")
    = invalid-type
. tree-host = derived-interface(parent, types.markup-tree-host-decl)
. content = if tree-host != no-type then first-arg(tree-host) else no-type
if content == no-type || content == invalid-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup branch host content type could not be resolved")
    = invalid-type
. resolution = bindings.resolution-of(frame.binding, id)
if types.intrinsic-of(content) != .class || resolution.kind != .resolve-slot || is-batch(content)
    decline(id)
    = invalid-type
if !makes-region(parent)
    frame.diagnose(id, .stated, program.store-atom(message))
    .. message = "Markup branch host ${type-source(types, parent)} must declare markup-make-region, or extend MarkupNode"
    = invalid-type
. builder = types.well-known-type-of("core/markup", "MarkupBranchBuilder", content)
. list = types.well-known-type-of("core/list", "List", builder)
if builder == invalid-type || list == invalid-type
    decline(id)
    = invalid-type
. rooted = in-batch()
. hosted = is-batch(parent)
. outer-batch = region
region = region.batch = rooted
region = region.root = resolution.slot + 2
frame.assign(resolution.slot, parent)
for arm in tree.region-arms(id)
    . body = tree.region-arm-body(arm)
    . decl = nested-decl-of(body)
    if decl == 0 || demand-nested(decl, content) == no-instance
        region = outer-batch
        decline(arm)
        = invalid-type
    . closure = intern-nested(decl)
    facts.set-node-type(instance, body, closure)
    if conversions.convert(arm, arm, closure, builder, .reason-markup-arm) == invalid-type
        region = outer-batch
        = invalid-type
region = outer-batch
calls.note-list(id, list)
read-arms(id)
demand-live-runtime()
. live = instances.live
. host = derived-interface(parent, types.markup-host-decl)
. selected = types.optional-of(types.index-type)
. markup = types.markup-host-decl.module
. mark = scratch.types.mark
scratch.types.push(content)
scratch.types.push(parent)
scratch.types.push(parent)
scratch.types.push(list)
scratch.types.push(selected)
. create = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom("markup-create-branch-region")
    - mark
    - 2
scratch.types.rewind(mark)
scratch.types.push(content)
scratch.types.push(content)
scratch.types.push(selected)
. matched = tree.nodes[id] is .node-match-expression || slot-parameter
    .. slot-parameter = tree.nodes[id] is .node-markup-slot-parameter
. keeps = if matched then no-instance else calls.demand-runtime-call(markup, no-type, program.store-atom("markup-branch-region-keeps-arm"), mark, 1)
. select = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom("markup-select-branch-region")
    - mark
    - 1
scratch.types.rewind(mark)
. batched = rooted || hosted
. trackers = if live.trackers != no-instance then trackers-type else no-type
    .. trackers-type = instances.signatures[live.trackers].returns
scratch.types.push(trackers)
scratch.types.push(live.callback)
scratch.types.push(if batched then batch-type() else host)
. action = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom(if batched then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
. structural = mark-structural(id, parent)
if create == no-instance || (keeps == no-instance && !matched) || uncalled
    decline(id)
    = invalid-type
.. uncalled = select == no-instance || action == no-instance || structural == no-instance
. made = instances.signatures[create].returns
if types.intrinsic-of(made) != .class || other-return
    decline(id)
    = invalid-type
.. other-return = instances.signatures[action].returns != types.live-action-type
if (!matched && instances.signatures[keeps].returns != types.bool-type) || actionless
    decline(id)
    = invalid-type
.. actionless = instances.live.has-actions == no-instance
if !raises-out(id, create) || !raises-out(id, action) || !raises-out(id, structural)
    decline(id)
    = invalid-type
if hosted
    conversions.convert(id, id, parent, batch-type(), .reason-markup-batch)
. ensure = region-ensure(id, made, batched, .reason-markup-region)
if !ensure
    = invalid-type
if !batched || is-markup-host(parent)
    conversions.convert(id, id, parent, host, .reason-markup-host)
frame.assign(resolution.slot, parent)
frame.assign(resolution.slot + 1, made)
frame.assign(resolution.slot + 2, if rooted then batch-type() else types.void-type)
. outer-content = region
region = region.content = content
region = region.keeps = keeps
region = region.select = select
. updater = demand-lambda(intern-nested(nested-decl-of(id)), scratch.no-types)
region = outer-content
if updater == no-instance || (updater-raises && live.callback-result == no-type)
    decline(id)
    = invalid-type
.. updater-raises = instances.signatures[updater].errors.count != 0
instances.mark-may-panic(instance)
facts.branch-regions += BranchRegion
    - instance
    - id
    - parent
    - content
    - list
    - selected
    - create
    - updater
    - action
    - structural
    - keeps
    - select
    - ensure
    - hosted
    - rooted
= made

────────────────────
_ do mark-structural InstanceId
    - id SyntaxId
    - owner TypeId

` The call that marks the action of a markup region structural, given the host that owns the
` action as the reference's `markupLiveAction` does: the parent of a branch or the region of a
` loop, where that is a markup host, so a batch runs the actions of outer regions before those
` of inner ones. The host, converted at the `if` or `for` to the `MarkupElement` it is, is converted
` there again to the optional the call takes. Where the owner is no markup host the call is
` given none.
. host = types.well-known-type("core/markup", "MarkupElement")
. optional = types.optional-of(host)
. mark = scratch.types.mark
scratch.types.push(types.live-action-type)
scratch.types.push(optional)
. structural = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("mark-structural-markup-action")
    - mark
scratch.types.rewind(mark)
if structural != no-instance && is-markup-host(owner)
    conversions.convert(id, id, host, optional, .reason-markup-structural)
= structural

────────────────────
_ do region-ensure InstanceId?
    - id SyntaxId
    - made TypeId
    - batched Bool
    - reason ConversionReason

` The call that puts a markup region under the batch the reference finds for its host, as
` `applyMarkupBatchRoot` does: none where no batch is found or the region is no markup host.
` The region is converted at the `if` or `for` to the host for the given reason, and the
` batch to the optional the call takes. One that has no shape here is declined, which is
` answered with nothing.
if !batched || !is-markup-host(made)
    = no-instance
. host = derived-interface(made, types.markup-host-decl)
. optional = types.optional-of(batch-type())
. mark = scratch.types.mark
scratch.types.push(host)
scratch.types.push(optional)
. ensure = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("ensure-markup-root")
    - mark
scratch.types.rewind(mark)
if ensure == no-instance || !raises-out(id, ensure)
    decline(id)
    = null
conversions.convert(id, id, made, host, reason)
conversions.convert(id, id, batch-type(), optional, .reason-markup-root)
= ensure

────────────────────
_ do arm-root Bool
    - body SyntaxId
    - content TypeId
    - slot SlotId

` The batch in force where a markup branch region is written, which the function that builds
` an arm is built under: read from the local that keeps it, and the region the arm is given
` put under it by `ensure-markup-root` first, where it is a markup host, as the reference's
` builder and then its `compileContents` each do. False, once declined, where that has no
` shape here.
. ensure = no-instance
if is-markup-host(content)
    . host = derived-interface(content, types.markup-host-decl)
    . optional = types.optional-of(batch-type())
    . mark = scratch.types.mark
    scratch.types.push(host)
    scratch.types.push(optional)
    ensure = calls.demand-runtime-call
        - types.markup-host-decl.module
        - no-type
        - program.store-atom("ensure-markup-root")
        - mark
    scratch.types.rewind(mark)
    if ensure == no-instance || !raises-out(body, ensure)
        decline(body)
        = false
    conversions.convert(body, body, content, host, .reason-markup-host)
    conversions.convert(body, body, batch-type(), optional, .reason-markup-root)
facts.region-roots += RegionRoot(instance, body, slot, batch-type(), ensure)
= true

────────────────────
_ do read-arms
    - id SyntaxId

` The conditions of a markup branch region read in turn, each tested as the condition of an
` `if` is, until one holds, and the subject of an arm written with a pattern, against which the
` pattern is tested (`test-pattern`); or the subject of a match region, against which each
` arm's pattern is tested in turn (`read-patterns`); or the name the parameter of a slot outlet
` that is a region gives, which must read the row's item as a getter, as the reference's
` `markupSlotOutletRebuildsOnArgument` asks.
do match? tree.nodes[id]
    | .node-match-expression(row)
        read-patterns(id, row.subject)
        =
    | .node-markup-slot-parameter(row)
        . value = infer(row.name)
        if value != invalid-type && not-row-item && !reads-getter(row.name)
            decline(row.name)
        .. not-row-item = facts.plan-of(instance, row.name) != .plan-row-item
        =
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                . subject = matched-subject(row.condition)
                . held = infer-unprojected(subject)
                if held == no-type
                    decline(subject)
                if held != no-type && held != invalid-type && !test-pattern(pattern, held)
                    =
            else if row.condition != 0
                tested-match = tested(row.condition)
                note-truthiness(row.condition, row.condition, infer(row.condition))
                tested-match = 0
            next = row.next
    arm = next

────────────────────
_ do read-patterns
    - id SyntaxId
    - subject SyntaxId

` The subject of a markup match region, read where the region is made and again by the function
` that selects its arm, against which each arm's pattern is tested in turn, binding nothing, as
` the reference's `markupMatchActiveArm` tests them. A pattern that tests with an expression of
` its own (`| x if x > 0`) has no shape here; one that can not match the subject is never tested.
. held = infer-unprojected(subject)
if held == no-type
    decline(subject)
if held == no-type || held == invalid-type
    =
for arm in tree.region-arms(id)
    if !test-pattern(arm, held)
        =

────────────────────
_ do test-pattern Bool
    - arm SyntaxId
    - held TypeId

` Tests the pattern of an arm of a match against a subject of a type, binding nothing. One that
` can not match is never tested; one that tests with an expression of its own has no shape here,
` and is declined, which answers false.
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if !tests-plainly(row.pattern)
            decline(arm)
            = false
        if !pattern-is-else(row.pattern) && !pattern-possible(row.pattern, held)
            facts.set-plan(instance, arm, .plan-never)
        else
            check-pattern(row.pattern, held)
= true

────────────────────
_ matched-subject SyntaxId
    - matching SyntaxId

` The subject of a match, or none.
match tree.nodes[matching]
    | .node-match-expression(row)
        row.subject
    ??
        0

────────────────────
_ do tests-plainly Bool
    - pattern SyntaxId

` Whether a pattern tests with no expression of its own that reads what it binds.
if pattern == 0
    = true
for node in tree.subtree-start(pattern) .. pattern
    if tree.nodes[node] is .node-type-predicate
        = false
= true

────────────────────
_ do bind-arm Bool
    - arm SyntaxId

` The subject of the match an arm of a markup match region, or of a branch region written with
` a pattern, is one of, read again by the function that builds the arm, where a member of the
` region's host read by its name alone is read from the host, kept where the region was made, and
` the arm's pattern matched against it, binding `it` and the names the pattern declares, as the
` reference's `markupCompileMatchedArm` does. False, once declined, where that has no shape here.
. subject = matched-subject(tree.arm-match(arm))
. resolution = bindings.resolution-of(frame.binding, tree.arm-site(arm))
if subject == 0 || resolution.kind != .resolve-slot
    decline(arm)
    = false
content-blocks += 0
content-parents += frame.slot-type(resolution.slot)
content-names += false
. held = infer-unprojected(subject)
content-blocks.pop()
content-parents.pop()
content-names.pop()
if held == no-type
    decline(subject)
if held == no-type || held == invalid-type
    = false
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if !pattern-is-else(row.pattern) && !pattern-possible(row.pattern, held)
            facts.set-plan(instance, arm, .plan-never)
            = true
        . it = arm-slot(arm, .slot-it)
        if it != no-slot
            frame.assign(it, held)
        check-pattern(row.pattern, held)
        . passed = passed-type(row.pattern, held)
        if it != no-slot && passed != held
            frame.assign(it, passed)
= true

────────────────────
_ do check-arm
    - body SyntaxId

` The function that builds an arm of a markup branch region: given the region, whose type is
` the host's content, it runs the arm's body as content of the region, under the styles, the
` rules written in rules, with the state cells it keeps (`take-scope`), and the batch in force
` where the region is written, as `arm-root` says. That of an arm of a match region first
` matches the arm's pattern against the subject (`bind-arm`). That of a slot outlet that is a
` region mounts the outlet's node as the region's content.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. content = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, body)
if resolution.kind != .resolve-slot || content == no-type
    decline(body)
    finish-errors(frame)
    close()
    =
frame.assign(resolution.slot, content)
. styled = markup-styles.length
if outer
    for style in outer.markup-styles
        markup-styles += style
    outer!.seen-sheets(markup-sheets, sheet-levels)
    sheets-given = outer!.sheets-known()
    for use in outer!.rule-scopes
        rule-scopes += take-scope(use)
    scopes-given = outer!.scopes-known()
    layer-given = outer!.markup-layer()
. rooted = if outer then outer.region.batch else false
if rooted && !arm-root(body, content, outer!.region.root)
    finish-errors(frame)
    close()
    =
. matched = tree.body-arm(body)
if matched != 0 && !bind-arm(matched)
    finish-errors(frame)
    close()
    =
content-blocks += body
content-parents += content
content-names += false
batched += rooted
if tree.nodes[body] is .node-slot-outlet
    . produced = check-statement(body, Want().adding(.want-content-line))
    link-content(body, produced, content)
else
    check-statement(body)
batched.pop()
content-blocks.pop()
content-parents.pop()
content-names.pop()
while markup-styles.length > styled
    markup-styles.pop()
finish-errors(frame)
close()

────────────────────
_ do check-branch-update
    - id SyntaxId

` The function the action of a markup branch region runs: it reads the conditions again, where
` a member of the region's host read by its name alone is read from the host, kept where the
` region was made, as is the region, given to the markup runtime as the host's content. What
` the markup runtime raises leaves the function, and the callback that runs it, as the
` reference's does.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. resolution = bindings.resolution-of(frame.binding, id)
. content = if outer then outer.region.content else no-type
if resolution.kind != .resolve-slot || content == no-type
    decline(id)
    finish-errors(frame)
    close()
    =
content-blocks += 0
content-parents += frame.slot-type(resolution.slot)
content-names += false
read-arms(id)
content-blocks.pop()
content-parents.pop()
content-names.pop()
conversions.convert(id, id, frame.slot-type(resolution.slot + 1), content, .reason-argument)
. keeps = outer!.region.keeps
if (keeps != no-instance && !raises-out(id, keeps)) || !raises-out(id, outer!.region.select)
    decline(id)
finish-errors(frame)
close()

────────────────────
_ do makes-region Bool
    - host TypeId

` Whether a markup host makes the regions of live loops and branches: a class declares
` `markup-make-region`, itself or in a base class, which the markup runtime calls for an empty
` region of the host's content to hold the region's controller. A host that is no class is left
` to the runtime.
=? true if types.intrinsic-of(host) != .class
= declares-method(host, program.store-atom("markup-make-region"))

────────────────────
_ do check-loop-region TypeId
    - id SyntaxId
    - parent TypeId

` A markup loop region, as the reference compiles one:
` one header, whose pattern is a name alone or none, with no clause but `keyed by`,
` by whose last one a function of its own keys each row (`check-key`).
` Its container is read in a live action of the region's own, where its read of a collection
` is no change the action follows, since the region observes the collection itself, and is the
` region's source as `loop-source` says. The host the `for` is content of must be a
` `MarkupElement`, whose `MarkupParent` gives the type of its content. Each row is built by a
` function of its own given the item, which gives one element as the host's content, made a
` `MarkupRowBuilder` at the `for`; that of a keyed loop over a collection is given a
` `MarkupRowItem` that holds the item, and made a `MarkupCollectionRowBuilder`. The key's
` function is made a `MarkupKeyBuilder` at its clause. The markup runtime makes the region of
` the host, the builders and the source, given last, as `loop-source` says, keyed where the loop
` is, and gives the region a source again by a replacer of its own; the region is the line's
` value, which the host takes. The host and the region are kept, in the
` two locals no name reaches declared at the `for`, for the function that reads the container
` again, which the action runs: made by
` `make-owner-markup-action`, owned by the region and marked structural. Where a batch is found
` for the host, the host itself where it is a batch and else the one in force, the region is
` put under it by `ensure-markup-root` once made; where one is in force it is kept in a third
` local no name reaches, which the rows are built under, and the action is made with it by
` `make-markup-action`. One whose region is no class is declined; one of a class with events
` is kept as any other, as the reference keeps it. One whose content is a class and whose host
` makes no regions, as `makes-region` says, is an error at the `for`.
. loop SyntaxId = 0
. body SyntaxId = 0
do match? tree.nodes[id]
    | .node-for-block(row)
        loop = row.loop
        body = row.body
. pattern SyntaxId = 0
. container SyntaxId = 0
. clause SyntaxId = 0
. chained SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        pattern = row.pattern
        container = row.container
        clause = row.clause
        chained = row.next
if chained != 0
    frame.diagnose(id, .stated, program.store-atom("Combined markup loops not supported"))
    = invalid-type
if pattern != 0 && !(tree.nodes[pattern] is .node-type-capture)
    frame.diagnose
        - pattern
        - .stated
        - program.store-atom("Markup loop patterns must be simple captures")
    = invalid-type
. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if row.op != .keyed-by-clause
                frame.diagnose
                    - current
                    - .stated
                    - program.store-atom("Markup loop only supports keyed by clauses")
                = invalid-type
            next = row.next
    current = next
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind != .resolve-slot
    decline(id)
    = invalid-type
. keyed = tree.keyed-clause(loop)
. read = infer(container, Want().adding(.want-observed))
if read == invalid-type || read == no-type
    = invalid-type
. found = loop-source(id, container, read)
. item = found.item
. source = found.given
if item == invalid-type
    = invalid-type
if !is-markup-host(parent)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup loop parent must implement MarkupElement")
    = invalid-type
. tree-host = derived-interface(parent, types.markup-tree-host-decl)
. content = if tree-host != no-type then first-arg(tree-host) else no-type
if content == no-type || content == invalid-type || types.completions[content].has-variables
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup loop host content type could not be resolved")
    = invalid-type
if types.intrinsic-of(content) == .class && !makes-region(parent)
    frame.diagnose(id, .stated, program.store-atom(message))
    .. message = "Markup loop host ${type-source(types, parent)} must declare markup-make-region, or extend MarkupNode"
    = invalid-type
if !one-element(body)
    = invalid-type
. refreshes = keyed != 0 && found.kind == "collection"
. given = if refreshes then types.well-known-type-of("core/markup", "MarkupRowItem", item) else item
. builder = types.well-known-type-of
    - "core/markup"
    - if refreshes then "MarkupCollectionRowBuilder" else "MarkupRowBuilder"
    - item
    - content
. decl = nested-decl-of(body)
if classless || builder == invalid-type || given == invalid-type || decl == 0
    decline(id)
    = invalid-type
.. classless = types.intrinsic-of(content) != .class
. rooted = in-batch()
. hosted = is-batch(parent)
. outer-content = region
region = region.content = content
region = region.batch = rooted
region = region.root = resolution.slot + 2
. built = demand-nested(decl, given)
region = outer-content
if built == no-instance
    decline(id)
    = invalid-type
. closure = intern-nested(decl)
facts.set-node-type(instance, body, closure)
if conversions.convert(id, id, closure, builder, .reason-markup-row) == invalid-type
    = invalid-type
. keyer = no-type
if keyed != 0
    keyer = types.well-known-type-of("core/markup", "MarkupKeyBuilder", item)
    . key = nested-decl-of(keyed)
    if keyer == invalid-type || key == 0 || demand-nested(key, item) == no-instance
        decline(id)
        = invalid-type
    . keying = intern-nested(key)
    facts.set-node-type(instance, keyed, keying)
    if conversions.convert(keyed, keyed, keying, keyer, .reason-markup-key) == invalid-type
        = invalid-type
demand-live-runtime()
. live = instances.live
. markup = types.markup-host-decl.module
. mark = scratch.types.mark
. optional = types.intrinsic-of(source) == .optional
. held = if optional then types.optional-inner(source) else source
scratch.types.push(item)
scratch.types.push(content)
scratch.types.push(parent)
scratch.types.push(held)
scratch.types.push(parent)
scratch.types.push(builder)
if keyer != no-type
    scratch.types.push(keyer)
scratch.types.push(source)
. creates = "markup-create-${if optional then "optional-" else ""}${if keyed != 0 then "keyed-" else ""}${found.kind}-region"
. create = calls.demand-runtime-call(markup, no-type, program.store-atom(creates), mark, 4)
scratch.types.rewind(mark)
. made = if create != no-instance then instances.signatures[create].returns else no-type
if made == no-type || types.intrinsic-of(made) != .class || !is-markup-host(made) || live.has-actions == no-instance
    decline(id)
    = invalid-type
scratch.types.push(item)
scratch.types.push(made)
scratch.types.push(held)
scratch.types.push(made)
scratch.types.push(source)
. replaces = "markup-replace-${if optional then "optional-" else ""}${found.kind}-source"
. replace = calls.demand-runtime-call(markup, no-type, program.store-atom(replaces), mark, 3)
scratch.types.rewind(mark)
if replace == no-instance
    decline(id)
    = invalid-type
. host = derived-interface(made, types.markup-host-decl)
scratch.types.push
    - if live.trackers != no-instance then instances.signatures[live.trackers].returns else no-type
scratch.types.push(live.callback)
scratch.types.push(if rooted then batch-type() else host)
. action = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom(if rooted then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
. structural = mark-structural(id, made)
if action == no-instance || structural == no-instance || other-return
    decline(id)
    = invalid-type
.. other-return = instances.signatures[action].returns != types.live-action-type
if !raises-out(id, create) || !raises-out(id, action) || !raises-out(id, structural)
    decline(id)
    = invalid-type
if hosted
    conversions.convert(id, id, parent, batch-type(), .reason-markup-batch)
. ensure = region-ensure(id, made, rooted || hosted, .reason-markup-region)
if !ensure
    = invalid-type
conversions.convert(id, id, made, host, .reason-markup-host)
frame.assign(resolution.slot, parent)
frame.assign(resolution.slot + 1, made)
frame.assign(resolution.slot + 2, if rooted then batch-type() else types.void-type)
. outer-source = region
region = region.source = source
region = region.replace = replace
. updater = demand-lambda(intern-nested(nested-decl-of(id)), scratch.no-types)
region = outer-source
if updater == no-instance || (updater-raises && live.callback-result == no-type)
    decline(id)
    = invalid-type
.. updater-raises = instances.signatures[updater].errors.count != 0
instances.mark-may-panic(instance)
facts.loop-regions += LoopRegion
    - instance
    - id
    - parent
    - content
    - source
    - create
    - updater
    - action
    - structural
    - ensure
    - hosted
    - rooted
    - replace
= made

────────────────────
_ do loop-source LoopSource
    - id SyntaxId
    - container SyntaxId
    - read TypeId

` The container of a markup loop region as the region's source, as the reference's
` `markupLoopSource` takes it: a concrete `Collection` as it is, made a region by
` `markup-create-collection-region`, and else one that supports a `Broadcastable` or an `Iterable`,
` in that order, converted to that interface at the container, made one by
` `markup-create-broadcastable-region` or `markup-create-iterable-region`. The item is the
` interface's, or where that is not concrete the container's own first, as the reference's
` `markupLoopItemType` takes it. One that is an `Indexable` alone is the reference's error, as is
` one that is a `Collection` but no concrete one, and one that supports none of these. One that
` converts to a `Collection`, which the reference gives the region unconverted, and an `Iterable`
` that is `Closable`, which the reference gives the region to close, have no shape here yet. An
` optional container is read by the type it holds, and given to the region as it is where that
` type is the interface or derives from it, and else converted to the interface made optional.
. none = LoopSource(invalid-type, no-type, "")
. optional = types.intrinsic-of(read) == .optional
. shape = if optional then types.optional-inner(read) else read
if types.intrinsic-of(shape) == .interface && indexable
    frame.diagnose(id, .stated, program.store-atom("Markup loop cannot observe Indexable sources because Indexable has no mutation events"))
    = none
.. indexable = same-decl(class-ref(types, shape), types.indexable-decl)
. supports = derived-interface(shape, types.collection-decl)
. kind = "collection"
if supports != no-type && types.intrinsic-of(shape) == .interface
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Markup loop requires a concrete Collection source")
    = none
. collects = supports != no-type
if supports == no-type && supported(shape, types.collection-decl) == no-type
    supports = supported(shape, types.broadcastable-decl)
    kind = "broadcastable"
if supports == no-type && supported(shape, types.collection-decl) == no-type
    supports = supported(shape, types.iterable-decl)
    kind = "iterable"
    if supports != no-type && derived-interface(shape, types.closable-decl) != no-type
        decline(id)
        = none
if supports == no-type
    if collection-shape || broadcasts || supported(shape, types.iterable-decl) != no-type
        decline(id)
    else if supported(shape, types.indexable-decl) != no-type
        frame.diagnose(id, .stated, program.store-atom("Markup loop cannot observe Indexable sources because Indexable has no mutation events"))
    else
        frame.diagnose
            - id
            - .stated
            - program.store-atom
                - "Markup loop source must be collection, broadcastable, or iterable"
    .. collection-shape = supported(shape, types.collection-decl) != no-type
    .. broadcasts = supported(shape, types.broadcastable-decl) != no-type
    = none
. item = first-arg(supports)
if item == no-type || item == invalid-type || types.completions[item].has-variables
    item = first-arg(shape)
if item == no-type || item == invalid-type || types.completions[item].has-variables
    decline(id)
    = none
if collects || (optional && derives)
    = LoopSource(item, read, kind)
.. derives = derived-interface(shape, if kind == "broadcastable" then types.broadcastable-decl else types.iterable-decl) != no-type
. given = supports
if types.completions[given].has-variables
    given = types.well-known-type-of
        - "core/stream"
        - if kind == "broadcastable" then "Broadcastable" else "Iterable"
        - item
if given == invalid-type
    = none
if optional
    given = types.optional-of(given)
if conversions.convert(container, container, read, given, .reason-argument) == invalid-type
    = none
= LoopSource(item, given, kind)

────────────────────
_ do one-element Bool
    - body SyntaxId

` Whether the body of a markup loop region gives one element, as the reference requires of a
` row: a line that is an `if`, or a second element, is its error at the body. A lazy
` declaration the binder found no getter in has no shape here.
do match? tree.nodes[body]
    | .node-block(block)
        . elements = 0u32
        for line in tree.children[block.body]
            do match? tree.nodes[line]
                | .node-declare(declared)
                    if declared.is-lazy && !declares-getter(declared.left)
                        decline(line)
                        = false
            if tree.nodes[line] is .node-if-block
                frame.diagnose(body, .stated, program.store-atom("A markup loop row must be one element; put its conditions in the element's properties"))
                = false
            if tree.nodes[line] is .node-markup
                elements += 1
        if elements > 1
            frame.diagnose
                - body
                - .stated
                - program.store-atom
                    - "A markup loop row must be one element; wrap its elements in one"
            = false
= true

────────────────────
_ do check-row
    - body SyntaxId

` The function that builds a row of a markup loop region: given the row's item, which the name
` the loop's header writes, `each` and `it` hold, it runs the loop's body as the body of a
` function, under the styles, the rules written in rules, with the state cells it keeps
` (`take-scope`), and the batch in force where the region is written, and gives
` what the body gives, converted to the content of the region's host at the body, as the
` reference casts it. An element that binds a slot written as a line of the body is the
` reference's error.
prepare()
. content = if outer then outer.region.content else no-type
. item = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, body)
if resolution.kind != .resolve-slot || content == no-type || item == no-type
    decline(body)
    finish-errors(frame)
    close()
    =
instances.set-returns(instance, content, content, .return-declared)
. lines [SyntaxId]
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            lines += statement
    ??
        lines += body
for line in lines
    do match? tree.nodes[line]
        | .node-markup(element)
            if element.slot-binding != 0
                frame.diagnose
                    - element.slot-binding
                    - .stated
                    - program.store-atom("Slot binding is only valid directly inside markup body")
                finish-errors(frame)
                close()
                =
frame.assign(resolution.slot, item)
if reads-eager-getter(body) && !is-row-item(resolution.slot, item)
    decline(body)
    finish-errors(frame)
    close()
    =
. styled = markup-styles.length
if outer
    for style in outer.markup-styles
        markup-styles += style
    outer!.seen-sheets(markup-sheets, sheet-levels)
    sheets-given = outer!.sheets-known()
    for use in outer!.rule-scopes
        rule-scopes += take-scope(use)
    scopes-given = outer!.scopes-known()
    layer-given = outer!.markup-layer()
. rooted = if outer then outer.region.batch else false
if rooted
    facts.region-roots += RegionRoot(instance, body, outer!.region.root, batch-type())
batched += rooted
value-syntax = body
. value = check-statement(body)
batched.pop()
while markup-styles.length > styled
    markup-styles.pop()
if value != invalid-type && value != no-type
    conversions.convert(body, value-syntax, value, content, .reason-return)
finish-errors(frame)
close()

────────────────────
_ do reads-eager-getter Bool
    - body SyntaxId

` Whether the body of a row declares a getter that is not lazy, which the binder finds in the
` row of any keyed loop region. The reference reads such a local as a getter only where the
` row is given a `MarkupRowItem`.
do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            do match? tree.nodes[line]
                | .node-declare(declared)
                    if !declared.is-lazy && declares-getter(declared.left)
                        = true
= false

────────────────────
_ do check-key
    - clause SyntaxId

` The function that keys a row of a markup loop region: given the row's item, which the name the
` loop's header writes, `each` and `it` hold, it gives the value of the `keyed by` clause,
` converted to a `String` at the value, as the reference casts it.
prepare()
. item = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, clause)
. expr SyntaxId = 0
do match? tree.nodes[clause]
    | .node-clause(row)
        expr = row.expr
if resolution.kind != .resolve-slot || item == no-type || expr == 0
    decline(clause)
    finish-errors(frame)
    close()
    =
instances.set-returns(instance, types.string-type, types.string-type, .return-declared)
frame.assign(resolution.slot, item)
. value = infer(expr)
if value != invalid-type && value != no-type
    conversions.convert
        - return-site(expr)
        - expr
        - value
        - types.string-type
        - .reason-return
        - true
        - true
finish-errors(frame)
close()

────────────────────
_ do read-row-item TypeId
    - id SyntaxId
    - held TypeId

` A name the row of a keyed markup loop region gives its item by, where the row's function is
` given a `MarkupRowItem`: the reference reads the holder's `item` by it, tracked.
. name = program.store-atom("item")
. place = types.property-named(held, name)
if !place
    decline(id)
    = invalid-type
track-read(id, held, name)
facts.set-plan(instance, id, .plan-row-item)
facts.row-item-reads += RowItemRead(instance, id, held)
= types.properties[place].type

────────────────────
_ do read-getter TypeId
    - id SyntaxId
    - slot SlotId

` A read of a local of a row of a markup loop region that the reference reads as a getter: the
` value its declaration writes, typed here, where it is made again, and read where the
` outermost such read is, which `reading.getter` keeps while it is. A second read in one
` function, and a local written with a type, have no shape here yet.
if getter-reads.find(slot) != null
    decline(id)
    = invalid-type
getter-reads += slot
do match? tree.nodes[bindings.slots[slot].getter]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.left]
            | .node-type-capture(capture)
                if capture.type != 0
                    decline(id)
                    = invalid-type
        . around = reading
        if reading.getter == 0
            reading = reading.getter = id
        . value = infer(declaration.right)
        reading = around
        if value != invalid-type && value != no-type
            facts.set-plan(instance, id, .plan-getter)
        = value
decline(id)
= invalid-type

────────────────────
_ do is-row-item Bool
    - slot SlotId
    - held TypeId

` Whether a local is the argument of the function that builds a row of a markup loop region,
` holding a `MarkupRowItem`.
if bindings.slots[slot].kind != .slot-argument || not-row-item
    = false
.. not-row-item = !same-decl(class-ref(types, held), types.markup-row-item-decl)
. scope = bindings.scopes[bindings.slots[slot].scope]
if scope.kind != .scope-nested
    = false
. decl = nested-decl-of(scope.syntax)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .row-decl
= false

────────────────────
_ do check-source-update
    - id SyntaxId

` The function the action of a markup loop region runs: it reads the container again, where its
` read of a collection is no change the action follows and a member of the region's host read by
` its name alone is read from the host, kept where the region was made, and gives what it gives
` to the region, kept there too, by the markup runtime's replacer for the region's source, which
` hands it to the region's controller. What that raises leaves the function, and the callback that
` runs it, as the reference's does.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. resolution = bindings.resolution-of(frame.binding, id)
. container SyntaxId = 0
do match? tree.nodes[id]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                container = loop.container
. expected = if outer then outer.region.source else no-type
if resolution.kind != .resolve-slot || container == 0 || expected == no-type
    decline(id)
    finish-errors(frame)
    close()
    =
content-blocks += 0
content-parents += frame.slot-type(resolution.slot)
content-names += false
. read = infer(container, Want().adding(.want-observed))
content-blocks.pop()
content-parents.pop()
content-names.pop()
. source = if read != invalid-type then loop-source(id, container, read).given else no-type
. replace = if outer then outer.region.replace else no-instance
if source != expected || replace == no-instance || !raises-out(id, replace)
    decline(id)
finish-errors(frame)
close()

────────────────────
_ do host-content
    - statement SyntaxId
    - parent TypeId

` An `if`, a `for`, and a loop written with `in` that is no function of its own, written as
` lines of a markup element's body, run their bodies as content of the same element: each body
` is noted as such while the statement is typed. A loop on a stream subscribes, and its body
` is no content, the arms of a markup branch region are content of the region, which functions
` of their own build, and the body of a markup loop region builds a row.
if is-region(statement) || is-loop-region(statement)
    =
do match? tree.nodes[statement]
    | .node-if-block
        . branch = statement
        while branch != 0
            . next SyntaxId = 0
            do match? tree.nodes[branch]
                | .node-if-block(row)
                    content-blocks += tree.arm-body(branch)
                    content-parents += parent
                    content-names += false
                    next = row.next
            branch = next
    | .node-for-block(row)
        if is-subscriber-loop(row.loop)
            =
        content-blocks += row.body
        content-parents += parent
        content-names += true
    | .node-iterator-expression(row)
        if nested-decl-of(statement) != 0
            =
        content-blocks += row.body
        content-parents += parent
        content-names += true

────────────────────
_ do link-content
    - statement SyntaxId
    - produced TypeId
    - parent TypeId

` A line of a markup element's body that gives a value is taken by the element: by its
` `+=`, or else its `++=`, with the value converted as an argument of the one found, or where
` the element is a markup host as `link-hosted` says. The call is kept for the line. An
` assignment, a print and a state machine give the element nothing, and a loop written as an
` expression has no shape as a line. An element no local is declared for, named for the property
` its class's markup declares for it, gives the property what the call answers, or the object
` where it answers nothing.
if untyped || produced == types.void-type || is-quasi-syntax(statement)
    =
.. untyped = produced == no-type || produced == invalid-type
if tree.nodes[statement] is .node-state-machine
    =
if tree.nodes[statement] is .node-iterator-expression
    decline(statement)
    =
if is-markup-host(parent)
    link-hosted(statement, produced, parent)
    =
. content = calls.content-call(parent, program.store-atom("+="), statement, produced)
if content.taken == no-type
    content = calls.content-call(parent, program.store-atom("++="), statement, produced)
. taken = content.taken
. link = content.fact
. answered = content.answer
if taken == no-type || link == no-fact
    frame.diagnose(statement, .stated, program.store-atom("Content not accepted"))
    =
conversions.convert(statement, statement, produced, taken, .reason-argument)
. answers = no-type
. named = named-element(statement)
if named && answered != no-type
    if answered == invalid-type
        decline(statement)
        =
    if conversions.convert(statement, statement, answered, frame.slot-type(named), .reason-assignment, true, true) == invalid-type
        =
    answers = answered
facts.note-content-link(ContentLink(instance, statement, parent, taken, link, answers))
if named
    note-named(statement, if answers != no-type then answers else frame.slot-type(named))
else if content-named(statement)
    note-named
        - statement
        - if answered != no-type && answered != types.void-type then answered else produced

────────────────────
_ do link-hosted
    - statement SyntaxId
    - produced TypeId
    - parent TypeId

` A line of the body of a markup element whose class is a markup host is taken through the
` markup protocol: by the host's `markup-absorb` where the value is an argument of one, which
` keeps it in the host's own state; else by its `markup-content`, which answers the node the
` value becomes, and that node is linked as the host's last child by the markup runtime's
` `markup-append`. A line that is an element a name is declared for gives the name the node,
` converted as a value assigned to the name, which casts it, checked, to the element's class;
` but where the element gives slots content and its name is a property of the class the markup
` is run on, the name and the property keep the object, as the reference keeps it there. One no
` local is declared for, named for the property its class's markup declares for it, gives the
` property the node, or the object where the host absorbs it.
. absorbing = calls.content-call(parent, program.store-atom("markup-absorb"), statement, produced)
. absorbed = absorbing.taken
if absorbed != no-type
    conversions.convert(statement, statement, produced, absorbed, .reason-argument)
    facts.note-content-link(ContentLink(instance, statement, parent, absorbed, absorbing.fact))
    . kept = named-element(statement)
    if kept
        note-named(statement, frame.slot-type(kept))
    else if content-named(statement)
        note-named(statement, produced)
    =
. content = calls.content-call(parent, program.store-atom("markup-content"), statement, produced)
. taken = content.taken
. link = content.fact
. answered = content.answer
if taken == no-type || link == no-fact || answered == no-type
    frame.diagnose(statement, .stated, program.store-atom("Content not accepted"))
    =
. named = named-element(statement)
if answered == invalid-type
    decline(statement)
    =
conversions.convert(statement, statement, produced, taken, .reason-argument)
. kept = named && !binds-property(statement)
if kept && conversions.convert(statement, statement, answered, frame.slot-type(named!), .reason-assignment, true, true) == invalid-type
    =
. mark = scratch.types.mark
scratch.types.push(parent)
scratch.types.push(answered)
. append = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("markup-append")
    - mark
scratch.types.rewind(mark)
if append == no-instance
    decline(statement)
    =
. answers = if kept then answered else no-type
facts.note-content-link(ContentLink(instance, statement, parent, taken, link, answers, append))
if kept
    note-named(statement, answered)
else if content-named(statement)
    note-named(statement, answered)
else if named
    note-named(statement, frame.slot-type(named))

────────────────────
_ do note-named
    - statement SyntaxId
    - held TypeId

` A markup element a block declares a name for, in a function run on an object whose class
` has a property of that name: once the element's line has run, the reference stores in the
` property what the name then holds, as `named-place` says.
do match? tree.nodes[statement]
    | .node-markup(row)
        . place = named-place(statement, row.id, held)
        if place
            facts.note-named-store(NamedStore(instance, statement, place))

────────────────────
_ do content-named Bool
    - statement SyntaxId

` Whether a line of content is a markup element that no block declares a local for, whose name
` is that of the property the markup of the class declares for it (`names-content-property`).
do match? tree.nodes[statement]
    | .node-markup(row)
        = unslotted && names-content-property(statement, row.id)
            .. unslotted = row.id != 0 && !element-slot(statement, row.id)
= false

────────────────────
_ do names-content-property Bool
    - element SyntaxId
    - name SyntaxId

` Whether the name of a markup element is that of a property the markup of the class of the
` object the function runs on declares for its elements of that name, where the element is one
` of them: written in that markup outside any function or loop of it. The reference gives such
` a property each such element's object, as `named-place` says.
if bindings.resolution-of(frame.binding, name).kind != .resolve-member
    = false
. self = frame.self-type
if self == no-type || self == invalid-type || types.intrinsic-of(self) != .class || lacks-self()
    = false
. text = identifier-name(tree, name)
. place = types.property-named(self, text) if text
if !place
    = false
. ref = declaring-class(types, types.properties[place].owner, text!)
. member = owner-property(program, ref.module, ref.decl, text!)
if member == 0
    = false
. content SyntaxId = 0
do match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        content = class.content
do match? program.modules[ref.module].decls[member]
    | .decl-property(declared)
        = owned && tree.subtree-start(content) <= element && !enclosed-element(element, content)
            .. owned = declared.element != 0 && ref.module == module && content > element
= false

────────────────────
_ do enclosed-element Bool
    - element SyntaxId
    - content SyntaxId

` Whether a markup element of a class's markup is written in a function or a loop there.
for node in element + 1 .. < content
    if tree.subtree-start(node) <= element
        do match? tree.nodes[node]
            | .node-function-syntax
                = true
            | .node-for-block
                = true
= false

────────────────────
_ do named-place U32?
    - site SyntaxId
    - name SyntaxId
    - held TypeId

` The property of the class of the object a function is run on that the name of a markup
` element names, which the reference stores what the name holds in, converted at `site` as a
` value the property is given; or none. A property that the markup written in a class declared
` for an element is stored only by that markup, and a lazy one is given its value as an
` assignment gives it. A store that has no shape here is declined: in a function written in
` another, but one that builds a slot or gives a name its object (`in-slots`), or of a
` property not stored in the object, private to another module, or an array.
. self = frame.self-type
if self == no-type || self == invalid-type || types.intrinsic-of(self) != .class || lacks-self()
    = null
. text = identifier-name(tree, name)
. place = types.property-named(self, text) if text
if !place
    = null
. property = types.properties[place]
. ref = declaring-class(types, property.owner, text!)
. member = owner-property(program, ref.module, ref.decl, text!)
do match? program.modules[ref.module].decls[member]
    | .decl-property(declared)
        if member != 0 && declared.element != 0
            . owner = program.modules[ref.module]
            . fills = false
            do match? owner.decls[ref.decl]
                | .decl-class(class)
                    fills = ref.module == (module) && class.content-function == written-decl()
            if !fills
                = null
. type = property.type
if type == no-type
    type = demand-member(property, self, text!)
. kept = property.storage-kind == .storage-eager || property.storage-kind == .storage-lazy
. stored = kept && type != no-type && type != invalid-type
if !in-slots() || !stored || is-hidden(property, text!, .setter-decl) || is-array-value(type)
    decline(site)
    = null
if conversions.convert(site, site, held, type, .reason-declaration, true, true) == invalid-type
    = null
. written = panics.property-of(self, text!)
if written
    panics.note-write(instance, written)
= place as U32

────────────────────
_ in-slots Bool

` Whether this function is no function written in another, or one written in such a one that
` builds a slot, gives a markup element's name its object, or builds a row of a markup loop
` region or an arm of a branch region, which run on the same object.
if builds-in-place() then outer != null && outer.in-slots() else outer == null

────────────────────
_ builds-in-place Bool

` Whether this function builds a slot, gives a markup element's name its object, or builds a row
` of a markup loop region or an arm of a branch region, for the function it is written in.
kind == .slot-decl || kind == .binder-decl || kind == .row-decl || kind == .branch-arm-decl

.. kind = frame.declaration.kind

────────────────────
_ written-decl DeclId

` The function this one is, or that it is written in where it builds what it is written in
` builds (`builds-in-place`).
if builds-in-place() && outer then outer.written-decl() else frame.decl

────────────────────
_ do named-element SlotId?
    - statement SyntaxId

` The local a line of content that is a markup element declares for the element, where a
` block declares one.
do match? tree.nodes[statement]
    | .node-markup(row)
        = element-slot(statement, row.id)
= null

────────────────────
_ element-slot SlotId?
    - element SyntaxId
    - name SyntaxId

` The local a block declares for a markup element written with a name. A name no block
` declares for the element may find a local something else declared, which is not one.
|? name == 0
    null
|? slot && bindings.slots[slot].group == element
    slot
??
    null

.. slot = declaring-slot(name)

────────────────────
_ is-placed Bool
    - slot SlotId

` Whether the local declared for a markup element's name is given the element's object where
` the element is written, which no block makes where it starts.
(bindings.slots[slot].flags /and/ SlotFlag.slot-placed) != 0

────────────────────
_ reads-before-placing Bool
    - read SyntaxId
    - slot SlotId

|? frame.declaration.kind != .slot-decl
    false
??
    element >= range.start && element < range.start + range.count && after-read

.. element = bindings.slots[slot].group
.. range = frame.declaration.subtree
.. after-read = tree.subtree-start(element) > read

────────────────────
_ places-across Bool
    - slot SlotId

` Whether a local a function this one is written in declares for a markup element's name is
` reached through functions that build slots alone, from this one out to the one that
` declares it.
|? !outer || !frame.is-captured(slot)
    true
|? frame.declaration.kind != .slot-decl
    false
??
    outer.places-across(slot)

────────────────────
_ do assign-placed
    - slot SlotId
    - made TypeId

` Gives the local declared for a markup element's name the element's object, in the function
` that declares it.
if outer && frame.is-captured(slot)
    outer.assign-placed(slot, made)
else
    frame.assign(slot, made)

────────────────────
_ do infer-index Found
    - id SyntaxId
    - object-syntax SyntaxId
    - key-syntax SyntaxId
    - is-optional Bool
    - want Want

. object-found = infer-found(object-syntax, Want().adding(.want-event))
. object = object-found.type
if object-found.event != U32.max
    = address-event(id, key-syntax, is-optional, found-events[object-found.event], want)
. own = object-found.link
. key = infer(key-syntax)
if object == invalid-type || key == invalid-type
    = Found(invalid-type)
. sized = sized-array(id, object, key-syntax, key)
if sized != no-type
    = Found(sized)
. form = if is-optional then note-chain(id, id, object) else ChainForm.chain-plain
if form == .chain-absent || absent-after(object-syntax, object)
    = Found(types.null-type)
. optional = form == .chain-tested
. receiver = link-receiver(object-syntax, object, own, optional)
. chained = (optional || optional-chained(object-syntax)) && types.is-optional(object)
. pointee = cpointer-item(receiver)
if pointee == types.void-type
    frame.diagnose(id, .stated, program.store-atom("Void has no physical address"))
    = Found(invalid-type)
if pointee != no-type
    facts.set-plan(instance, id, .plan-item)
    = Found(if chained then types.optional-of(pointee) else pointee).linking(pointee)
. field = tuple-field(receiver, key-syntax)
. positional = field != no-type
if field == no-type
    field = view-index(receiver, key-syntax)
    if field != no-type
        plan-view(id, eager-slot(row-struct-of(receiver), key-syntax))
if field == no-type
    field = aggregate-field(receiver, key-syntax, key, types.index-op-atom!)
    positional = field != no-type
if field != no-type
    . read = if chained then types.optional-of(field) else field
    if positional
        note-field(id, receiver, key-syntax)
        facts.set-node-type(instance, id, read)
    = Found(read).linking(field)
. cell = view-cell(id, object-syntax, receiver, key-syntax, key)
if cell != no-type
    = Found(if chained && cell != invalid-type then types.optional-of(cell) else cell).linking(cell)
. chosen = selection-key(receiver, key)
. diagnosed = facts.diagnostics.length
. first-call FactId = facts.calls.length as FactId
. tabled = is-table-view(receiver)
. result = calls.operator-call
    - id
    - receiver
    - types.index-op-atom!
    - key-syntax
    - chosen
    - tabled
    - object-syntax
if result == invalid-type
    restate-index(diagnosed, id, receiver, key-syntax)
    = Found(result)
if !plan-table-index(id, object-syntax, receiver, key-syntax, key, result)
    = Found(invalid-type)
if tabled && !facts.answers-in-place(instance, id)
    frame.forget-members()
if !optional
    calls.plan-array-item(id, key, first-call, result)
= Found(if chained then types.optional-of(result) else result).linking(result)

────────────────────
_ link-receiver TypeId
    - object-syntax SyntaxId
    - object TypeId
    - own TypeId
    - is-optional Bool

` What a read, an index or a call reads from. A link of an optional chain written after `?`
` reads from what the optional before it holds. A link written with no `?` after another
` link reads from what that link gives by itself, which the chain holds in no optional
` between its links: `own`, what typing the link before found it to give (`Found.link`).
` Anything else reads from the value as it is.
|? object == invalid-type || object == no-type || !types.is-optional(object)
    object
|? is-optional
    types.optional-inner(object)
|? !optional-chained(object-syntax)
    object
??
    if own != no-type then own else types.optional-inner(object)

────────────────────
_ do note-field
    - id SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId

` Records which stored field of a tuple or struct a constant index names, as the constant of
` the node that reads or assigns it. The index one past the last field names the place a new
` field would take. A tuple with no name stores every field it has, in order, so the index
` is the field.
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . wanted = parse-integer-literal(row.value).value
        . range = types.completions[receiver].properties
        if is-plain-tuple(receiver)
            if wanted < range.count
                . held = types.properties[(range.start + wanted) as Index].slot as U64
                facts.set-constant(instance, id, ConstantFact(held, 0, null, false), .plan-field)
            else if wanted == range.count
                facts.set-constant(instance, id, ConstantFact(wanted, 0, null, false), .plan-field)
            =
        . position U64
        . place U64
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind != .storage-eager
                continue
            if position == wanted
                place = property.slot
                break
            position += 1
            place = (property.slot as U64) + 1
        if position == wanted
            facts.set-constant(instance, id, ConstantFact(place, 0, null, false), .plan-field)

────────────────────
_ do restate-index
    - diagnosed Size
    - id SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId

` A tuple or struct with no index operator of its own is indexed by position, which must be a
` constant that names one of its fields.
if tuple-arity(receiver) == U32.max || column-receiver || indexes-itself(receiver)
    =
.. column-receiver = is-column-receiver(types.intrinsic-of(receiver))
. message = if literal-key then "Index out of bounds" else "Value has no constant form"
    .. literal-key = is-integer-literal(key-syntax)
facts.restate(diagnosed, instance, id, .illegal-operation, .stated, program.store-atom(message))

────────────────────
_ do selection-key TypeId
    - receiver TypeId
    - key TypeId

` A table selects rows by an array of indices as it does by an immutable array of them.
. kind = types.intrinsic-of(receiver)
if kind != .table && kind != .immutable-table
    = key
do match? types.rows[key]
    | .type-class(row)
        if same-decl(DeclRef(row.module, row.decl), types.array-decl)
            . mark = scratch.types.mark
            for position in 0 .. < row.args.count
                scratch.types.push(types.child-type(row.args, position))
            . owner = types.immutable-array-decl
            = types.intern-class(owner.module, owner.decl, mark)
= key

────────────────────
_ do tuple-field TypeId
    - receiver TypeId
    - key-syntax SyntaxId

. fields = RowRange'TypeId()
do match? types.rows[receiver]
    | .type-tuple(row)
        fields = row.fields
if fields.count == 0
    = no-type
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if !literal.negative && !literal.overflow && literal.value < fields.count
            = types.child-type(fields, literal.value as U32)
= no-type

────────────────────
_ do check-task
    - id SyntaxId

. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        . mask = callee-effects(frame, module, nested.decl)
        . none = scratch.no-types
        . callee = instances.intern(module, nested.decl, no-type, mask, instance, none, none, false)
        if instances.rows[callee].state == .instance-unstarted
            facts.task-bodies += callee
            run-within(callee, this)
        facts.record-call(instance, id, callee, .call-task, scratch.no-fills, false)
        demand-panic-report()
        =

────────────────────
_ do check-region
    - id SyntaxId
    - body SyntaxId

` A `do @no-gc` block written where code is outside the zone the collector never sees, as the
` reference outlines it: a function of its own, typed once, which reaches the locals and
` arguments of the function around it where they are kept and is called where the block is.
` What the flow knows of those locals holds in the body as in a plain block, and what the body
` leaves them as holds after it (`leave-region`). The call ends what is known of properties, as
` any call does. A block whose last line returns or raises is the reference's error. One that
` lets an error out has no shape here.
if ends-returning(body)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("GC-free do blocks cannot return from their enclosing function")
    =
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        . mask = callee-effects(frame, module, nested.decl)
        . none = scratch.no-types
        . callee = instances.intern(module, nested.decl, no-type, mask, instance, none, none, false)
        . left [Narrowed]
        if instances.rows[callee].state == .instance-unstarted
            facts.region-bodies += callee
            left = run-within(callee, this)
        if instances.signatures[callee].errors.count != 0
            decline(id)
            =
        facts.record-call(instance, id, callee, .call-function, scratch.no-fills, false)
        if instances.rows[callee].may-panic
            instances.mark-may-panic(instance)
        forget-assigned(nested)
        frame.keep-assigned(left)
        frame.forget-members()
        =
decline(id)

────────────────────
_ do forget-assigned
    - nested NestedFunction

` Each local a `do @no-gc` block assigns is known past the block as its own type, until what
` the body left it as is known again (`leave-region`): a body typed before is not typed again.
for index in 0 .. < nested.captures.count
    . capture = bindings.captures[nested.captures.start + index]
    if (capture.flags /and/ CaptureFlag.capture-assigned) == 0
        continue
    . held = slot-known(capture.slot)
    if held == no-type || held == invalid-type
        continue
    frame.push-assigned(slot-key(capture.slot), held)
    frame.reset-paths(slot-key(capture.slot))

────────────────────
_ do ends-returning Bool
    - body SyntaxId

` Whether the last line of a block returns or raises a panic or an error with no condition.
do match? tree.nodes[body]
    | .node-block(block)
        if block.body.count == 0
            = false
        do match? tree.nodes[tree.children[block.body.start + block.body.count - 1]]
            | .node-return
                = true
            | .node-assertion-syntax(row)
                = row.condition == 0
= false

────────────────────
_ do check-machine-site TypeId
    - id SyntaxId

` A state machine where it is written: its own function, typed once, is called there to start
` it, recorded at the machine, and answers the value it starts in, of the machine's union. The
` errors that leave its start leave the function there (see `check-machine`). A machine the
` binder bound no function for has no shape here.
. decl = nested-decl-of(id)
if decl == 0
    decline(id)
    = invalid-type
. callee = demand-nested(decl, no-type)
do facts.record-call(instance, id, callee, .call-function, scratch.no-fills, false)
note-unit-errors(callee, id)
. machine = facts.machine-of(callee)
= if machine then facts.root-machine(machine).union else invalid-type

────────────────────
_ do check-machine
    - id SyntaxId

` The function of a state machine, typed as one body though the emitter makes several functions
` of it: the one that starts it, and for each group of event transitions the one its
` subscriber runs. Its shape is checked first (`machine-shape`), then each part is typed once,
` in an order where what it reads is known (`type-machine`). It answers its union where it
` starts. One that refines the machine of a property of its class's base answers nothing: that
` machine starts after it, and keeps the value (`inherited-machine`).
prepare()
. items = tree.state-items(tree.state-body(id))
. row = bindings.machine-slots(module, id)
. store = machine-placement(id, row) if row
. union = no-type
machine-handed = false
machining = machining.outer-starts = true
machining = machining.refined = no-instance
. refined = inherited-machine(id, items, store) if row && store
if !row || !store
    decline(id)
else if refined && machine-shape(id, items, store)
    machining = machining.refined = refined
    union = type-machine(id, items, row, store)
. answered = if union != no-type && machining.refined == no-instance then union else types.void-type
instances.set-returns(instance, answered, answered, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do inherited-machine InstanceId?
    - id SyntaxId
    - items [SyntaxId]
    - store MachineStore

` The machine a property's machine refines, as the reference merges them: that of the property
` of the same name of the base of the class, through the instance that types the base's value
` for the class that declares it, as the class the machine is typed for holds it, which every
` class below shares, where the base has one; no instance where it has none, or the machine
` is no property's. A
` property of that name that holds no machine is the reference's error, as is a refinement that
` changes what the reference forbids (`refines-shaped`). One a class's markup writes refines that
` of the markup of a class above (`inherited-content-machine`).
if store == .store-content
    = inherited-content-machine(id, items)
if store != .store-member
    = no-instance
. property = machine-property(id)
. decls = program.modules[module].decls
. name Atom? = null
. owner-decl DeclId = 0
. site = id
do match? decls[property]
    | .decl-property(found)
        name = found.name
        owner-decl = found.owner
        site = found.syntax
if !name || owner-decl == 0
    = no-instance
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type
    = no-instance
types.complete(owner)
. base = types.base-of(owner) ?? no-type
. place = types.property-named(base, name) if base != no-type
if !place
    = no-instance
. level = types.properties[place].owner
. ref = class-ref(types, level)
. inherited = class-property(ref, name)
. value = declared-value(ref.module, inherited)
. machine = program.modules[ref.module].tree.declared-machine(value)
if machine == 0
    . message = "Inherited property '${name.text}' is not a state machine"
    frame.diagnose(site, .stated, program.store-atom(message))
    = null
. enclosing = instances.rows[instance].enclosing
. receiver = if enclosing != no-instance then holding-type(enclosing-self, ref) else level
    .. enclosing-self = instances.rows[enclosing].self-type
. unit = instances.intern-initializer(ref.module, inherited, receiver)
if instances.rows[unit].state == .instance-in-progress
    decline(id)
    = null
demand-own-body(unit)
for found in facts.machines
    . same = found.module == ref.module && found.syntax == machine && found.outer == 0
    if same && instances.rows[found.instance].enclosing == unit
        . names [Atom]
        . parents [U32]
        inherited-cases(found, names, parents)
        if !refines-shaped(items, U32.max, names, parents)
            = null
        = found.instance
decline(id)
= null

────────────────────
_ do inherited-content-machine InstanceId?
    - id SyntaxId
    - items [SyntaxId]

` The machine a machine written as a line of a class's markup refines, as a property's machine
` refines its base's: the first machine of the markup of a class above, from the nearest up,
` that has a case at its root of a name one of this machine's cases at its root has, through
` the function that fills the object with that class's markup, which the function this machine
` is written in runs; no instance where none has. A refinement that changes what the reference
` forbids is its error (`refines-shaped`).
. roots [Atom]
for item in items
    if tree.nodes[item] is .node-state-case
        roots += tree.state-name(item)!
. fill = instances.rows[instance].enclosing
while fill != no-instance
    . call = facts.filler-of(fill)
    if call == no-fact
        = no-instance
    fill = facts.calls[call].callee
    . level = instances.rows[fill].self-type
    if level == no-type || level == invalid-type
        = no-instance
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module].tree
    . content SyntaxId = 0
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            content = class.content
    for machine in owner.content-machines(content)
        if names-root(owner, machine, roots)
            if instances.rows[fill].state == .instance-in-progress
                decline(id)
                = null
            demand-own-body(fill)
            for found in facts.machines
                . same = found.module == ref.module && found.syntax == machine && found.outer == 0
                if same && instances.rows[found.instance].enclosing == fill
                    . names [Atom]
                    . parents [U32]
                    inherited-cases(found, names, parents)
                    if !refines-shaped(items, U32.max, names, parents)
                        = null
                    = found.instance
            decline(id)
            = null
= no-instance

────────────────────
_ do names-root Bool
    - owner AST
    - machine SyntaxId
    - roots [Atom]

` Whether a machine has a case at its root of one of some names.
for item in owner.state-items(owner.state-body(machine))
    if owner.nodes[item] is .node-state-case && roots.find(owner.state-name(item)!) != null
        = true
= false

────────────────────
_ do class-property DeclId
    - ref DeclRef
    - name Atom

` The property of a name a class declares, or none.
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(class)
        . place = owner.first-member(class.members, name)
        while place != no-member
            . member = owner.member-pool[place]
            place = owner.member-links[place]
            do match? owner.decls[member]
                | .decl-property(row)
                    if row.name && row.name == name
                        = member
= 0

────────────────────
_ do declared-value SyntaxId
    - owner ModuleId
    - property DeclId

` The value a property of a module declares, or none.
if property == 0
    = 0
do match? program.modules[owner].decls[property]
    | .decl-property(row)
        = row.value
= 0

────────────────────
_ do inherited-cases
    - machine MachineFact
    - names [Atom]
    - parents [U32]

` The cases a machine has, each with the place of the case it is written in, or none at the
` root: those written in it, and where it refines another machine, those of that machine with
` the ones it adds.
. owner = program.modules[machine.module].tree
. items = owner.state-items(owner.state-body(machine.syntax))
if machine.refined == no-instance
    written-cases(owner, items, U32.max, names, parents)
    =
. above = facts.machine-of(machine.refined)
if !above
    =
inherited-cases(above, names, parents)
added-cases(owner, items, U32.max, names, parents)

────────────────────
_ do written-cases
    - owner AST
    - items [SyntaxId]
    - parent U32
    - names [Atom]
    - parents [U32]

` Each case written in a body and in theirs, under the case at a place.
for item in items
    if owner.nodes[item] is .node-state-case
        . place = names.length as U32
        names += owner.state-name(item)!
        parents += parent
        written-cases(owner, owner.state-items(owner.state-body(item)), place, names, parents)

────────────────────
_ do added-cases
    - owner AST
    - items [SyntaxId]
    - parent U32
    - names [Atom]
    - parents [U32]

` The cases a refinement's body adds under the case at a place: one it names again is refined,
` and adds those of its own body; any other is added with each case written in it.
for item in items
    if owner.nodes[item] is .node-state-case
        . found = case-under(owner.state-name(item)!, parent, names, parents)
        if found != U32.max
            added-cases(owner, owner.state-items(owner.state-body(item)), found, names, parents)
        else
            . place = names.length as U32
            names += owner.state-name(item)!
            parents += parent
            written-cases(owner, owner.state-items(owner.state-body(item)), place, names, parents)

────────────────────
_ do case-under U32
    - name Atom
    - parent U32
    - names [Atom]
    - parents [U32]

` The place of the case of a name written under the case at a place, or none.
for place in 0 .. < names.length
    if names[place] == name && parents[place] == parent
        = place as U32
= U32.max

────────────────────
_ do refines-shaped Bool
    - items [SyntaxId]
    - parent U32
    - names [Atom]
    - parents [U32]

` Whether a refinement's body changes only what the reference lets it, under the case of the
` inherited machine at a place: each case it names again keeps that case's trigger and what it
` holds, and each case it adds is written under a case, with a name the inherited machine does
` not use. Anything but a case written at the root has no shape here yet.
for item in items
    if !(tree.nodes[item] is .node-state-case)
        if parent == U32.max
            decline(item)
            = false
        continue
    . name = tree.state-name(item)!
    . found = case-under(name, parent, names, parents)
    if found == U32.max
        if names.find(name) != null
            . message = "State case '${name.text}' is declared elsewhere in the inherited machine"
            frame.diagnose(item, .stated, program.store-atom(message))
            = false
        if parent == U32.max
            . message = "Refinement cannot add top-level state case '${name.text}'"
            frame.diagnose(item, .stated, program.store-atom(message))
            = false
        continue
    if tree.state-targets(item).count != 0 || tree.state-trigger(item) != 0
        . message = "Refined state case '${name.text}' cannot change its trigger or payload"
        frame.diagnose(item, .stated, program.store-atom(message))
        = false
    if !refines-shaped(tree.state-items(tree.state-body(item)), found, names, parents)
        = false
= true

────────────────────
_ do machine-placement MachineStore?
    - id SyntaxId
    - row MachineSlots

` Where a machine keeps its value: in the local or the lazy local it is declared into, which
` starts it where it is first read, in the global of the module or the property of the class it
` is the value of, in the flags of the object whose markup it is a line of, or nowhere, written
` as a statement of a function that is no markup of a class. One written in the markup of a
` class otherwise has no shape here yet.
if row.bound != no-slot
    . kind = bindings.slots[row.bound].kind
    = .store-local if kind == .slot-local || kind == .slot-lazy
. property = machine-property(id)
if property != 0
    do match? program.modules[module].decls[property]
        | .decl-property(found)
            = if found.owner == 0 then .store-global else .store-member
    = null
. owner = frame.outer
if owner && owner.declaration.is-content
    = .store-content if tree.content-machines(owner.declaration.syntax).find(id) != null
= .store-none

────────────────────
_ do machine-property DeclId
    - id SyntaxId

` The property of the module whose value a machine is, or none.
. decls = program.modules[module].decls
for position in 0 .. < decls.length
    do match? decls[position]
        | .decl-property(property)
            if property.value == id
                = position as DeclId
= 0

────────────────────
_ do machine-shape Bool
    - id SyntaxId
    - items [SyntaxId]
    - store MachineStore

` Whether a machine is one the reference builds: no case is written twice, each fallback
` follows a group of transitions, each handler is on one source with at most a `when`, no
` decision made on entry enters a case again (`entries-settle`), and one a local, a global or a
` property names starts in a case. Each is the reference's error. A
` fallback that names values, and a case of a machine of a class's markup whose name the class
` declares otherwise, have no shape here yet.
. redefined = tree.redefined-case(items)
if redefined != 0
    . name = tree.state-name(redefined)!
    frame.diagnose
        - redefined
        - .stated
        - program.store-atom("Redefinition of state case '${name.text}'")
    = false
. misplaced = tree.misplaced-fallback(items)
if misplaced != 0
    frame.diagnose(misplaced, .stated, program.store-atom("State fallback has no transition group"))
    = false
if !handlers-shaped(items) || !entries-settle(items)
    = false
if stored-machine && tree.initial-case(items) == 0 && items.length != 0
    frame.diagnose(items[0], .stated, program.store-atom("State machine has no initial state"))
    = false
.. stored-machine = store != .store-none && store != .store-content
if store == .store-content
    for node in tree.machine-cases(items)
        if !flagged(node)
            . name = tree.state-name(node)
            . shown = if name then name.text else ""
            . message = "A case of a machine in a class's markup is read as a property of its name, and the class declares \"$shown\" already; rename the case or the property"
            frame.diagnose(node, .stated, program.store-atom(message))
            = false
. unbuilt = unbuilt-part(items)
if unbuilt != 0
    decline(unbuilt)
    = false
= true

────────────────────
_ do entries-settle Bool
    - items [SyntaxId]

` Whether the decisions made where a machine's cases are entered, with no trigger, never enter a
` case again, as the reference checks them from its first case and from each case written in
` it. Where one does, it is the reference's error at the decision.
. roots [SyntaxId]
. initial = tree.initial-case(items)
if initial != 0
    roots += initial
for node in tree.explicit-cases(items)
    roots += node
for root in roots
    . entering [SyntaxId]
    entering += root
    if !case-entries-settle(items, entering, root, 0)
        = false
= true

────────────────────
_ do case-entries-settle Bool
    - items [SyntaxId]
    - entering [SyntaxId]
    - node SyntaxId
    - decision SyntaxId

` Whether the decisions made where a case is entered, past the cases already `entering`, enter
` none of them again: each immediate transition of its body, up to one with no trigger, which
` always passes, and its first case, entered by the decision that led to the case.
. body = tree.state-items(tree.state-body(node))
for transition in tree.immediate-transitions(body)
    if !enter-decided(items, entering, tree.immediate-path(items, node, transition), transition)
        = false
    if tree.state-trigger(transition) == 0
        = true
. initial = tree.initial-case(body)
if initial == 0
    = true
. path [SyntaxId]
path += initial
= enter-decided(items, entering, path, decision)

────────────────────
_ do enter-decided Bool
    - items [SyntaxId]
    - entering [SyntaxId]
    - path [SyntaxId]
    - decision SyntaxId

` Whether entering the cases of a path by a decision enters none of the cases already
` `entering`, nor do the decisions made where its last case is entered.
. depth = entering.length
for node in path
    if entering.find(node) != null
        . name = tree.state-name(node)!
        . message = "Entry decisions loop back to '${name.text}' without a trigger"
        frame.diagnose
            - if decision != 0 then decision else node
            - .stated
            - program.store-atom(message)
        = false
    entering += node
. settled = case-entries-settle(items, entering, path[path.length - 1], decision)
while entering.length > depth
    entering.pop()
= settled

────────────────────
_ do handlers-shaped Bool
    - items [SyntaxId]

` Whether each handler of a machine's bodies is one the reference builds: on a single source,
` with no clause but one `when`. Each other is the reference's error.
for item in items
    if tree.is-transition(item) && !handlers-shaped(tree.state-items(tree.state-body(item)))
        = false
    if !tree.is-state-handler(item)
        continue
    do match? tree.nodes[item]
        | .node-for-block(row)
            do match? tree.nodes[row.loop]
                | .node-loop-syntax(loop)
                    if loop.next != 0 || row.next != 0
                        . message = "A state handler subscribes to a single source"
                        frame.diagnose(item, .stated, program.store-atom(message))
                        = false
                    do match? tree.nodes[loop.clause]
                        | .node-clause(clause)
                            if !(clause.op is .when-clause) || clause.next != 0
                                . message = "A state handler accepts only a when clause"
                                frame.diagnose(loop.clause, .stated, program.store-atom(message))
                                = false
= true

────────────────────
_ do flagged Bool
    - node SyntaxId

` Whether the class declares the flag of a case of a machine its markup writes, or its projection.
for decl in program.modules[module].decls
    do match? decl
        | .decl-property(row)
            if row.flag == node || row.projection == node
                = true
= false

────────────────────
_ do unbuilt-part SyntaxId
    - items [SyntaxId]

` The first part of a machine's bodies that has no shape here yet: a fallback that names values.
for item in items
    if tree.nodes[item] is .node-state-fallback && tree.state-targets(item).count != 0
        = item
    if tree.is-transition(item)
        . inner = unbuilt-part(tree.state-items(tree.state-body(item)))
        if inner != 0
            = inner
= 0

────────────────────
_ do type-machine TypeId
    - id SyntaxId
    - items [SyntaxId]
    - row MachineSlots
    - store MachineStore
    - outer SyntaxId = 0
    - parent SyntaxId = 0

` Types a machine's parts, the root first, then each case and continuation once what its
` activation sees is known (`activation-known`); one that never is has no shape here. What each
` activation sees is foreseen first where it can be (`foresee-activations`), so that the parts
` can read the machine by its name (`early-union`). Then the machine's union is made, of each
` case it names with what that case holds, and what it keeps is typed, and each projection of a
` machine written as a statement: a case's flag, or its payload where it is active. What each
` transition gives is converted to what its case holds, and the machine is recorded, with the
` machine around it and the case it is written in where it is a named machine written in a case
` of another.
machining = machining.store = store
machining = machining.syntax = id
machining = machining.items = items
machining = machining.cases = tree.machine-cases(items)
machining = machining.kept = tree.machine-captures(items, machining.cases)
machining.payloads.clear()
machining.kept-types.clear()
machining.starts.clear()
machining.typed.clear()
machining.waiting.clear()
machining.groups-found.clear()
for position in 0 .. < machining.cases.length
    machining.payloads += fixed-payload(position as U32)
    . unknown [TypeId]
    for _ in machining.kept[position]
        unknown += no-type
    machining.kept-types += unknown
do foresee-activations()
early-union(id, row, store)
note-starts(items)
type-machine-body(0, items)
. progress = true
while progress
    progress = false
    for position in 0 .. < machining.waiting.length
        . node = machining.waiting[position]
        if node != 0 && activation-known(node)
            machining.waiting[position] = 0
            type-machine-body(node, tree.state-items(tree.state-body(node)))
            progress = true
    if !progress
        progress = foresee-activations()
for node in machining.waiting
    if node != 0
        decline(node)
        = no-type
for payload in machining.payloads
    if payload == no-type || payload == invalid-type
        decline(id)
        = no-type
. union = machine-union(id, row)
type-machine-slots(row, union)
type-projections(id, store)
convert-targets()
. start = facts.machine-groups.length
for group in machining.groups-found
    facts.machine-groups.append(group)
. groups = RowRange'MachineGroup(start as U32, (facts.machine-groups.length - start) as U32)
. property = if store == .store-global || store == .store-member then machine-property(id) else 0
. fact = MachineFact
    - instance
    - id
    - union
    - store
    - module
    - property
    - groups
    - outer
    - parent
    - machining.refined
facts.machines.append(fact)
if store == .store-member && outer == 0 && machining.refined == no-instance
    demand-machine-stops()
= union

────────────────────
_ do demand-machine-stops

` The event runtime's `event-own-machine`, which a machine a class's property holds gives what
` stops it as it starts, and its `event-stop-machines`, which runs those of an object as the
` `close` of its class leaves.
if facts.machine-stop != no-instance || types.event-endpoint-decl.module == 0
    =
. pointer = pointer-to(types.type-row(.uint8))
. mark = scratch.types.mark
scratch.types.push(pointer)
. none = scratch.types.mark
scratch.types.push(types.intern-function(types.void-type, false, none, none))
facts.machine-own = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-own-machine")
    - mark
scratch.types.rewind(mark)
scratch.types.push(pointer)
facts.machine-stop = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-stop-machines")
    - mark
scratch.types.rewind(mark)

────────────────────
_ do early-union
    - id SyntaxId
    - row MachineSlots
    - store MachineStore

` Where what every case holds is fixed or foreseen before anything is typed, the machine's union
` is made first, so that its cases can read the machine by its name: the local or the lazy local
` it is kept in, the module's or the class's property it is, or the name a named machine written
` in a case of another declares. Elsewhere such a read waits for the union and has no shape here.
` A machine that refines another is read as the union of the machine none refines, made already.
if machining.refined != no-instance
    . above = facts.machine-of(machining.refined)
    if above
        facts.early-unions.append(EarlyUnion(instance, module, id, facts.root-machine(above).union))
    =
for payload in machining.payloads
    if payload == no-type
        =
. union = machine-union(id, row)
if row.bound != no-slot && store == .store-local && frame.outer
    frame.outer.assign(row.bound, union)
else if row.bound != no-slot && store == .store-nested
    frame.assign(row.bound, union)
else if store == .store-global || store == .store-member
    facts.early-unions.append(EarlyUnion(instance, module, id, union))

────────────────────
_ fixed-payload TypeId
    - position U32

` What a case holds where that is known before anything is typed: nothing where nothing names
` it with values; `U8` where the source of its payload gives none (`gives-nothing`), as the
` reference falls back to. Otherwise no type, until its source is typed (`settle-payload`), with
` or without a trigger.
|? !source
    types.void-type
|? gives-nothing(source)
    types.type-row(.uint8)
??
    no-type

.. source = tree.payload-source(machining.items, tree.state-name(machining.cases[position])!)

────────────────────
_ do gives-nothing Bool
    - source StateSource

` Whether a source of a case's payload gives no value, as the reference finds none there: a
` case one of whose names neither its trigger, if it has one, nor its owner's trigger captures.
if !(tree.nodes[source.node] is .node-state-case)
    = false
. trigger = tree.state-trigger(source.node)
. captures [Atom]
if trigger != 0
    tree.pattern-names(tree.trigger-pattern(trigger), captures)
if source.owner != 0
    tree.pattern-names(tree.trigger-pattern(tree.state-trigger(source.owner)), captures)
for target in tree.children[tree.state-targets(source.node)]
    do match? tree.nodes[target]
        | .node-identifier(named)
            if captures.find(named.name) == null
                = true
= false

────────────────────
_ do foresee-activations Bool

` Settles what the activation of each case sees before the machine's parts are typed, and
` again where no case or continuation waiting is known, as the reference infers it apart from
` where anything fires: what each case holds, from the source of its payload that nothing has
` typed, and each name it keeps, from each transition that enters it, each transition typed on
` trial (`foresee-in`), until nothing more settles. Whether anything is settled so.
. sources [SyntaxId]
. unsettled = false
for position in 0 .. < machining.cases.length
    . source SyntaxId = 0
    if machining.payloads[position] == no-type
        . found = tree.payload-source(machining.items, tree.state-name(machining.cases[position])!)
        if found && machining.typed.find(found.node) == null
            source = found.node
    sources += source
    if source != 0 || machining.kept-types[position].find(no-type) != null
        unsettled = true
if !unsettled
    = false
. settled = false
. chain [SyntaxId]
while foresee-in(machining.items, chain, sources)
    settled = true
= settled

────────────────────
_ do foresee-in Bool
    - items [SyntaxId]
    - chain [SyntaxId]
    - sources [SyntaxId]

` The transitions written among a body's items and in their bodies, each with the cases and
` continuations whose bodies it is written in, outermost first (`foresee-entry`). Whether
` anything is settled so.
. settled = false
for item in items
    if !tree.is-transition(item)
        continue
    if foresee-entry(item, items, chain, sources)
        settled = true
    chain += item
    if foresee-in(tree.state-items(tree.state-body(item)), chain, sources)
        settled = true
    chain.pop()
= settled

────────────────────
_ do foresee-entry Bool
    - transition SyntaxId
    - items [SyntaxId]
    - chain [SyntaxId]
    - sources [SyntaxId]

` A transition typed on trial where something of the case it enters is unsettled
` (`trial-transition`), with the names the activations around it see where they are known
` (`activation-names`): each name the case keeps that it reads there takes the type it has
` there, and what the case holds, where the transition is the source of its payload, is what it
` gives, or a tuple of them. Whether either is settled so.
. position = tree.case-position(machining.cases, tree.state-name(transition)!)
if position == null
    = false
. sourced = sources[position] == transition && machining.payloads[position] == no-type
. places [Size]
. wanted [SlotId]
if machining.kept-types[position].find(no-type) != null
    for read in bindings.machine-reads
        if read.module != module || read.site != transition || read.slot == no-slot
            continue
        . place = machining.kept[position].find(read.name)
        if place != null && machining.kept-types[position][place] == no-type
            places += place
            wanted += read.slot
if wanted.length == 0 && !sourced
    = false
. slots [SlotId]
. given [TypeId]
for part in chain
    activation-names(part, slots, given)
. found [TypeId]
. targets [TypeId]
trial-transition(transition, items, slots, given, wanted, found, targets)
. settled = false
if found.length == wanted.length
    for offset in 0 .. < wanted.length
        if found[offset] != no-type && found[offset] != invalid-type
            machining.kept-types[position][places[offset]] = found[offset]
            settled = true
if !sourced || targets.length == 0
    = settled
for target in targets
    if target == no-type || target == invalid-type
        = settled
settle-given(position, targets)
= true

────────────────────
_ do note-starts
    - items [SyntaxId]

` The cases and continuations a body enters as it is entered, and so as the machine starts:
` its first case and those its immediate transitions enter, and so on in each of theirs.
. initial = tree.initial-case(items)
if initial != 0
    note-start(initial)
for transition in tree.immediate-transitions(items)
    note-start(transition)

────────────────────
_ do note-start
    - node SyntaxId

if machining.starts.find(node) != null
    =
machining.starts += node
if tree.nodes[node] is .node-state-continuation
    . target = tree.find-case(machining.items, tree.state-name(node)!)
    if target != 0
        note-start(target)
        =
note-starts(tree.state-items(tree.state-body(node)))

────────────────────
_ do activation-known Bool
    - node SyntaxId

` Whether what the activation of a case or a continuation sees is known: what the case it
` enters holds and each name it keeps.
. position = tree.case-position(machining.cases, tree.state-name(node)!)
if position == null
    = true
if machining.payloads[position] == no-type
    = false
for type in machining.kept-types[position]
    if type == no-type
        = false
= true

────────────────────
_ do type-machine-body
    - owner SyntaxId
    - items [SyntaxId]

` One body of a machine: the root, a case or a continuation. The names its activation sees take
` their types (`bind-activation`), its entry statements are typed, then what runs once they
` have (`type-entered`), the functions of its groups (`type-handlers`), and its `do finally`
` blocks, each in a region of its own, which no narrowing leaves. Its cases and continuations
` wait their turn. What leaves a part only a handler runs is no error of the function
` (`hand-off-since`). A named machine among its entry statements is typed where it is written
` (`type-nested-machine`).
. starts = machining.outer-starts && (owner == 0 || machining.starts.find(owner) != null)
. mark = scratch.outgoing.mark
. narrowed = scratch.narrowings.mark
if owner != 0
    bind-activation(owner)
    for item in items
        if tree.nested-machine(item) != 0
            type-nested-machine(owner, item, starts)
        else if tree.is-entry-item(item)
            do check-statement(item)
type-entered(owner, items)
end-machine-region(narrowed)
hand-off-since(mark, starts)
. handlers = scratch.outgoing.mark
type-handlers(owner, items)
end-machine-region(narrowed)
hand-off-since(handlers, false)
. exits = scratch.outgoing.mark
if owner != 0
    for item in items
        if tree.nodes[item] is .node-do-finally-block
            do check-statement(item)
end-machine-region(narrowed)
hand-off-since(exits, starts)
for item in items
    if tree.is-transition(item)
        machining.waiting += item

────────────────────
_ do type-nested-machine
    - parent SyntaxId
    - item SyntaxId
    - starts Bool

` A named machine written in a case of the machine being typed, part of its function, as the
` reference builds it: typed as a machine is, while what is known of the machine around it is
` put aside, and recorded with that machine and the case. Its parts start with the machine
` around it where the case does. It is the reference's error that it has no first case.
. machine = tree.nested-machine(item)
. row = bindings.machine-slots(module, machine)
if !row
    decline(item)
    =
. own = machining
. fresh-payloads [TypeId]
. fresh-kept-types [[TypeId]]
. fresh-starts [SyntaxId]
. fresh-typed [SyntaxId]
. fresh-waiting [SyntaxId]
. fresh-found [MachineGroup]
machining = Machining
    - own.syntax
    - own.store
    - no-instance
    - tree.nested-machine-name(item)
    - starts
    - own.items
    - own.cases
    - own.kept
    - fresh-payloads
    - fresh-kept-types
    - fresh-starts
    - fresh-typed
    - fresh-waiting
    - fresh-found
. nested = tree.state-items(tree.state-body(machine))
if machine-shape(machine, nested, .store-nested)
    do type-machine(machine, nested, row, .store-nested, own.syntax, parent)
machining = own

────────────────────
_ do end-machine-region
    - mark ScratchMark

` Ends a part of a machine, which runs where others may not have: what the flow knew in it
` holds no longer.
frame.pop-narrowing(mark)
frame.doubt-members()

────────────────────
_ do hand-off-since
    - mark ScratchMark
    - starts Bool

` What leaves a part of a machine since a mark. A handler gives each error that leaves it to the
` global `unhandled-error` (see `hands-off`), typed once for the machine, as the reference's
` handlers do; the errors of a part only a handler runs then leave nothing, and those of a part
` that runs as the machine starts leave its function too. A call there whose callee's errors are
` not yet known lets them out all the same, to where the handler gives them.
if scratch.outgoing.mark == mark
    =
if !machine-handed
    machine-handed = true
    if !hands-off(instance)
        decline(frame.declaration.syntax)
if !starts
    for row in scratch.outgoing.since(mark)
        if row.call != U32.max
            facts.calls[row.call].propagates = true
    scratch.outgoing.rewind(mark)

────────────────────
_ do bind-activation
    - node SyntaxId

` The names a case's or a continuation's activation sees take their types
` (`activation-names`).
. slots [SlotId]
. given [TypeId]
activation-names(node, slots, given)
for offset in 0 .. < slots.length
    frame.assign(slots[offset], given[offset])

────────────────────
_ do activation-names
    - node SyntaxId
    - slots [SlotId]
    - given [TypeId]

` The names a case's or a continuation's activation sees, as the reference binds them, each
` added to `slots` with its type added to `given`: a name among what it gives takes the part of
` what the case holds in its place, where that is known, and a name the case keeps what it
` keeps.
. position = tree.case-position(machining.cases, tree.state-name(node)!)
if position == null
    =
. payload = machining.payloads[position]
. targets = tree.state-targets(node)
. offset = 0u32
for target in tree.children[targets]
    do match? tree.nodes[target]
        | .node-identifier(named)
            . slot = bindings.declared-at(frame.slots, node, named.name)
            . part = if whole-payload then payload else payload-part(payload, offset)
                .. whole-payload = targets.count == 1 || payload == no-type
            if slot != no-slot && part != no-type
                slots += slot
                given += part
    offset += 1
. kept = machining.kept[position]
. names [Atom]
tree.target-names(node, names)
for place in 0 .. < kept.length
    . slot = bindings.declared-at(frame.slots, node, kept[place])
    if slot != no-slot && names.find(kept[place]) == null
        slots += slot
        given += machining.kept-types[position][place]

────────────────────
_ payload-part TypeId
    - payload TypeId
    - offset U32

` The part of a case's payload in a place, where it is a tuple.
match types.rows[payload]
    | .type-tuple(row)
        if offset < row.fields.count then types.child-type(row.fields, offset) else no-type
    ??
        no-type

────────────────────
_ do type-entered
    - owner SyntaxId
    - items [SyntaxId]

` What runs where a body is entered, once its entry statements have: what its first case is
` given where it is entered so (`enters-initial`), which a case's never is where one of its
` immediate transitions always passes (`always-passes`), its immediate transitions, each with
` its condition, or its subject matched by its pattern, and what it gives, then the stream of
` each of its groups (`type-group`).
. initial = if owner == 0 || !tree.always-passes(items) then tree.initial-case(items) else 0
if initial != 0 && tree.enters-initial(machining.items, owner)
    type-targets(initial)
for transition in tree.immediate-transitions(items)
    . trigger = tree.state-trigger(transition)
    . subject = tree.trigger-subject(trigger)
    if trigger == 0
        type-targets(transition)
        continue
    if subject != 0
        type-trigger-pattern(trigger, infer(subject))
    else
        . condition = tree.trigger-condition(trigger)
        note-truthiness(condition, condition, infer(condition))
    type-targets(transition)
for head in tree.group-heads(items)
    type-group(owner, head)

────────────────────
_ do type-trigger-pattern
    - trigger SyntaxId
    - subject TypeId

` A trigger's pattern matched against what it tests: an item of its stream, or the subject of
` an `if | p = s`.
. pattern = tree.trigger-pattern(trigger)
if pattern == 0 || subject == invalid-type || subject == no-type
    =
do match? tree.nodes[pattern]
    | .node-structure-match(row)
        check-pattern(row.pattern, subject)
        =
check-pattern(pattern, subject)

────────────────────
_ do type-group
    - owner SyntaxId
    - head SyntaxId

` A group of event transitions where its owner subscribes it, as the reference makes it: its
` stream is made a `Broadcastable`, recorded at its first transition's trigger, and the
` machine's `Subscriber` of its item is given to the broadcaster's `subscribe` and
` `unsubscribe`, whose errors are given to the global `unhandled-error` (`hands-off-raising`),
` each call kept with the group. What a call of the
` subscriber answers is kept for its type. A stream that is neither is the reference's error
` at the transition. One on an event of an object is typed so too (`type-event-group`), and one
` on a stream that is iterable and implements no `Broadcastable` itself, though it may convert
` to one, as `type-iterated-group` says, as the reference tries them in that order.
. trigger = tree.group-trigger(head)
. written = tree.group-stream(head)
. found = infer-found(written, Want().adding(.want-event))
. given = found.type
if found.event != U32.max
    . event = found-events[found.event]
    type-event-group(owner, head, trigger, written, event, given)
    =
if given == invalid-type || given == no-type
    =
if types.broadcastable-decl.module == 0
    decline(head)
    =
if interface-of(given, types.broadcastable-decl) == no-type && iterates-as-source(given)
    type-iterated-group(owner, head, trigger, written, given)
    =
. stream = supported(given, types.broadcastable-decl)
if stream == no-type
    frame.diagnose
        - head
        - .stated
        - program.store-atom("State trigger source is not broadcastable or iterable")
    =
conversions.convert(trigger, written, given, stream, .reason-argument)
facts.set-node-type(instance, trigger, stream)
. item = first-arg(stream)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if item == no-type || subscriber == invalid-type
    decline(head)
    =
. subscribing = calls.protocol-call(stream, program.store-atom("subscribe"), head, subscriber, false, no-type, no-type, false)
if subscribing.answer == invalid-type
    decline(head)
    =
. subscribe = subscribing.fact
. unsubscribing = calls.protocol-call(stream, program.store-atom("unsubscribe"), head, subscriber, false, no-type, no-type, false)
if unsubscribing.answer == invalid-type
    decline(head)
    =
. unsubscribe = unsubscribing.fact
if !hands-off-raising(subscribe) || !hands-off-raising(unsubscribe)
    decline(head)
    =
. carried = carried-result(types, subscriber)
if carried != no-type
    types.complete(carried)
    facts.note-carried(function-row(types, subscriber), carried)
. enqueue = machine-enqueue(item, subscriber)
if enqueue == no-instance
    decline(head)
    =
. group = MachineGroup
    - head
    - owner
    - stream
    - item
    - subscriber
    - subscribe
    - unsubscribe
    - U32.max
    - false
    - false
    - enqueue
machining.groups-found += group

────────────────────
_ do machine-enqueue InstanceId
    - item TypeId
    - subscriber TypeId

` The event runtime's `event-machine-enqueue` of an item, which the reference gives a group's
` activation, an item and its broadcaster, to run the activation once no event is being
` published and no other transition runs; or none.
. broadcaster = types.well-known-type-of("core/stream", "Broadcastable", item)
if broadcaster == invalid-type || types.event-endpoint-decl.module == 0
    = no-instance
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(subscriber)
scratch.types.push(item)
scratch.types.push(broadcaster)
. name = program.store-atom("event-machine-enqueue")
. found = calls.demand-runtime-call(types.event-endpoint-decl.module, no-type, name, mark, 1)
scratch.types.rewind(mark)
= found

────────────────────
_ do iterates-as-source Bool
    - container TypeId

` Whether the reference finds the items of the stream of a group of a machine's event
` transitions by iterating it: a generator, or a value `supported` as an `Iterable`, an
` `Indexable` or a `Stream`.
if same-decl(class-ref(types, container), types.generator-decl)
    = true
for decl in [types.iterable-decl, types.indexable-decl, types.stream-decl]
    if supported(container, decl) != no-type
        = true
= false

────────────────────
_ do type-iterated-group
    - owner SyntaxId
    - head SyntaxId
    - trigger SyntaxId
    - written SyntaxId
    - given TypeId

` A group of event transitions on a stream that is only iterable, as the reference makes it
` where its owner subscribes it: the container is read at once, by its protocol planned at the
` trigger, which has the slots of a loop, and each item is given to the group's handler with
` the container. The reference's loop there does not poll.
. iterated = iteration-container(given, written)
. item = loop-item-type(iterated, trigger)
if item == invalid-type || item == no-type
    decline(head)
    =
note-container-iteration(trigger, iterated, false, trigger)
if is-indexed(iterated, false)
    facts.set-plan(instance, trigger, .plan-index-loop)
    if is-array-field(iterated, types.length-atom!)
        facts.set-constant(instance, trigger, ConstantFact(1, 0, null, false), .plan-index-loop)
    keep-loop(trigger, iterated, types.size-type, types.size-type)
keep-loop-item(trigger, item)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if subscriber == invalid-type || facts.plan-of(instance, trigger) == .plan-none
    decline(head)
    =
machining.groups-found += MachineGroup
    - head
    - owner
    - iterated
    - item
    - subscriber
    - no-fact
    - no-fact
    - U32.max
    - false
    - true

────────────────────
_ do type-event-group
    - owner SyntaxId
    - head SyntaxId
    - trigger SyntaxId
    - written SyntaxId
    - event NamedEvent
    - stream TypeId

` A group on an event of an object, as the reference subscribes it: the endpoint the event
` runtime keeps for the object's event is the group's `Broadcastable`, and the machine keeps a
` port of the event runtime for the group, which queues each item that arrives on the event
` runtime's machine queue and runs the machine's subscriber with it. The port is made where
` the group is first subscribed, and attached to the endpoint and detached from it where its
` owner enters and exits. A group the event runtime runs from the table of a class instead
` (`lowers-group`) needs `event-register-lowered`, and its port is made where the machine
` starts and given what the table runs it with. One at the address of a keyed event takes the
` endpoint there, which the receiver claims, and is never run from the table, as the
` reference's `keyed-address-required` decides.
. keyed = event.address != 0
if (event.key != no-type && !keyed) || stream == invalid-type || stream == no-type
    decline(head)
    =
. endpoint = if keyed then event-call("event-keyed-endpoint", event.payload, no-type, 3) else event-call("event-endpoint", event.payload)
. item = event.payload
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
. broadcastable = types.well-known-type-of("core/stream", "Broadcastable", item)
. port-type = types.well-known-type-of("core/event", "EventMachinePort", item)
if endpoint == no-instance || subscriber == invalid-type || unportable
    decline(head)
    =
.. unportable = broadcastable != stream || port-type == invalid-type
if keyed && !claim-endpoint(head, head, event.address, endpoint)
    =
conversions.convert
    - trigger
    - written
    - instances.signatures[endpoint].returns
    - stream
    - .reason-argument
facts.set-node-type(instance, trigger, stream)
. lowered = if keyed then false else lowers-group(owner, written, event)
if !lowered
    =
if lowered! && facts.event-register == no-instance
    demand-event-register()
if lowered! && facts.event-register == no-instance
    decline(head)
    =
. carried = carried-result(types, subscriber)
if carried != no-type
    types.complete(carried)
    facts.note-carried(function-row(types, subscriber), carried)
. held = types.optional-of(port-type)
. port = if lowered then port-call("event-machine-port", item, subscriber, stream) else no-instance
. post = if lowered then port-call("event-machine-post", item, port-type, item) else no-instance
. attach = if lowered then no-instance else port-call("event-machine-attach", item, held, subscriber, stream)
. detach = if lowered then no-instance else port-call("event-machine-detach", item, held)
. made = if lowered then port != no-instance && post != no-instance else attachable
    .. attachable = attach != no-instance && detach != no-instance
if !made
    decline(head)
    =
. used = facts.event-uses.length as U32
facts.event-uses += EventUse
    - instance
    - head
    - written
    - event.owner
    - event.name
    - .event-subscribe
    - endpoint
    - no-instance
    - no-instance
    - event.address
instances.mark-may-panic(instance)
. group = MachineGroup
    - head
    - owner
    - stream
    - item
    - subscriber
    - no-fact
    - no-fact
    - used
    - lowered
    - false
    - no-instance
    - port
    - post
    - attach
    - detach
machining.groups-found += group

────────────────────
_ do port-call InstanceId
    - name String
    - item TypeId
    - first TypeId
    - second TypeId = no-type
    - third TypeId = no-type

` A function of the event runtime that keeps the port of a machine's group on an event of an
` object, with the group's item as its type argument, given arguments of the types after it.
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(first)
if second != no-type
    scratch.types.push(second)
if third != no-type
    scratch.types.push(third)
. called = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom(name)
    - mark
    - 1
scratch.types.rewind(mark)
= called

────────────────────
_ do lowers-group Bool?
    - owner SyntaxId
    - written SyntaxId
    - event NamedEvent

` Whether the event runtime runs a group of a machine's event transitions from the table of the
` class whose object it is written for, as the reference plans it: a group at the root of a
` machine a property of the class holds, or of one written in the class's content, as
` `lowers-for` decides. A group of a case of the same machine on the event is planned first, as
` the reference compiles the cases a transition enters before the machine's root, and is no such
` group, which leaves the root's group to the sidecar path the reference then takes.
. stored = machining.store == .store-member || machining.store == .store-content
if !stored || owner != 0 || frame.self-type == no-type
    = false
. lowered = lowers-for(frame.self-type, module, written, event)
if lowered == null
    decline(written)
= lowered

────────────────────
_ do lowers-for Bool?
    - receiver TypeId
    - source ModuleId
    - written SyntaxId
    - event NamedEvent

` Whether the event runtime runs a group at the root of a machine, written in a module on a
` stream, from the table of a class: one on an event of the object itself, its name alone or
` read from `this`. Where a section of the class or of one above it hears the event too, or a
` constructor of one of them subscribes to it, the reference subscribes the group itself. Where
` a group of another of their machines is on it, the reference's choice turns on the order it
` compiles them in, and the group has no shape here (null).
. found = own-event(receiver, source, written)
if !found || found.owner != event.owner || found.name != event.name
    = false
. chain [TypeId]
. level TypeId? = receiver
while level
    chain += level
    level = types.base-of(level)
. groups = 0u32
. hearing = 0u32
for holder in chain
    . ref = class-ref(types, holder)
    . owner-module = program.modules[ref.module]
    do match? owner-module.decls[ref.decl]
        | .decl-class(class)
            for member in owner-module.member-pool[class.members]
                do match? owner-module.decls[member]
                    | .decl-rule(rule)
                        . heard = section-event(receiver, ref.module, rule.syntax)
                        if heard && heard.owner == event.owner && heard.name == event.name
                            = false
                    | .decl-property(property)
                        . machine = if property.name && !property.is-lazy then machine-node else 0
                            .. machine-node = owner-module.tree.declared-machine(property.value)
                        if machine != 0
                            . heard = event-groups
                                - owner-module.tree
                                - owner-module.tree.state-items
                                    - owner-module.tree.state-body(machine)
                                - event.name
                            groups += heard
                            hearing += if heard != 0 then 1 else 0
            for machine in owner-module.tree.content-machines(class.content)
                . heard = event-groups
                    - owner-module.tree
                    - owner-module.tree.state-items(owner-module.tree.state-body(machine))
                    - event.name
                groups += heard
                hearing += if heard != 0 then 1 else 0
for heard in constructor-events(receiver, chain)
    if heard.owner == event.owner && heard.name == event.name
        = false
if hearing != 1
    = null
= groups == 1

────────────────────
_ do event-groups U32
    - tree AST
    - items [SyntaxId]
    - name Atom

` How many groups of event transitions in a body, and in the bodies of its transitions, are on
` an event of the object itself of a name, written alone or read from `this`.
. count = 0u32
for head in tree.group-heads(items)
    . stream = tree.group-stream(head)
    do match? tree.nodes[stream]
        | .node-identifier(row)
            if row.name == name
                count += 1
        | .node-get-expression(get)
            if get.name == name
                do match? tree.nodes[get.object]
                    | .node-identifier(object)
                        if object.name.text == "this"
                            count += 1
for item in items
    if tree.is-transition(item)
        count += event-groups(tree, tree.state-items(tree.state-body(item)), name)
= count

────────────────────
_ do group-item TypeId
    - head SyntaxId

` The item the stream of a group gives, or no type where its group has no shape.
for group in machining.groups-found
    if group.head == head
        = group.item
= no-type

────────────────────
_ do type-handlers
    - owner SyntaxId
    - items [SyntaxId]

` The function each group of a body's event transitions runs for an item: `each` and `it` are
` the item, and each transition matches its pattern, tests its guard and gives its targets; a
` handler runs its loop (`type-state-handler`).
for head in tree.group-heads(items)
    . item = group-item(head)
    if item == no-type
        continue
    . each = bindings.declared-kind-at(frame.slots, head, .slot-each)
    . it = bindings.declared-kind-at(frame.slots, head, .slot-it)
    if each != no-slot
        frame.assign(each, item)
    if it != no-slot
        frame.assign(it, item)
    if tree.is-state-handler(head)
        type-state-handler(head, item)
        continue
    for transition in tree.group-transitions(items, head)
        . trigger = tree.state-trigger(transition)
        type-trigger-pattern(trigger, item)
        . guard = tree.trigger-guard(trigger)
        if guard != 0
            note-truthiness(guard, guard, infer(guard))
        type-targets(transition)

────────────────────
_ do type-state-handler
    - head SyntaxId
    - item TypeId

` A handler's loop where an item of its stream arrives, as the reference runs it: its pattern
` binds the item, its `when` is tested, and then its body runs, as the handler `handling` names.
do match? tree.nodes[head]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                if loop.pattern != 0
                    check-pattern(loop.pattern, item)
                do match? tree.nodes[loop.clause]
                    | .node-clause(clause)
                        note-truthiness(clause.expr, clause.expr, infer(clause.expr))
                . outer = handling
                handling = head
                do check-statement(row.body)
                handling = outer

────────────────────
_ do type-targets
    - transition SyntaxId

` What a transition gives the case it enters, typed where it fires. The source of a case's
` payload settles what the case holds where nothing did before (`fixed-payload`), and each
` name the case keeps takes what it reads there, which every transition that enters the case
` where the name is in reach must agree on, as the reference unifies them. A transition into a
` case that names what it holds gives one value for each name (`gives-names`).
for target in tree.children[tree.state-targets(transition)]
    do infer(target)
if !gives-names(transition)
    =
machining.typed += transition
. position = tree.case-position(machining.cases, tree.state-name(transition)!)
if position == null
    =
settle-payload(position, transition)
for read in bindings.machine-reads
    if read.module != module || read.site != transition
        continue
    . place = machining.kept[position].find(read.name)
    if place == null
        continue
    if read.slot == no-slot
        continue
    . read-type = frame.slot-type(read.slot)
    if read-type == no-type || read-type == invalid-type
        decline(transition)
        continue
    . known = machining.kept-types[position][place]
    if known == no-type
        machining.kept-types[position][place] = read-type
    else if known != read-type
        . joined = relations.unify(known, read-type, module)
        if relation-legal(joined)
            machining.kept-types[position][place] = joined.unified
        else
            frame.diagnose
                - transition
                - .stated
                - program.store-atom
                    - "Unable to unify activation capture type for '${read.name.text}'"

────────────────────
_ do gives-names Bool
    - transition SyntaxId

` Whether a transition gives a case that names what it holds, written with no trigger of its
` own, a value for each name, which is reported where it does not.
. name = tree.state-name(transition)
. held = if name then tree.find-case(machining.items, name) else 0
if held == 0 || held == transition || tree.state-trigger(held) != 0
    = true
. names = tree.state-targets(held).count
. given = tree.state-targets(transition).count
if names == 0 || given == names
    = true
. holds = if names == 1 then "one value" else "$names values"
. gives = if given == 0 then "none" else "$given"
. message = "Case \"${name!.text}\" holds $holds, and this transition gives $gives; give it $holds"
frame.diagnose(transition, .stated, program.store-atom(message))
= false

────────────────────
_ do settle-payload
    - position U32
    - transition SyntaxId

` What a case holds, once the transition that is the source of its payload is typed, from what
` it gives (`settle-given`).
if machining.payloads[position] != no-type
    =
. source = tree.payload-source(machining.items, tree.state-name(machining.cases[position])!)
if !source || source.node != transition
    =
. given [TypeId]
for target in tree.children[tree.state-targets(transition)]
    given += facts.node-type(instance, target)
settle-given(position, given)

────────────────────
_ do settle-given
    - position U32
    - given [TypeId]

` What a case holds, from what the source of its payload gives: each part joined with what each
` other transition that gives the case values gives in its place, where that is known
` (`join-others`), and the one part, or a tuple of them.
join-others(position, given)
if given.length == 1
    machining.payloads[position] = given[0]
    =
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for offset in 0 .. < given.length
    scratch.names.push(types.index-atom(offset as U32))
    scratch.types.push(given[offset])
machining.payloads[position] = types.intern-tuple(mark, names-mark)

────────────────────
_ do join-others
    - position U32
    - given [TypeId]

` Joins what the source of a case's payload gives with what each other source that gives values
` gives in its place, as the reference joins them: what one typed already gives, or what one
` gives typed on trial apart from where it fires (`source-given`). One whose values are not
` known so, that gives another number of them, or whose values do not join, is left out, and
` its values are converted to what the case holds where it fires.
for type in given
    if type == no-type || type == invalid-type
        =
. name = tree.state-name(machining.cases[position])!
. best = tree.payload-source(machining.items, name)
for source in tree.payload-sources(machining.items, name)
    if (best && source.node == best.node) || gives-nothing(source)
        continue
    . other = source-given(source.node)
    if other.length != given.length
        continue
    . joined [TypeId]
    for offset in 0 .. < given.length
        . part = join-payload(given[offset], other[offset])
        if part == no-type || part == invalid-type
            break
        joined += part
    if joined.length == given.length
        for offset in 0 .. < given.length
            given[offset] = joined[offset]

────────────────────
_ do source-given [TypeId]
    - node SyntaxId

` What a transition that gives a case values gives: the types of its targets where it is typed,
` or else typed on trial where it is written, with the names the activations around it see
` (`trial-transition`). None where any is unknown.
. found [TypeId]
if machining.typed.find(node) != null
    for target in tree.children[tree.state-targets(node)]
        found += facts.node-type(instance, target)
else
    . chain [SyntaxId]
    . items = source-place(machining.items, node, chain)
    if items.length == 0
        = found
    . slots [SlotId]
    . known [TypeId]
    for part in chain
        activation-names(part, slots, known)
    . wanted [SlotId]
    . captured [TypeId]
    trial-transition(node, items, slots, known, wanted, captured, found)
for type in found
    if type == no-type || type == invalid-type
        found.clear()
        break
= found

────────────────────
_ do source-place [SyntaxId]
    - items [SyntaxId]
    - node SyntaxId
    - chain [SyntaxId]

` The items of the body of a machine a node is written among, with the cases and
` continuations whose bodies hold them added to `chain`, outermost first; none where it is not
` written there.
for item in items
    if item == node
        = items
    if tree.is-transition(item)
        chain += item
        . inner = source-place(tree.state-items(tree.state-body(item)), node, chain)
        if inner.length != 0
            = inner
        chain.pop()
. none [SyntaxId]
= none

────────────────────
_ do join-payload TypeId
    - held TypeId
    - given TypeId

` The type two values a case is given in one place join to, as the reference joins inferred
` types: an optional of the other where one is `null`, or what they unify to, or invalid.
if held == given
    = held
if held == types.null-type || given == types.null-type
    . other = if held == types.null-type then given else held
    = types.optional-of(types.optional-inner(other))
. relation = relations.unify(held, given, module)
= if relation-legal(relation) then relation.unified else invalid-type

────────────────────
_ do machine-union TypeId
    - id SyntaxId
    - row MachineSlots

` The union a machine's value is, private to it: a case for each case it names, in the order it
` names them, holding what that case holds. It is named, as the reference names it, for the
` local, the global or the property that names the machine, and numbered among the machines of
` the module, and told apart by that number, which an edit that moves the machine's lines keeps.
. name = "StateMachine"
. property = machine-property(id)
if row.bound != no-slot
    name = "${state-type-name(bindings.slots[row.bound].name)}State"
if machining.store == .store-nested && machining.named
    name = "${state-type-name(machining.named)}State"
do match? program.modules[module].decls[property]
    | .decl-property(found)
        if property != 0 && found.name
            name = "${state-type-name(found.name)}State"
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < machining.cases.length
    scratch.names.push(tree.state-name(machining.cases[position])!)
    scratch.types.push(machining.payloads[position])
. number = machine-number(id)
= types.intern-named-union(program.store-atom("$name$number"), mark, names-mark, module, number)

────────────────────
_ do state-type-name String
    - name Atom

` A name as the reference writes it in a type's: each part between hyphens with its first
` letter made upper case, joined.
. text = ""
for part in name.text.split("-")
    if part.length != 0
        text = "$text${part[0 .. < 1].uppercased}${part[1 ...]}"
= text

────────────────────
_ do machine-number U32
    - id SyntaxId

` The place of a machine among those its module writes, counted from one.
. count = 0u32
for row in bindings.machines
    if row.module == module && row.syntax <= id
        count += 1
= count

────────────────────
_ do type-machine-slots
    - row MachineSlots
    - union TypeId

` What a machine keeps, in its own function's environment: its value, and for each case its
` flag, its generation, what it holds, where it holds anything, and each name it keeps, whose
` first value is typed where it is a named tuple or struct, which a case keeps where nothing
` entering it captures the name; for each group the subscriber the machine gave its broadcaster
` and the broadcaster, while it is subscribed, or for a group on an event the port the machine
` keeps for it once it is made. Flags declared beside the local a machine is kept in are of the
` function the machine is written in.
assign-kept(row, row.syntax, "(value)", union)
for position in 0 .. < machining.cases.length
    . node = machining.cases[position]
    assign-kept(row, node, "(active)", types.bool-type)
    assign-kept(row, node, "(generation)", types.type-row(.uint32))
    if machining.payloads[position] != types.void-type
        assign-kept(row, node, "(payload)", machining.payloads[position])
    . kept = machining.kept[position]
    for place in 0 .. < kept.length
        assign-kept(row, node, "(kept ${kept[place].text})", machining.kept-types[position][place])
        demand-first-values(machining.kept-types[position][place])
for group in machining.groups-found
    . port = if group.port != no-instance then instances.signatures[group.port].returns else no-type
    . attached = if group.attach != no-instance then attach-type else port
        .. attach-type = instances.signatures[group.attach].returns
    . subscriber = if attached != no-type then attached else group.subscriber
    assign-kept(row, group.head, "(subscriber)", types.optional-of(subscriber))
    assign-kept(row, group.head, "(source)", types.optional-of(group.stream))

────────────────────
_ do assign-kept
    - row MachineSlots
    - node SyntaxId
    - name String
    - type TypeId

. slot = bindings.machine-slot(row, node, program.store-atom(name))
if slot == no-slot
    =
. own = bindings.machine-slot(row, row.syntax, program.store-atom("(value)"))
if own != no-slot && bindings.slots[slot].scope != bindings.slots[own].scope && frame.outer
    frame.outer.assign(slot, type)
else
    frame.assign(slot, type)

────────────────────
_ do type-projections
    - id SyntaxId
    - store MachineStore

` Each projection of a machine written as a statement, a local of the function it is written in
` named after a case: the case's flag, or what it holds where it is active.
if store != .store-none || !frame.outer
    =
for position in 0 .. < machining.cases.length
    . name = tree.state-name(machining.cases[position])!
    . slot = bindings.declared-at(frame.outer!.slots, id, name)
    . payload = machining.payloads[position]
    if slot != no-slot
        frame.outer!.assign
            - slot
            - if payload == types.void-type then types.bool-type else types.optional-of(payload)

────────────────────
_ do convert-targets

` What each typed transition gives, converted to the part of what its case holds in its place,
` or to all of it, at each value.
for transition in machining.typed
    . position = tree.case-position(machining.cases, tree.state-name(transition)!)
    if position == null
        continue
    . payload = machining.payloads[position]
    . targets = tree.state-targets(transition)
    . offset = 0u32
    for target in tree.children[targets]
        . part = if targets.count == 1 then payload else payload-part(payload, offset)
        . given = facts.node-type(instance, target)
        if part != no-type && given != no-type && given != invalid-type
            conversions.convert(target, target, given, part, .reason-argument)
        offset += 1

────────────────────
_ both-targets-text String

` The error of a task forked onto a worker and onto the pool's threads both.
"A task runs on a worker or on the pool's threads, not both; write $forms"
.. forms = if tree.source-path.ends-with(".bx") then brix-forms else rows-forms
.. brix-forms = "\"(do-new (worker: w) …)\" or \"(do-new-thread …)\""
.. rows-forms = "\"do (w) new\" or \"do new thread\""

────────────────────
_ do report-pattern-on
    - pattern SyntaxId

` Reports a stream pattern written on a stream a subscription is given, which no match reads.
. text = "A stream pattern matches items it reads with \"in\", not items a subscription with \"on\" is given; write \"in\" in place of \"on\""
frame.diagnose(pattern, .stated, program.store-atom(text))

────────────────────
_ do check-worker
    - id SyntaxId
    - worker SyntaxId

` A task forked onto a named target runs on a worker. The target is typed before the task, as
` the reference reads it where it still knows what the flow before the task knows of properties.
. target = infer(worker)
if target == invalid-type || target == no-type
    =
. named = match types.rows[target]
    | .type-class(row)
        types.worker-decl.refers-to(row.module, row.decl)
    ??
        false
if !named
    frame.diagnose(id, .stated, program.store-atom("Fork target is not a Worker"))

────────────────────
_ do runs-class Bool
    - owner DeclId

` Whether an instance is a function a class of the module declares, or has an object of the
` class or of one derived from it for its receiver.
. decls = program.modules[module].decls
for instance in 0 .. < instances.length
    . row = instances.rows[instance]
    if row.module == module
        do match? decls[row.decl]
            | .decl-function(fn)
                if fn.owner == owner
                    = true
    . level TypeId? = row.self-type if row.self-type != no-type
    while level && types.intrinsic-of(level) == .class
        . ref = class-ref(types, level)
        if ref.module == module && ref.decl == owner
            = true
        level = types.base-of(level)
= false

────────────────────
_ do probe-runtime-call InstanceId
    - probes ModuleId
    - name String
    - arguments [TypeId]

. mark = scratch.types.mark
for argument in arguments
    scratch.types.push(argument)
. callee = calls.demand-runtime-call(probes, no-type, program.store-atom(name), mark)
scratch.types.rewind(mark)
= callee

────────────────────
_ optional-chained Bool
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-get-expression(row)
        chains-at(syntax, row.is-optional) || optional-chained(row.object)
    | .node-index-expression(row)
        chains-at(syntax, row.is-optional) || optional-chained(row.object)
    | .node-style-read-expression(row)
        chains-at(syntax, row.is-optional) || (row.object != 0 && optional-chained(row.object))
    | .node-markup-read-expression(row)
        chains-at(syntax, row.is-optional) || (row.object != 0 && optional-chained(row.object))
    | .node-call-expression(row)
        optional-chained(row.callable)
    ??
        false

────────────────────
_ chains-at Bool
    - link SyntaxId
    - is-optional Bool

is-optional && facts.chain-form(instance, link) != .chain-plain

────────────────────
_ absent-after Bool
    - object-syntax SyntaxId
    - object TypeId

object == types.null-type && optional-chained(object-syntax)

────────────────────
_ do note-chain ChainForm
    - id SyntaxId
    - link SyntaxId
    - receiver TypeId

. form = chain-form-of(receiver)
facts.record-chain(instance, id, link, form)
= form

────────────────────
_ chain-form-of ChainForm
    - receiver TypeId

|? receiver == types.null-type
    .chain-absent
|? types.is-optional(receiver)
    .chain-tested
??
    .chain-plain

────────────────────
_ optional-chain-expr SyntaxId
    - id SyntaxId

match tree.nodes[id]
    | .node-optional-chain(row)
        row.expr
    ??
        0u32

────────────────────
_ do check-use TypeId
    - id SyntaxId
    - expr SyntaxId

` `use`, written as a value or as `do use`: the subject's `begin-using` gives the value, and its
` `end-using` is called where the block is left, the two calls recorded at the node in that
` order. A subject with no `begin-using` that closes gives itself, and `close`, the one call
` recorded, is called where the block is left. An error the call that ends the use raises
` leaves the function, as one a cleanup raises does.
cleans-up = true
. chain = optional-chain-expr(expr)
. subject = if chain != 0 then infer(chain) else infer(expr)
if subject == invalid-type || subject == no-type
    decline(id)
    = invalid-type
if chain != 0
    facts.set-node-type(instance, expr, subject)
    if types.is-optional(subject)
        subject = types.optional-inner(subject)
types.optional-of(subject)
. used = protocol-member(subject, "begin-using", id)
if used == invalid-type
    if ending-member(subject, "close", id) == invalid-type
        . shown = type-short-name(types, subject)
        . text = "$shown cannot be used, as it has no \"begin-using\" and is not Closable; declare \"begin-using\" and \"end-using\", or implement Closable"
        frame.diagnose(id, .stated, program.store-atom(text))
        = invalid-type
    used = subject
else if ending-member(subject, "end-using", id) == invalid-type
    decline(id)
    = invalid-type
. slot = bindings.using-slot(frame.binding, id)
if slot != no-slot
    frame.assign(slot, types.optional-of(subject))
= if chain != 0 && !types.is-optional(used) then types.optional-of(used) else used

────────────────────
_ do ending-member TypeId
    - receiver TypeId
    - name String
    - site SyntaxId

` The method that ends a use, called as `protocol-member` calls one, whose errors leave the
` function.
. result = calls.protocol-getter(receiver, program.store-atom(name), site)
if result != invalid-type
    = result
= calls.protocol-call(receiver, program.store-atom(name), site, no-type, true).answer

────────────────────
_ do protocol-member TypeId
    - receiver TypeId
    - name String
    - site SyntaxId

. atom = program.store-atom(name)
. result = calls.protocol-getter(receiver, atom, site)
if result != invalid-type
    = result
= calls.protocol-call(receiver, atom, site).answer

────────────────────
_ do check-for
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId
    - next SyntaxId

` A `for` block. One on a stream subscribes where it is written, and its subscriber runs the
` body; one on a stream joined to another source, by a header chained after it or an `or`
` arm, is an error. Any other loop runs its headers and its body.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if row.is-subscriber && tree.is-stream-pattern(row.pattern)
            report-pattern-on(row.pattern)
            =
        if row.is-subscriber && (row.next != 0 || next != 0)
            . text = "A loop on a stream subscribes to one source, so it cannot be joined to another; write a loop for each source"
            frame.diagnose(loop, .stated, program.store-atom(text))
            =
        . subscriber = if row.is-subscriber then nested-decl-of(id) else 0u32
        if subscriber != 0 && frame.declaration.syntax == id
            check-subscriber(loop, body)
        else if subscriber != 0
            check-subscription(id, loop, row.container, row.clause, subscriber)
        if subscriber != 0
            if next != 0
                check-statement(next)
            =
        . simple = row.next == 0 && is-simple-loop-pattern(row.pattern)
        . container = loop-container(row.container, simple, stated-item(row.pattern))
        frame.forget-members()
        reset-assigned-paths(body)
        . alone = row.next == 0 && !row.is-subscriber && !row.is-match
        if container.item != no-type && alone
            facts.set-plan(instance, loop, .plan-range-loop)
        note-poll()
        loop-marks += scratch.narrowings.mark
        check-loop(loop, container, body, false, row.next == 0)
        if container.item != no-type && alone
            if counts-from-zero(row.container)
                facts.set-constant
                    - instance
                    - loop
                    - ConstantFact(1, 0.0, null, false)
                    - .plan-range-loop
            note-proven-rows(loop, row.pattern, row.container, row.clause, body)
            note-proven-items(row.pattern, row.container, row.clause, body)
        widen-assigned(id, body)
if next != 0
    check-statement(next)

────────────────────
_ do check-loop
    - loop SyntaxId
    - container LoopContainer
    - body SyntaxId
    - yields Bool
    - alone Bool = false
    - given Bool = false

` One loop header over a container typed by the caller, then its chained headers and the body,
` which a comprehension yields and a `for` block runs. A `for` block's header `alone` in it
` gives the rows of a table as TypeScript gives them. A comprehension's header is `given` its
` container, which a loop over the rows of a table keeps until it begins. A pattern written as a match with no arms
` gives the item as it fitted, but one that names a case of a union leaves it the union. A
` `keyed by` keys only the rows of a markup loop region, which is not checked here.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if !row.is-subscriber
            reject-keyed-clause(row.clause)
        if tree.is-stream-pattern(row.pattern)
            if check-pattern-header(loop, row.pattern, container.type)
                check-loop-rest(loop, tested-clause(loop, row.clause), row.next, body, yields)
            =
        . item = container.item
        . iterated = container.type
        if item == no-type
            if !row.is-subscriber
                iterated = iteration-container(container.type, row.container)
            item = loop-item-type(iterated, loop, slice-through-call(row.container))
            . given = iterated != invalid-type && iterated != no-type
            if item == invalid-type && given && !row.is-subscriber
                frame.diagnose(row.container, .stated, program.store-atom("Object is not iterable"))
        . yielded = item
        . pattern = row.pattern
        . transformed = false
        . matched = row.is-match
        . fitted = false
        do match? tree.nodes[pattern]
            | .node-structure-match(inner)
                transformed = has-arms(inner.pattern)
                pattern = inner.pattern
                matched = true
                fitted = !transformed
        if transformed
            item = match-item(row.pattern, pattern, item)
        else if matched
            check-pattern(pattern, item)
            if fitted && typed-item && !(tree.nodes[pattern] is .node-type-case)
                item = pattern-value(pattern, item)
            .. typed-item = item != no-type && item != invalid-type
        else
            declare(pattern, item, row.container)
        facts.set-loop-take(instance, loop, loop-take(pattern, transformed, matched))
        if itemless && (counts-rows(iterated) || counts-indices(iterated, row.container))
            facts.set-plan(instance, loop, .plan-table-loop)
            instances.mark-may-panic(instance)
            . kind = types.intrinsic-of(iterated)
            . held = kind == .table-selection || kind == .immutable-table-selection || spans-index
                .. spans-index = kind == .index-span
            keep-loop(loop, if held then iterated else yielded, types.size-type, types.size-type)
            if given
                keep-loop-given(loop, iterated)
            if alone && !yields && checks-rows(row.pattern, iterated, body, row.clause)
                note-checked-rows(loop, row.pattern)
        else if container.item == no-type
            note-container-iteration(loop, iterated, false, loop)
            if facts.plan-of(instance, loop) == .plan-cursor-loop
                note-place(loop, row.container, iterated, .plan-cursor-place-loop)
            if is-indexed(iterated, slice-through-call(row.container))
                facts.set-plan(instance, loop, .plan-index-loop)
                if is-array-field(iterated, types.length-atom!)
                    facts.set-constant
                        - instance
                        - loop
                        - ConstantFact(1, 0, null, false)
                        - .plan-index-loop
                keep-loop(loop, iterated, types.size-type, types.size-type)
                note-place(loop, row.container, iterated, .plan-index-place-loop)
        else
            keep-loop(loop, container.item, container.item, types.bool-type)
        .. itemless = container.item == no-type
        keep-loop-item(loop, if transformed then item else yielded)
        assign-loop-slots(loop, item, row.pattern != 0 && !transformed && !fitted)
        check-loop-rest(loop, tested-clause(loop, row.clause), row.next, body, yields)
        if alone && !yields && !row.is-match && !row.is-subscriber && table-looped
            if proves-rows(row.pattern, iterated, body, row.clause)
                facts.set-constant
                    - instance
                    - loop
                    - ConstantFact(1, 0.0, null, false)
                    - .plan-table-loop
        .. table-looped = facts.plan-of(instance, loop) == .plan-table-loop
        . selects = types.intrinsic-of(iterated) == .table-selection || immutable-selection
            .. immutable-selection = types.intrinsic-of(iterated) == .immutable-table-selection
        if selects && facts.plan-of(instance, loop) == .plan-table-loop
            . reads = selection-reads
                - row.container
                - iterated
                - body
                - row.clause
                - row.next != 0 || yields
            facts.set-constant
                - instance
                - loop
                - ConstantFact(reads, 0, null, false)
                - .plan-table-loop

────────────────────
_ do reject-keyed-clause
    - clause SyntaxId

. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if row.op == .keyed-by-clause
                frame.diagnose
                    - current
                    - .stated
                    - program.store-atom("keyed by is only valid on markup loops")
            next = row.next
    current = next

────────────────────
_ tested-clause SyntaxId
    - loop SyntaxId
    - clause SyntaxId

` The clauses of a loop header that are tested: those after the first of a loop on an event
` whose first clause says which publications it hears. A `whenever` among them says whether
` the loop is subscribed and is not tested.
if facts.event-clause-of(module, loop) then next-clause(clause) else clause

────────────────────
_ do check-loop-rest
    - loop SyntaxId
    - clause SyntaxId
    - next SyntaxId
    - body SyntaxId
    - yields Bool

` What follows a loop's header: its clause, which holds wherever the body runs, then the
` headers chained after it, or the body.
. clause-mark = scratch.narrowings.mark
if clause != 0
    check-clause(clause, body)
if next != 0
    do match? tree.nodes[next]
        | .node-loop-syntax(following)
            check-loop
                - next
                - loop-container(following.container, false, stated-item(following.pattern))
                - body
                - yields
else if yields && is-subscriber-body()
    note-broadcast(body, infer(body))
else if yields
    note-yield(infer(body))
else
    loop-depth += 1
    check-body(body)
    loop-depth -= 1
frame.pop-narrowing(clause-mark)

────────────────────
_ do check-task-handlers
    - task SyntaxId

` The handlers written after a task's block run in the task, after its cleanups, when a panic
` of the type each names ends it, and bind that panic: each names `Panic` or a type derived
` from it, and takes no errors it replaced.
do match? tree.nodes[task]
    | .node-do-task-block(row)
        if row.catchers.count != 0
            frame.forget-members()
        for catcher in tree.children[row.catchers]
            do match? tree.nodes[catcher]
                | .node-catcher(handler)
                    if handler.previous.count != 0
                        frame.diagnose(catcher, .stated, program.store-atom("A task's handler replaces no errors"))
                    . named = handled-type(handler.type)
                    if named != 0
                        . handled = types.evaluate-type(module, tree, named, frame.env)
                        if handled != invalid-type && !is-subtype(types, handled, types.panic-type)
                            frame.diagnose(named, .stated, program.store-atom("A task's handler takes a panic"))
                    check-pattern(handler.type, types.panic-type)
                    check-statement(handler.body)

────────────────────
_ handled-type SyntaxId
    - pattern SyntaxId

` The type a handler's pattern names, or none for one that names only the panic.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type
    | .node-type-identifier
        pattern
    ??
        0

────────────────────
_ do check-body
    - body SyntaxId

` The body of a loop that runs it. One written as one line that is content of a markup element
` runs as a block of that line would: the elements it names are made first, and the element
` takes the line's value.
. parent = content-parent(body)
if parent == no-type || tree.nodes[body] is .node-block
    check-statement(body)
    =
if names-elements(body)
    raise-line(body)
. hosted = content-blocks.length
host-content(body, parent)
. produced = check-line(body, parent, Want().adding(.want-content-line))
while content-blocks.length != hosted
    content-blocks.pop()
    content-parents.pop()
    content-names.pop()
if !leaves-line(body)
    link-content(body, produced, parent)
else
    frame.diagnose(body, .stated, program.store-atom("Illegal return"))

────────────────────
_ do check-pattern-header Bool
    - loop SyntaxId
    - written SyntaxId
    - container TypeId

` A loop's header written as a stream pattern, as the reference runs it: the container is
` read through the stream a match would read it through, made once, by the calls recorded at
` the header, and each pass matches the pattern from where the last left the stream, as a
` rule's arms match, without reading the rest. The loop ends where the stream has no more or
` the pattern fails, and a pattern that may match without reading, where the reference knows
` what it reads first, is an error, as it is in a pipe. Its item, `each`
` and `it`, is what the pattern gives, and the names it captures are the body's. One whose
` item is optional is an error: the reference gives what the optional holds, or a value it
` can not print. One whose names are not each what one part gave has no shape. A container the
` reference finds no iterator for is read through its stream all the same, as the reference's
` `StreamSourceIterator` lets it be, and one it makes no stream of is its error at the pattern.
` False where the header was declined.
. pattern = written
do match? tree.nodes[written]
    | .node-stream-match(row)
        pattern = row.pattern
if container == invalid-type || container == no-type
    = false
if !iterates(container) && natural-item(container) == no-type
    frame.diagnose(written, .stated, program.store-atom("Can't convert to iterable"))
    = false
if first-set(pattern) == 3 || never-reads(pattern)
    frame.diagnose(written, .stated, program.store-atom("Stream pattern loop must consume input"))
    = false
. buffer = stream-view
. read = record-stream-protocol(loop, container)
. made = stream-view.type
. typed = if read then type-stream-arms(pattern, true) else invalid-type
stream-view = buffer
if !read || (typed != invalid-type && !plain-captures(pattern))
    decline(loop)
    = false
if typed == invalid-type
    = false
if types.is-optional(typed)
    frame.diagnose(written, .stated, program.store-atom(optional-match-text("loop")))
    = false
if calls.protocol-getter(made, program.store-atom("has-more"), loop) != types.bool-type
    decline(loop)
    = false
facts.set-plan(instance, loop, .plan-pattern-loop)
facts.set-loop-take(instance, loop, .take-whole)
keep-loop(loop, container, made)
keep-loop-item(loop, typed)
assign-loop-slots(loop, typed, false)
= true

────────────────────
_ do iterates Bool
    - container TypeId

` Whether the reference finds an iterator for the container of a loop over a stream, as it
` does before it makes the stream, though it uses none: a generator, or a value `supported` as
` a `CursorIterable`, an `Iterable`, an `Indexable` or a `Stream`.
if same-decl(class-ref(types, container), types.generator-decl)
    = true
for decl in [types.cursor-iterable-decl, types.iterable-decl, types.indexable-decl, types.stream-decl]
    if supported(container, decl) != no-type
        = true
= false

────────────────────
_ do plain-captures Bool
    - id SyntaxId
    - repeated Bool = false

` Whether each name a stream pattern captures holds what one part of it gave, as the
` reference gives the body of a loop the names its header captures: none captured in a
` repeat or a count, nor one that accumulates, which the reference can not compile there,
` nor one that may hold nothing, which it gives the body as a value it can not read.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        if repeated || row.accumulating || types.is-optional(facts.node-type(instance, row.name))
            = false
        = plain-captures(row.pattern, repeated)
    | .node-stream-and(row)
        = plain-captures(row.left, repeated) && plain-captures(row.right, repeated)
    | .node-stream-or(row)
        = plain-captures(row.left, repeated) && plain-captures(row.right, repeated)
    | .node-stream-transform(row)
        = plain-captures(row.pattern, repeated)
    | .node-stream-panic(row)
        = plain-captures(row.pattern, repeated)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        = plain-captures(row.operand, repeated || repeat)
    | .node-stream-length(row)
        = plain-captures(row.operand, true)
= true

────────────────────
_ do checks-rows Bool
    - pattern SyntaxId
    - iterated TypeId
    - body SyntaxId
    - clause SyntaxId

` Whether a loop gives each row of a table or a span of one as `t[i]` gives it, a row whose
` storage TypeScript checked: where the rows are of a union, the loop names its row alone, no
` nested function reads it, and neither the body nor the clause calls a local.
. kind = types.intrinsic-of(iterated)
if kind == .table-selection || kind == .immutable-table-selection || complex-pattern
    = false
.. complex-pattern = !is-simple-loop-pattern(pattern)
if types.intrinsic-of(row-struct-of(iterated)) != .union
    = false
. blocked [Atom]
. effects = SelectionEffects()
scan-effects(body, blocked, effects)
if clause != 0
    scan-effects(clause, blocked, effects)
= !effects.table

────────────────────
_ proves-rows Bool
    - pattern SyntaxId
    - iterated TypeId
    - body SyntaxId
    - clause SyntaxId

|? (kind != .table && kind != .table-span) || pattern == 0 || !is-simple-loop-pattern(pattern)
    false
|? !named || (bindings.slots[named].flags /and/ SlotFlag.slot-captured) != 0
    false
??
    keeps-table(body) && (clause == 0 || keeps-table(clause))

.. kind = types.intrinsic-of(iterated)
.. named = declaring-slot(pattern)

────────────────────
_ do keeps-table Bool
    - root SyntaxId

for node in tree.subtree-start(root) .. < root + 1
    if !keeps-table-node(node)
        = false
= true

────────────────────
_ do keeps-table-node Bool
    - node SyntaxId

. op = planned-table-op(node)
if has-call && op != TableOp.table-field && op != TableOp.table-row
    = false
.. has-call = facts.first-call(instance, node) != no-fact
do match? tree.nodes[node]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, node)
        = resolution.kind != .resolve-slot || bindings.slots[resolution.slot].kind != .slot-lazy
    | .node-unary-expression(unary)
        = unary.op == .negative-op || unary.op == .not-op
    | .node-get-expression(get)
        = !get.is-tracked
    | .node-assign(assign)
        = assigns-number(assign.lhs)
    | .node-type-capture(capture)
        = capture.type == 0
    | .node-type-predicate(predicate)
        = !predicate.is-contextual
    | .node-type-equality(equality)
        = !equality.is-contextual
    | .node-clause(clause)
        = clause.op != .whenever-clause
    | .node-match-expression(matched)
        = matched.helper == 0
= match tree.nodes[node]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-binary-expression
        true
    | .node-cast-expression
        true
    | .node-declare
        true
    | .node-block
        true
    | .node-if-block
        true
    | .node-break
        true
    | .node-continue
        true
    | .node-return
        true
    | .node-structure-match
        true
    | .node-type-or
        true
    | .node-type-transform
        true
    | .node-type-case
        true
    | .node-type-tuple
        true
    | .node-type-wildcard
        true
    | .node-type-identifier
        true
    ??
        false

────────────────────
_ do assigns-number Bool
    - lhs SyntaxId

do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        . local = resolution.kind == .resolve-slot && local-slot
            .. local-slot = bindings.slots[resolution.slot].kind == .slot-local
        . type = facts.node-type(instance, lhs)
        if (!local && resolution.kind != .resolve-global) || type == no-type || type == invalid-type
            = false
        = intrinsic-is-numeric(types.intrinsic-of(type))
= false

────────────────────
_ do note-checked-rows
    - loop SyntaxId
    - pattern SyntaxId

` Keeps the names a loop gives its rows by as reading rows whose storage was checked, unless a
` nested function reads one of them.
. slots [SlotId]
if pattern != 0
    . named = declaring-slot(pattern)
    if named
        slots += named
. first = bindings.resolution-of(frame.binding, loop)
if first.kind == .resolve-slot
    . bound = bindings.bindings[frame.binding]
    . slot = first.slot
    while slot < bound.slots.start + bound.slots.count
        . row = bindings.slots[slot]
        if (row.kind != .slot-it && row.kind != .slot-each) || row.syntax != loop
            break
        slots += slot
        slot += 1
for slot in slots
    if (bindings.slots[slot].flags /and/ SlotFlag.slot-captured) != 0
        =
for slot in slots
    checked-rows += slot

────────────────────
_ do note-proven-rows
    - loop SyntaxId
    - pattern SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

. view = counted-view(container)
if !view || pattern == 0
    =
. counter = declaring-slot(pattern)
if !counter
    =
if !keeps-rows(body, view, counter) || (clause != 0 && !keeps-rows(clause, view, counter))
    =
mark-proven-rows(loop, body, view, counter)
if clause != 0
    mark-proven-rows(loop, clause, view, counter)

────────────────────
_ do note-switch
    - pattern SyntaxId
    - subject TypeId

. arms [SyntaxId]
if !gather-switch-arms(pattern, arms)
    =
. kind = types.intrinsic-of(subject)
. cases = kind == .union || kind == .table-row || kind == .immutable-table-row
if !cases && !is-integer-kind(kind)
    =
. tested U32
for position in 0 .. < arms.length
    . arm = arms[position]
    if facts.plan-of(instance, arm) == .plan-never
        =
    do match? tree.nodes[arm]
        | .node-type-transform(row)
            if row.pattern == 0 || tree.nodes[row.pattern] is .node-type-wildcard
                if position != arms.length - 1
                    =
                continue
            if cases && !names-switch-case(row.pattern)
                =
            if !cases && !names-switch-number(row.pattern, subject)
                =
            tested += 1
if tested < 2
    =
facts.set-constant
    - instance
    - pattern
    - ConstantFact(if cases then 1 else 2, 0.0, null, false)
    - .plan-switch

────────────────────
_ do gather-switch-arms Bool
    - pattern SyntaxId
    - arms [SyntaxId]

do match? tree.nodes[pattern]
    | .node-type-or(row)
        = gather-switch-arms(row.left, arms) && gather-switch-arms(row.right, arms)
    | .node-type-transform(row)
        if row.pattern != 0 && tree.nodes[row.pattern] is .node-type-or
            = false
        arms += pattern
        = true
= false

────────────────────
_ names-switch-case Bool
    - pattern SyntaxId

|? facts.plan-of(instance, pattern) != .plan-case || facts.constant-of(instance, pattern) == no-fact
    false
??
    tree.nodes[pattern] is .node-type-case

────────────────────
_ do names-switch-number Bool
    - pattern SyntaxId
    - subject TypeId

do match? tree.nodes[pattern]
    | .node-type-equality(row)
        if row.is-contextual || types.completions[subject].has-equalities
            = false
        do match? tree.nodes[row.expr]
            | .node-integer-syntax(literal)
                if literal.unit
                    = false
                . parsed = parse-integer-literal(literal.value)
                = !parsed.negative && literal-fits-target(types, parsed, subject)
= false

────────────────────
_ counts-from-zero Bool
    - container SyntaxId

match tree.nodes[container]
    | .node-range-expression(range)
        range.op == .range-to-op && range.increment == 0 && is-zero-literal(range.left)
    ??
        false

────────────────────
_ do note-proven-items
    - pattern SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

. array = counted-array(container)
if !array || pattern == 0
    =
. counter = declaring-slot(pattern)
if !counter
    =
if !uses-as-items(body, array) || (clause != 0 && !uses-as-items(clause, array))
    =
mark-proven-items(body, array, counter)
if clause != 0
    mark-proven-items(clause, array, counter)

────────────────────
_ do counted-array SlotId?
    - container SyntaxId

if !counts-from-zero(container)
    = null
do match? tree.nodes[container]
    | .node-range-expression(range)
        do match? tree.nodes[range.right]
            | .node-get-expression(get)
                if get.is-tracked || get.is-optional || uncounted
                    = null
                .. uncounted = get.name.text != "length" && get.name.text != "size"
                if !is-array-type(facts.node-type(instance, get.object))
                    = null
                = plain-local(get.object)
= null

────────────────────
_ do uses-as-items Bool
    - root SyntaxId
    - array SlotId

. named U32
. used U32
for node in tree.subtree-start(root) .. < root + 1
    if names-slot(node, array)
        named += 1
    do match? tree.nodes[node]
        | .node-index-expression(index)
            if names-slot(index.object, array)
                used += 1
        | .node-get-expression(get)
            if names-slot(get.object, array) && plain-get && counted-name
                used += 1
            .. plain-get = !get.is-tracked && !get.is-optional
            .. counted-name = get.name.text == "length" || get.name.text == "size"
= named == used

────────────────────
_ do mark-proven-items
    - root SyntaxId
    - array SlotId
    - counter SlotId

for node in tree.subtree-start(root) .. < root + 1
    if facts.plan-of(instance, node) == .plan-array-item && is-counted-row(node, array, counter)
        facts.set-constant(instance, node, ConstantFact(1, 0.0, null, false), .plan-array-item)

────────────────────
_ do mark-proven-rows
    - loop SyntaxId
    - root SyntaxId
    - view SlotId
    - counter SlotId

. proven = (TableOp.proven-row as U64) /or/ ((loop as U64) /lshift/ 32)
for node in tree.subtree-start(root) .. < root + 1
    if is-counted-row(node, view, counter)
        if facts.plan-of(instance, node) == .plan-view
            facts.set-plan(instance, node, .plan-proven-row)
        else if planned-table-op(node) == TableOp.table-row
            facts.set-constant(instance, node, ConstantFact(proven, 0.0, null, false), .plan-table)

────────────────────
_ planned-table-op TableOp?
    - node SyntaxId

|? constant == no-fact || facts.plan-of(instance, node) != .plan-table
    null
??
    ((facts.constants[constant].bits /and/ 4294967295) as U32) as TableOp

.. constant = facts.constant-of(instance, node)

────────────────────
_ do counted-view SlotId?
    - container SyntaxId

do match? tree.nodes[container]
    | .node-range-expression(range)
        if range.op != .range-to-op || range.increment != 0 || !is-zero-literal(range.left)
            = null
        do match? tree.nodes[range.right]
            | .node-get-expression(get)
                if get.is-tracked || get.is-optional || uncounted
                    = null
                .. uncounted = get.name.text != "length" && get.name.text != "size"
                if view-kind(facts.node-type(instance, get.object)) != 1 && not-length
                    = null
                .. not-length = planned-table-op(range.right) != TableOp.table-length
                = plain-local(get.object)
= null

────────────────────
_ is-zero-literal Bool
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-integer-syntax(literal)
        literal.value == "0" && !literal.unit
    ??
        false

────────────────────
_ do plain-local SlotId?
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-identifier(named)
        if named.is-tracked
            = null
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind != .resolve-slot
            = null
        . slot = bindings.slots[resolution.slot]
        if slot.kind != .slot-local && slot.kind != .slot-argument
            = null
        if (slot.flags /and/ SlotFlag.slot-captured) != 0 || address-taken
            = null
        .. address-taken = (slot.flags /and/ SlotFlag.slot-address-taken) != 0
        = resolution.slot
= null

────────────────────
_ do names-slot Bool
    - syntax SyntaxId
    - slot SlotId

do match? tree.nodes[syntax]
    | .node-identifier(named)
        if named.is-tracked
            = false
        . resolution = bindings.resolution-of(frame.binding, syntax)
        = resolution.kind == .resolve-slot && resolution.slot == slot
= false

────────────────────
_ do is-counted-row Bool
    - node SyntaxId
    - view SlotId
    - counter SlotId

do match? tree.nodes[node]
    | .node-index-expression(index)
        = !index.is-optional && names-slot(index.object, view) && names-slot(index.index, counter)
= false

────────────────────
_ do keeps-rows Bool
    - root SyntaxId
    - view SlotId
    - counter SlotId

for node in tree.subtree-start(root) .. < root + 1
    if !keeps-row(node, view, counter)
        = false
= true

────────────────────
_ do keeps-row Bool
    - node SyntaxId
    - view SlotId
    - counter SlotId

. answered = planned-table-op(node) == TableOp.table-row || field-op
    .. field-op = planned-table-op(node) == TableOp.table-field
if facts.first-call(instance, node) != no-fact && !answered
    = false
do match? tree.nodes[node]
    | .node-unary-expression(unary)
        = unary.op == .negative-op || unary.op == .not-op
    | .node-get-expression(get)
        if get.is-tracked || get.is-optional || (unviewed && not-field)
            = false
        .. unviewed = facts.plan-of(instance, node) != .plan-view
        .. not-field = planned-table-op(node) != TableOp.table-field
        = is-counted-row(get.object, view, counter) && intrinsic-is-numeric(node-kind)
            .. node-kind = types.intrinsic-of(facts.node-type(instance, node))
    | .node-assign(assign)
        = keeps-assigned(assign.lhs, view, counter)
    | .node-type-capture(capture)
        = capture.type == 0
    | .node-type-predicate(predicate)
        = !predicate.is-contextual
    | .node-clause(clause)
        = clause.op != .whenever-clause
= match tree.nodes[node]
    | .node-identifier
        true
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-binary-expression
        true
    | .node-cast-expression
        true
    | .node-index-expression
        true
    | .node-declare
        true
    | .node-block
        true
    | .node-if-block
        true
    | .node-break
        true
    | .node-continue
        true
    ??
        false

────────────────────
_ do keeps-assigned Bool
    - lhs SyntaxId
    - view SlotId
    - counter SlotId

do match? tree.nodes[lhs]
    | .node-get-expression(get)
        = facts.plan-of(instance, lhs) == .plan-view && is-counted-row(get.object, view, counter)
    | .node-identifier
        if names-slot(lhs, view) || names-slot(lhs, counter)
            = false
        = intrinsic-is-numeric(types.intrinsic-of(facts.node-type(instance, lhs)))
= false

────────────────────
_ do selection-reads U64
    - container SyntaxId
    - selection TypeId
    - body SyntaxId
    - clause SyntaxId
    - chained Bool

` How a loop over a selection of a table's rows reads its indices, as TypeScript's loop over
` rows decides from what its body and its clause may change: 1 where the indices are found
` again on each pass, and 2 where TypeScript leaves the loop to the selection's own iteration,
` or where what the body changes cannot be told. A name assigned or declared is changed, and
` so is each name in a place assigned, which may change indices; a call of a local may change
` a table or indices, and a call of a member each name its receiver and arguments are written
` with, and indices through a builder or an arena, or a table through a table that grows.
. blocked [Atom]
. effects = SelectionEffects()
scan-effects(body, blocked, effects)
if clause != 0
    scan-effects(clause, blocked, effects)
if chained || effects.unknown
    = 2
. roots [Atom]
. subject = subject-roots(container, roots)
. stable = types.intrinsic-of(selection) == .immutable-table-selection
. source-blocked = subject && roots.length != 0 && has-atom(blocked, roots[0])
if !stable && (source-blocked || effects.table || effects.selected-table)
    = 2
. again = effects.table || effects.indices
if subject
    for position in 1 .. < roots.length
        if roots[position] != roots[0] && has-atom(blocked, roots[position])
            again = true
= if again then 1 else 0

────────────────────
_ do has-atom Bool
    - names [Atom]
    - name Atom

` Whether a list of names holds a name.
for held in names
    if held == name
        = true
= false

────────────────────
_ do scan-effects
    - root SyntaxId
    - blocked [Atom]
    - effects SelectionEffects

` Notes what the nodes under a node may change, as TypeScript's loop over rows notes it.
for node in tree.subtree-start(root) .. < root + 1
    do match? tree.nodes[node]
        | .node-assign(row)
            do match tree.nodes[row.lhs]
                | .node-identifier(named)
                    blocked += named.name
                ??
                    block-names(row.lhs, blocked)
                    effects.indices = true
        | .node-call-expression(row)
            do match tree.nodes[row.callable]
                | .node-identifier
                    if bindings.resolution-of(frame.binding, row.callable).kind == .resolve-slot
                        effects.table = true
                        effects.indices = true
                ??
                    block-names(row.callable, blocked)
                    do match? tree.nodes[row.callable]
                        | .node-get-expression(get)
                            note-call-effect(get.object, effects)
            for operand in tree.children[row.operands]
                . expression = operand
                do match? tree.nodes[operand]
                    | .node-argument(argument)
                        expression = argument.expr
                block-names(expression, blocked)
                note-call-effect(expression, effects)
        | .node-declare(row)
            . named = pattern-name(types, tree, row.left)
            if named
                blocked += named

────────────────────
_ do block-names
    - root SyntaxId
    - blocked [Atom]

` Notes each name written under a node as changed.
for node in tree.subtree-start(root) .. < root + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            blocked += row.name

────────────────────
_ do note-call-effect
    - expression SyntaxId
    - effects SelectionEffects

` Notes what a call may change through a value it is given: indices through a builder or an
` arena, and a table through a table that grows. A value whose type is not known here leaves
` what the call changes unknown.
. type = facts.node-type(instance, expression)
if type == no-type || type == invalid-type
    effects.unknown = true
    =
. kind = types.intrinsic-of(type)
if kind == .array-builder || types.is-arena(type)
    effects.indices = true
if kind == .table
    effects.selected-table = true

────────────────────
_ do subject-roots Bool
    - expression SyntaxId
    - roots [Atom]

` The names a loop's container is read through, as TypeScript's flow facts root it: the name
` it is read from first, then those of the indices it is read at. False where it is not read
` from names alone, or from literal indices.
do match? tree.nodes[expression]
    | .node-identifier(row)
        roots += row.name
        = true
    | .node-get-expression(row)
        = subject-roots(row.object, roots)
    | .node-index-expression(row)
        if !subject-roots(row.object, roots)
            = false
        do match? tree.nodes[row.index]
            | .node-integer-syntax(literal)
                = literal.unit == null
            | .node-string-syntax
                = true
        = subject-roots(row.index, roots)
= false

────────────────────
_ do note-place
    - loop SyntaxId
    - written SyntaxId
    - container TypeId
    - plan OperatorPlan

` Plans a loop that counts or steps through a tuple or a struct as one that reads it where
` it is kept, where its container is written as such a place and is iterated as it is.
if container == no-type || container == invalid-type
    =
. kind = types.intrinsic-of(container)
if (kind != .tuple && kind != .struct) || facts.node-type(instance, written) != container
    =
place-base = 0
. shape = place-shape(written)
if shape != 0
    facts.set-loop-place(instance, loop, plan, if shape == 1 then place-base else U32.max)

────────────────────
_ do place-shape U32
    - node SyntaxId

` How the reference holds what an expression of a tuple or struct type gives: 0 as a value
` of its own, 1 by the address of where it is kept, and 2 in a way that has no shape here.
` A place is a local, an argument, a global or a stored property read by its name, and a
` stored field or property of one. A lazy local is a place where a flag says it has its
` value, and a value of its own where a read evaluates it. `place-base` is left as the
` object such a property is read from where that is no receiver: it is evaluated once.
do match? tree.nodes[node]
    | .node-identifier(row)
        . resolution = bindings.resolution-of(frame.binding, node)
        if resolution.kind == .resolve-global
            = 1
        if resolution.kind == .resolve-slot
            if bindings.slots[resolution.slot].kind != .slot-lazy
                = 1
            . policy = bindings.lazy-policy(resolution.slot)
            if policy == .lazy-inline || policy == .lazy-first-read
                = 0
            = if policy == .lazy-unsettled then 2 else 1
        if resolution.kind == .resolve-member
            = stored-shape(node, frame.self-type, row.name)
        = 0
    | .node-get-expression(row)
        if row.is-tracked || row.is-optional || row.is-loop
            = 2
        if facts.plan-of(instance, node) == .plan-view
            = 0
        . held = facts.node-type(instance, row.object)
        if held == no-type || held == invalid-type
            = 2
        . stored = stored-shape(node, held, row.name)
        if stored != 1
            = stored
        . kind = types.intrinsic-of(held)
        if kind == .tuple || kind == .struct
            = place-shape(row.object)
        if kind != .class
            = 2
        if !names-receiver(row.object)
            place-base = row.object
        = 1
    | .node-index-expression(row)
        if row.is-optional
            = 2
        if facts.plan-of(instance, node) != .plan-field
            = 0
        = place-shape(row.object)
    | .node-call-expression
        = 0
    | .node-tuple-syntax
        = 0
    | .node-range-expression
        = 0
    | .node-binary-expression
        = 0
    | .node-unary-expression
        = 0
    | .node-cast-expression
        = 0
    | .node-iterable-expression
        = 0
= 2

────────────────────
_ stored-shape U32
    - node SyntaxId
    - owner TypeId
    - name Atom

` How a property read by its name is held: where it is kept for one the owner stores, and
` as a value of its own for one a function answers.
|? found
    if types.properties[found].storage-kind == .storage-getter then 0 else 1
|? facts.first-call(instance, node) != no-fact
    0
??
    if facts.plan-of(instance, node) == .plan-field then 1 else 2

.. found = types.property-named(owner, name)

────────────────────
_ do demand-materialized
    - declaration CheckedDecl

` A member that runs on a row's case and reads its cells with no check runs on the case
` gathered from the row instead where it may move the row's storage before it reads the row
` again, as TypeScript's `table-row-receiver-materialized` function does. That function is the
` member's instance on the case itself. One that writes its receiver has none.
. own = instances.rows[instance]
if own.row-receiver == no-type || !own.row-validated || writes-receiver(declaration)
    =
. signature = instances.signatures[instance]
. param-count = signature.param-count
. start = signature.args.start - param-count
. mark = scratch.types.mark
for offset in 0 .. < param-count + signature.args.count
    scratch.types.push(instances.signature-types[start + offset])
. params = scratch.types.span(mark, param-count)
. args = scratch.types.span(mark + param-count, signature.args.count)
. materialized = instances.intern
    - own.module
    - own.decl
    - own.self-type
    - own.effects
    - own.enclosing
    - params
    - args
scratch.types.rewind(mark)
instances.rows[instance].materialized = materialized

────────────────────
_ do writes-receiver Bool
    - declaration CheckedDecl

` Whether a body may write its receiver: it assigns to a place reached from `this` or a
` member, calls a member of either, or holds a function of its own.
if declaration.body == 0
    = false
for node in tree.subtree-start(declaration.body) .. < declaration.body + 1
    do match? tree.nodes[node]
        | .node-function-syntax
            = true
        | .node-assign(row)
            if reaches-receiver(row.lhs)
                = true
        | .node-call-expression(row)
            if reaches-receiver(row.callable)
                = true
= false

────────────────────
_ do reaches-receiver Bool
    - node SyntaxId

` Whether a place or a callee is `this` or a member, or is reached from either.
. current = node
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, current)
            if resolution.kind == .resolve-member
                = true
            = resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-this
        | .node-get-expression(row)
            next = row.object
        | .node-index-expression(row)
            next = row.object
    current = next
= false

────────────────────
_ do names-receiver Bool
    - node SyntaxId

do match? tree.nodes[node]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, node)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == .slot-this
= false

────────────────────
_ do loop-take LoopTake
    - pattern SyntaxId
    - transformed Bool
    - matched Bool

` What a header does with its item, from the pattern it writes: the arms of a match, a
` pattern written as one, or one a declaration is written with.
if transformed
    = .take-arms
if names-whole(pattern)
    = .take-whole
if matched
    = .take-fitted
if has-arms(pattern)
    = .take-unshaped
do match? tree.nodes[pattern]
    | .node-type-tuple(row)
        if row.field-types.count != 0
            = .take-fields
    | .node-tuple-syntax(row)
        if row.items.count != 0
            = .take-fields
    | .node-type-capture(capture)
        if !reads-name(capture.type)
            = .take-converted
= .take-declared

────────────────────
_ names-whole Bool
    - pattern SyntaxId

` Whether a pattern of a loop is its item whole under a name, or is not written.
|? pattern == 0
    true
??
    match tree.nodes[pattern]
        | .node-identifier
            true
        | .node-type-capture(capture)
            capture.type == 0
        ??
            false

────────────────────
_ has-arms Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-or
        true
    | .node-type-transform
        true
    ??
        false

────────────────────
_ do match-item TypeId
    - id SyntaxId
    - arms SyntaxId
    - item TypeId

` A loop whose pattern is the arms of a match runs them on each item: `each` is what the arm an
` item matches gives, and an item no arm matches is passed over. The pattern is typed as what
` the arms give, for emission.
if item == invalid-type || item == no-type
    = invalid-type
. own-matching = matching
matching = matching.subject = item
matching = matching.optional = true
matching = matching.case = 0
. result = infer-arms(id, arms)
matching = own-matching
if result != no-type && result != invalid-type
    facts.set-node-type(instance, id, result)
= if types.is-optional(result) then types.optional-inner(result) else result

────────────────────
_ do infer-comprehension TypeId
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId
    - next SyntaxId

` A comprehension is a call of its generated closure with the container as the one argument, so
` a range literal is constructed; the closure instance is keyed like a lambda's, at the
` comprehension, and yields the body. One whose header is a stream pattern reads a container
` the reference finds no iterator for through its stream all the same, and one it makes no
` stream of is its error at the pattern. One on a stream, `<* x on s`, subscribes where it is
` written: see `infer-broadcaster`.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if row.is-subscriber && tree.is-stream-pattern(row.pattern)
            report-pattern-on(row.pattern)
            = invalid-type
        if row.is-subscriber && next == 0
            = infer-broadcaster(id, loop, row.container, row.clause, body)
        if row.is-subscriber || next != 0
            decline(id)
            = invalid-type
        . container = loop-container(row.container, false, stated-item(row.pattern))
        if container.type == invalid-type
            = invalid-type
        if tree.is-stream-pattern(row.pattern) && !iterates(container.type) && no-item
            frame.diagnose(row.pattern, .stated, program.store-atom("Can't convert to iterable"))
            = invalid-type
        .. no-item = natural-item(container.type) == no-type
        . mark = facts.diagnostics.length
        . callee = demand-comprehension(id, container.type)
        if callee == no-instance
            decline(id)
            = invalid-type
        = generated-call(id, callee, mark)
decline(id)
= invalid-type

────────────────────
_ do demand-comprehension InstanceId
    - id SyntaxId
    - container TypeId

. decl = nested-decl-of(id)
if decl == 0
    = no-instance
= demand-nested(decl, container)

────────────────────
_ do nested-decl-of DeclId
    - id SyntaxId

. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        = nested.decl
= 0

────────────────────
_ do intern-nested TypeId
    - decl DeclId

` The type of a closure this instance writes.
= types.intern-closure(module, decl, instance, instances.stable-keys[instance])

────────────────────
_ do demand-nested InstanceId
    - decl DeclId
    - argument TypeId

` The one instance of a generated closure, keyed under this instance like a lambda's: a
` comprehension's takes its container, a pipeline body its item, and a bullet list nothing.
` Its closure type is interned here, before its body is typed, so that the types of every
` closure a function writes are rowed in the order the function is typed.
intern-nested(decl)
. mask = callee-effects(frame, module, decl)
. mark = scratch.types.mark
if argument != no-type
    scratch.types.push(argument)
. argument-span = scratch.types.since(mark)
. callee = instances.intern(module, decl, no-type, mask, instance, scratch.no-types, argument-span)
scratch.types.rewind(mark)
if instances.rows[callee].state == .instance-unstarted
    run-within(callee, this, true)
= callee

────────────────────
_ do expect-bullets
    - expr SyntaxId
    - target TypeId

` A bullet list written where a list of a known item type is wanted casts each plain bullet
` to that type, as the reference does for a typed list call and a list-returning function.
if target == no-type || target == invalid-type
    =
. wanted = types.optional-inner(target)
. bullets = written-bullets(expr)
if bullets == 0
    =
do match? types.rows[wanted]
    | .type-class(row)
        . listed = row.module == types.list-decl.module && row.decl == types.list-decl.decl
        if listed && row.args.count != 0
            . item = types.child-type(row.args, 0)
            bullet-lists += bullets
            bullet-items += item
            bullet-builds += nested-decl-of(bullets) != 0 && list-of(item) == wanted

────────────────────
_ do written-bullets SyntaxId
    - expr SyntaxId

. bullets = expr
do match? tree.nodes[bullets]
    | .node-argument(row)
        bullets = if row.name then 0 else row.expr
do match? tree.nodes[bullets]
    | .node-block(row)
        bullets = if row.body.count == 1 then tree.children[row.body.start] else 0
=? bullets if bullets != 0 && tree.nodes[bullets] is .node-bullet-expression
= 0

────────────────────
_ do list-of TypeId
    - item TypeId

. mark = scratch.types.mark
scratch.types.push(item)
. list = types.class-with-args(types.list-decl.module, types.list-decl.decl, mark)
types.complete(list)
= list

────────────────────
_ do bullet-item TypeId
    - bullets SyntaxId

for position in 0 .. < bullet-lists.length
    if bullet-lists[position] == bullets
        = bullet-items[position]
= no-type

────────────────────
_ do builds-bullets Bool
    - bullets SyntaxId

for position in 0 .. < bullet-lists.length
    if bullet-lists[position] == bullets
        = bullet-builds[position]
= false

────────────────────
_ do infer-listed-bullets TypeId
    - id SyntaxId
    - callable SyntaxId
    - bullets SyntaxId

types.clear-fault()
. listed = types.evaluate-type(module, tree, callable, frame.env)
if listed == invalid-type || !same-decl(class-ref(types, listed), types.list-decl)
    decline(id)
    = invalid-type
. open = types.completions[listed].has-variables
. wanted = if open then no-type else first-arg(listed)
if !open && list-of(wanted) != listed
    decline(id)
    = invalid-type
instances.mark-may-panic(instance)
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. sites [SyntaxId]
. valid = true
. bullet = bullets
while bullet != 0
    . next = 0u32
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            . given = listed-item(bullet, row.item, row.is-multi, row.is-optional, wanted)
            valid = valid && given != invalid-type
            scratch.types.push(given)
            scratch.syntax.push(if row.is-multi || row.is-optional then bullet else row.item)
            sites += bullet
            next = row.next
    bullet = next
. item = wanted
. given = types-start
if valid && item == no-type
    . peer = literal-peer(types-start, syntax-start, sites.length)
    given = scratch.types.mark
    for offset in 0 .. < sites.length
        . adapted = conversions.adapted-literal
            - scratch.syntax[syntax-start + offset]
            - scratch.types[types-start + offset]
            - peer
        scratch.types.push(adapted)
    item = relations.join(given)
    if item == invalid-type
        frame.diagnose(id, .stated, program.store-atom("Incompatible types in list"))
        valid = false
if valid
    for offset in 0 .. < sites.length
        . site = sites[offset]
        . written = scratch.syntax[syntax-start + offset]
        . element = scratch.types[given + offset]
        if element != item && written != site && symbol-of(written) != null
            element = infer-with-expected(written, item)
        if element != item
            conversions.convert(site, written, element, item, .reason-element)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
=? invalid-type if !valid
. list = list-of(item)
calls.note-list(id, list)
calls.note-append(id, list, item, .call-list-append)
facts.set-plan(instance, id, .plan-built-bullets)
= list

────────────────────
_ do listed-item TypeId
    - bullet SyntaxId
    - item SyntaxId
    - multi Bool
    - optional Bool
    - wanted TypeId

facts.set-bullet-site(instance, bullet, bullet, false)
=? listed-spread(bullet, multi-bullet-container(item, wanted)) if multi && !optional
. plain = !multi && !optional
. value = if plain && wanted != no-type then infer-with-expected(item, wanted) else infer(item)
=? invalid-type if value == invalid-type
if plain
    =? conversions.convert(bullet, item, value, wanted, .reason-explicit) if wanted != no-type
    = value
. inner = types.optional-inner(value)
=? inner if !multi
= listed-spread(bullet, LoopContainer(inner, no-type))

────────────────────
_ do listed-spread TypeId
    - bullet SyntaxId
    - container LoopContainer

=? invalid-type if container.type == invalid-type
if container.item != no-type
    plan-range-at(bullet, container.item)
    = container.item
. mark = facts.calls.length
. iterated = iteration-container(container.type, bullet)
. yielded = loop-item-type(iterated, bullet)
=? invalid-type if yielded == invalid-type
plan-iteration-at(bullet, bullet, iterated, yielded, true)
facts.set-protocol-start(instance, bullet, bullet, mark)
= yielded

────────────────────
_ do infer-bullets TypeId
    - id SyntaxId
    - consumer SyntaxId

` A bullet list is a call of its generated closure, whose type the reference records at the
` first bullet, yielding every item. The reference shifts the first bullet's location one line
` when it declares the closure, so the facts of that bullet's own yield land on the next bullet
` or on the pipeline consuming the list; `bullet-site` places them the same way.
. decl = nested-decl-of(id)
if decl == 0
    decline(id)
    = invalid-type
facts.set-node-type(instance, id, intern-nested(decl))
. callee = demand-nested(decl, no-type)
. produced = calls.generator-call(id, callee)
. site = bullet-site(id, consumer)
if site != id
    facts.set-node-type(instance, site, produced)
= produced

────────────────────
_ bullet-site SyntaxId
    - id SyntaxId
    - consumer SyntaxId

match tree.nodes[id]
    | .node-bullet-expression(row)
        if row.next != 0 then row.next else if consumer != 0 then consumer else id
    ??
        id

────────────────────
_ do check-bullets
    - id SyntaxId

` The closure's body: a bullet yields its item, an optional bullet only a present item, and a
` multi bullet every item of its iterable, as the reference's generated yields do. The first
` bullet's own facts sit where the reference shifts them, the consumer being the closure's
` enclosing frame's pipeline when the list feeds one.
. bullet = id
. site = bullet-site(id, consumer-of(id))
. wanted = if outer then outer.bullet-item(id) else no-type
building-list = outer && outer.builds-bullets(id)
built-item = wanted
. plain [Bool]
orders-yields = true
while bullet != 0
    . next = 0u32
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            facts.set-bullet-site(instance, bullet, site, false)
            . noted = ordered-yields.length
            check-bullet
                - bullet
                - site
                - row.item
                - row.is-multi
                - row.is-optional
                - wanted
                - bullet == id
            if ordered-yields.length != noted
                plain += !row.is-multi && !row.is-optional
            next = row.next
    bullet = next
    site = bullet
orders-yields = false
fold-bullet-yields(plain)

────────────────────
_ do fold-bullet-yields
    - plain [Bool]

for position in 0 .. < plain.length
    if plain[position]
        fold-yield
            - ordered-yields[position]
            - ordered-sites[position]
            - true
            - ordered-literals[position]
for offset in 0 .. < plain.length
    . position = plain.length - 1 - offset
    if !plain[position]
        fold-yield
            - ordered-yields[position]
            - ordered-sites[position]
            - true
            - ordered-literals[position]
ordered-yields.clear()
ordered-sites.clear()
ordered-literals.clear()

────────────────────
_ do bullets-consumer SyntaxId

` The pipeline that consumes the bullet list this body is, where its first bullet's facts sit,
` or nothing for any other body.
if !outer
    = 0
do match? tree.nodes[frame.declaration.syntax]
    | .node-bullet-expression
        = consumer-of(frame.declaration.syntax)
= 0

────────────────────
_ do consumer-of SyntaxId
    - id SyntaxId

` The pipeline whose left operand is the bullet list, if one consumes it.
. total = tree.nodes.length
for candidate in id + 1 .. < total
    do match? tree.nodes[candidate]
        | .node-pipeline-expression(row)
            if row.left == id
                = candidate as SyntaxId
= 0

────────────────────
_ do check-bullet
    - bullet SyntaxId
    - site SyntaxId
    - item SyntaxId
    - is-multi Bool
    - is-optional Bool
    - wanted TypeId
    - is-first Bool

` What a bullet yields is kept with where the reference places its yield, to be converted
` to the type of the list's items once that is known. A range of integers written with no
` suffix that a multi bullet yields is of the type of the items wanted.
if is-multi && !is-optional
    check-multi-bullet
        - bullet
        - site
        - multi-bullet-container(item, wanted)
        - is-first
        - written-literal(item)
    =
. value = infer(item)
if value == invalid-type
    note-yield(value)
    =
if wanted != no-type && !is-multi && !is-optional
    value = conversions.convert(item, item, value, wanted, .reason-explicit)
if is-optional && types.is-optional(value)
    value = types.optional-inner(value)
if !is-multi
    note-yield(value, site, false, if is-optional then 0 else written-literal(item))
    =
check-multi-bullet(bullet, site, LoopContainer(value, no-type), is-first)

────────────────────
_ do multi-bullet-container LoopContainer
    - item SyntaxId
    - wanted TypeId

do match? tree.nodes[item]
    | .node-list-syntax
        if wanted != no-type
            . listed = infer(item)
            if listed == invalid-type
                = LoopContainer(invalid-type, no-type)
            . mark = scratch.types.mark
            scratch.types.push(wanted)
            . target = types.class-named-with-args(module, types.list-atom!, mark)
            = LoopContainer(conversions.convert(item, item, listed, target, .reason-explicit), no-type)
= loop-container(item, true, wanted)

────────────────────
_ do check-multi-bullet
    - bullet SyntaxId
    - site SyntaxId
    - container LoopContainer
    - is-first Bool
    - literal SyntaxId = 0

` A multi bullet yields every item of its iterable through the loop the reference lowers it
` to, an integer range literal counting without a range, any other container through its
` iteration protocol with the yielded item converted to the generator's optional. The loop
` is planned at the bullet, which has the slots of a loop, and polls; the calls of a
` container's protocol stay where the reference keeps them, and the loop of the first bullet
` of a list is located on the line under it, where the reference shifts that bullet.
if container.type == invalid-type
    note-yield(invalid-type)
    =
if container.item != no-type
    note-yield(container.item, site, true, literal)
    plan-range-at(bullet, container.item)
    =
. mark = facts.calls.length
. iterated = iteration-container(container.type, site)
. yielded = loop-item-type(iterated, site)
note-yield(yielded, site, true)
if yielded == invalid-type
    =
plan-iteration-at(bullet, site, iterated, yielded, true)
facts.set-bullet-site(instance, bullet, site, is-first)
facts.set-protocol-start(instance, bullet, site, mark)
. wrapped = types.optional-of(yielded)
if wrapped != yielded
    conversions.convert(site, 0, yielded, wrapped, .reason-join)

────────────────────
_ do plan-range-at
    - planned SyntaxId
    - item TypeId

` A loop at a node that heads none, over a range literal of whole numbers: it counts, with
` no range, and polls.
facts.set-plan(instance, planned, .plan-range-loop)
keep-loop(planned, item, item, types.bool-type)
note-poll()

────────────────────
_ do plan-iteration-at
    - planned SyntaxId
    - site SyntaxId
    - iterated TypeId
    - item TypeId
    - is-bullet Bool

` A loop at a node that heads none, over any other container: by the container's protocol,
` whose calls are kept at `site`, by its indexes where it has them, and polling.
note-container-iteration(site, iterated, is-bullet, planned)
if is-indexed(iterated, false)
    facts.set-plan(instance, planned, .plan-index-loop)
    if is-array-field(iterated, types.length-atom!)
        facts.set-constant(instance, planned, ConstantFact(1, 0, null, false), .plan-index-loop)
    keep-loop(planned, iterated, types.size-type, types.size-type)
keep-loop-item(planned, item)
note-poll()

────────────────────
_ do note-container-iteration
    - site SyntaxId
    - container TypeId
    - is-bullet Bool
    - planned SyntaxId

` The iteration protocol the reference's generic loop lowering calls on a container that is
` neither a range literal nor a table, by the first it finds of these: a generator begins,
` reads, and ends iterating; a cursor iterable reads its initial state and steps it, the step
` called as any call is, whose errors leave the function; and anything else iterable, a value
` of an interface or an object of a class of one, begins, reads, and ends iterating. The
` instances and the witnesses of their implementors follow. A class that delegates the
` interface to a property is iterated by what the property holds, whose items are converted
` to the interface's at the loop, as the `as` that delegates it asks. A type iterated by an
` interface must answer the functions the interface requires, as where it is made one.
` A multi bullet over a table also keeps the index cast of its counter at the bullet. The
` loop is planned at `planned`, the header of a loop or the bullet, where the slots of the
` loop are.
if container == invalid-type || container == no-type
    =
. cursor = iterable-item(container, types.cursor-iterable-decl) != no-type
. iterable = iterable-item(container, types.iterable-decl) != no-type
. generated = same-decl(class-ref(types, container), types.generator-decl)
if is-bullet && !cursor && !iterable && implements(container, types.indexable-decl)
    conversions.convert(site, site, types.size-type, types.index-type, .reason-argument)
if cursor && !generated
    . cursor-interface = interface-of(container, types.cursor-iterable-decl)
    if types.intrinsic-of(container) != .interface && cursor-interface != no-type
        conform-members(container, cursor-interface)
    . state = calls.protocol-getter(container, program.store-atom("initial-iterator-state"), site)
    if state != invalid-type
        calls.protocol-call(container, program.store-atom("next-iterator"), site, state, true)
        if planned != 0
            facts.set-plan(instance, planned, .plan-cursor-loop)
            keep-loop(planned, container, state)
    =
if generated || iterable
    . places [U32]
    . interface = if iterable && !generated then iterable-interface else no-type
        .. iterable-interface = interface-of(container, types.iterable-decl)
    if interface != no-type && types.intrinsic-of(container) != .interface
        conform-members(container, interface)
    . holder = if interface != no-type then calls.ranking.interface-holder(container, interface, places) else no-type
    . receiver = if holder != no-type then holder else container
    calls.keep-protocol-through(calls.protocol-call(receiver, program.store-atom("begin-iterating"), site).fact, places)
    . read-call = calls.protocol-call(receiver, program.store-atom("<-read"), site, no-type, true)
    calls.keep-protocol-through(read-call.fact, places)
    . read = read-call.answer
    calls.keep-protocol-through(calls.protocol-call(receiver, program.store-atom("end-iterating"), site).fact, places)
    . item = if holder != no-type then first-arg(interface) else no-type
    if item != no-type && read != invalid-type && types.is-optional(read) && other-item
        conversions.convert
            - site
            - site
            - types.optional-inner(read)
            - item
            - .reason-element
            - true
            - places.length != 0
    .. other-item = types.optional-inner(read) != item
    if planned != 0
        facts.set-plan(instance, planned, .plan-stream-loop)
        keep-loop(planned, container)

────────────────────
_ is-indexed Bool
    - container TypeId
    - through-call Bool

` Whether a loop over a container counts through its indexes, as `loop-item-type` found its
` item: the container is neither kind of iterable, and no table the loop reads by its rows.
|? container == invalid-type || container == no-type
    false
|? iterable-item(container, types.cursor-iterable-decl) != no-type
    false
|? plain-iterable || !implements(container, types.indexable-decl)
    false
??
    through-call || !is-table-container(types.intrinsic-of(container))

.. plain-iterable = iterable-item(container, types.iterable-decl) != no-type

────────────────────
_ do keep-loop
    - loop SyntaxId
    - first TypeId
    - second TypeId = no-type
    - third TypeId = no-type

` Types what a loop keeps from one pass to the next, in the slots the binder declared for
` its header: for a range its index, its end and whether it counts down; for a container
` the container, and then its length and the count of items read, or the state of its
` cursor.
. slot = bindings.loop-state(frame.binding, loop)
if slot == no-slot
    =
frame.assign(slot, first)
if second != no-type
    frame.assign(slot + 1, second)
if third != no-type
    frame.assign(slot + 2, third)

────────────────────
_ do keep-loop-given
    - loop SyntaxId
    - container TypeId

` Types the slot after a loop's item, which the binder declared for a header given its
` container: there the loop of a comprehension over the rows of a table keeps the container
` until the loop begins and finds its rows, as TypeScript's loop over its argument does.
. slot = bindings.loop-state(frame.binding, loop)
if slot != no-slot
    frame.assign(slot + loop-state-count, container)

────────────────────
_ do keep-loop-item
    - loop SyntaxId
    - item TypeId

` Types the last of a loop's slots, which keeps the item of the pass.
. slot = bindings.loop-state(frame.binding, loop)
if slot != no-slot && item != no-type && item != invalid-type
    frame.assign(slot + loop-state-count - 1, item)

────────────────────
_ do infer-pipeline TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - right SyntaxId

` A pipeline passes its left value on: a forward pipe as the last argument of the call on the
` right, and a map or filter to the stream function of that name with the right operand's
` closure over `each`, as the reference lowers them. One written as a statement that no
` statement before it joins has no shape: the reference fails without saying where.
if left == 0
    decline(id)
    = invalid-type
if op == .pipe-write-each-op
    = infer-write-each(id, left, right)
if op == .stream-pattern-pipe-op
    = infer-pattern-pipe(id, left, right)
. listing = tree.listed-bullets(id)
=? infer-listed-bullets(id, right, listing) if listing != 0
. source = infer-pipeline-source(left, id)
if source == invalid-type
    = invalid-type
. site = source-site(left, id)
. with-atom = program.store-atom("with")
do match op
    |= .pipe-forward-op
        . result = infer-pipe-forward(id, source, site, right)
        if site == id
            facts.set-answer-type(instance, id, result)
        = result
    |= .map-op
        = infer-pipeline-closure(id, source, site, program.store-atom("map"), with-atom, false)
    |= .filter-op
        . where-atom = program.store-atom("where")
        = infer-pipeline-closure(id, source, site, program.store-atom("filter"), where-atom, false)
    |= .map-filter-op
        . map-filter-atom = program.store-atom("map-filter")
        = infer-pipeline-closure(id, source, site, map-filter-atom, with-atom, true)
    |= .pipe-repeat-op
        = infer-pipeline-closure(id, source, site, program.store-atom("tap"), with-atom, false)
    |= .pipe-closure-op
        . decl = nested-decl-of(id)
        if decl == 0
            decline(id)
            = invalid-type
        = calls.generator-call(id, demand-nested(decl, source))
    |= .pipe-write-all-op
        . sink = infer(right)
        if sink == invalid-type
            = invalid-type
        calls.operator-call(id, sink, program.store-atom("<-write"), left, source)
        if site == id
            facts.set-answer-type(instance, id, sink)
        = sink
    ??
        decline(id)
        = invalid-type

────────────────────
_ do infer-pattern-pipe TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` A stream piped through a pattern, `s ~> p`, as the reference lowers it: a call of the
` generator closure generated for it, given the left value, which yields what each match of
` the pattern gives. The value is given as `pipe-source` casts it, and a bullet the pipe reads
` alone is given nothing: the closure evaluates what it writes. A pattern that may match
` without reading, where the reference knows what it reads first, is an error: the pipe would
` never end, and so is a value the reference makes no stream of, which the closure loops over
` through its stream, iterable or not. A cast value the reference describes has no shape here: it names the closure for
` the cast, not for what it casts. Nor has any other list of bullets, whose yields the
` reference types again for the item it prefers.
. piped = tree.piped-bullet(id)
if piped == 0 && tree.nodes[left] is .node-bullet-expression
    decline(id)
    = invalid-type
. source = if piped == 0 then infer(left) else no-type
if source == invalid-type
    = invalid-type
. pattern = right
do match? tree.nodes[right]
    | .node-stream-match(row)
        pattern = row.pattern
if first-set(pattern) == 3 || never-reads(pattern)
    frame.diagnose(right, .stated, program.store-atom("Stream pattern pipeline must consume input"))
    = invalid-type
. decl = nested-decl-of(id)
if decl == 0
    decline(id)
    = invalid-type
. mark = facts.diagnostics.length
if piped != 0
    = generated-call(id, demand-nested(decl, no-type), mark)
. given = pipe-source(left, source, pattern)
if given == invalid-type || (given != source && description-of(tree, left) != "node")
    decline(id)
    = invalid-type
if !iterates(given) && natural-item(given) == no-type
    frame.diagnose(right, .stated, program.store-atom("Can't convert to iterable"))
    = invalid-type
= generated-call(id, demand-nested(decl, given), mark)

────────────────────
_ do generated-call TypeId
    - id SyntaxId
    - callee InstanceId
    - mark Size

` The call of the generator closure generated for a comprehension or a pipe, which gives the
` generator. None where the closure, or anything typed for it since `mark`, was refused or
` reported: what it yields is not known, and the value has no shape.
if facts.declined-since(0, callee) || facts.diagnostics.length != mark
    = invalid-type
= calls.generator-call(id, callee)

────────────────────
_ do pipe-source TypeId
    - site SyntaxId
    - source TypeId
    - pattern SyntaxId

` The value the reference gives the closure of a stream piped through a pattern, for each
` item the pattern prefers in turn: the value as it is where the stream it is read through
` reads that item, else the value cast to what `source-for-item` finds for it. The value as
` it is where it is cast for none.
. preferred [TypeId]
if !preferred-items(pattern, preferred)
    = invalid-type
. natural = natural-item(source)
for item in preferred
    if natural == item
        = source
    . target = source-for-item(source, item)
    if target != no-type
        if target != source && conversions.convert(site, site, source, target, .reason-argument) == invalid-type
            = invalid-type
        = target
= source

────────────────────
_ do piped-source TypeId
    - bullet SyntaxId
    - pattern SyntaxId

` What a bullet that a stream piped through a pattern reads alone writes, evaluated in the
` closure and cast as the reference casts it, for each item the pattern prefers in turn: to
` what `source-for-item` finds for that item. One cast for none has no shape here: the
` reference generates the bullet's own closure. The reference finds the cast of a `use` for
` the type of what it uses, so one whose `begin-using` gives another type has none either.
. item SyntaxId = 0
do match? tree.nodes[bullet]
    | .node-bullet-expression(row)
        item = row.item
. value = infer(item)
if value == invalid-type
    = invalid-type
do match? tree.nodes[item]
    | .node-use-expression(row)
        if optional-chain-expr(row.expr) != 0 || facts.node-type(instance, row.expr) != value
            decline(bullet)
            = invalid-type
. preferred [TypeId]
if !preferred-items(pattern, preferred)
    decline(bullet)
    = invalid-type
for preference in preferred
    . target = source-for-item(value, preference)
    if target != no-type
        if target != value && conversions.convert(item, item, value, target, .reason-argument) == invalid-type
            = invalid-type
        = target
decline(bullet)
= invalid-type

────────────────────
_ do preferred-items Bool
    - pattern SyntaxId
    - preferred [TypeId]

` The items the reference prefers a stream piped through a pattern to read, in order: where
` the pattern, under the captures, transforms, panics, repeats and lookaheads around it, calls
` a rule plainly, the one item every rule of that name the module reaches declares, where they
` agree; else characters and then bytes. A call of a local rule, of a pattern a name holds or
` given types has no shape here.
. node = pattern
. peeling = true
while peeling
    peeling = false
    do match? tree.nodes[node]
        | .node-stream-capture(row)
            node = row.pattern
            peeling = true
        | .node-stream-panic(row)
            node = row.pattern
            peeling = true
        | .node-stream-transform(row)
            if row.pattern != 0
                node = row.pattern
                peeling = true
        | .node-stream-unary(row)
            node = row.operand
            peeling = true
        | .node-stream-length(row)
            node = row.operand
            peeling = true
. declared = no-type
do match? tree.nodes[node]
    | .node-stream-call(row)
        if rule-of(node) != 0 || holds-value(node) || row.params.count != 0
            = false
        . agreed = true
        for candidate in program.lookup(module, row.name)
            . item = rule-item(candidate.module, candidate.decl)
            if item != no-type
                agreed = agreed && (declared == no-type || declared == item)
                declared = item
        if !agreed
            declared = no-type
if declared != no-type
    preferred += declared
else
    preferred += types.type-row(.char)
    preferred += types.type-row(.uint8)
= true

────────────────────
_ do rule-item TypeId
    - module ModuleId
    - decl DeclId

` The item a rule a module declares is over, where it states one that holds no type parameter.
` None for any other declaration.
if rule-match(program, module, decl) == 0
    = no-type
. owner = program.modules[module]
do match? owner.decls[decl]
    | .decl-function(fn)
        do match? owner.tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                . item = types.evaluate-type(module, owner.tree, syntax.pattern, types.env-frame())
                if item != invalid-type && !types.completions[item].has-variables
                    = item
= no-type

────────────────────
_ natural-item TypeId
    - source TypeId

` The item of the stream the reference reads a value through, as `record-stream-protocol`
` makes it, or none where it reads it through none.
|? source == no-type || source == invalid-type
    no-type
|? given != no-type
    first-arg(given)
|? source == types.string-type
    types.type-row(.char)
|? same-decl(ref, types.generator-decl) || (kind == .interface && cursor-iterable)
    first-arg(source)
|? kind != .class && kind != .struct && kind != .tuple && kind != .interface
    no-type
|? supported(source, types.byte-readable-decl) != no-type
    if decodable != no-type then first-arg(decodable) else types.type-row(.uint8)

    .. decodable = supported(source, types.decodable-decl)
|? indexable != no-type
    first-arg(indexable)
??
    if iterable != no-type then first-arg(iterable) else no-type

.. kind = types.intrinsic-of(source)
.. given = if kind == .class || kind == .interface then stream-support else no-type
.. ref = class-ref(types, source)
.. indexable = supported(source, types.indexable-decl)
.. iterable = supported(source, types.iterable-decl)
.. stream-support = supported(source, types.token-stream-decl)
.. cursor-iterable = same-decl(ref, types.cursor-iterable-decl)

────────────────────
_ supported TypeId
    - source TypeId
    - decl DeclRef

` The type of a declaration a value supports, as the reference finds the stream to read it
` through: the value's own, that of a class it derives from, or an interface any of them
` declares or one of those derives from; else what a converter any of them declares makes,
` of that declaration. None where it supports none.
if found != no-type then found else converted-class(source, decl)

.. found = derived-interface(source, decl)

────────────────────
_ do derived-interface TypeId
    - type TypeId
    - decl DeclRef

` The type of a declaration a type is, derives from, or declares as an interface, or one of
` those does, searched in that order, completing the type, which completes the classes above it.
if same-decl(class-ref(types, type), decl)
    = type
types.complete(type)
. base = types.base-of(type)
if base
    . found = derived-interface(base, decl)
    if found != no-type
        = found
for interface in types.interfaces-of(type)
    . found = derived-interface(interface, decl)
    if found != no-type
        = found
= no-type

────────────────────
_ do converted-class TypeId
    - type TypeId
    - decl DeclRef

` What a converter a type declares makes, where it is of a declaration, else what one a
` class it derives from or an interface it declares does, searched in that order, completing the
` type, which completes the classes above it.
. declared = relations.declared-converter(type, decl)
if declared != no-type
    = declared
types.complete(type)
. base = types.base-of(type)
if base
    . found = converted-class(base, decl)
    if found != no-type
        = found
for interface in types.interfaces-of(type)
    . found = converted-class(interface, decl)
    if found != no-type
        = found
= no-type

────────────────────
_ do source-for-item TypeId
    - source TypeId
    - item TypeId

` What the reference casts a value piped through a pattern to, to read items of a type: the
` value's own type where it is a generator of them, else the first of an `Iterable`, an
` `Indexable` and a `Stream` of them it converts to. None where it converts to none.
if same-decl(class-ref(types, source), types.generator-decl) && first-arg(source) == item
    = source
for decl in [types.iterable-decl, types.indexable-decl, types.stream-decl]
    . target = class-over(decl, item)
    if relation-legal(conversions.compare-held(source, target))
        = target
= no-type

────────────────────
_ do first-set U32
    - id SyntaxId

` What the reference knows of the first item a stream pattern reads, as it works it out to
` choose among arms: 1 where it knows what that item may be, and 2 more where the pattern may
` read none. A call, a test of a type, a predicate or text found as the pattern runs is not
` known, and a lookahead reads none and is not known either.
do match? tree.nodes[id]
    | .node-stream-match(row)
        = first-set(row.pattern)
    | .node-stream-string(row)
        = if row.text.length == 0 then 3 else 1
    | .node-stream-any
        = 1
    | .node-stream-char-range
        = 1
    | .node-stream-and(row)
        . leading = first-set(row.left)
        if (leading /and/ 2) == 0
            = leading
        . following = first-set(row.right)
        = (leading /and/ following /and/ 1) /or/ (following /and/ 2)
    | .node-stream-or(row)
        . left = first-set(row.left)
        . right = first-set(row.right)
        = (left /and/ right /and/ 1) /or/ ((left /or/ right) /and/ 2)
    | .node-stream-unary(row)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = 2
        . item = first-set(row.operand) /and/ 1
        = if row.op == .one-or-more-op then item else (item /or/ 2)
    | .node-stream-length(row)
        do match? tree.nodes[row.min]
            | .node-integer-syntax(bound)
                . item = first-set(row.operand) /and/ 1
                = if parse-integer-literal(bound.value).value == 0 then (item /or/ 2) else item
    | .node-stream-capture(row)
        = first-set(row.pattern)
    | .node-stream-transform(row)
        if row.pattern != 0
            = first-set(row.pattern)
    | .node-stream-panic(row)
        = first-set(row.pattern)
= 0

────────────────────
_ do never-reads Bool
    - id SyntaxId

` Whether a stream pattern matches without ever reading an item: one made only of lookaheads.
do match? tree.nodes[id]
    | .node-stream-match(row)
        = never-reads(row.pattern)
    | .node-stream-unary(row)
        = row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
    | .node-stream-and(row)
        = never-reads(row.left) && never-reads(row.right)
    | .node-stream-or(row)
        = never-reads(row.left) && never-reads(row.right)
    | .node-stream-capture(row)
        = never-reads(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && never-reads(row.pattern)
= false

────────────────────
_ optional-match-text String
    - form String

` The error for a stream pattern loop or pipeline whose matches give an optional value, which
` the values it gives can't hold, since none of them ends it.
"Stream pattern $form can't give an optional value; add an action that gives one"

────────────────────
_ do check-pattern-pipe
    - id SyntaxId
    - right SyntaxId

` The body of the generator closure a stream piped through a pattern compiles as, as the reference
` makes it: the value it is given is read through the stream a match would read it through, made
` once, and on each pass the pattern matches from where the last left the stream, as a rule's arms
` match, without reading the rest. Each pass first asks the stream whether it has more, and marks
` where it is before the match and after it, to panic where a match read nothing. Each value a
` match gives is yielded; the closure ends where the stream has no more, or the pattern fails. A
` stream made of a value that is none is the closure's own, and where it can be released, it is
` released first on each pass. A bullet the pipe reads alone is evaluated here, as `piped-source`
` casts it. A helper the pipe is given with `with` is evaluated once, after the stream is made,
` and every match runs under it, as a match given one does. One that marks the records a pipe
` matches is asked to begin each record where the stream has more, before the stream is marked,
` through the property it delegates that to where it does. A pattern whose value is optional is
` an error.
. pattern = right
. helper SyntaxId = 0
do match? tree.nodes[right]
    | .node-stream-match(row)
        pattern = row.pattern
        helper = row.helper
. piped = tree.piped-bullet(id)
. container = if piped != 0 then piped-source(piped, pattern) else first-argument
    .. first-argument = instances.argument-type(instance, 0)
if container == invalid-type
    =
note-poll()
. buffer = stream-view
. read = record-stream-protocol(right, container)
. made = stream-view.type
. saved-helper = helping
helping = helping.helper = null
helping = helping.site = 0
helping = helping.rolls = false
helping = helping.explicit = false
helping = helping.body = if helper != 0 then right else 0
. helped = helper == 0 || type-helper(helper)
. helper-type = if helper != 0 && helped then facts.node-type(instance, helper) else no-type
. typed = if read && helped then type-stream-arms(pattern, true) else invalid-type
if typed != invalid-type && helping.rolls && helping.helper!.rollback == no-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom
            - "Pattern @rollback helper must implement PatternRollback with a concrete Mark type"
    typed = invalid-type
helping = saved-helper
stream-view = buffer
if !helped
    =
if !read
    decline(id)
    =
if typed == invalid-type
    =
if types.is-optional(typed)
    frame.diagnose(right, .stated, program.store-atom(optional-match-text("pipeline")))
    =
if supported(container, types.token-stream-decl) == no-type
    calls.protocol-call(made, program.store-atom("pattern-release"), id)
if calls.protocol-getter(made, program.store-atom("has-more"), id) != types.bool-type
    decline(id)
    =
. mark = calls.protocol-call(made, program.store-atom("mark"), id).answer
if mark == invalid-type || field-of(mark, 1) != types.index-type
    decline(id)
    =
if helper-type != no-type && pattern-helper(types, helper-type).boundary != no-type
    . receiver = capability-receiver(helper-type, pattern-helper(types, helper-type).boundary)
    . places [U32]
    if receiver == no-type || (receiver != helper-type && !calls.ranking.delegate-path(helper-type, receiver, places))
        decline(id)
        =
    . recording = calls.protocol-call(receiver, program.store-atom("begin-pattern-record"), id)
    if recording.fact == no-fact
        decline(id)
        =
    if places.length != 0
        facts.calls[recording.fact].through = facts.keep-steps
            - places
            - calls.step-getters(places)
keep-loop(id, container, made, helper-type)
note-yield(typed)

────────────────────
_ do infer-write-each TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` A pipe that writes each item of what it reads to what is on the right, as the reference
` lowers it: what is on the right first, then a loop over the left value, planned at the
` pipe with the calls of its protocol, each turn of which gives the item to the function the
` right's type declares for a write, recorded at the pipe after them. The pipe gives what it
` wrote to.
. sink = infer(right)
. container = loop-container(left)
if sink == invalid-type || container.type == invalid-type
    = invalid-type
. item = container.item
if item != no-type
    plan-range-at(id, item)
else
    . iterated = iteration-container(container.type, left)
    item = loop-item-type(iterated, id)
    if item == invalid-type
        = invalid-type
    plan-iteration-at(id, id, iterated, item, false)
calls.operator-call(id, sink, program.store-atom("<-write"), left, item)
= sink

────────────────────
_ do infer-pipeline-source TypeId
    - left SyntaxId
    - id SyntaxId

do match? tree.nodes[left]
    | .node-bullet-expression
        = infer-bullets(left, id)
= infer(left)

────────────────────
_ source-site SyntaxId
    - left SyntaxId
    - id SyntaxId

` The reference converts a pipeline's left value where that value was produced: at the left
` operand, which for a bullet list is where its shifted first bullet lands.
match tree.nodes[left]
    | .node-bullet-expression
        bullet-site(left, id)
    ??
        left

────────────────────
_ do infer-pipe-forward TypeId
    - id SyntaxId
    - source TypeId
    - site SyntaxId
    - right SyntaxId

` A forward pipe: the call on the right given its own arguments and then, unnamed, the left value,
` produced at `site`, as the reference's `compilePipe` passes it.
. params-start = scratch.types.mark
. param-count = 0
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. callable = right
. object = CalledObject()
do match? tree.nodes[right]
    | .node-call-expression(call)
        callable = call.callable
        for param in tree.children[call.params]
            scratch.types.push(types.evaluate-type(module, tree, param, frame.env))
            param-count += 1
        object = type-called-object(callable, call.args.count + 1)
        for arg in tree.children[call.args]
            do match tree.nodes[arg]
                | .node-argument(argument)
                    scratch.types.push
                        - infer-argument(argument.expr, argument-symbol(argument.expr))
                    scratch.call-arguments.push
                        - argument-shape(argument.name, argument.is-optional, argument.expr)
                    scratch.syntax.push(arg)
                ??
                    scratch.types.push(infer-argument(arg, argument-symbol(arg)))
                    scratch.call-arguments.push(argument-shape(null, false, arg))
                    scratch.syntax.push(arg)
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(source)
scratch.syntax.push(site)
. params = scratch.types.span(params-start, param-count)
. arguments = arguments-since(shapes-start, types-start, syntax-start, params, false, if site == id then id else 0)
called-object = object
. result = infer-callable(id, callable, arguments).type
called-object = CalledObject()
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do infer-pipeline-closure TypeId
    - id SyntaxId
    - source TypeId
    - site SyntaxId
    - name Atom
    - argument-name Atom
    - explicit Bool

` A map, filter, map-filter or tap pipeline: the stream function `name` given the left value and,
` as `argument-name`, the right operand's closure over `each`, as the reference lowers it. Where
` `explicit` asks, the call names its types, the item and what the closure's optional holds;
` where the closure answers no optional, the call infers them, as the reference's
` `inferMapFilterClosureParamTypes` leaves them. A map-filter whose closure gives a value that
` is never null drops nothing, and is an error that asks for a map.
. item = pipeline-item-type(source)
. decl = nested-decl-of(id)
if item == invalid-type || decl == 0
    decline(id)
    = invalid-type
. callee = demand-nested(decl, item)
. closure = intern-nested(decl)
. params-start = scratch.types.mark
. param-count = 0
. returned = if explicit then instances.signatures[callee].returns else no-type
if explicit && returned == no-type
    decline(id)
    = invalid-type
if explicit && returned != invalid-type && returned != types.void-type && !types.is-optional(returned)
    . shown = type-short-name(types, returned)
    . message = "The body of this \"?*>\" gives $shown, which is never null, so it drops no item; write \"*>\""
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if explicit && types.is-optional(returned)
    scratch.types.push(item)
    scratch.types.push(types.optional-inner(returned))
    param-count = 2
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(source)
scratch.syntax.push(site)
scratch.call-arguments.push(CallArgument(argument-name, false, false, false, false, null))
scratch.types.push(closure)
scratch.syntax.push(id)
. params = scratch.types.span(params-start, param-count)
. arguments = arguments-since(shapes-start, types-start, syntax-start, params, false, if site == id then id else 0)
. result = calls.function-call(id, name, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do pipeline-item-type TypeId
    - source TypeId

` The item a pipeline body receives: a generator's, else the stream, iterable, or indexable
` item of the left value, in the reference's order.
if source == invalid-type || source == no-type
    = invalid-type
types.complete(source)
if same-decl(class-ref(types, source), types.generator-decl)
    . item = first-arg(source)
    = if item != no-type then item else invalid-type
. streamed = iterable-item(source, types.stream-decl)
if streamed == no-type
    streamed = iterable-item(source, types.iterable-decl)
if streamed == no-type
    streamed = iterable-item(source, types.indexable-decl)
= if streamed != no-type then streamed else invalid-type

────────────────────
_ do check-subscription
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - decl DeclId

` A loop on a stream where it is written, as the reference compiles one with no `whenever`
` clause: the container is made a `Broadcastable`, and the loop's subscriber, a closure of the
` item and the stream, is made a `Subscriber` and given to the broadcaster's `subscribe`, both
` recorded at the `for` block, whose errors leave the function as those of a call written
` there would. One in a method of an object or a section of a class, which the object owns, is
` subscribed as `own-subscription` says, and one with a `whenever` clause as
` `subscribe-whenever` says.
. stream = subscribed-stream(id, loop, container, clause, true)
. event = subscribed-event
subscribed-event = null
if stream == no-type
    =
. item = first-arg(stream)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if item == no-type || subscriber == invalid-type
    decline(id)
    =
. closure = intern-nested(decl)
facts.set-node-type(instance, id, closure)
if conversions.convert(id, id, closure, subscriber, .reason-argument) == invalid-type
    =
if event
    subscribe-event(id, container, event, stream, item, subscriber, closure)
else if whenever-of(loop) != 0
    subscribe-whenever(id, whenever-of(loop), stream, item, subscriber)
else if is-owner()
    own-subscription(id, stream, item, subscriber)
else if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscriber, true).answer == invalid-type
    decline(id)

────────────────────
_ do subscribe-event
    - id SyntaxId
    - container SyntaxId
    - event NamedEvent
    - stream TypeId
    - item TypeId
    - subscriber TypeId
    - closure TypeId

` A loop on an event, as the reference subscribes one: the subscriber is made an event's
` subscription, which runs it as the event is published and reports what it raises as
` unhandled, and that is given to the endpoint's `subscribe`, or owned by the object as a
` loop on a stream is. A section of a class that every class making it runs from its table,
` as `plan-event-handlers` plans it, is not subscribed: only its subscriber is typed, and
` where it lets errors out, what it gives them to (see `demand-hand-off`).
if id == lowering
    . start = scratch.types.mark
    scratch.types.push(item)
    scratch.types.push(stream)
    . run = demand-lambda(closure, scratch.types.since(start))
    scratch.types.rewind(start)
    if run != no-instance && !demand-hand-off(run)
        decline(id)
        =
    facts.event-uses += EventUse
        - instance
        - id
        - container
        - event.owner
        - event.name
        - .event-subscribe
        - subscribed-by
        - no-instance
        - run
    instances.mark-may-panic(instance)
    =
. subscribable = types.well-known-type-of("core/stream", "Subscribable", item)
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(subscriber)
scratch.types.push(types.type-row(.bool))
. wrap = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-subscription")
    - mark
    - 1
scratch.types.rewind(mark)
scratch.types.push(item)
scratch.types.push(stream)
. callback = demand-lambda(closure, scratch.types.since(mark))
scratch.types.rewind(mark)
. endpoint = subscribed-by
if wrap == no-instance || subscribable == invalid-type
    decline(id)
    =
if instances.signatures[wrap].returns != subscribable
    decline(id)
    =
if is-owner()
    own-subscription(id, stream, item, subscriber, wrap)
else if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscribable, true).answer == invalid-type
    decline(id)
    =
facts.event-uses += EventUse
    - instance
    - id
    - container
    - event.owner
    - event.name
    - .event-subscribe
    - endpoint
    - wrap
    - callback
    - event.address
instances.mark-may-panic(instance)

────────────────────
_ do demand-hand-off Bool
    - run InstanceId

` What a function the event runtime calls for a section of a class gives the errors its
` subscriber lets out to (see `hands-off`). Says whether that is in place, or nothing needs it.
demand-errors(run)
if instances.signatures[run].errors.count == 0
    = true
= hands-off(run)

────────────────────
_ do hands-off Bool
    - run InstanceId

` What a function gives the errors that leave it to where the reference keeps them from its
` caller: the global `unhandled-error` of core, typed, which holds a function that takes an
` `Error` and answers nothing, and read by the function as a checked read is, evaluated first
` where it has no value yet. Calling it may panic, as a call of any function value may. Says
` whether that is in place.
. module = class-ref(types, types.error-type).module
. decls = program.modules[module].decls
. name = program.store-atom("unhandled-error")
for position in 0 .. < decls.length
    do match? decls[position]
        | .decl-property(property)
            if property.owner == 0 && property.name && property.name == name
                . held = demand-property(module, position as DeclId)
                . fn = if held != invalid-type && held != no-type then held-row else no-type
                    .. held-row = function-row(types, held)
                if fn == no-type
                    = false
                do match? types.rows[fn]
                    | .type-function(row)
                        . answers = row.return-type != no-type && row.return-type != types.void-type
                        if row.is-c || answers || odd-signature || not-error
                            = false
                        .. odd-signature = row.errors.count != 0 || row.args.count != 1
                        .. not-error = types.child-type(row.args, 0) != types.error-type
                facts.unhandled-error = DeclRef(module, position as DeclId)
                facts.global-uses.append(GlobalUse(run, 0, module, position as DeclId))
                instances.mark-may-panic(run)
                = true
= false

────────────────────
_ do subscribed-stream TypeId
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - events Bool = false
    - want Want = Want()

` The container of a loop or a comprehension on a stream made a `Broadcastable` where it is
` written, as the reference makes it: cast where it supports
` one, and given to `publisher` where it only iterates, which is recorded at the header; the
` header has the broadcaster's type. Where `events` says a loop asks for one, an event of an
` object is the endpoint the event runtime keeps for it, recorded at the container and kept
` in `subscribed-event`; a first clause `when arrival` or `when bubbling` is then no clause but
` says which publications the loop hears (`facts.event-clauses`). No type where the container
` is not one, which is its error at `id`, or where the loop is not supported yet: one on an
` event with a `whenever` clause. A container that reads a tracked value must be a stream
` itself: one that only iterates is its error, which names the `whenever` that runs on the
` value's changes.
. found = infer-found(container, if events then want.adding(.want-event) else want)
. given = found.type
. tracked = tracked-read(container)
if tracked && found.event == U32.max && given != invalid-type && given != no-type && unbroadcast
    frame.diagnose
        - id
        - .stated
        - program.store-atom("#${tracked.text} is not a stream; use `whenever #${tracked.text}`")
    = no-type
.. unbroadcast = supported(given, types.broadcastable-decl) == no-type
if found.event != U32.max
    . event = found-events[found.event]
    if unaddressed(loop, event)
        = no-type
    if has-whenever(clause)
        decline(id)
        = no-type
    if arrival-clause(clause)
        do match? tree.nodes[clause]
            | .node-clause(row)
                do match? tree.nodes[row.expr]
                    | .node-identifier(name)
                        facts.event-clauses += EventClause
                            - module
                            - loop
                            - name.name.text == "arrival"
    = subscribed-endpoint(id, loop, container, event, given)
if arrival-clause(clause)
    do match? tree.nodes[clause]
        | .node-clause(row)
            if bindings.resolution-of(frame.binding, row.expr).kind == .resolve-unresolved
                frame.diagnose(row.expr, .stated, program.store-atom("Name not found"))
                = no-type
if given == invalid-type || given == no-type
    = no-type
if (has-whenever(clause) && whenever-of(loop) == 0) || types.broadcastable-decl.module == 0
    decline(id)
    = no-type
. stream = supported(given, types.broadcastable-decl)
. mark = scratch.types.mark
if stream == no-type && !iterates(given)
    . shown = type-display(types, given)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Object is not a broadcastable or iterable: $shown")
        - given
    = no-type
if stream == no-type
    scratch.types.push(given)
    . publisher = calls.demand-runtime-call
        - types.broadcastable-decl.module
        - no-type
        - program.store-atom("publisher")
        - mark
    scratch.types.rewind(mark)
    if publisher == no-instance
        decline(id)
        = no-type
    conversions.convert
        - loop
        - container
        - given
        - instances.argument-type(publisher, 0)
        - .reason-argument
    do facts.record-call(instance, loop, publisher, .call-function, scratch.no-fills, false)
    stream = instances.signatures[publisher].returns
else
    conversions.convert(loop, container, given, stream, .reason-argument)
facts.set-node-type(instance, loop, stream)
= stream

────────────────────
_ do tracked-read Atom?
    - id SyntaxId

` The name of a property or a local that an expression reads tracked, written `#name`, where
` it reads one.
for node in tree.subtree-start(id) .. < id + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked
                = row.name
        | .node-get-expression(row)
            if row.is-tracked
                = row.name
= null

────────────────────
_ do subscribed-endpoint TypeId
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId
    - event NamedEvent
    - stream TypeId

` The endpoint of an event a loop subscribes to, which the event runtime gives for the object
` and the event, recorded at the container and made the event's `Broadcastable` at the header.
` One at the address of a keyed event is claimed for the receiver at the loop (see
` `claim-endpoint`).
. keyed = event.address != 0
. endpoint = if keyed then event-call("event-keyed-endpoint", event.payload, no-type, 3) else event-call("event-endpoint", event.payload)
if endpoint == no-instance
    decline(loop)
    = no-type
if keyed && !claim-endpoint(id, id, event.address, endpoint)
    = no-type
conversions.convert
    - loop
    - container
    - instances.signatures[endpoint].returns
    - stream
    - .reason-argument
facts.set-node-type(instance, loop, stream)
subscribed-event = event
subscribed-by = endpoint
= stream

────────────────────
_ do arrival-clause Bool
    - clause SyntaxId

` Whether a loop on an event asks with its first clause, `when arrival` or `when bubbling`,
` for only the events that arrive at the object or for those that bubble too.
do match? tree.nodes[clause]
    | .node-clause(row)
        if row.op is .when-clause
            do match? tree.nodes[row.expr]
                | .node-identifier(name)
                    = name.name.text == "arrival" || name.name.text == "bubbling"
= false

────────────────────
_ do infer-broadcaster TypeId
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

` A comprehension on a stream, as the reference compiles it: the
` container is made a `Broadcastable` as a loop on a stream's is, an event of an object as
` the endpoint a value of its `Broadcastable` takes, and the
` comprehension's subscriber, a closure of the item and the stream, writes what its body gives
` to an `AsyncChannel` of the body's type, which is the comprehension's value. The subscriber
` is typed where it is made a `Subscriber`, before the channel, whose type its body decides; the
` channel is then made and kept in the local the subscriber captures, and the subscriber given
` to the broadcaster's `subscribe`, all recorded at the comprehension, or owned by the object
` as a loop's is, or subscribed as `subscribe-whenever` says where it has a `whenever` clause.
` A body that gives nothing is not supported: the reference fails inside the channel it makes.
. decl = nested-decl-of(id)
. channel-slot = bindings.resolution-of(frame.binding, id)
if decl == 0 || channel-slot.kind != .resolve-slot
    decline(id)
    = invalid-type
. stream = subscribed-stream(id, loop, container, clause, false, Want().adding(.want-adapt))
if stream == no-type
    = invalid-type
. item = first-arg(stream)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if item == no-type || subscriber == invalid-type
    decline(id)
    = invalid-type
. closure = intern-nested(decl)
if conversions.convert(id, id, closure, subscriber, .reason-argument) == invalid-type
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(stream)
. callee = demand-lambda(closure, scratch.types.since(mark))
scratch.types.rewind(mark)
. written = if callee != no-instance then facts.node-type(callee, body) else no-type
if written == no-type || written == invalid-type || written == types.void-type
    decline(id)
    = invalid-type
. channel = types.well-known-type-of("core/channel", "AsyncChannel", written)
. made = if channeled then calls.demand-constructor(channel, scratch.types.mark) else no-instance
    .. channeled = channel != invalid-type
if made == no-instance
    decline(id)
    = invalid-type
do facts.record-call(instance, id, made, .call-constructor, scratch.no-fills, false)
frame.assign(channel-slot.slot, channel)
if whenever-of(loop) != 0
    subscribe-whenever(id, whenever-of(loop), stream, item, subscriber)
else if is-owner()
    own-subscription(id, stream, item, subscriber)
else if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscriber, true).answer == invalid-type
    decline(id)
    = invalid-type
= channel

────────────────────
_ do subscribe-whenever
    - id SyntaxId
    - clause SyntaxId
    - stream TypeId
    - item TypeId
    - subscriber TypeId

` A loop or a comprehension on a stream with a `whenever` clause, as the reference subscribes
` it: the clause's value is typed where the loop is written, in a live action of its own, and
` must read something tracked. Where no object owns the subscription, the subscriber is
` wrapped in a `Subscription`, recorded at the clause, which is given to the broadcaster's
` `subscribe`, recorded at `id`, where the value holds. Where an object owns it, it is wrapped
` and given to a `SubscriptionTracker` as `own-subscription` says, at the clause, and the
` tracker is added to the action's trackers where the value holds. What the value gave, the
` subscription or its tracker, and the broadcaster are kept in the locals declared at the
` clause, which the function that tests the clause again captures; that function is typed
` once they are, and the live action that runs it is noted as a live statement's is, at the
` clause. A value that is no `Bool` has no shape here yet, nor has a clause where a batch of
` markup is in force, whose action the reference makes with the batch.
. expr = clause-expr(clause)
. resolution = bindings.resolution-of(frame.binding, clause)
if resolution.kind != .resolve-slot || in-batch()
    decline(id)
    =
. passed = infer(expr)
if passed == invalid-type
    =
if !tracks-reads(tree, expr)
    frame.diagnose
        - clause
        - .stated
        - program.store-atom
            - "whenever clauses must read at least one tracked property (like #is-open)"
    =
if passed != types.bool-type
    decline(clause)
    =
demand-live-runtime()
. live = instances.live
. wrapped = types.well-known-type-of("core/stream", "Subscription", item)
. subscribable = types.well-known-type-of("core/stream", "Subscribable", item)
if live.action == no-instance || live.previous == no-instance || missing-links
    decline(id)
    =
.. missing-links = live.next == no-instance || live.trackers == no-instance
if wrapped == invalid-type || subscribable == invalid-type
    decline(id)
    =
. kept = no-type
if is-owner()
    own-subscription(clause, stream, item, subscriber)
    . owned = facts.owned-subscription-of(instance, clause)
    if !owned
        =
    kept = instances.signatures[owned.tracker].returns
    if !owns-plain-actions(frame.self-type)
        live-owned = true
        own-markup-actions(frame.self-type, clause)
else
    . mark = scratch.types.mark
    scratch.types.push(subscriber)
    . made = calls.demand-constructor(wrapped, mark)
    scratch.types.rewind(mark)
    if made == no-instance
        decline(id)
        =
    kept = instances.signatures[made].returns
    do facts.record-call(instance, clause, made, .call-constructor, scratch.no-fills, false)
    conversions.convert(clause, clause, kept, subscribable, .reason-argument)
    if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscribable, true).answer == invalid-type
        decline(id)
        =
frame.assign(resolution.slot, passed)
frame.assign(resolution.slot + 1, kept)
frame.assign(resolution.slot + 2, stream)
. rerun = demand-lambda(intern-nested(nested-decl-of(clause)), scratch.no-types)
if rerun == no-instance || instances.signatures[rerun].errors.count != 0
    decline(id)
    =
facts.live-statements += LiveStatement(instance, clause, rerun)
instances.mark-may-panic(instance)

────────────────────
_ whenever-of SyntaxId
    - loop SyntaxId

` The `whenever` clause of a loop on a stream where a function of its own tests it again, or
` none.
if clause == 0 || nested-decl-of(clause) == 0 then 0 else clause

.. clause = tree.whenever-clause(loop)

────────────────────
_ do clause-expr SyntaxId
    - clause SyntaxId

` The value a clause tests.
do match? tree.nodes[clause]
    | .node-clause(row)
        = row.expr
= 0

────────────────────
_ do next-clause SyntaxId
    - clause SyntaxId

` The clause written after a clause, or none.
do match? tree.nodes[clause]
    | .node-clause(row)
        = row.next
= 0

────────────────────
_ is-owner Bool

` Whether what subscribes here is owned by an object: the markup element being built, the
` receiver of a method, or the object a class's section runs for. The reference gives such a
` subscription to the innermost element, or else to the object.
|? content-parents.length != 0
    types.intrinsic-of(content-parents[content-parents.length - 1]) == .class
??
    frame.self-type != no-type && frame.self-type != invalid-type && !lacks-self()

────────────────────
_ do is-subscriber-loop Bool
    - loop SyntaxId

` Whether the header of a loop reads a stream: `for x on s`.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        = row.is-subscriber
= false

────────────────────
_ do own-subscription
    - id SyntaxId
    - stream TypeId
    - item TypeId
    - subscriber TypeId
    - wrap InstanceId = no-instance

` A subscription the object owns, as the reference makes it: the subscriber is wrapped in a
` `Subscription`, or by `wrap` where one is given, which a `SubscriptionTracker` of the
` broadcaster subscribes when the live action that holds the tracker is made, and that action,
` whose callback does nothing, is the object's, so that closing the object unsubscribes it.
` What wraps and the tracker's constructor are kept for the node, and the subscription and the
` tracker are converted there to what they are given as.
demand-live-runtime()
. live = instances.live
. wrapped = types.well-known-type-of("core/stream", "Subscription", item)
. subscribable = types.well-known-type-of("core/stream", "Subscribable", item)
. tracking = types.well-known-type-of("core/tracker", "SubscriptionTracker", item)
. tracker = types.well-known-type("core/tracker", "Tracker")
if unwrapped || tracking == invalid-type || tracker == invalid-type || live-missing
    decline(id)
    =
.. unwrapped = wrapped == invalid-type || subscribable == invalid-type
.. live-missing = live.add-tracker == no-instance || live.action == no-instance
. mark = scratch.types.mark
. made = wrap
if made == no-instance
    scratch.types.push(subscriber)
    made = calls.demand-constructor(wrapped, mark)
    scratch.types.rewind(mark)
scratch.types.push(stream)
scratch.types.push(subscribable)
. tracks = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if made == no-instance || tracks == no-instance
    decline(id)
    =
conversions.convert(id, id, instances.signatures[made].returns, subscribable, .reason-argument)
conversions.convert(id, id, instances.signatures[tracks].returns, tracker, .reason-argument)
facts.owned-subscriptions += OwnedSubscription(instance, id, made, tracks)
instances.mark-may-panic(instance)

────────────────────
_ do check-subscriber
    - loop SyntaxId
    - body SyntaxId

` The subscriber of a loop on a stream: its header takes the item it is given, its clause is
` tested, and its body runs. A `while` or `until` clause, and a `break` that leaves no loop of
` the body, unsubscribe it from the stream it is given. Its own closure type is recorded at its
` `for` block, for the value it unsubscribes. A `break` or a `continue` in a loop of the body
` belongs to that loop.
. item = instances.argument-type(instance, 0)
. stream = instances.argument-type(instance, 1)
facts.set-node-type(instance, loop, stream)
facts.set-node-type(instance, frame.declaration.syntax, closure-of-self())
check-loop(loop, LoopContainer(stream, item), body, false)
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if ends-subscription(row.clause)
            demand-unsubscribe(loop)

────────────────────
_ do check-broadcast
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` The subscriber of a comprehension on a stream: its header takes the item it is given, its
` clauses are tested in the order written, and what its body gives is written to the channel the
` comprehension made, by `note-broadcast`. A `while` or an `until` unsubscribes it from the
` stream it is given, as a loop on a stream's does. Its own closure type is recorded at the
` comprehension, for the value it unsubscribes.
. item = instances.argument-type(instance, 0)
. stream = instances.argument-type(instance, 1)
facts.set-node-type(instance, loop, stream)
facts.set-node-type(instance, id, closure-of-self())
check-loop(loop, LoopContainer(stream, item), body, true)
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if ends-subscription(row.clause)
            demand-unsubscribe(loop)

────────────────────
_ do note-broadcast
    - body SyntaxId
    - written TypeId

` What the body of a comprehension on a stream gives, written to the comprehension's channel,
` an `AsyncChannel` of the body's type, by its `<-`, recorded at the comprehension; its errors
` leave the subscriber.
if written == invalid-type || written == no-type
    =
. channel = types.well-known-type-of("core/channel", "AsyncChannel", written)
if channel == invalid-type
    decline(body)
    =
. op = Operator.write-op
do calls.operator-call(frame.declaration.syntax, channel, program.store-atom("$op"), body, written)

────────────────────
_ do has-whenever Bool
    - clause SyntaxId

` Whether a loop's clauses include a `whenever`.
. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if row.op == .whenever-clause
                = true
            next = row.next
    current = next
= false

────────────────────
_ do ends-subscription Bool
    - clause SyntaxId

` Whether a loop's clauses include a `while` or an `until`, which end a subscription.
. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if row.op == .while-clause || row.op == .until-clause
                = true
            next = row.next
    current = next
= false

────────────────────
_ do is-subscriber-body Bool

` Whether the function being typed is the subscriber of a loop or a comprehension on a stream.
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        = fn.kind == .subscriber-decl
= false

────────────────────
_ do closure-of-self TypeId

` The closure type of the nested function being typed, as the instance that writes it made it.
. enclosing = instances.rows[instance].enclosing
if enclosing == no-instance
    = no-type
= types.intern-closure(module, frame.decl, enclosing, instances.stable-keys[enclosing])

────────────────────
_ do demand-unsubscribe
    - site SyntaxId

` The subscriber given as a `Subscriber` to its stream's `unsubscribe`, recorded at the node
` that unsubscribes: the `break` or the loop's header for its clause. It is made one as where it
` was subscribed, whose conversion its body, still being typed, cannot make again. An error
` that leaves `unsubscribe` is given to the global `unhandled-error` (`hands-off-raising`).
. item = instances.argument-type(instance, 0)
. stream = instances.argument-type(instance, 1)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if subscriber == invalid-type
    decline(site)
    =
. unsubscribing = calls.protocol-call(stream, program.store-atom("unsubscribe"), site, subscriber)
if unsubscribing.answer == invalid-type || !hands-off-raising(unsubscribing.fact)
    decline(site)
    =

────────────────────
_ do hands-off-raising Bool
    - call FactId

` What the function being checked gives the errors of a call the compiler places in it to,
` where the call may raise: the global `unhandled-error` (see `hands-off`), and the function
` goes on. Says whether that is in place, or nothing needs it.
if call == no-fact || instances.signatures[facts.calls[call].callee].errors.count == 0
    = true
= hands-off(instance)

────────────────────
_ do check-comprehension
    - loop SyntaxId
    - body SyntaxId

` The closure's body: the loop over its container argument, recorded at the header where the
` reference reads the passed container, yielding the body. The loop polls on each pass, as
` the `for` block the reference lowers it to does.
. container = instances.argument-type(instance, 0)
facts.set-node-type(instance, loop, container)
note-poll()
check-loop(loop, LoopContainer(container, no-type), body, true, false, true)

────────────────────
_ do check-clause
    - id SyntaxId
    - body SyntaxId

` A clause is tested as a condition. It holds wherever the loop's body runs, so what it tests
` is narrowed there.
do match? tree.nodes[id]
    | .node-clause(row)
        if row.op != .whenever-clause
            note-truthiness(row.expr, row.expr, infer-tested(row.expr))
        do match? row.op
            | .when-clause
                narrowing.narrow-condition(row.expr, true)
            | .while-clause
                narrowing.narrow-condition(row.expr, true)
            | .until-clause
                narrowing.narrow-condition(row.expr, false)
        if row.next != 0
            check-clause(row.next, body)

────────────────────
_ do assign-loop-slots
    - loop SyntaxId
    - item TypeId
    - wrap Bool

` `it` and `each` are the optional item under a pattern and the item itself without one, as
` the reference's loop lowering defines them; under a pattern written as a match they are
` the item as the pattern fitted it. The loop's header resolves to the first of the two the
` binder declared for it, and the other follows it.
. wrapped = if wrap && item != invalid-type then types.optional-of(item) else item
. first = bindings.resolution-of(frame.binding, loop)
if first.kind != .resolve-slot
    =
. bound = bindings.bindings[frame.binding]
. slot = first.slot
while slot < bound.slots.start + bound.slots.count
    . row = bindings.slots[slot]
    if (row.kind != .slot-it && row.kind != .slot-each) || row.syntax != loop
        =
    frame.assign(slot, wrapped)
    slot += 1

────────────────────
_ do stated-item TypeId
    - pattern SyntaxId

` The type a loop's pattern states for its item, when it states one and names no value.
if pattern != 0
    do match? tree.nodes[pattern]
        | .node-type-capture(row)
            if row.type != 0 && !reads-name(row.type)
                = types.evaluate-type(module, tree, row.type, frame.env)
= no-type

────────────────────
_ do loop-container LoopContainer
    - syntax SyntaxId
    - simple Bool = true
    - stated TypeId = no-type

` The container of a loop's header, typed. A range written there whose sides are integers
` written with no suffix is of the integer type the header's pattern states.
do match? tree.nodes[syntax]
    | .node-range-expression(row)
        if row.increment == 0
            . item = range-item(syntax, row.left, row.right, 0, stated)
            if item == invalid-type
                = LoopContainer(invalid-type, no-type)
            if is-integer(item) && simple
                . mark = scratch.types.mark
                scratch.types.push(item)
                . range = types.class-named-with-args(module, types.range-atom!, mark)
                facts.set-node-type(instance, syntax, range)
                = LoopContainer(range, item)
            . constructed = range-construction(syntax, row.op, item, row.left, row.right, 0)
            if constructed != no-type
                facts.set-node-type(instance, syntax, constructed)
            = LoopContainer(constructed, no-type)
= LoopContainer(infer(syntax), no-type)

────────────────────
_ is-simple-loop-pattern Bool
    - pattern SyntaxId

|? pattern == 0
    true
??
    match tree.nodes[pattern]
        | .node-identifier
            true
        | .node-type-capture(capture)
            capture.type == 0
        ??
            false

────────────────────
_ is-integer Bool
    - type TypeId

intrinsic-is-numeric(kind) && !intrinsic-is-float(kind) && kind != .cpointer

.. kind = types.intrinsic-of(type)

────────────────────
_ do iteration-container TypeId
    - container TypeId
    - site SyntaxId

` A container that is not iterable itself is iterated as the first iterable type it declares a
` conversion to, in the reference's order of iteration protocols.
if container == invalid-type || container == no-type
    = container
if interface-of(container, types.cursor-iterable-decl) != no-type
    = container
if interface-of(container, types.iterable-decl) != no-type
    = container
if implements(container, types.indexable-decl)
    = container
. converted = converted-iterable(container, types.generator-decl)
if converted == no-type
    converted = converted-iterable(container, types.cursor-iterable-decl)
if converted == no-type
    converted = converted-iterable(container, types.iterable-decl)
if converted == no-type
    converted = converted-iterable(container, types.indexable-decl)
if converted == no-type
    converted = converted-iterable(container, types.stream-decl)
if converted == no-type
    = container
= conversions.convert(site, site, container, converted, .reason-operand)

────────────────────
_ converted-iterable TypeId
    - container TypeId
    - protocol DeclRef

relations.converted-class(container, protocol.module, protocol.decl)

────────────────────
_ do loop-item-type TypeId
    - container TypeId
    - site SyntaxId
    - through-call Bool = false

if container == invalid-type || container == no-type
    = invalid-type
. container-kind = types.intrinsic-of(container)
. streamed = iterable-item(container, types.cursor-iterable-decl)
if streamed != no-type && container-kind == .interface
    . cursor = interface-of(container, types.cursor-iterable-decl)
    note-iterator-witness(cursor, program.store-atom("initial-iterator-state"), .getter-decl)
    note-iterator-witness(cursor, program.store-atom("next-iterator"), .function-decl)
if streamed == no-type
    streamed = iterable-item(container, types.iterable-decl)
if streamed != no-type
    = streamed
if implements(container, types.indexable-decl)
    if !is-array-field(container, types.length-atom!)
        calls.demand-getter(container, types.length-atom!, site)
    if is-table-container(container-kind) && !through-call
        = calls.index-item-type(container)
    = calls.index-item(container, site)
= invalid-type

────────────────────
_ do slice-through-call Bool
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-index-expression
        . fact = facts.first-call(instance, syntax)
        if fact == no-fact
            = false
        . callee = facts.calls[fact].callee
        if callee == no-instance
            = false
        = instances.rows[callee].module != types.table-module
= false

────────────────────
_ counts-rows Bool
    - container TypeId

` Whether a loop over a container counts through the rows of a table, of a span of one or of
` a selection of them, as TypeScript does by the container's type alone, rather than through a
` method of it. Its rows are structs or unions.
|? !is-column-receiver(kind) && !selects
    false
??
    row == .struct || row == .union

.. kind = types.intrinsic-of(container)
.. selects = kind == .table-selection || kind == .immutable-table-selection
.. row = types.intrinsic-of(row-struct-of(container))

────────────────────
_ counts-indices Bool
    - container TypeId
    - syntax SyntaxId

` Whether a loop over a container counts through the indices of an index span, as
` TypeScript's loop over what is indexable does, by its length and its `[]`.
types.intrinsic-of(container) == .index-span && !slice-through-call(syntax)

────────────────────
_ is-index-reader Bool
    - kind IntrinsicKind

` Whether a value reads indices: an index span, or a selection of a table's rows by one.
kind == .index-span || kind == .table-selection || kind == .immutable-table-selection

────────────────────
_ is-table-container Bool
    - kind IntrinsicKind

table || spans || .immutable-table-selection == kind || .index-span == kind

.. table = kind == .table || kind == .immutable-table
.. spans = kind == .table-span || kind == .immutable-table-span

────────────────────
_ implements Bool
    - container TypeId
    - decl DeclRef

interface-of(container, decl) != no-type

────────────────────
_ do note-iterator-witness
    - interface TypeId
    - name Atom
    - kind DeclKind

. ref = class-ref(types, interface)
if ref.module == 0 && ref.decl == 0
    =
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
. place = owner-module.first-member(members, name)
while place != no-member
    . member = owner-module.member-pool[place]
    place = owner-module.member-links[place]
    do match? owner-module.decls[member]
        | .decl-function(fn)
            if fn.kind == kind && fn.name && fn.name == name
                facts.record-witness-func(interface, ref.module, member)
                =
for parent in types.interfaces-of(interface)
    note-iterator-witness(parent, name, kind)

────────────────────
_ iterable-item TypeId
    - container TypeId
    - decl DeclRef

if interface != no-type then first-arg(interface) else no-type

.. interface = interface-of(container, decl)

────────────────────
_ do interface-of TypeId
    - container TypeId
    - decl DeclRef

` The interface of a declaration a type is or implements, its own before its bases': of
` several a class implements, the last it declares, whose functions answer for the earlier
` ones', as the reference finds them by name.
. current = container
while true
    . interfaces = types.interfaces-of(current)
    if same-decl(class-ref(types, current), decl)
        = current
    . found = no-type
    for interface in interfaces
        if same-decl(class-ref(types, interface), decl)
            found = interface
    if found != no-type
        = found
    . base = types.base-of(current)
    if !base
        = no-type
    current = base

────────────────────
_ first-arg TypeId
    - type TypeId

match types.rows[type]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
_ same-decl Bool
    - left DeclRef
    - right DeclRef

left.module == right.module && left.decl == right.decl

────────────────────
_ do closure-type TypeId
    - id SyntaxId

. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        for index in 0 .. < nested.captures.count
            if holds-tested(bindings.captures[nested.captures.start + index].slot)
                decline(id)
                = invalid-type
        = intern-nested(nested.decl)
decline(id)
= invalid-type

────────────────────
_ do note-case
    - site SyntaxId
    - about TypeId
    - name Atom

` Plans a node that names a case of a union as that case, by its number.
. completion = types.completion-of(about)
if completion.intrinsic != .union
    if facts.plan-of(instance, site) == .plan-case
        facts.set-plan(instance, site, .plan-none)
    =
for offset in 0 .. < completion.cases.count
    . fact = types.cases[completion.cases.start + offset]
    if fact.name && fact.name! == name
        facts.set-constant(instance, site, ConstantFact(offset, 0.0, null, false), .plan-case)
        =

────────────────────
_ do check-case
    - about TypeId
    - name Atom
    - written SyntaxId
    - declared SyntaxId

` A case's value is converted to its enum once, where the case is declared, however many
` places name the case. One a constructor of the enum makes has the call recorded there
` instead, with the value written as its argument. The value of a case of a union is held as
` that case, though another case holds the same type.
. literal = enum-case-type(about, name)
if literal == invalid-type && written != 0
    literal = written-type(written)
if literal == no-type || literal == invalid-type || literal == about
    =
if !is-numeric(types, about) && types.intrinsic-of(about) != .union
    . mark = scratch.types.mark
    if written != 0
        scratch.types.push(literal)
    . callee = calls.demand-constructor(about, mark)
    scratch.types.rewind(mark)
    if callee != no-instance
        if written != 0
            written-type(written)
        make-case(declared, about, written, literal)
        =
. relation = relations.compare(literal, about, false, false, null, module)
if written != 0 && !relation-legal(relation)
    facts.record-diagnostic(instance, module, written, .illegal-cast, null, literal, about)
    =
. site = if written != 0 then written else declared
if types.intrinsic-of(about) == .union
    . position U32
    for fact in types.cases-of(about)
        if fact.name && fact.name! == name
            conversions.convert-into-case(site, literal, about, position, .reason-assignment)
            =
        position += 1
conversions.convert(site, site, literal, about, .reason-assignment, true, true)

────────────────────
_ do make-case
    - declared SyntaxId
    - about TypeId
    - written SyntaxId
    - literal TypeId

` Records, where a case is declared, the call of the constructor of its enum that makes its
` value: given the value written for the case, or nothing.
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
if written != 0
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(literal)
    scratch.syntax.push(written)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.construction-on(declared, about, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do written-type TypeId
    - written SyntaxId

` The type of a value written for a case that is no literal: as the module's main typed it
` where it did, and else typed here.
. main = instances.intern(module, program.modules[module].main-decl, no-type, 0, no-instance)
. typed = facts.node-type(main, written)
= if typed != no-type then typed else infer(written)

────────────────────
_ do note-truthiness
    - site SyntaxId
    - condition SyntaxId
    - type TypeId
    - is-right Bool = false

` A value tested as a condition. One of a class or a text is asked whether it is empty, and
` the call is recorded at the site as the test: of the site's own value, or of an operand of
` the site when the condition is another node. `is-right` says the operand is the right one.
` A tuple, a struct, a table or a builder that says whether it is empty, as an array does, is
` asked too. A function value has no truth, nor has an object of a class, or a value of a tuple,
` a struct, a table or a builder, that does not say whether it is empty, which is reported at
` the site as `!` not defined for it.
forget-carried(condition)
if type == invalid-type || type == no-type
    =
. negation = program.store-atom("!")
if type == types.void-type
    frame.diagnose(site, .illegal-operation, negation, type)
    =
. completion = types.completion-of(type)
if completion.intrinsic == .closure || completion.intrinsic == .binding
    frame.diagnose(site, .illegal-operation, negation, type)
    =
. valued = completion.intrinsic == .tuple || completion.intrinsic == .struct || held
    .. held = completion.intrinsic == .table || completion.intrinsic == .immutable-table || completion.intrinsic == .array-builder
if completion.intrinsic != .class && completion.intrinsic != .string && !valued
    =
if completion.intrinsic == .class && completion.is-builtin
    =
if (valued || completion.intrinsic == .class) && calls.demand-method(type, negation) == no-instance
    frame.diagnose(site, .illegal-operation, negation, type)
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. first FactId = facts.calls.length as FactId
calls.method-call(site, condition, type, negation, arguments)
facts.mark-truth(instance, site, first, site != condition, is-right)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do is-super-syntax Bool
    - id SyntaxId

do match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, id)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == .slot-super
= false

────────────────────
_ do infer-symbol TypeId
    - id SyntaxId
    - name Atom

` A case named by its symbol alone, of the type its name alone gives. Where no type the module
` can name has it, it is of one of the program's that has it until the type expected of it
` settles it (`leave-unfound`), and where none has it, it is not found.
. owner = anonymous-symbol(id, name)
if owner == no-type
    owner = symbol-class(types, module, name)
if owner != invalid-type
    note-enum-case(owner, name, id)
    = owner
owner = program-symbol-class(types, name)
if owner == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Case not found"))
    = invalid-type
note-enum-case(owner, name, id, false)
calls.leave-unfound(id)
= owner

────────────────────
_ do infer-armed-symbol TypeId
    - id SyntaxId
    - name Atom

` A case named by its symbol alone that gives an arm of a match its value: of the type expected
` of the match where it has the case or another that converts to it does (`contextual-symbol`),
` as the reference casts each arm to that type, else as any other.
. owner = contextual-symbol(types, relations, arming.expected, name, module)
if owner == invalid-type
    = infer-symbol(id, name)
note-enum-case(owner, name, id)
note-unsettled(id, arming.expected)
= owner

────────────────────
_ do symbol-sharers
    - expr SyntaxId
    - owners [TypeId]

` The types the module can name that have the case an expression names by its symbol alone,
` where no union of anonymous cases has it: none for any other expression.
. name = symbol-of(expr)
if !name
    =
. unions [TypeId]
. labels [Atom]
symbol-unions(name, unions, labels)
if unions.length == 0
    symbol-owners(types, module, name, owners)

────────────────────
_ do shared-symbol Bool
    - expr SyntaxId

` Whether an expression names a case by its symbol alone that several types the module can name
` have, where no union of anonymous cases has it.
. owners [TypeId]
symbol-sharers(expr, owners)
= owners.length > 1

────────────────────
_ do loose-symbol Bool
    - expr SyntaxId

` Whether an expression names a case by its symbol alone that several types have
` (`shared-symbol`), typed as the one its name alone gives: as the reference leaves it, of none
` of them until a cast settles it.
. owners [TypeId]
symbol-sharers(expr, owners)
= owners.length > 1 && facts.node-type(instance, expr) == owners[owners.length - 1]

────────────────────
_ do note-loose
    - expr SyntaxId

` Notes a case named by its symbol alone that is used with no cast to settle which type's it is,
` to report as the reference reports one it never casts (`settle-later`).
if loose-symbol(expr)
    calls.settle-later(expr, symbol-of(expr)!)

────────────────────
_ do note-unsettled
    - expr SyntaxId
    - expected TypeId
    - explicit Bool = false

` Notes a case named by its symbol alone that a cast to the type expected of it leaves of no one
` type (`keeps-symbol`).
. name = symbol-of(expr)
if name && calls.keeps-symbol(expr, facts.node-type(instance, expr), expected, name, explicit)
    note-loose(expr)

────────────────────
_ symbol-of Atom?
    - expr SyntaxId

match? tree.nodes[expr]
    | .node-symbol(row)
        row.name

────────────────────
_ argument-symbol Atom?
    - expr SyntaxId

` The case an argument names by its symbol alone, bare or called with the case's values: the
` parameter it fills names the union.
match? tree.nodes[expr]
    | .node-symbol(row)
        row.name
    | .node-call-expression(row)
        symbol-of(row.callable)

────────────────────
_ argument-shape CallArgument
    - name Atom?
    - optional Bool
    - expr SyntaxId

CallArgument(name, optional, false, false, false, symbol, conversions.literal-of(expr), other)

.. chosen = symbol-choice(expr)
.. symbol = if chosen != 0 then symbol-of(chosen) else argument-symbol(expr)
.. other = if chosen != 0 then symbol-of(other-side(expr)) else null

────────────────────
_ do symbol-choice SyntaxId
    - expr SyntaxId

do match? tree.nodes[expr]
    | .node-binary-expression(row)
        if row.op == .else-op && symbol-of(row.rhs)
            do match? tree.nodes[row.lhs]
                | .node-binary-expression(side)
                    . type = facts.node-type(instance, row.rhs)
                    . agrees = type != invalid-type && type == facts.node-type(instance, side.lhs)
                    if side.op == .if-op && symbol-of(side.lhs) && agrees
                        = side.lhs
= 0

────────────────────
_ other-side SyntaxId
    - expr SyntaxId

match tree.nodes[expr]
    | .node-binary-expression(row)
        row.rhs
    ??
        0

────────────────────
_ do note-symbol-arm
    - about TypeId
    - arm SyntaxId

facts.replace-node-type(instance, arm, about)
note-enum-case(about, symbol-of(arm)!, arm)

────────────────────
_ do infer-argument TypeId
    - expr SyntaxId
    - symbol Atom?

` An argument is typed outside any `catch` its call is written under: an error it raises
` leaves the function, and the catch holds only the errors of the call itself. One that names
` an event is its `Broadcastable` (see `use-event`).
if symbol
    = types.void-type
. caught = frame.surround
frame.surround = frame.surround.catch-depth = 0
. type = infer(expr, Want().adding(.want-argument))
frame.surround = caught
= type

────────────────────
_ declares-error Bool
    - declared RowRange'TypeId
    - error TypeId

some(0 .. < declared.count) • where is-subtype(types, error, types.child-type(declared, each))

────────────────────
_ do run-within [Narrowed]
    - callee InstanceId
    - around Checker
    - nested Bool = false

` Types an instance written in another under the checker `around` of that one, in place where
` `nested`, as a closure, a task, a region or a body typed in place is. Answers what a region's
` body left the locals it captures as (`region-left`), which holds until another checker is made.
. checker = checker-for(session, callee, around, false, nested)
checker.run()
checker.retire()
= checker.region-left

────────────────────
_ do settled Checker
    - enclosing InstanceId

` A checker for an instance a closure was written in that has finished: it holds each
` local as the instance left it, and runs nothing. A closure written in a closure has one
` for each instance out to the first that is still running.
. around = instances.rows[enclosing].enclosing
. writer = if around != no-instance then definer(around) ?? settled(around) else null
. stand = checker-for(session, enclosing, writer, true)
stand.prepare()
for offset in 0 .. < stand.frame.slots.count
    . type = facts.slot-type(enclosing, offset)
    if type != no-type
        stand.frame.assign(stand.frame.slots.start + offset, type)
= stand

────────────────────
_ do dismiss

` Closes a settled checker, and then those made around it.
. around = outer
close()
retire()
if around && around.probing
    around.dismiss()

────────────────────
_ do decline
    - id SyntaxId

frame.diagnose(id, .not-supported)

────────────────────
_ do infer-integer TypeId
    - id SyntaxId
    - text String
    - unit Atom?

` An integer written with a builtin number's suffix is the bit pattern of that width, kept to
` its low bits, while one written with a unit a module declares must fit the unit's number type,
` as a plain integer given to it must.
. literal = parse-integer-literal(text)
. target = if unit then literal-unit(id, text, unit) else types.type-row(.uint64)
if unit && target != invalid-type && types.completions[target].has-variables
    . message = program.store-atom("Unit types must be numeric and unqualified")
    frame.diagnose(id, .stated, message)
    facts.inset-diagnostic(text.length as U32)
    = invalid-type
if target != invalid-type && (literal.overflow || unfit)
    . shown = program.store-atom(decimal-text(text))
    frame.diagnose(id, .literal-does-not-fit, shown, no-type, target)
    = invalid-type
.. unfit = unit && declared && !literal-fits-target(types, literal, builtin-number(types, target))
.. declared = builtin-number(types, target) != target
if unit
    = unit-literal(id, target)
= magnitude-type(types, literal)

────────────────────
_ do infer-unit-float TypeId
    - id SyntaxId
    - text String
    - unit Atom

` A number with a fraction written with a unit, which must hold fractions where it is a number
` of the unit's own.
. target = literal-unit(id, text, unit)
if target == invalid-type || declares-constructor(target)
    = unit-literal(id, target)
. number = builtin-number(types, target)
if is-integer-kind(types.intrinsic-of(number))
    . shown = type-short-name(types, target)
    . held = if number == target then "" else ", as ${type-short-name(types, number)} does"
    . message = "$shown holds whole numbers$held, so $text${unit.text} cannot be written; write a whole number"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
= unit-literal(id, target)

────────────────────
_ do unit-literal TypeId
    - id SyntaxId
    - unit-type TypeId

` A number written with a unit is of the unit's type. A unit that declares a constructor is
` constructed from the number, and the literal is what the constructor returns; one that
` declares none is a number, or no number can be written in it.
if unit-type == invalid-type
    = invalid-type
if is-unit-class(types, unit-type) && !declares-constructor(unit-type)
    if !intrinsic-is-numeric(types.intrinsic-of(builtin-number(types, unit-type)))
        . shown = type-short-name(types, unit-type)
        . message = "$shown is no number and declares no constructor that takes one, so no number can be written in its unit; declare $shown as a number type"
        frame.diagnose(id, .stated, program.store-atom(message))
        = invalid-type
    = unit-type
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(unit-type)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(id)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. result = calls.construction-on(id, unit-type, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do declares-constructor Bool
    - type TypeId

do match? types.rows[type]
    | .type-class(row)
        . module = program.modules[row.module]
        do match? module.decls[row.decl]
            | .decl-class(cls)
                if cls.members.count == 0
                    = false
                for member in module.member-pool[cls.members]
                    do match? module.decls[member]
                        | .decl-function(fn)
                            if fn.kind == .constructor-decl
                                = true
= false

────────────────────
_ do literal-unit TypeId
    - id SyntaxId
    - text String
    - unit Atom?

` The type the unit of a literal names. A unit that names no type is reported where it is
` written, past the digits.
. target = unit-class(unit)
if target == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Type not found"))
    facts.inset-diagnostic(text.length as U32)
= target

────────────────────
_ do unit-class TypeId
    - unit Atom?

if !unit
    = invalid-type
. found = types.type-named(module, unit, types.env-frame())
if found != invalid-type
    types.complete(found)
= found

────────────────────
_ do reads-uninitialized Bool
    - owner ModuleId
    - decl DeclId

` A module's globals take their values in the order they are declared, so the value of one
` cannot read a later one whose own value has yet to be computed. A global each task or each
` thread holds its own of, or that `do with` binds, takes its value before every other global
` of its module, so its value reads them checked, as a function does; it cannot read a later
` one of its own kind (see `reads-later-local`).
if initializing == 0 || owner != module || decl <= initializing
    = false
if initializes-early()
    = reads-later-local(owner, decl)
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        if row.owner != 0 || row.value == 0 || row.is-lazy || is-task-local(owner, decl)
            = false
        if is-thread-local(owner, decl) || is-stack-global(owner, decl)
            = false
        = !is-constant-global(owner, decl)
= false

────────────────────
_ reads-later-local Bool
    - owner ModuleId
    - decl DeclId

` Whether the value of a global each task or each thread holds its own of, or that `do with`
` binds, reads a later one of its kind, which takes its value after it: those each thread holds
` take theirs in the order they are declared, and so do the others together.
if is-thread-local(module, initializing) then is-thread-local(owner, decl) else later-other

.. later-other = is-task-local(owner, decl) || is-stack-global(owner, decl)

────────────────────
_ initializes-early Bool

` Whether the value being typed is that of a global each task or each thread holds its own
` of, or that `do with` binds: one that takes its value before the module's other globals.
|? initializing == 0
    false
??
    is-task-local(module, initializing) || is-thread-local(module, initializing) || stack-bound

.. stack-bound = is-stack-global(module, initializing)

────────────────────
_ do demand-global TypeId
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` The type of a global a name reads or writes. The use of one each task or each thread holds
` its own of is recorded once its value is typed, as TypeScript makes that value once it has
` compiled it.
. type = demand-property(owner, decl)
if is-task-local(owner, decl) || is-thread-local(owner, decl) || is-stack-global(owner, decl)
    facts.local-global-uses.append(LocalGlobalUse(instance, id, owner, decl))
= type

────────────────────
_ do is-task-local Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one each task holds its own of.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "task"
= false

────────────────────
_ do is-thread-local Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one each thread holds its own of.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "thread"
= false

────────────────────
_ do is-stack-global Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one `do with` binds.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "stack"
= false

────────────────────
_ do is-constant-global Bool
    - owner ModuleId
    - decl DeclId

` A global whose value is a literal laid down before anything runs: a number or a string, of a
` numeric type or String when it declares one. Every other global takes its value when its
` module starts, or, kept for each task or thread, as the task or thread starts.
. target = program.modules[owner]
do match? target.decls[decl]
    | .decl-property(row)
        if row.decoration != null
            = false
        . worded = row.value != 0 && is-string-literal(target.tree, row.value)
        if row.value != 0 && !worded && !is-constant-literal(owner, row.value)
            = false
        if row.type-syntax == 0
            = row.value != 0
        . env = types.env-frame()
        . declared = types.evaluate-type(owner, target.tree, row.type-syntax, env)
        if worded
            = declared == types.string-type
        = declared != invalid-type && is-numeric(types, declared)
= false

────────────────────
_ is-string-literal Bool
    - source AST
    - value SyntaxId

match source.nodes[value]
    | .node-string-syntax
        true
    ??
        false

────────────────────
_ do is-constant-literal Bool
    - owner ModuleId
    - value SyntaxId

` A number, a negated number, `true` or `false`, such a literal cast to a numeric type, or the
` least or greatest value of one. A number written with a unit that declares a constructor is
` what the constructor makes, and no literal.
. source = program.modules[owner].tree
do match? source.nodes[value]
    | .node-integer-syntax(row)
        = plain-unit(owner, row.unit)
    | .node-float-syntax(row)
        = plain-unit(owner, row.unit)
    | .node-unary-expression(row)
        = row.op == .negative-op && is-number(source, row.operand)
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom
    | .node-cast-expression(row)
        = is-constant-literal(owner, row.lhs) && names-numeric(owner, row.rhs)
    | .node-get-expression(row)
        . bound = row.name.text == "min" || row.name.text == "max"
        = bound && names-numeric(owner, row.object)
= false

────────────────────
_ plain-unit Bool
    - owner ModuleId
    - unit Atom?

|? !unit
    true
??
    found == invalid-type || !declares-constructor(found)

.. found = types.type-named(owner, unit, types.env-frame())

────────────────────
_ is-number Bool
    - source AST
    - value SyntaxId

match source.nodes[value]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    ??
        false

────────────────────
_ do names-numeric Bool
    - owner ModuleId
    - type-syntax SyntaxId

. source = program.modules[owner].tree
do match? source.nodes[type-syntax]
    | .node-type-identifier
        . named = types.evaluate-type(owner, source, type-syntax, types.env-frame())
        = named != invalid-type && is-numeric(types, named)
= false

────────────────────
_ do guards-read Bool
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` Whether reading a global can fail where the read stands. One that `do with` binds is unbound
` outside every binding of it. One each task or each thread holds its own of has its value as
` the task or the thread starts. A lazy one is evaluated by the first read, which fails when
` its value is being evaluated already. Any other that is not a constant is checked for its
` value wherever it is read outside its own module's statements. The value of a class's
` property, which a constructor runs, and of a lazy global, which its first read runs, are
` outside them: either may run before the module's globals have their values, as may the
` value of a global each task or each thread holds its own of, or that `do with` binds.
if is-stack-local(id)
    for scope in facts.stack-scopes
        if scope.instance == instance && scope.module == owner && scope.decl == decl
            if id >= scope.first && id <= scope.last
                = false
    = true
if is-task-local(owner, decl) || is-thread-local(owner, decl)
    = false
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        if row.owner == 0 && row.is-lazy
            = true
if frame.declaration.is-main && owner == (module) && !is-deferred-value() && !initializes-early()
    = false
if core-literal-type(owner, decl) != no-type
    = false
= !is-constant-global(owner, decl)

────────────────────
_ do is-deferred-value Bool

if !instances.is-initializer(instance)
    = false
do match? program.modules[module].decls[instances.rows[instance].initializer]
    | .decl-property(row)
        = row.owner != 0 || row.is-lazy
= false

────────────────────
_ do note-guarded
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` Plans a read of a global as a checked one: the reader may panic there.
instances.mark-may-panic(instance)
facts.set-plan(instance, id, .plan-guarded-read)
facts.global-uses.append(GlobalUse(instance, id, owner, decl))

────────────────────
_ do is-method Bool
    - owner ModuleId
    - decl DeclId

` Whether a function is a method of a type, which the value of a stored property cannot call:
` the object the method would run on is not yet made.
do match? program.modules[owner].decls[decl]
    | .decl-function(fn)
        if fn.owner == 0 || fn.is-static
            = false
        do match? program.modules[owner].decls[fn.owner]
            | .decl-class
                = true
= false

────────────────────
_ eager-call-message String
    - name Atom
    - owner ModuleId
    - decl DeclId

|? eager-value()
    "A property's value is computed before the object exists, so it $called; declare the property without a value and assign it in a constructor's body"
??
    "A \"..\" initializer runs before the object exists, so it $called; compute the value from the constructor's parameters, or assign it in the constructor's body"

.. called = "cannot call \"${name.text}\", a method of ${method-owner(owner, decl)}"

────────────────────
_ eager-value Bool

|? reading.eager
    instances.is-initializer(instance)
??
    outer != null && outer.eager-value()

────────────────────
_ do method-owner String
    - owner ModuleId
    - decl DeclId

. decls = program.modules[owner].decls
do match? decls[decl]
    | .decl-function(fn)
        do match? decls[fn.owner]
            | .decl-class(class)
                = class.name.text
= ""

────────────────────
_ do lacks-self Bool

` Whether the function being checked runs without a value of the type it belongs to: a static
` method, or the constructor of an interface, which has no value to construct.
if outer
    = outer.lacks-self()
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.is-static
            = true
        . self = frame.self-type
        if is-constructor-kind(fn.kind) && self != no-type && self != invalid-type
            = types.intrinsic-of(self) == .interface
= false

────────────────────
_ do lacks-base Bool

if outer
    = outer.lacks-base()
. self = frame.self-type
if self == no-type || self == invalid-type
    = false
types.complete(self)
= types.base-of(self) == null

────────────────────
_ do read-received Found
    - id SyntaxId
    - name Atom
    - want Want

` A name read by its name alone in the body of a markup element that is a member of the
` element, or of an element it is in, the innermost first, as the binder found it: the
` reference reads the property of that element's object (`received-parent`), or names its
` event. A member that is neither a stored property nor an event, one read where no element is
` being built, or an event read in a function written in the element's body, has no shape here,
` but such an event used as a value is reported as `refuse-event-value` says, and one stored in
` a property or given to a call is kept until the property or the parameter is known
` (`store-event`, `settle-kept-arguments`).
. parent = received-parent(id, name)
if parent == no-type
    decline(id)
    = Found(invalid-type)
. place = types.property-named(parent, name)
if !place && bindings.resolution-of(frame.binding, id).slot != no-slot
    . found = event-of(parent, name)
    if !found
        decline(id)
        = Found(invalid-type)
    . endpoint = endpoint-of(found)
    if misused-event(id, endpoint, want)
        refuse-event-value(id, found.owner, name)
        = Found(invalid-type)
    if endpoint != invalid-type && want.asks(.want-store)
        = Found(endpoint, no-type, found-event(found), true)
    if endpoint != invalid-type && argument-typing.unknown-callee
        = Found(endpoint)
    . addressed = found.key == no-type || found.address != 0
    if endpoint != invalid-type && want.asks(.want-argument) && argument-typing.keeps && addressed
        endpoint-arguments += id
        endpoint-events += found
        kept-arguments += id
        = Found(endpoint)
    decline(id)
    = Found(invalid-type)
if !place
    = read-event(id, parent, name, want)
if types.properties[place].storage-kind == .storage-getter
    decline(id)
    = Found(invalid-type)
= read-property(id, id, parent, name, want)

────────────────────
_ do misused-event Bool
    - id SyntaxId
    - endpoint TypeId
    - want Want

` Whether a node that names an event is used where a value is, as the reference finds none of
` an event: the value of a declaration that states no type, or one the event's `Broadcastable`
` is not (`takes-endpoint`), the value assigned to a local or cast to a type it is not, the
` value of an assigning operator, an item of a list or a tuple, what a line prints, an operand
` of an arithmetic, comparing or joining operator, or the object a member is read from or
` called on.
. holder = tree.holder-of(id)
. escaping = want.asks(.want-escape)
do match? tree.nodes[holder]
    | .node-declare
        = !escaping || want.type == no-type || !takes-endpoint(endpoint, want.type)
    | .node-assign(row)
        if row.rhs != id
            = false
        = row.op != .eq-op || (escaping && (typeless || !takes-endpoint(endpoint, want.type)))
            .. typeless = want.type == no-type
    | .node-cast-expression(row)
        = cast-escapes && want.type != no-type && !takes-endpoint(endpoint, want.type)
            .. cast-escapes = row.lhs == id && escaping
    | .node-list-syntax
        = true
    | .node-tuple-syntax
        = true
    | .node-print
        = true
    | .node-binary-expression(row)
        = computes || row.op == .concat-op || row.op == .concat-string-op
            .. computes = is-arithmetic(row.op) || is-comparison(row.op)
    | .node-get-expression(row)
        = row.object == id
= false

────────────────────
_ takes-endpoint Bool
    - endpoint TypeId
    - wanted TypeId

` Whether an event's `Broadcastable` becomes a type without a converter, as the reference casts
` an event's endpoint only to an interface it has.
|? endpoint == invalid-type || wanted == invalid-type
    true
??
    legal-plain && not-common && kind != .relation-string-cast && kind != .relation-fromverter

.. kind = conversions.compare-held(endpoint, wanted).kind
.. legal-plain = kind != .relation-illegal && kind != .relation-converter
.. not-common = kind != .relation-common-converter

────────────────────
_ do endpoint-of TypeId
    - event NamedEvent

` The `Broadcastable` an event's endpoint is.
= types.well-known-type-of("core/stream", "Broadcastable", event.payload)

────────────────────
_ do refuse-event-value
    - id SyntaxId
    - owner TypeId
    - name Atom

` Reports a node that names an event used as a value, where it hides a local as `hidden-member`
` says, and else as an event, which is no value.
if hidden-member(id, owner, name, "an event")
    =
. message = "\"${name.text}\" is an event of ${owner-name}; it cannot be used as a value"
    .. owner-name = type-short-name(types, owner)
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do reads-once Bool
    - id SyntaxId

` Whether a node is the operand of a `<-` written before it, which reads one item.
do match? tree.nodes[tree.holder-of(id)]
    | .node-unary-expression(row)
        = row.op == .read-op && row.operand == id
= false

────────────────────
_ do refuse-event-read
    - id SyntaxId
    - owner TypeId
    - name Atom

` Reports an event read with `<-`, as a channel is: an event gives each value to the
` subscribers it has as it is published, and keeps none to be read.
. written = name.text
do match? tree.nodes[id]
    | .node-get-expression(row)
        do match? tree.nodes[row.object]
            | .node-identifier(object)
                written = "${object.name.text}.${name.text}"
. owner-name = type-short-name(types, owner)
. message = "\"${name.text}\" is an event of $owner-name, which gives each value to its subscribers and keeps none to read with \"<-\"; hear the next one with \"for value on $written\", and end the loop with \"break\""
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do settle-kept-arguments
    - mark Size
    - result TypeId

` Declines each event read in a function written in a markup element's body that a call since
` `mark` was given and no converter refused (`misused-endpoint`), which has no shape here.
while kept-arguments.length > mark
    . kept = kept-arguments.pop()
    if kept != 0 && result != invalid-type
        decline(kept)

────────────────────
_ do store-event Bool
    - rhs SyntaxId
    - event NamedEvent
    - kept Bool
    - target TypeId

` An event stored in a property, once the property is known: one whose `Broadcastable` the
` property is not is reported as `refuse-event-value` says, one stored in a property of that
` very `Broadcastable` is made that endpoint, as `escape-event` says, and any other, or one
` read in a function written in a markup element's body, has no shape here. Says whether the
` store goes on.
. endpoint = endpoint-of(event)
if !takes-endpoint(endpoint, target)
    refuse-event-value(rhs, event.owner, event.name)
    = false
if kept || target != endpoint
    decline(rhs)
    = false
escape-event(rhs, event, endpoint, rhs)
= true

────────────────────
_ do hidden-member Bool
    - id SyntaxId
    - owner TypeId
    - name Atom
    - member String

` Whether a name read by its name alone in the body of a markup element, where a read of the
` element's member fails, hides a local of the name declared outside the element, as the binder
` found: reported at the name, which the author may have meant for the local.
if (bindings.resolution-of(frame.binding, id).flags /and/ ResolutionFlag.resolution-hides) == 0
    = false
. shown = type-short-name(types, owner)
. message = "\"${name.text}\" names $member of $shown here, not the local \"${name.text}\"; rename one of them"
frame.diagnose(id, .stated, program.store-atom(message))
= true

────────────────────
_ do hidden-property Bool
    - id SyntaxId
    - object-syntax SyntaxId

` Whether the object of a property read that finds nothing is a property of a markup element
` read by its name alone that hides a local, which is reported as `hidden-member` says.
if object-syntax == 0 || object-syntax == id
    = false
do match? tree.nodes[object-syntax]
    | .node-identifier(row)
        if (object-flags /and/ ResolutionFlag.resolution-received) == 0
            = false
        .. object-flags = bindings.resolution-of(frame.binding, object-syntax).flags
        . owner = received-parent(object-syntax, row.name)
        if owner != no-type && types.property-named(owner, row.name)
            = hidden-member(object-syntax, owner, row.name, "a property")
= false

────────────────────
_ do read-unmade TypeId
    - id SyntaxId
    - name Atom
    - slot SlotId

` The name of a markup element of a class's markup read in a closure the markup makes before
` the element is made: the reference reads the receiver's property of the name when the
` closure runs (`plan-element-property`). Where the class declares no such property, or the
` closure has no receiver, it has no shape here, except that a closure the element's own markup
` makes is the reference's error.
. self = frame.self-type
if self != no-type && self != invalid-type && !lacks-self() && types.intrinsic-of(self) == .class
    . place = types.property-named(self, name)
    if place && names-element(types, types.properties[place])
        facts.set-plan(instance, id, .plan-element-property)
        = read-property(id, id, self, name).type
if constructs-element(slot) && !is-placed(slot)
    . message = "Named markup element \"${name.text}\" can only be read from within its own markup in class content"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
decline(id)
= invalid-type

────────────────────
_ received-parent TypeId
    - id SyntaxId
    - name Atom

` The object a member read by its name alone in the body of a markup element is read from: in a
` function written in the body, that of the element the binder found, kept where it was made,
` and else the innermost element being built that has the member (`received-owner`).
|? kept == no-slot
    received-owner(name)
|? parent == no-type || parent == invalid-type || types.intrinsic-of(parent) != .class
    no-type
|? place && names-element(types, types.properties[place])
    no-type
??
    parent

.. kept = bindings.resolution-of(frame.binding, id).slot
.. parent = frame.slot-type(kept)
.. place = types.property-named(parent, name)

────────────────────
_ do keep-element Bool
    - element SyntaxId
    - made TypeId

` The local no name reaches that keeps the object of a markup element, where a function written
` in its body reads its members by name alone or one gives its arguments again, holds one of the
` element's class: the class written, as the functions that build regions of its body are typed
` with the body, and then that of the object made, which must be the same. False where it is not.
. resolution = bindings.resolution-of(frame.binding, element)
if resolution.kind != .resolve-slot
    = true
. held = frame.slot-type(resolution.slot)
if held != no-type && held != made
    = false
frame.assign(resolution.slot, made)
= true

────────────────────
_ do received-owner TypeId
    - name Atom

` The innermost markup element being built whose class has a property or an event of a name,
` or no type: a property the markup of the element's class declares for an element is hidden
` there.
. position = content-parents.length
while position != 0
    position -= 1
    . parent = content-parents[position]
    if types.intrinsic-of(parent) != .class
        continue
    . place = types.property-named(parent, name)
    if place && !names-element(types, types.properties[place])
        = parent
    if !place && declares-event(parent, name)
        = parent
= no-type

────────────────────
_ do infer-identifier Found
    - id SyntaxId
    - name Atom
    - want Want = Want()

` The type of a name alone, as what the binder resolved it to gives it: a local, a global, a
` member, a function or a type. A name the binder left for a style to resolve, which no style
` sheet's slot nor `inherit` is, is not found, as the reference reports it where no case of the
` property's union took it (`style-value`). The name of a slot outlet that is a markup branch
` region, which the reference builds a node of its own for where it is read, is declined.
. resolution = bindings.resolution-of(frame.binding, id)
if (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
    = read-received(id, name, want)
do match resolution.kind
    |= .resolve-slot
        if finally.limit != 0 && bindings.slots[resolution.slot].syntax > finally.limit
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].getter != 0
            = Found(read-getter(id, resolution.slot))
        if unbuilt.length != 0 && unbuilt.find(resolution.slot) != null
            if resolution.slot == building || held.find(resolution.slot) != null
                . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
                frame.diagnose(id, .stated, program.store-atom(message))
                = Found(invalid-type)
            if !raise-early(id, resolution.slot)
                decline(id)
                = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-this && in-eager()
            . message = "Illegal to reference 'this' in eager properties or properties "
            frame.diagnose(id, .stated, program.store-atom(message ++ "referenced by them"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-this && lacks-self()
            frame.diagnose(id, .stated, program.store-atom("Required self not defined"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-super && lacks-base()
            frame.diagnose(id, .stated, program.store-atom("super requires a base type"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-super && !want.asks(.want-receiver)
            frame.diagnose(id, .stated, program.store-atom("Bare super is not a value"))
            = Found(invalid-type)
        if is-placed(resolution.slot) && reads-before-placing(id, resolution.slot)
            . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if precedes-declaration(resolution.slot)
            if is-placed(resolution.slot) || awaits-element(resolution.slot)
                = Found(read-unmade(id, name, resolution.slot))
            if names-machine(resolution.slot)
                decline(id)
                = Found(invalid-type)
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        if is-placed(resolution.slot) && outlet-region(bindings.slots[resolution.slot].group) != 0
            decline(id)
            = Found(invalid-type)
        note-carried(id, resolution.slot)
        if wavers(resolution.slot)
            decline(id)
            = Found(invalid-type)
        . read = read-slot(resolution.slot, id)
        if in-lazy && scratch.narrowed-since(last-mark, slot-key(resolution.slot)) != no-type
            facts.note-inside-read(instance, id)
        .. in-lazy = lazy-marks.length != 0 && !frame.is-captured(resolution.slot)
        .. last-mark = lazy-marks[lazy-marks.length - 1]
        if is-row-item(resolution.slot, read)
            = Found(read-row-item(id, read))
        if !want.asks(.want-pattern) && is-pattern-func(read)
            if names-given-pattern(resolution.slot)
                if valuing.action-arm != 0
                    frame.diagnose
                        - valuing.action-arm
                        - .stated
                        - program.store-atom("Unable to compile pattern action: Name not found")
                else
                    frame.diagnose(id, .stated, program.store-atom("Name not found"))
                = Found(invalid-type)
            if instances.rows[instance].helper != no-type
                decline(id)
                = Found(invalid-type)
        note-case-read(id, resolution.slot, read)
        = Found(read)
    |= .resolve-global
        if reads-uninitialized(resolution.module, resolution.decl)
            . message = "Global '${name.text}' is read before it is initialized"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if is-stack-local(id)
            facts.stack-reads.append(StackRead(instance, id, resolution.module, resolution.decl))
        if guards-read(id, resolution.module, resolution.decl)
            note-guarded(id, resolution.module, resolution.decl)
        = Found(demand-global(id, resolution.module, resolution.decl))
    |= .resolve-member
        if theme-sheet != no-type && sheet-has-slot(family-root(theme-sheet), name)
            = Found(read-theme(id, name))
        if in-eager() && is-accessor(frame.self-type, name)
            . message = "Illegal to reference getters in eager properties"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if lacks-self()
            frame.diagnose(id, .stated, program.store-atom("Required self not defined"))
            = Found(invalid-type)
        if !outer && reads-unmade(name) && !instances.is-initializer(instance)
            . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if !outer && reads-unmade(name) && !is-eager-value() && !waits-in-rule() && unkept
            decline(id)
            = Found(invalid-type)
        .. unkept = !keeps-whole(name) && !runs-later(id)
        = read-member(id, name, want)
    |= .resolve-function
        if names-module-accessor(resolution.module, resolution.decl)
            = Found(calls.module-getter-call(id, name))
        if names-method(resolution.module, resolution.decl) && !lacks-self()
            = Found(calls.method-binding(frame.self-type, name, id))
        = Found(types.intern-binding(.bound-function, frame.module, resolution.module, resolution.decl))
    |= .resolve-type
        = Found(type-info-of(id, types.type-named(module, name, frame.env)))
    ??
        . bound = types.env-lookup(frame.env, name)
        if bound
            = Found(type-info-of(id, bound))
        . styled = (resolution.flags /and/ ResolutionFlag.resolution-styled) != 0
        if styled && themed && !is-inherit(id) && names-sheet-slot(name)
            = Found(read-theme(id, name))
        .. themed = theme-made != no-type || theme-sheet != no-type
        if styled && unquiet && !is-inherit(id) && !names-sheet-slot(name)
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        .. unquiet = (resolution.flags /and/ ResolutionFlag.resolution-quiet) == 0
        if (resolution.flags /and/ lenient-flags) != 0
            decline(id)
        .. lenient-flags = ResolutionFlag.resolution-styled /or/ ResolutionFlag.resolution-quiet
        = Found(invalid-type)

────────────────────
_ do note-collection-read TypeId
    - id SyntaxId
    - read TypeId
    - want Want

` A tracked read whose value is a collection, which the reference tracks the changes of too,
` where the read is tracked (`trackCollectionRead`): the read is noted, and the runtime's
` `track-collection-dependency` typed. One of an optional collection is tracked where it holds
` one. The container of a markup loop region (`want-observed`) is no such read: the region
` observes it itself. Answers the read.
if read == invalid-type || read == no-type || types.collection-decl.module == 0 || want.asks(.want-observed)
    = read
. held = if types.is-optional(read) then types.optional-inner(read) else read
if types.intrinsic-of(held) != .class || derived-interface(held, types.collection-decl) == no-type
    = read
if !demand-track-collection()
    decline(id)
    = invalid-type
facts.collection-reads += CollectionRead(instance, id)
= read

────────────────────
_ do demand-track-collection Bool

demand-live-runtime()
. live = instances.live
if live.track-collection == no-instance && live.trackers != no-instance
    . module = class-ref(types, types.live-action-type).module
    . trackers = types.properties[types.property-named(types.live-action-type, program.store-atom("trackers"))!].type
    . mark = scratch.types.mark
    scratch.types.push(trackers)
    scratch.types.push(trackers)
    scratch.types.push(types.well-known-type("core", "Pointer"))
    live.track-collection = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("track-collection-dependency")
        - mark
    scratch.types.rewind(mark)
    instances.live = live
= live.track-collection != no-instance

────────────────────
_ do raise-early Bool
    - read SyntaxId
    - slot SlotId

` Makes the object of a named markup element a block has not made yet where what makes an
` earlier one, or a statement of the block above it, reads its name, as the reference evaluates
` the name's local where it is first read, under the styles in force there. The element is not
` made again where it is written. Only a read made each time the element being made, or the
` statement, is reaches it: one a branch or a call may skip would leave the object unmade on
` some runs, and is declined.
. waited = unbuilt.find(slot)
if waited == null || awaited[waited] == 0
    = false
. element = awaited[waited]
if !reached-always(read, tree.holder-of(element))
    = false
do match? tree.nodes[element]
    | .node-markup(row)
        held += building
        . around = building
        building = slot
        . made = make-element(element, row)
        building = around
        held.pop()
        frame.assign(slot, made)
        unbuilt[waited] = no-slot
        awaited[waited] = 0
        facts.note-raised(instance, 0, element, read)
        = true
= false

────────────────────
_ do reached-always Bool
    - read SyntaxId
    - home SyntaxId

` Whether making the markup element being made, or else running a statement of the block `home`,
` always evaluates a node: each node between them evaluates the one below it whenever it is
` evaluated, up to an argument of the element, the value of an attribute it is given, or the
` statement.
. child = read
. node = tree.holder-of(read)
while node != 0
    if building == no-slot && node == home
        = true
    do match tree.nodes[node]
        | .node-markup(row)
            = (element-slot(node, row.id) ?? no-slot) == building
        | .node-assign(row)
            if row.rhs != child
                = false
            if building != no-slot
                . owner = tree.body-element(tree.holder-of(node))
                do match? tree.nodes[owner]
                    | .node-markup(made)
                        = (element-slot(owner, made.id) ?? no-slot) == building
                = false
        | .node-declare(row)
            if building != no-slot || row.right != child || row.is-lazy
                = false
        | .node-print(row)
            if building != no-slot || row.body != child
                = false
        | .node-get-expression(row)
            if row.object != child || row.is-optional
                = false
        | .node-binary-expression(row)
            . skips = chooses || row.op == .and-op || row.op == .or-op
                .. chooses = row.op == .coalesce-op || row.op == .else-op
            if skips && row.lhs != child
                = false
            if row.op == .if-op && row.rhs != child
                = false
            if !skips && row.op != .if-op && row.op != .concat-op && other-op
                = false
            .. other-op = !is-arithmetic(row.op) && !is-comparison(row.op)
        | .node-call-expression
        | .node-argument
        | .node-index-expression
        | .node-unary-expression
        | .node-cast-expression
        ??
            = false
    child = node
    node = tree.holder-of(node)
= false

────────────────────
_ do infer-tracked-name Found
    - id SyntaxId
    - name Atom
    - want Want

` A name alone read as tracked: a member of the receiver, read as any member is and tracked
` as `track-read` says, a member of a markup element being built, read as `read-received`
` says and tracked so too, or a local, tracked as `track-local` says. A global can not be
` tracked, as the reference reports, nor can `this`, which is no property. Any other name has no
` shape here yet.
. resolution = bindings.resolution-of(frame.binding, id)
. kind = resolution.kind
if kind == .resolve-global
    frame.diagnose(id, .stated, program.store-atom("Untrackable name"))
    = Found(invalid-type)
if name.text == "this"
    . message = "\"#this\" tracks nothing, as only a property is tracked; track the properties the value reads, as in \"#count\""
    frame.diagnose(id, .stated, program.store-atom(message))
    = Found(invalid-type)
if (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
    . received = read-received(id, name, want)
    . owner = received-parent(id, name)
    if received.type != invalid-type && owner != no-type
        track-read(id, owner, name)
    = received
if kind == .resolve-slot && is-trackable(resolution.slot)
    . held = infer-identifier(id, name, want)
    if held.type != invalid-type
        track-local(id, resolution.slot)
    = held
if kind != .resolve-member
    decline(id)
    = Found(invalid-type)
. read = infer-identifier(id, name, want)
if read.type != invalid-type
    track-read(id, frame.self-type, name)
= read

────────────────────
_ do track-root
    - object SyntaxId

` The object a tracked read reads from, where it is a name alone, as the reference reads it:
` tracked too. A member of the receiver is tracked as `track-read` says, a local as
` `track-local` says, the receiver itself is not, and a global can not be, as the reference
` reports. A name a pattern binds is tracked by the reference through its function's list,
` which nothing stores to by that name unless another local of the function shares it: it is
` read plainly then. Any other name is read plainly where no live action is open, and has no
` shape here yet where one is.
do match? tree.nodes[object]
    | .node-identifier(row)
        if row.is-tracked
            =
        . resolution = bindings.resolution-of(frame.binding, object)
        . bound = resolution.kind == .resolve-slot && pattern-slot
            .. pattern-slot = bindings.slots[resolution.slot].kind == .slot-pattern
        if resolution.kind == .resolve-member
            track-read(object, frame.self-type, row.name)
        else if resolution.kind == .resolve-global
            frame.diagnose(object, .stated, program.store-atom("Untrackable name"))
        else if resolution.kind == .resolve-slot && is-trackable(resolution.slot)
            track-local(object, resolution.slot)
        else if bound && !namesake(resolution.slot, false)
            =
        else if resolution.kind != .resolve-slot || not-this
            if live-context(read-site(object)) != .live-none
                decline(object)
        .. not-this = bindings.slots[resolution.slot].kind != .slot-this

────────────────────
_ is-trackable Bool
    - slot SlotId

` Whether a local is one a tracked read tracks: a lazy local, one a declaration names, or an
` argument.
kind == .slot-local || kind == .slot-lazy || kind == .slot-argument

.. kind = bindings.slots[slot].kind

────────────────────
_ do track-local
    - id SyntaxId
    - slot SlotId

` A read of a local that tracks it, as the reference's function scope does: through the list
` of subscribers the function that declares the local makes where it starts, which may panic.
` Where no live action of the reference is open the read is a plain one, though the function
` keeps the list, and a statement a function of its own runs again notes the read; the
` function that runs it again, and one that builds an arm or a row of a markup region or what
` an element gives a slot, read the local and the list where the function that declares them
` keeps them. A read in a `whenever` clause notes nothing: the clause is tested in a live
` action as it is subscribed. The reference keeps one list for every local of a function by
` name, so a local that shares its name with another of its function, one of an enclosing
` function anywhere else, one of the value of a property or a rule, and one a live action of
` any other kind reads have no shape here yet. A local nothing stores to after it is declared,
` nor to any other local of its function of its name, is read plainly where no statement runs
` again, though the function keeps its list where it can: no store runs what reads it.
. plain = !restored(slot) && !restored-namesake(slot)
. subscribers = subscribers-slot(slot)
. kind = frame.declaration.kind
. reaches = kind == .live-decl || kind == .whenever-decl || kind == .gate-decl || kind == .branch-decl || kind == .branch-arm-decl || kind == .source-decl || kind == .row-decl || kind == .slot-decl
if subscribers == no-slot || (frame.is-captured(slot) && !reaches) || in-initializer
    if !plain
        decline(id)
    else if subscribers != no-slot
        do hold-subscribers(id, subscribers)
    =
.. in-initializer = instances.rows[instance].initializer != 0
if namesake(slot, false) && !plain
    decline(id)
    =
if !hold-subscribers(id, subscribers)
    decline(id)
    =
. context = live-context(read-site(id))
if context == .live-none || context == .live-whenever || regional
    =
.. regional = context == .live-region || context == .live-gate
if context == .live-statement
    note-live-statement(read-site(id))
    =
if !plain
    decline(id)

────────────────────
_ do hold-subscribers Bool
    - id SyntaxId
    - subscribers SlotId

` Makes the list of subscribers a tracked read of a local reads, which may panic: typed here,
` with the read noted as its first, or where the function that declares the local is another,
` there, as `keep-subscribers` says. False where the runtime of live actions is not found.
demand-live-runtime()
. live = instances.live
if live.subscribers == no-instance || live.track == no-instance || live.dispatch == no-instance
    = false
. list = instances.signatures[live.subscribers].returns
if !frame.is-captured(subscribers)
    frame.assign(subscribers, list)
    facts.note-tracked-local(instance, if reading.lazy != 0 then reading.lazy else id)
else
    keep-subscribers(subscribers, list, id)
instances.mark-may-panic(instance)
= true

────────────────────
_ do restored Bool
    - slot SlotId

` Whether something stores to a local after it is declared: an assignment, or its declaration
` run again, as one whose value reads something tracked is.
if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0
    = true
. syntax = bindings.slots[slot].syntax
for node in syntax + 1 .. < (tree.nodes.length as SyntaxId)
    if tree.subtree-start(node) <= syntax && tree.nodes[node] is .node-declare
        = is-live-statement(node)
= false

────────────────────
_ do restored-namesake Bool
    - slot SlotId

` Whether another local of the function that declares a local has its name and is stored to
` after it is declared, as `restored` says.
. other = bindings.slots[slot].namesake
while other != no-slot && other != slot
    if is-trackable(other) && restored(other)
        = true
    other = bindings.slots[other].namesake
= false

────────────────────
_ do namesake Bool
    - slot SlotId
    - tracked Bool

` Whether another local of the function that declares a local has its name, one some read
` tracks where `tracked` says.
. other = bindings.slots[slot].namesake
while other != no-slot && other != slot
    if is-trackable(other) && (!tracked || tracked-other)
        = true
    .. tracked-other = (bindings.slots[other].flags /and/ SlotFlag.slot-tracked) != 0
    other = bindings.slots[other].namesake
= false

────────────────────
_ do function-scope ScopeId
    - scope ScopeId

` The scope of the function or the nested function a scope lies in.
. found = scope
while bindings.scopes[found].kind != .scope-function && bindings.scopes[found].kind != .scope-nested
    found = bindings.scopes[found].parent
= found

────────────────────
_ do keep-subscribers
    - subscribers SlotId
    - list TypeId
    - site SyntaxId

` The list of subscribers of a local that a function written in the one that declares the
` local reads it through is made by that one, as the reference makes it there once it compiles
` the read: typed for it there where nothing typed it yet, with the read noted as its first
` where it is one. What typing the other holds then is typed only with this one in it
` (`Instance.with-enclosing`), and so for each function out to that one.
if !outer
    =
instances.rows[instance].with-enclosing = true
if outer!.frame.is-captured(subscribers)
    outer!.keep-subscribers(subscribers, list, site)
    =
if outer!.frame.known(subscribers) == no-type
    outer!.frame.assign(subscribers, list)
facts.note-tracked-local(outer!.instance, site)

────────────────────
_ do subscribers-slot SlotId
    - slot SlotId

` The hidden local that holds the list of subscribers of the function that declares a local,
` which the binder declares in that function's own scope where one of its locals is read
` tracked.
. home = function-scope(bindings.slots[slot].scope)
. range = bindings.bindings[frame.binding].slots
for offset in 0 .. < range.count
    . row = bindings.slots[range.start + offset]
    if row.kind == .slot-subscribers && row.scope == home
        = range.start + offset
= no-slot

────────────────────
_ do track-read
    - id SyntaxId
    - receiver TypeId
    - name Atom

` A read of a property that tracks it, which may panic. The property is tracked wherever it
` is stored, which runs what the runtime keeps of the actions that read it. A getter can not
` be tracked, as the reference reports. Where no live action of the
` reference is open the read is a plain one. In the value of a stored property of a class,
` outside the functions written in it, the value runs in a live action of its own that notes
` the read, and so does a rule of a class, and so does the `whenever` clause of a loop on a
` stream. So does the value of a declaration of a style rule (`unit-styling.styling`). Any
` other read a live action sees has no shape here yet. A field of a struct or a tuple is reported,
` as their values are copied and no object notes what reads them, and so is a read in the value
` of a lazy property, which is worked out once.
` A read through an optional chain reads the object the optional holds.
if receiver == no-type || receiver == invalid-type
    =
. place = types.property-named(receiver, name)
if place && types.properties[place].storage-kind == .storage-getter
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Tracked getters are not supported; track concrete state instead")
    =
instances.mark-may-panic(instance)
. key = panics.property-of(receiver, name)
if key
    panics.track(key)
if place
    . ref = class-ref(types, types.tracked-root(types.properties[place].owner, name))
    facts.note-tracked(ref.module, ref.decl, name)
if valued
    . shown = type-short-name(types, receiver)
    . message = "\"#${name.text}\" reads a field of $shown, whose values are copied, so it cannot be tracked; track a property of a class"
    frame.diagnose(id, .stated, program.store-atom(message))
    =
.. valued = types.intrinsic-of(receiver) == .struct || types.intrinsic-of(receiver) == .tuple
if types.intrinsic-of(receiver) != .class
    decline(id)
    =
demand-live-runtime()
if unit-styling.styling != 0 && tree.subtree-start(unit-styling.styling) <= id && id <= unit-styling.styling
    =
. context = live-context(read-site(id))
if context == .live-none
    =
if context == .live-value && is-eager-value()
    instances.mark-live(instance)
    =
if context == .live-value && is-lazy-value()
    . message = "A lazy property is worked out once, when it is first read, so it cannot follow \"#${name.text}\"; write \"=\" in place of \":=\" to keep it live, or read \"${name.text}\" without \"#\""
    frame.diagnose(id, .stated, program.store-atom(message))
    =
if context == .live-rule && is-rule-unit()
    instances.mark-live(instance)
    =
if context == .live-statement
    note-live-statement(read-site(id))
    =
if context == .live-whenever
    =
if context == .live-region || context == .live-gate
    =
decline(id)

────────────────────
_ read-site SyntaxId
    - id SyntaxId

` Where a node is read: a node of the value of a row local read as a getter is read where the
` outermost such read is.
if reading.getter != 0 then reading.getter else id

────────────────────
_ is-rule-unit Bool

` Whether the instance types a rule of a class.
|? unit.initializer == 0 || frame.self-type == no-type
    false
??
    program.modules[unit.module].decls[unit.initializer] is .decl-rule

.. unit = instances.rows[instance]

────────────────────
_ do owns-plain-actions Bool
    - type TypeId

` Whether the live actions an object owns are plain ones: it is an object of a class that is
` neither a markup host nor a markup batch, whose actions the reference makes through markup.
if types.intrinsic-of(type) != .class
    = false
for decl in [types.markup-host-decl, types.markup-batch-decl]
    if (decl.module != 0 || decl.decl != 0) && derived-interface(type, decl) != no-type
        = false
= true

────────────────────
_ do live-context LiveContext
    - id SyntaxId

` Whether a live action of the reference is open where a node is compiled: none, the one the
` value of a property runs in, the one a rule of a class runs in, the one the value of a live
` statement runs in, the one a `whenever` clause of a loop on a stream is tested in, or
` another, which assignments, lazy declarations, markup, streams and subscriptions open, as
` does a function written in a value or a rule. An argument of a markup element run again is a
` live statement, as is a line of its body that gives content. The `keyed by` clause of a markup
` loop region is typed in a function of its own, which the reference compiles where no live
` action is open, and so are the values given rules an element applies, where the element is
` written in lines of markup alone out to a class's markup (`applies-plainly`) or is the root
` `<This`, whose values an instance of their own types, but their conditions, each tested in a
` gate's (`in-condition`). Where those values read something tracked, the rules' declarations
` that read them are declared again as it changes (`values-live`). A closure that is
` the whole value of an attribute runs only once the attribute is given, outside the attribute's
` action, so what it reads where it opens none of its own is read plainly when it runs
` (`gives-closure`). The value a root `<This` gives a property is one of a property. The
` reference opens none for a declaration that is not lazy, which is read as the one open around
` it where that is none or a rule's, and a lazy one in the value of a property runs again with
` the value, whose action it reads in; a function written in its value sees none where none is
` open around it, as the reference looks out through the functions around it for one. A line of
` an arm's body that gives content is a live statement, as one of an element's body is. An
` element that gives a slot content is built by a function of its own, which the reference
` compiles where no live action is open (`builds-slot`). The name the parameter of a slot outlet
` that is a region gives is read in the region's action, and plainly by the outlet's function.
` The body of a loop on a stream written among an element's lines runs where none is open, as
` the reference compiles it as a function of its own there (`handler`). So do the lines of an
` element in the row of a keyed markup loop region that are no live statement: the function that
` builds the row opens none.
. value = false
. nested = false
. handler = false
for node in id + 1 .. < (tree.nodes.length as SyntaxId)
    if tree.subtree-start(node) > id
        continue
    do match? tree.nodes[node]
        | .node-assign(row)
            if node == root-value()
                = if nested then .live-other else LiveContext.live-value
            if !nested && is-live-statement(node) && in-rhs
                = .live-statement
            .. in-rhs = tree.subtree-start(row.rhs) <= id && id <= row.rhs
            = .live-other
        | .node-declare(row)
            if !nested && is-live-statement(node) && in-right
                = .live-statement
            .. in-right = tree.subtree-start(row.right) <= id && id <= row.right
            . outer = if !row.is-lazy || !nested then live-context(node) else LiveContext.live-other
            if !row.is-lazy
                . plain = outer == .live-none || (!nested && outer == .live-rule)
                = if plain then outer else LiveContext.live-other
            = if outer == .live-value then .live-value else LiveContext.live-other
        | .node-markup
            if !nested && (live-argument(node, id) != 0 || live-line(node, id) != 0)
                = .live-statement
            if !nested && handler
                = .live-none
            if !nested && in-condition(node, id)
                = .live-gate
            if !nested && in-application(node, id) && (applies-plainly(node) || root-valued)
                = .live-none
            .. root-valued = instances.rows[instance].root-values != 0
            if !nested && builds-slot(node)
                = .live-none
            if !nested && frame.declaration.kind == .row-decl
                = .live-none
            = .live-other
        | .node-markup-slot-forward
            = .live-other
        | .node-markup-slot-parameter
            if is-region(node)
                if nested
                    = .live-other
                = if branch-arm then .live-none else LiveContext.live-region
                    .. branch-arm = frame.declaration.kind == .branch-arm-decl
        | .node-slot-outlet
            = .live-other
        | .node-iterable-expression(row)
            if !nested && is-live-statement(node) && in-expr
                = .live-statement
            .. in-expr = tree.subtree-start(row.expr) <= id && id <= row.expr
            = .live-other
        | .node-when-rule-syntax
            = if nested then .live-other else LiveContext.live-rule
        | .node-whenever-rule-syntax
            = if nested then .live-other else LiveContext.live-rule
        | .node-content-block
            = .live-other
        | .node-state-machine
            = .live-other
        | .node-clause(row)
            if row.op == .whenever-clause && !nested && nested-decl-of(node) != 0
                = .live-whenever
        | .node-if-block
            . head = region-head(node)
            if head != 0
                if !nested && arm-line(head, id) != 0
                    = .live-statement
                if nested || in-arm-body(head, id)
                    = .live-other
                = .live-region
        | .node-match-expression
            if is-region(node)
                if !nested && arm-line(node, id) != 0
                    = .live-statement
                if nested || in-arm-body(node, id)
                    = .live-other
                = .live-region
        | .node-type-transform
            if !nested && matched-line(node, id) != 0
                = .live-statement
        | .node-for-block(row)
            . subscribes = is-subscriber-loop(row.loop) && row.body != 0
            if !nested && subscribes && tree.subtree-start(row.body) <= id && id <= row.body
                handler = true
            if is-loop-region(node)
                if !nested && in-key(node, id)
                    = .live-none
                if nested || !in-container(node, id)
                    = .live-other
                = .live-region
        | .node-loop-syntax(row)
            if row.is-subscriber
                = .live-other
        | .node-function-syntax
            if !nested && gives-closure(node)
                = .live-none
            nested = true
        | .node-property-syntax(row)
            if frame.declaration.is-content || frame.declaration.kind == .live-decl
                if tree.content-property(node)
                    if !nested && is-live-statement(node) && in-value
                        = .live-statement
                    .. in-value = tree.subtree-start(row.value) <= id && id <= row.value
                    = .live-other
            value = true
if value && nested
    = .live-other
= if value then .live-value else LiveContext.live-none

────────────────────
_ do gives-closure Bool
    - function SyntaxId

` Whether a function written as a value is the whole value of an attribute of a markup element.
. holder = tree.holder-of(function)
do match? tree.nodes[holder]
    | .node-assign(row)
        = row.rhs == function && tree.attribute-element(holder) != 0
= false

────────────────────
_ do in-condition Bool
    - element SyntaxId
    - id SyntaxId

` Whether a node is written in the condition a rule a markup element applies after `•` is
` applied under, which a function of its own tests again.
do match? tree.nodes[element]
    | .node-markup(row)
        for application in tree.children[row.style-rule-applications]
            do match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    if applied.condition != 0 && after-start && id <= applied.condition
                        = nested-decl-of(applied.condition) != 0
                    .. after-start = tree.subtree-start(applied.condition) <= id
= false

────────────────────
_ do in-application Bool
    - element SyntaxId
    - id SyntaxId

` Whether a node is written in what a rule a markup element applies after `•` is given.
do match? tree.nodes[element]
    | .node-markup(row)
        for application in tree.children[row.style-rule-applications]
            if tree.subtree-start(application) <= id && id <= application
                = true
= false

────────────────────
_ do applies-plainly Bool
    - element SyntaxId

` Whether a markup element other than a root `<This` is written in lines of markup alone, each
` an element of the body of the one around it, out to the markup of a class or to the body of
` the arm of a markup region the instance builds, where the reference opens no live action as it
` makes the element.
do match? tree.nodes[element]
    | .node-markup(row)
        if tree.names-this(row.type-id)
            = false
. arm = if frame.declaration.kind == .branch-arm-decl then frame.declaration.syntax else 0u32
. node = element
while true
    . holder = tree.holder-of(node)
    if holder == 0
        = false
    if holder == arm
        = true
    do match tree.nodes[holder]
        | .node-block
            node = holder
        | .node-markup(row)
            if node != row.body
                = false
            node = holder
        | .node-content-block
            = true
        ??
            = false

────────────────────
_ do root-value SyntaxId

` The line of a root `<This` whose value the instance types, as the value of a property, or
` none.
. unit = instances.rows[instance]
if unit.initializer == 0
    = 0
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        if row.defaults-root
            = row.syntax
= 0

────────────────────
_ do is-live-statement Bool
    - id SyntaxId

` Whether an assignment, a declaration or an argument of a markup element is one a function
` of its own runs again: its value reads something tracked.
. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
_ do note-live-statement
    - id SyntaxId

` A tracked read in the value of a live statement, as the reference reads it: the statement
` runs in a live action the function makes when it runs, and the function the action runs it
` again with types it again where the statement is typed. The function that runs it again
` notes nothing. A statement in the value of a property or a rule, or in a nested function other
` than one that builds an arm of a markup branch region, a row or a slot, or that runs the body
` of a loop on a stream, has no shape here yet, but for a line of a style rule that sets a
` property of the class (`unit-styling.updating`).
if frame.declaration.kind == .live-decl
    =
. site = enclosing-statement(id)
. unit = instances.rows[instance]
. updating = site != 0 && site == unit-styling.updating
if site == 0 || ((unit.initializer != 0 || is-rule-unit()) && !updating)
    decline(id)
    =
. kind = frame.declaration.kind
. built = kind == .branch-arm-decl || kind == .row-decl || kind == .slot-decl
if is-nested-kind(kind) && !built && kind != .subscriber-decl
    decline(id)
    =
if facts.live-statement-of(instance, site)
    =
demand-live-runtime()
. live = instances.live
if live.action == no-instance || live.previous == no-instance || missing-links
    decline(id)
    =
.. missing-links = live.next == no-instance || live.trackers == no-instance
facts.live-statements += LiveStatement(instance, site, no-instance)

────────────────────
_ do enclosing-statement SyntaxId
    - id SyntaxId

` The assignment, the declaration, the line of a class's markup that declares a property, the
` stream of a value as it changes, or the argument or the line of content of a markup element, or
` of an arm of a region, run again a node is written in, or none.
for node in id + 1 .. < (tree.nodes.length as SyntaxId)
    if tree.subtree-start(node) <= id
        do match? tree.nodes[node]
            | .node-assign
                = node
            | .node-declare
                = node
            | .node-iterable-expression
                if is-live-statement(node)
                    = node
            | .node-property-syntax
                if is-live-statement(node)
                    = node
            | .node-markup
                . arg = live-argument(node, id)
                if arg != 0
                    = arg
                . line = live-line(node, id)
                if line != 0
                    = line
            | .node-if-block
                . head = region-head(node)
                . line = if head != 0 then arm-line(head, id) else 0u32
                if line != 0
                    = line
            | .node-match-expression
                . line = if is-region(node) then arm-line(node, id) else 0u32
                if line != 0
                    = line
            | .node-type-transform
                . line = matched-line(node, id)
                if line != 0
                    = line
= 0

────────────────────
_ do live-argument SyntaxId
    - element SyntaxId
    - id SyntaxId

` The argument of a markup element, given by position, that a node is written in, where a
` function of its own gives it again, or none.
do match? tree.nodes[element]
    | .node-markup(row)
        for arg in tree.children[row.args]
            if tree.subtree-start(arg) <= id && id <= arg
                = if is-live-statement(arg) then arg else 0u32
= 0

────────────────────
_ do live-line SyntaxId
    - element SyntaxId
    - id SyntaxId

` The line of a markup element's body that gives content a node is written in, where a function
` of its own gives it again, or none.
do match? tree.nodes[element]
    | .node-markup(row)
        do match? tree.nodes[row.body]
            | .node-block(block)
                for line in tree.children[block.body]
                    if tree.subtree-start(line) <= id && id <= line
                        = if holds-content && is-live-statement(line) then line else 0u32
                            .. holds-content = tree.content-element(line) != 0
= 0

────────────────────
_ do in-loop Bool
    - id SyntaxId

` Whether a node is written in a loop of the function that writes it. The body of a markup loop
` region is the function that builds a row, in no loop.
for node in id + 1 .. < (tree.nodes.length as SyntaxId)
    if node == frame.declaration.syntax && frame.declaration.kind == .row-decl
        = false
    if tree.subtree-start(node) <= id
        do match? tree.nodes[node]
            | .node-for-block
                = true
            | .node-iterator-expression
                = true
            | .node-while-block
                = true
            | .node-loop-syntax
                = true
            | .node-function-syntax
                = false
= false

────────────────────
_ do infer-argument-value TypeId
    - id SyntaxId
    - row ASTArgument

` An argument written where a value is wanted, as a line of a markup element's body, as the
` reference compiles one: one with a name is the tuple of its name and its value, and one with a
` bullet `•?` too is that tuple where the value tests as true, as a condition does, and nothing
` where it does not; one with no name is its value.
. value = infer(row.expr)
if value == invalid-type || value == no-type || !row.name
    = value
. mark = scratch.types.mark
. names-mark = scratch.names.mark
scratch.names.push(types.index-atom(0))
scratch.types.push(types.string-type)
scratch.names.push(types.index-atom(1))
scratch.types.push(value)
. pair = types.intern-tuple(mark, names-mark)
if !row.is-optional
    = pair
note-truthiness(id, row.expr, value)
= types.optional-around(pair)

────────────────────
_ do infer-stream TypeId
    - id SyntaxId
    - expr SyntaxId

` A stream of a value as it changes, `<#value>`, as the reference makes it: the value, read while
` a live action of its own is open, is written by `<-write` to an `AsyncBufferedChannel` of its
` type made there, which is kept in the local no name reaches declared at the stream, and the
` action writes the value again to the channel through the function written for it as what it
` read changes. One that reads nothing tracked is reported, as it would never change; one written
` where a markup element is being made has no shape here yet.
if !tracks-reads(tree, expr)
    . message = "A stream of a value follows the reads written with \"#\", and this one has none, so it would never change; write \"#\" before what it follows, as in \"<c.#count>\""
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
. decl = nested-decl-of(id)
. resolution = bindings.resolution-of(frame.binding, id)
if decl == 0 || resolution.kind != .resolve-slot || content-parents.length != 0
    decline(id)
    = invalid-type
. value = infer(expr)
if value == invalid-type || value == no-type
    = invalid-type
. channel = types.well-known-type-of("core/channel", "AsyncBufferedChannel", value)
if channel == invalid-type
    decline(id)
    = invalid-type
. made = calls.demand-constructor(channel, scratch.types.mark)
. given [TypeId]
given += value
. write = calls.protocol-call(channel, program.store-atom("<-write"), id, given, true).fact
if made == no-instance || write == no-fact
    decline(id)
    = invalid-type
do facts.record-call(instance, id, made, .call-constructor, scratch.no-fills, false)
frame.assign(resolution.slot, channel)
. position = facts.live-statements.length
while position != 0
    position -= 1
    . row = facts.live-statements[position]
    if row.instance != instance || row.site != id || row.rerun != no-instance
        continue
    . rerun = demand-lambda(intern-nested(decl), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(id)
        = invalid-type
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement(instance, id, rerun)
    = channel
decline(id)
= invalid-type

────────────────────
_ do stream-again Bool
    - statement SyntaxId
    - expr SyntaxId

` Types the value of a stream of a value as it changes, given again by a live action: the value
` is written again by `<-write` to the channel kept where the stream was made.
. resolution = bindings.resolution-of(frame.binding, statement)
. channel = if resolution.kind == .resolve-slot then frame.slot-type(resolution.slot) else no-type
if channel == no-type || channel == invalid-type
    = false
. value = infer(expr)
if value == invalid-type || value == no-type
    = false
. given [TypeId]
given += value
= calls.protocol-call(channel, program.store-atom("<-write"), statement, given, true).fact != no-fact

────────────────────
_ do settle-live-statement
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - written TypeId

` Types the function that runs a live statement again, once the statement is typed, and
` says whose actions the live action is: the object named alone whose property is assigned,
` where it is of a class, or for a declaration the object the reference's markup parent is
` where it is first read, the innermost markup element whose content is being typed, or else
` the receiver of the function, whose action is made as `declared-maker` says. The object of a
` class that markup makes the actions of that an assignment sets, a value the assignment
` stores only where it holds one, a statement that sets anything but a name or a property of an
` object named alone, and a declaration whose reads are not each plain, as `first-plain-read`
` says, have no shape here yet, nor has one typed where a batch of markup is in force, whose
` action the reference makes with the batch.
. position = facts.live-statements.length
while position != 0
    position -= 1
    . row = facts.live-statements[position]
    if row.instance != instance || row.site != id
        continue
    if row.rerun != no-instance
        =
    if in-batch()
        decline(id)
        =
    . declares = tree.nodes[id] is .node-declare
    . owned = frame.self-type != no-type && !lacks-self() && class-self
        .. class-self = types.intrinsic-of(frame.self-type) == .class
    . holder = no-type
    if declares
        holder = if content-parents.length != 0 then last-parent else owned-self
            .. last-parent = content-parents[content-parents.length - 1]
            .. owned-self = if owned then frame.self-type else no-type
    if !declares && written != stored-value(rhs, written)
        decline(id)
        =
    do match? tree.nodes[lhs]
        | .node-identifier
        | .node-type-capture
            if !declares
                decline(id)
                =
        | .node-get-expression(get)
            do match? tree.nodes[get.object]
                | .node-identifier
                    . owner = facts.node-type(instance, get.object)
                    if types.intrinsic-of(owner) == .class && !owns-plain-actions(owner)
                        decline(id)
                        =
                ??
                    decline(id)
                    =
        ??
            decline(id)
            =
    . first SyntaxId = 0
    if declares
        . declared = declaring-slot(lhs)
        if !declared
            decline(id)
            =
        first = first-read(declared, id)
    . maker InstanceId? = no-instance
    if declares
        maker = declared-maker(id, holder)
        if !maker
            =
    . rooted = maker! != no-instance && derived-interface(holder, types.markup-host-decl) == no-type
    . decl = nested-decl-of(id)
    . rerun = demand-lambda(intern-nested(decl), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(id)
        =
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement
        - instance
        - id
        - rerun
        - first
        - U32.max
        - maker!
        - rooted
        - holder
    =

────────────────────
_ do claim-lazy
    - slot SlotId
    - declaration SyntaxId
    - value SyntaxId

` A lazy local whose value is closable, which the reference keeps behind a flag
` (`lazy-flagged`), in a function that makes markup or runs on an object of a class, is claimed
` for the object that owns what is made where it is evaluated, as the reference's `ownClosable`
` gives it: a `ClosableTracker` of it, made a `Tracker`, is held by a live action of the owner,
` and the value and the tracker are converted at the declaration (`AddressClaim`). `it` is not
` claimed, and one written with a type its value is converted to has no shape here.
if value == 0 || bindings.slots[slot].name.text == "it" || !bindings.lazy-flagged(slot)
    =
. raw = facts.node-type(instance, value)
if raw == no-type || raw == invalid-type || derived-interface(raw, types.closable-decl) == no-type
    =
. owned = frame.self-type != no-type && !lacks-self() && class-self
    .. class-self = types.intrinsic-of(frame.self-type) == .class
if !owned && !writes-markup()
    =
if raw != frame.slot-type(slot)
    decline(declaration)
    =
demand-live-runtime()
. closable = types.well-known-type("core/stream", "Closable")
. tracking = types.well-known-type("core/tracker", "ClosableTracker")
. tracker = types.well-known-type("core/tracker", "Tracker")
if closable == invalid-type || tracking == invalid-type || tracker == invalid-type || live-missing
    decline(declaration)
    =
.. live-missing = instances.live.add-tracker == no-instance || instances.live.action == no-instance
. mark = scratch.types.mark
scratch.types.push(closable)
. closer = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if closer == no-instance
    decline(declaration)
    =
conversions.convert(declaration, declaration, raw, closable, .reason-argument)
conversions.convert
    - declaration
    - declaration
    - instances.signatures[closer].returns
    - tracker
    - .reason-argument
facts.address-claims += AddressClaim(instance, declaration, closer)

────────────────────
_ do writes-markup Bool

` Whether the body of the function being typed writes a markup element.
. body = frame.declaration.body
if body == 0
    = false
for node in tree.subtree-start(body) .. body
    if tree.nodes[node] is .node-markup
        = true
= false

────────────────────
_ do declared-maker InstanceId?
    - site SyntaxId
    - holder TypeId

` The function that makes the live action of a lazy declaration whose value read something
` tracked for the object of a type that owns it, as the reference's `createMarkupAction` makes
` it with no batch given: for a markup host the markup runtime's `make-owner-markup-action`,
` given the object as its host, else for a batch `make-markup-action`, given the object as the
` batch, to which it is converted at `site`; none where the object's actions are plain ones or
` nothing owns the action. Either may raise. One that has no shape here is declined, which is
` answered with nothing.
if holder == no-type || owns-plain-actions(holder)
    = no-instance
. host = if types.intrinsic-of(holder) == .class then markup-host else no-type
    .. markup-host = derived-interface(holder, types.markup-host-decl)
. rooted = host == no-type
if types.intrinsic-of(holder) != .class || (rooted && !is-batch(holder))
    decline(site)
    = null
. wanted = if rooted then batch-type() else host
demand-live-runtime()
. live = instances.live
. mark = scratch.types.mark
scratch.types.push
    - if live.trackers != no-instance then instances.signatures[live.trackers].returns else no-type
scratch.types.push(live.callback)
scratch.types.push(wanted)
. action = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom(if rooted then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
if action == no-instance || live.has-actions == no-instance || other-return
    decline(site)
    = null
.. other-return = instances.signatures[action].returns != types.live-action-type
if !raises-out(site, action)
    decline(site)
    = null
conversions.convert
    - site
    - site
    - holder
    - wanted
    - if rooted then .reason-markup-batch else .reason-markup-host
= action

────────────────────
_ do first-read SyntaxId
    - slot SlotId
    - declaration SyntaxId

` The first read of a lazy local in the order written, or none where nothing reads it.
. range = bindings.bindings[frame.binding].subtree
. start = tree.subtree-start(declaration)
for node in range.start .. < range.start + range.count
    if !(tree.nodes[node] is .node-identifier) || (node >= start && node <= declaration)
        continue
    . resolution = bindings.resolution-of(frame.binding, node)
    if resolution.kind == .resolve-slot && resolution.slot == slot
        = node
= 0

────────────────────
_ do demand-live-runtime

` Types, once, the instances a tracked value runs through (`LiveRuntime`): the module that
` declares a live action declares the rest.
. action = types.live-action-type
if instances.live.demanded || action == invalid-type
    =
instances.live.demanded = true
. live = instances.live
types.complete(action)
. module = class-ref(types, action).module
. trackers = types.properties[types.property-named(action, program.store-atom("trackers"))!].type
. callback = types.properties[types.property-named(action, program.store-atom("callback"))!].type
. mark = scratch.types.mark
live.trackers = calls.demand-constructor(trackers, mark)
scratch.types.push(trackers)
scratch.types.push(callback)
live.action = calls.demand-constructor(action, mark)
scratch.types.rewind(mark)
scratch.types.push(action)
. actions = types.class-named-with-args(module, types.list-atom!, mark)
scratch.types.rewind(mark)
live.actions = calls.demand-constructor(actions, mark)
scratch.types.push(action)
live.add-action = calls.demand-runtime-call(module, actions, program.store-atom("+="), mark)
scratch.types.rewind(mark)
. tracking = types.well-known-type("core/tracker", "Tracker")
if tracking != invalid-type
    scratch.types.push(tracking)
    live.add-tracker = calls.demand-runtime-call(module, trackers, program.store-atom("+="), mark)
    scratch.types.rewind(mark)
live.pop = calls.demand-method(actions, program.store-atom("pop"))
live.has-actions = calls.demand-method(actions, program.store-atom("!"))
live.close = calls.demand-method(action, program.store-atom("close"))
live.previous = module-getter(module, "active-previous-trackers")
live.next = module-getter(module, "active-next-trackers")
scratch.types.push(trackers)
scratch.types.push(trackers)
live.enter = calls.demand-runtime-call(module, no-type, program.store-atom("live-enter"), mark)
scratch.types.rewind(mark)
live.leave = calls.demand-runtime-call(module, no-type, program.store-atom("live-leave"), mark)
. tracker = types.well-known-type("core/tracker", "PropertyTracker")
if tracker == invalid-type
    instances.live = live
    =
types.complete(tracker)
. subscribers = tracker-field(tracker, "subscribers")
live.subscribers = calls.demand-constructor(subscribers, mark)
scratch.types.push(trackers)
scratch.types.push(trackers)
scratch.types.push(types.string-type)
scratch.types.push(tracker-field(tracker, "property-id"))
scratch.types.push(subscribers)
scratch.types.push(tracker-field(tracker, "owner"))
live.track = calls.demand-runtime-call
    - module
    - no-type
    - program.store-atom("track-property-dependency")
    - mark
scratch.types.rewind(mark)
scratch.types.push(subscribers)
scratch.types.push(types.string-type)
live.dispatch = calls.demand-runtime-call
    - module
    - no-type
    - program.store-atom("property-dispatch")
    - mark
scratch.types.rewind(mark)
. memo = types.well-known-type("core/tracker", "MemoAction")
if memo != invalid-type
    types.complete(memo)
    . owner = tracker-field(memo, "owner")
    . offset = tracker-field(memo, "flag-offset")
    scratch.types.push(trackers)
    scratch.types.push(callback)
    scratch.types.push(owner)
    scratch.types.push(offset)
    scratch.types.push(types.string-type)
    live.memo-action = calls.demand-constructor(memo, mark)
    scratch.types.rewind(mark)
    scratch.types.push(owner)
    scratch.types.push(offset)
    live.memo-settle = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("memo-settle-at")
        - mark
    scratch.types.rewind(mark)
live.callback = callback
. carried = carried-result(types, callback)
if carried != no-type
    types.complete(carried)
    facts.note-carried(function-row(types, callback), carried)
live.callback-result = carried
instances.live = live

────────────────────
_ do object-member TypeId
    - id SyntaxId
    - name Atom

` A member every object has that its class does not declare: its `uid`, or the list of the
` subscribers of its properties, which the runtime's property tracker gives the type of.
if name.text == "uid"
    facts.set-plan(instance, id, .plan-object-uid)
    = types.type-row(.uint32)
if name.text != "property-subscribers"
    = no-type
demand-live-runtime()
. tracker = types.well-known-type("core/tracker", "PropertyTracker")
if tracker == invalid-type || instances.live.subscribers == no-instance
    decline(id)
    = invalid-type
facts.set-plan(instance, id, .plan-property-subscribers)
= tracker-field(tracker, "subscribers")

────────────────────
_ do tracker-field TypeId
    - tracker TypeId
    - name String

` The declared type of a property of the runtime's property tracker, which gives the types the
` runtime's tracking functions take.
. place = types.property-named(tracker, program.store-atom(name))
= if place then types.properties[place].type else invalid-type

────────────────────
_ do module-getter InstanceId
    - module ModuleId
    - name String

` A getter a module declares, typed for compiled code that reads it of its own accord.
. atom = program.store-atom(name)
. decls = program.modules[module].decls
for position in 0 .. < decls.length
    do match? decls[position]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .getter-decl && fn.name == atom
                . decl = position as DeclId
                . callee = instances.intern
                    - module
                    - decl
                    - no-type
                    - callee-effects(frame, module, decl)
                    - no-instance
                demand(callee)
                = callee
= no-instance

────────────────────
_ reads-unmade Bool
    - name Atom

` Whether a member read by its name alone is the property the markup of a class declares
` for an element, read where the markup may not have run: in a constructor, or in the first
` value of a property or a rule. The reference reports the first, puts off the value of a
` stored property until the markup has run, and runs a rule that reads one in its test once
` it has.
|? !is-constructor-kind(frame.declaration.kind) && !instances.is-initializer(instance)
    false
|? self == no-type || self == invalid-type
    false
??
    place != null && names-element(types, types.properties[place])

.. self = frame.self-type
.. place = types.property-named(self, name)

────────────────────
_ do is-eager-value Bool

` Whether the instance types the value written for a stored property of a class, which a
` constructor can put off.
. unit = instances.rows[instance]
if unit.initializer == 0 || frame.self-type == no-type
    = false
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        = !row.is-lazy
= false

────────────────────
_ do is-lazy-value Bool

` Whether the instance types the value written for a lazy property of a class, worked out once
` when it is first read.
. unit = instances.rows[instance]
if unit.initializer == 0 || frame.self-type == no-type
    = false
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        = row.is-lazy
= false

────────────────────
_ do names-method Bool
    - owner ModuleId
    - decl DeclId

` Whether a declaration is a method called on a receiver: read as a value by its name
` alone, it binds the receiver of the function that reads it.
do match? program.modules[owner].decls[decl]
    | .decl-function(fn)
        = fn.owner != 0 && !fn.is-static && fn.kind == .function-decl
= false

────────────────────
_ names-module-accessor Bool
    - owner ModuleId
    - decl DeclId

match program.modules[owner].decls[decl]
    | .decl-function(fn)
        fn.owner == 0 && (fn.kind == .getter-decl || fn.kind == .setter-decl)
    ??
        false

────────────────────
_ do note-plain
    - id SyntaxId
    - name Atom

` Says of a name read that reading it evaluates nothing: a local or an argument that is not
` lazy, a global its module gives its value as it starts, a property the receiver stores as
` it is constructed, or a name of no value. A lazy one, and one kept in a way of its own, is
` evaluated where it is read. A property of the name of one some class derives may be
` evaluated again as it is read, so the reader may panic.
. resolution = bindings.resolution-of(frame.binding, id)
. plain = true
do match? resolution.kind
    |= .resolve-slot
        plain = bindings.slots[resolution.slot].kind != .slot-lazy
    |= .resolve-global
        plain = types.is-literal-global(resolution.module, resolution.decl)
        do match? program.modules[resolution.module].decls[resolution.decl]
            | .decl-property(row)
                if row.owner == 0 && row.decoration == null && row.name && !row.is-lazy
                    plain = true
    |= .resolve-member
        . found = types.property-named(frame.self-type, name) if frame.self-type != no-type
        plain = found != null && types.properties[found].storage-kind == .storage-eager
        if plain && program.is-derived-name(name) && types.intrinsic-of(frame.self-type) == .class
            instances.mark-may-panic(instance)
if plain
    facts.mark-plain(instance, id)

────────────────────
_ do note-case-read
    - id SyntaxId
    - slot SlotId
    - read TypeId

` Plans the read of a local that holds a union and is known to hold one case of it as the
` read of that case, and one known to hold cases of classes that derive from the class of one
` of them, read as that class, as the read of that one (`Narrowing.common-base`). One known to
` hold cases of classes that a class derives from or that derive from it, read as that class
` once a test for it holds, is read through the case `Narrowing.line-case` picks. A local that
` holds an optional of a union, known to hold a value that is one case, is planned the same. A
` local of an enclosing function is planned from the frame that declares it, as `read-slot` types it.
. home = slot-frame(slot)
plan-case-read(id, home.known(slot), home.narrowed-cases(slot-key(slot)), read)

────────────────────
_ narrowed-from TypeId
    - key NarrowingKey
    - receiver TypeId
    - name Atom

|? is-path-key(key)
    frame.path-declared-type(key)
|? declared != no-type || receiver == no-type || receiver == invalid-type
    declared
??
    if found then types.properties[found].type else no-type

.. declared = key-declared(key)
.. found = types.property-named(receiver, name)

────────────────────
_ do plan-case-read
    - id SyntaxId
    - declared TypeId
    - held U64
    - read TypeId

if read == declared || declared == no-type || declared == invalid-type
    =
if types.is-optional(declared)
    declared = types.optional-inner(declared)
if read == declared || types.intrinsic-of(declared) != .union
    =
. cases = types.completion-of(declared).cases
. based = narrowing.common-base(cases, held) == read
for offset in 0 .. < cases.count
    . bit = if offset < 64 then 1u64 /lshift/ offset else 0
    . base = based && (held /and/ bit) != 0 && types.cases[cases.start + offset].type == read
    if bit != 0 && (held == bit || base)
        facts.set-constant(instance, id, ConstantFact(offset, 0.0, null, false), .plan-case-read)
        =
. lined = narrowing.line-case(cases, held, read)
if held != 0 && lined != U32.max
    facts.set-constant(instance, id, ConstantFact(lined, 0.0, null, false), .plan-case-read)

────────────────────
_ slot-frame Frame
    - slot SlotId

if outer && frame.is-captured(slot) then outer.slot-frame(slot) else frame

────────────────────
_ do pointer-to TypeId
    - target TypeId

if target == invalid-type || target == no-type
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(target)
= types.class-named-with-args(module, types.cpointer-atom!, mark)

────────────────────
_ do sized-array TypeId
    - id SyntaxId
    - object TypeId
    - key-syntax SyntaxId
    - key TypeId

` An array of a type made with a count of an integer type takes the count as a `Size`, which
` it converts to as an argument does.
if types.intrinsic-of(object) != .type-info
    = no-type
. item-type = type-info-about(object)
if item-type == invalid-type
    = no-type
. mark = scratch.types.mark
scratch.types.push(item-type)
. pattern = types.class-named-with-args(module, types.array-atom!, mark)
if pattern == invalid-type
    = no-type
. count = key
if is-integer(key) && key != types.size-type
    count = conversions.convert(key-syntax, key-syntax, key, types.size-type, .reason-argument)
    if count == invalid-type
        = invalid-type
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(count)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(key-syntax)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. result = calls.construction-on(id, pattern, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do type-info-of TypeId
    - id SyntaxId
    - about TypeId

if about == invalid-type
    decline(id)
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(about)
= types.class-named-with-args(module, types.type-info-atom!, mark)

────────────────────
_ do type-info-about TypeId
    - info TypeId

do match? types.rows[info]
    | .type-class(row)
        if row.args.count == 1
            = types.child-type(row.args, 0)
= invalid-type

────────────────────
_ do static-get TypeId
    - id SyntaxId
    - about TypeId
    - name Atom

if about == invalid-type
    = invalid-type
. completion = types.completion-of(about)
if completion.intrinsic == .union
    for fact in types.cases[completion.cases]
        if fact.name && fact.name! == name
            . valued = (enum-case-value(about, name) ?? 0) != 0
            if valued
                note-enum-case(about, name, id)
                = about
            if fact.is-default || fact.type == no-type
                note-case(id, about, name)
                = about
            decline(id)
            = invalid-type
if completion.has-enums && enum-case-decl(types, program, about, name)
    note-enum-case(about, name, id)
    = about
if name == types.max-atom! || name == types.min-atom!
    . root = number-root(about)
    if root == invalid-type
        = invalid-type
    note-limit(id, root, name == types.max-atom!)
    = about
if name == types.size-atom!
    if is-numeric(types, about) && completion.bit-size != 0
        note-integer(id, (completion.bit-size + 7) / 8)
    else
        facts.set-plan(instance, id, .plan-type-size)
    = types.size-type
if is-type-info-text(name)
    note-type-text(id, about, name)
    = types.string-type
if is-type-info-flag(name)
    note-type-flag(id, about, name)
    = types.bool-type
if name.text == "bit-width"
    if !is-integer-kind(completion.intrinsic) && completion.intrinsic != .cpointer
        frame.diagnose(id, .stated, program.store-atom("Integer type required for bit-width"))
        = invalid-type
    note-integer(id, completion.bit-size)
    = types.type-row(.int64)
if name.text == "probe-data-type"
    note-integer(id, probe-data-type(types, about))
    = types.type-row(.int64)
if name.text == "properties"
    . listed = types.well-known-type("core/type", "PropertyList")
    if listed != invalid-type
        facts.note-properties-read(about)
        facts.set-plan(instance, id, .plan-type-properties)
        = listed
if name.text == "base"
    . base = types.base-of(about)
    if !base
        frame.diagnose(id, .stated, program.store-atom("No base type"))
        = invalid-type
    facts.set-plan(instance, id, .plan-type-base)
    = type-info-of(id, base)
frame.diagnose(id, .property-not-found, name)
= invalid-type

────────────────────
_ do note-integer
    - id SyntaxId
    - value U64

` Records an integer as the constant a node answers with.
facts.set-constant(instance, id, ConstantFact(value, 0, null, false))

────────────────────
_ do note-limit
    - id SyntaxId
    - root TypeId
    - is-max Bool

` Records the greatest or the least value of a number type as the constant its node answers
` with: the greatest and least finite values of a float.
. row = types.completions[root]
if intrinsic-is-float(row.intrinsic)
    . limit = if row.bit-size == 32 then 3.402823466e+38 else 1.7976931348623157e+308
    facts.set-constant(instance, id, ConstantFact(0, if is-max then limit else -limit, null, true))
else if is-integer-kind(row.intrinsic)
    note-integer(id, integer-limit(row.bit-size, row.is-signed && row.bit-size != 1, is-max))

────────────────────
_ do note-type-text
    - id SyntaxId
    - about TypeId
    - name Atom

` Records the name or the key of a type as the constant its node answers with. A class of
` objects and an interface answer the concrete ones from the value, so they have no constant,
` and neither has a type with arguments or one that is not a class. A concrete one with no
` constant is planned as read from the value, and the name or the key with none as the text
` of the type. The name inlining knows of a value of an interface has no constant either.
. kind = types.completion-of(about).intrinsic
. is-concrete = name.text == "concrete-name" || name.text == "concrete-key"
. is-inlined = name.text == "inlined-name"
. constant = !(is-concrete && (intrinsic-is-class(kind) || kind == .interface)) && not-inlined
    .. not-inlined = !(is-inlined && kind == .interface)
do match types.rows[about]
    | .type-class(row)
        if row.args.count != 0
            constant = false
    ??
        constant = false
if !constant
    if is-concrete
        facts.set-plan
            - instance
            - id
            - if name.text == "concrete-name" then .plan-concrete-name else .plan-concrete-key
    else if is-inlined && kind == .interface
        facts.set-plan(instance, id, .plan-inlined-name)
    else if name.text == "name" || is-inlined
        facts.set-plan(instance, id, .plan-type-name)
    else if name.text == "key"
        facts.set-plan(instance, id, .plan-type-key)
    =
. is-key = name.text == "key" || name.text == "concrete-key"
. text = if is-key then type-key(types, about) else type-short-name(types, about)
facts.set-constant(instance, id, ConstantFact(0, 0, program.store-atom(text), false))

────────────────────
_ do note-type-flag
    - id SyntaxId
    - about TypeId
    - name Atom

` Records what a type answers to a question about its kind as the constant of the node. A
` pointer is an integer without a sign. Every type is read-only but a class, a struct and a
` `TableField`, as TypeScript says.
. row = types.completion-of(about)
. kind = row.intrinsic
. numeric = is-numeric(types, about)
. asked = name.text
if asked == "read-only"
    . writable = kind == .class || kind == .struct || kind == .table-column
    note-integer(id, if writable then 0 else 1)
    =
. answer = kind == .struct
if asked == "is-integer"
    answer = is-integer-kind(kind) || kind == .cpointer
else if asked == "is-number"
    answer = numeric || kind == .cpointer
else if asked == "is-signed"
    answer = numeric && row.is-signed
else if asked == "is-tuple"
    answer = intrinsic-is-tuple-like(kind) && kind != .struct
note-integer(id, if answer then 1 else 0)

────────────────────
_ is-type-info-text Bool
    - name Atom

match name.text
    |= "name"
        true
    |= "inlined-name"
        true
    |= "concrete-name"
        true
    |= "concrete-key"
        true
    |= "key"
        true
    ??
        false

────────────────────
_ is-type-info-flag Bool
    - name Atom

` The Bool facts a type's info answers in the reference: `Item.is-integer` and its kin.
match name.text
    |= "is-integer"
        true
    |= "is-number"
        true
    |= "is-signed"
        true
    |= "is-tuple"
        true
    |= "is-struct"
        true
    |= "read-only"
        true
    ??
        false

────────────────────
_ do enum-case-type TypeId
    - about TypeId
    - name Atom

` The type of the value a case of an enum is written with, a number with no unit by its
` magnitude, as the number is typed where it is written.
. value = enum-case-value(about, name)
if !value
    = no-type
if value == 0
    = types.type-row(.int64)
. ref = class-ref(types, about)
. env = types.env-frame()
. tree = program.modules[ref.module].tree
do match? tree.nodes[value]
    | .node-integer-syntax(row)
        if !row.unit
            = magnitude-type(types, parse-integer-literal(row.value))
= literal-type(types, ref.module, tree, value, env)

────────────────────
_ do enum-case-value SyntaxId?
    - about TypeId
    - name Atom

. member = enum-case-decl(types, program, about, name)
if !member
    = null
. ref = class-ref(types, about)
do match? program.modules[ref.module].decls[member]
    | .decl-case(row)
        = row.value
= null

────────────────────
_ do number-root TypeId
    - about TypeId

. current = about
while true
    . kind = types.completions[current].intrinsic
    if kind == .bool
        = types.bool-type
    if types.type-row(kind) == current
        = current
    . base = types.base-of(current)
    if !base
        = invalid-type
    current = base

────────────────────
_ do cpointer-item TypeId
    - receiver TypeId

types.complete(receiver)
if types.completions[receiver].intrinsic != .cpointer
    = no-type
= pointee-of(types, receiver)

────────────────────
_ core-literal-type TypeId
    - owner U32
    - property DeclId

|? owner != types.core-module
    no-type
??
    match target.decls[property]
        | .decl-property(row)
            |? row.name == types.true-atom || row.name == types.false-atom
                types.bool-type
            |? row.name == types.null-atom
                types.null-type
            ??
                no-type
        ??
            no-type

.. target = program.modules[owner]

────────────────────
_ do read-member Found
    - id SyntaxId
    - name Atom
    - want Want = Want()

. receiver = frame.self-type
if receiver == no-type || receiver == invalid-type
    = Found(invalid-type)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-member && frame.is-doubted(member-key(resolution.decl))
    decline(id)
    = Found(invalid-type)
if resolution.kind == .resolve-member && frame.members-narrowed
    . key = member-key(resolution.decl)
    . narrowed = forced-member(id, key, want)
    if narrowed != no-type
        plan-case-read(id, narrowed-from(key, receiver, name), frame.narrowed-cases(key), narrowed)
        = Found(narrowed).holding(want.asks(.want-forced))
= read-property(id, id, receiver, name, want)

────────────────────
_ do forced-member TypeId
    - id SyntaxId
    - key NarrowingKey
    - want Want

` What the flow knows a property or a path to hold at a read of it. A read in the value of a lazy
` local of one a test the value made narrowed is noted as one that holds wherever the value is
` evaluated (`note-inside-read`), as a local's is.
. held = if !want.asks(.want-forced) then frame.narrowed-member(key) else frame.held-member(key)
if held != no-type && lazy-marks.length != 0 && narrowed-inside
    facts.note-inside-read(instance, id)
.. narrowed-inside = scratch.narrowed-since(lazy-marks[lazy-marks.length - 1], key) != no-type
= held

────────────────────
_ do note-lazy-read TypeId
    - id SyntaxId
    - property TypeProperty
    - receiver TypeId
    - name Atom

` A read of a lazy property evaluates its value when the object has none yet. The reference
` reads it by a call, which ends what is known of properties. The reader may panic where the
` value does, and always when the class of the object chooses the value: a class derived from
` the receiver's may write another. The errors the value lets out leave the reader at the read,
` which gives the value, as a call does; under `catch` the read gives the value or one of the
` errors, which is answered. A value that lets out errors for a class that the class of the
` object may not be is not typed here.
frame.forget-members()
if calls.is-virtual-receiver(receiver)
    instances.mark-may-panic(instance)
last-unit = no-instance
. value = demand-member(property, receiver, name)
. unit = last-unit
if unit == no-instance || unit == instance
    = no-type
panics.note-lazy-read(instance, unit)
. virtual = calls.is-virtual-receiver(receiver)
if !instances.errors-known(unit) && (frame.surround.catch-depth != 0 || virtual)
    demand-errors(unit)
. known = instances.errors-known(unit)
if known && instances.signatures[unit].errors.count == 0
    = no-type
if virtual || (!known && frame.surround.catch-depth != 0)
    decline(id)
    = no-type
if !known
    defer-outgoing(unit, id)
    = no-type
. signature = instances.signatures[unit]
if frame.surround.catch-depth != 0
    = result-type(types, value, calls.error-items(signature))
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], id)
= no-type

────────────────────
_ do read-property Found
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - want Want = Want()

. rows = forwarded-row
forwarded-row = no-type
. held = case-row
case-row = null
. receiver-kind = types.intrinsic-of(receiver)
if name == types.address-atom! && cpointer-item(receiver) != no-type
    facts.set-plan(instance, id, .plan-address)
    = Found(types.type-row(.uint64))
if receiver-kind == .atom
    if name == types.address-atom!
        facts.set-plan(instance, id, .plan-address)
        = Found(types.type-row(.uint64))
    if name == types.text-atom!
        facts.set-plan(instance, id, .plan-reinterpret)
        = Found(types.string-type)
. viewed = view-field(receiver, name)
if viewed != no-type
    . item = row-struct-of(receiver)
    plan-view(id, types.properties[types.property-named(item, name)!].slot)
    = Found(viewed)
if (is-column-receiver(receiver-kind) || columns || is-index-reader(receiver-kind)) && length-name
    plan-table(id, .table-length)
    = Found(types.size-type)
.. columns = receiver-kind == .table-column || receiver-kind == .immutable-table-column
.. length-name = name == types.length-atom! || name.text == "size"
. found = types.property-named(receiver, name)
if found && is-hidden(types.properties[found], name) && row-answers(receiver, name)
    found = null
if found
    . property = types.properties[found]
    if is-hidden(property, name)
        . message = "Property \"${name.text}\" is private"
        if id == object-syntax
            message = "Name not found"
        frame.diagnose(id, .stated, program.store-atom(message))
        = Found(invalid-type)
    if calls.ranking.has-extension-getter(receiver, name)
        frame.diagnose(id, .extension-conflict)
        = Found(invalid-type)
    if receiver-kind == .table-column && name == types.data-atom!
        plan-table(id, .table-data)
    if receiver-kind == .table && property.storage-kind == .storage-getter
        . getter = table-member(name.text)
        if getter == TableOp.table-mark || getter == TableOp.table-capacity
            plan-table(id, getter)
    if property.storage-kind == .storage-getter && !is-array-field(receiver, name)
        . capture = if held then held else row-capture-of(if object-syntax != id then object-syntax else 0)
        = Found(calls.getter-call(id, object-syntax, receiver, name, capture))
    if property.storage-kind == .storage-getter
        . place U64 = if name == types.data-atom! then 0 else 1
        facts.set-constant(instance, id, ConstantFact(place, 0, null, false), .plan-field)
    if property.storage-kind == .storage-lazy && !assigns-plainly
        . caught = note-lazy-read(id, property, receiver, name)
        if caught != no-type
            = Found(caught)
    if property.storage-kind == .storage-eager
        facts.mark-plain(instance, id)
        if !assigns-plainly && receiver-kind == .class && program.is-derived-name(name)
            instances.mark-may-panic(instance)
        if !assigns-plainly && id != rebound-root && unplanned && names-element(types, property) && !keeps-whole(name)
            instances.mark-may-panic(instance)
            facts.set-plan(instance, id, .plan-guarded-read)
        .. unplanned = facts.plan-of(instance, id) == .plan-none
    if property.type == no-type
        = Found(demand-member(property, receiver, name))
    = Found(property.type)
. shared-field = row-case-field(id, receiver, name)
if shared-field != no-type
    = Found(shared-field)
. places [U32]
. holder = calls.ranking.delegated-holder(receiver, name, places)
. reached = types.property-named(holder, name) if holder != no-type && places.length != 0
if reached && types.properties[reached].storage-kind != .storage-getter && !is-hidden(types.properties[reached], name)
    if calls.ranking.has-extension-getter(receiver, name)
        frame.diagnose(id, .extension-conflict)
        = Found(invalid-type)
    . read = read-property(id, object-syntax, holder, name, want)
    if read.type != invalid-type
        facts.set-through(instance, id, places, calls.step-getters(places))
    = read
if intrinsic-is-class(receiver-kind)
    . member = object-member(id, name)
    if member != no-type
        if calls.ranking.has-extension-getter(receiver, name)
            frame.diagnose(id, .extension-conflict)
            = Found(invalid-type)
        = Found(member)
if calls.has-getter(receiver, name)
    . capture = if held then held else row-capture-of(if object-syntax != id then object-syntax else 0)
    = Found(calls.getter-call(id, object-syntax, receiver, name, capture))
if receiver-kind == .union
    . built = union-property(id, receiver, name)
    if built != no-type
        = Found(built)
    if calls.getter-gap(receiver, name) == null
        . results [TypeId]
        for index in 0 .. < types.cases-of(receiver).length
            . payload = types.cases-of(receiver)[index].type
            if rows != no-type
                case-row = RowCapture(rows, index as U32, true)
            . got = read-property(id, object-syntax, payload, name, want).type
            if got == invalid-type
                = Found(invalid-type)
            if results.find(got) == null
                results += got
        facts.set-plan(instance, id, .plan-forward)
        = Found(calls.forward-results(id, results))
if receiver-kind == .optional
    if name == types.value-atom!
        = Found(types.optional-inner(receiver))
    if name == types.has-value-atom!
        = Found(types.bool-type)
if receiver-kind == .type-info
    = Found(static-get(id, type-info-about(receiver), name))
if name.text == "unit" && is-numeric(types, receiver)
    facts.set-plan(instance, id, .plan-unit-name)
    = Found(types.string-type)
. views = array-views(receiver, name)
if views != no-type
    if !is-view-item(row-struct-of(views))
        . message = "Array views require a fixed-layout product aggregate"
        frame.diagnose(id, .stated, program.store-atom(message))
        = Found(invalid-type)
    plan-view(id)
    = Found(views)
if name == types.length-atom! && (receiver-kind == .tuple || receiver-kind == .struct)
    . arity = tuple-arity(receiver)
    if arity != U32.max
        note-integer(id, arity)
    = Found(types.type-row(.int64))
if name.text == "layout" && receiver-kind == .table
    plan-table(id, .table-layout)
    = Found(types.string-type)
if is-column-receiver(receiver-kind)
    . column = column-field-type(receiver, name)
    if column != no-type
        . immutable = receiver-kind == .immutable-table || receiver-kind == .immutable-table-span
        . row = row-struct-of(receiver)
        if types.intrinsic-of(row) == .struct
            plan-table(id, .table-column, types.properties[types.property-named(row, name)!].slot)
        else if types.intrinsic-of(row) == .union
            . first = types.cases-of(row)[0].type
            . shared = types.property-named(first, name)
            if shared
                plan-table(id, .table-column, types.properties[shared].slot)
        = Found(types.column-view-of(column, immutable))
if receiver-kind == .table-row || receiver-kind == .immutable-table-row
    . row = row-struct-of(receiver)
    if row != no-type && types.intrinsic-of(row) == .union
        if has-case-getter(row, name)
            forwarded-row = receiver
            = read-property(id, object-syntax, row, name, want)
    . column = types.property-named(row, name) if row != no-type
    if column
        . field = types.properties[column]
        if is-hidden(field, name)
            frame.diagnose(id, .stated, program.store-atom("Property \"${name.text}\" is private"))
            = Found(invalid-type)
        if field.storage-kind == .storage-eager
            if types.intrinsic-of(row) == .struct
                plan-table(id, .table-field, field.slot)
            if field.type == no-type
                = Found(demand-member(field, row, name))
            = Found(field.type)
if declares-event(receiver, name)
    = read-event(id, receiver, name, want)
. bound = calls.method-binding(receiver, name, id)
if bound != no-type
    = Found(bound)
. gap = calls.getter-gap(receiver, name) if receiver-kind == .union
if gap
    frame.diagnose(id, .stated, program.store-atom(gap), receiver)
    frame.mention(calls.case-types(receiver))
    = Found(invalid-type)
if is-batch-flush(receiver)
    . (domain, below) = accessor-domain(name.text)
    if domain.length != 0 && !below
        = Found(flush-flag(id, domain))
if names-unmodeled-style(receiver, name, id)
    decline(id)
    = Found(invalid-type)
if hidden-property(id, object-syntax)
    = Found(invalid-type)
frame.diagnose(id, .property-not-found, name)
= Found(invalid-type)

────────────────────
_ do names-unmodeled-style Bool
    - receiver TypeId
    - name Atom
    - site SyntaxId

` Whether a name no member answers is one the reference reads or writes on an object as a
` property of a style its class uses, or as the flag of a domain a `MarkupBatchFlush` reports,
` neither of which has a shape here yet.
if is-batch-flush(receiver)
    . (domain, _) = accessor-domain(name.text)
    = domain.length != 0
if types.intrinsic-of(receiver) == .interface
    = uses-styles(receiver)
if types.intrinsic-of(receiver) != .class
    = false
. styles [TypeId]
if !add-visible-styles(receiver, styles, site)
    = true
= style-answering(styles, name) != no-type

────────────────────
_ do flush-flag TypeId
    - id SyntaxId
    - domain String

` A flag of a domain a `MarkupBatchFlush` reports, `is-X-invalid`, as the reference reads it:
` whether the bit of the domain, numbered as it is first named, is set in the mask of the
` domains the flush left pending.
. index = style-domain(program.store-atom(domain), module, id, module, id)
facts.style-flags += StyleFlag(instance, id, index, no-instance)
= types.bool-type

────────────────────
_ is-batch-flush Bool
    - type TypeId

` Whether a type is the `MarkupBatchFlush` of the markup runtime, which a program that loads no
` markup has none of.
flush.decl != 0 && same-decl(class-ref(types, type), flush)

.. flush = types.markup-batch-flush-decl

────────────────────
_ do uses-styles Bool
    - type TypeId

` Whether the declaration of a type names a style or a style sheet in a using.
. ref = class-ref(types, type)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            if owner.decls[member] is .decl-using
                = true
= false

────────────────────
_ do row-case-field TypeId
    - id SyntaxId
    - receiver TypeId
    - name Atom

` The field every case of a union shares, which a table row over the union reads in place:
` one the cases inherit from one declaration is planned as a field of the row, kept in a
` column of its own.
. row = calls.union-row(receiver)
if row == no-type
    = no-type
. shared = shared-case-field-type(row, name)
if shared != no-type
    . held = types.cases-of(row)
    . first = types.property-named(held[0].type, name) if held.length != 0
    if first && is-common-field(types, row, types.properties[first])
        plan-table(id, .table-field, types.properties[first].slot)
= shared

────────────────────
_ row-answers Bool
    - receiver TypeId
    - name Atom

` Whether a row of a table reads a name as a field of its row, or of the case its row holds,
` where the row's own member of the name is private, as TypeScript reads one past a member it
` may not use.
|? kind != .table-row && kind != .immutable-table-row
    false
|? row == no-type
    false
|? types.intrinsic-of(row) == .union && has-case-getter(row, name)
    true
??
    types.property-named(row, name) != null

.. kind = types.intrinsic-of(receiver)
.. row = row-struct-of(receiver)

────────────────────
_ do is-hidden Bool
    - fact TypeProperty
    - name Atom
    - accessor DeclKind = .getter-decl

` Whether a property, or the getter or setter that answers for it, is private to a module
` other than the one using it. One a markup element's name declares is not
` (`PropertyDecl.element`).
. ref = declaring-class(types, fact.owner, name)
if ref.module == module || (ref.module == 0 && ref.decl == 0)
    = false
. owner-module = program.modules[ref.module]
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        . place = owner-module.first-member(row.members, name)
        while place != no-member
            . member = owner-module.member-pool[place]
            place = owner-module.member-links[place]
            do match? owner-module.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name
                        = !is-public(property.access) && property.element == 0
                | .decl-function(fn)
                    if fn.kind == accessor && fn.name && fn.name == name
                        = !is-public(fn.access)
= false

────────────────────
_ do union-property TypeId
    - id SyntaxId
    - receiver TypeId
    - name Atom

` What a union answers by itself, planned at the node that reads it: the number of the case
` it holds, that case's name, the key of its type, or what the union holds as a case named.
` Where it holds another case, a case named gives what its type makes with nothing written,
` whose construction is recorded at the node.
if name.text == "case"
    facts.set-plan(instance, id, .plan-case-number)
    = types.type-row(.uint8)
if name.text == "name" || name.text == "type"
    facts.set-plan(instance, id, if name.text == "name" then .plan-case-name else .plan-case-type)
    = types.string-type
. cases = types.cases-of(receiver)
for index in 0 .. < cases.length
    . fact = cases[index]
    if fact.name && fact.name! == name
        facts.set-constant
            - instance
            - id
            - ConstantFact(index as U64, 0.0, null, false)
            - .plan-case-value
        construct-value(id, fact.type)
        = if fact.type != no-type then fact.type else types.type-row(.uint8)
= no-type

────────────────────
_ do array-views TypeId
    - receiver TypeId
    - name Atom

. is-rows = name.text == "rows"
if !is-rows && name.text != "fields"
    = no-type
. immutable = types.ancestor-of(receiver, types.immutable-array-decl)
. array = if immutable != no-type then immutable else types.ancestor-of(receiver, types.array-decl)
if array == no-type
    = no-type
. access = if immutable != no-type then types.array-read-access else types.array-write-access
. owner = if is-rows then types.array-rows-decl else types.array-fields-decl
= types.array-view-of(owner, row-struct-of(array), access)

────────────────────
_ do plan-view
    - id SyntaxId
    - slot U32 = U32.max

` A node the compiler answers for a view of an array, which may raise the panics of a view:
` with the place in the item's layout of the field a row or a view of fields is read at.
if slot == U32.max
    facts.set-plan(instance, id, .plan-view)
else
    facts.set-constant(instance, id, ConstantFact(slot, 0.0, null, false), .plan-view)
instances.mark-may-panic(instance)

────────────────────
_ do plan-table
    - id SyntaxId
    - op TableOp
    - slot U32 = 0

` A node the compiler answers for a table or a view of one, as TypeScript intercepts it before
` any method, which may raise the panics of a table: the operation, and the place in the row's
` layout of the field it reads or writes.
. bits = (op as U64) /or/ ((slot as U64) /lshift/ 32)
facts.set-constant(instance, id, ConstantFact(bits, 0.0, null, false), .plan-table)
instances.mark-may-panic(instance)

────────────────────
_ do plan-builder
    - id SyntaxId
    - builder TypeId
    - name String
    - count Size

` A member of an arena's builder that TypeScript answers where it is called, which may raise
` the panics of its growth: `append` of an item and `reserve`. The constant tells whether the
` arena traces the builder's items.
. item = types.builder-item(builder)
if item == no-type || item == invalid-type
    =
. appends = name == "append" && count == 1
if !appends && name != "reserve"
    =
. plan = if appends then OperatorPlan.plan-builder-append else OperatorPlan.plan-builder-reserve
. traces U64 = if calls.arena-traces(item) then 1 else 0
facts.set-constant(instance, id, ConstantFact(traces, 0.0, null, false), plan)
instances.mark-may-panic(instance)

────────────────────
_ table-member TableOp
    - name String

` The operation of a member of an arena's table that the compiler answers where it is called or
` read, as TypeScript answers it, or `table-row` for one it leaves to its body.
match name
    |= "append"
        TableOp.table-append
    |= "reserve"
        TableOp.table-reserve
    |= "extend"
        TableOp.table-extend
    |= "truncate"
        TableOp.table-truncate
    |= "clear"
        TableOp.table-clear
    |= "copy-from"
        TableOp.table-copy-from
    |= "finish"
        TableOp.table-finish
    |= "view"
        TableOp.table-view
    |= "rewind"
        TableOp.table-rewind
    |= "storage-checkpoint"
        TableOp.table-storage-checkpoint
    |= "validate-storage-restore"
        TableOp.table-validate-restore
    |= "restore-storage"
        TableOp.table-restore-storage
    |= "mark"
        TableOp.table-mark
    |= "capacity"
        TableOp.table-capacity
    ??
        TableOp.table-row

────────────────────
_ do note-span-range

` The range the constructor of an index span is given is made forward where the constructor
` runs, as TypeScript makes it: the call is recorded at no node of the constructor, which may
` raise the panics of a range that does not fit.
. range = instances.argument-type(instance, 1)
. shapes = scratch.call-arguments.mark
. given = scratch.types.mark
. written = scratch.syntax.mark
. none = arguments-since(shapes, given, written, scratch.no-types)
calls.method-call(0, 0, range, program.store-atom("forward"), none)
instances.mark-may-panic(instance)

────────────────────
_ is-table-view Bool
    - receiver TypeId

` Whether an index of a value of the type may be one the compiler answers for a table or a view
` of one (`plan-table-index`), which says whether the index makes a call.
kind == .table || kind == .immutable-table || spans || columns || selects || kind == .index-span

.. kind = types.intrinsic-of(receiver)
.. spans = kind == .table-span || kind == .immutable-table-span
.. columns = kind == .table-column || kind == .immutable-table-column
.. selects = kind == .table-selection || kind == .immutable-table-selection

────────────────────
_ do plan-table-index Bool
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId
    - result TypeId

` Plans an index of a table or of a view of one that TypeScript answers itself: a row of a
` table or of a span at a single index, an item of a field's column, the span or the view of
` the items a range spans, the rows indices select, and an index or a row of an index span or
` a selection, or the span a range of one spans. A range is made forward by the calls recorded
` here. False where those calls cannot be made.
. kind = types.intrinsic-of(receiver)
. tabled = table-kind || kind == .table-span || kind == .immutable-table-span
    .. table-kind = kind == .table || kind == .immutable-table
. made = types.intrinsic-of(result)
. spans = tabled && (made == .table-span || made == .immutable-table-span)
. columns = kind == .table-column || kind == .immutable-table-column
. selects = kind == .table-selection || kind == .immutable-table-selection
. ranged = is-range-type(key)
if tabled && (made == .table-row || made == .immutable-table-row)
    plan-table(id, .table-row)
else if (kind == .table || kind == .immutable-table) && made-selection
    plan-table(id, .table-select)
else if columns && !ranged
    plan-table(id, .table-item)
else if (kind == .index-span || selects) && !ranged
    plan-table(id, if kind == .index-span then .span-item else .selection-row)
else if ranged && (spans || (columns && made == kind) || kind == .index-span || selects)
    if !note-view-range(id, object-syntax, receiver, key-syntax, key)
        = false
    . op = TableOp.table-span
    if kind == .index-span
        op = .span-range
    else if selects
        op = .selection-range
    plan-table(id, op)
.. made-selection = made == .table-selection || made == .immutable-table-selection
= true

────────────────────
_ do view-cell TypeId
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId

` What an index of a view of rows or of one field reads, which the compiler answers before any
` `[]` the view declares: a range gives the view of the rows or the items it spans, and any
` other key, made an `Index`, the row or the item at that index.
. kind = view-kind(receiver)
if kind == 0
    = no-type
plan-view(id)
if is-range-type(key)
    if !note-view-range(id, object-syntax, receiver, key-syntax, key)
        = invalid-type
    = if kind == 2 then receiver else types.array-view-of(types.array-row-range-decl, row-struct-of(receiver), class-arg(types, receiver, 1))
conversions.convert(key-syntax, key-syntax, key, types.index-type, .reason-argument)
= if kind == 2 then row-struct-of(receiver) else types.array-view-of(types.array-row-decl, row-struct-of(receiver), class-arg(types, receiver, 1))

────────────────────
_ do note-view-range Bool
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId

` Records at the index of a view the calls that make a range of it forward: a range of
` positions is first made one of indexes by its `normalize`, given the view.
. first FactId = facts.calls.length as FactId
. range = key
if class-arg(types, key, 0) == types.position-type
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
    scratch.types.push(receiver)
    scratch.syntax.push(object-syntax)
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    range = calls.method-call(id, key-syntax, key, program.store-atom("normalize"), arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
if range == invalid-type || range == no-type
    = false
. empty-shapes = scratch.call-arguments.mark
. empty-types = scratch.types.mark
. empty-syntax = scratch.syntax.mark
. none = arguments-since(empty-shapes, empty-types, empty-syntax, scratch.no-types)
. forward = calls.method-call(id, key-syntax, range, program.store-atom("forward"), none)
. fact = facts.latest-call-of(instance)
while fact != no-fact && fact >= first
    if facts.calls[fact].syntax == id
        facts.calls[fact].form = .call-view-range
    fact = facts.prior-call(fact)
= forward != invalid-type && forward != no-type

────────────────────
_ do is-view-item Bool
    - item TypeId

` An array's rows and fields are views of a concrete tuple or struct item.
if item == no-type || item == invalid-type || types.completions[item].has-variables
    = false
. kind = types.intrinsic-of(item)
if kind != .tuple && kind != .struct
    = false
= match types.rows[item]
    | .type-class(row)
        !same-decl(DeclRef(row.module, row.decl), types.array-decl)
    ??
        true

────────────────────
_ view-item TypeId
    - receiver TypeId
    - owner DeclRef

|? types.intrinsic-of(receiver) != .tuple
    no-type
|? view == no-type
    no-type
??
    row-struct-of(view)

.. view = types.ancestor-of(receiver, owner)

────────────────────
_ do view-field TypeId
    - receiver TypeId
    - name Atom

. row-item = view-item(receiver, types.array-row-decl)
. item = if row-item != no-type then row-item else view-item(receiver, types.array-fields-decl)
if item == no-type
    = no-type
. found = types.property-named(item, name)
if !found
    = no-type
. field = eager-type(item, types.properties[found])
if field == no-type || row-item != no-type
    = field
= field-view(receiver, field)

────────────────────
_ do view-index TypeId
    - receiver TypeId
    - key-syntax SyntaxId
    - rows-only Bool = false

. row-item = view-item(receiver, types.array-row-decl)
if rows-only && row-item == no-type
    = no-type
. item = if row-item != no-type then row-item else view-item(receiver, types.array-fields-decl)
if item == no-type
    = no-type
. field = eager-field(item, key-syntax)
if field == no-type || row-item != no-type
    = field
= field-view(receiver, field)

────────────────────
_ is-plain-tuple Bool
    - type TypeId

match types.rows[type]
    | .type-tuple
        true
    ??
        false

────────────────────
_ do tuple-arity-at Bool
    - object TypeId
    - key-syntax SyntaxId

` Whether a constant index names the position just past a tuple's last field: assigning there
` gives a new tuple with one more field.
do match? types.rows[object]
    | .type-tuple(row)
        do match? tree.nodes[key-syntax]
            | .node-integer-syntax(key)
                . literal = parse-integer-literal(key.value)
                = !literal.negative && !literal.overflow && literal.value == row.fields.count
= false

────────────────────
_ do extended-tuple TypeId
    - object TypeId
    - value TypeId

. mark = scratch.types.mark
. names-mark = scratch.names.mark
do match? types.rows[object]
    | .type-tuple(row)
        for offset in 0 .. < row.fields.count
            scratch.names.push(types.index-atom(offset))
            scratch.types.push(types.child-type(row.fields, offset))
scratch.names.push(types.index-atom(scratch.types.length - mark))
scratch.types.push(value)
= types.intern-tuple(mark, names-mark)

────────────────────
_ view-kind U32
    - receiver TypeId

` Whether a type is a view of an array's rows, 1, or of one of its fields, 2, and 0 for any
` other: a range of a view is assigned from a view of the same kind.
|? receiver == no-type || receiver == invalid-type
    0
|? same-decl(ref, types.array-field-decl)
    2
|? same-decl(ref, types.array-rows-decl) || same-decl(ref, types.array-row-range-decl)
    1
??
    0

.. ref = class-ref(types, receiver)

────────────────────
_ do aggregate-field TypeId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId
    - operator Atom
    - value TypeId = no-type

` A tuple or struct class with no index operator of its own answers a constant index with the
` field at that position.
. kind = types.intrinsic-of(receiver)
if kind != .tuple && kind != .struct
    = no-type
if calls.has-operator(receiver, operator, key, value) || indexes-itself(receiver)
    = no-type
= eager-field(receiver, key-syntax)

────────────────────
_ do indexes-itself Bool
    - receiver TypeId

` Whether the class of a type, or a base of it, declares an index operator of its own.
. level TypeId? = receiver
while level
    do match? types.rows[level]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(body)
                    =? true if owner.first-member(body.members, types.index-op-atom!) != no-member
    level = types.base-of(level)
= false

────────────────────
_ do field-view TypeId
    - fields TypeId
    - field TypeId

. view = types.ancestor-of(fields, types.array-fields-decl)
= match types.rows[view]
    | .type-class(row)
        types.array-view-of(types.array-field-decl, field, types.child-type(row.args, 1))
    ??
        no-type

────────────────────
_ do eager-type TypeId
    - item TypeId
    - property TypeProperty

if property.storage-kind != .storage-eager
    = no-type
if property.type == no-type
    = demand-member(property, item, property.name)
= property.type

────────────────────
_ do eager-field TypeId
    - item TypeId
    - key-syntax SyntaxId

do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if literal.negative || literal.overflow
            = no-type
        types.complete(item)
        . range = types.completions[item].properties
        . position = 0u32
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind == .storage-eager
                if position == literal.value
                    = eager-type(item, property)
                position += 1
= no-type

────────────────────
_ do eager-slot U32
    - item TypeId
    - key-syntax SyntaxId

` The place in an item's layout of the stored field a constant index names.
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if literal.negative || literal.overflow
            = U32.max
        types.complete(item)
        . range = types.completions[item].properties
        . position = 0u32
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind == .storage-eager
                if position == literal.value
                    = property.slot
                position += 1
= U32.max

────────────────────
_ do published-payload TypeId
    - target SyntaxId

` What an event publishes, when a write names an event of this object or of a local one, and
` no type when it names anything else.
. receiver = no-type
. name Atom? = null
do match? tree.nodes[target]
    | .node-identifier(row)
        if bindings.resolution-of(frame.binding, target).kind == .resolve-member
            receiver = frame.self-type
            name = row.name
    | .node-get-expression(get)
        . simple = match tree.nodes[get.object]
            | .node-identifier
                true
            ??
                false
        if simple && !get.is-optional
            receiver = infer(get.object)
            name = get.name
if !name || receiver == no-type || receiver == invalid-type
    = no-type
if types.is-optional(receiver)
    receiver = types.optional-inner(receiver)
= event-payload(receiver, name)

────────────────────
_ event-payload TypeId
    - receiver TypeId
    - name Atom

if found then found.payload else no-type

.. found = event-of(receiver, name)

────────────────────
_ do event-of NamedEvent?
    - receiver TypeId
    - name Atom
    - anywhere Bool = false

` The event of this name a class declares or inherits, or an interface it is of declares, as
` the type that declares it has it, or none where none does, or one it keeps from the module
` asking, unless it is asked for `anywhere`.
for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    . place = target.first-member(class.members, name)
                    while place != no-member
                        . member = target.member-pool[place]
                        place = target.member-links[place]
                        do match? target.decls[member]
                            | .decl-event(event)
                                if event.name == name
                                    . hidden = match event.access
                                        | .private-access
                                            row.module != module
                                        ??
                                            false
                                    if hidden && !anywhere
                                        = null
                                    . private = event.access is .private-access
                                    = NamedEvent
                                        - cursor
                                        - name
                                        - declared-payload(cursor, event.type-syntax)
                                        - declared-key(cursor, event.key-type)
                                        - 0
                                        - private
= null

────────────────────
_ do event-chain [TypeId]
    - receiver TypeId

` The types whose declared events a type has: the type, the classes above it, and the
` interfaces each of them is of, each once.
. chain [TypeId]
. cursor = receiver
while cursor != no-type
    chain += cursor
    cursor = types.base-of(cursor) ?? no-type
. index Index = 0
while index < chain.length
    for interface in types.interfaces-of(chain[index])
        . known = false
        for held in chain
            known = known || held == interface
        if !known
            chain += interface
    index += 1
= chain

────────────────────
_ do read-event Found
    - id SyntaxId
    - receiver TypeId
    - name Atom
    - want Want

` A node that names an event of an object, which is used as `use-event` says. One private to
` another module is an error at its declaration, as the reference finds it.
. found = event-of(receiver, name)
if !found && hides-event(receiver, name)
    = Found(invalid-type)
if !found || found.payload == no-type
    decline(id)
    = Found(invalid-type)
= use-event(id, found, want)

────────────────────
_ do hides-event Bool
    - receiver TypeId
    - name Atom

` Whether the event of this name a class declares or inherits, or an interface it is of
` declares, is private to another module, which is reported where the event is declared.
for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    . place = target.first-member(class.members, name)
                    while place != no-member
                        . member = target.member-pool[place]
                        place = target.member-links[place]
                        do match? target.decls[member]
                            | .decl-event(event)
                                if event.name == name && private-event && row.module != module
                                    . message = program.store-atom
                                        - "Event \"${name.text}\" is private"
                                    facts.record-diagnostic
                                        - instance
                                        - row.module
                                        - event.syntax
                                        - .stated
                                        - message
                                    = true
                                .. private-event = event.access is .private-access
= false

────────────────────
_ do use-event Found
    - id SyntaxId
    - event NamedEvent
    - want Want

` A node that names an event, where something uses it as the reference does: a write that
` publishes to it, a loop that subscribes to it, an index that addresses it with a key, or
` `rekey` or `release` of an address asks for it at the node, and a value of the event's
` `Broadcastable`, an argument of a call, as the reference gives an event to a parameter, or the
` container of a comprehension on a stream, takes its endpoint. The node has that
` `Broadcastable`'s type. So has one in an argument of a call of a name nothing declares, which
` is reported as no function found (`names-nothing`). One used as a value is reported as
` `refuse-event-value` says (`misused-event`), and an argument one converted by a converter as
` `misused-endpoint` says, and one read with `<-` as `refuse-event-read` says. The value stored
` in a property is taken once the property is known (`store-event`). Naming an event anywhere
` else, a keyed one with no address among them, is not supported.
. broadcastable = endpoint-of(event)
if broadcastable == invalid-type
    decline(id)
    = Found(invalid-type)
if want.asks(.want-event)
    = Found(broadcastable, no-type, found-event(event))
if want.asks(.want-adapt)
    escape-event(id, event, broadcastable, id)
    = Found(broadcastable)
if want.asks(.want-escape) && want.type == broadcastable
    escape-event(id, event, broadcastable, want.place)
    = Found(broadcastable)
if misused-event(id, broadcastable, want)
    refuse-event-value(id, event.owner, event.name)
    = Found(invalid-type)
if want.asks(.want-store)
    = Found(broadcastable, no-type, found-event(event))
if argument-typing.unknown-callee
    = Found(broadcastable)
if want.asks(.want-argument) && (event.key == no-type || event.address != 0)
    escape-event(id, event, broadcastable, id)
    endpoint-arguments += id
    endpoint-events += event
    = Found(broadcastable)
if reads-once(id)
    refuse-event-read(id, event.owner, event.name)
    = Found(invalid-type)
frame.diagnose(id, .not-supported)
= Found(invalid-type)

────────────────────
_ do address-event Found
    - id SyntaxId
    - key-syntax SyntaxId
    - is-optional Bool
    - event NamedEvent
    - want Want

` A keyed event indexed with a key, as the reference addresses one: the key is converted at
` its node to the event's key type, and the index names the event at that address, used as
` `use-event` says. A negative number written as the key is not supported, which the
` reference checks against the `U64` the address holds as well and rejects.
if is-optional
    frame.diagnose(id, .stated, program.store-atom("Addressed event lookup cannot be optional"))
    = Found(invalid-type)
if event.address != 0
    frame.diagnose(id, .stated, program.store-atom("An addressed event cannot be indexed again"))
    = Found(invalid-type)
if event.key == no-type
    frame.diagnose(id, .stated, program.store-atom("Event \"${event.name.text}\" is not keyed"))
    = Found(invalid-type)
if event.key == invalid-type || !event-key(event.key)
    decline(id)
    = Found(invalid-type)
. key = infer(key-syntax)
if key == invalid-type || conversions.convert(key-syntax, key-syntax, key, event.key, .reason-argument) == invalid-type
    = Found(invalid-type)
if negative-literal(key-syntax)
    decline(key-syntax)
    = Found(invalid-type)
= use-event(id, NamedEvent(event.owner, event.name, event.payload, event.key, id, event.is-private), want)

────────────────────
_ do negative-literal Bool
    - id SyntaxId

` Whether a node is a negative number written in source.
do match? tree.nodes[id]
    | .node-integer-syntax(row)
        = parse-integer-literal(row.value).negative
    | .node-unary-expression(row)
        if row.op == .negative-op
            do match? tree.nodes[row.operand]
                | .node-integer-syntax
                    = true
= false

────────────────────
_ do unaddressed Bool
    - id SyntaxId
    - event NamedEvent

` Whether an event published by key is used with no key, which is an error at the node.
if event.key == no-type || event.address != 0
    = false
frame.diagnose
    - id
    - .stated
    - program.store-atom("Keyed event \"${event.name.text}\" must be addressed with [key]")
= true

────────────────────
_ do stable-key Bool
    - key SyntaxId

` Whether a key names what lasts as long as the address it makes, as the reference decides:
` a name, a number, a text or a case written alone, a name read from one, or a tuple of them.
do match? tree.nodes[key]
    | .node-identifier
        = true
    | .node-integer-syntax
        = true
    | .node-string-syntax
        = true
    | .node-anonymous-case
        = true
    | .node-get-expression(get)
        = stable-key(get.object)
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            if !stable-key(item)
                = false
        = true
= false

────────────────────
_ do publish-event TypeId
    - id SyntaxId
    - reference SyntaxId
    - event NamedEvent
    - arguments Arguments

` A write to an event, as the reference publishes one: what it is given is made the event's
` payload, but only where something listens, which the event runtime answers for the object,
` and the runtime then publishes it. A `RoutedEvent` is always made and published along its
` route of owners, from the object on. An event that bubbles (`event-node`) is published along
` the parents of its object where its payload has no route of its own, and asks whether
` anything listens on the object or anywhere it could bubble to. A keyed event is published at
` its address, where the runtime answers with the generation of the receiver there, and is given
` it to publish with.
if event.payload != types.void-type
    . site = arguments.syntax[0]
    . given = calls.payload-argument(arguments, 0, event.payload)
    if conversions.convert(site, site, given, event.payload, .reason-argument) == invalid-type
        = invalid-type
    note-payload-effects(site, event.name)
if routes(event.payload) && event.key != no-type
    frame.diagnose(id, .stated, program.store-atom("Keyed events cannot use routed publication"))
    = invalid-type
if routes(event.payload)
    . node = event-node(reference, event)
    . mark = scratch.types.mark
    scratch.types.push(event.payload)
    scratch.types.push(types.size-type)
    scratch.types.push(pointer-to(types.type-row(.uint8)))
    if node != no-type
        scratch.types.push(node)
    scratch.types.push(event.payload)
    . routing = if node != no-type then "event-publish-routed-node" else "event-publish-routed"
    . route = calls.demand-runtime-call
        - types.event-endpoint-decl.module
        - no-type
        - program.store-atom(routing)
        - mark
        - 1
    scratch.types.rewind(mark)
    if route == no-instance
        decline(id)
        = invalid-type
    facts.event-uses += EventUse
        - instance
        - id
        - reference
        - event.owner
        - event.name
        - .event-route
        - route
        - no-instance
        - no-instance
        - 0
        - node != no-type
    instances.mark-may-panic(instance)
    = types.void-type
if unaddressed(id, event)
    = invalid-type
. keyed = event.address != 0
. node = if keyed then no-type else event-node(reference, event)
. interest = if keyed then event-call("event-keyed-interest-generation", event.payload, no-type, 2) else event-call(if node != no-type then "event-has-route-interest" else "event-has-interest", no-type)
. publish = no-instance
if keyed
    publish = event-call("event-publish-keyed", event.payload, event.payload, 3)
else if node != no-type
    . mark = scratch.types.mark
    scratch.types.push(event.payload)
    scratch.types.push(pointer-to(types.type-row(.uint8)))
    scratch.types.push(types.size-type)
    scratch.types.push(node)
    scratch.types.push(event.payload)
    publish = calls.demand-runtime-call
        - types.event-endpoint-decl.module
        - no-type
        - program.store-atom("event-publish-node")
        - mark
        - 1
    scratch.types.rewind(mark)
else
    publish = event-call("event-publish", event.payload, event.payload)
if interest == no-instance || publish == no-instance
    decline(id)
    = invalid-type
facts.event-uses += EventUse
    - instance
    - id
    - reference
    - event.owner
    - event.name
    - .event-publish
    - interest
    - publish
    - no-instance
    - event.address
    - node != no-type
instances.mark-may-panic(instance)
= types.void-type

────────────────────
_ do event-node TypeId
    - reference SyntaxId
    - event NamedEvent

` The `EventNode` an event is published along, where it bubbles: one that is not private and is
` published by no key, on an object whose class is an `EventNode`, which is converted at the node
` that names the event (`reason-event-node`). No type where it does not bubble.
if event.is-private || event.key != no-type
    = no-type
. node = types.well-known-type("core/event", "EventNode")
if node == invalid-type || node == no-type
    = no-type
. receiver = event-receiver(reference)
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    = no-type
if derived-interface(receiver, class-ref(types, node)) == no-type
    = no-type
if conversions.convert(reference, reference, receiver, node, .reason-event-node) == invalid-type
    = no-type
= node

────────────────────
_ do event-receiver TypeId
    - reference SyntaxId

` The type of the object a node that names an event publishes on, as the emitter evaluates it
` (`Emitter.event-owner`).
do match? tree.nodes[reference]
    | .node-get-expression(get)
        = facts.node-type(instance, get.object)
    | .node-identifier(row)
        if (reference-flags /and/ ResolutionFlag.resolution-received) != 0
            = received-parent(reference, row.name)
        .. reference-flags = bindings.resolution-of(frame.binding, reference).flags
        = frame.self-type
= no-type

────────────────────
_ do note-payload-effects
    - payload SyntaxId
    - event Atom

` Records the effects the payload of an event has (`PayloadEffectFact`), as the reference finds
` them as it makes the payload: a call of a `do` function other than a constructor, an assignment
` used as a value, and a write to a channel, the first of each as the reference meets it. A
` function written in the payload runs where it is called, not where it is made.
if !facts.traces-lint || payload == 0
    =
. written = payload
do match? tree.nodes[payload]
    | .node-argument(row)
        written = row.expr
. start = tree.subtree-start(written)
. firsts [U32]
for _ in 0 .. < 3
    firsts += U32.max
. id = written
while id >= start
    . key = U32.max
    . kind = PayloadEffectKind.effect-call
    . nested = false
    do match? tree.nodes[id]
        | .node-function-syntax
            nested = true
        | .node-assign
            do match? tree.nodes[tree.holder-of(id)]
                | .node-block
                    key = U32.max
                ??
                    key = tree.subtree-start(id)
                    kind = .effect-assignment
        | .node-binary-expression(row)
            if row.op == .write-op
                key = tree.subtree-start(id)
                kind = .effect-channel-write
        | .node-call-expression(row)
            do match? tree.nodes[row.callable]
                | .node-get-expression(get)
                    if get.name.text == "<-write" && !get.is-optional
                        key = tree.subtree-start(id)
                        kind = .effect-channel-write
    if nested
        id = tree.subtree-start(id)
    else
        if key != U32.max && key < firsts[kind]
            firsts[kind] = key
        if id < firsts[0] && calls-imperative(id)
            firsts[0] = id
    if id <= start
        break
    id -= 1
while true
    . next = 3u32
    for position in 0 .. < 3
        if firsts[position] != U32.max && (next == 3 || firsts[position] < firsts[next])
            next = position as U32
    if next == 3
        break
    firsts[next] = U32.max
    facts.payload-effects.append
        - PayloadEffectFact(instance, written, event, next as PayloadEffectKind)

────────────────────
_ do calls-imperative Bool
    - id SyntaxId

` Whether a node calls a `do` function other than a constructor, as a function, a method, an
` operator or a static method.
. cursor = facts.first-call(instance, id)
while cursor != no-fact
    . call = facts.calls[cursor]
    cursor = call.next
    . plain = call.form == .call-function || call.form == .call-method
    if call.callee == no-instance || !(plain || operator-or-static)
        continue
    .. operator-or-static = call.form == .call-operator || call.form == .call-static
    . row = instances.rows[call.callee]
    . checked = describe(program, row.module, row.decl)
    if checked && checked.is-imperative && !is-constructor-kind(checked.kind)
        = true
= false

────────────────────
_ do readdress-event TypeId
    - id SyntaxId
    - reference SyntaxId
    - event NamedEvent
    - arguments Arguments
    - rekeys Bool

` `rekey` or `release` of the address of a keyed event, as the reference makes them: the
` receiver, which claimed the endpoint there, gives the address a new key, the call's
` argument converted to the event's key type, or gives it up. The errors `rekey` raises leave
` the function with the call, or under `catch` the call gives nothing or one of them.
. verb = if rekeys then "rekey" else "release"
if event.address == 0
    frame.diagnose(id, .stated, program.store-atom("$verb requires an addressed keyed event"))
    = invalid-type
if rekeys
    . site = arguments.syntax[0]
    if conversions.convert(site, site, arguments.types[0], event.key, .reason-argument) == invalid-type
        = invalid-type
if !is-owner()
    frame.diagnose
        - id
        - .stated
        - program.store-atom("$verb requires the stable target/address lifetime")
    = invalid-type
. called = if rekeys then event-call("event-keyed-rekey", event.payload, no-type, 5) else event-call("event-keyed-release", event.payload, no-type, 3)
if called == no-instance
    decline(id)
    = invalid-type
. caught = frame.surround.catch-depth != 0 && frame.surround.transformer-depth == 0
if caught
    demand-errors(called)
else if !raises-out(id, called)
    decline(id)
    = invalid-type
. kind = if rekeys then EventUseKind.event-rekey else EventUseKind.event-release
facts.event-uses += EventUse
    - instance
    - id
    - reference
    - event.owner
    - event.name
    - kind
    - called
    - no-instance
    - no-instance
    - event.address
instances.mark-may-panic(instance)
. signature = instances.signatures[called]
if caught && signature.errors.count != 0
    = result-type(types, types.void-type, calls.error-items(signature))
= types.void-type

────────────────────
_ do raises-out Bool
    - site SyntaxId
    - callee InstanceId

` Notes the errors a function of the event or markup runtime raises as leaving the function at
` a node, as those of a call written there do. Where they would be caught or transformed there,
` which has no shape here, it says no.
demand-errors(callee)
. signature = instances.signatures[callee]
if signature.errors.count == 0
    = true
if frame.surround.catch-depth != 0 || frame.surround.transformer-depth != 0
    = false
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], site)
= true

────────────────────
_ routes Bool
    - payload TypeId

` Whether an event's payload is a `RoutedEvent`, which the reference publishes along a route of
` owners.
routed != invalid-type && derived-interface(payload, class-ref(types, routed)) != no-type

.. routed = types.well-known-type("core/event", "RoutedEvent")

────────────────────
_ do event-call InstanceId
    - name String
    - payload TypeId
    - given TypeId = no-type
    - words Size = 0

` A function of the event runtime that compiled code calls of its own accord, for an object and
` the number of one of its events, then as many `U64` words as it is given, the halves of the
` keys of an address, a generation, or the identity of a receiver, then `given` where there is
` one: with `payload` as its type argument where there is one.
. mark = scratch.types.mark
if payload != no-type
    scratch.types.push(payload)
scratch.types.push(pointer-to(types.type-row(.uint8)))
scratch.types.push(types.size-type)
for _ in 0 .. < words
    scratch.types.push(types.type-row(.uint64))
if given != no-type
    scratch.types.push(given)
. explicit Size = if payload != no-type then 1 else 0
. called = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom(name)
    - mark
    - explicit
scratch.types.rewind(mark)
= called

────────────────────
_ do escape-event
    - id SyntaxId
    - event NamedEvent
    - broadcastable TypeId
    - place SyntaxId

` An event made the `Broadcastable` a value is wanted as: the endpoint the event runtime keeps
` for it on the object, made where the node is, converted there. One at the address of a keyed
` event is claimed for the receiver (see `claim-endpoint`), and its key must name what lasts as
` long as the address does. What is wrong with it is an error where the value is converted, at
` the type a declaration states (`place`).
if unaddressed(place, event)
    =
if event.address != 0 && !stable-key(index-key(event.address))
    . message = "A temporary keyed event address cannot escape; declare a stable address key and use that stable addressed lifetime"
    frame.diagnose(place, .stated, program.store-atom(message))
    =
. adapter = if event.address != 0 then event-call("event-keyed-adapter", event.payload, no-type, 3) else event-call("event-adapter", event.payload)
if adapter == no-instance
    decline(id)
    =
if event.address != 0 && !claim-endpoint(id, place, event.address, adapter)
    =
conversions.convert(id, id, instances.signatures[adapter].returns, broadcastable, .reason-argument)
facts.event-uses += EventUse
    - instance
    - id
    - id
    - event.owner
    - event.name
    - .event-escape
    - adapter
    - no-instance
    - no-instance
    - event.address
instances.mark-may-panic(instance)

────────────────────
_ do claim-endpoint Bool
    - site SyntaxId
    - place SyntaxId
    - address SyntaxId
    - made InstanceId

` The endpoint at the address of a keyed event, which `made` gives, claimed for the receiver as
` the reference claims it: the receiver's identity is given for it, its errors leave the
` function at `site`, and a `ClosableTracker` of it, held by a live action of the receiver,
` closes it with the receiver. Says whether it is claimed; it is an error at `place` where
` there is no receiver.
if !is-owner()
    . message = "An addressed event subscription or adapter requires a stable target/address lifetime"
    frame.diagnose(place, .stated, program.store-atom(message))
    = false
demand-live-runtime()
. closable = types.well-known-type("core/stream", "Closable")
. tracking = types.well-known-type("core/tracker", "ClosableTracker")
. tracker = types.well-known-type("core/tracker", "Tracker")
if closable == invalid-type || tracking == invalid-type || tracker == invalid-type || live-missing
    decline(site)
    = false
.. live-missing = instances.live.add-tracker == no-instance || instances.live.action == no-instance
. mark = scratch.types.mark
scratch.types.push(closable)
. closer = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if closer == no-instance || !raises-out(site, made)
    decline(site)
    = false
. named = index-object(address)
conversions.convert(named, named, instances.signatures[made].returns, closable, .reason-argument)
conversions.convert(named, named, instances.signatures[closer].returns, tracker, .reason-argument)
facts.address-claims += AddressClaim(instance, named, closer)
= true

────────────────────
_ do index-key SyntaxId
    - index SyntaxId

` The key an index is written with.
do match? tree.nodes[index]
    | .node-index-expression(row)
        = row.index
= 0

────────────────────
_ do index-object SyntaxId
    - index SyntaxId

` What an index is read from.
do match? tree.nodes[index]
    | .node-index-expression(row)
        = row.object
= 0

────────────────────
_ do declared-key TypeId
    - owner TypeId
    - syntax SyntaxId

` The type of the key an event is published by, or none where it is published by none. A key
` whose type is not known is the invalid type.
if syntax == 0
    = no-type
. key = declared-payload(owner, syntax)
= if key == no-type then invalid-type else key

────────────────────
_ do declared-payload TypeId
    - owner TypeId
    - syntax SyntaxId

if syntax == 0
    = types.void-type
. payload = invalid-type
do match? types.rows[owner]
    | .type-class(row)
        . env = types.class-env-for(row.module, row.decl, row.args, owner)
        . tree = program.modules[row.module].tree
        payload = types.evaluate-type(row.module, tree, syntax, env)
        types.env-release(env)
= if payload == invalid-type then no-type else payload

────────────────────
_ do declares-event Bool
    - receiver TypeId
    - name Atom

for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    . place = target.first-member(class.members, name)
                    while place != no-member
                        . member = target.member-pool[place]
                        place = target.member-links[place]
                        do match? target.decls[member]
                            | .decl-event(event)
                                if event.name == name
                                    = true
= false

────────────────────
_ do declares-method Bool
    - receiver TypeId
    - name Atom

. cursor = receiver
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    . place = target.first-member(class.members, name)
                    while place != no-member
                        . member = target.member-pool[place]
                        place = target.member-links[place]
                        do match? target.decls[member]
                            | .decl-function(fn)
                                if written && fn.kind == .function-decl && same-name
                                    = true
                                .. written = !fn.is-generated && !fn.is-static
                                .. same-name = fn.name && fn.name == name
    cursor = types.base-of(cursor) ?? no-type
= false

────────────────────
_ do inherited-getter-type TypeId
    - self TypeId

` The type a getter that states none returns where it is over one a base states the type of,
` which each getter over that one keeps.
=? no-type if self == no-type || self == invalid-type
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        . name = fn.name
        if fn.kind == .getter-decl && fn.return-type == 0 && name
            types.complete(self)
            . base = types.base-of(self) ?? no-type
            if base != no-type && states-getter-type(base, name)
                . inherited = types.property-named(base, name)
                if inherited
                    = types.properties[inherited].type
= no-type

────────────────────
_ do states-getter-type Bool
    - receiver TypeId
    - name Atom

` Whether the getter of this name that the receiver declares or inherits states its type
` where it is first declared, the farthest base that declares one: each getter over it has
` the type it states there, as TypeScript gives each inherited property its base's.
. stated = false
. cursor = receiver
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    . place = target.first-member(class.members, name)
                    while place != no-member
                        . member = target.member-pool[place]
                        place = target.member-links[place]
                        do match? target.decls[member]
                            | .decl-function(fn)
                                if fn.kind == .getter-decl && fn.name == name
                                    stated = fn.return-type != 0
    cursor = types.base-of(cursor) ?? no-type
= stated

────────────────────
_ is-column-receiver Bool
    - kind IntrinsicKind

|? kind == .table || kind == .immutable-table
    true
??
    kind == .table-span || kind == .immutable-table-span

────────────────────
_ is-field-view Bool
    - kind IntrinsicKind

` Whether a value is a view of a field's column.
kind == .table-column || kind == .immutable-table-column

────────────────────
_ do column-field-type TypeId
    - receiver TypeId
    - name Atom

. row = row-struct-of(receiver)
if row == no-type || row == invalid-type
    = no-type
if types.intrinsic-of(row) == .union
    = shared-case-field-type(row, name)
. column = types.property-named(row, name)
if !column
    = no-type
. field = types.properties[column]
if field.storage-kind != .storage-eager
    = no-type
if field.type == no-type
    = demand-member(field, row, name)
= field.type

────────────────────
_ do shared-case-field-type TypeId
    - union TypeId
    - name Atom

. first = first-case(union)
if first == no-type
    = no-type
. found = types.property-named(first, name)
if !found
    = no-type
. field = types.properties[found]
if !is-common-field(types, union, field)
    = no-type
= eager-type(first, field)

────────────────────
_ first-case TypeId
    - union TypeId

|? cases.length == 0
    no-type
|? first == invalid-type || cases[0].is-default
    no-type
??
    first

.. cases = types.cases-of(union)
.. first = cases[0].type

────────────────────
_ do has-case-getter Bool
    - union TypeId
    - name Atom

for fact in types.cases-of(union)
    if !fact.is-default && fact.type != no-type && fact.type != invalid-type
        . found = types.property-named(fact.type, name)
        if found && types.properties[found].storage-kind == .storage-getter
            = true
        if !found && calls.has-getter(fact.type, name)
            = true
= false

────────────────────
_ do column-at TypeId
    - receiver TypeId
    - position U32

` The field a table or span destructures to at a position, and no type past its last field.
. row = row-struct-of(receiver)
if row == no-type || row == invalid-type
    = no-type
. shared = types.intrinsic-of(row) == .union
. source = if shared then first-case(row) else row
if source == no-type
    = no-type
types.complete(source)
. range = types.completions[source].properties
. index = 0u32
for offset in 0 .. < range.count
    . property = types.properties[(range.start + offset) as Index]
    . counted = if shared then is-common-field(types, row, property) else eager-property
        .. eager-property = property.storage-kind == .storage-eager
    if counted
        if index == position
            = eager-type(source, property)
        index += 1
= no-type

────────────────────
_ do column-count U32
    - receiver TypeId

. count = 0u32
while column-at(receiver, count) != no-type
    count += 1
= count

────────────────────
_ row-struct-of TypeId
    - receiver TypeId

match types.rows[receiver]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
_ is-array-field Bool
    - receiver TypeId
    - name Atom

|? name != types.size-atom! && name != types.length-atom! && name != types.data-atom!
    false
??
    match types.rows[receiver]
        | .type-class(row)
            row.module == array.module && row.decl == array.decl && row.args.count == 2
        ??
            false

.. array = types.array-decl

────────────────────
_ do check-constructor-fills

. filling [SlotId]
. owner-module = program.modules[module]
. owner = 0u32
. args = RowRange'ArgumentShape()
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        owner = fn.owner
        args = fn.args
if owner == 0
    =
if names-given()
    decline(frame.declaration.body)
    =
. position = 0u32
for shape in owner-module.arg-pool[args]
    . name = pattern-name(types, tree, shape.pattern)
    if name && !redefaults(position)
        . property = owner-property(program, module, owner, name)
        if property != 0
            fill-property(name, property, argument-slot(position), shape.pattern)
        else
            fill-inherited(name, argument-slot(position), shape.pattern)
    position += 1
for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . slot = declaring-slot(row.left) if row.is-lazy
            if slot
                . name = bindings.slots[slot].name
                . property = owner-property(program, module, owner, name)
                if declared-property && is-typed(row.left)
                    frame.diagnose
                        - row.left
                        - .stated
                        - program.store-atom("Illegal to redefine property type")
                    =
                .. declared-property = property != 0 || types.property-named(frame.self-type, name)
                if property != 0
                    read-slot(slot)
                    fill-property(name, property, slot, row.right)
                    filling += slot
                else if types.property-named(frame.self-type, name)
                    read-slot(slot)
                    fill-inherited(name, slot, row.right)
                    filling += slot
if fills-share(filling)
    instances.rows[instance].fills-share = true
if frame.declaration.kind == .constructor-decl && !returns-own(tree, frame.declaration.body)
    check-initializer-reads()

────────────────────
_ do names-given Bool

` Whether the body of a constructor names a property a markup element gives it the value
` of: the name is then a constant that holds the value, which has no shape here yet.
. given = instances.rows[instance].fills
. body = frame.declaration.body
if given.count == 0 || body == 0
    = false
for node in tree.subtree-start(body) .. < body
    . name Atom? = null
    do match? tree.nodes[node]
        | .node-identifier(row)
            name = row.name
        | .node-ref-identifier(row)
            name = row.name
        | .node-declare(row)
            . slot = declaring-slot(row.left)
            if slot
                name = bindings.slots[slot].name
    if name
        for offset in 0 .. < given.count
            if types.properties[instances.fill-places[given.start + offset]].name == name
                = true
= false

────────────────────
_ do fills-share Bool
    - filling [SlotId]

` Whether the lazy locals a constructor gives its properties their values from, or the lazy
` locals their values read in turn, are captured by nested functions or make one.
. seen [SlotId]
. pending [SlotId]
for slot in filling
    pending += slot
while pending.length != 0
    . slot = pending.pop()
    if seen.find(slot) != null
        continue
    seen += slot
    . row = bindings.slots[slot]
    if (row.flags /and/ SlotFlag.slot-captured) != 0
        = true
    . value = lazy-value(row.group)
    if value == 0
        continue
    for node in tree.subtree-start(value) .. < value + 1
        do match? tree.nodes[node]
            | .node-function-syntax
                = true
            | .node-identifier
                . resolution = bindings.resolution-of(frame.binding, node)
                if resolution.kind == .resolve-slot && lazy-slot
                    pending += resolution.slot
                .. lazy-slot = bindings.slots[resolution.slot].kind == .slot-lazy
= false

────────────────────
_ lazy-value SyntaxId
    - declaration SyntaxId

` The value a lazy local is declared with.
match tree.nodes[declaration]
    | .node-declare(row)
        row.right
    ??
        0

────────────────────
_ is-typed Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type != 0
    ??
        false

────────────────────
_ do check-initializer-reads

` A field's initializer runs before the constructor's body, so one that reads a field the body
` assigns would read it from before the assignment: an error, at the read. The body assigns a
` field by its name or through `this`, apart from nested functions, `for ... on` loops and the
` names it declares.
. assigned [Atom]
. declared [Atom]
for statement in tree.children[body-statements()]
    if !is-lazy-declare(statement)
        collect-assigned(statement, assigned, declared)
. fields [Atom]
for name in assigned
    if declared.find(name) == null && types.property-named(frame.self-type, name)
        fields += name
if fields.length == 0
    =
for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . name = pattern-name(types, tree, row.left) if row.is-lazy
            if name && types.property-named(frame.self-type, name)
                . read = field-read(row.right, fields)
                if read != 0
                    . field = field-reference(read)!
                    . assigns = "before the constructor body assigns it"
                    . runs = "constructor .. initializers run before the body"
                    . text = "Initializer of ${name.text} reads ${field.text} $assigns; $runs"
                    frame.diagnose(read, .stated, program.store-atom(text))
                    =

────────────────────
_ do collect-assigned
    - id SyntaxId
    - assigned [Atom]
    - declared [Atom]

do match? tree.nodes[id]
    | .node-function-syntax
        =
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                if loop.is-subscriber
                    =
    | .node-declare(row)
        . name = pattern-name(types, tree, row.left)
        if name
            declared += name
    | .node-assign(row)
        collect-target(row.lhs, assigned)
        collect-assigned(row.rhs, assigned, declared)
        =
for child in tree.children-of(id)
    collect-assigned(child, assigned, declared)

────────────────────
_ do collect-target
    - target SyntaxId
    - assigned [Atom]

. name = field-reference(target)
if name
    assigned += name
    =
do match? tree.nodes[target]
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            collect-target(item, assigned)

────────────────────
_ do field-read SyntaxId
    - id SyntaxId
    - fields [Atom]

` The first read, in the order its value is evaluated, of one of the fields named.
do match? tree.nodes[id]
    | .node-function-syntax
        = 0
for child in tree.children-of(id)
    . found = field-read(child, fields)
    if found != 0
        = found
. name = field-reference(id)
= if name && fields.find(name) != null then id else 0

────────────────────
_ do field-reference Atom?
    - id SyntaxId

` The name of a field a node may name: an identifier, or a member read from `this`.
do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name
    | .node-get-expression(row)
        if names-receiver(row.object)
            = row.name
= null

────────────────────
_ body-statements RowRange'SyntaxId

match tree.nodes[frame.declaration.body]
    | .node-block(row)
        row.body
    ??
        RowRange'SyntaxId()

────────────────────
_ do is-constructor-initializer Bool
    - name Atom

for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . slot = declaring-slot(row.left) if row.is-lazy
            if slot && bindings.slots[slot].name == name
                = true
= false

────────────────────
_ do fill-inherited
    - name Atom
    - slot SlotId
    - value-syntax SyntaxId

` An argument or a lazy local named as a property a base class declares gives that property
` its value too. Its conversion to the property's type is recorded at the value: the type
` written for the property, or else the type of the value written for it.
. found = types.property-named(frame.self-type, name)
if !found
    =
. given = frame.known(slot)
if given == no-type || given == invalid-type
    =
facts.record-fill(FillFact(instance, name, slot, value-syntax))
. fact = types.properties[found]
. declared = fact.type
if declared == no-type && fact.storage-kind != .storage-getter
    declared = demand-member(fact, frame.self-type, name)
. filled = types.optional-inner(given)
if declared != no-type && declared != invalid-type && declared != filled
    conversions.convert(value-syntax, value-syntax, filled, declared, .reason-assignment)

────────────────────
_ do fill-property
    - name Atom
    - property DeclId
    - slot SlotId
    - value-syntax SyntaxId

` An argument named as a property the class declares gives the property its value. Its
` conversion to the property's type is recorded at the property: the type written, or the one
` a class above gave the property, or else the type of the value written for it.
. given = frame.known(slot)
if given == no-type || given == invalid-type
    =
do match? program.modules[module].decls[property]
    | .decl-property(row)
        facts.record-fill(FillFact(instance, name, slot, row.syntax))
        . declared = invalid-type
        . held = types.property-named(frame.self-type, name)
        . above = if held then first-type(types.properties[held], name) else no-type
        if row.type-syntax != 0
            declared = types.evaluate-type(module, tree, row.type-syntax, frame.env)
        else if above != no-type
            declared = above
        else if row.value != 0
            declared = literal-type(types, module, tree, row.value, frame.env)
        . filled = types.optional-inner(given)
        if declared != invalid-type && declared != filled
            conversions.convert(row.syntax, value-syntax, filled, declared, .reason-assignment)

────────────────────
_ do check-property-defaults
    - receiver TypeId

` Types the values of the stored properties a constructor is not given, which it evaluates,
` so the errors an eager one lets out leave the constructor, at its class. Those of one that
` reads something tracked leave the function its live action evaluates it again with too,
` which gives them to the global `unhandled-error` (`hands-off`), as the reference's live action
` does; where that is not in place it is declined. A tuple's
` constructor given some fields is given them by position or by name, which its instance does
` not tell: each call types the values of the fields it leaves out (`check-field-default`).
live-owned = false
if receiver == no-type || receiver == invalid-type
    = 
types.complete(receiver)
. some = frame.declaration.kind == .tuple-constructor-decl && given-args
    .. given-args = instances.signatures[instance].args.count != 0
for property in types.properties-of(receiver)
    . given = property.slot != U32.max && some
    if property.storage-kind != .storage-getter && !given
        last-unit = no-instance
        demand-member(property, receiver, property.name, true)
        if property.storage-kind == .storage-eager && last-unit != no-instance && live-unit
            live-owned = true
            demand-errors(last-unit)
            if instances.signatures[last-unit].errors.count != 0 && !hands-off(last-unit)
                decline(owner-syntax())
        .. live-unit = instances.rows[last-unit].is-live
        if property.storage-kind == .storage-eager && last-unit != no-instance && other-unit
            note-unit-errors(last-unit, owner-syntax())
            if !supplies(property.name)
                note-default-use(last-unit)
            check-shared-machine(property, receiver)
        .. other-unit = last-unit != instance
    if property.storage-kind == .storage-eager && !given
        construct-default(property, receiver)

────────────────────
_ do check-shared-machine
    - property TypeProperty
    - receiver TypeId

` A class runs the machine a property of it holds, and each machine that one refines, each typed
` for the class above it that declares it, and runs the groups at the root of each from its table
` where that class does (`lowers-for`). Where a section, a constructor or another machine of the
` class or of one between hears the event of such a group, that choice does not hold for it, and
` the class has no shape here.
if !intrinsic-is-class(types.intrinsic-of(receiver))
    =
. current = holding-type(receiver, declaring-class(types, property.owner, property.name))
while current != no-type
    . typed = current
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    . declared = if named-level then class-property(level, property.name) else 0
        .. named-level = level.module != 0 || level.decl != 0
    if declared == 0
        continue
    . owner-tree = program.modules[level.module].tree
    . machine = owner-tree.declared-machine(declared-value(level.module, declared))
    if machine == 0
        =
    if typed == receiver
        continue
    for head in owner-tree.group-heads(owner-tree.state-items(owner-tree.state-body(machine)))
        . written = owner-tree.group-stream(head)
        . event = own-event(typed, level.module, written)
        if !event
            continue
        . theirs = lowers-for(typed, level.module, written, event)
        . mine = lowers-for(receiver, level.module, written, event)
        if theirs != null && (mine == null || mine != theirs)
            decline(owner-syntax())
            =

────────────────────
_ supplies Bool
    - name Atom

` Whether a constructor gives a property its value: a parameter of its name, a lazy local of its
` name, or an attribute a markup element gives. A value that may be null gives none, as the
` property then holds what its class writes. A tuple's constructor given no field gives none.
|? frame.declaration.kind == .tuple-constructor-decl
    false
|? is-constructor-initializer(name)
    true
|? position != U32.max
    !redefaults(position) && !types.is-optional(frame.known(argument-slot(position)))
??
    filled != U32.max && !types.is-optional(instances.argument-type(instance, filled))

.. position = constructor-parameter(name)
.. filled = instances.fill-argument(instance, name)

────────────────────
_ redefaults Bool
    - position U32

` Whether a constructor leaves the property its parameter at a place names to the default the
` class it makes writes (`Instance.redefaults`).
position < 32 && (instances.rows[instance].redefaults /and/ (1u32 /lshift/ position)) != 0

────────────────────
_ do note-default-use
    - unit InstanceId

` Records the value a type writes for a property, which `unit` types, where a constructor of the
` type takes it as written (`DeclaredValueFact`).
. row = instances.rows[unit]
if row.module != module || row.initializer == 0
    =
do match? program.modules[row.module].decls[row.initializer]
    | .decl-property(property)
        if property.type-syntax != 0 && property.value != 0
            . declared = instances.signatures[unit].declared-returns
            . found = instances.signatures[unit].returns
            note-declared-value
                - 0
                - row.initializer
                - property.value
                - property.type-syntax
                - declared
                - found

────────────────────
_ do holding-type TypeId
    - receiver TypeId
    - ref DeclRef

` The class of a declaration among a class and its bases, as the class holds it: with the
` type arguments the class gives it. The class itself when it has no such base.
. current = receiver
while current != no-type
    . held = class-ref(types, current)
    if held.module == ref.module && held.decl == ref.decl
        = current
    current = types.base-of(current) ?? no-type
= receiver

────────────────────
_ do construct-default
    - fact TypeProperty
    - receiver TypeId

` A stored property with no value written, which the constructor is given none for, holds
` what its type constructs with no argument. The construction is recorded at the property,
` when the constructor's own module declares it. A constructor of another module has no
` place in its own source for it, so the construction is typed there by an instance of its
` own for the receiver, as a value written for the property is, and the constructor lets out
` its errors at its class and may panic where it may. The first values of a named tuple's or
` struct's fields are typed too, which emission gives the fields where the value is made.
. ref = declaring-class(types, fact.owner, fact.name)
if fact.type == no-type || fact.type == invalid-type || names-element(types, fact)
    =
. tuple = if ref.decl == 0 then written-tuple(types, receiver, fact.owner) else DeclRef(0, 0)
if tuple.decl != 0
    ref = tuple
. elsewhere = ref.module != module
if !writes-value(fact)
    demand-first-values(fact.type)
if gives-every-value(fact.name) || is-constructor-initializer(fact.name)
    =
if tuple.decl != 0
    if !elsewhere
        construct-value(written-field(program, tuple, fact.name), fact.type)
    =
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
. place = owner-module.first-member(members, fact.name)
while place != no-member
    . member = owner-module.member-pool[place]
    place = owner-module.member-links[place]
    do match? owner-module.decls[member]
        | .decl-property(row)
            if row.name && row.name == fact.name
                if row.value != 0 || row.syntax == 0
                    =
                if row.line == 0 && rejects-default-cycle(ref.module, row.syntax, fact)
                    =
                if !elsewhere
                    construct-value(row.syntax, fact.type)
                    =
                if !is-constructed(fact.type)
                    =
                . unit = instances.intern-initializer(ref.module, member, receiver)
                if instances.rows[unit].state == .instance-unstarted
                    instances.signatures[unit].declared-returns = fact.type
                do demand-initializer(unit, row.syntax)
                replay-member(unit)
                note-unit-errors(unit, owner-syntax())
                =

────────────────────
_ do rejects-default-cycle Bool
    - owner ModuleId
    - site SyntaxId
    - fact TypeProperty

=? false if parameter || instances.fill-argument(instance, fact.name) != U32.max
.. parameter = is-constructor-parameter(fact.name)
=? false if !defaults-class(fact)
. path-types [TypeId]
. path-properties [TypeProperty]
. done = Map'TypeId'Bool()
. found = default-cycle-from(fact.type, path-types, path-properties, done)
=? false if found == U32.max
. steps [String]
for index in found .. < path-types.length
    . property = path-properties[index]
    steps += "${holder-name}.${property.name.text} builds ${type-short-name(types, property.type)}"
        .. holder-name = type-short-name(types, path-types[index])
. message = "Default of ${fact.name.text} never finishes: ${", and ".join(steps)} again. Give one of these fields a value, make it lazy with :=, or make it optional"
facts.record-diagnostic(instance, owner, site, .stated, program.store-atom(message))
= true

────────────────────
_ do default-cycle-from U32
    - type TypeId
    - path-types [TypeId]
    - path-properties [TypeProperty]
    - done Map'TypeId'Bool

for index in 0 .. < path-types.length
    =? index as U32 if path-types[index] == type
=? U32.max if done has type
if builds-defaults(type)
    . fields [TypeProperty]
    for property in types.properties-of(type)
        if defaults-class(property)
            fields += property
    for property in fields
        path-types += type
        path-properties += property
        . found = default-cycle-from(property.type, path-types, path-properties, done)
        =? found if found != U32.max
        path-types.pop()
        path-properties.pop()
done[type] = true
= U32.max

────────────────────
_ do builds-defaults Bool
    - type TypeId

=? false if types.intrinsic-of(type) != .class || is-markup-query(type)
types.complete(type)
. current = type
while current != no-type
    . ref = class-ref(types, current)
    =? false if ref.module == 0 && ref.decl == 0
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            =? false if class.content != 0
            if current == type
                for member in owner.member-pool[class.members]
                    do match? owner.decls[member]
                        | .decl-function(function)
                            =? false if function.kind == .constructor-decl && bare-written
                            .. bare-written = !function.is-generated && function.required-count == 0
    current = types.base-of(current) ?? no-type
= true

────────────────────
_ defaults-class Bool
    - property TypeProperty

|? property.storage-kind != .storage-eager || untyped
    false
|? types.intrinsic-of(property.type) != .class || is-markup-query(property.type)
    false
??
    !names-element(types, property) && !writes-value(property)

.. untyped = property.type == no-type || property.type == invalid-type

────────────────────
_ is-markup-query Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        types.ancestor-decl.refers-to(row.module, row.decl) || descendant-query

        .. descendant-query = types.descendants-decl.refers-to(row.module, row.decl)
    ??
        false

────────────────────
_ is-constructed Bool
    - type TypeId

` Whether a value of a type with no value written is what the type constructs.
kind == .class || kind == .tuple || kind == .struct || kind == .array-builder

.. kind = types.intrinsic-of(type)

────────────────────
_ do writes-value Bool
    - fact TypeProperty

` Whether the nearest class that declares a property writes a value for it.
. ref = declaring-class(types, fact.owner, fact.name)
. member = valued-property(program, ref.module, ref.decl, fact.name)
if member == 0
    = false
do match? program.modules[ref.module].decls[member]
    | .decl-property(row)
        = row.value != 0
= false

────────────────────
_ do demand-case-values
    - table TypeId

` A table of unions starts each row as its first case's first value, and reads a row whose tag
` names no case as that: the values the case writes for its fields are typed with the table.
. row = row-struct-of(table)
if row == no-type || row == invalid-type || types.intrinsic-of(row) != .union
    =
. held = types.cases-of(row)
if held.length != 0 && held[0].type != no-type && held[0].type != invalid-type
    demand-first-values(held[0].type)

────────────────────
_ do demand-first-values
    - type TypeId
    - seen [TypeId] = List'TypeId()

` Types the values a named tuple or struct writes for its fields, and those of the named
` tuples and structs its fields hold with no value written.
=? if seen.find(type) != null
seen += type
if types.is-optional(type)
    demand-first-values(types.optional-inner(type), seen)
    =
. kind = types.intrinsic-of(type)
if kind == .union
    for case in types.cases-of(type)
        if case.type != no-type && case.type != invalid-type
            demand-first-values(case.type, seen)
    =
. ref = class-ref(types, type)
if (kind != .tuple && kind != .struct && kind != .array-builder) || unnamed
    =
.. unnamed = ref.module == 0 && ref.decl == 0
types.complete(type)
for property in types.properties-of(type)
    if property.storage-kind == .storage-getter
        continue
    if writes-value(property)
        demand-member(property, type, property.name, true)
    else if property.storage-kind == .storage-eager && typed-property
        demand-first-values(property.type, seen)
    .. typed-property = property.type != no-type && property.type != invalid-type

────────────────────
_ do construct-value
    - site SyntaxId
    - type TypeId

if site == 0 || type == no-type || type == invalid-type || !is-constructed(type)
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.construction-on(site, type, arguments, false)

────────────────────
_ is-constructor-parameter Bool
    - name Atom

constructor-parameter(name) != U32.max

────────────────────
_ gives-every-value Bool
    - name Atom

parameter != U32.max && !types.is-optional(instances.argument-type(instance, parameter))

.. parameter = constructor-parameter(name)

────────────────────
_ do constructor-parameter U32
    - name Atom

` The place among a constructor's parameters of the one of a name, or `U32.max`.
. owner-module = program.modules[module]
. position = 0u32
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        for shape in owner-module.arg-pool[fn.args]
            . named = pattern-name(types, tree, shape.pattern)
            if named && named == name
                = position
            position += 1
= U32.max

────────────────────
_ do refines-in-progress Bool
    - ref DeclRef
    - name Atom
    - receiver TypeId

` Whether a class above the one a property is declared in declares a property of the name whose
` value is being typed, for that class as a receiver holds it.
. above = false
. current = receiver
while current != no-type
    . held = current
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    if level.module == ref.module && level.decl == ref.decl
        above = true
        continue
    . declared = if above then class-property(level, name) else 0
    if declared != 0
        . unit = instances.intern-initializer(level.module, declared, held)
        if instances.rows[unit].state == .instance-in-progress
            = true
= false

────────────────────
_ do content-property-type TypeId
    - ref DeclRef
    - line SyntaxId

` The type of the property a line of a class's markup declares (`content-property`): that of the
` value the line gives it, as each function that fills an object with the markup typed it, which
` must agree, as the reference gives the property the type of the first value stored. Where none
` has typed the line yet, a filler or constructor of the class still waiting in the queue is typed
` first, one at a time, until one has (`pending-filler`). None where none is left.
. owner-module = program.modules[ref.module]
. filler DeclId = 0
do match? owner-module.decls[ref.decl]
    | .decl-class(class)
        filler = class.content-function
. value SyntaxId = 0
do match? owner-module.tree.nodes[line]
    | .node-property-syntax(row)
        value = row.value
if filler == 0 || value == 0
    = invalid-type
while true
    . found = no-type
    for unit in 0u32 .. < (instances.rows.length as U32)
        . row = instances.rows[unit]
        if row.module == ref.module && row.decl == filler
            . typed = facts.node-type(unit, value)
            if typed != no-type && typed != invalid-type
                if found != no-type && found != typed
                    = invalid-type
                found = typed
    if found != no-type
        = found
    . pending = pending-filler(ref, filler)
    if pending == no-instance
        = invalid-type
    demand-body(pending)

────────────────────
_ do projection-type TypeId
    - ref DeclRef
    - node SyntaxId
    - receiver TypeId

` The type of the property that projects a case of a machine of a class's markup that holds a
` value: the optional of what the case holds in the machine's union, as each function that fills
` an object with the markup typed the machine, which must agree. Where none has typed it yet, a
` filler or constructor of the class still waiting in the queue is typed first, one at a time,
` until one has (`pending-filler`), or else one of the class of the object read, or of a class
` between, which runs the class's, or else the class's filler as the object read holds the class,
` given no slots, which only typing reaches then: the instance that fills the object may be
` waiting in no queue yet, or in that of another pass of a parallel type pass. None where none is
` left.
. owner-module = program.modules[ref.module]
. owner = owner-module.tree
. filler DeclId = 0
. machine SyntaxId = 0
. position U32? = null
do match? owner-module.decls[ref.decl]
    | .decl-class(class)
        filler = class.content-function
        for written in owner.content-machines(class.content)
            . cases = owner.machine-cases(owner.state-items(owner.state-body(written)))
            if cases.find(node) != null
                machine = written
                position = owner.case-position(cases, owner.state-name(node)!)
if filler == 0 || machine == 0 || position == null
    = invalid-type
. own = false
while true
    . found = no-type
    for row in facts.machines
        . same = row.module == ref.module && row.syntax == machine && row.outer == 0
        if same && instances.rows[instances.rows[row.instance].enclosing].decl == filler
            . held = no-type
            do match? types.rows[row.union]
                | .type-named-union(union)
                    held = types.optional-of(types.child-type(union.cases, position))
            if found != no-type && found != held
                = invalid-type
            found = held
    if found != no-type
        = found
    . pending = pending-filler(ref, filler)
    . level = receiver
    while pending == no-instance && level != no-type
        . below = class-ref(types, level)
        if below.module == ref.module && below.decl == ref.decl
            break
        level = types.base-of(level) ?? no-type
        do match? program.modules[below.module].decls[below.decl]
            | .decl-class(class)
                pending = pending-filler(below, class.content-function)
    if pending == no-instance && !own
        own = true
        . slots [Atom]
        . builders [TypeId]
        pending = calls.filler-instance(holding-type(receiver, ref), slots, builders)
    if pending == no-instance
        = invalid-type
    demand-own-body(pending)

────────────────────
_ do pending-filler InstanceId
    - ref DeclRef
    - filler DeclId

` An instance waiting in the queue whose body would fill an object of a class with its markup:
` the class's filler, or else a constructor of the class, which calls it. None where none waits.
. owner-module = program.modules[ref.module]
. constructor = no-instance
for unit in 0u32 .. < (instances.rows.length as U32)
    . row = instances.rows[unit]
    if row.module != ref.module || row.state != .instance-unstarted
        continue
    if row.decl == filler
        = unit
    if constructor == no-instance
        do match? owner-module.decls[row.decl]
            | .decl-function(fn)
                if fn.owner == ref.decl && is-constructor-kind(fn.kind)
                    constructor = unit
= constructor

────────────────────
_ do first-type TypeId
    - fact TypeProperty
    - name Atom

` The type a stored property has from a class above the one that declares it again, or no
` type when no class above stores it. A class that gives a stored property of its base a new
` value does not give it a new type: the value is converted to the type the property already
` has. That type is worked out for the class above itself, once, whatever class below asks
` for it. A lazy property declared again is another function, with the type of its own value.
if fact.storage-kind != .storage-eager
    = no-type
. current = fact.owner
while current != no-type
    . ref = class-ref(types, current)
    . is-class = ref.module != 0 || ref.decl != 0
    . declares = is-class && owner-property(program, ref.module, ref.decl, name) != 0
    current = types.base-of(current) ?? no-type
    if declares
        break
if current == no-type
    = no-type
. found = types.property-named(current, name)
if !found
    = no-type
. above = types.properties[found]
if above.storage-kind != .storage-eager
    = no-type
. given = above.type
if given == no-type
    given = demand-member(above, current, name, false, true)
= if given == invalid-type then no-type else given

────────────────────
_ is-accessor Bool
    - receiver TypeId
    - name Atom

if found then types.properties[found].storage-kind == .storage-getter else inherited

.. found = types.property-named(receiver, name)
.. inherited = types.intrinsic-of(receiver) == .class && interface-accessor(receiver, name) != null

────────────────────
_ do infer-call Found
    - id SyntaxId
    - callable SyntaxId
    - params RowRange'SyntaxId
    - args RowRange'SyntaxId
    - curried Bool
    - attributes SyntaxId = 0
    - class TypeId = no-type
    - want Want = Want()
    - slots ImmutableArray'Atom'ArenaBacking = ImmutableArray'Atom'ArenaBacking()
    - builders ImmutableArray'TypeId'ArenaBacking = ImmutableArray'TypeId'ArenaBacking()
    - context U32 = U32.max

` A call written with its arguments. A markup element gives, after them, the value of each
` of the `attributes` its body writes for the `class` it makes, as an argument named as the
` property and marked as one, and its constructor the `slots` its body fills, each with the type
` of its builder (`builders`), and the `context` of the styles it sees. The arguments of a call of a name nothing declares are typed as
` the reference types them before it finds no function (`names-nothing`).
. owner = if want.asks(.want-owner) then held-type(want.type) else no-type
. params-start = scratch.types.mark
. param-count = 0
. unresolved = false
for param in tree.children[params]
    . written = types.evaluate-type(module, tree, param, frame.env)
    unresolved = unresolved || written == invalid-type
    scratch.types.push(written)
    param-count += 1
. listing = tree.listed-bullets(id)
=? Found(infer-listed-bullets(id, callable, listing)) if listing != 0
if args.count == 1
    do match? tree.nodes[callable]
        | .node-type-arguments
            . only = tree.children[args.start]
            expect-bullets(only, types.evaluate-type(module, tree, callable, frame.env))
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. object = if attributes != 0 then CalledObject() else type-called-object(callable, args.count)
. outer-unknown = argument-typing
. kept-mark = kept-arguments.length
argument-typing = argument-typing.unknown-callee = attributes == 0 && names-nothing(callable, args)
argument-typing = argument-typing.keeps = true
for arg in tree.children[args]
    do match tree.nodes[arg]
        | .node-argument(argument)
            scratch.types.push(infer-argument(argument.expr, argument-symbol(argument.expr)))
            scratch.call-arguments.push
                - argument-shape(argument.name, argument.is-optional, argument.expr)
            scratch.syntax.push(arg)
        ??
            scratch.types.push(infer-argument(arg, argument-symbol(arg)))
            scratch.call-arguments.push(argument-shape(null, false, arg))
            scratch.syntax.push(arg)
argument-typing = outer-unknown
. given = attributes == 0 || push-attributes(attributes, class)
. missing = given && unresolved && report-missing-params(params)
. params = scratch.types.span(params-start, param-count)
. arguments = arguments-since(shapes-start, types-start, syntax-start, params, curried, 0, slots, builders, context)
called-object = object
. result = if given && !missing then infer-callable(id, callable, arguments, owner) else Found(invalid-type)
settle-kept-arguments(kept-mark, result.type)
called-object = CalledObject()
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
=? Found(invalid-type) if result.type != invalid-type && tracks-method(id, callable)
= result

────────────────────
_ do tracks-method Bool
    - id SyntaxId
    - callable SyntaxId

` Reports a method called with "#" before its name, as in `c.#size()`, which tracks nothing, as
` only a stored property is tracked, and says whether it did.
. name Atom? = null
do match? tree.nodes[callable]
    | .node-get-expression(get)
        name = get.name if get.is-tracked
    | .node-identifier(ident)
        name = ident.name if ident.is-tracked
if !name
    = false
. fact = facts.first-call(instance, id)
while fact != no-fact
    if facts.calls[fact].form == .call-method
        . text = "\"${name.text}\" is a method, so \"#\" before it tracks nothing; track the properties it reads instead"
        frame.diagnose(callable, .stated, program.store-atom(text))
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ do report-missing-params Bool
    - params RowRange'SyntaxId

` Reports the first type written after a call's name that names nothing, as the reference does
` once it has typed the arguments. Says whether one was reported.
for param in tree.children[params]
    if report-missing-type(param, frame.env)
        = true
= false

────────────────────
_ do names-nothing Bool
    - callable SyntaxId
    - args RowRange'SyntaxId

` Whether a call names a function nothing declares, which the reference reports once it has typed
` the arguments: a name alone the binder resolves to nothing, of no type parameter, that the
` module reaches no declaration of, called where there is no receiver whose members it could
` name, with no symbol among its arguments whose union's module it could be looked for in.
. name = identifier-name(tree, callable)
if !name || frame.self-type != no-type || resolved
    = false
.. resolved = bindings.resolution-of(frame.binding, callable).kind != .resolve-unresolved
if types.env-lookup(frame.env, name)
    = false
for _ in program.lookup(module, name)
    = false
for arg in tree.children[args]
    . written = match tree.nodes[arg]
        | .node-argument(argument)
            argument.expr
        ??
            arg
    if argument-symbol(written)
        = false
= true

────────────────────
_ do type-called-object CalledObject
    - callable SyntaxId
    - count Size

` Types the object of a method a call names, which the reference evaluates before the call's
` arguments, so that what the flow knows of it is what it knew before them. The call is
` settled with it once its arguments are typed (`infer-callable`). A type a static method is
` called on is no value, and nothing is typed of it here.
do match? tree.nodes[callable]
    | .node-get-expression(get)
        if static-owner(get.object) != no-type
            = CalledObject()
        . writes = get.name.text == "<-write" && count == 1
        . rekeys = get.name.text == "rekey" && count == 1
        . asks-event = (writes || rekeys || (get.name.text == "release" && count == 0)) && !get.is-optional
        . want = Want().adding(.want-receiver)
        . receiver = infer-found(get.object, if asks-event then want.adding(.want-event) else want)
        = CalledObject(get.object, receiver.type, receiver.link, found-event-of(receiver))
= CalledObject()

────────────────────
_ arguments-since Arguments
    - shapes-start ScratchMark
    - types-start ScratchMark
    - syntax-start ScratchMark
    - params ImmutableArray'TypeId'ArenaBacking
    - curried Bool = false
    - piped SyntaxId = 0
    - slots ImmutableArray'Atom'ArenaBacking = ImmutableArray'Atom'ArenaBacking()
    - builders ImmutableArray'TypeId'ArenaBacking = ImmutableArray'TypeId'ArenaBacking()
    - context U32 = U32.max

` The arguments pushed on the scratch stacks since the marks, with any explicit type arguments,
` the call a value is piped into (`piped`), and what a markup element gives its constructor apart
` from them.
Arguments(shapes, arg-types, syntax, params, curried, piped, slots, builders, context)

.. shapes = scratch.call-arguments.since(shapes-start)
.. arg-types = scratch.types.since(types-start)
.. syntax = scratch.syntax.since(syntax-start)

────────────────────
_ do infer-callable Found
    - id SyntaxId
    - callable SyntaxId
    - arguments Arguments
    - owner TypeId = no-type

for type in arguments.types
    if type == invalid-type
        = Found(invalid-type)
do match? tree.nodes[callable]
    | .node-c-identifier(row)
        = Found(calls.c-call(id, row.name, arguments))
    | .node-type-identifier(row)
        . is-this = types.this-atom && row.name == types.this-atom
        if is-this || bindings.resolution-of(frame.binding, callable).kind != .resolve-type
            = Found(construct-type(id, callable, arguments))
    | .node-type-arguments
        if bindings.resolution-of(frame.binding, callable).kind != .resolve-type
            = Found(construct-type(id, callable, arguments))
    | .node-type-associated
        = Found(construct-type(id, callable, arguments))
    | .node-symbol(row)
        if owner != no-type
            = Found(calls.static-call(id, owner, row.name, arguments))
        . anonymous = anonymous-symbol(callable, row.name)
        if anonymous == invalid-type
            = Found(invalid-type)
        if anonymous != no-type
            = Found(calls.static-call(id, anonymous, row.name, arguments))
        if calls.ambiguous-case(callable, row.name)
            = Found(invalid-type)
        . named = symbol-class(types, module, row.name)
        if named == invalid-type
            frame.diagnose
                - id
                - .stated
                - program.store-atom("Unable to resolve symbol .${row.name.text}")
            = Found(invalid-type)
        = Found(calls.static-call(id, named, row.name, arguments))
    | .node-get-expression(get)
        . owner = static-owner(get.object)
        if owner != no-type
            = Found(call-static(id, get.object, owner, get.name, arguments))
        . typed = called-object
        called-object = CalledObject()
        if typed.object != get.object
            typed = type-called-object(callable, arguments.types.length)
        . receiver = typed.type
        if typed.event
            . event = typed.event
            . writes = get.name.text == "<-write" && arguments.types.length == 1
            . rekeys = get.name.text == "rekey" && arguments.types.length == 1
            if writes
                = Found(publish-event(id, get.object, event, arguments))
            = Found(readdress-event(id, get.object, event, arguments, rekeys))
        . own = typed.link
        if receiver == invalid-type
            = Found(invalid-type)
        if is-super-syntax(get.object) && receiver != frame.self-type
            conversions.convert(id, id, frame.self-type, receiver, .reason-receiver)
        . source = projected-from(get.object, receiver)
        if source != no-type && !calls.has-method(receiver, get.name, arguments)
            receiver = source
        . form = if get.is-optional then note-chain(id, callable, receiver) else plain-form
            .. plain-form = ChainForm.chain-plain
        if form == .chain-absent || absent-after(get.object, receiver)
            = Found(types.null-type)
        . optional = form == .chain-tested
        . held = link-receiver(get.object, receiver, own, optional)
        if !optional && !(optional-chained(get.object) && types.is-optional(receiver))
            if calls-property(get.object, receiver, get.name, arguments)
                . value = read-property(callable, get.object, receiver, get.name).type
                if value == invalid-type
                    = Found(value)
                facts.set-node-type(instance, callable, value)
                = Found(call-value(id, callable, value, arguments))
            . answered = calls.method-call(id, get.object, receiver, get.name, arguments, true, row-capture-of(get.object))
            if answered != invalid-type && types.intrinsic-of(receiver) == .table
                . op = table-member(get.name.text)
                if op != TableOp.table-row && op != TableOp.table-mark && not-capacity
                    plan-table(id, op)
                .. not-capacity = op != TableOp.table-capacity
            if answered != invalid-type
                plan-builder(id, receiver, get.name.text, arguments.types.length)
            if answered == types.void-type && get.name.text == "<-write"
                = Found(receiver)
            = Found(answered)
        if optional
            facts.unwrapped.append(UnwrappedFact(instance, get.object, held))
        . result = calls.method-call(id, get.object, held, get.name, arguments, true)
        if result == invalid-type || types.is-optional(result)
            = Found(result).linking(result)
        = Found(types.optional-of(result)).linking(result)
if is-super-syntax(callable) || names-super(callable)
    = Found(super-call(id, callable, arguments))
. resolution = bindings.resolution-of(frame.binding, callable)
do match resolution.kind
    |= .resolve-function
        . name = identifier-name(tree, callable)
        if !name
            decline(id)
            = Found(invalid-type)
        if in-eager() && is-method(resolution.module, resolution.decl)
            frame.diagnose
                - id
                - .stated
                - program.store-atom(eager-call-message(name, resolution.module, resolution.decl))
            = Found(invalid-type)
        . answered = calls.function-call(id, name, arguments)
        if answered != invalid-type && is-method(resolution.module, resolution.decl)
            plan-builder(id, frame.self-type, name.text, arguments.types.length)
        = Found(answered)
    |= .resolve-type
        . called = identifier-name(tree, callable)
        if called && types.this-atom && called == types.this-atom
            = Found(construct-type(id, callable, arguments))
        if types.const-array-decl.refers-to(resolution.module, resolution.decl)
            = Found(construct-type(id, callable, arguments))
        if resolution.module == types.table-module && !is-row-table(callable, arguments)
            = Found(invalid-type)
        . (class-module, class-decl) = taking-class(callable, resolution.module, resolution.decl)
        = Found(calls.construction(id, callable, class-module, class-decl, arguments))
    |= .resolve-slot
        if bindings.slots[resolution.slot].getter != 0
            decline(callable)
            = Found(invalid-type)
        if precedes-declaration(resolution.slot)
            frame.diagnose(id, .function-not-found, identifier-name(tree, callable))
            = Found(invalid-type)
        if wavers(resolution.slot)
            decline(id)
            = Found(invalid-type)
        . called = read-slot(resolution.slot, id)
        . declared = slot-known(resolution.slot)
        if declared != called && types.is-optional(declared) && unwraps-called
            facts.set-plan(instance, callable, .plan-callee)
        .. unwraps-called = types.optional-inner(declared) == called
        = Found(call-value(id, callable, called, arguments))
    |= .resolve-member
        . name = identifier-name(tree, callable)
        if !name
            decline(id)
            = Found(invalid-type)
        . held = read-member(callable, name).type
        . key = member-key(resolution.decl)
        . narrowed = if frame.members-narrowed then frame.narrowed-member(key) else no-type
        . declared = if narrowed != no-type then key-declared(key) else no-type
        . unwraps = optional-declared && types.optional-inner(declared) == held
            .. optional-declared = declared != no-type && types.is-optional(declared)
        if held != invalid-type && held == narrowed && (callable-held || unwraps)
            facts.set-plan(instance, callable, .plan-callee)
        .. callable-held = function-row(types, held) != no-type
        = Found(call-value(id, callable, held, arguments))
    |= .resolve-global
        . held = infer-node(callable, Want())
        if held == invalid-type
            = Found(held)
        = Found(call-value(id, callable, held, arguments))
    |= .resolve-unresolved
        . name = identifier-name(tree, callable)
        if !name
            = Found(invalid-type)
        . bound = types.env-lookup(frame.env, name)
        if bound
            = Found(calls.construction-on(id, bound, arguments, true, callable))
        = Found(calls.function-call(id, name, arguments))
    ??
        . target = infer(callable)
        if target == invalid-type
            = Found(target)
        . kind = types.intrinsic-of(target)
        if kind == .closure || kind == .binding || function-row(types, target) != no-type
            = Found(calls.slot-call(id, target, arguments))
        = Found(calls.method-call(id, callable, target, types.call-atom!, arguments))

────────────────────
_ calls-property Bool
    - object SyntaxId
    - receiver TypeId
    - name Atom
    - arguments Arguments

` Whether a call written as a method call reads a property and calls what it holds, as the
` reference does where the receiver has no method of the name but a property or a getter of
` it. A union, a type given as a value, and `super` are called only for their methods.
|? is-super-syntax(object)
    false
|? kind == .union || kind == .type-info || calls.has-method(receiver, name, arguments)
    false
??
    types.property-named(receiver, name) != null || calls.has-getter(receiver, name)

.. kind = types.intrinsic-of(receiver)

────────────────────
_ names-super Bool
    - callable SyntaxId

match tree.nodes[callable]
    | .node-identifier(row)
        row.name.text == "super"
    ??
        false

────────────────────
_ do super-call TypeId
    - id SyntaxId
    - callable SyntaxId
    - arguments Arguments

` `super(...)` runs the base class's constructor: only in a constructor, only as its first
` statement, and only when there is a base.
. self = frame.self-type
. based = self != no-type && self != invalid-type && types.base-of(self) != null
. message = ""
if !based
    message = "super requires a base type"
else if !is-constructor-kind(frame.declaration.kind)
    message = "super constructor call is only allowed in constructors"
else if body-statements().count == 0 || tree.children[body-statements().start] != id
    message = "super constructor call must be first"
if message.length != 0
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
= calls.construction-on(id, super-type(), arguments, false, callable)

────────────────────
_ do call-value TypeId
    - id SyntaxId
    - callable SyntaxId
    - target TypeId
    - arguments Arguments

` A call of what a name holds: a value of a function type is called, and a value of any
` other type is given to the function its type declares for a call of it.
if target == invalid-type || types.completions[target].intrinsic == .closure
    = calls.slot-call(id, target, arguments)
types.complete(target)
. kind = types.completions[target].intrinsic
if kind != .binding && function-row(types, target) == no-type
    = calls.method-call(id, callable, target, types.call-atom!, arguments)
= calls.slot-call(id, target, arguments)

────────────────────
_ type-head SyntaxId
    - id SyntaxId

` The name a type is written with, under the arguments it is given.
match tree.nodes[id]
    | .node-type-arguments(row)
        type-head(row.base)
    ??
        id

────────────────────
_ do names-nothing Bool
    - id SyntaxId

` Whether a name written as a type reaches nothing: no type parameter and no declaration the
` module reaches, which the reference says of a constructor.
. name = type-head-name(tree, id)
if !name || types.env-lookup(frame.env, name)
    = false
for _ in program.lookup(module, name)
    = false
= true

────────────────────
_ do construct-type TypeId
    - id SyntaxId
    - callable SyntaxId
    - arguments Arguments

if names-const-array(callable)
    frame.diagnose(id, .stated, program.store-atom("ConstArray requires one item type"))
    = invalid-type
types.clear-fault()
. receiver = types.evaluate-type(module, tree, callable, frame.env)
if receiver == invalid-type
    if report-circular() || report-fault(callable)
        = invalid-type
    . head = type-head(callable)
    if names-nothing(head)
        frame.diagnose(head, .constructor-not-found)
    else
        decline(id)
    = invalid-type
if is-const-array(receiver)
    . item = cpointer-item(receiver)
    . items [ConstItem]
    . folds = true
    for position in 0 .. < arguments.types.length
        . site = arguments.syntax[position]
        . shape = arguments.shapes[position]
        if shape.name || shape.is-property
            frame.diagnose(site, .stated, program.store-atom("Illegal ConstArray item"))
            = invalid-type
        conversions.convert(site, site, arguments.types[position], item, .reason-argument)
        if is-computed(site)
            . message = program.store-atom("ConstArray item must be constant")
            frame.diagnose(site, .stated, message)
            = invalid-type
        . folded = fold-const-item(site, item)
        if folded
            items += folded
        else
            folds = false
    if folds
        facts.note-const-array(instance, id, receiver, items)
    = receiver
. by-name = true
do match? tree.nodes[callable]
    | .node-type-identifier(row)
        if types.this-atom && row.name == types.this-atom
            by-name = false
            if frame.self-type != no-type
                receiver = frame.self-type
if !check-table-row(receiver, arguments)
    = invalid-type
= calls.construction-on
    - id
    - receiver
    - arguments
    - by-name
    - if tree.nodes[id] is .node-markup then id else callable

────────────────────
_ do fold-const-item ConstItem?
    - site SyntaxId
    - item TypeId

` An item of a ConstArray as TypeScript lays it down: a string literal, or a number folded
` to its bits and cut to the width of an integer item. Nothing for any other.
do match? tree.nodes[site]
    | .node-argument(row)
        = fold-const-item(row.expr, item)
    | .node-string-syntax
        if item == types.string-type
            = ConstItem(0, site)
        = null
. kind = types.completions[item].intrinsic
if !is-integer-kind(kind)
    = null
. folded = fold-number(site)
if !folded.folds
    = null
= ConstItem(cut-bits(folded.bits, item), 0)

────────────────────
_ do fold-number FoldedNumber
    - site SyntaxId

` The integer a literal number is, negated or cast to an integer type, as its bits.
do match? tree.nodes[site]
    | .node-argument(row)
        = fold-number(row.expr)
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if literal.overflow
            = FoldedNumber(0, false)
        = FoldedNumber(if literal.negative then 0 - literal.value else literal.value, true)
    | .node-unary-expression(row)
        if row.op == .negative-op
            . inner = fold-number(row.operand)
            = FoldedNumber(0 - inner.bits, inner.folds)
    | .node-cast-expression(row)
        . inner = fold-number(row.lhs)
        . target = types.evaluate-type(module, tree, row.rhs, frame.env)
        if inner.folds && target != invalid-type && integer-target
            = FoldedNumber(cut-bits(inner.bits, target), true)
        .. integer-target = is-integer-kind(types.completions[target].intrinsic)
= FoldedNumber(0, false)

────────────────────
_ cut-bits U64
    - bits U64
    - type TypeId

` Bits cut to the width of an integer type and extended by its sign.
|? width >= 64 || width == 0
    bits
??
    if negative then kept /or/ (mask /xor/ U64.max) else kept

.. row = types.completions[type]
.. width = row.bit-size as U64
.. mask = (1u64 /lshift/ width) - 1
.. kept = bits /and/ mask
.. negative = row.is-signed && (kept /rshift/ (width - 1)) != 0

────────────────────
_ do taking-class (ModuleId, DeclId)
    - callable SyntaxId
    - named-module ModuleId
    - named DeclId

` The class a callable written with type arguments makes: the one its name resolves to, or where
` that takes fewer type arguments than are written, the first class of the name this module sees
` that takes as many or more, as the reference passes over one that takes fewer.
do match? tree.nodes[callable]
    | .node-type-arguments(row)
        . given Size = row.args.count
        . taken Size = types.class-type-args(named-module, named).count
        . name = types.type-syntax-name(tree, row.base)
        if taken < given && name
            for candidate in program.lookup(module, name)
                do match? program.modules[candidate.module].decls[candidate.decl]
                    | .decl-class
                        . held Size = types.class-type-args(candidate.module, candidate.decl).count
                        if held >= given
                            = (candidate.module, candidate.decl)
= (named-module, named)

────────────────────
_ do is-row-table Bool
    - callable SyntaxId
    - arguments Arguments

` Whether a table named with its row type can lay that row out.
do match? tree.nodes[callable]
    | .node-type-arguments
        . table = types.evaluate-type(module, tree, callable, frame.env)
        if table != invalid-type
            = check-table-row(table, arguments)
= true

────────────────────
_ do check-table-row Bool
    - table TypeId
    - arguments Arguments

` A table lays its rows out in columns, so a row is a struct of eager stored fields with no
` delegated behavior, or a union of such tuples. A table an arena holds cannot hold managed
` pointers, and neither can the packed cases of union rows a table makes storage for, which an
` `ImmutableTable` made over storage that exists does not. Says whether the row can be laid out.
. kind = types.intrinsic-of(table)
if kind != .table && kind != .immutable-table
    = true
. row = row-struct-of(table)
if row == no-type || row == invalid-type || types.completions[row].has-variables
    = true
types.complete(row)
. row-kind = types.intrinsic-of(row)
. held = arguments.types.length != 0 && types.is-arena(arguments.types[0])
. ref = class-ref(types, row)
. site = class-site(ref)
if row-kind == .union
    if !check-union-rows(row, kind == .table && !held)
        = false
    . found = managed-path(row, 0) if held
    if found
        . shown = type-short-name(types, row)
        . path = "${type-key(types, row)}${found}"
        . message = "Arena type $shown contains managed pointers through $path"
        = refuse-row(ref.module, site, message, row)
    = true
if row-kind != .struct
    = refuse-row(ref.module, site, "Table row types must be concrete fixed-layout structs")
if types.delegates-of(row).length != 0
    = refuse-row(ref.module, site, "Table row types cannot use delegated interface behavior")
for index in 0 .. < types.properties-of(row).length
    . property = types.properties-of(row)[index]
    if property.storage-kind != .storage-eager
        . owner = declaring-class(types, property.owner, property.name)
        . written = member-site(types, owner, property.name)
        = refuse-row(owner.module, written, "Table row fields must be eager stored fields")
if held
    . found = managed-path(row, 0)
    if found
        . shown = type-short-name(types, row)
        . message = "Arena type $shown contains managed pointers through $shown${found}"
        = refuse-row(ref.module, site, message)
= true

────────────────────
_ do refuse-row Bool
    - owner ModuleId
    - site SyntaxId
    - message String
    - mentioned TypeId = no-type

facts.record-diagnostic(instance, owner, site, .stated, program.store-atom(message), mentioned)
= false

────────────────────
_ class-site SyntaxId
    - ref DeclRef

match program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        class.syntax
    ??
        0u32

────────────────────
_ do check-union-rows Bool
    - union TypeId
    - creates Bool

` A table of union rows keeps the fields every case shares in columns of their own and packs
` the rest of each case, which must be plain data where the table `creates` that storage itself.
. ref = class-ref(types, union)
. site = class-site(ref)
. count = types.cases-of(union).length
if count == 0
    = refuse-row(ref.module, site, "Table union row types must declare at least one case")
for index in 0 .. < count
    . fact = types.cases-of(union)[index]
    . shown = if fact.name then fact.name!.text else "$index"
    . tuple = !fact.is-default && fact.type != no-type && fact.type != invalid-type
    if !tuple || !intrinsic-is-tuple-like(types.intrinsic-of(fact.type))
        . message = "Table union case '$shown' must use a concrete fixed-layout tuple"
        = refuse-row(ref.module, site, message)
    if types.delegates-of(fact.type).length != 0
        = refuse-row(ref.module, site, "Table union case '$shown' cannot use delegated storage")
    for position in 0 .. < types.properties-of(fact.type).length
        . property = types.properties-of(fact.type)[position]
        if property.storage-kind == .storage-lazy
            . owner = declaring-class(types, property.owner, property.name)
            . written = member-site(types, owner, property.name)
            . message = "Table union case '$shown' cannot use lazy stored fields"
            = refuse-row(owner.module, written, message)
. first = types.cases-of(union)[0].type
for position in 0 .. < types.properties-of(first).length
    . property = types.properties-of(first)[position]
    if is-common-field(types, union, property) && is-hot-field(types, property)
        . owner = declaring-class(types, property.owner, property.name)
        . named = type-short-name(types, union)
        . message = "Table union '$named' common field '${property.name.text}' cannot be @hot "
        message ++= "because it already has a dedicated common column"
        = refuse-row(owner.module, member-site(types, owner, property.name), message)
if !creates
    = true
for index in 0 .. < count
    . fact = types.cases-of(union)[index]
    . shown = if fact.name then fact.name!.text else "$index"
    for position in 0 .. < types.properties-of(fact.type).length
        . property = types.properties-of(fact.type)[position]
        if property.storage-kind != .storage-eager || is-common-field(types, union, property)
            continue
        . stored = eager-type(fact.type, property)
        if stored != no-type && stored != invalid-type && is-managed(stored, 0)
            . owner = declaring-class(types, property.owner, property.name)
            . message = "Table union case '$shown' field '${property.name.text}' contains managed "
            message ++= "pointers through ${type-key(types, stored)}"
            = refuse-row(owner.module, member-site(types, owner, property.name), message, stored)
= true

────────────────────
_ do is-managed Bool
    - type TypeId
    - depth U32

` Whether a value of a type holds a pointer the collector must trace.
if depth > 16 || type == no-type || type == invalid-type
    = false
types.complete(type)
. kind = types.intrinsic-of(type)
if is-numeric(types, type) || kind == .void || kind == .atom || kind == .type-info
    = false
if kind == .cpointer || kind == .cfunction
    = false
if kind == .optional
    = is-managed(types.optional-inner(type), depth + 1)
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        if !fact.is-default && is-managed(fact.type, depth + 1)
            = true
    = false
if intrinsic-is-tuple-like(kind) || is-plain-tuple(type)
    . arity = tuple-arity(type)
    if arity == U32.max
        = true
    for position in 0 .. < arity
        if is-managed(field-of(type, position), depth + 1)
            = true
    = false
= true

────────────────────
_ do has-empty-value Bool
    - type TypeId
    - depth U32

if depth > 16 || type == no-type || type == invalid-type
    = false
types.complete(type)
. kind = types.intrinsic-of(type)
if kind == .optional || kind == .string || kind == .void || intrinsic-is-numeric(kind)
    = true
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        if !fact.is-default && fact.type != no-type && !has-empty-value(fact.type, depth + 1)
            = false
    = true
if kind != .tuple && kind != .struct && !is-plain-tuple(type)
    = false
. arity = tuple-arity(type)
if arity == U32.max
    = false
for position in 0 .. < arity
    if !has-empty-value(field-of(type, position), depth + 1)
        = false
= true

────────────────────
_ do managed-path String?
    - type TypeId
    - depth U32

` The path from a value an arena holds to the first managed pointer it would carry, and none
` when it carries none. A string and a foreign pointer are the arena's own to hold. The path
` is put together on the way back from the pointer, so a value without one builds no text.
if depth > 16 || type == no-type || type == invalid-type
    = null
types.complete(type)
. kind = types.intrinsic-of(type)
if kind == .string || kind == .cpointer || kind == .table-mark
    = null
if intrinsic-is-tuple-like(kind) || is-plain-tuple(type)
    for index in 0 .. < types.properties-of(type).length
        . property = types.properties-of(type)[index]
        if property.storage-kind != .storage-eager
            continue
        . found = managed-path(eager-type(type, property), depth + 1)
        if found
            = ".${property.name.text}${found}"
    = null
if kind == .optional
    . found = managed-path(types.optional-inner(type), depth + 1)
    if found
        = ".value${found}"
    = null
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        . found = managed-path(fact.type, depth + 1)
        if found
            . shown = if fact.name then fact.name!.text else "$index"
            = ".$shown${found}"
    = null
if is-managed(type, depth)
    = ""
= null

────────────────────
_ do names-const-array Bool
    - callable SyntaxId

` Whether a callable names ConstArray without the type of its items.
do match? tree.nodes[callable]
    | .node-type-identifier(row)
        if row.name != types.const-array-atom!
            = false
        . named = types.type-named(module, row.name, frame.env)
        = named != invalid-type && is-const-array(named)
= false

────────────────────
_ do is-computed Bool
    - site SyntaxId

` Whether an item is the result of a call, which no constant array can hold.
do match? tree.nodes[site]
    | .node-argument(row)
        = is-computed(row.expr)
    | .node-call-expression(row)
        do match? tree.nodes[row.callable]
            | .node-identifier
                = true
            | .node-get-expression
                = true
= false

────────────────────
_ do report-fault Bool
    - site SyntaxId
    - at-written Bool = false

` Says why the type store could not name a type just asked of it, at the place given or,
` when asked to and the type is written in this module, where it is written.
. fault = types.fault
if !fault
    = false
. written = types.fault-site
. exact = at-written && written != 0 && types.fault-module == module
frame.diagnose(if exact then written else site, .stated, fault)
types.clear-fault()
= true

────────────────────
_ do report-circular Bool

` Reports an associated type whose binding names itself, where the type store met the cycle.
if types.circular-binding == 0
    = false
. bound = types.circular-name
. label = if bound then bound.text else ""
. message = program.store-atom("Circular associated type $label")
. owner = types.circular-module
facts.record-diagnostic(instance, owner, types.circular-binding, .stated, message)
types.circular-binding = 0
= true

────────────────────
_ is-const-array Bool
    - type TypeId

` ConstArray is built by the compiler from constant items: it has no constructor to dispatch.
match types.rows[type]
    | .type-class(row)
        types.const-array-decl.refers-to(row.module, row.decl)
    ??
        false

────────────────────
_ do call-static TypeId
    - id SyntaxId
    - object SyntaxId
    - owner TypeId
    - name Atom
    - arguments Arguments

` A call on a type. It is a call of a static method when the type is a type parameter, an
` interface, or a type that declares a static method of the name: a type parameter answers
` only what its constraints declare, an interface answers nothing itself, and a static method
` that takes no such arguments is reported as one.
. dependent = dependent-name(object)
. interface = types.intrinsic-of(owner) == .interface
if !dependent && !interface && !declares-static(owner, name)
    . answered = calls.static-call(id, owner, name, arguments)
    note-type-value(id, object)
    = answered
if !dependent && interface
    . message = "Static methods cannot be called on an interface type"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if dependent && !requires-static(dependent, name)
    . shown = dependent.text
    . message = "Static method ${name.text} is not declared by constraints on $shown"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
. diagnosed = facts.diagnostics.length
. result = calls.static-call(id, owner, name, arguments)
if result == invalid-type
    . message = program.store-atom("Static function not found")
    facts.restate(diagnosed, instance, id, .function-not-found, .stated, message)
= result

────────────────────
_ do note-type-value
    - id SyntaxId
    - object SyntaxId

` A type that no static method answers for is called as the value describing it, and the
` type's name is that value.
. fact = facts.first-call(instance, id)
if fact == no-fact || facts.calls[fact].callee == no-instance
    =
. receiver = instances.rows[facts.calls[fact].callee].self-type
if receiver != no-type && types.intrinsic-of(receiver) == .type-info
    facts.set-node-type(instance, object, receiver)

────────────────────
_ do dependent-name Atom?
    - object SyntaxId

` The type parameter a type's name stands for, when it names one.
do match? tree.nodes[object]
    | .node-type-identifier(row)
        . this-name = types.this-atom
        if this-name && this-name == row.name
            = null
        if types.env-lookup(frame.env, row.name)
            = row.name
= null

────────────────────
_ do requires-static Bool
    - param Atom
    - name Atom

` Whether a constraint on a type parameter, of the function or converter or of the type it
` belongs to, declares a static method of the name.
. decls = program.modules[module].decls
. decl = frame.decl
while decl != 0
    . constraints = RowRange'SyntaxId()
    . next = 0u32
    do match? decls[decl]
        | .decl-function(fn)
            constraints = fn.param-constraints
            next = fn.owner
        | .decl-converter(converter)
            constraints = converter.param-constraints
            next = converter.owner
        | .decl-fromverter(fromverter)
            next = fromverter.owner
        | .decl-class(class)
            constraints = class.param-constraints
    for constraint in tree.children[constraints]
        do match? tree.nodes[constraint]
            | .node-param-constraint(row)
                . constrained = types.type-syntax-name(tree, row.left)
                if constrained && constrained == param
                    . bound = types.evaluate-type(module, tree, row.right, frame.env)
                    if bound != invalid-type && declares-static(bound, name)
                        = true
    decl = next
= false

────────────────────
_ do declares-static Bool
    - type TypeId
    - name Atom

` Whether a type, a base of it, or an interface it implements declares a static method.
types.complete(type)
do match? types.rows[type]
    | .type-class(row)
        . owner = program.modules[row.module]
        do match? owner.decls[row.decl]
            | .decl-class(class)
                . place = owner.first-member(class.members, name)
                while place != no-member
                    . member = owner.member-pool[place]
                    place = owner.member-links[place]
                    do match? owner.decls[member]
                        | .decl-function(fn)
                            if fn.is-static && fn.name && fn.name == name
                                = true
for interface in types.interfaces-of(type)
    if declares-static(interface, name)
        = true
. base = types.base-of(type)
if base
    = declares-static(base, name)
= false

────────────────────
_ do static-owner TypeId
    - object SyntaxId

. named = false
do match? tree.nodes[object]
    | .node-type-identifier
        named = true
    | .node-core-type-identifier
        named = true
    | .node-type-arguments
        named = true
    | .node-type-associated
        named = true
    | .node-identifier(row)
        . resolution = bindings.resolution-of(frame.binding, object)
        if resolution.kind == .resolve-type
            named = true
        else if resolution.kind == .resolve-unresolved || resolution.kind == .resolve-none
            . bound = types.env-lookup(frame.env, row.name)
            if bound
                = bound
if !named
    = no-type
. owner = types.evaluate-type(module, tree, object, frame.env)
= if owner == invalid-type then no-type else owner

────────────────────
_ do infer-catch-optional TypeId
    - id SyntaxId
    - body SyntaxId

. outer-surround = frame.surround
frame.surround = frame.surround.catch-depth = outer-surround.catch-depth + 1
. raw = infer(body)
frame.surround = outer-surround
if raw == invalid-type || raw == types.void-type
    = raw
. value = result-value(types, if types.is-optional(raw) then types.optional-inner(raw) else raw)
if value == types.void-type
    value = types.type-row(.int8)
if types.is-optional(value)
    = value
= types.optional-of(value)

────────────────────
_ do infer-catch TypeId
    - id SyntaxId
    - body SyntaxId
    - is-raw Bool
    - catchers RowRange'SyntaxId
    - want Want

` An expression under `catch` gives its value or its error, as it is. With handlers it gives
` what it gives where no error was raised, joined with what the handlers give. A handler
` that gives an error does not raise it: the whole is then a value that may be that error. A
` handler whose pattern can match neither the value nor any of the errors is passed over, as
` the reference compiles no arm that can not match (`catcher-possible`). One whose value is
` dropped, a statement a block does not keep the value of, gives none where the values do not
` join. An optional chain to a call that raises gives an optional of what the call gives
` (`chained-result`): handlers take the errors of the call, and the chain gives its value as an
` optional, which holds nothing where the chain made no call.
. unused = want.asks(.want-unused)
if catchers.count == 0 && !is-raw
    = infer(body)
. transformed = tree.transformer-exception(body, catchers)
if transformed != 0
    declare-transformers(body, transformed, catchers)
    = no-type
if catchers.count != 0
    instances.mark-may-panic(instance)
. outer-surround = frame.surround
frame.surround = frame.surround.catch-depth = outer-surround.catch-depth + 1
. raw = infer(body)
frame.surround = outer-surround
if catchers.count == 0 || raw == invalid-type
    = raw
. result = chained-result(raw)
. chained = result != no-type
if !chained
    result = raw
if !check-handled(id, body, result, is-raw, catchers)
    = invalid-type
. value = result-value(types, result)
. side = value
if chained && value != types.void-type && !types.is-optional(value)
    side = types.optional-of(value)
. mark = scratch.types.mark
if side != types.void-type
    scratch.types.push(side)
. errors [TypeId]
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if !takes-errors(catcher, row.type)
                continue
            if !catcher-possible(row.type, result)
                facts.set-plan(instance, catcher, .plan-never)
                continue
            check-pattern(row.type, result)
            . saved = frame.surround
            frame.surround = frame.surround.effects = exceptional-effects(saved.effects)
            . diagnosed = facts.diagnostics.length
            . handled = check-statement(row.body)
            frame.surround = saved
            if is-raised(handled)
                if errors.find(handled) == null
                    errors += handled
            else if handled != no-type && handled != types.void-type && handled != invalid-type
                scratch.types.push(handled)
            else if value != types.void-type && undiagnosed && lacks-value(row.body, handled)
                frame.diagnose(row.body, .stated, program.store-atom("Illegal statement"))
            .. undiagnosed = facts.diagnostics.length == diagnosed
if scratch.types.length == mark && errors.length == 0
    = types.void-type
. joined = types.void-type
if scratch.types.length != mark
    joined = relations.join(mark)
    if joined != invalid-type
        for part in scratch.types.since(mark)
            if part != joined
                conversions.convert(id, 0, part, joined, .reason-join)
        if chained && side != types.void-type
            if value != joined
                conversions.convert(id, 0, value, joined, .reason-join)
            conversions.convert(id, 0, types.null-type, joined, .reason-join)
scratch.types.rewind(mark)
if joined == invalid-type && unused && errors.length == 0
    = types.void-type
if joined == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Incompatible types in expression"))
    = joined
if errors.length == 0
    = joined
. given = scratch.types.mark
for error in errors
    scratch.types.push(error)
= result-type(types, joined, given)

────────────────────
_ chained-result TypeId
    - raw TypeId

` What an optional chain to a call that raises holds: the call's value or one of its errors.
` No type for anything else.
|? types.is-optional(raw) && is-result(inner)
    inner
??
    no-type

.. inner = types.optional-inner(raw)

────────────────────
_ is-result Bool
    - type TypeId

match types.rows[type]
    | .type-result
        true
    ??
        false

────────────────────
_ do takes-errors Bool
    - catcher SyntaxId
    - pattern SyntaxId

` Whether a handler names the error type it takes, as in `catch error IOError`: `Error` or a type
` that extends it. A name alone, as in `catch error`, names no type.
if pattern == 0
    frame.diagnose
        - catcher
        - .stated
        - program.store-atom("Attached catch handler requires an Error type")
    = false
. caught = match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type == 0 then no-type else caught-type(pattern)
    ??
        caught-type(pattern)
=? false if caught == invalid-type
if caught == no-type || !is-subtype(types, caught, types.error-type)
    frame.diagnose
        - pattern
        - .stated
        - program.store-atom("Attached catch handler type must be an Error subtype")
    = false
= true

────────────────────
_ do catcher-possible Bool
    - pattern SyntaxId
    - raw TypeId

` Whether the pattern of a handler could match what an expression that may raise gives: its
` value or one of its errors, which the reference matches the handlers against as a match's
` arms.
if pattern-possible(pattern, result-value(types, raw))
    = true
do match? types.rows[raw]
    | .type-result(row)
        for offset in 0 .. < row.errors.count
            if pattern-possible(pattern, types.child-type(row.errors, offset))
                = true
= false

────────────────────
_ do check-handled Bool
    - id SyntaxId
    - body SyntaxId
    - raw TypeId
    - is-raw Bool
    - catchers RowRange'SyntaxId

` Handlers attach to an expression that can raise. An error none of them takes leaves the
` function, unless the expression is itself caught: then the handlers must take every error.
` Which errors leave is recorded at the expression.
. errors = RowRange'TypeId()
. raises = false
do match? types.rows[raw]
    | .type-result(row)
        errors = row.errors
        raises = true
if !raises
    . message = "Attached catch handlers require a Result expression"
    frame.diagnose(body, .stated, program.store-atom(message))
    = false
. missing = ""
. leaving U64
. bit U64 = 1
for offset in 0 .. < errors.count
    . error = types.child-type(errors, offset)
    . place = bit
    bit = bit * 2
    if handles(catchers, error)
        continue
    if !is-raw
        note-outgoing(error, id)
        leaving = leaving /or/ place
        continue
    if missing.length != 0
        missing += ", "
    missing += type-short-name(types, error)
if missing.length != 0
    . message = "Non-exhaustive match for Result; missing $missing"
    frame.diagnose(id, .stated, program.store-atom(message))
    = false
if errors.count < 64
    facts.set-constant(instance, id, ConstantFact(leaving, 0.0, null, false), .plan-handled)
= true

────────────────────
_ do handles Bool
    - catchers RowRange'SyntaxId
    - error TypeId

for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if row.type == 0
                continue
            . caught = caught-type(row.type)
            if caught == invalid-type
                = true
            . relation = relations.compare(error, caught, false, false, null, module)
            . down = relation.kind == .relation-down-cast
            if relation-legal(relation) && !down && relation.kind != .relation-interface-down-cast
                = true
= false

────────────────────
_ do declare-transformers
    - site SyntaxId
    - exception SyntaxId
    - catchers RowRange'SyntaxId

` Each catcher names an error that, from here on, leaves the function as the exception raised
` in its place. The exception is typed once: only the catcher of a raise with one sees it.
. raised = no-type
. typed = false
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if row.body != 0
                . message = "Error transformers do not support catch bodies"
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            . source = if row.type == 0 then no-type else typed-catcher(row.type)
            if source == no-type || (source != invalid-type && !is-subtype(types, source, types.error-type))
                . message = "Error transformer catch requires an error type"
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            bind-catcher(row.type)
            . chain [TypeId]
            for previous in tree.children[row.previous]
                bind-catcher(previous)
                chain += caught-type(previous)
            if source != invalid-type && frame.has-transform(source, chain)
                . shown = type-short-name(types, source)
                . message = "Ambiguous error transformer for $shown; only one transformer may "
                message ++= "match the same error chain."
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            if !typed
                . saved = frame.surround
                frame.surround = Surround
                    - exceptional-effects(saved.effects)
                    - saved.zone-site
                    - saved.catch-depth
                    - saved.transformer-depth + 1
                raised = infer(exception)
                frame.surround = saved
                typed = true
            if source != invalid-type && raised != invalid-type && raised != no-type
                . fact = facts.note-transform
                    - instance
                    - catcher
                    - site
                    - exception
                    - source
                    - chain
                    - raised
                frame.add-transform(source, raised, chain, site, fact)

────────────────────
_ do caught-type TypeId
    - pattern SyntaxId

= match tree.nodes[pattern]
    | .node-type-capture(row)
        types.evaluate-type(module, tree, row.type, frame.env)
    ??
        types.evaluate-type(module, tree, pattern, frame.env)

────────────────────
_ do typed-catcher TypeId
    - pattern SyntaxId

` The error a catcher names, or none where it names only a local for it.
= match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type == 0 then no-type else caught-type(pattern)
    ??
        caught-type(pattern)

────────────────────
_ do bind-catcher
    - pattern SyntaxId

if pattern == 0
    =
do match? tree.nodes[pattern]
    | .node-type-capture(row)
        . slot = declaring-slot(pattern)
        . caught = types.evaluate-type(module, tree, row.type, frame.env)
        if slot && caught != invalid-type
            frame.assign(slot, caught)

────────────────────
_ do plan-class-test
    - id SyntaxId
    - op Operator
    - value TypeId
    - rhs SyntaxId

` Plans `is` or `is not` between an object and a class as a test of the object's class, and
` records the class tested for as the node's constant. The class tested for is the object's
` own, one it is derived from, or one derived from it: any other is no class the object can
` be of, and the test is of what the object converts to, as any other pattern's is.
if (op != .is-op && op != .is-not-op) || value == invalid-type || value == no-type
    =
if types.intrinsic-of(value) != .class || types.completions[value].has-variables
    =
. target = invalid-type
do match tree.nodes[rhs]
    | .node-symbol
        =
    | .node-type-case
        =
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    ??
        target = types.evaluate-type(module, tree, rhs, frame.env)
if target == invalid-type || target == no-type
    =
types.complete(target)
if types.intrinsic-of(target) != .class || types.completions[target].has-variables
    =
. kind = relations.compare(value, target).kind
. same = kind == .relation-same || kind == .relation-equal
if !same && kind != .relation-up-cast && kind != .relation-down-cast
    =
facts.set-constant(instance, id, ConstantFact(target, 0, null, false), .plan-class-test)

────────────────────
_ do infer-unprojected TypeId
    - syntax SyntaxId

` The type of the subject of a match or of the value `is` tests. A local known to hold one
` case of its union is read there as the union, not as the case, as the reference reads it.
` One that holds an optional of the union is known to hold a value, and is read as the union.
. read = infer(syntax)
do match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot && facts.plan-of(instance, syntax) == .plan-case-read
            . declared = frame.known(resolution.slot)
            if types.is-optional(declared)
                declared = types.optional-inner(declared)
            facts.set-plan(instance, syntax, .plan-none)
            facts.replace-node-type(instance, syntax, declared)
            = declared
= read

────────────────────
_ do plan-is
    - id SyntaxId
    - op Operator
    - subject TypeId
    - right SyntaxId

` Plans `is` or `is not` between a value and a pattern that is no test of an object's class.
` The pattern is planned as the pattern of an arm of a match is: a type named by the
` conversions that say what it tests, a case named by its number, of a union, of an optional
` one, or of the union a row of a table holds, and a pattern of items as it is planned in a
` match. Types in parentheses are the tuple of them. One that can not match the value is never
` true: so a pattern of items against a text, which has none to give, and a case against an optional row, as TypeScript has it. A
` case no type the module can name has is not found. A pattern of texts against a `String` is
` planned as one in a match.
if subject == invalid-type || subject == no-type || types.completions[subject].has-variables
    =
. kind = is-specificity(op)
. target = no-type
do match tree.nodes[right]
    | .node-symbol(row)
        . given = if types.is-optional(subject) then types.optional-inner(subject) else subject
        if names-enum-value(right, 0, row.name, given)
            =
        . given-kind = types.intrinsic-of(given)
        if given-kind == .union
            note-case(right, given, row.name)
        else if given == subject && (given-kind == .table-row || given-kind == .immutable-table-row)
            note-case(right, row-struct-of(given), row.name)
        . refined = given == subject && given-kind == .union && !names-case(given, row.name)
        if refined && refined-payload(given, row.name) != no-type
            facts.set-plan(instance, right, .plan-refined-case)
        else if facts.plan-of(instance, right) != .plan-case
            facts.set-plan(instance, right, .plan-never)
            if anonymous-symbol(right, row.name) == no-type && symbol-class(types, module, row.name) == invalid-type
                missing-case(right, row.name, given)
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-type-case
        check-pattern(right, subject)
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-type-list
        if subject == types.string-type || !is-collection-type(tree, right)
            plan-is-items(id, subject, right)
            =
        target = types.evaluate-type(module, tree, right, frame.env)
    | .node-type-map
        if !is-collection-type(tree, right)
            plan-is-items(id, subject, right)
            =
        target = types.evaluate-type(module, tree, right, frame.env)
    | .node-type-and { subject == types.string-type && check-text-pattern(right) }
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    | .node-tuple-syntax(row)
        target = tuple-named(row.items)
        if target == invalid-type
            . reported = facts.diagnostics.length
            for item in tree.children[row.items]
                report-missing-type(item, frame.env)
            if facts.diagnostics.length == reported
                . text = "Only types may be written in parentheses after \"is\"; to test what the fields hold, match the value with an arm, as in \"| (3, name)\""
                frame.diagnose(right, .stated, program.store-atom(text))
            =
    ??
        target = types.evaluate-type(module, tree, right, frame.env)
if target == invalid-type || target == no-type
    report-missing-type(right, frame.env)
    =
if types.completions[target].has-variables
    target = complete-named(target, subject, kind)
if target != no-type && could-match(subject, target, kind)
    plan-leaves(right, subject, target, kind, U32.max)
    plan-exact(right, kind)
else
    facts.set-plan(instance, right, .plan-never)
facts.set-plan(instance, id, .plan-is)

────────────────────
_ do tuple-named TypeId
    - items RowRange'SyntaxId

` The tuple of the types written in parentheses after `is`, as in `pair is (Int, String)`, or
` the invalid type where one of them names no type.
. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0
for item in tree.children[items]
    . field = match tree.nodes[item]
        | .node-identifier(row)
            types.type-named(module, row.name, frame.env)
        ??
            types.evaluate-type(module, tree, item, frame.env)
    if field == invalid-type || field == no-type
        scratch.types.rewind(mark)
        scratch.names.rewind(names-mark)
        = invalid-type
    scratch.names.push(types.index-atom(position))
    scratch.types.push(field)
    position += 1
= types.intern-tuple(mark, names-mark)

────────────────────
_ do complete-named TypeId
    - target TypeId
    - subject TypeId
    - kind Specificity

` A generic named with its arguments left out, completed from the value it is tested
` against: the generic the value is, or for a union the first of its cases that is one. No
` type where the value is none, and the test is never true.
. given = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(given) == .union
    for fact in types.cases-of(given)
        if fact.type != no-type && fact.type != invalid-type
            . held = relations.compare(fact.type, target, false, false, null, module)
            if instance-relation(held, kind) && !types.completions[held.to].has-variables
                = held.to
    = no-type
. relation = relations.compare(given, target, false, false, null, module)
if instance-relation(relation, kind) && !types.completions[relation.to].has-variables
    = relation.to
= no-type

────────────────────
_ instance-relation Bool
    - relation Relation
    - kind Specificity

relations.holds-as(relation, kind) && !conversions.converts-value(relation.kind)

────────────────────
_ do plan-is-items
    - id SyntaxId
    - subject TypeId
    - right SyntaxId

` Plans `is` between a value and a pattern of items or of keys: as the pattern of an arm of
` a match is planned, or as one that never matches where the value has none to give.
if pattern-possible(right, subject)
    check-pattern(right, subject)
else
    facts.set-plan(instance, right, .plan-never)
facts.set-plan(instance, id, .plan-is)

────────────────────
_ do infer-binary TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - right SyntaxId
    - want Want

if is-type-test(op)
    . tested = infer-unprojected(left)
    forget-carried(left)
    plan-class-test(id, op, tested, right)
    if facts.plan-of(instance, id) != .plan-class-test
        . own-matching = matching
        matching = matching.case = left
        plan-is(id, op, tested, right)
        matching = own-matching
    = types.bool-type
if op == .and-op || op == .or-op
    note-truthiness(id, left, infer-tested(left))
    if never-holds(left, op == .and-op)
        facts.set-plan(instance, id, .plan-never)
        = types.bool-type
    . mark = scratch.narrowings.mark
    narrowing.narrow-condition(left, op == .and-op)
    note-truthiness(id, right, infer-tested(right), true)
    pop-conditional(mark)
    = types.bool-type
if op == .coalesce-op
    = infer-coalesce(id, left, right, want)
if op == .else-op
    do match? tree.nodes[left]
        | .node-binary-expression(row)
            = infer-choice(id, row.lhs, row.rhs, right, want)
if op == .if-op
    = infer-conditional(id, left, right, want)
if is-pipeline-nested(op) || op == .pipe-forward-op || writes || op == .stream-pattern-pipe-op
    = infer-pipeline(id, op, left, right)
.. writes = op == .pipe-write-all-op || op == .pipe-write-each-op

. equates = op == .equals-op || op == .not-equals-op
if equates && (narrowing.is-null-syntax(left) || narrowing.is-null-syntax(right))
    . lhs = infer(left)
    . rhs = infer(right)
    forget-carried(left)
    forget-carried(right)
    . other = if narrowing.is-null-syntax(left) then rhs else lhs
    . operand = if narrowing.is-null-syntax(left) then right else left
    if other != invalid-type && other != no-type
        if types.is-optional(other) || reads-held(operand, other)
            facts.set-plan(instance, id, .plan-absent)
            = types.bool-type
    = infer-binary-values(id, op, left, lhs, right, rhs)
. names-left = symbol-of(left) != null || calls-symbol(left)
if equates && names-left && symbol-of(right) == null && !calls-symbol(right)
    . named = infer(right)
    if compares-machine-case(op, left, named)
        = invalid-type
    = infer-compared(id, op, left, infer-comparand(left, named), right, named)
if is-arithmetic(op) && !is-bitwise(op) && shared-symbol(left)
    . given = infer(right)
    = infer-binary-values(id, op, left, infer-receiver-symbol(left, op, given), right, given)
. lhs = infer(left)
if equates && compares-machine-case(op, right, lhs)
    = invalid-type
. rhs = if equates then infer-comparand(right, lhs) else infer(right)
note-operand-suffixes(op, left, lhs, right, rhs)
= infer-compared(id, op, left, lhs, right, rhs)

────────────────────
_ do compares-machine-case Bool
    - op Operator
    - symbol SyntaxId
    - other TypeId

` Reports a case of a state machine that `==` or `!=` compares with the machine's value: a
` machine's case is tested with `is`, which holds while a case nested in it is active too.
. name = symbol-of(symbol)
if !name || other == invalid-type || other == no-type
    = false
. machine = types.optional-inner(other)
if !is-machine-union(machine) || !names-case(machine, name)
    = false
. test = if op == .equals-op then "is" else "is not"
. written = ".${name.text}"
. message = "A state machine's case is tested with \"is\" or \"is not\", which count the cases nested in it; write \"$test $written\" in place of \"$op $written\""
frame.diagnose(symbol, .stated, program.store-atom(message))
= true

────────────────────
_ do note-operand-suffixes
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

if op == .pow-op || (!is-arithmetic(op) && !is-comparison(op))
    =
if !is-shift(op)
    calls.note-operand-suffix(left, right, rhs)
calls.note-operand-suffix(right, left, lhs)

────────────────────
_ do infer-receiver-symbol TypeId
    - left SyntaxId
    - op Operator
    - rhs TypeId

` A case named by its symbol alone that several types have, as the operand an operator is called
` on: of the last of them that declares the operator for the other operand, as a call settles
` such a case among its arguments by the function it finds, else of the type its name alone gives.
. token = program.store-atom("$op")
. owners [TypeId]
symbol-sharers(left, owners)
. position = owners.length
while position > 0 && rhs != invalid-type
    position -= 1
    . owner = owners[position]
    if calls.has-operator(owner, token, rhs)
        =? infer(left) if position == owners.length - 1
        note-enum-case(owner, symbol-of(left)!, left)
        facts.set-node-type(instance, left, owner)
        = owner
= infer(left)

────────────────────
_ do infer-compared TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

` A comparison casts each side to the type of the other, as the reference does, so a case named
` by its symbol alone compared with a value of a type without the case is of no one type.
if lhs != invalid-type && rhs != invalid-type && is-comparison(op)
    note-unsettled(left, rhs)
    note-unsettled(right, lhs)
= infer-binary-values(id, op, left, lhs, right, rhs)

────────────────────
_ do wider-float Bool
    - one TypeId
    - other TypeId

` Whether a float is wider than another float, which a comparison of the two converts to it.
. first = types.completion-of(one)
. second = types.completion-of(other)
= intrinsic-is-float(first.intrinsic) && intrinsic-is-float(second.intrinsic) && wider-bits
    .. wider-bits = first.bit-size > second.bit-size

────────────────────
_ do mixes-float Bool
    - one TypeId
    - other TypeId

` Whether one of two numbers is a float and the other an integer, which a comparison brings to
` the type arithmetic on the two works in.
. first = types.completion-of(one).intrinsic
. second = types.completion-of(other).intrinsic
= float-first || (is-integer-kind(first) && intrinsic-is-float(second))
    .. float-first = intrinsic-is-float(first) && is-integer-kind(second)

────────────────────
_ do infer-binary-values TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

if lhs == invalid-type || rhs == invalid-type
    = invalid-type
. left-type = conversions.adapted-literal(left, lhs, rhs)
. right-type = conversions.adapted-literal(right, rhs, lhs)
if left-type != lhs || right-type != rhs
    = infer-binary-values(id, op, left, left-type, right, right-type)
if op == .is-in-op || op == .not-in-op
    = infer-containment(id, op == .is-in-op, rhs, left, lhs, true)
if op == .has-op || op == .has-not-op
    = infer-containment(id, op == .has-op, lhs, right, rhs, false)
if op == .concat-op || op == .concat-string-op
    if op == .concat-op && non-string && calls.has-operator(lhs, types.concat-atom!, rhs)
        = calls.operator-call(id, lhs, types.concat-atom!, right, rhs)
    .. non-string = lhs != types.string-type
    if op == .concat-op && types.intrinsic-of(lhs) != .string
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    note-unsettled(left, types.string-type)
    note-unsettled(right, types.string-type)
    if lhs != types.string-type
        conversions.convert(id, left, lhs, types.string-type, .reason-operator)
    calls.concat-call(id, right, rhs)
    = types.string-type
. lhs-value = if types.is-optional(lhs) then types.optional-inner(lhs) else lhs
. rhs-value = if types.is-optional(rhs) then types.optional-inner(rhs) else rhs
. left-truth = types.intrinsic-of(lhs-value) == .bool
. right-truth = types.intrinsic-of(rhs-value) == .bool
. builtin = numeric && left-truth == right-truth
    .. numeric = is-numeric(types, lhs-value) && is-numeric(types, rhs-value)
. plain = lhs == lhs-value && rhs == rhs-value
. equates = op == .equals-op || op == .not-equals-op
if equates && !plain && lhs != types.null-type && rhs != types.null-type
    . held = infer-held(id, op, left, lhs, right, rhs)
    if held != no-type
        = held
if is-comparison(op) && builtin && !plain && !equates
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
if is-comparison(op) && builtin && plain && (is-declared-number(lhs) || is-declared-number(rhs))
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if overridden != no-type
        = overridden
if is-comparison(op) && builtin
    . plan = OperatorPlan.plan-builtin
    if lhs-value != rhs-value
        . common = integer-comparison-type(types, lhs-value, rhs-value)
        if common != no-type
            cast-operand(left, lhs-value, common)
            cast-operand(right, rhs-value, common)
            if compares-by-sign(types, lhs-value, rhs-value)
                plan = .plan-sign-checked-right
                if types.completions[lhs-value].is-signed
                    plan = .plan-sign-checked-left
        else if plain && mixes-float(lhs-value, rhs-value)
            . machine = promote(types, lhs-value, rhs-value)
            promote-operand(left, lhs-value, machine)
            promote-operand(right, rhs-value, machine)
        else if intrinsic-is-float(types.completions[rhs-value].intrinsic) && narrower
            conversions.convert(left, left, lhs-value, rhs-value, .reason-operand)
        else
            conversions.convert(right, right, rhs-value, lhs-value, .reason-operand)
        .. narrower = !wider-float(lhs-value, rhs-value)
    if plain
        facts.set-plan(instance, id, plan)
    = types.bool-type
if is-bitwise(op) && !is-shift(op)
    . answered = calls.operands-call(id, bitwise-name(op), left, lhs, right, rhs)
    if answered != no-type
        = plan-answer(id, .plan-call, answered)
if is-bitwise(op) && builtin
    . fallback = if is-integer(rhs-value) then rhs-value else types.type-row(.int64)
    . decided = if is-integer(lhs-value) then lhs-value else fallback
    . mixed = integers && builtin-number(types, lhs) != builtin-number(types, rhs)
        .. integers = is-integer(lhs) && is-integer(rhs)
    if mixed && !is-shift(op)
        . machine = promote(types, lhs, rhs)
        promote-operand(left, lhs, machine)
        promote-operand(right, rhs, machine)
        facts.set-plan(instance, id, .plan-builtin)
        = machine
    if lhs != decided
        conversions.convert(left, left, lhs, decided, .reason-operand)
    if is-shift(op)
        if rhs != rhs-value
            conversions.convert(right, right, rhs, rhs-value, .reason-operand)
        promote-operand(right, rhs-value, decided)
    else if rhs != decided
        conversions.convert(right, right, rhs, decided, .reason-operand)
    facts.set-plan(instance, id, .plan-builtin)
    = decided
if op == .pow-op && builtin && plain
    = plan-answer
        - id
        - .plan-call
        - calls.operator-call(id, lhs, program.store-atom("$op"), right, rhs)
if is-arithmetic(op) && builtin
    if lhs != lhs-value || left-truth
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    . given = rhs-value
    if rhs != rhs-value
        conversions.convert(right, right, rhs, lhs, .reason-operand)
        given = lhs
    . unit = unit-arithmetic-type(types, lhs-value, given, op == .multiply-op)
    . promoted = promote(types, lhs-value, given)
    if op != .pow-op
        plan-arithmetic(id, left, lhs-value, right, given, unit, promoted)
    = if unit != no-type then unit else promoted
. pointer-lhs = types.completions[lhs-value].intrinsic == .cpointer
if is-arithmetic(op) && pointer-lhs && is-numeric(types, rhs-value)
    if plain && op == .add-op
        facts.set-plan(instance, id, .plan-pointer-add)
    = lhs-value
if op == .add-op
    . zipped = zip-columns(lhs, rhs)
    if zipped != no-type
        facts.set-constant
            - instance
            - id
            - ConstantFact(TableOp.table-zip, 0.0, null, false)
            - .plan-table
        = zipped
. token = program.store-atom("$op")
if is-comparison(op)
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if equates && types.intrinsic-of(lhs) == .type-info && types.intrinsic-of(rhs) == .type-info
        facts.set-plan(instance, id, if lhs == rhs then .plan-alike else .plan-unlike)
        = types.bool-type
    if equates && plain && lhs == types.void-type && rhs == types.void-type && overridden == no-type
        facts.set-plan(instance, id, .plan-alike)
        = types.bool-type
    if overridden != no-type
        = overridden
    . left-address = types.intrinsic-of(lhs) == .cpointer
    . right-address = types.intrinsic-of(rhs) == .cpointer
    . addressed = left-pointer && (right-address || rhs == types.null-type)
        .. left-pointer = left-address || lhs == types.null-type
    if plain && (left-address || right-address) && addressed
        facts.set-plan(instance, id, .plan-address-compare)
        = types.bool-type
    if equates && plain && compare-fields(id, lhs, rhs, right, false)
        compare-fields(id, lhs, rhs, right, true)
        facts.set-plan(instance, id, if op == .equals-op then .plan-fields else .plan-not-fields)
        = types.bool-type
    if equates && plain && lhs == rhs && compare-cases(id, lhs, right, false)
        compare-cases(id, lhs, right, true)
        facts.set-plan(instance, id, if op == .equals-op then .plan-fields else .plan-not-fields)
        = types.bool-type
    if equates && plain && is-unlike(lhs, rhs)
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    . atoms = types.intrinsic-of(lhs) == .atom || types.intrinsic-of(rhs) == .atom
    if equates && plain && atoms && lhs != rhs && lhs != types.null-type && rhs != types.null-type
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    if equates && lhs == rhs && is-identified(lhs)
        facts.set-plan(instance, id, .plan-identity)
        = types.bool-type
    . classes = types.intrinsic-of(lhs) == .class && types.intrinsic-of(rhs) == .class
    if equates && plain && classes && related
        facts.set-plan(instance, id, .plan-identity)
        = types.bool-type
    .. related = in-base-chain(types, lhs, rhs) || in-base-chain(types, rhs, lhs)
    if equates && plain && lhs != rhs && classes
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    if equates && plain && lhs != rhs && closures
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    .. closures = types.intrinsic-of(lhs) == .closure && types.intrinsic-of(rhs) == .closure
    if equates && plain && lhs != rhs && types.intrinsic-of(lhs) == .union
        plan-case-equal(id, left, lhs, right, rhs)
        = types.bool-type
    if equates && plain && types.intrinsic-of(lhs) == .interface && rhs != types.null-type
        compare-interfaces(id, lhs, rhs)
        = types.bool-type
    if equates && plain && types.intrinsic-of(lhs) == .class && rhs-interface
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    .. rhs-interface = types.intrinsic-of(rhs) == .interface
    if types.intrinsic-of(lhs-value) == .interface && rhs != types.null-type
        instances.mark-may-panic(instance)
    if is-numeric(types, lhs) && !is-numeric(types, rhs-value) && rhs != types.null-type
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    . unanswered = unplanned && lhs != types.null-type && rhs != types.null-type
        .. unplanned = facts.plan-of(instance, id) == .plan-none
    if plain && unanswered && (lhs-value != rhs-value || !equates)
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    = types.bool-type
if is-numeric(types, lhs) && !is-numeric(types, rhs)
    if calls.has-operator(lhs, token, rhs)
        = plan-answer(id, .plan-call, calls.operator-call(id, lhs, token, right, rhs))
    if is-numeric(types, lhs-value) && !is-numeric(types, rhs-value)
        frame.diagnose(right, .illegal-cast, null, rhs, lhs-value)
        = invalid-type
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
= plan-answer(id, .plan-call, calls.operator-call(id, lhs, token, right, rhs))

────────────────────
_ do infer-held TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

` `==` or `!=` where an operand is an optional, in the order the reference asks:
` - two tuples of which one declares `==` for the other are compared where both operands
`   hold a value, and two that hold nothing are equal;
` - else a function the operands declare for each other as they are answers, as for any
`   comparison: no type is given here, and nothing is recorded;
` - else the operands are compared as what they hold, and two that hold nothing are equal
`   where they are optionals of one type.
` The `==` of what they hold is typed as any `==` is, with the right operand first where the
` reference puts an optional on the right first. Where that `==` tests a union on the left
` for a case, the one plan tests the case of what the optional holds. Nothing is planned where
` that `==` has no plan, or where two optionals of different types would be answered by a
` function.
. lhs-value = if types.is-optional(lhs) then types.optional-inner(lhs) else lhs
. rhs-value = if types.is-optional(rhs) then types.optional-inner(rhs) else rhs
if types.is-optional(lhs-value) || types.is-optional(rhs-value)
    = no-type
. equals = program.store-atom("${Operator.equals-op}")
. tuples = types.intrinsic-of(lhs-value) == .tuple && types.intrinsic-of(rhs-value) == .tuple
. declared = tuples && (calls.has-operator(lhs-value, equals, rhs-value) || calls.has-operator(rhs-value, equals, lhs-value))
if !declared && (!is-numeric(types, lhs-value) || !is-numeric(types, rhs-value))
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if overridden != no-type
        = overridden
. paired = lhs != lhs-value && rhs != rhs-value
. exchanged = rhs != rhs-value && (lhs == lhs-value || lhs == rhs || declared)
. answer = invalid-type
if exchanged
    answer = infer-binary-values(id, .equals-op, right, rhs-value, left, lhs-value)
else
    answer = infer-binary-values(id, .equals-op, left, lhs-value, right, rhs-value)
. inner = facts.plan-of(instance, id)
if answer == types.bool-type && inner == .plan-held && !exchanged
    . tested = facts.held-of(instance, id)
    if tested.case-index != U32.max && !tested.left && !tested.right
        facts.set-held
            - instance
            - id
            - HeldPlan
                - tested.plan
                - lhs != lhs-value
                - rhs != rhs-value
                - false
                - false
                - tested.case-index
        = types.bool-type
. called = plain-called || inner == .plan-neither-call || inner == .plan-not-or-call
    .. plain-called = inner == .plan-call || inner == .plan-negated-call
if answer != types.bool-type || inner == .plan-none || inner == .plan-held || undeclared-pair
    facts.set-plan(instance, id, .plan-none)
    = answer
.. undeclared-pair = paired && lhs != rhs && !declared && called
facts.set-held
    - instance
    - id
    - HeldPlan
        - inner
        - lhs != lhs-value
        - rhs != rhs-value
        - paired && (lhs == rhs || declared)
        - exchanged
= types.bool-type

────────────────────
_ do compare-fields Bool
    - id SyntaxId
    - left TypeId
    - right TypeId
    - right-syntax SyntaxId
    - records Bool

` Whether two tuples or structs are compared field by field: both store as many fields under
` the same names, and each pair in turn is one type the machine compares, or declares `==`,
` or is one class or atoms, or two unions of one type compared case by case, or is again two
` such tuples or structs, or two optionals of one type that declares `==` or is one of these,
` compared where both hold a value. With `records`, the call of each `==` is recorded at the
` node, in the order the fields are stored.
. kind = types.intrinsic-of(left)
. other = types.intrinsic-of(right)
if (kind != .tuple && kind != .struct) || (other != .tuple && other != .struct)
    = false
types.complete(left)
types.complete(right)
. mine = types.completions[left].properties
. theirs = types.completions[right].properties
. equals = program.store-atom("${Operator.equals-op}")
. a U32
. b U32
while true
    while a < mine.count && types.properties[mine.start + a].slot == U32.max
        a += 1
    while b < theirs.count && types.properties[theirs.start + b].slot == U32.max
        b += 1
    if a >= mine.count || b >= theirs.count
        = a >= mine.count && b >= theirs.count
    if types.properties[mine.start + a].name != types.properties[theirs.start + b].name
        = false
    . held = member-type(types.properties[mine.start + a], left)
    . given = member-type(types.properties[theirs.start + b], right)
    a += 1
    b += 1
    if held == no-type || held == invalid-type || given == no-type || given == invalid-type
        = false
    if held == given && compares-by-machine(types, held) && !is-declared-number(held)
        continue
    if calls.has-operator(held, equals, given)
        if records
            calls.operator-call(id, held, equals, right-syntax, given)
        continue
    if held == given && (compares-by-machine(types, held) || is-identified(held))
        continue
    if types.intrinsic-of(held) == .interface && types.intrinsic-of(given) == .interface
        if records
            require-interface-equality(id, held)
        continue
    if held == given && compare-cases(id, held, right-syntax, records)
        continue
    if held == given && types.is-optional(held)
        . inner = types.optional-inner(held)
        if calls.has-operator(inner, equals, inner)
            if records
                calls.operator-call(id, inner, equals, right-syntax, inner)
            continue
        if compares-by-machine(types, inner) || is-identified(inner) || compare-cases(id, inner, right-syntax, records) || compare-fields(id, inner, inner, right-syntax, records)
            continue
        = false
    if !compare-fields(id, held, given, right-syntax, records)
        = false
= true

────────────────────
_ do compare-cases Bool
    - id SyntaxId
    - type TypeId
    - right-syntax SyntaxId
    - records Bool

` Whether two unions of one type are compared case by case: they are equal where both hold
` the same case and what it holds is equal, compared as a field of a tuple is. A case that
` holds nothing of its own is equal to itself. With `records`, the call of each `==` is
` recorded at the node, in the order of the cases.
if type == no-type || type == invalid-type || types.intrinsic-of(type) != .union
    = false
. equals = program.store-atom("${Operator.equals-op}")
for fact in types.cases-of(type)
    . held = fact.type
    if fact.is-default || held == no-type
        continue
    if held == invalid-type
        = false
    if compares-by-machine(types, held) && !is-declared-number(held)
        continue
    if calls.has-operator(held, equals, held)
        if records
            calls.operator-call(id, held, equals, right-syntax, held)
        continue
    if compares-by-machine(types, held)
        continue
    if is-identified(held)
        continue
    if types.intrinsic-of(held) == .interface
        if records
            require-interface-equality(id, held)
        continue
    if compare-fields(id, held, held, right-syntax, records)
        continue
    if !compare-cases(id, held, right-syntax, records)
        = false
= true

────────────────────
_ do plan-case-equal
    - id SyntaxId
    - left SyntaxId
    - union TypeId
    - right SyntaxId
    - type TypeId

` Plans `==` of a union with a value of another type, as the reference answers it: the union
` is tested for the case a value of that type is held as, and what it holds is compared with
` the value as any two values of the type are. Nothing is planned where that case holds
` another type than the value's, or the `==` of two such values has no plan.
. relation = relations.compare(type, union, false, false, null, module)
if relation.kind != .relation-wrap-cast || relation.case-index == U32.max
    =
. held = types.cases-of(union)[relation.case-index]
if held.is-default || held.type != type
    =
. answer = infer-binary-values(id, .equals-op, left, type, right, type)
. inner = facts.plan-of(instance, id)
if answer != types.bool-type || inner == .plan-none || inner == .plan-held
    facts.set-plan(instance, id, .plan-none)
    =
facts.set-held(instance, id, HeldPlan(inner, false, false, false, false, relation.case-index))

────────────────────
_ is-identified Bool
    - type TypeId

` Whether two values of a type that declares no `==` are equal when they are one: one object
` of a class, one atom, one closure's data, or one code and data that two values of a function
` type hold.
class-or-atom || types.intrinsic-of(type) == .closure || function-row(types, type) != no-type

.. class-or-atom = types.intrinsic-of(type) == .class || types.intrinsic-of(type) == .atom

────────────────────
_ is-declared-number Bool
    - type TypeId

` Whether a number's type is a class written over a machine number, which may declare its own
` operators: a comparison of two asks them first, as of any other type.
owner.decl != 0 && is-numeric(types, type) && !types.is-builtin-decl(owner.module, owner.decl)

.. owner = class-ref(types, type)

────────────────────
_ do is-unlike Bool
    - left TypeId
    - right TypeId

` Whether two tuples or structs are never equal: they store other numbers of fields, or a
` field of one has another name than the field in its place in the other.
. kind = types.intrinsic-of(left)
. other = types.intrinsic-of(right)
if (kind != .tuple && kind != .struct) || (other != .tuple && other != .struct)
    = false
types.complete(left)
types.complete(right)
. mine = types.completions[left].properties
. theirs = types.completions[right].properties
. a U32
. b U32
while true
    while a < mine.count && types.properties[mine.start + a].slot == U32.max
        a += 1
    while b < theirs.count && types.properties[theirs.start + b].slot == U32.max
        b += 1
    if a >= mine.count || b >= theirs.count
        = a < mine.count || b < theirs.count
    if types.properties[mine.start + a].name != types.properties[theirs.start + b].name
        = true
    a += 1
    b += 1
= false

────────────────────
_ do member-type TypeId
    - property TypeProperty
    - owner TypeId

` The type of a stored property, typed from the value its class writes when none is declared.
if property.type != no-type
    = property.type
= demand-member(property, owner, property.name)

────────────────────
_ do plan-arithmetic
    - id SyntaxId
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId
    - unit TypeId
    - promoted TypeId

` Plans arithmetic on two numbers as the machine operation in their promoted type. With a
` unit, the right operand is first brought to the unit by its ratio, both are brought to the
` machine type of the unit, and the result goes back to the unit.
. machine = promoted
. given = rhs
if unit != no-type
    machine = promote(types, builtin-number(types, unit), builtin-number(types, unit))
    if rhs != unit
        conversions.convert(id, right, rhs, unit, .reason-operator)
        given = unit
promote-operand(left, lhs, machine)
promote-operand(right, given, machine)
if unit != no-type && unit != machine
    . relation = conversions.compare-held(machine, unit)
    conversions.record-conversion(id, relation, .reason-result)
facts.set-plan(instance, id, .plan-builtin)

────────────────────
_ do promote-operand
    - operand SyntaxId
    - source TypeId
    - target TypeId

` Brings an operand to the type its operator works in. The cast is the operator's own, which
` the reference makes without recording it, so it has a reason of its own. It is recorded at
` the operand as written, and never at the value of a local the operand names.
if source == target
    =
. relation = conversions.compare-held(source, target)
conversions.record-conversion(operand, relation, .reason-promotion, true)

────────────────────
_ do cast-operand
    - operand SyntaxId
    - source TypeId
    - target TypeId

` Brings an operand of a comparison of two integers to the type both are compared in. The
` cast is the operator's own, as in the reference, so a literal is not checked for fit:
` `-1 < 4000000000u32` is legal.
if source == target
    =
. relation = conversions.compare-held(source, target)
conversions.record-conversion(operand, relation, .reason-operand)

────────────────────
_ do compare-interfaces
    - id SyntaxId
    - left TypeId
    - right TypeId

` Plans `==` of a value of an interface with another value. Two values of interfaces are
` equal when the type behind the left one says so, through the function its witness table
` holds for equality, which the interface then requires; where the types behind them
` differ, the getter that says whether a tracker compares for a change is read. A value of a
` type that is no interface on the right is the panic the reference compiles in.
instances.mark-may-panic(instance)
if types.intrinsic-of(right) != .interface
    facts.set-plan(instance, id, .plan-interface-unlike)
    =
require-interface-equality(id, left)
facts.set-plan(instance, id, .plan-interface-equal)

────────────────────
_ do require-interface-equality
    - id SyntaxId
    - interface TypeId

` Notes that two values of an interface are compared at a node: the interface requires
` equality, the getter of a tracker's comparison for a change is recorded at the node, and
` the comparison may panic. Under an effect that forbids it, it is TypeScript's error.
instances.mark-may-panic(instance)
. restricted = heap-effects /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend
    .. heap-effects = CompilationEffect.gc-free /or/ CompilationEffect.no-heap
if (dispatch-effects(frame.surround.effects) /and/ restricted) != 0
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Interface equality requires unrestricted effects")
    =
facts.require-equality(interface)
. action = types.live-action-type
if action != invalid-type
    calls.demand-module-getter
        - class-ref(types, action).module
        - program.store-atom("is-comparing-for-change")
        - id

────────────────────
_ do infer-override TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId
    - exchanged Bool

` A comparison is answered by a function its operands declare. In order:
` - the operator itself;
` - the operator that says the reverse, negated: `!=` by `==`, `<=` by `>`;
` - for an ordering, the mirrored one with equality: `<` holds when neither `>` nor `==`
`   does, and `<=` when `>=` does not or `==` does;
` - the mirrored operator with the operands exchanged.
` Gives no type when nothing is declared.
. direct = call-override(id, op, left, lhs, right, rhs, exchanged)
if direct != no-type
    = plan-answer(id, .plan-call, direct)
. negated = call-override(id, negation-of(op), left, lhs, right, rhs, exchanged)
if negated != no-type
    = plan-answer
        - id
        - .plan-negated-call
        - if negated != invalid-type then types.bool-type else negated
. equates = op == .equals-op || op == .not-equals-op
. mirror = opposite-of(op)
if !equates
    . mirrored = call-override(id, mirror, left, lhs, right, rhs, exchanged)
    if mirrored == invalid-type
        = mirrored
    if mirrored != no-type
        . equal = call-override(id, .equals-op, left, lhs, right, rhs, exchanged)
        if equal != no-type
            . strict = op == .less-than-op || op == .greater-than-op
            . plan = if strict then neither-plan else OperatorPlan.plan-not-or-call
                .. neither-plan = OperatorPlan.plan-neither-call
            = plan-answer(id, plan, if equal != invalid-type then types.bool-type else equal)
        . mine = type-class-name(lhs)
        . theirs = type-class-name(rhs)
        . compared = if mine == theirs then mine else "$mine or $theirs"
        frame.diagnose(id, .stated, program.store-atom("Must implement == for $compared"))
        = invalid-type
if exchanged
    = no-type
= infer-override(id, mirror, right, rhs, left, lhs, true)

────────────────────
_ bitwise-name Atom
    - op Operator

` The name of the function that answers a bitwise operator in place of the operator itself,
` when one is declared.
|? op == .bitwise-and-op
    types.and-atom!
|? op == .bitwise-or-op
    types.or-atom!
??
    types.xor-atom!

────────────────────
_ do plan-answer TypeId
    - id SyntaxId
    - plan OperatorPlan
    - result TypeId

` Records how an operator is answered, once a function was found to answer it.
if result != invalid-type
    facts.set-plan(instance, id, plan)
= result

────────────────────
_ do call-override TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId
    - exchanged Bool

` Calls the operator one operand declares for the other, which for equality may be either
` operand, and gives no type when neither declares it. `exchanged` says the operands arrive
` in the reverse of their order in the source, so the call notes when its receiver is the
` operator's right operand.
. token = program.store-atom("$op")
if calls.has-operator(lhs, token, rhs)
    . result = calls.operator-call(id, lhs, token, right, rhs)
    if exchanged && result != invalid-type
        facts.mark-swapped(instance, id)
    = result
. either = op == .equals-op || op == .not-equals-op
if either && calls.has-operator(rhs, token, lhs)
    . result = calls.operator-call(id, rhs, token, left, lhs)
    if !exchanged && result != invalid-type
        facts.mark-swapped(instance, id)
    = result
= no-type

────────────────────
_ type-class-name String
    - type TypeId

match types.rows[type]
    | .type-class(row)
        class-name(program, row.module, row.decl)
    ??
        type-short-name(types, type)

────────────────────
_ opposite-of Operator
    - op Operator

match op
    |= .not-equals-op
        .equals-op
    |= .less-than-op
        .greater-than-op
    |= .greater-than-op
        .less-than-op
    |= .less-than-equals-op
        .greater-than-equals-op
    |= .greater-than-equals-op
        .less-than-equals-op
    |= .equals-op
        .not-equals-op
    ??
        .equals-op

────────────────────
_ negation-of Operator
    - op Operator

` The comparison that holds exactly when another does not.
match op
    |= .not-equals-op
        .equals-op
    |= .less-than-op
        .greater-than-equals-op
    |= .greater-than-op
        .less-than-equals-op
    |= .less-than-equals-op
        .greater-than-op
    |= .greater-than-equals-op
        .less-than-op
    ??
        .not-equals-op

────────────────────
_ do zip-columns TypeId
    - lhs TypeId
    - rhs TypeId

` Mutable table fields add into the tuple of fields a table span is cast from.
. mark = scratch.types.mark
. names-mark = scratch.names.mark
if !push-columns(lhs, mark) || !push-columns(rhs, mark)
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = no-type
= types.intern-tuple(mark, names-mark)

────────────────────
_ do push-columns Bool
    - value TypeId
    - mark ScratchMark

if types.intrinsic-of(value) == .table-column
    scratch.names.push(types.index-atom(scratch.types.length - mark))
    scratch.types.push(value)
    = true
. fields = RowRange'TypeId()
do match? types.rows[value]
    | .type-tuple(row)
        fields = row.fields
for offset in 0 .. < fields.count
    . field = types.child-type(fields, offset)
    if types.intrinsic-of(field) != .table-column
        = false
    scratch.names.push(types.index-atom(scratch.types.length - mark))
    scratch.types.push(field)
= fields.count != 0

────────────────────
_ do infer-containment TypeId
    - id SyntaxId
    - positive Bool
    - container TypeId
    - item-syntax SyntaxId
    - item TypeId
    - is-right Bool

` `has` and `has not` answer for each other: a container that declares only one is asked that
` one and the answer is negated, as the reference does for an operator and its opposite.
` `is-right` says the container is the operator's right operand, as it is for `is in`.
. has-not = program.store-atom("has not")
. wanted = if positive then types.has-atom! else has-not
. other = if positive then has-not else types.has-atom!
. chosen = wanted
if !calls.has-operator(container, wanted, item) && calls.has-operator(container, other, item)
    chosen = other
. found = calls.operator-call(id, container, chosen, item-syntax, item)
if found == invalid-type
    = found
if is-right
    facts.mark-swapped(instance, id)
facts.set-plan(instance, id, if chosen == wanted then .plan-call else .plan-negated-call)
= types.bool-type

────────────────────
_ do infer-conditional TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId
    - want Want

` `value if condition`: an optional of the value, empty where the condition fails. A lambda
` given where a function is expected is that function, as the reference types it with the type
` expected (`want-fitting`): its optional is of that type.
. fitting = fitting-of(want)
note-truthiness(id, right, infer(right), true)
. mark = scratch.narrowings.mark
narrowing.narrow-condition(right, true)
. value = infer(left)
pop-conditional(mark)
if value == invalid-type
    = invalid-type
. fits = fitting != no-type && value != no-type && types.intrinsic-of(value) == .closure
. wrapped = types.optional-of(if fits then fitting else value)
if wrapped != value
    conversions.convert(id, left, value, wrapped, .reason-join)
= wrapped

────────────────────
_ do infer-coalesce TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId
    - want Want

if coalesces-condition(id, left)
    frame.diagnose(id, .stated, program.store-atom("`value if condition ?? other` is not a choice of two values. Write `if condition then value else other`."))
    = invalid-type
. lhs = infer-tested(left, if want.asks(.want-fitting) then Want().asking(.want-fitting, want.type) else Want())
forget-carried(left)
skippable-depth += 1
. rhs = if shared-symbol(right) then infer(right) else infer-comparand(right, lhs)
skippable-depth -= 1
if lhs == invalid-type || rhs == invalid-type
    = invalid-type
if lhs == types.void-type
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
if lhs == types.null-type
    = rhs
if !types.is-optional(lhs)
    note-truthiness(id, left, lhs)
rhs = conversions.adapted-literal(right, rhs, types.optional-inner(lhs))
. inner = types.optional-inner(lhs)
. target = if types.is-optional(rhs) || rhs == types.null-type then lhs else inner
. relation = relations.unify-present(lhs, rhs, module)
if types.is-optional(lhs)
    relation = relations.unify-fallback(target, rhs, module)
if !relation-legal(relation)
    frame.diagnose(id, .illegal-cast, null, rhs, target)
    = invalid-type
. joined = relation.unified
. settled = settle-joined(right, rhs, joined)
if inner != joined
    conversions.convert(id, left, inner, joined, .reason-join)
if settled != joined
    conversions.convert(id, right, settled, joined, .reason-join)
= joined

────────────────────
_ do infer-tested TypeId
    - syntax SyntaxId
    - want Want = Want()

` The type of an operand of `&&`, `||` or `!`, of the left of `??`, and of the condition of
` `while` or `=?` or of a clause of a loop. A local that holds an optional is tested there as
` the optional it is, also where the flow knows it to hold a value, as the reference tests
` it: for whether it holds one, and not for what the one it holds is. Every other condition
` tests what it holds.
. read = infer(syntax, want)
if read == invalid-type || read == no-type
    = read
if !reads-held(syntax, read)
    note-tested-force(syntax, read)
    = read
. declared = slot-known(bindings.resolution-of(frame.binding, syntax).slot)
facts.replace-node-type(instance, syntax, declared)
= declared

────────────────────
_ do note-tested-force
    - syntax SyntaxId
    - read TypeId

do match? tree.nodes[syntax]
    | .node-unary-expression(row)
        if row.op == .optional-force-op && reads-held(row.operand, read)
            . fact = facts.first-force(instance, syntax)
            if fact != no-fact
                facts.forces[fact].is-tested = true

────────────────────
_ do reads-held Bool
    - expr SyntaxId
    - read TypeId

` Whether an expression reads a local that holds an optional, where the flow knows it to
` hold a value and so reads that value.
do match? tree.nodes[expr]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, expr)
        if resolution.kind == .resolve-slot
            . known = slot-known(resolution.slot)
            = types.is-optional(known) && types.optional-inner(known) == read
= false

────────────────────
_ coalesces-condition Bool
    - id SyntaxId
    - left SyntaxId

` Whether `??` takes the other side of a value written `value if condition`, as its left side
` or as the last of the sides before it in one chain, which shares the chain's place.
match tree.nodes[left]
    | .node-binary-expression(row)
        |? row.op == .if-op
            true
        |? row.op == .coalesce-op && tree.nodes.loc[left] == tree.nodes.loc[id]
            is-if-syntax(row.rhs)
        ??
            false
    ??
        false

────────────────────
_ is-if-syntax Bool
    - expr SyntaxId

match tree.nodes[expr]
    | .node-binary-expression(row)
        row.op == .if-op
    ??
        false

────────────────────
_ do infer-choice TypeId
    - id SyntaxId
    - value-syntax SyntaxId
    - condition SyntaxId
    - other-syntax SyntaxId
    - want Want

` `if condition then value else other`: the two sides joined, an optional where either side is
` `null` or an optional. A lambda given where a function is expected is that function, as
` `infer-conditional` types it. A choice a function gives as its result joins at the declared
` result type when both sides convert to it, as the reference casts each side there.
. fitting = fitting-of(want)
. wanted = if want.asks(.want-choice) then want.type else no-type
note-truthiness(id, condition, infer(condition))
. mark = scratch.narrowings.mark
narrowing.narrow-condition(condition, true)
. value = infer-choice-side(value-syntax, wanted)
. value-settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
narrowing.narrow-condition(condition, false)
. other = infer-choice-side(other-syntax, wanted)
pop-conditional(mark)
widen-settled(value-settled)
if value == invalid-type || other == invalid-type
    = invalid-type
if wanted != no-type && fits-choice(value, wanted) && fits-choice(other, wanted)
    if value != wanted
        conversions.convert(id, value-syntax, value, wanted, .reason-join)
    if other != wanted
        conversions.convert(id, other-syntax, other, wanted, .reason-join)
    = wanted
value = conversions.adapted-literal(value-syntax, value, types.optional-inner(other))
other = conversions.adapted-literal(other-syntax, other, types.optional-inner(value))
if value == types.null-type && other == types.null-type
    = value
if value == types.null-type
    = optional-side(id, other-syntax, other, value-syntax, fitting)
if other == types.null-type
    = optional-side(id, value-syntax, value, other-syntax, fitting)
. optional = types.is-optional(value) || types.is-optional(other)
. present = types.optional-inner(value)
. present-other = types.optional-inner(other)
. relation = relations.unify(present, present-other, module)
if !relation-legal(relation)
    relation = relations.unify-fallback(present, present-other, module)
if !relation-legal(relation)
    frame.diagnose(id, .illegal-cast, null, other, present)
    = invalid-type
. joined = relation.unified
. result = if optional then types.optional-of(joined) else joined
join-side(id, value-syntax, value, present, joined, result)
join-side(id, other-syntax, other, present-other, joined, result)
= result

────────────────────
_ do infer-choice-side TypeId
    - side SyntaxId
    - wanted TypeId

` A side of a choice, of `wanted` when one is given: a case named by its symbol alone is the case
` of that type, and a choice is joined at it.
=? infer(side) if wanted == no-type
=? infer-with-expected(side, wanted) if !is-choice-syntax(side)
= infer(side, Want().asking(.want-choice, wanted))

────────────────────
_ fits-choice Bool
    - side TypeId
    - wanted TypeId

relation-legal(relations.compare(side, wanted, true, false, null, module))

────────────────────
_ is-choice-syntax Bool
    - expr SyntaxId

` Whether an expression is `if condition then value else other`.
match tree.nodes[expr]
    | .node-binary-expression(row)
        row.op == .else-op && is-if-syntax(row.lhs)
    ??
        false

────────────────────
_ do optional-side TypeId
    - id SyntaxId
    - side SyntaxId
    - given TypeId
    - empty SyntaxId
    - fitting TypeId

` The join of a choice one side of which is `null`: an optional of the other side, which each
` side converts to, or the other side where it is a union with a case that holds `null`.
. present = types.optional-inner(given)
if given == present && holds-null(given)
    conversions.convert(id, empty, types.null-type, given, .reason-join)
    = given
. fits = fitting != no-type && types.intrinsic-of(present) == .closure
. result = types.optional-of(if fits then fitting else present)
if given != result
    conversions.convert(id, side, given, result, .reason-join)
conversions.convert(id, empty, types.null-type, result, .reason-join)
= result

────────────────────
_ do join-side
    - id SyntaxId
    - side SyntaxId
    - given TypeId
    - present TypeId
    - joined TypeId
    - result TypeId

` Converts a side of a choice to its join: a case named by its symbol alone is cast to the
` type the sides join to, as the reference casts it there.
. settled = settle-joined(side, present, joined)
. arrives = if types.is-optional(given) then types.optional-of(settled) else settled
if arrives != result
    conversions.convert(id, side, arrives, result, .reason-join)

────────────────────
_ do settle-joined TypeId
    - branch SyntaxId
    - value TypeId
    - joined TypeId

` The type a branch of a join arrives in: a case named by its symbol alone that several types
` have is cast to the type the branches join to, as the reference casts it there.
if value == joined || !loose-symbol(branch)
    = value
= infer-with-expected(branch, joined)

────────────────────
_ do infer-comparand TypeId
    - right SyntaxId
    - lhs TypeId

. symbol = symbol-of(right)
if symbol && lhs != invalid-type && lhs != no-type
    . owner = types.optional-inner(lhs)
    if enum-case-decl(types, program, owner, symbol)
        note-enum-case(owner, symbol, right)
        facts.set-node-type(instance, right, owner)
        = owner
if lhs != invalid-type && lhs != no-type && calls-symbol(right)
    = infer-with-expected(right, types.optional-inner(lhs))
= infer(right)

────────────────────
_ do infer-unary TypeId
    - id SyntaxId
    - op Operator
    - operand-syntax SyntaxId

` Types an operator written before its operand. A force of what an arm's condition tested takes
` the type the test gave (`collect-arms`). A force of what the flow does not know to hold a value
` ends what is known of properties, as the reference's panic where it holds none makes calls. A
` function value has no truth for `!` to deny.
if op == .delete-op
    = infer-delete(id, operand-syntax)
if op == .facts-of-op
    = types.string-type
. operand = if op == .optional-force-op && operand-syntax == arm-typing.forced then forced-type else no-type
    .. forced-type = facts.node-type(instance, operand-syntax)
. held = false
if operand == no-type && op == .not-op
    operand = infer-tested(operand-syntax)
else if operand == no-type
    . found = infer-found(operand-syntax, if op == .optional-force-op then Want().adding(.want-forced) else Want())
    operand = found.type
    held = found.held
if operand == invalid-type
    = invalid-type
if op == .not-op
    forget-carried(operand-syntax)
    . completion = types.completion-of(operand)
    . declares = completion.intrinsic == .class && !completion.is-builtin
    . valued = completion.intrinsic == .tuple || completion.intrinsic == .struct
    if declares && calls.demand-method(operand, program.store-atom("!")) == no-instance
        frame.diagnose(id, .illegal-operation, null, operand)
        = invalid-type
    if declares || valued || completion.intrinsic == .string
        . shapes-start = scratch.call-arguments.mark
        . types-start = scratch.types.mark
        . syntax-start = scratch.syntax.mark
        . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
        . not-atom = program.store-atom("!")
        . result = calls.method-call(id, operand-syntax, operand, not-atom, arguments)
        scratch.syntax.rewind(syntax-start)
        scratch.types.rewind(types-start)
        scratch.call-arguments.rewind(shapes-start)
        = plan-answer(id, .plan-call, result)
    if completion.intrinsic == .closure || completion.intrinsic == .binding
        frame.diagnose(id, .illegal-operation)
        = invalid-type
    if is-numeric(types, operand) || completion.intrinsic == .cpointer || types.is-optional(operand)
        facts.set-plan(instance, id, .plan-builtin)
    = types.bool-type
if op == .bitwise-not-op
    . decided = if is-integer(operand) then operand else types.type-row(.int64)
    if operand != decided
        conversions.convert(operand-syntax, operand-syntax, operand, decided, .reason-operand)
    if is-numeric(types, operand)
        facts.set-plan(instance, id, .plan-builtin)
    = decided
if op == .negative-op
    . completion = types.completion-of(operand)
    . kind = completion.intrinsic
    . aggregate = kind == .class || kind == .tuple || kind == .struct
    if !is-numeric(types, operand) && aggregate && !completion.is-builtin
        . shapes-start = scratch.call-arguments.mark
        . types-start = scratch.types.mark
        . syntax-start = scratch.syntax.mark
        . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
        . neg-atom = program.store-atom("-neg")
        . result = calls.method-call(id, operand-syntax, operand, neg-atom, arguments)
        scratch.syntax.rewind(syntax-start)
        scratch.types.rewind(types-start)
        scratch.call-arguments.rewind(shapes-start)
        = plan-answer(id, .plan-call, result)
    if !is-numeric(types, operand)
        frame.diagnose(id, .illegal-operation, null, operand)
        = invalid-type
    facts.set-plan(instance, id, .plan-builtin)
    = operand
if op == .read-op
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    . read-atom = program.store-atom("<-read")
    . result = calls.method-call(id, operand-syntax, operand, read-atom, arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
    = plan-answer(id, .plan-call, result)
if op == .optional-force-op
    if types.is-optional(operand)
        instances.mark-may-panic(instance)
        frame.forget-members()
    . result = types.optional-inner(operand)
    . slot = narrowing.condition-slot(operand-syntax)
    . is-narrowed = false
    . declared = no-type
    if slot && !types.is-optional(operand)
        declared = key-declared(slot)
        is-narrowed = declared != no-type && types.is-optional(declared)
    facts.record-force(instance, id, operand, result, is-narrowed)
    if is-narrowed && held && unsure-stores.length != 0
        unsure-forces += id
        unsure-operands += operand-syntax
        unsure-declared += declared
        unsure-forced += unsure-stores.length as U32
    if is-narrowed && typing-lazies.length != 0
        if scratch.narrowed-since(lazy-marks[lazy-marks.length - 1], slot!) == no-type
            forcing-lazies += typing-lazies[typing-lazies.length - 1]
            forcing-facts += (facts.forces.length - 1) as FactId
            forcing-declared += declared
    = result
if op == .type-of-op
    if types.intrinsic-of(operand) == .class
        note-loose(operand-syntax)
    = type-info-of(id, operand)
if op == .facts-of-op
    = types.string-type
decline(operand-syntax)
= invalid-type

────────────────────
_ do infer-delete TypeId
    - id SyntaxId
    - operand-syntax SyntaxId

do match? tree.nodes[operand-syntax]
    | .node-index-expression(row)
        . object = infer(row.object)
        . key = infer(row.index)
        if object == invalid-type || key == invalid-type
            = invalid-type
        . name = program.store-atom("-=[]")
        . result = calls.operator-call(operand-syntax, object, name, row.index, key)
        if result == object && intrinsic-is-tuple-like(types.intrinsic-of(object))
            facts.set-plan(instance, operand-syntax, .plan-store-answer)
            note-replacement(operand-syntax, object, result)
        = if result == types.void-type then object else result
decline(id)
= invalid-type

────────────────────
_ do infer-cast TypeId
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A case named by its symbol alone is cast as the reference casts it: settled by the target
` first (`contextual-symbol`), and noted where the cast leaves it of no one type. A target that
` names nothing is reported where it is written. An event cast is wanted as the target, as
` `use-event` says.
. target = types.evaluate-type(module, tree, rhs, frame.env)
. value = infer(lhs, Want().escaping(target, lhs))
if target == invalid-type
    report-missing-type(rhs, frame.env)
    = invalid-type
if value == invalid-type
    = target
. symbol = symbol-of(lhs)
if symbol
    . owner = contextual-symbol(types, relations, target, symbol, module)
    if owner != invalid-type && owner != value
        facts.replace-node-type(instance, lhs, owner)
        note-enum-case(owner, symbol, lhs)
        value = owner
    else if owner != invalid-type
        calls.settle-unfound(lhs)
. cast = cast-value(id, lhs, value, target)
if cast != invalid-type
    note-unsettled(lhs, target, true)
= cast

────────────────────
_ do cast-value TypeId
    - id SyntaxId
    - lhs SyntaxId
    - value TypeId
    - target TypeId

. callable = types.completions[value].intrinsic
if callable == .closure || callable == .binding
    = conversions.convert(id, lhs, value, target, .reason-explicit)
if is-const-array(value) && !is-const-array(target) && cpointer-item(target) != no-type
    frame.diagnose(id, .illegal-cast, null, value, target)
    = invalid-type
. relation = relations.compare-explicit(value, target, module)
. chooses = relation-legal(relation) && types.intrinsic-of(target) == .or
. answer = conversions.answer-of(relation)
if answer != no-type
    relation.to = answer
    relation.unified = answer
if relation-legal(relation) && relation.kind != .relation-same
    . requested = if chooses then target else no-type
    conversions.record-conversion(id, relation, .reason-explicit, false, requested, lhs)
    . down = relation.kind == .relation-down-cast || relation.kind == .relation-interface-down-cast
    if down || relation.kind == .relation-unwrap-cast
        instances.mark-may-panic(instance)
    if is-caught-cast(relation, value, target)
        demand-union-error()
        facts.set-plan(instance, id, .plan-caught-cast)
        . mark = scratch.types.mark
        scratch.types.push(types.union-error-type)
        = result-type(types, target, mark)
. collides = relation.reason == .reason-ambiguous || relation.reason == .reason-conflict
if !relation-legal(relation) && (collides || !explicit-cast-allowed(value, target))
    conversions.report-illegal(id, relation, value, target)
    = invalid-type
if !relation-legal(relation) && reinterprets(value, target)
    facts.set-plan(instance, id, .plan-reinterpret)
. open = types.completions[target].has-variables || relations.holds-alternatives(target)
= if chooses || (open && relation-legal(relation)) then relation.to else target

────────────────────
_ is-caught-cast Bool
    - relation Relation
    - value TypeId
    - target TypeId

` Whether a cast is one out of a union written under `catch`, to one of its cases and not to
` text: where it fails it gives an error in place of its value.
|? frame.surround.catch-depth == 0 || (relation.kind != .relation-unwrap-cast && not-down-cast)
    false
|? target == types.string-type || types.completions[target].has-variables
    false
??
    types.intrinsic-of(value) == .union && relation.to == target

.. not-down-cast = relation.kind != .relation-down-cast

────────────────────
_ do reinterprets Bool
    - value TypeId
    - target TypeId

` Whether a cast is between an atom and a text, which keeps the bits of the value: an atom
` is a pointer at its text.
. source = types.intrinsic-of(value)
. destination = types.intrinsic-of(target)
if source == .atom && destination == .string
    = true
= source == .string && destination == .atom

────────────────────
_ explicit-cast-allowed Bool
    - value TypeId
    - target TypeId

` A number converts to any other, except between two units no equality relates.
|? is-unit-class(types, value) && is-unit-class(types, target)
    false
|? is-numeric(types, value) && is-numeric(types, target)
    true
??
    reinterprets(value, target)

────────────────────
_ do infer-range TypeId
    - id SyntaxId
    - op Operator
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId

. item = range-item(id, left-syntax, right-syntax, increment)
if item == invalid-type
    = invalid-type
= range-construction(id, op, item, left-syntax, right-syntax, increment)

────────────────────
_ do range-item TypeId
    - range SyntaxId
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId
    - peer TypeId = no-type

` The item of a range: what its sides and its step unify to, each converted to that where
` it is written. An integer written with no suffix at one side is of the type of the other, and
` one written as the step of the type of the sides, as beside an operator, and the range is of
` the type of the other side. Sides written so beside a float step are of the step's type. A range with no step written steps by one, which is converted to
` an item that is no number at the range itself. Such an integer takes the integer type of a
` peer given, as a loop's pattern states it, before the type of the other side. Sides of two
` integer types neither converts to unasked are of the type arithmetic promotes them to.
. left = if left-syntax != 0 then infer(left-syntax) else types.position-type
. right = if right-syntax != 0 then infer(right-syntax) else types.position-type
. step = if increment != 0 then infer(increment) else no-type
if left == invalid-type || right == invalid-type || step == invalid-type
    = invalid-type
if peer != no-type && is-integer(peer)
    left = conversions.adapted-literal(left-syntax, left, peer)
    right = conversions.adapted-literal(right-syntax, right, peer)
. left-given = left
. right-given = right
left = conversions.adapted-literal(left-syntax, left, right)
right = conversions.adapted-literal(right-syntax, right, left)
. relation = relations.unify(left, right, module)
. promoted = !relation-legal(relation) && is-integer(left) && is-integer(right)
if !relation-legal(relation) && !promoted
    frame.diagnose(range, .illegal-operation, null, left, right)
    = invalid-type
. item = if promoted then promotion else if left != left-given then right else right-adapted
    .. promotion = promote(types, left, right)
    .. right-adapted = if right != right-given then left else relation.unified
. step-given = step
step = conversions.adapted-literal(increment, step, item)
if step != no-type && step == step-given
    . stepped = relations.unify(item, step, module)
    if relation-legal(stepped)
        item = stepped.unified
    else
        left = conversions.adapted-literal(left-syntax, left, step)
        right = conversions.adapted-literal(right-syntax, right, step)
        if left != step || right != step
            frame.diagnose(range, .illegal-operation, null, item, step)
            = invalid-type
        item = step
if left-syntax != 0 && left != item
    range-side(left-syntax, left, item, promoted)
if right-syntax != 0 && right != item
    range-side(right-syntax, right, item, promoted)
if increment != 0 && step != item
    conversions.convert(increment, increment, step, item, .reason-element)
if increment == 0 && !intrinsic-is-numeric(types.intrinsic-of(item))
    conversions.convert(range, range, types.type-row(.int64), item, .reason-step)
= item

────────────────────
_ do range-side
    - side SyntaxId
    - given TypeId
    - item TypeId
    - promoted Bool

` Brings a side of a range to its item: as an element converts, or where the sides are integers
` neither converts to unasked, by the cast arithmetic makes to the type both promote to.
if !promoted
    conversions.convert(side, side, given, item, .reason-element)
    =
conversions.record-conversion(side, conversions.compare-held(given, item), .reason-element)

────────────────────
_ do range-construction TypeId
    - id SyntaxId
    - op Operator
    - item TypeId
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId

. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
for _ in 0 .. < 3
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(item)
scratch.syntax.push(if left-syntax != 0 then left-syntax else id)
scratch.syntax.push(if right-syntax != 0 && left-syntax != 0 then right-syntax else id)
scratch.syntax.push(if increment != 0 then increment else id)
if op == .range-through-op
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(types.bool-type)
    scratch.syntax.push(id)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. env = types.class-env(types.range-decl.module, types.range-decl.decl)
. pattern = env.this-type
types.env-release(env)
. result = calls.construction-on(id, pattern, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do infer-tuple TypeId
    - items RowRange'SyntaxId

. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0
. valid = true
for item in tree.children[items]
    . field = infer(item)
    if field == invalid-type
        valid = false
    note-loose(item)
    note-escape(item)
    scratch.names.push(types.index-atom(position))
    scratch.types.push(field)
    position += 1
if !valid
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = invalid-type
= types.intern-tuple(mark, names-mark)

────────────────────
_ do note-escape
    - value SyntaxId

` A value the reference stores where it no longer follows it, in a local, a property or a field
` of a tuple, ends what it knows of what the value is read from (`forget-escaped`), or of
` every property where the value is `this` (`forget-receiver`). A cast or a `!` of a value is
` read from what the value is.
. subject = escaped-subject(value)
do match? tree.nodes[subject]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, subject)
        if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-this
            frame.forget-receiver()
            =
        . key = narrowing.base-key(subject)
        if key
            frame.forget-escaped(key)
    | .node-get-expression(row)
        if row.is-optional
            =
        . shared = narrowing.receiver-member(row.object, row.name)
        if shared
            frame.forget-escaped(shared)
            =
        . base = narrowing.base-key(row.object)
        if base
            . key = frame.find-path-key(base, row.name)
            if key
                frame.forget-escaped(key)

────────────────────
_ do forget-store-root Bool
    - object SyntaxId

` A store to a property of an object ends what the reference knows of every property of the
` name the object is read from through properties, and of every path from it, and it ends
` what it knows of every property of the receiver where that name is the receiver or one of
` its properties. What is known of a local itself the reference keeps. A store through a row of
` a table read in place (`answers-in-place`) ends what is known of every property, as the
` reference checks the table there and its failure makes calls. Answers whether the object is
` read from a local, the receiver or such a row, where the store ends just that.
. root = object
while tree.nodes[root] is .node-get-expression
    do match? tree.nodes[root]
        | .node-get-expression(row)
            root = row.object
do match? tree.nodes[root]
    | .node-index-expression
        if facts.answers-in-place(instance, root)
            frame.forget-members()
            = true
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, root)
        if resolution.kind == .resolve-member
            frame.forget-receiver()
            = true
        if resolution.kind != .resolve-slot
            = false
        if bindings.slots[resolution.slot].kind == .slot-this
            frame.forget-receiver()
            = true
        frame.forget-escaped(slot-key(resolution.slot))
        = true
= false

────────────────────
_ escaped-subject SyntaxId
    - value SyntaxId

match tree.nodes[value]
    | .node-cast-expression(row)
        escaped-subject(row.lhs)
    | .node-unary-expression(row)
        if row.op == .optional-force-op then escaped-subject(row.operand) else 0
    ??
        value

────────────────────
_ do infer-header TypeId
    - id SyntaxId
    - expr SyntaxId
    - items RowRange'SyntaxId

` A header gives each item below it to the `with` of what the one before gave. Each call is
` recorded at the header, in order. The first is made on the value written, each after on the
` header itself, which stands for the answer of the one before; one of those that would
` convert its receiver is declined, since the conversion would be kept at the header.
. left = infer(expr)
. with-atom = program.store-atom("with")
. object = expr
for item in tree.children[items]
    if left == invalid-type
        = invalid-type
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
    scratch.types.push(infer(item))
    scratch.syntax.push(item)
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    left = calls.method-call(id, object, left, with-atom, arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
    if object == id && left != invalid-type && facts.first-conversion(instance, id) != no-fact
        decline(id)
        = invalid-type
    object = id
= left

────────────────────
_ do infer-list TypeId
    - id SyntaxId
    - items RowRange'SyntaxId
    - want Want = Want()

` The items are joined, unless the list is expected as a list of a type each item converts to on
` its own (`want-items`), which each is made then, as a declared local of that type would be.
instances.mark-may-panic(instance)
. start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. count = 0
for item in tree.children[items]
    scratch.types.push(infer(item))
    scratch.syntax.push(item)
    count += 1
. peer = literal-peer(start, syntax-start, count)
. typed = scratch.types.mark
for offset in 0 .. < count
    scratch.types.push
        - conversions.adapted-literal
            - scratch.syntax[syntax-start + offset]
            - scratch.types[start + offset]
            - peer
. joined = invalid-type
. valid = true
for offset in 0 .. < count
    if scratch.types[typed + offset] == invalid-type
        valid = false
if valid
    . expected = expected-item(want)
    joined = if count != 0 then relations.join(typed) else invalid-type
    if count != 0 && expected != no-type && items-fit(typed, count, expected)
        joined = expected
    if joined == invalid-type
        frame.diagnose(id, .stated, program.store-atom("Incompatible types in list"))
        valid = false
if valid
    for offset in 0 .. < count
        . element = scratch.types[typed + offset]
        . site = scratch.syntax[syntax-start + offset]
        if element != joined && symbol-of(site) != null
            element = infer-with-expected(site, joined)
        if element != joined
            conversions.convert(site, site, element, joined, .reason-element)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(start)
if !valid
    = invalid-type
. list-mark = scratch.types.mark
scratch.types.push(joined)
. list-type = types.class-named-with-args(module, types.list-atom!, list-mark)
calls.note-list(id, list-type)
= list-type

────────────────────
_ do expected-item TypeId
    - want Want

` The item of the list type a list is expected as (`want-items`), or no type.
if !want.asks(.want-items)
    = no-type
. expected = types.optional-inner(want.type)
types.complete(expected)
do match? types.rows[expected]
    | .type-class(row)
        if row.module == types.list-decl.module && row.decl == types.list-decl.decl && row.args.count != 0
            . item = types.child-type(row.args, 0)
            types.complete(item)
            if !types.completions[item].has-variables
                = item
= no-type

────────────────────
_ do items-fit Bool
    - mark ScratchMark
    - count Int
    - expected TypeId

for offset in 0 .. < count
    if !fits-choice(scratch.types[mark + offset], expected)
        = false
= true

────────────────────
_ do infer-get Found
    - id SyntaxId
    - object-syntax SyntaxId
    - name Atom
    - is-optional Bool
    - want Want

. owner = static-owner(object-syntax)
if owner != no-type
    facts.set-node-type(instance, object-syntax, type-info-of(object-syntax, owner))
    if want.asks(.want-event) && (types.intrinsic-of(owner) == .class || owner-interface)
        . qualified = event-of(owner, name, true)
        if qualified
            = qualified-event(id, qualified, want)
    .. owner-interface = types.intrinsic-of(owner) == .interface
    = Found(static-get(id, owner, name))
. chain-expr = optional-chain-expr(object-syntax)
. object = no-type
. own = no-type
if chain-expr != 0
    . chained-found = infer-found(chain-expr)
    object = chained-found.type
    own = chained-found.link
    if object != invalid-type && types.is-optional(object)
        facts.set-node-type(instance, object-syntax, types.optional-inner(object))
    else
        facts.set-node-type(instance, object-syntax, object)
else
    . object-found = infer-found(object-syntax, Want().adding(.want-receiver))
    object = object-found.type
    own = object-found.link
if object == invalid-type
    = Found(invalid-type)
if types.intrinsic-of(object) == .type-info
    = Found(static-get(id, type-info-about(object), name))
if name.text == "path" && !is-optional && is-machine-union(object)
    = Found(plan-machine-path(id, object))
. form = if is-optional then note-chain(id, id, object) else ChainForm.chain-plain
if form == .chain-absent || absent-after(object-syntax, object)
    = Found(types.null-type)
. optional = form == .chain-tested
. doubted = false
if !optional && (frame.members-narrowed || frame.narrowed-members.length != 0 || stable-paths)
    . shared = narrowing.receiver-member(object-syntax, name)
    . base = narrowing.base-key(object-syntax)
    . key = shared
    if !key && base
        key = frame.find-path-key(base, name)
    if key && frame.is-doubted(key)
        if !want.asks(.want-store)
            decline(id)
            = Found(invalid-type)
        doubted = true
    if key && frame.knows-member(key)
        . narrowed = forced-member(id, key, want)
        if narrowed != no-type
            plan-narrowed-read(id, object, name)
            if facts.plan-of(instance, id) == .plan-none
                plan-case-read
                    - id
                    - narrowed-from(key, object, name)
                    - frame.narrowed-cases(key)
                    - narrowed
            = Found(narrowed).doubting(doubted).holding(want.asks(.want-forced))
.. stable-paths = frame.path-stable.length != 0
. receiver = link-receiver(object-syntax, object, own, optional)
. chained = (optional || optional-chained(object-syntax)) && types.is-optional(object)
if chained && optional && chain-expr == 0
    facts.unwrapped.append(UnwrappedFact(instance, object-syntax, receiver))
. source = projected-from(object-syntax, receiver)
if source != no-type && !answers(receiver, name)
    receiver = source
. found = read-property(id, object-syntax, receiver, name, want).doubting(doubted)
if found.type == invalid-type
    = found
if is-super-syntax(object-syntax) && !calls-getter(id)
    frame.diagnose(object-syntax, .stated, program.store-atom("Bare super is not a value"))
    = found.typed(invalid-type)
= found.typed(if chained then types.optional-of(found.type) else found.type).linking(found.type)

────────────────────
_ do qualified-event Found
    - id SyntaxId
    - event NamedEvent
    - want Want

` An event a loop names by the class that declares it, which the loop hears as it bubbles up to
` the object that owns the loop. A private event or one published by key does not bubble, which
` is an error at the node.
if event.is-private
    frame.diagnose(id, .stated, program.store-atom("Private event \"${event.name.text}\" does not bubble, so it cannot be named by its class"))
    = Found(invalid-type)
if event.key != no-type
    frame.diagnose(id, .stated, program.store-atom("Keyed event \"${event.name.text}\" does not bubble, so it cannot be named by its class"))
    = Found(invalid-type)
= use-event(id, event, want)

────────────────────
_ do is-machine-union Bool
    - union TypeId

` Whether a type is the union of a state machine: the only union told apart by where it is made.
do match? types.rows[union]
    | .type-named-union(row)
        = row.made-at != 0
= false

────────────────────
_ do plan-machine-path TypeId
    - id SyntaxId
    - union TypeId

` `path` read from a value of a machine's union, as the reference answers it: a `List'String`
` of the names of its active cases, made empty and given each name by its `append`.
. mark = scratch.types.mark
scratch.types.push(types.string-type)
. list = types.class-named-with-args(module, types.list-atom!, mark)
if list == invalid-type || list == no-type
    decline(id)
    = invalid-type
calls.note-list(id, list)
. given = scratch.types.mark
scratch.types.push(types.string-type)
. append = calls.demand-runtime-call(module, list, program.store-atom("append"), given)
scratch.types.rewind(given)
if append == no-instance
    decline(id)
    = invalid-type
do facts.record-call(instance, id, append, .call-method, scratch.no-fills, false)
facts.set-plan(instance, id, .plan-machine-path)
instances.mark-may-panic(instance)
= list

────────────────────
_ do plan-narrowed-read
    - id SyntaxId
    - object TypeId
    - name Atom

` A member a test narrowed is read as any member is, and only its type is the narrowed one: a
` field of a table's row is read from its column.
. kind = types.intrinsic-of(object)
if kind != .table-row && kind != .immutable-table-row
    =
. row = row-struct-of(object)
if row == no-type || types.intrinsic-of(row) != .struct
    =
. column = types.property-named(row, name)
if column && types.properties[column].storage-kind == .storage-eager
    plan-table(id, .table-field, types.properties[column].slot)

────────────────────
_ do plan-array-field
    - id SyntaxId
    - object-syntax SyntaxId
    - name Atom

` A field of numbers that a struct declares, read of an item of an array read by an index, is
` read as TypeScript reads one: where the array's storage holds the item, when the index is
` less than the array's size, and of what the function that answers for an index the array
` does not hold gives anywhere else.
if facts.first-call(instance, id) != no-fact
    =
do match? tree.nodes[object-syntax]
    | .node-index-expression(row)
        if row.is-optional
            =
        . item = facts.node-type(instance, object-syntax)
        if types.intrinsic-of(item) != .struct
            =
        . found = types.property-named(item, name)
        if !found
            =
        . field = types.properties[found]
        if field.storage-kind != .storage-eager || field.owner != item
            =
        calls.plan-array-item
            - object-syntax
            - facts.node-type(instance, row.index)
            - facts.first-call(instance, object-syntax)
            - field.type

────────────────────
_ do calls-getter Bool
    - id SyntaxId

` Whether a read is answered by a getter. `super` is the receiver of a call and no value: a
` read after it that calls nothing has no object to read.
. fact = facts.first-call(instance, id)
while fact != no-fact
    if facts.calls[fact].form == .call-getter
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ compiles-probe Bool
    - id SyntaxId

program.compiles-probe(module, instances.rows[instance].decl, id)

────────────────────
_ do check-probe
    - id SyntaxId
    - row ASTProbe

` A probe that compiles writes a record through the probes module, each call recorded at the
` probe in the order it makes them (`record-probe-call`): the head of the record, of the object it
` is written of where it has one, then each value written in it, then the flush the module makes
` once enough is written. The texts written in a log are its template, and no values.
. found = probes-module(id)
if !found
    =
. probes = found
. event = row.name != null
. object = check-probe-object(row.object)
if object == invalid-type
    =
. head = if event then "probe-event-head" else "probe-log-head"
if object != no-type
    head = if event then "probe-object-event-head" else "probe-object-log-head"
if !record-probe-head(id, probes, head, object) || !check-probe-values(id, probes, row.content, !event)
    =
record-probe-flush(id, probes)

────────────────────
_ do check-probe-assign
    - id SyntaxId
    - row ASTProbeAssign

` A probe that assigns a property writes an event named `set-property`, of the object it is written
` of where it has one: the key, then the value. Its record is flushed at once.
. found = probes-module(id)
if !found
    =
. probes = found
. object = check-probe-object(row.object)
if object == invalid-type
    =
. head = if object != no-type then "probe-object-event-head" else "probe-event-head"
if !record-probe-head(id, probes, head, object) || !record-probe-call(id, probes, "probe-write", [types.string-type]) || !check-probe-value(id, probes, row.content, false)
    =
record-probe-flush(id, probes, "probe-flush")

────────────────────
_ do check-probe-counter
    - id SyntaxId
    - row ASTProbeCounter

` A counter adds to the count the probes module keeps under its key, of the object it is written
` of where it has one, by one or by what it is given, which is converted to `U64`. One that
` compiles only as a metric of the profile adds to the metric instead, which the runtime counts.
. found = probes-module(id)
if !found
    =
. probes = found
. profiles = row.object == 0 && uncounted && program.probes.compiles-profile(row.key.text)
    .. uncounted = !program.probes.compiles-counter(program.modules[module].name, row.key.text)
. object = check-probe-object(row.object)
if object == invalid-type
    =
. delta = types.type-row(.uint64)
if row.delta != 0
    . got = infer-with-expected(row.delta, delta)
    if got == invalid-type || got == no-type
        =
    if conversions.convert(row.delta, row.delta, got, delta, .reason-argument, true, true) == invalid-type
        =
. short = types.type-row(.uint16)
if profiles
    facts.record-call(instance, id, no-instance, .call-probe-metric, scratch.no-fills, false)
else if object == no-type
    record-probe-call(id, probes, "probe-counter-add", [short, delta], .call-probe-head)
else
    record-probe-call
        - id
        - probes
        - "probe-object-counter-add"
        - [short, object, short, delta]
        - .call-probe-head

────────────────────
_ do check-probe-group
    - id SyntaxId
    - row ASTProbeGroup

` A group writes a record where it begins and one where it ends, each a record of its own the
` probes module opens or closes the group by, then flushes. A group of data records events, of the
` object it is written of where it has one, and one written as a log records logs. The values of a
` group are written where it begins, or where it ends where it only ends; a log that only ends
` writes them in a log of their own, then ends. A group that begins and ends ends where the block
` it is written in is left (see the emitter's `emit-probe-group`). A group of data of no object
` and no values that compiles only as a timer of the profile begins and ends the timer instead,
` which the runtime times. One that begins and ends of an object is declined.
. found = probes-module(id)
if !found
    =
. probes = found
. key = if row.key then row.key.text else ""
. objects = row.is-data && row.object != 0
if empty-data && uncompiled && program.probes.compiles-profile(key)
    facts.record-call(instance, id, no-instance, .call-probe-metric, scratch.no-fills, false)
    =
.. empty-data = row.is-data && !objects && (row.is-begin || row.is-end) && row.content.count == 0
.. uncompiled = !program.probes.compiles-data(program.modules[module].name, key)
if objects && row.is-begin && row.is-end
    decline(id)
    =
. object = if objects then check-probe-object(row.object) else no-type
if object == invalid-type
    =
. begins = if row.is-data then "probe-group-push-event" else "probe-group-push"
. ends = if row.is-data then "probe-group-pop-event" else "probe-group-pop"
if objects
    begins = "probe-group-push-object"
    ends = "probe-group-pop-object"
. logs = !row.is-data
if row.is-begin
    if !record-probe-head(id, probes, begins, object, true) || !check-probe-values(id, probes, row.content, logs) || !record-probe-flush(id, probes)
        =
    if !row.is-end
        =
    if record-probe-head(id, probes, ends, object, true)
        record-probe-flush(id, probes)
    =
if !row.is-end
    =
if logs
    if !record-probe-head(id, probes, "probe-log-head", no-type) || !check-probe-values(id, probes, row.content, true) || !record-probe-flush(id, probes)
        =
    if record-probe-head(id, probes, ends, no-type, true)
        record-probe-flush(id, probes)
    =
if record-probe-head(id, probes, ends, object, true) && check-probe-values(id, probes, row.content, false)
    record-probe-flush(id, probes)

────────────────────
_ do probes-module ModuleId?
    - id SyntaxId

` The probes module, which a probe that compiles writes its records through, or none, where the
` probe is declined.
. found = program.module-by-name(probes-module-name)
if !found
    decline(id)
    = null
= found as ModuleId

────────────────────
_ do record-probe-flush Bool
    - id SyntaxId
    - probes ModuleId
    - name String = "probe-flush-if-needed"

` Records at a probe the call that ends a record it writes: the flush the probes module makes once
` enough is written, or the one it makes at once.
. none [TypeId]
= record-probe-call(id, probes, name, none)

────────────────────
_ do check-probe-object TypeId
    - object SyntaxId

` The type of the object a probe is written of, or no type where it is written of none. One the
` probes module gives no id, which is neither an object of a class nor an array nor
` `Inspectable`, is declined.
if object == 0
    = no-type
. got = infer(object)
if got == invalid-type || got == no-type
    = invalid-type
. cast = probe-cast(types, got)
if cast != .probe-object && cast != .probe-array
    decline(object)
    = invalid-type
= got

────────────────────
_ do check-probe-values Bool
    - id SyntaxId
    - probes ModuleId
    - content RowRange'SyntaxId
    - logs Bool

` Records the writes of the values written in a probe, in order. The texts written in a log are
` its template, and no values.
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    if !check-probe-value(id, probes, item, logs)
        = false
= true

────────────────────
_ do check-probe-value Bool
    - id SyntaxId
    - probes ModuleId
    - item SyntaxId
    - logs Bool

` Records the write of a value written in a probe, as its type is cast (`probe-cast`): as it is, by
` the id of its object, or as its text, made as a print makes it, by a call that ends what is known
` of every property, here and in the reference. A log writes an object or an array
` as its text too, but for a snapshot (`$!`), whose object the probes module writes the snapshot
` of, and a preview (`$?`). A preview of a value written as its text writes the name of its type
` instead, and makes no text.
. value = item
. snapshot = false
. preview = false
do match? tree.nodes[item]
    | .node-probe-snapshot(row)
        value = row.content
        snapshot = true
    | .node-probe-preview(row)
        value = row.content
        preview = true
. got = infer(value)
if got == invalid-type || got == no-type
    = false
. cast = probe-cast(types, got)
if cast == .probe-number || cast == .probe-text
    = record-probe-call(id, probes, "probe-write", [got])
if preview && cast == .probe-converted
    = record-probe-call(id, probes, "probe-write", [types.string-type])
if cast == .probe-converted || (logs && !snapshot && !preview)
    note-unsettled(value, types.string-type)
    if conversions.convert(value, value, got, types.string-type, .reason-print) == invalid-type
        = false
    frame.forget-members()
    = record-probe-call(id, probes, "probe-write", [types.string-type])
= record-probe-call
    - id
    - probes
    - "probe-write-object"
    - [got, types.type-row(.uint16), types.bool-type]

────────────────────
_ do record-probe-head Bool
    - id SyntaxId
    - probes ModuleId
    - name String
    - object TypeId
    - groups Bool = false

` Records the call that starts a record of a probe, given the probe's number, and for one of an
` object the object and the number of its class, after the kind of record it opens or closes
` where it `groups`.
. short = types.type-row(.uint16)
if object == no-type
    = record-probe-call(id, probes, name, [short], .call-probe-head)
if groups
    = record-probe-call
        - id
        - probes
        - name
        - [short, types.well-known-type(probes-module-name, "ProbeType"), object, short]
        - .call-probe-head
= record-probe-call(id, probes, name, [short, object, short], .call-probe-head)

────────────────────
_ do record-probe-call Bool
    - id SyntaxId
    - probes ModuleId
    - name String
    - arguments [TypeId]
    - form CallForm = .call-probe

` Records at a probe a call of a function of the probes module, given values of types; one no
` function takes is declined. An error that leaves it is reported where it is made, and what
` follows runs, and making its text may panic.
. mark = scratch.types.mark
for argument in arguments
    scratch.types.push(argument)
. callee = calls.demand-runtime-call(probes, no-type, program.store-atom(name), mark)
scratch.types.rewind(mark)
if callee == no-instance
    decline(id)
    = false
demand-errors(callee)
if instances.signatures[callee].errors.count != 0
    instances.mark-may-panic(instance)
facts.record-call(instance, id, callee, form, scratch.no-fills, false)
= true

────────────────────
_ do infer-print TypeId
    - id SyntaxId
    - body SyntaxId

` The values written in a print are made text one by one. Several are joined by a function
` that polls, so the instance may panic.
do match? tree.nodes[body]
    | .node-tuple-syntax(row)
        instances.mark-may-panic(instance)
        . narrowed = frame.members-narrowed
        for item in tree.children[row.items]
            infer-print(id, item)
            frame.doubt-members-at(narrowed)
        frame.forget-members()
        = types.void-type
. printed = infer(body)
frame.forget-members()
if printed == invalid-type || printed == no-type
    = invalid-type
note-unsettled(body, types.string-type)
if printed != types.string-type
    conversions.convert(id, body, printed, types.string-type, .reason-print)
= types.void-type

────────────────────
_ do infer-match TypeId
    - id SyntaxId
    - subject-syntax SyntaxId
    - body SyntaxId
    - is-optional Bool
    - helper SyntaxId
    - is-block Bool
    - want Want = Want()

. expected = arms-expected
arms-expected = no-type
. subject = no-type
if subject-syntax != 0
    subject = infer-unprojected(subject-syntax)
. saved-helper = helping
helping = helping.helper = null
helping = helping.site = 0
helping = helping.rolls = false
helping = helping.explicit = false
helping = helping.body = 0
if helper != 0 && !type-helper(helper)
    helping = saved-helper
    = invalid-type
. own-matching = matching
matching = matching.rows = subject-syntax != 0 && reads-row(subject-syntax)
if matching.rows
    facts.mark-checked-row(instance, subject-syntax)
matching = matching.subject = subject
arms-expected = expected
matching = matching.optional = is-optional
matching = matching.open = tested-match == id
tested-match = 0
matching = matching.closed = if is-block && !is-optional && subject-syntax != 0 then body else 0
matching = matching.arms = if is-block && subject-syntax != 0 then body else 0
. saved-stream = rule-streaming
matching = matching.case = subject-syntax
rule-streaming = rule-streaming.matched = 0
if subject-syntax != 0 && tree.stream-statement(body) != 0
    rule-streaming = rule-streaming.matched = tree.stream-statement(body)
    helping = helping.body = rule-streaming.matched
    . subject-slot = arm-slot(id, .slot-it)
    if subject-slot != no-slot && subject != no-type && subject != invalid-type
        frame.assign(subject-slot, subject)
. result = check-statement(body, if want.asks(.want-match-statement) then Want().adding(.want-match-statement) else Want())
if result != invalid-type && helping.rolls && helping.helper!.rollback == no-type
    frame.diagnose
        - if rule-streaming.matched != 0 then rule-streaming.matched else id
        - .stated
        - program.store-atom
            - "Pattern @rollback helper must implement PatternRollback with a concrete Mark type"
    result = invalid-type
rule-streaming = saved-stream
helping = saved-helper
matching = own-matching
arms-expected = no-type
if expected != no-type && !is-optional
    . recorded = facts.node-type(instance, body)
    if !types.is-optional(expected) && recorded == types.optional-of(expected)
        facts.replace-node-type(instance, id, recorded)
    else if recorded != no-type
        facts.set-node-type(instance, id, recorded)
if result == no-type
    = invalid-type
= if is-optional then types.optional-of(result) else result

────────────────────
_ do type-helper Bool
    - helper SyntaxId

` Types the helper a stream match is given with `with`, after its subject, and resolves what it
` can do as the reference does, reporting there what the reference reports. One that can do
` nothing is reported; one that can is the helper of the match's pattern. One whose collector
` storages disagree, or that is no object, has no shape here. False where the match has no shape.
. type = infer(helper)
if type == invalid-type
    = false
if type == no-type
    decline(helper)
    = false
. resolved = pattern-helper(types, type)
if resolved.problem != null
    frame.diagnose(helper, .stated, program.store-atom(resolved.problem))
    = false
if !resolved.is-active
    frame.diagnose
        - helper
        - .stated
        - program.store-atom("Pattern helper implements no pattern capability")
    = false
if resolved.storage == invalid-type || types.intrinsic-of(type) != .class
    decline(helper)
    = false
facts.set-plan(instance, helper, .plan-pattern-helper)
helping = helping.helper = resolved
helping = helping.site = helper
= true

────────────────────
_ do infer-stream-match TypeId
    - id SyntaxId
    - pattern SyntaxId
    - is-root Bool

` A stream pattern a match runs, typed over a stream of its own: a pattern around it, whose
` action holds the match, reads its own stream again after.
. buffer = stream-view
. result = infer-stream-pattern(id, pattern, is-root)
stream-view = buffer
= result

────────────────────
_ do infer-stream-pattern TypeId
    - id SyntaxId
    - pattern SyntaxId
    - is-root Bool

` A stream pattern a match runs on the String it is on. The String is read through a
` `TextTokenStream`, whose buffer holds its UTF-8 bytes, by calls the type pass records at the
` pattern, in the order `record-stream-protocol` makes them. Its arms are typed as the
` reference declares them and joined, and its value is optional unless its last arm always
` passes. Where an arm gives the text it matched, or an action reads it as `it`, the call
` that slices it from the stream's buffer is recorded there. A match that is returned has the
` type the function returns, as its arms do, even those that give an optional, or what that
` type holds where it is optional. One that always passes panics where the stream defers its last arm, which no stream a
` String is read through does. The names the pattern captures are typed before its arms. The
` match `if` or `while` tests a pattern with gives true where its arm ran, and false where
` none did.
if id != rule-streaming.matched
    = infer-scoped-pattern(id, pattern, is-root)
if matching.subject == invalid-type
    = invalid-type
if is-root && !iterates(matching.subject) && natural-item(matching.subject) == no-type
    frame.diagnose(id, .stated, program.store-atom("Can't convert to iterable"))
    = invalid-type
if !is-root || !record-stream-protocol(id, matching.subject)
    decline(id)
    = invalid-type
. returned = facts.node-type(instance, id)
. target = no-type
if returned != no-type && returned != invalid-type
    target = if types.is-optional(returned) then types.optional-inner(returned) else returned
. result = type-stream-arms(pattern, true, target, target != returned)
if result == invalid-type
    = invalid-type
if matching.open
    if result != types.bool-type
        decline(id)
        = invalid-type
    facts.set-plan(instance, id, .plan-open)
    = result
if !always-passes(pattern)
    = types.optional-around(result)
instances.mark-may-panic(instance)
= result

────────────────────
_ do infer-scoped-pattern TypeId
    - id SyntaxId
    - pattern SyntaxId
    - is-root Bool

` A stream pattern written in the code of a function declared over the items of a stream, as
` the reference runs it: on the stream the function is given, from where the stream stands,
` through the calls a match on that stream records at the pattern. Its arms are typed and
` joined with no type to give but their own, and one that gives no value gives what its last
` part gives where that is optional, as the reference gives it. It gives an optional
` `CaptureResult` of the stream's items and what the arms give, which holds the items the
` pattern read beside that, and nothing where no arm passed. One in the code of a local rule
` runs on the stream the rule is called on, as `coded-rule-type` says. One in any other
` function is an error, and one in the arms of another pattern or under a helper has no shape
` here. Where the
` metrics of stream patterns compile, each result it gives is counted, as the reference counts it.
` A function or local rule a pattern on a String calls reads the stream's UTF-8 bytes, and its
` `CaptureResult` holds those bytes.
. stream = if rule-streaming.stream != no-type then rule-streaming.stream else scope-stream()
. texts = if rule-streaming.stream != no-type then rule-streaming.encoded else instances.rows[instance].encoded
if is-root || stream == no-type || rule-streaming.matched != 0 || helping.helper != null
    if stream == no-type && rule-streaming.matched == 0 && helping.helper == null
        frame.diagnose(id, .stated, program.store-atom(streamless-text))
    else
        decline(id)
    = invalid-type
    .. streamless-text = "This pattern has no stream to read; outside a rule, write it in a match whose arms are all ~ patterns"
. saved-rule = rule-streaming
rule-streaming = rule-streaming.stream = no-type
rule-streaming = rule-streaming.encoded = false
. own-matching = matching
. saved-body = helping
matching = matching.subject = stream
matching = matching.optional = false
matching = matching.closed = 0
matching = matching.arms = 0
matching = matching.open = false
matching = matching.rows = false
rule-streaming = rule-streaming.matched = id
helping = helping.body = id
. result = invalid-type
. item = no-type
if record-stream-protocol(id, stream, texts)
    item = buffer-item
    result = type-stream-arms(pattern, false)
else
    decline(id)
rule-streaming = rule-streaming.matched = 0
. carried-rolls = helping.rolls
helping = saved-body
helping = helping.rolls = carried-rolls
matching = own-matching
rule-streaming = saved-rule
if result == invalid-type
    = invalid-type
if program.probes.compiles-metrics("stream-pattern")
    facts.record-call(instance, id, no-instance, .call-probe-metric, scratch.no-fills, false)
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(result)
= types.optional-of
    - types.class-with-args(types.capture-result-decl.module, types.capture-result-decl.decl, mark)

────────────────────
_ do scope-stream TypeId

` The stream a function declared over the items of one is given, which a pattern written in
` its code runs on. None in a rule, whose pattern is its body, in a function written in
` another, and in any other function.
. row = instances.rows[instance]
if row.enclosing != no-instance || instances.signatures[instance].args.count == 0 || ruled
    = no-type
.. ruled = rule-match(program, row.module, row.decl) != 0
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        do match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.pattern != 0 && !fn.is-generated
                    = instances.argument-type(instance, 0)
= no-type

────────────────────
_ do type-stream-arms TypeId
    - pattern SyntaxId
    - texts Bool
    - target TypeId = no-type
    - lifts Bool = true

` The arms of a stream pattern over the stream in force, typed as the reference declares them
` and joined: the names it captures first, then each arm, the text it matched where it gives
` no other value. Where the pattern `texts`, as the arms of a match, a pipe or a loop do, an arm
` that gives no value gives its text though its last part is optional; elsewhere the reference
` gives that part.
` The arms are converted to the `target` where one is given, and else to the type they join
` as; where an arm gives null or an optional and the target `lifts`, to the `target` as an
` optional, which null is absent of.
if !text-items() && !is-integer(stream-view.item)
    . site = class-error-site(pattern)
    if site == U32.max
        decline(pattern)
        = invalid-type
    if site != 0
        frame.diagnose
            - site
            - .stated
            - program.store-atom("Character patterns can only match character or integer items")
        = invalid-type
. own-arms = rule-arming
. base = capture-sites.length
rule-arming = RuleArms(target, false, false, texts, pattern, base, rule-arming.casting)
. joined = arms-type(pattern)
-= capture-sites[base .. < capture-sites.length]
-= capture-slots[base .. < capture-slots.length]
-= capture-accumulating[base .. < capture-accumulating.length]
-= capture-patterns[base .. < capture-patterns.length]
-= capture-repeats[base .. < capture-repeats.length]
rule-arming = own-arms
if joined == invalid-type
    = invalid-type
. result = if target != no-type then target else joined-text
    .. joined-text = if joined == no-type then types.string-type else joined
if lifts && target != no-type && joined-null && !types.is-optional(target)
    result = types.optional-of(target)
.. joined-null = types.is-optional(joined) || joined == types.null-type
convert-stream-arms(pattern, result)
facts.set-node-type(instance, pattern, result)
= result

────────────────────
_ do arms-type TypeId
    - pattern SyntaxId

` The arms of a stream pattern, typed after the names it captures and joined, with what
` `settle-captures` then records for those names, and what `results-assumed` settles of the
` actions that took their own type for the one the arms give, which is the one they declare
` or else join as, text where they give none. While they are typed, `pattern-arms` says whether
` an action or a call of this pattern makes a value through the helper (`selects`), which arm is
` being typed (`arm`), and that arms are scoped (`scoped`), each of which the
` reference gives a scope of its own, so that one name may hold another type in another arm.
` Where the arms declare no type and an action is `uninferred`, the reference
` takes that arm to give none, so the arms have a shape here only where they give text, which
` is what the reference takes them to give then. An arm that made the text it matched as the
` type its last part gives, taking that for the type the arms join as, has a shape only where
` they join as it.
. saved = pattern-arms
pattern-arms = pattern-arms.selects = false
pattern-arms = pattern-arms.uninferred = false
pattern-arms = pattern-arms.scoped = true
pattern-arms = pattern-arms.arm = 0
pattern-arms = pattern-arms.joined = tree.nodes[pattern] is .node-stream-or
. assumed = assumed-results.length
. sourced = assumed-sources.length
. joined = if type-captures(pattern, 0) then stream-arm-type(pattern) else invalid-type
note-observed(pattern)
for position in sourced .. < assumed-sources.length
    if joined != invalid-type && assumed-sources[position] != joined
        decline(pattern)
        joined = invalid-type
-= assumed-sources[sourced .. < assumed-sources.length]
if joined != invalid-type && !settle-captures(pattern, settled-target)
    joined = invalid-type
.. settled-target = if rule-arming.target != no-type then rule-arming.target else joined
if joined == invalid-type
    -= assumed-results[assumed .. < assumed-results.length]
else if !results-assumed(assumed, if targeted then rule-arming.target else joined-text, pattern)
    joined = invalid-type
.. targeted = rule-arming.target != no-type
.. joined-text = if joined == no-type then types.string-type else joined
if pattern-arms.uninferred && joined != invalid-type && joined != no-type && joined != types.string-type
    decline(pattern)
    joined = invalid-type
pattern-arms = saved
= joined

────────────────────
_ do top-arm SyntaxId
    - node SyntaxId

` The arm of the pattern being typed that a node lies in, or none. The nodes of an arm lie
` together, though those of the alternatives that join the arms do not.
. arms [SyntaxId]
stream-arms(rule-arming.capture-root, arms)
for arm in arms
    if tree.subtree-start(arm) <= node && node <= arm
        = arm
= 0

────────────────────
_ do enter-arm
    - id SyntaxId

` Begins typing an arm of the pattern: each name the arm captures has the type its place in
` this arm gave it.
pattern-arms = pattern-arms.arm = id
if !pattern-arms.scoped
    =
for position in rule-arming.capture-base .. < capture-sites.length
    . site = capture-sites[position]
    if tree.subtree-start(id) <= site && site <= id
        frame.assign(capture-slots[position], facts.node-type(instance, site))

────────────────────
_ do optional-operand SyntaxId
    - id SyntaxId

` The part an optional part of a stream pattern holds, or none for any other part.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op
            = row.operand
= 0

────────────────────
_ do optional-text Bool
    - id SyntaxId

` Whether a name captured over the text a part of a stream pattern matched may hold none, as
` the reference types it: where the part is optional, or alternatives one of which is. A
` sequence holds the text it matched, though the part it ends with may be optional.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        = row.op == .zero-or-one-op
    | .node-stream-or(row)
        = optional-text(row.left) || optional-text(row.right)
    | .node-stream-capture(row)
        = optional-text(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && optional-text(row.pattern)
= false

────────────────────
_ do settle-captures Bool
    - pattern SyntaxId
    - result TypeId

` Records what the reference makes through the helper where a part a name captures passes,
` whether or not anything reads it, once the arms are typed. An optional part captured as a
` whole that gives its text makes it, as the type it holds, but for one literal, whose text
` the reference has as a constant, and one of text that actions read, but none for more than
` its length, which the reference keeps as the span it matched. Where no action or call of the
` pattern makes a value through the helper, a call of a rule that gives its text makes it
` too, as the type the rule states, but for one whose name the reference keeps as the span
` it matched: a name that holds text, so captured outside optional parts and repeats, and
` does not accumulate. Each is made by the capture materializer `record-eager` selects, and
` nothing where the helper has none. There, a call in a repeat that states another type
` than text, a name an action reads for more than its length, a sequence that ends with
` such a call, a count whose bounds are computed, and a helper that delegates what makes the
` type the arms give have no shape here. False where the pattern was declined.
if helping.helper == null || helping.helper.captures.length == 0
    = true
for position in rule-arming.capture-base .. < capture-sites.length
    . name = capture-sites[position]
    . part = capture-patterns[position]
    if facts.plan-of(instance, name) == .plan-stream-value
        continue
    . held = facts.node-type(instance, name)
    if optional-operand(part) != 0
        if capture-accumulating[position] || literal-part || sourceless
            continue
        .. literal-part = tree.nodes[optional-operand(part)] is .node-stream-string
        .. sourceless = source-candidates(peeled-optional(held)).length == 0
        if held == types.optional-of(types.string-type) && read-in && !plain-read
            continue
        .. read-in = reads-slot-in(pattern, capture-slots[position])
        .. plain-read = reads-plainly(pattern, capture-slots[position])
        if !pattern-arms.selects && delegates-result(result)
            decline(name)
            = false
        if !record-eager(part, peeled-optional(held))
            = false
        continue
    if pattern-arms.selects
        continue
    . called = closing-call(part)
    if called == 0
        continue
    . stated = facts.node-type(instance, called)
    if source-candidates(stated).length == 0 || made-at(called, .material-text)
        continue
    if called != part || computed-counts(pattern) || delegates-result(result) || reads-wide
        decline(name)
        = false
    .. reads-wide = reads-plainly(pattern, capture-slots[position])
    if stated == types.string-type && held == types.string-type && !capture-accumulating[position]
        continue
    if stated != types.string-type && is-listed(held)
        decline(name)
        = false
    if !record-eager(part, stated)
        = false
= true

────────────────────
_ do record-eager Bool
    - site SyntaxId
    - held TypeId

` Records at a part of a stream pattern the call of the capture materializer that makes a
` type of the text the part matched, as the reference's implicit materialization selects it
` among those that make that type from the stream's items, which the part makes where it
` passes. Nothing where the helper has none. False where the part has no shape, as one over
` items that are not characters has none.
. candidates = source-candidates(held)
if candidates.length == 0
    = true
if !text-items()
    decline(site)
    = false
. interface = select-materializer(candidates, buffer-item, held, true, site)
if interface == invalid-type
    = false
if interface == no-type
    = true
= record-material(site, .material-eager, no-slot, second-type-arg(interface), interface, no-type)

────────────────────
_ do closing-call SyntaxId
    - id SyntaxId

` The call of a rule that gives its text which a part of a stream pattern is, or which the
` sequence it is ends with, or none.
do match? tree.nodes[id]
    | .node-stream-call
        = if facts.plan-of(instance, id) == .plan-span-call then id else 0
    | .node-stream-and(row)
        = closing-call(row.right)
    | .node-stream-capture(row)
        = closing-call(row.pattern)
= 0

────────────────────
_ do made-at Bool
    - site SyntaxId
    - kind MaterialKind

` Whether the helper makes a value of a kind at a place, as recorded so far.
. row = facts.first-material(instance, site)
while row != U32.max
    if facts.materials[row].kind == kind
        = true
    row = facts.materials[row].next
= false

────────────────────
_ do computed-counts Bool
    - id SyntaxId

` Whether a stream pattern holds a count of a part whose bounds are not numbers written.
for node in tree.subtree-start(id) .. < id + 1
    do match? tree.nodes[node]
        | .node-stream-length(row)
            if !count-bound(row.min) || (row.max != 0 && !count-bound(row.max))
                = true
= false

────────────────────
_ do delegates-result Bool
    - result TypeId

` Whether a materializer that makes what a type holds, past optionals and lists, answers for
` the helper through a property the helper delegates it to.
. leaf = if result != no-type && result != invalid-type then desired-leaf(result) else no-type
for materializer in helping.helper!.captures
    if second-type-arg(materializer) == leaf && capability-receiver(helping.helper!.participant, materializer) != helping.helper!.participant
        = true
for materializer in helping.helper!.values
    if second-type-arg(materializer) == leaf && capability-receiver(helping.helper!.participant, materializer) != helping.helper!.participant
        = true
= false

────────────────────
_ do reads-slot-in Bool
    - pattern SyntaxId
    - slot SlotId

` Whether an action of a stream pattern reads a name.
for node in tree.subtree-start(pattern) .. < pattern + 1
    do match? tree.nodes[node]
        | .node-stream-transform(row)
            if row.right != 0 && !tree.lazies-only(row.right) && reads-slot(row.right, slot)
                = true
= false

────────────────────
_ do reads-plainly Bool
    - pattern SyntaxId
    - slot SlotId

` Whether an action of a stream pattern reads a name for more than its length, through `.` or,
` for an optional name, `?.`.
for node in tree.subtree-start(pattern) .. < pattern + 1
    do match? tree.nodes[node]
        | .node-stream-transform(row)
            if row.right != 0 && slot-read && !reads-length-only(slot, row.right) && wide-optional
                = true
            .. slot-read = !tree.lazies-only(row.right) && reads-slot(row.right, slot)
            .. wide-optional = !reads-length-only(slot, row.right, true)
= false

────────────────────
_ do type-captures Bool
    - id SyntaxId
    - depth U32
    - repeats U32 = 0
    - held Bool = false

` Types the names a stream pattern captures, as the reference's matchmaker types them: each
` the text its part matched, or what a rule the part calls gives, optional within an optional
` part, and within a repeat an `ImmutableArray` of what each pass captured. A name captured in
` more than one place keeps one type, and its places must be alternatives of one another, so
` that no way through the pattern passes two of them; a name may hold another type in
` another arm, though, as the reference gives each arm a scope of its own, but for one
` captured in a repeat. A name captured in a lookahead,
` optional twice over, or in a repeat but for text no optional part holds, has no shape here,
` nor has any name but one that accumulates where `held`. A name that accumulates is typed
` wherever it is captured but in a count, whose names the reference never declares. A name
` captured over a call of a rule that gives its text but states another type has that type,
` and holds the text until an action makes it so: under a helper, optional where the call or
` a part around it is, and in one repeat a list that keeps the range of each pass. Records
` where each name holds text the call that makes it, and for one in a repeat the calls that
` grow its lists; plans each that holds a rule's value so. A name captured over a sequence
` that ends by testing an item against a value has no shape here: the reference converts the
` text the sequence matched to the value's type. False where the pattern was declined.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        if row.accumulating
            = type-accumulating(id, row.name, row.pattern)
        . inner = stream-node-type(row.pattern)
        if inner == invalid-type
            = false
        . slot = capture-slot(row.name)
        if held
            decline(id)
            = false
        for position in rule-arming.capture-base .. < capture-sites.length
            if capture-slots[position] == slot && capture-accumulating[position]
                frame.diagnose(id, .stated, program.store-atom("Capture ${name-text(row.name)} mixes ordinary and accumulating capture modes"))
                = false
        . valued = stream-valued(row.pattern) || takes-item(row.pattern)
        . optional = types.optional-of(types.string-type)
        if !valued && inner == optional && !optional-text(row.pattern)
            inner = types.string-type
        . type = if depth != 0 then optional else inner
        if valued
            type = if depth != 0 then types.optional-of(inner) else inner
        . shapeless = if !valued then text-mismatch else (depth != 0 && types.is-optional(inner))
            .. text-mismatch = inner != types.string-type && (inner != optional || depth != 0)
        . sliced = !text-items() && !valued && pattern-spans && !holds-count(row.pattern)
            .. pattern-spans = returns-span(instance, row.pattern)
        . whole = optional-operand(row.pattern)
        . spanned = textless-inner && facts.plan-of(instance, planned-part) == .plan-span-call
            .. textless-inner = !valued && peeled-optional(inner) != types.string-type
            .. planned-part = if whole != 0 then whole else row.pattern
        if spanned && whole != 0
            type = inner
            shapeless = depth != 0 || repeats != 0 || helping.helper == null || whole-optional
                .. whole-optional = types.is-optional(facts.node-type(instance, whole))
        else if spanned && repeats != 0
            type = listed-type(repeats, inner)
            shapeless = depth != 0 || repeats != 1 || helping.helper == null || inner-optional
                .. inner-optional = types.is-optional(inner)
        else if spanned
            type = if depth != 0 then types.optional-of(inner) else inner
            shapeless = depth != 0 && (helping.helper == null || types.is-optional(inner))
        else if sliced
            type = stream-view.buffer
            shapeless = depth != 0 || repeats != 0
        else if !text-items() && !valued
            shapeless = true
        else if repeats != 0
            shapeless = depth != 0 || valued-optional || !(valued || inner == types.string-type)
                .. valued-optional = valued && types.is-optional(inner)
            type = listed-type(repeats, if valued then inner else types.string-type)
        if slot == no-slot || depth > 1 || shapeless || (valued && sequence-tests-item(row.pattern))
            decline(id)
            = false
        for position in rule-arming.capture-base .. < capture-sites.length
            if capture-slots[position] == slot
                . known = facts.node-type(instance, capture-sites[position])
                . apart = pattern-arms.scoped && other-arm && unrepeated && repeats == 0
                    .. other-arm = top-arm(capture-sites[position]) != top-arm(row.name)
                    .. unrepeated = capture-repeats[position] == 0
                if !alternatives(capture-sites[position])
                    frame.diagnose(id, .stated, program.store-atom("Capture ${name-text(row.name)} is captured twice on one way through the pattern"))
                    = false
                if known != type && !apart
                    . shown = "${type-short-name(types, known)} in one alternative and ${type-short-name(types, type)} in another"
                    frame.diagnose(id, .stated, program.store-atom("Capture ${name-text(row.name)} holds $shown"))
                    = false
        if valued
            facts.set-plan(instance, row.name, .plan-stream-value)
            if takes-item(row.pattern)
                facts.set-node-type(instance, row.pattern, inner)
            if repeats != 0 && !record-collectors(row.name, repeats, inner)
                decline(id)
                = false
        else if sliced
            facts.set-plan(instance, row.name, .plan-stream-slice)
        else if !record-stream-text(row.name)
            decline(id)
            = false
        else
            . ranged = spanned && repeats != 0
            if !ranged && repeats != 0 && helping.helper != null
                . found = ranged-capture(id, slot)
                if found == null
                    = false
                ranged = found
            . item = if ranged then types.pattern-capture-range-type else types.string-type
            if ranged && repeats != 1
                decline(id)
                = false
            if !record-collectors(row.name, repeats, item)
                decline(id)
                = false
            if ranged
                facts.record-material
                    - MaterialFact
                        - instance
                        - row.name
                        - .material-ranges
                        - slot
                        - class-over(types.immutable-array-decl, item)
                        - no-type
                        - no-fact
        frame.assign(slot, type)
        facts.set-node-type(instance, row.name, type)
        capture-sites += row.name
        capture-slots += slot
        capture-accumulating += false
        capture-patterns += row.pattern
        capture-repeats += repeats
        = type-captures(row.pattern, depth, repeats)
    | .node-stream-and(row)
        = type-captures(row.left, depth, repeats, held) && type-captures(row.right, depth, repeats, held)
    | .node-stream-or(row)
        if !type-captures(row.left, depth, repeats, held)
            = false
        right-arms += id
        . passes = type-captures(row.right, depth, repeats, held)
        right-arms.pop()
        = passes
    | .node-stream-transform(row)
        = type-captures(row.pattern, depth, repeats, held)
    | .node-stream-panic(row)
        = type-captures(row.pattern, depth, repeats, held)
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op
            = type-captures(row.operand, depth + 1, repeats, held)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        if repeat && depth == 0 && !held && listable(row.operand, row.operand)
            = type-captures(row.operand, 0, repeats + 1)
        = type-captures(row.operand, depth, repeats, true)
    | .node-stream-length(row)
        = captures-none(row.operand)
= true

────────────────────
_ do type-accumulating Bool
    - id SyntaxId
    - name SyntaxId
    - pattern SyntaxId

` Types a name that accumulates what its part gives each time the part passes, wherever it
` is captured, as the reference types one: an `ImmutableArray` of what the part gives, the
` text it matched or what a rule it calls gives, which every place that captures the name
` must give alike. Records where the part gives text the call that makes it, and the call
` that grows the list the match keeps of them. A name captured both so and plainly is
` TypeScript's error at the later place, as is a part that gives another type than the first.
` One over items that are not characters, or whose part gives an optional, has no shape here.
. inner = stream-node-type(pattern)
if inner == invalid-type
    = false
. slot = capture-slot(name)
if slot == no-slot
    decline(id)
    = false
. text = name-text(name)
for position in rule-arming.capture-base .. < capture-sites.length
    if capture-slots[position] == slot && !capture-accumulating[position]
        frame.diagnose
            - id
            - .stated
            - program.store-atom("Capture $text mixes ordinary and accumulating capture modes")
        = false
. valued = stream-valued(pattern)
if !text-items() || types.is-optional(inner) || (!valued && inner != types.string-type)
    decline(id)
    = false
. list = class-over(types.immutable-array-decl, inner)
for position in rule-arming.capture-base .. < capture-sites.length
    if capture-slots[position] == slot
        . first = facts.node-type(instance, capture-sites[position])
        if first != list
            . given = class-arg(types, first, 0)
            frame.diagnose(id, .stated, program.store-atom("Accumulating capture $text has incompatible contribution types ${type-key(types, given)} and ${type-key(types, inner)}"), given, inner)
            = false
        break
if valued
    facts.set-plan(instance, name, .plan-stream-value)
else if !record-stream-text(name)
    decline(id)
    = false
if !record-collectors(name, 1, inner)
    decline(id)
    = false
frame.assign(slot, list)
facts.set-node-type(instance, name, list)
capture-sites += name
capture-slots += slot
capture-accumulating += true
capture-patterns += pattern
capture-repeats += 0
= type-captures(pattern, 0, 0, true)

────────────────────
_ name-text String
    - id SyntaxId

if name then name.text else ""

.. name = identifier-name(tree, id)

────────────────────
_ do accumulates Bool
    - slot SlotId

` Whether a name the match captures accumulates what its parts give.
for position in rule-arming.capture-base .. < capture-slots.length
    if capture-slots[position] == slot
        = capture-accumulating[position]
= false

────────────────────
_ capture-slot SlotId
    - name SyntaxId

if resolution.kind == .resolve-slot then resolution.slot else no-slot

.. resolution = bindings.resolution-of(frame.binding, name)

────────────────────
_ do alternatives Bool
    - earlier SyntaxId

` Whether a place a name was captured lies in an alternative tried before one the pattern is
` being typed in, so that no way through the pattern passes both.
for arm in right-arms
    do match? tree.nodes[arm]
        | .node-stream-or(row)
            if earlier >= tree.subtree-start(row.left) && earlier <= row.left
                = true
= false

────────────────────
_ do listed-type TypeId
    - repeats U32
    - item TypeId

` The type of a name captured in repeats nested this deep: an `ImmutableArray` of what each
` pass captured, the text or the item, for each.
. type = item
for level in 0 .. < repeats
    type = class-over(types.immutable-array-decl, type)
= type

────────────────────
_ do record-collectors Bool
    - name SyntaxId
    - repeats U32
    - first TypeId

` Records at a name captured in repeats nested this deep the call that grows the list each
` repeat keeps of what its passes captured, from the innermost out: a `PatternCollector` of
` what one pass captured, the text or the item, then of the lists the repeat inside it made.
. item = first
for level in 0 .. < repeats
    . collector = collector-over(item)
    if collector == invalid-type
        = false
    if calls.protocol-call(collector, program.store-atom("grow"), name).answer != grown-items(collector)
        = false
    item = class-over(types.immutable-array-decl, item)
= true

────────────────────
_ do collector-over TypeId
    - item TypeId

` The `PatternCollector` a stream pattern keeps a list of items of a type in, as the
` reference makes it: backed as the helper of the pattern keeps collectors, which the body
` then reads the context of where it makes one, and else by the collector. A match without
` such a helper in a rule whose own helper keeps collectors has no shape here, and the rule
` is typed for its helper so that the call of it has none either.
. decl = types.pattern-collector-decl
if decl.module == 0
    = invalid-type
. backing = types.gc-backing-type
if helping.helper != null && helping.helper.storage != no-type
    if !note-storage()
        = invalid-type
    backing = helping.helper!.storage
else if rule-helper-site != 0 && helping.site != rule-helper-site && rule-stores()
    instances.rows[instance].uses-helper = true
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(backing)
= types.class-with-args(decl.module, decl.decl, mark)

────────────────────
_ do grown-items TypeId
    - collector TypeId

` The `Array` a `PatternCollector` keeps its items in: of its item, with its backing.
. item = class-arg(types, collector, 0)
. backing = class-arg(types, collector, 1)
if backing == types.gc-backing-type
    = class-over(types.array-decl, item)
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(backing)
= types.class-with-args(types.array-decl.module, types.array-decl.decl, mark)

────────────────────
_ do note-storage Bool

` Notes that the body being typed keeps the items of its collectors where the helper says:
` the property read from the helper for the context, which answers `pattern-collector-context`
` for it, is recorded once, at the body, with the getter that answers it where the helper
` stores none, after the properties the helper delegates its collector storage through. A rule
` typed for the helper uses it so. False where the body or the property has no shape here.
if helping.body == 0 || helping.helper!.storage == invalid-type
    = false
if facts.storage-body-of(instance, helping.body) == U32.max
    . participant = helping.helper!.participant
    . receiver = capability-receiver(helping.helper!.participant, helping.helper!.storages[0])
    . places [U32]
    if receiver == no-type || (receiver != participant && !calls.ranking.delegate-path(participant, receiver, places))
        = false
    . found = types.property-named(receiver, program.store-atom("pattern-collector-context"))
    if !found
        = false
    . property = types.properties[found]
    if property.type == no-type || property.type == invalid-type
        = false
    places += found as U32
    . steps = facts.keep-steps(places, calls.step-getters(places, helping.body))
    facts.add-storage-body(StorageBody(instance, helping.body, steps, property.type))
note-helper-use(false)
= true

────────────────────
_ do rule-stores Bool

` Whether the helper a rule this instance types is given keeps collectors where it says.
. given = instances.rows[instance].helper
if given == no-type
    . position = ambient-position(types, instances, instance)
    if position == U32.max
        = false
    given = instances.argument-type(instance, position)
= pattern-helper(types, given).storage != no-type

────────────────────
_ do listable Bool
    - id SyntaxId
    - operand SyntaxId

` Whether the names a repeat's part captures can be kept as lists: each is captured on every
` way the part passes, and the part runs no action. A name that accumulates keeps no list.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        if row.accumulating
            = listable(row.pattern, operand)
        . slot = capture-slot(row.name)
        = slot != no-slot && covers(operand, slot) && listable(row.pattern, operand)
    | .node-stream-and(row)
        = listable(row.left, operand) && listable(row.right, operand)
    | .node-stream-or(row)
        = listable(row.left, operand) && listable(row.right, operand)
    | .node-stream-unary(row)
        = listable(row.operand, operand)
    | .node-stream-length(row)
        = listable(row.operand, operand)
    | .node-stream-transform
        = false
    | .node-stream-panic
        = false
= true

────────────────────
_ do holds Bool
    - id SyntaxId
    - slot SlotId

` Whether a part of a pattern captures a name anywhere in it.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        = capture-slot(row.name) == slot || holds(row.pattern, slot)
    | .node-stream-and(row)
        = holds(row.left, slot) || holds(row.right, slot)
    | .node-stream-or(row)
        = holds(row.left, slot) || holds(row.right, slot)
    | .node-stream-unary(row)
        = holds(row.operand, slot)
    | .node-stream-length(row)
        = holds(row.operand, slot)
= false

────────────────────
_ do first-capture SyntaxId
    - id SyntaxId

` The first name a part of a pattern captures, or none.
for node in tree.subtree-start(id) .. < id + 1
    if tree.nodes[node] is .node-stream-capture
        = node
= 0

────────────────────
_ do captures-none Bool
    - id SyntaxId
    - quiet Bool = false

` Whether a part of a pattern captures no name, declining the first that does where it is not
` `quiet`.
for node in tree.subtree-start(id) .. < id + 1
    if tree.nodes[node] is .node-stream-capture
        if !quiet
            decline(node)
        = false
= true

────────────────────
_ do is-capture Bool
    - slot SlotId

for position in rule-arming.capture-base .. < capture-slots.length
    if capture-slots[position] == slot
        = true
= false

────────────────────
_ do covers Bool
    - id SyntaxId
    - slot SlotId

` Whether a pattern gives a name the match captures a value on every way it passes. An
` optional part gives the names in it nothing where it does not pass; a repeat gives each a
` list, empty where it took its part no time.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        = capture-slot(row.name) == slot || covers(row.pattern, slot)
    | .node-stream-and(row)
        = covers(row.left, slot) || covers(row.right, slot)
    | .node-stream-or(row)
        = covers(row.left, slot) && covers(row.right, slot)
    | .node-stream-unary(row)
        if row.op == .zero-or-more-op || row.op == .one-or-more-op
            = holds(row.operand, slot)
        = row.op == .zero-or-one-op && covers(row.operand, slot)
= false

────────────────────
_ do uncovered-read SyntaxId
    - pattern SyntaxId
    - body SyntaxId

` Where an action reads a name the match captures that may hold no value on some way the
` action's pattern passes, or none where each holds one: the reference leaves one that an
` alternative not taken captures unset. A name that accumulates always holds its list. A
` function the action makes reads only names that hold one value each, as `reads-captures`
` says, and is where it reads another.
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . slot = capture-slot(node)
            if slot != no-slot && is-capture(slot) && !accumulates(slot) && !covers(pattern, slot)
                = node
        | .node-function-syntax
            if capture-sites.length != rule-arming.capture-base && reads-captures(node)
                = node
= 0

────────────────────
_ uncovered-text String
    - read SyntaxId

` The error for an action that reads a name some way its pattern passes doesn't capture.
"Capture ${name-text(read)} holds no value on some ways this arm matches; capture it in every alternative"

────────────────────
_ slice-read-text String

` The error for a name captured as a slice of a stream that holds no characters, read for more
` than its length or an item.
"A capture over items that aren't characters can only be read for its length or an item"

────────────────────
_ do unplain-slice SyntaxId
    - body SyntaxId

` Where an action reads a name captured as a slice of a stream that holds no characters for
` more than its length or an item of it, or none. The reference types the name as an
` `ImmutableArray` but gives it the `Array` it reads, which shares the stream's buffer, and the
` two agree only there.
. receivers [SyntaxId]
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-get-expression(row)
            if row.name == types.length-atom! && !row.is-optional
                receivers += row.object
        | .node-index-expression(row)
            if !row.is-optional
                receivers += row.object
for node in tree.subtree-start(body) .. < body + 1
    if tree.nodes[node] is .node-identifier
        . slot = capture-slot(node)
        if slot != no-slot && is-capture(slot) && sliced && receivers.find(node) == null
            = node
        .. sliced = facts.plan-of(instance, bindings.slots[slot].syntax) == .plan-stream-slice
= 0

────────────────────
_ do reads-captures Bool
    - function SyntaxId

` Whether a function an action makes reads a name the match captures that holds more than the
` one value the function takes as it is made: one that collects what its parts give, or any
` under a helper, which makes the action's values. The binder records what the function reads
` of the function around it; one it kept no record of is taken to.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == function
        for index in 0 .. < nested.captures.count
            . slot = bindings.captures[nested.captures.start + index].slot
            if is-capture(slot) && (helping.helper != null || collects(slot))
                = true
        = false
= true

────────────────────
_ do collects Bool
    - slot SlotId

` Whether a name the match captures collects what its parts give: one that accumulates, or one
` written inside a repeat.
for position in rule-arming.capture-base .. < capture-slots.length
    if capture-slots[position] == slot && gathers
        = true
    .. gathers = capture-accumulating[position] || capture-repeats[position] != 0
= false

────────────────────
_ do outlines Bool
    - pattern SyntaxId
    - body SyntaxId
    - value TypeId

` Whether the reference runs an action in a function of its own, `stream-action`, which a
` panic in it would show: one with a pattern, whose value is not String and holds no function,
` in a function with no type parameters, a rule's own item type aside, that is more than a
` name, a number or text written alone, makes no function, and reads no local of the
` functions it is in but the names its match captures, `it` and `location`, none of which
` holds a function. The reference asks some of this by the names the action reads, so for an
` action that reads a name a local of its function also has the answer is not sure, which
` `outline-unsure` says. An action that names `This` is kept inline, as the reference finds
` no such type in the module.
outline-unsure = false
if pattern == 0 || value == types.string-type || trivial-action(body)
    = false
. params = instances.signatures[instance].param-count
. item-params = if rule-match(program, module, frame.decl) != 0 then 1u32 else 0u32
if params > item-params
    = false
if holds-function(value)
    = false
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-function-syntax
            = false
        | .node-type-identifier(row)
            if types.this-atom && row.name == types.this-atom
                = false
        | .node-identifier(row)
            if types.this-atom && row.name == types.this-atom
                = false
            . slot = capture-slot(node)
            . declared = bindings.slots[slot] if slot != no-slot
            . inside = declared && declared.syntax >= body-start && declared.syntax <= body
                .. body-start = tree.subtree-start(body)
            if !declared || inside
                if named-before(row.name, body)
                    outline-unsure = true
            else if declared.kind == .slot-it || declared.kind == .slot-location || is-capture(slot)
                if holds-function(frame.slot-type(slot))
                    = false
            else
                = false
= true

────────────────────
_ do trivial-action Bool
    - body SyntaxId

` Whether an action is a name, a number or text written alone, which the reference keeps
` inline.
. single = body
do match? tree.nodes[body]
    | .node-block(row)
        if row.body.count != 1
            = false
        single = tree.children[row.body.start]
do match? tree.nodes[single]
    | .node-identifier
        = true
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
= false

────────────────────
_ do named-before Bool
    - name Atom
    - body SyntaxId

` Whether a local of the function an action is in has a name: one declared before the
` action, in a scope the action is in.
. bound = bindings.bindings[frame.binding]
. start = tree.subtree-start(body)
for offset in 0 .. < bound.slots.count
    . other = bindings.slots[bound.slots.start + offset]
    if other.name != name || other.syntax >= start
        continue
    . held = bindings.scopes[other.scope].syntax
    if held == 0 || (tree.subtree-start(held) <= start && body <= held)
        = true
= false

────────────────────
_ do holds-function Bool
    - type TypeId

` Whether a type holds a function anywhere in it: a closure, a binding or a function type, or a
` field, case, argument or property of one that does.
. seen [TypeId]
. waiting [TypeId]
waiting += type
while waiting.length != 0
    . next = waiting[waiting.length - 1]
    waiting.pop()
    if next == no-type || next == invalid-type || seen.find(next) != null
        continue
    seen += next
    do match? types.rows[next]
        | .type-closure
            = true
        | .type-binding
            = true
        | .type-function
            = true
        | .type-tuple(row)
            for position in 0 .. < row.fields.count
                waiting += types.child-type(row.fields, position)
        | .type-union(row)
            for position in 0 .. < row.cases.count
                waiting += types.child-type(row.cases, position)
        | .type-named-union(row)
            for position in 0 .. < row.cases.count
                waiting += types.child-type(row.cases, position)
        | .type-class(row)
            for position in 0 .. < row.args.count
                waiting += types.child-type(row.args, position)
            for property in types.properties-of(next)
                waiting += property.type
= false

────────────────────
_ do note-outlined-action
    - arm SyntaxId
    - body SyntaxId
    - it-type TypeId

` Records an action the reference runs in a function of its own, with the names it gives the
` function: `location`, `it` and the names the match captures, in the order the action first
` reads them, each of the type the arm gives it, which a helper may have made another.
. start U32 = facts.action-slots.length as U32
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . slot = capture-slot(node)
            . type = no-type
            if slot != no-slot
                . row = bindings.slots[slot]
                if row.kind == .slot-location && row.syntax == arm
                    type = types.match-location-type
                else if row.kind == .slot-it && row.syntax == arm
                    type = it-type
                else if is-capture(slot)
                    type = frame.known(slot)
            . known = false
            for position in start .. < facts.action-slots.length
                known = known || facts.action-slots[position] == slot
            if type != no-type && !known
                facts.action-slots.append(slot)
                facts.action-types.append(type)
. count U32 = (facts.action-slots.length - start) as U32
facts.outlined.append
    - OutlinedAction(instance, arm, RowRange'U32(start, count), no-type, outline-unsure)

────────────────────
_ do record-stream-protocol Bool
    - id SyntaxId
    - subject TypeId
    - encoded Bool = false

` Records at a stream pattern the calls the reference makes to run it on the value a match is
` on, in order: the stream it reads the value through, the stream's `pattern-view`, its
` `pattern-commit` of where the pattern ended and how far it read, and its `pattern-extend`. What a value is is what it
` is `supported` as. A value that is a stream
` is read as the `TokenStream` it is, converted to that interface, through the view of its
` UTF-8 bytes where it is a `TextTokenStream` or the stream given to a function a pattern on a
` String calls, which is `encoded`. A String is read through a `TextTokenStream` of
` it, whose buffer holds its UTF-8 bytes. A generator is read
` through a `ChunkedTokenStream` of its items, which pulls them as the pattern needs them. So
` is a stream of items a parameter is written as, `<T>`, which the reference passes as a
` generator and which is the `CursorIterable` it is here, given its `Iterable`; and a value
` that is `ByteReadable`, given it as that interface, whose items are what it is `Decodable`
` as, else bytes. An Array is read as an `ArrayTokenStream` of its items, any other
` value that is `Indexable` as an `IndexableTokenStream`, and one that is only `Iterable`
` through a `ChunkedTokenStream`, each given it as that interface.
if subject == invalid-type || subject == no-type
    = false
. kind = types.intrinsic-of(subject)
. given = if kind == .class || kind == .interface then stream-support else no-type
    .. stream-support = supported(subject, types.token-stream-decl)
. ref = class-ref(types, subject)
if given != no-type
    if retyped && conversions.convert(id, id, subject, given, .reason-argument) == invalid-type
        = false
    .. retyped = subject != given
    = record-stream-view
        - id
        - given
        - first-arg(given)
        - encoded || same-decl(ref, types.text-token-stream-decl)
. mark = scratch.types.mark
. item = no-type
. made = types.array-token-stream-decl
. texts = subject == types.string-type
if texts
    item = types.type-row(.char)
    made = types.text-token-stream-decl
    scratch.types.push(subject)
else if same-decl(ref, types.generator-decl)
    item = first-arg(subject)
    made = types.chunked-token-stream-decl
    scratch.types.push(subject)
else if kind == .interface && same-decl(ref, types.cursor-iterable-decl)
    item = first-arg(subject)
    . iterable = class-over(types.iterable-decl, item)
    if item == no-type || conversions.convert(id, id, subject, iterable, .reason-argument) == invalid-type
        = false
    made = types.chunked-token-stream-decl
    scratch.types.push(iterable)
else
    if kind != .class && kind != .struct && kind != .tuple && kind != .interface
        = false
    . readable = supported(subject, types.byte-readable-decl)
    . indexable = if readable == no-type then supported(subject, types.indexable-decl) else no-type
    . iterable = if readable == no-type && indexable == no-type then iterable-support else no-type
        .. iterable-support = supported(subject, types.iterable-decl)
    . read = readable
    if readable != no-type
        . decodable = supported(subject, types.decodable-decl)
        item = if decodable != no-type then first-arg(decodable) else types.type-row(.uint8)
        made = types.chunked-token-stream-decl
    else if indexable != no-type
        item = first-arg(indexable)
        read = if same-decl(ref, types.array-decl) then no-type else indexable
        if read != no-type
            made = types.indexable-token-stream-decl
    else if iterable != no-type
        item = first-arg(iterable)
        read = iterable
        made = types.chunked-token-stream-decl
    else
        = false
    if read == no-type
        scratch.types.push(subject)
    else
        if conversions.convert(id, id, subject, read, .reason-argument) == invalid-type
            scratch.types.rewind(mark)
            = false
        scratch.types.push(read)
if made.module == 0 || item == no-type
    scratch.types.rewind(mark)
    = false
. stream = if texts then types.class-with-args(made.module, made.decl, scratch.types.mark) else class-over(made, item)
. constructs = calls.demand-constructor(stream, mark)
scratch.types.rewind(mark)
if constructs == no-instance
    = false
facts.record-call(instance, id, constructs, .call-constructor, scratch.no-fills, false)
= record-stream-view(id, stream, item, texts)

────────────────────
_ do record-stream-view Bool
    - id SyntaxId
    - stream TypeId
    - item TypeId
    - encoded Bool

` Records at a stream pattern the calls the reference makes of the stream it runs on, in
` order: its view of its buffer, which is its `pattern-text-view` of the UTF-8 bytes of its
` characters where it is `encoded` and else its `pattern-view`, its `pattern-commit`, and its
` `pattern-extend`, which a stream that may give more input is asked where the pattern reads
` past the end of its buffer.
. view = calls.protocol-getter(stream, view-name(encoded), id)
if !types.is-optional(view)
    = false
. buffer = field-of(types.optional-inner(view), 0)
if encoded && class-arg(types, buffer, 0) != types.type-row(.uint8)
    = false
if calls.protocol-call(stream, program.store-atom("pattern-commit"), id, types.index-type, false, types.index-type).answer == invalid-type
    = false
stream-view = stream-view.buffer = buffer
stream-view = stream-view.type = stream
stream-view = stream-view.item = item
= calls.protocol-call(stream, program.store-atom("pattern-extend"), id).answer == types.bool-type

────────────────────
_ do record-growth Bool
    - stream TypeId
    - id SyntaxId
    - encoded Bool

` Records at a pattern a function runs on a stream it is given the calls the reference makes of a
` stream that may give more input where the pattern reads past the end of its buffer, in order:
` the stream's view of its buffer, as `view-name` names it for a function that is `encoded`,
` which gives the buffer it then holds, and its `pattern-extend`.
if !types.is-optional(calls.protocol-getter(stream, view-name(encoded), id))
    = false
= calls.protocol-call(stream, program.store-atom("pattern-extend"), id).answer == types.bool-type

────────────────────
_ do stream-arm-type TypeId
    - id SyntaxId

` The type of the arms of a stream pattern, joined as the reference joins them, in the order
` written. An arm that raises gives none. An arm with no expression, or one whose body only
` declares lazy locals, gives the text its pattern matched, or what a rule its pattern calls
` gives. One whose pattern is one literal gives that text as it is, which no helper makes. One
` whose body only declares lazy locals and that would ask the helper for a rollback mark has
` no shape here. In a rule that states the `CaptureSpan` of its stream's items, each arm gives
` the span of the items it matched; elsewhere an arm that gives a span a rule gave, which the
` reference reads as text, has no shape here. An arm with no expression that is a sequence of
` parts gives the text it matched whatever its last part gives, made as the type the arms
` give, where its rule has other arms, where that type is text, which leaves the last part's
` value unmade where the arm is alone, where it is optional text and the arm has others or is
` alone in arms that state no type and give their text, though not where the arms give their
` text whatever their last part gives, or where the helper makes that type of
` the stream's items; one that the reference would make of text as a type nothing makes of it
` has no shape here. Where the arms state no type, that type is the one the arm's last part
` gives, which `arms-type` holds the other arms to. An arm that only looks ahead gives the
` text it matched, none, though it joins the other arms as the type of what it looks for, as
` the reference declares it, where the arms state text or no type and those then join as text.
note-observer()
do match? tree.nodes[id]
    | .node-stream-or(row)
        . left = stream-arm-type(row.left)
        . right = stream-arm-type(row.right)
        = join-stream-types(id, left, right)
enter-arm(id)
do match? tree.nodes[id]
    | .node-stream-transform(row)
        if row.pattern == 0 || !tree.lazies-only(row.right)
            = stream-action-type(id, row.pattern, row.right)
        if row.rollback || helping.explicit
            decline(id)
            = invalid-type
    | .node-stream-panic(row)
        check-stream-panic(id, row.pattern)
        = no-type
if spans-source(rule-arming.target)
    = span-arm-type(id)
. sequence = arm-sequence(id)
. alone = sequence && !pattern-arms.joined && rule-arming.target == types.string-type
. kept = valuing
if alone
    valuing = valuing.unvalued = true
. matched = stream-node-type(id)
valuing = kept
if matched == invalid-type
    = invalid-type
if sequence && stream-valued(id)
    . wanted = if rule-arming.target == no-type then matched else rule-arming.target
    . optional-text = types.optional-of(types.string-type)
    . spanned = rule-arming.target == no-type && returns-span(instance, rule-arming.capture-root)
    . optional = wanted == optional-text && (pattern-arms.joined || spanned)
    . makes = wanted == types.string-type || optional || helper-made
        .. helper-made = helping.helper != null && source-candidates(wanted).length != 0
    if pattern-arms.joined || makes
        if !makes || !text-items() || observes-span(matched) || !stream-and
            decline(id)
            = invalid-type
        .. stream-and = tree.nodes[id] is .node-stream-and
        . sourced = record-source-text(id, wanted)
        if sourced == invalid-type
            decline(id)
            = invalid-type
        . given = if optional && sourced == types.string-type then optional-text else sourced
        if rule-arming.target == no-type && pattern-arms.joined
            assumed-sources += given
        facts.set-node-type(instance, id, sourced)
        = given
if stream-valued(id)
    if observes-span(matched)
        decline(id)
        = invalid-type
    plan-valued(id)
else
    . texted = rule-arming.texts && matched == types.optional-of(types.string-type) && arm-spans
        .. arm-spans = returns-span(instance, id)
    . ahead = matched != types.string-type && looks-ahead(id) && text-target
        .. text-target = rule-arming.target == no-type || rule-arming.target == types.string-type
    . whole = joined-target && matched == types.optional-of(types.string-type)
        .. joined-target = sequence && pattern-arms.joined && rule-arming.target != no-type
    . lone = !texted && lone-arm && matched == types.optional-of(types.string-type) && lone-spans
        .. lone-arm = sequence && !pattern-arms.joined && rule-arming.target == no-type
        .. lone-spans = returns-span(instance, id)
    . recorded = if literal-arm(id) then sliced-text(id) else record-source-text(id, wanted-text)
        .. wanted-text = if rule-arming.target != no-type then rule-arming.target else types.string-type
    if untextual || !text-items() || recorded == invalid-type
        decline(id)
        = invalid-type
    .. untextual = matched != types.string-type && !texted && !ahead && !whole && !lone
    if ahead && rule-arming.target == no-type
        assumed-sources += recorded
        facts.set-node-type(instance, id, recorded)
        = matched
    if lone
        facts.set-node-type(instance, id, recorded)
        = matched
    matched = recorded
facts.set-node-type(instance, id, matched)
= matched

────────────────────
_ do arm-sequence Bool
    - id SyntaxId

` Whether an arm that runs no expression is a sequence of parts, alone or under lazy locals
` it only declares.
do match? tree.nodes[id]
    | .node-stream-and
        = true
    | .node-stream-transform(row)
        = row.pattern != 0 && arm-sequence(row.pattern)
= false

────────────────────
_ do looks-ahead Bool
    - id SyntaxId

` Whether an arm's pattern only looks ahead, for a part there or not.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        = row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
    | .node-stream-transform(row)
        = row.pattern != 0 && looks-ahead(row.pattern)
= false

────────────────────
_ do literal-arm Bool
    - id SyntaxId

` Whether an arm's pattern is one literal, whose text the reference gives as a constant.
do match? tree.nodes[id]
    | .node-stream-string
        = true
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.nodes[row.pattern] is .node-stream-string
= false

────────────────────
_ do plan-valued
    - id SyntaxId

` Plans a part of a stream pattern as giving what a rule it calls gives, unless it is a call of
` a pattern given to the rule, whose own plan says as much, or a call planned to give its text,
` which gives what the helper makes of that text where the type pass recorded that.
. plan = facts.plan-of(instance, id)
if plan != .plan-pattern-call && plan != .plan-span-call
    facts.set-plan(instance, id, .plan-stream-value)

────────────────────
_ do holds-count Bool
    - id SyntaxId

` Whether a part of a stream pattern counts a part, whose text the reference gives empty over
` items that are no characters.
for node in tree.subtree-start(id) .. < id + 1
    if tree.nodes[node] is .node-stream-length
        = true
= false

────────────────────
_ do record-stream-text Bool
    - id SyntaxId

` Records where a part of a stream pattern gives the text it matched the call that makes it:
` `slice-string` of the part of the stream's buffer it matched.
= calls.protocol-call(stream-view.buffer, program.store-atom("slice-string"), id).answer == types.string-type

────────────────────
_ do join-stream-types TypeId
    - id SyntaxId
    - left TypeId
    - right TypeId

` Two types a pattern may give, as one: where either side gives none, the other's; where
` either is null, the other's as an optional, unless it is one or null; else the two unified,
` or else their union.
if left == invalid-type || right == invalid-type
    = invalid-type
if left == no-type
    = right
if right == no-type
    = left
if left == types.null-type || right == types.null-type
    . valued = if left == types.null-type then right else left
    = if nullable then valued else types.optional-of(valued)
        .. nullable = valued == types.null-type || types.is-optional(valued)
. relation = relations.unify(left, right, module)
if relation-legal(relation)
    = relation.unified
. mark = scratch.types.mark
scratch.types.push(left)
scratch.types.push(right)
= types.intern-union(mark)

────────────────────
_ do convert-stream-arms
    - id SyntaxId
    - result TypeId

` Converts what each arm of a stream pattern gives to the type of the pattern, where the arm
` is. The type a pattern is declared to give asks for what its arms match as that type, as text
` read as a number or pieces matched as text, and for an integer written with no suffix that it
` holds.
do match? tree.nodes[id]
    | .node-stream-or(row)
        convert-stream-arms(row.left, result)
        convert-stream-arms(row.right, result)
        =
    | .node-stream-panic
        =
if facts.is-spanning-arm(instance, id)
    =
. given = facts.node-type(instance, id)
=? if given == no-type || given == result
if relations.reads-text-as-number(given, result) && !acts(id)
    . read = relations.compare-explicit(given, result, module)
    if relation-legal(read)
        conversions.record-conversion(id, read, .reason-join, false, no-type, id)
        =
. written = match? tree.nodes[id]
    | .node-stream-transform(row)
        row.right != 0 && conversions.fitting-literal(arm-value(row.right), result)
    ??
        false
conversions.convert
    - id
    - id
    - given
    - result
    - .reason-join
    - true
    - result == types.string-type || written

────────────────────
_ acts Bool
    - arm SyntaxId

match tree.nodes[arm]
    | .node-stream-transform(row)
        row.right != 0
    ??
        false

────────────────────
_ do note-arm-casts
    - id SyntaxId
    - declared TypeId

` Records each arm of a rule's pattern whose action gives a cast to the type the rule states
` (`note-context-cast`). A rule that states none takes its type from its arms, casts and all,
` and one that states `String` has the text of each arm made by a call, as the reference makes it.
do match? tree.nodes[id]
    | .node-stream-or(row)
        note-arm-casts(row.left, declared)
        note-arm-casts(row.right, declared)
    | .node-stream-transform(row)
        calls.note-context-cast(action-value(row.right), declared, .cast-return)

────────────────────
_ do action-value SyntaxId
    - action SyntaxId

` What an action gives: its last statement where it is a block.
do match? tree.nodes[action]
    | .node-block(block)
        if block.body.count != 0
            = tree.children[block.body.start + block.body.count - 1]
= action

────────────────────
_ do stream-action-type TypeId
    - id SyntaxId
    - pattern SyntaxId
    - body SyntaxId

` An arm that runs an expression where its pattern matched, which gives the arm's value. The
` expression sees as `it` the text its pattern matched, or what a rule its pattern calls gives where
` the pattern is no sequence, as the reference gives it the pattern's value. The text of a sequence
` of items that are no characters is what `slice-string` makes of them. Where the pattern is an
` optional part that gives its text, `it` is that text as an optional, which the part makes where
` its operand passes, a literal's by the slice and any other as `record-source-text` says. Any other
` value a pattern has has no shape here, and `it` in an arm with no pattern, which the reference
` types as the subject but gives empty text, is an error. Nothing reads the value of a pattern whose expression does
` not read `it`. It reads as `location` where its pattern began and ended, or where it is tried
` where it has none. One the reference runs in a function of its own is recorded, and is planned to
` run so where it is not quiet and its own code may panic, which the panic would show; the panic
` pass plans one whose calls may. Nor has an expression that leaves the function, one of a match's
` local rule marked to roll back with no helper, or one that reads a name its pattern may pass
` without capturing. One of a match's own arms marked to roll back where the match has no helper is
` the reference's error, at the match's first arm. One of a rule's marked so with no helper still
` asks for a mark, which the rule's function cannot give where a pattern calls it so. One under a
` helper that cannot roll back makes the match need it to, and one under a helper that can asks it
` for a mark before the expression runs, as does every arm of a rule whose pattern is marked so.
` Under a helper, the names the expression reads, `it` and what it gives are made as
` `materialize-captures` and `materialize-result` say; `it` alone, where a capture materializer
` makes the type the arms give, is made as that type. One that reads a name the helper made as
` another type than it is wanted as, which the reference does, has a shape only where it gives the
` type it gives with the name as it was, as the reference then takes what it gives for that type. A
` name that holds a `CaptureSpan` reads as text, as `observe-spans` says. In a rule that states a
` `CaptureSpan` the arm gives the span of the items it matched, and its expression, whose value the
` reference drops, has a shape only where it gives that type; elsewhere one that gives a span, or
` reads `it` that holds one, which the reference reads as text, has none.
. rolls-back = helping.explicit
do match? tree.nodes[id]
    | .node-stream-transform(row)
        rolls-back = rolls-back || row.rollback
if rolls-back
    if helping.helper == null && rule-streaming.matched != 0 && within-matched
        frame.diagnose
            - rule-streaming.matched
            - .stated
            - program.store-atom("Pattern @rollback requires a with helper")
        = invalid-type
    .. within-matched = tree.subtree-start(rule-streaming.matched) <= id && id < rule-streaming.matched
    if helping.helper == null && rule-streaming.matched != 0
        decline(id)
        = invalid-type
    if helping.helper == null
        facts.note-marking-arm(instance, id)
    else
        helping = helping.rolls = true
        note-helper-use(true)
        if helping.helper!.rollback != no-type
            facts.note-marking-arm(instance, id)
            facts.note-asked-mark(first-type-arg(types, helping.helper!.rollback))
            note-mark()
if spans-source(rule-arming.target) && !rule-arming.span
    decline(id)
    = invalid-type
. forwards-it = forwarding && name-text(forwarded-read(body)) == "it"
    .. forwarding = helping.helper != null && forwarded-read(body) != 0
. it-wanted = types.string-type
if forwards-it && non-text-target && source-candidates(rule-arming.target).length != 0
    it-wanted = rule-arming.target
.. non-text-target = rule-arming.target != no-type && peeled-optional(rule-arming.target) != types.string-type
. it-type = types.string-type
. spans-it = no-type
if pattern != 0
    . reads = mentions(body, "it")
    . slot = arm-slot(id, .slot-it)
    . sequence = tree.nodes[pattern] is .node-stream-and
    if reads && !forwards-it
        spans-it = it-span(pattern, body, slot)
    . saved-unvalued = valuing
    valuing = valuing.unvalued = !reads || (spans-it != no-type && (sequence || calls-stream))
        .. calls-stream = tree.nodes[pattern] is .node-stream-call
    . matched = stream-node-type(pattern)
    valuing = saved-unvalued
    if matched == invalid-type
        = invalid-type
    if spans-it != no-type && !sequence && matched != types.string-type
        spans-it = no-type
    if spans-it != no-type
        it-type = spans-it
        facts.note-spanning-it(instance, id, spans-it)
        frame.assign(slot, spans-it)
    else if !sequence && stream-valued(pattern) && matched != no-type
        plan-valued(pattern)
        it-type = matched
        if slot != no-slot
            frame.assign(slot, matched)
    else
        . held = optional-operand(pattern)
        if reads && held != 0 && text-items() && matched == types.optional-of(types.string-type)
            . made = if tree.nodes[held] is .node-stream-string then sliced-text(pattern) else record-source-text(pattern, types.string-type)
            if made != types.string-type
                decline(id)
                = invalid-type
            plan-valued(pattern)
            facts.set-node-type(instance, pattern, matched)
            it-type = matched
        else if reads
            . made = if text-sourced then record-source-text(id, it-wanted) else invalid-type
                .. text-sourced = sequence || (text-items() && matched == types.string-type)
            if made == invalid-type
                decline(id)
                = invalid-type
            it-type = made
        if slot != no-slot && (text-items() || reads)
            frame.assign(slot, it-type)
else if mentions(body, "it")
    frame.diagnose(id, .stated, program.store-atom("An arm with no pattern has no \"it\"; read the subject by its name"))
    = invalid-type
if !type-location(id, pattern != 0, body)
    decline(id)
    = invalid-type
. restores [SlotId]
. restored [TypeId]
if helping.helper != null && !materialize-captures(id, body, restores, restored)
    = invalid-type
if !observe-spans(id, body, restores, restored) || it-spanned
    decline(id)
    = invalid-type
.. it-spanned = observes-span(it-type) && spans-it == no-type && mentions(body, "it")
keep-text-spans(body, restores, restored)
. selects = action-selects
. remade [U32]
. unmade [TypeId]
for offset in 0 .. < remade-positions.length
    remade += remade-positions[offset]
    unmade += remade-types[offset]
. was = instances.rows[instance].may-panic
instances.clear-may-panic(instance)
. outer-arm = valuing
valuing = valuing.action-arm = id
. value = check-statement(body)
valuing = outer-arm
if (value == no-type || value == types.void-type) && final-print(body) != 0
    frame.diagnose(final-print(body), .stated, program.store-atom(print-block-text()))
    = invalid-type
. panics-here = instances.rows[instance].may-panic
if was
    instances.mark-may-panic(instance)
if value == invalid-type
    = invalid-type
if rule-arming.target == no-type && reads-atom(body)
    pattern-arms = pattern-arms.uninferred = true
if rolled-remakes && (outer || trial-type(body, remade, unmade) != value)
    decline(id)
    = invalid-type
.. rolled-remakes = remade.length != 0 && helping.helper!.rollback != no-type
remakes-result = false
if helping.helper != null && value != no-type
    value = materialize-result(id, pattern, body, value, selects, forwards-it)
    if value == invalid-type
        = invalid-type
if value == no-type || narrowing.exits(body)
    decline(id)
    = invalid-type
. uncovered = uncovered-read(pattern, body)
if uncovered != 0
    if tree.nodes[uncovered] is .node-identifier
        frame.diagnose(uncovered, .stated, program.store-atom(uncovered-text(uncovered)))
    else
        decline(id)
    = invalid-type
. unplain = unplain-slice(body)
if unplain != 0
    frame.diagnose(unplain, .stated, program.store-atom(slice-read-text()))
    = invalid-type
if rule-arming.span
    if value != rule-arming.target || remakes-result || forwards-it
        decline(id)
        = invalid-type
    facts.note-spanning-arm(instance, id)
else if observes-span(value)
    decline(id)
    = invalid-type
if !remakes-result && outlines(pattern, body, value)
    note-outlined-action(id, body, it-type)
    if !is-quiet(body)
        if panics-here
            facts.set-plan(instance, id, .plan-outlined-panic)
        panics.note-outlined(instance, id, body)
for position in 0 .. < restores.length
    frame.assign(restores[position], restored[position])
facts.set-node-type(instance, id, value)
= value

────────────────────
_ it-span TypeId
    - pattern SyntaxId
    - body SyntaxId
    - slot SlotId

` The `CaptureSpan` an action that reads `it` sees it as, as the reference keeps it where the
` action reads it only for numbers its span gives as its text does and `it` is the text of the
` characters the arm's pattern matched: that of a sequence, or of a part that gives the text it
` matched, which is not optional; none where it is anything else, and in a rule that states a
` span.
|? slot == no-slot || !text-items() || rule-arming.span || optional-operand(pattern) != 0
    no-type
|? !(tree.nodes[pattern] is .node-stream-and) && !returns-span(instance, pattern)
    no-type
??
    if reads-span-numbers(body, slot, span) then span else no-type

.. span = class-over(types.capture-span-decl, buffer-item)

────────────────────
_ do reads-atom Bool
    - body SyntaxId

` Whether an action reads a property of an `Atom`, which the reference finds no type for
` where it infers what an action gives, and so takes the action to give none.
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-get-expression(row)
            . held = facts.node-type(instance, row.object)
            if held != no-type && held != invalid-type && holds-atom
                = true
            .. holds-atom = types.intrinsic-of(peeled-optional(held)) == .atom
= false

────────────────────
_ do observe-spans Bool
    - id SyntaxId
    - body SyntaxId
    - restores [SlotId]
    - restored [TypeId]

` Plans how an action reads the names that hold a `CaptureSpan`, as the reference makes them
` where the action starts, with a helper or none: one that holds the span of the stream's
` characters reads as their text, made by `slice-string` of the items it spans. One the helper
` made as another type is left as that. One that holds a span of other items, or in an
` optional or a list, has no shape here. Keeps the slots it retypes, and their types before.
` False where an action has no shape.
. seen [SlotId]
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . slot = capture-slot(node)
            . position = if slot != no-slot then capture-position(slot, pattern-arms.arm) else U32.max
            if position != U32.max && seen.find(slot) == null
                seen += slot
                . held = facts.node-type(instance, capture-sites[position])
                if !observes-span(held) || restores.find(slot) != null
                    continue
                if !text-items() || !gives-source-span(held)
                    = false
                if reads-span-numbers(body, slot, held)
                    continue
                . made = calls.protocol-call
                    - field-of(held, 0)
                    - program.store-atom("slice-string")
                    - id
                    - no-type
                    - false
                    - no-type
                    - no-type
                    - false
                if made.answer != types.string-type || made.fact == no-fact
                    = false
                facts.record-material
                    - MaterialFact
                        - instance
                        - id
                        - .material-span-text
                        - slot
                        - types.string-type
                        - no-type
                        - made.fact
                restores += slot
                restored += held
                frame.assign(slot, types.string-type)
= true

────────────────────
_ do keep-text-spans
    - body SyntaxId
    - restores [SlotId]
    - restored [TypeId]

` Keeps as the `CaptureSpan` of the characters it matched each name captured over text that an
` action reads only for numbers its span gives as its text does, as the reference keeps such a
` name, with a helper or none, where nothing made it otherwise: as an optional span, read only
` through `?.`, where the name is captured over an optional part. Keeps the slots it retypes,
` and their types before.
if !text-items()
    =
. span = class-over(types.capture-span-decl, buffer-item)
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . slot = capture-slot(node)
            if slot == no-slot || restores.find(slot) != null
                continue
            . text = plain-text(slot)
            if text == no-type
                continue
            . optional = types.is-optional(text)
            if !reads-span-numbers(body, slot, span, optional)
                continue
            restores += slot
            restored += text
            frame.assign(slot, if optional then types.optional-of(span) else span)

────────────────────
_ do plain-text TypeId
    - slot SlotId

` The text a name holds where it is captured, once or as alternatives of one another, over text
` that no repeat holds and the stream's buffer gives no part of, and it does not accumulate:
` text, or optional text where each place it is captured is an optional part. None where it is
` anything else.
. found = no-type
for position in rule-arming.capture-base .. < capture-slots.length
    if capture-slots[position] != slot
        continue
    . site = capture-sites[position]
    . plan = facts.plan-of(instance, site)
    . type = facts.node-type(instance, site)
    . optional = type == types.optional-of(types.string-type) && optional-part
        .. optional-part = optional-operand(capture-patterns[position]) != 0
    if capture-accumulating[position] || capture-repeats[position] != 0 || (type != types.string-type && !optional) || plan == .plan-stream-value || plan == .plan-stream-slice || (found != no-type && found != type)
        = no-type
    found = type
= found

────────────────────
_ do reads-span-numbers Bool
    - body SyntaxId
    - slot SlotId
    - span TypeId
    - optional Bool = false

. names = 0
. reads = 0
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-function-syntax
            = false
        | .node-identifier
            if capture-slot(node) == slot
                names += 1
        | .node-get-expression(row)
            if tree.nodes[row.object] is .node-identifier && capture-slot(row.object) == slot
                if row.is-tracked || row.is-optional != optional || row.is-loop || foreign-number
                    = false
                .. foreign-number = !shares-number(span, row.name)
                reads += 1
        | .node-call-expression(row)
            if !optional
                reads += passed-spans(row, slot, span)
= names == reads

────────────────────
_ do passes-spans-only Bool
    - slot SlotId
    - body SyntaxId

` Whether an action gives a name captured over text to a function that takes its span, and
` reads it otherwise only for numbers its span gives as its text does (`reads-span-numbers`).
. passed = false
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-call-expression(row)
            passed = passed || passed-spans(row, slot, class-over(types.capture-span-decl, buffer-item)) != 0
= passed && reads-span-numbers(body, slot, class-over(types.capture-span-decl, buffer-item))

────────────────────
_ do passed-spans Int
    - call ASTCallExpression
    - slot SlotId
    - span TypeId

` How many times a call gives a name, alone, as a positional argument that no named one precedes,
` to a function that takes its span there (`takes-span`).
. passed = 0
. position = 0u32
for arg in tree.children[call.args]
    . expr = arg
    . optional = false
    do match? tree.nodes[arg]
        | .node-argument(argument)
            if argument.name
                break
            expr = argument.expr
            optional = argument.is-optional
    if !optional && captured-name && takes-span(call, position, span)
        passed += 1
    .. captured-name = tree.nodes[expr] is .node-identifier && capture-slot(expr) == slot
    position += 1
= passed

────────────────────
_ do takes-span Bool
    - call ASTCallExpression
    - position U32
    - span TypeId

` Whether a call by a name alone reaches a function that states a `CaptureSpan` for the parameter
` at a position, as the reference finds one among the functions of a module the name looks up:
` one that is no method, takes no list of the rest, and is seen from here.
if call.is-curried || call.param-count != 0
    = false
. callee Atom? = null
do match? tree.nodes[call.callable]
    | .node-identifier(read)
        callee = read.name
if !callee
    = false
for candidate in program.lookup(module, callee)
    . target = program.modules[candidate.module]
    do match? target.decls[candidate.decl]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .function-decl && positional && visible
                . types-mark = types.scratch.types.mark
                . names-mark = types.scratch.names.mark
                . signature = signature-into
                    - types
                    - candidate.module
                    - candidate.decl
                    - no-type-arguments(types)
                    - no-type
                    - true
                . wanted = in-signature && same-class(types, signature.args[position], span)
                    .. in-signature = position < signature.args.length
                types.scratch.types.rewind(types-mark)
                types.scratch.names.rewind(names-mark)
                if wanted
                    = true
            .. positional = fn.variadic-index == U32.max && position < fn.args.count
            .. visible = fn.access == .public-access || candidate.module == module
= false

────────────────────
_ shares-number Bool
    - span TypeId
    - name Atom

|? class-arg(types, span, 0) != types.type-row(.char) || !found || !text
    false
??
    is-numeric(types, type) && type == member-type(types.properties[text], types.string-type)

.. found = types.property-named(span, name)
.. text = types.property-named(types.string-type, name)
.. type = member-type(types.properties[found], span)

────────────────────
_ do observes-span Bool
    - type TypeId

` Whether a value holds a `CaptureSpan`, itself or in an optional or a list, which the
` reference has an action read, and give, as the text or the items it spans.
if type == no-type || type == invalid-type
    = false
. inner = peeled-optional(type)
do match? types.rows[inner]
    | .type-class(row)
        if types.capture-span-decl.refers-to(row.module, row.decl)
            = true
        if types.list-decl.refers-to(row.module, row.decl) || immutable-array
            = observes-span(class-arg(types, inner, 0))
        .. immutable-array = types.immutable-array-decl.refers-to(row.module, row.decl)
= false

────────────────────
_ do span-arm-type TypeId
    - id SyntaxId

` An arm that runs no expression in a pattern that is to give a `CaptureSpan`: where a rule
` states the span of its stream's items, the arm gives the span of the items it matched, and
` nothing reads what its pattern gives. Any other such pattern has no shape here.
if !rule-arming.span
    decline(id)
    = invalid-type
. saved-unvalued = valuing
valuing = valuing.unvalued = true
. matched = stream-node-type(id)
valuing = saved-unvalued
if matched == invalid-type
    = invalid-type
facts.note-spanning-arm(instance, id)
= rule-arming.target

────────────────────
_ gives-source-span Bool
    - type TypeId

` Whether a type a rule states is the `CaptureSpan` of the items its stream holds, over the
` buffer the stream reads. The reference then has each arm of the rule give the span of the
` items it matched, whatever its pattern or its action gives.
|? type == no-type || type == invalid-type || types.is-optional(type) || !spans-source(type)
    false
??
    stream-view.item != no-type && over-buffer && field-of(type, 0) == stream-view.buffer

.. over-buffer = class-arg(types, type, 0) == buffer-item

────────────────────
_ do spans-source Bool
    - type TypeId

` Whether a pattern is to give a `CaptureSpan`, optional or not. The reference then gives the
` span of the items the pattern matched, whatever its actions give, which has a shape only
` for the arms of a rule that `gives-source-span` says.
if type == no-type || type == invalid-type
    = false
do match? types.rows[peeled-optional(type)]
    | .type-class(row)
        = types.capture-span-decl.refers-to(row.module, row.decl)
= false

────────────────────
_ do ranged-capture Bool?
    - id SyntaxId
    - slot SlotId

` Whether a name captured over text in a repeat keeps the ranges of its passes, as the
` reference keeps one an action that reads it makes through a capture materializer, wanted as
` a list of text or, where the action is that name alone, as what the arms give. A name some
` actions make so and others read as text has no shape here; null where a choice is ambiguous
` or the pattern has no shape.
. listed = class-over(types.immutable-array-decl, types.string-type)
. made = false
. plain = false
for node in tree.subtree-start(rule-arming.capture-root) .. < rule-arming.capture-root + 1
    do match? tree.nodes[node]
        | .node-stream-transform(row)
            if row.right != 0 && !tree.lazies-only(row.right) && reads-slot(row.right, slot)
                . forwarded = forwarded-read(row.right)
                . forwards = forwarded != 0 && capture-slot(forwarded) == slot
                . result = if rule-arming.target != no-type then rule-arming.target else listed
                . desired = if forwards && contains-output(result) then result else listed
                . chosen = select-materializer
                    - helping.helper!.captures
                    - buffer-item
                    - desired-leaf(desired)
                    - true
                    - node
                if chosen == invalid-type
                    = null
                if chosen == no-type
                    plain = true
                else
                    made = true
if made && plain
    decline(id)
    = null
= made

────────────────────
_ do results-assumed Bool
    - mark Size
    - result TypeId
    - pattern SyntaxId

` Whether the arms that a helper made values for, where the arms declare no type, chose as they
` would have with the type they join as, which the reference takes. Where any did not, the
` pattern has no shape here. An action taken to make its value again does so where the arms
` give the type it took.
. agreed = true
for position in mark .. < assumed-results.length
    . assumed = assumed-results[position]
    if !agrees(assumed, result)
        agreed = false
    else if assumed.interface != no-type && assumed.value == result
        if !record-result(assumed.site, assumed.value, assumed.interface)
            agreed = false
-= assumed-results[mark .. < assumed-results.length]
if !agreed
    decline(pattern)
= agreed

────────────────────
_ agrees Bool
    - assumed AssumedResult
    - result TypeId

` Whether an action that took its own type for the type the arms give chose as it would have
` with the type they join as: where the type is the same; else where it materializes with
` both or with neither, a name it forwards wanted as the type it would be wanted as selects no
` materializer, `it` forwarded would be no other text, and where the action materializes, the
` helper makes neither type. Where the helper makes the type it took and not the one the arms
` give, the action's value is not made again, which is as the action chose but for the
` function of its own the reference may then run it in: so only where it surely runs none, an
` action with no pattern, one that gives text, or a name, a number or text written alone.
|? assumed.value == result
    true
|? selected != (assumed.selects || values-select(assumed.value))
    false
|? forwarding && changed && selects(assumed.forwarded, result, assumed.backed, assumed.site) != 0
    false
|? assumed.forwards-it && untexted && source-candidates(result).length != 0
    false
|? !selected || (!contains-output(assumed.value) && !contains-output(result))
    true
??
    !contains-output(result) && (assumed.pattern == 0 || gives-text || trivial-action(assumed.body))

.. selected = assumed.selects || values-select(result)
.. forwarding = assumed.forwarded != no-type && contains-output(result)
.. changed = result != assumed.forwarded
.. untexted = peeled-optional(result) != types.string-type
.. gives-text = assumed.value == types.string-type

────────────────────
_ do forwarded-read SyntaxId
    - body SyntaxId

` The name an action's expression is, where it is one name alone, as the reference finds a
` capture an action forwards. None for any other expression.
. inner = body
do match? tree.nodes[body]
    | .node-block(block)
        if block.body.count != 1
            = 0
        inner = tree.children[block.body.start]
= if tree.nodes[inner] is .node-identifier then inner else 0

────────────────────
_ do capture-position U32
    - slot SlotId
    - arm SyntaxId

` Where among the names the match captures a slot is kept, or `U32.max` for one it does not:
` the place in `arm` where it has one, as a name of a rule's pattern may hold another type in
` another arm.
if arm != 0
    for position in rule-arming.capture-base .. < capture-slots.length
        if capture-slots[position] == slot && after-start && capture-sites[position] <= arm
            = position as U32
        .. after-start = tree.subtree-start(arm) <= capture-sites[position]
for position in rule-arming.capture-base .. < capture-slots.length
    if capture-slots[position] == slot
        = position as U32
= U32.max

────────────────────
_ do materialize-captures Bool
    - id SyntaxId
    - body SyntaxId
    - restores [SlotId]
    - restored [TypeId]

` Plans how the helper makes the names an action reads, in the order the expression first reads
` them, as the reference materializes them where the action starts. Each is wanted as the type
` `capture-wanted` says, or, where one could be made as another type and the expression is not
` typed with the first, as the one choice of the others it is typed with, as the reference
` chooses; two such choices are its error. Each is then made as `materialize-capture` says,
` and the expression is typed with what it holds. Notes in `action-selects` whether any name
` selects a materializer. Keeps the slots it retypes, and their types before.
action-selects = false
remade-positions.clear()
remade-types.clear()
. forwarded = forwarded-read(body)
. seen [SlotId]
. positions [U32]
. sites [SyntaxId]
. candidates [TypeId]
. starts [U32]
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . slot = capture-slot(node)
            . position = if slot != no-slot then capture-position(slot, pattern-arms.arm) else U32.max
            if position != U32.max && seen.find(slot) == null
                seen += slot
                positions += position
                sites += node
                starts += candidates.length as U32
                if !capture-wanted(id, position, node == forwarded, candidates)
                    = false
starts += candidates.length as U32
. chosen = choose-captures(id, body, positions, candidates, starts)
if chosen == null
    = false
for offset in 0 .. < positions.length
    if !materialize-capture(id, body, positions[offset], chosen[offset], restores, restored)
        = false
= true

────────────────────
_ do capture-wanted Bool
    - id SyntaxId
    - position U32
    - forwards Bool
    - candidates [TypeId]

` The types a name an action reads may be wanted as, first the one the reference wants it as: what
` it holds, or where the action is that name alone and the arms give a type a materializer makes,
` that type; then each other type the materializers that apply to it make, put in what it holds past
` optionals and lists, where one is selected for it. Under a helper with no materializer, only what
` it holds, as is a name that accumulates what rules gave where no value materializer takes one, and
` a name that holds the text of a rule that states another type, which the reference holds as that
` type. Otherwise a name that accumulates, holds a part of the buffer, or holds what a rule gave
` that is the text it matched has no shape here. False where the pattern has no shape.
. name = capture-sites[position]
. natural = facts.node-type(instance, name)
if helping.helper!.captures.length == 0 && helping.helper!.values.length == 0
    candidates += natural
    = true
. plan = facts.plan-of(instance, name)
. backed = plan != .plan-stream-value
if capture-accumulating[position] && !backed && selects(natural, natural, false, id) == 0
    candidates += natural
    = true
if (capture-accumulating[position] && backed) || plan == .plan-stream-slice
    decline(id)
    = false
if !backed && returns-span(instance, capture-patterns[position])
    decline(id)
    = false
. result = if rule-arming.target != no-type then rule-arming.target else natural
. desired = if forwards && contains-output(result) then result else natural
candidates += desired
if backed && desired-leaf(natural) != types.string-type
    = true
for materializer in if backed then helping.helper!.captures else helping.helper!.values
    . candidate = with-leaf(desired, second-type-arg(materializer))
    if candidate != desired && candidates.find(candidate) == null
        . also = selects(natural, candidate, backed, id)
        if also == 2
            = false
        if also == 1
            candidates += candidate
= true

────────────────────
_ do choose-captures [TypeId]?
    - id SyntaxId
    - body SyntaxId
    - positions [U32]
    - candidates [TypeId]
    - starts [U32]

` The types the names an action reads are wanted as, as the reference chooses them: each the
` first it may be wanted as, where none may be wanted as another or the expression is typed
` with those; else of the choices of the others, tried in order, that the expression is typed
` with, the one that makes the most names as a materializer does, or the first where none is.
` Two such choices that make as many are the reference's error at the action, which names the
` first two. An action of a closure has no shape here where a choice must be tried. Null where
` the pattern has no shape.
. firsts [TypeId]
. several = false
for offset in 0 .. < positions.length
    firsts += candidates[starts[offset]]
    if starts[offset + 1] - starts[offset] > 1
        several = true
if !several
    = firsts
if outer
    decline(id)
    = null
if accepts(body, positions, firsts)
    = firsts
. found [TypeId]
. second [TypeId]
. count = 0
. most = 0
. picks [U32]
for _ in positions
    picks += 0
. done = false
while !done
    . moved = false
    . place = positions.length
    while place != 0 && !moved
        place -= 1
        if picks[place] + 1 < starts[place + 1] - starts[place]
            picks[place] += 1
            for later in place + 1 .. < positions.length
                picks[later] = 0
            moved = true
    if !moved
        done = true
    else
        . made = 0
        for pick in picks
            if pick != 0
                made += 1
        if made >= most
            . tried [TypeId]
            for offset in 0 .. < positions.length
                tried += candidates[starts[offset] + picks[offset]]
            if accepts(body, positions, tried)
                if made > most
                    most = made
                    count = 1
                    found = tried
                else
                    count += 1
                    if count == 2
                        second = tried
if count > 1
    . options [String]
    for choice in [found, second]
        . parts [String]
        for offset in 0 .. < positions.length
            parts += "${name-text(capture-sites[positions[offset]])}=${choice-key}"
                .. choice-key = type-key(types, choice[offset])
        options += ", ".join(parts)
    frame.diagnose
        - id
        - .stated
        - program.store-atom
            - "Ambiguous pattern action capture materialization: ${" or ".join(options)}"
    frame.mention(found ++ second)
    = null
= if count == 1 then found else firsts

────────────────────
_ do accepts Bool
    - body SyntaxId
    - positions [U32]
    - wanted [TypeId]

` Whether an action's expression is typed with the names it reads holding the types given, as
` `trial-type` types it.
. value = trial-type(body, positions, wanted)
= value != invalid-type && value != no-type

────────────────────
_ do trial-type TypeId
    - body SyntaxId
    - positions [U32]
    - wanted [TypeId]

` The type an action's expression gives with the names it reads holding the types given, as
` the reference tries it, on trial (`trial-checker`). Invalid where it reports any.
. checker = trial-checker(body)
for offset in 0 .. < positions.length
    checker.frame.assign(capture-slots[positions[offset]], wanted[offset])
. reported = facts.diagnostics.length
. value = checker.check-statement(body)
if facts.diagnostics.length != reported
    value = invalid-type
facts.diagnostics.truncate(reported)
checker.close()
checker.retire()
= value

────────────────────
_ do trial-transition
    - transition SyntaxId
    - items [SyntaxId]
    - slots [SlotId]
    - given [TypeId]
    - wanted [SlotId]
    - found [TypeId]
    - targets [TypeId]

` What a transition of a machine, written among a body's items, sees and gives, typed on trial
` apart from where it fires (`trial-checker`) with the names its activation sees holding the
` types given, as the reference infers what a case holds and the names it keeps: the type of
` each slot wanted once its trigger's pattern has matched (`foresee-transition`), added to
` `found`, and of each of its targets, added to `targets`. None of either where the part that
` gives them reports anything.
. checker = trial-checker(transition)
for offset in 0 .. < slots.length
    if given[offset] != no-type && given[offset] != invalid-type
        checker.frame.assign(slots[offset], given[offset])
. reported = facts.diagnostics.length
checker.foresee-transition(transition, items, wanted, found, targets)
facts.diagnostics.truncate(reported)
checker.close()
checker.retire()

────────────────────
_ do foresee-transition
    - transition SyntaxId
    - items [SyntaxId]
    - wanted [SlotId]
    - found [TypeId]
    - targets [TypeId]

` A transition typed on trial as the group it is in runs it, without its guard: `each` and `it`
` are an item of its stream (`foreseen-item`), or what an `if | p = s` tests, which its pattern
` matches, and then its targets are typed. Its guard is left out, as the reference leaves it
` out where it infers what a case holds, since it may read the machine.
. reported = facts.diagnostics.length
. trigger = tree.state-trigger(transition)
if trigger != 0
    . subject = tree.trigger-subject(trigger)
    . stream = tree.trigger-stream(trigger)
    . item = if subject != 0 then infer(subject) else if stream != 0 then foreseen-item(stream) else no-type
    if stream != 0 && item != no-type && item != invalid-type
        for head in tree.group-heads(items)
            if tree.group-transitions(items, head).find(transition) != null
                . each = bindings.declared-kind-at(frame.slots, head, .slot-each)
                . it = bindings.declared-kind-at(frame.slots, head, .slot-it)
                if each != no-slot
                    frame.assign(each, item)
                if it != no-slot
                    frame.assign(it, item)
    if tree.trigger-pattern(trigger) != 0
        if item == no-type || item == invalid-type
            =
        type-trigger-pattern(trigger, item)
if facts.diagnostics.length != reported
    =
for slot in wanted
    found += frame.slot-type(slot)
. given = facts.diagnostics.length
for target in tree.children[tree.state-targets(transition)]
    targets += infer(target)
if facts.diagnostics.length != given
    targets.clear()

────────────────────
_ do foreseen-item TypeId
    - written SyntaxId

` The item the stream a trigger is on gives, as `type-group` finds it: what an event of an
` object publishes, the item of the `Broadcastable` the stream is or converts to, or the item of
` a stream that is only iterable. No type where it is none of these.
. found = infer-found(written, Want().adding(.want-event))
. given = found.type
if found.event != U32.max
    . event = found-events[found.event]
    = event.payload
if given == invalid-type || given == no-type || types.broadcastable-decl.module == 0
    = no-type
if interface-of(given, types.broadcastable-decl) == no-type && iterates-as-source(given)
    = loop-item-type(iteration-container(given, written), written)
. stream = supported(given, types.broadcastable-decl)
if stream == no-type
    = no-type
= first-arg(stream)

────────────────────
_ do trial-checker Checker
    - body SyntaxId

` A checker of its own for an instance of this one's declaration that nothing runs, nested
` where this one is, which reserves only the nodes of a part of the body and knows the slots
` this frame knows, and whose facts are dropped, to type that part on trial.
instances.probes += 1
. row = instances.rows[instance]
. signature = instances.signatures[instance]
. mark = scratch.types.mark
for position in 0 .. < signature.param-count
    scratch.types.push(instances.param-type(instance, position))
. params = scratch.types.since(mark)
. args-mark = scratch.types.mark
for position in 0 .. < signature.args.count
    scratch.types.push(instances.argument-type(instance, position))
. args = scratch.types.since(args-mark)
. probe = instances.intern
    - row.module
    - row.decl
    - row.self-type
    - row.effects
    - row.enclosing
    - params
    - args
    - false
    - no-type
    - U32.max
    - false
    - instances.probes
scratch.types.rewind(mark)
. start = tree.subtree-start(body)
. checker = checker-for(session, probe, outer, true, false, SyntaxRange(start, body - start + 1))
checker.prepare()
for offset in 0 .. < frame.slots.count
    . slot = frame.slots.start + offset
    . known = frame.known(slot)
    if known != no-type && known != invalid-type
        checker.frame.assign(slot, known)
= checker

────────────────────
_ do materialize-capture Bool
    - id SyntaxId
    - body SyntaxId
    - position U32
    - desired TypeId
    - restores [SlotId]
    - restored [TypeId]

` Plans how the helper makes a name an action reads, wanted as a type, as the reference does
` where the action starts. A name captured over text is made by the capture materializer
` selected for the stream's items and the type wanted, where one is, from its cursors; a name
` that holds a value, by the value materializer selected for its type. An optional name is
` made only where it holds a value; a list of text, one by one, from the ranges its passes
` kept. A name the action reads only for its length, an optional one through `?.`, or gives
` only to functions that take its span (`passes-spans-only`), is left as its text. A name no
` materializer is selected for is left as it is, whatever type it is wanted as, but one that
` holds text for another type has no shape here, nor has such a name the action reads only
` for its length or its span. A name that
` holds a value wanted as its own type, for which the reference selects a value materializer
` that makes another, is made as that other all the same, and noted in `remade-positions`.
. helper = helping.helper!
. name = capture-sites[position]
. slot = capture-slots[position]
. natural = facts.node-type(instance, name)
. backed = facts.plan-of(instance, name) != .plan-stream-value
. ranges = facts.first-material(instance, name)
. chosen = selects(natural, desired, backed, id)
if chosen == 2
    = false
. texted = !backed || desired-leaf(natural) == types.string-type
if chosen == 0
    if !texted
        decline(id)
        = false
    = true
action-selects = true
if backed && !texted && (reads-length-only(slot, body) || passes-spans-only(slot, body))
    decline(id)
    = false
if is-listed(natural)
    = materialize-list(id, position, ranges, desired, backed, restores, restored)
. optional = types.is-optional(natural)
. leaf = if optional then types.optional-inner(natural) else natural
. wanted = if types.is-optional(desired) then types.optional-inner(desired) else desired
if backed && texted && (length-only || (!optional && passes-spans-only(slot, body)))
    = true
.. length-only = reads-length-only(slot, body, optional)
. interface = select-materializer
    - if backed then helper.captures else helper.values
    - if backed then buffer-item else leaf
    - wanted
    - backed
    - id
if interface == invalid-type
    = false
. made = second-type-arg(interface)
if !backed && wanted == leaf && made != leaf
    remade-positions += position
    remade-types += natural
. kind = if backed then MaterialKind.material-capture else MaterialKind.material-value
if !record-material(id, kind, slot, if optional then types.optional-of(made) else made, interface, leaf)
    = false
. typed = if optional then types.optional-of(made) else made
restores += slot
restored += natural
frame.assign(slot, typed)
= true

────────────────────
_ do materialize-list Bool
    - id SyntaxId
    - position U32
    - ranges U32
    - desired TypeId
    - backed Bool
    - restores [SlotId]
    - restored [TypeId]

` Plans how the helper makes a name captured in a repeat, one pass at a time, in order, into a
` collector of what it makes, whose list the action reads: for text, each range the passes
` kept, by the capture materializer selected for the stream's items and what the list is
` wanted to hold; for values, each value, by the value materializer selected for its type,
` noted in `remade-positions` where it makes another type than the list is wanted to hold.
if backed && (ranges == U32.max || facts.materials[ranges].kind != .material-ranges)
    decline(id)
    = false
. slot = capture-slots[position]
. natural = facts.node-type(instance, capture-sites[position])
. item = first-arg(natural)
if types.is-optional(item)
    decline(id)
    = false
. interface = select-materializer
    - if backed then helping.helper!.captures else helping.helper!.values
    - if backed then buffer-item else item
    - desired-leaf(desired)
    - backed
    - id
if interface == invalid-type
    = false
. made = second-type-arg(interface)
if !backed && desired-leaf(desired) == item && made != item
    remade-positions += position
    remade-types += natural
. listed = class-over(types.immutable-array-decl, made)
. collector = collector-over(made)
. kind = if backed then MaterialKind.material-capture else MaterialKind.material-value
if collector == invalid-type || !record-material(id, kind, slot, listed, interface, item)
    decline(id)
    = false
. growing = calls.protocol-call(collector, program.store-atom("grow"), id, no-type, false, no-type, no-type, false)
if growing.answer != grown-items(collector) || growing.fact == no-fact
    decline(id)
    = false
facts.record-material
    - MaterialFact(instance, id, .material-grow, slot, collector, no-type, growing.fact)
if listed != natural
    restores += slot
    restored += natural
    frame.assign(slot, listed)
= true

────────────────────
_ do materialize-result TypeId
    - id SyntaxId
    - pattern SyntaxId
    - body SyntaxId
    - value TypeId
    - selects Bool
    - forwards-it Bool

` What an action gives under a helper, as the reference materializes it: an action whose names
` select a materializer, or whose arms give a type a value materializer's output converts to
` better than down, materializes, and has the helper roll back where it implements
` `PatternRollback`. Where the arms give a type a materializer makes, what such an action gives is
` made again by the value materializer selected for it, and the action gives what that makes; but
` not where the action is `it` alone, made as that type already. An optional value is made again
` only where it holds one, where the arms give an optional too, and a list item by item, where
` they give a list; an optional the arms give as what it holds, a list they give as none, and a
` list of optionals or of lists have no shape here. Where the arms declare no type, the action's
` own stands for theirs, as `results-assumed` then checks, and the value materializer selected is
` only noted there, to be called once the arms are known to give that type. An action that
` materializes where the arms give such a type `remakes-result`, which the reference runs where
` its arm does, never in a function of its own.
. helper = helping.helper!
. result = rule-arming.target
. assuming = result == no-type
. natural = no-type
. backed = false
if assuming
    result = value
    . forwarded = if forwarded-read(body) != 0 then forwarded-position else U32.max
        .. forwarded-position = capture-position(capture-slot(forwarded-read(body)), pattern-arms.arm)
    natural = if forwarded != U32.max then forwarded-type else no-type
        .. forwarded-type = facts.node-type(instance, capture-sites[forwarded])
    backed = forwarded != U32.max && plain-forward
        .. plain-forward = facts.plan-of(instance, capture-sites[forwarded]) != .plan-stream-value
    assumed-results += AssumedResult
        - value
        - selects
        - forwards-it
        - natural
        - backed
        - id
        - pattern
        - body
        - no-type
. selected = selects || values-select(result)
if !selected
    = value
pattern-arms = pattern-arms.selects = true
remakes-result = contains-output(result)
note-helper-use(helper.rollback != no-type)
if !contains-output(result) || forwards-it
    = value
. requires = result-requires(value, result, id)
if requires == 2
    = invalid-type
if requires == 0
    = value
. listing = is-listed(value)
. optional = types.is-optional(value)
if (listing && !is-listed(result)) || (optional && !types.is-optional(result))
    decline(id)
    = invalid-type
. leaf = if listing then first-arg(value) else if optional then inner-value else value
    .. inner-value = types.optional-inner(value)
if types.is-optional(leaf) || is-listed(leaf)
    decline(id)
    = invalid-type
. wanted = if listing then first-arg(result) else if optional then inner-result else result
    .. inner-result = types.optional-inner(result)
. interface = select-materializer(helper.values, leaf, wanted, false, id)
if interface == invalid-type
    = invalid-type
if interface == no-type
    = value
. made = remade-as(value, interface)
if assuming
    if made != value
        decline(id)
        = invalid-type
    assumed-results[assumed-results.length - 1] = AssumedResult
        - value
        - selects
        - forwards-it
        - natural
        - backed
        - id
        - pattern
        - body
        - interface
    = made
if !record-result(id, value, interface)
    = invalid-type
= made

────────────────────
_ do remade-as TypeId
    - value TypeId
    - interface TypeId

` The type a value made again by a value materializer has: what the materializer makes, as
` an optional where the value is one, or a list where it is a list.
. made = second-type-arg(interface)
if is-listed(value)
    = class-over(types.immutable-array-decl, made)
= if types.is-optional(value) then types.optional-of(made) else made

────────────────────
_ do record-result Bool
    - site SyntaxId
    - value TypeId
    - interface TypeId

` Records the call of the value materializer that makes what an action gives again: of the
` value; of what an optional one holds, which is made only where it holds one and given as
` the optional of what the materializer makes; or of each item of a list, into a collector of
` what the materializer makes, grown by the call recorded after the materializer's, whose
` list the action then gives. False where the pattern has no shape.
. made = second-type-arg(interface)
if !is-listed(value)
    = record-material
        - site
        - .material-result
        - no-slot
        - remade-as(value, interface)
        - interface
        - if types.is-optional(value) then types.optional-inner(value) else value
. collector = collector-over(made)
if collector == invalid-type || !record-material(site, .material-result, no-slot, remade-as(value, interface), interface, first-arg(value))
    decline(site)
    = false
. growing = calls.protocol-call(collector, program.store-atom("grow"), site, no-type, false, no-type, no-type, false)
if growing.answer != grown-items(collector) || growing.fact == no-fact
    decline(site)
    = false
facts.record-material
    - MaterialFact(instance, site, .material-grow, no-slot, collector, no-type, growing.fact)
= true

────────────────────
_ do values-select Bool
    - type TypeId

` Whether what a value materializer of the helper makes converts to a type better than down,
` as the reference finds an action that gives that type materializing.
for materializer in helping.helper!.values
    . relation = relations.compare(second-type-arg(materializer), type)
    if relation-legal(relation) && relation.rank < down-cast-rank()
        = true
= false

────────────────────
_ do result-requires U8
    - value TypeId
    - result TypeId
    - site SyntaxId

` Whether the reference makes what an action gives again as the type the arms give: where it
` is optional and they are not, or a list and they are not, or what it holds past optionals
` and lists is another type than theirs, or has a value materializer selected for it. 0 for
` no, 1 for yes, 2 where the choice is ambiguous, reported at the site.
if types.is-optional(value)
    = if types.is-optional(result) then result-requires(inner-value, inner-result, site) else 1
        .. inner-value = types.optional-inner(value)
        .. inner-result = types.optional-inner(result)
if is-listed(value)
    = if is-listed(result) then result-requires(first-arg(value), first-arg(result), site) else 1
. chosen = select-materializer(helping.helper!.values, value, result, false, site)
if chosen == invalid-type
    = 2
= if chosen != no-type || value != result then 1 else 0

────────────────────
_ do record-source-text TypeId
    - id SyntaxId
    - result TypeId

` Records where a part of a stream pattern gives the text it matched as a value, the call that
` makes it: under a helper with a capture materializer that makes the type the value is
` wanted as from the stream's items, that materializer's, as the reference's implicit
` materialization; else the slice `record-stream-text` records. The type the text is given
` as, or invalid where the part has no shape.
if helping.helper == null
    = sliced-text(id)
. candidates = source-candidates(result)
if candidates.length == 0
    = sliced-text(id)
. interface = select-materializer(candidates, buffer-item, peeled-optional(result), true, id)
if interface == invalid-type
    = invalid-type
if interface == no-type
    = sliced-text(id)
. made = second-type-arg(interface)
= if record-material(id, .material-text, no-slot, made, interface, no-type) then made else invalid-type

────────────────────
_ do sliced-text TypeId
    - id SyntaxId

` The type of the text a part of a stream pattern gives as `record-stream-text` records it.
= if record-stream-text(id) then types.string-type else invalid-type

────────────────────
_ do source-candidates [TypeId]
    - result TypeId

` The capture materializers of the helper that make the type a value is wanted as, what it
` holds where it is optional.
. wanted = peeled-optional(result)
. found [TypeId]
for materializer in helping.helper!.captures
    if second-type-arg(materializer) == wanted
        found += materializer
= found

────────────────────
_ do peeled-optional TypeId
    - type TypeId

. current = type
while types.is-optional(current)
    current = types.optional-inner(current)
= current

────────────────────
_ is-listed Bool
    - type TypeId

same-decl(class-ref(types, type), types.immutable-array-decl)

────────────────────
_ desired-leaf TypeId
    - type TypeId

` What a type a value is wanted as holds, past optionals and lists, as the reference selects a
` materializer for it.
if is-listed(current) then desired-leaf(first-arg(current)) else current

.. current = peeled-optional(type)

────────────────────
_ do with-leaf TypeId
    - type TypeId
    - leaf TypeId

` A type a value is wanted as, with what it holds past optionals and lists another type.
if types.is-optional(type)
    = types.optional-of(with-leaf(types.optional-inner(type), leaf))
if is-listed(type)
    = class-over(types.immutable-array-decl, with-leaf(first-arg(type), leaf))
= leaf

────────────────────
_ do contains-output Bool
    - type TypeId

` Whether what a type holds past optionals and lists is what one of the helper's materializers
` makes.
. leaf = desired-leaf(type)
for materializer in helping.helper!.captures
    if second-type-arg(materializer) == leaf
        = true
for materializer in helping.helper!.values
    if second-type-arg(materializer) == leaf
        = true
= false

────────────────────
_ do selects U8
    - type TypeId
    - desired TypeId
    - backed Bool
    - site SyntaxId

` Whether the helper selects a materializer for a name of a type wanted as another, past
` optionals and lists: for a name captured over text, a capture materializer of the stream's
` items; else a value materializer of what it holds, which for a value wanted as its own type
` must make that type. 0 for none, 1 for one, 2 where the choice is ambiguous, reported at the
` site.
. held = peeled-optional(type)
. wanted = if types.is-optional(desired) then types.optional-inner(desired) else desired
if is-listed(held)
    held = first-arg(held)
    wanted = if is-listed(wanted) then first-arg(wanted) else wanted
. chosen = select-materializer
    - if backed then helping.helper!.captures else helping.helper!.values
    - if backed then buffer-item else held
    - wanted
    - backed
    - site
if chosen == invalid-type
    = 2
if chosen == no-type
    = 0
if !backed && held == wanted
    . made = relations.compare(second-type-arg(chosen), desired-leaf(wanted))
    if !relation-legal(made) || made.rank >= down-cast-rank()
        = 0
= 1

────────────────────
_ do select-materializer TypeId
    - candidates [TypeId]
    - input TypeId
    - desired TypeId
    - capture Bool
    - site SyntaxId

` The materializer the reference selects among some for an input and a type wanted: of those
` that take the input better than down, and a union only as itself, those that take it as it
` is where any does; of those, the ones whose output
` converts to what the wanted type holds better than down, or else all; the one whose
` conversion ranks best, its output's to the wanted type or else to the input's own text. None
` where none takes the input; a tie is the reference's error at the site.
. leaf = if desired != no-type then desired-leaf(desired) else no-type
. fallback = input
if capture
    fallback = if text-items() then types.string-type else class-over(types.array-decl, input)
. compatible [TypeId]
. ranks [I32]
. fits [Bool]
. exact = false
for candidate in candidates
    exact = exact || (first-type-arg(types, candidate) == input && takes-input(candidate, input))
for candidate in candidates
    if !takes-input(candidate, input) || (exact && first-type-arg(types, candidate) != input)
        continue
    . output = second-type-arg(candidate)
    . fit = false
    . rank = I32.max
    if leaf != no-type
        . given = relations.compare(output, leaf)
        if relation-legal(given) && given.rank < down-cast-rank()
            fit = true
            rank = given.rank
    if !fit
        . plain = relations.compare(output, fallback)
        if relation-legal(plain) && plain.rank < down-cast-rank()
            rank = plain.rank
    compatible += candidate
    ranks += rank
    fits += fit
. any-fit = fits.find(true) != null
. best = I32.max
for position in 0 .. < compatible.length
    if (fits[position] || !any-fit) && ranks[position] < best
        best = ranks[position]
. chosen [TypeId]
for position in 0 .. < compatible.length
    if (fits[position] || !any-fit) && ranks[position] == best
        chosen += compatible[position]
if chosen.length > 1
    . keys [String]
    for type in chosen
        keys += type-key(types, type)
    . named = ", ".join(keys)
    . wanted = if desired != no-type then type-key(types, desired) else "*"
    . capability = if capture then "PatternCaptureMaterializer" else "PatternValueMaterializer"
    frame.diagnose(site, .stated, program.store-atom("Pattern helper has ambiguous $capability capabilities for input ${type-key(types, input)}, output $wanted: $named"), input, desired)
    frame.mention(chosen)
    = invalid-type
= if chosen.length != 0 then chosen[0] else no-type

────────────────────
_ takes-input Bool
    - candidate TypeId
    - input TypeId

|? unites(input) && input != accepted
    false
??
    relation-legal(taken) && taken.rank < down-cast-rank()

.. accepted = first-type-arg(types, candidate)
.. taken = relations.compare(input, accepted)

────────────────────
_ do unites Bool
    - type TypeId

` Whether a type is a union as the reference holds one: one written of its cases, or one a
` module declares.
do match? types.rows[type]
    | .type-union
        = true
    | .type-named-union
        = true
    | .type-class
        = types.intrinsic-of(type) == .union
= false

────────────────────
_ down-cast-rank RelationRank

relation-rank(.relation-down-cast)

────────────────────
_ second-type-arg TypeId
    - type TypeId

match types.rows[type]
    | .type-class(row)
        if row.args.count > 1 then types.child-type(row.args, 1) else no-type
    ??
        no-type

────────────────────
_ do capability-receiver TypeId
    - participant TypeId
    - interface TypeId

` The type of what answers a capability interface for a helper, a materializer, a collector
` storage or a record boundary: the helper, or what the property it delegates that interface to
` holds, its initializer typed where it declares no type, followed while that delegates it again.
` None where such a property has no type.
. current = participant
. visited [TypeId]
while visited.find(current) == null
    visited += current
    . pairs = types.delegates-of(current)
    . delegated = false
    . next = no-type
    for offset in 0 .. < pairs.length / 2
        if pairs[offset * 2] == interface && !delegated
            delegated = true
            next = calls.ranking.delegate-type(current, offset)
    if !delegated
        = current
    if next == no-type || next == invalid-type
        = no-type
    current = next
= current

────────────────────
_ do record-material Bool
    - site SyntaxId
    - kind MaterialKind
    - slot SlotId
    - type TypeId
    - interface TypeId
    - input TypeId

` Records the call of a materializer that makes a value at a place, kept apart from the calls
` of its node: `materialize-capture` of the stream's buffer and two cursors, or
` `materialize-value` of the value, on what answers the interface for the helper, reached
` through the properties the helper delegates it to, which the call keeps.
. receiver = capability-receiver(helping.helper!.participant, interface)
. places [U32]
if receiver == no-type || (receiver != helping.helper!.participant && !calls.ranking.delegate-path(helping.helper!.participant, receiver, places))
    decline(site)
    = false
. made = ProtocolCall()
if kind == .material-text || kind == .material-capture || kind == .material-eager
    made = calls.protocol-call
        - receiver
        - program.store-atom("materialize-capture")
        - site
        - stream-view.buffer
        - false
        - types.index-type
        - types.index-type
        - false
else
    made = calls.protocol-call
        - receiver
        - program.store-atom("materialize-value")
        - site
        - input
        - false
        - no-type
        - no-type
        - false
if made.fact == no-fact || made.answer != second-type-arg(interface)
    decline(site)
    = false
if places.length != 0
    facts.calls[made.fact].through = facts.keep-steps(places, calls.step-getters(places))
facts.record-material
    - MaterialFact(instance, site, kind, slot, type, interface, made.fact)
note-helper-use(false)
= true

────────────────────
_ do note-helper-use
    - rolls Bool

` Notes that the pattern of a rule typed for a helper makes a value through it, or needs it to
` roll back, where the helper is the rule's and not that of a match in one of its actions.
if rule-helper-site == 0 || helping.site != rule-helper-site
    =
instances.rows[instance].uses-helper = true
if rolls
    instances.rows[instance].rolls-helper = true

────────────────────
_ do note-mark

` Notes that the body being typed holds a rollback mark, which its parts ask the helper for or
` are given by the rules they call: the calls of `mark` and `rewind` that body makes on the
` helper are recorded once, at the body. A rule's own pattern that holds one gives it to the
` pattern calling it.
if helping.body == 0 || helping.helper == null || helping.helper.rollback == no-type
    =
if facts.rollback-body-of(instance, helping.body) == U32.max
    . participant = helping.helper!.participant
    . held = first-type-arg(types, helping.helper!.rollback)
    . made = calls.protocol-call
        - participant
        - program.store-atom("mark")
        - helping.body
        - no-type
        - false
        - no-type
        - no-type
        - false
    . mark-call = made.fact
    . rewinding = calls.protocol-call
        - participant
        - program.store-atom("rewind")
        - helping.body
        - held
        - false
        - no-type
        - no-type
        - false
    . rewind-call = rewinding.fact
    if made.answer != held || mark-call == no-fact || rewind-call == no-fact
        decline(helping.body)
        =
    . kept = if is-integer-kind(types.intrinsic-of(held)) then held else types.optional-of(held)
    facts.add-rollback-body(RollbackBody(instance, helping.body, mark-call, rewind-call, held, kept))
if rule-helper-site != 0 && helping.site == rule-helper-site && helping.body == rule-helper-site
    instances.rows[instance].carries-mark = true

────────────────────
_ do note-observer

` Notes that the body being typed runs under a helper that observes the literal words it
` matches: the calls of `record-pattern-literal` and `rewind-pattern-literals` that body makes
` on the helper are recorded once, at the body.
if helping.body == 0 || helping.helper == null || helping.helper.observer == no-type
    =
if facts.observer-body-of(instance, helping.body) != U32.max
    =
. participant = helping.helper!.participant
. recording = calls.protocol-call
    - participant
    - program.store-atom("record-pattern-literal")
    - helping.body
    - types.index-type
    - false
    - types.index-type
    - no-type
    - false
. record = recording.fact
. rewinding = calls.protocol-call
    - participant
    - program.store-atom("rewind-pattern-literals")
    - helping.body
    - types.index-type
    - false
    - no-type
    - no-type
    - false
. rewind = rewinding.fact
if record == no-fact || rewind == no-fact
    decline(helping.body)
    =
facts.add-observer-body(ObserverBody(instance, helping.body, record, rewind))

────────────────────
_ do note-observed
    - pattern SyntaxId

` Notes that a pattern typed under a helper that observes literal words runs under it, as the
` reference runs one that `observes-literals` says does, which needs the helper to roll back.
if unobserved || !observes-literals(tree, facts, instance, pattern)
    =
.. unobserved = helping.helper == null || helping.helper.observer == no-type
helping = helping.rolls = true
note-helper-use(true)

────────────────────
_ do holds-rollback Bool
    - pattern SyntaxId

` Whether a pattern has a part marked to roll back.
for node in tree.subtree-start(pattern) .. < pattern + 1
    do match? tree.nodes[node]
        | .node-stream-transform(row)
            if row.rollback
                = true
= false

────────────────────
_ do reads-length-only Bool
    - slot SlotId
    - body SyntaxId
    - optional Bool = false

` Whether an action reads a name only for its `length`, a number the span it captured has too,
` as the reference keeps such a name as the span it captured; an `optional` name, only through
` `?.`.
. receivers [SyntaxId]
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-get-expression(row)
            if length-read && row.is-optional == optional && !row.is-tracked && !row.is-loop
                receivers += row.object
            .. length-read = row.name == types.length-atom!
. found = false
for node in tree.subtree-start(body) .. < body + 1
    if tree.nodes[node] is .node-identifier && capture-slot(node) == slot
        if receivers.find(node) == null
            = false
        found = true
= found

────────────────────
_ do type-location Bool
    - arm SyntaxId
    - spans Bool
    - body SyntaxId

` Types the `location` an arm of a stream pattern declares where its expression reads it: a
` `MatchLocation` where the arm has a pattern, and else a `TokenLocation`. The call that
` answers where in the input a cursor lies, the stream's `pattern-location-at`, is recorded at
` the arm, after any other, as the reference makes it there before the expression runs. Only
` the stream a match makes, and the one a rule a module declares is given, are known here.
. slot = arm-slot(arm, .slot-location)
if slot == no-slot || !reads-slot(body, slot)
    = true
. type = if spans then types.match-location-type else types.token-location-type
if stream-view.type == no-type || type == invalid-type
    = false
if calls.protocol-call(stream-view.type, program.store-atom("pattern-location-at"), arm, types.index-type).answer != types.token-location-type
    = false
frame.assign(slot, type)
= true

────────────────────
_ do reads-slot Bool
    - body SyntaxId
    - slot SlotId

` Whether an expression, or a function written in it, reads a slot.
for node in tree.subtree-start(body) .. < body + 1
    do match? tree.nodes[node]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot && resolution.slot == slot
                = true
= false

────────────────────
_ do is-quiet Bool
    - id SyntaxId

` Whether an expression cannot panic: a local or a constant named, a literal, a case of an
` anonymous union or a tuple made of them, texts joined or compared, a text printed, and
` blocks of them.
do match? tree.nodes[id]
    | .node-block(row)
        = all-quiet(row.body)
    | .node-do-block(row)
        = is-quiet(row.body)
    | .node-print(row)
        = facts.node-type(instance, row.body) == types.string-type && is-quiet(row.body)
    | .node-binary-expression(row)
        . texts = text-left && facts.node-type(instance, row.rhs) == types.string-type
            .. text-left = facts.node-type(instance, row.lhs) == types.string-type
        . joins = concatenates || row.op == .equals-op || row.op == .not-equals-op
            .. concatenates = row.op == .concat-op || row.op == .concat-string-op
        = texts && joins && is-quiet(row.lhs) && is-quiet(row.rhs)
    | .node-identifier(row)
        if row.name == types.true-atom || row.name == types.false-atom
            = true
        . slot = capture-slot(id)
        = slot != no-slot && bindings.slots[slot].kind != .slot-lazy
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-anonymous-case(row)
        = all-quiet(row.args)
    | .node-tuple-syntax(row)
        = all-quiet(row.items)
    | .node-argument(row)
        = is-quiet(row.expr)
= false

────────────────────
_ do all-quiet Bool
    - args RowRange'SyntaxId

for arg in tree.children[args]
    if !is-quiet(arg)
        = false
= true

────────────────────
_ do check-stream-panic
    - id SyntaxId
    - pattern SyntaxId

` An arm that raises what it gives where no arm before it passed: a panic, or an error that
` leaves the function. Its value is evaluated as an assertion's exception is, and reads as
` `location` where the pattern failed farthest. One with a pattern of its own, or that gives
` any other value, has no shape here.
. exception SyntaxId = 0
do match? tree.nodes[pattern]
    | .node-stream-transform(row)
        if row.pattern == 0
            exception = row.right
if exception == 0 || mentions(exception, "it")
    decline(id)
    =
if !type-location(pattern, false, exception)
    decline(id)
    =
. saved = frame.surround
frame.surround = frame.surround.effects = exceptional-effects(saved.effects)
. raised = infer(exception)
frame.surround = saved
if raised == invalid-type || raised == no-type
    =
if is-subtype(types, raised, types.panic-type)
    instances.mark-may-panic(instance)
    =
if is-subtype(types, raised, types.error-type)
    note-outgoing(raised, id)
    facts.set-plan(instance, id, .plan-raise)
    =
decline(id)

────────────────────
_ do stream-node-type TypeId
    - id SyntaxId

` The type the reference declares for a part of a stream pattern that runs nothing: the text
` it matched for a literal, a range of characters or any one, and for a repeat or a count of
` a part; for a call of a rule, what the rule gives. Over integer items, a range of characters
` gives the item it matched and a literal, where nothing reads it, none; each tests items
` against code points they hold, and other text is an error, as is any text over items of
` another type. A sequence has the type of its last part
` and a lookahead that of its operand; an optional part is optional, and alternatives join.
` An optional part whose operand gives an optional is one of that optional, as the reference
` types it, only where nothing reads its value. A repeat or a count of a part gives its text only where the reference reckons the part
` gives the text it matched; a repeat of a part that gives a value, neither text nor optional,
` gives an `ImmutableArray` of the values, kept by a `PatternCollector` whose growing call is
` recorded at the repeat, and so does a count of such a part, or of a `.`, over items that are
` no characters. A count of another part that gives its text is text over any items, as the reference
` types it, though over items that are no characters what it gives is empty, so nothing may
` read it there. Alternatives that call rules are valued by their text only where each rule
` gives its text; where each gives a value of one type that is not optional, they give the
` value of the one that passed, and are planned so, as are alternatives that each test an item
` against a value of one type. Nothing reads what the alternatives of a part that gives the
` text it matched give, as the reference replaces it with that text. A repeat or a count whose value nothing
` reads, of a part that gives neither its text nor a value, gives none, as the reference makes
` none, and so do alternatives whose value nothing reads. Another count of a part that gives a
` value, other alternatives that call rules, and any other part have no shape here.
do match? tree.nodes[id]
    | .node-stream-string(row)
        if text-items()
            = types.string-type
        if valuing.unvalued && is-integer(stream-view.item)
            if some(row.text.codepoints) • where !item-holds(each as U64)
                = report-unheld(id)
            = no-type
        if stream-view.item != no-type && !is-integer(stream-view.item)
            frame.diagnose(id, .stated, program.store-atom("Text in a pattern can only match character or integer items"))
            = invalid-type
    | .node-stream-any
        = if text-items() then types.string-type else stream-view.item
    | .node-stream-char-range(row)
        if char-bound(row.first) && char-bound(row.last)
            if text-items()
                = types.string-type
            if is-integer(stream-view.item)
                if !item-holds(bound(row.first)) || !item-holds(bound(row.last))
                    = report-unheld(id)
                = stream-view.item
    | .node-stream-predicate(row)
        = predicate-type(id, row.predicate)
    | .node-stream-equality(row)
        = equality-type(id, row.value)
    | .node-stream-and(row)
        . saved = valuing
        valuing = valuing.unvalued = true
        . left = stream-node-type(row.left)
        valuing = saved
        . right = stream-node-type(row.right)
        = if left == invalid-type then invalid-type else right
    | .node-stream-or(row)
        . saved = valuing
        if returns-span(instance, id)
            valuing = valuing.unvalued = true
        . left = stream-node-type(row.left)
        . right = stream-node-type(row.right)
        valuing = saved
        . items = tests-item(id)
        if (items || stream-valued(row.left) || stream-valued(row.right)) && unspanned
            if valuing.unvalued && left != invalid-type && right != invalid-type
                = no-type
            left = valued-alternatives(row.left, left)
            right = valued-alternatives(row.right, right)
            if left != right || left-unfit || !stream-valued(row.left) || !stream-valued(row.right)
                if left != right && typed(left) && typed(right)
                    . shown = "${type-short-name(types, left)} and ${type-short-name(types, right)}"
                    frame.diagnose(id, .stated, program.store-atom("Alternatives give $shown; give each a value of one type"))
                else
                    decline(id)
                = invalid-type
            .. left-unfit = left == invalid-type || left == no-type || types.is-optional(left)
            .. typed = :: type => type != invalid-type && type != no-type
            facts.set-plan(instance, id, .plan-stream-value)
            facts.set-node-type(instance, id, left)
            = left
        .. unspanned = items || !returns-span(instance, id)
        = join-stream-types(id, left, right)
    | .node-stream-unary(row)
        . operand = stream-node-type(row.operand)
        if operand == invalid-type || operand == no-type
            = operand
        if row.op == .zero-or-one-op
            . optional = types.optional-of(operand)
            if stream-valued(row.operand)
                if types.is-optional(operand)
                    if !valuing.unvalued
                        decline(id)
                        = invalid-type
                    optional = types.optional-around(operand)
                facts.set-node-type(instance, id, optional)
            = optional
        if row.op == .zero-or-more-op || row.op == .one-or-more-op
            if !text-items() && !stream-valued(row.operand)
                if returns-span(instance, row.operand)
                    = class-over(types.immutable-array-decl, stream-view.item)
                decline(id)
                = invalid-type
            if text-items() && returns-span(instance, row.operand)
                = types.string-type
            = repeated-values(id, row.operand, operand)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = operand
    | .node-stream-capture(row)
        . saved = valuing
        valuing = valuing.unvalued = false
        . captured = stream-node-type(row.pattern)
        valuing = saved
        = captured
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = stream-node-type(row.pattern)
    | .node-stream-call
        = stream-call-type(id)
    | .node-stream-type(row)
        = type-node-type(id, row.type)
    | .node-stream-length(row)
        if !counts(row.min, row.max == 0) || (row.max != 0 && !counts(row.max, true))
            decline(id)
            = invalid-type
        . counted = stream-node-type(row.operand)
        if counted == invalid-type
            = invalid-type
        if stream-valued(id)
            = repeated-values(id, row.operand, counted)
        if !returns-span(instance, row.operand)
            if valuing.unvalued
                = no-type
            decline(id)
            = invalid-type
        = types.string-type
decline(id)
= invalid-type

────────────────────
_ do class-error-site SyntaxId
    - pattern SyntaxId

` Where the reference reports a range of characters in a pattern over items that are neither
` characters nor integers, which it cannot test: at the first it meets as it emits the arms in
` turn. Where the pattern has more than one arm and one of them may start with anything, the
` reference first tests the item an arm starts with where the arm must start with one of
` certain characters, and reports that test at the arm. None where no range is met; `U32.max`
` where the pattern is shaped so that where the reference meets one first is not known here.
. arms [SyntaxId]
stream-arms(pattern, arms)
. ranged = false
for arm in arms
    ranged = ranged || range-site(arm) != 0
if !ranged
    = 0
. guarded = false
if arms.length > 1
    . open = false
    for arm in arms
        . first = first-items(arm)
        if first == .first-unsure
            = U32.max
        open = open || first == .first-open
        guarded = guarded || first == .first-ranges
    if guarded && !open
        = U32.max
for arm in arms
    if guarded && first-items(arm) == .first-ranges
        = arm
    . site = range-site(arm)
    if site != 0
        = site
= 0

────────────────────
_ do valued-alternatives TypeId
    - id SyntaxId
    - type TypeId

` What a side of alternatives that give the value of the one that passed gives: alternatives
` nested there that gave none, typed as part of alternatives that give the text they matched,
` typed again now that their value is read.
=? type if type != no-type || !(tree.nodes[id] is .node-stream-or)
= stream-node-type(id)

────────────────────
_ do stream-arms
    - id SyntaxId
    - arms [SyntaxId]

` The arms of a stream pattern, in the order written.
do match? tree.nodes[id]
    | .node-stream-or(row)
        stream-arms(row.left, arms)
        stream-arms(row.right, arms)
        =
arms += id

────────────────────
_ do first-items FirstItems
    - id SyntaxId

do match? tree.nodes[id]
    | .node-stream-transform(row)
        = if row.pattern != 0 then first-items(row.pattern) else .first-open
    | .node-stream-panic(row)
        = first-items(row.pattern)
    | .node-stream-capture(row)
        = first-items(row.pattern)
    | .node-stream-and(row)
        . left = first-items(row.left)
        = if left == .first-open then first-items(row.right) else left
    | .node-stream-any
        = .first-any
    | .node-stream-char-range
        = .first-ranges
    | .node-stream-predicate
        = .first-open
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op || row.op == .zero-or-more-op || lookahead
            = .first-open
        .. lookahead = row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
        if row.op == .one-or-more-op
            = first-items(row.operand)
= .first-unsure

────────────────────
_ do range-site SyntaxId
    - id SyntaxId

` Where the reference reports the first range of characters it meets in a part of a pattern
` over items that cannot be tested so: at the range, or at a repeat it scans for. None where
` the part has none, and `U32.max` where one lies where the reference meets it otherwise.
do match? tree.nodes[id]
    | .node-stream-transform(row)
        = if row.pattern != 0 then range-site(row.pattern) else 0
    | .node-stream-panic(row)
        = range-site(row.pattern)
    | .node-stream-capture(row)
        = range-site(row.pattern)
    | .node-stream-and(row)
        . left = range-site(row.left)
        = if left == 0 then range-site(row.right) else left
    | .node-stream-char-range
        = id
    | .node-stream-unary(row)
        . inner = range-site(row.operand)
        if inner != 0 && inner == row.operand && repeats
            = id
        .. repeats = row.op == .zero-or-more-op || row.op == .one-or-more-op
        = inner
    | .node-stream-length(row)
        = range-site(row.operand)
    | .node-stream-or(row)
        if range-site(row.left) != 0 || range-site(row.right) != 0
            = U32.max
= 0

────────────────────
_ text-items Bool

` Whether the stream a pattern reads holds characters, whose parts give the text they matched.
stream-view.item == types.type-row(.char)

────────────────────
_ encoded Bool

` Whether the buffer of the stream a pattern reads holds the UTF-8 bytes of the characters the
` stream gives, as a `TextTokenStream`'s text view does, rather than the characters.
stream-view.buffer != no-type && class-arg(types, stream-view.buffer, 0) != stream-view.item

────────────────────
_ do view-name Atom
    - encoded Bool

` The getter of a stream's view of its buffer: `pattern-text-view` where the buffer holds the
` UTF-8 bytes of its characters, and else `pattern-view`.
= program.store-atom(if encoded then "pattern-text-view" else "pattern-view")

────────────────────
_ do pattern-argument-type TypeId
    - arg SyntaxId

` A pattern given to a rule as an argument, `~ p`, which the reference passes as a function
` the rule calls with the stream: one that is a call of a rule a module declares written
` alone passes the function made of that rule, and any other a function made of the pattern
` where it is written. It is typed over the items of the stream the call reads, as a rule's
` arms are, read as the `TokenStream` of those items the function is given, as a
` `PatternFunc` of those items and what it gives, which asks the stream for more input through
` the calls `record-growth` keeps. One that captures a name is an error, as nothing can read
` it; one that runs an action has no shape here, nor one that reads a name or calls a local
` rule but as `plain-argument` says, which keeps the names its function is given. Under a helper it is typed for the
` helper as a pattern of its own, which holds a rollback mark where the helper can roll back,
` and needs the helper to roll back where its parts do.
. known = facts.node-type(instance, arg)
if known != no-type
    = known
. pattern SyntaxId = 0
do match? tree.nodes[arg]
    | .node-stream-match(row)
        pattern = row.pattern
. reads [SlotId]
. read-types [TypeId]
if pattern == 0 || stream-view.item == no-type
    decline(arg)
    = invalid-type
. capture = first-capture(pattern)
if capture != 0
    frame.diagnose(capture, .stated, program.store-atom("A pattern given as an argument can't capture names"))
    = invalid-type
if !plain-argument(pattern, reads, read-types)
    decline(arg)
    = invalid-type
. given = class-over(types.token-stream-decl, stream-view.item)
if !record-growth(given, arg, encoded())
    decline(arg)
    = invalid-type
. outer = stream-view
. texts = rule-arming
. rolls = helping
stream-view = stream-view.type = given
rule-arming = rule-arming.texts = false
rule-arming = rule-arming.capture-root = pattern
rule-arming = rule-arming.target = no-type
rule-arming = rule-arming.rule = true
rule-arming = rule-arming.span = false
helping = helping.rolls = false
rule-arming = rule-arming.casting = 0
helping = helping.explicit = false
helping = helping.body = arg
do match? tree.nodes[pattern]
    | .node-stream-call(call)
        if call.params.count == 0 && call.args.count == 0 && rule-of(pattern) == 0
            rule-arming = rule-arming.casting = pattern
. joined = stream-arm-type(pattern)
note-observed(pattern)
. rolled = helping.rolls
if helping.helper != null
    note-mark()
stream-view = outer
rule-arming = texts
helping = rolls
if rolled
    helping = helping.rolls = true
    note-helper-use(true)
if joined == invalid-type
    = invalid-type
. result = if joined == no-type then types.string-type else joined
convert-stream-arms(pattern, result)
facts.set-node-type(instance, pattern, result)
. rule = no-instance
do match? tree.nodes[pattern]
    | .node-stream-call(row)
        if row.params.count == 0 && row.args.count == 0
            . fact = facts.first-call(instance, pattern)
            rule = if fact != no-fact then facts.calls[fact].callee else no-instance
if stream-view.buffer == no-type
    decline(arg)
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(stream-view.item)
scratch.types.push(result)
. type = types.class-with-args(types.pattern-func-decl.module, types.pattern-func-decl.decl, mark)
. answer = types.optional-of(result)
. helper = if helping.helper != null then helping.helper.participant else no-type
. start U32 = facts.action-slots.length as U32
if rule == no-instance
    for position in 0 .. < reads.length
        facts.action-slots.append(reads[position])
        facts.action-types.append(read-types[position])
. count U32 = (facts.action-slots.length - start) as U32
. local SyntaxId = 0
do match? tree.nodes[pattern]
    | .node-stream-call(row)
        if rule == no-instance && row.params.count == 0 && row.args.count == 0
            local = rule-of(pattern)
facts.pattern-arguments.append
    - PatternArgument
        - instance
        - arg
        - result
        - answer
        - given
        - stream-view.buffer
        - rule
        - helper
        - RowRange'U32(start, count)
        - local
facts.set-node-type(instance, arg, type)
= type

────────────────────
_ do plain-argument Bool
    - pattern SyntaxId
    - reads [SlotId]
    - read-types [TypeId]
    - quiet Bool = false

` Whether a pattern given to a rule runs no action and reads no name but a global or one
` `reads-given` says the function made of it can be given, so that the function needs no more
` of the function it is written in. It calls a local rule given no values, the ways the
` reference compiles: written alone, a rule that is such a pattern itself and calls no rule,
` which the function then runs where it calls it, as the reference's function of the rule shows
` no frame where nothing it runs may panic, or a rule of a match in a function that is no rule
` that runs actions and captures names but calls no rule, panics in no arm and reads no name
` but a global, one it declares or one the function can be given; or anywhere in it, any rule
` `gives-arguments` says
` the function can run, as in a rule a module declares. The first is given the rule's arguments
` too wherever it can be, as the rule runs in a function of its own where a helper it makes its
` value through may panic. Keeps the names the function is given, each once, with its type.
` A name the binder resolved nothing for is one the parser left where it tried another way to
` read the text, and is no part of the pattern. One that is `quiet` declines nothing.
for node in tree.subtree-start(pattern) .. < pattern + 1
    . plain = true
    do match? tree.nodes[node]
        | .node-identifier
            . kind = bindings.resolution-of(frame.binding, node).kind
            plain = kind == .resolve-none || kind == .resolve-global || reads-given(node, reads, read-types)
        | .node-ref-identifier
            plain = false
        | .node-stream-transform(row)
            plain = row.right == 0
        | .node-stream-panic
            plain = false
        | .node-stream-call(row)
            . rule = rule-of(node)
            if rule != 0
                plain = row.params.count == 0 && row.args.count == 0
                if plain
                    . runs = node == pattern && (plain-rule(rule, reads, read-types) || acting-rule(rule, reads, read-types))
                    . given = gives-arguments(reads, read-types)
                    plain = runs || given
    if !plain
        if !quiet
            decline(node)
        = false
= true

────────────────────
_ do plain-rule Bool
    - rule SyntaxId
    - reads [SlotId]
    - read-types [TypeId]

` Whether a local rule a pattern given to a rule calls captures no name, runs no action, calls
` no rule and reads no name but one the function made of the pattern can be given. Keeps
` those names only where it is.
. pattern = local-rule-pattern(rule)
if pattern == 0
    = false
for node in tree.subtree-start(pattern) .. < pattern + 1
    if tree.nodes[node] is .node-stream-call
        = false
. held = reads.length
if captures-none(pattern, true) && plain-argument(pattern, reads, read-types, true)
    = true
while reads.length > held
    reads.pop()
    read-types.pop()
= false

────────────────────
_ do acting-rule Bool
    - rule SyntaxId
    - reads [SlotId]
    - read-types [TypeId]

. row = instances.rows[instance]
. pattern = local-rule-pattern(rule)
if pattern == 0 || rule-match(program, row.module, row.decl) != 0
    = false
. first = tree.subtree-start(rule)
. held = reads.length
for node in tree.subtree-start(pattern) .. < pattern + 1
    . plain = true
    do match? tree.nodes[node]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, node)
            . own = resolution.kind == .resolve-slot && from-first && within-rule
                .. from-first = bindings.slots[resolution.slot].syntax >= first
                .. within-rule = bindings.slots[resolution.slot].syntax <= rule
            plain = own || resolution.kind == .resolve-none || resolution.kind == .resolve-global || resolution.kind == .resolve-type || module-function(resolution) || reads-given(node, reads, read-types)
        | .node-ref-identifier
            plain = false
        | .node-function-syntax
            plain = false
        | .node-stream-panic
            plain = false
        | .node-stream-call
            plain = false
    if !plain
        while reads.length > held
            reads.pop()
            read-types.pop()
        = false
= true

────────────────────
_ do module-function Bool
    - resolution Resolution

if resolution.kind != .resolve-function
    = false
do match? program.modules[resolution.module].decls[resolution.decl]
    | .decl-function(fn)
        = fn.owner == 0
= false

────────────────────
_ do reads-given Bool
    - node SyntaxId
    - reads [SlotId]
    - read-types [TypeId]

` Whether a name a pattern given to a rule reads is one the function made of the pattern can
` be given where the pattern is passed: an argument of the function being typed, which
` nothing tracks, narrowed or captured from a function around it. The reference finds no
` local there. Keeps each once, with its type.
. resolution = bindings.resolution-of(frame.binding, node)
if resolution.kind != .resolve-slot || outer
    = false
. slot = resolution.slot
. row = bindings.slots[slot]
if row.kind != .slot-argument || tracked || frame.is-captured(slot)
    = false
.. tracked = (row.flags /and/ SlotFlag.slot-tracked) != 0
. type = frame.known(slot)
if type == no-type || type == invalid-type || frame.slot-type(slot) != type
    = false
if reads.find(slot) == null
    reads += slot
    read-types += type
= true

────────────────────
_ do gives-arguments Bool
    - reads [SlotId]
    - read-types [TypeId]

` Whether the function made of a pattern that calls a local rule can run the rule: in a rule a
` module declares, the function is given the arguments the rule was given, which it gives the
` function of the local rule, or reads where it runs the local rule itself. Keeps each once,
` with its type, and none where it cannot be given them all.
. row = instances.rows[instance]
if outer || rule-match(program, row.module, row.decl) == 0
    = false
for position in 1 .. < instances.signatures[instance].args.count
    . slot = argument-slot(position)
    if slot == no-slot || tracked || frame.is-captured(slot)
        = false
    .. tracked = (bindings.slots[slot].flags /and/ SlotFlag.slot-tracked) != 0
for position in 1 .. < instances.signatures[instance].args.count
    . slot = argument-slot(position)
    if reads.find(slot) == null
        reads += slot
        read-types += instances.argument-type(instance, position)
= true

────────────────────
_ do pattern-result TypeId
    - type TypeId

` What a pattern given to a rule gives, where a value is a `PatternFunc` of the stream's
` items; none otherwise.
do match? types.rows[type]
    | .type-class(row)
        if pattern-func && row.args.count == 2 && class-arg(types, type, 0) == stream-view.item
            = class-arg(types, type, 1)
        .. pattern-func = types.pattern-func-decl.refers-to(row.module, row.decl)
= no-type

────────────────────
_ names-given-pattern Bool
    - slot SlotId

` Whether a name is a pattern a rule a module declares is given, which the reference reads
` only as `$name` and `\name` call it, and reports as no name anywhere else: in an action, as
` an action it cannot compile.
bindings.slots[slot].kind == .slot-argument && rule-match(program, row.module, row.decl) != 0

.. row = instances.rows[instance]

────────────────────
_ do is-pattern-func Bool
    - type TypeId

` Whether a type is a `PatternFunc` of any items.
if type == no-type || type == invalid-type
    = false
do match? types.rows[type]
    | .type-class(row)
        = types.pattern-func-decl.refers-to(row.module, row.decl)
= false

────────────────────
_ do plan-pattern-call TypeId
    - id SyntaxId
    - called TypeId

` Plans a part of a stream pattern as a call of a pattern given to the rule, which gives what
` the pattern gives, and whose function answers the optional of it. What the function runs is
` not known, so the rule may panic. In a rule typed for a helper that can roll back, the
` function gives the rollback mark it holds, which the rule's pattern then holds.
facts.set-node-type(instance, id, called)
facts.set-plan(instance, id, .plan-pattern-call)
facts.set-answer-type(instance, id, types.optional-of(called))
instances.mark-may-panic(instance)
if instances.rows[instance].helper != no-type
    note-mark()
= called

────────────────────
_ do equality-type TypeId
    - id SyntaxId
    - value SyntaxId

` What `$value` matches as a pattern runs. A pattern given to the rule the part is in, a
` `PatternFunc` of the stream's items, is called as a rule is, and gives what it gives. Text
` over a stream of characters gives the text it matched: the value is evaluated where the
` part is tried, with the names captured before it in reach; its length is read checked, by
` its `validated-length`, and its characters in turn by its `next-iterator`, as the reference
` reads them, or where the buffer is `encoded`, its count of bytes by its `size`, which are
` compared with the buffer's. A value of a type like the items', as the reference compares
` them, is compared
` with one item, and gives the value. A value of any other type has no shape here.
. known = facts.node-type(instance, id)
if known != no-type
    = known
. type = infer(value, if tree.nodes[value] is .node-identifier then Want().adding(.want-pattern) else Want())
if type == invalid-type || type == no-type
    = invalid-type
. called = pattern-result(type)
if called != no-type
    = plan-pattern-call(id, called)
if type != types.string-type
    . relation = relations.compare(type, stream-view.item, false, false, null, module)
    if stream-view.item == no-type || !validate-relation(relation, .similar)
        decline(id)
        = invalid-type
    facts.set-node-type(instance, id, type)
    = type
if !text-items()
    decline(id)
    = invalid-type
if calls.protocol-getter(types.string-type, program.store-atom("validated-length"), id) != types.size-type
    decline(id)
    = invalid-type
if encoded()
    if calls.protocol-getter(types.string-type, program.store-atom("size"), id) != types.size-type
        decline(id)
        = invalid-type
else if calls.protocol-call(types.string-type, program.store-atom("next-iterator"), id, types.size-type).answer == invalid-type
    decline(id)
    = invalid-type
facts.set-node-type(instance, id, types.string-type)
= types.string-type

────────────────────
_ do predicate-type TypeId
    - id SyntaxId
    - predicate SyntaxId

` A test of one item of a stream, which gives the item where it passes, a character in a stream
` of them: its expression sees the item as `it`, and is tested as a condition.
. known = facts.node-type(instance, id)
if known != no-type
    = known
. slot = arm-slot(id, .slot-it)
if slot != no-slot
    frame.assign(slot, stream-view.item)
. tested = infer(predicate)
if tested == invalid-type || tested == no-type
    = invalid-type
note-truthiness(predicate, predicate, tested)
facts.set-node-type(instance, id, stream-view.item)
= stream-view.item

────────────────────
_ do repeated-values TypeId
    - id SyntaxId
    - operand SyntaxId
    - item TypeId

` A repeat of a part that gives a value: an `ImmutableArray` of what each pass gave, whose
` collector's growing call is recorded at the repeat, once. A part whose value is text gives
` the text a rule it ends with gave. A repeat whose value is not read, as a part of a sequence
` before its last is not, gives none and keeps no collector, as the reference makes none.
. known = facts.node-type(instance, id)
if known != no-type
    = known
if valuing.unvalued
    = no-type
. valued = if item == types.string-type && text-items() then ends-with-rule(operand) else (stream-valued(operand) || takes-item(operand))
. collector = if valued then collector-over(item) else invalid-type
if collector == invalid-type || calls.protocol-call(collector, program.store-atom("grow"), id).answer != grown-items(collector)
    decline(id)
    = invalid-type
if takes-item(operand)
    facts.set-node-type(instance, operand, item)
. list = class-over(types.immutable-array-decl, item)
facts.set-node-type(instance, id, list)
facts.set-plan(instance, id, .plan-stream-value)
= list

────────────────────
_ returns-span Bool
    - owner InstanceId
    - id SyntaxId

` Whether a part of a stream pattern of an instance gives the text it matched, as
` `spans-in` says.
spans-in(instances.rows[owner].module, instances.rows[owner].binding, owner, id)

────────────────────
_ do spans-in Bool
    - module ModuleId
    - binding BindingId
    - owner InstanceId
    - id SyntaxId

` Whether a part of a stream pattern a function of a module writes gives the text it matched,
` as the reference reckons it where it repeats or counts the part: a part that matches items,
` a count, an arm that runs nothing, and a name captured over, a repeat or lookahead of, or a
` sequence or alternatives of such parts. A call of a rule gives its text where the rule's
` pattern does, and a rule met again while it is asked of does. The instance that runs the
` pattern, where there is one, says what a test of a value matches, and a call of a pattern
` given to the rule does not give its text; where none, one does not give its text.
. source = program.modules[module].tree
. key = ((binding as U64) /lshift/ 32) /or/ (id as U64)
for held in spanning
    if held == key
        = true
spanning += key
. spans = false
do match? source.nodes[id]
    | .node-stream-transform(arm)
        spans = arm.right == 0 && arm.pattern != 0 && spans-in(module, binding, owner, arm.pattern)
    | .node-stream-capture(capture)
        spans = spans-in(module, binding, owner, capture.pattern)
    | .node-stream-and(pair)
        spans = spans-in(module, binding, owner, pair.left) && spans-in(module, binding, owner, pair.right)
    | .node-stream-or(pair)
        spans = spans-in(module, binding, owner, pair.left) && spans-in(module, binding, owner, pair.right)
    | .node-stream-unary(unary)
        spans = spans-in(module, binding, owner, unary.operand)
    | .node-stream-call
        spans = called-spans(module, binding, owner, id)
    | .node-stream-string
        spans = true
    | .node-stream-char-range
        spans = true
    | .node-stream-any
        spans = true
    | .node-stream-length
        spans = true
    | .node-stream-predicate
        spans = true
    | .node-stream-equality(test)
        spans = owner != no-instance && !calls-given-pattern(owner, binding, id, test.value)
spanning.pop()
= spans

────────────────────
_ calls-given-pattern Bool
    - owner InstanceId
    - binding BindingId
    - id SyntaxId
    - value SyntaxId

` Whether `$value` calls a pattern given to the rule rather than testing a value: as the type
` pass planned it, or, before it typed the part in the instance being typed, where the value
` is a name that holds a `PatternFunc` of the stream's items there.
|? facts.plan-of(owner, id) == .plan-pattern-call
    true
|? owner != instance || binding != frame.binding || !(tree.nodes[value] is .node-identifier)
    false
|? resolution.kind != .resolve-slot
    false
??
    type != no-type && pattern-result(type) != no-type

.. resolution = bindings.resolution-of(binding, value)
.. type = frame.slot-type(resolution.slot)

────────────────────
_ do called-spans Bool
    - module ModuleId
    - binding BindingId
    - owner InstanceId
    - call SyntaxId

` Whether a rule a pattern calls gives the text it matched: a local rule of the function, or
` the rule of the function its call was resolved to, or where the instance has not resolved
` it, the rule a module declares that the name binds. A call given collectors gives it.
. source = program.modules[module].tree
do match? source.nodes[call]
    | .node-stream-call(written)
        if written.collector-mappings.count != 0
            = true
if binding == no-binding
    = false
. resolution = bindings.resolution-of(binding, call)
if resolution.kind == .resolve-slot
    . slot = bindings.slots[resolution.slot]
    if slot.kind == .slot-lazy && slot.group != 0
        do match? source.nodes[slot.group]
            | .node-declare(declaration)
                do match? source.nodes[declaration.right]
                    | .node-stream-match(rule)
                        = spans-in(module, binding, owner, rule.pattern)
    = false
. fact = if owner != no-instance then facts.first-call(owner, call) else no-fact
if fact != no-fact && facts.calls[fact].callee != no-instance
    . callee = facts.calls[fact].callee
    . called = instances.rows[callee]
    . matched = rule-match(program, called.module, called.decl)
    do match? program.modules[called.module].tree.nodes[matched]
        | .node-stream-match(rule)
            = spans-in
                - called.module
                - session.binder.bind(called.module, called.decl)
                - callee
                - rule.pattern
    = false
if resolution.kind != .resolve-function
    = false
. matched = rule-match(program, resolution.module, resolution.decl)
do match? program.modules[resolution.module].tree.nodes[matched]
    | .node-stream-match(rule)
        = spans-in
            - resolution.module
            - session.binder.bind(resolution.module, resolution.decl)
            - no-instance
            - rule.pattern
= false

────────────────────
_ do stream-valued Bool
    - id SyntaxId

` Whether a part of a stream pattern gives what a rule it calls gives rather than the text it
` matched, as the reference's parts give their values: a call of a rule, a name captured over
` one, an optional one, a repeat of one that gives no text or that ends with one, and a
` sequence whose last part gives one that is no text, a test of an item, a type named, a call
` of a pattern given to the rule, a test of a value like the items', and a count of a part
` that gives a value, as a repeat of one does over characters; and alternatives
` `stream-node-type` planned to give the value of the one that passed. A call given collectors
` gives the text it matched, as does one that `span-call` says gives it.
do match? tree.nodes[id]
    | .node-stream-call(row)
        = row.collector-mappings.count == 0 && (!span-call(id) || spans-valued(id))
    | .node-stream-or
        = facts.plan-of(instance, id) == .plan-stream-value
    | .node-stream-capture(row)
        = stream-valued(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && stream-valued(row.pattern)
    | .node-stream-unary(row)
        if row.op == .zero-or-more-op || row.op == .one-or-more-op
            if !text-items()
                = stream-valued(row.operand)
            = repeat-unspanned && (stream-valued(row.operand) || ends-with-rule(row.operand))
                .. repeat-unspanned = !returns-span(instance, row.operand)
        = row.op == .zero-or-one-op && stream-valued(row.operand)
    | .node-stream-and(row)
        = stream-valued(row.right) && (stream-node-type(row.right) != types.string-type || !text-items())
    | .node-stream-predicate
        = true
    | .node-stream-type
        = true
    | .node-stream-equality
        = facts.plan-of(instance, id) == .plan-pattern-call || tests-item(id)
    | .node-stream-length(row)
        if !text-items()
            = stream-valued(row.operand) || takes-item(row.operand)
        = counted-unspanned && (stream-valued(row.operand) || ends-with-rule(row.operand))
            .. counted-unspanned = !returns-span(instance, row.operand)
= false

────────────────────
_ takes-item Bool
    - id SyntaxId

` Whether a part of a stream pattern is a `.` over items that are not characters, which gives
` the item it matched where a name captures it or a count takes it, as a name captured over a
` test of the item holds it.
!text-items() && tree.nodes[id] is .node-stream-any

────────────────────
_ do sequence-tests-item Bool
    - id SyntaxId

` Whether a part of a stream pattern is a sequence whose value is that of a part that tests
` an item against a value, as `tests-item` says.
do match? tree.nodes[id]
    | .node-stream-and(row)
        = ends-testing-item(row.right)
    | .node-stream-capture(row)
        = sequence-tests-item(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && sequence-tests-item(row.pattern)
= false

────────────────────
_ do ends-testing-item Bool
    - id SyntaxId

` Whether a part of a stream pattern ends with a part that tests an item against a value.
do match? tree.nodes[id]
    | .node-stream-and(row)
        = ends-testing-item(row.right)
    | .node-stream-capture(row)
        = ends-testing-item(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && ends-testing-item(row.pattern)
= tests-item(id)

────────────────────
_ do tests-item Bool
    - id SyntaxId

` Whether a part of a stream pattern tests one item against a value of a type like the
` items' that `equality-type` typed, or is alternatives that each do.
do match? tree.nodes[id]
    | .node-stream-equality
        . type = facts.node-type(instance, id)
        = unpatterned && type != no-type && type != invalid-type && type != types.string-type
            .. unpatterned = facts.plan-of(instance, id) != .plan-pattern-call
    | .node-stream-or(row)
        = tests-item(row.left) && tests-item(row.right)
= false

────────────────────
_ do ends-with-rule Bool
    - id SyntaxId

` Whether a part of a stream pattern ends with a call of a rule, whose value is what the part
` gives on each pass of a repeat around it: a call, a type named, or a sequence that ends with
` one or with a name captured over one. A call given collectors gives no value of its own,
` nor does one that `span-call` says gives its text.
do match? tree.nodes[id]
    | .node-stream-call(row)
        = row.collector-mappings.count == 0 && (!span-call(id) || spans-valued(id))
    | .node-stream-capture(row)
        = ends-with-rule(row.pattern)
    | .node-stream-type
        = true
    | .node-stream-equality
        = facts.plan-of(instance, id) == .plan-pattern-call
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && ends-with-rule(row.pattern)
    | .node-stream-and(row)
        = ends-with-rule(row.right)
= false

────────────────────
_ span-call Bool
    - id SyntaxId

` Whether a call of a rule under a helper gives the text it matched rather than what the rule
` gives, as the reference calls a rule whose pattern gives its text for the span it matched,
` which the pattern calling it makes through the helper only where it needs it; so does such
` a call in a rule called so. Over items that are not characters, such a call has no shape. A
` call written alone as a pattern given to a rule passes the rule's function, which makes its
` text itself. A call of a local rule whose value its arm gives runs the rule for its value
` where the rule states a type other than text that no capture materializer of the helper
` makes, as the reference compiles such a call for the type the rule states.
(helped && id != rule-arming.casting && returns-span(instance, id) && !rule-valued(id)) || span-planned

.. helped = helping.helper != null || helping.span-typing
.. span-planned = facts.plan-of(instance, id) == .plan-span-call

────────────────────
_ do rule-valued Bool
    - id SyntaxId

if helping.helper == null || helping.span-typing
    = false
. rule = rule-of(id)
if rule == 0
    = false
. stated = local-rule-declared(rule)
if unstated || peeled-optional(stated) == types.string-type || !value-position(id)
    = false
.. unstated = stated == no-type || stated == invalid-type
for candidate in source-candidates(stated)
    if takes-input(candidate, stream-view.item)
        = false
= true

────────────────────
_ bare-span Bool
    - id SyntaxId
    - rule SyntaxId

|? helping.helper != null || helping.span-typing || id == rule-arming.casting || facts.is-recursive-rule(instance, rule)
    false
|? (stated != no-type && stated != types.string-type) || !returns-span(instance, id)
    false
??
    bare-arm(id)

.. stated = local-rule-declared(rule)

────────────────────
_ module-span Bool
    - id SyntaxId

` Whether a call of a rule a module declares that gives text, with no helper in force, gives
` the text it matched rather than what the rule makes, as the reference calls such a rule for
` its span where the value it makes is not wanted: one whose value nothing reads, and one
` captured alone in an arm whose action does not read `it`.
|? helping.helper != null || helping.span-typing || id == rule-arming.casting || !returns-span(instance, id)
    false
??
    valuing.unvalued || bare-arm(id)

────────────────────
_ do bare-arm Bool
    - id SyntaxId

` Whether a call is the pattern of an arm whose action does not read `it`, or a name captured
` over it alone, or over it as an optional part, in the sequence of such an arm.
. arms [SyntaxId]
stream-arms(rule-arming.capture-root, arms)
for arm in arms
    if tree.subtree-start(arm) <= id && id <= arm
        do match? tree.nodes[arm]
            | .node-stream-transform(row)
                = row.pattern != 0 && !tree.lazies-only(row.right) && it-unread && own-part
                    .. it-unread = !mentions(row.right, "it")
                    .. own-part = row.pattern == id || bare-part(row.pattern, id)
        = false
= false

────────────────────
_ do bare-part Bool
    - node SyntaxId
    - id SyntaxId

do match? tree.nodes[node]
    | .node-stream-capture(row)
        = (row.pattern == id || optional-operand(row.pattern) == id) && !row.accumulating
    | .node-stream-and(row)
        = bare-part(row.left, id) || bare-part(row.right, id)
= false

────────────────────
_ do stream-call-type TypeId
    - id SyntaxId

` A call of a rule: the type of what the rule gives. A local rule given no arguments is typed
` where it is first called. A rule a module declares is called as its function is, and a
` pattern a name holds as `$name` calls it; a local rule given arguments or types is an
` error. A rule given collectors is typed as `mapped-call-type` says, where it can take
` them, and is TypeScript's error where not; under a helper that makes text, one whose text is
` read has no shape here. Under a helper, a local rule the match runs where it is called and a
` rule a module declares have a shape here, and no other; one whose pattern gives its text is
` typed as `span-call-type` says. A local rule a function of its own
` runs has a shape only under its rule's own helper, the one the rule is typed for or given as
` an argument. A local rule whose body is code is typed as `coded-rule-type` says, given
` nothing. With no helper, a call of a
` rule that gives text gives the text it matched where `bare-span` or `module-span` says.
. known = facts.node-type(instance, id)
if known != no-type
    = known
. result = invalid-type
do match? tree.nodes[id]
    | .node-stream-call(row)
        . plain = row.params.count == 0 && row.args.count == 0
        . rule = rule-of(id)
        . coded = coded-rule(id)
        if coded != 0
            if !plain || row.collector-mappings.count != 0
                decline(id)
            else
                result = coded-rule-type(id, coded)
        else if helping.helper != null && rule == 0 && holds-value(id)
            if row.collector-mappings.count != 0
                decline(id)
            else
                result = held-pattern-type(id, row.name, plain)
        else if row.collector-mappings.count != 0 && helping.helper != null && !helping.span-typing
            if !plain || (!valuing.unvalued && helping.helper.captures.length != 0)
                decline(id)
            else
                result = mapped-call-type(id, rule, row.name, row.collector-mappings)
        else if span-call(id)
            result = span-call-type(id, rule, row.name, row.params, row.args)
        else if row.collector-mappings.count != 0
            if !plain || (rule == 0 && holds-value(id))
                decline(id)
            else
                result = mapped-call-type(id, rule, row.name, row.collector-mappings)
        else if rule != 0 && !plain
            frame.diagnose(id, .stated, program.store-atom("A local rule takes no arguments or types; declare it at module level to give it some"))
        else if rule != 0
            . recurs = !beside-rule && rules.find(rule) != null
            if !beside-rule && rules.length != 0
                facts.note-rule-call(instance, rules[rules.length - 1], rule)
            result = rule-type(rule)
            if recurs && result != invalid-type && !record-recursion(id, rule, result)
                result = invalid-type
            if helping.helper != null && facts.is-recursive-rule(instance, rule) && !own-helper
                decline(id)
                result = invalid-type
            else if result == types.string-type && rules.find(rule) == null && bare-span(id, rule)
                facts.set-plan(instance, id, .plan-span-call)
        else if holds-value(id)
            result = held-pattern-type(id, row.name, plain)
        else
            result = module-rule-type(id, row.name, row.params, row.args)
            if result == types.string-type && plain && module-span(id)
                facts.set-plan(instance, id, .plan-span-call)
if result == invalid-type
    = invalid-type
facts.set-node-type(instance, id, result)
= result

────────────────────
_ spans-valued Bool
    - id SyntaxId

` Whether a call `span-call` says gives its text gives a value of another type, which its arm
` gives, made from that text.
known != no-type && known != invalid-type && known != types.string-type && value-position(id)

.. known = facts.node-type(instance, id)

────────────────────
_ do span-call-type TypeId
    - id SyntaxId
    - rule SyntaxId
    - name Atom
    - params RowRange'SyntaxId
    - args RowRange'SyntaxId

` A call of a rule under a helper that gives the text it matched, as the reference compiles
` one: the rule is typed with no helper, a local rule as giving its text whatever type it
` states, and the call has the type the rule states. A call of one that states text, or none,
` gives the text, as a part matching characters does. Where the rule states another type, a
` call whose value its arm gives is made that type from its text, by `record-source-text`,
` or for an optional type what it holds, which the call then gives as the optional; any other
` gives none. Within a rule called so, every such call gives its text. A local rule given
` arguments or types, a pattern given as an argument, a rule a module declares that gives
` another type than text, and items that are not characters have no shape here. Under a helper
` that observes literal words, the rule is typed under the helper, which makes nothing for it,
` so a call within it still gives its text.
if !text-items() || (rule != 0 && (params.count != 0 || args.count != 0))
    decline(id)
    = invalid-type
for arg in tree.children[args]
    . given = arg
    do match? tree.nodes[arg]
        | .node-argument(argument)
            given = argument.expr
    if tree.nodes[given] is .node-stream-match
        decline(given)
        = invalid-type
. saved-helper = helping
if helping.helper != null && helping.helper.observer != no-type
    helping = helping.helper = spanning-helper(helping.helper)
else
    helping = helping.helper = null
    helping = helping.site = 0
helping = helping.span-typing = true
. called = if rule != 0 then rule-type(rule) else module-rule-type(id, name, params, args)
. carried-rolls = helping.rolls
helping = saved-helper
helping = helping.rolls = carried-rolls
if called == invalid-type
    = invalid-type
if called != types.string-type
    decline(id)
    = invalid-type
facts.set-plan(instance, id, .plan-span-call)
. stated = if helped-rule then local-rule-declared(rule) else no-type
    .. helped-rule = rule != 0 && helping.helper != null && !helping.span-typing
if stated == invalid-type
    decline(id)
    = invalid-type
if stated == no-type || stated == types.string-type
    = types.string-type
if !value-position(id)
    = stated
. made = record-source-text(id, stated)
if made == invalid-type || made == stated
    = made
if types.is-optional(stated) && types.optional-inner(stated) == made
    = stated
decline(id)
= invalid-type

────────────────────
_ do local-rule-declared TypeId
    - rule SyntaxId

` The type a local rule's declaration states, or none.
do match? tree.nodes[rule]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.left]
            | .node-type-capture(row)
                if row.type != 0
                    = types.evaluate-type(module, tree, row.type, frame.env)
= no-type

────────────────────
_ do value-position Bool
    - id SyntaxId

` Whether the value of a part of the stream pattern being typed is what its arm gives, as the
` reference requires it of the part: the arm's pattern, the last part of a sequence that is,
` and the pattern of an action that reads it as `it`.
. arms [SyntaxId]
stream-arms(rule-arming.capture-root, arms)
for arm in arms
    if tree.subtree-start(arm) <= id && id <= arm
        = value-site(arm, id)
= false

────────────────────
_ do value-site Bool
    - node SyntaxId
    - id SyntaxId

if node == id
    = true
do match? tree.nodes[node]
    | .node-stream-transform(row)
        if row.pattern == 0 || (!tree.lazies-only(row.right) && !mentions(row.right, "it"))
            = false
        = value-site(row.pattern, id)
    | .node-stream-and(row)
        = tree.subtree-start(row.right) <= id && id <= row.right && value-site(row.right, id)
= false

────────────────────
_ do mapped Bool
    - mappings RowRange'SyntaxId
    - name Atom
    - source AST
    - target SyntaxId

` Whether the collectors a call maps are ones the rule it calls and the pattern calling it
` accumulate, as the reference checks them where it compiles the call: no name of the rule's
` is mapped twice and no name of the caller's receives twice, each name of the rule's is one
` its own pattern accumulates, and each of the caller's one the pattern calling it does. Each
` name of the rule's is the caller's where none is written. TypeScript's error where not.
. callees [String]
. callers [String]
. sites [SyntaxId]
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            . callee = if row.callee then row.callee.text else row.caller.text
            if callees.find(callee) != null
                frame.diagnose
                    - mapping
                    - .stated
                    - program.store-atom
                        - "Accumulating capture $callee cannot be mapped more than once"
                = false
            if callers.find(row.caller.text) != null
                frame.diagnose
                    - mapping
                    - .stated
                    - program.store-atom
                        - "Collector ${row.caller.text} cannot receive multiple mapped accumulators"
                = false
            callees += callee
            callers += row.caller.text
            sites += mapping
for position in 0 .. < sites.length
    if !accumulates-in(source, target, callees[position])
        frame.diagnose
            - sites[position]
            - .stated
            - program.store-atom
                - "Pattern ${name.text} has no accumulating capture ${callees[position]}"
        = false
for position in 0 .. < sites.length
    if !accumulates-in(tree, rule-arming.capture-root, callers[position])
        frame.diagnose(sites[position], .stated, program.store-atom("Collector mapping target ${callers[position]} is not an active accumulating capture"))
        = false
= true

────────────────────
_ do mapped-call-type TypeId
    - id SyntaxId
    - rule SyntaxId
    - name Atom
    - mappings RowRange'SyntaxId

` A call of a rule given collectors, as the reference compiles one: the rule, a local one or
` one a module declares, is typed as where it is called plainly, and each name of the rule's
` that a collector is given for adds to the list the caller's name keeps, which for a local
` rule must be a list of what the rule's name accumulates; the emitter checks one a module
` declares. The call gives the text it matched, as the reference's call gives no value of its
` own. One over items that are not characters, or given a name of the caller's not yet typed,
` has no shape here.
if !text-items()
    decline(id)
    = invalid-type
if rule != 0
    . pattern = local-rule-pattern(rule)
    if !mapped(mappings, name, tree, pattern)
        = invalid-type
    if rule-type(rule) == invalid-type
        = invalid-type
    for mapping in tree.children[mappings]
        do match? tree.nodes[mapping]
            | .node-stream-collector-mapping(row)
                . callee = if row.callee then row.callee.text else row.caller.text
                . given = accumulated-type(pattern, callee)
                if given == no-type || given != accumulator-type(row.caller.text)
                    decline(id)
                    = invalid-type
    = types.string-type
do match? tree.nodes[id]
    | .node-stream-call(row)
        if module-rule-type(id, row.name, row.params, row.args) == invalid-type
            = invalid-type
. fact = facts.first-call(instance, id)
. callee = if fact != no-fact then facts.calls[fact].callee else no-instance
if callee == no-instance
    decline(id)
    = invalid-type
. called = instances.rows[callee]
. source = program.modules[called.module].tree
. pattern SyntaxId = 0
do match? source.nodes[rule-match(program, called.module, called.decl)]
    | .node-stream-match(matched)
        pattern = matched.pattern
if pattern == 0
    decline(id)
    = invalid-type
if !mapped(mappings, name, source, pattern)
    = invalid-type
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            if accumulator-type(row.caller.text) == no-type
                decline(id)
                = invalid-type
= types.string-type

────────────────────
_ do accumulator-type TypeId
    - name String

` The list the pattern being typed keeps for a name it accumulates, where the name was typed.
for position in rule-arming.capture-base .. < capture-sites.length
    if capture-accumulating[position] && name-text(capture-sites[position]) == name
        = facts.node-type(instance, capture-sites[position])
= no-type

────────────────────
_ do accumulated-type TypeId
    - id SyntaxId
    - name String

` The list a pattern keeps of what a name it accumulates in a part of its own adds, or none.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        if row.accumulating && name-text(row.name) == name
            = facts.node-type(instance, row.name)
        = accumulated-type(row.pattern, name)
    | .node-stream-and(row)
        . left = accumulated-type(row.left, name)
        = if left != no-type then left else accumulated-type(row.right, name)
    | .node-stream-or(row)
        . left = accumulated-type(row.left, name)
        = if left != no-type then left else accumulated-type(row.right, name)
    | .node-stream-transform(row)
        if row.pattern != 0
            = accumulated-type(row.pattern, name)
    | .node-stream-panic(row)
        = accumulated-type(row.pattern, name)
    | .node-stream-unary(row)
        = accumulated-type(row.operand, name)
    | .node-stream-length(row)
        = accumulated-type(row.operand, name)
= no-type

────────────────────
_ do accumulates-in Bool
    - source AST
    - id SyntaxId
    - name String

` Whether a pattern accumulates a name in a part of its own, not in a rule it calls.
do match? source.nodes[id]
    | .node-stream-capture(row)
        . named = identifier-name(source, row.name)
        = accumulates-own || accumulates-in(source, row.pattern, name)
            .. accumulates-own = row.accumulating && named && named.text == name
    | .node-stream-and(row)
        = accumulates-in(source, row.left, name) || accumulates-in(source, row.right, name)
    | .node-stream-or(row)
        = accumulates-in(source, row.left, name) || accumulates-in(source, row.right, name)
    | .node-stream-transform(row)
        = row.pattern != 0 && accumulates-in(source, row.pattern, name)
    | .node-stream-panic(row)
        = accumulates-in(source, row.pattern, name)
    | .node-stream-unary(row)
        = accumulates-in(source, row.operand, name)
    | .node-stream-length(row)
        = accumulates-in(source, row.operand, name)
= false

────────────────────
_ do local-rule-pattern SyntaxId
    - rule SyntaxId

` The pattern of a local rule, by its declaration.
do match? tree.nodes[rule]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.right]
            | .node-stream-match(row)
                = row.pattern
= 0

────────────────────
_ holds-value Bool
    - call SyntaxId

` Whether a call of a rule names a local, an argument or the item of a loop, rather than a
` local rule or a rule a module declares.
|? resolution.kind != .resolve-slot
    false
??
    kind == .slot-local || kind == .slot-argument || kind == .slot-loop-item

.. resolution = bindings.resolution-of(frame.binding, call)
.. kind = bindings.slots[resolution.slot].kind

────────────────────
_ do held-pattern-type TypeId
    - call SyntaxId
    - name Atom
    - plain Bool

` A call of a pattern given to the rule, `\name`, as `$name` calls one. One given arguments
` or types, or that names a value of any other type, has no shape here.
. type = if plain then infer-identifier(call, name, Want().adding(.want-pattern)).type else invalid-type
. called = if type != invalid-type then pattern-result(type) else no-type
if called == no-type
    decline(call)
    = invalid-type
= plan-pattern-call(call, called)

────────────────────
_ do type-node-type TypeId
    - id SyntaxId
    - written SyntaxId

` A type named as a part of a stream pattern, as the reference types it: a call of the type's
` constructor that takes the stream, which gives what the constructor gives where it passes;
` for a number, a call of the rule `num` or `dec` given the type that reads one, where a rule
` of that name takes the stream; else a test of one item for the type, which gives the item.
. known = facts.node-type(instance, id)
if known != no-type
    = known
. class = types.evaluate-type(module, tree, written, frame.env)
if class == invalid-type || class == no-type
    if !report-missing-type(written, frame.env)
        decline(id)
    = invalid-type
. made = stream-constructor-type(id, class)
if made == no-type
    . kind = types.intrinsic-of(class)
    . reader = program.store-atom(if intrinsic-is-float(kind) then "dec" else "num")
    if intrinsic-is-numeric(kind) && reads-stream(reader, class)
        . empty = RowRange'SyntaxId()
        made = module-rule-type(id, reader, empty, empty, class)
    else
        made = item-test-type(id, written, class)
if made == invalid-type
    = invalid-type
facts.set-node-type(instance, id, made)
= made

────────────────────
_ do stream-constructor-type TypeId
    - id SyntaxId
    - class TypeId

` A call of the constructor of a type that takes the stream, as a `TokenStream` of its items,
` with the type of the items as its type parameter, as the reference dispatches it. It gives
` what the constructor gives where it passes, as the rule the constructor is: no type where
` the type has no such constructor. A constructor that is no rule, or that gives what it
` captured, has no shape here. A pattern whose buffer is `encoded` calls the constructor typed
` again for that buffer, as `encoded-callee` says.
. stream = class-over(types.token-stream-decl, stream-view.item)
. params-start = scratch.types.mark
scratch.types.push(stream-view.item)
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(stream)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(id)
. arguments = arguments-since
    - shapes-start
    - types-start
    - syntax-start
    - scratch.types.span(params-start, 1)
types.complete(class)
calls.ranking.begin(arguments.shapes, arguments.types)
calls.ranking.explicit-params(arguments.params)
. hit = calls.ranking.dispatch-constructor(class, true)
calls.ranking.release()
. made = no-type
if hit
    if stream-view.type != stream && conversions.convert(id, id, stream-view.type, stream, .reason-argument) == invalid-type
        made = invalid-type
    else
        made = calls.construction-on(id, class, arguments, true, 0, false, true)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
if made == no-type || made == invalid-type
    = made
. fact = facts.first-call(instance, id)
. callee = if fact != no-fact then facts.calls[fact].callee else no-instance
if callee == no-instance || !types.is-optional(made) || no-rule
    decline(id)
    = invalid-type
.. no-rule = rule-match(program, instances.rows[callee].module, instances.rows[callee].decl) == 0
. given = types.optional-inner(made)
if same-decl(class-ref(types, given), types.capture-result-decl)
    decline(id)
    = invalid-type
. chosen = if helping.helper != null then helped-callee(id, callee, false) else plain-callee(callee)
if chosen == no-instance
    = invalid-type
facts.calls[fact].callee = chosen
= given

────────────────────
_ do reads-stream Bool
    - name Atom
    - class TypeId

` Whether the function of a name given the stream, with the type of its items and a type as its
` type parameters, is a rule, as the reference looks for the rule that reads a number of that
` type.
. params-start = scratch.types.mark
scratch.types.push(stream-view.item)
scratch.types.push(class)
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(stream-view.type)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(0)
. arguments = arguments-since
    - shapes-start
    - types-start
    - syntax-start
    - scratch.types.span(params-start, 2)
calls.ranking.begin(arguments.shapes, arguments.types)
calls.ranking.explicit-params(arguments.params)
. hit = calls.ranking.dispatch-function(no-type, name)
calls.ranking.release()
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
= !!hit && rule-match(program, hit.module, hit.decl) != 0

────────────────────
_ do item-test-type TypeId
    - id SyntaxId
    - written SyntaxId
    - class TypeId

` A test of one item for a type, as the reference tests it: the item's type must relate to the
` type, as it is reported where not, and the test passes where the item is of it. It gives the
` item as the type. An item of the type itself is tested here, and one of a class the type
` derives from, which is tested as the type named as a pattern tests a value, by what
` `plan-type-pattern` records at the type written. An item that is a number of another type is
` never of it, as the reference compares the two types alone, so the test never passes.
` The reference first tells the stream the pattern stands at the item, as it does before it
` calls a function that reads the type, and finds none.
. relation = relations.compare(stream-view.item, class, false, false, null, module)
if !relation-legal(relation)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Type has no stream constructor for this stream item type")
    = invalid-type
if stream-view.item != class && intrinsic-is-numeric(types.intrinsic-of(stream-view.item))
    if !record-commit(id)
        decline(id)
        = invalid-type
    = class
if stream-view.item != class
    if !derives(class, stream-view.item)
        decline(id)
        = invalid-type
    . planned = facts.conversions.length
    plan-type-pattern(written, stream-view.item, class, .similar)
    if facts.conversions.length == planned
        decline(id)
        = invalid-type
if !record-commit(id)
    decline(id)
    = invalid-type
= class

────────────────────
_ do derives Bool
    - type TypeId
    - ancestor TypeId

` Whether a class derives from another, however far.
if types.intrinsic-of(type) != .class || types.intrinsic-of(ancestor) != .class
    = false
. base = types.base-of(type)
while base
    if base == ancestor
        = true
    base = types.base-of(base)
= false

────────────────────
_ do module-rule-type TypeId
    - id SyntaxId
    - name Atom
    - params RowRange'SyntaxId
    - args RowRange'SyntaxId
    - named TypeId = no-type

` A call of a rule a module declares, as the reference matches it: a call of the function of
` that name given the stream as its first argument, as a `TokenStream` of its items, before
` the arguments written, and the type of the stream's items as its first type parameter,
` before the types written. It gives what the rule gives where the rule passes. Where no
` function of the name takes them, the call is reported as the reference reports it, unless
` an argument has no type, as a pattern given as an argument has none here. A type `named`
` stands for the types written. A function that
` is no rule, a rule that belongs to a type, and one that calls itself without stating its
` type have no shape here, but where the call reads no type yet the rule reports that it
` cannot be typed, as the reference does. Under a helper, the rule runs as `helped-callee`
` says, and a function that is no rule has no shape. A rule given a pattern there runs typed
` for the helper, which it gives each pattern it calls: a pattern written as the argument,
` typed for the helper too; any other has no shape. The names of the pattern its arguments
` read are made before the call as `materialize-arguments` says. A rule typed again for the
` helper runs in place of the rule as it is, whose body this call then leaves untyped, as the
` reference compiles only the one the pattern calls. A pattern whose buffer is `encoded` calls the
` rule, or the function that is no rule, typed again for that buffer, as `encoded-callee` says,
` in place of the one as it is.
if slot-named || stream-view.item == no-type || stream-view.type == no-type
    decline(id)
    = invalid-type
.. slot-named = bindings.resolution-of(frame.binding, id).kind == .resolve-slot
. stream = class-over(types.token-stream-decl, stream-view.item)
if retyped && conversions.convert(id, id, stream-view.type, stream, .reason-argument) == invalid-type
    decline(id)
    = invalid-type
.. retyped = stream-view.type != stream
. restores [SlotId]
. restored [TypeId]
if helping.helper != null && !materialize-arguments(id, args, restores, restored)
    = invalid-type
. params-start = scratch.types.mark
scratch.types.push(stream-view.item)
. param-count = 1
if named != no-type
    scratch.types.push(named)
    param-count += 1
for param in tree.children[params]
    scratch.types.push(types.evaluate-type(module, tree, param, frame.env))
    param-count += 1
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(stream)
scratch.syntax.push(id)
. typed = true
. patterned = false
for arg in tree.children[args]
    . given = arg
    . label Atom? = null
    . optional = false
    do match? tree.nodes[arg]
        | .node-argument(argument)
            given = argument.expr
            label = argument.name
            optional = argument.is-optional
    . written = tree.nodes[given] is .node-stream-match
    . type = if written then pattern-argument-type(given) else infer-argument(given, given-symbol)
        .. given-symbol = argument-symbol(given)
    scratch.call-arguments.push(argument-shape(label, optional, given))
    if helping.helper != null && is-pattern-func(type)
        patterned = true
        if !written
            decline(given)
            type = invalid-type
    typed = typed && type != invalid-type
    scratch.types.push(type)
    scratch.syntax.push(arg)
. arguments = arguments-since
    - shapes-start
    - types-start
    - syntax-start
    - scratch.types.span(params-start, param-count)
. diagnosed = facts.diagnostics.length
. holds = helping.helper != null || encoded()
. mark = if holds then instances.hold() else instances.held.mark
deferring = holds
. result = if typed then calls.function-call(id, name, arguments) else invalid-type
deferring = false
. resolved = instances.held.mark
if result == invalid-type && typed
    . known = false
    . ruled = false
    for candidate in program.lookup(module, name)
        known = true
        . owner = program.modules[candidate.module]
        do match? owner.decls[candidate.decl]
            | .decl-function(fn)
                ruled = ruled || (fn.args.count != 0 && owner.arg-pool[fn.args.start].name?.text == "(stream)")
    . missing = "Rule \"${name.text}\" not found"
    . unruled = "\"${name.text}\" is a function, not a rule; call it outside the pattern"
    . unmatched = "No rule \"${name.text}\" matches ${type-short-name(types, stream-view.item)} items with these arguments"
    . message = program.store-atom(if !known then missing else if !ruled then unruled else unmatched)
    facts.restate(diagnosed, instance, id, .function-not-found, .stated, message)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
for position in 0 .. < restores.length
    frame.assign(restores[position], restored[position])
. answer = invalid-type
. dropped = no-instance
. fact = if result != invalid-type && result != no-type then called-fact else no-fact
    .. called-fact = facts.first-call(instance, id)
. callee = if fact != no-fact then facts.calls[fact].callee else no-instance
if result == invalid-type || result == no-type
    answer = invalid-type
else if callee == no-instance
    decline(id)
else if instances.rows[callee].self-type != no-type || (in-progress && undeclared)
    decline(id)
else if rule-match(program, instances.rows[callee].module, instances.rows[callee].decl) == 0
    if helping.helper != null
        decline(id)
    else
        answer = boundary-type(id, callee, result)
        if answer != invalid-type && encoded()
            facts.calls[fact].callee = plain-callee(callee)
            dropped = callee
else if !types.is-optional(result)
    decline(id)
else
    . chosen = if has-helper then helped-callee(id, callee, patterned) else plain-callee(callee)
        .. has-helper = helping.helper != null
    if chosen != no-instance
        facts.calls[fact].callee = chosen
        answer = types.optional-inner(result)
        if chosen != callee
            dropped = callee
.. in-progress = instances.rows[callee].state == .instance-in-progress
.. undeclared = instances.signatures[callee].return-state != .return-declared
if holds
    instances.release(mark, resolved, dropped)
= answer

────────────────────
_ do materialize-arguments Bool
    - id SyntaxId
    - args RowRange'SyntaxId
    - restores [SlotId]
    - restored [TypeId]

` Plans how the helper makes the names of the pattern that the arguments of a call of a rule
` read, as the reference makes them before the call where one selects a materializer: each
` wanted as what it holds, in the order the arguments first read them, made as
` `materialize-capture` says. A call that makes one makes its pattern one that makes a value
` through the helper. A pattern written as an argument reads none. A name read only for its
` length has no shape here. Keeps the slots it retypes, and their types before.
. seen [SlotId]
. arm = top-arm(id)
action-selects = false
. planned = true
for arg in tree.children[args]
    . given = arg
    do match? tree.nodes[arg]
        | .node-argument(argument)
            given = argument.expr
    if tree.nodes[given] is .node-stream-match
        continue
    for node in tree.subtree-start(given) .. < given + 1
        do match? tree.nodes[node]
            | .node-identifier
                . slot = capture-slot(node)
                . position = if slot != no-slot then capture-position(slot, arm) else U32.max
                if planned && position != U32.max && seen.find(slot) == null
                    seen += slot
                    if reads-length-only(slot, given)
                        decline(id)
                        planned = false
                    else if !materialize-capture(id, given, position, facts.node-type(instance, capture-sites[position]), restores, restored)
                        planned = false
if action-selects
    pattern-arms = pattern-arms.selects = true
action-selects = false
= planned

────────────────────
_ do helped-callee InstanceId
    - id SyntaxId
    - callee InstanceId
    - patterned Bool

` The instance a call of a rule a module declares runs under the helper of the pattern calling
` it, as the reference compiles the call: the rule typed again for the helper where its own
` pattern makes a value through it or needs it to roll back, which the call then gives it, and
` the rule as it is elsewhere where not. The pattern calling such a rule uses the helper too,
` and needs it to roll back where the rule does. A call of the rule from its own pattern,
` typed for the helper, has no shape here. A rule given its own helper as an argument runs
` under that, and where it needs it to roll back, so does the pattern calling it; where that
` is not yet known and the helper in force cannot roll back, the call has no shape here. A
` rule given patterns typed for the helper is always typed for it, and one given its own
` helper has no shape then. A rule that holds a rollback mark gives it to the pattern calling
` it, which then holds one too; one given its own helper that holds one gives it so only
` where the pattern calling it keeps marks of the same type, and has no shape here elsewhere.
` Under a helper that observes literal words, a rule is typed for the helper first, and runs
` under it where its pattern does (`observes-literals`); a rule given its own helper runs under
` that only where not, and a call of the rule from its own pattern runs it under the helper.
. observed = helping.helper!.observer != no-type
if ambient-position(types, instances, callee) != U32.max && !observed
    = ambient-callee(id, callee, patterned)
. row = instances.rows[callee]
. signature = instances.signatures[callee]
. start = signature.args.start - signature.param-count
. mark = scratch.types.mark
for offset in 0 .. < signature.param-count + signature.args.count
    scratch.types.push(instances.signature-types[start + offset])
. params = scratch.types.span(mark, signature.param-count)
. args = scratch.types.span(mark + signature.param-count, signature.args.count)
. none = ImmutableArray'U32'ArenaBacking()
. helped = instances.intern
    - row.module
    - row.decl
    - row.self-type
    - row.effects
    - row.enclosing
    - params
    - args
    - true
    - no-type
    - U32.max
    - false
    - 0
    - helping.helper!.participant
    - none
    - none
    - U32.max
    - ZoneEntry()
    - no-instance
    - 0
    - helping.span-typing
    - encoded()
scratch.types.rewind(mark)
demand-body(helped)
. recursive = observed && instances.rows[helped].state == .instance-in-progress
if instances.rows[helped].state != .instance-done && !recursive
    decline(id)
    = no-instance
if !instances.rows[helped].uses-helper && !patterned && !recursive
    if ambient-position(types, instances, callee) != U32.max
        = ambient-callee(id, callee, patterned)
    = plain-callee(callee)
if instances.rows[helped].rolls-helper
    helping = helping.rolls = true
note-helper-use(instances.rows[helped].rolls-helper)
if instances.rows[helped].carries-mark
    note-mark()
= helped

────────────────────
_ do plain-callee InstanceId
    - callee InstanceId

` The instance of a rule, or of a function given the stream that is no rule, a pattern calls
` under no helper: the one it resolved to, or where the pattern's buffer is `encoded`, the one
` `encoded-callee` gives.
= if encoded() then encoded-callee(callee) else callee

────────────────────
_ do encoded-callee InstanceId
    - callee InstanceId

` The instance of a rule, or of a function given the stream that is no rule, a pattern calls
` whose buffer holds the UTF-8 bytes of a String: the one typed again as `encoded`, whose own
` patterns on the stream read those bytes, under the helper and for the text it is typed for
` already.
. row = instances.rows[callee]
. signature = instances.signatures[callee]
. start = signature.args.start - signature.param-count
. mark = scratch.types.mark
for offset in 0 .. < signature.param-count + signature.args.count
    scratch.types.push(instances.signature-types[start + offset])
. params = scratch.types.span(mark, signature.param-count)
. args = scratch.types.span(mark + signature.param-count, signature.args.count)
. none = ImmutableArray'U32'ArenaBacking()
. made = instances.intern
    - row.module
    - row.decl
    - row.self-type
    - row.effects
    - row.enclosing
    - params
    - args
    - true
    - no-type
    - U32.max
    - false
    - 0
    - row.helper
    - none
    - none
    - U32.max
    - ZoneEntry()
    - no-instance
    - 0
    - row.spans
    - true
scratch.types.rewind(mark)
demand-body(made)
= made

────────────────────
_ do ambient-callee InstanceId
    - id SyntaxId
    - callee InstanceId
    - patterned Bool

` The instance a call of a rule given its own helper as an argument runs under that helper, as
` `helped-callee` says, typed again as `plain-callee` says.
if patterned
    decline(id)
    = no-instance
. ruled = plain-callee(callee)
demand-body(ruled)
if instances.rows[ruled].state != .instance-done && helping.helper!.rollback == no-type
    decline(id)
    = no-instance
if instances.rows[ruled].carries-mark
    note-mark()
    . theirs = facts.rollback-body-of
        - ruled
        - rule-match(program, instances.rows[ruled].module, instances.rows[ruled].decl)
    . ours = if helping.body != 0 then facts.rollback-body-of(instance, helping.body) else U32.max
    if theirs == U32.max || ours == U32.max || kept-differs
        decline(id)
        = no-instance
    .. kept-differs = facts.rollback-bodies[theirs].kept != facts.rollback-bodies[ours].kept
if instances.rows[ruled].rolls-helper
    helping = helping.rolls = true
    note-helper-use(true)
= ruled

────────────────────
_ do boundary-type TypeId
    - id SyntaxId
    - callee InstanceId
    - result TypeId

` A call of a function given the stream that is no rule, as the reference calls it: the stream
` is told the pattern stands at the cursor before, and asked for its view after, which says
` where the function left it and how far it read. It gives what the function gives, which
` the call holds where the function answers an optional, and the result of a `CaptureResult`
` where it answers one. A function that raises errors has no shape here.
if instances.signatures[callee].errors.count != 0 || !record-commit(id)
    decline(id)
    = invalid-type
. view = calls.protocol-getter(stream-view.type, view-name(encoded()), id)
if !types.is-optional(view)
    decline(id)
    = invalid-type
. given = if types.is-optional(result) then types.optional-inner(result) else result
= if capturing then class-arg(types, given, 1) else given
    .. capturing = same-decl(class-ref(types, given), types.capture-result-decl)

────────────────────
_ do record-commit Bool
    - id SyntaxId

` Records at a part of a stream pattern the stream's `pattern-commit` of the cursor where the
` part begins, which the reference makes there before it calls a function that is no rule.
= calls.protocol-call(stream-view.type, program.store-atom("pattern-commit"), id, types.index-type, false, types.index-type).answer != invalid-type

────────────────────
_ do rule-of SyntaxId
    - call SyntaxId

` The declaration of the local rule a call of a rule names, or none where it names another.
. resolution = bindings.resolution-of(frame.binding, call)
if resolution.kind != .resolve-slot
    = 0
. row = bindings.slots[resolution.slot]
if row.kind != .slot-lazy || row.group == 0
    = 0
do match? tree.nodes[row.group]
    | .node-declare(declaration)
        if tree.nodes[declaration.right] is .node-stream-match
            = row.group
= 0

────────────────────
_ do record-recursion Bool
    - id SyntaxId
    - rule SyntaxId
    - result TypeId

` Records what the reference does at a call of a local rule beside a match made from the
` rule's own arms. It calls a function it makes of the rule as it calls a function given the
` stream: the stream is told the pattern stands at the cursor before, and asked for its view
` after. That function runs the rule on the stream's view and commits where it ended, by the
` calls a match on the stream records, which are kept at the rule's pattern; the stream, its
` buffer, and the optional `CaptureResult` the function answers are kept with the rule. A
` rule another rule calls back, one called under a helper, and one called on another stream
` than it was first, have no shape here.
. matched SyntaxId = 0
do match? tree.nodes[rule]
    | .node-declare(declaration)
        matched = declaration.right
. pattern = local-rule-pattern(rule)
if pattern == 0 || rules.length == 0 || rules[rules.length - 1] != rule || helping.helper != null
    if pattern != 0 && rules.find(rule) != null && helping.helper == null
        . text = "The local rules of a match cannot call one another in a cycle; declare them below a rule the module declares, whose local rules can"
        frame.diagnose(id, .stated, program.store-atom(text))
    else
        decline(id)
    = false
. place = facts.note-local-rule(instance, rule)
if facts.local-rules[place].stream == no-type
    . stream = stream-view.type
    . item = stream-view.item
    if !record-stream-view(matched, stream, item, encoded())
        decline(id)
        = false
    . mark = scratch.types.mark
    scratch.types.push(buffer-item)
    scratch.types.push(result)
    . captured = types.class-with-args
        - types.capture-result-decl.module
        - types.capture-result-decl.decl
        - mark
    types.complete(captured)
    . adapted = types.optional-of(captured)
    types.complete(adapted)
    facts.local-rules[place].adapted = adapted
    facts.local-rules[place].stream = stream
    facts.local-rules[place].buffer = stream-view.buffer
else if facts.local-rules[place].stream != stream-view.type
    decline(id)
    = false
if !record-commit(id) || !types.is-optional(calls.protocol-getter(stream-view.type, view-name(encoded()), id))
    decline(id)
    = false
= true

────────────────────
_ do coded-rule SyntaxId
    - call SyntaxId

` The declaration of the local rule a call of a rule names whose body is code that runs
` patterns rather than a pattern, or none where it names another.
. resolution = bindings.resolution-of(frame.binding, call)
if resolution.kind != .resolve-slot
    = 0
. row = bindings.slots[resolution.slot]
if row.kind != .slot-lazy || row.group == 0
    = 0
do match? tree.nodes[row.group]
    | .node-declare(declaration)
        if declaration.is-pattern && declaration.right != 0 && !stream-match
            = row.group
        .. stream-match = tree.nodes[declaration.right] is .node-stream-match
= 0

────────────────────
_ do coded-rule-type TypeId
    - id SyntaxId
    - rule SyntaxId

` A call of a local rule whose body is code, as the reference calls the function it makes of
` it: the stream is told the pattern stands at the cursor before, the code runs, each pattern
` in it on the stream from where the stream stands, and the stream is asked for its view
` after, which says where the code left it and how far it read. The reference's function
` holds the names the code reads; here the code runs where the rule is called, where they
` are. The code is typed where the rule is first called, for the stream it is called on, and
` must give an optional `CaptureResult` of the stream's items, as a pattern in it does, whose
` result the call gives; code that gives anything else, or that calls the rule, is reported
` as the reference reports it. A rule that states a type or is marked to roll back, and one
` called on another stream or under a helper, have no shape here.
. left SyntaxId = 0
. code SyntaxId = 0
. marked = false
do match? tree.nodes[rule]
    | .node-declare(declaration)
        left = declaration.left
        code = declaration.right
        marked = declaration.rollback
. stated = false
do match? tree.nodes[left]
    | .node-type-capture(row)
        stated = row.type != 0
if code == 0 || marked || stated || helping.helper != null
    decline(id)
    = invalid-type
. untyped = program.store-atom("Unable to infer pattern result type")
if coded-rules.find(rule) != null
    frame.diagnose(id, .stated, untyped)
    = invalid-type
if !record-commit(id)
    decline(id)
    = invalid-type
. typed = coded-typed.find(rule)
if typed != null && coded-streams[typed] != stream-view.type
    decline(id)
    = invalid-type
. given = facts.node-type(instance, code)
if typed == null
    . saved-stream = rule-streaming
    . saved-expected = arms-expected
    . saved-unvalued = valuing
    . saved-explicit = helping
    . ran = stream-view
    coded-rules += rule
    rule-streaming = rule-streaming.matched = 0
    rule-streaming = rule-streaming.stream = ran.type
    rule-streaming = rule-streaming.encoded = encoded()
    arms-expected = no-type
    valuing = valuing.unvalued = false
    helping = helping.explicit = false
    given = infer(code)
    . carried-rolls = helping.rolls
    helping = saved-explicit
    helping = helping.rolls = carried-rolls
    valuing = saved-unvalued
    arms-expected = saved-expected
    rule-streaming = saved-stream
    stream-view = ran
    coded-rules.pop()
    coded-typed += rule
    coded-streams += ran.type
if given == invalid-type
    = invalid-type
. view = calls.protocol-getter(stream-view.type, view-name(encoded()), id)
if !types.is-optional(view)
    decline(id)
    = invalid-type
. held = if given != no-type && types.is-optional(given) then inner-given else no-type
    .. inner-given = types.optional-inner(given)
if held == no-type || !same-decl(class-ref(types, held), types.capture-result-decl)
    frame.diagnose(id, .stated, untyped)
    = invalid-type
if class-arg(types, held, 0) != buffer-item
    decline(id)
    = invalid-type
= class-arg(types, held, 1)

────────────────────
_ do left-call SyntaxId
    - id SyntaxId
    - target SyntaxId
    - seen [SyntaxId]

` The call by which a part of a stream pattern calls a rule before it reads an item, or none:
` the local rule `target`, or for none the rule the module declares that is being checked,
` called directly or through the local rules called first. A call of any other rule is taken
` to read before it calls anything. Such a rule would call itself forever.
do match? tree.nodes[id]
    | .node-stream-call
        if calls-target(id, target)
            = id
        . rule = rule-of(id)
        if rule == 0 || seen.find(rule) != null
            = 0
        seen += rule
        = left-call(rule-pattern(rule), target, seen)
    | .node-stream-and(row)
        . leading = left-call(row.left, target, seen)
        if leading != 0 || !may-read-none(row.left, List'SyntaxId())
            = leading
        = left-call(row.right, target, seen)
    | .node-stream-or(row)
        . leading = left-call(row.left, target, seen)
        = if leading != 0 then leading else left-call(row.right, target, seen)
    | .node-stream-unary(row)
        = left-call(row.operand, target, seen)
    | .node-stream-length(row)
        = left-call(row.operand, target, seen)
    | .node-stream-capture(row)
        = left-call(row.pattern, target, seen)
    | .node-stream-transform(row)
        if row.pattern != 0
            = left-call(row.pattern, target, seen)
    | .node-stream-panic(row)
        if row.pattern != 0
            = left-call(row.pattern, target, seen)
= 0

────────────────────
_ do calls-target Bool
    - call SyntaxId
    - target SyntaxId

` Whether a call of a rule names the local rule `target`, or for none the rule the module
` declares that is being checked.
if target != 0
    = rule-of(call) == target
. resolution = bindings.resolution-of(frame.binding, call)
= resolution.kind == .resolve-function && resolution.decl == frame.decl && resolution.module == module

────────────────────
_ do may-read-none Bool
    - id SyntaxId
    - seen [SyntaxId]

` Whether a part of a stream pattern may match without reading an item, as far as it is
` known here: a call of a rule other than a local one is taken to read.
do match? tree.nodes[id]
    | .node-stream-string(row)
        = row.text.length == 0
    | .node-stream-and(row)
        = may-read-none(row.left, seen) && may-read-none(row.right, seen)
    | .node-stream-or(row)
        = may-read-none(row.left, seen) || may-read-none(row.right, seen)
    | .node-stream-unary(row)
        = row.op != .one-or-more-op || may-read-none(row.operand, seen)
    | .node-stream-length(row)
        do match? tree.nodes[row.min]
            | .node-integer-syntax(bound)
                if parse-integer-literal(bound.value).value == 0
                    = true
        = may-read-none(row.operand, seen)
    | .node-stream-capture(row)
        = may-read-none(row.pattern, seen)
    | .node-stream-transform(row)
        = row.pattern != 0 && may-read-none(row.pattern, seen)
    | .node-stream-panic(row)
        = row.pattern != 0 && may-read-none(row.pattern, seen)
    | .node-stream-call
        . rule = rule-of(id)
        if rule == 0 || seen.find(rule) != null
            = false
        seen += rule
        = may-read-none(rule-pattern(rule), seen)
= false

────────────────────
_ do rule-pattern SyntaxId
    - rule SyntaxId

` The pattern of a local rule's declaration.
do match? tree.nodes[rule]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.right]
            | .node-stream-match(row)
                = row.pattern
= 0

────────────────────
_ do report-left-recursion
    - call SyntaxId

` Reports a call by which a rule calls itself before it reads anything.
. name = ""
do match? tree.nodes[call]
    | .node-stream-call(row)
        name = row.name.text
. text = "\"$name\" calls itself before reading any input, so it never ends; read input before this call, or write the repetition with \"*\""
frame.diagnose(call, .stated, program.store-atom(text))

────────────────────
_ do rule-type TypeId
    - rule SyntaxId

` What a local rule gives, typed where it is first called: its arms are typed as a pattern of
` their own whose names are its own, which reads the stream from where it is called, and
` joined, then converted to the type its declaration states. The reference runs the rule in
` the function that calls it, where the rule reads that function's locals and the names its
` match captured. A rule that calls itself, directly or through other local rules, gives at
` those calls the type its declaration states, and each rule on the way is one the reference
` runs as a function of its own, which answers the optional of what the rule gives; one that
` states no type is an error at the rule. Nor has a rule called under another helper than it was
` typed under, whose values that helper made. One typed for a call that gives its text states
` that it gives text. A rule beside a rule's pattern that is marked to roll back, or whose
` pattern has an arm that is, asks the helper for a mark before each of its actions, as the
` reference does a rule it compiles on its own. One beside a match's pattern that is marked
` so gives the mark to each of its arms. Its arms give their values whether or not the call it
` is first typed at reads what it gives: a later call may.
. left SyntaxId = 0
. matched SyntaxId = 0
. marked = false
do match? tree.nodes[rule]
    | .node-declare(declaration)
        left = declaration.left
        matched = declaration.right
        marked = declaration.rollback
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
if pattern == 0
    decline(rule)
    = invalid-type
. known = facts.node-type(instance, matched)
if known != no-type
    . typed = typed-rules.find(rule)
    if typed != null && typed-helpers[typed] != helping.site
        decline(rule)
        = invalid-type
    = known
. declared = no-type
do match? tree.nodes[left]
    | .node-type-capture(row)
        if row.type != 0
            declared = types.evaluate-type(module, tree, row.type, frame.env)
if declared == invalid-type
    decline(rule)
    = invalid-type
if helping.span-typing
    declared = types.string-type
. calling = rules.find(rule)
if calling != null
    . closing = left-call(pattern, rule, List'SyntaxId())
    if closing != 0
        report-left-recursion(closing)
        = invalid-type
    if declared == no-type
        frame.diagnose(left, .stated, program.store-atom("Can't infer return type after recursion"))
        = invalid-type
    for position in calling .. < rules.length
        facts.local-rules[facts.note-local-rule(instance, rules[position])].recursive = true
    = declared
. place = facts.note-local-rule(instance, rule)
rules += rule
typed-rules += rule
typed-helpers += helping.site
. own-arms = rule-arming
. base = capture-sites.length
rule-arming = RuleArms(declared, gives-source-span(declared), true, declared == types.string-type, pattern, base, rule-arming.casting)
. saved-explicit = helping
. saved-unvalued = valuing
helping = helping.explicit = marked || (beside-rule && holds-rollback(pattern))
valuing = valuing.unvalued = false
. joined = arms-type(pattern)
valuing = saved-unvalued
. carried-rolls = helping.rolls
helping = saved-explicit
helping = helping.rolls = carried-rolls
-= capture-sites[base .. < capture-sites.length]
-= capture-slots[base .. < capture-slots.length]
-= capture-accumulating[base .. < capture-accumulating.length]
-= capture-patterns[base .. < capture-patterns.length]
-= capture-repeats[base .. < capture-repeats.length]
rule-arming = own-arms
rules.pop()
if joined == invalid-type
    = invalid-type
. result = declared
if result == no-type
    result = if joined == no-type then types.string-type else joined
convert-stream-arms(pattern, result)
if declared != no-type && declared != types.string-type
    note-arm-casts(pattern, declared)
facts.set-node-type(instance, pattern, result)
facts.set-node-type(instance, matched, result)
facts.local-rules[place].answer = types.optional-around(result)
= result

────────────────────
_ item-holds Bool
    - point U64

` Whether integer items hold a character a pattern tests them against as its code point: one
` their type fits, and over items of a byte, which hold the UTF-8 of text, one that is ASCII.
literal-fits-target(types, IntegerLiteral(point, false, false), stream-view.item) && ascii-or-wide
.. ascii-or-wide = point < 0x80 || types.completion-of(stream-view.item).bit-size > 8

────────────────────
_ do report-unheld TypeId
    - id SyntaxId

` The error for characters in a pattern over integer items that do not hold them as they are.
. byte = types.completion-of(stream-view.item).bit-size <= 8
. text = if byte then over-bytes else over-items
    .. over-bytes = "Characters in a pattern over bytes must be ASCII; match other bytes by number"
    .. over-items = "Characters in a pattern over ${type-display(types, stream-view.item)} items must fit that type"
frame.diagnose(id, .stated, program.store-atom(text))
= invalid-type

────────────────────
_ bound U64
    - id SyntaxId

` The code point a bound of a range of characters is written as.
match tree.nodes[id]
    | .node-integer-syntax(row)
        parse-integer-literal(row.value).value
    ??
        0

────────────────────
_ char-bound Bool
    - id SyntaxId

` Whether a bound of a range of characters is a character written, as the reference requires: a
` character literal, whose unit is `(char)`, or a number with no unit or `Char`'s suffix.
match tree.nodes[id]
    | .node-integer-syntax(row)
        !row.unit || row.unit.text == "(char)" || row.unit.text == "c"
    ??
        false

────────────────────
_ count-bound Bool
    - id SyntaxId

` Whether a bound of a count is a number written.
match tree.nodes[id]
    | .node-integer-syntax(row)
        !row.unit
    ??
        false

────────────────────
_ do counts Bool
    - id SyntaxId
    - repeated Bool

` Whether a bound of a count has a shape here: a number written, or an integer computed as
` the match runs. The reference reads the most again before each time it takes the part, so
` a bound it reads more than once must give the same each time without doing anything, as
` `steady` says. A bound is typed once, however often the part is.
if count-bound(id)
    = true
. known = facts.node-type(instance, id)
. type = if known != no-type then known else infer(id)
if type == invalid-type || type == no-type || !is-integer-kind(types.intrinsic-of(type))
    = false
= !repeated || steady(id)

────────────────────
_ do steady Bool
    - id SyntaxId

` Whether an expression gives the same each time it is read without doing anything: a name, a
` literal, a constant such as the size of a type, a lazy local or a global, an integer cast to
` another, and one of two such picked by such a number or truth.
if is-quiet(id)
    = true
. plan = facts.plan-of(instance, id)
if plan == .plan-constant || plan == .plan-type-size
    = true
do match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, id)
        if resolution.kind == .resolve-global
            = true
        . slot = capture-slot(id)
        = slot != no-slot && bindings.slots[slot].kind == .slot-lazy
    | .node-cast-expression(row)
        . given = types.intrinsic-of(facts.node-type(instance, row.lhs))
        . made = types.intrinsic-of(facts.node-type(instance, id))
        = is-integer-kind(given) && is-integer-kind(made) && steady(row.lhs)
    | .node-binary-expression(row)
        if row.op == .if-op
            . test = types.intrinsic-of(facts.node-type(instance, row.rhs))
            = (is-integer-kind(test) || test == .bool) && steady(row.lhs) && steady(row.rhs)
        if row.op == .coalesce-op || row.op == .else-op
            = steady(row.lhs) && steady(row.rhs)
= false

────────────────────
_ always-passes Bool
    - id SyntaxId

` Whether a stream pattern always gives a value or raises: its last arm has no pattern, or
` raises.
match tree.nodes[id]
    | .node-stream-or(row)
        always-passes(row.right)
    | .node-stream-transform(row)
        row.pattern == 0 || always-passes(row.pattern)
    | .node-stream-panic
        true
    ??
        false

────────────────────
_ do mentions Bool
    - id SyntaxId
    - name String

` Whether a name is read anywhere in an expression, as the reference finds what an action
` refers to. An `it` read in the action of an arm written within the expression is that arm's
` own.
if id == 0
    = false
for node in tree.subtree-start(id) .. < id + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.name.text == name && (name != "it" || !in-inner-action(node, id))
                = true
= false

────────────────────
_ do in-inner-action Bool
    - node SyntaxId
    - id SyntaxId

` Whether a node lies in the action of an arm of a stream pattern written within an expression.
for outer in node + 1 .. < id
    do match? tree.nodes[outer]
        | .node-stream-transform(row)
            if row.right != 0 && tree.subtree-start(row.right) <= node && node <= row.right
                = true
= false

────────────────────
_ do infer-arms TypeId
    - id SyntaxId
    - pattern SyntaxId
    - want Want = Want()

` The type a match's arms give, joined, each arm checked against the subject. A match written
` as a statement is one for its own arms alone: a match written in one of them is an
` expression unless it is written as a statement too. Arms of conditions alone with no else,
` where a type is expected that is no optional, give an optional of it, as the reference's do,
` which whatever expects it converts. An integer an arm gives written with no suffix takes the
` type expected, or with none expected, the type of the first arm that gives one written with one.
. expected = arms-expected
arms-expected = no-type
. subject = matching.subject
. as-statement = want.asks(.want-match-statement)
. own-arming = arming
. arms-mark = scratch.types.mark
arming = Arming(as-statement, arms-mark, expected, false, arming.union, 0, is-alternative(pattern), no-slot, 0)
. narrow-mark = scratch.narrowings.mark
. first-arm = arm-bodies.length
. first-value = arm-values.length
. first-settled = arm-settled.length
. first-raised = raised-arms.length
if matching.arms != 0 && closes(matching.arms, id)
    check-arm-reach(pattern, subject, true)
. has-else = collect-arms(pattern, subject)
. possible = arming.possible
. unites = arming.unite && expected == no-type
. union-start = arming.union
arming = own-arming
if matching.closed != 0 && closes(matching.closed, id)
    check-coverage(id, pattern, subject)
frame.pop-narrowing(narrow-mark)
if as-statement && !matching.optional
    merge-arms(first-arm)
if as-statement && stays-present(first-arm)
    narrowing.narrow-condition(matching.case, true)
. own-settled [Narrowed]
for position in first-settled .. < arm-settled.length
    own-settled += arm-settled[position]
-= arm-settled[first-settled .. < arm-settled.length]
widen-settled(own-settled)
-= arm-bodies[first-arm .. < arm-bodies.length]
-= arm-present[first-arm .. < arm-present.length]
-= arm-starts[first-arm .. < arm-starts.length]
-= arm-ends[first-arm .. < arm-ends.length]
. closed = matching.closed != 0 && closes(matching.closed, id)
. absent = subject != no-type && !matching.optional && !matching.open && !closed && conditional
    .. conditional = is-conditional(pattern)
if absent && expected != no-type && !types.is-optional(expected)
    decline(id)
if !has-else && subject != no-type && !matching.optional && matching.open
    facts.set-plan(instance, id, .plan-open)
else if !has-else && absent
    facts.set-plan(instance, id, .plan-unmatched-absent)
else if !has-else && subject != no-type && !matching.optional
    instances.mark-may-panic(instance)
    facts.set-plan(instance, id, .plan-unmatched)
if subject != no-type && subject != invalid-type
    note-switch(pattern, subject)
. arms = scratch.types.since(arms-mark)
. values [SyntaxId]
for position in first-value .. < arm-values.length
    values += arm-values[position]
-= arm-values[first-value .. < arm-values.length]
. valued = values.length == arms.length
. typed [TypeId]
. peer = if !valued then no-type else if expected != no-type then expected-inner else written-peer
    .. expected-inner = types.optional-inner(expected)
    .. written-peer = arms-peer(arms, values)
for position in 0 .. < arms.length
    typed += if peer != no-type then conversions.adapted-literal(values[position], arms[position], peer) else arms[position]
. raises = gives-errors(arms, expected)
if raises && frame.surround.catch-depth == 0
    for position in first-raised .. < raised-arms.length
        facts.set-plan(instance, raised-arms[position], .plan-raise)
-= raised-arms[first-raised .. < raised-arms.length]
. errors [TypeId]
. mark = scratch.types.mark
. has-null = false
for arm in typed
    if arm == types.null-type
        has-null = true
    else if raises && raises-at-arm(arm, expected)
        if errors.find(arm) == null
            errors += arm
    else if arm != invalid-type
        scratch.types.push(arm)
if scratch.types.length == mark && has-null
    scratch.types.push(types.null-type)
if scratch.types.length == mark && possible == 0 && matching.optional && optional-expected
    scratch.types.push(expected)
.. optional-expected = expected != no-type && types.is-optional(expected)
if scratch.types.length == mark && errors.length != 0
    scratch.types.rewind(arms-mark)
    if frame.surround.catch-depth != 0
        . raised = scratch.types.mark
        for error in errors
            scratch.types.push(error)
        = result-type(types, types.void-type, raised)
    for error in errors
        note-outgoing(error, id)
    = types.void-type
if scratch.types.length == mark
    scratch.types.rewind(arms-mark)
    if possible == 0
        frame.diagnose(pattern, .no-possible-matches)
    = invalid-type
. joined = relations.join-arms(mark)
if unites
    . united = scratch.types.mark
    for position in union-start .. < mark
        . arm = scratch.types[position]
        if arm != types.null-type && arm != invalid-type
            scratch.types.push(arm)
    joined = types.intern-union(united)
scratch.types.rewind(mark)
. result = joined
if expected != no-type
    result = expected
    . missed = !has-else && subject == no-type && expected != types.void-type
    if missed && !types.is-optional(expected)
        result = types.optional-of(expected)
        facts.replace-node-type(instance, id, result)
    else
        facts.set-node-type(instance, id, joined)
else if null-joined || absent || (!has-else && subject == no-type)
    result = types.optional-of(joined)
.. null-joined = has-null && joined != types.null-type && !holds-null(joined)
. joins = !as-statement
for position in 0 .. < arms.length
    . arm = typed[position]
    if joins && arm != result && arm != invalid-type && !(raises && raises-at-arm(arm, expected))
        conversions.convert(id, if valued then values[position] else 0, arm, result, .reason-join)
scratch.types.rewind(arms-mark)
if raises && frame.surround.catch-depth != 0
    . raised = scratch.types.mark
    for error in errors
        scratch.types.push(error)
    = result-type(types, result, raised)
for error in errors
    note-outgoing(error, id)
= result

────────────────────
_ do literal-peer TypeId
    - types-start ScratchMark
    - syntax-start ScratchMark
    - count Size

` The type integers written with no suffix take among values joined: that of the first value
` written with none, what it holds where it is an optional, or where each is written with none,
` that of the first float, or where each is a tuple, the tuple they join to place by place. Where
` no value is written with one there is none.
. peer = no-type
. float = no-type
. places = no-type
. plain = false
for offset in 0 .. < count
    . syntax = scratch.syntax[syntax-start + offset]
    . type = scratch.types[types-start + offset]
    if conversions.literal-of(syntax) == 0
        if peer == no-type
            peer = types.optional-inner(type)
    else
        plain = true
        if float == no-type && tree.nodes[syntax] is .node-float-syntax
            float = type
        if tree.nodes[syntax] is .node-tuple-syntax
            places = if offset == 0 then type else if places != no-type then relations.joined-places(places, type) else no-type
        else
            places = no-type
|? !plain
    = no-type
|? peer != no-type
    = peer
|? float != no-type
    = float
??
    = places

────────────────────
_ do arms-peer TypeId
    - arms ImmutableArray'TypeId'ArenaBacking
    - values [SyntaxId]

` The type integers written with no suffix take among the values of a match's arms: that of the
` first arm that gives a value written with none other than a text, what it holds where it is an
` optional, or where each is written with none, that of the first that gives a float.
. float = no-type
for position in 0 .. < arms.length
    . arm = arms[position]
    if arm != types.null-type && arm != invalid-type && non-literal && !text
        = types.optional-inner(arm)
    .. non-literal = conversions.literal-of(values[position]) == 0
    .. text = types.optional-inner(arm) == types.string-type
    if float == no-type && values[position] != 0 && float-written
        float = arm
    .. float-written = tree.nodes[values[position]] is .node-float-syntax
= float

────────────────────
_ holds-null Bool
    - type TypeId

` Whether a type is a union with a case that holds `null`, which a `null` joined with it becomes.
types.intrinsic-of(type) == .union && relations.unnamed-case-holds(type, types.null-type)

────────────────────
_ do merge-arms
    - first Size

` After a match statement, a local every arm that falls through leaves holding the same value
` holds it: the arms agree, as the reference's flow facts merge them. Only an arm's own
` statements count.
. lead = Size.max
for arm in first .. < arm-bodies.length
    if lead == Size.max && !narrowing.exits(arm-bodies[arm])
        lead = arm
if lead == Size.max
    =
for position in arm-starts[lead] .. < arm-ends[lead]
    . slot = frame.assigned-slots[position]
    . settled = arm-settles(lead, slot)
    if settled == no-type || settled == slot-known(slot)
        continue
    . agreed = true
    for arm in first .. < arm-bodies.length
        if !narrowing.exits(arm-bodies[arm]) && arm-settles(arm, slot) != settled
            agreed = false
    if agreed
        frame.push-assigned(slot-key(slot), settled)

────────────────────
_ do stays-present Bool
    - first Size

if matching.case == 0
    = false
. reached = false
for arm in first .. < arm-bodies.length
    if !narrowing.exits(arm-bodies[arm])
        if !arm-present[arm]
            = false
        reached = true
= reached

────────────────────
_ do arm-settles TypeId
    - arm Size
    - slot SlotId

` What an arm's own statements last assign a local, or no type when they assign it nothing.
. settled = no-type
for position in arm-starts[arm] .. < arm-ends[arm]
    if frame.assigned-slots[position] == slot
        if is-direct-statement(arm-bodies[arm], frame.assigned-syntax[position])
            settled = frame.assigned-types[position]
= settled

────────────────────
_ is-raised Bool
    - arm TypeId

arm != invalid-type && arm != no-type && is-subtype(types, arm, types.error-type)

────────────────────
_ do raises-at-arm Bool
    - arm TypeId
    - expected TypeId

=? false if !is-raised(arm)
=? true if expected == no-type
. held = types.optional-inner(result-value(types, expected))
=? false if is-subtype(types, arm, held)
=? true if types.intrinsic-of(held) != .union
= all(types.cases-of(held)) • where !is-subtype(types, arm, each.type)

────────────────────
_ do gives-errors Bool
    - arms ImmutableArray'TypeId'ArenaBacking
    - expected TypeId

` Whether some arm gives an error the type the arms are expected to give does not hold: those
` errors then leave the function as errors, each at its arm, and the values alone are what the
` arms give, or nothing where every arm gives such an error.
for arm in arms
    if raises-at-arm(arm, expected)
        = true
= false

────────────────────
_ do closes Bool
    - body SyntaxId
    - arms SyntaxId

` Whether arms are the ones a match must cover its subject with: the body of the match, of a
` catch the body is, or a statement of a block the body is.
if body == arms
    = true
do match? tree.nodes[body]
    | .node-catch-expression(row)
        = closes(row.body, arms)
    | .node-block(row)
        for statement in tree.children[row.body]
            if closes(statement, arms)
                = true
= false

────────────────────
_ do check-coverage
    - id SyntaxId
    - pattern SyntaxId
    - subject TypeId

. coverage = Coverage(frame, this)
. gap = coverage.gap(pattern, subject)
if gap
    . site = if coverage.site != 0 then coverage.site else id
    frame.diagnose(site, .stated, program.store-atom(gap), subject)
    frame.mention(coverage.held)

────────────────────
_ do check-arm-reach Bool
    - pattern SyntaxId
    - subject TypeId
    - is-last Bool

do match? tree.nodes[pattern]
    | .node-type-or(row)
        = check-arm-reach(row.left, subject, false) || check-arm-reach(row.right, subject, is-last)
. armed = pattern
do match? tree.nodes[pattern]
    | .node-type-transform(row)
        armed = row.pattern
. shown = takes-all(armed)
if !shown
    = false
if armed != 0 && tree.nodes[armed] is .node-type-capture
    . bound = Coverage(frame, this).bound-case(armed, subject)
    if bound
        frame.diagnose(armed, .stated, program.store-atom(bound), subject)
        = true
if is-last
    = false
. site = if armed != 0 then armed else pattern
frame.diagnose
    - site
    - .stated
    - program.store-atom("Arm '$shown' takes every value, so the arms after it are never reached")
= true

────────────────────
_ do takes-all String?
    - pattern SyntaxId

if pattern == 0
    = "??"
do match? tree.nodes[pattern]
    | .node-type-wildcard
        = "| _"
    | .node-type-capture(row)
        . name = identifier-name(tree, row.id)
        if row.type == 0 && name
            = "| ${name.text}"
= null

────────────────────
_ do collect-arms Bool
    - id SyntaxId
    - subject TypeId

` Types the arms of a match, each alternative of an `or` in turn, and says whether one is the
` arm of what is left. An arm written `|?` with no body gives what its condition tested, forced,
` which the reference evaluates again: where the flow knows that by no key, the force takes the
` type the test gave, so what the condition calls is recorded once. An arm whose value is a case
` named by its symbol alone, where a type is expected of the match, gives the case of that type
` where it can (`armed-symbol`).
if id == 0
    = false
do match tree.nodes[id]
    | .node-type-or(row)
        . left = collect-arms(row.left, subject)
        if !fails-present(row.left) || untyped || !types.is-optional(subject)
            . right = collect-arms(row.right, subject)
            = left || right
        .. untyped = subject == no-type || subject == invalid-type
        facts.set-plan(instance, id, .plan-present-after)
        narrowing.narrow-condition(matching.case, true)
        arming = arming.present-depth = arming.present-depth + 1
        . present = collect-arms(row.right, types.optional-inner(subject))
        arming = arming.present-depth = arming.present-depth - 1
        = left || present
    | .node-type-transform(row)
        . is-else = pattern-is-else(row.pattern)
        . entered = frame.live-members()
        . unread SyntaxId = 0
        if arming.several && subject != no-type && subject != invalid-type
            unread = name-read(row.pattern)
        if unread != 0
            frame.diagnose(unread, .stated, program.store-atom("Type not found"))
            facts.set-plan(instance, id, .plan-never)
            = false
        if !is-else && !pattern-possible(row.pattern, subject)
            facts.set-plan(instance, id, .plan-never)
            = false
        arming = arming.possible = arming.possible + 1
        . subject-slot = arm-slot(id, .slot-it)
        if subject-slot != no-slot && subject != no-type && subject != invalid-type
            frame.assign(subject-slot, subject)
            carry-subject(subject-slot)
        . own-arm = arm-typing
        arm-typing = arm-typing.it = subject-slot
        check-pattern(row.pattern, subject)
        arm-typing = own-arm
        if subject-slot != no-slot && subject != no-type && subject != invalid-type
            . passed = passed-type(row.pattern, subject)
            if passed != subject
                frame.assign(subject-slot, passed)
        . predicate = predicate-expr(row.pattern)
        . mark = scratch.narrowings.mark
        narrowing.narrow-condition(predicate, true)
        if predicate != 0 && subject == no-type
            . it-slot = arm-slot(id, .slot-it)
            . it-type = facts.node-type(instance, predicate)
            do match? tree.nodes[predicate]
                | .node-identifier
                    . resolution = bindings.resolution-of(frame.binding, predicate)
                    if resolution.kind == .resolve-slot
                        it-type = frame.slot-type(resolution.slot)
            if it-slot != no-slot && it-type != no-type
                frame.assign(it-slot, it-type)
        . value = no-type
        . symbol = symbol-of(row.expr)
        . assigned-start = frame.assigned-syntax.length
        if symbol && arming.expected == no-type
            value = arm-symbol(row.expr, symbol)
        . diagnosed = facts.diagnostics.length
        . known = frame.save-members()
        if value == no-type
            . own-arm = arm-typing
            arm-typing = arm-typing.forced = if predicate != 0 && narrowing.condition-slot(predicate) == null then predicate else 0
            arm-typing = arm-typing.symbol = if arming.expected != no-type then arm-value(row.expr) else 0
            if passes-expected(row.expr)
                note-returned-match(arm-value(row.expr), arming.expected)
                arms-expected = arming.expected
            value = check-statement(row.expr)
            arm-typing = own-arm
        if narrowing.exits(row.expr)
            frame.restore-members(known)
        else if known.narrowed && !frame.members-narrowed
            frame.keep-members(entered)
        . silent = row.expr != 0 && facts.diagnostics.length == diagnosed
        if silent && !arming.statement && lacks-value(row.expr, value) && !matches-row(subject)
            frame.diagnose(row.expr, .stated, program.store-atom("Match arm gives no value"))
        arm-bodies += row.expr
        arm-present += arming.present-depth != 0
        arm-starts += assigned-start
        arm-ends += frame.assigned-syntax.length
        if !narrowing.exits(row.expr)
            for settled in frame.assigned-since(mark)
                arm-settled += settled
        frame.pop-narrowing(mark)
        narrowing.narrow-condition(predicate, false)
        if value != no-type
            if row.is-union && !arming.unite
                arming = arming.unite = true
                arming = arming.union = scratch.types.mark
            scratch.types.push(value)
            arm-values += arm-value(row.expr)
        if raises-at-arm(value, arming.expected)
            raised-arms += id
        = is-else
    | .node-type-panic(row)
        = collect-panic(row.pattern, subject)
    ??
        . is-else = pattern-is-else(id)
        if !is-else && !pattern-possible(id, subject)
            facts.set-plan(instance, id, .plan-never)
            = false
        arming = arming.possible = arming.possible + 1
        check-pattern(id, subject)
        . value = pattern-value(id, subject)
        if value != no-type && value != invalid-type
            scratch.types.push(value)
            arm-values += 0
        = is-else

────────────────────
_ do passes-expected Bool
    - body SyntaxId

` Whether the value of an arm is a match that nothing in the arm runs before, which is of the
` type the arms are expected to give as a returned match is, so that its own arms convert to it.
. value = arm-value(body)
=? false if arming.expected == no-type || arming.expected == types.void-type || !is-match-syntax(value)
=? false if may-miss(value, arming.expected)
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            =? true if statement == value
            do match? tree.nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            =? false if !is-comment-syntax(tree, statement)
= true

────────────────────
_ is-conditional Bool
    - pattern SyntaxId

` Whether arms may match nothing, as the reference asks it of a match written on one line: its
` last arm has a pattern.
match tree.nodes[pattern]
    | .node-type-or(row)
        is-conditional(row.right)
    | .node-type-transform(row)
        row.pattern != 0 && is-conditional(row.pattern)
    | .node-type-panic(row)
        is-conditional(row.pattern)
    ??
        true

────────────────────
_ do arm-value SyntaxId
    - body SyntaxId

` The node that gives the body of an arm its value: the body, or of a block the last statement
` that runs where it stands, or none where there is none.
do match? tree.nodes[body]
    | .node-block(block)
        . last SyntaxId = 0
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            if !is-declaration-syntax(tree, statement) && !is-comment-syntax(tree, statement)
                last = statement
        = last
= body

────────────────────
_ lacks-value Bool
    - body SyntaxId
    - value TypeId

` The body of an arm gives the match its value or leaves the function itself. One that ends in
` a match whose every arm leaves does neither: that match is an expression with no value.
|? narrowing.exits(body, true)
    false
??
    value == no-type || (value == invalid-type && narrowing.exits(body))

────────────────────
_ matches-row Bool
    - subject TypeId

` Whether a match is on a row of a table of unions, whose arms may run for their effect alone.
|? subject == no-type || subject == invalid-type
    false
??
    calls.union-row(subject) != no-type

────────────────────
_ do carry-subject
    - slot SlotId

` The subject of a match is one value under the `it` of each arm. What the arms before left
` known of it, by a condition that did not hold, is known of it in the arm that follows.
if arming.it != no-slot && arming.it != slot
    . carried = frame.narrowed-slot(arming.it)
    if carried != no-type
        frame.push-narrowing(slot-key(slot), carried, frame.narrowed-cases(slot-key(arming.it)))
arming = arming.it = slot

────────────────────
_ do collect-panic Bool
    - id SyntaxId
    - subject TypeId

do match? tree.nodes[id]
    | .node-type-transform(row)
        . is-else = pattern-is-else(row.pattern)
        check-pattern(row.pattern, subject)
        . predicate = predicate-expr(row.pattern)
        check-assertion(id, row.expr, 0)
        narrowing.narrow-condition(predicate, false)
        = is-else
= false

────────────────────
_ do arm-slot SlotId
    - arm SyntaxId
    - kind SlotKind

. bound = bindings.bindings[frame.binding]
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    . row = bindings.slots[slot]
    if row.kind == kind && row.syntax == arm
        = slot
= no-slot

────────────────────
_ predicate-expr SyntaxId
    - pattern SyntaxId

|? pattern == 0
    0
??
    match tree.nodes[pattern]
        | .node-type-predicate(row)
            row.expr
        ??
            0

────────────────────
_ fails-present Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-or(row)
        fails-present(row.left) || fails-present(row.right)
    | .node-type-transform(row)
        row.pattern != 0 && fails-present(row.pattern)
    | .node-type-equality(row)
        narrowing.is-null-syntax(row.expr)
    ??
        false

────────────────────
_ pattern-is-else Bool
    - pattern SyntaxId

|? pattern == 0
    true
??
    match tree.nodes[pattern]
        | .node-type-wildcard
            true
        ??
            false

────────────────────
_ do check-pattern
    - pattern SyntaxId
    - subject TypeId

if pattern == 0
    =
do match tree.nodes[pattern]
    | .node-type-predicate(row)
        check-predicate(pattern, row.expr, subject)
    | .node-type-equality(row)
        plan-equality(pattern, subject, row.expr, infer-comparand(row.expr, subject))
    | .node-type-and(row)
        if subject == types.string-type && check-text-pattern(pattern)
            =
        check-pattern(row.left, subject)
        if reads-name(row.left)
            check-pattern(row.right, passed-type(row.left, subject))
        else
            check-pattern(row.right, pattern-type(row.left, subject))
    | .node-type-or(row)
        check-alternative(row.left, subject)
        . left-slots [SlotId]
        . left-types [TypeId]
        alternative-slots(row.left, left-slots)
        for slot in left-slots
            left-types += frame.known(slot)
        check-alternative(row.right, subject)
        . right-slots [SlotId]
        alternative-slots(row.right, right-slots)
        check-alternative-names(row.left, left-slots, left-types, row.right, right-slots)
    | .node-type-panic(row)
        check-pattern(row.pattern, subject)
    | .node-type-arguments
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-type-optional
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-type-list(row)
        if is-collection-type(tree, pattern)
            plan-type-pattern(pattern, subject, no-type, .similar)
        else
            check-list-pattern(pattern, row.patterns, subject)
    | .node-type-map(row)
        if is-collection-type(tree, pattern)
            plan-type-pattern(pattern, subject, no-type, .similar)
        else
            check-map-pattern(pattern, row.patterns, subject)
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            check-pattern(row.type, subject)
            . named = declaring-slot(pattern)
            if named && subject != no-type && subject != invalid-type
                frame.assign(named, passed-type(row.type, subject))
            =
        . captured = subject
        if row.type != 0
            . annotation = types.evaluate-type(module, tree, row.type, frame.env)
            if annotation != invalid-type
                captured = completed-capture(annotation, subject)
            else if names-type(tree, row.type) || is-collection-type(tree, row.type)
                report-missing-type(row.type, frame.env)
        . slot = declaring-slot(pattern)
        if slot && captured != no-type
            frame.assign(slot, captured)
            if cursor-binding.binds
                row-cursors += RowCursor(slot, cursor-binding.capture)
        if row.type != 0 && (names-type(tree, row.type) || is-collection-type(tree, row.type))
            plan-capture(row.type, subject, captured)
        else if matches-named(row.type)
            check-pattern(row.type, subject)
        else
            check-pattern(row.type, captured)
    | .node-type-match(row)
        if names-type(tree, row.type)
            plan-type-pattern(row.type, subject, no-type, required-match(row.op))
        else
            check-pattern(row.type, subject)
    | .node-type-tuple(row)
        . whole = held-subject(subject)
        . position = 0u32
        . saved-cursor = cursor-binding
        cursor-binding = cursor-binding.binds = false
        for field in tree.children[row.field-types]
            . part = if whole != no-type then field-of(whole, position) else no-type
            check-pattern(field, part)
            position += 1
        cursor-binding = saved-cursor
    | .node-type-wildcard
        =
    | .node-type-identifier
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-identifier
        . slot = declaring-slot(pattern)
        if slot && subject != no-type
            frame.assign(slot, subject)
            if cursor-binding.binds
                row-cursors += RowCursor(slot, cursor-binding.capture)
    | .node-type-remainder(row)
        check-pattern(row.name, subject)
    | .node-type-property(row)
        if subject != no-type && subject != invalid-type
            . read = read-property(pattern, pattern, subject, row.name).type
            if read != invalid-type
                facts.set-node-type(instance, pattern, read)
            . slot = declaring-slot(pattern)
            if slot
                frame.assign(slot, read)
    | .node-type-case(row)
        . case-type = subject
        if row.type != 0
            case-type = types.evaluate-type(module, tree, row.type, frame.env)
        . given = subject
        if given != no-type && given != invalid-type && types.is-optional(given)
            given = types.optional-inner(given)
        if given != no-type && given != invalid-type && types.intrinsic-of(given) == .union
            if row.type == 0 || case-type == given
                note-case(pattern, given, row.name)
            else if names-case(given, row.name)
                decline(pattern)
        else if given != no-type && given != invalid-type && (row.type == 0 || case-type == given)
            . given-kind = types.intrinsic-of(given)
            if given-kind == .table-row || given-kind == .immutable-table-row
                note-case(pattern, row-struct-of(given), row.name)
            else if row.type == 0 && names-nothing-case(pattern, row.name, given)
                missing-case(pattern, row.name, given)
                =
        . payload = case-payload(if row.type == 0 then given else case-type, row.name)
        . refined = no-type
        . known = given != no-type && given != invalid-type
        if row.type == 0 && known && !names-case(given, row.name)
            refined = refined-payload(given, row.name)
        if refined == invalid-type && row.value != 0
            decline(pattern)
        if refined != no-type
            facts.set-plan(instance, pattern, .plan-refined-case)
            payload = if refined-holds then refined else no-type
                .. refined-holds = refined != types.void-type && refined != invalid-type
        . case-kind = if case-type != no-type then case-intrinsic else IntrinsicKind.none
            .. case-intrinsic = types.intrinsic-of(case-type)
        . is-row = case-kind == .table-row || case-kind == .immutable-table-row
        . planned = facts.plan-of(instance, pattern)
        if known && !is-row && planned != .plan-case && refined == no-type
            facts.set-plan(instance, pattern, .plan-never)
        . saved-cursor = cursor-binding
        cursor-binding = cursor-binding.binds = is-row
        if is-row
            . validated = immutable-row || (matching.rows && case-type == matching.subject)
                .. immutable-row = case-kind == .immutable-table-row
            cursor-binding = cursor-binding.capture = RowCapture
                - case-type
                - case-number(row-struct-of(case-type), row.name)
                - validated
        check-case-value(row.value, payload)
        cursor-binding = saved-cursor
    ??
        instances.mark-may-panic(instance)
        decline(pattern)

────────────────────
_ reads-name Bool
    - pattern SyntaxId

` Whether a pattern passes on what a name read from its subject gives: one that reads a
` name, one joined after it, or a name that captures either.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-and(row)
        reads-name(row.left)
    | .node-type-capture(row)
        row.type != 0 && reads-name(row.type)
    ??
        false

────────────────────
_ is-alternative Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-or
        true
    ??
        false

────────────────────
_ name-read SyntaxId
    - pattern SyntaxId

` The pattern that reads a name from its subject in the pattern of an arm, or none. Where a
` match has several arms the reference asks of each whether it could match, and of such a
` pattern it has no answer: it looks for a type of that name.
|? pattern == 0
    0
??
    match tree.nodes[pattern]
        | .node-type-property
            pattern
        | .node-type-and(row)
            if name-read(row.left) != 0 then name-read(row.left) else name-read(row.right)
        | .node-type-capture(row)
            name-read(row.type)
        | .node-type-match(row)
            name-read(row.type)
        ??
            0

────────────────────
_ do check-predicate
    - pattern SyntaxId
    - expr SyntaxId
    - subject TypeId

` A pattern that is a condition. While the condition is typed, `it` is what the pattern is
` given: the pattern's own `it`, or the one of the arm it is written in, which holds what it
` did again after. The condition is tested as any other is.
. slot = arm-slot(pattern, .slot-it)
. is-shared = slot == no-slot && arm-typing.it != no-slot
if is-shared
    slot = arm-typing.it
else if slot == no-slot
    slot = it-read(expr)
    is-shared = slot != no-slot
. is-given = slot != no-slot && subject != no-type && subject != invalid-type
. held = if is-given && is-shared then frame.slot-type(slot) else no-type
if is-given
    frame.assign(slot, subject)
note-truthiness(expr, expr, infer(expr))
if held != no-type && held != invalid-type && held != subject
    frame.assign(slot, held)

────────────────────
_ do check-alternative
    - pattern SyntaxId
    - subject TypeId

if tree.nodes[pattern] is not .node-type-or && !pattern-possible(pattern, subject)
    facts.set-plan(instance, pattern, .plan-never)
    =
check-pattern(pattern, subject)

────────────────────
_ do alternative-slots
    - pattern SyntaxId
    - slots [SlotId]

` The locals an alternative of a pattern binds, each once.
for id in tree.subtree-start(pattern) .. pattern
    . resolution = bindings.resolution-of(frame.binding, id)
    . declares = (resolution.flags /and/ ResolutionFlag.resolution-declares) != 0
    if resolution.kind == .resolve-slot && declares && slots.find(resolution.slot) == null
        slots += resolution.slot

────────────────────
_ do check-alternative-names
    - left SyntaxId
    - left-slots [SlotId]
    - left-types [TypeId]
    - right SyntaxId
    - right-slots [SlotId]

` The alternatives of `| a | b` bind the same names, each of one type, since the arm reads the
` names whichever alternative matched.
for position in 0 .. < left-slots.length
    . slot = left-slots[position]
    . name = bindings.slots[slot].name.text
    if right-slots.find(slot) == null
        frame.diagnose(right, .stated, program.store-atom("\"$name\" is bound by the alternative before this one but not by this one; bind it in each alternative"))
        =
    . before = left-types[position]
    . after = frame.known(slot)
    if known-type(before) && known-type(after) && before != after
        . text = "\"$name\" is ${type-source(types, before)} in one alternative and ${type-source(types, after)} in another; bind it to one type in each"
        frame.diagnose(right, .stated, program.store-atom(text))
        =
for slot in right-slots
    if left-slots.find(slot) == null
        . name = bindings.slots[slot].name.text
        frame.diagnose(left, .stated, program.store-atom("\"$name\" is bound by the alternative after this one but not by this one; bind it in each alternative"))
        =

────────────────────
_ known-type Bool
    - type TypeId

type != no-type && type != invalid-type

────────────────────
_ do it-read SlotId
    - expr SyntaxId

` The slot a condition reads `it` through where its pattern declares none and no arm has
` one: that of an earlier pattern of the same block.
for id in tree.subtree-start(expr) .. expr
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, id)
            if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-it
                = resolution.slot
= no-slot

────────────────────
_ do plan-equality
    - pattern SyntaxId
    - subject TypeId
    - expr SyntaxId
    - value TypeId

` Plans an equality pattern as `==` of its subject and its value, at the pattern's node,
` which stands for the subject as the left operand and has the type of the answer. A subject
` compared with `null` is asked whether it holds nothing.
if subject == no-type || subject == invalid-type || value == no-type || value == invalid-type
    =
if narrowing.is-null-syntax(expr) && types.is-optional(subject)
    facts.set-plan(instance, pattern, .plan-absent)
    facts.set-node-type(instance, pattern, types.bool-type)
    =
. answer = infer-binary-values(pattern, .equals-op, pattern, subject, expr, value)
if answer != invalid-type && answer != no-type
    facts.set-node-type(instance, pattern, answer)

────────────────────
_ do plan-capture
    - pattern SyntaxId
    - subject TypeId
    - captured TypeId

` A name declared with a type in a pattern holds what the type passes. An optional given to
` one declared an optional is captured whole where it converts, with no test.
if subject == no-type || subject == invalid-type || captured == no-type || captured == invalid-type
    =
if types.is-optional(subject) && types.is-optional(captured)
    . whole = relations.compare(subject, captured, false, false, null, module)
    if relations.holds-as(whole, .similar)
        conversions.record-pattern(pattern, whole, U32.max)
        =
plan-type-pattern(pattern, subject, captured, .similar)

────────────────────
_ do plan-type-pattern
    - pattern SyntaxId
    - subject TypeId
    - named TypeId
    - kind Specificity

` Records at a type named as a pattern what it does to the subject it is given, as the
` reference matches it: an optional as what it holds, and a union whole where it converts
` whole, else by each of its cases that converts. `named` is the type where the pattern's
` own syntax leaves some of it to the subject.
if subject == no-type || subject == invalid-type
    =
. target = named
if target == no-type
    target = types.evaluate-type(module, tree, pattern, frame.env)
    if target == invalid-type
        report-missing-type(pattern, frame.env)
if target == invalid-type || target == no-type
    =
if types.completions[target].has-variables
    target = complete-named(target, subject, kind)
    if target == no-type
        facts.set-plan(instance, pattern, .plan-never)
        =
plan-leaves(pattern, subject, target, kind, U32.max)
plan-exact(pattern, kind)

────────────────────
_ do plan-exact
    - pattern SyntaxId
    - kind Specificity

if kind == .exact && facts.plan-of(instance, pattern) != .plan-never
    facts.set-plan(instance, pattern, .plan-exact-class)

────────────────────
_ do plan-leaves
    - pattern SyntaxId
    - held TypeId
    - target TypeId
    - kind Specificity
    - guard U32

. intrinsic = types.intrinsic-of(held)
if intrinsic == .optional
    plan-leaves(pattern, types.optional-inner(held), target, kind, guard)
    =
. whole = relations.compare-pattern(held, target, module)
if relations.holds-as(whole, kind)
    conversions.record-pattern(pattern, whole, guard)
    =
if intrinsic != .union
    =
if guard != U32.max
    conversions.record-pattern(pattern, whole, guard)
    =
. cases = types.cases-of(held)
for index in 0 .. < cases.length
    . fact = cases[index]
    if fact.type == no-type || fact.type == invalid-type
        continue
    if relations.holds-as(relations.compare-pattern(fact.type, target, module), kind)
        plan-leaves(pattern, fact.type, target, kind, index as U32)

────────────────────
_ held-subject TypeId
    - subject TypeId

` What fields in parentheses are matched against: what an optional holds, which is tested for
` first, as TypeScript matches any pattern, or else the subject.
if plain-subject then subject else types.optional-inner(subject)

.. plain-subject = subject == no-type || subject == invalid-type || !types.is-optional(subject)

────────────────────
_ do passed-type TypeId
    - pattern SyntaxId
    - subject TypeId

` The type of what a pattern passes on where it matches, which `it` is in the body of its
` arm: the type a type named gives, also one of a list or a map written in brackets, for a case
` named what the pattern written for what it holds passes or else the union, for fields in
` parentheses what an optional holds, and else the subject. The sides of an alternative may
` pass different types: the subject stands for them.
if pattern == 0 || subject == no-type || subject == invalid-type
    = subject
do match? tree.nodes[pattern]
    | .node-type-tuple
        = held-subject(subject)
    | .node-type-case(row)
        . given = if types.is-optional(subject) then types.optional-inner(subject) else subject
        if row.value == 0
            = given
        . owner = given
        if row.type != 0
            owner = types.evaluate-type(module, tree, row.type, frame.env)
        . payload = case-payload(owner, row.name)
        if payload == no-type || payload == invalid-type
            = subject
        . part = row.value
        do match? tree.nodes[row.value]
            | .node-type-tuple(fields)
                if fields.field-types.count == 1 && types.intrinsic-of(payload) != .tuple
                    part = tree.children[fields.field-types][0]
        = passed-type(part, payload)
    | .node-type-identifier
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if concrete-name then named else subject
            .. concrete-name = named != invalid-type && !types.completions[named].has-variables
    | .node-type-arguments
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if concrete-arguments then named else subject
            .. concrete-arguments = named != invalid-type && !types.completions[named].has-variables
    | .node-type-optional
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if concrete-optional then named else subject
            .. concrete-optional = named != invalid-type && !types.completions[named].has-variables
    | .node-type-list
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if concrete-list then named else subject
                .. concrete-list = named != invalid-type && !types.completions[named].has-variables
    | .node-type-map
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if concrete-map then named else subject
                .. concrete-map = named != invalid-type && !types.completions[named].has-variables
    | .node-type-match(row)
        = passed-type(row.type, subject)
    | .node-type-and(row)
        = passed-type(row.right, passed-type(row.left, subject))
    | .node-type-property
        . read = facts.node-type(instance, pattern)
        = if read != no-type then read else subject
    | .node-type-panic(row)
        = passed-type(row.pattern, subject)
    | .node-type-capture(row)
        if row.type == 0
            = subject
        . slot = declaring-slot(pattern)
        if slot
            . captured = frame.slot-type(slot)
            if captured != no-type && captured != invalid-type
                = captured
        = passed-type(row.type, subject)
= subject

────────────────────
_ do pattern-possible Bool
    - pattern SyntaxId
    - subject TypeId
    - inside Bool = false

` Whether a pattern could match a subject of this type at all. The reference compiles no arm
` whose pattern cannot, and a match none of whose arms can is an error. `inside` says the
` pattern is a field of one that takes a tuple apart.
if pattern == 0 || subject == no-type || subject == invalid-type
    = true
do match? tree.nodes[pattern]
    | .node-type-identifier
        = type-possible(pattern, subject, .similar)
    | .node-type-arguments
        = type-possible(pattern, subject, .similar)
    | .node-type-match(row)
        = type-possible(row.type, subject, required-match(row.op))
    | .node-type-or(row)
        = pattern-possible(row.left, subject, inside) || pattern-possible(row.right, subject, inside)
    | .node-type-and(row)
        if !pattern-possible(row.left, subject, inside)
            = false
        . passed = if reads-name(row.left) then passed-type(row.left, subject) else pattern-type(row.left, subject)
        = pattern-possible(row.right, passed, inside)
    | .node-type-capture(row)
        = pattern-possible(row.type, subject, inside)
    | .node-type-case(row)
        = case-possible(pattern, row.type, row.name, subject, inside)
    | .node-type-tuple(row)
        = tuple-possible(row.field-types, subject)
    | .node-type-property(row)
        = answers(subject, row.name)
    | .node-type-list(row)
        if is-collection-type(tree, pattern)
            = type-possible(pattern, subject, .similar)
        . held = sequence-case(subject)
        if held == no-type
            = false
        if held == invalid-type
            = true
        . item = iterable-item(held, types.indexable-decl)
        for element in tree.children[row.patterns]
            do match tree.nodes[element]
                | .node-type-remainder
                    continue
                ??
                    if !pattern-possible(element, item)
                        = false
    | .node-type-map(row)
        if is-collection-type(tree, pattern)
            = type-possible(pattern, subject, .similar)
        . held = structured-case(subject, types.map-decl)
        . map = types.ancestor-of(held, types.map-decl)
        if map == no-type
            = false
        for element in tree.children[row.patterns]
            do match? tree.nodes[element]
                | .node-type-map-item(item)
                    if !pattern-possible(item.value, class-arg(types, map, 1))
                        = false
= true

────────────────────
_ do tuple-possible Bool
    - fields RowRange'SyntaxId
    - subject TypeId

` Whether a pattern that takes a tuple apart could match a subject: one that could be a
` tuple, and where it is one of as many fields, each field's pattern could match its field.
if !destructures-some(subject)
    = false
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) == .union || !destructures(held, fields.count)
    = true
. position = 0u32
for field in tree.children[fields]
    if !pattern-possible(field, field-of(held, position), true)
        = false
    position += 1
= true

────────────────────
_ do missing-case
    - pattern SyntaxId
    - name Atom
    - subject TypeId

` Reports a case a pattern names that no type has, where it tests a value of a union, which is
` named with its cases, or of a type with none.
if subject == no-type || subject == invalid-type
    frame.diagnose(pattern, .stated, program.store-atom("Type not found"))
    =
. shown = type-short-name(types, subject)
. message = if types.intrinsic-of(subject) == .union then "Case \".${name.text}\" not found in $shown" else "Case \".${name.text}\" not found: $shown has no cases"
frame.diagnose(pattern, .stated, program.store-atom(message))

────────────────────
_ do names-nothing-case Bool
    - pattern SyntaxId
    - name Atom
    - subject TypeId

` Whether a pattern names a case by its name alone that neither a value of the subject's enum
` nor any type the pattern could mean has.
if names-enum-value(pattern, 0, name, subject)
    = false
= anonymous-symbol(pattern, name) == no-type && symbol-class(types, module, name) == invalid-type

────────────────────
_ do case-possible Bool
    - pattern SyntaxId
    - type SyntaxId
    - name Atom
    - subject TypeId
    - inside Bool

` Whether a pattern that names a case could match a subject: one that is a union with a case
` of that name, an optional of one, or a row. The reference compiles the arm of no other,
` and where the pattern names no type and no type it could mean has a case or a value of
` the name, it reports that. As a field of a tuple the pattern keeps its arm also where the
` type it means is the field's, or what a case of the field holds: it matches nothing there.
. given = if types.is-optional(subject) then types.optional-inner(subject) else subject
. kind = types.intrinsic-of(given)
if kind == .table-row || kind == .immutable-table-row || names-case(given, name)
    = true
if kind == .union && refined-payload(given, name) != no-type
    = true
if names-enum-value(pattern, type, name, given)
    = true
. meant = no-type
if type != 0
    meant = types.evaluate-type(module, tree, type, frame.env)
else
    meant = anonymous-symbol(pattern, name)
    if meant == no-type
        meant = symbol-class(types, module, name)
        if meant == invalid-type
            missing-case(pattern, name, given)
if meant == no-type || meant == invalid-type || !inside
    = false
if meant == given
    = true
if kind == .union
    for fact in types.cases-of(given)
        if fact.type == meant || names-case(fact.type, name)
            = true
= false

────────────────────
_ do refined-payload TypeId
    - union TypeId
    - name Atom

` What a case holds that a refinement of the machine of a property of a class adds, where the
` machine's union is a type and the case is of a name, as the refinement's own union holds it:
` `Void` for nothing, or its values. Refinements typed so far are found, and else those of the property the
` subject reads for the class of the object it reads it from (`case-owner-of`), or of the
` machine's property for the class the function, or one it is written in, is typed for
` (`enclosing-self`), as the reference finds them, and
` the refinement being typed as it is written (`writing-payload`). No type where none adds the
` case.
. root = refined-root(union)
. found = if root then refining-payload(root, name) else no-type
if found != no-type
    = found
. owner = case-owner-of(matching.case)
. receiver = if owner != no-type then owner else enclosing-self()
. property = decl-property-name(root.module, root.decl) if root
if owner != no-type
    property = subject-property(matching.case)
. classed = receiver != no-type && types.intrinsic-of(receiver) == .class
. place = types.property-named(receiver, property) if property && classed
if !place
    = no-type
. ref = class-ref(types, types.properties[place].owner)
. declared = class-property(ref, property!)
if declared == 0
    = no-type
. unit = instances.intern-initializer(ref.module, declared, holding-type(receiver, ref))
if instances.rows[unit].state == .instance-in-progress
    = writing-payload(receiver, property!, name)
demand-body(unit)
. typed = refined-root(union)
= if typed then refining-payload(typed, name) else no-type

────────────────────
_ do enclosing-self TypeId

` The class the function is typed for, or the nearest function it is written in is, or none.
. current = instance
while current != no-instance
    if instances.rows[current].self-type != no-type
        = instances.rows[current].self-type
    current = instances.rows[current].enclosing
= no-type

────────────────────
_ do writing-payload TypeId
    - receiver TypeId
    - property Atom
    - name Atom

` What a case of a name holds that a machine of a property of a name writes, of a class a
` receiver is or derives from, while those machines are typed for it: `Void` for a case written
` with no values, and invalid where what it holds is not typed yet; no type where none writes
` such a case.
. current = receiver
while current != no-type
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    . declared = if level.module != 0 || level.decl != 0 then class-property(level, property) else 0
    if declared == 0
        continue
    . owner-tree = program.modules[level.module].tree
    do match? program.modules[level.module].decls[declared]
        | .decl-property(found)
            . machine = owner-tree.declared-machine(found.value)
            . items = if machine != 0 then machine-states else List'SyntaxId()
                .. machine-states = owner-tree.state-items(owner-tree.state-body(machine))
            . node = if machine != 0 then owner-tree.find-case(items, name) else 0
            if node != 0
                = if targetless then types.void-type else invalid-type
                    .. targetless = owner-tree.state-targets(node).count == 0
= no-type

────────────────────
_ do case-owner-of TypeId
    - subject SyntaxId

` The class of the object a subject reads a property from, as the reference finds the object a
` state machine's union is read from: the type of the object written before the property's
` name, or none.
if subject == 0
    = no-type
do match? tree.nodes[subject]
    | .node-get-expression(row)
        . held = facts.node-type(instance, row.object)
        . inner = if types.is-optional(held) then types.optional-inner(held) else held
        if inner != no-type && inner != invalid-type && types.intrinsic-of(inner) == .class
            = inner
= no-type

────────────────────
_ do subject-property Atom?
    - subject SyntaxId

` The name of the property a subject reads from an object, or none.
do match? tree.nodes[subject]
    | .node-get-expression(row)
        = row.name
= null

────────────────────
_ do refined-root MachineFact?
    - union TypeId

` The machine of a property of a class whose union a type is, and that refines none.
for machine in facts.machines
    . member = machine.store == .store-member && machine.outer == 0
    if machine.union == union && member && machine.refined == no-instance
        = machine
= null

────────────────────
_ do refining-payload TypeId
    - root MachineFact
    - name Atom

` What a case of a name holds that a refinement typed so far of a machine adds, `Void` where it
` holds nothing, or no type.
for machine in facts.machines
    if machine.refined == no-instance || machine.outer != 0 || !names-case(machine.union, name)
        continue
    . above = facts.root-machine(machine)
    if above.module == root.module && above.syntax == root.syntax
        . held = case-payload(machine.union, name)
        = if held != no-type then held else types.void-type
= no-type

────────────────────
_ do decl-property-name Atom?
    - owner ModuleId
    - property DeclId

` The name of a property a module declares.
do match? program.modules[owner].decls[property]
    | .decl-property(row)
        = row.name
= null

────────────────────
_ do names-enum-value Bool
    - pattern SyntaxId
    - type SyntaxId
    - name Atom
    - subject TypeId

` Whether a pattern that names a case names a value of a whole number type instead, written
` alone or with that type. It is an error the reference reports at the pattern, wherever the
` pattern is, so the arm is kept for it.
if !types.completions[subject].has-enums || !is-integer-kind(types.intrinsic-of(subject))
    = false
if !enum-case-decl(types, program, subject, name)
    = false
if type != 0 && types.evaluate-type(module, tree, type, frame.env) != subject
    = false
. shown = type-short-name(types, subject)
. member = "${if type != 0 then shown else ""}.${name.text}"
. message = "$shown.${name.text} is an enum value, not a union case; match it with '|= $member'"
frame.diagnose(pattern, .stated, program.store-atom(message))
= true

────────────────────
_ do names-case Bool
    - type TypeId
    - name Atom

` Whether a type is a union with a case of a name.
if type == no-type || type == invalid-type || types.intrinsic-of(type) != .union
    = false
for fact in types.cases-of(type)
    if fact.name && fact.name! == name
        = true
= false

────────────────────
_ type-possible Bool
    - pattern SyntaxId
    - subject TypeId
    - kind Specificity

|? target == invalid-type
    true
??
    could-match(subject, target, kind)

.. target = types.evaluate-type(module, tree, pattern, frame.env)

────────────────────
_ do destructures-some Bool
    - subject TypeId

` Whether a value of the subject's type could be a tuple a pattern takes apart.
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = tuple-arity(held) != U32.max
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type && tuple-arity(fact.type) != U32.max
        = true
= false

────────────────────
_ do pattern-value TypeId
    - pattern SyntaxId
    - subject TypeId

` What an arm with no body gives: the subject as its pattern matched it. Of patterns written
` one after another it is what the last type named among them made of it. A case named with
` nothing written for what it holds gives the union, what an optional holds.
do match? tree.nodes[pattern]
    | .node-type-and(row)
        if names-type(tree, row.right) || matches-named(row.right)
            = pattern-type(row.right, subject)
        = pattern-value(row.left, subject)
    | .node-type-match(row)
        = pattern-value(row.type, subject)
    | .node-type-capture(row)
        = if row.type != 0 then pattern-value(row.type, subject) else subject
    | .node-type-case(row)
        if row.value == 0
            = if subject != no-type && types.is-optional(subject) then inner-subject else subject
                .. inner-subject = types.optional-inner(subject)
        . owner = subject
        if row.type != 0
            owner = types.evaluate-type(module, tree, row.type, frame.env)
        . payload = case-payload(owner, row.name)
        = if payload != no-type then payload else subject
    | .node-type-predicate
        = subject
. optional = subject != no-type && types.is-optional(subject)
= pattern-type(pattern, if optional then types.optional-inner(subject) else subject)

────────────────────
_ do completed-capture TypeId
    - annotation TypeId
    - subject TypeId

` A capture that names a generic type without its parameters holds that type as the subject
` gives it: the subject itself, the value an optional holds, or the case of a union that is of
` the named type.
if subject == no-type || subject == invalid-type || !types.completions[annotation].has-variables
    = annotation
. relation = relations.compare(subject, annotation, false, false, null, module)
if instance-relation(relation, .similar) && !types.completions[relation.to].has-variables
    = relation.to
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if held != subject
    = completed-capture(annotation, held)
if types.intrinsic-of(held) == .union
    for fact in types.cases-of(held)
        if fact.type != no-type && fact.type != invalid-type
            . given = relations.compare(fact.type, annotation, false, false, null, module)
            if instance-relation(given, .similar) && !types.completions[given.to].has-variables
                = given.to
= annotation

────────────────────
_ matches-named Bool
    - pattern SyntaxId

` Whether a pattern is a type named with how near a value must be to it (`Int~`): it is
` planned for the value it is given, as the type named alone is.
match tree.nodes[pattern]
    | .node-type-match(row)
        names-type(tree, row.type)
    ??
        false

────────────────────
_ do pattern-type TypeId
    - pattern SyntaxId
    - subject TypeId

` The type a pattern narrows its subject to: a type named in the pattern, as the subject gives
` it where it names a generic type without its parameters (`completed-capture`), also one of a
` list or a map written in brackets, or by a name that captures what it matches, what an optional
` holds for fields in parentheses, else the subject. Patterns written one after another narrow
` in turn.
do match? tree.nodes[pattern]
    | .node-type-tuple
        = held-subject(subject)
    | .node-type-identifier
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if named != invalid-type then completed-capture(named, subject) else subject
    | .node-type-arguments
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if named != invalid-type then completed-capture(named, subject) else subject
    | .node-type-list
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if named != invalid-type then named else subject
    | .node-type-map
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if named != invalid-type then named else subject
    | .node-type-match(row)
        = pattern-type(row.type, subject)
    | .node-type-capture(row)
        = if row.type != 0 then pattern-type(row.type, subject) else subject
    | .node-type-and(row)
        = pattern-type(row.right, pattern-type(row.left, subject))
= subject

────────────────────
_ do sequence-case TypeId
    - subject TypeId

` The type whose items a list pattern reads, as the reference finds it: of an optional what it
` holds, and of a union the case that has items to give. A text has none, nor has a type that
` is no `Indexable`: no type then, and the pattern can not match. Where more than one case
` of a union has items the reference matches each, which has no shape here: the type that
` is none.
if subject == no-type || subject == invalid-type
    = subject
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = if has-items(held) then held else no-type
. found = no-type
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type && has-items(fact.type)
        if found != no-type
            = invalid-type
        found = fact.type
= found

────────────────────
_ do structured-case TypeId
    - subject TypeId
    - wanted DeclRef

` A map pattern matches the value an optional holds, and of a union the case that is a map.
if subject == no-type || subject == invalid-type
    = subject
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = held
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type
        if types.ancestor-of(fact.type, wanted) != no-type
            = fact.type
= held

────────────────────
_ do check-text-pattern Bool
    - pattern SyntaxId

` A pattern of texts matched against a `String`, as the reference lowers one: the length is
` read and tested, then `starts-with` the texts before the rest and `ends-with` those after,
` each a call recorded at the pattern. A name given a text is bound to that text, and a rest
` with a name to what lies between, each a `String`. One with no rest or with several, or with
` a text that is not ASCII, whose length the reference counts in units of its own, is declined.
. parts [SyntaxId]
tree.text-parts(pattern, parts)
if parts.length == 0
    = false
. rest SyntaxId = 0
. rests = 0
. leads = false
. trails = false
. plain = true
for part in parts
    . text = tree.text-of(part)
    if text
        if text.size != text.length
            plain = false
        if text.length != 0
            leads = leads || rests == 0
            trails = trails || rests != 0
    else
        rests += 1
        rest = part
if rests != 1 || !plain
    decline(pattern)
    = true
facts.set-plan(instance, pattern, .plan-text-pattern)
calls.demand-getter(types.string-type, types.length-atom!, pattern)
if leads
    text-call(pattern, "starts-with")
if trails
    text-call(pattern, "ends-with")
for part in parts
    if tree.nodes[part] is .node-type-capture
        . slot = declaring-slot(part)
        if slot
            frame.assign(slot, types.string-type)
do match? tree.nodes[rest]
    | .node-type-remainder(row)
        if row.name != 0
            . range = range-construction(rest, .range-to-op, types.index-type, 0, 0, 0)
            check-pattern
                - row.name
                - calls.operator-call(rest, types.string-type, types.index-op-atom!, 0, range)
= true

────────────────────
_ do text-call
    - pattern SyntaxId
    - name String

` Records at a pattern of texts a call of a method of `String` given one text, which the pattern
` makes of the texts it writes.
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(types.string-type)
scratch.syntax.push(pattern)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.method-call(pattern, pattern, types.string-type, program.store-atom(name), arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do check-list-pattern
    - pattern SyntaxId
    - patterns RowRange'SyntaxId
    - whole TypeId

` A list pattern reads the length of its subject, each item by its index and a rest that has
` a name by a range, as the reference lowers it: the items take the type of an item and the
` rest what the range gives. The subject is what an optional holds and the case of a union
` that is a list, by the conversions recorded at the pattern as for a type named. The length
` is read by the getter recorded at the pattern, or is the field of an array a constant fact
` names. Of a table, a span of one or a view of a field's column, which the constant says,
` TypeScript answers the length and the rows or the items itself, which may raise the panics of
` a table, and makes a rest with a name the span or the view a range gives. The read of an item is the
` first call at its pattern; a rest with a name has the construction of its range and then
` the read.
. subject = sequence-case(whole)
if subject == invalid-type && whole != invalid-type
    decline(pattern)
if subject == no-type || subject == invalid-type
    for element in tree.children[patterns]
        check-pattern(element, no-type)
    =
if subject != whole
    plan-leaves(pattern, whole, subject, .similar, U32.max)
. viewed = is-column-receiver(types.intrinsic-of(subject)) || field-view
    .. field-view = is-field-view(types.intrinsic-of(subject))
if is-array-field(subject, types.length-atom!)
    facts.set-constant(instance, pattern, ConstantFact(1, 0, null, false), .plan-list-pattern)
else if viewed
    facts.set-constant(instance, pattern, ConstantFact(2, 0, null, false), .plan-list-pattern)
    instances.mark-may-panic(instance)
else
    facts.set-plan(instance, pattern, .plan-list-pattern)
    calls.demand-getter(subject, types.length-atom!, pattern)
for element in tree.children[patterns]
    do match tree.nodes[element]
        | .node-type-remainder(row)
            if row.name != 0
                . range = range-construction(element, .range-to-op, types.index-type, 0, 0, 0)
                . rest = calls.operator-call(element, subject, types.index-op-atom!, 0, range)
                if rest != invalid-type && viewed
                    if !plan-table-index(element, 0, subject, 0, range, rest)
                        rest = invalid-type
                check-pattern(row.name, rest)
        ??
            . item = calls.index-item(subject, element)
            note-item-read(element)
            check-pattern(element, item)

────────────────────
_ do note-item-read
    - element SyntaxId

` Marks the call just recorded at the pattern written for an item as the read that gives the
` pattern what it is matched against, apart from the calls the pattern makes itself.
. fact = facts.latest-call(instance, element)
if fact != no-fact && facts.calls[fact].form == .call-operator
    facts.calls[fact].form = .call-item-read

────────────────────
_ do check-map-pattern
    - pattern SyntaxId
    - patterns RowRange'SyntaxId
    - whole TypeId

` A map pattern reads each key's value through the index operator, which gives nothing for a
` key the map lacks; a rest keeps the map. The subject is what an optional holds and the
` case of a union that is a map, by the conversions recorded at the pattern as for a type
` named. A rest with a name is the map without what matched, by the calls recorded there.
. subject = structured-case(whole, types.map-decl)
. mapped = typed-subject && types.ancestor-of(subject, types.map-decl) != no-type
    .. typed-subject = subject != no-type && subject != invalid-type
if mapped
    if subject != whole
        plan-leaves(pattern, whole, subject, .similar, U32.max)
    facts.set-plan(instance, pattern, .plan-map-pattern)
for element in tree.children[patterns]
    do match tree.nodes[element]
        | .node-type-map-item(row)
            . key = infer(key-expr(row.key))
            . known = mapped && key != invalid-type
            . value = no-type
            if known
                value = calls.operator-call(element, subject, types.index-op-atom!, row.key, key)
                note-item-read(element)
            . held = no-type
            if value != no-type && value != invalid-type
                held = types.optional-inner(value)
            check-pattern(row.value, held)
        | .node-type-remainder(row)
            if row.name != 0 && mapped
                plan-map-rest(element, subject)
            check-pattern(row.name, subject)
        ??
            check-pattern(element, no-type)

────────────────────
_ do plan-map-rest
    - site SyntaxId
    - subject TypeId

` What a rest of a map pattern with a name calls, as the reference lowers it: an empty map of
` the subject's type is made, each key matched is stored there with what it holds, and the
` rest is the subject less that map.
. map = types.ancestor-of(subject, types.map-decl)
if map == no-type
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
calls.construction-on
    - site
    - subject
    - arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.index-assign-call(site, subject, 0, class-arg(types, map, 0), 0, class-arg(types, map, 1))
calls.operator-call(site, subject, program.store-atom("-"), 0, subject)

────────────────────
_ key-expr SyntaxId
    - key SyntaxId

` A map pattern's key is an equality on a literal or a `$name`: the expression it compares to.
match tree.nodes[key]
    | .node-type-equality(row)
        row.expr
    ??
        key

────────────────────
_ do check-case-value
    - value SyntaxId
    - payload TypeId

if value != 0 && payload != no-type
    do match? tree.nodes[value]
        | .node-type-tuple(row)
            . payload-kind = types.intrinsic-of(payload)
            if row.field-types.count == 1 && payload-kind != .tuple
                check-pattern(tree.children[row.field-types][0], payload)
                =
check-pattern(value, payload)

────────────────────
_ do case-payload TypeId
    - about TypeId
    - name Atom

if about == no-type || about == invalid-type
    = no-type
. subject = about
. subject-kind = types.intrinsic-of(subject)
if subject-kind == .table-row || subject-kind == .immutable-table-row
    subject = row-struct-of(subject)
    if subject == no-type
        = no-type
. completion = types.completion-of(subject)
if completion.intrinsic != .union
    = no-type
for fact in types.cases[completion.cases]
    if fact.name && fact.name! == name && !fact.is-default
        = fact.type
= no-type

────────────────────
_ do refuses-machine-write Bool
    - id SyntaxId
    - name Atom
    - resolution Resolution

` Reports an assignment to a name of a state machine, which moves only by its transitions: the
` local or the property it is kept in, or the property that says whether one of its cases is
` active or holds what the case holds, and says whether it did.
if resolution.kind == .resolve-member
    = writes-machine(id, frame.self-type, name)
if resolution.kind == .resolve-global
    = writes-machine-property(id, resolution.module, resolution.decl, name)
if resolution.kind != .resolve-slot
    = false
if bindings.slots[resolution.slot].kind == .slot-machine
    = machine-write(id, "\"${name.text}\" is a case of a state machine, which")
for row in bindings.machines
    if row.bound != no-slot && row.bound == resolution.slot
        = machine-write(id, "State machine \"${name.text}\"")
= false

────────────────────
_ do writes-machine Bool
    - id SyntaxId
    - receiver TypeId
    - name Atom

` Reports an assignment to a property of a class that is a state machine or one of its cases, as
` `refuses-machine-write` does, and says whether it did.
if !intrinsic-is-class(types.intrinsic-of(receiver))
    = false
. ref = declaring-class(types, receiver, name)
= writes-machine-property(id, ref.module, owner-property(program, ref.module, ref.decl, name), name)

────────────────────
_ do writes-machine-property Bool
    - id SyntaxId
    - module ModuleId
    - decl DeclId
    - name Atom

` Reports an assignment to a property that is a state machine or one of its cases, as
` `refuses-machine-write` does, and says whether it did.
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-property(row)
        if program.modules[module].tree.declared-machine(row.value) != 0
            = machine-write(id, "State machine \"${name.text}\"")
        if row.flag != 0 || row.projection != 0
            = machine-write(id, "\"${name.text}\" is a case of a state machine, which")
= false

────────────────────
_ do machine-write Bool
    - id SyntaxId
    - subject String

` Reports an assignment to a state machine or to one of its cases.
. text = "${subject} moves only by its transitions, so it cannot be assigned; add a transition that enters the case"
frame.diagnose(id, .stated, program.store-atom(text))
= true

────────────────────
_ do infer-assign TypeId
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - want Want

do match? tree.nodes[lhs]
    | .node-tuple-syntax(row)
        if op == .eq-op
            = infer-destructure(lhs, row.items, rhs)
    | .node-list-syntax
        infer(rhs)
        . text = "Names in brackets can be declared from a list, as in \". [x, y] = items\", but not assigned again; assign a tuple to them, as in \"x, y = items[0], items[1]\""
        frame.diagnose(lhs, .stated, program.store-atom(text))
        = invalid-type
    | .node-call-expression
        frame.diagnose(id, .stated, program.store-atom("Illegal assignment"))
        = invalid-type
    | .node-style-read-expression(row)
        = infer-style-write(id, op, lhs, row, rhs)
    | .node-index-expression(row)
        . stored = infer-index-assign(lhs, id, op, row.object, row.index, rhs, row.is-optional)
        = chain-stored(lhs, stored)
    | .node-get-expression(row)
        . stored = infer-property-assign(id, lhs, op, row.object, row.name, rhs, row.is-optional, no-type, want)
        = chain-stored(lhs, stored)
    | .node-identifier(row)
        . resolution = bindings.resolution-of(frame.binding, lhs)
        if refuses-machine-write(id, row.name, resolution)
            = invalid-type
        if resolution.kind == .resolve-member
            = infer-property-assign(id, lhs, op, 0, row.name, rhs, false, no-type, want)
        if resolution.kind == .resolve-function && module-accessor
            = infer-module-setter-assign(id, lhs, op, row.name, rhs)
        .. module-accessor = names-module-accessor(resolution.module, resolution.decl)
        if resolution.kind == .resolve-function
            frame.diagnose(id, .stated, program.store-atom("Function \"${row.name.text}\" cannot be assigned"))
            = invalid-type
        if (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
            = infer-received-assign(id, lhs, op, row.name, rhs, want)
        if resolution.kind == .resolve-unresolved && styled
            = infer-self-style-assign(id, lhs, op, row.name, rhs)
        .. styled = (resolution.flags /and/ ResolutionFlag.resolution-styled) != 0
        if is-stack-local(lhs)
            . message = "Stack-local variable '${row.name.text}' can only be rebound with do with"
            frame.diagnose(id, .stated, program.store-atom(message))
            = invalid-type
        if assigns-early(lhs)
            if op == .eq-op
                frame.diagnose(id, .stated, program.store-atom("Variable not declared"))
            else
                frame.diagnose(lhs, .stated, program.store-atom("Name not found"))
            = invalid-type
        if op != .eq-op
            facts.set-node-type(instance, lhs, target-of(lhs, true))
            . assigned = bindings.resolution-of(frame.binding, lhs)
            if assigned.kind == .resolve-global && guards-read(lhs, assigned.module, assigned.decl)
                note-guarded(lhs, assigned.module, assigned.decl)
        check-tracked-store(id, lhs)
. target = target-of(lhs, op != .eq-op)
. written = if op == .eq-op then infer-with-expected(rhs, target, Want().escaping(target, rhs)) else infer(rhs)
if written == invalid-type || target == invalid-type
    = invalid-type
. value = stored-value(rhs, written)
. withheld = value != written
if stores-loop-constant(lhs, op, target, value, rhs)
    frame.diagnose(id, .stated, program.store-atom("Illegal to update const variables"))
    = invalid-type
note-escape(rhs)
if op == .eq-op && is-identifier-syntax(lhs)
    calls.note-context-cast(rhs, target, .cast-assignment)
. result = assign-into(id, lhs, op, target, rhs, value)
check-zone-store(id, lhs, rhs, value)
if !withheld
    note-replacement(id, target, if op == .eq-op then value else result)
. slot = narrowing.condition-slot(lhs)
if slot
    . settled = slot-known(slot)
    . held U64
    if op == .eq-op && withheld
        if frame.slot-type(slot) == assigned-narrowing(settled, value)
            settled = frame.slot-type(slot)
    else if op == .eq-op
        held = assigned-case(settled, value)
        settled = assigned-narrowing(settled, value)
    else if !(outer && frame.is-captured(slot))
        . current = frame.slot-type(slot)
        if current != no-type && current != invalid-type
            settled = current
    frame.push-assigned(slot-key(slot), settled, held)
    frame.reset-paths(slot-key(slot))
    frame.note-assignment(id, slot, settled)
if withheld && op == .eq-op
    = infer(lhs)
= result

────────────────────
_ do infer-received-assign TypeId
    - id SyntaxId
    - lhs SyntaxId
    - op Operator
    - name Atom
    - rhs SyntaxId
    - want Want

` An assignment to a member of a markup element, or of an element it is in, by its name alone,
` as the binder found it: the reference assigns the property of that element's object
` (`received-parent`). A member that is no stored property, or one assigned where no element is
` being built, has no shape here.
. parent = received-parent(lhs, name)
. place = types.property-named(parent, name) if parent != no-type
if !place || types.properties[place].storage-kind == .storage-getter
    decline(id)
    = invalid-type
= infer-property-assign(id, lhs, op, 0, name, rhs, false, parent, want)

────────────────────
_ do infer-module-setter-assign TypeId
    - id SyntaxId
    - lhs SyntaxId
    - op Operator
    - name Atom
    - rhs SyntaxId

if op == .eq-op
    . value = infer(rhs)
    =? invalid-type if value == invalid-type
    = store-through-module-setter(lhs, name, rhs, value, .call-setter)
. target = infer(lhs)
=? invalid-type if target == invalid-type
. value = infer(rhs)
=? invalid-type if value == invalid-type
if updates-in-place(target, op, value, rhs)
    decline(id)
    = invalid-type
. result = assign-into(id, lhs, op, target, rhs, value)
=? invalid-type if result == invalid-type
=? invalid-type if store-through-module-setter(lhs, name, lhs, target, .call-store-setter) == invalid-type
= result

────────────────────
_ do store-through-module-setter TypeId
    - lhs SyntaxId
    - name Atom
    - argument SyntaxId
    - value TypeId
    - form CallForm

. diagnosed = facts.diagnostics.length
. set = calls.module-setter-call(lhs, name, argument, value, form)
if set == invalid-type
    facts.restate
        - diagnosed
        - instance
        - lhs
        - .function-not-found
        - .stated
        - program.store-atom("Setter not found")
= set

────────────────────
_ do infer-content-property TypeId
    - id SyntaxId
    - value SyntaxId
    - want Want

` A line of a class's markup that declares a property it gives its value (`content-property`), as
` the reference's content runs it: the value is stored in the property of the object being filled
` where the line runs, as an assignment to the property named alone stores it, and runs again
` where it reads something tracked, as a live assignment does. The line gives no content. One
` whose name its class or a class above declares too is reported (`report-content-clash`).
. left = tree.content-property-name(id)
. name = identifier-name(tree, left) if left != 0
if !name || bindings.resolution-of(frame.binding, left).kind != .resolve-member
    decline(id)
    = invalid-type
if !owns-content-property(frame.self-type, name, id)
    report-content-clash(frame.self-type, name, id)
    = invalid-type
. assigned = infer-assign(id, .eq-op, left, value, want)
if assigned != invalid-type && facts.live-statements.length != 0
    settle-live-statement(id, left, value, facts.node-type(instance, value))
= assigned

────────────────────
_ do report-content-clash
    - receiver TypeId
    - name Atom
    - id SyntaxId

` Reports the property of a name that the class whose markup holds the line `id`, or a class
` above it, declares otherwise than the line does (`content-property`), as the reference reports
` a property stored two ways: `Inherited properties must have same assignment type` at that
` declaration, where it is a stored one of this module. Any other clash, one a class below
` declares among them, is declined.
. level TypeId? = receiver
. reached = false
while level
    . ref = class-ref(types, level)
    reached = reached || holds-line(ref, id)
    . member = owner-property(program, ref.module, ref.decl, name)
    if member != 0
        do match? program.modules[ref.module].decls[member]
            | .decl-property(row)
                if row.line != id && reached
                    if ref.module == module && !row.is-lazy
                        frame.diagnose
                            - row.syntax
                            - .stated
                            - program.store-atom
                                - "Inherited properties must have same assignment type"
                        =
                    decline(id)
                    =
    level = types.base-of(level)
decline(id)

────────────────────
_ do holds-line Bool
    - ref DeclRef
    - id SyntaxId

` Whether a line of this module is one of the markup the class `ref` writes.
if ref.module != module
    = false
do match? program.modules[module].decls[ref.decl]
    | .decl-class(class)
        = class.content != 0 && tree.subtree-start(class.content) <= id && id <= class.content
= false

────────────────────
_ do owns-content-property Bool
    - receiver TypeId
    - name Atom
    - line SyntaxId

` Whether the property of a name an object of `receiver` has is the one a line of the markup of
` its class, or of a class above, declares (`content-property`), and no class above that one
` declares one of the name.
. level TypeId? = receiver
while level
    . ref = class-ref(types, level)
    . member = owner-property(program, ref.module, ref.decl, name)
    if member != 0
        do match? program.modules[ref.module].decls[member]
            | .decl-property(row)
                if row.line != line || ref.module != module
                    = false
                . above = types.base-of(level)
                = !above || !types.property-named(above, name)
        = false
    level = types.base-of(level)
= false

────────────────────
_ do check-tracked-store
    - id SyntaxId
    - lhs SyntaxId

` A store to a local some read tracks, which runs the actions that read it where its bits
` change, as the reference's function scope does once it has made its list of subscribers;
` they may panic. A store from a function written in the one that declares the local has no
` shape here yet, but for the function that runs a live statement again where it reads the
` list, nor has a store to a local that shares its name with one some read tracks, which the
` reference's list runs the actions of too. What the actions run leaves what is known of
` properties in doubt.
. resolution = bindings.resolution-of(frame.binding, lhs)
if resolution.kind != .resolve-slot || !is-trackable(resolution.slot)
    =
if (bindings.slots[resolution.slot].flags /and/ SlotFlag.slot-tracked) == 0
    if namesake(resolution.slot, true)
        decline(id)
    =
. subscribers = subscribers-slot(resolution.slot)
. rerun = frame.declaration.kind == .live-decl
if subscribers == no-slot
    =
if frame.is-captured(resolution.slot) && (!rerun || !frame.is-captured(subscribers))
    decline(id)
    =
demand-live-runtime()
if instances.live.dispatch == no-instance
    decline(id)
    =
instances.mark-may-panic(instance)
frame.doubt-members()

────────────────────
_ do note-replacement
    - id SyntaxId
    - target TypeId
    - stored TypeId

` An array stored over an array tells the runtime its storage is replaced, which marks stale
` the views of the old storage where it goes away or shrinks. What an assigning operator
` stores is what its function answers, as it is for an assignment what is written.
if is-array-value(target) && is-array-value(stored)
    facts.mark-replacing(instance, id)
    instances.mark-may-panic(instance)

────────────────────
_ is-array-value Bool
    - type TypeId

|? type == no-type || type == invalid-type || types.intrinsic-of(type) != .tuple
    false
??
    types.ancestor-of(type, types.array-decl) != no-type || immutable-array

.. immutable-array = types.ancestor-of(type, types.immutable-array-decl) != no-type

────────────────────
_ do reads-as-declared Bool
    - rhs SyntaxId
    - target TypeId

` Whether a value stored is a read of a property of a path a test narrowed, made to a place of
` the type the path declares the property as: the read is then taken as declared, which gives
` what the narrowed one would where the property holds what was tested, and what it gives where
` a store before it ended what is known, so it relies on nothing the flow knew.
do match? tree.nodes[rhs]
    | .node-get-expression(row)
        if row.is-optional || row.is-tracked
            = false
        . base = narrowing.base-key(row.object)
        if !base
            = false
        . key = frame.find-path-key(base, row.name)
        if !key || !is-path-key(key)
            = false
        . narrowed = frame.held-member(key)
        if narrowed == no-type || facts.node-type(instance, rhs) != narrowed
            = false
        if frame.path-declared-type(key) != target
            = false
        facts.replace-node-type(instance, rhs, target)
        frame.member-reads -= 1
        = true
= false

────────────────────
_ do stored-value TypeId
    - rhs SyntaxId
    - written TypeId

` The type of what an assignment stores. A value written after the `?` of an assignment is
` stored only where it holds a value, so what is stored is what that optional holds; the
` assignment then gives what the place holds afterwards, which where nothing was stored is
` what it held before. Any other value is stored as written.
if written == invalid-type || written == no-type || !types.is-optional(written)
    = written
do match? tree.nodes[rhs]
    | .node-optional-chain
        = types.optional-inner(written)
= written

────────────────────
_ do chain-stored TypeId
    - lhs SyntaxId
    - stored TypeId

` What an assignment gives where the place assigned is a link of an optional chain: the
` optional of what the store gives, which holds nothing where the store was not made.
if stored == invalid-type || stored == no-type || !optional-chained(lhs)
    = stored
= types.optional-of(stored)

────────────────────
_ do assigned-narrowing TypeId
    - declared TypeId
    - value TypeId

` An optional local assigned a present value, or a union local assigned the value of one of
` its cases, reads as that value until the next assignment, as the reference's flow facts
` track it.
if value == invalid-type || value == no-type || declared == invalid-type || declared == no-type
    = declared
if types.intrinsic-of(declared) == .union && types.intrinsic-of(value) != .union
    . wrap = relations.compare(value, declared)
    if wrap.kind == .relation-wrap-cast
        . fact = types.cases-of(declared)[wrap.case-index]
        if !fact.is-default && fact.type != no-type
            = fact.type
    = declared
if !types.is-optional(declared) || types.is-optional(value) || value == types.null-type
    = declared
= types.optional-inner(declared)

────────────────────
_ assigned-case U64
    - declared TypeId
    - value TypeId

` The one case a union local holds after it is assigned a value of that case, as a mask, or
` none where it reads as the union still.
|? assigned-narrowing(declared, value) == declared
    0
|? types.intrinsic-of(declared) != .union
    0
??
    if wrap.case-index < 64 then 1u64 /lshift/ wrap.case-index else 0u64

.. wrap = relations.compare(value, declared)

────────────────────
_ do projected-from TypeId
    - object-syntax SyntaxId
    - receiver TypeId

` The union a local declares when it reads as one of that union's cases: a member the case
` does not answer is still the union's own.
do match? tree.nodes[object-syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, object-syntax)
        if resolution.kind == .resolve-slot
            . known = slot-known(resolution.slot)
            if known != no-type && known != invalid-type && known != receiver
                if types.intrinsic-of(known) == .union
                    = known
= no-type

────────────────────
_ answers Bool
    - receiver TypeId
    - name Atom

|? types.property-named(receiver, name) != null || calls.has-getter(receiver, name)
    true
??
    calls.method-binding(receiver, name) != no-type

────────────────────
_ do infer-property-assign TypeId
    - id SyntaxId
    - lhs SyntaxId
    - op Operator
    - object-syntax SyntaxId
    - name Atom
    - rhs SyntaxId
    - is-optional Bool = false
    - owner TypeId = no-type
    - want Want = Want()

` What an assignment to a property gives as a value. A property named alone is the receiver's,
` or the `owner`'s where one is given, and gives the value assigned, as it was before the store
` converted it. A field of a tuple gives the new tuple,
` also by an assigning operator that assigns it (`updates-in-place`), which is not stored, and
` any other place, of an object, a struct, a row or a builder, gives what it then holds. A
` property written after `?` is that of what the optional before it holds, and the object of
` a property written after a link of an optional chain is what that link gives by itself. A
` store to a property some read tracks runs the actions that read it, which ends what is known
` of every property. One no read typed so far tracks is taken as running nothing where that
` matters, and the pass starts over knowing it tracked where a read typed later tracks it
` (`Panics.typed-late`). A narrowed read stored after such a store is taken as declared where
` that is what the place holds (`reads-as-declared`), and one in doubt that is stored any other
` way is declined. The object of an assignment that applies an operator is typed before the
` value, and that of a plain one after it, as the reference evaluates them, but before a case
` named by its symbol alone, which evaluates nothing, so that a state machine is found before
` the case is (`writes-machine`). An event stored is taken once the property is known, as
` `store-event` says.
. object-first = (op != .eq-op || tree.nodes[rhs] is .node-symbol) && object-syntax != 0
. early = if object-first then infer-found(object-syntax) else Found(no-type)
if object-first && op == .eq-op && writes-machine(id, early.type, name)
    = invalid-type
. assigned = infer-found(rhs, if op == .eq-op then Want().adding(.want-store) else Want())
. value = stored-value(rhs, assigned.type)
. doubted = assigned.doubted
. stored = found-event-of(assigned)
. kept = assigned.kept
. own-receiver = if owner != no-type then owner else frame.self-type
. unqualified = object-syntax == 0
. late = if unqualified || object-first then Found(no-type) else infer-found(object-syntax)
. receiver = if unqualified then own-receiver else if object-first then early.type else late.type
. own = if object-first then early.link else late.link
if value == invalid-type || receiver == invalid-type || receiver == no-type
    = invalid-type
. form = if is-optional then note-chain(lhs, lhs, receiver) else ChainForm.chain-plain
if form == .chain-absent || (object-syntax != 0 && absent-after(object-syntax, receiver))
    = value
. optional = form == .chain-tested
if optional
    receiver = types.optional-inner(receiver)
else if object-syntax != 0 && types.is-optional(receiver) && optional-chained(object-syntax)
    receiver = link-receiver(object-syntax, receiver, own, false)
    facts.set-node-type(instance, object-syntax, receiver)
if object-syntax != 0 && refuses-write(lhs, receiver, false)
    = invalid-type
if object-syntax != 0 && writes-machine(id, receiver, name)
    = invalid-type
. sets-length = name == types.length-atom! && !types.property-named(receiver, name)
if object-syntax != 0 && op == .eq-op && refuses-layout(id, lhs, object-syntax, receiver, name, rhs, want)
    = invalid-type
if (doubted || stored) && (is-accessor(receiver, name) || forwards-setter(receiver, name))
    decline(rhs)
    = invalid-type
if op == .eq-op && is-accessor(receiver, name)
    = store-through-setter(lhs, object-syntax, receiver, name, rhs, value, .call-setter)
if op == .eq-op && forwards-setter(receiver, name)
    . site = if object-syntax != 0 then object-syntax else lhs
    . sent = no-type
    for index in 0 .. < types.cases-of(receiver).length
        . payload = types.cases-of(receiver)[index].type
        sent = calls.setter-call(lhs, site, payload, name, rhs, value)
        if sent == invalid-type
            = invalid-type
    facts.set-plan(instance, lhs, .plan-forward)
    facts.note-forward(instance, lhs, sent, rhs)
    = sent
if is-batch-flush(receiver)
    . (domain, below) = accessor-domain(name.text)
    . flag = domain.length != 0 && !below
    . message = if flag then "Markup batch flush domain flags are immutable" else "Markup batch flush summaries are immutable"
    frame.diagnose(lhs, .stated, program.store-atom(message))
    = invalid-type
if op == .eq-op && is-query-property(receiver, name)
    frame.diagnose
        - lhs
        - .stated
        - program.store-atom("Markup query properties are compiler-managed and cannot be assigned")
    = invalid-type
if object-syntax != 0
    . styled = infer-style-assign(id, lhs, receiver, name, op, rhs, value)
    if styled && (doubted || stored)
        decline(rhs)
        = invalid-type
    if styled
        = styled
assigns-plainly = op == .eq-op
. target = read-property(lhs, if object-syntax != 0 then object-syntax else lhs, receiver, name).type
assigns-plainly = false
if target == invalid-type
    = invalid-type
if stored && !store-event(rhs, stored, kept, target)
    = invalid-type
if op == .eq-op && reads-as-declared(rhs, target)
    value = target
else if doubted
    decline(rhs)
    = invalid-type
check-zone-store(id, lhs, rhs, value)
if op == .eq-op && symbol-of(rhs) != null
    value = infer-with-expected(rhs, target)
. written = panics.property-of(receiver, name)
if written
    panics.note-write(instance, written)
facts.set-node-type(instance, lhs, if op == .eq-op && object-syntax == 0 then value else target)
note-escape(rhs)
if object-syntax == 0
    . resolution = bindings.resolution-of(frame.binding, lhs)
    if resolution.kind == .resolve-member
        frame.push-assigned(member-key(resolution.decl), target)
        frame.reset-paths(member-key(resolution.decl))
else
    . shared = narrowing.receiver-member(object-syntax, name)
    . base = narrowing.base-key(object-syntax)
    if shared
        frame.push-assigned(shared, target)
        frame.reset-paths(shared)
    else if base
        . key = frame.find-path-key(base, name)
        if key
            frame.push-assigned(key, target)
            frame.reset-paths(key)
. result = assign-into(id, lhs, op, target, rhs, value)
if compound-result && is-accessor(receiver, name) && !updates-in-place(target, op, value, rhs)
    =? invalid-type if store-through-setter(lhs, object-syntax, receiver, name, lhs, target, .call-store-setter) == invalid-type
.. compound-result = op != .eq-op && result != invalid-type
note-replacement(id, target, if op == .eq-op then value else result)
if object-syntax != 0 && !facts.is-replacing(instance, id) && forget-store-root(object-syntax)
    settled-store = id
if written && frame.knows-properties()
    if panics.is-tracked-property(written)
        frame.forget-members()
    else
        unsure-stores += panics.assume-untracked(instance, id, written)
        unsure-reads += frame.member-reads
if object-syntax != 0 && op != .eq-op && !sets-length && !is-row-cursor(object-syntax)
    if result != invalid-type && !updates-in-place(target, op, value, rhs)
        if refuses-layout(id, lhs, object-syntax, receiver, name, rhs, want)
            = invalid-type
        . updated = replaced-tuple(id, object-syntax, receiver, name, rhs)
        =? updated if updated != no-type
if op != .eq-op
    = result
if object-syntax == 0
    = value
if is-row-cursor(object-syntax)
    = target
. replaced = replaced-tuple(id, object-syntax, receiver, name, rhs)
if replaced != no-type
    = replaced
. kind = types.intrinsic-of(receiver)
. plain = is-plain-tuple(receiver) || (kind == .tuple && view-kind(receiver) == 0)
= if plain then no-type else target

────────────────────
_ do store-through-setter TypeId
    - lhs SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - argument SyntaxId
    - value TypeId
    - form CallForm

` A value stored in a property its setter answers: by an assignment, or by an assigning operator
` that stores the value it makes through the setter (`call-store-setter`).
. found = types.property-named(receiver, name)
if found && is-hidden(types.properties[found], name, .setter-decl)
    frame.diagnose(lhs, .stated, program.store-atom("Property \"${name.text}\" is private"))
    = invalid-type
. diagnosed = facts.diagnostics.length
. site = if object-syntax != 0 then object-syntax else lhs
. set = calls.setter-call(lhs, site, receiver, name, argument, value, form)
if set == invalid-type
    facts.restate
        - diagnosed
        - instance
        - lhs
        - .function-not-found
        - .stated
        - program.store-atom("Setter not found")
= set

────────────────────
_ do updates-in-place Bool
    - target TypeId
    - op Operator
    - value TypeId
    - rhs SyntaxId

` Whether an assigning operator changes what a place holds without assigning the place: a
` function of its own name on a type that is not a struct or a tuple, as the reference's
` `increment` calls it and stores nothing.
. held = types.intrinsic-of(target)
if held == .struct || held == .tuple
    = false
= calls.has-operator(target, program.store-atom("$op"), value) • arg-syntax rhs

────────────────────
_ do replaced-tuple TypeId
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - rhs SyntaxId

` What an assignment to a field of a tuple gives: a new tuple of the same type, or of its
` first fields when it is the length that is assigned, where the tuple declares no `length`
` of its own. An assignment to any other place gives nothing here.
if object-syntax == 0
    = no-type
. kind = types.intrinsic-of(receiver)
if !is-plain-tuple(receiver) && (kind != .tuple || view-kind(receiver) != 0)
    = no-type
if name == types.length-atom! && !types.property-named(receiver, name)
    = truncated-tuple(id, receiver, rhs)
. field = types.property-named(receiver, name)
if !field || types.properties[field].storage-kind != .storage-eager
    = no-type
= receiver

────────────────────
_ do truncated-tuple TypeId
    - id SyntaxId
    - receiver TypeId
    - rhs SyntaxId

` The tuple of the first fields of a tuple, as many as a constant says. A count written
` below zero has no plan.
. count U64 = U64.max
. counted = true
do match? tree.nodes[rhs]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        count = literal.value
        counted = !literal.negative && !literal.overflow
. mark = scratch.types.mark
. names-mark = scratch.names.mark
do match? types.rows[receiver]
    | .type-tuple(row)
        if count > (row.fields.count as U64)
            frame.diagnose(id, .stated, program.store-atom("Illegal to increase tuple length"))
            = invalid-type
        . kept = count as U32
        for offset in 0 .. < kept
            scratch.names.push(types.index-atom(offset))
            scratch.types.push(types.child-type(row.fields, offset))
        if counted
            facts.set-plan(instance, id, .plan-truncate)
        = types.intern-tuple(mark, names-mark)
= no-type

────────────────────
_ do refuses-layout Bool
    - id SyntaxId
    - lhs SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - rhs SyntaxId
    - want Want

` A tuple is a value: assigning one of its fields, by `=` or by an assigning operator that
` assigns it (`updates-in-place`), gives a new tuple, which a statement that does nothing with
` it loses, and its length changes only to a constant. A struct's layout does not change at all. A `length` the type declares is a
` field like any other. As the reference has it, a statement loses the tuple in a `do`
` function or a module's main, and in the body of another function only as one of its own
` statements (`want-quasi`): the value of an arm or a block inside gives the tuple. A struct's
` field is changed in place, which loses the change where nothing holds the struct: a struct
` cast to its base, which is a copy, or one a call gives.
. kind = types.intrinsic-of(receiver)
. plain = is-plain-tuple(receiver) || (kind == .tuple && view-kind(receiver) == 0)
if name == types.length-atom! && !types.property-named(receiver, name)
    if kind == .struct
        frame.diagnose(lhs, .stated, program.store-atom("Struct layout cannot be changed"))
        = true
    if plain && !is-integer-literal(rhs)
        frame.diagnose(lhs, .stated, program.store-atom("Value has no constant form"))
        = true
    = false
if kind == .struct && !holds-struct(object-syntax)
    . stored = types.property-named(receiver, name)
    if stored && types.properties[stored].storage-kind == .storage-eager
        . shown = type-display(types, receiver)
        . message = "Assigning ${name.text} changes a $shown struct that nothing holds, so the change is lost; assign ${name.text} where the struct is held"
        frame.diagnose(id, .stated, program.store-atom(message), receiver)
        = true
if !plain || !want.asks(.want-statement) || is-row-cursor(object-syntax)
    = false
if !want.asks(.want-quasi) && !frame.declaration.is-imperative && !frame.declaration.is-main
    = false
. field = types.property-named(receiver, name)
if !field || types.properties[field].storage-kind != .storage-eager
    = false
. owner = description-of(tree, object-syntax)
. shown = type-display(types, receiver)
. message = "Assigning ${name.text} creates a new $shown tuple that is discarded; "
message ++= "write $owner = $owner.${name.text} = value"
frame.diagnose(id, .stated, program.store-atom(message), receiver)
= true

────────────────────
_ holds-struct Bool
    - object-syntax SyntaxId

` Whether a struct whose field is assigned is held where the change stays: not one a cast or
` a call gives.
match tree.nodes[object-syntax]
    | .node-cast-expression
        false
    | .node-call-expression
        false
    ??
        true

────────────────────
_ is-row-cursor Bool
    - object-syntax SyntaxId

` Whether a name stands for the case of a table row a pattern matched: a place in the table,
` which a field assignment writes through.
object-syntax != 0 && row-capture-of(object-syntax) != null

────────────────────
_ do row-capture-of RowCapture?
    - object-syntax SyntaxId

` What a receiver stands for where it is the case of a row: a name a pattern bound to the
` case, or the receiver of a member that runs on a row's case, written or not.
. own = instances.rows[instance]
. adapted = RowCapture(own.row-receiver, own.row-case, own.row-validated)
if object-syntax == 0
    = adapted if own.row-receiver != no-type
do match? tree.nodes[object-syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, object-syntax)
        if resolution.kind == .resolve-slot
            if bindings.slots[resolution.slot].kind == .slot-this
                = adapted if own.row-receiver != no-type
            = cursor-of(resolution.slot)
= null

────────────────────
_ do cursor-of RowCapture?
    - slot SlotId

for held in row-cursors
    if held.slot == slot
        = held.capture
= outer.cursor-of(slot) if outer != null

────────────────────
_ do case-number U32
    - union TypeId
    - name Atom

` The number of the case of a union a name names.
. position U32
for fact in types.cases-of(union)
    if fact.name && fact.name! == name
        = position
    position += 1
= U32.max

────────────────────
_ do reads-row Bool
    - syntax SyntaxId

` Whether a subject is the row `t[i]` reads of a table, a span or a selection, which TypeScript
` makes a cursor of whose storage it checked there, or a name a loop gives such a row by.
do match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        = resolution.kind == .resolve-slot && checked-rows.find(resolution.slot) != null
    | .node-index-expression
        . constant = facts.constant-of(instance, syntax)
        if table-planned && constant != no-fact && !optional-chained(syntax)
            . op = ((facts.constants[constant].bits /and/ 4294967295) as U32) as TableOp
            = op == TableOp.table-row || op == TableOp.selection-row || op == TableOp.proven-row
        .. table-planned = facts.plan-of(instance, syntax) == .plan-table
= false

────────────────────
_ do forwards-setter Bool
    - receiver TypeId
    - name Atom

` A union whose every case sets a member through a setter sets it through each case's own.
if !calls.forwards-to-cases(receiver)
    = false
for fact in types.cases-of(receiver)
    if !is-accessor(fact.type, name)
        = false
= true

────────────────────
_ do refuses-write Bool
    - id SyntaxId
    - target TypeId
    - indexed Bool

` Reports a store through a value that only reads: an immutable table and its rows, spans and
` fields, a constant array, an immutable array's elements, and an array view with read access.
. message = read-only-message(target, indexed)
if message.length == 0
    = false
frame.diagnose(id, .stated, program.store-atom(message))
= true

────────────────────
_ do read-only-message String
    - target TypeId
    - indexed Bool

. kind = types.intrinsic-of(target)
if kind == .immutable-table
    = "ImmutableTable is read-only"
if kind == .immutable-table-row
    = "ImmutableTableRow is read-only"
if kind == .immutable-table-span
    = "ImmutableTableSpan is read-only"
if kind == .immutable-table-column
    = "ImmutableTableField is read-only"
if indexed && is-const-array(target)
    = "ConstArray values are read-only"
if kind != .tuple
    = ""
if indexed && types.ancestor-of(target, types.immutable-array-decl) != no-type
    = "ImmutableArray does not support element assignment"
for view in [types.array-row-decl, types.array-row-range-decl, types.array-field-decl]
    . found = types.ancestor-of(target, view)
    if found != no-type
        do match? types.rows[found]
            | .type-class(row)
                if row.args.count == 2 && types.child-type(row.args, 1) == types.array-read-access
                    = "Cannot write through a read-only array view"
= ""

────────────────────
_ do assign-into TypeId
    - id SyntaxId
    - lhs SyntaxId
    - op Operator
    - target TypeId
    - rhs SyntaxId
    - value TypeId
    - in-place Bool = false

` `in-place` says the node is itself the place assigned, a field of a struct named by an
` index, so an assigning operator is planned at it as it is at an assignment. The value of
` an assignment is what was assigned, or what the function of an assigning operator answers.
` A struct and a tuple are values, so what such a function answers for one is assigned to the
` place, as the reference assigns it: the value is then what the place holds, but for a local
` or a global, where it is the answer. A function of its own name answers before any rule for
` numbers does.
if op == .eq-op
    conversions.convert(id, rhs, value, target, .reason-assignment)
    = value
. token = program.store-atom("$op")
if op == .add-eq-op && is-plain-tuple(target)
    . extended = extended-tuple(target, value)
    facts.set-node-type(instance, id, extended)
    facts.set-plan(instance, id, .plan-extend)
    = extended
. stepped = increment-base(op)
if stepped && stepped != .pow-op && stepped != .concat-op
    calls.note-operand-suffix(rhs, lhs, target)
. given = conversions.adapted-literal(rhs, value, target)
. numeric = is-numeric(types, target) && is-numeric(types, given)
if numeric && !calls.has-operator(target, token, given)
    . promoted = promote(types, target, given)
    . base = increment-base(op)
    if (lhs != id || in-place) && base && base != .pow-op
        . unit = unit-arithmetic-type(types, target, given)
        plan-arithmetic(id, lhs, target, rhs, given, unit, promoted)
        if unit != no-type
            = target
    if (lhs != id || in-place) && base && base == .pow-op
        . raised = infer-binary-values(id, base, lhs, target, rhs, given)
        if raised != invalid-type
            conversions.convert(id, id, raised, target, .reason-assignment)
        = target
    if promoted != target
        conversions.convert(id, id, promoted, target, .reason-assignment, true, given == target)
        if lhs == id || is-identifier-syntax(lhs)
            facts.set-node-type(instance, id, promoted)
            = promoted
    else if in-place
        facts.set-node-type(instance, id, target)
    = target
. result = invalid-type
. diagnosed = facts.diagnostics.length
. answers = true
. stores = false
if calls.has-operator(target, token, value) • arg-syntax rhs
    result = calls.operator-call(lhs, target, token, rhs, value)
    . held = types.intrinsic-of(target)
    stores = result != invalid-type && (held == .struct || held == .tuple)
else
    . base = increment-base(op)
    if base
        answers = false
        result = infer-binary-values(id, base, lhs, target, rhs, value)
        if result != invalid-type
            conversions.convert(id, id, result, target, .reason-assignment)
    else
        result = calls.operator-call(lhs, target, token, rhs, value)
if result == invalid-type && types.intrinsic-of(target) == .struct
    facts.restate(diagnosed, instance, id, .illegal-operation, .function-not-found)
facts.set-node-type(instance, id, result)
if answers && result != invalid-type
    place-given(id, rhs, value)
if stores
    facts.set-plan(instance, id, .plan-store-answer)
    conversions.convert(id, id, result, target, .reason-assignment)
    = if names-variable(lhs) then result else target
= if answers && result != invalid-type then result else target

────────────────────
_ do place-given
    - statement SyntaxId
    - written SyntaxId
    - closure TypeId

` Says where the reference places the function a closure runs as a value of a function type
` once the function that answers an assigning operator is given it: where the closure's
` value is made. That is the statement for a closure written in a loop of its function,
` whose turn holds it, and the line below the closure for any other.
if closure == no-type || closure == invalid-type || types.intrinsic-of(closure) != .closure
    =
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax != written
        continue
    . scope = bindings.scopes[nested.scope].parent
    . looped = false
    while bindings.scopes[scope].kind != .scope-function && bindings.scopes[scope].kind != .scope-nested
        looped = looped || bindings.scopes[scope].kind == .scope-loop
        scope = bindings.scopes[scope].parent
    types.place-closure(closure, if looped then statement else written, !looped)
    =

────────────────────
_ names-variable Bool
    - id SyntaxId

` Whether an expression is the name of a local or of a global.
|? !is-identifier-syntax(id)
    false
??
    kind == .resolve-slot || kind == .resolve-global

.. kind = bindings.resolution-of(frame.binding, id).kind

────────────────────
_ do infer-destructure TypeId
    - lhs SyntaxId
    - items RowRange'SyntaxId
    - rhs SyntaxId

. value = infer(rhs)
if value == invalid-type
    = invalid-type
facts.set-node-type(instance, lhs, value)
types.complete(value)
. arity = tuple-arity(value)
if arity == U32.max
    frame.diagnose(lhs, .stated, program.store-atom("Tuple expected"))
    = invalid-type
if items.count != arity
    frame.diagnose(lhs, .stated, program.store-atom("Tuple sizes don't match"))
    = invalid-type
. position = 0u32
for item in tree.children[items]
    if position < arity
        . field = field-of(value, position)
        do match? tree.nodes[item]
            | .node-identifier
                . resolution = bindings.resolution-of(frame.binding, item)
                if resolution.kind == .resolve-slot
                    frame.assign
                        - resolution.slot
                        - assigned-part(item, written-part(rhs, position), field)
    position += 1
= value

────────────────────
_ do assigned-part TypeId
    - item SyntaxId
    - written SyntaxId
    - field TypeId

` What a local a tuple is taken apart into holds of a field: the field converted to the local's
` type at the local's name, as an assignment converts it, and then the field itself, or the
` local's type where both are numbers.
. target = target-of(item)
=? field if target == field || target == no-type || target == invalid-type
if conversions.convert(item, written, field, target, .reason-assignment) == invalid-type
    = target
= if is-numeric(types, field) && is-numeric(types, target) then target else field

────────────────────
_ written-part SyntaxId
    - rhs SyntaxId
    - position U32

` The item written at a position of a tuple written as a value, or none.
match tree.nodes[rhs]
    | .node-tuple-syntax(row)
        if position < row.items.count then tree.children[row.items.start + position] else 0
    ??
        0

────────────────────
_ do infer-index-assign TypeId
    - id SyntaxId
    - assignment SyntaxId
    - op Operator
    - object-syntax SyntaxId
    - key-syntax SyntaxId
    - rhs SyntaxId
    - is-optional Bool

` An index assigned. An assigning operator reads the item by `[]` and gives the value its
` operator makes to `[]=`, but where the item holds no struct or tuple and a function of the
` operator's own name answers it, as the reference compiles it for an object: that function is
` called on the item, and nothing is stored (`plan-answer-item`). An item past a pointer is
` read and stored by its plan, and the operator is planned at the assignment, as for a field.
` A text's item assigned gives a new text, stored where the text is held, so one written where
` nothing holds it, as a literal or what a call gives, is an error.
. value = stored-value(rhs, infer(rhs))
. noted = facts.diagnostics.length
. object-found = infer-found(object-syntax)
. object = object-found.type
. own = object-found.link
if object == invalid-type
    facts.resite(noted, instance, object-syntax, id)
. key = infer(key-syntax)
if object == invalid-type || key == invalid-type || value == invalid-type
    = invalid-type
. form = if is-optional then note-chain(id, id, object) else ChainForm.chain-plain
if form == .chain-absent || absent-after(object-syntax, object)
    = value
. optional = form == .chain-tested
object = link-receiver(object-syntax, object, own, optional)
if refuses-write(id, object, true)
    = invalid-type
if object == types.string-type && !holds-text(object-syntax)
    . message = "Assigning an item of a text makes a new text, and nothing holds this one, so the change is lost; assign the item of a text a name holds"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
. pointee = cpointer-item(object)
if pointee == types.void-type
    frame.diagnose(id, .stated, program.store-atom("Void has no physical address"))
    = invalid-type
if pointee != no-type
    facts.set-plan(instance, id, .plan-item)
    if op != .eq-op
        facts.set-node-type(instance, id, pointee)
        = assign-into(assignment, id, op, pointee, rhs, value)
    conversions.convert(id, rhs, value, pointee, .reason-assignment)
    = pointee
if op == .eq-op && tuple-arity-at(object, key-syntax)
    note-field(id, object, key-syntax)
    = extended-tuple(object, value)
. cell = view-index(object, key-syntax, true)
if cell == no-type
    cell = aggregate-field(object, key-syntax, key, types.index-assign-atom!, value)
    if cell != no-type
        note-field(id, object, key-syntax)
        . held = types.intrinsic-of(object)
        . stored = assign-into(id, id, op, cell, rhs, value, held == .struct)
        if op == .eq-op && held == .struct
            = cell
        = if op == .eq-op && held == .tuple then object else stored
if cell != no-type
    plan-view(id, eager-slot(row-struct-of(object), key-syntax))
    = assign-into(id, id, op, cell, rhs, value)
if op == .eq-op && is-range-type(key) && view-kind(object) != 0
    . same-item = row-struct-of(object) == row-struct-of(value)
    if view-kind(value) != view-kind(object) || !same-item
        . message = "Array view range assignment requires a compatible view"
        frame.diagnose(id, .stated, program.store-atom(message))
        = invalid-type
    plan-view(id)
    if !note-view-range(id, object-syntax, object, key-syntax, key)
        = invalid-type
    = types.void-type
if op == .eq-op && view-kind(object) != 0
    plan-view(id)
    conversions.convert(key-syntax, key-syntax, key, types.index-type, .reason-argument)
    = assign-into(id, id, op, row-struct-of(object), rhs, value)
. is-array = is-array-type(object) && !is-range-type(key)
. diagnosed = facts.diagnostics.length
if op != .eq-op
    . current = calls.operator-call(id, object, types.index-op-atom!, key-syntax, key)
    if current == invalid-type
        restate-index(diagnosed, id, object, key-syntax)
        = invalid-type
    . held = types.intrinsic-of(current)
    . alone = held != .struct && held != .tuple && (calls.has-operator(current, program.store-atom("$op"), value) • arg-syntax rhs)
    if alone
        facts.set-node-type(instance, id, current)
        facts.set-plan(instance, id, .plan-answer-item)
    . updated = assign-into(id, id, op, current, rhs, value, true)
    if alone
        = updated
    = calls.index-assign-call(id, object, key-syntax, key, rhs, current, is-array)
. literal = is-integer-literal(rhs)
. first-call FactId = facts.calls.length as FactId
. stored = calls.index-assign-call(id, object, key-syntax, key, rhs, value, is-array, literal)
if stored != invalid-type && array-item && first-call < facts.calls.length
    . store = facts.calls[first-call]
    if store.syntax == id && store.callee != no-instance && two-args
        calls.note-replaced-read(id, object, instances.argument-type(store.callee, 0))
    .. two-args = instances.signatures[store.callee].args.count == 2
.. array-item = is-array-value(value) && !is-range-type(key)
if stored != invalid-type && !optional && is-array && own-call && stores-item
    facts.set-plan(instance, id, .plan-array-item)
.. own-call = first-call < facts.calls.length && facts.calls[first-call].syntax == id
.. stores-item = calls.stores-array-item(facts.calls[first-call].callee)
if stored == invalid-type
    restate-index(diagnosed, id, object, key-syntax)
else if !optional
    store-through(id, object-syntax, object)
if stored != invalid-type && first-call < facts.calls.length && stores-row
    plan-table(id, .table-store)
else if stored != invalid-type && types.intrinsic-of(object) == .table-column && !is-range-type(key)
    plan-table(id, .table-item-store)
else if stored != invalid-type && is-range-type(key) && copies-range(object, value)
    if !note-view-range(id, object-syntax, object, key-syntax, key)
        = invalid-type
    plan-table(id, .table-range-store)
.. stores-row = stores-table-row(object, facts.calls[first-call].callee)
= stored

────────────────────
_ stores-table-row Bool
    - object TypeId
    - callee InstanceId

` Whether an index assigned of a table or a span of one stores a row at a single index, which
` TypeScript answers itself.
|? (kind != .table && kind != .table-span) || callee == no-instance
    false
??
    takes-two && instances.argument-type(callee, 0) == types.index-type

.. kind = types.intrinsic-of(object)
.. takes-two = instances.signatures[callee].args.count == 2

────────────────────
_ do copies-range Bool
    - object TypeId
    - given TypeId

` Whether a range of a table, of a span of one or of a view of a field's column is assigned
` from what TypeScript copies into it itself: the rows of a span or a table of struct or union
` rows, or the items of a view of the same field's type.
. kind = types.intrinsic-of(object)
. given-kind = types.intrinsic-of(given)
if kind == .table-column
    = given-kind == .table-column && class-arg(types, given, 0) == class-arg(types, object, 0)
if kind != .table && kind != .table-span
    = false
. row = types.intrinsic-of(row-struct-of(object))
= given-table && (row == .struct || row == .union) && row-struct-of(given) == row-struct-of(object)
    .. given-table = given-kind == .table-span || given-kind == .table

────────────────────
_ holds-text Bool
    - object-syntax SyntaxId

` Whether a text whose item is assigned is held where the new text is stored: not a literal, a
` text joined from parts, or one a cast or a call gives.
match tree.nodes[object-syntax]
    | .node-string-syntax
        false
    | .node-binary-expression
        false
    | .node-cast-expression
        false
    | .node-call-expression
        false
    ??
        true

────────────────────
_ do store-through
    - id SyntaxId
    - held-syntax SyntaxId
    - held TypeId

` Where the object of an index assigned is itself an index, has the `[]=` of the object that
` inner index reads from recorded, for the answer the type pass planned to be stored.
do match? tree.nodes[held-syntax]
    | .node-index-expression(row)
        . container = facts.node-type(instance, row.object)
        . key = facts.node-type(instance, row.index)
        . known = container != no-type && container != invalid-type
        if known && key != no-type && key != invalid-type && !row.is-optional
            calls.index-store-through(id, held-syntax, container, key, held)

────────────────────
_ do is-stack-local Bool
    - name SyntaxId

` Whether a name stands for a global bound anew by each `do with` that names it.
. resolution = bindings.resolution-of(frame.binding, name)
if resolution.kind != .resolve-global
    = false
do match? program.modules[resolution.module].decls[resolution.decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "stack"
= false

────────────────────
_ do target-of TypeId
    - lhs SyntaxId
    - narrowed Bool = false

do match? tree.nodes[lhs]
    | .node-identifier(ident)
        . resolution = bindings.resolution-of(frame.binding, lhs)
        do match resolution.kind
            |= .resolve-slot
                . slot = resolution.slot
                . known = if narrowed then frame.slot-type(slot) else slot-known(slot)
                = if known == no-type then read-slot(slot) else known
            |= .resolve-global
                = demand-global(lhs, resolution.module, resolution.decl)
            |= .resolve-member
                = read-member(lhs, ident.name).type
            ??
                = invalid-type
= infer(lhs)

━━━━━━━━━━━━━━━━━━━━
+ do checker-for Checker
    - session Session
    - instance InstanceId
    - around Checker? = null
    - probe Bool = false
    - nested Bool = false
    - trial SyntaxRange = SyntaxRange(0, 0)

` A checker for an instance, with the settings `Checker` takes. The kit of a checker that has
` finished is kept and used again, because making one allocates its frame, its calls, and every
` list they hold. The first checker a session makes lists its declarations before it types
` anything (`Checker.list-declarations`).
. idle = session.scratch.idle
if idle.length == 0
    . made = Checker(session, instance, CheckerKit(session), around, probe, nested, trial)
    made.list-declarations()
    = made
. parts = idle[idle.length - 1] as CheckerKit
idle.pop()
= Checker(session, instance, parts, around, probe, nested, trial)

━━━━━━━━━━━━━━━━━━━━
+ do type-written-in Bool
    - session Session

` Types each instance written in another that the passes of a parallel type pass typed and none is
` taken from (`Instances.written-in`), once the one it was written in is typed and did not type it
` in its run, as a closure called after that one finished is typed (`Checker.run-after-enclosing`).
` Says whether it typed any.
. instances = session.instances
. waiting = instances.written-in
. typed = false
. kept = 0
for position in 0 .. < waiting.length
    . id = waiting[position]
    . row = instances.rows[id]
    if row.state != .instance-unstarted
        continue
    . around = instances.rows[row.enclosing].state
    if around != .instance-done && around != .instance-failed
        waiting[kept] = id
        kept += 1
        continue
    . checker = checker-for(session, id)
    checker.run-after-enclosing()
    checker.retire()
    typed = true
while waiting.length > kept
    waiting.pop()
= typed

━━━━━━━━━━━━━━━━━━━━
_ LoopContainer is Tuple

+ type TypeId
+ item TypeId

━━━━━━━━━━━━━━━━━━━━
_ ThemeScope is Tuple

+ made TypeId
+ sheet TypeId
+ statement SyntaxId
+ number U32

━━━━━━━━━━━━━━━━━━━━
_ ClassName is Tuple
    is Hashable

` What tells a class apart from the others of its module: its name and the number of type
` parameters it takes.

+ name Atom
+ arity U32

╌╌╌╌╌╌╌╌╌╌ is Hashable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get hash Hash

hash-for(name) /xor/ hash-for(arity)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ this == other This

name == other.name && arity == other.arity

━━━━━━━━━━━━━━━━━━━━
_ RowCursor is Tuple

` A slot a pattern bound to the case of a row of a table of unions, and what it stands for.

+ slot SlotId
+ capture RowCapture

━━━━━━━━━━━━━━━━━━━━
_ AssumedResult is Tuple

` What an action under a helper took for the type its pattern's arms give where they declare
` none, the type of its own value, and what its choices rest on: whether a name it reads
` selected a materializer, whether it is `it` alone, and where it is a captured name alone,
` what that name holds and whether it holds text; the action, the pattern it follows and its
` expression; and the value materializer taken to make its value again, which is called only
` once the arms are known to give that type.

+ value TypeId
+ selects Bool
+ forwards-it Bool
+ forwarded TypeId
+ backed Bool
+ site SyntaxId
+ pattern SyntaxId
+ body SyntaxId
+ interface TypeId

━━━━━━━━━━━━━━━━━━━━
_ NamedEvent is Tuple

` An event a node names: the class that declares it, as the object's type has it, its name,
` what it publishes, and the type of its key where it is published by key, with the node that
` indexes it with a key where one does. A private event does not bubble.

+ owner TypeId
+ name Atom
+ payload TypeId
+ key TypeId = no-type
+ address SyntaxId = 0
+ is-private Bool = false

━━━━━━━━━━━━━━━━━━━━
_ CalledObject is Tuple

` The object a method is called on, typed before the arguments of the call as the reference
` evaluates it (`type-called-object`): its node, its type, what it links an optional chain to,
` and the event it names where it names one.

+ object SyntaxId = 0
+ type TypeId = no-type
+ link TypeId = no-type
+ event NamedEvent? = null

━━━━━━━━━━━━━━━━━━━━
_ FoldedNumber is Tuple

` The bits a constant number folds to, where it `folds`.

+ bits U64
+ folds Bool

━━━━━━━━━━━━━━━━━━━━
_ WantRole is U32

` What the context of a node asks of it. Of the type it expects: a function given as a value
` chosen by a condition is of that type (`want-fitting`), the sides of `if condition then value
` else other` are joined at it (`want-choice`), a case a call names by its symbol alone is one of
` it (`want-owner`), and a value that leaves the node there is of it, so that an event the node
` names gives its endpoint where the type is the event's `Broadcastable`, reported at the place
` asked (`want-escape`). Of an event the node names: it is an argument of a call
` (`want-argument`), the container of a loop that adapts it (`want-adapt`), asked for itself
` (`want-event`), or the value of a property stored to (`want-store`). And of the node itself: it
` is the object a member is read from or called on, which `super` may be (`want-receiver`), a
` statement whose value nothing uses (`want-unused`), one of the statements a function gives its
` value from (`want-quasi`), a statement (`want-statement`), the operand of `!`, which reads
` what a property holds where the flow knows it holds a value (`want-forced`), a match written
` as a statement, whose arms are one for their own alone (`want-match-statement`), a line of a
` markup body (`want-content-line`), the container of a markup loop region, which the region
` observes itself (`want-observed`), the name of a pattern a pattern compares with or calls
` (`want-pattern`), or a list written with its items, which are each made the item of the list
` type it expects where each converts to it (`want-items`).

| want-none = 0
| want-fitting = 1
| want-choice = 2
| want-owner = 4
| want-escape = 8
| want-argument = 16
| want-adapt = 32
| want-event = 64
| want-store = 128
| want-receiver = 256
| want-unused = 512
| want-quasi = 1024
| want-statement = 2048
| want-forced = 4096
| want-match-statement = 8192
| want-content-line = 16384
| want-observed = 32768
| want-pattern = 65536
| want-items = 131072

━━━━━━━━━━━━━━━━━━━━
_ Want is Tuple

` What the context of a node asks of it where its syntax does not say: the type it expects of the
` node, what that type is for there and the roles the node has (`WantRole`), and where a value
` that escapes it is reported. `infer` gives it to that node alone, and a node gives the one inside
` it that stands for it what it was asked.

+ type TypeId = no-type
+ roles U32 = 0
+ place SyntaxId = 0

────────────────────
+ asks Bool
    - role WantRole

(roles /and/ (role as U32)) != 0

────────────────────
+ asking Want
    - role WantRole
    - type TypeId

Want(type, roles /or/ (role as U32), place)

────────────────────
+ adding Want
    - role WantRole

Want(type, roles /or/ (role as U32), place)

────────────────────
+ escaping Want
    - type TypeId
    - place SyntaxId

Want(type, roles /or/ (WantRole.want-escape as U32), place)

━━━━━━━━━━━━━━━━━━━━
_ Found is Tuple

` What typing a node found beside its type: what a link of an optional chain gives by itself,
` which the chain holds in no optional between its links (`link`); the event it names where it was
` asked for one or stored, kept in `found-events` (`event`), and whether a member a markup element
` receives names it (`kept`); whether a property read where it is stored is in doubt (`doubted`);
` and whether the property `!` reads holds a value the flow knows of (`held`).

+ type TypeId
+ link TypeId = no-type
+ event U32 = U32.max
+ kept Bool = false
+ doubted Bool = false
+ held Bool = false

────────────────────
+ typed Found
    - type TypeId

Found(type, link, event, kept, doubted, held)

────────────────────
+ linking Found
    - link TypeId

Found(type, link, event, kept, doubted, held)

────────────────────
+ doubting Found
    - doubted Bool

Found(type, link, event, kept, doubted, held)

────────────────────
+ holding Found
    - held Bool

Found(type, link, event, kept, doubted, held)

━━━━━━━━━━━━━━━━━━━━
_ LiveContext is U8

` The live action of the reference open where a node is compiled: none, the one the value of
` a property runs in, another, the one a rule of a class runs in, the one the value of an
` assignment or a lazy declaration runs in that a function of its own runs again, the one
` the `whenever` clause of a loop on a stream is tested in, which a function of its own tests
` again, the one the conditions of a markup branch region or the container of a markup loop
` region are read in, which a function of its own reads again, or the one the condition a style
` rule written on a markup element is applied under is tested in as a gate is made, which a
` function of its own tests again.

| live-none = 0
| live-value = 1
| live-other = 2
| live-rule = 3
| live-statement = 4
| live-whenever = 5
| live-region = 6
| live-gate = 7

━━━━━━━━━━━━━━━━━━━━
_ LoopSource is Tuple

` What the container of a markup loop region is to the region, as the reference's
` `markupLoopSource` finds it: the item of its rows, the type the region is given it as, and its
` kind, which names the markup runtime's function that makes the region of it: `collection`,
` `broadcastable` or `iterable`. The invalid type for the item where there is none.

+ item TypeId
+ given TypeId
+ kind String

━━━━━━━━━━━━━━━━━━━━
_ FirstItems is U8

` What the reference knows of the item a part of a stream pattern starts with: it may start
` with anything, or it may match nothing; it starts with any item; it must start with one of
` certain characters; or it is shaped so that what the reference knows is not known here.

| first-open = 0
| first-any = 1
| first-ranges = 2
| first-unsure = 3

━━━━━━━━━━━━━━━━━━━━
_ SelectionEffects

` What the body of a loop over a selection of a table's rows may change, as TypeScript's loop
` over rows notes it: a table's storage, the indices, or a table that grows; or that what it
` changes is not known.

+ table Bool
+ indices Bool
+ selected-table Bool
+ unknown Bool

━━━━━━━━━━━━━━━━━━━━
_ Machining is Tuple

` The machine being typed (`type-machine`): its syntax and where it is stored, the instance of the
` machine above that it refines, the name of a machine nested in a case and whether its parts
` start with the machine around it; its parts (`items`), its cases and the names each keeps, the
` payload each case is given and the types of what each keeps, the cases it starts in, those
` typed and those waiting to be, and the groups found. A nested machine is typed in a frame of its
` own (`type-nested-machine`).

+ syntax SyntaxId
+ store MachineStore
+ refined InstanceId
+ named Atom?
+ outer-starts Bool
+ items [SyntaxId]
+ cases [SyntaxId]
+ kept [[Atom]]
+ payloads [TypeId]
+ kept-types [[TypeId]]
+ starts [SyntaxId]
+ typed [SyntaxId]
+ waiting [SyntaxId]
+ groups-found [MachineGroup]

━━━━━━━━━━━━━━━━━━━━
_ Matching is Tuple

` The match being typed (`infer-match`): whether it gives an optional, the block of a match that
` covers its subject and of one whose arms are blocks (`closed` and `arms`), whether `if` or
` `while` tests it (`open`), whether its subject reads a row of a table, the subject a case
` written alone is a case of, and the type of the subject.

+ optional Bool
+ closed SyntaxId = 0
+ arms SyntaxId = 0
+ open Bool
+ rows Bool
+ case SyntaxId = 0
+ subject TypeId = no-type

━━━━━━━━━━━━━━━━━━━━
_ Arming is Tuple

` The arms being typed (`infer-arms`): whether they stand as a statement, where their values
` start on the typing scratch, the type expected of them, whether they unite and where the types
` they unite start, how many may run and whether several do, the slot of the subject's `it`, and
` how deep the arms that test for a present value are.

+ statement Bool
+ start ScratchMark = 0
+ expected TypeId = no-type
+ unite Bool
+ union ScratchMark = 0
+ possible U32
+ several Bool
+ it SlotId = no-slot
+ present-depth U32

━━━━━━━━━━━━━━━━━━━━
_ ArmTyping is Tuple

` The arm being collected (`collect-arms`): the slot of its `it`, the symbol a choice in it
` names, and the force its value reads through.

+ it SlotId = no-slot
+ symbol SyntaxId = 0
+ forced SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
_ RuleStream is Tuple

` The stream a pattern written in code runs on: the stream match being typed, and the stream a
` local rule is called on, with whether its pattern reads a String's UTF-8 bytes.

+ matched SyntaxId = 0
+ stream TypeId = no-type
+ encoded Bool

━━━━━━━━━━━━━━━━━━━━
_ Valuing is Tuple

` What the part of a stream pattern being typed gives: whether it gives no value of its own, and
` the arm whose action is being typed.

+ unvalued Bool
