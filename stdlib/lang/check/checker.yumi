            note-span-range()
        if declaration.kind == .default-constructor-decl
            note-class-targets(receiver)
            demand-filler(receiver, owner-syntax())
            demand-rules(receiver, owner-syntax())
            demand-styles(receiver, owner-syntax())
            register-queries(receiver, owner-syntax())
        own-markup-actions(receiver, owner-syntax())
        if opened
            frame.close-env()
        finish-errors(frame)
        scratch.outgoing.rewind(frame.outgoing-start)
    if declaration.kind == .default-constructor-decl
        . base = types.base-of(receiver)
        while base && types.completions[base].intrinsic == .class
            . class-syntax = owner-syntax()
            conversions.convert(class-syntax, class-syntax, receiver, base, .reason-receiver)
            base = types.base-of(base)
    =

prepare()
. door = program.effects.door-of(module, frame.decl)
if door && instances.fake-of(instances.rows[instance].effects, door) != no-type
    check-forwarder(door)
    =
. ruled = rule-match(program, module, frame.decl)
if ruled != 0
    check-rule(declaration, ruled)
    =
if is-constructor-kind(declaration.kind)
    check-property-defaults(frame.self-type)
    check-constructor-fills()
. builds = is-constructor-kind(declaration.kind) && !returns-own(tree, declaration.body)
if builds && declaration.kind == .constructor-decl && !declaration.is-generated
    note-class-targets(frame.self-type)
    if writes-content(frame.self-type) && tree.leaves-early(declaration.body)
        decline(declaration.body)
    else
        demand-filler(frame.self-type, declaration.syntax)
    demand-rules(frame.self-type, declaration.syntax, declaration.body)
    demand-styles(frame.self-type, declaration.syntax)
    register-queries(frame.self-type, declaration.syntax)
if is-constructor-kind(declaration.kind)
    own-markup-actions(frame.self-type, declaration.syntax)
if declaration.kind == .constructor-decl && !declaration.is-generated && !builds
    instances.mark-returns-own(instance)
if declared-return != no-type && declared-return != types.bool-type
    if answers-bool(program, module, frame.decl)
        . message = program.store-atom("Operator must return Bool")
        frame.diagnose(declaration.syntax, .stated, message)
. unbuildable = builds && lacks-self()
. declared = declared-return
. intrinsic = if bodiless then math-intrinsic-return() else no-type
    .. bodiless = declaration.body == 0 && declared == no-type
. promises = instances.signatures[instance].header == .header-settled
. promised = instances.signatures[instance].returns
if declared != no-type
    instances.set-returns(instance, read-return(declaration, declared), declared, .return-declared)
else if intrinsic != no-type
    instances.set-returns(instance, intrinsic, no-type, .return-inferred)
else if !promises
    . evident = evident-return(declaration)
    . provisional = if evident != no-type then evident else types.void-type
    instances.set-returns(instance, provisional, no-type, .return-pending)

. value = no-type
if declaration.is-main
    check-top-level(tree.root)
else
    value-syntax = declaration.body
    if declaration.kind == .closure-decl && !declaration.is-imperative
        check-closure-rows(declaration.body)
    . body-symbol = tree.symbol-of(declaration.body)
    if body-symbol && declared != no-type
        value = infer-with-expected(declaration.body, declared)
    else
        quasi-free-block = if !declaration.is-imperative then declaration.body else 0
        discarding-block = if imperative-body then declaration.body else 0
            .. imperative-body = declaration.is-imperative || declaration.kind == .constructor-decl
        if !declaration.is-imperative
            expect-bullets(declaration.body, declared)
        value = check-statement(declaration.body)
        if discarding-block == declaration.body && !(tree.nodes[declaration.body] is .node-block)
            check-called(declaration.body, value)
        . valueless = tree.is-quasi-syntax(declaration.body) && !assigns(declaration.body)
        if !declaration.is-imperative && valueless
            value = no-type
        if discards-result()
            value = no-type
        if declaration.kind == .task-decl
            check-task-handlers(declaration.syntax)
    . leaves = narrowing.exits(declaration.body, false, false, true, true)
    giving = giving.falls-through = declaration.is-imperative && !leaves
    check-unreturned(declared)
    . converts = !declaration.is-imperative && value != no-type && value != types.void-type
    if converts && declared != no-type && declared != types.void-type
        calls.note-context-cast(value-syntax, declared, .cast-return)
        . site = tree.return-site(value-syntax)
        . located = not-string || declared == types.bool-type || types.is-optional(declared)
            .. not-string = !tree.is-string-syntax(value-syntax)
        conversions.convert(site, value-syntax, value, declared, .reason-return, located)

. unwritten = unwritten-return(declaration, declared, intrinsic)
if unwritten != 0 && !refuses-unwritten()
    instances.mark-gives-unwritten(instance)
    construct-value(unwritten, declared)

if declared == no-type && intrinsic == no-type
    settle-symbol-returns()
    value = settle-literal-returns(value)
    if building-list
        settle-built-list()
    else
        . unified = infer-return(frame, giving, value)
        if unified != no-type && unified != invalid-type
            convert-returns(unified, instances.signatures[instance].returns)
else if declared != no-type && !giving.yields
    narrow-declared-return(frame, declared, value)
if default-site != 0 && !giving.yields
    refuse-default(default-site)
. generates = giving.yields && !building-list
if generates
    instances.mark-generator(instance)
    frame.check-allocates(declaration.syntax)
if is-close-method(declaration) || is-generator-end(declaration)
    instances.mark-may-panic(instance)
if is-generator-end(declaration)
    . stepped = types.optional-around(first-arg(frame.self-type))
    . raised = step-result(types, frame.self-type, stepped)
    . ended = if raised != no-type then raised else stepped
    types.complete(ended)
    instances.mark-ends-generator(instance, ended)
if is-close-method(declaration)
    demand-live-action-cleanup()
    if has-events(frame.self-type)
        demand-event-close()
        facts.event-closers += instance
. lacks = false
if !declaration.is-main && !declaration.is-imperative && declaration.body != 0
    . produced = instances.signatures[instance].returns
    . empty = produced == types.void-type || produced == no-type
    . wants-value = declared != no-type && declared != types.void-type
    . valueless = wants-value && (value == no-type || value == types.void-type)
    . is-stated = first-stated(declaration.body) != 0
    . falls-off = valueless && !giving.yields && unexited && !discards-result() && !is-stated
        .. unexited = !narrowing.exits(declaration.body, false, false, true)
    if falls-off
        frame.diagnose(declaration.syntax, .non-void-return)
    lacks = empty && !falls-off && !discards-result() && !is-stated
else if lacks-result(declaration, declared, intrinsic)
    frame.diagnose(declaration.syntax, .non-void-return)
finish-errors(frame, lacks, unbuildable)
if generates
    demand-errors(instance)
if generates && declared != no-type
    . steps = instances.rows[instance].step-errors
    . returned = generator-return(declared, steps)
    if types.intrinsic-of(returned) == .interface
        record-witness(generator-of(first-arg(returned), steps), returned)
    instances.set-returns(instance, returned, declared, .return-declared)
if generates
    note-generator()
?! Panic("A body gave a return type other than the one its header promised")
    if promises && instances.signatures[instance].returns != promised
demand-materialized(declaration)
if in-zone-body
    leave-region()
close()

────────────────────
_ do check-forwarder
    - effect U32

` A door typed under a `do with` that binds a fake to its effect, which calls the fake's method in
` place of its body (`Calls.answer-door`).
. declared = if declared-return != no-type then declared-return else types.void-type
instances.set-returns(instance, declared, declared, .return-declared)
calls.answer-door(frame.decl, effect, declared)
finish-errors(frame)
close()

────────────────────
_ do member-type TypeId
    - owner TypeId
    - name Atom

=? no-type if owner == no-type || owner == invalid-type
. found = property-named(owner, name)
=? no-type if !found
. property = types.properties[found]
= if property.type != no-type then property.type else demand-member(property, owner, name)

────────────────────
_ do check-retest
    - clause SyntaxId

` The function a live action runs to test a `whenever` clause again, as the reference compiles
` it: the clause's value typed again as the body of a closure that answers nothing, and the
` broadcaster's `subscribe` and `unsubscribe`, each given the subscription made where the loop
` is written, kept apart from the calls of the clause's nodes (`facts.whenever-calls`). Their
` errors are given to the global `unhandled-error` where they are raised (`hands-off-raising`). Where
` an object owns the subscription, the tracker kept there is converted to a `Tracker` at the
` clause instead, to be added to the trackers of the action that runs the function.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. resolution = bindings.resolution-of(frame.binding, clause)
. passed = infer(tree.clause-expr(clause))
. owns = facts.owned-subscription-of(instances.rows[instance].enclosing, clause) != null
if passed != types.bool-type || resolution.kind != .resolve-slot
    decline(clause)
else if owns
    . tracker = types.well-known-type("core/tracker", "Tracker")
    demand-live-runtime()
    if tracker == invalid-type || instances.live.add-tracker == no-instance
        decline(clause)
    else
        conversions.convert
            - clause
            - clause
            - frame.slot-type(resolution.slot + 1)
            - tracker
            - .reason-argument
        facts.whenever-calls += WheneverCalls(instance, true)
else
    . subscription = frame.slot-type(resolution.slot + 1)
    . stream = frame.slot-type(resolution.slot + 2)
    . subscribable = types.well-known-type-of("core/stream", "Subscribable", first-arg(stream))
    if subscribable == invalid-type
        decline(clause)
    else
        conversions.convert(clause, clause, subscription, subscribable, .reason-argument)
        . adds = calls.protocol-call
            - stream
            - program.store-atom("subscribe")
            - clause
            - subscribable
            - false
            - no-type
            - no-type
            - false
        . drops = calls.protocol-call
            - stream
            - program.store-atom("unsubscribe")
            - clause
            - subscribable
            - false
            - no-type
            - no-type
            - false
        if untyped-calls || no-facts || !hands-off-raising(adds.fact) || !hands-off-raising(drops.fact)
            decline(clause)
        else
            facts.whenever-calls += WheneverCalls(instance, false, adds.fact, drops.fact)
        .. untyped-calls = adds.answer == invalid-type || drops.answer == invalid-type
        .. no-facts = adds.fact == no-fact || drops.fact == no-fact
finish-errors(frame)
close()

────────────────────
_ do check-filler
    - declaration CheckedDecl

` The function that fills an object with the markup written in its class. It runs the function of
` the class above, where that class or one above it writes markup, and then each line of its own
` class's markup as content of the object: a line that gives a value is taken by the object's `+=`,
` or else its `++=`, as a line of an element's body is. The lines of a root `<This` that assign are
` no lines of it: each is the first value of a property; nor are the lines of the class's `• This`
` that are the rule's own, where its other lines are the markup (`rule-lines`). Without a root, a
` line that assigns is a statement, as one in a function is, unless a class above writes markup: the
` reference takes it then for an attribute it drops, and it is declined. Where the markup of a class
` above holds slot outlets, its function is given a builder for each slot this one was given one
` for, and for each the lines of its own markup give, as an element's lines give the slots of its
` class (`supply-slots`), but those this one was given, which win; where it holds the default
` outlet, the lines that give the default slot are no lines of this markup, and are dropped where
` this one was given that slot. A line that gives a slot of a class above none of whose markup holds
` outlets is declined. It answers nothing and raises nothing: an error that leaves it is given to
` `unhandled-error`, as the reference gives it (see `hands-off`). Lines with no shape here are
` declined, and so is the markup of a class whose lines are linked neither by its own `+=` and `++=`
` nor through the markup protocol, but where a class above holds the default slot, which takes them.
` The rules of its own class that wait for the markup run after the lines, so it may panic where
` there are any, and a `when` or `whenever` rule among them gives the object a live action
` (`own-markup-actions`). Its markup sees the styles and style sheets of the markup that made the
` object, with its class's (`load-context`), and so does that of the class above. A class whose
` markup is only state machines the object keeps needs no way to take lines. A state machine written
` beside a root `<This` runs where it is written among the root's lines, as the reference runs it.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. receiver = frame.self-type
. site = owner-syntax()
if clashes-element(receiver, declaration.syntax)
    finish-errors(frame)
    close()
    =
if !load-context(receiver, site)
    finish-errors(frame)
    close()
    =
. ref = class-ref(types, receiver)
. owner = program.modules[ref.module]
live-owned = false
for part in sheet-parts(ref)
    . written = program.modules[part.module]
    for member in written.member-pool[part-members(part)]
        do match? written.decls[member]
            | .decl-rule(rule)
                if waits-for-markup(receiver, part.module, rule.syntax)
                    instances.mark-may-panic(instance)
                    if is-live-rule(written.tree, rule.syntax)
                        live-owned = true
own-markup-actions(receiver, site)
. base = types.base-of(receiver) ?? no-type
. given = base != no-type && holds-slot(base)
. own = is-markup-host(receiver) && !given
if takes-nothing && !own && !given && !only-machines(declaration.body)
    decline(site)
    finish-errors(frame)
    close()
    =
.. takes-nothing = !takes-lines(receiver) && !takes-hosted(receiver)
. above = base != no-type && writes-content(base)
. body = declaration.body
. rooted = tree.root-this(frame.declaration.syntax) != 0
. ruled = tree.nodes[frame.declaration.syntax] is .node-rule-syntax
. dropped = if above && !rooted && !ruled then assigning-line(body) else 0u32
. lines [SyntaxId]
if wraps-default(body)
    lines += body
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if binds-slot(statement)
                lines += statement
. names [Atom]
. wanted [TypeId]
. items [TypeId]
. slots [Atom]
. builders [TypeId]
if !hold-builders(receiver, site)
    finish-errors(frame)
    close()
    =
if above && holds-outlets(base)
    . reported = facts.diagnostics.length
    if !class-outlets(base, names, wanted, items)
        if facts.diagnostics.length == reported
            decline(site)
        finish-errors(frame)
        close()
        =
    if names.find(program.store-atom("")) != null && gives-default(body, ruled)
        decline(body)
        finish-errors(frame)
        close()
        =
    for name in names
        . argument = instances.slot-argument(instance, name)
        if argument != U32.max
            add-slot(name, instances.argument-type(instance, argument), slots, builders)
    . styles [TypeId]
    if program.module-by-name("core/style")
        for style in markup-styles
            styles += style
        if !add-visible-styles(base, styles, site)
            finish-errors(frame)
            close()
            =
    . sheets [TypeId]
    . levels [U32]
    visible-sheets(base, sheets, levels)
    . scopes [ScopeUse]
    . scoped = scoping-any() && scopes-known()
    for position in 0 .. < incoming-scopes
        scopes += rule-scopes[position]
    if scoped && !base-scopes(receiver, base, scopes, site)
        finish-errors(frame)
        close()
        =
    if !give-lines(lines, names, wanted, items, styles, sheets, levels, slots, builders, base, scopes, scoped, true)
        finish-errors(frame)
        close()
        =
else if lines.length != 0
    decline(lines[0])
    finish-errors(frame)
    close()
    =
if above
    . call = calls.filler-call(base, site, slots, builders, content-context())
    if call == no-fact
        decline(site)
    else
        facts.note-filler(instance, call)
        conversions.convert(site, site, receiver, base, .reason-receiver)
. defaulted = names.find(program.store-atom("")) != null
. beside = tree.root-machines(frame.declaration.syntax, false).length + machines-after
    .. machines-after = tree.root-machines(frame.declaration.syntax, true).length
if beside != 0 && (defaulted || (body == 0 && given))
    decline(site)
if body != 0 || (beside != 0 && !defaulted && !given)
    if dropped != 0 && tree.binds-line(dropped)
        misplaced-binding(dropped)
    else if dropped != 0
        decline(dropped)
    else if defaulted
        do match? tree.nodes[body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    if !ruled || !tree.rule-part(statement)
                        facts.note-content-link
                            - ContentLink(instance, statement, receiver, no-type, no-fact)
    else if given || !is-plain-body(body, rooted, ruled)
        if tree.binding-line(body) != 0
            misplaced-binding(tree.binding-line(body))
        else
            decline(body)
    else
        . bodied = body != 0 && (rooted || lines.length != 0)
        content-blocks += body
        content-parents += receiver
        content-names += true
        if bodied
            element-bodies += body
        rule-lines = if ruled then body else 0
        for machine in tree.root-machines(frame.declaration.syntax, false)
            check-statement(machine)
        if body != 0
            check-statement(body)
        for machine in tree.root-machines(frame.declaration.syntax, true)
            check-statement(machine)
        rule-lines = 0
        content-blocks.pop()
        content-parents.pop()
        content-names.pop()
        if bodied
            element-bodies.pop()
hand-off-outgoing(site)
finish-errors(frame)
close()

────────────────────
_ do hand-off-outgoing
    - site SyntaxId

` Gives what leaves the function being checked to the global `unhandled-error` (see
` `hands-off`), as the reference's function that fills an object with the markup of its class
` does, and its function a live action runs a statement again with: the function raises nothing,
` and each call that lets errors out lets them out to where they are given, a call whose
` callee's errors are not yet known too.
if scratch.outgoing.since(frame.outgoing-start).length == 0
    =
if !hands-off(instance)
    decline(site)
for row in scratch.outgoing.since(frame.outgoing-start)
    if row.call != U32.max
        facts.calls[row.call].propagates = true
scratch.outgoing.rewind(frame.outgoing-start)

────────────────────
_ do only-machines Bool
    - body SyntaxId

` Whether each line of the markup of the class whose object the function being checked fills
` is a state machine the object keeps, and there is one.
. content = frame.declaration.syntax
. machines = tree.content-machines(content)
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if tree.runs-line(content, statement) && machines.find(statement) == null
                = false
        = machines.length != 0
= false

────────────────────
_ kept-machine Bool
    - line SyntaxId

` Whether a line is a state machine written in the markup of the class whose object the
` function being checked fills, which the object keeps.
frame.declaration.is-content && tree.content-machines(frame.declaration.syntax).find(line) != null

────────────────────
_ do misplaced-binding
    - line SyntaxId

. outlet = tree.nodes[tree.attribute-element(line)] is .node-slot-outlet
. message = if outlet then "A slot outlet cannot bind with \"<->\", since what fills the slot is made elsewhere; bind the property in the element that fills it" else "\"<->\" binds a property of a markup element to a place, so it is written in the element's body; to store a value here, write \"=\""
frame.diagnose(line, .stated, program.store-atom(message))

────────────────────
_ do demand-filler
    - receiver TypeId
    - site SyntaxId

` A constructor of a class that writes markup, or is below one that does, runs the function
` that fills the object once its own body has: the call is kept for the constructor. The
` function is given the builder of each slot the constructor is given one for, which it passes
` on, but the function that gives an element's name its object, which the constructor runs
` itself, and for the styles and style sheets the constructor is made for.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
if !writes-content(receiver)
    =
. slots [Atom]
. builders [TypeId]
. given = instances.rows[instance].slots.count
. first = instances.signatures[instance].args.count - given
. passed = if instances.takes-binder(instance) then given - 1 else given
for offset in 0 .. < passed
    slots += instances.slot-name(instance, offset)
    builders += instances.argument-type(instance, first + offset)
. call = calls.filler-call(receiver, site, slots, builders, instances.rows[instance].context)
if call == no-fact
    decline(site)
    =
facts.note-filler(instance, call)
defer-values(receiver)

────────────────────
_ do runs-later Bool
    - id SyntaxId

` Whether a node is written in the body of a `whenever` rule of a class on a value, which the
` reference runs only where the value changes, never in the run the constructor makes, which
` takes the value alone: a member read there is read as it is, as the reference reads it.
. unit = instances.rows[instance]
if unit.initializer == 0
    = false
. tree = program.modules[unit.module].tree
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-rule(row)
        do match? tree.nodes[row.syntax]
            | .node-whenever-rule-syntax(rule)
                if rule.kind.text != "value" || rule.body == 0
                    = false
                = tree.subtree-start(rule.body) <= id && id <= rule.body
= false

────────────────────
_ do keeps-whole Bool
    - name Atom

` Whether a name is the whole value a `whenever` rule of a class keeps. The reference runs such
` a rule from the constructor, before the markup has, where an element not yet made reads as no
` object, and runs its body only once the element is written, so the rule may read that one.
. unit = instances.rows[instance]
if unit.initializer == 0
    = false
. tree = program.modules[unit.module].tree
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-rule(row)
        do match? tree.nodes[row.syntax]
            | .node-whenever-rule-syntax(rule)
                do match? tree.nodes[rule.expr]
                    | .node-identifier(read)
                        = read.name == name
= false

────────────────────
_ do constructor-events [NamedEvent]
    - receiver TypeId
    - chain [TypeId]

` Each event of the object itself that a loop in the body of a constructor of a class of the
` chain subscribes to, outside the functions written there.
. heard [NamedEvent]
for holder in chain
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    . tree = owner.tree
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-function(fn)
                        if fn.kind != .constructor-decl || fn.is-generated || fn.body == 0
                            continue
                        . floor = tree.subtree-start(fn.body)
                        . node = fn.body + 1
                        while node > floor
                            node -= 1
                            do match? tree.nodes[node]
                                | .node-function-syntax
                                    node = tree.subtree-start(node)
                                | .node-for-block(block)
                                    do match? tree.nodes[block.loop]
                                        | .node-loop-syntax(loop)
                                            if loop.is-subscriber
                                                . found = own-event
                                                    - receiver
                                                    - ref.module
                                                    - loop.container
                                                if found
                                                    heard += found
= heard

────────────────────
_ do section-loop SyntaxId
    - module ModuleId
    - syntax SyntaxId

` The loop a section of a class writes, or none.
. tree = program.modules[module].tree
do match? tree.nodes[syntax]
    | .node-subscriber-syntax(section)
        = section.iterator
= 0

────────────────────
_ do section-event NamedEvent?
    - receiver TypeId
    - module ModuleId
    - syntax SyntaxId

` The event of the object itself a section of a class subscribes to in a loop of one header,
` or none.
. tree = program.modules[module].tree
. iterator = section-loop(module, syntax)
if iterator == 0
    = null
do match? tree.nodes[iterator]
    | .node-for-block(block)
        if block.next != 0
            = null
        do match? tree.nodes[block.loop]
            | .node-loop-syntax(loop)
                if loop.is-subscriber && loop.next == 0 && loop.container != 0
                    = own-event(receiver, module, loop.container)
= null

────────────────────
_ do own-event NamedEvent?
    - receiver TypeId
    - module ModuleId
    - container SyntaxId

` The event of the object itself a container names: its name alone, read from `this`, or read
` from the class that declares an event that bubbles.
. tree = program.modules[module].tree
do match? tree.nodes[container]
    | .node-identifier(row)
        = event-of(receiver, row.name, true)
    | .node-get-expression(get)
        do match? tree.nodes[get.object]
            | .node-identifier(row)
                if row.name.text == "this"
                    = event-of(receiver, get.name, true)
            | .node-type-identifier
                = bubbling-event-of(receiver, module, tree, get.object, get.name)
            | .node-type-arguments
                = bubbling-event-of(receiver, module, tree, get.object, get.name)
= null

────────────────────
_ do bubbling-event-of NamedEvent?
    - receiver TypeId
    - module ModuleId
    - tree AST
    - written SyntaxId
    - name Atom

` The event a class written in a section of `receiver`'s class declares, where it bubbles: one
` that is not private and is published by no key.
. declarer = invalid-type
do match? types.rows[receiver]
    | .type-class(row)
        . env = types.class-env-for(row.module, row.decl, row.args, receiver)
        declarer = types.evaluate-type(module, tree, written, env)
        types.env-release(env)
if declarer == invalid-type || declarer == no-type
    = null
if types.intrinsic-of(declarer) != .class && types.intrinsic-of(declarer) != .interface
    = null
. found = event-of(declarer, name, true)
if !found || found.is-private || found.key != no-type
    = null
= found

────────────────────
_ do query-type TypeId
    - ref DeclRef
    - written SyntaxId
    - level TypeId = no-type

` The type a class writes for a property where it queries the markup an object is in,
` `Ancestor'T` or `Descendants'T` of the markup runtime with one argument, or no type: for the
` parameters a `level` of the class with type parameters gives it, where one is given.
do match program.modules[ref.module].tree.nodes[written]
    | .node-type-arguments
    ??
        = no-type
. owner = program.modules[ref.module]
. env = types.class-env(ref.module, ref.decl)
if level != no-type
    do match? types.rows[level]
        | .type-class(row)
            if row.args.count != 0
                types.env-release(env)
                env = types.class-env-for(row.module, row.decl, row.args, level)
. type = types.evaluate-type(ref.module, owner.tree, written, env)
types.env-release(env)
do match? types.rows[type]
    | .type-class(row)
        if row.args.count == 1 && (ancestor-query || descendant-query)
            = type
        .. ancestor-query = types.ancestor-decl.refers-to(row.module, row.decl)
        .. descendant-query = types.descendants-decl.refers-to(row.module, row.decl)
= no-type

────────────────────
_ do query-target TypeId
    - query TypeId

` The class a query of the markup an object is in looks for: its one argument.
do match? types.rows[query]
    | .type-class(row)
        = types.child-type(row.args, 0)
= no-type

────────────────────
_ do note-open-targets
    - ref DeclRef
    - members RowRange'DeclId

` Notes the classes a class with type parameters may look for among the descendants of its markup
` host once typing makes it for some (`note-class-targets`): the class of each `Descendants'T` it
` declares and of each `whenever children T` and `whenever descendants T` rule it writes, or any
` class, where `T` is not a class.
. owner = program.modules[ref.module]
. env = types.class-env(ref.module, ref.decl)
for member in owner.member-pool[members]
    . target = no-type
    do match? owner.decls[member]
        | .decl-property(property)
            . query = if typed then query-type(ref, property.type-syntax) else no-type
                .. typed = property.type-syntax != 0
            if query != no-type && !is-ancestor-query(query)
                target = query-target(query)
        | .decl-rule(rule)
            do match? owner.tree.nodes[rule.syntax]
                | .node-whenever-rule-syntax(written)
                    if written.kind.text == "children" || written.kind.text == "descendants"
                        target = types.evaluate-type
                            - ref.module
                            - owner.tree
                            - written.target-type
                            - env
    if target == no-type || target == invalid-type
        continue
    if types.intrinsic-of(target) == .class
        . key = class-ref(types, target).key
        if facts.open-targets.find(key) == null
            facts.open-targets += key
    else
        facts.opens-any-target = true
types.env-release(env)

────────────────────
_ do note-class-targets
    - receiver TypeId

` Numbers, after those of the program (`find-query-targets`), the classes each class of an
` object with type parameters looks for among the descendants of its markup host, for the
` parameters the object's class gives it, base first: those of the properties it declares as
` `Descendants'T`, then of its `whenever children T` and `whenever descendants T` rules, as the
` reference numbers them when it first makes the class for those parameters, before any of its
` objects is made.
find-query-targets()
. chain [TypeId]
. level TypeId? = receiver
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . current = chain[chain.length - 1 - position]
    do match? types.rows[current]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(class)
                    if class.type-args.count != 0
                        . ref = DeclRef(row.module, row.decl)
                        for member in owner.member-pool[class.members]
                            do match? owner.decls[member]
                                | .decl-property(property)
                                    . query = if property.type-syntax != 0 then query-type(ref, property.type-syntax, current) else no-type
                                    . target = if descends then query-target(query) else no-type
                                        .. descends = query != no-type && !is-ancestor-query(query)
                                    if target != no-type && facts.query-targets.find(target) == null
                                        facts.query-targets += target
                        . env = types.class-env-for(row.module, row.decl, row.args, current)
                        for member in owner.member-pool[class.members]
                            do match? owner.decls[member]
                                | .decl-rule(rule)
                                    . target = rule-target(row.module, rule.syntax, env)
                                    if target != no-type && facts.query-targets.find(target) == null
                                        facts.query-targets += target
                        types.env-release(env)

────────────────────
_ do register-queries
    - receiver TypeId
    - site SyntaxId

` The registrations a constructor makes once the rules of each class of its object have run,
` base first, as the reference makes them: each query of the markup the object is in that the
` class declares a property for (`markup-query`), given to the markup runtime's
` `register-markup-ancestor-query` or `register-markup-descendants-query` with the object as
` its host, then, where the class is a markup host that a descendant query may look for
` (`may-be-target`), the object as a target of each one whose target is the class or one above
` it (`register-markup-descendant-target`), which program tables find once typing has numbered
` them all. Each may panic.
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    =
. markup = types.markup-host-decl
if markup.module == 0 && markup.decl == 0
    =
find-query-targets()
. chain [TypeId]
. level TypeId? = receiver
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . current = chain[chain.length - 1 - position]
    . ref = class-ref(types, current)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-property(property)
                        . query = if property.type-syntax != 0 then query-type(ref, property.type-syntax, current) else no-type
                        if query != no-type
                            . index = markup-query
                                - current
                                - query
                                - site
                                - ref.module
                                - property.syntax
                                - property.name
                            if index == U32.max || !register-query(receiver, current, index, site)
                                =
    if is-markup-host(current) && may-be-target(current)
        if !register-target(receiver, current, site)
            =

────────────────────
_ do may-be-target Bool
    - level TypeId

` Whether a descendant query may look for a class or one above it: one the program numbers
` before typing (`find-query-targets`), or one a class with type parameters may number as typing
` makes it for some (`note-open-targets`). Each class a class with type parameters may number is
` noted before typing, so this does not depend on the order instances are typed in.
=? true if facts.opens-any-target
. held TypeId? = level
while held && types.intrinsic-of(held) == .class
    =? true if facts.query-targets.find(held) != null
    =? true if facts.open-targets.find(class-ref(types, held).key) != null
    held = types.base-of(held)
= false

────────────────────
_ do register-query Bool
    - receiver TypeId
    - level TypeId
    - index U32
    - site SyntaxId

` Types the registration of a markup query by the constructor, as `register-queries` says, and
` says whether it has a shape here.
. row = facts.markup-queries[index]
. ancestor = row.target-id == 0
. callback = types.well-known-type
    - "core/markup"
    - if ancestor then "MarkupAncestorQueryRefresher" else "MarkupDescendantsQueryApplier"
if callback == invalid-type || !host-self(receiver, site)
    decline(site)
    = false
. mark = scratch.types.mark
scratch.types.push(derived-interface(receiver, types.markup-host-decl))
if !ancestor
    scratch.types.push(types.size-type)
    scratch.types.push(callback)
scratch.types.push(callback)
. register = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom
        - if ancestor then "register-markup-ancestor-query" else "register-markup-descendants-query"
    - mark
scratch.types.rewind(mark)
if register == no-instance || !raises-out(site, register)
    decline(site)
    = false
instances.mark-may-panic(instance)
facts.query-registrations += QueryRegistration(instance, site, level, index, register)
= true

────────────────────
_ do register-target Bool
    - receiver TypeId
    - level TypeId
    - site SyntaxId

` Types the registration by the constructor of the object as a target of the descendant queries
` that look for `level` or a class above it, as `register-queries` says, and says whether it has
` a shape here.
if !host-self(receiver, site)
    decline(site)
    = false
. mark = scratch.types.mark
scratch.types.push(derived-interface(receiver, types.markup-host-decl))
scratch.types.push(types.size-type)
. register = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("register-markup-descendant-target")
    - mark
scratch.types.rewind(mark)
if register == no-instance || !raises-out(site, register)
    decline(site)
    = false
instances.mark-may-panic(instance)
facts.query-registrations += QueryRegistration(instance, site, level, U32.max, register)
= true

────────────────────
_ do host-self Bool
    - receiver TypeId
    - site SyntaxId

` Converts the object a constructor or the function that fills it makes to its markup host at
` `site`, once, and says whether its class is one.
. host = if is-markup-host(receiver) then markup-host else no-type
    .. markup-host = derived-interface(receiver, types.markup-host-decl)
if host == no-type
    = false
if !converted-to-host
    converted-to-host = true
    conversions.convert(site, site, receiver, host, .reason-markup-host)
= true

────────────────────
_ scopes-known Bool

` Whether the style rules written in rules that markup written here sees are known here
` (`rule-scopes`): where the style sheets it sees are (`sheets-known`), and in a function that
` builds markup the markup around it gives them to (`scopes-given`), as for one that builds what a
` line gives a slot, with those found on the way to its outlet (`outlet-scopes`), and one that
` builds content a style rule generates (`check-content`); not in another that builds what a line
` gives a slot.
|? frame.declaration.is-content || scopes-given
    true
|? kind == .slot-decl
    false
??
    instances.rows[instance].enclosing == no-instance && (kind == .main-decl || kind == .function-decl || kind == .getter-decl || kind == .setter-decl || is-constructor-kind(kind))

.. kind = frame.declaration.kind

────────────────────
_ do place-values Bool
    - first U32
    - valued [U32]
    - value-types [TypeId]
    - rows [U32]

` Places among the values a context gives, from the `first`th on, those of the rule around each
` rule written in a rule in view (`rule-scopes`) that takes some, once each: `valued` has where
` each rule's start, or `U32.max` for one around which none takes any, `value-types` their types
` and `rows` the values (`ScopeValues`) in turn. False where their types are not known here.
. next = first
. places [U32]
. known = true
for use in rule-scopes
    . place = U32.max
    if use.values == U32.max - 1
        known = false
    else if use.values != U32.max
        . found = rows.find(use.values)
        if found
            place = places[found]
        else
            . taken = frame-value-types(use.values)
            if !taken
                known = false
            else
                place = next
                rows += use.values
                places += next
                for type in taken
                    value-types += type
                next += taken.length as U32
    valued += place
= known

────────────────────
_ frame-value-types [TypeId]?
    - values U32

` The types of the values of the rule around rules written in it (`ScopeValues`), as the class or
` style sheet that writes it declares them (`frame-types`).
frame-types(facts.scope-values[values].frame)

────────────────────
_ do frame-types [TypeId]?
    - frame U32

` The types of the values of the rule of a frame, as the class or style sheet that writes it
` declares them; none where they are not known here.
. held = instances.frames[frame]
do match? program.modules[held.module].decls[held.decl]
    | .decl-style-rule(rule)
        = written-argument-types(held.module, rule.owner, held.decl)
= null

────────────────────
_ do given-values U32
    - scope RuleScope
    - place U32

` The values of the rule around a rule written in a rule that the markup that made the object
` gives the function that fills it, from its `place`th on among those its context gives, made
` once.
. frame = valued-frame(scope.frames)
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if held.instance == instance && held.argument == place && held.frame == frame
        = index as U32
facts.scope-values += ScopeValues(instance, 0, module, frame, place)
= (facts.scope-values.length - 1) as U32

────────────────────
_ do valued-frame U32
    - frames U32

` The frame of a rule that takes values among the rules applied around a rule written in a rule,
` or none.
. frame = frames
while frame != U32.max
    . held = instances.frames[frame]
    if held.gate == 0
        do match? program.modules[held.module].decls[held.decl]
            | .decl-style-rule(rule)
                if rule-takes(program.modules[held.module].tree, rule.syntax) != 0
                    = frame
    frame = held.outer
= U32.max

────────────────────
_ do load-context Bool
    - receiver TypeId
    - site SyntaxId

` Takes, in the function that fills an object with its class's markup, the styles and style
` sheets of the markup that made the object, with those of the class after them, as the
` reference's `markupStyleContextWithClassUsings` makes the context its content is made under:
` the styles, the first to answer a name innermost, and the sheets in their groups; and the rules
` written in rules it sees, each under the state cells it is given with (`given-cell`), the
` outermost first, and those its own markup brings (`root-scopes`). A rule that reaches only the
` markup of the class of the element that brought it into view matches here where that element's
` object is the one filled (`scope-pending`), and not where it matched in the markup that made it
` (`scope-entered`), as the reference's `markupStyleContextEnteringContent` gives them. False where
` a using is declined.
. context = instances.rows[instance].context
. vocabulary [TypeId]
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first .. < held.first + held.styles
        vocabulary += instances.context-types[position]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
if program.module-by-name("core/style") && !add-visible-styles(receiver, vocabulary, site)
    = false
for position in 0 .. < vocabulary.length
    markup-styles += vocabulary[vocabulary.length - 1 - position]
if types.well-known-type("core/style", "StyleSheetInfo") != invalid-type
    add-sheet-groups(receiver, markup-sheets, sheet-levels)
. made = receiver
. known = false
if context != U32.max
    . held = instances.contexts[context]
    . argument U32
    for position in held.scope-first .. < held.scope-first + held.scopes
        . given = instances.context-scopes[position]
        . count = instances.context-cells[position]
        if given.own == .scope-entered
            argument += count
            continue
        . scope = entered-use(ScopeUse(given)).scope
        . place = instances.context-valued[position]
        . values = if place == U32.max then U32.max else given-values(scope, place)
        if count != 0
            . links = U32.max
            for depth in 0 .. < count - 1
                links = facts.scope-link
                    - given-cell(scope, argument + depth, count - 1 - depth)
                    - links
            rule-scopes += ScopeUse
                - scope
                - given-cell(scope, argument + count - 1, 0)
                - values
                - links
            argument += count
        else
            rule-scopes += ScopeUse(scope, U32.max, values)
    if held.made != no-type
        made = held.made
        known = true
incoming-scopes = rule-scopes.length as U32
= root-scopes(receiver, made, known, site)

────────────────────
_ do root-scopes Bool
    - receiver TypeId
    - made TypeId
    - known Bool
    - site SyntaxId

` Brings into view, in the function that fills an object with its class's markup, after the
` rules written in rules of the markup that made the object, those the rules a root `<This`
` matches bring, each that is not in view already, under whatever state cell, as the reference's
` `classContentRootStyleRuleScopes` gathers them (`gather-scopes`), which binds the cells of only
` those it brings (`prune-cells`), made where the root is; then those of the rules `• This` of the
` chain of the object's class `made` (`default-scopes`), made where the class `receiver` is,
` `known` where the markup that made the object said which class it is. The states of the
` `when`s around them are then checked (`check-cells`). False where one is declined or reported.
. root = tree.root-this(frame.declaration.syntax)
do match? tree.nodes[root]
    | .node-markup(row)
        if may-scope(receiver, row)
            . names [Atom]
            for name in implicit-names(receiver, row.type-id, 0, tree)
                names += program.store-atom(name)
            . gathered [ScopeUse]
            . first = facts.scope-cells.length as U32
            . own-keying = keying
            keying = Keying(keying.discovering, keying.sheet-self, module, root)
            . gathering = gather-scopes
                - receiver
                - names
                - row.style-rule-applications
                - 0
                - made
                - gathered
                - tree
            keying = own-keying
            if !gathering
                decline(root)
                = false
            . added [ScopeUse]
            for gathered-use in gathered
                . use = entered-use(gathered-use)
                . shown = false
                for held in rule-scopes
                    shown = shown || instances.same-scope(held.scope, use.scope)
                for held in added
                    shown = shown || instances.same-scope(held.scope, use.scope)
                if !shown
                    added += use
            for use in prune-cells(first, added)
                rule-scopes += use
if scoping-any()
    . ref = class-ref(types, receiver)
    . own-keying = keying
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            keying = Keying(keying.discovering, keying.sheet-self, ref.module, class.syntax)
    default-scopes(made, 0, rule-scopes, true)
    keying = own-keying
= check-cells(0, site, made, known)

────────────────────
_ do base-scopes Bool
    - receiver TypeId
    - base TypeId
    - scopes [ScopeUse]
    - site SyntaxId

` Adds to `scopes` the rules written in rules that the functions building what the lines of a
` class's markup give the slots of the class above see after those of the markup that made the
` object, as the reference's `baseSlotOutletStyleContext` holds them: those the rules the root
` `<This` of the markup of the class above matches bring, seeing only those of the markup that
` made the object, each not in view already, under state cells made where that root is; then
` those of the rules `• This` of the chain of the class above, under state cells made where the
` class `receiver` is. False where one is declined or reported.
. ref = class-ref(types, base)
. written = program.modules[ref.module].tree
. root = written.root-this(class-content(base))
. context = instances.rows[instance].context
. made = receiver
. known = false
if context != U32.max && instances.contexts[context].made != no-type
    made = instances.contexts[context].made
    known = true
do match? written.nodes[root]
    | .node-markup(row)
        . names [Atom]
        for text in implicit-names(base, row.type-id, 0, written)
            names += program.store-atom(text)
        . later [ScopeUse]
        while rule-scopes.length > incoming-scopes
            later += rule-scopes.pop()
        . gathered [ScopeUse]
        . first = facts.scope-cells.length as U32
        . own-keying = keying
        keying = Keying(keying.discovering, keying.sheet-self, ref.module, root)
        . gathering = gather-scopes
            - base
            - names
            - row.style-rule-applications
            - 0
            - made
            - gathered
            - written
        keying = own-keying
        . added [ScopeUse]
        for gathered-use in gathered
            . use = entered-use(gathered-use)
            . shown = false
            for held in rule-scopes
                shown = shown || instances.same-scope(held.scope, use.scope)
            for held in added
                shown = shown || instances.same-scope(held.scope, use.scope)
            if !shown
                added += use
        while later.length != 0
            rule-scopes += later.pop()
        if !gathering
            decline(site)
            = false
        for use in prune-cells(first, added)
            scopes += use
. owner = class-ref(types, receiver)
. own-keying = keying
do match? program.modules[owner.module].decls[owner.decl]
    | .decl-class(class)
        keying = Keying(keying.discovering, keying.sheet-self, owner.module, class.syntax)
default-scopes(base, 0, scopes, true)
keying = own-keying
= check-cells(0, site, made, known)

────────────────────
_ do resolve-slot (TypeId, Bool)
    - made TypeId
    - name Atom
    - owner ModuleId
    - statement SyntaxId

` The style sheet whose slot of a name a markup element of a class sees, as the reference's
` `resolveStyleSheetSlot` resolves it: that of the highest group that has one, two in one group
` being its error at the line, written at `statement` in a module; or none. False where it is
` reported.
. sheets [TypeId]
. levels [U32]
visible-sheets(made, sheets, levels)
. found = no-type
. group = if levels.length != 0 then levels[levels.length - 1] + 1 else 0u32
while group > 0 && found == no-type
    group -= 1
    for place in 0 .. < sheets.length
        if levels[place] == group && sheet-has-slot(sheets[place], name)
            if found != no-type
                report-at(owner, statement, "StyleSheet slot \"${name.text}\" is ambiguous between visible style sheets ${type-short-name(types, found)} and ${type-short-name(types, sheets[place])}")
                = (no-type, false)
            found = sheets[place]
= (found, true)

────────────────────
_ do report-at
    - owner ModuleId
    - at SyntaxId
    - text String

` Reports the reference's error at a node of a module: of this one through its frame, of another
` as an error of a type's own declaration is.
if owner == module
    frame.diagnose(at, .stated, program.store-atom(text))
else
    facts.record-diagnostic
        - instance
        - owner
        - at
        - .stated
        - program.store-atom(text)
        - no-type
        - no-type

────────────────────
_ precedes Bool
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Whether a place in the program comes before another in source order: in a module loaded
` first, or earlier in the same module.
|? module != other-module
    module < other-module
??
    begin.line < other-begin.line || earlier-column

.. tree = program.modules[module].tree
.. begin = tree.nodes.loc[site].begin
.. other-begin = tree.nodes.loc[other].begin
.. earlier-column = begin.line == other-begin.line && begin.column < other-begin.column

────────────────────
_ do conform-members
    - value TypeId
    - interface TypeId

` A type whose values are made values of an interface must answer each function the interface
` and those it extends declare without a body and with a result: its table has nothing of the
` interface's to run for it. The first it does not answer is the error, at the type's
` declaration, as a call through the interface reports it. Each instance that makes the witness
` reports it, so that it is reported whichever of them a type pass types.
. ref = class-ref(types, value)
if ref.decl == 0
    =
. owner = program.modules[ref.module]
. site = match owner.decls[ref.decl]
    | .decl-class(declared)
        declared.syntax
    ??
        0u32
if site == 0
    =
. key = ((value as U64) /lshift/ 32) /or/ (interface as U64)
. known = scratch.missing-members[key]
. missing = if known then known else missing-member(value, interface)
scratch.missing-members[key] = missing
if missing == 0
    =
. module = (missing /rshift/ 32) as ModuleId
. decl = (missing /and/ 0xffffffff) as DeclId
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        . declaring = declaring-interface(interface, DeclRef(module, fn.owner))
        . text = program.store-atom(unanswered-text(types, value, declaring, fn.name!))
        facts.record-diagnostic(instance, ref.module, site, .stated, text)
        facts.relate-diagnostic(program.store-atom("Interface"), module, fn.syntax)

────────────────────
_ do missing-member U64
    - value TypeId
    - interface TypeId

` The first function an interface, then each it extends, declares without a body and with a
` result that a type does not answer, as its module above its declaration, or 0 where the type
` answers each. A function with type parameters of its own is left to the calls that give it
` arguments, which choose what answers it. A step function written with no steps has no body
` either: it is given an empty block only so that it has one to check.
. ref = class-ref(types, interface)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-function(fn)
                    . own-params = fn.type-args.count != 0
                    . bodiless = fn.body == 0 || is-module-empty-block(ref.module, fn.body)
                    if bodiless && fn.return-type != 0 && !fn.is-static && !own-params && fn.name
                        if !answers-required(value, interface, ref.module, member, fn.kind, fn.name)
                            = ((ref.module as U64) /lshift/ 32) /or/ (member as U64)
for extended in types.interfaces-of(interface)
    . missing = missing-member(value, extended)
    if missing != 0
        = missing
= 0

────────────────────
_ do answers-required Bool
    - value TypeId
    - interface TypeId
    - module ModuleId
    - decl DeclId
    - kind DeclKind
    - name Atom

` Whether a type answers a function an interface declares without a body, as the table of the
` type finds it: by a member of its own, of a class it is derived from or of an extension that
` takes the arguments the interface's function does, by a property it stores or one it
` delegates the name to for a getter or a setter, and by what it delegates the interface to.
` The signature is read onto the scratch stacks, and taken off them again.
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. signature = signature-into(types, module, decl, no-type-arguments(types), interface, true)
. answered = answers-signature(value, signature, module, decl, kind, name)
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
= answered

────────────────────
_ do answers-signature Bool
    - value TypeId
    - signature Signature
    - module ModuleId
    - decl DeclId
    - kind DeclKind
    - name Atom

for arg in signature.args
    if types.completions[arg].has-variables
        = true
if kind != .function-decl && property-named(value, name)
    = true
. busy = calls.suspend-ranking()
. ranking = calls.ranking
. caller = ranking.caller
ranking.caller = class-ref(types, value).module
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
for arg in signature.args
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(arg)
ranking.begin(scratch.call-arguments.since(shapes-start), scratch.types.since(types-start))
. hit Hit? = null
if kind == .getter-decl
    hit = ranking.dispatch-getter(value, name)
else if kind == .setter-decl
    hit = ranking.dispatch-setter(value, name)
else
    hit = ranking.dispatch-method(value, name)
. answered = hit && (hit.module != module || hit.decl != decl || ranking.ambiguity() != null)
. steps [U32]
if !answered && kind != .function-decl
    . holder = ranking.delegated-holder(value, name, steps)
    answered = holder != no-type && steps.length != 0 && property-named(holder, name) != null
ranking.release()
scratch.call-arguments.rewind(shapes-start)
scratch.types.rewind(types-start)
ranking.caller = caller
calls.resume-ranking(busy)
= answered

────────────────────
_ do check-root-values

` Types the values a style rule applied on the root `<This` of a class's markup is given
` (`Instance.root-values`), for the class whose constructor applies the rule, as the reference's
` constructor evaluates them there: each typed with nothing expected, the rule chosen for them
` under the styles and style sheets of the instance's context as the constructor chooses it
` (`choose-written-rule`), and each converted at its node to the type that rule takes it as. It
` answers nothing.
prepare()
. receiver = instances.rows[instance].self-type
. application = instances.rows[instance].root-values
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, class-ref(types, receiver).decl)))
. context = instances.rows[instance].context
if context != U32.max
    . held = instances.contexts[context]
    for position in held.first + held.styles .. < held.first + held.styles + held.sheets
        markup-sheets += instances.context-types[position]
        sheet-levels += instances.context-levels[position]
    for position in held.scope-first .. < held.scope-first + held.scopes
        if instances.context-cells[position] == 0 && instances.context-valued[position] == U32.max
            rule-scopes += ScopeUse(instances.context-scopes[position])
do match? tree.nodes[application]
    | .node-style-rule-application(applied)
        . given [TypeId]
        . typed = true
        for value in tree.children[applied.args]
            . type = infer(value)
            if type == invalid-type || type == no-type
                typed = false
                break
            given += type
        . levels [TypeId]
        . members [DeclRef]
        . gates [U64]
        . scoped [ScopeUse]
        if typed && choose-written-rule(receiver, application, given, levels, members, gates, scoped) && levels.length + scoped.length != 0
            . wanted = if levels.length != 0 then rule-argument-types(members[0]) ?? scope-argument-types(scoped[0].scope) else scope-argument-types(scoped[0].scope)
            for position in 0 .. < given.length
                . value = tree.children[applied.args.start + position]
                conversions.convert
                    - value
                    - value
                    - given[position]
                    - wanted![position]
                    - .reason-argument
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do scope-argument-types [TypeId]?
    - scope RuleScope

` The types a rule written in a rule takes its values as, as the class that writes it declares
` them (`written-argument-types`).
do match? program.modules[scope.module].decls[scope.decl]
    | .decl-style-rule(rule)
        = written-argument-types(scope.module, rule.owner, scope.decl)
= null

────────────────────
_ do take-scope ScopeUse
    - use ScopeUse

` A rule written in a rule that the function building markup sees as the markup it is written in
` sees it, as the reference's closures capture the values of its frames: under a state cell this
` function keeps of that one (`kept-cell`), or, for one found on the way to the slot outlet that
` mounts what it builds, reads from those the outlet holds (`read-cell`), and so for those of the
` `when`s further out (`take-links`); with the values of the rule around it that takes some this
` function keeps (`kept-values`).
. values = if use.values < U32.max - 1 then kept-values(use.values) else use.values
if use.cell >= U32.max - 1
    = ScopeUse(use.scope, use.cell, values)
= ScopeUse(use.scope, take-cell(use.cell), values, take-links(use.outer-cells))

────────────────────
_ do take-links U32
    - link U32

` The state cells of a link of `scope-links` the function building markup sees as the markup it
` is written in sees them (`take-cell`), made into a link again.
if link == U32.max
    = U32.max
. held = facts.scope-links[link]
. outer = take-links(held.outer)
= facts.scope-link(take-cell(held.cell), outer)

────────────────────
_ do kept-values U32
    - source U32

` The values of a rule around rules written in it that this function keeps of those of the
` function it is written in, made once, in the order kept; `U32.max - 1`, values not here, where
` their types are not known. It names that one's values, so this function is typed only with that
` one (`Instance.with-enclosing`).
instances.rows[instance].with-enclosing = true
. count U32
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if held.instance == instance && held.kept != U32.max
        if held.source == source
            = index as U32
        count += 1
. taken = frame-value-types(source)
if !taken
    = U32.max - 1
. first = facts.scope-value-types.length as U32
for type in taken
    facts.scope-value-types += type
facts.scope-values += ScopeValues
    - instance
    - 0
    - module
    - facts.scope-values[source].frame
    - U32.max
    - count
    - source
    - first
    - taken.length as U32
= (facts.scope-values.length - 1) as U32

────────────────────
_ do nested-decl DeclId
    - owner ModuleId
    - outer DeclId
    - syntax SyntaxId

` The declaration of a style rule written at a node of the body of another, or of one of its
` `when`s: among those its module declares after the other, as it declares them, before the
` first that is written in none.
. decls = program.modules[owner].decls
. index = outer + 1
while index < decls.length
    do match decls[index]
        | .decl-style-rule(rule)
            if rule.outer == 0
                = 0
            if rule.syntax == syntax
                = index
        ??
            = 0
    index += 1
= 0

────────────────────
_ do scopes-of (U32, U32)
    - id SyntaxId

` Where among `scoped-rows` the rules a markup element brings into view are kept, the last kept
` for it, or none.
. position = scoped-sites.length
while position != 0
    position -= 1
    if scoped-sites[position] == id
        = (scoped-starts[position], scoped-ends[position])
= (0u32, 0u32)

────────────────────
_ entered-use ScopeUse
    - use ScopeUse

` A rule written in a rule as it is seen in the markup of the class of the element it was brought
` into view at: matching there where it reaches only that markup and matched nothing before.
|? use.scope.own != .scope-pending
    use
??
    ScopeUse
        - RuleScope(scope.module, scope.decl, scope.owner, scope.frames, .scope-entered)
        - use.cell
        - use.values
        - use.outer-cells

.. scope = use.scope

────────────────────
_ do scope-own ScopeOwn
    - written AST
    - line SyntaxId

` How a rule written in a rule, at a line of the module that writes it, is first brought into
` view: matching nothing until its element's object is filled where it is written `• own`.
do match? written.nodes[line]
    | .node-rule-syntax(row)
        =? .scope-pending if row.is-own
= .scope-plain

────────────────────
_ do may-scope Bool
    - class TypeId
    - row ASTMarkup

` Whether a style rule a markup element of a class applies may bring rules written in rules into
` view: whether a name it applies by has a rule that does (`scoping-names`).
if !scoping-any() || types.intrinsic-of(class) != .class
    = false
for name in implicit-names(class, row.type-id, row.id, tree)
    if scoping-named(program.store-atom(name))
        = true
for application in tree.children[row.style-rule-applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if scoping-named(applied.name)
                = true
= false

────────────────────
_ do gather-scopes Bool
    - made TypeId
    - names [Atom]
    - applications RowRange'SyntaxId
    - site SyntaxId
    - owner TypeId
    - scopes [ScopeUse]
    - written AST

` The rules written in rules that the style rules a markup element applies bring into view, as
` the reference prepares them before it makes the object (`prepareElementStyleRules`): for the
` rules each name it matches by answers, and then each written after `•` in `written`, those they
` bring (`gather-name`), each seeing those the ones before brought, with the state cells of the
` `when`s around them made at `site` for an object read as of class `owner`. The values a written
` one gives are typed here, as the reference evaluates them as it prepares the element, and the
` rules it brings read them as the element's rule takes them (`ScopeValues`). One an element
` writes with a condition brings none: the reference reports the rules written in what it
` applies (`declares-only`). False where one is declined: one written with a condition or with
` values where no element is (a root `<This`). While the way to a slot outlet is followed
` (`discovering`), one with values is passed over, as the reference leaves out what it brings
` there.
. none [TypeId]
for name in names
    if !gather-name(made, name, scopes, U32.max, U32.max, site, owner, scopes, none, 0, U32.max, U32.max)
        = false
for application in written.children[applications]
    do match? written.nodes[application]
        | .node-style-rule-application(applied)
            if !scoping-named(applied.name) || (applied.condition != 0 && site != 0)
                continue
            if applied.args.count != 0 && applied.condition == 0 && keying.discovering
                continue
            if applied.condition != 0 || (applied.args.count != 0 && site == 0)
                = false
            . given [TypeId]
            for value in written.children[applied.args]
                . type = infer(value)
                pretyped += value
                if type == invalid-type || type == no-type
                    = false
                given += type
            . gives = if given.length != 0 then application else 0
            if !gather-name(made, applied.name, scopes, U32.max, U32.max, site, owner, scopes, given, gives, U32.max, U32.max)
                = false
= true

────────────────────
_ do gather-name Bool
    - made TypeId
    - name Atom
    - seen [ScopeUse]
    - frames U32
    - cell U32
    - site SyntaxId
    - owner TypeId
    - scopes [ScopeUse]
    - given [TypeId]
    - gives SyntaxId
    - values U32
    - outer-cells U32

` Gathers into `scopes` the rules written in rules that the rules a name answers at an element
` of a class for values of the types `given` bring into view, as `apply-style-rules` resolves
` them: the class's, or else those of the style sheets the element sees, and then the rules
` written in rules that the element sees, with those `seen` after them; each within `frames`,
` the state cells `cell` and `outer-cells` and the `values` of the rules around, or its own. The
` application `gives` the values, or none does. Only a name some rule that brings any has is
` resolved. False where one is declined.
if !scoping-named(name)
    = true
. pending [ScopeUse]
. level = no-type
. member = DeclRef(0, 0)
if given.length == 0
    . (found, chosen, named) = class-style-rule(made, name)
    level = found
    member = chosen
else
    . (found, chosen, taken, mismatch) = match-style-rule(made, name, given)
    if found == invalid-type
        = false
    level = found
    member = chosen
if level != no-type
    if !gather-rule(made, member.module, member.decl, level, frames, cell, seen, site, owner, pending, gives, values, outer-cells)
        = false
else
    . sheets [TypeId]
    . members [DeclRef]
    . gates [U64]
    . (status, writes, missed) = sheet-rules(made, name, given, 0, sheets, members, gates, U32.max)
    if status != 0
        = false
    for position in 0 .. < sheets.length
        if !gather-rule(made, members[position].module, members[position].decl, sheets[position], frames, cell, seen, site, owner, pending, gives, values, outer-cells)
            = false
. scoped [ScopeUse]
. (scoping, found, missed) = scope-rules(made, name, given, seen, scoped, U32.max)
if scoping != 0
    = false
for use in scoped
    . holder = if types.intrinsic-of(use.scope.owner) == .style-sheet then use.scope.owner else made
    if !gather-rule(made, use.scope.module, use.scope.decl, holder, use.scope.frames, use.cell, seen, site, owner, pending, gives, use.values, use.outer-cells)
        = false
for use in pending
    scopes += use
= true

────────────────────
_ do default-scopes
    - made TypeId
    - site SyntaxId
    - uses [ScopeUse]
    - takes-own Bool

` Adds to `uses` the rules written in the rule `• This` of each class of the chain of the class
` `made`, the base first, as the reference's `defaultMarkupStyleRuleScopes` gives them: those of
` its body, then those of each of its `when`s, with no rule around them but the `when`'s, under
` its state cell, made at a site, the markup element whose slots are given content or none for
` the markup a class's content makes. One written `• own` is added matching in the markup being
` filled (`scope-entered`) where the markup of the class's own `takes-own`, and else left out.
. chain [TypeId]
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    . holder = chain[chain.length - 1 - position]
    . ref = class-ref(types, holder)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        if rule.name.text != "This"
                            continue
                        . body = rule-body(owner.tree, rule.syntax)
                        do match? owner.tree.nodes[body]
                            | .node-block(block)
                                for statement in owner.tree.children[block.body]
                                    if nested && (takes-own || plain)
                                        uses += entered-use
                                            - ScopeUse
                                                - RuleScope
                                                    - ref.module
                                                    - nested-decl(ref.module, member, statement)
                                                    - holder
                                                    - U32.max
                                                    - scope-own(owner.tree, statement)
                                    .. nested = owner.tree.nodes[statement] is .node-rule-syntax
                                    .. plain = scope-own(owner.tree, statement) == .scope-plain
                        for branch in rule-whens(owner.tree, body)
                            . gate = U32.max
                            . held = U32.max
                            for line in owner.tree.when-lines(branch)
                                if nested-line && (takes-own || plain-line)
                                    if gate == U32.max
                                        gate = instances.intern-frame
                                            - U32.max
                                            - ref.module
                                            - member
                                            - holder
                                            - branch
                                        held = scope-cell(site, made, ref.module, branch)
                                    uses += entered-use
                                        - ScopeUse
                                            - RuleScope
                                                - ref.module
                                                - nested-decl(ref.module, member, line)
                                                - holder
                                                - gate
                                                - scope-own(owner.tree, line)
                                            - held
                                .. nested-line = owner.tree.nodes[line] is .node-rule-syntax
                                .. plain-line = scope-own(owner.tree, line) == .scope-plain
                        break

────────────────────
_ do rule-argument-types [TypeId]?
    - member DeclRef

` The types a style rule a class or a style sheet writes takes its values as, as it declares
` them, or none where one is not written or is not known without the class's type arguments.
do match? program.modules[member.module].decls[member.decl]
    | .decl-style-rule(rule)
        = written-argument-types(member.module, rule.owner, member.decl)
= null

────────────────────
_ do written-argument-types [TypeId]?
    - module ModuleId
    - class DeclId
    - member DeclId

` The types a style rule written in a class of a module, or in an extension of a style sheet,
` or in a rule of either, takes its values as, as `rule-argument-types` says.
. owner = program.modules[module]
. taken [TypeId]
do match? owner.decls[member]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(row)
                . env = holder-env(DeclRef(module, class))
                for arg in owner.tree.children[row.args]
                    . written = argument-type-syntax(owner.tree, arg)
                    . type = if written != 0 then types.evaluate-type(module, owner.tree, written, env) else invalid-type
                    if type == invalid-type || types.completions[type].has-variables
                        types.env-release(env)
                        = null
                    taken += type
                types.env-release(env)
= taken

────────────────────
_ argument-type-syntax SyntaxId
    - written AST
    - argument SyntaxId

` The type written for a value a style rule takes, `name Type`, or none.
match written.nodes[argument]
    | .node-argument-decl(row)
        match written.nodes[row.pattern]
            | .node-type-capture(capture)
                capture.type
            ??
                0
    ??
        0

────────────────────
_ generates Bool
    - written AST
    - line SyntaxId

` Whether a line of a style rule generates content: a markup element that binds a slot.
match written.nodes[line]
    | .node-markup(row)
        row.slot-binding != 0
    ??
        false

────────────────────
_ do implicit-names [String]
    - made TypeId
    - type-id SyntaxId
    - element SyntaxId
    - written AST

` The names a style rule that takes no values matches a markup element by, as the reference
` applies one without its being written, each once, in its order: the name of each class of
` the element's chain, base first, the type written, and the element's id spelled as a
` selector, each capital a hyphen and its small letter, as `written`. `This` matches nothing.
. chain [String]
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            chain += class.name.text
    level = types.base-of(level)
. names [String]
for position in 0 .. < chain.length
    add-name(names, chain[chain.length - 1 - position])
do match? written.nodes[written-base(written, type-id)]
    | .node-type-identifier(typed)
        if !typed.is-declare
            add-name(names, typed.name.text)
do match? written.nodes[element]
    | .node-identifier(named)
        add-name(names, selector-name(named.name.text))
= names

────────────────────
_ do add-name
    - names [String]
    - name String

if name != "This" && names.find(name) == null
    names += name

────────────────────
_ written-base SyntaxId
    - written AST
    - id SyntaxId

` A type written with type arguments as the type they are given to.
match written.nodes[id]
    | .node-type-arguments(row)
        written-base(written, row.base)
    ??
        id

────────────────────
_ do scoping-from Bool
    - name Atom
    - from ModuleId

` Whether a module sees a name `scoping-names` lists: one a module it shares a case with writes.
for position in 0 .. < facts.scoping-names.length
    if facts.scoping-names[position] == name && case-shared
        = true
    .. case-shared = program.shares-case(from, facts.scoping-modules[position])
= false

────────────────────
_ scoping-named Bool
    - name Atom

` Whether the module being typed sees a name `scoping-names` lists.
scoping-from(name, module)

────────────────────
_ do scoping-any Bool

` Whether the module being typed sees any name `scoping-names` lists.
for owner in facts.scoping-modules
    if program.shares-case(module, owner)
        = true
= false

────────────────────
_ do nested-any Bool

` Whether a module the module being typed shares a case with writes a rule in a rule.
for owner in facts.nested-modules
    if program.shares-case(module, owner)
        = true
= false

────────────────────
_ do selector-name String
    - name String

` An id as a style rule's name matches it: each capital is a hyphen and its small letter.
. spelled = ""
for char in name
    if char >= 'A' && char <= 'Z'
        spelled += "-"
        spelled += "$char".lowercased
    else
        spelled += char
= spelled

────────────────────
_ do demand-event-register

` The event runtime's `event-register-lowered`, which puts a section the reference runs from a
` table of its class in that table as the module of the class starts, and its
` `event-register-lowered-arrival`, which puts one that hears only what arrives at its object.
. matcher = types.well-known-alias("core/event", "EventLoweredOwnerMatcher")
if matcher == invalid-type
    =
. mark = scratch.types.mark
scratch.types.push(types.size-type)
scratch.types.push(matcher)
scratch.types.push(pointer-to(types.type-row(.uint8)))
scratch.types.push(types.size-type)
scratch.types.push(types.bool-type)
facts.event-register = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-register-lowered")
    - mark
facts.event-register-arrival = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-register-lowered-arrival")
    - mark
scratch.types.rewind(mark)

────────────────────
_ do defer-values
    - receiver TypeId

` The first values a constructor gives only once the markup of its class has run, as the
` reference puts them off: a stored property's value that reads by its name alone a property
` the markup declares for an element, outside the functions written in it, and then each
` that reads a property put off, unless the constructor gives the property its value itself.
` Each is given after those it reads, and a value that reads itself that way is reported, as is
` one whose type has no value to hold until then.
. range = types.completions[receiver].properties
. count = range.count
. values = SyntaxId[count]
. owners = ModuleId[count]
. sites = SyntaxId[count]
. deferred = Bool[count]
. given = Bool[count]
. fill = facts.latest-fill-of(instance)
while fill != no-fact
    . place = property-named(receiver, facts.fills[fill].name)
    if place && (place as U32) >= range.start && (place as U32) < range.start + count
        given[(place as U32) - range.start] = true
    fill = facts.prior-fill(fill)
. any = false
for position in 0 .. < count
    . property = types.properties[range.start + position]
    if property.storage-kind != .storage-eager || given[position] || names-element(types, property)
        continue
    . ref = declaring-decl(types, property)
    . member = valued-property(program, ref.module, ref.decl, property.name)
    do match? program.modules[ref.module].decls[member]
        | .decl-property(row)
            if member != 0 && !row.is-lazy
                values[position] = row.value
                owners[position] = ref.module
                sites[position] = row.syntax
    if values[position] != 0 && reads-element(receiver, ref-tree, values[position])
        deferred[position] = true
        any = true
    .. ref-tree = program.modules[ref.module].tree
if !any
    =
. grew = true
while grew
    grew = false
    for position in 0 .. < count
        if values[position] == 0 || deferred[position]
            continue
        . tree = program.modules[owners[position]].tree
        . value = values[position]
        for node in tree.subtree-start(value) .. value
            . read = read-place(receiver, tree, node)
            if read != U32.max && deferred[read]
                deferred[position] = true
                grew = true
                break
for position in 0 .. < count
    . property = types.properties[range.start + position]
    if deferred[position] && !has-empty-value(eager-type(receiver, property), 0)
        . message = "Property \"${property.name.text}\" initializes after its markup, so its type must be optional"
        facts.record-diagnostic
            - instance
            - owners[position]
            - sites[position]
            - .stated
            - program.store-atom(message)
        =
. states = U8[count]
. order [U32]
for position in 0 .. < count
    if !deferred[position]
        continue
    if !order-deferred(receiver, position, values, owners, sites, deferred, states, order)
        =
facts.note-deferred(instance, order)

────────────────────
_ do order-deferred Bool
    - receiver TypeId
    - position U32
    - values [SyntaxId]
    - owners [ModuleId]
    - sites [SyntaxId]
    - deferred [Bool]
    - states [U8]
    - order [U32]

` Places a value put off after the values put off that it reads, and then itself, by its
` property's place among all properties. A value reached again while those it reads are
` being placed depends on itself, and is reported at its property.
if states[position] == 2
    = true
. start = types.completions[receiver].properties.start
if states[position] == 1
    . name = types.properties[start + position].name
    . message = "Property \"${name.text}\" depends on itself through properties that initialize after its markup"
    facts.record-diagnostic
        - instance
        - owners[position]
        - sites[position]
        - .stated
        - program.store-atom(message)
    = false
states[position] = 1
. tree = program.modules[owners[position]].tree
. value = values[position]
for node in tree.subtree-start(value) .. value
    . read = read-place(receiver, tree, node)
    if read != U32.max && read != position && deferred[read]
        if !order-deferred(receiver, read, values, owners, sites, deferred, states, order)
            = false
states[position] = 2
order += start + position
= true

────────────────────
_ do read-place U32
    - receiver TypeId
    - tree AST
    - node SyntaxId

` The place among a class's own properties of the one a node of a value reads as the
` reference finds them: by a name alone, or after `this`. `U32.max` for any other node.
. name Atom? = null
do match? tree.nodes[node]
    | .node-identifier(row)
        name = row.name
    | .node-get-expression(row)
        do match? tree.nodes[row.object]
            | .node-identifier(object)
                if types.this-atom && object.name == types.this-atom
                    name = row.name
if !name
    = U32.max
. place = property-named(receiver, name)
. range = types.completions[receiver].properties
if !place || (place as U32) < range.start || (place as U32) >= range.start + range.count
    = U32.max
= (place as U32) - range.start

────────────────────
_ do check-rule
    - declaration CheckedDecl
    - matched SyntaxId

` A rule a module declares, typed for the stream and the arguments a pattern calls it with, as the
` reference types the function it makes of it: its pattern is typed as a match of its own over the
` buffer of the stream, which holds the stream's items, or the UTF-8 bytes of its characters where
` the rule is `encoded` for a pattern on a String, and its arms are joined and converted to the
` type the rule states. The function made of it returns an optional of that type, which holds
` nothing where no arm passed, and which a call of the rule from its own arms gives where the rule
` states its type; one that states none, called from its own arms before its type is known, reports
` that it cannot be typed, as the reference does. The type of the buffer is kept at the rule. A
` type's constructor that takes a stream is such a rule. Its pattern asks the stream for more input
` where it reads past the end of the buffer, through the calls `record-growth` keeps. One typed for
` the helper a pattern calls it under runs its pattern under that helper; one given an argument
` `ambient-position` finds, under that argument, whatever helper a pattern calls it under, and one
` whose helper observes literals or keeps collectors where its storages disagree has no shape here.
` A rule marked to roll back, or whose pattern has an arm that is, asks the helper for a mark before
` each action of its arms, as the reference does. Another rule that belongs to a type is an
` error, and one whose body holds more than its pattern and the lazy locals declared for it has
` no shape here.
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. declared = declared-return
. signature = instances.signatures[instance]
. item = if signature.param-count != 0 then instances.param-type(instance, 0) else no-type
. owned = frame.self-type != no-type && declaration.kind != .constructor-decl
. given = if item != no-type then class-over(types.token-stream-decl, item) else no-type
. grows = pattern == 0 || item == no-type || record-growth(given, matched, encodes)
    .. encodes = instances.rows[instance].encoded
. marked = false
do match? tree.nodes[declaration.syntax]
    | .node-function-syntax(row)
        marked = row.rollback
if pattern == 0 || item == no-type || owned || !grows || !lazies-beside(declaration.body, matched)
    if owned
        frame.diagnose(declaration.syntax, .stated, program.store-atom("A rule can't be a method; declare it at module level"))
    else
        decline(declaration.syntax)
    instances.set-returns(instance, invalid-type, no-type, .return-inferred)
    finish-errors(frame)
    close()
    =
if declared != no-type
    . stated = types.optional-around(declared)
    instances.set-returns(instance, stated, stated, .return-declared)
stream-view = stream-view.item = item
stream-view = stream-view.buffer = class-over
    - types.array-decl
    - if instances.rows[instance].encoded then types.type-row(.uint8) else item
stream-view = stream-view.type = given
if instances.rows[instance].helper != no-type
    helping = helping.helper = pattern-helper(types, instances.rows[instance].helper)
    if instances.rows[instance].spans
        helping = helping.helper = spanning-helper(helping.helper!)
        helping = helping.span-typing = true
    helping = helping.site = matched
    rule-helper-site = matched
else if ambient-position(types, instances, instance) != U32.max
    . resolved = pattern-helper
        - types
        - instances.argument-type(instance, ambient-position(types, instances, instance))
    if resolved.problem != null || resolved.observer != no-type || resolved.storage == invalid-type
        decline(declaration.syntax)
    helping = helping.helper = resolved
    helping = helping.site = matched
    rule-helper-site = matched
. closing = left-call(pattern, 0, List'SyntaxId())
if closing != 0
    report-left-recursion(closing)
    instances.set-returns(instance, invalid-type, no-type, .return-inferred)
    finish-errors(frame)
    close()
    =
rule-arming = rule-arming.capture-base = capture-sites.length
rule-arming = rule-arming.capture-root = pattern
rule-arming = rule-arming.texts = declared == types.string-type
. saved-target = rule-arming
rule-arming = rule-arming.target = declared
rule-arming = rule-arming.span = gives-source-span(declared)
helping = helping.explicit = marked || holds-rollback(pattern)
helping = helping.body = matched
. joined = arms-type(pattern)
helping = helping.explicit = false
helping = helping.body = 0
rule-arming = saved-target
rule-arming = rule-arming.texts = false
. result = declared
if result == no-type
    result = if joined == no-type then types.string-type else joined
if joined != invalid-type
    convert-stream-arms(pattern, result)
    if declared != no-type && declared != types.string-type
        note-arm-casts(pattern, declared)
    facts.set-node-type(instance, pattern, result)
    facts.set-node-type(instance, declaration.syntax, stream-view.buffer)
if declared == no-type
    if instances.signatures[instance].read-in-progress
        . reader = instances.signatures[instance].read-by
        if reader == no-instance || reader == instance || !facts.has-diagnostic(reader)
            facts.record-diagnostic
                - instance
                - frame.module
                - declaration.syntax
                - .return-after-recursion
        instances.set-returns(instance, invalid-type, no-type, .return-failed)
    else
        instances.set-returns(instance, types.optional-around(result), no-type, .return-inferred)
finish-errors(frame)
close()

────────────────────
_ do lazies-beside Bool
    - body SyntaxId
    - matched SyntaxId

` Whether the body of a rule holds nothing beside its pattern but lazy locals declared for
` it, as the reference's `where` holds them.
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if statement != matched && !narrowing.is-lazy-declaration(statement)
                = false
= true

────────────────────
_ lacks-result Bool
    - declaration CheckedDecl
    - declared TypeId
    - intrinsic TypeId

` A function written without a body and without `do` gives nothing, unless it declares a type
` to construct, states a requirement of an interface, or is one the compiler computes.
|? declaration.body != 0 || declaration.is-main || declaration.is-imperative
    false
|? declaration.is-generated || is-constructor-kind(declaration.kind) || intrinsic != no-type
    false
|? declared != no-type && declared != types.void-type
    false
|? self != no-type && self != invalid-type && types.intrinsic-of(self) == .interface
    false
??
    declaration.kind == .function-decl

.. self = frame.self-type

────────────────────
_ do unwritten-return SyntaxId
    - declaration CheckedDecl
    - declared TypeId
    - intrinsic TypeId

` The type a function written without a body and without `do` declares it returns, which
` it gives as made with nothing written, as a local declared with no value is, or nothing
` where it gives nothing so. A function the compiler computes is none of these.
if declaration.body != 0 || declaration.is-main || not-expression
    = 0
.. not-expression = declaration.is-imperative || declaration.is-generated
if module == types.intrinsics-module
    = 0
if declaration.kind != .function-decl || intrinsic != no-type || gives-nothing
    = 0
.. gives-nothing = declared == no-type || declared == types.void-type
. self = frame.self-type
if self != no-type && self != invalid-type && types.intrinsic-of(self) == .interface
    = 0
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        = fn.return-type
= 0

────────────────────
_ do refuses-unwritten Bool

do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.owner == 0 && fn.name && calls.intrinsic-plan(instance) == .plan-none
            . text = "Function \"${fn.name.text}\" has no body, and no compiler intrinsic supplies one"
            frame.diagnose(fn.syntax, .stated, program.store-atom(text))
            = true
= false

────────────────────
_ do evident-return TypeId
    - declaration CheckedDecl

` The type an expression function gives when its result constructs a type it names in full:
` a function that reads this one's return while it is still being checked reads that type.
if declaration.is-main || declaration.is-imperative || declaration.body == 0
    = no-type
. result = declaration.body
do match? tree.nodes[result]
    | .node-block(row)
        result = 0
        for statement in tree.children[row.body]
            if !tree.is-lazy-declare(statement)
                result = statement
if result == 0
    = no-type
do match? tree.nodes[result]
    | .node-call-expression(call)
        do match? tree.nodes[call.callable]
            | .node-type-arguments
                . named = types.evaluate-type(module, tree, call.callable, frame.env)
                if named != invalid-type && !types.completions[named].has-variables
                    = named
= no-type

────────────────────
_ do check-unreturned
    - declared TypeId

` A `do` function that can run off its end must not finish on a value: a value it means to
` give back needs `=`. One that declares a type it must give cannot run off its end at all;
` nothing, a truth and an optional each have a value for the end to give. A function a C
` header declares has no end to run off, and neither has one an interface requires and
` gives no body.
. declaration = frame.declaration
. plain = declaration.kind == .function-decl || declaration.kind == .getter-decl
if !plain || !declaration.is-imperative || giving.yields
    =
if program.modules[module].name.ends-with(".h") || narrowing.exits(declaration.body, false, true)
    =
. owner = frame.self-type
if owner != no-type && owner != invalid-type && tree.is-empty-block(declaration.body)
    if types.intrinsic-of(owner) == .interface
        =
. gives = declared != no-type && declared != types.void-type
. required = gives && declared != types.bool-type && !types.is-optional(declared)
if final-statement == 0 && !required
    =
. name = ""
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.name
            name = fn.name.text
    | .decl-converter(converter)
        . target = types.type-syntax-name(tree, converter.target-type)
        if target
            name = "to ${target.text}"
if final-statement != 0
    . gives-value = gives
    if declared == no-type
        for position in frame.returns-start .. < scratch.returns.length
            . returned = scratch.returns[position].type
            if returned != no-type && returned != types.void-type
                gives-value = true
    if gives-value
        . message = "Function $name ends with a value it does not return"
        frame.diagnose(final-statement, .stated, program.store-atom(message))
        =
    if is-bare-value(final-statement) && frame.self-type == no-type
        frame.diagnose(final-statement, .stated, program.store-atom(bare-value-text()))
        =
    instances.set-unreturned(instance, final-statement)
if required
    . shown = type-short-name(types, declared)
    . message = "Function $name can fall through without returning $shown"
    frame.diagnose(declaration.syntax, .stated, program.store-atom(message), declared)

────────────────────
_ bare-value-text String

"A value cannot stand alone as a step; use it, or remove it"

────────────────────
_ is-module-empty-block Bool
    - module ModuleId
    - id SyntaxId

match program.modules[module].tree.nodes[id]
    | .node-block(row)
        row.body.count == 0
    ??
        false

────────────────────
_ discards-result Bool

` A tap's closure runs for its effect: the reference declares it to return nothing.
|? frame.declaration.kind != .pipeline-decl
    false
??
    match tree.nodes[frame.declaration.syntax]
        | .node-pipeline-expression(row)
            row.op == .pipe-repeat-op
        | .node-binary-expression(row)
            row.op == .pipe-repeat-op
        ??
            false

────────────────────
_ do math-intrinsic-return TypeId

` What a function the compiler computes gives, where it declares nothing: one of the four of
` the math module that take floats, or the intrinsic that calls an event's lowered handler.
. name = ""
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.name
            . atom = fn.name
            name = atom.text
if module == types.intrinsics-module && name == "event-invoke-lowered"
    = types.void-type
if program.modules[module].name != "math"
    = no-type
. signature = instances.signatures[instance]
if signature.args.count == 0
    = no-type
for position in 0 .. < signature.args.count
    if instances.argument-type(instance, position) != types.f64-type
        = no-type
if (name == "sqrt" || name == "abs") && signature.args.count == 1
    = types.f64-type
if (name == "min" || name == "max") && signature.args.count == 2
    = types.f64-type
= no-type

────────────────────
_ do generator-return TypeId
    - declared TypeId
    - raised RowRange'TypeId

` A generator body under a declared return type, its steps raising the errors in `raised`: a
` declared generator stays; a declared stream or iterable returns the iterable of its item,
` the case of the stream union a generator unifies with, unless the steps raise, when the
` reference keeps the concrete generator so its pull carries the errors.
if declared == invalid-type
    = declared
. ref = class-ref(types, declared)
if same-decl(ref, types.generator-decl)
    = declared
if !same-decl(ref, types.stream-decl) && !same-decl(ref, types.iterable-decl)
    = declared
. item = first-arg(declared)
if item == no-type
    = declared
if raised.count != 0
    = generator-of(item, raised)
= class-over(types.iterable-decl, item)

────────────────────
_ do read-return TypeId
    - declaration CheckedDecl
    - declared TypeId

` The return a call back to a function reads while its body is typed. A body that yields
` itself gives what `generator-return` settles its declared return to, its steps raising the
` errors it states, or none so far, as such a call reads those it infers; one that turns up
` later is reported as leaving a recursive generator.
if declared == invalid-type
    = declared
. ref = class-ref(types, declared)
. streams = same-decl(ref, types.stream-decl) || same-decl(ref, types.iterable-decl)
if !streams || !tree.yields-itself(declaration)
    = declared
. signature = instances.signatures[instance]
. stated = if signature.error-state == .errors-stated then signature.errors else RowRange'TypeId()
= generator-return(declared, stated)

────────────────────
_ do note-generator

` Says what a function that yields makes and what a step of its body gives, for emission:
` the generator of the items it returns a generator or an iterable of, or else of what its
` yields unify to. Each yield a statement writes is converted to the type of the items
` where it gives another, at the statement, as the reference casts it once the body is
` compiled. A function declared to return anything else returns the generator converted to
` that, where it is called: the conversion is recorded at the declaration. A generator whose
` steps raise carries their errors, and a step gives its item or one of them.
. returned = instances.signatures[instance].returns
. ref = if returned != no-type && returned != invalid-type then returned-ref else DeclRef(0, 0)
    .. returned-ref = class-ref(types, returned)
. item = giving.yielded
if same-decl(ref, types.generator-decl) || same-decl(ref, types.iterable-decl)
    item = first-arg(returned)
if item == no-type || item == invalid-type
    =
convert-yields(item)
. makes = generator-of(item, instances.rows[instance].step-errors)
. yields = step-answer(types.optional-around(item))
types.complete(makes)
types.complete(yields)
. inferred = instances.signatures[instance].return-state == .return-inferred
if inferred && same-decl(ref, types.generator-decl) && returned != makes
    instances.set-returns(instance, makes, no-type, .return-inferred)
    returned = makes
if returned != no-type && returned != invalid-type && returned != makes && not-interface
    . site = frame.declaration.syntax
    if !relation-legal(conversions.compare-held(makes, returned))
        . message = program.store-atom("Generator return type does not match declared return type")
        frame.diagnose(site, .stated, message)
        =
    conversions.convert(site, site, makes, returned, .reason-return)
.. not-interface = types.intrinsic-of(returned) != .interface
instances.set-generator(instance, makes, yields, loops-yields && splits-yields)

────────────────────
_ do convert-yields
    - item TypeId

for position in frame.yields-start .. < scratch.yields.length
    . site = scratch.yields[position]
    if site.type != item
        . noted = position - frame.yields-start
        . literal = if noted < yield-literals.length then yield-literals[noted] else 0
        if literal != 0 && yield-fits(literal, item)
            conversions.convert(site.syntax, literal, site.type, item, .reason-return, true, true)
        else
            conversions.convert
                - site.syntax
                - tree.yielded-syntax(site.syntax)
                - site.type
                - item
                - .reason-return

────────────────────
_ do settle-built-list

. item = if built-item != no-type then built-item else giving.yielded
if item == no-type || item == invalid-type
    instances.set-returns(instance, invalid-type, no-type, .return-failed)
    =
convert-yields(item)
. list = list-of(item)
instances.set-returns(instance, list, no-type, .return-inferred)
. head = frame.declaration.syntax
calls.note-list(head, list)
calls.note-append(head, list, item, .call-list-append)

────────────────────
_ do generator-of TypeId
    - item TypeId
    - raised RowRange'TypeId

` The generator a function that yields makes, of its items and of the errors in `raised`, which
` a step of its body raises.
if raised.count == 0
    = class-over(types.generator-decl, item)
. mark = scratch.types.mark
scratch.types.push(item)
. errors-mark = scratch.types.mark
for offset in 0 .. < raised.count
    scratch.types.push(instances.signature-types[raised.start + offset])
= types.intern-raising-class
    - types.generator-decl.module
    - types.generator-decl.decl
    - mark
    - errors-mark

────────────────────
_ do step-answer TypeId
    - optional TypeId

` What a step of a function that yields gives: the optional of an item, or that or one of
` the errors the step raises.
. raised = instances.rows[instance].step-errors
if raised.count == 0
    = optional
. mark = scratch.types.mark
for offset in 0 .. < raised.count
    scratch.types.push(instances.step-error-type(instance, offset))
= result-type(types, optional, mark)

────────────────────
_ do class-over TypeId
    - decl DeclRef
    - item TypeId

. mark = scratch.types.mark
scratch.types.push(item)
= types.class-with-args(decl.module, decl.decl, mark)

────────────────────
_ do super-type TypeId

. self = frame.self-type
if self == no-type || self == invalid-type
    = self
types.complete(self)
= types.base-of(self) ?? self

────────────────────
_ do owner-syntax SyntaxId

. owner = 0u32
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        owner = fn.owner
if owner == 0
    = frame.declaration.syntax
do match? program.modules[module].decls[owner]
    | .decl-class(class)
        = class.syntax
= frame.declaration.syntax

────────────────────
_ do states-type Bool
    - signature Signature
    - position U32

` Whether the argument at a position of the function being typed is written with a type
` that leaves nothing open.
. declared = signature.args[position]
if declared == invalid-type || types.completions[declared].has-variables
    = false
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if position < fn.args.count
            = program.modules[module].arg-pool[fn.args.start + position].type-syntax != 0
= false

────────────────────
_ do demand-own-body
    - callee InstanceId

` Types a callee's body in this pass where nothing has typed it yet, for what it records of the
` state machines it types, which a pass of a parallel type pass takes in from the others only
` as they merge: taken in from another (`adopt`), the callee would have none here. Where one was
` taken in already, the parallel pass cannot stand (`SharedTyping.diverge`).
if instances.rows[callee].state == .instance-unstarted
    . checker = checker-for(session, callee)
    checker.run()
    checker.retire()
else if instances.rows[callee].imported && session.shared
    session.shared.diverge()

────────────────────
_ do check-equality

` Types the comparison of two values of the instance's type, which the function a witness
` table holds for equality runs: `==` of two such values, planned in the frame of the type's
` module's main at the type's declaration, as anywhere else.
prepare()
. value = instances.rows[instance].self-type
. site = equality-site(types, program, value)
infer-binary-values(site, .equals-op, site, value, site, value)
instances.set-returns(instance, types.bool-type, types.bool-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do names-machine Bool
    - slot SlotId

` Whether a slot holds the value of a state machine, which its cases read before the machine's
` union is made where what a case holds is inferred (see `early-union`).
for row in bindings.machines
    if row.bound == slot
        = true
= false

────────────────────
_ do note-unit-errors
    - unit InstanceId
    - site SyntaxId

` The errors a unit the function runs lets out, which leave the function at a node.
if !instances.errors-known(unit)
    defer-outgoing(unit, site)
    =
. signature = instances.signatures[unit]
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], site)

────────────────────
_ do replay-member
    - unit InstanceId

` A constructor runs the values of the properties it is not given, so it may panic where they
` do, and makes the calls they make. The calls are those of the property's own module: a
` constructor in another module has no place in its own source to put them.
. value = instances.rows[unit]
. reader = instances.rows[instance]
if reader.initializer == 0 && reader.module == value.module && reader.decl == value.decl
    =
if value.may-panic
    instances.mark-may-panic(instance)
if value.polls
    instances.mark-polls(instance)
if value.module != (module)
    =
facts.replay-calls(unit, instance)

────────────────────
_ do check-field-default
    - position U32

` The value a tuple's type writes for a field a call of its constructor leaves out, typed where
` the call is, as `check-property-defaults` types every value for a constructor given no field.
` The constructor lets out the errors an eager one may raise, at its class.
. receiver = instances.rows[instance].self-type
if instances.signatures[instance].args.count == 0 || receiver == no-type || receiver == invalid-type
    =
frame.declaration = described!
conversions.attach(this)
calls.attach(this)
. opened = open-class-env(receiver)
frame.outgoing-start = scratch.outgoing.mark
types.complete(receiver)
. filled = 0u32
for property in types.properties-of(receiver)
    if property.slot == U32.max
        continue
    if filled == position && property.storage-kind != .storage-getter
        last-unit = no-instance
        demand-member(property, receiver, property.name, true)
        if property.storage-kind == .storage-eager && last-unit != no-instance && other-unit
            note-unit-errors(last-unit, owner-syntax())
            note-default-use(last-unit)
        .. other-unit = last-unit != instance
        if property.storage-kind == .storage-eager
            construct-default(property, receiver)
    filled += 1
if opened
    frame.close-env()
finish-errors(frame)
scratch.outgoing.rewind(frame.outgoing-start)

────────────────────
_ do type-written-defaults

` Types, as the function is checked, each default written as a constant (`written-constant`),
` which the reference evaluates as the function's module starts whether or not a call takes
` it. Any other default is typed where a call first takes it (`type-default`).
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        for position in 0 .. < fn.args.count
            . syntax = owner-module.arg-pool[fn.args.start + position].default-syntax
            if syntax != 0 && written-constant(syntax) && instances.type-default(instance, position)
                check-default(position)

────────────────────
_ do written-constant Bool
    - syntax SyntaxId

` Whether a default is written as a constant as the reference tells one: a number, a text, a
` symbol, a truth, null, an operator on one of those, or a member named on a type.
do match? tree.nodes[syntax]
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-symbol
        = true
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom || row.name == types.null-atom
    | .node-unary-expression(row)
        = written-constant(row.operand)
    | .node-get-expression(row)
        = !row.is-tracked && !row.is-optional && is-type-syntax(tree, row.object)
= false

────────────────────
_ do check-default
    - position U32

` Types the default a parameter declares, as the parameter's type expects it. A default that
` is no literal and gives another type is converted to the parameter's type where it is
` written, for the calls that take it; a literal is converted at each call. One that no
` conversion takes to the parameter's type is reported by no call that gives the argument.
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        if position >= fn.args.count
            =
        . shape = owner-module.arg-pool[fn.args.start + position]
        if shape.default-syntax == 0
            =
        . slot = argument-slot(position)
        . expected = if slot != no-slot then frame.slot-type(slot) else no-type
        if tree.is-empty-list(shape.default-syntax) && list-expected
            facts.set-node-type(instance, shape.default-syntax, expected)
            calls.note-list(shape.default-syntax, expected)
            =
        .. list-expected = types.ancestor-of(expected, types.list-decl) != no-type
        . given = infer-with-expected(shape.default-syntax, expected)
        . literal = literal-type(types, module, tree, shape.default-syntax, frame.env)
        . converts = typed-default && given != expected && given != invalid-type
            .. typed-default = literal == invalid-type && expected != no-type
        if converts && relation-legal(conversions.compare-held(given, expected))
            conversions.convert
                - shape.default-syntax
                - shape.default-syntax
                - given
                - expected
                - .reason-default
                - true
                - true

────────────────────
_ do argument-slot SlotId
    - position U32

. seen = 0u32
. bound = bindings.bindings[frame.binding]
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    if bindings.slots[slot].kind == .slot-argument
        if seen == position
            = slot
        seen += 1
= no-slot

────────────────────
_ do check-assertion
    - id SyntaxId
    - exception SyntaxId
    - condition SyntaxId

` A condition is typed first, and what is raised under what the condition finds. What typing
` the condition left known, as a lazy local it evaluated, holds after it.
if condition != 0
    note-truthiness(condition, condition, infer-tested(condition))
. mark = scratch.narrowings.mark
if condition != 0
    narrowing.narrow-condition(condition, true)
. saved = frame.surround
frame.surround = frame.surround.effects = exceptional-effects(saved.effects)
. known = frame.save-members()
. raised = infer(exception)
frame.surround = saved
if condition != 0
    frame.restore-members(known)
    pop-conditional(mark)
if raised == invalid-type || raised == no-type
    =
if is-subtype(types, raised, types.panic-type)
    instances.mark-may-panic(instance)
    =
if is-subtype(types, raised, types.error-type)
    note-outgoing(raised, id)
    facts.set-plan(instance, id, .plan-raise)
    =
frame.diagnose(id, .invalid-bang-return, null, raised)

────────────────────
_ is-class Bool
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-class
        decl != 0
    ??
        false

────────────────────
_ do check-equality
    - unit UnitDecl

` An equality relates two units wherever they meet, so it is public, and each side of it
` measures in a unit of its own. The type store declared it before anything was typed; one
` it could not evaluate is not a constant, at the first operation that gives no number.
if !is-public(unit.access)
    frame.diagnose(unit.syntax, .stated, program.store-atom("Equalities must be public"))
    =
if misstates-unit(unit.number) || misstates-unit(unit.value)
    =
. offset = tree.offset-of(unit.number)
. shifted = if offset != 0 then offset else tree.offset-of(unit.value)
if shifted != 0
    . message = "An equality relates two units by a ratio alone, so a number with no unit cannot be added to or taken from one; write the ratio as one number in the unit"
    frame.diagnose(shifted, .stated, program.store-atom(message))
    =
. diagnosed = facts.diagnostics.length
. left = unit-of(unit.number)
. right = unit-of(unit.value)
if facts.diagnostics.length != diagnosed
    =
if left == no-type || right == no-type
    frame.diagnose(unit.syntax, .stated, program.store-atom("Ambiguous units"))
    =
for side in [left, right]
    if side != invalid-type && types.completions[side].is-builtin
        . shown = type-short-name(types, side)
        . message = "An equality relates units a program declares, and $shown is a number type of the language; write each side in a unit the program declares"
        frame.diagnose(unit.syntax, .stated, program.store-atom(message))
        =
for equality in types.equalities
    if equality.from == left && equality.to == right
        disagrees(unit.syntax, left, right)
        =
. unevaluated = tree.unevaluated-operation(unit.number)
. failed = if unevaluated != 0 then unevaluated else tree.unevaluated-operation(unit.value)
. place = if failed != 0 then failed else unit.syntax
frame.diagnose(place, .stated, program.store-atom("Invalid constant expression"))

────────────────────
_ do disagrees
    - id SyntaxId
    - left TypeId
    - right TypeId

` Reports an equality between two units that another written between them disagrees with: a
` number would convert by whichever is found first.
. ratios [F64]
for equality in types.equalities
    if equality.from == left && equality.to == right
        ratios += equality.ratio.multiplier / equality.ratio.divisor
for ratio in ratios
    . quotient = ratio / ratios[0]
    if quotient > 1.000000001 || quotient < 0.999999999
        . from = type-short-name(types, left)
        . to = type-short-name(types, right)
        . message = "Equalities between $from and $to disagree: one makes 1 $from ${ratios[0]} $to, another ${ratio} $to; keep one of them"
        frame.diagnose(id, .stated, program.store-atom(message))
        =

────────────────────
_ do misstates-unit Bool
    - id SyntaxId

` Reports a side of a unit's declaration written as a number in a unit that names nothing, or
` as zero of a unit, which relates no number of one to the other, and says whether it did.
. text = ""
. unit Atom? = null
do match? tree.nodes[id]
    | .node-integer-syntax(row)
        text = row.value
        unit = row.unit
    | .node-float-syntax(row)
        text = row.value
        unit = row.unit
if !unit
    = false
if literal-unit(id, text, unit) == invalid-type
    = true
if (text as F64) != 0.0
    = false
. message = "A unit cannot be declared as zero of another, which no number of it would convert from; write a number other than zero"
frame.diagnose(id, .stated, program.store-atom(message))
= true

────────────────────
_ do unit-of TypeId
    - expr SyntaxId

` The unit an expression of an equality measures in, and no type for a bare number. Two
` units cannot meet in one operation.
do match? tree.nodes[expr]
    | .node-integer-syntax(row)
        = if row.unit then unit-class(row.unit) else no-type
    | .node-float-syntax(row)
        = if row.unit then unit-class(row.unit) else no-type
    | .node-binary-expression(row)
        . left = unit-of(row.lhs)
        . right = unit-of(row.rhs)
        if left != no-type && right != no-type
            frame.diagnose(expr, .stated, program.store-atom("Conflicting units"))
            = invalid-type
        = if left != no-type then left else right
= no-type

────────────────────
_ member-name (Atom?, Bool, SyntaxId)
    - target Module
    - member DeclId

match target.decls[member]
    | .decl-property(row)
        (row.name, row.access != .private-access, row.syntax)
    | .decl-function(row)
        (row.name, row.access != .private-access, row.syntax)
    | .decl-event(row)
        (row.name, true, row.syntax)
    ??
        (null, false, 0)

────────────────────
_ do declares-name Bool
    - owner-module ModuleId
    - owner DeclId
    - name Atom
    - shared-only Bool

` Whether a class or facet declares a member of a name, or one of the name that is not private.
. target = program.modules[owner-module]
. members = match target.decls[owner]
    | .decl-class(row)
        row.members
    | .decl-extension(row)
        row.members
    ??
        RowRange'DeclId()
for member in target.members-named(members, name)
    . (named, is-shared, _) = member-name(target, member)
    if named && named == name && (is-shared || !shared-only)
        = true
= false

────────────────────
_ class-name-of String
    - ref DeclRef

match program.modules[ref.module].decls[ref.decl]
    | .decl-class(row)
        row.name.text
    ??
        "its class"

────────────────────
_ facet-name-of String
    - facet U32

match program.modules[program.facets.modules[facet]].decls[program.facets.decls[facet]]
    | .decl-extension(row)
        row.facet?.text ?? "a facet"
    ??
        "a facet"

────────────────────
_ do event-key Bool
    - type TypeId

` Whether a type keys an event: an integer, a `Char` or a `Bool`, or a tuple of an integer
` `index` and an integer `generation`, or a type named for such a tuple.
if is-integer-kind(types.intrinsic-of(type))
    = true
. base = types.base-of(type) ?? no-type
if types.rows[type] is .type-class && base != no-type && types.rows[base] is .type-tuple
    = event-key(base)
do match? types.rows[type]
    | .type-tuple(row)
        if row.fields.count != 2 || row.names.count != 2
            = false
        if types.child-name(row.names, 0).text != "index" || not-generation
            = false
        .. not-generation = types.child-name(row.names, 1).text != "generation"
        = integer-index && is-integer-kind(types.intrinsic-of(types.child-type(row.fields, 1)))
            .. integer-index = is-integer-kind(types.intrinsic-of(types.child-type(row.fields, 0)))
= false

────────────────────
_ checks-at-declaration Bool
    - declaration CheckedDecl

` Whether how a function returns is checked as the module declares it (`check-return-mode`):
` a function, getter, setter or conversion written in the module as one expression.
declared-plain && declaration.body != 0 && (function-or-getter || declaration.kind == .setter-decl)

.. declared-plain = !declaration.is-generated && !declaration.is-imperative && !declaration.is-main
.. function-or-getter = declaration.kind == .function-decl || declaration.kind == .getter-decl

────────────────────
_ do check-closure-rows
    - body SyntaxId

=? if tree.first-unexpressed(body, false) != 0 || tree.first-unexpressed(body, true) != 0
. stated = first-stated(body)
if stated != 0
    frame.diagnose(stated, .stated, program.store-atom(tree.requires-do-text(stated)))

────────────────────
_ first-stated SyntaxId
    - body SyntaxId

match tree.nodes[body]
    | .node-block(row)
        first-stated-row(row.body)
    ??
        0

────────────────────
_ do first-stated-row SyntaxId
    - rows RowRange'SyntaxId

. result Index = rows.count
for position in 0 .. < rows.count
    if !tree.is-trailing-row(tree.children[rows.start + position])
        result = position
for position in 0 .. < rows.count
    . statement = tree.children[rows.start + position]
    do match? tree.nodes[statement]
        | .node-assign
            = statement
        | .node-if-block
            = statement
        | .node-call-expression
            =? statement if (position as Index) < result
        | .node-declare(row)
            =? statement if row.is-lazy && result < rows.count && comes-first
            .. comes-first = precedes(module, statement, module, tree.children[rows.start + result])
= 0

────────────────────
_ do family-root TypeId
    - sheet TypeId

. root = sheet
while true
    types.complete(root)
    . base = types.base-of(root) ?? no-type
    if !is-sheet-type(base)
        = root
    root = base

────────────────────
_ part-members RowRange'DeclId
    - ref DeclRef

` The members a class, a facet of one, or an extension of a style sheet, declares.
match program.modules[ref.module].decls[ref.decl]
    | .decl-class(row)
        row.members
    | .decl-extension(row)
        row.members
    | .decl-sheet-extension(row)
        row.members
    ??
        RowRange'DeclId()

────────────────────
_ do holder-env TypeEnv
    - ref DeclRef

` The types the members of a class, a facet of one, or an extension of a style sheet, are written
` under: those of the class, the facet's class, or the sheet it extends.
. sheet = extended-sheet(ref)
if sheet
    = types.class-env(sheet.module, sheet.decl)
. facets = program.facets
. facet = facets.index-of(ref.module, ref.decl) if facets.count != 0
if facet
    = types.class-env(facets.owner-modules[facet], facets.owner-decls[facet])
= types.class-env(ref.module, ref.decl)

────────────────────
_ do written-type-name String?
    - written AST
    - id SyntaxId

` A type as the reference names it to tell style rules apart (`getTypeName`): an identifier by its
` name, followed by the names of the type arguments written after it; a tuple, a struct and a
` list by those of what they hold; nothing written as nothing. None for another way of writing
` one.
if id == 0
    = ""
do match? written.nodes[id]
    | .node-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        . base = written-type-name(written, row.base)
        if !base
            = null
        . text = base
        for arg in written.children[row.args]
            . held = written-type-name(written, arg)
            if !held
                = null
            text += "'${held}"
        = text
    | .node-type-tuple(row)
        . names = written-type-names(written, row.field-types)
        if !names
            = null
        = if row.is-struct then "struct(${names})" else "tuple(${names})"
    | .node-type-list(row)
        . names = written-type-names(written, row.patterns)
        if !names
            = null
        = "list(${names})"
    | .node-type-capture(row)
        = written-type-name(written, row.type)
= null

────────────────────
_ do written-type-names String?
    - written AST
    - ids RowRange'SyntaxId

` The names of types written in a row, as `written-type-name` names each, joined by commas.
. text = ""
for offset in 0 .. < ids.count
    . held = written-type-name(written, written.children[ids.start + offset])
    if !held
        = null
    if offset != 0
        text += ","
    text += held
= text

────────────────────
_ do check-statement TypeId
    - id SyntaxId
    - want Want = Want()

if id == 0
    = no-type
. stated = want.adding(.want-statement)
if is-leaving(id)
    facts.mark-leaving(instance, id)

do match tree.nodes[id]
    | .node-block(row)
        = check-block(id, row.body, id == quasi-free-block, want.asks(.want-match-statement))
    | .node-declare(row)
        if !row.is-lazy
            require-do(id, "Immediate declaration requires do")
        if declares-getter(row.left)
            = no-type
        if !row.is-lazy || !waits-for-read(row.left)
            check-declare(row.left, tree.machine-or-value(row.left, row.right), row.is-lazy)
        if row.is-lazy || (!tree.is-plain-name(row.left) && !is-typed-name(row.left))
            frame.doubt-members()
        = no-type
    | .node-return(row)
        note-explicit-return(id, row.expr)
        check-return(id, row.expr, false)
        = no-type
    | .node-return-if-true(row)
        note-explicit-return(id, row.expr)
        note-truthiness(row.condition, row.condition, infer-tested(row.condition))
        . mark = scratch.narrowings.mark
        narrowing.narrow-condition(row.condition, true)
        . known = frame.save-members()
        check-return(id, row.expr, true)
        frame.restore-members(known)
        pop-conditional(mark)
        narrowing.narrow-condition(row.condition, false)
        = no-type
    | .node-if-block(row)
        if is-region(id)
            decline(id)
            = no-type
        check-if(id, row.condition, row.body, row.next)
        = no-type
    | .node-while-block(row)
        require-do(id, "Loop requires do")
        check-while(id, row.condition, row.body)
        = no-type
    | .node-assertion-syntax(row)
        check-assertion(id, row.exception, row.condition)
        if row.condition != 0
            narrowing.narrow-condition(row.condition, false)
        = no-type
    | .node-yield(row)
        require-do(id, "Yield requires do")
        frame.check-suspends(id)
        note-yield(yielded-value(id, row.expr), id, false, written-literal(row.expr))
        note-escape(row.expr)
        if cleans-up || loop-depth != 0
            frame.doubt-members()
        = no-type
    | .node-do-block(row)
        if nested-decl-of(id) != 0
            check-region(id, row.body)
            = no-type
        . saved = frame.surround
        frame.surround = frame.surround.effects = dispatch-effects(saved.effects /or/ row.compilation-effects /or/ program.bans-named(module, row.bans))
        if (saved.effects /and/ CompilationEffect.gc-free) == 0 && enters-gc-free
            frame.surround = frame.surround.zone-site = id
        .. enters-gc-free = (row.compilation-effects /and/ CompilationEffect.gc-free) != 0
        do-depth += 1
        check-statement(row.body, if tree.is-match-syntax(row.body) then Want().adding(.want-match-statement) else Want())
        do-depth -= 1
        frame.surround = saved
        = no-type
    | .node-noop
        = no-type
    | .node-probe-statement(row)
        if compiles-probe(id)
            check-statement(row.body)
        = no-type
    | .node-probe-scope(row)
        if compiles-probe(id)
            for statement in tree.children[row.body]
                check-statement(statement)
        = no-type
    | .node-probe(row)
        if compiles-probe(id)
            check-probe(id, row)
        = no-type
    | .node-probe-counter(row)
        if compiles-probe(id)
            check-probe-counter(id, row)
        = no-type
    | .node-probe-group(row)
        if compiles-probe(id)
            check-probe-group(id, row)
        = no-type
    | .node-probe-assign(row)
        if compiles-probe(id)
            check-probe-assign(id, row)
        = no-type
    | .node-probe-snapshot
        = no-type
    | .node-probe-preview
        = no-type
    | .node-break
        if leaves-cleanup()
            report-cleanup-leave(id, "break")
        else if loop-marks.length == 0 && is-subscriber-body()
            demand-unsubscribe(id)
        else if loop-marks.length == 0
            frame.diagnose(id, .stated, program.store-atom("`break` outside a loop"))
        = no-type
    | .node-continue
        if leaves-cleanup()
            report-cleanup-leave(id, "continue")
        else if loop-marks.length == 0 && !is-subscriber-body()
            frame.diagnose(id, .stated, program.store-atom("`continue` outside a loop"))
        = no-type
    | .node-for-block(row)
        require-do(id, "Loop requires do")
        check-for(id, row.loop, row.body, row.next)
        frame.forget-members()
        = no-type
    | .node-do-finally-block(row)
        cleans-up = true
        do-depth += 1
        frame.doubt-members()
        . finished = check-statement(row.body)
        frame.doubt-members()
        do-depth -= 1
        = finished
    | .node-use-block(row)
        check-use(id, row.subject)
        frame.doubt-members()
        discarding-block = row.body
        check-statement(row.body)
        frame.doubt-members()
        = no-type
    | .node-do-task-block(row)
        if row.worker != 0 && row.is-parallel
            frame.diagnose(id, .stated, program.store-atom(tree.both-targets-text()))
        else if row.worker != 0
            check-worker(id, row.worker)
        frame.doubt-members()
        check-task(id)
        = no-type
    | .node-stack-local-binding-block(row)
        cleans-up = true
        frame.doubt-members()
        check-stack-binding(id, row.value, row.body)
        frame.doubt-members()
        = no-type
    | .node-iterator-expression(row)
        if frame.declaration.syntax == id && is-subscriber-body()
            check-broadcast(id, row.loop, row.body)
            = no-type
        if frame.declaration.syntax == id
            check-comprehension(row.loop, row.body)
            = no-type
        = infer(id, stated)
    | .node-pipeline-expression(row)
        if frame.declaration.syntax == id && row.op == .stream-pattern-pipe-op
            check-pattern-pipe(id, row.right)
            = no-type
        = infer(id, stated)
    | .node-binary-expression(row)
        if frame.declaration.syntax == id && row.op == .stream-pattern-pipe-op
            check-pattern-pipe(id, row.rhs)
            = no-type
        = infer(id, stated)
    | .node-bullet-expression
        if frame.declaration.syntax == id
            check-bullets(id)
            = no-type
        = infer(id, stated)
    | .node-state-machine
        do check-machine-site(id)
        = no-type
    ??
        = infer(id, stated)

────────────────────
_ do check-stack-binding
    - id SyntaxId
    - value-syntax SyntaxId
    - body SyntaxId

. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-global && program.modules[resolution.module].decls[resolution.decl] is .decl-effect
    check-effect-binding(id, value-syntax, body, resolution.module, resolution.decl)
    =
. declared = no-type
if resolution.kind == .resolve-global
    declared = demand-global(id, resolution.module, resolution.decl)
. value = infer(value-syntax)
if resolution.kind == .resolve-global && value != invalid-type
    conversions.convert(id, value-syntax, value, declared, .reason-assignment)
if resolution.kind == .resolve-global
    . first = tree.subtree-start(body)
    facts.stack-scopes.append(StackScope(instance, first, body, resolution.module, resolution.decl, 0))
discarding-block = body
check-statement(body)

────────────────────
_ do check-effect-binding
    - id SyntaxId
    - value-syntax SyntaxId
    - body SyntaxId
    - module ModuleId
    - decl DeclId

` `do with` an effect: the body runs with the fake bound to it, an object of a class whose methods
` answer the effect's doors that the body reaches, each typed with the fake in its key.
. value = infer(value-syntax)
. effect = program.effects.index-of(module, decl)
. saved = frame.surround
. entry U32 = 0
if value != invalid-type && (!types.is-class-type(value) || types.is-optional(value))
    frame.diagnose(value-syntax, .stated, program.store-atom(fake-class-text(module, decl, value)))
else if effect && effect >= most-effects()
    frame.diagnose(id, .stated, program.store-atom("A program can bind at most ${most-effects()} effects, and '${program.effects.names[effect].text}' is past them"))
else if value != invalid-type && effect
    frame.surround = frame.surround.effects = instances.bound-to(saved.effects, effect, value)
    entry = instances.swap-entry-of(frame.surround.effects, effect)
facts.stack-scopes.append(StackScope(instance, tree.subtree-start(body), body, module, decl, entry))
discarding-block = body
check-statement(body)
frame.surround = saved

────────────────────
_ do fake-class-text String
    - module ModuleId
    - decl DeclId
    - value TypeId

. name = program.effects.names[program.effects.index-of(module, decl) ?? 0].text
= "A fake bound to '$name' is an object of a class, not ${type-short-name(types, value)}"

────────────────────
_ do redeclares-in Bool
    - block SyntaxId

` Whether a block declares a local again that it declared in an earlier statement, which the
` binder leaves to the type pass to settle.
if frame.binding == no-binding
    = false
. range = bindings.bindings[frame.binding].diagnostics
. start = tree.subtree-start(block)
for diagnostic in bindings.diagnostics[range.start .. < range.end]
    if diagnostic.kind == .redeclared && diagnostic.syntax >= start && diagnostic.syntax <= block
        = true
= false

────────────────────
_ do projects Bool

` Whether the reference opens a scope before a statement here (`pushFlowProjectionScope`). It
` does where a local that holds an optional, and that nothing assigns, is known by a test to hold
` a value, and makes a local of the value in that scope, which the blocks inside see as well
` (`materialized`): it opens none for that local again there. An optional of a tuple keeps its
` place.
. opens = false
for slot in frame.tested-locals()
    . known = slot-known(slot)
    if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 || !types.is-optional(known)
        continue
    . inner = types.optional-inner(known)
    if types.intrinsic-of(inner) == .tuple || frame.slot-type(slot) != inner || projected
        continue
    .. projected = materialized.find(slot) != null
    materialized += slot
    opens = true
= opens

────────────────────
_ do settle-redeclared
    - statement SyntaxId
    - projected SyntaxId

` A local a statement declares again, where an earlier statement of its block declared it, is
` a new one past a scope the reference opened after that statement (`projects`), as the
` reference declares it there. With no such scope it is declared twice in one scope.
. range = bindings.bindings[frame.binding].diagnostics
. start = tree.subtree-start(statement)
for diagnostic in bindings.diagnostics[range.start .. < range.end]
    if diagnostic.kind != .redeclared || diagnostic.syntax < start || diagnostic.syntax > statement
        continue
    if diagnostic.earlier >= start
        continue
    if projected == 0 || tree.subtree-start(projected) <= diagnostic.earlier
        frame.diagnose
            - diagnostic.syntax
            - .stated
            - program.store-atom("Redefining variable in same scope")

────────────────────
_ do check-block TypeId
    - block SyntaxId
    - body RowRange'SyntaxId
    - skips-quasi Bool
    - matched Bool = false

` The value of a block is that of its one statement that gives one. A block whose last
` statement leaves, by a raise under no condition, a return, `continue` or `break`, never
` ends, and gives none; the block and that statement are noted as leaving. The statements
` after one that leaves are not checked, but for lazy locals, as the reference compiles none of
` them; in markup content a statement that leaves is an error instead. A statement that
` names what it does not call is checked (`check-called`) unless it gives the block its value:
` the last of a block the reference keeps the value of, which a `discarding-block` is not. The
` arms of a block a match written as a statement runs (`matched`) are that match's.
. mark = scratch.narrowings.mark
. discards = block == discarding-block
. last = if body.count != 0 then tree.children[body.start + body.count - 1] else 0
. kept = tree.kept-row(body)
. value = no-type
. values = 0
. leaves = false
. final-leave SyntaxId = 0
. finals [SyntaxId]
. limits [SyntaxId]
. open = 0
. parent = content-parent(block)
. attributes = parent != no-type && element-bodies.find(block) != null
. awaiting = if parent == no-type then await-elements(body) else unbuilt.length
if parent != no-type && names-elements(block)
    raise-elements(block, body)
. redeclares = redeclares-in(block)
. materialized-mark = materialized.length
. projected SyntaxId = 0
. dead = false
for statement in tree.children[body]
    if dead && !tree.is-lazy-declare(statement)
        continue
    if redeclares
        if projects()
            projected = statement
        settle-redeclared(statement, projected)
    if block == rule-lines && tree.rule-part(statement)
        continue
    if tree.is-finally(statement)
        finals += statement
        limits += 0
        continue
    if attributes && (tree.nodes[statement] is .node-assign || binds-slot(statement))
        facts.note-content-link(ContentLink(instance, statement, parent, no-type, no-fact))
        continue
    if parent != no-type && tree.element-fill(statement)
        facts.note-content-link(ContentLink(instance, statement, parent, no-type, no-fact))
        continue
    . hosted = content-blocks.length
    . reported = facts.diagnostics.length
    if parent != no-type
        host-content(statement, parent)
    else
        raise-statement(statement)
    . calls-before U32 = facts.calls.length as U32
    . declared = declared-return
    if skips-quasi && arms-line && declared != no-type && declared != types.void-type
        note-returned-match(statement, declared)
        arms-expected = declared
    .. arms-line = tree.is-arms-syntax(statement)
    . named = skips-quasi && declared != no-type && symbolic
        .. symbolic = tree.calls-symbol(statement) || tree.symbol-of(statement) != null
    . watches = open < finals.length
    if watches
        watching-leaves += 1
    . want = Want()
    if parent != no-type
        want = want.adding(.want-content-line)
    if matched && tree.is-arms-syntax(statement)
        want = want.adding(.want-match-statement)
    if skips-quasi
        want = want.adding(.want-quasi)
    if skips-quasi && choice-statement && declared != no-type && declared != types.void-type
        want = want.asking(.want-choice, declared)
    .. choice-statement = tree.is-choice-syntax(statement)
    if discards || statement != last
        want = want.adding(.want-unused)
    . produced = if named then infer-with-expected(statement, declared, want) else check-line(statement, parent, want)
    if watches
        watching-leaves -= 1
    if parent != no-type
        while content-blocks.length != hosted
            content-blocks.pop()
            content-parents.pop()
            content-names.pop()
        if !leaves-line(statement)
            link-content(statement, produced, parent)
            . settles = if element-line then attributes else tree.content-line(statement)
                .. element-line = tree.content-element(statement) != 0
            if settles && is-live-statement(statement)
                settle-content(statement, parent, produced)
        else if facts.diagnostics.length == reported
            frame.diagnose(statement, .stated, program.store-atom("Illegal return"))
    else
        . named = named-element(statement)
        if named && produced != invalid-type && produced != no-type
            note-named(statement, frame.slot-type(named))
        if discards || statement != last
            check-called(statement, produced, is-step-position(statement, kept, discards), body)
    if watches && may-leave(calls-before)
        for position in open .. < finals.length
            limits[position] = statement
        open = finals.length
    . quasi = skips-quasi && tree.is-quasi-syntax(statement)
    if produced != no-type && produced != types.void-type && !quasi
        value = produced
        value-syntax = statement
        values += 1
    else if produced == types.void-type && !quasi && (declared == no-type || declared == produced)
        values += 1
    if !tree.is-lazy-declare(statement)
        . valued = produced != no-type && produced != types.void-type
        final-statement = if valued && !tree.is-quasi-syntax(statement) then statement else 0
        leaves = is-leaving(statement)
        final-leave = statement
        dead = leaves && parent == no-type
for position in 0 .. < finals.length
    check-finally(finals[position], limits[position])
settle-elements(awaiting)
if leaves
    facts.mark-leaving(instance, block)
    facts.mark-leaving(instance, final-leave)
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
frame.keep-assigned(settled)
if materialized.length != materialized-mark
    -= materialized[materialized-mark .. < materialized.length]
= if values == 1 && !leaves then value else no-type

────────────────────
_ do check-called
    - statement SyntaxId
    - produced TypeId
    - is-step Bool = false
    - body RowRange'SyntaxId = RowRange'SyntaxId()

` A statement that only names a function, a closure or a method does nothing with it, and is
` the reference's error where nothing takes its value.
=? if produced == invalid-type
. named = tree.nodes[statement] is .node-identifier || tree.nodes[statement] is .node-get-expression
if named && produced != no-type
    . kind = types.intrinsic-of(produced)
    if kind == .function || kind == .closure || kind == .binding
        . written = description-of(tree, statement)
        frame.diagnose
            - statement
            - .stated
            - program.store-atom("$written is never called; write $written() to call it")
        =
if is-step && is-bare-value(statement) && !is-piped-row(body, statement)
    frame.diagnose(statement, .stated, program.store-atom(bare-value-text()))

────────────────────
_ is-step-position Bool
    - statement SyntaxId
    - kept SyntaxId
    - discards Bool

|? discards && is-constructor-kind(frame.declaration.kind)
    false
|? statement != kept
    true
|? !discards || frame.declaration.is-main
    false
??
    !(builds || frame.declaration.kind == .function-decl || frame.declaration.kind == .getter-decl)

.. builds = giving.yields || is-constructor-kind(frame.declaration.kind)

────────────────────
_ print-block-text String

"A print is a step and gives no value; end the block with its value"

────────────────────
_ is-bare-value Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-identifier
        true
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-string-syntax
        true
    | .node-get-expression
        true
    | .node-index-expression
        true
    | .node-list-syntax
        true
    | .node-tuple-syntax
        true
    | .node-range-expression
        true
    | .node-cast-expression
        true
    | .node-binary-expression(row)
        is-arithmetic(row.op) || is-comparison(row.op) || valued-ops has row.op
    | .node-unary-expression(row)
        row.op == .not-op || row.op == .negative-op || row.op == .bitwise-not-op
    ??
        false

.. valued-ops = [Operator.concat-op, Operator.concat-string-op, Operator.and-op, Operator.or-op, Operator.is-op, Operator.is-not-op, Operator.is-exactly-op, Operator.is-not-exactly-op, Operator.is-similar-op, Operator.is-not-similar-op, Operator.is-in-op, Operator.not-in-op, Operator.has-op, Operator.has-not-op]

────────────────────
_ is-leaving Bool
    - statement SyntaxId

` Whether a statement leaves its block. `=? value` of an optional leaves only where the
` optional holds a value, so it does not.
match tree.nodes[statement]
    | .node-assertion-syntax(row)
        row.condition == 0
    | .node-return(row)
        !returns-present(row.expr)
    | .node-continue
        true
    | .node-break
        true
    ??
        false

────────────────────
_ do returns-present Bool
    - expr SyntaxId

` Whether a return gives `=? value` of an optional, which leaves only where it holds a value,
` as the reference returns what it holds and goes on where it holds none. Before the value is
` typed, any `=? value` may be one.
if expr == 0
    = false
do match? tree.nodes[expr]
    | .node-optional-chain
        . value = facts.node-type(instance, expr)
        = value == no-type || (value != invalid-type && types.is-optional(value))
= false

────────────────────
_ do may-leave Bool
    - calls-before U32

` Whether a statement just checked called something known to panic. A finally block runs
` wherever control leaves its block after it, so it sees only the locals declared before the
` first statement after it that may leave. A callee is
` known to panic once its body is typed, so a statement watched for this types the bodies of
` what it calls.
. position = facts.latest-call-of(instance)
while position != no-fact && position >= calls-before
    . callee = facts.calls[position].callee
    if callee != no-instance && instances.rows[callee].may-panic
        = true
    position = facts.prior-call(position)
= false

────────────────────
_ leaves-cleanup Bool

` Whether a `break` or `continue` here would leave a cleanup for a loop open around it.
finally.cleaning-up && loop-marks.length != 0 && loop-marks.length == finally.loops

────────────────────
_ do report-cleanup-leave
    - id SyntaxId
    - word String

` Reports a `break` or `continue` that would leave a cleanup, which runs however its block is
` left, for the loop around it.
. text = "A cleanup cannot \"$word\" the loop around it, as it runs however its block is left; write \"$word\" in the loop's body"
frame.diagnose(id, .stated, program.store-atom(text))

────────────────────
_ do check-finally
    - statement SyntaxId
    - limit SyntaxId

. saved = finally
finally = finally.limit = limit
finally = finally.loops = loop-marks.length
if saved.cleaning-up
    frame.diagnose(statement, .stated, program.store-atom("Illegal deferred statement"))
finally = finally.cleaning-up = true
check-statement(statement)
finally = saved

────────────────────
_ waits-for-read Bool
    - left SyntaxId

` A lazy local takes its value where it is first read, under what is known there, and one
` nothing reads is never computed. One that gives a property its value is computed with the
` object.
slot != null && bindings.slots[slot].property == 0

.. slot = declaring-slot(tree.first-named(left))

────────────────────
_ declares-getter Bool
    - left SyntaxId

` Whether a declaration declares a local of a row of a markup loop region that the reference
` reads as a getter: its value is typed where it is read, and not where it is written.
slot != null && bindings.slots[slot].getter != 0

.. slot = declaring-slot(left)

────────────────────
_ do check-declare
    - left SyntaxId
    - right SyntaxId
    - is-lazy Bool

if is-lazy && lazy-known(left)
    =
. value = no-type
if right != 0
    . slot = declaring-slot(left) if is-lazy
    if slot
        frame.assign(slot, invalid-type)
        lazy-slots += slot
    own-anonymous-cases(left, right)
    . saved-eager = reading
    if slot && bindings.slots[slot].property != 0
        reading = reading.eager = true
    value = infer-declared(left, right)
    reading = saved-eager
    if slot
        lazy-slots.pop()
    if !is-lazy
        note-escape(right)
    if !is-lazy && !writes-type(left)
        note-loose(right)
else
    construct-declared(left)
declare(left, value, right)

────────────────────
_ do own-anonymous-cases
    - pattern SyntaxId
    - root SyntaxId

` Gives the anonymous cases a declaration owns their union: every `..name` under its value
` that names this owner, payloads unified by case name, in source order. Payloads written as
` numbers with no suffix join others place by place, so `..value(1)` beside `..value(1.5)` holds
` a float.
. owner = identifier-name(tree, tree.pattern-identifier(pattern))
if !owner || anonymous-union(owner) != no-type
    =
. sites [SyntaxId]
. held [TypeId]
hold-payloads(root, owner, owner, sites, held)
. names [Atom]
. payloads [TypeId]
. counts [U32]
. written [Bool]
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            . payload = held[position]
            . literal = written-payload(row.args)
            . known = names.find(row.name)
            if known != null && counts[known] != row.args.count
                report-arity(sites[position], row.name)
            else if known != null && payload != invalid-type
                . joined = relations.unify(payloads[known], payload, module)
                if relation-legal(joined)
                    payloads[known] = joined.unified
                else
                    . places = relations.joined-places(payloads[known], payload)
                    if places != no-type && kept-written && (literal || places == payload)
                        payloads[known] = places
                    .. kept-written = written[known] || places == payloads[known]
                written[known] = written[known] && literal
            else if known == null && payload != invalid-type
                names += row.name
                payloads += payload
                counts += row.args.count
                written += literal
if names.length == 0
    =
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < names.length
    scratch.names.push(names[position])
    scratch.types.push(payloads[position])
owner-names += owner
owner-unions += types.intern-named-union(owner, mark, names-mark)
owner-declared += true

────────────────────
_ do hold-payloads
    - root SyntaxId
    - owner Atom?
    - named Atom
    - sites [SyntaxId]
    - held [TypeId]

. declared = owner != null
. waits = false
for id in tree.subtree-start(root) .. root
    do match? tree.nodes[id]
        | .node-anonymous-case(row)
            if owns-case(owner, row.owner)
                . waiting = row.args.count != 0 && (!declared || reads-untyped(row.args))
                . reported = facts.diagnostics.length
                . payload = if waiting then no-type else anonymous-payload(row.args)
                if payload == invalid-type && facts.diagnostics.length == reported
                    report-unheld(id, row.name)
                sites += id
                held += payload
                waits = waits || waiting
if !waits
    =
foresee-payloads(root, named, declared, sites, held)
for position in 0 .. < sites.length
    if held[position] == invalid-type && unheld-cases.find(sites[position]) == null
        unheld-cases += sites[position]

────────────────────
_ do report-unheld
    - id SyntaxId
    - name Atom

. message = "Unable to infer payload type for anonymous case '..${name.text}'"
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do owns-case Bool
    - owner Atom?
    - written Atom?

if owner && written
    = owner == written
= !owner && !written

────────────────────
_ do reads-untyped Bool
    - args RowRange'SyntaxId

. followed [SlotId]
for arg in tree.children[args]
    if value-reads-untyped(arg, followed)
        = true
= false

────────────────────
_ do value-reads-untyped Bool
    - value SyntaxId
    - followed [SlotId]

for id in tree.subtree-start(value) .. value
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, id)
            if resolution.kind == .resolve-slot && awaits-flow(resolution.slot)
                = true
            if resolution.kind == .resolve-slot && lazy-reads-untyped(resolution.slot, followed)
                = true
= false

────────────────────
_ do lazy-reads-untyped Bool
    - slot SlotId
    - followed [SlotId]

. row = bindings.slots[slot]
. unread = row.kind == .slot-lazy && !frame.is-captured(slot) && frame.known(slot) == no-type
if !unread || row.group == 0 || followed.find(slot) != null
    = false
followed += slot
do match? tree.nodes[row.group]
    | .node-declare(declaration)
        = value-reads-untyped(declaration.right, followed)
= false

────────────────────
_ do awaits-flow Bool
    - slot SlotId

if frame.is-captured(slot) || frame.known(slot) != no-type
    = false
if bindings.slots[slot].getter != 0 || is-placed(slot)
    = false
. kind = bindings.slots[slot].kind
. named = kind == .slot-local || kind == .slot-pattern || kind == .slot-loop-item
= named || kind == .slot-it || kind == .slot-each

────────────────────
_ do foresee-payloads
    - root SyntaxId
    - named Atom
    - declared Bool
    - sites [SyntaxId]
    - held [TypeId]

. listed [Atom]
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            if listed.find(row.name) == null
                listed += row.name
                scratch.names.push(row.name)
                scratch.types.push(first-held(row.name, sites, held))
. provisional = types.intern-named-union(named, mark, names-mark)
. checker = trial-checker(root)
for position in 0 .. < owner-names.length
    checker.owner-names += owner-names[position]
    checker.owner-unions += owner-unions[position]
    checker.owner-declared += owner-declared[position]
checker.owner-names += named
checker.owner-unions += provisional
checker.owner-declared += declared
checker.foreseen-union = provisional
if root == frame.declaration.body
    checker.value-syntax = root
    checker.quasi-free-block = if frame.declaration.is-imperative then 0 else root
    checker.discarding-block = if imperative-body then root else 0
        .. imperative-body = frame.declaration.is-imperative || builds
        .. builds = frame.declaration.kind == .constructor-decl
. reported = facts.diagnostics.length
scratch.runners += checker
scratch.running += checker.instance
checker.check-statement(root)
scratch.runners.pop()
scratch.running.pop()
facts.drop-trial-diagnostics(reported, checker.instance)
for position in 0 .. < sites.length
    if held[position] == no-type
        held[position] = checker.foreseen-payload(sites[position])
checker.close()
checker.retire()

────────────────────
_ do foreseen-payload TypeId
    - site SyntaxId

. payload = invalid-type
for position in 0 .. < foreseen-sites.length
    if foreseen-sites[position] == site && foreseen-payloads[position] != invalid-type
        payload = foreseen-payloads[position]
= payload

────────────────────
_ do foreseer-of Checker?
    - union TypeId

if foreseen-union == union
    = this
if outer
    = outer.foreseer-of(union)
= null

────────────────────
_ do first-held TypeId
    - name Atom
    - sites [SyntaxId]
    - held [TypeId]

for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            if row.name == name && held[position] != no-type && held[position] != invalid-type
                = held[position]
= types.void-type

────────────────────
_ do written-payload Bool
    - args RowRange'SyntaxId

` Whether each value an anonymous case is given is written as a number with no suffix.
=? false if args.count == 0
= all(tree.children[args]) • where conversions.literal-of(each) != 0

────────────────────
_ do report-arity
    - id SyntaxId
    - name Atom

` One anonymous case holds the same number of values wherever its owner names it.
. message = "Anonymous case '..${name.text}' has conflicting arity"
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do anonymous-payload TypeId
    - args RowRange'SyntaxId

if args.count == 0
    = types.void-type
. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0u32
for arg in tree.children[args]
    . type = infer(arg)
    if type == invalid-type
        scratch.types.rewind(mark)
        scratch.names.rewind(names-mark)
        = invalid-type
    scratch.names.push(types.index-atom(position))
    scratch.types.push(type)
    position += 1
if position == 1
    . single = scratch.types[mark]
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = single
= types.intern-tuple(mark, names-mark)

────────────────────
_ do anonymous-union TypeId
    - owner Atom

for position in 0 .. < owner-names.length
    if owner-names[position] == owner
        = owner-unions[position]
if outer
    = outer.anonymous-union(owner)
= no-type

────────────────────
_ do symbol-unions
    - name Atom
    - found [TypeId]
    - owners [Atom]

` The unions of anonymous cases that have a case of a name, among those a declaration typed
` so far owns: those of the enclosing functions first, then this one's in the order typed.
if outer
    outer.symbol-unions(name, found, owners)
for position in 0 .. < owner-names.length
    if !owner-declared[position] || found.find(owner-unions[position]) != null
        continue
    for fact in types.cases-of(owner-unions[position])
        if fact.name && fact.name! == name
            found += owner-unions[position]
            owners += owner-names[position]
            break

────────────────────
_ do anonymous-symbol TypeId
    - id SyntaxId
    - name Atom

` The union a case named by its symbol alone is of where a declaration owns anonymous cases
` of that name: the one union that has it, as the reference picks before any declared type.
` Gives no type where none has it, and reports a name that two have.
. found [TypeId]
. owners [Atom]
symbol-unions(name, found, owners)
if found.length == 0
    = no-type
if found.length == 1
    = found[0]
. listed = ""
for owner in owners
    if listed.length != 0
        listed += ", "
    listed += "'${owner.text}'"
frame.diagnose
    - id
    - .stated
    - program.store-atom("Anonymous case '.${name.text}' is ambiguous between $listed")
= invalid-type

────────────────────
_ do function-union TypeId

` The union of the anonymous cases a function's body gives that no declaration in it owns:
` the function owns them, under its own name.
. name Atom? = null
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        name = fn.name
. body = frame.declaration.body
if !name || body == 0
    = no-type
. known = anonymous-union(name)
if known != no-type
    = known
. sites [SyntaxId]
. held [TypeId]
hold-payloads(body, null, name, sites, held)
. names [Atom]
. payloads [TypeId]
. counts [U32]
for position in 0 .. < sites.length
    do match? tree.nodes[sites[position]]
        | .node-anonymous-case(row)
            . payload = held[position]
            . found = names.find(row.name)
            if found != null && counts[found] != row.args.count
                report-arity(sites[position], row.name)
            else if found != null && payload != invalid-type
                . joined = relations.unify(payloads[found], payload, module)
                if relation-legal(joined)
                    payloads[found] = joined.unified
            else if found == null && payload != invalid-type
                names += row.name
                payloads += payload
                counts += row.args.count
if names.length == 0
    = no-type
. mark = scratch.types.mark
. names-mark = scratch.names.mark
for position in 0 .. < names.length
    scratch.names.push(names[position])
    scratch.types.push(payloads[position])
. union = types.intern-named-union(name, mark, names-mark)
owner-names += name
owner-unions += union
owner-declared += false
= union

────────────────────
_ do infer-anonymous-case TypeId
    - id SyntaxId
    - name Atom
    - args RowRange'SyntaxId
    - owner Atom?

` An anonymous case is a case of the union its owner's cases make, planned by its number.
` Each value it is given converts to the field in its place of what the case holds, or one
` value to what the case holds. A value that does not convert is reported at the case. One
` value given for a case that holds a tuple or a struct is taken by the reference for the
` first field, which is reported where it does not convert and has no plan where it does.
. union = if owner then anonymous-union(owner) else function-union()
if union == no-type && !owner
    . message = "Anonymous match case '..${name.text}' needs a stable result owner"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if union == no-type
    decline(id)
    = invalid-type
. foreseer = foreseer-of(union)
if foreseer
    foreseer.foreseen-sites += id
    foreseer.foreseen-payloads += anonymous-payload(args)
    = union
. payload = no-type
. number = U32.max
. place = 0u32
for fact in types.cases-of(union)
    if fact.name && fact.name! == name
        number = place
        if !fact.is-default
            payload = fact.type
    place += 1
. shaped = false
if payload != no-type && payload != invalid-type
    shaped = types.intrinsic-of(payload) == .tuple || types.intrinsic-of(payload) == .struct
. position = 0u32
. typed = true
for arg in tree.children[args]
    . given = facts.node-type(instance, arg)
    if given == no-type
        given = infer(arg)
    typed = typed && given != invalid-type
    if given != invalid-type && payload != no-type
        . expected = if args.count > 1 || shaped then field-of(payload, position) else payload
        if expected == no-type || expected == invalid-type
            decline(id)
            = invalid-type
        . plain = types.intrinsic-of(given) != .closure && types.intrinsic-of(given) != .binding
        if plain && !relation-legal(conversions.compare-held(given, expected))
            frame.diagnose(id, .illegal-cast, null, given, expected)
            = invalid-type
        if args.count == 1 && shaped
            decline(id)
            = invalid-type
        conversions.convert(arg, arg, given, expected, .reason-argument)
    position += 1
if number == U32.max && typed && unheld-cases.find(id) != null
    report-unheld(id, name)
    = invalid-type
if number == U32.max && typed
    . message = "Anonymous case '..${name.text}' was not declared"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if number != U32.max
    . plan = if args.count > 1 then OperatorPlan.plan-case-fields else OperatorPlan.plan-case
    facts.set-constant(instance, id, ConstantFact(number, 0.0, null, false), plan)
= union

────────────────────
_ do infer-declared TypeId
    - left SyntaxId
    - right SyntaxId

. expected = no-type
do match? tree.nodes[left]
    | .node-type-capture(row)
        if row.type != 0
            expected = types.evaluate-type(module, tree, row.type, frame.env)
            if expected == invalid-type && report-missing-type(row.type, frame.env)
                = invalid-type
if expected != no-type && expected != invalid-type && is-async-channel(expected)
    . payload = published-payload(right)
    if payload != no-type
        . provided = "[Interface core/stream:Broadcastable'${type-display(types, payload)}]"
        . message = "Event endpoints provide $provided, not ${type-display(types, expected)}"
        frame.diagnose(left, .stated, program.store-atom(message), payload, expected)
        = invalid-type
. place = right
do match? tree.nodes[left]
    | .node-type-capture(row)
        if row.type != 0
            place = row.type
. arms = tree.arms-value(right)
if expecting && tree.is-arms-syntax(arms) && !may-miss(arms, expected)
    note-returned-match(arms, expected)
    arms-expected = expected
.. expecting = expected != no-type && expected != invalid-type
= infer-with-expected(right, expected, Want().escaping(expected, place))

────────────────────
_ do report-missing-signature
    - signature Signature

` Reports the first type written in the signature of the function being typed that names
` nothing, among its arguments and then its return.
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        . pool = program.modules[module].arg-pool
        for position in 0 .. < fn.args.count
            if position < signature.args.length && signature.args[position] == invalid-type
                . written = pool[fn.args.start + position].type-syntax
                if written != 0 && report-missing-type(written, frame.env)
                    =
        if fn.return-type != 0 && signature.returns == invalid-type
            report-missing-type(fn.return-type, frame.env)

────────────────────
_ do report-missing-type Bool
    - syntax SyntaxId
    - env TypeEnv

` Reports where a type written names nothing, as TypeScript reports it (`missing-type`). Says
` whether one was reported.
. missing = types.missing-type(module, program.modules[module].tree, syntax, env)
=? false if missing == 0
frame.diagnose(missing, .stated, program.store-atom("Type not found"))
= true

────────────────────
_ is-async-channel Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        types.async-channel-decl.refers-to(row.module, row.decl)
    ??
        false

────────────────────
_ do fitting-of TypeId
    - want Want

` The function type a value chosen by a condition is given as, where its context expects one of it
` (`want-fitting`).
= if want.asks(.want-fitting) then expected-function(want.type) else no-type

────────────────────
_ armed-want Want
    - id SyntaxId
    - want Want

` What is asked of the value an arm gives where the match expects a type of its arms
` (`armed-symbol`) and the value is `if condition then value else other`: that its sides are
` joined at that type, unless the block it ends asks that of it already.
if id == arm-typing.symbol && !want.asks(.want-choice) && arming.expected != types.void-type && tree.is-choice-syntax(id) then want.asking(.want-choice, arming.expected) else want

────────────────────
_ do expected-function TypeId
    - expected TypeId

` The function type a value is expected to be, written as it or as an optional of it; no type
` for any other.
. inner = if types.is-optional(expected) then types.optional-inner(expected) else expected
types.complete(inner)
= if function-row(types, inner) != no-type then inner else no-type

────────────────────
_ do construct-declared
    - pattern SyntaxId

do match? tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0
            . declared = types.evaluate-type(module, tree, row.type, frame.env)
            if declared == invalid-type && report-missing-type(row.type, frame.env)
                =
            if declared != invalid-type && types.intrinsic-of(declared) == .interface
                frame.diagnose(row.type, .stated, program.store-atom("Type can't be null"))
                =
            construct-value(row.type, declared)
    | .node-type-tuple(row)
        for field in tree.children[row.field-types]
            construct-declared(field)

────────────────────
_ lazy-known Bool
    - pattern SyntaxId

|? slot
    frame.known(slot) != no-type
??
    false

.. slot = declaring-slot(tree.first-named(pattern))

────────────────────
_ declaring-slot SlotId?
    - pattern SyntaxId

|? resolution.kind == .resolve-slot
    resolution.slot
??
    null

.. identifier = match tree.nodes[pattern]
    | .node-type-capture(row)
        row.id
    ??
        pattern
.. resolution = bindings.resolution-of(frame.binding, identifier)

────────────────────
_ do declare
    - pattern SyntaxId
    - value TypeId
    - value-syntax SyntaxId

if pattern == 0
    =
do match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            plan-tested(row.type)
            check-pattern(pattern, value)
            =
        . declared = value
        if row.type != 0
            . annotation = types.evaluate-type(module, tree, row.type, frame.env)
            if value-syntax != 0 && value != no-type
                note-declared-value(pattern, 0, value-syntax, row.type, annotation, value)
            if bare-generic-annotation(annotation, value)
                annotation = relations.complete-from(annotation, value) ?? value
            declared = annotation
            if never-fits(value, annotation)
                frame.diagnose(pattern, .no-possible-matches)
            else if value != no-type
                calls.note-context-cast(value-syntax, annotation, .cast-pattern)
                . chosen = conversions.convert
                    - row.type
                    - value-syntax
                    - value
                    - annotation
                    - .reason-declaration
                if types.is-optional(annotation) || value != annotation
                    instances.mark-may-panic(instance)
                if !matches-in-place(value, annotation)
                    frame.forget-members()
                if chosen != invalid-type
                    declared = chosen
        . slot = declaring-slot(pattern)
        if slot
            frame.assign(slot, declared)
    | .node-identifier
        . slot = declaring-slot(pattern)
        if slot
            frame.assign(slot, value)
    | .node-type-tuple(row)
        . known = value != no-type && value != invalid-type
        . held = value
        if known && types.is-optional(value)
            held = types.optional-inner(value)
            instances.mark-may-panic(instance)
            facts.record-force(instance, pattern, value, held, false)
        if known && !destructures(held, row.field-types.count)
            frame.diagnose(pattern, .no-possible-matches)
        . position = 0u32
        for field in tree.children[row.field-types]
            . item = if held == no-type then no-type else field-of(held, position)
            declare(field, item, tree.place-syntax(value-syntax, position, row.field-types.count))
            position += 1
    | .node-type-wildcard
        =
    | .node-type-list
        if value != no-type && !pattern-possible(pattern, value)
            frame.diagnose(pattern, .no-possible-matches)
            =
        plan-tested(pattern)
        check-pattern(pattern, value)
    | .node-type-and
        plan-tested(pattern)
        check-pattern(pattern, value)
    | .node-type-property
        if value != no-type && !pattern-possible(pattern, value)
            frame.diagnose(pattern, .no-possible-matches)
            =
        check-pattern(pattern, value)
    ??
        decline(pattern)

────────────────────
_ do note-declared-value
    - pattern SyntaxId
    - property DeclId
    - value SyntaxId
    - annotation SyntaxId
    - declared TypeId
    - found TypeId

` Records a value written with the type it is declared as, for the rules that read how it is
` written (`DeclaredValueFact`).
. fact = DeclaredValueFact(instance, pattern, property, value, annotation, declared, found)
facts.declared-values.append(fact)

────────────────────
_ matches-in-place Bool
    - value TypeId
    - annotation TypeId

` Whether the reference takes a value declared with a type as it is, with no test that panics
` where it fails, which would end what is known of properties: a value of that type, of an equal
` one, or of an alternative of an `or`.
|? value == annotation
    true
??
    kind == .relation-same || kind == .relation-equal || kind == .relation-or-cast

.. kind = conversions.compare-held(value, annotation).kind

────────────────────
_ do plan-tested
    - pattern SyntaxId

` A pattern a declaration is written with that tests what it is given panics where the test
` fails: it is planned as arms that take nothing of what is left. A pattern of items keeps
` its own plan, and panics where it is declared with.
do match? tree.nodes[pattern]
    | .node-type-and
        instances.mark-may-panic(instance)
        facts.set-plan(instance, pattern, .plan-unmatched)
    | .node-type-list
        instances.mark-may-panic(instance)

────────────────────
_ do never-fits Bool
    - value TypeId
    - annotation TypeId

` Whether a value declared under a type can never be of it: the declaration is a pattern, and
` one nothing matches. A binding fits a function type, or an optional of one, where what it
` calls takes the type's arguments and gives its return.
if value == no-type || value == invalid-type || annotation == invalid-type || value == annotation
    = false
. kind = types.intrinsic-of(value)
if kind == .binding
    types.complete(annotation)
    . inner = types.optional-inner(annotation)
    types.complete(inner)
    = function-row(types, inner) != no-type && !conversions.binding-takes(value, inner)
if kind == .closure
    = false
= !relation-legal(conversions.compare-held(value, annotation))

────────────────────
_ do bare-generic-annotation Bool
    - annotation TypeId
    - value TypeId

if annotation == no-type || annotation == invalid-type || value == no-type || value == invalid-type
    = false
types.complete(annotation)
if !types.completions[annotation].has-variables && !has-inference-args(annotation)
    = false
. declared = class-ref(types, annotation)
. given = class-ref(types, value)
if declared.decl == 0 || given.decl == 0
    = false
= declared.module == given.module && declared.decl == given.decl

────────────────────
_ do has-inference-args Bool
    - id TypeId

do match? types.rows[id]
    | .type-class(row)
        for offset in 0 .. < row.args.count
            do match? types.rows[types.child-type(row.args, offset)]
                | .type-inference
                    = true
= false

────────────────────
_ destructures Bool
    - value TypeId
    - count U32

` A table or span gives exactly its fields; any other tuple gives its leading ones.
|? arity == U32.max
    false
|? is-column-receiver(types.intrinsic-of(value))
    count == arity
??
    count <= arity

.. arity = tuple-arity(value)

────────────────────
_ do struct-arity U32
    - value TypeId

` How many fields a named tuple or struct stores. What a getter answers is no field.
. kind = types.intrinsic-of(value)
if kind != .tuple && kind != .struct && kind != .array-builder
    = U32.max
. count U32
for field in types.properties-of(value)
    if field.slot != U32.max
        count += 1
= count

────────────────────
_ do struct-field-of TypeId
    - value TypeId
    - position U32

. properties = types.completions[value].properties
if position >= properties.count
    = invalid-type
. field = types.properties[properties.start + position]
if field.type == no-type
    = demand-member(field, value, field.name)
= field.type

────────────────────
_ slot-known TypeId
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.slot-known(slot)
??
    frame.known(slot)

────────────────────
_ key-declared TypeId
    - key NarrowingKey

` What a local, a property or a path holds before the flow knows more of it: a local its own
` type, and a property or a path the type it had where the flow first came to know something of
` it, or no type where the flow knows nothing of it.
|? !is-member-key(key)
    slot-known(key)
|? frame.is-stable-path(key)
    frame.path-declared-type(key)
??
    if index != null then frame.member-declared[index] else no-type

.. index = frame.narrowed-members.find(key)

────────────────────
_ lazy-pattern SyntaxId
    - slot SlotId

match tree.nodes[row.group]
    | .node-declare(declaration)
        tree.pattern-identifier(declaration.left)
    ??
        row.group

.. row = bindings.slots[slot]

────────────────────
_ do read-slot TypeId
    - slot SlotId
    - site SyntaxId = 0

` A lazy local of a function this one is written in may be evaluated here, by this read: what
` its value may do, this function may do. A lazy local's value is typed where it is first
` read, which `reading.lazy` keeps while it is, the outermost such read; a later read where a
` local the value reads is known otherwise makes it wavering. While the value is typed,
` `lazy-marks` keeps where the narrowings stood as it was entered, so that a read in it of a
` local a test the value made narrowed is noted as one that holds wherever the value is evaluated
` (`note-inside-read`). A later read evaluates nothing where every way to it passed an earlier
` one: for a local kept behind a flag, where the flow knows it has its value (`note-evaluated`),
` as the reference finds a read whose block an earlier one's dominates, and for any other, whose
` reads run in a straight line, always. Such a read neither types the value again nor makes it
` waver (`note-dominated-read`). The value of a local kept behind a flag is typed between
` `mask-tested` and `close-flagged-value`.
if outer && frame.is-captured(slot)
    . found = outer.read-slot(slot)
    if bindings.slots[slot].kind == .slot-lazy && instances.rows[outer!.instance].may-panic
        instances.mark-may-panic(instance)
    if bindings.slots[slot].kind == .slot-lazy
        let-out-lazy(slot, if site != 0 then site else bindings.slots[slot].group)
    = found
if lazy-slots.find(slot) != null
    frame.diagnose(lazy-pattern(slot), .circular-reference)
    = invalid-type
. current = frame.slot-type(slot)
. row = bindings.slots[slot]
. flagged = row.kind == .slot-lazy && site != 0 && bindings.lazy-flagged(slot)
if current != no-type
    if row.kind == .slot-lazy && site != 0 && evaluated-here
        facts.note-dominated-read(instance, site)
        = current
    .. evaluated-here = !bindings.lazy-flagged(slot) || frame.is-evaluated(slot)
    if row.kind == .slot-lazy && row.group != 0 && !settles(slot, row.group)
        facts.note-wavering(instance, slot)
        if bindings.lazy-flagged(slot)
            diagnose-retyped(row.group)
    if row.kind == .slot-lazy && !transforms-agree(slot)
        facts.note-unheld-lazy(instance, slot)
    if row.kind == .slot-lazy && bindings.lazy-flagged(slot)
        recheck-forces(slot)
        if forgetting-lazies.find(slot) != null
            frame.forget-members()
    if flagged
        note-evaluated(slot)
    = current
if row.kind == .slot-lazy && row.group != 0
    . busy = calls.suspend-ranking()
    . leaving = scratch.outgoing.mark
    . around = reading
    if reading.lazy == 0
        reading = reading.lazy = site
    . typed-mark = scratch.narrowings.mark
    if bindings.lazy-flagged(slot)
        mask-tested(row.group)
    lazy-marks += scratch.narrowings.mark
    typing-lazies += slot
    . forgotten = frame.forgotten
    do match? tree.nodes[row.group]
        | .node-declare(declaration)
            note-entered(slot, declaration.right)
            check-declare
                - declaration.left
                - tree.machine-or-value(declaration.left, declaration.right)
                - true
            claim-lazy(slot, row.group, declaration.right)
            if facts.live-statements.length != 0
                settle-live-statement(row.group, declaration.left, declaration.right, no-type)
    if bindings.lazy-flagged(slot) && frame.forgotten != forgotten
        forgetting-lazies += slot
    typing-lazies.pop()
    lazy-marks.pop()
    if bindings.lazy-flagged(slot)
        close-flagged-value(typed-mark)
    if flagged
        note-evaluated(slot)
    reading = around
    calls.resume-ranking(busy)
    if scratch.outgoing.mark != leaving
        raising-lazies += slot
        lazy-transforms += frame.transforms.length
        raising-starts += raising-entries.length
        for entry in scratch.outgoing.since(leaving)
            raising-entries += entry
    = frame.known(slot)
= invalid-type

────────────────────
_ do diagnose-retyped
    - group SyntaxId

` The reference types the value of a lazy local kept behind a flag again at a read that no
` evaluation of it is passed before, under what is known there. A property the value reads from
` a local or a property of the receiver that the flow knew to hold a value where the value was
` typed, and not by a test the value made, but that may hold nothing here, is the reference's
` error there: the property is read from an optional.
. value SyntaxId = 0
do match? tree.nodes[group]
    | .node-declare(declaration)
        value = declaration.right
if value == 0
    =
for id in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[id]
        | .node-get-expression(row)
            if row.is-optional || facts.is-inside-read(instance, row.object) || retyped
                continue
            .. retyped = retyped-reads.find(id) != null
            . recorded = facts.node-type(instance, row.object)
            . here = known-here(row.object)
            if recorded == no-type || recorded == invalid-type || plain-here
                continue
            .. plain-here = here == no-type || !types.is-optional(here)
            if types.is-optional(recorded) || types.optional-inner(here) != recorded
                continue
            retyped-reads += id
            frame.diagnose(id, .property-not-found, row.name, here)

────────────────────
_ do known-here TypeId
    - syntax SyntaxId

` What a read of a local of this frame or of a stored property of the receiver would find
` here, or no type for any other read.
do match? tree.nodes[syntax]
    | .node-identifier(named)
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot && !frame.is-captured(resolution.slot)
            = frame.slot-type(resolution.slot)
        if resolution.kind == .resolve-member
            . key = member-key(resolution.decl)
            if frame.knows-member(key) && !frame.is-doubted(key)
                . held = frame.held-member(key)
                if held != no-type
                    = held
            = member-type(named.name)
= no-type

────────────────────
_ do note-evaluated
    - slot SlotId

` A read of a lazy local kept behind a flag that runs wherever what follows it runs gives the
` local its value there. One in a part of an expression that may not run, where nothing takes
` back what is known after it, or where an error may leave for a catch in this function before
` it ran, gives it nothing that follows.
if skippable-depth == 0 && frame.surround.catch-depth == 0
    frame.note-evaluated(slot)

────────────────────
_ do mask-tested
    - group SyntaxId

` Each local of this frame that the value of a lazy local kept behind a flag tests, which the
` flow knows more of than its type, is known as its type while the value is typed. The reference
` evaluates such a value at the first of its reads and types it again at each read that is not
` passed only after another, under what is known there; a value typed with what it tests as its
` type holds at each, whatever each knows of it.
. value SyntaxId = 0
do match? tree.nodes[group]
    | .node-declare(declaration)
        value = declaration.right
if value == 0
    =
. tested [SyntaxId]
for id in tree.subtree-start(value) .. < value + 1
    note-tested(id, tested)
for subject in tested
    if !(tree.nodes[subject] is .node-identifier)
        continue
    . resolution = bindings.resolution-of(frame.binding, subject)
    if resolution.kind != .resolve-slot || frame.is-captured(resolution.slot) || unnarrowed
        continue
    .. unnarrowed = !frame.is-narrowed(resolution.slot)
    frame.push-narrowing(slot-key(resolution.slot), frame.known(resolution.slot))

────────────────────
_ do note-tested
    - id SyntaxId
    - into [SyntaxId]

` The operands a condition at a node tests of what they hold: the sides of `&&` and `||`, the
` condition of `if`, what `!`, `?` and `is` test, and what is compared with `null`.
do match? tree.nodes[id]
    | .node-binary-expression(row)
        if row.op == .and-op || row.op == .or-op
            into += row.lhs
            into += row.rhs
        else if row.op == .if-op
            into += row.rhs
        else if (row.op == .equals-op || row.op == .not-equals-op) && narrowing.is-null-syntax(row.rhs)
            into += row.lhs
        else if (row.op == .equals-op || row.op == .not-equals-op) && narrowing.is-null-syntax(row.lhs)
            into += row.rhs
        else if is-type-test(row.op)
            into += row.lhs
    | .node-unary-expression(row)
        if row.op == .not-op
            into += row.operand
    | .node-type-predicate(row)
        into += row.expr
    | .node-if-block(row)
        if row.condition != 0
            into += row.condition

────────────────────
_ do close-flagged-value
    - mark ScratchMark

` What the value of a lazy local kept behind a flag, or `mask-tested` before it, left known holds
` only within it, since a read that comes after it may find the flag set and evaluate nothing.
` What an assignment in it settled is known after it.
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
for row in settled
    frame.push-assigned(row.key, row.type, row.cases)

────────────────────
_ do recheck-forces
    - slot SlotId

` The reference evaluates the value of a lazy local it keeps behind a flag again at each read,
` under what is known there, where this pass types it at the first: a force in the value that
` the flow narrowed before the value was entered is narrowed only where every read still knows
` what the force reads to hold a value, and a read that does not ends what is known of
` properties, as the reference's panic there makes calls. What the value itself tests it tests
` at each read.
for position in 0 .. < forcing-lazies.length
    if forcing-lazies[position] == slot
        . index = forcing-facts[position]
        if !known-present(tree.force-operand(facts.forces[index].syntax))
            facts.forces[index].operand = forcing-declared[position]
            facts.forces[index].is-narrowed = false
            frame.forget-members()

────────────────────
_ do known-present Bool
    - syntax SyntaxId

` Whether the flow knows here that a local, a property of the receiver or a path from one of
` those holds a value, as a read of it here would find.
do match? tree.nodes[syntax]
    | .node-type-predicate(row)
        = known-present(row.expr)
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot
            . known = frame.slot-type(resolution.slot)
            = known != no-type && known != invalid-type && !types.is-optional(known)
        if resolution.kind == .resolve-member
            = member-holds(member-key(resolution.decl))
    | .node-get-expression(row)
        if row.is-optional
            = false
        . key = narrowing.receiver-member(row.object, row.name)
        . base = narrowing.base-key(row.object)
        if !key && base
            key = frame.find-path-key(base, row.name)
        = key != null && member-holds(key)
= false

────────────────────
_ member-holds Bool
    - key NarrowingKey

` Whether the flow knows here that a property or a path holds a value, a read of it that is
` counted (`member-reads`).
|? !frame.knows-member(key) || frame.is-doubted(key)
    false
??
    held != no-type && held != invalid-type && !types.is-optional(held)

.. held = frame.narrowed-member(key)

────────────────────
_ do lazy-leaving Bool
    - slot SlotId
    - into [Outgoing]

` The errors the value of a lazy local lets out where its first read typed it, added to `into`
` by the function that declares it. False where transformers were declared there, which may
` take them.
for position in 0 .. < raising-lazies.length
    if raising-lazies[position] == slot
        if lazy-transforms[position] != 0
            = false
        . start = raising-starts[position]
        . end = raising-entries.length
        if position + 1 < raising-starts.length
            end = raising-starts[position + 1]
        for index in start .. < end
            into += raising-entries[index]
        = true
if outer && frame.is-captured(slot)
    = outer.lazy-leaving(slot, into)
= true

────────────────────
_ do let-out-lazy
    - slot SlotId
    - site SyntaxId

` A lazy local of a function this one is written in that this read evaluates lets its errors
` out of this function too, where its writer calls it in place, as they leave TypeScript's
` inline loop; the writer lets them out with the call. Those of a function called elsewhere,
` or that meet transformers declared on either side, stay in the writer, and an error that
` would leave here has no shape where emitted.
if !in-place || frame.transforms.length != 0
    =
. leaving [Outgoing]
if !outer!.lazy-leaving(slot, leaving)
    =
for entry in leaving
    scratch.outgoing.push(Outgoing(entry.type, site, entry.callee, U32.max, 0))

────────────────────
_ do transforms-agree Bool
    - slot SlotId

` Whether a lazy local whose value lets errors out is read again where the transformers
` declared are those declared where its first read typed it. TypeScript evaluates the value
` at each read, so an error leaving it is transformed by those declared there.
for position in 0 .. < raising-lazies.length
    if raising-lazies[position] == slot
        = lazy-transforms[position] == frame.transforms.length
= true

────────────────────
_ do hold-transforms
    - error TypeId
    - site SyntaxId

` TypeScript evaluates the exception of a transformer again where each error it takes
` leaves, with the names and the flow there, where the type pass typed it once where it is
` declared. A transformer that may take an error leaving here, an error not yet known taken
` by any, whose exception does not hold here, is marked, and emission refuses it.
for transform in frame.transforms
    if error != no-type && caught-rank(relations, error, transform.source) == null
        continue
    . row = facts.transforms[transform.fact]
    if !exception-holds(row.site, row.exception, site)
        facts.note-unheld-transform(transform.fact)

────────────────────
_ do exception-holds Bool
    - declared SyntaxId
    - exception SyntaxId
    - site SyntaxId

` Whether a transformer's exception, typed at the raise that declares it, means here what it
` meant there: each name it reads names nothing declared since that a scope here holds, a
` local it reads is in a scope here and known as it was there, and a property it reads by its
` name is known as it was there. The names the catchers bind are its own.
. first = tree.subtree-start(declared)
for id in tree.subtree-start(exception) .. < exception + 1
    do match? tree.nodes[id]
        | .node-identifier(name)
            . resolution = bindings.resolution-of(frame.binding, id)
            . recorded = facts.node-type(instance, id)
            if shadowed(name.name, declared, site)
                = false
            if resolution.kind == .resolve-slot
                . row = bindings.slots[resolution.slot]
                . own = row.syntax >= first && row.syntax <= declared
                if !own && !holds-scope(row.scope, site)
                    = false
                if !own && recorded != no-type && recorded != frame.slot-type(resolution.slot)
                    = false
            if member-recorded && recorded != member-type(name.name)
                = false
            .. member-recorded = resolution.kind == .resolve-member && recorded != no-type
= true

────────────────────
_ do shadowed Bool
    - name Atom
    - declared SyntaxId
    - site SyntaxId

` Whether a local of the function named so is declared after a node and before a site, in a
` scope that holds the site.
. bound = bindings.bindings[frame.binding]
for slot in bound.slots.start .. < bound.slots.start + bound.slots.count
    . row = bindings.slots[slot]
    if row.name == name && between && holds-scope(row.scope, site)
        = true
    .. between = row.syntax > declared && row.syntax < site
= false

────────────────────
_ holds-scope Bool
    - scope ScopeId
    - site SyntaxId

` Whether a site lies in a scope: a function's own holds all of it.
|? row.kind == .scope-function || row.kind == .scope-nested
    true
??
    site >= tree.subtree-start(row.syntax) && site <= row.syntax

.. row = bindings.scopes[scope]

────────────────────
_ do settles Bool
    - slot SlotId
    - group SyntaxId

` Whether the value of a lazy local, typed where it was first read, holds where it is read
` again: each local it reads, and each property it reads by its name, is known here as it was
` there, or read there as its type. A local the value itself learns more of, by a test it makes, is known there as the
` value left it; it holds here where the local is known as it was when the value was
` entered, which `note-entered` kept. One not known yet then, a lazy local the value is the
` first to read or one it declares, the value knows first as its type. A local the value read
` as its type holds anywhere.
do match? tree.nodes[group]
    | .node-declare(declaration)
        . value = declaration.right
        for id in tree.subtree-start(value) .. < value + 1
            do match? tree.nodes[id]
                | .node-identifier(name)
                    . recorded = facts.node-type(instance, id)
                    . resolution = bindings.resolution-of(frame.binding, id)
                    if recorded == no-type
                        continue
                    if resolution.kind == .resolve-slot
                        . known = frame.slot-type(resolution.slot)
                        . entered = entered-type(slot, resolution.slot)
                        . prior = if entered != no-type then entered else frame-known
                            .. frame-known = frame.known(resolution.slot)
                        if recorded != known && prior != known && stale-record
                            = false
                        .. stale-record = recorded != frame.known(resolution.slot)
                    if member-read && recorded != member-type(name.name) && moved-here
                        = false
                    .. member-read = resolution.kind == .resolve-member
                    .. moved-here = recorded != known-here(id)
= true

────────────────────
_ do note-entered
    - slot SlotId
    - value SyntaxId

` Keeps, where the value of a lazy local is first typed, what each local it reads is known as
` before it, for `settles`.
entered-lazies += slot
entered-starts += entered-slots.length
for id in tree.subtree-start(value) .. < value + 1
    if !(tree.nodes[id] is .node-identifier)
        continue
    . resolution = bindings.resolution-of(frame.binding, id)
    if resolution.kind != .resolve-slot
        continue
    . known = frame.slot-type(resolution.slot)
    if known != no-type
        entered-slots += resolution.slot
        entered-types += known

────────────────────
_ do entered-type TypeId
    - slot SlotId
    - read SlotId

` What a local a lazy local's value reads was known as when the value was first typed, or
` none where it was not known yet.
. position = entered-lazies.find(slot)
if !position
    = no-type
. end = if position + 1 < entered-lazies.length then entered-starts[position + 1] else slots-end
    .. slots-end = entered-slots.length
for index in entered-starts[position] .. < end
    if entered-slots[index] == read
        = entered-types[index]
= no-type

────────────────────
_ do member-type TypeId
    - name Atom

. found = property-named(frame.self-type, name) if frame.self-type != no-type
= if found then member-type(types.properties[found], frame.self-type) else no-type

────────────────────
_ do wavers Bool
    - slot SlotId

` Whether a local is read as more than its type where that may not hold: by its own
` function after a nested function that captures it was typed, or by a nested function at
` all, when something assigns it. In a loop the call that types the nested function may be
` written after the read and run before it, so there a local a nested function captures
` wavers wherever something assigns it. The body of a `do without gc` block runs where it is
` written, so a local it reads wavers only as the read would in the function around it.
if outer && frame.is-captured(slot) && in-zone-body
    = outer.wavers(slot)
if outer && frame.is-captured(slot)
    = outer.holds-narrowed(slot)
if frame.wavers(slot)
    = true
. shared = SlotFlag.slot-captured /or/ SlotFlag.slot-assigned
= loop-marks.length != 0 && shared-flags && frame.is-narrowed(slot) && closes-over(slot)
    .. shared-flags = (bindings.slots[slot].flags /and/ shared) == shared

────────────────────
_ do closes-over Bool
    - slot SlotId

` Whether a nested function of the binding captures a local, other than the body of a
` `do without gc` block, which runs where it is written.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if is-region-body(nested.decl)
        continue
    for index in 0 .. < nested.captures.count
        if bindings.captures[nested.captures.start + index].slot == slot
            = true
= false

────────────────────
_ holds-narrowed Bool
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.holds-narrowed(slot)
??
    (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 && frame.is-narrowed(slot)

────────────────────
_ holds-tested Bool
    - slot SlotId

` Whether a local something assigns is held where the type pass stands as what a test found
` of it. The reference gives a nested function written there a copy of what the test found,
` so what the function assigns does not reach the local. What an assignment left a local as
` is no copy, there or here.
|? outer && frame.is-captured(slot)
    outer.holds-tested(slot)
??
    (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0 && frame.is-tested(slot)

────────────────────
_ do share-captures
    - nested-decl DeclId

` A nested function written in this one is typed for the first time. Each local it
` captures that something assigns is shared from here, in the frame that declares it.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.decl != nested-decl
        continue
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0
            share(slot)

────────────────────
_ do share
    - slot SlotId

if outer && frame.is-captured(slot)
    outer.share(slot)
else
    frame.share(slot)

────────────────────
_ precedes-declaration Bool
    - slot SlotId

` A closure body is checked where the closure is first called, and a local that an enclosing
` function declares after that call does not exist yet.
|? !outer || !frame.is-captured(slot)
    false
??
    outer.awaits-declaration(slot)

────────────────────
_ awaits-declaration Bool
    - slot SlotId

|? outer && frame.is-captured(slot)
    outer.awaits-declaration(slot)
??
    bindings.slots[slot].kind == .slot-local && frame.known(slot) == no-type

────────────────────
_ do is-close-method Bool
    - declaration CheckedDecl

if frame.self-type == no-type || frame.self-type == invalid-type
    = false
if types.intrinsic-of(frame.self-type) != .class
    = false
. owner-module = program.modules[module]
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . atom = fn.name
            = atom.text == "close"
= false

────────────────────
_ do has-events Bool
    - type TypeId

` Whether a class declares an event or inherits one, in its body or in a facet.
. cursor = type
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    =? true if has-event-member(target, class.members)
            =? true if facets-have-events(row.module, row.decl)
    cursor = types.base-of(cursor) ?? no-type
= false

────────────────────
_ do has-event-member Bool
    - target Module
    - members RowRange'DeclId

` Whether a class's or a facet's members hold an event.
for member in target.member-pool[members]
    =? true if target.decls[member] is .decl-event
= false

────────────────────
_ do facets-have-events Bool
    - class-module ModuleId
    - class-decl DeclId

` Whether a facet of a class declares an event.
. facets = program.facets
=? false if facets.count == 0
. (start, end) = facets.class-range(class-module, class-decl)
for position in start .. < end
    . facet = facets.class-facets[position]
    . home = program.modules[facets.modules[facet]]
    do match? home.decls[facets.decls[facet]]
        | .decl-extension(row)
            =? true if facets.states[facet] == .facet-bound && has-event-member(home, row.members)
= false

────────────────────
_ do demand-event-close

` The event runtime's `event-close-owner`, which the `close` of a class with events calls as it
` leaves, so that what subscribes to the object's events no longer hears them.
if facts.event-close != no-instance
    =
. mark = scratch.types.mark
scratch.types.push(pointer-to(types.type-row(.uint8)))
facts.event-close = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-close-owner")
    - mark
scratch.types.rewind(mark)

────────────────────
_ do is-generator-end Bool
    - declaration CheckedDecl

` A generator's `end-iterating` closes the generator in the reference, which can panic.
if frame.self-type == no-type || frame.self-type == invalid-type
    = false
if !same-decl(class-ref(types, frame.self-type), types.generator-decl)
    = false
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . atom = fn.name
            = atom.text == "end-iterating"
= false

────────────────────
_ do note-explicit-return
    - id SyntaxId
    - expr SyntaxId

` Where an explicit return may be written. A cleanup and the body of `main` or of a loop on a
` stream have none, a task's body and a state machine's handler return no value, and a
` function that is not imperative states it needs `do`. In the body of a rule of a class one
` with no value leaves the body, and one with a value is reported, as a rule gives none.
if finally.cleaning-up
    frame.diagnose(id, .stated, program.store-atom("Illegal deferred statement"))
    =
if handling != 0 && expr != 0
    . text = "A state machine's handler gives no value, so it cannot return one with \"=\"; end it early with \"= alone\""
    frame.diagnose(id, .stated, program.store-atom(text))
    =
if is-rule-unit()
    if expr != 0
        . text = "A rule gives no value, so its body cannot return one with \"=\"; end it early with \"= alone\""
        frame.diagnose(id, .stated, program.store-atom(text))
    =
if is-subscriber-body()
    frame.diagnose(id, .stated, program.store-atom("Illegal return from subscriber"))
    =
if frame.declaration.kind == .task-decl && expr != 0
    . brix = tree.source-path.ends-with(".bx")
    . returning = if brix then "(return …)" else "="
    . ending = if brix then "(return)" else "= alone"
    . text = "A task gives no value, so its body cannot return one with \"$returning\"; end it with \"$ending\", or send the value on a channel"
    frame.diagnose(id, .stated, program.store-atom(text))
    =
if frame.declaration.is-main
    frame.diagnose(id, .stated, program.store-atom("Illegal return"))
    =
if frame.declaration.is-imperative || checks-at-declaration(frame.declaration)
    =
frame.diagnose(id, .explicit-return-requires-do)

────────────────────
_ do note-returned-match
    - expr SyntaxId
    - declared TypeId

` A match that is returned is the value of the declared return type, and so are its arms,
` and so is a stream pattern its body runs beside the lazy locals declared for it.
facts.set-node-type(instance, expr, declared)
do match? tree.nodes[expr]
    | .node-match-expression(row)
        facts.set-node-type(instance, row.body, declared)
        . streamed = tree.stream-statement(row.body)
        if streamed != 0 && streamed != row.body
            facts.set-node-type(instance, streamed, declared)

────────────────────
_ do may-miss Bool
    - expr SyntaxId
    - declared TypeId

` Whether a returned match runs a stream pattern no arm of which need pass, in a function
` that returns no optional. The reference types such a match as it does one that is not
` returned, an optional of what its arms give, and the return converts it as any optional,
` at the match and not at its arms.
if declared == no-type || declared == types.void-type || types.is-optional(declared)
    = false
do match? tree.nodes[expr]
    | .node-match-expression(row)
        do match? tree.nodes[tree.stream-statement(row.body)]
            | .node-stream-match(stream)
                = !always-passes(stream.pattern)
= false

────────────────────
_ do require-do
    - id SyntaxId
    - message String

` A function that is not `do` is one expression: it has no immediate declarations, loops or
` yields outside a `do` block. Generated closures run their own statements and are exempt, and
` one the module declares is checked as it is declared (`check-return-mode`).
if do-depth != 0 || frame.declaration.is-imperative || frame.declaration.is-main
    =
if frame.declaration.kind != .function-decl && frame.declaration.kind != .closure-decl
    =
if checks-at-declaration(frame.declaration)
    =
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do check-return
    - statement SyntaxId
    - expr SyntaxId
    - is-conditional Bool

if expr == 0
    if is-conditional
        giving = giving.defaulted = true
        if default-site == 0
            default-site = statement
    else
        giving = giving.empty = true
    =
. declared = declared-return
. missing = may-miss(expr, declared)
. matched = declared != no-type && declared != types.void-type && tree.is-match-syntax(expr) && !missing
if matched
    note-returned-match(expr, declared)
    arms-expected = declared
. value = if declared == no-type then returned-symbol(expr) else no-type
if value == no-type
    expect-bullets(expr, declared)
    value = infer-with-expected(expr, declared, Want().escaping(declared, expr))
if !is-conditional
    value = returned-value(statement, value)
. noted = value
. whole = is-conditional && value != no-type && value != invalid-type && types.is-optional(value)
if whole
    noted = types.optional-inner(value)
do match? tree.nodes[expr]
    | .node-optional-chain
        if value != no-type && value != invalid-type && types.is-optional(value)
            noted = types.optional-inner(value)
` A conditional return of `null` from a function that returns an optional gives the null of the
` return type itself: nothing converts.
. returns-optional = declared != no-type && types.is-optional(declared)
. gives-null = is-conditional && narrowing.is-null-syntax(expr) && returns-optional
` A conditional return of an optional returns the optional itself: what it holds only counts
` toward the type the returns unify to.
if declared != no-type && declared != types.void-type && !gives-null
    calls.note-context-cast(expr, declared, .cast-return)
    . located = !tree.is-string-syntax(expr) || types.is-optional(declared)
    conversions.convert
        - if missing then expr else tree.return-site(expr)
        - expr
        - if whole then value else noted
        - declared
        - .reason-return
        - located
else if whole
    whole-returns += statement
    giving = giving.whole = true
frame.note-return(noted, statement)

────────────────────
_ do refuse-default
    - statement SyntaxId

` A return written with only its condition gives nothing, false or an optional that holds
` nothing: a function declared to return anything else has none of those to give. A
` constructor's leaves it with the object it has made, and a function that yields ends what
` it makes there, so the first such return is refused once the body is typed.
if frame.declaration.kind == .constructor-decl
    =
. declared = declared-return
if declared == no-type || declared == invalid-type || plain-return
    =
.. plain-return = declared == types.void-type || declared == types.bool-type
if types.is-optional(declared)
    =
. message = "Condition-only early return cannot return from ${type-display(types, declared)}; use an optional, Bool, or Void return type"
frame.diagnose(statement, .stated, program.store-atom(message), declared)

────────────────────
_ do returned-value TypeId
    - statement SyntaxId
    - value TypeId

` What a return gives of a value that may be an error: the value alone. Each error leaves the
` function at the return, in the place of its value.
if value == no-type || value == invalid-type
    = value
do match? types.rows[value]
    | .type-result(row)
        for offset in 0 .. < row.errors.count
            note-outgoing(types.child-type(row.errors, offset), statement)
        facts.set-plan(instance, statement, .plan-fused)
        = row.value
= value

────────────────────
_ do convert-returns
    - unified TypeId
    - final TypeId

` Converts what each return gives to the type the returns unify to, and then to the optional
` of it where the function may also return nothing. A conditional return of an optional gives
` the optional itself, which converts to the type the function returns in one step.
. wraps = final != unified && final != no-type && final != invalid-type && types.is-optional(final)
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . skipped = site.type == no-type || site.type == invalid-type || site.type == types.null-type
    if skipped
        continue
    if whole-returns.find(site.syntax) != null
        . given = types.optional-of(site.type)
        . target = if wraps then final else unified
        if given != target
            conversions.convert(site.syntax, site.syntax, given, target, .reason-return)
        continue
    if site.type != unified
        conversions.convert(site.syntax, site.syntax, site.type, unified, .reason-return)
    if wraps
        conversions.convert(site.syntax, site.syntax, unified, final, .reason-return)

────────────────────
_ do returned-symbol TypeId
    - expr SyntaxId

. symbol = tree.symbol-of(expr)
if !symbol
    = no-type
for position in frame.returns-start .. < types.scratch.returns.length
    . noted = types.scratch.returns[position].type
    if noted != no-type && noted != invalid-type && enum-case-decl(types, program, noted, symbol)
        note-enum-case(noted, symbol, expr)
        facts.set-node-type(instance, expr, noted)
        = noted
= no-type

────────────────────
_ do settle-symbol-returns

. symbolic = false
. candidates [TypeId]
. counts [U32]
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if tree.symbol-of(tree.returned-expr(site.syntax))
        symbolic = true
    if site.type == no-type || site.type == invalid-type || valueless
        continue
    .. valueless = site.type == types.null-type || site.type == types.void-type
    . found = U32.max
    for index in 0 .. < candidates.length
        if candidates[index] == site.type
            found = index as U32
    if found == U32.max
        candidates += site.type
        counts += 1
    else
        counts[found] += 1
if !symbolic || candidates.length < 2
    =
for index in 1 .. < candidates.length
    . place = index
    while place > 0 && counts[place - 1] < counts[place]
        . held = candidates[place]
        candidates[place] = candidates[place - 1]
        candidates[place - 1] = held
        . tally = counts[place]
        counts[place] = counts[place - 1]
        counts[place - 1] = tally
        place -= 1
for candidate in candidates
    if symbol-returns-fit(candidate)
        retype-symbol-returns(candidate)
        =

────────────────────
_ do settle-literal-returns TypeId
    - value TypeId

` Gives an integer a function returns written with no suffix the type of the first other value it
` returns, as an integer beside that value takes, so `= 0` beside `= count` returns the type of
` `count`, or where each is written with none, that of the first float, so `= 1` beside `= 2.5`
` returns a float. Returns what the value the body ends with now has.
. tail = if !frame.declaration.is-imperative && value != no-type then value-syntax else 0
. peer = no-type
. float = no-type
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . expr = tree.returned-expr(site.syntax)
    if peer == no-type && returns-peer(site.type) && conversions.literal-of(expr) == 0
        peer = site.type
    if float == no-type && returns-peer(site.type) && float-literal
        float = site.type
    .. float-literal = conversions.literal-of(expr) != 0 && tree.nodes[expr] is .node-float-syntax
if peer == no-type && tail != 0 && returns-peer(value) && conversions.literal-of(tail) == 0
    peer = value
if float == no-type && tail != 0 && returns-peer(value) && float-tail
    float = value
.. float-tail = conversions.literal-of(tail) != 0 && tree.nodes[tail] is .node-float-syntax
if peer == no-type
    peer = float
=? value if peer == no-type
for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    . expr = tree.returned-expr(site.syntax)
    if site.type != peer && returns-peer(site.type) && conversions.literal-of(expr) != 0
        scratch.returns[position] = TypedSite
            - conversions.adapted-literal(expr, site.type, peer)
            - site.syntax
= if literal-tail then conversions.adapted-literal(tail, value, peer) else value
    .. literal-tail = tail != 0 && conversions.literal-of(tail) != 0

────────────────────
_ returns-peer Bool
    - type TypeId

type != no-type && type != invalid-type && type != types.null-type && type != types.void-type

────────────────────
_ do symbol-returns-fit Bool
    - candidate TypeId

for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if no-value || site.type == types.void-type || site.type == candidate
        continue
    .. no-value = site.type == no-type || site.type == invalid-type || site.type == types.null-type
    . symbol = tree.symbol-of(tree.returned-expr(site.syntax))
    if symbol && enum-case-decl(types, program, candidate, symbol)
        continue
    if !relation-legal(relations.compare(site.type, candidate))
        = false
= true

────────────────────
_ do retype-symbol-returns
    - candidate TypeId

for position in frame.returns-start .. < scratch.returns.length
    . site = scratch.returns[position]
    if site.type == candidate || site.type == no-type || site.type == invalid-type
        continue
    . expr = tree.returned-expr(site.syntax)
    . symbol = tree.symbol-of(expr)
    if symbol && enum-case-decl(types, program, candidate, symbol)
        note-enum-case(candidate, symbol, expr)
        facts.replace-node-type(instance, expr, candidate)
        scratch.returns[position] = TypedSite(candidate, site.syntax)

────────────────────
_ do yielded-value TypeId
    - id SyntaxId
    - expr SyntaxId

` `<=?` yields only a present value, so the optional it reads unwraps; the reference types the
` statement as the optional it tests.
. value = infer(expr)
do match? tree.nodes[expr]
    | .node-optional-chain
        if types.is-optional(value)
            facts.set-node-type(instance, id, value)
            = types.optional-inner(value)
= value

────────────────────
_ do note-yield
    - value TypeId
    - site SyntaxId = 0
    - looped Bool = false
    - literal SyntaxId = 0

` Notes a yield and what it gives. One a statement writes is kept with where it is
` written, to be converted to the type of the function's items once that is known. The
` items have the type the yields unify to in the order they are written, as the reference
` folds them: each with the type the relation before it converted to, so that of two
` tuples or two lists neither of which is the wider, the first stays. Nothing is unified
` where the function declares its items. The reference folds in the order of its blocks,
` which is the order written only outside loops: a fold that gives another type the other
` way round is noted, with whether any yield is in a loop (F12b-30). The yields of a list of
` bullets are kept until the list is typed, and folded in the order of its blocks, which
` visit each branch's failing successor first: a bullet that tests before it yields, a `**`
` by its loop and a `*?` by its test, yields after everything the bullets after it yield. A
` yield written as a number with no suffix, as such numbers or as a range of such integers, is
` kept with what it writes, which takes the type of the others as the items of a list do.
giving = giving.yields = true
if loop-depth != 0 || looped
    loops-yields = true
if value == invalid-type || value == no-type
    =
if site != 0
    frame.note-yielded(value, site)
    yield-literals += literal
if orders-yields
    ordered-yields += value
    ordered-sites += site
    ordered-literals += literal
    =
fold-yield(value, site, false, literal)

────────────────────
_ do fold-yield
    - value TypeId
    - site SyntaxId
    - ordered Bool
    - literal SyntaxId

` Folds a yield into what the yields so far unify to. One written as a number with no suffix
` that the others hold is of their type, and where each so far is written so, they are of the
` type of one they all fit, or of tuples such numbers write, the tuple they join to place by place.
if giving.yielded == no-type
    giving = giving.yielded = value
    folded-yield = value
    folded-literal = literal != 0
    =
if states-items()
    =
. relation = relations.unify(folded-yield, value)
if !relation-legal(relation) && literal != 0 && yield-fits(literal, folded-yield)
    =
if !relation-legal(relation) && folded-literal && literals-fit(value)
    folded-yield = value
    giving = giving.yielded = value
    folded-literal = literal != 0
    =
if !relation-legal(relation) && folded-literal && literal != 0
    . joined = relations.joined-places(folded-yield, value)
    if joined != no-type && literals-fit(joined)
        folded-yield = joined
        giving = giving.yielded = joined
        =
if literal == 0
    folded-literal = false
if relation-legal(relation)
    if folded-yield != value && !ordered
        . back = relations.unify(value, folded-yield)
        if !relation-legal(back) || back.unified != relation.unified
            splits-yields = true
    folded-yield = relation.to
    giving = giving.yielded = relation.unified
else if site != 0 && frame.yields-start < scratch.yields.length
    . first = scratch.yields[frame.yields-start].syntax
    do match? tree.nodes[first]
        | .node-yield(row)
            first = row.expr
    frame.diagnose(first, .stated, program.store-atom("Unable to unify generator yield types"))

────────────────────
_ do literals-fit Bool
    - target TypeId

` Whether each yield noted that is written as a number with no suffix is one a type holds.
= all(yield-literals) • where each == 0 || yield-fits(each, target)

────────────────────
_ do yield-fits Bool
    - literal SyntaxId
    - target TypeId

` Whether a yield written as a number with no suffix, as such numbers, or as a range of such
` integers is one a type holds.
do match? tree.nodes[literal]
    | .node-range-expression(row)
        = row.increment == 0 && conversions.fitting-literal(row.left, target) && right-fits
            .. right-fits = conversions.fitting-literal(row.right, target)
= conversions.fitting-literal(literal, target)

────────────────────
_ written-literal SyntaxId
    - syntax SyntaxId

` What a yield writes where it is a number with no suffix, such numbers, or a range of such
` integers, or none.
|? conversions.literal-of(syntax) != 0
    syntax
??
    match tree.nodes[syntax]
        | .node-range-expression(row)
            if row.increment == 0 && plain-left && plain-right then syntax else 0

            .. plain-left = conversions.is-plain-integer(row.left)
            .. plain-right = conversions.is-plain-integer(row.right)
        ??
            0

────────────────────
_ states-items Bool

` Whether the function declares what its yields give, as a generator, a stream, an iterable
` or an indexable of it.
|? declared == no-type || declared == invalid-type
    false
|? same-decl(ref, types.generator-decl) || same-decl(ref, types.stream-decl)
    true
??
    same-decl(ref, types.iterable-decl) || same-decl(ref, types.indexable-decl)

.. declared = declared-return
.. ref = class-ref(types, declared)

────────────────────
_ is-range-type Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        row.module == types.range-decl.module && row.decl == types.range-decl.decl
    ??
        false

────────────────────
_ is-array-type Bool
    - type TypeId

match types.rows[type]
    | .type-class(row)
        row.module == types.array-decl.module && row.decl == types.array-decl.decl
    ??
        false

────────────────────
_ do check-if
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId

if condition == 0
    check-statement(body)
    check-statement(next)
    =
tested-match = tree.tested(condition)
note-truthiness(condition, condition, infer(condition))
tested-match = 0
. assigned-mark = frame.assigned-syntax.length
. body-mark = scratch.narrowings.mark
. dead = never-holds(condition, true)
. known = frame.save-members()
if dead
    facts.set-plan(instance, id, .plan-never)
else
    narrowing.narrow-condition(condition, true)
    check-statement(body)
. split = frame.assigned-syntax.length
. body-settled = frame.assigned-since(body-mark)
frame.pop-narrowing(body-mark)
. next-mark = scratch.narrowings.mark
. body-known = frame.save-members()
frame.restore-members(known)
narrowing.narrow-condition(condition, false)
check-statement(next)
. body-exits = !dead && narrowing.exits(body)
. next-exits = next != 0 && narrowing.exits(next)
if next-exits && !body-exits
    frame.restore-members(body-known)
else if !body-exits
    frame.merge-members(body-known)
if body-exits && !next-exits
    frame.forget-assignments(assigned-mark)
    =
. next-settled = frame.assigned-since(next-mark)
frame.pop-narrowing(next-mark)
if next-exits && !body-exits
    narrowing.narrow-condition(condition, true)
    frame.keep-assigned(body-settled)
else if next == 0 && !body-exits
    merge-assignments(condition, body, body-settled)
    widen-settled(body-settled)
else if !next-exits && !body-exits && !dead
    join-branches(condition, body, next, assigned-mark, split)
    widen-settled(body-settled)
    widen-settled(next-settled)
else if dead && !next-exits
    frame.keep-assigned(next-settled)
frame.forget-assignments(assigned-mark)

────────────────────
_ settled-now TypeId
    - key NarrowingKey

` What a key is known as where the type pass stands: the type of a local, or what a member
` or a path is narrowed to, which is no type for one that is not narrowed.
if is-member-key(key) then frame.held-member(key) else frame.slot-type(key)

────────────────────
_ do widen-settled
    - settled [Narrowed]

` After a region that may not have run, a key that an assignment in it left other than it is
` known now is known no longer: a local is what its declaration says, and a member or a path
` is not narrowed. What the paths through the region agree on is made known before this.
for row in settled
    . held = row.type
    . plain = no-type
    if !is-member-key(row.key)
        plain = slot-known(row.key)
        if held == no-type
            held = plain
    if held != settled-now(row.key)
        frame.push-assigned(row.key, plain)

────────────────────
_ do pop-conditional
    - mark ScratchMark

` Ends a region that runs under a condition, which is no statement of its own: what an
` assignment in it settled is known no longer where it differs from what was known before.
. settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
widen-settled(settled)

────────────────────
_ do join-branches
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId
    - mark Size
    - split Size

` After an `if` with an `else`, a local both branches leave as one type is that type: the
` branch that assigns it leaves what it assigned, and the other what the condition tells of it.
. other = next
do match? tree.nodes[next]
    | .node-if-block(row)
        if row.condition == 0
            other = row.body
. end = frame.assigned-syntax.length
. slots [SlotId]
for position in mark .. < end
    if slots.find(frame.assigned-slots[position]) == null
        slots += frame.assigned-slots[position]
for slot in slots
    . left = branch-end(slot, condition, true, body, mark, split)
    . right = branch-end(slot, condition, false, other, split, end)
    if left != no-type && left == right && left != frame.slot-type(slot)
        frame.push-assigned(slot-key(slot), left)

────────────────────
_ do branch-end TypeId
    - slot SlotId
    - condition SyntaxId
    - truth Bool
    - branch SyntaxId
    - from Size
    - to Size

` What a local is where a branch ends: what the branch's own statements last assigned it, or
` what the condition tells of it when nothing under the branch assigns it. No type when an
` assignment nested in the branch may or may not have run.
. last = no-type
. direct = 0
for position in from .. < to
    . written = frame.assigned-syntax[position]
    if frame.assigned-slots[position] == slot && tree.is-direct-statement(branch, written)
        last = frame.assigned-types[position]
        direct += 1
. written = 0
for id in tree.subtree-start(branch) .. branch
    do match? tree.nodes[id]
        | .node-assign(row)
            . target = narrowing.condition-slot(row.lhs)
            if target && target == slot
                written += 1
if written != direct
    = no-type
if direct != 0
    = last
. probe = scratch.narrowings.mark
narrowing.narrow-condition(condition, truth)
. known = frame.slot-type(slot)
frame.pop-narrowing(probe)
= known

────────────────────
_ do never-holds Bool
    - condition SyntaxId
    - truth Bool

` Whether a condition can never take a truth value, because a type test in it asks a local
` for a type its own can never be. The reference compiles neither the branch such a condition
` guards nor the operand it short-circuits.
do match? tree.nodes[condition]
    | .node-type-predicate(row)
        = never-holds(row.expr, truth)
    | .node-unary-expression(row)
        if row.op == .not-op
            = never-holds(row.operand, !truth)
    | .node-binary-expression(row)
        if row.op == .and-op || row.op == .or-op
            . left = never-holds(row.lhs, truth)
            . right = never-holds(row.rhs, truth)
            = if (row.op == .and-op) == truth then left || right else left && right
        if is-type-test(row.op)
            . negated = is-negated-test(row.op)
            = negated != truth && impossible-test(row.op, row.lhs, row.rhs)
= false

────────────────────
_ do impossible-test Bool
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

. subject = no-type
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, lhs)
        if resolution.kind == .resolve-slot
            subject = frame.slot-type(resolution.slot)
if subject == no-type || subject == invalid-type
    = false
. target = invalid-type
do match tree.nodes[rhs]
    | .node-symbol
        = false
    | .node-type-case
        = false
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    ??
        target = types.evaluate-type(module, tree, rhs, frame.env)
if target == invalid-type || types.completions[target].has-variables
    = false
= !could-match(subject, target, is-specificity(op))

────────────────────
_ is-specificity Specificity
    - op Operator

match op
    |= .is-exactly-op
        .exact
    |= .is-not-exactly-op
        .exact
    |= .is-similar-op
        .convertible
    |= .is-not-similar-op
        .convertible
    ??
        .similar

────────────────────
_ do could-match Bool
    - subject TypeId
    - target TypeId
    - kind Specificity

if types.completions[subject].has-variables
    = true
if relations.holds-as(relations.compare-pattern(subject, target), kind)
    = true
. intrinsic = types.intrinsic-of(subject)
if intrinsic == .optional
    = could-match(types.optional-inner(subject), target, kind)
if intrinsic == .table-row || intrinsic == .immutable-table-row
    = true
if intrinsic != .union
    = false
for fact in types.cases-of(subject)
    if fact.type != no-type && fact.type != invalid-type
        if relations.holds-as(relations.compare-pattern(fact.type, target), kind)
            = true
= false

────────────────────
_ do note-carried
    - id SyntaxId
    - slot SlotId

` Notes a read of a local that relies on what was known of it before a loop around the read
` began: nothing in the loop has told more of it since. The body of a `do without gc` block notes
` a read of a local it captures for the function around it, where it runs.
if outer && frame.is-captured(slot) && in-zone-body
    outer.note-carried(id, slot)
    =
if loop-marks.length == 0 || (outer && frame.is-captured(slot))
    =
if frame.slot-type(slot) == frame.known(slot)
    =
for index in 0 .. < loop-marks.length
    if scratch.narrowed-since(loop-marks[index], slot-key(slot)) == no-type
        carried-slots += slot
        carried-loops += index
        carried-sites += id

────────────────────
_ do forget-carried
    - id SyntaxId

` A test of whether a local holds a value relies on nothing known of it.
if carried-sites.length == 0
    =
. kept = 0
for position in 0 .. < carried-sites.length
    if carried-sites[position] != id
        carried-slots[kept] = carried-slots[position]
        carried-loops[kept] = carried-loops[position]
        carried-sites[kept] = carried-sites[position]
        kept += 1
-= carried-slots[kept .. < carried-slots.length]
-= carried-loops[kept .. < carried-loops.length]
-= carried-sites[kept .. < carried-sites.length]

────────────────────
_ do infer-found Found
    - id SyntaxId
    - want Want = Want()

` A node typed as `infer` types it, with what else typing it found (`Found`).
if id == 0
    = Found(no-type)
. found = found-node(id, want)
settle-typed(id, found.type)
= found

────────────────────
_ do settle-typed TypeId
    - id SyntaxId
    - inferred TypeId

` Keeps the type a node was found to have, where it has one, and ends what is known of
` properties where the node may change them (`unsettles`).
if frame.members-narrowed && unsettles(id)
    frame.doubt-members()
if inferred != no-type
    facts.set-node-type(instance, id, inferred)
= inferred

────────────────────
_ do found-node Found
    - id SyntaxId
    - want Want

` What typing a node finds, of the nodes that may find more than their type: names, reads of
` members, indexes and calls, which may be links of an optional chain or name events. Any other
` node finds its type alone. A node that stands for a value already typed (`standing`) finds that.
=? Found(standing-type) if id == standing && standing != 0
do match? tree.nodes[id]
    | .node-identifier(row)
        note-plain(id, row.name)
        if row.is-tracked
            . tracked = infer-tracked-name(id, row.name, want)
            = tracked.typed(note-collection-read(id, tracked.type, want))
        = infer-identifier(id, row.name, want)
    | .node-call-expression(row)
        = infer-call(id, row.callable, row.params, row.args, row.is-curried, 0, no-type, want)
    | .node-get-expression(row)
        . got = infer-get(id, row.object, row.name, row.is-optional, want)
        if !row.is-tracked && !row.is-optional && got.type != invalid-type
            plan-array-field(id, row.object, row.name)
        if row.is-tracked && got.type != invalid-type
            note-collection-read(id, got.type, want)
            if !pulled-root(id, row.object)
                track-root(row.object)
            . held = facts.node-type(instance, row.object)
            track-read
                - id
                - if types.is-optional(held) then types.optional-inner(held) else held
                - row.name
        = got
    | .node-index-expression(row)
        = infer-index(id, row.object, row.index, row.is-optional, want)
    | .node-markup-read-expression(row)
        = infer-markup-read(id, row)
    | .node-style-read-expression(row)
        = infer-style-read(id, row)
= Found(infer-node(id, want))

────────────────────
_ do found-event U32
    - event NamedEvent

` Keeps an event a node names for what typed it to take (`Found.event`).
found-events += event
= (found-events.length - 1) as U32

────────────────────
_ found-event-of NamedEvent?
    - found Found

` The event a node was found to name, or none.
if found.event != U32.max then found-events[found.event] else null

────────────────────
_ do unsettles Bool
    - id SyntaxId

` Whether a node, once its parts are typed, does something that may end what the reference
` knows of a property where this pass keeps it. The reference forgets at every call it
` emits but a probe's, also the ones no source writes. This pass forgets at the calls it
` settles, and the frame sees the calls and conversions it records. What does none of these is
` listed here:
` among them a literal string or a nested function made, which the reference makes in place,
` a cast, whose conversion the frame sees, unless it is one under `catch` that gives an error
` where it fails, a `!` of what the flow knows holds a value, which the reference takes as it
` is, `type-of`, arithmetic the reference makes in place, division too, a comparison it makes
` in place (`compares-in-place`), also of optionals whose flags it tests around such a
` comparison of what they hold, a read of a field of a tuple or a struct by a constant index,
` a read or a write of a style, which ends what is known of properties as a call does, a call
` the compiler answers with no call of its own (`answers-in-place`), and a store to a property
` of an object read from a local or the receiver, which ends what the reference ends
` (`forget-store-root`). Anything else leaves the two in doubt, and a property
` read in doubt is declined.
do match? tree.nodes[id]
    | .node-integer-syntax
        = false
    | .node-cast-expression
        = facts.plan-of(instance, id) == .plan-caught-cast
    | .node-function-syntax
        = false
    | .node-float-syntax
        = false
    | .node-string-syntax
        = false
    | .node-identifier
        = false
    | .node-get-expression
        = false
    | .node-index-expression
        = facts.plan-of(instance, id) != .plan-field && !facts.answers-in-place(instance, id)
    | .node-style-read-expression
        = false
    | .node-tuple-syntax
        = false
    | .node-optional-chain
        = false
    | .node-type-predicate
        = false
    | .node-block
        = false
    | .node-assertion-syntax
        = false
    | .node-match-expression
        = false
    | .node-structure-match
        = false
    | .node-call-expression
        = !facts.answers-in-place(instance, id)
    | .node-binary-expression(row)
        if (row.op == .is-op || row.op == .is-not-op) && tree.nodes[row.rhs] is .node-symbol
            = false
        . branches = short-circuits || row.op == .if-op || row.op == .else-op
            .. short-circuits = row.op == .and-op || row.op == .or-op || row.op == .coalesce-op
        . plan = facts.plan-of(instance, id)
        . compared = if plan == .plan-held then facts.held-of(instance, id).plan else plan
        = !branches && compared != .plan-builtin && !compares-in-place(compared)
    | .node-unary-expression(row)
        if row.op == .optional-force-op && !types.is-optional(operand-type)
            = false
        .. operand-type = facts.node-type(instance, row.operand)
        if row.op == .type-of-op
            = false
        = row.op != .not-op && facts.plan-of(instance, id) != .plan-builtin
    | .node-assign(row)
        do match? tree.nodes[row.lhs]
            | .node-identifier
                . kind = bindings.resolution-of(frame.binding, row.lhs).kind
                = kind != .resolve-slot && kind != .resolve-member
            | .node-get-expression
                = settled-store != id
            | .node-style-read-expression
                = false
= true

────────────────────
_ compares-in-place Bool
    - plan OperatorPlan

` Whether a comparison is one the reference makes with no call of its own: of tuples, structs
` or unions field by field, of objects or atoms by identity, of an optional with `null`, of
` values never equal, or a test of an object's class. The calls a field-by-field comparison
` makes are recorded, and the frame sees them.
structural || plan == .plan-absent || plan == .plan-unlike || plan == .plan-class-test

.. structural = plan == .plan-fields || plan == .plan-not-fields || plan == .plan-identity

────────────────────
_ is-typed-name Bool
    - pattern SyntaxId

` Whether what a declaration declares is one name with the type written for it, which the
` declaration matches as `matches-in-place` says.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type != 0 && !reads-name(row.type)
    ??
        false

────────────────────
_ do infer-latest TypeId
    - id SyntaxId
    - value SyntaxId

` The latest item of a stream, `##` of it, as the reference reads it in a live action: the
` stream is made a `Broadcastable` where it is written, cast where it supports one and given
` to `publisher` where it only iterates, either converted at the stream's own node, apart from
` what converts the item where it is read, and a `BroadcasterTracker` is made of it and the empty
` value of its item, recorded at the node, which converts it to a `Tracker` there for the
` trackers of the action. The local the node declares keeps it for the function that runs the
` action again, which reads its `latest`. The node has the item's type. The statement it is
` read in runs in a live action as one a tracked read is in does. An event made a stream, and
` a read in any other live action, have no shape here.
demand-live-runtime()
. given = infer(value)
if given == invalid-type || given == no-type
    = invalid-type
if types.broadcastable-decl.module == 0
    decline(id)
    = invalid-type
. stream = supported(given, types.broadcastable-decl)
. mark = scratch.types.mark
. publisher = no-instance
if stream == no-type && !iterates(given)
    . shown = type-display(types, given)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Object is not a broadcastable or iterable: $shown")
        - given
    = invalid-type
if stream == no-type
    scratch.types.push(given)
    publisher = calls.demand-runtime-call
        - types.broadcastable-decl.module
        - no-type
        - program.store-atom("publisher")
        - mark
    scratch.types.rewind(mark)
    if publisher == no-instance
        decline(id)
        = invalid-type
    conversions.convert
        - value
        - value
        - given
        - instances.argument-type(publisher, 0)
        - .reason-argument
    do facts.record-call(instance, id, publisher, .call-function, scratch.no-fills, false)
    stream = instances.signatures[publisher].returns
else
    conversions.convert(value, value, given, stream, .reason-argument)
. item = first-arg(stream)
. tracking = if item != no-type then types.well-known-type-of("core/tracker", "BroadcasterTracker", item) else invalid-type
. tracker = types.well-known-type("core/tracker", "Tracker")
if tracking == invalid-type || tracker == invalid-type || instances.live.add-tracker == no-instance
    decline(id)
    = invalid-type
scratch.types.push(stream)
scratch.types.push(item)
. made = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if made == no-instance
    decline(id)
    = invalid-type
. kept = instances.signatures[made].returns
conversions.convert(id, id, kept, tracker, .reason-argument)
facts.latest-reads += LatestRead(instance, id, stream, made, publisher)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, kept)
instances.mark-may-panic(instance)
if frame.declaration.kind != .live-decl
    if live-context(read-site(id)) != .live-statement
        decline(id)
        = invalid-type
    note-live-statement(read-site(id))
= item

────────────────────
_ do infer-held TypeId
    - id SyntaxId
    - expr SyntaxId

` The middle of a chain of orderings has the type of its expression, which its slot keeps for
` the ordering that reads it.
. held = infer(expr)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, held)
= held

────────────────────
_ do infer-held-read TypeId
    - id SyntaxId

` The ordering after the middle of a chain reads the type the middle's slot keeps. A read
` that no middle was held for is declined.
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind != .resolve-slot
    decline(id)
    = invalid-type
= frame.slot-type(resolution.slot)

────────────────────
_ do infer-node TypeId
    - id SyntaxId
    - want Want

do match tree.nodes[id]
    | .node-integer-syntax(row)
        = infer-integer(id, row.value, row.unit)
    | .node-float-syntax(row)
        = if row.unit then infer-unit-float(id, row.value, row.unit) else types.f64-type
    | .node-symbol(row)
        if id == arm-typing.symbol
            = infer-armed-symbol(id, row.name)
        = infer-symbol(id, row.name)
    | .node-string-syntax
        = types.string-type
    | .node-identifier
        = found-node(id, want).type
    | .node-call-expression
        = found-node(id, want).type
    | .node-binary-expression(row)
        = infer-binary(id, row.op, row.lhs, row.rhs, armed-want(id, want))
    | .node-unary-expression(row)
        = infer-unary(id, row.op, row.operand)
    | .node-held-expression(row)
        = infer-held(id, row.expr)
    | .node-held-read
        = infer-held-read(id)
    | .node-latest-expression(row)
        = infer-latest(id, row.expr)
    | .node-use-expression(row)
        = check-use(id, row.expr)
    | .node-catch-optional-expression(row)
        = infer-catch-optional(id, row.body)
    | .node-catch-expression(row)
        = infer-catch(id, row.body, row.is-raw-result, row.catchers, want)
    | .node-cast-expression(row)
        = infer-cast(id, row.lhs, row.rhs)
    | .node-range-expression(row)
        = infer-range(id, row.op, row.left, row.right, row.increment)
    | .node-tuple-syntax(row)
        = infer-tuple(row.items)
    | .node-header-expression(row)
        = infer-header(id, row.expr, row.items)
    | .node-c-identifier(row)
        . constant = program.c-constant-text(module, row.name)
        if constant
            = infer-integer(id, constant, null)
        . bound = calls.c-binding(row.name)
        if bound == no-type
            frame.diagnose(id, .function-not-found, row.name)
            = invalid-type
        = bound
    | .node-list-syntax(row)
        = infer-list(id, row.items, want)
    | .node-get-expression
        = found-node(id, want).type
    | .node-print(row)
        = infer-print(id, row.body)
    | .node-match-expression(row)
        if is-region(id)
            decline(id)
            = invalid-type
        = infer-match(id, row.subject, row.body, row.is-optional, row.helper, row.is-block, want)
    | .node-stream-match(row)
        = infer-stream-match(id, row.pattern, row.is-root)
    | .node-structure-match(row)
        = infer-arms(id, row.pattern, want)
    | .node-assign(row)
        . assigned = infer-assign(id, row.op, row.lhs, row.rhs, want)
        if assigned != invalid-type && facts.live-statements.length != 0
            settle-live-statement(id, row.lhs, row.rhs, facts.node-type(instance, row.rhs))
        = assigned
    | .node-property-syntax(row) { frame.declaration.is-content || frame.declaration.kind == .live-decl }
        = infer-content-property(id, row.value, want)
    | .node-optional-chain(row)
        = infer(row.expr)
    | .node-type-predicate(row)
        = infer(row.expr)
    | .node-block(row)
        . diagnosed = facts.diagnostics.length
        . valued = check-block(id, row.body, false)
        if valued == no-type && facts.diagnostics.length == diagnosed
            . printed = tree.final-print(id)
            if printed != 0
                frame.diagnose(printed, .stated, program.store-atom(print-block-text()))
            else
                frame.diagnose(id, .stated, program.store-atom("Illegal statement"))
            = invalid-type
        = valued
    | .node-function-syntax
        = closure-type(id)
    | .node-do-task-block(row)
        if row.worker != 0 && !row.is-parallel
            check-worker(id, row.worker)
        frame.doubt-members()
        check-task(id)
        = calls.demand-task-value(id)
    | .node-type-identifier
        . named = types.evaluate-type(module, tree, id, frame.env)
        if named == invalid-type && report-missing-type(id, frame.env)
            = invalid-type
        = type-info-of(id, named)
    | .node-core-type-identifier
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-assertion-syntax(row)
        check-assertion(id, row.exception, row.condition)
        if row.condition == 0
            facts.mark-leaving(instance, id)
        = no-type
    | .node-ref-identifier(row)
        . referred = infer-identifier(id, row.name, want).type
        if referred == types.void-type
            frame.diagnose(id, .stated, program.store-atom("Void has no physical address"))
            = invalid-type
        = pointer-to(referred)
    | .node-index-expression
        = found-node(id, want).type
    | .node-iterator-expression(row)
        = infer-comprehension(id, row.loop, row.body, row.next)
    | .node-iterable-expression(row)
        = infer-stream(id, row.expr)
    | .node-argument(row)
        = infer-argument-value(id, row)
    | .node-bullet-expression
        = infer-bullets(id, 0)
    | .node-pipeline-expression(row)
        = infer-pipeline(id, row.op, row.left, row.right)
    | .node-anonymous-case(row)
        = infer-anonymous-case(id, row.name, row.args, row.owner)
    | .node-type-arguments
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-type-associated
        = type-info-of(id, types.evaluate-type(module, tree, id, frame.env))
    | .node-pattern-helper-syntax
        frame.diagnose
            - id
            - .stated
            - program.store-atom("with helper must be the first clause of a stream match")
        = invalid-type
    | .node-markup(row)
        = infer-markup(id, row, want)
    | .node-slot-outlet(row)
        = infer-outlet(id, row)
    | .node-markup-read-expression
        = found-node(id, want).type
    | .node-style-read-expression
        = found-node(id, want).type
    | .node-style-property-expression(row)
        = infer-style-property(id, row)
    | .node-style-when
        frame.diagnose
            - id
            - .stated
            - program.store-atom("\"when\" state branches are only allowed in style rule bodies")
        = invalid-type
    | .node-state-machine
        = check-machine-site(id)
    ??
        decline(id)
        = invalid-type

────────────────────
_ is-batch Bool
    - type TypeId

` Whether objects of a type are batches of markup.
if batch-declared then derived-interface(type, types.markup-batch-decl) != no-type else false

.. batch-declared = types.markup-batch-decl.module != 0 || types.markup-batch-decl.decl != 0

────────────────────
_ in-batch Bool

` Whether a batch of markup is in force where content is being typed.
batched.length != 0 && batched[batched.length - 1]

────────────────────
_ batch-type TypeId

` The `MarkupRootElement` of the markup runtime.
types.well-known-type("core/markup", "MarkupRootElement")

────────────────────
_ line-keeper SlotId
    - line SyntaxId

` The local no name reaches that keeps the object of the element a line of content is given to,
` declared at the line and found by its name, since the line may be a name its node resolves;
` the one after it keeps what the element took.
bindings.declared-at(frame.slots, line, program.store-atom("(element)"))

────────────────────
_ do action-maker InstanceId?
    - site SyntaxId
    - made TypeId
    - rooted Bool

` The markup runtime's function that makes the live action an object of a class owns, as
` `owner-action` says: `make-markup-action` given the batch in force where `rooted`, else
` `make-owner-markup-action` given the object as its host. One that has no shape here is
` declined, which is answered with nothing.
. host = if types.intrinsic-of(made) == .class then markup-host else no-type
    .. markup-host = derived-interface(made, types.markup-host-decl)
if types.intrinsic-of(made) != .class || (host == no-type && !rooted)
    decline(site)
    = null
demand-live-runtime()
. live = instances.live
. mark = scratch.types.mark
scratch.types.push
    - if live.trackers != no-instance then instances.signatures[live.trackers].returns else no-type
scratch.types.push(live.callback)
scratch.types.push(if rooted then batch-type() else host)
. action = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom(if rooted then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
if action == no-instance || live.has-actions == no-instance || other-return
    decline(site)
    = null
.. other-return = instances.signatures[action].returns != types.live-action-type
if !raises-out(site, action)
    decline(site)
    = null
= action

────────────────────
_ owns-batch Bool
    - made TypeId

` Whether the live actions a markup element owns are made with a batch, as the reference's
` `createMarkupAction` makes them where it finds one for the element: the element itself where
` it is a batch, converted at its type as `batch-element` converts it, else the one in force.
is-batch(made) || in-batch()

────────────────────
_ do argument-name Atom?
    - arg SyntaxId
    - element SyntaxId
    - from InstanceId

` The name of the parameter an argument of a markup element, given by position, fills, as the
` instance that makes the element chose its constructor, or none.
. fact = facts.latest-call(from, element)
if fact == no-fact || facts.calls[fact].callee == no-instance
    = null
. callee = instances.rows[facts.calls[fact].callee]
. owner = program.modules[callee.module]
do match? tree.nodes[element]
    | .node-markup(row)
        do match? owner.decls[callee.decl]
            | .decl-function(fn)
                . position U32
                for written in tree.children[row.args]
                    if written == arg
                        if position >= fn.args.count
                            = null
                        = owner.arg-pool[fn.args.start + position].name
                    position += 1
= null

────────────────────
_ do interface-accessor Index?
    - type TypeId
    - name Atom

types.complete(type)
. base = types.base-of(type)
if base
    . inherited = interface-accessor(base, name)
    =? inherited if inherited
for interface in types.interfaces-of(type)
    . place = property-named(interface, name)
    =? place if place && types.properties[place].storage-kind == .storage-getter
    . deeper = interface-accessor(interface, name)
    =? deeper if deeper
= null

────────────────────
_ do raise-statement
    - statement SyntaxId

` Makes the object of each markup element a statement of a block declares a name for, where the
` statement runs, as the reference does: the locals the statements above declare are in reach
` of what makes it. One a read of its name above made first is not made again.
=? if unbuilt.length == 0 || !(tree.nodes[statement] is .node-markup)
raise-element(statement, statement)

────────────────────
_ do raise-line
    - line SyntaxId

` Makes the object of each markup element a body written as one line declares a name for, as
` `raise-elements` does for the lines of a block.
. first = unbuilt.length
await-element(line)
if unbuilt.length == first
    =
raise-element(line, line)
while unbuilt.length > first
    unbuilt.pop()
    awaited.pop()

────────────────────
_ do is-plain-body Bool
    - body SyntaxId
    - rooted Bool = false
    - ruled Bool = false

` Whether the body of a markup element is one whose every line has a shape here: a block in which
` nothing tracks what it reads, apart from statements run again when it changes, values given rules
` applied where no live action of the reference is open, which read what they track plainly, markup
` branch and loop regions, whose arms and rows are checked where they are built, lines that give
` slots content, checked where the functions that build them are, in a root `<This`, the values its
` lines give properties, and state machines the object keeps; a line that holds another state
` machine, but in a region or a loop, has none. In the class's `• This` (`ruled`), the lines that
` are the rule's own are no lines of it. What the conditions of the style rules an element applies
` read is read by the gates that test them.
if body == 0
    = true
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if kept-machine(statement) || rule-line || binds-slot(statement)
                continue
            .. rule-line = ruled && tree.rule-part(statement)
            if !is-plain-line(statement, body, rooted)
                = false
        = true
= false

────────────────────
_ do is-plain-line Bool
    - line SyntaxId
    - body SyntaxId
    - rooted Bool

` Whether a line of the body of a markup element has a shape here, as `is-plain-body` says.
. gated [SyntaxId]
for node in tree.subtree-start(line) .. line
    do match? tree.nodes[node]
        | .node-style-rule-application(row)
            if row.condition != 0
                gated += row.condition
for node in tree.subtree-start(line) .. line
    if in-gated(node, gated)
        continue
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked && name-plain && name-live
                = false
            .. name-plain = !in-live-statement(node, body) && !(rooted && tree.in-attribute(node, body))
            .. name-live = !in-region(node, body) && live-context(node) != .live-none
        | .node-get-expression(row)
            if row.is-tracked && get-plain && get-live
                = false
            .. get-plain = !in-live-statement(node, body) && !(rooted && tree.in-attribute(node, body))
            .. get-live = !in-region(node, body) && live-context(node) != .live-none
        | .node-state-machine
            if !in-region(node, body) && !tree.in-body-loop(node, body)
                = false
        | .node-markup-read-expression
            = false
= true

────────────────────
_ do leaves-line Bool
    - statement SyntaxId

` Whether a line of a markup element's body leaves where it stands, which the reference
` reports as a return no element may hold: a return, under a condition or not, a raise
` under no condition, `continue`, `break`, or a `do` block whose last statement is one.
if is-leaving(statement) || tree.nodes[statement] is .node-return-if-true
    = true
do match? tree.nodes[statement]
    | .node-do-block(row)
        = facts.is-leaving(instance, row.body)
= false

────────────────────
_ is-markup-host Bool
    - type TypeId

` Whether objects of a type take their content through the markup protocol.
types.intrinsic-of(type) == .class && host-named && derived-interface(type, host) != no-type

.. host = types.markup-host-decl
.. host-named = host.module != 0 || host.decl != 0

────────────────────
_ takes-lines Bool
    - type TypeId

` Whether an element's lines are linked to it by its own `+=` and `++=`: it is an object of
` a class that does not take content through the markup protocol, and neither the class nor
` one it derives from writes markup that holds the default slot, which would take the lines.
|? types.intrinsic-of(type) != .class
    false
|? (host.module != 0 || host.decl != 0) && derived-interface(type, host) != no-type
    false
??
    !holds-slot(type)

.. host = types.markup-host-decl

────────────────────
_ takes-hosted Bool
    - type TypeId

` Whether an element's lines are linked to it through the markup protocol: it is an object of
` a markup host, and neither its class nor one it derives from writes markup that holds the
` default slot, which would take the lines.
is-markup-host(type) && !holds-slot(type)

────────────────────
_ do holds-slot Bool
    - type TypeId

` Whether a class or one it derives from writes markup that holds the default slot.
. level TypeId? = type
while level
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            if class.content != 0
                for node in owner.tree.subtree-start(class.content) .. < class.content
                    do match? owner.tree.nodes[node]
                        | .node-slot-outlet(row)
                            if row.name == 0
                                = true
    level = types.base-of(level)
= false

────────────────────
_ builds-slot Bool
    - element SyntaxId

` Whether this instance is the function that builds what a markup element, this one, gives a
` slot.
frame.declaration.kind == .slot-decl && frame.declaration.syntax == element

────────────────────
_ do binds-slot Bool
    - statement SyntaxId

` Whether a line is a markup element that gives a slot content, which a function of its own
` builds: one that binds a slot by name, or the one line of its body that gives the default slot
` content, element or value; or one that forwards a slot.
do match? tree.nodes[statement]
    | .node-markup
        = nested-decl-of(statement) != 0
    | .node-markup-slot-forward
        = true
=? true if tree.fills-only(statement)
= wraps-default(statement)

────────────────────
_ do check-slot
    - element SyntaxId

` The function that builds what a markup element gives a slot: the element made with its
` content, as it would be anywhere, cast to the type of the slot, which the element that gives
` it the function settled (`supply-slots`), under the styles that element sees and the rules
` written in rules it gives with those found on the way to the slot's outlet, under the state
` cells this function keeps or reads (`take-scope`). Where the slot
` repeats, it is given the item, which the name the element writes for it holds. It answers
` that type, and lets out what making the element raises. An element whose name is a property
` of the class the markup is run on gives the property the object, once made. The body of an
` element whose lines all give the default slot content builds them into a node (`wrap`). It
` runs under the batch in force where the line is written, read from the local that keeps it.
` Where the rules the slot's outlet applies bring rules under the state cells of `when`s, this
` function brings them (`root-applications`) and checks the states on what it built.
` One a style rule generates is typed as `check-content` says.
if instances.rows[instance].context != U32.max
    check-content(element)
    =
prepare()
. wanted = if outer then outer.slot-wanted else no-type
if wanted == no-type
    decline(element)
    finish-errors(frame)
    close()
    =
instances.set-returns(instance, wanted, wanted, .return-declared)
. rooted = if outer then outer.slot-batch else false
if rooted
    facts.region-roots += RegionRoot(instance, element, outer!.slot-root, batch-type())
do match? tree.nodes[element]
    | .node-markup(row)
        if row.slot-parameter != 0
            . resolution = bindings.resolution-of(frame.binding, row.slot-parameter)
            . item = instances.argument-type(instance, 0)
            if resolution.kind != .resolve-slot || item == no-type
                decline(element)
                finish-errors(frame)
                close()
                =
            frame.assign(resolution.slot, item)
. styled = markup-styles.length
for style in outer!.slot-styles
    markup-styles += style
for sheet in outer!.slot-sheets
    markup-sheets += sheet
for level in outer!.slot-levels
    sheet-levels += level
sheets-given = outer!.slot-sheets-known
for use in outer!.slot-scopes
    rule-scopes += take-scope(use)
. applied = outer!.slot-applying
if applied != 0 && !root-applications(outer!.slot-applying-module, applied, wanted)
    decline(element)
    finish-errors(frame)
    close()
    =
scopes-given = outer!.slot-scopes-known
layer-given = outer!.markup-layer()
batched += rooted
. made = if tree.nodes[element] is .node-block then wrap(element, wanted) else infer(element)
batched.pop()
if typed-made && applied != 0 && !check-cells(U32.max - 1, element, made, true)
    made = invalid-type
.. typed-made = made != invalid-type && made != no-type
if made != invalid-type && made != no-type
    conversions.convert(element, element, made, wanted, .reason-return)
    do match? tree.nodes[element]
        | .node-markup(row)
            if row.id != 0
                . place = named-place(element, row.id, made)
                if place
                    facts.note-named-store(NamedStore(instance, element, place))
while markup-styles.length > styled
    markup-styles.pop()
finish-errors(frame)
close()

────────────────────
_ do wrap TypeId
    - body SyntaxId
    - wanted TypeId

` The node the lines of a markup element's body, all content of its class's default slot, are
` built into, as the reference's `markupSlotContentWrapper` builds it: an object of the slot's
` type made with no arguments, of which the lines are the content. A type that is no markup
` host, or a batch, is declined.
if !is-markup-host(wanted) || is-batch(wanted)
    decline(body)
    = invalid-type
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. made = calls.construction-on(body, wanted, arguments)
if made == invalid-type || made == no-type
    = invalid-type
facts.set-node-type(instance, body, made)
content-blocks += body
content-parents += made
content-names += false
element-bodies += body
batched += in-batch()
check-statement(body)
batched.pop()
element-bodies.pop()
content-names.pop()
content-parents.pop()
content-blocks.pop()
= made

────────────────────
_ do check-binder
    - name SyntaxId

` The function a markup element whose body gives slots content gives its constructor, which
` the constructor runs once its own body has, before the markup of the element's class: it
` gives the local the element's name declares its one argument, the object, in the function
` that declares the local, so that what the slots are given reads it, as the reference's
` binder does, and where the name is a property of the class the markup is run on, gives the
` property the object too. A name no block declares a local for gives only the property. A local
` reached through functions other than those that build slots has no shape here.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. host = instances.argument-type(instance, 0)
. slot = declaring-slot(name)
. reached = if slot then outer && frame.is-captured(slot) && outer.places-across(slot) else member
    .. member = names-property(name)
if host == no-type || !reached
    decline(name)
    finish-errors(frame)
    close()
    =
if slot
    assign-placed(slot, host)
if names-property(name)
    . place = named-place(name, name, host)
    if place
        facts.note-named-store(NamedStore(instance, name, place))
finish-errors(frame)
close()

────────────────────
_ names-property Bool
    - name SyntaxId

` Whether the name of a markup element is that of a property of the class of the object the
` function is run on.
|? self == no-type || self == invalid-type || types.intrinsic-of(self) != .class || lacks-self()
    false
??
    text != null && property-named(self, text) != null

.. self = frame.self-type
.. text = identifier-name(tree, name)

────────────────────
_ do give-lines Bool
    - lines [SyntaxId]
    - names [Atom]
    - wanted [TypeId]
    - items [TypeId]
    - styles [TypeId]
    - sheets [TypeId]
    - levels [U32]
    - given [Atom]
    - builders [TypeId]
    - class TypeId
    - scopes [ScopeUse]
    - scoped Bool
    - keeps-own Bool

` Types the function of each line that gives a slot content, under `styles` and the style
` `sheets` in their groups, and where `scoped`, the rules written in rules `scopes` and those found
` on the way to the outlet of the slot of `class` it gives (`outlet-scopes`, the way to which
` `keeps-own` those that match in the markup being filled where it is of that markup), made the
` builder of the slot (`builder-type`), as `names`, `wanted` and `items` hold them, and adds the
` slot to those `given`, with its builder (`add-slot`). The function of a slot that repeats takes
` the item, by the name the line writes for it. A line of a slot given already is not built: what
` gave it wins. A name bound twice is the reference's error, as is one no outlet declares, a
` slot that repeats given content that names no item, or default content, a line naming an item
` for a slot that does not repeat, and one that writes the item's type. A line that forwards a
` slot passes on the builder of that name the markup it is written in was given
` (`forward-slot`). The content given a slot whose items can be bound again is checked as the
` reference checks it (`reads-rebindable`). The function of each line is built under the batch
` in force where the line is written (`keep-root`). Answers false where a line has no shape here
` or is wrong.
. defaulted = names.find(program.store-atom("")) != null
. seen [Atom]
for line in lines
    if tree.holds-fills(line)
        if !give-choices(line, names, wanted, items, styles, sheets, levels, given, builders, class, scopes, scoped, keeps-own, seen)
            = false
        continue
    . binding SyntaxId = 0
    . parameter SyntaxId = 0
    . forwarding SyntaxId = 0
    do match? tree.nodes[line]
        | .node-markup(row)
            binding = row.slot-binding
            parameter = row.slot-parameter
        | .node-markup-slot-forward(row)
            binding = row.slot-binding
            forwarding = row.outlet
    . bound = identifier-name(tree, binding)
    if (binding != 0 && !bound) || (binding == 0 && !defaulted)
        decline(line)
        = false
    . name = if binding != 0 then bound! else program.store-atom("")
    if seen.find(name) != null
        frame.diagnose(binding, .stated, program.store-atom("Duplicate slot content"))
        = false
    seen += name
    . position = names.find(name)
    if position == null
        frame.diagnose(binding, .stated, program.store-atom("Unknown slot"))
        = false
    . item = items[position]
    if item != no-type && binding == 0
        frame.diagnose
            - line
            - .stated
            - program.store-atom("Repeated default slot content requires a slot binding")
        = false
    do match tree.nodes[parameter]
        | .node-markup-slot-parameter(written)
            if item == no-type
                frame.diagnose
                    - written.name
                    - .stated
                    - program.store-atom("Slot parameter requires a repeated slot")
                = false
            if written.type-id != 0
                frame.diagnose
                    - written.type-id
                    - .stated
                    - program.store-atom("Slot content parameter type belongs on the slot outlet")
                = false
        ??
            if item != no-type && forwarding == 0
                frame.diagnose
                    - binding
                    - .stated
                    - program.store-atom("Repeated slot content requires a slot parameter")
                = false
    . root = if forwarding == 0 then keep-root(line) else no-slot
    . held = given.find(name)
    if held && keeps-own && chosen-slot(builders[held]) != no-type
        . message = "Slot \"${name.text}\" is filled inside an if or match where this object is made, so the class's content does not fill it too"
        frame.diagnose(line, .stated, program.store-atom(message))
        = false
    if held != null
        continue
    if item != no-type && forwarding == 0 && rebinds(item) && !reads-rebindable(line, parameter)
        = false
    . content = wanted[position]
    . builder = builder-type(content, item)
    if forwarding != 0
        if forwards-nothing(name)
            continue
        if forwards-choice(name)
            frame.diagnose(line, .stated, program.store-atom("A slot filled inside an if or match is not passed on with <+; give it content here instead"))
            = false
        if builder == invalid-type || !forward-slot(line, forwarding, name, builder)
            decline(line)
            = false
        . kept = facts.outlet-cells.length
        if !hold-cells(line, scopes)
            = false
        if facts.outlet-cells.length != kept
            facts.slot-forwards += SlotForward(instance, line, builder, item)
        add-slot(name, builder, given, builders)
        continue
    slot-scopes-known = scoped
    if scoped
        . seen [ScopeUse]
        for use in scopes
            seen += use
        . found [ScopeUse]
        . status = outlet-scopes(class, name, content, true, seen, sheets, levels, found, keeps-own)
        if status == 2
            slot-scopes-known = false
            decline(line)
            = false
        if status == 3
            . (owner, outlet) = slot-outlet(class, name)
            slot-applying = outlet
            slot-applying-module = class-ref(types, owner).module
        for use in scopes
            slot-scopes += use
        for use in found
            slot-scopes += use
    . decl = nested-decl-of(line)
    if builder == invalid-type || decl == 0
        decline(line)
        = false
    slot-wanted = content
    slot-root = root
    slot-batch = root != no-slot && in-batch()
    for style in styles
        slot-styles += style
    for sheet in sheets
        slot-sheets += sheet
    for level in levels
        slot-levels += level
    slot-sheets-known = sheets-known()
    . callee = demand-nested(decl, item)
    slot-wanted = no-type
    slot-root = no-slot
    slot-batch = false
    slot-styles.clear()
    slot-sheets.clear()
    slot-levels.clear()
    slot-sheets-known = false
    slot-scopes.clear()
    slot-scopes-known = false
    slot-applying = 0
    if callee == no-instance
        decline(line)
        = false
    . closure = intern-nested(decl)
    facts.set-node-type(instance, line, closure)
    if conversions.convert(line, line, closure, builder, .reason-markup-slot) == invalid-type
        = false
    add-slot(name, builder, given, builders)
= true

────────────────────
_ do keep-root SlotId
    - line SyntaxId

` The local no name reaches that keeps the batch of markup in force where a line that gives a
` slot content is written, which the function that builds the content captures: given the
` batch's type, which the line keeps there as it makes the function, or none where no batch is
` in force, as the reference captures the batch it finds.
. decl = nested-decl-of(line)
. root = if decl != 0 then captured-root(decl, line) else no-slot
if root == no-slot
    = no-slot
. rooted = in-batch()
frame.assign(root, if rooted then batch-type() else types.void-type)
if rooted
    facts.region-roots += RegionRoot(instance, line, root, batch-type())
= root

────────────────────
_ do captured-root SlotId
    - decl DeclId
    - line SyntaxId

` The local declared at a line that gives a slot content that the function the line declares
` captures, which keeps the batch in force there.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.decl == decl
        for index in 0 .. < nested.captures.count
            . slot = bindings.captures[nested.captures.start + index].slot
            if bindings.slots[slot].syntax == line && bindings.slots[slot].kind == .slot-local
                = slot
        = no-slot
= no-slot

────────────────────
_ do forward-slot Bool
    - line SyntaxId
    - outlet SyntaxId
    - name Atom
    - builder TypeId

` A line that forwards a slot passes on, as the builder of the slot of its name, the one the
` function that fills an object with the markup it is written in was given for that name, which
` a function written in that one reaches through the local that holds it, as the reference
` passes it on unwrapped. The forward's outlet keeps where it is read from. Where that function
` was given one of another type, it is declined. One given none gives nothing (`forwards-nothing`).
. filling = filling-checker()
if !filling
    = false
. argument = instances.slot-argument(filling.instance, name)
if argument == U32.max || instances.argument-type(filling.instance, argument) != builder
    = false
. held = no-slot
if !frame.declaration.is-content
    held = builder-slot(name)
    if held == no-slot
        = false
    argument = U32.max
facts.slot-outlets += SlotOutlet(instance, outlet, argument, 0, no-type, held, 0)
= true

────────────────────
_ forwards-nothing Bool
    - name Atom

` Whether a line that forwards the slot of a name gives nothing, as the function that fills an
` object with the markup it is written in was given no builder for that name.
filling != null && instances.slot-argument(filling.instance, name) == U32.max

.. filling = filling-checker()

────────────────────
_ do builder-type TypeId
    - content TypeId
    - item TypeId

` The type of the function that builds a slot of a content type: a `MarkupSlotBuilder`, or the
` `MarkupRowBuilder` that takes the item where the slot repeats.
if item == no-type
    = types.well-known-type-of("core/markup", "MarkupSlotBuilder", content)
= types.well-known-type-of("core/markup", "MarkupRowBuilder", item, content)

────────────────────
_ rebinds Bool
    - item TypeId

` Whether the items of a slot that repeats are ones a row can be bound to again, whose content
` the reference checks for reads that would outlive the binding.
|? scope == invalid-type
    false
??
    derived-interface(item, class-ref(types, scope)) != no-type

.. scope = types.well-known-type("core/markup", "MarkupRebindableScope")

────────────────────
_ do reads-rebindable Bool
    - line SyntaxId
    - parameter SyntaxId

` Checks the reads of the item a line gives a slot whose items can be bound again, by the name
` the line writes for it, as the reference checks them: outside a function or a `do` block, each
` read of a member of it must be tracked, and no local declared there with a value that reads
` it may be read in a function the line writes, by the names in reach as the reference finds
` them (`escaping-local`). Both are the reference's errors, the first at the member read, after
` the item's name. Answers false where one is reported.
. scope Atom? = null
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(written)
        scope = identifier-name(tree, written.name)
if !scope
    decline(line)
    = false
. read = untracked-read(line, scope)
if read != 0
    do match? tree.nodes[read]
        | .node-get-expression(row)
            . message = "Rebindable slot scope reads must be tracked as ${scope.text}.#${row.name.text}; use an explicit snapshot inside do for a stable value"
            . object = tree.nodes.loc[row.object]
            frame.diagnose(row.object, .stated, program.store-atom(message))
            facts.inset-diagnostic
                - object.end.column + 1 - object.begin.column
                - (row.name.text.length + 1) as U32
    = false
. derived [SyntaxId]
derive-locals(line, scope, derived)
if derived.length == 0
    = true
. names [Atom]
. held [Bool]
. escaping = escaping-local(line, derived, names, held, false)
if escaping != 0
    . name = identifier-name(tree, escaping)
    . message = "Local ${name!.text} derived from rebindable slot scope ${scope.text} cannot escape into a closure; read ${scope.text} directly in the closure or take an explicit snapshot inside do"
    frame.diagnose(escaping, .stated, program.store-atom(message))
    = false
= true

────────────────────
_ do derive-locals
    - id SyntaxId
    - scope Atom
    - derived [SyntaxId]

` Adds each `.` written outside a function or a `do` block whose value reads a name there.
do match? tree.nodes[id]
    | .node-function-syntax
        =
    | .node-do-block
        =
    | .node-declare(row)
        if !row.is-lazy && row.right != 0 && reads-name(row.right, scope)
            derived += id
for child in tree.children-of(id)
    derive-locals(child, scope, derived)

────────────────────
_ do reads-name Bool
    - id SyntaxId
    - scope Atom

` Whether a name is read outside a function or a `do` block.
do match? tree.nodes[id]
    | .node-function-syntax
        = false
    | .node-do-block
        = false
    | .node-identifier(row)
        = row.name == scope
for child in tree.children-of(id)
    if reads-name(child, scope)
        = true
= false

────────────────────
_ do escaping-local SyntaxId
    - id SyntaxId
    - derived [SyntaxId]
    - names [Atom]
    - held [Bool]
    - closed Bool

` The first name read in a function, in the order written, that reaches a local one of the
` `derived` declarations declares, by the names in reach as the reference finds them, apart
` from what binds them: the names each declaration of a block around it declares, a lazy one's
` from the block's start and another's from after its value, which `held` marks where the
` declaration is derived, and the arguments of each function around it. None where there is
` none.
do match? tree.nodes[id]
    | .node-function-syntax(row)
        if row.body == 0
            = 0
        . mark = names.length
        for arg in tree.children[row.args]
            do match? tree.nodes[arg]
                | .node-argument-decl(shape)
                    bind-names(shape.pattern, false, names, held)
        . found = escaping-local(row.body, derived, names, held, true)
        unbind-names(mark, names, held)
        = found
    | .node-block(row)
        . mark = names.length
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-declare(declare)
                    if declare.is-lazy
                        bind-names(declare.left, derived.find(statement) != null, names, held)
        for statement in tree.children[row.body]
            . found = escaping-local(statement, derived, names, held, closed)
            if found != 0
                unbind-names(mark, names, held)
                = found
        unbind-names(mark, names, held)
        = 0
    | .node-declare(row)
        if row.is-lazy
            bind-names(row.left, derived.find(id) != null, names, held)
        if row.right != 0
            . found = escaping-local(row.right, derived, names, held, closed)
            if found != 0
                = found
        if !row.is-lazy
            bind-names(row.left, derived.find(id) != null, names, held)
        = 0
    | .node-identifier(row)
        if closed
            . place = names.length
            while place > 0
                place -= 1
                if names[place] == row.name
                    if held[place]
                        = id
                    = 0
        = 0
for child in tree.children-of(id)
    . found = escaping-local(child, derived, names, held, closed)
    if found != 0
        = found
= 0

────────────────────
_ do bind-names
    - pattern SyntaxId
    - derived Bool
    - names [Atom]
    - held [Bool]

` Puts in reach each name a pattern declares, marked `derived` or not.
do match? tree.nodes[pattern]
    | .node-identifier(row)
        names += row.name
        held += derived
        =
for child in tree.children-of(pattern)
    bind-names(child, derived, names, held)

────────────────────
_ do unbind-names
    - mark Size
    - names [Atom]
    - held [Bool]

` Takes out of reach the names put in reach since a mark.
while names.length > mark
    names.pop()
    held.pop()

────────────────────
_ do add-slot
    - name Atom
    - builder TypeId
    - given [Atom]
    - builders [TypeId]

` Adds a slot to those given, with its builder, in the order of their names, the default one
` first, as the reference orders them.
. spot = given.length
while spot != 0 && given[spot - 1].text > name.text
    spot -= 1
given.insert(name, spot)
builders.insert(builder, spot)

────────────────────
_ do wraps-default Bool
    - body SyntaxId

` Whether the body of a markup element is built by a function of its own into a node of its
` class's default slot type, every line of it content of that slot, or the one line that gives
` that content is built by one as a value of that type.
if body == 0
    = false
. decl = nested-decl-of(body)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .slot-decl
= false

────────────────────
_ do gives-default Bool
    - body SyntaxId
    - ruled Bool = false

` Whether a line of an element's body gives the default slot content that no function of its
` own builds: a line that neither assigns nor gives a slot content, nor is the rule's own in
` the body of a class's `• This` (`ruled`), where the body is not built by one.
if wraps-default(body)
    = false
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !assigning && !binds-slot(statement) && !(ruled && tree.rule-part(statement))
                = true
            .. assigning = tree.nodes[statement] is .node-assign
= false

────────────────────
_ do filling-checker Checker?

` The checker of the function that fills an object with the markup written in its class that
` this function is, or is written in; none where it is neither.
. level Checker? = this
while level
    if level.frame.declaration.is-content
        = level
    level = level.outer
= null

────────────────────
_ do builder-slot SlotId
    - name Atom

` The local that holds the function that builds the slot of a name, which the function that
` fills an object with the markup of its class was given, where a function written in that one
` reaches it.
. range = bindings.bindings[frame.binding].slots
for offset in 0 .. < range.count
    . slot = range.start + offset
    if bindings.slots[slot].kind == .slot-builder && bindings.slots[slot].name == name
        = slot
= no-slot

────────────────────
_ do hold-builders Bool
    - receiver TypeId
    - site SyntaxId

` Types the local that holds the function that builds each slot a function written in this one
` reaches through it, as the builder of the slot the class's markup declares, given or not.
` Answers false where the slots have no shape here or are wrong.
. range = bindings.bindings[frame.binding].slots
. names [Atom]
. wanted [TypeId]
. items [TypeId]
. read = false
for offset in 0 .. < range.count
    . slot = range.start + offset
    if bindings.slots[slot].kind != .slot-builder
        continue
    if !read
        read = true
        . reported = facts.diagnostics.length
        if !class-outlets(receiver, names, wanted, items)
            if facts.diagnostics.length == reported
                decline(site)
            = false
    . position = names.find(bindings.slots[slot].name)
    if position == null
        decline(site)
        = false
    . builder = builder-type(wanted[position], items[position])
    . argument = instances.slot-argument(instance, bindings.slots[slot].name)
    if argument != U32.max && chosen-slot(instances.argument-type(instance, argument)) != no-type
        builder = instances.argument-type(instance, argument)
    if builder == invalid-type
        decline(site)
        = false
    frame.assign(slot, builder)
= true

────────────────────
_ reads-getter Bool
    - id SyntaxId

` Whether a name reads a local of a row of a markup loop region that the reference reads as a
` getter.
resolution.kind == .resolve-slot && bindings.slots[resolution.slot].getter != 0

.. resolution = bindings.resolution-of(frame.binding, id)

────────────────────
_ do check-line TypeId
    - statement SyntaxId
    - parent TypeId
    - want Want = Want()

` A line of a block: one of markup content that is a markup branch region, a slot outlet that
` is one (`outlet-region`), or a markup loop region makes the region, which is the line's value,
` one that is a loop written with `in` and no function of its own runs its body as content as a
` `for` does, and any other is checked as a statement.
if parent != no-type && is-region(statement)
    = check-branch(statement, parent)
if parent != no-type && outlet-choice(statement) != no-type
    = check-chosen-outlet(statement, parent, outlet-choice(statement))
if parent != no-type && tree.builds-outlet-alone(statement)
    = check-outlet-arm(statement, parent)
if parent != no-type && outlet-region(statement) != 0
    = check-branch(outlet-region(statement), parent)
if parent != no-type && is-loop-region(statement)
    = check-loop-region(statement, parent)
if parent != no-type && nested-decl-of(statement) == 0
    do match? tree.nodes[statement]
        | .node-iterator-expression(row)
            facts.set-plan(instance, statement, .plan-content-loop)
            check-for(statement, row.loop, row.body, row.next)
            frame.forget-members()
            = no-type
= check-statement(statement, want)

────────────────────
_ do chosen-slot TypeId
    - builder TypeId

do match? types.rows[builder]
    | .type-class(row)
        if row.args.count == 1
            . slot = types.child-type(row.args, 0)
            if types.well-known-type-of("core/markup", "MarkupSlotChoice", slot) == builder
                = slot
= no-type

────────────────────
_ do is-region Bool
    - id SyntaxId

` Whether an `if` or a `match` is a markup branch region, whose arm a function of its own
` selects again.
. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .branch-decl
= false

────────────────────
_ do is-selector Bool
    - id SyntaxId

. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .selector-decl
= false

────────────────────
_ do selector-head SyntaxId
    - arm SyntaxId

. head = arm
while head != 0
    if is-selector(head)
        = head
    . before = tree.subtree-start(head) - 1
    . linked = false
    do match? tree.nodes[before]
        | .node-if-block(row)
            linked = row.next == head
    if !linked
        = 0
    head = before
= 0

────────────────────
_ do is-loop-region Bool
    - id SyntaxId

` Whether a `for` is a markup loop region, whose container a function of its own reads again.
. decl = nested-decl-of(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .source-decl
= false

────────────────────
_ region-head SyntaxId
    - arm SyntaxId

` The `if` of the markup branch region an arm is one of, or none: a later arm resolves to the
` local that keeps the region's host, which the `if` declares.
|? is-region(arm)
    arm
|? resolution.kind != .resolve-slot
    0
|? head != arm && head < tree.nodes.length && tree.nodes[head] is .node-if-block && is-region(head)
    head
??
    0

.. resolution = bindings.resolution-of(frame.binding, arm)
.. head = bindings.slots[resolution.slot].syntax

────────────────────
_ do in-region Bool
    - node SyntaxId
    - body SyntaxId

` Whether a node is written in a markup branch, match or loop region within a body: in one of
` its conditions, its subject, its patterns or its container, which the region reads in a live
` action of its own, or in an arm or the body of its loop, which a function of its own builds;
` or in a slot outlet that is such a region.
for around in node + 1 .. < body
    if tree.subtree-start(around) <= node && outlet-region(around) != 0
        = true
    if tree.subtree-start(around) <= node && if-region
        = true
    .. if-region = tree.nodes[around] is .node-if-block && region-head(around) != 0
    if tree.subtree-start(around) <= node && match-region
        = true
    .. match-region = tree.nodes[around] is .node-match-expression && is-region(around)
    if tree.subtree-start(around) <= node && loop-region
        = true
    .. loop-region = tree.nodes[around] is .node-for-block && is-loop-region(around)
    if tree.subtree-start(around) <= node && is-selector(around)
        = true
= false

────────────────────
_ do check-branch TypeId
    - id SyntaxId
    - parent TypeId

` A markup branch region, as the reference compiles one:
` the host the `if` is content of must be a `MarkupElement`, whose `MarkupParent`
` gives the type of its content. Each arm is built by a function of its own given the
` region, made a `MarkupBranchBuilder` at the arm, and the builders are made a list at the
` `if`. The conditions are read in a live action of the region's own, and the index of the
` arm whose condition holds is what the markup runtime's `markup-create-branch-region` makes
` the region with; the region is the line's value, which the host takes. The host and the
` region are kept, in the two locals no name reaches declared at the `if`, for the function
` that selects the arm again, which the action runs: made by `make-owner-markup-action`,
` owned by the host and marked structural. Where a batch is found for the host, as
` `region-batch-of` says, the region is put under it by `ensure-markup-root` once made, and the
` action is made with it by `make-markup-action`. The batch in force where the region is
` written is kept in a third such local, which the arms are built under. A region whose
` content is no class or is a batch is declined, and one whose host makes no branch region, as
` `makes-region` says, is an error at the `if`. A region of a class with events, which the
` markup runtime makes, is kept as any other: the reference closes only its live actions. A
` match region selects the first arm whose pattern its subject matches (`read-patterns`), and
` its function selects again whatever arm the region holds, asking nothing of the region first,
` as the reference's `markupMatchBranch` does, and so does that of a slot outlet that is a region,
` written at its parameter, whose one arm is the outlet.
if !is-markup-host(parent)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup branch parent must implement MarkupElement")
    = invalid-type
. tree-host = derived-interface(parent, types.markup-tree-host-decl)
. content = if tree-host != no-type then first-arg(tree-host) else no-type
if content == no-type || content == invalid-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Dynamic markup branch host content type could not be resolved")
    = invalid-type
. resolution = bindings.resolution-of(frame.binding, id)
if types.intrinsic-of(content) != .class || resolution.kind != .resolve-slot || is-batch(content)
    decline(id)
    = invalid-type
if !makes-region(parent)
    frame.diagnose(id, .stated, program.store-atom(message))
    .. message = "Markup branch host ${type-source(types, parent)} must declare markup-make-region, or extend MarkupNode"
    = invalid-type
. builder = types.well-known-type-of("core/markup", "MarkupBranchBuilder", content)
. list = types.well-known-type-of("core/list", "List", builder)
if builder == invalid-type || list == invalid-type
    decline(id)
    = invalid-type
. rooted = in-batch()
. hosted = is-batch(parent)
. outer-batch = region
region = region.batch = rooted
region = region.root = resolution.slot + 2
frame.assign(resolution.slot, parent)
for arm in tree.region-arms(id)
    . body = tree.region-arm-body(arm)
    . decl = nested-decl-of(body)
    if decl == 0 || demand-nested(decl, content) == no-instance
        region = outer-batch
        decline(arm)
        = invalid-type
    . closure = intern-nested(decl)
    facts.set-node-type(instance, body, closure)
    if conversions.convert(arm, arm, closure, builder, .reason-markup-arm) == invalid-type
        region = outer-batch
        = invalid-type
region = outer-batch
calls.note-list(id, list)
read-arms(id)
demand-live-runtime()
. live = instances.live
. host = derived-interface(parent, types.markup-host-decl)
. selected = types.optional-of(types.index-type)
. markup = types.markup-host-decl.module
. mark = scratch.types.mark
scratch.types.push(content)
scratch.types.push(parent)
scratch.types.push(parent)
scratch.types.push(list)
scratch.types.push(selected)
. create = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom("markup-create-branch-region")
    - mark
    - 2
scratch.types.rewind(mark)
scratch.types.push(content)
scratch.types.push(content)
scratch.types.push(selected)
. matched = tree.nodes[id] is .node-match-expression || slot-parameter
    .. slot-parameter = tree.nodes[id] is .node-markup-slot-parameter
. keeps = if matched then no-instance else calls.demand-runtime-call(markup, no-type, program.store-atom("markup-branch-region-keeps-arm"), mark, 1)
. select = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom("markup-select-branch-region")
    - mark
    - 1
scratch.types.rewind(mark)
. batched = rooted || hosted
. trackers = if live.trackers != no-instance then trackers-type else no-type
    .. trackers-type = instances.signatures[live.trackers].returns
scratch.types.push(trackers)
scratch.types.push(live.callback)
scratch.types.push(if batched then batch-type() else host)
. action = calls.demand-runtime-call
    - markup
    - no-type
    - program.store-atom(if batched then "make-markup-action" else "make-owner-markup-action")
    - mark
scratch.types.rewind(mark)
. structural = mark-structural(id, parent)
if create == no-instance || (keeps == no-instance && !matched) || uncalled
    decline(id)
    = invalid-type
.. uncalled = select == no-instance || action == no-instance || structural == no-instance
. made = instances.signatures[create].returns
if types.intrinsic-of(made) != .class || other-return
    decline(id)
    = invalid-type
.. other-return = instances.signatures[action].returns != types.live-action-type
if (!matched && instances.signatures[keeps].returns != types.bool-type) || actionless
    decline(id)
    = invalid-type
.. actionless = instances.live.has-actions == no-instance
if !raises-out(id, create) || !raises-out(id, action) || !raises-out(id, structural)
    decline(id)
    = invalid-type
if hosted
    conversions.convert(id, id, parent, batch-type(), .reason-markup-batch)
. ensure = region-ensure(id, made, batched, .reason-markup-region)
if !ensure
    = invalid-type
if !batched || is-markup-host(parent)
    conversions.convert(id, id, parent, host, .reason-markup-host)
frame.assign(resolution.slot, parent)
frame.assign(resolution.slot + 1, made)
frame.assign(resolution.slot + 2, if rooted then batch-type() else types.void-type)
. outer-content = region
region = region.content = content
region = region.keeps = keeps
region = region.select = select
. updater = demand-lambda(intern-nested(nested-decl-of(id)), scratch.no-types)
region = outer-content
if updater == no-instance || (updater-raises && live.callback-result == no-type)
    decline(id)
    = invalid-type
.. updater-raises = instances.signatures[updater].errors.count != 0
instances.mark-may-panic(instance)
facts.branch-regions += BranchRegion
    - instance
    - id
    - parent
    - content
    - list
    - selected
    - create
    - updater
    - action
    - structural
    - keeps
    - select
    - ensure
    - hosted
    - rooted
= made

────────────────────
_ do mark-structural InstanceId
    - id SyntaxId
    - owner TypeId

` The call that marks the action of a markup region structural, given the host that owns the
` action as the reference's `markupLiveAction` does: the parent of a branch or the region of a
` loop, where that is a markup host, so a batch runs the actions of outer regions before those
` of inner ones. The host, converted at the `if` or `for` to the `MarkupElement` it is, is converted
` there again to the optional the call takes. Where the owner is no markup host the call is
` given none.
. host = types.well-known-type("core/markup", "MarkupElement")
. optional = types.optional-of(host)
. mark = scratch.types.mark
scratch.types.push(types.live-action-type)
scratch.types.push(optional)
. structural = calls.demand-runtime-call
    - types.markup-host-decl.module
    - no-type
    - program.store-atom("mark-structural-markup-action")
    - mark
scratch.types.rewind(mark)
if structural != no-instance && is-markup-host(owner)
    conversions.convert(id, id, host, optional, .reason-markup-structural)
= structural

────────────────────
_ do arm-root Bool
    - body SyntaxId
    - content TypeId
    - slot SlotId

` The batch in force where a markup branch region is written, which the function that builds
` an arm is built under: read from the local that keeps it, and the region the arm is given
` put under it by `ensure-markup-root` first, where it is a markup host, as the reference's
` builder and then its `compileContents` each do. False, once declined, where that has no
` shape here.
. ensure = no-instance
if is-markup-host(content)
    . host = derived-interface(content, types.markup-host-decl)
    . optional = types.optional-of(batch-type())
    . mark = scratch.types.mark
    scratch.types.push(host)
    scratch.types.push(optional)
    ensure = calls.demand-runtime-call
        - types.markup-host-decl.module
        - no-type
        - program.store-atom("ensure-markup-root")
        - mark
    scratch.types.rewind(mark)
    if ensure == no-instance || !raises-out(body, ensure)
        decline(body)
        = false
    conversions.convert(body, body, content, host, .reason-markup-host)
    conversions.convert(body, body, batch-type(), optional, .reason-markup-root)
facts.region-roots += RegionRoot(instance, body, slot, batch-type(), ensure)
= true

────────────────────
_ do read-arms
    - id SyntaxId

` The conditions of a markup branch region read in turn, each tested as the condition of an
` `if` is, until one holds, and the subject of an arm written with a pattern, against which the
` pattern is tested (`test-pattern`); or the subject of a match region, against which each
` arm's pattern is tested in turn (`read-patterns`); or the name the parameter of a slot outlet
` that is a region gives, which must read the row's item as a getter, as the reference's
` `markupSlotOutletRebuildsOnArgument` asks.
do match? tree.nodes[id]
    | .node-match-expression(row)
        read-patterns(id, row.subject)
        =
    | .node-markup-slot-parameter(row)
        . value = infer(row.name)
        if value != invalid-type && not-row-item && !reads-getter(row.name)
            decline(row.name)
        .. not-row-item = facts.plan-of(instance, row.name) != .plan-row-item
        =
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                . subject = tree.matched-subject(row.condition)
                . held = infer-unprojected(subject)
                if held == no-type
                    decline(subject)
                if held != no-type && held != invalid-type && !test-pattern(pattern, held)
                    =
            else if row.condition != 0
                tested-match = tree.tested(row.condition)
                note-truthiness(row.condition, row.condition, infer(row.condition))
                tested-match = 0
            next = row.next
    arm = next

────────────────────
_ do read-patterns
    - id SyntaxId
    - subject SyntaxId

` The subject of a markup match region, read where the region is made and again by the function
` that selects its arm, against which each arm's pattern is tested in turn, binding nothing, as
` the reference's `markupMatchActiveArm` tests them. A pattern that tests with an expression of
` its own (`| x if x > 0`) has no shape here; one that can not match the subject is never tested.
. held = infer-unprojected(subject)
if held == no-type
    decline(subject)
if held == no-type || held == invalid-type
    =
for arm in tree.region-arms(id)
    if !test-pattern(arm, held)
        =

────────────────────
_ do test-pattern Bool
    - arm SyntaxId
    - held TypeId

` Tests the pattern of an arm of a match against a subject of a type, binding nothing. One that
` can not match is never tested; one that tests with an expression of its own has no shape here,
` and is declined, which answers false.
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if !tree.tests-plainly(row.pattern)
            decline(arm)
            = false
        if !pattern-is-else(row.pattern) && !pattern-possible(row.pattern, held)
            facts.set-plan(instance, arm, .plan-never)
        else
            check-pattern(row.pattern, held)
= true

────────────────────
_ do bind-arm Bool
    - arm SyntaxId

` The subject of the match an arm of a markup match region, or of a branch region written with
` a pattern, is one of, read again by the function that builds the arm, where a member of the
` region's host read by its name alone is read from the host, kept where the region was made, and
` the arm's pattern matched against it, binding `it` and the names the pattern declares, as the
` reference's `markupCompileMatchedArm` does. False, once declined, where that has no shape here.
. subject = tree.matched-subject(tree.arm-match(arm))
. resolution = bindings.resolution-of(frame.binding, tree.arm-site(arm))
if subject == 0 || resolution.kind != .resolve-slot
    decline(arm)
    = false
content-blocks += 0
content-parents += frame.slot-type(resolution.slot)
content-names += false
. held = infer-unprojected(subject)
content-blocks.pop()
content-parents.pop()
content-names.pop()
if held == no-type
    decline(subject)
if held == no-type || held == invalid-type
    = false
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if !pattern-is-else(row.pattern) && !pattern-possible(row.pattern, held)
            facts.set-plan(instance, arm, .plan-never)
            = true
        . it = arm-slot(arm, .slot-it)
        if it != no-slot
            frame.assign(it, held)
        check-pattern(row.pattern, held)
        . passed = passed-type(row.pattern, held)
        if it != no-slot && passed != held
            frame.assign(it, passed)
= true

────────────────────
_ do check-arm
    - body SyntaxId

` The function that builds an arm of a markup branch region: given the region, whose type is
` the host's content, it runs the arm's body as content of the region, under the styles, the
` rules written in rules, with the state cells it keeps (`take-scope`), and the batch in force
` where the region is written, as `arm-root` says. That of an arm of a match region first
` matches the arm's pattern against the subject (`bind-arm`). That of a slot outlet that is a
` region mounts the outlet's node as the region's content.
prepare()
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
. content = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, body)
if resolution.kind != .resolve-slot || content == no-type
    decline(body)
    finish-errors(frame)
    close()
    =
frame.assign(resolution.slot, content)
. styled = markup-styles.length
if outer
    for style in outer.markup-styles
        markup-styles += style
    outer!.seen-sheets(markup-sheets, sheet-levels)
    sheets-given = outer!.sheets-known()
    for use in outer!.rule-scopes
        rule-scopes += take-scope(use)
    scopes-given = outer!.scopes-known()
    layer-given = outer!.markup-layer()
. rooted = if outer then outer.region.batch else false
if rooted && tree.builds-outlet-alone(body)
    facts.region-roots += RegionRoot(instance, body, outer!.region.root, batch-type(), no-instance)
else if rooted && !arm-root(body, content, outer!.region.root)
    finish-errors(frame)
    close()
    =
. matched = tree.body-arm(body)
if matched != 0 && !bind-arm(matched)
    finish-errors(frame)
    close()
    =
content-blocks += body
content-parents += content
content-names += false
batched += rooted
if tree.nodes[body] is .node-slot-outlet
    . produced = check-statement(body, Want().adding(.want-content-line))
    link-content(body, produced, content)
else
    check-statement(body)
batched.pop()
content-blocks.pop()
content-parents.pop()
content-names.pop()
while markup-styles.length > styled
    markup-styles.pop()
finish-errors(frame)
close()

────────────────────
_ do loop-source LoopSource
    - id SyntaxId
    - container SyntaxId
    - read TypeId

` The container of a markup loop region as the region's source, as the reference's
` `markupLoopSource` takes it: a concrete `Collection` as it is, made a region by
` `markup-create-collection-region`, and else one that supports a `Broadcastable` or an `Iterable`,
` in that order, converted to that interface at the container, made one by
` `markup-create-broadcastable-region` or `markup-create-iterable-region`. The item is the
` interface's, or where that is not concrete the container's own first, as the reference's
` `markupLoopItemType` takes it. One that is an `Indexable` alone is the reference's error, as is
` one that is a `Collection` but no concrete one, and one that supports none of these. One that
` converts to a `Collection`, which the reference gives the region unconverted, and an `Iterable`
` that is `Closable`, which the reference gives the region to close, have no shape here yet. An
` optional container is read by the type it holds, and given to the region as it is where that
` type is the interface or derives from it, and else converted to the interface made optional.
. none = LoopSource(invalid-type, no-type, "")
. optional = types.intrinsic-of(read) == .optional
. shape = if optional then types.optional-inner(read) else read
if types.intrinsic-of(shape) == .interface && indexable
    frame.diagnose(id, .stated, program.store-atom("Markup loop cannot observe Indexable sources because Indexable has no mutation events"))
    = none
.. indexable = same-decl(class-ref(types, shape), types.indexable-decl)
. supports = derived-interface(shape, types.collection-decl)
. kind = "collection"
if supports != no-type && types.intrinsic-of(shape) == .interface
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Markup loop requires a concrete Collection source")
    = none
. collects = supports != no-type
if supports == no-type && supported(shape, types.collection-decl) == no-type
    supports = supported(shape, types.broadcastable-decl)
    kind = "broadcastable"
if supports == no-type && supported(shape, types.collection-decl) == no-type
    supports = supported(shape, types.iterable-decl)
    kind = "iterable"
    if supports != no-type && derived-interface(shape, types.closable-decl) != no-type
        decline(id)
        = none
if supports == no-type
    if collection-shape || broadcasts || supported(shape, types.iterable-decl) != no-type
        decline(id)
    else if supported(shape, types.indexable-decl) != no-type
        frame.diagnose(id, .stated, program.store-atom("Markup loop cannot observe Indexable sources because Indexable has no mutation events"))
    else
        frame.diagnose
            - id
            - .stated
            - program.store-atom
                - "Markup loop source must be collection, broadcastable, or iterable"
    .. collection-shape = supported(shape, types.collection-decl) != no-type
    .. broadcasts = supported(shape, types.broadcastable-decl) != no-type
    = none
. item = first-arg(supports)
if item == no-type || item == invalid-type || types.completions[item].has-variables
    item = first-arg(shape)
if item == no-type || item == invalid-type || types.completions[item].has-variables
    decline(id)
    = none
if collects || (optional && derives)
    = LoopSource(item, read, kind)
.. derives = derived-interface(shape, if kind == "broadcastable" then types.broadcastable-decl else types.iterable-decl) != no-type
. given = supports
if types.completions[given].has-variables
    given = types.well-known-type-of
        - "core/stream"
        - if kind == "broadcastable" then "Broadcastable" else "Iterable"
        - item
if given == invalid-type
    = none
if optional
    given = types.optional-of(given)
if conversions.convert(container, container, read, given, .reason-argument) == invalid-type
    = none
= LoopSource(item, given, kind)

────────────────────
_ do check-row
    - body SyntaxId

` The function that builds a row of a markup loop region: given the row's item, which the name
` the loop's header writes, `each` and `it` hold, it runs the loop's body as the body of a
` function, or, where the row is a region of its own (`row-region`), as content of the region
` it is given after the item, as an arm's body runs, under the styles, the rules written in rules, with the state cells it keeps
` (`take-scope`), and the batch in force where the region is written, and gives
` what the body gives, converted to the content of the region's host at the body, as the
` reference casts it. An element that binds a slot written as a line of the body is the
` reference's error.
prepare()
. content = if outer then outer.region.content else no-type
. item = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, body)
if resolution.kind != .resolve-slot || content == no-type || item == no-type
    decline(body)
    finish-errors(frame)
    close()
    =
. regioned = tree.row-region(body)
. returned = if regioned then types.void-type else content
instances.set-returns(instance, returned, returned, .return-declared)
. lines [SyntaxId]
do match tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            lines += statement
    ??
        lines += body
for line in lines
    do match? tree.nodes[line]
        | .node-markup(element)
            if element.slot-binding != 0
                frame.diagnose
                    - element.slot-binding
                    - .stated
                    - program.store-atom("A slot is filled by a line of the element's body, or by a line of an arm of an if or match there")
                finish-errors(frame)
                close()
                =
frame.assign(resolution.slot, item)
if regioned
    . held = bindings.resolution-of(frame.binding, row-loop(body))
    if held.kind != .resolve-slot
        decline(body)
        finish-errors(frame)
        close()
        =
    frame.assign(held.slot, content)
if reads-eager-getter(body) && !is-row-item(resolution.slot, item)
    decline(body)
    finish-errors(frame)
    close()
    =
. styled = markup-styles.length
if outer
    for style in outer.markup-styles
        markup-styles += style
    outer!.seen-sheets(markup-sheets, sheet-levels)
    sheets-given = outer!.sheets-known()
    for use in outer!.rule-scopes
        rule-scopes += take-scope(use)
    scopes-given = outer!.scopes-known()
    layer-given = outer!.markup-layer()
. rooted = if outer then outer.region.batch else false
if rooted && regioned && !arm-root(body, content, outer!.region.root)
    finish-errors(frame)
    close()
    =
if rooted && !regioned
    facts.region-roots += RegionRoot(instance, body, outer!.region.root, batch-type())
batched += rooted
if regioned
    content-blocks += body
    content-parents += content
    content-names += false
    check-statement(body)
    content-blocks.pop()
    content-parents.pop()
    content-names.pop()
    batched.pop()
    while markup-styles.length > styled
        markup-styles.pop()
    finish-errors(frame)
    close()
    =
value-syntax = body
. value = check-statement(body)
batched.pop()
while markup-styles.length > styled
    markup-styles.pop()
if value != invalid-type && value != no-type
    conversions.convert(body, value-syntax, value, content, .reason-return)
finish-errors(frame)
close()

────────────────────
_ do reads-eager-getter Bool
    - body SyntaxId

` Whether the body of a row declares a getter that is not lazy, which the binder finds in the
` row of any keyed loop region. The reference reads such a local as a getter only where the
` row is given a `MarkupRowItem`.
do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            do match? tree.nodes[line]
                | .node-declare(declared)
                    if !declared.is-lazy && declares-getter(declared.left)
                        = true
= false

────────────────────
_ do check-key
    - clause SyntaxId

` The function that keys a row of a markup loop region: given the row's item, which the name the
` loop's header writes, `each` and `it` hold, it gives the value of the `keyed by` clause,
` converted to a `String` at the value, as the reference casts it. That of a `when` clause tests
` the row's item, given as the row's function is, as a condition, and the markup runtime runs it
` in a live action of the row's own, which what it reads with `#` notes (`watched`).
prepare()
. item = instances.argument-type(instance, 0)
. resolution = bindings.resolution-of(frame.binding, clause)
. expr SyntaxId = 0
. tests = false
do match? tree.nodes[clause]
    | .node-clause(row)
        expr = row.expr
        tests = row.op == .when-clause
if resolution.kind != .resolve-slot || item == no-type || expr == 0
    decline(clause)
    finish-errors(frame)
    close()
    =
. answer = if tests then types.bool-type else types.string-type
instances.set-returns(instance, answer, answer, .return-declared)
frame.assign(resolution.slot, item)
. value = infer(expr)
if value != invalid-type && value != no-type
    conversions.convert
        - tree.return-site(expr)
        - expr
        - value
        - answer
        - .reason-return
        - true
        - true
finish-errors(frame)
close()

────────────────────
_ do read-row-item TypeId
    - id SyntaxId
    - held TypeId

` A name the row of a keyed markup loop region gives its item by, where the row's function is
` given a `MarkupRowItem`: the reference reads the holder's `item` by it, tracked. In the value
` of an assignment written with an operator other than `=`, which nothing runs again, the read
` is a plain one, as it is in the value of a declaration.
. name = program.store-atom("item")
. place = property-named(held, name)
if !place
    decline(id)
    = invalid-type
if !tree.in-operator-value(id)
    track-read(id, held, name)
facts.set-plan(instance, id, .plan-row-item)
facts.row-item-reads += RowItemRead(instance, id, held)
= types.properties[place].type

────────────────────
_ do read-getter TypeId
    - id SyntaxId
    - slot SlotId

` A read of a local of a row of a markup loop region that the reference reads as a getter: the
` value its declaration writes, typed here, where it is made again, and read where the
` outermost such read is, which `reading.getter` keeps while it is. A second read in one
` function, and a local written with a type, have no shape here yet.
if getter-reads.find(slot) != null
    decline(id)
    = invalid-type
getter-reads += slot
do match? tree.nodes[bindings.slots[slot].getter]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.left]
            | .node-type-capture(capture)
                if capture.type != 0
                    decline(id)
                    = invalid-type
        . around = reading
        if reading.getter == 0
            reading = reading.getter = id
        . value = infer(declaration.right)
        reading = around
        if value != invalid-type && value != no-type
            facts.set-plan(instance, id, .plan-getter)
        = value
decline(id)
= invalid-type

────────────────────
_ do is-row-item Bool
    - slot SlotId
    - held TypeId

` Whether a local is the argument of the function that builds a row of a markup loop region,
` holding a `MarkupRowItem`.
if bindings.slots[slot].kind != .slot-argument || not-row-item
    = false
.. not-row-item = !same-decl(class-ref(types, held), types.markup-row-item-decl)
. scope = bindings.scopes[bindings.slots[slot].scope]
if scope.kind != .scope-nested
    = false
. decl = nested-decl-of(scope.syntax)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .row-decl || (fn.kind == .key-decl && tree.tests-row(fn.syntax))
= false

────────────────────
_ do note-named
    - statement SyntaxId
    - held TypeId

` A markup element a block declares a name for, in a function run on an object whose class
` has a property of that name: once the element's line has run, the reference stores in the
` property what the name then holds, as `named-place` says.
do match? tree.nodes[statement]
    | .node-markup(row)
        . place = named-place(statement, row.id, held)
        if place
            facts.note-named-store(NamedStore(instance, statement, place))

────────────────────
_ do named-place U32?
    - site SyntaxId
    - name SyntaxId
    - held TypeId

` The property of the class of the object a function is run on that the name of a markup
` element names, which the reference stores what the name holds in, converted at `site` as a
` value the property is given; or none. A property that the markup written in a class declared
` for an element is stored only by that markup, and a lazy one is given its value as an
` assignment gives it. A store that has no shape here is declined: in a function written in
` another, but one that builds a slot or gives a name its object (`in-slots`), or of a
` property not stored in the object, private to another module, or an array.
. self = frame.self-type
if self == no-type || self == invalid-type || types.intrinsic-of(self) != .class || lacks-self()
    = null
. text = identifier-name(tree, name)
. place = property-named(self, text) if text
if !place
    = null
. property = types.properties[place]
. ref = declaring-decl(types, property)
. member = owner-property(program, ref.module, ref.decl, text!)
do match? program.modules[ref.module].decls[member]
    | .decl-property(declared)
        if member != 0 && declared.element != 0
            . owner = program.modules[ref.module]
            . fills = false
            do match? owner.decls[ref.decl]
                | .decl-class(class)
                    fills = ref.module == (module) && class.content-function == written-decl()
            if !fills
                = null
. type = property.type
if type == no-type
    type = demand-member(property, self, text!)
. kept = property.storage-kind == .storage-eager || property.storage-kind == .storage-lazy
. stored = kept && type != no-type && type != invalid-type
if !in-slots() || !stored || is-hidden(property, text!, .setter-decl) || is-array-value(type)
    decline(site)
    = null
if conversions.convert(site, site, held, type, .reason-declaration, true, true) == invalid-type
    = null
. written = panics.property-of(self, text!)
if written
    panics.note-write(instance, written)
= place as U32

────────────────────
_ in-slots Bool

` Whether this function is no function written in another, or one written in such a one that
` builds a slot, gives a markup element's name its object, or builds a row of a markup loop
` region or an arm of a branch region, which run on the same object.
if builds-in-place() then outer != null && outer.in-slots() else outer == null

────────────────────
_ builds-in-place Bool

` Whether this function builds a slot, gives a markup element's name its object, or builds a row
` of a markup loop region or an arm of a branch region, for the function it is written in.
kind == .slot-decl || kind == .binder-decl || kind == .row-decl || kind == .branch-arm-decl

.. kind = frame.declaration.kind

────────────────────
_ written-decl DeclId

` The function this one is, or that it is written in where it builds what it is written in
` builds (`builds-in-place`).
if builds-in-place() && outer then outer.written-decl() else frame.decl

────────────────────
_ is-placed Bool
    - slot SlotId

` Whether the local declared for a markup element's name is given the element's object where
` the element is written, which no block makes where it starts.
(bindings.slots[slot].flags /and/ SlotFlag.slot-placed) != 0

────────────────────
_ reads-before-made Bool
    - read SyntaxId
    - slot SlotId

reads-before-placing(read, slot) || (!(outer && frame.is-captured(slot)) && frame.slot-type(slot) == no-type)

────────────────────
_ reads-before-placing Bool
    - read SyntaxId
    - slot SlotId

|? frame.declaration.kind != .slot-decl
    false
??
    element >= range.start && element < range.start + range.count && after-read

.. element = bindings.slots[slot].group
.. range = frame.declaration.subtree
.. after-read = tree.subtree-start(element) > read

────────────────────
_ do infer-index Found
    - id SyntaxId
    - object-syntax SyntaxId
    - key-syntax SyntaxId
    - is-optional Bool
    - want Want

. object-found = infer-found(object-syntax, Want().adding(.want-event))
. object = object-found.type
if object-found.event != U32.max
    = address-event(id, key-syntax, is-optional, found-events[object-found.event], want)
. own = object-found.link
. key = infer(key-syntax)
if object == invalid-type || key == invalid-type
    = Found(invalid-type)
. sized = sized-array(id, object, key-syntax, key)
if sized != no-type
    = Found(sized)
. form = if is-optional then note-chain(id, id, object) else ChainForm.chain-plain
if form == .chain-absent || absent-after(object-syntax, object)
    = Found(types.null-type)
. optional = form == .chain-tested
. receiver = link-receiver(object-syntax, object, own, optional)
. chained = (optional || optional-chained(object-syntax)) && types.is-optional(object)
. pointee = cpointer-item(receiver)
if pointee == types.void-type
    frame.diagnose(id, .stated, program.store-atom("Void has no physical address"))
    = Found(invalid-type)
if pointee != no-type
    facts.set-plan(instance, id, .plan-item)
    = Found(if chained then types.optional-of(pointee) else pointee).linking(pointee)
. field = tuple-field(receiver, key-syntax)
. positional = field != no-type
if field == no-type
    field = view-index(receiver, key-syntax)
    if field != no-type
        plan-view(id, eager-slot(row-struct-of(receiver), key-syntax))
if field == no-type
    field = aggregate-field(receiver, key-syntax, key, types.index-op-atom!)
    positional = field != no-type
if field != no-type
    . read = if chained then types.optional-of(field) else field
    if positional
        note-field(id, receiver, key-syntax)
        facts.set-node-type(instance, id, read)
    = Found(read).linking(field)
. cell = view-cell(id, object-syntax, receiver, key-syntax, key)
if cell != no-type
    = Found(if chained && cell != invalid-type then types.optional-of(cell) else cell).linking(cell)
. chosen = selection-key(receiver, key)
. diagnosed = facts.diagnostics.length
. first-call FactId = facts.calls.length as FactId
. tabled = is-table-view(receiver)
. result = calls.operator-call
    - id
    - receiver
    - types.index-op-atom!
    - key-syntax
    - chosen
    - tabled
    - object-syntax
if result == invalid-type
    restate-index(diagnosed, id, receiver, key-syntax)
    = Found(result)
if !plan-table-index(id, object-syntax, receiver, key-syntax, key, result)
    = Found(invalid-type)
if tabled && !facts.answers-in-place(instance, id)
    frame.forget-members()
if !optional
    calls.plan-array-item(id, key, first-call, result)
= Found(if chained then types.optional-of(result) else result).linking(result)

────────────────────
_ link-receiver TypeId
    - object-syntax SyntaxId
    - object TypeId
    - own TypeId
    - is-optional Bool

` What a read, an index or a call reads from. A link of an optional chain written after `?`
` reads from what the optional before it holds. A link written with no `?` after another
` link reads from what that link gives by itself, which the chain holds in no optional
` between its links: `own`, what typing the link before found it to give (`Found.link`).
` Anything else reads from the value as it is.
|? object == invalid-type || object == no-type || !types.is-optional(object)
    object
|? is-optional
    types.optional-inner(object)
|? !optional-chained(object-syntax)
    object
??
    if own != no-type then own else types.optional-inner(object)

────────────────────
_ do note-field
    - id SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId

` Records which stored field of a tuple or struct a constant index names, as the constant of
` the node that reads or assigns it. The index one past the last field names the place a new
` field would take. A tuple with no name stores every field it has, in order, so the index
` is the field.
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . wanted = parse-integer-literal(row.value).value
        . range = types.completions[receiver].properties
        if types.is-plain-tuple(receiver)
            if wanted < range.count
                . held = types.properties[(range.start + wanted) as Index].slot as U64
                facts.set-constant(instance, id, ConstantFact(held, 0, null, false), .plan-field)
            else if wanted == range.count
                facts.set-constant(instance, id, ConstantFact(wanted, 0, null, false), .plan-field)
            =
        . position U64
        . place U64
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind != .storage-eager
                continue
            if position == wanted
                place = property.slot
                break
            position += 1
            place = (property.slot as U64) + 1
        if position == wanted
            facts.set-constant(instance, id, ConstantFact(place, 0, null, false), .plan-field)

────────────────────
_ do restate-index
    - diagnosed Size
    - id SyntaxId
    - receiver TypeId
    - key-syntax SyntaxId

` A tuple or struct with no index operator of its own is indexed by position, which must be a
` constant that names one of its fields.
if tuple-arity(receiver) == U32.max || column-receiver || indexes-itself(receiver)
    =
.. column-receiver = is-column-receiver(types.intrinsic-of(receiver))
. message = if literal-key then "Index out of bounds" else "Value has no constant form"
    .. literal-key = tree.is-integer-literal(key-syntax)
facts.restate(diagnosed, instance, id, .illegal-operation, .stated, program.store-atom(message))

────────────────────
_ do selection-key TypeId
    - receiver TypeId
    - key TypeId

` A table selects rows by an array of indices as it does by an immutable array of them.
. kind = types.intrinsic-of(receiver)
if kind != .table && kind != .immutable-table
    = key
do match? types.rows[key]
    | .type-class(row)
        if same-decl(DeclRef(row.module, row.decl), types.array-decl)
            . mark = scratch.types.mark
            for position in 0 .. < row.args.count
                scratch.types.push(types.child-type(row.args, position))
            . owner = types.immutable-array-decl
            = types.intern-class(owner.module, owner.decl, mark)
= key

────────────────────
_ do tuple-field TypeId
    - receiver TypeId
    - key-syntax SyntaxId

. fields = RowRange'TypeId()
do match? types.rows[receiver]
    | .type-tuple(row)
        fields = row.fields
if fields.count == 0
    = no-type
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if !literal.negative && !literal.overflow && literal.value < fields.count
            = types.child-type(fields, literal.value as U32)
= no-type

────────────────────
_ do check-task
    - id SyntaxId

` A task spawned where its block is written. A body that captures a local is given an object the
` collector owns where it is spawned, and a panic a handler takes is moved into the collector's
` heap.
. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        . mask = callee-effects(frame, module, nested.decl)
        . none = scratch.no-types
        . callee = instances.intern(module, nested.decl, no-type, mask, instance, none, none, false)
        if instances.rows[callee].state == .instance-unstarted
            facts.task-bodies += callee
            run-within(callee, this)
        . owned = owns-task(id)
        if nested.captures.count != 0 || tree.has-handlers(id) || owned
            frame.check-allocates(id)
        . form CallForm = if owned then .call-owned-task else .call-task
        facts.record-call(instance, id, callee, form, scratch.no-fills, false)
        demand-panic-report()
        =

────────────────────
_ do owns-task Bool
    - task SyntaxId

` Whether the task spawned at a node is owned, cancelled as its owner closes or its case exits:
` one not marked `@detached`, spawned in markup being built, by its innermost element where that
` is an object of a class, or else by the activation of a case the binder gave it to
` (`activation-tasks`), or else where a subscription would be owned (`is-owner`), by the receiver
` where that is an object of a class.
do match? tree.nodes[task]
    | .node-do-task-block(row)
        =? false if row.detached
        =? types.intrinsic-of(content-parents[content-parents.length - 1]) == .class if content-parents.length != 0
        =? true if bindings.activation-tasks(frame.binding, task, program.store-atom("(tasks)")) != no-slot
        =? false if !is-owner()
        = types.intrinsic-of(frame.self-type) == .class
= false

────────────────────
_ do class-property DeclId
    - ref DeclRef
    - name Atom

` The property of a name a class declares, or none.
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(class)
        for member in owner.members-named(class.members, name)
            do match? owner.decls[member]
                | .decl-property(row)
                    if row.name && row.name == name
                        = member
= 0

────────────────────
_ do declared-value SyntaxId
    - owner ModuleId
    - property DeclId

` The value a property of a module declares, or none.
if property == 0
    = 0
do match? program.modules[owner].decls[property]
    | .decl-property(row)
        = row.value
= 0

────────────────────
_ do report-pattern-on
    - pattern SyntaxId

` Reports a stream pattern written on a stream a subscription is given, which no match reads.
. text = "A stream pattern matches items it reads with \"in\", not items a subscription with \"on\" is given; write \"in\" in place of \"on\""
frame.diagnose(pattern, .stated, program.store-atom(text))

────────────────────
_ do check-worker
    - id SyntaxId
    - worker SyntaxId

` A task forked onto a named target runs on a worker. The target is typed before the task, as
` the reference reads it where it still knows what the flow before the task knows of properties.
. target = infer(worker)
if target == invalid-type || target == no-type
    =
. named = match types.rows[target]
    | .type-class(row)
        types.worker-decl.refers-to(row.module, row.decl)
    ??
        false
if !named
    frame.diagnose(id, .stated, program.store-atom("Fork target is not a Worker"))

────────────────────
_ do runs-class Bool
    - owner DeclId

` Whether an instance is a function a class of the module declares, or has an object of the
` class or of one derived from it for its receiver.
. decls = program.modules[module].decls
for instance in 0 .. < instances.length
    . row = instances.rows[instance]
    if row.module == module
        do match? decls[row.decl]
            | .decl-function(fn)
                if fn.owner == owner
                    = true
    . level TypeId? = row.self-type if row.self-type != no-type
    while level && types.intrinsic-of(level) == .class
        . ref = class-ref(types, level)
        if ref.module == module && ref.decl == owner
            = true
        level = types.base-of(level)
= false

────────────────────
_ do probe-runtime-call InstanceId
    - probes ModuleId
    - name String
    - arguments [TypeId]

. mark = scratch.types.mark
for argument in arguments
    scratch.types.push(argument)
. callee = calls.demand-runtime-call(probes, no-type, program.store-atom(name), mark)
scratch.types.rewind(mark)
= callee

────────────────────
_ optional-chained Bool
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-get-expression(row)
        chains-at(syntax, row.is-optional) || optional-chained(row.object)
    | .node-index-expression(row)
        chains-at(syntax, row.is-optional) || optional-chained(row.object)
    | .node-style-read-expression(row)
        chains-at(syntax, row.is-optional) || (row.object != 0 && optional-chained(row.object))
    | .node-markup-read-expression(row)
        chains-at(syntax, row.is-optional) || (row.object != 0 && optional-chained(row.object))
    | .node-call-expression(row)
        optional-chained(row.callable)
    ??
        false

────────────────────
_ chains-at Bool
    - link SyntaxId
    - is-optional Bool

is-optional && facts.chain-form(instance, link) != .chain-plain

────────────────────
_ absent-after Bool
    - object-syntax SyntaxId
    - object TypeId

object == types.null-type && optional-chained(object-syntax)

────────────────────
_ do note-chain ChainForm
    - id SyntaxId
    - link SyntaxId
    - receiver TypeId

. form = chain-form-of(receiver)
facts.record-chain(instance, id, link, form)
= form

────────────────────
_ chain-form-of ChainForm
    - receiver TypeId

|? receiver == types.null-type
    .chain-absent
|? types.is-optional(receiver)
    .chain-tested
??
    .chain-plain

────────────────────
_ do check-use TypeId
    - id SyntaxId
    - expr SyntaxId

` `use`, written as a value or as `do use`: the subject's `begin-using` gives the value, and its
` `end-using` is called where the block is left, the two calls recorded at the node in that
` order. A subject with no `begin-using` that closes gives itself, and `close`, the one call
` recorded, is called where the block is left. An error the call that ends the use raises
` leaves the function, as one a cleanup raises does.
cleans-up = true
. chain = tree.optional-chain-expr(expr)
. subject = if chain != 0 then infer(chain) else infer(expr)
if subject == invalid-type || subject == no-type
    decline(id)
    = invalid-type
if chain != 0
    facts.set-node-type(instance, expr, subject)
    if types.is-optional(subject)
        subject = types.optional-inner(subject)
types.optional-of(subject)
. used = protocol-member(subject, "begin-using", id)
if used == invalid-type
    if ending-member(subject, "close", id) == invalid-type
        . shown = type-short-name(types, subject)
        . text = "$shown cannot be used, as it has no \"begin-using\" and is not Closable; declare \"begin-using\" and \"end-using\", or implement Closable"
        frame.diagnose(id, .stated, program.store-atom(text))
        = invalid-type
    used = subject
else if ending-member(subject, "end-using", id) == invalid-type
    decline(id)
    = invalid-type
. slot = bindings.using-slot(frame.binding, id)
if slot != no-slot
    frame.assign(slot, types.optional-of(subject))
= if chain != 0 && !types.is-optional(used) then types.optional-of(used) else used

────────────────────
_ do ending-member TypeId
    - receiver TypeId
    - name String
    - site SyntaxId

` The method that ends a use, called as `protocol-member` calls one, whose errors leave the
` function.
. result = calls.protocol-getter(receiver, program.store-atom(name), site)
if result != invalid-type
    = result
= calls.protocol-call(receiver, program.store-atom(name), site, no-type, true).answer

────────────────────
_ do protocol-member TypeId
    - receiver TypeId
    - name String
    - site SyntaxId

. atom = program.store-atom(name)
. result = calls.protocol-getter(receiver, atom, site)
if result != invalid-type
    = result
= calls.protocol-call(receiver, atom, site).answer

────────────────────
_ do check-task-handlers
    - task SyntaxId

` The handlers written after a task's block run in the task, after its cleanups, when a panic
` of the type each names ends it, and bind that panic: each names `Panic` or a type derived
` from it, and takes no errors it replaced.
do match? tree.nodes[task]
    | .node-do-task-block(row)
        if row.catchers.count != 0
            frame.forget-members()
        for catcher in tree.children[row.catchers]
            do match? tree.nodes[catcher]
                | .node-catcher(handler)
                    if handler.previous.count != 0
                        frame.diagnose(catcher, .stated, program.store-atom("A task's handler replaces no errors"))
                    . named = tree.handled-type(handler.type)
                    if named != 0
                        . handled = types.evaluate-type(module, tree, named, frame.env)
                        if handled != invalid-type && !is-subtype(types, handled, types.panic-type)
                            frame.diagnose(named, .stated, program.store-atom("A task's handler takes a panic"))
                    check-pattern(handler.type, types.panic-type)
                    check-statement(handler.body)

────────────────────
_ do nested-decl-of DeclId
    - id SyntaxId

. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        = nested.decl
= 0

────────────────────
_ do intern-nested TypeId
    - decl DeclId

` The type of a closure this instance writes.
= types.intern-closure(module, decl, instance, instances.stable-keys[instance])

────────────────────
_ do demand-nested InstanceId
    - decl DeclId
    - argument TypeId
    - second TypeId = no-type

` The one instance of a generated closure, keyed under this instance like a lambda's: a
` comprehension's takes its container, a pipeline body its item, and a bullet list nothing.
` Its closure type is interned here, before its body is typed, so that the types of every
` closure a function writes are rowed in the order the function is typed.
intern-nested(decl)
. mask = callee-effects(frame, module, decl)
. mark = scratch.types.mark
if argument != no-type
    scratch.types.push(argument)
if second != no-type
    scratch.types.push(second)
. argument-span = scratch.types.since(mark)
. callee = instances.intern(module, decl, no-type, mask, instance, scratch.no-types, argument-span)
scratch.types.rewind(mark)
if instances.rows[callee].state == .instance-unstarted
    run-within(callee, this, true)
= callee

────────────────────
_ do list-of TypeId
    - item TypeId

. mark = scratch.types.mark
scratch.types.push(item)
. list = types.class-with-args(types.list-decl.module, types.list-decl.decl, mark)
types.complete(list)
= list

────────────────────
_ natural-item TypeId
    - source TypeId

` The item of the stream the reference reads a value through, as `record-stream-protocol`
` makes it, or none where it reads it through none.
|? source == no-type || source == invalid-type
    no-type
|? given != no-type
    first-arg(given)
|? source == types.string-type
    types.type-row(.char)
|? same-decl(ref, types.generator-decl) || (kind == .interface && cursor-iterable)
    first-arg(source)
|? kind != .class && kind != .struct && kind != .tuple && kind != .interface
    no-type
|? supported(source, types.byte-readable-decl) != no-type
    if decodable != no-type then first-arg(decodable) else types.type-row(.uint8)

    .. decodable = supported(source, types.decodable-decl)
|? indexable != no-type
    first-arg(indexable)
??
    if iterable != no-type then first-arg(iterable) else no-type

.. kind = types.intrinsic-of(source)
.. given = if kind == .class || kind == .interface then stream-support else no-type
.. ref = class-ref(types, source)
.. indexable = supported(source, types.indexable-decl)
.. iterable = supported(source, types.iterable-decl)
.. stream-support = supported(source, types.token-stream-decl)
.. cursor-iterable = same-decl(ref, types.cursor-iterable-decl)

────────────────────
_ supported TypeId
    - source TypeId
    - decl DeclRef

` The type of a declaration a value supports, as the reference finds the stream to read it
` through: the value's own, that of a class it derives from, or an interface any of them
` declares or one of those derives from; else what a converter any of them declares makes,
` of that declaration. None where it supports none.
if found != no-type then found else converted-class(source, decl)

.. found = derived-interface(source, decl)

────────────────────
_ do derived-interface TypeId
    - type TypeId
    - decl DeclRef

` The type of a declaration a type is, derives from, or declares as an interface, or one of
` those does, searched in that order, completing the type, which completes the classes above it.
if same-decl(class-ref(types, type), decl)
    = type
types.complete(type)
. base = types.base-of(type)
if base
    . found = derived-interface(base, decl)
    if found != no-type
        = found
for interface in types.interfaces-of(type)
    . found = derived-interface(interface, decl)
    if found != no-type
        = found
= no-type

────────────────────
_ do converted-class TypeId
    - type TypeId
    - decl DeclRef

` What a converter a type declares makes, where it is of a declaration, else what one a
` class it derives from or an interface it declares does, searched in that order, completing the
` type, which completes the classes above it.
. declared = relations.declared-converter(type, decl)
if declared != no-type
    = declared
types.complete(type)
. base = types.base-of(type)
if base
    . found = converted-class(base, decl)
    if found != no-type
        = found
for interface in types.interfaces-of(type)
    . found = converted-class(interface, decl)
    if found != no-type
        = found
= no-type

────────────────────
_ do first-set U32
    - id SyntaxId

` What the reference knows of the first item a stream pattern reads, as it works it out to
` choose among arms: 1 where it knows what that item may be, and 2 more where the pattern may
` read none. A call, a test of a type, a predicate or text found as the pattern runs is not
` known, and a lookahead reads none and is not known either.
do match? tree.nodes[id]
    | .node-stream-match(row)
        = first-set(row.pattern)
    | .node-stream-string(row)
        = if row.text.length == 0 then 3 else 1
    | .node-stream-any
        = 1
    | .node-stream-char-range
        = 1
    | .node-stream-and(row)
        . leading = first-set(row.left)
        if (leading /and/ 2) == 0
            = leading
        . following = first-set(row.right)
        = (leading /and/ following /and/ 1) /or/ (following /and/ 2)
    | .node-stream-or(row)
        . left = first-set(row.left)
        . right = first-set(row.right)
        = (left /and/ right /and/ 1) /or/ ((left /or/ right) /and/ 2)
    | .node-stream-unary(row)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = 2
        . item = first-set(row.operand) /and/ 1
        = if row.op == .one-or-more-op then item else (item /or/ 2)
    | .node-stream-length(row)
        do match? tree.nodes[row.min]
            | .node-integer-syntax(bound)
                . item = first-set(row.operand) /and/ 1
                = if parse-integer-literal(bound.value).value == 0 then (item /or/ 2) else item
    | .node-stream-capture(row)
        = first-set(row.pattern)
    | .node-stream-transform(row)
        if row.pattern != 0
            = first-set(row.pattern)
    | .node-stream-panic(row)
        = first-set(row.pattern)
= 0

────────────────────
_ optional-match-text String
    - form String

` The error for a stream pattern loop or pipeline whose matches give an optional value, which
` the values it gives can't hold, since none of them ends it.
"Stream pattern $form can't give an optional value; add an action that gives one"

────────────────────
_ do hands-off Bool
    - run InstanceId

` What a function gives the errors that leave it to where the reference keeps them from its
` caller: the global `unhandled-error` of core, typed, which holds a function that takes an
` `Error` and answers nothing, and read by the function as a checked read is, evaluated first
` where it has no value yet. Calling it may panic, as a call of any function value may. Says
` whether that is in place.
. module = class-ref(types, types.error-type).module
. decls = program.modules[module].decls
. name = program.store-atom("unhandled-error")
for position in 0 .. < decls.length
    do match? decls[position]
        | .decl-property(property)
            if property.owner == 0 && property.name && property.name == name
                . held = demand-property(module, position as DeclId)
                . fn = if held != invalid-type && held != no-type then held-row else no-type
                    .. held-row = function-row(types, held)
                if fn == no-type
                    = false
                do match? types.rows[fn]
                    | .type-function(row)
                        . answers = row.return-type != no-type && row.return-type != types.void-type
                        if row.is-c || answers || odd-signature || not-error
                            = false
                        .. odd-signature = row.errors.count != 0 || row.args.count != 1
                        .. not-error = types.child-type(row.args, 0) != types.error-type
                facts.unhandled-error = DeclRef(module, position as DeclId)
                facts.global-uses.append(GlobalUse(run, 0, module, position as DeclId))
                instances.mark-may-panic(run)
                = true
= false

────────────────────
_ is-owner Bool

` Whether what subscribes here is owned by an object: the markup element being built, the
` receiver of a method, or the object a class's section runs for. The reference gives such a
` subscription to the innermost element, or else to the object.
|? content-parents.length != 0
    types.intrinsic-of(content-parents[content-parents.length - 1]) == .class
??
    frame.self-type != no-type && frame.self-type != invalid-type && !lacks-self()

────────────────────
_ do closure-of-self TypeId

` The closure type of the nested function being typed, as the instance that writes it made it.
. enclosing = instances.rows[instance].enclosing
if enclosing == no-instance
    = no-type
= types.intern-closure(module, frame.decl, enclosing, instances.stable-keys[enclosing])

────────────────────
_ do hands-off-raising Bool
    - call FactId

` What the function being checked gives the errors of a call the compiler places in it to,
` where the call may raise: the global `unhandled-error` (see `hands-off`), and the function
` goes on. Says whether that is in place, or nothing needs it.
if call == no-fact || instances.signatures[facts.calls[call].callee].errors.count == 0
    = true
= hands-off(instance)

────────────────────
_ is-integer Bool
    - type TypeId

intrinsic-is-numeric(kind) && !intrinsic-is-float(kind) && kind != .cpointer

.. kind = types.intrinsic-of(type)

────────────────────
_ implements Bool
    - container TypeId
    - decl DeclRef

interface-of(container, decl) != no-type

────────────────────
_ iterable-item TypeId
    - container TypeId
    - decl DeclRef

if interface != no-type then first-arg(interface) else no-type

.. interface = interface-of(container, decl)

────────────────────
_ do interface-of TypeId
    - container TypeId
    - decl DeclRef

` The interface of a declaration a type is or implements, its own before its bases': of
` several a class implements, the last it declares, whose functions answer for the earlier
` ones', as the reference finds them by name.
. current = container
while true
    . interfaces = types.interfaces-of(current)
    if same-decl(class-ref(types, current), decl)
        = current
    . found = no-type
    for interface in interfaces
        if same-decl(class-ref(types, interface), decl)
            found = interface
    if found != no-type
        = found
    . base = types.base-of(current)
    if !base
        = no-type
    current = base

────────────────────
_ first-arg TypeId
    - type TypeId

match types.rows[type]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
_ do closure-type TypeId
    - id SyntaxId

. row = bindings.bindings[frame.binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == id
        for index in 0 .. < nested.captures.count
            if holds-tested(bindings.captures[nested.captures.start + index].slot)
                decline(id)
                = invalid-type
        if nested.captures.count != 0
            frame.check-allocates(id)
        = intern-nested(nested.decl)
decline(id)
= invalid-type

────────────────────
_ do note-case
    - site SyntaxId
    - about TypeId
    - name Atom

` Plans a node that names a case of a union as that case, by its number.
. completion = types.completion-of(about)
if completion.intrinsic != .union
    if facts.plan-of(instance, site) == .plan-case
        facts.set-plan(instance, site, .plan-none)
    =
for offset in 0 .. < completion.cases.count
    . fact = types.cases[completion.cases.start + offset]
    if fact.name && fact.name! == name
        facts.set-constant(instance, site, ConstantFact(offset, 0.0, null, false), .plan-case)
        =

────────────────────
_ do note-truthiness
    - site SyntaxId
    - condition SyntaxId
    - type TypeId
    - is-right Bool = false

` A value tested as a condition. One of a class or a text is asked whether it is empty, and
` the call is recorded at the site as the test: of the site's own value, or of an operand of
` the site when the condition is another node. `is-right` says the operand is the right one.
` A tuple, a struct, a table or a builder that says whether it is empty, as an array does, is
` asked too. A function value has no truth, nor has an object of a class, or a value of a tuple,
` a struct, a table or a builder, that does not say whether it is empty, which is reported at
` the site as `!` not defined for it. A value that may be an error, as `catch` gives, or a value
` of an interface has none either, which is reported at the condition with what to write
` instead.
forget-carried(condition)
if type == invalid-type || type == no-type
    =
. negation = program.store-atom("!")
if type == types.void-type
    frame.diagnose(site, .illegal-operation, negation, type)
    =
if types.intrinsic-of(type) == .union && !(all(types.cases-of(type)) • where !is-raised(each.type))
    . advice = "test it with \"is Error\", or take it apart with \"match\""
    frame.diagnose(condition, .stated, program.store-atom("A value that may be an error, as \"catch\" gives, has no truth; $advice"))
    =
. completion = types.completion-of(type)
if completion.intrinsic == .interface
    . shown = type-source(types, type)
    frame.diagnose(condition, .stated, program.store-atom("$shown has no truth to test; read the values it gives instead"))
    =
if completion.intrinsic == .closure || completion.intrinsic == .binding
    frame.diagnose(site, .illegal-operation, negation, type)
    =
. valued = completion.intrinsic == .tuple || completion.intrinsic == .struct || held
    .. held = completion.intrinsic == .table || completion.intrinsic == .immutable-table || completion.intrinsic == .array-builder
if completion.intrinsic != .class && completion.intrinsic != .string && !valued
    =
if completion.intrinsic == .class && completion.is-builtin
    =
if (valued || completion.intrinsic == .class) && calls.demand-method(type, negation) == no-instance
    frame.diagnose(site, .illegal-operation, negation, type)
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. first FactId = facts.calls.length as FactId
calls.method-call(site, condition, type, negation, arguments)
facts.mark-truth(instance, site, first, site != condition, is-right)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do is-super-syntax Bool
    - id SyntaxId

do match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, id)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == .slot-super
= false

────────────────────
_ do infer-symbol TypeId
    - id SyntaxId
    - name Atom

` A case named by its symbol alone, of the type its name alone gives. Where no type the module
` can name has it, it is of one of the program's that has it until the type expected of it
` settles it (`leave-unfound`), and where none has it, it is not found.
. owner = anonymous-symbol(id, name)
if owner == no-type
    owner = symbol-class(types, module, name)
if owner != invalid-type
    note-enum-case(owner, name, id)
    = owner
owner = program-symbol-class(types, name)
if owner == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Case not found"))
    = invalid-type
note-enum-case(owner, name, id, false)
calls.leave-unfound(id)
= owner

────────────────────
_ do infer-armed-symbol TypeId
    - id SyntaxId
    - name Atom

` A case named by its symbol alone that gives an arm of a match its value: of the type expected
` of the match where it has the case or another that converts to it does (`contextual-symbol`),
` as the reference casts each arm to that type, else as any other.
. owner = contextual-symbol(types, relations, arming.expected, name, module)
if owner == invalid-type
    = infer-symbol(id, name)
note-enum-case(owner, name, id)
note-unsettled(id, arming.expected)
= owner

────────────────────
_ do symbol-sharers
    - expr SyntaxId
    - owners [TypeId]

` The types the module can name that have the case an expression names by its symbol alone,
` where no union of anonymous cases has it: none for any other expression.
. name = tree.symbol-of(expr)
if !name
    =
. unions [TypeId]
. labels [Atom]
symbol-unions(name, unions, labels)
if unions.length == 0
    symbol-owners(types, module, name, owners)

────────────────────
_ do shared-symbol Bool
    - expr SyntaxId

` Whether an expression names a case by its symbol alone that several types the module can name
` have, where no union of anonymous cases has it.
. owners [TypeId]
symbol-sharers(expr, owners)
= owners.length > 1

────────────────────
_ do loose-symbol Bool
    - expr SyntaxId

` Whether an expression names a case by its symbol alone that several types have
` (`shared-symbol`), typed as the one its name alone gives: as the reference leaves it, of none
` of them until a cast settles it.
. owners [TypeId]
symbol-sharers(expr, owners)
= owners.length > 1 && facts.node-type(instance, expr) == owners[owners.length - 1]

────────────────────
_ do note-loose
    - expr SyntaxId

` Notes a case named by its symbol alone that is used with no cast to settle which type's it is,
` to report as the reference reports one it never casts (`settle-later`).
if loose-symbol(expr)
    calls.settle-later(expr, tree.symbol-of(expr)!)

────────────────────
_ do note-unsettled
    - expr SyntaxId
    - expected TypeId
    - explicit Bool = false

` Notes a case named by its symbol alone that a cast to the type expected of it leaves of no one
` type (`keeps-symbol`).
. name = tree.symbol-of(expr)
if name && calls.keeps-symbol(expr, facts.node-type(instance, expr), expected, name, explicit)
    note-loose(expr)

────────────────────
_ argument-shape CallArgument
    - name Atom?
    - optional Bool
    - expr SyntaxId

CallArgument(name, optional, false, false, false, symbol, conversions.literal-of(expr), other)

.. chosen = symbol-choice(expr)
.. symbol = if chosen != 0 then tree.symbol-of(chosen) else tree.argument-symbol(expr)
.. other = if chosen != 0 then tree.symbol-of(tree.other-side(expr)) else null

────────────────────
_ do symbol-choice SyntaxId
    - expr SyntaxId

do match? tree.nodes[expr]
    | .node-binary-expression(row)
        if row.op == .else-op && tree.symbol-of(row.rhs)
            do match? tree.nodes[row.lhs]
                | .node-binary-expression(side)
                    . type = facts.node-type(instance, row.rhs)
                    . agrees = type != invalid-type && type == facts.node-type(instance, side.lhs)
                    if side.op == .if-op && tree.symbol-of(side.lhs) && agrees
                        = side.lhs
= 0

────────────────────
_ do note-symbol-arm
    - about TypeId
    - arm SyntaxId

facts.replace-node-type(instance, arm, about)
note-enum-case(about, tree.symbol-of(arm)!, arm)

────────────────────
_ declares-error Bool
    - declared RowRange'TypeId
    - error TypeId

some(0 .. < declared.count) • where is-subtype(types, error, types.child-type(declared, each))

────────────────────
_ do run-within [Narrowed]
    - callee InstanceId
    - around Checker
    - nested Bool = false

` Types an instance written in another under the checker `around` of that one, in place where
` `nested`, as a closure, a task, a region or a body typed in place is. Answers what a region's
` body left the locals it captures as (`region-left`), which holds until another checker is made.
. checker = checker-for(session, callee, around, false, nested)
checker.run()
checker.retire()
= checker.region-left

────────────────────
_ do settled Checker
    - enclosing InstanceId

` A checker for an instance a closure was written in that has finished: it holds each
` local as the instance left it, and runs nothing. A closure written in a closure has one
` for each instance out to the first that is still running.
. around = instances.rows[enclosing].enclosing
. writer = if around != no-instance then definer(around) ?? settled(around) else null
. stand = checker-for(session, enclosing, writer, true)
stand.prepare()
for offset in 0 .. < stand.frame.slots.count
    . type = facts.slot-type(enclosing, offset)
    if type != no-type
        stand.frame.assign(stand.frame.slots.start + offset, type)
= stand

────────────────────
_ do dismiss

` Closes a settled checker, and then those made around it.
. around = outer
close()
retire()
if around && around.probing
    around.dismiss()

────────────────────
_ do decline
    - id SyntaxId

frame.diagnose(id, .not-supported)

────────────────────
_ do infer-integer TypeId
    - id SyntaxId
    - text String
    - unit Atom?

` An integer written with a builtin number's suffix is the bit pattern of that width, kept to
` its low bits, while one written with a unit a module declares must fit the unit's number type,
` as a plain integer given to it must.
. literal = parse-integer-literal(text)
. target = if unit then literal-unit(id, text, unit) else types.type-row(.uint64)
if unit && target != invalid-type && types.completions[target].has-variables
    . message = program.store-atom("Unit types must be numeric and unqualified")
    frame.diagnose(id, .stated, message)
    facts.inset-diagnostic(text.length as U32)
    = invalid-type
if target != invalid-type && (literal.overflow || unfit)
    . shown = program.store-atom(decimal-text(text))
    frame.diagnose(id, .literal-does-not-fit, shown, no-type, target)
    = invalid-type
.. unfit = unit && declared && !literal-fits-target(types, literal, builtin-number(types, target))
.. declared = builtin-number(types, target) != target
if unit
    = unit-literal(id, target)
= magnitude-type(types, literal)

────────────────────
_ do infer-unit-float TypeId
    - id SyntaxId
    - text String
    - unit Atom

` A number with a fraction written with a unit, which must hold fractions where it is a number
` of the unit's own.
. target = literal-unit(id, text, unit)
if target == invalid-type || declares-constructor(target)
    = unit-literal(id, target)
. number = builtin-number(types, target)
if is-integer-kind(types.intrinsic-of(number))
    . shown = type-short-name(types, target)
    . held = if number == target then "" else ", as ${type-short-name(types, number)} does"
    . message = "$shown holds whole numbers$held, so $text${unit.text} cannot be written; write a whole number"
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
= unit-literal(id, target)

────────────────────
_ do unit-literal TypeId
    - id SyntaxId
    - unit-type TypeId

` A number written with a unit is of the unit's type. A unit that declares a constructor is
` constructed from the number, and the literal is what the constructor returns; one that
` declares none is a number, or no number can be written in it.
if unit-type == invalid-type
    = invalid-type
if is-unit-class(types, unit-type) && !declares-constructor(unit-type)
    if !intrinsic-is-numeric(types.intrinsic-of(builtin-number(types, unit-type)))
        . shown = type-short-name(types, unit-type)
        . message = "$shown is no number and declares no constructor that takes one, so no number can be written in its unit; declare $shown as a number type"
        frame.diagnose(id, .stated, program.store-atom(message))
        = invalid-type
    = unit-type
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(unit-type)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(id)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. result = calls.construction-on(id, unit-type, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do declares-constructor Bool
    - type TypeId

do match? types.rows[type]
    | .type-class(row)
        . module = program.modules[row.module]
        do match? module.decls[row.decl]
            | .decl-class(cls)
                if cls.members.count == 0
                    = false
                for member in module.member-pool[cls.members]
                    do match? module.decls[member]
                        | .decl-function(fn)
                            if fn.kind == .constructor-decl
                                = true
= false

────────────────────
_ do literal-unit TypeId
    - id SyntaxId
    - text String
    - unit Atom?

` The type the unit of a literal names. A unit that names no type is reported where it is
` written, past the digits.
. target = unit-class(unit)
if target == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Type not found"))
    facts.inset-diagnostic(text.length as U32)
= target

────────────────────
_ do unit-class TypeId
    - unit Atom?

if !unit
    = invalid-type
. found = types.type-named(module, unit, types.env-frame())
if found != invalid-type
    types.complete(found)
= found

────────────────────
_ do reads-uninitialized Bool
    - owner ModuleId
    - decl DeclId

` A module's globals take their values in the order they are declared, so the value of one
` cannot read a later one whose own value has yet to be computed. A global each task or each
` thread holds its own of, or that `do with` binds, takes its value before every other global
` of its module, so its value reads them checked, as a function does; it cannot read a later
` one of its own kind (see `reads-later-local`).
if initializing == 0 || owner != module || decl <= initializing
    = false
if initializes-early()
    = reads-later-local(owner, decl)
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        if row.owner != 0 || row.value == 0 || row.is-lazy || is-task-local(owner, decl)
            = false
        if is-thread-local(owner, decl) || is-stack-global(owner, decl)
            = false
        = !is-constant-global(owner, decl)
= false

────────────────────
_ reads-later-local Bool
    - owner ModuleId
    - decl DeclId

` Whether the value of a global each task or each thread holds its own of, or that `do with`
` binds, reads a later one of its kind, which takes its value after it: those each thread holds
` take theirs in the order they are declared, and so do the others together.
if is-thread-local(module, initializing) then is-thread-local(owner, decl) else later-other

.. later-other = is-task-local(owner, decl) || is-stack-global(owner, decl)

────────────────────
_ do demand-global TypeId
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` The type of a global a name reads or writes. The use of one each task or each thread holds
` its own of is recorded once its value is typed, as TypeScript makes that value once it has
` compiled it.
. type = demand-property(owner, decl)
if is-task-local(owner, decl) || is-thread-local(owner, decl) || is-stack-global(owner, decl)
    facts.local-global-uses.append(LocalGlobalUse(instance, id, owner, decl))
= type

────────────────────
_ do is-lazy-global Bool
    - owner ModuleId
    - decl DeclId

` Whether a global takes its value where it is first read.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.owner == 0 && row.is-lazy && row.decoration == null
= false

────────────────────
_ do is-task-local Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one each task holds its own of.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "task"
= false

────────────────────
_ do is-thread-local Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one each thread holds its own of.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "thread"
= false

────────────────────
_ do is-stack-global Bool
    - owner ModuleId
    - decl DeclId

` Whether a global is one `do with` binds.
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "stack"
= false

────────────────────
_ do is-constant-global Bool
    - owner ModuleId
    - decl DeclId

` A global whose value is a literal laid down before anything runs: a number or a string, of a
` numeric type or String when it declares one. Every other global takes its value when its
` module starts, or, kept for each task or thread, as the task or thread starts. One `do with`
` could bind is laid down so only where nothing binds it (`ProgramTables`).
. target = program.modules[owner]
do match? target.decls[decl]
    | .decl-property(row)
        if row.decoration != null && row.decoration.text != "stack"
            = false
        . worded = row.value != 0 && is-string-literal(target.tree, row.value)
        if row.value != 0 && !worded && !is-constant-literal(owner, row.value)
            = false
        if row.type-syntax == 0
            = row.value != 0
        . env = types.env-frame()
        . declared = types.evaluate-type(owner, target.tree, row.type-syntax, env)
        if worded
            = declared == types.string-type
        = declared != invalid-type && is-numeric(types, declared)
= false

────────────────────
_ is-string-literal Bool
    - source AST
    - value SyntaxId

match source.nodes[value]
    | .node-string-syntax
        true
    ??
        false

────────────────────
_ do is-constant-literal Bool
    - owner ModuleId
    - value SyntaxId

` A number, a negated number, `true` or `false`, such a literal cast to a numeric type, or the
` least or greatest value of one. A number written with a unit that declares a constructor is
` what the constructor makes, and no literal.
. source = program.modules[owner].tree
do match? source.nodes[value]
    | .node-integer-syntax(row)
        = plain-unit(owner, row.unit)
    | .node-float-syntax(row)
        = plain-unit(owner, row.unit)
    | .node-unary-expression(row)
        = row.op == .negative-op && is-number(source, row.operand)
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom
    | .node-cast-expression(row)
        = is-constant-literal(owner, row.lhs) && names-numeric(owner, row.rhs)
    | .node-get-expression(row)
        . bound = row.name.text == "min" || row.name.text == "max"
        = bound && names-numeric(owner, row.object)
= false

────────────────────
_ plain-unit Bool
    - owner ModuleId
    - unit Atom?

|? !unit
    true
??
    found == invalid-type || !declares-constructor(found)

.. found = types.type-named(owner, unit, types.env-frame())

────────────────────
_ is-number Bool
    - source AST
    - value SyntaxId

match source.nodes[value]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    ??
        false

────────────────────
_ do names-numeric Bool
    - owner ModuleId
    - type-syntax SyntaxId

. source = program.modules[owner].tree
do match? source.nodes[type-syntax]
    | .node-type-identifier
        . named = types.evaluate-type(owner, source, type-syntax, types.env-frame())
        = named != invalid-type && is-numeric(types, named)
= false

────────────────────
_ do guards-read Bool
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` Whether reading a global can fail where the read stands. One that `do with` binds is unbound
` outside every binding of it. One each task or each thread holds its own of has its value as
` the task or the thread starts. A lazy one is evaluated by the first read, which fails when
` its value is being evaluated already. Any other that is not a constant is checked for its
` value wherever it is read outside its own module's statements. The value of a class's
` property, which a constructor runs, and of a lazy global, which its first read runs, are
` outside them: either may run before the module's globals have their values, as may the
` value of a global each task or each thread holds its own of, or that `do with` binds.
if is-stack-local(id)
    for scope in facts.stack-scopes
        if scope.instance == instance && scope.module == owner && scope.decl == decl
            if id >= scope.first && id <= scope.last
                = false
    = true
if is-task-local(owner, decl) || is-thread-local(owner, decl)
    = false
do match? program.modules[owner].decls[decl]
    | .decl-property(row)
        if row.owner == 0 && row.is-lazy
            = true
if frame.declaration.is-main && owner == (module) && !is-deferred-value() && !initializes-early()
    = false
if core-literal-type(owner, decl) != no-type
    = false
= !is-constant-global(owner, decl)

────────────────────
_ do is-deferred-value Bool

if !instances.is-initializer(instance)
    = false
do match? program.modules[module].decls[instances.rows[instance].initializer]
    | .decl-property(row)
        = row.owner != 0 || row.is-lazy
= false

────────────────────
_ do note-guarded
    - id SyntaxId
    - owner ModuleId
    - decl DeclId

` Plans a read of a global as a checked one: the reader may panic there.
instances.mark-may-panic(instance)
facts.set-plan(instance, id, .plan-guarded-read)
facts.global-uses.append(GlobalUse(instance, id, owner, decl))

────────────────────
_ do lacks-self Bool

` Whether the function being checked runs without a value of the type it belongs to: a static
` method, or the constructor of an interface, which has no value to construct.
if outer
    = outer.lacks-self()
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        if fn.is-static
            = true
        . self = frame.self-type
        if is-constructor-kind(fn.kind) && self != no-type && self != invalid-type
            = types.intrinsic-of(self) == .interface
= false

────────────────────
_ do lacks-base Bool

if outer
    = outer.lacks-base()
. self = frame.self-type
if self == no-type || self == invalid-type
    = false
types.complete(self)
= types.base-of(self) == null

────────────────────
_ do read-received Found
    - id SyntaxId
    - name Atom
    - want Want

` A name read by its name alone in the body of a markup element that is a member of the
` element, or of an element it is in, the innermost first, as the binder found it: the
` reference reads the property of that element's object (`received-parent`), or names its
` event. A member that is neither a stored property nor an event, one read where no element is
` being built, or an event read in a function written in the element's body, has no shape here,
` but such an event used as a value is reported as `refuse-event-value` says, and one stored in
` a property or given to a call is kept until the property or the parameter is known
` (`store-event`, `settle-kept-arguments`).
. parent = received-parent(id, name)
if parent == no-type
    decline(id)
    = Found(invalid-type)
. place = property-named(parent, name)
if !place && bindings.resolution-of(frame.binding, id).slot != no-slot
    . found = event-of(parent, name)
    if !found
        decline(id)
        = Found(invalid-type)
    . endpoint = endpoint-of(found)
    if misused-event(id, endpoint, want)
        refuse-event-value(id, found.owner, name)
        = Found(invalid-type)
    if endpoint != invalid-type && want.asks(.want-store)
        = Found(endpoint, no-type, found-event(found), true)
    if endpoint != invalid-type && argument-typing.unknown-callee
        = Found(endpoint)
    . addressed = found.key == no-type || found.address != 0
    if endpoint != invalid-type && want.asks(.want-argument) && argument-typing.keeps && addressed
        endpoint-arguments += id
        endpoint-events += found
        kept-arguments += id
        = Found(endpoint)
    decline(id)
    = Found(invalid-type)
if !place
    = read-event(id, parent, name, want)
if types.properties[place].storage-kind == .storage-getter
    decline(id)
    = Found(invalid-type)
= read-property(id, id, parent, name, want)

────────────────────
_ do misused-event Bool
    - id SyntaxId
    - endpoint TypeId
    - want Want

` Whether a node that names an event is used where a value is, as the reference finds none of
` an event: the value of a declaration that states no type, or one the event's `Broadcastable`
` is not (`takes-endpoint`), the value assigned to a local or cast to a type it is not, the
` value of an assigning operator, an item of a list or a tuple, what a line prints, an operand
` of an arithmetic, comparing or joining operator, or the object a member is read from or
` called on.
. holder = tree.holder-of(id)
. escaping = want.asks(.want-escape)
do match? tree.nodes[holder]
    | .node-declare
        = !escaping || want.type == no-type || !takes-endpoint(endpoint, want.type)
    | .node-assign(row)
        if row.rhs != id
            = false
        = row.op != .eq-op || (escaping && (typeless || !takes-endpoint(endpoint, want.type)))
            .. typeless = want.type == no-type
    | .node-cast-expression(row)
        = cast-escapes && want.type != no-type && !takes-endpoint(endpoint, want.type)
            .. cast-escapes = row.lhs == id && escaping
    | .node-list-syntax
        = true
    | .node-tuple-syntax
        = true
    | .node-print
        = true
    | .node-binary-expression(row)
        = computes || row.op == .concat-op || row.op == .concat-string-op
            .. computes = is-arithmetic(row.op) || is-comparison(row.op)
    | .node-get-expression(row)
        = row.object == id
= false

────────────────────
_ takes-endpoint Bool
    - endpoint TypeId
    - wanted TypeId

` Whether an event's `Broadcastable` becomes a type without a converter, as the reference casts
` an event's endpoint only to an interface it has.
|? endpoint == invalid-type || wanted == invalid-type
    true
??
    legal-plain && not-common && kind != .relation-string-cast && kind != .relation-fromverter

.. kind = conversions.compare-held(endpoint, wanted).kind
.. legal-plain = kind != .relation-illegal && kind != .relation-converter
.. not-common = kind != .relation-common-converter

────────────────────
_ do endpoint-of TypeId
    - event NamedEvent

` The `Broadcastable` an event's endpoint is.
= types.well-known-type-of("core/stream", "Broadcastable", event.payload)

────────────────────
_ do refuse-event-value
    - id SyntaxId
    - owner TypeId
    - name Atom

` Reports a node that names an event used as a value, which an event is not.
. message = "\"${name.text}\" is an event of ${owner-name}; it cannot be used as a value"
    .. owner-name = type-short-name(types, owner)
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do refuse-event-read
    - id SyntaxId
    - owner TypeId
    - name Atom

` Reports an event read with `<-`, as a channel is: an event gives each value to the
` subscribers it has as it is published, and keeps none to be read.
. written = name.text
do match? tree.nodes[id]
    | .node-get-expression(row)
        do match? tree.nodes[row.object]
            | .node-identifier(object)
                written = "${object.name.text}.${name.text}"
. owner-name = type-short-name(types, owner)
. message = "\"${name.text}\" is an event of $owner-name, which gives each value to its subscribers and keeps none to read with \"<-\"; hear the next one with \"for value on $written\", and end the loop with \"break\""
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
_ do read-unmade TypeId
    - id SyntaxId
    - name Atom
    - slot SlotId

` The name of a markup element of a class's markup read in a closure the markup makes before
` the element is made: the reference reads the receiver's property of the name when the
` closure runs (`plan-element-property`). In a function's markup, the closure reads the local
` that keeps the element when it runs (`read-later-element`), as it does the element it is an
` attribute of.
. self = frame.self-type
if self != no-type && self != invalid-type && !lacks-self() && types.intrinsic-of(self) == .class
    . place = property-named(self, name)
    if place && names-element(types, types.properties[place])
        instances.mark-may-panic(instance)
        facts.set-plan(instance, id, .plan-element-property)
        = read-property(id, id, self, name).type
if outer && frame.is-captured(slot) && awaits-element(slot)
    = read-later-element(id, name, slot)
decline(id)
= invalid-type

────────────────────
_ received-parent TypeId
    - id SyntaxId
    - name Atom

` The object a member read by its name alone in the body of a markup element is read from: in a
` function written in the body, that of the element the binder found, kept where it was made,
` and else the innermost element being built that has the member (`received-owner`).
|? kept == no-slot
    received-owner(name)
|? parent == no-type || parent == invalid-type || types.intrinsic-of(parent) != .class
    no-type
|? place && names-element(types, types.properties[place])
    no-type
??
    parent

.. kept = bindings.resolution-of(frame.binding, id).slot
.. parent = frame.slot-type(kept)
.. place = property-named(parent, name)

────────────────────
_ do received-owner TypeId
    - name Atom

` The innermost markup element being built whose class has a property or an event of a name,
` or no type: a property the markup of the element's class declares for an element is hidden
` there.
. position = content-parents.length
while position != 0
    position -= 1
    . parent = content-parents[position]
    if types.intrinsic-of(parent) != .class
        continue
    . place = property-named(parent, name)
    if place && !names-element(types, types.properties[place])
        = parent
    if !place && declares-event(parent, name)
        = parent
= no-type

────────────────────
_ do infer-identifier Found
    - id SyntaxId
    - name Atom
    - want Want = Want()

` The type of a name alone, as what the binder resolved it to gives it: a local, a global, a
` member, a function or a type. A name the binder left for a style to resolve, which no style
` sheet's slot nor `inherit` is, is not found, as the reference reports it where no case of the
` property's union took it (`style-value`). The name of a slot outlet that is a markup branch
` region, which the reference builds a node of its own for where it is read, is declined.
. resolution = bindings.resolution-of(frame.binding, id)
if (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
    = read-received(id, name, want)
do match resolution.kind
    |= .resolve-slot
        if finally.limit != 0 && bindings.slots[resolution.slot].syntax > finally.limit
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].getter != 0
            = Found(read-getter(id, resolution.slot))
        if is-placed(resolution.slot) && outlet-choice(bindings.slots[resolution.slot].group) != no-type
            . message = "Outlet \"${name.text}\" is not read by its name where its slot is filled inside an if or match"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if unbuilt.length != 0 && unbuilt.find(resolution.slot) != null
            if resolution.slot == building || held.find(resolution.slot) != null
                . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
                frame.diagnose(id, .stated, program.store-atom(message))
                = Found(invalid-type)
            if !raise-early(id, resolution.slot)
                decline(id)
                = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-this && in-eager()
            . message = "Illegal to reference 'this' in eager properties or properties "
            frame.diagnose(id, .stated, program.store-atom(message ++ "referenced by them"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-this && lacks-self()
            frame.diagnose(id, .stated, program.store-atom("Required self not defined"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-super && lacks-base()
            frame.diagnose(id, .stated, program.store-atom("super requires a base type"))
            = Found(invalid-type)
        if bindings.slots[resolution.slot].kind == .slot-super && !want.asks(.want-receiver)
            frame.diagnose(id, .stated, program.store-atom("Bare super is not a value"))
            = Found(invalid-type)
        if is-placed(resolution.slot) && reads-before-made(id, resolution.slot)
            . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if precedes-declaration(resolution.slot)
            if is-placed(resolution.slot) || awaits-element(resolution.slot)
                = Found(read-unmade(id, name, resolution.slot))
            if names-machine(resolution.slot)
                decline(id)
                = Found(invalid-type)
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        if is-placed(resolution.slot) && outlet-region(bindings.slots[resolution.slot].group) != 0
            decline(id)
            = Found(invalid-type)
        note-carried(id, resolution.slot)
        if wavers(resolution.slot)
            decline(id)
            = Found(invalid-type)
        . read = read-slot(resolution.slot, id)
        if in-lazy && scratch.narrowed-since(last-mark, slot-key(resolution.slot)) != no-type
            facts.note-inside-read(instance, id)
        .. in-lazy = lazy-marks.length != 0 && !frame.is-captured(resolution.slot)
        .. last-mark = lazy-marks[lazy-marks.length - 1]
        if is-row-item(resolution.slot, read)
            = Found(read-row-item(id, read))
        if !want.asks(.want-pattern) && types.is-pattern-func(read)
            if names-given-pattern(resolution.slot)
                if valuing.action-arm != 0
                    frame.diagnose
                        - valuing.action-arm
                        - .stated
                        - program.store-atom("Unable to compile pattern action: Name not found")
                else
                    frame.diagnose(id, .stated, program.store-atom("Name not found"))
                = Found(invalid-type)
            if instances.rows[instance].helper != no-type
                decline(id)
                = Found(invalid-type)
        note-case-read(id, resolution.slot, read)
        = Found(read)
    |= .resolve-global
        if reads-uninitialized(resolution.module, resolution.decl)
            . message = "Global '${name.text}' is read before it is initialized"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if is-stack-local(id)
            facts.stack-reads.append(StackRead(instance, id, resolution.module, resolution.decl))
        if is-lazy-global(resolution.module, resolution.decl)
            frame.check-lazy-read(id, name.text)
        if guards-read(id, resolution.module, resolution.decl)
            note-guarded(id, resolution.module, resolution.decl)
        = Found(demand-global(id, resolution.module, resolution.decl))
    |= .resolve-member
        if theme-sheet != no-type && sheet-has-slot(family-root(theme-sheet), name)
            = Found(read-theme(id, name))
        if in-eager() && is-accessor(frame.self-type, name)
            . message = "Illegal to reference getters in eager properties"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if lacks-self()
            frame.diagnose(id, .stated, program.store-atom("Required self not defined"))
            = Found(invalid-type)
        if !outer && reads-unmade(name) && !instances.is-initializer(instance)
            . message = "Named markup element \"${name.text}\" is read before its markup constructs it"
            frame.diagnose(id, .stated, program.store-atom(message))
            = Found(invalid-type)
        if !outer && reads-unmade(name) && !is-eager-value() && !waits-in-rule() && unkept
            decline(id)
            = Found(invalid-type)
        .. unkept = !keeps-whole(name) && !runs-later(id)
        = read-member(id, name, want)
    |= .resolve-function
        if names-module-accessor(resolution.module, resolution.decl)
            = Found(calls.module-getter-call(id, name))
        if names-method(resolution.module, resolution.decl) && !lacks-self()
            = Found(calls.method-binding(frame.self-type, name, id))
        = Found(types.intern-binding(.bound-function, frame.module, resolution.module, resolution.decl))
    |= .resolve-type
        = Found(type-info-of(id, types.type-named(module, name, frame.env)))
    ??
        . bound = types.env-lookup(frame.env, name)
        if bound
            = Found(type-info-of(id, bound))
        . styled = (resolution.flags /and/ ResolutionFlag.resolution-styled) != 0
        if styled && themed && !tree.is-inherit(id) && names-sheet-slot(name)
            = Found(read-theme(id, name))
        .. themed = theme-made != no-type || theme-sheet != no-type
        if styled && unquiet && !tree.is-inherit(id) && !names-sheet-slot(name)
            frame.diagnose(id, .stated, program.store-atom("Name not found"))
            = Found(invalid-type)
        .. unquiet = (resolution.flags /and/ ResolutionFlag.resolution-quiet) == 0
        if (resolution.flags /and/ lenient-flags) != 0
            decline(id)
        .. lenient-flags = ResolutionFlag.resolution-styled /or/ ResolutionFlag.resolution-quiet
        = Found(invalid-type)

────────────────────
_ do note-collection-read TypeId
    - id SyntaxId
    - read TypeId
    - want Want

` A tracked read whose value is a collection, which the reference tracks the changes of too,
` where the read is tracked (`trackCollectionRead`): the read is noted, and the runtime's
` `track-collection-dependency` typed. One of an optional collection is tracked where it holds
` one. The container of a markup loop region (`want-observed`) is no such read: the region
` observes it itself. Answers the read.
if read == invalid-type || read == no-type || types.collection-decl.module == 0 || want.asks(.want-observed)
    = read
. held = if types.is-optional(read) then types.optional-inner(read) else read
if types.intrinsic-of(held) != .class || derived-interface(held, types.collection-decl) == no-type
    = read
if !demand-track-collection()
    decline(id)
    = invalid-type
facts.collection-reads += CollectionRead(instance, id)
= read

────────────────────
_ do raise-early Bool
    - read SyntaxId
    - slot SlotId

` Makes the object of a named markup element a block has not made yet where what makes an
` earlier one, or a statement of the block above it, reads its name, as the reference evaluates
` the name's local where it is first read, under the styles in force there. The element is not
` made again where it is written. Only a read made each time the element being made, or the
` statement, is reaches it: one a branch or a call may skip would leave the object unmade on
` some runs, and is declined.
. waited = unbuilt.find(slot)
if waited == null || awaited[waited] == 0
    = false
. element = awaited[waited]
if !reached-always(read, tree.holder-of(element))
    = false
do match? tree.nodes[element]
    | .node-markup(row)
        held += building
        . around = building
        building = slot
        . made = make-element(element, row)
        building = around
        held.pop()
        assign-element(slot, made, element)
        unbuilt[waited] = no-slot
        awaited[waited] = 0
        facts.note-raised(instance, 0, element, read)
        = true
= false

────────────────────
_ do reached-always Bool
    - read SyntaxId
    - home SyntaxId

` Whether making the markup element being made, or else running a statement of the block `home`,
` always evaluates a node: each node between them evaluates the one below it whenever it is
` evaluated, up to an argument of the element, the value of an attribute it is given, or the
` statement.
. child = read
. node = tree.holder-of(read)
while node != 0
    if building == no-slot && node == home
        = true
    do match tree.nodes[node]
        | .node-markup(row)
            = (element-slot(node, row.id) ?? no-slot) == building
        | .node-assign(row)
            if row.rhs != child
                = false
            if building != no-slot
                . owner = tree.body-element(tree.holder-of(node))
                do match? tree.nodes[owner]
                    | .node-markup(made)
                        = (element-slot(owner, made.id) ?? no-slot) == building
                = false
        | .node-declare(row)
            if building != no-slot || row.right != child || row.is-lazy
                = false
        | .node-print(row)
            if building != no-slot || row.body != child
                = false
        | .node-get-expression(row)
            if row.object != child || row.is-optional
                = false
        | .node-binary-expression(row)
            . skips = chooses || row.op == .and-op || row.op == .or-op
                .. chooses = row.op == .coalesce-op || row.op == .else-op
            if skips && row.lhs != child
                = false
            if row.op == .if-op && row.rhs != child
                = false
            if !skips && row.op != .if-op && row.op != .concat-op && other-op
                = false
            .. other-op = !is-arithmetic(row.op) && !is-comparison(row.op)
        | .node-call-expression
        | .node-argument
        | .node-index-expression
        | .node-unary-expression
        | .node-cast-expression
        ??
            = false
    child = node
    node = tree.holder-of(node)
= false

────────────────────
_ do pulled-root Bool
    - id SyntaxId
    - object SyntaxId

=? false if pipeline-of(id) == 0 && !watched(id)
do match? tree.nodes[object]
    | .node-identifier(row)
        =? false if row.is-tracked
        = bindings.resolution-of(frame.binding, object).kind == .resolve-slot
= false

────────────────────
_ do restored Bool
    - slot SlotId

` Whether something stores to a local after it is declared: an assignment, or its declaration
` run again, as one whose value reads something tracked is.
if (bindings.slots[slot].flags /and/ SlotFlag.slot-assigned) != 0
    = true
. syntax = bindings.slots[slot].syntax
for node in syntax + 1 .. < (tree.nodes.length as SyntaxId)
    if tree.subtree-start(node) <= syntax && tree.nodes[node] is .node-declare
        = is-live-statement(node)
= false

────────────────────
_ do namesake Bool
    - slot SlotId
    - tracked Bool

` Whether another local of the function that declares a local has its name, one some read
` tracks where `tracked` says.
. other = bindings.slots[slot].namesake
while other != no-slot && other != slot
    if bindings.is-trackable(other) && (!tracked || tracked-other)
        = true
    .. tracked-other = (bindings.slots[other].flags /and/ SlotFlag.slot-tracked) != 0
    other = bindings.slots[other].namesake
= false

────────────────────
_ do unfollowed
    - id SyntaxId
    - name Atom

. shown = name.text
. message = "\"#$shown\" is read for each item of a pipeline, which is followed only where the pipeline is given to a call in a live value, as in count(each in #items when each.#is-done); write \"$shown\" to read it plainly"
frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
+ do note-given
    - call SyntaxId
    - given SyntaxId
    - callee InstanceId
    - position U32

if callee == no-instance || !takes-generator(instances.argument-type(callee, position))
    =
given-nodes += given
given-calls += call
given-callees += callee
given-positions += position

────────────────────
_ takes-generator Bool
    - type TypeId

type != no-type && type != invalid-type && (same-decl(ref, types.generator-decl) || same-decl(ref, types.iterable-decl))

.. ref = class-ref(types, type)

────────────────────
_ do given-index Size?
    - node SyntaxId

. index = given-nodes.length
while index != 0
    index -= 1
    if given-nodes[index] == node
        = index
= null

────────────────────
_ do callee-use GeneratorUse
    - callee InstanceId
    - position U32

if position >= 64
    = .generator-kept
demand-body(callee)
if instances.rows[callee].state != .instance-done
    = .generator-kept
. bit = 1u64 /lshift/ (position as U64)
if (instances.rows[callee].consumes /and/ bit) != 0
    = .generator-consumed
if (instances.rows[callee].hands-back /and/ bit) != 0
    = .generator-returned
= .generator-kept

────────────────────
_ do generator-use GeneratorUse
    - node SyntaxId

. given = given-index(node)
if given != null
    . use = callee-use(given-callees[given], given-positions[given])
    if use == .generator-returned
        = generator-use(given-calls[given])
    = use
. range = instances.rows[instance].subtree
for id in range.start .. < range.start + range.count
    do match? tree.nodes[id]
        | .node-for-block(row)
            do match? tree.nodes[row.loop]
                | .node-loop-syntax(loop)
                    if loop.container == node
                        = .generator-consumed
        | .node-unary-expression(row)
            if row.op == .read-op && row.operand == node
                = .generator-consumed
        | .node-return(row)
            if row.expr == node
                = .generator-returned
        | .node-yield(row)
            if row.expr == node && row.does-yield-all
                = .generator-returned
        | .node-argument-decl(row)
            if tree.subtree-start(row.pattern) <= node && node <= row.pattern
                = .generator-consumed
= .generator-kept

────────────────────
_ do parameter-use GeneratorUse
    - slot SlotId

. held = SlotFlag.slot-captured /or/ SlotFlag.slot-address-taken
if (bindings.slots[slot].flags /and/ held) != 0
    = .generator-kept
. range = instances.rows[instance].subtree
. use GeneratorUse = .generator-consumed
for id in range.start .. < range.start + range.count
    if tree.nodes[id] is .node-identifier
        . resolution = bindings.resolution-of(frame.binding, id)
        if resolution.kind == .resolve-slot && resolution.slot == slot
            . found = generator-use(id)
            if found == .generator-kept
                = .generator-kept
            if found == .generator-returned
                use = .generator-returned
if instances.rows[instance].is-generator
    = .generator-returned
= use

────────────────────
_ do settle-generators

for index in 0 .. < pulled-pipelines.length
    follow-pipeline(pulled-pipelines[index], pulled-reads[index], pulled-names[index])
. consumes U64 = 0
. hands-back U64 = 0
. position = 0u32
for offset in 0 .. < frame.slots.count
    . slot = frame.slots.start + offset
    . row = bindings.slots[slot]
    if outer && row.scope != frame.nested-scope
        continue
    if row.kind != .slot-argument
        continue
    if position < 64 && takes-generator(instances.argument-type(instance, position))
        . use = parameter-use(slot)
        . bit = 1u64 /lshift/ (position as U64)
        if use == .generator-consumed
            consumes = consumes /or/ bit
        else if use == .generator-returned
            hands-back = hands-back /or/ bit
    position += 1
instances.rows[instance].consumes = consumes
instances.rows[instance].hands-back = hands-back

────────────────────
_ read-site SyntaxId
    - id SyntaxId

` Where a node is read: a node of the value of a row local read as a getter is read where the
` outermost such read is.
if reading.getter != 0 then reading.getter else id

────────────────────
_ do owns-plain-actions Bool
    - type TypeId

` Whether the live actions an object owns are plain ones: it is an object of a class that is
` neither a markup host nor a markup batch, whose actions the reference makes through markup.
if types.intrinsic-of(type) != .class
    = false
for decl in [types.markup-host-decl, types.markup-batch-decl]
    if (decl.module != 0 || decl.decl != 0) && derived-interface(type, decl) != no-type
        = false
= true

────────────────────
_ do root-value SyntaxId

` The line of a root `<This` whose value the instance types, as the value of a property, or
` none.
. unit = instances.rows[instance]
if unit.initializer == 0
    = 0
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        if row.defaults-root
            = row.syntax
= 0

────────────────────
_ do in-loop Bool
    - id SyntaxId

` Whether a node is written in a loop of the function that writes it. The body of a markup loop
` region is the function that builds a row, in no loop.
for node in id + 1 .. < (tree.nodes.length as SyntaxId)
    if node == frame.declaration.syntax && frame.declaration.kind == .row-decl
        = false
    if tree.subtree-start(node) <= id
        do match? tree.nodes[node]
            | .node-for-block
                = true
            | .node-iterator-expression
                = true
            | .node-while-block
                = true
            | .node-loop-syntax
                = true
            | .node-function-syntax
                = false
= false

────────────────────
_ do infer-stream TypeId
    - id SyntaxId
    - expr SyntaxId

` A stream of a value as it changes, `<#value>`, as the reference makes it: the value, read while
` a live action of its own is open, is written by `<-write` to an `AsyncBufferedChannel` of its
` type made there, which is kept in the local no name reaches declared at the stream, and the
` action writes the value again to the channel through the function written for it as what it
` read changes. One that reads nothing tracked is reported, as it would never change; one written
` where a markup element is being made has no shape here yet.
if !tracks-reads(tree, expr)
    . message = "A stream of a value follows the reads written with \"#\", and this one has none, so it would never change; write \"#\" before what it follows, as in \"<c.#count>\""
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
. decl = nested-decl-of(id)
. resolution = bindings.resolution-of(frame.binding, id)
if decl == 0 || resolution.kind != .resolve-slot || content-parents.length != 0
    decline(id)
    = invalid-type
. value = infer(expr)
if value == invalid-type || value == no-type
    = invalid-type
. channel = types.well-known-type-of("core/channel", "AsyncBufferedChannel", value)
if channel == invalid-type
    decline(id)
    = invalid-type
. made = calls.demand-constructor(channel, scratch.types.mark)
. given [TypeId]
given += value
. write = calls.protocol-call(channel, program.store-atom("<-write"), id, given, true).fact
if made == no-instance || write == no-fact
    decline(id)
    = invalid-type
do facts.record-call(instance, id, made, .call-constructor, scratch.no-fills, false)
frame.assign(resolution.slot, channel)
. position = facts.live-statements.length
while position != 0
    position -= 1
    . row = facts.live-statements[position]
    if row.instance != instance || row.site != id || row.rerun != no-instance
        continue
    . rerun = demand-lambda(intern-nested(decl), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(id)
        = invalid-type
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement(instance, id, rerun)
    = channel
. message = "A stream of a value is made only by a statement in a function's body, as in \". values = <c.#count>\"; make it there, move a machine as a value changes with a \"whenever\" trigger, as in \"then loading whenever #feed\", or publish an event from a \"whenever\" rule and loop on it"
frame.diagnose(id, .stated, program.store-atom(message))
= invalid-type

────────────────────
_ do claim-lazy
    - slot SlotId
    - declaration SyntaxId
    - value SyntaxId

` A lazy local whose value is closable, which the reference keeps behind a flag
` (`lazy-flagged`), in a function that makes markup or runs on an object of a class, is claimed
` for the object that owns what is made where it is evaluated, as the reference's `ownClosable`
` gives it: a `ClosableTracker` of it, made a `Tracker`, is held by a live action of the owner,
` and the value and the tracker are converted at the declaration (`AddressClaim`). `it` is not
` claimed, and one written with a type its value is converted to has no shape here.
if value == 0 || bindings.slots[slot].name.text == "it" || !bindings.lazy-flagged(slot)
    =
. raw = facts.node-type(instance, value)
if raw == no-type || raw == invalid-type || derived-interface(raw, types.closable-decl) == no-type
    =
. owned = frame.self-type != no-type && !lacks-self() && class-self
    .. class-self = types.intrinsic-of(frame.self-type) == .class
if !owned && !writes-markup()
    =
if raw != frame.slot-type(slot)
    decline(declaration)
    =
demand-live-runtime()
. closable = types.well-known-type("core/stream", "Closable")
. tracking = types.well-known-type("core/tracker", "ClosableTracker")
. tracker = types.well-known-type("core/tracker", "Tracker")
if closable == invalid-type || tracking == invalid-type || tracker == invalid-type || live-missing
    decline(declaration)
    =
.. live-missing = instances.live.add-tracker == no-instance || instances.live.action == no-instance
. mark = scratch.types.mark
scratch.types.push(closable)
. closer = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if closer == no-instance
    decline(declaration)
    =
conversions.convert(declaration, declaration, raw, closable, .reason-argument)
conversions.convert
    - declaration
    - declaration
    - instances.signatures[closer].returns
    - tracker
    - .reason-argument
facts.address-claims += AddressClaim(instance, declaration, closer)

────────────────────
_ do object-member TypeId
    - id SyntaxId
    - name Atom

` A member every object has that its class does not declare: its `uid`, or the list of the
` subscribers of its properties, which the runtime's property tracker gives the type of.
if name.text == "uid"
    facts.set-plan(instance, id, .plan-object-uid)
    = types.type-row(.uint32)
if name.text != "property-subscribers"
    = no-type
demand-live-runtime()
. tracker = types.well-known-type("core/tracker", "PropertyTracker")
if tracker == invalid-type || instances.live.subscribers == no-instance
    decline(id)
    = invalid-type
facts.set-plan(instance, id, .plan-property-subscribers)
= tracker-field(tracker, "subscribers")

────────────────────
_ reads-unmade Bool
    - name Atom

` Whether a member read by its name alone is the property the markup of a class declares
` for an element, read where the markup may not have run: in a constructor, or in the first
` value of a property or a rule. The reference reports the first, puts off the value of a
` stored property until the markup has run, and runs a rule that reads one in its test once
` it has.
|? !is-constructor-kind(frame.declaration.kind) && !instances.is-initializer(instance)
    false
|? self == no-type || self == invalid-type
    false
??
    place != null && names-element(types, types.properties[place])

.. self = frame.self-type
.. place = property-named(self, name)

────────────────────
_ do is-eager-value Bool

` Whether the instance types the value written for a stored property of a class, which a
` constructor can put off.
. unit = instances.rows[instance]
if unit.initializer == 0 || frame.self-type == no-type
    = false
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        = !row.is-lazy
= false

────────────────────
_ do names-method Bool
    - owner ModuleId
    - decl DeclId

` Whether a declaration is a method called on a receiver: read as a value by its name
` alone, it binds the receiver of the function that reads it.
do match? program.modules[owner].decls[decl]
    | .decl-function(fn)
        = fn.owner != 0 && !fn.is-static && fn.kind == .function-decl
= false

────────────────────
_ names-module-accessor Bool
    - owner ModuleId
    - decl DeclId

match program.modules[owner].decls[decl]
    | .decl-function(fn)
        fn.owner == 0 && (fn.kind == .getter-decl || fn.kind == .setter-decl)
    ??
        false

────────────────────
_ do note-plain
    - id SyntaxId
    - name Atom

` Says of a name read that reading it evaluates nothing: a local or an argument that is not
` lazy, a global its module gives its value as it starts, a property the receiver stores as
` it is constructed, or a name of no value. A lazy one, and one kept in a way of its own, is
` evaluated where it is read. A property of the name of one some class derives may be
` evaluated again as it is read, so the reader may panic.
. resolution = bindings.resolution-of(frame.binding, id)
. plain = true
do match? resolution.kind
    |= .resolve-slot
        plain = bindings.slots[resolution.slot].kind != .slot-lazy
    |= .resolve-global
        plain = types.is-literal-global(resolution.module, resolution.decl)
        do match? program.modules[resolution.module].decls[resolution.decl]
            | .decl-property(row)
                if row.owner == 0 && row.decoration == null && row.name && !row.is-lazy
                    plain = true
    |= .resolve-member
        . found = property-named(frame.self-type, name) if frame.self-type != no-type
        plain = found != null && types.properties[found].storage-kind == .storage-eager
        if plain && program.is-derived-name(name) && types.intrinsic-of(frame.self-type) == .class
            instances.mark-may-panic(instance)
if plain
    facts.mark-plain(instance, id)

────────────────────
_ do note-case-read
    - id SyntaxId
    - slot SlotId
    - read TypeId

` Plans the read of a local that holds a union and is known to hold one case of it as the
` read of that case, and one known to hold cases of classes that derive from the class of one
` of them, read as that class, as the read of that one (`Narrowing.common-base`). One known to
` hold cases of classes that a class derives from or that derive from it, read as that class
` once a test for it holds, is read through the case `Narrowing.line-case` picks. A local that
` holds an optional of a union, known to hold a value that is one case, is planned the same. A
` local of an enclosing function is planned from the frame that declares it, as `read-slot` types it.
. home = slot-frame(slot)
plan-case-read(id, home.known(slot), home.narrowed-cases(slot-key(slot)), read)

────────────────────
_ narrowed-from TypeId
    - key NarrowingKey
    - receiver TypeId
    - name Atom

|? is-path-key(key)
    frame.path-declared-type(key)
|? declared != no-type || receiver == no-type || receiver == invalid-type
    declared
??
    if found then types.properties[found].type else no-type

.. declared = key-declared(key)
.. found = property-named(receiver, name)

────────────────────
_ do plan-case-read
    - id SyntaxId
    - declared TypeId
    - held U64
    - read TypeId

if read == declared || declared == no-type || declared == invalid-type
    =
if types.is-optional(declared)
    declared = types.optional-inner(declared)
if read == declared || types.intrinsic-of(declared) != .union
    =
. cases = types.completion-of(declared).cases
. based = narrowing.common-base(cases, held) == read
for offset in 0 .. < cases.count
    . bit = if offset < 64 then 1u64 /lshift/ offset else 0
    . base = based && (held /and/ bit) != 0 && types.cases[cases.start + offset].type == read
    if bit != 0 && (held == bit || base)
        facts.set-constant(instance, id, ConstantFact(offset, 0.0, null, false), .plan-case-read)
        =
. lined = narrowing.line-case(cases, held, read)
if held != 0 && lined != U32.max
    facts.set-constant(instance, id, ConstantFact(lined, 0.0, null, false), .plan-case-read)

────────────────────
_ slot-frame Frame
    - slot SlotId

if outer && frame.is-captured(slot) then outer.slot-frame(slot) else frame

────────────────────
_ do pointer-to TypeId
    - target TypeId

if target == invalid-type || target == no-type
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(target)
= types.class-named-with-args(module, types.cpointer-atom!, mark)

────────────────────
_ do sized-array TypeId
    - id SyntaxId
    - object TypeId
    - key-syntax SyntaxId
    - key TypeId

` An array of a type made with a count of an integer type takes the count as a `Size`, which
` it converts to as an argument does.
if types.intrinsic-of(object) != .type-info
    = no-type
. item-type = type-info-about(object)
if item-type == invalid-type
    = no-type
. mark = scratch.types.mark
scratch.types.push(item-type)
. pattern = types.class-named-with-args(module, types.array-atom!, mark)
if pattern == invalid-type
    = no-type
. count = key
if is-integer(key) && key != types.size-type
    count = conversions.convert(key-syntax, key-syntax, key, types.size-type, .reason-argument)
    if count == invalid-type
        = invalid-type
. shapes-start = scratch.call-arguments.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. types-start = scratch.types.mark
scratch.types.push(count)
. syntax-start = scratch.syntax.mark
scratch.syntax.push(key-syntax)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. result = calls.construction-on(id, pattern, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do type-info-of TypeId
    - id SyntaxId
    - about TypeId

if about == invalid-type
    decline(id)
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(about)
= types.class-named-with-args(module, types.type-info-atom!, mark)

────────────────────
_ do type-info-about TypeId
    - info TypeId

do match? types.rows[info]
    | .type-class(row)
        if row.args.count == 1
            = types.child-type(row.args, 0)
= invalid-type

────────────────────
_ do static-get TypeId
    - id SyntaxId
    - about TypeId
    - name Atom

if about == invalid-type
    = invalid-type
. completion = types.completion-of(about)
if completion.intrinsic == .union
    for fact in types.cases[completion.cases]
        if fact.name && fact.name! == name
            . valued = (enum-case-value(about, name) ?? 0) != 0
            if valued
                note-enum-case(about, name, id)
                = about
            if fact.is-default || fact.type == no-type
                note-case(id, about, name)
                = about
            decline(id)
            = invalid-type
if completion.has-enums && enum-case-decl(types, program, about, name)
    note-enum-case(about, name, id)
    = about
if name == types.max-atom! || name == types.min-atom!
    . root = number-root(about)
    if root == invalid-type
        = invalid-type
    note-limit(id, root, name == types.max-atom!)
    = about
if name == types.size-atom!
    if is-numeric(types, about) && completion.bit-size != 0
        note-integer(id, (completion.bit-size + 7) / 8)
    else
        facts.set-plan(instance, id, .plan-type-size)
    = types.size-type
if is-type-info-text(name)
    note-type-text(id, about, name)
    = types.string-type
if is-type-info-flag(name)
    note-type-flag(id, about, name)
    = types.bool-type
if name.text == "bit-width"
    if !is-integer-kind(completion.intrinsic) && completion.intrinsic != .cpointer
        frame.diagnose(id, .stated, program.store-atom("Integer type required for bit-width"))
        = invalid-type
    note-integer(id, completion.bit-size)
    = types.type-row(.int64)
if name.text == "probe-data-type"
    note-integer(id, probe-data-type(types, about))
    = types.type-row(.int64)
if name.text == "properties"
    . listed = types.well-known-type("core/type", "PropertyList")
    if listed != invalid-type
        facts.note-properties-read(about)
        facts.set-plan(instance, id, .plan-type-properties)
        = listed
if name.text == "base"
    . base = types.base-of(about)
    if !base
        frame.diagnose(id, .stated, program.store-atom("No base type"))
        = invalid-type
    facts.set-plan(instance, id, .plan-type-base)
    = type-info-of(id, base)
frame.diagnose(id, .property-not-found, name)
= invalid-type

────────────────────
_ do note-integer
    - id SyntaxId
    - value U64

` Records an integer as the constant a node answers with.
facts.set-constant(instance, id, ConstantFact(value, 0, null, false))

────────────────────
_ do note-limit
    - id SyntaxId
    - root TypeId
    - is-max Bool

` Records the greatest or the least value of a number type as the constant its node answers
` with: the greatest and least finite values of a float.
. row = types.completions[root]
if intrinsic-is-float(row.intrinsic)
    . limit = if row.bit-size == 32 then 3.402823466e+38 else 1.7976931348623157e+308
    facts.set-constant(instance, id, ConstantFact(0, if is-max then limit else -limit, null, true))
else if is-integer-kind(row.intrinsic)
    note-integer(id, integer-limit(row.bit-size, row.is-signed && row.bit-size != 1, is-max))

────────────────────
_ do note-type-text
    - id SyntaxId
    - about TypeId
    - name Atom

` Records the name or the key of a type as the constant its node answers with. A class of
` objects and an interface answer the concrete ones from the value, so they have no constant,
` and neither has a type with arguments or one that is not a class. A concrete one with no
` constant is planned as read from the value, and the name or the key with none as the text
` of the type. The name inlining knows of a value of an interface has no constant either.
. kind = types.completion-of(about).intrinsic
. is-concrete = name.text == "concrete-name" || name.text == "concrete-key"
. is-inlined = name.text == "inlined-name"
. constant = !(is-concrete && (intrinsic-is-class(kind) || kind == .interface)) && not-inlined
    .. not-inlined = !(is-inlined && kind == .interface)
do match types.rows[about]
    | .type-class(row)
        if row.args.count != 0
            constant = false
    ??
        constant = false
if !constant
    if is-concrete
        facts.set-plan
            - instance
            - id
            - if name.text == "concrete-name" then .plan-concrete-name else .plan-concrete-key
    else if is-inlined && kind == .interface
        facts.set-plan(instance, id, .plan-inlined-name)
    else if name.text == "name" || is-inlined
        facts.set-plan(instance, id, .plan-type-name)
    else if name.text == "key"
        facts.set-plan(instance, id, .plan-type-key)
    =
. is-key = name.text == "key" || name.text == "concrete-key"
. text = if is-key then type-key(types, about) else type-short-name(types, about)
facts.set-constant(instance, id, ConstantFact(0, 0, program.store-atom(text), false))

────────────────────
_ do note-type-flag
    - id SyntaxId
    - about TypeId
    - name Atom

` Records what a type answers to a question about its kind as the constant of the node. A
` pointer is an integer without a sign. Every type is read-only but a class, a struct and a
` `TableField`, as TypeScript says.
. row = types.completion-of(about)
. kind = row.intrinsic
. numeric = is-numeric(types, about)
. asked = name.text
if asked == "read-only"
    . writable = kind == .class || kind == .struct || kind == .table-column
    note-integer(id, if writable then 0 else 1)
    =
. answer = kind == .struct
if asked == "is-integer"
    answer = is-integer-kind(kind) || kind == .cpointer
else if asked == "is-number"
    answer = numeric || kind == .cpointer
else if asked == "is-signed"
    answer = numeric && row.is-signed
else if asked == "is-tuple"
    answer = intrinsic-is-tuple-like(kind) && kind != .struct
note-integer(id, if answer then 1 else 0)

────────────────────
_ is-type-info-text Bool
    - name Atom

match name.text
    |= "name"
        true
    |= "inlined-name"
        true
    |= "concrete-name"
        true
    |= "concrete-key"
        true
    |= "key"
        true
    ??
        false

────────────────────
_ is-type-info-flag Bool
    - name Atom

` The Bool facts a type's info answers in the reference: `Item.is-integer` and its kin.
match name.text
    |= "is-integer"
        true
    |= "is-number"
        true
    |= "is-signed"
        true
    |= "is-tuple"
        true
    |= "is-struct"
        true
    |= "read-only"
        true
    ??
        false

────────────────────
_ do enum-case-value SyntaxId?
    - about TypeId
    - name Atom

. member = enum-case-decl(types, program, about, name)
if !member
    = null
. ref = class-ref(types, about)
do match? program.modules[ref.module].decls[member]
    | .decl-case(row)
        = row.value
= null

────────────────────
_ do number-root TypeId
    - about TypeId

. current = about
while true
    . kind = types.completions[current].intrinsic
    if kind == .bool
        = types.bool-type
    if types.type-row(kind) == current
        = current
    . base = types.base-of(current)
    if !base
        = invalid-type
    current = base

────────────────────
_ do cpointer-item TypeId
    - receiver TypeId

types.complete(receiver)
if types.completions[receiver].intrinsic != .cpointer
    = no-type
= pointee-of(types, receiver)

────────────────────
_ core-literal-type TypeId
    - owner U32
    - property DeclId

|? owner != types.core-module
    no-type
??
    match target.decls[property]
        | .decl-property(row)
            |? row.name == types.true-atom || row.name == types.false-atom
                types.bool-type
            |? row.name == types.null-atom
                types.null-type
            ??
                no-type
        ??
            no-type

.. target = program.modules[owner]

────────────────────
_ do read-member Found
    - id SyntaxId
    - name Atom
    - want Want = Want()

. receiver = frame.self-type
if receiver == no-type || receiver == invalid-type
    = Found(invalid-type)
. resolution = bindings.resolution-of(frame.binding, id)
if resolution.kind == .resolve-member && frame.is-doubted(member-key(resolution.decl))
    decline(id)
    = Found(invalid-type)
if resolution.kind == .resolve-member && frame.members-narrowed
    . key = member-key(resolution.decl)
    . narrowed = forced-member(id, key, want)
    if narrowed != no-type
        plan-case-read(id, narrowed-from(key, receiver, name), frame.narrowed-cases(key), narrowed)
        = Found(narrowed).holding(want.asks(.want-forced))
= read-property(id, id, receiver, name, want)

────────────────────
_ do forced-member TypeId
    - id SyntaxId
    - key NarrowingKey
    - want Want

` What the flow knows a property or a path to hold at a read of it. A read in the value of a lazy
` local of one a test the value made narrowed is noted as one that holds wherever the value is
` evaluated (`note-inside-read`), as a local's is.
. held = if !want.asks(.want-forced) then frame.narrowed-member(key) else frame.held-member(key)
if held != no-type && lazy-marks.length != 0 && narrowed-inside
    facts.note-inside-read(instance, id)
.. narrowed-inside = scratch.narrowed-since(lazy-marks[lazy-marks.length - 1], key) != no-type
= held

────────────────────
_ do note-lazy-read TypeId
    - id SyntaxId
    - property TypeProperty
    - receiver TypeId
    - name Atom

` A read of a lazy property evaluates its value when the object has none yet. The reference
` reads it by a call, which ends what is known of properties. The reader may panic where the
` value does, and always when the class of the object chooses the value: a class derived from
` the receiver's may write another. The errors the value lets out leave the reader at the read,
` which gives the value, as a call does; under `catch` the read gives the value or one of the
` errors, which is answered. A value that lets out errors for a class that the class of the
` object may not be is not typed here.
frame.forget-members()
if calls.is-virtual-receiver(receiver)
    instances.mark-may-panic(instance)
last-unit = no-instance
. value = demand-member(property, receiver, name)
. unit = last-unit
if unit == no-instance || unit == instance
    = no-type
panics.note-lazy-read(instance, unit)
. virtual = calls.is-virtual-receiver(receiver)
if !instances.errors-known(unit) && (frame.surround.catch-depth != 0 || virtual)
    demand-errors(unit)
. known = instances.errors-known(unit)
if known && instances.signatures[unit].errors.count == 0
    = no-type
if virtual || (!known && frame.surround.catch-depth != 0)
    decline(id)
    = no-type
if !known
    defer-outgoing(unit, id)
    = no-type
. signature = instances.signatures[unit]
if frame.surround.catch-depth != 0
    = result-type(types, value, calls.error-items(signature))
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], id)
= no-type

────────────────────
_ do read-property Found
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - want Want = Want()

. rows = forwarded-row
forwarded-row = no-type
. held = case-row
case-row = null
. receiver-kind = types.intrinsic-of(receiver)
if name == types.address-atom! && cpointer-item(receiver) != no-type
    facts.set-plan(instance, id, .plan-address)
    = Found(types.type-row(.uint64))
if receiver-kind == .atom
    if name == types.address-atom!
        facts.set-plan(instance, id, .plan-address)
        = Found(types.type-row(.uint64))
    if name == types.text-atom!
        facts.set-plan(instance, id, .plan-reinterpret)
        = Found(types.string-type)
. viewed = view-field(receiver, name)
if viewed != no-type
    . item = row-struct-of(receiver)
    plan-view(id, types.properties[property-named(item, name)!].slot)
    = Found(viewed)
if (is-column-receiver(receiver-kind) || columns || is-index-reader(receiver-kind)) && length-name
    plan-table(id, .table-length)
    = Found(types.size-type)
.. columns = receiver-kind == .table-column || receiver-kind == .immutable-table-column
.. length-name = name == types.length-atom! || name.text == "size"
. found = property-named(receiver, name)
if found && is-hidden(types.properties[found], name) && row-answers(receiver, name)
    found = null
if found
    . property = types.properties[found]
    if is-hidden(property, name)
        . message = privacy-message(property, name)
        if id == object-syntax
            message = "Name not found"
        frame.diagnose(id, .stated, program.store-atom(message))
        = Found(invalid-type)
    if calls.ranking.has-extension-getter(receiver, name)
        frame.diagnose(id, .extension-conflict)
        = Found(invalid-type)
    if receiver-kind == .table-column && name == types.data-atom!
        plan-table(id, .table-data)
    if receiver-kind == .table && property.storage-kind == .storage-getter
        . getter = table-member(name.text)
        if getter == TableOp.table-mark || getter == TableOp.table-capacity
            plan-table(id, getter)
    if property.storage-kind == .storage-getter && !is-array-field(receiver, name)
        . capture = if held then held else row-capture-of(if object-syntax != id then object-syntax else 0)
        = Found(calls.getter-call(id, object-syntax, receiver, name, capture))
    if property.storage-kind == .storage-getter
        . place U64 = if name == types.data-atom! then 0 else 1
        facts.set-constant(instance, id, ConstantFact(place, 0, null, false), .plan-field)
    if property.storage-kind == .storage-lazy && !assigns-plainly
        . caught = note-lazy-read(id, property, receiver, name)
        if caught != no-type
            = Found(caught)
    if property.storage-kind == .storage-eager
        facts.mark-plain(instance, id)
        if !assigns-plainly && receiver-kind == .class && program.is-derived-name(name)
            instances.mark-may-panic(instance)
        if !assigns-plainly && id != rebound-root && unplanned && names-element(types, property) && !keeps-whole(name)
            instances.mark-may-panic(instance)
            facts.set-plan(instance, id, .plan-guarded-read)
        .. unplanned = facts.plan-of(instance, id) == .plan-none
    if property.type == no-type
        = Found(demand-member(property, receiver, name))
    = Found(property.type)
. shared-field = row-case-field(id, receiver, name)
if shared-field != no-type
    = Found(shared-field)
. places [U32]
. holder = calls.ranking.delegated-holder(receiver, name, places)
. reached = property-named(holder, name) if holder != no-type && places.length != 0
if reached && types.properties[reached].storage-kind != .storage-getter && !is-hidden(types.properties[reached], name)
    if calls.ranking.has-extension-getter(receiver, name)
        frame.diagnose(id, .extension-conflict)
        = Found(invalid-type)
    . read = read-property(id, object-syntax, holder, name, want)
    if read.type != invalid-type
        facts.set-through(instance, id, places, calls.step-getters(places))
    = read
if intrinsic-is-class(receiver-kind)
    . member = object-member(id, name)
    if member != no-type
        if calls.ranking.has-extension-getter(receiver, name)
            frame.diagnose(id, .extension-conflict)
            = Found(invalid-type)
        = Found(member)
if calls.has-getter(receiver, name)
    . capture = if held then held else row-capture-of(if object-syntax != id then object-syntax else 0)
    = Found(calls.getter-call(id, object-syntax, receiver, name, capture))
if receiver-kind == .union
    . built = union-property(id, receiver, name)
    if built != no-type
        = Found(built)
    if calls.getter-gap(receiver, name) == null
        . results [TypeId]
        for index in 0 .. < types.cases-of(receiver).length
            . payload = types.cases-of(receiver)[index].type
            if rows != no-type
                case-row = RowCapture(rows, index as U32, true)
            . got = read-property(id, object-syntax, payload, name, want).type
            if got == invalid-type
                = Found(invalid-type)
            if results.find(got) == null
                results += got
        facts.set-plan(instance, id, .plan-forward)
        = Found(calls.forward-results(id, results))
if receiver-kind == .optional
    if name == types.value-atom!
        = Found(types.optional-inner(receiver))
    if name == types.has-value-atom!
        = Found(types.bool-type)
if receiver-kind == .type-info
    = Found(static-get(id, type-info-about(receiver), name))
if name.text == "unit" && is-numeric(types, receiver)
    facts.set-plan(instance, id, .plan-unit-name)
    = Found(types.string-type)
. views = array-views(receiver, name)
if views != no-type
    if !is-view-item(row-struct-of(views))
        . message = "Array views require a fixed-layout product aggregate"
        frame.diagnose(id, .stated, program.store-atom(message))
        = Found(invalid-type)
    plan-view(id)
    frame.check-allocates(id)
    = Found(views)
if name == types.length-atom! && (receiver-kind == .tuple || receiver-kind == .struct)
    . arity = tuple-arity(receiver)
    if arity != U32.max
        note-integer(id, arity)
    = Found(types.type-row(.int64))
if name.text == "layout" && receiver-kind == .table
    plan-table(id, .table-layout)
    = Found(types.string-type)
if is-column-receiver(receiver-kind)
    . column = column-field-type(receiver, name)
    if column != no-type
        . immutable = receiver-kind == .immutable-table || receiver-kind == .immutable-table-span
        . row = row-struct-of(receiver)
        if types.intrinsic-of(row) == .struct
            plan-table(id, .table-column, types.properties[property-named(row, name)!].slot)
        else if types.intrinsic-of(row) == .union
            . first = types.cases-of(row)[0].type
            . shared = property-named(first, name)
            if shared
                plan-table(id, .table-column, types.properties[shared].slot)
        = Found(types.column-view-of(column, immutable))
if receiver-kind == .table-row || receiver-kind == .immutable-table-row
    . row = row-struct-of(receiver)
    if row != no-type && types.intrinsic-of(row) == .union
        if has-case-getter(row, name)
            forwarded-row = receiver
            = read-property(id, object-syntax, row, name, want)
    . column = property-named(row, name) if row != no-type
    if column
        . field = types.properties[column]
        if is-hidden(field, name)
            frame.diagnose(id, .stated, program.store-atom(privacy-message(field, name)))
            = Found(invalid-type)
        if field.storage-kind == .storage-eager
            if types.intrinsic-of(row) == .struct
                plan-table(id, .table-field, field.slot)
            if field.type == no-type
                = Found(demand-member(field, row, name))
            = Found(field.type)
if declares-event(receiver, name)
    = read-event(id, receiver, name, want)
. bound = calls.method-binding(receiver, name, id)
if bound != no-type
    = Found(bound)
. gap = calls.getter-gap(receiver, name) if receiver-kind == .union
if gap
    frame.diagnose(id, .stated, program.store-atom(gap), receiver)
    frame.mention(calls.case-types(receiver))
    = Found(invalid-type)
if is-batch-flush(receiver)
    . (domain, below) = accessor-domain(name.text)
    if domain.length != 0 && !below
        = Found(flush-flag(id, domain))
if names-unmodeled-style(receiver, name, id)
    decline(id)
    = Found(invalid-type)
frame.diagnose(id, .property-not-found, name)
= Found(invalid-type)

────────────────────
_ do flush-flag TypeId
    - id SyntaxId
    - domain String

` A flag of a domain a `MarkupBatchFlush` reports, `is-X-invalid`, as the reference reads it:
` whether the bit of the domain, numbered as it is first named, is set in the mask of the
` domains the flush left pending.
. index = style-domain(program.store-atom(domain), module, id, module, id)
facts.style-flags += StyleFlag(instance, id, index, no-instance)
= types.bool-type

────────────────────
_ is-batch-flush Bool
    - type TypeId

` Whether a type is the `MarkupBatchFlush` of the markup runtime, which a program that loads no
` markup has none of.
flush.decl != 0 && same-decl(class-ref(types, type), flush)

.. flush = types.markup-batch-flush-decl

────────────────────
_ do property-named Index?
    - id TypeId
    - name Atom

` The place of a property of a type by a name, as the module being typed sees it.
= types.property-seen(id, name, module)

────────────────────
_ do is-hidden Bool
    - fact TypeProperty
    - name Atom
    - accessor DeclKind = .getter-decl

` Whether a property, or the getter or setter that answers for it, is out of reach of the module
` using it, as `hiding-access` finds it.
= hiding-access(fact, name, accessor) != null

────────────────────
_ do hiding-access Access?
    - fact TypeProperty
    - name Atom
    - accessor DeclKind = .getter-decl

` The access that keeps a property, or the getter or setter that answers for it, from the module
` using it: private to another module, or shared with a file family not this one's. One a markup
` element's name declares is not kept (`PropertyDecl.element`). A module that declares a facet of a
` class reaches the private members of the class, but a facet's private members are its own
` module's.
. ref = declaring-decl(types, fact)
if ref.module == module || (ref.module == 0 && ref.decl == 0)
    = null
if fact.facet == U32.max && program.reaches-private(module, ref.module)
    = null
. owner-module = program.modules[ref.module]
. members = match owner-module.decls[ref.decl]
    | .decl-class(row)
        row.members
    | .decl-extension(row)
        row.members
    ??
        RowRange'DeclId()
for member in owner-module.members-named(members, name)
    do match? owner-module.decls[member]
        | .decl-property(property)
            if property.name && property.name == name
                =? null if property.element != 0
                = shut-access(property.access, ref.module)
        | .decl-function(fn)
            if fn.kind == accessor && fn.name && fn.name == name
                = shut-access(fn.access, ref.module)
= null

────────────────────
_ do shut-access Access?
    - access Access
    - other ModuleId

` An access that keeps a member of another module from this one, once `reaches-private` has had
` its say: private, or shared with a file family not this one's.
if access is .public-access || (access is .family-access && program.same-family(module, other))
    = null
= access

────────────────────
_ do privacy-message String
    - fact TypeProperty
    - name Atom
    - accessor DeclKind = .getter-decl

` What an error says of a property `is-hidden` keeps from this module.
= hidden-message("Property", name, hiding-access(fact, name, accessor) ?? Access.private-access)

────────────────────
_ hidden-message String
    - kind String
    - name Atom
    - access Access

` What an error says of a member another module keeps from this one: that it is private, or that
` it is shared with a file family not this one's.
|? access is .private-access
    "$kind \"${name.text}\" is private"
??
    "$kind \"${name.text}\" is shared, declared with ^, so only its own file family can use it"

────────────────────
_ do union-property TypeId
    - id SyntaxId
    - receiver TypeId
    - name Atom

` What a union answers by itself, planned at the node that reads it: the number of the case
` it holds, that case's name, the key of its type, or what the union holds as a case named.
` Where it holds another case, a case named gives what its type makes with nothing written,
` whose construction is recorded at the node.
if name.text == "case"
    facts.set-plan(instance, id, .plan-case-number)
    = types.type-row(.uint8)
if name.text == "name" || name.text == "type"
    facts.set-plan(instance, id, if name.text == "name" then .plan-case-name else .plan-case-type)
    = types.string-type
. cases = types.cases-of(receiver)
for index in 0 .. < cases.length
    . fact = cases[index]
    if fact.name && fact.name! == name
        facts.set-constant
            - instance
            - id
            - ConstantFact(index as U64, 0.0, null, false)
            - .plan-case-value
        construct-value(id, fact.type)
        = if fact.type != no-type then fact.type else types.type-row(.uint8)
= no-type

────────────────────
_ do aggregate-field TypeId
    - receiver TypeId
    - key-syntax SyntaxId
    - key TypeId
    - operator Atom
    - value TypeId = no-type

` A tuple or struct class with no index operator of its own answers a constant index with the
` field at that position.
. kind = types.intrinsic-of(receiver)
if kind != .tuple && kind != .struct
    = no-type
if calls.has-operator(receiver, operator, key, value) || indexes-itself(receiver)
    = no-type
= eager-field(receiver, key-syntax)

────────────────────
_ do indexes-itself Bool
    - receiver TypeId

` Whether the class of a type, or a base of it, declares an index operator of its own.
. level TypeId? = receiver
while level
    do match? types.rows[level]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(body)
                    =? true if owner.first-member(body.members, types.index-op-atom!) != no-member
    level = types.base-of(level)
= false

────────────────────
_ do eager-type TypeId
    - item TypeId
    - property TypeProperty

if property.storage-kind != .storage-eager
    = no-type
if property.type == no-type
    = demand-member(property, item, property.name)
= property.type

────────────────────
_ do eager-field TypeId
    - item TypeId
    - key-syntax SyntaxId

do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if literal.negative || literal.overflow
            = no-type
        types.complete(item)
        . range = types.completions[item].properties
        . position = 0u32
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind == .storage-eager
                if position == literal.value
                    = eager-type(item, property)
                position += 1
= no-type

────────────────────
_ do eager-slot U32
    - item TypeId
    - key-syntax SyntaxId

` The place in an item's layout of the stored field a constant index names.
do match? tree.nodes[key-syntax]
    | .node-integer-syntax(row)
        . literal = parse-integer-literal(row.value)
        if literal.negative || literal.overflow
            = U32.max
        types.complete(item)
        . range = types.completions[item].properties
        . position = 0u32
        for offset in 0 .. < range.count
            . property = types.properties[(range.start + offset) as Index]
            if property.storage-kind == .storage-eager
                if position == literal.value
                    = property.slot
                position += 1
= U32.max

────────────────────
_ do published-payload TypeId
    - target SyntaxId

` What an event publishes, when a write names an event of this object or of a local one, and
` no type when it names anything else.
. receiver = no-type
. name Atom? = null
do match? tree.nodes[target]
    | .node-identifier(row)
        if bindings.resolution-of(frame.binding, target).kind == .resolve-member
            receiver = frame.self-type
            name = row.name
    | .node-get-expression(get)
        . simple = match tree.nodes[get.object]
            | .node-identifier
                true
            ??
                false
        if simple && !get.is-optional
            receiver = infer(get.object)
            name = get.name
if !name || receiver == no-type || receiver == invalid-type
    = no-type
if types.is-optional(receiver)
    receiver = types.optional-inner(receiver)
= event-payload(receiver, name)

────────────────────
_ event-payload TypeId
    - receiver TypeId
    - name Atom

if found then found.payload else no-type

.. found = event-of(receiver, name)

────────────────────
_ do event-of NamedEvent?
    - receiver TypeId
    - name Atom
    - anywhere Bool = false

` The event of this name a class declares or inherits, or an interface it is of declares, as
` the type that declares it has it, or none where none does, or one it keeps from the module
` asking, unless it is asked for `anywhere`.
for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            . found = declared-event(row.module, row.decl, name)
            if found
                . home = found.module
                do match? program.modules[home].decls[found.decl]
                    | .decl-event(event)
                        . hidden = !program.reaches-access(module, home, event.access)
                        if hidden && !anywhere
                            = null
                        . private = !(event.access is .public-access)
                        = NamedEvent
                            - cursor
                            - name
                            - declared-payload(cursor, event.type-syntax, home)
                            - declared-key(cursor, event.key-type, home)
                            - 0
                            - private
= null

────────────────────
_ do declared-event DeclRef?
    - class-module ModuleId
    - class-decl DeclId
    - name Atom

` The event of a name a class declares, in its body or in a facet of it this module sees, as the
` module and the declaration that declare it.
. target = program.modules[class-module]
do match? target.decls[class-decl]
    | .decl-class(class)
        =? DeclRef(class-module, found) if found
        .. found = member-event(target, class.members, name)
. facets = program.facets
=? null if facets.count == 0
. (start, end) = facets.class-range(class-module, class-decl)
for position in start .. < end
    . facet = facets.class-facets[position]
    if facets.states[facet] == .facet-bound && program.sees-facet(module, facet)
        . home = facets.modules[facet]
        do match? program.modules[home].decls[facets.decls[facet]]
            | .decl-extension(row)
                =? DeclRef(home, found) if found
                .. found = member-event(program.modules[home], row.members, name)
= null

────────────────────
_ do member-event DeclId?
    - target Module
    - members RowRange'DeclId
    - name Atom

` The event of a name among a class's or a facet's members.
for member in target.members-named(members, name)
    do match? target.decls[member]
        | .decl-event(event)
            =? member if event.name == name
= null

────────────────────
_ do event-chain [TypeId]
    - receiver TypeId

` The types whose declared events a type has: the type, the classes above it, and the
` interfaces each of them is of, each once.
. chain [TypeId]
. cursor = receiver
while cursor != no-type
    chain += cursor
    cursor = types.base-of(cursor) ?? no-type
. index Index = 0
while index < chain.length
    for interface in types.interfaces-of(chain[index])
        . known = false
        for held in chain
            known = known || held == interface
        if !known
            chain += interface
    index += 1
= chain

────────────────────
_ do read-event Found
    - id SyntaxId
    - receiver TypeId
    - name Atom
    - want Want

` A node that names an event of an object, which is used as `use-event` says. One private to
` another module is an error at its declaration, as the reference finds it.
. found = event-of(receiver, name)
if !found && hides-event(receiver, name)
    = Found(invalid-type)
if !found || found.payload == no-type
    decline(id)
    = Found(invalid-type)
= use-event(id, found, want)

────────────────────
_ do hides-event Bool
    - receiver TypeId
    - name Atom

` Whether the event of this name a class declares or inherits, or an interface it is of
` declares, is kept from this module, which is reported where the event is declared.
for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            . found = declared-event(row.module, row.decl, name)
            if found
                . home = found.module
                do match? program.modules[home].decls[found.decl]
                    | .decl-event(event)
                        if !program.reaches-access(module, home, event.access)
                            . message = program.store-atom(hidden-message("Event", name, event.access))
                            facts.record-diagnostic(instance, home, event.syntax, .stated, message)
                            = true
= false

────────────────────
_ do use-event Found
    - id SyntaxId
    - event NamedEvent
    - want Want

` A node that names an event, where something uses it as the reference does: a write that
` publishes to it, a loop that subscribes to it, an index that addresses it with a key, or
` `rekey` or `release` of an address asks for it at the node, and a value of the event's
` `Broadcastable`, an argument of a call, as the reference gives an event to a parameter, or the
` container of a comprehension on a stream, takes its endpoint. The node has that
` `Broadcastable`'s type. So has one in an argument of a call of a name nothing declares, which
` is reported as no function found (`names-nothing`). One used as a value is reported as
` `refuse-event-value` says (`misused-event`), and an argument one converted by a converter as
` `misused-endpoint` says, and one read with `<-` as `refuse-event-read` says. The value stored
` in a property is taken once the property is known (`store-event`). Naming an event anywhere
` else, a keyed one with no address among them, is not supported.
. broadcastable = endpoint-of(event)
if broadcastable == invalid-type
    decline(id)
    = Found(invalid-type)
if want.asks(.want-event)
    = Found(broadcastable, no-type, found-event(event))
if want.asks(.want-adapt)
    escape-event(id, event, broadcastable, id)
    = Found(broadcastable)
if want.asks(.want-escape) && want.type == broadcastable
    escape-event(id, event, broadcastable, want.place)
    = Found(broadcastable)
if misused-event(id, broadcastable, want)
    refuse-event-value(id, event.owner, event.name)
    = Found(invalid-type)
if want.asks(.want-store)
    = Found(broadcastable, no-type, found-event(event))
if argument-typing.unknown-callee
    = Found(broadcastable)
if want.asks(.want-argument) && (event.key == no-type || event.address != 0)
    escape-event(id, event, broadcastable, id)
    endpoint-arguments += id
    endpoint-events += event
    = Found(broadcastable)
if tree.reads-once(id)
    refuse-event-read(id, event.owner, event.name)
    = Found(invalid-type)
frame.diagnose(id, .not-supported)
= Found(invalid-type)

────────────────────
_ do address-event Found
    - id SyntaxId
    - key-syntax SyntaxId
    - is-optional Bool
    - event NamedEvent
    - want Want

` A keyed event indexed with a key, as the reference addresses one: the key is converted at
` its node to the event's key type, and the index names the event at that address, used as
` `use-event` says. A negative number written as the key is not supported, which the
` reference checks against the `U64` the address holds as well and rejects.
if is-optional
    frame.diagnose(id, .stated, program.store-atom("Addressed event lookup cannot be optional"))
    = Found(invalid-type)
if event.address != 0
    frame.diagnose(id, .stated, program.store-atom("An addressed event cannot be indexed again"))
    = Found(invalid-type)
if event.key == no-type
    frame.diagnose(id, .stated, program.store-atom("Event \"${event.name.text}\" is not keyed"))
    = Found(invalid-type)
if event.key == invalid-type || !event-key(event.key)
    decline(id)
    = Found(invalid-type)
. key = infer(key-syntax)
if key == invalid-type || conversions.convert(key-syntax, key-syntax, key, event.key, .reason-argument) == invalid-type
    = Found(invalid-type)
if negative-literal(key-syntax)
    decline(key-syntax)
    = Found(invalid-type)
= use-event(id, NamedEvent(event.owner, event.name, event.payload, event.key, id, event.is-private), want)

────────────────────
_ do negative-literal Bool
    - id SyntaxId

` Whether a node is a negative number written in source.
do match? tree.nodes[id]
    | .node-integer-syntax(row)
        = parse-integer-literal(row.value).negative
    | .node-unary-expression(row)
        if row.op == .negative-op
            do match? tree.nodes[row.operand]
                | .node-integer-syntax
                    = true
= false

────────────────────
_ do unaddressed Bool
    - id SyntaxId
    - event NamedEvent

` Whether an event published by key is used with no key, which is an error at the node.
if event.key == no-type || event.address != 0
    = false
frame.diagnose
    - id
    - .stated
    - program.store-atom("Keyed event \"${event.name.text}\" must be addressed with [key]")
= true

────────────────────
_ do publish-event TypeId
    - id SyntaxId
    - reference SyntaxId
    - event NamedEvent
    - arguments Arguments

` A write to an event, as the reference publishes one: what it is given is made the event's
` payload, but only where something listens, which the event runtime answers for the object,
` and the runtime then publishes it. A `RoutedEvent` is always made and published along its
` route of owners, from the object on. An event that bubbles (`event-node`) is published along
` the parents of its object where its payload has no route of its own, and asks whether
` anything listens on the object or anywhere it could bubble to. A keyed event is published at
` its address, where the runtime answers with the generation of the receiver there, and is given
` it to publish with.
if event.payload != types.void-type
    . site = arguments.syntax[0]
    . given = calls.payload-argument(arguments, 0, event.payload)
    if conversions.convert(site, site, given, event.payload, .reason-argument) == invalid-type
        = invalid-type
    note-payload-effects(site, event.name)
if routes(event.payload) && event.key != no-type
    frame.diagnose(id, .stated, program.store-atom("Keyed events cannot use routed publication"))
    = invalid-type
if routes(event.payload)
    . node = event-node(reference, event)
    . mark = scratch.types.mark
    scratch.types.push(event.payload)
    scratch.types.push(types.size-type)
    scratch.types.push(pointer-to(types.type-row(.uint8)))
    if node != no-type
        scratch.types.push(node)
    scratch.types.push(event.payload)
    . routing = if node != no-type then "event-publish-routed-node" else "event-publish-routed"
    . route = calls.demand-runtime-call
        - types.event-endpoint-decl.module
        - no-type
        - program.store-atom(routing)
        - mark
        - 1
    scratch.types.rewind(mark)
    if route == no-instance
        decline(id)
        = invalid-type
    facts.event-uses += EventUse
        - instance
        - id
        - reference
        - event.owner
        - event.name
        - .event-route
        - route
        - no-instance
        - no-instance
        - 0
        - node != no-type
    instances.mark-may-panic(instance)
    = types.void-type
if unaddressed(id, event)
    = invalid-type
. keyed = event.address != 0
. node = if keyed then no-type else event-node(reference, event)
. interest = if keyed then event-call("event-keyed-interest-generation", event.payload, no-type, 2) else event-call(if node != no-type then "event-has-route-interest" else "event-has-interest", no-type)
. publish = no-instance
if keyed
    publish = event-call("event-publish-keyed", event.payload, event.payload, 3)
else if node != no-type
    . mark = scratch.types.mark
    scratch.types.push(event.payload)
    scratch.types.push(pointer-to(types.type-row(.uint8)))
    scratch.types.push(types.size-type)
    scratch.types.push(node)
    scratch.types.push(event.payload)
    publish = calls.demand-runtime-call
        - types.event-endpoint-decl.module
        - no-type
        - program.store-atom("event-publish-node")
        - mark
        - 1
    scratch.types.rewind(mark)
else
    publish = event-call("event-publish", event.payload, event.payload)
if interest == no-instance || publish == no-instance
    decline(id)
    = invalid-type
facts.event-uses += EventUse
    - instance
    - id
    - reference
    - event.owner
    - event.name
    - .event-publish
    - interest
    - publish
    - no-instance
    - event.address
    - node != no-type
instances.mark-may-panic(instance)
= types.void-type

────────────────────
_ do event-node TypeId
    - reference SyntaxId
    - event NamedEvent

` The `EventNode` an event is published along, where it bubbles: one that is public and is
` published by no key, on an object whose class is an `EventNode`, which is converted at the node
` that names the event (`reason-event-node`). No type where it does not bubble.
if event.is-private || event.key != no-type
    = no-type
. node = types.well-known-type("core/event", "EventNode")
if node == invalid-type || node == no-type
    = no-type
. receiver = event-receiver(reference)
if receiver == no-type || receiver == invalid-type || types.intrinsic-of(receiver) != .class
    = no-type
if derived-interface(receiver, class-ref(types, node)) == no-type
    = no-type
if conversions.convert(reference, reference, receiver, node, .reason-event-node) == invalid-type
    = no-type
= node

────────────────────
_ do event-receiver TypeId
    - reference SyntaxId

` The type of the object a node that names an event publishes on, as the emitter evaluates it
` (`Emitter.event-owner`).
do match? tree.nodes[reference]
    | .node-get-expression(get)
        . object = facts.node-type(instance, get.object)
        = link-receiver(get.object, object, no-type, chains-at(reference, get.is-optional))
    | .node-identifier(row)
        if (reference-flags /and/ ResolutionFlag.resolution-received) != 0
            = received-parent(reference, row.name)
        .. reference-flags = bindings.resolution-of(frame.binding, reference).flags
        = frame.self-type
= no-type

────────────────────
_ do note-payload-effects
    - payload SyntaxId
    - event Atom

` Records the effects the payload of an event has (`PayloadEffectFact`), as the reference finds
` them as it makes the payload: a call of a `do` function other than a constructor, an assignment
` used as a value, and a write to a channel, the first of each as the reference meets it. A
` function written in the payload runs where it is called, not where it is made.
if !facts.traces-lint || payload == 0
    =
. written = payload
do match? tree.nodes[payload]
    | .node-argument(row)
        written = row.expr
. start = tree.subtree-start(written)
. firsts [U32]
for _ in 0 .. < 3
    firsts += U32.max
. id = written
while id >= start
    . key = U32.max
    . kind = PayloadEffectKind.effect-call
    . nested = false
    do match? tree.nodes[id]
        | .node-function-syntax
            nested = true
        | .node-assign
            do match tree.nodes[tree.holder-of(id)]
                | .node-block
                    key = U32.max
                ??
                    key = tree.subtree-start(id)
                    kind = .effect-assignment
        | .node-binary-expression(row)
            if row.op == .write-op
                key = tree.subtree-start(id)
                kind = .effect-channel-write
        | .node-call-expression(row)
            do match? tree.nodes[row.callable]
                | .node-get-expression(get)
                    if get.name.text == "<-write" && !get.is-optional
                        key = tree.subtree-start(id)
                        kind = .effect-channel-write
    if nested
        id = tree.subtree-start(id)
    else
        if key != U32.max && key < firsts[kind]
            firsts[kind] = key
        if id < firsts[0] && calls-imperative(id)
            firsts[0] = id
    if id <= start
        break
    id -= 1
while true
    . next = 3u32
    for position in 0 .. < 3
        if firsts[position] != U32.max && (next == 3 || firsts[position] < firsts[next])
            next = position as U32
    if next == 3
        break
    firsts[next] = U32.max
    facts.payload-effects.append
        - PayloadEffectFact(instance, written, event, next as PayloadEffectKind)

────────────────────
_ do calls-imperative Bool
    - id SyntaxId

` Whether a node calls a `do` function other than a constructor, as a function, a method, an
` operator or a static method.
. cursor = facts.first-call(instance, id)
while cursor != no-fact
    . call = facts.calls[cursor]
    cursor = call.next
    . plain = call.form == .call-function || call.form == .call-method
    if call.callee == no-instance || !(plain || operator-or-static)
        continue
    .. operator-or-static = call.form == .call-operator || call.form == .call-static
    . row = instances.rows[call.callee]
    . checked = describe(program, row.module, row.decl)
    if checked && checked.is-imperative && !is-constructor-kind(checked.kind)
        = true
= false

────────────────────
_ do readdress-event TypeId
    - id SyntaxId
    - reference SyntaxId
    - event NamedEvent
    - arguments Arguments
    - rekeys Bool

` `rekey` or `release` of the address of a keyed event, as the reference makes them: the
` receiver, which claimed the endpoint there, gives the address a new key, the call's
` argument converted to the event's key type, or gives it up. The errors `rekey` raises leave
` the function with the call, or under `catch` the call gives nothing or one of them.
. verb = if rekeys then "rekey" else "release"
if event.address == 0
    frame.diagnose(id, .stated, program.store-atom("$verb requires an addressed keyed event"))
    = invalid-type
if rekeys
    . site = arguments.syntax[0]
    if conversions.convert(site, site, arguments.types[0], event.key, .reason-argument) == invalid-type
        = invalid-type
if !is-owner()
    frame.diagnose
        - id
        - .stated
        - program.store-atom("$verb requires the stable target/address lifetime")
    = invalid-type
. called = if rekeys then event-call("event-keyed-rekey", event.payload, no-type, 5) else event-call("event-keyed-release", event.payload, no-type, 3)
if called == no-instance
    decline(id)
    = invalid-type
. caught = frame.surround.catch-depth != 0 && frame.surround.transformer-depth == 0
if caught
    demand-errors(called)
else if !raises-out(id, called)
    decline(id)
    = invalid-type
. kind = if rekeys then EventUseKind.event-rekey else EventUseKind.event-release
facts.event-uses += EventUse
    - instance
    - id
    - reference
    - event.owner
    - event.name
    - kind
    - called
    - no-instance
    - no-instance
    - event.address
instances.mark-may-panic(instance)
. signature = instances.signatures[called]
if caught && signature.errors.count != 0
    = result-type(types, types.void-type, calls.error-items(signature))
= types.void-type

────────────────────
_ do raises-out Bool
    - site SyntaxId
    - callee InstanceId

` Notes the errors a function of the event or markup runtime raises as leaving the function at
` a node, as those of a call written there do. Where they would be caught or transformed there,
` which has no shape here, it says no.
demand-errors(callee)
. signature = instances.signatures[callee]
if signature.errors.count == 0
    = true
if frame.surround.catch-depth != 0 || frame.surround.transformer-depth != 0
    = false
for offset in 0 .. < signature.errors.count
    note-outgoing(instances.signature-types[signature.errors.start + offset], site)
= true

────────────────────
_ routes Bool
    - payload TypeId

` Whether an event's payload is a `RoutedEvent`, which the reference publishes along a route of
` owners.
routed != invalid-type && derived-interface(payload, class-ref(types, routed)) != no-type

.. routed = types.well-known-type("core/event", "RoutedEvent")

────────────────────
_ do event-call InstanceId
    - name String
    - payload TypeId
    - given TypeId = no-type
    - words Size = 0

` A function of the event runtime that compiled code calls of its own accord, for an object and
` the number of one of its events, then as many `U64` words as it is given, the halves of the
` keys of an address, a generation, or the identity of a receiver, then `given` where there is
` one: with `payload` as its type argument where there is one.
. mark = scratch.types.mark
if payload != no-type
    scratch.types.push(payload)
scratch.types.push(pointer-to(types.type-row(.uint8)))
scratch.types.push(types.size-type)
for _ in 0 .. < words
    scratch.types.push(types.type-row(.uint64))
if given != no-type
    scratch.types.push(given)
. explicit Size = if payload != no-type then 1 else 0
. called = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom(name)
    - mark
    - explicit
scratch.types.rewind(mark)
= called

────────────────────
_ do escape-event
    - id SyntaxId
    - event NamedEvent
    - broadcastable TypeId
    - place SyntaxId

` An event made the `Broadcastable` a value is wanted as: the endpoint the event runtime keeps
` for it on the object, made where the node is, converted there. One at the address of a keyed
` event is claimed for the receiver (see `claim-endpoint`), and its key must name what lasts as
` long as the address does. What is wrong with it is an error where the value is converted, at
` the type a declaration states (`place`).
if unaddressed(place, event)
    =
if event.address != 0 && !tree.stable-key(tree.index-key(event.address))
    . message = "A temporary keyed event address cannot escape; declare a stable address key and use that stable addressed lifetime"
    frame.diagnose(place, .stated, program.store-atom(message))
    =
. adapter = if event.address != 0 then event-call("event-keyed-adapter", event.payload, no-type, 3) else event-call("event-adapter", event.payload)
if adapter == no-instance
    decline(id)
    =
if event.address != 0 && !claim-endpoint(id, place, event.address, adapter)
    =
conversions.convert(id, id, instances.signatures[adapter].returns, broadcastable, .reason-argument)
facts.event-uses += EventUse
    - instance
    - id
    - id
    - event.owner
    - event.name
    - .event-escape
    - adapter
    - no-instance
    - no-instance
    - event.address
instances.mark-may-panic(instance)

────────────────────
_ do claim-endpoint Bool
    - site SyntaxId
    - place SyntaxId
    - address SyntaxId
    - made InstanceId

` The endpoint at the address of a keyed event, which `made` gives, claimed for the receiver as
` the reference claims it: the receiver's identity is given for it, its errors leave the
` function at `site`, and a `ClosableTracker` of it, held by a live action of the receiver,
` closes it with the receiver. Says whether it is claimed; it is an error at `place` where
` there is no receiver.
if !is-owner()
    . message = "An addressed event subscription or adapter requires a stable target/address lifetime"
    frame.diagnose(place, .stated, program.store-atom(message))
    = false
demand-live-runtime()
. closable = types.well-known-type("core/stream", "Closable")
. tracking = types.well-known-type("core/tracker", "ClosableTracker")
. tracker = types.well-known-type("core/tracker", "Tracker")
if closable == invalid-type || tracking == invalid-type || tracker == invalid-type || live-missing
    decline(site)
    = false
.. live-missing = instances.live.add-tracker == no-instance || instances.live.action == no-instance
. mark = scratch.types.mark
scratch.types.push(closable)
. closer = calls.demand-constructor(tracking, mark)
scratch.types.rewind(mark)
if closer == no-instance || !raises-out(site, made)
    decline(site)
    = false
. named = tree.index-object(address)
conversions.convert(named, named, instances.signatures[made].returns, closable, .reason-argument)
conversions.convert(named, named, instances.signatures[closer].returns, tracker, .reason-argument)
facts.address-claims += AddressClaim(instance, named, closer)
= true

────────────────────
_ do declared-key TypeId
    - owner TypeId
    - syntax SyntaxId
    - home ModuleId

` The type of the key an event is published by, or none where it is published by none. A key
` whose type is not known is the invalid type.
if syntax == 0
    = no-type
. key = declared-payload(owner, syntax, home)
= if key == no-type then invalid-type else key

────────────────────
_ do declared-payload TypeId
    - owner TypeId
    - syntax SyntaxId
    - home ModuleId

` The type an event of a class publishes, written in the module that declares the event: the
` class's own, or a facet's.
if syntax == 0
    = types.void-type
. payload = invalid-type
do match? types.rows[owner]
    | .type-class(row)
        . env = types.class-env-for(row.module, row.decl, row.args, owner)
        . tree = program.modules[home].tree
        payload = types.evaluate-type(home, tree, syntax, env)
        types.env-release(env)
= if payload == invalid-type then no-type else payload

────────────────────
_ do declares-event Bool
    - receiver TypeId
    - name Atom

for cursor in event-chain(receiver)
    do match? types.rows[cursor]
        | .type-class(row)
            =? true if declared-event(row.module, row.decl, name) != null
= false

────────────────────
_ do declares-method Bool
    - receiver TypeId
    - name Atom

. cursor = receiver
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    for member in target.members-named(class.members, name)
                        do match? target.decls[member]
                            | .decl-function(fn)
                                if written && fn.kind == .function-decl && same-name
                                    = true
                                .. written = !fn.is-generated && !fn.is-static
                                .. same-name = fn.name && fn.name == name
    cursor = types.base-of(cursor) ?? no-type
= false

────────────────────
_ do inherited-getter-type TypeId
    - self TypeId

` The type a getter that states none returns where it is over one a base states the type of,
` which each getter over that one keeps.
=? no-type if self == no-type || self == invalid-type
do match? program.modules[module].decls[frame.decl]
    | .decl-function(fn)
        . name = fn.name
        if fn.kind == .getter-decl && fn.return-type == 0 && name
            types.complete(self)
            . base = types.base-of(self) ?? no-type
            if base != no-type && states-getter-type(base, name)
                . inherited = property-named(base, name)
                if inherited
                    = types.properties[inherited].type
= no-type

────────────────────
_ do states-getter-type Bool
    - receiver TypeId
    - name Atom

` Whether the getter of this name that the receiver declares or inherits states its type
` where it is first declared, the farthest base that declares one: each getter over it has
` the type it states there, as TypeScript gives each inherited property its base's.
. stated = false
. cursor = receiver
while cursor != no-type
    do match? types.rows[cursor]
        | .type-class(row)
            . target = program.modules[row.module]
            do match? target.decls[row.decl]
                | .decl-class(class)
                    for member in target.members-named(class.members, name)
                        do match? target.decls[member]
                            | .decl-function(fn)
                                if fn.kind == .getter-decl && fn.name == name
                                    stated = fn.return-type != 0
    cursor = types.base-of(cursor) ?? no-type
= stated

────────────────────
_ is-array-field Bool
    - receiver TypeId
    - name Atom

|? name != types.size-atom! && name != types.length-atom! && name != types.data-atom!
    false
??
    match types.rows[receiver]
        | .type-class(row)
            row.module == array.module && row.decl == array.decl && row.args.count == 2
        ??
            false

.. array = types.array-decl

────────────────────
_ do check-constructor-fills

. filling [SlotId]
. owner-module = program.modules[module]
. owner = 0u32
. args = RowRange'ArgumentShape()
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        owner = fn.owner
        args = fn.args
if owner == 0
    =
if names-given()
    decline(frame.declaration.body)
    =
. position = 0u32
for shape in owner-module.arg-pool[args]
    . name = pattern-name(types, tree, shape.pattern)
    if name && !redefaults(position)
        . property = owner-property(program, module, owner, name)
        if property != 0
            fill-property(name, property, argument-slot(position), shape.pattern)
        else
            fill-inherited(name, argument-slot(position), shape.pattern)
    position += 1
for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . slot = declaring-slot(row.left) if row.is-lazy
            if slot
                . name = bindings.slots[slot].name
                . property = owner-property(program, module, owner, name)
                if declared-property && tree.is-typed(row.left)
                    frame.diagnose
                        - row.left
                        - .stated
                        - program.store-atom("Illegal to redefine property type")
                    =
                .. declared-property = property != 0 || property-named(frame.self-type, name)
                if property != 0
                    read-slot(slot)
                    fill-property(name, property, slot, row.right)
                    filling += slot
                else if property-named(frame.self-type, name)
                    read-slot(slot)
                    fill-inherited(name, slot, row.right)
                    filling += slot
if fills-share(filling)
    instances.rows[instance].fills-share = true
if frame.declaration.kind == .constructor-decl && !returns-own(tree, frame.declaration.body)
    check-initializer-reads()

────────────────────
_ do names-given Bool

` Whether the body of a constructor names a property a markup element gives it the value
` of: the name is then a constant that holds the value, which has no shape here yet.
. given = instances.rows[instance].fills
. body = frame.declaration.body
if given.count == 0 || body == 0
    = false
for node in tree.subtree-start(body) .. < body
    . name Atom? = null
    do match? tree.nodes[node]
        | .node-identifier(row)
            name = row.name
        | .node-ref-identifier(row)
            name = row.name
        | .node-declare(row)
            . slot = declaring-slot(row.left)
            if slot
                name = bindings.slots[slot].name
    if name
        for offset in 0 .. < given.count
            if types.properties[instances.fill-places[given.start + offset]].name == name
                = true
= false

────────────────────
_ do fills-share Bool
    - filling [SlotId]

` Whether the lazy locals a constructor gives its properties their values from, or the lazy
` locals their values read in turn, are captured by nested functions or make one.
. seen [SlotId]
. pending [SlotId]
for slot in filling
    pending += slot
while pending.length != 0
    . slot = pending.pop()
    if seen.find(slot) != null
        continue
    seen += slot
    . row = bindings.slots[slot]
    if (row.flags /and/ SlotFlag.slot-captured) != 0
        = true
    . value = tree.lazy-value(row.group)
    if value == 0
        continue
    for node in tree.subtree-start(value) .. < value + 1
        do match? tree.nodes[node]
            | .node-function-syntax
                = true
            | .node-identifier
                . resolution = bindings.resolution-of(frame.binding, node)
                if resolution.kind == .resolve-slot && lazy-slot
                    pending += resolution.slot
                .. lazy-slot = bindings.slots[resolution.slot].kind == .slot-lazy
= false

────────────────────
_ do field-reference Atom?
    - id SyntaxId

` The name of a field a node may name: an identifier, or a member read from `this`.
do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name
    | .node-get-expression(row)
        if names-receiver(row.object)
            = row.name
= null

────────────────────
_ body-statements RowRange'SyntaxId

match tree.nodes[frame.declaration.body]
    | .node-block(row)
        row.body
    ??
        RowRange'SyntaxId()

────────────────────
_ do fill-inherited
    - name Atom
    - slot SlotId
    - value-syntax SyntaxId

` An argument or a lazy local named as a property a base class or a facet declares gives that
` property its value too. A facet's private property takes none: code outside the facet's file
` doesn't see it, and in that file it is refused, since another facet may keep the name as well.
` Its conversion to the property's type is recorded at the value: the type written for the
` property, or else the type of the value written for it.
. found = property-named(frame.self-type, name)
if !found
    =
. facet = types.properties[found].facet
if facet != U32.max && !declares-name(facets.modules[facet], facets.decls[facet], name, true)
    if facets.modules[facet] == module
        . message = "${name.text} is private to facet ${facet-name-of(facet)}, so a constructor's argument can't give it a value"
        frame.diagnose(value-syntax, .stated, program.store-atom(message))
    =
.. facets = program.facets
. given = frame.known(slot)
if given == no-type || given == invalid-type
    =
facts.record-fill(FillFact(instance, name, slot, value-syntax))
. fact = types.properties[found]
. declared = fact.type
if declared == no-type && fact.storage-kind != .storage-getter
    declared = demand-member(fact, frame.self-type, name)
. filled = types.optional-inner(given)
if declared != no-type && declared != invalid-type && declared != filled
    conversions.convert(value-syntax, value-syntax, filled, declared, .reason-assignment)

────────────────────
_ do fill-property
    - name Atom
    - property DeclId
    - slot SlotId
    - value-syntax SyntaxId

` An argument named as a property the class declares gives the property its value. Its
` conversion to the property's type is recorded at the property: the type written, or the one
` a class above gave the property, or else the type of the value written for it.
. given = frame.known(slot)
if given == no-type || given == invalid-type
    =
do match? program.modules[module].decls[property]
    | .decl-property(row)
        facts.record-fill(FillFact(instance, name, slot, row.syntax))
        . declared = invalid-type
        . held = property-named(frame.self-type, name)
        . above = if held then first-type(types.properties[held], name) else no-type
        if row.type-syntax != 0
            declared = types.evaluate-type(module, tree, row.type-syntax, frame.env)
        else if above != no-type
            declared = above
        else if row.value != 0
            declared = literal-type(types, module, tree, row.value, frame.env)
        . filled = types.optional-inner(given)
        if declared != invalid-type && declared != filled
            conversions.convert(row.syntax, value-syntax, filled, declared, .reason-assignment)

────────────────────
_ do check-property-defaults
    - receiver TypeId

` Types the values of the stored properties a constructor is not given, which it evaluates,
` so the errors an eager one lets out leave the constructor, at its class. Those of one that
` reads something tracked leave the function its live action evaluates it again with too,
` which gives them to the global `unhandled-error` (`hands-off`), as the reference's live action
` does; where that is not in place it is declined. A tuple's
` constructor given some fields is given them by position or by name, which its instance does
` not tell: each call types the values of the fields it leaves out (`check-field-default`).
live-owned = false
if receiver == no-type || receiver == invalid-type
    = 
types.complete(receiver)
. some = frame.declaration.kind == .tuple-constructor-decl && given-args
    .. given-args = instances.signatures[instance].args.count != 0
for property in types.properties-of(receiver)
    . given = property.slot != U32.max && some
    if property.storage-kind != .storage-getter && !given
        last-unit = no-instance
        demand-member(property, receiver, property.name, true)
        if property.storage-kind == .storage-eager && last-unit != no-instance && live-unit
            live-owned = true
            demand-errors(last-unit)
            if instances.signatures[last-unit].errors.count != 0 && !hands-off(last-unit)
                decline(owner-syntax())
        .. live-unit = instances.rows[last-unit].is-live
        if property.storage-kind == .storage-eager && last-unit != no-instance && other-unit
            note-unit-errors(last-unit, owner-syntax())
            if !supplies(property.name)
                note-default-use(last-unit)
            check-shared-machine(property, receiver)
        .. other-unit = last-unit != instance
    if property.storage-kind == .storage-eager && !given
        construct-default(property, receiver)

────────────────────
_ do check-shared-machine
    - property TypeProperty
    - receiver TypeId

` A class runs the machine a property of it holds, and each machine that one refines, each typed
` for the class above it that declares it, and runs the groups at the root of each from its table
` where that class does (`lowers-for`). Where a section, a constructor or another machine of the
` class or of one between hears the event of such a group, that choice does not hold for it, and
` the class has no shape here.
if !intrinsic-is-class(types.intrinsic-of(receiver))
    =
. current = holding-type(receiver, declaring-holder(types, property))
while current != no-type
    . typed = current
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    . declared = if named-level then class-property(level, property.name) else 0
        .. named-level = level.module != 0 || level.decl != 0
    if declared == 0
        continue
    . owner-tree = program.modules[level.module].tree
    . machine = owner-tree.declared-machine(declared-value(level.module, declared))
    if machine == 0
        =
    if typed == receiver
        continue
    for head in owner-tree.group-heads(owner-tree.state-items(owner-tree.state-body(machine)))
        . written = owner-tree.group-stream(head)
        . event = own-event(typed, level.module, written)
        if !event
            continue
        . theirs = lowers-for(typed, level.module, written, event)
        . mine = lowers-for(receiver, level.module, written, event)
        if theirs != null && (mine == null || mine != theirs)
            decline(owner-syntax())
            =

────────────────────
_ supplies Bool
    - name Atom

` Whether a constructor gives a property its value: a parameter of its name, a lazy local of its
` name, or an attribute a markup element gives. A value that may be null gives none, as the
` property then holds what its class writes. A tuple's constructor given no field gives none.
|? frame.declaration.kind == .tuple-constructor-decl
    false
|? is-constructor-initializer(name)
    true
|? position != U32.max
    !redefaults(position) && !types.is-optional(frame.known(argument-slot(position)))
??
    filled != U32.max && !types.is-optional(instances.argument-type(instance, filled))

.. position = constructor-parameter(name)
.. filled = instances.fill-argument(instance, name)

────────────────────
_ redefaults Bool
    - position U32

` Whether a constructor leaves the property its parameter at a place names to the default the
` class it makes writes (`Instance.redefaults`).
position < 32 && (instances.rows[instance].redefaults /and/ (1u32 /lshift/ position)) != 0

────────────────────
_ do note-default-use
    - unit InstanceId

` Records the value a type writes for a property, which `unit` types, where a constructor of the
` type takes it as written (`DeclaredValueFact`).
. row = instances.rows[unit]
if row.module != module || row.initializer == 0
    =
do match? program.modules[row.module].decls[row.initializer]
    | .decl-property(property)
        if property.type-syntax != 0 && property.value != 0
            . declared = instances.signatures[unit].declared-returns
            . found = instances.signatures[unit].returns
            note-declared-value
                - 0
                - row.initializer
                - property.value
                - property.type-syntax
                - declared
                - found

────────────────────
_ do holding-type TypeId
    - receiver TypeId
    - ref DeclRef

` The class of a declaration among a class and its bases, as the class holds it: with the
` type arguments the class gives it. The class itself when it has no such base.
. current = receiver
while current != no-type
    . held = class-ref(types, current)
    if held.module == ref.module && held.decl == ref.decl
        = current
    current = types.base-of(current) ?? no-type
= receiver

────────────────────
_ do construct-default
    - fact TypeProperty
    - receiver TypeId

` A stored property with no value written, which the constructor is given none for, holds
` what its type constructs with no argument. The construction is recorded at the property,
` when the constructor's own module declares it. A constructor of another module has no
` place in its own source for it, so the construction is typed there by an instance of its
` own for the receiver, as a value written for the property is, and the constructor lets out
` its errors at its class and may panic where it may. The first values of a named tuple's or
` struct's fields are typed too, which emission gives the fields where the value is made.
. ref = declaring-decl(types, fact)
if fact.type == no-type || fact.type == invalid-type || names-element(types, fact)
    =
. tuple = if ref.decl == 0 then written-tuple(types, receiver, fact.owner) else DeclRef(0, 0)
if tuple.decl != 0
    ref = tuple
. elsewhere = ref.module != module
if !writes-value(fact)
    demand-first-values(fact.type)
if gives-every-value(fact.name) || is-constructor-initializer(fact.name)
    =
if tuple.decl != 0
    if !elsewhere
        construct-value(written-field(program, tuple, fact.name), fact.type)
    =
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
for member in owner-module.members-named(members, fact.name)
    do match? owner-module.decls[member]
        | .decl-property(row)
            if row.name && row.name == fact.name
                if row.value != 0 || row.syntax == 0
                    =
                if row.line == 0 && rejects-default-cycle(ref.module, row.syntax, fact)
                    =
                if row.line == 0 && rejects-facet-default(ref.module, row.syntax, fact)
                    =
                if !elsewhere
                    construct-value(row.syntax, fact.type)
                    =
                if !is-constructed(fact.type)
                    =
                . unit = instances.intern-initializer(ref.module, member, receiver)
                if instances.rows[unit].state == .instance-unstarted
                    instances.signatures[unit].declared-returns = fact.type
                do demand-initializer(unit, row.syntax)
                replay-member(unit)
                note-unit-errors(unit, owner-syntax())
                =

────────────────────
_ do rejects-facet-default Bool
    - owner ModuleId
    - site SyntaxId
    - fact TypeProperty

` Whether a stored property with no value written is of a facet's type, which no constructor makes,
` and reports so.
=? false if is-constructor-parameter(fact.name) || instances.fill-argument(instance, fact.name) != U32.max
. facet = types.facet-of-type(fact.type)
=? false if !facet
. shown = type-short-name(types, fact.type)
. made = type-short-name(types, types.facet-owner(facet))
. message = "${fact.name.text} is a $shown, a facet of $made, which has no constructor to give it its first value; give it a value, or make it optional"
facts.record-diagnostic(instance, owner, site, .stated, program.store-atom(message))
= true

────────────────────
_ do rejects-default-cycle Bool
    - owner ModuleId
    - site SyntaxId
    - fact TypeProperty

=? false if parameter || instances.fill-argument(instance, fact.name) != U32.max
.. parameter = is-constructor-parameter(fact.name)
=? false if !defaults-class(fact)
. path-types [TypeId]
. path-properties [TypeProperty]
. done = Map'TypeId'Bool()
. found = default-cycle-from(fact.type, path-types, path-properties, done)
=? false if found == U32.max
. steps [String]
for index in found .. < path-types.length
    . property = path-properties[index]
    steps += "${holder-name}.${property.name.text} builds ${type-short-name(types, property.type)}"
        .. holder-name = type-short-name(types, path-types[index])
. message = "Default of ${fact.name.text} never finishes: ${", and ".join(steps)} again. Give one of these fields a value, make it lazy with :=, or make it optional"
facts.record-diagnostic(instance, owner, site, .stated, program.store-atom(message))
= true

────────────────────
_ do default-cycle-from U32
    - type TypeId
    - path-types [TypeId]
    - path-properties [TypeProperty]
    - done Map'TypeId'Bool

for index in 0 .. < path-types.length
    =? index as U32 if path-types[index] == type
=? U32.max if done has type
if builds-defaults(type)
    . fields [TypeProperty]
    for property in types.properties-of(type)
        if defaults-class(property)
            fields += property
    for property in fields
        path-types += type
        path-properties += property
        . found = default-cycle-from(property.type, path-types, path-properties, done)
        =? found if found != U32.max
        path-types.pop()
        path-properties.pop()
done[type] = true
= U32.max

────────────────────
_ do builds-defaults Bool
    - type TypeId

=? false if types.intrinsic-of(type) != .class || is-markup-query(type)
types.complete(type)
. current = type
while current != no-type
    . ref = class-ref(types, current)
    =? false if ref.module == 0 && ref.decl == 0
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            =? false if class.content != 0
            if current == type
                for member in owner.member-pool[class.members]
                    do match? owner.decls[member]
                        | .decl-function(function)
                            =? false if function.kind == .constructor-decl && bare-written
                            .. bare-written = !function.is-generated && function.required-count == 0
    current = types.base-of(current) ?? no-type
= true

────────────────────
_ defaults-class Bool
    - property TypeProperty

|? property.storage-kind != .storage-eager || untyped
    false
|? types.intrinsic-of(property.type) != .class || is-markup-query(property.type)
    false
??
    !names-element(types, property) && !writes-value(property)

.. untyped = property.type == no-type || property.type == invalid-type

────────────────────
_ is-constructed Bool
    - type TypeId

` Whether a value of a type with no value written is what the type constructs.
kind == .class || kind == .tuple || kind == .struct || kind == .array-builder

.. kind = types.intrinsic-of(type)

────────────────────
_ do demand-case-values
    - table TypeId

` A table of unions starts each row as its first case's first value, and reads a row whose tag
` names no case as that: the values the case writes for its fields are typed with the table.
. row = row-struct-of(table)
if row == no-type || row == invalid-type || types.intrinsic-of(row) != .union
    =
. held = types.cases-of(row)
if held.length != 0 && held[0].type != no-type && held[0].type != invalid-type
    demand-first-values(held[0].type)

────────────────────
_ do demand-first-values
    - type TypeId
    - seen [TypeId] = List'TypeId()

` Types the values a named tuple or struct writes for its fields, and those of the named
` tuples and structs its fields hold with no value written.
=? if seen.find(type) != null
seen += type
if types.is-optional(type)
    demand-first-values(types.optional-inner(type), seen)
    =
. kind = types.intrinsic-of(type)
if kind == .union
    for case in types.cases-of(type)
        if case.type != no-type && case.type != invalid-type
            demand-first-values(case.type, seen)
    =
. ref = class-ref(types, type)
if (kind != .tuple && kind != .struct && kind != .array-builder) || unnamed
    =
.. unnamed = ref.module == 0 && ref.decl == 0
types.complete(type)
for property in types.properties-of(type)
    if property.storage-kind == .storage-getter
        continue
    if writes-value(property)
        demand-member(property, type, property.name, true)
    else if property.storage-kind == .storage-eager && typed-property
        demand-first-values(property.type, seen)
    .. typed-property = property.type != no-type && property.type != invalid-type

────────────────────
_ do construct-value
    - site SyntaxId
    - type TypeId

if site == 0 || type == no-type || type == invalid-type || !is-constructed(type)
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.construction-on(site, type, arguments, false)

────────────────────
_ is-constructor-parameter Bool
    - name Atom

constructor-parameter(name) != U32.max

────────────────────
_ gives-every-value Bool
    - name Atom

parameter != U32.max && !types.is-optional(instances.argument-type(instance, parameter))

.. parameter = constructor-parameter(name)

────────────────────
_ do constructor-parameter U32
    - name Atom

` The place among a constructor's parameters of the one of a name, or `U32.max`.
. owner-module = program.modules[module]
. position = 0u32
do match? owner-module.decls[frame.decl]
    | .decl-function(fn)
        for shape in owner-module.arg-pool[fn.args]
            . named = pattern-name(types, tree, shape.pattern)
            if named && named == name
                = position
            position += 1
= U32.max

────────────────────
_ do refines-in-progress Bool
    - ref DeclRef
    - name Atom
    - receiver TypeId

` Whether a class above the one a property is declared in declares a property of the name whose
` value is being typed, for that class as a receiver holds it.
. above = false
. current = receiver
while current != no-type
    . held = current
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    if level.module == ref.module && level.decl == ref.decl
        above = true
        continue
    . declared = if above then class-property(level, name) else 0
    if declared != 0
        . unit = instances.intern-initializer(level.module, declared, held)
        if instances.rows[unit].state == .instance-in-progress
            = true
= false

────────────────────
_ do projection-type TypeId
    - ref DeclRef
    - node SyntaxId
    - receiver TypeId

` The type of the property that projects a case of a machine of a class's markup that holds a
` value: the optional of what the case holds in the machine's union, as each function that fills
` an object with the markup typed the machine, which must agree. Where none has typed it yet, a
` filler or constructor of the class still waiting in the queue is typed first, one at a time,
` until one has (`pending-filler`), or else one of the class of the object read, or of a class
` between, which runs the class's, or else the class's filler as the object read holds the class,
` given no slots, which only typing reaches then: the instance that fills the object may be
` waiting in no queue yet, or in that of another pass of a parallel type pass. None where none is
` left.
. owner-module = program.modules[ref.module]
. owner = owner-module.tree
. filler DeclId = 0
. machine SyntaxId = 0
. position U32? = null
do match? owner-module.decls[ref.decl]
    | .decl-class(class)
        filler = class.content-function
        for written in owner.content-machines(class.content)
            . cases = owner.machine-cases(owner.state-items(owner.state-body(written)))
            if cases.find(node) != null
                machine = written
                position = owner.case-position(cases, owner.state-name(node)!)
if filler == 0 || machine == 0 || position == null
    = invalid-type
. own = false
while true
    . found = no-type
    for row in facts.machines
        . same = row.module == ref.module && row.syntax == machine && row.outer == 0
        if same && instances.rows[instances.rows[row.instance].enclosing].decl == filler
            . held = no-type
            do match? types.rows[row.union]
                | .type-named-union(union)
                    held = types.optional-of(types.child-type(union.cases, position))
            if found != no-type && found != held
                = invalid-type
            found = held
    if found != no-type
        = found
    . pending = pending-filler(ref, filler)
    . level = receiver
    while pending == no-instance && level != no-type
        . below = class-ref(types, level)
        if below.module == ref.module && below.decl == ref.decl
            break
        level = types.base-of(level) ?? no-type
        do match? program.modules[below.module].decls[below.decl]
            | .decl-class(class)
                pending = pending-filler(below, class.content-function)
    if pending == no-instance && !own
        own = true
        . slots [Atom]
        . builders [TypeId]
        pending = calls.filler-instance(holding-type(receiver, ref), slots, builders)
    if pending == no-instance
        = invalid-type
    demand-own-body(pending)

────────────────────
_ do pending-filler InstanceId
    - ref DeclRef
    - filler DeclId

` An instance waiting in the queue whose body would fill an object of a class with its markup:
` the class's filler, or else a constructor of the class, which calls it. None where none waits.
. owner-module = program.modules[ref.module]
. constructor = no-instance
for unit in 0u32 .. < (instances.rows.length as U32)
    . row = instances.rows[unit]
    if row.module != ref.module || row.state != .instance-unstarted
        continue
    if row.decl == filler
        = unit
    if constructor == no-instance
        do match? owner-module.decls[row.decl]
            | .decl-function(fn)
                if fn.owner == ref.decl && is-constructor-kind(fn.kind)
                    constructor = unit
= constructor

────────────────────
_ do first-type TypeId
    - fact TypeProperty
    - name Atom

` The type a stored property has from a class above the one that declares it again, or no
` type when no class above stores it. A class that gives a stored property of its base a new
` value does not give it a new type: the value is converted to the type the property already
` has. That type is worked out for the class above itself, once, whatever class below asks
` for it. A lazy property declared again is another function, with the type of its own value.
if fact.storage-kind != .storage-eager
    = no-type
. current = fact.owner
while current != no-type
    . ref = class-ref(types, current)
    . is-class = ref.module != 0 || ref.decl != 0
    . declares = is-class && owner-property(program, ref.module, ref.decl, name) != 0
    current = types.base-of(current) ?? no-type
    if declares
        break
if current == no-type
    = no-type
. found = property-named(current, name)
if !found
    = no-type
. above = types.properties[found]
if above.storage-kind != .storage-eager
    = no-type
. given = above.type
if given == no-type
    given = demand-member(above, current, name, false, true)
= if given == invalid-type then no-type else given

────────────────────
_ is-accessor Bool
    - receiver TypeId
    - name Atom

if found then types.properties[found].storage-kind == .storage-getter else inherited

.. found = property-named(receiver, name)
.. inherited = types.intrinsic-of(receiver) == .class && interface-accessor(receiver, name) != null

────────────────────
_ do names-nothing Bool
    - callable SyntaxId
    - args RowRange'SyntaxId

` Whether a call names a function nothing declares, which the reference reports once it has typed
` the arguments: a name alone the binder resolves to nothing, of no type parameter, that the
` module reaches no declaration of, called where there is no receiver whose members it could
` name, with no symbol among its arguments whose union's module it could be looked for in.
. name = identifier-name(tree, callable)
if !name || frame.self-type != no-type || resolved
    = false
.. resolved = bindings.resolution-of(frame.binding, callable).kind != .resolve-unresolved
if types.env-lookup(frame.env, name)
    = false
for _ in program.lookup(module, name)
    = false
for arg in tree.children[args]
    . written = match tree.nodes[arg]
        | .node-argument(argument)
            argument.expr
        ??
            arg
    if tree.argument-symbol(written)
        = false
= true

────────────────────
_ arguments-since Arguments
    - shapes-start ScratchMark
    - types-start ScratchMark
    - syntax-start ScratchMark
    - params ImmutableArray'TypeId'ArenaBacking
    - curried Bool = false
    - piped SyntaxId = 0
    - slots ImmutableArray'Atom'ArenaBacking = ImmutableArray'Atom'ArenaBacking()
    - builders ImmutableArray'TypeId'ArenaBacking = ImmutableArray'TypeId'ArenaBacking()
    - context U32 = U32.max

` The arguments pushed on the scratch stacks since the marks, with any explicit type arguments,
` the call a value is piped into (`piped`), and what a markup element gives its constructor apart
` from them.
Arguments(shapes, arg-types, syntax, params, curried, piped, slots, builders, context)

.. shapes = scratch.call-arguments.since(shapes-start)
.. arg-types = scratch.types.since(types-start)
.. syntax = scratch.syntax.since(syntax-start)

────────────────────
_ do names-nothing Bool
    - id SyntaxId

` Whether a name written as a type reaches nothing: no type parameter and no declaration the
` module reaches, which the reference says of a constructor.
. name = type-head-name(tree, id)
if !name || types.env-lookup(frame.env, name)
    = false
for _ in program.lookup(module, name)
    = false
= true

────────────────────
_ class-site SyntaxId
    - ref DeclRef

match program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        class.syntax
    ??
        0u32

────────────────────
_ do is-managed Bool
    - type TypeId
    - depth U32

` Whether a value of a type holds a pointer the collector must trace.
if depth > 16 || type == no-type || type == invalid-type
    = false
types.complete(type)
. kind = types.intrinsic-of(type)
if is-numeric(types, type) || kind == .void || kind == .atom || kind == .type-info
    = false
if kind == .cpointer || kind == .cfunction
    = false
if kind == .optional
    = is-managed(types.optional-inner(type), depth + 1)
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        if !fact.is-default && is-managed(fact.type, depth + 1)
            = true
    = false
if intrinsic-is-tuple-like(kind) || types.is-plain-tuple(type)
    . arity = tuple-arity(type)
    if arity == U32.max
        = true
    for position in 0 .. < arity
        if is-managed(field-of(type, position), depth + 1)
            = true
    = false
= true

────────────────────
_ do has-empty-value Bool
    - type TypeId
    - depth U32

if depth > 16 || type == no-type || type == invalid-type
    = false
types.complete(type)
. kind = types.intrinsic-of(type)
if kind == .optional || kind == .string || kind == .void || intrinsic-is-numeric(kind)
    = true
if kind == .union
    for index in 0 .. < types.cases-of(type).length
        . fact = types.cases-of(type)[index]
        if !fact.is-default && fact.type != no-type && !has-empty-value(fact.type, depth + 1)
            = false
    = true
if kind != .tuple && kind != .struct && !types.is-plain-tuple(type)
    = false
. arity = tuple-arity(type)
if arity == U32.max
    = false
for position in 0 .. < arity
    if !has-empty-value(field-of(type, position), depth + 1)
        = false
= true

────────────────────
_ do report-fault Bool
    - site SyntaxId
    - at-written Bool = false

` Says why the type store could not name a type just asked of it, at the place given or,
` when asked to and the type is written in this module, where it is written.
. fault = types.fault
if !fault
    = false
. written = types.fault-site
. exact = at-written && written != 0 && types.fault-module == module
frame.diagnose(if exact then written else site, .stated, fault)
types.clear-fault()
= true

────────────────────
_ do report-circular Bool

` Reports an associated type whose binding names itself, where the type store met the cycle.
if types.circular-binding == 0
    = false
. bound = types.circular-name
. label = if bound then bound.text else ""
. message = program.store-atom("Circular associated type $label")
. owner = types.circular-module
facts.record-diagnostic(instance, owner, types.circular-binding, .stated, message)
types.circular-binding = 0
= true

────────────────────
_ is-const-array Bool
    - type TypeId

` ConstArray is built by the compiler from constant items: it has no constructor to dispatch.
match types.rows[type]
    | .type-class(row)
        types.const-array-decl.refers-to(row.module, row.decl)
    ??
        false

────────────────────
_ do static-owner TypeId
    - object SyntaxId

. named = false
do match? tree.nodes[object]
    | .node-type-identifier
        named = true
    | .node-core-type-identifier
        named = true
    | .node-type-arguments
        named = true
    | .node-type-associated
        named = true
    | .node-identifier(row)
        . resolution = bindings.resolution-of(frame.binding, object)
        if resolution.kind == .resolve-type
            named = true
        else if resolution.kind == .resolve-unresolved || resolution.kind == .resolve-none
            . bound = types.env-lookup(frame.env, row.name)
            if bound
                = bound
if !named
    = no-type
. owner = types.evaluate-type(module, tree, object, frame.env)
= if owner == invalid-type then no-type else owner

────────────────────
_ do infer-catch-optional TypeId
    - id SyntaxId
    - body SyntaxId

. outer-surround = frame.surround
frame.surround = frame.surround.catch-depth = outer-surround.catch-depth + 1
. raw = infer(body)
frame.surround = outer-surround
if raw == invalid-type || raw == types.void-type
    = raw
. value = result-value(types, if types.is-optional(raw) then types.optional-inner(raw) else raw)
if value == types.void-type
    value = types.type-row(.int8)
if types.is-optional(value)
    = value
= types.optional-of(value)

────────────────────
_ do infer-catch TypeId
    - id SyntaxId
    - body SyntaxId
    - is-raw Bool
    - catchers RowRange'SyntaxId
    - want Want

` An expression under `catch` gives its value or its error, as it is. With handlers it gives
` what it gives where no error was raised, joined with what the handlers give. A handler
` that gives an error does not raise it: the whole is then a value that may be that error. A
` handler whose pattern can match neither the value nor any of the errors is passed over, as
` the reference compiles no arm that can not match (`catcher-possible`). One whose value is
` dropped, a statement a block does not keep the value of, gives none where the values do not
` join. An optional chain to a call that raises gives an optional of what the call gives
` (`chained-result`): handlers take the errors of the call, and the chain gives its value as an
` optional, which holds nothing where the chain made no call.
. unused = want.asks(.want-unused)
if catchers.count == 0 && !is-raw
    = infer(body)
. transformed = tree.transformer-exception(body, catchers)
if transformed != 0
    declare-transformers(body, transformed, catchers)
    = no-type
if catchers.count != 0
    instances.mark-may-panic(instance)
. outer-surround = frame.surround
frame.surround = frame.surround.catch-depth = outer-surround.catch-depth + 1
. raw = infer(body)
frame.surround = outer-surround
if catchers.count == 0 || raw == invalid-type
    = raw
. result = chained-result(raw)
. chained = result != no-type
if !chained
    result = raw
if !check-handled(id, body, result, is-raw, catchers)
    = invalid-type
. value = result-value(types, result)
. side = value
if chained && value != types.void-type && !types.is-optional(value)
    side = types.optional-of(value)
. mark = scratch.types.mark
if side != types.void-type
    scratch.types.push(side)
. errors [TypeId]
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if !takes-errors(catcher, row.type)
                continue
            if !catcher-possible(row.type, result)
                facts.set-plan(instance, catcher, .plan-never)
                continue
            check-pattern(row.type, result)
            . saved = frame.surround
            frame.surround = frame.surround.effects = exceptional-effects(saved.effects)
            . diagnosed = facts.diagnostics.length
            . handled = check-statement(row.body)
            frame.surround = saved
            if is-raised(handled)
                if errors.find(handled) == null
                    errors += handled
            else if handled != no-type && handled != types.void-type && handled != invalid-type
                scratch.types.push(handled)
            else if value != types.void-type && undiagnosed && lacks-value(row.body, handled)
                frame.diagnose(row.body, .stated, program.store-atom("Illegal statement"))
            .. undiagnosed = facts.diagnostics.length == diagnosed
if scratch.types.length == mark && errors.length == 0
    = types.void-type
. joined = types.void-type
if scratch.types.length != mark
    joined = relations.join(mark)
    if joined != invalid-type
        for part in scratch.types.since(mark)
            if part != joined
                conversions.convert(id, 0, part, joined, .reason-join)
        if chained && side != types.void-type
            if value != joined
                conversions.convert(id, 0, value, joined, .reason-join)
            conversions.convert(id, 0, types.null-type, joined, .reason-join)
scratch.types.rewind(mark)
if joined == invalid-type && unused && errors.length == 0
    = types.void-type
if joined == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Incompatible types in expression"))
    = joined
if errors.length == 0
    = joined
. given = scratch.types.mark
for error in errors
    scratch.types.push(error)
= result-type(types, joined, given)

────────────────────
_ chained-result TypeId
    - raw TypeId

` What an optional chain to a call that raises holds: the call's value or one of its errors.
` No type for anything else.
|? types.is-optional(raw) && is-result(inner)
    inner
??
    no-type

.. inner = types.optional-inner(raw)

────────────────────
_ is-result Bool
    - type TypeId

match types.rows[type]
    | .type-result
        true
    ??
        false

────────────────────
_ do takes-errors Bool
    - catcher SyntaxId
    - pattern SyntaxId

` Whether a handler names the error type it takes, as in `catch error IOError`: `Error` or a type
` that extends it. A name alone, as in `catch error`, names no type.
if pattern == 0
    frame.diagnose
        - catcher
        - .stated
        - program.store-atom("Attached catch handler requires an Error type")
    = false
. caught = match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type == 0 then no-type else caught-type(pattern)
    ??
        caught-type(pattern)
=? false if caught == invalid-type
if caught == no-type || !is-subtype(types, caught, types.error-type)
    frame.diagnose
        - pattern
        - .stated
        - program.store-atom("Attached catch handler type must be an Error subtype")
    = false
= true

────────────────────
_ do catcher-possible Bool
    - pattern SyntaxId
    - raw TypeId

` Whether the pattern of a handler could match what an expression that may raise gives: its
` value or one of its errors, which the reference matches the handlers against as a match's
` arms.
if pattern-possible(pattern, result-value(types, raw))
    = true
do match? types.rows[raw]
    | .type-result(row)
        for offset in 0 .. < row.errors.count
            if pattern-possible(pattern, types.child-type(row.errors, offset))
                = true
= false

────────────────────
_ do check-handled Bool
    - id SyntaxId
    - body SyntaxId
    - raw TypeId
    - is-raw Bool
    - catchers RowRange'SyntaxId

` Handlers attach to an expression that can raise. An error none of them takes leaves the
` function, unless the expression is itself caught: then the handlers must take every error.
` Which errors leave is recorded at the expression.
. errors = RowRange'TypeId()
. raises = false
do match? types.rows[raw]
    | .type-result(row)
        errors = row.errors
        raises = true
if !raises
    . message = "Attached catch handlers require a Result expression"
    frame.diagnose(body, .stated, program.store-atom(message))
    = false
. missing = ""
. leaving U64
. bit U64 = 1
for offset in 0 .. < errors.count
    . error = types.child-type(errors, offset)
    . place = bit
    bit = bit * 2
    if handles(catchers, error)
        continue
    if !is-raw
        note-outgoing(error, id)
        leaving = leaving /or/ place
        continue
    if missing.length != 0
        missing += ", "
    missing += type-short-name(types, error)
if missing.length != 0
    . message = "Non-exhaustive match for Result; missing $missing"
    frame.diagnose(id, .stated, program.store-atom(message))
    = false
if errors.count < 64
    facts.set-constant(instance, id, ConstantFact(leaving, 0.0, null, false), .plan-handled)
= true

────────────────────
_ do handles Bool
    - catchers RowRange'SyntaxId
    - error TypeId

for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if row.type == 0
                continue
            . caught = caught-type(row.type)
            if caught == invalid-type
                = true
            . relation = relations.compare(error, caught, false, false, null, module)
            . down = relation.kind == .relation-down-cast
            if relation-legal(relation) && !down && relation.kind != .relation-interface-down-cast
                = true
= false

────────────────────
_ do declare-transformers
    - site SyntaxId
    - exception SyntaxId
    - catchers RowRange'SyntaxId

` Each catcher names an error that, from here on, leaves the function as the exception raised
` in its place. The exception is typed once: only the catcher of a raise with one sees it.
. raised = no-type
. typed = false
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if row.body != 0
                . message = "Error transformers do not support catch bodies"
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            . source = if row.type == 0 then no-type else typed-catcher(row.type)
            if source == no-type || (source != invalid-type && !is-subtype(types, source, types.error-type))
                . message = "Error transformer catch requires an error type"
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            bind-catcher(row.type)
            . chain [TypeId]
            for previous in tree.children[row.previous]
                bind-catcher(previous)
                chain += caught-type(previous)
            if source != invalid-type && frame.has-transform(source, chain)
                . shown = type-short-name(types, source)
                . message = "Ambiguous error transformer for $shown; only one transformer may "
                message ++= "match the same error chain."
                frame.diagnose(catcher, .stated, program.store-atom(message))
                continue
            if !typed
                . saved = frame.surround
                frame.surround = Surround
                    - exceptional-effects(saved.effects)
                    - saved.zone-site
                    - saved.catch-depth
                    - saved.transformer-depth + 1
                raised = infer(exception)
                frame.surround = saved
                typed = true
            if source != invalid-type && raised != invalid-type && raised != no-type
                . fact = facts.note-transform
                    - instance
                    - catcher
                    - site
                    - exception
                    - source
                    - chain
                    - raised
                frame.add-transform(source, raised, chain, site, fact)

────────────────────
_ do caught-type TypeId
    - pattern SyntaxId

= match tree.nodes[pattern]
    | .node-type-capture(row)
        types.evaluate-type(module, tree, row.type, frame.env)
    ??
        types.evaluate-type(module, tree, pattern, frame.env)

────────────────────
_ do typed-catcher TypeId
    - pattern SyntaxId

` The error a catcher names, or none where it names only a local for it.
= match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type == 0 then no-type else caught-type(pattern)
    ??
        caught-type(pattern)

────────────────────
_ do bind-catcher
    - pattern SyntaxId

if pattern == 0
    =
do match? tree.nodes[pattern]
    | .node-type-capture(row)
        . slot = declaring-slot(pattern)
        . caught = types.evaluate-type(module, tree, row.type, frame.env)
        if slot && caught != invalid-type
            frame.assign(slot, caught)

────────────────────
_ do plan-class-test
    - id SyntaxId
    - op Operator
    - value TypeId
    - rhs SyntaxId

` Plans `is` or `is not` between an object and a class as a test of the object's class, and
` records the class tested for as the node's constant. The class tested for is the object's
` own, one it is derived from, or one derived from it: any other is no class the object can
` be of, and the test is of what the object converts to, as any other pattern's is.
if (op != .is-op && op != .is-not-op) || value == invalid-type || value == no-type
    =
if types.intrinsic-of(value) != .class || types.completions[value].has-variables
    =
. target = invalid-type
do match tree.nodes[rhs]
    | .node-symbol
        =
    | .node-type-case
        =
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    ??
        target = types.evaluate-type(module, tree, rhs, frame.env)
if target == invalid-type || target == no-type
    =
types.complete(target)
if types.intrinsic-of(target) != .class || types.completions[target].has-variables
    =
if types.facet-of-type(target) != null
    =
. kind = relations.compare(value, target).kind
. same = kind == .relation-same || kind == .relation-equal
if !same && kind != .relation-up-cast && kind != .relation-down-cast
    =
facts.set-constant(instance, id, ConstantFact(target, 0, null, false), .plan-class-test)

────────────────────
_ do infer-unprojected TypeId
    - syntax SyntaxId

` The type of the subject of a match or of the value `is` tests. A local known to hold one
` case of its union is read there as the union, not as the case, as the reference reads it.
` One that holds an optional of the union is known to hold a value, and is read as the union.
. read = infer(syntax)
do match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        if resolution.kind == .resolve-slot && facts.plan-of(instance, syntax) == .plan-case-read
            . declared = frame.known(resolution.slot)
            if types.is-optional(declared)
                declared = types.optional-inner(declared)
            facts.set-plan(instance, syntax, .plan-none)
            facts.replace-node-type(instance, syntax, declared)
            = declared
= read

────────────────────
_ do plan-is
    - id SyntaxId
    - op Operator
    - subject TypeId
    - right SyntaxId

` Plans `is` or `is not` between a value and a pattern that is no test of an object's class.
` The pattern is planned as the pattern of an arm of a match is: a type named by the
` conversions that say what it tests, a case named by its number, of a union, of an optional
` one, or of the union a row of a table holds, and a pattern of items as it is planned in a
` match. Types in parentheses are the tuple of them. One that can not match the value is never
` true: so a pattern of items against a text, which has none to give, and a case against an optional row, as TypeScript has it. A
` case no type the module can name has is not found. A pattern of texts against a `String` is
` planned as one in a match.
if subject == invalid-type || subject == no-type || types.completions[subject].has-variables
    =
. kind = is-specificity(op)
. target = no-type
do match tree.nodes[right]
    | .node-symbol(row)
        . given = if types.is-optional(subject) then types.optional-inner(subject) else subject
        if names-enum-value(right, 0, row.name, given)
            =
        . given-kind = types.intrinsic-of(given)
        if given-kind == .union
            note-case(right, given, row.name)
        else if given == subject && (given-kind == .table-row || given-kind == .immutable-table-row)
            note-case(right, row-struct-of(given), row.name)
        . refined = given == subject && given-kind == .union && !names-case(given, row.name)
        if refined && refined-payload(given, row.name) != no-type
            facts.set-plan(instance, right, .plan-refined-case)
        else if facts.plan-of(instance, right) != .plan-case
            facts.set-plan(instance, right, .plan-never)
            if anonymous-symbol(right, row.name) == no-type && symbol-class(types, module, row.name) == invalid-type
                missing-case(right, row.name, given)
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-type-case
        check-pattern(right, subject)
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-type-list
        if subject == types.string-type || !is-collection-type(tree, right)
            plan-is-items(id, subject, right)
            =
        target = types.evaluate-type(module, tree, right, frame.env)
    | .node-type-map
        if !is-collection-type(tree, right)
            plan-is-items(id, subject, right)
            =
        target = types.evaluate-type(module, tree, right, frame.env)
    | .node-type-and { subject == types.string-type && check-text-pattern(right) }
        facts.set-plan(instance, id, .plan-is)
        =
    | .node-identifier(row)
        target = types.type-named(module, row.name, frame.env)
    | .node-tuple-syntax(row)
        target = tuple-named(row.items)
        if target == invalid-type
            . reported = facts.diagnostics.length
            for item in tree.children[row.items]
                report-missing-type(item, frame.env)
            if facts.diagnostics.length == reported
                . text = "Only types may be written in parentheses after \"is\"; to test what the fields hold, match the value with an arm, as in \"| (3, name)\""
                frame.diagnose(right, .stated, program.store-atom(text))
            =
    ??
        target = types.evaluate-type(module, tree, right, frame.env)
if target == invalid-type || target == no-type
    report-missing-type(right, frame.env)
    =
if refuses-facet-test(right, target)
    =
if types.completions[target].has-variables
    target = complete-named(target, subject, kind)
if target != no-type && could-match(subject, target, kind)
    plan-leaves(right, subject, target, kind, U32.max)
    plan-exact(right, kind)
else
    facts.set-plan(instance, right, .plan-never)
facts.set-plan(instance, id, .plan-is)

────────────────────
_ do refuses-facet-test Bool
    - syntax SyntaxId
    - target TypeId

` Whether a type a value is tested for is a facet's, which every object of its owner has, so that
` no test could say anything, and reports so.
. facet = types.facet-of-type(target)
=? false if !facet
. owner = types.facet-owner(facet)
. message = "${type-short-name(types, target)} is a facet, which every ${type-short-name(types, owner)} has, so no value is tested for it"
frame.diagnose(syntax, .stated, program.store-atom(message))
= true

────────────────────
_ do tuple-named TypeId
    - items RowRange'SyntaxId

` The tuple of the types written in parentheses after `is`, as in `pair is (Int, String)`, or
` the invalid type where one of them names no type.
. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0
for item in tree.children[items]
    . field = match tree.nodes[item]
        | .node-identifier(row)
            types.type-named(module, row.name, frame.env)
        ??
            types.evaluate-type(module, tree, item, frame.env)
    if field == invalid-type || field == no-type
        scratch.types.rewind(mark)
        scratch.names.rewind(names-mark)
        = invalid-type
    scratch.names.push(types.index-atom(position))
    scratch.types.push(field)
    position += 1
= types.intern-tuple(mark, names-mark)

────────────────────
_ do complete-named TypeId
    - target TypeId
    - subject TypeId
    - kind Specificity

` A generic named with its arguments left out, completed from the value it is tested
` against: the generic the value is, or for a union the first of its cases that is one. No
` type where the value is none, and the test is never true.
. given = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(given) == .union
    for fact in types.cases-of(given)
        if fact.type != no-type && fact.type != invalid-type
            . held = relations.compare(fact.type, target, false, false, null, module)
            if instance-relation(held, kind) && !types.completions[held.to].has-variables
                = held.to
    = no-type
. relation = relations.compare(given, target, false, false, null, module)
if instance-relation(relation, kind) && !types.completions[relation.to].has-variables
    = relation.to
= no-type

────────────────────
_ instance-relation Bool
    - relation Relation
    - kind Specificity

relations.holds-as(relation, kind) && !conversions.converts-value(relation.kind)

────────────────────
_ do plan-is-items
    - id SyntaxId
    - subject TypeId
    - right SyntaxId

` Plans `is` between a value and a pattern of items or of keys: as the pattern of an arm of
` a match is planned, or as one that never matches where the value has none to give.
if pattern-possible(right, subject)
    check-pattern(right, subject)
else
    facts.set-plan(instance, right, .plan-never)
facts.set-plan(instance, id, .plan-is)

────────────────────
_ do infer-binary TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - right SyntaxId
    - want Want

if is-type-test(op)
    . tested = infer-unprojected(left)
    forget-carried(left)
    plan-class-test(id, op, tested, right)
    if facts.plan-of(instance, id) != .plan-class-test
        . own-matching = matching
        matching = matching.case = left
        plan-is(id, op, tested, right)
        matching = own-matching
    = types.bool-type
if op == .and-op || op == .or-op
    note-truthiness(id, left, infer-tested(left))
    if never-holds(left, op == .and-op)
        facts.set-plan(instance, id, .plan-never)
        = types.bool-type
    . mark = scratch.narrowings.mark
    narrowing.narrow-condition(left, op == .and-op)
    note-truthiness(id, right, infer-tested(right), true)
    pop-conditional(mark)
    = types.bool-type
if op == .coalesce-op
    = infer-coalesce(id, left, right, want)
if op == .else-op
    do match? tree.nodes[left]
        | .node-binary-expression(row)
            = infer-choice(id, row.lhs, row.rhs, right, want)
if op == .if-op
    = infer-conditional(id, left, right, want)
if is-pipeline-nested(op) || op == .pipe-forward-op || writes || op == .stream-pattern-pipe-op
    = infer-pipeline(id, op, left, right)
.. writes = op == .pipe-write-all-op || op == .pipe-write-each-op

. equates = op == .equals-op || op == .not-equals-op
if equates && (narrowing.is-null-syntax(left) || narrowing.is-null-syntax(right))
    . lhs = infer(left)
    . rhs = infer(right)
    forget-carried(left)
    forget-carried(right)
    . other = if narrowing.is-null-syntax(left) then rhs else lhs
    . operand = if narrowing.is-null-syntax(left) then right else left
    if other != invalid-type && other != no-type
        if types.is-optional(other) || reads-held(operand, other)
            facts.set-plan(instance, id, .plan-absent)
            = types.bool-type
    = infer-binary-values(id, op, left, lhs, right, rhs)
. names-left = tree.symbol-of(left) != null || tree.calls-symbol(left)
if equates && names-left && tree.symbol-of(right) == null && !tree.calls-symbol(right)
    . named = infer(right)
    if compares-machine-case(op, left, named)
        = invalid-type
    = infer-compared(id, op, left, infer-comparand(left, named), right, named)
if is-arithmetic(op) && !is-bitwise(op) && shared-symbol(left)
    . given = infer(right)
    = infer-binary-values(id, op, left, infer-receiver-symbol(left, op, given), right, given)
. lhs = infer(left, member-want(op, left, false))
if equates && compares-machine-case(op, right, lhs)
    = invalid-type
. rhs = if equates then infer-comparand(right, lhs) else infer(right, member-want(op, right, true))
note-operand-suffixes(op, left, lhs, right, rhs)
= infer-compared(id, op, left, lhs, right, rhs)

────────────────────
_ member-want Want
    - op Operator
    - operand SyntaxId
    - is-right Bool

` What a membership test asks of the operand it looks in, where that is a list written: that the
` test record what makes it (`want-member`).
if tests && tree.nodes[operand] is .node-list-syntax then Want().adding(.want-member) else Want()

.. tests = if is-right then op == .is-in-op || op == .not-in-op else op == .has-op || op == .has-not-op

────────────────────
_ do compares-machine-case Bool
    - op Operator
    - symbol SyntaxId
    - other TypeId

` Reports a case of a state machine that `==` or `!=` compares with the machine's value: a
` machine's case is tested with `is`, which holds while a case nested in it is active too.
. name = tree.symbol-of(symbol)
if !name || other == invalid-type || other == no-type
    = false
. machine = types.optional-inner(other)
if !is-machine-union(machine) || !names-case(machine, name)
    = false
. test = if op == .equals-op then "is" else "is not"
. written = ".${name.text}"
. message = "A state machine's case is tested with \"is\" or \"is not\", which count the cases nested in it; write \"$test $written\" in place of \"$op $written\""
frame.diagnose(symbol, .stated, program.store-atom(message))
= true

────────────────────
_ do note-operand-suffixes
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

if op == .pow-op || (!is-arithmetic(op) && !is-comparison(op))
    =
if !is-shift(op)
    calls.note-operand-suffix(left, right, rhs)
calls.note-operand-suffix(right, left, lhs)

────────────────────
_ do infer-receiver-symbol TypeId
    - left SyntaxId
    - op Operator
    - rhs TypeId

` A case named by its symbol alone that several types have, as the operand an operator is called
` on: of the last of them that declares the operator for the other operand, as a call settles
` such a case among its arguments by the function it finds, else of the type its name alone gives.
. token = program.store-atom("$op")
. owners [TypeId]
symbol-sharers(left, owners)
. position = owners.length
while position > 0 && rhs != invalid-type
    position -= 1
    . owner = owners[position]
    if calls.has-operator(owner, token, rhs)
        =? infer(left) if position == owners.length - 1
        note-enum-case(owner, tree.symbol-of(left)!, left)
        facts.set-node-type(instance, left, owner)
        = owner
= infer(left)

────────────────────
_ do infer-compared TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

` A comparison casts each side to the type of the other, as the reference does, so a case named
` by its symbol alone compared with a value of a type without the case is of no one type.
if lhs != invalid-type && rhs != invalid-type && is-comparison(op)
    note-unsettled(left, rhs)
    note-unsettled(right, lhs)
= infer-binary-values(id, op, left, lhs, right, rhs)

────────────────────
_ do wider-float Bool
    - one TypeId
    - other TypeId

` Whether a float is wider than another float, which a comparison of the two converts to it.
. first = types.completion-of(one)
. second = types.completion-of(other)
= intrinsic-is-float(first.intrinsic) && intrinsic-is-float(second.intrinsic) && wider-bits
    .. wider-bits = first.bit-size > second.bit-size

────────────────────
_ do mixes-float Bool
    - one TypeId
    - other TypeId

` Whether one of two numbers is a float and the other an integer, which a comparison brings to
` the type arithmetic on the two works in.
. first = types.completion-of(one).intrinsic
. second = types.completion-of(other).intrinsic
= float-first || (is-integer-kind(first) && intrinsic-is-float(second))
    .. float-first = intrinsic-is-float(first) && is-integer-kind(second)

────────────────────
_ do infer-binary-values TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

if lhs == invalid-type || rhs == invalid-type
    = invalid-type
. left-type = conversions.adapted-literal(left, lhs, rhs)
. right-type = conversions.adapted-literal(right, rhs, lhs)
if left-type != lhs || right-type != rhs
    = infer-binary-values(id, op, left, left-type, right, right-type)
if op == .is-in-op || op == .not-in-op
    = infer-containment(id, op == .is-in-op, right, rhs, left, lhs, true)
if op == .has-op || op == .has-not-op
    = infer-containment(id, op == .has-op, left, lhs, right, rhs, false)
if op == .concat-op || op == .concat-string-op
    if op == .concat-op && non-string && calls.has-operator(lhs, types.concat-atom!, rhs)
        = calls.operator-call(id, lhs, types.concat-atom!, right, rhs)
    .. non-string = lhs != types.string-type
    if op == .concat-op && types.intrinsic-of(lhs) != .string
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    note-unsettled(left, types.string-type)
    note-unsettled(right, types.string-type)
    if lhs != types.string-type
        conversions.convert(id, left, lhs, types.string-type, .reason-operator)
    calls.concat-call(id, right, rhs)
    = types.string-type
. lhs-value = if types.is-optional(lhs) then types.optional-inner(lhs) else lhs
. rhs-value = if types.is-optional(rhs) then types.optional-inner(rhs) else rhs
. left-truth = types.intrinsic-of(lhs-value) == .bool
. right-truth = types.intrinsic-of(rhs-value) == .bool
. builtin = numeric && left-truth == right-truth
    .. numeric = is-numeric(types, lhs-value) && is-numeric(types, rhs-value)
. plain = lhs == lhs-value && rhs == rhs-value
. equates = op == .equals-op || op == .not-equals-op
if equates && !plain && lhs != types.null-type && rhs != types.null-type
    . held = infer-held(id, op, left, lhs, right, rhs)
    if held != no-type
        = held
if is-comparison(op) && builtin && !plain && !equates
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
if is-comparison(op) && builtin && plain && (is-declared-number(lhs) || is-declared-number(rhs))
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if overridden != no-type
        = overridden
if is-comparison(op) && builtin
    . plan = OperatorPlan.plan-builtin
    if lhs-value != rhs-value
        . common = integer-comparison-type(types, lhs-value, rhs-value)
        if common != no-type
            cast-operand(left, lhs-value, common)
            cast-operand(right, rhs-value, common)
            if compares-by-sign(types, lhs-value, rhs-value)
                plan = .plan-sign-checked-right
                if types.completions[lhs-value].is-signed
                    plan = .plan-sign-checked-left
        else if plain && mixes-float(lhs-value, rhs-value)
            . machine = promote(types, lhs-value, rhs-value)
            promote-operand(left, lhs-value, machine)
            promote-operand(right, rhs-value, machine)
        else if intrinsic-is-float(types.completions[rhs-value].intrinsic) && narrower
            conversions.convert(left, left, lhs-value, rhs-value, .reason-operand)
        else
            conversions.convert(right, right, rhs-value, lhs-value, .reason-operand)
        .. narrower = !wider-float(lhs-value, rhs-value)
    if plain
        facts.set-plan(instance, id, plan)
    = types.bool-type
if is-bitwise(op) && !is-shift(op)
    . answered = calls.operands-call(id, bitwise-name(op), left, lhs, right, rhs)
    if answered != no-type
        = plan-answer(id, .plan-call, answered)
if is-bitwise(op) && builtin
    . fallback = if is-integer(rhs-value) then rhs-value else types.type-row(.int64)
    . decided = if is-integer(lhs-value) then lhs-value else fallback
    . mixed = integers && builtin-number(types, lhs) != builtin-number(types, rhs)
        .. integers = is-integer(lhs) && is-integer(rhs)
    if mixed && !is-shift(op)
        . machine = promote(types, lhs, rhs)
        promote-operand(left, lhs, machine)
        promote-operand(right, rhs, machine)
        facts.set-plan(instance, id, .plan-builtin)
        = machine
    if lhs != decided
        conversions.convert(left, left, lhs, decided, .reason-operand)
    if is-shift(op)
        if rhs != rhs-value
            conversions.convert(right, right, rhs, rhs-value, .reason-operand)
        promote-operand(right, rhs-value, decided)
    else if rhs != decided
        conversions.convert(right, right, rhs, decided, .reason-operand)
    facts.set-plan(instance, id, .plan-builtin)
    = decided
if op == .pow-op && builtin && plain
    = plan-answer
        - id
        - .plan-call
        - calls.operator-call(id, lhs, program.store-atom("$op"), right, rhs)
if is-arithmetic(op) && builtin
    if lhs != lhs-value || left-truth
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    . given = rhs-value
    if rhs != rhs-value
        conversions.convert(right, right, rhs, lhs, .reason-operand)
        given = lhs
    . unit = unit-arithmetic-type(types, lhs-value, given, op == .multiply-op)
    . promoted = promote(types, lhs-value, given)
    if op != .pow-op
        plan-arithmetic(id, left, lhs-value, right, given, unit, promoted)
    = if unit != no-type then unit else promoted
. pointer-lhs = types.completions[lhs-value].intrinsic == .cpointer
if is-arithmetic(op) && pointer-lhs && is-numeric(types, rhs-value)
    if plain && op == .add-op
        facts.set-plan(instance, id, .plan-pointer-add)
    = lhs-value
if op == .add-op
    . zipped = zip-columns(lhs, rhs)
    if zipped != no-type
        facts.set-constant
            - instance
            - id
            - ConstantFact(TableOp.table-zip, 0.0, null, false)
            - .plan-table
        = zipped
. token = program.store-atom("$op")
if is-comparison(op)
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if equates && types.intrinsic-of(lhs) == .type-info && types.intrinsic-of(rhs) == .type-info
        facts.set-plan(instance, id, if lhs == rhs then .plan-alike else .plan-unlike)
        = types.bool-type
    if equates && plain && lhs == types.void-type && rhs == types.void-type && overridden == no-type
        facts.set-plan(instance, id, .plan-alike)
        = types.bool-type
    if overridden != no-type
        = overridden
    . left-address = types.intrinsic-of(lhs) == .cpointer
    . right-address = types.intrinsic-of(rhs) == .cpointer
    . addressed = left-pointer && (right-address || rhs == types.null-type)
        .. left-pointer = left-address || lhs == types.null-type
    if plain && (left-address || right-address) && addressed
        facts.set-plan(instance, id, .plan-address-compare)
        = types.bool-type
    if equates && plain && compare-fields(id, lhs, rhs, right, false)
        compare-fields(id, lhs, rhs, right, true)
        facts.set-plan(instance, id, if op == .equals-op then .plan-fields else .plan-not-fields)
        = types.bool-type
    if equates && plain && lhs == rhs && compare-cases(id, lhs, right, false)
        compare-cases(id, lhs, right, true)
        facts.set-plan(instance, id, if op == .equals-op then .plan-fields else .plan-not-fields)
        = types.bool-type
    if equates && plain && is-unlike(lhs, rhs)
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    . atoms = types.intrinsic-of(lhs) == .atom || types.intrinsic-of(rhs) == .atom
    if equates && plain && atoms && lhs != rhs && lhs != types.null-type && rhs != types.null-type
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    if equates && lhs == rhs && is-identified(lhs)
        facts.set-plan(instance, id, .plan-identity)
        = types.bool-type
    . classes = types.intrinsic-of(lhs) == .class && types.intrinsic-of(rhs) == .class
    if equates && plain && classes && related
        facts.set-plan(instance, id, .plan-identity)
        = types.bool-type
    .. related = in-base-chain(types, lhs, rhs) || in-base-chain(types, rhs, lhs)
    if equates && plain && lhs != rhs && classes
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    if equates && plain && lhs != rhs && closures
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    .. closures = types.intrinsic-of(lhs) == .closure && types.intrinsic-of(rhs) == .closure
    if equates && plain && lhs != rhs && types.intrinsic-of(lhs) == .union
        plan-case-equal(id, left, lhs, right, rhs)
        = types.bool-type
    if equates && plain && types.intrinsic-of(lhs) == .interface && rhs != types.null-type
        compare-interfaces(id, lhs, rhs)
        = types.bool-type
    if equates && plain && types.intrinsic-of(lhs) == .class && rhs-interface
        facts.set-plan(instance, id, .plan-unlike)
        = types.bool-type
    .. rhs-interface = types.intrinsic-of(rhs) == .interface
    if types.intrinsic-of(lhs-value) == .interface && rhs != types.null-type
        instances.mark-may-panic(instance)
    if is-numeric(types, lhs) && !is-numeric(types, rhs-value) && rhs != types.null-type
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    . unanswered = unplanned && lhs != types.null-type && rhs != types.null-type
        .. unplanned = facts.plan-of(instance, id) == .plan-none
    if plain && unanswered && (lhs-value != rhs-value || !equates)
        frame.diagnose(id, .illegal-operation, null, lhs, rhs)
        = invalid-type
    = types.bool-type
if is-numeric(types, lhs) && !is-numeric(types, rhs)
    if calls.has-operator(lhs, token, rhs)
        = plan-answer(id, .plan-call, calls.operator-call(id, lhs, token, right, rhs))
    if is-numeric(types, lhs-value) && !is-numeric(types, rhs-value)
        frame.diagnose(right, .illegal-cast, null, rhs, lhs-value)
        = invalid-type
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
= plan-answer(id, .plan-call, calls.operator-call(id, lhs, token, right, rhs))

────────────────────
_ do infer-held TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId

` `==` or `!=` where an operand is an optional, in the order the reference asks:
` - two tuples of which one declares `==` for the other are compared where both operands
`   hold a value, and two that hold nothing are equal;
` - else a function the operands declare for each other as they are answers, as for any
`   comparison: no type is given here, and nothing is recorded;
` - else the operands are compared as what they hold, and two that hold nothing are equal
`   where they are optionals of one type.
` The `==` of what they hold is typed as any `==` is, with the right operand first where the
` reference puts an optional on the right first. Where that `==` tests a union on the left
` for a case, the one plan tests the case of what the optional holds. Nothing is planned where
` that `==` has no plan, or where two optionals of different types would be answered by a
` function.
. lhs-value = if types.is-optional(lhs) then types.optional-inner(lhs) else lhs
. rhs-value = if types.is-optional(rhs) then types.optional-inner(rhs) else rhs
if types.is-optional(lhs-value) || types.is-optional(rhs-value)
    = no-type
. equals = program.store-atom("${Operator.equals-op}")
. tuples = types.intrinsic-of(lhs-value) == .tuple && types.intrinsic-of(rhs-value) == .tuple
. declared = tuples && (calls.has-operator(lhs-value, equals, rhs-value) || calls.has-operator(rhs-value, equals, lhs-value))
if !declared && (!is-numeric(types, lhs-value) || !is-numeric(types, rhs-value))
    . overridden = infer-override(id, op, left, lhs, right, rhs, false)
    if overridden != no-type
        = overridden
. paired = lhs != lhs-value && rhs != rhs-value
. exchanged = rhs != rhs-value && (lhs == lhs-value || lhs == rhs || declared)
. answer = invalid-type
if exchanged
    answer = infer-binary-values(id, .equals-op, right, rhs-value, left, lhs-value)
else
    answer = infer-binary-values(id, .equals-op, left, lhs-value, right, rhs-value)
. inner = facts.plan-of(instance, id)
if answer == types.bool-type && inner == .plan-held && !exchanged
    . tested = facts.held-of(instance, id)
    if tested.case-index != U32.max && !tested.left && !tested.right
        facts.set-held
            - instance
            - id
            - HeldPlan
                - tested.plan
                - lhs != lhs-value
                - rhs != rhs-value
                - false
                - false
                - tested.case-index
        = types.bool-type
. called = plain-called || inner == .plan-neither-call || inner == .plan-not-or-call
    .. plain-called = inner == .plan-call || inner == .plan-negated-call
if answer != types.bool-type || inner == .plan-none || inner == .plan-held || undeclared-pair
    facts.set-plan(instance, id, .plan-none)
    = answer
.. undeclared-pair = paired && lhs != rhs && !declared && called
facts.set-held
    - instance
    - id
    - HeldPlan
        - inner
        - lhs != lhs-value
        - rhs != rhs-value
        - paired && (lhs == rhs || declared)
        - exchanged
= types.bool-type

────────────────────
_ do compare-fields Bool
    - id SyntaxId
    - left TypeId
    - right TypeId
    - right-syntax SyntaxId
    - records Bool

` Whether two tuples or structs are compared field by field: both store as many fields under
` the same names, and each pair in turn is one type the machine compares, or declares `==`,
` or is one class or atoms, or two unions of one type compared case by case, or is again two
` such tuples or structs, or two optionals of one type that declares `==` or is one of these,
` compared where both hold a value. With `records`, the call of each `==` is recorded at the
` node, in the order the fields are stored.
. kind = types.intrinsic-of(left)
. other = types.intrinsic-of(right)
if (kind != .tuple && kind != .struct) || (other != .tuple && other != .struct)
    = false
types.complete(left)
types.complete(right)
. mine = types.completions[left].properties
. theirs = types.completions[right].properties
. equals = program.store-atom("${Operator.equals-op}")
. a U32
. b U32
while true
    while a < mine.count && types.properties[mine.start + a].slot == U32.max
        a += 1
    while b < theirs.count && types.properties[theirs.start + b].slot == U32.max
        b += 1
    if a >= mine.count || b >= theirs.count
        = a >= mine.count && b >= theirs.count
    if types.properties[mine.start + a].name != types.properties[theirs.start + b].name
        = false
    . held = member-type(types.properties[mine.start + a], left)
    . given = member-type(types.properties[theirs.start + b], right)
    a += 1
    b += 1
    if held == no-type || held == invalid-type || given == no-type || given == invalid-type
        = false
    if held == given && compares-by-machine(types, held) && !is-declared-number(held)
        continue
    if calls.has-operator(held, equals, given)
        if records
            calls.operator-call(id, held, equals, right-syntax, given)
        continue
    if held == given && (compares-by-machine(types, held) || is-identified(held))
        continue
    if types.intrinsic-of(held) == .interface && types.intrinsic-of(given) == .interface
        if records
            require-interface-equality(id, held)
        continue
    if held == given && compare-cases(id, held, right-syntax, records)
        continue
    if held == given && types.is-optional(held)
        . inner = types.optional-inner(held)
        if calls.has-operator(inner, equals, inner)
            if records
                calls.operator-call(id, inner, equals, right-syntax, inner)
            continue
        if compares-by-machine(types, inner) || is-identified(inner) || compare-cases(id, inner, right-syntax, records) || compare-fields(id, inner, inner, right-syntax, records)
            continue
        = false
    if !compare-fields(id, held, given, right-syntax, records)
        = false
= true

────────────────────
_ do compare-cases Bool
    - id SyntaxId
    - type TypeId
    - right-syntax SyntaxId
    - records Bool

` Whether two unions of one type are compared case by case: they are equal where both hold
` the same case and what it holds is equal, compared as a field of a tuple is. A case that
` holds nothing of its own is equal to itself. With `records`, the call of each `==` is
` recorded at the node, in the order of the cases.
if type == no-type || type == invalid-type || types.intrinsic-of(type) != .union
    = false
. equals = program.store-atom("${Operator.equals-op}")
for fact in types.cases-of(type)
    . held = fact.type
    if fact.is-default || held == no-type
        continue
    if held == invalid-type
        = false
    if compares-by-machine(types, held) && !is-declared-number(held)
        continue
    if calls.has-operator(held, equals, held)
        if records
            calls.operator-call(id, held, equals, right-syntax, held)
        continue
    if compares-by-machine(types, held)
        continue
    if is-identified(held)
        continue
    if types.intrinsic-of(held) == .interface
        if records
            require-interface-equality(id, held)
        continue
    if compare-fields(id, held, held, right-syntax, records)
        continue
    if !compare-cases(id, held, right-syntax, records)
        = false
= true

────────────────────
_ do plan-case-equal
    - id SyntaxId
    - left SyntaxId
    - union TypeId
    - right SyntaxId
    - type TypeId

` Plans `==` of a union with a value of another type, as the reference answers it: the union
` is tested for the case a value of that type is held as, and what it holds is compared with
` the value as any two values of the type are. Nothing is planned where that case holds
` another type than the value's, or the `==` of two such values has no plan.
. relation = relations.compare(type, union, false, false, null, module)
if relation.kind != .relation-wrap-cast || relation.case-index == U32.max
    =
. held = types.cases-of(union)[relation.case-index]
if held.is-default || held.type != type
    =
. answer = infer-binary-values(id, .equals-op, left, type, right, type)
. inner = facts.plan-of(instance, id)
if answer != types.bool-type || inner == .plan-none || inner == .plan-held
    facts.set-plan(instance, id, .plan-none)
    =
facts.set-held(instance, id, HeldPlan(inner, false, false, false, false, relation.case-index))

────────────────────
_ is-identified Bool
    - type TypeId

` Whether two values of a type that declares no `==` are equal when they are one: one object
` of a class, one atom, one closure's data, or one code and data that two values of a function
` type hold.
class-or-atom || types.intrinsic-of(type) == .closure || function-row(types, type) != no-type

.. class-or-atom = types.intrinsic-of(type) == .class || types.intrinsic-of(type) == .atom

────────────────────
_ is-declared-number Bool
    - type TypeId

` Whether a number's type is a class written over a machine number, which may declare its own
` operators: a comparison of two asks them first, as of any other type.
owner.decl != 0 && is-numeric(types, type) && !types.is-builtin-decl(owner.module, owner.decl)

.. owner = class-ref(types, type)

────────────────────
_ do is-unlike Bool
    - left TypeId
    - right TypeId

` Whether two tuples or structs are never equal: they store other numbers of fields, or a
` field of one has another name than the field in its place in the other.
. kind = types.intrinsic-of(left)
. other = types.intrinsic-of(right)
if (kind != .tuple && kind != .struct) || (other != .tuple && other != .struct)
    = false
types.complete(left)
types.complete(right)
. mine = types.completions[left].properties
. theirs = types.completions[right].properties
. a U32
. b U32
while true
    while a < mine.count && types.properties[mine.start + a].slot == U32.max
        a += 1
    while b < theirs.count && types.properties[theirs.start + b].slot == U32.max
        b += 1
    if a >= mine.count || b >= theirs.count
        = a < mine.count || b < theirs.count
    if types.properties[mine.start + a].name != types.properties[theirs.start + b].name
        = true
    a += 1
    b += 1
= false

────────────────────
_ do member-type TypeId
    - property TypeProperty
    - owner TypeId

` The type of a stored property, typed from the value its class writes when none is declared.
if property.type != no-type
    = property.type
= demand-member(property, owner, property.name)

────────────────────
_ do plan-arithmetic
    - id SyntaxId
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId
    - unit TypeId
    - promoted TypeId

` Plans arithmetic on two numbers as the machine operation in their promoted type. With a
` unit, the right operand is first brought to the unit by its ratio, both are brought to the
` machine type of the unit, and the result goes back to the unit.
. machine = promoted
. given = rhs
if unit != no-type
    machine = promote(types, builtin-number(types, unit), builtin-number(types, unit))
    if rhs != unit
        conversions.convert(id, right, rhs, unit, .reason-operator)
        given = unit
promote-operand(left, lhs, machine)
promote-operand(right, given, machine)
if unit != no-type && unit != machine
    . relation = conversions.compare-held(machine, unit)
    conversions.record-conversion(id, relation, .reason-result)
facts.set-plan(instance, id, .plan-builtin)

────────────────────
_ do promote-operand
    - operand SyntaxId
    - source TypeId
    - target TypeId

` Brings an operand to the type its operator works in. The cast is the operator's own, which
` the reference makes without recording it, so it has a reason of its own. It is recorded at
` the operand as written, and never at the value of a local the operand names.
if source == target
    =
. relation = conversions.compare-held(source, target)
conversions.record-conversion(operand, relation, .reason-promotion, true)

────────────────────
_ do cast-operand
    - operand SyntaxId
    - source TypeId
    - target TypeId

` Brings an operand of a comparison of two integers to the type both are compared in. The
` cast is the operator's own, as in the reference, so a literal is not checked for fit:
` `-1 < 4000000000u32` is legal.
if source == target
    =
. relation = conversions.compare-held(source, target)
conversions.record-conversion(operand, relation, .reason-operand)

────────────────────
_ do compare-interfaces
    - id SyntaxId
    - left TypeId
    - right TypeId

` Plans `==` of a value of an interface with another value. Two values of interfaces are
` equal when the type behind the left one says so, through the function its witness table
` holds for equality, which the interface then requires; where the types behind them
` differ, the getter that says whether a tracker compares for a change is read. A value of a
` type that is no interface on the right is the panic the reference compiles in.
instances.mark-may-panic(instance)
if types.intrinsic-of(right) != .interface
    facts.set-plan(instance, id, .plan-interface-unlike)
    =
require-interface-equality(id, left)
facts.set-plan(instance, id, .plan-interface-equal)

────────────────────
_ do require-interface-equality
    - id SyntaxId
    - interface TypeId

` Notes that two values of an interface are compared at a node: the interface requires
` equality, the getter of a tracker's comparison for a change is recorded at the node, and
` the comparison may panic. Under an effect that forbids it, it is TypeScript's error.
instances.mark-may-panic(instance)
. restricted = heap-effects /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend /or/ ban-bits()
    .. heap-effects = CompilationEffect.gc-free /or/ CompilationEffect.no-heap
if (dispatch-effects(frame.surround.effects) /and/ restricted) != 0
    frame.diagnose
        - id
        - .restricted
        - program.store-atom("Interface equality requires unrestricted effects")
    =
facts.require-equality(interface)
. action = types.live-action-type
if action != invalid-type
    calls.demand-module-getter
        - class-ref(types, action).module
        - program.store-atom("is-comparing-for-change")
        - id

────────────────────
_ do infer-override TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - lhs TypeId
    - right SyntaxId
    - rhs TypeId
    - exchanged Bool

` A comparison is answered by a function its operands declare. In order:
` - the operator itself;
` - the operator that says the reverse, negated: `!=` by `==`, `<=` by `>`;
` - for an ordering, the mirrored one with equality: `<` holds when neither `>` nor `==`
`   does, and `<=` when `>=` does not or `==` does;
` - the mirrored operator with the operands exchanged.
` Gives no type when nothing is declared.
. direct = call-override(id, op, left, lhs, right, rhs, exchanged)
if direct != no-type
    = plan-answer(id, .plan-call, direct)
. negated = call-override(id, negation-of(op), left, lhs, right, rhs, exchanged)
if negated != no-type
    = plan-answer
        - id
        - .plan-negated-call
        - if negated != invalid-type then types.bool-type else negated
. equates = op == .equals-op || op == .not-equals-op
. mirror = opposite-of(op)
if !equates
    . mirrored = call-override(id, mirror, left, lhs, right, rhs, exchanged)
    if mirrored == invalid-type
        = mirrored
    if mirrored != no-type
        . equal = call-override(id, .equals-op, left, lhs, right, rhs, exchanged)
        if equal != no-type
            . strict = op == .less-than-op || op == .greater-than-op
            . plan = if strict then neither-plan else OperatorPlan.plan-not-or-call
                .. neither-plan = OperatorPlan.plan-neither-call
            = plan-answer(id, plan, if equal != invalid-type then types.bool-type else equal)
        . mine = type-class-name(lhs)
        . theirs = type-class-name(rhs)
        . compared = if mine == theirs then mine else "$mine or $theirs"
        frame.diagnose(id, .stated, program.store-atom("Must implement == for $compared"))
        = invalid-type
if exchanged
    = no-type
= infer-override(id, mirror, right, rhs, left, lhs, true)

────────────────────
_ bitwise-name Atom
    - op Operator

` The name of the function that answers a bitwise operator in place of the operator itself,
` when one is declared.
|? op == .bitwise-and-op
    types.and-atom!
|? op == .bitwise-or-op
    types.or-atom!
??
    types.xor-atom!

────────────────────
_ do plan-answer TypeId
    - id SyntaxId
    - plan OperatorPlan
    - result TypeId

` Records how an operator is answered, once a function was found to answer it.
if result != invalid-type
    facts.set-plan(instance, id, plan)
= result

────────────────────
_ type-class-name String
    - type TypeId

match types.rows[type]
    | .type-class(row)
        class-name(program, row.module, row.decl)
    ??
        type-short-name(types, type)

────────────────────
_ opposite-of Operator
    - op Operator

match op
    |= .not-equals-op
        .equals-op
    |= .less-than-op
        .greater-than-op
    |= .greater-than-op
        .less-than-op
    |= .less-than-equals-op
        .greater-than-equals-op
    |= .greater-than-equals-op
        .less-than-equals-op
    |= .equals-op
        .not-equals-op
    ??
        .equals-op

────────────────────
_ negation-of Operator
    - op Operator

` The comparison that holds exactly when another does not.
match op
    |= .not-equals-op
        .equals-op
    |= .less-than-op
        .greater-than-equals-op
    |= .greater-than-op
        .less-than-equals-op
    |= .less-than-equals-op
        .greater-than-op
    |= .greater-than-equals-op
        .less-than-op
    ??
        .not-equals-op

────────────────────
_ do infer-containment TypeId
    - id SyntaxId
    - positive Bool
    - container-syntax SyntaxId
    - container TypeId
    - item-syntax SyntaxId
    - item TypeId
    - is-right Bool

` `has` and `has not` answer for each other: a container that declares only one is asked that
` one and the answer is negated, as the reference does for an operator and its opposite.
` `is-right` says the container is the operator's right operand, as it is for `is in`. A list
` written in place may be answered without being made (`plans-list-member`); one that is not
` records here what makes it.
. has-not = program.store-atom("has not")
. wanted = if positive then types.has-atom! else has-not
. other = if positive then has-not else types.has-atom!
. chosen = wanted
if !(calls.has-operator(container, wanted, item) • arg-syntax item-syntax) && answers-other
    chosen = other
.. answers-other = calls.has-operator(container, other, item) • arg-syntax item-syntax
. found = calls.operator-call(id, container, chosen, item-syntax, item)
if found == invalid-type
    = found
if is-right
    facts.mark-swapped(instance, id)
facts.set-plan(instance, id, if chosen == wanted then .plan-call else .plan-negated-call)
if chosen == types.has-atom! && plans-list-member(id, container-syntax, container)
    facts.set-plan(instance, id, .plan-list-member)
else if tree.nodes[container-syntax] is .node-list-syntax
    instances.mark-may-panic(instance)
    calls.note-list(container-syntax, container)
= types.bool-type

────────────────────
_ do plans-list-member Bool
    - id SyntaxId
    - written SyntaxId
    - list TypeId

` Whether `has` of a list written in place, which core's `List` answers, is answered as
` `List.has` answers it without making the list (`plan-list-member`): where `==` of two values
` of the list's item type, planned at the list, compares them by the machine, as one object or
` one atom, or by the one function it calls, declared in a class, which `List.has` sees as this
` module does. An extension's `==` that this module sees may be hidden from `List.has`.
=? false if tree.nodes[written] is not .node-list-syntax
. callee = operator-callee(id)
=? false if callee == no-instance || instances.rows[callee].module != types.list-decl.module
=? false if instances.rows[callee].self-type != list || !same-decl(class-ref(types, list), types.list-decl)
. item = first-arg(list)
=? false if item == no-type || item == invalid-type
. kind = types.intrinsic-of(item)
. identified = kind == .class || kind == .atom
. declared = calls.has-operator(item, program.store-atom("${Operator.equals-op}"), item)
=? false if !declared && !identified && !compares-by-machine(types, item)
. answer = infer-binary-values(written, .equals-op, written, item, written, item)
. plan = facts.plan-of(instance, written)
. machine = plan == .plan-builtin && compares-by-machine(types, item)
. same = plan == .plan-identity && identified
. called = plan == .plan-call && in-class(operator-callee(written))
=? true if answer == types.bool-type && (machine || same || called)
facts.set-plan(instance, written, .plan-none)
= false

────────────────────
_ do in-class Bool
    - callee InstanceId

` Whether a function is declared in the body of a class, which code sees wherever it sees the
` class, and not in an extension.
=? false if callee == no-instance
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = program.modules[row.module].decls[fn.owner] is .decl-class
= false

────────────────────
_ do operator-callee InstanceId
    - id SyntaxId

` The function the one call of an operator recorded at a node calls, or no instance where
` there is none, or more than one.
. found = no-instance
. fact = facts.first-call(instance, id)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-operator
        =? no-instance if found != no-instance || row.is-partial
        found = row.callee
    fact = row.next
= found

────────────────────
_ do infer-conditional TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId
    - want Want

` `value if condition`: an optional of the value, empty where the condition fails. A lambda
` given where a function is expected is that function, as the reference types it with the type
` expected (`want-fitting`): its optional is of that type.
. fitting = fitting-of(want)
note-truthiness(id, right, infer(right), true)
. mark = scratch.narrowings.mark
narrowing.narrow-condition(right, true)
. value = infer(left)
pop-conditional(mark)
if value == invalid-type
    = invalid-type
. fits = fitting != no-type && value != no-type && types.intrinsic-of(value) == .closure
. wrapped = types.optional-of(if fits then fitting else value)
if wrapped != value
    conversions.convert(id, left, value, wrapped, .reason-join)
= wrapped

────────────────────
_ do infer-coalesce TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId
    - want Want

if tree.coalesces-condition(id, left)
    frame.diagnose(id, .stated, program.store-atom("`value if condition ?? other` is not a choice of two values. Write `if condition then value else other`."))
    = invalid-type
. lhs = infer-tested(left, if want.asks(.want-fitting) then Want().asking(.want-fitting, want.type) else Want())
forget-carried(left)
skippable-depth += 1
. rhs = if shared-symbol(right) then infer(right) else infer-comparand(right, lhs)
skippable-depth -= 1
if lhs == invalid-type || rhs == invalid-type
    = invalid-type
if lhs == types.void-type
    frame.diagnose(id, .illegal-operation, null, lhs, rhs)
    = invalid-type
if lhs == types.null-type
    = rhs
if !types.is-optional(lhs)
    note-truthiness(id, left, lhs)
rhs = conversions.adapted-literal(right, rhs, types.optional-inner(lhs))
. inner = types.optional-inner(lhs)
. target = if types.is-optional(rhs) || rhs == types.null-type then lhs else inner
. relation = relations.unify-present(lhs, rhs, module)
if types.is-optional(lhs)
    relation = relations.unify-fallback(target, rhs, module)
if !relation-legal(relation)
    frame.diagnose(id, .illegal-cast, null, rhs, target)
    = invalid-type
. joined = relation.unified
. settled = settle-joined(right, rhs, joined)
if inner != joined
    conversions.convert(id, left, inner, joined, .reason-join)
if settled != joined
    conversions.convert(id, right, settled, joined, .reason-join)
= joined

────────────────────
_ do infer-tested TypeId
    - syntax SyntaxId
    - want Want = Want()

` The type of an operand of `&&`, `||` or `!`, of the left of `??`, and of the condition of
` `while` or `=?` or of a clause of a loop. A local that holds an optional is tested there as
` the optional it is, also where the flow knows it to hold a value, as the reference tests
` it: for whether it holds one, and not for what the one it holds is. Every other condition
` tests what it holds.
. read = infer(syntax, want)
if read == invalid-type || read == no-type
    = read
if !reads-held(syntax, read)
    note-tested-force(syntax, read)
    = read
. declared = slot-known(bindings.resolution-of(frame.binding, syntax).slot)
facts.replace-node-type(instance, syntax, declared)
= declared

────────────────────
_ do note-tested-force
    - syntax SyntaxId
    - read TypeId

do match? tree.nodes[syntax]
    | .node-unary-expression(row)
        if row.op == .optional-force-op && reads-held(row.operand, read)
            . fact = facts.first-force(instance, syntax)
            if fact != no-fact
                facts.forces[fact].is-tested = true

────────────────────
_ do reads-held Bool
    - expr SyntaxId
    - read TypeId

` Whether an expression reads a local that holds an optional, where the flow knows it to
` hold a value and so reads that value.
do match? tree.nodes[expr]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, expr)
        if resolution.kind == .resolve-slot
            . known = slot-known(resolution.slot)
            = types.is-optional(known) && types.optional-inner(known) == read
= false

────────────────────
_ do infer-choice TypeId
    - id SyntaxId
    - value-syntax SyntaxId
    - condition SyntaxId
    - other-syntax SyntaxId
    - want Want

` `if condition then value else other`: the two sides joined, an optional where either side is
` `null` or an optional. A lambda given where a function is expected is that function, as
` `infer-conditional` types it. A choice a function gives as its result joins at the declared
` result type when both sides convert to it, as the reference casts each side there.
. fitting = fitting-of(want)
. wanted = if want.asks(.want-choice) then want.type else no-type
note-truthiness(id, condition, infer(condition))
. mark = scratch.narrowings.mark
narrowing.narrow-condition(condition, true)
. value = infer-choice-side(value-syntax, wanted)
. value-settled = frame.assigned-since(mark)
frame.pop-narrowing(mark)
narrowing.narrow-condition(condition, false)
. other = infer-choice-side(other-syntax, wanted)
pop-conditional(mark)
widen-settled(value-settled)
if value == invalid-type || other == invalid-type
    = invalid-type
if wanted != no-type && fits-choice(value, wanted) && fits-choice(other, wanted)
    if value != wanted
        conversions.convert(id, value-syntax, value, wanted, .reason-join)
    if other != wanted
        conversions.convert(id, other-syntax, other, wanted, .reason-join)
    = wanted
value = conversions.adapted-literal(value-syntax, value, types.optional-inner(other))
other = conversions.adapted-literal(other-syntax, other, types.optional-inner(value))
if value == types.null-type && other == types.null-type
    = value
if value == types.null-type
    = optional-side(id, other-syntax, other, value-syntax, fitting)
if other == types.null-type
    = optional-side(id, value-syntax, value, other-syntax, fitting)
. optional = types.is-optional(value) || types.is-optional(other)
. present = types.optional-inner(value)
. present-other = types.optional-inner(other)
. relation = relations.unify(present, present-other, module)
if !relation-legal(relation)
    relation = relations.unify-fallback(present, present-other, module)
if !relation-legal(relation)
    frame.diagnose(id, .illegal-cast, null, other, present)
    = invalid-type
. joined = relation.unified
. result = if optional then types.optional-of(joined) else joined
join-side(id, value-syntax, value, present, joined, result)
join-side(id, other-syntax, other, present-other, joined, result)
= result

────────────────────
_ do infer-choice-side TypeId
    - side SyntaxId
    - wanted TypeId

` A side of a choice, of `wanted` when one is given: a case named by its symbol alone is the case
` of that type, and a choice is joined at it.
=? infer(side) if wanted == no-type
=? infer-with-expected(side, wanted) if !tree.is-choice-syntax(side)
= infer(side, Want().asking(.want-choice, wanted))

────────────────────
_ fits-choice Bool
    - side TypeId
    - wanted TypeId

relation-legal(relations.compare(side, wanted, true, false, null, module))

────────────────────
_ do optional-side TypeId
    - id SyntaxId
    - side SyntaxId
    - given TypeId
    - empty SyntaxId
    - fitting TypeId

` The join of a choice one side of which is `null`: an optional of the other side, which each
` side converts to, or the other side where it is a union with a case that holds `null`.
. present = types.optional-inner(given)
if given == present && holds-null(given)
    conversions.convert(id, empty, types.null-type, given, .reason-join)
    = given
. fits = fitting != no-type && types.intrinsic-of(present) == .closure
. result = types.optional-of(if fits then fitting else present)
if given != result
    conversions.convert(id, side, given, result, .reason-join)
conversions.convert(id, empty, types.null-type, result, .reason-join)
= result

────────────────────
_ do join-side
    - id SyntaxId
    - side SyntaxId
    - given TypeId
    - present TypeId
    - joined TypeId
    - result TypeId

` Converts a side of a choice to its join: a case named by its symbol alone is cast to the
` type the sides join to, as the reference casts it there.
. settled = settle-joined(side, present, joined)
. arrives = if types.is-optional(given) then types.optional-of(settled) else settled
if arrives != result
    conversions.convert(id, side, arrives, result, .reason-join)

────────────────────
_ do settle-joined TypeId
    - branch SyntaxId
    - value TypeId
    - joined TypeId

` The type a branch of a join arrives in: a case named by its symbol alone that several types
` have is cast to the type the branches join to, as the reference casts it there.
if value == joined || !loose-symbol(branch)
    = value
= infer-with-expected(branch, joined)

────────────────────
_ do infer-comparand TypeId
    - right SyntaxId
    - lhs TypeId

. symbol = tree.symbol-of(right)
if symbol && lhs != invalid-type && lhs != no-type
    . owner = types.optional-inner(lhs)
    if enum-case-decl(types, program, owner, symbol)
        note-enum-case(owner, symbol, right)
        facts.set-node-type(instance, right, owner)
        = owner
if lhs != invalid-type && lhs != no-type && tree.calls-symbol(right)
    = infer-with-expected(right, types.optional-inner(lhs))
= infer(right)

────────────────────
_ do infer-unary TypeId
    - id SyntaxId
    - op Operator
    - operand-syntax SyntaxId

` Types an operator written before its operand. A force of what an arm's condition tested takes
` the type the test gave (`collect-arms`). A force of what the flow does not know to hold a value
` ends what is known of properties, as the reference's panic where it holds none makes calls. A
` function value has no truth for `!` to deny.
if op == .delete-op
    = infer-delete(id, operand-syntax)
if op == .facts-of-op
    = types.string-type
. operand = if op == .optional-force-op && operand-syntax == arm-typing.forced then forced-type else no-type
    .. forced-type = facts.node-type(instance, operand-syntax)
. held = false
if operand == no-type && op == .not-op
    operand = infer-tested(operand-syntax)
else if operand == no-type
    . found = infer-found(operand-syntax, if op == .optional-force-op then Want().adding(.want-forced) else Want())
    operand = found.type
    held = found.held
if operand == invalid-type
    = invalid-type
if op == .not-op
    forget-carried(operand-syntax)
    . completion = types.completion-of(operand)
    . declares = completion.intrinsic == .class && !completion.is-builtin
    . valued = completion.intrinsic == .tuple || completion.intrinsic == .struct
    if declares && calls.demand-method(operand, program.store-atom("!")) == no-instance
        frame.diagnose(id, .illegal-operation, null, operand)
        = invalid-type
    if declares || valued || completion.intrinsic == .string
        . shapes-start = scratch.call-arguments.mark
        . types-start = scratch.types.mark
        . syntax-start = scratch.syntax.mark
        . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
        . not-atom = program.store-atom("!")
        . result = calls.method-call(id, operand-syntax, operand, not-atom, arguments)
        scratch.syntax.rewind(syntax-start)
        scratch.types.rewind(types-start)
        scratch.call-arguments.rewind(shapes-start)
        = plan-answer(id, .plan-call, result)
    if completion.intrinsic == .closure || completion.intrinsic == .binding
        frame.diagnose(id, .illegal-operation)
        = invalid-type
    if is-numeric(types, operand) || completion.intrinsic == .cpointer || types.is-optional(operand)
        facts.set-plan(instance, id, .plan-builtin)
    = types.bool-type
if op == .bitwise-not-op
    . decided = if is-integer(operand) then operand else types.type-row(.int64)
    if operand != decided
        conversions.convert(operand-syntax, operand-syntax, operand, decided, .reason-operand)
    if is-numeric(types, operand)
        facts.set-plan(instance, id, .plan-builtin)
    = decided
if op == .negative-op
    . completion = types.completion-of(operand)
    . kind = completion.intrinsic
    . aggregate = kind == .class || kind == .tuple || kind == .struct
    if !is-numeric(types, operand) && aggregate && !completion.is-builtin
        . shapes-start = scratch.call-arguments.mark
        . types-start = scratch.types.mark
        . syntax-start = scratch.syntax.mark
        . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
        . neg-atom = program.store-atom("-neg")
        . result = calls.method-call(id, operand-syntax, operand, neg-atom, arguments)
        scratch.syntax.rewind(syntax-start)
        scratch.types.rewind(types-start)
        scratch.call-arguments.rewind(shapes-start)
        = plan-answer(id, .plan-call, result)
    if !is-numeric(types, operand)
        frame.diagnose(id, .illegal-operation, null, operand)
        = invalid-type
    facts.set-plan(instance, id, .plan-builtin)
    = operand
if op == .read-op
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    . read-atom = program.store-atom("<-read")
    . result = calls.method-call(id, operand-syntax, operand, read-atom, arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
    = plan-answer(id, .plan-call, result)
if op == .optional-force-op
    if types.is-optional(operand)
        instances.mark-may-panic(instance)
        frame.forget-members()
    . result = types.optional-inner(operand)
    . slot = narrowing.condition-slot(operand-syntax)
    . is-narrowed = false
    . declared = no-type
    if slot && !types.is-optional(operand)
        declared = key-declared(slot)
        is-narrowed = declared != no-type && types.is-optional(declared)
    facts.record-force(instance, id, operand, result, is-narrowed)
    if is-narrowed && held && unsure-stores.length != 0
        unsure-forces += id
        unsure-operands += operand-syntax
        unsure-declared += declared
        unsure-forced += unsure-stores.length as U32
    if is-narrowed && typing-lazies.length != 0
        if scratch.narrowed-since(lazy-marks[lazy-marks.length - 1], slot!) == no-type
            forcing-lazies += typing-lazies[typing-lazies.length - 1]
            forcing-facts += (facts.forces.length - 1) as FactId
            forcing-declared += declared
    = result
if op == .type-of-op
    if types.intrinsic-of(operand) == .class
        note-loose(operand-syntax)
    . viewed = types.facet-of-type(operand)
    = type-info-of(id, if viewed then types.facet-owner(viewed) else operand)
if op == .facts-of-op
    = types.string-type
decline(operand-syntax)
= invalid-type

────────────────────
_ do infer-delete TypeId
    - id SyntaxId
    - operand-syntax SyntaxId

do match? tree.nodes[operand-syntax]
    | .node-index-expression(row)
        . object = infer(row.object)
        . key = infer(row.index)
        if object == invalid-type || key == invalid-type
            = invalid-type
        . name = program.store-atom("-=[]")
        . result = calls.operator-call(operand-syntax, object, name, row.index, key)
        if result == object && intrinsic-is-tuple-like(types.intrinsic-of(object))
            facts.set-plan(instance, operand-syntax, .plan-store-answer)
            note-replacement(operand-syntax, object, result)
        = if result == types.void-type then object else result
decline(id)
= invalid-type

────────────────────
_ do infer-cast TypeId
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A case named by its symbol alone is cast as the reference casts it: settled by the target
` first (`contextual-symbol`), and noted where the cast leaves it of no one type. A target that
` names nothing is reported where it is written. An event cast is wanted as the target, as
` `use-event` says.
. target = types.evaluate-type(module, tree, rhs, frame.env)
. value = infer(lhs, Want().escaping(target, lhs))
if target == invalid-type
    report-missing-type(rhs, frame.env)
    = invalid-type
if value == invalid-type
    = target
. symbol = tree.symbol-of(lhs)
if symbol
    . owner = contextual-symbol(types, relations, target, symbol, module)
    if owner != invalid-type && owner != value
        facts.replace-node-type(instance, lhs, owner)
        note-enum-case(owner, symbol, lhs)
        value = owner
    else if owner != invalid-type
        calls.settle-unfound(lhs)
. cast = cast-value(id, lhs, value, target)
if cast != invalid-type
    note-unsettled(lhs, target, true)
= cast

────────────────────
_ do cast-value TypeId
    - id SyntaxId
    - lhs SyntaxId
    - value TypeId
    - target TypeId

. callable = types.completions[value].intrinsic
if callable == .closure || callable == .binding
    = conversions.convert(id, lhs, value, target, .reason-explicit)
if is-const-array(value) && !is-const-array(target) && cpointer-item(target) != no-type
    frame.diagnose(id, .illegal-cast, null, value, target)
    = invalid-type
. relation = relations.compare-explicit(value, target, module)
. chooses = relation-legal(relation) && types.intrinsic-of(target) == .or
. answer = conversions.answer-of(relation)
if answer != no-type
    relation.to = answer
    relation.unified = answer
if relation-legal(relation) && relation.kind != .relation-same
    . requested = if chooses then target else no-type
    conversions.record-conversion(id, relation, .reason-explicit, false, requested, lhs)
    . down = relation.kind == .relation-down-cast || relation.kind == .relation-interface-down-cast
    if down || relation.kind == .relation-unwrap-cast
        instances.mark-may-panic(instance)
    if is-caught-cast(relation, value, target)
        demand-union-error()
        facts.set-plan(instance, id, .plan-caught-cast)
        . mark = scratch.types.mark
        scratch.types.push(types.union-error-type)
        = result-type(types, target, mark)
. collides = relation.reason == .reason-ambiguous || relation.reason == .reason-conflict
if !relation-legal(relation) && (collides || !explicit-cast-allowed(value, target))
    conversions.report-illegal(id, relation, value, target)
    = invalid-type
if !relation-legal(relation) && reinterprets(value, target)
    facts.set-plan(instance, id, .plan-reinterpret)
. open = types.completions[target].has-variables || relations.holds-alternatives(target)
= if chooses || (open && relation-legal(relation)) then relation.to else target

────────────────────
_ is-caught-cast Bool
    - relation Relation
    - value TypeId
    - target TypeId

` Whether a cast is one out of a union written under `catch`, to one of its cases and not to
` text: where it fails it gives an error in place of its value.
|? frame.surround.catch-depth == 0 || (relation.kind != .relation-unwrap-cast && not-down-cast)
    false
|? target == types.string-type || types.completions[target].has-variables
    false
??
    types.intrinsic-of(value) == .union && relation.to == target

.. not-down-cast = relation.kind != .relation-down-cast

────────────────────
_ do reinterprets Bool
    - value TypeId
    - target TypeId

` Whether a cast is between an atom and a text, which keeps the bits of the value: an atom
` is a pointer at its text.
. source = types.intrinsic-of(value)
. destination = types.intrinsic-of(target)
if source == .atom && destination == .string
    = true
= source == .string && destination == .atom

────────────────────
_ explicit-cast-allowed Bool
    - value TypeId
    - target TypeId

` A number converts to any other, except between two units no equality relates.
|? is-unit-class(types, value) && is-unit-class(types, target)
    false
|? is-numeric(types, value) && is-numeric(types, target)
    true
??
    reinterprets(value, target)

────────────────────
_ do infer-range TypeId
    - id SyntaxId
    - op Operator
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId

. item = range-item(id, left-syntax, right-syntax, increment)
if item == invalid-type
    = invalid-type
= range-construction(id, op, item, left-syntax, right-syntax, increment)

────────────────────
_ do range-item TypeId
    - range SyntaxId
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId
    - peer TypeId = no-type

` The item of a range: what its sides and its step unify to, each converted to that where
` it is written. An integer written with no suffix at one side is of the type of the other, and
` one written as the step of the type of the sides, as beside an operator, and the range is of
` the type of the other side. Sides written so beside a float step are of the step's type. A range with no step written steps by one, which is converted to
` an item that is no number at the range itself. Such an integer takes the integer type of a
` peer given, as a loop's pattern states it, before the type of the other side. Sides of two
` integer types neither converts to unasked are of the type arithmetic promotes them to.
. left = if left-syntax != 0 then infer(left-syntax) else types.position-type
. right = if right-syntax != 0 then infer(right-syntax) else types.position-type
. step = if increment != 0 then infer(increment) else no-type
if left == invalid-type || right == invalid-type || step == invalid-type
    = invalid-type
if peer != no-type && is-integer(peer)
    left = conversions.adapted-literal(left-syntax, left, peer)
    right = conversions.adapted-literal(right-syntax, right, peer)
. left-given = left
. right-given = right
left = conversions.adapted-literal(left-syntax, left, right)
right = conversions.adapted-literal(right-syntax, right, left)
. relation = relations.unify(left, right, module)
. promoted = !relation-legal(relation) && is-integer(left) && is-integer(right)
if !relation-legal(relation) && !promoted
    frame.diagnose(range, .illegal-operation, null, left, right)
    = invalid-type
. item = if promoted then promotion else if left != left-given then right else right-adapted
    .. promotion = promote(types, left, right)
    .. right-adapted = if right != right-given then left else relation.unified
. step-given = step
step = conversions.adapted-literal(increment, step, item)
if step != no-type && step == step-given
    . stepped = relations.unify(item, step, module)
    if relation-legal(stepped)
        item = stepped.unified
    else
        left = conversions.adapted-literal(left-syntax, left, step)
        right = conversions.adapted-literal(right-syntax, right, step)
        if left != step || right != step
            frame.diagnose(range, .illegal-operation, null, item, step)
            = invalid-type
        item = step
if left-syntax != 0 && left != item
    range-side(left-syntax, left, item, promoted)
if right-syntax != 0 && right != item
    range-side(right-syntax, right, item, promoted)
if increment != 0 && step != item
    conversions.convert(increment, increment, step, item, .reason-element)
if increment == 0 && !intrinsic-is-numeric(types.intrinsic-of(item))
    conversions.convert(range, range, types.type-row(.int64), item, .reason-step)
= item

────────────────────
_ do range-side
    - side SyntaxId
    - given TypeId
    - item TypeId
    - promoted Bool

` Brings a side of a range to its item: as an element converts, or where the sides are integers
` neither converts to unasked, by the cast arithmetic makes to the type both promote to.
if !promoted
    conversions.convert(side, side, given, item, .reason-element)
    =
conversions.record-conversion(side, conversions.compare-held(given, item), .reason-element)

────────────────────
_ do range-construction TypeId
    - id SyntaxId
    - op Operator
    - item TypeId
    - left-syntax SyntaxId
    - right-syntax SyntaxId
    - increment SyntaxId

. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
for _ in 0 .. < 3
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(item)
scratch.syntax.push(if left-syntax != 0 then left-syntax else id)
scratch.syntax.push(if right-syntax != 0 && left-syntax != 0 then right-syntax else id)
scratch.syntax.push(if increment != 0 then increment else id)
if op == .range-through-op
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(types.bool-type)
    scratch.syntax.push(id)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
. env = types.class-env(types.range-decl.module, types.range-decl.decl)
. pattern = env.this-type
types.env-release(env)
. result = calls.construction-on(id, pattern, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do infer-tuple TypeId
    - items RowRange'SyntaxId

. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0
. valid = true
for item in tree.children[items]
    . field = infer(item)
    if field == invalid-type
        valid = false
    note-loose(item)
    note-escape(item)
    scratch.names.push(types.index-atom(position))
    scratch.types.push(field)
    position += 1
if !valid
    scratch.types.rewind(mark)
    scratch.names.rewind(names-mark)
    = invalid-type
= types.intern-tuple(mark, names-mark)

────────────────────
_ do note-escape
    - value SyntaxId

` A value the reference stores where it no longer follows it, in a local, a property or a field
` of a tuple, ends what it knows of what the value is read from (`forget-escaped`), or of
` every property where the value is `this` (`forget-receiver`). A cast or a `!` of a value is
` read from what the value is.
. subject = tree.escaped-subject(value)
do match? tree.nodes[subject]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, subject)
        if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-this
            frame.forget-receiver()
            =
        . key = narrowing.base-key(subject)
        if key
            frame.forget-escaped(key)
    | .node-get-expression(row)
        if row.is-optional
            =
        . shared = narrowing.receiver-member(row.object, row.name)
        if shared
            frame.forget-escaped(shared)
            =
        . base = narrowing.base-key(row.object)
        if base
            . key = frame.find-path-key(base, row.name)
            if key
                frame.forget-escaped(key)

────────────────────
_ do infer-header TypeId
    - id SyntaxId
    - expr SyntaxId
    - items RowRange'SyntaxId

` A header gives each item below it to the `with` of what the one before gave. Each call is
` recorded at the header, in order. The first is made on the value written, each after on the
` header itself, which stands for the answer of the one before; one of those that would
` convert its receiver is declined, since the conversion would be kept at the header.
. left = infer(expr)
. with-atom = program.store-atom("with")
. object = expr
for item in tree.children[items]
    if left == invalid-type
        = invalid-type
    . shapes-start = scratch.call-arguments.mark
    . types-start = scratch.types.mark
    . syntax-start = scratch.syntax.mark
    scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
    scratch.types.push(infer(item))
    scratch.syntax.push(item)
    . arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
    left = calls.method-call(id, object, left, with-atom, arguments)
    scratch.syntax.rewind(syntax-start)
    scratch.types.rewind(types-start)
    scratch.call-arguments.rewind(shapes-start)
    if object == id && left != invalid-type && facts.first-conversion(instance, id) != no-fact
        decline(id)
        = invalid-type
    object = id
= left

────────────────────
_ do infer-list TypeId
    - id SyntaxId
    - items RowRange'SyntaxId
    - want Want = Want()

` The items are joined, unless the list is expected as a list of a type each item converts to on
` its own (`want-items`), which each is made then, as a declared local of that type would be. A
` list a membership test looks in is made only where the test makes it (`want-member`).
. makes = !want.asks(.want-member)
if makes
    instances.mark-may-panic(instance)
. start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. count = 0
for item in tree.children[items]
    scratch.types.push(infer(item))
    scratch.syntax.push(item)
    count += 1
. peer = literal-peer(start, syntax-start, count)
. typed = scratch.types.mark
for offset in 0 .. < count
    scratch.types.push
        - conversions.adapted-literal
            - scratch.syntax[syntax-start + offset]
            - scratch.types[start + offset]
            - peer
. joined = invalid-type
. valid = true
for offset in 0 .. < count
    if scratch.types[typed + offset] == invalid-type
        valid = false
if valid
    . expected = expected-item(want)
    joined = if count != 0 then relations.join(typed) else invalid-type
    if count != 0 && expected != no-type && items-fit(typed, count, expected)
        joined = expected
    if joined == invalid-type
        frame.diagnose(id, .stated, program.store-atom("Incompatible types in list"))
        valid = false
if valid
    for offset in 0 .. < count
        . element = scratch.types[typed + offset]
        . site = scratch.syntax[syntax-start + offset]
        if element != joined && tree.symbol-of(site) != null
            element = infer-with-expected(site, joined)
        if element != joined
            conversions.convert(site, site, element, joined, .reason-element)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(start)
if !valid
    = invalid-type
. list-mark = scratch.types.mark
scratch.types.push(joined)
. list-type = types.class-named-with-args(module, types.list-atom!, list-mark)
if makes
    calls.note-list(id, list-type)
= list-type

────────────────────
_ do expected-item TypeId
    - want Want

` The item of the list type a list is expected as (`want-items`), or no type.
if !want.asks(.want-items)
    = no-type
. expected = types.optional-inner(want.type)
types.complete(expected)
do match? types.rows[expected]
    | .type-class(row)
        if row.module == types.list-decl.module && row.decl == types.list-decl.decl && row.args.count != 0
            . item = types.child-type(row.args, 0)
            types.complete(item)
            if !types.completions[item].has-variables
                = item
= no-type

────────────────────
_ do items-fit Bool
    - mark ScratchMark
    - count Int
    - expected TypeId

for offset in 0 .. < count
    if !fits-choice(scratch.types[mark + offset], expected)
        = false
= true

────────────────────
_ do infer-get Found
    - id SyntaxId
    - object-syntax SyntaxId
    - name Atom
    - is-optional Bool
    - want Want

. owner = static-owner(object-syntax)
if owner != no-type
    facts.set-node-type(instance, object-syntax, type-info-of(object-syntax, owner))
    if want.asks(.want-event) && (types.intrinsic-of(owner) == .class || owner-interface)
        . qualified = event-of(owner, name, true)
        if qualified
            = qualified-event(id, qualified, want)
    .. owner-interface = types.intrinsic-of(owner) == .interface
    = Found(static-get(id, owner, name))
. chain-expr = tree.optional-chain-expr(object-syntax)
. object = no-type
. own = no-type
if chain-expr != 0
    . chained-found = infer-found(chain-expr)
    object = chained-found.type
    own = chained-found.link
    if object != invalid-type && types.is-optional(object)
        facts.set-node-type(instance, object-syntax, types.optional-inner(object))
    else
        facts.set-node-type(instance, object-syntax, object)
else
    . object-found = infer-found(object-syntax, Want().adding(.want-receiver))
    object = object-found.type
    own = object-found.link
if object == invalid-type
    = Found(invalid-type)
if types.intrinsic-of(object) == .type-info
    = Found(static-get(id, type-info-about(object), name))
if name.text == "path" && !is-optional && is-machine-union(object)
    = Found(plan-machine-path(id, object))
. form = if is-optional then note-chain(id, id, object) else ChainForm.chain-plain
if form == .chain-absent || absent-after(object-syntax, object)
    = Found(types.null-type)
. optional = form == .chain-tested
. doubted = false
if !optional && (frame.members-narrowed || frame.narrowed-members.length != 0 || stable-paths)
    . shared = narrowing.receiver-member(object-syntax, name)
    . base = narrowing.base-key(object-syntax)
    . key = shared
    if !key && base
        key = frame.find-path-key(base, name)
    if key && frame.is-doubted(key)
        if !want.asks(.want-store)
            decline(id)
            = Found(invalid-type)
        doubted = true
    if key && frame.knows-member(key)
        . narrowed = forced-member(id, key, want)
        if narrowed != no-type
            plan-narrowed-read(id, object, name)
            if facts.plan-of(instance, id) == .plan-none
                plan-case-read
                    - id
                    - narrowed-from(key, object, name)
                    - frame.narrowed-cases(key)
                    - narrowed
            = Found(narrowed).doubting(doubted).holding(want.asks(.want-forced))
.. stable-paths = frame.path-stable.length != 0
. receiver = link-receiver(object-syntax, object, own, optional)
. chained = (optional || optional-chained(object-syntax)) && types.is-optional(object)
if chained && optional && chain-expr == 0
    facts.unwrapped.append(UnwrappedFact(instance, object-syntax, receiver))
. source = projected-from(object-syntax, receiver)
if source != no-type && !answers(receiver, name)
    receiver = source
. found = read-property(id, object-syntax, receiver, name, want).doubting(doubted)
if found.type == invalid-type
    = found
if is-super-syntax(object-syntax) && !calls-getter(id)
    frame.diagnose(object-syntax, .stated, program.store-atom("Bare super is not a value"))
    = found.typed(invalid-type)
= found.typed(if chained then types.optional-of(found.type) else found.type).linking(found.type)

────────────────────
_ do qualified-event Found
    - id SyntaxId
    - event NamedEvent
    - want Want

` An event a loop names by the class that declares it, which the loop hears as it bubbles up to
` the object that owns the loop. An event that is not public, or one published by key, does not
` bubble, which is an error at the node.
if event.is-private
    frame.diagnose(id, .stated, program.store-atom("Event \"${event.name.text}\" is not public, so it does not bubble and cannot be named by its class"))
    = Found(invalid-type)
if event.key != no-type
    frame.diagnose(id, .stated, program.store-atom("Keyed event \"${event.name.text}\" does not bubble, so it cannot be named by its class"))
    = Found(invalid-type)
= use-event(id, event, want)

────────────────────
_ do is-machine-union Bool
    - union TypeId

` Whether a type is the union of a state machine: the only union told apart by where it is made.
do match? types.rows[union]
    | .type-named-union(row)
        = row.made-at != 0
= false

────────────────────
_ do plan-machine-path TypeId
    - id SyntaxId
    - union TypeId

` `path` read from a value of a machine's union, as the reference answers it: a `List'String`
` of the names of its active cases, made empty and given each name by its `append`.
. mark = scratch.types.mark
scratch.types.push(types.string-type)
. list = types.class-named-with-args(module, types.list-atom!, mark)
if list == invalid-type || list == no-type
    decline(id)
    = invalid-type
calls.note-list(id, list)
. given = scratch.types.mark
scratch.types.push(types.string-type)
. append = calls.demand-runtime-call(module, list, program.store-atom("append"), given)
scratch.types.rewind(given)
if append == no-instance
    decline(id)
    = invalid-type
do facts.record-call(instance, id, append, .call-method, scratch.no-fills, false)
facts.set-plan(instance, id, .plan-machine-path)
instances.mark-may-panic(instance)
= list

────────────────────
_ do plan-narrowed-read
    - id SyntaxId
    - object TypeId
    - name Atom

` A member a test narrowed is read as any member is, and only its type is the narrowed one: a
` field of a table's row is read from its column.
. kind = types.intrinsic-of(object)
if kind != .table-row && kind != .immutable-table-row
    =
. row = row-struct-of(object)
if row == no-type || types.intrinsic-of(row) != .struct
    =
. column = property-named(row, name)
if column && types.properties[column].storage-kind == .storage-eager
    plan-table(id, .table-field, types.properties[column].slot)

────────────────────
_ do plan-array-field
    - id SyntaxId
    - object-syntax SyntaxId
    - name Atom

` A field of numbers that a struct declares, read of an item of an array read by an index, is
` read as TypeScript reads one: where the array's storage holds the item, when the index is
` less than the array's size, and of what the function that answers for an index the array
` does not hold gives anywhere else.
if facts.first-call(instance, id) != no-fact
    =
do match? tree.nodes[object-syntax]
    | .node-index-expression(row)
        if row.is-optional
            =
        . item = facts.node-type(instance, object-syntax)
        if types.intrinsic-of(item) != .struct
            =
        . found = property-named(item, name)
        if !found
            =
        . field = types.properties[found]
        if field.storage-kind != .storage-eager || field.owner != item
            =
        calls.plan-array-item
            - object-syntax
            - facts.node-type(instance, row.index)
            - facts.first-call(instance, object-syntax)
            - field.type

────────────────────
_ do calls-getter Bool
    - id SyntaxId

` Whether a read is answered by a getter. `super` is the receiver of a call and no value: a
` read after it that calls nothing has no object to read.
. fact = facts.first-call(instance, id)
while fact != no-fact
    if facts.calls[fact].form == .call-getter
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ compiles-probe Bool
    - id SyntaxId

program.compiles-probe(module, instances.rows[instance].decl, id)

────────────────────
_ do check-probe
    - id SyntaxId
    - row ASTProbe

` A probe that compiles writes a record through the probes module, each call recorded at the
` probe in the order it makes them (`record-probe-call`): the head of the record, of the object it
` is written of where it has one, then each value written in it, then the flush the module makes
` once enough is written. The texts written in a log are its template, and no values.
. found = probes-module(id)
if !found
    =
. probes = found
. event = row.name != null
. object = check-probe-object(row.object)
if object == invalid-type
    =
. head = if event then "probe-event-head" else "probe-log-head"
if object != no-type
    head = if event then "probe-object-event-head" else "probe-object-log-head"
if !record-probe-head(id, probes, head, object) || !check-probe-values(id, probes, row.content, !event)
    =
record-probe-flush(id, probes)

────────────────────
_ do check-probe-counter
    - id SyntaxId
    - row ASTProbeCounter

` A counter adds to the count the probes module keeps under its key, of the object it is written
` of where it has one, by one or by what it is given, which is converted to `U64`. One that
` compiles only as a metric of the profile adds to the metric instead, which the runtime counts.
. found = probes-module(id)
if !found
    =
. probes = found
. profiles = row.object == 0 && uncounted && program.probes.compiles-profile(row.key.text)
    .. uncounted = !program.probes.compiles-counter(program.modules[module].name, row.key.text)
. object = check-probe-object(row.object)
if object == invalid-type
    =
. delta = types.type-row(.uint64)
if row.delta != 0
    . got = infer-with-expected(row.delta, delta)
    if got == invalid-type || got == no-type
        =
    if conversions.convert(row.delta, row.delta, got, delta, .reason-argument, true, true) == invalid-type
        =
. short = types.type-row(.uint16)
if profiles
    facts.record-call(instance, id, no-instance, .call-probe-metric, scratch.no-fills, false)
else if object == no-type
    record-probe-call(id, probes, "probe-counter-add", [short, delta], .call-probe-head)
else
    record-probe-call
        - id
        - probes
        - "probe-object-counter-add"
        - [short, object, short, delta]
        - .call-probe-head

────────────────────
_ do check-probe-group
    - id SyntaxId
    - row ASTProbeGroup

` A group writes a record where it begins and one where it ends, each a record of its own the
` probes module opens or closes the group by, then flushes. A group of data records events, of the
` object it is written of where it has one, and one written as a log records logs. The values of a
` group are written where it begins, or where it ends where it only ends; a log that only ends
` writes them in a log of their own, then ends. A group that begins and ends ends where the block
` it is written in is left (see the emitter's `emit-probe-group`). A group of data of no object
` and no values that compiles only as a timer of the profile begins and ends the timer instead,
` which the runtime times. One that begins and ends of an object is declined.
. found = probes-module(id)
if !found
    =
. probes = found
. key = if row.key then row.key.text else ""
. objects = row.is-data && row.object != 0
if empty-data && uncompiled && program.probes.compiles-profile(key)
    facts.record-call(instance, id, no-instance, .call-probe-metric, scratch.no-fills, false)
    =
.. empty-data = row.is-data && !objects && (row.is-begin || row.is-end) && row.content.count == 0
.. uncompiled = !program.probes.compiles-data(program.modules[module].name, key)
if objects && row.is-begin && row.is-end
    decline(id)
    =
. object = if objects then check-probe-object(row.object) else no-type
if object == invalid-type
    =
. begins = if row.is-data then "probe-group-push-event" else "probe-group-push"
. ends = if row.is-data then "probe-group-pop-event" else "probe-group-pop"
if objects
    begins = "probe-group-push-object"
    ends = "probe-group-pop-object"
. logs = !row.is-data
if row.is-begin
    if !record-probe-head(id, probes, begins, object, true) || !check-probe-values(id, probes, row.content, logs) || !record-probe-flush(id, probes)
        =
    if !row.is-end
        =
    if record-probe-head(id, probes, ends, object, true)
        record-probe-flush(id, probes)
    =
if !row.is-end
    =
if logs
    if !record-probe-head(id, probes, "probe-log-head", no-type) || !check-probe-values(id, probes, row.content, true) || !record-probe-flush(id, probes)
        =
    if record-probe-head(id, probes, ends, no-type, true)
        record-probe-flush(id, probes)
    =
if record-probe-head(id, probes, ends, object, true) && check-probe-values(id, probes, row.content, false)
    record-probe-flush(id, probes)

────────────────────
_ do probes-module ModuleId?
    - id SyntaxId

` The probes module, which a probe that compiles writes its records through, or none, where the
` probe is declined.
. found = program.module-by-name(probes-module-name)
if !found
    decline(id)
    = null
= found as ModuleId

────────────────────
_ do record-probe-flush Bool
    - id SyntaxId
    - probes ModuleId
    - name String = "probe-flush-if-needed"

` Records at a probe the call that ends a record it writes: the flush the probes module makes once
` enough is written, or the one it makes at once.
. none [TypeId]
= record-probe-call(id, probes, name, none)

────────────────────
_ do check-probe-object TypeId
    - object SyntaxId

` The type of the object a probe is written of, or no type where it is written of none. One the
` probes module gives no id, which is neither an object of a class nor an array nor
` `Inspectable`, is declined.
if object == 0
    = no-type
. got = infer(object)
if got == invalid-type || got == no-type
    = invalid-type
. cast = probe-cast(types, got)
if cast != .probe-object && cast != .probe-array
    decline(object)
    = invalid-type
= got

────────────────────
_ do check-probe-values Bool
    - id SyntaxId
    - probes ModuleId
    - content RowRange'SyntaxId
    - logs Bool

` Records the writes of the values written in a probe, in order. The texts written in a log are
` its template, and no values.
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    if !check-probe-value(id, probes, item, logs)
        = false
= true

────────────────────
_ do check-probe-value Bool
    - id SyntaxId
    - probes ModuleId
    - item SyntaxId
    - logs Bool

` Records the write of a value written in a probe, as its type is cast (`probe-cast`): as it is, by
` the id of its object, or as its text, made as a print makes it, by a call that ends what is known
` of every property, here and in the reference. A log writes an object or an array
` as its text too, but for a snapshot (`$!`), whose object the probes module writes the snapshot
` of, and a preview (`$?`). A preview of a value written as its text writes the name of its type
` instead, and makes no text.
. value = item
. snapshot = false
. preview = false
do match? tree.nodes[item]
    | .node-probe-snapshot(row)
        value = row.content
        snapshot = true
    | .node-probe-preview(row)
        value = row.content
        preview = true
. got = infer(value)
if got == invalid-type || got == no-type
    = false
. cast = probe-cast(types, got)
if cast == .probe-number || cast == .probe-text
    = record-probe-call(id, probes, "probe-write", [got])
if preview && cast == .probe-converted
    = record-probe-call(id, probes, "probe-write", [types.string-type])
if cast == .probe-converted || (logs && !snapshot && !preview)
    note-unsettled(value, types.string-type)
    if conversions.convert(value, value, got, types.string-type, .reason-print) == invalid-type
        = false
    frame.forget-members()
    = record-probe-call(id, probes, "probe-write", [types.string-type])
= record-probe-call
    - id
    - probes
    - "probe-write-object"
    - [got, types.type-row(.uint16), types.bool-type]

────────────────────
_ do record-probe-head Bool
    - id SyntaxId
    - probes ModuleId
    - name String
    - object TypeId
    - groups Bool = false

` Records the call that starts a record of a probe, given the probe's number, and for one of an
` object the object and the number of its class, after the kind of record it opens or closes
` where it `groups`.
. short = types.type-row(.uint16)
if object == no-type
    = record-probe-call(id, probes, name, [short], .call-probe-head)
if groups
    = record-probe-call
        - id
        - probes
        - name
        - [short, types.well-known-type(probes-module-name, "ProbeType"), object, short]
        - .call-probe-head
= record-probe-call(id, probes, name, [short, object, short], .call-probe-head)

────────────────────
_ do record-probe-call Bool
    - id SyntaxId
    - probes ModuleId
    - name String
    - arguments [TypeId]
    - form CallForm = .call-probe

` Records at a probe a call of a function of the probes module, given values of types; one no
` function takes is declined. An error that leaves it is reported where it is made, and what
` follows runs, and making its text may panic.
. mark = scratch.types.mark
for argument in arguments
    scratch.types.push(argument)
. callee = calls.demand-runtime-call(probes, no-type, program.store-atom(name), mark)
scratch.types.rewind(mark)
if callee == no-instance
    decline(id)
    = false
demand-errors(callee)
if instances.signatures[callee].errors.count != 0
    instances.mark-may-panic(instance)
facts.record-call(instance, id, callee, form, scratch.no-fills, false)
= true

────────────────────
_ do infer-print TypeId
    - id SyntaxId
    - body SyntaxId

` The values written in a print are made text one by one. Several are joined by a function
` that polls, so the instance may panic.
do match? tree.nodes[body]
    | .node-tuple-syntax(row)
        instances.mark-may-panic(instance)
        . narrowed = frame.members-narrowed
        for item in tree.children[row.items]
            infer-print(id, item)
            frame.doubt-members-at(narrowed)
        frame.forget-members()
        = types.void-type
. printed = infer(body)
frame.forget-members()
if printed == invalid-type || printed == no-type
    = invalid-type
note-unsettled(body, types.string-type)
if printed != types.string-type
    conversions.convert(id, body, printed, types.string-type, .reason-print)
= types.void-type

────────────────────
_ do report-unheld TypeId
    - id SyntaxId

` The error for characters in a pattern over integer items that do not hold them as they are.
. byte = types.completion-of(stream-view.item).bit-size <= 8
. text = if byte then over-bytes else over-items
    .. over-bytes = "Characters in a pattern over bytes must be ASCII; match other bytes by number"
    .. over-items = "Characters in a pattern over ${type-display(types, stream-view.item)} items must fit that type"
frame.diagnose(id, .stated, program.store-atom(text))
= invalid-type

────────────────────
_ reads-name Bool
    - pattern SyntaxId

` Whether a pattern passes on what a name read from its subject gives: one that reads a
` name, one joined after it, or a name that captures either.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-and(row)
        reads-name(row.left)
    | .node-type-capture(row)
        row.type != 0 && reads-name(row.type)
    ??
        false

────────────────────
_ do note-replacement
    - id SyntaxId
    - target TypeId
    - stored TypeId

` An array stored over an array tells the runtime its storage is replaced, which marks stale
` the views of the old storage where it goes away or shrinks. What an assigning operator
` stores is what its function answers, as it is for an assignment what is written.
if is-array-value(target) && is-array-value(stored)
    facts.mark-replacing(instance, id)
    instances.mark-may-panic(instance)

────────────────────
_ is-array-value Bool
    - type TypeId

|? type == no-type || type == invalid-type || types.intrinsic-of(type) != .tuple
    false
??
    types.ancestor-of(type, types.array-decl) != no-type || immutable-array

.. immutable-array = types.ancestor-of(type, types.immutable-array-decl) != no-type

────────────────────
_ do stored-value TypeId
    - rhs SyntaxId
    - written TypeId

` The type of what an assignment stores. A value written after the `?` of an assignment is
` stored only where it holds a value, so what is stored is what that optional holds; the
` assignment then gives what the place holds afterwards, which where nothing was stored is
` what it held before. Any other value is stored as written.
if written == invalid-type || written == no-type || !types.is-optional(written)
    = written
do match? tree.nodes[rhs]
    | .node-optional-chain
        = types.optional-inner(written)
= written

────────────────────
_ do projected-from TypeId
    - object-syntax SyntaxId
    - receiver TypeId

` The union a local declares when it reads as one of that union's cases: a member the case
` does not answer is still the union's own.
do match? tree.nodes[object-syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, object-syntax)
        if resolution.kind == .resolve-slot
            . known = slot-known(resolution.slot)
            if known != no-type && known != invalid-type && known != receiver
                if types.intrinsic-of(known) == .union
                    = known
= no-type

────────────────────
_ answers Bool
    - receiver TypeId
    - name Atom

|? property-named(receiver, name) != null || calls.has-getter(receiver, name)
    true
??
    calls.method-binding(receiver, name) != no-type

────────────────────
_ do row-capture-of RowCapture?
    - object-syntax SyntaxId

` What a receiver stands for where it is the case of a row: a name a pattern bound to the
` case, or the receiver of a member that runs on a row's case, written or not.
. own = instances.rows[instance]
. adapted = RowCapture(own.row-receiver, own.row-case, own.row-validated)
if object-syntax == 0
    = adapted if own.row-receiver != no-type
do match? tree.nodes[object-syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, object-syntax)
        if resolution.kind == .resolve-slot
            if bindings.slots[resolution.slot].kind == .slot-this
                = adapted if own.row-receiver != no-type
            = cursor-of(resolution.slot)
= null

────────────────────
_ do cursor-of RowCapture?
    - slot SlotId

for held in row-cursors
    if held.slot == slot
        = held.capture
= outer.cursor-of(slot) if outer != null

────────────────────
_ do is-stack-local Bool
    - name SyntaxId

` Whether a name stands for a global bound anew by each `do with` that names it.
. resolution = bindings.resolution-of(frame.binding, name)
if resolution.kind != .resolve-global
    = false
do match? program.modules[resolution.module].decls[resolution.decl]
    | .decl-property(row)
        = row.decoration != null && row.decoration.text == "stack"
= false

━━━━━━━━━━━━━━━━━━━━
+ do checker-for Checker
    - session Session
    - instance InstanceId
    - around Checker? = null
    - probe Bool = false
    - nested Bool = false
    - trial SyntaxRange = SyntaxRange(0, 0)

` A checker for an instance, with the settings `Checker` takes. The kit of a checker that has
` finished is kept and used again, because making one allocates its frame, its calls, and every
` list they hold. The first checker a session makes lists its declarations before it types
` anything (`Checker.list-declarations`).
. idle = session.scratch.idle
if idle.length == 0
    . made = Checker(session, instance, CheckerKit(session), around, probe, nested, trial)
    made.list-declarations()
    = made
. parts = idle[idle.length - 1] as CheckerKit
idle.pop()
= Checker(session, instance, parts, around, probe, nested, trial)

━━━━━━━━━━━━━━━━━━━━
+ do type-written-in Bool
    - session Session

` Types each instance written in another that the passes of a parallel type pass typed and none is
` taken from (`Instances.written-in`), once the one it was written in is typed and did not type it
` in its run, as a closure called after that one finished is typed (`Checker.run-after-enclosing`).
` Says whether it typed any.
. instances = session.instances
. waiting = instances.written-in
. typed = false
. kept = 0
for position in 0 .. < waiting.length
    . id = waiting[position]
    . row = instances.rows[id]
    if row.state != .instance-unstarted
        continue
    . around = instances.rows[row.enclosing].state
    if around != .instance-done && around != .instance-failed
        waiting[kept] = id
        kept += 1
        continue
    . checker = checker-for(session, id)
    checker.run-after-enclosing()
    checker.retire()
    typed = true
while waiting.length > kept
    waiting.pop()
= typed

━━━━━━━━━━━━━━━━━━━━
_ LoopContainer is Tuple

+ type TypeId
+ item TypeId

━━━━━━━━━━━━━━━━━━━━
_ RowCursor is Tuple

` A slot a pattern bound to the case of a row of a table of unions, and what it stands for.

+ slot SlotId
+ capture RowCapture

━━━━━━━━━━━━━━━━━━━━
_ AssumedResult is Tuple

` What an action under a helper took for the type its pattern's arms give where they declare
` none, the type of its own value, and what its choices rest on: whether a name it reads
` selected a materializer, whether it is `it` alone, and where it is a captured name alone,
` what that name holds and whether it holds text; the action, the pattern it follows and its
` expression; and the value materializer taken to make its value again, which is called only
` once the arms are known to give that type.

+ value TypeId
+ selects Bool
+ forwards-it Bool
+ forwarded TypeId
+ backed Bool
+ site SyntaxId
+ pattern SyntaxId
+ body SyntaxId
+ interface TypeId

━━━━━━━━━━━━━━━━━━━━
_ NamedEvent is Tuple

` An event a node names: the class that declares it, as the object's type has it, its name,
` what it publishes, and the type of its key where it is published by key, with the node that
` indexes it with a key where one does. An event that is not public does not bubble.

+ owner TypeId
+ name Atom
+ payload TypeId
+ key TypeId = no-type
+ address SyntaxId = 0
+ is-private Bool = false

━━━━━━━━━━━━━━━━━━━━
_ CalledObject is Tuple

` The object a method is called on, typed before the arguments of the call as the reference
` evaluates it (`type-called-object`): its node, its type, what it links an optional chain to,
` and the event it names where it names one.

+ object SyntaxId = 0
+ type TypeId = no-type
+ link TypeId = no-type
+ event NamedEvent? = null

━━━━━━━━━━━━━━━━━━━━
_ WantRole is U32

` What the context of a node asks of it. Of the type it expects: a function given as a value
` chosen by a condition is of that type (`want-fitting`), the sides of `if condition then value
` else other` are joined at it (`want-choice`), a case a call names by its symbol alone is one of
` it (`want-owner`), and a value that leaves the node there is of it, so that an event the node
` names gives its endpoint where the type is the event's `Broadcastable`, reported at the place
` asked (`want-escape`). Of an event the node names: it is an argument of a call
` (`want-argument`), the container of a loop that adapts it (`want-adapt`), asked for itself
` (`want-event`), or the value of a property stored to (`want-store`). And of the node itself: it
` is the object a member is read from or called on, which `super` may be (`want-receiver`), a
` statement whose value nothing uses (`want-unused`), one of the statements a function gives its
` value from (`want-quasi`), a statement (`want-statement`), the operand of `!`, which reads
` what a property holds where the flow knows it holds a value (`want-forced`), a match written
` as a statement, whose arms are one for their own alone (`want-match-statement`), a line of a
` markup body (`want-content-line`), the container of a markup loop region, which the region
` observes itself (`want-observed`), the name of a pattern a pattern compares with or calls
` (`want-pattern`), or a list written with its items, which are each made the item of the list
` type it expects where each converts to it (`want-items`), or the list written that a membership
` test looks in, which records what makes it only where the test makes it (`want-member`).

| want-none = 0
| want-fitting = 1
| want-choice = 2
| want-owner = 4
| want-escape = 8
| want-argument = 16
| want-adapt = 32
| want-event = 64
| want-store = 128
| want-receiver = 256
| want-unused = 512
| want-quasi = 1024
| want-statement = 2048
| want-forced = 4096
| want-match-statement = 8192
| want-content-line = 16384
| want-observed = 32768
| want-pattern = 65536
| want-items = 131072
| want-member = 262144

━━━━━━━━━━━━━━━━━━━━
_ Want is Tuple

` What the context of a node asks of it where its syntax does not say: the type it expects of the
` node, what that type is for there and the roles the node has (`WantRole`), and where a value
` that escapes it is reported. `infer` gives it to that node alone, and a node gives the one inside
` it that stands for it what it was asked.

+ type TypeId = no-type
+ roles U32 = 0
+ place SyntaxId = 0

────────────────────
+ asks Bool
    - role WantRole

(roles /and/ (role as U32)) != 0

────────────────────
+ asking Want
    - role WantRole
    - type TypeId

Want(type, roles /or/ (role as U32), place)

────────────────────
+ adding Want
    - role WantRole

Want(type, roles /or/ (role as U32), place)

────────────────────
+ escaping Want
    - type TypeId
    - place SyntaxId

Want(type, roles /or/ (WantRole.want-escape as U32), place)

━━━━━━━━━━━━━━━━━━━━
_ Found is Tuple

` What typing a node found beside its type: what a link of an optional chain gives by itself,
` which the chain holds in no optional between its links (`link`); the event it names where it was
` asked for one or stored, kept in `found-events` (`event`), and whether a member a markup element
` receives names it (`kept`); whether a property read where it is stored is in doubt (`doubted`);
` and whether the property `!` reads holds a value the flow knows of (`held`).

+ type TypeId
+ link TypeId = no-type
+ event U32 = U32.max
+ kept Bool = false
+ doubted Bool = false
+ held Bool = false

────────────────────
+ typed Found
    - type TypeId

Found(type, link, event, kept, doubted, held)

────────────────────
+ linking Found
    - link TypeId

Found(type, link, event, kept, doubted, held)

────────────────────
+ doubting Found
    - doubted Bool

Found(type, link, event, kept, doubted, held)

────────────────────
+ holding Found
    - held Bool

Found(type, link, event, kept, doubted, held)

━━━━━━━━━━━━━━━━━━━━
_ LiveContext is U8

` The live action of the reference open where a node is compiled: none, the one the value of
` a property runs in, another, the one a rule of a class runs in, the one the value of an
` assignment or a lazy declaration runs in that a function of its own runs again, the one
` the `whenever` clause of a loop on a stream is tested in, which a function of its own tests
` again, the one the conditions of a markup branch region or the container of a markup loop
` region are read in, which a function of its own reads again, or the one the condition a style
` rule written on a markup element is applied under is tested in as a gate is made, which a
` function of its own tests again.

| live-none = 0
| live-value = 1
| live-other = 2
| live-rule = 3
| live-statement = 4
| live-whenever = 5
| live-region = 6
| live-gate = 7

━━━━━━━━━━━━━━━━━━━━
_ LoopSource is Tuple

` What the container of a markup loop region is to the region, as the reference's
` `markupLoopSource` finds it: the item of its rows, the type the region is given it as, and its
` kind, which names the markup runtime's function that makes the region of it: `collection`,
` `broadcastable` or `iterable`. The invalid type for the item where there is none.

+ item TypeId
+ given TypeId
+ kind String

━━━━━━━━━━━━━━━━━━━━
_ FirstItems is U8

` What the reference knows of the item a part of a stream pattern starts with: it may start
` with anything, or it may match nothing; it starts with any item; it must start with one of
` certain characters; or it is shaped so that what the reference knows is not known here.

| first-open = 0
| first-any = 1
| first-ranges = 2
| first-unsure = 3

━━━━━━━━━━━━━━━━━━━━
_ SelectionEffects

` What the body of a loop over a selection of a table's rows may change, as TypeScript's loop
` over rows notes it: a table's storage, the indices, or a table that grows; or that what it
` changes is not known.

+ table Bool
+ indices Bool
+ selected-table Bool
+ unknown Bool

━━━━━━━━━━━━━━━━━━━━
_ Machining is Tuple

` The machine being typed (`type-machine`): its syntax and where it is stored, the instance of the
` machine above that it refines, the name of a machine nested in a case and whether its parts
` start with the machine around it; its parts (`items`), its cases and the names each keeps, the
` payload each case is given and the types of what each keeps, the cases it starts in, those
` typed and those waiting to be, and the groups found. A nested machine is typed in a frame of its
` own (`type-nested-machine`).

+ syntax SyntaxId
+ store MachineStore
+ refined InstanceId
+ named Atom?
+ outer-starts Bool
+ items [SyntaxId]
+ cases [SyntaxId]
+ kept [[Atom]]
+ payloads [TypeId]
+ kept-types [[TypeId]]
+ starts [SyntaxId]
+ typed [SyntaxId]
+ waiting [SyntaxId]
+ groups-found [MachineGroup]

━━━━━━━━━━━━━━━━━━━━
_ Matching is Tuple

` The match being typed (`infer-match`): whether it gives an optional, the block of a match that
` covers its subject and of one whose arms are blocks (`closed` and `arms`), whether `if` or
` `while` tests it (`open`), whether its subject reads a row of a table, the subject a case
` written alone is a case of, and the type of the subject.

+ optional Bool
+ closed SyntaxId = 0
+ arms SyntaxId = 0
+ open Bool
+ rows Bool
+ case SyntaxId = 0
+ subject TypeId = no-type

━━━━━━━━━━━━━━━━━━━━
_ Arming is Tuple

` The arms being typed (`infer-arms`): whether they stand as a statement, where their values
` start on the typing scratch, the type expected of them, whether they unite and where the types
` they unite start, how many may run and whether several do, the slot of the subject's `it`, and
` how deep the arms that test for a present value are.

+ statement Bool
+ start ScratchMark = 0
+ expected TypeId = no-type
+ unite Bool
+ union ScratchMark = 0
+ possible U32
+ several Bool
+ it SlotId = no-slot
+ present-depth U32

━━━━━━━━━━━━━━━━━━━━
_ ArmTyping is Tuple

` The arm being collected (`collect-arms`): the slot of its `it`, the symbol a choice in it
` names, and the force its value reads through.

+ it SlotId = no-slot
+ symbol SyntaxId = 0
+ forced SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
_ RuleStream is Tuple

` The stream a pattern written in code runs on: the stream match being typed, and the stream a
` local rule is called on, with whether its pattern reads a String's UTF-8 bytes.

+ matched SyntaxId = 0
+ stream TypeId = no-type
+ encoded Bool

━━━━━━━━━━━━━━━━━━━━
_ Valuing is Tuple

` What the part of a stream pattern being typed gives: whether it gives no value of its own, and
` the arm whose action is being typed.

+ unvalued Bool
+ action-arm SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
_ RuleArms is Tuple

` The arms of a stream pattern and what they are converted to (`type-stream-arms`): the type
` given them, whether they give a span of the source, whether they are a rule's, whether they
` give their text, the pattern whose names they capture and where its captures start, and the
` call a pattern argument casts.

+ target TypeId = no-type
+ span Bool
+ rule Bool
+ texts Bool
+ capture-root SyntaxId = 0
+ capture-base Size = 0
+ casting SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
_ StreamView is Tuple

` The stream a pattern reads (`record-stream-view`): the buffer that holds its items, the type of
` an item, and the type of the stream.

+ buffer TypeId = no-type
+ item TypeId = no-type
+ type TypeId = no-type

━━━━━━━━━━━━━━━━━━━━
_ Helping is Tuple

` The helper a stream pattern runs under and how it rolls back: the helper and where it is given,
` whether anything in the pattern rolls back through it, whether the pattern is marked to roll
` back, the body a mark is taken around, and whether it types a span of the source.

+ helper PatternHelper? = null
+ site SyntaxId = 0
+ rolls Bool
+ explicit Bool
+ body SyntaxId = 0
+ span-typing Bool

━━━━━━━━━━━━━━━━━━━━
_ Preparing is Tuple

` How the element being made is given its values and content: the element whose rules are
` applied, whether their values are taken once, whether content they generate is off or refused,
` and whether an outlet's content overlays what it holds.

+ site SyntaxId = 0
+ values-once Bool
+ content-off Bool
+ content-refused Bool
+ overlaying Bool

━━━━━━━━━━━━━━━━━━━━
_ Finally is Tuple

` The `finally` block being checked: whether its cleanup runs, the last node it watches, and
` how many loops are open around it.

+ cleaning-up Bool
+ limit SyntaxId = 0
+ loops Size = 0

━━━━━━━━━━━━━━━━━━━━
_ CallArgumentsTyping is Tuple

` The arguments of the call being typed (`infer-call`): whether what each gives is kept for the
` call to settle, and whether the call names a function nothing declares.

+ keeps Bool
+ unknown-callee Bool

━━━━━━━━━━━━━━━━━━━━
_ UnitStyling is Tuple

` The line of a unit's style being declared, and the property of a unit being updated.

+ styling SyntaxId = 0
+ updating SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
_ Reading is Tuple

` What is being read for a value: the getter a row local reads, the lazy local, and whether an
` eager value is typed in its context.

+ getter SyntaxId = 0
+ lazy SyntaxId = 0
+ eager Bool

━━━━━━━━━━━━━━━━━━━━
_ Region is Tuple

` The markup region being typed (`check-branch`, `check-loop-region`): the type of its content,
` the functions that keep, select and replace what it shows and the source it shows, whether it
` runs in a batch, and the slot of its root.

+ content TypeId = no-type
+ keeps InstanceId = no-instance
+ select InstanceId = no-instance
+ source TypeId = no-type
+ replace InstanceId = no-instance
+ batch Bool
+ root SlotId = no-slot

━━━━━━━━━━━━━━━━━━━━
_ Keying is Tuple

` Where the state cells of the `when`s that style scopes are gathered under are made: whether the
` way to a slot outlet is followed (`outlet-scopes`), the class whose sheets that way adds, and the
` root `<This`, class, or element of markup the cells are keyed at, in its module.

+ discovering Bool
+ sheet-self TypeId = no-type
+ module ModuleId = 0
+ site SyntaxId = 0

