. place = owner-module.first-member(members, name)
while place != no-member
    . member = owner-module.member-pool[place]
    place = owner-module.member-links[place]
    do match? owner-module.decls[member]
        | .decl-property(row)
            if row.name && row.name == name
                if target == 0 || (initializer == 0 && row.value != 0)
                    target = member
                    written = row.syntax
                    initializer = row.value
                if row.type-syntax != 0
                    annotation = row.syntax
if target == 0 && fact.type == no-type && fact.storage-kind == .storage-getter
    = calls.protocol-getter(receiver, name)
if target != 0
    do match? owner-module.decls[target]
        | .decl-property(row)
            if row.line != 0
                = content-property-type(ref, row.line)
            if row.projection != 0
                = projection-type(ref, row.projection, receiver)
if target == 0 || initializer == 0
    = if fact.type != no-type then fact.type else invalid-type
. machine = owner-module.tree.declared-machine(initializer) != 0
. shared = lazily-held && intrinsic-is-class(types.intrinsic-of(receiver))
    .. lazily-held = fact.storage-kind == .storage-lazy || machine
. holder = if shared then holding-type(receiver, ref) else receiver
