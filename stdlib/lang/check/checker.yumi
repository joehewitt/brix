━━━━━━━━━━━━━━━━━━━━
_ is-bitwise Bool
    - op Operator

op == .bitwise-and-op || op == .bitwise-or-op || op == .bitwise-xor-op || is-shift(op)

━━━━━━━━━━━━━━━━━━━━
_ is-shift Bool
    - op Operator

op == .bitwise-lshift-op || op == .bitwise-rshift-op || op == .bitwise-zrshift-op

━━━━━━━━━━━━━━━━━━━━
_ is-arithmetic Bool
    - op Operator

|? op == .add-op || op == .subtract-op || op == .multiply-op
    true
|? op == .divide-op || op == .mod-op || op == .pow-op
    true
|? op == .bitwise-and-op || op == .bitwise-or-op || op == .bitwise-xor-op
    true
??
    op == .bitwise-lshift-op || op == .bitwise-rshift-op || op == .bitwise-zrshift-op
