. nested = scratch.nested-unshared
. fixed = unretirable-weight()
. nested-fixed = scratch.nested-unretirable
. inline-mark = scratch.inline-runs.length
//!typing.serial if !session.shared
    //typing.serial ++
scratch.runners += this
scratch.running += instance
check-instance()
calls.report-unsettled-cases()
settle-generators()
instances.finish-body(instance)
scratch.runners.pop()
scratch.running.pop()
. changed = unshared-weight() - weight
. changed-fixed = unretirable-weight() - fixed
. inline = runs-inline(instances.rows[instance])
if changed != scratch.nested-unshared - nested
    instances.rows[instance].unshared = true
if changed-fixed != scratch.nested-unretirable - nested-fixed
    instances.rows[instance].unretirable = true
if !inline
    scratch.nested-unshared = nested + changed
    scratch.nested-unretirable = nested-fixed + changed-fixed
if instances.rows[instance].unshared
    for position in inline-mark .. < scratch.inline-runs.length
        instances.rows[scratch.inline-runs[position]].unshared = true
if instances.rows[instance].unretirable
    for position in inline-mark .. < scratch.inline-runs.length
        instances.rows[scratch.inline-runs[position]].unretirable = true
if inline
    scratch.inline-runs += instance
else
    while scratch.inline-runs.length > inline-mark
        scratch.inline-runs.pop()
. signature = instances.signatures[instance]
if session.shared && signature.read-in-progress && signature.return-state == .return-failed
    session.shared.diverge()
share(session, instance)
offer-queued(session)

