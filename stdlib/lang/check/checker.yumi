. fitting = if expects then expected-function(expected) else no-type
=? infer(expr, want.asking(.want-fitting, expected)) if fitting != no-type && is-conditional-value(expr)
=? infer(expr, want.asking(.want-items, expected)) if expects && tree.nodes[expr] is .node-list-syntax
=? infer(expr, want) if !expects || !calls-symbol(expr)
