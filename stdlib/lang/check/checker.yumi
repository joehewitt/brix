conversions.begin()
calls.begin()

────────────────────
+ do demand-errors
    - callee InstanceId

` Settles a callee's errors for a call that reads them now. Every body they pass through is
` typed first, here when nothing has typed it yet.
if instances.errors-known(callee)
    =
. errors = session.errors
while true
    . base = errors.gather(callee)
    if errors.unready.length == base
        break
    while errors.unready.length > base
        . last = errors.unready.length - 1
        . next = errors.unready[last] as InstanceId
        errors.unready.rewind(last)
        demand-body(next)
errors.settle(callee)

────────────────────
+ do type-default
    - callee InstanceId
    - position U32

` Types the default of a parameter of a callee where a call first takes it, as the reference
` compiles a default only for a call that takes it: what the default calls is typed then, and
` what it gets wrong is reported then. For a tuple's constructor it is the value its type writes
` for the field the call leaves out (`check-field-default`). The default of a nested function
` is typed nowhere, as no call of it has a shape.
if callee == no-instance || instances.rows[callee].enclosing != no-instance
    =
if !instances.type-default(callee, position)
    =
. checker = checker-for(session, callee, null, true)
if checker.described && checker.described.kind == .tuple-constructor-decl
    checker.check-field-default(position)
else if checker.described
    checker.prepare()
    checker.check-default(position)
    checker.close()
checker.retire()

────────────────────
+ do demand-lambda InstanceId
    - closure TypeId
    - args ImmutableArray'TypeId'ArenaBacking

. owner = 0u32
. nested-decl = 0u32
. enclosing = instance
do match? types.rows[closure]
    | .type-closure(row)
        owner = row.module
        nested-decl = row.decl
        enclosing = row.enclosing
if nested-decl == 0
    = no-instance
. effects = callee-effects(frame, owner, nested-decl)
. callee = instances.intern(owner, nested-decl, no-type, effects, enclosing, scratch.no-types, args)
if instances.rows[callee].state != .instance-unstarted
    = callee
. live = if enclosing == instance then this else definer(enclosing)
. writer = live ?? settled(enclosing)
writer.share-captures(nested-decl)
run-within(callee, writer)
if !live
    writer.dismiss()
= callee

────────────────────
+ do lambda-fit TypeId
    - closure TypeId
    - args ImmutableArray'TypeId'ArenaBacking

` The type a closure returns for the arguments a candidate of a call would pass it, or the
` invalid type when its body does not type with them: that candidate is not the one, and what
` the body got wrong under it is not reported. A body that was refused says nothing of the
` candidate, so the function being typed is refused with it.
. diagnosed = facts.diagnostics.length
. callee = demand-lambda(closure, args)
if callee == no-instance
    = invalid-type
demand-errors(callee)
. declined = facts.declined-since(diagnosed, callee)
if facts.drop-diagnostics(diagnosed, callee)
    instances.set-returns(callee, invalid-type, no-type, .return-failed)
    if declined
        decline(frame.declaration.syntax)
    = invalid-type
. signature = instances.signatures[callee]
if signature.return-state == .return-pending
    = invalid-type
= signature.returns

────────────────────
+ do binding-return BoundReturn
    - binding TypeId
    - args ImmutableArray'TypeId'ArenaBacking
    - asked Bool = false

= calls.bound-return(binding, args, asked)

────────────────────
+ do whole-answer TypeId
    - callable TypeId
    - returned TypeId
    - args ImmutableArray'TypeId'ArenaBacking
    - declared RowRange'TypeId
    - bound InstanceId

` What a closure or a binding answers a function type whose return nothing has bound yet:
` what it returns, or its value or one of its errors where it raises. A parameter of the
` type bound so is how an error crosses a value of the type. A binding's is asked after
` `binding-return`, which found what the binding calls (`bound`).
. binds = types.completions[callable].intrinsic == .binding
. callee = if binds then bound else demand-lambda(callable, args)
if callee == no-instance
    = returned
demand-errors(callee)
. signature = instances.signatures[callee]
if signature.errors.count == 0
    = returned
. mark = scratch.types.mark
for offset in 0 .. < signature.errors.count
    . error = instances.signature-types[signature.errors.start + offset]
    if !declares-error(declared, error)
        scratch.types.push(error)
=? returned if scratch.types.length == mark
= result-type(types, if returned == no-type then types.void-type else returned, mark)

────────────────────
+ do misused-endpoint Bool
    - syntax SyntaxId

` Whether a node that names an event, given to a call as its endpoint, is converted by a
` converter, as the reference converts no endpoint: reported as `refuse-event-value` says.
. place = syntax
do match? tree.nodes[syntax]
    | .node-argument(row)
        place = row.expr
. position = endpoint-arguments.find(place)
if position == null
    = false
. event = endpoint-events[position]
refuse-event-value(place, event.owner, event.name)
. kept = kept-arguments.find(place)
if kept != null
    kept-arguments[kept] = 0
= true

────────────────────
+ do truth-callee InstanceId
    - type TypeId

` The function that says whether a value of a class or a text is empty, which a conversion
` of the value to a Bool calls. No instance for a value of any other type.
. completion = types.completion-of(type)
if completion.intrinsic != .class && completion.intrinsic != .string
    = no-instance
if completion.intrinsic == .class && completion.is-builtin
    = no-instance
= calls.demand-method(type, program.store-atom("!"))

────────────────────
+ do tuple-arity U32
    - value TypeId

if is-column-receiver(types.intrinsic-of(value))
    = column-count(value)
do match? types.rows[value]
    | .type-tuple(row)
        = row.fields.count
    | .type-class
        = struct-arity(value)
= U32.max

────────────────────
+ do field-of TypeId
    - value TypeId
    - position U32

. kind = types.intrinsic-of(value)
if is-column-receiver(kind)
    . column = column-at(value, position)
    if column == no-type
        = invalid-type
    = types.column-view-of(column, kind == .immutable-table || kind == .immutable-table-span)
do match? types.rows[value]
    | .type-tuple(row)
        = if position < row.fields.count then field-type else invalid-type
            .. field-type = types.child-type(row.fields, position)
    | .type-class
        = struct-field-of(value, position)
= invalid-type

────────────────────
+ has-items Bool
    - type TypeId

` Whether a type has items a list pattern reads: one that is `Indexable` and no text.
type != types.string-type && implements(type, types.indexable-decl)

────────────────────
+ do note-enum-case
    - about TypeId
    - name Atom
    - site SyntaxId
    - settles Bool = true

` Notes the case a site names as one of `about`, which `settles` where something expected of it
` is a type with the case (`leave-unfound`).
if settles
    calls.settle-unfound(site)
if tree.calls-symbol(site)
    . busy = calls.suspend-ranking()
    infer-with-expected(site, about)
    calls.resume-ranking(busy)
    =
note-case(site, about, name)
. is-union = types.intrinsic-of(about) == .union
if is-union && (enum-case-value(about, name) ?? 0) == 0
    =
if !is-union && !types.completion-of(about).has-enums
    =
. member = enum-case-decl(types, program, about, name)
if !member
    =
. home = class-ref(types, about).module
demand-body(instances.intern-initializer(home, member, about))
. place = (home as U64) * 4294967296 + (member as U64)
facts.set-constant(instance, site, ConstantFact(place, 0.0, null, false), .plan-enum-value)

────────────────────
+ do note-symbol-choice
    - about TypeId
    - expr SyntaxId

. chosen = symbol-choice(expr)
if chosen == 0
    =
note-symbol-arm(about, chosen)
note-symbol-arm(about, tree.other-side(expr))
facts.replace-node-type(instance, expr, about)

────────────────────
+ do note-enum-number
    - site SyntaxId
    - about TypeId

` Types what a number converted to an enum by its place needs, at the node the conversion is
` recorded at: every value the enum declares is made, and the enum is constructed with
` nothing given for a number that is no value's place. The construction is recorded only at
` a node no call is recorded at.
. ref = class-ref(types, about)
if ref.module == U32.max || site == 0
    =
. home = program.modules[ref.module]
for member in 0 .. < home.decls.length
    do match? home.decls[member]
        | .decl-case(row)
            if row.owner == ref.decl
                demand-body(instances.intern-initializer(ref.module, member as DeclId, about))
if facts.first-call(instance, site) != no-fact
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.construction-on(site, about, arguments)
. fact = facts.first-call(instance, site)
while fact != no-fact
    if facts.calls[fact].form == .call-constructor
        facts.calls[fact].form = .call-enum-default
    fact = facts.calls[fact].next

────────────────────
+ do record-witness
    - from TypeId
    - to TypeId

` A value made a value of an interface. Where its type carries errors of its own, as a
` generator that raises does, a function of the interface that carries none panics with the
` error's text where the type's raises one, so the text of each is made. Where an object of a
` class is made one, the class must use the styles the interface does (`conform-styles`), and a
` value of any type made one must answer the functions the interface requires
` (`conform-members`).
facts.record-witness-table(from, to)
if types.intrinsic-of(from) == .class && types.intrinsic-of(to) == .interface
    conform-styles(from, to)
if types.intrinsic-of(from) != .interface && types.intrinsic-of(to) == .interface
    conform-members(from, to)
do match? types.rows[from]
    | .type-class(row)
        if row.errors.count != 0
            for offset in 0 .. < row.errors.count
                conversions.demand-converter
                    - types.child-type(row.errors, offset)
                    - types.string-type
            conversions.demand-error-report()

────────────────────
+ do demand-union-error

` Types what an unwrapped union that holds another case raises: the error's constructor and
` the converter that gives the panic its message, with the report they are raised through.
if instances.report.union-error != no-instance
    =
. error = types.union-error-type
. made = calls.demand-constructor(error, scratch.types.mark, false, true)
. text = conversions.demand-converter(error, types.string-type)
instances.report.union-error = made
instances.report.union-text = text

────────────────────
+ do note-outgoing
    - error TypeId
    - syntax SyntaxId

` An error leaving the function at a node.
hold-transforms(error, syntax)
frame.note-outgoing(error, syntax)

────────────────────
+ do defer-outgoing
    - callee InstanceId
    - syntax SyntaxId

` The errors of a callee not yet known leaving the function at a call.
hold-transforms(no-type, syntax)
frame.defer-outgoing(callee, syntax)

────────────────────
_ get in-zone-body Bool

` Whether the instance is the body of a `do without gc` block.
frame.declaration.kind == .region-decl

────────────────────
+ do retire

` Hands the checker's kit back once nothing is running on it.
scratch.idle += kit

────────────────────
+ do run

` Types the instance, leaving it `unshared` where its typing, apart from the instances it typed in
` turn, changed what another type pass cannot take in (`unshared-weight`), and publishes what it
` found for the other passes of a parallel type pass (`share`), offering them what it queued. One
` whose return was read while it was typed and then failed makes the parallel pass diverge. An
` instance that is typed only in the run of another (`runs-inline`) is part of that run: what it
` changed is the other's change too, and where the other is left unshared, so is it, so that a
` pass types the two again together. It is left `unretirable` in the same way where what it changed
` is more than rows retiring it removes and what an edit typed again in place keeps
` (`unretirable-weight`).
