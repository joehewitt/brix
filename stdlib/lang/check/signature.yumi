./error-sets
./facts
./frame
./header
./instances
./type-relation
./type-signature
./type-store
./type-text
./types
./typing-scratch
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ Giving is Tuple

` How the function being checked gives its value, as `infer-return` reads it: whether it yields,
` and the type its yields join as, whether a return gives nothing, a conditional return its
` default or an optional whole, and whether its body may run off its end.

+ yields Bool
+ yielded TypeId = no-type
+ empty Bool
+ defaulted Bool
+ whole Bool
+ falls-through Bool

━━━━━━━━━━━━━━━━━━━━
+ do infer-return TypeId
    - frame Frame
    - giving Giving
    - value TypeId

. types = frame.types
. relations = frame.relations
. facts = frame.facts
. instances = frame.instances
. declaration = frame.declaration
if giving.yields
    . item-mark = types.scratch.types.mark
    types.scratch.types.push(if giving.yielded != no-type then giving.yielded else types.void-type)
    . decl = types.generator-decl
    . generator = types.class-with-args(decl.module, decl.decl, item-mark)
    finish-inferred-return(frame, generator)
    = no-type
. mark = types.scratch.types.mark
. first = 0u32
. returns-null = false
for position in frame.returns-start .. < types.scratch.returns.length
    . site = types.scratch.returns[position].type
    if site != no-type && site != types.void-type
        if first == 0
            first = types.scratch.returns[position].syntax
        if site == types.null-type
            returns-null = true
        else
            types.scratch.types.push(site)
if !declaration.is-imperative && value != no-type
    if first == 0
        first = declaration.body
    if value == types.null-type
        returns-null = true
    else
        types.scratch.types.push(value)
. adds-null = returns-null && types.scratch.types.length != mark
if returns-null && !adds-null
    types.scratch.types.push(types.null-type)
if declaration.is-main || types.scratch.types.length == mark
    types.scratch.types.rewind(mark)
    instances.set-returns(frame.instance, types.void-type, no-type, .return-inferred)
    = no-type
. joined = types.scratch.types[mark]
for position in mark + 1 .. < types.scratch.types.length
    . next = types.scratch.types[position]
    . relation = relations.unify(joined, next)
    if !relation-legal(relation)
        if joined != invalid-type && next != invalid-type
            frame.diagnose(first, .unable-to-unify-returns, null, joined, next)
        types.scratch.types.rewind(mark)
        instances.set-returns(frame.instance, invalid-type, no-type, .return-failed)
        = no-type
    joined = relation.unified
types.scratch.types.rewind(mark)
. unified = joined
if nullable && !types.is-optional(joined)
    joined = types.optional-of(joined)
else if giving.defaulted && joined != types.bool-type && !types.is-optional(joined)
    joined = types.optional-of(joined)
.. nullable = giving.empty || giving.falls-through || giving.whole || adds-null

finish-inferred-return(frame, joined)
= unified

━━━━━━━━━━━━━━━━━━━━
_ do finish-inferred-return
    - frame Frame
    - joined TypeId

. types = frame.types
. relations = frame.relations
. facts = frame.facts
. instances = frame.instances
. instance = frame.instance
. provisional = instances.signatures[instance].returns
if instances.signatures[instance].read-in-progress && joined != provisional
    . relation = relations.compare(provisional, joined)
    if relation-legal(relation)
        instances.set-returns(instance, provisional, no-type, .return-inferred)
        =
    . reader = instances.signatures[instance].read-by
    if reader != no-instance && reader != instance && facts.has-diagnostic(reader)
        instances.set-returns(instance, invalid-type, no-type, .return-failed)
        =
    . kind = TypeDiagnosticKind.return-after-recursion
    . site = frame.declaration.syntax
    . owner U32 = frame.module
    facts.record-diagnostic(instance, owner, site, kind, null, provisional, joined)
    instances.set-returns(instance, invalid-type, no-type, .return-failed)
    =
instances.set-returns(instance, joined, no-type, .return-inferred)

━━━━━━━━━━━━━━━━━━━━
+ do narrow-declared-return
    - frame Frame
    - declared TypeId
    - value TypeId

` A declared return that leaves parameters open, or names alternatives, is the type the
` returned values give it: the parameters they bind, or the alternative they choose. A function
` that is one expression returns that expression's value.
. types = frame.types
. relations = frame.relations
. instances = frame.instances
if declared == invalid-type
    =
. chooses = types.intrinsic-of(declared) == .or || relations.holds-alternatives(declared)
if !types.completions[declared].has-variables && !chooses
    =
if instances.signatures[frame.instance].read-in-progress
    =
. narrowed = no-type
for position in frame.returns-start .. < types.scratch.returns.length
    . site = types.scratch.returns[position].type
    narrowed = narrow-return(frame, declared, chooses, narrowed, site)
if !frame.declaration.is-imperative
    narrowed = narrow-return(frame, declared, chooses, narrowed, value)
if narrowed != no-type
    instances.set-returns(frame.instance, narrowed, declared, .return-declared)

━━━━━━━━━━━━━━━━━━━━
_ narrow-return TypeId
    - frame Frame
    - declared TypeId
    - chooses Bool
    - narrowed TypeId
    - site TypeId

|? site == no-type || site == invalid-type || site == types.void-type
    narrowed
|? !relation-legal(relation) || types.completions[given].has-variables
    narrowed
|? narrowed == no-type
    given
??
    if relation-legal(unifier) then unifier.unified else narrowed

.. types = frame.types
.. relations = frame.relations
.. relation = relations.compare(site, declared)
.. given = if chooses then relation.to else relation.unified
.. unifier = relations.unify(narrowed, given)

━━━━━━━━━━━━━━━━━━━━
+ do finish-errors
    - frame Frame
    - lacks-result Bool = false
    - unbuildable Bool = false

` Ends the errors of the body a frame checked. `lacks-result` says the body gives no value
` where one is due, which is an error unless something leaves it; `unbuildable` that it builds
` a type that cannot be built. Both are reported with the errors, in that order.
. instances = frame.instances
. instance = frame.instance
if !instances.errors-known(instance)
    inherit-errors(frame.types, instances, instance, frame.self-type, frame.declaration.kind)
    if instances.rows[instance].is-generator
        instances.move-step-errors(instance)
. outgoing = frame.scratch.outgoing.since(frame.outgoing-start)
. syntax = frame.declaration.syntax
. errors = frame.session.errors
errors.close-body(instance, syntax, outgoing, frame.transforms, lacks-result, unbuildable)

━━━━━━━━━━━━━━━━━━━━
+ callee-effects EffectMask
    - frame Frame
    - module ModuleId
    - decl DeclId

dispatch-effects(frame.surround.effects /or/ declared-effects(frame.program, module, decl))

━━━━━━━━━━━━━━━━━━━━
+ do exceptional-effects EffectMask
    - effects EffectMask

if (effects /and/ CompilationEffect.gc-free) == 0
    = effects
. zone EffectMask = CompilationEffect.gc-free
zone = zone /or/ (CompilationEffect.no-heap)
zone = zone /or/ (CompilationEffect.no-safepoint)
zone = zone /or/ (CompilationEffect.no-suspend)
= effects /and/ (U64.max /xor/ zone)

━━━━━━━━━━━━━━━━━━━━
+ do declared-effects EffectMask
    - program Program
    - module ModuleId
    - decl DeclId

` What a function's header keeps its code from: the restrictions it writes, and the effects it bans.
. declared EffectMask = 0
do match? program.modules[module].decls[decl]
    | .decl-function(row)
        declared = row.effects /or/ program.effects.bans-of(module, decl)
= dispatch-effects(declared)

━━━━━━━━━━━━━━━━━━━━
+ do result-of TypeId
    - frame Frame
    - signature InstanceSignature

. types = frame.types
. mark = types.scratch.types.mark
for offset in 0 .. < signature.errors.count
    types.scratch.types.push(frame.instances.signature-types[signature.errors.start + offset])
. value = signature.returns
if value == no-type
    value = types.void-type
= result-type(types, value, mark)

━━━━━━━━━━━━━━━━━━━━
+ do carried-result TypeId
    - types Types
    - type TypeId

` What a call of a value of a function type answers with where the type carries errors: its
` value or one of them. The errors are those the type declares and those of what it
` returns, where that is already a value or an error, as a parameter of the type bound to
` what a function that raises answers is. No type for a type that carries none.
. fn = function-row(types, type)
if fn == no-type
    = no-type
do match? types.rows[fn]
    | .type-function(row)
        . value = if row.return-type == no-type then types.void-type else row.return-type
        . mark = types.scratch.types.mark
        do match? types.rows[value]
            | .type-result(held)
                if row.errors.count == 0
                    = value
                for offset in 0 .. < held.errors.count
                    types.scratch.types.push(types.child-type(held.errors, offset))
                value = held.value
        if row.errors.count == 0
            = no-type
        for offset in 0 .. < row.errors.count
            types.scratch.types.push(types.child-type(row.errors, offset))
        = result-type(types, value, mark)
= no-type

━━━━━━━━━━━━━━━━━━━━
+ do step-result TypeId
    - types Types
    - generator TypeId
    - stepped TypeId

` What a call of a generator for its next item answers with where the generator carries
` errors, those a step of the body that made it raises: the optional of the item, or one of
` them. No type for a generator that carries none.
do match? types.rows[generator]
    | .type-class(row)
        if row.errors.count != 0
            . mark = types.scratch.types.mark
            for offset in 0 .. < row.errors.count
                types.scratch.types.push(types.child-type(row.errors, offset))
            = result-type(types, stepped, mark)
= no-type

━━━━━━━━━━━━━━━━━━━━
+ do carried-value TypeId
    - types Types
    - returns TypeId

` The value a function type returns: what it returns, or the value of that where it is
` already a value or an error.
if returns == no-type || returns == invalid-type
    = returns
do match? types.rows[returns]
    | .type-result(held)
        = held.value
= returns

━━━━━━━━━━━━━━━━━━━━
+ result-value TypeId
    - types Types
    - type TypeId

|? type == no-type
    types.void-type
??
    match types.rows[type]
        | .type-result(row)
            row.value
        ??
            type
