_ do untracked
    - id SyntaxId
    - name Atom

do match? tree.nodes[id]
    | .node-identifier(row)
        =? if !row.is-tracked
=? if tree.in-applied-value(id) || tree.reads-slot-scope(id)
. shown = name.text
. message = "\"#$shown\" tracks nothing here: a read is followed only where it is written directly in a live value, such as markup, a derived property, a rule or a live statement. Write \"$shown\" to read it plainly, or read \"#$shown\" in the live value and pass it in as an argument"
