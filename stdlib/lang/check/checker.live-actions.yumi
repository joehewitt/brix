            .. pattern-slot = bindings.slots[resolution.slot].kind == .slot-pattern
        if resolution.kind == .resolve-member
            track-read(object, frame.self-type, row.name)
        else if resolution.kind == .resolve-global
            frame.diagnose(object, .stated, program.store-atom("Untrackable name"))
        else if resolution.kind == .resolve-slot && bindings.is-trackable(resolution.slot)
            track-local(object, resolution.slot)
