    =
if instances.signatures[wrap].returns != subscribable
    decline(id)
    =
if is-owner()
    own-subscription(id, stream, item, subscriber, wrap)
else if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscribable, true).answer == invalid-type
    decline(id)
    =
facts.event-uses += EventUse
    - instance
    - id
    - container
    - event.owner
    - event.name
    - .event-subscribe
    - endpoint
    - wrap
    - callback
    - event.address
instances.mark-may-panic(instance)

