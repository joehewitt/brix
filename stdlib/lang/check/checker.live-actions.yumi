. subscribable = types.well-known-type-of("core/stream", "Subscribable", item)
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(subscriber)
scratch.types.push(types.type-row(.bool))
. wrap = calls.demand-runtime-call
    - types.event-endpoint-decl.module
    - no-type
    - program.store-atom("event-subscription")
    - mark
    - 1
scratch.types.rewind(mark)
scratch.types.push(item)
scratch.types.push(stream)
. callback = demand-lambda(closure, scratch.types.since(mark))
scratch.types.rewind(mark)
. endpoint = subscribed-by
if wrap == no-instance || subscribable == invalid-type
