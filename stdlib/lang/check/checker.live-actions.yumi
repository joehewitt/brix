. home = bindings.function-scope(bindings.slots[slot].scope)
. range = bindings.bindings[frame.binding].slots
for offset in 0 .. < range.count
    . row = bindings.slots[range.start + offset]
    if row.kind == .slot-subscribers && row.scope == home
