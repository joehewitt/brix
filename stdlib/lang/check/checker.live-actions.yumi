demand-live-runtime()
. live = instances.live
. wrapped = types.well-known-type-of("core/stream", "Subscription", item)
. subscribable = types.well-known-type-of("core/stream", "Subscribable", item)
if live.action == no-instance || live.previous == no-instance || missing-links
    decline(id)
    =
.. missing-links = live.next == no-instance || live.trackers == no-instance
if wrapped == invalid-type || subscribable == invalid-type
    decline(id)
    =
. kept = no-type
if is-owner()
    own-subscription(clause, stream, item, subscriber)
    . owned = facts.owned-subscription-of(instance, clause)
    if !owned
