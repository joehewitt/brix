                            - module
                            - loop
                            - name.name.text == "arrival"
    = subscribed-endpoint(id, loop, container, event, given)
if tree.arrival-clause(clause)
    do match? tree.nodes[clause]
        | .node-clause(row)
            if bindings.resolution-of(frame.binding, row.expr).kind == .resolve-unresolved
