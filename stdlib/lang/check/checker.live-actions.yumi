live.action = calls.demand-constructor(action, mark)
scratch.types.rewind(mark)
scratch.types.push(action)
. actions = types.class-named-with-args(module, types.list-atom!, mark)
scratch.types.rewind(mark)
live.actions = calls.demand-constructor(actions, mark)
scratch.types.push(action)
live.add-action = calls.demand-runtime-call(module, actions, program.store-atom("+="), mark)
scratch.types.rewind(mark)
. tracking = types.well-known-type("core/tracker", "Tracker")
if tracking != invalid-type
    scratch.types.push(tracking)
    live.add-tracker = calls.demand-runtime-call(module, trackers, program.store-atom("+="), mark)
    scratch.types.rewind(mark)
live.pop = calls.demand-method(actions, program.store-atom("pop"))
live.has-actions = calls.demand-method(actions, program.store-atom("!"))
live.close = calls.demand-method(action, program.store-atom("close"))
live.previous = module-getter(module, "active-previous-trackers")
live.next = module-getter(module, "active-next-trackers")
scratch.types.push(trackers)
scratch.types.push(trackers)
live.enter = calls.demand-runtime-call(module, no-type, program.store-atom("live-enter"), mark)
scratch.types.rewind(mark)
live.leave = calls.demand-runtime-call(module, no-type, program.store-atom("live-leave"), mark)
. tracker = types.well-known-type("core/tracker", "PropertyTracker")
if tracker == invalid-type
    instances.live = live
    =
types.complete(tracker)
. subscribers = tracker-field(tracker, "subscribers")
live.subscribers = calls.demand-constructor(subscribers, mark)
scratch.types.push(trackers)
scratch.types.push(trackers)
scratch.types.push(types.string-type)
scratch.types.push(tracker-field(tracker, "property-id"))
scratch.types.push(subscribers)
scratch.types.push(tracker-field(tracker, "owner"))
live.track = calls.demand-runtime-call
    - module
    - no-type
    - program.store-atom("track-property-dependency")
    - mark
scratch.types.rewind(mark)
scratch.types.push(subscribers)
scratch.types.push(types.string-type)
live.dispatch = calls.demand-runtime-call
    - module
    - no-type
    - program.store-atom("property-dispatch")
    - mark
scratch.types.rewind(mark)
. memo = types.well-known-type("core/tracker", "MemoAction")
if memo != invalid-type
    types.complete(memo)
    . owner = tracker-field(memo, "owner")
    . offset = tracker-field(memo, "flag-offset")
    scratch.types.push(trackers)
    scratch.types.push(callback)
    scratch.types.push(owner)
    scratch.types.push(offset)
    scratch.types.push(types.string-type)
    live.memo-action = calls.demand-constructor(memo, mark)
    scratch.types.rewind(mark)
    scratch.types.push(owner)
    scratch.types.push(offset)
    live.memo-settle = calls.demand-runtime-call
        - module
        - no-type
        - program.store-atom("memo-settle-at")
        - mark
    scratch.types.rewind(mark)
live.callback = callback
. carried = carried-result(types, callback)
if carried != no-type
    types.complete(carried)
    facts.note-carried(function-row(types, callback), carried)
live.callback-result = carried
instances.live = live

────────────────────
+ do tracker-field TypeId
    - tracker TypeId
    - name String

` The declared type of a property of the runtime's property tracker, which gives the types the
` runtime's tracking functions take.
. place = property-named(tracker, program.store-atom(name))
= if place then types.properties[place].type else invalid-type

────────────────────
_ do module-getter InstanceId
    - module ModuleId
    - name String

` A getter a module declares, typed for compiled code that reads it of its own accord.
. atom = program.store-atom(name)
. decls = program.modules[module].decls
for position in 0 .. < decls.length
    do match? decls[position]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .getter-decl && fn.name == atom
                . decl = position as DeclId
                . callee = instances.intern
                    - module
                    - decl
                    - no-type
                    - callee-effects(frame, module, decl)
                    - no-instance
                demand(callee)
                = callee
= no-instance

────────────────────
_ do is-lazy-value Bool

` Whether the instance types the value written for a lazy property of a class, worked out once
` when it is first read.
. unit = instances.rows[instance]
if unit.initializer == 0 || frame.self-type == no-type
    = false
do match? program.modules[unit.module].decls[unit.initializer]
    | .decl-property(row)
        = row.is-lazy
= false

────────────────────
+ do check-tracked-store
    - id SyntaxId
    - lhs SyntaxId

` A store to a local some read tracks, which runs the actions that read it where its bits
` change, as the reference's function scope does once it has made its list of subscribers;
` they may panic. A store from a function written in the one that declares the local runs
` them through the list that function keeps, which it captures. A store to the copy of the
` local a task's body holds, and one to a local that shares its name with one some read
` tracks, which the reference's list runs the actions of too, have no shape here yet. What the
` actions run leaves what is known of properties in doubt.
. resolution = bindings.resolution-of(frame.binding, lhs)
if resolution.kind != .resolve-slot || !bindings.is-trackable(resolution.slot)
    =
if (bindings.slots[resolution.slot].flags /and/ SlotFlag.slot-tracked) == 0
    if bindings.namesake(resolution.slot, true)
        decline(id)
    =
. subscribers = subscribers-slot(resolution.slot)
if subscribers == no-slot
    =
if frame.is-captured(resolution.slot) && (!frame.is-captured(subscribers) || copies(resolution.slot))
    decline(id)
    =
demand-live-runtime()
if instances.live.dispatch == no-instance
    decline(id)
    =
instances.mark-may-panic(instance)
frame.doubt-members()

────────────────────
_ do copies Bool
    - slot SlotId

` Whether the function, or one it is written in, out to the one that declares a local, holds a
` copy of the local, as a task's body does.
if !frame.is-captured(slot)
    = false
if frame.holds-copy(slot)
    = true
if !outer
    = false
= outer.copies(slot)
