./binding
/core/parsing
/lang/ast/ast
/lang/ast/ast-nodes
/lang/ast/ast-queries
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ slot-kind-text String
    - kind SlotKind

match kind
    |= .slot-argument
        "argument"
    |= .slot-local
        "local"
    |= .slot-lazy
        "lazy"
    |= .slot-pattern
        "pattern"
    |= .slot-loop-item
        "loop-item"
    |= .slot-this
        "this"
    |= .slot-it
        "it"
    |= .slot-each
        "each"
    |= .slot-super
        "super"
    |= .slot-held
        "held"
    |= .slot-loop-state
        "loop-state"
    |= .slot-location
        "location"
    ??
        "closure-env"

━━━━━━━━━━━━━━━━━━━━
+ resolution-kind-text String
    - kind ResolutionKind

match kind
    |= .resolve-slot
        "slot"
    |= .resolve-member
        "member"
    |= .resolve-global
        "global"
    |= .resolve-function
        "function"
    |= .resolve-type
        "type"
    |= .resolve-unresolved
        "unresolved"
    ??
        "none"

━━━━━━━━━━━━━━━━━━━━
+ diagnostic-kind-text String
    - kind DiagnosticKind

match kind
    |= .name-not-found
        "name-not-found"
    |= .already-defined
        "already-defined"
    |= .required-self
        "required-self"
    |= .variable-not-declared
        "variable-not-declared"
    |= .stream-not-found
        "stream-not-found"
    |= .lazy-defined
        "lazy-defined"
    |= .stated
        "stated"
    |= .redeclared
        "redeclared"
    ??
        "context-not-found"

━━━━━━━━━━━━━━━━━━━━
+ slot-oracle-text String
    - bindings Bindings
    - tree AST
    - slot SlotId

` Whether a local is a constant or a variable depends on which lowering the types select, for
` loop items in particular, so the oracle compares the declaring slot and only the lazy, this,
` and super storage classes.
"slot:$storage $position"

.. row = bindings.slots[slot]
.. storage = match row.kind
    |= .slot-this
        "this"
    |= .slot-super
        "super"
    |= .slot-lazy
        if row.property != 0 then "local" else "lazy"
    ??
        "local"
.. implicit = row.syntax == 0 || is-implicit-name(row.name)
.. grouped = row.kind == .slot-lazy && row.group != 0
.. declared = if grouped then group-pattern(tree, row.group) else row.syntax
.. declaring = if row.property != 0 then row.property else declared
.. position = if implicit then "-" else location-text(tree, declaring)

━━━━━━━━━━━━━━━━━━━━
+ group-pattern SyntaxId
    - tree AST
    - group SyntaxId

` The TypeScript compiler declares every name of a lazy group at the group pattern's position.
match tree.nodes[group]
    | .node-declare(row)
        row.left
    ??
        group

━━━━━━━━━━━━━━━━━━━━
+ is-implicit-name Bool
    - name Atom

` The TypeScript compiler prints no position for these names whether the source declares them
` or a construct binds them.
text == "this" || text == "super" || text == "it" || text == "each"

.. text = name.text

━━━━━━━━━━━━━━━━━━━━
+ location-text String
    - tree AST
    - id SyntaxId

"${loc.begin.line}:${loc.begin.column}"

.. loc = syntax-location(tree, id)

━━━━━━━━━━━━━━━━━━━━
+ syntax-location MatchLocation
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.loc
    | .node-ref-identifier(row)
        row.loc
    | .node-type-capture(row)
        row.loc
    | .node-loop-syntax(row)
        row.loc
    | .node-type-transform(row)
        row.loc
    | .node-declare(row)
        row.loc
    | .node-assign(row)
        row.loc
    | .node-type-tuple(row)
        row.loc
    | .node-function-syntax(row)
        row.loc
    | .node-getter-syntax(row)
        row.loc
    | .node-setter-syntax(row)
        row.loc
    | .node-converter-syntax(row)
        row.loc
    | .node-fromverter-syntax(row)
        row.loc
    | .node-do-task-block(row)
        row.loc
    | .node-property-syntax(row)
        row.loc
    ??
        MatchLocation()

━━━━━━━━━━━━━━━━━━━━
+ resolution-oracle-text String
    - bindings Bindings
    - tree AST
    - resolution Resolution

match resolution.kind
    |= .resolve-slot
        slot-oracle-text(bindings, tree, resolution.slot)
    ??
        resolution-kind-text(resolution.kind)

━━━━━━━━━━━━━━━━━━━━
+ do binding-use-lines
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId
    - label String
    - lines [String]

` One line per identifier use site in syntax order. Declaration sites are skipped because the
` TypeScript compiler never resolves them as reads.
. tree = program.modules[module].tree
. row = bindings.bindings[binding]
for offset in 0 .. < row.subtree.count
    . id = row.subtree.start + offset
    . resolution = bindings.resolutions[row.resolution-base + offset]
    if resolution.kind == .resolve-none
        continue
    if (resolution.flags /and/ (ResolutionFlag.resolution-declares)) != 0
        if !declares-lazy(bindings, resolution)
            continue
    . name = tree.identifier-name(id)
    if !name
        continue
    . shown = name
    . resolved = resolution-oracle-text(bindings, tree, resolution)
    lines += "id $label ${location-text(tree, id)} ${shown.text} $resolved"

━━━━━━━━━━━━━━━━━━━━
+ declares-lazy Bool
    - bindings Bindings
    - resolution Resolution

` The TypeScript compiler evaluates a lazy's declaring identifier when it plans the lazy, so
` the oracle lists lazy declaration sites as reads.
resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-lazy

━━━━━━━━━━━━━━━━━━━━
+ binding-use-summary String
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId

` The unit-test form: every use site as `name=kind` joined by spaces.

" ".join(use-site-text(bindings, tree, row, each) in 0 .. < row.subtree.count when is-use-site(bindings, tree, row, each))

.. tree = program.modules[module].tree
.. row = bindings.bindings[binding]

━━━━━━━━━━━━━━━━━━━━
+ is-use-site Bool
    - bindings Bindings
    - tree AST
    - row Binding
    - offset U32

resolution.kind != .resolve-none && !declares && !!tree.identifier-name(row.subtree.start + offset)

.. resolution = bindings.resolutions[row.resolution-base + offset]
.. declares = (resolution.flags /and/ (ResolutionFlag.resolution-declares)) != 0

━━━━━━━━━━━━━━━━━━━━
+ use-site-text String
    - bindings Bindings
    - tree AST
    - row Binding
    - offset U32

"${name.text}=${resolution-summary-text(bindings, tree, resolution)}"

.. name = tree.identifier-name(row.subtree.start + offset)!
.. resolution = bindings.resolutions[row.resolution-base + offset]

━━━━━━━━━━━━━━━━━━━━
+ resolution-summary-text String
    - bindings Bindings
    - tree AST
    - resolution Resolution

` Implicit loop names carry the line of the loop that bound them, so a test can say which loop
` an inner `it` reached.
match resolution.kind
    |= .resolve-slot
        |? slot.kind == .slot-it || slot.kind == .slot-each
            "${slot-kind-text(slot.kind)}@${syntax-location(tree, slot.syntax).begin.line}"
        ??
            slot-kind-text(slot.kind)
    ??
        resolution-kind-text(resolution.kind)

.. slot = bindings.slots[resolution.slot]

━━━━━━━━━━━━━━━━━━━━
+ binding-lazy-summary String
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId

` Every lazy slot of a binding as `name@group:reads/writes/refs/tracked:flags`, where the group
` is the line of the declaring statement and the flags are the context letters L for declared
` in a loop, l for read in a loop, n for nested, b for branch, s for subscription, m for state
` machine.

" ".join(lazy-slot-text(bindings, tree, each) in slots when each.kind == .slot-lazy)

.. tree = program.modules[module].tree
.. row = bindings.bindings[binding]
.. slots = bindings.slots[row.slots]

━━━━━━━━━━━━━━━━━━━━
+ lazy-slot-text String
    - bindings Bindings
    - tree AST
    - slot Slot

"${slot.name.text}@$group:$counts:${lazy-flag-text(use.flags)}"

.. group = syntax-location(tree, slot.group).begin.line
.. use = bindings.lazy-uses[slot.use]
.. counts = "${use.reads}/${use.writes}/${use.refs}/${use.tracked}"

━━━━━━━━━━━━━━━━━━━━
+ lazy-flag-text String
    - flags U32

"$declared$loop$nested$branch$subscription$machine"

.. declared = if (flags /and/ (LazyUseFlag.declared-in-loop)) != 0 then "L" else ""
.. loop = if (flags /and/ (LazyUseFlag.read-in-loop)) != 0 then "l" else ""
.. nested = if (flags /and/ (LazyUseFlag.read-in-nested)) != 0 then "n" else ""
.. branch = if (flags /and/ (LazyUseFlag.read-in-branch)) != 0 then "b" else ""
.. subscription = if (flags /and/ (LazyUseFlag.read-in-subscription)) != 0 then "s" else ""
.. machine = if (flags /and/ (LazyUseFlag.read-in-state-machine)) != 0 then "m" else ""

━━━━━━━━━━━━━━━━━━━━
+ binding-diagnostic-summary String
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId

` Every diagnostic a binding produced as `kind:name@line:column`, in order.

" ".join(binding-diagnostic-text(tree, each) in diagnostics)

.. tree = program.modules[module].tree
.. row = bindings.bindings[binding]
.. diagnostics = bindings.diagnostics[range.start .. < range.end]
.. range = row.diagnostics

━━━━━━━━━━━━━━━━━━━━
+ binding-diagnostic-text String
    - tree AST
    - diagnostic Diagnostic

"${diagnostic-kind-text(diagnostic.kind)}:$shown@${location-text(tree, diagnostic.syntax)}"

.. shown = if diagnostic.name then named.text else "-"
.. named = diagnostic.name

━━━━━━━━━━━━━━━━━━━━
+ do nested-kind-text String
    - program Program
    - module ModuleId
    - decl DeclId

do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.kind == .task-decl
            = "task"
        if fn.kind == .region-decl
            = "region"
        if fn.kind == .iterator-decl
            = "iterator"
        if fn.kind == .feed-decl
            = "feed"
        if fn.kind == .pipeline-decl
            = "pipeline"
= "closure"

━━━━━━━━━━━━━━━━━━━━
+ binding-capture-names [String]
    - bindings Bindings
    - nested U32
    - mark-by-value Bool

` The names a nested function captures, in first-reference walk order; a trailing `*` marks a
` capture by value when asked for.

capture-name(bindings, each, mark-by-value) in captures

.. row = bindings.nested[nested]
.. captures = bindings.captures[row.captures]

━━━━━━━━━━━━━━━━━━━━
+ capture-name String
    - bindings Bindings
    - capture Capture
    - mark-by-value Bool

"${bindings.slots[capture.slot].name.text}$suffix"

.. by-value = (capture.flags /and/ (CaptureFlag.capture-by-value)) != 0
.. suffix = if mark-by-value && by-value then "*" else ""

━━━━━━━━━━━━━━━━━━━━
+ binding-capture-summary String
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId

` Every nested function of a binding as `kind@line:captures`, innermost first, with `*` marking
` a capture by value.

" ".join(texts)

.. nested = row.nested
.. first = nested.start
.. texts = nested-capture-text(bindings, program, module, tree, first + each) in 0 .. < nested.count

.. tree = program.modules[module].tree
.. row = bindings.bindings[binding]

━━━━━━━━━━━━━━━━━━━━
+ nested-capture-text String
    - bindings Bindings
    - program Program
    - module ModuleId
    - tree AST
    - index U32

"$kind@$line:${",".join(names)}"

.. nested = bindings.nested[index]
.. kind = nested-kind-text(program, module, nested.decl)
.. line = syntax-location(tree, nested.syntax).begin.line
.. names = binding-capture-names(bindings, index, true)

━━━━━━━━━━━━━━━━━━━━
+ scan-summary-text String
    - bindings Bindings
    - scan U32

` One scan row as `y<yields> t<tracked> l<latest> u<use>/<use-block>/<finally>/<stack-local>
` n<nested> c<calls> p<assertions>/<forces>/<indexes>`.

"$head u$cleanup n${row.nested-functions} c${row.calls} p$panics"

.. row = bindings.scans[scan]
.. cleanup = "${row.use-expressions}/${row.use-blocks}/${row.do-finallys}/${row.stack-locals}"
.. panics = "${row.assertions}/${row.forces}/${row.indexes}"
.. head = "y${row.yields} t${row.tracked-reads} l${row.latests}"

━━━━━━━━━━━━━━━━━━━━
+ scan-sites-text String
    - bindings Bindings
    - tree AST
    - binding BindingId

` The scan sites of a binding in source order, each as `<letter><row>@<line>:<column>`: the
` kind's letter, the scan row among the binding's own (0 is the function itself), and where.
" ".join(scan-site-text(bindings, tree, row.sites.start + each, row.scans.start) in 0 .. < row.sites.count)

.. row = bindings.bindings[binding]

━━━━━━━━━━━━━━━━━━━━
_ scan-site-text String
    - bindings Bindings
    - tree AST
    - index U32
    - first U32

"${site-letter(site.kind)}${site.scan - first}@${loc.line}:${loc.column}"

.. site = bindings.scan-sites[index]
.. loc = tree.nodes.loc[site.syntax].begin

━━━━━━━━━━━━━━━━━━━━
_ site-letter String
    - kind ScanKind

match kind
    |= .scan-yield
        "y"
    |= .scan-tracked-read
        "t"
    |= .scan-latest
        "l"
    |= .scan-use-expression
        "u"
    |= .scan-use-block
        "b"
    |= .scan-do-finally
        "f"
    |= .scan-stack-local
        "s"
    |= .scan-nested-function
        "n"
    |= .scan-call
        "c"
    |= .scan-assertion
        "a"
    |= .scan-force
        "p"
    |= .scan-index
        "i"

━━━━━━━━━━━━━━━━━━━━
+ scan-oracle-text String
    - bindings Bindings
    - scan U32

` The flags the TypeScript compiler discovers while lowering, as the oracle compares them.

"$flags cleanup=${flag-text(cleanups)} nested=${row.nested-functions}"

.. row = bindings.scans[scan]
.. cleanups = row.use-expressions + row.use-blocks + row.do-finallys + row.stack-locals
.. tracked = flag-text(row.tracked-reads)
.. flags = "gen=${flag-text(row.yields)} tracked=$tracked latest=${flag-text(row.latests)}"

━━━━━━━━━━━━━━━━━━━━
+ flag-text String
    - count U32

if count != 0 then "1" else "0"

━━━━━━━━━━━━━━━━━━━━
+ binding-scan-summary String
    - bindings Bindings
    - program Program
    - module ModuleId
    - binding BindingId

` The function's scan row, then one `kind@line:row` per nested function, innermost first.

" ".join(scan-items(bindings, program, module, tree, row))

.. tree = program.modules[module].tree
.. row = bindings.bindings[binding]

━━━━━━━━━━━━━━━━━━━━
+ scan-items [String]
    - bindings Bindings
    - program Program
    - module ModuleId
    - tree AST
    - row Binding

* scan-summary-text(bindings, row.scans.start)
** nested-scan-text(bindings, program, module, tree, row, each) in 0 .. < row.nested.count

━━━━━━━━━━━━━━━━━━━━
+ nested-scan-text String
    - bindings Bindings
    - program Program
    - module ModuleId
    - tree AST
    - row Binding
    - offset U32

"$kind@$line:${scan-summary-text(bindings, row.scans.start + 1 + offset)}"

.. nested = bindings.nested[row.nested.start + offset]
.. kind = nested-kind-text(program, module, nested.decl)
.. line = syntax-location(tree, nested.syntax).begin.line
