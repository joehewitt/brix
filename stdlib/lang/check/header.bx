(import ./binding)
(import ./frame)
(import ./instances)
(import ./session)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(fn-do + settle-header Bool
  (param session Session)
  (param instance InstanceId)
  ; Reads from an instance's declaration what a call needs of it: the errors it states, and its
  ; return type where the declaration alone gives it. It says whether the return type is given,
  ; in which case the caller goes on and the body waits in the queue. A function that fills an object
  ; with its class's markup answers nothing and raises nothing (`check-filler`). The return type is
  ; not given, and the caller types the body first, when:
  ; - the return type is inferred from a value;
  ; - the stated type leaves a parameter or an alternative for the body to choose;
  ; - the stated type is a stream or an iterable, which a generator's body turns into the
  ;   generator or the iterable it returns;
  ; - the instance is a closure or takes one, since it reads the frame the closure is written in;
  ; - the declaration is a rule, whose function returns an optional of the type it states;
  ; - the declaration is a main, or its signature does not evaluate.
  (let instances (. session instances))
  (let known (. ([] (. instances signatures) instance) header))
  (if (!= known .header-unread)
    (return (== known .header-settled))
  )
  (= (. ([] (. instances signatures) instance) header) .header-open)
  (let row ([] (. instances rows) instance))
  (if (or (!= (. row enclosing) no-instance) (. row holds-closure))
    (return false)
  )
  (let described (call describe (. session program) (. row module) (. row decl)))
  (if (not described)
    (return false)
  )
  (let declaration described)
  (if (or (. declaration is-main) (!= (call rule-match (. session program) (. row module) (. row decl)) 0))
    (return false)
  )
  (if (or (call is-startup-kind (. declaration kind)) (call is-nested-kind (. declaration kind)))
    (return false)
  )
  (if (== (. declaration kind) .termination-panic-decl)
    (return false)
  )
  (let types (. session types))
  (let scratch (. session scratch))
  (let names-mark (. scratch names mark))
  (let items-mark (. scratch types mark))
  (let receiver (call logical-receiver session (. row module) (. row decl) (. row self-type)))
  (call (. types clear-fault))
  (let plain (call signature-into types (. row module) (. row decl) (call no-type-arguments types) receiver true))
  (let param-count (. ([] (. instances signatures) instance) param-count))
  (let given (call no-type-arguments types))
  (if (== param-count (. plain params length))
    (let bound-start (. scratch types mark))
    (for (in position (..< 0 param-count))
      (call (. scratch types push) (call (. instances param-type) instance position))
    )
    (= given (call TypeArguments (. plain params) (call (. scratch types since) bound-start)))
  )
  (let signature (call signature-into types (. row module) (. row decl) given receiver true))
  (let settled false)
  (if (. types fault)
    (call (. types clear-fault))
    (else
      (= settled (call read-header session instance declaration signature))
    )
  )
  (call (. scratch types rewind) items-mark)
  (call (. scratch names rewind) names-mark)
  (if settled
    (= (. ([] (. instances signatures) instance) header) .header-settled)
  )
  (return settled)
)

(fn-do _ read-header Bool
  (param session Session)
  (param instance InstanceId)
  (param declaration CheckedDecl)
  (param signature Signature)
  (let types (. session types))
  (let instances (. session instances))
  (let row ([] (. instances rows) instance))
  (if (. declaration is-content)
    (call (. instances state-errors) instance (. session scratch no-types))
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (return true)
  )
  (if (!= (. signature errors length) 0)
    (call (. instances state-errors) instance (. signature errors))
    (else
      (let owner (call interface-default-owner types (. session program) (. row module) (. row decl) (. row self-type)))
      (let self (if-expr (!= owner no-type) owner (. row self-type)))
      (call inherit-errors types instances instance self (. declaration kind))
    )
  )
  (let stated (call stated-return types (. row module) (. row decl) declaration (. row self-type) (. signature returns)))
  (if (!= stated no-type)
    (if (or (== stated invalid-type) (. ([] (. types completions) stated) has-variables))
      (return false)
    )
    (if (or (== (call (. types intrinsic-of) stated) .or) (call (. session relations holds-alternatives) stated))
      (return false)
    )
    (let ref (call class-ref types stated))
    (let stream (. types stream-decl))
    (let iterable (. types iterable-decl))
    (if (and (== (. ref module) (. stream module)) (== (. ref decl) (. stream decl)))
      (return false)
    )
    (if (and (== (. ref module) (. iterable module)) (== (. ref decl) (. iterable decl)))
      (return false)
    )
    (call (. instances set-returns) instance stated stated .return-declared)
    (return true)
  )
  (if (or (not (. declaration is-imperative)) (== (. declaration body) 0))
    (return false)
  )
  (if (call gives-or-yields (. ([] (. session program modules) (. row module)) tree) (. declaration subtree))
    (return false)
  )
  (call (. instances set-returns) instance (. types void-type) no-type .return-inferred)
  (return true)
)

(fn-do _ gives-or-yields Bool
  (param tree AST)
  (param subtree SyntaxRange)
  ; Whether any statement in a function's syntax returns a value or yields one. The statements
  ; of functions nested in it count too, so this can say yes of a function that gives nothing.
  (for (in offset (..< 0 (. subtree count)))
    (match? ([] (. tree nodes) (+ (. subtree start) offset))
      (case .node-yield
        (return true)
      )
      (case (call .node-return row)
        (if (!= (. row expr) 0)
          (return true)
        )
      )
      (case (call .node-return-if-true row)
        (if (!= (. row expr) 0)
          (return true)
        )
      )
    )
  )
  (return false)
)

(fn-do + stated-return TypeId
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param declaration CheckedDecl)
  (param self TypeId)
  (param returns TypeId)
  ; The return type a declaration states, given the one its signature evaluates to. A constructor
  ; that returns no value states its own class, but one that is a rule states nothing, and gives
  ; what its arms give; an operator that answers yes or no states Bool whether or not it says so.
  ; A function with statements that states a value or an error, as a parameter bound to what a
  ; function that raises answers, states the value: each return raises the error in its place.
  (let tree (. ([] (. types program modules) module) tree))
  (let constructs
    (scope (and plain-constructor (== (call rule-match (. types program) module decl) 0))
      (lazy plain-constructor (and (call is-constructor-kind (. declaration kind)) (== returns no-type)))
    )
  )
  (let stated returns)
  (if constructs
    (= stated (if-expr (call returns-own tree (. declaration body)) no-type self))
  )
  (if (and (== stated no-type) (call answers-bool (. types program) module decl))
    (= stated (. types bool-type))
  )
  (if (and (. declaration is-imperative) (!= stated no-type) (!= stated invalid-type))
    (match? ([] (. types rows) stated)
      (case (call .type-result held)
        (return (. held value))
      )
    )
  )
  (return stated)
)

(fn-do + answers-bool Bool
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  ; Whether a function overrides an operator that answers yes or no: a comparison, a containment
  ; test, or `!`. Such a function returns Bool whether or not it says so.
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (if (or (== (. fn owner) 0) (not (. fn name)) (!= (. fn kind) .function-decl))
        (return false)
      )
      (let token (. fn name text))
      (if (or (== token "==") (== token "!=") (== token "<") (== token ">"))
        (return true)
      )
      (if (or (== token "<=") (== token ">=") (== token "has") (== token "has not"))
        (return true)
      )
      (return (== token "!"))
    )
  )
  (return false)
)

(fn-do + logical-receiver TypeId
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (param self TypeId)
  ; An extension member of a union, or of a base its cases share, runs on a table row of that
  ; union with the row as its receiver, and binds its declarations against the type it extends.
  (let types (. session types))
  (let relations (. session relations))
  (let program (. session program))
  (let union (if-expr (and (!= self no-type) (!= self invalid-type)) (call row-union types self) no-type))
  (if (== union no-type)
    (return self)
  )
  (let owner 0u32)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (= owner (. fn owner))
    )
  )
  (match? ([] (. ([] (. program modules) module) decls) owner)
    (case .decl-extension
      (let shared (call (. types shared-case-base) union))
      (let matched (call (. relations match-extension) module owner union))
      (while (and (not matched) (!= shared no-type))
        (= matched (call (. relations match-extension) module owner shared))
        (= shared (call (. types shared-case-base) union shared))
      )
      (if matched
        (call (. types env-release) (. matched env))
        (return (. matched receiver))
      )
    )
  )
  (return self)
)

(fn-do + inherit-errors _
  (param types Types)
  (param instances Instances)
  (param instance InstanceId)
  (param self TypeId)
  (param kind DeclKind)
  ; A method that states no errors takes those stated by the method of a base class it has the
  ; same name and arguments as. One typed again for a class's table in the place of a base's
  ; method whose generator carries errors states those errors.
  (let inherited (. ([] (. instances rows) instance) inherits))
  (if (!= inherited no-instance)
    (let mark (. types scratch types mark))
    (for (in position (..< 0 (. ([] (. instances rows) inherited) step-errors count)))
      (call (. types scratch types push) (call (. instances step-error-type) inherited position))
    )
    (call (. instances state-errors) instance (call (. types scratch types since) mark))
    (call (. types scratch types rewind) mark)
    (return)
  )
  (if (or (== self no-type) (call is-constructor-kind kind))
    (return)
  )
  (let row ([] (. instances rows) instance))
  (let name (? Atom) null)
  (let is-static false)
  (match? ([] (. ([] (. types program modules) (. row module)) decls) (. row decl))
    (case (call .decl-function fn)
      (= name (. fn name))
      (= is-static (. fn is-static))
    )
  )
  (if (or (not name) is-static)
    (return)
  )
  (let own ([] (. instances signatures) instance))
  (if (!= (. own param-count) 0)
    (return)
  )
  (let base (call (. types base-of) self))
  (while base
    (if (call inherit-from-base types instances instance base name own)
      (return)
    )
    (= base (call (. types base-of) base))
  )
)

(fn-do _ inherit-from-base Bool
  (param types Types)
  (param instances Instances)
  (param instance InstanceId)
  (param base TypeId)
  (param name Atom)
  (param own InstanceSignature)
  (let ref (call class-ref types base))
  (if (and (== (. ref module) 0) (== (. ref decl) 0))
    (return false)
  )
  (let base-module ([] (. types program modules) (. ref module)))
  (let members (call (of RowRange DeclId)))
  (match? ([] (. base-module decls) (. ref decl))
    (case (call .decl-class row)
      (= members (. row members))
    )
  )
  (for (in member (call (. base-module members-named) members name))
    (match? ([] (. base-module decls) member)
      (case (call .decl-function fn)
        (let plain (and (not (. fn is-generated)) (not (. fn is-static)) (not (call is-constructor-kind (. fn kind)))))
        (if (and plain (== (. fn type-args count) 0) (. fn name) (== (. fn name) name))
          (if (call inherit-from-method types instances instance (. ref module) member base own)
            (return true)
          )
        )
      )
    )
  )
  (return false)
)

(fn-do _ inherit-from-method Bool
  (param types Types)
  (param instances Instances)
  (param instance InstanceId)
  (param base-module Index)
  (param member DeclId)
  (param base TypeId)
  (param own InstanceSignature)
  (let names-mark (. types scratch names mark))
  (let items-mark (. types scratch types mark))
  (let given (call no-type-arguments types))
  (let signature (call signature-into types (as base-module ModuleId) member given base true))
  (let matches (and (== (. signature params length) 0) (== (. signature args length) (. own args count))))
  (if matches
    (for (in offset (..< 0 (. signature args length)))
      (let position Size (. own args start))
      (if (!= ([] (. signature args) offset) ([] (. instances signature-types) (+ position offset)))
        (= matches false)
      )
    )
  )
  (if (and matches (!= (. signature errors length) 0))
    (call (. instances state-errors) instance (. signature errors))
    (else
      (= matches false)
    )
  )
  (call (. types scratch types rewind) items-mark)
  (call (. types scratch names rewind) names-mark)
  (return matches)
)
