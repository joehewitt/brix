        "CFunctionType"
    |= .tuple
        "TupleType"
    |= .union
        "UnionType"
    |= .atom
        "AtomType"
    |= .interface
        "InterfaceType"
    |= .or
        "OrType"
    |= .struct
        "StructType"
    |= .optional
        "OptionalType"
    |= .gc-type-map
        "GCTypeMapType"
    |= .number
        "NumberType"
    |= .int1
        "Int1Type"
    |= .int8
        "Int8Type"
    |= .uint8
        "UInt8Type"
    |= .int16
        "Int16Type"
    |= .uint16
        "UInt16Type"
    |= .int32
        "Int32Type"
    |= .uint32
        "UInt32Type"
    |= .int64
        "Int64Type"
    |= .uint64
        "UInt64Type"
    |= .float32
        "Float32Type"
    |= .float64
        "Float64Type"
    |= .bool
        "BoolType"
    |= .char
        "CharType"
    |= .string
        "StringType"
    |= .type-info
        "TypeInfoType"
    |= .type-relation
        "TypeRelationType"
    |= .table
        "TableType"
    |= .table-row
        "TableRowType"
    |= .table-span
        "TableSpanType"
    |= .table-selection
        "TableSelectionType"
    |= .table-column
        "TableColumnType"
    |= .immutable-table
        "ImmutableTableType"
    |= .immutable-table-row
        "ImmutableTableRowType"
    |= .immutable-table-span
        "ImmutableTableSpanType"
