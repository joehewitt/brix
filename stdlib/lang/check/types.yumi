━━━━━━━━━━━━━━━━━━━━
+ RelationRank is I32

━━━━━━━━━━━━━━━━━━━━
+ RelationKind is U32

| relation-illegal = 0
| relation-same = 1
| relation-equal = 2
| relation-side-cast = 3
| relation-unwrap-cast = 4
| relation-up-cast = 5
| relation-down-cast = 6
| relation-interface-cast = 7
| relation-or-cast = 8
| relation-wrap-cast = 9
| relation-fromverter = 10
| relation-converter = 11
| relation-common-equality = 12
| relation-common-converter = 13
| relation-common-up-cast = 14
| relation-common-interface = 15
| relation-final-cast = 16
| relation-string-cast = 17
| relation-interface-down-cast = 18

━━━━━━━━━━━━━━━━━━━━
+ RelationReason is U32

| reason-none = 0
| reason-illegal-cast = 1
| reason-unresolved = 2
| reason-conflict = 3
| reason-ambiguous = 4

━━━━━━━━━━━━━━━━━━━━
+ Relation is Struct

+ kind RelationKind
+ rank RelationRank
+ match Specificity
+ from TypeId = no-type
+ to TypeId = no-type
+ unified TypeId = no-type
+ case-index U32 = U32.max
+ via TypeId = no-type
+ ratio UnitRatio
+ reason RelationReason
+ converter-module ModuleId = U32.max
+ converter-decl DeclId = 0
+ explicit Bool

━━━━━━━━━━━━━━━━━━━━
+ relation-rank RelationRank
    - kind RelationKind

match kind
    |= .relation-same
        0i32
    |= .relation-equal
        10i32
    |= .relation-side-cast
        20i32
    |= .relation-unwrap-cast
        30i32
    |= .relation-up-cast
        30i32
    |= .relation-down-cast
        40i32
    |= .relation-interface-cast
        50i32
    |= .relation-interface-down-cast
        55i32
    |= .relation-or-cast
        60i32
    |= .relation-wrap-cast
        70i32
    |= .relation-fromverter
        80i32
    |= .relation-converter
        90i32
    |= .relation-common-equality
        100i32
    |= .relation-common-converter
        110i32
    |= .relation-common-up-cast
        120i32
    |= .relation-common-interface
        130i32
    |= .relation-final-cast
        140i32
    |= .relation-string-cast
        150i32
    ??
        -1i32

━━━━━━━━━━━━━━━━━━━━
+ same-relation Relation
    - type TypeId

Relation(.relation-same, 0i32, .exact, type, type, type, U32.max, no-type, ratio, none, U32.max, 0)

.. none = RelationReason.reason-none
.. ratio = no-ratio()

━━━━━━━━━━━━━━━━━━━━
+ side-cast-relation Relation
    - source TypeId
    - target TypeId

Relation
    - kind
    - relation-rank(kind)
    - match
    - source
    - target
    - target
    - U32.max
    - no-type
    - no-ratio()
    - none
    - U32.max
    - 0

.. none = RelationReason.reason-none

.. kind = RelationKind.relation-side-cast
.. match = relation-match(kind)

━━━━━━━━━━━━━━━━━━━━
+ relation-name String
    - kind RelationKind

match kind
    |= .relation-same
        "Same"
    |= .relation-equal
        "Equal"
    |= .relation-side-cast
        "SideCast"
    |= .relation-unwrap-cast
        "Unwrap"
    |= .relation-up-cast
        "UpCast"
    |= .relation-down-cast
        "DownCast"
    |= .relation-interface-down-cast
        "InterfaceDownCast"
    |= .relation-interface-cast
        "InterfaceCast"
    |= .relation-or-cast
        "Or"
    |= .relation-wrap-cast
        "Wrap"
    |= .relation-fromverter
        "Fromverter"
    |= .relation-converter
        "Converter"
    |= .relation-common-equality
        "CommonEquality"
    |= .relation-common-converter
        "CommonConverter"
    |= .relation-common-up-cast
        "CommonUpCast"
    |= .relation-common-interface
        "CommonInterface"
    |= .relation-final-cast
        "FinalCast"
    |= .relation-string-cast
        "StringCast"
    ??
        "Illegal"

━━━━━━━━━━━━━━━━━━━━
+ relation-match Specificity
    - kind RelationKind

match kind
    |= .relation-same
        .exact
    |= .relation-equal
        .exact
    |= .relation-or-cast
        .exact
    |= .relation-common-equality
        .exact
    |= .relation-fromverter
        .convertible
    |= .relation-converter
        .convertible
    |= .relation-common-converter
        .convertible
    |= .relation-string-cast
        .convertible
    |= .relation-illegal
        .convertible
    ??
        .similar

