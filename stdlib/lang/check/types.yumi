━━━━━━━━━━━━━━━━━━━━
+ IntrinsicKind is U32

| none = 0
| class = 1
| void = 2
| cpointer = 3
| cfunction = 4
| tuple = 5
| union = 6
| atom = 7
| interface = 8
| or = 9
| struct = 10
| optional = 11
| gc-type-map = 12
| number = 13
| int1 = 14
| int8 = 15
| uint8 = 16
| int16 = 17
| uint16 = 18
| int32 = 19
| uint32 = 20
| int64 = 21
| uint64 = 22
| float32 = 23
| float64 = 24
| bool = 25
| char = 26
| string = 27
| type-info = 28
| type-relation = 29
| table = 30
| table-row = 31
| table-span = 32
| table-selection = 33
| table-column = 34
| immutable-table = 35
| immutable-table-row = 36
| immutable-table-span = 37
| immutable-table-selection = 38
| immutable-table-column = 39
| index-span = 40
| table-mark = 41
| function = 46
| closure = 47
| capture = 48
| binding = 49
| array-builder = 50
| style = 51
| style-sheet = 52

━━━━━━━━━━━━━━━━━━━━
