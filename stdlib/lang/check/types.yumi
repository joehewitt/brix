+ is-signed Bool
+ is-pointer Bool
+ is-struct Bool
+ interfaces RowRange'TypeId
+ properties RowRange'TypeProperty
+ cases RowRange'TypeCase
+ converters RowRange'TypeId
+ fromverters RowRange'TypeId
