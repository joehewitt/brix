━━━━━━━━━━━━━━━━━━━━
+ is-illegal-base Bool
    - kind IntrinsicKind

match kind
    |= .bool
        true
    |= .optional
        true
    |= .void
        true
    |= .closure
        true
    |= .capture
        true
    |= .binding
        true
    |= .type-info
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ is-index-reader Bool
    - kind IntrinsicKind

` Whether a value reads indices: an index span, or a selection of a table's rows by one.
kind == .index-span || kind == .table-selection || kind == .immutable-table-selection

━━━━━━━━━━━━━━━━━━━━
+ is-table-container Bool
    - kind IntrinsicKind

table || spans || .immutable-table-selection == kind || .index-span == kind

.. table = kind == .table || kind == .immutable-table
.. spans = kind == .table-span || kind == .immutable-table-span

━━━━━━━━━━━━━━━━━━━━
+ known-type Bool
    - type TypeId

type != no-type && type != invalid-type

━━━━━━━━━━━━━━━━━━━━
+ down-cast-rank RelationRank

relation-rank(.relation-down-cast)

━━━━━━━━━━━━━━━━━━━━
+ boxed-style Bool
    - kind IntrinsicKind

` Whether a style value of a kind is kept in a box the runtime holds a handle to, as the
` reference's `styleValueClass` says of a value that is no number, object or union: a tuple, a
` struct or a string.
kind == .tuple || kind == .struct || kind == .string

━━━━━━━━━━━━━━━━━━━━
+ is-column-receiver Bool
    - kind IntrinsicKind

|? kind == .table || kind == .immutable-table
    true
??
    kind == .table-span || kind == .immutable-table-span

━━━━━━━━━━━━━━━━━━━━
+ is-field-view Bool
    - kind IntrinsicKind

` Whether a value is a view of a field's column.
kind == .table-column || kind == .immutable-table-column

━━━━━━━━━━━━━━━━━━━━
+ is-immutable-view Bool
    - kind IntrinsicKind

` Whether a value is a table that was finished, or a view of one, which holds no metadata.
table-or-span || kind == .immutable-table-row || kind == .immutable-table-column
.. table-or-span = kind == .immutable-table || kind == .immutable-table-span

━━━━━━━━━━━━━━━━━━━━
+ is-row-source Bool
    - kind IntrinsicKind

` Whether a value is a table or a span of one, whose rows can be read.
kind == .table || kind == .table-span || kind == .immutable-table || kind == .immutable-table-span

━━━━━━━━━━━━━━━━━━━━
+ source-name String
    - kind IntrinsicKind

` The name of a table, or of a span of one, its panics give.
|? kind == .table
    "Table"
|? kind == .table-span
    "TableSpan"
|? kind == .immutable-table
    "ImmutableTable"
??
    "ImmutableTableSpan"
