+ do record-pair
    - instance InstanceId
    - from TypeId
    - to TypeId
    - relation Relation

. fact = PairFact
    - instance
    - from
    - to
    - relation.kind
    - relation.rank
    - relation.match
    - relation.unified
    - relation.ratio
pairs.append(fact)

