        style-authors[position].instance = dead
for position in 0 .. < style-writes.length
    if held-by(retired, style-writes[position].instance)
        style-writes[position].instance = dead
. kept-values Size = 0
for position in 0 .. < style-static-values.length
    . row = style-static-values[position]
    if !held-by(retired, row.instance)
        style-static-values[kept-values] = row
        kept-values += 1
while style-static-values.length > kept-values
    style-static-values.pop()
. kept-codings Size = 0
for position in 0 .. < coding-users.length
    . row = coding-users[position]
    if !held-by(retired, row.instance)
        coding-users[kept-codings] = row
        kept-codings += 1
while coding-users.length > kept-codings
    coding-users.pop()
. kept-gates Size = 0
for position in 0 .. < gate-users.length
    . row = gate-users[position]
    if !held-by(retired, row.instance)
        gate-users[kept-gates] = row
        kept-gates += 1
while gate-users.length > kept-gates
    gate-users.pop()
. kept-domains Size = 0
for position in 0 .. < domain-users.length
    . row = domain-users[position]
    if !held-by(retired, row.instance)
        domain-users[kept-domains] = row
        kept-domains += 1
while domain-users.length > kept-domains
    domain-users.pop()
for position in 0 .. < style-applications.length
    if held-by(retired, style-applications[position].instance)
        style-applications[position].instance = dead
for position in 0 .. < scope-cells.length
    if held-by(retired, scope-cells[position].instance)
        scope-cells[position].instance = dead
for position in 0 .. < scope-values.length
    if held-by(retired, scope-values[position].instance)
        scope-values[position].instance = dead
for position in 0 .. < carried-values.length
    if held-by(retired, carried-values[position].instance)
        carried-values[position].instance = dead
for position in 0 .. < carried-cells.length
    if held-by(retired, carried-cells[position].instance)
        carried-cells[position].instance = dead
for position in 0 .. < outlet-cells.length
    if held-by(retired, outlet-cells[position].instance)
        outlet-cells[position].instance = dead
for position in 0 .. < slot-forwards.length
    if held-by(retired, slot-forwards[position].instance)
        slot-forwards[position].instance = dead
for position in 0 .. < style-contents.length
    if held-by(retired, style-contents[position].instance)
        style-contents[position].instance = dead
for position in 0 .. < rule-updates.length
    if held-by(retired, rule-updates[position].instance)
        rule-updates[position].instance = dead
for position in 0 .. < style-reads.length
    if held-by(retired, style-reads[position].instance)
        style-reads[position].instance = dead
for position in 0 .. < style-flags.length
    if held-by(retired, style-flags[position].instance)
        style-flags[position].instance = dead
for position in 0 .. < element-stores.length
    if held-by(retired, element-stores[position].instance)
        element-stores[position].instance = dead
for position in 0 .. < raised-elements.length
    if held-by(retired, raised-elements[position].instance)
        raised-elements[position].instance = dead
for position in 0 .. < materials.length
    if held-by(retired, materials[position].instance)
        materials[position].instance = dead
for position in 0 .. < rollback-bodies.length
    if held-by(retired, rollback-bodies[position].instance)
        rollback-bodies[position].instance = dead
for position in 0 .. < storage-bodies.length
    if held-by(retired, storage-bodies[position].instance)
        storage-bodies[position].instance = dead
for position in 0 .. < observer-bodies.length
    if held-by(retired, observer-bodies[position].instance)
        observer-bodies[position].instance = dead
for position in 0 .. < wavering.length
    if held-by(retired, wavering[position].instance)
        wavering[position].instance = dead
for position in 0 .. < unheld-lazies.length
    if held-by(retired, unheld-lazies[position].instance)
        unheld-lazies[position].instance = dead
purge-placed(local-rule-rows, retired, 32)
purge-placed(content-link-rows, retired, 32)
purge-placed(named-store-rows, retired, 32)
purge-placed(raised-rows, retired, 32)
purge-placed(raised-tails, retired, 32)
purge-placed(raised-blocks, retired, 32)
purge-placed(raised-sites, retired, 32)
purge-placed(element-store-rows, retired, 32)
purge-placed(element-store-tails, retired, 32)
purge-placed(material-rows, retired, 32)
purge-placed(material-tails, retired, 32)
purge-placed(rollback-body-rows, retired, 32)
purge-placed(storage-body-rows, retired, 32)
purge-placed(observer-body-rows, retired, 32)
purge-placed(marking-arms, retired, 32)
purge-placed(inside-reads, retired, 32)
purge-placed(dominated-reads, retired, 32)
purge-placed(spanning-arms, retired, 32)
purge-placed(spanning-its, retired, 32)
purge-placed(leave-heads, retired, 32)
purge-placed(filler-rows, retired, 0)
purge-placed(deferred-rows, retired, 0)
purge-placed(style-declaration-heads, retired, 0)
purge-placed(style-declaration-tails, retired, 0)
. bodies [InstanceId]
for body in task-bodies
    if !held-by(retired, body)
        bodies += body
task-bodies = bodies
. regions [InstanceId]
for body in region-bodies
    if !held-by(retired, body)
        regions += body
region-bodies = regions
. closers [InstanceId]
for closer in event-closers
    if !held-by(retired, closer)
        closers += closer
event-closers.clear()
for closer in closers
    event-closers += closer
. kept-reads Size = 0
for position in 0 .. < theme-reads.length
    . row = theme-reads[position]
    if !held-by(retired, row.instance)
        theme-reads[kept-reads] = row
        kept-reads += 1
while theme-reads.length > kept-reads
    theme-reads.pop()
. kept-slots Size = 0
for position in 0 .. < rule-slots.length
    . row = rule-slots[position]
    if applies-live(retired, dead, row.application)
        rule-slots[kept-slots] = row
        kept-slots += 1
while rule-slots.length > kept-slots
    rule-slots.pop()
. kept-themes Size = 0
for position in 0 .. < rule-themes.length
    . row = rule-themes[position]
    if applies-live(retired, dead, row.application)
        rule-themes[kept-themes] = row
        kept-themes += 1
while rule-themes.length > kept-themes
    rule-themes.pop()
retire-projections(retired, dead)
place-theme-reads()
place-rule-rows()

────────────────────
_ do retire-projections
    - retired [Bool]
    - dead InstanceId

` Removes the projections of slots of style sheets that only the declarations and rule lines of
` instances an edit retires take, and numbers those that stand anew where the declarations and
` rule lines that take them name them. Each is made for the one declaration or rule line it is
` first made for, as the runtime registers a projection's table for each markup site.
. taken [Bool]
for _ in 0 .. < style-projections.length
    taken += false
for row in style-declarations
    if row.projection < U32.max - 1 && live(retired, dead, row.instance)
        taken[row.projection] = true
for row in rule-slots
    if row.projection < U32.max - 1
        taken[row.projection] = true
. places [U32]
. tags [U32]
. kept U32
for position in 0 .. < style-projections.length
    if !taken[position]
        places += U32.max
        continue
    . row = style-projections[position] as StyleProjection
    if row.kind == 2
        . first = tags.length as U32
        for offset in row.first .. < row.first + row.count
            tags += projection-tags[offset]
        row.first = first
    style-projections[kept] = row
    places += kept
    kept += 1
while style-projections.length > (kept as Size)
    style-projections.pop()
projection-tags.clear()
for tag in tags
    projection-tags += tag
for position in 0 .. < style-declarations.length
    . projection = style-declarations[position].projection
    if projection < U32.max - 1
        style-declarations[position].projection = places[projection]
for position in 0 .. < rule-slots.length
    . projection = rule-slots[position].projection
    if projection < U32.max - 1
        rule-slots[position].projection = places[projection]

────────────────────
_ applies-live Bool
    - retired [Bool]
    - dead InstanceId
    - application U32

` Whether an application of a style rule is made by an instance an edit neither retires nor has
` retired before, so the slots and values its lines take stand.
(application as Size) >= style-applications.length || applier-live

.. applier-live = live(retired, dead, style-applications[application].instance)

────────────────────
_ do place-theme-reads

theme-read-places.clear()
for position in 0 .. < theme-reads.length
    . row = theme-reads[position]
    theme-read-places[((row.instance as Size) /lshift/ 32) /or/ read-site] = position as U32
    .. read-site = row.site as Size

────────────────────
_ do place-rule-rows

rule-slot-places.clear()
for position in 0 .. < rule-slots.length
    . row = rule-slots[position]
    rule-slot-places[((row.application as Size) /lshift/ 32) /or/ slot-site] = position as U32
    .. slot-site = row.site as Size
rule-theme-places.clear()
for position in 0 .. < rule-themes.length
    . row = rule-themes[position]
    rule-theme-places[((row.application as Size) /lshift/ 32) /or/ theme-site] = position as U32
    .. theme-site = row.site as Size

────────────────────
_ do purge-placed'Value
    - map Map'Size'Value'ArenaBacking
    - retired [Bool]
    - shift Size

. gone [Size]
for (key, _) in map
    if held-by(retired, (key /rshift/ shift) as InstanceId)
        gone += key
for key in gone
    -= map[key]

────────────────────
+ do move-syntax String?
    - module ModuleId
    - moved [SyntaxId]
    - instances Instances
    - retired [Bool]
    - dead InstanceId

` Moves the nodes of an edited module that facts name to where the edit puts them, as `moved`
` maps them. An edit typed in place leaves the nodes outside the bodies it changes as they were,
` but numbers them anew where it adds or removes nodes before them, and instances of other modules
` it does not retire name them: the rules and `when`s of styles they apply, the markup and
` sections of classes they make, and where they enter a zone. So do the state machines of
` instances it retires, which stand for them until they are typed again (`replace-machines`), as
` refinements typed again find them. Gives why an edit cannot be typed in place where an instance
` it does not retire names a node of a body it changes, or nothing.
=? "moved cells" if moves-cells(module, moved, instances, retired, dead)
=? "moved applications" if moves-applications(module, moved, instances, retired, dead)
for position in 0 .. < style-users.length
    if style-users[position].module == module
        =? "moved users" if user-live && unmoved(moved, style-users[position].site)
        .. user-live = live(retired, dead, style-users[position].instance)
        style-users[position].site = moved-node(moved, style-users[position].site)
for position in 0 .. < style-static-values.length
    if style-static-values[position].module == module
        =? "moved values" if value-live && unmoved(moved, style-static-values[position].site)
        .. value-live = live(retired, dead, style-static-values[position].instance)
        style-static-values[position].site = moved-node(moved, style-static-values[position].site)
=? move-domain-users(domain-users, module, moved, retired, dead)
=? move-domain-users(domain-places, module, moved, retired, dead)
for position in 0 .. < style-sites.length
    if style-sites[position].module == module
        =? "moved sites" if site-live && unmoved(moved, style-sites[position].site)
        .. site-live = live(retired, dead, style-sites[position].instance)
        style-sites[position].site = moved-node(moved, style-sites[position].site)
for position in 0 .. < style-applications.length
    . row = style-applications[position] as StyleApplication
    if row.module == module
        style-applications[position].site = moved-node(moved, row.site)
        style-applications[position].written = moved-node(moved, row.written)
    if row.outer != U32.max && instances.rows[style-applications[row.outer].unit].module == module
        style-applications[position].within = moved-node(moved, row.within)
for position in 0 .. < style-gate-whens.length
    if style-gate-whens[position].module == module
        style-gate-whens[position].syntax = moved-node(moved, style-gate-whens[position].syntax)
for position in 0 .. < scope-cells.length
    . row = scope-cells[position] as ScopeCell
    if row.module == module
        scope-cells[position].when = moved-node(moved, row.when)
    if row.instance != no-instance && instances.rows[row.instance].module == module
        scope-cells[position].site = moved-node(moved, row.site)
for position in 0 .. < scope-values.length
    if scope-values[position].module == module
        =? "moved scope values" if scope-live && unmoved(moved, scope-values[position].site)
        .. scope-live = live(retired, dead, scope-values[position].instance)
        scope-values[position].site = moved-node(moved, scope-values[position].site)
for position in 0 .. < typed-sections.length
    if typed-sections[position].module == module
        =? "moved sections" if section-live && unmoved(moved, typed-sections[position].syntax)
        .. section-live = live(retired, dead, typed-sections[position].instance)
        typed-sections[position].syntax = moved-node(moved, typed-sections[position].syntax)
for position in 0 .. < markup-queries.length
    if markup-queries[position].module == module
        markup-queries[position].site = moved-node(moved, markup-queries[position].site)
for position in 0 .. < event-clauses.length
    if event-clauses[position].module == module
        event-clauses[position].loop = moved-node(moved, event-clauses[position].loop)
for position in 0 .. < lowered-handlers.length
    if lowered-handlers[position].module == module
        lowered-handlers[position].syntax = moved-node(moved, lowered-handlers[position].syntax)
move-sections(subscribed-sections, module, moved)
move-sections(lowered-sections, module, moved)
move-sections(rebinding-sections, module, moved)
for position in 0 .. < machines.length
    . row = machines[position] as MachineFact
    if row.module == module
        row.syntax = moved-node(moved, row.syntax)
        row.outer = moved-node(moved, row.outer)
        row.parent = moved-node(moved, row.parent)
        machines[position] = row
        for group in row.groups.start .. < row.groups.start + row.groups.count
            . held = machine-groups[group] as MachineGroup
            held.head = moved-node(moved, held.head)
            held.owner = moved-node(moved, held.owner)
            machine-groups[group] = held
for position in 0 .. < early-unions.length
    if early-unions[position].module == module
        early-unions[position].syntax = moved-node(moved, early-unions[position].syntax)
for position in 0 .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if row.module == module
        diagnostics[position].syntax = moved-node(moved, row.syntax)
    if row.related-module == module
        =? "moved diagnostics" if diagnostic-live && unmoved(moved, row.related-syntax)
        .. diagnostic-live = live(retired, dead, row.instance)
        diagnostics[position].related-syntax = moved-node(moved, row.related-syntax)
=? move-themes(module, moved, instances, retired, dead)
= null

────────────────────
_ do move-themes String?
    - module ModuleId
    - moved [SyntaxId]
    - instances Instances
    - retired [Bool]
    - dead InstanceId

` Moves the nodes of an edited module that the slots of style sheets read there, the lines of
` style rules applied with slots and the values evaluated from slots name. The reads and rule
` lines of the instances an edit retires are gone (`retire`). A value whose line the edit changes
` is left to the dead instance, unless an instance the edit does not retire evaluates it. Gives why
` an edit cannot be typed in place, or nothing.
for position in 0 .. < theme-reads.length
    . row = theme-reads[position]
    if row.module == module
        =? "moved theme reads" if unmoved(moved, row.site)
        theme-reads[position].site = moved-node(moved, row.site)
for position in 0 .. < rule-slots.length
    . row = rule-slots[position]
    if rule-module(row.application, instances) == module
        =? "moved rule slots" if unmoved(moved, row.site)
        rule-slots[position].site = moved-node(moved, row.site)
for position in 0 .. < rule-themes.length
    . row = rule-themes[position]
    if rule-module(row.application, instances) == module
        =? "moved rule themes" if unmoved(moved, row.site)
        rule-themes[position].site = moved-node(moved, row.site)
place-theme-reads()
place-rule-rows()
. referenced [Bool]? = null
for position in 0 .. < style-themed-values.length
    . row = style-themed-values[position]
    if row.module != module || row.instance == dead
        continue
    if !unmoved(moved, row.site)
        style-themed-values[position].site = moved-node(moved, row.site)
        continue
    =? "moved themed values" if live(retired, dead, row.instance)
    if !referenced
        referenced = themed-references(retired, dead)
    =? "moved themed values" if referenced[position]
    style-themed-values[position].instance = dead
    style-themed-values[position].site = 0
= null

────────────────────
_ rule-module ModuleId
    - application U32
    - instances Instances

` The module that writes the lines of the rule an application of a style rule applies.
if (application as Size) >= style-applications.length then U32.max as ModuleId else unit-module

.. unit-module = instances.rows[style-applications[application].unit].module

────────────────────
_ do themed-references [Bool]
    - retired [Bool]
    - dead InstanceId

` Which values evaluated from slots of style sheets a declaration or an applied rule line of an
` instance an edit does not retire evaluates.
. referenced [Bool]
for _ in 0 .. < style-themed-values.length
    referenced += false
for row in style-declarations
    if row.themed != U32.max && live(retired, dead, row.instance)
        referenced[row.themed] = true
for row in rule-themes
    if row.themed != U32.max && applies-live(retired, dead, row.application)
        referenced[row.themed] = true
= referenced

────────────────────
+ do unmoved-namers [InstanceId]
    - module ModuleId
    - moved [SyntaxId]
    - instances Instances

` The instances whose facts name a node of a body an edit to a module changes, as `moved` maps
` them: those of other modules typed in a context the module's markup gives, such as the
` constructor of a class an element makes, whose state cells are made at the element. Retired
` with the module's own, they are typed again in the edited one.
. found [InstanceId]
for row in scope-cells
    if (row.module == module && unmoved(moved, row.when)) || (known-key && unmoved-key)
        found += row.instance
    .. known-key = (row.key as Size) < instances.state-keys.length
    .. unmoved-key = key-unmoved(instances.state-keys[row.key], module, moved)
for row in style-applications
    if row.module == module && (unmoved(moved, row.site) || unmoved(moved, row.written))
        found += row.instance
    else if row.outer != U32.max && outer-in-module && unmoved(moved, row.within)
        found += row.instance
    .. outer-in-module = instances.rows[style-applications[row.outer].unit].module == module
for row in style-users
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in style-static-values
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in style-sites
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in scope-values
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in typed-sections
    if row.module == module && unmoved(moved, row.syntax)
        found += row.instance
for row in domain-users
    if (row.module == module && unmoved(moved, row.site)) || line-unmoved
        found += row.instance
    .. line-unmoved = row.line-module == module && unmoved(moved, row.line)
for row in diagnostics
    if row.related-module == module && unmoved(moved, row.related-syntax)
        found += row.instance
for row in theme-reads
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in rule-slots
    if rule-module(row.application, instances) == module && unmoved(moved, row.site)
        found += style-applications[row.application].instance
for row in rule-themes
    if rule-module(row.application, instances) == module && unmoved(moved, row.site)
        found += style-applications[row.application].instance
for row in style-themed-values
    if row.module == module && unmoved(moved, row.site)
        found += row.instance
for row in style-declarations
    if row.themed != U32.max && (row.themed as Size) < style-themed-values.length
        . value = style-themed-values[row.themed]
        if value.module == module && unmoved(moved, value.site)
            found += row.instance
= found

────────────────────
_ do moves-cells Bool
    - module ModuleId
    - moved [SyntaxId]
    - instances Instances
    - retired [Bool]
    - dead InstanceId

` Whether a state cell an edit does not retire names a node of a body the edit changes: its
` `when`, its site, or where it is made.
for row in scope-cells
    if live(retired, dead, row.instance)
        =? true if row.module == module && unmoved(moved, row.when)
        =? true if row.instance != no-instance && in-module && unmoved(moved, row.site)
        .. in-module = instances.rows[row.instance].module == module
        =? true if (row.key as Size) < instances.state-keys.length && unmoved-key
        .. unmoved-key = key-unmoved(instances.state-keys[row.key], module, moved)
= false

────────────────────
_ key-unmoved Bool
    - key StateKey
    - module ModuleId
    - moved [SyntaxId]

site-unmoved || (key.when-module == module && unmoved(moved, key.when))

.. site-unmoved = key.module == module && unmoved(moved, key.site)

────────────────────
_ do moves-applications Bool
    - module ModuleId
    - moved [SyntaxId]
    - instances Instances
    - retired [Bool]
    - dead InstanceId

` Whether a style rule applied by an instance an edit does not retire names a node of a body the
` edit changes: its site, the values written for it, or the `when` of the rule around it.
for row in style-applications
    if live(retired, dead, row.instance)
        =? true if row.module == module && (unmoved(moved, row.site) || unmoved(moved, row.written))
        =? true if row.outer != U32.max && outer-in-module && unmoved(moved, row.within)
        .. outer-in-module = instances.rows[style-applications[row.outer].unit].module == module
= false

────────────────────
_ live Bool
    - retired [Bool]
    - dead InstanceId
    - instance InstanceId

instance != dead && !held-by(retired, instance)

────────────────────
_ do move-domain-users String?
    - users List'DomainUser'ArenaBacking
    - module ModuleId
    - moved [SyntaxId]
    - retired [Bool]
    - dead InstanceId

for position in 0 .. < users.length
    . row = users[position] as DomainUser
    if row.module == module
        =? "moved domains" if site-kept && unmoved(moved, row.site)
        .. site-kept = live(retired, dead, row.instance) && row.instance != no-instance
        users[position].site = moved-node(moved, row.site)
    if row.line-module == module
        =? "moved domains" if line-kept && unmoved(moved, row.line)
        .. line-kept = live(retired, dead, row.instance) && row.instance != no-instance
        users[position].line = moved-node(moved, row.line)
= null

────────────────────
_ do move-sections
    - refs List'SectionRef'ArenaBacking
    - module ModuleId
    - moved [SyntaxId]

for position in 0 .. < refs.length
    if refs[position].module == module
        refs[position].syntax = moved-node(moved, refs[position].syntax)

────────────────────
_ held-by Bool
    - retired [Bool]
    - instance InstanceId

(instance as Size) < retired.length && retired[instance]

────────────────────
+ do replace-machines String?
    - retired [Bool]
    - machine-count Size
    - union-count Size

` Removes the state machines that instances an edit retired had typed, from the first
` `machine-count`, with their groups of event transitions, and the unions they made early, from
` the first `union-count`, once typing those instances again has made them anew. Until then they
` stand for them, as typing found them before the edit. Gives why the edit cannot be kept where
` an instance makes other machines or another union for one.
for position in 0 .. < machine-count
    . old = machines[position] as MachineFact
    if held-by(retired, old.instance)
        . rank = machines-of(old.instance, 0, position)
        . made = machine-place(old.instance, machine-count, rank)
        =? "machine ${old.instance}" if made == U32.max || machines[made].union != old.union
        if rank == 0
            . typed = machines-of(old.instance, 0, machine-count)
            =? "machines ${old.instance}" if retyped != typed
            .. retyped = machines-of(old.instance, machine-count, machines.length)
. kept Size = 0
. grouped Size = 0
for position in 0 .. < machines.length
    . row = machines[position] as MachineFact
    if position < machine-count && held-by(retired, row.instance)
        continue
    . start = grouped
    for group in row.groups.start .. < row.groups.start + row.groups.count
        machine-groups[grouped] = machine-groups[group] as MachineGroup
        grouped += 1
    row.groups = RowRange'MachineGroup(start as U32, row.groups.count)
    machines[kept] = row
    kept += 1
machines.truncate(kept)
machine-groups.truncate(grouped)
. unions Size = 0
for position in 0 .. < early-unions.length
    if position >= union-count || !held-by(retired, early-unions[position].instance)
        early-unions[unions] = early-unions[position]
        unions += 1
early-unions.remove(unions, early-unions.length - unions)
= null

────────────────────
_ do machines-of Size
    - instance InstanceId
    - from Size
    - to Size

` How many of the machines from one place to another an instance typed.
. count Size = 0
for position in from .. < to
    if machines[position].instance == instance
        count += 1
= count

────────────────────
_ do machine-place U32
    - instance InstanceId
    - from Size
    - rank Size

` The place, from one on, of the machine an instance typed after `rank` others there, or none.
. seen Size = 0
for position in from .. < machines.length
    if machines[position].instance == instance
        =? position as U32 if seen == rank
        seen += 1
= U32.max

────────────────────
+ unshared-weight I64

` How much these facts hold that another type pass cannot take in: the rows retiring an instance
` removes (`retirable-weight`), what an edit retyped in place keeps (`kept-weight`) and the rest
` (`unretirable-weight`), but for what the merge takes in (`absorbed-weight`). A type pass takes in
` the properties reads track from each pass (`absorb-shared`), the instances that use styles and the
` sites and applications of style rules with their instances (`absorb-owned`, `absorb-applications`),
` and lists the style rules and extensions of style sheets before typing
` (`Checker.list-declarations`), so none of those counts. A type pass that types on many workers
` types again each instance whose typing changed it (`merge-sessions`).
retirable-weight() + kept-weight() + unretirable-weight() - absorbed-weight()

────────────────────
+ do absorbed-weight I64

` What of those weights the merge takes in from the pass that typed an instance: what each
` instance records of markup, of the queries it registers, of tracked values and of the events it
` uses (`absorb-markup`), and of the styles it declares, reads and writes, the values evaluated
` once for every making it types, the codings, gates and domains it uses and the arguments of
` markup elements it stores (`absorb-styles`), the slots of style sheets it reads and those the
` lines of rules it applies take or compute with, with the projections and the values evaluated
` from slots they name (`absorb-themes`), the state cells of `when`s and the values of rules it
` makes, keeps and carries, with the content style rules generate (`absorb-scopes`,
` `absorb-contents`), and the sections it types (`absorb-plans`); and what it takes in from every
` pass: the targets of descendant queries, the markup queries, the rules that run once markup has,
` the event runtime's functions that close an object's events and register a lowered section, the
` styles with their properties, the style sheets with their slots and the members of their
` families (`absorb-sheets`), the codings, the gates and the domains, the links between state
` cells, and the plans of the event handlers of the classes made, each by its key; and the state
` machines each instance types, with the unions they make early (`absorb-machines`).
. markup = change-test-count + markup-reads.length + row-item-reads.length + collection-reads.length
    .. change-test-count = change-tests.length
markup += element-roots.length + named-stores.length + slot-outlets.length + raised-elements.length
markup += slot-choices.length
markup += loop-regions.length + branch-regions.length + trigger-count + deferred-values.length
    .. trigger-count = markup-triggers.length
markup += region-roots.length + whenever-calls.length + query-targets.length
markup += markup-queries.length + query-registrations.length + markup-rules.length
. tracked = live-statements.length + subscriptions + tracked-locals.length + latest-reads.length
    .. subscriptions = owned-subscriptions.length
tracked += pulled-sites.length
. events = event-uses.length + event-closers.length
events += (if event-close != no-instance then 1u32 else 0u32) + (if event-register != no-instance then 1u32 else 0u32)
events += if event-register-arrival != no-instance then 1u32 else 0u32
. styles = declaration-count + style-authors.length + style-writes.length + style-reads.length
    .. declaration-count = style-declarations.length
styles += style-flags.length + element-stores.length + rule-updates.length + static-value-count
    .. static-value-count = style-static-values.length
styles += coding-users.length + gate-users.length + domain-users.length
. registries = style-codings.length + style-gates.length + style-uses.length + property-count
    .. property-count = style-properties.length
registries += style-domains.length + property-domains.length
registries += style-sheet-uses.length + sheet-slots.length + sheet-members.length + member-slots
    .. member-slots = sheet-member-slots.length
. sheets = style-projections.length + rule-slots.length + rule-themes.length + themed-value-count
    .. themed-value-count = style-themed-values.length
sheets += themed-givens.length + theme-reads.length + (family-gates + sheet-reads + lookups) as Size
. plans = lowered-handlers.length + lowered-types.length + subscribed-sections.length
plans += lowered-sections.length + rebinding-sections.length
. scopes = scope-cells.length + scope-links.length + scope-values.length + carried-values.length
scopes += carried-cells.length + outlet-cells.length + slot-forwards.length + style-contents.length
. machined = machines.length + early-unions.length
= markup + tracked + events + styles + registries + sheets + plans + scopes + machined

────────────────────
+ do kept-weight I64

` What an edit retyped in place keeps and finds again as it types the edited module: each lookup
` that finds by its key a style sheet another instance may have made, which a type pass cannot
` take in (`lookups`), the plans of the event handlers of the classes made
` (`Checker.plan-event-handlers`), which `retype-edit` refuses an edit that would change, the
` codings of style values and the gates of style declarations, which program tables emit only
` while some instance uses them (`coding-users`, `gate-users`), the styles and style sheets,
` with their properties and slots, which program tables place and register only where a function
` they reach uses them (`style-users`), with the domains changes to properties raise
` (`property-domains`), the domains of invalidation, placed, numbered and registered only while
` some instance names them (`domain-users`), and what markup and events keep once for the
` program: the markup queries, found by their class and property and emitted only for a
` registration reached, the rules that run once markup has, a function of the rule alone, and the
` event runtime's functions that close an object's events and register a lowered section, reached
` only from a closer or a section reached; and the values evaluated from slots of style sheets,
` found by their lines, whose sites an edit moves (`move-themes`).
. plans = lowered-handlers.length + lowered-types.length + subscribed-sections.length
plans += lowered-sections.length + rebinding-sections.length
. styles = style-codings.length + style-gates.length + style-uses.length + style-sheet-uses.length
styles += property-count + sheet-slots.length + style-domains.length + property-domains.length
    .. property-count = style-properties.length
styles += sheet-members.length + sheet-member-slots.length
styles += style-themed-values.length + themed-givens.length
. markup = markup-queries.length + markup-rules.length
. events = (if event-close != no-instance then 1u32 else 0u32) + (if event-register != no-instance then 1u32 else 0u32)
events += if event-register-arrival != no-instance then 1u32 else 0u32
= ((plans + styles + markup + events) as I64) + (lookups as I64)

────────────────────
+ do retirable-weight I64

. markup = collection-reads.length + event-uses.length + markup-reads.length + element-roots.length
markup += slot-outlets.length + branch-regions.length + loop-regions.length + row-item-reads.length
markup += slot-choices.length
markup += region-roots.length + query-registrations.length + markup-triggers.length
markup += whenever-call-count + raised-elements.length + named-stores.length + event-closers.length
    .. whenever-call-count = whenever-calls.length
markup += deferred-values.length
. tracked = change-tests.length + owned-subscriptions.length + latest-reads.length
tracked += live-statements.length + tracked-locals.length + pulled-sites.length
. styles = style-declarations.length + style-authors.length + style-writes.length
styles += style-static-values.length + scope-cells.length + scope-values.length
styles += carried-values.length + carried-cells.length + outlet-cells.length + slot-forwards.length
styles += style-contents.length + rule-updates.length + style-reads.length + style-flags.length
styles += element-stores.length + coding-users.length + gate-users.length + domain-users.length
styles += theme-reads.length + rule-slots.length + rule-themes.length + style-projections.length
. settled = machined + raising-rules.length + stack-needs.length + stack-holds.length
    .. machined = machines.length + early-unions.length
= markup + tracked + styles + settled

────────────────────
+ unretirable-weight I64

held + (revised as I64) * 65536

.. markup = query-targets.length + event-clauses.length
.. styles = scope-links.length
.. settled = overrides.length + witness-slots.length
.. held = (markup + styles + settled + family-gates + sheet-reads) as I64

────────────────────
_ do keyed-conversions [Bool]

` Which conversions are kept by what they convert rather than where they are written: those of
` what a function is passed, and those of a function made for two function types.
. keyed [Bool]
for _ in 0 .. < conversions.length
    keyed += false
for head in passed-heads.values
    . fact = head
    while fact != no-fact
        keyed[fact] = true
        fact = conversions[fact].next
for head in cast-heads.values
    . fact = head
    while fact != no-fact
        keyed[fact] = true
        fact = conversions[fact].next
= keyed

────────────────────
_ do moved FactId
    - taken [FactId]
    - id FactId

` The number here of a fact the peer numbered `id`, which is one taken in.
if id == no-fact
    = no-fact
?! Panic("A fact of another type pass that this pass leaves is named by one it takes in")
    if taken[id] == no-fact
= taken[id]

────────────────────
_ do absorb-machines
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]
    - events Size

` Takes in the state machines the peer's instances that this pass takes from it typed, each with
` its groups of event transitions after the groups here, and the unions they made early, with
` their types, instances and facts as they are here. A group's event use is among those
` `absorb-markup` took in from `events` on, in the peer's order.
. event-ids [U32]
. next-event = events as U32
for row in peer.event-uses
    event-ids += if ids.owns(row.instance) then next-event else U32.max
    next-event += (if ids.owns(row.instance) then 1 else 0) as U32
for row in peer.machines
    if ids.owns(row.instance)
        . start = machine-groups.length
        for group in row.groups.start .. < row.groups.start + row.groups.count
            . taken = peer.machine-groups[group] as MachineGroup
            taken.stream = ids.type(taken.stream)
            taken.item = ids.type(taken.item)
            taken.subscriber = ids.type(taken.subscriber)
            taken.subscribe = moved(call-ids, taken.subscribe)
            taken.unsubscribe = moved(call-ids, taken.unsubscribe)
            taken.event = if taken.event != U32.max then event-ids[taken.event] else U32.max
            taken.enqueue = ids.instance(taken.enqueue)
            taken.port = ids.instance(taken.port)
            taken.post = ids.instance(taken.post)
            taken.attach = ids.instance(taken.attach)
            taken.detach = ids.instance(taken.detach)
            machine-groups.append(taken)
        . fact = row as MachineFact
        fact.instance = ids.instance(row.instance)
        fact.union = ids.type(row.union)
        fact.groups = RowRange'MachineGroup(start as U32, row.groups.count)
        fact.refined = ids.instance(row.refined)
        machines.append(fact)
for row in peer.early-unions
    if ids.owns(row.instance)
        early-unions += EarlyUnion
            - ids.instance(row.instance)
            - row.module
            - row.syntax
            - ids.type(row.union)

────────────────────
_ do absorb-steps RowRange'U32
    - peer Facts
    - ids PeerIds
    - range RowRange'U32

if range.count == 0
    = RowRange'U32()
. start U32 = steps.length as U32
for offset in 0 .. < range.count
    . place = ids.property(peer.steps[range.start + offset])
    . getter = ids.instance(peer.step-callees[range.start + offset])
    steps += place
    step-callees += getter
= RowRange'U32(start, range.count)

────────────────────
_ do absorb-actions RowRange'U32
    - peer Facts
    - ids PeerIds
    - range RowRange'U32

if range.count == 0
    = RowRange'U32(action-slots.length as U32, 0)
. start U32 = action-slots.length as U32
for offset in 0 .. < range.count
    . slot = ids.slot(peer.action-slots[range.start + offset])
    . type = ids.type(peer.action-types[range.start + offset])
    action-slots.append(slot)
    action-types.append(type)
= RowRange'U32(start, range.count)

────────────────────
_ do absorb-calls
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]

for position in 0 .. < peer.calls.length
    if call-ids[position] == no-fact
        continue
    . fact = peer.calls[position] as CallFact
    . instance = ids.instance(fact.instance)
    . callee = ids.instance(fact.callee)
    . walked = absorb-steps(peer, ids, fact.through)
    . start U32 = call-fills.length as U32
    for offset in 0 .. < fact.fills.count
        call-fills += peer.call-fills[fact.fills.start + offset]
    fact.instance = instance
    fact.callee = callee
    fact.fills = RowRange'ArgumentFill(start, fact.fills.count)
    fact.through = walked
    fact.next = moved(call-ids, fact.next)
    . id FactId = calls.length as FactId
    ?! Panic("The calls taken in from another type pass are numbered out of order")
        if id != call-ids[position]
    calls.append(fact)
    chain-fact(call-lasts, call-priors, instance, id)

────────────────────
_ do absorb-conversion ConversionFact
    - peer Facts
    - ids PeerIds
    - fact ConversionFact

` A conversion of the peer's with its types and instances as they are here and its parts taken
` in, but for the conversion it leads to.
. moved = fact
moved.instance = ids.instance(fact.instance)
moved.from = ids.type(fact.from)
moved.to = ids.type(fact.to)
moved.callee = ids.instance(fact.callee)
moved.runs = ids.instance(fact.runs)
moved.asked = ids.type(fact.asked)
moved.parts = absorb-parts(peer, ids, fact.parts)
= moved

────────────────────
_ do absorb-parts FactId
    - peer Facts
    - ids PeerIds
    - first FactId

` Takes in a chain of the parts of a conversion, each with parts of its own, and gives the first.
. head = no-fact
. last = no-fact
. cursor = first
while cursor != no-fact
    . part = absorb-conversion(peer, ids, peer.conversion-parts[cursor])
    part.next = no-fact
    . id FactId = conversion-parts.length as FactId
    conversion-parts.append(part)
    if last == no-fact
        head = id
    else
        conversion-parts[last].next = id
    last = id
    cursor = peer.conversion-parts[cursor].next
= head

────────────────────
_ do absorb-conversions
    - peer Facts
    - ids PeerIds
    - keyed [Bool]
    - conversion-ids [FactId]

for position in 0 .. < peer.conversions.length
    if conversion-ids[position] == no-fact
        continue
    . fact = absorb-conversion(peer, ids, peer.conversions[position])
    fact.next = moved(conversion-ids, fact.next)
    . id FactId = conversions.length as FactId
    ?! Panic("The conversions taken in from another type pass are numbered out of order")
        if id != conversion-ids[position]
    conversions.append(fact)
    chain-fact(conversion-lasts, conversion-priors, fact.instance, id)

────────────────────
_ do absorb-keyed-conversions
    - peer Facts
    - ids PeerIds
    - keyed [Bool]

` Takes in each conversion the peer keeps by what it converts that this pass lacks, in the order
` the peer recorded them.
for (callee, head) in peer.passed-heads
    . runs = ids.instance(callee as InstanceId)
    for fact in peer.chain-order(head)
        . row = peer.conversions[fact] as ConversionFact
        if passed-conversion(runs, row.reason, ids.type(row.from), ids.type(row.to)) != no-fact
            continue
        . moved = absorb-conversion(peer, ids, row)
        moved.next = first-passed(runs)
        . id FactId = conversions.length as FactId
        conversions.append(moved)
        chain-fact(conversion-lasts, conversion-priors, moved.instance, id)
        passed-heads[runs] = id
for (key, head) in peer.cast-heads
    . source = ids.type((key /rshift/ 32) as TypeId)
    . target = ids.type((key /and/ (U32.max as Size)) as TypeId)
    for fact in peer.chain-order(head)
        . row = peer.conversions[fact] as ConversionFact
        if cast-conversion(source, target, row.reason, ids.type(row.from), ids.type(row.to)) != no-fact
            continue
        . moved = absorb-conversion(peer, ids, row)
        moved.next = first-cast(source, target)
        . id FactId = conversions.length as FactId
        conversions.append(moved)
        chain-fact(conversion-lasts, conversion-priors, moved.instance, id)
        cast-heads[cast-key(source, target)] = id

────────────────────
_ do chain-order [FactId]
    - head FactId

` The conversions of a chain kept by what they convert, first recorded first.
. order [FactId]
. fact = head
while fact != no-fact
    order += fact
    fact = conversions[fact].next
. reversed [FactId]
. position = order.length
while position != 0
    position -= 1
    reversed += order[position]
= reversed

────────────────────
_ do absorb-forces
    - peer Facts
    - ids PeerIds
    - force-ids [FactId]

for position in 0 .. < peer.forces.length
    if force-ids[position] == no-fact
        continue
    . fact = peer.forces[position] as ForceFact
    fact.instance = ids.instance(fact.instance)
    fact.operand = ids.type(fact.operand)
    fact.result = ids.type(fact.result)
    fact.next = moved(force-ids, fact.next)
    forces.append(fact)

────────────────────
_ do absorb-transforms
    - peer Facts
    - ids PeerIds
    - transform-ids [U32]

for position in 0 .. < peer.transforms.length
    if transform-ids[position] == U32.max
        continue
    . fact = peer.transforms[position] as TransformFact
    . start U32 = transform-chains.length as U32
    for offset in 0 .. < fact.chain.count
        . link = ids.type(peer.transform-chains[fact.chain.start + offset])
        transform-chains += link
    fact.chain = RowRange'TypeId(start, fact.chain.count)
    fact.instance = ids.instance(fact.instance)
    fact.source = ids.type(fact.source)
    fact.raised = ids.type(fact.raised)
    transforms.append(fact)

────────────────────
_ do absorb-nodes
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]
    - conversion-ids [FactId]
    - force-ids [FactId]

` Gives each instance taken from the peer nodes of its own, filled as the peer filled them, and
` keeps the types its locals hold.
. queue = node-copies
?! Panic("Facts takes in the nodes of another type pass only while copying them")
    if !queue
. first U32 = node-types.length as U32
. ranges [RowRange'U32]
. peer-rows = peer.instances.rows
for id in 0 .. < peer-rows.length
    if !ids.owns(id as InstanceId)
        continue
    . row = peer-rows[id] as Instance
    . instance = ids.instance(id as InstanceId)
    if row.slot-start != U32.max
        instances.rows[instance].slot-start = slot-types.length as U32
        instances.rows[instance].slot-count = row.slot-count
        instances.rows[instance].slot-base = row.slot-base
        for offset in 0 .. < row.slot-count
            . held = ids.type(peer.slot-types[row.slot-start + offset])
            slot-types += held
    if row.node-start == U32.max
        continue
    ?! Panic("An instance taken from another type pass has nodes here already")
        if instances.rows[instance].node-start != U32.max
    instances.rows[instance].binding = ids.binding(row.binding)
    instances.rows[instance].node-start = node-types.length as U32
    instances.rows[instance].subtree = row.subtree
    ranges += RowRange'U32(row.node-start, row.subtree.count)
    for source in row.node-start .. < row.node-start + row.subtree.count
        node-types += ids.type(peer.node-types[source])
        . constant = peer.node-constants[source]
        if constant == no-fact
            node-constants += no-fact
        else
            node-constants += constants.length as FactId
            constants.append
                - absorb-constant(peer, ids, peer.constants[constant], peer.node-plans[source])
queue <- NodeCopy(peer, first, ranges, call-ids, conversion-ids, force-ids)

────────────────────
+ do start-copying-nodes
    - pool Worker
    - count Size

?! Panic("Facts copies the nodes of other type passes already")
    if node-copies
. room = node-types.length + count
node-types.reserve(room)
node-calls.reserve(room)
node-conversions.reserve(room)
node-conversion-tails.reserve(room)
node-forces.reserve(room)
node-plans.reserve(room)
node-chains.reserve(room)
node-constants.reserve(room)
. queue SyncBufferedChannel'NodeCopy
. group = TaskGroup()
node-copies = queue
node-copying = group
. task = do (pool) new
    for copy in queue
        copy-nodes(copy)
catch failed
    group.keep(failed)
group.add(task)

────────────────────
+ do end-copying-nodes

. queue = node-copies
. group = node-copying
if queue
    queue.close()
if group
    group.settle()
node-copies = null
node-copying = null
if group
    group.wait()

────────────────────
_ do copy-nodes
    - copy NodeCopy

?! Panic("The nodes taken in from other type passes are copied out of order")
    if node-calls.length != copy.first as Size
. peer = copy.peer
for range in copy.ranges
    for source in range.start .. < range.end
        node-calls += moved(copy.call-ids, peer.node-calls[source])
        node-conversions += moved(copy.conversion-ids, peer.node-conversions[source])
        node-conversion-tails += moved(copy.conversion-ids, peer.node-conversion-tails[source])
        node-forces += moved(copy.force-ids, peer.node-forces[source])
        node-plans += peer.node-plans[source]
        node-chains += peer.node-chains[source]

────────────────────
_ do absorb-constant ConstantFact
    - peer Facts
    - ids PeerIds
    - constant ConstantFact
    - plan U8

` A node's constant as it is here: the type a C call that allocates is described by, the class
` an `is` tests for, and the steps a read through a delegated property takes, are numbered here.
. moved = constant
. kind = (plan /and/ plan-bits) as OperatorPlan
if kind == .plan-described || kind == .plan-class-test
    moved.bits = ids.type(constant.bits as TypeId) as U64
else if kind == .plan-through
    . range = RowRange'U32((constant.bits % 4294967296) as U32, (constant.bits / 4294967296) as U32)
    . kept = absorb-steps(peer, ids, range)
    moved.bits = (kept.start as U64) + (kept.count as U64) * 4294967296
= moved

────────────────────
_ do absorb-owned
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]
    - conversion-ids [FactId]
    - force-ids [FactId]

` Takes in the facts of the peer's instances that this pass takes from it, which no other fact
` names by its place.
for row in peer.pairs
    if ids.owns(row.instance)
        . fact = row as PairFact
        fact.instance = ids.instance(row.instance)
        fact.from = ids.type(row.from)
        fact.to = ids.type(row.to)
        fact.unified = ids.type(row.unified)
        pairs.append(fact)
for row in peer.relations
    if ids.owns(row.instance)
        . fact = row as RelationFact
        fact.instance = ids.instance(row.instance)
        fact.from = ids.type(row.from)
        fact.to = ids.type(row.to)
        relations.append(fact)
for row in peer.unwrapped
    if ids.owns(row.instance)
        . fact = row as UnwrappedFact
        fact.instance = ids.instance(row.instance)
        fact.type = ids.type(row.type)
        unwrapped.append(fact)
for row in peer.chains
    if ids.owns(row.instance)
        . fact = row as ChainFact
        fact.instance = ids.instance(row.instance)
        chains.append(fact)
for row in peer.declared-values
    if ids.owns(row.instance)
        . fact = row as DeclaredValueFact
        fact.instance = ids.instance(row.instance)
        fact.declared = ids.type(row.declared)
        fact.found = ids.type(row.found)
        declared-values.append(fact)
for row in peer.context-casts
    if ids.owns(row.instance)
        . fact = row as ContextCastFact
        fact.instance = ids.instance(row.instance)
        fact.target = ids.type(row.target)
        context-casts.append(fact)
for row in peer.payload-effects
    if ids.owns(row.instance)
        . fact = row as PayloadEffectFact
        fact.instance = ids.instance(row.instance)
        payload-effects.append(fact)
for row in peer.case-owners
    if ids.owns(row.instance)
        . fact = row as CaseOwnerFact
        fact.instance = ids.instance(row.instance)
        fact.owner = ids.type(row.owner)
        case-owners.append(fact)
for row in peer.fills
    if ids.owns(row.instance)
        . fact = row as FillFact
        fact.instance = ids.instance(row.instance)
        fact.slot = ids.slot(row.slot)
        record-fill(fact)
for row in peer.stack-reads
    if ids.owns(row.instance)
        stack-reads.append(StackRead(ids.instance(row.instance), row.syntax, row.module, row.decl))
for row in peer.local-global-uses
    if ids.owns(row.instance)
        local-global-uses.append
            - LocalGlobalUse(ids.instance(row.instance), row.syntax, row.module, row.decl)
for row in peer.stack-scopes
    if ids.owns(row.instance)
        stack-scopes.append
            - StackScope
                - ids.instance(row.instance)
                - row.first
                - row.last
                - row.module
                - row.decl
                - ids.swap-entry(row.entry)
for row in peer.swap-forwards
    if ids.owns(row.instance)
        . fact = row as SwapForward
        fact.instance = ids.instance(row.instance)
        fact.callee = ids.instance(row.callee)
        swap-forwards.append(fact)
for row in peer.global-uses
    if ids.owns(row.instance)
        global-uses.append(GlobalUse(ids.instance(row.instance), row.syntax, row.module, row.decl))
for row in peer.value-reads
    if ids.owns(row.instance)
        value-reads.append(ValueRead(ids.instance(row.instance), row.name, row.syntax, row.surely))
for row in peer.diagnostics
    if ids.owns(row.instance)
        absorb-diagnostic(peer, ids, row)
for row in peer.loose-calls
    if ids.owns(row.instance)
        add-loose-call(LooseFact(ids.instance(row.instance), moved(call-ids, row.fact), row.apart))
for row in peer.loose-conversions
    if ids.owns(row.instance)
        loose-conversions.append
            - LooseFact(ids.instance(row.instance), moved(conversion-ids, row.fact), row.apart)
for row in peer.loose-forces
    if ids.owns(row.instance)
        loose-forces.append
            - LooseFact(ids.instance(row.instance), moved(force-ids, row.fact), row.apart)
for row in peer.loose-types
    if ids.owns(row.instance)
        loose-types.append(LooseType(ids.instance(row.instance), row.syntax, ids.type(row.type)))
for row in peer.answer-types
    if ids.owns(row.instance)
        answer-types.append(LooseType(ids.instance(row.instance), row.syntax, ids.type(row.type)))
for row in peer.forwards
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        key-scratch[0] = instance
        key-scratch[1] = row.syntax
        forward-keys.store(key-scratch.data, 2)
        forwards.append
            - ForwardFact
                - instance
                - row.syntax
                - ids.type(row.value)
                - ids.type(row.result)
                - row.given
for row in peer.const-arrays
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        key-scratch[0] = instance
        key-scratch[1] = row.syntax
        const-array-keys.store(key-scratch.data, 2)
        . first U32 = const-items.length as U32
        for offset in 0 .. < row.count
            const-items.append(peer.const-items[row.first + offset])
        const-arrays.append
            - ConstArrayFact(instance, row.syntax, ids.type(row.type), first, row.count)
for row in peer.leaves
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        . start U32 = leave-tried.length as U32
        for offset in 0 .. < row.tried.count
            . transform = ids.transforms[peer.leave-tried[row.tried.start + offset]]
            ?! Panic("A leave taken in from another type pass names a transform it leaves")
                if transform == U32.max
            leave-tried += transform
        . key = leave-key(instance, row.syntax)
        . id FactId = leaves.length as FactId
        leaves.append
            - LeaveFact
                - instance
                - row.syntax
                - ids.type(row.error)
                - RowRange'U32(start, row.tried.count)
                - leave-heads[key] ?? no-fact
        leave-heads[key] = id
for row in peer.outlined
    if ids.owns(row.instance)
        . fact = row as OutlinedAction
        fact.instance = ids.instance(row.instance)
        fact.params = absorb-actions(peer, ids, row.params)
        fact.result = ids.type(row.result)
        outlined.append(fact)
for row in peer.pattern-arguments
    if ids.owns(row.instance)
        . fact = row as PatternArgument
        fact.instance = ids.instance(row.instance)
        fact.result = ids.type(row.result)
        fact.answer = ids.type(row.answer)
        fact.stream = ids.type(row.stream)
        fact.buffer = ids.type(row.buffer)
        fact.rule = ids.instance(row.rule)
        fact.helper = ids.type(row.helper)
        fact.params = absorb-actions(peer, ids, row.params)
        fact.raised = ids.type(row.raised)
        pattern-arguments.append(fact)
for row in peer.self-actions
    if ids.owns(row.instance)
        self-actions += SelfAction
            - ids.instance(row.instance)
            - row.site
            - ids.instance(row.maker)
            - row.rooted
for row in peer.address-claims
    if ids.owns(row.instance)
        address-claims += AddressClaim
            - ids.instance(row.instance)
            - row.site
            - ids.instance(row.closer)
for row in peer.wavering
    if ids.owns(row.instance)
        wavering.append(WaveringLazy(ids.instance(row.instance), ids.slot(row.slot)))
for row in peer.unheld-lazies
    if ids.owns(row.instance)
        unheld-lazies.append(WaveringLazy(ids.instance(row.instance), ids.slot(row.slot)))
for fact in peer.unheld-transforms
    . transform = ids.transforms[fact]
    if transform != U32.max
        unheld-transforms += transform
for body in peer.task-bodies
    if ids.owns(body)
        task-bodies += ids.instance(body)
for body in peer.region-bodies
    if ids.owns(body)
        region-bodies += ids.instance(body)
for row in peer.style-users
    if ids.owns(row.instance)
        style-users += StyleUser
            - ids.type(row.type)
            - ids.instance(row.instance)
            - row.module
            - row.site
            - row.constructed

────────────────────
_ do absorb-applications [U32]
    - peer Facts
    - ids PeerIds
    - sheets [U32]

` Takes in the style sites and the applications of style rules of the peer's instances that this
` pass takes from it, each application's `outer` and the style sheet of its family numbered here,
` with the state cells of `when`s and the values of rules the peer's instances made
` (`absorb-scope-cells`, `absorb-scope-values`) and what names them (`absorb-contents`). An
` application names its cells, the link of those further out, and the values around it, as they
` stand here. Says where each of the peer's applications stands here, or `U32.max` where it was
` not taken in.
for row in peer.style-sites
    if ids.owns(row.instance)
        style-sites += StyleSite(ids.instance(row.instance), row.module, row.site)
. cells = absorb-scope-cells(peer, ids)
. values = absorb-scope-values(peer, ids)
. moved [U32]
for row in peer.style-applications
    if !ids.owns(row.instance)
        moved += U32.max
        continue
    . fact = row as StyleApplication
    fact.instance = ids.instance(row.instance)
    fact.unit = ids.instance(row.unit)
    fact.action = ids.instance(row.action)
    fact.made = ids.type(row.made)
    fact.values = ids.instance(row.values)
    fact.updater = ids.instance(row.updater)
    fact.cell = moved-scope(cells, row.cell)
    fact.outer-cells = moved-link(peer, cells, row.outer-cells)
    fact.around-values = moved-scope(values, row.around-values)
    fact.family = moved-sheet(sheets, row.family)
    if row.outer != U32.max
        ?! Panic("An application of a style rule of another type pass is applied by one not taken in")
            if moved[row.outer] == U32.max
        fact.outer = moved[row.outer]
    moved += style-applications.length as U32
    style-applications += fact
absorb-contents(peer, ids, cells, values, moved)
= moved

────────────────────
_ do absorb-scope-cells [U32]
    - peer Facts
    - ids PeerIds

` Takes in the state cells of `when`s the peer's instances that this pass takes from it made,
` kept, read and were given, in the order the peer made them, which is the order their code holds
` them in, and each the peer made on the way to a slot outlet, which no instance holds, where this
` pass lacks it (`Checker.scope-cell`). Says where each of the peer's cells stands here, or
` `U32.max` where it was not taken in. A cell kept of the function an instance is written in
` names that one's, which this pass takes from the same peer (`Instance.with-enclosing`). First
` it takes in each place the peer keyed a cell by, as a pass alone keys every place it makes one,
` though it drops the cell again (`Checker.prune-cells`), and the runtime numbers them all
` (`ProgramTables.state-key-number`).
for held in ids.peer-instances.state-keys
    ids.instances.state-key(held.module, held.site, held.when-module, held.when)
. cells [U32]
for row in peer.scope-cells
    . key = moved-state-key(ids, row.key)
    if row.instance == no-instance
        . found = U32.max
        for index in 0 .. < scope-cells.length
            . held = scope-cells[index]
            if found == U32.max && held.instance == no-instance && same-place && same-key
                found = index as U32
            .. same-place = held.site == row.site && held.module == row.module
            .. same-key = held.when == row.when && held.key == key
        if found == U32.max
            . fact = row
            fact.owner = ids.type(row.owner)
            fact.key = key
            found = scope-cells.length as U32
            scope-cells += fact
        cells += found
    else if ids.owns(row.instance)
        . fact = row
        fact.instance = ids.instance(row.instance)
        fact.owner = ids.type(row.owner)
        fact.key = key
        if row.source != U32.max
            fact.source = moved-scope(cells, row.source)
        cells += scope-cells.length as U32
        scope-cells += fact
    else
        cells += U32.max
= cells

────────────────────
_ do absorb-scope-values [U32]
    - peer Facts
    - ids PeerIds

` Takes in the values of rules around rules written in rules that the peer's instances that this
` pass takes from it give, are given and keep, in the order the peer made them, with their frames
` and types as they stand here. Says where each of the peer's stands here, or `U32.max` where it
` was not taken in.
. values [U32]
for row in peer.scope-values
    if !ids.owns(row.instance)
        values += U32.max
        continue
    . fact = row
    fact.instance = ids.instance(row.instance)
    fact.frame = ids.frame(row.frame)
    if row.source != U32.max
        fact.source = moved-scope(values, row.source)
    fact.type-first = scope-value-types.length as U32
    for position in row.type-first .. < row.type-first + row.count
        scope-value-types += ids.type(peer.scope-value-types[position])
    values += scope-values.length as U32
    scope-values += fact
= values

────────────────────
_ do absorb-contents
    - peer Facts
    - ids PeerIds
    - cells [U32]
    - values [U32]
    - applications [U32]

` Takes in what the peer's instances that this pass takes from it record of the state cells and
` the values of rules they carry: those a markup element gives its constructor, those a slot
` outlet holds, the lines that forward a slot, and the content style rules generate, with the
` application that generates it and the values and cells it keeps, all as they stand here.
for row in peer.carried-cells
    if ids.owns(row.instance)
        carried-cells += CarriedCell
            - ids.instance(row.instance)
            - row.site
            - moved-scope(cells, row.cell)
for row in peer.carried-values
    if ids.owns(row.instance)
        carried-values += CarriedValues
            - ids.instance(row.instance)
            - row.site
            - moved-scope(values, row.values)
for row in peer.outlet-cells
    if ids.owns(row.instance)
        outlet-cells += OutletCell
            - ids.instance(row.instance)
            - row.outlet
            - moved-scope(cells, row.cell)
for row in peer.slot-forwards
    if ids.owns(row.instance)
        slot-forwards += SlotForward
            - ids.instance(row.instance)
            - row.line
            - ids.type(row.builder)
            - ids.type(row.item)
for row in peer.style-contents
    if !ids.owns(row.instance)
        continue
    . fact = row
    fact.instance = ids.instance(row.instance)
    fact.application = moved-scope(applications, row.application)
    fact.builder = ids.instance(row.builder)
    fact.closure = ids.type(row.closure)
    fact.value-first = content-values.length as U32
    for position in row.value-first .. < row.value-first + row.values
        content-values += moved-scope(values, peer.content-values[position])
    fact.cell-first = content-cells.length as U32
    for position in row.cell-first .. < row.cell-first + row.cells
        content-cells += moved-scope(cells, peer.content-cells[position])
    style-contents += fact

────────────────────
_ do moved-scope U32
    - moved [U32]
    - index U32

` Where a row the peer numbered `index` stands here, of its state cells, its values of rules or its
` applications of style rules, which is one taken in; one past those, none or one not here
` (`U32.max - 1`), stays.
if index >= U32.max - 1
    = index
?! Panic("A fact of another type pass names a state cell, values or an application not taken in")
    if (index as Size) >= moved.length || moved[index] == U32.max
= moved[index]

────────────────────
_ do moved-link U32
    - peer Facts
    - cells [U32]
    - link U32

` The link here of the peer's link of state cells `link`, made once (`scope-link`).
if link == U32.max
    = link
. held = peer.scope-links[link]
. outer = moved-link(peer, cells, held.outer)
= scope-link(moved-scope(cells, held.cell), outer)

────────────────────
_ do moved-state-key U32
    - ids PeerIds
    - key U32

` Where the peer's state key `key` stands here, made where this pass lacks it.
if key == U32.max
    = key
. held = ids.peer-instances.state-keys[key]
= ids.instances.state-key(held.module, held.site, held.when-module, held.when)

────────────────────
_ do absorb-style-runtime
    - peer Facts
    - ids PeerIds

` Takes in each function of the style runtime a peer typed that this pass has none of yet, as the
` instances that demanded them may be taken in rather than typed here.
. given = peer.style-runtime
if style-runtime.info-for == no-instance
    style-runtime.info-for = ids.instance(given.info-for)
if style-runtime.info == no-instance
    style-runtime.info = ids.instance(given.info)
if style-runtime.register-property == no-instance
    style-runtime.register-property = ids.instance(given.register-property)
if style-runtime.register == no-instance
    style-runtime.register = ids.instance(given.register)
if style-runtime.register-domain == no-instance
    style-runtime.register-domain = ids.instance(given.register-domain)
if style-runtime.intern-holder == no-instance
    style-runtime.intern-holder = ids.instance(given.intern-holder)
if style-runtime.held == no-type
    style-runtime.held = ids.type(given.held)
if style-runtime.info-required == no-instance
    style-runtime.info-required = ids.instance(given.info-required)
if style-runtime.site-static == no-instance
    style-runtime.site-static = ids.instance(given.site-static)
if style-runtime.template-static == no-instance
    style-runtime.template-static = ids.instance(given.template-static)
if style-runtime.associate == no-instance
    style-runtime.associate = ids.instance(given.associate)
if style-runtime.site-ready == no-instance
    style-runtime.site-ready = ids.instance(given.site-ready)
if style-runtime.open-block == no-instance
    style-runtime.open-block = ids.instance(given.open-block)
if style-runtime.close-block == no-instance
    style-runtime.close-block = ids.instance(given.close-block)
if style-runtime.dynamic == no-instance
    style-runtime.dynamic = ids.instance(given.dynamic)
if style-runtime.block-enabled == no-instance
    style-runtime.block-enabled = ids.instance(given.block-enabled)
if style-runtime.author-dynamic == no-instance
    style-runtime.author-dynamic = ids.instance(given.author-dynamic)
if style-runtime.site-inherit == no-instance
    style-runtime.site-inherit = ids.instance(given.site-inherit)
if style-runtime.template-object == no-instance
    style-runtime.template-object = ids.instance(given.template-object)
if style-runtime.site-cached == no-instance
    style-runtime.site-cached = ids.instance(given.site-cached)
if style-runtime.site-recording == no-instance
    style-runtime.site-recording = ids.instance(given.site-recording)
if style-runtime.site-recorded == no-instance
    style-runtime.site-recorded = ids.instance(given.site-recorded)
if style-runtime.author-object == no-instance
    style-runtime.author-object = ids.instance(given.author-object)
if style-runtime.object-pointer == no-instance
    style-runtime.object-pointer = ids.instance(given.object-pointer)
if style-runtime.imperative == no-instance
    style-runtime.imperative = ids.instance(given.imperative)
if style-runtime.imperative-object == no-instance
    style-runtime.imperative-object = ids.instance(given.imperative-object)
if style-runtime.sheet-info-for == no-instance
    style-runtime.sheet-info-for = ids.instance(given.sheet-info-for)
if style-runtime.sheet-info == no-instance
    style-runtime.sheet-info = ids.instance(given.sheet-info)
if style-runtime.sheet-register-slot == no-instance
    style-runtime.sheet-register-slot = ids.instance(given.sheet-register-slot)
if style-runtime.sheet-register == no-instance
    style-runtime.sheet-register = ids.instance(given.sheet-register)
if style-runtime.sheet-info-required == no-instance
    style-runtime.sheet-info-required = ids.instance(given.sheet-info-required)
if style-runtime.sheet-register-member == no-instance
    style-runtime.sheet-register-member = ids.instance(given.sheet-register-member)
if style-runtime.sheet-member-slot == no-instance
    style-runtime.sheet-member-slot = ids.instance(given.sheet-member-slot)
if style-runtime.sheet-member-tag == no-instance
    style-runtime.sheet-member-tag = ids.instance(given.sheet-member-tag)
if style-runtime.site-themed == no-instance
    style-runtime.site-themed = ids.instance(given.site-themed)
if style-runtime.themed-slot == no-instance
    style-runtime.themed-slot = ids.instance(given.themed-slot)
if style-runtime.themed-none == no-instance
    style-runtime.themed-none = ids.instance(given.themed-none)
if style-runtime.themed-made == no-type
    style-runtime.themed-made = ids.type(given.themed-made)
if style-runtime.site-family == no-instance
    style-runtime.site-family = ids.instance(given.site-family)
if style-runtime.site-family-end == no-instance
    style-runtime.site-family-end = ids.instance(given.site-family-end)
if style-runtime.site-sheet == no-instance
    style-runtime.site-sheet = ids.instance(given.site-sheet)
if style-runtime.site-projected == no-instance
    style-runtime.site-projected = ids.instance(given.site-projected)
if style-runtime.remap-tags == no-type
    style-runtime.remap-tags = ids.type(given.remap-tags)
if style-runtime.scope-state == no-instance
    style-runtime.scope-state = ids.instance(given.scope-state)
if style-runtime.template-content == no-instance
    style-runtime.template-content = ids.instance(given.template-content)
if style-runtime.content-enabled == no-instance
    style-runtime.content-enabled = ids.instance(given.content-enabled)
if style-runtime.outlet-mark == no-instance
    style-runtime.outlet-mark = ids.instance(given.outlet-mark)
if style-runtime.outlet-push == no-instance
    style-runtime.outlet-push = ids.instance(given.outlet-push)
if style-runtime.outlet-release == no-instance
    style-runtime.outlet-release = ids.instance(given.outlet-release)
if style-runtime.outlet-state == no-instance
    style-runtime.outlet-state = ids.instance(given.outlet-state)

────────────────────
_ do absorb-rules
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]

` Takes in the facts of the peer's instances that this pass takes from it that are found by the
` instance and the node they are recorded at.
for row in peer.local-rules
    if ids.owns(row.instance)
        . fact = row as LocalRule
        fact.instance = ids.instance(row.instance)
        fact.answer = ids.type(row.answer)
        fact.result = ids.type(row.result)
        fact.stream = ids.type(row.stream)
        fact.buffer = ids.type(row.buffer)
        fact.adapted = ids.type(row.adapted)
        fact.relayed = ids.type(row.relayed)
        local-rule-rows[instance-bits /or/ (fact.syntax as Size)] = local-rules.length as U32
        .. instance-bits = (fact.instance as Size) /lshift/ 32
        local-rules.append(fact)
for row in peer.rule-calls
    if ids.owns(row.instance)
        note-rule-call(ids.instance(row.instance), row.from, row.to)
for row in peer.content-links
    if ids.owns(row.instance)
        . link = row as ContentLink
        link.instance = ids.instance(row.instance)
        link.parent = ids.type(row.parent)
        link.taken = ids.type(row.taken)
        link.call = moved(call-ids, row.call)
        link.answers = ids.type(row.answers)
        link.append = ids.instance(row.append)
        link.close = moved(call-ids, row.close)
        note-content-link(link)
for row in peer.filler-calls
    if ids.owns(row.instance)
        note-filler(ids.instance(row.instance), moved(call-ids, row.call))
for row in peer.materials
    if ids.owns(row.instance)
        . fact = row as MaterialFact
        fact.instance = ids.instance(row.instance)
        fact.slot = ids.slot(row.slot)
        fact.type = ids.type(row.type)
        fact.interface = ids.type(row.interface)
        fact.call = moved(call-ids, row.call)
        fact.next = U32.max
        record-material(fact)
for row in peer.rollback-bodies
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        . mark = moved(call-ids, row.mark)
        . rewind = moved(call-ids, row.rewind)
        add-rollback-body
            - RollbackBody
                - instance
                - row.syntax
                - mark
                - rewind
                - ids.type(row.held)
                - ids.type(row.kept)
for row in peer.storage-bodies
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        . walked = absorb-steps(peer, ids, row.through)
        add-storage-body(StorageBody(instance, row.syntax, walked, ids.type(row.context)))
for row in peer.observer-bodies
    if ids.owns(row.instance)
        add-observer-body
            - ObserverBody
                - ids.instance(row.instance)
                - row.syntax
                - moved(call-ids, row.record)
                - moved(call-ids, row.rewind)

────────────────────
_ do absorb-shared
    - peer Facts
    - ids PeerIds

` Takes in the facts that belong to no one instance, each that this pass lacks.
for type in peer.equalities
    require-equality(ids.type(type))
for row in peer.tracked-properties
    note-tracked(row.module, row.decl, row.name)
for row in peer.constant-globals
    . known = false
    for held in constant-globals
        if held.module == row.module && held.decl == row.decl
            known = true
    if !known
        constant-globals.append(ConstantGlobal(row.module, row.decl))
for row in peer.witness-tables
    ?! Panic("A witness table of another type pass holds an equality")
        if row.equality != no-instance
    record-witness-table(ids.type(row.value), ids.type(row.interface))
for row in peer.dynamic-witnesses
    record-dynamic-witness(ids.type(row.value), ids.type(row.interface))
for row in peer.witness-funcs
    record-witness-func(ids.type(row.interface), row.module, row.decl)
for row in peer.witness-calls
    record-witness-call(ids.type(row.interface), row.module, row.decl)
for proto in peer.witness-protos
    record-witness-proto(ids.instance(proto))
for type in peer.asked-marks
    note-asked-mark(ids.type(type))
for type in peer.property-reads
    note-properties-read(ids.type(type))
for (function, result) in peer.carried-heads
    note-carried(ids.type(function as TypeId), ids.type(result))
for (key, place) in peer.cast-places
    . source = ids.type((key /rshift/ 32) as TypeId)
    . target = ids.type((key /and/ (U32.max as Size)) as TypeId)
    . owner = (place /rshift/ 32) as InstanceId
    . held = cast-key(source, target)
    if owner == no-instance
        cast-places[held] = ((no-instance as U64) /lshift/ 32)
    else
        . instance = ids.instance(owner)
        . known = cast-places[held]
        . moved = ((instance as U64) /lshift/ 32) /or/ (place /and/ (U32.max as U64))
        if known == null
            cast-places[held] = moved
        else if (known /rshift/ 32) != (instance as U64)
            cast-places[held] = ((no-instance as U64) /lshift/ 32)
        else if known != moved
            shared-casts[held] = true
for (key, shared) in peer.shared-casts
    . source = ids.type((key /rshift/ 32) as TypeId)
    . target = ids.type((key /and/ (U32.max as Size)) as TypeId)
    shared-casts[cast-key(source, target)] = shared
if unhandled-error == null
    unhandled-error = peer.unhandled-error

────────────────────
_ do absorb-places
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]

` Takes in what the peer keeps of the nodes of the instances this pass takes from it, by the
` place of the node among all nodes or by its instance.
. starts = peer.owned-starts(ids)
for (slot, bits) in peer.bullet-sites
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        bullet-sites[place] = bits
for (slot, call) in peer.protocol-starts
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        protocol-starts[place] = moved(call-ids, call)
for (slot, take) in peer.loop-takes
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        loop-takes[place] = take
for (slot, flag) in peer.replacing
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        replacing[place] = flag
for (slot, flag) in peer.leaving
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        leaving[place] = flag
for (slot, flag) in peer.checked-rows
    . place = peer.node-place(ids, starts, slot)
    if place != U32.max
        checked-rows[place] = flag
for (key, flag) in peer.marking-arms
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        marking-arms[((ids.instance(owner) as Size) /lshift/ 32) /or/ arm-syntax] = flag
        .. arm-syntax = key /and/ (U32.max as Size)
for (key, flag) in peer.inside-reads
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        inside-reads[((ids.instance(owner) as Size) /lshift/ 32) /or/ inside-syntax] = flag
        .. inside-syntax = key /and/ (U32.max as Size)
for (key, flag) in peer.dominated-reads
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        dominated-reads[((ids.instance(owner) as Size) /lshift/ 32) /or/ dominated-syntax] = flag
        .. dominated-syntax = key /and/ (U32.max as Size)
for (key, flag) in peer.spanning-arms
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        spanning-arms[((ids.instance(owner) as Size) /lshift/ 32) /or/ spanning-syntax] = flag
        .. spanning-syntax = key /and/ (U32.max as Size)
for (key, span) in peer.spanning-its
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        spanning-its[((ids.instance(owner) as Size) /lshift/ 32) /or/ span-syntax] = ids.type(span)
        .. span-syntax = key /and/ (U32.max as Size)

────────────────────
_ do absorb-styles
    - peer Facts
    - ids PeerIds
    - domains [U32]
    - sheeted PeerSheets

` Takes in the domains of invalidation, the codings, the styles and the gates the peer made, each
` that this pass lacks, by its key: a domain by its name, a coding by its type, a style by its type
` with its properties in order and the domains changes to them raise, and a gate by its type, its
` `when`s and whether it gates content. A coding's holder of objects is taken where only the peer
` made one. Then takes in what the peer's instances that this pass takes from it recorded of
` styles and of the arguments of markup elements they store, each row of those it names numbered
` here: a style sheet by `absorb-sheets`, and a projection and a value evaluated from the slots of
` a sheet the first time one is named (`PeerSheets`). A value evaluated once for every making is
` kept for the instance whose stable key is least, as typing keeps it (`note-static-value`).
for row in peer.style-codings
    . type = ids.type(row.type)
    . found = U32.max
    for position in 0 .. < style-codings.length
        if style-codings[position].type == type
            found = position as U32
    if found == U32.max
        style-codings += StyleCoding
            - type
            - ids.instance(row.intern)
            - ids.instance(row.holder)
            - ids.type(row.taken)
            - ids.instance(row.value-holder)
    else if style-codings[found].value-holder == no-instance
        style-codings[found].value-holder = ids.instance(row.value-holder)
. properties [U32]
for _ in 0 .. < peer.style-properties.length
    properties += U32.max
for row in peer.style-uses
    . type = ids.type(row.type)
    . first = U32.max
    for held in style-uses
        if held.type == type
            ?! Panic("A style of another type pass has other properties here")
                if held.count != row.count
            first = held.first
    if first == U32.max
        first = style-properties.length as U32
        for offset in 0 .. < row.count
            . property = peer.style-properties[row.first + offset] as StyleProperty
            property.type = ids.type(property.type)
            style-properties += property
        for held in peer.property-domains
            if held.property >= row.first && held.property < row.first + row.count
                property-domains += PropertyDomain
                    - first + held.property - row.first
                    - domains[held.domain]
                    - held.parent
        style-uses += StyleUse(type, ids.instance(row.singleton), first, row.count)
    for offset in 0 .. < row.count
        properties[row.first + offset] = first + offset
. gates [U32]
for row in peer.style-gates
    . whens [StyleWhen]
    for offset in 0 .. < row.count
        . held = peer.style-gate-whens[row.first + offset] as StyleWhen
        held.test = ids.instance(held.test)
        whens += held
    . type = ids.type(row.type)
    . found = gate-of(type, whens, row.content)
    if found == U32.max
        found = style-gates.length as U32
        style-gates += StyleGate
            - type
            - style-gate-whens.length as U32
            - row.count
            - ids.instance(row.action)
            - row.content
        for held in whens
            style-gate-whens += held
    gates += found
for row in peer.style-declarations
    if ids.owns(row.instance)
        . fact = row as StyleDeclaration
        fact.instance = ids.instance(row.instance)
        fact.style = ids.type(row.style)
        fact.property = moved-row(properties, row.property)
        fact.sheet = moved-sheet(sheeted.sheets, row.sheet)
        fact.projection = moved-projection(peer, sheeted, row.projection)
        fact.themed = moved-themed(peer, ids, sheeted, row.themed)
        add-style-declaration(fact)
for row in peer.style-authors
    if ids.owns(row.instance)
        style-authors += StyleAuthor(ids.instance(row.instance), row.site)
for row in peer.style-static-values
    if ids.owns(row.instance)
        note-static-value(row.module, row.site, ids.instance(row.instance), ids.type(row.type))
for row in peer.style-writes
    if ids.owns(row.instance)
        style-writes += StyleWrite
            - ids.instance(row.instance)
            - row.site
            - ids.type(row.style)
            - moved-row(properties, row.property)
for row in peer.style-reads
    if ids.owns(row.instance)
        . fact = row as StyleRead
        fact.instance = ids.instance(row.instance)
        fact.style = ids.type(row.style)
        fact.reader = ids.instance(row.reader)
        fact.type = ids.type(row.type)
        if row.sheet == U32.max
            fact.property = moved-row(properties, row.property)
        else
            fact.sheet = moved-sheet(sheeted.sheets, row.sheet)
        style-reads += fact
for row in peer.style-flags
    if ids.owns(row.instance)
        style-flags += StyleFlag
            - ids.instance(row.instance)
            - row.site
            - moved-row(domains, row.domain)
            - ids.instance(row.call)
for row in peer.rule-updates
    if ids.owns(row.instance)
        rule-updates += RuleUpdate
            - ids.instance(row.instance)
            - row.site
            - ids.property(row.property)
            - row.reads-given
for row in peer.element-stores
    if ids.owns(row.instance)
        . instance = ids.instance(row.instance)
        note-element-store
            - ElementStore
                - instance
                - row.site
                - row.argument
                - ids.property(row.property)
                - row.converted
                - row.setter
for row in peer.coding-users
    if ids.owns(row.instance)
        coding-users += CodingUser(ids.instance(row.instance), ids.type(row.type), row.holds)
for row in peer.gate-users
    if ids.owns(row.instance)
        gate-users += GateUser(ids.instance(row.instance), moved-row(gates, row.gate))
for row in peer.domain-users
    if ids.owns(row.instance)
        . user = row as DomainUser
        user.instance = ids.instance(row.instance)
        user.domain = moved-row(domains, row.domain)
        domain-users += user

────────────────────
_ moved-row U32
    - taken [U32]
    - row U32

` The place here of a row of a registry the peer numbered `row`, which is one taken in.
?! Panic("A fact of another type pass names a row of a registry not taken in")
    if (row as Size) >= taken.length || taken[row] == U32.max

taken[row]

────────────────────
_ do absorb-domains [U32]
    - peer Facts

. domains [U32]
for row in peer.style-domains
    . found = U32.max
    for position in 0 .. < style-domains.length
        if style-domains[position].name == row.name
            found = position as U32
    if found == U32.max
        found = style-domains.length as U32
        style-domains += StyleDomain(row.name)
    domains += found
= domains

────────────────────
_ do absorb-sheets [U32]
    - peer Facts
    - ids PeerIds
    - domains [U32]

. sheets [U32]
for row in peer.style-sheet-uses
    . type = ids.type(row.type)
    . found = U32.max
    for position in 0 .. < style-sheet-uses.length
        if style-sheet-uses[position].type == type
            found = position as U32
    if found == U32.max
        . first = sheet-slots.length as U32
        for offset in 0 .. < row.count
            . slot = peer.sheet-slots[row.first + offset] as SheetSlot
            slot.type = ids.type(slot.type)
            slot.domains = moved-domains(domains, slot.domains)
            sheet-slots += slot
        for member in peer.sheet-members
            if member.root == row.type
                . start = sheet-member-slots.length as U32
                for position in member.first .. < member.first + member.count
                    sheet-member-slots += peer.sheet-member-slots[position]
                sheet-members += SheetMember
                    - type
                    - ids.type(member.type)
                    - ids.instance(member.singleton)
                    - start
                    - member.count
        found = style-sheet-uses.length as U32
        style-sheet-uses += StyleSheetUse(type, ids.instance(row.singleton), first, row.count)
    sheets += found
= sheets

────────────────────
_ do moved-domains U32
    - domains [U32]
    - mask U32

. moved = 0u32
for position in 0 .. < domains.length
    if position < 32 && selected && domains[position] < 32
        moved = moved /or/ (1u32 /lshift/ (domains[position] as Size))
    .. selected = (mask /and/ (1u32 /lshift/ (position as Size))) != 0
= moved

────────────────────
_ moved-sheet U32
    - sheets [U32]
    - sheet U32

if sheet >= U32.max - 1 then sheet else sheets[sheet]

────────────────────
_ do unmoved-rows [U32]
    - count Size

. rows [U32]
for _ in 0 .. < count
    rows += U32.max
= rows

────────────────────
_ do moved-projection U32
    - peer Facts
    - sheeted PeerSheets
    - projection U32

=? projection if projection >= U32.max - 1
. held = sheeted.projections[projection]
=? held if held != U32.max
. row = peer.style-projections[projection] as StyleProjection
if row.kind == 2
    . first = projection-tags.length as U32
    for offset in row.first .. < row.first + row.count
        projection-tags += peer.projection-tags[offset]
    row.first = first
. place = style-projections.length as U32
style-projections += row
sheeted.projections[projection] = place
= place

────────────────────
_ do moved-themed U32
    - peer Facts
    - ids PeerIds
    - sheeted PeerSheets
    - row U32

=? row if row == U32.max
. held = sheeted.themed[row]
=? held if held != U32.max
. value = peer.style-themed-values[row]
. instance = ids.instance(value.instance)
. type = ids.type(value.type)
. sheet = moved-sheet(sheeted.sheets, value.sheet)
. place = U32.max
if value.given == U32.max
    place = note-themed-value(value.module, value.site, instance, type, sheet)
else
    . givens [ThemedGiven]
    for position in value.given .. < value.given + value.given-count
        . given = peer.themed-givens[position]
        givens += ThemedGiven(ids.slot(given.param), given.slot)
    place = note-given-themed-value(value.module, value.site, instance, type, sheet, givens)
sheeted.themed[row] = place
= place

────────────────────
_ do absorb-themes
    - peer Facts
    - ids PeerIds
    - sheeted PeerSheets
    - applications [U32]

for row in peer.theme-reads
    if ids.owns(row.instance)
        add-theme-read
            - ThemeRead
                - ids.instance(row.instance)
                - row.module
                - row.site
                - moved-sheet(sheeted.sheets, row.sheet)
                - row.slot
for row in peer.rule-slots
    . application = applications[row.application]
    if application != U32.max
        add-rule-slot
            - RuleSlot
                - application
                - row.site
                - moved-sheet(sheeted.sheets, row.sheet)
                - row.slot
                - moved-projection(peer, sheeted, row.projection)
for row in peer.rule-themes
    . application = applications[row.application]
    if application != U32.max
        add-rule-theme
            - RuleTheme(application, row.site, moved-themed(peer, ids, sheeted, row.themed))

────────────────────
_ do absorb-markup
    - peer Facts
    - ids PeerIds
    - call-ids [FactId]
    - conversion-ids [FactId]

` Takes in what the peer's instances that this pass takes from it recorded of markup, of tracked
` values and of the events they use, with the event runtime's functions that close an object's
` events and register a lowered section where this pass has none yet. A markup trigger's target
` is numbered here, among the targets of descendant queries this pass took in first
` (`merge-sessions`). Each markup query the peer recorded that this pass lacks is taken in by its
` class and property, with its target numbered so and the conversion of an object of the class
` to its markup host: the one taken in with the instance that recorded it, or else a copy no node
` leads to. A registration names the query here. Each rule the peer runs once markup has, and this
` pass does not, is taken in by its instance.
. queries [U32]
for row in peer.markup-queries
    . level = ids.type(row.level)
    . place = ids.property(row.place)
    . found = U32.max
    for offset in 0 .. < markup-queries.length
        if markup-queries[offset].level == level && markup-queries[offset].place == place
            found = offset as U32
    if found == U32.max
        . fact = row as MarkupQuery
        fact.level = level
        fact.place = place
        fact.target = ids.type(row.target)
        if row.target-id != 0
            fact.target-id = (query-targets.find(fact.target)! + 1) as U32
        fact.hosted = conversion-ids[row.hosted]
        if fact.hosted == no-fact
            . moved = absorb-conversion(peer, ids, peer.conversions[row.hosted])
            moved.next = no-fact
            . hosted FactId = conversions.length as FactId
            conversions.append(moved)
            chain-fact(conversion-lasts, conversion-priors, moved.instance, hosted)
            fact.hosted = hosted
        fact.parent = ids.instance(row.parent)
        fact.add = ids.instance(row.add)
        fact.remove = ids.instance(row.remove)
        found = markup-queries.length as U32
        markup-queries += fact
    queries += found
for row in peer.query-registrations
    if ids.owns(row.instance)
        . query = if row.query != U32.max then moved-row(queries, row.query) else U32.max
        query-registrations += QueryRegistration
            - ids.instance(row.instance)
            - row.site
            - ids.type(row.level)
            - query
            - ids.instance(row.register)
for row in peer.change-tests
    if ids.owns(row.instance)
        note-change-test(ids.instance(row.instance), ids.instance(row.tester), row.hosted)
for row in peer.markup-reads
    if ids.owns(row.instance)
        markup-reads += MarkupRead
            - ids.instance(row.instance)
            - row.site
            - ids.instance(row.reader)
            - ids.type(row.target)
for row in peer.row-item-reads
    if ids.owns(row.instance)
        row-item-reads += RowItemRead(ids.instance(row.instance), row.site, ids.type(row.held))
for row in peer.collection-reads
    if ids.owns(row.instance)
        collection-reads += CollectionRead(ids.instance(row.instance), row.site)
for row in peer.pulled-sites
    if ids.owns(row.instance)
        pulled-sites += PulledSite(ids.instance(row.instance), row.site)
for row in peer.event-uses
    if ids.owns(row.instance)
        . fact = row as EventUse
        fact.instance = ids.instance(row.instance)
        fact.owner = ids.type(row.owner)
        fact.first = ids.instance(row.first)
        fact.second = ids.instance(row.second)
        fact.callback = ids.instance(row.callback)
        event-uses += fact
for row in peer.element-roots
    if ids.owns(row.instance)
        element-roots += ElementRoot
            - ids.instance(row.instance)
            - row.site
            - ids.instance(row.ensure)
            - ids.instance(row.mount)
            - row.owns
for row in peer.named-stores
    if ids.owns(row.instance)
        note-named-store
            - NamedStore(ids.instance(row.instance), row.site, ids.property(row.property))
for row in peer.slot-outlets
    if ids.owns(row.instance)
        . fact = row as SlotOutlet
        fact.instance = ids.instance(row.instance)
        fact.content = ids.type(row.content)
        fact.held = ids.slot(row.held)
        fact.chosen = ids.instance(row.chosen)
        fact.picks = ids.type(row.picks)
        fact.arm = ids.type(row.arm)
        slot-outlets += fact
for row in peer.slot-choices
    if ids.owns(row.instance)
        slot-choices += SlotChoice
            - ids.instance(row.instance)
            - row.site
            - row.line
            - ids.type(row.choice)
            - ids.instance(row.create)
            - ids.instance(row.fill)
            - ids.type(row.selector)
for row in peer.raised-elements
    if ids.owns(row.instance)
        note-raised(ids.instance(row.instance), row.block, row.element)
for (key, element) in peer.raised-sites
    . owner = (key /rshift/ 32) as InstanceId
    if ids.owns(owner)
        . block = peer.raised-blocks[((owner as Size) /lshift/ 32) /or/ (element as Size)]!
        note-raised(ids.instance(owner), block, element, (key /and/ (U32.max as Size)) as SyntaxId)
for row in peer.loop-regions
    if ids.owns(row.instance)
        . fact = row as LoopRegion
        fact.instance = ids.instance(row.instance)
        fact.host = ids.type(row.host)
        fact.content = ids.type(row.content)
        fact.source = ids.type(row.source)
        fact.create = ids.instance(row.create)
        fact.updater = ids.instance(row.updater)
        fact.action = ids.instance(row.action)
        fact.structural = ids.instance(row.structural)
        fact.ensure = ids.instance(row.ensure)
        fact.replace = ids.instance(row.replace)
        fact.adapts = ids.instance(row.adapts)
        loop-regions += fact
for row in peer.branch-regions
    if ids.owns(row.instance)
        . fact = row as BranchRegion
        fact.instance = ids.instance(row.instance)
        fact.host = ids.type(row.host)
        fact.content = ids.type(row.content)
        fact.list = ids.type(row.list)
        fact.selected = ids.type(row.selected)
        fact.create = ids.instance(row.create)
        fact.updater = ids.instance(row.updater)
        fact.action = ids.instance(row.action)
        fact.structural = ids.instance(row.structural)
        fact.keeps = ids.instance(row.keeps)
        fact.select = ids.instance(row.select)
        fact.ensure = ids.instance(row.ensure)
        branch-regions += fact
for row in peer.markup-triggers
    if ids.owns(row.instance)
        . fact = row as MarkupTrigger
        fact.instance = ids.instance(row.instance)
        fact.target = ids.type(row.target)
        if row.target-id != 0
            fact.target-id = (query-targets.find(fact.target)! + 1) as U32
        fact.found = ids.type(row.found)
        fact.host = ids.type(row.host)
        fact.changes = ids.type(row.changes)
        fact.made = ids.instance(row.made)
        fact.clear = ids.instance(row.clear)
        fact.record = ids.instance(row.record)
        fact.register = ids.instance(row.register)
        fact.parent = ids.instance(row.parent)
        fact.schedule = ids.instance(row.schedule)
        markup-triggers += fact
for row in peer.deferred-values
    if ids.owns(row.instance)
        . places [U32]
        for position in row.start .. < row.start + row.count
            places += ids.property(peer.deferred-places[position])
        note-deferred(ids.instance(row.instance), places)
for row in peer.region-roots
    if ids.owns(row.instance)
        region-roots += RegionRoot
            - ids.instance(row.instance)
            - row.site
            - ids.slot(row.slot)
            - ids.type(row.batch)
            - ids.instance(row.ensure)
for row in peer.whenever-calls
    if ids.owns(row.instance)
        whenever-calls += WheneverCalls
            - ids.instance(row.instance)
            - row.owns
            - moved(call-ids, row.subscribe)
            - moved(call-ids, row.unsubscribe)
for row in peer.live-statements
    if ids.owns(row.instance)
        . fact = row as LiveStatement
        fact.instance = ids.instance(row.instance)
        fact.rerun = ids.instance(row.rerun)
        fact.property = ids.property(row.property)
        fact.owned = ids.instance(row.owned)
        fact.holder = ids.type(row.holder)
        live-statements += fact
for row in peer.owned-subscriptions
    if ids.owns(row.instance)
        owned-subscriptions += OwnedSubscription
            - ids.instance(row.instance)
            - row.site
            - ids.instance(row.subscription)
            - ids.instance(row.tracker)
for row in peer.tracked-locals
    if ids.owns(row.instance)
        note-tracked-local(ids.instance(row.instance), row.site)
for row in peer.latest-reads
    if ids.owns(row.instance)
        latest-reads += LatestRead
            - ids.instance(row.instance)
            - row.site
            - ids.type(row.stream)
            - ids.instance(row.tracker)
            - ids.instance(row.publisher)
for closer in peer.event-closers
    if ids.owns(closer)
        event-closers += ids.instance(closer)
if event-close == no-instance
    event-close = ids.instance(peer.event-close)
if event-register == no-instance
    event-register = ids.instance(peer.event-register)
if event-register-arrival == no-instance
    event-register-arrival = ids.instance(peer.event-register-arrival)
if machine-own == no-instance
    machine-own = ids.instance(peer.machine-own)
if machine-stop == no-instance
    machine-stop = ids.instance(peer.machine-stop)
if machine-close == no-instance
    machine-close = ids.instance(peer.machine-close)
if task-owner-make == no-instance
    task-owner-make = ids.instance(peer.task-owner-make)
for unit in peer.markup-rules
    . rule = ids.instance(unit)
    if !waits-for-markup(rule)
        markup-rules += rule

────────────────────
_ do absorb-plans
    - peer Facts
    - ids PeerIds

` Takes in the plans of the event handlers of the classes the peer planned that this pass has not:
` each class with its handlers, in the order the peer planned them, and each section a plan
` subscribes or a branch of the markup subscribes again, once. Then takes in the sections the
` peer's instances that this pass takes from it typed, those typed as run from tables among the
` sections so typed. Those it takes are typed as the plans of every peer together say
` (`merge-sessions`).
for receiver in peer.lowered-types
    . type = ids.type(receiver)
    . known = false
    for planned in lowered-types
        known = known || planned == type
    if known
        continue
    lowered-types += type
    for row in peer.lowered-handlers
        if row.type == receiver
            lowered-handlers += LoweredHandler
                - type
                - ids.type(row.level)
                - row.module
                - row.decl
                - row.syntax
                - ids.type(row.owner)
                - row.name
                - row.order
                - row.arrives
for row in peer.subscribed-sections
    . level = ids.type(row.level)
    if !holds-section(subscribed-sections, level, row.module, row.syntax)
        subscribed-sections += SectionRef(level, row.module, row.syntax)
for row in peer.rebinding-sections
    . level = ids.type(row.level)
    if !holds-section(rebinding-sections, level, row.module, row.syntax)
        rebinding-sections += SectionRef(level, row.module, row.syntax)
for row in peer.typed-sections
    if ids.owns(row.instance)
        . level = ids.type(row.level)
        typed-sections += TypedSection
            - ids.instance(row.instance)
            - level
            - row.module
            - row.syntax
            - row.lowered
        if row.lowered && !holds-section(lowered-sections, level, row.module, row.syntax)
            lowered-sections += SectionRef(level, row.module, row.syntax)

────────────────────
_ do owned-starts [U64]
    - ids PeerIds

` The first node of each instance of this pass that a peer takes from it, above the instance,
` in the order of their first nodes. An instance that holds no nodes is left out: its first node
` would be that of the instance whose nodes come next.
. starts [U64]
for id in 0 .. < instances.rows.length
    . row = instances.rows[id]
    if row.node-start != U32.max && row.subtree.count != 0 && ids.owns(id as InstanceId)
        starts += ((row.node-start as U64) /lshift/ 32) /or/ (id as U64)
= sort(starts)

────────────────────
_ do node-place U32
    - ids PeerIds
    - starts [U64]
    - slot Size

` The place among the nodes of the pass that takes from this one of the node at `slot` here, or
` `U32.max` where the node is of an instance that pass does not take.
. low Size = 0
. high Size = starts.length
while low < high
    . middle = low + (high - low) / 2
    if (starts[middle] /rshift/ 32) as Size <= slot
        low = middle + 1
    else
        high = middle
if low == 0
    = U32.max
. found = starts[low - 1]
. instance = (found /and/ (U32.max as U64)) as InstanceId
. row = instances.rows[instance]
if slot >= (row.node-start + row.subtree.count) as Size
    = U32.max
= ids.instances.rows[ids.instance(instance)].node-start + (slot as U32) - row.node-start

━━━━━━━━━━━━━━━━━━━━
+ table-member TableOp
    - name String

` The operation of a member of an arena's table that the compiler answers where it is called or
` read, as TypeScript answers it, or `table-row` for one it leaves to its body.
match name
    |= "append"
        TableOp.table-append
    |= "reserve"
        TableOp.table-reserve
    |= "extend"
        TableOp.table-extend
    |= "truncate"
        TableOp.table-truncate
    |= "clear"
        TableOp.table-clear
    |= "copy-from"
        TableOp.table-copy-from
    |= "finish"
        TableOp.table-finish
    |= "view"
        TableOp.table-view
    |= "rewind"
        TableOp.table-rewind
    |= "storage-checkpoint"
        TableOp.table-storage-checkpoint
    |= "validate-storage-restore"
        TableOp.table-validate-restore
    |= "restore-storage"
        TableOp.table-restore-storage
    |= "mark"
        TableOp.table-mark
    |= "capacity"
        TableOp.table-capacity
    ??
        TableOp.table-row

━━━━━━━━━━━━━━━━━━━━
+ compares-in-place Bool
    - plan OperatorPlan

` Whether a comparison is one the reference makes with no call of its own: of tuples, structs
` or unions field by field, of objects or atoms by identity, of an optional with `null`, of
` values never equal, or a test of an object's class. The calls a field-by-field comparison
` makes are recorded, and the frame sees them.
structural || plan == .plan-absent || plan == .plan-unlike || plan == .plan-class-test

.. structural = plan == .plan-fields || plan == .plan-not-fields || plan == .plan-identity

━━━━━━━━━━━━━━━━━━━━
+ is-float-math Bool
    - plan OperatorPlan

plan == .plan-f64-sqrt || plan == .plan-f64-abs || plan == .plan-f64-min || plan == .plan-f64-max

━━━━━━━━━━━━━━━━━━━━
+ is-applied Bool
    - reason ConversionReason

` Whether some shape here applies the conversions recorded for a reason. Generated content
` applies the object of its markup element made a `MarkupElement`, and the function that builds
` it made a `MarkupSlotBuilder`, at the line that builds it (`generate-content`). A write to an
` event that bubbles applies its object made an `EventNode` (`emit-publish`, `emit-route`).
|? reason == .reason-argument || reason == .reason-print || reason == .reason-operand
    true
|? reason == .reason-markup-host || reason == .reason-markup-slot || reason == .reason-markup-arm
    true
|? reason == .reason-explicit || reason == .reason-return || reason == .reason-join
    true
|? reason == .reason-literal-return
    true
|? reason == .reason-promotion || reason == .reason-result
    true
|? reason == .reason-assignment || reason == .reason-declaration || reason == .reason-element
    true
|? reason == .reason-receiver || reason == .reason-default || reason == .reason-relation
    true
|? reason == .reason-own-receiver || reason == .reason-event-node
    true
??
    reason == .reason-operator || reason == .reason-step || reason == .reason-piped
