+ do set-loop-take
    - instance InstanceId
    - loop SyntaxId
    - take LoopTake

` Keeps what the header of a loop does with an item it has read.
. slot = node-slot(instance, loop)
if slot
    loop-takes[slot] = take

────────────────────
+ loop-take LoopTake
    - instance InstanceId
    - loop SyntaxId

` What the header of a loop does with an item it has read: no more than keep it where the
` type pass kept nothing.
|? !slot || !kept
    .take-whole
??
    kept as LoopTake

.. slot = node-slot(instance, loop)
.. kept = loop-takes[slot]

────────────────────
+ bullet-site SyntaxId
    - instance InstanceId
    - loop SyntaxId

` Where the facts of a bullet are recorded, as `set-bullet-site` kept it, and those of any
` other node, such as the header of a loop, at the node.
|? !slot || !kept
    loop
??
    (kept % 4294967296) as SyntaxId

.. slot = node-slot(instance, loop)
.. kept = bullet-sites[slot]

────────────────────
+ is-bullet-below Bool
    - instance InstanceId
    - bullet SyntaxId

` Whether the loop of a bullet that gives every item of a container is located on the line
` under the bullet.
|? !slot
    false
??
    kept != null && kept >= 4294967296

.. slot = node-slot(instance, bullet)
.. kept = bullet-sites[slot]

────────────────────
+ do set-through
    - instance InstanceId
    - syntax SyntaxId
    - places [U32]
    - getters [InstanceId]

` Plans a node as a read through the properties its object delegates to, and keeps their
` places and the getters that answer them.
. kept = keep-steps(places, getters)
. start U64 = kept.start
. count U64 = kept.count
. bits = start + count * 4294967296
set-constant(instance, syntax, ConstantFact(bits, 0.0, null, false), .plan-through)

────────────────────
+ through-of RowRange'U32
    - instance InstanceId
    - syntax SyntaxId

` The properties a node planned with `plan-through` reads from its object, in the order
` they are read.
RowRange'U32((bits % 4294967296) as U32, (bits / 4294967296) as U32)

.. bits = constants[constant-of(instance, syntax)].bits

────────────────────
+ do replay-call
    - fact CallFact
    - instance InstanceId

. id FactId = calls.length as FactId
calls.append(CallFact(instance, fact.syntax, fact.callee, fact.form, fact.fills, fact.is-partial))
chain-fact(call-lasts, call-priors, instance, id)
calls[id].is-swapped = fact.is-swapped
calls[id].through = fact.through
link-call(instance, fact.syntax, id)

────────────────────
+ do replay-calls
    - from InstanceId
    - into InstanceId

` Records every call of one instance again under another, in syntax order.
. row = instances.rows[from]
if row.node-start != U32.max
    for offset in 0 .. < row.subtree.count
        . cursor = node-calls[row.node-start + offset]
        while cursor != no-fact
            . fact = calls[cursor] as CallFact
            replay-call(fact, into)
            cursor = fact.next
. positions [U32]
. loose = latest-of(loose-call-lasts, from)
while loose != no-fact
    positions += loose
    loose = prior-of(loose-call-priors, loose)
. position = positions.length
while position != 0
    position -= 1
    . fact = calls[loose-calls[positions[position]].fact] as CallFact
    replay-call(fact, into)

────────────────────
+ do chain-loose-calls

` Makes the calls an instance recorded at one node outside its body follow each other in the
` order they were recorded, as those at a node of a body do. Run once, when every call is
` recorded and those of initializers are folded.
. tails = Map'Size'U32(arena)
for loose in loose-calls
    . key = (loose.instance as Size) * 4294967296 + calls[loose.fact].syntax
    . tail = tails[key]
    if tail
        calls[tail].next = loose.fact
    tails[key] = loose.fact

────────────────────
+ do fold-initializers
    - bindings Bindings
    - scope [Bool]

` Moves the facts of the value of every global and of every case of an enum to the main of
` its module, where emission and the dumps read them: the types and facts at its nodes, the
` locals it retained, and every row that names it. A node the main typed itself keeps the
` main's type, and gets the initializer's calls, conversions and forces after its own. A
` function written in the value, a list of bullets or a lambda, is then written in the main,
` which runs the value as the module starts. The value of a class's property keeps its facts,
` which differ for each receiver; only what it diagnosed is its main's, so that two receivers
` say a thing once.
. total = instances.rows.length
. mains [InstanceId]
. any = false
for id in 0 .. < total
    . row = instances.rows[id]
    if row.initializer == 0 || (scope.length != 0 && (id >= scope.length || !scope[id]))
        mains += no-instance
    else
        mains += instances.intern(row.module, row.decl, no-type, 0, no-instance)
        any = true
if !any
    =
for position in 0 .. < diagnostics.length
    if mains[diagnostics[position].instance] != no-instance
        diagnostics[position].instance = mains[diagnostics[position].instance]
for id in 0 .. < total
    if mains[id] != no-instance && instances.keeps-facts(id as InstanceId)
        mains[id] = no-instance
for id in 0 .. < total
    . enclosing = instances.rows[id].enclosing
    if enclosing != no-instance && mains[enclosing] != no-instance
        instances.rows[id].enclosing = mains[enclosing]
for id in 0 .. < total
    if mains[id] != no-instance
        . row = instances.rows[id]
        if row.binding != no-binding
            reserve-nodes(mains[id], row.binding, bindings.bindings[row.binding].subtree)
fold-loose(mains)
for id in 0 .. < total
    if mains[id] != no-instance
        . binding = instances.rows[id].binding
        . slot-count = if binding != no-binding then bindings.bindings[binding].slots.count else 0
        fold-nodes(id as InstanceId, mains[id], slot-count)
for position in 0 .. < calls.length
    if mains[calls[position].instance] != no-instance
        calls[position].instance = mains[calls[position].instance]
for position in 0 .. < conversions.length
    if mains[conversions[position].instance] != no-instance
        conversions[position].instance = mains[conversions[position].instance]
for position in 0 .. < forces.length
    if mains[forces[position].instance] != no-instance
        forces[position].instance = mains[forces[position].instance]
for position in 0 .. < pairs.length
    if mains[pairs[position].instance] != no-instance
        pairs[position].instance = mains[pairs[position].instance]
for position in 0 .. < relations.length
    if mains[relations[position].instance] != no-instance
        relations[position].instance = mains[relations[position].instance]
for position in 0 .. < unwrapped.length
    if mains[unwrapped[position].instance] != no-instance
        unwrapped[position].instance = mains[unwrapped[position].instance]
for position in 0 .. < chains.length
    if mains[chains[position].instance] != no-instance
        chains[position].instance = mains[chains[position].instance]
for position in 0 .. < declared-values.length
    if mains[declared-values[position].instance] != no-instance
        declared-values[position].instance = mains[declared-values[position].instance]
for position in 0 .. < context-casts.length
    if mains[context-casts[position].instance] != no-instance
        context-casts[position].instance = mains[context-casts[position].instance]
for position in 0 .. < payload-effects.length
    if mains[payload-effects[position].instance] != no-instance
        payload-effects[position].instance = mains[payload-effects[position].instance]
for position in 0 .. < case-owners.length
    if mains[case-owners[position].instance] != no-instance
        case-owners[position].instance = mains[case-owners[position].instance]
for position in 0 .. < fills.length
    if mains[fills[position].instance] != no-instance
        fills[position].instance = mains[fills[position].instance]
for position in 0 .. < stack-reads.length
    if mains[stack-reads[position].instance] != no-instance
        stack-reads[position].instance = mains[stack-reads[position].instance]
for position in 0 .. < stack-scopes.length
    if mains[stack-scopes[position].instance] != no-instance
        stack-scopes[position].instance = mains[stack-scopes[position].instance]
for position in 0 .. < swap-forwards.length
    if mains[swap-forwards[position].instance] != no-instance
        swap-forwards[position].instance = mains[swap-forwards[position].instance]
    if swap-forwards[position].callee != no-instance && mains[swap-forwards[position].callee] != no-instance
        swap-forwards[position].callee = mains[swap-forwards[position].callee]
for position in 0 .. < global-uses.length
    if mains[global-uses[position].instance] != no-instance
        global-uses[position].instance = mains[global-uses[position].instance]
for position in 0 .. < const-arrays.length
    if mains[const-arrays[position].instance] != no-instance
        const-arrays[position].instance = mains[const-arrays[position].instance]

────────────────────
_ do fold-nodes
    - from InstanceId
    - into InstanceId
    - slot-count U32

` The locals of an initializer are a few of its main's, which begin at its base among them.
. row = instances.rows[from]
if row.may-panic
    instances.mark-may-panic(into)
if row.slot-start != U32.max
    for offset in 0 .. < row.slot-count
        retain-slot(into, slot-count, row.slot-base + offset, slot-types[row.slot-start + offset])
    instances.rows[from].slot-start = U32.max
    instances.rows[from].slot-count = 0
if row.node-start == U32.max
    =
for offset in 0 .. < row.subtree.count
    . syntax = row.subtree.start + offset
    . slot = row.node-start + offset
    if node-types[slot] != no-type
        set-node-type(into, syntax, node-types[slot])
    if (node-plans[slot] /and/ plan-bits) != OperatorPlan.plan-none
        set-plan(into, syntax, (node-plans[slot] /and/ plan-bits) as OperatorPlan)
    if (node-plans[slot] /and/ plain-bit) != 0
        mark-plain(into, syntax)
    . target = node-slot(into, syntax)
    if target && node-constants[slot] != no-fact
        node-constants[target] = node-constants[slot]
    if target && node-chains[slot] != .chain-tested
        node-chains[target] = node-chains[slot]
    . call = node-calls[slot]
    node-calls[slot] = no-fact
    fold-calls(into, syntax, call)
    . conversion = node-conversions[slot]
    node-conversions[slot] = no-fact
    node-conversion-tails[slot] = no-fact
    fold-conversions(into, syntax, conversion)
    . force = node-forces[slot]
    node-forces[slot] = no-fact
    fold-forces(into, syntax, force)
instances.rows[from].node-start = U32.max

────────────────────
_ do fold-calls
    - into InstanceId
    - syntax SyntaxId
    - first FactId

` Gives a main the calls its initializer recorded at a node, in order. A main that typed the
` node itself recorded its own there: each of the initializer's that repeats one of those,
` not repeated before, is dropped, so that the node has each call once.
. own [FactId]
. slot = node-slot(into, syntax)
if slot && first != no-fact
    . cursor = node-calls[slot]
    while cursor != no-fact
        own += cursor
        cursor = calls[cursor].next
. call = first
while call != no-fact
    . next = calls[call].next
    calls[call].next = no-fact
    . repeated = false
    for position in 0 .. < own.length
        if !repeated && own[position] != no-fact && same-call(calls[own[position]], calls[call])
            own[position] = no-fact
            repeated = true
    if !repeated
        link-call(into, syntax, call)
    call = next

────────────────────
_ do fold-conversions
    - into InstanceId
    - syntax SyntaxId
    - first FactId

` Gives a main the conversions its initializer recorded at a node, as it is given the calls.
. own [FactId]
. slot = node-slot(into, syntax)
if slot && first != no-fact
    . cursor = node-conversions[slot]
    while cursor != no-fact
        own += cursor
        cursor = conversions[cursor].next
. conversion = first
while conversion != no-fact
    . next = conversions[conversion].next
    conversions[conversion].next = no-fact
    . repeated = false
    for position in 0 .. < own.length
        if !repeated && own[position] != no-fact && alike
            own[position] = no-fact
            repeated = true
        .. alike = same-conversion(conversions[own[position]], conversions[conversion])
    if !repeated
        link-conversion(into, syntax, conversion)
    conversion = next

────────────────────
_ do fold-forces
    - into InstanceId
    - syntax SyntaxId
    - first FactId

` Gives a main the forces its initializer recorded at a node, as it is given the calls.
. own [FactId]
. slot = node-slot(into, syntax)
if slot && first != no-fact
    . cursor = node-forces[slot]
    while cursor != no-fact
        own += cursor
        cursor = forces[cursor].next
. force = first
while force != no-fact
    . next = forces[force].next
    forces[force].next = no-fact
    . repeated = false
    for position in 0 .. < own.length
        . held = own[position]
        if !repeated && held != no-fact
            . alike = same-operand && forces[held].result == forces[force].result
                .. same-operand = forces[held].operand == forces[force].operand
            if alike && forces[held].is-narrowed == forces[force].is-narrowed
                own[position] = no-fact
                repeated = true
    if !repeated
        link-force(into, syntax, force)
    force = next

────────────────────
_ do same-call Bool
    - first CallFact
    - other CallFact

` Whether two calls recorded at one node are the same call: of one callee, in one form, with
` its parameters filled alike.
if first.callee != other.callee || first.form != other.form || fills-differ
    = false
.. fills-differ = first.fills.count != other.fills.count
if first.is-partial != other.is-partial || first.is-swapped != other.is-swapped
    = false
for position in 0 .. < first.fills.count
    if call-fills[first.fills.start + position] != call-fills[other.fills.start + position]
        = false
= true

────────────────────
_ same-conversion Bool
    - first ConversionFact
    - other ConversionFact

` Whether two conversions recorded at one site are the same conversion.
same-kind && first.callee == other.callee && first.ratio == other.ratio

.. same-kind = same-types && first.kind == other.kind && first.reason == other.reason
.. same-types = first.from == other.from && first.to == other.to

────────────────────
_ do fold-loose
    - mains [InstanceId]

` What an initializer recorded at a node outside its own declaration is recorded for its main
` instead, at the node when the main holds it. A call kept apart from those of its node stays
` apart, made by the main.
. types [LooseType]
. kept Size = 0
for position in 0 .. < loose-types.length
    . held = loose-types[position] as LooseType
    if mains[held.instance] == no-instance
        loose-types[kept] = held
        kept += 1
    else
        types += held
loose-types.truncate(kept)
for held in types
    set-node-type(mains[held.instance], held.syntax, held.type)

. moved [LooseFact]
kept = 0
for position in 0 .. < loose-calls.length
    . loose = loose-calls[position] as LooseFact
    if mains[loose.instance] == no-instance
        loose-calls[kept] = loose
        kept += 1
    else if loose.apart
        loose-calls[kept] = LooseFact(mains[loose.instance], loose.fact, true)
        kept += 1
    else
        moved += loose
loose-calls.truncate(kept)
loose-call-lasts.clear()
loose-call-priors.clear()
for position in 0 .. < loose-calls.length
    link-loose-call(position)
for loose in moved
    link-call(mains[loose.instance], calls[loose.fact].syntax, loose.fact)

moved.clear()
kept = 0
for position in 0 .. < loose-conversions.length
    . loose = loose-conversions[position] as LooseFact
    if mains[loose.instance] == no-instance
        loose-conversions[kept] = loose
        kept += 1
    else
        moved += loose
loose-conversions.truncate(kept)
for loose in moved
    link-conversion(mains[loose.instance], conversions[loose.fact].syntax, loose.fact)

moved.clear()
kept = 0
for position in 0 .. < loose-forces.length
    . loose = loose-forces[position] as LooseFact
    if mains[loose.instance] == no-instance
        loose-forces[kept] = loose
        kept += 1
    else
        moved += loose
loose-forces.truncate(kept)
for loose in moved
    link-force(mains[loose.instance], forces[loose.fact].syntax, loose.fact)

────────────────────
+ do add-style-rule
    - ref DeclRef
    - name Atom

` Lists a style rule written outside any rule, after those of its name listed before it.
. position = style-rules.length as U32
style-rules += ref
style-rule-nexts += U32.max
. last = style-rule-lasts[name]
if last
    style-rule-nexts[last] = position
else
    style-rule-firsts[name] = position
style-rule-lasts[name] = position

────────────────────
+ first-style-rule U32
    - name Atom

` The place of the first style rule of a name written outside any rule, or U32.max when none is;
` each leads to the next of its name (`style-rule-nexts`).
style-rule-firsts[name] ?? U32.max

