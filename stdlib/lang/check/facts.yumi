+ do record-conversion FactId
    - instance InstanceId
    - syntax SyntaxId
    - relation Relation
    - reason ConversionReason
    - callee InstanceId = no-instance

. fact = ConversionFact
    - instance
    - syntax
    - relation.from
    - relation.to
    - relation.kind
    - relation.rank
    - reason
    - relation.ratio
    - callee
. id FactId = conversions.length as FactId
conversions.append(fact)
chain-fact(conversion-lasts, conversion-priors, instance, id)
conversions[id].case-index = relation.case-index
link-conversion(instance, syntax, id)
= id

────────────────────
+ do record-part FactId
    - instance InstanceId
    - relation Relation
    - reason ConversionReason
    - callee InstanceId

` Adds the conversion of one field of a tuple or struct. No node leads to it: the conversion
` of the whole does, through its `parts`, and each part leads to the next field's.
. fact = ConversionFact
    - instance
    - 0
    - relation.from
    - relation.to
    - relation.kind
    - relation.rank
    - reason
    - relation.ratio
    - callee
. id FactId = conversion-parts.length as FactId
conversion-parts.append(fact)
conversion-parts[id].case-index = relation.case-index
= id

────────────────────
+ do dispatches-to Bool
    - caller InstanceId
    - callee InstanceId

` Whether a door calls the door typed under a fake where its effect's slot holds one
` (`SwapDispatch`).
for dispatch in swap-dispatches
    =? true if dispatch.instance == caller && dispatch.forwarder == callee
= false

────────────────────
+ do record-call U32
    - instance InstanceId
    - syntax SyntaxId
    - callee InstanceId
    - form CallForm
    - fills ImmutableArray'U32'ArenaBacking
    - is-partial Bool
    - links Bool = true

` Keeps a call, among those of its node unless it is made apart from them, as a value a helper
` makes is: such a call is kept with those at no node of the instance's body, and found through
` the fact that names it.
. start U32 = call-fills.length as U32
for fill in fills
    call-fills += fill as ArgumentFill
. range = RowRange'ArgumentFill(start, fills.length as U32)
. fact = CallFact(instance, syntax, callee, form, range, is-partial)
. id FactId = calls.length as FactId
calls.append(fact)
chain-fact(call-lasts, call-priors, instance, id)
if links
    link-call(instance, syntax, id)
else
    add-loose-call(LooseFact(instance, id, true))
= id

────────────────────
+ do keep-steps RowRange'U32
    - places [U32]
    - getters [InstanceId]

` Keeps the places of the properties read from a receiver to what a property it delegates
` to holds, in the order they are read, each with the getter that answers it where the type
` stores no such property, which emission calls each time the way is read. With no getters
` given, they are set later.
. start U32 = steps.length as U32
for position in 0 .. < places.length
    steps += places[position]
    step-callees += if position < getters.length then getters[position] else no-instance
= RowRange'U32(start, places.length as U32)

────────────────────
+ do set-loop-place
    - instance InstanceId
    - loop SyntaxId
    - plan OperatorPlan
    - base U32

` Plans a loop over a container read where it is kept, with the expression evaluated once
` beside what the node's constant already names.
. kept U64
. found = constant-of(instance, loop)
if found != no-fact
    kept = constants[found].bits % 4294967296
. high U64 = base
set-constant(instance, loop, ConstantFact(kept + high * 4294967296, 0.0, null, false), plan)

────────────────────
+ loop-base U32
    - instance InstanceId
    - loop SyntaxId

` The expression a loop planned over a place evaluates once, none, or all bits set.
(constants[constant-of(instance, loop)].bits / 4294967296) as U32

