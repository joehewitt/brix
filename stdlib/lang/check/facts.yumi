────────────────────
_ do add-loose-call
    - loose LooseFact

` Records a call at a node its instance's body did not reserve.
. position = loose-calls.length
loose-calls.append(loose)
link-loose-call(position)

────────────────────
_ do link-loose-call
    - position Size

` Links a loose call to the one its instance recorded before it, as the last its instance made.
chain-fact(loose-call-lasts, loose-call-priors, loose-calls[position].instance, position as U32)

────────────────────
_ do chain-fact
    - lasts List'U32'ArenaBacking
    - priors List'U32'ArenaBacking
    - instance InstanceId
    - id U32

` Links the place of a fact to that of the one of its kind its instance recorded before it, as
` the last its instance made. Each holds one past the place, and zero for none.
. place = instance as Size
while lasts.length <= place
    lasts += 0
priors += lasts[place]
lasts[place] = id + 1

────────────────────
_ latest-of U32
    - lasts List'U32'ArenaBacking
    - instance InstanceId

` The place of the last fact of a kind an instance recorded, or no fact.
|? place >= lasts.length || lasts[place] == 0
    no-fact
??
    lasts[place] - 1

.. place = instance as Size

────────────────────
_ prior-of U32
    - priors List'U32'ArenaBacking
    - id U32

` The place of the fact of a kind the instance of one recorded before it, or no fact.
if prior == 0 then no-fact else prior - 1

.. prior = priors[id]

────────────────────
_ do link-call
    - instance InstanceId
    - syntax SyntaxId
    - id FactId

. slot = node-slot(instance, syntax)
if !slot
    add-loose-call(LooseFact(instance, id))
    =
. head = node-calls[slot]
if head == no-fact
    node-calls[slot] = id
    =
. cursor = head
while calls[cursor].next != no-fact
    cursor = calls[cursor].next
calls[cursor].next = id

────────────────────
_ do link-conversion
    - instance InstanceId
    - syntax SyntaxId
    - id FactId

. slot = node-slot(instance, syntax)
if !slot
    loose-conversions.append(LooseFact(instance, id))
    =
. tail = node-conversion-tails[slot]
if tail == no-fact
    node-conversions[slot] = id
else
    conversions[tail].next = id
node-conversion-tails[slot] = id

────────────────────
_ do link-force
    - instance InstanceId
    - syntax SyntaxId
    - id FactId

. slot = node-slot(instance, syntax)
if !slot
    loose-forces.append(LooseFact(instance, id))
    =
. head = node-forces[slot]
if head == no-fact
    node-forces[slot] = id
    =
. cursor = head
while forces[cursor].next != no-fact
    cursor = forces[cursor].next
forces[cursor].next = id

────────────────────
+ do record-force
    - instance InstanceId
    - syntax SyntaxId
    - operand TypeId
    - result TypeId
    - is-narrowed Bool

. id FactId = forces.length as FactId
forces.append(ForceFact(instance, syntax, operand, result, is-narrowed))
link-force(instance, syntax, id)

────────────────────
+ do record-diagnostic
    - instance InstanceId
    - module ModuleId
    - syntax SyntaxId
    - kind TypeDiagnosticKind
    - name Atom? = null
    - source TypeId = no-type
    - target TypeId = no-type

` A type's own declaration is checked where the type is first used, so what it gets wrong is
` recorded ahead of anything found afterwards.
if initializer
    initializer.initialize-classes()
diagnostics.append(TypeDiagnostic(instance, module, syntax, kind, name, source, target))

────────────────────
+ do mention-types
    - mentioned [TypeId]

. start = diagnostic-mentions.length as U32
diagnostic-mentions ++= mentioned
diagnostics[diagnostics.length - 1].mentions = RowRange'TypeId(start, mentioned.length as U32)

────────────────────
+ do note-members
    - members [DeclRef]

. start = diagnostic-members.length as U32
diagnostic-members ++= members
diagnostics[diagnostics.length - 1].members = RowRange'DeclRef(start, members.length as U32)

────────────────────
+ do inset-diagnostic
    - columns U32
    - width U32 = 0

` Starts the diagnostic just recorded some columns into its node: at the part of a literal
` it is about, or, given a `width`, at a part of that many columns that may run past it.
diagnostics[diagnostics.length - 1].inset = columns
diagnostics[diagnostics.length - 1].width = width

────────────────────
+ do relate-diagnostic
    - label Atom
    - module ModuleId
    - syntax SyntaxId

` Points the diagnostic just recorded at a second place in the source, under a label.
. last = diagnostics.length - 1
diagnostics[last].related-label = label
diagnostics[last].related-module = module
diagnostics[last].related-syntax = syntax

────────────────────
+ do restate
    - mark Size
    - instance InstanceId
    - syntax SyntaxId
    - from TypeDiagnosticKind
    - to TypeDiagnosticKind
    - message Atom? = null

` What an attempt reported at a place since a mark is said in the words of whoever made the
` attempt, who knows more about why it failed.
for position in mark .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if row.instance == instance && row.syntax == syntax && row.kind == from
        diagnostics[position].kind = to
        diagnostics[position].name = message

────────────────────
+ do has-diagnostic Bool
    - instance InstanceId

for row in diagnostics
    if row.instance == instance && row.kind != .not-supported
        = true
= false

────────────────────
+ do resite
    - mark Size
    - instance InstanceId
    - from SyntaxId
    - to SyntaxId

` What was reported at one place since a mark is reported at another: the whole expression a
` failed part of it belongs to.
for position in mark .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if row.instance == instance && row.syntax == from
        diagnostics[position].syntax = to

────────────────────
+ do declined-since Bool
    - mark Size
    - instance InstanceId

` Whether an instance was refused since a mark.
for position in mark .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if row.instance == instance && row.kind == .not-supported
        = true
= false

────────────────────
+ do drop-diagnostics Bool
    - mark Size
    - instance InstanceId

` Drops the diagnostics recorded for one instance since a mark, and says whether any were.
. kept = mark
for position in mark .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if row.instance != instance
        diagnostics[kept] = row
        kept += 1
. dropped = kept != diagnostics.length
diagnostics.truncate(kept)
= dropped

────────────────────
+ do drop-trial-diagnostics
    - mark Size
    - trial InstanceId

. kept = mark
for position in mark .. < diagnostics.length
    . row = diagnostics[position] as TypeDiagnostic
    if !written-in(row.instance, trial)
        diagnostics[kept] = row
        kept += 1
diagnostics.truncate(kept)

────────────────────
_ do written-in Bool
    - instance InstanceId
    - around InstanceId

. current = instance
while current != no-instance
    if current == around
        = true
    current = instances.rows[current].enclosing
= false

────────────────────
+ do record-witness-table
    - value TypeId
    - interface TypeId

key-scratch[0] = value
key-scratch[1] = interface
witness-keys.store(key-scratch.data, 2)
if witness-keys.last-inserted
    witness-tables.append(WitnessTable(value, interface))

────────────────────
+ do record-dynamic-witness
    - value TypeId
    - interface TypeId

` A class cast to an interface it does not declare, which classes declared below it do: the
` table of the class keeps a slot for the interface, which holds the table of each class
` below it that has one, and nothing for the others.
for row in dynamic-witnesses
    if row.value == value && row.interface == interface
        =
dynamic-witnesses.append(WitnessTable(value, interface))

────────────────────
+ do equality-of InstanceId
    - value TypeId
    - interface TypeId

` The comparison the function a type's table for an interface holds for equality runs, or
` none where the table holds none.
key-scratch[0] = value
key-scratch[1] = interface
. found = witness-keys.find(key-scratch.data, 2)
= if found then witness-tables[found].equality else no-instance

────────────────────
+ do record-witness-func
    - interface TypeId
    - module ModuleId
    - decl DeclId

key-scratch[0] = interface
key-scratch[1] = module
key-scratch[2] = decl
witness-func-keys.store(key-scratch.data, 3)
if witness-func-keys.last-inserted
    witness-funcs.append(WitnessFunc(interface, module, decl))

────────────────────
+ do record-witness-call
    - receiver TypeId
    - module ModuleId
    - decl DeclId

` Notes that a call through a value of the interface `receiver` has been dispatched to a function
` it or an interface it is derived from declares (`record-witness-proto`).
key-scratch[0] = receiver
key-scratch[1] = module
key-scratch[2] = decl
witness-call-keys.store(key-scratch.data, 3)
if witness-call-keys.last-inserted
    witness-calls.append(WitnessFunc(receiver, module, decl))

────────────────────
+ do record-witness-proto
    - proto InstanceId

` Notes an instance of an interface's function that a call names, where a call through a
` value of the interface has been dispatched to the function (`record-witness-call`): it has a
` slot of its own in the interface's witness tables.
. row = instances.rows[proto]
key-scratch[0] = row.self-type
key-scratch[1] = row.module
key-scratch[2] = row.decl
if !witness-call-keys.find(key-scratch.data, 3)
    =
key-scratch[0] = no-type
key-scratch[1] = proto
witness-slot-keys.store(key-scratch.data, 2)
if witness-slot-keys.last-inserted
    witness-protos += proto

────────────────────
+ do record-witness-slot
    - value TypeId
    - proto InstanceId
    - callee InstanceId
    - property U32 = U32.max
    - through RowRange'U32 = RowRange'U32()
    - based Bool = false
    - converts Bool = false

key-scratch[0] = value
key-scratch[1] = proto
key-scratch[2] = 1
witness-slot-keys.store(key-scratch.data, if based then 3 else 2)
if witness-slot-keys.last-inserted
    witness-slots.append(WitnessSlot(value, proto, callee, property, through, based, converts))

────────────────────
+ do absorb
    - peer Facts
    - ids PeerIds

` Takes in what another type pass over the program recorded: every fact of each instance this
` pass takes from it (`PeerIds.owns`), and each fact that no one instance owns and this pass
` lacks, once. A fact of an instance this pass does not take from the peer is left: the pass that
` owns the instance holds it. The peer's call and transform facts are numbered here in
` `PeerIds.calls` and `PeerIds.transforms`. What `unshared-weight` counts is left: the instances
` whose typing changed it are typed again here.
. call-ids [FactId]
. next-call FactId = calls.length as FactId
for row in peer.calls
    call-ids += if ids.owns(row.instance) then next-call else no-fact
    next-call += (if ids.owns(row.instance) then 1 else 0) as FactId
. keyed = peer.keyed-conversions()
. conversion-ids [FactId]
. next-conversion FactId = conversions.length as FactId
for position in 0 .. < peer.conversions.length
    . taken = !keyed[position] && ids.owns(peer.conversions[position].instance)
    conversion-ids += if taken then next-conversion else no-fact
    next-conversion += (if taken then 1 else 0) as FactId
. force-ids [FactId]
. next-force FactId = forces.length as FactId
for row in peer.forces
    force-ids += if ids.owns(row.instance) then next-force else no-fact
    next-force += (if ids.owns(row.instance) then 1 else 0) as FactId
. transform-ids [U32]
. next-transform U32 = transforms.length as U32
for row in peer.transforms
    transform-ids += if ids.owns(row.instance) then next-transform else U32.max
    next-transform += (if ids.owns(row.instance) then 1 else 0) as U32
ids.calls = call-ids
ids.transforms = transform-ids
absorb-calls(peer, ids, call-ids)
absorb-conversions(peer, ids, keyed, conversion-ids)
absorb-forces(peer, ids, force-ids)
absorb-transforms(peer, ids, transform-ids)
absorb-nodes(peer, ids, call-ids, conversion-ids, force-ids)
absorb-keyed-conversions(peer, ids, keyed)
absorb-owned(peer, ids, call-ids, conversion-ids, force-ids)
. domains = absorb-domains(peer)
. sheets = absorb-sheets(peer, ids, domains)
. sheeted = PeerSheets
    - sheets
    - unmoved-rows(peer.style-projections.length)
    - unmoved-rows(peer.style-themed-values.length)
. applications = absorb-applications(peer, ids, sheets)
absorb-themes(peer, ids, sheeted, applications)
absorb-style-runtime(peer, ids)
absorb-rules(peer, ids, call-ids)
absorb-shared(peer, ids)
absorb-places(peer, ids, call-ids)
absorb-styles(peer, ids, domains, sheeted)
. events = event-uses.length
absorb-markup(peer, ids, call-ids, conversion-ids)
absorb-plans(peer, ids)
absorb-machines(peer, ids, call-ids, events)

