| table-extend = 13
| table-truncate = 14
| table-clear = 15
| table-copy-from = 16
| table-finish = 17
| table-rewind = 18
| table-storage-checkpoint = 19
| table-validate-restore = 20
| table-restore-storage = 21
| table-mark = 22
| table-capacity = 23
| table-select = 24
| span-item = 25
| span-range = 26
| selection-row = 27
| selection-range = 28
| table-view = 29
| table-layout = 30
| proven-row = 31

