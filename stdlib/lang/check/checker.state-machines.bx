(import ./binding)
(import ./calls)
(import ./checker)
(import ./checker.live-actions)
(import ./checker.loops)
(import ./checker.match-arms)
(import ./checker.streams)
(import ./checker.styles)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ StateMachines (facet-of Checker)
  (sees LiveActions)
  (sees Loops)
  (sees MatchArms)
  (sees Streams)
  (sees Styles)
  (prop _ machine-handed _ (= false))
  (fn-do + check-machine-site TypeId
    (param id SyntaxId)
    ; A state machine where it is written: its own function, typed once, is called there to start
    ; it, recorded at the machine, and answers the value it starts in, of the machine's union. The
    ; errors that leave its start leave the function there (see `check-machine`). A machine the
    ; binder bound no function for has no shape here.
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (call decline id)
      (return invalid-type)
    )
    (let callee (call demand-nested decl no-type))
    (do
      (inline (call (. facts record-call) instance id callee .call-function (. scratch no-fills) false))
    )
    (call note-unit-errors callee id)
    (let machine (call (. facts machine-of) callee))
    (return (if-expr machine (. (call (. facts root-machine) machine) union) invalid-type))
  )
  (fn-do + check-machine _
    (param id SyntaxId)
    ; The function of a state machine, typed as one body though the emitter makes several functions
    ; of it: the one that starts it, and for each group of event transitions the one its
    ; subscriber runs. Its shape is checked first (`machine-shape`), then each part is typed once,
    ; in an order where what it reads is known (`type-machine`). It answers its union where it
    ; starts. One that refines the machine of a property of its class's base answers nothing: that
    ; machine starts after it, and keeps the value (`inherited-machine`).
    (call prepare)
    (let items (call (. tree state-items) (call (. tree state-body) id)))
    (let row (call (. bindings machine-slots) module id))
    (let store (only-if (call machine-placement id row) (if row)))
    (let union no-type)
    (= machine-handed false)
    (= machining (= (. machining outer-starts) true))
    (= machining (= (. machining refined) no-instance))
    (let refined (only-if (call inherited-machine id items store) (if (and row store))))
    (if (or (not row) (not store))
      (call decline id)
      (else-if refined
        (= machining (= (. machining refined) refined))
        (if (call machine-shape id items store)
          (= union (call type-machine id items row store))
        )
      )
    )
    (let answered (if-expr (and (!= union no-type) (== (. machining refined) no-instance)) union (. types void-type)))
    (call (. instances set-returns) instance answered answered .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ inherited-machine (? InstanceId)
    (param id SyntaxId)
    (param items (list SyntaxId))
    (param store MachineStore)
    ; The machine a property's machine refines, as the reference merges them: that of the property
    ; of the same name of the base of the class, through the instance that types the base's value
    ; for the class that declares it, as the class the machine is typed for holds it, which every
    ; class below shares, where the base has one; no instance where it has none, or the machine
    ; is no property's. A
    ; property of that name that holds no machine is the reference's error, as is a refinement that
    ; changes what the reference forbids (`refines-shaped`). One a class's markup writes refines that
    ; of the markup of a class above (`inherited-content-machine`).
    (if (== store .store-content)
      (return (call inherited-content-machine id items))
    )
    (if (!= store .store-member)
      (return no-instance)
    )
    (let property (call machine-property id))
    (let decls (. ([] (. program modules) module) decls))
    (let name (? Atom) null)
    (let owner-decl DeclId 0)
    (let site id)
    (match? ([] decls property)
      (case (call .decl-property found)
        (= name (. found name))
        (= owner-decl (. found owner))
        (= site (. found syntax))
      )
    )
    (if (or (not name) (== owner-decl 0))
      (return no-instance)
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module owner-decl mark))
    (if (== owner invalid-type)
      (return no-instance)
    )
    (call (. types complete) owner)
    (let base (?? (call (. types base-of) owner) no-type))
    (let place (only-if (call property-named base name) (if (!= base no-type))))
    (if (not place)
      (return no-instance)
    )
    (let level (. ([] (. types properties) place) owner))
    (let ref (call class-ref types level))
    (let inherited (call class-property ref name))
    (let value (call declared-value (. ref module) inherited))
    (let machine (call (. ([] (. program modules) (. ref module)) tree declared-machine) value))
    (if (== machine 0)
      (let message (str "Inherited property '" (. name text) "' is not a state machine"))
      (call (. frame diagnose) site .stated (call (. program store-atom) message))
      (return null)
    )
    (let enclosing (. ([] (. instances rows) instance) enclosing))
    (let receiver
      (scope (if-expr (!= enclosing no-instance) (call holding-type enclosing-self ref) level)
        (lazy enclosing-self (. ([] (. instances rows) enclosing) self-type))
      )
    )
    (let unit (call (. instances intern-initializer) (. ref module) inherited receiver))
    (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
      (call decline id)
      (return null)
    )
    (call demand-own-body unit)
    (for (in found (. facts machines))
      (let same (and (== (. found module) (. ref module)) (== (. found syntax) machine) (== (. found outer) 0)))
      (if (and same (== (. ([] (. instances rows) (. found instance)) enclosing) unit))
        (let names (list Atom))
        (let parents (list U32))
        (call inherited-cases found names parents)
        (if (not (call refines-shaped items (. U32 max) names parents))
          (return null)
        )
        (return (. found instance))
      )
    )
    (call decline id)
    (return null)
  )
  (fn-do _ inherited-content-machine (? InstanceId)
    (param id SyntaxId)
    (param items (list SyntaxId))
    ; The machine a machine written as a line of a class's markup refines, as a property's machine
    ; refines its base's: the first machine of the markup of a class above, from the nearest up,
    ; that has a case at its root of a name one of this machine's cases at its root has, through
    ; the function that fills the object with that class's markup, which the function this machine
    ; is written in runs; no instance where none has. A refinement that changes what the reference
    ; forbids is its error (`refines-shaped`).
    (let roots (list Atom))
    (for (in item items)
      (if (is ([] (. tree nodes) item) .node-state-case)
        (+= roots (!! (call (. tree state-name) item)))
      )
    )
    (let fill (. ([] (. instances rows) instance) enclosing))
    (while (!= fill no-instance)
      (let call (call (. facts filler-of) fill))
      (if (== call no-fact)
        (return no-instance)
      )
      (= fill (. ([] (. facts calls) call) callee))
      (let level (. ([] (. instances rows) fill) self-type))
      (if (or (== level no-type) (== level invalid-type))
        (return no-instance)
      )
      (let ref (call class-ref types level))
      (let owner (. ([] (. program modules) (. ref module)) tree))
      (let content SyntaxId 0)
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (= content (. class content))
        )
      )
      (for (in machine (call (. owner content-machines) content))
        (if (call (. owner names-root) machine roots)
          (if (== (. ([] (. instances rows) fill) state) .instance-in-progress)
            (call decline id)
            (return null)
          )
          (call demand-own-body fill)
          (for (in found (. facts machines))
            (let same (and (== (. found module) (. ref module)) (== (. found syntax) machine) (== (. found outer) 0)))
            (if (and same (== (. ([] (. instances rows) (. found instance)) enclosing) fill))
              (let names (list Atom))
              (let parents (list U32))
              (call inherited-cases found names parents)
              (if (not (call refines-shaped items (. U32 max) names parents))
                (return null)
              )
              (return (. found instance))
            )
          )
          (call decline id)
          (return null)
        )
      )
    )
    (return no-instance)
  )
  (fn-do _ inherited-cases _
    (param machine MachineFact)
    (param names (list Atom))
    (param parents (list U32))
    ; The cases a machine has, each with the place of the case it is written in, or none at the
    ; root: those written in it, and where it refines another machine, those of that machine with
    ; the ones it adds.
    (let owner (. ([] (. program modules) (. machine module)) tree))
    (let items (call (. owner state-items) (call (. owner state-body) (. machine syntax))))
    (if (== (. machine refined) no-instance)
      (call written-cases owner items (. U32 max) names parents)
      (return)
    )
    (let above (call (. facts machine-of) (. machine refined)))
    (if (not above)
      (return)
    )
    (call inherited-cases above names parents)
    (call added-cases owner items (. U32 max) names parents)
  )
  (fn-do _ written-cases _
    (param owner AST)
    (param items (list SyntaxId))
    (param parent U32)
    (param names (list Atom))
    (param parents (list U32))
    ; Each case written in a body and in theirs, under the case at a place.
    (for (in item items)
      (if (is ([] (. owner nodes) item) .node-state-case)
        (let place (as (. names length) U32))
        (+= names (!! (call (. owner state-name) item)))
        (+= parents parent)
        (call written-cases owner (call (. owner state-items) (call (. owner state-body) item)) place names parents)
      )
    )
  )
  (fn-do _ added-cases _
    (param owner AST)
    (param items (list SyntaxId))
    (param parent U32)
    (param names (list Atom))
    (param parents (list U32))
    ; The cases a refinement's body adds under the case at a place: one it names again is refined,
    ; and adds those of its own body; any other is added with each case written in it.
    (for (in item items)
      (if (is ([] (. owner nodes) item) .node-state-case)
        (let found (call case-under (!! (call (. owner state-name) item)) parent names parents))
        (if (!= found (. U32 max))
          (call added-cases owner (call (. owner state-items) (call (. owner state-body) item)) found names parents)
          (else
            (let place (as (. names length) U32))
            (+= names (!! (call (. owner state-name) item)))
            (+= parents parent)
            (call written-cases owner (call (. owner state-items) (call (. owner state-body) item)) place names parents)
          )
        )
      )
    )
  )
  (fn-do _ refines-shaped Bool
    (param items (list SyntaxId))
    (param parent U32)
    (param names (list Atom))
    (param parents (list U32))
    ; Whether a refinement's body changes only what the reference lets it, under the case of the
    ; inherited machine at a place: each case it names again keeps that case's trigger and what it
    ; holds, and each case it adds is written under a case, with a name the inherited machine does
    ; not use. Anything but a case written at the root has no shape here yet.
    (for (in item items)
      (if (not (is ([] (. tree nodes) item) .node-state-case))
        (if (== parent (. U32 max))
          (call decline item)
          (return false)
        )
        (continue)
      )
      (let name (!! (call (. tree state-name) item)))
      (let found (call case-under name parent names parents))
      (if (== found (. U32 max))
        (if (!= (call (. names find) name) null)
          (let message (str "State case '" (. name text) "' is declared elsewhere in the inherited machine"))
          (call (. frame diagnose) item .stated (call (. program store-atom) message))
          (return false)
        )
        (if (== parent (. U32 max))
          (let message (str "Refinement cannot add top-level state case '" (. name text) "'"))
          (call (. frame diagnose) item .stated (call (. program store-atom) message))
          (return false)
        )
        (continue)
      )
      (if (or (!= (. (call (. tree state-targets) item) count) 0) (!= (call (. tree state-trigger) item) 0))
        (let message (str "Refined state case '" (. name text) "' cannot change its trigger or payload"))
        (call (. frame diagnose) item .stated (call (. program store-atom) message))
        (return false)
      )
      (if (not (call refines-shaped (call (. tree state-items) (call (. tree state-body) item)) found names parents))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ machine-placement (? MachineStore)
    (param id SyntaxId)
    (param row MachineSlots)
    ; Where a machine keeps its value: in the local or the lazy local it is declared into, which
    ; starts it where it is first read, in the global of the module or the property of the class it
    ; is the value of, in the flags of the object whose markup it is a line of, or nowhere, written
    ; as a statement of a function that is no markup of a class. One written in the markup of a
    ; class otherwise has no shape here yet.
    (if (!= (. row bound) no-slot)
      (let kind (. ([] (. bindings slots) (. row bound)) kind))
      (return (only-if .store-local (if (or (== kind .slot-local) (== kind .slot-lazy)))))
    )
    (let property (call machine-property id))
    (if (!= property 0)
      (match? ([] (. ([] (. program modules) module) decls) property)
        (case (call .decl-property found)
          (return (if-expr (== (. found owner) 0) .store-global .store-member))
        )
      )
      (return null)
    )
    (let owner (. frame outer))
    (if (and owner (. owner declaration is-content))
      (return (only-if .store-content (if (!= (call (. (call (. tree content-machines) (. owner declaration syntax)) find) id) null))))
    )
    (return .store-none)
  )
  (fn-do _ machine-property DeclId
    (param id SyntaxId)
    ; The property of the module whose value a machine is, or none.
    (let decls (. ([] (. program modules) module) decls))
    (for (in position (..< 0 (. decls length)))
      (match? ([] decls position)
        (case (call .decl-property property)
          (if (== (. property value) id)
            (return (as position DeclId))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ machine-shape Bool
    (param id SyntaxId)
    (param items (list SyntaxId))
    (param store MachineStore)
    ; Whether a machine is one the reference builds: no case is written twice, each fallback
    ; follows a group of transitions, each case's rows but its lazies come before its cases and
    ; transitions (`statements-lead`), no decision made on entry enters a case again
    ; (`entries-settle`), and one a local, a global or a property names starts in a case. Each is
    ; the reference's error. A fallback that names values, and a case of a machine of a class's
    ; markup whose name the class declares otherwise, have no shape here yet.
    (let redefined (call (. tree redefined-case) items))
    (if (!= redefined 0)
      (let name (!! (call (. tree state-name) redefined)))
      (call (. frame diagnose)
        (block
          (arg redefined)
          (arg .stated)
          (arg (call (. program store-atom) (str "Redefinition of state case '" (. name text) "'")))
        )
      )
      (return false)
    )
    (let misplaced (call (. tree misplaced-fallback) items))
    (if (!= misplaced 0)
      (call (. frame diagnose) misplaced .stated (call (. program store-atom) "State fallback has no transition group"))
      (return false)
    )
    (if (or (not (call statements-lead items)) (not (call entries-settle items)))
      (return false)
    )
    (if (and stored-machine (== (call (. tree initial-case) items) 0) (!= (. items length) 0))
      (call (. frame diagnose) ([] items 0) .stated (call (. program store-atom) "State machine has no initial state"))
      (return false)
    )
    (lazy stored-machine (and (!= store .store-none) (!= store .store-content)))
    (if (== store .store-content)
      (for (in node (call (. tree machine-cases) items))
        (if (not (call flagged node))
          (let name (call (. tree state-name) node))
          (let shown (if-expr name (. name text) ""))
          (let message
            (paragraph
              (str "A case of a machine in a class's markup is read as a property of its name, and the class declares \"" shown "\" already; rename the case or the property")
            )
          )
          (call (. frame diagnose) node .stated (call (. program store-atom) message))
          (return false)
        )
      )
    )
    (let unbuilt (call unbuilt-part items))
    (if (!= unbuilt 0)
      (call decline unbuilt)
      (return false)
    )
    (return true)
  )
  (fn-do _ entries-settle Bool
    (param items (list SyntaxId))
    ; Whether the decisions made where a machine's cases are entered, with no trigger, never enter a
    ; case again, as the reference checks them from its first case and from each case written in
    ; it. Where one does, it is the reference's error at the decision.
    (let roots (list SyntaxId))
    (let initial (call entered-case 0 items))
    (if (!= initial 0)
      (+= roots initial)
    )
    (for (in node (call (. tree explicit-cases) items))
      (+= roots node)
    )
    (for (in root roots)
      (let entering (list SyntaxId))
      (+= entering root)
      (if (not (call case-entries-settle items entering root 0))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ case-entries-settle Bool
    (param items (list SyntaxId))
    (param entering (list SyntaxId))
    (param node SyntaxId)
    (param decision SyntaxId)
    ; Whether the decisions made where a case is entered, past the cases already `entering`, enter
    ; none of them again: each immediate transition of its body, up to one with no trigger, which
    ; always passes, and its first case, entered by the decision that led to the case.
    (let body (call (. tree state-items) (call (. tree state-body) node)))
    (for (in transition (call (. tree immediate-transitions) body))
      (if (not (call enter-decided items entering (call (. tree immediate-path) items node transition) transition))
        (return false)
      )
      (if (== (call (. tree state-trigger) transition) 0)
        (return true)
      )
    )
    (let initial (call entered-case node body))
    (if (== initial 0)
      (return true)
    )
    (let path (list SyntaxId))
    (+= path initial)
    (return (call enter-decided items entering path decision))
  )
  (fn-do _ enter-decided Bool
    (param items (list SyntaxId))
    (param entering (list SyntaxId))
    (param path (list SyntaxId))
    (param decision SyntaxId)
    ; Whether entering the cases of a path by a decision enters none of the cases already
    ; `entering`, nor do the decisions made where its last case is entered.
    (let depth (. entering length))
    (for (in node path)
      (if (!= (call (. entering find) node) null)
        (let name (!! (call (. tree state-name) node)))
        (let message (str "Entry decisions loop back to '" (. name text) "' without a trigger"))
        (call (. frame diagnose)
          (block
            (arg (if-expr (!= decision 0) decision node))
            (arg .stated)
            (arg (call (. program store-atom) message))
          )
        )
        (return false)
      )
      (+= entering node)
    )
    (let settled (call case-entries-settle items entering ([] path (- (. path length) 1)) decision))
    (while (> (. entering length) depth)
      (call (. entering pop))
    )
    (return settled)
  )
  (fn-do _ statements-lead Bool
    (param items (list SyntaxId))
    (for (in item items)
      (if (not (call (. tree is-transition) item))
        (continue)
      )
      (let body (call (. tree state-items) (call (. tree state-body) item)))
      (if (not (call statements-lead body))
        (return false)
      )
      (if (not (is ([] (. tree nodes) item) .node-state-case))
        (continue)
      )
      (let declared false)
      (for (in row body)
        (if (or (call (. tree is-transition) row) (is ([] (. tree nodes) row) .node-state-fallback))
          (= declared true)
          (continue)
        )
        (match? ([] (. tree nodes) row)
          (case (call .node-declare declare)
            (if (. declare is-lazy)
              (continue)
            )
          )
        )
        (if declared
          (let message "A case's statements come before its cases and transitions, since they run first as it is entered; move this row above the first \"state\", \"then\" or \"else-state\"")
          (call (. frame diagnose) row .stated (call (. program store-atom) message))
          (return false)
        )
      )
    )
    (return true)
  )
  (fn-do + flagged Bool
    (param node SyntaxId)
    ; Whether the class declares the flag of a case of a machine its markup writes, or its projection.
    (for (in decl (. ([] (. program modules) module) decls))
      (match? decl
        (case (call .decl-property row)
          (if (or (== (. row flag) node) (== (. row projection) node))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ unbuilt-part SyntaxId
    (param items (list SyntaxId))
    ; The first part of a machine's bodies that has no shape here yet: a fallback that names values.
    (for (in item items)
      (if (and (is ([] (. tree nodes) item) .node-state-fallback) (!= (. (call (. tree state-targets) item) count) 0))
        (return item)
      )
      (if (call (. tree is-transition) item)
        (let inner (call unbuilt-part (call (. tree state-items) (call (. tree state-body) item))))
        (if (!= inner 0)
          (return inner)
        )
      )
    )
    (return 0)
  )
  (fn-do _ type-machine TypeId
    (param id SyntaxId)
    (param items (list SyntaxId))
    (param row MachineSlots)
    (param store MachineStore)
    (param outer SyntaxId (= 0))
    (param parent SyntaxId (= 0))
    ; Types a machine's parts, the root first, then each case and continuation once what its
    ; activation sees is known (`activation-known`); one that never is has no shape here. What each
    ; activation sees is foreseen first where it can be (`foresee-activations`), so that the parts
    ; can read the machine by its name (`early-union`). Then the machine's union is made, of each
    ; case it names with what that case holds, and what it keeps is typed, and each projection of a
    ; machine written as a statement: a case's flag, or its payload where it is active. What each
    ; transition gives is converted to what its case holds, and the machine is recorded, with the
    ; machine around it and the case it is written in where it is a named machine written in a case
    ; of another.
    (= machining (= (. machining store) store))
    (= machining (= (. machining syntax) id))
    (= machining (= (. machining items) items))
    (= machining (= (. machining cases) (call (. tree machine-cases) items)))
    (= machining (= (. machining kept) (call (. tree machine-captures) items (. machining cases))))
    (call (. machining payloads clear))
    (call (. machining kept-types clear))
    (call (. machining starts clear))
    (call (. machining typed clear))
    (call (. machining waiting clear))
    (call (. machining groups-found clear))
    (for (in position (..< 0 (. machining cases length)))
      (+= (. machining payloads) (call fixed-payload (as position U32)))
      (let unknown (list TypeId))
      (for (in _ ([] (. machining kept) position))
        (+= unknown no-type)
      )
      (+= (. machining kept-types) unknown)
    )
    (do
      (inline (call foresee-activations))
    )
    (call early-union id row store)
    (call note-starts 0 items)
    (call type-machine-body 0 items)
    (let progress true)
    (while progress
      (= progress false)
      (for (in position (..< 0 (. machining waiting length)))
        (let node ([] (. machining waiting) position))
        (if (and (!= node 0) (call activation-known node))
          (= ([] (. machining waiting) position) 0)
          (call type-machine-body node (call (. tree state-items) (call (. tree state-body) node)))
          (= progress true)
        )
      )
      (if (not progress)
        (= progress (call foresee-activations))
      )
    )
    (for (in node (. machining waiting))
      (if (!= node 0)
        (call decline node)
        (return no-type)
      )
    )
    (for (in payload (. machining payloads))
      (if (or (== payload no-type) (== payload invalid-type))
        (call decline id)
        (return no-type)
      )
    )
    (let union (call machine-union id row))
    (call type-machine-slots row union)
    (call type-projections id store)
    (call convert-targets)
    (let start (. facts machine-groups length))
    (for (in group (. machining groups-found))
      (call (. facts machine-groups append) group)
    )
    (let groups (call (of RowRange MachineGroup) (as start U32) (as (- (. facts machine-groups length) start) U32)))
    (let property (if-expr (or (== store .store-global) (== store .store-member)) (call machine-property id) 0))
    (let fact
      (call MachineFact
        (block
          (arg instance)
          (arg id)
          (arg union)
          (arg store)
          (arg module)
          (arg property)
          (arg groups)
          (arg outer)
          (arg parent)
          (arg (. machining refined))
        )
      )
    )
    (call (. facts machines append) fact)
    (if (and (or (== store .store-member) (== store .store-content)) (== outer 0) (== (. machining refined) no-instance))
      (call demand-machine-stops)
    )
    (return union)
  )
  (fn-do _ demand-task-owner _
    ; The constructor of the `TaskOwner` a case makes as it is entered, where its activation owns
    ; the tasks spawned for it.
    (if (or (!= (. facts task-owner-make) no-instance) (== (. types task-owner-type) invalid-type))
      (return)
    )
    (= (. facts task-owner-make) (call (. calls demand-constructor) (. types task-owner-type) (. scratch types mark)))
  )
  (fn-do _ demand-machine-stops _
    ; The event runtime's `event-own-machine`, which a machine a class's property holds or its markup
    ; writes gives what stops it as it starts, its `event-stop-machines`, which runs those of an
    ; object as the `close` of its class starts, and its `event-close-stopped`, which closes the
    ; object's events as that `close` leaves.
    (if (or (!= (. facts machine-stop) no-instance) (== (. types event-endpoint-decl module) 0))
      (return)
    )
    (let pointer (call pointer-to (call (. types type-row) .uint8)))
    (let mark (. scratch types mark))
    (call (. scratch types push) pointer)
    (let none (. scratch types mark))
    (call (. scratch types push) (call (. types intern-function) (. types void-type) false none none))
    (= (. facts machine-own)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-own-machine"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) pointer)
    (= (. facts machine-stop)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-stop-machines"))
          (arg mark)
        )
      )
    )
    (= (. facts machine-close)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-close-stopped"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
  )
  (fn-do _ early-union _
    (param id SyntaxId)
    (param row MachineSlots)
    (param store MachineStore)
    ; Where what every case holds is fixed or foreseen before anything is typed, the machine's union
    ; is made first, so that its cases can read the machine by its name: the local or the lazy local
    ; it is kept in, the module's or the class's property it is, or the name a named machine written
    ; in a case of another declares. Elsewhere such a read waits for the union and has no shape here.
    ; A machine that refines another is read as the union of the machine none refines, made already.
    (if (!= (. machining refined) no-instance)
      (let above (call (. facts machine-of) (. machining refined)))
      (if above
        (call (. facts early-unions append) (call EarlyUnion instance module id (. (call (. facts root-machine) above) union)))
      )
      (return)
    )
    (for (in payload (. machining payloads))
      (if (== payload no-type)
        (return)
      )
    )
    (let union (call machine-union id row))
    (if (and (!= (. row bound) no-slot) (== store .store-local) (. frame outer))
      (call (. frame outer assign) (. row bound) union)
      (else-if (and (!= (. row bound) no-slot) (== store .store-nested))
        (call (. frame assign) (. row bound) union)
      )
      (else-if (or (== store .store-global) (== store .store-member))
        (call (. facts early-unions append) (call EarlyUnion instance module id union))
      )
    )
  )
  (fn-expr _ fixed-payload TypeId
    (param position U32)
    ; What a case holds where that is known before anything is typed: nothing where nothing names
    ; it with values; `U8` where the source of its payload gives none (`gives-nothing`), as the
    ; reference falls back to. Otherwise no type, until its source is typed (`settle-payload`), with
    ; or without a trigger.
    (case? (not source)
      (. types void-type)
    )
    (case? (call (. tree gives-nothing) source)
      (call (. types type-row) .uint8)
    )
    (default
      no-type
    )
    (where
      (lazy source (call (. tree payload-source) (. machining items) (!! (call (. tree state-name) ([] (. machining cases) position)))))
    )
  )
  (fn-do _ foresee-activations Bool
    ; Settles what the activation of each case sees before the machine's parts are typed, and
    ; again where no case or continuation waiting is known, as the reference infers it apart from
    ; where anything fires: what each case holds, from the source of its payload that nothing has
    ; typed, and each name it keeps, from each transition that enters it, each transition typed on
    ; trial (`foresee-in`), until nothing more settles. Whether anything is settled so.
    (let sources (list SyntaxId))
    (let unsettled false)
    (for (in position (..< 0 (. machining cases length)))
      (let source SyntaxId 0)
      (if (== ([] (. machining payloads) position) no-type)
        (let found (call (. tree payload-source) (. machining items) (!! (call (. tree state-name) ([] (. machining cases) position)))))
        (if (and found (== (call (. machining typed find) (. found node)) null))
          (= source (. found node))
        )
      )
      (+= sources source)
      (if (or (!= source 0) (!= (call (. ([] (. machining kept-types) position) find) no-type) null))
        (= unsettled true)
      )
    )
    (if (not unsettled)
      (return false)
    )
    (let settled false)
    (let chain (list SyntaxId))
    (while (call foresee-in (. machining items) chain sources)
      (= settled true)
    )
    (return settled)
  )
  (fn-do _ foresee-in Bool
    (param items (list SyntaxId))
    (param chain (list SyntaxId))
    (param sources (list SyntaxId))
    ; The transitions written among a body's items and in their bodies, each with the cases and
    ; continuations whose bodies it is written in, outermost first (`foresee-entry`). Whether
    ; anything is settled so.
    (let settled false)
    (for (in item items)
      (if (not (call (. tree is-transition) item))
        (continue)
      )
      (if (call foresee-entry item items chain sources)
        (= settled true)
      )
      (+= chain item)
      (if (call foresee-in (call (. tree state-items) (call (. tree state-body) item)) chain sources)
        (= settled true)
      )
      (call (. chain pop))
    )
    (return settled)
  )
  (fn-do _ foresee-entry Bool
    (param transition SyntaxId)
    (param items (list SyntaxId))
    (param chain (list SyntaxId))
    (param sources (list SyntaxId))
    ; A transition typed on trial where something of the case it enters is unsettled
    ; (`trial-transition`), with the names the activations around it see where they are known
    ; (`activation-names`): each name the case keeps that it reads there takes the type it has
    ; there, and what the case holds, where the transition is the source of its payload, is what it
    ; gives, or a tuple of them. Whether either is settled so.
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) transition))))
    (if (== position null)
      (return false)
    )
    (let sourced (and (== ([] sources position) transition) (== ([] (. machining payloads) position) no-type)))
    (let places (list Size))
    (let wanted (list SlotId))
    (if (!= (call (. ([] (. machining kept-types) position) find) no-type) null)
      (for (in read (. bindings machine-reads))
        (if (or (!= (. read module) module) (!= (. read site) transition) (== (. read slot) no-slot))
          (continue)
        )
        (let place (call (. ([] (. machining kept) position) find) (. read name)))
        (if (and (!= place null) (== ([] ([] (. machining kept-types) position) place) no-type))
          (+= places place)
          (+= wanted (. read slot))
        )
      )
    )
    (if (and (== (. wanted length) 0) (not sourced))
      (return false)
    )
    (let slots (list SlotId))
    (let given (list TypeId))
    (for (in part chain)
      (call activation-names part slots given)
    )
    (let found (list TypeId))
    (let targets (list TypeId))
    (call trial-transition transition items slots given wanted found targets)
    (let settled false)
    (if (== (. found length) (. wanted length))
      (for (in offset (..< 0 (. wanted length)))
        (if (and (!= ([] found offset) no-type) (!= ([] found offset) invalid-type))
          (= ([] ([] (. machining kept-types) position) ([] places offset)) ([] found offset))
          (= settled true)
        )
      )
    )
    (if (or (not sourced) (== (. targets length) 0))
      (return settled)
    )
    (for (in target targets)
      (if (or (== target no-type) (== target invalid-type))
        (return settled)
      )
    )
    (call settle-given position targets)
    (return true)
  )
  (fn-do _ note-starts _
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; The cases and continuations a body enters as it is entered, and so as the machine starts:
    ; its first case and those its immediate transitions enter, and so on in each of theirs.
    (let initial (call entered-case owner items))
    (if (!= initial 0)
      (call note-start initial)
    )
    (for (in transition (call (. tree immediate-transitions) items))
      (call note-start transition)
    )
  )
  (fn-do _ note-start _
    (param node SyntaxId)
    (if (!= (call (. machining starts find) node) null)
      (return)
    )
    (+= (. machining starts) node)
    (if (is ([] (. tree nodes) node) .node-state-continuation)
      (let target (call (. tree find-case) (. machining items) (!! (call (. tree state-name) node))))
      (if (!= target 0)
        (call note-start target)
        (return)
      )
    )
    (call note-starts node (call (. tree state-items) (call (. tree state-body) node)))
  )
  (fn-do _ activation-known Bool
    (param node SyntaxId)
    ; Whether what the activation of a case or a continuation sees is known: what the case it
    ; enters holds and each name it keeps.
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    (if (== position null)
      (return true)
    )
    (if (== ([] (. machining payloads) position) no-type)
      (return false)
    )
    (for (in type ([] (. machining kept-types) position))
      (if (== type no-type)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ type-machine-body _
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; One body of a machine: the root, a case or a continuation. The names its activation sees take
    ; their types (`bind-activation`), its entry statements are typed, then what runs once they
    ; have (`type-entered`), the functions of its groups (`type-handlers`), and its `do finally`
    ; blocks, each in a region of its own, which no narrowing leaves. Its cases and continuations
    ; wait their turn. What leaves a part only a handler runs is no error of the function
    ; (`hand-off-since`). A named machine among its entry statements is typed where it is written
    ; (`type-nested-machine`).
    (let starts (and (. machining outer-starts) (or (== owner 0) (!= (call (. machining starts find) owner) null))))
    (let mark (. scratch outgoing mark))
    (let narrowed (. scratch narrowings mark))
    (if (!= owner 0)
      (call bind-activation owner)
      (for (in item items)
        (if (!= (call (. tree nested-machine) item) 0)
          (call type-nested-machine owner item starts)
          (else-if (call (. tree is-entry-item) item)
            (do
              (inline (call check-statement item))
            )
          )
        )
      )
    )
    (call type-entered owner items)
    (call end-machine-region narrowed)
    (call hand-off-since mark starts)
    (let handlers (. scratch outgoing mark))
    (call type-handlers owner items)
    (call end-machine-region narrowed)
    (call hand-off-since handlers false)
    (let exits (. scratch outgoing mark))
    (if (!= owner 0)
      (for (in item items)
        (if (is ([] (. tree nodes) item) .node-do-finally-block)
          (do
            (inline (call check-statement item))
          )
        )
      )
    )
    (call end-machine-region narrowed)
    (call hand-off-since exits starts)
    (for (in item items)
      (if (call (. tree is-transition) item)
        (+= (. machining waiting) item)
      )
    )
  )
  (fn-do _ type-nested-machine _
    (param parent SyntaxId)
    (param item SyntaxId)
    (param starts Bool)
    ; A named machine written in a case of the machine being typed, part of its function, as the
    ; reference builds it: typed as a machine is, while what is known of the machine around it is
    ; put aside, and recorded with that machine and the case. Its parts start with the machine
    ; around it where the case does. It is the reference's error that it has no first case.
    (let machine (call (. tree nested-machine) item))
    (let row (call (. bindings machine-slots) module machine))
    (if (not row)
      (call decline item)
      (return)
    )
    (let own machining)
    (let fresh-payloads (list TypeId))
    (let fresh-kept-types (list (list TypeId)))
    (let fresh-starts (list SyntaxId))
    (let fresh-typed (list SyntaxId))
    (let fresh-waiting (list SyntaxId))
    (let fresh-found (list MachineGroup))
    (= machining
      (call Machining
        (block
          (arg (. own syntax))
          (arg (. own store))
          (arg no-instance)
          (arg (call (. tree nested-machine-name) item))
          (arg starts)
          (arg (. own items))
          (arg (. own cases))
          (arg (. own kept))
          (arg fresh-payloads)
          (arg fresh-kept-types)
          (arg fresh-starts)
          (arg fresh-typed)
          (arg fresh-waiting)
          (arg fresh-found)
        )
      )
    )
    (let nested (call (. tree state-items) (call (. tree state-body) machine)))
    (if (call machine-shape machine nested .store-nested)
      (do
        (inline (call type-machine machine nested row .store-nested (. own syntax) parent))
      )
    )
    (= machining own)
  )
  (fn-do _ end-machine-region _
    (param mark ScratchMark)
    ; Ends a part of a machine, which runs where others may not have: what the flow knew in it
    ; holds no longer.
    (call (. frame pop-narrowing) mark)
    (call (. frame doubt-members))
  )
  (fn-do _ hand-off-since _
    (param mark ScratchMark)
    (param starts Bool)
    ; What leaves a part of a machine since a mark. A handler gives each error that leaves it to the
    ; global `unhandled-error` (see `hands-off`), typed once for the machine, as the reference's
    ; handlers do; the errors of a part only a handler runs then leave nothing, and those of a part
    ; that runs as the machine starts leave its function too. A call there whose callee's errors are
    ; not yet known lets them out all the same, to where the handler gives them.
    (if (== (. scratch outgoing mark) mark)
      (return)
    )
    (if (not machine-handed)
      (= machine-handed true)
      (if (not (call hands-off instance))
        (call decline (. frame declaration syntax))
      )
    )
    (if (not starts)
      (for (in row (call (. scratch outgoing since) mark))
        (if (!= (. row call) (. U32 max))
          (= (. ([] (. facts calls) (. row call)) propagates) true)
        )
      )
      (call (. scratch outgoing rewind) mark)
    )
  )
  (fn-do _ bind-activation _
    (param node SyntaxId)
    ; The names a case's or a continuation's activation sees take their types
    ; (`activation-names`).
    (let slots (list SlotId))
    (let given (list TypeId))
    (call activation-names node slots given)
    (for (in offset (..< 0 (. slots length)))
      (call (. frame assign) ([] slots offset) ([] given offset))
    )
  )
  (fn-do _ activation-names _
    (param node SyntaxId)
    (param slots (list SlotId))
    (param given (list TypeId))
    ; The names a case's or a continuation's activation sees, as the reference binds them, each
    ; added to `slots` with its type added to `given`: a name among what it gives takes the part of
    ; what the case holds in its place, where that is known, and a name the case keeps what it
    ; keeps.
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    (if (== position null)
      (return)
    )
    (let payload ([] (. machining payloads) position))
    (let targets (call (. tree state-targets) node))
    (let offset 0u32)
    (for (in target ([] (. tree children) targets))
      (match? ([] (. tree nodes) target)
        (case (call .node-identifier named)
          (let slot (call (. bindings declared-at) (. frame slots) node (. named name)))
          (let part
            (scope (if-expr whole-payload payload (call payload-part payload offset))
              (lazy whole-payload (or (== (. targets count) 1) (== payload no-type)))
            )
          )
          (if (and (!= slot no-slot) (!= part no-type))
            (+= slots slot)
            (+= given part)
          )
        )
      )
      (+= offset 1)
    )
    (let kept ([] (. machining kept) position))
    (let names (list Atom))
    (call (. tree target-names) node names)
    (for (in place (..< 0 (. kept length)))
      (let slot (call (. bindings declared-at) (. frame slots) node ([] kept place)))
      (if (and (!= slot no-slot) (== (call (. names find) ([] kept place)) null))
        (+= slots slot)
        (+= given ([] ([] (. machining kept-types) position) place))
      )
    )
  )
  (fn-expr _ payload-part TypeId
    (param payload TypeId)
    (param offset U32)
    ; The part of a case's payload in a place, where it is a tuple.
    (match ([] (. types rows) payload)
      (case (call .type-tuple row)
        (if-expr (< offset (. row fields count)) (call (. types child-type) (. row fields) offset) no-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-do _ type-entered _
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; What runs where a body is entered, once its entry statements have: what its first case is
    ; given where it is entered so (`enters-initial`), which a case's never is where one of its
    ; immediate transitions always passes (`always-passes`), its immediate transitions, each with
    ; its condition, or its subject matched by its pattern, and what it gives, then the stream of
    ; each of its groups (`type-group`).
    (let initial (if-expr (or (== owner 0) (not (call (. tree always-passes) items))) (call entered-case owner items) 0))
    (if (and (!= initial 0) (call (. tree enters-initial) (. machining items) owner))
      (if (not (call initial-given initial))
        (return)
      )
      (call type-targets initial)
    )
    (for (in transition (call (. tree immediate-transitions) items))
      (let trigger (call (. tree state-trigger) transition))
      (let subject (call (. tree trigger-subject) trigger))
      (if (== trigger 0)
        (call type-targets transition)
        (continue)
      )
      (if (!= subject 0)
        (call type-trigger-pattern trigger (call infer subject))
        (else
          (let condition (call (. tree trigger-condition) trigger))
          (call note-truthiness condition condition (call infer condition))
        )
      )
      (call type-targets transition)
    )
    (for (in head (call (. tree group-heads) items))
      (call type-group owner head)
    )
  )
  (fn-do _ entered-case SyntaxId
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; The case a body of a case, or the root for none, enters first: its first case with no
    ; trigger, unless a machine this one refines enters a case of its own there, which the cases
    ; this one adds there come after.
    (return-if 0 (if (call inherits-initial owner)))
    (return (call (. tree initial-case) items))
  )
  (fn-do _ inherits-initial Bool
    (param owner SyntaxId)
    ; Whether a machine this one refines writes a case with no trigger in the body of a case, or
    ; at the root for none.
    (return-if false (if (== (. machining refined) no-instance)))
    (let path (call (. tree case-path) (. machining items) owner))
    (return-if false (if (and (!= owner 0) (== (. path length) 0))))
    (let above (call (. facts machine-of) (. machining refined)))
    (while above
      (let piece (. ([] (. program modules) (. above module)) tree))
      (let body (. above syntax))
      (for (in node path)
        (let name (!! (call (. tree state-name) node)))
        (let found SyntaxId 0)
        (if (!= body 0)
          (for (in child (call (. piece child-cases) (call (. piece state-items) (call (. piece state-body) body))))
            (if (== (!! (call (. piece state-name) child)) name)
              (= found child)
            )
          )
        )
        (= body found)
      )
      (if (and (!= body 0) (!= (call (. piece initial-case) (call (. piece state-items) (call (. piece state-body) body))) 0))
        (return true)
      )
      (= above (only-if (call (. facts machine-of) (. above refined)) (if (!= (. above refined) no-instance))))
    )
    (return false)
  )
  (fn-do _ initial-given Bool
    (param initial SyntaxId)
    ; Whether each name a machine's first case is given, where it is entered, names a value: one
    ; that names none is a payload nothing gives, the reference's error at the name.
    (for (in target ([] (. tree children) (call (. tree state-targets) initial)))
      (let resolution (call (. bindings resolution-of) (. frame binding) target))
      (let unresolved (and (== (. resolution kind) .resolve-unresolved) (== (. resolution slot) no-slot)))
      (if (and (is ([] (. tree nodes) target) .node-identifier) unresolved)
        (let name (!! (call (. tree state-name) initial)))
        (let message
          (paragraph
            (str "Initial state case '" (. name text) "' cannot take a payload, since nothing enters it to give it one; give it values, or write a case with no payload before it")
          )
        )
        (call (. frame diagnose) target .stated (call (. program store-atom) message))
        (return false)
      )
    )
    (return true)
  )
  (fn-do + type-trigger-pattern _
    (param trigger SyntaxId)
    (param subject TypeId)
    ; A trigger's pattern matched against what it tests: an item of its stream, or the subject of
    ; an `if | p = s`.
    (let pattern (call (. tree trigger-pattern) trigger))
    (if (or (== pattern 0) (== subject invalid-type) (== subject no-type))
      (return)
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-structure-match row)
        (call check-pattern (. row pattern) subject)
        (return)
      )
    )
    (call check-pattern pattern subject)
  )
  (fn-do _ type-group _
    (param owner SyntaxId)
    (param head SyntaxId)
    ; A group of event transitions where its owner subscribes it, as the reference makes it: its
    ; stream is made a `Broadcastable`, recorded at its first transition's trigger, and the
    ; machine's `Subscriber` of its item is given to the broadcaster's `subscribe` and
    ; `unsubscribe`, whose errors are given to the global `unhandled-error` (`hands-off-raising`),
    ; each call kept with the group. What a call of the
    ; subscriber answers is kept for its type. A stream that is neither is the reference's error
    ; at the transition. One on an event of an object is typed so too (`type-event-group`), and one
    ; on a stream that is iterable and implements no `Broadcastable` itself, though it may convert
    ; to one, as `type-iterated-group` says, as the reference tries them in that order.
    (let trigger (call (. tree state-trigger) head))
    (let written (call (. tree group-stream) head))
    (if (== (call (. tree trigger-kind) trigger) (. StateTriggerKind state-trigger-whenever))
      (let watched (call watched-stream trigger written))
      (if (!= watched no-type)
        (call subscribe-group owner head watched)
      )
      (return)
    )
    (let found (call infer-found written (call (. (call Want) adding) .want-event)))
    (let given (. found type))
    (if (!= (. found event) (. U32 max))
      (let event ([] found-events (. found event)))
      (call type-event-group owner head trigger written event given)
      (return)
    )
    (if (or (== given invalid-type) (== given no-type))
      (return)
    )
    (if (== (. types broadcastable-decl module) 0)
      (call decline head)
      (return)
    )
    (if (and (== (call interface-of given (. types broadcastable-decl)) no-type) (call iterates-as-source given))
      (call type-iterated-group owner head trigger written given)
      (return)
    )
    (let stream (call supported given (. types broadcastable-decl)))
    (if (== stream no-type)
      (call (. frame diagnose)
        (block
          (arg head)
          (arg .stated)
          (arg (call (. program store-atom) "State trigger source is not broadcastable or iterable"))
        )
      )
      (return)
    )
    (call (. conversions convert) trigger written given stream .reason-argument)
    (call (. facts set-node-type) instance trigger stream)
    (call subscribe-group owner head stream)
  )
  (fn-do _ subscribe-group _
    (param owner SyntaxId)
    (param head SyntaxId)
    (param stream TypeId)
    (let item (call first-arg stream))
    (let subscriber (call (. types well-known-type-of) "core/stream" "Subscriber" item))
    (if (or (== item no-type) (== subscriber invalid-type))
      (call decline head)
      (return)
    )
    (let subscribing
      (call (. calls protocol-call)
        (block
          (arg stream)
          (arg (call (. program store-atom) "subscribe"))
          (arg head)
          (arg subscriber)
          (arg false)
          (arg no-type)
          (arg no-type)
          (arg false)
        )
      )
    )
    (if (== (. subscribing answer) invalid-type)
      (call decline head)
      (return)
    )
    (let subscribe (. subscribing fact))
    (let unsubscribing
      (call (. calls protocol-call)
        (block
          (arg stream)
          (arg (call (. program store-atom) "unsubscribe"))
          (arg head)
          (arg subscriber)
          (arg false)
          (arg no-type)
          (arg no-type)
          (arg false)
        )
      )
    )
    (if (== (. unsubscribing answer) invalid-type)
      (call decline head)
      (return)
    )
    (let unsubscribe (. unsubscribing fact))
    (if (or (not (call hands-off-raising subscribe)) (not (call hands-off-raising unsubscribe)))
      (call decline head)
      (return)
    )
    (let carried (call carried-result types subscriber))
    (if (!= carried no-type)
      (call (. types complete) carried)
      (call (. facts note-carried) (call function-row types subscriber) carried)
    )
    (let enqueue (call machine-enqueue item subscriber))
    (if (== enqueue no-instance)
      (call decline head)
      (return)
    )
    (let group
      (call MachineGroup
        (block
          (arg head)
          (arg owner)
          (arg stream)
          (arg item)
          (arg subscriber)
          (arg subscribe)
          (arg unsubscribe)
          (arg (. U32 max))
          (arg false)
          (arg false)
          (arg enqueue)
        )
      )
    )
    (+= (. machining groups-found) group)
  )
  (fn-do _ watched-stream TypeId
    (param trigger SyntaxId)
    (param written SyntaxId)
    (if (not (call (. tree tracks-reads) written))
      (let message
        (paragraph
          "A \"whenever\" trigger fires as what it reads with \"#\" changes, and this one reads nothing with \"#\", so it would never fire; write \"#\" before what it follows, as in \"whenever #feed\""
        )
      )
      (call (. frame diagnose) trigger .stated (call (. program store-atom) message))
      (return no-type)
    )
    (if (== (. types live-action-type) invalid-type)
      (call decline trigger)
      (return no-type)
    )
    (let given (call infer written))
    (if (or (== given invalid-type) (== given no-type))
      (return no-type)
    )
    (let read (call demand-lambda given (. scratch no-types)))
    (if (== read no-instance)
      (call decline trigger)
      (return no-type)
    )
    (let value (. ([] (. instances signatures) read) returns))
    (if (or (== value invalid-type) (== value no-type))
      (return no-type)
    )
    (let module (. (call class-ref types (. types live-action-type)) module))
    (let mark (. scratch types mark))
    (call (. scratch types push) value)
    (call (. scratch types push) given)
    (let watch (call (. calls demand-runtime-call) module no-type (call (. program store-atom) "watch-changes") mark 1))
    (call (. scratch types rewind) mark)
    (if (== watch no-instance)
      (call decline trigger)
      (return no-type)
    )
    (call (. conversions convert) trigger written given (call (. instances argument-type) watch 0) .reason-argument)
    (do
      (inline (call (. facts record-call) instance trigger watch .call-function (. scratch no-fills) false))
    )
    (let stream (. ([] (. instances signatures) watch) returns))
    (call (. facts set-node-type) instance trigger stream)
    (return stream)
  )
  (fn-do _ machine-enqueue InstanceId
    (param item TypeId)
    (param subscriber TypeId)
    ; The event runtime's `event-machine-enqueue` of an item, which the reference gives a group's
    ; activation, an item and its broadcaster, to run the activation once no event is being
    ; published and no other transition runs; or none.
    (let broadcaster (call (. types well-known-type-of) "core/stream" "Broadcastable" item))
    (if (or (== broadcaster invalid-type) (== (. types event-endpoint-decl module) 0))
      (return no-instance)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) subscriber)
    (call (. scratch types push) item)
    (call (. scratch types push) broadcaster)
    (let name (call (. program store-atom) "event-machine-enqueue"))
    (let found (call (. calls demand-runtime-call) (. types event-endpoint-decl module) no-type name mark 1))
    (call (. scratch types rewind) mark)
    (return found)
  )
  (fn-do + iterates-as-source Bool
    (param container TypeId)
    ; Whether the reference finds the items of the stream of a group of a machine's event
    ; transitions by iterating it: a generator, or a value `supported` as an `Iterable`, an
    ; `Indexable` or a `Stream`.
    (if (call same-decl (call class-ref types container) (. types generator-decl))
      (return true)
    )
    (for (in decl (list (. types iterable-decl) (. types indexable-decl) (. types stream-decl)))
      (if (!= (call supported container decl) no-type)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ type-iterated-group _
    (param owner SyntaxId)
    (param head SyntaxId)
    (param trigger SyntaxId)
    (param written SyntaxId)
    (param given TypeId)
    ; A group of event transitions on a stream that is only iterable, as the reference makes it
    ; where its owner subscribes it: the container is read at once, by its protocol planned at the
    ; trigger, which has the slots of a loop, and each item is given to the group's handler with
    ; the container. The reference's loop there does not poll.
    (let iterated (call iteration-container given written))
    (let item (call loop-item-type iterated trigger))
    (if (or (== item invalid-type) (== item no-type))
      (call decline head)
      (return)
    )
    (call note-container-iteration trigger iterated false trigger)
    (if (call is-indexed iterated false)
      (call (. facts set-plan) instance trigger .plan-index-loop)
      (if (call is-array-field iterated (!! (. types length-atom)))
        (call (. facts set-constant) instance trigger (call ConstantFact 1 0 null false) .plan-index-loop)
      )
      (call keep-loop trigger iterated (. types size-type) (. types size-type))
    )
    (call keep-loop-item trigger item)
    (let subscriber (call (. types well-known-type-of) "core/stream" "Subscriber" item))
    (if (or (== subscriber invalid-type) (== (call (. facts plan-of) instance trigger) .plan-none))
      (call decline head)
      (return)
    )
    (+= (. machining groups-found)
      (call MachineGroup
        (block
          (arg head)
          (arg owner)
          (arg iterated)
          (arg item)
          (arg subscriber)
          (arg no-fact)
          (arg no-fact)
          (arg (. U32 max))
          (arg false)
          (arg true)
        )
      )
    )
  )
  (fn-do _ type-event-group _
    (param owner SyntaxId)
    (param head SyntaxId)
    (param trigger SyntaxId)
    (param written SyntaxId)
    (param event NamedEvent)
    (param stream TypeId)
    ; A group on an event of an object, as the reference subscribes it: the endpoint the event
    ; runtime keeps for the object's event is the group's `Broadcastable`, and the machine keeps a
    ; port of the event runtime for the group, which queues each item that arrives on the event
    ; runtime's machine queue and runs the machine's subscriber with it. The port is made where
    ; the group is first subscribed, and attached to the endpoint and detached from it where its
    ; owner enters and exits. A group the event runtime runs from the table of a class instead
    ; (`lowers-group`) needs `event-register-lowered`, and its port is made where the machine
    ; starts and given what the table runs it with. One at the address of a keyed event takes the
    ; endpoint there, which the receiver claims, and is never run from the table, as the
    ; reference's `keyed-address-required` decides.
    (let keyed (!= (. event address) 0))
    (if (or (and (!= (. event key) no-type) (not keyed)) (== stream invalid-type) (== stream no-type))
      (call decline head)
      (return)
    )
    (let endpoint
      (block
        (case? keyed
          (call event-call "event-keyed-endpoint" (. event payload) no-type 3)
        )
        (default
          (call event-call "event-endpoint" (. event payload))
        )
      )
    )
    (let item (. event payload))
    (let subscriber (call (. types well-known-type-of) "core/stream" "Subscriber" item))
    (let broadcastable (call (. types well-known-type-of) "core/stream" "Broadcastable" item))
    (let port-type (call (. types well-known-type-of) "core/event" "EventMachinePort" item))
    (if (or (== endpoint no-instance) (== subscriber invalid-type) unportable)
      (call decline head)
      (return)
    )
    (lazy unportable (or (!= broadcastable stream) (== port-type invalid-type)))
    (if (and keyed (not (call claim-endpoint head head (. event address) endpoint)))
      (return)
    )
    (call (. conversions convert)
      (block
        (arg trigger)
        (arg written)
        (arg (. ([] (. instances signatures) endpoint) returns))
        (arg stream)
        (arg .reason-argument)
      )
    )
    (call (. facts set-node-type) instance trigger stream)
    (let lowered (if-expr keyed false (call lowers-group owner written event)))
    (if (not lowered)
      (return)
    )
    (if (and (!! lowered) (== (. facts event-register) no-instance))
      (call demand-event-register)
    )
    (if (and (!! lowered) (== (. facts event-register) no-instance))
      (call decline head)
      (return)
    )
    (let carried (call carried-result types subscriber))
    (if (!= carried no-type)
      (call (. types complete) carried)
      (call (. facts note-carried) (call function-row types subscriber) carried)
    )
    (let held (call (. types optional-of) port-type))
    (let port (if-expr lowered (call port-call "event-machine-port" item subscriber stream) no-instance))
    (let post (if-expr lowered (call port-call "event-machine-post" item port-type item) no-instance))
    (let attach
      (block
        (case? lowered
          no-instance
        )
        (default
          (call port-call "event-machine-attach" item held subscriber stream)
        )
      )
    )
    (let detach (if-expr lowered no-instance (call port-call "event-machine-detach" item held)))
    (let made
      (scope (if-expr lowered (and (!= port no-instance) (!= post no-instance)) attachable)
        (lazy attachable (and (!= attach no-instance) (!= detach no-instance)))
      )
    )
    (if (not made)
      (call decline head)
      (return)
    )
    (let used (as (. facts event-uses length) U32))
    (+= (. facts event-uses)
      (call EventUse
        (block
          (arg instance)
          (arg head)
          (arg written)
          (arg (. event owner))
          (arg (. event name))
          (arg .event-subscribe)
          (arg endpoint)
          (arg no-instance)
          (arg no-instance)
          (arg (. event address))
        )
      )
    )
    (call (. instances mark-may-panic) instance)
    (let group
      (call MachineGroup
        (block
          (arg head)
          (arg owner)
          (arg stream)
          (arg item)
          (arg subscriber)
          (arg no-fact)
          (arg no-fact)
          (arg used)
          (arg lowered)
          (arg false)
          (arg no-instance)
          (arg port)
          (arg post)
          (arg attach)
          (arg detach)
        )
      )
    )
    (+= (. machining groups-found) group)
  )
  (fn-do _ port-call InstanceId
    (param name String)
    (param item TypeId)
    (param first TypeId)
    (param second TypeId (= no-type))
    (param third TypeId (= no-type))
    ; A function of the event runtime that keeps the port of a machine's group on an event of an
    ; object, with the group's item as its type argument, given arguments of the types after it.
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) first)
    (if (!= second no-type)
      (call (. scratch types push) second)
    )
    (if (!= third no-type)
      (call (. scratch types push) third)
    )
    (let called
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) name))
          (arg mark)
          (arg 1)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (return called)
  )
  (fn-do _ lowers-group (? Bool)
    (param owner SyntaxId)
    (param written SyntaxId)
    (param event NamedEvent)
    ; Whether the event runtime runs a group of a machine's event transitions from the table of the
    ; class whose object it is written for, as the reference plans it: a group at the root of a
    ; machine a property of the class holds, or of one written in the class's content, as
    ; `lowers-for` decides. A group of a case of the same machine on the event is planned first, as
    ; the reference compiles the cases a transition enters before the machine's root, and is no such
    ; group, which leaves the root's group to the sidecar path the reference then takes.
    (let stored (or (== (. machining store) .store-member) (== (. machining store) .store-content)))
    (if (or (not stored) (!= owner 0) (== (. frame self-type) no-type))
      (return false)
    )
    (let lowered (call lowers-for (. frame self-type) module written event))
    (if (== lowered null)
      (call decline written)
    )
    (return lowered)
  )
  (fn-do + lowers-for (? Bool)
    (param receiver TypeId)
    (param source ModuleId)
    (param written SyntaxId)
    (param event NamedEvent)
    ; Whether the event runtime runs a group at the root of a machine, written in a module on a
    ; stream, from the table of a class: one on an event of the object itself, its name alone or
    ; read from `this`. Where a section of the class or of one above it hears the event too, or a
    ; constructor of one of them subscribes to it, the reference subscribes the group itself. Where
    ; a group of another of their machines is on it, the reference's choice turns on the order it
    ; compiles them in, and the group has no shape here (null).
    (let found (call own-event receiver source written))
    (if (or (not found) (!= (. found owner) (. event owner)) (!= (. found name) (. event name)))
      (return false)
    )
    (let chain (list TypeId))
    (let level (? TypeId) receiver)
    (while level
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (let groups 0u32)
    (let hearing 0u32)
    (for (in holder chain)
      (let ref (call class-ref types holder))
      (for (in part (call sheet-parts ref))
        (let part-module ([] (. program modules) (. part module)))
        (for (in member ([] (. part-module member-pool) (call part-members part)))
          (match? ([] (. part-module decls) member)
            (case (call .decl-rule rule)
              (let heard (call section-event receiver (. part module) (. rule syntax)))
              (if (and heard (== (. heard owner) (. event owner)) (== (. heard name) (. event name)))
                (return false)
              )
            )
            (case (call .decl-property property)
              (let machine
                (scope (if-expr (and (. property name) (not (. property is-lazy))) machine-node 0)
                  (lazy machine-node (call (. part-module tree declared-machine) (. property value)))
                )
              )
              (if (!= machine 0)
                (let heard
                  (call event-groups
                    (block
                      (arg (. part-module tree))
                      (arg
                        (call (. part-module tree state-items)
                          (block
                            (arg (call (. part-module tree state-body) machine))
                          )
                        )
                      )
                      (arg (. event name))
                    )
                  )
                )
                (+= groups heard)
                (+= hearing (if-expr (!= heard 0) 1 0))
              )
            )
          )
        )
      )
      (let owner-module ([] (. program modules) (. ref module)))
      (match? ([] (. owner-module decls) (. ref decl))
        (case (call .decl-class class)
          (for (in machine (call (. owner-module tree content-machines) (. class content)))
            (let heard
              (call event-groups
                (block
                  (arg (. owner-module tree))
                  (arg (call (. owner-module tree state-items) (call (. owner-module tree state-body) machine)))
                  (arg (. event name))
                )
              )
            )
            (+= groups heard)
            (+= hearing (if-expr (!= heard 0) 1 0))
          )
        )
      )
    )
    (for (in heard (call constructor-events receiver chain))
      (if (and (== (. heard owner) (. event owner)) (== (. heard name) (. event name)))
        (return false)
      )
    )
    (if (!= hearing 1)
      (return null)
    )
    (return (== groups 1))
  )
  (fn-do _ event-groups U32
    (param tree AST)
    (param items (list SyntaxId))
    (param name Atom)
    ; How many groups of event transitions in a body, and in the bodies of its transitions, are on
    ; an event of the object itself of a name, written alone or read from `this`.
    (let count 0u32)
    (for (in head (call (. tree group-heads) items))
      (let stream (call (. tree group-stream) head))
      (match? ([] (. tree nodes) stream)
        (case (call .node-identifier row)
          (if (== (. row name) name)
            (+= count 1)
          )
        )
        (case (call .node-get-expression get)
          (if (== (. get name) name)
            (match? ([] (. tree nodes) (. get object))
              (case (call .node-identifier object)
                (if (== (. object name text) "this")
                  (+= count 1)
                )
              )
            )
          )
        )
      )
    )
    (for (in item items)
      (if (call (. tree is-transition) item)
        (+= count (call event-groups tree (call (. tree state-items) (call (. tree state-body) item)) name))
      )
    )
    (return count)
  )
  (fn-do _ group-item TypeId
    (param head SyntaxId)
    ; The item the stream of a group gives, or no type where its group has no shape.
    (for (in group (. machining groups-found))
      (if (== (. group head) head)
        (return (. group item))
      )
    )
    (return no-type)
  )
  (fn-do _ type-handlers _
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; The function each group of a body's event transitions runs for an item: `each` and `it` are
    ; the item, and each transition matches its pattern, tests its guard and gives its targets.
    (for (in head (call (. tree group-heads) items))
      (let item (call group-item head))
      (if (== item no-type)
        (continue)
      )
      (let each (call (. bindings declared-kind-at) (. frame slots) head .slot-each))
      (let it (call (. bindings declared-kind-at) (. frame slots) head .slot-it))
      (if (!= each no-slot)
        (call (. frame assign) each item)
      )
      (if (!= it no-slot)
        (call (. frame assign) it item)
      )
      (for (in transition (call (. tree group-transitions) items head))
        (let trigger (call (. tree state-trigger) transition))
        (call type-trigger-pattern trigger item)
        (let guard (call (. tree trigger-guard) trigger))
        (if (!= guard 0)
          (call note-truthiness guard guard (call infer guard))
        )
        (call type-targets transition)
      )
    )
  )
  (fn-do _ type-targets _
    (param transition SyntaxId)
    ; What a transition gives the case it enters, typed where it fires. The source of a case's
    ; payload settles what the case holds where nothing did before (`fixed-payload`), and each
    ; name the case keeps takes what it reads there, which every transition that enters the case
    ; where the name is in reach must agree on, as the reference unifies them. A transition into a
    ; case that names what it holds gives one value for each name (`gives-names`).
    (for (in target ([] (. tree children) (call (. tree state-targets) transition)))
      (do
        (inline (call infer target))
      )
    )
    (if (not (call gives-names transition))
      (return)
    )
    (+= (. machining typed) transition)
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) transition))))
    (if (== position null)
      (return)
    )
    (call settle-payload position transition)
    (for (in read (. bindings machine-reads))
      (if (or (!= (. read module) module) (!= (. read site) transition))
        (continue)
      )
      (let place (call (. ([] (. machining kept) position) find) (. read name)))
      (if (== place null)
        (continue)
      )
      (if (== (. read slot) no-slot)
        (continue)
      )
      (let read-type (call (. frame slot-type) (. read slot)))
      (if (or (== read-type no-type) (== read-type invalid-type))
        (call decline transition)
        (continue)
      )
      (let known ([] ([] (. machining kept-types) position) place))
      (if (== known no-type)
        (= ([] ([] (. machining kept-types) position) place) read-type)
        (else-if (!= known read-type)
          (let joined (call (. relations unify) known read-type module))
          (if (call relation-legal joined)
            (= ([] ([] (. machining kept-types) position) place) (. joined unified))
            (else
              (call (. frame diagnose)
                (block
                  (arg transition)
                  (arg .stated)
                  (arg
                    (call (. program store-atom)
                      (block
                        (arg (str "Unable to unify activation capture type for '" (. read name text) "'"))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ gives-names Bool
    (param transition SyntaxId)
    ; Whether a transition gives a case that names what it holds, written with no trigger of its
    ; own, a value for each name, which is reported where it does not.
    (let name (call (. tree state-name) transition))
    (let held (if-expr name (call (. tree find-case) (. machining items) name) 0))
    (if (or (== held 0) (== held transition) (!= (call (. tree state-trigger) held) 0))
      (return true)
    )
    (let names (. (call (. tree state-targets) held) count))
    (let given (. (call (. tree state-targets) transition) count))
    (if (or (== names 0) (== given names))
      (return true)
    )
    (let holds (if-expr (== names 1) "one value" (str names " values")))
    (let gives (if-expr (== given 0) "none" (str given)))
    (let message (str "Case \"" (. (!! name) text) "\" holds " holds ", and this transition gives " gives "; give it " holds))
    (call (. frame diagnose) transition .stated (call (. program store-atom) message))
    (return false)
  )
  (fn-do _ settle-payload _
    (param position U32)
    (param transition SyntaxId)
    ; What a case holds, once the transition that is the source of its payload is typed, from what
    ; it gives (`settle-given`).
    (if (!= ([] (. machining payloads) position) no-type)
      (return)
    )
    (let source (call (. tree payload-source) (. machining items) (!! (call (. tree state-name) ([] (. machining cases) position)))))
    (if (or (not source) (!= (. source node) transition))
      (return)
    )
    (let given (list TypeId))
    (for (in target ([] (. tree children) (call (. tree state-targets) transition)))
      (+= given (call (. facts node-type) instance target))
    )
    (call settle-given position given)
  )
  (fn-do _ settle-given _
    (param position U32)
    (param given (list TypeId))
    ; What a case holds, from what the source of its payload gives: each part joined with what each
    ; other transition that gives the case values gives in its place, where that is known
    ; (`join-others`), and the one part, or a tuple of them.
    (call join-others position given)
    (if (== (. given length) 1)
      (= ([] (. machining payloads) position) ([] given 0))
      (return)
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (for (in offset (..< 0 (. given length)))
      (call (. scratch names push) (call (. types index-atom) (as offset U32)))
      (call (. scratch types push) ([] given offset))
    )
    (= ([] (. machining payloads) position) (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ join-others _
    (param position U32)
    (param given (list TypeId))
    ; Joins what the source of a case's payload gives with what each other source that gives values
    ; gives in its place, as the reference joins them: what one typed already gives, or what one
    ; gives typed on trial apart from where it fires (`source-given`). One whose values are not
    ; known so, that gives another number of them, or whose values do not join, is left out, and
    ; its values are converted to what the case holds where it fires.
    (for (in type given)
      (if (or (== type no-type) (== type invalid-type))
        (return)
      )
    )
    (let name (!! (call (. tree state-name) ([] (. machining cases) position))))
    (let best (call (. tree payload-source) (. machining items) name))
    (for (in source (call (. tree payload-sources) (. machining items) name))
      (if (or (and best (== (. source node) (. best node))) (call (. tree gives-nothing) source))
        (continue)
      )
      (let other (call source-given (. source node)))
      (if (!= (. other length) (. given length))
        (continue)
      )
      (let joined (list TypeId))
      (for (in offset (..< 0 (. given length)))
        (let part (call join-payload ([] given offset) ([] other offset)))
        (if (or (== part no-type) (== part invalid-type))
          (break)
        )
        (+= joined part)
      )
      (if (== (. joined length) (. given length))
        (for (in offset (..< 0 (. given length)))
          (= ([] given offset) ([] joined offset))
        )
      )
    )
  )
  (fn-do _ source-given (list TypeId)
    (param node SyntaxId)
    ; What a transition that gives a case values gives: the types of its targets where it is typed,
    ; or else typed on trial where it is written, with the names the activations around it see
    ; (`trial-transition`). None where any is unknown.
    (let found (list TypeId))
    (if (!= (call (. machining typed find) node) null)
      (for (in target ([] (. tree children) (call (. tree state-targets) node)))
        (+= found (call (. facts node-type) instance target))
      )
      (else
        (let chain (list SyntaxId))
        (let items (call source-place (. machining items) node chain))
        (if (== (. items length) 0)
          (return found)
        )
        (let slots (list SlotId))
        (let known (list TypeId))
        (for (in part chain)
          (call activation-names part slots known)
        )
        (let wanted (list SlotId))
        (let captured (list TypeId))
        (call trial-transition node items slots known wanted captured found)
      )
    )
    (for (in type found)
      (if (or (== type no-type) (== type invalid-type))
        (call (. found clear))
        (break)
      )
    )
    (return found)
  )
  (fn-do _ source-place (list SyntaxId)
    (param items (list SyntaxId))
    (param node SyntaxId)
    (param chain (list SyntaxId))
    ; The items of the body of a machine a node is written among, with the cases and
    ; continuations whose bodies hold them added to `chain`, outermost first; none where it is not
    ; written there.
    (for (in item items)
      (if (== item node)
        (return items)
      )
      (if (call (. tree is-transition) item)
        (+= chain item)
        (let inner (call source-place (call (. tree state-items) (call (. tree state-body) item)) node chain))
        (if (!= (. inner length) 0)
          (return inner)
        )
        (call (. chain pop))
      )
    )
    (let none (list SyntaxId))
    (return none)
  )
  (fn-do _ join-payload TypeId
    (param held TypeId)
    (param given TypeId)
    ; The type two values a case is given in one place join to, as the reference joins inferred
    ; types: an optional of the other where one is `null`, or what they unify to, or invalid.
    (if (== held given)
      (return held)
    )
    (if (or (== held (. types null-type)) (== given (. types null-type)))
      (let other (if-expr (== held (. types null-type)) given held))
      (return (call (. types optional-of) (call (. types optional-inner) other)))
    )
    (let relation (call (. relations unify) held given module))
    (return (if-expr (call relation-legal relation) (. relation unified) invalid-type))
  )
  (fn-do _ machine-union TypeId
    (param id SyntaxId)
    (param row MachineSlots)
    ; The union a machine's value is, private to it: a case for each case it names, in the order it
    ; names them, holding what that case holds. It is named, as the reference names it, for the
    ; local, the global or the property that names the machine, and numbered among the machines of
    ; the module, and told apart by that number, which an edit that moves the machine's lines keeps.
    (let name "StateMachine")
    (let property (call machine-property id))
    (if (!= (. row bound) no-slot)
      (= name (str (call state-type-name (. ([] (. bindings slots) (. row bound)) name)) "State"))
    )
    (if (and (== (. machining store) .store-nested) (. machining named))
      (= name (str (call state-type-name (. machining named)) "State"))
    )
    (match? ([] (. ([] (. program modules) module) decls) property)
      (case (call .decl-property found)
        (if (and (!= property 0) (. found name))
          (= name (str (call state-type-name (. found name)) "State"))
        )
      )
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (for (in position (..< 0 (. machining cases length)))
      (call (. scratch names push) (!! (call (. tree state-name) ([] (. machining cases) position))))
      (call (. scratch types push) ([] (. machining payloads) position))
    )
    (let number (call machine-number id))
    (return (call (. types intern-named-union) (call (. program store-atom) (str name number)) mark names-mark module number))
  )
  (fn-do _ machine-number U32
    (param id SyntaxId)
    ; The place of a machine among those its module writes, counted from one.
    (let count 0u32)
    (for (in row (. bindings machines))
      (if (and (== (. row module) module) (<= (. row syntax) id))
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do _ type-machine-slots _
    (param row MachineSlots)
    (param union TypeId)
    ; What a machine keeps, in its own function's environment: its value, and for each case its
    ; flag, its generation, what it holds, where it holds anything, and each name it keeps, whose
    ; first value is typed where it is a named tuple or struct, which a case keeps where nothing
    ; entering it captures the name; for each group the subscriber the machine gave its broadcaster
    ; and the broadcaster, while it is subscribed, or for a group on an event the port the machine
    ; keeps for it once it is made. A case whose activation owns the tasks spawned for it keeps the
    ; `TaskOwner` it makes as it is entered (`demand-task-owner`). Flags declared beside the local a
    ; machine is kept in are of the function the machine is written in.
    (call assign-kept row (. row syntax) "(value)" union)
    (for (in position (..< 0 (. machining cases length)))
      (let node ([] (. machining cases) position))
      (call assign-kept row node "(active)" (. types bool-type))
      (call assign-kept row node "(generation)" (call (. types type-row) .uint32))
      (if (!= (call (. bindings machine-slot) row node (call (. program store-atom) "(tasks)")) no-slot)
        (call demand-task-owner)
        (call assign-kept row node "(tasks)" (call (. types optional-of) (. types task-owner-type)))
      )
      (if (!= ([] (. machining payloads) position) (. types void-type))
        (call assign-kept row node "(payload)" ([] (. machining payloads) position))
      )
      (let kept ([] (. machining kept) position))
      (for (in place (..< 0 (. kept length)))
        (call assign-kept row node (str "(kept " (. ([] kept place) text) ")") ([] ([] (. machining kept-types) position) place))
        (call demand-first-values ([] ([] (. machining kept-types) position) place))
      )
    )
    (for (in group (. machining groups-found))
      (let port (if-expr (!= (. group port) no-instance) (. ([] (. instances signatures) (. group port)) returns) no-type))
      (let attached
        (scope (if-expr (!= (. group attach) no-instance) attach-type port)
          (lazy attach-type (. ([] (. instances signatures) (. group attach)) returns))
        )
      )
      (let subscriber (if-expr (!= attached no-type) attached (. group subscriber)))
      (call assign-kept row (. group head) "(subscriber)" (call (. types optional-of) subscriber))
      (call assign-kept row (. group head) "(source)" (call (. types optional-of) (. group stream)))
    )
  )
  (fn-do _ assign-kept _
    (param row MachineSlots)
    (param node SyntaxId)
    (param name String)
    (param type TypeId)
    (let slot (call (. bindings machine-slot) row node (call (. program store-atom) name)))
    (if (== slot no-slot)
      (return)
    )
    (let own (call (. bindings machine-slot) row (. row syntax) (call (. program store-atom) "(value)")))
    (if (and (!= own no-slot) (!= (. ([] (. bindings slots) slot) scope) (. ([] (. bindings slots) own) scope)) (. frame outer))
      (call (. frame outer assign) slot type)
      (else
        (call (. frame assign) slot type)
      )
    )
  )
  (fn-do _ type-projections _
    (param id SyntaxId)
    (param store MachineStore)
    ; Each projection of a machine written as a statement, a local of the function it is written in
    ; named after a case: the case's flag, or what it holds where it is active.
    (if (or (!= store .store-none) (not (. frame outer)))
      (return)
    )
    (for (in position (..< 0 (. machining cases length)))
      (let name (!! (call (. tree state-name) ([] (. machining cases) position))))
      (let slot (call (. bindings declared-at) (. (!! (. frame outer)) slots) id name))
      (let payload ([] (. machining payloads) position))
      (if (!= slot no-slot)
        (call (. (!! (. frame outer)) assign)
          (block
            (arg slot)
            (arg (if-expr (== payload (. types void-type)) (. types bool-type) (call (. types optional-of) payload)))
          )
        )
      )
    )
  )
  (fn-do _ convert-targets _
    ; What each typed transition gives, converted to the part of what its case holds in its place,
    ; or to all of it, at each value.
    (for (in transition (. machining typed))
      (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) transition))))
      (if (== position null)
        (continue)
      )
      (let payload ([] (. machining payloads) position))
      (let targets (call (. tree state-targets) transition))
      (let offset 0u32)
      (for (in target ([] (. tree children) targets))
        (let part (if-expr (== (. targets count) 1) payload (call payload-part payload offset)))
        (let given (call (. facts node-type) instance target))
        (if (and (!= part no-type) (!= given no-type) (!= given invalid-type))
          (call (. conversions convert) target target given part .reason-argument)
        )
        (+= offset 1)
      )
    )
  )
  (fn-do _ trial-transition _
    (param transition SyntaxId)
    (param items (list SyntaxId))
    (param slots (list SlotId))
    (param given (list TypeId))
    (param wanted (list SlotId))
    (param found (list TypeId))
    (param targets (list TypeId))
    ; What a transition of a machine, written among a body's items, sees and gives, typed on trial
    ; apart from where it fires (`trial-checker`) with the names its activation sees holding the
    ; types given, as the reference infers what a case holds and the names it keeps: the type of
    ; each slot wanted once its trigger's pattern has matched (`foresee-transition`), added to
    ; `found`, and of each of its targets, added to `targets`. None of either where the part that
    ; gives them reports anything.
    (let checker (call trial-checker transition))
    (for (in offset (..< 0 (. slots length)))
      (if (and (!= ([] given offset) no-type) (!= ([] given offset) invalid-type))
        (call (. checker frame assign) ([] slots offset) ([] given offset))
      )
    )
    (let reported (. facts diagnostics length))
    (call (. checker foresee-transition) transition items wanted found targets)
    (call (. facts diagnostics truncate) reported)
    (call (. checker close))
    (call (. checker retire))
  )
)

(fn-do _ case-under U32
  (param name Atom)
  (param parent U32)
  (param names (list Atom))
  (param parents (list U32))
  ; The place of the case of a name written under the case at a place, or none.
  (for (in place (..< 0 (. names length)))
    (if (and (== ([] names place) name) (== ([] parents place) parent))
      (return (as place U32))
    )
  )
  (return (. U32 max))
)

(fn-do _ state-type-name String
  (param name Atom)
  ; A name as the reference writes it in a type's: each part between hyphens with its first
  ; letter made upper case, joined.
  (let text "")
  (for (in part (call (. name text split) "-"))
    (if (!= (. part length) 0)
      (= text (str text (. ([] part (..< 0 1)) uppercased) ([] part (... 1))))
    )
  )
  (return text)
)
