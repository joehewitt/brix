(import /core/arena)

(type _ IdKey (is Tuple)
  (implements Hashable)
  (prop + data (of CPointer U32))
  (prop + count U32 (= 0))
  (fn-do + (infix this == (param other This)) _
    (return-if (if (!= count (. other count))))
    (let total Size count)
    (for (in offset (..< 0 total))
      (return-if (if (!= ([] data offset) ([] (. other data) offset))))
    )
    (return true)
  )
  (fn-do + hash Hash :get
    (let fingerprint (* (/xor/ 2166136261 count) 16777619))
    (let total Size count)
    (for (in offset (..< 0 total))
      (= fingerprint (* (/xor/ fingerprint ([] data offset)) 16777619))
    )
    (return fingerprint)
  )
)

(type + IdMap
  (implements (of Usable Void))
  (prop _ arena Arena)
  (prop _ entries (of Map IdKey U32 ArenaBacking))
  (prop _ keys (of List IdKey ArenaBacking))
  (prop + last-inserted Bool)
  (prop _ released Bool)
  (fn-do + This _
    (lazy entries (call (of Map IdKey U32) arena))
    (lazy keys (call (of List IdKey) arena))
  )
  (fn-expr + length Size :get
    (before
      (throw (call Panic "IdMap arena is stale or released") (if released))
    )
    (. keys length)
  )
  (fn-do + store Index
    (param data (of CPointer U32))
    (param count Size)
    (throw (call Panic "IdMap arena is stale or released") (if released))
    (throw (call Panic "IdMap key exceeds U32 capacity") (if (>= count (. U32 max))))
    (throw (call Panic "IdMap entry count exceeds U32 capacity") (if (>= (. keys length) (. U32 max))))
    (blank)
    (let probe (call IdKey data (as count U32)))
    (let existing ([] entries probe))
    (blank)
    (if existing
      (= last-inserted false)
      (return existing)
    )
    (blank)
    (let stable (call (of (. arena allocate) U32) count))
    (for (in offset (..< 0 count))
      (= ([] stable offset) ([] data offset))
    )
    (blank)
    (let durable (call IdKey stable (as count U32)))
    (let ordinal (. keys length))
    (+= keys durable)
    (= ([] entries durable) (as ordinal U32))
    (= last-inserted true)
    (return ordinal)
  )
  (fn-expr + find (? Index)
    (param data (of CPointer U32))
    (param count Size)
    (before
      (throw (call Panic "IdMap arena is stale or released") (if released))
      (throw (call Panic "IdMap key exceeds U32 capacity") (if (>= count (. U32 max))))
    )
    (case? existing
      existing
    )
    (default
      null
    )
    (where
      (lazy probe (call IdKey data (as count U32)))
      (lazy existing ([] entries probe))
    )
  )
  (fn-expr + key-count Size
    (param index Index)
    (before
      (throw (call Panic "IdMap arena is stale or released") (if released))
      (throw (call Panic "IdMap index out of bounds") (if (>= index (. keys length))))
    )
    (. ([] keys index) count)
  )
  (fn-expr + key-word U32
    (param index Index)
    (param offset Index)
    (before
      (throw (call Panic "IdMap arena is stale or released") (if released))
      (throw (call Panic "IdMap index out of bounds") (if (>= index (. keys length))))
      (throw (call Panic "IdMap key word offset out of bounds") (if (>= offset (. ([] keys index) count))))
    )
    ([] (. ([] keys index) data) offset)
  )
  (fn-do + begin-using _)
  (fn-do + end-using _ (without gc)
    (call release)
  )
  (fn-do + release _ (without gc)
    (if (not released)
      (call (. arena release))
      (= released true)
    )
  )
)
