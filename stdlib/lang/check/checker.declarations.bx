(type _ ClassName (is Tuple)
  (implements Hashable)
  ; What tells a class apart from the others of its module: its name and the number of type
  ; parameters it takes.
  (blank)
  (prop + name Atom)
  (prop + arity U32)
  (fn-expr + hash Hash :get
    (/xor/ (call hash-for name) (call hash-for arity))
  )
  (fn-expr + (infix this == (param other This)) _
    (and (== name (. other name)) (== arity (. other arity)))
  )
)

(fn-do _ redeclares-class Bool
  (param classes (of Map ClassName Bool))
  (param class ClassDecl)
  ; Whether a class has the name and the number of type parameters of one its module declares
  ; before it, which `classes` holds, and holds from now on. The reference takes the later of
  ; the two wherever the name is written, which is not modeled.
  (let key (call ClassName (. class name) (. class type-args count)))
  (if (?? ([] classes key) false)
    (return true)
  )
  (= ([] classes key) true)
  (return false)
)

(type _ Declarations (facet-of Checker)
  (sees Assignments)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Loops)
  (sees Markup)
  (sees MatchArms)
  (sees Styles)
  (prop _ class-cursor Size (= 0))
  (fn-do + initialize-classes _
    ; Checks the declarations of this module's types that have come into use since the last time.
    (while (< class-cursor (. types class-uses length))
      (let used ([] (. types class-uses) class-cursor))
      (+= class-cursor 1)
      (if (== (. used module) module)
        (call initialize-class (. used decl))
      )
    )
  )
  (fn-do + list-declarations _
    ; Lists what typing reads of the program's declarations as a whole, once for the session and
    ; before it types any instance, so that no instance's typing changes it: the style rules
    ; (`list-style-rules`) and the extensions of style sheets (`list-sheet-extensions`). An edit
    ; retyped in place keeps both, as it changes no declaration (`retype-edit`).
    (call list-style-rules)
    (call list-sheet-extensions)
  )
  (fn-do + initialize-class _
    (param decl DeclId)
    ; What a type declares is checked once, where the reference checks it: when the type is first
    ; used, by the checker of its module's statements where they use it and otherwise after the
    ; program is typed (`check-used-classes`). A type nothing uses is not checked. Its base and
    ; associated types come first, then its properties, getters and events in the order it declares
    ; them.
    (let key (. (call DeclRef module decl) key))
    (if (!= ([] (. types checked-classes) key) null)
      (return)
    )
    (= ([] (. types checked-classes) key) instance)
    (let decls (. ([] (. program modules) module) decls))
    (match? ([] decls decl)
      (case (call .decl-class class)
        (call check-base decl class)
        (call check-interfaces decl class)
        (call check-content decl class)
        (call check-associated decl class)
        (call check-default-cycles decl class)
        (for (in member ([] (. ([] (. program modules) module) member-pool) (. class members)))
          (match? ([] decls member)
            (case (call .decl-function fn)
              (if (and (not (. fn is-generated)) (== (. fn kind) .getter-decl) (. fn name))
                (let getter-name (. fn name))
                (let getter (. StorageKind storage-getter))
                (call check-member
                  (block
                    (arg member)
                    (arg decl)
                    (arg getter-name)
                    (arg (. fn syntax))
                    (arg getter)
                    (arg (!= (. fn return-type) 0))
                  )
                )
                (call check-union-member decl getter-name (. fn syntax) false)
              )
              (if (and (not (. fn is-generated)) (not (. fn is-static)) (== (. fn kind) .function-decl) (. fn name))
                (call check-inherited-method decl (. fn name) (. fn syntax))
              )
            )
            (case (call .decl-event event)
              (call check-inherited-event event)
            )
            (case (call .decl-property property)
              (if (and (not (. property defaults-root)) (== (. property element) 0))
                (call check-member-property member property)
              )
            )
          )
        )
      )
    )
  )
  (fn-do + declaring-interface TypeId
    (param interface TypeId)
    (param declarer DeclRef)
    ; The interface, of one and those it extends, that a declaration declares.
    (let ref (call class-ref types interface))
    (if (and (== (. ref module) (. declarer module)) (== (. ref decl) (. declarer decl)))
      (return interface)
    )
    (for (in extended (call (. types interfaces-of) interface))
      (let found (call declaring-interface extended declarer))
      (if (!= found no-type)
        (return found)
      )
    )
    (return no-type)
  )
  (fn-do + check-initializer _
    (param property DeclId)
    ; Types the value of one property in the frame of its module's main. A global whose type names
    ; a generic class without its arguments takes them from its value, or from the conversion its
    ; value is given, as a local does. A class's property is typed for one receiver, with `this`
    ; bound to it and the type parameters of the class that writes the value as the receiver gives
    ; them; a feed list a root `<This` gives a list takes the list's item type. A case of an enum
    ; is typed for its enum. A line of a root `<This` that names no property is a style's
    ; declaration (`check-root-style`).
    (call prepare)
    (let receiver (. ([] (. instances rows) instance) self-type))
    (match? ([] (. ([] (. program modules) module) decls) property)
      (case (call .decl-case row)
        (if (. row name)
          (call check-case receiver (. row name) (. row value) (. row syntax))
        )
        (call (. instances set-returns) instance receiver no-type .return-inferred)
        (call finish-errors frame)
        (call close)
        (return)
      )
      (case (call .decl-rule row)
        (call check-class-rule receiver (. row syntax) (. row owner))
        (return)
      )
      (case (call .decl-style-rule row)
        (call check-style-unit receiver (. row syntax) (. row owner))
        (return)
      )
      (case (call .decl-property row)
        (if (and (. row defaults-root) (. row name) received (not (call property-named receiver (. row name))))
          (call check-root-style receiver row)
          (return)
        )
        (lazy received (!= receiver no-type))
      )
    )
    (let annotation 0u32)
    (let initializer 0u32)
    (let site 0u32)
    (let eager false)
    (let writer 0u32)
    (match? ([] (. ([] (. program modules) module) decls) property)
      (case (call .decl-property row)
        (= annotation (. row type-syntax))
        (= initializer (. row value))
        (= site (. row syntax))
        (= eager (not (. row is-lazy)))
        (= writer (. row owner))
      )
    )
    (let result no-type)
    (if (== receiver no-type)
      (let declared no-type)
      (if (!= annotation 0)
        (= declared (call (. types evaluate-type) module tree annotation (call (. types env-frame))))
        (if (== declared invalid-type)
          (call report-missing-type annotation (call (. types env-frame)))
        )
      )
      (let value no-type)
      (if (!= initializer 0)
        (= initializing (if-expr eager property 0))
        (call expect-arms initializer declared)
        (= value (call infer-with-expected initializer declared))
        (= initializing 0)
        (if (!= declared no-type)
          (call note-declared-value 0 property initializer annotation declared value)
        )
        (if (call bare-generic-annotation declared value)
          (= declared (?? (call (. relations complete-from) declared value) value))
        )
        (if (!= declared no-type)
          (let chosen (call (. conversions convert) site initializer value declared .reason-declaration))
          (if (!= chosen invalid-type)
            (= declared chosen)
          )
        )
        (else-if (!= declared no-type)
          (call construct-value site declared)
        )
      )
      (= result (if-expr (!= declared no-type) declared value))
      (if (and eager (call is-constant-global module property))
        (call (. facts constant-globals append) (call ConstantGlobal module property))
      )
      (else
        (let declared (. ([] (. instances signatures) instance) declared-returns))
        (= (. frame self-type) receiver)
        (call bind-this receiver)
        (call (. frame close-env))
        (call open-class-env (call holding-type receiver (call DeclRef module writer)))
        (= reading (= (. reading eager) eager))
        (if (== initializer 0)
          (call construct-value site declared)
          (= result declared)
          (else
            (if (!= (call root-value) 0)
              (call expect-feeds initializer declared)
            )
            (call expect-arms initializer declared)
            (= result (call infer-with-expected initializer declared))
            (if (!= declared no-type)
              (call (. conversions convert) site initializer result declared .reason-declaration)
            )
            (call note-value-shape initializer)
          )
        )
      )
    )
    (if (== result no-type)
      (= result invalid-type)
    )
    (let stated (. ([] (. instances signatures) instance) declared-returns))
    (call (. instances set-returns) instance result stated .return-inferred)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ note-value-shape _
    (param value SyntaxId)
    ; Records how the value a class writes for a property depends on the object it is evaluated
    ; for: each property it reads, by a name the binder resolved to a member or after the
    ; receiver, and whether the value evaluates the read whenever it is evaluated; whether it names
    ; the receiver, and so may read any property; and whether it may evaluate a part of itself and
    ; not another, which is every value but one made of names, literals, calls, reads and operators
    ; that test nothing.
    (if (== value 0)
      (return)
    )
    (for (in node (..< (call (. tree subtree-start) value) (+ value 1)))
      (if (not (call (. tree tests-nothing) node))
        (= (. ([] (. instances rows) instance) branches) true)
      )
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (and (== (. resolution kind) .resolve-slot) this-slot)
            (= (. ([] (. instances rows) instance) reads-self) true)
          )
          (lazy this-slot (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
          (if (== (. resolution kind) .resolve-member)
            (call (. facts value-reads append)
              (block
                (arg (call ValueRead instance (. row name) node (call (. tree evaluated-surely) value node)))
              )
            )
          )
        )
        (case (call .node-get-expression row)
          (match? ([] (. tree nodes) (. row object))
            (case .node-identifier
              (let resolution (call (. bindings resolution-of) (. frame binding) (. row object)))
              (if (and (== (. resolution kind) .resolve-slot) this-object)
                (call (. facts value-reads append)
                  (block
                    (arg (call ValueRead instance (. row name) node surely))
                  )
                )
              )
              (lazy this-object (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
              (lazy surely (call (. tree evaluated-surely) value node))
            )
          )
        )
      )
    )
  )
  (fn-do _ early-union-of TypeId
    (param unit InstanceId)
    ; The union made early of the state machine a property's value is, or none. A machine that
    ; refines another, read while the machines it refines are typed, is read as the union of the
    ; machine none refines, typed for the same class (`inherited-union`). Where the machine's union is
    ; made only once its cases are typed, invalid.
    (let owner (. ([] (. instances rows) unit) module))
    (let owner-tree (. ([] (. program modules) owner) tree))
    (match? ([] (. ([] (. program modules) owner) decls) (. ([] (. instances rows) unit) initializer))
      (case (call .decl-property found)
        (let machine (call (. owner-tree declared-machine) (. found value)))
        (if (== machine 0)
          (return no-type)
        )
        (for (in row (. facts early-unions))
          (if (and (== (. row module) owner) (== (. row syntax) machine))
            (return (. row union))
          )
        )
        (let inherited (call inherited-union (. ([] (. instances rows) unit) self-type) (. found name)))
        (return (if-expr (!= inherited no-type) inherited invalid-type))
      )
    )
    (return no-type)
  )
  (fn-do _ inherited-union TypeId
    (param receiver TypeId)
    (param name (? Atom))
    ; The union of the machine of a property of a name that refines none, typed for a class or for
    ; the class above it that declares it, where it is typed already, or none.
    (if (or (not name) (== receiver no-type))
      (return no-type)
    )
    (for (in fact (. facts machines))
      (if (or (!= (. fact refined) no-instance) (!= (. fact outer) 0) (!= (. fact store) .store-member))
        (continue)
      )
      (let held (call decl-property-name (. fact module) (. fact decl)))
      (let level (. ([] (. instances rows) (. ([] (. instances rows) (. fact instance)) enclosing)) self-type))
      (if (and held (== held name) (== (call holding-type receiver (call class-ref types level)) level))
        (return (. fact union))
      )
    )
    (return no-type)
  )
  (fn-do + demand-initializer TypeId
    (param unit InstanceId)
    (param written SyntaxId)
    ; The type of a property's value, typed when the property is first read. A read that reaches
    ; the property again while its value is being typed is a circular reference, unless the value is
    ; a state machine whose union was made before its cases were typed (`early-union`).
    (let owner (. ([] (. instances rows) unit) module))
    (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
      (let early (call early-union-of unit))
      (if (== early invalid-type)
        (call decline written)
      )
      (if (!= early no-type)
        (return early)
      )
      (call (. facts record-diagnostic) instance owner written .circular-reference)
      (return invalid-type)
    )
    (call (. instances intern) owner (. ([] (. program modules) owner) main-decl) no-type 0 no-instance)
    (call demand-body unit)
    (return (. ([] (. instances signatures) unit) returns))
  )
  (fn-do _ note-value-errors _
    (param property DeclId)
    (param site SyntaxId)
    ; A module gives its globals their values as it starts, so the errors a value lets out leave
    ; the module's main at the global's declaration.
    (let unit (call (. instances intern-initializer) module property no-type))
    (if (!= (. ([] (. instances rows) unit) state) .instance-done)
      (return)
    )
    (call note-unit-errors unit site)
  )
  (fn-do + check-top-level _
    (param id SyntaxId)
    ; Checks what a module declares, then its statements. A declaration the module holds no row
    ; for is one no pass models, so it is declined where it is written: no program that holds one
    ; is taken for understood. One that is a member of a class waits for the class to be used, but
    ; a section with nothing written in it is the reference's error, and so are a section that
    ; follows the class's content (`follows-content`) and a member that takes a name the class took
    ; before (`declare-members`). A local the statements declare again is settled as a block's is
    ; (`settle-redeclared`).
    (let decls (. ([] (. program modules) module) decls))
    (let previous (. facts initializer))
    (= (. facts initializer) this)
    (let declaring (call (. tree declaring-type-names)))
    (let classes (call (of Map ClassName Bool)))
    (let suffixes (call (of Map Atom Atom)))
    (for (in index (..< 0 (. decls length)))
      (match? ([] decls index)
        (case (call .decl-case row)
          (if (and (!= (. row value) 0) (call is-enum-owner (. row owner)))
            (call infer (. row value))
          )
        )
        (case (call .decl-function fn)
          (if (not (. fn is-generated))
            (call check-shared-access (. fn syntax) (. fn access) (. fn owner))
            (call check-argument-shapes (. fn args))
            (if (call declares-within declaring (. fn subtree))
              (call check-type-params fn)
            )
            (call check-duplicate (as index DeclId) fn)
            (call check-getter-annotations (. fn syntax))
            (call check-return-mode (as index DeclId) (. fn return-type))
          )
        )
        (case (call .decl-event event)
          (call check-shared-access (. event syntax) (. event access) (. event owner))
          (if (and (!= (. event owner) 0) (call is-facet-decl (. event owner)))
            (call check-facet-event event)
            (else-if (and (!= (. event owner) 0) (not (call is-class (. event owner))))
              (call decline (. event syntax))
            )
            (else-if (!= (. event owner) 0)
              (call check-event-owner event)
            )
          )
        )
        (case (call .decl-associated associated)
          (if (and (!= (. associated binding) 0) (not (call is-type-syntax tree (. associated binding))))
            (let message (call (. program store-atom) "Associated type binding must be a type"))
            (call (. frame diagnose) (. associated binding) .stated message)
          )
        )
        (case (call .decl-extension extension)
          (call check-shared-access (. extension syntax) (. extension access) 0)
          (if (. extension facet)
            (call declare-members (. extension members))
            (call check-facet (as index DeclId) extension)
            (else
              (call check-extension (. extension syntax))
            )
          )
        )
        (case (call .decl-sheet-extension extension)
          (call check-sheet-extension (as index DeclId) extension)
        )
        (case (call .decl-class class)
          (call check-shared-access (. class syntax) (. class access) 0)
          (if (call redeclares-class classes class)
            (call decline (. class syntax))
            (else-if (and (== (. class name text) "This") (call is-sheet-decl module (as index DeclId)))
              (call (. frame diagnose)
                (block
                  (arg (. class syntax))
                  (arg .stated)
                  (arg (call (. program store-atom) "\"This\" is not a valid style sheet name"))
                )
              )
            )
            (else
              (call declare-members (. class members))
              (call check-unit-base class)
              (call check-suffixes class suffixes)
              (call check-below-facets (as index DeclId) class)
              (if (call is-sheet-decl module (as index DeclId))
                (call check-derived-sheet (as index DeclId) class)
                (call check-sheet-domains (as index DeclId) class)
              )
            )
          )
        )
        (case (call .decl-style-rule rule)
          (if (== (. rule outer) 0)
            (call check-style-rule (as index DeclId) rule)
          )
        )
        (case (call .decl-converter converter)
          (call check-conversion-access (. converter syntax) (. converter access))
          (call check-return-mode (as index DeclId) 0)
        )
        (case (call .decl-fromverter fromverter)
          (call check-conversion-access (. fromverter syntax) (. fromverter access))
          (call check-return-mode (as index DeclId) 0)
        )
        (case (call .decl-unit unit)
          (call check-shared-access (. unit syntax) (. unit access) (. unit owner))
          (call check-equality unit)
        )
        (case (call .decl-property property)
          (call check-shared-access (. property syntax) (. property access) (. property owner))
          (if (not (call is-class (. property owner)))
            (call check-member-property (as index DeclId) property)
          )
          (let literal (!= (call core-literal-type module (as index DeclId)) no-type))
          (if (and (== (. property owner) 0) (!= (. property value) 0) (not (. property is-lazy)) (not literal))
            (= initializing (as index DeclId))
            (if (call is-object-construction (. property value))
              (call check-module-property (as index DeclId) (. property value) (. property type-syntax))
              (else
                (call demand-property module (as index DeclId))
                (call note-value-errors (as index DeclId) (. property syntax))
              )
            )
            (= initializing 0)
          )
        )
      )
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-top-level-syntax row)
        (let finals (list SyntaxId))
        (let limits (list SyntaxId))
        (let open 0)
        (let awaiting (call await-elements (. row statements)))
        (let redeclares (call redeclares-in id))
        (let projected SyntaxId 0)
        (for (in statement ([] (. tree children) (. row statements)))
          (if redeclares
            (if (call projects)
              (= projected statement)
            )
            (call settle-redeclared statement projected)
          )
          (if (call (. tree is-finally) statement)
            (+= finals statement)
            (+= limits 0)
            (else-if (not (call is-declaration-syntax tree statement))
              (let calls-before U32 (as (. facts calls length) U32))
              (let watches (< open (. finals length)))
              (if watches
                (+= watching-leaves 1)
              )
              (call raise-statement statement)
              (call check-called statement (call check-statement statement (if-expr (call runs-steps statement) (call (. (call (. (call Want) adding) .want-unused) adding) .want-match-statement) (call (. (call Want) adding) .want-unused))) true (. row statements))
              (if watches
                (-= watching-leaves 1)
              )
              (if (and watches (call may-leave calls-before))
                (for (in position (..< open (. finals length)))
                  (= ([] limits position) statement)
                )
                (= open (. finals length))
              )
            )
          )
        )
        (for (in position (..< 0 (. finals length)))
          (call check-finally ([] finals position) ([] limits position))
        )
        (call settle-elements awaiting)
        (if (call (. program runs-main) module)
          (call note-main-end id)
        )
      )
    )
    (let undeclared (. ([] (. program modules) module) undeclared))
    (for (in position (..< 0 (. undeclared length)))
      (let owner ([] (. ([] (. program modules) module) undeclared-owners) position))
      (if (== owner 0)
        (call decline ([] undeclared position))
        (else-if (call (. tree is-empty-section) ([] undeclared position))
          (call (. frame diagnose)
            (block
              (arg ([] undeclared position))
              (arg .stated)
              (arg (call (. program store-atom) "Empty content section not permitted"))
            )
          )
        )
        (else-if (call follows-content ([] undeclared position) owner)
          (call (. frame diagnose)
            (block
              (arg ([] undeclared position))
              (arg .stated)
              (arg (call (. program store-atom) "Only one content section permitted"))
            )
          )
        )
      )
    )
    (call initialize-classes)
    (= (. facts initializer) previous)
  )
  (fn-do _ note-main-end _
    (param id SyntaxId)
    ; The program's main calls `end-main` of core where its statements end, before its cleanups run,
    ; as the reference does. The call is recorded at the main's node.
    (let found (call (. program module-by-name) "core/task"))
    (if (not found)
      (call decline id)
      (return)
    )
    (let mark (. scratch types mark))
    (let callee
      (call (. calls demand-runtime-call)
        (block
          (arg (as found ModuleId))
          (arg no-type)
          (arg (call (. program store-atom) "end-main"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== callee no-instance)
      (call decline id)
      (return)
    )
    (call (. facts record-call) (. frame instance) id callee .call-function (. scratch no-fills) false)
  )
  (fn-do _ declare-members _
    (param declared (of RowRange DeclId))
    ; Checks each member of a class or a facet against those it declares before, as the reference
    ; does as it declares the class, whether or not the class is used: a property or a getter takes a name for
    ; a property, which a property or a getter of that name redefines, and an event or an associated
    ; type takes a name for a member, which nothing may take again. A setter takes the name for a
    ; property where nothing took it.
    (let owner ([] (. program modules) module))
    (let properties (list Atom))
    (let members (list Atom))
    (for (in member ([] (. owner member-pool) declared))
      (match? ([] (. owner decls) member)
        (case (call .decl-property property)
          (if (and (. property name) (not (. property defaults-root)) (== (. property element) 0))
            (call take-property-name (. property name) (. property syntax) properties members)
          )
        )
        (case (call .decl-function fn)
          (if (and (. fn name) (not (. fn is-generated)) (== (. fn kind) .getter-decl))
            (call take-property-name (. fn name) (. fn syntax) properties members)
          )
          (if (and (. fn name) plain-setter (== (call (. properties find) (. fn name)) null))
            (call take-property-name (. fn name) (. fn syntax) properties members)
          )
          (lazy plain-setter (and (not (. fn is-generated)) (== (. fn kind) .setter-decl)))
          (if (and (. fn name) plain-method (!= (call (. members find) (. fn name)) null))
            (call (. frame diagnose)
              (block
                (arg (. fn syntax))
                (arg .stated)
                (arg (call (. program store-atom) "Redefinition of class member"))
              )
            )
          )
          (lazy plain-method (and (not (. fn is-generated)) (not (. fn is-static)) (== (. fn kind) .function-decl)))
        )
        (case (call .decl-event event)
          (call take-member-name (. event name) (. event syntax) properties members)
        )
        (case (call .decl-associated associated)
          (call take-member-name (. associated name) (. associated syntax) properties members)
        )
      )
    )
  )
  (fn-do _ take-property-name _
    (param name Atom)
    (param site SyntaxId)
    (param properties (list Atom))
    (param members (list Atom))
    (if (!= (call (. members find) name) null)
      (call (. frame diagnose) site .stated (call (. program store-atom) "Redefinition of class member"))
      (else-if (!= (call (. properties find) name) null)
        (call (. frame diagnose) site .stated (call (. program store-atom) "Redefinition of property"))
      )
      (else
        (+= properties name)
      )
    )
  )
  (fn-do _ take-member-name _
    (param name Atom)
    (param site SyntaxId)
    (param properties (list Atom))
    (param members (list Atom))
    (if (or (!= (call (. members find) name) null) (!= (call (. properties find) name) null))
      (call (. frame diagnose) site .stated (call (. program store-atom) "Redefinition of class member"))
      (else
        (+= members name)
      )
    )
  )
  (fn-do _ check-member-property _
    (param decl DeclId)
    (param property PropertyDecl)
    (return-if (if (not (call check-keyed-name property))))
    (call check-annotations property)
    (call check-property decl property)
    (if (and (!= (. property owner) 0) (. property name))
      (call check-union-member (. property owner) (. property name) (. property syntax) true)
    )
  )
  (fn-do _ check-event-owner _
    (param event EventDecl)
    ; Reports an event a struct or a tuple declares: an event belongs to an object, whose
    ; subscribers it keeps, and a value of a struct or a tuple is copied, so none would hear it.
    (match? ([] (. ([] (. program modules) module) decls) (. event owner))
      (case (call .decl-class class)
        (if (== (. class base) 0)
          (return)
        )
        (let base (call (. types evaluate-type) module tree (. class base) (. frame env)))
        (if (or (== base invalid-type) (== base no-type))
          (return)
        )
        (let kind (call (. types intrinsic-of) base))
        (if (and (!= kind .struct) (!= kind .tuple))
          (return)
        )
        (let shape (if-expr (== kind .struct) "struct" "tuple"))
        (let text
          (paragraph
            (str "Only a class can declare an event, which belongs to an object, and " (. class name text) " is a " shape ", whose values are copied; declare " (. class name text) " as a class")
          )
        )
        (call (. frame diagnose) (. event syntax) .stated (call (. program store-atom) text))
      )
    )
  )
  (fn-do _ check-default-cycles _
    (param decl DeclId)
    (param class ClassDecl)
    ; A stored property's value cannot depend on itself through the values of the properties
    ; beside it. The values are followed once: a property is not reached yet, being followed, or
    ; done, and a value that reads one being followed closes a circle. Only then is the first
    ; property declared that is on a circle looked for, to be reported: as one that initializes
    ; after the class's markup where a value on the circle reads an element the markup names. A
    ; state machine is no such value: its cases run on the object, as the reference compiles them.
    (let owner ([] (. program modules) module))
    (let count (. class members count))
    (let values ([] SyntaxId count))
    (let sites ([] SyntaxId count))
    (let states ([] U8 count))
    (let offset 0u32)
    (for (in member ([] (. owner member-pool) (. class members)))
      (match? ([] (. owner decls) member)
        (case (call .decl-property property)
          (if (and (. property name) (!= (. property value) 0) (not (. property is-lazy)) no-machine)
            (= ([] values offset) (. property value))
            (= ([] sites offset) (. property syntax))
          )
          (lazy no-machine (== (call (. tree declared-machine) (. property value)) 0))
        )
      )
      (+= offset 1)
    )
    (let circular false)
    (let pending (list U32))
    (let cursors (list SyntaxId))
    (for (in start (..< 0 count))
      (if (or (== ([] values start) 0) (!= ([] states start) 0) circular)
        (continue)
      )
      (= ([] states start) 1)
      (+= pending start)
      (+= cursors (call (. tree subtree-start) ([] values start)))
      (while (and (!= (. pending length) 0) (not circular))
        (let current ([] pending (- (. pending length) 1)))
        (let id ([] cursors (- (. cursors length) 1)))
        (if (> id ([] values current))
          (= ([] states current) 2)
          (call (. pending pop))
          (call (. cursors pop))
          (continue)
        )
        (= ([] cursors (- (. cursors length) 1)) (+ id 1))
        (let read (call default-read class id))
        (if (or (== read (. U32 max)) (== ([] values read) 0))
          (continue)
        )
        (if (== ([] states read) 1)
          (= circular true)
          (else-if (== ([] states read) 0)
            (= ([] states read) 1)
            (+= pending read)
            (+= cursors (call (. tree subtree-start) ([] values read)))
          )
        )
      )
    )
    (if (not circular)
      (return)
    )
    (for (in start (..< 0 count))
      (if (and (!= ([] values start) 0) (call reads-itself class values start))
        (if (call puts-off-circle decl class values start)
          (let name (call default-name class start))
          (let message
            (paragraph
              (str "Property \"" (. name text) "\" depends on itself through properties that initialize after its markup")
            )
          )
          (call (. frame diagnose) ([] sites start) .stated (call (. program store-atom) message))
          (else
            (call (. frame diagnose) ([] sites start) .circular-reference)
          )
        )
        (return)
      )
    )
  )
  (fn-do _ reads-itself Bool
    (param class ClassDecl)
    (param values (list SyntaxId))
    (param start U32)
    ; Whether the value of a stored property reads the property, by itself or through the values
    ; of the properties it reads.
    (let reached ([] Bool (. values length)))
    (let pending (list U32))
    (+= pending start)
    (while (!= (. pending length) 0)
      (let current ([] pending (- (. pending length) 1)))
      (call (. pending pop))
      (for (in id (.. (call (. tree subtree-start) ([] values current)) ([] values current)))
        (let read (call default-read class id))
        (if (or (== read (. U32 max)) (== ([] values read) 0))
          (continue)
        )
        (if (== read start)
          (return true)
        )
        (if (not ([] reached read))
          (= ([] reached read) true)
          (+= pending read)
        )
      )
    )
    (return false)
  )
  (fn-do _ puts-off-circle Bool
    (param decl DeclId)
    (param class ClassDecl)
    (param values (list SyntaxId))
    (param start U32)
    ; Whether a value on a circle, or one it reads, reads an element the markup of the class
    ; names, so that the reference puts the circle off until the markup has run.
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module decl mark))
    (call (. scratch types rewind) mark)
    (if (or (== owner invalid-type) (== owner no-type))
      (return false)
    )
    (call (. types complete) owner)
    (let reached ([] Bool (. values length)))
    (let pending (list U32))
    (+= pending start)
    (= ([] reached start) true)
    (while (!= (. pending length) 0)
      (let current ([] pending (- (. pending length) 1)))
      (call (. pending pop))
      (if (call reads-element owner tree ([] values current))
        (return true)
      )
      (for (in id (.. (call (. tree subtree-start) ([] values current)) ([] values current)))
        (let read (call default-read class id))
        (if (and (!= read (. U32 max)) (!= ([] values read) 0) (not ([] reached read)))
          (= ([] reached read) true)
          (+= pending read)
        )
      )
    )
    (return false)
  )
  (fn-do _ default-name Atom
    (param class ClassDecl)
    (param offset U32)
    (let owner ([] (. program modules) module))
    (match? ([] (. owner decls) ([] (. owner member-pool) (+ (. class members start) offset)))
      (case (call .decl-property property)
        (return (!! (. property name)))
      )
    )
    (throw (call Panic "A value on a circle belongs to no property"))
  )
  (fn-do _ default-read U32
    (param class ClassDecl)
    (param id SyntaxId)
    ; The place among a class's members of the stored property with a value that a node names,
    ; or none.
    (let owner ([] (. program modules) module))
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (let place (call (. owner first-member) (. class members) (. row name)))
        (while (!= place no-member)
          (match? ([] (. owner decls) ([] (. owner member-pool) place))
            (case (call .decl-property property)
              (if (and (!= (. property value) 0) (not (. property is-lazy)))
                (return (- place (. class members start)))
              )
            )
          )
          (= place ([] (. owner member-links) place))
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ check-associated _
    (param decl DeclId)
    (param class ClassDecl)
    ; A type binds every associated type the interfaces it implements require, as openly as the
    ; requirement and with as many parameters.
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module decl mark))
    (if (== owner invalid-type)
      (return)
    )
    (call (. types complete) owner)
    (if (== (call (. types intrinsic-of) owner) .interface)
      (return)
    )
    (let seen (list TypeId))
    (let level (? TypeId) owner)
    (while level
      (for (in interface (call (. types interfaces-of) level))
        (if (not (call check-requirements owner class interface seen))
          (return)
        )
      )
      (= level (call (. types base-of) level))
    )
  )
  (fn-do _ check-requirements Bool
    (param owner TypeId)
    (param class ClassDecl)
    (param interface TypeId)
    (param seen (list TypeId))
    (if (!= (call (. seen find) interface) null)
      (return true)
    )
    (+= seen interface)
    (call (. types complete) interface)
    (let ref (call class-ref types interface))
    (let declaring ([] (. program modules) (. ref module)))
    (match? ([] (. declaring decls) (. ref decl))
      (case (call .decl-class required)
        (for (in member ([] (. declaring member-pool) (. required members)))
          (match? ([] (. declaring decls) member)
            (case (call .decl-associated requirement)
              (if (not (call check-binding owner class requirement))
                (return false)
              )
            )
          )
        )
      )
    )
    (for (in parent (call (. types interfaces-of) interface))
      (if (not (call check-requirements owner class parent seen))
        (return false)
      )
    )
    (let base (call (. types base-of) interface))
    (if base
      (return (call check-requirements owner class base seen))
    )
    (return true)
  )
  (fn-do _ check-binding Bool
    (param owner TypeId)
    (param class ClassDecl)
    (param requirement AssociatedDecl)
    (let name (. requirement name))
    (let level (? TypeId) owner)
    (while level
      (let ref (call class-ref types level))
      (let declaring ([] (. program modules) (. ref module)))
      (match? ([] (. declaring decls) (. ref decl))
        (case (call .decl-class holder)
          (for (in member ([] (. declaring member-pool) (. holder members)))
            (match? ([] (. declaring decls) member)
              (case (call .decl-associated binding)
                (if (!= (. binding name) name)
                  (continue)
                )
                (let message "")
                (if (and (call is-public (. requirement access)) (not (call is-public (. binding access))))
                  (= message (str "Associated type " (. name text) " must be public"))
                  (else-if (!= (. binding type-args count) (. requirement type-args count))
                    (= message (str "Associated type " (. name text) " has incompatible arity"))
                  )
                )
                (if (== (. message length) 0)
                  (return true)
                )
                (call (. facts record-diagnostic)
                  (block
                    (arg instance)
                    (arg (. ref module))
                    (arg (. binding syntax))
                    (arg .stated)
                    (arg (call (. program store-atom) message))
                  )
                )
                (return false)
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (let shown (call type-short-name types owner))
    (let message (str "Must implement associated type " (. name text) " in " shown))
    (call (. frame diagnose) (. class syntax) .stated (call (. program store-atom) message))
    (return false)
  )
  (fn-expr _ is-facet-decl Bool
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-extension row)
        (!= (. row facet) null)
      )
      (default
        false
      )
    )
  )
  (fn-do _ check-facet-event _
    (param event EventDecl)
    ; An event a facet declares is its class's, and its types are checked as a class's event's are.
    ; One of a facet that is not bound to its class was reported with the facet.
    (let facets (. program facets))
    (let found (call (. facets index-of) module (. event owner)))
    (return-if (if (or (not found) (!= ([] (. facets states) found) .facet-bound))))
    (let index found)
    (let owner (call (. types plain-class) ([] (. facets owner-modules) index) ([] (. facets owner-decls) index)))
    (call check-event-types event owner)
  )
  (fn-do _ check-shared-access _
    (param syntax SyntaxId)
    (param access Access)
    (param owner DeclId)
    ; Only a member is shared with its file family; what a module declares itself is public or private.
    (if (and (== owner 0) (is access .family-access))
      (let message "Only a member can be shared with its file family; declare this + or _")
      (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ check-conversion-access _
    (param syntax SyntaxId)
    (param access Access)
    ; A conversion applies wherever its types meet, so it cannot be private to a module.
    (if (not (call is-public access))
      (call (. frame diagnose) syntax .stated (call (. program store-atom) "Converters must be public"))
    )
  )
  (fn-do _ check-suffixes _
    (param class ClassDecl)
    (param suffixes (of Map Atom Atom))
    ; Reports a name written in parentheses after a class's own, as a unit's suffix is, that a class
    ; its module declares before it wrote already, which `suffixes` holds, and holds from now on, or
    ; that a class of a module it can name writes (`imported-suffix`), which it would hide there. It
    ; is reported at the class's base, written on the line of the name.
    (for (in offset (..< 0 (. class aliases count)))
      (let alias ([] (. tree atoms) (+ (. class aliases start) offset)))
      (let earlier (?? ([] suffixes alias) (call imported-suffix alias)))
      (if earlier
        (let message
          (paragraph
            (str "\"" (. alias text) "\" already names " (. earlier text) "; give " (. class name text) " a suffix of its own")
          )
        )
        (call (. frame diagnose)
          (block
            (arg (if-expr (!= (. class base) 0) (. class base) (. class syntax)))
            (arg .stated)
            (arg (call (. program store-atom) message))
          )
        )
        (else
          (= ([] suffixes alias) (. class name))
        )
      )
    )
  )
  (fn-do _ imported-suffix (? Atom)
    (param alias Atom)
    ; The name of a public class of another module this one can name that writes a name in
    ; parentheses after its own, as `Char` writes `c`, or none.
    (for (in candidate (call (. program lookup) module alias))
      (if (or (== (. candidate module) module) (== (call (. program listed-last) module (. candidate module)) (. U32 max)))
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case (call .decl-class row)
          (if (and (!= (. row name) alias) (== (. row access) .public-access))
            (return (. row name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ check-unit-base _
    (param class ClassDecl)
    ; A class declared as a number of a unit, as `Hours` is `60minutes`, is declared in a unit the
    ; program has, as `misstates-unit` says.
    (if (!= (. class base) 0)
      (match? ([] (. tree nodes) (. class base))
        (case (call .node-type-numeric numeric)
          (do
            (inline (call misstates-unit (. numeric value)))
          )
        )
      )
    )
  )
  (fn-do _ check-extension _
    (param syntax SyntaxId)
    ; An extension adds behavior to a type it does not own: it cannot yet make the type implement
    ; an interface, and it cannot add storage.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-extension row)
        (if (!= (. row as-types count) 0)
          (call (. frame diagnose) syntax .stated (call (. program store-atom) "Not yet implemented"))
          (return)
        )
        (for (in member ([] (. tree children) (. row body)))
          (match? ([] (. tree nodes) member)
            (case .node-property-syntax
              (let message "Stored properties are not allowed in extensions")
              (call (. frame diagnose) member .stated (call (. program store-atom) message))
              (return)
            )
          )
        )
      )
    )
  )
  (fn-do _ check-facet _
    (param decl DeclId)
    (param facet ExtensionDecl)
    ; A facet is part of a class, or of another facet of it, declared in the class's file family. It
    ; holds what a class body may but for what only a class has: a base, type parameters,
    ; constructors, static functions and markup. The interfaces it names are its class's, and each
    ; names an interface. Its stored properties have their first values from the class's
    ; constructors, so each has a value or an optional type. Its members are found wherever the
    ; class's are, so none takes a name the class answers, nor a name, not private, that another facet
    ; of the class declares.
    (let facets (. program facets))
    (let found (call (. facets index-of) module decl))
    (return-if (if (not found)))
    (let index found)
    (let name (. (!! (. facet facet)) text))
    (let owner (?? (?. (call (. types type-syntax-name) tree (. facet receiver)) text) "its owner"))
    (let state ([] (. facets states) index))
    (if (!= state .facet-bound)
      (let (tuple root-module _) (call (. facets root-of) index))
      (let family "its class's")
      (if (!= root-module (. U32 max))
        (= family (call path-file (. ([] (. program modules) root-module) path)))
      )
      (let message (call facet-state-message state name owner family))
      (call (. frame diagnose) (. facet receiver) .stated (call (. program store-atom) message))
    )
    (call check-facet-shape facet name)
    (return-if (if (!= state .facet-bound)))
    (call check-facet-interfaces decl facet name)
    (let owner-ref (call DeclRef ([] (. facets owner-modules) index) ([] (. facets owner-decls) index)))
    (let owner-type (call (. types plain-class) (. owner-ref module) (. owner-ref decl)))
    (if (!= (call (. types intrinsic-of) owner-type) .class)
      (let message (str name " can't be part of " owner ", since only a class has facets"))
      (call (. frame diagnose) (. facet receiver) .stated (call (. program store-atom) message))
      (return)
    )
    (let sees-start ([] (. facets sees-starts) index))
    (for (in position (..< sees-start ([] (. facets sees-starts) (+ index 1))))
      (if (== ([] (. facets sees) position) (. U32 max))
        (let written ([] (. ([] (. program modules) module) syntax-pool) (- (+ (. facet sees start) position) sees-start)))
        (let seen (?? (?. (call (. types type-syntax-name) tree written) text) "It"))
        (let message
          (paragraph
            (str "\"" seen "\" is no other facet of " (call class-name-of owner-ref) ", so " name " can't see it")
          )
        )
        (call (. frame diagnose) written .stated (call (. program store-atom) message))
      )
    )
    (call check-facet-names index facet name)
  )
  (fn-do _ check-below-facets _
    (param decl DeclId)
    (param class ClassDecl)
    ; A class below one with facets may not declare a member of the name of a member, not private,
    ; that a facet of a class above declares, but to override a facet's method, getter or setter, or
    ; to give a property the facet stores a new value (`overrides-facet`).
    (let facets (. program facets))
    (return-if (if (or (== (. facets count) 0) (== (. class base) 0))))
    (let env (call (. types class-env) module decl))
    (let level (? TypeId) (call (. types evaluate-type) module tree (. class base) env))
    (call (. types env-release) env)
    (let target ([] (. program modules) module))
    (while (and level (!= level invalid-type))
      (let ref (call class-ref types level))
      (let (tuple start end) (call (. facets class-range) (. ref module) (. ref decl)))
      (for (in position (..< start end))
        (let facet ([] (. facets class-facets) position))
        (for (in member ([] (. target member-pool) (. class members)))
          (let (tuple named _ site) (call (. target member-name) member))
          (let facet-module ([] (. facets modules) facet))
          (if (and named (call declares-name facet-module ([] (. facets decls) facet) named true) (not overriding))
            (let message
              (paragraph
                (str (. class name text) " can't declare " (. named text) ", since facet " (call facet-name-of facet) " of " (call class-name-of ref) " declares it")
              )
            )
            (call (. frame diagnose) site .stated (call (. program store-atom) message))
          )
          (lazy overriding (call overrides-facet ([] (. target decls) member) facet-module ([] (. facets decls) facet)))
        )
      )
      (= level (call (. types base-of) level))
    )
  )
  (fn-do _ overrides-facet Bool
    (param decl Decl)
    (param facet-module ModuleId)
    (param facet-decl DeclId)
    ; Whether a member of a class below one with facets overrides a facet's: a method, getter or
    ; setter where the facet declares one of its name and kind, or a property with a value where the
    ; facet stores one of its name.
    (let target ([] (. program modules) facet-module))
    (let members
      (match ([] (. target decls) facet-decl)
        (case (call .decl-extension row)
          (. row members)
        )
        (default
          (call (of RowRange DeclId))
        )
      )
    )
    (match? decl
      (case (call .decl-function fn)
        (return-if false (if (or (. fn is-static) (not (. fn name)) (not (call is-overridable-kind (. fn kind))))))
        (for (in member (call (. target members-named) members (. fn name)))
          (match? ([] (. target decls) member)
            (case (call .decl-function other)
              (return-if true (if (and (== (. other name) (. fn name)) (== (. other kind) (. fn kind)) (not (. other is-static)))))
            )
          )
        )
      )
      (case (call .decl-property property)
        (return-if false (if (or (== (. property value) 0) (not (. property name)))))
        (for (in member (call (. target members-named) members (. property name)))
          (match? ([] (. target decls) member)
            (case (call .decl-property other)
              (return-if true (if (== (. other name) (. property name))))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-facet-interfaces _
    (param decl DeclId)
    (param facet ExtensionDecl)
    (param name String)
    ; An interface a facet names that names nothing is reported (`missing-type`), and so is a class, a
    ; struct or a tuple, which a facet, part of its class, is not built on.
    (return-if (if (== (. facet interfaces count) 0)))
    (let env (call holder-env (call DeclRef module decl)))
    (for (in interface ([] (. ([] (. program modules) module) syntax-pool) (. facet interfaces)))
      (if (not (call report-missing-type interface env))
        (let named (call (. types evaluate-type) module tree interface env))
        (let kind (if-expr (!= named invalid-type) (call (. types intrinsic-of) named) (. IntrinsicKind none)))
        (if (or (== kind .class) (== kind .struct) (== kind .tuple))
          (let shown (call type-short-name types named))
          (let text
            (paragraph
              (str name " cannot implement " shown ", which is not an interface; a facet is part of its class and is built on no type")
            )
          )
          (call (. frame diagnose) interface .stated (call (. program store-atom) text))
        )
      )
    )
    (call (. types env-release) env)
  )
  (fn-do _ check-facet-shape _
    (param facet ExtensionDecl)
    (param name String)
    ; What a facet may not hold, in what it writes and in what it declares.
    (match? ([] (. tree nodes) (. facet syntax))
      (case (call .node-class-block row)
        (if (!= (. row type-args count) 0)
          (let message (str name " is a facet, so it takes no type parameters"))
          (call (. frame diagnose) (. facet syntax) .stated (call (. program store-atom) message))
        )
        (if (!= (. row base) 0)
          (let message (str name " is a facet, part of its owner, so it derives from no class"))
          (call (. frame diagnose) (. row base) .stated (call (. program store-atom) message))
        )
        (for (in member ([] (. tree children) (. row members)))
          (let shown
            (match ([] (. tree nodes) member)
              (case .node-content-block
                (str name " is a facet, so it writes no markup; a content section is its owner's alone")
              )
              (default
                ""
              )
            )
          )
          (if (!= (. shown length) 0)
            (call (. frame diagnose) member .stated (call (. program store-atom) shown))
          )
        )
      )
    )
    (let target ([] (. program modules) module))
    (for (in member ([] (. target member-pool) (. facet members)))
      (match? ([] (. target decls) member)
        (case (call .decl-function fn)
          (if (call is-constructor-kind (. fn kind))
            (let message
              (paragraph
                (str name " is a facet, so it has no constructors; its owner's give its properties their first values")
              )
            )
            (call (. frame diagnose) (. fn syntax) .stated (call (. program store-atom) message))
            (else-if (. fn is-static)
              (let message (str name " is a facet, so it has no static functions"))
              (call (. frame diagnose) (. fn syntax) .stated (call (. program store-atom) message))
            )
          )
        )
        (case (call .decl-property property)
          (if (and (== (. property value) 0) (. property name) (not (call starts-empty (. property type-syntax))))
            (let message
              (paragraph
                (str (. property name text) " needs a value or an optional type, since " name " is a facet and no constructor gives it one")
              )
            )
            (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
          )
        )
      )
    )
  )
  (fn-do _ starts-empty Bool
    (param written SyntaxId)
    ; Whether a facet's property of a type written may start with no value: an optional type, or one
    ; that names nothing, which is reported where it is written.
    (return-if false (if (== written 0)))
    (call (. types clear-fault))
    (let made (call (. types evaluate-type) module tree written (. frame env)))
    (call (. types clear-fault))
    (return (or (== made invalid-type) (call (. types is-optional) made)))
  )
  (fn-do _ check-facet-names _
    (param index U32)
    (param facet ExtensionDecl)
    (param name String)
    ; A facet's member may not take a name its class, or a class above it or a facet of one, declares;
    ; nor may one that is not private take the name of such a member of another facet of the class.
    (let facets (. program facets))
    (let owner-ref (call DeclRef ([] (. facets owner-modules) index) ([] (. facets owner-decls) index)))
    (let owner (call (. types plain-class) (. owner-ref module) (. owner-ref decl)))
    (let target ([] (. program modules) module))
    (let (tuple start end) (call (. facets class-range) (. owner-ref module) (. owner-ref decl)))
    (for (in member ([] (. target member-pool) (. facet members)))
      (let (tuple named is-shared site) (call (. target member-name) member))
      (if (not named)
        (continue)
      )
      (let declared named)
      (let level (? TypeId) owner)
      (let taken false)
      (while (and level (not taken))
        (let ref (call class-ref types level))
        (let above (and (!= level owner) (call facet-declares ref declared)))
        (= taken (or above (call declares-name (. ref module) (. ref decl) declared false)))
        (= level (call (. types base-of) level))
      )
      (if taken
        (let message
          (paragraph
            (str (. declared text) " is already a member of " (call class-name-of owner-ref) ", so facet " name " can't declare it")
          )
        )
        (call (. frame diagnose) site .stated (call (. program store-atom) message))
        (continue)
      )
      (if (not is-shared)
        (continue)
      )
      (let event (is ([] (. target decls) member) .decl-event))
      (for (in position (..< start end))
        (let other ([] (. facets class-facets) position))
        (let shared (call declares-name ([] (. facets modules) other) ([] (. facets decls) other) declared (not event)))
        (if (and (!= other index) shared)
          (let other-name (call facet-name-of other))
          (let reason (if-expr event "an event's name is its class's alone, private or not" "a facet's members that are not private are its class's, so a name is one facet's"))
          (let message
            (paragraph
              (str "Facets " name " and " other-name " of " (call class-name-of owner-ref) " both declare " (. declared text) "; " reason)
            )
          )
          (call (. frame diagnose) site .stated (call (. program store-atom) message))
        )
      )
    )
  )
  (fn-do _ facet-declares Bool
    (param ref DeclRef)
    (param name Atom)
    ; Whether a facet of a class declares a member of a name that is not private.
    (let facets (. program facets))
    (let (tuple start end) (call (. facets class-range) (. ref module) (. ref decl)))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (return-if true (if (call declares-name ([] (. facets modules) facet) ([] (. facets decls) facet) name true)))
    )
    (return false)
  )
  (fn-do _ check-base _
    (param decl DeclId)
    (param class ClassDecl)
    ; A type cannot derive from a function type by name, nor from a type no value is an instance
    ; of in its own right. A base written that names nothing, as one declared in a module this one
    ; does not import, is reported (`missing-type`); `check-derived-sheet` reports a style sheet's.
    (if (== (. class base) 0)
      (return)
    )
    (let named (call (. types type-syntax-name) tree (. class base)))
    (let illegal (and (!= named null) (or (== named (!! (. types function-atom))) (== named (!! (. types cfunction-atom))))))
    (if (not illegal)
      (let env (call (. types class-env) module decl))
      (let sole (and (== (. class or-bases count) 0) (not (call is-sheet-decl module decl))))
      (let missing (and sole (call report-missing-type (. class base) env)))
      (for (in alternative ([] (. tree children) (. class or-bases)))
        (= missing (or missing (call report-missing-type alternative env)))
      )
      (let base (call (. types evaluate-type) module tree (. class base) env))
      (call (. types env-release) env)
      (return-if (if missing))
      (= illegal (and (!= base invalid-type) (call is-illegal-base (call (. types intrinsic-of) base))))
    )
    (if illegal
      (call (. frame diagnose) (. class syntax) .stated (call (. program store-atom) "Type has illegal base class"))
    )
  )
  (fn-do _ check-interfaces _
    (param decl DeclId)
    (param class ClassDecl)
    ; An interface written that names nothing, as one declared in a module this one does not import,
    ; is reported (`missing-type`). A row that names a class, a struct or a tuple names no interface:
    ; the type it is built on is written in its header, and it has one.
    (if (== (. class interfaces count) 0)
      (return)
    )
    (let env (call (. types class-env) module decl))
    (for (in interface ([] (. ([] (. program modules) module) syntax-pool) (. class interfaces)))
      (if (not (call report-missing-type interface env))
        (let named (call (. types evaluate-type) module tree interface env))
        (let kind (if-expr (!= named invalid-type) (call (. types intrinsic-of) named) (. IntrinsicKind none)))
        (if (or (== kind .class) (== kind .struct) (== kind .tuple))
          (let shown (call type-short-name types named))
          (let lead (str (. class name text) " cannot implement " shown ", which is not an interface"))
          (let base
            (block
              (case? (!= (. class base) 0)
                (call (. types evaluate-type) module tree (. class base) env)
              )
              (default
                no-type
              )
            )
          )
          (let text (if-expr (or (== base no-type) (== base invalid-type)) (str lead "; a type is built on one type, written in its header, as in \"+ " (. class name text) " is " shown "\"") (str lead "; " (. class name text) " is built on " (call type-short-name types base) ", and a type is built on one type")))
          (call (. frame diagnose) interface .stated (call (. program store-atom) text))
        )
      )
    )
    (call (. types env-release) env)
  )
  (fn-do _ check-property _
    (param decl DeclId)
    (param property PropertyDecl)
    ; A property a type declares for itself has one declaration, a type or a value to take its
    ; type from, or a line of the class's markup that gives it one (`content-property`), and a way
    ; of being stored that the type's layout can hold. A type written for it that names nothing is
    ; reported (`missing-type`). The flag of a case of a machine that refines the machine of its
    ; base's property is the base's, and so is the projection of one that refines a machine of its
    ; base's markup. An interface stores nothing: what it requires of the types that are it is a
    ; getter.
    (if (or (== (. property owner) 0) (not (. property name)))
      (return)
    )
    (let name (. property name))
    (let storage (if-expr (. property is-lazy) (. StorageKind storage-lazy) (. StorageKind storage-eager)))
    (let typed
      (scope (or stated (!= (. property context) 0) (!= (. property line) 0))
        (lazy stated (or (!= (. property type-syntax) 0) (!= (. property flag) 0)))
      )
    )
    (= typed (or typed (!= (. property part) 0) (!= (. property projection) 0)))
    (if (not (call check-member decl (. property owner) name (. property syntax) storage plainly-typed))
      (return)
    )
    (lazy plainly-typed (and typed (== (. property flag) 0) (== (. property projection) 0)))
    (if (!= (. property type-syntax) 0)
      (let env (call (. types class-env) module (. property owner)))
      (let reported (call report-missing-type (. property type-syntax) env))
      (call (. types env-release) env)
      (return-if (if reported))
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module (. property owner) mark))
    (if (== owner invalid-type)
      (return)
    )
    (let kind (call (. types intrinsic-of) owner))
    (if (== kind .interface)
      (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) (call stored-interface-text property)))
      (return)
    )
    (if (and (== kind .struct) (!= (. property value) 0))
      (match? ([] (. tree nodes) (. property value))
        (case .node-state-machine
          (let message "State machine properties are not supported on structs")
          (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
          (return)
        )
      )
    )
    (if (and (not typed) (== (. property value) 0))
      (let shown (call type-short-name types owner))
      (let message (str "Property '" (. name text) "' of '" shown "' needs either a type or a value"))
      (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ check-union-member _
    (param owner-decl DeclId)
    (param name Atom)
    (param syntax SyntaxId)
    (param stored Bool)
    ; A union holds one of its cases and nothing more, so it declares only getters, and none
    ; under a name every union already answers to.
    (let owned
      (match ([] (. ([] (. program modules) module) decls) owner-decl)
        (case .decl-class
          true
        )
        (default
          false
        )
      )
    )
    (if (not owned)
      (return)
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module owner-decl mark))
    (if (or (== owner invalid-type) (!= (call (. types intrinsic-of) owner) .union))
      (return)
    )
    (if stored
      (let message (call (. program store-atom) "Unions can only declare getter properties"))
      (call (. frame diagnose) syntax .stated message)
      (return)
    )
    (let label (. name text))
    (if (or (== label "case") (== label "name") (== label "type"))
      (let message (str "Union property '" label "' conflicts with reserved union property"))
      (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ check-member Bool
    (param decl DeclId)
    (param owner-decl DeclId)
    (param name Atom)
    (param syntax SyntaxId)
    (param storage StorageKind)
    (param typed Bool)
    ; Checks a property or getter against the others of its name: one the same type declares
    ; before it, which `declare-members` reported, and one the type inherits, which it may restate
    ; only stored the same way and without a type of its own. A state case that restates an inherited
    ; case is a refinement's to check (`refines-shaped`). Says whether the member stands.
    (let decls (. ([] (. program modules) module) decls))
    (match ([] decls owner-decl)
      (case (call .decl-class class)
        (if (!= storage .storage-getter)
          (for (in member (call (. ([] (. program modules) module) members-named) (. class members) name))
            (match? ([] decls member)
              (case (call .decl-property other)
                (if (and (< member decl) (. other name) (== (. other name) name))
                  (return false)
                )
              )
              (case (call .decl-event other)
                (if (and (< member decl) (== (. other name) name))
                  (return false)
                )
              )
            )
          )
        )
      )
      (default
        (return true)
      )
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module owner-decl mark))
    (if (== owner invalid-type)
      (return true)
    )
    (call (. types complete) owner)
    (let base (?? (call (. types base-of) owner) no-type))
    (if (and (!= base no-type) (call declares-event base name))
      (let message (str "Inherited event \"" (. name text) "\" cannot be redeclared as a property"))
      (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
      (return false)
    )
    (let inherited (only-if (call property-named base name) (if (!= base no-type))))
    (if (and inherited (is ([] (. tree nodes) syntax) .node-state-case))
      (return true)
    )
    (if inherited
      (if (!= (. ([] (. types properties) inherited) storage-kind) storage)
        (let message "Inherited properties must have same assignment type")
        (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
        (return false)
      )
      (if (and typed (or (!= storage .storage-getter) (call states-getter-type base name)))
        (let message "Illegal to redefine type of inherited property")
        (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
        (return false)
      )
      (return true)
    )
    (let kind (call (. types intrinsic-of) owner))
    (let stores (!= storage .storage-getter))
    (let unsupported (and stores (call intrinsic-is-numeric kind)))
    (if (and (== storage .storage-lazy) (or (== kind .tuple) (== kind .struct)))
      (= unsupported true)
    )
    (if unsupported
      (call (. frame diagnose) syntax .stated (call (. program store-atom) "Property not supported"))
      (return false)
    )
    (return true)
  )
  (fn-do _ check-inherited-method _
    (param owner-decl DeclId)
    (param name Atom)
    (param syntax SyntaxId)
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module owner-decl mark))
    (if (== owner invalid-type)
      (return)
    )
    (call (. types complete) owner)
    (let base (?? (call (. types base-of) owner) no-type))
    (if (and (!= base no-type) (call declares-event base name))
      (let message (str "Inherited event \"" (. name text) "\" cannot be redeclared as a method"))
      (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ check-inherited-event _
    (param event EventDecl)
    ; An event may not take the name of a property or an event its class inherits, and its types are
    ; as `check-event-types` says. One whose class took its name before is checked no further, as
    ; `declare-members` reported it.
    (let decls (. ([] (. program modules) module) decls))
    (match? ([] decls (. event owner))
      (case (call .decl-class class)
        (for (in member (call (. ([] (. program modules) module) members-named) (. class members) (. event name)))
          (let earlier
            (match ([] decls member)
              (case (call .decl-property other)
                (and (< (. other syntax) (. event syntax)) (. other name) (== (. other name) (. event name)))
              )
              (case (call .decl-event other)
                (and (< (. other syntax) (. event syntax)) (== (. other name) (. event name)))
              )
              (case (call .decl-associated other)
                (and (< (. other syntax) (. event syntax)) (== (. other name) (. event name)))
              )
              (default
                false
              )
            )
          )
          (if earlier
            (return)
          )
        )
      )
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module (. event owner) mark))
    (if (== owner invalid-type)
      (return)
    )
    (call (. types complete) owner)
    (let base (?? (call (. types base-of) owner) no-type))
    (if (and (!= base no-type) (!= (call property-named base (. event name)) null))
      (let message (str "Inherited property \"" (. event name text) "\" cannot be redeclared as an event"))
      (call (. frame diagnose) (. event syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (if (and (!= base no-type) (call declares-event base (. event name)))
      (let message (str "Inherited event \"" (. event name text) "\" cannot be redeclared"))
      (call (. frame diagnose) (. event syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (if (and (!= base no-type) (call declares-method base (. event name)))
      (let message (str "Inherited method \"" (. event name text) "\" cannot be redeclared as an event"))
      (call (. frame diagnose) (. event syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (call check-event-types event owner)
  )
  (fn-do _ check-event-types _
    (param event EventDecl)
    (param owner TypeId)
    ; What an event publishes is a type other than `Void`, and the key it is published by, where it
    ; has one, is an `EventKey` (see `event-key`).
    (let payload (call declared-payload owner (. event type-syntax) module))
    (if (== payload no-type)
      (if (not (call report-missing-type (. event type-syntax) (. frame env)))
        (call decline (. event syntax))
      )
      (return)
    )
    (if (== payload (. types void-type))
      (let message
        (paragraph
          (str "An event gives each subscriber a value, so it cannot carry Void; an event that only signals carries Bool, as in \"+ event " (. event name text) " Bool\"")
        )
      )
      (call (. frame diagnose) (. event type-syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (if (== (. event key-type) 0)
      (return)
    )
    (let key (call declared-payload owner (. event key-type) module))
    (if (== key no-type)
      (if (not (call report-missing-type (. event key-type) (. frame env)))
        (call decline (. event syntax))
      )
      (return)
    )
    (if (not (call event-key key))
      (let message
        (paragraph
          "Keyed event keys must conform to EventKey: integer, Char, Bool, interned identity, or an integer (index, generation) handle; Float and user-defined equality/hash keys are not supported"
        )
      )
      (call (. frame diagnose) (. event syntax) .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ check-getter-annotations _
    (param syntax SyntaxId)
    ; A getter stores nothing, so no property annotation applies to it.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-function-syntax row)
        (if (!= (. row property-annotations count) 0)
          (call report-annotation (. row property-site) ([] (. tree atoms) (. row property-annotations start)))
        )
      )
    )
  )
  (fn-do _ check-return-mode _
    (param decl DeclId)
    (param returns SyntaxId)
    ; A function that is not `do` is one expression, which the reference checks as it declares the
    ; function, whether or not anything calls it: its body returns nowhere explicitly, and outside
    ; a `do` block it declares nothing immediately, loops nowhere and yields nothing, apart from
    ; in the functions, tasks and deferred blocks written in it. One written to give `Void` gives
    ; nothing. Closures are checked where they are typed (`require-do`).
    (let described (call describe program module decl))
    (if (or (not described) (not (call checks-at-declaration described)))
      (return)
    )
    (let body (. described body))
    (let returned (call (. tree first-unexpressed) body false))
    (if (!= returned 0)
      (call (. frame diagnose) returned .explicit-return-requires-do)
      (return)
    )
    (let statement (call (. tree first-unexpressed) body true))
    (if (!= statement 0)
      (call (. frame diagnose) statement .stated (call (. program store-atom) (call (. tree requires-do-text) statement)))
      (return)
    )
    (let stated (call first-stated body))
    (if (!= stated 0)
      (call (. frame diagnose) stated .stated (call (. program store-atom) (call (. tree requires-do-text) stated)))
      (return)
    )
    (match? ([] (. tree nodes) returns)
      (case (call .node-type-identifier row)
        (if (== (. row name text) "Void")
          (call (. frame diagnose) (. described syntax) .non-void-return)
        )
      )
    )
  )
  (fn-do _ check-keyed-name Bool
    (param property PropertyDecl)
    (let name (. property name))
    (return-if true (if (or (not name) (== (call (. name text find) ".") null))))
    (if (!= (. property owner) 0)
      (let mark (. scratch types mark))
      (let owner (call (. types class-pattern-with-args) module (. property owner) mark))
      (return-if true (if (or (== owner invalid-type) (== (call (. types intrinsic-of) owner) .style))))
    )
    (let message (str "Only a Style may declare a keyed property such as \"" (. name text) "\""))
    (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
    (return false)
  )
  (fn-do _ check-annotations _
    (param property PropertyDecl)
    ; `@hot` marks an eager stored field of a tuple-layout type that does not hold a delegate;
    ; no other annotation is known outside a style.
    (let annotations (call (of RowRange Atom)))
    (match? ([] (. tree nodes) (. property syntax))
      (case (call .node-property-syntax row)
        (= annotations (. row annotations))
      )
    )
    (if (== (. annotations count) 0)
      (return)
    )
    (if (== (. property owner) 0)
      (call report-annotation (. property syntax) ([] (. tree atoms) (. annotations start)))
      (return)
    )
    (let mark (. scratch types mark))
    (let owner (call (. types class-pattern-with-args) module (. property owner) mark))
    (if (== owner invalid-type)
      (return)
    )
    (let kind (call (. types intrinsic-of) owner))
    (let tuple-layout (call intrinsic-is-tuple-like kind))
    (for (in offset (..< 0 (. annotations count)))
      (let annotation ([] (. tree atoms) (+ (. annotations start) offset)))
      (if (== (. annotation text) "hot")
        (let eager (and (not (. property is-lazy)) (== (. property delegates count) 0)))
        (if (or (not tuple-layout) (not eager))
          (call report-annotation (. property syntax) annotation)
          (return)
        )
        (else-if (!= kind .style)
          (call report-annotation (. property syntax) annotation)
          (return)
        )
      )
    )
  )
  (fn-do _ report-annotation _
    (param syntax SyntaxId)
    (param annotation Atom)
    (let label (. annotation text))
    (let message (str "Unknown property annotation \"@" label "\"; only \"@hot\" is supported on eager "))
    (++= message "tuple fields")
    (if (== label "hot")
      (= message "Property annotation \"@hot\" requires an eager stored field on a tuple-layout type")
    )
    (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
  )
  (fn-do _ check-argument-shapes _
    (param args (of RowRange ArgumentShape))
    ; The shape rules of a declaration's arguments: nothing follows a variadic argument, and once
    ; an argument has a default every later one needs one.
    (let defaulted false)
    (let variadic false)
    (for (in shape ([] (. ([] (. program modules) module) arg-pool) args))
      (if variadic
        (let message "Variadic arguments must be the last one")
        (call (. frame diagnose) (. shape pattern) .stated (call (. program store-atom) message))
        (return)
      )
      (= variadic (. shape is-variadic))
      (if (. shape has-default)
        (= defaulted true)
        (else-if defaulted
          (call (. frame diagnose) (. shape pattern) .stated (call (. program store-atom) "Default value required"))
          (return)
        )
      )
    )
  )
  (fn-do _ check-duplicate _
    (param decl DeclId)
    (param fn FunctionDecl)
    ; A module or a type defines a function of one name and one signature once.
    (if (or (== (. fn body) 0) (not (. fn name)))
      (return)
    )
    (let fn-name (. fn name))
    (let target ([] (. program modules) module))
    (let repeated false)
    (if (== (. fn owner) 0)
      (for (in candidate (call (. program lookup) module fn-name))
        (if (and (== (. candidate module) module) (< (. candidate decl) decl))
          (= repeated (or repeated (call same-definition (. candidate decl) fn)))
        )
      )
      (else
        (match? ([] (. target decls) (. fn owner))
          (case (call .decl-class class)
            (for (in member (call (. target members-named) (. class members) fn-name))
              (if (< member decl)
                (= repeated (or repeated (call same-definition member fn)))
              )
            )
          )
        )
      )
    )
    (if repeated
      (let message (str "Duplicate definition of " (. fn-name text) " with the same signature"))
      (call (. frame diagnose) (. fn syntax) .stated (call (. program store-atom) message))
    )
  )
  (fn-do _ same-definition Bool
    (param other DeclId)
    (param fn FunctionDecl)
    (let target ([] (. program modules) module))
    (match? ([] (. target decls) other)
      (case (call .decl-function row)
        (if (or (== (. row body) 0) (not (. row name)) (!= (. row name) (!! (. fn name))) (!= (. row kind) (. fn kind)))
          (return false)
        )
        (if (or (!= (. row owner) (. fn owner)) (!= (. row is-static) (. fn is-static)))
          (return false)
        )
        (if (or (!= (. row type-args count) (. fn type-args count)) (!= (. row args count) (. fn args count)))
          (return false)
        )
        (if (not (call (. tree same-syntax) (. row return-type) (. fn return-type)))
          (return false)
        )
        (if (not (call (. tree same-syntaxes) (. row param-constraints) (. fn param-constraints)))
          (return false)
        )
        (for (in offset (..< 0 (. fn args count)))
          (let mine ([] (. target arg-pool) (+ (. fn args start) offset)))
          (let theirs ([] (. target arg-pool) (+ (. row args start) offset)))
          (if (or (!= (. mine is-variadic) (. theirs is-variadic)) (not (call same-atom (. mine name) (. theirs name))))
            (return false)
          )
          (if (not (call (. tree same-syntax) (. mine type-syntax) (. theirs type-syntax)))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ check-type-params _
    (param fn FunctionDecl)
    ; A type parameter an argument declares in passing cannot repeat one the function names.
    (let names (list Atom))
    (for (in param ([] (. tree children) (. fn type-args)))
      (let named (call (. types type-syntax-name) tree param))
      (if named
        (+= names named)
      )
    )
    (for (in shape ([] (. ([] (. program modules) module) arg-pool) (. fn args)))
      (if (and (!= (. shape pattern) 0) (call repeats-param (. shape pattern) names))
        (return)
      )
    )
  )
  (fn-do _ repeats-param Bool
    (param id SyntaxId)
    (param names (list Atom))
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (if (. row is-declare)
          (if (!= (call (. names find) (. row name)) null)
            (call (. frame diagnose) id .stated (call (. program store-atom) "Duplicate type parameter"))
            (return true)
          )
          (+= names (. row name))
        )
      )
    )
    (for (in child (call (. tree children-of) id))
      (if (call repeats-param child names)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ check-module-property _
    (param property DeclId)
    (param initializer SyntaxId)
    (param annotation SyntaxId)
    (let value (call infer initializer))
    (if (or (== annotation 0) (== value invalid-type) (== value no-type))
      (return)
    )
    (let declared (call (. types evaluate-type) module tree annotation (. frame env)))
    (call note-declared-value 0 property initializer annotation declared value)
    (if (and (!= declared invalid-type) (!= declared value))
      (call (. conversions convert) initializer initializer value declared .reason-declaration)
    )
  )
  (fn-do _ is-object-construction Bool
    (param initializer SyntaxId)
    (match? ([] (. tree nodes) initializer)
      (case (call .node-call-expression call)
        (let resolution (call (. bindings resolution-of) (. frame binding) (. call callable)))
        (if (== (. resolution kind) .resolve-type)
          (return (call is-object-class (. resolution module) (. resolution decl)))
        )
      )
    )
    (return false)
  )
  (fn-do _ is-object-class Bool
    (param class-module ModuleId)
    (param class-decl DeclId)
    (match? ([] (. ([] (. program modules) class-module) decls) class-decl)
      (case (call .decl-class row)
        (if (!= (. row type-args count) 0)
          (let env (call (. types class-env) class-module class-decl))
          (let pattern (. env this-type))
          (call (. types env-release) env)
          (return (== (call (. types intrinsic-of) pattern) .class))
        )
        (let type (call (. types class-with-args) class-module class-decl (. scratch types mark)))
        (call (. types complete) type)
        (return (== (call (. types intrinsic-of) type) .class))
      )
    )
    (return false)
  )
  (fn-expr _ is-enum-owner Bool
    (param owner DeclId)
    (match ([] (. ([] (. program modules) module) decls) owner)
      (case (call .decl-class row)
        (!= (. row base) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do _ check-case _
    (param about TypeId)
    (param name Atom)
    (param written SyntaxId)
    (param declared SyntaxId)
    ; A case's value is converted to its enum once, where the case is declared, however many
    ; places name the case. One a constructor of the enum makes has the call recorded there
    ; instead, with the value written as its argument. The value of a case of a union is held as
    ; that case, though another case holds the same type.
    (let literal (call enum-case-type about name))
    (if (and (== literal invalid-type) (!= written 0))
      (= literal (call written-type written))
    )
    (if (or (== literal no-type) (== literal invalid-type) (== literal about))
      (return)
    )
    (if (and (not (call is-numeric types about)) (!= (call (. types intrinsic-of) about) .union))
      (let mark (. scratch types mark))
      (if (!= written 0)
        (call (. scratch types push) literal)
      )
      (let callee (call (. calls demand-constructor) about mark))
      (call (. scratch types rewind) mark)
      (if (!= callee no-instance)
        (if (!= written 0)
          (call written-type written)
        )
        (call make-case declared about written literal)
        (return)
      )
    )
    (let relation (call (. relations compare) literal about false false null module))
    (if (and (!= written 0) (not (call relation-legal relation)))
      (call (. facts record-diagnostic) instance module written .illegal-cast null literal about)
      (return)
    )
    (let site (if-expr (!= written 0) written declared))
    (if (== (call (. types intrinsic-of) about) .union)
      (let position U32)
      (for (in fact (call (. types cases-of) about))
        (if (and (. fact name) (== (!! (. fact name)) name))
          (call (. conversions convert-into-case) site literal about position .reason-assignment)
          (return)
        )
        (+= position 1)
      )
    )
    (call (. conversions convert) site site literal about .reason-assignment true true)
  )
  (fn-do _ make-case _
    (param declared SyntaxId)
    (param about TypeId)
    (param written SyntaxId)
    (param literal TypeId)
    ; Records, where a case is declared, the call of the constructor of its enum that makes its
    ; value: given the value written for the case, or nothing.
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (if (!= written 0)
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) literal)
      (call (. scratch syntax push) written)
    )
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (call (. calls construction-on) declared about arguments)
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
  )
  (fn-do _ written-type TypeId
    (param written SyntaxId)
    ; The type of a value written for a case that is no literal: as the module's main typed it
    ; where it did, and else typed here.
    (let main (call (. instances intern) module (. ([] (. program modules) module) main-decl) no-type 0 no-instance))
    (let typed (call (. facts node-type) main written))
    (return (if-expr (!= typed no-type) typed (call infer written)))
  )
  (fn-expr + initializes-early Bool
    ; Whether the value being typed is that of a global each task or each thread holds its own
    ; of, or that `do with` binds: one that takes its value before the module's other globals.
    (case? (== initializing 0)
      false
    )
    (default
      (or (call is-task-local module initializing) (call is-thread-local module initializing) stack-bound)
    )
    (where
      (lazy stack-bound (call is-stack-global module initializing))
    )
  )
  (fn-do _ enum-case-type TypeId
    (param about TypeId)
    (param name Atom)
    ; The type of the value a case of an enum is written with, a number with no unit by its
    ; magnitude, as the number is typed where it is written.
    (let value (call enum-case-value about name))
    (if (not value)
      (return no-type)
    )
    (if (== value 0)
      (return (call (. types type-row) .int64))
    )
    (let ref (call class-ref types about))
    (let env (call (. types env-frame)))
    (let tree (. ([] (. program modules) (. ref module)) tree))
    (match? ([] (. tree nodes) value)
      (case (call .node-integer-syntax row)
        (if (not (. row unit))
          (return (call magnitude-type types (call parse-integer-literal (. row value))))
        )
      )
    )
    (return (call literal-type types (. ref module) tree value env))
  )
  (fn-do + check-initializer-reads _
    ; A field's initializer runs before the constructor's body, so one that reads a field the body
    ; assigns would read it from before the assignment: an error, at the read. The body assigns a
    ; field by its name or through `this`, apart from nested functions, `for ... on` loops and the
    ; names it declares.
    (let assigned (list Atom))
    (let declared (list Atom))
    (for (in statement ([] (. tree children) (call body-statements)))
      (if (not (call (. tree is-lazy-declare) statement))
        (call collect-assigned statement assigned declared)
      )
    )
    (let fields (list Atom))
    (for (in name assigned)
      (if (and (== (call (. declared find) name) null) (call property-named (. frame self-type) name))
        (+= fields name)
      )
    )
    (if (== (. fields length) 0)
      (return)
    )
    (for (in statement ([] (. tree children) (call body-statements)))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (let name (only-if (call pattern-name types tree (. row left)) (if (. row is-lazy))))
          (if (and name (call property-named (. frame self-type) name))
            (let read (call field-read (. row right) fields))
            (if (!= read 0)
              (let field (!! (call field-reference read)))
              (let assigns "before the constructor body assigns it")
              (let runs "constructor .. initializers run before the body")
              (let text (str "Initializer of " (. name text) " reads " (. field text) " " assigns "; " runs))
              (call (. frame diagnose) read .stated (call (. program store-atom) text))
              (return)
            )
          )
        )
      )
    )
  )
  (fn-do _ field-read SyntaxId
    (param id SyntaxId)
    (param fields (list Atom))
    ; The first read, in the order its value is evaluated, of one of the fields named.
    (match? ([] (. tree nodes) id)
      (case .node-function-syntax
        (return 0)
      )
    )
    (for (in child (call (. tree children-of) id))
      (let found (call field-read child fields))
      (if (!= found 0)
        (return found)
      )
    )
    (let name (call field-reference id))
    (return (if-expr (and name (!= (call (. fields find) name) null)) id 0))
  )
  (fn-do + is-constructor-initializer Bool
    (param name Atom)
    (for (in statement ([] (. tree children) (call body-statements)))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (let slot (only-if (call declaring-slot (. row left)) (if (. row is-lazy))))
          (if (and slot (== (. ([] (. bindings slots) slot) name) name))
            (return true)
          )
        )
      )
    )
    (return false)
  )
)

(fn-expr _ path-file String
  (param path String)
  (case? (call (. path find-reverse) "/")
    ([] path (... (+ (!! it) 1)))
  )
  (default
    path
  )
)

(fn-expr _ same-atom Bool
  (param left (? Atom))
  (param right (? Atom))
  (case? (or (== left null) (== right null))
    (and (== left null) (== right null))
  )
  (default
    (== left right)
  )
)
