(import ./conversions)
(import ./dispatch)
(import ./facts)
(import ./frame)
(import ./idmap)
(import ./instances)
(import ./method-results)
(import ./pair-order)
(import ./portable)
(import ./session)
(import ./shared-results)
(import ./signature)
(import ./stable-key)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/map)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + Override (is Struct)
  ; A method that answers for a base's in a class's table, and the place of its fact among
  ; the facts' overrides.
  (blank)
  (prop + method InstanceId)
  (prop + base InstanceId)
  (prop + fact U32)
)

(type + ClassTables
  (prop + types Types)
  (prop + program Program)
  (prop + instances Instances)
  (prop _ ranking Ranking)
  (prop _ scratch TypingScratch)
  (prop _ instances-scanned Size (= 0))
  (prop _ types-scanned Size (= 0))
  (prop _ methods-scanned Size (= 0))
  (prop _ classes-scanned Size (= 0))
  (prop _ methods-shared Size (= 0))
  (prop _ classes-shared Size (= 0))
  (prop _ methods-taken Size (= 0))
  (prop _ classes-taken Size (= 0))
  (prop _ methods (list InstanceId))
  (prop _ method-heads (list U32))
  (prop _ method-links (list U32))
  (prop _ classes (list TypeId))
  (prop _ child-heads (list U32))
  (prop _ child-links (list U32))
  (prop _ answers IdMap)
  (prop _ answered (list InstanceId))
  (prop _ answer-key (of Array U32 ArenaBacking))
  (prop _ converters (list InstanceId))
  (prop _ converter-classes (list Size))
  (prop _ unsettled (list TypeId))
  (prop _ overrides (list Override))
  (prop _ adapted (list U64))
  (prop _ extension-names (of Map Atom Bool))
  (prop _ frame Frame)
  (prop _ conversions Conversions)
  (prop _ session Session)
  (prop _ host (? Demander) (= null))
  (fn-do + This _
    (param typing Session)
    (lazy session typing)
    (lazy types (. session types))
    (lazy program (. session program))
    (lazy instances (. session instances))
    (lazy ranking (call Ranking session 0))
    (lazy scratch (. session scratch))
    (lazy answer-key (call (of Array U32) (. instances arena) 16))
    (lazy frame (call Frame session))
    (lazy conversions (call Conversions frame))
    (lazy extension-names (call name-extensions program))
  )
  (fn-do + release _
    (call (. answers release))
  )
  (fn-do + expand _
    (param demander Demander)
    ; Finds the methods that answer for others in the tables of classes (`find-overrides`), and
    ; checks each against the one it answers for once both are typed. The demander types what the
    ; conversion of an override's answer calls.
    (= host demander)
    (call find-overrides)
    (let waiting (list Override))
    (for (in item overrides)
      (if (and (call settled (. item method)) (call settled (. item base)))
        (let retyped (call check-override item))
        (if (!= retyped no-instance)
          (+= waiting (call Override retyped (. item base) (. item fact)))
        )
        (else
          (+= waiting item)
        )
      )
    )
    (= overrides waiting)
    (= host null)
  )
  (fn-do + find-overrides _
    ; Types each method again for each class below its own, once for each such pair, in the
    ; order of the methods and then of the classes. A class newly listed takes the methods of
    ; every class above it, found by going up its bases. A method newly listed takes the classes
    ; listed before below its class, found by going down from it. So the work is as large as the
    ; pairs are many, and not as the methods times the classes. In a parallel type pass, the
    ; methods and the classes of the other passes are listed too (`share-tables`).
    (call list-tables)
    (if (. session shared)
      (call share-tables)
      (call list-tables)
    )
    (for (in position (..< methods-scanned (. methods length)))
      (let owner (. ([] (. instances rows) ([] methods position)) self-type))
      (= ([] method-links position) ([] method-heads owner))
      (= ([] method-heads owner) (as (+ position 1) U32))
    )
    (let methods-before methods-scanned)
    (let classes-before classes-scanned)
    (= methods-scanned (. methods length))
    (= classes-scanned (. classes length))
    (let pairs (list U64))
    (for (in offset (..< classes-before classes-scanned))
      (let level (call (. types base-of) ([] classes offset)))
      (while level
        (let method ([] method-heads level))
        (while (!= method 0)
          (let wide U64 (- method 1))
          (+= pairs (/or/ (/lshift/ wide 32) (as offset U64)))
          (= method ([] method-links (- method 1)))
        )
        (= level (call (. types base-of) level))
      )
    )
    (let open (list U32))
    (for (in position (..< methods-before methods-scanned))
      (let wide (as position U64))
      (+= open ([] child-heads (. ([] (. instances rows) ([] methods position)) self-type)))
      (while (!= (. open length) 0)
        (let child ([] open (- (. open length) 1)))
        (call (. open pop))
        (while (!= child 0)
          (let offset (- child 1))
          (if (< offset classes-before)
            (+= pairs (/or/ (/lshift/ wide 32) offset))
          )
          (+= open ([] child-heads ([] classes offset)))
          (= child ([] child-links offset))
        )
      )
    )
    (let sorted (call sorted-pairs pairs))
    (for (in pair sorted)
      (let method ([] methods (as (/rshift/ pair 32) Index)))
      (let class ([] classes (as (/and/ pair 0xffffffff) Index)))
      (if (and (call redeclares method class) (call claims method class))
        (call redispatch method class)
      )
    )
    (for (in position (..< 0 (. converters length)))
      (let converter ([] converters position))
      (if (not (call settled converter))
        (continue)
      )
      (let base (. ([] (. instances rows) converter) self-type))
      (for (in offset (..< ([] converter-classes position) (. classes length)))
        (let type ([] classes offset))
        (if (and (!= type base) (call in-base-chain types type base))
          (call redispatch-converter converter type)
        )
      )
      (= ([] converter-classes position) (. classes length))
    )
  )
  (fn-do _ list-tables _
    ; Lists the methods of classes with classes below them, and the classes completed, since last.
    (let count (. instances length))
    (for (in position (..< instances-scanned count))
      (let instance (as position InstanceId))
      (let row ([] (. instances rows) position))
      (if (call is-table-method row)
        (call declare-effects instance)
        (if (call (. types has-subclasses) (. row self-type))
          (+= methods instance)
          (+= method-links 0)
        )
      )
      (if (and (call is-table-converter row) (call (. types has-subclasses) (. row self-type)))
        (+= converters instance)
        (+= converter-classes 0)
      )
    )
    (= instances-scanned count)
    (let type-count (. types rows length))
    (while (< (. method-heads length) type-count)
      (+= method-heads 0)
      (+= child-heads 0)
    )
    (let later (list TypeId))
    (for (in type unsettled)
      (if (not (call list-class type))
        (+= later type)
      )
    )
    (for (in candidate (..< types-scanned type-count))
      (if (not (call list-class (as candidate TypeId)))
        (+= later (as candidate TypeId))
      )
    )
    (= unsettled later)
    (= types-scanned type-count)
  )
  (fn-do _ share-tables _
    ; Offers the other passes of a parallel type pass the methods and the classes listed here since
    ; last, and interns those they offered, so that a pass pairs a method one pass typed with a class
    ; another completed. Each pass offers before it takes, so of two passes that list a method and a
    ; class below its own, the one that takes last finds both.
    (let shared (!! (. session shared)))
    (for (in position (..< methods-shared (. methods length)))
      (let item (call export-instance session ([] methods position)))
      (if item
        (call (. shared offer-table-method) item)
      )
    )
    (= methods-shared (. methods length))
    (for (in position (..< classes-shared (. classes length)))
      (let item (call export-class types ([] classes position)))
      (if item
        (call (. shared offer-table-class) item)
      )
    )
    (= classes-shared (. classes length))
    (for (in item (call (. shared table-methods-from) methods-taken))
      (call import-instance session item)
      (+= methods-taken 1)
    )
    (for (in item (call (. shared table-classes-from) classes-taken))
      (call (. types complete) (call import-class types item))
      (+= classes-taken 1)
    )
  )
  (fn-do _ is-facet-of Bool
    (param module ModuleId)
    (param decl DeclId)
    (param home DeclRef)
    ; Whether a declaration is a facet bound to a class.
    (let facets (. program facets))
    (let found (call (. facets index-of) module decl))
    (return-if false (if (not found)))
    (let index found)
    (return (and (== ([] (. facets states) index) .facet-bound) (== ([] (. facets owner-modules) index) (. home module)) same-decl))
    (lazy same-decl (== ([] (. facets owner-decls) index) (. home decl)))
  )
  (fn-do _ claims Bool
    (param method InstanceId)
    (param receiver TypeId)
    ; Whether this pass is the first of a parallel type pass to type a method again for a class
    ; below its own (`SharedTyping.claim`).
    (if (not (. session shared))
      (return true)
    )
    (let key
      (call mixed
        (block
          (arg (call mixed (call mixed stable-key-seed (- (. U32 max) 7)) ([] (. instances stable-keys) method)))
          (arg (call (. types key-of) receiver))
        )
      )
    )
    (return (call (. (!! (. session shared)) claim) key))
  )
  (fn-do _ redeclares Bool
    (param method InstanceId)
    (param receiver TypeId)
    ; Whether a class, or a class above it and below the one a method is typed for, declares a member
    ; of the method's name, or an extension declares one, or the method is not one the class it is
    ; typed for or a facet of it declares: where none is, the class's objects run the method itself
    ; (`redispatch`).
    (let row ([] (. instances rows) method))
    (let name (? Atom) null)
    (let owner 0u32)
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= name (. fn name))
        (= owner (. fn owner))
      )
    )
    (let home (call class-ref types (. row self-type)))
    (let own (and (== (. home module) (. row module)) (== (. home decl) owner)))
    (if (or (not name) (!= ([] extension-names name) null) (and (not own) (not (call is-facet-of (. row module) owner home))))
      (return true)
    )
    (let level (? TypeId) receiver)
    (while level
      (if (== level (. row self-type))
        (return false)
      )
      (let ref (call class-ref types level))
      (let written ([] (. program modules) (. ref module)))
      (match? ([] (. written decls) (. ref decl))
        (case (call .decl-class class)
          (if (!= (call (. written first-member) (. class members) name) no-member)
            (return true)
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return true)
  )
  (fn-do _ list-class Bool
    (param type TypeId)
    ; Lists a type among the classes to redispatch for, once the type pass has completed it, and
    ; says whether it has. A type seen before its completion is looked at again.
    (let completion ([] (. types completions) type))
    (if (and (!= (. completion completion) .completion-done) (!= (. completion completion) .completion-failed))
      (return false)
    )
    (let base (call (. types base-of) type))
    (if (and (call intrinsic-is-class (. completion intrinsic)) (not (. completion has-variables)) base)
      (+= classes type)
      (+= child-links ([] child-heads base))
      (= ([] child-heads base) (as (. classes length) U32))
    )
    (return true)
  )
  (fn-expr _ settled Bool
    (param instance InstanceId)
    (and done (!= (. ([] (. instances signatures) instance) return-state) .return-pending))
    (where
      (lazy done (== (. ([] (. instances rows) instance) state) .instance-done))
    )
  )
  (fn-do _ check-override InstanceId
    (param item Override)
    ; A method that overrides a base class's gives what callers of the base method expect.
    ; Where it answers another type, the class's table holds a function in the base's place that
    ; converts what it answers to the base's type, as the conversion recorded at the method's
    ; declaration says, once for each type a base answers. A method that yields and states no
    ; errors, in the place of a base's whose generator carries others, is typed again stating
    ; those (see `retype-steps`), and the instance typed again is answered, to be checked in turn.
    (let retyped (call retype-steps item))
    (if (!= retyped no-instance)
      (= (. ([] (. session facts overrides) (. item fact)) override) retyped)
      (return retyped)
    )
    (call check-answer (. item method) (. item base))
    (return no-instance)
  )
  (fn-do + check-retyped _
    (param demander Demander)
    (param retired (list Bool))
    ; Checks again the answer of each override an edit typed again in place (`retype-edit`), which
    ; retiring it dropped the conversion of. The demander types what a conversion calls.
    (= host demander)
    (for (in fact (. session facts overrides))
      (if (and (< (as (. fact override) Size) (. retired length)) ([] retired (. fact override)))
        (call check-answer (. fact override) (. fact base))
      )
    )
    (= host null)
  )
  (fn-do _ check-answer _
    (param method InstanceId)
    (param base InstanceId)
    ; Checks what an override answers against what its base's does, and converts it where the two
    ; differ (`adapt-answer`). One typed again to state its base's errors (`retype-steps`) is not
    ; checked.
    (if (!= (. ([] (. instances rows) method) inherits) no-instance)
      (call adapt-answer method (. ([] (. instances signatures) base) returns))
      (return)
    )
    (let row ([] (. instances rows) base))
    (let signature ([] (. instances signatures) base))
    (let syntax 0u32)
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= syntax (. fn syntax))
      )
    )
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature errors count)))
      (call (. scratch types push) (call (. instances error-type) base offset))
    )
    (let errors (call (. scratch types since) mark))
    (let proto (call MethodProto "Base method" "method" (. row module) syntax (. signature returns) errors))
    (call check-method-result session method proto)
    (call (. scratch types rewind) mark)
    (call adapt-answer method (. signature returns))
  )
  (fn-do _ retype-steps InstanceId
    (param item Override)
    ; The instance a class's table holds in the place of a base's method whose generator carries
    ; errors, for a method that yields and states no errors and whose generator gives the same
    ; items but carries other errors, or none, when it answers the iterable of them: the method
    ; typed again stating those of the base's, as the reference's method inherits them when the
    ; base's has been compiled. None for any other.
    (let row ([] (. instances rows) (. item method)))
    (let base ([] (. instances rows) (. item base)))
    (if (or (!= (. row inherits) no-instance) (not (. row is-generator)) (not (. base is-generator)) no-base-errors)
      (return no-instance)
    )
    (lazy no-base-errors (== (. base step-errors count) 0))
    (if (== (. ([] (. instances signatures) (. item method)) error-state) .errors-stated)
      (return no-instance)
    )
    (let returned (. ([] (. instances signatures) (. item method)) returns))
    (let expected (. ([] (. instances signatures) (. item base)) returns))
    (if (or (== returned expected) (not (call same-items returned expected)))
      (return no-instance)
    )
    (let signature ([] (. instances signatures) (. item method)))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature param-count)))
      (call (. scratch types push) (call (. instances param-type) (. item method) offset))
    )
    (let params (call (. scratch types since) mark))
    (let args-mark (. scratch types mark))
    (for (in offset (..< 0 (. signature args count)))
      (call (. scratch types push) (call (. instances argument-type) (. item method) offset))
    )
    (let args (call (. scratch types since) args-mark))
    (let retyped (call (. instances intern-retyped) (. item method) (. item base) params args))
    (call (. scratch types rewind) mark)
    (return retyped)
  )
  (fn-do _ same-items Bool
    (param one TypeId)
    (param two TypeId)
    ; Whether a method answers the items of a base's generator, whatever errors each carries: as a
    ; generator, or as the iterable a method that yields and raises nothing answers.
    (let generator (. types generator-decl))
    (let iterable (. types iterable-decl))
    (match? ([] (. types rows) one)
      (case (call .type-class left)
        (match? ([] (. types rows) two)
          (case (call .type-class right)
            (let yields (and (== (. left module) (. generator module)) (== (. left decl) (. generator decl))))
            (let iterates (and (== (. left module) (. iterable module)) (== (. left decl) (. iterable decl))))
            (if (or (not (or yields iterates)) not-generator)
              (return false)
            )
            (lazy not-generator (or (!= (. right module) (. generator module)) (!= (. right decl) (. generator decl))))
            (if (!= (. right args count) (. left args count))
              (return false)
            )
            (for (in position (..< 0 (. left args count)))
              (if (!= (call (. types child-type) (. left args) position) right-arg)
                (return false)
              )
              (lazy right-arg (call (. types child-type) (. right args) position))
            )
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ adapt-answer _
    (param method InstanceId)
    (param expected TypeId)
    (let returned (. ([] (. instances signatures) method) returns))
    (if (or (== returned expected) (== returned no-type) (== returned invalid-type))
      (return)
    )
    (if (or (== expected no-type) (== expected invalid-type) (== expected (. types void-type)))
      (return)
    )
    (let pair U64 (/or/ (/lshift/ (as method U64) 32) (as expected U64)))
    (for (in seen adapted)
      (if (== seen pair)
        (return)
      )
    )
    (+= adapted pair)
    (let row ([] (. instances rows) method))
    (let site 0u32)
    (let body 0u32)
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= site (. fn syntax))
        (= body (. fn body))
      )
    )
    (if (== site 0)
      (return)
    )
    (call (. frame begin) method)
    (call (. conversions begin))
    (= (. conversions host) host)
    (if (call relation-legal (call (. conversions compare-held) returned expected))
      (call (. conversions convert) site (call final-value body) returned expected .reason-return)
    )
  )
  (fn-do _ final-value SyntaxId
    (param body SyntaxId)
    ; The value a body ends on: its last statement where it is a block, so an answer that ends on an
    ; integer written with no suffix converts as that integer does.
    (return-if body (if (== body 0)))
    (match? ([] (. frame tree nodes) body)
      (case (call .node-block row)
        (return-if body (if (== (. row body count) 0)))
        (return ([] (. frame tree children) (- (+ (. row body start) (. row body count)) 1)))
      )
    )
    (return body)
  )
  (fn-do _ is-table-method Bool
    (param row Instance)
    (if (or (== (. row self-type) no-type) (!= (. row enclosing) no-instance) (. row holds-default))
      (return false)
    )
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) (. row self-type))))
      (return false)
    )
    (let owner-module ([] (. program modules) (. row module)))
    (match? ([] (. owner-module decls) (. row decl))
      (case (call .decl-function fn)
        (let method (or (== (. fn kind) .function-decl) (== (. fn kind) .getter-decl) (== (. fn kind) .setter-decl)))
        (if (or (not method) (. fn is-generated) (. fn is-static) (== (. fn owner) 0))
          (return false)
        )
        (match? ([] (. owner-module decls) (. fn owner))
          (case .decl-class
            (return true)
          )
          (case (call .decl-extension extension)
            (return (!= (. extension facet) null))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ is-table-converter Bool
    (param row Instance)
    ; Whether an instance is a converter of a class with no type parameters of its own, which
    ; holds a place in the class's table.
    (if (or (== (. row self-type) no-type) (!= (. row enclosing) no-instance))
      (return false)
    )
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) (. row self-type))))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-converter converter)
        (return (and (== (. converter param-constraints count) 0) (== (. converter param-assignments count) 0)))
      )
    )
    (return false)
  )
  (fn-do _ redispatch-converter _
    (param converter InstanceId)
    (param receiver TypeId)
    ; A converter a subclass declares again takes the place of its base's for the subclass's
    ; objects. It is typed with the subclass as receiver, and the facts say which it replaces.
    (let row ([] (. instances rows) converter))
    (let target (. ([] (. instances signatures) converter) returns))
    (if (or (== target no-type) (== target invalid-type))
      (return)
    )
    (let caller (. (call class-ref types receiver) module))
    (let relation (call (. session relations compare) receiver target false false null caller))
    (if (or (!= (. relation kind) .relation-converter) (== (. relation converter-module) (. U32 max)))
      (return)
    )
    (let module (. relation converter-module))
    (let decl (. relation converter-decl))
    (if (and (== module (. row module)) (== decl (. row decl)))
      (return)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-converter found)
        (if (or (!= (. found param-constraints count) 0) (!= (. found param-assignments count) 0))
          (return)
        )
      )
    )
    (let override
      (call (. instances intern-dispatched)
        (block
          (arg module)
          (arg decl)
          (arg receiver)
          (arg (call declared-effects program module decl))
          (arg converter)
        )
      )
    )
    (call (. session facts overrides append) (call OverrideFact converter receiver override))
  )
  (fn-do _ declare-effects _
    (param instance InstanceId)
    (let row ([] (. instances rows) instance))
    (let declared (call declared-effects program (. row module) (. row decl)))
    (if (== declared (. row effects))
      (return)
    )
    (let signature ([] (. instances signatures) instance))
    (let params-mark (. scratch types mark))
    (for (in offset (..< 0 (. signature param-count)))
      (call (. scratch types push) (call (. instances param-type) instance offset))
    )
    (let params (call (. scratch types since) params-mark))
    (let args-mark (. scratch types mark))
    (for (in offset (..< 0 (. signature args count)))
      (call (. scratch types push) (call (. instances argument-type) instance offset))
    )
    (let args (call (. scratch types since) args-mark))
    (call (. instances intern) (. row module) (. row decl) (. row self-type) declared no-instance params args)
    (call (. scratch types rewind) params-mark)
  )
  (fn-do _ redispatch _
    (param method InstanceId)
    (param receiver TypeId)
    ; The function a class's objects run for a method of a class above it. The method's own type
    ; parameters are given as written, so a class's method that constrains them answers only for
    ; the ones it takes; one an argument with no type makes is not written, and the arguments
    ; choose it. What a class answers for a name, a kind, the type parameters and the types of
    ; the arguments is asked once, and kept for the other methods that ask the same. A method it
    ; may answer with whose parameters write a type that names nothing stops the class's table
    ; there, as TypeScript's does, and the base's does not answer in its place. A getter or a
    ; setter the class stores as a property is answered by the property (`stored-place`).
    (let row ([] (. instances rows) method))
    (let kind (. DeclKind function-decl))
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= kind (. fn kind))
        (= name (. fn name))
      )
    )
    (if (not name)
      (return)
    )
    (let place (call stored-place (. row self-type) receiver kind name))
    (if (!= place (. U32 max))
      (call (. session facts overrides append) (call OverrideFact method receiver no-instance place))
      (return)
    )
    (let signature ([] (. instances signatures) method))
    (let given (- (. signature param-count) (call implicit-argument-count types (. row module) (. row decl))))
    (let high-effects (as (/rshift/ (. row effects) 32) U32))
    (let words (+ 5 given (. signature args count) (if-expr (== high-effects 0) 0 1)))
    (if (> words (. answer-key length))
      (= answer-key (call (. answer-key resize) (* words 2) (. instances arena)))
    )
    (= ([] answer-key 0) receiver)
    (= ([] answer-key 1) kind)
    (= ([] answer-key 2) (as (call (. program atom-key) name) U32))
    (= ([] answer-key 3) given)
    (= ([] answer-key 4) (as (/and/ (. row effects) (. U32 max)) U32))
    (if (!= high-effects 0)
      (= ([] answer-key (- words 1)) high-effects)
    )
    (for (in offset (..< 0 given))
      (= ([] answer-key (+ 5 offset)) (call (. instances param-type) method offset))
    )
    (for (in offset (..< 0 (. signature args count)))
      (= ([] answer-key (+ 5 given offset)) (call (. instances argument-type) method offset))
    )
    (let asked (call (. answers store) (. answer-key data) words))
    (if (not (. answers last-inserted))
      (call note-override method receiver ([] answered asked))
      (return)
    )
    (+= answered no-instance)
    (= (. ranking caller) (. (call class-ref types receiver) module))
    (let names-mark (. scratch names mark))
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (for (in offset (..< 0 given))
      (call (. scratch types push) (call (. instances param-type) method offset))
    )
    (let params (call (. scratch types since) types-start))
    (let args-start (. scratch types mark))
    (for (in offset (..< 0 (. signature args count)))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) (call (. instances argument-type) method offset))
    )
    (call (. ranking begin) (call (. scratch call-arguments since) shapes-start) (call (. scratch types since) args-start))
    (call (. ranking explicit-params) params)
    (let hit (? Hit) null)
    (if (== kind .getter-decl)
      (= hit (call (. ranking dispatch-getter) receiver name))
      (else-if (== kind .setter-decl)
        (= hit (call (. ranking dispatch-setter) receiver name))
      )
      (else
        (= hit (call (. ranking dispatch-method) receiver name))
      )
    )
    (if (!= (. ranking missing-site) 0)
      (let message (call (. program store-atom) "Type not found"))
      (call (. session facts record-diagnostic)
        (block
          (arg method)
          (arg (. ranking missing-module))
          (arg (. ranking missing-site))
          (arg .stated)
          (arg message)
        )
      )
      (else-if (and hit (not (call (. ranking ambiguity))))
        (let found hit)
        (let override
          (call (. instances intern-dispatched)
            (block
              (arg (. found module))
              (arg (. found decl))
              (arg (. found receiver))
              (arg (call declared-effects program (. found module) (. found decl)))
              (arg method)
              (arg (. found params))
              (arg (. found args))
            )
          )
        )
        (= ([] answered asked) override)
        (call note-override method receiver override)
      )
    )
    (call (. ranking release))
    (call (. scratch call-arguments rewind) shapes-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch names rewind) names-mark)
  )
  (fn-do _ stored-place U32
    (param base TypeId)
    (param receiver TypeId)
    (param kind DeclKind)
    (param name Atom)
    ; The property a class stores in place of a getter or a setter it inherits from an interface
    ; through a base class, which declares the accessor nowhere, as a class that declares the
    ; interface itself answers it with a property it stores. No property for any other member.
    (if (and (!= kind .getter-decl) (!= kind .setter-decl))
      (return (. U32 max))
    )
    (let place (call (. types property-named) receiver name))
    (if (or (not place) (== (. ([] (. types properties) place) storage-kind) .storage-getter) (call (. types property-named) base name))
      (return (. U32 max))
    )
    (return (as place U32))
  )
  (fn-do _ note-override _
    (param method InstanceId)
    (param receiver TypeId)
    (param override InstanceId)
    ; Notes, as a fact, that a method answers for a base's for objects of a class, and keeps it to
    ; be checked once both are typed.
    (if (and (!= override no-instance) (!= override method))
      (+= overrides (call Override override method (as (. session facts overrides length) U32)))
      (call (. session facts overrides append) (call OverrideFact method receiver override))
    )
  )
)

(fn-do _ name-extensions (of Map Atom Bool)
  (param program Program)
  ; The name of each function and property an extension declares, anywhere in a program. A facet's
  ; are left out: no class below its own, nor a facet of one, may take them but to override one.
  (let names (call (of Map Atom Bool)))
  (for (in owner (. program modules))
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-extension extended)
          (if (. extended facet)
            (continue)
          )
          (for (in member ([] (. owner member-pool) (. extended members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-function fn)
                (if (. fn name)
                  (= ([] names (. fn name)) true)
                )
              )
              (case (call .decl-property property)
                (if (. property name)
                  (= ([] names (. property name)) true)
                )
              )
            )
          )
        )
      )
    )
  )
  (return names)
)
