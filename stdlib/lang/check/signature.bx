(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + Giving (is Tuple)
  ; How the function being checked gives its value, as `infer-return` reads it: whether it yields,
  ; and the type its yields join as, whether a return gives nothing, a conditional return its
  ; default or an optional whole, and whether its body may run off its end.
  (blank)
  (prop + yields Bool)
  (prop + yielded TypeId (= no-type))
  (prop + empty Bool)
  (prop + defaulted Bool)
  (prop + whole Bool)
  (prop + falls-through Bool)
)

(fn-do + infer-return TypeId
  (param frame Frame)
  (param giving Giving)
  (param value TypeId)
  (let types (. frame types))
  (let relations (. frame relations))
  (let facts (. frame facts))
  (let instances (. frame instances))
  (let declaration (. frame declaration))
  (if (. giving yields)
    (let item-mark (. types scratch types mark))
    (call (. types scratch types push) (if-expr (!= (. giving yielded) no-type) (. giving yielded) (. types void-type)))
    (let decl (. types generator-decl))
    (let generator (call (. types class-with-args) (. decl module) (. decl decl) item-mark))
    (call finish-inferred-return frame generator)
    (return no-type)
  )
  (let mark (. types scratch types mark))
  (let first 0u32)
  (let returns-null false)
  (for (in position (..< (. frame returns-start) (. types scratch returns length)))
    (let site (. ([] (. types scratch returns) position) type))
    (if (and (!= site no-type) (!= site (. types void-type)))
      (if (== first 0)
        (= first (. ([] (. types scratch returns) position) syntax))
      )
      (if (== site (. types null-type))
        (= returns-null true)
        (else
          (call (. types scratch types push) site)
        )
      )
    )
  )
  (if (and (not (. declaration is-imperative)) (!= value no-type))
    (if (== first 0)
      (= first (. declaration body))
    )
    (if (== value (. types null-type))
      (= returns-null true)
      (else
        (call (. types scratch types push) value)
      )
    )
  )
  (let adds-null (and returns-null (!= (. types scratch types length) mark)))
  (if (and returns-null (not adds-null))
    (call (. types scratch types push) (. types null-type))
  )
  (if (or (. declaration is-main) (== (. types scratch types length) mark))
    (call (. types scratch types rewind) mark)
    (call (. instances set-returns) (. frame instance) (. types void-type) no-type .return-inferred)
    (return no-type)
  )
  (let joined ([] (. types scratch types) mark))
  (for (in position (..< (+ mark 1) (. types scratch types length)))
    (let next ([] (. types scratch types) position))
    (let relation (call (. relations unify) joined next))
    (if (not (call relation-legal relation))
      (if (and (!= joined invalid-type) (!= next invalid-type))
        (call (. frame diagnose) first .unable-to-unify-returns null joined next)
      )
      (call (. types scratch types rewind) mark)
      (call (. instances set-returns) (. frame instance) invalid-type no-type .return-failed)
      (return no-type)
    )
    (= joined (. relation unified))
  )
  (call (. types scratch types rewind) mark)
  (let unified joined)
  (if (and nullable (not (call (. types is-optional) joined)))
    (= joined (call (. types optional-of) joined))
    (else-if (and (. giving defaulted) (!= joined (. types bool-type)) (not (call (. types is-optional) joined)))
      (= joined (call (. types optional-of) joined))
    )
  )
  (lazy nullable (or (. giving empty) (. giving falls-through) (. giving whole) adds-null))
  (blank)
  (call finish-inferred-return frame joined)
  (return unified)
)

(fn-do _ finish-inferred-return _
  (param frame Frame)
  (param joined TypeId)
  (let types (. frame types))
  (let relations (. frame relations))
  (let facts (. frame facts))
  (let instances (. frame instances))
  (let instance (. frame instance))
  (let provisional (. ([] (. instances signatures) instance) returns))
  (if (and (. ([] (. instances signatures) instance) read-in-progress) (!= joined provisional))
    (let relation (call (. relations compare) provisional joined))
    (if (call relation-legal relation)
      (call (. instances set-returns) instance provisional no-type .return-inferred)
      (return)
    )
    (let reader (. ([] (. instances signatures) instance) read-by))
    (if (and (!= reader no-instance) (!= reader instance) (call (. facts has-diagnostic) reader))
      (call (. instances set-returns) instance invalid-type no-type .return-failed)
      (return)
    )
    (let kind (. TypeDiagnosticKind return-after-recursion))
    (let site (. frame declaration syntax))
    (let owner U32 (. frame module))
    (call (. facts record-diagnostic) instance owner site kind null provisional joined)
    (call (. instances set-returns) instance invalid-type no-type .return-failed)
    (return)
  )
  (call (. instances set-returns) instance joined no-type .return-inferred)
)

(fn-do + narrow-declared-return _
  (param frame Frame)
  (param declared TypeId)
  (param value TypeId)
  ; A declared return that leaves parameters open, or names alternatives, is the type the
  ; returned values give it: the parameters they bind, or the alternative they choose. A function
  ; that is one expression returns that expression's value.
  (let types (. frame types))
  (let relations (. frame relations))
  (let instances (. frame instances))
  (if (== declared invalid-type)
    (return)
  )
  (let chooses (or (== (call (. types intrinsic-of) declared) .or) (call (. relations holds-alternatives) declared)))
  (if (and (not (. ([] (. types completions) declared) has-variables)) (not chooses))
    (return)
  )
  (if (. ([] (. instances signatures) (. frame instance)) read-in-progress)
    (return)
  )
  (let narrowed no-type)
  (for (in position (..< (. frame returns-start) (. types scratch returns length)))
    (let site (. ([] (. types scratch returns) position) type))
    (= narrowed (call narrow-return frame declared chooses narrowed site))
  )
  (if (not (. frame declaration is-imperative))
    (= narrowed (call narrow-return frame declared chooses narrowed value))
  )
  (if (!= narrowed no-type)
    (call (. instances set-returns) (. frame instance) narrowed declared .return-declared)
  )
)

(fn-expr _ narrow-return TypeId
  (param frame Frame)
  (param declared TypeId)
  (param chooses Bool)
  (param narrowed TypeId)
  (param site TypeId)
  (case? (or (== site no-type) (== site invalid-type) (== site (. types void-type)))
    narrowed
  )
  (case? (or (not (call relation-legal relation)) (. ([] (. types completions) given) has-variables))
    narrowed
  )
  (case? (== narrowed no-type)
    given
  )
  (default
    (if-expr (call relation-legal unifier) (. unifier unified) narrowed)
  )
  (where
    (lazy types (. frame types))
    (lazy relations (. frame relations))
    (lazy relation (call (. relations compare) site declared))
    (lazy given (if-expr chooses (. relation to) (. relation unified)))
    (lazy unifier (call (. relations unify) narrowed given))
  )
)

(fn-do + finish-errors _
  (param frame Frame)
  (param lacks-result Bool (= false))
  (param unbuildable Bool (= false))
  ; Ends the errors of the body a frame checked. `lacks-result` says the body gives no value
  ; where one is due, which is an error unless something leaves it; `unbuildable` that it builds
  ; a type that cannot be built. Both are reported with the errors, in that order.
  (let instances (. frame instances))
  (let instance (. frame instance))
  (if (not (call (. instances errors-known) instance))
    (call inherit-errors (. frame types) instances instance (. frame self-type) (. frame declaration kind))
    (if (. ([] (. instances rows) instance) is-generator)
      (call (. instances move-step-errors) instance)
    )
  )
  (let outgoing (call (. frame scratch outgoing since) (. frame outgoing-start)))
  (let syntax (. frame declaration syntax))
  (let errors (. frame session errors))
  (call (. errors close-body) instance syntax outgoing (. frame transforms) lacks-result unbuildable)
)

(fn-expr + callee-effects EffectMask
  (param frame Frame)
  (param module ModuleId)
  (param decl DeclId)
  (call dispatch-effects (/or/ (. frame surround effects) (call declared-effects (. frame program) module decl)))
)

(fn-do + exceptional-effects EffectMask
  (param effects EffectMask)
  (if (== (/and/ effects (. CompilationEffect gc-free)) 0)
    (return effects)
  )
  (let zone EffectMask (. CompilationEffect gc-free))
  (= zone (/or/ zone (. CompilationEffect no-heap)))
  (= zone (/or/ zone (. CompilationEffect no-safepoint)))
  (= zone (/or/ zone (. CompilationEffect no-suspend)))
  (return (/and/ effects (/xor/ (. U64 max) zone)))
)

(fn-do + declared-effects EffectMask
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  ; What a function's header keeps its code from: the restrictions it writes.
  (let declared EffectMask 0)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function row)
      (= declared (. row effects))
    )
  )
  (return (call dispatch-effects declared))
)

(fn-do + result-of TypeId
  (param frame Frame)
  (param signature InstanceSignature)
  (let types (. frame types))
  (let mark (. types scratch types mark))
  (for (in offset (..< 0 (. signature errors count)))
    (call (. types scratch types push) ([] (. frame instances signature-types) (+ (. signature errors start) offset)))
  )
  (let value (. signature returns))
  (if (== value no-type)
    (= value (. types void-type))
  )
  (return (call result-type types value mark))
)

(fn-do + carried-result TypeId
  (param types Types)
  (param type TypeId)
  ; What a call of a value of a function type answers with where the type carries errors: its
  ; value or one of them. The errors are those the type declares and those of what it
  ; returns, where that is already a value or an error, as a parameter of the type bound to
  ; what a function that raises answers is. No type for a type that carries none.
  (let fn (call function-row types type))
  (if (== fn no-type)
    (return no-type)
  )
  (match? ([] (. types rows) fn)
    (case (call .type-function row)
      (let value (if-expr (== (. row return-type) no-type) (. types void-type) (. row return-type)))
      (let mark (. types scratch types mark))
      (match? ([] (. types rows) value)
        (case (call .type-result held)
          (if (== (. row errors count) 0)
            (return value)
          )
          (for (in offset (..< 0 (. held errors count)))
            (call (. types scratch types push) (call (. types child-type) (. held errors) offset))
          )
          (= value (. held value))
        )
      )
      (if (== (. row errors count) 0)
        (return no-type)
      )
      (for (in offset (..< 0 (. row errors count)))
        (call (. types scratch types push) (call (. types child-type) (. row errors) offset))
      )
      (return (call result-type types value mark))
    )
  )
  (return no-type)
)

(fn-do + step-result TypeId
  (param types Types)
  (param generator TypeId)
  (param stepped TypeId)
  ; What a call of a generator for its next item answers with where the generator carries
  ; errors, those a step of the body that made it raises: the optional of the item, or one of
  ; them. No type for a generator that carries none.
  (match? ([] (. types rows) generator)
    (case (call .type-class row)
      (if (!= (. row errors count) 0)
        (let mark (. types scratch types mark))
        (for (in offset (..< 0 (. row errors count)))
          (call (. types scratch types push) (call (. types child-type) (. row errors) offset))
        )
        (return (call result-type types stepped mark))
      )
    )
  )
  (return no-type)
)

(fn-do + carried-value TypeId
  (param types Types)
  (param returns TypeId)
  ; The value a function type returns: what it returns, or the value of that where it is
  ; already a value or an error.
  (if (or (== returns no-type) (== returns invalid-type))
    (return returns)
  )
  (match? ([] (. types rows) returns)
    (case (call .type-result held)
      (return (. held value))
    )
  )
  (return returns)
)

(fn-expr + result-value TypeId
  (param types Types)
  (param type TypeId)
  (case? (== type no-type)
    (. types void-type)
  )
  (default
    (match ([] (. types rows) type)
      (case (call .type-result row)
        (. row value)
      )
      (default
        type
      )
    )
  )
)
