(import ./conversions)
(import ./dispatch)
(import ./facts)
(import ./frame)
(import ./instances)
(import ./method-results)
(import ./pair-order)
(import ./session)
(import ./signature)
(import ./stable-key)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /stream/sort)

(type + PendingReturn (is Struct)
  (prop + callee InstanceId)
  (prop + site SyntaxId)
  (prop + expected TypeId)
  (prop + owner ModuleId)
)

(type + PendingWitness (is Struct)
  (prop + callee InstanceId)
  (prop + fn WitnessFunc)
  (prop + value TypeId)
)

(type + WitnessTables
  ; The tables of what answers the functions of interfaces for each type converted to one. One
  ; that is `finding` only interns the functions that answer, as a type pass that types on many
  ; workers does on each (`type-share`): it records what tables a class derived from one has and
  ; which instances of an interface's functions calls name, and nothing of what answers them.
  (blank)
  (prop + finding _ (= false))
  (prop _ retyping _ (= false))
  (prop + types Types)
  (prop + program Program)
  (prop _ relations Relations)
  (prop + instances Instances)
  (prop + facts Facts)
  (prop _ ranking Ranking)
  (prop _ scratch TypingScratch)
  (prop _ tables-scanned Size (= 0))
  (prop _ funcs-scanned Size (= 0))
  (prop _ protos-scanned Size (= 0))
  (prop _ calls-scanned Size (= 0))
  (prop _ types-scanned Size (= 0))
  (prop _ equalities-scanned Size (= 0))
  (prop _ dynamic-scanned Size (= 0))
  (prop _ waiting (list TypeId))
  (prop _ pending (list PendingReturn))
  (prop _ resolved (list Bool))
  (prop _ unchecked (list PendingWitness))
  (prop _ getter-steps (list U32))
  (prop _ tables-indexed Size (= 0))
  (prop _ table-heads (list U32))
  (prop _ table-links (list U32))
  (prop _ funcs-indexed Size (= 0))
  (prop _ func-heads (list U32))
  (prop _ func-links (list U32))
  (prop _ protos-indexed Size (= 0))
  (prop _ proto-heads (list U32))
  (prop _ proto-links (list U32))
  (prop _ frame Frame)
  (prop _ conversions Conversions)
  (prop _ session Session)
  (fn-do + This _
    (param typing Session)
    (lazy session typing)
    (lazy types (. session types))
    (lazy relations (. session relations))
    (lazy program (. session program))
    (lazy instances (. session instances))
    (lazy facts (. session facts))
    (lazy ranking (call Ranking session 0))
    (lazy scratch (. session scratch))
    (lazy frame (call Frame session))
    (lazy conversions (call Conversions frame))
  )
  (fn-do + expand Bool
    (param host Demander)
    (param host-conversions Conversions)
    ; Finds what answers the functions of interfaces for the types converted to them since it
    ; last ran, and says whether a table was added. A class derived from one with a table has a
    ; table of its own, but for one with variables left, which no object is: a class made since it
    ; last ran, or complete since then (`fresh-types`), finds the tables of the classes above it,
    ; which are listed by the class each is for, but for those made as this runs, which have none
    ; listed yet, and a table added since then looks through every class made before, where any
    ; class is declared below its own. They are added in the
    ; order of the tables and then of the classes. Each table schedules the functions, listed by
    ; interface, of the interfaces its own is derived from, in the order they were found. The host
    ; works out the type of a property a class delegates to that is written with none, and types
    ; the defaults a function of a table gives (`record-defaults`). The ranking converts as the
    ; host does, with `host-conversions`.
    (= (. ranking host) host)
    (= (. ranking conversions) host-conversions)
    (let tables-before tables-scanned)
    (let types-before types-scanned)
    (let funcs-before funcs-scanned)
    (let protos-before protos-scanned)
    (for (in position (..< calls-scanned (. facts calls length)))
      (let callee (. ([] (. facts calls) position) callee))
      (if (== callee no-instance)
        (continue)
      )
      (let receiver (. ([] (. instances rows) callee) self-type))
      (if (and (!= receiver no-type) (!= receiver invalid-type) (== (call (. types intrinsic-of) receiver) .interface))
        (call (. facts record-witness-proto) callee)
      )
    )
    (= calls-scanned (. facts calls length))
    (= tables-scanned (. facts witness-tables length))
    (= types-scanned (. types rows length))
    (= funcs-scanned (. facts witness-funcs length))
    (= protos-scanned (. facts witness-protos length))
    (while (< (. table-heads length) types-scanned)
      (+= table-heads 0)
      (+= func-heads 0)
      (+= proto-heads 0)
    )
    (for (in position (..< tables-indexed tables-scanned))
      (let value (. ([] (. facts witness-tables) position) value))
      (+= table-links ([] table-heads value))
      (= ([] table-heads value) (as (+ position 1) U32))
    )
    (= tables-indexed tables-scanned)
    (let fresh (call fresh-types types-before))
    (let found (list U64))
    (for (in position (..< tables-before tables-scanned))
      (let table ([] (. facts witness-tables) position))
      (if (not (call (. types has-subclasses) (. table value)))
        (continue)
      )
      (for (in candidate (..< 0 types-before))
        (let type (as candidate TypeId))
        (if (or (== type (. table value)) (not class-like) (. ([] (. types completions) type) has-variables))
          (continue)
        )
        (lazy class-like (call intrinsic-is-class (. ([] (. types completions) type) intrinsic)))
        (if (call in-base-chain types type (. table value))
          (let wide U64 (as position U64))
          (+= found (/or/ (/lshift/ wide 32) (as candidate U64)))
        )
      )
    )
    (for (in type fresh)
      (if (or (not (call intrinsic-is-class (. ([] (. types completions) type) intrinsic))) generic)
        (continue)
      )
      (lazy generic (. ([] (. types completions) type) has-variables))
      (let level (call (. types base-of) type))
      (while level
        (let link (if-expr (< level (. table-heads length)) ([] table-heads level) 0))
        (while (!= link 0)
          (let wide U64 (- link 1))
          (+= found (/or/ (/lshift/ wide 32) (as type U64)))
          (= link ([] table-links (- link 1)))
        )
        (= level (call (. types base-of) level))
      )
    )
    (let sorted (call sorted-pairs found))
    (for (in pair sorted)
      (let table ([] (. facts witness-tables) (as (/rshift/ pair 32) Index)))
      (call (. facts record-witness-table) (as (/and/ pair 0xffffffff) TypeId) (. table interface))
    )
    (call derive-dynamic fresh)
    (for (in offset (..< funcs-indexed funcs-scanned))
      (let interface (. ([] (. facts witness-funcs) offset) interface))
      (+= func-links ([] func-heads interface))
      (= ([] func-heads interface) (as (+ offset 1) U32))
    )
    (= funcs-indexed funcs-scanned)
    (for (in offset (..< protos-indexed protos-scanned))
      (let interface (. ([] (. instances rows) ([] (. facts witness-protos) offset)) self-type))
      (+= proto-links ([] proto-heads interface))
      (= ([] proto-heads interface) (as (+ offset 1) U32))
    )
    (= protos-indexed protos-scanned)
    (for (in position (..< 0 tables-scanned))
      (let table ([] (. facts witness-tables) position))
      (if (== (. ([] (. types completions) (. table value)) intrinsic) .interface)
        (continue)
      )
      (let first (if-expr (< position tables-before) funcs-before 0))
      (let first-proto (if-expr (< position tables-before) protos-before 0))
      (if (and (== first funcs-scanned) (== first-proto protos-scanned))
        (continue)
      )
      (let reached (list TypeId))
      (call reach-interfaces (. table interface) reached)
      (let offsets (list U32))
      (let proto-offsets (list U32))
      (for (in interface reached)
        (if (>= interface (. func-heads length))
          (continue)
        )
        (let link ([] func-heads interface))
        (while (and (!= link 0) (>= (as (- link 1) Size) first))
          (+= offsets (- link 1))
          (= link ([] func-links (- link 1)))
        )
        (= link ([] proto-heads interface))
        (while (and (!= link 0) (>= (as (- link 1) Size) first-proto))
          (+= proto-offsets (- link 1))
          (= link ([] proto-links (- link 1)))
        )
      )
      (let sorted-funcs (call sort offsets))
      (for (in offset sorted-funcs)
        (call schedule-witness (. table value) ([] (. facts witness-funcs) offset) no-instance)
      )
      (let sorted-protos (call sort proto-offsets))
      (for (in offset sorted-protos)
        (let proto ([] (. facts witness-protos) offset))
        (let row ([] (. instances rows) proto))
        (call schedule-witness
          (block
            (arg (. table value))
            (arg (call WitnessFunc (. row self-type) (. row module) (. row decl)))
            (arg proto)
            (arg (. table interface))
          )
        )
      )
    )
    (if (not finding)
      (call resolve-pending)
      (call expand-equalities tables-before)
    )
    (= (. ranking host) null)
    (= (. ranking conversions) null)
    (return (!= (. facts witness-tables length) tables-scanned))
  )
  (fn-do + check-retyped _
    (param host Demander)
    (param host-conversions Conversions)
    (param retired (list Bool))
    ; Notes again each answer to a function of an interface that an edit typed again in place
    ; (`retype-edit`). Retiring the answer dropped what was noted at it: how it takes the arguments,
    ; how what it answers converts, and how the interface's own function takes the value. Its slot is
    ; filled already, and stays as it is.
    (= (. ranking host) host)
    (= (. ranking conversions) host-conversions)
    (= retyping true)
    (let count (. facts witness-slots length))
    (for (in position (..< 0 count))
      (let slot ([] (. facts witness-slots) position))
      (if (or (. slot based) (== (. slot callee) no-instance) unretired)
        (continue)
      )
      (lazy unretired (or (>= (as (. slot callee) Size) (. retired length)) (not ([] retired (. slot callee)))))
      (let row ([] (. instances rows) (. slot proto)))
      (call schedule-witness
        (block
          (arg (. slot value))
          (arg (call WitnessFunc (. row self-type) (. row module) (. row decl)))
          (arg (. slot proto))
          (arg (. row self-type))
        )
      )
    )
    (call resolve-pending)
    (= retyping false)
    (= (. ranking host) null)
    (= (. ranking conversions) null)
  )
  (fn-do _ fresh-types (list TypeId)
    (param types-before Size)
    ; The types made since the last pass, and those made before that were not complete then and are
    ; now, in that order; one not complete yet waits for a later pass, as what it is is not known
    ; until it is.
    (let fresh (list TypeId))
    (let still (list TypeId))
    (for (in type waiting)
      (if (call is-settled type)
        (+= fresh type)
        (else
          (+= still type)
        )
      )
    )
    (for (in candidate (..< types-before types-scanned))
      (let type (as candidate TypeId))
      (if (call is-settled type)
        (+= fresh type)
        (else
          (+= still type)
        )
      )
    )
    (= waiting still)
    (return fresh)
  )
  (fn-expr _ is-settled Bool
    (param type TypeId)
    (or (== state .completion-done) (== state .completion-failed))
    (where
      (lazy state (. ([] (. types completions) type) completion))
    )
  )
  (fn-do _ derive-dynamic _
    (param fresh (list TypeId))
    ; A class cast to an interface that classes below it declare has, for each class below it
    ; that the interface's conversion takes, a table of that class's own (`record-dynamic-witness`).
    ; A pair noted since the last pass looks through every class, and the others through the
    ; classes `fresh-types` gives.
    (let pairs (. facts dynamic-witnesses length))
    (for (in position (..< 0 pairs))
      (let pair ([] (. facts dynamic-witnesses) position))
      (if (>= position dynamic-scanned)
        (for (in candidate (..< 0 types-scanned))
          (call derive-table (as candidate TypeId) (. pair value) (. pair interface))
        )
        (else
          (for (in type fresh)
            (call derive-table type (. pair value) (. pair interface))
          )
        )
      )
    )
    (= dynamic-scanned pairs)
  )
  (fn-do _ derive-table _
    (param type TypeId)
    (param value TypeId)
    (param interface TypeId)
    (if (or (not (call intrinsic-is-class (. ([] (. types completions) type) intrinsic))) (. ([] (. types completions) type) has-variables))
      (return)
    )
    (if (and (!= type value) (not (call in-base-chain types type value)))
      (return)
    )
    (if (== (. (call (. relations compare) type interface) kind) .relation-interface-cast)
      (call (. facts record-witness-table) type interface)
    )
  )
  (fn-do _ expand-equalities _
    (param tables-before Size)
    ; Gives each table whose interface, or one it is derived from, has its values compared the
    ; comparison of two values of its type, which the function the table holds for equality
    ; runs. The comparison is queued as it is first made.
    (let equalities-before equalities-scanned)
    (= equalities-scanned (. facts equalities length))
    (for (in position (..< 0 tables-scanned))
      (let table ([] (. facts witness-tables) position))
      (let owner (call class-ref types (. table value)))
      (if (or (!= (. table equality) no-instance) (== (. owner decl) 0) of-interface)
        (continue)
      )
      (lazy of-interface (== (. ([] (. types completions) (. table value)) intrinsic) .interface))
      (let first (if-expr (< position tables-before) equalities-before 0))
      (for (in offset (..< first equalities-scanned))
        (if (call implements (. table interface) ([] (. facts equalities) offset))
          (= (. ([] (. facts witness-tables) position) equality)
            (call (. instances intern-equality)
              (block
                (arg (. owner module))
                (arg (. table value))
              )
            )
          )
          (break)
        )
      )
    )
  )
  (fn-do _ resolve-pending _
    (for (in position (..< 0 (. pending length)))
      (if ([] resolved position)
        (continue)
      )
      (let item ([] pending position))
      (if (!= (. ([] (. instances rows) (. item callee)) state) .instance-done)
        (continue)
      )
      (let signature ([] (. instances signatures) (. item callee)))
      (if (== (. signature return-state) .return-pending)
        (continue)
      )
      (= ([] resolved position) true)
      (call record-return (. item callee) (. item site) (. signature returns) (. item expected) (. item owner))
    )
    (let waiting (list PendingWitness))
    (for (in item unchecked)
      (let settled (== (. ([] (. instances rows) (. item callee)) state) .instance-done))
      (if (and settled (!= (. ([] (. instances signatures) (. item callee)) return-state) .return-pending))
        (call check-witness item)
        (else
          (+= waiting item)
        )
      )
    )
    (= unchecked waiting)
  )
  (fn-do _ check-witness _
    (param item PendingWitness)
    (let fn (. item fn))
    (let names-mark (. scratch names mark))
    (let items-mark (. scratch types mark))
    (let module (. fn module))
    (let signature (call signature-into types module (. fn decl) (call no-type-arguments types) (. fn interface) true))
    (let syntax (call decl-syntax (. fn module) (. fn decl)))
    (let proto
      (call MethodProto
        (block
          (arg "Interface")
          (arg "interface")
          (arg (. fn module))
          (arg syntax)
          (arg (. signature returns))
          (arg (. signature errors))
        )
      )
    )
    (call check-method-result session (. item callee) proto (call carries-own-errors types (. item value)))
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
  )
  (fn-do _ record-return _
    (param callee InstanceId)
    (param site SyntaxId)
    (param returned TypeId)
    (param expected TypeId)
    (param owner ModuleId)
    ; Records how the function of a witness table converts what the type's function answers to
    ; what the interface's answers, where they differ: at the type's function, with the function a
    ; type declares that converts it, where one does.
    (if (or (== returned expected) (== returned no-type) (== returned invalid-type))
      (return)
    )
    (let relation (call (. relations compare) returned expected false false null owner))
    (if (!= (. relation kind) .relation-same)
      (call (. frame begin) callee)
      (call (. conversions begin))
      (= (. conversions host) (. ranking host))
      (let converter (call (. conversions converter-of) relation))
      (let id (call (. facts record-conversion) callee site relation .reason-return converter))
      (call record-held callee id relation .reason-return)
    )
  )
  (fn-do _ record-receiver _
    (param callee InstanceId)
    (param site SyntaxId)
    (param receiver TypeId)
    (param expected TypeId)
    (param owner ModuleId)
    ; Records where the function of a witness table gives the interface's own function the value
    ; of the type as that interface: at the interface's function.
    (if (or (== site 0) (== receiver expected))
      (return)
    )
    (let relation (call (. relations compare) receiver expected false false null owner))
    (if (!= (. relation kind) .relation-same)
      (call (. facts record-conversion) callee site relation .reason-receiver no-instance)
    )
  )
  (fn-do _ record-held _
    (param callee InstanceId)
    (param id FactId)
    (param relation Relation)
    (param reason ConversionReason)
    ; Records the parts of a conversion, as `parts-of` makes them: for one that makes an optional of
    ; another type, the conversion of what it holds, and for a value made a case of a union, its
    ; conversion to what the case holds. The witness table of what an optional holds is noted where
    ; the new one holds an interface.
    (if (and (== (. relation kind) .relation-side-cast) (call (. types is-optional) (. relation to)))
      (let held (call (. types optional-inner) (. relation to)))
      (let given (call (. types optional-inner) (. relation from)))
      (if (and (== (call (. types intrinsic-of) held) .interface) (!= given held) (!= given (. types null-type)))
        (call (. facts record-witness-table) given held)
      )
    )
    (call (. frame begin) callee)
    (call (. conversions begin))
    (= (. conversions host) (. ranking host))
    (= (. ([] (. facts conversions) id) parts) (call (. conversions parts-of) relation reason))
  )
  (fn-do _ record-arguments Bool
    (param callee InstanceId)
    (param site SyntaxId)
    (param hit Hit)
    ; Records how the function of a witness table gives the type's function each argument the
    ; interface's function takes, where their types differ: at the type's function, with the
    ; function that converts where the type's argument is made from the interface's by one it
    ; declares. A conversion by any other function is left out, and has no shape. Says whether
    ; any argument converts.
    (let converts false)
    (for (in position (..< 0 (. hit fills length)))
      (if (>= position (. hit relations length))
        (break)
      )
      (let relation ([] (. hit relations) position))
      (if (or (== (. relation kind) .relation-same) (== (. relation from) (. relation to)))
        (continue)
      )
      (= converts true)
      (let converter no-instance)
      (if (!= (. relation converter-module) (. U32 max))
        (if (!= (. relation kind) .relation-fromverter)
          (continue)
        )
        (let mark (. scratch types mark))
        (call (. scratch types push) (. relation from))
        (let effects (call declared-effects program (. relation converter-module) (. relation converter-decl)))
        (= converter
          (call (. instances intern)
            (block
              (arg (. relation converter-module))
              (arg (. relation converter-decl))
              (arg (. relation to))
              (arg effects)
              (arg no-instance)
              (arg (. scratch no-types))
              (arg (call (. scratch types since) mark))
            )
          )
        )
        (call (. scratch types rewind) mark)
      )
      (let id (call (. facts record-conversion) callee site relation .reason-argument converter))
      (call record-held callee id relation .reason-argument)
    )
    (return converts)
  )
  (fn-do _ record-defaults _
    (param callee InstanceId)
    (param site SyntaxId)
    (param hit Hit)
    (param given U32)
    ; Types the defaults of the parameters a type's function takes past the arguments the
    ; interface's function gives, which the function of the witness table gives it, and records at
    ; the type's function how a literal one converts to its parameter's type, as a call that
    ; leaves the argument out records it.
    (let host (!! (. ranking host)))
    (let owner ([] (. program modules) (. hit module)))
    (match? ([] (. owner decls) (. hit decl))
      (case (call .decl-function fn)
        (for (in position (..< given (. fn args count)))
          (let shape ([] (. owner arg-pool) (+ (. fn args start) position)))
          (if (== (. shape default-syntax) 0)
            (continue)
          )
          (call (. host type-default) callee position)
          (let env (call (. types env-frame)))
          (let literal (call literal-type types (. hit module) (. owner tree) (. shape default-syntax) env))
          (call (. types env-release) env)
          (let expected (call (. instances argument-type) callee position))
          (match? ([] (. owner tree nodes) (. shape default-syntax))
            (case (call .node-symbol row)
              (= literal (call contextual-symbol types relations expected (. row name) (. hit module)))
            )
          )
          (if (or (== literal invalid-type) (== literal expected))
            (continue)
          )
          (call (. frame begin) callee)
          (call (. conversions begin))
          (= (. conversions host) host)
          (call (. conversions convert) site site literal expected .reason-default)
        )
      )
    )
  )
  (fn-do _ reach-interfaces _
    (param interface TypeId)
    (param reached (list TypeId))
    ; Adds an interface and each it is derived from to a list, each once.
    (if (!= (call (. reached find) interface) null)
      (return)
    )
    (+= reached interface)
    (for (in parent (call (. types interfaces-of) interface))
      (call reach-interfaces parent reached)
    )
  )
  (fn-do _ implements Bool
    (param interface TypeId)
    (param required TypeId)
    (if (== interface required)
      (return true)
    )
    (for (in parent (call (. types interfaces-of) interface))
      (if (call implements parent required)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ schedule-witness _
    (param receiver TypeId)
    (param fn WitnessFunc)
    (param proto InstanceId)
    (param table TypeId (= no-type))
    ; Finds the function of a type that answers a function of an interface, and schedules it. One that
    ; is `finding` leaves what another pass of a parallel type pass finds first to that pass.
    ; For an instance of the interface's function that a call names, it is found for that
    ; instance's arguments, with its type parameters as written, and noted as what fills the
    ; instance's slot for the type. Where the
    ; type declares none, that is the interface's own function: the instance itself when its
    ; receiver is the interface that declares the function, and else the function as the type
    ; runs it, which takes a value of the type and sees it as that interface. A getter or a
    ; setter the interface declares with a body is always the type's, whose receiver is the
    ; value. One found
    ; through a property the type delegates to is run for what that property holds. A getter or a
    ; setter the type answers with a property it stores is noted with the property, and a
    ; function a property the type delegates to answers with the properties read to reach it,
    ; as is a property stored there. A getter with a body found so is the type's own instead:
    ; it is typed with the type as its receiver, as the reference runs it for a value.
    ; Where the interface's own function answers and `table` is an interface derived from the
    ; one that declares it, the function as the type runs it is noted too: the reference fills
    ; the slot of such a table with that. A function no call names whose parameters are written
    ; with type parameters of its own is found only for the arguments a call gives it, as the
    ; reference fills its tables only with the functions calls name.
    (if (and finding (not (call claims receiver fn proto table)))
      (return)
    )
    (let owner-module ([] (. program modules) (. fn module)))
    (let kind (. DeclKind function-decl))
    (let name (? Atom) null)
    (let defaulted false)
    (let answers false)
    (let declarer DeclId 0)
    (match? ([] (. owner-module decls) (. fn decl))
      (case (call .decl-function row)
        (= kind (. row kind))
        (= name (. row name))
        (= defaulted (!= (. row body) 0))
        (= answers (!= (. row return-type) 0))
        (= declarer (. row owner))
      )
    )
    (if (not name)
      (return)
    )
    (= (. ranking caller) (. (call class-ref types receiver) module))
    (let names-mark (. scratch names mark))
    (let items-mark (. scratch types mark))
    (let module (. fn module))
    (let plain (call no-type-arguments types))
    (let signature (call signature-into types module (. fn decl) plain (. fn interface) true))
    (let shapes-start (. scratch call-arguments mark))
    (let params-start (. scratch types mark))
    (if (!= proto no-instance)
      (let row ([] (. instances rows) proto))
      (let given
        (scope (- param-count (call implicit-argument-count types (. row module) (. row decl)))
          (lazy param-count (. ([] (. instances signatures) proto) param-count))
        )
      )
      (for (in position (..< 0 given))
        (call (. scratch types push) (call (. instances param-type) proto position))
      )
    )
    (let params (call (. scratch types since) params-start))
    (let types-start (. scratch types mark))
    (let open false)
    (if (== proto no-instance)
      (for (in arg (. signature args))
        (call (. scratch call-arguments push) (call CallArgument null false false false false))
        (call (. scratch types push) arg)
        (= open (or open (. ([] (. types completions) arg) has-variables)))
      )
      (else
        (for (in position (..< 0 (. ([] (. instances signatures) proto) args count)))
          (call (. scratch call-arguments push) (call CallArgument null false false false false))
          (call (. scratch types push) (call (. instances argument-type) proto position))
        )
      )
    )
    (call (. ranking begin) (call (. scratch call-arguments since) shapes-start) (call (. scratch types since) types-start))
    (call (. ranking explicit-params) params)
    (let hit (? Hit) null)
    (if (== kind .getter-decl)
      (= hit (call (. ranking dispatch-getter) receiver name))
      (else-if (== kind .setter-decl)
        (= hit (call (. ranking dispatch-setter) receiver name))
      )
      (else
        (= hit (call (. ranking dispatch-method) receiver name))
      )
    )
    (let declared (and hit defaulted (== (. hit module) (. fn module)) (== (. hit decl) (. fn decl))))
    (let passed (and hit (!= (. hit receiver) receiver) (call (. ranking delegates-to) receiver (. hit receiver))))
    (let own (and declared (not passed)))
    (let unanswered
      (scope (and answerable self-hit (!= (call (. types intrinsic-of) receiver) .interface))
        (lazy answerable (and (!= proto no-instance) (not defaulted) answers))
        (lazy self-hit (or (not hit) (and (== (. hit module) (. fn module)) (== (. hit decl) (. fn decl)))))
      )
    )
    (let lazy-override (and hit defaulted (not (call is-imperative-decl (. hit module) (. hit decl)))))
    (let direct false)
    (if (and own-function (not (call (. ranking ambiguity))) (== (call (. types intrinsic-of) receiver) .class))
      (let seen (call class-ref types (. ([] (. instances rows) proto) self-type)))
      (= direct (and (== (. seen module) (. fn module)) (== (. seen decl) declarer)))
    )
    (lazy own-function (and own (== kind .function-decl) (!= proto no-instance)))
    (let place (only-if (call (. types property-named) receiver name) (if (!= kind .function-decl))))
    (let stored (and place (!= (. ([] (. types properties) place) storage-kind) .storage-getter)))
    (let steps (list U32))
    (let holder no-type)
    (if (and (!= kind .function-decl) (not place))
      (= holder (call (. ranking delegated-holder) receiver name steps))
    )
    (let reached (only-if (call (. types property-named) holder name) (if (and (!= holder no-type) (!= (. steps length) 0)))))
    (let lent (and reached (!= (. ([] (. types properties) reached) storage-kind) .storage-getter)))
    (if (and lent (or declared (not hit)))
      (if (and (!= proto no-instance) (not finding))
        (call (. facts record-witness-slot) receiver proto no-instance (as (!! reached) U32) (call keep-steps steps))
      )
      (else-if (and stored (or declared (not hit)))
        (if (and (!= proto no-instance) (not finding))
          (call (. facts record-witness-slot) receiver proto no-instance (as (!! place) U32))
        )
      )
      (else-if direct
        (if (not finding)
          (call (. facts record-witness-slot) receiver proto proto)
          (call record-receiver
            (block
              (arg proto)
              (arg (call decl-syntax (. fn module) (. fn decl)))
              (arg receiver)
              (arg (. ([] (. instances rows) proto) self-type))
              (arg (. fn module))
            )
          )
        )
        (if (and hit (!= table (. ([] (. instances rows) proto) self-type)))
          (let found hit)
          (let viewed
            (call (. instances intern-dispatched)
              (block
                (arg (. found module))
                (arg (. found decl))
                (arg (. found receiver))
                (arg (call declared-effects program (. found module) (. found decl)))
                (arg proto)
                (arg (. found params))
                (arg (. found args))
              )
            )
          )
          (if (not finding)
            (call (. facts record-witness-slot) receiver proto viewed (. U32 max) (call (of RowRange U32)) true)
          )
        )
      )
      (else-if unanswered
        (if (not finding)
          (call report-unanswered receiver fn proto name)
        )
      )
      (else-if (and hit (not (call (. ranking ambiguity))) (or (!= proto no-instance) (and (not own) (not lazy-override) (not open))))
        (let effects (call declared-effects program (. hit module) (. hit decl)))
        (let found hit)
        (let self (. found receiver))
        (let places (list U32))
        (let lent (and (!= self receiver) (call (. ranking delegate-path) receiver self places)))
        (if (and lent (== kind .getter-decl))
          (= self receiver)
          (= lent false)
        )
        (let callee no-instance)
        (if (!= proto no-instance)
          (= callee
            (call (. instances intern-dispatched)
              (block
                (arg (. found module))
                (arg (. found decl))
                (arg self)
                (arg effects)
                (arg proto)
                (arg (. found params))
                (arg (. found args))
              )
            )
          )
          (else
            (= callee
              (call (. instances intern)
                (block
                  (arg (. found module))
                  (arg (. found decl))
                  (arg self)
                  (arg effects)
                  (arg no-instance)
                  (arg (. found params))
                  (arg (. found args))
                )
              )
            )
          )
        )
        (if (not finding)
          (call note-witness callee fn receiver proto found lent places (. signature returns))
        )
      )
    )
    (call (. ranking release))
    (call (. scratch call-arguments rewind) shapes-start)
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
    (call keep-getters)
  )
  (fn-do _ claims Bool
    (param receiver TypeId)
    (param fn WitnessFunc)
    (param proto InstanceId)
    (param table TypeId)
    ; Whether this pass is the first of a parallel type pass to find what answers a function of an
    ; interface for a type (`SharedTyping.claim`).
    (if (not (. session shared))
      (return true)
    )
    (let key (call mixed (call mixed stable-key-seed (call (. types key-of) receiver)) (call (. types key-of) (. fn interface))))
    (= key (call mixed (call mixed (call mixed key (. fn module)) (. fn decl)) (call (. types key-of) table)))
    (if (!= proto no-instance)
      (= key (call mixed key ([] (. instances stable-keys) proto)))
    )
    (return (call (. (!! (. session shared)) claim) key))
  )
  (fn-do _ report-unanswered _
    (param receiver TypeId)
    (param fn WitnessFunc)
    (param proto InstanceId)
    (param name Atom)
    ; Reports a type that answers no function of an interface the interface declares without a body
    ; and with a result, which the type must answer: there is nothing of the interface's to run.
    (let ref (call class-ref types receiver))
    (let site
      (match ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (. class syntax)
        )
        (default
          0u32
        )
      )
    )
    (let message (call unanswered-text types receiver (. fn interface) name))
    (call (. facts record-diagnostic) proto (. ref module) site .stated (call (. program store-atom) message))
    (call (. facts relate-diagnostic) (call (. program store-atom) "Interface") (. fn module) (call decl-syntax (. fn module) (. fn decl)))
  )
  (fn-do _ note-witness _
    (param callee InstanceId)
    (param fn WitnessFunc)
    (param receiver TypeId)
    (param proto InstanceId)
    (param found Hit)
    (param lent Bool)
    (param places (list U32))
    (param expected TypeId)
    ; Notes the function of a type that answers a function of an interface: to be checked against it
    ; once typed, with how it takes the arguments of an instance a call names and fills its slot,
    ; and how what it answers converts to what the interface's answers.
    (+= unchecked (call PendingWitness callee fn receiver))
    (let site (call decl-syntax (. found module) (. found decl)))
    (if (!= proto no-instance)
      (let converts (and (!= site 0) (call record-arguments callee site found)))
      (if (!= site 0)
        (call record-defaults callee site found (. ([] (. instances signatures) proto) args count))
      )
      (if (and lent (not retyping))
        (call (. facts record-witness-slot)
          (block
            (arg receiver)
            (arg proto)
            (arg callee)
            (arg (. U32 max))
            (arg (call keep-steps places))
            (arg false)
            (arg converts)
          )
        )
        (else
          (call (. facts record-witness-slot) receiver proto callee (. U32 max) (call (of RowRange U32)) false converts)
        )
      )
    )
    (let owner (. found module))
    (let given (call no-type-arguments types))
    (let implemented (call signature-into types owner (. found decl) given (if-expr lent (. found receiver) receiver) true))
    (let returned (. implemented returns))
    (if (and (!= site 0) (!= expected no-type))
      (if (== returned no-type)
        (+= pending (call PendingReturn callee site expected owner))
        (+= resolved false)
        (else
          (call record-return callee site returned expected owner)
        )
      )
    )
  )
  (fn-do _ keep-steps (of RowRange U32)
    (param places (list U32))
    ; Keeps the properties read on the way to what a type delegates to, and notes those a getter
    ; answers, whose getters are kept once the ranking is released.
    (let none (list InstanceId))
    (let kept (call (. facts keep-steps) places none))
    (for (in offset (..< 0 (. places length)))
      (let property ([] (. types properties) ([] places offset)))
      (if (and (== (. property storage-kind) .storage-getter) (!= (. property owner) no-type))
        (+= getter-steps (as (+ (. kept start) offset) U32))
      )
    )
    (return kept)
  )
  (fn-do _ keep-getters _
    ; Keeps, for each property read on the way to what a type delegates to that a getter
    ; answers, the getter as the type that declares the property runs it, for the function of
    ; the witness table to call.
    (for (in step getter-steps)
      (let property ([] (. types properties) ([] (. facts steps) step)))
      (call (. ranking begin) (. scratch no-shapes) (. scratch no-types))
      (let hit (call (. ranking dispatch-getter) (. property owner) (. property name)))
      (if (and hit (not (call (. ranking ambiguity))))
        (let found hit)
        (let effects (call declared-effects program (. found module) (. found decl)))
        (let getter
          (call (. instances intern)
            (block
              (arg (. found module))
              (arg (. found decl))
              (arg (. found receiver))
              (arg effects)
              (arg no-instance)
              (arg (. found params))
              (arg (. found args))
            )
          )
        )
        (= ([] (. facts step-callees) step) getter)
      )
      (call (. ranking release))
    )
    (call (. getter-steps clear))
  )
  (fn-expr _ decl-syntax SyntaxId
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (. fn syntax)
      )
      (default
        0u32
      )
    )
  )
  (fn-do _ is-imperative-decl Bool
    (param module ModuleId)
    (param decl DeclId)
    (let owner-module ([] (. program modules) module))
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-function fn)
        (match? ([] (. owner-module tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (return (. syntax imperative))
          )
          (case (call .node-getter-syntax syntax)
            (return (. syntax imperative))
          )
        )
      )
    )
    (return true)
  )
)
