./call-paths
./facts
./instances
./session
./types
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program

━━━━━━━━━━━━━━━━━━━━
+ StackLocals

` A global that each `do with` binds anew must be bound wherever it is read. A function requires
` the ones it reads outside a binding of its own, and the ones the functions it calls require
` unless it calls them under a binding. A door that calls the door typed under a fake where its
` effect's slot holds one hands on nothing: it reads the slot. A call of an interface member or of a method a class
` declares again requires what each function that may answer it requires. A nested function holds
` the state of where it is made, so what it requires reaches the function that makes it, unless
` a binding is open where it is made, and does not reach its callers. What a module's own
` statements still require is never bound, which is reported at a read it reaches, with the chain
` from the statements to the read. A function becomes a value of a function type only where it
` requires nothing, since what a call through the value requires reaches no caller; a closure
` holds the state of where it is made. What each function reads outside its bindings, with or
` without a value of its own, is recorded too.

_ program Program
_ instances Instances
_ facts Facts
_ paths CallPaths
_ holders [InstanceId]
_ modules [ModuleId]
_ decls [DeclId]
_ readers [InstanceId]
_ read-modules [ModuleId]
_ read-decls [DeclId]
_ keepers [InstanceId]
_ kept-modules [ModuleId]
_ kept-decls [DeclId]
_ call-heads [U32]
_ call-links [U32]

────────────────────
+ This
    - session Session
    - paths

.. program = session.program
.. instances = session.instances
.. facts = session.facts

────────────────────
+ do check

for read in facts.stack-reads
    . bound = binds(read.instance, read.syntax, read.module, read.decl)
    if !bound && !has-default(read.instance, read.module, read.decl)
        require(read.instance, read.module, read.decl)
. grew = holders.length != 0
while grew
    grew = false
    for call in facts.calls
        if call.callee != no-instance && requires-any(call.callee) && propagates(call.callee) && !dispatches
            grew = require-from(call.callee, call.instance, call.syntax) || grew
        .. dispatches = facts.dispatches-to(call.instance, call.callee)
    for slot in facts.witness-slots
        if slot.callee != no-instance && slot.proto != no-instance && requires-any(slot.callee)
            grew = require-from(slot.callee, slot.proto, 0) || grew
    for fact in facts.overrides
        if fact.override != no-instance && requires-any(fact.override)
            grew = require-from(fact.override, fact.base, 0) || grew
    . total = holders.length
    for position in 0 .. < total
        . holder = holders[position]
        . outer = instances.rows[holder].enclosing
        if outer != no-instance && is-nested(holder)
            . module = modules[position]
            . decl = decls[position]
            if !binds(outer, made-at(holder), module, decl)
                grew = require(outer, module, decl) || grew
check-values()
report()
gather-needs()
gather-holds()

────────────────────
_ do require-from Bool
    - callee InstanceId
    - caller InstanceId
    - syntax SyntaxId

. grew = false
. total = holders.length
for position in 0 .. < total
    if holders[position] == callee
        . module = modules[position]
        . decl = decls[position]
        if syntax == 0 || !binds(caller, syntax, module, decl)
            grew = require(caller, module, decl) || grew
= grew

────────────────────
_ do gather-needs

` Records the globals each function reads outside its own bindings of them, itself or through
` the functions it calls outside one. Calling a nested function reads nothing: it holds what
` it captured. Each function found to read one hands it on to the calls of it once.
for read in facts.stack-reads
    if !binds(read.instance, read.syntax, read.module, read.decl)
        need(read.instance, read.module, read.decl)
if readers.length != 0
    index-calls()
. next Size = 0
while next < readers.length
    . module = read-modules[next]
    . decl = read-decls[next]
    . call = call-heads[readers[next]]
    next += 1
    while call != U32.max
        . fact = facts.calls[call]
        if !binds(fact.instance, fact.syntax, module, decl)
            need(fact.instance, module, decl)
        call = call-links[call]
for position in 0 .. < readers.length
    facts.stack-needs.append
        - StackNeed(readers[position], read-modules[position], read-decls[position])

────────────────────
_ do index-calls

` Chains the calls of each function that hands on what it reads to its callers.
for instance in 0 .. < instances.length
    call-heads += U32.max
for position in 0 .. < facts.calls.length
    call-links += U32.max
    . callee = facts.calls[position].callee
    if callee != no-instance && propagates(callee)
        call-links[position] = call-heads[callee]
        call-heads[callee] = position as U32

────────────────────
_ do gather-holds

` Records the globals whose state each nested function holds from where it is made: those it
` reads outside its own bindings of them, and those each function nested in it holds where no
` binding of its own is open where that function is made. A function that is not nested reads
` the slot of the task running where it makes one.
for position in 0 .. < readers.length
    if is-nested(readers[position])
        hold(readers[position], read-modules[position], read-decls[position])
. grew = keepers.length != 0
while grew
    grew = false
    . total = keepers.length
    for position in 0 .. < total
        . outer = instances.rows[keepers[position]].enclosing
        if outer != no-instance && is-nested(outer)
            . module = kept-modules[position]
            . decl = kept-decls[position]
            if !binds(outer, made-at(keepers[position]), module, decl)
                grew = hold(outer, module, decl) || grew
for position in 0 .. < keepers.length
    facts.stack-holds.append
        - StackHold(keepers[position], kept-modules[position], kept-decls[position])

────────────────────
_ do hold Bool
    - keeper InstanceId
    - module ModuleId
    - decl DeclId

for position in 0 .. < keepers.length
    if keepers[position] == keeper && kept-modules[position] == module && same-decl
        = false
    .. same-decl = kept-decls[position] == decl
keepers += keeper
kept-modules += module
kept-decls += decl
= true

────────────────────
_ do is-nested Bool
    - instance InstanceId

. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = is-nested-kind(fn.kind)
= false

────────────────────
_ do made-at SyntaxId
    - instance InstanceId

` Where a nested function is written in the function it is nested in.
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.syntax
= 0

────────────────────
_ do need Bool
    - reader InstanceId
    - module ModuleId
    - decl DeclId

for position in 0 .. < readers.length
    if readers[position] == reader && read-modules[position] == module && same-decl
        = false
    .. same-decl = read-decls[position] == decl
readers += reader
read-modules += module
read-decls += decl
= true

────────────────────
_ do require Bool
    - holder InstanceId
    - module ModuleId
    - decl DeclId

for position in 0 .. < holders.length
    if holders[position] == holder && modules[position] == module && decls[position] == decl
        = false
holders += holder
modules += module
decls += decl
= true

────────────────────
_ do requires-any Bool
    - holder InstanceId

for known in holders
    if known == holder
        = true
= false

────────────────────
_ do binds Bool
    - instance InstanceId
    - syntax SyntaxId
    - module ModuleId
    - decl DeclId

for scope in facts.stack-scopes
    if scope.instance == instance && scope.module == module && scope.decl == decl
        if syntax >= scope.first && syntax <= scope.last
            = true
= false

────────────────────
_ do has-default Bool
    - instance InstanceId
    - module ModuleId
    - decl DeclId

` Whether a read of a global `do with` binds has a value where none is bound: the one written, or
` for an effect the real doors, which a door reached where no fake is bound calls.
do match? program.modules[module].decls[decl]
    | .decl-property(row)
        = row.value != 0
    | .decl-effect
        . effect = program.effects.index-of(module, decl)
        = !effect || instances.fake-of(instances.rows[instance].effects, effect) == no-type
= false

────────────────────
_ do propagates Bool
    - callee InstanceId

. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = !is-nested-kind(fn.kind)
= true

────────────────────
_ is-root Bool
    - holder InstanceId

program.modules[row.module].main-decl == row.decl

.. row = instances.rows[holder]

────────────────────
_ do report

for position in 0 .. < holders.length
    if is-root(holders[position])
        report-unbound(holders[position], modules[position], decls[position])

────────────────────
_ do report-unbound
    - root InstanceId
    - module ModuleId
    - decl DeclId

. found = paths.chain-from(root, :: edge CallEdge => carries(edge, module, decl), :: instance InstanceId => read-in(instance, module, decl) != 0)
. reader = if found && found.length != 0 then found[found.length - 1].callee else root
. read = read-in(reader, module, decl)
. names [String]
names += paths.name-of(root)
if found
    names ++= paths.names(found)
. chain = if names.length > 1 then ": ${" → ".join(names)}" else ""
. message = program.store-atom("${subject-of(module, decl)} is not bound$chain")
if read == 0
    facts.record-diagnostic(root, module, site-of(module, decl), .reached, message)
    =
facts.record-diagnostic(root, instances.rows[reader].module, read, .reached, message)

────────────────────
_ do check-values

` A function made a value of a function type requires nothing of where it is called, since no
` call through the value reaches it: reported where it is made, with the chain to a read.
=? if holders.length == 0
for fact in facts.conversions
    check-value(fact.instance, fact.syntax, fact.runs)
for fact in facts.conversion-parts
    check-value(fact.instance, fact.syntax, fact.runs)

────────────────────
_ do check-value
    - maker InstanceId
    - site SyntaxId
    - runs InstanceId

=? if runs == no-instance || maker == no-instance || maker == instances.dead || is-nested(runs)
for position in 0 .. < holders.length
    if holders[position] == runs
        . module = modules[position]
        . decl = decls[position]
        . found = paths.chain-from(runs, :: edge CallEdge => carries(edge, module, decl), :: instance InstanceId => read-in(instance, module, decl) != 0)
        . names [String]
        names += paths.name-of(runs)
        if found
            names ++= paths.names(found)
        . text = "${subject-of(module, decl)} cannot be read through a function value: ${" → ".join(names)}"
        facts.record-diagnostic(maker, instances.rows[maker].module, site, .reached, program.store-atom(text))

────────────────────
_ do carries Bool
    - edge CallEdge
    - module ModuleId
    - decl DeclId

` Whether a global the function an edge reaches requires reaches the function it leaves.
=? false if !requires(edge.callee, module, decl)
do match edge.kind
    |= .edge-call
        = propagates(edge.callee) && !binds(edge.caller, edge.syntax, module, decl)
    |= .edge-answer
        = true
    |= .edge-made
        = !binds(edge.caller, edge.syntax, module, decl)
    ??
        = false
= false

────────────────────
_ do requires Bool
    - holder InstanceId
    - module ModuleId
    - decl DeclId

for position in 0 .. < holders.length
    if holders[position] == holder && modules[position] == module && decls[position] == decl
        = true
= false

────────────────────
_ do read-in SyntaxId
    - instance InstanceId
    - module ModuleId
    - decl DeclId

` A read of a global in a function outside a binding of its own, or none.
for read in facts.stack-reads
    if read.instance == instance && read.module == module && read.decl == decl
        if !binds(instance, read.syntax, module, decl)
            = read.syntax
= 0

────────────────────
_ do subject-of String
    - module ModuleId
    - decl DeclId

` What an error names a global `do with` binds as: a stack-local variable, or the fake bound to
` an effect.
do match? program.modules[module].decls[decl]
    | .decl-effect(row)
        = "The fake bound to '${row.name.text}'"
= "Stack-local variable '${name-of(module, decl)}'"

────────────────────
_ do name-of String
    - module ModuleId
    - decl DeclId

do match? program.modules[module].decls[decl]
    | .decl-property(row)
        if row.name
            = row.name.text
= ""

────────────────────
_ do site-of SyntaxId
    - module ModuleId
    - decl DeclId

do match? program.modules[module].decls[decl]
    | .decl-property(row)
        = row.syntax
= 0
