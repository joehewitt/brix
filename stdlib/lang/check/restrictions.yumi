./call-paths
./facts
./instances
./session
./type-text
./types
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program

━━━━━━━━━━━━━━━━━━━━
+ restricting-effects EffectMask

CompilationEffect.gc-free /or/ CompilationEffect.no-heap /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend

━━━━━━━━━━━━━━━━━━━━
+ Restrictions

` A restriction broken is reported with the chain from where it is placed to where it is broken,
` once typing has found every call: from a function that declares it, or from one whose `do` block
` enters it, through each function typed again under it, to the code that breaks it. The report
` is then `reached`: stated with its chain, and shown however many its function has. A ban is
` broken where a door of the effect it bans is reached under it, which is reported at each call of
` the door, or at each call of an interface member a door answers, with the same chain. A door a
` fake answers under a `do with` is no door reached, and one the fake cannot answer is reported in
` the same way, with the chain from the `do with`; where only a door reached outside every binding
` calls it, as code a function value runs is, that is a panic where it runs.

_ session Session
_ paths CallPaths

────────────────────
+ This
    - session
    - paths

────────────────────
+ do chain-reports

. facts = session.facts
for position in 0 .. < facts.diagnostics.length
    . row = facts.diagnostics[position]
    if row.kind == .restricted
        . name = row.name
        if name
            . need = dispatch-effects(session.instances.rows[row.instance].effects) /and/ restricting-effects()
            . chain = chain-text(row.instance, row.module, row.syntax, need, restricting-effects())
            . text = if chain.length == 0 then name.text else "${name.text}: $chain"
            facts.diagnostics[position].name = session.program.store-atom(text)
        facts.diagnostics[position].kind = .reached
report-bans()
report-swaps()

────────────────────
_ do report-bans

. table = session.program.effects
=? if table.count == 0
. instances = session.instances
for position in 0 .. < instances.length
    . id = position as InstanceId
    if id != instances.dead
        . row = instances.rows[id]
        . door = table.door-of(row.module, row.decl)
        if door && door < most-effects() && (dispatch-effects(row.effects) /and/ ban-bit(door)) != 0 && real
            . reported = false
            for edge in paths.edges-into(id)
                reported = report-door(edge, id, door, 0) || reported
            if !reported
                report-unreached(id, door)
        .. real = !door || instances.fake-of(row.effects, door) == no-type

────────────────────
_ do report-swaps

for forward in session.facts.swap-forwards
    if forward.instance != session.instances.dead && forward.miss != .swap-answered
        . reported = false
        . dispatched = false
        for edge in paths.edges-into(forward.instance)
            if session.facts.dispatches-to(edge.caller, forward.instance)
                dispatched = true
            else
                reported = report-swap(edge, forward, 0) || reported
        if !reported && !dispatched
            . row = session.instances.rows[forward.instance]
            . text = swap-text(forward, "")
            session.facts.record-diagnostic(forward.instance, row.module, 0, .reached, session.program.store-atom(text))

────────────────────
_ do report-swap Bool
    - edge CallEdge
    - forward SwapForward
    - depth Size

` Reports a door a fake cannot answer where the edge reaches it, with the chain from the `do with`
` that binds the fake: at a call, or at each call of the interface member it answers.
=? false if depth > 8
. instances = session.instances
if edge.syntax == 0
    . reported = false
    for outer in paths.edges-into(edge.caller)
        reported = report-swap(outer, forward, depth + 1) || reported
    = reported
. caller = instances.rows[edge.caller]
. need = dispatch-effects(caller.effects) /and/ swap-bits()
. found = if need == 0 then null else paths.chain-to(edge.caller, :: link CallEdge => step(link, need))
. parts [String]
. bound = session.program.effects.names[forward.effect].text
if found && found.length != 0
    parts += "${paths.name-of(found[0].caller)} (with $bound)"
    parts ++= paths.names(found)
else
    parts += "${paths.name-of(edge.caller)} (with $bound)"
. shown = site-text(caller.module, edge.syntax)
if shown.length != 0
    parts += shown
if depth != 0
    parts += paths.name-of(forward.instance)
. text = swap-text(forward, " → ".join(parts))
session.facts.record-diagnostic(edge.caller, caller.module, edge.syntax, .reached, session.program.store-atom(text))
= true

────────────────────
_ do swap-text String
    - forward SwapForward
    - chain String

` What a fake lacks to answer a door, with the chain to the door.
. effects = session.program.effects
. name = effects.names[forward.effect].text
. row = session.instances.rows[forward.instance]
. fake = session.instances.fake-of(row.effects, forward.effect)
. fake-name = type-short-name(session.types, fake)
. door = paths.name-of(forward.instance)
. said = match forward.miss
    |= .swap-missing
        "$fake-name has no method '$door' to answer the door of '$name'"
    |= .swap-mismatched
        "$fake-name.$door does not take and give what the door of '$name' does"
    ??
        "a fake answers only a door of '$name' that is a function of its module, and $door is not"
=? said if chain.length == 0
= "$said: $chain"

────────────────────
_ do report-unreached
    - door InstanceId
    - effect U32

` Reports a door held under a ban of its effect that no recorded call reaches, at the door, with
` the chain to it, so that no way of reaching one lets it pass.
. row = session.instances.rows[door]
. bit = ban-bit(effect)
. at = match session.program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        fn.syntax
    ??
        0u32
. chain = chain-text(door, row.module, 0, dispatch-effects(row.effects) /and/ bit, bit)
. name = session.program.effects.names[effect].text
. text = "cannot reach a door of '$name' under 'without $name': $chain"
session.facts.record-diagnostic(door, row.module, at, .reached, session.program.store-atom(text))

────────────────────
_ do report-door Bool
    - edge CallEdge
    - door InstanceId
    - effect U32
    - depth Size

` Reports a door of an effect reached under a ban of it where the edge reaches it: at a call, or
` at each call of the interface member it answers. A door of the effect that calls the door is
` reached under the ban itself, which is reported where it is. Answers whether it is reported.
. instances = session.instances
. table = session.program.effects
. caller = instances.rows[edge.caller]
=? true if table.door-of(caller.module, caller.decl) == effect
=? false if depth > 8
if edge.syntax == 0
    . reported = false
    for outer in paths.edges-into(edge.caller)
        reported = report-door(outer, door, effect, depth + 1) || reported
    = reported
. bit = ban-bit(effect)
. need = dispatch-effects(caller.effects) /and/ bit
. chain = chain-text(edge.caller, caller.module, edge.syntax, need, bit)
. reached = if depth == 0 then "" else " → ${paths.name-of(door)}"
. name = table.names[effect].text
. text = "cannot reach a door of '$name' under 'without $name': $chain$reached"
session.facts.record-diagnostic(edge.caller, caller.module, edge.syntax, .reached, session.program.store-atom(text))
= true

────────────────────
_ do chain-text String
    - broken InstanceId
    - module ModuleId
    - site SyntaxId
    - need EffectMask
    - placing EffectMask

` The chain from where what `need` names is placed to the site that breaks it: the function that
` breaks it, where its own header writes what `placing` names or it holds none of `need` and a
` `do` block of its own places it.
. parts [String]
if need == 0 || (written-effects(broken) /and/ placing) != 0
    parts += placed(broken, site)
else
    . found = paths.chain-to(broken, :: edge CallEdge => step(edge, need))
    =? "" if !found || found.length == 0
    parts += placed(found[0].caller, found[0].syntax)
    parts ++= paths.names(found)
. shown = site-text(module, site)
if shown.length != 0
    parts += shown
= " → ".join(parts)

────────────────────
_ do step EdgeStep
    - edge CallEdge
    - need EffectMask

` Each function a restriction reaches is typed again under it, so the walk goes back through
` those that have it and stops at the one that places it.
. held = dispatch-effects(session.instances.rows[edge.caller].effects) /and/ need
=? .step-reach if held != need || (written-effects(edge.caller) /and/ need) != 0
= .step-follow

────────────────────
_ do placed String
    - root InstanceId
    - at SyntaxId

` A function that places a restriction, with what it writes: its own `without` section, or that of
` the `do` block around where the chain leaves it. The body of a `do without gc` block is the
` function it is written in.
. row = session.instances.rows[root]
. written = written-effects(root) /and/ shown-effects()
. names = session.program.effects.names
if is-region(root) && row.enclosing != no-instance
    = "${paths.name-of(row.enclosing)} (do ${without-text(written, names)})"
if written != 0
    = "${paths.name-of(root)} (${without-text(written, names)})"
. block = block-effects(root, at)
=? "${paths.name-of(root)} (do ${without-text(block, names)})" if block != 0
= paths.name-of(root)

────────────────────
_ do written-effects EffectMask
    - instance InstanceId

. row = session.instances.rows[instance]
do match? session.program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.effects /or/ session.program.effects.bans-of(row.module, row.decl)
= 0

────────────────────
_ shown-effects EffectMask

` What a chain shows of a `without` section: the restrictions, and the bans.
restricting-effects() /or/ ban-bits()

────────────────────
_ do is-region Bool
    - instance InstanceId

. row = session.instances.rows[instance]
do match? session.program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.kind == .region-decl
= false

────────────────────
_ do block-effects EffectMask
    - instance InstanceId
    - at SyntaxId

` What the innermost `do` block of an instance that restricts code writes, among those around a
` node.
=? 0 if at == 0
. row = session.instances.rows[instance]
. tree = session.program.modules[row.module].tree
. found EffectMask = 0
. narrowest SyntaxId = 0
for offset in 0 .. < row.subtree.count
    . id = (row.subtree.start + offset) as SyntaxId
    do match? tree.nodes[id]
        | .node-do-block(block)
            . written = (block.compilation-effects as EffectMask) /or/ session.program.bans-named(row.module, block.bans)
            . effects = written /and/ shown-effects()
            if effects != 0 && tree.subtree-start(id) <= at && at <= id && (narrowest == 0 || id < narrowest)
                found = effects
                narrowest = id
= found

────────────────────
_ do site-text String
    - module ModuleId
    - site SyntaxId

` The code that breaks a restriction as written, where it is short and on one line, or the first
` line of a block that does.
=? "" if site == 0
. tree = session.program.modules[module].tree
. loc = tree.nodes.loc[site]
. line = source-line(tree.source, loc.begin.line)
. first = loc.begin.column as Size
if loc.begin.line != loc.end.line && is-block(tree.nodes[site])
    =? "" if line.length - first > 40
    = line[first ...].trim()
=? "" if loc.begin.line != loc.end.line || loc.end.column < loc.begin.column
. last = (loc.end.column as Size) + 1
=? "" if last > line.length || last - first > 40
= line[first .. < last]

━━━━━━━━━━━━━━━━━━━━
_ is-block Bool
    - node Syntax

match node
    | .node-do-block
        true
    | .node-do-task-block
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ do without-text String
    - effects EffectMask
    - names [Atom]

` Restrictions and bans as a `without` section writes them, leaving out the names another one
` implies, the bans after the restrictions.
. parts [String]
if (effects /and/ CompilationEffect.gc-free) != 0
    parts += "gc"
else
    if (effects /and/ CompilationEffect.no-heap) != 0
        parts += "heap"
    if (effects /and/ CompilationEffect.no-safepoint) != 0
        parts += "safepoints"
    else if (effects /and/ CompilationEffect.no-suspend) != 0
        parts += "suspend"
for index in 0 .. < names.length
    if index < most-effects() && (effects /and/ ban-bit(index as U32)) != 0
        parts += names[index].text
= "without ${", ".join(parts)}"
