(import ./instances)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)

(type + BanSite (is Struct)
  (prop + instance InstanceId)
  (prop + block SyntaxId)
  (prop + bans EffectMask)
)

(type _ BannedBlock (is Struct)
  (prop + module ModuleId)
  (prop + block SyntaxId)
  (prop + bans EffectMask)
)

(fn-do + ban-sites (list BanSite)
  (param program Program)
  (param instances Instances)
  (let sites (list BanSite))
  (return-if sites (if (== (. program effects count) 0)))
  (blank)
  (let blocks (list BannedBlock))
  (for (in module (..< 0 (. program modules length)))
    (let tree (. ([] (. program modules) module) tree))
    (for (in id (..< 1u32 (. tree nodes length)))
      (match? ([] (. tree nodes) id)
        (case (call .node-do-block block)
          (let bans (call (. program bans-named) (as module ModuleId) (. block bans)))
          (if (!= bans 0)
            (+= blocks (call BannedBlock (as module ModuleId) (as id SyntaxId) bans))
          )
        )
      )
    )
  )
  (for (in position (..< 0 (. instances length)))
    (let id (as position InstanceId))
    (if (!= id (. instances dead))
      (let row ([] (. instances rows) id))
      (let header (call (. program effects bans-of) (. row module) (. row decl)))
      (if (!= header 0)
        (+= sites (call BanSite id 0 header))
      )
      (for (in banned blocks)
        (if (and (== (. banned module) (. row module)) (>= (. banned block) (. row subtree start)) (< (. banned block) (+ (. row subtree start) (. row subtree count))))
          (+= sites (call BanSite id (. banned block) (. banned bans)))
        )
      )
    )
  )
  (return sites)
)

(fn-do + banned-anywhere EffectMask
  (param program Program)
  (param instances Instances)
  (let mask EffectMask 0)
  (for (in site (call ban-sites program instances))
    (= mask (/or/ mask (. site bans)))
  )
  (return mask)
)
