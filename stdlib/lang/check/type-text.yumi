./type-store
./types
/core/scratch
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ type-text String
    - types Types
    - id TypeId

types.rows[id].text(types)

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
+ do type-short-name String
    - types Types
    - id TypeId

` A type by the name of its class and the names of its arguments. An array on the collected
` heap is named without its backing.
. program = types.program
if id == no-type || id == invalid-type
    = "?"
. text = type-text(types, id)
do match? types.rows[id]
    | .type-class(row)
        text = class-name(program, row.module, row.decl)
        . count = row.args.count
        if count == 2 && is-default-backing(types, row)
            count = 1
        for position in 0 .. < count
            text += "'" ++ type-short-name(types, types.child-type(row.args, position))
= text

━━━━━━━━━━━━━━━━━━━━
+ do type-runtime-name String
    - types Types
    - id TypeId

` The name a type answers with in a running program: a class by its name and the names of
` its arguments, a parameter by its name, a closure as `Closure`, a tuple that has no name
` of its own as `Tuple`, and a union that has none, or a value that may be an error, as
` `Union`. An array on the collected heap is named without its backing.
if id == no-type || id == invalid-type
    = "?"
do match? types.rows[id]
    | .type-class(row)
        . text = class-name(types.program, row.module, row.decl)
        . count = row.args.count
        if count == 2 && is-default-backing(types, row)
            count = 1
        for position in 0 .. < count
            text += "'" ++ type-runtime-name(types, types.child-type(row.args, position))
        = text
    | .type-variable(row)
        = row.name.text
    | .type-closure
        = "Closure"
    | .type-tuple
        = "Tuple"
    | .type-union
        = "Union"
    | .type-result
        = "Union"
= type-text(types, id)

━━━━━━━━━━━━━━━━━━━━
+ type-runtime-key String
    - types Types
    - id TypeId

` The key a type answers with in a running program: its key, in which every optional is
` keyed as the struct that holds it, a value and a flag.
optionals-as-structs(type-key(types, id))

━━━━━━━━━━━━━━━━━━━━
_ do optionals-as-structs String
    - key String

. opening = "Class:core:Optional("
. found = key.find(opening)
if found == null
    = key
. head Index = found
. start Index = head + (opening.length as Index)
. depth = 1
. end Index = start
. position Index = 0
for char in key
    if position >= start && depth != 0
        if char == '('
            depth += 1
        else if char == ')'
            depth -= 1
            if depth == 0
                end = position
    position += 1
. inner = optionals-as-structs(key[start .. < end])
. rest = optionals-as-structs(key[end + 1 ...])
= key[... head] ++ "Struct:optional(" ++ inner ++ ", Class:core/number:I8)" ++ rest

━━━━━━━━━━━━━━━━━━━━
+ do type-display String
    - types Types
    - id TypeId

` A type as a diagnostic names it: a class of objects or an interface in brackets under its
` module, a tuple-like type or a named union by its own name, a tuple with no name by its
` fields, each under its name when it has one, and anything else by its key. A class that
` is a pointer is named as the pointer it is.
. program = types.program
if id == no-type || id == invalid-type
    = "?"
. completion = types.completion-of(id)
. kind = completion.intrinsic
do match? types.rows[id]
    | .type-class(row)
        if kind == .optional
            = "Optional:(${type-display(types, types.child-type(row.args, 0))})"
        if kind == .union
            = class-name(program, row.module, row.decl)
        if kind == .function
            = "[Function ${type-short-name(types, id)}]"
        if kind == .cpointer
            if types.const-array-decl.refers-to(row.module, row.decl)
                = "ConstArray'${type-display(types, types.child-type(row.args, 0))}"
            . base = types.base-of(id)
            if base
                = type-display(types, base)
            if row.args.count == 1
                = "${type-display(types, types.child-type(row.args, 0))}*"
        . named = qualified-name(program, row.module, row.decl)
        if intrinsic-is-tuple-like(kind)
            named = class-name(program, row.module, row.decl)
        . text = named ++ display-arguments(types, row)
        if kind == .interface
            = "[Interface $text]"
        if intrinsic-is-class(kind)
            = "[Object $text]"
        = text
    | .type-tuple(row)
        . fields = ""
        for offset in 0 .. < row.fields.count
            if offset
                fields += ", "
            . name = types.child-name(row.names, offset).text
            if name != "$offset"
                fields += "$name: "
            fields += type-display(types, types.child-type(row.fields, offset))
        = "Tuple:($fields)"
    | .type-closure(row)
        . written = program.modules[row.module].name
        = "[Closure $written:${closure-name(program, row.module, row.decl)}]"
    | .type-binding(row)
        = "[Binding ${binding-name(types, row)}]"
= type-key(types, id)

━━━━━━━━━━━━━━━━━━━━
+ do type-source String
    - types Types
    - id TypeId

if id == no-type || id == invalid-type
    = "?"
. settled = types.completions[id].completion == .completion-done
. optional = settled && types.completion-of(id).intrinsic == .optional
do match? types.rows[id]
    | .type-class(row)
        if optional
            = "${type-source(types, types.child-type(row.args, 0))}?"
        if types.list-decl.refers-to(row.module, row.decl) && row.args.count != 0
            = "[${type-source(types, types.child-type(row.args, 0))}]"
        if types.map-decl.refers-to(row.module, row.decl) && row.args.count > 1
            = "[${type-source(types, types.child-type(row.args, 0))} = $value-text]"
                .. value-text = type-source(types, types.child-type(row.args, 1))
        . text = class-name(types.program, row.module, row.decl)
        . count = row.args.count
        if count == 2 && is-default-backing(types, row)
            count = 1
        for position in 0 .. < count
            text += "'" ++ type-source(types, types.child-type(row.args, position))
        = text
    | .type-tuple(row)
        . fields [String]
        for position in 0 .. < row.fields.count
            fields += type-source(types, types.child-type(row.fields, position))
        = "(${", ".join(fields)})"
    | .type-union(row)
        . cases [String]
        for position in 0 .. < row.cases.count
            cases += type-source(types, types.child-type(row.cases, position))
        = " | ".join(cases)
    | .type-variable(row)
        = row.name.text
    | .type-closure
        = "closure"
    | .type-binding(row)
        . name = binding-name(types, row)
        = if name.length != 0 then "function $name" else "function"
= type-display(types, id)

━━━━━━━━━━━━━━━━━━━━
+ do string-cast-text String?
    - types Types
    - id TypeId

` The text a value becomes where its type has no converter to String, for the types that have
` one here: nothing is the name a diagnostic gives it, as is a binding or a value of a
` function type, a pointer is that name in brackets, and an object is the name of the class
` it is held as, or of the interface.
. kind = types.completion-of(id).intrinsic
if kind == .void || kind == .binding || kind == .function
    = type-display(types, id)
if kind == .cpointer
    = "[CPointer ${type-display(types, id)}]"
if kind == .class || kind == .interface
    do match? types.rows[id]
        | .type-class
            = type-display(types, id)
= null

━━━━━━━━━━━━━━━━━━━━
_ display-arguments String
    - types Types
    - row ClassType

` An array on the collected heap is named without its backing.
"".join("'${type-display(types, types.child-type(row.args, each))}" in 0 .. < count)

.. count = if row.args.count == 2 && is-default-backing(types, row) then 1 else row.args.count

━━━━━━━━━━━━━━━━━━━━
_ is-default-backing Bool
    - types Types
    - row ClassType

types.array-decl.refers-to(row.module, row.decl) && gc-backed

.. gc-backed = types.child-type(row.args, 1) == types.gc-backing-type

━━━━━━━━━━━━━━━━━━━━
_ do binding-name String
    - types Types
    - row BindingType

` A binding is named for what it calls: the type a constructor makes, by the name it has in
` a running program, the function, or a nested function as a stack trace names it. One of a
` value of a function type has no name.
. program = types.program
if row.form == .bound-constructor && row.object != no-type
    = type-runtime-name(types, row.object)
if row.form == .bound-closure
    do match? types.rows[row.object]
        | .type-closure(nested)
            = closure-name(program, nested.module, nested.decl)
    = ""
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.name
            = fn.name.text
= ""

━━━━━━━━━━━━━━━━━━━━
+ do closure-name String
    - program Program
    - module ModuleId
    - decl DeclId
    - property Atom? = null

` A closure is named for the variable whose declaration or assignment it is written in,
` within the function that writes it, as the declarations note it. The function generated for
` a comprehension or a loop on a stream is named for the container of its loop, as is the one
` for a stream piped through a pattern for the stream, and the one for the right side of a
` pipe has one name, as has the one that runs a live statement again: `assignment`, `var` for
` a declaration, or `prop-` and the property's name for an attribute of a markup element, and
` for an argument of one given by position, the property its parameter names, `property`.
` The one that tests a `whenever` clause again is `whenever`, and the one that tests the
` condition a style rule is applied under again `style-gate`. One that builds an arm of a
` markup branch region is `markup-branch-arm`, or of a match region `markup-match-arm`, and the
` one that selects its arm again `markup-branch`. What is written on the left of a pipe is
` written by the function the pipe is in.
. owner = program.modules[module]
. tree = owner.tree
. named = 0u32
do match? owner.decls[decl]
    | .decl-function(fn)
        if fn.kind == .pipeline-decl
            = "(pipeline)"
        if fn.kind == .live-decl
            if tree.argument-element(fn.syntax) != 0
                = if property then "prop-${property.text}" else "prop"
            if tree.attribute-element(fn.syntax) != 0
                do match? tree.nodes[fn.syntax]
                    | .node-assign(row)
                        do match? tree.nodes[row.lhs]
                            | .node-identifier(target)
                                = "prop-${target.name.text}"
            = if tree.nodes[fn.syntax] is .node-declare then "var" else "assignment"
        if fn.kind == .whenever-decl
            = "whenever"
        if fn.kind == .gate-decl
            = "style-gate"
        if fn.kind == .branch-arm-decl
            = if tree.body-arm(fn.syntax) != 0 then "markup-match-arm" else "markup-branch-arm"
        if fn.kind == .branch-decl
            = "markup-branch"
        if fn.kind == .row-decl
            = "collection-row"
        if fn.kind == .source-decl
            = "collection-source"
        if fn.kind == .key-decl
            = "collection-key"
        if fn.kind == .slot-decl
            = "markup-slot"
        if fn.kind == .binder-decl
            = "markup-id-binder"
        if fn.kind == .subscriber-decl
            do match? tree.nodes[fn.syntax]
                | .node-for-block(row)
                    do match? tree.nodes[row.loop]
                        | .node-loop-syntax(loop)
                            = "on ${description-of(tree, loop.container)}"
                | .node-iterator-expression(row)
                    do match? tree.nodes[row.loop]
                        | .node-loop-syntax(loop)
                            = "on ${description-of(tree, loop.container)}"
        if fn.kind == .iterator-decl
            do match? tree.nodes[fn.syntax]
                | .node-iterator-expression(row)
                    do match? tree.nodes[row.loop]
                        | .node-loop-syntax(loop)
                            = "on ${description-of(tree, loop.container)}"
                | .node-pipeline-expression(row)
                    = "on ${description-of(tree, row.left)}"
                | .node-binary-expression(row)
                    = "on ${description-of(tree, row.lhs)}"
        named = fn.named-by
if named == 0
    = "anon"
do match? tree.nodes[named]
    | .node-declare(row)
        = declared-name(tree, row.left)
    | .node-assign(row)
        = target-name(tree, row.lhs)
= "anon"

━━━━━━━━━━━━━━━━━━━━
+ do description-of String
    - tree AST
    - id SyntaxId

` How the reference describes an expression in the name of a function generated for it: a
` name as it is written, a property after what it is read from, and anything else as a
` node.
do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name.text
    | .node-ref-identifier(row)
        = row.name.text
    | .node-symbol(row)
        = row.name.text
    | .node-c-identifier(row)
        = row.name.text
    | .node-get-expression(row)
        = "${description-of(tree, row.object)}.${row.name.text}"
    | .node-style-read-expression(row)
        = "$$${row.name.text}"
    | .node-style-property-expression(row)
        . component = row.component
        = if component then "${row.name.text}.${component.text}" else row.name.text
    | .node-markup-read-expression(row)
        = "%${row.name.text}"
= "node"

━━━━━━━━━━━━━━━━━━━━
_ do declared-name String
    - tree AST
    - left SyntaxId

` A declaration of several locals together names a closure for the last of them.
do match? tree.nodes[left]
    | .node-tuple-syntax(row)
        if row.items.count != 0
            = declared-name(tree, tree.children[row.items.start + row.items.count - 1])
    | .node-type-tuple(row)
        if row.field-types.count != 0
            = declared-name(tree, tree.children[row.field-types.start + row.field-types.count - 1])
= target-name(tree, left)

━━━━━━━━━━━━━━━━━━━━
_ do target-name String
    - tree AST
    - target SyntaxId

do match? tree.nodes[target]
    | .node-identifier(row)
        = row.name.text
    | .node-type-capture(row)
        = target-name(tree, row.id)
= "anon"

━━━━━━━━━━━━━━━━━━━━
+ type-key String
    - types Types
    - id TypeId

match types.rows[id]
    | .type-class(row)
        class-key(types, row.module, row.decl, row.args)
    | .type-variable(row)
        "Variable::${row.name.text}"
    | .type-inference(row)
        "Variable::(T${row.ordinal})"
    | .type-tuple(row)
        "Tuple:(${field-keys(types, row.fields, row.names)})"
    | .type-struct(row)
        "StructType:(${field-keys(types, row.fields, row.names)})"
    | .type-union(row)
        "Union:(${joined-keys(types, row.cases, " | ")})"
    | .type-named-union(row)
        named-union-key(types, row.owner, row.cases, row.names)
    | .type-function
        function-key(types, id)
    | .type-result(row)
        result-key(types, row.value, row.errors)
    | .type-associated(row)
        associated-key(types, row.module, row.decl, row.owner, row.name, row.args)
    | .type-binding
        "Binding"
    | .type-closure(row)
        closure-key(program, row.module, row.decl)
    ??
        type-text(types, id)

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
+ ratio-text String
    - ratio UnitRatio

"$multiplier/$divisor"

.. multiplier = ((ratio.multiplier * 1000000.0) + 0.5) as I64
.. divisor = ((ratio.divisor * 1000000.0) + 0.5) as I64

━━━━━━━━━━━━━━━━━━━━
+ do order-errors
    - types Types
    - mark ScratchMark

` Puts the errors above the mark in the order of their keys and drops repeats. TypeScript keeps
` an error set in this order, and it does not depend on which error typing reached first.
. items = types.scratch.types
. total = items.length
if total - mark < 2
    =
. keys [String]
for position in mark .. < total
    keys += type-key(types, items[position])
for position in mark + 1 .. < total
    . value = items[position]
    . key = keys[position - mark]
    . slot = position
    while slot > mark && keys[slot - 1 - mark] > key
        items[slot] = items[slot - 1]
        keys[slot - mark] = keys[slot - 1 - mark]
        slot -= 1
    items[slot] = value
    keys[slot - mark] = key
. write = mark
for read in mark .. < total
    if write == mark || items[write - 1] != items[read]
        items[write] = items[read]
        write += 1
items.rewind(write)

━━━━━━━━━━━━━━━━━━━━
+ do result-type TypeId
    - types Types
    - value TypeId
    - mark ScratchMark

` The type of a value that can come with any of the errors above the mark.
order-errors(types, mark)
= types.intern-ordered-result(value, mark)

━━━━━━━━━━━━━━━━━━━━
+ closure-key String
    - program Program
    - module ModuleId
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-function(row)
        "Closure@${loc.begin.line - shift}:${loc.begin.column}"
            .. loc = program.modules[module].tree.nodes.loc[row.syntax]
            .. shift = if is-shifted then 1 else 0
            .. is-shifted = row.kind == DeclKind.iterator-decl || row.kind == DeclKind.pipeline-decl
    ??
        "Closure@?"

━━━━━━━━━━━━━━━━━━━━
+ class-name String
    - program Program
    - module ModuleId
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-class(row)
        row.name.text
    ??
        "<class?>"

━━━━━━━━━━━━━━━━━━━━
+ qualified-name String
    - program Program
    - module ModuleId
    - decl DeclId

"$module-name:$shown"

.. module-name = program.modules[module].name
.. shown = class-name(program, module, decl)

━━━━━━━━━━━━━━━━━━━━
_ class-key String
    - types Types
    - module ModuleId
    - decl DeclId
    - args RowRange'TypeId

|? args.count == 0
    nominal
|? nominal == "Class:core:ConstArray"
    "ConstArray:$list"
??
    "$nominal($list)"

.. nominal = "Class:${qualified-name(program, module, decl)}"
.. list = joined-keys(types, args, ", ")

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ do function-key String
    - types Types
    - id TypeId

. program = types.program
do match? types.rows[id]
    | .type-function(row)
        . head = if row.is-c then "CFunction:" else qualified-name(program, row.module, row.decl)
        . arg-list = joined-keys(types, row.args, ", ")
        . ret = type-key(types, row.return-type)
        . tail = ""
        if row.errors.count != 0
            tail = " ?! ${joined-keys(types, row.errors, " | ")}"
        = "$head($arg-list) => $ret$tail"
= "<function?>"

━━━━━━━━━━━━━━━━━━━━
_ named-union-key String
    - types Types
    - owner Atom
    - cases RowRange'TypeId
    - names RowRange'Atom

"AnonymousNamedUnion:(${owner.text} | $case-list)"

.. case-list = case-keys(types, cases, names)

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ result-key String
    - types Types
    - value TypeId
    - errors RowRange'TypeId

"Union:($value-key | $error-list)"

.. value-key = type-key(types, value)
.. error-list = joined-keys(types, errors, " | ")

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ associated-key String
    - types Types
    - module ModuleId
    - decl DeclId
    - owner TypeId
    - name Atom
    - args RowRange'TypeId

"associated:$owner-key.$declaring:${name.text}'$arg-list"

.. owner-key = type-key(types, owner)
.. declaring = qualified-name(program, module, decl)
.. arg-list = joined-keys(types, args, "'")

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ field-keys String
    - types Types
    - fields RowRange'TypeId
    - names RowRange'Atom

", ".join(keys)

.. keys = <* offset in 0 .. < fields.count
    "(${types.child-name(names, offset).text}:${type-key(types, types.child-type(fields, offset))})"
.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ case-keys String
    - types Types
    - cases RowRange'TypeId
    - names RowRange'Atom

" | ".join(keys)

.. keys = <* offset in 0 .. < cases.count
    "${types.child-name(names, offset).text}:${payload-key(types, types.child-type(cases, offset))}"
.. program = types.program

━━━━━━━━━━━━━━━━━━━━
_ payload-key String
    - types Types
    - payload TypeId

if payload == types.void-type then "" else type-key(types, payload)

━━━━━━━━━━━━━━━━━━━━
_ joined-keys String
    - types Types
    - range RowRange'TypeId
    - separator String

separator.join(type-key(types, types.child-type(range, each)) in 0 .. < range.count)

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
+ extend InvalidType

────────────────────
+ text String
    - types Types

"<invalid>"

━━━━━━━━━━━━━━━━━━━━
+ extend ClassType

────────────────────
+ text String
    - types Types

|? args.count == 0
    shown
??
    "$shown'$list"
        .. list = range-text(types, args)

.. shown = class-name(program, module, decl)

.. program = types.program

