    (= has-atom (call (. program store-atom) "has"))
    (= length-atom (call (. program store-atom) "length"))
    (= data-atom (call (. program store-atom) "data"))
    (= items-atom (call (. program store-atom) "items"))
    (= call-atom (call (. program store-atom) "()"))
    (= item-atom (call (. program store-atom) "Item"))
    (= value-type-atom (call (. program store-atom) "Value"))
    (= reserve-atom (call (. program store-atom) "reserve"))
    (= append-atom (call (. program store-atom) "append"))
