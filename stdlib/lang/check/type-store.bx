  (fn-do + well-known-type TypeId
    (param module-name String)
    (param class-name String)
    (let ref (call well-known-decl module-name class-name))
    (if (and (== (. ref module) 0) (== (. ref decl) 0))
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (return (call intern-class (. ref module) (. ref decl) mark))
  )
  (fn-do + well-known-type-of TypeId
    (param module-name String)
    (param class-name String)
    (param argument TypeId)
    (param second TypeId (= no-type))
    (let ref (call well-known-decl module-name class-name))
    (if (and (== (. ref module) 0) (== (. ref decl) 0))
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) argument)
    (if (!= second no-type)
      (call (. scratch types push) second)
    )
    (return (call class-with-args (. ref module) (. ref decl) mark))
  )
  (fn-do + well-known-alias TypeId
    (param module-name String)
    (param class-name String)
    ; A type a module of the standard library names for a C function type, which is that type.
    (let ref (call well-known-decl module-name class-name))
    (if (and (== (. ref module) 0) (== (. ref decl) 0))
      (return invalid-type)
    )
    (return (call through-alias (. ref module) (. ref decl) (call intern-class (. ref module) (. ref decl) (. scratch types mark))))
  )
  (fn-expr + is-builtin-decl Bool
    (param module ModuleId)
    (param decl DeclId)
    (not (not ([] builtin-decls (call pack-decl module decl))))
  )
  (fn-expr + intrinsic-for-decl IntrinsicKind
    (param module ModuleId)
    (param decl DeclId)
    (case? found
      (as found IntrinsicKind)
    )
    (default
      (. IntrinsicKind none)
    )
    (where
      (lazy found ([] types-by-decl (call pack-decl module decl)))
    )
  )
  (fn-expr + type-row TypeId
    (param type IntrinsicKind)
    (case? found
      (as found TypeId)
    )
    (default
      invalid-type
    )
    (where
      (lazy found ([] rows-by-type type))
    )
  )
  (fn-expr + type-decl DeclRef
    (param type IntrinsicKind)
    (match ([] rows (call type-row type))
      (case (call .type-class row)
        (call DeclRef (. row module) (. row decl))
      )
      (default
        (call DeclRef 0 0)
      )
    )
  )
  (fn-do + is-class-type Bool
    (param id TypeId)
    ; Whether a type is a class whose values are objects, a style or a sheet of styles among them.
    (if (or (== id no-type) (== id invalid-type))
      (return false)
    )
    (if (not (call intrinsic-is-class (. ([] completions id) intrinsic)))
      (return false)
    )
    (match? ([] rows id)
      (case .type-class
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + is-plain-tuple Bool
    (param id TypeId)
    (match ([] rows id)
      (case .type-tuple
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + is-pattern-func Bool
    (param id TypeId)
    (if (or (== id no-type) (== id invalid-type))
      (return false)
    )
    (match? ([] rows id)
      (case (call .type-class row)
        (return (call (. pattern-func-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return false)
  )
  (fn-expr + is-optional Bool
    (param id TypeId)
    (match ([] rows id)
      (case (call .type-class row)
        (and (== (. row module) (. owner module)) (== (. row decl) (. owner decl)) (== (. row args count) 1))
      )
      (default
        false
      )
    )
    (where
      (lazy owner (call type-decl .optional))
    )
  )
  (fn-expr + optional-inner TypeId
    (param id TypeId)
    (case? (call is-optional id)
      (match ([] rows id)
        (case (call .type-class row)
          (call child-type (. row args) 0)
        )
        (default
          id
        )
      )
    )
    (default
      id
    )
  )
  (fn-do + optional-of TypeId
    (param id TypeId)
    (if (or (call is-optional id) (== id invalid-type))
      (return id)
    )
    (let owner (call type-decl .optional))
    (let mark (. scratch types mark))
    (call (. scratch types push) id)
    (return (call intern-class (. owner module) (. owner decl) mark))
  )
  (fn-do + optional-around TypeId
    (param id TypeId)
    ; An optional that holds a value of a type or nothing, even where the type is an optional
    ; itself: what a step of a generator gives of its items, where an item that holds nothing
    ; is not the end.
    (if (== id invalid-type)
      (return id)
    )
    (let owner (call type-decl .optional))
    (let mark (. scratch types mark))
    (call (. scratch types push) id)
    (return (call intern-class (. owner module) (. owner decl) mark))
  )
  (fn-do + column-view-of TypeId
    (param field TypeId)
    (param immutable Bool)
    (let owner (call type-decl (if-expr immutable .immutable-table-column .table-column)))
    (let mark (. scratch types mark))
    (call (. scratch types push) field)
    (return (call intern-class (. owner module) (. owner decl) mark))
  )
  (fn-do + array-view-of TypeId
    (param owner DeclRef)
    (param item TypeId)
    (param access TypeId)
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) access)
    (return (call intern-class (. owner module) (. owner decl) mark))
  )
  (fn-do + shared-case-base TypeId
    (param union TypeId)
    (param above TypeId (= no-type))
    ; The nearest base every case of a union derives from, or the next one above a base given.
    (let cases (call cases-of union))
    (if (== (. cases length) 0)
      (return no-type)
    )
    (for (in fact cases)
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return no-type)
      )
    )
    (let base (?? (call base-of (if-expr (!= above no-type) above (. ([] cases 0) type))) no-type))
    (while (!= base no-type)
      (let ref (call DeclRef 0 0))
      (match? ([] rows base)
        (case (call .type-class row)
          (= ref (call DeclRef (. row module) (. row decl)))
        )
      )
      (let shared true)
      (for (in fact cases)
        (if (!= (call ancestor-of (. fact type) ref) base)
          (= shared false)
        )
      )
      (if shared
        (return base)
      )
      (= base (?? (call base-of base) no-type))
    )
    (return no-type)
  )
  (fn-do + ancestor-of TypeId
    (param id TypeId)
    (param ref DeclRef)
    (let current id)
    (while true
      (call complete current)
      (match? ([] rows current)
        (case (call .type-class row)
          (if (and (== (. row module) (. ref module)) (== (. row decl) (. ref decl)))
            (return current)
          )
        )
      )
      (let base (call base-of current))
      (if (not base)
        (return no-type)
      )
      (= current base)
    )
  )
  (fn-do + is-arena Bool
    (param id TypeId)
    ; Whether a type is `core/arena`'s `Arena`.
    (match? ([] rows id)
      (case (call .type-class row)
        (let module ([] (. program modules) (. row module)))
        (match? ([] (. module decls) (. row decl))
          (case (call .decl-class owner)
            (return (and (== (. module name) "core/arena") (== (. owner name text) "Arena")))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + is-arena-backing Bool
    (param id TypeId)
    ; Whether a type is `core/arena`'s `ArenaBacking`.
    (match? ([] rows id)
      (case (call .type-class row)
        (let module ([] (. program modules) (. row module)))
        (match? ([] (. module decls) (. row decl))
          (case (call .decl-class owner)
            (return (and (== (. module name) "core/arena") (== (. owner name text) "ArenaBacking")))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + builder-item TypeId
    (param id TypeId)
    ; The type of the items of an `ArrayBuilder` an arena backs, or none for any other type.
    (call complete id)
    (if (!= (. ([] completions id) intrinsic) .array-builder)
      (return no-type)
    )
    (match? ([] rows id)
      (case (call .type-class row)
        (if (and (> (. row args count) 1) (call is-arena-backing (call child-type (. row args) 1)))
          (return (call child-type (. row args) 0))
        )
      )
    )
    (return no-type)
  )
  (fn-do + intern-class TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param mark ScratchMark)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (call ensure-scratch (+ 3 count))
    (= ([] key-scratch 0) (. TypeTag class))
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 3 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 3 count)) U32))
    (if (. keys last-inserted)
      (let args (call store-items mark))
      (call (. rows append) (call ClassType module decl args (call (of RowRange TypeId))))
      (call add-completion)
      (call note-children id args)
      (if (call is-builtin-decl module decl)
        (call set-flag id .flag-builtin)
      )
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + intern-raising-class TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param mark ScratchMark)
    (param errors-mark ScratchMark)
    ; A class whose value is a function that raises errors its declaration does not state, as
    ; the generator of a function that yields and raises is. The arguments are above `mark` and
    ; the errors above `errors-mark`, in the order `order-errors` gives them. With no errors it
    ; is the class itself.
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (if (== (. scratch types length) errors-mark)
      (return (call intern-class module decl mark))
    )
    (let count (- (. scratch types length) mark))
    (call ensure-scratch (+ 4 count))
    (= ([] key-scratch 0) (. TypeTag raising-class))
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (= ([] key-scratch 3) (as (- errors-mark mark) U32))
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 4 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 4 count)) U32))
    (if (. keys last-inserted)
      (let errors (call store-items errors-mark))
      (call (. scratch types rewind) errors-mark)
      (let args (call store-items mark))
      (call (. rows append) (call ClassType module decl args errors))
      (call add-completion)
      (call note-children id args)
      (call note-children id errors)
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + intern-variable TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param index U32)
    (param name Atom)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (call ensure-scratch 4)
    (= ([] key-scratch 0) (. TypeTag variable))
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (= ([] key-scratch 3) index)
    (let id U32 (as (call (. keys store) (. key-scratch data) 4) U32))
    (if (. keys last-inserted)
      (call (. rows append) (call VariableType module decl index name))
      (call add-completion)
      (call set-flag id .flag-variables)
    )
    (return id)
  )
  (fn-do + intern-closure TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param enclosing U32)
    (param enclosing-key StableKey)
    ; `enclosing` is the instance the closure is written in, and `enclosing-key` that instance's
    ; stable key.
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (call ensure-scratch 4)
    (= ([] key-scratch 0) (. TypeTag closure))
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (= ([] key-scratch 3) enclosing)
    (let id U32 (as (call (. keys store) (. key-scratch data) 4) U32))
    (if (. keys last-inserted)
      (call (. rows append) (call ClosureType module decl enclosing))
      (call add-completion enclosing-key)
      (= (. ([] completions id) intrinsic) .closure)
      (= (. ([] completions id) is-pointer) true)
      (= (. ([] completions id) has-closures) true)
    )
    (return id)
  )
  (fn-do + place-closure _
    (param closure TypeId)
    (param site SyntaxId)
    (param below Bool)
    ; Notes where the function a closure runs as a value of a function type is placed, for a closure
    ; given to the function that answers an assigning operator: at `site`, or on the line below it.
    (let bits U64 site)
    (if below
      (+= bits 4294967296)
    )
    (= ([] placed closure) bits)
  )
  (fn-expr + closure-place U64
    (param closure TypeId)
    ; The place noted for a closure, and above its 32 bits whether the line below is meant. Zero
    ; where none is noted.
    (?? ([] placed closure) 0)
  )
  (fn-do + intern-binding TypeId
    (param form BindingForm)
    (param scope ModuleId)
    (param module ModuleId)
    (param decl DeclId)
    (param object TypeId (= no-type))
    (param param-count U32 (= 0))
    (param mark (? ScratchMark) (= null))
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let start (?? mark (. scratch types length)))
    (let count (- (. scratch types length) start))
    (call ensure-scratch (+ 7 count))
    (= ([] key-scratch 0) (. TypeTag binding))
    (= ([] key-scratch 1) form)
    (= ([] key-scratch 2) module)
    (= ([] key-scratch 3) decl)
    (= ([] key-scratch 4) object)
    (= ([] key-scratch 5) param-count)
    (= ([] key-scratch 6) scope)
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 7 offset)) ([] (. scratch types) (+ start offset)))
    )
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 7 count)) U32))
    (if (. keys last-inserted)
      (let held (call store-items start))
      (call (. rows append) (call BindingType module decl form scope object param-count held))
      (call add-completion)
      (= (. ([] completions id) intrinsic) .binding)
      (= (. ([] completions id) is-pointer) true)
      (for (in offset (..< 0 (. held count)))
        (if (. ([] completions (call child-type held offset)) has-closures)
          (= (. ([] completions id) has-closures) true)
        )
      )
      (if (and (!= object no-type) (. ([] completions object) has-closures))
        (= (. ([] completions id) has-closures) true)
      )
    )
    (call (. scratch types rewind) start)
    (return id)
  )
  (fn-do + intern-inference TypeId
    (param scope U32)
    (param ordinal U32)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (call ensure-scratch 3)
    (= ([] key-scratch 0) (. TypeTag inference))
    (= ([] key-scratch 1) scope)
    (= ([] key-scratch 2) ordinal)
    (let id U32 (as (call (. keys store) (. key-scratch data) 3) U32))
    (if (. keys last-inserted)
      (call (. rows append) (call InferenceType 0 0 scope ordinal))
      (call add-completion)
      (call set-flag id .flag-variables)
    )
    (return id)
  )
  (fn-expr + intern-tuple TypeId
    (param mark ScratchMark)
    (param names-mark ScratchMark)
    (call intern-fields (. TypeTag tuple) mark names-mark)
  )
  (fn-expr + intern-struct TypeId
    (param mark ScratchMark)
    (param names-mark ScratchMark)
    (call intern-fields (. TypeTag struct) mark names-mark)
  )
  (fn-do + intern-union TypeId
    (param mark ScratchMark)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (call ensure-scratch (+ 1 count))
    (= ([] key-scratch 0) (. TypeTag union))
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 1 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 1 count)) U32))
    (if (. keys last-inserted)
      (let owner (call type-decl .union))
      (let cases (call store-items mark))
      (call (. rows append) (call UnionType (. owner module) (. owner decl) cases))
      (call add-completion)
      (call note-children id cases)
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + intern-named-union TypeId
    (param owner-name Atom)
    (param mark ScratchMark)
    (param names-mark ScratchMark)
    (param made-in U32 (= 0))
    (param made-at U32 (= 0))
    ; The union of the cases pushed since the marks, named for a declaration, and private to the
    ; module and the place in it that make it where they are given: another made elsewhere is another
    ; type.
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (throw (call Panic "Types union case names and types are misaligned") (if (!= (- (. scratch names length) names-mark) count)))
    (blank)
    (call ensure-scratch (+ 5 (* count 3)))
    (let owner-address (. owner-name address))
    (= ([] key-scratch 0) (. TypeTag named-union))
    (= ([] key-scratch 1) (as (/and/ owner-address (. U32 max)) U32))
    (= ([] key-scratch 2) (as (/rshift/ owner-address 32) U32))
    (= ([] key-scratch 3) made-in)
    (= ([] key-scratch 4) made-at)
    (for (in offset (..< 0 count))
      (let address (. ([] (. scratch names) (+ names-mark offset)) address))
      (= ([] key-scratch (+ 5 (* offset 3))) (as (/and/ address (. U32 max)) U32))
      (= ([] key-scratch (+ 6 (* offset 3))) (as (/rshift/ address 32) U32))
      (= ([] key-scratch (+ 7 (* offset 3))) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 5 (* count 3))) U32))
    (if (. keys last-inserted)
      (let owner (call type-decl .union))
      (let cases (call store-items mark))
      (let names (call store-names names-mark))
      (call (. rows append)
        (block
          (arg (call NamedUnionType (. owner module) (. owner decl) owner-name cases names made-in made-at))
        )
      )
      (call add-completion)
      (call note-children id cases)
    )
    (call (. scratch types rewind) mark)
    (call (. scratch names rewind) names-mark)
    (return id)
  )
  (fn-do + intern-function TypeId
    (param return-type TypeId)
    (param is-c Bool)
    (param mark ScratchMark)
    (param errors-mark ScratchMark)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (let arg-count (- errors-mark mark))
    (call ensure-scratch (+ 4 count))
    (= ([] key-scratch 0) (. TypeTag function))
    (= ([] key-scratch 1) return-type)
    (= ([] key-scratch 2) (if-expr is-c 1u32 0u32))
    (= ([] key-scratch 3) (as arg-count U32))
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 4 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 4 count)) U32))
    (if (. keys last-inserted)
      (let owner (call type-decl (if-expr is-c (. IntrinsicKind cfunction) (. IntrinsicKind function))))
      (let errors (call store-items errors-mark))
      (call (. scratch types rewind) errors-mark)
      (let args (call store-items mark))
      (call (. rows append) (call FunctionType (. owner module) (. owner decl) return-type args errors is-c))
      (call add-completion)
      (call note-children id args)
      (call note-children id errors)
      (call note-child id return-type)
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + intern-ordered-result TypeId
    (param value TypeId)
    (param mark ScratchMark)
    ; The errors above the mark are already in the order `order-errors` gives them.
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (if (== count 0)
      (return value)
    )
    (blank)
    (call ensure-scratch (+ 2 count))
    (= ([] key-scratch 0) (. TypeTag result))
    (= ([] key-scratch 1) value)
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 2 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 2 count)) U32))
    (if (. keys last-inserted)
      (let owner (call type-decl .union))
      (let errors (call store-items mark))
      (call (. rows append) (call ResultType (. owner module) (. owner decl) value errors))
      (call add-completion)
      (call note-children id errors)
      (call note-child id value)
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + intern-associated TypeId
    (param owner TypeId)
    (param declaring DeclRef)
    (param name Atom)
    (param mark ScratchMark)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (call ensure-scratch (+ 6 count))
    (let address (. name address))
    (= ([] key-scratch 0) (. TypeTag associated))
    (= ([] key-scratch 1) owner)
    (= ([] key-scratch 2) (. declaring module))
    (= ([] key-scratch 3) (. declaring decl))
    (= ([] key-scratch 4) (as (/and/ address (. U32 max)) U32))
    (= ([] key-scratch 5) (as (/rshift/ address 32) U32))
    (for (in offset (..< 0 count))
      (= ([] key-scratch (+ 6 offset)) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 6 count)) U32))
    (if (. keys last-inserted)
      (let args (call store-items mark))
      (call (. rows append) (call AssociatedType (. declaring module) (. declaring decl) owner name args))
      (call add-completion)
      (call note-children id args)
      (call set-flag id .flag-variables)
    )
    (call (. scratch types rewind) mark)
    (return id)
  )
  (fn-do + evaluate-type TypeId
    (param caller ModuleId)
    (param ast AST)
    (param id SyntaxId)
    (param env TypeEnv)
    (if (== id 0)
      (return void-type)
    )
    (blank)
    (match ([] (. ast nodes) id)
      (case (call .node-type-identifier row)
        (return (call type-named caller (. row name) env))
      )
      (case (call .node-core-type-identifier row)
        (return (call well-known-type (. row module-name text) (. row name text)))
      )
      (case (call .node-type-arguments row)
        (return (call evaluate-type-args caller ast (. row base) (. row args) env))
      )
      (case (call .node-type-associated row)
        (let named (call evaluate-type-associated caller ast (. row owner) (. row name) (. row args) env))
        (if (and (== named invalid-type) fault (== fault-site 0))
          (= fault-module caller)
          (= fault-site id)
        )
        (return named)
      )
      (case (call .node-type-optional row)
        (return (call evaluate-type-optional caller ast (. row field-types) env))
      )
      (case (call .node-type-tuple row)
        (return (call evaluate-type-tuple caller ast (. row field-types) (. row is-struct) env))
      )
      (case (call .node-type-function row)
        (let ret (. row return-type))
        (let errs (. row errors))
        (return (call evaluate-type-function caller ast ret (. row args) errs (. row is-c) env))
      )
      (case (call .node-type-capture row)
        (return (if-expr (== (. row type) 0) invalid-type (call evaluate-type caller ast (. row type) env)))
      )
      (case (call .node-type-list row)
        (return (call evaluate-sugar caller ast (!! list-atom) (. row patterns) env))
      )
      (case (call .node-type-map row)
        (return (call evaluate-type-map caller ast (. row patterns) env))
      )
      (case (call .node-type-iterable row)
        (let item (call evaluate-type caller ast (. row pattern) env))
        (return-if invalid-type (if (== item invalid-type)))
        (blank)
        (let mark (. scratch types mark))
        (call (. scratch types push) item)
        (return (call class-named-with-args caller (!! stream-atom) mark))
      )
      (case (call .node-type-match row)
        (return (call evaluate-type caller ast (. row type) env))
      )
      (case (call .node-type-and row)
        (return (call evaluate-type caller ast (. row left) env))
      )
      (case (call .node-type-or row)
        (return (call evaluate-type caller ast (. row left) env))
      )
      (case (call .node-type-numeric row)
        (return (call evaluate-type-numeric caller ast (. row value) env))
      )
      (case (call .node-identifier row)
        (return (call type-named caller (. row name) env))
      )
      (case (call .node-argument-decl row)
        (return (call evaluate-type caller ast (. row pattern) env))
      )
      (default
        (return invalid-type)
      )
    )
  )
  (fn-do + missing-type SyntaxId
    (param caller ModuleId)
    (param ast AST)
    (param id SyntaxId)
    (param env TypeEnv)
    ; The innermost type written by name, with its arguments, that names nothing, within a type
    ; written; 0 where every name names a type.
    (match? ([] (. ast nodes) id)
      (case .node-type-identifier
        (return (if-expr (== (call evaluate-type caller ast id env) invalid-type) id 0))
      )
      (case (call .node-type-arguments row)
        (for (in argument ([] (. ast children) (. row args)))
          (let inner (call missing-type caller ast argument env))
          (if (!= inner 0)
            (return inner)
          )
        )
        (return (if-expr (== (call evaluate-type caller ast id env) invalid-type) id 0))
      )
    )
    (for (in child (call (. ast children-of) id))
      (let inner (call missing-type caller ast child env))
      (if (!= inner 0)
        (return inner)
      )
    )
    (return 0)
  )
  (fn-do + type-named TypeId
    (param caller ModuleId)
    (param name Atom)
    (param env TypeEnv)
    ; The type a name gives where a module writes it. `(char)`, the unit the parser gives a character
    ; literal, which no source can write, is `Char` itself, whatever names a module declares.
    (return-if (call type-row .char) (if (and char-literal-atom (== name char-literal-atom))))
    (blank)
    (let bound (call env-lookup env name))
    (if bound
      (return bound)
    )
    (if (and this-atom (== name this-atom) (!= (. env this-type) no-type))
      (return (. env this-type))
    )
    (blank)
    (let mark (. scratch types mark))
    (return (call class-named-with-args caller name mark))
  )
  (fn-do + class-pattern-with-args TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param mark ScratchMark)
    (if (not (call items-valid mark))
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (let type-args (call class-type-args module decl))
    (let count Size (. type-args count))
    (let given (- (. scratch types length) mark))
    (if (> given count)
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (let tree (. ([] (. program modules) module) tree))
    (for (in position (..< given count))
      (let name (call class-param-name tree type-args position))
      (if (not name)
        (call (. scratch types rewind) mark)
        (return invalid-type)
      )
      (call (. scratch types push) (call intern-variable module decl (as position U32) name))
    )
    (return (call class-with-args module decl mark))
  )
  (fn-do + class-param-default (? TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (param env TypeEnv)
    (let tree (. ([] (. program modules) module) tree))
    (let assignments (call class-param-assignments module decl))
    (let assigned (call param-assignment-type module tree assignments name env))
    (if (or (not assigned) (== assigned invalid-type))
      (return null)
    )
    (return assigned)
  )
  (fn-do + class-named-with-args TypeId
    (param caller ModuleId)
    (param name Atom)
    (param mark ScratchMark)
    ; The class of a name the caller sees given the type arguments from `mark`: the nearest that
    ; takes as many or more, passing over one that takes fewer, and one known by the name only as
    ; another name for it where no class is declared by the name.
    (let given (- (. scratch types length) mark))
    (let found (?? (call nearest-class caller name given false) (call nearest-class caller name given true)))
    (if found
      (return (call class-with-args (. found module) (. found decl) mark))
    )
    (blank)
    (call (. scratch types rewind) mark)
    (return invalid-type)
  )
  (fn-do + nearest-class (? DeclRef)
    (param caller ModuleId)
    (param name Atom)
    (param given Size)
    (param aliased Bool)
    ; The class reached first looking for a type written by name that takes `given` type arguments
    ; or more: modules by where they last come among those the caller lists, from the last to the
    ; first, so its own module first, and of a module's classes the last declared first. Another
    ; module's private classes are not seen, but by a module that declares a facet of one of its
    ; classes, and with `aliased` only other names are. A facet is the class of its name where the
    ; caller sees it (`sees-facet`) and reaches its access, and takes no type arguments.
    (let best (? DeclRef) null)
    (let best-place 0u32)
    (let best-exact false)
    (for (in candidate (call (. program lookup) caller name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case (call .decl-extension row)
          (if (or aliased (!= given 0) (not (call named-facet caller (call DeclRef (. candidate module) (. candidate decl)) (== (. row facet) name))))
            (continue)
          )
          (if (not (call (. program reaches-access) caller (. candidate module) (. row access)))
            (continue)
          )
          (let place (call (. program facet-listed-last) caller (. candidate module)))
          (if (or (== place (. U32 max)) (and best (< place best-place)))
            (continue)
          )
          (= best (call DeclRef (. candidate module) (. candidate decl)))
          (= best-place place)
          (= best-exact true)
        )
        (case (call .decl-class row)
          (if (!= (!= (. row name) name) aliased)
            (continue)
          )
          (if (and (!= (. row access) .public-access) (not (call (. program reaches-private) caller (. candidate module))))
            (continue)
          )
          (let place (call (. program listed-last) caller (. candidate module)))
          (if (or (== place (. U32 max)) (and best (< place best-place)))
            (continue)
          )
          (let taken Size (. (call class-type-args (. candidate module) (. candidate decl)) count))
          (if (and (>= taken given) (not (and best (== place best-place) best-exact (!= taken given))))
            (= best (call DeclRef (. candidate module) (. candidate decl)))
            (= best-place place)
            (= best-exact (== taken given))
          )
        )
      )
    )
    (return best)
  )
  (fn-do _ named-facet Bool
    (param caller ModuleId)
    (param candidate DeclRef)
    (param named Bool)
    ; Whether a declaration a name finds is a facet bound to a class that the caller sees.
    (return-if false (if (or (not named) (== (. program facets count) 0))))
    (blank)
    (let facet (call (. program facets index-of) (. candidate module) (. candidate decl)))
    (return-if false (if (not facet)))
    (return (and (== ([] (. program facets states) facet) .facet-bound) (call (. program sees-facet) caller facet)))
  )
  (fn-do + facet-of-type (? U32)
    (param id TypeId)
    ; The facet a type is, where it is the type of a facet's name.
    (return-if null (if (== (. program facets count) 0)))
    (blank)
    (match? ([] rows id)
      (case (call .type-class row)
        (return (call (. program facets index-of) (. row module) (. row decl)))
      )
    )
    (return null)
  )
  (fn-do + plain-class TypeId
    (param module ModuleId)
    (param decl DeclId)
    ; The type of a class that takes no type arguments.
    (return (call class-with-args module decl (. scratch types mark)))
  )
  (fn-do + facet-owner TypeId
    (param facet U32)
    ; The type of a facet's owner. Once the store is sealed, it is the one made before, or none.
    (let module ([] (. program facets owner-modules) facet))
    (let decl ([] (. program facets owner-decls) facet))
    (return-if (call plain-class module decl) (if (not sealed)))
    (blank)
    (call ensure-scratch 3)
    (= ([] key-scratch 0) (. TypeTag class))
    (= ([] key-scratch 1) module)
    (= ([] key-scratch 2) decl)
    (let found (call (. keys find) (. key-scratch data) 3))
    (return (if-expr found (as found TypeId) no-type))
  )
  (fn-do + class-with-args TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param mark ScratchMark)
    (let type-args (call class-type-args module decl))
    (let count Size (. type-args count))
    (let given (- (. scratch types length) mark))
    (if (== given count)
      (return (call through-alias module decl (call intern-class module decl mark)))
    )
    (if (> given count)
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (blank)
    (let tree (. ([] (. program modules) module) tree))
    (let local (call env-frame))
    (for (in position (..< 0 count))
      (let bound TypeId invalid-type)
      (if (< position given)
        (= bound ([] (. scratch types) (+ mark position)))
        (else
          (= bound (call intern-inference 0 (as (- position given) U32)))
        )
      )
      (let name (call class-param-name tree type-args position))
      (if name
        (= local (call env-bind local name bound))
      )
    )
    (blank)
    (let constraints (call class-param-constraints module decl))
    (= local (call apply-constraints module tree constraints local))
    (let assignments (call class-param-assignments module decl))
    (for (in position (..< given count))
      (let name (call class-param-name tree type-args position))
      (if name
        (let assigned (call param-assignment-type module tree assignments name local))
        (if assigned
          (= local (call env-bind local name assigned))
        )
      )
    )
    (blank)
    (call (. scratch types rewind) mark)
    (for (in position (..< 0 count))
      (let name (call class-param-name tree type-args position))
      (let bound (only-if (call env-lookup local name) (if name)))
      (call (. scratch types push) (?? bound invalid-type))
    )
    (call env-release local)
    (return (call through-alias module decl (call intern-class module decl mark)))
  )
  (fn-do + note-c-function-decl _
    (param type TypeId)
    (param declared U64)
    ; Notes a class declared as the C function type `type`, its module above its declaration in
    ; `declared`. The first by module and then by declaration is kept, whichever is found first.
    (let known ([] c-function-decls type))
    (if (or (not known) (> known declared))
      (= ([] c-function-decls type) declared)
    )
  )
  (fn-expr + c-function-decl (? DeclRef)
    (param type TypeId)
    ; The class first declared as a C function type, which the type is, by module and then by
    ; declaration: where code made for it is placed. None for one written where it is used.
    (case? ([] c-function-decls type)
      (call DeclRef (as (/rshift/ (!! bits) 32) ModuleId) (as (/and/ (!! bits) 4294967295) DeclId))
    )
    (where
      (lazy bits ([] c-function-decls type))
    )
  )
  (fn-do + class-env TypeEnv
    (param module ModuleId)
    (param decl DeclId)
    (let env (call env-frame))
    (let tree (. ([] (. program modules) module) tree))
    (let type-args (call class-type-args module decl))
    (let mark (. scratch types mark))
    (for (in position (..< 0 (. type-args count)))
      (let name (call class-param-name tree type-args position))
      (if name
        (let variable (call intern-variable module decl position name))
        (= env (call env-bind env name variable))
        (call (. scratch types push) variable)
        (else
          (call (. scratch types push) invalid-type)
        )
      )
    )
    (= env (call env-with-this env (call intern-class module decl mark)))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (= env (call declare-into env tree (. row base) module decl (. env start)))
        (= env (call apply-constraints module tree (. row param-constraints) env))
      )
    )
    (return env)
  )
  (fn-do + class-env-for TypeEnv
    (param module ModuleId)
    (param decl DeclId)
    (param args (of RowRange TypeId))
    (param self TypeId)
    (let env (call env-frame))
    (let tree (. ([] (. program modules) module) tree))
    (let type-args (call class-type-args module decl))
    (for (in position (..< 0 (. type-args count)))
      (let name (call class-param-name tree type-args position))
      (if (and name (< position (. args count)))
        (= env (call env-bind env name (call child-type args position)))
      )
    )
    (= env (call env-with-this env self))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (= env (call declare-into env tree (. row base) module decl (. env start)))
        (= env (call apply-constraints module tree (. row param-constraints) env))
      )
    )
    (return env)
  )
  (fn-do + apply-constraints TypeEnv
    (param module ModuleId)
    (param tree AST)
    (param constraints (of RowRange SyntaxId))
    (param env TypeEnv)
    (let current env)
    (for (in constraint ([] (. tree nodes) ([] (. tree children) constraints)))
      (match? constraint
        (case (call .node-param-constraint row)
          (let name (call type-syntax-name tree (. row left)))
          (let bound (only-if (call env-lookup current name) (if name)))
          (if bound
            (let right (call evaluate-type module tree (. row right) current))
            (= current (call env-constrain current bound right))
          )
        )
      )
    )
    (return current)
  )
  (fn-expr + type-syntax-name (? Atom)
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (. row name)
      )
      (case (call .node-identifier row)
        (. row name)
      )
      (case (call .node-type-arguments row)
        (call type-syntax-name tree (. row base))
      )
    )
  )
  (fn-expr + class-type-args (of RowRange SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (. row type-args)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-expr + class-param-name (? Atom)
    (param tree AST)
    (param type-args (of RowRange SyntaxId))
    (param position Size)
    (call type-syntax-name tree ([] (. tree children) slot))
    (where
      (lazy slot (+ (. type-args start) position))
    )
  )
  (fn-do + clear-fault _
    (= fault null)
    (= fault-site 0)
  )
  (fn-do + resolve-associated TypeId
    (param owner TypeId)
    (param name Atom)
    (param mark ScratchMark)
    (param env TypeEnv)
    (param caller (? ModuleId) (= null))
    (let count U32 (as (- (. scratch types length) mark) U32))
    (match ([] rows owner)
      (case .type-variable
        (return (call associated-by-constraints owner name mark count env))
      )
      (case .type-inference
        (return (call associated-by-constraints owner name mark count env))
      )
      (case .type-class
        (call ensure-representation owner)
        (if (== (. ([] completions owner) intrinsic) .interface)
          (let declaring (call find-requirement owner name count))
          (if declaring
            (return (call intern-associated owner declaring name mark))
          )
          (call (. scratch types rewind) mark)
          (return invalid-type)
        )
        (return (call resolve-binding owner name mark count caller))
      )
      (default
        (call (. scratch types rewind) mark)
        (return invalid-type)
      )
    )
  )
  (fn-do + declare-into TypeEnv
    (param env TypeEnv)
    (param tree AST)
    (param id SyntaxId)
    (param module ModuleId)
    (param owner DeclId)
    (param first Size)
    (if (== id 0)
      (return env)
    )
    (blank)
    (let current env)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (if (and (. row is-declare) (not (call env-lookup-from current (. row name) first)))
          (let variable (call intern-variable module owner (as (- (. current end) first) U32) (. row name)))
          (= current (call env-bind current (. row name) variable))
        )
      )
      (case (call .node-type-arguments row)
        (= current (call declare-into current tree (. row base) module owner first))
        (= current (call declare-children current tree (. row args) module owner first))
      )
      (case (call .node-type-associated row)
        (= current (call declare-into current tree (. row owner) module owner first))
        (= current (call declare-children current tree (. row args) module owner first))
      )
      (case (call .node-type-optional row)
        (= current (call declare-children current tree (. row field-types) module owner first))
      )
      (case (call .node-type-tuple row)
        (= current (call declare-children current tree (. row field-types) module owner first))
      )
      (case (call .node-type-capture row)
        (= current (call declare-into current tree (. row type) module owner first))
      )
      (case (call .node-type-match row)
        (= current (call declare-into current tree (. row type) module owner first))
      )
      (case (call .node-type-and row)
        (= current (call declare-into current tree (. row left) module owner first))
        (= current (call declare-into current tree (. row right) module owner first))
      )
      (case (call .node-type-or row)
        (= current (call declare-into current tree (. row left) module owner first))
        (= current (call declare-into current tree (. row right) module owner first))
      )
      (case (call .node-type-list row)
        (= current (call declare-children current tree (. row patterns) module owner first))
      )
      (case (call .node-type-map row)
        (= current (call declare-children current tree (. row patterns) module owner first))
      )
      (case (call .node-type-map-item row)
        (= current (call declare-into current tree (. row key) module owner first))
        (= current (call declare-into current tree (. row value) module owner first))
      )
      (case (call .node-type-iterable row)
        (= current (call declare-into current tree (. row pattern) module owner first))
      )
      (case (call .node-type-function row)
        (= current (call declare-into current tree (. row return-type) module owner first))
        (= current (call declare-children current tree (. row args) module owner first))
        (= current (call declare-children current tree (. row errors) module owner first))
      )
      (case (call .node-argument-decl row)
        (= current (call declare-into current tree (. row pattern) module owner first))
      )
    )
    (return current)
  )
  (fn-expr + base-of (? TypeId)
    (param id TypeId)
    (case? (== base no-type)
      null
    )
    (default
      base
    )
    (where
      (lazy base (. ([] completions id) base))
    )
  )
  (fn-do + ensure-representation _
    (param id TypeId)
    (if (== (. ([] completions id) completion) .completion-unstarted)
      (call complete-slow id)
    )
  )
  (fn-do + complete _ @inline
    (param id TypeId)
    (let state (. ([] completions id) completion))
    (if (and (!= state .completion-done) (!= state .completion-failed))
      (call complete-slow id)
    )
  )
  (fn-do + completion-of (of TableRow TypeCompletion) @inline
    (param id TypeId)
    (call complete id)
    (return ([] completions id))
  )
  (fn-expr + is-literal-global Bool
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a global is core's `true`, `false` or `null`: every read of one is a literal, so it
    ; is never stored and its value never runs.
    (match ([] (. owner decls) decl)
      (case (call .decl-property row)
        (case? (or (!= (. owner name) "core") (not (. row name)))
          false
        )
        (default
          (or (== (. row name) true-atom) (== (. row name) false-atom) (== (. row name) null-atom))
        )
      )
      (default
        false
      )
    )
    (where
      (lazy owner ([] (. program modules) module))
    )
  )
  (fn-do + intrinsic-of IntrinsicKind @inline
    (param id TypeId)
    (call complete id)
    (return (. ([] completions id) intrinsic))
  )
  (fn-do + is-generic Bool @inline
    (param id TypeId)
    (call complete id)
    (return (. ([] completions id) has-variables))
  )
  (fn-do + properties-of (of TableSpan TypeProperty) @inline
    (param id TypeId)
    (call complete id)
    (return ([] properties (. ([] completions id) properties)))
  )
  (fn-do + delegates-of (of ImmutableArray TypeId ArenaBacking) @inline
    (param id TypeId)
    ; The interfaces a class answers through a property, as pairs: the interface, then the type of
    ; the property that implements it.
    (call complete id)
    (return ([] children (. ([] completions id) delegates)))
  )
  (fn-expr + delegate-name Atom
    (param id TypeId)
    (param offset Size)
    (call child-name (. ([] completions id) delegate-names) (as offset U32))
  )
  (fn-do + interfaces-of (of ImmutableArray TypeId ArenaBacking) @inline
    (param id TypeId)
    (call complete id)
    (return ([] children (. ([] completions id) interfaces)))
  )
  (fn-do + cases-of (of TableSpan TypeCase) @inline
    (param id TypeId)
    (call complete id)
    (return ([] cases (. ([] completions id) cases)))
  )
  (fn-do + null-case U32
    (param id TypeId)
    ; The case of a union that holds null and is not its default, or none.
    (if (!= (call intrinsic-of id) .union)
      (return (. U32 max))
    )
    (let held (call cases-of id))
    (for (in index (..< 0 (. held length)))
      (if (and (not (. ([] held index) is-default)) (== (. ([] held index) type) null-type))
        (return (as index U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do + tracked-root TypeId
    (param owner TypeId)
    (param name Atom)
    ; The class whose property of a name a tracked read of it is kept by: the topmost of the class
    ; that declares it and the classes above that declare it too, whose trackers an override in a
    ; class below shares.
    (let root owner)
    (while true
      (let base (. ([] completions root) base))
      (if (or (== base no-type) (== base invalid-type))
        (return root)
      )
      (let place (call property-named base name))
      (if (not place)
        (return root)
      )
      (= root (. ([] properties place) owner))
    )
  )
  (fn-do + property-named (? Index) @inline
    (param id TypeId)
    (param name Atom)
    ; The place of the property of a type by a name, its own or one it takes from a class above.
    (call complete id)
    (let range (. ([] completions id) properties))
    (if (> (. range count) property-scan-limit)
      (return (call placed-property id name))
    )
    (for (in offset (..< 0 (. range count)))
      (let position (as (+ (. range start) offset) Index))
      (if (== (. ([] properties position) name) name)
        (return position)
      )
    )
    (return null)
  )
  (fn-do + property-seen (? Index)
    (param id TypeId)
    (param name Atom)
    (param module ModuleId)
    ; The place of the property of a type by a name, as code in a module sees it. Facets of a class
    ; may each declare a private property of one name: of those, code sees its own module's, and
    ; otherwise one that no facet keeps to itself. A module that declares facets of the class sees
    ; no property of a facet it does not reach. A facet's value has its facet's properties and its
    ; ancestor facets', and no others.
    (let viewed (call facet-of-type id))
    (if viewed
      (let held (call property-of-facet id name viewed))
      (return-if null (if (and held (not (call (. program sees-facet) module (. ([] properties held) facet))))))
      (return held)
    )
    (let found (call property-named id name))
    (return-if found (if (or (not found) (== (. ([] properties found) facet) (. U32 max)))))
    (blank)
    (let facets (. program facets))
    (let range (. ([] completions id) properties))
    (let open (? Index) null)
    (let kept (? Index) null)
    (for (in offset (..< 0 (. range count)))
      (let position (as (+ (. range start) offset) Index))
      (let fact ([] properties position))
      (if (== (. fact name) name)
        (return-if position (if (or (== (. fact facet) (. U32 max)) (== ([] (. facets modules) (. fact facet)) module))))
        (blank)
        (if (call (. program sees-facet) module (. fact facet))
          (if (not (call is-facet-private (. fact facet) name))
            (= open (?? open position))
            (else-if (not kept)
              (= kept position)
            )
          )
        )
      )
    )
    (return (?? open kept))
  )
  (fn-do _ property-of-facet (? Index)
    (param id TypeId)
    (param name Atom)
    (param facet U32)
    ; The place of the property of a facet's type by a name that the facet or one of its ancestor
    ; facets declares, the nearest first.
    (call complete id)
    (let facets (. program facets))
    (let current facet)
    (let steps Size 0)
    (while (and (!= current (. U32 max)) (<= steps (. facets count)))
      (let found (call property-declared id name current))
      (return-if found (if found))
      (blank)
      (= current ([] (. facets parents) current))
      (+= steps 1)
    )
    (return null)
  )
  (fn-do + property-declared (? Index)
    (param id TypeId)
    (param name Atom)
    (param facet U32)
    ; The place of the property of a type by a name and the facet that declares it, or none.
    (return-if (call property-named id name) (if (== facet (. U32 max))))
    (blank)
    (let range (. ([] completions id) properties))
    (for (in offset (..< 0 (. range count)))
      (let position (as (+ (. range start) offset) Index))
      (if (and (== (. ([] properties position) name) name) (== (. ([] properties position) facet) facet))
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ is-facet-private Bool
    (param facet U32)
    (param name Atom)
    ; Whether a facet keeps a property of a name to its own module.
    (let target ([] (. program modules) ([] (. program facets modules) facet)))
    (match? ([] (. target decls) ([] (. program facets decls) facet))
      (case (call .decl-extension row)
        (for (in member (call (. target members-named) (. row members) name))
          (match? ([] (. target decls) member)
            (case (call .decl-property property)
              (if (and (. property name) (== (. property name) name))
                (return (== (. property access) .private-access))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + implements-type Bool
    (param id TypeId)
    (param interface TypeId)
    (let current id)
    (while (!= current no-type)
      (if (== current interface)
        (return true)
      )
      (for (in implemented (call interfaces-of current))
        (if (call implements-type implemented interface)
          (return true)
        )
      )
      (= current (?? (call base-of current) no-type))
    )
    (return false)
  )
  (fn-do + declare-unit-equalities _
    (let joined ([] Bool (. program modules length)))
    (for (in module (. program init-order))
      (= ([] joined module) true)
      (call declare-module-equalities module)
    )
    (for (in module (..< 0 (. program modules length)))
      (if (not ([] joined module))
        (call declare-module-equalities (as module ModuleId))
      )
    )
    (call (. unit-families join-alike))
    (for (in derived (. unit-families derived))
      (if (== (. derived problem) .none)
        (call set-flag (. derived type) .flag-equalities)
      )
    )
  )
  (fn-do _ declare-module-equalities _
    (param caller ModuleId)
    (let module ([] (. program modules) caller))
    (let tree (. module tree))
    (for (in decl (. module decls))
      (match? decl
        (case (call .decl-unit unit)
          (call declare-unit-equality caller tree unit)
        )
      )
    )
    (call (. unit-families resolve-derived))
  )
  (fn-expr _ is-single-unit Bool
    (param terms (list UnitTerm))
    (and (== (. terms length) 1) (== (. ([] terms 0) power) 1))
  )
  (fn-do _ declare-unit-equality _
    (param caller ModuleId)
    (param tree AST)
    (param unit UnitDecl)
    (let left (call unit-amount caller tree (. unit number)))
    (let right (call unit-amount caller tree (. unit value)))
    (if (or (!= (. left failed) 0) (!= (. right failed) 0) (== (. left amount) 0.0) (== (. right amount) 0.0))
      (return)
    )
    (for (in term (call added-terms (. left terms) (. right terms) 1))
      (if (. ([] completions (. term unit)) is-builtin)
        (return)
      )
    )
    (let left-single (call is-single-unit (. left terms)))
    (let right-single (call is-single-unit (. right terms)))
    (let exact (call ratio-over (call decimal-ratio (. right amount)) (call decimal-ratio (. left amount))))
    (if (and left-single right-single)
      (call relate-units (. ([] (. left terms) 0) unit) (. ([] (. right terms) 0) unit) exact caller (. unit syntax))
      (return)
    )
    (if (and left-single (== (. right terms length) 0))
      (let type (. ([] (. left terms) 0) unit))
      (call (. unit-families join) type number-member exact caller (. unit syntax))
      (call set-flag type .flag-equalities)
      (return)
    )
    (if (and right-single (== (. left terms length) 0))
      (let type (. ([] (. right terms) 0) unit))
      (call (. unit-families join) type number-member (call ratio-over (call decimal-ratio (. left amount)) (call decimal-ratio (. right amount))) caller (. unit syntax))
      (call set-flag type .flag-equalities)
      (return)
    )
    (if left-single
      (call (. unit-families declare-derived) (. ([] (. left terms) 0) unit) exact (. right terms) caller (. unit syntax))
      (else-if right-single
        (call (. unit-families declare-derived) (. ([] (. right terms) 0) unit) (call ratio-over (call decimal-ratio (. left amount)) (call decimal-ratio (. right amount))) (. left terms) caller (. unit syntax))
      )
    )
  )
  (fn-expr + key-of StableKey
    (param type TypeId)
    (case? (== type no-type)
      0
    )
    (default
      ([] stable-keys type)
    )
  )
  (fn-do + has-subclasses Bool
    (param id TypeId)
    (call scan-subclasses)
    (return (== ([] subclassed-decls (call class-decl-key id)) true))
  )
  (fn-do + declares-subclass-interface Bool
    (param id TypeId)
    (param interface TypeId)
    ; Whether a class declared below a class, at any depth, declares an interface, or one it may be
    ; derived from: a class cast to such an interface is tested for it as the program runs. An
    ; interface a class declares that names no type may be any.
    (call scan-subclasses)
    (let target (call class-decl-key interface))
    (let keys (list Size))
    (+= keys (call class-decl-key id))
    (let index 0)
    (while (< index (. keys length))
      (let link (?? ([] subclass-heads ([] keys index)) 0))
      (+= index 1)
      (while (!= link 0)
        (let packed ([] subclass-decls (- link 1)))
        (= link ([] subclass-links (- link 1)))
        (if (!= (call (. keys find) packed) null)
          (continue)
        )
        (+= keys packed)
        (let module (as (/rshift/ packed 32) ModuleId))
        (let decl (as (/and/ packed 0xffffffff) DeclId))
        (let written (call (of RowRange SyntaxId)))
        (match? ([] (. ([] (. program modules) module) decls) decl)
          (case (call .decl-class row)
            (= written (. row interfaces))
          )
        )
        (let env (call class-env module decl))
        (let tree (. ([] (. program modules) module) tree))
        (for (in syntax ([] (. ([] (. program modules) module) syntax-pool) written))
          (let named (call evaluate-type module tree syntax env))
          (if (or (== named invalid-type) (== (call class-decl-key named) target) reaches)
            (call env-release env)
            (return true)
          )
          (lazy reaches (call interface-reaches named target))
        )
        (call env-release env)
      )
    )
    (return false)
  )
  (fn-do _ rank _
    ; Lists the types the seal reached by stable key, an order that does not depend on the order
    ; typing interned them. The others are types typing made on the way and no instance names.
    (let count Size 0)
    (for (in id (..< 0 (. rows length)))
      (if (call is-reached (as id TypeId))
        (+= count 1)
      )
    )
    (= ranked (call (of Array TypeId) arena count))
    (let spare (call (of Array TypeId) arena count))
    (let filled Size 0)
    (for (in id (..< 0 (. rows length)))
      (if (call is-reached (as id TypeId))
        (= ([] ranked filled) (as id TypeId))
        (+= filled 1)
      )
    )
    (let width Size 1)
    (while (< width count)
      (let start Size 0)
      (while (< start count)
        (let middle (if-expr (< (+ start width) count) (+ start width) count))
        (let end (if-expr (< (+ middle width) count) (+ middle width) count))
        (call merge-ranked spare start middle end)
        (= start end)
      )
      (let merged ranked)
      (= ranked spare)
      (= spare merged)
      (*= width 2)
    )
  )
  (fn-do _ merge-ranked _
    (param into (of Array TypeId ArenaBacking))
    (param start Size)
    (param middle Size)
    (param end Size)
    (let left start)
    (let right middle)
    (for (in position (..< start end))
      (if (and (< left middle) (or (>= right end) (not (call ranks-before ([] ranked right) ([] ranked left)))))
        (= ([] into position) ([] ranked left))
        (+= left 1)
        (else
          (= ([] into position) ([] ranked right))
          (+= right 1)
        )
      )
    )
  )
  (fn-expr _ ranks-before Bool
    (param first TypeId)
    (param second TypeId)
    (< ([] stable-keys first) ([] stable-keys second))
  )
  (fn-expr _ is-reached Bool
    (param id TypeId)
    (and (< id (. reach-visited length)) ([] reach-visited id))
  )
  (fn-do _ reach-children _
    (param id TypeId)
    (let mark (. scratch types mark))
    (call push-parts id)
    (call push-members id)
    (for (in at (..< mark (. scratch types length)))
      (call reach ([] (. scratch types) at))
    )
    (call (. scratch types rewind) mark)
  )
  (fn-do _ push-parts _
    (param id TypeId)
    (match? ([] rows id)
      (case (call .type-class row)
        (call push-range (. row args))
        (call push-range (. row errors))
      )
      (case (call .type-tuple row)
        (call push-range (. row fields))
      )
      (case (call .type-struct row)
        (call push-range (. row fields))
      )
      (case (call .type-union row)
        (call push-range (. row cases))
      )
      (case (call .type-named-union row)
        (call push-range (. row cases))
      )
      (case (call .type-function row)
        (call (. scratch types push) (. row return-type))
        (call push-range (. row args))
        (call push-range (. row errors))
      )
      (case (call .type-result row)
        (call (. scratch types push) (. row value))
        (call push-range (. row errors))
      )
      (case (call .type-associated row)
        (call (. scratch types push) (. row owner))
        (call push-range (. row args))
      )
    )
  )
  (fn-do _ push-members _
    (param id TypeId)
    (let completion ([] completions id))
    (call (. scratch types push) (. completion base))
    (for (in interface ([] children (. completion interfaces)))
      (call (. scratch types push) interface)
    )
    (for (in property ([] properties (. completion properties)))
      (call (. scratch types push) (. property type))
    )
    (for (in case ([] cases (. completion cases)))
      (call (. scratch types push) (. case type))
    )
    (for (in associated ([] associated-types (. completion associated)))
      (call (. scratch types push) (. associated type))
    )
  )
  (fn-do _ push-range _
    (param range (of RowRange TypeId))
    (for (in offset (..< 0 (. range count)))
      (call (. scratch types push) (call child-type range offset))
    )
  )
  (fn-do + embeds Bool
    (param outer TypeId)
    (param inner TypeId)
    (if (== outer inner)
      (return true)
    )
    (if (or (== outer no-type) (== outer invalid-type) (== inner no-type) (== inner invalid-type))
      (return false)
    )
    (if (< (. ([] completions outer) depth) (. ([] completions inner) depth))
      (return false)
    )
    (let mark (. scratch types mark))
    (finally
      (call (. scratch types rewind) mark)
    )
    (call push-parts outer)
    (let middle (. scratch types length))
    (for (in at (..< mark middle))
      (if (call embeds ([] (. scratch types) at) inner)
        (return true)
      )
    )
    (if (not (call same-head outer inner))
      (return false)
    )
    (call push-parts inner)
    (if (!= (- (. scratch types length) middle) (- middle mark))
      (return false)
    )
    (for (in offset (..< 0 (- middle mark)))
      (if (not (call embeds ([] (. scratch types) (+ mark offset)) ([] (. scratch types) (+ middle offset))))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ same-head Bool
    (param outer TypeId)
    (param inner TypeId)
    (match? ([] rows outer)
      (case .type-class
        (return (call same-class this outer inner))
      )
      (case .type-tuple
        (return (is ([] rows inner) .type-tuple))
      )
      (case .type-struct
        (return (is ([] rows inner) .type-struct))
      )
      (case .type-union
        (return (is ([] rows inner) .type-union))
      )
      (case .type-named-union
        (return (is ([] rows inner) .type-named-union))
      )
      (case .type-function
        (return (is ([] rows inner) .type-function))
      )
      (case .type-result
        (return (is ([] rows inner) .type-result))
      )
    )
    (return false)
  )
  (fn-do + grows Bool
    (param module ModuleId)
    (param decl DeclId)
    (let key (call pack-decl module decl))
    (let known ([] growth key))
    (if known
      (return (== known 2))
    )
    (= ([] growth key) 1)
    (let found (call (. (call growth-graph module decl) cycles) (call DeclRef module decl)))
    (= ([] growth key) (if-expr found 2u8 1u8))
    (if (== completing 0)
      (call complete-made)
    )
    (return found)
  )
  (fn-do + grows-through Bool
    (param module ModuleId)
    (param decl DeclId)
    (param member TypeId)
    (let found (call (. (call growth-graph module decl) cycles) (call DeclRef module decl) member))
    (if (== completing 0)
      (call complete-made)
    )
    (return found)
  )
  (fn-do _ growth-graph GrowthGraph
    (param module ModuleId)
    (param decl DeclId)
    (let graph (call GrowthGraph))
    (let waiting (list DeclRef))
    (let expanded (list DeclRef))
    (+= waiting (call DeclRef module decl))
    (+= completing 1)
    (finally (-= completing 1))
    (while (!= (. waiting length) 0)
      (let owner ([] waiting (- (. waiting length) 1)))
      (call (. waiting pop))
      (if (!= (call (. expanded find) owner) null)
        (continue)
      )
      (+= expanded owner)
      (let pattern (call growth-pattern owner))
      (if (== pattern no-type)
        (continue)
      )
      (let mark (. scratch types mark))
      (call push-members pattern)
      (for (in at (..< mark (. scratch types length)))
        (let member ([] (. scratch types) at))
        (call scan-growth graph waiting owner member member)
      )
      (call (. scratch types rewind) mark)
    )
    (return graph)
  )
  (fn-do _ growth-pattern TypeId
    (param ref DeclRef)
    (let mark (. scratch types mark))
    (let pattern (call class-pattern-with-args (. ref module) (. ref decl) mark))
    (call (. scratch types rewind) mark)
    (if (or (== pattern invalid-type) (== pattern no-type) (== (. ([] completions pattern) completion) .completion-in-progress))
      (return no-type)
    )
    (call complete pattern)
    (return (if-expr (== (. ([] completions pattern) completion) .completion-done) pattern no-type))
  )
  (fn-do _ scan-growth _
    (param graph GrowthGraph)
    (param waiting (list DeclRef))
    (param owner DeclRef)
    (param member TypeId)
    (param type TypeId)
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (match? ([] rows type)
      (case (call .type-class row)
        (let target (call DeclRef (. row module) (. row decl)))
        (for (in position (..< 0 (. row args count)))
          (let held (call child-type (. row args) position))
          (let found (list TypeId))
          (call gather-variables held owner found)
          (for (in variable found)
            (match? ([] rows variable)
              (case (call .type-variable named)
                (let from (call (. graph node) owner (. named index)))
                (let to (call (. graph node) target (as position U32)))
                (call (. graph link) from to (!= held variable) member)
                (+= waiting target)
              )
            )
          )
        )
      )
    )
    (let mark (. scratch types mark))
    (call push-parts type)
    (for (in at (..< mark (. scratch types length)))
      (call scan-growth graph waiting owner member ([] (. scratch types) at))
    )
    (call (. scratch types rewind) mark)
  )
  (fn-do _ gather-variables _
    (param type TypeId)
    (param owner DeclRef)
    (param found (list TypeId))
    (if (or (== type no-type) (== type invalid-type) (not (. ([] completions type) has-variables)))
      (return)
    )
    (match? ([] rows type)
      (case (call .type-variable row)
        (if (and (== (. row module) (. owner module)) (== (. row decl) (. owner decl)) (== (call (. found find) type) null))
          (+= found type)
        )
        (return)
      )
    )
    (let mark (. scratch types mark))
    (call push-parts type)
    (for (in at (..< mark (. scratch types length)))
      (call gather-variables ([] (. scratch types) at) owner found)
    )
    (call (. scratch types rewind) mark)
  )
  (fn-expr _ well-known-decl DeclRef
    (param module-name String)
    (param class-name String)
    (case? (and module decl)
      (call DeclRef (as module ModuleId) decl)
    )
    (default
      (call DeclRef 0 0)
    )
    (where
      (lazy module (call (. program module-by-name) module-name))
      (lazy decl (call class-decl-named (as module ModuleId) class-name))
    )
  )
  (fn-do _ query-held TypeId
    (param type TypeId)
    ; The type a property holds that is written with a type that queries the markup its object is
    ; in: `Ancestor'T` holds a `T?`, and `Descendants'T` holds a `[T]`. Any other type is held as it
    ; is written.
    (match? ([] rows type)
      (case (call .type-class row)
        (if (and (== (. row args count) 1) (call (. ancestor-decl refers-to) (. row module) (. row decl)))
          (return (call optional-of (call child-type (. row args) 0)))
        )
        (if (and (== (. row args count) 1) (call (. descendants-decl refers-to) (. row module) (. row decl)))
          (let item (call child-type (. row args) 0))
          (let mark (. scratch types mark))
          (call (. scratch types push) item)
          (return (call class-with-args (. list-decl module) (. list-decl decl) mark))
        )
      )
    )
    (return type)
  )
  (fn-do _ class-decl-named (? U32)
    (param module ModuleId)
    (param name String)
    (let atom (call (. program store-atom) name))
    (let decls (. ([] (. program modules) module) decls))
    (let index 0u32)
    (for (in decl decls)
      (match? decl
        (case (call .decl-class row)
          (if (== (. row name) atom)
            (return index)
          )
        )
      )
      (+= index 1)
    )
    (return null)
  )
  (fn-do _ intern-fields TypeId
    (param tag U32)
    (param mark ScratchMark)
    (param names-mark ScratchMark)
    (throw (call Panic "Types are sealed and cannot intern a type") (if sealed))
    (blank)
    (let count (- (. scratch types length) mark))
    (throw (call Panic "Types tuple field names and types are misaligned") (if (!= (- (. scratch names length) names-mark) count)))
    (blank)
    (call ensure-scratch (+ 1 (* count 3)))
    (= ([] key-scratch 0) tag)
    (for (in offset (..< 0 count))
      (let address (. ([] (. scratch names) (+ names-mark offset)) address))
      (= ([] key-scratch (+ 1 (* offset 3))) (as (/and/ address (. U32 max)) U32))
      (= ([] key-scratch (+ 2 (* offset 3))) (as (/rshift/ address 32) U32))
      (= ([] key-scratch (+ 3 (* offset 3))) ([] (. scratch types) (+ mark offset)))
    )
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) (+ 1 (* count 3))) U32))
    (if (. keys last-inserted)
      (let owner (call type-decl (if-expr (== tag (. TypeTag tuple)) (. IntrinsicKind tuple) (. IntrinsicKind struct))))
      (let fields (call store-items mark))
      (let names (call store-names names-mark))
      (if (== tag (. TypeTag tuple))
        (call (. rows append) (call TupleType (. owner module) (. owner decl) fields names))
        (else
          (call (. rows append) (call StructType (. owner module) (. owner decl) fields names))
        )
      )
      (call add-completion)
      (call note-children id fields)
    )
    (call (. scratch types rewind) mark)
    (call (. scratch names rewind) names-mark)
    (return id)
  )
  (fn-do _ intern-invalid TypeId
    (call ensure-scratch 1)
    (= ([] key-scratch 0) (. TypeTag invalid))
    (blank)
    (let id U32 (as (call (. keys store) (. key-scratch data) 1) U32))
    (if (. keys last-inserted)
      (call (. rows append) (call InvalidType 0 0 null))
      (call add-completion)
    )
    (return id)
  )
  (fn-do _ through-alias TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param id TypeId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (if (and (!= (. row base) 0) (not (call has-explicit-members module (. row members))))
          (let tree (. ([] (. program modules) module) tree))
          (match? ([] (. tree nodes) (. row base))
            (case .node-type-function
              (let env (call env-frame))
              (let base (call evaluate-type module tree (. row base) env))
              (call env-release env)
              (match? ([] rows base)
                (case (call .type-function fn)
                  (if (. fn is-c)
                    (call note-c-function-decl
                      (block
                        (arg base)
                        (arg (/or/ (/lshift/ (as module U64) 32) (as decl U64)))
                      )
                    )
                    (return base)
                  )
                )
              )
            )
          )
        )
      )
    )
    (return id)
  )
  (fn-do _ has-explicit-members Bool
    (param module ModuleId)
    (param members (of RowRange DeclId))
    (let owner-module ([] (. program modules) module))
    (for (in member ([] (. owner-module member-pool) members))
      (let explicit
        (match ([] (. owner-module decls) member)
          (case (call .decl-function fn)
            (let implicit (or (== (. fn kind) .default-constructor-decl) (== (. fn kind) .cast-constructor-decl)))
            (and (not implicit) (!= (. fn kind) .tuple-constructor-decl))
          )
          (default
            true
          )
        )
      )
      (if explicit
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ param-assignment-type (? TypeId)
    (param module ModuleId)
    (param tree AST)
    (param assignments (of RowRange SyntaxId))
    (param name Atom)
    (param env TypeEnv)
    (for (in assignment ([] (. tree nodes) ([] (. tree children) assignments)))
      (match? assignment
        (case (call .node-param-assignment row)
          (let left (call type-syntax-name tree (. row left)))
          (if (and left (== left name))
            (return (call evaluate-type module tree (. row right) env))
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ class-param-constraints (of RowRange SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (. row param-constraints)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-expr _ class-param-assignments (of RowRange SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (. row param-assignments)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-expr _ items-valid Bool
    (param mark ScratchMark)
    (call all (..< mark (. scratch types length)) (:where (!= ([] (. scratch types) each) invalid-type)))
  )
  (fn-do _ evaluate-type-args TypeId
    (param caller ModuleId)
    (param ast AST)
    (param base SyntaxId)
    (param args (of RowRange SyntaxId))
    (param env TypeEnv)
    (let name (call type-syntax-name ast base))
    (return-if invalid-type (if (not name)))
    (return-if invalid-type (if (call env-lookup env name)))
    (blank)
    (let mark (. scratch types mark))
    (for (in child ([] (. ast children) args))
      (call (. scratch types push) (call evaluate-type caller ast child env))
    )
    (if (not (call items-valid mark))
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (if (and this-atom (== name this-atom) (!= (. env this-type) no-type))
      (match? ([] rows (. env this-type))
        (case (call .type-class row)
          (return (call class-with-args (. row module) (. row decl) mark))
        )
      )
    )
    (return (call class-named-with-args caller name mark))
  )
  (fn-do _ evaluate-sugar TypeId
    (param caller ModuleId)
    (param ast AST)
    (param name Atom)
    (param patterns (of RowRange SyntaxId))
    (param env TypeEnv)
    (let mark (. scratch types mark))
    (for (in child ([] (. ast children) patterns))
      (call (. scratch types push) (call evaluate-type caller ast child env))
    )
    (if (not (call items-valid mark))
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (return (call class-named-with-args caller name mark))
  )
  (fn-do _ evaluate-type-map TypeId
    (param caller ModuleId)
    (param ast AST)
    (param patterns (of RowRange SyntaxId))
    (param env TypeEnv)
    (for (in child ([] (. ast nodes) ([] (. ast children) patterns)))
      (match? child
        (case (call .node-type-map-item row)
          (let mark (. scratch types mark))
          (call (. scratch types push) (call evaluate-type caller ast (. row key) env))
          (call (. scratch types push) (call evaluate-type caller ast (. row value) env))
          (if (not (call items-valid mark))
            (call (. scratch types rewind) mark)
            (return invalid-type)
          )
          (return (call class-named-with-args caller (!! map-atom) mark))
        )
      )
    )
    (return invalid-type)
  )
  (fn-do _ evaluate-type-optional TypeId
    (param caller ModuleId)
    (param ast AST)
    (param field-types (of RowRange SyntaxId))
    (param env TypeEnv)
    (if (== (. field-types count) 0)
      (return invalid-type)
    )
    (blank)
    (let owner (call type-decl .optional))
    (if (and (== (. owner module) 0) (== (. owner decl) 0))
      (return invalid-type)
    )
    (blank)
    (let inner (call evaluate-type-fields caller ast field-types env))
    (return-if invalid-type (if (== inner invalid-type)))
    (blank)
    (let mark (. scratch types mark))
    (call (. scratch types push) inner)
    (return (call intern-class (. owner module) (. owner decl) mark))
  )
  (fn-do _ evaluate-type-fields TypeId
    (param caller ModuleId)
    (param ast AST)
    (param field-types (of RowRange SyntaxId))
    (param env TypeEnv)
    (if (== (. field-types count) 1)
      (let child ([] (. ast children) (. field-types start)))
      (return (call evaluate-type caller ast child env))
    )
    (blank)
    (return (call evaluate-type-tuple caller ast field-types false env))
  )
  (fn-do _ evaluate-type-tuple TypeId
    (param caller ModuleId)
    (param ast AST)
    (param field-types (of RowRange SyntaxId))
    (param is-struct Bool)
    (param env TypeEnv)
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let position 0)
    (for (in child ([] (. ast children) field-types))
      (let captured
        (match? ([] (. ast nodes) child)
          (case (call .node-type-capture capture)
            (call capture-name ast (. capture id))
          )
        )
      )
      (call (. scratch names push) (?? captured (call index-atom position)))
      (call (. scratch types push) (call evaluate-type caller ast child env))
      (+= position 1)
    )
    (blank)
    (if (not (call items-valid mark))
      (call (. scratch types rewind) mark)
      (call (. scratch names rewind) names-mark)
      (return invalid-type)
    )
    (return (if-expr is-struct (call intern-struct mark names-mark) (call intern-tuple mark names-mark)))
  )
  (fn-expr _ capture-name (? Atom)
    (param ast AST)
    (param id SyntaxId)
    (match? ([] (. ast nodes) id)
      (case (call .node-identifier row)
        (. row name)
      )
    )
  )
  (fn-do _ evaluate-type-function TypeId
    (param caller ModuleId)
    (param ast AST)
    (param return-type SyntaxId)
    (param args (of RowRange SyntaxId))
    (param errors (of RowRange SyntaxId))
    (param is-c Bool)
    (param env TypeEnv)
    (let mark (. scratch types mark))
    (for (in child ([] (. ast children) args))
      (call (. scratch types push) (call evaluate-type caller ast child env))
    )
    (let errors-mark (. scratch types length))
    (for (in child ([] (. ast children) errors))
      (call (. scratch types push) (call evaluate-type caller ast child env))
    )
    (blank)
    (let result (call evaluate-type caller ast return-type env))
    (if (or (== result invalid-type) (not (call items-valid mark)))
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (return (call intern-function result is-c mark errors-mark))
  )
  (fn-do _ evaluate-type-numeric TypeId
    (param caller ModuleId)
    (param ast AST)
    (param value SyntaxId)
    (param env TypeEnv)
    (let unit
      (match? ([] (. ast nodes) value)
        (case (call .node-integer-syntax number)
          (. number unit)
        )
        (case (call .node-float-syntax number)
          (. number unit)
        )
      )
    )
    (return-if invalid-type (if (not unit)))
    (blank)
    (let unit-type (call type-named caller unit env))
    (call complete-slow unit-type)
    (return (?? (call base-of unit-type) invalid-type))
  )
  (fn-do _ evaluate-type-associated TypeId
    (param caller ModuleId)
    (param ast AST)
    (param owner-syntax SyntaxId)
    (param name Atom)
    (param args (of RowRange SyntaxId))
    (param env TypeEnv)
    (let owner (call evaluate-type caller ast owner-syntax env))
    (return-if invalid-type (if (== owner invalid-type)))
    (blank)
    (let mark (. scratch types mark))
    (for (in child ([] (. ast children) args))
      (call (. scratch types push) (call evaluate-type caller ast child env))
    )
    (if (not (call items-valid mark))
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (return (call resolve-associated owner name mark env caller))
  )
  (fn-do _ raise-fault _
    (param message String)
    ; Notes why a type could not be named, for whoever asked to say so where it was written.
    (if (not fault)
      (= fault (call (. program store-atom) message))
      (= fault-site 0)
    )
  )
  (fn-do _ associated-by-constraints TypeId
    (param owner TypeId)
    (param name Atom)
    (param mark ScratchMark)
    (param count U32)
    (param env TypeEnv)
    ; A type parameter names an associated type only through the interfaces that constrain it,
    ; and through them only when exactly one declares it.
    (let found (list DeclRef))
    (for (in position (..< (. env constraint-start) (. env constraint-end)))
      (if (== ([] env-constrained position) owner)
        (call collect-requirements ([] env-constraints position) name count found)
      )
    )
    (if (== (. found length) 1)
      (return (call intern-associated owner ([] found 0) name mark))
    )
    (call (. scratch types rewind) mark)
    (if (> (. found length) 1)
      (call raise-fault (str "Associated type " (. name text) " is ambiguous"))
      (return invalid-type)
    )
    (match? ([] rows owner)
      (case (call .type-variable row)
        (let shown (. row name text))
        (call raise-fault (str "Associated type " (. name text) " is not declared by constraints on " shown))
      )
    )
    (return invalid-type)
  )
  (fn-do _ collect-requirements _
    (param type TypeId)
    (param name Atom)
    (param count U32)
    (param found (list DeclRef))
    ; Every declaration of an associated type an interface answers to, its own and those of the
    ; interfaces it extends, each once.
    (let ref
      (match? ([] rows type)
        (case (call .type-class row)
          (call DeclRef (. row module) (. row decl))
        )
      )
    )
    (if (not ref)
      (return)
    )
    (let declaring ref)
    (if (call find-associated-member (. declaring module) (. declaring decl) name count)
      (let known false)
      (for (in other found)
        (if (and (== (. other module) (. declaring module)) (== (. other decl) (. declaring decl)))
          (= known true)
        )
      )
      (if (not known)
        (+= found declaring)
      )
    )
    (call ensure-representation type)
    (let base (call base-of type))
    (if base
      (call ensure-representation base)
      (if (== (. ([] completions base) intrinsic) .interface)
        (call collect-requirements base name count found)
      )
    )
    (let owner-module ([] (. program modules) (. declaring module)))
    (match? ([] (. owner-module decls) (. declaring decl))
      (case (call .decl-class row)
        (if (!= (. row interfaces count) 0)
          (let env (call class-env (. declaring module) (. declaring decl)))
          (let caller Index (. declaring module))
          (for (in interface ([] (. owner-module syntax-pool) (. row interfaces)))
            (let implemented (call evaluate-type (as caller ModuleId) (. owner-module tree) interface env))
            (call collect-requirements implemented name count found)
          )
          (call env-release env)
        )
      )
    )
  )
  (fn-do _ find-requirement (? DeclRef)
    (param type TypeId)
    (param name Atom)
    (param count U32)
    (let ref
      (match? ([] rows type)
        (case (call .type-class row)
          (call DeclRef (. row module) (. row decl))
        )
      )
    )
    (return-if null (if (not ref)))
    (blank)
    (let declaring ref)
    (blank)
    (let member (call find-associated-member (. declaring module) (. declaring decl) name count))
    (if member
      (return ref)
    )
    (blank)
    (call ensure-representation type)
    (let base (call base-of type))
    (if base
      (call ensure-representation base)
      (if (== (. ([] completions base) intrinsic) .interface)
        (let found (call find-requirement base name count))
        (if found
          (return found)
        )
      )
    )
    (blank)
    (let owner-module ([] (. program modules) (. declaring module)))
    (let found (? DeclRef))
    (match? ([] (. owner-module decls) (. declaring decl))
      (case (call .decl-class row)
        (if (!= (. row interfaces count) 0)
          (let env (call class-env (. declaring module) (. declaring decl)))
          (let caller Index (. declaring module))
          (for (in interface ([] (. owner-module syntax-pool) (. row interfaces)))
            (if (not found)
              (let tree (. owner-module tree))
              (let implemented (call evaluate-type (as caller ModuleId) tree interface env))
              (= found (call find-requirement implemented name count))
            )
          )
          (call env-release env)
        )
      )
    )
    (return found)
  )
  (fn-do _ resolve-binding TypeId
    (param owner TypeId)
    (param name Atom)
    (param mark ScratchMark)
    (param count U32)
    (param caller (? ModuleId) (= null))
    (let ref
      (match? ([] rows owner)
        (case (call .type-class row)
          (call DeclRef (. row module) (. row decl))
        )
      )
    )
    (if (not ref)
      (call (. scratch types rewind) mark)
      (return invalid-type)
    )
    (let declaring ref)
    (blank)
    (let member (call find-associated-member (. declaring module) (. declaring decl) name count))
    (if member
      (let module ([] (. program modules) (. declaring module)))
      (match? ([] (. module decls) member)
        (case (call .decl-associated row)
          (let hidden
            (block
              (and (!= caller null) (not (call (. program reaches-access) caller (. declaring module) (. row access))))
            )
          )
          (if hidden
            (call raise-fault (call associated-hidden-message name (. row access)))
            (call (. scratch types rewind) mark)
            (return invalid-type)
          )
          (if (!= (. row binding) 0)
            (if (call is-resolving owner member)
              (= circular-module (. declaring module))
              (= circular-binding (. row binding))
              (= circular-name name)
              (call (. scratch types rewind) mark)
              (return invalid-type)
            )
            (+= resolving owner)
            (+= resolving member)
            (let args
              (match ([] rows owner)
                (case (call .type-class class-row)
                  (. class-row args)
                )
                (default
                  (call (of RowRange TypeId))
                )
              )
            )
            (let env (call class-env-for (. declaring module) (. declaring decl) args owner))
            (let position 0u32)
            (for (in child ([] (. module tree children) (. row type-args)))
              (let param (call type-syntax-name (. module tree) child))
              (if (and param (< position count))
                (= env (call env-bind env param ([] (. scratch types) (+ mark position))))
              )
              (+= position 1)
            )
            (let caller Index (. declaring module))
            (let bound (call evaluate-type (as caller ModuleId) (. module tree) (. row binding) env))
            (call env-release env)
            (call (. scratch types rewind) mark)
            (-= ([] resolving (..< (- (. resolving length) 2) (. resolving length))))
            (return bound)
          )
        )
      )
    )
    (blank)
    (call ensure-representation owner)
    (let base (call base-of owner))
    (if base
      (return (call resolve-binding base name mark count caller))
    )
    (call (. scratch types rewind) mark)
    (return invalid-type)
  )
  (fn-expr _ associated-hidden-message String
    (param name Atom)
    (param access Access)
    ; What an error says of an associated type another module keeps from the code naming it.
    (case? (is access .family-access)
      (str "Associated type " (. name text) " is shared, declared with ^, so only its own file family can use it")
    )
    (default
      (str "Associated type " (. name text) " is private")
    )
  )
  (fn-do _ is-resolving Bool
    (param owner TypeId)
    (param member DeclId)
    ; Whether an associated type's binding is being evaluated already: its own binding names it.
    (for (in offset (..< 0 (/ (. resolving length) 2)))
      (if (and (== ([] resolving (* offset 2)) owner) (== ([] resolving (+ (* offset 2) 1)) member))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ find-associated-member (? DeclId)
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (param count U32)
    (let owner-module ([] (. program modules) module))
    (let members
      (match ([] (. owner-module decls) decl)
        (case (call .decl-class row)
          (. row members)
        )
        (default
          (call (of RowRange DeclId))
        )
      )
    )
    (if (== (. members count) 0)
      (return null)
    )
    (blank)
    (for (in member ([] (. owner-module member-pool) members))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-associated row)
          (if (and (== (. row name) name) (== (. row type-args count) count))
            (return member)
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ declare-children TypeEnv
    (param env TypeEnv)
    (param tree AST)
    (param range (of RowRange SyntaxId))
    (param module ModuleId)
    (param owner DeclId)
    (param first Size)
    (let current env)
    (for (in child ([] (. tree children) range))
      (= current (call declare-into current tree child module owner first))
    )
    (return current)
  )
  (fn-expr _ placed-property (? Index)
    (param id TypeId)
    (param name Atom)
    ; A property of a type with many, found by its name without reading the others.
    (only-if (as found Index) (if found))
    (where
      (lazy found ([] property-places (call MemberKey id name)))
    )
  )
  (fn-do _ complete-slow _
    (param id TypeId)
    (throw (call Panic "Types are sealed and cannot complete a type") (if sealed))
    (blank)
    (let state (. ([] completions id) completion))
    (if (or (== state .completion-done) (== state .completion-failed))
      (return)
    )
    (if (== state .completion-in-progress)
      (call set-completion id .completion-failed .none null)
      (return)
    )
    (call cut-growth id)
    (if (!= (. ([] completions id) completion) .completion-unstarted)
      (return)
    )
    (blank)
    (call set-completion id .completion-in-progress .none null)
    (+= completing 1)
    (match ([] rows id)
      (case (call .type-class row)
        (+= class-uses (call DeclRef (. row module) (. row decl)))
        (call complete-class id (. row module) (. row decl) (. row args) (. row errors))
        (call make-properties id)
      )
      (case (call .type-tuple row)
        (call complete-fields id .tuple (. row fields) (. row names))
      )
      (case (call .type-struct row)
        (call complete-fields id .struct (. row fields) (. row names))
      )
      (case (call .type-union row)
        (call complete-cases id (. row cases) (call (of RowRange TypeId)) no-type)
      )
      (case (call .type-named-union row)
        (call complete-cases id (. row cases) (. row names) no-type)
      )
      (case (call .type-result row)
        (call complete-cases id (. row errors) (call (of RowRange TypeId)) (. row value))
      )
      (case (call .type-function row)
        (call set-completion
          (block
            (arg id)
            (arg .completion-done)
            (arg (if-expr (. row is-c) (. IntrinsicKind cfunction) (. IntrinsicKind function)))
            (arg null)
          )
        )
      )
      (case .type-binding
        (call set-completion id .completion-done .binding null)
      )
      (case .type-closure
        (call set-completion id .completion-done .closure null)
      )
      (default
        (call set-completion id .completion-done .none null)
      )
    )
    (-= completing 1)
    (if (== completing 0)
      (call complete-made)
    )
  )
  (fn-do _ cut-growth _
    (param id TypeId)
    (if (. ([] completions id) has-variables)
      (return)
    )
    (match? ([] rows id)
      (case (call .type-class row)
        (if (and (!= (. row args count) 0) (call grows (. row module) (. row decl)) (== (. ([] completions id) completion) .completion-unstarted))
          (+= class-uses (call DeclRef (. row module) (. row decl)))
          (call set-completion id .completion-failed .none null)
        )
      )
    )
  )
  (fn-do _ make-properties _
    (param id TypeId)
    ; Queues the types written in the properties of a class just completed: the classes among them
    ; have tables, and so do those their own properties are written with.
    (let completion ([] completions id))
    (if (or (!= (. completion completion) .completion-done) (. completion has-variables))
      (return)
    )
    (for (in property ([] properties (. completion properties)))
      (call make (. property type))
    )
  )
  (fn-do _ make _
    (param id TypeId)
    ; Queues a type to complete, and the types it is written with.
    (if (or (== id no-type) (== id invalid-type))
      (return)
    )
    (match? ([] rows id)
      (case (call .type-class row)
        (if (!= (. ([] completions id) completion) .completion-unstarted)
          (return)
        )
        (+= making id)
        (call make-range (. row args))
      )
      (case (call .type-tuple row)
        (call make-range (. row fields))
      )
      (case (call .type-struct row)
        (call make-range (. row fields))
      )
      (case (call .type-union row)
        (call make-range (. row cases))
      )
      (case (call .type-named-union row)
        (call make-range (. row cases))
      )
      (case (call .type-function row)
        (call make (. row return-type))
        (call make-range (. row args))
        (call make-range (. row errors))
      )
      (case (call .type-result row)
        (call make (. row value))
        (call make-range (. row errors))
      )
    )
  )
  (fn-do _ make-range _
    (param range (of RowRange TypeId))
    (for (in offset (..< 0 (. range count)))
      (call make (call child-type range offset))
    )
  )
  (fn-do _ complete-made _
    ; Completes the types queued once no completion is under way, so none is found in progress. A
    ; fault met on the way is not the caller's, whose own is kept.
    (let saved fault)
    (let saved-module fault-module)
    (let saved-site fault-site)
    (+= completing 1)
    (while (!= (. making length) 0)
      (let next ([] making (- (. making length) 1)))
      (call (. making pop))
      (call complete next)
    )
    (-= completing 1)
    (= fault saved)
    (= fault-module saved-module)
    (= fault-site saved-site)
  )
  (fn-expr _ case-value-type TypeId
    (param tree AST)
    (param value SyntaxId)
    ; The payload type of a union case declared by its value: the literal's own type.
    (match ([] (. tree nodes) value)
      (case .node-integer-syntax
        (call type-row .int64)
      )
      (case .node-float-syntax
        f64-type
      )
      (case .node-string-syntax
        string-type
      )
      (default
        invalid-type
      )
    )
  )
  (fn-do _ complete-cases _
    (param id TypeId)
    (param cases (of RowRange TypeId))
    (param names (of RowRange Atom))
    (param value TypeId)
    (let mark (. case-scratch length))
    (if (!= value no-type)
      (call (. case-scratch append) (call TypeCase null value false))
    )
    (for (in offset (..< 0 (. cases count)))
      (let name (? Atom) null)
      (if (< offset (. names count))
        (= name (call child-name names offset))
      )
      (let payload (call child-type cases offset))
      (if (and name (== payload void-type))
        (call (. case-scratch append) (call TypeCase name (call type-row .uint8) true))
        (else
          (call (. case-scratch append) (call TypeCase name payload false))
        )
      )
    )
    (call set-completion id .completion-done .union null)
    (call commit-cases id mark)
  )
  (fn-do _ complete-fields _
    (param id TypeId)
    (param type IntrinsicKind)
    (param fields (of RowRange TypeId))
    (param names (of RowRange Atom))
    (let mark (. property-scratch length))
    (for (in offset (..< 0 (. fields count)))
      (let name (call child-name names offset))
      (let fact (call TypeProperty name .storage-eager offset (call child-type fields offset) id (. U32 max)))
      (call (. property-scratch append) fact)
    )
    (call set-completion id .completion-done type null)
    (call commit-properties id mark)
  )
  (fn-do _ raising TypeId
    (param base TypeId)
    (param errors (of RowRange TypeId))
    ; The function type a class with errors of its own is: the one its declaration names, which
    ; raises those errors too.
    (if (== (. errors count) 0)
      (return base)
    )
    (match? ([] rows base)
      (case (call .type-function row)
        (let mark (. scratch types mark))
        (for (in offset (..< 0 (. row args count)))
          (call (. scratch types push) (call child-type (. row args) offset))
        )
        (let errors-mark (. scratch types mark))
        (for (in offset (..< 0 (. row errors count)))
          (call (. scratch types push) (call child-type (. row errors) offset))
        )
        (for (in offset (..< 0 (. errors count)))
          (call (. scratch types push) (call child-type errors offset))
        )
        (return (call intern-function (. row return-type) (. row is-c) mark errors-mark))
      )
    )
    (return base)
  )
  (fn-do _ complete-class _
    (param id TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param args (of RowRange TypeId))
    (param errors (of RowRange TypeId))
    (let facet (only-if (call (. program facets index-of) module decl) (if (!= (. program facets count) 0))))
    (if facet
      (call complete-facet id facet)
      (return)
    )
    (let owner-module ([] (. program modules) module))
    (let tree (. owner-module tree))
    (let base-syntax SyntaxId 0)
    (let aliased false)
    (let members (call (of RowRange DeclId)))
    (let interface-list (call (of RowRange SyntaxId)))
    (let or-bases (call (of RowRange SyntaxId)))
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-class row)
        (= base-syntax (. row base))
        (= aliased (!= (. row aliases count) 0))
        (= members (. row members))
        (= interface-list (. row interfaces))
        (= or-bases (. row or-bases))
      )
    )
    (blank)
    (let env (call class-env-for module decl args id))
    (let base (? TypeId))
    (if (!= base-syntax 0)
      (= base (call raising (call evaluate-type module tree base-syntax env) errors))
      (call complete-slow base)
      (if (== (. ([] completions base) completion) .completion-failed)
        (call env-release env)
        (call set-completion id .completion-failed .none null)
        (return)
      )
    )
    (blank)
    (let tag (call intrinsic-for-decl module decl))
    (let type
      (block
        (case? (!= tag .none)
          tag
        )
        (case? base
          (. ([] completions base) intrinsic)
        )
        (default
          (. IntrinsicKind class)
        )
      )
    )
    (call set-completion id .completion-in-progress type base)
    (blank)
    (let property-mark (. property-scratch length))
    (let outer-stored stored-count)
    (= stored-count 0)
    (let case-mark (. case-scratch length))
    (let associated-mark (. associated-scratch length))
    (let items-mark (. scratch types mark))
    (blank)
    (if base
      (call inherit-properties base id property-mark)
    )
    (let interface-start (. scratch types length))
    (if (!= (. interface-list count) 0)
      (for (in interface ([] (. owner-module syntax-pool) interface-list))
        (call (. scratch types push) (call evaluate-type module tree interface env))
      )
    )
    (let delegated (list TypeId))
    (let delegators (list Atom))
    (for (in member ([] (. owner-module member-pool) members))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-property row)
          (if (and (!= (. row delegates count) 0) (. row name))
            (let delegator (. row name))
            (let held no-type)
            (if (!= (. row type-syntax) 0)
              (= held (call evaluate-type module tree (. row type-syntax) env))
            )
            (let source held)
            (if (== source no-type)
              (= source (call constructed-class module tree (. row value) env))
            )
            (for (in delegate ([] (. owner-module syntax-pool) (. row delegates)))
              (let named (call evaluate-type module tree delegate env))
              (let interface (call delegated-interface named source))
              (call (. scratch types push) interface)
              (+= delegated interface)
              (+= delegated held)
              (+= delegators delegator)
            )
          )
        )
        (case (call .decl-function row)
          (if (and (!= (. row delegates count) 0) (. row name))
            (let delegator (. row name))
            (let held no-type)
            (if (!= (. row return-type) 0)
              (= held (call evaluate-type module tree (. row return-type) env))
            )
            (for (in delegate ([] (. owner-module syntax-pool) (. row delegates)))
              (let named (call evaluate-type module tree delegate env))
              (let interface (call delegated-interface named held))
              (call (. scratch types push) interface)
              (+= delegated interface)
              (+= delegated held)
              (+= delegators delegator)
            )
          )
        )
      )
    )
    (call gather-facet-interfaces module decl env)
    (let alternative-start (. scratch types length))
    (for (in child ([] (. tree children) or-bases))
      (call (. scratch types push) (call evaluate-type module tree child env))
    )
    (let converter-start (. scratch types length))
    (let fromverter-start (. scratch types length))
    (if (!= (. members count) 0)
      (for (in member ([] (. owner-module member-pool) members))
        (call gather-member id module member env type property-mark)
      )
    )
    (call gather-facets id module decl env type property-mark)
    (if (!= (. members count) 0)
      (= converter-start (. scratch types length))
      (for (in member ([] (. owner-module member-pool) members))
        (call gather-converter id module member env true)
      )
      (= fromverter-start (. scratch types length))
      (for (in member ([] (. owner-module member-pool) members))
        (call gather-converter id module member env false)
      )
    )
    (if (!= (. args count) 0)
      (call declare-equalities id module tree base-syntax env aliased)
    )
    (call env-release env)
    (blank)
    (let interfaces (call commit-items interface-start alternative-start))
    (let alternatives (call commit-items alternative-start converter-start))
    (let converters (call commit-items converter-start fromverter-start))
    (let fromverters (call commit-items fromverter-start (. scratch types length)))
    (call (. scratch types rewind) items-mark)
    (for (in item delegated)
      (call (. scratch types push) item)
    )
    (let delegates (call commit-items items-mark (. scratch types length)))
    (call (. scratch types rewind) items-mark)
    (call set-completion id .completion-done type base)
    (call commit-properties id property-mark)
    (= stored-count outer-stored)
    (call commit-cases id case-mark)
    (call commit-associated id associated-mark)
    (call set-ranges id interfaces alternatives converters fromverters)
    (= (. ([] completions id) delegates) delegates)
    (let names-mark (. scratch names mark))
    (for (in name delegators)
      (call (. scratch names push) name)
    )
    (= (. ([] completions id) delegate-names) (call store-names names-mark))
    (call (. scratch names rewind) names-mark)
  )
  (fn-do _ constructed-class TypeId
    (param module ModuleId)
    (param tree AST)
    (param value SyntaxId)
    (param env TypeEnv)
    ; The class a property with no declared type constructs in its initializer, when the
    ; initializer is a call of a type.
    (if (== value 0)
      (return no-type)
    )
    (match? ([] (. tree nodes) value)
      (case (call .node-call-expression call)
        (let named
          (match ([] (. tree nodes) (. call callable))
            (case .node-type-identifier
              true
            )
            (case .node-type-arguments
              true
            )
            (default
              false
            )
          )
        )
        (if named
          (let constructed (call evaluate-type module tree (. call callable) env))
          (return (if-expr (== constructed invalid-type) no-type constructed))
        )
      )
    )
    (return no-type)
  )
  (fn-do _ delegated-interface TypeId
    (param interface TypeId)
    (param source TypeId)
    ; A class that delegates a type of alternatives delegates the alternative its property is.
    (if (or (== interface invalid-type) (== source no-type) (== source invalid-type))
      (return interface)
    )
    (call complete interface)
    (if (!= (. ([] completions interface) intrinsic) .or)
      (return interface)
    )
    (let alternatives (. ([] completions interface) alternatives))
    (for (in offset (..< 0 (. alternatives count)))
      (let alternative (call child-type alternatives offset))
      (if (call implements-type source alternative)
        (return alternative)
      )
    )
    (return interface)
  )
  (fn-do _ inherit-properties _
    (param base TypeId)
    (param id TypeId)
    (param mark ScratchMark)
    (let range (. ([] completions base) properties))
    (for (in inherited ([] properties range))
      (let kind (. inherited storage-kind))
      (call add-property mark (. inherited name) kind (. inherited type) (. inherited owner) (. inherited facet))
    )
  )
  (fn-do _ action-type TypeId
    ; A function that takes nothing and answers nothing, `-> Void`.
    (let mark (. scratch types mark))
    (return (call intern-function void-type false mark mark))
  )
  (fn-do _ pointer-type TypeId
    (param module ModuleId)
    ; The address of bytes, `Pointer`, as a module sees it.
    (let mark (. scratch types mark))
    (call (. scratch types push) (call type-row .uint8))
    (return (call class-named-with-args module (!! cpointer-atom) mark))
  )
  (fn-do _ held-storage (? StorageKind)
    (param mark ScratchMark)
    (param name Atom)
    ; How a property of a name is stored among those gathered for a type so far, the ones it has
    ; from the class above it among them, or nothing where there is none. The value a root
    ; `<This` gives a property applies only to one the type has and stores in the object, and
    ; the name of an element declares a property only where the type has none of that name.
    (let found ([] scratch-places (call MemberKey (as mark U32) name)))
    (if found
      (let slot Index found)
      (if (and (>= slot mark) (< slot (. property-scratch length)) (== (. ([] property-scratch slot) name) name))
        (return (. ([] property-scratch slot) storage-kind))
      )
    )
    (return null)
  )
  (fn-do _ add-property _
    (param mark ScratchMark)
    (param name Atom)
    (param storage StorageKind)
    (param type TypeId)
    (param owner TypeId)
    (param facet U32 (= (. U32 max)))
    ; A property of the name gathered before is the same property, given again by a class below,
    ; unless a facet declares the new one, or a facet keeps the one before to itself: facets name their
    ; private properties as they like. A class below that gives a facet's stored property a new value
    ; gives it the facet's own, which stays the facet's.
    (let key (call MemberKey (as mark U32) name))
    (let found ([] scratch-places key))
    (if found
      (let slot Index found)
      (let same (and (>= slot mark) (< slot (. property-scratch length)) (== (. ([] property-scratch slot) name) name)))
      (if (and same (== facet (. U32 max)) (or (== held (. U32 max)) given-again))
        (let existing ([] property-scratch slot))
        (let kept (if-expr (!= (. existing type) no-type) (. existing type) type))
        (= ([] property-scratch slot)
          (call TypeProperty
            (block
              (arg name)
              (arg (. existing storage-kind))
              (arg (. existing slot))
              (arg kept)
              (arg owner)
              (arg held)
            )
          )
        )
        (return)
      )
      (lazy held (. ([] property-scratch slot) facet))
      (lazy stored (and (!= storage .storage-getter) (!= (. ([] property-scratch slot) storage-kind) .storage-getter)))
      (lazy given-again (and stored (not (call is-facet-private held name))))
    )
    (let index (. U32 max))
    (if (!= storage .storage-getter)
      (= index stored-count)
      (+= stored-count 1)
    )
    (= ([] scratch-places key) (as (. property-scratch length) U32))
    (call (. property-scratch append) (call TypeProperty name storage index type owner facet))
  )
  (fn-do _ gather-facets _
    (param id TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param env TypeEnv)
    (param type IntrinsicKind)
    (param mark ScratchMark)
    ; The properties a class's facets declare, after the class's own, facet by facet in their order.
    ; A facet's getters and setters are found as an extension's are.
    (let facets (. program facets))
    (return-if (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) module decl))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (let facet-module ([] (. facets modules) facet))
      (let target ([] (. program modules) facet-module))
      (match? ([] (. target decls) ([] (. facets decls) facet))
        (case (call .decl-extension row)
          (for (in member ([] (. target member-pool) (. row members)))
            (if (is ([] (. target decls) member) .decl-property)
              (call gather-member id facet-module member env type mark facet)
            )
          )
        )
      )
    )
  )
  (fn-do _ gather-facet-interfaces _
    (param module ModuleId)
    (param decl DeclId)
    (param env TypeEnv)
    ; The interfaces a class's facets name, after the class's own, facet by facet in their order, each
    ; read in its facet's module.
    (let facets (. program facets))
    (return-if (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) module decl))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (let facet-module ([] (. facets modules) facet))
      (let target ([] (. program modules) facet-module))
      (match? ([] (. target decls) ([] (. facets decls) facet))
        (case (call .decl-extension row)
          (for (in interface ([] (. target syntax-pool) (. row interfaces)))
            (call (. scratch types push) (call evaluate-type facet-module (. target tree) interface env))
          )
        )
      )
    )
  )
  (fn-do _ gather-member _
    (param id TypeId)
    (param module ModuleId)
    (param member DeclId)
    (param env TypeEnv)
    (param type IntrinsicKind)
    (param mark ScratchMark)
    (param facet U32 (= (. U32 max)))
    (let owner-module ([] (. program modules) module))
    (let tree (. owner-module tree))
    (match? ([] (. owner-module decls) member)
      (case (call .decl-property row)
        (let held (only-if (call held-storage mark (. row name)) (if (. row name))))
        (let given (and (. row defaults-root) (or (not held) (!= held .storage-eager))))
        (let named (and (!= (. row element) 0) (!= held null)))
        (let refined (and (or (!= (. row projection) 0) (!= (. row flag) 0)) (!= held null)))
        (if (and (. row name) (not given) (not named) (not refined))
          (let property-name (. row name))
          (let storage (if-expr (. row is-lazy) .storage-lazy .storage-eager))
          (let declared no-type)
          (if (!= (. row type-syntax) 0)
            (= declared (call query-held (call evaluate-type module tree (. row type-syntax) env)))
            (else-if (!= (. row flag) 0)
              (= declared (call type-row .bool))
            )
            (else-if (!= (. row context) 0)
              (= declared (call pointer-type module))
            )
            (else-if (!= (. row part) 0)
              (= declared (call action-type))
            )
          )
          (call add-property mark property-name storage declared id facet)
        )
      )
      (case (call .decl-function row)
        (let is-accessor (or (== (. row kind) .getter-decl) (== (. row kind) .setter-decl)))
        (if (and (. row name) is-accessor (== (. row owner) (call member-owner module member)))
          (let accessor-name (. row name))
          (let declared no-type)
          (if (and (== (. row kind) .getter-decl) (!= (. row return-type) 0))
            (= declared (call evaluate-type module tree (. row return-type) env))
          )
          (call add-property mark accessor-name .storage-getter declared id facet)
        )
      )
      (case (call .decl-case row)
        (if (!= type .union)
          (call set-flag id .flag-enums)
          (else
            (let declared no-type)
            (let is-default (and (== (. row type-syntax) 0) (== (. row value) 0)))
            (if (!= (. row type-syntax) 0)
              (= declared (call evaluate-type module tree (. row type-syntax) env))
              (else-if (== (. row value) 0)
                (= declared (call type-row .uint8))
              )
              (else
                (= declared (call case-value-type tree (. row value)))
              )
            )
            (call (. case-scratch append) (call TypeCase (. row name) declared is-default))
          )
        )
      )
      (case (call .decl-associated row)
        (if (!= (. row binding) 0)
          (let bound env)
          (let first (. bound end))
          (for (in child ([] (. tree children) (. row type-args)))
            (let param (call type-syntax-name tree child))
            (if param
              (let variable (call intern-variable module member (as (- (. bound end) first) U32) param))
              (= bound (call env-bind bound param variable))
            )
          )
          (let binding (call evaluate-type module tree (. row binding) bound))
          (-= ([] env-names (..< (. env end) (. env-names length))))
          (-= ([] env-types (..< (. env end) (. env-types length))))
          (call (. associated-scratch append) (call TypeAssociated (. row name) binding))
        )
      )
    )
  )
  (fn-expr _ member-owner DeclId
    (param module ModuleId)
    (param member DeclId)
    (match ([] (. ([] (. program modules) module) decls) member)
      (case (call .decl-function row)
        (. row owner)
      )
      (default
        0
      )
    )
  )
  (fn-do _ gather-converter _
    (param id TypeId)
    (param module ModuleId)
    (param member DeclId)
    (param env TypeEnv)
    (param wants-converters Bool)
    (let owner-module ([] (. program modules) module))
    (let tree (. owner-module tree))
    (let syntax SyntaxId 0)
    (match? ([] (. owner-module decls) member)
      (case (call .decl-converter row)
        (if wants-converters
          (= syntax (. row target-type))
        )
      )
      (case (call .decl-fromverter row)
        (if (not wants-converters)
          (= syntax (. row source-type))
        )
      )
    )
    (if (== syntax 0)
      (return)
    )
    (let bound (call declare-into env tree syntax module member (. env end)))
    (let target (call evaluate-type module tree syntax bound))
    (-= ([] env-names (..< (. env end) (. env-names length))))
    (-= ([] env-types (..< (. env end) (. env-types length))))
    (call (. scratch types push) target)
    (call (. scratch types push) module)
    (call (. scratch types push) member)
    (call (. scratch types push) id)
  )
  (fn-do _ declare-class-equalities _
    ; Declares the equality of every class that is a number of some unit, before anything is
    ; typed. Whether two numbers of different units may be cast to one another depends on whether
    ; each takes part in an equality, so the answer must not wait on which class happens to be
    ; completed first.
    (let module-index 0u32)
    (for (in module (. program modules))
      (let tree (. module tree))
      (let decl-index 0u32)
      (for (in decl (. module decls))
        (match? decl
          (case (call .decl-class row)
            (let aliased (!= (. row aliases count) 0))
            (if (and (== (. row type-args count) 0) (or (call names-unit-multiple tree (. row base)) named-alias))
              (let owner ModuleId module-index)
              (let env (call class-env owner decl-index))
              (call declare-equalities (. env this-type) owner tree (. row base) env aliased)
              (call env-release env)
            )
            (lazy named-alias (and aliased (call (. tree names-type) (. row base))))
          )
        )
        (+= decl-index 1)
      )
      (+= module-index 1)
    )
  )
  (fn-expr _ names-type Bool
    (param tree AST)
    (param base-syntax SyntaxId)
    ; Whether a class is declared as another type by its name, as `Small (sm)` is `Base`.
    (case? (== base-syntax 0)
      false
    )
    (default
      (match ([] (. tree nodes) base-syntax)
        (case .node-type-identifier
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr _ names-unit-multiple Bool
    (param tree AST)
    (param base-syntax SyntaxId)
    ; Whether a class is declared as a number of some unit, as `Hours` is `60minutes`.
    (case? (== base-syntax 0)
      false
    )
    (default
      (match ([] (. tree nodes) base-syntax)
        (case .node-type-numeric
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-do + unit-amount UnitAmount
    (param caller ModuleId)
    (param tree AST)
    (param syntax SyntaxId)
    (let none (list UnitTerm))
    (if (== syntax 0)
      (return (call UnitAmount 0.0 none syntax ""))
    )
    (match? ([] (. tree nodes) syntax)
      (case (call .node-binary-expression row)
        (let left (call unit-amount caller tree (. row lhs)))
        (if (!= (. left failed) 0)
          (return left)
        )
        (let right (call unit-amount caller tree (. row rhs)))
        (if (!= (. right failed) 0)
          (return right)
        )
        (let op (. row op))
        (let amount (. left amount))
        (let other (. right amount))
        (if (== op .multiply-op)
          (return (call UnitAmount (* amount other) (call added-terms (. left terms) (. right terms) 1) 0 ""))
        )
        (if (== op .divide-op)
          (return (call UnitAmount (/ amount other) (call added-terms (. left terms) (. right terms) -1) 0 ""))
        )
        (if (== op .pow-op)
          (if (or (!= (. right terms length) 0) (!= (as (as other I64) F64) other))
            (return (call UnitAmount 0.0 none (. row rhs) "A unit is raised only to a whole number with no unit, as in \"(%% 1meters 2)\""))
          )
          (let raised (list UnitTerm))
          (return (call UnitAmount (%% amount other) (call added-terms raised (. left terms) (as other I32)) 0 ""))
        )
        (let alike (call same-terms (. left terms) (. right terms)))
        (let terms (if-expr (!= (. left terms length) 0) (. left terms) (. right terms)))
        (if (or (== op .add-op) (== op .subtract-op) (== op .mod-op))
          (if (not alike)
            (if (and (!= op .mod-op) (or (== (. left terms length) 0) (== (. right terms length) 0)))
              (return (call UnitAmount 0.0 none (if-expr (== (. left terms length) 0) (. row lhs) (. row rhs)) "An equality relates two units by a ratio alone, so a number with no unit cannot be added to or taken from one; write the ratio as one number in the unit"))
            )
            (return (call UnitAmount 0.0 none syntax "Conflicting units"))
          )
          (if (== op .add-op)
            (return (call UnitAmount (+ amount other) terms 0 ""))
          )
          (if (== op .subtract-op)
            (return (call UnitAmount (- amount other) terms 0 ""))
          )
          (return (call UnitAmount (% amount other) terms 0 ""))
        )
        (if (and (!= (. left terms length) 0) (!= (. right terms length) 0))
          (return (call UnitAmount 0.0 none syntax "Conflicting units"))
        )
        (let whole (as (as amount I64) I32))
        (let count (as (as other I64) I32))
        (let shift (/and/ count 31))
        (if (== op .bitwise-and-op)
          (return (call UnitAmount (as (/and/ whole count) F64) terms 0 ""))
        )
        (if (== op .bitwise-or-op)
          (return (call UnitAmount (as (/or/ whole count) F64) terms 0 ""))
        )
        (if (== op .bitwise-xor-op)
          (return (call UnitAmount (as (/xor/ whole count) F64) terms 0 ""))
        )
        (if (== op .bitwise-lshift-op)
          (return (call UnitAmount (as (/lshift/ whole shift) F64) terms 0 ""))
        )
        (if (== op .bitwise-rshift-op)
          (return (call UnitAmount (as (/rshift/ whole shift) F64) terms 0 ""))
        )
        (if (== op .bitwise-zrshift-op)
          (return (call UnitAmount (as (/zrshift/ (as whole U32) shift) F64) terms 0 ""))
        )
        (return (call UnitAmount 0.0 none syntax ""))
      )
    )
    (let text "")
    (let suffix (? Atom) null)
    (let numeric false)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-integer-syntax number)
        (= text (. number value))
        (= suffix (. number unit))
        (= numeric true)
      )
      (case (call .node-float-syntax number)
        (= text (. number value))
        (= suffix (. number unit))
        (= numeric true)
      )
    )
    (if (not numeric)
      (return (call UnitAmount 0.0 none syntax ""))
    )
    (let amount (as text F64))
    (if (not suffix)
      (return (call UnitAmount amount none 0 ""))
    )
    (let type (call type-named caller suffix (call env-frame)))
    (if (== type invalid-type)
      (return (call UnitAmount 0.0 none syntax ""))
    )
    (let terms (list UnitTerm))
    (+= terms (call UnitTerm type 1))
    (return (call UnitAmount amount terms 0 ""))
  )
  (fn-do _ declare-equalities _
    (param id TypeId)
    (param module ModuleId)
    (param tree AST)
    (param base-syntax SyntaxId)
    (param env TypeEnv)
    (param aliased Bool (= false))
    ; A class declared as a number of some unit equals that many of it. A unit declared on a
    ; number type of the program's own, as `Small (sm)` is `Base`, is one of that type, and each
    ; equals the other. A class with type parameters is declared once for each set of arguments,
    ; when that one is completed.
    (if (== base-syntax 0)
      (return)
    )
    (match? ([] (. tree nodes) base-syntax)
      (case .node-type-identifier
        (if aliased
          (let base (call evaluate-type module tree base-syntax env))
          (if (and known-base (!= base id) (not (. ([] completions base) is-builtin)))
            (call complete base)
            (if (call intrinsic-is-numeric (. ([] completions base) intrinsic))
              (call relate-units id base (call UnitRatio 1.0 1.0) module base-syntax)
            )
          )
          (lazy known-base (and (!= base invalid-type) (!= base no-type)))
        )
      )
      (case (call .node-type-numeric numeric)
        (let unit (? Atom))
        (let text "")
        (match? ([] (. tree nodes) (. numeric value))
          (case (call .node-integer-syntax number)
            (= unit (. number unit))
            (= text (. number value))
          )
          (case (call .node-float-syntax number)
            (= unit (. number unit))
            (= text (. number value))
          )
        )
        (if unit
          (let unit-type (call type-named module unit env))
          (let ratio (as text F64))
          (if (and (!= unit-type invalid-type) (!= ratio 0.0))
            (call relate-units id unit-type (call decimal-ratio ratio) module base-syntax)
          )
        )
      )
    )
  )
  (fn-do _ relate-units _
    (param from TypeId)
    (param to TypeId)
    (param ratio UnitRatio)
    (param module ModuleId)
    (param syntax SyntaxId)
    (call (. unit-families join) from to ratio module syntax)
    (call set-flag from .flag-equalities)
    (call set-flag to .flag-equalities)
  )
  (fn-do _ commit-items (of RowRange TypeId)
    (param start Size)
    (param end Size)
    (throw (call Panic "Types child pool exceeds U32 capacity") (if (>= (. children length) (. U32 max))))
    (blank)
    (let first (. children length))
    (for (in index (..< start end))
      (call (. children push) ([] (. scratch types) index))
    )
    (return (call (of RowRange TypeId) (as first U32) (as (- (. children length) first) U32)))
  )
  (fn-do _ complete-facet _
    (param id TypeId)
    (param facet U32)
    ; A facet's type is its class's objects seen through the facet: a class of its own with no base,
    ; whose properties are its class's own, so that its objects are laid out as the class's are and a
    ; property is one wherever it is read. Which of them code reaches through it is the checker's to
    ; say.
    (let facets (. program facets))
    (if (!= ([] (. facets states) facet) .facet-bound)
      (call set-completion id .completion-failed .none null)
      (return)
    )
    (let owner (call facet-owner facet))
    (call complete-slow owner)
    (if (!= (. ([] completions owner) completion) .completion-done)
      (call set-completion id .completion-failed .none null)
      (return)
    )
    (call set-completion id .completion-done .class null)
    (let range (. ([] completions owner) properties))
    (= (. ([] completions id) properties) range)
    (if (> (. range count) property-scan-limit)
      (for (in offset (..< 0 (. range count)))
        (let place (- (+ (. range start) (. range count)) 1 offset))
        (= ([] property-places (call MemberKey id (. ([] properties place) name))) (as place U32))
      )
    )
  )
  (fn-do _ commit-properties _
    (param id TypeId)
    (param mark ScratchMark)
    (let first (. properties length))
    (for (in fact ([] property-scratch (..< mark (. property-scratch length))))
      (let copied
        (call TypeProperty
          (block
            (arg (. fact name))
            (arg (. fact storage-kind))
            (arg (. fact slot))
            (arg (. fact type))
            (arg (. fact owner))
            (arg (. fact facet))
          )
        )
      )
      (call (. properties append) copied)
    )
    (call (. property-scratch truncate) mark)
    (let count (- (. properties length) first))
    (= (. ([] completions id) properties) (call (of RowRange TypeProperty) (as first U32) (as count U32)))
    (if (> count property-scan-limit)
      (for (in offset (..< 0 count))
        (let place (- (+ first count) 1 offset))
        (= ([] property-places (call MemberKey id (. ([] properties place) name))) (as place U32))
      )
    )
  )
  (fn-do _ commit-cases _
    (param id TypeId)
    (param mark ScratchMark)
    (let first (. cases length))
    (for (in fact ([] case-scratch (..< mark (. case-scratch length))))
      (call (. cases append) (call TypeCase (. fact name) (. fact type) (. fact is-default)))
    )
    (call (. case-scratch truncate) mark)
    (= (. ([] completions id) cases) (call (of RowRange TypeCase) (as first U32) (as (- (. cases length) first) U32)))
  )
  (fn-do _ commit-associated _
    (param id TypeId)
    (param mark ScratchMark)
    (let first (. associated-types length))
    (for (in fact ([] associated-scratch (..< mark (. associated-scratch length))))
      (call (. associated-types append) (call TypeAssociated (. fact name) (. fact type)))
    )
    (call (. associated-scratch truncate) mark)
    (= (. ([] completions id) associated)
      (call (of RowRange TypeAssociated)
        (block
          (arg (as first U32))
          (arg (as (- (. associated-types length) first) U32))
        )
      )
    )
  )
  (fn-do _ set-ranges _
    (param id TypeId)
    (param interfaces (of RowRange TypeId))
    (param alternatives (of RowRange TypeId))
    (param converters (of RowRange TypeId))
    (param fromverters (of RowRange TypeId))
    (= (. ([] completions id) interfaces) interfaces)
    (= (. ([] completions id) alternatives) alternatives)
    (= (. ([] completions id) converters) converters)
    (= (. ([] completions id) fromverters) fromverters)
  )
  (fn-do _ set-completion _
    (param id TypeId)
    (param completion CompletionState)
    (param type IntrinsicKind)
    (param base (? TypeId) (= null))
    (= (. ([] completions id) completion) completion)
    (= (. ([] completions id) base) (?? base no-type))
    (= (. ([] completions id) intrinsic) type)
    (= (. ([] completions id) bit-size) (call intrinsic-bit-size type))
    (= (. ([] completions id) is-signed) (call intrinsic-is-signed type))
    (= (. ([] completions id) is-pointer) (call intrinsic-is-pointer type))
    (= (. ([] completions id) is-struct) (call intrinsic-is-struct type))
  )
  (fn-do _ add-completion _
    (param owner-key StableKey (= 0))
    (let empty (call (of RowRange TypeId)))
    (let row
      (call TypeCompletion
        (block
          (arg .completion-unstarted)
          (arg no-type)
          (arg .none)
          (arg 0)
          (arg false)
          (arg false)
          (arg false)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg empty)
          (arg (call (of RowRange Atom)))
          (arg false)
          (arg false)
          (arg false)
          (arg false)
        )
      )
    )
    (call (. completions append) row)
    (+= stable-keys (call stable-key (as (- (. completions length) 1) TypeId) owner-key))
    (call check-alignment)
  )
  (fn-do _ stable-key StableKey
    (param id TypeId)
    (param owner-key StableKey)
    ; Hashed from the type's kind, its declaration, and the keys of the types it is made of. A
    ; closure's also takes the key of the instance it is written in.
    (let key stable-key-seed)
    (match? ([] rows id)
      (case .type-invalid
        (= key (call mixed key (. TypeTag invalid)))
      )
      (case (call .type-class row)
        (= key (call keyed-range (call keyed-decl key (. TypeTag class) (. row module) (. row decl)) (. row args)))
        (if (!= (. row errors count) 0)
          (= key (call keyed-range (call mixed key (. TypeTag raising-class)) (. row errors)))
        )
      )
      (case (call .type-variable row)
        (= key (call mixed (call keyed-decl key (. TypeTag variable) (. row module) (. row decl)) (. row index)))
      )
      (case (call .type-inference row)
        (= key (call mixed (call mixed (call mixed key (. TypeTag inference)) (. row scope)) (. row ordinal)))
      )
      (case (call .type-tuple row)
        (= key (call keyed-names (call keyed-range (call mixed key (. TypeTag tuple)) (. row fields)) (. row names)))
      )
      (case (call .type-struct row)
        (= key (call keyed-names (call keyed-range (call mixed key (. TypeTag struct)) (. row fields)) (. row names)))
      )
      (case (call .type-union row)
        (= key (call keyed-range (call mixed key (. TypeTag union)) (. row cases)))
      )
      (case (call .type-named-union row)
        (= key (call mixed-text (call mixed key (. TypeTag named-union)) (. row owner text)))
        (= key (call keyed-names (call keyed-range key (. row cases)) (. row names)))
        (if (!= (. row made-at) 0)
          (= key (call mixed (call mixed key (. row made-in)) (. row made-at)))
        )
      )
      (case (call .type-function row)
        (= key (call mixed (call mixed key (. TypeTag function)) (call key-of (. row return-type))))
        (= key (call mixed key (if-expr (. row is-c) 1u64 0u64)))
        (= key (call keyed-range (call keyed-range key (. row args)) (. row errors)))
      )
      (case (call .type-result row)
        (= key (call mixed (call mixed key (. TypeTag result)) (call key-of (. row value))))
        (= key (call keyed-range key (. row errors)))
      )
      (case (call .type-associated row)
        (= key (call keyed-decl key (. TypeTag associated) (. row module) (. row decl)))
        (= key (call mixed-text (call mixed key (call key-of (. row owner))) (. row name text)))
        (= key (call keyed-range key (. row args)))
      )
      (case (call .type-closure row)
        (= key (call mixed (call keyed-decl key (. TypeTag closure) (. row module) (. row decl)) owner-key))
      )
      (case (call .type-binding row)
        (= key
          (call mixed
            (block
              (arg (call mixed (call keyed-decl key (. TypeTag binding) (. row module) (. row decl)) (. row form)))
              (arg (. row scope))
            )
          )
        )
        (= key (call mixed (call mixed key (call key-of (. row object))) (. row param-count)))
        (= key (call keyed-range key (. row items)))
      )
    )
    (return key)
  )
  (fn-expr _ keyed-decl StableKey
    (param key StableKey)
    (param tag U32)
    (param module ModuleId)
    (param decl DeclId)
    (call mixed (call mixed (call mixed key tag) module) decl)
  )
  (fn-do _ keyed-range StableKey
    (param key StableKey)
    (param range (of RowRange TypeId))
    (let result (call mixed key (. range count)))
    (for (in offset (..< 0 (. range count)))
      (= result (call mixed result (call key-of ([] children (+ (. range start) offset)))))
    )
    (return result)
  )
  (fn-do _ keyed-names StableKey
    (param key StableKey)
    (param range (of RowRange Atom))
    (let result (call mixed key (. range count)))
    (for (in offset (..< 0 (. range count)))
      (= result (call mixed-text result (. ([] atoms (+ (. range start) offset)) text)))
    )
    (return result)
  )
  (fn-do _ set-flag _
    (param id TypeId)
    (param flag FactFlag)
    (match flag
      (case= .flag-builtin
        (= (. ([] completions id) is-builtin) true)
      )
      (case= .flag-variables
        (= (. ([] completions id) has-variables) true)
      )
      (case= .flag-equalities
        (= (. ([] completions id) has-equalities) true)
      )
      (default
        (= (. ([] completions id) has-enums) true)
      )
    )
  )
  (fn-do _ note-children _
    (param id TypeId)
    (param range (of RowRange TypeId))
    (for (in offset (..< 0 (. range count)))
      (call note-child id (call child-type range offset))
    )
  )
  (fn-do _ note-child _
    (param id TypeId)
    (param child TypeId)
    ; A type holds a variable when anything it is made of does, and a closure the same way. A
    ; function that takes a closure is typed while the function the closure is written in still
    ; runs, so a call has to know which types hold one.
    (if (. ([] completions child) has-variables)
      (= (. ([] completions id) has-variables) true)
    )
    (if (. ([] completions child) has-closures)
      (= (. ([] completions id) has-closures) true)
    )
    (if (and (!= child no-type) (!= child invalid-type) (>= (. ([] completions child) depth) (. ([] completions id) depth)))
      (= (. ([] completions id) depth) (+ (. ([] completions child) depth) 1))
    )
  )
  (fn-do _ store-items (of RowRange TypeId)
    (param mark ScratchMark)
    (throw (call Panic "Types child pool exceeds U32 capacity") (if (>= (. children length) (. U32 max))))
    (blank)
    (let start (. children length))
    (for (in index (..< mark (. scratch types length)))
      (call (. children push) ([] (. scratch types) index))
    )
    (return (call (of RowRange TypeId) (as start U32) (as (- (. children length) start) U32)))
  )
  (fn-do _ store-names (of RowRange Atom)
    (param mark ScratchMark)
    (throw (call Panic "Types name pool exceeds U32 capacity") (if (>= (. atoms length) (. U32 max))))
    (blank)
    (let start (. atoms length))
    (for (in index (..< mark (. scratch names length)))
      (+= atoms ([] (. scratch names) index))
    )
    (return (call (of RowRange Atom) (as start U32) (as (- (. atoms length) start) U32)))
  )
  (fn-do _ ensure-scratch _
    (param count Size)
    (if (> count (. key-scratch length))
      (let capacity (. key-scratch length))
      (while (< capacity count)
        (*= capacity 2)
      )
      (= key-scratch (call (. key-scratch resize) capacity arena))
    )
  )
  (fn-do _ check-alignment _
    (throw (call Panic "Types row, fact, and key tables are misaligned") (if (or (!= (. rows length) (. keys length)) (!= (. completions length) (. keys length)))))
    (throw (call Panic "Types rows and stable keys are misaligned") (if (!= (. stable-keys length) (. keys length))))
  )
  (fn-do _ scan-subclasses _
    (return-if (if subclass-scan-done))
    (blank)
    (= subclass-scan-done true)
    (let module 0u32)
    (for (in owner (. program modules))
      (let decl 0u32)
      (for (in row (. owner decls))
        (match? row
          (case .decl-class
            (call note-bases module decl)
          )
        )
        (+= decl 1)
      )
      (+= module 1)
    )
  )
  (fn-do _ interface-reaches Bool
    (param id TypeId)
    (param target Size)
    ; Whether an interface is derived from the one a declaration key names.
    (for (in interface (call interfaces-of id))
      (if (or (== (call class-decl-key interface) target) (call interface-reaches interface target))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ class-decl-key Size
    (param id TypeId)
    (match ([] rows id)
      (case (call .type-class row)
        (. (call DeclRef (. row module) (. row decl)) key)
      )
      (default
        (. Size max)
      )
    )
  )
  (fn-do _ note-bases _
    (param module ModuleId)
    (param decl DeclId)
    ; Marks the class a class declares as its base as one with subclasses, from the base as written:
    ; the class declared is not made for it, so a class nothing uses is never typed.
    (let base-syntax SyntaxId 0)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-class row)
        (= base-syntax (. row base))
      )
    )
    (if (== base-syntax 0)
      (return)
    )
    (let env (call class-env module decl))
    (let base (call evaluate-type module (. ([] (. program modules) module) tree) base-syntax env))
    (call env-release env)
    (let key (call class-decl-key base))
    (if (!= key (. Size max))
      (= ([] subclassed-decls key) true)
      (+= subclass-decls (call pack-decl module decl))
      (+= subclass-links (?? ([] subclass-heads key) 0))
      (= ([] subclass-heads key) (as (. subclass-decls length) U32))
    )
  )
)

(fn-expr + class-ref DeclRef
  (param types Types)
  (param type TypeId)
  (match ([] (. types rows) type)
    (case (call .type-class row)
      (call DeclRef (. row module) (. row decl))
    )
    (default
      (call DeclRef 0 0)
    )
  )
)

(fn-do + same-class Bool
  (param types Types)
  (param type TypeId)
  (param other TypeId)
  ; Whether two types are each a class, and the same class whatever the arguments of each.
  (match? ([] (. types rows) type)
    (case (call .type-class row)
      (match? ([] (. types rows) other)
        (case (call .type-class of)
          (return (and (== (. row module) (. of module)) (== (. row decl) (. of decl))))
        )
      )
    )
  )
  (return false)
)

(fn-do + function-row TypeId
  (param types Types)
  (param id TypeId)
  ; The function type a type is, or the one a class it derives from is, completing the classes it
  ; passes through; no type for any other.
  (match? ([] (. types rows) id)
    (case .type-function
      (return id)
    )
    (case .type-class
      (call (. types complete) id)
      (let base (call (. types base-of) id))
      (if base
        (return (call function-row types base))
      )
    )
  )
  (return no-type)
)

(fn-expr + carries-own-errors Bool
  (param types Types)
  (param id TypeId)
  ; Whether a type is a class whose value is a function that raises errors its declaration
  ; does not state, as the generator of a function that yields and raises is.
  (match ([] (. types rows) id)
    (case (call .type-class row)
      (!= (. row errors count) 0)
    )
    (default
      false
    )
  )
)

(fn-do + is-c-function Bool
  (param types Types)
  (param id TypeId)
  ; Whether a type is a C function's: a value of it is code alone, with no data beside it.
  (let fn (call function-row types id))
  (if (!= fn no-type)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (return (. row is-c))
      )
    )
  )
  (return false)
)

(fn-expr + class-arg TypeId
  (param types Types)
  (param id TypeId)
  (param index U32)
  (match ([] (. types rows) id)
    (case (call .type-class row)
      (if-expr (< index (. row args count)) (call (. types child-type) (. row args) index) no-type)
    )
    (default
      no-type
    )
  )
)

(fn-expr + row-union TypeId
  (param types Types)
  (param receiver TypeId)
  ; The union a table row is a row of, and no type for a row of anything else.
  (case? (and (!= kind .table-row) (!= kind .immutable-table-row))
    no-type
  )
  (case? (or (== row no-type) (!= (call (. types intrinsic-of) row) .union))
    no-type
  )
  (default
    row
  )
  (where
    (lazy kind (call (. types intrinsic-of) receiver))
    (lazy row (call class-arg types receiver 0))
  )
)

(type _ TypeTag (is U32)
  (variant invalid)
  (variant class)
  (variant tuple)
  (variant function)
  (variant variable)
  (variant inference)
  (variant struct)
  (variant union)
  (variant named-union)
  (variant result)
  (variant associated)
  (variant closure)
  (variant binding)
  (variant raising-class)
)

(type _ TypeBinding (is Tuple)
  (prop + module-name String)
  (prop + class-name String)
  (prop + type IntrinsicKind)
  (prop + is-builtin Bool)
)

(fn-expr _ pack-decl Size
  (param module ModuleId)
  (param decl DeclId)
  (/or/ (/lshift/ (as module Size) 32) (as decl Size))
)

(type _ GrowthGraph
  (prop + decls (list DeclRef))
  (prop + indexes (list U32))
  (prop + sources (list U32))
  (prop + targets (list U32))
  (prop + growing (list Bool))
  (prop + members (list TypeId))
  (fn-do + node U32
    (param decl DeclRef)
    (param index U32)
    (for (in at (..< 0 (. decls length)))
      (return-if (as at U32) (if (and (== ([] decls at) decl) (== ([] indexes at) index))))
    )
    (+= decls decl)
    (+= indexes index)
    (return (as (- (. decls length) 1) U32))
  )
  (fn-do + link _
    (param source U32)
    (param target U32)
    (param grows Bool)
    (param member TypeId)
    (+= sources source)
    (+= targets target)
    (+= growing grows)
    (+= members member)
  )
  (fn-do + cycles Bool
    (param owner DeclRef)
    (param member TypeId (= no-type))
    (for (in start (..< 0 (. decls length)))
      (if (!= ([] decls start) owner)
        (continue)
      )
      (let ahead (call reached (as start U32) true))
      (let behind (call reached (as start U32) false))
      (let grows false)
      (let through (== member no-type))
      (for (in edge (..< 0 (. sources length)))
        (let source ([] sources edge))
        (let target ([] targets edge))
        (if (and ([] ahead source) ([] behind source) ([] ahead target) ([] behind target))
          (= grows (or grows ([] growing edge)))
          (= through (or through (and (== ([] members edge) member) (== ([] decls source) owner))))
        )
      )
      (return-if true (if (and grows through)))
    )
    (return false)
  )
  (fn-do _ reached (list Bool)
    (param start U32)
    (param forward Bool)
    (let seen (list Bool))
    (for (in _ (..< 0 (. decls length)))
      (+= seen false)
    )
    (= ([] seen start) true)
    (let pending (list U32))
    (+= pending start)
    (while (!= (. pending length) 0)
      (let at ([] pending (- (. pending length) 1)))
      (call (. pending pop))
      (for (in edge (..< 0 (. sources length)))
        (let from (if-expr forward ([] sources edge) ([] targets edge)))
        (let to (if-expr forward ([] targets edge) ([] sources edge)))
        (if (and (== from at) (not ([] seen to)))
          (= ([] seen to) true)
          (+= pending to)
        )
      )
    )
    (return seen)
  )
)
