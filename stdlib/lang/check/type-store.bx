  (blank)
  (prop _ arena Arena)
  (prop _ sealed Bool)
  (prop _ reach-pending (list TypeId))
  (prop _ reach-visited (list Bool))
  (prop _ making (list TypeId))
  (prop _ completing U32)
  (prop _ atoms (of List Atom ArenaBacking))
  (prop _ env-names (of List Atom ArenaBacking))
  (prop _ env-types (of List TypeId ArenaBacking))
  (prop _ env-constrained (of List TypeId ArenaBacking))
  (prop _ env-constraints (of List TypeId ArenaBacking))
  (prop _ index-atoms (of List Atom ArenaBacking))
  (prop _ resolving (of List U32 ArenaBacking))
  (prop _ property-scratch (of Table TypeProperty))
  (prop _ property-places (of Map MemberKey U32 ArenaBacking))
  (prop _ scratch-places (of Map MemberKey U32 ArenaBacking))
  (prop _ stored-count U32)
  (prop _ case-scratch (of Table TypeCase))
  (prop _ associated-scratch (of Table TypeAssociated))
  (prop _ keys IdMap)
  (prop _ key-scratch (of Array U32 ArenaBacking))
  (prop _ types-by-decl (of Map Size U32 ArenaBacking))
  (prop _ rows-by-type (of Map Size U32 ArenaBacking))
  (prop _ builtin-decls (of Map Size U32 ArenaBacking))
  (prop _ map-atom (? Atom))
  (prop _ stream-atom (? Atom))
  (prop _ subclassed-decls (of Map Size Bool ArenaBacking))
  (prop _ subclass-heads (of Map Size U32 ArenaBacking))
  (prop _ subclass-decls (list Size))
  (prop _ subclass-links (list U32))
  (prop _ subclass-scan-done Bool)
  (fn-do + This _
    (param program Program)
    (param scratch TypingScratch)
    (throw (call Panic "Types must intern the invalid type at id zero") (if (!= (call intern-invalid) invalid-type)))
    (blank)
    (= void-type invalid-type)
    (= bool-type invalid-type)
    (= null-type invalid-type)
    (= char8-type invalid-type)
    (= f64-type invalid-type)
    (= string-type invalid-type)
    (= generator-decl (call DeclRef 0 0))
    (= list-decl (call DeclRef 0 0))
    (blank)
    (lazy rows (call (of Table TypeData) arena 16))
    (lazy completions (call (of Table TypeCompletion) arena 16))
    (lazy stable-keys (call (of List StableKey) arena))
    (lazy ranked (call (of Array TypeId) arena 0))
    (lazy children (call (of Scratch TypeId) arena 1024))
    (lazy atoms (call (of List Atom) arena))
    (lazy env-names (call (of List Atom) arena))
    (lazy env-types (call (of List TypeId) arena))
    (lazy env-constrained (call (of List TypeId) arena))
    (lazy env-constraints (call (of List TypeId) arena))
    (lazy index-atoms (call (of List Atom) arena))
    (lazy resolving (call (of List U32) arena))
    (lazy properties (call (of Table TypeProperty) arena 16))
    (lazy cases (call (of Table TypeCase) arena 16))
    (lazy associated-types (call (of Table TypeAssociated) arena 16))
    (lazy unit-families (call UnitFamilies))
    (lazy property-scratch (call (of Table TypeProperty) arena 16))
    (lazy property-places (call (of Map MemberKey U32) arena))
    (lazy scratch-places (call (of Map MemberKey U32) arena))
    (lazy case-scratch (call (of Table TypeCase) arena 16))
    (lazy associated-scratch (call (of Table TypeAssociated) arena 16))
    (lazy key-scratch (call (of Array U32) arena 16))
    (lazy types-by-decl (call (of Map Size U32) arena))
    (lazy rows-by-type (call (of Map Size U32) arena))
    (lazy builtin-decls (call (of Map Size U32) arena))
    (lazy subclassed-decls (call (of Map Size Bool) arena))
    (lazy subclass-heads (call (of Map Size U32) arena))
    (lazy checked-classes (call (of Map Size U32) arena))
    (lazy growth (call (of Map Size U8) arena))
    (lazy c-function-decls (call (of Map Size U64) arena))
    (lazy placed (call (of Map Size U64) arena))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-expr + is-sealed Bool :get
    sealed
  )
  (fn-expr + builtin-classes BuiltinClasses :get
    (call BuiltinClasses (call type-decl .optional) (call type-decl .type-info) (call type-decl .number))
  )
  (fn-do + release _
    (call (. keys release))
    (call (. arena release))
  )
  (fn-do + reach _
    (param id TypeId)
    ; Marks a type the typing state still names as a seal root. Duplicates and the absent type
    ; are dropped here so the callers can offer every column they hold without sorting it.
    (if (== id no-type)
      (return)
    )
    (while (<= (. reach-visited length) id)
      (+= reach-visited false)
    )
    (if ([] reach-visited id)
      (return)
    )
    (= ([] reach-visited id) true)
    (+= reach-pending id)
  )
  (fn-do + seal _
    ; Completes every reached type and everything a completed type refers to, including the types
    ; completion itself interns on the way, and then refuses to intern or complete anything more,
    ; so the store can outlive the syntax trees and the typing scratch that completion reads.
    (while (!= (. reach-pending length) 0)
      (let last (- (. reach-pending length) 1))
      (let id ([] reach-pending last))
      (-= ([] reach-pending (..< last (. reach-pending length))))
      (call complete id)
      (call reach-children id)
    )
    (call rank)
    (= sealed true)
  )
  (fn-do + forget-module _
    (param forgotten ModuleId)
    (let dropped (list Size))
    (for (in (tuple closure _) placed)
      (match? ([] rows (as closure TypeId))
        (case (call .type-closure row)
          (if (== (. row module) forgotten)
            (+= dropped closure)
          )
        )
      )
    )
    (for (in closure dropped)
      (-= ([] placed closure))
    )
  )
  (fn-do + unseal _
    (= sealed false)
  )
  (fn-expr + env-frame TypeEnv
    (call TypeEnv (. env-names length) (. env-names length) (. env-constrained length) (. env-constrained length))
  )
  (fn-do + env-bind TypeEnv
    (param env TypeEnv)
    (param name Atom)
    (param type TypeId)
    (throw (call Panic "TypeEnv binding below the top frame") (if (!= (. env end) (. env-names length))))
    (blank)
    (+= env-names name)
    (+= env-types type)
    (return (call TypeEnv (. env start) (. env-names length) (. env constraint-start) (. env constraint-end) (. env this-type)))
  )
  (fn-do + env-constrain TypeEnv
    (param env TypeEnv)
    (param type TypeId)
    (param constraint TypeId)
    (throw (call Panic "TypeEnv constraint below the top frame") (if (!= (. env constraint-end) (. env-constrained length))))
    (blank)
    (+= env-constrained type)
    (+= env-constraints constraint)
    (return (call TypeEnv (. env start) (. env end) (. env constraint-start) (. env-constrained length) (. env this-type)))
  )
  (fn-expr + env-with-this TypeEnv
    (param env TypeEnv)
    (param this-type TypeId)
    (call TypeEnv (. env start) (. env end) (. env constraint-start) (. env constraint-end) this-type)
  )
  (fn-do + env-lookup (? TypeId)
    (param env TypeEnv)
    (param name Atom)
    (for (in reverse (..< 0 (- (. env end) (. env start))))
      (let position (- (. env end) 1 reverse))
      (if (== ([] env-names position) name)
        (return ([] env-types position))
      )
    )
    (return null)
  )
  (fn-do + env-lookup-from (? TypeId)
    (param env TypeEnv)
    (param name Atom)
    (param first Size)
    (for (in reverse (..< 0 (- (. env end) first)))
      (let position (- (. env end) 1 reverse))
      (if (== ([] env-names position) name)
        (return ([] env-types position))
      )
    )
    (return null)
  )
  (fn-expr + env-name Atom
    (param position Size)
    ([] env-names position)
  )
  (fn-do + env-within TypeEnv
    (param env TypeEnv)
    ; A frame on top that holds what an environment below it binds and constrains, in its order,
    ; and the type it reads `This` as, for what is read inside what that environment is read for.
    (let made (call env-frame))
    (for (in position (..< (. env start) (. env end)))
      (= made (call env-bind made ([] env-names position) ([] env-types position)))
    )
    (for (in position (..< (. env constraint-start) (. env constraint-end)))
      (= made (call env-constrain made ([] env-constrained position) ([] env-constraints position)))
    )
    (return (call env-with-this made (. env this-type)))
  )
  (fn-do + env-release _
    (param env TypeEnv)
    (-= ([] env-names (..< (. env start) (. env-names length))))
    (-= ([] env-types (..< (. env start) (. env-types length))))
    (-= ([] env-constrained (..< (. env constraint-start) (. env-constrained length))))
    (-= ([] env-constraints (..< (. env constraint-start) (. env-constraints length))))
  )
  (fn-do + env-truncate _
    (param env TypeEnv)
    (-= ([] env-names (..< (. env end) (. env-names length))))
    (-= ([] env-types (..< (. env end) (. env-types length))))
  )
  (fn-do + index-atom Atom
    (param position Size)
    (while (<= (. index-atoms length) position)
      (let next (. index-atoms length))
      (+= index-atoms (call (. program store-atom) (str next)))
    )
    (return ([] index-atoms position))
  )
  (fn-do + total-key-words Size
    (let total Size 0)
    (for (in index (..< 0 (. keys length)))
      (+= total (call (. keys key-count) index))
    )
    (return total)
  )
  (fn-expr + child-type TypeId
    (param range (of RowRange TypeId))
    (param offset U32)
    (before
      (throw (call OutOfBoundsError "Types child offset out of bounds") (if (>= offset (. range count))))
    )
    ([] children (+ (. range start) offset))
  )
  (fn-expr + child-name Atom
    (param range (of RowRange Atom))
    (param offset U32)
    (before
      (throw (call OutOfBoundsError "Types name offset out of bounds") (if (>= offset (. range count))))
    )
    ([] atoms (+ (. range start) offset))
  )
  (fn-do + bind-types _
    (for (in binding type-bindings)
      (let module (call (. program module-by-name) (. binding module-name)))
      (if module
        (let owner U32 (as module U32))
        (let decl (call class-decl-named owner (. binding class-name)))
        (if decl
          (= ([] types-by-decl (call pack-decl owner decl)) (. binding type))
          (if (. binding is-builtin)
            (= ([] builtin-decls (call pack-decl owner decl)) 1)
          )
          (let mark (. scratch types mark))
          (let id (call intern-class owner decl mark))
          (if (not ([] rows-by-type (. binding type)))
            (= ([] rows-by-type (. binding type)) id)
          )
        )
      )
    )
    (blank)
    (= void-type (call type-row .void))
    (= bool-type (call type-row .bool))
    (= f64-type (call type-row .float64))
    (= string-type (call type-row .string))
    (= null-type (call well-known-type "core" "Null"))
    (= error-type (call well-known-type "core/error" "Error"))
    (= panic-type (call well-known-type "core/error" "Panic"))
    (= termination-type (call well-known-type "core/error" "TaskTerminationError"))
    (= cancelation-type (call well-known-type "core/error" "TaskCancelationError"))
    (= union-error-type (call well-known-type "core/error" "UnionError"))
    (= live-action-type (call well-known-type "core/tracker" "LiveAction"))
    (= match-location-type (call well-known-type "core/parsing" "MatchLocation"))
    (= pattern-capture-range-type (call well-known-type "core/parsing" "PatternCaptureRange"))
    (= token-location-type (call well-known-type "core/parsing" "TokenLocation"))
    (= char8-type (call well-known-type "core/number" "Char8"))
    (= generator-decl (call well-known-decl "core/stream" "Generator"))
    (= list-decl (call well-known-decl "core/list" "List"))
    (= map-decl (call well-known-decl "core/map" "Map"))
    (= range-decl (call well-known-decl "core/range" "Range"))
    (= array-decl (call well-known-decl "core/array" "Array"))
    (= readable-array-decl (call well-known-decl "core/array" "ReadableArray"))
    (= immutable-array-decl (call well-known-decl "core/array" "ImmutableArray"))
    (= array-rows-decl (call well-known-decl "core/array" "ArrayRows"))
    (= array-row-range-decl (call well-known-decl "core/array" "ArrayRowRange"))
    (= array-fields-decl (call well-known-decl "core/array" "ArrayFields"))
    (= array-field-decl (call well-known-decl "core/array" "ArrayField"))
    (= array-row-decl (call well-known-decl "core/array" "ArrayRow"))
    (= array-read-access (call well-known-type "core/array" "ArrayReadAccess"))
    (= array-write-access (call well-known-type "core/array" "ArrayWriteAccess"))
    (= gc-backing-type (call well-known-type "core/backing" "GCBacking"))
    (= arena-backing-type (call well-known-type "core/arena" "ArenaBacking"))
    (= stream-decl (call well-known-decl "core/stream" "Stream"))
    (= iterable-decl (call well-known-decl "core/stream" "Iterable"))
    (= indexable-decl (call well-known-decl "core/stream" "Indexable"))
    (= cursor-iterable-decl (call well-known-decl "core/stream" "CursorIterable"))
    (= const-array-decl (call well-known-decl "core" "ConstArray"))
