(prop _ property-scan-limit _ (= 8))
(prop _ type-bindings List
  (block
    (item (call TypeBinding "core" "Void" .void true))
    (item (call TypeBinding "core" "CPointer" .cpointer))
    (item (call TypeBinding "core" "CFunction" .cfunction))
