  (prop + core-module ModuleId (= (. U32 max)))
  (prop + intrinsics-module ModuleId (= (. U32 max)))
  (prop + table-module ModuleId (= (. U32 max)))
  (prop + function-atom (? Atom))
  (prop + cfunction-atom (? Atom))
