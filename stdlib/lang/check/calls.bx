(import ./binding)
(import ./claims)
(import ./conversions)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./instances)
(import ./numeric)
(import ./signature)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/viability)
(import /stream/sort)

(type + RowCapture (is Tuple)
  ; What a name a pattern binds to the case of a row of a table of unions stands for: the row's
  ; type, the number of the case, and whether TypeScript checked the row's storage where the
  ; pattern read it, as its cursor holds.
  (blank)
  (prop + row TypeId)
  (prop + case-index U32)
  (prop + validated Bool)
)

(type + Arguments (is Tuple)
  ; A call site's arguments as the dispatcher sees them: the shape of each argument, its inferred
  ; type, its syntax, and any explicit type arguments. Where a value is piped into the call, `piped`
  ; is the call, which the argument piped has as its syntax. A markup element's call also gives its
  ; constructor the slots its body fills, each with the type of the builder it is given
  ; (`builders`), and the context of the styles the element sees (`context`).
  (blank)
  (prop + shapes (of ImmutableArray CallArgument ArenaBacking))
  (prop + types (of ImmutableArray TypeId ArenaBacking))
  (prop + syntax (of ImmutableArray SyntaxId ArenaBacking))
  (prop + params (of ImmutableArray TypeId ArenaBacking))
  (prop + curried Bool (= false))
  (prop + piped SyntaxId (= 0))
  (prop + slots (of ImmutableArray Atom ArenaBacking) (= (call (of ImmutableArray Atom ArenaBacking))))
  (prop + builders (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
  (prop + context U32 (= (. U32 max)))
)

(type + CallSite (is Tuple)
  ; The marks of a synthesized call site's runs on the scratch stacks.
  (blank)
  (prop + shapes-mark ScratchMark)
  (prop + types-mark ScratchMark)
  (prop + syntax-mark ScratchMark)
  (prop _ scratch TypingScratch)
  (fn-expr + shapes (of ImmutableArray CallArgument ArenaBacking) :get
    (call (. scratch call-arguments since) shapes-mark)
  )
  (fn-expr + types (of ImmutableArray TypeId ArenaBacking) :get
    (call (. scratch types since) types-mark)
  )
  (fn-expr + syntax (of ImmutableArray SyntaxId ArenaBacking) :get
    (call (. scratch syntax since) syntax-mark)
  )
)

(type + ProtocolCall (is Tuple)
  ; A call of a method the compiler makes on a value without a call in the source: the call
  ; recorded, or none where the receiver has no such method, what the method answers, and the type
  ; it takes its argument as.
  (blank)
  (prop + fact FactId (= no-fact))
  (prop + answer TypeId (= no-type))
  (prop + taken TypeId (= no-type))
)

(type + Construction (is Tuple)
  ; A constructor a call has chosen, which the call interns once its arguments are settled
  ; (`intern-settled`), with what it gives the constructor apart from its arguments: the properties
  ; a markup element sets that name no parameter (`fills`), the context of the styles it sees, and
  ; the slots its body fills, each with the type of its builder.
  (blank)
  (prop + module ModuleId (= 0))
  (prop + decl DeclId (= 0))
  (prop + receiver TypeId (= no-type))
  (prop + fills Bool)
  (prop + context U32 (= (. U32 max)))
  (prop + slots (of ImmutableArray Atom ArenaBacking) (= (call (of ImmutableArray Atom ArenaBacking))))
  (prop + builders (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
)

(type + Calls
  (prop + frame Frame)
  (prop + host (? Demander) (= null))
  (prop + conversions Conversions)
  (prop + ranking Ranking)
  (prop _ delegator TypeId (= no-type))
  (prop _ interning (? RowCapture) (= null))
  (prop _ constructing Construction (= (call Construction)))
  (prop _ forward-row TypeId (= no-type))
  (prop _ unsettled-sites (list SyntaxId))
  (prop _ unsettled-names (list Atom))
  (prop _ unfound-sites (list SyntaxId))
  (prop _ types Types)
  (prop _ instances Instances)
  (prop _ relations Relations)
  (prop _ facts Facts)
  (prop _ program Program)
  (prop _ scratch TypingScratch)
  (prop _ records-pairs _ (= true))
  (fn-do + This _
    (param frame Frame)
    (param conversions Conversions)
    (lazy types (. frame types))
    (lazy relations (. frame relations))
    (lazy scratch (. frame scratch))
    (lazy instances (. frame instances))
    (lazy facts (. frame facts))
    (lazy program (. frame program))
    (lazy ranking (call Ranking (. frame session) (. frame module)))
  )
  (fn-do + begin _
    (= host null)
    (= records-pairs true)
    (call (. unsettled-sites clear))
    (call (. unsettled-names clear))
    (call (. unfound-sites clear))
    (call (. ranking rebind) (. frame module))
  )
  (fn-do + attach _
    (param demander Demander)
    (= host demander)
    (= (. ranking host) demander)
    (= (. ranking conversions) conversions)
    (= (. conversions fitter) ranking)
  )
  (fn-do _ note-outgoing _
    (param error TypeId)
    (param syntax SyntaxId)
    ; An error leaving the function at a node, which the checker attached hears of first.
    (if host
      (call (. host note-outgoing) error syntax)
      (else
        (call (. frame note-outgoing) error syntax)
      )
    )
  )
  (fn-do _ defer-outgoing _
    (param callee InstanceId)
    (param syntax SyntaxId)
    (if host
      (call (. host defer-outgoing) callee syntax)
      (else
        (call (. frame defer-outgoing) callee syntax)
      )
    )
  )
  (fn-do _ local-ranking Ranking
    (param module ModuleId)
    ; A ranking of its own, for a call ranked apart from the one being ranked, which has what is
    ; attached to type what it asks for.
    (let local (call Ranking (. frame session) module))
    (= (. local host) host)
    (= (. local conversions) (only-if conversions (if host)))
    (return local)
  )
  (fn-do + suspend-ranking (? Ranking)
    ; A ranking in the middle of a dispatch must not be reused: typing a closure argument can come
    ; back to this function for a lazy variable, whose value has calls of its own.
    (if (not (. ranking active))
      (return null)
    )
    (let busy ranking)
    (= ranking (call local-ranking (. frame module)))
    (return busy)
  )
  (fn-do + resume-ranking _
    (param busy (? Ranking))
    (if busy
      (= ranking busy)
    )
  )
  (fn-do + function-call TypeId
    (param id SyntaxId)
    (param name Atom)
    (param arguments Arguments)
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (let hit (call (. ranking dispatch-function) (. frame self-type) name))
    (call note-interface-call (. frame self-type) hit)
    (if (and hit (!= (. hit receiver) no-type) (!= (. hit receiver) (. frame self-type)) (not (call (. ranking ambiguity))))
      (let delegated (call (. ranking delegates-to) (. frame self-type) (. hit receiver)))
      (if delegated
        (= delegator (. frame self-type))
      )
      (if (and (not delegated) (call intrinsic-is-class (. ([] (. types completions) (. hit receiver)) intrinsic)))
        (call (. conversions convert) id id (. frame self-type) (. hit receiver) .reason-own-receiver)
      )
    )
    (if (and hit (!= (. hit receiver) no-type) (call is-virtual-receiver (. frame self-type)))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (if (and (not hit) (. arguments curried) (. ranking partial))
      (let owner (. ranking partial receiver))
      (let form (if-expr (== owner no-type) (. BindingForm bound-function) (. BindingForm bound-method)))
      (return (call bind-partial form owner arguments))
    )
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg .call-function)
          (arg (. arguments syntax))
          (arg .function-not-found)
          (arg hit)
          (arg name)
          (arg 0)
          (arg (. frame self-type))
          (arg (. arguments piped))
        )
      )
    )
    (call (. ranking release))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (let answered (call intrinsic-plan callee))
    (if (and (== answered .plan-count-leading-zeros) (not (call counts-integer callee)))
      (let message "count-leading-zeros requires an integer argument")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (and object-plan (!= (call (. types intrinsic-of) (call (. instances param-type) callee 0)) .class))
      (let message "gc-object-from-pointer requires a class object type")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (lazy object-plan (== answered .plan-object-from-pointer))
    (if (and witness-plan (!= (call (. types intrinsic-of) (call (. instances argument-type) callee 0)) .interface))
      (let message "interface-witness-pointer requires an interface value")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (lazy witness-plan (== answered .plan-witness-pointer))
    (if (and interface-plan (!= (call (. types intrinsic-of) (call (. instances param-type) callee 0)) .interface))
      (let message "gc-interface-from-pointer requires an interface type")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (lazy interface-plan (== answered .plan-interface-from-pointer))
    (if (and (!= answered .plan-side-payload) (!= answered .plan-publish-side-payload))
      (if (!= answered .plan-none)
        (call (. facts set-plan) (. frame instance) id answered)
      )
      (return (call demand-return callee id))
    )
    (let returned (call demand-return callee id))
    (let given (if-expr (and (!= returned invalid-type) (!= returned no-type)) returned no-type))
    (let payload
      (scope (if-expr (and (== answered .plan-side-payload) (!= given no-type)) unwrapped given)
        (lazy unwrapped (call (. types optional-inner) given))
      )
    )
    (if (or (== payload no-type) (!= (call (. types intrinsic-of) payload) .class))
      (let message "GC object side payload intrinsics require a class payload type")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (call (. facts set-plan) (. frame instance) id answered)
    (return returned)
  )
  (fn-do _ stores-untraced Bool
    (param callee InstanceId)
    ; Whether a function is the one the arena module declares with no body for a pointer, which
    ; stores an item where the collector does not look. The compiler answers a call of it.
    (let row ([] (. instances rows) callee))
    (if (or (!= (. row module) (. types arena-module)) (== (. row self-type) no-type))
      (return false)
    )
    (if (!= (call (. types intrinsic-of) (. row self-type)) .cpointer)
      (return false)
    )
    (let target ([] (. program modules) (. row module)))
    (match? ([] (. target decls) (. row decl))
      (case (call .decl-function fn)
        (if (or (== (. fn owner) 0) (not (. fn name)) (!= (. fn name) (!! (. types store-untraced-atom))))
          (return false)
        )
        (if (== (. fn body) 0)
          (return true)
        )
        (match? ([] (. target tree nodes) (. fn body))
          (case (call .node-block body)
            (return (== (. body body count) 0))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + arena-traces Bool
    (param type TypeId)
    ; Whether a value of a type holds what an arena must tell the collector of: anything but
    ; numbers, text, atoms, pointers and the marks of a table, inside any tuple, struct, optional
    ; or case of a union that holds them.
    (if (or (== type no-type) (== type invalid-type))
      (return true)
    )
    (let completion (call (. types completion-of) type))
    (let kind (. completion intrinsic))
    (if (or (call intrinsic-is-numeric kind) (== kind .void) (== kind .string) scalar)
      (return false)
    )
    (lazy scalar (or (== kind .cpointer) (== kind .bool) (== kind .char)))
    (if (or (== kind .atom) (== kind .table-mark))
      (return false)
    )
    (if (== kind .optional)
      (return (call arena-traces (call (. types optional-inner) type)))
    )
    (if (== kind .union)
      (for (in fact ([] (. types cases) (. completion cases)))
        (if (and (!= (. fact type) no-type) (call arena-traces (. fact type)))
          (return true)
        )
      )
      (return false)
    )
    (if (not (call intrinsic-is-tuple-like kind))
      (return true)
    )
    (let range (. completion properties))
    (for (in offset (..< 0 (. range count)))
      (if (call arena-traces (. ([] (. types properties) (+ (. range start) offset)) type))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ counts-integer Bool
    (param callee InstanceId)
    ; Whether the one argument of a count of leading zeros is an integer.
    (and (!= counted no-type) (!= counted invalid-type) integral)
    (where
      (lazy counted (call (. instances argument-type) callee 0))
      (lazy integral (call is-integer-kind (. ([] (. types completions) counted) intrinsic)))
    )
  )
  (fn-expr _ answered-in-place Bool
    (param callee InstanceId)
    ; Whether the compiler answers a call of the callee with no call of its own.
    (call is-in-place-plan (call intrinsic-plan callee))
  )
  (fn-do + intrinsic-plan OperatorPlan
    (param callee InstanceId)
    ; The plan of a call the compiler answers itself: of a function with no body that the
    ; intrinsics module declares, or of one of the four of the math module that take floats.
    (let row ([] (. instances rows) callee))
    (let target ([] (. program modules) (. row module)))
    (match? ([] (. target decls) (. row decl))
      (case (call .decl-function fn)
        (if (or (!= (. fn body) 0) (not (. fn name)) (!= (. fn owner) 0))
          (return .plan-none)
        )
        (let name (. fn name text))
        (if (== (. row module) (. types intrinsics-module))
          (let written (. fn name))
          (if (== written (!! (. types count-leading-zeros-atom)))
            (return .plan-count-leading-zeros)
          )
          (if (== written (!! (. types side-payload-atom)))
            (return .plan-side-payload)
          )
          (if (== written (!! (. types publish-side-payload-atom)))
            (return .plan-publish-side-payload)
          )
          (if (== written (!! (. types object-from-pointer-atom)))
            (return .plan-object-from-pointer)
          )
          (if (== written (!! (. types invoke-lowered-atom)))
            (call (. instances mark-may-panic) (. frame instance))
            (return .plan-invoke-lowered)
          )
          (if (== written (!! (. types witness-pointer-atom)))
            (return .plan-witness-pointer)
          )
          (if (== written (!! (. types interface-from-pointer-atom)))
            (return .plan-interface-from-pointer)
          )
        )
        (if (!= (. target name) "math")
          (return .plan-none)
        )
        (let signature ([] (. instances signatures) callee))
        (let float (call (. types type-row) .float64))
        (for (in position (..< 0 (. signature args count)))
          (if (!= (call (. instances argument-type) callee position) float)
            (return .plan-none)
          )
        )
        (if (and (== name "sqrt") (== (. signature args count) 1))
          (return .plan-f64-sqrt)
        )
        (if (and (== name "abs") (== (. signature args count) 1))
          (return .plan-f64-abs)
        )
        (if (and (== name "min") (== (. signature args count) 2))
          (return .plan-f64-min)
        )
        (if (and (== name "max") (== (. signature args count) 2))
          (return .plan-f64-max)
        )
      )
    )
    (return .plan-none)
  )
  (fn-expr + is-virtual-receiver Bool
    (param receiver TypeId)
    ; Whether a call on a receiver of this type is chosen by the class of the object: the type is
    ; a class written in source that some class is derived from. Such a call may panic whatever
    ; the function named does, because the one chosen may.
    (case? (or (== receiver no-type) (== receiver invalid-type))
      false
    )
    (case? (or (!= (. completion intrinsic) .class) (. completion is-builtin))
      false
    )
    (default
      (call (. types has-subclasses) receiver)
    )
    (where
      (lazy completion (call (. types completion-of) receiver))
    )
  )
  (fn-do + c-call TypeId
    (param id SyntaxId)
    (param name Atom)
    (param arguments Arguments)
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (let hit (call (. ranking dispatch-c-function) name))
    (if (and (not hit) (. arguments curried) (. ranking partial))
      (return (call bind-partial .bound-c-function no-type arguments))
    )
    (= records-pairs (not (call (. name text starts-with) "brix")))
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg .call-function)
          (arg (. arguments syntax))
          (arg .function-not-found)
          (arg hit)
          (arg name)
          (arg 0)
          (arg no-type)
          (arg (. arguments piped))
        )
      )
    )
    (= records-pairs true)
    (call (. ranking release))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (if (== name (!! (. types bench-collect-atom)))
      (call (. facts set-plan) (. frame instance) id .plan-elided)
    )
    (call note-described id name)
    (call check-zone-call id name callee)
    (call check-claim id name)
    (return (call demand-return callee id))
  )
  (fn-do _ check-claim _
    (param id SyntaxId)
    (param name Atom)
    ; A C function an effect claims is called only by a door of that effect, or by a function written
    ; in one. One that two effects claim is called by neither's.
    (let table (. program effects))
    (return-if (if (== (. table count) 0)))
    (blank)
    (let claimed ([] (. table claims) name))
    (return-if (if (not claimed)))
    (blank)
    (let contested ([] (. table contested) name))
    (if contested
      (let first (. ([] (. table names) claimed) text))
      (let second (. ([] (. table names) contested) text))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg (str "'C:" (. name text) "' is claimed by both the '" first "' and the '" second "' effect"))
              )
            )
          )
        )
      )
      (return)
    )
    (let outer (. frame instance))
    (while (!= (. ([] (. instances rows) outer) enclosing) no-instance)
      (= outer (. ([] (. instances rows) outer) enclosing))
    )
    (let row ([] (. instances rows) outer))
    (return-if (if (== (call (. table door-of) (. row module) (. row decl)) claimed)))
    (blank)
    (let effect (. ([] (. table names) claimed) text))
    (call (. frame diagnose)
      (block
        (arg id)
        (arg .stated)
        (arg
          (call (. program store-atom)
            (block
              (arg (str "'C:" (. name text) "' belongs to the '" effect "' effect, so only its doors may call it"))
            )
          )
        )
      )
    )
  )
  (fn-do _ check-zone-call _
    (param id SyntaxId)
    (param name Atom)
    (param callee InstanceId)
    ; A C call of a function that may suspend the task, where the code may not suspend, and one
    ; that may allocate from the collector, where the heap may not be used, are reported at the
    ; call: in a GC-free zone, naming where it is entered, or under `without suspend` or `without heap`.
    ; What a function may do is its claim (`claims.bx`), and one that polls the collector and has
    ; none is taken to do both.
    (let polls false)
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= polls (!= (/and/ (. fn effects) (. CompilationEffect gc-polling)) 0))
      )
    )
    (if (call may-suspend (. name text) polls)
      (call (. frame check-suspends) id)
    )
    (if (call may-allocate (. name text) polls)
      (call (. frame check-allocates) id)
    )
  )
  (fn-do _ note-described _
    (param id SyntaxId)
    (param name Atom)
    ; Plans a C call that allocates, resizes or copies the storage of an array the collector
    ; owns, with the type of the array's items. So too a call of an arena's own that reserves
    ; or copies storage for items of a type the arena traces, as TypeScript reserves and copies
    ; the storage of an `ArrayBuilder` an arena backs: the type is the parameter the function
    ; names `Value` or `Item`.
    (let item no-type)
    (if (or (== name (!! (. types allocate-buffer-atom))) (== name (!! (. types resize-buffer-atom))) slice-copy)
      (= item (call collected-item (. frame self-type)))
    )
    (lazy slice-copy (== name (!! (. types copy-slice-atom))))
    (if (and (== item no-type) (or (== name (!! (. types arena-reserve-atom))) (== name (!! (. types copy-slice-atom)))))
      (= item (call arena-item (. frame self-type)))
    )
    (if (and (!= item no-type) (!= item invalid-type) (not (. ([] (. types completions) item) has-variables)))
      (call (. facts set-constant) (. frame instance) id (call ConstantFact item 0 null false) .plan-described)
    )
  )
  (fn-expr _ arena-item TypeId
    (param owner TypeId)
    ; The type of the items an arena's function reserves storage for, where the arena traces
    ; them.
    (case? (or (== owner no-type) (== owner invalid-type) (not (call (. types is-arena) owner)))
      no-type
    )
    (case? (or (== item no-type) (== item invalid-type) (not (call arena-traces item)))
      no-type
    )
    (default
      item
    )
    (where
      (lazy item (?? (call (. types env-lookup) (. frame env) (!! (. types value-type-atom))) (call (. types env-lookup) (. frame env) (!! (. types item-atom))) no-type))
    )
  )
  (fn-do _ collected-item TypeId
    (param owner TypeId)
    ; The type of the items of the storage the functions of a class allocate from the collector:
    ; those of the backing that does so, for the type parameter the function names `Item`, and
    ; those of an array held by that backing.
    (if (or (== owner no-type) (== owner invalid-type) (== (. types gc-backing-type) invalid-type))
      (return no-type)
    )
    (if (== owner (. types gc-backing-type))
      (return (?? (call (. types env-lookup) (. frame env) (!! (. types item-atom))) no-type))
    )
    (let immutable (call (. types ancestor-of) owner (. types immutable-array-decl)))
    (let array (if-expr (!= immutable no-type) immutable (call (. types ancestor-of) owner (. types array-decl))))
    (if (== array no-type)
      (return no-type)
    )
    (match? ([] (. types rows) array)
      (case (call .type-class row)
        (if (and (== (. row args count) 2) (== (call (. types child-type) (. row args) 1) (. types gc-backing-type)))
          (return (call (. types child-type) (. row args) 0))
        )
      )
    )
    (return no-type)
  )
  (fn-do + generator-call TypeId
    (param id SyntaxId)
    (param callee InstanceId)
    ; The one call of a comprehension's closure, passing the container: a closure call for the
    ; panic rules, with the callee's errors propagating like any call.
    (call (. facts record-call) (. frame instance) id callee .call-closure (. scratch no-fills) false)
    (return (call demand-return callee id))
  )
  (fn-do + slot-call TypeId
    (param id SyntaxId)
    (param callee TypeId)
    (param arguments Arguments)
    (if (== callee invalid-type)
      (return invalid-type)
    )
    (if (== (. ([] (. types completions) callee) intrinsic) .binding)
      (return (call binding-call id callee arguments))
    )
    (if (== (. ([] (. types completions) callee) intrinsic) .closure)
      (if (< (. arguments types length) (call closure-arity callee))
        (return (call bind-values .bound-closure callee arguments))
      )
      (let tail (call closure-tail callee))
      (if (!= tail (. U32 max))
        (return (call tail-closure-call id callee arguments tail))
      )
      (let passed (list TypeId))
      (for (in position (..< 0 (. arguments types length)))
        (+= passed (call closure-argument callee position arguments))
      )
      (let given-mark (. scratch types mark))
      (for (in type passed)
        (call (. scratch types push) type)
      )
      (let lambda (call (. (!! host) demand-lambda) callee (call (. scratch types since) given-mark)))
      (call (. scratch types rewind) given-mark)
      (if (== lambda no-instance)
        (return invalid-type)
      )
      (call (. facts record-call) (. frame instance) id lambda .call-closure (. scratch no-fills) false)
      (call (. frame forget-members))
      (return (call demand-return lambda id))
    )
    (return (call value-call id callee (call (of RowRange TypeId)) arguments))
  )
  (fn-do + builder-call TypeId
    (param id SyntaxId)
    (param builder TypeId)
    (param takes U32 (= 0))
    ; A call of what a value of a function type that takes `takes` arguments holds, which no call in
    ; the source writes, as a slot outlet calls the function that builds its slot: what it answers,
    ; each error the type carries leaving the function at the call, as at a call of such a value
    ; written in source. What runs is not known, so it may panic.
    (call (. types complete) builder)
    (let fn (call function-row types builder))
    (if (== fn no-type)
      (return invalid-type)
    )
    (let returns no-type)
    (let count U32)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= returns (. row return-type))
        (= count (. row args count))
      )
    )
    (if (!= count takes)
      (return invalid-type)
    )
    (if (not (call admits-value-call id))
      (return invalid-type)
    )
    (call (. facts record-call) (. frame instance) id no-instance .call-closure (. scratch no-fills) false)
    (call (. instances mark-may-panic) (. frame instance))
    (let carried (call carried-result types builder))
    (if (!= carried no-type)
      (return (call raised-call id fn carried))
    )
    (return (if-expr (== returns no-type) (. types void-type) returns))
  )
  (fn-do _ value-call TypeId
    (param id SyntaxId)
    (param callee TypeId)
    (param held (of RowRange TypeId))
    (param arguments Arguments)
    ; Calls a value of a function type. Each argument takes a place the type declares: a named one
    ; the place of that name, the others the places left, in turn. A binding of the value holds
    ; the arguments given so far in their places, with the void type where a place is unfilled,
    ; and a call that leaves places unfilled gives such a binding. An argument of the void type
    ; fills its place as any other does. The call records which argument written fills each
    ; place, whether it calls or binds. An integer written with no suffix takes the type of its
    ; place. A type that carries errors answers with them, never with those of what the value
    ; holds.
    (call (. types complete) callee)
    (let fn (call function-row types callee))
    (if (== fn no-type)
      (call (. frame diagnose) id .not-supported)
      (return invalid-type)
    )
    (let args (call (of RowRange TypeId)))
    (let returns no-type)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= args (. row args))
        (= returns (. row return-type))
      )
    )
    (let unfilled (. types void-type))
    (let places (list TypeId))
    (let filled (list Bool))
    (for (in offset (..< 0 (. args count)))
      (let kept (if-expr (< offset (. held count)) (call (. types child-type) held offset) unfilled))
      (+= places kept)
      (+= filled (!= kept unfilled))
    )
    (let names (list (? Atom)))
    (call declared-names callee names)
    (let order (list U32))
    (let next 0u32)
    (for (in position (..< 0 (. arguments shapes length)))
      (while (and (< next (. args count)) ([] filled next))
        (+= next 1)
      )
      (let index next)
      (let name (. ([] (. arguments shapes) position) name))
      (if name
        (let found (call (. names find) name))
        (if (== found null)
          (let message (call (. program store-atom) "Unrecognized argument"))
          (call (. frame diagnose) ([] (. arguments syntax) position) .stated message)
          (return invalid-type)
        )
        (= index (as found U32))
      )
      (if (or (>= index (. args count)) ([] filled index))
        (let message (call (. program store-atom) "Wrong number of arguments"))
        (call (. frame diagnose) (if-expr name ([] (. arguments syntax) position) id) .stated message)
        (return invalid-type)
      )
      (let declared (call (. types child-type) args index))
      (= ([] places index)
        (call (. conversions adapted-literal)
          (block
            (arg (call argument-expr ([] (. arguments syntax) position)))
            (arg ([] (. arguments types) position))
            (arg declared)
          )
        )
      )
      (= ([] filled index) true)
      (+= order index)
    )
    (let empty U32 (. ArgumentFill fill-empty))
    (let fills-mark (. scratch words mark))
    (for (in place (..< 0 (. args count)))
      (let written (call (. order find) place))
      (call (. scratch words push) (if-expr written (as written U32) empty))
    )
    (let binds (!= (call (. filled find) false) null))
    (if (and (not binds) (not (call admits-value-call id)))
      (call (. scratch words rewind) fills-mark)
      (return invalid-type)
    )
    (call (. facts record-call)
      (block
        (arg (. frame instance))
        (arg id)
        (arg no-instance)
        (arg .call-closure)
        (arg (call (. scratch words since) fills-mark))
        (arg binds)
      )
    )
    (call (. scratch words rewind) fills-mark)
    (if binds
      (let mark (. scratch types mark))
      (for (in place places)
        (call (. scratch types push) place)
      )
      (return (call (. types intern-binding) .bound-value (. frame module) 0 0 callee 0 mark))
    )
    (call (. frame forget-members))
    (for (in offset (..< 0 (. held count)))
      (let kept (call (. types child-type) held offset))
      (if (!= kept unfilled)
        (call (. conversions convert) id id kept (call (. types child-type) args offset) .reason-argument)
      )
    )
    (for (in position (..< 0 (. arguments types length)))
      (let site ([] (. arguments syntax) position))
      (let declared (call (. types child-type) args ([] order position)))
      (call (. conversions convert) site site ([] places ([] order position)) declared .reason-argument)
    )
    (let ref (call class-ref types callee))
    (let steps (and (== (. ref module) (. types generator-decl module)) (== (. ref decl) (. types generator-decl decl))))
    (if (and steps (!= returns no-type))
      (call (. facts set-plan) (. frame instance) id .plan-step)
      (let stepped (call (. types optional-around) returns))
      (let raised (call step-result types callee stepped))
      (if (!= raised no-type)
        (return (call raised-call id callee raised))
      )
      (return stepped)
    )
    (let carried (if-expr steps no-type (call carried-result types callee)))
    (if (!= carried no-type)
      (return (call raised-call id fn carried))
    )
    (return (if-expr (== returns no-type) (. types void-type) returns))
  )
  (fn-do _ raised-call TypeId
    (param id SyntaxId)
    (param function TypeId)
    (param carried TypeId)
    ; What a call of a value of a function type that carries errors gives. Under `catch` it is
    ; the value or one of the errors. Elsewhere each error leaves the function at the call, and
    ; the call gives the value. What it answers with is kept for the type, for emission.
    (call (. types complete) carried)
    (call (. facts note-carried) function carried)
    (if (!= (. frame surround catch-depth) 0)
      (return carried)
    )
    (match? ([] (. types rows) carried)
      (case (call .type-result row)
        (for (in offset (..< 0 (. row errors count)))
          (call note-outgoing (call (. types child-type) (. row errors) offset) id)
        )
        (call (. facts mark-propagates) (. frame instance) id)
        (return (. row value))
      )
    )
    (return carried)
  )
  (fn-do _ declared-names _
    (param callee TypeId)
    (param names (list (? Atom)))
    ; The names the arguments of a function type are called by, where the type is declared.
    (let level (? TypeId) callee)
    (while level
      (match? ([] (. types rows) level)
        (case (call .type-class row)
          (let owner ([] (. program modules) (. row module)))
          (match? ([] (. owner decls) (. row decl))
            (case (call .decl-class class)
              (match? ([] (. owner tree nodes) (. class base))
                (case (call .node-type-function fn)
                  (for (in arg ([] (. owner tree children) (. fn args)))
                    (+= names (call declared-name (. owner tree) arg))
                  )
                  (return)
                )
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
  )
  (fn-do _ declared-name (? Atom)
    (param tree AST)
    (param arg SyntaxId)
    (match? ([] (. tree nodes) arg)
      (case (call .node-argument-decl row)
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-capture capture)
            (match? ([] (. tree nodes) (. capture id))
              (case (call .node-identifier identifier)
                (return (. identifier name))
              )
            )
          )
          (case (call .node-identifier identifier)
            (return (. identifier name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do + method-call TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param arguments Arguments)
    (param written Bool (= false))
    (param capture (? RowCapture) (= null))
    ; `written` marks a call the source spells as a method call, which a union must answer with
    ; every case's own method. A type given as a value is compared as the type it is known to be
    ; where the call stands, as it is when the type is named. A union a row of a table holds answers
    ; with each case's own method run on the row, as it is read where the row's storage was checked;
    ; there an extension of the case itself stands over one of a base of it.
    (let rows forward-row)
    (= forward-row no-type)
    (if (and (== (call (. types intrinsic-of) receiver) .type-info) (call relates-types name))
      (return (call type-info-call id (call class-arg types receiver 0) name arguments))
    )
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (= (. ranking row-case) (if-expr capture receiver no-type))
    (let hit (call adapt-row receiver (call (. ranking dispatch-method) receiver name) capture))
    (call note-interface-call receiver hit)
    (if (and (not hit) (not (. ranking partial)) (== (call (. types intrinsic-of) receiver) .union))
      (call (. ranking release))
      (let gap (only-if (call method-gap receiver name arguments) (if written)))
      (if gap
        (call (. frame diagnose) id .stated (call (. program store-atom) gap) receiver)
        (call (. frame mention) (call case-types receiver))
        (return invalid-type)
      )
      (if (call forwards-to-cases receiver)
        (return (call forward-call id object-syntax receiver name arguments rows))
      )
      (call (. frame diagnose) id .function-not-found name)
      (return invalid-type)
    )
    (let row (call union-row receiver))
    (if (and (not hit) (not (. ranking partial)) (!= row no-type))
      (call (. ranking release))
      (= forward-row receiver)
      (return (call method-call id object-syntax row name arguments written))
    )
    (let delegated (and hit (call (. ranking delegates-to) receiver (. hit receiver))))
    (if delegated
      (= delegator receiver)
    )
    (let on-row (and hit capture (== (. hit receiver) (. capture row))))
    (if (and hit (!= (. hit receiver) receiver) (not (call (. ranking ambiguity))) (not delegated) (not on-row))
      (call (. conversions convert)
        (block
          (arg object-syntax)
          (arg object-syntax)
          (arg receiver)
          (arg (. hit receiver))
          (arg (call receiver-reason id object-syntax))
        )
      )
    )
    (if (and hit (call is-virtual-receiver receiver))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (if (and (not hit) (. arguments curried) (. ranking partial))
      (= interning null)
      (return (call bind-partial .bound-method receiver arguments))
    )
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg .call-method)
          (arg (. arguments syntax))
          (arg .function-not-found)
          (arg hit)
          (arg name)
          (arg 0)
          (arg receiver)
          (arg (. arguments piped))
        )
      )
    )
    (= interning null)
    (call (. ranking release))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (if (call stores-untraced callee)
      (let item (call class-arg types (. ([] (. instances rows) callee) self-type) 0))
      (let traced U64 (if-expr (call arena-traces item) 1 0))
      (call (. facts set-constant)
        (block
          (arg (. frame instance))
          (arg id)
          (arg (call ConstantFact traced 0 null false))
          (arg .plan-store-untraced)
        )
      )
    )
    (let returned (call demand-return callee id))
    (if (and (== (call (. types intrinsic-of) receiver) .type-relation) (== (. arguments types length) 1))
      (let named (call (. facts relation-at) (. frame instance) object-syntax))
      (if (and (!= named no-fact) (or (== (. name text) "cast") (== (. name text) "unify")))
        (return (call relation-cast id ([] (. facts relations) named) ([] (. arguments types) 0) ([] (. arguments syntax) 0)))
      )
    )
    (return returned)
  )
  (fn-do _ relation-cast TypeId
    (param id SyntaxId)
    (param named RelationFact)
    (param value TypeId)
    (param given SyntaxId)
    ; The relation of two types converts a value by itself: its `cast` gives the value as the type
    ; the relation leads to, and a relation that is not legal refuses the value. The call is
    ; planned as one the compiler answers, and what converts the value is recorded at the value.
    ; A relation of two types that share an equal unit converts in two steps: to the type the
    ; first converts to, and from that by the ratio. A value that is not of the type the relation
    ; starts at is the receiver of the converter where the relation is one, and converts to that
    ; type first, as a receiver does; under any other relation it has nothing recorded, and
    ; emission refuses it. An integer written with no suffix that fits the type it starts at is of that
    ; type.
    (let relation (call (. relations compare) (. named from) (. named to) (. named unifies) false null (. frame module)))
    (if (not (call relation-legal relation))
      (call (. frame diagnose) id .illegal-cast null (. named from) (. named to))
      (return invalid-type)
    )
    (call (. facts set-plan) (. frame instance) id .plan-relation-cast)
    (let held (call (. conversions adapted-literal) (call argument-site given) value (. named from)))
    (if (== (. relation kind) .relation-same)
      (return held)
    )
    (let target (if-expr (and (. named unifies) (!= (. relation unified) no-type)) (. relation unified) (. relation to)))
    (if (== held (. named from))
      (let fitted (if-expr (call (. types is-optional) target) (call (. types optional-inner) target) target))
      (call (. conversions check-literal-fit) (call argument-site given) fitted)
      (if (and (== (. relation kind) .relation-common-equality) (!= (. relation via) no-type))
        (call convert-related given held (. relation via))
        (call convert-related given (. relation via) target)
        (else
          (call convert-related given held target)
        )
      )
      (else-if (== (. relation kind) .relation-converter)
        (let received (call (. relations compare) held (. named from) false false null (. frame module)))
        (if (not (call relation-legal received))
          (call (. frame diagnose) given .illegal-cast null held (. named from))
          (return invalid-type)
        )
        (call (. conversions check-literal-fit) (call argument-site given) (. named from))
        (call (. conversions record-conversion) given received .reason-relation)
        (call convert-related given (. named from) target)
      )
    )
    (return target)
  )
  (fn-do _ convert-related _
    (param given SyntaxId)
    (param from TypeId)
    (param to TypeId)
    ; Records at a value what converts it from one type to another, for a relation asked to
    ; cast it. Nothing is recorded where the two are one type or do not convert.
    (let found (call (. relations compare) from to false false null (. frame module)))
    (if (and (call relation-legal found) (!= (. found kind) .relation-same))
      (call (. conversions record-conversion) given found .reason-relation)
    )
  )
  (fn-do _ note-relation _
    (param id SyntaxId)
    (param from TypeId)
    (param to TypeId)
    (param unifies Bool)
    ; Plans a relation asked of a type as one the compiler answers, and records the text it is
    ; printed as: its name, and the names of the two types as they are when the program runs.
    (if (or (== from no-type) (== from invalid-type) (== to no-type) (== to invalid-type))
      (return)
    )
    (let relation (call (. relations compare) from to unifies false null (. frame module)))
    (let left (call type-runtime-name types from))
    (let right (call type-runtime-name types to))
    (let shown (str "[" (call relation-name (. relation kind)) " " left " = " right "]"))
    (call (. facts set-constant)
      (block
        (arg (. frame instance))
        (arg id)
        (arg (call ConstantFact 0 0 (call (. program store-atom) shown) false))
        (arg .plan-relation)
      )
    )
  )
  (fn-expr + union-row TypeId
    (param receiver TypeId)
    (call row-union types receiver)
  )
  (fn-do + has-method Bool
    (param receiver TypeId)
    (param name Atom)
    (param arguments Arguments)
    ; Whether a method of the receiver takes these arguments, in full or in part.
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (let found (or (!= (call (. ranking dispatch-method) receiver name) null) (!= (. ranking partial) null)))
    (call (. ranking release))
    (return found)
  )
  (fn-do + has-getter Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether a getter answers the name: one an extension adds is no property of the class.
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let found (call (. ranking dispatch-getter) receiver name))
    (call (. ranking release))
    (call close-site site)
    (return (!= found null))
  )
  (fn-do + has-setter Bool
    (param receiver TypeId)
    (param name Atom)
    (param value TypeId)
    (param rhs SyntaxId)
    ; Whether a setter takes the value for the name: one an extension adds is no property of the class.
    (let site (call open-site))
    (call push-argument value rhs)
    (call (. ranking begin) (. site shapes) (. site types))
    (let found (call (. ranking dispatch-setter) receiver name))
    (call (. ranking release))
    (call close-site site)
    (return (!= found null))
  )
  (fn-do _ method-gap (? String)
    (param union TypeId)
    (param name Atom)
    (param arguments Arguments)
    ; Why a union cannot answer a method with its cases' own: the first case that holds no value,
    ; or whose value has no method taking the arguments in full.
    (for (in index (..< 0 (. (call (. types cases-of) union) length)))
      (let fact ([] (call (. types cases-of) union) index))
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return (call gap-text fact index "no payload" "method" name))
      )
      (call (. ranking begin) (. arguments shapes) (. arguments types))
      (call (. ranking explicit-params) (. arguments params))
      (let found (!= (call (. ranking dispatch-method) (. fact type) name) null))
      (call (. ranking release))
      (if (and (not found) (not (call forwards-to-cases (. fact type))))
        (return (call gap-text fact index "no complete dispatch" "method" name))
      )
    )
    (return null)
  )
  (fn-do + getter-gap (? String)
    (param union TypeId)
    (param name Atom)
    ; Why a union cannot answer a property with its cases' own.
    (for (in index (..< 0 (. (call (. types cases-of) union) length)))
      (let fact ([] (call (. types cases-of) union) index))
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return (call gap-text fact index "no payload" "getter" name))
      )
      (if (and (== (call (. types property-named) (. fact type) name) null) (not (call has-getter (. fact type) name)))
        (return (call gap-text fact index "no complete dispatch" "getter" name))
      )
    )
    (return null)
  )
  (fn-expr _ gap-text String
    (param fact TypeCase)
    (param index Size)
    (param lack String)
    (param member String)
    (param name Atom)
    (str "Union case " shown " has " lack " for " member " '" (. name text) "'")
    (where
      (lazy shown
        (block
          (case? (. fact name)
            (str "'" (. fact name text) "'")
          )
          (default
            (str "#" index " (" (call type-display types (. fact type)) ")")
          )
        )
      )
    )
  )
  (fn-do + case-types (list TypeId)
    (param union TypeId)
    (let found (list TypeId))
    (for (in fact (call (. types cases-of) union))
      (+= found (. fact type))
    )
    (return found)
  )
  (fn-do + forwards-to-cases Bool
    (param receiver TypeId)
    ; A union whose every case holds a value answers a member it does not declare with each
    ; case's own.
    (if (!= (call (. types intrinsic-of) receiver) .union)
      (return false)
    )
    (let cases (call (. types cases-of) receiver))
    (for (in fact cases)
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return false)
      )
    )
    (return (!= (. cases length) 0))
  )
  (fn-do _ forward-call TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param arguments Arguments)
    (param row TypeId (= no-type))
    (let results (list TypeId))
    (for (in index (..< 0 (. (call (. types cases-of) receiver) length)))
      (let payload (. ([] (call (. types cases-of) receiver) index) type))
      (let capture (only-if (call RowCapture row (as index U32) true) (if (!= row no-type))))
      (let returned (call method-call id object-syntax payload name arguments false capture))
      (if (== returned invalid-type)
        (return invalid-type)
      )
      (if (== (call (. results find) returned) null)
        (+= results returned)
      )
    )
    (call (. facts set-plan) (. frame instance) id .plan-forward)
    (return (call forward-results id results))
  )
  (fn-do + forward-results TypeId
    (param id SyntaxId)
    (param results (list TypeId))
    ; What a member a union forwards gives, with the conversion of what each case gives to it
    ; recorded at the node, where the cases give more than one type and no error.
    (let joined (call forwarded-type results))
    (call (. facts note-forward) (. frame instance) id joined)
    (if (or (== (. results length) 1) (== joined invalid-type) (!= (call (. types intrinsic-of) joined) .union))
      (return joined)
    )
    (for (in result results)
      (if (!= result joined)
        (call (. conversions convert) id id result joined .reason-join)
      )
    )
    (return joined)
  )
  (fn-do + forwarded-type TypeId
    (param results (list TypeId))
    ; What a forwarded member gives: the one type every case gives, or the union of them, raising
    ; every error any case raises.
    (if (== (. results length) 1)
      (return ([] results 0))
    )
    (let values (list TypeId))
    (let errors (list TypeId))
    (for (in result results)
      (let value result)
      (match? ([] (. types rows) result)
        (case (call .type-result row)
          (= value (. row value))
          (for (in offset (..< 0 (. row errors count)))
            (let error (call (. types child-type) (. row errors) offset))
            (if (== (call (. errors find) error) null)
              (+= errors error)
            )
          )
        )
      )
      (if (== (call (. values find) value) null)
        (+= values value)
      )
    )
    (let joined ([] values 0))
    (if (!= (. values length) 1)
      (let mark (. scratch types mark))
      (for (in value values)
        (call (. scratch types push) value)
      )
      (= joined (call (. types intern-union) mark))
    )
    (if (== (. errors length) 0)
      (return joined)
    )
    (let raised (. scratch types mark))
    (for (in error errors)
      (call (. scratch types push) error)
    )
    (return (call result-type types joined raised))
  )
  (fn-do + c-binding TypeId
    (param name Atom)
    ; A C function read as a value binds no arguments yet.
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-c-function) name))
    (let candidate (?? hit (. ranking partial)))
    (let result no-type)
    (if candidate
      (= result (call (. types intern-binding) .bound-c-function (. frame module) (. candidate module) (. candidate decl)))
    )
    (call (. ranking release))
    (call close-site site)
    (return result)
  )
  (fn-do + method-binding TypeId
    (param receiver TypeId)
    (param name Atom)
    (param read SyntaxId (= 0))
    ; A method read as a value binds its receiver: no arguments yet, so every overload that still
    ; wants some is a candidate. Read at a node, it binds as the reference does each parameter
    ; from the first that is written with a default, to the default evaluated there; a method
    ; that wants an argument before its last such parameter is not supported.
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (let candidate (?? hit (. ranking partial)))
    (let result no-type)
    (let leading
      (block
        (case? (and candidate (!= read 0))
          (call leading-defaults (. candidate module) (. candidate decl))
        )
        (default
          0u32
        )
      )
    )
    (if (and candidate (== leading 0))
      (= result
        (call (. types intern-binding)
          (block
            (arg .bound-method)
            (arg (. frame module))
            (arg (. candidate module))
            (arg (. candidate decl))
            (arg receiver)
          )
        )
      )
      (else-if (and candidate (not hit))
        (call (. frame diagnose) read .not-supported)
        (= result invalid-type)
      )
      (else-if hit
        (= result (call bind-defaults hit receiver leading read))
      )
    )
    (call (. ranking release))
    (call close-site site)
    (return result)
  )
  (fn-do _ leading-defaults U32
    (param module ModuleId)
    (param decl DeclId)
    ; How many parameters of a function, from the first, are written with a default.
    (let owner ([] (. program modules) module))
    (let count 0u32)
    (match? ([] (. owner decls) decl)
      (case (call .decl-function fn)
        (while (and (< count (. fn args count)) (!= (. ([] (. owner arg-pool) (+ (. fn args start) count)) default-syntax) 0))
          (+= count 1)
        )
      )
    )
    (return count)
  )
  (fn-do _ bind-defaults TypeId
    (param hit Hit)
    (param receiver TypeId)
    (param leading U32)
    (param read SyntaxId)
    ; The binding a method read as a value makes of its receiver and the first parameters it is
    ; written with defaults for, each held as the parameter's type. The method as called with
    ; none given is recorded at the read, with each default's conversion, as a call that leaves
    ; them out records them.
    (let callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    (call (. (!! host) demand) callee)
    (let mark (. scratch types mark))
    (for (in position (..< 0 leading))
      (call (. scratch types push) ([] (. hit args) (as position Size)))
    )
    (let result
      (call (. types intern-binding)
        (block
          (arg .bound-method)
          (arg (. frame module))
          (arg (. hit module))
          (arg (. hit decl))
          (arg receiver)
          (arg 0)
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (for (in position (..< 0 leading))
      (call convert-default read hit callee position false)
    )
    (do
      (inline (call (. facts record-call) (. frame instance) read callee .call-method (. scratch no-fills) true))
    )
    (return result)
  )
  (fn-do _ bind-partial TypeId
    (param form BindingForm)
    (param object TypeId)
    (param arguments Arguments)
    ; The binding a curried call leaves when it gives its callee too few arguments: the candidate
    ; it partly matched, with the explicit type arguments and the argument types given so far. An
    ; integer written with no suffix is held as the type of the parameter it fills.
    (let partial (!! (. ranking partial)))
    (let module (. partial module))
    (let decl (. partial decl))
    (let adapted (list TypeId))
    (for (in type (. arguments types))
      (+= adapted type)
    )
    (for (in slot (..< 0 (. partial fills length)))
      (let filled (as ([] (. partial fills) slot) Size))
      (if (and (< filled (. adapted length)) (< slot (. partial args length)))
        (let expr (call argument-expr ([] (. arguments syntax) filled)))
        (= ([] adapted filled) (call (. conversions adapted-literal) expr ([] adapted filled) ([] (. partial args) slot)))
      )
    )
    (call (. ranking release))
    (let mark (. scratch types mark))
    (for (in type adapted)
      (call (. scratch types push) type)
    )
    (let held
      (call Arguments
        (block
          (arg (. arguments shapes))
          (arg (call (. scratch types since) mark))
          (arg (. arguments syntax))
          (arg (. arguments params))
          (arg (. arguments curried))
        )
      )
    )
    (let result (call bind-values form object held module decl))
    (call (. scratch types rewind) mark)
    (return result)
  )
  (fn-do _ bind-values TypeId
    (param form BindingForm)
    (param object TypeId)
    (param arguments Arguments)
    (param module ModuleId (= 0))
    (param decl DeclId (= 0))
    (let mark (. scratch types mark))
    (for (in param (. arguments params))
      (call (. scratch types push) param)
    )
    (for (in type (. arguments types))
      (call (. scratch types push) type)
    )
    (let count U32 (as (. arguments params length) U32))
    (return (call (. types intern-binding) form (. ranking caller) module decl object count mark))
  )
  (fn-do _ closure-arity Size
    (param closure TypeId)
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
          (case (call .decl-function fn)
            (return (. fn args count))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ closure-tail U32
    (param closure TypeId)
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
          (case (call .decl-function fn)
            (return (. fn variadic-index))
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ closure-signature Signature
    (param closure TypeId)
    (let module 0u32)
    (let decl 0u32)
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (= module (. row module))
        (= decl (. row decl))
      )
    )
    (return (call signature-into types module decl (call no-type-arguments types) no-type true))
  )
  (fn-do _ closure-argument TypeId
    (param closure TypeId)
    (param position Size)
    (param arguments Arguments)
    ; The type a nested function is typed for at an argument written before any tail: the type
    ; its parameter states, which the argument converts to at the call as TypeScript converts
    ; it, or the argument's own where the parameter states none, or states a union or a type
    ; with variables.
    (let given ([] (. arguments types) position))
    (let plain (call closure-signature closure))
    (if (>= position (. plain args length))
      (return given)
    )
    (let declared ([] (. plain args) position))
    (if (or (== declared given) (== declared invalid-type) (== declared no-type))
      (return given)
    )
    (if (or (. ([] (. types completions) declared) has-variables) (== (. ([] (. types completions) declared) intrinsic) .or))
      (return given)
    )
    (let stated false)
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
          (case (call .decl-function fn)
            (if (< position (. fn args count))
              (= stated (!= (. ([] (. ([] (. program modules) (. row module)) arg-pool) (+ (. fn args start) position)) type-syntax) 0))
            )
          )
        )
      )
    )
    (if (not stated)
      (return given)
    )
    (let site ([] (. arguments syntax) position))
    (call (. conversions check-literal-fit) (call argument-site site) declared)
    (call (. conversions convert) site site given declared .reason-argument)
    (return declared)
  )
  (fn-do _ tail-closure-call TypeId
    (param id SyntaxId)
    (param callee TypeId)
    (param arguments Arguments)
    (param tail U32)
    ; A call of a nested function whose last parameter is a variadic tail, which TypeScript packs as a
    ; function's call packs its tail: the arguments from the tail on are made a list of the item the
    ; tail declares, or where it declares none of the union of the distinct types they give, in order,
    ; each converted to the item. The nested function is typed for the arguments before the tail and the
    ; list.
    (for (in shape (. arguments shapes))
      (if (or (. shape name) (. shape is-optional))
        (call (. frame diagnose) id .not-supported)
        (return invalid-type)
      )
    )
    (let first (as tail Size))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (let plain (call closure-signature callee))
    (let declared (if-expr (< first (. plain args length)) ([] (. plain args) first) invalid-type))
    (let item invalid-type)
    (if (and (!= declared invalid-type) (not (. ([] (. types completions) declared) has-variables)))
      (match? ([] (. types rows) declared)
        (case (call .type-class row)
          (if (and (== (. row module) (. types list-decl module)) (== (. row decl) (. types list-decl decl)) has-args)
            (= item (call (. types child-type) (. row args) 0))
          )
          (lazy has-args (>= (. row args count) 1))
        )
      )
      (else
        (let distinct (list TypeId))
        (for (in position (..< first (. arguments types length)))
          (if (== (call (. distinct find) ([] (. arguments types) position)) null)
            (+= distinct ([] (. arguments types) position))
          )
        )
        (if (== (. distinct length) 1)
          (= item ([] distinct 0))
          (else-if (!= (. distinct length) 0)
            (let mark (. scratch types mark))
            (for (in type distinct)
              (call (. scratch types push) type)
            )
            (= item (call (. types intern-union) mark))
          )
        )
      )
    )
    (if (or (== item invalid-type) (== item no-type))
      (call (. frame diagnose) id .not-supported)
      (return invalid-type)
    )
    (let list-mark (. scratch types mark))
    (call (. scratch types push) item)
    (let list (call (. types class-with-args) (. types list-decl module) (. types list-decl decl) list-mark))
    (for (in position (..< first (. arguments types length)))
      (let site ([] (. arguments syntax) position))
      (call (. conversions check-literal-fit) (call argument-site site) item)
      (if (!= ([] (. arguments types) position) item)
        (call (. conversions convert) site site ([] (. arguments types) position) item .reason-element)
      )
    )
    (let passed (list TypeId))
    (for (in position (..< 0 first))
      (+= passed (call closure-argument callee position arguments))
    )
    (let given-mark (. scratch types mark))
    (for (in type passed)
      (call (. scratch types push) type)
    )
    (call (. scratch types push) list)
    (let lambda (call (. (!! host) demand-lambda) callee (call (. scratch types since) given-mark)))
    (call (. scratch types rewind) given-mark)
    (if (== lambda no-instance)
      (return invalid-type)
    )
    (call note-list id list)
    (let fills-mark (. scratch words mark))
    (for (in position (..< 0 tail))
      (call (. scratch words push) position)
    )
    (call (. scratch words push) variadic)
    (call (. facts record-call) (. frame instance) id lambda .call-closure (call (. scratch words since) fills-mark) false)
    (call (. scratch words rewind) fills-mark)
    (call (. frame forget-members))
    (return (call demand-return lambda id))
  )
  (fn-do _ binding-call TypeId
    (param id SyntaxId)
    (param callee TypeId)
    (param arguments Arguments)
    ; A call of a binding passes the arguments it holds and then the call's own, to whatever its
    ; form names. Too few arguments under a curried call leave a further binding. A binding of
    ; the constructor a tuple or struct is given takes its parameters and no argument: the
    ; fields it does not hold take their defaults.
    (let form (. BindingForm bound-function))
    (let scope (. frame module))
    (let module 0u32)
    (let decl 0u32)
    (let object no-type)
    (let param-count 0u32)
    (let items (call (of RowRange TypeId)))
    (match? ([] (. types rows) callee)
      (case (call .type-binding row)
        (= form (. row form))
        (= scope (. row scope))
        (= module (. row module))
        (= decl (. row decl))
        (= object (. row object))
        (= param-count (. row param-count))
        (= items (. row items))
      )
    )
    (if (== form .bound-value)
      (return (call value-call id object items arguments))
    )
    (if (and (== form .bound-constructor) (!= (. arguments types length) 0) (call is-made-constructor module decl))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal arguments to binding"))
      (return invalid-type)
    )
    (let params-start (. scratch types mark))
    (let given 0)
    (for (in offset (..< 0 param-count))
      (call (. scratch types push) (call (. types child-type) items offset))
      (+= given 1)
    )
    (for (in param (. arguments params))
      (call (. scratch types push) param)
      (+= given 1)
    )
    (let site (call open-site))
    (for (in offset (..< param-count (. items count)))
      (call push-argument (call (. types child-type) items offset) id)
    )
    (for (in position (..< 0 (. arguments types length)))
      (call (. scratch call-arguments push) ([] (. arguments shapes) position))
      (call (. scratch types push) ([] (. arguments types) position))
      (call (. scratch syntax push) ([] (. arguments syntax) position))
    )
    (let params (call (. scratch types span) params-start given))
    (let combined
      (call Arguments
        (block
          (arg (. site shapes))
          (arg (. site types))
          (arg (. site syntax))
          (arg params)
          (arg (. arguments curried))
          (arg (. arguments piped))
          (arg (. arguments slots))
          (arg (. arguments builders))
          (arg (. arguments context))
        )
      )
    )
    (let diagnosed (. facts diagnostics length))
    (let result (call call-bound id form scope module decl object combined))
    (if (== result invalid-type)
      (let message (call (. program store-atom) "Illegal arguments to binding"))
      (call (. facts restate) diagnosed (. frame instance) id .function-not-found .stated message)
      (call (. facts restate) diagnosed (. frame instance) id .constructor-not-found .stated message)
    )
    (call close-site site)
    (call (. scratch types rewind) params-start)
    (return result)
  )
  (fn-do + bound-return BoundReturn
    (param binding TypeId)
    (param args (of ImmutableArray TypeId ArenaBacking))
    (param asked Bool (= false))
    ; The type a binding returns for these argument types, which a parameter of a function type
    ; infers from, with the function, the method or the constructor it calls with them. Nothing is
    ; reported: a binding that does not take them returns the invalid type, and so does one of a
    ; function or a method they leave a parameter of.
    (let form (. BindingForm bound-function))
    (let scope (. frame module))
    (let module 0u32)
    (let decl 0u32)
    (let object no-type)
    (let param-count 0u32)
    (let items (call (of RowRange TypeId)))
    (match? ([] (. types rows) binding)
      (case (call .type-binding row)
        (= form (. row form))
        (= scope (. row scope))
        (= module (. row module))
        (= decl (. row decl))
        (= object (. row object))
        (= param-count (. row param-count))
        (= items (. row items))
      )
    )
    (let shapes-mark (. scratch call-arguments mark))
    (let types-mark (. scratch types mark))
    (for (in offset (..< param-count (. items count)))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) (call (. types child-type) items offset))
    )
    (for (in type args)
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) type)
    )
    (let given (call (. scratch types since) types-mark))
    (let result (call BoundReturn))
    (if (== form .bound-closure)
      (let returned (call lambda-return (!! host) instances object given))
      (if (!= returned invalid-type)
        (= result (call BoundReturn returned (call (. (!! host) demand-lambda) object given)))
      )
      (else-if (== form .bound-value)
        (match? ([] (. types rows) (call function-row types object))
          (case (call .type-function row)
            (= result (call BoundReturn (. row return-type)))
          )
        )
      )
      (else
        (let shapes (call (. scratch call-arguments since) shapes-mark))
        (= result (call settle-bound form scope module decl object shapes given asked))
      )
    )
    (call (. scratch types rewind) types-mark)
    (call (. scratch call-arguments rewind) shapes-mark)
    (return result)
  )
  (fn-do _ settle-bound BoundReturn
    (param form BindingForm)
    (param scope ModuleId)
    (param module ModuleId)
    (param decl DeclId)
    (param object TypeId)
    (param shapes (of ImmutableArray CallArgument ArenaBacking))
    (param given (of ImmutableArray TypeId ArenaBacking))
    (param asked Bool)
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (= name (. fn name))
      )
    )
    (let local (call local-ranking scope))
    (= (. local asked) asked)
    (call (. local begin) shapes given)
    (let hit (? Hit) null)
    (if (== form .bound-constructor)
      (= (. local bound-call) true)
      (= hit (call (. local dispatch-constructor) object true))
      (else-if (and name (== form .bound-method))
        (= hit (call (. local dispatch-method) object name))
      )
      (else-if (and name (== form .bound-c-function))
        (= hit (call (. local dispatch-c-function) name))
      )
      (else-if name
        (= hit (call (. local dispatch-function) (. frame self-type) name))
      )
    )
    (let result (call BoundReturn))
    (let whole
      (scope (or (not hit) constructs c-function (call takes-every (. hit module) (. hit decl) (. given length)))
        (lazy constructs (== form .bound-constructor))
        (lazy c-function (== form .bound-c-function))
      )
    )
    (if (and hit whole)
      (let callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
      (call (. (!! host) demand) callee)
      (let signature ([] (. instances signatures) callee))
      (let returned (. signature returns))
      (if (== form .bound-constructor)
        (= returned (. hit receiver))
        (else-if (== (. signature return-state) .return-pending)
          (= returned invalid-type)
        )
      )
      (= result (call BoundReturn returned callee))
    )
    (call (. local release))
    (return result)
  )
  (fn-do _ takes-every Bool
    (param module ModuleId)
    (param decl DeclId)
    (param count Size)
    ; Whether a function a binding calls as a value of a function type is given every parameter,
    ; as the reference requires: a default is no part of the call, and only a variadic tail
    ; takes any number.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (or (!= (. fn variadic-index) (. U32 max)) (== (as (. fn args count) Size) count)))
      )
    )
    (return true)
  )
  (fn-do _ call-bound TypeId
    (param id SyntaxId)
    (param form BindingForm)
    (param scope ModuleId)
    (param module ModuleId)
    (param decl DeclId)
    (param object TypeId)
    (param arguments Arguments)
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (= name (. fn name))
      )
    )
    (match form
      (case= .bound-constructor
        (return (call construction-on id (call with-params object (. arguments params)) arguments true 0 true))
      )
      (case= .bound-closure
        (if (< (. arguments types length) (call closure-arity object))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Bound function not found"))
          (return invalid-type)
        )
        (return (call slot-call id object arguments))
      )
      (default
        (if (not name)
          (call (. frame diagnose) id .function-not-found)
          (return invalid-type)
        )
        (let caller (. ranking caller))
        (= (. ranking caller) scope)
        (let result (call bound-dispatch id form object name arguments))
        (= (. ranking caller) caller)
        (return result)
      )
    )
  )
  (fn-do _ bound-dispatch TypeId
    (param id SyntaxId)
    (param form BindingForm)
    (param object TypeId)
    (param name Atom)
    (param arguments Arguments)
    ; A binding of a function, a method or a C function chooses among the overloads of the module
    ; it was made in, which the ranking looks them up from.
    (if (== form .bound-method)
      (return (call method-call id id object name arguments))
    )
    (if (== form .bound-c-function)
      (return (call c-call id name arguments))
    )
    (return (call function-call id name arguments))
  )
  (fn-do _ explain-rows _
    (param receiver TypeId)
    (param arguments Arguments)
    (param by-name Bool)
    (param diagnosed Size)
    ; Where a constructor matches nothing but would were each value cast, the first value of a row of
    ; its tail, such as a bullet, that converts only when asked is reported in place of the call.
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (= (. ranking asked) true)
    (let hit (call (. ranking dispatch-constructor) receiver by-name))
    (= (. ranking asked) false)
    (let fills (list U32))
    (let wanted (list TypeId))
    (if hit
      (for (in offset (..< 0 (. hit tail-fills length)))
        (+= fills ([] (. hit tail-fills) offset))
        (+= wanted (. ([] (. hit tail-relations) offset) to))
      )
    )
    (call (. ranking release))
    (for (in offset (..< 0 (. fills length)))
      (let fill (as ([] fills offset) Size))
      (let target (if-expr (. ([] (. arguments shapes) fill) name) (call value-field ([] wanted offset)) ([] wanted offset)))
      (if (and (!= target no-type) (call explain-row (call argument-expr ([] (. arguments syntax) fill)) target diagnosed))
        (return)
      )
    )
  )
  (fn-do _ value-field TypeId
    (param pair TypeId)
    ; What a row written with a name gives its value as: the last field of the tuple the row is.
    (call (. types complete) pair)
    (let mark (. types scratch types mark))
    (call push-fields types pair)
    (let count (- (. types scratch types length) mark))
    (let field (if-expr (== count 2) ([] (. types scratch types) (+ mark 1)) no-type))
    (call (. types scratch types rewind) mark)
    (return field)
  )
  (fn-do _ explain-row Bool
    (param item SyntaxId)
    (param wanted TypeId)
    (param diagnosed Size)
    ; Whether a value of a row converts only when asked to what it is wanted as, reported where it
    ; is written, or where a tuple written is wanted as a tuple, at the first of its items that does.
    (return-if false (if (call (. conversions fits-unasked) item wanted)))
    (blank)
    (match? ([] (. frame tree nodes) item)
      (case (call .node-tuple-syntax row)
        (call (. types complete) wanted)
        (let mark (. types scratch types mark))
        (call push-fields types wanted)
        (let fields (list TypeId))
        (for (in offset (..< mark (. types scratch types length)))
          (+= fields ([] (. types scratch types) offset))
        )
        (call (. types scratch types rewind) mark)
        (if (== (. fields length) (. row items count))
          (let offset 0)
          (for (in element ([] (. frame tree children) (. row items)))
            (return-if true (if (call explain-row element ([] fields offset) diagnosed)))
            (blank)
            (+= offset 1)
          )
        )
      )
    )
    (let value (call (. facts node-type) (. frame instance) item))
    (return-if false (if (or (== value no-type) (== value invalid-type))))
    (return-if false (if (not (call relation-legal (call (. relations compare-explicit) value wanted)))))
    (blank)
    (call (. facts diagnostics truncate) diagnosed)
    (call (. conversions convert) item item value wanted .reason-argument)
    (return true)
  )
  (fn-do _ is-made-constructor Bool
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return
          (scope (and (. fn is-generated) implicit)
            (lazy implicit (or (== (. fn kind) .default-constructor-decl) (== (. fn kind) .tuple-constructor-decl)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ recast-property DeclId
    (param hit Hit)
    (param position Size)
    (param expected TypeId)
    ; The property a constructor the compiler generates for a tuple or struct with type
    ; parameters fills from an argument, where the property holds a value of a function type
    ; and is declared with a type that names one of the parameters. The reference gives such
    ; an argument the function type with no name, and makes the property's type of it where
    ; the property is declared. No property for any other argument.
    (match? ([] (. ([] (. program modules) (. hit module)) decls) (. hit decl))
      (case (call .decl-function fn)
        (let params (call (. types class-type-args) (. hit module) (. fn owner)))
        (if (or (not (. fn is-generated)) (!= (. fn kind) .tuple-constructor-decl) (== (. params count) 0))
          (return 0)
        )
        (let held (call (. types optional-inner) expected))
        (call (. types complete) held)
        (let plain (call function-row types held))
        (let ref (call class-ref types held))
        (let steps (and (== (. ref module) (. types generator-decl module)) (== (. ref decl) (. types generator-decl decl))))
        (if (or (== plain no-type) (== plain held) steps (call is-c-function types held))
          (return 0)
        )
        (let filled 0)
        (for (in property (call (. types properties-of) (. hit receiver)))
          (if (== (. property slot) (. U32 max))
            (continue)
          )
          (if (== filled position)
            (let declared (call owner-property program (. hit module) (. fn owner) (. property name)))
            (return (if-expr (call names-parameter (. hit module) params declared) declared 0))
          )
          (+= filled 1)
        )
      )
    )
    (return 0)
  )
  (fn-do _ names-parameter Bool
    (param module ModuleId)
    (param params (of RowRange SyntaxId))
    (param property DeclId)
    ; Whether the type a property is declared with names one of its class's type parameters.
    (if (== property 0)
      (return false)
    )
    (let tree (. ([] (. program modules) module) tree))
    (match? ([] (. ([] (. program modules) module) decls) property)
      (case (call .decl-property row)
        (if (== (. row type-syntax) 0)
          (return false)
        )
        (for (in id (..< (call (. tree subtree-start) (. row type-syntax)) (+ (. row type-syntax) 1)))
          (let name (call (. types type-syntax-name) tree id))
          (for (in position (..< 0 (. params count)))
            (if (and name (== (call (. types class-param-name) tree params position) name))
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ convert-recast _
    (param syntax SyntaxId)
    (param given TypeId)
    (param expected TypeId)
    (param callee InstanceId)
    (param property DeclId)
    ; Converts an argument of a generated constructor to a property that `recast-property`
    ; names, as the reference does: to the function type with no name, then to the property's
    ; type by the function made for the two, which is placed where the property is declared,
    ; and then to the optional that holds it. An optional given has no shape here.
    (let named (call (. types optional-inner) expected))
    (let plain (call function-row types named))
    (let kind (. ([] (. types completions) given) intrinsic))
    (if (or (call (. types is-optional) given) (and (!= kind .closure) (!= kind .binding) (!= kind .function)))
      (call (. frame diagnose) syntax .not-supported)
      (return)
    )
    (if (and differs (== (call (. conversions convert) syntax syntax given plain .reason-argument) invalid-type))
      (return)
    )
    (lazy differs (!= given plain))
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) callee) module)) decls) property)
      (case (call .decl-property row)
        (call (. facts place-cast) plain named callee (. row syntax))
      )
    )
    (call (. conversions convert) syntax syntax plain named .reason-argument)
    (if (!= named expected)
      (call (. conversions convert) syntax syntax named expected .reason-argument)
    )
  )
  (fn-do _ holds-callable Bool
    (param given TypeId)
    (param expected TypeId)
    ; Whether an argument is a closure or a binding given where an optional of a function type
    ; is wanted: it becomes a value of the function type first, and then what holds it.
    (let kind (. ([] (. types completions) given) intrinsic))
    (if (or (and (!= kind .closure) (!= kind .binding)) (not (call (. types is-optional) expected)))
      (return false)
    )
    (let inner (call (. types optional-inner) expected))
    (call (. types complete) inner)
    (return (!= (call function-row types inner) no-type))
  )
  (fn-do _ with-params TypeId
    (param object TypeId)
    (param params (of ImmutableArray TypeId ArenaBacking))
    ; The class a bound constructor constructs once its call names the type parameters.
    (if (== (. params length) 0)
      (return object)
    )
    (match? ([] (. types rows) object)
      (case (call .type-class row)
        (let mark (. scratch types mark))
        (for (in param params)
          (call (. scratch types push) param)
        )
        (return (call (. types class-pattern-with-args) (. row module) (. row decl) mark))
      )
    )
    (return object)
  )
  (fn-do + static-call TypeId
    (param id SyntaxId)
    (param owner TypeId)
    (param name Atom)
    (param arguments Arguments)
    (if (== (call (. types intrinsic-of) owner) .union)
      (let constructed (call construct-case id owner name arguments))
      (if (!= constructed no-type)
        (return constructed)
      )
    )
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (let hit (call (. ranking dispatch-static) owner name))
    (if (not hit)
      (call (. ranking release))
      (return (call type-info-call id owner name arguments))
    )
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg .call-static)
          (arg (. arguments syntax))
          (arg .function-not-found)
          (arg hit)
          (arg name)
          (arg 0)
          (arg no-type)
          (arg (. arguments piped))
        )
      )
    )
    (call (. ranking release))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (return (call demand-return callee id))
  )
  (fn-expr _ relates-types Bool
    (param name Atom)
    (or (== (. name text) "compare") (== (. name text) "compare-unified"))
  )
  (fn-do _ type-info-call TypeId
    (param id SyntaxId)
    (param about TypeId)
    (param name Atom)
    (param arguments Arguments)
    (let relates (call relates-types name))
    (if (and relates (== (. arguments types length) 1))
      (if (!= (call (. types intrinsic-of) ([] (. arguments types) 0)) .type-info)
        (call (. frame diagnose) ([] (. arguments syntax) 0) .stated (call (. program store-atom) "Invalid argument"))
        (return invalid-type)
      )
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) about)
    (let info (call (. types class-named-with-args) (. frame module) (!! (. types type-info-atom)) mark))
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (call (. ranking explicit-params) (. arguments params))
    (let hit (call (. ranking dispatch-method) info name))
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg .call-method)
          (arg (. arguments syntax))
          (arg .function-not-found)
          (arg hit)
          (arg name)
          (arg 0)
          (arg no-type)
          (arg (. arguments piped))
        )
      )
    )
    (call (. ranking release))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (if (and relates (== (. arguments types length) 1))
      (let other (call class-arg types ([] (. arguments types) 0) 0))
      (call (. facts record-relation) (. frame instance) id about other (== (. name text) "compare-unified"))
      (call note-relation id about other (== (. name text) "compare-unified"))
    )
    (if relates
      (return (call (. types type-row) .type-relation))
    )
    (return (call demand-return callee id))
  )
  (fn-do _ construct-case TypeId
    (param id SyntaxId)
    (param owner TypeId)
    (param name Atom)
    (param arguments Arguments)
    (let cases (. ([] (. types completions) owner) cases))
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (let plan (. OperatorPlan plan-case))
        (if (and (!= (. fact type) no-type) (not (. fact is-default)))
          (= plan (call construct-payload (. fact type) arguments))
        )
        (call (. facts set-constant) (. frame instance) id (call ConstantFact offset 0.0 null false) plan)
        (return owner)
      )
    )
    (return no-type)
  )
  (fn-do _ construct-payload OperatorPlan
    (param payload TypeId)
    (param arguments Arguments)
    ; A case of a tuple type takes the tuple's fields as its arguments, or the tuple itself; a case
    ; of any other type takes that one value. The plan says which.
    (let kind (call (. types intrinsic-of) payload))
    (let whole (and (== (. arguments types length) 1) (== ([] (. arguments types) 0) payload)))
    (if (or (and (!= kind .tuple) (!= kind .struct)) whole)
      (if (== (. arguments types length) 1)
        (let site ([] (. arguments syntax) 0))
        (call note-context-cast site payload .cast-argument)
        (call (. conversions convert)
          (block
            (arg site)
            (arg site)
            (arg (call payload-argument arguments 0 payload))
            (arg payload)
            (arg .reason-argument)
          )
        )
      )
      (return .plan-case)
    )
    (let position 0)
    (for (in field (call (. types properties-of) payload))
      (if (and (== (. field storage-kind) .storage-eager) (< position (. arguments types length)))
        (let expected (. field type))
        (if (== expected no-type)
          (= expected (call (. (!! host) demand-member) field payload (. field name)))
        )
        (let site ([] (. arguments syntax) position))
        (call note-context-cast site expected .cast-argument)
        (call (. conversions convert)
          (block
            (arg site)
            (arg site)
            (arg (call payload-argument arguments position expected))
            (arg expected)
            (arg .reason-argument)
          )
        )
        (+= position 1)
      )
    )
    (return .plan-case-fields)
  )
  (fn-do + payload-argument TypeId
    (param arguments Arguments)
    (param position Size)
    (param expected TypeId)
    ; The type of an argument given for what a case holds, or what an event publishes. A case
    ; named by its symbol alone is a case of the type expected of it, as one given to a function
    ; is.
    (let given ([] (. arguments types) position))
    (let shape ([] (. arguments shapes) position))
    (let symbol (. shape symbol))
    (if (or (not symbol) (not host))
      (return given)
    )
    (if (. shape other-symbol)
      (let target (if-expr (call (. types is-optional) expected) (call (. types optional-inner) expected) expected))
      (if (== (call symbols-type types program target shape) invalid-type)
        (return given)
      )
      (call (. (!! host) note-symbol-choice) target (call argument-expr ([] (. arguments syntax) position)))
      (return target)
    )
    (let owner (call contextual-symbol types relations expected symbol (. frame module)))
    (if (or (== owner invalid-type) (== owner no-type))
      (return given)
    )
    (let site (call argument-site ([] (. arguments syntax) position)))
    (call (. facts set-node-type) (. frame instance) site owner)
    (call (. (!! host) note-enum-case) owner symbol site)
    (if (call keeps-symbol site owner expected symbol)
      (call settle-later site symbol)
    )
    (return owner)
  )
  (fn-expr + keeps-symbol Bool
    (param site SyntaxId)
    (param owner TypeId)
    (param expected TypeId)
    (param name Atom)
    (param explicit Bool (= false))
    ; Whether a case named by its symbol alone, where it is cast to the type expected of it, stays of
    ; no one type as the reference keeps it: of the type its name alone gives, cast to a type without
    ; the case that it converts to, other than by a method of its own, as an object of a class
    ; becomes text. An explicit cast keeps it though it does not convert.
    (case? (or (not (is ([] (. frame tree nodes) site) .node-symbol)) (== owner invalid-type) (== owner no-type))
      false
    )
    (case? (or (== target owner) (== target invalid-type) (== target no-type) generic-target)
      false
    )
    (case? (and host (!= (call symbol-type types program target name) invalid-type))
      false
    )
    (case? (!= owner (call symbol-class types (. frame module) name))
      false
    )
    (case? (not (call relation-legal relation))
      explicit
    )
    (case? (and (== (. relation kind) .relation-string-cast) (== (call (. types intrinsic-of) owner) .class))
      false
    )
    (default
      (and unconverted (!= (. relation kind) .relation-common-converter))
    )
    (where
      (lazy target (if-expr (call (. types is-optional) expected) (call (. types optional-inner) expected) expected))
      (lazy relation (call (. relations compare) owner target false false null (. frame module)))
      (lazy unconverted (and (!= (. relation kind) .relation-converter) (!= (. relation kind) .relation-fromverter)))
      (lazy generic-target (. ([] (. types completions) target) has-variables))
    )
  )
  (fn-do + settle-later _
    (param site SyntaxId)
    (param name Atom)
    ; Notes a case named by its symbol alone that nothing settles, to report once the instance is
    ; typed (`report-unsettled-cases`): the reference reports one only after it has compiled
    ; everything else.
    (+= unsettled-sites site)
    (+= unsettled-names name)
  )
  (fn-do + leave-unfound _
    (param site SyntaxId)
    ; Notes a case named by its symbol alone that no type the module can name has, taken as one of
    ; the program's types that has it (`program-symbol-class`) until the type expected of it settles
    ; it (`settle-unfound`).
    (if (== (call (. unfound-sites find) site) null)
      (+= unfound-sites site)
    )
  )
  (fn-do + settle-unfound _
    (param site SyntaxId)
    (let found (call (. unfound-sites find) site))
    (if (!= found null)
      (-= ([] unfound-sites (..< found (+ found 1))))
    )
  )
  (fn-do + report-unsettled-cases _
    ; Reports each case noted by `settle-later` that several types have, in the order noted, and
    ; each that no type the module can name has and nothing settled (`leave-unfound`), as the
    ; reference reports one only after it has compiled everything else.
    (for (in position (..< 0 (. unsettled-sites length)))
      (call ambiguous-case ([] unsettled-sites position) ([] unsettled-names position))
    )
    (for (in site unfound-sites)
      (call (. frame diagnose) site .stated (call (. program store-atom) "Case not found"))
    )
    (call (. unsettled-sites clear))
    (call (. unsettled-names clear))
    (call (. unfound-sites clear))
  )
  (fn-do + ambiguous-case Bool
    (param site SyntaxId)
    (param name Atom)
    ; Reports a case named by its symbol alone that several types the module can name have, where
    ; nothing settles which type's it is. Says whether it reported one.
    (let owners (list TypeId))
    (call symbol-owners types (. frame module) name owners)
    (if (< (. owners length) 2)
      (return false)
    )
    (let names (list String))
    (for (in owner owners)
      (+= names (call owner-name owner))
    )
    (let sorted (list String) (call sort names))
    (let listed "")
    (for (in shown sorted)
      (if (!= (. listed length) 0)
        (+= listed ", ")
      )
      (+= listed (str "'" shown "'"))
    )
    (call (. frame diagnose)
      (block
        (arg site)
        (arg .stated)
        (arg (call (. program store-atom) (str "Case '." (. name text) "' is ambiguous between " listed)))
      )
    )
    (return true)
  )
  (fn-expr _ owner-name String
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (call class-name program (. row module) (. row decl))
      )
      (default
        (call type-short-name types type)
      )
    )
  )
  (fn-do + construction TypeId
    (param id SyntaxId)
    (param callable SyntaxId)
    (param class-module ModuleId)
    (param class-decl DeclId)
    (param arguments Arguments)
    (if (call is-tuple-class class-module class-decl)
      (call (. facts set-plan) (. frame instance) id .plan-tuple)
      (return (call tuple-of-arguments arguments))
    )
    (let receiver (call construction-receiver callable class-module class-decl))
    (if (== receiver invalid-type)
      (let missing (call (. types missing-type) (. frame module) (. frame tree) callable (. frame env)))
      (if (!= missing 0)
        (call (. frame diagnose) missing .stated (call (. program store-atom) "Type not found"))
        (else
          (call (. frame diagnose) id .not-supported)
        )
      )
      (return invalid-type)
    )
    (if (call is-this-callable callable)
      (return (call construction-on id receiver arguments false callable))
    )
    (return (call construction-on id receiver arguments true callable))
  )
  (fn-do + construction-on TypeId
    (param id SyntaxId)
    (param receiver TypeId)
    (param arguments Arguments)
    (param by-name Bool (= true))
    (param missing-site SyntaxId (= 0))
    (param bound Bool (= false))
    (param explicit Bool (= false))
    ; A call of a type. Where the call is of a binding, a constructor given fewer arguments than
    ; it declares is partial, so its defaults do not fill them, as TypeScript dispatches a binding.
    ; With `explicit`, the type parameters of the arguments are the constructor's own.
    (call (. types complete) receiver)
    (call (. ranking begin) (. arguments shapes) (. arguments types))
    (= (. ranking bound-call) bound)
    (if explicit
      (call (. ranking explicit-params) (. arguments params))
    )
    (let hit (call (. ranking dispatch-constructor) receiver by-name))
    (if (and (not hit) (. arguments curried) (. ranking partial))
      (return (call bind-partial .bound-constructor receiver arguments))
    )
    (if (and hit (. arguments curried) (. ([] (. types completions) (. hit receiver)) has-variables))
      (let module (. hit module))
      (let decl (. hit decl))
      (call (. ranking release))
      (return (call bind-values .bound-constructor receiver arguments module decl))
    )
    (let form (if-expr by-name (. CallForm call-constructor) (. CallForm call-this-constructor)))
    (let site (if-expr (!= missing-site 0) missing-site id))
    (match? ([] (. frame tree nodes) site)
      (case (call .node-type-arguments named)
        (= site (. named base))
      )
    )
    (if hit
      (let fills false)
      (for (in shape (. arguments shapes))
        (if (. shape is-property)
          (= fills true)
          (break)
        )
      )
      (if (or fills (!= (. arguments slots length) 0) (!= (. arguments context) (. U32 max)))
        (= constructing
          (call Construction
            (block
              (arg (. hit module))
              (arg (. hit decl))
              (arg (. hit receiver))
              (arg fills)
              (arg (. arguments context))
              (arg (. arguments slots))
              (arg (. arguments builders))
            )
          )
        )
      )
    )
    (let diagnosed (. facts diagnostics length))
    (let callee
      (call resolve-hit
        (block
          (arg id)
          (arg form)
          (arg (. arguments syntax))
          (arg .constructor-not-found)
          (arg hit)
          (arg null)
          (arg site)
          (arg no-type)
          (arg (. arguments piped))
        )
      )
    )
    (= constructing (call Construction))
    (call (. ranking release))
    (if (== callee no-instance)
      (if (not hit)
        (call explain-rows receiver arguments by-name diagnosed)
      )
      (return invalid-type)
    )
    (let constructed (if-expr (not (. ([] (. types completions) receiver) has-variables)) receiver (. (!! hit) receiver)))
    (let deferred false)
    (if host
      (call (. host demand) callee)
    )
    (if (and by-name (== (call (. types intrinsic-of) constructed) .class))
      (call (. frame check-allocates) id)
    )
    (if host
      (if (not (call (. instances errors-known) callee))
        (let running (== (. ([] (. instances rows) callee) state) .instance-in-progress))
        (if (or (!= (. frame surround catch-depth) 0) running (call converts-literal (!! hit) arguments))
          (call (. (!! host) demand-errors) callee)
          (else
            (call defer-outgoing callee id)
            (= deferred true)
          )
        )
      )
    )
    (let signature ([] (. instances signatures) callee))
    (let returned (. signature returns))
    (if (and (!= (. signature return-state) .return-pending) (!= returned no-type) (!= returned invalid-type))
      (= constructed returned)
    )
    (if (and (!= (. signature errors count) 0) (not deferred))
      (if (!= (. frame surround catch-depth) 0)
        (return (call result-type types constructed (call error-items signature)))
      )
      (if (call converts-literal (!! hit) arguments)
        (call (. instances mark-may-panic) (. frame instance))
        (call (. conversions demand-error-report))
        (call (. facts set-plan) (. frame instance) id .plan-literal-conversion)
        (return constructed)
      )
      (for (in offset (..< 0 (. signature errors count)))
        (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) id)
      )
      (call (. facts mark-propagates) (. frame instance) id)
    )
    (return constructed)
  )
  (fn-do _ converts-literal Bool
    (param hit Hit)
    (param arguments Arguments)
    ; A call of a type with one text written in source, which a function the type declares
    ; converts, is a conversion of the text: where it fails outside a catch it panics rather than
    ; raising from the function it is written in.
    (if (or (!= (. arguments syntax length) 1) (!= (. arguments shapes length) 1))
      (return false)
    )
    (if (or (. ([] (. arguments shapes) 0) name) (not (call (. conversions is-text-literal) ([] (. arguments syntax) 0))))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. hit module)) decls) (. hit decl))
      (case .decl-fromverter
        (return true)
      )
    )
    (return false)
  )
  (fn-do + error-items Size
    (param signature InstanceSignature)
    ; Pushes the errors a signature raises onto the scratch types, answering the mark below them.
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature errors count)))
      (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
    )
    (return mark)
  )
  (fn-expr _ is-tuple-class Bool
    (param class-module ModuleId)
    (param class-decl DeclId)
    (call (. (call (. types type-decl) .tuple) refers-to) class-module class-decl)
  )
  (fn-do _ tuple-of-arguments TypeId
    (param arguments Arguments)
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let position 0u32)
    (for (in type (. arguments types))
      (if (== type invalid-type)
        (call (. scratch types rewind) mark)
        (call (. scratch names rewind) names-mark)
        (return invalid-type)
      )
      (call (. scratch names push) (call (. types index-atom) position))
      (call (. scratch types push) type)
      (+= position 1)
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ construction-receiver TypeId
    (param callable SyntaxId)
    (param class-module ModuleId)
    (param class-decl DeclId)
    (match? ([] (. frame tree nodes) callable)
      (case (call .node-type-arguments row)
        (let mark (. scratch types mark))
        (for (in child ([] (. frame tree children) (. row args)))
          (let evaluated (call (. types evaluate-type) (. frame module) (. frame tree) child (. frame env)))
          (call (. scratch types push) evaluated)
        )
        (return (call (. types class-pattern-with-args) class-module class-decl mark))
      )
    )
    (if (and (call is-this-callable callable) (!= (. frame self-type) no-type))
      (return (. frame self-type))
    )
    (if (== (. (call (. types class-type-args) class-module class-decl) count) 0)
      (return (call (. types class-with-args) class-module class-decl (. scratch types mark)))
    )
    (let env (call (. types class-env) class-module class-decl))
    (let pattern (. env this-type))
    (call (. types env-release) env)
    (return pattern)
  )
  (fn-expr _ is-this-callable Bool
    (param callable SyntaxId)
    (case? (not (. types this-atom))
      false
    )
    (default
      (match ([] (. frame tree nodes) callable)
        (case (call .node-identifier row)
          (== (. row name) (. types this-atom))
        )
        (case (call .node-type-identifier row)
          (== (. row name) (. types this-atom))
        )
        (default
          false
        )
      )
    )
  )
  (fn-do + operator-call TypeId
    (param id SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param arg-syntax SyntaxId)
    (param arg TypeId)
    (param deferred Bool (= false))
    (param object-syntax SyntaxId (= 0))
    ; A call of the operator `name` of the receiver given one argument. `deferred` leaves ending what
    ; is known of properties to the caller, which learns whether the compiler answers it in place.
    (blank)
    (let site (call open-site))
    (call push-argument arg arg-syntax)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (call note-interface-call receiver hit)
    (let ambiguous (call (. ranking ambiguity)))
    (let result invalid-type)
    (if (and hit ambiguous)
      (call (. ranking release))
      (call (. frame diagnose) id ambiguous name)
      (else-if hit
        (if (and (!= object-syntax 0) (!= (. hit receiver) receiver) (call inherits-from receiver (. hit receiver)))
          (call (. conversions convert)
            (block
              (arg object-syntax)
              (arg object-syntax)
              (arg receiver)
              (arg (. hit receiver))
              (arg (call receiver-reason id object-syntax))
            )
          )
        )
        (if (call is-virtual-receiver receiver)
          (call (. instances mark-may-panic) (. frame instance))
        )
        (let callee (call commit-hit id hit .call-operator (. site syntax) deferred))
        (call (. ranking release))
        (= result (call demand-return callee id))
      )
      (else
        (call (. ranking release))
        (call (. frame diagnose) id .illegal-operation name receiver arg)
      )
    )
    (call close-site site)
    (return result)
  )
  (fn-do + operands-call TypeId
    (param id SyntaxId)
    (param name Atom)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    ; The call an operator makes of a function of its own name, given its two operands. No type
    ; when no function of that name takes them: the operator then answers by itself.
    (let site (call open-site))
    (call push-argument lhs left)
    (call push-argument rhs right)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-function) (. frame self-type) name))
    (let result no-type)
    (if hit
      (call note-interface-call (. frame self-type) hit)
      (let callee (call resolve-hit id .call-function (. site syntax) .function-not-found hit name))
      (call (. ranking release))
      (= result (if-expr (!= callee no-instance) (call demand-return callee id) invalid-type))
      (else
        (call (. ranking release))
      )
    )
    (call close-site site)
    (return result)
  )
  (fn-do + demand-getter _
    (param receiver TypeId)
    (param name Atom)
    (param syntax SyntaxId (= 0))
    (let callee (call getter-instance receiver name))
    (if (and (!= callee no-instance) (!= syntax 0))
      (call (. facts record-call) (. frame instance) syntax callee .call-getter (. scratch no-fills) false)
    )
  )
  (fn-do + demand-module-getter _
    (param module ModuleId)
    (param name Atom)
    (param syntax SyntaxId)
    ; A getter a module declares, which the reference's lowering reads of its own accord at a
    ; node: typed, and recorded there as a call.
    (let decls (. ([] (. program modules) module) decls))
    (for (in position (..< 0 (. decls length)))
      (match? ([] decls position)
        (case (call .decl-function fn)
          (if (and (== (. fn owner) 0) (== (. fn kind) .getter-decl) (== (. fn name) name))
            (let decl (as position DeclId))
            (let callee
              (call (. instances intern)
                (block
                  (arg module)
                  (arg decl)
                  (arg no-type)
                  (arg (call callee-effects frame module decl))
                  (arg no-instance)
                )
              )
            )
            (call (. (!! host) demand) callee)
            (call (. facts record-call)
              (block
                (arg (. frame instance))
                (arg syntax)
                (arg callee)
                (arg .call-getter)
                (arg (. scratch no-fills))
                (arg false)
              )
            )
            (return)
          )
        )
      )
    )
  )
  (fn-do + demand-task-value TypeId
    (param syntax SyntaxId)
    ; The `Task` a `do new` used as a value gives, which `task-started` of core makes from the record
    ; the runtime keeps of how the task ends: typed, and recorded at the node as a call.
    (let task (call (. types well-known-type) "core/task" "Task"))
    (let pointer (call (. types well-known-type) "core" "Pointer"))
    (if (or (== task invalid-type) (== pointer invalid-type))
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) pointer)
    (let callee
      (call demand-runtime-call
        (block
          (arg (. (call class-ref types task) module))
          (arg no-type)
          (arg (call (. program store-atom) "task-started"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== callee no-instance)
      (return invalid-type)
    )
    (call (. facts record-call) (. frame instance) syntax callee .call-function (. scratch no-fills) false)
    (return task)
  )
  (fn-do + demand-runtime-call InstanceId
    (param module ModuleId)
    (param receiver TypeId)
    (param name Atom)
    (param mark ScratchMark)
    (param explicit-count Size (= 0))
    ; A function a module declares, or a method of `receiver`, which compiled code calls of its
    ; own accord with no node to record the call at, for the types pushed since `mark`: the first
    ; `explicit-count` are its type arguments, and the rest those of its arguments. It is typed as
    ; a call written in that module is, or no instance where none takes them.
    (let shapes-mark (. scratch call-arguments mark))
    (let count (- (. scratch types length) mark explicit-count))
    (for (in _ (..< 0 count))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
    )
    (let shapes (call (. scratch call-arguments since) shapes-mark))
    (let given (call (. scratch types since) (+ mark explicit-count)))
    (let local (call local-ranking module))
    (call (. local begin) shapes given)
    (if (!= explicit-count 0)
      (call (. local explicit-params) (call (. scratch types span) mark explicit-count))
    )
    (let hit (? Hit) null)
    (if (== receiver no-type)
      (= hit (call (. local dispatch-function) no-type name))
      (else
        (= hit (call (. local dispatch-method) receiver name))
      )
    )
    (let callee no-instance)
    (if (and hit (not (call (. local ambiguity))))
      (let declared (call declared-effects program (. hit module) (. hit decl)))
      (= callee
        (call intern-settled
          (block
            (arg hit)
            (arg (call dispatch-effects (/or/ (call exceptional-effects (. frame surround effects)) declared)))
          )
        )
      )
    )
    (call (. local release))
    (call (. scratch call-arguments rewind) shapes-mark)
    (if (and (!= callee no-instance) host)
      (call (. host demand) callee)
    )
    (return callee)
  )
  (fn-do + answer-door _
    (param door DeclId)
    (param effect U32)
    (param declared TypeId)
    ; Types a door under a `do with` that binds a fake to its effect as a call of the fake's method of
    ; the door's name that takes the door's arguments, with the fake its effect's slot holds, and
    ; gives what the door gives. The method runs as at the `do with`, under what was bound to the
    ; effect there, and so does what it calls (`Instances.handled-by`). A fake answers only a door
    ; that is a function of its module. Where the door states its errors, the method raises only those,
    ; or classes below them. One the fake cannot answer panics, where only a door a function value
    ; reaches calls it; elsewhere that is reported (`Restrictions.report-swaps`).
    (let module (. frame module))
    (let own (. frame instance))
    (let effects (. ([] (. instances rows) own) effects))
    (let entry (call (. instances swap-entry-of) effects effect))
    (let fake (. ([] (. instances swap-entries) (- entry 1)) fake))
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) module) decls) door)
      (case (call .decl-function fn)
        (if (and (== (. fn owner) 0) (== (. fn kind) .function-decl))
          (= name (. fn name))
        )
      )
    )
    (let syntax (. frame declaration syntax))
    (let effect-module (as ([] (. program effects modules) effect) ModuleId))
    (let effect-decl (as ([] (. program effects decls) effect) DeclId))
    (if (not name)
      (call (. facts swap-forwards append)
        (block
          (arg (call SwapForward own no-instance effect-module effect-decl effect .swap-unanswerable))
        )
      )
      (call (. instances mark-may-panic) own)
      (return)
    )
    (let signature ([] (. instances signatures) own))
    (let mark (. scratch types mark))
    (for (in position (..< 0 (. signature args count)))
      (call (. scratch types push) (call (. instances argument-type) own position))
    )
    (let shapes-mark (. scratch call-arguments mark))
    (for (in _ (..< 0 (. signature args count)))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
    )
    (let local (call local-ranking (. (call class-ref types fake) module)))
    (call (. local begin) (call (. scratch call-arguments since) shapes-mark) (call (. scratch types since) mark))
    (let hit (call (. local dispatch-method) fake name))
    (let callee no-instance)
    (if (and hit (not (call (. local ambiguity))) (call is-own-method hit fake))
      (let handled (call (. instances handled-by) effects entry))
      (= callee
        (call intern-settled
          (block
            (arg hit)
            (arg (call dispatch-effects (/or/ handled (call declared-effects program (. hit module) (. hit decl)))))
          )
        )
      )
    )
    (call (. local release))
    (call (. scratch call-arguments rewind) shapes-mark)
    (call (. scratch types rewind) mark)
    (if (== callee no-instance)
      (call (. facts swap-forwards append)
        (block
          (arg (call SwapForward own no-instance effect-module effect-decl effect .swap-missing))
        )
      )
      (call (. instances mark-may-panic) own)
      (return)
    )
    (let matches (== (. ([] (. instances signatures) callee) args count) (. signature args count)))
    (for (in position (..< 0 (. signature args count)))
      (if (and matches (!= (call (. instances argument-type) callee position) (call (. instances argument-type) own position)))
        (= matches false)
      )
    )
    (if (and matches (!= (call demand-return callee syntax) declared))
      (= matches false)
    )
    (if (and matches (== (. ([] (. instances signatures) own) error-state) .errors-stated))
      (call (. (!! host) demand-errors) callee)
      (= matches (call raises-within callee own))
    )
    (if (not matches)
      (call (. facts swap-forwards append)
        (block
          (arg (call SwapForward own no-instance effect-module effect-decl effect .swap-mismatched))
        )
      )
      (call (. instances mark-may-panic) own)
      (return)
    )
    (call (. facts swap-forwards append)
      (block
        (arg (call SwapForward own callee effect-module effect-decl effect .swap-answered))
      )
    )
    (call (. facts record-call) own syntax callee .call-method (. scratch no-fills) false false)
    (call (. facts stack-reads append) (call StackRead own syntax effect-module effect-decl))
  )
  (fn-do _ raises-within Bool
    (param callee InstanceId)
    (param door InstanceId)
    ; Whether each error a fake's method raises is one a door states, or a class below one.
    (let raised (. ([] (. instances signatures) callee) errors))
    (let stated (. ([] (. instances signatures) door) errors))
    (for (in position (..< (. raised start) (+ (. raised start) (. raised count))))
      (let error ([] (. instances signature-types) position))
      (let taken false)
      (for (in place (..< (. stated start) (+ (. stated start) (. stated count))))
        (if (call is-subtype types error ([] (. instances signature-types) place))
          (= taken true)
        )
      )
      (if (not taken)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ is-own-method Bool
    (param hit Hit)
    (param fake TypeId)
    ; Whether a method a fake's class dispatches to is one an object of it is called with: declared by
    ; the class or one it is derived from, and not static.
    (match? ([] (. ([] (. program modules) (. hit module)) decls) (. hit decl))
      (case (call .decl-function fn)
        (return (and (!= (. fn owner) 0) (not (. fn is-static))))
      )
    )
    (return false)
  )
  (fn-do _ getter-instance InstanceId
    (param receiver TypeId)
    (param name Atom)
    ; The getter that answers a property of a type, typed, or none. A ranking in the middle of a
    ; dispatch is kept aside meanwhile.
    (let busy (call suspend-ranking))
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-getter) receiver name))
    (call note-interface-call receiver hit)
    (let callee no-instance)
    (if (and hit (not (call (. ranking ambiguity))))
      (= callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) false))
      (call (. (!! host) demand) callee)
    )
    (call (. ranking release))
    (call close-site site)
    (call resume-ranking busy)
    (return callee)
  )
  (fn-do + step-getters (list InstanceId)
    (param places (list U32))
    (param site SyntaxId (= 0))
    ; The getter that answers each property read on the way to what a type delegates to, typed
    ; as this function runs it and recorded as its call, or none for a property the type stores.
    ; The call has no node of its own, or is made at a `site`, kept apart from the calls of the
    ; node there.
    (let getters (list InstanceId))
    (for (in place places)
      (let property ([] (. types properties) place))
      (let getter no-instance)
      (if (and (== (. property storage-kind) .storage-getter) (!= (. property owner) no-type))
        (= getter (call getter-instance (. property owner) (. property name)))
        (if (!= getter no-instance)
          (call (. facts record-call)
            (block
              (arg (. frame instance))
              (arg site)
              (arg getter)
              (arg .call-getter)
              (arg (. scratch no-fills))
              (arg false)
              (arg (== site 0))
            )
          )
        )
      )
      (+= getters getter)
    )
    (return getters)
  )
  (fn-do + protocol-call ProtocolCall
    (param receiver TypeId)
    (param name Atom)
    (param site SyntaxId)
    (param argument TypeId (= no-type))
    (param propagates Bool (= false))
    (param second TypeId (= no-type))
    (param third TypeId (= no-type))
    (param links Bool (= true))
    (param named (? Atom) (= null))
    (param restricted Bool (= true))
    ; A method the compiler calls on a value without a call in the source: the iteration
    ; protocol of a loop's container, the protocol of a stream a pattern runs on, a method of a
    ; helper a pattern is given, or the one a markup loop region is given its container again by.
    ; Its instance and the witnesses of its implementors follow. Its errors panic the loop, but
    ; those of a call that `propagates`, which the reference makes as any call, leave the function
    ; with it, as a loop's read of a generator that raises does. A call that `links` is kept among
    ; those of its node. The first argument is given by the name `named` where there is one. Gives
    ; the call recorded and what it answers: the invalid type where there is no such method or what it
    ; answers is not known yet. One not `restricted` is typed as declared, outside the restrictions
    ; of the code that calls it, as it is recorded only for what it answers.
    (let fact no-fact)
    (let opened (call open-site))
    (let count U32)
    (if (!= argument no-type)
      (call push-argument argument 0 named)
      (= count 1)
    )
    (if (!= second no-type)
      (call push-argument second 0)
      (= count 2)
    )
    (if (!= third no-type)
      (call push-argument third 0)
      (= count 3)
    )
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (call note-interface-call receiver hit)
    (let result invalid-type)
    (if (and hit (not (call (. ranking ambiguity))))
      (let effects
        (block
          (case? restricted
            (call callee-effects frame (. hit module) (. hit decl))
          )
          (default
            (call declared-effects program (. hit module) (. hit decl))
          )
        )
      )
      (let callee (call intern-hit hit effects true))
      (call (. (!! host) demand) callee)
      (call (. (!! host) demand-errors) callee)
      (= fact
        (call (. facts record-call)
          (block
            (arg (. frame instance))
            (arg site)
            (arg callee)
            (arg .call-method)
            (arg (. scratch no-fills))
            (arg false)
            (arg links)
          )
        )
      )
      (call pair-receiver receiver (. hit receiver))
      (for (in position (..< 0 count))
        (if (< position (. hit fills length))
          (let relation ([] (. hit relations) position))
          (call (. facts record-pair) (. frame instance) (. relation from) ([] (. hit args) position) relation)
        )
      )
      (let signature ([] (. instances signatures) callee))
      (if (and propagates (!= (. signature errors count) 0))
        (for (in offset (..< 0 (. signature errors count)))
          (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) site)
        )
        (call (. facts mark-propagates) (. frame instance) site)
        (else
          (for (in offset (..< 0 (. signature errors count)))
            (let raised ([] (. instances signature-types) (+ (. signature errors start) offset)))
            (call (. conversions demand-converter) raised (. types string-type))
          )
          (if (!= (. signature errors count) 0)
            (call (. conversions demand-error-report))
          )
        )
      )
      (if (!= (. signature return-state) .return-pending)
        (= result (. signature returns))
      )
    )
    (call (. ranking release))
    (call close-site opened)
    (return (call ProtocolCall fact result))
  )
  (fn-do + keep-protocol-through _
    (param fact FactId)
    (param places (list U32))
    ; Notes at a call `protocol-call` recorded the properties read from the value it is made for to
    ; reach the one it is made on, as `keep-through` notes them at a call written.
    (if (or (== fact no-fact) (== (. places length) 0))
      (return)
    )
    (= (. ([] (. facts calls) fact) through) (call (. facts keep-steps) places (call step-getters places)))
  )
  (fn-do + content-call ProtocolCall
    (param receiver TypeId)
    (param name Atom)
    (param site SyntaxId)
    (param argument TypeId)
    ; A method a markup element takes a line of its body with, which no call in the source
    ; writes: the one of the name that the value is an argument of, but one that would take what
    ; an optional holds, which the reference passes over. Its errors leave the function with the
    ; call, as those of a call written do. Gives the call recorded, kept apart from the calls of the
    ; line, and the type the method takes; no type where the element has no such method. What the
    ; method answers is no type where it answers nothing, and the invalid type where that is not
    ; known yet.
    (let fact no-fact)
    (let answer no-type)
    (let opened (call open-site))
    (call push-argument argument site)
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (let taken no-type)
    (if (and hit (not ambiguous) (== (. hit fills length) 1) (!= (. ([] (. hit relations) 0) kind) .relation-unwrap-cast))
      (call note-interface-call receiver hit)
      (let callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) true))
      (call (. (!! host) demand) callee)
      (call (. (!! host) demand-errors) callee)
      (= fact
        (call (. facts record-call)
          (block
            (arg (. frame instance))
            (arg site)
            (arg callee)
            (arg .call-method)
            (arg (. scratch no-fills))
            (arg false)
            (arg false)
          )
        )
      )
      (call pair-receiver receiver (. hit receiver))
      (call (. facts record-pair) (. frame instance) (. ([] (. hit relations) 0) from) ([] (. hit args) 0) ([] (. hit relations) 0))
      (let signature ([] (. instances signatures) callee))
      (for (in offset (..< 0 (. signature errors count)))
        (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) site)
      )
      (if (!= (. signature errors count) 0)
        (= (. ([] (. facts calls) fact) propagates) true)
      )
      (= taken ([] (. hit args) 0))
      (if (== (. signature return-state) .return-pending)
        (= answer invalid-type)
        (else-if (!= (. signature returns) (. types void-type))
          (= answer (. signature returns))
        )
      )
    )
    (lazy ambiguous (call (. ranking ambiguity)))
    (call (. ranking release))
    (call close-site opened)
    (return (call ProtocolCall fact answer taken))
  )
  (fn-do + protocol-call ProtocolCall
    (param receiver TypeId)
    (param name Atom)
    (param site SyntaxId)
    (param given (list TypeId))
    (param linked Bool (= false))
    ; A method an object is called with values the compiler holds, which no call in the source
    ; writes, as `content-call` calls one: the one of the name that takes values of the types given
    ; as they are, in order. Gives the call recorded, kept apart from the calls of the line unless
    ; `linked`, or none where the receiver has no such method, and what it answers, as
    ; `content-call` says.
    (let fact no-fact)
    (let answer no-type)
    (let opened (call open-site))
    (for (in type given)
      (call push-argument type site)
    )
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (let fits (and hit (not (call (. ranking ambiguity))) (== (. hit fills length) (. given length))))
    (for (in position (..< 0 (. given length)))
      (= fits (and fits (== (. ([] (. (!! hit) relations) position) kind) .relation-same)))
    )
    (if fits
      (call note-interface-call receiver (!! hit))
      (let callee (call intern-hit (!! hit) (call callee-effects frame (. (!! hit) module) (. (!! hit) decl)) true))
      (call (. (!! host) demand) callee)
      (call (. (!! host) demand-errors) callee)
      (= fact
        (call (. facts record-call)
          (block
            (arg (. frame instance))
            (arg site)
            (arg callee)
            (arg .call-method)
            (arg (. scratch no-fills))
            (arg false)
            (arg linked)
          )
        )
      )
      (call pair-receiver receiver (. (!! hit) receiver))
      (let signature ([] (. instances signatures) callee))
      (for (in offset (..< 0 (. signature errors count)))
        (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) site)
      )
      (if (!= (. signature errors count) 0)
        (= (. ([] (. facts calls) fact) propagates) true)
      )
      (if (== (. signature return-state) .return-pending)
        (= answer invalid-type)
        (else-if (!= (. signature returns) (. types void-type))
          (= answer (. signature returns))
        )
      )
    )
    (call (. ranking release))
    (call close-site opened)
    (return (call ProtocolCall fact answer))
  )
  (fn-do _ push-carried _
    (param context U32)
    ; Pushes the types of the values a context gives (`context-values`): the type of its state cells,
    ; `StyleScopeState`, once for each, then those of the values of the rules around rules written in
    ; rules.
    (if (== (call (. instances context-values) context) 0)
      (return)
    )
    (let count (call (. instances context-cell-count) context))
    (if (!= count 0)
      (let cell (call (. types well-known-type) "core/style" "StyleScopeState"))
      (call (. types complete) cell)
      (for (in _ (..< 0 count))
        (call (. scratch types push) cell)
      )
    )
    (let held ([] (. instances contexts) context))
    (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
      (call (. scratch types push) ([] (. instances context-value-types) position))
    )
  )
  (fn-do + filler-call FactId
    (param receiver TypeId)
    (param site SyntaxId)
    (param slots (list Atom))
    (param builders (list TypeId))
    (param context U32 (= (. U32 max)))
    ; The call of the function that fills an object of a class with the markup written in the
    ; class, which no call in the source writes (`filler-instance`). No fact where the receiver is no
    ; class, or the function raises an error, which has no shape here.
    (let callee (call filler-instance receiver slots builders context))
    (if (== callee no-instance)
      (return no-fact)
    )
    (call (. (!! host) demand) callee)
    (call (. (!! host) demand-errors) callee)
    (if (!= (. ([] (. instances signatures) callee) errors count) 0)
      (return no-fact)
    )
    (return (call (. facts record-call) (. frame instance) site callee .call-method (. scratch no-fills) false false))
  )
  (fn-do + filler-instance InstanceId
    (param receiver TypeId)
    (param slots (list Atom))
    (param builders (list TypeId))
    (param context U32 (= (. U32 max)))
    ; The function that fills an object of a class with the markup written in the class: the class's
    ; own, typed for the class as the receiver holds it, and for the slots of the names given, in
    ; order, each given a builder of the type beside it, and for the styles and style sheets of a
    ; `context`, whose state cells it takes before the builders. None where the receiver is no class
    ; that has one.
    (let ref (call class-ref types receiver))
    (let filler DeclId 0)
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class class)
        (= filler (. class content-function))
      )
    )
    (if (== filler 0)
      (return no-instance)
    )
    (let params-mark (. scratch types mark))
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (for (in position (..< 0 (. row args count)))
          (call (. scratch types push) (call (. types child-type) (. row args) position))
        )
      )
    )
    (let params (call (. scratch types since) params-mark))
    (let args-mark (. scratch types mark))
    (let slots-mark (. scratch words mark))
    (call push-carried context)
    (for (in offset (..< 0 (. slots length)))
      (call (. scratch types push) ([] builders offset))
      (call (. scratch words push) (call (. instances slot-id) ([] slots offset)))
    )
    (let args (call (. scratch types since) args-mark))
    (let places (call (. scratch words since) slots-mark))
    (let effects (call callee-effects frame (. ref module) filler))
    (let callee
      (call (. instances intern)
        (block
          (arg (. ref module))
          (arg filler)
          (arg receiver)
          (arg effects)
          (arg no-instance)
          (arg params)
          (arg args)
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg no-type)
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg places)
          (arg context)
        )
      )
    )
    (call (. scratch words rewind) slots-mark)
    (call (. scratch types rewind) params-mark)
    (return callee)
  )
  (fn-do + demand-method InstanceId
    (param receiver TypeId)
    (param name Atom)
    (let opened (call open-site))
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver name))
    (let callee no-instance)
    (if (and hit (not (call (. ranking ambiguity))))
      (= callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) true))
      (call (. (!! host) demand) callee)
    )
    (call (. ranking release))
    (call close-site opened)
    (return callee)
  )
  (fn-do + protocol-getter TypeId
    (param receiver TypeId)
    (param name Atom)
    (param syntax SyntaxId (= 0))
    ; A getter the reference's loop lowering reads on a container: a cursor iterable's initial
    ; state, whose type the stepping call takes.
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-getter) receiver name))
    (call note-interface-call receiver hit)
    (let result invalid-type)
    (if (and hit (not (call (. ranking ambiguity))))
      (let callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) false))
      (call (. (!! host) demand) callee)
      (if (!= syntax 0)
        (call (. facts record-call) (. frame instance) syntax callee .call-getter (. scratch no-fills) false)
      )
      (let signature ([] (. instances signatures) callee))
      (if (!= (. signature return-state) .return-pending)
        (= result (. signature returns))
      )
    )
    (call (. ranking release))
    (call close-site site)
    (return result)
  )
  (fn-do + index-item TypeId
    (param receiver TypeId)
    (param site SyntaxId (= 0))
    (let opened (call open-site))
    (call push-argument (. types index-type) 0)
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver (!! (. types index-op-atom))))
    (call note-interface-call receiver hit)
    (let result invalid-type)
    (if (and hit (not (call (. ranking ambiguity))))
      (let callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) true))
      (call (. (!! host) demand) callee)
      (if (!= site 0)
        (call (. facts record-call) (. frame instance) site callee .call-operator (. scratch no-fills) false)
      )
      (call pair-receiver receiver (. hit receiver))
      (let size (. types size-type))
      (let index (. types index-type))
      (call (. facts record-pair) (. frame instance) size index (call side-cast-relation size index))
      (let signature ([] (. instances signatures) callee))
      (if (!= (. signature return-state) .return-pending)
        (= result (. signature returns))
      )
    )
    (call (. ranking release))
    (call close-site opened)
    (return result)
  )
  (fn-do + index-item-type TypeId
    (param receiver TypeId)
    (let opened (call open-site))
    (call push-argument (. types index-type) 0)
    (call (. ranking begin) (. opened shapes) (. opened types))
    (let hit (call (. ranking dispatch-method) receiver (!! (. types index-op-atom))))
    (let result invalid-type)
    (if (and hit (not (call (. ranking ambiguity))))
      (let names-mark (. scratch names mark))
      (let items-mark (. scratch types mark))
      (let arguments (call no-type-arguments types))
      (let signature (call signature-into types (. hit module) (. hit decl) arguments (. hit receiver) true))
      (= result (. signature returns))
      (call (. scratch types rewind) items-mark)
      (call (. scratch names rewind) names-mark)
    )
    (call (. ranking release))
    (call close-site opened)
    (return result)
  )
  (fn-do + has-operator Bool
    (param receiver TypeId)
    (param name Atom)
    (param arg TypeId)
    (param second TypeId (= no-type))
    (param arg-syntax SyntaxId (= 0))
    ; Whether a type declares an operator of a name for arguments of types, as a call from this
    ; module finds it, which every other asking of the module finds too. An argument written as an
    ; integer with no suffix may be taken as any type that holds it, so what is found for it is
    ; found for that argument alone.
    (let literal (!= (call (. conversions literal-of) arg-syntax) 0))
    (let query (call OperatorQuery (. ranking caller) receiver name arg second))
    (let known (if-expr literal null ([] (. scratch operators) query)))
    (if (!= known null)
      (return known)
    )
    (let site (call open-site))
    (call push-argument arg (if-expr literal arg-syntax 0))
    (if (!= second no-type)
      (call push-argument second 0)
    )
    (call (. ranking begin) (. site shapes) (. site types))
    (let found (!= (call (. ranking dispatch-method) receiver name) null))
    (call (. ranking release))
    (call close-site site)
    (if (not literal)
      (= ([] (. scratch operators) query) found)
    )
    (return found)
  )
  (fn-do + concat-call _
    (param id SyntaxId)
    (param right SyntaxId)
    (param piece TypeId)
    (let site (call open-site))
    (call push-argument piece right)
    (call (. ranking begin) (. site shapes) (. site types))
    (= (. ranking texts) true)
    (let hit (call (. ranking dispatch-method) (. types string-type) (!! (. types concat-atom))))
    (= (. ranking texts) false)
    (if hit
      (call commit-hit id hit .call-operator (. site syntax))
      (else-if (not (call (. ranking ambiguity)))
        (call (. frame diagnose) id .illegal-operation null (. types string-type) piece)
      )
    )
    (call (. ranking release))
    (call close-site site)
  )
  (fn-expr _ stores-back Bool
    (param receiver TypeId)
    ; Whether what `[]=` answers for an object of a type is stored back in the object when it
    ; is of that type: for a struct, for a number, and for a text, where the assignment then
    ; gives the text stored.
    (or (== kind .struct) (== kind .string) (and (call intrinsic-is-numeric kind) (!= kind .cpointer)))
    (where
      (lazy kind (call (. types intrinsic-of) receiver))
    )
  )
  (fn-do + index-assign-call TypeId
    (param id SyntaxId)
    (param object TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    (param rhs SyntaxId)
    (param value TypeId)
    (param value-at-site Bool (= false))
    (param literal-value Bool (= false))
    (let name (!! (. types index-assign-atom)))
    (let site (call open-site))
    (call push-argument key key-syntax)
    (call push-argument value rhs)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-method) object name))
    (call note-interface-call object hit)
    (let ambiguous (call (. ranking ambiguity)))
    (let result invalid-type)
    (if (and hit ambiguous)
      (call (. ranking release))
      (call (. frame diagnose) id ambiguous name)
      (else-if hit
        (let callee (call commit-hit id hit .call-operator (. site syntax)))
        (let answered
          (scope (and stored-back (== (call demand-return callee id) (. hit receiver)))
            (lazy stored-back (and (!= callee no-instance) (call stores-back (. hit receiver))))
          )
        )
        (if answered
          (call (. facts set-plan) (. frame instance) id .plan-store-answer)
        )
        (if value-at-site
          (let expected-value ([] (. hit args) 1))
          (if (!= expected-value value)
            (call (. conversions convert) id rhs value expected-value .reason-argument)
          )
        )
        (let stored ([] (. hit args) 1))
        (let numeric (and (call is-numeric types value) (call is-numeric types stored)))
        (let adapted (and literal-value (== (call (. facts node-type) (. frame instance) rhs) stored)))
        (= result (if-expr (and numeric (or (not literal-value) adapted)) stored value))
        (if (and answered (== (call (. types intrinsic-of) (. hit receiver)) .string))
          (= result (. hit receiver))
        )
        (call (. ranking release))
      )
      (else
        (call (. ranking release))
        (call (. frame diagnose) id .illegal-operation name object value)
      )
    )
    (call close-site site)
    (return result)
  )
  (fn-do + index-store-through _
    (param id SyntaxId)
    (param held SyntaxId)
    (param container TypeId)
    (param key TypeId)
    (param item TypeId)
    ; An index of an index assigned, where what `[]=` answers for the item is planned to be
    ; stored: the answer is assigned to the inner index in turn, through the `[]=` of the object
    ; the inner index reads from, as TypeScript does. The function is recorded at the inner
    ; index. It is asked with the key as the inner index has it and the item as answered, and
    ; no conversion is recorded for either: emission refuses where one would be needed.
    (if (!= (call (. facts plan-of) (. frame instance) id) .plan-store-answer)
      (return)
    )
    (let site (call open-site))
    (call push-argument key 0)
    (call push-argument item 0)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-method) container (!! (. types index-assign-atom))))
    (if (and hit (not (call (. ranking ambiguity))))
      (let callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
      (if (and (!= callee no-instance) host)
        (call (. host demand) callee)
        (call (. facts record-call) (. frame instance) held callee .call-store-through (. hit fills) false)
      )
    )
    (call (. ranking release))
    (call close-site site)
  )
  (fn-do + getter-call TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param capture (? RowCapture) (= null))
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (= (. ranking row-case) (if-expr capture receiver no-type))
    (let hit (call adapt-row receiver (call (. ranking dispatch-getter) receiver name) capture))
    (call note-interface-call receiver hit)
    (let delegated (and hit (call (. ranking delegates-to) receiver (. hit receiver))))
    (if delegated
      (= delegator receiver)
    )
    (let on-row (and hit capture (== (. hit receiver) (. capture row))))
    (if (and hit (!= (. hit receiver) receiver) (not (call (. ranking ambiguity))) (not delegated) (not on-row))
      (call (. conversions convert)
        (block
          (arg object-syntax)
          (arg object-syntax)
          (arg receiver)
          (arg (. hit receiver))
          (arg (call receiver-reason id object-syntax))
        )
      )
    )
    (if (and hit (call is-virtual-receiver receiver))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (let callee (call resolve-hit id .call-getter (. site syntax) .property-not-found hit name))
    (= interning null)
    (call (. ranking release))
    (call close-site site)
    (if (== callee no-instance)
      (return invalid-type)
    )
    (if (not on-row)
      (call pair-receiver receiver (. (!! hit) receiver))
    )
    (return (call demand-return callee id))
  )
  (fn-do _ adapt-row (? Hit)
    (param receiver TypeId)
    (param hit (? Hit))
    (param capture (? RowCapture) (= null))
    ; A member called on a name that stands for the case of a row runs on the row, as TypeScript's
    ; `table-row-extension` runs it: one of the case itself on the case's cells, an instance of
    ; its own, and one of a base every case shares on the row itself, an extension's member of
    ; that base among them though it runs on the case elsewhere.
    (if (or (not hit) (not capture) (call (. ranking ambiguity)))
      (return hit)
    )
    (let found (if-expr (!= (. hit level) no-type) (. hit level) (. hit receiver)))
    (if (== found receiver)
      (= interning capture)
      (return hit)
    )
    (if (not (call shares-row-base (. capture row) found))
      (return hit)
    )
    (return
      (call Hit
        (block
          (arg (. hit module))
          (arg (. hit decl))
          (arg (. capture row))
          (arg (. hit params))
          (arg (. hit args))
          (arg (. hit fills))
          (arg (. hit relations))
          (arg (. hit tail-fills))
          (arg (. hit tail-relations))
          (arg true)
          (arg (. hit level))
        )
      )
    )
  )
  (fn-do _ shares-row-base Bool
    (param row TypeId)
    (param base TypeId)
    ; Whether every case of the union a row is a row of derives from a base.
    (let union (call class-arg types row 0))
    (if (or (== union no-type) (!= (call (. types intrinsic-of) union) .union))
      (return false)
    )
    (let shared (call (. types shared-case-base) union))
    (while (!= shared no-type)
      (if (== shared base)
        (return true)
      )
      (= shared (call (. types shared-case-base) union shared))
    )
    (return false)
  )
  (fn-do + setter-call TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param rhs SyntaxId)
    (param value TypeId)
    (param form CallForm (= (. CallForm call-setter)))
    (let site (call open-site))
    (call push-argument value rhs)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-setter) receiver name))
    (call note-interface-call receiver hit)
    (let delegated (and hit (call (. ranking delegates-to) receiver (. hit receiver))))
    (if delegated
      (= delegator receiver)
    )
    (if (and hit (!= (. hit receiver) receiver) (not (call (. ranking ambiguity))) (not delegated))
      (call (. conversions convert)
        (block
          (arg object-syntax)
          (arg object-syntax)
          (arg receiver)
          (arg (. hit receiver))
          (arg (call receiver-reason id object-syntax))
        )
      )
    )
    (if (and hit (call is-virtual-receiver receiver))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (let callee (call resolve-hit id form (. site syntax) .function-not-found hit name))
    (call (. ranking release))
    (let result invalid-type)
    (if (!= callee no-instance)
      (call pair-receiver receiver (. (!! hit) receiver))
      (let returned (call demand-return callee id))
      (= result (if-expr (or (== returned (. types void-type)) (== returned no-type)) value returned))
    )
    (call close-site site)
    (return result)
  )
  (fn-do + module-getter-call TypeId
    (param id SyntaxId)
    (param name Atom)
    (let site (call open-site))
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-module-getter) name))
    (let callee (call resolve-hit id .call-getter (. site syntax) .property-not-found hit name))
    (call (. ranking release))
    (call close-site site)
    (return (if-expr (!= callee no-instance) (call demand-return callee id) invalid-type))
  )
  (fn-do + module-setter-call TypeId
    (param id SyntaxId)
    (param name Atom)
    (param rhs SyntaxId)
    (param value TypeId)
    (param form CallForm (= (. CallForm call-setter)))
    (let site (call open-site))
    (call push-argument value rhs)
    (call (. ranking begin) (. site shapes) (. site types))
    (let hit (call (. ranking dispatch-module-setter) name))
    (let callee (call resolve-hit id form (. site syntax) .function-not-found hit name))
    (call (. ranking release))
    (let result invalid-type)
    (if (!= callee no-instance)
      (let returned (call demand-return callee id))
      (= result (if-expr (or (== returned (. types void-type)) (== returned no-type)) value returned))
    )
    (call close-site site)
    (return result)
  )
  (fn-do _ admits-value-call Bool
    (param id SyntaxId)
    (let restricted
      (block
        (scope (/or/ heap-free (. CompilationEffect no-safepoint) (. CompilationEffect no-suspend) (call ban-bits))
          (lazy heap-free (/or/ (. CompilationEffect gc-free) (. CompilationEffect no-heap)))
        )
      )
    )
    (return-if true (if (== (/and/ (call dispatch-effects (. frame surround effects)) restricted) 0)))
    (blank)
    (call (. frame diagnose)
      (block
        (arg id)
        (arg .restricted)
        (arg (call (. program store-atom) "Function value call requires unrestricted effects"))
      )
    )
    (return false)
  )
  (fn-do _ note-interface-call _
    (param receiver TypeId)
    (param hit (? Hit))
    (if (or (not hit) (. hit is-extension) (call (. ranking ambiguity)))
      (return)
    )
    (if (or (== receiver no-type) (!= (. ([] (. types completions) receiver) intrinsic) .interface))
      (return)
    )
    (let owner (call declaring-interface (. hit receiver) (. hit module) (. hit decl)))
    (if (or (== owner no-type) (!= (. ([] (. types completions) owner) intrinsic) .interface))
      (return)
    )
    (call (. facts record-witness-func) owner (. hit module) (. hit decl))
    (call (. facts record-witness-call) (. hit receiver) (. hit module) (. hit decl))
  )
  (fn-do _ declaring-interface TypeId
    (param receiver TypeId)
    (param module ModuleId)
    (param decl DeclId)
    ; The interface that declares a function called on a receiver, among the receiver and the
    ; interfaces it is derived from, as the reference fills the function's slot in that interface's
    ; part of a table. The receiver where the function belongs to no interface found.
    (let owner DeclId 0)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (= owner (. fn owner))
      )
    )
    (if (or (== owner 0) (== receiver no-type))
      (return receiver)
    )
    (let pending (list TypeId))
    (+= pending receiver)
    (let position 0)
    (while (< position (. pending length))
      (let current ([] pending position))
      (let ref (call class-ref types current))
      (if (and (== (. ref module) module) (== (. ref decl) owner))
        (return current)
      )
      (for (in parent (call (. types interfaces-of) current))
        (if (== (call (. pending find) parent) null)
          (+= pending parent)
        )
      )
      (+= position 1)
    )
    (return receiver)
  )
  (fn-do _ inherits-from Bool
    (param type TypeId)
    (param base TypeId)
    (let above (call (. types base-of) type))
    (while above
      (return-if true (if (== above base)))
      (blank)
      (= above (call (. types base-of) above))
    )
    (return false)
  )
  (fn-expr _ receiver-reason ConversionReason
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    ; Why the receiver of a call is converted: as the receiver of the function the call is in where
    ; the call writes none, its own node then standing for the receiver, and else as the one written.
    (if-expr (== object-syntax id) (. ConversionReason reason-own-receiver) as-written)
    (where
      (lazy as-written (. ConversionReason reason-receiver))
    )
  )
  (fn-do _ pair-receiver _
    (param receiver TypeId)
    (param expected TypeId)
    (if (== receiver expected)
      (call (. facts record-pair) (. frame instance) receiver expected (call same-relation receiver))
      (return)
    )
    (let relation (call (. relations compare) receiver expected false false null (. frame module)))
    (call (. facts record-pair) (. frame instance) receiver expected relation)
  )
  (fn-do _ resolve-hit InstanceId
    (param id SyntaxId)
    (param form CallForm)
    (param syntax (of ImmutableArray SyntaxId ArenaBacking))
    (param missing TypeDiagnosticKind)
    (param hit (? Hit))
    (param name (? Atom))
    (param missing-site SyntaxId (= 0))
    (param receiver TypeId (= no-type))
    (param piped SyntaxId (= 0))
    ; A call of a function that a property the receiver delegates to answers keeps, with the
    ; call, the properties read from the receiver to what the function takes. A call that may take a
    ; function whose parameters write a type that names nothing stops there, as TypeScript's does.
    (let owner delegator)
    (= delegator no-type)
    (if (!= (. ranking missing-site) 0)
      (let message (call (. program store-atom) "Type not found"))
      (let site (. ranking missing-site))
      (call (. facts record-diagnostic) (. frame instance) (. ranking missing-module) site .stated message)
      (return no-instance)
    )
    (if hit
      (let ambiguous (call (. ranking ambiguity)))
      (if ambiguous
        (call (. frame diagnose) id ambiguous name)
        (return no-instance)
      )
      (let callee (call commit-hit id hit form syntax false piped))
      (if (!= owner no-type)
        (call keep-through id callee owner (. hit receiver))
      )
      (return callee)
    )
    (if (. ranking partial)
      (call commit-partial id (. ranking partial) form)
      (let open (call unresolved-param (!! (. ranking partial))))
      (if open
        (let message (str "Could not resolve parameter " (. open text)))
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
        (return no-instance)
      )
    )
    (call (. frame diagnose) (if-expr (!= missing-site 0) missing-site id) missing name)
    (if (and (!= receiver no-type) name)
      (call (. facts note-members) (call (. ranking extension-functions) receiver name))
    )
    (return no-instance)
  )
  (fn-do _ prove-casts _
    (param hit Hit)
    (param syntax (of ImmutableArray SyntaxId ArenaBacking))
    ; Records each argument written as a cast to the type the call takes it as, where the call,
    ; ranked again with what is cast in its place, chooses the same function the same way
    ; (`ContextCastFact`). A cast that changes the type of what it casts to a type written with the
    ; type parameters, or to one the call binds a parameter to, is kept, since it may choose the
    ; function. A call given a function is not ranked again, since ranking types the function for
    ; what each candidate passes it.
    (if (or (not (. facts traces-lint)) (!= (call (. ranking ambiguity)) null) (call answers-table-index))
      (return)
    )
    (for (in position (..< 0 (. ranking shape-count)))
      (let kind (. ([] (. types completions) (call (. ranking given-at) (as position U32))) intrinsic))
      (if (or (== kind .closure) (== kind .binding))
        (return)
      )
    )
    (for (in position (..< 0 (. syntax length)))
      (let written ([] syntax position))
      (match? ([] (. frame tree nodes) written)
        (case (call .node-argument row)
          (= written (. row expr))
        )
      )
      (let fill (as position U32))
      (match? ([] (. frame tree nodes) written)
        (case (call .node-cast-expression row)
          (let target (call (. ranking given-at) fill))
          (if (== (call (. types evaluate-type) (. frame module) (. frame tree) (. row rhs) (. frame env)) target)
            (let source (call (. facts node-type) (. frame instance) (. row lhs)))
            (if (or (== source target) (not (call (. frame names-type-param) (. row rhs))))
              (call prove-cast hit fill written source (call (. conversions literal-of) (. row lhs)))
            )
          )
        )
        (case .node-integer-syntax
          (call prove-suffix hit fill written)
        )
        (case .node-float-syntax
          (call prove-suffix hit fill written)
        )
      )
    )
  )
  (fn-do _ note-case-owners _
    (param hit Hit)
    (param syntax (of ImmutableArray SyntaxId ArenaBacking))
    ; Records the types candidates took each argument that is a case named by its symbol alone as a
    ; case of, where they took it as one of more than one (`CaseOwnerFact`).
    (if (not (. facts traces-lint))
      (return)
    )
    (let noted (list CaseOwnerNote))
    (call (. ranking symbol-owners-noted) hit noted)
    (for (in note noted)
      (if (< (. note fill) (. syntax length))
        (let fact
          (call CaseOwnerFact
            (block
              (arg (. frame instance))
              (arg ([] syntax (. note fill)))
              (arg (. note name))
              (arg (. note owner))
              (arg (. note chosen))
            )
          )
        )
        (call (. facts case-owners append) fact)
      )
    )
  )
  (fn-do _ prove-suffix _
    (param hit Hit)
    (param fill U32)
    (param literal SyntaxId)
    (if (!= (call (. conversions suffix-type) literal) (call (. ranking given-at) fill))
      (return)
    )
    (let saved (. conversions unsuffixed))
    (= (. conversions unsuffixed) literal)
    (call prove-cast hit fill literal (call (. conversions unsuffixed-type) literal) literal)
    (= (. conversions unsuffixed) saved)
  )
  (fn-do _ prove-cast _
    (param hit Hit)
    (param fill U32)
    (param cast SyntaxId)
    (param source TypeId)
    (param literal SyntaxId)
    (let target (call (. ranking given-at) fill))
    (if (or (== source no-type) (== source invalid-type) (!= (call slot-type hit fill) target))
      (return)
    )
    (if (!= source target)
      (for (in param (. hit params))
        (if (== param target)
          (return)
        )
      )
    )
    (let mark (. scratch types mark))
    (for (in position (..< 0 (. ranking shape-count)))
      (let given (as position U32))
      (call (. scratch types push) (if-expr (== given fill) source (call (. ranking given-at) given)))
    )
    (let shadow (call Ranking (. frame session) (. frame module)))
    (let again
      (call (. shadow replay)
        (block
          (arg ranking)
          (arg (call (. scratch types since) mark))
          (arg (if-expr (!= literal 0) fill (. U32 max)))
          (arg literal)
        )
      )
    )
    (let chosen (and (!= again null) (== (. shadow missing-site) 0) (== (call (. shadow ambiguity)) null)))
    (let same (and chosen (call same-hit hit (!! again)) (== (call slot-type (!! again) fill) target)))
    (call (. shadow release))
    (call (. scratch types rewind) mark)
    (if same
      (let fact (call ContextCastFact (. frame instance) cast .cast-argument target))
      (call (. facts context-casts append) fact)
    )
  )
  (fn-do + note-context-cast _
    (param value SyntaxId)
    (param expected TypeId)
    (param kind ContextCastKind)
    ; Records a value written as a cast to the type its place takes it as, where what is cast
    ; converts to that type without it, for the rule that reads how it is written
    ; (`ContextCastFact`). An argument cast from another type to one written with the type
    ; parameters is not, since it may choose what is called, nor a cast whose value is not of the
    ; type written, as a cast to a stream keeps what it casts.
    (if (or (not (. facts traces-lint)) (== expected no-type) (== expected invalid-type))
      (return)
    )
    (let written value)
    (match? ([] (. frame tree nodes) written)
      (case (call .node-argument row)
        (= written (. row expr))
      )
    )
    (match? ([] (. frame tree nodes) written)
      (case (call .node-cast-expression row)
        (let source (call (. facts node-type) (. frame instance) (. row lhs)))
        (let target (call (. facts node-type) (. frame instance) written))
        (if (or (!= target expected) (== source no-type) (== source invalid-type))
          (return)
        )
        (if (!= (call (. types evaluate-type) (. frame module) (. frame tree) (. row rhs) (. frame env)) target)
          (return)
        )
        (let named (call (. frame names-type-param) (. row rhs)))
        (if (and (== kind .cast-argument) named (!= source expected))
          (return)
        )
        (if (call (. conversions fits-unasked) (. row lhs) expected)
          (let fact (call ContextCastFact (. frame instance) written kind expected))
          (call (. facts context-casts append) fact)
        )
      )
    )
    (call note-suffixes written expected kind)
  )
  (fn-do _ note-suffixes _
    (param value SyntaxId)
    (param expected TypeId)
    (param kind ContextCastKind)
    (match? ([] (. frame tree nodes) value)
      (case .node-integer-syntax
        (call note-suffix value expected kind)
      )
      (case .node-float-syntax
        (call note-suffix value expected kind)
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .else-op)
          (match? ([] (. frame tree nodes) (. row lhs))
            (case (call .node-binary-expression chosen)
              (let yes (call (. facts node-type) (. frame instance) (. chosen lhs)))
              (let no (call (. facts node-type) (. frame instance) (. row rhs)))
              (if (and (== (. chosen op) .if-op) (== yes expected) (== no expected))
                (call note-suffixes (. chosen lhs) expected kind)
                (call note-suffixes (. row rhs) expected kind)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ note-suffix _
    (param literal SyntaxId)
    (param expected TypeId)
    (param kind ContextCastKind)
    (let suffixed (call (. conversions suffix-type) literal))
    (if (and (!= suffixed no-type) (== suffixed expected) (call (. conversions unsuffixed-fits) literal expected))
      (call (. facts context-casts append) (call ContextCastFact (. frame instance) literal kind expected))
    )
  )
  (fn-do + note-operand-suffix _
    (param operand SyntaxId)
    (param other SyntaxId)
    (param beside TypeId)
    (if (or (not (. facts traces-lint)) (call written-number other))
      (return)
    )
    (let suffixed (call (. conversions suffix-type) operand))
    (if (and (!= suffixed no-type) (== (call (. conversions unsuffixed-beside) operand beside) suffixed))
      (call (. facts context-casts append) (call ContextCastFact (. frame instance) operand .cast-operand suffixed))
    )
  )
  (fn-do _ written-number Bool
    (param syntax SyntaxId)
    (return-if true (if (!= (call (. conversions literal-of) syntax) 0)))
    (blank)
    (match? ([] (. frame tree nodes) syntax)
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case (call .node-unary-expression row)
        (return (and (== (. row op) .negative-op) (call written-number (. row operand))))
      )
    )
    (return false)
  )
  (fn-expr _ answers-table-index Bool
    ; Whether the call is an index of a table or of a view of one by an integer, or an assignment
    ; through one, which TypeScript answers itself without choosing a function.
    (case? (or (!= (. ranking request) .request-method) (not name) (== (. ranking shape-count) 0))
      false
    )
    (case? (and (not assigns) (!= name (!! (. types index-op-atom))))
      false
    )
    (case? (and (not tables) (not spans) (not columns) (not selects))
      false
    )
    (default
      (or assigns (call is-integer-kind (call (. types intrinsic-of) (call (. ranking given-at) 0))))
    )
    (where
      (lazy name (. ranking request-name))
      (lazy assigns (== name (!! (. types index-assign-atom))))
      (lazy kind (call (. types intrinsic-of) (. ranking request-receiver)))
      (lazy tables (or (== kind .table) (== kind .immutable-table) (== kind .index-span)))
      (lazy spans (or (== kind .table-span) (== kind .immutable-table-span)))
      (lazy columns (or (== kind .table-column) (== kind .immutable-table-column)))
      (lazy selects (or (== kind .table-selection) (== kind .immutable-table-selection)))
    )
  )
  (fn-do _ slot-type TypeId
    (param hit Hit)
    (param fill U32)
    ; The type a hit takes an argument as: that of the slot the argument fills, or the item of the
    ; list its variadic tail is made into.
    (for (in position (..< 0 (. hit fills length)))
      (if (== ([] (. hit fills) position) fill)
        (return ([] (. hit args) position))
      )
    )
    (for (in offset (..< 0 (. hit tail-fills length)))
      (if (== ([] (. hit tail-fills) offset) fill)
        (return (. ([] (. hit tail-relations) offset) to))
      )
    )
    (return no-type)
  )
  (fn-do _ same-hit Bool
    (param one Hit)
    (param other Hit)
    ; Whether two hits choose the same function the same way: on the same receiver, binding the
    ; same type parameters and taking each argument slot as the same type.
    (if (or (!= (. one module) (. other module)) (!= (. one decl) (. other decl)) (!= (. one receiver) (. other receiver)))
      (return false)
    )
    (if (or (!= (. one level) (. other level)) (!= (. one is-extension) (. other is-extension)))
      (return false)
    )
    (if (or (!= (. one params length) (. other params length)) (!= (. one args length) (. other args length)))
      (return false)
    )
    (for (in position (..< 0 (. one params length)))
      (if (!= ([] (. one params) position) ([] (. other params) position))
        (return false)
      )
    )
    (for (in position (..< 0 (. one args length)))
      (if (!= ([] (. one args) position) ([] (. other args) position))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ keep-through _
    (param id SyntaxId)
    (param callee InstanceId)
    (param owner TypeId)
    (param held TypeId)
    ; Notes at a call that a property its receiver delegates to answers the properties read
    ; from the receiver to reach what the function takes, in the order they are read. A call the
    ; receiver's own type answers has none. A property on the way that a getter answers is read
    ; by a call of the getter, which is typed for the type that declares it and kept with the
    ; step; the caller calls it, with no node of its own.
    (let places (list U32))
    (if (not (call (. ranking delegate-path) owner held places))
      (return)
    )
    (let getters (call step-getters places))
    (let fact (call (. facts first-call) (. frame instance) id))
    (while (!= fact no-fact)
      (if (and (== (. ([] (. facts calls) fact) callee) callee) (== (. ([] (. facts calls) fact) through count) 0))
        (= (. ([] (. facts calls) fact) through) (call (. facts keep-steps) places getters))
        (return)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
  )
  (fn-do _ unresolved-param (? Atom)
    (param hit Hit)
    ; The first type parameter a call gave its candidate no way to work out.
    (let names-mark (. scratch names mark))
    (let items-mark (. scratch types mark))
    (let module Index (. hit module))
    (let signature
      (call signature-into
        (block
          (arg types)
          (arg (as module ModuleId))
          (arg (. hit decl))
          (arg (call no-type-arguments types))
          (arg (. hit receiver))
          (arg true)
        )
      )
    )
    (let open (? Atom) null)
    (for (in position (..< 0 (. hit params length)))
      (if (and (not open) (< position (. signature params length)))
        (if (. ([] (. types completions) ([] (. hit params) position)) has-variables)
          (= open ([] (. signature params) position))
        )
      )
    )
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
    (return open)
  )
  (fn-do _ commit-partial _
    (param id SyntaxId)
    (param hit Hit)
    (param form CallForm)
    (let callee (call intern-hit hit (call callee-effects frame (. hit module) (. hit decl)) true false))
    (call (. facts record-call) (. frame instance) id callee form (. hit fills) true)
  )
  (fn-do _ commit-hit InstanceId
    (param id SyntaxId)
    (param hit Hit)
    (param form CallForm)
    (param syntax (of ImmutableArray SyntaxId ArenaBacking))
    (param deferred Bool (= false))
    (param piped SyntaxId (= 0))
    ; Turns the winning candidate into the callee instance and records what the call site learned:
    ; the pair relation per argument, literal fits, conversions, enum symbols, the list a variadic
    ; tail is made into, and default conversions. An integer written with no suffix that a parameter
    ; holds takes the parameter's type, and needs no conversion. Where an argument of the tail has a name or a
    ; bullet `•?`, what it gives the list before its conversion is kept at the argument: the
    ; tuple of its name and its value, or what it holds where it is present. A tail with a bullet
    ; `•?` appends each argument to the list, by a call recorded at the argument. A list of one
    ; bullet piped into the call at `piped` is converted for a reason of its own, apart from the
    ; pipe's value, which is kept at the same node: the first argument written at the pipe. A case
    ; named by its symbol alone is a case of the parameter's type where that type has it, as the
    ; reference casts it there, whatever type the call was ranked with; one that several types have,
    ; cast to a parameter type without it, is of none of them (`keeps-symbol`). What is known of
    ; properties ends at the call, unless the compiler answers it in place (`answered-in-place`) or
    ; that is left to the caller (`deferred`).
    (call prove-casts hit syntax)
    (call note-case-owners hit syntax)
    (let empty U32 (. ArgumentFill fill-empty))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (let callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    (let at-site (call is-argument-form form))
    (let piped-fill (. U32 max))
    (if (and (!= piped 0) (== id piped))
      (for (in offset (..< 0 (. syntax length)))
        (if (== ([] syntax offset) piped)
          (= piped-fill (as offset U32))
          (break)
        )
      )
    )
    (if (and (not deferred) (not (call answered-in-place callee)))
      (call (. frame forget-members))
    )
    (for (in position (..< 0 (. hit fills length)))
      (let fill ([] (. hit fills) position))
      (if (and (!= fill empty) (!= fill variadic))
        (let relation ([] (. hit relations) position))
        (let arg-syntax ([] syntax fill))
        (let site (call argument-site arg-syntax))
        (let expected ([] (. hit args) position))
        (if (or (== (. ([] (. types completions) expected) intrinsic) .or) (call (. relations holds-alternatives) expected))
          (= expected (. relation to))
        )
        (let shape (call (. ranking shape-at) fill))
        (let symbol (. shape symbol))
        (if symbol
          (let target
            (scope (if-expr (call (. types is-optional) expected) expected-inner expected)
              (lazy expected-inner (call (. types optional-inner) expected))
            )
          )
          (let holds (!= (call symbols-type types program target shape) invalid-type))
          (if (and (!= (. relation from) target) holds)
            (= relation (call (. relations compare) target expected false false null (. frame module)))
          )
          (call (. facts set-node-type) (. frame instance) site (. relation from))
          (if (. shape other-symbol)
            (call (. (!! host) note-symbol-choice) (. relation from) (call argument-expr arg-syntax))
            (else
              (call (. (!! host) note-enum-case) (. relation from) symbol site holds)
              (if (call keeps-symbol site (. relation from) expected symbol)
                (call settle-later site symbol)
              )
            )
          )
        )
        (let applied relation)
        (let mismatched (and (== (. relation kind) .relation-same) (!= (. relation from) expected)))
        (let unbound (and (== (. relation to) (. relation unified)) (call (. types is-generic) (. relation to))))
        (if (and mismatched (not (. ([] (. types completions) expected) has-variables)))
          (let fresh (call (. relations compare) (. relation from) expected false false null (. frame module)))
          (if (call relation-legal fresh)
            (= applied fresh)
          )
          (else-if (and unbound (not (call (. types is-generic) expected)))
            (= (. applied to) expected)
            (= (. applied unified) expected)
          )
        )
        (if records-pairs
          (call (. facts record-pair) (. frame instance) (. applied from) expected applied)
        )
        (call (. conversions check-literal-fit) site expected)
        (let adapted (call (. conversions adapted-literal) site (. applied from) expected))
        (if (!= adapted (. applied from))
          (let refit (call (. relations compare) adapted expected false false null (. frame module)))
          (if (call relation-legal refit)
            (= applied refit)
          )
        )
        (let recast (call recast-property hit position expected))
        (let reason ConversionReason (if-expr (== fill piped-fill) .reason-piped .reason-argument))
        (if (and (!= recast 0) (!= (. applied from) (. types null-type)))
          (call convert-recast arg-syntax (. applied from) expected callee recast)
          (else-if (call holds-callable (. applied from) expected)
            (call (. conversions convert) arg-syntax arg-syntax (. applied from) expected reason)
          )
          (else-if (!= (. applied kind) .relation-same)
            (call (. conversions record-conversion) arg-syntax applied reason at-site no-type arg-syntax)
          )
        )
        (if (call (. types is-optional) (. relation from))
          (call convert-default arg-syntax hit callee position true)
        )
      )
    )
    (let listed no-type)
    (for (in position (..< 0 (. hit fills length)))
      (if (== ([] (. hit fills) position) variadic)
        (= listed ([] (. hit args) position))
      )
    )
    (let appends false)
    (for (in fill (. hit tail-fills))
      (if (. (call (. ranking shape-at) fill) is-optional)
        (= appends true)
      )
    )
    (for (in offset (..< 0 (. hit tail-fills length)))
      (let relation ([] (. hit tail-relations) offset))
      (let arg-syntax ([] syntax ([] (. hit tail-fills) offset)))
      (let shape (call (. ranking shape-at) ([] (. hit tail-fills) offset)))
      (if (or (. shape name) (. shape is-optional))
        (call (. facts set-node-type) (. frame instance) arg-syntax (. relation from))
      )
      (if appends
        (call note-append arg-syntax listed (. relation to))
      )
      (if records-pairs
        (call (. facts record-pair) (. frame instance) (. relation from) (. relation to) relation)
      )
      (let site (call argument-site arg-syntax))
      (call (. conversions check-literal-fit) site (. relation to))
      (let adapted (call (. conversions adapted-literal) site (. relation from) (. relation to)))
      (if (!= adapted (. relation from))
        (let refit (call (. relations compare) adapted (. relation to) false false null (. frame module)))
        (if (call relation-legal refit)
          (= relation refit)
        )
      )
      (if (!= (. relation kind) .relation-same)
        (call (. conversions record-conversion)
          (block
            (arg arg-syntax)
            (arg relation)
            (arg .reason-element)
            (arg at-site)
            (arg no-type)
            (arg arg-syntax)
          )
        )
      )
    )
    (for (in position (..< 0 (. hit fills length)))
      (let fill ([] (. hit fills) position))
      (if (== fill variadic)
        (call note-list id ([] (. hit args) position))
      )
      (if (== fill empty)
        (call convert-default id hit callee position false)
      )
    )
    (call (. facts record-call) (. frame instance) id callee form (. hit fills) false)
    (for (in position (..< 0 (. hit fills length)))
      (let fill ([] (. hit fills) position))
      (if (and (!= fill empty) (!= fill variadic))
        (call (. (!! host) note-given) id (call argument-expr ([] syntax fill)) callee (as position U32))
      )
    )
    (let live (call live-name hit))
    (if live
      (call (. (!! host) note-live-call) id live)
    )
    (return callee)
  )
  (fn-do _ live-name (? Atom)
    (param hit Hit)
    (let owner-module ([] (. program modules) (. hit module)))
    (match? ([] (. owner-module decls) (. hit decl))
      (case (call .decl-function fn)
        (match? ([] (. owner-module tree nodes) (. fn syntax))
          (case (call .node-function-syntax row)
            (return-if (. fn name) (if (. row is-live)))
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ argument-site SyntaxId
    (param syntax SyntaxId)
    (match ([] (. frame tree nodes) syntax)
      (case (call .node-argument row)
        (if-expr (not (. row name)) (. row expr) syntax)
      )
      (default
        syntax
      )
    )
  )
  (fn-expr _ argument-expr SyntaxId
    (param syntax SyntaxId)
    (match ([] (. frame tree nodes) syntax)
      (case (call .node-argument row)
        (. row expr)
      )
      (default
        syntax
      )
    )
  )
  (fn-expr _ is-argument-form Bool
    (param form CallForm)
    (match form
      (case= .call-function
        true
      )
      (case= .call-method
        true
      )
      (case= .call-static
        true
      )
      (case= .call-constructor
        true
      )
      (case= .call-this-constructor
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ convert-default _
    (param site SyntaxId)
    (param hit Hit)
    (param callee InstanceId)
    (param position Size)
    (param is-given Bool)
    ; The default a parameter declares, converted to the parameter's type where a call takes it:
    ; at the call for an argument it leaves out, and at an argument it gives that is an optional,
    ; which takes the default when it holds no value. The callee types the default then, if no call
    ; took it before, as a tuple's constructor types the value written for a field a call leaves out.
    ; A default is cast to the parameter's type, as `as` casts it, whether the parameter writes that
    ; type or the call decides it for a type parameter.
    (let owner-module ([] (. program modules) (. hit module)))
    (match? ([] (. owner-module decls) (. hit decl))
      (case (call .decl-function fn)
        (if (and (. fn is-generated) (== (. fn kind) .tuple-constructor-decl) (not is-given))
          (call (. (!! host) type-default) callee (as position U32))
          (return)
        )
        (if (>= position (. fn args count))
          (return)
        )
        (let start Index (. fn args start))
        (let shape ([] (. owner-module arg-pool) (+ start position)))
        (if (== (. shape default-syntax) 0)
          (return)
        )
        (call (. (!! host) type-default) callee (as position U32))
        (let env (call (. types env-frame)))
        (let tree (. owner-module tree))
        (let owner Index (. hit module))
        (let literal (call literal-type types (as owner ModuleId) tree (. shape default-syntax) env))
        (call (. types env-release) env)
        (let expected ([] (. hit args) position))
        (match? ([] (. tree nodes) (. shape default-syntax))
          (case (call .node-symbol row)
            (= literal (call contextual-symbol types relations expected (. row name) (as owner ModuleId)))
          )
        )
        (if (or (== literal invalid-type) (== literal expected))
          (return)
        )
        (if (not is-given)
          (call (. conversions convert) site site literal expected .reason-default true true)
          (return)
        )
        (let relation (call (. conversions compare-held) literal expected))
        (if (call relation-legal relation)
          (call (. conversions record-conversion) site relation .reason-default true)
        )
      )
    )
  )
  (fn-do + note-list _
    (param syntax SyntaxId)
    (param list TypeId)
    ; Records what a list written is made with: the constructor that makes the empty list, the
    ; function that reserves room for its items, and the one that answers where the array the
    ; list keeps them in holds them. A call's variadic tail is such a list, recorded at the call.
    ; The list is made in the zone it is written in, as TypeScript makes it.
    (if (or (== list invalid-type) (== list no-type))
      (return)
    )
    (let made (call demand-constructor list (. scratch types mark) true))
    (if (!= made no-instance)
      (call (. facts record-call) (. frame instance) syntax made .call-list-make (. scratch no-fills) false)
    )
    (let reserves (call reserve-instance list))
    (if (!= reserves no-instance)
      (call (. facts record-call) (. frame instance) syntax reserves .call-list-reserve (. scratch no-fills) false)
    )
    (let held (call (. types property-named) list (!! (. types items-atom))))
    (if (not held)
      (return)
    )
    (let shapes-mark (. scratch call-arguments mark))
    (let types-mark (. scratch types mark))
    (let local (call Ranking (. frame session) (. frame module)))
    (call (. local begin) (call (. scratch call-arguments since) shapes-mark) (call (. scratch types since) types-mark))
    (let hit (call (. local dispatch-getter) (. ([] (. types properties) held) type) (!! (. types data-atom))))
    (let reads no-instance)
    (if hit
      (= reads (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    )
    (call (. local release))
    (if (and (!= reads no-instance) host)
      (call (. host demand) reads)
      (call (. facts record-call) (. frame instance) syntax reads .call-list-data (. scratch no-fills) false)
    )
  )
  (fn-do + note-replaced-read _
    (param syntax SyntaxId)
    (param object TypeId)
    (param key TypeId)
    ; Records at an index an array is stored at the read of what the index holds first, given the
    ; key the store takes, which the runtime is then told the storage of.
    (if (or (== object no-type) (== object invalid-type) (== key no-type) (== key invalid-type))
      (return)
    )
    (let shapes-mark (. scratch call-arguments mark))
    (let types-mark (. scratch types mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (call (. scratch types push) key)
    (let local (call Ranking (. frame session) (. frame module)))
    (call (. local begin) (call (. scratch call-arguments since) shapes-mark) (call (. scratch types since) types-mark))
    (let hit (call (. local dispatch-method) object (!! (. types index-op-atom))))
    (let callee no-instance)
    (if (and hit (not (call (. local ambiguity))))
      (= callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    )
    (call (. local release))
    (call (. scratch types rewind) types-mark)
    (call (. scratch call-arguments rewind) shapes-mark)
    (if (or (== callee no-instance) (not host) (!= (call (. instances argument-type) callee 0) key))
      (return)
    )
    (call (. host demand) callee)
    (call (. instances mark-may-panic) (. frame instance))
    (let fills-start (. scratch words mark))
    (call (. scratch words push) 0)
    (call (. facts record-call)
      (block
        (arg (. frame instance))
        (arg syntax)
        (arg callee)
        (arg .call-replaced)
        (arg (call (. scratch words since) fills-start))
        (arg false)
      )
    )
    (call (. scratch words rewind) fills-start)
  )
  (fn-do + plan-array-item _
    (param syntax SyntaxId)
    (param key TypeId)
    (param first FactId)
    (param read TypeId)
    ; TypeScript reads an item of an array of numbers by an index, or a field of numbers of an item
    ; of an array of structs, where the array's storage holds it, when the index is less than the
    ; array's size, and calls the function that answers for an index the array does not hold
    ; anywhere else. Where `first` is the call of `[]` recorded at the index, of ReadableArray's
    ; own on an array, and `read` the type of the number read, the call then names that function.
    (if (>= first (. facts calls length))
      (return)
    )
    (let fact ([] (. facts calls) first))
    (if (or (!= (. fact syntax) syntax) (!= (. fact form) .call-operator) (not (call reads-array-item (. fact callee) read)))
      (return)
    )
    (let receiver (. ([] (. instances rows) (. fact callee)) self-type))
    (let shapes-mark (. scratch call-arguments mark))
    (let types-mark (. scratch types mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (call (. scratch types push) key)
    (let local (call Ranking (. frame session) (. types readable-array-decl module)))
    (call (. local begin) (call (. scratch call-arguments since) shapes-mark) (call (. scratch types since) types-mark))
    (let hit (call (. local dispatch-method) receiver (!! (. types absent-atom))))
    (let callee no-instance)
    (if (and hit (not (call (. local ambiguity))))
      (= callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    )
    (call (. local release))
    (call (. scratch types rewind) types-mark)
    (call (. scratch call-arguments rewind) shapes-mark)
    (if (or (== callee no-instance) (not host) (!= (call (. instances argument-type) callee 0) (. types index-type)))
      (return)
    )
    (call (. host demand) callee)
    (= (. ([] (. facts calls) first) callee) callee)
    (call (. facts set-plan) (. frame instance) syntax .plan-array-item)
  )
  (fn-do _ reads-array-item Bool
    (param callee InstanceId)
    (param read TypeId)
    ; Whether `[]` is ReadableArray's own of an index, called on an array, for a read of a number
    ; TypeScript reads where it lies: a number, a truth or a character of 1, 8, 16, 32 or 64 bits,
    ; or a C pointer to what is itself a pointer.
    (if (or (== callee no-instance) (!= (. ([] (. instances signatures) callee) args count) 1) not-indexed)
      (return false)
    )
    (lazy not-indexed (!= (call (. instances argument-type) callee 0) (. types index-type)))
    (let own ([] (. instances rows) callee))
    (let readable (. types readable-array-decl))
    (if (!= (. own module) (. readable module))
      (return false)
    )
    (let owned false)
    (match? ([] (. ([] (. program modules) (. own module)) decls) (. own decl))
      (case (call .decl-function fn)
        (= owned (== (. fn owner) (. readable decl)))
      )
    )
    (if (not owned)
      (return false)
    )
    (let arrayed false)
    (match? ([] (. types rows) (. own self-type))
      (case (call .type-class row)
        (= arrayed
          (scope (and of-array (== (. row args count) 2))
            (lazy of-array (or (call (. types array-decl refers-to) (. row module) (. row decl)) (call (. types immutable-array-decl refers-to) (. row module) (. row decl))))
          )
        )
      )
    )
    (if (or (not arrayed) (== read no-type) (== read invalid-type))
      (return false)
    )
    (return (call is-array-number read))
  )
  (fn-do + stores-array-item Bool
    (param callee InstanceId)
    (if (or (== callee no-instance) (!= (. ([] (. instances signatures) callee) args count) 2) not-indexed)
      (return false)
    )
    (lazy not-indexed (!= (call (. instances argument-type) callee 0) (. types index-type)))
    (let own ([] (. instances rows) callee))
    (let array (. types array-decl))
    (if (!= (. own module) (. array module))
      (return false)
    )
    (let owned false)
    (match? ([] (. ([] (. program modules) (. own module)) decls) (. own decl))
      (case (call .decl-function fn)
        (= owned (== (. fn owner) (. array decl)))
      )
    )
    (let stored (call (. instances argument-type) callee 1))
    (if (or (not owned) (== stored no-type) (== stored invalid-type))
      (return false)
    )
    (return (call is-array-number stored))
  )
  (fn-do _ is-array-number Bool
    (param read TypeId)
    (call (. types complete) read)
    (let held ([] (. types completions) read))
    (if (not (call intrinsic-is-numeric (. held intrinsic)))
      (return false)
    )
    (if (== (. held intrinsic) .cpointer)
      (let pointee (call pointee-of types read))
      (call (. types complete) pointee)
      (if (not (. ([] (. types completions) pointee) is-pointer))
        (return false)
      )
    )
    (return
      (scope (or narrow (== (. held bit-size) 16) (== (. held bit-size) 32) (== (. held bit-size) 64))
        (lazy narrow (or (== (. held bit-size) 1) (== (. held bit-size) 8)))
      )
    )
  )
  (fn-do + note-append _
    (param syntax SyntaxId)
    (param list TypeId)
    (param item TypeId)
    (param form CallForm (= (. CallForm call-method)))
    ; Records at an argument of a variadic tail the call of `append` that adds its item to the
    ; list the tail is made into.
    (if (or (== list no-type) (== list invalid-type) (== item invalid-type))
      (return)
    )
    (let shapes-mark (. scratch call-arguments mark))
    (let types-mark (. scratch types mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (call (. scratch types push) item)
    (let local (call Ranking (. frame session) (. frame module)))
    (call (. local begin) (call (. scratch call-arguments since) shapes-mark) (call (. scratch types since) types-mark))
    (let hit (call (. local dispatch-method) list (!! (. types append-atom))))
    (let callee no-instance)
    (if (and hit (not (call (. local ambiguity))))
      (= callee (call intern-settled hit (call callee-effects frame (. hit module) (. hit decl))))
    )
    (call (. local release))
    (call (. scratch types rewind) types-mark)
    (call (. scratch call-arguments rewind) shapes-mark)
    (if (and (!= callee no-instance) host)
      (call (. host demand) callee)
      (let fills-start (. scratch words mark))
      (call (. scratch words push) 0)
      (call (. facts record-call)
        (block
          (arg (. frame instance))
          (arg syntax)
          (arg callee)
          (arg form)
          (arg (call (. scratch words since) fills-start))
          (arg false)
        )
      )
      (call (. scratch words rewind) fills-start)
    )
  )
  (fn-do + reserve-instance InstanceId
    (param receiver TypeId)
    (if (or (== receiver invalid-type) (== receiver no-type))
      (return no-instance)
    )
    (let ref (call class-ref types receiver))
    (if (== (. ref module) (. U32 max))
      (return no-instance)
    )
    (let wanted (!! (. types reserve-atom)))
    (let owner-module ([] (. program modules) (. ref module)))
    (let members (call (of RowRange DeclId)))
    (match? ([] (. owner-module decls) (. ref decl))
      (case (call .decl-class row)
        (= members (. row members))
      )
    )
    (for (in member (call (. owner-module members-named) members wanted))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-function fn)
          (if (and (== (. fn kind) .function-decl) (. fn name) (== (. fn name) wanted) (== (. fn args count) 1))
            (let mark (. scratch types mark))
            (call (. scratch types push) (. types size-type))
            (let effects (call callee-effects frame (. ref module) member))
            (let size-arg (call (. scratch types since) mark))
            (let none (. scratch no-types))
            (let callee
              (call (. instances intern)
                (block
                  (arg (. ref module))
                  (arg member)
                  (arg receiver)
                  (arg effects)
                  (arg no-instance)
                  (arg none)
                  (arg size-arg)
                )
              )
            )
            (call (. scratch types rewind) mark)
            (call (. (!! host) demand) callee)
            (return callee)
          )
        )
      )
    )
    (return no-instance)
  )
  (fn-expr + open-site CallSite
    ; Marks the scratch stacks for one synthesized call site; push-argument fills it and close-site
    ; releases it. The spans read the runs pushed so far, so take them after the last push.
    (call CallSite (. scratch call-arguments mark) (. scratch types mark) (. scratch syntax mark) scratch)
  )
  (fn-do + push-argument _
    (param type TypeId)
    (param syntax SyntaxId)
    (param name (? Atom) (= null))
    (let literal (if-expr (!= syntax 0) (call (. conversions literal-of) syntax) 0))
    (call (. scratch call-arguments push) (call CallArgument name false false false false null literal))
    (call (. scratch types push) type)
    (call (. scratch syntax push) syntax)
  )
  (fn-do + close-site _
    (param site CallSite)
    (call (. scratch syntax rewind) (. site syntax-mark))
    (call (. scratch types rewind) (. site types-mark))
    (call (. scratch call-arguments rewind) (. site shapes-mark))
  )
  (fn-do _ intern-settled InstanceId
    (param hit Hit)
    (param effects EffectMask)
    (let empty U32 (. ArgumentFill fill-empty))
    (let variadic U32 (. ArgumentFill fill-variadic))
    (let provided-only (call is-tuple-constructor (. hit module) (. hit decl)))
    (let args-mark (. scratch types mark))
    (for (in position (..< 0 (. hit fills length)))
      (let fill ([] (. hit fills) position))
      (if (or (not provided-only) (!= fill empty))
        (let expected ([] (. hit args) position))
        (if (and (!= fill empty) (!= fill variadic))
          (if (or (== (call (. types intrinsic-of) expected) .or) (call (. relations holds-alternatives) expected))
            (= expected (. ([] (. hit relations) position) to))
          )
        )
        (call (. scratch types push) expected)
      )
    )
    (let fills-mark (. scratch words mark))
    (let chosen
      (scope (and (!= (. constructing receiver) no-type) (== (. hit receiver) (. constructing receiver)) same-decl)
        (lazy same-decl (and (== (. hit module) (. constructing module)) (== (. hit decl) (. constructing decl))))
      )
    )
    (if (and chosen (. constructing fills))
      (call push-fills hit)
    )
    (let given (if-expr chosen (. constructing context) (. U32 max)))
    (call push-carried given)
    (let slots-mark (. scratch words mark))
    (if chosen
      (for (in offset (..< 0 (. constructing slots length)))
        (call (. scratch words push) (call (. instances slot-id) ([] (. constructing slots) offset)))
        (call (. scratch types push) ([] (. constructing builders) offset))
      )
      (= constructing (call Construction))
    )
    (let fills (call (. scratch words span) fills-mark (- slots-mark fills-mark)))
    (let slots (call (. scratch words since) slots-mark))
    (let settled (call (. scratch types since) args-mark))
    (let row interning)
    (= interning null)
    (let callee
      (call (. instances intern)
        (block
          (arg (. hit module))
          (arg (. hit decl))
          (arg (. hit receiver))
          (arg effects)
          (arg no-instance)
          (arg (. hit params))
          (arg settled)
          (arg true)
          (arg (if-expr row (. row row) no-type))
          (arg (if-expr row (. row case-index) (. U32 max)))
          (arg (and row (. row validated)))
          (arg 0)
          (arg no-type)
          (arg fills)
          (arg slots)
          (arg given)
          (arg (call (. frame zone)))
          (arg no-instance)
          (arg (call redefaulted hit))
        )
      )
    )
    (call (. scratch words rewind) fills-mark)
    (call (. scratch types rewind) args-mark)
    (return callee)
  )
  (fn-do _ redefaulted U32
    (param hit Hit)
    ; The parameters a call of a constructor of a class above the one it makes gives no value for,
    ; with a default, named as a property the class it makes writes a default of its own for, as
    ; the reference's `redefaultedArgNames` finds them: a bit for each, among the first 32.
    (let owner-module ([] (. program modules) (. hit module)))
    (let mask 0u32)
    (match? ([] (. owner-module decls) (. hit decl))
      (case (call .decl-function fn)
        (if (or unowned (== (. hit receiver) no-type) (!= (call (. types intrinsic-of) (. hit receiver)) .class))
          (return 0)
        )
        (lazy unowned (or (!= (. fn kind) .constructor-decl) (== (. fn owner) 0)))
        (let made (call class-ref types (. hit receiver)))
        (if (and (== (. made module) (. hit module)) (== (. made decl) (. fn owner)))
          (return 0)
        )
        (let empty U32 (. ArgumentFill fill-empty))
        (for (in position (..< 0 (. hit fills length)))
          (if (or (>= position 32) (>= position (. fn args count)))
            (break)
          )
          (let shape ([] (. owner-module arg-pool) (+ (. fn args start) position)))
          (if (or (!= ([] (. hit fills) position) empty) (== (. shape default-syntax) 0))
            (continue)
          )
          (let name (call pattern-name types (. owner-module tree) (. shape pattern)))
          (if (and name (call writes-default (. hit receiver) name (. hit module) (. fn owner)))
            (= mask (/or/ mask (/lshift/ 1u32 (as position U32))))
          )
        )
      )
    )
    (return mask)
  )
  (fn-do _ writes-default Bool
    (param receiver TypeId)
    (param name Atom)
    (param module ModuleId)
    (param owner DeclId)
    ; Whether a class, or one above it and below the class that declares a constructor, writes its
    ; own default for the property of a name: a property it declares of the name with a value, or a
    ; value its root `<This` gives it, as the reference's `redefaultsProperty` finds one.
    (let current receiver)
    (while (!= current no-type)
      (let ref (call class-ref types current))
      (if (and (== (. ref module) module) (== (. ref decl) owner))
        (return false)
      )
      (if (not (call (. types property-named) current name))
        (return false)
      )
      (let declaring ([] (. program modules) (. ref module)))
      (match? ([] (. declaring decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. declaring member-pool) (. class members)))
            (match? ([] (. declaring decls) member)
              (case (call .decl-property property)
                (if (and (. property name) (== (. property name) name) valued)
                  (return true)
                )
                (lazy valued (and (!= (. property value) 0) (== (. property element) 0)))
              )
            )
          )
        )
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do _ push-fills _
    (param hit Hit)
    ; The properties a markup element gives a constructor values for, apart from its arguments:
    ; each attribute that names no parameter of the constructor. The place of each among all
    ; properties is pushed on the words, and its type on the types, after the arguments. The
    ; constructor is the one the ranking, which still holds the call, has just chosen.
    (let count (. ranking shape-count))
    (if (== count 0)
      (return)
    )
    (let owner ([] (. program modules) (. hit module)))
    (match? ([] (. owner decls) (. hit decl))
      (case (call .decl-function fn)
        (for (in index (..< 0 count))
          (let shape (call (. ranking shape-at) (as index U32)))
          (if (or (not (. shape is-property)) (not (. shape name)))
            (continue)
          )
          (let shape-name (. shape name))
          (if (!= (call shape-index owner fn shape-name) (. U32 max))
            (continue)
          )
          (let place (call (. types property-named) (. hit receiver) shape-name))
          (if place
            (call (. scratch words push) (as place U32))
            (call (. scratch types push) (call (. ranking given-at) (as index U32)))
          )
        )
      )
    )
  )
  (fn-do + demand-constructor InstanceId
    (param receiver TypeId)
    (param mark ScratchMark)
    (param zoned Bool (= false))
    (param reported Bool (= false))
    ; The constructor of a value the compiler makes, chosen as a call written in the module chooses
    ; it, so a parameter typed by its default ranks with that type. It is typed outside any GC-free
    ; zone, as an error or a panic is made on the path out of one; one `zoned` is typed in the zone
    ; it is made in, and one `reported`, for a report one instance serves wherever it is made, as
    ; declared. The defaults of the parameters it leaves out are typed, as the value is made with
    ; them.
    (let shapes-mark (. scratch call-arguments mark))
    (let count (- (. scratch types length) mark))
    (for (in _ (..< 0 count))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
    )
    (let shapes (call (. scratch call-arguments since) shapes-mark))
    (let given (call (. scratch types since) mark))
    (call (. types complete) receiver)
    (let local (call local-ranking (. frame module)))
    (call (. local begin) shapes given)
    (let hit (call (. local dispatch-constructor) receiver false))
    (let callee no-instance)
    (if hit
      (let declared (call declared-effects program (. hit module) (. hit decl)))
      (let held
        (block
          (case? reported
            0u32
          )
          (case? zoned
            (. frame surround effects)
          )
          (default
            (call exceptional-effects (. frame surround effects))
          )
        )
      )
      (= callee (call intern-settled hit (call dispatch-effects (/or/ held declared))))
      (let empty U32 (. ArgumentFill fill-empty))
      (for (in position (..< 0 (. hit fills length)))
        (if (and host (== ([] (. hit fills) position) empty))
          (call (. host type-default) callee (as position U32))
        )
      )
    )
    (call (. local release))
    (call (. scratch call-arguments rewind) shapes-mark)
    (if (and (!= callee no-instance) host)
      (call (. host demand) callee)
    )
    (return callee)
  )
  (fn-expr _ intern-hit InstanceId
    (param hit Hit)
    (param effects EffectMask)
    (param with-args Bool)
    (param schedule Bool (= true))
    ; The callee instance a hit names: its declaration under the hit's type parameters and, when
    ; the call passes arguments, the expected type of every slot.
    (call (. instances intern)
      (block
        (arg (. hit module))
        (arg (. hit decl))
        (arg (. hit receiver))
        (arg effects)
        (arg no-instance)
        (arg (. hit params))
        (arg args)
        (arg schedule)
      )
    )
    (where
      (lazy args (if-expr with-args (. hit args) (. scratch no-types)))
    )
  )
  (fn-expr _ is-tuple-constructor Bool
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (== (. fn kind) .tuple-constructor-decl)
      )
      (default
        false
      )
    )
  )
  (fn-do _ demand-return TypeId
    (param callee InstanceId)
    (param call SyntaxId)
    ; A callee that has not settled its errors holds a place among those that leave the caller.
    ; A call whose type or report depends on them settles them first, and so does a call back to
    ; a function still being checked, which reads it as raising nothing so far.
    (call (. (!! host) demand) callee)
    (let deferred false)
    (if (not (call (. instances errors-known) callee))
      (let running (== (. ([] (. instances rows) callee) state) .instance-in-progress))
      (if (or (!= (. frame surround transformer-depth) 0) (!= (. frame surround catch-depth) 0) running)
        (call (. (!! host) demand-errors) callee)
        (else
          (call defer-outgoing callee call)
          (= deferred true)
        )
      )
    )
    (let signature ([] (. instances signatures) callee))
    (let returns (. signature returns))
    (if (and (!= (. signature errors count) 0) (not deferred))
      (if (!= (. frame surround transformer-depth) 0)
        (let message "Error transformer expressions must not call result-returning functions")
        (call (. frame diagnose) call .stated (call (. program store-atom) message))
        (else-if (!= (. frame surround catch-depth) 0)
          (= returns (call result-of frame signature))
        )
        (else
          (for (in offset (..< 0 (. signature errors count)))
            (let error ([] (. instances signature-types) (+ (. signature errors start) offset)))
            (call note-outgoing error call)
          )
          (call (. facts mark-propagates) (. frame instance) call)
        )
      )
    )
    (if (== (. ([] (. instances rows) callee) state) .instance-in-progress)
      (call (. instances mark-read-in-progress) callee (. frame instance))
      (return returns)
    )
    (if (== (. signature return-state) .return-pending)
      (return invalid-type)
    )
    (return returns)
  )
)
