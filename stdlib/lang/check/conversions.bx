(import ./binding)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./instances)
(import ./numeric)
(import ./signature)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import ./unit-families)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /stream/aggregate)
(blank)
(prop _ deepest-parts U32 (= 64))

(type + Conversions
  (prop + frame Frame)
  (prop + host (? Demander) (= null))
  (prop + fitter (? CallableFitter) (= null))
  (prop + unsuffixed SyntaxId)
  (prop _ types Types)
  (prop _ instances Instances)
  (prop _ relations Relations)
  (prop _ facts Facts)
  (prop _ program Program)
  (prop _ scratch TypingScratch)
  (prop _ part-depth U32)
  (prop _ part-site SyntaxId (= 0))
  (prop _ part-value SyntaxId (= 0))
  (prop _ answered TypeId (= no-type))
  (fn-do + This _
    (param frame Frame)
    (lazy types (. frame types))
    (lazy relations (. frame relations))
    (lazy scratch (. frame scratch))
    (lazy instances (. frame instances))
    (lazy facts (. frame facts))
    (lazy program (. frame program))
  )
  (fn-do + begin _
    (= host null)
    (= fitter null)
  )
  (fn-do + attach _
    (param demander Demander)
    (= host demander)
  )
  (fn-do _ note-outgoing _
    (param error TypeId)
    (param syntax SyntaxId)
    ; An error leaving the function at a node, which the checker attached hears of first.
    (if host
      (call (. host note-outgoing) error syntax)
      (else
        (call (. frame note-outgoing) error syntax)
      )
    )
  )
  (fn-do + convert TypeId
    (param syntax SyntaxId)
    (param value-syntax SyntaxId)
    (param source TypeId)
    (param target TypeId)
    (param reason ConversionReason)
    (param located Bool (= true))
    (param cast Bool (= false))
    ; A literal converts unasked to what it fits, where the target names parameters left open, as
    ; the target the value completes it to.
    (if (or (== source invalid-type) (== target invalid-type) (== source no-type) (== target no-type))
      (return invalid-type)
    )
    (if (== source target)
      (return target)
    )
    (if (== (. ([] (. types completions) source) intrinsic) .closure)
      (return (call convert-closure syntax source target reason))
    )
    (if (== (. ([] (. types completions) source) intrinsic) .binding)
      (call (. types complete) target)
      (let inner (call (. types optional-inner) target))
      (call (. types complete) inner)
      (if (and (!= inner target) (!= (call function-row types inner) no-type))
        (if (== (call convert syntax value-syntax source inner reason located) invalid-type)
          (return invalid-type)
        )
        (return (call convert syntax syntax inner target reason located))
      )
      (if (not (call binding-fits syntax source target (or cast (== reason .reason-explicit))))
        (return invalid-type)
      )
    )
    (let relation (call compare-held source target))
    (let fitted
      (block
        (case? (. ([] (. types completions) target) has-variables)
          (?? (call (. relations complete-from) target source) target)
        )
        (default
          target
        )
      )
    )
    (let asked
      (scope (or requested operates (call fitting-literal value-syntax fitted) lowers)
        (lazy requested (or cast (== reason .reason-explicit) (== reason .reason-print)))
        (lazy operates (and (== reason .reason-operator) (not (call (. relations loses-fraction) relation))))
        (lazy lowers (call lowers-facet relation reason))
      )
    )
    (if (or (not (call relation-legal relation)) (and (not asked) (not (call (. relations implicit) relation))))
      (if (call misfits-literal value-syntax target)
        (call check-literal-fit value-syntax target)
        (else
          (call report-illegal (if-expr (== reason .reason-operator) value-syntax syntax) relation source target)
        )
      )
      (return invalid-type)
    )
    (call check-literal-fit value-syntax target)
    (let chooses (== (call (. types intrinsic-of) target) .or))
    (let answer (call answer-of relation))
    (if (!= answer no-type)
      (= (. relation to) answer)
      (= (. relation unified) answer)
    )
    (if located
      (call record-conversion
        (block
          (arg syntax)
          (arg relation)
          (arg reason)
          (arg false)
          (arg (if-expr chooses target no-type))
          (arg value-syntax)
        )
      )
      (else-if (== reason .reason-return)
        (call record-conversion syntax relation .reason-literal-return false no-type value-syntax)
      )
    )
    (let open (or (. ([] (. types completions) target) has-variables) (call (. relations holds-alternatives) target)))
    (return (if-expr (or chooses open) (. relation to) target))
  )
  (fn-do _ whole-in-unit Bool
    (param syntax SyntaxId)
    (param amount F64)
    (param target TypeId)
    (let given (call (. facts node-type) (. frame instance) syntax))
    (if (not (call unit-drops-fraction types given target))
      (return false)
    )
    (return (call scales-whole amount (call (. types unit-families ratio-between) given target)))
  )
  (fn-expr _ lowers-facet Bool
    (param relation Relation)
    (param reason ConversionReason)
    ; Whether a conversion is of a facet's value to its owner as the receiver of a member of the
    ; facet, which runs on the owner's object.
    (case? (and (!= reason .reason-receiver) (!= reason .reason-own-receiver))
      false
    )
    (default
      (and (== (. relation kind) .relation-up-cast) (!= (call (. types facet-of-type) (. relation from)) null))
    )
  )
  (fn-do + answer-of TypeId
    (param relation Relation)
    ; What a converter declared to give one of several types gives: the alternative its body
    ; chooses, as the reference completes the type against the value returned. No type for any
    ; other relation, for a converter with parameters of its own, which is bound by the type
    ; declared, and for one whose answer is not known yet.
    (if (or (!= (. relation kind) .relation-converter) (== (. relation converter-module) (. U32 max)) (not host))
      (return no-type)
    )
    (if (!= (call (. types intrinsic-of) (. relation to)) .or)
      (return no-type)
    )
    (let mark (. scratch types mark))
    (let bound (call converter-params relation))
    (call (. scratch types rewind) mark)
    (if (!= bound 0)
      (return no-type)
    )
    (let signature ([] (. instances signatures) (call converter-instance relation)))
    (let returned (. signature returns))
    (if (or (== (. signature return-state) .return-pending) (== returned no-type) (== returned invalid-type))
      (return no-type)
    )
    (if (== (call (. types intrinsic-of) returned) .or)
      (return no-type)
    )
    (return returned)
  )
  (fn-do + convert-into-case _
    (param syntax SyntaxId)
    (param source TypeId)
    (param union TypeId)
    (param index U32)
    (param reason ConversionReason)
    ; Records the conversion of the value a case of a union is declared with into that union: as
    ; the case that declares it, whatever case a value of its type is held as anywhere else.
    (let relation (call compare-held source union))
    (if (or (not (call relation-legal relation)) (!= (. relation kind) .relation-wrap-cast) caseless)
      (call convert syntax syntax source union reason)
      (return)
    )
    (lazy caseless (== (. relation case-index) (. U32 max)))
    (if (!= (. ([] (call (. types cases-of) union) index) type) (. ([] (call (. types cases-of) union) (. relation case-index)) type))
      (call convert syntax syntax source union reason)
      (return)
    )
    (= (. relation case-index) index)
    (call check-literal-fit syntax union)
    (call record-conversion syntax relation reason false no-type syntax)
  )
  (fn-do + compare-held Relation
    (param source TypeId)
    (param target TypeId)
    ; Relates a value to the type it converts to with the closures it holds, such as a field of a
    ; tuple, fitted to the function types they become.
    (let previous (. relations callables))
    (= (. relations callables) fitter)
    (let relation (call (. relations compare) source target false false null (. frame module)))
    (= (. relations callables) previous)
    (return relation)
  )
  (fn-do + report-illegal _
    (param syntax SyntaxId)
    (param relation Relation)
    (param source TypeId)
    (param target TypeId)
    ; Says why a conversion is illegal: extension converters that collide, a value with no truth
    ; asked to be a `Bool`, or no way to convert.
    (if (== (. relation reason) .reason-ambiguous)
      (call (. frame diagnose) syntax .ambiguous-extension)
      (else-if (== (. relation reason) .reason-conflict)
        (call (. frame diagnose) syntax .extension-conflict)
      )
      (else-if (and (call relation-legal relation) (call truthless relation))
        (call report-truthless syntax relation)
      )
      (else-if (call relation-legal relation)
        (call (. frame diagnose) syntax (call unasked relation) null source target)
      )
      (else
        (call (. frame diagnose) syntax .illegal-cast null source target)
      )
    )
  )
  (fn-do _ truthless Bool
    (param relation Relation)
    ; Whether a cast makes a `Bool` of a value with no truth to test: an interface, or an object of
    ; a class written in source that does not say whether it is empty with `!`.
    (let casts (or (== (. relation kind) .relation-final-cast) (== (. relation kind) .relation-side-cast)))
    (if (or (not casts) (!= (call (. types intrinsic-of) (. relation to)) .bool) (not host))
      (return false)
    )
    (let completion (call (. types completion-of) (. relation from)))
    (if (== (. completion intrinsic) .interface)
      (return true)
    )
    (return (and (== (. completion intrinsic) .class) (not (. completion is-builtin)) (== (call (. (!! host) truth-callee) (. relation from)) no-instance)))
  )
  (fn-do _ report-truthless _
    (param syntax SyntaxId)
    (param relation Relation)
    ; The error for a value with no truth asked to be a `Bool`, which says that `as` does not read
    ; the values it gives.
    (let shown (call type-source types (. relation from)))
    (let reason "it has no truth to test, and \"as\" does not read the values it gives")
    (call (. frame diagnose)
      (block
        (arg syntax)
        (arg .stated)
        (arg (call (. program store-atom) (str shown " cannot become Bool: " reason "; read them instead")))
        (arg (. relation from))
        (arg (. relation to))
      )
    )
  )
  (fn-expr _ unasked TypeDiagnosticKind
    (param relation Relation)
    (case? (== (. ([] (. types completions) (. relation from)) intrinsic) .optional)
      .unasked-unwrap
    )
    (case? (== (. ([] (. types completions) (. relation to)) intrinsic) .string)
      .unasked-text
    )
    (case? (or (== (. relation kind) .relation-down-cast) interface-down (== (. relation kind) .relation-unwrap-cast))
      .unasked-narrowing
    )
    (case? (call (. relations loses-fraction) relation)
      .unasked-fraction
    )
    (default
      .unasked-conversion
    )
    (where
      (lazy interface-down (== (. relation kind) .relation-interface-down-cast))
    )
  )
  (fn-do _ check-item-size _
    (param syntax SyntaxId)
    (param from TypeId)
    (param to TypeId)
    (return-if (if (or (not (call holds-items from)) (not (call holds-items to)))))
    (blank)
    (let from-item (call class-arg types from 0))
    (let to-item (call class-arg types to 0))
    (return-if (if (== from-item to-item)))
    (blank)
    (let from-size (call known-size from-item))
    (let to-size (call known-size to-item))
    (if (or (== from-size 0) (== to-size 0))
      (call (. instances mark-may-panic) (. frame instance))
      (else-if (!= from-size to-size)
        (let named (str (call type-source types from) " cannot be cast to " (call type-source types to)))
        (let message
          (paragraph
            (str named "; their items are " from-size " and " to-size " bytes, and a cast keeps the count of items")
          )
        )
        (call (. frame diagnose) syntax .stated (call (. program store-atom) message) from to)
      )
    )
  )
  (fn-expr _ holds-items Bool
    (param type TypeId)
    (or (call (. types array-decl refers-to) (. ref module) (. ref decl)) (call (. types immutable-array-decl refers-to) (. ref module) (. ref decl)))
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-expr _ known-size U32
    (param type TypeId)
    (/ (+ (. (call (. types completion-of) type) bit-size) 7) 8)
  )
  (fn-do + demand-converter InstanceId
    (param source TypeId)
    (param target TypeId)
    ; The instance of the function a type declares to convert a value of one type to another, or
    ; none where no such function converts it. It is demanded for a report, which one instance
    ; serves wherever it is made, so it is typed as declared, outside any restriction where the
    ; report is demanded.
    (let relation (call (. relations compare) source target false false null (. frame module)))
    (if (and (== (. relation kind) .relation-converter) (!= (. relation converter-module) (. U32 max)))
      (return (call converter-instance relation false))
    )
    (return no-instance)
  )
  (fn-do + converter-of InstanceId
    (param relation Relation)
    ; The instance of the function a type declares that a conversion runs to make the value it
    ; converts to, as a converter or as one that makes its own type from another; none for any
    ; other conversion.
    (if (and (!= (. relation kind) .relation-converter) (!= (. relation kind) .relation-fromverter))
      (return no-instance)
    )
    (if (== (. relation converter-module) (. U32 max))
      (return no-instance)
    )
    (return (call converter-instance relation))
  )
  (fn-do + record-conversion _
    (param syntax SyntaxId)
    (param found Relation)
    (param reason ConversionReason)
    (param at-site Bool (= false))
    (param requested TypeId (= no-type))
    (param value SyntaxId (= 0))
    ; Records how a value converts where it is used. An optional or a union becomes text as `as-text`
    ; says, but a declaration with a type is a pattern, and there it unwraps. `value` is the node of the
    ; value where the caller has one. A pattern that takes the text a case of a union holds as it is
    ; has no parts, as it converts no other case. A closure or a binding that becomes a value of a
    ; function type is recorded with the instance it runs as one. An event's endpoint a converter would
    ; convert is reported instead, as `misused-endpoint` says.
    (if (and host (call converts-value (. found kind)) (call (. host misused-endpoint) (if-expr (!= value 0) value syntax)))
      (return)
    )
    (let relation
      (scope (if-expr (== reason .reason-declaration) found (call as-text found as-pattern))
        (lazy as-pattern (== reason .reason-pattern))
      )
    )
    (let callee no-instance)
    (if (or (== (. relation kind) .relation-converter) (== (. relation kind) .relation-fromverter))
      (= callee (call conversion-callee relation))
    )
    (let counted (and (== (. relation kind) .relation-fromverter) (== (. relation converter-module) (. U32 max))))
    (if (and counted host (== (. relation via) (. relation to)))
      (call (. host note-enum-number) syntax (. relation to))
    )
    (if (and (== (. relation kind) .relation-unwrap-cast) (!= (. relation converter-module) (. U32 max)))
      (if (!= (. relation via) no-type)
        (= callee (call conversion-callee relation))
      )
    )
    (let to-text (== (. ([] (. types completions) (. relation to)) intrinsic) .string))
    (if (and (== (. ([] (. types completions) (. relation from)) intrinsic) .cpointer) to-text)
      (call (. instances mark-may-panic) (. frame instance))
    )
    (let tests (== reason .reason-pattern))
    (if (and (== (. relation kind) .relation-unwrap-cast) (call (. types is-optional) (. relation from)) (not tests))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (call note-narrowing relation reason)
    (if (and (call unwraps-case relation) host (not tests))
      (call (. instances mark-may-panic) (. frame instance))
      (call (. (!! host) demand-union-error))
    )
    (if (and (== (. relation kind) .relation-side-cast) (== (. ([] (. types completions) (. relation to)) intrinsic) .table-span))
      (call (. instances mark-may-panic) (. frame instance))
    )
    (call demand-witness relation syntax)
    (if (== (. relation kind) .relation-final-cast)
      (call check-item-size syntax (. relation from) (. relation to))
    )
    (let casts (or (== (. relation kind) .relation-final-cast) (== (. relation kind) .relation-side-cast)))
    (if (and casts host (== (. ([] (. types completions) (. relation to)) intrinsic) .bool))
      (= callee (call (. host truth-callee) (. relation from)))
      (if (call truthless relation)
        (call report-truthless syntax relation)
        (return)
      )
    )
    (let id (call (. facts record-conversion) (. frame instance) (call cast-site syntax at-site) relation reason callee))
    (= (. ([] (. facts conversions) id) asked) requested)
    (= (. ([] (. facts conversions) id) runs) (call runs-of (. relation from) (. relation to)))
    (call note-adapted
      (block
        (arg (. ([] (. facts conversions) id) runs))
        (arg (. relation from))
        (arg (. relation to))
        (arg (. ([] (. facts conversions) id) syntax))
        (arg (== reason .reason-explicit))
      )
    )
    (if (call casts-function relation)
      (= (. ([] (. facts conversions) id) casts) true)
      (call note-cast (. relation from) (. relation to) (== reason .reason-explicit))
    )
    (if (call copies-function relation (. ([] (. facts conversions) id) casts))
      (call (. frame check-allocates) (. ([] (. facts conversions) id) syntax))
    )
    (= part-site (. ([] (. facts conversions) id) syntax))
    (= part-value (if-expr tests 0 value))
    (let parts (if-expr (and tests (call takes-case-text relation)) no-fact (call record-parts relation reason)))
    (= part-value 0)
    (if (!= parts no-fact)
      (= (. ([] (. facts conversions) id) parts) parts)
    )
    (let runs-function (or (== (. relation kind) .relation-fromverter) (== (. relation kind) .relation-converter)))
    (if (and runs-function (!= callee no-instance) host (not tests))
      (= (. ([] (. facts conversions) id) raise) (call settle-raise callee value))
      (if (== reason .reason-join)
        (call agree-raise id)
      )
    )
    (if (and (== (. relation kind) .relation-converter) (!= callee no-instance) (call converts-virtually (. relation from)))
      (call (. instances mark-may-panic) (. frame instance))
    )
  )
  (fn-expr _ takes-case-text Bool
    (param relation Relation)
    (and union-text picked (== (. ([] (call (. types cases-of) (. relation from)) (. relation case-index)) type) (. types string-type)))
    (where
      (lazy union-text (and (== (. relation kind) .relation-unwrap-cast) (== (. relation to) (. types string-type)) from-union))
      (lazy from-union (== (call (. types intrinsic-of) (. relation from)) .union))
      (lazy picked (!= (. relation case-index) (. U32 max)))
    )
  )
  (fn-expr _ converts-virtually Bool
    (param from TypeId)
    ; Whether a converter of a value of this type is chosen by the class of the object, as a call
    ; of a method is: the type is a class written in source that some class is derived from. Such
    ; a conversion may panic whatever the converter named does, because the one chosen may.
    (case? (or (== from no-type) (== from invalid-type))
      false
    )
    (case? (or (!= (. completion intrinsic) .class) (. completion is-builtin))
      false
    )
    (default
      (call (. types has-subclasses) from)
    )
    (where
      (lazy completion (call (. types completion-of) from))
    )
  )
  (fn-do + record-made _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param source TypeId)
    (param target TypeId)
    ; Records that a closure becomes a value of a function type at a node of an instance typed
    ; already, that the closure runs, as the function that builds content a style rule generates is
    ; made one where the rule is applied to a markup element: `note-adapted` says how.
    (let id
      (call (. facts record-conversion)
        (block
          (arg instance)
          (arg syntax)
          (arg (call side-cast-relation source target))
          (arg .reason-markup-slot)
        )
      )
    )
    (= (. ([] (. facts conversions) id) runs) instance)
    (call note-adapted instance source target syntax)
  )
  (fn-do _ note-narrowing _
    (param relation Relation)
    (param reason ConversionReason)
    ; Outside a pattern, a cast that narrows a value panics where the value is not of the type it
    ; is cast to.
    (let narrows (or (== (. relation kind) .relation-down-cast) (== (. relation kind) .relation-interface-down-cast)))
    (if (and narrows (!= reason .reason-pattern))
      (call (. instances mark-may-panic) (. frame instance))
    )
  )
  (fn-expr _ as-text Relation
    (param found Relation)
    (param tests Bool (= false))
    ; An optional becomes text by the converter it declares, which has text for one that holds
    ; nothing, though an optional of text also unwraps to it. So does a union no case of which with
    ; no name holds text, but for a pattern that `tests` the union for the case that holds it.
    (case? (or (!= (. found kind) .relation-unwrap-cast) (!= (. found to) (. types string-type)))
      found
    )
    (case? (and (not from-optional) (or tests (!= (call (. types intrinsic-of) (. found from)) .union) unnamed-holds))
      found
    )
    (default
      (if-expr (call relation-legal declared) declared found)
    )
    (where
      (lazy declared (call (. relations converter-relation) (. found from) (. found to) (. frame module)))
      (lazy from-optional (call (. types is-optional) (. found from)))
      (lazy unnamed-holds (call (. relations unnamed-case-holds) (. found from) (. found to)))
    )
  )
  (fn-do _ demand-witness _
    (param relation Relation)
    (param site SyntaxId (= 0))
    ; A value that becomes a value of an interface needs the witness of its type for that
    ; interface. One made so inside an optional is the optional's part. A value that is no object
    ; and no whole number is copied into an object the collector owns, where it converts.
    (if (not host)
      (return)
    )
    (if (== (. relation kind) .relation-interface-cast)
      (call (. host record-witness) (. relation from) (. relation to))
      (if (and (!= site 0) (call boxes (. relation from)))
        (call (. frame check-allocates) site)
      )
    )
    (if (and (== (. relation kind) .relation-interface-down-cast) (== (call (. types intrinsic-of) (. relation to)) .interface))
      (call (. facts record-dynamic-witness) (. relation from) (. relation to))
    )
  )
  (fn-expr _ copies-function Bool
    (param relation Relation)
    (param casts Bool)
    ; Whether a value of a function type is made with a copy the collector owns: of a binding that
    ; holds the value it calls on or arguments, or of a value of another function type.
    (and (== (call (. types intrinsic-of) (. relation to)) .function) (or casts (call binds (. relation from))))
  )
  (fn-do _ binds Bool
    (param type TypeId)
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (return (or (and (!= (. row object) no-type) (!= (. row form) .bound-constructor)) (> (. row items count) (. row param-count))))
      )
    )
    (return false)
  )
  (fn-expr _ boxes Bool
    (param type TypeId)
    ; Whether a value of a type is copied into an object the collector owns where it becomes a
    ; value of an interface: one that is no object and is not held as a whole number.
    (not (or (== kind .class) (== kind .interface) (== kind .bool) (== kind .int1) (== kind .char) (== kind .int8) (== kind .uint8) (== kind .int16) (== kind .uint16) (== kind .int32) (== kind .uint32) (== kind .int64) (== kind .uint64)))
    (where
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-do _ note-adapted _
    (param runs InstanceId)
    (param source TypeId)
    (param target TypeId)
    (param site SyntaxId)
    (param explicit Bool (= false))
    ; Records how the function a closure or a binding runs as a value of a function type takes
    ; the arguments a binding holds and those the type gives, and gives the type its answer,
    ; where their types differ. The function made for the value has no syntax of its own, so
    ; each is recorded for the function it runs, with no node, and with the function that
    ; converts where one is written for the two types. A conversion that may fail, other than
    ; an unwrap of an optional, or whose function raises, is left out, and such a value has no
    ; shape. A type that carries errors has what a call of its value answers with kept for it,
    ; and the function made answers so. An error what runs raises that the type does not carry
    ; is reported where the value is made.
    (if (== runs no-instance)
      (return)
    )
    (let fn (call function-row types target))
    (if (== fn no-type)
      (return)
    )
    (call note-carries target)
    (call (. (!! host) demand-errors) runs)
    (let raised (. ([] (. instances signatures) runs) errors))
    (for (in offset (..< 0 (. raised count)))
      (let error ([] (. instances signature-types) (+ (. raised start) offset)))
      (if (not (call carries-error target error))
        (call (. frame diagnose) site .error-not-carried null error target)
        (return)
      )
    )
    (let owner (. ([] (. instances rows) runs) self-type))
    (if (and (!= owner no-type) (== (. ([] (. types completions) owner) intrinsic) .interface))
      (call (. facts record-witness-func) owner (. ([] (. instances rows) runs) module) (. ([] (. instances rows) runs) decl))
      (call (. facts record-witness-call) owner (. ([] (. instances rows) runs) module) (. ([] (. instances rows) runs) decl))
      (call (. facts record-witness-proto) runs)
    )
    (let signature ([] (. instances signatures) runs))
    (match? ([] (. types rows) fn)
      (case (call .type-function shape)
        (if (< (. signature args count) (. shape args count))
          (return)
        )
        (let held (- (. signature args count) (. shape args count)))
        (match? ([] (. types rows) source)
          (case (call .type-binding bound)
            (for (in offset (..< (. bound param-count) (. bound items count)))
              (let place (- offset (. bound param-count)))
              (if (< place held)
                (call note-passed
                  (block
                    (arg runs)
                    (arg (call (. types child-type) (. bound items) offset))
                    (arg (call (. instances argument-type) runs place))
                    (arg .reason-argument)
                    (arg no-type)
                    (arg no-type)
                    (arg explicit)
                  )
                )
              )
            )
          )
        )
        (for (in offset (..< 0 (. shape args count)))
          (let taken (call (. instances argument-type) runs (+ held offset)))
          (call note-passed
            (block
              (arg runs)
              (arg (call (. types child-type) (. shape args) offset))
              (arg taken)
              (arg .reason-argument)
              (arg no-type)
              (arg no-type)
              (arg explicit)
            )
          )
        )
        (let wanted (call carried-value types (. shape return-type)))
        (if (and (!= wanted no-type) (!= wanted (. types void-type)))
          (let returned (if-expr (!= answered no-type) answered (. signature returns)))
          (call note-passed runs returned wanted .reason-return no-type no-type explicit)
        )
      )
    )
  )
  (fn-do _ carries-error Bool
    (param type TypeId)
    (param error TypeId)
    ; Whether a function type carries an error: one it declares, or one of what it returns where
    ; that is already a value or an error.
    (let fn (call function-row types type))
    (if (== fn no-type)
      (return false)
    )
    (call (. types complete) error)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (for (in offset (..< 0 (. row errors count)))
          (if (call is-subtype types error (call (. types child-type) (. row errors) offset))
            (return true)
          )
        )
        (if (!= (. row return-type) no-type)
          (match? ([] (. types rows) (. row return-type))
            (case (call .type-result held)
              (for (in offset (..< 0 (. held errors count)))
                (if (call is-subtype types error (call (. types child-type) (. held errors) offset))
                  (return true)
                )
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ note-carries TypeId
    (param type TypeId)
    ; Keeps, for a function type that carries errors, what a call of its value answers with,
    ; and gives it: no type where the type carries none.
    (let carried (call carried-result types type))
    (if (!= carried no-type)
      (call (. types complete) carried)
      (call (. facts note-carried) (call function-row types type) carried)
    )
    (return carried)
  )
  (fn-expr _ casts-function Bool
    (param relation Relation)
    ; Whether a conversion makes a value of one function type a value of another, which a
    ; function made for the two types does. A C function's type and a generator are not made
    ; so.
    (and hosted-side-cast (call holds-function (. relation from)) (call holds-function (. relation to)))
    (where
      (lazy hosted-side-cast (and (== (. relation kind) .relation-side-cast) (!= host null)))
    )
  )
  (fn-expr _ holds-function Bool
    (param type TypeId)
    (case? (or (!= (. ([] (. types completions) type) intrinsic) .function) (call is-c-function types type))
      false
    )
    (default
      (or (!= (. ref module) (. types generator-decl module)) (!= (. ref decl) (. types generator-decl decl)))
    )
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-do _ note-cast _
    (param source TypeId)
    (param target TypeId)
    (param explicit Bool (= false))
    ; Records how the function made where a value of one function type becomes a value of
    ; another gives the first what the second is given, and gives the second's answer, where
    ; their types differ: each for the two types, with no node and no instance. A type that
    ; carries errors has what a call of its value answers with kept for it.
    (let taken (call (of RowRange TypeId)))
    (let given (call (of RowRange TypeId)))
    (let answered no-type)
    (let returned no-type)
    (match? ([] (. types rows) (call function-row types source))
      (case (call .type-function shape)
        (= taken (. shape args))
        (= answered (call carried-value types (. shape return-type)))
      )
    )
    (match? ([] (. types rows) (call function-row types target))
      (case (call .type-function shape)
        (= given (. shape args))
        (= returned (call carried-value types (. shape return-type)))
      )
    )
    (call note-carries source)
    (call note-carries target)
    (if (!= (. given count) (. taken count))
      (return)
    )
    (for (in offset (..< 0 (. given count)))
      (call note-passed
        (block
          (arg no-instance)
          (arg (call (. types child-type) given offset))
          (arg (call (. types child-type) taken offset))
          (arg .reason-argument)
          (arg source)
          (arg target)
          (arg explicit)
        )
      )
    )
    (if (and (!= returned no-type) (!= returned (. types void-type)))
      (call note-passed no-instance answered returned .reason-return source target explicit)
    )
  )
  (fn-do _ note-passed _
    (param runs InstanceId)
    (param from TypeId)
    (param to TypeId)
    (param reason ConversionReason)
    (param source TypeId (= no-type))
    (param target TypeId (= no-type))
    (param explicit Bool (= false))
    ; Records one conversion of a function made with no syntax of its own: for the function it
    ; runs, or for the two function types where it runs what a value holds. A tuple or struct
    ; made another is recorded with its parts where each converts as plainly. An unwrapped
    ; optional panics where it holds no value.
    (if (or (== from to) (== from no-type) (== from invalid-type) (== to no-type) (== to invalid-type))
      (return)
    )
    (let known
      (scope (if-expr (== runs no-instance) cast-fact (call (. facts passed-conversion) runs reason from to))
        (lazy cast-fact (call (. facts cast-conversion) source target reason from to))
      )
    )
    (if (!= known no-fact)
      (return)
    )
    (let implicit (call (. relations compare) from to false false null (. frame module)))
    (let reads (and explicit (not (call relation-legal implicit)) (call (. relations reads-text-as-number) from to)))
    (let relation (if-expr reads (call (. relations compare-explicit) from to (. frame module)) implicit))
    (if (or (not (call relation-legal relation)) (not host))
      (return)
    )
    (let callee no-instance)
    (if (!= (. relation converter-module) (. U32 max))
      (if (and (!= (. relation kind) .relation-converter) (!= (. relation kind) .relation-fromverter))
        (return)
      )
      (= callee (call conversion-callee relation))
      (call (. (!! host) demand-errors) callee)
      (if (!= (. ([] (. instances signatures) callee) errors count) 0)
        (return)
      )
      (else-if (and (not (call is-plain relation)) (not (call plain-fields relation)) (not (call unwraps-optional relation)))
        (return)
      )
    )
    (call demand-witness relation)
    (let id no-fact)
    (if (== runs no-instance)
      (= id (call (. facts record-cast) (. frame instance) source target relation reason callee))
      (else
        (= id (call (. facts record-passed) runs relation reason callee))
      )
    )
    (= part-site 0)
    (let parts (call record-parts relation reason))
    (if (!= parts no-fact)
      (= (. ([] (. facts conversions) id) parts) parts)
    )
  )
  (fn-expr _ unwraps-optional Bool
    (param relation Relation)
    (and (== (. relation kind) .relation-unwrap-cast) (call (. types is-optional) (. relation from)))
  )
  (fn-expr _ is-plain Bool
    (param relation Relation)
    ; Whether a conversion with no function written for it calls none, can not fail and
    ; converts no part of its value apart: none of a number to an enum or of an object or a
    ; text to its truth, none that unwraps, none of a union or of the fields of a tuple or
    ; struct, and none of an optional of an interface.
    (case? (or (== kind .relation-converter) (== kind .relation-fromverter))
      false
    )
    (case? (or (== kind .relation-unwrap-cast) (== kind .relation-down-cast) interface-down)
      false
    )
    (case? (or (== source .cpointer) (== source .union) (== (. ([] (. types completions) (. relation to)) intrinsic) .union))
      false
    )
    (case? (and (or (== kind .relation-string-cast) (== kind .relation-final-cast)) (call holds-fields (. relation from)))
      false
    )
    (case? (and casts to-bool (or (== source .class) (== source .string)))
      false
    )
    (case? (and (== kind .relation-side-cast) to-optional (not (call (. types is-optional) (. relation from))))
      (!= (. ([] (. types completions) (call (. types optional-inner) (. relation to))) intrinsic) .interface)
    )
    (default
      true
    )
    (where
      (lazy kind (. relation kind))
      (lazy source (. ([] (. types completions) (. relation from)) intrinsic))
      (lazy casts (or (== kind .relation-final-cast) (== kind .relation-side-cast)))
      (lazy interface-down (== kind .relation-interface-down-cast))
      (lazy to-bool (== (. ([] (. types completions) (. relation to)) intrinsic) .bool))
      (lazy to-optional (call (. types is-optional) (. relation to)))
    )
  )
  (fn-do _ plain-fields Bool
    (param relation Relation)
    ; Whether a conversion makes a tuple or struct another by converting each field as `is-plain`
    ; says, or a field that is one of them so in turn.
    (if (or (!= (. relation kind) .relation-final-cast) (>= part-depth deepest-parts))
      (return false)
    )
    (if (or (not (call holds-fields (. relation from))) (not (call holds-fields (. relation to))))
      (return false)
    )
    (let targets (. ([] (. types completions) (. relation to)) properties))
    (let cursor U32)
    (for (in field (call (. types properties-of) (. relation from)))
      (if (== (. field slot) (. U32 max))
        (continue)
      )
      (while (and (< cursor (. targets count)) (== (. ([] (. types properties) (+ (. targets start) cursor)) slot) (. U32 max)))
        (+= cursor 1)
      )
      (if (>= cursor (. targets count))
        (return false)
      )
      (let wanted (. ([] (. types properties) (+ (. targets start) cursor)) type))
      (+= cursor 1)
      (if (or (== (. field type) no-type) (== wanted no-type))
        (return false)
      )
      (if (== (. field type) wanted)
        (continue)
      )
      (let part (call compare-held (. field type) wanted))
      (if (not (call relation-legal part))
        (return false)
      )
      (if (and (== (. part converter-module) (. U32 max)) (call is-plain part))
        (continue)
      )
      (+= part-depth 1)
      (let inner (call plain-fields part))
      (-= part-depth 1)
      (if (not inner)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ settle-raise ConversionRaise
    (param callee InstanceId)
    (param value SyntaxId)
    ; Says what becomes of an error given by the function a conversion, or a part of one, calls.
    ; Where the value is a text written in source the error is a panic. Of any other value the
    ; errors leave the function the conversion is written in. Under `catch`, or where no node is
    ; the value, nothing is settled.
    (call (. (!! host) demand-errors) callee)
    (let signature ([] (. instances signatures) callee))
    (if (or (== (. signature errors count) 0) (== value 0))
      (return .raise-unsettled)
    )
    (if (call is-text-literal value)
      (call (. instances mark-may-panic) (. frame instance))
      (call demand-error-report)
      (return .raise-panics)
    )
    (if (!= (. frame surround catch-depth) 0)
      (return .raise-unsettled)
    )
    (for (in offset (..< 0 (. signature errors count)))
      (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) value)
    )
    (return .raise-leaves)
  )
  (fn-do _ agree-raise _
    (param fact FactId)
    ; The sides of a join that have one type take one conversion, the first recorded for the
    ; type. Where two of them settle differently what becomes of an error, none is settled.
    (let row ([] (. facts conversions) fact))
    (let differs false)
    (let other (call (. facts first-conversion) (. frame instance) (. row syntax)))
    (while (!= other no-fact)
      (let held ([] (. facts conversions) other))
      (if (and (== (. held reason) .reason-join) (== (. held from) (. row from)) (!= (. held raise) (. row raise)))
        (= differs true)
      )
      (= other (. held next))
    )
    (if (not differs)
      (return)
    )
    (= other (call (. facts first-conversion) (. frame instance) (. row syntax)))
    (while (!= other no-fact)
      (let held ([] (. facts conversions) other))
      (if (and (== (. held reason) .reason-join) (== (. held from) (. row from)))
        (= (. ([] (. facts conversions) other) raise) .raise-unsettled)
      )
      (= other (. held next))
    )
  )
  (fn-do + is-text-literal Bool
    (param syntax SyntaxId)
    ; Whether a node is a text written in source, itself or as an argument.
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-argument argument)
        (return (call is-text-literal (. argument expr)))
      )
      (case .node-string-syntax
        (return true)
      )
    )
    (return false)
  )
  (fn-do + record-pattern _
    (param syntax SyntaxId)
    (param relation Relation)
    (param guard U32)
    (param within TypeId (= no-type))
    ; Records at a type named as a pattern how a value it is given becomes that type, for the
    ; case of a union the guard numbers, or for the value itself with no guard.
    (let row FactId (as (. facts conversions length) FactId))
    (call record-conversion syntax relation .reason-pattern)
    (= (. ([] (. facts conversions) row) guard) guard)
    (= (. ([] (. facts conversions) row) within) within)
  )
  (fn-do + parts-of FactId
    (param relation Relation)
    (param reason ConversionReason)
    ; The parts of a conversion recorded for the function the frame began, which no value of the
    ; frame's own body is converted for, as `record-parts` makes them.
    (= part-site 0)
    (= part-value 0)
    (= part-depth 0)
    (return (call record-parts relation reason))
  )
  (fn-do _ record-parts FactId
    (param relation Relation)
    (param reason ConversionReason)
    ; What a conversion of a tuple or struct does to each field it stores, in the order they are
    ; stored: the conversion of the field to text for one made text, and to the field in the
    ; same place for one cast to another tuple or struct. A field that is converted the same
    ; way has parts of its own. Text is joined by a function that polls, so the instance may
    ; panic. No fact for any other conversion, nor for fields held deeper than any type that
    ; can be stored holds them: one that holds itself has no end.
    ; A value made a case of a union has one part, its conversion to what the case holds. A union
    ; made text, or made another union, has a part for each of its cases in their order: the
    ; conversion of what the case holds, which for a case with no value of its own is not used.
    ; An optional made a union with a case for null has one part, the conversion of what it holds.
    ; A value made an optional of another type, or an optional made one, has one part: the
    ; conversion of the value, or of what the optional holds, to what the new one holds.
    (if (>= part-depth deepest-parts)
      (return no-fact)
    )
    (if (and (== (. relation kind) .relation-side-cast) (call (. types is-optional) (. relation to)))
      (let held (call (. types optional-inner) (. relation to)))
      (let given (call (. types optional-inner) (. relation from)))
      (if (or (== given held) (== given (. types null-type)))
        (return no-fact)
      )
      (return (call record-part given held reason))
    )
    (if (and optional-unwrap (!= (call (. types null-case) (. relation to)) (. U32 max)))
      (return (call record-part (call (. types optional-inner) (. relation from)) (. relation to) reason))
    )
    (lazy optional-unwrap (and (== (. relation kind) .relation-unwrap-cast) (call (. types is-optional) (. relation from))))
    (if (and (== (. relation kind) .relation-wrap-cast) (!= (. relation case-index) (. U32 max)))
      (if (!= (call (. types intrinsic-of) (. relation to)) .union)
        (return no-fact)
      )
      (let held (. ([] (call (. types cases-of) (. relation to)) (. relation case-index)) type))
      (return (call record-part (. relation from) held reason))
    )
    (if (== (call (. types intrinsic-of) (. relation from)) .union)
      (return (call record-cases relation reason))
    )
    (let is-text (== (. relation kind) .relation-string-cast))
    (if (and (not is-text) (!= (. relation kind) .relation-final-cast))
      (return no-fact)
    )
    (if (or (not (call holds-fields (. relation from))) (and (not is-text) (not (call holds-fields (. relation to)))))
      (return no-fact)
    )
    (if is-text
      (call (. instances mark-may-panic) (. frame instance))
    )
    (let head no-fact)
    (let last no-fact)
    (let targets (. ([] (. types completions) (. relation to)) properties))
    (let cursor U32)
    (for (in field (call (. types properties-of) (. relation from)))
      (if (== (. field slot) (. U32 max))
        (continue)
      )
      (let target (. types string-type))
      (if (not is-text)
        (while (and (< cursor (. targets count)) (== (. ([] (. types properties) (+ (. targets start) cursor)) slot) (. U32 max)))
          (+= cursor 1)
        )
        (if (>= cursor (. targets count))
          (break)
        )
        (let wanted ([] (. types properties) (+ (. targets start) cursor)))
        (= target (. wanted type))
        (if (and (== target no-type) host)
          (= target (call (. host demand-member) wanted (. relation to) (. wanted name)))
        )
        (+= cursor 1)
      )
      (let held (. field type))
      (if (and (== held no-type) host)
        (= held (call (. host demand-member) field (. relation from) (. field name)))
      )
      (if (or (== held no-type) (== held invalid-type) (== target no-type) (== target invalid-type))
        (break)
      )
      (let id (call record-part held target reason))
      (if (== last no-fact)
        (= head id)
        (else
          (= (. ([] (. facts conversion-parts) last) next) id)
        )
      )
      (= last id)
    )
    (return head)
  )
  (fn-do _ record-part FactId
    (param held TypeId)
    (param target TypeId)
    (param reason ConversionReason)
    ; Adds the conversion of one value held inside another, with the parts of its own. A
    ; closure, a binding or a value of a function type that becomes a value of a function type
    ; there is recorded as one converted alone is, at the place of the whole conversion.
    (let part (if-expr (== held target) (call same-relation held) (call as-text (call compare-held held target))))
    (let callee no-instance)
    (if (or (== (. part kind) .relation-converter) (== (. part kind) .relation-fromverter))
      (= callee (call conversion-callee part))
    )
    (if (and (call unwraps-case part) host)
      (call (. instances mark-may-panic) (. frame instance))
      (call (. (!! host) demand-union-error))
    )
    (call note-narrowing part reason)
    (call demand-witness part part-site)
    (let id (call (. facts record-part) (. frame instance) part reason callee))
    (if (and (!= callee no-instance) host (!= part-value 0))
      (= (. ([] (. facts conversion-parts) id) raise) (call settle-raise callee part-value))
    )
    (let runs (if-expr (!= held target) (call runs-of (. part from) (. part to)) no-instance))
    (if (!= runs no-instance)
      (= (. ([] (. facts conversion-parts) id) runs) runs)
      (= (. ([] (. facts conversion-parts) id) syntax) part-site)
      (call note-adapted runs (. part from) (. part to) part-site)
    )
    (if (and (!= held target) (call casts-function part))
      (= (. ([] (. facts conversion-parts) id) casts) true)
      (= (. ([] (. facts conversion-parts) id) syntax) part-site)
      (call note-cast (. part from) (. part to))
    )
    (if (and (!= held target) (call copies-function part (. ([] (. facts conversion-parts) id) casts)))
      (call (. frame check-allocates) part-site)
    )
    (+= part-depth 1)
    (let inner (call record-parts part reason))
    (-= part-depth 1)
    (if (!= inner no-fact)
      (= (. ([] (. facts conversion-parts) id) parts) inner)
    )
    (return id)
  )
  (fn-do _ record-cases FactId
    (param relation Relation)
    (param reason ConversionReason)
    (let to-text (== (. relation to) (. types string-type)))
    (let is-text
      (scope (and to-text text-cast)
        (lazy text-cast (or (== (. relation kind) .relation-unwrap-cast) (== (. relation kind) .relation-string-cast)))
      )
    )
    (let rewraps (and (== (. relation kind) .relation-final-cast) (== (call (. types intrinsic-of) (. relation to)) .union)))
    (if (and (not is-text) (not rewraps))
      (return no-fact)
    )
    (let head no-fact)
    (let last no-fact)
    (for (in fact (call (. types cases-of) (. relation from)))
      (let target (if-expr (. fact is-default) (. fact type) (. relation to)))
      (let id (call record-part (. fact type) target reason))
      (if (== last no-fact)
        (= head id)
        (else
          (= (. ([] (. facts conversion-parts) last) next) id)
        )
      )
      (= last id)
    )
    (return head)
  )
  (fn-expr _ unwraps-case Bool
    (param relation Relation)
    ; Whether a conversion takes one case out of a union, and raises where the union holds
    ; another.
    (and unwraps (!= (. relation case-index) (. U32 max)) (!= (. relation to) (. types string-type)))
    (where
      (lazy unwraps (or (== (. relation kind) .relation-unwrap-cast) (== (. relation kind) .relation-down-cast)))
    )
  )
  (fn-expr _ holds-fields Bool
    (param type TypeId)
    (or (== kind .tuple) (== kind .struct))
    (where
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-do _ cast-site SyntaxId
    (param syntax SyntaxId)
    (param at-site Bool)
    (if at-site
      (return syntax)
    )
    (match? ([] (. frame tree nodes) syntax)
      (case .node-identifier
        (let resolution (call (. frame bindings resolution-of) (. frame binding) syntax))
        (if (== (. resolution kind) .resolve-slot)
          (let slot (. resolution slot))
          (if (call (. frame bindings lazy-inlines) slot)
            (let row ([] (. frame bindings slots) slot))
            (match? ([] (. frame tree nodes) (. row group))
              (case (call .node-declare declaration)
                (if (!= (. declaration right) 0)
                  (return (. declaration right))
                )
              )
            )
          )
        )
      )
    )
    (return syntax)
  )
  (fn-do _ conversion-callee InstanceId
    (param relation Relation)
    (if (== (. relation converter-module) (. U32 max))
      (return no-instance)
    )
    (call (. facts record-pair) (. frame instance) (. relation from) (. relation from) (call same-relation (. relation from)))
    (let callee (call converter-instance relation))
    (call (. facts record-call) (. frame instance) 0 callee .call-converter (. scratch no-fills) false)
    (return callee)
  )
  (fn-do _ converter-instance InstanceId
    (param relation Relation)
    (param restricted Bool (= true))
    ; The instance of the function a conversion runs, demanded of the host where there is one; one
    ; found with no host, where a witness answers, is typed from the queue. A restricted one is
    ; typed under the restrictions of the code that converts.
    (let self (if-expr (== (. relation kind) .relation-converter) (. relation from) (. relation to)))
    (let mark (. scratch types mark))
    (let params (. scratch no-types))
    (let args (. scratch no-types))
    (if (== (. relation kind) .relation-converter)
      (call converter-params relation)
      (= params (call (. scratch types since) mark))
    )
    (if (== (. relation kind) .relation-fromverter)
      (call (. scratch types push) (. relation from))
      (= args (call (. scratch types since) mark))
    )
    (if (== (. relation kind) .relation-unwrap-cast)
      (call (. scratch types push) (. relation via))
      (= args (call (. scratch types since) mark))
    )
    (let decl (. relation converter-decl))
    (let effects
      (block
        (case? restricted
          (call callee-effects frame (. relation converter-module) decl)
        )
        (default
          (call declared-effects (. frame program) (. relation converter-module) decl)
        )
      )
    )
    (let callee
      (call (. instances intern)
        (block
          (arg (. relation converter-module))
          (arg decl)
          (arg self)
          (arg effects)
          (arg no-instance)
          (arg params)
          (arg args)
          (:zone (if-expr restricted (call (. frame zone)) (call ZoneEntry)))
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if host
      (call (. host demand) callee)
    )
    (return callee)
  )
  (fn-do _ converter-params U32
    (param relation Relation)
    (let items-mark (. scratch types mark))
    (let module (. relation converter-module))
    (let decl (. relation converter-decl))
    (let source (. relation from))
    (if (not (call (. relations bind-converter) source (. relation to) module decl (. frame module) items-mark))
      (call (. scratch types rewind) items-mark)
      (return 0)
    )
    (let count (/ (- (. scratch types length) items-mark) 2))
    (let ordered (list TypeId))
    (for (in _ (..< 0 count))
      (+= ordered no-type)
    )
    (for (in offset (..< 0 count))
      (let index (call variable-index types ([] (. scratch types) (+ items-mark (* offset 2)))))
      (if (< index count)
        (= ([] ordered index) ([] (. scratch types) (+ items-mark (* offset 2) 1)))
      )
    )
    (call (. scratch types rewind) items-mark)
    (for (in actual ordered)
      (if (== actual no-type)
        (return 0)
      )
    )
    (let added 0u32)
    (for (in actual ordered)
      (call (. scratch types push) actual)
      (+= added 1)
    )
    (return added)
  )
  (fn-do _ convert-closure TypeId
    (param syntax SyntaxId)
    (param source TypeId)
    (param target TypeId)
    (param reason ConversionReason)
    ; A closure becomes a value of a function type where its body can be typed for the
    ; type's arguments and returns what the type does, each argument and what it returns converted
    ; unasked as a call converts them, unless the conversion is asked. A filter's condition gives its
    ; truth. Into an optional of such a type it becomes that value first, and then what holds it.
    (call (. types complete) target)
    (let inner (call (. types optional-inner) target))
    (call (. types complete) inner)
    (if (and (!= inner target) (!= (call function-row types inner) no-type))
      (if (== (call convert-closure syntax source inner reason) invalid-type)
        (return invalid-type)
      )
      (return (call convert syntax syntax inner target reason))
    )
    (let fn (call function-row types target))
    (if (== fn no-type)
      (call (. frame diagnose) syntax .illegal-cast null source target)
      (return invalid-type)
    )
    (let args (call (of RowRange TypeId)))
    (let returns no-type)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= args (. row args))
        (= returns (. row return-type))
      )
    )
    (if (not (call takes-count source (. args count)))
      (call (. frame diagnose) syntax .illegal-cast null source target)
      (return invalid-type)
    )
    (if (!= reason .reason-explicit)
      (for (in offset (..< 0 (. args count)))
        (let given (call (. types child-type) args offset))
        (let taken (call taken-type source offset given))
        (let unasked (or (== taken given) (call (. relations implicit) (call (. relations compare) given taken false false null (. frame module)))))
        (if (or (call (. relations reads-text-as-number) given taken) (not unasked))
          (call (. frame diagnose) syntax .illegal-cast null given taken)
          (return invalid-type)
        )
      )
    )
    (let args-start (. scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (call (. scratch types push) (call taken-type source offset (call (. types child-type) args offset)))
    )
    (let diagnosed (. frame facts diagnostics length))
    (let returned (call lambda-return (!! host) instances source (call (. scratch types since) args-start)))
    (call (. scratch types rewind) args-start)
    (if (== returned invalid-type)
      (if (== (. frame facts diagnostics length) diagnosed)
        (call (. frame diagnose) syntax .illegal-cast null source target)
      )
      (return invalid-type)
    )
    (let wanted (call carried-value types returns))
    (if (and (!= wanted no-type) (!= wanted (. types void-type)))
      (let relation (call (. relations compare) returned wanted false false null (. frame module)))
      (let unasked
        (block
          (scope (and implied (not (and (== wanted (. types bool-type)) (call is-filter-condition types program source))))
            (lazy implied (!= reason .reason-explicit))
          )
        )
      )
      (if (or (not (call relation-legal relation)) (and unasked (not (call (. relations implicit) relation))))
        (call (. frame diagnose) syntax .illegal-cast null returned wanted)
        (return invalid-type)
      )
    )
    (call record-conversion syntax (call side-cast-relation source target) reason)
    (return target)
  )
  (fn-do _ runs-of InstanceId
    (param source TypeId)
    (param target TypeId)
    ; The instance a closure or a binding runs as a value of a function type: the closure's
    ; body typed with the arguments it takes, or what the binding calls with the type's. None
    ; for any other conversion. `answered` is left as what a binding's call answers, which the
    ; function it calls may not have said yet.
    (let kind (. ([] (. types completions) source) intrinsic))
    (if (or (not host) (and (!= kind .closure) (!= kind .binding)))
      (return no-instance)
    )
    (let fn (call function-row types target))
    (if (== fn no-type)
      (return no-instance)
    )
    (let args (call (of RowRange TypeId)))
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= args (. row args))
      )
    )
    (let start (. scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (call (. scratch types push) (call taken-type source offset (call (. types child-type) args offset)))
    )
    (let runs no-instance)
    (= answered no-type)
    (if (== kind .closure)
      (= runs (call (. (!! host) demand-lambda) source (call (. scratch types since) start)))
      (else
        (let bound (call (. (!! host) binding-return) source (call (. scratch types since) start)))
        (= answered (. bound type))
        (if (!= answered invalid-type)
          (= runs (. bound callee))
          (if (!= runs no-instance)
            (= (. ([] (. instances rows) runs) bound-call) (call bound-call-of runs))
          )
        )
      )
    )
    (call (. scratch types rewind) start)
    (return runs)
  )
  (fn-do _ bound-call-of BoundCall
    (param callee InstanceId)
    ; How a binding calls the instance it runs, read from the instance's declaration: a written
    ; constructor of a class, a method of an object where the function is a member that is not
    ; static, or a function.
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)) (call (. types is-class-type) (. row self-type)))
          (return .bound-call-constructor)
        )
        (if (== (. fn kind) .function-decl)
          (return (if-expr (and (!= (. fn owner) 0) (not (. fn is-static))) .bound-call-method .bound-call-function))
        )
      )
    )
    (return .bound-call-none)
  )
  (fn-expr _ taken-type TypeId
    (param source TypeId)
    (param position U32)
    (param given TypeId)
    ; The type a closure made a value of a function type takes for an argument the type gives
    ; it: the one it declares, and the type's own where it declares none. A binding takes what
    ; the type gives.
    (case? (or (!= (. ([] (. types completions) source) intrinsic) .closure) (== declared no-type))
      given
    )
    (default
      declared
    )
    (where
      (lazy declared (call declared-argument types source position))
    )
  )
  (fn-do _ binding-fits Bool
    (param syntax SyntaxId)
    (param source TypeId)
    (param target TypeId)
    (param asked Bool)
    ; A binding becomes a value of a function type only when what it calls takes that type's
    ; arguments and gives its return (`binding-takes`), and a C function type holds no call that
    ; needs a receiver.
    (call (. types complete) target)
    (let fn (call function-row types target))
    (if (== fn no-type)
      (return true)
    )
    (let is-c false)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= is-c (. row is-c))
      )
    )
    (if (not (call binding-takes source target asked))
      (call (. frame diagnose) syntax .illegal-cast null source target)
      (return false)
    )
    (let bound-method false)
    (match? ([] (. types rows) source)
      (case (call .type-binding row)
        (= bound-method (== (. row form) .bound-method))
      )
    )
    (if (and is-c bound-method)
      (let message "Illegal to cast this function to CFunction")
      (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
      (return false)
    )
    (return true)
  )
  (fn-do + binding-takes Bool
    (param source TypeId)
    (param target TypeId)
    (param asked Bool (= false))
    ; Whether what a binding calls takes the arguments of a function type and gives its return,
    ; converted unasked unless the conversion is asked.
    (call (. types complete) target)
    (let fn (call function-row types target))
    (if (== fn no-type)
      (return true)
    )
    (let args (call (of RowRange TypeId)))
    (let returns no-type)
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (= args (. row args))
        (= returns (. row return-type))
      )
    )
    (let args-start (. scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (call (. scratch types push) (call (. types child-type) args offset))
    )
    (let returned (. (call (. (!! host) binding-return) source (call (. scratch types since) args-start) asked) type))
    (call (. scratch types rewind) args-start)
    (if (== returned invalid-type)
      (return false)
    )
    (let wanted (call carried-value types returns))
    (if (and (!= wanted no-type) (!= wanted (. types void-type)))
      (let relation (call (. relations compare) returned wanted false false null (. frame module)))
      (return (and (call relation-legal relation) (or asked (call (. relations implicit) relation))))
    )
    (return true)
  )
  (fn-do _ takes-count Bool
    (param closure TypeId)
    (param count U32)
    ; Whether a closure can be called with this many arguments: no more than it declares, and
    ; every one it declares without a default. A loop's subscriber takes the item and the stream,
    ; the function that builds an arm of a markup branch region the region, those that build
    ; and key a row of a markup loop region the row's item, the one that gives a markup
    ; element's name its object the object, and the one that builds what a slot that repeats is
    ; given the item.
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (let owner ([] (. program modules) (. row module)))
        (match? ([] (. owner decls) (. row decl))
          (case (call .decl-function fn)
            (if (== (. fn kind) .subscriber-decl)
              (return (== count 2))
            )
            (if (and (== (. fn kind) .row-decl) (call (. owner tree row-region) (. fn syntax)))
              (return (== count 2))
            )
            (if (or arm-or-row (== (. fn kind) .key-decl) (== (. fn kind) .binder-decl))
              (return (== count 1))
            )
            (lazy arm-or-row (or (== (. fn kind) .branch-arm-decl) (== (. fn kind) .row-decl)))
            (if (== (. fn kind) .slot-decl)
              (match? ([] (. owner tree nodes) (. fn syntax))
                (case (call .node-markup element)
                  (return (== count (if-expr (!= (. element slot-parameter) 0) 1 0)))
                )
              )
              (return (== count 0))
            )
            (if (and (> count (. fn args count)) (== (. fn variadic-index) (. U32 max)))
              (return false)
            )
            (for (in offset (..< count (. fn args count)))
              (let shape ([] (. owner arg-pool) (+ (. fn args start) offset)))
              (if (and (not (. shape has-default)) (not (. shape is-variadic)))
                (return false)
              )
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ misfits-literal Bool
    (param syntax SyntaxId)
    (param target TypeId)
    ; Whether an expression is an integer written with no suffix that the integer type a place holds
    ; it as cannot hold, which is reported as that and not as a conversion.
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-argument argument)
        (return (call misfits-literal (. argument expr) target))
      )
      (case .node-block
        (let row (call (. frame tree arms-value) syntax))
        (return (and (!= row syntax) (call misfits-literal row target)))
      )
      (case (call .node-integer-syntax row)
        (if (. row unit)
          (return false)
        )
        (let literal (call parse-integer-literal (. row value)))
        (let held (call literal-target literal target))
        (return
          (scope (and (call is-integer-kind (call (. types intrinsic-of) (call builtin-number types held))) overflows)
            (lazy overflows (not (call literal-fits-target types literal held)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + check-literal-fit _
    (param syntax SyntaxId)
    (param target TypeId)
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-argument argument)
        (call check-literal-fit (. argument expr) target)
      )
      (case .node-block
        (let row (call (. frame tree arms-value) syntax))
        (if (!= row syntax)
          (call check-literal-fit row target)
        )
      )
      (case (call .node-integer-syntax row)
        (if (. row unit)
          (return)
        )
        (let literal (call parse-integer-literal (. row value)))
        (let held (call literal-target literal target))
        (if (not (call literal-fits-target types literal held))
          (let shown (call (. program store-atom) (. row value)))
          (call (. frame diagnose) syntax .literal-does-not-fit shown no-type held)
        )
      )
    )
  )
  (fn-do + adapted-literal TypeId
    (param literal SyntaxId)
    (param given TypeId)
    (param other TypeId)
    ; The type an integer written with no suffix takes beside a value of an integer type it fits: the
    ; machine type of that value, so `offset + 1` stays in the type of `offset`, and a character's is
    ; `U32`, the type its arithmetic is in, and beside a float the machine type of that float, so
    ; `width ?? 1` needs no `as`. A constant a C header defines is such an integer. A float
    ; written with no suffix beside a value of `F32` it fits takes `F32`, so `scale * 0.5` stays in
    ; `F32`. The literal's node takes the type. Any other keeps its own, as does one beside a value of
    ; an enum. A choice of two such integers takes the type both take, and a tuple written beside a
    ; tuple of as many fields is the tuple of what its items take beside those fields.
    (return-if given (if (or (== literal 0) (== given other) (== other invalid-type) (== other no-type))))
    (blank)
    (match? ([] (. frame tree nodes) literal)
      (case (call .node-tuple-syntax row)
        (let adapted (call adapted-tuple (. row items) given other))
        (if (!= adapted given)
          (call (. facts replace-node-type) (. frame instance) literal adapted)
        )
        (return adapted)
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .else-op)
          (match? ([] (. frame tree nodes) (. row lhs))
            (case (call .node-binary-expression chosen)
              (if (and (== (. chosen op) .if-op) (call is-plain-integer (. chosen lhs)) plain-right)
                (let yes (call adapted-literal (. chosen lhs) given other))
                (let no (call adapted-literal (. row rhs) given other))
                (if (and (!= yes given) (== yes no))
                  (call (. facts replace-node-type) (. frame instance) literal yes)
                  (return yes)
                )
              )
              (lazy plain-right (call is-plain-integer (. row rhs)))
            )
          )
        )
        (return given)
      )
    )
    (return-if given (if (. ([] (. types completions) other) has-enums)))
    (blank)
    (let target
      (scope (if-expr (== (call (. types intrinsic-of) other) .char) (call (. types type-row) .uint32) number-type)
        (lazy number-type (call builtin-number types other))
      )
    )
    (let kind (call (. types intrinsic-of) target))
    (return-if given (if (== given target)))
    (blank)
    (match? ([] (. frame tree nodes) literal)
      (case (call .node-integer-syntax row)
        (let numeric (and (or (call is-integer-kind kind) (call intrinsic-is-float kind)) (!= kind .bool)))
        (if (and numeric (not (. row unit)) (call literal-fits-target types parsed target))
          (call (. facts replace-node-type) (. frame instance) literal target)
          (return target)
        )
        (lazy parsed (call parse-integer-literal (. row value)))
      )
      (case .node-c-identifier
        (let constant (call c-constant literal))
        (let numeric (and (or (call is-integer-kind kind) (call intrinsic-is-float kind)) (!= kind .bool)))
        (if (and constant numeric (call literal-fits-target types (call parse-integer-literal constant) target))
          (call (. facts replace-node-type) (. frame instance) literal target)
          (return target)
        )
      )
      (case (call .node-float-syntax row)
        (if (and (== kind .float32) (not (. row unit)) (call float-literal-fits types (. row value) target))
          (call (. facts replace-node-type) (. frame instance) literal target)
          (return target)
        )
      )
    )
    (return given)
  )
  (fn-do _ adapted-tuple TypeId
    (param items (of RowRange SyntaxId))
    (param given TypeId)
    (param other TypeId)
    (match? ([] (. types rows) given)
      (case (call .type-tuple row)
        (call (. types complete) other)
        (let mark (. types scratch types mark))
        (call push-fields types other)
        (if (or (!= (- (. types scratch types length) mark) (. row fields count)) (!= (. row fields count) (. items count)))
          (call (. types scratch types rewind) mark)
          (return given)
        )
        (let adapted-mark (. types scratch types mark))
        (let names-mark (. types scratch names mark))
        (let changed false)
        (let offset 0u32)
        (for (in item ([] (. frame tree children) items))
          (let field (call (. types child-type) (. row fields) offset))
          (let adapted (call adapted-literal item field ([] (. types scratch types) (+ mark offset))))
          (= changed (or changed (!= adapted field)))
          (call (. types scratch types push) adapted)
          (call (. types scratch names push) (call (. types child-name) (. row names) offset))
          (+= offset 1)
        )
        (let result (if-expr changed (call (. types intern-tuple) adapted-mark names-mark) given))
        (call (. types scratch types rewind) mark)
        (call (. types scratch names rewind) names-mark)
        (return result)
      )
    )
    (return given)
  )
  (fn-do + plain-item Bool
    (param syntax SyntaxId)
    (param offset Size)
    ; Whether the item at a place of a tuple written is an integer written with no suffix.
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-tuple-syntax row)
        (let position 0)
        (for (in item ([] (. frame tree children) (. row items)))
          (return-if (call is-plain-integer item) (if (== position offset)))
          (blank)
          (+= position 1)
        )
      )
    )
    (return false)
  )
  (fn-do + demand-error-report _
    ; Types what the report of an error no caller handles calls and the report of a panic does
    ; not: the converter of an error to text. The panic a failed conversion of a text written in
    ; source raises takes its message from it too.
    (if (!= (. instances report error-text) no-instance)
      (return)
    )
    (= (. instances report error-text) (call demand-converter (. types error-type) (. types string-type)))
  )
  (fn-expr + is-plain-integer Bool
    (param syntax SyntaxId)
    ; Whether an expression is an integer written with no suffix, or a constant a C header defines,
    ; which is one.
    (match ([] (. frame tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (or (not (. row unit)) (and (!= unsuffixed 0) (== syntax unsuffixed)))
      )
      (case .node-c-identifier
        (!= (call c-constant syntax) null)
      )
      (default
        false
      )
    )
  )
  (fn-do _ c-constant (? String)
    (param syntax SyntaxId)
    ; The number a constant a C header defines is written as, where an expression names one, as in
    ; `C:SEEK_END`.
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-c-identifier row)
        (return (call (. program c-constant-text) (. frame module) (. row name)))
      )
    )
    (return null)
  )
  (fn-do + unit-literal-of SyntaxId
    (param syntax SyntaxId)
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-argument argument)
        (return (call unit-literal-of (. argument expr)))
      )
      (case (call .node-integer-syntax row)
        (return (if-expr (and (. row unit) (or (== unsuffixed 0) (!= syntax unsuffixed))) syntax 0))
      )
      (case (call .node-float-syntax row)
        (return (if-expr (and (. row unit) (or (== unsuffixed 0) (!= syntax unsuffixed))) syntax 0))
      )
    )
    (return 0)
  )
  (fn-do + literal-of SyntaxId
    (param syntax SyntaxId)
    ; An argument that is a number written with no suffix or a constant a C header defines, a list
    ; of only such integers or such lists, or a choice or a tuple written with one among its sides or
    ; items, which a call may take as any type that holds it.
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (return (if-expr (and (. row unit) (or (== unsuffixed 0) (!= syntax unsuffixed))) 0 syntax))
      )
      (case .node-c-identifier
        (return (if-expr (!= (call c-constant syntax) null) syntax 0))
      )
      (case (call .node-float-syntax row)
        (return (if-expr (and (. row unit) (or (== unsuffixed 0) (!= syntax unsuffixed))) 0 syntax))
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .else-op)
          (match? ([] (. frame tree nodes) (. row lhs))
            (case (call .node-binary-expression chosen)
              (if (and (== (. chosen op) .if-op) (or (!= (call literal-of (. chosen lhs)) 0) right-literal))
                (return syntax)
              )
              (lazy right-literal (!= (call literal-of (. row rhs)) 0))
            )
          )
        )
      )
      (case (call .node-list-syntax row)
        (if (== (. row items count) 0)
          (return 0)
        )
        (for (in item ([] (. frame tree children) (. row items)))
          (return-if 0 (if (and (not (call is-plain-integer item)) (== (call literal-of item) 0))))
        )
        (return syntax)
      )
      (case .node-call-expression
        (return-if 0 (if (== (call (. frame tree listed-feeds) syntax) 0)))
        (blank)
        (let feeds (call listed-items syntax))
        (if (== (. feeds length) 0)
          (return 0)
        )
        (for (in item feeds)
          (return-if 0 (if (and (not (call is-plain-integer item)) (== (call literal-of item) 0))))
        )
        (return syntax)
      )
      (case (call .node-tuple-syntax row)
        (for (in item ([] (. frame tree children) (. row items)))
          (return-if syntax (if (!= (call literal-of item) 0)))
        )
      )
    )
    (return 0)
  )
  (fn-do + fitting-literal Bool
    (param syntax SyntaxId)
    (param target TypeId)
    ; Whether an expression is an integer written with no suffix that a machine integer type holds
    ; unchanged, a float written with none that a float type holds, a list of only such integers that
    ; a list of that type holds, such a value an arm `|? value if condition` gives, or a choice or a
    ; tuple written whose sides or items are such values or convert unasked. The type may be the
    ; optional of one, or a union with a case of one.
    (let held (if-expr (call (. types is-optional) target) (call (. types optional-inner) target) target))
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-argument argument)
        (return (call fitting-literal (. argument expr) target))
      )
      (case .node-block
        (let row (call (. frame tree arms-value) syntax))
        (return (and (!= row syntax) (call fitting-literal row target)))
      )
      (case (call .node-binary-expression row)
        (if (!= (. row op) .else-op)
          (return false)
        )
        (match? ([] (. frame tree nodes) (. row lhs))
          (case (call .node-binary-expression chosen)
            (if (== (. chosen op) .if-op)
              (return (and (call fits-unasked (. chosen lhs) target) (call fits-unasked (. row rhs) target)))
            )
          )
        )
        (return false)
      )
      (case (call .node-unary-expression row)
        (if (!= (. row op) .optional-force-op)
          (return false)
        )
        (match? ([] (. frame tree nodes) (. row operand))
          (case (call .node-binary-expression chosen)
            (if (== (. chosen op) .if-op)
              (return (call fits-unasked (. chosen lhs) target))
            )
          )
        )
        (return false)
      )
      (case (call .node-integer-syntax row)
        (return
          (scope (or written whole)
            (lazy written (and (or (not (. row unit)) (and (!= unsuffixed 0) (== syntax unsuffixed))) (call integer-fits parsed held)))
            (lazy whole (and (not (. parsed overflow)) (call whole-in-unit syntax (as (. parsed value) F64) held)))
            (lazy parsed (call parse-integer-literal (. row value)))
          )
        )
      )
      (case .node-c-identifier
        (let constant (call c-constant syntax))
        (if constant
          (return (call integer-fits (call parse-integer-literal constant) held))
        )
        (return false)
      )
      (case (call .node-float-syntax row)
        (return
          (scope (or written whole)
            (lazy written (and (or (not (. row unit)) (and (!= unsuffixed 0) (== syntax unsuffixed))) float-fits))
            (lazy whole (call whole-in-unit syntax (as (. row value) F64) held))
            (lazy float-fits (call float-literal-fits types (. row value) held))
          )
        )
      )
      (case (call .node-tuple-syntax row)
        (call (. types complete) held)
        (let mark (. types scratch types mark))
        (call push-fields types held)
        (let count (- (. types scratch types length) mark))
        (let fits (and (!= count 0) (== count (. row items count))))
        (let offset 0)
        (for (in item ([] (. frame tree children) (. row items)))
          (if fits
            (= fits (call fits-unasked item ([] (. types scratch types) (+ mark offset))))
          )
          (+= offset 1)
        )
        (call (. types scratch types rewind) mark)
        (return fits)
      )
      (case (call .node-list-syntax row)
        (let list (call class-ref types held))
        (if (or empty (!= (. list module) (. types list-decl module)) (!= (. list decl) (. types list-decl decl)))
          (return false)
        )
        (lazy empty (== (. row items count) 0))
        (let item (call class-arg types held 0))
        (for (in element ([] (. frame tree children) (. row items)))
          (if (not (call fitting-literal element item))
            (return false)
          )
        )
        (return true)
      )
      (case .node-call-expression
        (return-if false (if (== (call (. frame tree listed-feeds) syntax) 0)))
        (blank)
        (let feeds (call listed-items syntax))
        (let list (call class-ref types held))
        (if (or (== (. feeds length) 0) (!= (. list module) (. types list-decl module)) (!= (. list decl) (. types list-decl decl)))
          (return false)
        )
        (let item (call class-arg types held 0))
        (for (in element feeds)
          (if (not (call fitting-literal element item))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ listed-items (list SyntaxId)
    (param syntax SyntaxId)
    (let items (list SyntaxId))
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-call-expression row)
        (if (is-not ([] (. frame tree nodes) (. row callable)) .node-type-identifier)
          (return items)
        )
      )
    )
    (let feed (call (. frame tree listed-feeds) syntax))
    (while (!= feed 0)
      (match ([] (. frame tree nodes) feed)
        (case (call .node-feed-expression row)
          (if (or (. row is-spread) (. row is-optional))
            (call (. items clear))
            (return items)
          )
          (+= items (. row item))
          (= feed (. row next))
        )
        (default
          (= feed 0)
        )
      )
    )
    (return items)
  )
  (fn-expr + fits-unasked Bool
    (param syntax SyntaxId)
    (param target TypeId)
    ; Whether an expression is such a literal, or a value that converts to the type unasked.
    (or (call fitting-literal syntax target) (call (. relations implicit) (call compare-held given target)))
    (where
      (lazy given (call (. facts node-type) (. frame instance) syntax))
    )
  )
  (fn-do + suffix-type TypeId
    (param syntax SyntaxId)
    (match ([] (. frame tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (return-if no-type (if (not (. row unit))))
      )
      (case (call .node-float-syntax row)
        (return-if no-type (if (not (. row unit))))
      )
      (default
        (return no-type)
      )
    )
    (let type (call (. facts node-type) (. frame instance) syntax))
    (return-if no-type (if (or (== type no-type) (== type invalid-type) (not (. ([] (. types completions) type) is-builtin)))))
    (blank)
    (let kind (call (. types intrinsic-of) type))
    (return-if no-type (if (or (== kind .bool) (== kind .char) (. ([] (. types completions) type) has-enums))))
    (return (if-expr (or (call is-integer-kind kind) (call intrinsic-is-float kind)) type no-type))
  )
  (fn-do + unsuffixed-fits Bool
    (param syntax SyntaxId)
    (param target TypeId)
    (let saved unsuffixed)
    (= unsuffixed syntax)
    (let fits (call fitting-literal syntax target))
    (= unsuffixed saved)
    (return fits)
  )
  (fn-expr + unsuffixed-type TypeId
    (param syntax SyntaxId)
    (match ([] (. frame tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (call magnitude-type types (call parse-integer-literal (. row value)))
      )
      (case .node-float-syntax
        (. types f64-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-do + unsuffixed-beside TypeId
    (param syntax SyntaxId)
    (param other TypeId)
    (let given (call unsuffixed-type syntax))
    (return-if given (if (or (== given no-type) (== given other) (== other invalid-type) (== other no-type))))
    (return-if given (if (. ([] (. types completions) other) has-enums)))
    (blank)
    (let target
      (scope (if-expr (== (call (. types intrinsic-of) other) .char) (call (. types type-row) .uint32) number-type)
        (lazy number-type (call builtin-number types other))
      )
    )
    (let kind (call (. types intrinsic-of) target))
    (return-if given (if (== given target)))
    (blank)
    (match? ([] (. frame tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (let numeric (and (or (call is-integer-kind kind) (call intrinsic-is-float kind)) (!= kind .bool)))
        (if (and numeric (call literal-fits-target types (call parse-integer-literal (. row value)) target))
          (return target)
        )
      )
      (case (call .node-float-syntax row)
        (if (and (== kind .float32) (call float-literal-fits types (. row value) target))
          (return target)
        )
      )
    )
    (return given)
  )
  (fn-do _ integer-fits Bool
    (param literal IntegerLiteral)
    (param held TypeId)
    ; Whether an integer written with no suffix is a value of a machine integer type, or of a case of
    ; a union.
    (if (== (call (. types intrinsic-of) held) .union)
      (return (call some (call (. types cases-of) held) (:where (call holds-literal literal (. each type)))))
    )
    (return (call holds-literal literal held))
  )
  (fn-expr _ holds-literal Bool
    (param literal IntegerLiteral)
    (param type TypeId)
    ; Whether a machine integer type holds an integer written with no suffix, or a float type does, at
    ; the value of that type nearest it.
    (and plain-number (not (. ([] (. types completions) type) has-enums)) (call literal-fits-target types literal type))
    (where
      (lazy plain-number (and (!= type no-type) numeric (!= kind .bool) (!= kind .char)))
      (lazy numeric (or (call is-integer-kind kind) (call intrinsic-is-float kind)))
      (blank)
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-expr _ literal-target TypeId
    (param literal IntegerLiteral)
    (param target TypeId)
    (case? (!= (call (. types intrinsic-of) held) .union)
      held
    )
    (case? (or (not (call relation-legal relation)) (== (. relation case-index) (. U32 max)))
      held
    )
    (default
      (. ([] (call (. types cases-of) held) (. relation case-index)) type)
    )
    (where
      (lazy held (if-expr (call (. types is-optional) target) (call (. types optional-inner) target) target))
      (lazy relation (call compare-held (call magnitude-type types literal) held))
    )
  )
)

(fn-do + is-filter-condition Bool
  (param types Types)
  (param program Program)
  (param closure TypeId)
  ; Whether a closure is the condition a filter keeps its items by, which answers a truth as a
  ; condition does.
  (match? ([] (. types rows) closure)
    (case (call .type-closure row)
      (let owner ([] (. program modules) (. row module)))
      (match? ([] (. owner decls) (. row decl))
        (case (call .decl-function fn)
          (if (== (. fn kind) .pipeline-decl)
            (match? ([] (. owner tree nodes) (. fn syntax))
              (case (call .node-pipeline-expression pipe)
                (return (== (. pipe op) .filter-op))
              )
              (case (call .node-binary-expression pipe)
                (return (== (. pipe op) .filter-op))
              )
            )
          )
        )
      )
    )
  )
  (return false)
)
