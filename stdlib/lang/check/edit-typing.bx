(import ./call-paths)
(import ./checker)
(import ./class-tables)
(import ./facts)
(import ./instances)
(import ./panics)
(import ./parallel-typing)
(import ./restrictions)
(import ./session)
(import ./stable-key)
(import ./stack-locals)
(import ./type-store)
(import ./types)
(import ./typing)
(import ./witnesses)
(import /core/arena)
(import /core/map)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/syntax-program)
(import /stream/aggregate)
(import /stream/sort)
(blank)
(prop _ kept-typing-slots Size (= 4))
(prop _ retype-growth-percent Size (= 50))

(fn-do + retype-edit (? String)
  (param session Session)
  (param next Program)
  (param emits Bool)
  (let old (. session program))
  (return-if "modules" (if (!= (. old modules length) (. next modules length))))
  (return-if "atoms" (if (not (call (. next shares-atoms-with) old))))
  (call (. next continue-keys) old)
  (let changed (list ModuleId))
  (for (in position (..< 0 (. old modules length)))
    (let kept ([] (. old modules) position))
    (let made ([] (. next modules) position))
    (return-if "paths" (if (!= (. kept path) (. made path))))
    (if (!= (. kept tree source) (. made tree source))
      (+= changed (as position ModuleId))
    )
  )
  (call (. next note-derived-names))
  (return-if "derived properties" (if (not (call (. old same-derived-names) next))))
  (return-if "effects" (if (not (call (. old effects same-as) (. next effects)))))
  (if (== (. changed length) 0)
    (call (. session retarget) next)
    (return null)
  )
  (let held (. session held-bytes))
  (if (== (. session fresh-bytes) 0)
    (= (. session fresh-bytes) held)
  )
  (return-if "grown" (if (> held (+ (. session fresh-bytes) (/ (* (. session fresh-bytes) retype-growth-percent) 100)))))
  (return-if (str (. changed length) " modules changed") (if (!= (. changed length) 1)))
  (let module ([] changed 0))
  (return-if "declarations" (if (not (call same-decls ([] (. old modules) module) ([] (. next modules) module)))))
  (return-if "outside bodies" (if (!= (call outline ([] (. old modules) module)) (call outline ([] (. next modules) module)))))
  (return-if "constructor subscriptions" (if (!= (call subscriptions ([] (. old modules) module)) next-subscriptions)))
  (lazy next-subscriptions (call subscriptions ([] (. next modules) module)))
  (let moved (call node-map ([] (. old modules) module) ([] (. next modules) module)))
  (return-if "nodes" (if (not moved)))
  (let instances (. session instances))
  (let facts (. session facts))
  (let count (. instances length))
  (let retired (list Bool))
  (let edited (list InstanceId))
  (for (in position (..< 0 count))
    (let row ([] (. instances rows) position))
    (let held
      (scope (and in-module (!= (. row state) .instance-unstarted) (!= position (. instances dead)))
        (lazy in-module (or (== (. row module) module) (call typed-for session row module)))
      )
    )
    (+= retired held)
    (if held
      (return-if (str "unretirable " position) (if (. row unretirable)))
      (return-if (str "state " position) (if (!= (. row state) .instance-done)))
      (+= edited (as position InstanceId))
    )
  )
  (for (in id (call (. facts unmoved-namers) module moved instances))
    (if (and (!= id no-instance) (!= id (. instances dead)) (not ([] retired id)))
      (let row ([] (. instances rows) id))
      (return-if (str "unretirable " id) (if (. row unretirable)))
      (return-if (str "state " id) (if (!= (. row state) .instance-done)))
      (= ([] retired id) true)
      (+= edited id)
    )
  )
  (return? (call retired-refinements session retired edited))
  (if emits
    (return-if "diagnostics" (if (and (not (call keeps-errors session module retired)) (not all-retired))))
    (lazy all-retired (call retires-all (. session typed-amid-errors) retired))
  )
  (let diagnosed (call diagnosed-decls session module))
  (let defaults (list U64))
  (for (in id edited)
    (+= defaults (. ([] (. instances rows) id) typed-defaults))
  )
  (let wide (list U64))
  (for (in key (. instances wide-defaults))
    (if (and (< (/rshift/ key 32) (as count U64)) ([] retired (as (/rshift/ key 32) Size)))
      (+= wide key)
    )
  )
  (let summaries (list String))
  (for (in id edited)
    (+= summaries (call summary session id))
  )
  (let planned (call plan-size facts))
  (let owner (as (- (. old modules length) 1) ModuleId))
  (let dead (call (. instances add-dead) owner (as (- (. ([] (. old modules) owner) decls length) 1) DeclId)))
  (while (< (. retired length) (. instances length))
    (+= retired false)
  )
  (let made (. instances length))
  (let machine-count (. facts machines length))
  (let union-count (. facts early-unions length))
  (call (. facts retire) retired dead)
  (call (. session panics retire) retired)
  (call (. session errors retire) retired dead)
  (let checked (list Size))
  (for (in (tuple class checker) (. session types checked-classes))
    (if (and (< (as checker Size) count) ([] retired checker))
      (+= checked class)
    )
  )
  (for (in class checked)
    (-= ([] (. session types checked-classes) class))
  )
  (call (. session bindings forget-module) module)
  (call (. session binder forget-module) module)
  (call (. session types forget-module) module)
  (let used (list Size))
  (for (in (tuple key _) (. session scratch using-types))
    (if (== (/rshift/ key 32) (as module Size))
      (+= used key)
    )
  )
  (for (in key used)
    (-= ([] (. session scratch using-types) key))
  )
  (call (. facts stack-needs clear))
  (call (. facts stack-holds clear))
  (for (in id edited)
    (call (. instances retype) id)
  )
  (call (. session types unseal))
  (call (. instances unseal))
  (return? (call (. facts move-syntax) module moved instances retired dead))
  (call (. instances move-syntax) module moved)
  (call (. session retarget) next)
  (call queue-edited session edited)
  (call retype session)
  (call retype-overrides session retired)
  (call retype-witnesses session retired)
  (call retype-defaults session edited defaults wide)
  (call retype session)
  (return? (call (. facts replace-machines) retired machine-count union-count))
  (return-if "added instances" (if (not (call settled-added instances made))))
  (return-if "event plan" (if (!= (call plan-size facts) planned)))
  (for (in id edited)
    (let row ([] (. instances rows) id))
    (return-if (str "retyped state " id) (if (!= (. row state) .instance-done)))
    (return-if (str "retyped unretirable " id) (if (. row unretirable)))
  )
  (for (in decl diagnosed)
    (return-if "unbound diagnostics" (if (not (call (. session bindings binding-for) module decl))))
  )
  (call (. session panics retest-forces))
  (call check-forces session)
  (call check-chains session)
  (call number-style-sites session)
  (call number-domains session)
  (return-if "domains" (if (> (. facts domain-order length) 32)))
  (call (. session panics gather-unit-calls))
  (call (. facts fold-initializers) (. session bindings) retired)
  (call (. facts chain-loose-calls))
  (call (. session panics propagate))
  (let paths (call CallPaths session))
  (call (. (call StackLocals session paths) check))
  (call (. (call Restrictions session paths) chain-reports))
  (return-if "settled added instances" (if (not (call settled-added instances made))))
  (for (in position (..< 0 (. edited length)))
    (let now (call summary session ([] edited position)))
    (return-if (str "summary " ([] edited position) ": " ([] summaries position) " -> " now) (if (!= now ([] summaries position))))
  )
  (if emits
    (call note-amid-errors session edited made)
    (call (. session seal))
  )
  (return null)
)

(fn-do _ keeps-errors Bool
  (param session Session)
  (param module ModuleId)
  (param retired (list Bool))
  (for (in row (. session facts diagnostics))
    (return-if true (if (or (>= (as (. row instance) Size) (. retired length)) (not ([] retired (. row instance))))))
  )
  (return (call (. session bindings reports) module))
)

(fn-expr _ retires-all Bool
  (param amid (list Bool))
  (param retired (list Bool))
  (call all (..< 0 (. amid length)) (:where (or (not ([] amid each)) (and (< each (. retired length)) ([] retired each)))))
)

(fn-expr _ has-errors Bool
  (param session Session)
  (or (!= (. session facts diagnostics length) 0) (call (. session bindings reports)))
)

(fn-do _ note-amid-errors _
  (param session Session)
  (param edited (list InstanceId))
  (param made Size)
  (let instances (. session instances))
  (if (not (call has-errors session))
    (call (. session typed-amid-errors clear))
    (return)
  )
  (while (< (. session typed-amid-errors length) (. instances length))
    (+= (. session typed-amid-errors) false)
  )
  (for (in id edited)
    (= ([] (. session typed-amid-errors) id) true)
  )
  (for (in id (..< made (. instances length)))
    (if (!= (. ([] (. instances rows) id) state) .instance-unstarted)
      (= ([] (. session typed-amid-errors) id) true)
    )
  )
)

(fn-do _ diagnosed-decls (list DeclId)
  (param session Session)
  (param module ModuleId)
  (let bindings (. session bindings))
  (let found (list DeclId))
  (for (in position (..< 0 (. ([] (. session program modules) module) decls length)))
    (let binding (call (. bindings binding-for) module (as position DeclId)))
    (if (and binding (!= (. ([] (. bindings bindings) binding) diagnostics count) 0))
      (+= found (as position DeclId))
    )
  )
  (return found)
)

(fn-do _ retired-refinements (? String)
  (param session Session)
  (param retired (list Bool))
  (param edited (list InstanceId))
  ; Retires each state machine that refines one retired, through every refinement between: its
  ; typing read the machine it refines, its cases and its union, which typing that machine again
  ; makes anew. Gives why an edit cannot retire one, or nothing.
  (let instances (. session instances))
  (let growing true)
  (while growing
    (= growing false)
    (for (in machine (. session facts machines))
      (let above (. machine refined))
      (if (and (!= above no-instance) ([] retired above) (not ([] retired (. machine instance))))
        (let row ([] (. instances rows) (. machine instance)))
        (return-if (str "unretirable " (. machine instance)) (if (. row unretirable)))
        (return-if (str "state " (. machine instance)) (if (!= (. row state) .instance-done)))
        (= ([] retired (. machine instance)) true)
        (+= edited (. machine instance))
        (= growing true)
      )
    )
  )
  (return null)
)

(fn-do _ typed-for Bool
  (param session Session)
  (param row Instance)
  (param module ModuleId)
  ; Whether an instance is typed for a class a module declares, or for one that derives from such a
  ; class, as a constructor a class takes from its base is: it reads the declarations of those
  ; classes, such as the rules, the markup queries and the defaults rule `• This` it applies, so an
  ; edit to the module retires it with the module's own.
  (return-if false (if (== (. row self-type) no-type)))
  (let level (? TypeId) (. row self-type))
  (while level
    (match? ([] (. session types rows) level)
      (case (call .type-class class)
        (return-if true (if (== (. class module) module)))
      )
    )
    (= level (call (. session types base-of) level))
  )
  (return false)
)

(fn-do _ node-map (? (list SyntaxId))
  (param kept Module)
  (param made Module)
  ; Where an edit to a module moves each node, by its node in the edited tree, or 0 for one whose
  ; lines the edit changes in a body. The edit leaves the lines `outline` keeps as they were, and
  ; a node in a body all of whose subtree's lines are as they were parses as it did, so the trees
  ; hold the same nodes there, but the edit numbers them anew where it adds or removes nodes before
  ; them. A body the edit changes is followed down to the nodes whose lines it leaves, while their
  ; places line up. Gives nothing where the trees differ outside bodies.
  (let kept-tree (. kept tree))
  (let made-tree (. made tree))
  (let kept-lines (call List (call (. kept-tree source split) "\n")))
  (let made-lines (call List (call (. made-tree source split) "\n")))
  (let kept-spans (call line-spans kept-tree))
  (let made-spans (call line-spans made-tree))
  (let kept-bodies (call body-nodes kept))
  (let made-bodies (call body-nodes made))
  (let moved (list SyntaxId))
  (for (in _ (..< 0 (. kept-tree nodes length)))
    (+= moved 0)
  )
  (let olds (list SyntaxId))
  (let news (list SyntaxId))
  (let ways (list NodeWay))
  (+= olds (. kept-tree root))
  (+= news (. made-tree root))
  (+= ways .outside)
  (while (!= (. olds length) 0)
    (let was ([] olds (- (. olds length) 1)))
    (let now ([] news (- (. news length) 1)))
    (let way ([] ways (- (. ways length) 1)))
    (call (. olds pop))
    (call (. news pop))
    (call (. ways pop))
    (let was-at ([] (. kept-tree nodes loc) was))
    (let now-at ([] (. made-tree nodes loc) now))
    (if (== way .same)
      (= ([] moved was) now)
      (let was-children (call (. kept-tree children-of) was))
      (let now-children (call (. made-tree children-of) now))
      (return-if null (if (!= (. was-children length) (. now-children length))))
      (for (in position (..< 0 (. was-children length)))
        (+= olds ([] was-children position))
        (+= news ([] now-children position))
        (+= ways .same)
      )
      (continue)
    )
    (if (or (== way .inside) ([] kept-bodies was))
      (if (!= (. was-at begin column) (. now-at begin column))
        (continue)
      )
      (if (call same-lines kept-lines ([] kept-spans was) made-lines ([] made-spans now))
        (+= olds was)
        (+= news now)
        (+= ways .same)
        (continue)
      )
      (let was-children (call (. kept-tree children-of) was))
      (let now-children (call (. made-tree children-of) now))
      (if (== (. was-children length) (. now-children length))
        (for (in position (..< 0 (. was-children length)))
          (+= olds ([] was-children position))
          (+= news ([] now-children position))
          (+= ways .inside)
        )
      )
      (continue)
    )
    (return-if null (if (!= (. was-at begin column) (. now-at begin column))))
    (= ([] moved was) now)
    (let was-children (call some-children kept-tree was kept-bodies false))
    (let now-children (call some-children made-tree now made-bodies false))
    (return-if null (if (!= (. was-children length) (. now-children length))))
    (for (in position (..< 0 (. was-children length)))
      (+= olds ([] was-children position))
      (+= news ([] now-children position))
      (+= ways .outside)
    )
    (let was-bodies (call some-children kept-tree was kept-bodies true))
    (let now-bodies (call some-children made-tree now made-bodies true))
    (if (== (. was-bodies length) (. now-bodies length))
      (for (in position (..< 0 (. was-bodies length)))
        (+= olds ([] was-bodies position))
        (+= news ([] now-bodies position))
        (+= ways .inside)
      )
    )
  )
  (return moved)
)

(type _ NodeWay (is U8)
  ; How `node-map` follows a pair of nodes: outside bodies, where the trees must line up; in a body
  ; the edit may change; or below a node whose lines it leaves as they were.
  (variant outside)
  (variant inside)
  (variant same)
)

(fn-do _ body-nodes (list Bool)
  (param module Module)
  ; The nodes of a module that begin the bodies whose lines `outline` leaves out.
  (let tree (. module tree))
  (let bodies (list Bool))
  (for (in _ (..< 0 (. tree nodes length)))
    (+= bodies false)
  )
  (for (in decl (. module decls))
    (match? decl
      (case (call .decl-function fn)
        (if (!= (. fn body) 0)
          (match? ([] (. tree nodes) (. fn body))
            (case .node-block
              (= ([] bodies (. fn body)) true)
            )
            (case (call .node-top-level-syntax row)
              (for (in statement ([] (. tree children) (. row statements)))
                (if (not (call is-declaration-syntax tree statement))
                  (= ([] bodies statement) true)
                )
              )
            )
          )
        )
      )
      (case (call .decl-property property)
        (let machine (call (. tree declared-machine) (. property value)))
        (if (!= machine 0)
          (for (in item (call (. tree state-items) (call (. tree state-body) machine)))
            (= ([] bodies item) true)
          )
        )
      )
    )
  )
  (return bodies)
)

(fn-expr _ some-children (list SyntaxId)
  (param tree AST)
  (param id SyntaxId)
  (param bodies (list Bool))
  (param begin-bodies Bool)
  (in each (call (. tree children-of) id) (when (== ([] bodies each) begin-bodies)))
)

(fn-do _ line-spans (list U64)
  (param tree AST)
  ; The first and last lines of each node's subtree, the first in the high half, or `U64.max` for
  ; a node with none, so that a node is judged by all that is below it, whether or not its own place
  ; holds it.
  (let spans (list U64))
  (for (in id (..< 0u32 (. tree nodes length)))
    (let place ([] (. tree nodes loc) id))
    (+= spans
      (scope (if-expr (!= place (call MatchLocation)) line-span (. U64 max))
        (lazy line-span (/or/ (/lshift/ (as (. place begin line) U64) 32) (as (. place end line) U64)))
      )
    )
  )
  (let order (list SyntaxId))
  (let open (list SyntaxId))
  (+= open (. tree root))
  (while (!= (. open length) 0)
    (let id ([] open (- (. open length) 1)))
    (call (. open pop))
    (+= order id)
    (for (in child (call (. tree children-of) id))
      (+= open child)
    )
  )
  (for (in position (..< 0 (. order length)))
    (let id ([] order (- (. order length) 1 position)))
    (for (in child (call (. tree children-of) id))
      (= ([] spans id) (call joined-span ([] spans id) ([] spans child)))
    )
  )
  (return spans)
)

(fn-expr _ joined-span U64
  (param span U64)
  (param other U64)
  (case? (== span (. U64 max))
    other
  )
  (case? (== other (. U64 max))
    span
  )
  (default
    (/or/ (/lshift/ first 32) last)
  )
  (where
    (lazy first (if-expr (< (/rshift/ other 32) (/rshift/ span 32)) (/rshift/ other 32) (/rshift/ span 32)))
    (lazy last (if-expr (> (/and/ other (as (. U32 max) U64)) (/and/ span (as (. U32 max) U64))) (/and/ other (as (. U32 max) U64)) (/and/ span (as (. U32 max) U64))))
  )
)

(fn-do _ same-lines Bool
  (param kept (list String))
  (param kept-span U64)
  (param made (list String))
  (param made-span U64)
  (return-if false (if (or (== kept-span (. U64 max)) (== made-span (. U64 max)))))
  (let kept-first (as (/rshift/ kept-span 32) Size))
  (let kept-last (as (/and/ kept-span (as (. U32 max) U64)) Size))
  (let made-first (as (/rshift/ made-span 32) Size))
  (let made-last (as (/and/ made-span (as (. U32 max) U64)) Size))
  (return-if false (if (or (< kept-last kept-first) (< made-last made-first) past-end)))
  (lazy past-end (or (>= kept-last (. kept length)) (>= made-last (. made length))))
  (return-if false (if (!= (- kept-last kept-first) (- made-last made-first))))
  (for (in offset (.. 0 (- kept-last kept-first)))
    (return-if false (if (!= ([] kept (+ kept-first offset)) ([] made (+ made-first offset)))))
  )
  (return true)
)

(fn-do _ settled-added Bool
  (param instances Instances)
  (param start Size)
  (for (in added (..< start (. instances length)))
    (let row ([] (. instances rows) added))
    (if (and (!= (. row state) .instance-unstarted) (or (!= (. row state) .instance-done) (. row unretirable)))
      (return false)
    )
  )
  (return true)
)

(fn-do _ queue-edited _
  (param session Session)
  (param edited (list InstanceId))
  (let instances (. session instances))
  (let places (call (of Map StableKey InstanceId)))
  (let keys (list StableKey))
  (for (in id edited)
    (= ([] places ([] (. instances stable-keys) id)) id)
    (+= keys ([] (. instances stable-keys) id))
  )
  (let sorted (call sort keys))
  (for (in key sorted)
    (let id (!! ([] places key)))
    (let row ([] (. instances rows) id))
    (if (!= (. row probe) 0)
      (continue)
    )
    (if (!= (. row enclosing) no-instance)
      (+= (. instances written-in) id)
      (else-if (or (!= (. row initializer) 0) (!= (. row root-values) 0))
        (+= (. instances typed-on-read) id)
      )
      (else
        (call (. instances queue) id)
      )
    )
  )
)

(fn-do _ retype _
  (param session Session)
  (let instances (. session instances))
  (while true
    (while (< (. instances worklist-next) (. instances worklist length))
      (let id ([] (. instances worklist) (. instances worklist-next)))
      (+= (. instances worklist-next) 1)
      (call demand-instance session id)
    )
    (if (or (call type-written-in session) (call type-unread session))
      (continue)
    )
    (call (. session errors settle-open))
    (if (call check-used-classes session)
      (continue)
    )
    (return)
  )
)

(fn-do _ retype-overrides _
  (param session Session)
  (param retired (list Bool))
  ; Checks again the answers of the overrides an edit typed again in place, as the type pass
  ; checks them once both an override and its base are typed (`ClassTables.check-retyped`).
  (let any false)
  (for (in fact (. session facts overrides))
    (= any (or any (and (< (as (. fact override) Size) (. retired length)) ([] retired (. fact override)))))
  )
  (return-if (if (not any)))
  (let tables (call ClassTables session))
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (call (. tables check-retyped) checker retired)
  (call (. checker close))
  (call (. checker retire))
  (call (. tables release))
)

(fn-do _ retype-witnesses _
  (param session Session)
  (param retired (list Bool))
  ; Notes again the answers to the functions of interfaces that an edit typed again in place, as the
  ; type pass notes them once it finds them (`WitnessTables.check-retyped`).
  (let any false)
  (for (in slot (. session facts witness-slots))
    (= any
      (scope (or any (and callee-in-range ([] retired (. slot callee))))
        (lazy callee-in-range (and (!= (. slot callee) no-instance) (< (as (. slot callee) Size) (. retired length))))
      )
    )
  )
  (return-if (if (not any)))
  (let witnesses (call WitnessTables session))
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (call (. witnesses check-retyped) checker (. checker conversions) retired)
  (call (. checker close))
  (call (. checker retire))
)

(fn-do _ retype-defaults _
  (param session Session)
  (param edited (list InstanceId))
  (param defaults (list U64))
  (param wide (list U64))
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (for (in position (..< 0 (. edited length)))
    (let bits ([] defaults position))
    (for (in place (..< 0u32 64u32))
      (if (!= (/and/ bits (/lshift/ 1u64 (as place U64))) 0)
        (call (. checker type-default) ([] edited position) place)
      )
    )
  )
  (for (in key wide)
    (call (. checker type-default) (as (/rshift/ key 32) InstanceId) (as (/and/ key (as (. U32 max) U64)) U32))
  )
  (call (. checker close))
  (call (. checker retire))
)

(fn-do _ summary String
  (param session Session)
  (param id InstanceId)
  (let instances (. session instances))
  (let row ([] (. instances rows) id))
  (let signature ([] (. instances signatures) id))
  (let errors (list String))
  (for (in offset (..< 0 (. signature errors count)))
    (+= errors (str ([] (. instances signature-types) (+ (. signature errors start) offset))))
  )
  (let flags (str (. row may-panic) " " (. row polls) " " (. row is-generator) " " (. row reads-self) " " (. row branches) " " (. row returns-own) " " (. row gives-unwritten) " " (. row casts-errors) " " (. row ends-generator) " " (. row quiet) " " (. row splits-yields) " " (. row fills-share) " " (. row uses-helper) " " (. row rolls-helper) " " (. row carries-mark) " " (. row is-live) " " (. row consumes) " " (. row hands-back)))
  (return (str (. signature returns) " " (. signature declared-returns) " " (. signature return-state) " " (. signature error-state) " [" (call (. "," join) errors) "] " (. row makes) " " (. row yields) " " (. row materialized) " " (. row retyped) " " flags))
)

(fn-do _ same-decls Bool
  (param kept Module)
  (param made Module)
  (return-if false (if (!= (. kept decls length) (. made decls length))))
  (for (in position (..< 0 (. kept decls length)))
    (if (!= (call decl-shape ([] (. kept decls) position)) (call decl-shape ([] (. made decls) position)))
      (return false)
    )
  )
  (return true)
)

(fn-do _ outline String
  (param module Module)
  ; The lines of a module that an edit typed again in place must leave as they were: all but the
  ; bodies of its functions and the cases and transitions of the state machines its properties
  ; hold, whose unions a retyped machine must make again as they were (`Facts.replace-machines`).
  (let tree (. module tree))
  (let lines (call List (call (. tree source split) "\n")))
  (let inside (list Bool))
  (for (in _ lines)
    (+= inside false)
  )
  (for (in decl (. module decls))
    (match? decl
      (case (call .decl-function fn)
        (if (!= (. fn body) 0)
          (call mark-body tree (. fn body) inside)
        )
      )
      (case (call .decl-property property)
        (let machine (call (. tree declared-machine) (. property value)))
        (if (!= machine 0)
          (for (in item (call (. tree state-items) (call (. tree state-body) machine)))
            (call mark-lines tree item inside)
          )
        )
      )
    )
  )
  (return (call (. "\n" join) (in ([] lines each) (..< 0 (. lines length)) (when (and (not ([] inside each)) (not (call blank ([] lines each))))))))
)

(fn-do _ mark-body _
  (param tree AST)
  (param body SyntaxId)
  (param inside (list Bool))
  (match? ([] (. tree nodes) body)
    (case (call .node-block block)
      (for (in statement ([] (. tree children) (. block body)))
        (call mark-lines tree statement inside)
      )
    )
    (case (call .node-top-level-syntax row)
      (for (in statement ([] (. tree children) (. row statements)))
        (if (not (call is-declaration-syntax tree statement))
          (call mark-lines tree statement inside)
        )
      )
    )
  )
)

(fn-do _ mark-lines _
  (param tree AST)
  (param statement SyntaxId)
  (param inside (list Bool))
  (let loc ([] (. tree nodes loc) statement))
  (for (in line (.. (. loc begin line) (. loc end line)))
    (if (< (as line Size) (. inside length))
      (= ([] inside line) true)
    )
  )
)

(fn-do _ subscriptions String
  (param module Module)
  ; The events the constructors of a module subscribe to in their bodies, as
  ; `Checker.constructor-events` finds them: a loop's container that is a name alone or a name read
  ; from `this`. The event plans of the classes are kept across an edit retyped in place, so it may
  ; not change these.
  (let tree (. module tree))
  (let found (list String))
  (for (in decl (. module decls))
    (match? decl
      (case (call .decl-function fn)
        (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)) (!= (. fn body) 0))
          (let floor (call (. tree subtree-start) (. fn body)))
          (let node (+ (. fn body) 1))
          (while (> node floor)
            (-= node 1)
            (match? ([] (. tree nodes) node)
              (case .node-function-syntax
                (= node (call (. tree subtree-start) node))
              )
              (case (call .node-for-block block)
                (match? ([] (. tree nodes) (. block loop))
                  (case (call .node-loop-syntax loop)
                    (if (. loop is-subscriber)
                      (+= found (call subscribed-name tree (. loop container)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (return (call (. "\n" join) found))
)

(fn-do _ subscribed-name String
  (param tree AST)
  (param container SyntaxId)
  (match? ([] (. tree nodes) container)
    (case (call .node-identifier row)
      (return (. row name text))
    )
    (case (call .node-get-expression get)
      (match? ([] (. tree nodes) (. get object))
        (case (call .node-identifier row)
          (if (== (. row name text) "this")
            (return (str "this." (. get name text)))
          )
        )
      )
    )
  )
  (return "-")
)

(fn-expr _ plan-size Size
  (param facts Facts)
  ; How many rows the event plans of the classes hold, which typing an edit again in place may not
  ; add to (`Checker.plan-event-handlers`).
  (+ plan-rows (. facts lowered-sections length) (. facts rebinding-sections length))
  (where
    (lazy plan-rows (+ handler-rows (. facts subscribed-sections length)))
    (lazy handler-rows (+ (. facts lowered-handlers length) (. facts lowered-types length)))
  )
)

(fn-do _ blank Bool
  (param line String)
  (for (in char line)
    (if (and (!= char (char " ")) (!= char (char "\t")) (!= char (char "\r")))
      (return false)
    )
  )
  (return true)
)

(fn-do _ decl-shape String
  (param decl Decl)
  (match? decl
    (case (call .decl-function row)
      (return (str "function " (call named (. row name))))
    )
    (case (call .decl-class row)
      (return (str "class " (. row name text)))
    )
    (case (call .decl-property row)
      (return (str "property " (call named (. row name)) " " (. row owner)))
    )
  )
  (return (str (call decl-kind decl)))
)

(fn-expr _ decl-kind U32
  (param decl Decl)
  (match decl
    (case .decl-extension
      1
    )
    (case .decl-converter
      2
    )
    (case .decl-fromverter
      3
    )
    (case .decl-event
      4
    )
    (case .decl-unit
      5
    )
    (case .decl-import
      6
    )
    (case .decl-associated
      7
    )
    (case .decl-case
      8
    )
    (case .decl-using
      9
    )
    (case .decl-rule
      10
    )
    (case .decl-style-domains
      11
    )
    (case .decl-style-rule
      12
    )
    (case .decl-sheet-extension
      13
    )
    (default
      0
    )
  )
)

(fn-expr _ named String
  (param name (? Atom))
  (if-expr name (. name text) "")
)

(type + KeptTyping
  (implements (of Usable Void))
  (prop + modules (? ModuleView))
  (prop + refusal (? String))
  (prop _ slots (list KeptTypingSlot))
  (prop _ uses U64)
  (fn-do + This _
    (param modules (? ModuleView) (= null))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (for (in slot slots)
      (call (. slot release))
    )
    (call (. slots clear))
  )
  (fn-do + typed Session
    (param key String)
    (param next Program)
    (param workers Int)
    (param unreached Bool (= false))
    (+= uses 1)
    (let slot (call slot-for key))
    (= (. slot touched) uses)
    (= refusal (if-expr (not (. slot session)) "first build" (call retype-edit (. slot session) next true)))
    (if (not refusal)
      (call (. (!! (. slot program)) release))
      (= (. slot program) next)
      (call (. slot pin) next modules)
      (return (!! (. slot session)))
    )
    (call (. slot release))
    (= (. slot program) next)
    (let made (call Session next))
    (= (. slot session) made)
    (if unreached
      (+= (. made unreached-modules) (. next entry-module))
    )
    (call type-program made workers)
    (if (call has-errors made)
      (for (in _ (..< 0 (. made instances length)))
        (+= (. made typed-amid-errors) true)
      )
    )
    (call (. made seal))
    (call (. slot pin) next modules)
    (return made)
  )
  (fn-do _ slot-for KeptTypingSlot
    (param key String)
    (for (in slot slots)
      (return-if slot (if (== (. slot key) key)))
    )
    (if (>= (. slots length) kept-typing-slots)
      (let oldest Size 0)
      (for (in index (..< 1 (. slots length)))
        (if (< (. ([] slots index) touched) (. ([] slots oldest) touched))
          (= oldest index)
        )
      )
      (call (. ([] slots oldest) release))
      (call (. slots remove) oldest)
    )
    (let made (call KeptTypingSlot key))
    (+= slots made)
    (return made)
  )
)

(type _ KeptTypingSlot
  (prop + key String)
  (prop + session (? Session))
  (prop + program (? Program))
  (prop + touched U64)
  (prop _ pins (? ModulePins))
  (fn-do + This _
    (param key _)
  )
  (fn-do + pin _
    (param program Program)
    (param modules (? ModuleView))
    (return-if (if (not modules)))
    (let paths (list String))
    (for (in module (. program modules))
      (+= paths (. module path))
    )
    (let fresh (call (. modules pin) paths))
    (call (?. pins release))
    (= pins fresh)
  )
  (fn-do + release _
    (if session
      (call (. session release))
    )
    (= session null)
    (if program
      (call (. program release))
    )
    (= program null)
    (call (?. pins release))
    (= pins null)
  )
)
