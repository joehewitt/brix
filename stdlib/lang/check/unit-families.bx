(import ./types)
(import /lang/ast/ast-nodes)
(import /lang/ast/module)

(prop + number-member TypeId (= (- (. U32 max) 1)))

(type + UnitEdge (is Struct)
  (prop + from TypeId)
  (prop + to TypeId)
  (prop + ratio UnitRatio)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + holds Bool)
)

(type + UnitTerm (is Struct)
  (prop + unit TypeId)
  (prop + power I32)
)

(type + UnitAmount (is Struct)
  (prop + amount F64)
  (prop + terms (list UnitTerm))
  (prop + failed SyntaxId)
  (prop + problem String)
)

(type + DerivedProblem (is U32)
  (variant none (= 0))
  (variant own-family (= 1))
  (variant circular (= 2))
  (variant two-dimensions (= 3))
)

(type + DerivedUnit (is Struct)
  (prop + type TypeId)
  (prop + ratio UnitRatio)
  (prop + terms (list UnitTerm))
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + problem DerivedProblem)
  (prop + absorbed Bool)
)

(type + Dimension (is Struct)
  (prop + known Bool)
  (prop + factor UnitRatio)
  (prop + terms (list UnitTerm))
)

(type + UnitFamilies
  (prop + edges (list UnitEdge))
  (prop + derived (list DerivedUnit))
  (prop _ resolved Size (= 0))
  (prop _ slots (of Map Size U32))
  (prop _ members (list TypeId))
  (prop _ parents (list U32))
  (prop _ ratios (list UnitRatio))
  (fn-do + join Bool
    (param from TypeId)
    (param to TypeId)
    (param ratio UnitRatio)
    (param module ModuleId)
    (param syntax SyntaxId)
    (let left (call slot-of from))
    (let right (call slot-of to))
    (let (tuple left-root left-ratio) (call root-of left))
    (let (tuple right-root right-ratio) (call root-of right))
    (if (== left-root right-root)
      (let holds (call ratios-agree (call ratio-over left-ratio right-ratio) ratio))
      (+= edges (call UnitEdge from to ratio module syntax holds))
      (return holds)
    )
    (= ([] parents left-root) right-root)
    (= ([] ratios left-root) (call ratio-over (call ratio-times ratio right-ratio) left-ratio))
    (call flatten)
    (+= edges (call UnitEdge from to ratio module syntax true))
    (return true)
  )
  (fn-do + ratio-between UnitRatio
    (param from TypeId)
    (param to TypeId)
    (let left ([] slots (as from Size)))
    (let right ([] slots (as to Size)))
    (return-if (call no-ratio) (if (or (== from to) (not left) (not right))))
    (let (tuple left-root left-ratio) (call root-of left))
    (let (tuple right-root right-ratio) (call root-of right))
    (if (!= left-root right-root)
      (return (call no-ratio))
    )
    (return (call ratio-over left-ratio right-ratio))
  )
  (fn-expr + same-family Bool
    (param from TypeId)
    (param to TypeId)
    (not (. (call ratio-between from to) is-none))
  )
  (fn-do + declared-at (? UnitEdge)
    (param module ModuleId)
    (param syntax SyntaxId)
    (for (in edge edges)
      (if (and (== (. edge module) module) (== (. edge syntax) syntax))
        (return edge)
      )
    )
    (return null)
  )
  (fn-do + joins-directly Bool
    (param from TypeId)
    (param to TypeId)
    (for (in edge edges)
      (if (and (. edge holds) (or (and (== (. edge from) from) (== (. edge to) to)) (and (== (. edge from) to) (== (. edge to) from))))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + path-between (list TypeId)
    (param from TypeId)
    (param to TypeId)
    (let reached (call (of Map Size TypeId)))
    (let queue (list TypeId))
    (= ([] reached (as from Size)) from)
    (+= queue from)
    (let next 0)
    (while (and (< next (. queue length)) (not ([] reached (as to Size))))
      (let current ([] queue next))
      (+= next 1)
      (for (in edge edges)
        (if (. edge holds)
          (let neighbor (if-expr (== (. edge from) current) (. edge to) (if-expr (== (. edge to) current) (. edge from) current)))
          (if (and (!= neighbor current) (not ([] reached (as neighbor Size))))
            (= ([] reached (as neighbor Size)) current)
            (+= queue neighbor)
          )
        )
      )
    )
    (let path (list TypeId))
    (if (not ([] reached (as to Size)))
      (return path)
    )
    (let step (?? ([] reached (as to Size)) from))
    (while (!= step from)
      (call (. path insert) step 0)
      (= step (?? ([] reached (as step Size)) from))
    )
    (return path)
  )
  (fn-do + declare-derived _
    (param type TypeId)
    (param ratio UnitRatio)
    (param terms (list UnitTerm))
    (param module ModuleId)
    (param syntax SyntaxId)
    (call slot-of type)
    (+= derived (call DerivedUnit type ratio terms module syntax .none false))
  )
  (fn-do + derived-at (? DerivedUnit)
    (param module ModuleId)
    (param syntax SyntaxId)
    (for (in unit derived)
      (if (and (== (. unit module) module) (== (. unit syntax) syntax))
        (return unit)
      )
    )
    (return null)
  )
  (fn-do + source-of (? DerivedUnit)
    (param type TypeId)
    (let slot ([] slots (as type Size)))
    (if (not slot)
      (return null)
    )
    (let (tuple root _) (call root-of slot))
    (let found (? DerivedUnit) null)
    (for (in unit derived)
      (if (and (== (. unit problem) .none) (not (. unit absorbed)) (== (call root-of-type (. unit type)) root))
        (if (== (. unit type) type)
          (return unit)
        )
        (if (not found)
          (= found unit)
        )
      )
    )
    (return found)
  )
  (fn-do + sources-measuring (list DerivedUnit)
    (param terms (list UnitTerm))
    (let found (list DerivedUnit))
    (for (in unit derived)
      (if (and (== (. unit problem) .none) (not (. unit absorbed)))
        (let measured (call dimension-of (. unit type)))
        (if (and (. measured known) (call same-terms (. measured terms) terms))
          (+= found unit)
        )
      )
    )
    (return found)
  )
  (fn-do + dimension-of Dimension
    (param type TypeId)
    (let visiting (list TypeId))
    (return (call dimension-within type visiting))
  )
  (fn-do _ dimension-within Dimension
    (param type TypeId)
    (param visiting (list TypeId))
    (let one (call UnitRatio 1.0 1.0))
    (let slot ([] slots (as type Size)))
    (if (not slot)
      (let alone (list UnitTerm))
      (+= alone (call UnitTerm type 1))
      (return (call Dimension true one alone))
    )
    (let none (list UnitTerm))
    (if (== type number-member)
      (return (call Dimension true one none))
    )
    (let pure (call ratio-between type number-member))
    (if (not (. pure is-none))
      (return (call Dimension true pure none))
    )
    (let (tuple root to-root) (call root-of slot))
    (for (in unit derived)
      (if (and (== (. unit problem) .none) (not (. unit absorbed)) (== (call root-of-type (. unit type)) root))
        (let source (call expanded unit visiting))
        (if (not (. source known))
          (return source)
        )
        (let toward (if-expr (== type (. unit type)) one (call ratio-between type (. unit type))))
        (return (call Dimension true (call ratio-times toward (. source factor)) (. source terms)))
      )
    )
    (let base (list UnitTerm))
    (+= base (call UnitTerm ([] members root) 1))
    (return (call Dimension true to-root base))
  )
  (fn-do _ expanded Dimension
    (param unit DerivedUnit)
    (param visiting (list TypeId))
    (let none (list UnitTerm))
    (for (in seen visiting)
      (if (== seen (. unit type))
        (return (call Dimension false (call no-ratio) none))
      )
    )
    (let depth (. visiting length))
    (+= visiting (. unit type))
    (let factor (. unit ratio))
    (let terms (list UnitTerm))
    (for (in term (. unit terms))
      (let part (call dimension-within (. term unit) visiting))
      (if (not (. part known))
        (return part)
      )
      (= factor (call ratio-times factor (call ratio-power (. part factor) (. term power))))
      (= terms (call added-terms terms (. part terms) (. term power)))
    )
    (-= ([] visiting (..< depth (. visiting length))))
    (return (call Dimension true factor terms))
  )
  (fn-do + resolve-derived _
    (while (< resolved (. derived length))
      (call resolve-one resolved)
      (+= resolved 1)
    )
  )
  (fn-do + join-alike _
    (for (in index (..< 0 (. derived length)))
      (let unit ([] derived index))
      (if (and (== (. unit problem) .none) (not (. unit absorbed)))
        (let seen (list TypeId))
        (let measured (call expanded unit seen))
        (for (in earlier (..< 0 index))
          (let other ([] derived earlier))
          (if (and (== (. other problem) .none) (not (. other absorbed)) (!= (call root-of-type (. other type)) (call root-of-type (. unit type))))
            (let passed (list TypeId))
            (let theirs (call expanded other passed))
            (if (and (. measured known) (. theirs known) (call same-terms (. theirs terms) (. measured terms)))
              (call join (. unit type) (. other type) (call ratio-over (. measured factor) (. theirs factor)) (. unit module) (. unit syntax))
            )
          )
        )
      )
    )
  )
  (fn-do _ resolve-one _
    (param index Size)
    (let unit ([] derived index))
    (let own (call root-of-type (. unit type)))
    (let named-own false)
    (for (in term (. unit terms))
      (if (or (== (. term unit) (. unit type)) (== (call root-of-type (. term unit)) own))
        (= named-own true)
      )
    )
    (if named-own
      (= (. ([] derived index) problem) .own-family)
      (return)
    )
    (let visiting (list TypeId))
    (let measured (call expanded unit visiting))
    (if (not (. measured known))
      (= (. ([] derived index) problem) .circular)
      (return)
    )
    (if (== (. measured terms length) 0)
      (call join (. unit type) number-member (. measured factor) (. unit module) (. unit syntax))
      (= (. ([] derived index) absorbed) true)
      (return)
    )
    (if (and (== (. measured terms length) 1) (== (. ([] (. measured terms) 0) power) 1))
      (call join (. unit type) (. ([] (. measured terms) 0) unit) (. measured factor) (. unit module) (. unit syntax))
      (= (. ([] derived index) absorbed) true)
      (return)
    )
    (for (in earlier (..< 0 index))
      (let other ([] derived earlier))
      (if (and (== (. other problem) .none) (not (. other absorbed)))
        (let shared (== (call root-of-type (. other type)) (call root-of-type (. unit type))))
        (let seen (list TypeId))
        (let theirs (call expanded other seen))
        (let alike (and (. theirs known) (call same-terms (. theirs terms) (. measured terms))))
        (if (and shared (not alike))
          (= (. ([] derived index) problem) .two-dimensions)
          (break)
        )
        (if alike
          (call join (. unit type) (. other type) (call ratio-over (. measured factor) (. theirs factor)) (. unit module) (. unit syntax))
          (break)
        )
      )
    )
  )
  (fn-do _ root-of-type U32
    (param type TypeId)
    (let slot ([] slots (as type Size)))
    (if (not slot)
      (return (. U32 max))
    )
    (let (tuple root _) (call root-of slot))
    (return root)
  )
  (fn-do _ slot-of U32
    (param type TypeId)
    (let known ([] slots (as type Size)))
    (if known
      (return known)
    )
    (let slot (as (. members length) U32))
    (+= members type)
    (+= parents slot)
    (+= ratios (call UnitRatio 1.0 1.0))
    (= ([] slots (as type Size)) slot)
    (return slot)
  )
  (fn-do _ root-of (tuple U32 UnitRatio)
    (param slot U32)
    (let current slot)
    (let ratio (call UnitRatio 1.0 1.0))
    (while (!= ([] parents current) current)
      (= ratio (call ratio-times ratio ([] ratios current)))
      (= current ([] parents current))
    )
    (return (tuple current ratio))
  )
  (fn-do _ flatten _
    (let roots (list U32))
    (let to-roots (list UnitRatio))
    (for (in slot (..< 0 (. members length)))
      (let (tuple root ratio) (call root-of (as slot U32)))
      (+= roots root)
      (+= to-roots ratio)
    )
    (for (in slot (..< 0 (. members length)))
      (= ([] parents slot) ([] roots slot))
      (= ([] ratios slot) ([] to-roots slot))
    )
  )
)

(fn-do + decimal-ratio UnitRatio
  (param amount F64)
  (let scale 1.0)
  (let limit 1000000000000000.0)
  (while (<= scale limit)
    (let scaled (* amount scale))
    (if (and (call is-exact-whole scaled) (<= (call magnitude scaled) limit) (== (/ scaled scale) amount))
      (return (call reduced-ratio scaled scale))
    )
    (= scale (* scale 10.0))
  )
  (return (call UnitRatio amount 1.0))
)

(fn-expr + ratio-times UnitRatio
  (param left UnitRatio)
  (param right UnitRatio)
  (call reduced-ratio (* (/ (. left multiplier) first) (/ (. right multiplier) second)) (* (/ (. left divisor) second) (/ (. right divisor) first)))
  (where
    (lazy first (call common-divisor (. left multiplier) (. right divisor)))
    (lazy second (call common-divisor (. right multiplier) (. left divisor)))
  )
)

(fn-expr + ratio-over UnitRatio
  (param left UnitRatio)
  (param right UnitRatio)
  (call ratio-times left (call UnitRatio (. right divisor) (. right multiplier)))
)

(fn-expr + ratio-value F64
  (param ratio UnitRatio)
  (/ (. ratio multiplier) (. ratio divisor))
)

(fn-expr + ratio-is-whole Bool
  (param ratio UnitRatio)
  (and (== (. ratio divisor) 1.0) (call is-exact-whole (. ratio multiplier)))
)

(fn-expr + scales-whole Bool
  (param amount F64)
  (param ratio UnitRatio)
  (call is-exact-whole (/ (* amount (. ratio multiplier)) (. ratio divisor)))
)

(fn-expr + ratios-agree Bool
  (param left UnitRatio)
  (param right UnitRatio)
  (and (>= quotient 0.999999999) (<= quotient 1.000000001))
  (where
    (lazy quotient (/ (call ratio-value left) (call ratio-value right)))
  )
)

(fn-expr _ reduced-ratio UnitRatio
  (param multiplier F64)
  (param divisor F64)
  (call UnitRatio (/ (* multiplier sign) common) (/ (* divisor sign) common))
  (where
    (lazy common (call common-divisor multiplier divisor))
    (lazy sign (if-expr (< divisor 0.0) -1.0 1.0))
  )
)

(fn-do _ common-divisor F64
  (param left F64)
  (param right F64)
  (if (or (not (call is-exact-whole left)) (not (call is-exact-whole right)))
    (return 1.0)
  )
  (let larger (as (call magnitude left) U64))
  (let smaller (as (call magnitude right) U64))
  (while (!= smaller 0)
    (let rest (% larger smaller))
    (= larger smaller)
    (= smaller rest)
  )
  (return (if-expr (== larger 0) 1.0 (as larger F64)))
)

(fn-expr _ is-exact-whole Bool
  (param amount F64)
  (and (<= size 9007199254740992.0) (== (as (as size U64) F64) size))
  (where
    (lazy size (call magnitude amount))
  )
)

(fn-expr _ magnitude F64
  (param amount F64)
  (if-expr (< amount 0.0) (- amount) amount)
)

(fn-do + added-terms (list UnitTerm)
  (param base (list UnitTerm))
  (param extra (list UnitTerm))
  (param power I32)
  (let terms (list UnitTerm))
  (for (in term base)
    (+= terms term)
  )
  (for (in term extra)
    (let found false)
    (for (in index (..< 0 (. terms length)))
      (if (== (. ([] terms index) unit) (. term unit))
        (= (. ([] terms index) power) (+ (. ([] terms index) power) (* (. term power) power)))
        (= found true)
      )
    )
    (if (not found)
      (+= terms (call UnitTerm (. term unit) (* (. term power) power)))
    )
  )
  (let kept (list UnitTerm))
  (for (in term terms)
    (if (!= (. term power) 0)
      (+= kept term)
    )
  )
  (return kept)
)

(fn-do + same-terms Bool
  (param left (list UnitTerm))
  (param right (list UnitTerm))
  (if (!= (. left length) (. right length))
    (return false)
  )
  (for (in term left)
    (let matched false)
    (for (in other right)
      (if (and (== (. other unit) (. term unit)) (== (. other power) (. term power)))
        (= matched true)
      )
    )
    (if (not matched)
      (return false)
    )
  )
  (return true)
)

(fn-do + ratio-power UnitRatio
  (param ratio UnitRatio)
  (param power I32)
  (let base (if-expr (< power 0) (call UnitRatio (. ratio divisor) (. ratio multiplier)) ratio))
  (let result (call UnitRatio 1.0 1.0))
  (for (in _ (..< 0 (if-expr (< power 0) (- power) power)))
    (= result (call ratio-times result base))
  )
  (return result)
)

(fn-expr + ratio-root UnitRatio
  (param ratio UnitRatio)
  (call UnitRatio (%% (. ratio multiplier) 0.5) (%% (. ratio divisor) 0.5))
)

(fn-do + raised-terms (list UnitTerm)
  (param terms (list UnitTerm))
  (param power I32)
  (param halves Bool)
  (let raised (list UnitTerm))
  (for (in term terms)
    (let times (* (. term power) power))
    (if (!= times 0)
      (+= raised (call UnitTerm (. term unit) (if-expr halves (/ times 2) times)))
    )
  )
  (return raised)
)

(fn-do + halves-evenly Bool
  (param terms (list UnitTerm))
  (for (in term terms)
    (if (!= (% (. term power) 2) 0)
      (return false)
    )
  )
  (return true)
)

(fn-expr + ratio-is-one Bool
  (param ratio UnitRatio)
  (== (. ratio multiplier) (. ratio divisor))
)
