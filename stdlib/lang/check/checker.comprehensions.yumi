━━━━━━━━━━━━━━━━━━━━
_ Comprehensions is facet of Checker
    sees CallTyping
    sees LiveActions
    sees Loops
    sees MatchArms
    sees Streams

────────────────────
+ do infer-comprehension TypeId
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId
    - next SyntaxId

` A comprehension is a call of its generated closure with the container as the one argument, so
` a range literal is constructed; the closure instance is keyed like a lambda's, at the
` comprehension, and yields the body. One whose header is a grammar reads a container
` the reference finds no iterator for through its stream all the same, and one it makes no
` stream of is its error at the pattern. One on a stream, `<* x on s`, subscribes where it is
` written: see `infer-broadcaster`.
match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if row.is-subscriber && tree.is-grammar(row.pattern)
            report-pattern-on(row.pattern)
            = invalid-type
        if row.is-subscriber && next == 0
            = infer-broadcaster(id, loop, row.container, row.clause, body)
        if row.is-subscriber || next != 0
            decline(id)
            = invalid-type
        . container = loop-container(row.container, false, stated-item(row.pattern))
        if container.type == invalid-type
            = invalid-type
        if tree.is-grammar(row.pattern) && !iterates(container.type) && no-item
            frame.diagnose(row.pattern, .stated, program.store-atom("Can't convert to iterable"))
            = invalid-type
        .. no-item = natural-item(container.type) == no-type
        . mark = facts.diagnostics.length
        . callee = demand-comprehension(id, container.type)
        if callee == no-instance
            decline(id)
            = invalid-type
        = generated-call(id, callee, mark)
decline(id)
= invalid-type

────────────────────
_ do demand-comprehension InstanceId
    - id SyntaxId
    - container TypeId

. decl = nested-decl-of(id)
if decl == 0
    = no-instance
= demand-nested(decl, container)

────────────────────
+ do expect-feeds
    - expr SyntaxId
    - target TypeId

` A feed list written where a list of a known item type is wanted casts each plain feed
` to that type, as the reference does for a typed list call and a list-returning function.
if target == no-type || target == invalid-type
    =
. wanted = types.optional-inner(target)
. feeds = tree.written-feeds(expr)
if feeds == 0
    =
match? types.rows[wanted]
    | .type-class(row)
        . listed = row.module == types.list-decl.module && row.decl == types.list-decl.decl
        if listed && row.args.count != 0
            . item = types.child-type(row.args, 0)
            feed-lists += feeds
            feed-items += item
            feed-builds += nested-decl-of(feeds) != 0 && list-of(item) == wanted

────────────────────
_ do feed-item TypeId
    - feeds SyntaxId

for position in 0 .. < feed-lists.length
    if feed-lists[position] == feeds
        = feed-items[position]
= no-type

────────────────────
_ do builds-feeds Bool
    - feeds SyntaxId

for position in 0 .. < feed-lists.length
    if feed-lists[position] == feeds
        = feed-builds[position]
= false

────────────────────
+ do infer-listed-feeds TypeId
    - id SyntaxId
    - callable SyntaxId
    - feeds SyntaxId

types.clear-fault()
. listed = types.evaluate-type(module, tree, callable, frame.env)
if listed == invalid-type || !same-decl(class-ref(types, listed), types.list-decl)
    decline(id)
    = invalid-type
. open = types.completions[listed].has-variables
. wanted = if open then no-type else first-arg(listed)
if !open && list-of(wanted) != listed
    decline(id)
    = invalid-type
instances.mark-may-panic(instance)
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. sites [SyntaxId]
. valid = true
. feed = feeds
while feed != 0
    . next = 0u32
    match? tree.nodes[feed]
        | .node-feed-expression(row)
            . given = listed-item(feed, row.item, row.is-spread, row.is-optional, wanted)
            valid = valid && given != invalid-type
            scratch.types.push(given)
            scratch.syntax.push(if row.is-spread || row.is-optional then feed else row.item)
            sites += feed
            next = row.next
    feed = next
. item = wanted
. given = types-start
if valid && item == no-type
    . peer = literal-peer(types-start, syntax-start, sites.length)
    given = scratch.types.mark
    for offset in 0 .. < sites.length
        . adapted = conversions.adapted-literal
            - scratch.syntax[syntax-start + offset]
            - scratch.types[types-start + offset]
            - peer
        scratch.types.push(adapted)
    item = relations.join(given)
    if item == invalid-type
        frame.diagnose(id, .stated, program.store-atom("Incompatible types in list"))
        valid = false
if valid
    for offset in 0 .. < sites.length
        . site = sites[offset]
        . written = scratch.syntax[syntax-start + offset]
        . element = scratch.types[given + offset]
        if element != item && written != site && tree.symbol-of(written) != null
            element = infer-with-expected(written, item)
        if element != item
            conversions.convert(site, written, element, item, .reason-element)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
=? invalid-type if !valid
. list = list-of(item)
calls.note-list(id, list)
calls.note-append(id, list, item, .call-list-append)
facts.set-plan(instance, id, .plan-built-feeds)
= list

────────────────────
_ do listed-item TypeId
    - feed SyntaxId
    - item SyntaxId
    - multi Bool
    - optional Bool
    - wanted TypeId

facts.set-feed-site(instance, feed, feed, false)
=? listed-spread(feed, spread-container(item, wanted)) if multi && !optional
. plain = !multi && !optional
. value = if plain && wanted != no-type then infer-with-expected(item, wanted) else infer(item)
=? invalid-type if value == invalid-type
if plain
    =? conversions.convert(feed, item, value, wanted, .reason-explicit) if wanted != no-type
    = value
. inner = types.optional-inner(value)
=? inner if !multi
= listed-spread(feed, LoopContainer(inner, no-type))

────────────────────
_ do listed-spread TypeId
    - feed SyntaxId
    - container LoopContainer

=? invalid-type if container.type == invalid-type
if container.item != no-type
    plan-range-at(feed, container.item)
    = container.item
. mark = facts.calls.length
. iterated = iteration-container(container.type, feed)
. yielded = loop-item-type(iterated, feed)
=? invalid-type if yielded == invalid-type
plan-iteration-at(feed, feed, iterated, yielded, true)
facts.set-protocol-start(instance, feed, feed, mark)
= yielded

────────────────────
+ do infer-feeds TypeId
    - id SyntaxId
    - consumer SyntaxId

` A feed list is a call of its generated closure, whose type the reference records at the
` first feed, yielding every item. The reference shifts the first feed's location one line
` when it declares the closure, so the facts of that feed's own yield land on the next feed
` or on the pipeline consuming the list; `feed-site` places them the same way.
. decl = nested-decl-of(id)
if decl == 0
    decline(id)
    = invalid-type
facts.set-node-type(instance, id, intern-nested(decl))
. callee = demand-nested(decl, no-type)
. produced = calls.generator-call(id, callee)
. site = tree.feed-site(id, consumer)
if site != id
    facts.set-node-type(instance, site, produced)
= produced

────────────────────
+ do check-feeds
    - id SyntaxId

` The closure's body: a feed yields its item, an optional feed only a present item, and a
` spread every item of its iterable, as the reference's generated yields do. The first
` feed's own facts sit where the reference shifts them, the consumer being the closure's
` enclosing frame's pipeline when the list feeds one.
. feed = id
. site = tree.feed-site(id, tree.consumer-of(id))
. wanted = if outer then outer.feed-item(id) else no-type
building-list = outer && outer.builds-feeds(id)
built-item = wanted
. plain [Bool]
orders-yields = true
while feed != 0
    . next = 0u32
    match? tree.nodes[feed]
        | .node-feed-expression(row)
            facts.set-feed-site(instance, feed, site, false)
            . noted = ordered-yields.length
            check-feed
                - feed
                - site
                - row.item
                - row.is-spread
                - row.is-optional
                - wanted
                - feed == id
            if ordered-yields.length != noted
                plain += !row.is-spread && !row.is-optional
            next = row.next
    feed = next
    site = feed
orders-yields = false
fold-feed-yields(plain)

────────────────────
_ do fold-feed-yields
    - plain [Bool]

for position in 0 .. < plain.length
    if plain[position]
        fold-yield
            - ordered-yields[position]
            - ordered-sites[position]
            - true
            - ordered-literals[position]
for offset in 0 .. < plain.length
    . position = plain.length - 1 - offset
    if !plain[position]
        fold-yield
            - ordered-yields[position]
            - ordered-sites[position]
            - true
            - ordered-literals[position]
ordered-yields.clear()
ordered-sites.clear()
ordered-literals.clear()

────────────────────
+ do feeds-consumer SyntaxId

` The pipeline that consumes the feed list this body is, where its first feed's facts sit,
` or nothing for any other body.
if !outer
    = 0
match? tree.nodes[frame.declaration.syntax]
    | .node-feed-expression
        = tree.consumer-of(frame.declaration.syntax)
= 0

────────────────────
_ do check-feed
    - feed SyntaxId
    - site SyntaxId
    - item SyntaxId
    - is-spread Bool
    - is-optional Bool
    - wanted TypeId
    - is-first Bool

` What a feed yields is kept with where the reference places its yield, to be converted
` to the type of the list's items once that is known. A range of integers written with no
` suffix that a spread yields is of the type of the items wanted.
if is-spread && !is-optional
    check-spread
        - feed
        - site
        - spread-container(item, wanted)
        - is-first
        - written-literal(item)
    =
. value = infer(item)
if value == invalid-type
    note-yield(value)
    =
if wanted != no-type && !is-spread && !is-optional
    value = conversions.convert(item, item, value, wanted, .reason-explicit)
if is-optional && types.is-optional(value)
    value = types.optional-inner(value)
if !is-spread
    note-yield(value, site, false, if is-optional then 0 else written-literal(item))
    =
check-spread(feed, site, LoopContainer(value, no-type), is-first)

────────────────────
_ do spread-container LoopContainer
    - item SyntaxId
    - wanted TypeId

match? tree.nodes[item]
    | .node-list-syntax
        if wanted != no-type
            . listed = infer(item)
            if listed == invalid-type
                = LoopContainer(invalid-type, no-type)
            . mark = scratch.types.mark
            scratch.types.push(wanted)
            . target = types.class-named-with-args(module, types.list-atom!, mark)
            = LoopContainer(conversions.convert(item, item, listed, target, .reason-explicit), no-type)
= loop-container(item, true, wanted)

────────────────────
_ do check-spread
    - feed SyntaxId
    - site SyntaxId
    - container LoopContainer
    - is-first Bool
    - literal SyntaxId = 0

` A spread yields every item of its iterable through the loop the reference lowers it
` to, an integer range literal counting without a range, any other container through its
` iteration protocol with the yielded item converted to the generator's optional. The loop
` is planned at the feed, which has the slots of a loop, and polls; the calls of a
` container's protocol stay where the reference keeps them, and the loop of the first feed
` of a list is located on the line under it, where the reference shifts that feed.
if container.type == invalid-type
    note-yield(invalid-type)
    =
if container.item != no-type
    note-yield(container.item, site, true, literal)
    plan-range-at(feed, container.item)
    =
. mark = facts.calls.length
. iterated = iteration-container(container.type, site)
. yielded = loop-item-type(iterated, site)
note-yield(yielded, site, true)
if yielded == invalid-type
    =
plan-iteration-at(feed, site, iterated, yielded, true)
facts.set-feed-site(instance, feed, site, is-first)
facts.set-protocol-start(instance, feed, site, mark)
. wrapped = types.optional-of(yielded)
if wrapped != yielded
    conversions.convert(site, 0, yielded, wrapped, .reason-join)

────────────────────
+ do infer-pipeline TypeId
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - right SyntaxId

` A pipeline passes its left value on: a forward pipe as the last argument of the call on the
` right, and a map or filter to the stream function of that name with the right operand's
` closure over `each`, as the reference lowers them. One written as a statement that no
` statement before it joins has no shape: the reference fails without saying where.
if left == 0
    decline(id)
    = invalid-type
if op == .pipe-write-each-op
    = infer-write-each(id, left, right)
if op == .grammar-pipe-op
    = infer-pattern-pipe(id, left, right)
. listing = tree.listed-feeds(id)
=? infer-listed-feeds(id, right, listing) if listing != 0
. source = infer-pipeline-source(left, id)
if source == invalid-type
    = invalid-type
. site = tree.source-site(left, id)
. with-atom = program.store-atom("with")
match op
    |= .pipe-forward-op
        . result = infer-pipe-forward(id, source, site, right)
        if site == id
            facts.set-answer-type(instance, id, result)
        = result
    |= .map-op
        = infer-pipeline-closure(id, source, site, program.store-atom("map"), with-atom, false)
    |= .filter-op
        . where-atom = program.store-atom("where")
        = infer-pipeline-closure(id, source, site, program.store-atom("filter"), where-atom, false)
    |= .map-filter-op
        . map-filter-atom = program.store-atom("map-filter")
        = infer-pipeline-closure(id, source, site, map-filter-atom, with-atom, true)
    |= .pipe-repeat-op
        = infer-pipeline-closure(id, source, site, program.store-atom("tap"), with-atom, false)
    |= .pipe-closure-op
        . decl = nested-decl-of(id)
        if decl == 0
            decline(id)
            = invalid-type
        = calls.generator-call(id, demand-nested(decl, source))
    |= .pipe-write-all-op
        . sink = infer(right)
        if sink == invalid-type
            = invalid-type
        calls.operator-call(id, sink, program.store-atom("<-write"), left, source)
        if site == id
            facts.set-answer-type(instance, id, sink)
        = sink
    ??
        decline(id)
        = invalid-type

────────────────────
_ do infer-pattern-pipe TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` A stream piped through a pattern, `s ~> p`, as the reference lowers it: a call of the
` generator closure generated for it, given the left value, which yields what each match of
` the pattern gives. The value is given as `pipe-source` casts it, and a feed the pipe reads
` alone is given nothing: the closure evaluates what it writes. A pattern that may match
` without reading, where the reference knows what it reads first, is an error: the pipe would
` never end, and so is a value the reference makes no stream of, which the closure loops over
` through its stream, iterable or not. A cast value the reference describes has no shape here: it names the closure for
` the cast, not for what it casts. Nor has any other list of feeds, whose yields the
` reference types again for the item it prefers.
. piped = tree.piped-feed(id)
if piped == 0 && tree.nodes[left] is .node-feed-expression
    decline(id)
    = invalid-type
. source = if piped == 0 then infer(left) else no-type
if source == invalid-type
    = invalid-type
. pattern = right
match? tree.nodes[right]
    | .node-stream-match(row)
        pattern = row.pattern
if first-set(pattern) == 3 || tree.never-reads(pattern)
    frame.diagnose(right, .stated, program.store-atom("Grammar pipeline must consume input"))
    = invalid-type
. decl = nested-decl-of(id)
if decl == 0
    decline(id)
    = invalid-type
. mark = facts.diagnostics.length
if piped != 0
    = generated-call(id, demand-nested(decl, no-type), mark)
. given = pipe-source(left, source, pattern)
if given == invalid-type || (given != source && description-of(tree, left) != "node")
    decline(id)
    = invalid-type
if !iterates(given) && natural-item(given) == no-type
    frame.diagnose(right, .stated, program.store-atom("Can't convert to iterable"))
    = invalid-type
= generated-call(id, demand-nested(decl, given), mark)

────────────────────
_ do generated-call TypeId
    - id SyntaxId
    - callee InstanceId
    - mark Size

` The call of the generator closure generated for a comprehension or a pipe, which gives the
` generator. None where the closure, or anything typed for it since `mark`, was refused or
` reported: what it yields is not known, and the value has no shape.
if facts.declined-since(0, callee) || facts.diagnostics.length != mark
    = invalid-type
= calls.generator-call(id, callee)

────────────────────
_ do pipe-source TypeId
    - site SyntaxId
    - source TypeId
    - pattern SyntaxId

` The value the reference gives the closure of a stream piped through a pattern, for each
` item the pattern prefers in turn: the value as it is where the stream it is read through
` reads that item, else the value cast to what `source-for-item` finds for it. The value as
` it is where it is cast for none.
. preferred [TypeId]
if !preferred-items(pattern, preferred)
    = invalid-type
. natural = natural-item(source)
for item in preferred
    if natural == item
        = source
    . target = source-for-item(source, item)
    if target != no-type
        if target != source && conversions.convert(site, site, source, target, .reason-argument) == invalid-type
            = invalid-type
        = target
= source

────────────────────
_ do piped-source TypeId
    - feed SyntaxId
    - pattern SyntaxId

` What a feed that a stream piped through a pattern reads alone writes, evaluated in the
` closure and cast as the reference casts it, for each item the pattern prefers in turn: to
` what `source-for-item` finds for that item. One cast for none has no shape here: the
` reference generates the feed's own closure. The reference finds the cast of a `use` for
` the type of what it uses, so one whose `begin-using` gives another type has none either.
. item SyntaxId = 0
match? tree.nodes[feed]
    | .node-feed-expression(row)
        item = row.item
. value = infer(item)
if value == invalid-type
    = invalid-type
match? tree.nodes[item]
    | .node-use-expression(row)
        if tree.optional-chain-expr(row.expr) != 0 || facts.node-type(instance, row.expr) != value
            decline(feed)
            = invalid-type
. preferred [TypeId]
if !preferred-items(pattern, preferred)
    decline(feed)
    = invalid-type
for preference in preferred
    . target = source-for-item(value, preference)
    if target != no-type
        if target != value && conversions.convert(item, item, value, target, .reason-argument) == invalid-type
            = invalid-type
        = target
decline(feed)
= invalid-type

────────────────────
_ do preferred-items Bool
    - pattern SyntaxId
    - preferred [TypeId]

` The items the reference prefers a stream piped through a pattern to read, in order: where
` the pattern, under the captures, transforms, panics, repeats and lookaheads around it, calls
` a rule plainly, the one item every rule of that name the module reaches declares, where they
` agree; else characters and then bytes. A call of a local rule, of a pattern a name holds or
` given types has no shape here.
. node = pattern
. peeling = true
while peeling
    peeling = false
    match? tree.nodes[node]
        | .node-stream-capture(row)
            node = row.pattern
            peeling = true
        | .node-stream-panic(row)
            node = row.pattern
            peeling = true
        | .node-stream-transform(row)
            if row.pattern != 0
                node = row.pattern
                peeling = true
        | .node-stream-unary(row)
            node = row.operand
            peeling = true
        | .node-stream-length(row)
            node = row.operand
            peeling = true
. declared = no-type
match? tree.nodes[node]
    | .node-stream-call(row)
        if rule-of(node) != 0 || holds-value(node) || row.params.count != 0
            = false
        . agreed = true
        for candidate in program.lookup(module, row.name)
            . item = rule-item(candidate.module, candidate.decl)
            if item != no-type
                agreed = agreed && (declared == no-type || declared == item)
                declared = item
        if !agreed
            declared = no-type
if declared != no-type
    preferred += declared
else
    preferred += types.type-row(.char)
    preferred += types.type-row(.uint8)
= true

────────────────────
_ do rule-item TypeId
    - module ModuleId
    - decl DeclId

` The item a rule a module declares is over, where it states one that holds no type parameter.
` None for any other declaration.
if rule-match(program, module, decl) == 0
    = no-type
. owner = program.modules[module]
match? owner.decls[decl]
    | .decl-function(fn)
        match? owner.tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                . item = types.evaluate-type(module, owner.tree, syntax.pattern, types.env-frame())
                if item != invalid-type && !types.completions[item].has-variables
                    = item
= no-type

────────────────────
_ do source-for-item TypeId
    - source TypeId
    - item TypeId

` What the reference casts a value piped through a pattern to, to read items of a type: the
` value's own type where it is a generator of them, else the first of an `Iterable`, an
` `Indexable` and a `Stream` of them it converts to. None where it converts to none.
if same-decl(class-ref(types, source), types.generator-decl) && first-arg(source) == item
    = source
for decl in [types.iterable-decl, types.indexable-decl, types.stream-decl]
    . target = class-over(decl, item)
    if relation-legal(conversions.compare-held(source, target))
        = target
= no-type

────────────────────
+ do check-pattern-pipe
    - id SyntaxId
    - right SyntaxId

` The body of the generator closure a stream piped through a pattern compiles as, as the reference
` makes it: the value it is given is read through the stream a match would read it through, made
` once, and on each pass the pattern matches from where the last left the stream, as a rule's arms
` match, without reading the rest. Each pass first releases the input the stream has delivered,
` then asks the stream whether it has more, and takes its position, which holds no input, before
` the match and after it, to panic where a match read nothing. Each value a match gives is yielded;
` the closure ends where the stream has no more, or the pattern fails. A stream made of a value
` that is none is the closure's own, and is released whole; one given as a stream is the caller's,
` and keeps what the caller's marks hold. A feed the pipe reads alone is evaluated here, as
` `piped-source` casts it. A helper the pipe is given with `with` is evaluated once, after the
` stream is made, and every match runs under it, as a match given one does. One that marks the
` records a pipe matches is asked to begin each record where the stream has more, before the
` stream's position is taken, through the property it delegates that to where it does. A pattern
` whose value is optional is an error.
. pattern = right
. helper SyntaxId = 0
match? tree.nodes[right]
    | .node-stream-match(row)
        pattern = row.pattern
        helper = row.helper
. piped = tree.piped-feed(id)
. container = if piped != 0 then piped-source(piped, pattern) else first-argument
    .. first-argument = instances.argument-type(instance, 0)
if container == invalid-type
    =
note-poll()
. buffer = stream-view
. read = record-stream-protocol(right, container)
. made = stream-view.type
. saved-helper = helping
helping = helping.helper = null
helping = helping.site = 0
helping = helping.rolls = false
helping = helping.explicit = false
helping = helping.body = if helper != 0 then right else 0
. helped = helper == 0 || type-helper(helper)
. helper-type = if helper != 0 && helped then facts.node-type(instance, helper) else no-type
. typed = if read && helped then type-stream-arms(pattern, true) else invalid-type
if typed != invalid-type && helping.rolls && helping.helper!.rollback == no-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom
            - "Pattern @rollback helper must implement PatternRollback with a concrete Mark type"
    typed = invalid-type
helping = saved-helper
stream-view = buffer
if !helped
    =
if !read
    decline(id)
    =
if typed == invalid-type
    =
if types.is-optional(typed)
    frame.diagnose(right, .stated, program.store-atom(optional-match-text("pipeline")))
    =
. release = if supported(container, types.token-stream-decl) == no-type then "pattern-release" else "pattern-release-unmarked"
calls.protocol-call(made, program.store-atom(release), id)
if calls.protocol-getter(made, program.store-atom("has-more"), id) != types.bool-type
    decline(id)
    =
. mark = calls.protocol-call(made, program.store-atom("pattern-position"), id).answer
if mark == invalid-type || field-of(mark, 1) != types.index-type
    decline(id)
    =
if helper-type != no-type && pattern-helper(types, helper-type).boundary != no-type
    . receiver = capability-receiver(helper-type, pattern-helper(types, helper-type).boundary)
    . places [U32]
    if receiver == no-type || (receiver != helper-type && !calls.ranking.delegate-path(helper-type, receiver, places))
        decline(id)
        =
    . recording = calls.protocol-call(receiver, program.store-atom("begin-pattern-record"), id)
    if recording.fact == no-fact
        decline(id)
        =
    if places.length != 0
        facts.calls[recording.fact].through = facts.keep-steps
            - places
            - calls.step-getters(places)
keep-loop(id, container, made, helper-type)
note-yield(typed)

────────────────────
_ do infer-write-each TypeId
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` A pipe that writes each item of what it reads to what is on the right, as the reference
` lowers it: what is on the right first, then a loop over the left value, planned at the
` pipe with the calls of its protocol, each turn of which gives the item to the function the
` right's type declares for a write, recorded at the pipe after them. The pipe gives what it
` wrote to.
. sink = infer(right)
. container = loop-container(left)
if sink == invalid-type || container.type == invalid-type
    = invalid-type
. item = container.item
if item != no-type
    plan-range-at(id, item)
else
    . iterated = iteration-container(container.type, left)
    item = loop-item-type(iterated, id)
    if item == invalid-type
        = invalid-type
    plan-iteration-at(id, id, iterated, item, false)
calls.operator-call(id, sink, program.store-atom("<-write"), left, item)
= sink

────────────────────
_ do infer-pipeline-source TypeId
    - left SyntaxId
    - id SyntaxId

match? tree.nodes[left]
    | .node-feed-expression
        = infer-feeds(left, id)
= infer(left)

────────────────────
_ do infer-pipe-forward TypeId
    - id SyntaxId
    - source TypeId
    - site SyntaxId
    - right SyntaxId

` A forward pipe: the call on the right given its own arguments and then, unnamed, the left value,
` produced at `site`, as the reference's `compilePipe` passes it.
. params-start = scratch.types.mark
. param-count = 0
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
. callable = right
. object = CalledObject()
match? tree.nodes[right]
    | .node-call-expression(call)
        callable = call.callable
        for param in tree.children[call.params]
            scratch.types.push(types.evaluate-type(module, tree, param, frame.env))
            param-count += 1
        object = type-called-object(callable, call.args.count + 1)
        for arg in tree.children[call.args]
            match tree.nodes[arg]
                | .node-argument(argument)
                    scratch.types.push
                        - infer-argument(argument.expr, tree.argument-symbol(argument.expr))
                    scratch.call-arguments.push
                        - argument-shape(argument.name, argument.is-optional, argument.expr)
                    scratch.syntax.push(arg)
                ??
                    scratch.types.push(infer-argument(arg, tree.argument-symbol(arg)))
                    scratch.call-arguments.push(argument-shape(null, false, arg))
                    scratch.syntax.push(arg)
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(source)
scratch.syntax.push(site)
. params = scratch.types.span(params-start, param-count)
. arguments = arguments-since(shapes-start, types-start, syntax-start, params, false, if site == id then id else 0)
called-object = object
. result = infer-callable(id, callable, arguments).type
called-object = CalledObject()
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do infer-pipeline-closure TypeId
    - id SyntaxId
    - source TypeId
    - site SyntaxId
    - name Atom
    - argument-name Atom
    - explicit Bool

` A map, filter, map-filter or tap pipeline: the stream function `name` given the left value and,
` as `argument-name`, the right operand's closure over `each`, as the reference lowers it. Where
` `explicit` asks, the call names its types, the item and what the closure's optional holds;
` where the closure answers no optional, the call infers them, as the reference's
` `inferMapFilterClosureParamTypes` leaves them. A map-filter whose closure gives a value that
` is never null drops nothing, and is an error that asks for a map.
. item = pipeline-item-type(source)
. decl = nested-decl-of(id)
if item == invalid-type || decl == 0
    decline(id)
    = invalid-type
. callee = demand-nested(decl, item)
. closure = intern-nested(decl)
. params-start = scratch.types.mark
. param-count = 0
. returned = if explicit then instances.signatures[callee].returns else no-type
if explicit && returned == no-type
    decline(id)
    = invalid-type
if explicit && returned != invalid-type && returned != types.void-type && !types.is-optional(returned)
    . shown = type-short-name(types, returned)
    . message = "The body of this \"?*>\" gives $shown, which is never null, so it drops no item; write \"*>\""
    frame.diagnose(id, .stated, program.store-atom(message))
    = invalid-type
if explicit && types.is-optional(returned)
    scratch.types.push(item)
    scratch.types.push(types.optional-inner(returned))
    param-count = 2
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(source)
scratch.syntax.push(site)
scratch.call-arguments.push(CallArgument(argument-name, false, false, false, false, null))
scratch.types.push(closure)
scratch.syntax.push(id)
. params = scratch.types.span(params-start, param-count)
. arguments = arguments-since(shapes-start, types-start, syntax-start, params, false, if site == id then id else 0)
. result = calls.function-call(id, name, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(params-start)
scratch.call-arguments.rewind(shapes-start)
= result

────────────────────
_ do pipeline-item-type TypeId
    - source TypeId

` The item a pipeline body receives: a generator's, else the stream, iterable, or indexable
` item of the left value, in the reference's order.
if source == invalid-type || source == no-type
    = invalid-type
types.complete(source)
if same-decl(class-ref(types, source), types.generator-decl)
    . item = first-arg(source)
    = if item != no-type then item else invalid-type
. streamed = iterable-item(source, types.stream-decl)
if streamed == no-type
    streamed = iterable-item(source, types.iterable-decl)
if streamed == no-type
    streamed = iterable-item(source, types.indexable-decl)
= if streamed != no-type then streamed else invalid-type

────────────────────
_ do infer-broadcaster TypeId
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId
    - clause SyntaxId
    - body SyntaxId

` A comprehension on a stream, as the reference compiles it: the
` container is made a `Broadcastable` as a loop on a stream's is, an event of an object as
` the endpoint a value of its `Broadcastable` takes, and the
` comprehension's subscriber, a closure of the item and the stream, writes what its body gives
` to an `AsyncChannel` of the body's type, which is the comprehension's value. The subscriber
` is typed where it is made a `Subscriber`, before the channel, whose type its body decides; the
` channel is then made and kept in the local the subscriber captures, and the subscriber given
` to the broadcaster's `subscribe`, all recorded at the comprehension, or owned by the object
` as a loop's is, or subscribed as `subscribe-whenever` says where it has a `whenever` clause.
` A body that gives nothing is not supported: the reference fails inside the channel it makes.
. decl = nested-decl-of(id)
. channel-slot = bindings.resolution-of(frame.binding, id)
if decl == 0 || channel-slot.kind != .resolve-slot
    decline(id)
    = invalid-type
. stream = subscribed-stream(id, loop, container, clause, false, Want().adding(.want-adapt))
if stream == no-type
    = invalid-type
. item = first-arg(stream)
. subscriber = types.well-known-type-of("core/stream", "Subscriber", item)
if item == no-type || subscriber == invalid-type
    decline(id)
    = invalid-type
. closure = intern-nested(decl)
if conversions.convert(id, id, closure, subscriber, .reason-argument) == invalid-type
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(item)
scratch.types.push(stream)
. callee = demand-lambda(closure, scratch.types.since(mark))
scratch.types.rewind(mark)
. written = if callee != no-instance then facts.node-type(callee, body) else no-type
if written == no-type || written == invalid-type || written == types.void-type
    decline(id)
    = invalid-type
. channel = types.well-known-type-of("core/channel", "AsyncChannel", written)
. made = if channeled then calls.demand-constructor(channel, scratch.types.mark) else no-instance
    .. channeled = channel != invalid-type
if made == no-instance
    decline(id)
    = invalid-type
do facts.record-call(instance, id, made, .call-constructor, scratch.no-fills, false)
frame.assign(channel-slot.slot, channel)
if whenever-of(loop) != 0
    subscribe-whenever(id, whenever-of(loop), stream, item, subscriber)
else if is-owner()
    own-subscription(id, stream, item, subscriber)
else if calls.protocol-call(stream, program.store-atom("subscribe"), id, subscriber, true).answer == invalid-type
    decline(id)
    = invalid-type
= channel

────────────────────
+ do check-broadcast
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` The subscriber of a comprehension on a stream: its header takes the item it is given, its
` clauses are tested in the order written, and what its body gives is written to the channel the
` comprehension made, by `note-broadcast`. A `while` or an `until` unsubscribes it from the
` stream it is given, as a loop on a stream's does. Its own closure type is recorded at the
` comprehension, for the value it unsubscribes.
. item = instances.argument-type(instance, 0)
. stream = instances.argument-type(instance, 1)
facts.set-node-type(instance, loop, stream)
facts.set-node-type(instance, id, closure-of-self())
check-loop(loop, LoopContainer(stream, item), body, true)
match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if tree.ends-subscription(row.clause)
            demand-unsubscribe(loop)

────────────────────
+ do note-broadcast
    - body SyntaxId
    - written TypeId

` What the body of a comprehension on a stream gives, written to the comprehension's channel,
` an `AsyncChannel` of the body's type, by its `<-`, recorded at the comprehension; its errors
` leave the subscriber.
if written == invalid-type || written == no-type
    =
. channel = types.well-known-type-of("core/channel", "AsyncChannel", written)
if channel == invalid-type
    decline(body)
    =
. op = Operator.write-op
do calls.operator-call(frame.declaration.syntax, channel, program.store-atom("$op"), body, written)

────────────────────
+ do check-comprehension
    - loop SyntaxId
    - body SyntaxId

` The closure's body: the loop over its container argument, recorded at the header where the
` reference reads the passed container, yielding the body. The loop polls on each pass, as
` the `for` block the reference lowers it to does.
. container = instances.argument-type(instance, 0)
facts.set-node-type(instance, loop, container)
note-poll()
check-loop(loop, LoopContainer(container, no-type), body, true, false, true)

────────────────────
+ do follow-pipeline
    - pipeline SyntaxId
    - read SyntaxId
    - name Atom

. node = pipeline
. handed = no-instance
. shown = name.text
while true
    . given = given-index(node)
    if given == null && handed == no-instance
        unfollowed(read, name)
        =
    if given == null
        . message = "\"#$shown\" is read for each item of a pipeline that \"${callee-text(handed)}\" hands back without working it through, and nothing works through what it hands back as the value is made; give that to a function that works it through, as count does, or write \"$shown\" to read it plainly"
        frame.diagnose(read, .stated, program.store-atom(message))
        =
    . use = callee-use(given-callees[given], given-positions[given])
    if use == .generator-consumed
        facts.note-pulled(instance, given-calls[given])
        =
    if use == .generator-kept
        . message = "\"#$shown\" is read for each item of a pipeline that \"${callee-text(given-callees[given])}\" keeps rather than working through as it is called, so the read would not be followed; give the pipeline to a function that works it through, as count does, or write \"$shown\" to read it plainly"
        frame.diagnose(read, .stated, program.store-atom(message))
        =
    handed = given-callees[given]
    node = given-calls[given]

────────────────────
_ callee-text String
    - callee InstanceId

match program.modules[row.module].decls[row.decl]
    | .decl-function(function)
        function.name?.text ?? "the function"
    ??
        "the function"

.. row = instances.rows[callee]
