(import ./binding)
(import /core/parsing)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(fn-expr + slot-kind-text String
  (param kind SlotKind)
  (match kind
    (case= .slot-argument
      "argument"
    )
    (case= .slot-local
      "local"
    )
    (case= .slot-lazy
      "lazy"
    )
    (case= .slot-pattern
      "pattern"
    )
    (case= .slot-loop-item
      "loop-item"
    )
    (case= .slot-this
      "this"
    )
    (case= .slot-it
      "it"
    )
    (case= .slot-each
      "each"
    )
    (case= .slot-super
      "super"
    )
    (case= .slot-held
      "held"
    )
    (case= .slot-loop-state
      "loop-state"
    )
    (case= .slot-location
      "location"
    )
    (default
      "closure-env"
    )
  )
)

(fn-expr + resolution-kind-text String
  (param kind ResolutionKind)
  (match kind
    (case= .resolve-slot
      "slot"
    )
    (case= .resolve-member
      "member"
    )
    (case= .resolve-global
      "global"
    )
    (case= .resolve-function
      "function"
    )
    (case= .resolve-type
      "type"
    )
    (case= .resolve-unresolved
      "unresolved"
    )
    (default
      "none"
    )
  )
)

(fn-expr + diagnostic-kind-text String
  (param kind DiagnosticKind)
  (match kind
    (case= .name-not-found
      "name-not-found"
    )
    (case= .already-defined
      "already-defined"
    )
    (case= .required-self
      "required-self"
    )
    (case= .variable-not-declared
      "variable-not-declared"
    )
    (case= .stream-not-found
      "stream-not-found"
    )
    (case= .lazy-defined
      "lazy-defined"
    )
    (case= .stated
      "stated"
    )
    (case= .redeclared
      "redeclared"
    )
    (default
      "context-not-found"
    )
  )
)

(fn-expr + slot-oracle-text String
  (param bindings Bindings)
  (param tree AST)
  (param slot SlotId)
  ; Whether a local is a constant or a variable depends on which lowering the types select, for
  ; loop items in particular, so the oracle compares the declaring slot and only the lazy, this,
  ; and super storage classes.
  (str "slot:" storage " " position)
  (where
    (lazy row ([] (. bindings slots) slot))
    (lazy storage
      (match (. row kind)
        (case= .slot-this
          "this"
        )
        (case= .slot-super
          "super"
        )
        (case= .slot-lazy
          (if-expr (!= (. row property) 0) "local" "lazy")
        )
        (default
          "local"
        )
      )
    )
    (lazy implicit (or (== (. row syntax) 0) (call is-implicit-name (. row name))))
    (lazy grouped (and (== (. row kind) .slot-lazy) (!= (. row group) 0)))
    (lazy declared (if-expr grouped (call group-pattern tree (. row group)) (. row syntax)))
    (lazy declaring (if-expr (!= (. row property) 0) (. row property) declared))
    (lazy position (if-expr implicit "-" (call location-text tree declaring)))
  )
)

(fn-expr + group-pattern SyntaxId
  (param tree AST)
  (param group SyntaxId)
  ; The TypeScript compiler declares every name of a lazy group at the group pattern's position.
  (match ([] (. tree nodes) group)
    (case (call .node-declare row)
      (. row left)
    )
    (default
      group
    )
  )
)

(fn-expr + is-implicit-name Bool
  (param name Atom)
  ; The TypeScript compiler prints no position for these names whether the source declares them
  ; or a construct binds them.
  (or (== text "this") (== text "super") (== text "it") (== text "each"))
  (where
    (lazy text (. name text))
  )
)

(fn-expr + location-text String
  (param tree AST)
  (param id SyntaxId)
  (str (. loc begin line) ":" (. loc begin column))
  (where
    (lazy loc (call syntax-location tree id))
  )
)

(fn-expr + syntax-location MatchLocation
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (. row loc)
    )
    (case (call .node-ref-identifier row)
      (. row loc)
    )
    (case (call .node-type-capture row)
      (. row loc)
    )
    (case (call .node-loop-syntax row)
      (. row loc)
    )
    (case (call .node-type-transform row)
      (. row loc)
    )
    (case (call .node-declare row)
      (. row loc)
    )
    (case (call .node-assign row)
      (. row loc)
    )
    (case (call .node-type-tuple row)
      (. row loc)
    )
    (case (call .node-function-syntax row)
      (. row loc)
    )
    (case (call .node-getter-syntax row)
      (. row loc)
    )
    (case (call .node-setter-syntax row)
      (. row loc)
    )
    (case (call .node-converter-syntax row)
      (. row loc)
    )
    (case (call .node-fromverter-syntax row)
      (. row loc)
    )
    (case (call .node-do-task-block row)
      (. row loc)
    )
    (case (call .node-property-syntax row)
      (. row loc)
    )
    (default
      (call MatchLocation)
    )
  )
)

(fn-expr + resolution-oracle-text String
  (param bindings Bindings)
  (param tree AST)
  (param resolution Resolution)
  (match (. resolution kind)
    (case= .resolve-slot
      (call slot-oracle-text bindings tree (. resolution slot))
    )
    (default
      (call resolution-kind-text (. resolution kind))
    )
  )
)

(fn-do + binding-use-lines _
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  (param label String)
  (param lines (list String))
  ; One line per identifier use site in syntax order. Declaration sites are skipped because the
  ; TypeScript compiler never resolves them as reads.
  (let tree (. ([] (. program modules) module) tree))
  (let row ([] (. bindings bindings) binding))
  (for (in offset (..< 0 (. row subtree count)))
    (let id (+ (. row subtree start) offset))
    (let resolution ([] (. bindings resolutions) (+ (. row resolution-base) offset)))
    (if (== (. resolution kind) .resolve-none)
      (continue)
    )
    (if (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-declares)) 0)
      (if (not (call declares-lazy bindings resolution))
        (continue)
      )
    )
    (let name (call (. tree identifier-name) id))
    (if (not name)
      (continue)
    )
    (let shown name)
    (let resolved (call resolution-oracle-text bindings tree resolution))
    (+= lines (str "id " label " " (call location-text tree id) " " (. shown text) " " resolved))
  )
)

(fn-expr + declares-lazy Bool
  (param bindings Bindings)
  (param resolution Resolution)
  ; The TypeScript compiler evaluates a lazy's declaring identifier when it plans the lazy, so
  ; the oracle lists lazy declaration sites as reads.
  (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy))
)

(fn-expr + binding-use-summary String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  ; The unit-test form: every use site as `name=kind` joined by spaces.
  (blank)
  (call (. " " join) (in (call use-site-text bindings tree row each) (..< 0 (. row subtree count)) (when (call is-use-site bindings tree row each))))
  (where
    (lazy tree (. ([] (. program modules) module) tree))
    (lazy row ([] (. bindings bindings) binding))
  )
)

(fn-expr + is-use-site Bool
  (param bindings Bindings)
  (param tree AST)
  (param row Binding)
  (param offset U32)
  (and (!= (. resolution kind) .resolve-none) (not declares) (not (not (call (. tree identifier-name) (+ (. row subtree start) offset)))))
  (where
    (lazy resolution ([] (. bindings resolutions) (+ (. row resolution-base) offset)))
    (lazy declares (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-declares)) 0))
  )
)

(fn-expr + use-site-text String
  (param bindings Bindings)
  (param tree AST)
  (param row Binding)
  (param offset U32)
  (str (. name text) "=" (call resolution-summary-text bindings tree resolution))
  (where
    (lazy name (!! (call (. tree identifier-name) (+ (. row subtree start) offset))))
    (lazy resolution ([] (. bindings resolutions) (+ (. row resolution-base) offset)))
  )
)

(fn-expr + resolution-summary-text String
  (param bindings Bindings)
  (param tree AST)
  (param resolution Resolution)
  ; Implicit loop names carry the line of the loop that bound them, so a test can say which loop
  ; an inner `it` reached.
  (match (. resolution kind)
    (case= .resolve-slot
      (case? (or (== (. slot kind) .slot-it) (== (. slot kind) .slot-each))
        (str (call slot-kind-text (. slot kind)) "@" (. (call syntax-location tree (. slot syntax)) begin line))
      )
      (default
        (call slot-kind-text (. slot kind))
      )
    )
    (default
      (call resolution-kind-text (. resolution kind))
    )
  )
  (where
    (lazy slot ([] (. bindings slots) (. resolution slot)))
  )
)

(fn-expr + binding-lazy-summary String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  ; Every lazy slot of a binding as `name@group:reads/writes/refs/tracked:flags`, where the group
  ; is the line of the declaring statement and the flags are the context letters L for declared
  ; in a loop, l for read in a loop, n for nested, b for branch, s for subscription, m for state
  ; machine.
  (blank)
  (call (. " " join) (in (call lazy-slot-text bindings tree each) slots (when (== (. each kind) .slot-lazy))))
  (where
    (lazy tree (. ([] (. program modules) module) tree))
    (lazy row ([] (. bindings bindings) binding))
    (lazy slots ([] (. bindings slots) (. row slots)))
  )
)

(fn-expr + lazy-slot-text String
  (param bindings Bindings)
  (param tree AST)
  (param slot Slot)
  (str (. slot name text) "@" group ":" counts ":" (call lazy-flag-text (. use flags)))
  (where
    (lazy group (. (call syntax-location tree (. slot group)) begin line))
    (lazy use ([] (. bindings lazy-uses) (. slot use)))
    (lazy counts (str (. use reads) "/" (. use writes) "/" (. use refs) "/" (. use tracked)))
  )
)

(fn-expr + lazy-flag-text String
  (param flags U32)
  (str declared loop nested branch subscription machine)
  (where
    (lazy declared (if-expr (!= (/and/ flags (. LazyUseFlag declared-in-loop)) 0) "L" ""))
    (lazy loop (if-expr (!= (/and/ flags (. LazyUseFlag read-in-loop)) 0) "l" ""))
    (lazy nested (if-expr (!= (/and/ flags (. LazyUseFlag read-in-nested)) 0) "n" ""))
    (lazy branch (if-expr (!= (/and/ flags (. LazyUseFlag read-in-branch)) 0) "b" ""))
    (lazy subscription (if-expr (!= (/and/ flags (. LazyUseFlag read-in-subscription)) 0) "s" ""))
    (lazy machine (if-expr (!= (/and/ flags (. LazyUseFlag read-in-state-machine)) 0) "m" ""))
  )
)

(fn-expr + binding-diagnostic-summary String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  ; Every diagnostic a binding produced as `kind:name@line:column`, in order.
  (blank)
  (call (. " " join) (in (call binding-diagnostic-text tree each) diagnostics))
  (where
    (lazy tree (. ([] (. program modules) module) tree))
    (lazy row ([] (. bindings bindings) binding))
    (lazy diagnostics ([] (. bindings diagnostics) (..< (. range start) (. range end))))
    (lazy range (. row diagnostics))
  )
)

(fn-expr + binding-diagnostic-text String
  (param tree AST)
  (param diagnostic Diagnostic)
  (str (call diagnostic-kind-text (. diagnostic kind)) ":" shown "@" (call location-text tree (. diagnostic syntax)))
  (where
    (lazy shown (if-expr (. diagnostic name) (. named text) "-"))
    (lazy named (. diagnostic name))
  )
)

(fn-do + nested-kind-text String
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (if (== (. fn kind) .task-decl)
        (return "task")
      )
      (if (== (. fn kind) .region-decl)
        (return "region")
      )
      (if (== (. fn kind) .iterator-decl)
        (return "iterator")
      )
      (if (== (. fn kind) .feed-decl)
        (return "feed")
      )
      (if (== (. fn kind) .pipeline-decl)
        (return "pipeline")
      )
    )
  )
  (return "closure")
)

(fn-expr + binding-capture-names (list String)
  (param bindings Bindings)
  (param nested U32)
  (param mark-by-value Bool)
  ; The names a nested function captures, in first-reference walk order; a trailing `*` marks a
  ; capture by value when asked for.
  (blank)
  (in (call capture-name bindings each mark-by-value) captures)
  (where
    (lazy row ([] (. bindings nested) nested))
    (lazy captures ([] (. bindings captures) (. row captures)))
  )
)

(fn-expr + capture-name String
  (param bindings Bindings)
  (param capture Capture)
  (param mark-by-value Bool)
  (str (. ([] (. bindings slots) (. capture slot)) name text) suffix)
  (where
    (lazy by-value (!= (/and/ (. capture flags) (. CaptureFlag capture-by-value)) 0))
    (lazy suffix (if-expr (and mark-by-value by-value) "*" ""))
  )
)

(fn-expr + binding-capture-summary String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  ; Every nested function of a binding as `kind@line:captures`, innermost first, with `*` marking
  ; a capture by value.
  (blank)
  (call (. " " join) texts)
  (where
    (lazy nested (. row nested))
    (lazy first (. nested start))
    (lazy texts (in (call nested-capture-text bindings program module tree (+ first each)) (..< 0 (. nested count))))
    (blank)
    (lazy tree (. ([] (. program modules) module) tree))
    (lazy row ([] (. bindings bindings) binding))
  )
)

(fn-expr + nested-capture-text String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param tree AST)
  (param index U32)
  (str kind "@" line ":" (call (. "," join) names))
  (where
    (lazy nested ([] (. bindings nested) index))
    (lazy kind (call nested-kind-text program module (. nested decl)))
    (lazy line (. (call syntax-location tree (. nested syntax)) begin line))
    (lazy names (call binding-capture-names bindings index true))
  )
)

(fn-expr + scan-summary-text String
  (param bindings Bindings)
  (param scan U32)
  ; One scan row as `y<yields> t<tracked> l<latest> u<use>/<use-block>/<finally>/<stack-local>
  ; n<nested> c<calls> p<assertions>/<forces>/<indexes>`.
  (blank)
  (str head " u" cleanup " n" (. row nested-functions) " c" (. row calls) " p" panics)
  (where
    (lazy row ([] (. bindings scans) scan))
    (lazy cleanup (str (. row use-expressions) "/" (. row use-blocks) "/" (. row do-finallys) "/" (. row stack-locals)))
    (lazy panics (str (. row assertions) "/" (. row forces) "/" (. row indexes)))
    (lazy head (str "y" (. row yields) " t" (. row tracked-reads) " l" (. row latests)))
  )
)

(fn-expr + scan-sites-text String
  (param bindings Bindings)
  (param tree AST)
  (param binding BindingId)
  ; The scan sites of a binding in source order, each as `<letter><row>@<line>:<column>`: the
  ; kind's letter, the scan row among the binding's own (0 is the function itself), and where.
  (call (. " " join) (in (call scan-site-text bindings tree (+ (. row sites start) each) (. row scans start)) (..< 0 (. row sites count))))
  (where
    (lazy row ([] (. bindings bindings) binding))
  )
)

(fn-expr _ scan-site-text String
  (param bindings Bindings)
  (param tree AST)
  (param index U32)
  (param first U32)
  (str (call site-letter (. site kind)) (- (. site scan) first) "@" (. loc line) ":" (. loc column))
  (where
    (lazy site ([] (. bindings scan-sites) index))
    (lazy loc (. ([] (. tree nodes loc) (. site syntax)) begin))
  )
)

(fn-expr _ site-letter String
  (param kind ScanKind)
  (match kind
    (case= .scan-yield
      "y"
    )
    (case= .scan-tracked-read
      "t"
    )
    (case= .scan-latest
      "l"
    )
    (case= .scan-use-expression
      "u"
    )
    (case= .scan-use-block
      "b"
    )
    (case= .scan-do-finally
      "f"
    )
    (case= .scan-stack-local
      "s"
    )
    (case= .scan-nested-function
      "n"
    )
    (case= .scan-call
      "c"
    )
    (case= .scan-assertion
      "a"
    )
    (case= .scan-force
      "p"
    )
    (case= .scan-index
      "i"
    )
  )
)

(fn-expr + scan-oracle-text String
  (param bindings Bindings)
  (param scan U32)
  ; The flags the TypeScript compiler discovers while lowering, as the oracle compares them.
  (blank)
  (str flags " cleanup=" (call flag-text cleanups) " nested=" (. row nested-functions))
  (where
    (lazy row ([] (. bindings scans) scan))
    (lazy cleanups (+ (. row use-expressions) (. row use-blocks) (. row do-finallys) (. row stack-locals)))
    (lazy tracked (call flag-text (. row tracked-reads)))
    (lazy flags (str "gen=" (call flag-text (. row yields)) " tracked=" tracked " latest=" (call flag-text (. row latests))))
  )
)

(fn-expr + flag-text String
  (param count U32)
  (if-expr (!= count 0) "1" "0")
)

(fn-expr + binding-scan-summary String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param binding BindingId)
  ; The function's scan row, then one `kind@line:row` per nested function, innermost first.
  (blank)
  (call (. " " join) (call scan-items bindings program module tree row))
  (where
    (lazy tree (. ([] (. program modules) module) tree))
    (lazy row ([] (. bindings bindings) binding))
  )
)

(fn-expr + scan-items (list String)
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param tree AST)
  (param row Binding)
  (item (call scan-summary-text bindings (. row scans start)))
  (spread (in (call nested-scan-text bindings program module tree row each) (..< 0 (. row nested count))))
)

(fn-expr + nested-scan-text String
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param tree AST)
  (param row Binding)
  (param offset U32)
  (str kind "@" line ":" (call scan-summary-text bindings (+ (. row scans start) 1 offset)))
  (where
    (lazy nested ([] (. bindings nested) (+ (. row nested start) offset)))
    (lazy kind (call nested-kind-text program module (. nested decl)))
    (lazy line (. (call syntax-location tree (. nested syntax)) begin line))
  )
)
