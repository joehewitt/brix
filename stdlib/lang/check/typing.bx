(import ./call-paths)
(import ./checker)
(import ./class-tables)
(import ./facts)
(import ./instances)
(import ./portable)
(import ./restrictions)
(import ./session)
(import ./stack-locals)
(import ./signature)
(import ./type-signature)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import ./witnesses)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(fn-do + check-program _
  (param session Session)
  ; Types the program from what it was seeded with, and again from that where a pass must start
  ; over (`check-pass`).
  (while (not (call check-pass session))
    (call start-over session)
  )
)

(fn-do + check-pass Bool
  (param session Session)
  ; Types the program from the worklist, and settles what is known once it is typed. False where
  ; a store typed as one that runs nothing turned out to run actions where what was typed after
  ; it read what the flow knew of a property (`Panics.typed-late`): nothing is settled, and the
  ; pass starts over (`start-over`).
  (let instances (. session instances))
  (let witnesses (call WitnessTables session))
  (let tables (call ClassTables session))
  (while true
    (while (< (. instances worklist-next) (. instances worklist length))
      (let id ([] (. instances worklist) (. instances worklist-next)))
      (+= (. instances worklist-next) 1)
      (call demand-instance session id)
    )
    (if (or (call type-written-in session) (call type-unread session))
      (continue)
    )
    (call (. session errors settle-open))
    (let queued (. instances worklist length))
    (call expand-tables session tables)
    (let grew (call expand-witnesses session witnesses))
    (if (call expand-swaps session)
      (= grew true)
    )
    (if (and (== (. instances worklist length) queued) (not grew))
      (call seed-unreached session)
      (if (== (. instances worklist length) queued)
        (call settle-properties session)
      )
      (if (== (. instances worklist length) queued)
        (call seed-panic-report session)
        (call seed-error-report session)
        (call seed-probe-runtime session)
      )
      (if (!= (. instances worklist length) queued)
        (continue)
      )
      (call (. session errors settle-open))
    )
    (if (call check-used-classes session)
      (continue)
    )
    (if (and (== (. instances worklist length) queued) (not grew))
      (if (call (. session panics typed-late))
        (call (. tables release))
        (return false)
      )
      (call decline-used-members session)
      (call (. session panics retest-forces))
      (call check-forces session)
      (call check-chains session)
      (call number-style-sites session)
      (call number-domains session)
      (call (. session panics gather-unit-calls))
      (let everywhere (list Bool))
      (call (. session facts fold-initializers) (. session bindings) everywhere)
      (call (. session facts chain-loose-calls))
      (call (. session panics propagate))
      (let paths (call CallPaths session))
      (call (. (call StackLocals session paths) check))
      (call (. (call Restrictions session paths) chain-reports))
      (call seed-startup session)
      (call (. tables release))
      (return true)
    )
  )
)

(fn-do + check-forces _
  (param session Session)
  (let facts (. session facts))
  (let instances (. session instances))
  (let nullable (map U64 Bool))
  (for (in fact (. facts forces))
    (let needed
      (scope (or (. fact is-tested) (== (. fact operand) invalid-type) optional-operand)
        (lazy optional-operand (call (. session types is-optional) (. fact operand)))
      )
    )
    (if (and (!= (. fact instance) (. instances dead)) needed)
      (= ([] nullable (call written-site instances (. fact instance) (. fact syntax))) true)
    )
  )
  (for (in fact (. facts forces))
    (if (!= (. fact instance) (. instances dead))
      (let site (call written-site instances (. fact instance) (. fact syntax)))
      (let module (. ([] (. instances rows) (. fact instance)) module))
      (if (and (not ([] nullable site)) (call is-written-force (. ([] (. session program modules) module) tree) (. fact syntax)))
        (= ([] nullable site) true)
        (let message (call (. session program store-atom) "Optional force operand is not optional"))
        (call (. facts record-diagnostic)
          (block
            (arg (. fact instance))
            (arg module)
            (arg (. fact syntax))
            (arg .stated)
            (arg message)
            (arg (. fact operand))
          )
        )
      )
    )
  )
)

(fn-do + check-chains _
  (param session Session)
  (let facts (. session facts))
  (let instances (. session instances))
  (let needed (map U64 Bool))
  (for (in fact (. facts chains))
    (if (and (!= (. fact instance) (. instances dead)) (. fact needed))
      (= ([] needed (call written-site instances (. fact instance) (. fact syntax))) true)
    )
  )
  (for (in fact (. facts chains))
    (if (!= (. fact instance) (. instances dead))
      (let site (call written-site instances (. fact instance) (. fact syntax)))
      (if (not ([] needed site))
        (= ([] needed site) true)
        (let module (. ([] (. instances rows) (. fact instance)) module))
        (let message (call (. session program store-atom) "Optional chaining receiver is not optional"))
        (call (. facts record-diagnostic) (. fact instance) module (. fact syntax) .stated message)
      )
    )
  )
)

(fn-do _ is-written-force Bool
  (param tree AST)
  (param syntax SyntaxId)
  (match? ([] (. tree nodes) syntax)
    (case (call .node-unary-expression row)
      (let written (. ([] (. tree nodes loc) syntax) end))
      (let operand (. ([] (. tree nodes loc) (. row operand)) end))
      (return (or (!= (. written line) (. operand line)) (!= (. written column) (. operand column))))
    )
  )
  (return false)
)

(fn-expr _ written-site U64
  (param instances Instances)
  (param instance InstanceId)
  (param syntax SyntaxId)
  (/or/ (/lshift/ (as (. ([] (. instances rows) instance) module) U64) 32) syntax)
)

(fn-do + number-style-sites _
  (param session Session)
  ; Numbers the places that declare styles in source order, as styles are numbered, and those of
  ; one place by the stable keys of their instances. An edit typed again in place numbers them
  ; again (`retype-edit`).
  (let sites (. session facts style-sites))
  (if (== (. sites length) 0)
    (return)
  )
  (for (in position (..< 1 (. sites length)))
    (let moving ([] sites position))
    (let place position)
    (while (and (> place 0) (call site-before session moving ([] sites (- place 1))))
      (= ([] sites place) ([] sites (- place 1)))
      (-= place 1)
    )
    (= ([] sites place) moving)
  )
  (for (in position (..< 0 (. sites length)))
    (= (. ([] sites position) number) (as position U32))
  )
)

(fn-expr _ site-before Bool
  (param session Session)
  (param site StyleSite)
  (param other StyleSite)
  (case? (!= (. site module) (. other module))
    (< (. site module) (. other module))
  )
  (case? (!= (. begin line) (. other-begin line))
    (< (. begin line) (. other-begin line))
  )
  (case? (!= (. begin column) (. other-begin column))
    (< (. begin column) (. other-begin column))
  )
  (default
    (< ([] keys (. site instance)) ([] keys (. other instance)))
  )
  (where
    (lazy tree (. ([] (. session program modules) (. site module)) tree))
    (lazy begin (. ([] (. tree nodes loc) (. site site)) begin))
    (lazy other-begin (. ([] (. tree nodes loc) (. other site)) begin))
    (lazy keys (. session instances stable-keys))
  )
)

(fn-do + number-domains _
  (param session Session)
  ; Places each domain of invalidation at the first place an instance names it, by the first line
  ; there (`Facts.domain-places`), and orders those some instance names as the style module's init
  ; registers them (`Facts.domain-order`), so that the order is the same however typing numbered
  ; them (`registers-before`). One no instance names any longer, as after an edit typed again in
  ; place, is not registered. The runtime holds 32 (`report-domain-cap`). An edit typed again in
  ; place orders them again (`retype-edit`).
  (let facts (. session facts))
  (call (. facts domain-places clear))
  (call (. facts domain-order clear))
  (for (in index (..< 0 (. facts style-domains length)))
    (+= (. facts domain-places) (call DomainUser no-instance (as index U32) 0 0 0 0))
  )
  (for (in user (. facts domain-users))
    (let best ([] (. facts domain-places) (. user domain)))
    (if (or (== (. best instance) no-instance) (call names-first session user best))
      (= ([] (. facts domain-places) (. user domain)) user)
    )
  )
  (for (in index (..< 0 (. facts domain-places length)))
    (if (== (. ([] (. facts domain-places) index) instance) no-instance)
      (continue)
    )
    (+= (. facts domain-order) (as index U32))
    (let place (- (. facts domain-order length) 1))
    (while (and (> place 0) (call registers-before session ([] (. facts domain-order) place) ([] (. facts domain-order) (- place 1))))
      (let held ([] (. facts domain-order) (- place 1)))
      (= ([] (. facts domain-order) (- place 1)) ([] (. facts domain-order) place))
      (= ([] (. facts domain-order) place) held)
      (-= place 1)
    )
  )
  (if (> (. facts domain-order length) 32)
    (call report-domain-cap session)
  )
)

(fn-do _ report-domain-cap _
  (param session Session)
  ; Reports the reference's error for the domains of invalidation some instance names past the 32
  ; the runtime holds, at the 33rd in the order of the first line that names each, in source order
  ; (`place-before`), then of their names, where that line names it (`written-line`).
  (let facts (. session facts))
  (let firsts (list DomainUser))
  (for (in index (..< 0 (. facts style-domains length)))
    (+= firsts (call DomainUser no-instance (as index U32) 0 0 0 0))
  )
  (for (in user (. facts domain-users))
    (let best ([] firsts (. user domain)))
    (if (or (== (. best instance) no-instance) earlier)
      (= ([] firsts (. user domain)) user)
    )
    (lazy earlier (call place-before session (. user line-module) (. user line) (. best line-module) (. best line)))
  )
  (let named (list DomainUser))
  (for (in first firsts)
    (if (== (. first instance) no-instance)
      (continue)
    )
    (+= named first)
    (let place (- (. named length) 1))
    (while (and (> place 0) (call named-before session ([] named place) ([] named (- place 1))))
      (let held ([] named (- place 1)))
      (= ([] named (- place 1)) ([] named place))
      (= ([] named place) held)
      (-= place 1)
    )
  )
  (let past ([] named 32))
  (let name (. ([] (. facts style-domains) (. past domain)) name text))
  (let message
    (call (. session program store-atom)
      (block
        (arg (str "Too many style invalidation domains (32 maximum); cannot intern \"" name "\""))
      )
    )
  )
  (call (. facts record-diagnostic)
    (block
      (arg (. past instance))
      (arg (. past line-module))
      (arg (call written-line session (. past line-module) (. past line)))
      (arg .stated)
      (arg message)
    )
  )
)

(fn-do _ written-line SyntaxId
  (param session Session)
  (param module ModuleId)
  (param named SyntaxId)
  ; The line of a style that names a domain of invalidation at `named`, or, where the read or write
  ; of the domain's flag names it, `named` itself: where the reference reports an error about it.
  (let tree (. ([] (. session program modules) module) tree))
  (for (in index (..< 0 (. tree nodes length)))
    (match? ([] (. tree nodes) (as index SyntaxId))
      (case (call .node-style-annotation row)
        (for (in item ([] (. tree children) (. row domains)))
          (if (== item named)
            (return (as index SyntaxId))
          )
        )
      )
    )
  )
  (return named)
)

(fn-expr _ named-before Bool
  (param session Session)
  (param user DomainUser)
  (param other DomainUser)
  ; Whether a domain of invalidation is first named before another: at an earlier line, or at the
  ; same line by an earlier name.
  (case? (call place-before session (. user line-module) (. user line) (. other line-module) (. other line))
    true
  )
  (case? (call place-before session (. other line-module) (. other line) (. user line-module) (. user line))
    false
  )
  (default
    (< (. ([] names (. user domain)) name text) (. ([] names (. other domain)) name text))
  )
  (where
    (lazy names (. session facts style-domains))
  )
)

(fn-expr _ names-first Bool
  (param session Session)
  (param user DomainUser)
  (param other DomainUser)
  ; Whether an instance names a domain of invalidation before another does: at an earlier place, or
  ; at the same place by an earlier line (`place-before`).
  (case? (call place-before session (. user module) (. user site) (. other module) (. other site))
    true
  )
  (case? (call place-before session (. other module) (. other site) (. user module) (. user site))
    false
  )
  (default
    (call place-before session (. user line-module) (. user line) (. other line-module) (. other line))
  )
)

(fn-expr _ registers-before Bool
  (param session Session)
  (param domain U32)
  (param other U32)
  ; Whether the style module's init registers a domain of invalidation before another: by the place
  ; each is registered at, then by the line that names each there, as the reference names them as
  ; it reaches them, then by name (`place-before`).
  (case? (call place-before session (. one module) (. one site) (. two module) (. two site))
    true
  )
  (case? (call place-before session (. two module) (. two site) (. one module) (. one site))
    false
  )
  (case? (call place-before session (. one line-module) (. one line) (. two line-module) (. two line))
    true
  )
  (case? (call place-before session (. two line-module) (. two line) (. one line-module) (. one line))
    false
  )
  (default
    (< (. ([] names domain) name text) (. ([] names other) name text))
  )
  (where
    (lazy one ([] (. session facts domain-places) domain))
    (lazy two ([] (. session facts domain-places) other))
    (lazy names (. session facts style-domains))
  )
)

(fn-expr _ place-before Bool
  (param session Session)
  (param module ModuleId)
  (param site SyntaxId)
  (param other-module ModuleId)
  (param other SyntaxId)
  ; Whether a place in the program comes before another in source order: in a module loaded first,
  ; or earlier in the same module, or, of two that begin together or that are no node, at the
  ; earlier syntax.
  (case? (!= module other-module)
    (< module other-module)
  )
  (case? (or (>= site (. tree nodes length)) (>= other (. tree nodes length)))
    (< site other)
  )
  (case? (!= (. begin line) (. other-begin line))
    (< (. begin line) (. other-begin line))
  )
  (case? (!= (. begin column) (. other-begin column))
    (< (. begin column) (. other-begin column))
  )
  (default
    (< site other)
  )
  (where
    (lazy tree (. ([] (. session program modules) module) tree))
    (lazy begin (. ([] (. tree nodes loc) site) begin))
    (lazy other-begin (. ([] (. tree nodes loc) other) begin))
  )
)

(fn-do _ decline-used-members _
  (param session Session)
  ; Declines the members no pass models of the classes the program used, by a checker that
  ; stands in each module that holds one.
  (for (in position (..< 0 (. session program modules length)))
    (if (!= (. ([] (. session program modules) position) undeclared length) 0)
      (let checker (call checker-for session (call seed-main session (as position ModuleId))))
      (call (. checker prepare))
      (call (. checker decline-used-members))
      (call (. checker close))
      (call (. checker retire))
    )
  )
)

(fn-do + check-used-classes Bool
  (param session Session)
  ; Checks what each class the program used declares where no checker of its module's statements
  ; checked it, as the reference checks a class where it is first used: by a checker that stands in
  ; the class's module. Says whether it checked any.
  (let uses (. session types class-uses))
  (let checked false)
  (let position Size 0)
  (while (< position (. uses length))
    (let used ([] uses position))
    (+= position 1)
    (if (!= ([] (. session types checked-classes) (. used key)) null)
      (continue)
    )
    (let checker (call checker-for session (call seed-main session (. used module))))
    (call (. checker prepare))
    (for (in later (..< (- position 1) (. uses length)))
      (if (== (. ([] uses later) module) (. used module))
        (call (. checker initialize-class) (. ([] uses later) decl))
      )
    )
    (call (. checker close))
    (call (. checker retire))
    (= checked true)
  )
  (return checked)
)

(fn-do + type-unread Bool
  (param session Session)
  ; Types each value of a property, of a rule a root applies and each rule of a class that the
  ; passes of a parallel type pass typed and none is taken from (`Instances.typed-on-read`), which
  ; nothing typed here read first. Says whether it typed any.
  (let waiting (. session instances typed-on-read))
  (let typed false)
  (for (in id waiting)
    (if (== (. ([] (. session instances rows) id) state) .instance-unstarted)
      (call demand-instance session id)
      (= typed true)
    )
  )
  (call (. waiting clear))
  (return typed)
)

(fn-do _ expand-tables _
  (param session Session)
  (param tables ClassTables)
  ; Lists the methods of classes for their tables, the targets of the program's descendant queries
  ; among the classes though no object of one is made. A checker that stands in the entry module
  ; types what converting an override's answer to its base's type calls.
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (call (. checker find-query-targets))
  (call (. tables expand) checker)
  (call (. checker close))
  (call (. checker retire))
)

(fn-do + expand-witnesses Bool
  (param session Session)
  (param witnesses WitnessTables)
  ; Finds what answers the functions of interfaces. A checker that stands in the entry module
  ; works out the types a type's function takes that are written with none, and the type of a
  ; property a class answers an interface through that is written with none, and types the
  ; defaults a function of a witness table gives the type's function.
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (let grew (call (. witnesses expand) checker (. checker conversions)))
  (call (. checker close))
  (call (. checker retire))
  (return grew)
)

(fn-do _ expand-swaps Bool
  (param session Session)
  ; In a program that binds a fake to an effect somewhere, a door of it reached where no `do with`
  ; binds one, as code a function value runs is, reads the effect's slot, and where it holds a fake
  ; calls the door typed under a binding of that fake's class: that is interned for each class
  ; fakes of the effect are bound as, and recorded as a call, which may panic where the fake has no
  ; method that answers it. Such a door reads the slot as a global `do with` binds. Says whether it
  ; interned any.
  (let program (. session program))
  (let instances (. session instances))
  (let facts (. session facts))
  (return-if false (if (or (== (. program effects count) 0) (== (. instances swap-entries length) 0))))
  (let grew false)
  (let total (. instances length))
  (for (in position (..< 0 total))
    (let id (as position InstanceId))
    (let row ([] (. instances rows) id))
    (let door (call (. program effects door-of) (. row module) (. row decl)))
    (if (and (!= id (. instances dead)) door (< door (call most-effects)) (== (call (. instances swap-entry-of) (. row effects) door) 0))
      (= grew (or (call dispatch-door session id door) grew))
    )
  )
  (return grew)
)

(fn-do _ dispatch-door Bool
  (param session Session)
  (param id InstanceId)
  (param effect U32)
  (let program (. session program))
  (let instances (. session instances))
  (let facts (. session facts))
  (let fakes (call (. instances fakes-of) effect))
  (return-if false (if (== (. fakes length) 0)))
  (let module (as ([] (. program effects modules) effect) ModuleId))
  (let decl (as ([] (. program effects decls) effect) DeclId))
  (let grew false)
  (for (in fake fakes)
    (let known false)
    (for (in dispatch (. facts swap-dispatches))
      (if (and (== (. dispatch instance) id) (== (. dispatch fake) fake))
        (= known true)
      )
    )
    (if (not known)
      (let row ([] (. instances rows) id))
      (let entry (call (. instances intern-swap-entry) (call SwapEntry effect fake 0 false)))
      (let signature ([] (. instances signatures) id))
      (let stack (. session types scratch types))
      (let mark (. stack mark))
      (for (in place (..< (- (. signature args start) (. signature param-count)) (+ (. signature args start) (. signature args count))))
        (call (. stack push) ([] (. instances signature-types) place))
      )
      (let forwarder
        (call (. instances intern)
          (block
            (arg (. row module))
            (arg (. row decl))
            (arg (. row self-type))
            (arg (call (. instances swapped) (. row effects) effect entry))
            (arg (. row enclosing))
            (arg (call (. stack span) mark (. signature param-count)))
            (arg (call (. stack span) (+ mark (. signature param-count)) (. signature args count)))
          )
        )
      )
      (call (. stack rewind) mark)
      (if (or (== (. facts swap-dispatches length) 0) (call first-of facts id))
        (let site (call declared-syntax program (. row module) (. row decl)))
        (call (. facts stack-reads append) (call StackRead id site module decl))
      )
      (call (. facts swap-dispatches append) (call SwapDispatch id fake (call (. instances fake-kind) effect fake) forwarder module decl))
      (call (. facts record-call) id (call declared-syntax program (. row module) (. row decl)) forwarder .call-function (. session scratch no-fills) false false)
      (= grew true)
    )
  )
  (return grew)
)

(fn-do _ first-of Bool
  (param facts Facts)
  (param id InstanceId)
  (for (in dispatch (. facts swap-dispatches))
    (return-if false (if (== (. dispatch instance) id)))
  )
  (return true)
)

(fn-do _ declared-syntax SyntaxId
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (return (. fn syntax))
    )
  )
  (return 0)
)

(fn-do _ seed-startup _
  (param session Session)
  ; The functions a program starts in are instances like any other, so the tables built after
  ; the seal find them: each module's init, and the entry module's task main, or that of each root
  ; of a batch. They come last, when nothing is left to type, and have no body to check.
  (let program (. session program))
  (let instances (. session instances))
  (for (in position (..< 0 (. program modules length)))
    (let init (. ([] (. program modules) position) init-decl))
    (call demand-instance session (call (. instances intern) (as position ModuleId) init no-type 0 no-instance))
  )
  (let entry (. program entry-module))
  (let task-main (. ([] (. program modules) entry) task-main-decl))
  (call demand-instance session (call (. instances intern) entry task-main no-type 0 no-instance))
  (for (in root (. program batch-roots))
    (let root-main (. ([] (. program modules) root) task-main-decl))
    (call demand-instance session (call (. instances intern) root root-main no-type 0 no-instance))
  )
)

(fn-do _ seed-panic-report _
  (param session Session)
  ; Every program can end in an unhandled panic, so what the report of one calls is typed for
  ; every program, once, when nothing else is left to type. Emission holds only what a root
  ; that may panic reaches.
  (if (!= (. session instances report termination) no-instance)
    (return)
  )
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (call (. checker demand-panic-report))
  (call (. checker close))
  (call (. checker retire))
)

(fn-do _ seed-error-report _
  (param session Session)
  ; The main of a module, the value of a lazy global or the body of a spawned task that lets an
  ; error out reports it, so what that report calls is typed once, when the errors of every one
  ; are settled. Making the texts of the report may panic, so such a function may.
  (let instances (. session instances))
  (let program (. session program))
  (let raises false)
  (for (in position (..< 0 (. program modules length)))
    (let main (call seed-main session (as position ModuleId)))
    (if (!= (. ([] (. instances signatures) main) errors count) 0)
      (call (. instances mark-may-panic) main)
      (= raises true)
    )
    (let owner ([] (. program modules) position))
    (for (in index (..< 0 (. owner decls length)))
      (match? ([] (. owner decls) index)
        (case (call .decl-property property)
          (if (and (== (. property owner) 0) (. property is-lazy) (== (. property decoration) null))
            (let unit
              (call (. instances find-initializer)
                (block
                  (arg (as position ModuleId))
                  (arg (as index DeclId))
                  (arg no-type)
                )
              )
            )
            (if (and (!= unit no-instance) (!= (. ([] (. instances signatures) unit) errors count) 0))
              (call (. instances mark-may-panic) unit)
              (= raises true)
            )
          )
        )
      )
    )
  )
  (for (in body (. session facts task-bodies))
    (if (!= (. ([] (. instances signatures) body) errors count) 0)
      (call (. instances mark-may-panic) body)
      (= raises true)
    )
  )
  (if (or (not raises) (!= (. instances report error-text) no-instance))
    (return)
  )
  (let checker (call checker-for session (call seed-main session (. program entry-module))))
  (call (. checker prepare))
  (call (. checker conversions demand-error-report))
  (call (. checker close))
  (call (. checker retire))
)

(fn-do _ seed-probe-runtime _
  (param session Session)
  ; A program whose probes compile declares them, flushes them and closes their record through the
  ; probes module, whether or not it writes any, so what that calls is typed once, when nothing
  ; else is left to type.
  (if (or (not (. session program probes is-enabled)) (. session instances probe-runtime demanded))
    (return)
  )
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (call (. checker demand-probe-runtime))
  (call (. checker close))
  (call (. checker retire))
)

(fn-do _ settle-properties _
  (param session Session)
  ; Gives every stored property of every concrete type its type before the seal. A property
  ; written without a type takes the type of its value, which the checker works out where the
  ; property is first read; one that nothing read is worked out here, so that the type's layout
  ; is whole.
  (let types (. session types))
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (let id 0u32)
  (while (< id (. types completions length))
    (let completion ([] (. types completions) id))
    (if (and (== (. completion completion) .completion-done) (not (. completion has-variables)))
      (for (in offset (..< 0 (. completion properties count)))
        (let position (+ (. completion properties start) offset))
        (let property ([] (. types properties) position))
        (if (and (!= (. property storage-kind) .storage-getter) (== (. property type) no-type))
          (let value (call (. checker demand-member) property id (. property name)))
          (if (and (!= value invalid-type) (!= value no-type))
            (= (. ([] (. types properties) position) type) value)
          )
        )
      )
    )
    (+= id 1)
  )
  (call (. checker close))
  (call (. checker retire))
)

(fn-do + demand-instance _
  (param session Session)
  (param instance InstanceId)
  (if (or (!= (. ([] (. session instances rows) instance) state) .instance-unstarted) (call adopt session instance))
    (return)
  )
  (let checker (call checker-for session instance))
  (call (. checker run))
  (call (. checker retire))
)

(fn-expr + seed-main InstanceId
  (param session Session)
  (param module ModuleId)
  (call (. session instances intern) module main no-type 0 no-instance)
  (where
    (lazy main (. ([] (. session program modules) module) main-decl))
  )
)

(fn-do + seed-mains _
  (param session Session)
  ; A program runs the statements of every module it loads, so every module's main is typed,
  ; the entry module's first.
  (call seed-module session (. session program entry-module))
  (for (in position (..< 0 (. session program modules length)))
    (call seed-module session (as position ModuleId))
  )
)

(fn-do + seed-module _
  (param session Session)
  (param module ModuleId)
  (call (. session note-seed) module false)
  (call seed-main session module)
)

(fn-do + seed-functions _
  (param session Session)
  (param module ModuleId)
  (call (. session note-seed) module true)
  (call seed-module-functions session module)
)

(fn-do + start-over _
  (param session Session)
  ; Starts a type pass over from what it was seeded with, knowing every property the pass so
  ; far found tracked.
  (probe-log typing.start-over (text: "starts over"))
  (call (. session restart))
  (for (in position (..< 0 (. session seeded-modules length)))
    (if ([] (. session seeded-functions) position)
      (call seed-module-functions session ([] (. session seeded-modules) position))
      (else
        (call seed-main session ([] (. session seeded-modules) position))
      )
    )
  )
)

(fn-do _ seed-module-functions _
  (param session Session)
  (param module ModuleId)
  (let owner-module ([] (. session program modules) module))
  (let index 0u32)
  (for (in decl (. owner-module decls))
    (match? decl
      (case (call .decl-function row)
        (let accessor (and (== (. row owner) 0) (or (== (. row kind) .getter-decl) (== (. row kind) .setter-decl))))
        (let concrete (and (not (. row is-generated)) (not (. row is-static)) (!= (. row body) 0)))
        (let plain (and concrete (or (== (. row kind) .function-decl) accessor)))
        (if (and plain (== (. row type-args count) 0) (not (call has-untyped-default owner-module row)))
          (call seed-declaration session module index)
        )
      )
    )
    (+= index 1)
  )
)

(fn-do _ seed-unreached _
  (param session Session)
  (for (in module (. session unreached-modules))
    (call seed-module-functions session module)
    (call seed-unmade-classes session module)
    (call seed-sheet-rules session module)
  )
)

(fn-do _ seed-sheet-rules _
  (param session Session)
  (param module ModuleId)
  (let types (. session types))
  (let instances (. session instances))
  (let owner ([] (. session program modules) module))
  (let index 0u32)
  (for (in decl (. owner decls))
    (let sheet no-type)
    (let members (call (of RowRange DeclId)))
    (match? decl
      (case (call .decl-class class)
        (if (== (. class type-args count) 0)
          (let env (call (. types class-env) module index))
          (= sheet (. env this-type))
          (call (. types env-release) env)
          (= members (. class members))
        )
      )
      (case (call .decl-sheet-extension extension)
        (call (. types clear-fault))
        (= sheet (call (. types evaluate-type) module (. owner tree) (. extension receiver) (call (. types env-frame))))
        (call (. types clear-fault))
        (= members (. extension members))
      )
    )
    (if (and (!= sheet no-type) (!= sheet invalid-type) (== (call (. types intrinsic-of) sheet) .style-sheet))
      (for (in member ([] (. owner member-pool) members))
        (match? ([] (. owner decls) member)
          (case (call .decl-style-rule rule)
            (if (== (. rule outer) 0)
              (call (. instances queue) (call (. instances intern-initializer) module member sheet))
            )
          )
        )
      )
    )
    (+= index 1)
  )
)

(fn-do _ seed-unmade-classes _
  (param session Session)
  (param module ModuleId)
  (let owner ([] (. session program modules) module))
  (let made (call made-classes session module))
  (let index 0u32)
  (for (in decl (. owner decls))
    (match? decl
      (case (call .decl-class class)
        (if (and (== (. class type-args count) 0) (not ([] made index)))
          (call seed-constructors session module index class)
        )
      )
    )
    (+= index 1)
  )
)

(fn-do _ made-classes (list Bool)
  (param session Session)
  (param module ModuleId)
  (let types (. session types))
  (let instances (. session instances))
  (let made (list Bool))
  (for (in _ (..< 0 (. ([] (. session program modules) module) decls length)))
    (+= made false)
  )
  (for (in position (..< 0 (. instances length)))
    (let row ([] (. instances rows) position))
    (if (and (!= (. row self-type) no-type) (call makes-object session (. row module) (. row decl)))
      (let level (? TypeId) (. row self-type))
      (while level
        (let ref (call class-ref types level))
        (if (== (. ref module) module)
          (= ([] made (. ref decl)) true)
        )
        (= level (call (. types base-of) level))
      )
    )
  )
  (return made)
)

(fn-expr _ makes-object Bool
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (match ([] (. ([] (. session program modules) module) decls) decl)
    (case (call .decl-function fn)
      (call is-constructor-kind (. fn kind))
    )
    (default
      false
    )
  )
)

(fn-do _ seed-constructors _
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (param class ClassDecl)
  (let owner ([] (. session program modules) module))
  (let env (call (. session types class-env) module decl))
  (let kind (call (. session types intrinsic-of) (. env this-type)))
  (call (. session types env-release) env)
  (if (!= kind .class)
    (return)
  )
  (let writes false)
  (let generated DeclId 0)
  (for (in member ([] (. owner member-pool) (. class members)))
    (match? ([] (. owner decls) member)
      (case (call .decl-function fn)
        (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)))
          (= writes true)
          (if (not (call has-untyped-default owner fn))
            (call seed-declaration session module member)
          )
        )
        (if (== (. fn kind) .default-constructor-decl)
          (= generated member)
        )
      )
    )
  )
  (if (and (not writes) (!= generated 0))
    (call seed-declaration session module generated)
  )
)

(fn-do _ has-untyped-default Bool
  (param owner-module Module)
  (param row FunctionDecl)
  (for (in shape ([] (. owner-module arg-pool) (. row args)))
    (if (and (== (. shape type-syntax) 0) (!= (. shape default-syntax) 0))
      (return true)
    )
  )
  (return false)
)

(fn-expr _ is-stream-type Bool
  (param types Types)
  (param type TypeId)
  (match ([] (. types rows) type)
    (case (call .type-class row)
      (and (== (. row module) (. types stream-decl module)) (== (. row decl) (. types stream-decl decl)))
    )
    (default
      false
    )
  )
)

(fn-do + seed-declaration (? InstanceId)
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (let types (. session types))
  (let program (. session program))
  (let owner 0u32)
  (let effects EffectMask 0)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function row)
      (= owner (. row owner))
      (= effects (call declared-effects program module decl))
    )
    (case (call .decl-converter row)
      (= owner (. row owner))
    )
    (case (call .decl-fromverter row)
      (= owner (. row owner))
    )
  )
  (let receiver no-type)
  (blank)
  (if (!= owner 0)
    (match? ([] (. ([] (. program modules) module) decls) owner)
      (case (call .decl-class class)
        (if (!= (. class type-args count) 0)
          (return null)
        )
        (let env (call (. types class-env) module owner))
        (= receiver (. env this-type))
        (call (. types env-release) env)
      )
      (case .decl-extension
        (return null)
      )
    )
  )
  (return (call seed-member session module decl receiver effects))
)

(fn-do + seed-member (? InstanceId)
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (param receiver TypeId)
  (param effects EffectMask)
  (let types (. session types))
  (let scratch (. session scratch))
  (let names-mark (. scratch names mark))
  (let items-mark (. scratch types mark))
  (let signature (call signature-into types module decl (call no-type-arguments types) receiver true))
  (let usable (== (. signature params length) 0))
  (for (in arg (. signature args))
    (let item (call (. types optional-inner) arg))
    (if (or (== arg invalid-type) (. ([] (. types completions) arg) has-variables) (call is-stream-type types item))
      (= usable false)
    )
  )
  (let seeded (? InstanceId) null)
  (if usable
    (let none (. scratch no-types))
    (= seeded
      (call (. session instances intern)
        (block
          (arg module)
          (arg decl)
          (arg receiver)
          (arg effects)
          (arg no-instance)
          (arg none)
          (arg (. signature args))
        )
      )
    )
  )
  (call (. scratch types rewind) items-mark)
  (call (. scratch names rewind) names-mark)
  (return seeded)
)
