./binding
/lang/ast/decl
/lang/ast/module

+ NarrowingKey is U64

_ evaluated-key-base NarrowingKey = 4611686018427387904u64
_ member-key-base NarrowingKey = 9223372036854775808u64
_ path-key-base NarrowingKey = 13835058055282163712u64

━━━━━━━━━━━━━━━━━━━━
+ slot-key NarrowingKey
    - slot SlotId

slot as NarrowingKey

━━━━━━━━━━━━━━━━━━━━
+ evaluated-key NarrowingKey
    - slot SlotId

` The key under which the flow knows that a lazy local kept behind a flag has its value: every
` way here passed a read of it.
evaluated-key-base + (slot as NarrowingKey)

━━━━━━━━━━━━━━━━━━━━
+ member-key NarrowingKey
    - module ModuleId
    - decl DeclId

member-key-base + ((module as NarrowingKey) /lshift/ 32) + (decl as NarrowingKey)

━━━━━━━━━━━━━━━━━━━━
+ path-key-at NarrowingKey
    - index U32

path-key-base + (index as NarrowingKey)

━━━━━━━━━━━━━━━━━━━━
+ is-evaluated-key Bool
    - key NarrowingKey

key >= evaluated-key-base && key < member-key-base

━━━━━━━━━━━━━━━━━━━━
+ is-member-key Bool
    - key NarrowingKey

key >= member-key-base

━━━━━━━━━━━━━━━━━━━━
+ is-path-key Bool
    - key NarrowingKey

key >= path-key-base

━━━━━━━━━━━━━━━━━━━━
+ path-index U32
    - key NarrowingKey

(key - path-key-base) as U32

━━━━━━━━━━━━━━━━━━━━
+ key-slot SlotId
    - key NarrowingKey

if key < evaluated-key-base then key as SlotId else no-slot
