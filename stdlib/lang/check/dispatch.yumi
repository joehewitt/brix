+ do has-extension-getter Bool
    - receiver TypeId
    - name Atom

` Whether an extension in scope adds a getter of this name to the receiver or to a base of it.
. level TypeId? = receiver
while level
    . ref = DeclRef(U32.max, U32.max)
    do match? types.rows[level]
        | .type-class(row)
            ref = DeclRef(row.module, row.decl)
    if ref.module != U32.max
        for extension in program.extensions-for(caller, ref.module, ref.decl)
            if extends-getter(extension.module, extension.decl, level, name)
