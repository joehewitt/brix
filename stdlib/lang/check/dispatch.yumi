                = row.value != 0
= false

────────────────────
_ do rank-fields Hit?
    - scope MatchScope
    - module ModuleId
    - decl DeclId
    - receiver TypeId

. generic = types.is-generic(receiver)
. class-args = RowRange'TypeId()
do match? types.rows[receiver]
    | .type-class(row)
        class-args = row.args

. owner = 0u32
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        owner = fn.owner

. type-args = types.class-type-args(module, owner)
. tree = program.modules[module].tree

if generic
