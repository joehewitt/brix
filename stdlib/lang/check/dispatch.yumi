. items-start = scratch.types.mark
. words-start = scratch.words.mark
. relations-start = scratch.relations.mark
. fills-start = scratch.words.mark
scratch.words.push(0)
. fills = scratch.words.since(fills-start)
. expected-start = scratch.types.mark
scratch.types.push(receiver)
. expected = scratch.types.since(expected-start)
. scope = relations.scope-open()
. tails = TailMatch(scratch.no-fills, scratch.no-relations)
. relations-mark = scratch.relations.mark
. args-mark = scratch.types.mark
. was-asked = asked
asked = true
. ranked = rank-slots
    - scope
    - false
    - fills
    - expected
    - expected
    - scratch.no-fills
    - scratch.no-fills
    - U32.max
    - tails
    - scratch.no-fills
asked = was-asked
relations.scope-release(scope)
if !ranked
    scratch.types.rewind(items-start)
    scratch.words.rewind(words-start)
    scratch.relations.rewind(relations-start)
    = null
. args = scratch.types.since(args-mark)
. slot-relations = scratch.relations.since(relations-mark)
. alternative = types.intrinsic-of(receiver) == .or && slot-relations.length == 1
= Hit
    - module
    - decl
    - if alternative then slot-relations[0].to else receiver
    - scratch.no-types
    - args
    - fills
    - slot-relations
    - tails.fills
    - tails.relations
    - false

────────────────────
+ do rank-tuple Hit?
    - module ModuleId
    - decl DeclId
    - receiver TypeId

is-partial = false
. items-start = scratch.types.mark
. words-start = scratch.words.mark
. relations-start = scratch.relations.mark
. scope = relations.scope-open()
. hit = rank-fields(scope, module, decl, receiver)
relations.scope-release(scope)
if !hit
    scratch.types.rewind(items-start)
    scratch.words.rewind(words-start)
    scratch.relations.rewind(relations-start)
= hit

────────────────────
_ do field-type TypeId
    - fact TypeProperty
    - receiver TypeId

if fact.type != no-type
    = fact.type
if !host
    = invalid-type
consulted = true
= host.demand-member(fact, receiver, fact.name)

