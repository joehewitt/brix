if held != no-type
    = held
. name = types.delegate-name(receiver, offset)
. found = types.property-named(receiver, name)
if !found || !host
    = no-type
consulted = true
= host.demand-member(types.properties[found], receiver, name)

────────────────────
_ do declares-method Bool
    - interface TypeId
    - name Atom
    - kind DeclKind

. ref = DeclRef(U32.max, U32.max)
do match? types.rows[interface]
    | .type-class(row)
        ref = DeclRef(row.module, row.decl)
if ref.module == U32.max
    = false
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(row)
        . place = owner.first-member(row.members, name)
        while place != no-member
            . member = owner.member-pool[place]
            place = owner.member-links[place]
            do match? owner.decls[member]
                | .decl-function(fn)
                    if fn.name && fn.name == name && fn.kind == kind
