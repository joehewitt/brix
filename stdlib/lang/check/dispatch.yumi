────────────────────
_ do owner-param Bool
    - module ModuleId
    - owner DeclId
    - name Atom

if owner == 0
    = false
. tree = program.modules[module].tree
. type-args = types.class-type-args(module, owner)
for position in 0 .. < type-args.count
    . param = types.class-param-name(tree, type-args, position)
    if param && param == name
