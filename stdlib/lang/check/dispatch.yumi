_ do accept
    - hit Hit?

if !hit
    ranked.clear()
    ranked-params.clear()
    =
if is-partial
    if !partial
        partial = hit
    ranked.clear()
    =
if best && best.receiver != no-type && hit.receiver == no-type
    ranked.clear()
    =
if ranked.length != hit.relations.length
    ranked.clear()
    for relation in hit.relations
        ranked += relation
if best
    . equal = equal-ranking(best, hit)
    . same = best!.module == hit.module && best!.decl == hit.decl
    . constructors = kind == .rank-constructor && !is-generated(best!) && !is-generated(hit)
    if constructors && equal && equal-specificity(best!, hit) && different-params(best!, hit)
        ambiguous-constructor = true
    else if kind == .rank-static && equal && !same && equal-specificity(best!, hit)
        ambiguous-static = true
    else if !same && best!.is-extension && hit.is-extension
        . preferred = row-case-preference(best!, hit)
        if preferred < 0
            ranked.clear()
            ranked-params.clear()
            =
        ambiguous-extension = preferred == 0
    else if !same && best!.is-extension != hit.is-extension && same-signature(best!, hit)
        conflicting = conflicting || !(is-facet-member(best!) || is-facet-member(hit))
    if !equal
        ambiguous-constructor = false
        ambiguous-static = false
best = hit
incumbent.clear()
for relation in ranked
    incumbent += relation
incumbent-variadic = hit.tail-fills.length != 0 || is-variadic(hit.module, hit.decl)
incumbent-params.clear()
for param in ranked-params
    incumbent-params += param
ranked.clear()
ranked-params.clear()

────────────────────
+ ambiguity TypeDiagnosticKind?

|? !best
    null
|? best.is-extension && ambiguous-extension
    .ambiguous-extension
|? ambiguous-constructor
    .ambiguous-constructor
|? ambiguous-static
    .ambiguous-static
|? conflicting
    .extension-conflict
??
    null

────────────────────
_ row-case-preference I32
    - kept Hit
    - next Hit

` Which of two extensions' members a name that stands for the case of a row (`row-case`) takes,
` as TypeScript's `preferNarrowedTableRowExtension` does: the one that extends the case itself
` over one that extends a base of it, -1 for `kept`, 1 for `next`, or 0 for neither.
|? row-case == no-type || (kept.level == row-case) == (next.level == row-case)
    0
|? kept.level == row-case
    -1
??
    1

────────────────────
_ do equal-ranking Bool
    - left Hit
    - right Hit

` Whether a candidate ranks as the one chosen so far does, slot by slot, by what each has
` compared its arguments to: `incumbent` for the one chosen, `ranked` for the new one.
if left.fills.length != right.fills.length || left.tail-fills.length != right.tail-fills.length
    = false
if incumbent.length != ranked.length
    = false
for position in 0 .. < incumbent.length
    if incumbent[position].rank != ranked[position].rank
        = false
for position in 0 .. < left.tail-relations.length
    if left.tail-relations[position].rank != right.tail-relations[position].rank
        = false
= true

────────────────────
_ do is-generated Bool
    - hit Hit

do match? program.modules[hit.module].decls[hit.decl]
    | .decl-function(fn)
        = fn.is-generated
= false

────────────────────
_ do equal-specificity Bool
    - left Hit
    - right Hit

. mine = program.modules[left.module]
. theirs = program.modules[right.module]
. count = U32.max
. start Index = 0
. variadic = U32.max
do match? mine.decls[left.decl]
    | .decl-function(fn)
        count = fn.args.count
        start = fn.args.start
        variadic = fn.variadic-index
do match? theirs.decls[right.decl]
    | .decl-function(fn)
        . plain = fn.variadic-index == U32.max
        if fn.args.count != count || plain != (variadic == U32.max)
            = false
        . other Index = fn.args.start
        . offset = 0u32
        while offset < count
            . spec = mine.arg-pool[start + offset].specificity
            if spec != theirs.arg-pool[other + offset].specificity
                = false
            offset += 1
        = true
= false

────────────────────
_ do different-params Bool
    - left Hit
    - right Hit

if left.params.length != right.params.length
    = false
for offset in 0 .. < left.params.length
    if left.params[offset] != right.params[offset]
        = true
= false

────────────────────
_ do is-facet-member Bool
    - hit Hit

` Whether a candidate is a member of a facet, which a class below the facet's own declares again
` to override it, as it would a member of the class, and which answers an interface's function as
` the class's own member would.
=? false if !hit.is-extension || program.facets.count == 0
do match? program.modules[hit.module].decls[hit.decl]
    | .decl-function(fn)
        = program.facets.index-of(hit.module, fn.owner) != null
= false

────────────────────
_ do same-signature Bool
    - left Hit
    - right Hit

. mine = program.modules[left.module]
. theirs = program.modules[right.module]
. count = U32.max
. start Index = 0
do match? mine.decls[left.decl]
    | .decl-function(fn)
        count = fn.args.count
        start = fn.args.start
do match? theirs.decls[right.decl]
    | .decl-function(fn)
        if fn.args.count != count || left.fills.length != right.fills.length
            = false
        . other Index = fn.args.start
        . offset = 0u32
        while offset < count
            . called = mine.arg-pool[start + offset].name
            if called != theirs.arg-pool[other + offset].name
                = false
            offset += 1
        for position in 0 .. < left.fills.length
            if left.args[position] != right.args[position]
                = false
        = true
= false

────────────────────
_ do is-variadic Bool
    - module ModuleId
    - decl DeclId

do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.variadic-index != U32.max
= false

────────────────────
_ do rank-methods
    - receiver TypeId
    - name Atom
    - kind DeclKind

. viewed = types.facet-of-type(receiver)
if viewed
    rank-facet-members(viewed, name, kind)
    =
. receiver-kind = types.intrinsic-of(receiver)
. base = types.base-of(receiver)
if receiver-kind != .interface
    rank-default-methods(receiver, receiver, name, kind)
rank-delegates(receiver, name, kind)
if base
    rank-bases(base, receiver, name, kind)
if receiver-kind == .interface
    rank-parent-interfaces(receiver, receiver, name, kind)
rank-methods-at(receiver, receiver, name, kind)
if receiver-kind == .table-row || receiver-kind == .immutable-table-row
    rank-logical(receiver, name, kind)

────────────────────
_ do rank-facet-members
    - facet U32
    - name Atom
    - kind DeclKind

` Ranks what a facet's value answers: the members of the facet and of its ancestor facets that
` the caller sees, the nearest last, each run on the facet's owner, so that a class below that
` declares one again answers for it.
. facets = program.facets
. owner = types.facet-owner(facet)
. chain [U32]
. current = facet
while current != U32.max && chain.length <= facets.count
    chain += current
    current = facets.parents[current]
for offset in 0 .. < chain.length
    . held = chain[chain.length - 1 - offset]
    if !program.sees-facet(caller, held)
        continue
    . module = facets.modules[held]
    . target = program.modules[module]
    do match? target.decls[facets.decls[held]]
        | .decl-extension(body)
            extension-ranking = true
            extension-level = owner
            rank-members(module, target, body.members, name, owner, no-type-arguments(types), kind)
            extension-ranking = false
            extension-level = no-type

────────────────────
_ do rank-bases
    - level TypeId
    - receiver TypeId
    - name Atom
    - kind DeclKind

` Ranks what a base class answers. Its interfaces and delegates are ranked on the way to the
` root and its own members on the way back, so that of two candidates that rank alike the
` one declared nearest the receiver stands.
if types.intrinsic-of(receiver) != .interface
    rank-default-methods(level, receiver, name, kind)
rank-delegates(level, name, kind)
. base = types.base-of(level)
if base
    rank-bases(base, receiver, name, kind)
rank-methods-at(level, receiver, name, kind)

────────────────────
_ do rank-logical
    - receiver TypeId
    - name Atom
    - kind DeclKind

` A table row over a union also answers the extension methods and getters of the union, and
` the extension methods of each base all of its cases share, which run with the row itself as
` the receiver, as TypeScript's rows answer them. A getter of such a base is each case's own.
