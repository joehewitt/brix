────────────────────
_ do infer-fields Bool
    - scope MatchScope
    - fills ImmutableArray'U32'ArenaBacking
    - fields ImmutableArray'TypeId'ArenaBacking
    - class-args RowRange'TypeId
    - type-args RowRange'SyntaxId
    - module ModuleId
    - decl DeclId

