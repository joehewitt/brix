adapted = receiver
rank-extensions(union, name, kind)
. shared = if kind == .function-decl then types.shared-case-base(union) else no-type
while shared != no-type
    rank-extensions(shared, name, kind)
    shared = types.shared-case-base(union, shared)
adapted = no-type

────────────────────
_ readdress Hit?
    - hit Hit?

|? !hit || adapted == no-type
