= false

────────────────────
+ do interface-holder TypeId
    - receiver TypeId
    - interface TypeId
    - places [U32]

` What a class delegates an interface to: the type of the property it names for it, or one of
` its bases names, whose place is appended. No type where the class implements it itself.
. current = receiver
while current != no-type
    . delegates = types.delegates-of(current)
    for offset in 0 .. < delegates.length / 2
        if delegates[offset * 2] != interface
            continue
        . delegate = delegate-type(current, offset)
        . found = types.property-named(current, types.delegate-name(current, offset))
        if found && delegate != no-type && delegate != invalid-type
            places += found as U32
            = delegate
    current = types.base-of(current) ?? no-type
= no-type

────────────────────
+ do delegated-holder TypeId
    - receiver TypeId
    - name Atom
    - places [U32]

` The type that answers a name for a class through the properties it delegates interfaces
` to, where the class holds no property of the name: what a search of its bases, from the
` first of them, reaches. A class asks each property it delegates an interface that declares
` the name to, which answers where its type holds the property or reaches one so, and then
` its own interfaces, where one that declares the name ends the search. The place of each
` property read to reach the answer is appended in the order they are read; none is where
` an interface of the class answers, or nothing does.
. current = receiver
while current != no-type && types.delegates-of(current).length == 0
    current = types.base-of(current) ?? no-type
if current == no-type
    = no-type
= seek-holder(receiver, name, places)

────────────────────
_ do seek-holder TypeId
    - receiver TypeId
    - name Atom
    - places [U32]

. levels [TypeId]
. current = receiver
while current != no-type
    levels += current
    current = types.base-of(current) ?? no-type
for back in 0 .. < levels.length
    . level = levels[levels.length - 1 - back]
    for offset in 0 .. < types.delegates-of(level).length / 2
        if !declares-property(types.delegates-of(level)[offset * 2], name)
            continue
        . delegate = delegate-type(level, offset)
        . read = types.property-named(level, types.delegate-name(level, offset))
        if !read || delegate == no-type || delegate == invalid-type
            continue
        . mark = places.length
        places += read as U32
        if types.property-named(delegate, name)
            = delegate
        if lends(level, delegate)
            . reached = seek-holder(delegate, name, places)
            lent()
            if reached != no-type
                = reached
        while places.length > mark
            places.pop()
    for interface in types.interfaces-of(level)
        if declares-property(interface, name)
            = level
= no-type

────────────────────
_ do declares-property Bool
    - interface TypeId
    - name Atom

` Whether an interface declares a property of a name, itself or one it is derived from.
if types.property-named(interface, name)
    = true
for parent in types.interfaces-of(interface)
    if declares-property(parent, name)
        = true
= false

────────────────────
_ do rank-default-methods
    - level TypeId
    - receiver TypeId
    - name Atom
    - kind DeclKind

for interface in types.interfaces-of(level)
    rank-default-methods(interface, receiver, name, kind)
    . ref = DeclRef(U32.max, U32.max)
    do match? types.rows[interface]
        | .type-class(row)
            ref = DeclRef(row.module, row.decl)
    if ref.module == U32.max
