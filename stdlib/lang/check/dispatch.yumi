────────────────────
+ This
    - session Session
    - caller ModuleId

.. types = session.types
.. relations = session.relations
.. program = session.program
.. scratch = session.scratch
.. facts = session.facts

────────────────────
+ do rebind
    - module ModuleId

` Hands the ranking to another function's calls, as if it were new.
caller = module
host = null
conversions = null
best = null
partial = null
active = false
c-only = false
pattern-self = false
adapted = no-type

────────────────────
+ do begin
    - shapes ImmutableArray'CallArgument'ArenaBacking
    - given ImmutableArray'TypeId'ArenaBacking

best = null
partial = null
bound-call = false
row-case = no-type
active = true
missing-module = 0
missing-site = 0
kind = .rank-plain
extension-ranking = false
extension-level = no-type
is-partial = false
ambiguous-constructor = false
ambiguous-static = false
ambiguous-extension = false
conflicting = false
incumbent.clear()
incumbent-variadic = false
incumbent-params.clear()
ranked.clear()
ranked-params.clear()
explicit = scratch.no-types
args = given
ranked-shapes = shapes
request = .request-none
items-mark = scratch.types.mark
names-mark = scratch.names.mark
words-mark = scratch.words.mark
relations-mark = scratch.relations.mark
calls.clear()
for shape in shapes
    calls += shape
symbol-fills.clear()

────────────────────
_ do note-request
    - made DispatchRequest
    - receiver TypeId
    - name Atom?

request = made
request-receiver = receiver
request-name = name

────────────────────
_ do recall Bool

` Restores what ranking this call chose before, where the call was ranked as it is now.
consulted = false
=? false if !rememberable()
open-ranking-key()
. cache = scratch.rankings
. found = cache.found
=? false if !found
. row = cache.rankings[found]
best = cached-hit(row.best)
partial = cached-hit(row.partial)
ambiguous-constructor = row.ambiguous-constructor
ambiguous-static = row.ambiguous-static
ambiguous-extension = row.ambiguous-extension
conflicting = row.conflicting
missing-module = row.missing-module
missing-site = row.missing-site
= true

────────────────────
_ do remember

` Keeps what ranking this call chose, where ranking it asked nothing of the checker.
=? if consulted || !rememberable()
open-ranking-key()
. row = CachedRanking
    - kept-hit(best)
    - kept-hit(partial)
    - ambiguous-constructor
    - ambiguous-static
    - ambiguous-extension
    - conflicting
    - missing-module
    - missing-site
scratch.rankings.keep(row)

────────────────────
_ do rememberable Bool

` Whether what ranking chooses for this call is told by what the call gives alone: no argument
` is a case named by its symbol alone or an integer written with no suffix, and no type given
` holds a variable or a closure.
for shape in calls
    =? false if shape.symbol || shape.literal != 0
=? false if !plain-type(request-receiver) || !plain-type(row-case)
for type in args
    =? false if !plain-type(type)
= all(explicit) • where plain-type(each)

────────────────────
_ plain-type Bool
    - type TypeId

type == no-type || (!completion.has-variables && !completion.has-closures)

.. completion = types.completions[type]

────────────────────
_ do open-ranking-key

. cache = scratch.rankings
cache.open-key()
cache.add-key(request)
cache.add-key(request-receiver)
add-atom-key(request-name)
cache.add-key(caller)
. flags = 0u32
if bound-call
    flags += 1
if host
    flags += 2
if c-only
    flags += 4
if request == .request-constructor && request-by-name
    flags += 8
cache.add-key(flags)
cache.add-key(row-case)
cache.add-key(explicit.length as U32)
for type in explicit
    cache.add-key(type)
cache.add-key(args.length as U32)
for type in args
    cache.add-key(type)
cache.add-key(calls.length as U32)
for shape in calls
    add-atom-key(shape.name)
    . shape-flags = 0u32
    if shape.is-optional
        shape-flags += 1
    if shape.is-variadic-list
        shape-flags += 2
    if shape.is-property
        shape-flags += 4
    if shape.is-skipped
        shape-flags += 8
    cache.add-key(shape-flags)

────────────────────
_ do add-atom-key
    - name Atom?

. address Size = (if name then name.address else 0) as Size
scratch.rankings.add-key((address /and/ (U32.max as Size)) as U32)
scratch.rankings.add-key((address /rshift/ 32) as U32)

────────────────────
_ cached-hit Hit?
    - place U32

|? place == U32.max
    null
??
    Hit
        - row.module
        - row.decl
        - row.receiver
        - cache.types.span(row.params, row.param-count)
        - cache.types.span(row.args, row.arg-count)
        - cache.words.span(row.fills, row.fill-count)
        - cache.relations.span(row.relations, row.relation-count)
        - cache.words.span(row.tail-fills, row.tail-fill-count)
        - cache.relations.span(row.tail-relations, row.tail-relation-count)
        - row.is-extension
        - row.level

.. cache = scratch.rankings
.. row = cache.hits[place]

────────────────────
_ do kept-hit U32
    - hit Hit?

=? U32.max if !hit
. kept = hit
. cache = scratch.rankings
. params U32 = cache.types.length as U32
for type in kept.params
    cache.types.push(type)
. args U32 = cache.types.length as U32
for type in kept.args
    cache.types.push(type)
. fills U32 = cache.words.length as U32
for fill in kept.fills
    cache.words.push(fill)
. tail-fills U32 = cache.words.length as U32
for fill in kept.tail-fills
    cache.words.push(fill)
. relations U32 = cache.relations.length as U32
for relation in kept.relations
    cache.relations.push(relation)
. tail-relations U32 = cache.relations.length as U32
for relation in kept.tail-relations
    cache.relations.push(relation)
. place U32 = cache.hits.length as U32
. made = CachedHit
    - kept.module
    - kept.decl
    - kept.receiver
    - kept.level
    - kept.is-extension
    - params
    - kept.params.length as U32
    - args
    - kept.args.length as U32
    - fills
    - kept.fills.length as U32
    - relations
    - kept.relations.length as U32
    - tail-fills
    - kept.tail-fills.length as U32
    - tail-relations
    - kept.tail-relations.length as U32
cache.hits.append(made)
= place

────────────────────
+ do replay Hit?
    - other Ranking
    - given ImmutableArray'TypeId'ArenaBacking
    - literal-at U32 = U32.max
    - literal SyntaxId = 0

` Ranks again what another ranking last ranked, as it was ranked, with other types given for
` its arguments, and the argument at `literal-at` taken as the number `literal` is written. The
` ranking is then released as any other.
caller = other.caller
host = other.host
conversions = other.conversions
begin(other.ranked-shapes, given)
if literal-at < calls.length
    . shape = calls[literal-at]
    calls[literal-at] = shape.literal = literal
explicit = other.explicit
bound-call = other.bound-call
row-case = other.row-case
. receiver = other.request-receiver
. name = other.request-name
do match? other.request
    |= .request-function
        = dispatch-function(receiver, name!)
    |= .request-c-function
        = dispatch-c-function(name!)
    |= .request-method
        = dispatch-method(receiver, name!)
    |= .request-getter
        = dispatch-getter(receiver, name!)
    |= .request-setter
        = dispatch-setter(receiver, name!)
    |= .request-module-getter
        = dispatch-module-getter(name!)
    |= .request-module-setter
        = dispatch-module-setter(name!)
    |= .request-static
        = dispatch-static(receiver, name!)
    |= .request-constructor
        = dispatch-constructor(receiver, other.request-by-name)
= null

────────────────────
+ shape-at CallArgument
    - fill U32

calls[fill]

────────────────────
+ get shape-count Size

calls.length

────────────────────
+ given-at TypeId
    - fill U32

args[fill]

────────────────────
+ do explicit-params
    - params ImmutableArray'TypeId'ArenaBacking

explicit = params

────────────────────
+ do release

scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
scratch.words.rewind(words-mark)
scratch.relations.rewind(relations-mark)
best = null
active = false

────────────────────
_ do open-symbols

` Lists, for each argument that is a case named by its symbol alone, the types it may be a
` case of: first the one a symbol alone names, and then the others in their order. A call is
` ranked with the first of each, and where nothing answers it, again with the next
` combination, as the reference retries it.
symbol-fills.clear()
symbol-starts.clear()
symbol-options.clear()
symbol-choices.clear()
symbol-attempts = 0
symbol-accepted.clear()
symbol-accepted-fills.clear()
. found [TypeId]
for fill in 0 .. < calls.length
    . symbol = calls[fill].symbol
    if !symbol
        continue
    found.clear()
    symbol-owners(types, caller, symbol, found)
    . other = calls[fill].other-symbol
    . kept = 0
    while other && host && kept < found.length
        if symbol-type(types, program, found[kept], other) == invalid-type
            -= found[kept .. < kept + 1]
        else
            kept += 1
    if found.length == 0
        continue
    symbol-fills += fill as U32
    symbol-starts += symbol-options.length as U32
    symbol-options += found[found.length - 1]
    for position in 0 .. < found.length - 1
        symbol-options += found[position]
    symbol-choices += 0
symbol-starts += symbol-options.length as U32

────────────────────
_ do next-symbols Bool

` Moves to the next combination of types for the arguments that are symbols, and says whether
` there is one to rank the call with. Nothing is left of the ranking before.
if best || partial || symbol-fills.length == 0 || symbol-attempts >= 64
    = false
symbol-attempts += 1
. position = 0
while position < symbol-choices.length
    symbol-choices[position] += 1
    if symbol-choices[position] < symbol-starts[position + 1] - symbol-starts[position]
        break
    symbol-choices[position] = 0
    position += 1
if position == symbol-choices.length
    = false
incumbent.clear()
incumbent-variadic = false
incumbent-params.clear()
is-partial = false
ambiguous-constructor = false
ambiguous-static = false
ambiguous-extension = false
conflicting = false
= true

────────────────────
_ do note-symbol-owners
    - fills ImmutableArray'U32'ArenaBacking
    - declared ImmutableArray'TypeId'ArenaBacking

` Notes, for each argument that is a case named by its symbol alone, the types it may be a case
` of that a candidate's parameters take, optional or not, as the reference notes them for each
` candidate the arguments fit as it ranks the call with the type a symbol alone names.
if !facts.traces-lint || symbol-attempts != 0
    =
for position in 0 .. < fills.length
    if position >= declared.length
        break
    if fills[position] < calls.length && calls[fills[position]].other-symbol
        continue
    . owner = symbol-option(fills[position], types.optional-inner(declared[position]))
    if owner == no-type
        continue
    . noted = false
    for offset in 0 .. < symbol-accepted.length
        if symbol-accepted-fills[offset] == fills[position] && symbol-accepted[offset] == owner
            noted = true
    if !noted
        symbol-accepted += owner
        symbol-accepted-fills += fills[position]

────────────────────
_ do symbol-option TypeId
    - fill U32
    - type TypeId

` A type an argument that is a case named by its symbol alone may be a case of, where it is
` `type`, or no type.
for position in 0 .. < symbol-fills.length
    if symbol-fills[position] == fill
        for option in symbol-starts[position] .. < symbol-starts[position + 1]
            if symbol-options[option] == type
                = type
= no-type

────────────────────
+ do symbol-owners-noted
    - hit Hit
    - noted [CaseOwnerNote]

` Adds to `noted` the types candidates took each argument that is a case named by its symbol
` alone as a case of, where they took it as one of more than one, with whether the one `hit`
` takes is that type, as the reference traces such a call it ranked with the type a symbol alone
` names. Nothing is noted for an argument the hit takes as a case of none of them.
if symbol-attempts != 0
    =
for position in 0 .. < hit.fills.length
    if position >= hit.args.length
        break
    . fill = hit.fills[position]
    . chosen = symbol-option(fill, types.optional-inner(hit.args[position]))
    . count = 0
    for offset in 0 .. < symbol-accepted.length
        if symbol-accepted-fills[offset] == fill
            count += 1
    if chosen == no-type || count < 2
        continue
    for offset in 0 .. < symbol-accepted.length
        if symbol-accepted-fills[offset] == fill
            . owner = symbol-accepted[offset]
            noted += CaseOwnerNote(fill, calls[fill].symbol!, owner, owner == chosen)

────────────────────
_ do symbol-owner TypeId
    - fill U32

` The type an argument that is a symbol is ranked as a case of, or no type for one the call
` lists no types for.
for position in 0 .. < symbol-fills.length
    if symbol-fills[position] == fill
        = symbol-options[symbol-starts[position] + symbol-choices[position]]
= no-type

────────────────────
+ do dispatch-function Hit?
    - receiver TypeId
    - name Atom

note-request(.request-function, receiver, name)
=? best if recall()
open-symbols()
rank-functions(receiver, name)
while next-symbols()
    rank-functions(receiver, name)
remember()
= best

────────────────────
_ do rank-functions
    - receiver TypeId
    - name Atom

if receiver != no-type
    rank-methods(receiver, name, .function-decl)
rank-module-functions(name, .function-decl)

────────────────────
_ do rank-module-functions
    - name Atom
    - kind DeclKind

. ordered = scratch.words.mark
for candidate in program.lookup(caller, name)
    scratch.words.push(candidate.module)
    scratch.words.push(candidate.decl)
. end = scratch.words.mark
. position = ordered
while position < end
    . module = scratch.words[position]
    . run-end = position
    while run-end < end && scratch.words[run-end] == module
        run-end += 2
    . cursor = run-end
    while cursor > position
        cursor -= 2
        rank-module-function(module, scratch.words[cursor + 1], kind)
    position = run-end

────────────────────
_ do rank-module-function
    - module ModuleId
    - decl DeclId
    - kind DeclKind

. target = program.modules[module]
if target.name.ends-with(".h") != c-only
    =
do match? target.decls[decl]
    | .decl-function(fn)
        if fn.owner == 0 && fn.kind == kind && visible-from(module, fn.access)
            accept(rank-function(module, decl, no-type, no-type-arguments(types)))

────────────────────
_ visible-from Bool
    - module ModuleId
    - access Access

` Whether a declaration of a module is visible to the caller, as `reaches-access` says.
program.reaches-access(caller, module, access)

────────────────────
+ do dispatch-c-function Hit?
    - name Atom

c-only = true
. hit = dispatch-function(no-type, name)
c-only = false
request = .request-c-function
= hit

────────────────────
+ do dispatch-method Hit?
    - receiver TypeId
    - name Atom

note-request(.request-method, receiver, name)
=? best if recall()
open-symbols()
rank-methods(receiver, name, .function-decl)
while next-symbols()
    rank-methods(receiver, name, .function-decl)
remember()
= best

────────────────────
+ do dispatch-getter Hit?
    - receiver TypeId
    - name Atom

note-request(.request-getter, receiver, name)
=? best if recall()
rank-methods(receiver, name, .getter-decl)
remember()
= best

────────────────────
+ do dispatch-setter Hit?
    - receiver TypeId
    - name Atom

note-request(.request-setter, receiver, name)
=? best if recall()
rank-methods(receiver, name, .setter-decl)
remember()
= best

────────────────────
+ do dispatch-module-getter Hit?
    - name Atom

note-request(.request-module-getter, no-type, name)
=? best if recall()
rank-module-functions(name, .getter-decl)
remember()
= best

────────────────────
+ do dispatch-module-setter Hit?
    - name Atom

note-request(.request-module-setter, no-type, name)
=? best if recall()
rank-module-functions(name, .setter-decl)
remember()
= best

────────────────────
+ do dispatch-static Hit?
    - owner TypeId
    - name Atom

note-request(.request-static, owner, name)
kind = .rank-static
=? best if recall()
types.complete(owner)
. ref = DeclRef(U32.max, U32.max)
do match? types.rows[owner]
    | .type-class(row)
        ref = DeclRef(row.module, row.decl)
if ref.module == U32.max
    = null
. target = program.modules[ref.module]
do match? target.decls[ref.decl]
    | .decl-class(row)
        open-symbols()
        rank-statics(ref.module, target, row.members, name, owner)
        while next-symbols()
            rank-statics(ref.module, target, row.members, name, owner)
        remember()
= best

────────────────────
+ do dispatch-constructor Hit?
    - receiver TypeId
    - by-name Bool = true

` The constructor a call of a type names. Where the type's parameters are not known and the
` call holds nothing, it is the default constructor, unless the type writes one of its own.
` Where the call gives type parameters of the constructor's own, only a constructor written
` with its own can be named. A type of alternatives, as `Int || String`, is made only from a
` value of one of them.
note-request(.request-constructor, receiver, null)
request-by-name = by-name
kind = .rank-constructor
pattern-self = by-name
=? best if recall()
. first = if args.length != 0 then args[0] else no-type
constructor-candidates(relations, receiver, calls, candidates, caller, first, sole-field(receiver))
. written = false
. alternatives = types.completions[receiver].intrinsic == .or
for candidate in candidates
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-function(fn)
            if fn.kind == .constructor-decl
                written = true
for candidate in candidates
    . target = program.modules[candidate.module]
    do match? target.decls[candidate.decl]
        | .decl-function(fn)
            . generic = types.completions[receiver].has-variables
            if explicit.length != 0 && fn.kind != .constructor-decl
                continue
            if fn.kind == .default-constructor-decl && alternatives
                continue
            if fn.kind == .default-constructor-decl && !generic
                accept(constrained(rank-default(candidate.module, candidate.decl, receiver)))
            else if fn.kind == .default-constructor-decl
                . defaulted = with-defaults(receiver)
                if defaulted != no-type
                    accept(constrained(rank-default(candidate.module, candidate.decl, defaulted)))
                else if args.length == 0 && !written
                    . open = rank-default(candidate.module, candidate.decl, receiver)
                    is-partial = true
                    accept(open)
            else if fn.kind == .cast-constructor-decl && !generic
                accept(rank-cast(candidate.module, candidate.decl, receiver))
            else if fn.kind == .tuple-constructor-decl
                accept(rank-tuple(candidate.module, candidate.decl, receiver))
            else if fn.kind == .constructor-decl || is-table-constructor-kind(fn.kind)
                . plain = no-type-arguments(types)
                . ranked = rank-function(candidate.module, candidate.decl, receiver, plain)
                accept(constrained(ranked))
        | .decl-fromverter
            if explicit.length == 0
                accept(rank-fromverter(candidate.module, candidate.decl, receiver))
remember()
= best

────────────────────
_ do sole-field TypeId
    - receiver TypeId

` The type of the one field a tuple or a struct called with one value stores, worked out
` where the type does not write it, which tells whether the value is the field or one to
` convert; no type for any other call.
. kind = types.completions[receiver].intrinsic
if args.length != 1 || (kind != .tuple && kind != .struct)
    = no-type
. found TypeProperty? = null
. count = 0u32
for fact in types.properties[types.completions[receiver].properties]
    if fact.slot != U32.max
        found = fact
        count += 1
if count != 1 || found!.type != no-type
    = no-type
= field-type(found!, receiver)

────────────────────
_ do constrained Hit?
    - hit Hit?

` A constructor constructs only a class whose parameters meet the constraints the class
` declares for them.
if !hit
    = null
. receiver = hit.receiver
if receiver == no-type || types.completions[receiver].has-variables
    = hit
do match? types.rows[receiver]
    | .type-class(row)
        . target = program.modules[row.module]
        do match? target.decls[row.decl]
            | .decl-class(class)
                if class.param-constraints.count == 0
                    = hit
                . owner Index = row.module
                . env = types.class-env-for(row.module, row.decl, row.args, receiver)
                . holds = true
                for id in target.tree.children[class.param-constraints]
                    do match? target.tree.nodes[id]
                        | .node-param-constraint(constraint)
                            . left = types.evaluate-type
                                - owner as ModuleId
                                - target.tree
                                - constraint.left
                                - env
                            . right = types.evaluate-type
                                - owner as ModuleId
                                - target.tree
                                - constraint.right
                                - env
                            if left != invalid-type && right != invalid-type
