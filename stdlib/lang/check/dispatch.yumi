+ caller ModuleId
_ scratch TypingScratch
+ host Demander? = null
+ conversions Conversions? = null
+ best Hit? = null
+ partial Hit? = null
+ bound-call Bool
+ row-case TypeId = no-type
+ texts Bool
+ asked Bool
_ kind RankKind = .rank-plain
_ extension-ranking Bool
_ extension-level TypeId = no-type
_ is-partial Bool
_ ambiguous-constructor Bool
_ ambiguous-static Bool
_ ambiguous-extension Bool
_ conflicting Bool
_ c-only Bool
_ pattern-self Bool
_ adapted TypeId = no-type
_ tail-default TypeId = no-type
_ lenders [TypeId]
+ active Bool
+ missing-module ModuleId = 0
+ missing-site SyntaxId = 0
_ args ImmutableArray'TypeId'ArenaBacking
_ ranked-shapes ImmutableArray'CallArgument'ArenaBacking
_ explicit ImmutableArray'TypeId'ArenaBacking
+ request DispatchRequest = .request-none
+ request-receiver TypeId = no-type
+ request-name Atom? = null
_ request-by-name Bool
_ incumbent [Relation]
_ incumbent-variadic Bool
_ incumbent-params [TypeId]
_ ranked [Relation]
_ ranked-params [TypeId]
_ items-mark ScratchMark = 0
_ names-mark ScratchMark = 0
_ words-mark ScratchMark = 0
_ relations-mark ScratchMark = 0
_ calls [CallArgument]
_ slots [U32]
