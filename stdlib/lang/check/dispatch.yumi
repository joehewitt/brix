────────────────────
_ do rank-defaults
    - module ModuleId
    - target Module
    - members RowRange'DeclId
    - name Atom
    - receiver TypeId
    - kind DeclKind

if members.count == 0
    =
. place = target.first-member(members, name)
while place != no-member
    . member = target.member-pool[place]
    place = target.member-links[place]
    do match? target.decls[member]
        | .decl-function(row)
            . named = row.name && row.name == name
            if named && row.kind == kind && !row.is-static && row.body != 0
                accept(rank-function(module, member, receiver, no-type-arguments(types)))

────────────────────
_ do rank-parent-interfaces
    - level TypeId
    - receiver TypeId
    - name Atom
    - kind DeclKind

` An interface answers the methods of the interfaces it extends, such as `<-read` on an
` Iterable through Readable.
for parent in types.interfaces-of(level)
    rank-parent-interfaces(parent, receiver, name, kind)
    rank-methods-at(parent, receiver, name, kind)

────────────────────
_ do rank-methods-at
    - level TypeId
    - receiver TypeId
    - name Atom
    - kind DeclKind

. ref = DeclRef(U32.max, U32.max)
do match? types.rows[level]
    | .type-class(row)
        ref = DeclRef(row.module, row.decl)
if ref.module == U32.max
    =
. held = types.completions[receiver].intrinsic
rank-extensions(level, name, kind, if intrinsic-is-class(held) then level else receiver)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(row)
        . self = if intrinsic-is-class(held) then level else receiver
        rank-members(ref.module, owner, row.members, name, self, no-type-arguments(types), kind)

────────────────────
_ do rank-extensions
    - level TypeId
    - name Atom
    - kind DeclKind
    - receiver TypeId = no-type

` Ranks the members extensions add to a type. A value that is not an object of a class, such
` as a tuple, a struct or a number, is the receiver of what an extension of its base adds, as it
` is of what its base declares.
