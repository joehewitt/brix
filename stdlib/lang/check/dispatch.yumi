= false

────────────────────
+ do delegates-to Bool
    - receiver TypeId
    - held TypeId

` Whether a class answers for a type through a property it delegates to, directly, through
` that property's own delegates, or through a base class's. A property of a class derived
` from the type answers for it too.
. current = receiver
while current != no-type
    for offset in 0 .. < types.delegates-of(current).length / 2
        . delegate = delegate-type(current, offset)
        if answers-as(delegate, held)
            = true
        if lends(current, delegate)
            . answers = delegates-to(delegate, held)
            lent()
            if answers
