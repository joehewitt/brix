_ do field-has-default Bool
    - module ModuleId
    - decl DeclId
    - name Atom

. owner-module = program.modules[module]
. members = RowRange'DeclId()
do match? owner-module.decls[decl]
    | .decl-class(row)
        members = row.members
. place = owner-module.first-member(members, name)
while place != no-member
    . member = owner-module.member-pool[place]
    place = owner-module.member-links[place]
    do match? owner-module.decls[member]
        | .decl-property(row)
