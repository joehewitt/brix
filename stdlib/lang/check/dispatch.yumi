do match? target.decls[owner]
    | .decl-extension(row)
        . env = extension-env(types, module, owner)
        for offset in 0 .. < names.length
            env = types.env-bind(env, names[offset], params[offset])
        . extended = types.evaluate-type(module, target.tree, row.receiver, env)
