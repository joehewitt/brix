────────────────────
_ do with-defaults TypeId
    - receiver TypeId

` A class named without its parameters, each of which its declaration assigns a type, is the
` class of those types.
do match? types.rows[receiver]
    | .type-class(row)
        . mark = scratch.types.mark
        for position in 0 .. < row.args.count
            . arg = types.child-type(row.args, position)
            if types.completions[arg].has-variables
                break
            scratch.types.push(arg)
        . filled = types.class-with-args(row.module, row.decl, mark)
        if filled != invalid-type && !types.completions[filled].has-variables
            = filled
