    - module ModuleId
    - decl DeclId
    - receiver TypeId
    - names ImmutableArray'Atom'ArenaBacking
    - params ImmutableArray'TypeId'ArenaBacking

if receiver == no-type || !types.completions[receiver].has-variables
    = receiver
. target = program.modules[module]
. owner = 0u32
do match? target.decls[decl]
    | .decl-function(fn)
        if is-constructor-kind(fn.kind)
            owner = fn.owner
if owner == 0
