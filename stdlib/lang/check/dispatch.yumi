_ do rank-members
    - module ModuleId
    - target Module
    - members RowRange'DeclId
    - name Atom
    - receiver TypeId
    - bindings TypeArguments
    - kind DeclKind

if members.count == 0
    =
. place = target.first-member(members, name)
while place != no-member
    . member = target.member-pool[place]
    place = target.member-links[place]
    do match? target.decls[member]
        | .decl-function(row)
            . named = row.name && row.name == name
            if named && row.kind == kind && !row.is-static && visible-from(module, row.access)
                accept(readdress(rank-function(module, member, receiver, bindings)))


────────────────────
_ do rank-statics
    - module ModuleId
    - target Module
    - members RowRange'DeclId
    - name Atom
    - owner TypeId

if members.count == 0
    =
. place = target.first-member(members, name)
while place != no-member
    . member = target.member-pool[place]
    place = target.member-links[place]
    do match? target.decls[member]
        | .decl-function(row)
            . named = row.name && row.name == name
            . open = visible-from(module, row.access)
