        | .type-class(row)
            for extension in program.extensions-for(caller, row.module, row.decl)
                . matched = relations.match-extension(extension.module, extension.decl, level)
                if matched
                    types.env-release(matched.env)
                    add-named-functions(extension.module, extension.decl, name, found)
    level = types.base-of(level)
= found

────────────────────
_ do add-named-functions
    - module ModuleId
    - decl DeclId
    - name Atom
    - found [DeclRef]

. target = program.modules[module]
do match? target.decls[decl]
    | .decl-extension(body)
        if body.members.count != 0
            . place = target.first-member(body.members, name)
            while place != no-member
                . member = target.member-pool[place]
                place = target.member-links[place]
                do match? target.decls[member]
                    | .decl-function(row)
                        if row.name && row.name == name && row.kind == .function-decl
                            found += DeclRef(module, member)

────────────────────
_ do extends-getter Bool
    - module ModuleId
    - decl DeclId
    - level TypeId
    - name Atom

. target = program.modules[module]
do match? target.decls[decl]
    | .decl-extension(body)
        . named = false
        if body.members.count != 0
            . place = target.first-member(body.members, name)
            while place != no-member
                . member = target.member-pool[place]
                place = target.member-links[place]
                do match? target.decls[member]
                    | .decl-function(row)
                        if row.kind == .getter-decl && row.name && row.name == name
