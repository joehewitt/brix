_ do rank-declaration Hit?
    - opened MatchScope
    - env TypeEnv
    - module ModuleId
    - decl DeclId
    - receiver TypeId
    - bindings TypeArguments

. target = program.modules[module]
. variadic-index = U32.max
. constraints = RowRange'SyntaxId()
. assignments = RowRange'SyntaxId()
. specs-start = scratch.words.mark
. owner = 0u32
. declarer = 0u32
. own-params = RowRange'SyntaxId()
do match? target.decls[decl]
    | .decl-function(fn)
