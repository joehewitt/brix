    current = types.base-of(current) ?? no-type
= false

────────────────────
_ do answers-as Bool
    - delegate TypeId
    - held TypeId

` Whether what a property holds answers as a type: it is of that type, or of a class derived
` from it, whose members the type declares.
. current = delegate
while current != no-type && current != invalid-type
    if current == held
        = true
    current = types.base-of(current) ?? no-type
= false

────────────────────
+ do delegate-path Bool
    - receiver TypeId
    - held TypeId
    - places [U32]

` The properties read from a value of a class to reach what answers for it as `held`, as
` `delegates-to` finds it: the place of each is appended in the order they are read.
` Nothing is appended where the class does not answer so.
. current = receiver
while current != no-type
    for offset in 0 .. < types.delegates-of(current).length / 2
        . delegate = delegate-type(current, offset)
        . found = types.property-named(current, types.delegate-name(current, offset))
        if !found || delegate == no-type || delegate == invalid-type
            continue
        . mark = places.length
        places += found as U32
        if answers-as(delegate, held)
            = true
        if lends(current, delegate)
            . reaches = delegate-path(delegate, held, places)
            lent()
            if reaches
