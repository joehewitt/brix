. items-start = scratch.types.mark
. names-mark = scratch.names.mark
. words-start = scratch.words.mark
. relations-start = scratch.relations.mark
. scope = relations.scope-open()
. env = types.env-frame()
. hit = rank-declaration(scope, env, module, decl, receiver, bindings)
types.env-release(env)
relations.scope-release(scope)
if !hit
