_ do env-bindings Size
    - env TypeEnv

. names-start = scratch.names.mark
. count = 0
for position in env.start .. < env.end
    . name = types.env-name(position)
    if !name-in-range(names-start, count, name)
        . type = types.env-lookup(env, name)
        if type
            scratch.names.push(name)
            scratch.types.push(type)
            count += 1
= count

