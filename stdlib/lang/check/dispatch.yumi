    - scope MatchScope
    - env TypeEnv
    - module ModuleId
    - owner DeclId
    - name Atom

. bound = relations.scope-env(scope, env)
. fallback = types.class-param-default(module, owner, name, bound)
types.env-truncate(env)
if !fallback
