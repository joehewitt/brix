= false

────────────────────
_ do infer-params Bool
    - scope MatchScope
    - env TypeEnv
    - fills ImmutableArray'U32'ArenaBacking
    - signature Signature
    - module ModuleId
    - decl DeclId

` Binds a candidate's type parameters from the arguments that fill parameters naming them, one
` parameter at a time. An argument of a function type given a parameter that names one is
` compared once every parameter is evaluated, and a closure or a binding last of those, since
` what it is given depends on the others, wherever it is written among the arguments. A number
` written with no suffix binds a parameter only after the other arguments, an integer after a
` float, and one given for a parameter that is the type they bound holds it as that type. A tuple
` written with such integers among its items binds by its other items where those bind a type
` that holds the integers.
. empty U32 = ArgumentFill.fill-empty
. variadic U32 = ArgumentFill.fill-variadic
for position in 0 .. < fills.length
    . fill = fills[position]
    if fill != empty && fill != variadic && position < signature.args.length
        . expected = signature.args[position]
        for name in signature.params
            if mentions-variable(expected, name)
                relations.scope-link(scope, name, position as U32)
. delayed-start = scratch.words.mark
for name in signature.params
    . links = relations.scope-links(scope, name)
    for pass in 0u32 .. < 3
        for linked in 0 .. < fills.length
            if (links /and/ (1u64 /lshift/ (linked as U64))) != 0 && in-pass
                . given = inferred-given(fills, linked, module, decl)
                . expected = signature.args[linked]
                if should-delay-compare(types, given, expected)
                    scratch.words.push(linked as U32)
                else if !fill-holds && !places-hold && !legal-in-scope(given, expected, scope)
                    = false
                .. fill-holds = holds-literal-fill(fills, linked, expected, name, scope)
                .. places-hold = holds-literal-places(fills, linked, given, expected, scope)
            .. in-pass = literal-pass(fills, linked) == pass
    relations.scope-clear-links(scope, name)
    if !relations.scope-defers(scope, name)
        if !relations.scope-evaluate(scope, name, env, null)
            = false
for name in signature.params
    if relations.scope-has-assignment(scope, name)
        if !relations.scope-evaluate(scope, name, env, null)
            = false
. fitted [Size]
for delayed in scratch.words.since(delayed-start)
    . linked Size = delayed
    . given = inferred-given(fills, linked, module, decl)
    . expected = signature.args[linked]
    if is-callable-value(scope, given, expected)
        fitted += linked
    else if !legal-in-scope(given, expected, scope)
        = false
scratch.words.rewind(delayed-start)
for linked in fitted
    if !closure-fits(inferred-given(fills, linked, module, decl), signature.args[linked], scope)
        = false
= true

────────────────────
_ literal-fill SyntaxId
    - fills ImmutableArray'U32'ArenaBacking
    - position Size

` The integer written with no suffix that fills a parameter, or none.
|? fill == empty || fill == variadic
    0
??
    calls[fill].literal

.. fill = fills[position]
.. empty U32 = ArgumentFill.fill-empty
.. variadic U32 = ArgumentFill.fill-variadic

────────────────────
_ literal-pass U32
    - fills ImmutableArray'U32'ArenaBacking
    - position Size

` When an argument binds the parameters it fills: first where it is no number written with no
` suffix, then where it is one but no integer, and last where it is an integer.
|? literal == 0
    0
|? conversions != null && conversions.is-plain-integer(literal)
    2
??
    1

.. literal = literal-fill(fills, position)

────────────────────
_ holds-literal-fill Bool
    - fills ImmutableArray'U32'ArenaBacking
    - position Size
    - expected TypeId
    - name Atom
    - scope MatchScope

` Whether an integer written with no suffix fills a parameter that is a type parameter the
` other arguments bound to a type that holds it.
|? literal == 0 || conversions == null || variable-of(expected) != name
    false
??
    bound != null && !is-variable-row(types, bound) && conversions!.fitting-literal(literal, bound)

.. literal = literal-fill(fills, position)
.. bound = relations.scope-lookup(scope, name)

────────────────────
_ holds-literal-places Bool
    - fills ImmutableArray'U32'ArenaBacking
    - position Size
    - given TypeId
    - expected TypeId
    - scope MatchScope

` Whether a tuple written with integers with no suffix among its items fills a parameter whose
` type parameters its other items bind to types that hold those integers.
|? loose == no-type || !legal-in-scope(loose, expected, scope)
    false
??
    conversions!.fitting-literal(literal-fill(fills, position), substitute(expected, scope))

.. loose = loose-places(fills, position, given, expected)

────────────────────
_ do loose-places TypeId
    - fills ImmutableArray'U32'ArenaBacking
    - position Size
    - given TypeId
    - expected TypeId

` The tuple a tuple written with integers with no suffix among its items binds type parameters
` by: each such item's place has the type expected there, so only the other items bind them.
. literal = literal-fill(fills, position)
=? no-type if literal == 0 || conversions == null
. fields = RowRange'TypeId()
. names = RowRange'Atom()
do match? types.rows[given]
    | .type-tuple(row)
        fields = row.fields
        names = row.names
=? no-type if fields.count == 0
types.complete(expected)
. wanted-mark = types.scratch.types.mark
push-fields(types, expected)
if types.scratch.types.length - wanted-mark != fields.count
    types.scratch.types.rewind(wanted-mark)
    = no-type
. mark = types.scratch.types.mark
. names-mark = types.scratch.names.mark
. loosened = false
for offset in 0 .. < fields.count
    . plain = conversions!.plain-item(literal, offset)
    loosened = loosened || plain
    types.scratch.types.push(if plain then wanted-field else types.child-type(fields, offset))
        .. wanted-field = types.scratch.types[wanted-mark + offset]
    types.scratch.names.push(types.child-name(names, offset))
. loose = if loosened then types.intern-tuple(mark, names-mark) else no-type
types.scratch.types.rewind(wanted-mark)
types.scratch.names.rewind(names-mark)
= loose

────────────────────
_ variable-of Atom?
    - type TypeId

match? types.rows[type]
    | .type-variable(row)
        row.name

────────────────────
_ do inferred-given TypeId
    - fills ImmutableArray'U32'ArenaBacking
    - position Size
    - module ModuleId
    - decl DeclId

` What an argument a call gives binds type parameters as: its own type, or, for a case named
` by its symbol alone, the type whose case the default of an untyped parameter names by its
` symbol, as the reference reads the symbol against the default, or else the type the
` argument is ranked as a case of.
. fill = fills[position]
if !calls[fill].symbol
    = args[fill]
. target = program.modules[module]
do match? target.decls[decl]
    | .decl-function(fn)
        if position < fn.args.count
            . start Index = fn.args.start
            . shape = target.arg-pool[start + position]
            if shape.type-syntax == 0 && shape.default-syntax != 0
                do match? target.tree.nodes[shape.default-syntax]
                    | .node-symbol(row)
                        . named = symbol-class(types, module, row.name)
                        if named != invalid-type
                            = named
. owner = symbol-owner(fill)
= if owner != no-type then owner else args[fill]

────────────────────
_ do bind-defaults
    - scope MatchScope
    - env TypeEnv
    - module ModuleId
    - decl DeclId
    - receiver TypeId
    - fills ImmutableArray'U32'ArenaBacking
    - signature Signature

` An argument that declares no type and is not given takes the type of its default, typed
` under the type parameters the call has bound. A variadic tail that declares no type, given
` no argument, takes the type of its default, which `tail-default` keeps, and binds the type
` parameter its name declares to it.
if !host
    =
. empty U32 = ArgumentFill.fill-empty
. target = program.modules[module]
do match? target.decls[decl]
    | .decl-function(fn)
        . position = 0
        for shape in target.arg-pool[fn.args]
            . open = position < fills.length && position < signature.args.length
            if open && fills[position] == empty && shape.default-syntax != 0
                . expected = signature.args[position]
                . tail = position as U32 == fn.variadic-index
                . anonymous = untyped-tail && types.completions[expected].has-variables
                    .. untyped-tail = tail && shape.type-syntax == 0
                if anonymous || is-unbound(scope, env, signature, checked-type)
                    . mark = scratch.types.mark
                    for param in signature.params
                        . current = relations.scope-evaluate(scope, param, env, null)
                        scratch.types.push(current ?? invalid-type)
                    . bound = scratch.types.since(mark)
                    . syntax = shape.default-syntax
                    consulted = true
                    . given = host!.default-type(module, decl, receiver, syntax, bound)
                    scratch.types.rewind(mark)
                    if given != no-type && given != invalid-type && anonymous
                        tail-default = given
                        if is-unbound(scope, env, signature, expected)
                            legal-in-scope(given, expected, scope)
                    else if given != no-type && given != invalid-type
                        legal-in-scope(given, expected, scope)
                .. checked-type = if tail then list-item(expected) else expected
            position += 1

────────────────────
_ do is-unbound Bool
    - scope MatchScope
    - env TypeEnv
    - signature Signature
    - expected TypeId

` Whether an argument's type is a type parameter the call has not bound yet.
if !is-variable-row(types, expected)
    = false
for offset in 0 .. < signature.params.length
    if signature.variables[offset] == expected
        . current = relations.scope-evaluate(scope, signature.params[offset], env, null)
        = current != null && is-variable-row(types, current)
= false

────────────────────
_ argument-at TypeId
    - fills ImmutableArray'U32'ArenaBacking
    - position Size

args[fills[position]]

────────────────────
+ do fit-callable TypeId?
    - given TypeId
    - expected TypeId
    - scope MatchScope?

` Fits a closure or a binding to a function type, as `as` asks where the relations are asking,
` which the closure's own body is typed without.
. asked = relations.asking
relations.asking = false
. fit = closure-fits(given, expected, scope, asked)
relations.asking = asked
= fit.to if fit

────────────────────
_ do closure-fits Relation?
    - given TypeId
    - expected TypeId
    - scope MatchScope?
    - asked Bool = false

` A closure or a binding fits a function type where it takes each argument the type gives and
` gives what the type returns, each converted unasked as a call converts them, unless asked. A
` filter's condition gives its truth.

types.complete(expected)
. fn = function-row(types, expected)
if fn == no-type
    = null
. args = RowRange'TypeId()
. returns = no-type
. errors = RowRange'TypeId()
do match? types.rows[fn]
    | .type-function(row)
        args = row.args
        returns = row.return-type
        errors = row.errors
. args-start = scratch.types.mark
for offset in 0 .. < args.count
    . open = types.child-type(args, offset)
    . arg = substitute(open, scope)
    . unbound = types.completions[arg].has-variables
    if unbound || types.completions[given].intrinsic == .closure
        . declared = declared-argument(types, given, offset)
        if declared != no-type
            if unbound
                legal-in-scope(declared, arg, scope)
            else if !asked && !relations.implicit(relations.compare(arg, declared, false, false, null, caller))
                scratch.types.rewind(args-start)
                = null
            arg = declared
    if types.completions[arg].has-variables
        scratch.types.rewind(args-start)
        = null
    scratch.types.push(arg)
if !host
    scratch.types.rewind(args-start)
    = null
consulted = true
. returned = invalid-type
. bound = no-instance
if types.completions[given].intrinsic == .binding
    . answered = host.binding-return(given, scratch.types.since(args-start))
    returned = answered.type
    bound = answered.callee
else
    returned = host.lambda-fit(given, scratch.types.since(args-start))
if returned == invalid-type
    scratch.types.rewind(args-start)
    = null
. taken = scratch.types.since(args-start)
if returns != no-type && returns != types.void-type && is-unbound-return(returns, scope)
    returned = host!.whole-answer(given, returned, taken, errors, bound)
if returns != no-type && returns != types.void-type && !is-inference-row(returns)
    . wanted = substitute(returns, scope)
    . open = types.completions[wanted].has-variables
    . binds = scope if open
    . relation = relations.compare
        - returned
        - if open then returns else wanted
        - false
        - false
        - binds
        - caller
    . truth = wanted == types.bool-type && is-filter-condition(types, program, given)
    if !relation-legal(relation) || (!asked && !truth && !relations.implicit(relation))
        scratch.types.rewind(args-start)
        = null
. settled = settle-callable(substitute(expected, scope), returns, returned, args, taken)
scratch.types.rewind(args-start)
= side-cast-relation(given, settled)

────────────────────
_ is-unbound-return Bool
    - returns TypeId
    - scope MatchScope?

` Whether what a function type returns is a parameter nothing has bound: one of the type
` left out where the type is named, or one of the call's still open. Such a parameter takes
` the whole of what a callable answers, its errors too.
is-inference-row(returns) || (variable-return && is-variable-row(types, substitute(returns, scope)))

.. variable-return = is-variable-row(types, returns)

────────────────────
_ do settle-callable TypeId
    - target TypeId
    - returns TypeId
    - returned TypeId
    - args RowRange'TypeId
    - taken ImmutableArray'TypeId'ArenaBacking

` A function type named without all of its parameters takes the open ones from the callable
` it is given: what the callable returns, and the argument types it was typed with.
if !types.completions[target].has-variables
    = target
do match? types.rows[target]
    | .type-class(row)
        . mark = scratch.types.mark
        for position in 0 .. < row.args.count
            . arg = types.child-type(row.args, position)
            . bound = arg
            if is-inference-row(arg) && arg == returns
                bound = returned
            else if is-inference-row(arg)
                for offset in 0 .. < args.count
                    if types.child-type(args, offset) == arg
                        bound = taken[offset]
            scratch.types.push(bound)
        = types.intern-class(row.module, row.decl, mark)
= target

────────────────────
_ do is-callable-value Bool
    - scope MatchScope
    - given TypeId
    - expected TypeId

` A closure or binding fits a parameter of a function type by what it returns for that
` type's arguments. A parameter of any other type takes it as the value it is.
if given >= types.completions.length
    = false
. kind = types.completions[given].intrinsic
if kind != .closure && kind != .binding
    = false
. target = substitute(expected, scope)
types.complete(target)
= function-row(types, target) != no-type

────────────────────
_ is-inference-row Bool
    - id TypeId

match types.rows[id]
    | .type-inference
        true
    ??
        false

────────────────────
_ do substitute TypeId
    - id TypeId
    - scope MatchScope?

if !scope || !types.completions[id].has-variables
    = id
= match types.rows[id]
    | .type-variable(row)
        relations.scope-lookup(scope, row.name) ?? id
    | .type-class(row)
        substitute-class(row.module, row.decl, row.args, scope)
    ??
        id

────────────────────
_ do substitute-class TypeId
    - module ModuleId
    - decl DeclId
    - args RowRange'TypeId
    - scope MatchScope?

. mark = scratch.types.mark
for offset in 0 .. < args.count
    . arg = substitute(types.child-type(args, offset), scope)
    scratch.types.push(arg)
= types.intern-class(module, decl, mark)

────────────────────
_ legal-in-scope Bool
    - given TypeId
    - expected TypeId
    - scope MatchScope?

relation-legal(compare-argument(given, expected, scope))

────────────────────
_ do compare-argument Relation
    - given TypeId
    - expected TypeId
    - scope MatchScope?
    - requested Bool = false

` Relates an argument to what a candidate expects with this ranking fitting the closures the
` argument holds, such as a field of a tuple. A conversion `requested` holds whether or not it
` would be made unasked: one a `~` parameter takes, or one of an optional given only where it is
` present, whose value is related on its own. A C function takes whatever a cast would convert
` to its parameter, as C does, except a number, a `Bool` or a `Char` for a pointer, which it takes
` only when asked.
. previous = relations.callables
relations.callables = this
. relation = relations.compare(given, expected, false, false, scope, caller)
. c-loose = c-only && !addresses-number(given, expected)
. held = if c-loose || asked || requested then relation else relations.implicitly(relation, texts)
relations.callables = previous
= held

────────────────────
_ addresses-number Bool
    - given TypeId
    - expected TypeId

types.completion-of(expected).intrinsic == .cpointer && from != .cpointer && numeric-from

.. from = types.completion-of(given).intrinsic
.. numeric-from = intrinsic-is-numeric(from)

────────────────────
_ do explicit-place Size
    - tree AST
    - own-params RowRange'SyntaxId
    - extended Bool
    - offset Size
    - name Atom

` Which of the parameters written at a call a parameter of the callee takes. They are the
` callee's in order, except that a method of an extension is written only its own, after
` which the extension's are inferred from the receiver.
if !extended
    = offset
. position = 0u32
for child in tree.children[own-params]
    . own = types.type-syntax-name(tree, child)
    if own && own == name
        = position
    position += 1
= Size.max

────────────────────
_ do constraints-hold Bool
    - scope MatchScope
    - module ModuleId
    - declarer DeclId
    - tree AST
    - constraints RowRange'SyntaxId
    - name Atom
    - evaluated TypeId
    - receiver TypeId

` Whether the type chosen for a type parameter meets what the function requires of it. A
` requirement is read where the function is declared: the parameters of its class or
` extension are those of the receiver, `This` is the receiver, and the function's own are
` those of the match.
for id in tree.children[constraints]
    do match? tree.nodes[id]
        | .node-param-constraint(row)
            . left = types.type-syntax-name(tree, row.left)
            if left && left == name
                . frame = owner-env(types, module, declarer)
                . owned = frame
                if declarer != 0 && receiver != no-type
                    . extended = extended-class-env(types, module, declarer, receiver, frame)
                    owned = bind-receiver(types, module, declarer, receiver, extended)
                . scoped = types.env-with-this(relations.scope-env(scope, owned), receiver)
                . right = types.evaluate-type(module, tree, row.right, scoped)
                types.env-release(frame)
                if !meets-constraint(scope, evaluated, right, required-match(row.op))
                    = false
= true

────────────────────
_ do meets-constraint Bool
    - scope MatchScope
    - evaluated TypeId
    - right TypeId
    - required Specificity

= relations.holds-as(relation, required, true)

.. relation = relations.compare(evaluated, right, false, false, scope, caller)

────────────────────
_ mentions-variable Bool
    - id TypeId
    - name Atom

|? !types.completions[id].has-variables
    false
??
    match types.rows[id]
        | .type-variable(row)
            row.name == name
        | .type-class(row)
            range-mentions(row.args, name)
        | .type-tuple(row)
            range-mentions(row.fields, name)
        | .type-struct(row)
            range-mentions(row.fields, name)
        | .type-union(row)
            range-mentions(row.cases, name)
        | .type-named-union(row)
            range-mentions(row.cases, name)
        | .type-function(row)
            function-mentions(row.return-type, row.args, row.errors, name)
        | .type-result(row)
            mentions-variable(row.value, name) || range-mentions(row.errors, name)
        | .type-associated(row)
            mentions-variable(row.owner, name) || range-mentions(row.args, name)
        ??
            false

────────────────────
_ function-mentions Bool
    - returns TypeId
    - args RowRange'TypeId
    - errors RowRange'TypeId
    - name Atom

mentions-variable(returns, name) || range-mentions(args, name) || range-mentions(errors, name)

────────────────────
_ do range-mentions Bool
    - range RowRange'TypeId
    - name Atom

for offset in 0 .. < range.count
    if mentions-variable(types.child-type(range, offset), name)
        = true
= false

────────────────────
_ do rank-slots Bool
    - scope MatchScope
    - generic Bool
    - fills ImmutableArray'U32'ArenaBacking
    - expected ImmutableArray'TypeId'ArenaBacking
    - declared ImmutableArray'TypeId'ArenaBacking
    - specs ImmutableArray'U32'ArenaBacking
    - untyped ImmutableArray'U32'ArenaBacking
    - variadic-index U32
    - tails TailMatch
    - defaults ImmutableArray'U32'ArenaBacking

` Relates every filled slot's argument to its expected type, recording the relation and the
` type the slot settles on, and rejects the candidate as soon as one slot loses to the incumbent.
` A generic candidate's slots relate to what its parameters are bound to, and two that tie
` are told apart by what each declares, with its parameters unbound, as in the reference.
` A parameter with no type written compares its argument to nothing, as in the reference: the
` slot keeps what the candidate chosen so far compared there, and a later candidate that
` writes a type takes the slot whatever its relation.
` A variadic slot ranks as the reference ranks it, which relates one list to the list
` declared. Where every parameter was known before the arguments were looked at, the tail
` is typed as the list declared, and the slot ranks as the same type. Where the list
` declared is known and a parameter is not, the tail is a list of what its arguments unify
` to, and the slot ranks as that list related to the one declared. Where the list was
` inferred from the tail, the slot ranks as the worst of the tail.
. empty U32 = ArgumentFill.fill-empty
. variadic U32 = ArgumentFill.fill-variadic
. is-variadic = variadic-index != U32.max
ranked.clear()
ranked-params.clear()
for position in 0 .. < fills.length
    . fill = fills[position]
    . param = expected[position]
    . compares = position >= untyped.length || untyped[position] == 0
    . open = !generic && param != invalid-type && types.completions[param].has-variables
    if param == invalid-type || (open && (fill == empty || fill == variadic))
        = false
    . relation = same-relation(param)
    if fill == variadic
        if !tails.settled
            for tail in tails.relations
                if tail.rank > relation.rank
                    relation = tail
            if tails.listed >= 0
                relation.rank = tails.listed
    else if fill != empty
        . given = args[fill]
        . shape = calls[fill]
        if given == invalid-type || given == no-type
            = false
        if shape.symbol
            . resolved = symbol-owner(fill)
            if resolved == no-type
                consulted = true
                resolved = symbols-type(types, program, param, shape)
            if resolved == invalid-type
                = false
            relation = relations.compare(resolved, param, false, false, scope, caller)
        else if is-callable-value(scope, given, param)
            . fit = closure-fits(given, param, scope)
            if !fit
                = false
            relation = fit
        else
            . defaulted = position < defaults.length && defaults[position] != 0
            . present = omittable && types.is-optional(given) && !types.is-optional(param)
                .. omittable = shape.is-optional || defaulted
            . literal = has-literal && conversions != null && conversions.fitting-literal(shape.literal, param)
                .. has-literal = shape.literal != 0
            . requested = present || literal || similar-spec
                .. similar-spec = position < specs.length && specs[position] == Specificity.similar
            relation = compare-argument(given, param, scope, requested)
            if present && !relation-legal(compare-argument(given-inner, param, scope))
                = false
            .. given-inner = types.optional-inner(given)
            if relation.kind == .relation-converter
                consulted = true
            . answer = if conversions then conversions.answer-of(relation) else no-type
            if answer != no-type
                relation.to = answer
                relation.unified = answer
        if !relation-legal(relation) || relation.kind == .relation-interface-down-cast
            = false
        if open && types.completions[relation.to].has-variables
            = false
        . specificity = if position < specs.length then specs[position] else 0u32
        . written = shape.literal != 0 && conversions != null && conversions.fitting-literal(shape.literal, param)
        if !meets-specificity(relation, specificity) && !written
            = false
    if compared-fill && !beats-incumbent(position, relation, is-variadic, declared[position])
        = false
    .. compared-fill = fill != empty && compares
    scratch.relations.push(relation)
    if compares
        ranked += relation
        ranked-params += declared[position]
    else
        ranked += if position < incumbent.length then incumbent[position] else uncompared()
        ranked-params += incumbent-declared(position)
    . chosen = param
    . completes = relations.holds-alternatives(param)
    . chooses = open || completes || types.completions[param].intrinsic == .or
    if chooses && fill != empty && fill != variadic
        chosen = relation.to
    . unified = unifies && !(completes && fill != empty && fill != variadic)
        .. unifies = generic && relation.unified != no-type
    . recorded = if unified then relation.unified else chosen
    if fill == variadic && generic && tails.fills.length != 0
        recorded = list-type-of(relation.unified)
    if fill == empty && position as U32 == variadic-index && tail-default != no-type
        recorded = tail-default
    scratch.types.push(recorded)
= true

────────────────────
_ do list-type-of TypeId
    - item TypeId

. mark = scratch.types.mark
scratch.types.push(item)
= types.class-with-args(types.list-decl.module, types.list-decl.decl, mark)

────────────────────
_ meets-specificity Bool
    - relation Relation
    - specificity U32

|? specificity == Specificity.similar
    validate-relation(relation, .similar)
|? specificity == Specificity.exact
    validate-relation(relation, .exact)
??
    true

────────────────────
_ beats-incumbent Bool
    - position Size
    - relation Relation
    - is-variadic Bool
    - declared TypeId

` Whether the relation of a candidate's slot keeps it in the running against the candidate
` chosen so far, as the reference's `matchArg` decides. A candidate with fixed slots takes
` the place of a variadic one where its relation ranks under a converter and narrows
` nothing. Any other is kept where its relation is preferred, and where neither is
` preferred unless it is variadic: of two that tie, the fixed one and the earlier variadic
` one win.
|? position >= incumbent.length
    true
|? !relation-legal(current)
    true
|? incumbent-variadic && !is-variadic && !narrows && below-converter
    true
|? preference != 0
    preference > 0
??
    !is-variadic

.. current = incumbent[position]
.. narrows = relation.kind == .relation-unwrap-cast || relation.kind == .relation-down-cast
.. preference = slot-preference(current, relation, position, declared)
.. below-converter = relation.rank < relation-rank(.relation-converter)

────────────────────
_ do slot-preference I32
    - current Relation
    - relation Relation
    - position Size
    - declared TypeId

` Which of two relations of one argument is preferred, that of the candidate chosen so far
` or a new one: above zero for the new one, under it for the chosen one, in the reference's
` order. A lambda is given to a function type declared before a type parameter. Of two side
` casts of one type, the one that lifts it to a base is. Else the lower rank is. Of two final
` casts of one tuple, the one whose fields are, each field by what the two candidates
` declare for it: `declared` is what the new one declares for the slot.
if relation.from == current.from && is-closure-type(relation.from)
    . chosen = incumbent-declared(position)
    if is-type-variable(chosen) && function-row(types, declared) != no-type
        = 1
    if is-type-variable(declared) && function-row(types, chosen) != no-type
        = -1
. side-pair = relation.kind == .relation-side-cast && current.kind == .relation-side-cast
if side-pair && relation.from == current.from
    . lifts = in-base-chain(types, relation.from, relation.to)
    . current-lifts = in-base-chain(types, current.from, current.to)
    if lifts != current-lifts
        = if lifts then 1 else -1
if relation.rank != current.rank
    = if relation.rank < current.rank then 1 else -1
. final = relation.kind == .relation-final-cast && current.kind == .relation-final-cast
if final && relation.from == current.from
    = relations.tuple-field-preference
        - relation.from
        - current.to
        - relation.to
        - incumbent-declared(position)
        - declared
= 0

────────────────────
_ is-closure-type Bool
    - type TypeId

|? type == no-type
    false
??
    match types.rows[type]
        | .type-closure
            true
        ??
            false

────────────────────
_ is-type-variable Bool
    - type TypeId

|? type == no-type
    false
??
    match types.rows[type]
        | .type-variable
            true
        ??
            false

────────────────────
_ uncompared Relation

Relation
    - .relation-illegal
    - -1i32
    - .convertible
    - no-type
    - no-type
    - no-type
    - U32.max
    - no-type
    - no-ratio()
    - .reason-none

────────────────────
_ incumbent-declared TypeId
    - position Size

` What the candidate chosen so far declares for a slot, with its parameters unbound, where
` its slots were ranked one by one.
if position >= incumbent-params.length then no-type else incumbent-params[position]

────────────────────
_ do rank-tail Size
    - scope MatchScope
    - fills ImmutableArray'U32'ArenaBacking
    - variadic-index U32
    - item TypeId

. count = 0
. index = 0u32
for _ in 0 .. < calls.length
    if index >= variadic-index && !slot-holds(fills, index)
        . given = tail-given(index)
        . literal = calls[index].literal
        . fits = literal != 0 && conversions != null && conversions.fitting-literal(literal, substitute(item, scope))
        . relation = compare-argument(given, item, scope, fits)
        if !relation-legal(relation)
            = Size.max
        scratch.words.push(index)
        scratch.relations.push(relation)
        count += 1
    index += 1
= count

────────────────────
_ do tail-item TypeId
    - fills ImmutableArray'U32'ArenaBacking
    - variadic-index U32

` The one type the arguments of a variadic tail that declares no type unify to, where those
` written as numbers with no suffix join the others place by place, as the items of a list do.
. joined = no-type
. written = true
. index = 0u32
for _ in 0 .. < calls.length
    if index >= variadic-index && !slot-holds(fills, index)
        . given = tail-given(index)
        . literal = calls[index].literal != 0
        if joined == no-type
            joined = given
        else
            . relation = relations.unify(joined, given, caller)
            if relation-legal(relation)
                joined = relation.unified
            else
                . places = relations.joined-places(joined, given)
                =? invalid-type if places == no-type || misplaced
                .. misplaced = !(written || places == joined) || !(literal || places == given)
                joined = places
        written = written && literal
    index += 1
= joined

────────────────────
_ do tail-given TypeId
    - index U32

` What an argument of a variadic tail gives the list, as TypeScript gives it: its value, or
` the tuple of its name and its value where it has a name. With a bullet `•?` it gives what
` it holds where it is present: the value an optional holds, and of the tuple of a key and
` a value, the key and what the value holds.
. given = args[index]
. shape = calls[index]
if shape.is-optional && shape.name
    = key-value-type(if types.is-optional(given) then types.optional-inner(given) else given)
if shape.is-optional
    = present-pair(given)
if shape.name
    = key-value-type(given)
= given

────────────────────
_ do present-pair TypeId
    - pair TypeId

` The tuple of a key and what an optional value after it holds.
if types.intrinsic-of(pair) != .tuple
    = pair
. fields = types.completions[pair].properties
if fields.count != 2
    = pair
. held = types.properties[fields.start + 1].type
if !types.is-optional(held)
    = pair
. mark = scratch.types.mark
. names-mark = scratch.names.mark
scratch.names.push(types.index-atom(0))
scratch.types.push(types.properties[fields.start].type)
scratch.names.push(types.index-atom(1))
scratch.types.push(types.optional-inner(held))
= types.intern-tuple(mark, names-mark)

────────────────────
_ do key-value-type TypeId
    - value TypeId

. mark = scratch.types.mark
. names-mark = scratch.names.mark
scratch.names.push(types.index-atom(0))
scratch.types.push(types.string-type)
scratch.names.push(types.index-atom(1))
scratch.types.push(value)
= types.intern-tuple(mark, names-mark)

────────────────────
_ do slot-holds Bool
    - fills ImmutableArray'U32'ArenaBacking
    - index U32

for fill in fills
    if fill == index
        = true
= false

────────────────────
_ list-item TypeId
    - param TypeId

match types.rows[param]
    | .type-class(row)
        if is-list(row.module, row.decl, row.args.count) then item else invalid
        .. item = types.child-type(row.args, 0)
    ??
        invalid

.. invalid = invalid-type

────────────────────
_ is-list Bool
    - module ModuleId
    - decl DeclId
    - count U32

module == types.list-decl.module && decl == types.list-decl.decl && count >= 1

━━━━━━━━━━━━━━━━━━━━
+ TailMatch is Tuple

+ fills ImmutableArray'U32'ArenaBacking
+ relations ImmutableArray'Relation'ArenaBacking
+ settled Bool
+ listed RelationRank = -1

━━━━━━━━━━━━━━━━━━━━
+ symbols-type TypeId
    - types Types
    - program Program
    - expected TypeId
    - shape CallArgument

if found == invalid-type || !shape.other-symbol then found else symbol-type(types, program, expected, shape.other-symbol)

.. found = symbol-type(types, program, expected, shape.symbol!)

━━━━━━━━━━━━━━━━━━━━
+ do symbol-type TypeId
    - types Types
    - program Program
    - expected TypeId
    - name Atom

` The type a case named by its symbol alone is of where a type is expected of it that has the
` case: the expected type, a union with a case of the name or a class with an enum case of it.
` The invalid type where it has none.
if expected == invalid-type || expected == no-type
    = invalid-type
. completion = types.completion-of(expected)
if completion.intrinsic == .union
    for fact in types.cases[completion.cases]
        if fact.name && fact.name! == name
            = expected
    = invalid-type
if completion.has-enums && enum-case-decl(types, program, expected, name)
    = expected
= invalid-type

━━━━━━━━━━━━━━━━━━━━
+ do contextual-symbol TypeId
    - types Types
    - relations Relations
    - expected TypeId
    - name Atom
    - home ModuleId

` The type a case named by its symbol alone is of where a type is expected of it, as the
` reference settles it: the expected type where it has the case, else the type the name alone
` gives where that converts, else the first other type with the case that converts.
if expected == invalid-type || expected == no-type
    = invalid-type
. target = if types.is-optional(expected) then types.optional-inner(expected) else expected
if symbol-type(types, types.program, target, name) != invalid-type
    = target
. primary = symbol-class(types, home, name)
if primary == invalid-type || primary == target
    = primary
if relation-legal(relations.compare(primary, target, false, false, null, home))
    = primary
. owners [TypeId]
symbol-owners(types, home, name, owners)
for owner in owners
    if owner != primary
        if relation-legal(relations.compare(owner, target, false, false, null, home))
            = owner
= primary

━━━━━━━━━━━━━━━━━━━━
+ do enum-case-decl DeclId?
    - types Types
    - program Program
    - about TypeId
    - name Atom

` The enum case a class declares by a name, or none.
. ref = class-ref(types, about)
if ref.module == U32.max
    = null
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
do match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
. place = owner-module.first-member(members, name)
while place != no-member
    . member = owner-module.member-pool[place]
    place = owner-module.member-links[place]
    do match? owner-module.decls[member]
        | .decl-case(row)
            if row.name && row.name == name
                = member
= null
