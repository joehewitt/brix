(fn-expr + sorted-pairs (list U64)
  (param pairs (list U64))
  ; The pairs in order, each a place in one list above a place in another: sorted by the low word,
  ; then, keeping that order, by the high word, each by counting how many take each place. So the
  ; work is as large as the pairs are many and the places they name.
  (call ordered-by (call ordered-by pairs 0) 32)
)

(fn-do _ ordered-by (list U64)
  (param pairs (list U64))
  (param shift U64)
  (let top Size 0)
  (for (in pair pairs)
    (let place (call word-of pair shift))
    (if (> place top)
      (= top place)
    )
  )
  (let starts (list Size))
  (for (in _ (..< 0 (+ top 2)))
    (+= starts 0)
  )
  (for (in pair pairs)
    (+= ([] starts (+ (call word-of pair shift) 1)) 1)
  )
  (for (in position (..< 1 (. starts length)))
    (+= ([] starts position) ([] starts (- position 1)))
  )
  (let ordered (list U64))
  (for (in _ (..< 0 (. pairs length)))
    (+= ordered 0)
  )
  (for (in pair pairs)
    (let place (call word-of pair shift))
    (= ([] ordered ([] starts place)) pair)
    (+= ([] starts place) 1)
  )
  (return ordered)
)

(fn-expr _ word-of Size
  (param pair U64)
  (param shift U64)
  (as (/and/ (/rshift/ pair shift) 0xffffffff) Size)
)
