(import ./facts)
(import ./instances)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/state-machines)

(type + MachineComposite
  ; The machine of a property of a class merged with the refinements of it: its `pieces`, the
  ; machine none refines first, then each refinement from the base's down to one piece, each typed
  ; for the class that declares it, so that every class below shares it; and their cases. The cases
  ; each piece adds come after those of the pieces before it, so a case has the same place in the
  ; composite of every piece below the one that adds it; among those of one piece, each comes before
  ; those written in it. Each case has the case it is written in, or none at the root, the piece
  ; that writes it, and the node each piece names it at, or none, `pieces.length` to a case in
  ; `nodes`.
  (blank)
  (prop + pieces (list MachineFact))
  (prop + names (list Atom))
  (prop + parents (list U32))
  (prop + owners (list U32))
  (prop + nodes (list SyntaxId))
  (fn-do + This _
    (param merged (list MachineFact))
    (lazy pieces merged)
  )
  (fn-do + case-named U32
    (param name Atom)
    ; The case of a name, or none.
    (for (in place (..< 0 (. names length)))
      (if (== ([] names place) name)
        (return (as place U32))
      )
    )
    (return (. U32 max))
  )
  (fn-expr + node SyntaxId
    (param case U32)
    (param piece U32)
    ; The node a piece names a case at, or none.
    ([] nodes (+ (* (as case Size) (. pieces length)) (as piece Size)))
  )
  (fn-expr + children (list U32)
    (param case U32)
    ; The cases written in a case, or at the root for none, in order.
    (in (as each U32) (..< 0 (. parents length)) (when (== ([] parents each) case)))
  )
  (fn-do + descendants (list U32)
    (param case U32)
    ; The cases written in a case, or at the root for none, and in the cases written there, each
    ; before those written in it.
    (let found (list U32))
    (for (in child (call children case))
      (+= found child)
      (for (in inner (call descendants child))
        (+= found inner)
      )
    )
    (return found)
  )
  (fn-do + path-to (list U32)
    (param case U32)
    ; The cases from the root down to a case, the case last.
    (let found (list U32))
    (let current case)
    (while (!= current (. U32 max))
      (call (. found insert) current 0)
      (= current ([] parents current))
    )
    (return found)
  )
  (fn-do + piece-of U32
    (param instance InstanceId)
    ; The place of the piece an instance types, or none.
    (for (in place (..< 0 (. pieces length)))
      (if (== (. ([] pieces place) instance) instance)
        (return (as place U32))
      )
    )
    (return (. U32 max))
  )
)

(fn-do + compose-machine (? MachineComposite)
  (param program Program)
  (param facts Facts)
  (param machine MachineFact)
  ; The composite of a machine of a property of a class and each machine it refines, up to the one
  ; none refines, which is the machine's last piece; or none where it refines none and none
  ; refines it.
  (if (!= (. machine outer) 0)
    (return null)
  )
  (let pieces (list MachineFact))
  (let current (? MachineFact) machine)
  (while current
    (call (. pieces insert) current 0)
    (= current (only-if (call (. facts machine-of) (. current refined)) (if (!= (. current refined) no-instance))))
  )
  (if (and (== (. pieces length) 1) (not (call refined-by facts machine)))
    (return null)
  )
  (let composite (call MachineComposite pieces))
  (let above (list SyntaxId))
  (for (in piece pieces)
    (+= above (. piece syntax))
  )
  (call add-composite-level program composite (. U32 max) above)
  (call order-by-piece composite)
  (return composite)
)

(fn-do + refined-by Bool
  (param facts Facts)
  (param machine MachineFact)
  ; Whether a machine of a property of a class is refined by another.
  (for (in fact (. facts machines))
    (if (and (== (. fact refined) (. machine instance)) (== (. fact outer) 0))
      (return true)
    )
  )
  (return false)
)

(fn-do _ order-by-piece _
  (param composite MachineComposite)
  ; Places the cases of a composite by the piece that writes them, each piece's in the order they
  ; were found.
  (let count (. composite pieces length))
  (let order (list U32))
  (for (in piece (..< 0 count))
    (for (in place (..< 0 (. composite names length)))
      (if (== ([] (. composite owners) place) (as piece U32))
        (+= order (as place U32))
      )
    )
  )
  (let moved (list U32))
  (for (in _ (..< 0 (. composite names length)))
    (+= moved 0)
  )
  (for (in place (..< 0 (. order length)))
    (= ([] moved (as ([] order place) Size)) (as place U32))
  )
  (let names (list Atom))
  (let parents (list U32))
  (let owners (list U32))
  (let nodes (list SyntaxId))
  (for (in place order)
    (+= names ([] (. composite names) place))
    (let parent ([] (. composite parents) place))
    (+= parents (if-expr (== parent (. U32 max)) (. U32 max) ([] moved (as parent Size))))
    (+= owners ([] (. composite owners) place))
    (for (in piece (..< 0 count))
      (+= nodes ([] (. composite nodes) (+ (* (as place Size) count) piece)))
    )
  )
  (= (. composite names) names)
  (= (. composite parents) parents)
  (= (. composite owners) owners)
  (= (. composite nodes) nodes)
)

(fn-do _ add-composite-level _
  (param program Program)
  (param composite MachineComposite)
  (param parent U32)
  (param above (list SyntaxId))
  ; Adds the cases written in a case, or at the root, by the node each piece names it at: those
  ; the first piece that writes the case writes, then those each piece after it adds, each followed
  ; by the cases written in it.
  (let count (. composite pieces length))
  (let names (list Atom))
  (let owners (list U32))
  (let found (list SyntaxId))
  (for (in piece (..< 0 count))
    (if (== ([] above piece) 0)
      (continue)
    )
    (let tree (. ([] (. program modules) (. ([] (. composite pieces) piece) module)) tree))
    (for (in child (call (. tree child-cases) (call (. tree state-items) (call (. tree state-body) ([] above piece)))))
      (let name (!! (call (. tree state-name) child)))
      (let known (call (. names find) name))
      (if (== known null)
        (+= names name)
        (+= owners (as piece U32))
        (for (in _ (..< 0 count))
          (+= found 0)
        )
        (= ([] found (+ (* (- (. names length) 1) count) piece)) child)
        (else
          (= ([] found (+ (* known count) piece)) child)
        )
      )
    )
  )
  (for (in position (..< 0 (. names length)))
    (let place (as (. composite names length) U32))
    (+= (. composite names) ([] names position))
    (+= (. composite parents) parent)
    (+= (. composite owners) ([] owners position))
    (let below (list SyntaxId))
    (for (in piece (..< 0 count))
      (+= (. composite nodes) ([] found (+ (* position count) piece)))
      (+= below ([] found (+ (* position count) piece)))
    )
    (call add-composite-level program composite place below)
  )
)
