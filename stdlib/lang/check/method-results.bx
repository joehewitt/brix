(import ./error-sets)
(import ./facts)
(import ./instances)
(import ./session)
(import ./signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import /core/arena)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)

(type + MethodProto (is Tuple)
  ; The method an implementation stands in for: an interface's requirement or a base class's
  ; method, with the value and errors its callers expect.
  (blank)
  (prop + label String)
  (prop + kind String)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
  (prop + returns TypeId)
  (prop + errors (of ImmutableArray TypeId ArenaBacking))
)

(fn-do + check-method-result _
  (param session Session)
  (param impl InstanceId)
  (param proto MethodProto)
  (param panics Bool (= false))
  ; An implementation must give what the method it stands in for gives: it cannot end on a
  ; value it does not return where callers expect one, nor raise an error they do not expect.
  ; Where it `panics`, standing in for an interface's function for a value whose type carries
  ; errors of its own, an error it raises is a panic and not checked.
  (let instances (. session instances))
  (let types (. session types))
  (let row ([] (. instances rows) impl))
  (let signature ([] (. instances signatures) impl))
  (let owner ([] (. session program modules) (. row module)))
  (let name "")
  (let site 0u32)
  (match? ([] (. owner decls) (. row decl))
    (case (call .decl-function fn)
      (= site (. fn syntax))
      (if (. fn name)
        (= name (. fn name text))
      )
    )
  )
  (let expects (and (!= (. proto returns) no-type) (!= (. proto returns) (. types void-type))))
  (if (and (!= (. signature unreturned) 0) (== (. signature returns) (. types void-type)) expects)
    (let message (str "Function " name " ends with a value it does not return"))
    (let atom (call (. session program store-atom) message))
    (call (. session facts record-diagnostic) impl (. row module) (. signature unreturned) .stated atom)
    (return)
  )
  (if panics
    (return)
  )
  (let accepted true)
  (let names "")
  (for (in offset (..< 0 (. signature errors count)))
    (let error (call (. instances error-type) impl offset))
    (let fits false)
    (for (in expected (. proto errors))
      (if (call is-subtype types error expected)
        (= fits true)
      )
    )
    (if (not fits)
      (= accepted false)
    )
    (if (!= (. names length) 0)
      (+= names ", ")
    )
    (+= names (call type-short-name types error))
  )
  (if accepted
    (return)
  )
  (let message (str "Function returns error (" names ") but " (. proto kind) " does not"))
  (let atom (call (. session program store-atom) message))
  (call (. session facts record-diagnostic) impl (. row module) site .stated atom)
  (call (. session facts relate-diagnostic) (call (. session program store-atom) (. proto label)) (. proto module) (. proto syntax))
)
