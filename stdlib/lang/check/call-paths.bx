(import ./facts)
(import ./instances)
(import ./session)
(import ./stable-key)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /stream/sort)
(blank)
(prop + no-edge U32 (= (. U32 max)))

(type + CallEdgeKind (is U32)
  (variant edge-call (= 0))
  (variant edge-convert (= 1))
  (variant edge-answer (= 2))
  (variant edge-made (= 3))
  (variant edge-value (= 4))
)

(type + CallEdge (is Tuple)
  ; How one instance reaches another, at a node of the one that reaches it: a call, with the fact
  ; that records it; a conversion that runs a function, with its fact; the answer an interface's
  ; function or a method a class declares again is given by a function that answers for it, at no
  ; node; a nested function, where the function it is written in makes it; or a function that
  ; becomes a value of a function type, where it becomes one.
  (blank)
  (prop + caller InstanceId)
  (prop + callee InstanceId)
  (prop + syntax SyntaxId)
  (prop + kind CallEdgeKind)
  (prop + fact FactId (= no-fact))
)

(type + EdgeStep (is U32)
  (variant step-skip (= 0))
  (variant step-follow (= 1))
  (variant step-reach (= 2))
)

(type _ KeyedEdge (is Tuple)
  (prop + key StableKey)
  (prop + index U32)
)

(fn-expr _ compare-keyed Comparison
  (param left KeyedEdge)
  (param right KeyedEdge)
  (case? (!= (. left key) (. right key))
    (call compare-basic (. left key) (. right key))
  )
  (default
    (call compare-basic (. left index) (. right index))
  )
)

(type + CallPaths
  ; How instances reach one another once typing ends, and the shortest chain from one to another,
  ; found breadth first. The edges are indexed both ways when first asked for, in the order of the
  ; stable keys of the instances they leave, so a chain is the same in any order of typing.
  (blank)
  (prop _ session Session)
  (prop _ indexed _ (= false))
  (prop _ edges (list CallEdge))
  (prop _ out-heads (list U32))
  (prop _ out-links (list U32))
  (prop _ in-heads (list U32))
  (prop _ in-links (list U32))
  (fn-do + This _
    (param session _)
  )
  (fn-do + chain-to (? (list CallEdge))
    (param target InstanceId)
    (param step _)
    ; The shortest chain that ends at an instance, walked back from it. `step` says of each edge
    ; reached whether the walk goes on to the instance it leaves, ends there with the chain, or
    ; leaves it. None where no edge ends the walk.
    (call index)
    (let parent (map InstanceId U32))
    (let queue (list InstanceId))
    (+= queue target)
    (= ([] parent target) no-edge)
    (let next Size 0)
    (while (< next (. queue length))
      (let current ([] queue next))
      (+= next 1)
      (let link ([] in-heads current))
      (while (!= link no-edge)
        (let edge ([] edges link))
        (let chosen EdgeStep (call step edge))
        (if (== chosen .step-reach)
          (return (call forward-chain parent link target))
        )
        (if (and (== chosen .step-follow) (== ([] parent (. edge caller)) null))
          (= ([] parent (. edge caller)) link)
          (+= queue (. edge caller))
        )
        (= link ([] in-links link))
      )
    )
    (return null)
  )
  (fn-do + chain-from (? (list CallEdge))
    (param start InstanceId)
    (param follows _)
    (param reaches _)
    ; The shortest chain from an instance to the first one `reaches` accepts, along the edges
    ; `follows` accepts: empty where the instance itself is accepted, none where no instance is.
    (call index)
    (let parent (map InstanceId U32))
    (let queue (list InstanceId))
    (+= queue start)
    (= ([] parent start) no-edge)
    (let next Size 0)
    (while (< next (. queue length))
      (let current ([] queue next))
      (+= next 1)
      (if (call reaches current)
        (return (call backward-chain parent current start))
      )
      (let link ([] out-heads current))
      (while (!= link no-edge)
        (let edge ([] edges link))
        (if (and (== ([] parent (. edge callee)) null) (call follows edge))
          (= ([] parent (. edge callee)) link)
          (+= queue (. edge callee))
        )
        (= link ([] out-links link))
      )
    )
    (return null)
  )
  (fn-do + edges-into (list CallEdge)
    (param target InstanceId)
    ; The edges that reach an instance, in the order of the stable keys of the instances they leave.
    (call index)
    (let found (list CallEdge))
    (let link ([] in-heads target))
    (while (!= link no-edge)
      (+= found ([] edges link))
      (= link ([] in-links link))
    )
    (return found)
  )
  (fn-do + edges-from (list CallEdge)
    (param source InstanceId)
    (call index)
    (let found (list CallEdge))
    (let link ([] out-heads source))
    (while (!= link no-edge)
      (+= found ([] edges link))
      (= link ([] out-links link))
    )
    (return found)
  )
  (fn-do + names (list String)
    (param chain (list CallEdge))
    (return (call (of List String) (in (call name-of (. each callee)) chain)))
  )
  (fn-do + name-of String
    (param instance InstanceId)
    ; The name a chain shows for an instance: a function's, a method's with its class, a class's
    ; for its constructor, the code of a module for its statements, or the function a nested one
    ; is written in.
    (let row ([] (. session instances rows) instance))
    (let owner-module ([] (. session program modules) (. row module)))
    (return-if "main" (if (== (. owner-module main-decl) (. row decl))))
    (blank)
    (let decls (. owner-module decls))
    (match? ([] decls (. row decl))
      (case (call .decl-function fn)
        (let owner (call class-named decls (. fn owner)))
        (return-if owner (if (and (== (. fn kind) .constructor-decl) (!= (. owner length) 0))))
        (blank)
        (let name (. fn name))
        (if name
          (return-if (str owner "." (. name text)) (if (!= (. owner length) 0)))
          (return (. name text))
        )
        (return-if (str "a function in " (call name-of (. row enclosing))) (if (!= (. row enclosing) no-instance)))
      )
      (case (call .decl-converter converter)
        (return (str "the converter of " (call class-named decls (. converter owner))))
      )
      (case (call .decl-fromverter fromverter)
        (return (str "the fromverter of " (call class-named decls (. fromverter owner))))
      )
    )
    (return "a function")
  )
  (fn-do _ forward-chain (list CallEdge)
    (param parent (map InstanceId U32))
    (param first U32)
    (param target InstanceId)
    (let chain (list CallEdge))
    (+= chain ([] edges first))
    (let cursor (. ([] edges first) callee))
    (while (!= cursor target)
      (let link (?? ([] parent cursor) no-edge))
      (return-if chain (if (== link no-edge)))
      (blank)
      (+= chain ([] edges link))
      (= cursor (. ([] edges link) callee))
    )
    (return chain)
  )
  (fn-do _ backward-chain (list CallEdge)
    (param parent (map InstanceId U32))
    (param end InstanceId)
    (param start InstanceId)
    (let chain (list CallEdge))
    (let cursor end)
    (while (!= cursor start)
      (let link (?? ([] parent cursor) no-edge))
      (return-if chain (if (== link no-edge)))
      (blank)
      (call (. chain insert) ([] edges link) 0)
      (= cursor (. ([] edges link) caller))
    )
    (return chain)
  )
  (fn-do _ index _
    (return-if (if indexed))
    (blank)
    (= indexed true)
    (let instances (. session instances))
    (let facts (. session facts))
    (let found (list CallEdge))
    (for (in position (..< 0 (. facts calls length)))
      (let call ([] (. facts calls) position))
      (if (and (!= (. call callee) no-instance) (!= (. call instance) (. instances dead)))
        (+= found (call CallEdge (. call instance) (. call callee) (. call syntax) .edge-call (as position FactId)))
      )
    )
    (for (in slot (. facts witness-slots))
      (if (and (!= (. slot proto) no-instance) (!= (. slot callee) no-instance))
        (+= found (call CallEdge (. slot proto) (. slot callee) 0 .edge-answer))
      )
    )
    (for (in fact (. facts overrides))
      (if (!= (. fact override) no-instance)
        (+= found (call CallEdge (. fact base) (. fact override) 0 .edge-answer))
      )
    )
    (for (in position (..< 0 (. facts conversions length)))
      (let fact ([] (. facts conversions) position))
      (if (!= (. fact instance) (. instances dead))
        (if (!= (. fact callee) no-instance)
          (+= found
            (call CallEdge
              (block
                (arg (. fact instance))
                (arg (. fact callee))
                (arg (. fact syntax))
                (arg .edge-convert)
                (arg (as position FactId))
              )
            )
          )
        )
        (if (!= (. fact runs) no-instance)
          (+= found (call CallEdge (. fact instance) (. fact runs) (. fact syntax) .edge-value))
        )
      )
    )
    (for (in fact (. facts conversion-parts))
      (if (and (!= (. fact instance) (. instances dead)) (!= (. fact runs) no-instance))
        (+= found (call CallEdge (. fact instance) (. fact runs) (. fact syntax) .edge-value))
      )
    )
    (for (in position (..< 0 (. instances length)))
      (let row ([] (. instances rows) position))
      (let id (as position InstanceId))
      (if (and (!= (. row enclosing) no-instance) (== (. row probe) 0) (!= id (. instances dead)))
        (let made (call made-at id))
        (if (!= made 0)
          (+= found (call CallEdge (. row enclosing) id made .edge-made))
        )
      )
    )
    (let keyed (list KeyedEdge))
    (for (in position (..< 0 (. found length)))
      (+= keyed (call KeyedEdge ([] (. instances stable-keys) (. ([] found position) caller)) (as position U32)))
    )
    (let sorted (call sort keyed (:using compare-keyed)))
    (for (in item sorted)
      (+= edges ([] found (. item index)))
      (+= out-links no-edge)
      (+= in-links no-edge)
    )
    (for (in position (..< 0 (. instances length)))
      (+= out-heads no-edge)
      (+= in-heads no-edge)
    )
    (let position (. edges length))
    (while (> position 0)
      (-= position 1)
      (let edge ([] edges position))
      (= ([] out-links position) ([] out-heads (. edge caller)))
      (= ([] out-heads (. edge caller)) (as position U32))
      (= ([] in-links position) ([] in-heads (. edge callee)))
      (= ([] in-heads (. edge callee)) (as position U32))
    )
  )
  (fn-do _ made-at SyntaxId
    (param instance InstanceId)
    ; Where a nested function is written in the function it is nested in, or none for any other.
    (let row ([] (. session instances rows) instance))
    (match? ([] (. ([] (. session program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return-if (. fn syntax) (if (call is-nested-kind (. fn kind))))
      )
    )
    (return 0)
  )
)

(fn-expr _ class-named String
  (param decls (of ImmutableTable Decl))
  (param owner DeclId)
  (match ([] decls owner)
    (case (call .decl-class owned)
      (. owned name text)
    )
    (default
      ""
    )
  )
)
