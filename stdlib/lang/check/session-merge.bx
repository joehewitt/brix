(import ./binding)
(import ./checker)
(import ./instances)
(import ./peer-ids)
(import ./session)
(import ./stable-key)
(import ./types)
(import ./typing)
(import /core/map)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/row-range)
(import /stream/sort)

(fn-do + merge-sessions _
  (param session Session)
  (param peers (list Session))
  (param pool Worker)
  ; Takes into `session` what `peers`, type passes over the same program, typed: each instance from
  ; the first peer that typed its body, with everything known of it, and each fact no one instance
  ; owns that the session lacks. An instance whose typing changed what a pass cannot take in
  ; (`Instance.unshared`) is taken from none: the session types it again (`queue-unshared`). What a
  ; peer reported of an instance no peer typed is taken from the first peer that reported any. A
  ; default of a parameter that a peer typed where the peer the instance is taken from did not is
  ; typed here. Whatever no peer typed is left for the session to type, as it types anything left in
  ; its queue. Nor is one taken that typed a section of a class otherwise than the plans of every
  ; peer together type it, or that was written in one that did (`stale-sections`), nor one typed only
  ; with the one it is written in (`Instance.with-enclosing`) from a peer that one is not taken from.
  (let typed (call (of Map StableKey Bool)))
  (for (in peer peers)
    (let rows (. peer instances rows))
    (for (in id (..< 0 (. rows length)))
      (if (call is-typed ([] rows id))
        (= ([] typed ([] (. peer instances stable-keys) id)) true)
      )
    )
  )
  (let names (list PeerNames))
  (for (in peer peers)
    (+= names (call PeerNames (. peer types) (. peer instances)))
  )
  (let stale (call stale-sections peers))
  (let owners (call (of Map StableKey Bool)))
  (let owned-by (list (list Bool)))
  (let node-count Size 0)
  (for (in position (..< 0 (. peers length)))
    (let peer ([] peers position))
    (let owned (list Bool))
    (let rows (. peer instances rows))
    (for (in id (..< 0 (. rows length)))
      (let key ([] (. peer instances stable-keys) id))
      (let outer (. ([] rows id) enclosing))
      (let beside
        (scope (or (not (. ([] rows id) with-enclosing)) owned-outer)
          (lazy owned-outer (and (!= outer no-instance) (< (as outer Size) (. owned length)) ([] owned outer)))
        )
      )
      (let open
        (scope (and shareable (not ([] ([] stale position) id)) beside (== ([] owners key) null))
          (lazy shareable (and (call is-typed ([] rows id)) (not (. ([] rows id) unshared))))
        )
      )
      (let takes (and open (call (. ([] names position) instance-named) (as id InstanceId))))
      (if takes
        (= ([] owners key) true)
        (if (!= (. ([] rows id) node-start) (. U32 max))
          (+= node-count (. ([] rows id) subtree count))
        )
      )
      (+= owned takes)
    )
    (+= owned-by owned)
  )
  (let taken (list PeerIds))
  (call (. session bindings begin-taking))
  (for (in position (..< 0 (. peers length)))
    (let peer ([] peers position))
    (let ids
      (call PeerIds
        (block
          (arg (. session types))
          (arg (. session instances))
          (arg (. session bindings))
          (arg (. peer types))
          (arg (. peer instances))
          (arg (. peer bindings))
          (arg ([] owned-by position))
        )
      )
    )
    (for (in id (..< 0 (. peer bindings bindings length)))
      (call (. ids binding) (as id BindingId))
    )
    (+= taken ids)
  )
  (call absorb-query-targets session peers taken names)
  (call (. session bindings start-copying) pool)
  (call (. session facts start-copying-nodes) pool node-count)
  (for (in position (..< 0 (. peers length)))
    (call absorb-peer session ([] peers position) ([] taken position) ([] names position))
  )
  (call (. session facts end-copying-nodes))
  (call (. session bindings end-taking))
  (call queue-unshared session peers taken names owners)
  (call absorb-untyped session peers taken typed)
  (call type-defaults session peers taken names)
)

(fn-do _ stale-sections (list (list Bool))
  (param peers (list Session))
  ; For each peer, which of its instances typed a section of a class as run from tables where the
  ; plans of every peer together subscribe it, or as a subscription where they run it from tables
  ; and subscribe it nowhere (`Facts.lowers-only`), and which were written in one that did. A pass
  ; types such a section as the plans it holds when it is typed say, and those of one peer lack
  ; what the others planned.
  (let lowered (call (of Map StableKey Bool)))
  (let subscribed (call (of Map StableKey Bool)))
  (for (in peer peers)
    (for (in row (. peer facts lowered-handlers))
      (= ([] lowered (call section-key peer (. row level) (. row module) (. row syntax))) true)
    )
    (for (in row (. peer facts subscribed-sections))
      (= ([] subscribed (call section-key peer (. row level) (. row module) (. row syntax))) true)
    )
  )
  (let stale (list (list Bool)))
  (for (in peer peers)
    (let rows (. peer instances rows))
    (let marked (list Bool))
    (for (in _ (..< 0 (. rows length)))
      (+= marked false)
    )
    (for (in row (. peer facts typed-sections))
      (let key (call section-key peer (. row level) (. row module) (. row syntax)))
      (let planned (and (!= ([] lowered key) null) (== ([] subscribed key) null)))
      (if (!= (. row lowered) planned)
        (probe-count typing.stale-sections)
        (= ([] marked (. row instance)) true)
      )
    )
    (for (in id (..< 0 (. rows length)))
      (let outer (. ([] rows id) enclosing))
      (while (and (!= outer no-instance) (not ([] marked id)))
        (= ([] marked id) ([] marked outer))
        (= outer (. ([] rows outer) enclosing))
      )
    )
    (+= stale marked)
  )
  (return stale)
)

(fn-expr _ section-key StableKey
  (param peer Session)
  (param level TypeId)
  (param module ModuleId)
  (param syntax SyntaxId)
  ; The key of a section of a class typed for `level`, the same in every peer.
  (call mixed (call mixed (call (. peer types key-of) level) module) syntax)
)

(fn-do _ absorb-query-targets _
  (param session Session)
  (param peers (list Session))
  (param taken (list PeerIds))
  (param names (list PeerNames))
  ; Takes in each class a peer numbered as the target of descendant queries, in the order of their
  ; stable keys, before the session types anything again.
  (let found (call (of Map StableKey TypeId)))
  (for (in position (..< 0 (. peers length)))
    (for (in target (. ([] peers position) facts query-targets))
      (throw (call Panic "A target of descendant queries of another type pass cannot be named here") (if (not (call (. ([] names position) type-named) target))))
      (blank)
      (let type (call (. ([] taken position) type) target))
      (let key (call (. session types key-of) type))
      (if (and (== ([] found key) null) (== (call (. session facts query-targets find) type) null))
        (= ([] found key) type)
      )
    )
  )
  (let keys (list StableKey))
  (for (in (tuple key _) found)
    (+= keys key)
  )
  (let sorted (call sort keys))
  (for (in key sorted)
    (+= (. session facts query-targets) (!! ([] found key)))
  )
)

(fn-do _ queue-unshared _
  (param session Session)
  (param peers (list Session))
  (param taken (list PeerIds))
  (param names (list PeerNames))
  (param owners (of Map StableKey Bool))
  ; Queues here each instance a peer typed and none is taken from, as its typing changed what a pass
  ; cannot take in, for the session to type again, in the order of their stable keys, which is the
  ; same whichever peers typed them. One written in another is typed again in the run of that one
  ; (`Checker.run`), or else once that one is typed (`Instances.written-in`), and one typed on trial
  ; where it is tried. The value of a property or of a rule a root applies, and a rule of a class,
  ; are typed again where first read, as a pass alone types them, or else once nothing is left to
  ; type (`Instances.typed-on-read`): what a rule of a class does depends on what typing its class
  ; planned before (`plan-event-handlers`).
  (let found (call (of Map StableKey U64)))
  (let written (call (of Map StableKey U64)))
  (let read (call (of Map StableKey U64)))
  (for (in position (..< 0 (. peers length)))
    (let peer ([] peers position))
    (let rows (. peer instances rows))
    (for (in id (..< 0 (. rows length)))
      (let key ([] (. peer instances stable-keys) id))
      (let open (and (call is-typed ([] rows id)) (== ([] owners key) null) (== (. ([] rows id) probe) 0)))
      (if (and open (call (. ([] names position) instance-named) (as id InstanceId)))
        (let place (/or/ (/lshift/ (as position U64) 32) (as id U64)))
        (let on-read (or (!= (. ([] rows id) initializer) 0) (!= (. ([] rows id) root-values) 0)))
        (if (!= (. ([] rows id) enclosing) no-instance)
          (if (== ([] written key) null)
            (= ([] written key) place)
          )
          (else-if on-read
            (if (== ([] read key) null)
              (= ([] read key) place)
            )
          )
          (else-if (== ([] found key) null)
            (= ([] found key) place)
          )
        )
      )
    )
  )
  (for (in key (call sorted-keys found))
    (probe-count typing.unshared)
    (call (. session instances queue) (call peer-instance taken (!! ([] found key))))
  )
  (for (in key (call sorted-keys written))
    (probe-count typing.unshared-written)
    (+= (. session instances written-in) (call peer-instance taken (!! ([] written key))))
  )
  (for (in key (call sorted-keys read))
    (probe-count typing.unshared-read)
    (+= (. session instances typed-on-read) (call peer-instance taken (!! ([] read key))))
  )
)

(fn-do _ sorted-keys (list StableKey)
  (param places (of Map StableKey U64))
  (let keys (list StableKey))
  (for (in (tuple key _) places)
    (+= keys key)
  )
  (return (call sort keys))
)

(fn-do _ peer-instance InstanceId
  (param taken (list PeerIds))
  (param place U64)
  ; The instance here that is the instance of a peer a place names: the peer in its high bits and
  ; the peer's instance in its low bits.
  (return (call (. ([] taken (as (/rshift/ place 32) Index)) instance) (as (/and/ place 0xffffffff) InstanceId)))
)

(fn-expr _ is-typed Bool
  (param row Instance)
  ; Whether a pass typed an instance's body, to the end or failing, rather than taking it in.
  (and (or (== (. row state) .instance-done) (== (. row state) .instance-failed)) (not (. row imported)))
)

(fn-do _ absorb-peer _
  (param session Session)
  (param peer Session)
  (param ids PeerIds)
  (param names PeerNames)
  ; Takes in one peer: the types it completed, the classes it found declared as C function types
  ; and the places it noted for closures, of those this pass can name, the classes whose
  ; declarations the instances taken from it checked, then its instances, their facts, what it
  ; noted of panics, and the errors it still held.
  (let completions (. peer types completions))
  (for (in id (..< 0 (. completions length)))
    (let state (. ([] completions id) completion))
    (if (and (or (== state .completion-done) (== state .completion-failed)) (call (. names type-named) (as id TypeId)))
      (call (. session types complete) (call (. ids type) (as id TypeId)))
    )
  )
  (for (in (tuple type declared) (. peer types c-function-decls))
    (if (call (. names type-named) (as type TypeId))
      (call (. session types note-c-function-decl) (call (. ids type) (as type TypeId)) declared)
    )
  )
  (for (in (tuple closure bits) (. peer types placed))
    (if (call (. names type-named) (as closure TypeId))
      (let held (as (call (. ids type) (as closure TypeId)) Size))
      (if (== ([] (. session types placed) held) null)
        (= ([] (. session types placed) held) bits)
      )
    )
  )
  (for (in (tuple class checker) (. peer types checked-classes))
    (if (and (call (. ids owns) checker) (== ([] (. session types checked-classes) class) null))
      (= ([] (. session types checked-classes) class) (call (. ids instance) checker))
    )
  )
  (call absorb-instances session peer ids names)
  (call (. session facts absorb) (. peer facts) ids)
  (call (. session panics absorb) (. peer panics) ids)
  (call (. session errors absorb) (. peer errors) ids)
)

(fn-do _ absorb-instances _
  (param session Session)
  (param peer Session)
  (param ids PeerIds)
  (param names PeerNames)
  ; Gives each instance taken from the peer what the peer knew of it once its body was typed, and
  ; any instance the peer bound to a value of a function type how such a value calls it.
  (let instances (. session instances))
  (let given (. peer instances))
  (for (in id (..< 0 (. given rows length)))
    (let row (as ([] (. given rows) id) Instance))
    (if (and (!= (. row bound-call) .bound-call-none) (call (. names instance-named) (as id InstanceId)))
      (= (. ([] (. instances rows) (call (. ids instance) (as id InstanceId))) bound-call) (. row bound-call))
    )
    (if (not (call (. ids owns) (as id InstanceId)))
      (continue)
    )
    (let instance (call (. ids instance) (as id InstanceId)))
    (let makes (call (. ids type) (. row makes)))
    (let yields (call (. ids type) (. row yields)))
    (let materialized (call (. ids instance) (. row materialized)))
    (let retyped (call (. ids instance) (. row retyped)))
    (= (. ([] (. instances rows) instance) state) (. row state))
    (= (. ([] (. instances rows) instance) may-panic) (. row may-panic))
    (= (. ([] (. instances rows) instance) polls) (. row polls))
    (= (. ([] (. instances rows) instance) is-generator) (. row is-generator))
    (= (. ([] (. instances rows) instance) reads-self) (. row reads-self))
    (= (. ([] (. instances rows) instance) branches) (. row branches))
    (= (. ([] (. instances rows) instance) returns-own) (. row returns-own))
    (= (. ([] (. instances rows) instance) gives-unwritten) (. row gives-unwritten))
    (= (. ([] (. instances rows) instance) casts-errors) (. row casts-errors))
    (= (. ([] (. instances rows) instance) makes) makes)
    (= (. ([] (. instances rows) instance) yields) yields)
    (= (. ([] (. instances rows) instance) ends-generator) (. row ends-generator))
    (= (. ([] (. instances rows) instance) quiet) (. row quiet))
    (= (. ([] (. instances rows) instance) splits-yields) (. row splits-yields))
    (= (. ([] (. instances rows) instance) materialized) materialized)
    (= (. ([] (. instances rows) instance) fills-share) (. row fills-share))
    (= (. ([] (. instances rows) instance) uses-helper) (. row uses-helper))
    (= (. ([] (. instances rows) instance) rolls-helper) (. row rolls-helper))
    (= (. ([] (. instances rows) instance) carries-mark) (. row carries-mark))
    (= (. ([] (. instances rows) instance) unretirable) (. row unretirable))
    (= (. ([] (. instances rows) instance) is-live) (. row is-live))
    (= (. ([] (. instances rows) instance) consumes) (. row consumes))
    (= (. ([] (. instances rows) instance) hands-back) (. row hands-back))
    (= (. ([] (. instances rows) instance) typed-defaults) (. row typed-defaults))
    (= (. ([] (. instances rows) instance) retyped) retyped)
    (if (!= (. row step-errors count) 0)
      (let stack (. session types scratch types))
      (let mark (. stack mark))
      (call push-types ids given (. row step-errors))
      (call (. instances set-step-errors) instance (call (. stack since) mark))
      (call (. stack rewind) mark)
    )
    (call absorb-signature session ids (as id InstanceId) instance)
  )
  (call absorb-report session peer ids)
  (call absorb-live session peer ids)
)

(fn-do _ absorb-signature _
  (param session Session)
  (param ids PeerIds)
  (param id InstanceId)
  (param instance InstanceId)
  ; Gives an instance taken from a peer the signature the peer settled for it. Errors the peer
  ; still held wait here as they waited there (`ErrorSets.absorb`).
  (let given (. ids peer-instances))
  (let signature (as ([] (. given signatures) id) InstanceSignature))
  (let returns (call (. ids type) (. signature returns)))
  (let declared (call (. ids type) (. signature declared-returns)))
  (let read-by (call (. ids instance) (. signature read-by)))
  (let instances (. session instances))
  (call (. instances set-returns) instance returns declared (. signature return-state))
  (if (!= (. signature errors count) 0)
    (let stack (. session types scratch types))
    (let mark (. stack mark))
    (call push-types ids given (. signature errors))
    (call (. instances set-errors) instance (call (. stack since) mark))
    (call (. stack rewind) mark)
  )
  (= (. ([] (. instances signatures) instance) read-in-progress) (. signature read-in-progress))
  (= (. ([] (. instances signatures) instance) read-by) read-by)
  (= (. ([] (. instances signatures) instance) unreturned) (. signature unreturned))
  (= (. ([] (. instances signatures) instance) header) (. signature header))
  (= (. ([] (. instances signatures) instance) error-state) (. signature error-state))
  (= (. ([] (. instances signatures) instance) errors-read-early) (. signature errors-read-early))
)

(fn-do _ push-types _
  (param ids PeerIds)
  (param given Instances)
  (param range (of RowRange TypeId))
  ; Pushes the types a peer's signature types hold over a range, as they are here.
  (for (in offset (..< 0 (. range count)))
    (let type (call (. ids type) ([] (. given signature-types) (+ (. range start) offset))))
    (call (. ids types scratch types push) type)
  )
)

(fn-do _ absorb-report _
  (param session Session)
  (param peer Session)
  (param ids PeerIds)
  ; Takes in the functions a peer typed for the report of an unhandled panic, where this pass has
  ; none yet.
  (let report (. session instances report))
  (let given (. peer instances report))
  (if (== (. report message) no-instance)
    (= (. session instances report message) (call (. ids instance) (. given message)))
  )
  (if (== (. report source-text) no-instance)
    (= (. session instances report source-text) (call (. ids instance) (. given source-text)))
  )
  (if (== (. report source) no-instance)
    (= (. session instances report source) (call (. ids instance) (. given source)))
  )
  (if (== (. report termination) no-instance)
    (= (. session instances report termination) (call (. ids instance) (. given termination)))
  )
  (if (== (. report termination-error) no-instance)
    (= (. session instances report termination-error) (call (. ids instance) (. given termination-error)))
  )
  (if (== (. report panic) no-instance)
    (= (. session instances report panic) (call (. ids instance) (. given panic)))
  )
  (if (== (. report source-slot) (. U32 max))
    (= (. session instances report source-slot) (. given source-slot))
  )
  (if (== (. report trace-slot) (. U32 max))
    (= (. session instances report trace-slot) (. given trace-slot))
  )
  (if (== (. report previous-slot) (. U32 max))
    (= (. session instances report previous-slot) (. given previous-slot))
  )
  (if (== (. report union-error) no-instance)
    (= (. session instances report union-error) (call (. ids instance) (. given union-error)))
  )
  (if (== (. report union-text) no-instance)
    (= (. session instances report union-text) (call (. ids instance) (. given union-text)))
  )
  (if (== (. report error-text) no-instance)
    (= (. session instances report error-text) (call (. ids instance) (. given error-text)))
  )
)

(fn-do _ absorb-live _
  (param session Session)
  (param peer Session)
  (param ids PeerIds)
  ; Takes in the functions a peer typed for tracked values, where this pass has none yet, and the ones
  ; that follow the read of a collection or a read in a pipeline a live value pulls where this pass
  ; has not typed them, which a pass types only as it first notes such a read
  ; (`note-collection-read`, `pulled`). They are left to be demanded here again
  ; where this pass types a tracked read, as what such a read reads of them is settled by demanding
  ; them (`demand-live-runtime`).
  (let given (. peer instances live))
  (if (not (. given demanded))
    (return)
  )
  (if (== (. session instances live track-collection) no-instance)
    (= (. session instances live track-collection) (call (. ids instance) (. given track-collection)))
  )
  (if (== (. session instances live track-active) no-instance)
    (= (. session instances live track-active) (call (. ids instance) (. given track-active)))
  )
  (if (== (. session instances live track-active-collection) no-instance)
    (let active (call (. ids instance) (. given track-active-collection)))
    (= (. session instances live track-active-collection) active)
  )
  (if (!= (. session instances live trackers) no-instance)
    (return)
  )
  (let live (call LiveRuntime))
  (= (. live trackers) (call (. ids instance) (. given trackers)))
  (= (. live subscribers) (call (. ids instance) (. given subscribers)))
  (= (. live actions) (call (. ids instance) (. given actions)))
  (= (. live action) (call (. ids instance) (. given action)))
  (= (. live add-action) (call (. ids instance) (. given add-action)))
  (= (. live add-tracker) (call (. ids instance) (. given add-tracker)))
  (= (. live track) (call (. ids instance) (. given track)))
  (= (. live track-collection) (call (. ids instance) (. given track-collection)))
  (= (. live track-active) (call (. ids instance) (. given track-active)))
  (= (. live track-active-collection) (call (. ids instance) (. given track-active-collection)))
  (= (. live dispatch) (call (. ids instance) (. given dispatch)))
  (= (. live memo-action) (call (. ids instance) (. given memo-action)))
  (= (. live memo-settle) (call (. ids instance) (. given memo-settle)))
  (= (. live previous) (call (. ids instance) (. given previous)))
  (= (. live next) (call (. ids instance) (. given next)))
  (= (. live enter) (call (. ids instance) (. given enter)))
  (= (. live leave) (call (. ids instance) (. given leave)))
  (= (. live pop) (call (. ids instance) (. given pop)))
  (= (. live close) (call (. ids instance) (. given close)))
  (= (. live has-actions) (call (. ids instance) (. given has-actions)))
  (= (. live callback) (call (. ids type) (. given callback)))
  (= (. live callback-result) (call (. ids type) (. given callback-result)))
  (= (. session instances live) live)
)

(fn-do _ absorb-untyped _
  (param session Session)
  (param peers (list Session))
  (param taken (list PeerIds))
  (param typed (of Map StableKey Bool))
  ; Takes in what peers reported of the instances none of them typed, each from the first peer
  ; that reported anything of it (`Facts.absorb-diagnostics`).
  (let reported (call (of Map StableKey Bool)))
  (for (in position (..< 0 (. peers length)))
    (let peer ([] peers position))
    (let flags (list Bool))
    (for (in _ (..< 0 (. peer instances rows length)))
      (+= flags false)
    )
    (let keys (list StableKey))
    (for (in row (. peer facts diagnostics))
      (let key ([] (. peer instances stable-keys) (. row instance)))
      (if (and (== ([] typed key) null) (== ([] reported key) null))
        (= ([] flags (. row instance)) true)
        (+= keys key)
      )
    )
    (for (in key keys)
      (= ([] reported key) true)
    )
    (call (. session facts absorb-diagnostics) (. peer facts) ([] taken position) flags)
  )
)

(fn-do _ type-defaults _
  (param session Session)
  (param peers (list Session))
  (param taken (list PeerIds))
  (param names (list PeerNames))
  ; Types each default of a parameter that some peer typed and this pass has not, as the first call
  ; that takes it would have.
  (let checker (call checker-for session (call seed-main session (. session program entry-module))))
  (call (. checker prepare))
  (for (in position (..< 0 (. peers length)))
    (let peer ([] peers position))
    (let ids ([] taken position))
    (let rows (. peer instances rows))
    (for (in id (..< 0 (. rows length)))
      (let bits (. ([] rows id) typed-defaults))
      (if (or (== bits 0) (not (call (. ([] names position) instance-named) (as id InstanceId))))
        (continue)
      )
      (let callee (call (. ids instance) (as id InstanceId)))
      (for (in place (..< 0u32 64u32))
        (if (and place-set (not (call (. session instances default-typed) callee place)))
          (call (. checker type-default) callee place)
        )
        (lazy place-set (!= (/and/ bits (/lshift/ 1u64 (as place U64))) 0))
      )
    )
    (for (in key (. peer instances wide-defaults))
      (if (not (call (. ([] names position) instance-named) (as (/rshift/ key 32) InstanceId)))
        (continue)
      )
      (let callee (call (. ids instance) (as (/rshift/ key 32) InstanceId)))
      (let place (as (/and/ key (as (. U32 max) U64)) U32))
      (if (not (call (. session instances default-typed) callee place))
        (call (. checker type-default) callee place)
      )
    )
  )
  (call (. checker close))
  (call (. checker retire))
)
