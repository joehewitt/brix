(import ./signature-cache)
(import ./type-env)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + Signature (is Tuple)
  ; A declaration's signature evaluated in an environment: its type parameter names and the
  ; variables or bound types they stand for, its argument types, return type, and error types.
  ; The spans are runs on the types' scratch stacks and live until the caller rewinds.
  (blank)
  (prop + params (of ImmutableArray Atom ArenaBacking))
  (prop + variables (of ImmutableArray TypeId ArenaBacking))
  (prop + args (of ImmutableArray TypeId ArenaBacking))
  (prop + returns TypeId)
  (prop + errors (of ImmutableArray TypeId ArenaBacking))
)

(type + TypeArguments (is Tuple)
  ; IntrinsicKind parameter names bound to types before a signature is evaluated.
  (blank)
  (prop + names (of ImmutableArray Atom ArenaBacking))
  (prop + types (of ImmutableArray TypeId ArenaBacking))
)

(type + FunctionEnv (is Tuple)
  (prop + env TypeEnv)
  (prop + params-start ScratchMark)
  (prop + hidden-start ScratchMark (= 0))
  (prop + hidden-end ScratchMark (= 0))
)

(fn-do + owner-env TypeEnv
  (param types Types)
  (param module ModuleId)
  (param owner DeclId)
  (let program (. types program))
  (if (== owner 0)
    (return (call (. types env-frame)))
  )
  (blank)
  (match? ([] (. ([] (. program modules) module) decls) owner)
    (case .decl-class
      (return (call (. types class-env) module owner))
    )
    (case .decl-extension
      (return (call extension-env types module owner))
    )
  )
  (return (call (. types env-frame)))
)

(fn-do + extension-env TypeEnv
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param receiver TypeId (= no-type))
  ; The environment of an extension, the names its pattern declares. The pattern is read where
  ; the class it extends is, so with a receiver known, a name of that class's parameters the
  ; pattern does not declare is, while it is read, what the receiver gives it. A facet's `this` is
  ; its class, which takes no type arguments, through whatever facets the facet is part of.
  (let program (. types program))
  (let env (call (. types env-frame)))
  (let tree (. ([] (. program modules) module) tree))
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-extension row)
      (if (. row facet)
        (let facets (. program facets))
        (let facet (call (. facets index-of) module decl))
        (let owner invalid-type)
        (if (and facet (== ([] (. facets states) facet) .facet-bound))
          (= owner (call (. types plain-class) ([] (. facets owner-modules) facet) ([] (. facets owner-decls) facet)))
        )
        (return (call (. types env-with-this) env owner))
      )
      (= env (call (. types declare-into) env tree (. row receiver) module decl (. env start)))
      (let pattern no-type)
      (if (!= receiver no-type)
        (let scoped (call bind-extended types module tree (. row receiver) receiver env))
        (= pattern (call (. types evaluate-type) module tree (. row receiver) scoped))
        (call (. types env-truncate) env)
        (else
          (= pattern (call (. types evaluate-type) module tree (. row receiver) env))
        )
      )
      (= env (call (. types env-with-this) env pattern))
      (= env (call (. types apply-constraints) module tree (. row param-constraints) env))
    )
  )
  (return env)
)

(fn-do + extended-class-env TypeEnv
  (param types Types)
  (param module ModuleId)
  (param owner DeclId)
  (param receiver TypeId)
  (param env TypeEnv)
  ; For a member of an extension read with its receiver known, the parameters of the class it
  ; extends that its pattern does not declare, bound from the receiver: TypeScript reads the
  ; member where the class is. They are not parameters of the member.
  (let program (. types program))
  (match? ([] (. ([] (. program modules) module) decls) owner)
    (case (call .decl-extension row)
      (return (call bind-extended types module (. ([] (. program modules) module) tree) (. row receiver) receiver env))
    )
  )
  (return env)
)

(fn-do _ bind-extended TypeEnv
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param pattern SyntaxId)
  (param receiver TypeId)
  (param env TypeEnv)
  (let base pattern)
  (match? ([] (. tree nodes) pattern)
    (case (call .node-type-arguments row)
      (= base (. row base))
    )
  )
  (let extended (call class-ref types (call (. types evaluate-type) module tree base env)))
  (if (== (. extended decl) 0)
    (return env)
  )
  (let program (. types program))
  (let bound env)
  (match? ([] (. ([] (. program modules) (. extended module)) decls) (. extended decl))
    (case (call .decl-class row)
      (let args (call (of RowRange TypeId)))
      (match? ([] (. types rows) (call owner-instance types (. extended module) (. extended decl) receiver))
        (case (call .type-class actual)
          (= args (. actual args))
        )
      )
      (let owner-tree (. ([] (. program modules) (. extended module)) tree))
      (for (in position (..< 0 (. args count)))
        (if (< position (. row type-args count))
          (let name (call (. types class-param-name) owner-tree (. row type-args) position))
          (if (and name (not (call (. types env-lookup) bound name)))
            (= bound (call (. types env-bind) bound name (call (. types child-type) args position)))
          )
        )
      )
    )
  )
  (return bound)
)

(fn-do + function-env FunctionEnv
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param bindings TypeArguments)
  (param receiver TypeId)
  (param class-params Bool)
  (param around (? TypeEnv) (= null))
  ; The environment a function's types are read in. A function written in another one starts from
  ; what that one's binds, `around`.
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (let tree (. owner-module tree))
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (let env (if-expr around (call (. types env-within) around) (call owner-env types module (. row owner))))
      (let hidden-start (. env end))
      (if (!= receiver no-type)
        (= env (call extended-class-env types module (. row owner) receiver env))
      )
      (let hidden-end (. env end))
      (if (!= receiver no-type)
        (= env (call bind-receiver types module (. row owner) receiver env))
      )
      (let params-start (. env end))
      (let constructs (call is-constructor-kind (. row kind)))
      (if (and class-params constructs)
        (= params-start (. env start))
      )
      (match? ([] (. owner-module decls) (. row owner))
        (case .decl-extension
          (if (or class-params (not constructs))
            (= params-start (. env start))
          )
        )
      )
      (let first (. env end))
      (for (in child ([] (. tree children) (. row type-args)))
        (let name (call (. types type-syntax-name) tree child))
        (if (and name (not (call (. types env-lookup-from) env name first)))
          (let index U32 (as (- (. env end) first) U32))
          (let variable (call (. types intern-variable) module decl index name))
          (= env (call (. types env-bind) env name variable))
        )
      )
      (if (call is-index-span-constructor-kind (. row kind))
        (for (in text (list "Source" "Bounds"))
          (let name (call (. program store-atom) text))
          (let index U32 (as (- (. env end) first) U32))
          (= env (call (. types env-bind) env name (call (. types intern-variable) module decl index name)))
        )
      )
      (for (in shape ([] (. owner-module arg-pool) (. row args)))
        (= env (call (. types declare-into) env tree (. shape pattern) module decl first))
        (if (call is-implicit-argument types module tree (call constructed-class row) shape)
          (let name (!! (call pattern-name types tree (. shape pattern))))
          (if (not (call (. types env-lookup-from) env name first))
            (let index U32 (as (- (. env end) first) U32))
            (let variable (call (. types intern-variable) module decl index name))
            (= env (call (. types env-bind) env name variable))
          )
        )
      )
      (for (in offset (..< 0 (. bindings names length)))
        (= env (call (. types env-bind) env ([] (. bindings names) offset) ([] (. bindings types) offset)))
      )
      (= env (call (. types apply-constraints) module tree (. row param-constraints) env))
      (return (call FunctionEnv env params-start hidden-start hidden-end))
    )
    (case (call .decl-converter row)
      (let env (call owner-env types module (. row owner)))
      (if (!= receiver no-type)
        (= env (call bind-receiver types module (. row owner) receiver env))
      )
      (let params-start (. env end))
      (= env (call (. types declare-into) env tree (. row target-type) module decl params-start))
      (= env (call bind-given types bindings env))
      (= env (call (. types apply-constraints) module tree (. row param-constraints) env))
      (return (call FunctionEnv env params-start))
    )
    (case (call .decl-fromverter row)
      (let env (call owner-env types module (. row owner)))
      (if (!= receiver no-type)
        (= env (call bind-receiver types module (. row owner) receiver env))
      )
      (let params-start (. env end))
      (= env (call (. types declare-into) env tree (. row source-type) module decl params-start))
      (return (call FunctionEnv (call bind-given types bindings env) params-start))
    )
  )
  (return (call FunctionEnv (call (. types env-frame)) 0))
)

(fn-do _ bind-given TypeEnv
  (param types Types)
  (param bindings TypeArguments)
  (param env TypeEnv)
  (let bound env)
  (for (in offset (..< 0 (. bindings names length)))
    (= bound (call (. types env-bind) bound ([] (. bindings names) offset) ([] (. bindings types) offset)))
  )
  (return bound)
)

(fn-do + converter-env TypeEnv
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param owner DeclId)
  (param type-syntax SyntaxId)
  (let program (. types program))
  (let env (call owner-env types module owner))
  (let tree (. ([] (. program modules) module) tree))
  (return (call (. types declare-into) env tree type-syntax module decl (. env end)))
)

(fn-do + signature-into Signature
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param bindings TypeArguments)
  (param receiver TypeId)
  (param class-params Bool)
  ; A fault raised before is set aside while the signature is read, so what reading it raises
  ; alone decides whether it is kept.
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (let tree (. owner-module tree))
  (let scratch (. types scratch))
  (call open-key types module decl bindings receiver class-params)
  (let cached (. scratch signatures found))
  (if cached
    (return (call replay scratch ([] (. scratch signatures rows) cached)))
  )
  (let prior (. types fault))
  (let prior-module (. types fault-module))
  (let prior-site (. types fault-site))
  (call (. types clear-fault))
  (let function (call function-env types module decl bindings receiver class-params))
  (let env (. function env))
  (let params-start (. scratch names mark))
  (for (in position (..< (. function params-start) (. env end)))
    (let name (call (. types env-name) position))
    (let hidden (and (>= position (. function hidden-start)) (< position (. function hidden-end))))
    (if (and (not hidden) (not (call name-in-span (call (. scratch names since) params-start) name)))
      (call (. scratch names push) name)
    )
  )
  (let params (call (. scratch names since) params-start))
  (let variables-start (. scratch types mark))
  (for (in name params)
    (let bound (call (. types env-lookup) env name))
    (call (. scratch types push) (?? bound invalid-type))
  )
  (let variables (call (. scratch types since) variables-start))
  (let args-start (. scratch types mark))
  (let args-count 0)
  (let returns no-type)
  (let errors (. scratch no-types))
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (if (call is-table-constructor-kind (. row kind))
        (= args-count (call table-arguments types module (. row kind) env))
        (else-if (!= (. row args count) 0)
          (for (in shape ([] (. owner-module arg-pool) (. row args)))
            (let declared (call argument-type types module tree (call constructed-class row) shape env))
            (call (. scratch types push) declared)
            (+= args-count 1)
          )
        )
      )
      (if (!= (. row return-type) 0)
        (= returns (call (. types evaluate-type) module tree (. row return-type) env))
      )
      (let errors-start (. scratch types mark))
      (for (in child ([] (. tree children) (. row errors)))
        (call (. scratch types push) (call (. types evaluate-type) module tree child env))
      )
      (= errors (call (. scratch types since) errors-start))
    )
    (case (call .decl-converter row)
      (= returns (call (. types evaluate-type) module tree (. row target-type) env))
    )
    (case (call .decl-fromverter row)
      (call (. scratch types push) (call (. types evaluate-type) module tree (. row source-type) env))
      (= args-count 1)
      (= returns (if-expr (!= receiver no-type) receiver (. env this-type)))
    )
  )
  (call (. types env-release) env)
  (blank)
  (let signature
    (call Signature
      (block
        (arg params)
        (arg variables)
        (arg (call (. scratch types span) args-start args-count))
        (arg returns)
        (arg errors)
      )
    )
  )
  (call open-key types module decl bindings receiver class-params)
  (call remember types signature)
  (if prior
    (= (. types fault) prior)
    (= (. types fault-module) prior-module)
    (= (. types fault-site) prior-site)
  )
  (return signature)
)

(fn-do _ open-key _
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param bindings TypeArguments)
  (param receiver TypeId)
  (param class-params Bool)
  (let cache (. types scratch signatures))
  (call (. cache open-key) module decl receiver class-params (. bindings names length))
  (for (in offset (..< 0 (. bindings names length)))
    (let name U32 (as (call (. types program atom-key) ([] (. bindings names) offset)) U32))
    (call (. cache add-binding) name ([] (. bindings types) offset))
  )
)

(fn-do _ replay Signature
  (param scratch TypingScratch)
  (param row CachedSignature)
  ; The cached signature, pushed as the runs an evaluation leaves.
  (let cache (. scratch signatures))
  (let names-start (. scratch names mark))
  (for (in offset (..< 0 (. row params)))
    (call (. scratch names push) ([] (. cache names) (+ (. row names) offset)))
  )
  (let params (call (. scratch names since) names-start))
  (let variables-start (. scratch types mark))
  (for (in offset (..< 0 (. row params)))
    (call (. scratch types push) ([] (. cache types) (+ (. row types) offset)))
  )
  (let variables (call (. scratch types since) variables-start))
  (let args-start (. scratch types mark))
  (for (in offset (..< 0 (. row args)))
    (call (. scratch types push) ([] (. cache types) (+ (. row types) (. row params) offset)))
  )
  (let errors-start (. scratch types mark))
  (for (in offset (..< 0 (. row errors)))
    (call (. scratch types push) ([] (. cache types) (+ (. row types) (. row params) (. row args) offset)))
  )
  (let args (call (. scratch types span) args-start (. row args)))
  (return (call Signature params variables args (. row returns) (call (. scratch types since) errors-start)))
)

(fn-do _ remember _
  (param types Types)
  (param signature Signature)
  ; A signature that named every type is kept. One that failed is evaluated again, so its fault
  ; is raised again for whoever reports it.
  (let clean (and (not (. types fault)) (!= (. signature returns) invalid-type)))
  (for (in type (. signature variables))
    (if (== type invalid-type)
      (= clean false)
    )
  )
  (for (in type (. signature args))
    (if (== type invalid-type)
      (= clean false)
    )
  )
  (for (in type (. signature errors))
    (if (== type invalid-type)
      (= clean false)
    )
  )
  (if (not clean)
    (return)
  )
  (let cache (. types scratch signatures))
  (let names U32 (as (. cache names length) U32))
  (let kept U32 (as (. cache types length) U32))
  (for (in name (. signature params))
    (+= (. cache names) name)
  )
  (for (in type (. signature variables))
    (+= (. cache types) type)
  )
  (for (in type (. signature args))
    (+= (. cache types) type)
  )
  (for (in type (. signature errors))
    (+= (. cache types) type)
  )
  (let params U32 (as (. signature params length) U32))
  (let args U32 (as (. signature args length) U32))
  (let errors U32 (as (. signature errors length) U32))
  (call (. cache keep) (call CachedSignature names kept params args errors (. signature returns)))
)

(fn-do _ argument-type TypeId
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param constructed DeclId)
  (param shape ArgumentShape)
  (param env TypeEnv)
  (let program (. types program))
  (let written (call written-argument-type types module tree constructed shape))
  (if (!= written 0)
    (return (call (. types evaluate-type) module tree written env))
  )
  (let name (call pattern-name types tree (. shape pattern)))
  (if (not name)
    (return (call (. types evaluate-type) module tree (. shape pattern) env))
  )
  (let bound (call (. types env-lookup) env name))
  (if bound
    (return bound)
  )
  (return invalid-type)
)

(fn-expr + is-implicit-argument Bool
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param constructed DeclId)
  (param shape ArgumentShape)
  (and (== (call written-argument-type types module tree constructed shape) 0) named-pattern)
  (where
    (lazy named-pattern (!= (call pattern-name types tree (. shape pattern)) null))
  )
)

(fn-do + written-argument-type SyntaxId
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param constructed DeclId)
  (param shape ArgumentShape)
  (return-if (. shape type-syntax) (if (or (!= (. shape type-syntax) 0) (== constructed 0))))
  (blank)
  (let name (call pattern-name types tree (. shape pattern)))
  (if (not name)
    (return 0)
  )
  (let property (call owner-property (. types program) module constructed name))
  (if (== property 0)
    (return 0)
  )
  (match? ([] (. ([] (. types program modules) module) decls) property)
    (case (call .decl-property row)
      (if (not (. row is-lazy))
        (return (. row type-syntax))
      )
    )
  )
  (return 0)
)

(fn-expr + constructed-class DeclId
  (param function FunctionDecl)
  (if-expr (call is-constructor-kind (. function kind)) (. function owner) 0)
)

(fn-do + implicit-argument-count U32
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (let count 0u32)
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (for (in shape ([] (. owner-module arg-pool) (. row args)))
        (if (call is-implicit-argument types module (. owner-module tree) (call constructed-class row) shape)
          (+= count 1)
        )
      )
    )
  )
  (return count)
)

(fn-do + pattern-name (? Atom)
  (param types Types)
  (param tree AST)
  (param pattern SyntaxId)
  (if (== pattern 0)
    (return null)
  )
  (match? ([] (. tree nodes) pattern)
    (case (call .node-type-capture row)
      (return (call (. types type-syntax-name) tree (. row id)))
    )
  )
  (return (call (. types type-syntax-name) tree pattern))
)

(fn-do + owner-property DeclId
  (param program Program)
  (param module ModuleId)
  (param owner DeclId)
  (param name Atom)
  (if (== owner 0)
    (return 0)
  )
  (let owner-module ([] (. program modules) module))
  (let members (call (of RowRange DeclId)))
  (match? ([] (. owner-module decls) owner)
    (case (call .decl-class row)
      (= members (. row members))
    )
    (case (call .decl-extension row)
      (if (. row facet)
        (= members (. row members))
      )
    )
  )
  (for (in member (call (. owner-module members-named) members name))
    (match? ([] (. owner-module decls) member)
      (case (call .decl-property row)
        (if (and (. row name) (== (. row name) name))
          (return member)
        )
      )
    )
  )
  (return 0)
)

(fn-do + valued-property DeclId
  (param program Program)
  (param module ModuleId)
  (param owner DeclId)
  (param name Atom)
  ; The declaration of a property of a name in a class that writes its value: the first that
  ; has one, as a root `<This` gives a value to a property the class declares with none, or
  ; else the first.
  (let first (call owner-property program module owner name))
  (if (== first 0)
    (return 0)
  )
  (let owner-module ([] (. program modules) module))
  (let members
    (match ([] (. owner-module decls) owner)
      (case (call .decl-class row)
        (. row members)
      )
      (case (call .decl-extension row)
        (. row members)
      )
      (default
        (call (of RowRange DeclId))
      )
    )
  )
  (for (in member (call (. owner-module members-named) members name))
    (match? ([] (. owner-module decls) member)
      (case (call .decl-property property)
        (if (and (. property name) (== (. property name) name) (!= (. property value) 0))
          (return member)
        )
      )
    )
  )
  (return first)
)

(fn-do + literal-type TypeId
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param syntax SyntaxId)
  (param env TypeEnv)
  (let program (. types program))
  (match? ([] (. tree nodes) syntax)
    (case (call .node-integer-syntax row)
      (if (. row unit)
        (return (call (. types type-named) module (. row unit) env))
      )
      (return (call (. types type-row) .int64))
    )
    (case (call .node-float-syntax row)
      (if (. row unit)
        (return (call (. types type-named) module (. row unit) env))
      )
      (return (. types f64-type))
    )
    (case .node-string-syntax
      (return (. types string-type))
    )
    (case (call .node-identifier row)
      (if (or (== (. row name) (!! (. types true-atom))) (== (. row name) (!! (. types false-atom))))
        (return (. types bool-type))
      )
      (if (== (. row name) (!! (. types null-atom)))
        (return (. types null-type))
      )
      (return (call global-default-type types module tree (. row name) env))
    )
    (case (call .node-symbol row)
      (return (call symbol-class types module (. row name)))
    )
    (case (call .node-unary-expression row)
      (if (== (. row op) .negative-op)
        (return (call literal-type types module tree (. row operand) env))
      )
    )
    (case (call .node-call-expression row)
      (let name (call (. types type-syntax-name) tree (. row callable)))
      (match? ([] (. tree nodes) (. row callable))
        (case .node-type-arguments
          (if name
            (return (call (. types evaluate-type) module tree (. row callable) env))
          )
        )
      )
      (if name
        (return (call (. types type-named) module name env))
      )
    )
    (case (call .node-get-expression get)
      (return (call static-member-type types module tree (. get object) (. get name) env))
    )
  )
  (return invalid-type)
)

(fn-do _ global-default-type TypeId
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param name Atom)
  (param env TypeEnv)
  (let program (. types program))
  (for (in candidate (call (. program lookup) module name))
    (let target ([] (. program modules) (. candidate module)))
    (match? ([] (. target decls) (. candidate decl))
      (case (call .decl-property property)
        (if (!= (. property owner) 0)
          (continue)
        )
        (if (!= (. property type-syntax) 0)
          (return (call (. types evaluate-type) (. candidate module) (. target tree) (. property type-syntax) env))
        )
        (if (!= (. property value) 0)
          (return (call literal-type types (. candidate module) (. target tree) (. property value) env))
        )
        (return invalid-type)
      )
    )
  )
  (return invalid-type)
)

(fn-do _ static-member-type TypeId
  (param types Types)
  (param module ModuleId)
  (param tree AST)
  (param object SyntaxId)
  (param name Atom)
  (param env TypeEnv)
  (let owner-name (call (. types type-syntax-name) tree object))
  (if (not owner-name)
    (return invalid-type)
  )
  (let owner (call (. types type-named) module owner-name env))
  (if (== owner invalid-type)
    (return invalid-type)
  )
  (call (. types complete) owner)
  (let found (call (. types property-named) owner name))
  (if found
    (let property ([] (. types properties) found))
    (if (!= (. property type) no-type)
      (return (. property type))
    )
    (return invalid-type)
  )
  (return owner)
)

(fn-do _ table-arguments Size
  (param types Types)
  (param module ModuleId)
  (param kind DeclKind)
  (param env TypeEnv)
  (let program (. types program))
  (if (call is-index-span-constructor-kind kind)
    (call (. types scratch types push) (call (. types type-named) module (call (. program store-atom) "Source") env))
    (if (== kind .index-span-source-constructor-decl)
      (return 1)
    )
    (let mark (. types scratch types mark))
    (call (. types scratch types push) (call (. types type-named) module (call (. program store-atom) "Bounds") env))
    (let range (. types range-decl))
    (call (. types scratch types push) (call (. types intern-class) (. range module) (. range decl) mark))
    (return 2)
  )
  (let size (. types size-type))
  (let arena-mark (. types scratch types mark))
  (let arena (call (. types intern-class) (. types arena-decl module) (. types arena-decl decl) arena-mark))
  (if (== kind .table-size-constructor-decl)
    (call (. types scratch types push) size)
    (return 1)
  )
  (if (== kind .table-arena-constructor-decl)
    (call (. types scratch types push) arena)
    (return 1)
  )
  (if (== kind .table-capacity-constructor-decl)
    (call (. types scratch types push) arena)
    (call (. types scratch types push) size)
    (return 2)
  )
  (call (. types scratch types push) size)
  (let row (call (. types type-named) module (call (. program store-atom) "Row") env))
  (let index (. types index-type))
  (let mark (. types scratch types mark))
  (call (. types scratch types push) index)
  (let errors (. types scratch types mark))
  (call (. types scratch types push) (call (. types intern-function) row false mark errors))
  (return 2)
)

(fn-do + declared-argument TypeId
  (param types Types)
  (param given TypeId)
  (param position U32)
  ; The type a closure or a bound function declares for an argument, which a parameter of a
  ; function type infers its own open argument types from, and which a closure made a value
  ; of a function type takes whatever the type gives it.
  (let module 0u32)
  (let decl 0u32)
  (let object no-type)
  (let held 0u32)
  (match? ([] (. types rows) given)
    (case (call .type-closure row)
      (= module (. row module))
      (= decl (. row decl))
    )
    (case (call .type-binding row)
      (= module (. row module))
      (= decl (. row decl))
      (= object (. row object))
      (= held (- (. row items count) (. row param-count)))
    )
  )
  (if (== decl 0)
    (return no-type)
  )
  (let scratch (. types scratch))
  (let names-mark (. scratch names mark))
  (let items-mark (. scratch types mark))
  (let signature (call signature-into types module decl (call no-type-arguments types) object true))
  (let slot (+ position held))
  (let declared (if-expr (< slot (. signature args length)) ([] (. signature args) slot) no-type))
  (call (. scratch types rewind) items-mark)
  (call (. scratch names rewind) names-mark)
  (if (or (== declared no-type) (== declared invalid-type))
    (return no-type)
  )
  (return (if-expr (. ([] (. types completions) declared) has-variables) no-type declared))
)

(fn-expr + function-signature Signature
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  ; The signature of a declaration on its own, with no receiver and no bindings. The spans are
  ; runs on the scratch stacks; the caller marks before and rewinds after reading them.
  (call signature-into types module decl (call no-type-arguments types) no-type false)
)

(fn-expr + is-constructor-kind Bool
  (param kind DeclKind)
  (case? (or (== kind .constructor-decl) (== kind .default-constructor-decl))
    true
  )
  (case? (or (== kind .cast-constructor-decl) (== kind .tuple-constructor-decl))
    true
  )
  (default
    (call is-table-constructor-kind kind)
  )
)

(fn-expr + no-type-arguments TypeArguments
  (param types Types)
  (call TypeArguments (. types scratch no-names) (. types scratch no-types))
)

(fn-do _ name-in-span Bool
  (param names (of ImmutableArray Atom ArenaBacking))
  (param name Atom)
  (for (in candidate names)
    (if (== candidate name)
      (return true)
    )
  )
  (return false)
)

(fn-do _ owner-instance TypeId
  (param types Types)
  (param module ModuleId)
  (param owner DeclId)
  (param receiver TypeId)
  ; The receiver seen as the class that declares a member: the receiver itself or the base of
  ; that class, or the interface of it the receiver implements.
  (let current receiver)
  (while true
    (match? ([] (. types rows) current)
      (case (call .type-class row)
        (if (and (== (. row module) module) (== (. row decl) owner))
          (return current)
        )
      )
    )
    (let base (call (. types base-of) current))
    (if (not base)
      (break)
    )
    (= current base)
  )
  (= current receiver)
  (while (!= current no-type)
    (let found (call implemented-interface types current module owner))
    (if (!= found no-type)
      (return found)
    )
    (= current (?? (call (. types base-of) current) no-type))
  )
  (return receiver)
)

(fn-do + bind-receiver TypeEnv
  (param types Types)
  (param module ModuleId)
  (param owner DeclId)
  (param receiver TypeId)
  (param env TypeEnv)
  ; The environment of a member read with its receiver known: the parameters of its class
  ; bound from the receiver, or, for an extension, the names its pattern declares.
  (let program (. types program))
  (let bound env)
  (match? ([] (. ([] (. program modules) module) decls) owner)
    (case (call .decl-class row)
      (let args (call (of RowRange TypeId)))
      (match? ([] (. types rows) (call owner-instance types module owner receiver))
        (case (call .type-class actual)
          (= args (. actual args))
        )
      )
      (for (in position (..< 0 (. args count)))
        (if (< position (. row type-args count))
          (let tree (. ([] (. program modules) module) tree))
          (let type-args (. row type-args))
          (let name (call (. types class-param-name) tree type-args position))
          (if name
            (= bound (call (. types env-bind) bound name (call (. types child-type) args position)))
          )
        )
      )
      (= bound (call (. types env-with-this) bound receiver))
    )
    (case (call .decl-extension row)
      (let tree (. ([] (. program modules) module) tree))
      (let actual-args (call (of RowRange TypeId)))
      (match? ([] (. types rows) receiver)
        (case (call .type-class actual)
          (= actual-args (. actual args))
        )
      )
      (match? ([] (. tree nodes) (. row receiver))
        (case (call .node-type-arguments pattern)
          (let position 0)
          (for (in child ([] (. tree children) (. pattern args)))
            (match? ([] (. tree nodes) child)
              (case (call .node-type-identifier name-row)
                (if (and (. name-row is-declare) (< position (. actual-args count)))
                  (let actual (call (. types child-type) actual-args (as position U32)))
                  (= bound (call (. types env-bind) bound (. name-row name) actual))
                )
              )
            )
            (+= position 1)
          )
        )
      )
      (= bound (call (. types env-with-this) bound receiver))
    )
  )
  (return bound)
)

(fn-do + symbol-class TypeId
  (param types Types)
  (param module ModuleId)
  (param name Atom)
  ; The type a case named by its symbol alone is of, where nothing else says: the last of the
  ; types the module can name that have the case.
  (let found (list TypeId))
  (call symbol-owners types module name found)
  (if (== (. found length) 0)
    (return invalid-type)
  )
  (return ([] found (- (. found length) 1)))
)

(fn-do + symbol-owners _
  (param types Types)
  (param module ModuleId)
  (param name Atom)
  (param found (list TypeId))
  ; Every type a module can name that has a case or value of this name, as the reference lists
  ; them: those of the modules it imports, and then its own, each module's in the order they
  ; are declared.
  (let program (. types program))
  (let count (. program modules length))
  (let ordered (list Size))
  (for (in _ (..< 0 count))
    (+= ordered (. Size max))
  )
  (for (in position (..< 0 count))
    (let owner Index position)
    (let place (call (. program listed) module (as owner ModuleId)))
    (if (< place count)
      (= ([] ordered place) position)
    )
  )
  (for (in position ordered)
    (if (== position (. Size max))
      (continue)
    )
    (call module-symbol-owners types position name found)
  )
)

(fn-do + program-symbol-class TypeId
  (param types Types)
  (param name Atom)
  ; The type a case named by its symbol alone is of where no type the module can name has the
  ; case: the last of the program's types that have it, as the reference takes it until the type
  ; expected of the case settles it. Invalid where none has it.
  (let found (list TypeId))
  (for (in position (..< 0 (. types program modules length)))
    (call module-symbol-owners types position name found)
  )
  (if (== (. found length) 0)
    (return invalid-type)
  )
  (return ([] found (- (. found length) 1)))
)

(fn-do _ module-symbol-owners _
  (param types Types)
  (param position Size)
  (param name Atom)
  (param found (list TypeId))
  (let owner Index position)
  (let owner-module ([] (. types program modules) position))
  (for (in decl (. owner-module decls))
    (match? decl
      (case (call .decl-case row)
        (if (and (. row name) (== (. row name) name) (!= (. row owner) 0))
          (match? ([] (. owner-module decls) (. row owner))
            (case .decl-class
              (let mark (. types scratch types mark))
              (let type (call (. types class-with-args) (as owner ModuleId) (. row owner) mark))
              (if (and (!= type invalid-type) (== (call (. found find) type) null))
                (+= found type)
              )
            )
          )
        )
      )
    )
  )
)

(fn-do + interface-default-owner TypeId
  (param types Types)
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  (param self TypeId)
  ; The interface a function that an interface declares with a body sees its receiver as,
  ; where that is an object of a class. No type for a getter or a setter, which the reference
  ; runs with the object itself, as it runs every such function for a value that is no object.
  (if (or (== self no-type) (== self invalid-type))
    (return no-type)
  )
  (let owner 0u32)
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (= owner (. fn owner))
      (if (or (== (. fn kind) .getter-decl) (== (. fn kind) .setter-decl))
        (return no-type)
      )
    )
  )
  (if (or (== owner 0) (!= (call (. types intrinsic-of) self) .class))
    (return no-type)
  )
  (let current self)
  (while (!= current no-type)
    (match? ([] (. types rows) current)
      (case (call .type-class row)
        (if (and (== (. row module) module) (== (. row decl) owner))
          (return no-type)
        )
      )
    )
    (let found (call implemented-interface types current module owner))
    (if (!= found no-type)
      (return found)
    )
    (= current (?? (call (. types base-of) current) no-type))
  )
  (return no-type)
)

(fn-do _ implemented-interface TypeId
  (param types Types)
  (param level TypeId)
  (param module ModuleId)
  (param owner DeclId)
  (for (in interface (call (. types interfaces-of) level))
    (match? ([] (. types rows) interface)
      (case (call .type-class row)
        (if (and (== (. row module) module) (== (. row decl) owner))
          (return interface)
        )
      )
    )
    (let parent (call implemented-interface types interface module owner))
    (if (!= parent no-type)
      (return parent)
    )
  )
  (return no-type)
)
