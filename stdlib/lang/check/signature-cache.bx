(import ./idmap)
(import ./types)
(import /core/arena)
(import /core/table)
(import /lang/ast/decl)
(import /lang/ast/module)

(type + CachedSignature (is Struct)
  (prop + names U32)
  (prop + types U32)
  (prop + params U32)
  (prop + args U32)
  (prop + errors U32)
  (prop + returns TypeId)
)

(type + SignatureCache
  ; Signatures already evaluated from syntax, each under one receiver and one set of bound type
  ; parameters, so that ranking a declaration at another call site reads it back. A row's names
  ; are its parameters; its types are their variables, then its arguments, then its errors.
  (blank)
  (prop + rows (of Table CachedSignature))
  (prop + names (of List Atom ArenaBacking))
  (prop + types (of List TypeId ArenaBacking))
  (prop _ arena Arena)
  (prop _ keys IdMap)
  (prop _ key-scratch (of Array U32 ArenaBacking))
  (prop _ key-count Size)
  (fn-do + This _
    (param arena Arena)
    (lazy rows (call (of Table CachedSignature) arena 64))
    (lazy names (call (of List Atom) arena))
    (lazy types (call (of List TypeId) arena))
    (lazy key-scratch (call (of Array U32) arena 16))
  )
  (fn-do + release _
    (call (. keys release))
  )
  (fn-do + open-key _
    (param module ModuleId)
    (param decl DeclId)
    (param receiver TypeId)
    (param class-params Bool)
    (param bindings Size)
    (let count (+ 4 (* bindings 2)))
    (if (> count (. key-scratch length))
      (let capacity (. key-scratch length))
      (while (< capacity count)
        (*= capacity 2)
      )
      (= key-scratch (call (. key-scratch resize) capacity arena))
    )
    (= ([] key-scratch 0) module)
    (= ([] key-scratch 1) decl)
    (= ([] key-scratch 2) receiver)
    (= ([] key-scratch 3) (if-expr class-params 1u32 0u32))
    (= key-count 4)
  )
  (fn-do + add-binding _
    (param name U32)
    (param type TypeId)
    (= ([] key-scratch key-count) name)
    (= ([] key-scratch (+ key-count 1)) type)
    (+= key-count 2)
  )
  (fn-expr + found (? Index) :get
    (call (. keys find) (. key-scratch data) key-count)
  )
  (fn-do + keep _
    (param row CachedSignature)
    (call (. keys store) (. key-scratch data) key-count)
    (if (. keys last-inserted)
      (call (. rows append) row)
    )
  )
)
