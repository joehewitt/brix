./type-store
./type-text
./types
/lang/ast/decl
/lang/ast/module
/lang/ast/program

━━━━━━━━━━━━━━━━━━━━
+ ProbeCast is U8

` How a probe writes a value of a type (see `probe-cast`).

| probe-number = 0
| probe-text = 1
| probe-object = 2
| probe-array = 3
| probe-converted = 4

━━━━━━━━━━━━━━━━━━━━
+ probe-cast ProbeCast
    - types Types
    - type TypeId

` How a probe writes a value of a type, as the reference casts one: a scalar number, a truth or a
` character, and a text, as they are; an object of a class, and a tuple that is an `Array` or is
` `Inspectable`, by the id the probes module gives it, an array with the type of its items; and
` any other value as its text.
|? intrinsic-is-numeric(kind) && kind != .number && kind != .cpointer
    .probe-number
|? type == types.string-type
    .probe-text
|? kind == .class
    .probe-object
|? !intrinsic-is-tuple-like(kind)
    .probe-converted
|? is-probe-array(types, type)
    .probe-array
|? is-inspectable(types, type)
    .probe-object
??
    .probe-converted

.. kind = types.intrinsic-of(type)

━━━━━━━━━━━━━━━━━━━━
+ probe-data-type U8
    - types Types
    - type TypeId

` The probe data type a value of a type is written as, which the probes module reads it by.
match probe-cast(types, type)
    |= .probe-object
        15
    |= .probe-array
        14
    |= .probe-number
        number-data-type(types.intrinsic-of(type))
    ??
        13

━━━━━━━━━━━━━━━━━━━━
+ do probe-class-name String
    - types Types
    - type TypeId

` The name the probes module declares the class of an object or an array by: its module's name
` and its own.
. program = types.program
match? types.rows[type]
    | .type-class(row)
        = "${program.modules[row.module].name}:${class-name(program, row.module, row.decl)}"
= ""

━━━━━━━━━━━━━━━━━━━━
+ probe-preview-text String
    - types Types
    - type TypeId

` What a preview of a value that a probe would write as its text writes instead: the name of its
` type, in brackets.
"[${type-runtime-name(types, type)}]"

━━━━━━━━━━━━━━━━━━━━
_ number-data-type U8
    - kind IntrinsicKind

match kind
    |= .bool
        1
    |= .int1
        1
    |= .char
        2
    |= .int8
        3
    |= .uint8
        4
    |= .int16
        5
    |= .uint16
        6
    |= .int32
        7
    |= .uint32
        8
    |= .int64
        9
    |= .uint64
        10
    |= .float32
        11
    |= .float64
        12
    ??
        13

━━━━━━━━━━━━━━━━━━━━
_ do is-probe-array Bool
    - types Types
    - type TypeId

` Whether a type is the core `Array`, or a class below it.
. current TypeId? = type
while current
    if is-named(types, current, "core/array", "Array")
        = true
    current = types.base-of(current)
= false

━━━━━━━━━━━━━━━━━━━━
_ do is-inspectable Bool
    - types Types
    - type TypeId

` Whether a type is `Inspectable`: it, an interface it has, or a class above it, has the interface.
for interface in types.interfaces-of(type)
    if is-named(types, interface, "core", "Inspectable") || is-inspectable(types, interface)
        = true
. base = types.base-of(type)
if base
    = is-inspectable(types, base)
= false

━━━━━━━━━━━━━━━━━━━━
_ is-named Bool
    - types Types
    - type TypeId
    - module-name String
    - name String

match types.rows[type]
    | .type-class(row)
        types.program.modules[row.module].name == module-name && same-name
        .. same-name = class-name(types.program, row.module, row.decl) == name
    ??
        false
