(type _ FoldedNumber (is Tuple)
  ; The bits a constant number folds to, where it `folds`.
  (blank)
  (prop + bits U64)
  (prop + folds Bool)
)

(type _ CallTyping (facet-of Checker)
  (sees Comprehensions)
  (sees Markup)
  (sees Tables)
  (fn-expr _ held-type TypeId
    (param type TypeId)
    ; A type, or what it holds where it is an optional.
    (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type)
  )
  (fn-do + infer-argument TypeId
    (param expr SyntaxId)
    (param symbol (? Atom))
    ; An argument is typed outside any `catch` its call is written under: an error it raises
    ; leaves the function, and the catch holds only the errors of the call itself. One that names
    ; an event is its `Broadcastable` (see `use-event`).
    (if symbol
      (return (. types void-type))
    )
    (let caught (. frame surround))
    (= (. frame surround) (= (. frame surround catch-depth) 0))
    (let type (call infer expr (call (. (call Want) adding) .want-argument)))
    (= (. frame surround) caught)
    (return type)
  )
  (fn-do _ is-method Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a function is a method of a type, which the value of a stored property cannot call:
    ; the object the method would run on is not yet made.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-function fn)
        (if (or (== (. fn owner) 0) (. fn is-static))
          (return false)
        )
        (match? ([] (. ([] (. program modules) owner) decls) (. fn owner))
          (case .decl-class
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ eager-call-message String
    (param name Atom)
    (param owner ModuleId)
    (param decl DeclId)
    (case? (call eager-value)
      (str "A property's value is computed before the object exists, so it " called "; declare the property without a value and assign it in a constructor's body")
    )
    (default
      (str "A \"lazy\" initializer runs before the object exists, so it " called "; compute the value from the constructor's parameters, or assign it in the constructor's body")
    )
    (where
      (lazy called (str "cannot call \"" (. name text) "\", a method of " (call method-owner owner decl)))
    )
  )
  (fn-expr _ eager-value Bool
    (case? (. reading eager)
      (call (. instances is-initializer) instance)
    )
    (default
      (and (!= outer null) (call (. outer eager-value)))
    )
  )
  (fn-do _ method-owner String
    (param owner ModuleId)
    (param decl DeclId)
    (let decls (. ([] (. program modules) owner) decls))
    (match? ([] decls decl)
      (case (call .decl-function fn)
        (match? ([] decls (. fn owner))
          (case (call .decl-class class)
            (return (. class name text))
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ settle-kept-arguments _
    (param mark Size)
    (param result TypeId)
    ; Declines each event read in a function written in a markup element's body that a call since
    ; `mark` was given and no converter refused (`misused-endpoint`), which has no shape here.
    (while (> (. kept-arguments length) mark)
      (let kept (call (. kept-arguments pop)))
      (if (and (!= kept 0) (!= result invalid-type))
        (call decline kept)
      )
    )
  )
  (fn-do + infer-argument-value TypeId
    (param id SyntaxId)
    (param row ASTArgument)
    ; An argument written where a value is wanted, as a line of a markup element's body, as the
    ; reference compiles one: one with a name is the tuple of its name and its value, and one with a
    ; bullet `•?` too is that tuple where the value tests as true, as a condition does, and nothing
    ; where it does not; one with no name is its value.
    (let value (call infer (. row expr)))
    (if (or (== value invalid-type) (== value no-type) (not (. row name)))
      (return value)
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (call (. scratch names push) (call (. types index-atom) 0))
    (call (. scratch types push) (. types string-type))
    (call (. scratch names push) (call (. types index-atom) 1))
    (call (. scratch types push) value)
    (let pair (call (. types intern-tuple) mark names-mark))
    (if (not (. row is-optional))
      (return pair)
    )
    (call note-truthiness id (. row expr) value)
    (return (call (. types optional-around) pair))
  )
  (fn-do + infer-call Found
    (param id SyntaxId)
    (param callable SyntaxId)
    (param params (of RowRange SyntaxId))
    (param args (of RowRange SyntaxId))
    (param curried Bool)
    (param attributes SyntaxId (= 0))
    (param class TypeId (= no-type))
    (param want Want (= (call Want)))
    (param slots (of ImmutableArray Atom ArenaBacking) (= (call (of ImmutableArray Atom ArenaBacking))))
    (param builders (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (param context U32 (= (. U32 max)))
    ; A call written with its arguments. A markup element gives, after them, the value of each
    ; of the `attributes` its body writes for the `class` it makes, as an argument named as the
    ; property and marked as one, and its constructor the `slots` its body fills, each with the type
    ; of its builder (`builders`), and the `context` of the styles it sees. The arguments of a call of a name nothing declares are typed as
    ; the reference types them before it finds no function (`names-nothing`).
    (let owner (if-expr (call (. want asks) .want-owner) (call held-type (. want type)) no-type))
    (let params-start (. scratch types mark))
    (let param-count 0)
    (let unresolved false)
    (for (in param ([] (. tree children) params))
      (let written (call (. types evaluate-type) module tree param (. frame env)))
      (= unresolved (or unresolved (== written invalid-type)))
      (call (. scratch types push) written)
      (+= param-count 1)
    )
    (let listing (call (. tree listed-feeds) id))
    (return-if (call Found (call infer-listed-feeds id callable listing)) (if (!= listing 0)))
    (if (== (. args count) 1)
      (match? ([] (. tree nodes) callable)
        (case .node-type-arguments
          (let only ([] (. tree children) (. args start)))
          (call expect-feeds only (call (. types evaluate-type) module tree callable (. frame env)))
        )
      )
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let object (if-expr (!= attributes 0) (call CalledObject) (call type-called-object callable (. args count))))
    (let outer-unknown argument-typing)
    (let kept-mark (. kept-arguments length))
    (= argument-typing (= (. argument-typing unknown-callee) (and (== attributes 0) (call names-nothing callable args))))
    (= argument-typing (= (. argument-typing keeps) true))
    (for (in arg ([] (. tree children) args))
      (match ([] (. tree nodes) arg)
        (case (call .node-argument argument)
          (call (. scratch types push) (call infer-argument (. argument expr) (call (. tree argument-symbol) (. argument expr))))
          (call (. scratch call-arguments push)
            (block
              (arg (call argument-shape (. argument name) (. argument is-optional) (. argument expr)))
            )
          )
          (call (. scratch syntax push) arg)
        )
        (default
          (call (. scratch types push) (call infer-argument arg (call (. tree argument-symbol) arg)))
          (call (. scratch call-arguments push) (call argument-shape null false arg))
          (call (. scratch syntax push) arg)
        )
      )
    )
    (= argument-typing outer-unknown)
    (let given (or (== attributes 0) (call push-attributes attributes class)))
    (let missing (and given unresolved (call report-missing-params params)))
    (let params (call (. scratch types span) params-start param-count))
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg params)
          (arg curried)
          (arg 0)
          (arg slots)
          (arg builders)
          (arg context)
        )
      )
    )
    (= called-object object)
    (let result
      (block
        (case? (and given (not missing))
          (call infer-callable id callable arguments owner)
        )
        (default
          (call Found invalid-type)
        )
      )
    )
    (call settle-kept-arguments kept-mark (. result type))
    (= called-object (call CalledObject))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return-if (call Found invalid-type) (if (and (!= (. result type) invalid-type) (call tracks-method id callable))))
    (return result)
  )
  (fn-do _ tracks-method Bool
    (param id SyntaxId)
    (param callable SyntaxId)
    ; Reports a method called with "#" before its name, as in `c.#size()`, which tracks nothing, as
    ; only a stored property is tracked, and says whether it did.
    (let name (? Atom) null)
    (match? ([] (. tree nodes) callable)
      (case (call .node-get-expression get)
        (= name (only-if (. get name) (if (. get is-tracked))))
      )
      (case (call .node-identifier ident)
        (= name (only-if (. ident name) (if (. ident is-tracked))))
      )
    )
    (if (not name)
      (return false)
    )
    (let fact (call (. facts first-call) instance id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-method)
        (let text
          (paragraph
            (str "\"" (. name text) "\" is a method, so \"#\" before it tracks nothing; track the properties it reads instead")
          )
        )
        (call (. frame diagnose) callable .stated (call (. program store-atom) text))
        (return true)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return false)
  )
  (fn-do _ report-missing-params Bool
    (param params (of RowRange SyntaxId))
    ; Reports the first type written after a call's name that names nothing, as the reference does
    ; once it has typed the arguments. Says whether one was reported.
    (for (in param ([] (. tree children) params))
      (if (call report-missing-type param (. frame env))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + type-called-object CalledObject
    (param callable SyntaxId)
    (param count Size)
    ; Types the object of a method a call names, which the reference evaluates before the call's
    ; arguments, so that what the flow knows of it is what it knew before them. The call is
    ; settled with it once its arguments are typed (`infer-callable`). A type a static method is
    ; called on is no value, and nothing is typed of it here.
    (match? ([] (. tree nodes) callable)
      (case (call .node-get-expression get)
        (if (!= (call static-owner (. get object)) no-type)
          (return (call CalledObject))
        )
        (let writes (and (== (. get name text) "<-write") (== count 1)))
        (let rekeys (and (== (. get name text) "rekey") (== count 1)))
        (let asks-event
          (block
            (and (or writes rekeys (and (== (. get name text) "release") (== count 0))) (not (. get is-optional)))
          )
        )
        (let want (call (. (call Want) adding) .want-receiver))
        (let receiver (call infer-found (. get object) (if-expr asks-event (call (. want adding) .want-event) want)))
        (return (call CalledObject (. get object) (. receiver type) (. receiver link) (call found-event-of receiver)))
      )
    )
    (return (call CalledObject))
  )
  (fn-do + infer-callable Found
    (param id SyntaxId)
    (param callable SyntaxId)
    (param arguments Arguments)
    (param owner TypeId (= no-type))
    (for (in type (. arguments types))
      (if (== type invalid-type)
        (return (call Found invalid-type))
      )
    )
    (match? ([] (. tree nodes) callable)
      (case (call .node-c-identifier row)
        (return (call Found (call (. calls c-call) id (. row name) arguments)))
      )
      (case (call .node-type-identifier row)
        (let is-this (and (. types this-atom) (== (. row name) (. types this-atom))))
        (if (or is-this (!= (. (call (. bindings resolution-of) (. frame binding) callable) kind) .resolve-type))
          (return (call Found (call construct-type id callable arguments)))
        )
      )
      (case .node-type-arguments
        (if (!= (. (call (. bindings resolution-of) (. frame binding) callable) kind) .resolve-type)
          (return (call Found (call construct-type id callable arguments)))
        )
      )
      (case .node-type-associated
        (return (call Found (call construct-type id callable arguments)))
      )
      (case (call .node-symbol row)
        (if (!= owner no-type)
          (return (call Found (call (. calls static-call) id owner (. row name) arguments)))
        )
        (let anonymous (call anonymous-symbol callable (. row name)))
        (if (== anonymous invalid-type)
          (return (call Found invalid-type))
        )
        (if (!= anonymous no-type)
          (return (call Found (call (. calls static-call) id anonymous (. row name) arguments)))
        )
        (if (call (. calls ambiguous-case) callable (. row name))
          (return (call Found invalid-type))
        )
        (let named (call symbol-class types module (. row name)))
        (if (== named invalid-type)
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg (call (. program store-atom) (str "Unable to resolve symbol ." (. row name text))))
            )
          )
          (return (call Found invalid-type))
        )
        (return (call Found (call (. calls static-call) id named (. row name) arguments)))
      )
      (case (call .node-get-expression get)
        (let owner (call static-owner (. get object)))
        (if (!= owner no-type)
          (return (call Found (call call-static id (. get object) owner (. get name) arguments)))
        )
        (let typed called-object)
        (= called-object (call CalledObject))
        (if (!= (. typed object) (. get object))
          (= typed (call type-called-object callable (. arguments types length)))
        )
        (let receiver (. typed type))
        (if (. typed event)
          (let event (. typed event))
          (let writes (and (== (. get name text) "<-write") (== (. arguments types length) 1)))
          (let rekeys (and (== (. get name text) "rekey") (== (. arguments types length) 1)))
          (if writes
            (let published (call publish-event id (. get object) event arguments))
            (if (and (!= published invalid-type) (call optional-chained (. get object)))
              (return (call Found (call (. types optional-of) published)))
            )
            (return (call Found published))
          )
          (return (call Found (call readdress-event id (. get object) event arguments rekeys)))
        )
        (let own (. typed link))
        (if (== receiver invalid-type)
          (return (call Found invalid-type))
        )
        (if (and (call is-super-syntax (. get object)) (!= receiver (. frame self-type)))
          (call (. conversions convert) id id (. frame self-type) receiver .reason-receiver)
        )
        (let source (call projected-from (. get object) receiver))
        (if (and (!= source no-type) (not (call (. calls has-method) receiver (. get name) arguments)))
          (= receiver source)
        )
        (let form
          (scope (if-expr (. get is-optional) (call note-chain id callable receiver) plain-form)
            (lazy plain-form (. ChainForm chain-plain))
          )
        )
        (if (or (== form .chain-absent) (call absent-after (. get object) receiver))
          (return (call Found (. types null-type)))
        )
        (let optional (== form .chain-tested))
        (let held (call link-receiver (. get object) receiver own optional))
        (if (and (not optional) (not (and (call optional-chained (. get object)) (call (. types is-optional) receiver))))
          (if (call calls-property (. get object) receiver (. get name) arguments)
            (let value (. (call read-property callable (. get object) receiver (. get name)) type))
            (if (== value invalid-type)
              (return (call Found value))
            )
            (call (. facts set-node-type) instance callable value)
            (return (call Found (call call-value id callable value arguments)))
          )
          (let answered
            (call (. calls method-call)
              (block
                (arg id)
                (arg (. get object))
                (arg receiver)
                (arg (. get name))
                (arg arguments)
                (arg true)
                (arg (call row-capture-of (. get object)))
              )
            )
          )
          (if (and (!= answered invalid-type) (== (call (. types intrinsic-of) receiver) .table))
            (let op (call table-member (. get name text)))
            (if (and (!= op (. TableOp table-row)) (!= op (. TableOp table-mark)) not-capacity)
              (call plan-table id op)
            )
            (lazy not-capacity (!= op (. TableOp table-capacity)))
          )
          (if (!= answered invalid-type)
            (call plan-builder id receiver (. get name text) (. arguments types length))
          )
          (if (and (== answered (. types void-type)) (== (. get name text) "<-write"))
            (return (call Found receiver))
          )
          (return (call Found answered))
        )
        (if optional
          (call (. facts unwrapped append) (call UnwrappedFact instance (. get object) held))
        )
        (let result (call (. calls method-call) id (. get object) held (. get name) arguments true))
        (if (or (== result invalid-type) (call (. types is-optional) result))
          (return (call (. (call Found result) linking) result))
        )
        (return (call (. (call Found (call (. types optional-of) result)) linking) result))
      )
    )
    (if (or (call is-super-syntax callable) (call (. tree names-super) callable))
      (return (call Found (call super-call id callable arguments)))
    )
    (let resolution (call (. bindings resolution-of) (. frame binding) callable))
    (match (. resolution kind)
      (case= .resolve-function
        (let name (call (. tree identifier-name) callable))
        (if (not name)
          (call decline id)
          (return (call Found invalid-type))
        )
        (if (and (call in-eager) (call is-method (. resolution module) (. resolution decl)))
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg (call (. program store-atom) (call eager-call-message name (. resolution module) (. resolution decl))))
            )
          )
          (return (call Found invalid-type))
        )
        (let answered (call (. calls function-call) id name arguments))
        (if (and (!= answered invalid-type) (call is-method (. resolution module) (. resolution decl)))
          (call plan-builder id (. frame self-type) (. name text) (. arguments types length))
        )
        (return (call Found answered))
      )
      (case= .resolve-type
        (let called (call (. tree identifier-name) callable))
        (if (and called (. types this-atom) (== called (. types this-atom)))
          (return (call Found (call construct-type id callable arguments)))
        )
        (if (call (. types const-array-decl refers-to) (. resolution module) (. resolution decl))
          (return (call Found (call construct-type id callable arguments)))
        )
        (if (and (== (. resolution module) (. types table-module)) (not (call is-row-table callable arguments)))
          (return (call Found invalid-type))
        )
        (let (tuple class-module class-decl) (call taking-class callable (. resolution module) (. resolution decl)))
        (return (call Found (call (. calls construction) id callable class-module class-decl arguments)))
      )
      (case= .resolve-slot
        (if (!= (. ([] (. bindings slots) (. resolution slot)) getter) 0)
          (call decline callable)
          (return (call Found invalid-type))
        )
        (if (call precedes-declaration (. resolution slot))
          (call (. frame diagnose) id .function-not-found (call (. tree identifier-name) callable))
          (return (call Found invalid-type))
        )
        (if (call wavers (. resolution slot))
          (call decline id)
          (return (call Found invalid-type))
        )
        (let called (call read-slot (. resolution slot) id))
        (let declared (call slot-known (. resolution slot)))
        (if (and (!= declared called) (call (. types is-optional) declared) unwraps-called)
          (call (. facts set-plan) instance callable .plan-callee)
        )
        (lazy unwraps-called (== (call (. types optional-inner) declared) called))
        (return (call Found (call call-value id callable called arguments)))
      )
      (case= .resolve-member
        (let name (call (. tree identifier-name) callable))
        (if (not name)
          (call decline id)
          (return (call Found invalid-type))
        )
        (let held (. (call read-member callable name) type))
        (let key (call member-key (. resolution module) (. resolution decl)))
        (let narrowed (if-expr (. frame members-narrowed) (call (. frame narrowed-member) key) no-type))
        (let declared (if-expr (!= narrowed no-type) (call key-declared key) no-type))
        (let unwraps
          (scope (and optional-declared (== (call (. types optional-inner) declared) held))
            (lazy optional-declared (and (!= declared no-type) (call (. types is-optional) declared)))
          )
        )
        (if (and (!= held invalid-type) (== held narrowed) (or callable-held unwraps))
          (call (. facts set-plan) instance callable .plan-callee)
        )
        (lazy callable-held (!= (call function-row types held) no-type))
        (return (call Found (call call-value id callable held arguments)))
      )
      (case= .resolve-global
        (let held (call infer-node callable (call Want)))
        (if (== held invalid-type)
          (return (call Found held))
        )
        (return (call Found (call call-value id callable held arguments)))
      )
      (case= .resolve-unresolved
        (let name (call (. tree identifier-name) callable))
        (if (not name)
          (return (call Found invalid-type))
        )
        (let bound (call (. types env-lookup) (. frame env) name))
        (if bound
          (return (call Found (call (. calls construction-on) id bound arguments true callable)))
        )
        (return (call Found (call (. calls function-call) id name arguments)))
      )
      (default
        (let target (call infer callable))
        (if (== target invalid-type)
          (return (call Found target))
        )
        (let kind (call (. types intrinsic-of) target))
        (if (or (== kind .closure) (== kind .binding) (!= (call function-row types target) no-type))
          (return (call Found (call (. calls slot-call) id target arguments)))
        )
        (return (call Found (call (. calls method-call) id callable target (!! (. types call-atom)) arguments)))
      )
    )
  )
  (fn-expr _ calls-property Bool
    (param object SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param arguments Arguments)
    ; Whether a call written as a method call reads a property and calls what it holds, as the
    ; reference does where the receiver has no method of the name but a property or a getter of
    ; it. A union, a type given as a value, and `super` are called only for their methods.
    (case? (call is-super-syntax object)
      false
    )
    (case? (or (== kind .union) (== kind .type-info) (call (. calls has-method) receiver name arguments))
      false
    )
    (default
      (or (!= (call property-named receiver name) null) (call (. calls has-getter) receiver name))
    )
    (where
      (lazy kind (call (. types intrinsic-of) receiver))
    )
  )
  (fn-do _ super-call TypeId
    (param id SyntaxId)
    (param callable SyntaxId)
    (param arguments Arguments)
    ; `super(...)` runs the base class's constructor: only in a constructor, only as its first
    ; statement, and only when there is a base.
    (let self (. frame self-type))
    (let based (and (!= self no-type) (!= self invalid-type) (!= (call (. types base-of) self) null)))
    (let message "")
    (if (not based)
      (= message "super requires a base type")
      (else-if (not (call is-constructor-kind (. frame declaration kind)))
        (= message "super constructor call is only allowed in constructors")
      )
      (else-if (or (== (. (call body-statements) count) 0) (!= ([] (. tree children) (. (call body-statements) start)) id))
        (= message "super constructor call must be first")
      )
    )
    (if (!= (. message length) 0)
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (return (call (. calls construction-on) id (call super-type) arguments false callable))
  )
  (fn-do _ call-value TypeId
    (param id SyntaxId)
    (param callable SyntaxId)
    (param target TypeId)
    (param arguments Arguments)
    ; A call of what a name holds: a value of a function type is called, and a value of any
    ; other type is given to the function its type declares for a call of it.
    (if (or (== target invalid-type) (== (. ([] (. types completions) target) intrinsic) .closure))
      (return (call (. calls slot-call) id target arguments))
    )
    (call (. types complete) target)
    (let kind (. ([] (. types completions) target) intrinsic))
    (if (and (!= kind .binding) (== (call function-row types target) no-type))
      (return (call (. calls method-call) id callable target (!! (. types call-atom)) arguments))
    )
    (return (call (. calls slot-call) id target arguments))
  )
  (fn-expr _ type-head SyntaxId
    (param id SyntaxId)
    ; The name a type is written with, under the arguments it is given.
    (match ([] (. tree nodes) id)
      (case (call .node-type-arguments row)
        (call type-head (. row base))
      )
      (default
        id
      )
    )
  )
  (fn-do _ construct-type TypeId
    (param id SyntaxId)
    (param callable SyntaxId)
    (param arguments Arguments)
    (if (call names-const-array callable)
      (call (. frame diagnose) id .stated (call (. program store-atom) "ConstArray requires one item type"))
      (return invalid-type)
    )
    (call (. types clear-fault))
    (let receiver (call (. types evaluate-type) module tree callable (. frame env)))
    (if (== receiver invalid-type)
      (if (or (call report-circular) (call report-fault callable))
        (return invalid-type)
      )
      (let head (call type-head callable))
      (if (call names-nothing head)
        (call (. frame diagnose) head .constructor-not-found)
        (else
          (call decline id)
        )
      )
      (return invalid-type)
    )
    (if (call is-const-array receiver)
      (let item (call cpointer-item receiver))
      (let items (list ConstItem))
      (let folds true)
      (for (in position (..< 0 (. arguments types length)))
        (let site ([] (. arguments syntax) position))
        (let shape ([] (. arguments shapes) position))
        (if (or (. shape name) (. shape is-property))
          (call (. frame diagnose) site .stated (call (. program store-atom) "Illegal ConstArray item"))
          (return invalid-type)
        )
        (call (. conversions convert) site site ([] (. arguments types) position) item .reason-argument)
        (if (call is-computed site)
          (let message (call (. program store-atom) "ConstArray item must be constant"))
          (call (. frame diagnose) site .stated message)
          (return invalid-type)
        )
        (let folded (call fold-const-item site item))
        (if folded
          (+= items folded)
          (else
            (= folds false)
          )
        )
      )
      (if folds
        (call (. facts note-const-array) instance id receiver items)
      )
      (return receiver)
    )
    (let by-name true)
    (match? ([] (. tree nodes) callable)
      (case (call .node-type-identifier row)
        (if (and (. types this-atom) (== (. row name) (. types this-atom)))
          (= by-name false)
          (if (!= (. frame self-type) no-type)
            (= receiver (. frame self-type))
          )
        )
      )
    )
    (if (not (call check-table-row receiver arguments))
      (return invalid-type)
    )
    (return
      (call (. calls construction-on)
        (block
          (arg id)
          (arg receiver)
          (arg arguments)
          (arg by-name)
          (arg (if-expr (is ([] (. tree nodes) id) .node-markup) id callable))
        )
      )
    )
  )
  (fn-do _ fold-const-item (? ConstItem)
    (param site SyntaxId)
    (param item TypeId)
    ; An item of a ConstArray as TypeScript lays it down: a string literal, or a number folded
    ; to its bits and cut to the width of an integer item. Nothing for any other.
    (match? ([] (. tree nodes) site)
      (case (call .node-argument row)
        (return (call fold-const-item (. row expr) item))
      )
      (case .node-string-syntax
        (if (== item (. types string-type))
          (return (call ConstItem 0 site))
        )
        (return null)
      )
    )
    (let kind (. ([] (. types completions) item) intrinsic))
    (if (not (call is-integer-kind kind))
      (return null)
    )
    (let folded (call fold-number site))
    (if (not (. folded folds))
      (return null)
    )
    (return (call ConstItem (call cut-bits (. folded bits) item) 0))
  )
  (fn-do _ fold-number FoldedNumber
    (param site SyntaxId)
    ; The integer a literal number is, negated or cast to an integer type, as its bits.
    (match? ([] (. tree nodes) site)
      (case (call .node-argument row)
        (return (call fold-number (. row expr)))
      )
      (case (call .node-integer-syntax row)
        (let literal (call parse-integer-literal (. row value)))
        (if (. literal overflow)
          (return (call FoldedNumber 0 false))
        )
        (return (call FoldedNumber (if-expr (. literal negative) (- 0 (. literal value)) (. literal value)) true))
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .negative-op)
          (let inner (call fold-number (. row operand)))
          (return (call FoldedNumber (- 0 (. inner bits)) (. inner folds)))
        )
      )
      (case (call .node-cast-expression row)
        (let inner (call fold-number (. row lhs)))
        (let target (call (. types evaluate-type) module tree (. row rhs) (. frame env)))
        (if (and (. inner folds) (!= target invalid-type) integer-target)
          (return (call FoldedNumber (call cut-bits (. inner bits) target) true))
        )
        (lazy integer-target (call is-integer-kind (. ([] (. types completions) target) intrinsic)))
      )
    )
    (return (call FoldedNumber 0 false))
  )
  (fn-expr _ cut-bits U64
    (param bits U64)
    (param type TypeId)
    ; Bits cut to the width of an integer type and extended by its sign.
    (case? (or (>= width 64) (== width 0))
      bits
    )
    (default
      (if-expr negative (/or/ kept (/xor/ mask (. U64 max))) kept)
    )
    (where
      (lazy row ([] (. types completions) type))
      (lazy width (as (. row bit-size) U64))
      (lazy mask (- (/lshift/ 1u64 width) 1))
      (lazy kept (/and/ bits mask))
      (lazy negative (and (. row is-signed) (!= (/rshift/ kept (- width 1)) 0)))
    )
  )
  (fn-do _ taking-class (tuple ModuleId DeclId)
    (param callable SyntaxId)
    (param named-module ModuleId)
    (param named DeclId)
    ; The class a callable written with type arguments makes: the one its name resolves to, or where
    ; that takes fewer type arguments than are written, the first class of the name this module sees
    ; that takes as many or more, as the reference passes over one that takes fewer.
    (match? ([] (. tree nodes) callable)
      (case (call .node-type-arguments row)
        (let given Size (. row args count))
        (let taken Size (. (call (. types class-type-args) named-module named) count))
        (let name (call (. types type-syntax-name) tree (. row base)))
        (if (and (< taken given) name)
          (for (in candidate (call (. program lookup) module name))
            (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
              (case .decl-class
                (let held Size (. (call (. types class-type-args) (. candidate module) (. candidate decl)) count))
                (if (>= held given)
                  (return (tuple (. candidate module) (. candidate decl)))
                )
              )
            )
          )
        )
      )
    )
    (return (tuple named-module named))
  )
  (fn-do _ names-const-array Bool
    (param callable SyntaxId)
    ; Whether a callable names ConstArray without the type of its items.
    (match? ([] (. tree nodes) callable)
      (case (call .node-type-identifier row)
        (if (!= (. row name) (!! (. types const-array-atom)))
          (return false)
        )
        (let named (call (. types type-named) module (. row name) (. frame env)))
        (return (and (!= named invalid-type) (call is-const-array named)))
      )
    )
    (return false)
  )
  (fn-do _ is-computed Bool
    (param site SyntaxId)
    ; Whether an item is the result of a call, which no constant array can hold.
    (match? ([] (. tree nodes) site)
      (case (call .node-argument row)
        (return (call is-computed (. row expr)))
      )
      (case (call .node-call-expression row)
        (match? ([] (. tree nodes) (. row callable))
          (case .node-identifier
            (return true)
          )
          (case .node-get-expression
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ call-static TypeId
    (param id SyntaxId)
    (param object SyntaxId)
    (param owner TypeId)
    (param name Atom)
    (param arguments Arguments)
    ; A call on a type. It is a call of a static method when the type is a type parameter, an
    ; interface, or a type that declares a static method of the name: a type parameter answers
    ; only what its constraints declare, an interface answers nothing itself, and a static method
    ; that takes no such arguments is reported as one.
    (let dependent (call dependent-name object))
    (let interface (== (call (. types intrinsic-of) owner) .interface))
    (if (and (not dependent) (not interface) (not (call declares-static owner name)))
      (let answered (call (. calls static-call) id owner name arguments))
      (call note-type-value id object)
      (return answered)
    )
    (if (and (not dependent) interface)
      (let message "Static methods cannot be called on an interface type")
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (and dependent (not (call requires-static dependent name)))
      (let shown (. dependent text))
      (let message (str "Static method " (. name text) " is not declared by constraints on " shown))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let diagnosed (. facts diagnostics length))
    (let result (call (. calls static-call) id owner name arguments))
    (if (== result invalid-type)
      (let message (call (. program store-atom) "Static function not found"))
      (call (. facts restate) diagnosed instance id .function-not-found .stated message)
    )
    (return result)
  )
  (fn-do _ note-type-value _
    (param id SyntaxId)
    (param object SyntaxId)
    ; A type that no static method answers for is called as the value describing it, and the
    ; type's name is that value.
    (let fact (call (. facts first-call) instance id))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return)
    )
    (let receiver (. ([] (. instances rows) (. ([] (. facts calls) fact) callee)) self-type))
    (if (and (!= receiver no-type) (== (call (. types intrinsic-of) receiver) .type-info))
      (call (. facts set-node-type) instance object receiver)
    )
  )
  (fn-do _ dependent-name (? Atom)
    (param object SyntaxId)
    ; The type parameter a type's name stands for, when it names one.
    (match? ([] (. tree nodes) object)
      (case (call .node-type-identifier row)
        (let this-name (. types this-atom))
        (if (and this-name (== this-name (. row name)))
          (return null)
        )
        (if (call (. types env-lookup) (. frame env) (. row name))
          (return (. row name))
        )
      )
    )
    (return null)
  )
  (fn-do _ requires-static Bool
    (param param Atom)
    (param name Atom)
    ; Whether a constraint on a type parameter, of the function or converter or of the type it
    ; belongs to, declares a static method of the name.
    (let decls (. ([] (. program modules) module) decls))
    (let decl (. frame decl))
    (while (!= decl 0)
      (let constraints (call (of RowRange SyntaxId)))
      (let next 0u32)
      (match? ([] decls decl)
        (case (call .decl-function fn)
          (= constraints (. fn param-constraints))
          (= next (. fn owner))
        )
        (case (call .decl-converter converter)
          (= constraints (. converter param-constraints))
          (= next (. converter owner))
        )
        (case (call .decl-fromverter fromverter)
          (= next (. fromverter owner))
        )
        (case (call .decl-class class)
          (= constraints (. class param-constraints))
        )
      )
      (for (in constraint ([] (. tree children) constraints))
        (match? ([] (. tree nodes) constraint)
          (case (call .node-param-constraint row)
            (let constrained (call (. types type-syntax-name) tree (. row left)))
            (if (and constrained (== constrained param))
              (let bound (call (. types evaluate-type) module tree (. row right) (. frame env)))
              (if (and (!= bound invalid-type) (call declares-static bound name))
                (return true)
              )
            )
          )
        )
      )
      (= decl next)
    )
    (return false)
  )
  (fn-do _ declares-static Bool
    (param type TypeId)
    (param name Atom)
    ; Whether a type, a base of it, or an interface it implements declares a static method.
    (call (. types complete) type)
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (let owner ([] (. program modules) (. row module)))
        (match? ([] (. owner decls) (. row decl))
          (case (call .decl-class class)
            (for (in member (call (. owner members-named) (. class members) name))
              (match? ([] (. owner decls) member)
                (case (call .decl-function fn)
                  (if (and (. fn is-static) (. fn name) (== (. fn name) name))
                    (return true)
                  )
                )
              )
            )
          )
        )
      )
    )
    (for (in interface (call (. types interfaces-of) type))
      (if (call declares-static interface name)
        (return true)
      )
    )
    (let base (call (. types base-of) type))
    (if base
      (return (call declares-static base name))
    )
    (return false)
  )
  (fn-do + call-override TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param exchanged Bool)
    ; Calls the operator one operand declares for the other, which for equality may be either
    ; operand, and gives no type when neither declares it. `exchanged` says the operands arrive
    ; in the reverse of their order in the source, so the call notes when its receiver is the
    ; operator's right operand.
    (let token (call (. program store-atom) (str op)))
    (if (call (. calls has-operator) lhs token rhs)
      (let result (call (. calls operator-call) id lhs token right rhs))
      (if (and exchanged (!= result invalid-type))
        (call (. facts mark-swapped) instance id)
      )
      (return result)
    )
    (let either (or (== op .equals-op) (== op .not-equals-op)))
    (if (and either (call (. calls has-operator) rhs token lhs))
      (let result (call (. calls operator-call) id rhs token left lhs))
      (if (and (not exchanged) (!= result invalid-type))
        (call (. facts mark-swapped) instance id)
      )
      (return result)
    )
    (return no-type)
  )
)
