    (let resolution (call (. bindings resolution-of) (. frame binding) clause))
    (if (or (!= (. resolution kind) .resolve-slot) (call in-batch))
      (call decline id)
      (return)
    )
    (let passed (call infer expr))
    (if (== passed invalid-type)
      (return)
    )
    (if (not (call (. tree tracks-reads) expr))
      (call (. frame diagnose)
        (block
          (arg clause)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg "whenever clauses must read at least one tracked property (like #is-open)")
              )
            )
          )
        )
      )
      (return)
    )
    (if (!= passed (. types bool-type))
      (call decline clause)
      (return)
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (let wrapped (call (. types well-known-type-of) "core/stream" "Subscription" item))
    (let subscribable (call (. types well-known-type-of) "core/stream" "Subscribable" item))
    (if (or (== (. live action) no-instance) (== (. live previous) no-instance) missing-links)
      (call decline id)
      (return)
    )
    (lazy missing-links (or (== (. live next) no-instance) (== (. live trackers) no-instance)))
    (if (or (== wrapped invalid-type) (== subscribable invalid-type))
      (call decline id)
      (return)
    )
    (let kept no-type)
    (if (call owns-subscription id)
