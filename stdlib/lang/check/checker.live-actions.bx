      (call (. scratch types rewind) mark)
      (call (. scratch types push) (call (. types well-known-type) "core" "Pointer"))
      (let dependency (call (. program store-atom) "track-active-dependency"))
      (= (. live track-active-collection) (call (. calls demand-runtime-call) module no-type dependency mark))
