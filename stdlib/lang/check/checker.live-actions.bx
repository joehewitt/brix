(import ./binding)
(import ./calls)
(import ./checker)
(import ./checker.assignments)
(import ./checker.comprehensions)
(import ./checker.loops)
(import ./checker.markup)
(import ./checker.styles)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ LiveActions (facet-of Checker)
  (sees Assignments)
  (sees Comprehensions)
  (sees Loops)
  (sees Markup)
  (sees Styles)
  (prop _ subscribed-event (? NamedEvent) (= null))
  (prop _ subscribed-by InstanceId (= no-instance))
  (fn-do + demand _
    (param callee InstanceId)
    ; Readies what a call reads of a callee. A header that gives the return type is enough, and
    ; the body stays in the queue. Otherwise the body is typed now, as it is for a statement that a
    ; finally block watches. A call of a rule under a helper, which may run the rule typed for the
    ; helper in its place, queues a rule that states its type too, as `promise` says. A callee that
    ; may not use the heap is typed now, as TypeScript compiles it where it is called, so that what
    ; allocates there is found in the order TypeScript finds it. One another pass of a parallel type
    ; pass published is taken in from it (`adopt`).
    (if (or (!= (. ([] (. instances rows) callee) state) .instance-unstarted) (call adopt session callee))
      (return)
    )
    (if (== (. ([] (. instances rows) callee) origin) no-instance)
      (= (. ([] (. instances rows) callee) origin) instance)
    )
    (let heapless (!= (/and/ (. ([] (. instances rows) callee) effects) (. CompilationEffect no-heap)) 0))
    (if (and (== watching-leaves 0) (not heapless) (call settle-header session callee))
      (call (. instances queue) callee)
      (return)
    )
    (if (and deferring (call promise callee))
      (call (. instances queue) callee)
      (return)
    )
    (call demand-body callee)
  )
  (fn-do + note-live-call _
    (param id SyntaxId)
    (param name Atom)
    (call demand-live-runtime)
    (let live (. instances live))
    (if (or (== (. live enter) no-instance) (== (. live leave) no-instance))
      (call decline id)
      (return)
    )
    (if (!= (. frame declaration kind) .live-decl)
      (let context (call live-context (call read-site id)))
      (if (and (== context .live-value) (call is-eager-value))
        (call (. instances mark-live) instance)
        (else-if (and (== context .live-rule) (call is-rule-unit))
          (call (. instances mark-live) instance)
        )
        (else-if (== context .live-statement)
          (call note-live-statement (call read-site id))
        )
        (else-if (and (!= context .live-region) (!= context .live-gate))
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg (str "The live function \"" (. name text) "\" is called only where a value is read live"))
                  )
                )
              )
            )
          )
          (return)
        )
      )
    )
    (call (. facts set-plan) instance id .plan-live-call)
  )
  (fn-do + check-rerun _
    (param statement SyntaxId)
    ; The function a live action runs a live statement again with, as the reference compiles it: the
    ; statement typed again as the body of a closure, which answers nothing. A declaration's value is
    ; typed again and stored in the local it declares, which must hold it as it is; one some read tracks
    ; is stored through the list of subscribers it reaches. An attribute's value is typed again for the
    ; property of the element's object it names, kept where the element was made, or for the style
    ; property it declares, and an argument of an element for the property its parameter names, and so
    ; is the value of a line of a style rule for the property of the object it is applied to. A line
    ; of an element's body is absorbed again by the element, kept where it was made (`absorb-again`), or
    ; replaces what it took (`replace-again`). The value of a stream of a value as it changes is written
    ; again to its channel (`stream-again`). An error that leaves the statement is given to
    ; `unhandled-error` (`hand-off-outgoing`).
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (match? ([] (. tree nodes) statement)
      (case (call .node-iterable-expression row)
        (if (not (call stream-again statement (. row expr)))
          (call decline statement)
        )
        (call hand-off-outgoing statement)
        (call finish-errors frame)
        (call close)
        (return)
      )
    )
    (if (call (. tree content-line) statement)
      (let kept (call line-keeper statement))
      (let made (if-expr (!= kept no-slot) (call (. frame slot-type) kept) no-type))
      (let previous (if-expr (!= kept no-slot) (call (. frame slot-type) (+ kept 1)) no-type))
      (let absorbs (== previous (. types void-type)))
      (if (or (== made no-type) (== previous no-type) (and absorbs (not (call absorb-again statement made))) (and (not absorbs) (not (call replace-again statement made previous))))
        (call decline statement)
      )
      (call hand-off-outgoing statement)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let element (call (. tree argument-element) statement))
    (if (!= element 0)
      (let resolution (call (. bindings resolution-of) (. frame binding) element))
      (let made (if-expr (== (. resolution kind) .resolve-slot) (call (. frame slot-type) (. resolution slot)) no-type))
      (if (== made no-type)
        (call decline statement)
        (else
          (do
            (inline (call argument-again statement made))
          )
        )
      )
      (call hand-off-outgoing statement)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let bound (call (. tree bound-attribute) statement))
    (if (!= bound 0)
      (if (not (call bind-again statement bound))
        (call decline statement)
      )
      (call hand-off-outgoing statement)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (!= (call (. tree attribute-element) statement) 0)
      (let resolution (call (. bindings resolution-of) (. frame binding) statement))
      (let made (if-expr (== (. resolution kind) .resolve-slot) (call (. frame slot-type) (. resolution slot)) no-type))
      (let styled (call (. facts style-declaration-of) (. ([] (. instances rows) instance) enclosing) statement))
      (match? ([] (. tree nodes) statement)
        (case (call .node-assign row)
          (let name (call style-name tree (. row lhs)))
          (if styled
            (if (or (== made no-type) (not (call style-again statement (. row rhs) styled)))
              (call decline statement)
            )
            (else-if (== made no-type)
              (call decline statement)
            )
            (else-if (and name (call attribute-accessor made name))
              (do
                (inline (call setter-attribute statement (. row op) (. row lhs) (. row rhs) made))
              )
            )
            (else-if (== (call attribute-type statement (. row op) (. row lhs) (. row rhs) made) invalid-type)
              (call decline statement)
            )
          )
        )
      )
      (call hand-off-outgoing statement)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (call (. facts rule-update-of) (. ([] (. instances rows) instance) enclosing) statement)
      (let resolution (call (. bindings resolution-of) (. frame binding) statement))
      (let made (if-expr (== (. resolution kind) .resolve-slot) (call (. frame slot-type) (. resolution slot)) no-type))
      (match? ([] (. tree nodes) statement)
        (case (call .node-assign row)
          (if (or unmade (== (call attribute-type statement (. row op) (. row lhs) (. row rhs) made) invalid-type))
            (call decline statement)
          )
          (lazy unmade (== made no-type))
        )
      )
      (call hand-off-outgoing statement)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (match ([] (. tree nodes) statement)
      (case (call .node-declare declaration)
        (let slot (call declaring-slot (. declaration left)))
        (let value (if-expr slot (call infer-declared (. declaration left) (. declaration right)) invalid-type))
        (let tracked (and slot (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-tracked)) 0)))
        (if (or (not slot) (== value invalid-type) (!= value (call (. frame slot-type) slot)))
          (call decline statement)
          (else-if (and tracked (not (call (. frame is-captured) (call subscribers-slot slot))))
            (call decline statement)
          )
          (else-if tracked
            (call demand-live-runtime)
          )
        )
      )
      (default
        (call check-statement statement)
      )
    )
    (call hand-off-outgoing statement)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ bind-again Bool
    (param anchor SyntaxId)
    (param statement SyntaxId)
    (let resolution (call (. bindings resolution-of) (. frame binding) statement))
    (let made (if-expr (== (. resolution kind) .resolve-slot) (call (. frame slot-type) (. resolution slot)) no-type))
    (let name (call (. tree identifier-name) anchor))
    (return-if false (if (or (== made no-type) (not name))))
    (blank)
    (let found (call property-named made name))
    (return-if false (if (or (not found) (!= (. ([] (. types properties) found) storage-kind) .storage-eager))))
    (blank)
    (let property ([] (. types properties) found))
    (let declared (if-expr (!= (. property type) no-type) (. property type) (call demand-member property made name)))
    (return-if false (if (or (== declared no-type) (== declared invalid-type))))
    (blank)
    (let ref (call class-ref types (call (. types tracked-root) (. property owner) name)))
    (call (. facts note-tracked) (. ref module) (. ref decl) name)
    (call (. instances mark-may-panic) instance)
    (call demand-live-runtime)
    (match? ([] (. tree nodes) statement)
      (case (call .node-assign row)
        (= standing anchor)
        (= standing-type (if-expr (call takes-held declared (call named-place-type (. row rhs))) (call (. types optional-inner) declared) declared))
        (let stored (call infer-assign anchor .eq-op (. row rhs) anchor (call Want)))
        (= standing 0)
        (= standing-type no-type)
        (return-if false (if (or (== stored invalid-type) (== stored no-type))))
        (blank)
        (let held (call place-type (. row rhs)))
        (if (and (!= held declared) (!= held no-type) (!= held invalid-type) (call writes-back declared))
          (return-if false (if (== (call (. conversions convert) statement (. row rhs) held declared .reason-assignment) invalid-type)))
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ takes-held Bool
    (param property TypeId)
    (param place TypeId)
    (return-if false (if (or (not (call (. types is-optional) property)) (== place no-type) (== place invalid-type) (call (. types is-optional) place))))
    (return-if false (if (call (. relations implicit) (call (. conversions compare-held) property place))))
    (return (call (. relations implicit) (call (. conversions compare-held) (call (. types optional-inner) property) place)))
  )
  (fn-do _ named-place-type TypeId
    (param place SyntaxId)
    (match? ([] (. tree nodes) place)
      (case (call .node-get-expression row)
        (return (call member-type (call named-place-type (. row object)) (. row name)))
      )
    )
    (return (call place-type place))
  )
  (fn-do _ place-type TypeId
    (param place SyntaxId)
    (match? ([] (. tree nodes) place)
      (case (call .node-identifier row)
        (let resolution (call (. bindings resolution-of) (. frame binding) place))
        (if (== (. resolution kind) .resolve-slot)
          (return (call (. frame slot-type) (. resolution slot)))
        )
        (if (== (. resolution kind) .resolve-member)
          (return (call member-type (. frame self-type) (. row name)))
        )
      )
      (case (call .node-get-expression row)
        (return (call member-type (call (. facts node-type) instance (. row object)) (. row name)))
      )
    )
    (return no-type)
  )
  (fn-expr _ writes-back Bool
    (param type TypeId)
    (or (call intrinsic-is-numeric intrinsic) (== intrinsic .bool))
    (where
      (lazy intrinsic (call (. types intrinsic-of) type))
    )
  )
  (fn-do + demand-rules _
    (param receiver TypeId)
    (param site SyntaxId)
    (param body SyntaxId (= 0))
    ; Types the rules of a class being made and of the classes above it, each for the class that
    ; writes it as the receiver holds it: the constructor runs them once its body has run, or
    ; the function that fills the object with the markup of the class that writes one runs it once
    ; that markup has (`waits-for-markup`), so what they run may panic, and the errors a section
    ; lets out as it subscribes leave the constructor at `site`. A `when` or `whenever` rule the
    ; constructor runs gives the object a live action (`own-markup-actions`), and one on the markup
    ; the object is in registers the object as its markup host (`host-self`). The errors such a
    ; rule lets out the first time it runs leave the constructor at `site`, and those it lets out
    ; when its action runs it again are handed off (`hands-off`), as the reference does; one that
    ; runs on the markup, or once the markup of its class has, that lets out errors has no shape
    ; here. A dependency the
    ; class that writes it subscribes otherwise than the object's class would, as one is a markup
    ; host and the other is not, has no shape here, nor have rules where the
    ; constructor's body returns before its end, unless each is a section the event runtime runs
    ; from the table of the class, which no object subscribes. Which sections those are is
    ; planned first, since it decides how they are typed. One function fills the objects of
    ; every class below the one that writes the markup, while the reference makes one for each
    ; class it constructs: a section run there that some such class runs from its table and
    ; another subscribes has no shape here, and nor has one that lets out errors.
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .class))
      (return)
    )
    (call plan-event-handlers receiver site)
    (let level (? TypeId) receiver)
    (let found false)
    (let ran false)
    (while level
      (for (in ref (call sheet-parts (call class-ref types level)))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (let written SyntaxId 0)
          (match? ([] (. owner decls) member)
            (case (call .decl-rule rule)
              (= written (. rule syntax))
            )
          )
          (if (== written 0)
            (continue)
          )
          (= found true)
          (let section (call section-loop (. ref module) written))
          (let tabled (call (. facts lowers) receiver (. ref module) section))
          (let waits (call waits-for-markup level (. ref module) written))
          (if (and waits tabled (call (. facts holds-section) subscriptions level (. ref module) section))
            (call decline site)
            (return)
          )
          (lazy subscriptions (. facts subscribed-sections))
          (if (and dependency-line (!= (call is-markup-host receiver) (call is-markup-host level)))
            (call decline site)
            (return)
          )
          (lazy dependency-line (is ([] (. owner tree nodes) written) .node-dependency-declaration))
          (if (and (not waits) (call (. owner tree is-live-rule) written))
            (= live-owned true)
          )
          (if (and (call (. owner tree is-markup-trigger) written) (not (call host-self receiver site)))
            (call decline site)
            (return)
          )
          (if (and (not ran) (not tabled))
            (= ran true)
            (if (and (!= body 0) (call (. tree leaves-early) body))
              (call decline body)
              (return)
            )
          )
          (let unit (call (. instances intern-initializer) (. ref module) member level))
          (call demand-body unit)
          (if (and waits (not (call (. facts waits-for-markup) unit)))
            (+= (. facts markup-rules) unit)
          )
          (if (and waits (!= section 0) (not tabled))
            (call demand-errors unit)
            (if (!= (. ([] (. instances signatures) unit) errors count) 0)
              (call decline site)
              (return)
            )
          )
          (if (!= section 0)
            (call note-unit-errors unit site)
            (else-if (call (. owner tree is-live-rule) written)
              (call demand-errors unit)
              (if (!= (. ([] (. instances signatures) unit) errors count) 0)
                (if (or waits (call (. owner tree is-markup-trigger) written) (not (call hands-off unit)))
                  (call decline site)
                  (return)
                )
                (call note-unit-errors unit site)
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (if found
      (call (. instances mark-may-panic) instance)
    )
  )
  (fn-do + waits-in-rule Bool
    ; Whether the instance types a rule of a class that runs once the markup of the class has.
    (let unit ([] (. instances rows) instance))
    (if (or (== (. unit initializer) 0) (== (. frame self-type) no-type))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-rule row)
        (return (call waits-for-markup (. frame self-type) (. unit module) (. row syntax)))
      )
    )
    (return false)
  )
  (fn-do _ plan-event-handlers _
    (param receiver TypeId)
    (param site SyntaxId)
    ; The sections of a class being made, and of the classes above it, base first, that the
    ; reference runs from a table of the class rather than subscribing them for each object, as it
    ; plans them once for the class. Each section on an event of the object itself, its name alone
    ; or read from `this` in a loop of one header, counts among those of the event in order. One
    ; is run from the table where no section before it on the event was subscribed, the event is
    ; not published by key, no constructor of the class or of one above it subscribes to the event,
    ; its loop has no clause but one `when arrival` or `when bubbling`, and its body neither leaves
    ; it, writes a function, nor names an argument of a constructor of the class that writes it. The
    ; event runtime's `event-register-lowered` puts it in the table, or its
    ; `event-register-lowered-arrival` where it hears only what arrives at its object. A section run from the table for every class
    ; planned when it is typed is typed so alone; a class planned after that which subscribes it
    ; has no shape here. A class whose chain writes no section has nothing to plan. A class planned
    ; already is found by its type. An edit typed again in place keeps the plans, as long as it does
    ; not change what the constructors it edits subscribe to (`retype-edit`).
    (for (in planned (. facts lowered-types))
      (if (== planned receiver)
        (return)
      )
    )
    (let chain (list TypeId))
    (let level (? TypeId) receiver)
    (while level
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (if (not (call writes-sections chain))
      (return)
    )
    (+= (. facts lowered-types) receiver)
    (let heard (call constructor-events receiver chain))
    (let owners (list TypeId))
    (let names (list Atom))
    (let counts (list U32))
    (let closed (list Bool))
    (for (in offset (..< 0 (. chain length)))
      (let holder ([] chain (- (. chain length) 1 offset)))
      (for (in ref (call sheet-parts (call class-ref types holder)))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (let syntax SyntaxId 0)
          (match? ([] (. owner decls) member)
            (case (call .decl-rule rule)
              (= syntax (. rule syntax))
            )
          )
          (let found (only-if (call section-event receiver (. ref module) syntax) (if (!= syntax 0))))
          (if (not found)
            (continue)
          )
          (let event found)
          (let index (. owners length))
          (for (in position (..< 0 (. owners length)))
            (if (and (== ([] owners position) (. event owner)) (== ([] names position) (. event name)))
              (= index position)
            )
          )
          (if (== index (. owners length))
            (+= owners (. event owner))
            (+= names (. event name))
            (+= counts 0)
            (+= closed false)
          )
          (let order ([] counts index))
          (= ([] counts index) (+ order 1))
          (let subscribed false)
          (for (in other heard)
            (if (and (== (. other owner) (. event owner)) (== (. other name) (. event name)))
              (= subscribed true)
            )
          )
          (let iterator (call section-loop (. ref module) syntax))
          (let arrives (== (call section-delivery (. ref module) syntax) 1))
          (if (and open-event lowerable-section (== (. facts event-register) no-instance))
            (call demand-event-register)
          )
          (lazy open-event (and (== (. event key) no-type) (not ([] closed index)) (not subscribed)))
          (lazy lowerable-section (call lowerable (. ref module) (. ref decl) syntax))
          (let registers (if-expr arrives (. facts event-register-arrival) (. facts event-register)))
          (if (or closed-event not-lowered (== registers no-instance))
            (= ([] closed index) true)
            (if (call (. facts holds-section) (. facts lowered-sections) holder (. ref module) iterator)
              (call decline site)
            )
            (if (not (call (. facts holds-section) (. facts subscribed-sections) holder (. ref module) iterator))
              (+= (. facts subscribed-sections) (call SectionRef holder (. ref module) iterator))
            )
            (continue)
          )
          (lazy closed-event (or (!= (. event key) no-type) ([] closed index) subscribed))
          (lazy not-lowered (not (call lowerable (. ref module) (. ref decl) syntax)))
          (+= (. facts lowered-handlers)
            (call LoweredHandler
              (block
                (arg receiver)
                (arg holder)
                (arg (. ref module))
                (arg member)
                (arg iterator)
                (arg (. event owner))
                (arg (. event name))
                (arg order)
                (arg arrives)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ writes-sections Bool
    (param chain (list TypeId))
    ; Whether a class of a chain writes a section.
    (for (in holder chain)
      (for (in ref (call sheet-parts (call class-ref types holder)))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (match? ([] (. owner decls) member)
            (case (call .decl-rule rule)
              (if (!= (call section-loop (. ref module) (. rule syntax)) 0)
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ section-delivery U32
    (param module ModuleId)
    (param syntax SyntaxId)
    ; Which publications the loop a section of a class writes hears where its only clause says so:
    ; 1 for `when arrival`, 2 for `when bubbling`, and else 0.
    (let tree (. ([] (. program modules) module) tree))
    (match? ([] (. tree nodes) (call section-loop module syntax))
      (case (call .node-for-block block)
        (match? ([] (. tree nodes) (. block loop))
          (case (call .node-loop-syntax loop)
            (return (call (. tree clause-delivery) (. loop clause)))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ lowerable Bool
    (param module ModuleId)
    (param writer DeclId)
    (param syntax SyntaxId)
    ; Whether the loop of a section has no clause but one `when arrival` or `when bubbling`, and its
    ; body has no `break`, no return, no function written in it, and no name of an argument of a
    ; constructor of the class that writes it, nor of the stream a loop is given.
    (let owner ([] (. program modules) module))
    (let tree (. owner tree))
    (let iterator (call section-loop module syntax))
    (let body SyntaxId 0)
    (match? ([] (. tree nodes) iterator)
      (case (call .node-for-block block)
        (= body (. block body))
        (match? ([] (. tree nodes) (. block loop))
          (case (call .node-loop-syntax loop)
            (if (and (!= (. loop clause) 0) (== (call (. tree clause-delivery) (. loop clause)) 0))
              (return false)
            )
          )
        )
      )
    )
    (if (== body 0)
      (return false)
    )
    (let arguments (list Atom))
    (match? ([] (. owner decls) writer)
      (case (call .decl-class class)
        (for (in member ([] (. owner member-pool) (. class members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-function fn)
              (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)))
                (for (in shape ([] (. owner arg-pool) (. fn args)))
                  (if (. shape name)
                    (+= arguments (. shape name))
                  )
                )
              )
            )
          )
        )
      )
    )
    (for (in node (.. (call (. tree subtree-start) body) body))
      (match? ([] (. tree nodes) node)
        (case .node-break
          (return false)
        )
        (case .node-return
          (return false)
        )
        (case .node-return-if-true
          (return false)
        )
        (case .node-function-syntax
          (return false)
        )
        (case (call .node-identifier row)
          (if (== (. row name text) "(stream)")
            (return false)
          )
          (for (in name arguments)
            (if (== name (. row name))
              (return false)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do + rule-target TypeId
    (param written ModuleId)
    (param syntax SyntaxId)
    (param env TypeEnv)
    ; The class a `whenever children T` or `whenever descendants T` rule looks for, written in a
    ; module and evaluated with the type parameters an environment gives, where it is a markup
    ; host, or no type.
    (let owner ([] (. program modules) written))
    (match? ([] (. owner tree nodes) syntax)
      (case (call .node-whenever-rule-syntax rule)
        (if (and (!= (. rule kind text) "children") (!= (. rule kind text) "descendants"))
          (return no-type)
        )
        (let type (call (. types evaluate-type) written (. owner tree) (. rule target-type) env))
        (return (if-expr (call is-markup-host type) type no-type))
      )
    )
    (return no-type)
  )
  (fn-do + prune-cells (list ScopeUse)
    (param first U32)
    (param uses (list ScopeUse))
    ; The rules written in rules given, with the state cells made from `first` on that none of them
    ; is under, innermost or further out, taken away again, and those kept renumbered.
    (let used (list Bool))
    (for (in _ (..< first (as (. facts scope-cells length) U32)))
      (+= used false)
    )
    (for (in use uses)
      (let chain (list U32))
      (call (. facts link-cells) (. use outer-cells) chain)
      (if (< (. use cell) (- (. U32 max) 1))
        (+= chain (. use cell))
      )
      (for (in held chain)
        (if (>= held first)
          (= ([] used (- held first)) true)
        )
      )
    )
    (let moved (list U32))
    (let next first)
    (for (in index (..< first (as (. facts scope-cells length) U32)))
      (if ([] used (- index first))
        (+= moved next)
        (let holder (. ([] (. facts scope-cells) index) instance))
        (if (and (!= holder instance) (!= holder no-instance))
          (+= (. facts revised) 1)
        )
        (= ([] (. facts scope-cells) next) ([] (. facts scope-cells) index))
        (+= next 1)
        (else
          (+= moved (. U32 max))
        )
      )
    )
    (while (> (as (. facts scope-cells length) U32) next)
      (call (. facts scope-cells pop))
    )
    (let kept (list ScopeUse))
    (for (in use uses)
      (let cell
        (scope (if-expr relocated ([] moved (- (. use cell) first)) (. use cell))
          (lazy relocated (and (>= (. use cell) first) (< (. use cell) (- (. U32 max) 1))))
        )
      )
      (let chain (list U32))
      (call (. facts link-cells) (. use outer-cells) chain)
      (let links (. U32 max))
      (for (in held chain)
        (= links (call (. facts scope-link) (if-expr (>= held first) ([] moved (- held first)) held) links))
      )
      (+= kept (call ScopeUse (. use scope) cell (. use values) links))
    )
    (return kept)
  )
  (fn-do + scope-cell U32
    (param site SyntaxId)
    (param owner TypeId)
    (param module ModuleId)
    (param branch SyntaxId)
    ; The state cell of a `when` at a site of this instance, made once, as the reference keeps one
    ; for each `when` an element or a class's content sees (`StyleScopeStateCells`), with where it is
    ; made (`cell-key`). While the way to a slot outlet is followed (`discovering`), one of no
    ; instance, which the function that builds what the outlet mounts reads from those it holds.
    (let holder (if-expr (. keying discovering) no-instance instance))
    (let key (call cell-key site module branch))
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (and same-site (== (. held when) branch) (== (. held key) key))
        (return (as index U32))
      )
      (lazy same-site (and (== (. held instance) holder) (== (. held site) site) (== (. held module) module)))
    )
    (+= (. facts scope-cells) (call ScopeCell holder site module branch owner false (. U32 max) key))
    (return (as (- (. facts scope-cells length) 1) U32))
  )
  (fn-do _ cell-key U32
    (param site SyntaxId)
    (param written ModuleId)
    (param branch SyntaxId)
    ; Where the state cell of a `when`, written in `written`, made at a site of this instance is made,
    ; among `Instances.state-keys`, as the reference's `styleScopeStateKey` keys it: the markup element,
    ; or where `keying` names one, the root `<This`, class, or element of markup it names, in its
    ; module.
    (if (!= (. keying site) 0)
      (return (call (. instances state-key) (. keying module) (. keying site) written branch))
    )
    (return (call (. instances state-key) module site written branch))
  )
  (fn-do + take-cell U32
    (param cell U32)
    ; A state cell the function building markup sees as the markup it is written in sees it, as
    ; `take-scope` says.
    (if (== (. ([] (. facts scope-cells) cell) instance) no-instance)
      (return (call read-cell cell))
    )
    (return (call kept-cell cell))
  )
  (fn-do _ kept-cell U32
    (param source U32)
    ; The state cell this function keeps of one of the function it is written in, made once, in the
    ; order kept. It names that one's cell, so this function is typed only with that one
    ; (`Instance.with-enclosing`).
    (= (. ([] (. instances rows) instance) with-enclosing) true)
    (let count U32)
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (and (== (. held instance) instance) (!= (. held kept) (. U32 max)))
        (if (== (. held source) source)
          (return (as index U32))
        )
        (+= count 1)
      )
    )
    (let row ([] (. facts scope-cells) source))
    (+= (. facts scope-cells)
      (call ScopeCell
        (block
          (arg instance)
          (arg (. U32 max))
          (arg (. row module))
          (arg (. row when))
          (arg (. row owner))
          (arg true)
          (arg (. U32 max))
          (arg (. row key))
          (arg count)
          (arg source)
        )
      )
    )
    (return (as (- (. facts scope-cells length) 1) U32))
  )
  (fn-do _ read-cell U32
    (param found U32)
    ; The state cell this function reads from those the slot outlet that mounts what it builds holds,
    ; for one found on the way there, made once for each place a cell is made, as the reference's
    ; `markupStyleRuleScopesWithOutletStates` reads one. False where the runtime has no such read.
    (let row ([] (. facts scope-cells) found))
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (and (== (. held instance) instance) (. held read) (== (. held key) (. row key)))
        (return (as index U32))
      )
    )
    (do
      (inline (call demand-outlet-states))
    )
    (+= (. facts scope-cells)
      (call ScopeCell
        (block
          (arg instance)
          (arg (. U32 max))
          (arg (. row module))
          (arg (. row when))
          (arg (. row owner))
          (arg true)
          (arg (. U32 max))
          (arg (. row key))
          (arg (. U32 max))
          (arg (. U32 max))
          (arg true)
        )
      )
    )
    (return (as (- (. facts scope-cells length) 1) U32))
  )
  (fn-do + hold-cells Bool
    (param id SyntaxId)
    (param uses (list ScopeUse))
    ; Keeps the state cells a slot outlet holds while the function that builds what it mounts runs, or
    ; a line that forwards a slot while the builder it forwards does (`OutletCell`), as the reference's
    ; `markupOutletStyleStateCells` takes them: of the rules written in rules `uses`, the cells of the
    ; `when`s around each, the outermost first, the first for each place cells are made, but those
    ; given with the context, which no place made. False where the runtime has none.
    (let keys (list U32))
    (let cells (list U32))
    (for (in use uses)
      (if (>= (. use cell) (- (. U32 max) 1))
        (continue)
      )
      (let chain (list U32))
      (call (. facts link-cells) (. use outer-cells) chain)
      (+= chain (. use cell))
      (for (in held chain)
        (let key (. ([] (. facts scope-cells) held) key))
        (if (and (!= key (. U32 max)) (== (call (. keys find) key) null))
          (+= keys key)
          (+= cells held)
        )
      )
    )
    (if (== (. cells length) 0)
      (return true)
    )
    (if (not (call demand-outlet-states))
      (call decline id)
      (return false)
    )
    (for (in held (. facts outlet-cells))
      (if (and (== (. held instance) instance) (== (. held outlet) id))
        (return true)
      )
    )
    (for (in cell cells)
      (+= (. facts outlet-cells) (call OutletCell instance id cell))
    )
    (return true)
  )
  (fn-do + given-cell U32
    (param scope RuleScope)
    (param argument U32)
    (param depth U32)
    ; The state cell this instance is given, its `argument`th, for a `when` around a rule written in
    ; a rule its context gives: the frame of the rule that is the `depth`th `when`'s from the
    ; innermost. It is made at no place a slot outlet holds it by, as the reference's
    ; `markupStyleContextWithRuntimeValues` drops the `stateKey` of the frames a function is given.
    (let frame (. scope frames))
    (let passed U32)
    (while (!= frame (. U32 max))
      (if (!= (. ([] (. instances frames) frame) gate) 0)
        (if (== passed depth)
          (break)
        )
        (+= passed 1)
      )
      (= frame (. ([] (. instances frames) frame) outer))
    )
    (let module (if-expr (!= frame (. U32 max)) (. ([] (. instances frames) frame) module) 0u32))
    (let branch (if-expr (!= frame (. U32 max)) (. ([] (. instances frames) frame) gate) 0u32))
    (+= (. facts scope-cells) (call ScopeCell instance (. U32 max) module branch no-type true argument))
    (return (as (- (. facts scope-cells length) 1) U32))
  )
  (fn-do + check-cells Bool
    (param site SyntaxId)
    (param at SyntaxId)
    (param made TypeId)
    (param known Bool)
    ; Checks the state each state cell made at a site names, once, as the reference binds them once
    ; the object is made (`compileStyleScopeStateBindings`): a property of the class of the object,
    ; `made`, of type `Bool`, as the reference reports, which is read tracked. Where the class was
    ; not `known` exactly, which is where the cell is made for a class's content that classes below
    ; may run, one the class has not is declined. False where one is reported or declined.
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (or (!= (. held instance) instance) (!= (. held site) site) (. held checked))
        (continue)
      )
      (= (. ([] (. facts scope-cells) index) checked) true)
      (if (not (call check-cell held at made known))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ check-cell Bool
    (param held ScopeCell)
    (param at SyntaxId)
    (param made TypeId)
    (param known Bool)
    ; Checks the state a state cell names, as `check-cells` says, and types what keeps the cell: the
    ; constructor of `StyleScopeState`, whose `is-on` is read tracked, and the live action.
    (let written (. ([] (. program modules) (. held module)) tree))
    (let state (call (. program store-atom) ""))
    (match? ([] (. written nodes) (. held when))
      (case (call .node-style-when row)
        (= state (. row state))
      )
    )
    (let place (call property-named made state))
    (let shown (call type-short-name types made))
    (if (not place)
      (if (not known)
        (call decline at)
        (return false)
      )
      (call (. facts record-diagnostic)
        (block
          (arg instance)
          (arg (. held module))
          (arg (. held when))
          (arg .stated)
          (arg (call (. program store-atom) (str "Style state \"" (. state text) "\" is not a property of " shown)))
          (arg no-type)
          (arg no-type)
        )
      )
      (return false)
    )
    (let property ([] (. types properties) place))
    (if (== (. property storage-kind) .storage-getter)
      (call decline at)
      (return false)
    )
    (let declared (. property type))
    (if (== declared no-type)
      (= declared (call demand-member property made state))
    )
    (if (== declared invalid-type)
      (return false)
    )
    (if (!= declared (. types bool-type))
      (call (. facts record-diagnostic)
        (block
          (arg instance)
          (arg (. held module))
          (arg (. held when))
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Style state \"" (. state text) "\" must be a boolean property, but " shown "." (. state text) " is " (call type-display types declared))
                  )
                )
              )
            )
          )
          (arg declared)
          (arg no-type)
        )
      )
      (return false)
    )
    (call (. instances mark-may-panic) instance)
    (let key (call (. panics property-of) made state))
    (if key
      (call (. panics track) key)
    )
    (let ref (call class-ref types (. property owner)))
    (call (. facts note-tracked) (. ref module) (. ref decl) state)
    (call demand-live-runtime)
    (let cell (call (. types well-known-type) "core/style" "StyleScopeState"))
    (if (or (== cell invalid-type) (== (. instances live action) no-instance) no-track)
      (call decline at)
      (return false)
    )
    (lazy no-track (== (. instances live track) no-instance))
    (let runtime (. facts style-runtime))
    (if (== (. runtime scope-state) no-instance)
      (call (. types complete) cell)
      (= (. runtime scope-state) (call (. calls demand-constructor) cell (. scratch types mark)))
      (= (. facts style-runtime) runtime)
    )
    (if (== (. runtime scope-state) no-instance)
      (call decline at)
      (return false)
    )
    (let is-on (call (. program store-atom) "is-on"))
    (let cell-key (call (. panics property-of) cell is-on))
    (if cell-key
      (call (. panics track) cell-key)
    )
    (let cell-ref (call class-ref types cell))
    (call (. facts note-tracked) (. cell-ref module) (. cell-ref decl) is-on)
    (return true)
  )
  (fn-do _ promise Bool
    (param callee InstanceId)
    ; Gives a rule that states its type what its function returns, the optional of that type,
    ; from its declaration alone, so that its body may wait in the queue. False for any other
    ; instance, whose body says what it returns.
    (let row ([] (. instances rows) callee))
    (if (or (!= (. row self-type) no-type) (!= (. row enclosing) no-instance) (. row holds-closure) no-rule)
      (return false)
    )
    (lazy no-rule (== (call rule-match program (. row module) (. row decl)) 0))
    (let reported (. facts diagnostics length))
    (let checker (call checker-for session callee))
    (let declared no-type)
    (if (. checker described)
      (call (. checker prepare))
      (= declared (. checker declared-return))
      (call (. checker close))
    )
    (call (. checker retire))
    (call (. facts diagnostics truncate) reported)
    (if (or (== declared no-type) (== declared invalid-type))
      (return false)
    )
    (let stated (call (. types optional-around) declared))
    (call (. instances set-returns) callee stated stated .return-declared)
    (return true)
  )
  (fn-do + check-class-rule _
    (param receiver TypeId)
    (param syntax SyntaxId)
    (param writer DeclId)
    ; Types a rule of a class for the class that writes it, as the value of a property is typed:
    ; with `this` bound and the type parameters of that class as the receiver gives them. What a
    ; `when` rule tests is tested for truth, as a condition is, and the rule's value is what a
    ; `whenever` rule compares from one run to the next. A rule answers nothing. The reference
    ; reports one that reads nothing tracked where it runs it in a live action of its own: a
    ; `when` rule as it tests and runs its body, a `whenever` rule as it takes its value. A section
    ; that subscribes to a stream is typed as its loop, which the object owns; one on a stream of
    ; an element a branch of the markup makes is subscribed again as the branch makes the element
    ; again (`rebind-section`). How a section is typed is noted as the instance's (`TypedSection`).
    (= (. frame self-type) receiver)
    (call bind-this receiver)
    (call (. frame close-env))
    (call open-class-env (call holding-type receiver (call DeclRef module writer)))
    (match? ([] (. tree nodes) syntax)
      (case (call .node-when-rule-syntax rule)
        (call note-truthiness (. rule expr) (. rule expr) (call infer (. rule expr)))
        (call check-statement (. rule body))
        (call untracked-rule (. rule expr) "when rules must read at least one tracked property")
      )
      (case (call .node-whenever-rule-syntax rule)
        (if (!= (. rule kind text) "value")
          (call check-markup-trigger receiver syntax rule)
          (else
            (let value (call infer (. rule expr)))
            (if (call untracked-rule (. rule expr) "whenever value triggers must read at least one tracked property (like #bar)")
              (call demand-change-test (. rule expr) value)
            )
            (call check-statement (. rule body))
          )
        )
      )
      (case (call .node-dependency-declaration dependency)
        (call check-dependency receiver syntax (. dependency left) (. dependency right))
      )
      (case (call .node-subscriber-syntax section)
        (match? ([] (. tree nodes) (. section iterator))
          (case (call .node-for-block row)
            (let root (call branch-root receiver (. row loop)))
            (if (or (== root 0) (call rebind-section receiver (. section iterator) (. row loop) root))
              (let lowered (call (. facts lowers-only) receiver module (. section iterator)))
              (if lowered
                (= lowering (. section iterator))
                (if (not (call (. facts holds-section) sections receiver module (. section iterator)))
                  (+= (. facts lowered-sections) (call SectionRef receiver module (. section iterator)))
                )
                (lazy sections (. facts lowered-sections))
              )
              (+= (. facts typed-sections)
                (call TypedSection
                  (block
                    (arg instance)
                    (arg receiver)
                    (arg module)
                    (arg (. section iterator))
                    (arg lowered)
                  )
                )
              )
              (= rebound-root root)
              (call check-for (. section iterator) (. row loop) (. row body) 0)
              (= rebound-root 0)
              (= lowering 0)
            )
          )
        )
      )
    )
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ rebind-section Bool
    (param receiver TypeId)
    (param iterator SyntaxId)
    (param loop SyntaxId)
    (param root SyntaxId)
    ; A section on a stream of an element a branch of the markup makes, which the reference
    ; subscribes in a live action of its own that reads the element tracked, as its
    ; `loopAsRebindingSubscription` does: as the branch makes the element again, the action reads
    ; the stream again and the tracker of a new subscription to it takes the old one's place. The
    ; element's property is tracked so. A `whenever` clause there is the reference's error.
    (let clause (call (. tree whenever-clause) loop))
    (if (!= clause 0)
      (let message "A whenever clause cannot follow a named element that a branch rebuilds")
      (call (. frame diagnose) clause .stated (call (. program store-atom) message))
      (return false)
    )
    (let name (!! (call (. tree identifier-name) root)))
    (let place (call property-named receiver name))
    (if (not place)
      (call decline root)
      (return false)
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (let runs (and (!= (. live action) no-instance) (!= (. live previous) no-instance) (!= (. live next) no-instance)))
    (let adds (and (!= (. live trackers) no-instance) (!= (. live add-tracker) no-instance)))
    (if (or (not runs) (not adds) (== (. live track) no-instance) (== (. live subscribers) no-instance))
      (call decline root)
      (return false)
    )
    (call (. instances mark-may-panic) instance)
    (let key (call (. panics property-of) receiver name))
    (if key
      (call (. panics track) key)
    )
    (let ref (call class-ref types (call (. types tracked-root) (. ([] (. types properties) place) owner) name)))
    (call (. facts note-tracked) (. ref module) (. ref decl) name)
    (if (not (call (. facts holds-section) (. facts rebinding-sections) receiver module iterator))
      (+= (. facts rebinding-sections) (call SectionRef receiver module iterator))
    )
    (return true)
  )
  (fn-do _ branch-root SyntaxId
    (param receiver TypeId)
    (param loop SyntaxId)
    ; The name, read untracked, that the stream a loop of a class's section subscribes to is read
    ; from, where the markup of the class, or of one above it, gives that name an element written
    ; in an `if` or a `match` of that markup, outside its functions and loops, or none.
    (let root SyntaxId 0)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (= root (. row container))
      )
    )
    (let reached false)
    (while (not reached)
      (match ([] (. tree nodes) root)
        (case (call .node-get-expression get)
          (= root (. get object))
        )
        (default
          (= reached true)
        )
      )
    )
    (let name (? Atom) null)
    (match? ([] (. tree nodes) root)
      (case (call .node-identifier read)
        (if (not (. read is-tracked))
          (= name (. read name))
        )
      )
    )
    (if (not name)
      (return 0)
    )
    (let level (? TypeId) receiver)
    (while level
      (let ref (call class-ref types level))
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (if (and (!= (. class content) 0) (call (. owner-tree branches-element) (. class content) name))
            (return root)
          )
          (lazy owner-tree (. ([] (. program modules) (. ref module)) tree))
        )
      )
      (= level (call (. types base-of) level))
    )
    (return 0)
  )
  (fn-do _ required-argument (? Atom)
    (param receiver TypeId)
    (param method Atom)
    ; The first argument a class's method of a name requires, where each method of that name the
    ; class declares requires one, which a dependency, calling it with nothing, cannot give; none
    ; where one requires none, or the class declares none.
    (let ref (call class-ref types receiver))
    (let owner ([] (. program modules) (. ref module)))
    (let required (? Atom) null)
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class row)
        (for (in member ([] (. owner member-pool) (. row members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-function fn)
              (if (and (. fn name) (== (. fn name) method))
                (let first (call first-required owner fn))
                (if (not first)
                  (return null)
                )
                (= required first)
              )
            )
          )
        )
      )
    )
    (return required)
  )
  (fn-do _ first-required (? Atom)
    (param owner Module)
    (param fn FunctionDecl)
    ; The name of the first argument a function requires: one with no default that is not variadic.
    (for (in offset (..< 0 (. fn args count)))
      (let shape ([] (. owner arg-pool) (+ (. fn args start) offset)))
      (if (and (not (. shape has-default)) (not (. shape is-variadic)))
        (return (?? (. shape name) (call (. program store-atom) "_")))
      )
    )
    (return null)
  )
  (fn-do _ check-dependency _
    (param receiver TypeId)
    (param syntax SyntaxId)
    (param left SyntaxId)
    (param right (of RowRange SyntaxId))
    ; A dependency `. m < p, q` of a class: each property it names is tracked, and the method is
    ; read as a value of the object being made, given as a `Doer` to `property-dependency-subscribe`
    ; once for each property, or for an object of a markup host to the markup runtime's
    ; `markup-property-dependency-subscribe`, given the object as its host too. The conversions are
    ; recorded at the dependency, where the reference places the call the `Doer` makes. The
    ; reference reports a property or a method the class does not have. A getter is never stored, so
    ; a dependency on it would never run, and is reported.
    (for (in name-syntax ([] (. tree children) right))
      (let name (call (. tree identifier-atom) name-syntax))
      (let place (only-if (call property-named receiver name) (if name)))
      (if (not place)
        (let shown (if-expr name (. name text) ""))
        (call (. frame diagnose) syntax .stated (call (. program store-atom) (str "Property \"" shown "\" does not exist")))
        (return)
      )
      (if (== (. ([] (. types properties) place) storage-kind) .storage-getter)
        (let text
          (paragraph
            (str "\"" (. (!! name) text) "\" is a getter, which is never stored, so a dependency on it never runs; depend on the properties it reads")
          )
        )
        (call (. frame diagnose) name-syntax .stated (call (. program store-atom) text))
        (return)
      )
      (let ref (call class-ref types (call (. types tracked-root) (. ([] (. types properties) place) owner) (!! name))))
      (call (. facts note-tracked) (. ref module) (. ref decl) (!! name))
    )
    (let method (call (. tree identifier-atom) left))
    (let bound (if-expr method (call (. calls method-binding) receiver method left) no-type))
    (if (== bound invalid-type)
      (return)
    )
    (if (== bound no-type)
      (let shown (if-expr method (. method text) ""))
      (call (. frame diagnose) syntax .stated (call (. program store-atom) (str "Function \"" shown "\" does not exist")))
      (return)
    )
    (let required (call required-argument receiver (!! method)))
    (if required
      (let text
        (paragraph
          (str "A dependency calls \"" (. (!! method) text) "\" with nothing, but it takes \"" (. required text) "\"; give \"" (. required text) "\" a default, or name a method that takes nothing")
        )
      )
      (call (. frame diagnose) left .stated (call (. program store-atom) text))
      (return)
    )
    (let doer (call (. types well-known-type) "core/function" "Doer"))
    (if (== doer invalid-type)
      (call decline syntax)
      (return)
    )
    (call (. facts set-node-type) instance left bound)
    (call (. conversions convert) syntax left bound doer .reason-argument)
    (call demand-live-runtime)
    (let hosted (call is-markup-host receiver))
    (let host (if-expr hosted (call derived-interface receiver (. types markup-host-decl)) no-type))
    (let mark (. scratch types mark))
    (call (. scratch types push) receiver)
    (if hosted
      (call (. scratch types push) host)
    )
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) doer)
    (let module
      (scope (if-expr hosted (. types markup-host-decl module) live-module)
        (lazy live-module (. (call class-ref types (. types live-action-type)) module))
      )
    )
    (let subscribe
      (call (. calls demand-runtime-call)
        (block
          (arg module)
          (arg no-type)
          (arg
            (call (. program store-atom)
              (block
                (arg (if-expr hosted "markup-property-dependency-subscribe" "property-dependency-subscribe"))
              )
            )
          )
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== subscribe no-instance)
      (call decline syntax)
      (return)
    )
    (if hosted
      (call (. conversions convert) syntax syntax receiver host .reason-markup-host)
    )
    (call (. facts note-change-test) instance subscribe hosted)
  )
  (fn-do _ untracked-rule Bool
    (param expr SyntaxId)
    (param message String)
    ; Reports a rule that has read nothing tracked so far, unless what it read has no shape here;
    ; whether it has read something.
    (if (. ([] (. instances rows) instance) is-live)
      (return true)
    )
    (if (not (call (. facts declined-since) 0 instance))
      (call (. frame diagnose) expr .stated (call (. program store-atom) message))
    )
    (return false)
  )
  (fn-do _ demand-change-test _
    (param expr SyntaxId)
    (param value TypeId)
    ; The function that tells whether a `whenever` rule's value has changed, given the value it
    ; had and the one it has: `value-changed` of the tracker's runtime, for the value's type.
    (if (or (== value no-type) (== value invalid-type))
      (return)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) value)
    (call (. scratch types push) value)
    (let module (. (call class-ref types (. types live-action-type)) module))
    (let tester (call (. calls demand-runtime-call) module no-type (call (. program store-atom) "value-changed") mark))
    (call (. scratch types rewind) mark)
    (if (== tester no-instance)
      (call decline expr)
      (return)
    )
    (call (. facts note-change-test) instance tester)
  )
  (fn-do + demand-live-action-cleanup _
    (let action (. types live-action-type))
    (if (== action invalid-type)
      (return)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) action)
    (let actions (call (. types class-named-with-args) module (!! (. types list-atom)) mark))
    (call (. calls demand-method) actions (call (. program store-atom) "!"))
    (call (. calls demand-method) actions (call (. program store-atom) "pop"))
    (call (. calls demand-method) action (call (. program store-atom) "close"))
  )
  (fn-do _ replace-again Bool
    (param statement SyntaxId)
    (param made TypeId)
    (param previous TypeId)
    ; Types a line of a markup element's body that a live action gives the element again in place
    ; of what it took before, kept where the element was made, as the reference's replacer gives it:
    ; a markup host makes the value its node by its `markup-content`, which the markup runtime's
    ; `markup-replace` puts in place of the one before; another element's `replace` is given the
    ; one before and the value, and what it answers, or the value where it answers nothing, is kept
    ; in place of the one before. That is then closed by its `close`, or where it has none, each
    ; live action it owns is. What is kept is of the type of what was kept before.
    (+= content-blocks 0)
    (+= content-parents made)
    (let produced (call infer statement))
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (if (or (== produced invalid-type) (== produced no-type))
      (return false)
    )
    (let taken produced)
    (let call no-fact)
    (let replace no-instance)
    (let kept produced)
    (if (call is-markup-host made)
      (let content (call (. calls content-call) made (call (. program store-atom) "markup-content") statement produced))
      (= taken (. content taken))
      (= call (. content fact))
      (= kept (. content answer))
      (if (or (== taken no-type) (== call no-fact) (!= kept previous))
        (return false)
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) made)
      (call (. scratch types push) previous)
      (call (. scratch types push) kept)
      (= replace
        (call (. calls demand-runtime-call)
          (block
            (arg (. types markup-host-decl module))
            (arg no-type)
            (arg (call (. program store-atom) "markup-replace"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== replace no-instance)
        (return false)
      )
      (call (. conversions convert) statement statement produced taken .reason-argument)
      (else
        (let given (list TypeId))
        (+= given previous)
        (+= given produced)
        (let replacing (call (. calls protocol-call) made (call (. program store-atom) "replace") statement given))
        (= call (. replacing fact))
        (if (or (== call no-fact) (== (. replacing answer) invalid-type))
          (return false)
        )
        (if (!= (. replacing answer) no-type)
          (= kept (. replacing answer))
        )
        (if (!= kept previous)
          (return false)
        )
      )
    )
    (let nothing (list TypeId))
    (let closed (. (call (. calls protocol-call) previous (call (. program store-atom) "close") statement nothing) fact))
    (if (== closed no-fact)
      (call demand-live-runtime)
      (if (== (. instances live has-actions) no-instance)
        (return false)
      )
    )
    (call (. facts note-content-link)
      (block
        (arg (call ContentLink instance statement made taken call no-type replace closed))
      )
    )
    (return true)
  )
  (fn-do _ absorb-again Bool
    (param statement SyntaxId)
    (param made TypeId)
    ; Types a line of a markup element's body that a live action gives the element again: its value,
    ; where a name of a member of the element is read from the element's object, kept where the
    ; element was made, is absorbed again by the element's `markup-absorb`, as where it is written.
    (+= content-blocks 0)
    (+= content-parents made)
    (let produced (call infer statement))
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (if (or (== produced invalid-type) (== produced no-type))
      (return false)
    )
    (let absorbing (call (. calls content-call) made (call (. program store-atom) "markup-absorb") statement produced))
    (let absorbed (. absorbing taken))
    (if (== absorbed no-type)
      (return false)
    )
    (call (. conversions convert) statement statement produced absorbed .reason-argument)
    (call (. facts note-content-link) (call ContentLink instance statement made absorbed (. absorbing fact)))
    (return true)
  )
  (fn-do _ argument-again TypeId
    (param arg SyntaxId)
    (param made TypeId)
    ; The type an argument of a markup element, given by position, is given again by its own
    ; function: that of the property its parameter names, to which the value is converted as one
    ; assigned is. A parameter that names no property stored in the object, as the instance that
    ; makes the element chose its constructor, is declined.
    (let element (call (. tree argument-element) arg))
    (let name (call argument-name arg element (. ([] (. instances rows) instance) enclosing)))
    (let place (only-if (call property-named made name) (if name)))
    (if (not place)
      (call decline arg)
      (return invalid-type)
    )
    (let property ([] (. types properties) place))
    (if (!= (. property storage-kind) .storage-eager)
      (call decline arg)
      (return invalid-type)
    )
    (let declared (. property type))
    (if (== declared no-type)
      (= declared (call demand-member property made (!! name)))
    )
    (if (or (== declared no-type) (== declared invalid-type))
      (call decline arg)
      (return invalid-type)
    )
    (let written (call infer arg))
    (if (or (== written invalid-type) (== written no-type))
      (return invalid-type)
    )
    (if (== (call (. conversions convert) arg arg written declared .reason-assignment) invalid-type)
      (return invalid-type)
    )
    (return declared)
  )
  (fn-do + in-live-statement Bool
    (param node SyntaxId)
    (param body SyntaxId)
    ; Whether a node is written in an assignment, a declaration or an argument of a markup
    ; element within a body that a function of its own runs again.
    (for (in outer (..< node body))
      (if (and (<= (call (. tree subtree-start) outer) node) (call is-live-statement outer))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + untracked-read SyntaxId
    (param id SyntaxId)
    (param scope Atom)
    ; The first read, in the order written, of a member of what a name names that is not tracked,
    ; outside a function or a `do` block, or none.
    (match? ([] (. tree nodes) id)
      (case .node-function-syntax
        (return 0)
      )
      (case .node-do-block
        (return 0)
      )
      (case (call .node-get-expression row)
        (if (and (not (. row is-tracked)) (is ([] (. tree nodes) (. row object)) .node-identifier) reads-scope)
          (return id)
        )
        (lazy reads-scope (== (call (. tree identifier-name) (. row object)) scope))
      )
    )
    (for (in child (call (. tree children-of) id))
      (let found (call untracked-read child scope))
      (if (!= found 0)
        (return found)
      )
    )
    (return 0)
  )
  (fn-do _ arm-line SyntaxId
    (param region SyntaxId)
    (param id SyntaxId)
    ; The line of the body of an arm of a markup branch or match region that gives content a node is
    ; written in, where a function of its own gives it again, or none.
    (for (in arm (call (. tree region-arms) region))
      (match? ([] (. tree nodes) (call (. tree region-arm-body) arm))
        (case (call .node-block block)
          (for (in line ([] (. tree children) (. block body)))
            (if (and (<= (call (. tree subtree-start) line) id) (<= id line))
              (return (if-expr (and (call (. tree content-line) line) (call is-live-statement line)) line 0u32))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr _ matched-line SyntaxId
    (param arm SyntaxId)
    (param id SyntaxId)
    ; The line of an arm of a markup match region that gives content a node is written in, as
    ; `arm-line` says, or none. The arm is not written within its match, which follows it.
    (if-expr (and (!= region 0) (call is-region region)) (call arm-line region id) 0u32)
    (where
      (lazy region (call (. tree arm-match) arm))
    )
  )
  (fn-do + check-subscription _
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    (param clause SyntaxId)
    (param decl DeclId)
    ; A loop on a stream where it is written, as the reference compiles one with no `whenever`
    ; clause: the container is made a `Broadcastable`, and the loop's subscriber, a closure of the
    ; item and the stream, is made a `Subscriber` and given to the broadcaster's `subscribe`, both
    ; recorded at the `for` block, whose errors leave the function as those of a call written
    ; there would. One in a method of an object or a section of a class, which the object owns, is
    ; subscribed as `own-subscription` says, and one with a `whenever` clause as
    ; `subscribe-whenever` says.
    (let stream (call subscribed-stream id loop container clause true))
    (let event subscribed-event)
    (= subscribed-event null)
    (if (== stream no-type)
      (return)
    )
    (let item (call first-arg stream))
    (let subscriber (call (. types well-known-type-of) "core/stream" "Subscriber" item))
    (if (or (== item no-type) (== subscriber invalid-type))
      (call decline id)
      (return)
    )
    (let closure (call intern-nested decl))
    (call (. facts set-node-type) instance id closure)
    (if (== (call (. conversions convert) id id closure subscriber .reason-argument) invalid-type)
      (return)
    )
    (if event
      (call subscribe-event id container event stream item subscriber closure)
      (else-if (!= (call whenever-of loop) 0)
        (call subscribe-whenever id (call whenever-of loop) stream item subscriber)
      )
      (else-if (call owns-subscription id)
        (call own-subscription id stream item subscriber)
      )
      (else-if (== (. (call (. calls protocol-call) stream (call (. program store-atom) "subscribe") id subscriber true (:role (. CallRole role-subscribe))) answer) invalid-type)
        (call decline id)
      )
    )
  )
  (fn-do _ subscribe-event _
    (param id SyntaxId)
    (param container SyntaxId)
    (param event NamedEvent)
    (param stream TypeId)
    (param item TypeId)
    (param subscriber TypeId)
    (param closure TypeId)
    ; A loop on an event, as the reference subscribes one: the subscriber is made an event's
    ; subscription, which runs it as the event is published and reports what it raises as
    ; unhandled, and that is given to the endpoint's `subscribe`, or owned by the object as a
    ; loop on a stream is. A section of a class that every class making it runs from its table,
    ; as `plan-event-handlers` plans it, is not subscribed: only its subscriber is typed, and
    ; where it lets errors out, what it gives them to (see `demand-hand-off`).
    (if (== id lowering)
      (let start (. scratch types mark))
      (call (. scratch types push) item)
      (call (. scratch types push) stream)
      (let run (call demand-lambda closure (call (. scratch types since) start)))
      (call (. scratch types rewind) start)
      (if (and (!= run no-instance) (not (call demand-hand-off run)))
        (call decline id)
        (return)
      )
      (+= (. facts event-uses)
        (call EventUse
          (block
            (arg instance)
            (arg id)
            (arg container)
            (arg (. event owner))
            (arg (. event name))
            (arg .event-subscribe)
            (arg subscribed-by)
            (arg no-instance)
            (arg run)
          )
        )
      )
      (call (. instances mark-may-panic) instance)
      (return)
    )
    (let subscribable (call (. types well-known-type-of) "core/stream" "Subscribable" item))
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) subscriber)
    (call (. scratch types push) (call (. types type-row) .bool))
    (let wrap
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-subscription"))
          (arg mark)
          (arg 1)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) item)
    (call (. scratch types push) stream)
    (let callback (call demand-lambda closure (call (. scratch types since) mark)))
    (call (. scratch types rewind) mark)
    (let endpoint subscribed-by)
    (if (or (== wrap no-instance) (== subscribable invalid-type))
      (call decline id)
      (return)
    )
    (if (!= (. ([] (. instances signatures) wrap) returns) subscribable)
      (call decline id)
      (return)
    )
    (if (call owns-subscription id)
      (call own-subscription id stream item subscriber wrap)
      (else-if (== (. (call (. calls protocol-call) stream (call (. program store-atom) "subscribe") id subscribable true (:role (. CallRole role-subscribe))) answer) invalid-type)
        (call decline id)
        (return)
      )
    )
    (+= (. facts event-uses)
      (call EventUse
        (block
          (arg instance)
          (arg id)
          (arg container)
          (arg (. event owner))
          (arg (. event name))
          (arg .event-subscribe)
          (arg endpoint)
          (arg wrap)
          (arg callback)
          (arg (. event address))
        )
      )
    )
    (call (. instances mark-may-panic) instance)
  )
  (fn-do _ demand-hand-off Bool
    (param run InstanceId)
    ; What a function the event runtime calls for a section of a class gives the errors its
    ; subscriber lets out to (see `hands-off`). Says whether that is in place, or nothing needs it.
    (call demand-errors run)
    (if (== (. ([] (. instances signatures) run) errors count) 0)
      (return true)
    )
    (return (call hands-off run))
  )
  (fn-do + subscribed-stream TypeId
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    (param clause SyntaxId)
    (param events Bool (= false))
    (param want Want (= (call Want)))
    ; The container of a loop or a comprehension on a stream made a `Broadcastable` where it is
    ; written, as the reference makes it: cast where it supports
    ; one, and given to `publisher` where it only iterates, which is recorded at the header; the
    ; header has the broadcaster's type. Where `events` says a loop asks for one, an event of an
    ; object is the endpoint the event runtime keeps for it, recorded at the container and kept
    ; in `subscribed-event`; a first clause `when arrival` or `when bubbling` is then no clause but
    ; says which publications the loop hears (`facts.event-clauses`). No type where the container
    ; is not one, which is its error at `id`, or where the loop is not supported yet: one on an
    ; event with a `whenever` clause. A container that reads a tracked value must be a stream
    ; itself: one that only iterates is its error, which names the `whenever` that runs on the
    ; value's changes.
    (let found (call infer-found container (if-expr events (call (. want adding) .want-event) want)))
    (let given (. found type))
    (let tracked (call (. tree tracked-read) container))
    (if (and tracked (== (. found event) (. U32 max)) (!= given invalid-type) (!= given no-type) unbroadcast)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "#" (. tracked text) " is not a stream; use `whenever #" (. tracked text) "`")))
        )
      )
      (return no-type)
    )
    (lazy unbroadcast (== (call supported given (. types broadcastable-decl)) no-type))
    (if (!= (. found event) (. U32 max))
      (let event ([] found-events (. found event)))
      (if (call unaddressed loop event)
        (return no-type)
      )
      (if (call (. tree has-whenever) clause)
        (call decline id)
        (return no-type)
      )
      (if (call (. tree arrival-clause) clause)
        (match? ([] (. tree nodes) clause)
          (case (call .node-clause row)
            (match? ([] (. tree nodes) (. row expr))
              (case (call .node-identifier name)
                (+= (. facts event-clauses)
                  (call EventClause
                    (block
                      (arg module)
                      (arg loop)
                      (arg (== (. name name text) "arrival"))
                    )
                  )
                )
              )
            )
          )
        )
      )
      (return (call subscribed-endpoint id loop container event given))
    )
    (if (call (. tree arrival-clause) clause)
      (match? ([] (. tree nodes) clause)
        (case (call .node-clause row)
          (if (== (. (call (. bindings resolution-of) (. frame binding) (. row expr)) kind) .resolve-unresolved)
            (call (. frame diagnose) (. row expr) .stated (call (. program store-atom) "Name not found"))
            (return no-type)
          )
        )
      )
    )
    (if (or (== given invalid-type) (== given no-type))
      (return no-type)
    )
    (if (or (and (call (. tree has-whenever) clause) (== (call whenever-of loop) 0)) (== (. types broadcastable-decl module) 0))
      (call decline id)
      (return no-type)
    )
    (let stream (call supported given (. types broadcastable-decl)))
    (let mark (. scratch types mark))
    (if (and (== stream no-type) (not (call iterates given)))
      (let shown (call type-display types given))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "Object is not a broadcastable or iterable: " shown)))
          (arg given)
        )
      )
      (return no-type)
    )
    (if (== stream no-type)
      (call (. scratch types push) given)
      (let publisher
        (call (. calls demand-runtime-call)
          (block
            (arg (. types broadcastable-decl module))
            (arg no-type)
            (arg (call (. program store-atom) "publisher"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== publisher no-instance)
        (call decline id)
        (return no-type)
      )
      (call (. conversions convert)
        (block
          (arg loop)
          (arg container)
          (arg given)
          (arg (call (. instances argument-type) publisher 0))
          (arg .reason-argument)
        )
      )
      (do
        (inline (call (. facts record-call) instance loop publisher .call-function (. scratch no-fills) false))
      )
      (= stream (. ([] (. instances signatures) publisher) returns))
      (else
        (call (. conversions convert) loop container given stream .reason-argument)
      )
    )
    (call (. facts set-node-type) instance loop stream)
    (return stream)
  )
  (fn-do _ subscribed-endpoint TypeId
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    (param event NamedEvent)
    (param stream TypeId)
    ; The endpoint of an event a loop subscribes to, which the event runtime gives for the object
    ; and the event, recorded at the container and made the event's `Broadcastable` at the header.
    ; One at the address of a keyed event is claimed for the receiver at the loop (see
    ; `claim-endpoint`).
    (let keyed (!= (. event address) 0))
    (let endpoint
      (block
        (case? keyed
          (call event-call "event-keyed-endpoint" (. event payload) no-type 3)
        )
        (default
          (call event-call "event-endpoint" (. event payload))
        )
      )
    )
    (if (== endpoint no-instance)
      (call decline loop)
      (return no-type)
    )
    (if (and keyed (not (call claim-endpoint id id (. event address) endpoint)))
      (return no-type)
    )
    (call (. conversions convert)
      (block
        (arg loop)
        (arg container)
        (arg (. ([] (. instances signatures) endpoint) returns))
        (arg stream)
        (arg .reason-argument)
      )
    )
    (call (. facts set-node-type) instance loop stream)
    (= subscribed-event event)
    (= subscribed-by endpoint)
    (return stream)
  )
  (fn-do + subscribe-whenever _
    (param id SyntaxId)
    (param clause SyntaxId)
    (param stream TypeId)
    (param item TypeId)
    (param subscriber TypeId)
    ; A loop or a comprehension on a stream with a `whenever` clause, as the reference subscribes
    ; it: the clause's value is typed where the loop is written, in a live action of its own, and
    ; must read something tracked. Where no object owns the subscription, the subscriber is
    ; wrapped in a `Subscription`, recorded at the clause, which is given to the broadcaster's
    ; `subscribe`, recorded at `id`, where the value holds. Where an object owns it, it is wrapped
    ; and given to a `SubscriptionTracker` as `own-subscription` says, at the clause, and the
    ; tracker is added to the action's trackers where the value holds. What the value gave, the
    ; subscription or its tracker, and the broadcaster are kept in the locals declared at the
    ; clause, which the function that tests the clause again captures; that function is typed
    ; once they are, and the live action that runs it is noted as a live statement's is, at the
    ; clause. A value that is no `Bool` has no shape here yet, nor has a clause where a batch of
    ; markup is in force, whose action the reference makes with the batch.
