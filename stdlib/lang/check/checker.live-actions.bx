      (let owned (call (. facts owned-subscription-of) instance clause))
      (if (not owned)
        (return)
      )
      (= kept (. ([] (. instances signatures) (. owned tracker)) returns))
      (if (and (not (call activation-owns id)) (not (call owns-plain-actions (. frame self-type))))
