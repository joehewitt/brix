        (call (. scratch types push) subscriber)
        (let made (call (. calls demand-constructor) wrapped mark))
        (call (. scratch types rewind) mark)
        (if (== made no-instance)
          (call decline id)
          (return)
        )
        (= kept (. ([] (. instances signatures) made) returns))
        (do
          (inline (call (. facts record-call) instance clause made .call-constructor (. scratch no-fills) false))
        )
        (call (. conversions convert) clause clause kept subscribable .reason-argument)
        (if (== (. (call (. calls protocol-call) stream (call (. program store-atom) "subscribe") id subscribable true (:role (. CallRole role-subscribe))) answer) invalid-type)
          (call decline id)
          (return)
        )
      )
    )
    (call (. frame assign) (. resolution slot) passed)
    (call (. frame assign) (+ (. resolution slot) 1) kept)
    (call (. frame assign) (+ (. resolution slot) 2) stream)
    (let rerun (call demand-lambda (call intern-nested (call nested-decl-of clause)) (. scratch no-types)))
    (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
      (call decline id)
      (return)
    )
    (+= (. facts live-statements) (call LiveStatement instance clause rerun))
    (call (. instances mark-may-panic) instance)
