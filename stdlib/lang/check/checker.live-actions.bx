    (param loop SyntaxId)
    ; The `whenever` clause of a loop on a stream where a function of its own tests it again, or
    ; none.
    (if-expr (or (== clause 0) (== (call nested-decl-of clause) 0)) 0 clause)
    (where
      (lazy clause (call (. tree whenever-clause) loop))
    )
  )
  (fn-do + own-subscription _
    (param id SyntaxId)
    (param stream TypeId)
    (param item TypeId)
