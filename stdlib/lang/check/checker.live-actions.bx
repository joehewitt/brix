    )
    (if (== context .live-none)
      (call untracked id name)
      (return)
    )
    (if (call pulled id name)
      (return)
    )
    (if (and (== context .live-value) (call is-eager-value))
      (call (. instances mark-live) instance)
      (return)
    )
    (if (and (== context .live-value) (call is-lazy-value))
      (let message
        (paragraph
          (str "A lazy property is worked out once, when it is first read, so it cannot follow \"#" (. name text) "\"; write \"=\" in place of \":=\" to keep it live, or read \"" (. name text) "\" without \"#\"")
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return)
    )
    (if (and (== context .live-rule) (call is-rule-unit))
      (call (. instances mark-live) instance)
      (return)
    )
    (if (== context .live-statement)
      (call note-live-statement (call read-site id))
      (return)
    )
    (if (== context .live-whenever)
      (return)
    )
    (if (or (== context .live-region) (== context .live-gate))
      (return)
    )
    (call decline id)
  )
  (fn-do _ untracked _
    (param id SyntaxId)
    (param name Atom)
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (return-if (if (not (. row is-tracked))))
      )
    )
    (return-if (if (or (call (. tree in-applied-value) id) (call (. tree reads-slot-scope) id))))
    (blank)
    (let shown (. name text))
    (let message
      (paragraph
        (str "\"#" shown "\" tracks nothing here: a read is followed only where it is written directly in a live value, such as markup, a derived property, a rule or a live statement. Write \"" shown "\" to read it plainly, or read \"#" shown "\" in the live value and pass it in as an argument")
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ pulled Bool
    (param id SyntaxId)
    (param name Atom)
    (let pipeline (call (. tree pipeline-of) id))
    (return-if false (if (== pipeline 0)))
    (blank)
    (let enclosing outer)
    (if (and enclosing (== (call (. enclosing nested-decl-of) pipeline) (. ([] (. instances rows) instance) decl)))
      (if (and (call (. enclosing pulls-live) pipeline id name) (call demand-track-active))
        (call (. facts note-pulled) instance id)
        (return true)
      )
    )
    (call unfollowed id name)
    (return true)
  )
  (fn-do + watched Bool
    (param id SyntaxId)
    (let function SyntaxId 0)
    (for (in node (..< (+ id 1) (as (. tree nodes length) SyntaxId)))
      (if (<= (call (. tree subtree-start) node) id)
        (match? ([] (. tree nodes) node)
          (case .node-function-syntax
            (if (== function 0)
              (= function node)
            )
          )
          (case (call .node-clause row)
            (if (and (== function 0) (== (. row op) .when-clause) (!= (call nested-decl-of node) 0))
              (return true)
            )
          )
          (case (call .node-state-trigger row)
            (return-if false (if (or (!= (. row kind) .state-trigger-whenever) (== function 0))))
            (return (== (call (. tree trigger-item) node 0) function))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ pulls-live Bool
    (param pipeline SyntaxId)
    (param read SyntaxId)
    (param name Atom)
    (call demand-live-runtime)
    (let live (. instances live))
    (return-if false (if (or (== (. live enter) no-instance) (== (. live leave) no-instance))))
    (blank)
    (let context (call live-context (call read-site pipeline)))
    (if (and (== context .live-value) (call is-eager-value))
      (call (. instances mark-live) instance)
      (else-if (and (== context .live-rule) (call is-rule-unit))
        (call (. instances mark-live) instance)
      )
      (else-if (== context .live-statement)
        (call note-live-statement (call read-site pipeline))
      )
      (else-if (and (!= context .live-region) (!= context .live-gate))
        (return false)
      )
    )
    (if (== (call (. pulled-pipelines find) pipeline) null)
      (+= pulled-pipelines pipeline)
      (+= pulled-reads read)
      (+= pulled-names name)
    )
    (return true)
  )
  (fn-expr + is-rule-unit Bool
    ; Whether the instance types a rule of a class.
    (case? (or (== (. unit initializer) 0) (== (. frame self-type) no-type))
      false
    )
    (default
      (is ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer)) .decl-rule)
    )
    (where
      (lazy unit ([] (. instances rows) instance))
    )
  )
  (fn-do + live-context LiveContext
    (param id SyntaxId)
    ; Whether a live action of the reference is open where a node is compiled: none, the one the
    ; value of a property runs in, the one a rule of a class runs in, the one the value of a live
    ; statement runs in, the one a `whenever` clause of a loop on a stream is tested in, or
    ; another, which assignments, lazy declarations, markup, streams and subscriptions open, as
    ; does a function written in a value or a rule. An argument of a markup element run again is a
    ; live statement, as is a line of its body that gives content. The `keyed by` clause of a markup
    ; loop region is typed in a function of its own, which the reference compiles where no live
    ; action is open, and so are the values given rules an element applies, where the element is
    ; written in lines of markup alone out to a class's markup (`applies-plainly`) or is the root
    ; `<This`, whose values an instance of their own types, but their conditions, each tested in a
    ; gate's (`in-condition`). Where those values read something tracked, the rules' declarations
    ; that read them are declared again as it changes (`values-live`). A closure that is
    ; the whole value of an attribute runs only once the attribute is given, outside the attribute's
    ; action, so what it reads where it opens none of its own is read plainly when it runs
    ; (`gives-closure`). The value a root `<This` gives a property is one of a property. The
    ; reference opens none for a declaration that is not lazy, which is read as the one open around
    ; it where that is none or a rule's, and a lazy one in the value of a property or of a live
    ; statement runs again with the value, whose action it reads in; a function written in its value
    ; sees none where none is open around it, as the reference looks out through the functions around
    ; it for one. A line of
    ; an arm's body that gives content is a live statement, as one of an element's body is. An
    ; element that gives a slot content is built by a function of its own, which the reference
    ; compiles where no live action is open (`builds-slot`). The name the parameter of a slot outlet
    ; that is a region gives is read in the region's action, and plainly by the outlet's function.
    ; The body of a loop on a stream written among an element's lines runs where none is open, as
    ; the reference compiles it as a function of its own there (`handler`). So do the lines of an
    ; element in the row of a keyed markup loop region that are no live statement: the function that
    ; builds the row opens none.
    (let value false)
    (let nested false)
    (let handler false)
    (for (in node (..< (+ id 1) (as (. tree nodes length) SyntaxId)))
      (if (> (call (. tree subtree-start) node) id)
        (continue)
      )
      (match? ([] (. tree nodes) node)
        (case (call .node-assign row)
          (if (== node (call root-value))
            (return (if-expr nested .live-other (. LiveContext live-value)))
          )
          (if (and (not nested) (call is-live-statement node) in-rhs)
            (return .live-statement)
          )
          (lazy in-rhs (and (<= (call (. tree subtree-start) (. row rhs)) id) (<= id (. row rhs))))
          (return .live-other)
        )
        (case (call .node-declare row)
          (if (and (not nested) (call is-live-statement node) in-right)
            (return .live-statement)
          )
          (lazy in-right (and (<= (call (. tree subtree-start) (. row right)) id) (<= id (. row right))))
          (let outer (if-expr (or (not (. row is-lazy)) (not nested)) (call live-context node) (. LiveContext live-other)))
          (if (not (. row is-lazy))
            (let plain (or (== outer .live-none) (and (not nested) (== outer .live-rule))))
            (return (if-expr plain outer (. LiveContext live-other)))
          )
          (return
            (block
              (case? (or (== outer .live-value) (== outer .live-statement))
                outer
              )
              (default
                (. LiveContext live-other)
              )
            )
          )
        )
        (case .node-markup
          (if (and (not nested) (or (!= (call live-argument node id) 0) (!= (call live-line node id) 0)))
            (return .live-statement)
          )
          (if (and (not nested) handler)
            (return .live-none)
          )
          (if (and (not nested) (call in-condition node id))
            (return .live-gate)
          )
          (if (and (not nested) (call (. tree in-application) node id) (or (call applies-plainly node) root-valued))
            (return .live-none)
          )
          (lazy root-valued (!= (. ([] (. instances rows) instance) root-values) 0))
          (if (and (not nested) (call builds-slot node))
            (return .live-none)
          )
          (if (and (not nested) (== (. frame declaration kind) .row-decl))
            (return .live-none)
          )
          (return .live-other)
        )
        (case .node-markup-slot-forward
          (return .live-other)
        )
        (case .node-markup-slot-parameter
          (if (call is-region node)
            (if nested
              (return .live-other)
            )
            (return
              (scope (if-expr branch-arm .live-none (. LiveContext live-region))
                (lazy branch-arm (== (. frame declaration kind) .branch-arm-decl))
              )
            )
          )
        )
        (case .node-slot-outlet
          (return .live-other)
        )
        (case (call .node-iterable-expression row)
          (if (and (not nested) (call is-live-statement node) in-expr)
            (return .live-statement)
          )
          (lazy in-expr (and (<= (call (. tree subtree-start) (. row expr)) id) (<= id (. row expr))))
          (return .live-other)
        )
        (case .node-when-rule-syntax
          (return (if-expr nested .live-other (. LiveContext live-rule)))
        )
        (case .node-whenever-rule-syntax
          (return (if-expr nested .live-other (. LiveContext live-rule)))
        )
        (case .node-content-block
          (return .live-other)
        )
        (case .node-state-machine
          (return .live-other)
        )
        (case (call .node-clause row)
          (if (and (== (. row op) .whenever-clause) (not nested) (!= (call nested-decl-of node) 0))
            (return .live-whenever)
          )
        )
        (case .node-if-block
          (let chooser (call selector-head node))
          (if (and (!= chooser 0) (not nested))
            (return (if-expr (call (. tree in-arm-body) chooser id) (. LiveContext live-other) (. LiveContext live-region)))
          )
          (let head (call region-head node))
          (if (!= head 0)
            (if (and (not nested) (!= (call arm-line head id) 0))
              (return .live-statement)
            )
            (if (or nested (call (. tree in-arm-body) head id))
              (return .live-other)
            )
            (return .live-region)
          )
        )
        (case .node-match-expression
          (if (and (call is-selector node) (not nested))
            (return
              (scope (if-expr in-arm (. LiveContext live-other) (. LiveContext live-region))
                (lazy in-arm (call (. tree in-arm-body) node id))
              )
            )
          )
          (if (call is-region node)
            (if (and (not nested) (!= (call arm-line node id) 0))
              (return .live-statement)
            )
            (if (or nested (call (. tree in-arm-body) node id))
              (return .live-other)
            )
            (return .live-region)
          )
        )
        (case .node-type-transform
          (if (and (not nested) (!= (call matched-line node id) 0))
            (return .live-statement)
          )
        )
        (case (call .node-for-block row)
          (let subscribes (and (call (. tree is-subscriber-loop) (. row loop)) (!= (. row body) 0)))
          (if (and (not nested) subscribes (<= (call (. tree subtree-start) (. row body)) id) (<= id (. row body)))
            (= handler true)
          )
          (if (call is-loop-region node)
            (if (and (not nested) (call (. tree in-key) node id))
              (return .live-none)
            )
            (if (or nested (not (call (. tree in-container) node id)))
              (return .live-other)
            )
            (return .live-region)
          )
        )
        (case (call .node-loop-syntax row)
          (if (. row is-subscriber)
            (return .live-other)
          )
        )
        (case .node-function-syntax
          (if (and (not nested) (call (. tree gives-closure) node))
            (return .live-none)
          )
          (= nested true)
        )
        (case (call .node-property-syntax row)
          (if (or (. frame declaration is-content) (== (. frame declaration kind) .live-decl))
            (if (call (. tree content-property) node)
              (if (and (not nested) (call is-live-statement node) in-value)
                (return .live-statement)
              )
              (lazy in-value (and (<= (call (. tree subtree-start) (. row value)) id) (<= id (. row value))))
              (return .live-other)
            )
          )
          (= value true)
        )
      )
    )
    (if (and value nested)
      (return .live-other)
    )
    (return (if-expr value .live-value (. LiveContext live-none)))
  )
  (fn-do _ selector-head SyntaxId
    (param arm SyntaxId)
    (let head arm)
    (while (!= head 0)
      (if (call is-selector head)
        (return head)
      )
      (let before (- (call (. tree subtree-start) head) 1))
      (let linked false)
      (match? ([] (. tree nodes) before)
        (case (call .node-if-block row)
          (= linked (== (. row next) head))
        )
      )
      (if (not linked)
        (return 0)
      )
      (= head before)
    )
    (return 0)
  )
  (fn-do _ in-condition Bool
    (param element SyntaxId)
    (param id SyntaxId)
    ; Whether a node is written in the condition a rule a markup element applies after `•` is
    ; applied under, which a function of its own tests again.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (for (in application ([] (. tree children) (. row style-rule-applications)))
          (match? ([] (. tree nodes) application)
            (case (call .node-style-rule-application applied)
              (if (and (!= (. applied condition) 0) after-start (<= id (. applied condition)))
                (return (!= (call nested-decl-of (. applied condition)) 0))
              )
              (lazy after-start (<= (call (. tree subtree-start) (. applied condition)) id))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + is-live-statement Bool
    (param id SyntaxId)
    ; Whether an assignment, a declaration or an argument of a markup element is one a function
    ; of its own runs again: its value reads something tracked.
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .live-decl))
      )
    )
    (return false)
  )
  (fn-do + note-live-statement _
    (param id SyntaxId)
    ; A tracked read in the value of a live statement, as the reference reads it: the statement
    ; runs in a live action the function makes when it runs, and the function the action runs it
    ; again with types it again where the statement is typed. The function that runs it again
    ; notes nothing. A statement in the value of a property or a rule, or in a nested function other
    ; than one that builds an arm of a markup branch region, a row or a slot, or that runs the body
    ; of a loop on a stream, has no shape here yet, but for a line of a style rule that sets a
    ; property of the class (`unit-styling.updating`).
    (if (== (. frame declaration kind) .live-decl)
      (return)
    )
    (let site (call enclosing-statement id))
    (let unit ([] (. instances rows) instance))
    (let updating (and (!= site 0) (== site (. unit-styling updating))))
    (if (or (== site 0) (and (or (!= (. unit initializer) 0) (call is-rule-unit)) (not updating)))
      (call decline id)
      (return)
    )
    (let kind (. frame declaration kind))
    (let built (or (== kind .branch-arm-decl) (== kind .row-decl) (== kind .slot-decl)))
    (if (and (call is-nested-kind kind) (not built) (!= kind .subscriber-decl))
      (call decline id)
      (return)
    )
    (if (call (. facts live-statement-of) instance site)
      (return)
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (if (or (== (. live action) no-instance) (== (. live previous) no-instance) missing-links)
      (call decline id)
      (return)
    )
    (lazy missing-links (or (== (. live next) no-instance) (== (. live trackers) no-instance)))
    (+= (. facts live-statements) (call LiveStatement instance site no-instance))
  )
  (fn-do _ enclosing-statement SyntaxId
    (param id SyntaxId)
    ; The assignment, the declaration, the line of a class's markup that declares a property, the
    ; stream of a value as it changes, or the argument or the line of content of a markup element, or
    ; of an arm of a region, run again a node is written in, or none. A lazy declaration in the value
    ; of one is part of it.
    (for (in node (..< (+ id 1) (as (. tree nodes length) SyntaxId)))
      (if (<= (call (. tree subtree-start) node) id)
        (match? ([] (. tree nodes) node)
          (case .node-assign
            (return node)
          )
          (case (call .node-declare row)
            (if (or (not (. row is-lazy)) (call is-live-statement node))
              (return node)
            )
          )
          (case .node-iterable-expression
            (if (call is-live-statement node)
              (return node)
            )
          )
          (case .node-property-syntax
            (if (call is-live-statement node)
              (return node)
            )
          )
          (case .node-markup
            (let arg (call live-argument node id))
            (if (!= arg 0)
              (return arg)
            )
            (let line (call live-line node id))
            (if (!= line 0)
              (return line)
            )
          )
          (case .node-if-block
            (let head (call region-head node))
            (let line (if-expr (!= head 0) (call arm-line head id) 0u32))
            (if (!= line 0)
              (return line)
            )
          )
          (case .node-match-expression
            (let line (if-expr (call is-region node) (call arm-line node id) 0u32))
            (if (!= line 0)
              (return line)
            )
          )
          (case .node-type-transform
            (let line (call matched-line node id))
            (if (!= line 0)
              (return line)
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ live-argument SyntaxId
    (param element SyntaxId)
    (param id SyntaxId)
    ; The argument of a markup element, given by position, that a node is written in, where a
    ; function of its own gives it again, or none.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (for (in arg ([] (. tree children) (. row args)))
          (if (and (<= (call (. tree subtree-start) arg) id) (<= id arg))
            (return (if-expr (call is-live-statement arg) arg 0u32))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ live-line SyntaxId
    (param element SyntaxId)
    (param id SyntaxId)
    ; The line of a markup element's body that gives content a node is written in, where a function
    ; of its own gives it again, or none.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in line ([] (. tree children) (. block body)))
              (if (and (<= (call (. tree subtree-start) line) id) (<= id line))
                (return
                  (scope (if-expr (and holds-content (call is-live-statement line)) line 0u32)
                    (lazy holds-content (!= (call (. tree content-element) line) 0))
                  )
                )
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ stream-again Bool
    (param statement SyntaxId)
    (param expr SyntaxId)
    ; Types the value of a stream of a value as it changes, given again by a live action: the value
    ; is written again by `<-write` to the channel kept where the stream was made.
    (let resolution (call (. bindings resolution-of) (. frame binding) statement))
    (let channel (if-expr (== (. resolution kind) .resolve-slot) (call (. frame slot-type) (. resolution slot)) no-type))
    (if (or (== channel no-type) (== channel invalid-type))
      (return false)
    )
    (let value (call infer expr))
    (if (or (== value invalid-type) (== value no-type))
      (return false)
    )
    (let given (list TypeId))
    (+= given value)
    (return (!= (. (call (. calls protocol-call) channel (call (. program store-atom) "<-write") statement given true (:role (. CallRole role-write))) fact) no-fact))
  )
  (fn-do + settle-live-statement _
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param written TypeId)
    ; Types the function that runs a live statement again, once the statement is typed, and
    ; says whose actions the live action is: the object named alone whose property is assigned,
    ; where it is of a class, or for a declaration the object the reference's markup parent is
    ; where it is first read, the innermost markup element whose content is being typed, or else
    ; the receiver of the function, the action of each made as `declared-maker` says. A value the
    ; assignment stores only where it holds one, a statement that sets anything but a name or a
    ; property of an object named alone, and a declaration whose reads are not each plain, as
    ; `first-plain-read` says, have no shape here yet, nor has one typed where a batch of markup is
    ; in force, whose action the reference makes with the batch.
    (let position (. facts live-statements length))
    (while (!= position 0)
      (-= position 1)
      (let row ([] (. facts live-statements) position))
      (if (or (!= (. row instance) instance) (!= (. row site) id))
        (continue)
      )
      (if (!= (. row rerun) no-instance)
        (return)
      )
      (if (call in-batch)
        (call decline id)
        (return)
      )
      (let declares (is ([] (. tree nodes) id) .node-declare))
      (let owned
        (scope (and (!= (. frame self-type) no-type) (not (call lacks-self)) class-self)
          (lazy class-self (== (call (. types intrinsic-of) (. frame self-type)) .class))
        )
      )
      (let holder no-type)
      (if declares
        (= holder
          (scope (if-expr (!= (. content-parents length) 0) last-parent owned-self)
            (lazy last-parent ([] content-parents (- (. content-parents length) 1)))
            (lazy owned-self (if-expr owned (. frame self-type) no-type))
          )
        )
      )
      (if (and (not declares) (!= written (call stored-value rhs written)))
        (call decline id)
        (return)
      )
      (match ([] (. tree nodes) lhs)
        (case .node-identifier)
        (case .node-type-capture
          (if (not declares)
            (call decline id)
            (return)
          )
        )
        (case (call .node-get-expression get)
          (match ([] (. tree nodes) (. get object))
            (case .node-identifier
              (let owner (call (. facts node-type) instance (. get object)))
              (if (and (== (call (. types intrinsic-of) owner) .class) (not (call owns-plain-actions owner)))
                (= holder owner)
              )
            )
            (default
              (call decline id)
              (return)
            )
          )
        )
        (default
          (call decline id)
          (return)
        )
      )
      (let first SyntaxId 0)
      (if declares
        (let declared (call declaring-slot lhs))
        (if (not declared)
          (call decline id)
          (return)
        )
        (= first (call first-read declared id))
      )
      (let maker (call declared-maker id holder))
      (if (not maker)
        (return)
      )
      (let rooted (and (!= maker no-instance) (== (call derived-interface holder (. types markup-host-decl)) no-type)))
      (let decl (call nested-decl-of id))
      (let rerun (call demand-lambda (call intern-nested decl) (. scratch no-types)))
      (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
        (call decline id)
        (return)
      )
      (call (. instances mark-may-panic) instance)
      (= ([] (. facts live-statements) position)
        (call LiveStatement
          (block
            (arg instance)
            (arg id)
            (arg rerun)
            (arg first)
            (arg (. U32 max))
            (arg maker)
            (arg rooted)
            (arg holder)
          )
        )
      )
      (return)
    )
  )
  (fn-do _ declared-maker (? InstanceId)
    (param site SyntaxId)
    (param holder TypeId)
    ; The function that makes the live action of a lazy declaration whose value read something
    ; tracked for the object of a type that owns it, as the reference's `createMarkupAction` makes
    ; it with no batch given: for a markup host the markup runtime's `make-owner-markup-action`,
    ; given the object as its host, else for a batch `make-markup-action`, given the object as the
    ; batch, to which it is converted at `site`; none where the object's actions are plain ones or
    ; nothing owns the action. Either may raise. One that has no shape here is declined, which is
    ; answered with nothing.
    (if (or (== holder no-type) (call owns-plain-actions holder))
      (return no-instance)
    )
    (let host
      (scope (if-expr (== (call (. types intrinsic-of) holder) .class) markup-host no-type)
        (lazy markup-host (call derived-interface holder (. types markup-host-decl)))
      )
    )
    (let rooted (== host no-type))
    (if (or (!= (call (. types intrinsic-of) holder) .class) (and rooted (not (call is-batch holder))))
      (call decline site)
      (return null)
    )
    (let wanted (if-expr rooted (call batch-type) host))
    (call demand-live-runtime)
    (let live (. instances live))
    (let mark (. scratch types mark))
    (call (. scratch types push)
      (block
        (arg (if-expr (!= (. live trackers) no-instance) (. ([] (. instances signatures) (. live trackers)) returns) no-type))
      )
    )
    (call (. scratch types push) (. live callback))
    (call (. scratch types push) wanted)
    (let action
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) (if-expr rooted "make-markup-action" "make-owner-markup-action")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== action no-instance) (== (. live has-actions) no-instance) other-return)
      (call decline site)
      (return null)
    )
    (lazy other-return (!= (. ([] (. instances signatures) action) returns) (. types live-action-type)))
    (if (not (call raises-out site action))
      (call decline site)
      (return null)
    )
    (call (. conversions convert)
      (block
        (arg site)
        (arg site)
        (arg holder)
        (arg wanted)
        (arg (if-expr rooted .reason-markup-batch .reason-markup-host))
      )
    )
    (return action)
  )
  (fn-do _ first-read SyntaxId
    (param slot SlotId)
    (param declaration SyntaxId)
    ; The first read of a lazy local in the order written, or none where nothing reads it.
    (let range (. ([] (. bindings bindings) (. frame binding)) subtree))
    (let start (call (. tree subtree-start) declaration))
    (for (in node (..< (. range start) (+ (. range start) (. range count))))
      (if (or (not (is ([] (. tree nodes) node) .node-identifier)) (and (>= node start) (<= node declaration)))
        (continue)
      )
      (let resolution (call (. bindings resolution-of) (. frame binding) node))
      (if (and (== (. resolution kind) .resolve-slot) (== (. resolution slot) slot))
        (return node)
      )
    )
    (return 0)
  )
  (fn-do + demand-live-runtime _
    ; Types, once, the instances a tracked value runs through (`LiveRuntime`): the module that
    ; declares a live action declares the rest.
    (let action (. types live-action-type))
    (if (or (. instances live demanded) (== action invalid-type))
      (return)
    )
    (= (. instances live demanded) true)
    (let live (. instances live))
    (call (. types complete) action)
    (let module (. (call class-ref types action) module))
    (let trackers (. ([] (. types properties) (!! (call property-named action (call (. program store-atom) "trackers")))) type))
    (let callback (. ([] (. types properties) (!! (call property-named action (call (. program store-atom) "callback")))) type))
    (let mark (. scratch types mark))
    (= (. live trackers) (call (. calls demand-constructor) trackers mark))
    (call (. scratch types push) trackers)
    (call (. scratch types push) callback)
    (= (. live action) (call (. calls demand-constructor) action mark))
    (call (. scratch types rewind) mark)
    (call (. scratch types push) action)
    (let actions (call (. types class-named-with-args) module (!! (. types list-atom)) mark))
    (call (. scratch types rewind) mark)
    (= (. live actions) (call (. calls demand-constructor) actions mark))
    (call (. scratch types push) action)
    (= (. live add-action) (call (. calls demand-runtime-call) module actions (call (. program store-atom) "+=") mark))
    (call (. scratch types rewind) mark)
    (let tracking (call (. types well-known-type) "core/tracker" "Tracker"))
    (if (!= tracking invalid-type)
      (call (. scratch types push) tracking)
      (= (. live add-tracker) (call (. calls demand-runtime-call) module trackers (call (. program store-atom) "+=") mark))
      (call (. scratch types rewind) mark)
    )
    (= (. live pop) (call (. calls demand-method) actions (call (. program store-atom) "pop")))
    (= (. live has-actions) (call (. calls demand-method) actions (call (. program store-atom) "!")))
    (= (. live close) (call (. calls demand-method) action (call (. program store-atom) "close")))
    (= (. live previous) (call module-getter module "active-previous-trackers"))
    (= (. live next) (call module-getter module "active-next-trackers"))
    (call (. scratch types push) trackers)
    (call (. scratch types push) trackers)
    (= (. live enter) (call (. calls demand-runtime-call) module no-type (call (. program store-atom) "live-enter") mark))
    (call (. scratch types rewind) mark)
    (= (. live leave) (call (. calls demand-runtime-call) module no-type (call (. program store-atom) "live-leave") mark))
    (let tracker (call (. types well-known-type) "core/tracker" "PropertyTracker"))
    (if (== tracker invalid-type)
      (= (. instances live) live)
      (return)
    )
    (call (. types complete) tracker)
    (let subscribers (call tracker-field tracker "subscribers"))
    (= (. live subscribers) (call (. calls demand-constructor) subscribers mark))
    (call (. scratch types push) trackers)
    (call (. scratch types push) trackers)
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (call tracker-field tracker "property-id"))
    (call (. scratch types push) subscribers)
    (call (. scratch types push) (call tracker-field tracker "owner"))
    (= (. live track)
      (call (. calls demand-runtime-call)
        (block
          (arg module)
          (arg no-type)
          (arg (call (. program store-atom) "track-property-dependency"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) subscribers)
    (call (. scratch types push) (. types string-type))
    (= (. live dispatch)
      (call (. calls demand-runtime-call)
        (block
          (arg module)
          (arg no-type)
          (arg (call (. program store-atom) "property-dispatch"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let memo (call (. types well-known-type) "core/tracker" "MemoAction"))
    (if (!= memo invalid-type)
      (call (. types complete) memo)
      (let owner (call tracker-field memo "owner"))
      (let offset (call tracker-field memo "flag-offset"))
      (call (. scratch types push) trackers)
      (call (. scratch types push) callback)
      (call (. scratch types push) owner)
      (call (. scratch types push) offset)
      (call (. scratch types push) (. types string-type))
      (= (. live memo-action) (call (. calls demand-constructor) memo mark))
      (call (. scratch types rewind) mark)
      (call (. scratch types push) owner)
      (call (. scratch types push) offset)
      (= (. live memo-settle)
        (call (. calls demand-runtime-call)
          (block
            (arg module)
            (arg no-type)
            (arg (call (. program store-atom) "memo-settle-at"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
    )
    (= (. live callback) callback)
    (let carried (call carried-result types callback))
    (if (!= carried no-type)
      (call (. types complete) carried)
      (call (. facts note-carried) (call function-row types callback) carried)
    )
    (= (. live callback-result) carried)
    (= (. instances live) live)
  )
  (fn-do + tracker-field TypeId
    (param tracker TypeId)
    (param name String)
    ; The declared type of a property of the runtime's property tracker, which gives the types the
    ; runtime's tracking functions take.
    (let place (call property-named tracker (call (. program store-atom) name)))
    (return (if-expr place (. ([] (. types properties) place) type) invalid-type))
  )
  (fn-do _ module-getter InstanceId
    (param module ModuleId)
    (param name String)
    ; A getter a module declares, typed for compiled code that reads it of its own accord.
    (let atom (call (. program store-atom) name))
    (let decls (. ([] (. program modules) module) decls))
    (for (in position (..< 0 (. decls length)))
      (match? ([] decls position)
        (case (call .decl-function fn)
          (if (and (== (. fn owner) 0) (== (. fn kind) .getter-decl) (== (. fn name) atom))
            (let decl (as position DeclId))
            (let callee
              (call (. instances intern)
                (block
                  (arg module)
                  (arg decl)
                  (arg no-type)
                  (arg (call callee-effects frame module decl))
                  (arg no-instance)
                )
              )
            )
            (call demand callee)
            (return callee)
          )
        )
      )
    )
    (return no-instance)
  )
  (fn-do _ is-lazy-value Bool
    ; Whether the instance types the value written for a lazy property of a class, worked out once
    ; when it is first read.
    (let unit ([] (. instances rows) instance))
    (if (or (== (. unit initializer) 0) (== (. frame self-type) no-type))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-property row)
        (return (. row is-lazy))
      )
    )
    (return false)
  )
  (fn-do + check-tracked-store _
    (param id SyntaxId)
    (param lhs SyntaxId)
    ; A store to a local some read tracks, which runs the actions that read it where its bits
    ; change, as the reference's function scope does once it has made its list of subscribers;
    ; they may panic. A store from a function written in the one that declares the local runs
    ; them through the list that function keeps, which it captures. A store to the copy of the
    ; local a task's body holds, and one to a local that shares its name with one some read
    ; tracks, which the reference's list runs the actions of too, have no shape here yet. What the
    ; actions run leaves what is known of properties in doubt.
    (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
    (if (or (!= (. resolution kind) .resolve-slot) (not (call (. bindings is-trackable) (. resolution slot))))
      (return)
    )
    (if (== (/and/ (. ([] (. bindings slots) (. resolution slot)) flags) (. SlotFlag slot-tracked)) 0)
      (if (call (. bindings namesake) (. resolution slot) true)
        (call decline id)
      )
      (return)
    )
    (let subscribers (call subscribers-slot (. resolution slot)))
    (if (== subscribers no-slot)
      (return)
    )
    (if (and (call (. frame is-captured) (. resolution slot)) (or (not (call (. frame is-captured) subscribers)) (call copies (. resolution slot))))
      (call decline id)
      (return)
    )
    (call demand-live-runtime)
    (if (== (. instances live dispatch) no-instance)
      (call decline id)
      (return)
    )
    (call (. instances mark-may-panic) instance)
    (call (. frame doubt-members))
  )
  (fn-do _ copies Bool
    (param slot SlotId)
    ; Whether the function, or one it is written in, out to the one that declares a local, holds a
    ; copy of the local, as a task's body does.
    (if (not (call (. frame is-captured) slot))
      (return false)
    )
    (if (call (. frame holds-copy) slot)
      (return true)
    )
    (if (not outer)
      (return false)
    )
    (return (call (. outer copies) slot))
  )
)
