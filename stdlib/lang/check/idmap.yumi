/core/arena

━━━━━━━━━━━━━━━━━━━━
_ IdKey is Tuple
    is Hashable

+ data CPointer'U32
+ count U32 = 0

────────────────────
+ do this == other This

=? if count != other.count
. total Size = count
for offset in 0 .. < total
    =? if data[offset] != other.data[offset]
= true

────────────────────
+ do get hash Hash

. fingerprint = (2166136261 /xor/ count) * 16777619
. total Size = count
for offset in 0 .. < total
    fingerprint = (fingerprint /xor/ data[offset]) * 16777619
= fingerprint

━━━━━━━━━━━━━━━━━━━━
+ IdMap
    is Usable'Void

_ arena Arena
_ entries Map'IdKey'U32'ArenaBacking
_ keys List'IdKey'ArenaBacking
+ last-inserted Bool
_ released Bool

────────────────────
+ This

.. entries = Map'IdKey'U32(arena)
.. keys = List'IdKey(arena)

────────────────────
+ get length Size

?! Panic("IdMap arena is stale or released")
    if released

keys.length

────────────────────
+ do store Index
    - data CPointer'U32
    - count Size

?! Panic("IdMap arena is stale or released")
    if released
?! Panic("IdMap key exceeds U32 capacity")
    if count >= U32.max
?! Panic("IdMap entry count exceeds U32 capacity")
    if keys.length >= U32.max

. probe = IdKey(data, count as U32)
. existing = entries[probe]

if existing
    last-inserted = false
    = existing

. stable = arena.allocate'U32(count)
for offset in 0 .. < count
    stable[offset] = data[offset]

. durable = IdKey(stable, count as U32)
. ordinal = keys.length
keys += durable
entries[durable] = ordinal as U32
last-inserted = true
= ordinal

────────────────────
+ find Index?
    - data CPointer'U32
    - count Size

?! Panic("IdMap arena is stale or released")
    if released
?! Panic("IdMap key exceeds U32 capacity")
    if count >= U32.max

|? existing
    existing
??
    null

.. probe = IdKey(data, count as U32)
.. existing = entries[probe]

────────────────────
+ key-count Size
    - index Index

?! Panic("IdMap arena is stale or released")
    if released
?! Panic("IdMap index out of bounds")
    if index >= keys.length

keys[index].count

────────────────────
+ key-word U32
    - index Index
    - offset Index

?! Panic("IdMap arena is stale or released")
    if released
?! Panic("IdMap index out of bounds")
    if index >= keys.length
?! Panic("IdMap key word offset out of bounds")
    if offset >= keys[index].count

keys[index].data[offset]

────────────────────
+ do begin-using

────────────────────
+ do end-using without gc

release()

────────────────────
+ do release without gc

if !released
    arena.release()
    released = true
