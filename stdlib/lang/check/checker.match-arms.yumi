        =
plan-leaves(pattern, subject, target, kind, U32.max)
plan-exact(pattern, kind)

────────────────────
+ do plan-exact
    - pattern SyntaxId
    - kind Specificity

if kind == .exact && facts.plan-of(instance, pattern) != .plan-never
    facts.set-plan(instance, pattern, .plan-exact-class)

────────────────────
+ do plan-leaves
    - pattern SyntaxId
    - held TypeId
    - target TypeId
    - kind Specificity
    - guard U32

. intrinsic = types.intrinsic-of(held)
if intrinsic == .optional
    plan-leaves(pattern, types.optional-inner(held), target, kind, guard)
    =
. whole = relations.compare-pattern(held, target, module)
if relations.holds-as(whole, kind)
    conversions.record-pattern(pattern, whole, guard)
    =
if intrinsic != .union
    =
if guard != U32.max
    conversions.record-pattern(pattern, whole, guard)
    =
. cases = types.cases-of(held)
for index in 0 .. < cases.length
    . fact = cases[index]
    if fact.type == no-type || fact.type == invalid-type
