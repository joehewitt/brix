━━━━━━━━━━━━━━━━━━━━
_ CursorBinding is Tuple

` The row cursor a pattern binds (`check-pattern`): whether it binds one, and the row it captures.

+ binds Bool
+ capture RowCapture = RowCapture(no-type, U32.max, false)

━━━━━━━━━━━━━━━━━━━━
_ MatchArms is facet of Checker
    sees Streams
    sees Tables

_ cursor-binding = CursorBinding()

────────────────────
_ do arm-symbol TypeId
    - expr SyntaxId
    - symbol Atom

for position in arming.start .. < scratch.types.length
    . noted = scratch.types[position]
    if noted != no-type && noted != invalid-type && enum-case-decl(types, program, noted, symbol)
        note-enum-case(noted, symbol, expr)
        facts.set-node-type(instance, expr, noted)
        = noted
= no-type

────────────────────
_ do note-switch
    - pattern SyntaxId
    - subject TypeId

. arms [SyntaxId]
if !gather-switch-arms(pattern, arms)
    =
. kind = types.intrinsic-of(subject)
. cases = kind == .union || kind == .table-row || kind == .immutable-table-row
if !cases && !is-integer-kind(kind)
    =
. tested U32
for position in 0 .. < arms.length
    . arm = arms[position]
    if facts.plan-of(instance, arm) == .plan-never
        =
    do match? tree.nodes[arm]
        | .node-type-transform(row)
            if row.pattern == 0 || tree.nodes[row.pattern] is .node-type-wildcard
                if position != arms.length - 1
                    =
                continue
            if cases && !names-switch-case(row.pattern)
                =
            if !cases && !names-switch-number(row.pattern, subject)
                =
            tested += 1
if tested < 2
    =
facts.set-constant
    - instance
    - pattern
    - ConstantFact(if cases then 1 else 2, 0.0, null, false)
    - .plan-switch

────────────────────
_ do gather-switch-arms Bool
    - pattern SyntaxId
    - arms [SyntaxId]

do match? tree.nodes[pattern]
    | .node-type-or(row)
        = gather-switch-arms(row.left, arms) && gather-switch-arms(row.right, arms)
    | .node-type-transform(row)
        if row.pattern != 0 && tree.nodes[row.pattern] is .node-type-or
            = false
        arms += pattern
        = true
= false

────────────────────
_ names-switch-case Bool
    - pattern SyntaxId

|? facts.plan-of(instance, pattern) != .plan-case || facts.constant-of(instance, pattern) == no-fact
    false
??
    tree.nodes[pattern] is .node-type-case

────────────────────
_ do names-switch-number Bool
    - pattern SyntaxId
    - subject TypeId

do match? tree.nodes[pattern]
    | .node-type-equality(row)
        if row.is-contextual || types.completions[subject].has-equalities
            = false
        do match? tree.nodes[row.expr]
            | .node-integer-syntax(literal)
                if literal.unit
                    = false
                . parsed = parse-integer-literal(literal.value)
                = !parsed.negative && literal-fits-target(types, parsed, subject)
= false

────────────────────
+ do infer-match TypeId
    - id SyntaxId
    - subject-syntax SyntaxId
    - body SyntaxId
    - is-optional Bool
    - helper SyntaxId
    - is-block Bool
    - want Want = Want()

. expected = arms-expected
arms-expected = no-type
. subject = no-type
if subject-syntax != 0
    subject = infer-unprojected(subject-syntax)
. saved-helper = helping
helping = helping.helper = null
helping = helping.site = 0
helping = helping.rolls = false
helping = helping.explicit = false
helping = helping.body = 0
if helper != 0 && !type-helper(helper)
    helping = saved-helper
    = invalid-type
. own-matching = matching
matching = matching.rows = subject-syntax != 0 && reads-row(subject-syntax)
if matching.rows
    facts.mark-checked-row(instance, subject-syntax)
matching = matching.subject = subject
arms-expected = expected
matching = matching.optional = is-optional
matching = matching.open = tested-match == id
tested-match = 0
matching = matching.closed = if is-block && !is-optional && subject-syntax != 0 then body else 0
matching = matching.arms = if is-block && subject-syntax != 0 then body else 0
. saved-stream = rule-streaming
matching = matching.case = subject-syntax
rule-streaming = rule-streaming.matched = 0
if subject-syntax != 0 && tree.stream-statement(body) != 0
    rule-streaming = rule-streaming.matched = tree.stream-statement(body)
    helping = helping.body = rule-streaming.matched
    . subject-slot = arm-slot(id, .slot-it)
    if subject-slot != no-slot && subject != no-type && subject != invalid-type
        frame.assign(subject-slot, subject)
. result = check-statement(body, if want.asks(.want-match-statement) then Want().adding(.want-match-statement) else Want())
if result != invalid-type && helping.rolls && helping.helper!.rollback == no-type
    frame.diagnose
        - if rule-streaming.matched != 0 then rule-streaming.matched else id
        - .stated
        - program.store-atom
            - "Pattern @rollback helper must implement PatternRollback with a concrete Mark type"
    result = invalid-type
rule-streaming = saved-stream
helping = saved-helper
matching = own-matching
arms-expected = no-type
if expected != no-type && !is-optional
    . recorded = facts.node-type(instance, body)
    if !types.is-optional(expected) && recorded == types.optional-of(expected)
        facts.replace-node-type(instance, id, recorded)
    else if recorded != no-type
        facts.set-node-type(instance, id, recorded)
if result == no-type
    = invalid-type
= if is-optional then types.optional-of(result) else result

────────────────────
+ do infer-arms TypeId
    - id SyntaxId
    - pattern SyntaxId
    - want Want = Want()

` The type a match's arms give, joined, each arm checked against the subject. A match written
` as a statement is one for its own arms alone: a match written in one of them is an
` expression unless it is written as a statement too. Arms of conditions alone with no else,
` where a type is expected that is no optional, give an optional of it, as the reference's do,
` which whatever expects it converts. An integer an arm gives written with no suffix takes the
` type expected, or with none expected, the type of the first arm that gives one written with one.
. expected = arms-expected
arms-expected = no-type
. subject = matching.subject
. as-statement = want.asks(.want-match-statement)
. own-arming = arming
. arms-mark = scratch.types.mark
arming = Arming(as-statement, arms-mark, expected, false, arming.union, 0, tree.is-alternative(pattern), no-slot, 0)
. narrow-mark = scratch.narrowings.mark
. first-arm = arm-bodies.length
. first-value = arm-values.length
. first-settled = arm-settled.length
. first-raised = raised-arms.length
if matching.arms != 0 && closes(matching.arms, id)
    check-arm-reach(pattern, subject, true)
. has-else = collect-arms(pattern, subject)
. possible = arming.possible
. unites = arming.unite && expected == no-type
. union-start = arming.union
arming = own-arming
if matching.closed != 0 && closes(matching.closed, id)
    check-coverage(id, pattern, subject)
frame.pop-narrowing(narrow-mark)
if as-statement && !matching.optional
    merge-arms(first-arm)
if as-statement && stays-present(first-arm)
    narrowing.narrow-condition(matching.case, true)
. own-settled [Narrowed]
for position in first-settled .. < arm-settled.length
    own-settled += arm-settled[position]
-= arm-settled[first-settled .. < arm-settled.length]
widen-settled(own-settled)
-= arm-bodies[first-arm .. < arm-bodies.length]
-= arm-present[first-arm .. < arm-present.length]
-= arm-starts[first-arm .. < arm-starts.length]
-= arm-ends[first-arm .. < arm-ends.length]
. closed = matching.closed != 0 && closes(matching.closed, id)
. absent = subject != no-type && !matching.optional && !matching.open && !closed && conditional
    .. conditional = is-conditional(pattern)
if absent && expected != no-type && !types.is-optional(expected)
    decline(id)
if !has-else && subject != no-type && !matching.optional && matching.open
    facts.set-plan(instance, id, .plan-open)
else if !has-else && absent
    facts.set-plan(instance, id, .plan-unmatched-absent)
else if !has-else && subject != no-type && !matching.optional
    instances.mark-may-panic(instance)
    facts.set-plan(instance, id, .plan-unmatched)
if subject != no-type && subject != invalid-type
    note-switch(pattern, subject)
. arms = scratch.types.since(arms-mark)
. values [SyntaxId]
for position in first-value .. < arm-values.length
    values += arm-values[position]
-= arm-values[first-value .. < arm-values.length]
. valued = values.length == arms.length
. typed [TypeId]
. peer = if !valued then no-type else if expected != no-type then expected-inner else written-peer
    .. expected-inner = types.optional-inner(expected)
    .. written-peer = arms-peer(arms, values)
for position in 0 .. < arms.length
    typed += if peer != no-type then conversions.adapted-literal(values[position], arms[position], peer) else arms[position]
. raises = gives-errors(arms, expected)
if raises && frame.surround.catch-depth == 0
    for position in first-raised .. < raised-arms.length
        facts.set-plan(instance, raised-arms[position], .plan-raise)
-= raised-arms[first-raised .. < raised-arms.length]
. errors [TypeId]
. mark = scratch.types.mark
. has-null = false
for arm in typed
    if arm == types.null-type
        has-null = true
    else if raises && raises-at-arm(arm, expected)
        if errors.find(arm) == null
            errors += arm
    else if arm != invalid-type
        scratch.types.push(arm)
if scratch.types.length == mark && has-null
    scratch.types.push(types.null-type)
if scratch.types.length == mark && possible == 0 && matching.optional && optional-expected
    scratch.types.push(expected)
.. optional-expected = expected != no-type && types.is-optional(expected)
if scratch.types.length == mark && errors.length != 0
    scratch.types.rewind(arms-mark)
    if frame.surround.catch-depth != 0
        . raised = scratch.types.mark
        for error in errors
            scratch.types.push(error)
        = result-type(types, types.void-type, raised)
    for error in errors
        note-outgoing(error, id)
    = types.void-type
if scratch.types.length == mark
    scratch.types.rewind(arms-mark)
    if possible == 0
        frame.diagnose(pattern, .no-possible-matches)
    = invalid-type
. joined = relations.join-arms(mark)
if unites
    . united = scratch.types.mark
    for position in union-start .. < mark
        . arm = scratch.types[position]
        if arm != types.null-type && arm != invalid-type
            scratch.types.push(arm)
    joined = types.intern-union(united)
scratch.types.rewind(mark)
. result = joined
if expected != no-type
    result = expected
    . missed = !has-else && subject == no-type && expected != types.void-type
    if missed && !types.is-optional(expected)
        result = types.optional-of(expected)
        facts.replace-node-type(instance, id, result)
    else
        facts.set-node-type(instance, id, joined)
else if null-joined || absent || (!has-else && subject == no-type)
    result = types.optional-of(joined)
.. null-joined = has-null && joined != types.null-type && !holds-null(joined)
. joins = !as-statement
for position in 0 .. < arms.length
    . arm = typed[position]
    if joins && arm != result && arm != invalid-type && !(raises && raises-at-arm(arm, expected))
        conversions.convert(id, if valued then values[position] else 0, arm, result, .reason-join)
scratch.types.rewind(arms-mark)
if raises && frame.surround.catch-depth != 0
    . raised = scratch.types.mark
    for error in errors
        scratch.types.push(error)
    = result-type(types, result, raised)
for error in errors
    note-outgoing(error, id)
= result

────────────────────
+ do literal-peer TypeId
    - types-start ScratchMark
    - syntax-start ScratchMark
    - count Size

` The type integers written with no suffix take among values joined: that of the first value
` written with none, what it holds where it is an optional, or where each is written with none,
` that of the first float, or where each is a tuple, the tuple they join to place by place. Where
` no value is written with one there is none.
. peer = no-type
. float = no-type
. places = no-type
. plain = false
for offset in 0 .. < count
    . syntax = scratch.syntax[syntax-start + offset]
    . type = scratch.types[types-start + offset]
    if conversions.literal-of(syntax) == 0
        if peer == no-type
            peer = types.optional-inner(type)
    else
        plain = true
        if float == no-type && tree.nodes[syntax] is .node-float-syntax
            float = type
        if tree.nodes[syntax] is .node-tuple-syntax
            places = if offset == 0 then type else if places != no-type then relations.joined-places(places, type) else no-type
        else
            places = no-type
|? !plain
    = no-type
|? peer != no-type
    = peer
|? float != no-type
    = float
??
    = places

────────────────────
_ do arms-peer TypeId
    - arms ImmutableArray'TypeId'ArenaBacking
    - values [SyntaxId]

` The type integers written with no suffix take among the values of a match's arms: that of the
` first arm that gives a value written with none other than a text, what it holds where it is an
` optional, or where each is written with none, that of the first that gives a float.
. float = no-type
for position in 0 .. < arms.length
    . arm = arms[position]
    if arm != types.null-type && arm != invalid-type && non-literal && !text
        = types.optional-inner(arm)
    .. non-literal = conversions.literal-of(values[position]) == 0
    .. text = types.optional-inner(arm) == types.string-type
    if float == no-type && values[position] != 0 && float-written
        float = arm
    .. float-written = tree.nodes[values[position]] is .node-float-syntax
= float

────────────────────
+ holds-null Bool
    - type TypeId

` Whether a type is a union with a case that holds `null`, which a `null` joined with it becomes.
types.intrinsic-of(type) == .union && relations.unnamed-case-holds(type, types.null-type)

────────────────────
_ do merge-arms
    - first Size

` After a match statement, a local every arm that falls through leaves holding the same value
` holds it: the arms agree, as the reference's flow facts merge them. Only an arm's own
` statements count.
. lead = Size.max
for arm in first .. < arm-bodies.length
    if lead == Size.max && !narrowing.exits(arm-bodies[arm])
        lead = arm
if lead == Size.max
    =
for position in arm-starts[lead] .. < arm-ends[lead]
    . slot = frame.assigned-slots[position]
    . settled = arm-settles(lead, slot)
    if settled == no-type || settled == slot-known(slot)
        continue
    . agreed = true
    for arm in first .. < arm-bodies.length
        if !narrowing.exits(arm-bodies[arm]) && arm-settles(arm, slot) != settled
            agreed = false
    if agreed
        frame.push-assigned(slot-key(slot), settled)

────────────────────
_ do stays-present Bool
    - first Size

if matching.case == 0
    = false
. reached = false
for arm in first .. < arm-bodies.length
    if !narrowing.exits(arm-bodies[arm])
        if !arm-present[arm]
            = false
        reached = true
= reached

────────────────────
_ do arm-settles TypeId
    - arm Size
    - slot SlotId

` What an arm's own statements last assign a local, or no type when they assign it nothing.
. settled = no-type
for position in arm-starts[arm] .. < arm-ends[arm]
    if frame.assigned-slots[position] == slot
        if tree.is-direct-statement(arm-bodies[arm], frame.assigned-syntax[position])
            settled = frame.assigned-types[position]
= settled

────────────────────
+ is-raised Bool
    - arm TypeId

arm != invalid-type && arm != no-type && is-subtype(types, arm, types.error-type)

────────────────────
_ do raises-at-arm Bool
    - arm TypeId
    - expected TypeId

=? false if !is-raised(arm)
=? true if expected == no-type
. held = types.optional-inner(result-value(types, expected))
=? false if is-subtype(types, arm, held)
=? true if types.intrinsic-of(held) != .union
= all(types.cases-of(held)) • where !is-subtype(types, arm, each.type)

────────────────────
_ do gives-errors Bool
    - arms ImmutableArray'TypeId'ArenaBacking
    - expected TypeId

` Whether some arm gives an error the type the arms are expected to give does not hold: those
` errors then leave the function as errors, each at its arm, and the values alone are what the
` arms give, or nothing where every arm gives such an error.
for arm in arms
    if raises-at-arm(arm, expected)
        = true
= false

────────────────────
_ do closes Bool
    - body SyntaxId
    - arms SyntaxId

` Whether arms are the ones a match must cover its subject with: the body of the match, of a
` catch the body is, or a statement of a block the body is.
if body == arms
    = true
do match? tree.nodes[body]
    | .node-catch-expression(row)
        = closes(row.body, arms)
    | .node-block(row)
        for statement in tree.children[row.body]
            if closes(statement, arms)
                = true
= false

────────────────────
_ do check-coverage
    - id SyntaxId
    - pattern SyntaxId
    - subject TypeId

. coverage = Coverage(frame, this)
. gap = coverage.gap(pattern, subject)
if gap
    . site = if coverage.site != 0 then coverage.site else id
    frame.diagnose(site, .stated, program.store-atom(gap), subject)
    frame.mention(coverage.held)

────────────────────
_ do check-arm-reach Bool
    - pattern SyntaxId
    - subject TypeId
    - is-last Bool

do match? tree.nodes[pattern]
    | .node-type-or(row)
        = check-arm-reach(row.left, subject, false) || check-arm-reach(row.right, subject, is-last)
. armed = pattern
do match? tree.nodes[pattern]
    | .node-type-transform(row)
        armed = row.pattern
. shown = tree.takes-all(armed)
if !shown
    = false
if armed != 0 && tree.nodes[armed] is .node-type-capture
    . bound = Coverage(frame, this).bound-case(armed, subject)
    if bound
        frame.diagnose(armed, .stated, program.store-atom(bound), subject)
        = true
if is-last
    = false
. site = if armed != 0 then armed else pattern
frame.diagnose
    - site
    - .stated
    - program.store-atom("Arm '$shown' takes every value, so the arms after it are never reached")
= true

────────────────────
_ do collect-arms Bool
    - id SyntaxId
    - subject TypeId

` Types the arms of a match, each alternative of an `or` in turn, and says whether one is the
` arm of what is left. An arm written `|?` with no body gives what its condition tested, forced,
` which the reference evaluates again: where the flow knows that by no key, the force takes the
` type the test gave, so what the condition calls is recorded once. An arm whose value is a case
` named by its symbol alone, where a type is expected of the match, gives the case of that type
` where it can (`armed-symbol`).
if id == 0
    = false
do match tree.nodes[id]
    | .node-type-or(row)
        . left = collect-arms(row.left, subject)
        if !fails-present(row.left) || untyped || !types.is-optional(subject)
            . right = collect-arms(row.right, subject)
            = left || right
        .. untyped = subject == no-type || subject == invalid-type
        facts.set-plan(instance, id, .plan-present-after)
        narrowing.narrow-condition(matching.case, true)
        arming = arming.present-depth = arming.present-depth + 1
        . present = collect-arms(row.right, types.optional-inner(subject))
        arming = arming.present-depth = arming.present-depth - 1
        = left || present
    | .node-type-transform(row)
        . is-else = tree.pattern-is-else(row.pattern)
        . entered = frame.live-members()
        . unread SyntaxId = 0
        if arming.several && subject != no-type && subject != invalid-type
            unread = name-read(row.pattern)
        if unread != 0
            frame.diagnose(unread, .stated, program.store-atom("Type not found"))
            facts.set-plan(instance, id, .plan-never)
            = false
        if !is-else && !pattern-possible(row.pattern, subject)
            facts.set-plan(instance, id, .plan-never)
            = false
        arming = arming.possible = arming.possible + 1
        . subject-slot = arm-slot(id, .slot-it)
        if subject-slot != no-slot && subject != no-type && subject != invalid-type
            frame.assign(subject-slot, subject)
            carry-subject(subject-slot)
        . own-arm = arm-typing
        arm-typing = arm-typing.it = subject-slot
        check-pattern(row.pattern, subject)
        arm-typing = own-arm
        if subject-slot != no-slot && subject != no-type && subject != invalid-type
            . passed = passed-type(row.pattern, subject)
            if passed != subject
                frame.assign(subject-slot, passed)
        . predicate = tree.predicate-expr(row.pattern)
        . mark = scratch.narrowings.mark
        narrowing.narrow-condition(predicate, true)
        if predicate != 0 && subject == no-type
            . it-slot = arm-slot(id, .slot-it)
            . it-type = facts.node-type(instance, predicate)
            do match? tree.nodes[predicate]
                | .node-identifier
                    . resolution = bindings.resolution-of(frame.binding, predicate)
                    if resolution.kind == .resolve-slot
                        it-type = frame.slot-type(resolution.slot)
            if it-slot != no-slot && it-type != no-type
                frame.assign(it-slot, it-type)
        . value = no-type
        . symbol = tree.symbol-of(row.expr)
        . assigned-start = frame.assigned-syntax.length
        if symbol && arming.expected == no-type
            value = arm-symbol(row.expr, symbol)
        . diagnosed = facts.diagnostics.length
        . known = frame.save-members()
        if value == no-type
            . own-arm = arm-typing
            arm-typing = arm-typing.forced = if predicate != 0 && narrowing.condition-slot(predicate) == null then predicate else 0
            arm-typing = arm-typing.symbol = if arming.expected != no-type then tree.arm-value(row.expr) else 0
            if passes-expected(row.expr)
                note-returned-match(tree.arm-value(row.expr), arming.expected)
                arms-expected = arming.expected
            value = check-statement(row.expr)
            arm-typing = own-arm
        if narrowing.exits(row.expr)
            frame.restore-members(known)
        else if known.narrowed && !frame.members-narrowed
            frame.keep-members(entered)
        . silent = row.expr != 0 && facts.diagnostics.length == diagnosed
        if silent && !arming.statement && lacks-value(row.expr, value) && !matches-row(subject)
            frame.diagnose(row.expr, .stated, program.store-atom("Match arm gives no value"))
        arm-bodies += row.expr
        arm-present += arming.present-depth != 0
        arm-starts += assigned-start
        arm-ends += frame.assigned-syntax.length
        if !narrowing.exits(row.expr)
            for settled in frame.assigned-since(mark)
                arm-settled += settled
        frame.pop-narrowing(mark)
        narrowing.narrow-condition(predicate, false)
        if value != no-type
            if row.is-union && !arming.unite
                arming = arming.unite = true
                arming = arming.union = scratch.types.mark
            scratch.types.push(value)
            arm-values += tree.arm-value(row.expr)
        if raises-at-arm(value, arming.expected)
            raised-arms += id
        = is-else
    | .node-type-panic(row)
        = collect-panic(row.pattern, subject)
    ??
        . is-else = tree.pattern-is-else(id)
        if !is-else && !pattern-possible(id, subject)
            facts.set-plan(instance, id, .plan-never)
            = false
        arming = arming.possible = arming.possible + 1
        check-pattern(id, subject)
        . value = pattern-value(id, subject)
        if value != no-type && value != invalid-type
            scratch.types.push(value)
            arm-values += 0
        = is-else

────────────────────
_ do passes-expected Bool
    - body SyntaxId

` Whether the value of an arm is a match that nothing in the arm runs before, which is of the
` type the arms are expected to give as a returned match is, so that its own arms convert to it.
. value = tree.arm-value(body)
=? false if arming.expected == no-type || arming.expected == types.void-type || !tree.is-match-syntax(value)
=? false if may-miss(value, arming.expected)
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            =? true if statement == value
            do match? tree.nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            =? false if !is-comment-syntax(tree, statement)
= true

────────────────────
_ is-conditional Bool
    - pattern SyntaxId

` Whether arms may match nothing, as the reference asks it of a match written on one line: its
` last arm has a pattern.
match tree.nodes[pattern]
    | .node-type-or(row)
        is-conditional(row.right)
    | .node-type-transform(row)
        row.pattern != 0 && is-conditional(row.pattern)
    | .node-type-panic(row)
        is-conditional(row.pattern)
    ??
        true

────────────────────
+ lacks-value Bool
    - body SyntaxId
    - value TypeId

` The body of an arm gives the match its value or leaves the function itself. One that ends in
` a match whose every arm leaves does neither: that match is an expression with no value.
|? narrowing.exits(body, true)
    false
??
    value == no-type || (value == invalid-type && narrowing.exits(body))

────────────────────
_ matches-row Bool
    - subject TypeId

` Whether a match is on a row of a table of unions, whose arms may run for their effect alone.
|? subject == no-type || subject == invalid-type
    false
??
    calls.union-row(subject) != no-type

────────────────────
_ do carry-subject
    - slot SlotId

` The subject of a match is one value under the `it` of each arm. What the arms before left
` known of it, by a condition that did not hold, is known of it in the arm that follows.
if arming.it != no-slot && arming.it != slot
    . carried = frame.narrowed-slot(arming.it)
    if carried != no-type
        frame.push-narrowing(slot-key(slot), carried, frame.narrowed-cases(slot-key(arming.it)))
arming = arming.it = slot

────────────────────
_ do collect-panic Bool
    - id SyntaxId
    - subject TypeId

do match? tree.nodes[id]
    | .node-type-transform(row)
        . is-else = tree.pattern-is-else(row.pattern)
        check-pattern(row.pattern, subject)
        . predicate = tree.predicate-expr(row.pattern)
        check-assertion(id, row.expr, 0)
        narrowing.narrow-condition(predicate, false)
        = is-else
= false

────────────────────
+ do arm-slot SlotId
    - arm SyntaxId
    - kind SlotKind

. bound = bindings.bindings[frame.binding]
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    . row = bindings.slots[slot]
    if row.kind == kind && row.syntax == arm
        = slot
= no-slot

────────────────────
_ fails-present Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-or(row)
        fails-present(row.left) || fails-present(row.right)
    | .node-type-transform(row)
        row.pattern != 0 && fails-present(row.pattern)
    | .node-type-equality(row)
        narrowing.is-null-syntax(row.expr)
    ??
        false

────────────────────
+ do check-pattern
    - pattern SyntaxId
    - subject TypeId

if pattern == 0
    =
do match tree.nodes[pattern]
    | .node-type-predicate(row)
        check-predicate(pattern, row.expr, subject)
    | .node-type-equality(row)
        plan-equality(pattern, subject, row.expr, infer-comparand(row.expr, subject))
    | .node-type-and(row)
        if subject == types.string-type && check-text-pattern(pattern)
            =
        check-pattern(row.left, subject)
        if reads-name(row.left)
            check-pattern(row.right, passed-type(row.left, subject))
        else
            check-pattern(row.right, pattern-type(row.left, subject))
    | .node-type-or(row)
        check-alternative(row.left, subject)
        . left-slots [SlotId]
        . left-types [TypeId]
        alternative-slots(row.left, left-slots)
        for slot in left-slots
            left-types += frame.known(slot)
        check-alternative(row.right, subject)
        . right-slots [SlotId]
        alternative-slots(row.right, right-slots)
        check-alternative-names(row.left, left-slots, left-types, row.right, right-slots)
    | .node-type-panic(row)
        check-pattern(row.pattern, subject)
    | .node-type-arguments
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-type-optional
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-type-list(row)
        if is-collection-type(tree, pattern)
            plan-type-pattern(pattern, subject, no-type, .similar)
        else
            check-list-pattern(pattern, row.patterns, subject)
    | .node-type-map(row)
        if is-collection-type(tree, pattern)
            plan-type-pattern(pattern, subject, no-type, .similar)
        else
            check-map-pattern(pattern, row.patterns, subject)
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            check-pattern(row.type, subject)
            . named = declaring-slot(pattern)
            if named && subject != no-type && subject != invalid-type
                frame.assign(named, passed-type(row.type, subject))
            =
        . captured = subject
        if row.type != 0
            . annotation = types.evaluate-type(module, tree, row.type, frame.env)
            if annotation != invalid-type
                captured = completed-capture(annotation, subject)
            else if tree.names-type(row.type) || is-collection-type(tree, row.type)
                report-missing-type(row.type, frame.env)
        . slot = declaring-slot(pattern)
        if slot && captured != no-type
            frame.assign(slot, captured)
            if cursor-binding.binds
                row-cursors += RowCursor(slot, cursor-binding.capture)
        if row.type != 0 && (tree.names-type(row.type) || is-collection-type(tree, row.type))
            plan-capture(row.type, subject, captured)
        else if tree.matches-named(row.type)
            check-pattern(row.type, subject)
        else
            check-pattern(row.type, captured)
    | .node-type-match(row)
        if tree.names-type(row.type)
            plan-type-pattern(row.type, subject, no-type, required-match(row.op))
        else
            check-pattern(row.type, subject)
    | .node-type-tuple(row)
        . whole = held-subject(subject)
        . position = 0u32
        . saved-cursor = cursor-binding
        cursor-binding = cursor-binding.binds = false
        for field in tree.children[row.field-types]
            . part = if whole != no-type then field-of(whole, position) else no-type
            check-pattern(field, part)
            position += 1
        cursor-binding = saved-cursor
    | .node-type-wildcard
        =
    | .node-type-identifier
        plan-type-pattern(pattern, subject, no-type, .similar)
    | .node-identifier
        . slot = declaring-slot(pattern)
        if slot && subject != no-type
            frame.assign(slot, subject)
            if cursor-binding.binds
                row-cursors += RowCursor(slot, cursor-binding.capture)
    | .node-type-remainder(row)
        check-pattern(row.name, subject)
    | .node-type-property(row)
        if subject != no-type && subject != invalid-type
            . read = read-property(pattern, pattern, subject, row.name).type
            if read != invalid-type
                facts.set-node-type(instance, pattern, read)
            . slot = declaring-slot(pattern)
            if slot
                frame.assign(slot, read)
    | .node-type-case(row)
        . case-type = subject
        if row.type != 0
            case-type = types.evaluate-type(module, tree, row.type, frame.env)
        . given = subject
        if given != no-type && given != invalid-type && types.is-optional(given)
            given = types.optional-inner(given)
        if given != no-type && given != invalid-type && types.intrinsic-of(given) == .union
            if row.type == 0 || case-type == given
                note-case(pattern, given, row.name)
            else if names-case(given, row.name)
                decline(pattern)
        else if given != no-type && given != invalid-type && (row.type == 0 || case-type == given)
            . given-kind = types.intrinsic-of(given)
            if given-kind == .table-row || given-kind == .immutable-table-row
                note-case(pattern, row-struct-of(given), row.name)
            else if row.type == 0 && names-nothing-case(pattern, row.name, given)
                missing-case(pattern, row.name, given)
                =
        . payload = case-payload(if row.type == 0 then given else case-type, row.name)
        . refined = no-type
        . known = given != no-type && given != invalid-type
        if row.type == 0 && known && !names-case(given, row.name)
            refined = refined-payload(given, row.name)
        if refined == invalid-type && row.value != 0
            decline(pattern)
        if refined != no-type
            facts.set-plan(instance, pattern, .plan-refined-case)
            payload = if refined-holds then refined else no-type
                .. refined-holds = refined != types.void-type && refined != invalid-type
        . case-kind = if case-type != no-type then case-intrinsic else IntrinsicKind.none
            .. case-intrinsic = types.intrinsic-of(case-type)
        . is-row = case-kind == .table-row || case-kind == .immutable-table-row
        . planned = facts.plan-of(instance, pattern)
        if known && !is-row && planned != .plan-case && refined == no-type
            facts.set-plan(instance, pattern, .plan-never)
        . saved-cursor = cursor-binding
        cursor-binding = cursor-binding.binds = is-row
        if is-row
            . validated = immutable-row || (matching.rows && case-type == matching.subject)
                .. immutable-row = case-kind == .immutable-table-row
            cursor-binding = cursor-binding.capture = RowCapture
                - case-type
                - case-number(row-struct-of(case-type), row.name)
                - validated
        check-case-value(row.value, payload)
        cursor-binding = saved-cursor
    ??
        instances.mark-may-panic(instance)
        decline(pattern)

────────────────────
_ name-read SyntaxId
    - pattern SyntaxId

` The pattern that reads a name from its subject in the pattern of an arm, or none. Where a
` match has several arms the reference asks of each whether it could match, and of such a
` pattern it has no answer: it looks for a type of that name.
|? pattern == 0
    0
??
    match tree.nodes[pattern]
        | .node-type-property
            pattern
        | .node-type-and(row)
            if name-read(row.left) != 0 then name-read(row.left) else name-read(row.right)
        | .node-type-capture(row)
            name-read(row.type)
        | .node-type-match(row)
            name-read(row.type)
        ??
            0

────────────────────
_ do check-predicate
    - pattern SyntaxId
    - expr SyntaxId
    - subject TypeId

` A pattern that is a condition. While the condition is typed, `it` is what the pattern is
` given: the pattern's own `it`, or the one of the arm it is written in, which holds what it
` did again after. The condition is tested as any other is.
. slot = arm-slot(pattern, .slot-it)
. is-shared = slot == no-slot && arm-typing.it != no-slot
if is-shared
    slot = arm-typing.it
else if slot == no-slot
    slot = it-read(expr)
    is-shared = slot != no-slot
. is-given = slot != no-slot && subject != no-type && subject != invalid-type
. held = if is-given && is-shared then frame.slot-type(slot) else no-type
if is-given
    frame.assign(slot, subject)
note-truthiness(expr, expr, infer(expr))
if held != no-type && held != invalid-type && held != subject
    frame.assign(slot, held)

────────────────────
_ do check-alternative
    - pattern SyntaxId
    - subject TypeId

if tree.nodes[pattern] is not .node-type-or && !pattern-possible(pattern, subject)
    facts.set-plan(instance, pattern, .plan-never)
    =
check-pattern(pattern, subject)

────────────────────
_ do alternative-slots
    - pattern SyntaxId
    - slots [SlotId]

` The locals an alternative of a pattern binds, each once.
for id in tree.subtree-start(pattern) .. pattern
    . resolution = bindings.resolution-of(frame.binding, id)
    . declares = (resolution.flags /and/ ResolutionFlag.resolution-declares) != 0
    if resolution.kind == .resolve-slot && declares && slots.find(resolution.slot) == null
        slots += resolution.slot

────────────────────
_ do check-alternative-names
    - left SyntaxId
    - left-slots [SlotId]
    - left-types [TypeId]
    - right SyntaxId
    - right-slots [SlotId]

` The alternatives of `| a | b` bind the same names, each of one type, since the arm reads the
` names whichever alternative matched.
for position in 0 .. < left-slots.length
    . slot = left-slots[position]
    . name = bindings.slots[slot].name.text
    if right-slots.find(slot) == null
        frame.diagnose(right, .stated, program.store-atom("\"$name\" is bound by the alternative before this one but not by this one; bind it in each alternative"))
        =
    . before = left-types[position]
    . after = frame.known(slot)
    if known-type(before) && known-type(after) && before != after
        . text = "\"$name\" is ${type-source(types, before)} in one alternative and ${type-source(types, after)} in another; bind it to one type in each"
        frame.diagnose(right, .stated, program.store-atom(text))
        =
for slot in right-slots
    if left-slots.find(slot) == null
        . name = bindings.slots[slot].name.text
        frame.diagnose(left, .stated, program.store-atom("\"$name\" is bound by the alternative after this one but not by this one; bind it in each alternative"))
        =

────────────────────
_ do it-read SlotId
    - expr SyntaxId

` The slot a condition reads `it` through where its pattern declares none and no arm has
` one: that of an earlier pattern of the same block.
for id in tree.subtree-start(expr) .. expr
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, id)
            if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-it
                = resolution.slot
= no-slot

────────────────────
_ do plan-equality
    - pattern SyntaxId
    - subject TypeId
    - expr SyntaxId
    - value TypeId

` Plans an equality pattern as `==` of its subject and its value, at the pattern's node,
` which stands for the subject as the left operand and has the type of the answer. A subject
` compared with `null` is asked whether it holds nothing. Values listed for a subject that is
` no tuple are an error that names how an arm takes any of several.
if subject == no-type || subject == invalid-type || value == no-type || value == invalid-type
    =
if tree.nodes[expr] is .node-tuple-syntax && !intrinsic-is-tuple-like(types.intrinsic-of(subject))
    . advice = "to take any of several, write a condition, as in '|? it == .a || it == .b'"
    frame.diagnose(expr, .stated, program.store-atom("An arm written '|=' compares the subject with one value, and this lists several; $advice"))
    =
if narrowing.is-null-syntax(expr) && types.is-optional(subject)
    facts.set-plan(instance, pattern, .plan-absent)
    facts.set-node-type(instance, pattern, types.bool-type)
    =
. answer = infer-binary-values(pattern, .equals-op, pattern, subject, expr, value)
if answer != invalid-type && answer != no-type
    facts.set-node-type(instance, pattern, answer)

────────────────────
_ do plan-capture
    - pattern SyntaxId
    - subject TypeId
    - captured TypeId

` A name declared with a type in a pattern holds what the type passes. An optional given to
` one declared an optional is captured whole where it converts, with no test.
if subject == no-type || subject == invalid-type || captured == no-type || captured == invalid-type
    =
if types.is-optional(subject) && types.is-optional(captured)
    . whole = relations.compare(subject, captured, false, false, null, module)
    if relations.holds-as(whole, .similar)
        conversions.record-pattern(pattern, whole, U32.max)
        =
plan-type-pattern(pattern, subject, captured, .similar)

────────────────────
+ do plan-type-pattern
    - pattern SyntaxId
    - subject TypeId
    - named TypeId
    - kind Specificity

` Records at a type named as a pattern what it does to the subject it is given, as the
` reference matches it: an optional as what it holds, and a union whole where it converts
` whole, else by each of its cases that converts. `named` is the type where the pattern's
` own syntax leaves some of it to the subject.
if subject == no-type || subject == invalid-type
    =
. target = named
if target == no-type
    target = types.evaluate-type(module, tree, pattern, frame.env)
    if target == invalid-type
        report-missing-type(pattern, frame.env)
if target == invalid-type || target == no-type || refuses-facet-test(pattern, target)
    =
if types.completions[target].has-variables
    target = complete-named(target, subject, kind)
    if target == no-type
