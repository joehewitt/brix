` Whether a pattern could match a subject of this type at all. The reference compiles no arm
` whose pattern cannot, and a match none of whose arms can is an error. `inside` says the
` pattern is a field of one that takes a tuple apart.
if pattern == 0 || subject == no-type || subject == invalid-type
    = true
do match? tree.nodes[pattern]
    | .node-type-identifier
        = type-possible(pattern, subject, .similar)
    | .node-type-arguments
        = type-possible(pattern, subject, .similar)
    | .node-type-match(row)
        = type-possible(row.type, subject, required-match(row.op))
    | .node-type-or(row)
        = pattern-possible(row.left, subject, inside) || pattern-possible(row.right, subject, inside)
    | .node-type-and(row)
        if !pattern-possible(row.left, subject, inside)
            = false
        . passed = if reads-name(row.left) then passed-type(row.left, subject) else pattern-type(row.left, subject)
        = pattern-possible(row.right, passed, inside)
    | .node-type-capture(row)
        = pattern-possible(row.type, subject, inside)
    | .node-type-case(row)
        = case-possible(pattern, row.type, row.name, subject, inside)
    | .node-type-tuple(row)
        = tuple-possible(row.field-types, subject)
    | .node-type-property(row)
        = answers(subject, row.name)
    | .node-type-list(row)
        if is-collection-type(tree, pattern)
            = type-possible(pattern, subject, .similar)
        . held = sequence-case(subject)
        if held == no-type
            = false
        if held == invalid-type
            = true
        . item = iterable-item(held, types.indexable-decl)
        for element in tree.children[row.patterns]
            do match tree.nodes[element]
                | .node-type-remainder
                    continue
                ??
                    if !pattern-possible(element, item)
                        = false
    | .node-type-map(row)
        if is-collection-type(tree, pattern)
            = type-possible(pattern, subject, .similar)
        . held = structured-case(subject, types.map-decl)
        . map = types.ancestor-of(held, types.map-decl)
        if map == no-type
            = false
        for element in tree.children[row.patterns]
            do match? tree.nodes[element]
                | .node-type-map-item(item)
                    if !pattern-possible(item.value, class-arg(types, map, 1))
                        = false
= true

────────────────────
_ do tuple-possible Bool
    - fields RowRange'SyntaxId
    - subject TypeId

` Whether a pattern that takes a tuple apart could match a subject: one that could be a
` tuple, and where it is one of as many fields, each field's pattern could match its field.
if !destructures-some(subject)
    = false
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) == .union || !destructures(held, fields.count)
    = true
. position = 0u32
for field in tree.children[fields]
    if !pattern-possible(field, field-of(held, position), true)
        = false
    position += 1
= true

────────────────────
+ do missing-case
    - pattern SyntaxId
    - name Atom
    - subject TypeId

` Reports a case a pattern names that no type has, where it tests a value of a union, which is
` named with its cases, or of a type with none.
if subject == no-type || subject == invalid-type
    frame.diagnose(pattern, .stated, program.store-atom("Type not found"))
    =
. shown = type-short-name(types, subject)
. message = if types.intrinsic-of(subject) == .union then "Case \".${name.text}\" not found in $shown" else "Case \".${name.text}\" not found: $shown has no cases"
frame.diagnose(pattern, .stated, program.store-atom(message))

────────────────────
_ do names-nothing-case Bool
    - pattern SyntaxId
    - name Atom
    - subject TypeId

` Whether a pattern names a case by its name alone that neither a value of the subject's enum
` nor any type the pattern could mean has.
if names-enum-value(pattern, 0, name, subject)
    = false
= anonymous-symbol(pattern, name) == no-type && symbol-class(types, module, name) == invalid-type

────────────────────
_ do case-possible Bool
    - pattern SyntaxId
    - type SyntaxId
    - name Atom
    - subject TypeId
    - inside Bool

` Whether a pattern that names a case could match a subject: one that is a union with a case
` of that name, an optional of one, or a row. The reference compiles the arm of no other,
` and where the pattern names no type and no type it could mean has a case or a value of
` the name, it reports that. As a field of a tuple the pattern keeps its arm also where the
` type it means is the field's, or what a case of the field holds: it matches nothing there.
. given = if types.is-optional(subject) then types.optional-inner(subject) else subject
. kind = types.intrinsic-of(given)
if kind == .table-row || kind == .immutable-table-row || names-case(given, name)
    = true
if kind == .union && refined-payload(given, name) != no-type
    = true
if names-enum-value(pattern, type, name, given)
    = true
. meant = no-type
if type != 0
    meant = types.evaluate-type(module, tree, type, frame.env)
else
    meant = anonymous-symbol(pattern, name)
    if meant == no-type
        meant = symbol-class(types, module, name)
        if meant == invalid-type
            missing-case(pattern, name, given)
if meant == no-type || meant == invalid-type || !inside
    = false
if meant == given
    = true
if kind == .union
    for fact in types.cases-of(given)
        if fact.type == meant || names-case(fact.type, name)
            = true
= false

────────────────────
+ do refined-payload TypeId
    - union TypeId
    - name Atom

` What a case holds that a refinement of the machine of a property of a class adds, where the
` machine's union is a type and the case is of a name, as the refinement's own union holds it:
` `Void` for nothing, or its values. Refinements typed so far are found, and else those of the property the
` subject reads for the class of the object it reads it from (`case-owner-of`), or of the
` machine's property for the class the function, or one it is written in, is typed for
` (`enclosing-self`), as the reference finds them, and
` the refinement being typed as it is written (`writing-payload`). No type where none adds the
` case.
. root = refined-root(union)
. found = if root then refining-payload(root, name) else no-type
if found != no-type
    = found
. owner = case-owner-of(matching.case)
. receiver = if owner != no-type then owner else enclosing-self()
. property = decl-property-name(root.module, root.decl) if root
if owner != no-type
    property = tree.subject-property(matching.case)
. classed = receiver != no-type && types.intrinsic-of(receiver) == .class
. place = property-named(receiver, property) if property && classed
if !place
    = no-type
. ref = class-ref(types, types.properties[place].owner)
. declared = class-property(ref, property!)
if declared == 0
    = no-type
. unit = instances.intern-initializer(ref.module, declared, holding-type(receiver, ref))
if instances.rows[unit].state == .instance-in-progress
    = writing-payload(receiver, property!, name)
demand-body(unit)
. typed = refined-root(union)
= if typed then refining-payload(typed, name) else no-type

────────────────────
+ do enclosing-self TypeId

` The class the function is typed for, or the nearest function it is written in is, or none.
. current = instance
while current != no-instance
    if instances.rows[current].self-type != no-type
        = instances.rows[current].self-type
    current = instances.rows[current].enclosing
= no-type

────────────────────
_ do writing-payload TypeId
    - receiver TypeId
    - property Atom
    - name Atom

` What a case of a name holds that a machine of a property of a name writes, of a class a
` receiver is or derives from, while those machines are typed for it: `Void` for a case written
` with no values, and invalid where what it holds is not typed yet; no type where none writes
` such a case.
. current = receiver
while current != no-type
    . level = class-ref(types, current)
    current = types.base-of(current) ?? no-type
    . declared = if level.module != 0 || level.decl != 0 then class-property(level, property) else 0
    if declared == 0
        continue
    . owner-tree = program.modules[level.module].tree
    do match? program.modules[level.module].decls[declared]
        | .decl-property(found)
            . machine = owner-tree.declared-machine(found.value)
            . items = if machine != 0 then machine-states else List'SyntaxId()
                .. machine-states = owner-tree.state-items(owner-tree.state-body(machine))
            . node = if machine != 0 then owner-tree.find-case(items, name) else 0
            if node != 0
                = if targetless then types.void-type else invalid-type
                    .. targetless = owner-tree.state-targets(node).count == 0
= no-type

────────────────────
_ do case-owner-of TypeId
    - subject SyntaxId

` The class of the object a subject reads a property from, as the reference finds the object a
` state machine's union is read from: the type of the object written before the property's
` name, or none.
if subject == 0
    = no-type
do match? tree.nodes[subject]
    | .node-get-expression(row)
        . held = facts.node-type(instance, row.object)
        . inner = if types.is-optional(held) then types.optional-inner(held) else held
        if inner != no-type && inner != invalid-type && types.intrinsic-of(inner) == .class
            = inner
= no-type

────────────────────
_ do refined-root MachineFact?
    - union TypeId

` The machine of a property of a class whose union a type is, and that refines none.
for machine in facts.machines
    . member = machine.store == .store-member && machine.outer == 0
    if machine.union == union && member && machine.refined == no-instance
        = machine
= null

────────────────────
_ do refining-payload TypeId
    - root MachineFact
    - name Atom

` What a case of a name holds that a refinement typed so far of a machine adds, `Void` where it
` holds nothing, or no type.
for machine in facts.machines
    if machine.refined == no-instance || machine.outer != 0 || !names-case(machine.union, name)
        continue
    . above = facts.root-machine(machine)
    if above.module == root.module && above.syntax == root.syntax
        . held = case-payload(machine.union, name)
        = if held != no-type then held else types.void-type
= no-type

────────────────────
+ do decl-property-name Atom?
    - owner ModuleId
    - property DeclId

` The name of a property a module declares.
do match? program.modules[owner].decls[property]
    | .decl-property(row)
        = row.name
= null

────────────────────
+ do names-enum-value Bool
    - pattern SyntaxId
    - type SyntaxId
    - name Atom
    - subject TypeId

` Whether a pattern that names a case names a value of a whole number type instead, written
` alone or with that type. It is an error the reference reports at the pattern, wherever the
` pattern is, so the arm is kept for it.
if !types.completions[subject].has-enums || !is-integer-kind(types.intrinsic-of(subject))
    = false
if !enum-case-decl(types, program, subject, name)
    = false
if type != 0 && types.evaluate-type(module, tree, type, frame.env) != subject
    = false
. shown = type-short-name(types, subject)
. member = "${if type != 0 then shown else ""}.${name.text}"
. message = "$shown.${name.text} is an enum value, not a union case; match it with '|= $member'"
frame.diagnose(pattern, .stated, program.store-atom(message))
= true

────────────────────
+ do names-case Bool
    - type TypeId
    - name Atom

` Whether a type is a union with a case of a name.
if type == no-type || type == invalid-type || types.intrinsic-of(type) != .union
    = false
for fact in types.cases-of(type)
    if fact.name && fact.name! == name
        = true
= false

────────────────────
_ type-possible Bool
    - pattern SyntaxId
    - subject TypeId
    - kind Specificity

|? target == invalid-type
    true
??
    could-match(subject, target, kind)

.. target = types.evaluate-type(module, tree, pattern, frame.env)

────────────────────
_ do destructures-some Bool
    - subject TypeId

` Whether a value of the subject's type could be a tuple a pattern takes apart.
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = tuple-arity(held) != U32.max
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type && tuple-arity(fact.type) != U32.max
        = true
= false

────────────────────
+ do pattern-value TypeId
    - pattern SyntaxId
    - subject TypeId

` What an arm with no body gives: the subject as its pattern matched it. Of patterns written
` one after another it is what the last type named among them made of it. A case named with
` nothing written for what it holds gives the union, what an optional holds.
do match? tree.nodes[pattern]
    | .node-type-and(row)
        if tree.names-type(row.right) || tree.matches-named(row.right)
            = pattern-type(row.right, subject)
        = pattern-value(row.left, subject)
    | .node-type-match(row)
        = pattern-value(row.type, subject)
    | .node-type-capture(row)
        = if row.type != 0 then pattern-value(row.type, subject) else subject
    | .node-type-case(row)
        if row.value == 0
            = if subject != no-type && types.is-optional(subject) then inner-subject else subject
                .. inner-subject = types.optional-inner(subject)
        . owner = subject
        if row.type != 0
            owner = types.evaluate-type(module, tree, row.type, frame.env)
        . payload = case-payload(owner, row.name)
        = if payload != no-type then payload else subject
    | .node-type-predicate
        = subject
. optional = subject != no-type && types.is-optional(subject)
= pattern-type(pattern, if optional then types.optional-inner(subject) else subject)

────────────────────
_ do completed-capture TypeId
    - annotation TypeId
    - subject TypeId

` A capture that names a generic type without its parameters holds that type as the subject
` gives it: the subject itself, the value an optional holds, or the case of a union that is of
` the named type.
if subject == no-type || subject == invalid-type || !types.completions[annotation].has-variables
    = annotation
. relation = relations.compare(subject, annotation, false, false, null, module)
if instance-relation(relation, .similar) && !types.completions[relation.to].has-variables
    = relation.to
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if held != subject
    = completed-capture(annotation, held)
if types.intrinsic-of(held) == .union
    for fact in types.cases-of(held)
        if fact.type != no-type && fact.type != invalid-type
            . given = relations.compare(fact.type, annotation, false, false, null, module)
            if instance-relation(given, .similar) && !types.completions[given.to].has-variables
                = given.to
= annotation

────────────────────
_ do pattern-type TypeId
    - pattern SyntaxId
    - subject TypeId

` The type a pattern narrows its subject to: a type named in the pattern, as the subject gives
` it where it names a generic type without its parameters (`completed-capture`), also one of a
` list or a map written in brackets, or by a name that captures what it matches, what an optional
` holds for fields in parentheses, else the subject. Patterns written one after another narrow
` in turn.
do match? tree.nodes[pattern]
    | .node-type-tuple
        = held-subject(subject)
    | .node-type-identifier
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if named != invalid-type then completed-capture(named, subject) else subject
    | .node-type-arguments
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if named != invalid-type then completed-capture(named, subject) else subject
    | .node-type-list
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if named != invalid-type then named else subject
    | .node-type-map
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if named != invalid-type then named else subject
    | .node-type-match(row)
        = pattern-type(row.type, subject)
    | .node-type-capture(row)
        = if row.type != 0 then pattern-type(row.type, subject) else subject
    | .node-type-and(row)
        = pattern-type(row.right, pattern-type(row.left, subject))
= subject

────────────────────
_ do sequence-case TypeId
    - subject TypeId

` The type whose items a list pattern reads, as the reference finds it: of an optional what it
` holds, and of a union the case that has items to give. A text has none, nor has a type that
` is no `Indexable`: no type then, and the pattern can not match. Where more than one case
` of a union has items the reference matches each, which has no shape here: the type that
` is none.
if subject == no-type || subject == invalid-type
    = subject
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = if has-items(held) then held else no-type
. found = no-type
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type && has-items(fact.type)
        if found != no-type
            = invalid-type
        found = fact.type
= found

────────────────────
_ do structured-case TypeId
    - subject TypeId
    - wanted DeclRef

` A map pattern matches the value an optional holds, and of a union the case that is a map.
if subject == no-type || subject == invalid-type
    = subject
. held = if types.is-optional(subject) then types.optional-inner(subject) else subject
if types.intrinsic-of(held) != .union
    = held
for fact in types.cases-of(held)
    if fact.type != no-type && fact.type != invalid-type
        if types.ancestor-of(fact.type, wanted) != no-type
            = fact.type
= held

────────────────────
+ do check-text-pattern Bool
    - pattern SyntaxId

` A pattern of texts matched against a `String`, as the reference lowers one: the length is
` read and tested, then `starts-with` the texts before the rest and `ends-with` those after,
` each a call recorded at the pattern. A name given a text is bound to that text, and a rest
` with a name to what lies between, each a `String`. One with no rest or with several, or with
` a text that is not ASCII, whose length the reference counts in units of its own, is declined.
. parts [SyntaxId]
tree.text-parts(pattern, parts)
if parts.length == 0
    = false
. rest SyntaxId = 0
. rests = 0
. leads = false
. trails = false
. plain = true
for part in parts
    . text = tree.text-of(part)
    if text
        if text.size != text.length
            plain = false
        if text.length != 0
            leads = leads || rests == 0
            trails = trails || rests != 0
    else
        rests += 1
        rest = part
if rests != 1 || !plain
    decline(pattern)
    = true
facts.set-plan(instance, pattern, .plan-text-pattern)
calls.demand-getter(types.string-type, types.length-atom!, pattern)
if leads
    text-call(pattern, "starts-with")
if trails
    text-call(pattern, "ends-with")
for part in parts
    if tree.nodes[part] is .node-type-capture
        . slot = declaring-slot(part)
        if slot
            frame.assign(slot, types.string-type)
do match? tree.nodes[rest]
    | .node-type-remainder(row)
        if row.name != 0
            . range = range-construction(rest, .range-to-op, types.index-type, 0, 0, 0)
            check-pattern
                - row.name
                - calls.operator-call(rest, types.string-type, types.index-op-atom!, 0, range)
= true

────────────────────
_ do text-call
    - pattern SyntaxId
    - name String

` Records at a pattern of texts a call of a method of `String` given one text, which the pattern
` makes of the texts it writes.
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false, null))
scratch.types.push(types.string-type)
scratch.syntax.push(pattern)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.method-call(pattern, pattern, types.string-type, program.store-atom(name), arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do check-list-pattern
    - pattern SyntaxId
    - patterns RowRange'SyntaxId
    - whole TypeId

` A list pattern reads the length of its subject, each item by its index and a rest that has
` a name by a range, as the reference lowers it: the items take the type of an item and the
` rest what the range gives. The subject is what an optional holds and the case of a union
` that is a list, by the conversions recorded at the pattern as for a type named. The length
` is read by the getter recorded at the pattern, or is the field of an array a constant fact
` names. Of a table, a span of one or a view of a field's column, which the constant says,
` TypeScript answers the length and the rows or the items itself, which may raise the panics of
` a table, and makes a rest with a name the span or the view a range gives. The read of an item is the
` first call at its pattern; a rest with a name has the construction of its range and then
` the read.
. subject = sequence-case(whole)
if subject == invalid-type && whole != invalid-type
    decline(pattern)
if subject == no-type || subject == invalid-type
    for element in tree.children[patterns]
        check-pattern(element, no-type)
    =
if subject != whole
    plan-leaves(pattern, whole, subject, .similar, U32.max)
. viewed = is-column-receiver(types.intrinsic-of(subject)) || field-view
    .. field-view = is-field-view(types.intrinsic-of(subject))
if is-array-field(subject, types.length-atom!)
    facts.set-constant(instance, pattern, ConstantFact(1, 0, null, false), .plan-list-pattern)
else if viewed
    facts.set-constant(instance, pattern, ConstantFact(2, 0, null, false), .plan-list-pattern)
    instances.mark-may-panic(instance)
else
    facts.set-plan(instance, pattern, .plan-list-pattern)
    calls.demand-getter(subject, types.length-atom!, pattern)
for element in tree.children[patterns]
    do match tree.nodes[element]
        | .node-type-remainder(row)
            if row.name != 0
                . range = range-construction(element, .range-to-op, types.index-type, 0, 0, 0)
                . rest = calls.operator-call(element, subject, types.index-op-atom!, 0, range)
                if rest != invalid-type && viewed
                    if !plan-table-index(element, 0, subject, 0, range, rest)
                        rest = invalid-type
                check-pattern(row.name, rest)
        ??
            . item = calls.index-item(subject, element)
            note-item-read(element)
            check-pattern(element, item)

────────────────────
_ do note-item-read
    - element SyntaxId

` Marks the call just recorded at the pattern written for an item as the read that gives the
` pattern what it is matched against, apart from the calls the pattern makes itself.
. fact = facts.latest-call(instance, element)
if fact != no-fact && facts.calls[fact].form == .call-operator
    facts.calls[fact].form = .call-item-read

────────────────────
_ do check-map-pattern
    - pattern SyntaxId
    - patterns RowRange'SyntaxId
    - whole TypeId

` A map pattern reads each key's value through the index operator, which gives nothing for a
` key the map lacks; a rest keeps the map. The subject is what an optional holds and the
` case of a union that is a map, by the conversions recorded at the pattern as for a type
` named. A rest with a name is the map without what matched, by the calls recorded there.
. subject = structured-case(whole, types.map-decl)
. mapped = typed-subject && types.ancestor-of(subject, types.map-decl) != no-type
    .. typed-subject = subject != no-type && subject != invalid-type
if mapped
    if subject != whole
        plan-leaves(pattern, whole, subject, .similar, U32.max)
    facts.set-plan(instance, pattern, .plan-map-pattern)
for element in tree.children[patterns]
    do match tree.nodes[element]
        | .node-type-map-item(row)
            . key = infer(tree.key-expr(row.key))
            . known = mapped && key != invalid-type
            . value = no-type
            if known
                value = calls.operator-call(element, subject, types.index-op-atom!, row.key, key)
                note-item-read(element)
            . held = no-type
            if value != no-type && value != invalid-type
                held = types.optional-inner(value)
            check-pattern(row.value, held)
        | .node-type-remainder(row)
            if row.name != 0 && mapped
                plan-map-rest(element, subject)
            check-pattern(row.name, subject)
        ??
            check-pattern(element, no-type)

────────────────────
_ do plan-map-rest
    - site SyntaxId
    - subject TypeId

` What a rest of a map pattern with a name calls, as the reference lowers it: an empty map of
` the subject's type is made, each key matched is stored there with what it holds, and the
` rest is the subject less that map.
. map = types.ancestor-of(subject, types.map-decl)
if map == no-type
    =
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
calls.construction-on
    - site
    - subject
    - arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.index-assign-call(site, subject, 0, class-arg(types, map, 0), 0, class-arg(types, map, 1))
calls.operator-call(site, subject, program.store-atom("-"), 0, subject)

────────────────────
_ do check-case-value
    - value SyntaxId
    - payload TypeId

if value != 0 && payload != no-type
    do match? tree.nodes[value]
        | .node-type-tuple(row)
            . payload-kind = types.intrinsic-of(payload)
            if row.field-types.count == 1 && payload-kind != .tuple
                check-pattern(tree.children[row.field-types][0], payload)
                =
check-pattern(value, payload)

────────────────────
+ do case-payload TypeId
    - about TypeId
    - name Atom

if about == no-type || about == invalid-type
    = no-type
. subject = about
. subject-kind = types.intrinsic-of(subject)
if subject-kind == .table-row || subject-kind == .immutable-table-row
    subject = row-struct-of(subject)
    if subject == no-type
        = no-type
. completion = types.completion-of(subject)
if completion.intrinsic != .union
    = no-type
for fact in types.cases[completion.cases]
    if fact.name && fact.name! == name && !fact.is-default
        = fact.type
= no-type

────────────────────
_ do case-number U32
    - union TypeId
    - name Atom

` The number of the case of a union a name names.
. position U32
for fact in types.cases-of(union)
    if fact.name && fact.name! == name
        = position
    position += 1
= U32.max

────────────────────
_ do reads-row Bool
    - syntax SyntaxId

` Whether a subject is the row `t[i]` reads of a table, a span or a selection, which TypeScript
` makes a cursor of whose storage it checked there, or a name a loop gives such a row by.
do match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(frame.binding, syntax)
        = resolution.kind == .resolve-slot && checked-rows.find(resolution.slot) != null
    | .node-index-expression
        . constant = facts.constant-of(instance, syntax)
        if table-planned && constant != no-fact && !optional-chained(syntax)
            . op = ((facts.constants[constant].bits /and/ 4294967295) as U32) as TableOp
            = op == TableOp.table-row || op == TableOp.selection-row || op == TableOp.proven-row
        .. table-planned = facts.plan-of(instance, syntax) == .plan-table
= false
