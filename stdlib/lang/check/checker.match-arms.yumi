do match? tree.nodes[pattern]
    | .node-type-tuple
        = held-subject(subject)
    | .node-type-case(row)
        . given = if types.is-optional(subject) then types.optional-inner(subject) else subject
        if row.value == 0
            = given
        . owner = given
        if row.type != 0
            owner = types.evaluate-type(module, tree, row.type, frame.env)
        . payload = case-payload(owner, row.name)
        if payload == no-type || payload == invalid-type
            = subject
        . part = row.value
        do match? tree.nodes[row.value]
            | .node-type-tuple(fields)
                if fields.field-types.count == 1 && types.intrinsic-of(payload) != .tuple
                    part = tree.children[fields.field-types][0]
