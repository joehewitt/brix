    | .node-type-arguments
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if concrete-arguments then named else subject
            .. concrete-arguments = named != invalid-type && !types.completions[named].has-variables
    | .node-type-optional
        . named = types.evaluate-type(module, tree, pattern, frame.env)
        = if concrete-optional then named else subject
            .. concrete-optional = named != invalid-type && !types.completions[named].has-variables
    | .node-type-list
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if concrete-list then named else subject
                .. concrete-list = named != invalid-type && !types.completions[named].has-variables
    | .node-type-map
        if is-collection-type(tree, pattern)
            . named = types.evaluate-type(module, tree, pattern, frame.env)
            = if concrete-map then named else subject
                .. concrete-map = named != invalid-type && !types.completions[named].has-variables
    | .node-type-match(row)
        = passed-type(row.type, subject)
    | .node-type-and(row)
        = passed-type(row.right, passed-type(row.left, subject))
    | .node-type-property
        . read = facts.node-type(instance, pattern)
        = if read != no-type then read else subject
    | .node-type-panic(row)
        = passed-type(row.pattern, subject)
    | .node-type-capture(row)
        if row.type == 0
            = subject
        . slot = declaring-slot(pattern)
        if slot
            . captured = frame.slot-type(slot)
            if captured != no-type && captured != invalid-type
