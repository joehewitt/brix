(import ./idmap)
(import ./types)
(import /core/arena)
(import /core/scratch)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)

(type + CachedHit (is Struct)
  ; A hit kept by a ranking cache: its runs are places and counts in the cache's stacks.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + receiver TypeId)
  (prop + level TypeId)
  (prop + is-extension Bool)
  (prop + params U32)
  (prop + param-count U32)
  (prop + args U32)
  (prop + arg-count U32)
  (prop + fills U32)
  (prop + fill-count U32)
  (prop + relations U32)
  (prop + relation-count U32)
  (prop + tail-fills U32)
  (prop + tail-fill-count U32)
  (prop + tail-relations U32)
  (prop + tail-relation-count U32)
)

(type + CachedRanking (is Struct)
  ; What ranking a call chose: the places of its best and partial hits among the cache's hits,
  ; none being `U32.max`, and what it found ambiguous or missing.
  (blank)
  (prop + best U32)
  (prop + partial U32)
  (prop + ambiguous-constructor Bool)
  (prop + ambiguous-static Bool)
  (prop + ambiguous-extension Bool)
  (prop + conflicting Bool)
  (prop + missing-module ModuleId)
  (prop + missing-site SyntaxId)
)

(type + RankingCache
  ; Calls already ranked, each by what was asked and what the call gives, so that ranking the
  ; same call again reads back what it chose. Rows are only added, so a span read from the stacks
  ; lasts as long as the cache.
  (blank)
  (prop + rankings (of Table CachedRanking))
  (prop + hits (of Table CachedHit))
  (prop + types (of Scratch TypeId))
  (prop + words (of Scratch U32))
  (prop + relations (of Scratch Relation))
  (prop _ arena Arena)
  (prop _ keys IdMap)
  (prop _ key-scratch (of Array U32 ArenaBacking))
  (prop _ key-count Size)
  (fn-do + This _
    (param arena Arena)
    (lazy rankings (call (of Table CachedRanking) arena 64))
    (lazy hits (call (of Table CachedHit) arena 64))
    (lazy types (call (of Scratch TypeId) arena))
    (lazy words (call (of Scratch U32) arena))
    (lazy relations (call (of Scratch Relation) arena))
    (lazy key-scratch (call (of Array U32) arena 32))
  )
  (fn-do + release _
    (call (. keys release))
  )
  (fn-do + open-key _
    (= key-count 0)
  )
  (fn-do + add-key _
    (param word U32)
    (if (== key-count (. key-scratch length))
      (= key-scratch (call (. key-scratch resize) (* (. key-scratch length) 2) arena))
    )
    (= ([] key-scratch key-count) word)
    (+= key-count 1)
  )
  (fn-expr + found (? Index) :get
    (call (. keys find) (. key-scratch data) key-count)
  )
  (fn-do + keep _
    (param row CachedRanking)
    (call (. keys store) (. key-scratch data) key-count)
    (if (. keys last-inserted)
      (call (. rankings append) row)
    )
  )
)
