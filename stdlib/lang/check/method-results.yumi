./error-sets
./facts
./instances
./session
./signature
./type-store
./type-text
./types
/core/arena
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program

━━━━━━━━━━━━━━━━━━━━
+ MethodProto is Tuple

` The method an implementation stands in for: an interface's requirement or a base class's
` method, with the value and errors its callers expect.

+ label String
+ kind String
+ module ModuleId
+ syntax SyntaxId
+ returns TypeId
+ errors ImmutableArray'TypeId'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
+ do check-method-result
    - session Session
    - impl InstanceId
    - proto MethodProto
    - panics Bool = false

` An implementation must give what the method it stands in for gives: it cannot end on a
` value it does not return where callers expect one, nor raise an error they do not expect.
` Where it `panics`, standing in for an interface's function for a value whose type carries
` errors of its own, an error it raises is a panic and not checked.
. instances = session.instances
. types = session.types
. row = instances.rows[impl]
. signature = instances.signatures[impl]
. owner = session.program.modules[row.module]
. name = ""
. site = 0u32
do match? owner.decls[row.decl]
    | .decl-function(fn)
        site = fn.syntax
        if fn.name
            name = fn.name.text
. expects = proto.returns != no-type && proto.returns != types.void-type
if signature.unreturned != 0 && signature.returns == types.void-type && expects
    . message = "Function $name ends with a value it does not return"
    . atom = session.program.store-atom(message)
    session.facts.record-diagnostic(impl, row.module, signature.unreturned, .stated, atom)
    =
if panics
    =
. accepted = true
. names = ""
for offset in 0 .. < signature.errors.count
    . error = instances.error-type(impl, offset)
    . fits = false
    for expected in proto.errors
        if is-subtype(types, error, expected)
            fits = true
    if !fits
        accepted = false
    if names.length != 0
        names += ", "
    names += type-short-name(types, error)
if accepted
    =
. message = "Function returns error ($names) but ${proto.kind} does not"
. atom = session.program.store-atom(message)
session.facts.record-diagnostic(impl, row.module, site, .stated, atom)
session.facts.relate-diagnostic(session.program.store-atom(proto.label), proto.module, proto.syntax)
