        )
      )
      (let unwrap (call make-relation .relation-unwrap-cast from target target))
      (if (== (. ([] (. types completions) from) intrinsic) .union)
        (= (. unwrap case-index) (call wrap-case from to))
      )
      (if (== (. ([] (. types completions) from) intrinsic) .optional)
        (let inner (call optional-item from))
        (if (!= inner target)
          (let inner-relation (call compare inner target))
          (if (!= (. inner-relation converter-module) (. U32 max))
            (= (. unwrap converter-module) (. inner-relation converter-module))
            (= (. unwrap converter-decl) (. inner-relation converter-decl))
            (= (. unwrap via) inner)
            (else-if (== (. ([] (. types completions) inner) intrinsic) .union)
              (let held (call wrap-case inner target))
              (= (. unwrap case-index) (if-expr (!= held no-case) held (call down-case inner target)))
            )
          )
        )
      )
      (return unwrap)
    )
    (blank)
    (if (!= (. types program facets count) 0)
      (let facet-relation (call relate-facets from to))
      (if facet-relation
        (return facet-relation)
      )
    )
    (blank)
    (if (call in-base-chain types from to)
      (return (call make-relation .relation-up-cast from to to))
    )
    (blank)
    (if (and (call intrinsic-is-class (. ([] (. types completions) from) intrinsic)) (call in-base-chain types to from))
      (return (call make-relation .relation-down-cast from to to))
    )
    (blank)
    (if (and (not for-unify) (== (. ([] (. types completions) from) intrinsic) .union))
      (let held (call down-case from to))
      (if (!= held no-case)
        (let down (call make-relation .relation-down-cast from to to))
        (= (. down case-index) held)
        (return down)
      )
    )
    (blank)
    (if (and (== (. ([] (. types completions) from) intrinsic) .interface) (call has-interface types to from))
      (let kind (. ([] (. types completions) to) intrinsic))
      (if (or (call intrinsic-is-class kind) (call intrinsic-is-tuple-like kind))
        (return (call make-relation .relation-interface-down-cast from to to))
      )
    )
    (blank)
    (if (and (== (. ([] (. types completions) to) intrinsic) .interface) (call has-interface types from to))
      (return (call make-relation .relation-interface-cast from to to))
    )
    (blank)
    (if (== (. ([] (. types completions) to) intrinsic) .or)
      (let plain (call unraised from))
      (let alternative (call best-alternative plain to scope))
      (if (and (!= alternative no-type) (!= plain from))
        (return (call make-relation .relation-same from from from))
      )
      (if (!= alternative no-type)
        (let inner (call compare from alternative false false scope))
        (= (. inner via) alternative)
        (return inner)
      )
    )
    (blank)
    (if (== (. ([] (. types completions) to) intrinsic) .union)
      (let wrapped (call wrap-case to from true))
      (if (!= wrapped no-case)
        (let wrap (call make-relation .relation-wrap-cast from to to))
        (= (. wrap case-index) wrapped)
        (return wrap)
      )
    )
    (blank)
    (if (not (call reads-text-as-number from to))
      (let declared (call declared-relation from to caller))
      (if (or (call relation-legal declared) (!= (. declared reason) .reason-illegal-cast))
        (return declared)
      )
    )
    (blank)
    (if for-unify
      (let common (call common-relation from to caller))
      (if (call relation-legal common)
        (return common)
      )
    )
    (blank)
    (if (and (not for-unify) (call subclass-may-be from to))
      (return (call make-relation .relation-interface-down-cast from to to))
    )
    (blank)
    (if (and (call can-final-cast to from) (not (and for-unify (call tests-truth to from))))
      (return (call make-relation .relation-final-cast from to to))
    )
    (blank)
    (if (and (== (. ([] (. types completions) to) intrinsic) .string) (!= (. ([] (. types completions) from) intrinsic) .atom))
      (return (call make-relation .relation-string-cast from to to))
    )
    (blank)
    (if (. ([] (. types completions) to) has-variables)
      (return (call illegal-relation from to .reason-unresolved))
    )
    (return (call illegal-relation from to .reason-illegal-cast))
  )
  (fn-do + reads-text-as-number Bool
    (param from TypeId)
    (param to TypeId)
    (call (. types complete) from)
    (call (. types complete) to)
    (return
      (scope (and from-text (call intrinsic-is-numeric (. ([] (. types completions) to) intrinsic)))
        (lazy from-text (== (. ([] (. types completions) from) intrinsic) .string))
      )
    )
  )
  (fn-do _ declared-relation Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    (let fromverter (call fromverter-owner to from caller))
    (return-if (call illegal-relation from to (. fromverter collision)) (if (!= (. fromverter collision) .reason-none)))
    (return-if (call converter-relation from to caller) (if (== (. fromverter owner) no-type)))
    (blank)
    (let conversion (call make-relation .relation-fromverter from to to))
    (= (. conversion via) (. fromverter owner))
    (= (. conversion converter-module) (. fromverter module))
    (= (. conversion converter-decl) (. fromverter decl))
    (return conversion)
  )
  (fn-expr _ subclass-may-be Bool
    (param from TypeId)
    (param to TypeId)
    ; Whether an object of a class may be of an interface the class does not declare, where a
    ; class declared below it does: the cast tests the object's class as it runs.
    (and (call class-may-be from to) (call (. types declares-subclass-interface) from to))
  )
  (fn-expr _ class-may-be Bool
    (param from TypeId)
    (param to TypeId)
    (case? (or (not (call intrinsic-is-class (. ([] (. types completions) from) intrinsic))) not-interface)
      false
    )
    (default
      (and (not (. ([] (. types completions) from) has-variables)) (not (. ([] (. types completions) to) has-variables)))
    )
    (where
      (lazy not-interface (!= (. ([] (. types completions) to) intrinsic) .interface))
    )
  )
  (fn-expr + unnamed-case-holds Bool
    (param union TypeId)
    (param type TypeId)
    ; Whether a case of a union that has no name holds a value of a type.
    (!= (call wrap-case union type false true) no-case)
  )
  (fn-do + declared-converter TypeId
    (param from TypeId)
    (param decl DeclRef)
    ; What a converter a type declares itself makes, where that is of a declaration, as TypeScript
    ; reads a type's own converters to find a stream's. None where none is.
    (let converters ([] (. types children) (. (call (. types completion-of) from) converters)))
    (for (in offset (..< 0 (/ (. converters length) converter-words)))
      (let target ([] converters (* offset converter-words)))
      (if (call same-decl (call class-ref types target) decl)
        (return target)
      )
    )
    (return no-type)
  )
  (fn-do + converter-relation Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    ; How a type converts to another by a converter it declares, whatever else relates the two.
    ; Illegal when it declares none, or when two that extensions declare collide.
    (let chosen (call converter-match from to caller))
    (if (!= (. chosen collision) .reason-none)
      (return (call illegal-relation from to (. chosen collision)))
    )
    (if (== (. chosen specificity) no-match)
      (return (call illegal-relation from to .reason-illegal-cast))
    )
    (let converter (call make-relation .relation-converter from to to))
    (= (. converter match) (as (. chosen specificity) Specificity))
    (= (. converter converter-module) (. chosen module))
    (= (. converter converter-decl) (. chosen decl))
    (= (. converter explicit) (not (. chosen implicit)))
    (return converter)
  )
  (fn-do _ common-relation Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    (let base (call (. types base-of) from))
    (if base
      (let shared (call common-base types base to))
      (if (!= shared no-type)
        (let up (call make-relation .relation-common-up-cast from to shared))
        (= (. up via) shared)
        (return up)
      )
    )
    (blank)
    (let interface (call common-interface types from from to))
    (if (!= interface no-type)
      (let shared (call make-relation .relation-common-interface from to interface))
      (= (. shared via) interface)
      (return shared)
    )
    (blank)
    (let mark (. types scratch types mark))
    (call push-converters from caller)
    (let matches 0)
    (let chosen no-type)
    (let chosen-ratio (call no-ratio))
    (let candidates (/ (- (. types scratch types length) mark) converter-words))
    (for (in offset (..< 0 candidates))
      (let target ([] (. types scratch types) (+ mark (* offset converter-words))))
      (if (not (. ([] (. types completions) target) has-variables))
        (let ratio (call lookup-equality types target to))
        (if (not (. ratio is-none))
          (+= matches 1)
          (= chosen target)
          (= chosen-ratio ratio)
        )
      )
    )
    (call (. types scratch types rewind) mark)
    (if (== matches 1)
      (let equality (call make-relation .relation-common-equality from to to))
      (= (. equality via) chosen)
      (= (. equality ratio) chosen-ratio)
      (return equality)
    )
    (blank)
    (let common (call common-converter from to caller))
    (if (!= common no-type)
      (let converter (call make-relation .relation-common-converter from to common))
      (= (. converter via) common)
      (return converter)
    )
    (return (call illegal-relation from to .reason-illegal-cast))
  )
  (fn-do _ common-converter TypeId
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    (let from-mark (. types scratch types mark))
    (call push-converters from caller)
    (let to-mark (. types scratch types mark))
    (call push-converters to caller)
    (let from-count (/ (- to-mark from-mark) converter-words))
    (let to-count (/ (- (. types scratch types length) to-mark) converter-words))
    (let common 0)
    (let chosen no-type)
    (for (in offset (..< 0 from-count))
      (let target ([] (. types scratch types) (+ from-mark (* offset converter-words))))
      (if (not (. ([] (. types completions) target) has-variables))
        (let matching false)
        (for (in other (..< 0 to-count))
          (let candidate ([] (. types scratch types) (+ to-mark (* other converter-words))))
          (if (and (== candidate target) (not (. ([] (. types completions) candidate) has-variables)))
            (+= common 1)
            (= chosen target)
            (= matching true)
          )
        )
        (if (and (not matching) (call can-unify-with-target to target))
          (+= common 1)
          (= chosen target)
        )
      )
    )
    (for (in offset (..< 0 to-count))
      (let target ([] (. types scratch types) (+ to-mark (* offset converter-words))))
      (if (not (. ([] (. types completions) target) has-variables))
        (let matching false)
        (for (in other (..< 0 from-count))
          (let candidate ([] (. types scratch types) (+ from-mark (* other converter-words))))
          (if (and (== candidate target) (not (. ([] (. types completions) candidate) has-variables)))
            (= matching true)
          )
        )
        (if (and (not matching) (call can-unify-with-target from target))
          (+= common 1)
          (= chosen target)
        )
      )
    )
    (call (. types scratch types rewind) from-mark)
    (if (== common 1)
      (return chosen)
    )
    (return no-type)
  )
  (fn-expr _ can-unify-with-target Bool
    (param from TypeId)
    (param to TypeId)
    (and (call relation-legal relation) (< (. relation rank) converter-rank))
    (where
      (lazy relation (call compare from to false true))
    )
  )
  (fn-do + bind-converter Bool
    (param from TypeId)
    (param to TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param caller (? ModuleId))
    (param mark ScratchMark (= 0))
    (let list-mark (. types scratch types mark))
    (call push-converters from caller)
    (let count (/ (- (. types scratch types length) list-mark) converter-words))
    (let target no-type)
    (for (in offset (..< 0 count))
      (let base (+ list-mark (* offset converter-words)))
      (let same-module (== ([] (. types scratch types) (+ base 1)) module))
      (if (and same-module (== ([] (. types scratch types) (+ base 2)) decl))
        (= target ([] (. types scratch types) base))
      )
    )
    (call (. types scratch types rewind) list-mark)
    (if (or (== target no-type) (== target to) (not (. ([] (. types completions) target) has-variables)))
      (return false)
    )
    (return (call bind-row types target to mark))
  )
  (fn-do _ push-converters _
    (param id TypeId)
    (param caller (? ModuleId))
    (let completion (call (. types completion-of) id))
    (if (not (. completion has-variables))
      (for (in converter ([] (. types children) (. completion converters)))
        (call (. types scratch types push) converter)
      )
      (if caller
        (call push-extension-converters caller id)
      )
    )
    (let base (call (. types base-of) id))
    (if base
      (call push-converters base caller)
    )
    (for (in offset (..< 0 (. completion interfaces count)))
      (call push-converters (call (. types child-type) (. completion interfaces) offset) caller)
    )
  )
  (fn-do _ push-extension-converters _
    (param caller ModuleId)
    (param id TypeId)
    (let ref (call class-decl-ref types id))
    (if (== (. ref module) (. U32 max))
      (return)
    )
    (for (in extension (call (. program extensions-for) caller (. ref module) (. ref decl)))
      (let matched (call match-extension (. extension module) (. extension decl) id))
      (if matched
        (let owner-module ([] (. program modules) (. extension module)))
        (match? ([] (. owner-module decls) (. extension decl))
          (case (call .decl-extension row)
            (for (in member ([] (. owner-module member-pool) (. row members)))
              (match? ([] (. owner-module decls) member)
                (case (call .decl-converter converter)
                  (let syntax (. converter target-type))
                  (let env (. matched env))
                  (let owner (. extension module))
                  (let target
                    (call member-type-in
                      (block
                        (arg types)
                        (arg owner)
                        (arg member)
                        (arg syntax)
                        (arg env)
                      )
                    )
                  )
                  (call (. types scratch types push) target)
                  (call (. types scratch types push) (. extension module))
                  (call (. types scratch types push) member)
                  (call (. types scratch types push) id)
                  (+= extension-uses 1)
                )
              )
            )
          )
        )
        (call (. types env-release) (. matched env))
      )
    )
  )
  (fn-do _ converter-match ConverterHit
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    ; The converter a type gives a type by, as TypeScript's `dispatchConverter` finds it: of the
    ; type's own, its extensions', its base's and its interfaces', in that order, the first whose
    ; target is the type asked for, or else the first whose target binds to it. One that binds to a
    ; pointer to anything but `Void` converts only when asked, as it reads the type as another.
    (let mark (. types scratch types mark))
    (call push-converters from caller)
    (let count (/ (- (. types scratch types length) mark) converter-words))
    (let best (call ConverterHit no-match (. U32 max) 0))
    (let best-rank 0i32)
    (for (in offset (..< 0 count))
      (let base (+ mark (* offset converter-words)))
      (let target ([] (. types scratch types) base))
      (let module U32 ([] (. types scratch types) (+ base 1)))
      (let decl U32 ([] (. types scratch types) (+ base 2)))
      (let owner ([] (. types scratch types) (+ base 3)))
      (let rank 0i32)
      (let binding-mark (. types scratch types mark))
      (let applies false)
      (if (or (== target to) (call is-alternative target to))
        (= applies true)
        (else-if (and (. ([] (. types completions) target) has-variables) (not (. ([] (. types completions) to) has-variables)))
          (= applies (call bind-row types target to binding-mark))
          (= rank 1)
        )
      )
      (let ties (and (!= (. best specificity) no-match) (== rank best-rank)))
      (if (and applies (or (== (. best specificity) no-match) (<= rank best-rank)))
        (let hit (call converter-hit module decl owner binding-mark))
        (if (and (!= (. hit specificity) no-match) ties)
          (let collision (call converter-collision best module decl))
          (if (!= collision .reason-none)
            (= best
              (call ConverterHit
                (block
                  (arg (. best specificity))
                  (arg (. best module))
                  (arg (. best decl))
                  (arg collision)
                  (arg (. best implicit))
                )
              )
            )
          )
          (else-if (and (!= (. hit specificity) no-match) (!= rank 0) (call retypes-pointer to))
            (= best (call ConverterHit (. hit specificity) (. hit module) (. hit decl) (. hit collision) false))
            (= best-rank rank)
          )
          (else-if (!= (. hit specificity) no-match)
            (= best hit)
            (= best-rank rank)
          )
        )
      )
      (call (. types scratch types rewind) binding-mark)
    )
    (call (. types scratch types rewind) mark)
    (return best)
  )
  (fn-expr _ retypes-pointer Bool
    (param to TypeId)
    (and (== (. (call (. types completion-of) to) intrinsic) .cpointer) (!= (call pointee-of types to) (. types void-type)))
  )
  (fn-do _ is-alternative Bool
    (param target TypeId)
    (param to TypeId)
    ; Whether a converter declared to give one of several types gives the one asked for: the
    ; reference completes the type it declares against the one asked for, which takes the
    ; alternative that is that type.
    (call (. types complete) target)
    (if (!= (. ([] (. types completions) target) intrinsic) .or)
      (return false)
    )
    (let alternatives (. ([] (. types completions) target) alternatives))
    (for (in offset (..< 0 (. alternatives count)))
      (if (== (call (. types child-type) alternatives offset) to)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ converter-collision RelationReason
    (param held ConverterHit)
    (param module ModuleId)
    (param decl DeclId)
    ; Two converters that reach one target equally well collide when an extension adds either: two
    ; extensions are ambiguous, and an extension beside the type's own converter conflicts with it.
    (case? (and (== (. held module) module) (== (. held decl) decl))
      .reason-none
    )
    (case? (and mine theirs)
      .reason-ambiguous
    )
    (case? (or mine theirs)
      .reason-conflict
    )
    (default
      .reason-none
    )
    (where
      (lazy mine (call extends-converter (. held module) (. held decl)))
      (lazy theirs (call extends-converter module decl))
    )
  )
  (fn-do _ extends-converter Bool
    (param module ModuleId)
    (param decl DeclId)
    (let decls (. ([] (. program modules) module) decls))
    (match? ([] decls decl)
      (case (call .decl-converter row)
        (match? ([] decls (. row owner))
          (case .decl-extension
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ converter-hit ConverterHit
    (param module ModuleId)
    (param decl DeclId)
    (param owner TypeId)
    (param binding-mark ScratchMark)
    (let owner-module 0u32)
    (let owner-decl 0u32)
    (let owner-args (call (of RowRange TypeId)))
    (match? ([] (. types rows) owner)
      (case (call .type-class row)
        (= owner-module (. row module))
        (= owner-decl (. row decl))
        (= owner-args (. row args))
      )
    )
    (let decls (. ([] (. program modules) module) decls))
    (let extension-owner (. U32 max))
    (match? ([] decls decl)
      (case (call .decl-converter row)
        (match? ([] decls (. row owner))
          (case .decl-extension
            (= extension-owner (. row owner))
          )
        )
      )
    )
    (let env (call (. types env-frame)))
    (if (!= extension-owner (. U32 max))
      (let matched (call match-extension module extension-owner owner))
      (if (not matched)
        (return (call ConverterHit no-match (. U32 max) 0))
      )
      (= env (. matched env))
      (else
        (= env (call (. types class-env-for) owner-module owner-decl owner-args owner))
      )
    )
    (let count (/ (- (. types scratch types length) binding-mark) 2))
    (for (in offset (..< 0 count))
      (let variable ([] (. types scratch types) (+ binding-mark (* offset 2))))
      (let actual ([] (. types scratch types) (+ binding-mark (* offset 2) 1)))
      (let name (call variable-name types variable))
      (if name
        (= env (call (. types env-bind) env name actual))
      )
    )
    (let tree (. ([] (. program modules) module) tree))
    (let result (call ParamResult env .convertible false))
    (match? ([] decls decl)
      (case (call .decl-converter row)
        (let assigns (. row param-assignments))
        (let limits (. row param-constraints))
        (= result (call apply-param-declarations module tree assigns limits env))
      )
    )
    (call (. types env-release) (. result env))
    (if (. result accepted)
      (return (call ConverterHit (. result specificity) module decl .reason-none (. result implicit)))
    )
    (return (call ConverterHit no-match (. U32 max) 0))
  )
  (fn-do _ apply-param-declarations ParamResult
    (param module ModuleId)
    (param tree AST)
    (param assignments (of RowRange SyntaxId))
    (param constraints (of RowRange SyntaxId))
    (param env TypeEnv)
    (let current env)
    (let specificity (. Specificity convertible))
    (let accepted true)
    (let implicit true)
    (for (in assignment ([] (. tree nodes) ([] (. tree children) assignments)))
      (match? assignment
        (case (call .node-param-assignment arow)
          (let assigned (call assignment-type module tree (. arow right) current))
          (if (== (. assigned type) invalid-type)
            (= accepted false)
            (else
              (= implicit (and implicit (. assigned implicit)))
              (if (. arow is-specificity)
                (= specificity (. assigned match))
              )
              (let left (call (. types type-syntax-name) tree (. arow left)))
              (let bound (only-if (call (. types env-lookup) current left) (if left)))
              (if (and left (not bound))
                (= current (call (. types env-bind) current left (. assigned type)))
                (else-if (and bound (!= bound (. assigned type)))
                  (= accepted false)
                )
              )
            )
          )
        )
      )
    )
    (for (in constraint ([] (. tree nodes) ([] (. tree children) constraints)))
      (match? constraint
        (case (call .node-param-constraint crow)
          (let name (call (. types type-syntax-name) tree (. crow left)))
          (let bound (only-if (call (. types env-lookup) current name) (if name)))
          (if bound
            (let caller Index module)
            (let right (call (. types evaluate-type) (as caller ModuleId) tree (. crow right) current))
            (let relation (call compare bound right))
            (let required (call required-match (. crow op)))
            (if (not (call holds-as relation required true))
              (= accepted false)
              (else-if (and (== required .convertible) (not (call kin relation)) (not (call (. this implicit) relation)))
                (= implicit false)
              )
            )
            (else
              (= accepted false)
            )
          )
        )
      )
    )
    (return (call ParamResult current specificity accepted implicit))
  )
  (fn-do + match-extension (? ExtensionHit)
    (param module ModuleId)
    (param decl DeclId)
    (param type TypeId)
    (let env (call extension-env types module decl type))
    (let pattern (. env this-type))
    (let ref (call class-decl-ref types pattern))
    (if (== (. ref module) (. U32 max))
      (call (. types env-release) env)
      (return null)
    )
    (let matching (call member-class types type (. ref module) (. ref decl)))
    (if (== matching no-type)
      (call (. types env-release) env)
      (return null)
    )
    (let mark (. types scratch types mark))
    (if (not (call bind-row types pattern matching mark))
      (call (. types scratch types rewind) mark)
      (call (. types env-release) env)
      (return null)
    )
    (let count (/ (- (. types scratch types length) mark) 2))
    (for (in offset (..< 0 count))
      (let variable ([] (. types scratch types) (+ mark (* offset 2))))
      (let actual ([] (. types scratch types) (+ mark (* offset 2) 1)))
      (let name (call variable-name types variable))
      (if name
        (= env (call (. types env-bind) env name actual))
      )
    )
    (call (. types scratch types rewind) mark)
    (let owner-module ([] (. program modules) module))
    (let tree (. owner-module tree))
    (let result (call ParamResult env .convertible false))
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-extension row)
        (let assigns (. row param-assignments))
        (let limits (. row param-constraints))
        (= result (call apply-param-declarations module tree assigns limits env))
      )
    )
    (= env (. result env))
    (if (or (not (. result accepted)) (not (call params-resolved types env)))
      (call (. types env-release) env)
      (return null)
    )
    (return (call ExtensionHit module decl matching (call (. types env-with-this) env matching)))
  )
  (fn-do + extension-matches (stream ExtensionHit)
    (param caller ModuleId)
    (param type TypeId)
    (let chain (list TypeId))
    (call collect-member-chain types type chain)
    (for (in level chain)
      (let ref (call class-decl-ref types level))
      (if (!= (. ref module) (. U32 max))
        (for (in extension (call (. program extensions-for) caller (. ref module) (. ref decl)))
          (let decl U32 (. extension decl))
          (let matched (call match-extension (. extension module) decl type))
          (if matched
            (yield matched)
            (blank)
            (call (. types env-release) (. matched env))
          )
        )
      )
    )
  )
  (fn-do _ assignment-type Assigned
    (param module ModuleId)
    (param tree AST)
    (param right SyntaxId)
    (param env TypeEnv)
    (match? ([] (. tree nodes) right)
      (case (call .node-cast-expression cast)
        (let source (call (. types evaluate-type) module tree (. cast lhs) env))
        (let target (call (. types evaluate-type) module tree (. cast rhs) env))
        (let relation (call compare source target))
        (if (call relation-legal relation)
          (let unified (if-expr (!= (. relation unified) no-type) (. relation unified) target))
          (return (call Assigned unified (. relation match) (call implicit relation)))
        )
        (return (call Assigned invalid-type .convertible))
      )
    )
    (return (call Assigned (call (. types evaluate-type) module tree right env) .convertible))
  )
  (fn-do + fromverter-owner FromverterHit
    (param to TypeId)
    (param from TypeId)
    (param caller (? ModuleId))
    (let completion ([] (. types completions) to))
    (let direct (call FromverterHit no-type (. U32 max) 0))
    (for (in offset (..< 0 (/ (. completion fromverters count) converter-words)))
      (let base (* offset converter-words))
      (if (and (== (. direct owner) no-type) (== (call (. types child-type) (. completion fromverters) (as base U32)) from))
        (let module U32 (call (. types child-type) (. completion fromverters) (as (+ base 1) U32)))
        (let decl U32 (call (. types child-type) (. completion fromverters) (as (+ base 2) U32)))
        (= direct (call FromverterHit to module decl))
      )
    )
    (if caller
      (let extended (call extension-fromverter-hit caller to from))
      (if (and (!= (. extended owner) no-type) (!= (. direct owner) no-type))
        (return (call FromverterHit to (. direct module) (. direct decl) .reason-conflict))
      )
      (if (!= (. extended owner) no-type)
        (return extended)
      )
    )
    (if (!= (. direct owner) no-type)
      (return direct)
    )
    (let numeric-from (call intrinsic-is-numeric (. ([] (. types completions) from) intrinsic)))
    (if (and (. completion has-enums) (!= (. completion intrinsic) .union) numeric-from)
      (return (call FromverterHit to (. U32 max) 0))
    )
    (let base (call (. types base-of) to))
    (if base
      (return (call fromverter-owner base from caller))
    )
    (return (call FromverterHit no-type (. U32 max) 0))
  )
  (fn-do _ extension-fromverter-hit FromverterHit
    (param caller ModuleId)
    (param to TypeId)
    (param from TypeId)
    ; The fromverter an extension adds for the source type; two of them are ambiguous.
    (let ref (call class-ref types to))
    (let hit (call FromverterHit no-type (. U32 max) 0))
    (if (== (. ref module) (. U32 max))
      (return hit)
    )
    (for (in extension (call (. program extensions-for) caller (. ref module) (. ref decl)))
      (let matched (call match-extension (. extension module) (. extension decl) to))
      (if matched
        (let owner-module ([] (. program modules) (. extension module)))
        (match? ([] (. owner-module decls) (. extension decl))
          (case (call .decl-extension row)
            (for (in member ([] (. owner-module member-pool) (. row members)))
              (match? ([] (. owner-module decls) member)
                (case (call .decl-fromverter fromverter)
                  (let syntax (. fromverter source-type))
                  (let env (. matched env))
                  (let owner (. extension module))
                  (let source
                    (call member-type-in
                      (block
                        (arg types)
                        (arg owner)
                        (arg member)
                        (arg syntax)
                        (arg env)
                      )
                    )
                  )
                  (if (and (== source from) (!= (. hit owner) no-type))
                    (= hit (call FromverterHit to (. hit module) (. hit decl) .reason-ambiguous))
                    (else-if (== source from)
                      (= hit (call FromverterHit to (. extension module) member))
                      (+= extension-uses 1)
                    )
                  )
                )
              )
            )
          )
        )
        (call (. types env-release) (. matched env))
      )
    )
    (return hit)
  )
  (fn-expr _ tests-truth Bool
    (param to TypeId)
    (param from TypeId)
    (and (== (. ([] (. types completions) to) intrinsic) .bool) (!= from-type .bool) (not (call intrinsic-is-numeric from-type)))
    (where
      (lazy from-type (. ([] (. types completions) from) intrinsic))
    )
  )
  (fn-do _ can-side-cast Bool
    (param to TypeId)
    (param from TypeId)
    (let to-completion ([] (. types completions) to))
    (let from-completion ([] (. types completions) from))
    (let to-type (. to-completion intrinsic))
    (let from-type (. from-completion intrinsic))
    (if (== to-type .bool)
      (return (. from-completion is-builtin))
    )
    (if (== to-type .cpointer)
      (return (or (call pointer-accepts from-type) (and (== from-type .union) (call holds-objects from))))
    )
    (if (== to-type .string)
      (return (and (== from-type .cpointer) (== (call pointee-of types from) (. types char8-type))))
    )
    (if (== to-type .optional)
      (return (call optional-accepts to from))
    )
    (if (or (== to-type .closure) (== to-type .capture))
      (return (== from-type .cpointer))
    )
    (if (== to-type .function)
      (if (== from-type .binding)
        (return true)
      )
      (if (== from-type .closure)
        (return (!= (call fit-closure from to null) null))
      )
      (if (or (== from-type .function) (== from-type .cfunction))
        (return (call legal-function-call (call function-row types from) (call function-row types to)))
      )
      (return false)
    )
    (if (== to-type .cfunction)
      (if (or (== from (. types null-type)) (== from-type .binding))
        (return true)
      )
      (if (== from-type .cfunction)
        (return (call legal-function-call (call function-row types from) (call function-row types to)))
      )
      (return false)
    )
    (if (call intrinsic-is-numeric to-type)
      (let unitless (or (not (. to-completion has-equalities)) (not (. from-completion has-equalities))))
      (return (and (call intrinsic-is-numeric from-type) unitless))
    )
    (if (== to-type .table-span)
      (return (call zips-columns to from))
    )
    (if (and (== to-type .tuple) (== from-type .tuple))
      (return (call view-widens to from))
    )
    (return false)
  )
  (fn-do _ fit-closure (? TypeId)
    (param from TypeId)
    (param to TypeId)
    (param scope (? MatchScope))
    ; A closure is a value of a function type when its body types with that type's arguments and
    ; returns what the type returns. Only the caller that is ranking or converting can type the
    ; body, so the answer holds for that caller alone and is never remembered.
    (+= callable-uses 1)
    (if (not callables)
      (return null)
    )
    (return (call (. callables fit-callable) from to scope))
  )
  (fn-do _ zips-columns Bool
    (param to TypeId)
    (param from TypeId)
    ; A span of struct rows is cast from the tuple of that struct's mutable fields, in order.
    (let row (call class-arg types to 0))
    (if (or (== row no-type) (== (. ([] (. types completions) row) intrinsic) .union))
      (return false)
    )
    (let zipped (call (of RowRange TypeId)))
    (match? ([] (. types rows) from)
      (case (call .type-tuple tuple)
        (= zipped (. tuple fields))
      )
    )
    (if (== (. zipped count) 0)
      (return false)
    )
    (let mark (. types scratch types mark))
    (call push-fields types row)
    (let matches (== (- (. types scratch types length) mark) (. zipped count)))
    (if matches
      (for (in offset (..< 0 (. zipped count)))
        (let column (call (. types child-type) zipped offset))
        (call (. types complete) column)
        (let is-column (== (. ([] (. types completions) column) intrinsic) .table-column))
        (if (or (not is-column) (!= (call class-arg types column 0) ([] (. types scratch types) (+ mark offset))))
          (= matches false)
        )
      )
    )
    (call (. types scratch types rewind) mark)
    (return matches)
  )
  (fn-expr _ view-widens Bool
    (param to TypeId)
    (param from TypeId)
    (case? (and (not ranged) (not (call same-decl target source)))
      false
    )
    (case? (and (not rows) (not fields) (not (call same-decl target (. types array-row-decl))))
      false
    )
    (case? (!= (call class-arg types to 0) (call class-arg types from 0))
      false
    )
    (default
      (and readable (== (call class-arg types from 1) (. types array-write-access)))
    )
    (where
      (lazy target (call class-decl-ref types to))
      (lazy source (call class-decl-ref types from))
      (lazy row-range (. types array-row-range-decl))
      (lazy ranged (and (call same-decl target row-range) (call same-decl source (. types array-rows-decl))))
      (lazy rows (or (call same-decl target row-range) (call same-decl target (. types array-rows-decl))))
      (lazy fields (or (call same-decl target (. types array-fields-decl)) (call same-decl target (. types array-field-decl))))
      (lazy readable (== (call class-arg types to 1) (. types array-read-access)))
    )
  )
  (fn-do _ optional-accepts Bool
    (param to TypeId)
    (param from TypeId)
    (if (== from (. types null-type))
      (return true)
    )
    (let inner (call optional-item to))
    (if (== inner no-type)
      (return false)
    )
    (if (== (. ([] (. types completions) from) intrinsic) .optional)
      (let given (call optional-item from))
      (return (and (!= given no-type) (call legal given inner)))
    )
    (if (== (. ([] (. types completions) from) intrinsic) .union)
      (for (in fact (call (. types cases-of) from))
        (if (== (. fact type) to)
          (return false)
        )
      )
    )
    (return (call legal from inner))
  )
  (fn-expr _ optional-item TypeId
    (param id TypeId)
    ; The type an optional holds, through a class that only derives from Optional.
    (if-expr (!= found no-type) (call class-arg types found 0) no-type)
    (where
      (lazy found (call (. types ancestor-of) id (call (. types type-decl) .optional)))
    )
  )
  (fn-expr _ legal Bool
    (param from TypeId)
    (param to TypeId)
    (call relation-legal (call compare from to))
  )
  (fn-do _ legal-function-call Bool
    (param from TypeId)
    (param to TypeId)
    (if (or (== from no-type) (== to no-type))
      (return false)
    )
    (let from-args (call (of RowRange TypeId)))
    (let from-errors (call (of RowRange TypeId)))
    (let from-return no-type)
    (let to-args (call (of RowRange TypeId)))
    (let to-errors (call (of RowRange TypeId)))
    (let to-return no-type)
    (match? ([] (. types rows) from)
      (case (call .type-function row)
        (= from-args (. row args))
        (= from-errors (. row errors))
        (= from-return (. row return-type))
      )
    )
    (match? ([] (. types rows) to)
      (case (call .type-function row)
        (= to-args (. row args))
        (= to-errors (. row errors))
        (= to-return (. row return-type))
      )
    )
    (if (!= (. from-args count) (. to-args count))
      (return false)
    )
    (for (in offset (..< 0 (. to-args count)))
      (let arg-from (call (. types child-type) to-args offset))
      (let arg-to (call (. types child-type) from-args offset))
      (if (not (call legal arg-from arg-to))
        (return false)
      )
    )
    (if (not (call legal from-return to-return))
      (return false)
    )
    (return (call accepts-errors from-errors to-errors))
  )
  (fn-do _ calls-implicit Bool
    (param from TypeId)
    (param to TypeId)
    (param texts Bool)
    ; Whether a function becomes a value of another function type unasked: as a call of it converts,
    ; each argument the type gives converts unasked to the one the function takes, and what the
    ; function gives to what the type returns.
    (if (or (== from no-type) (== to no-type))
      (return false)
    )
    (let from-args (call (of RowRange TypeId)))
    (let from-return no-type)
    (let to-args (call (of RowRange TypeId)))
    (let to-return no-type)
    (match? ([] (. types rows) from)
      (case (call .type-function row)
        (= from-args (. row args))
        (= from-return (. row return-type))
      )
    )
    (match? ([] (. types rows) to)
      (case (call .type-function row)
        (= to-args (. row args))
        (= to-return (. row return-type))
      )
    )
    (if (!= (. from-args count) (. to-args count))
      (return false)
    )
    (for (in offset (..< 0 (. to-args count)))
      (if (not (call implicit (call compare to-arg (call (. types child-type) from-args offset)) texts))
        (return false)
      )
      (lazy to-arg (call (. types child-type) to-args offset))
    )
    (return
      (scope (or same-return (call implicit (call compare from-return to-return) texts))
        (lazy same-return (or (== to-return (. types void-type)) (== from-return to-return)))
      )
    )
  )
  (fn-do _ accepts-errors Bool
    (param raised (of RowRange TypeId))
    (param accepted (of RowRange TypeId))
    (for (in offset (..< 0 (. raised count)))
      (let error (call (. types child-type) raised offset))
      (let handled false)
      (for (in candidate (..< 0 (. accepted count)))
        (if (call legal error (call (. types child-type) accepted candidate))
          (= handled true)
        )
      )
      (if (not handled)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ can-unwrap-cast Bool
    (param from TypeId)
    (param to TypeId)
    (let from-type (. ([] (. types completions) from) intrinsic))
    (if (== from-type .optional)
      (let inner (call optional-item from))
      (if (== to inner)
        (return true)
      )
      (if (or (== to (. types bool-type)) (== inner no-type))
        (return false)
      )
      (let relation (call compare inner to))
      (return (and (call relation-legal relation) (< (. relation rank) converter-rank)))
    )
    (if (== from-type .union)
      (return (!= (call wrap-case from to) no-case))
    )
    (if (or (== from-type .table-row) (== from-type .immutable-table-row))
      (let row (call class-arg types from 0))
      (return (or (== to row) (call shares-base row to)))
    )
    (if (and (== from-type .tuple) (call same-decl (call class-decl-ref types from) (. types array-row-decl)))
      (return (== to (call class-arg types from 0)))
    )
    (return false)
  )
  (fn-do _ down-case U32
    (param union TypeId)
    (param to TypeId)
    (if (not (call intrinsic-is-class (. ([] (. types completions) to) intrinsic)))
      (return no-case)
    )
    (let above false)
    (for (in fact (call (. types cases-of) union))
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (continue)
      )
      (let kind (. ([] (. types completions) (. fact type)) intrinsic))
      (if (and (== kind .interface) (call has-interface types to (. fact type)))
        (return no-case)
      )
      (if (and (call intrinsic-is-class kind) (!= (. fact type) to) (call in-base-chain types to (. fact type)))
        (= above true)
      )
    )
    (return (if-expr above (call wrap-case union to true) no-case))
  )
  (fn-do _ holds-objects Bool
    (param union TypeId)
    (let cases (call (. types cases-of) union))
    (for (in fact cases)
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return false)
      )
      (call (. types complete) (. fact type))
      (if (not (call intrinsic-is-class (. ([] (. types completions) (. fact type)) intrinsic)))
        (return false)
      )
    )
    (return (!= (. cases length) 0))
  )
  (fn-do _ shares-base Bool
    (param union TypeId)
    (param base TypeId)
    ; Whether every case of a union derives from a base, which a table row of the union then
    ; reads from the fields the cases share.
    (if (== union no-type)
      (return false)
    )
    (call (. types complete) union)
    (if (!= (. ([] (. types completions) union) intrinsic) .union)
      (return false)
    )
    (let ref (call class-decl-ref types base))
    (if (== (. ref module) (. U32 max))
      (return false)
    )
    (let cases (call (. types cases-of) union))
    (for (in fact cases)
      (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
        (return false)
      )
      (if (or (== (. fact type) base) (!= (call (. types ancestor-of) (. fact type) ref) base))
        (return false)
      )
    )
    (return (!= (. cases length) 0))
  )
  (fn-do _ wrap-case U32
    (param union TypeId)
    (param from TypeId)
    (param converts Bool (= false))
    (param unnamed Bool (= false))
    ; The case of a union a value of a type is held in, or none: one it converts to unasked before
    ; one it does not, and among those the nearest. With `converts` the value may also be cast up to
    ; the case's class or to its interface, as when it is wrapped, and with `unnamed` only a case with
    ; no name holds it.
    (let mark (. types scratch types mark))
    (call push-cases types union unnamed)
    (let count (/ (- (. types scratch types length) mark) 2))
    (let generator (call generator-item types from))
    (if (!= generator no-type)
      (for (in offset (..< 0 count))
        (let case-type ([] (. types scratch types) (+ mark (* offset 2))))
        (let item (call list-item types case-type))
        (if (and (!= item no-type) (call legal generator item))
          (let chosen U32 ([] (. types scratch types) (+ mark (* offset 2) 1)))
          (call (. types scratch types rewind) mark)
          (return chosen)
        )
      )
    )
    (let best no-case)
    (let best-rank 0i32)
    (let best-match 0u32)
    (let best-unasked false)
    (for (in offset (..< 0 count))
      (let case-type ([] (. types scratch types) (+ mark (* offset 2))))
      (let index U32 ([] (. types scratch types) (+ mark (* offset 2) 1)))
      (let relation (call compare from case-type false true))
      (let cast (or (== (. relation kind) .relation-up-cast) (== (. relation kind) .relation-interface-cast)))
      (if (or (call usable-wrap types relation) (and converts (call relation-legal relation) cast))
        (let rank (call case-selection-rank types relation))
        (let match U32 (. relation match))
        (let unasked (call implicit relation))
        (let nearer (or (< rank best-rank) (and (== rank best-rank) (> match best-match))))
        (if (or (== best no-case) (and unasked (not best-unasked)) (and (== unasked best-unasked) nearer))
          (= best index)
          (= best-rank rank)
          (= best-match match)
          (= best-unasked unasked)
        )
      )
    )
    (call (. types scratch types rewind) mark)
    (return best)
  )
  (fn-expr _ best-alternative TypeId
    (param from TypeId)
    (param to TypeId)
    (param scope (? MatchScope))
    ([] best 0)
    (where
      (lazy alternatives (. ([] (. types completions) to) alternatives))
      (lazy best
        (call reduce (tuple no-type 0i32) (..< 0 (. alternatives count))
          (:using
            (=> (current offset)
              (block
                (case? (and (call relation-legal relation) (or (== ([] current 0) no-type) (< (. relation rank) ([] current 1))))
                  (tuple alternative (. relation rank))
                )
                (default
                  current
                )
                (lazy alternative (call (. types child-type) alternatives offset))
                (lazy relation (call compare from alternative false false scope))
              )
            )
          )
        )
      )
    )
  )
  (fn-expr _ can-final-cast Bool
    (param to TypeId)
    (param from TypeId)
    (case? (== to-type .bool)
      true
    )
    (case? (== to-type .table-row)
      (and (!= row no-type) (== (. ([] (. types completions) row) intrinsic) .union) (call case-present types row from))
    )
    (case? (== to-type .union)
      (and (== from-type .union) (call union-rewraps to from))
    )
    (case? (call intrinsic-is-tuple-like to-type)
      (and (not (call is-array-view to)) (call tuple-final-cast to from))
    )
    (default
      false
    )
    (where
      (lazy to-type (. ([] (. types completions) to) intrinsic))
      (lazy from-type (. ([] (. types completions) from) intrinsic))
      (lazy row (call class-arg types to 0))
    )
  )
  (fn-expr _ is-array-view Bool
    (param type TypeId)
    ; A view of an array's rows or fields carries the access it was made with: only a view that
    ; writes becomes one that reads, never by a cast of last resort.
    (or plural (call same-decl target (. types array-field-decl)) (call same-decl target (. types array-row-decl)))
    (where
      (lazy target (call class-decl-ref types type))
      (lazy plural (or rows (call same-decl target (. types array-fields-decl))))
      (lazy rows (or (call same-decl target (. types array-rows-decl)) (call same-decl target (. types array-row-range-decl))))
    )
  )
  (fn-do _ union-rewraps Bool
    (param to TypeId)
    (param from TypeId)
    (let mark (. types scratch types mark))
    (let has-default (call push-cases types from))
    (let count (/ (- (. types scratch types length) mark) 2))
    (let rewraps (and (not has-default) (!= count 0)))
    (if rewraps
      (for (in offset (..< 0 count))
        (let case-type ([] (. types scratch types) (+ mark (* offset 2))))
        (if (== (call wrap-case to case-type true) no-case)
          (= rewraps false)
        )
      )
    )
    (call (. types scratch types rewind) mark)
    (return rewraps)
  )
  (fn-do _ tuple-final-cast Bool
    (param to TypeId)
    (param from TypeId)
    (let from-anon (call is-anonymous-fields types from))
    (let to-anon (call is-anonymous-fields types to))
    (let named (and (not from-anon) (not to-anon)))
    (if (and named (not (call same-class types from to)))
      (return false)
    )
    (let from-struct (== (. ([] (. types completions) from) intrinsic) .struct))
    (if (and (not named) (not from-anon) (not (and to-anon from-struct)))
      (return false)
    )
    (let from-mark (. types scratch types mark))
    (call push-fields types from)
    (let to-mark (. types scratch types mark))
    (call push-fields types to)
    (let count (- to-mark from-mark))
    (let legal-fields (== count (- (. types scratch types length) to-mark)))
    (if legal-fields
      (for (in offset (..< 0 count))
        (let from-field ([] (. types scratch types) (+ from-mark offset)))
        (let to-field ([] (. types scratch types) (+ to-mark offset)))
        (if (and (!= from-field no-type) (!= to-field no-type) (or (not named) (!= from-field to-field)))
          (if (and named (or (== (. ([] (. types completions) from-field) intrinsic) .cpointer) to-pointer))
            (= legal-fields false)
            (else-if (not (call legal from-field to-field))
              (= legal-fields false)
            )
          )
          (lazy to-pointer (== (. ([] (. types completions) to-field) intrinsic) .cpointer))
        )
      )
      (else-if named
        (= legal-fields true)
      )
    )
    (call (. types scratch types rewind) from-mark)
    (return legal-fields)
  )
  (fn-do + tuple-field-preference I32
    (param from TypeId)
    (param left TypeId)
    (param right TypeId)
    (param left-declared TypeId (= no-type))
    (param right-declared TypeId (= no-type))
    ; Which of two tuples a tuple written with no name is better cast to, field by field: above
    ; zero for the right one, under it for the left one, zero where the fields disagree. A
    ; field one of the two declares as a parameter of its own loses to one the other declares
    ; with a type, as the reference prefers; any other is the one of lower rank.
    (if (not (call is-anonymous-fields types from))
      (return 0)
    )
    (let left-tuple (call intrinsic-is-tuple-like (. ([] (. types completions) left) intrinsic)))
    (let right-tuple (call intrinsic-is-tuple-like (. ([] (. types completions) right) intrinsic)))
    (if (or (not left-tuple) (not right-tuple))
      (return 0)
    )
    (let from-mark (. types scratch types mark))
    (call push-fields types from)
    (let left-mark (. types scratch types mark))
    (call push-fields types left)
    (let right-mark (. types scratch types mark))
    (call push-fields types right)
    (let left-open (. types scratch types mark))
    (if (and (!= left-declared no-type) (!= left-declared invalid-type))
      (call push-fields types left-declared)
    )
    (let right-open (. types scratch types mark))
    (if (and (!= right-declared no-type) (!= right-declared invalid-type))
      (call push-fields types right-declared)
    )
    (let count (- left-mark from-mark))
    (let knows-left (== (- right-open left-open) count))
    (let knows-right (== (- (. types scratch types length) right-open) count))
    (let preference 0i32)
    (let conflict false)
    (if (and (== (- right-mark left-mark) count) (== (- left-open right-mark) count))
      (for (in offset (..< 0 count))
        (let field ([] (. types scratch types) (+ from-mark offset)))
        (let to-left ([] (. types scratch types) (+ left-mark offset)))
        (let to-right ([] (. types scratch types) (+ right-mark offset)))
        (if (and (!= field no-type) (!= to-left no-type) (!= to-right no-type))
          (let left-free (and knows-left (call is-free-field ([] (. types scratch types) (+ left-open offset)))))
          (let right-free (and knows-right (call is-free-field ([] (. types scratch types) (+ right-open offset)))))
          (let left-rank (. (call compare field to-left) rank))
          (let right-rank (. (call compare field to-right) rank))
          (let field-preference 0i32)
          (if (!= left-free right-free)
            (= field-preference (if-expr left-free 1 -1))
            (else-if left-free
              (= field-preference 0)
            )
            (else-if (> left-rank right-rank)
              (= field-preference 1)
            )
            (else-if (< left-rank right-rank)
              (= field-preference -1)
            )
          )
          (if (!= field-preference 0)
            (if (and (!= preference 0) (!= preference field-preference))
              (= conflict true)
            )
            (= preference field-preference)
          )
        )
      )
    )
    (call (. types scratch types rewind) from-mark)
    (return (if-expr conflict 0 preference))
  )
  (fn-expr _ is-free-field Bool
    (param declared TypeId)
    (and (!= declared no-type) (!= declared invalid-type) (call is-variable-row types declared))
  )
  (fn-expr _ has-type Bool
    (param a TypeId)
    (param b TypeId)
    (match (. ([] (. types completions) a) intrinsic)
      (case= .optional
        (== b (call class-arg types a 0))
      )
      (case= .union
        (!= (call wrap-case a b) no-case)
      )
      (default
        false
      )
    )
  )
  (fn-expr + scope-open MatchScope
    (call MatchScope (. params length) (. params length))
  )
  (fn-do + scope-release _
    (param scope MatchScope)
    (call (. params truncate) (. scope start))
  )
  (fn-do + scope-find (? Size)
    (param scope MatchScope)
    (param name Atom)
    (let position (. scope start))
    (for (in row ([] params (..< (. scope start) (. scope end))))
      (if (== (. row name) name)
        (return position)
      )
      (+= position 1)
    )
    (return null)
  )
  (fn-expr + scope-lookup (? TypeId)
    (param scope MatchScope)
    (param name Atom)
    (case? (and found (!= type no-type))
      type
    )
    (default
      null
    )
    (where
      (lazy found (call scope-find scope name))
      (lazy type (. ([] params found) type))
    )
  )
  (fn-do + scope-declare (? MatchScope)
    (param scope MatchScope)
    (param name Atom)
    (param explicit Bool)
    (param type (? TypeId))
    (throw (call Panic "MatchScope declaration below the top frame") (if (!= (. scope end) (. params length))))
    (blank)
    (let resolved-explicit false)
    (if (and explicit type)
      (let own (call variable-name types type))
      (= resolved-explicit (or (not (call is-variable-row types type)) (not own) (!= own name)))
    )
    (let found (call scope-find scope name))
    (if (not found)
      (let row
        (call TypeParamMatch
          (block
            (arg name)
            (arg (?? type no-type))
            (arg resolved-explicit)
            (arg resolved-explicit)
            (arg .convertible)
            (arg false)
            (arg 0)
            (arg 0)
            (arg 0)
            (arg false)
            (arg 0)
            (arg 0)
            (arg .convertible)
          )
        )
      )
      (call (. params append) row)
      (return (call MatchScope (. scope start) (+ (. scope end) 1)))
    )
    (let index Index found)
    (let pinned (or (. ([] params index) is-pinned) resolved-explicit))
    (let previous (. ([] params index) type))
    (if (and (!= previous no-type) (not explicit) pinned)
      (= (. ([] params index) is-pinned) pinned)
      (return scope)
    )
    (if (and (!= previous no-type) (not (call is-variable-row types previous)))
      (if (not type)
        (return null)
      )
      (let held (call implicitly (call compare type previous false false null)))
      (if (or (not (call relation-legal held)) (call is-narrowing held))
        (let unifier (call unify previous type))
        (if (not (call relation-legal unifier))
          (return null)
        )
        (= (. ([] params index) type) (. unifier unified))
      )
      (= (. ([] params index) is-pinned) pinned)
      (= (. ([] params index) is-explicit) pinned)
      (return scope)
    )
    (let was-inferred false)
    (if type
      (= was-inferred (!= type previous))
    )
    (= (. ([] params index) is-pinned) pinned)
    (= (. ([] params index) type) (?? type no-type))
    (let became-explicit (or (. ([] params index) is-explicit) resolved-explicit was-inferred))
    (= (. ([] params index) is-explicit) became-explicit)
    (return scope)
  )
  (fn-do + scope-link _
    (param scope MatchScope)
    (param name Atom)
    (param index U32)
    (let found (call scope-find scope name))
    (if found
      (= (. ([] params found) links) (/or/ (. ([] params found) links) (/lshift/ 1u64 index)))
    )
  )
  (fn-expr + scope-links U64
    (param scope MatchScope)
    (param name Atom)
    (case? found
      (. ([] params found) links)
    )
    (default
      0u64
    )
    (where
      (lazy found (call scope-find scope name))
    )
  )
  (fn-do + scope-clear-links _
    (param scope MatchScope)
    (param name Atom)
    (let found (call scope-find scope name))
    (if found
      (= (. ([] params found) links) 0u64)
    )
  )
  (fn-do + scope-set-assignment _
    (param scope MatchScope)
    (param name Atom)
    (param module ModuleId)
    (param syntax SyntaxId)
    (param is-specificity Bool)
    (param must-match Bool)
    (let found (call scope-find scope name))
    (if found
      (= (. ([] params found) syntax-module) module)
      (= (. ([] params found) assign-syntax) syntax)
      (= (. ([] params found) has-specificity) is-specificity)
      (= (. ([] params found) must-match) must-match)
    )
  )
  (fn-do + scope-set-default _
    (param scope MatchScope)
    (param name Atom)
    (param module ModuleId)
    (param syntax SyntaxId)
    (let found (call scope-find scope name))
    (if found
      (= (. ([] params found) syntax-module) module)
      (= (. ([] params found) default-syntax) syntax)
    )
  )
  (fn-do + scope-set-constraint _
    (param scope MatchScope)
    (param name Atom)
    (param module ModuleId)
    (param syntax SyntaxId)
    (param op Specificity)
    (let found (call scope-find scope name))
    (if found
      (= (. ([] params found) syntax-module) module)
      (= (. ([] params found) constraint-syntax) syntax)
      (= (. ([] params found) constraint-op) op)
    )
  )
  (fn-do + scope-env TypeEnv
    (param scope MatchScope)
    (param env TypeEnv)
    (let bound env)
    (for (in row ([] params (..< (. scope start) (. scope end))))
      (if (!= (. row type) no-type)
        (= bound (call (. types env-bind) bound (. row name) (. row type)))
      )
    )
    (return bound)
  )
  (fn-do + scope-evaluate (? TypeId)
    (param scope MatchScope)
    (param name Atom)
    (param env TypeEnv)
    (param default (? TypeId))
    (let found (call scope-find scope name))
    (if (not found)
      (return null)
    )
    (let index Index found)
    (let row ([] params index))
    (if (== (. row type) no-type)
      (return null)
    )
    (if (and default (not (call is-variable-row types (. row type))))
      (let relation (call compare (. row type) default false false scope))
      (if (not (call relation-legal relation))
        (return null)
      )
      (= (. row type) (. relation unified))
    )
    (let unbound (and (call is-variable-row types (. row type)) (not (. row is-explicit))))
    (let tree (. ([] (. program modules) (. row syntax-module)) tree))
    (if (and (!= (. row assign-syntax) 0) (. row must-match))
      (let assigned (call scope-assigned scope row env))
      (if (== (. assigned type) invalid-type)
        (return null)
      )
      (if unbound
        (= (. row type) (. assigned type))
        (else
          (let relation (call compare (. row type) (. assigned type) false false scope))
          (if (not (call validate-relation relation .exact))
            (return null)
          )
          (= (. row type) (. relation unified))
        )
      )
      (else-if (and (!= (. row assign-syntax) 0) unbound)
        (if default
          (= (. row type) default)
        )
        (let assigned (call scope-assigned scope row env))
        (if (== (. assigned type) invalid-type)
          (return null)
        )
        (= (. row type) (. assigned type))
        (if (. row has-specificity)
          (= (. row specificity) (. assigned match))
        )
      )
    )
    (= unbound (and (call is-variable-row types (. row type)) (not (. row is-explicit))))
    (if (and (!= (. row default-syntax) 0) unbound)
      (let bound (call scope-env scope env))
      (let caller Index (. row syntax-module))
      (let evaluated (call (. types evaluate-type) (as caller ModuleId) tree (. row default-syntax) bound))
      (call (. types env-truncate) env)
      (if (== evaluated invalid-type)
        (return null)
      )
      (= (. row type) evaluated)
      (else-if (and default unbound)
        (= (. row type) default)
      )
    )
    (= ([] params index) row)
    (return (. row type))
  )
  (fn-do _ scope-assigned Assigned
    (param scope MatchScope)
    (param row TypeParamMatch)
    (param env TypeEnv)
    (let bound (call scope-env scope env))
    (let tree (. ([] (. program modules) (. row syntax-module)) tree))
    (let assigned (call assignment-type (. row syntax-module) tree (. row assign-syntax) bound))
    (call (. types env-truncate) env)
    (return assigned)
  )
  (fn-expr + scope-defers Bool
    (param scope MatchScope)
    (param name Atom)
    (case? (not found)
      false
    )
    (case? (== (. row assign-syntax) 0)
      false
    )
    (case? (or (not (. row must-match)) (== (. row type) no-type))
      true
    )
    (default
      (and (call is-variable-row types (. row type)) (not (. row is-explicit)))
    )
    (where
      (lazy found (call scope-find scope name))
      (lazy row ([] params found))
    )
  )
  (fn-expr + scope-has-assignment Bool
    (param scope MatchScope)
    (param name Atom)
    (case? (not found)
      false
    )
    (default
      (!= (. ([] params found) assign-syntax) 0)
    )
    (where
      (lazy found (call scope-find scope name))
    )
  )
  (fn-do + scope-specificity Specificity
    (param scope MatchScope)
    (for (in row ([] params (..< (. scope start) (. scope end))))
      (if (. row has-specificity)
        (return (as (. row specificity) Specificity))
      )
    )
    (return .convertible)
  )
  (fn-do + scope-resolved Bool
    (param scope MatchScope)
    (for (in row ([] params (..< (. scope start) (. scope end))))
      (if (== (. row type) no-type)
        (return false)
      )
      (if (and (call is-variable-row types (. row type)) (not (. row is-explicit)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do + complete-against (? TypeId)
    (param to TypeId)
    (param from TypeId)
    (param scope MatchScope)
    (let closed (and (not (. ([] (. types completions) to) has-variables)) (not (call holds-alternatives to))))
    (if (or (and closed (!= (call (. types intrinsic-of) to) .or)) (== to from))
      (return to)
    )
    (match? ([] (. types rows) to)
      (case (call .type-variable row)
        (let found (call scope-find scope (. row name)))
        (if found
          (let param ([] params found))
          (if (and (. param is-pinned) (!= (. param type) no-type))
            (return (. param type))
          )
        )
        (let declared (call scope-declare scope (. row name) false from))
        (if (not declared)
          (return null)
        )
        (return from)
      )
      (case .type-inference
        (return (if-expr (. ([] (. types completions) from) has-variables) null from))
      )
      (case (call .type-tuple row)
        (return (call complete-tuple (. row fields) (. row names) from scope))
      )
      (case (call .type-class row)
        (if (and (== from (. types null-type)) (== (call (. types intrinsic-of) to) .optional))
          (return null)
        )
        (if (== (call (. types intrinsic-of) to) .or)
          (return (call complete-alternative to from scope))
        )
        (if (== (. ([] (. types completions) from) intrinsic) .closure)
          (call (. types complete) to)
          (let fitted (only-if (call fit-closure from to scope) (if (!= (call function-row types to) no-type))))
          (return (only-if (call complete-against to fitted scope) (if fitted)))
        )
        (if (== (. ([] (. types completions) from) intrinsic) .binding)
          (call (. types complete) to)
          (if (!= (call function-row types to) no-type)
            (let fitted (call fit-closure from to scope))
            (return (only-if (call complete-against to fitted scope) (if fitted)))
          )
        )
        (let matching (call member-class types from (. row module) (. row decl)))
        (if (== matching no-type)
          (= matching (call converted-class from (. row module) (. row decl)))
        )
        (if (and (== matching no-type) (call converts-from to from))
          (match? ([] (. types rows) from)
            (case (call .type-class other)
              (return (call complete-params (. row module) (. row decl) (. row args) (. other args) scope))
            )
          )
        )
        (if (== matching no-type)
          (return (call complete-shape to (. row module) (. row decl) (. row args) from scope))
        )
        (let actual (call (of RowRange TypeId)))
        (match? ([] (. types rows) matching)
          (case (call .type-class other)
            (= actual (. other args))
          )
        )
        (return (call complete-params (. row module) (. row decl) (. row args) actual scope))
      )
      (case (call .type-associated row)
        (return (call complete-associated (. row owner) (. row name) (. row args) from scope))
      )
    )
    (return null)
  )
  (fn-do _ complete-associated (? TypeId)
    (param owner TypeId)
    (param name Atom)
    (param args (of RowRange TypeId))
    (param from TypeId)
    (param scope MatchScope)
    ; An associated type of a parameter the call has bound is the type that binding gives it,
    ; whose own parameters the source then binds.
    (let variable (call variable-name types owner))
    (let bound (if-expr variable (?? (call scope-lookup scope variable) owner) owner))
    (if (or (not bound) (. ([] (. types completions) bound) has-variables))
      (return null)
    )
    (let mark (. types scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (call (. types scratch types push) (call (. types child-type) args offset))
    )
    (let resolved (call (. types resolve-associated) bound name mark (call (. types env-frame))))
    (if (== resolved invalid-type)
      (return null)
    )
    (return (call complete-against resolved from scope))
  )
  (fn-do + converted-class TypeId
    (param from TypeId)
    (param module ModuleId)
    (param decl DeclId)
    ; The type one of the source's converters gives when it is an instance of the wanted class.
    (let mark (. types scratch types mark))
    (call push-converters from null)
    (let count (/ (- (. types scratch types length) mark) converter-words))
    (let found no-type)
    (for (in offset (..< 0 count))
      (let base (+ mark (* offset converter-words)))
      (let target ([] (. types scratch types) base))
      (let ref (call class-decl-ref types target))
      (if (and (== (. ref module) module) (== (. ref decl) decl))
        (if (. ([] (. types completions) target) has-variables)
          (let converter-module U32 ([] (. types scratch types) (+ base 1)))
          (let converter U32 ([] (. types scratch types) (+ base 2)))
          (= target (call default-target converter-module converter ([] (. types scratch types) (+ base 3))))
        )
        (if (and (!= target invalid-type) (not (. ([] (. types completions) target) has-variables)))
          (= found target)
        )
      )
    )
    (call (. types scratch types rewind) mark)
    (return found)
  )
  (fn-do _ default-target TypeId
    (param module ModuleId)
    (param decl DeclId)
    (param owner TypeId)
    ; The type a converter to a generic type gives when nothing names that type's parameters:
    ; each takes the type its declaration assigns it.
    (let owner-module 0u32)
    (let owner-decl 0u32)
    (let owner-args (call (of RowRange TypeId)))
    (match? ([] (. types rows) owner)
      (case (call .type-class row)
        (= owner-module (. row module))
        (= owner-decl (. row decl))
        (= owner-args (. row args))
      )
    )
    (let decls (. ([] (. program modules) module) decls))
    (let tree (. ([] (. program modules) module) tree))
    (let target invalid-type)
    (match? ([] decls decl)
      (case (call .decl-converter row)
        (let env (call (. types env-frame)))
        (let extended false)
        (match? ([] decls (. row owner))
          (case .decl-extension
            (= extended true)
          )
        )
        (if extended
          (let matched (call match-extension module (. row owner) owner))
          (if (not matched)
            (return invalid-type)
          )
          (= env (. matched env))
          (else
            (= env (call (. types class-env-for) owner-module owner-decl owner-args owner))
          )
        )
        (= env (call (. types declare-into) env tree (. row target-type) module decl (. env end)))
        (for (in assignment ([] (. tree nodes) ([] (. tree children) (. row param-assignments))))
          (match? assignment
            (case (call .node-param-assignment arow)
              (let left (call (. types type-syntax-name) tree (. arow left)))
              (let assigned (call assignment-type module tree (. arow right) env))
              (if (and left (!= (. assigned type) invalid-type))
                (= env (call (. types env-bind) env left (. assigned type)))
              )
            )
          )
        )
        (= target (call (. types evaluate-type) module tree (. row target-type) env))
        (call (. types env-release) env)
      )
    )
    (return target)
  )
  (fn-do _ complete-shape (? TypeId)
    (param to TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param args (of RowRange TypeId))
    (param from TypeId)
    (param scope MatchScope)
    ; A generic class no base or interface of the source names: an optional takes its parameter
    ; from the value it would hold, and a tuple class takes its parameters field by field from an
    ; anonymous tuple. A parameter the class was named without is taken from the fields that hold
    ; it, joined as the types of a generic function's arguments are.
    (let optional (call (. types type-decl) .optional))
    (if (and (== module (. optional module)) (== decl (. optional decl)) (== (. args count) 1))
      (let inner (call complete-against (call (. types child-type) args 0) from scope))
      (return (only-if (call (. types optional-of) inner) (if inner)))
    )
    (let source (call (of RowRange TypeId)))
    (match? ([] (. types rows) from)
      (case (call .type-tuple other)
        (= source (. other fields))
      )
    )
    (let kind (call (. types intrinsic-of) to))
    (if (or (== (. source count) 0) (and (!= kind .tuple) (!= kind .struct)))
      (return null)
    )
    (let pairs (. types scratch types mark))
    (let position 0u32)
    (for (in field (call (. types properties-of) to))
      (if (== (. field storage-kind) .storage-eager)
        (if (or (>= position (. source count)) (== (. field type) no-type))
          (call (. types scratch types rewind) pairs)
          (return null)
        )
        (let completed (call complete-against (. field type) (call (. types child-type) source position) scope))
        (if (not completed)
          (call (. types scratch types rewind) pairs)
          (return null)
        )
        (let held (. types scratch types mark))
        (call bind-row types (. field type) completed held)
        (if (not (call join-pairs pairs held))
          (call (. types scratch types rewind) pairs)
          (return null)
        )
        (+= position 1)
      )
    )
    (if (!= position (. source count))
      (call (. types scratch types rewind) pairs)
      (return null)
    )
    (let mark (. types scratch types mark))
    (for (in offset (..< 0 (. args count)))
      (let arg (call (. types child-type) args offset))
      (let name (call variable-name types arg))
      (let bound
        (scope (if-expr name (?? (call scope-lookup scope name) (call paired types arg pairs mark)) partner)
          (lazy partner (call paired types arg pairs mark))
        )
      )
      (call (. types scratch types push) (?? bound arg))
    )
    (let completed (call (. types intern-class) module decl mark))
    (call (. types scratch types rewind) pairs)
    (return completed)
  )
  (fn-do _ join-pairs Bool
    (param mark ScratchMark)
    (param held ScratchMark)
    ; Joins the pairs `bind-row` pushed from `held` into those pushed from `mark` before: a
    ; pattern bound there takes the type its two types join to, as `joined-places` joins them, and a
    ; new one is kept. False where two types of one pattern do not join.
    (let pending (. types scratch types))
    (let end held)
    (let count (/ (- (. pending length) held) 2))
    (for (in offset (..< 0 count))
      (let pattern ([] pending (+ held (* offset 2))))
      (let actual ([] pending (+ held (* offset 2) 1)))
      (let found false)
      (for (in earlier (..< 0 (/ (- end mark) 2)))
        (let bound (+ mark (* earlier 2)))
        (if (== ([] pending bound) pattern)
          (= found true)
          (if (!= ([] pending (+ bound 1)) actual)
            (let joined (call joined-places ([] pending (+ bound 1)) actual))
            (if (== joined no-type)
              (return false)
            )
            (= ([] pending (+ bound 1)) joined)
          )
        )
      )
      (if (not found)
        (= ([] pending end) pattern)
        (= ([] pending (+ end 1)) actual)
        (+= end 2)
      )
    )
    (call (. pending rewind) end)
    (return true)
  )
  (fn-do _ complete-tuple (? TypeId)
    (param fields (of RowRange TypeId))
    (param names (of RowRange Atom))
    (param from TypeId)
    (param scope MatchScope)
    (let source (call (of RowRange TypeId)))
    (match? ([] (. types rows) from)
      (case (call .type-tuple other)
        (= source (. other fields))
      )
    )
    (if (or (!= (. source count) (. fields count)) (== (. fields count) 0))
      (return null)
    )
    (let mark (. types scratch types mark))
    (let names-mark (. types scratch names mark))
    (for (in offset (..< 0 (. fields count)))
      (let given (call (. types child-type) source offset))
      (let field (call complete-against (call (. types child-type) fields offset) given scope))
      (if (not field)
        (call (. types scratch types rewind) mark)
        (call (. types scratch names rewind) names-mark)
        (return null)
      )
      (call (. types scratch types push) field)
      (call (. types scratch names push) (call (. types child-name) names offset))
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ complete-alternative (? TypeId)
    (param to TypeId)
    (param from TypeId)
    (param scope MatchScope)
    (let alternatives (. ([] (. types completions) to) alternatives))
    (let plain (call unraised from))
    (let saved (list TypeParamMatch))
    (for (in row ([] params (..< (. scope start) (. scope end))))
      (+= saved row)
    )
    (let length (. params length))
    (let best no-type)
    (let best-rank 0i32)
    (let best-offset 0)
    (for (in offset (..< 0 (. alternatives count)))
      (let alternative (call (. types child-type) alternatives offset))
      (let relation (call compare plain alternative false false scope))
      (if (and (call relation-legal relation) (or (== best no-type) (< (. relation rank) best-rank)))
        (= best (. relation unified))
        (= best-rank (. relation rank))
        (= best-offset offset)
      )
      (call restore-scope scope saved length)
    )
    (if (== best no-type)
      (return null)
    )
    (let chosen (call (. types child-type) alternatives (as best-offset U32)))
    (call compare plain chosen false false scope)
    (return (if-expr (!= plain from) from best))
  )
  (fn-do _ unraised TypeId
    (param id TypeId)
    ; A class whose value raises errors of its own, as the generator of a function that yields
    ; and raises does, without them: the reference chooses among alternatives by that type, and
    ; the value keeps its own.
    (match? ([] (. types rows) id)
      (case (call .type-class row)
        (if (!= (. row errors count) 0)
          (let mark (. types scratch types mark))
          (for (in offset (..< 0 (. row args count)))
            (call (. types scratch types push) (call (. types child-type) (. row args) offset))
          )
          (return (call (. types intern-class) (. row module) (. row decl) mark))
        )
      )
    )
    (return id)
  )
  (fn-do _ restore-scope _
    (param scope MatchScope)
    (param saved (list TypeParamMatch))
    (param length Size)
    (call (. params truncate) length)
    (for (in offset (..< 0 (. saved length)))
      (= ([] params (+ (. scope start) offset)) ([] saved offset))
    )
  )
  (fn-do _ converts-from Bool
    (param to TypeId)
    (param from TypeId)
    ; A generic class that declares a conversion from the source takes its parameters from the
    ; source's own, in order.
    (call (. types complete) to)
    (return (!= (. (call fromverter-owner to from null) owner) no-type))
  )
  (fn-do _ complete-params (? TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param patterns (of RowRange TypeId))
    (param actuals (of RowRange TypeId))
    (param scope MatchScope)
    (if (!= (. patterns count) (. actuals count))
      (return null)
    )
    (let mark (. types scratch types mark))
    (for (in offset (..< 0 (. patterns count)))
      (let pattern (call (. types child-type) patterns offset))
      (let actual (call (. types child-type) actuals offset))
      (let chosen (? TypeId) null)
      (if (call is-variable-row types pattern)
        (let name (call variable-name types pattern))
        (if (and name (call scope-find scope name))
          (= chosen (call scope-evaluate scope name (call (. types env-frame)) actual))
          (else
            (= chosen actual)
          )
        )
        (if (and chosen (. ([] (. types completions) chosen) has-variables))
          (= chosen null)
        )
        (else-if (or (. ([] (. types completions) pattern) has-variables) (call holds-alternatives pattern))
          (= chosen (call complete-against pattern actual scope))
        )
        (else-if (== (call (. types intrinsic-of) pattern) .or)
          (= chosen (call complete-alternative pattern actual scope))
        )
        (else-if (call is-variable-row types actual)
          (= chosen pattern)
        )
        (else-if (== pattern actual)
          (= chosen pattern)
        )
      )
      (if (not chosen)
        (call (. types scratch types rewind) mark)
        (return null)
      )
      (call (. types scratch types push) chosen)
    )
    (return (call (. types intern-class) module decl mark))
  )
)
