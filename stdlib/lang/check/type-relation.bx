(import ./type-env)
(import ./type-signature)
(import ./type-store)
(import ./types)
(import /core/arena)
(import /core/map)
(import /core/scratch)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /stream/aggregate)
(blank)
(prop _ no-case U32 (= (. U32 max)))
(prop _ no-match _ (= (as (. U32 max) Specificity)))
(prop _ converter-words Size (= 4))
(prop _ unwrap-rank RelationRank (= 30))
(prop _ converter-rank RelationRank (= 90))
(prop _ final-rank RelationRank (= 140))

(fn-expr + relation-legal Bool
  (param relation Relation)
  (!= (. relation kind) .relation-illegal)
)

(fn-expr + validate-relation Bool
  (param relation Relation)
  (param required Specificity)
  (and (call relation-legal relation) (>= (. relation match) required))
)

(fn-expr + most-specific Relation
  (param first Relation)
  (param second Relation)
  (case? (not (call relation-legal second))
    first
  )
  (case? (not (call relation-legal first))
    second
  )
  (case? (< (. first rank) (. second rank))
    first
  )
  (default
    second
  )
)

(fn-expr + case-selection-rank I32
  (param types Types)
  (param relation Relation)
  (case? (== (. relation kind) .relation-side-cast)
    (+ 20 (call representation-distance types (. relation from) (. relation to)))
  )
  (default
    (. relation rank)
  )
)

(fn-expr _ representation-distance I32
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (case? (call crosses-bool types from to)
    3i32
  )
  (case? (or (not (call intrinsic-is-numeric from-type)) (not (call intrinsic-is-numeric to-type)))
    0i32
  )
  (case? (!= (call intrinsic-is-float from-type) (call intrinsic-is-float to-type))
    2i32
  )
  (case? (and (== (call intrinsic-bit-size from-type) (call intrinsic-bit-size to-type)) same-sign)
    0i32
  )
  (default
    1i32
  )
  (where
    (lazy from-type (. ([] (. types completions) from) intrinsic))
    (lazy to-type (. ([] (. types completions) to) intrinsic))
    (lazy same-sign (== (call intrinsic-is-signed from-type) (call intrinsic-is-signed to-type)))
  )
)

(fn-expr _ crosses-bool Bool
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (and (call is-number-like from-type) (call is-number-like to-type) (!= (== from-type .bool) (== to-type .bool)))
  (where
    (lazy from-type (. ([] (. types completions) from) intrinsic))
    (lazy to-type (. ([] (. types completions) to) intrinsic))
  )
)

(fn-expr _ is-number-like Bool
  (param type IntrinsicKind)
  (or (call intrinsic-is-numeric type) (== type .bool))
)

(fn-expr + up-cast-relation Relation
  (param from TypeId)
  (param to TypeId)
  ; How a class relates to a class known to be among its bases, with no walk to find it.
  (call make-relation .relation-up-cast from to to)
)

(fn-expr _ make-relation Relation
  (param kind RelationKind)
  (param from TypeId)
  (param to TypeId)
  (param unified TypeId)
  (call Relation kind rank match from to unified (. U32 max) no-type ratio .reason-none (. U32 max) 0)
  (where
    (lazy rank (call relation-rank kind))
    (lazy match (call relation-match kind))
    (lazy ratio (call no-ratio))
  )
)

(fn-expr _ illegal-relation Relation
  (param from TypeId)
  (param to TypeId)
  (param reason RelationReason)
  (call Relation .relation-illegal -1i32 .convertible from to to (. U32 max) no-type (call no-ratio) reason)
)

(fn-expr _ cache-key Size
  (param source TypeId)
  (param target TypeId)
  (param caller (? ModuleId))
  (/or/ (/lshift/ (as source Size) 40) (/lshift/ (as target Size) 16) (call caller-word caller))
)

(fn-expr _ caller-word Size
  (param caller (? ModuleId))
  (case? caller
    (+ caller 1)
  )
  (default
    0
  )
)

(fn-expr _ common-base TypeId
  (param types Types)
  (param candidate TypeId)
  (param to TypeId)
  (case? (call in-base-chain types to candidate)
    candidate
  )
  (case? base
    (call common-base types base to)
  )
  (default
    no-type
  )
  (where
    (lazy base (call (. types base-of) candidate))
  )
)

(fn-do _ common-interface TypeId
  (param types Types)
  (param root TypeId)
  (param id TypeId)
  (param to TypeId)
  (let program (. types program))
  (let completion (call (. types completion-of) id))
  (if (and (== (. completion intrinsic) .interface) (!= id root) (call interface-includes types to id))
    (return id)
  )
  (for (in interface ([] (. types children) (. completion interfaces)))
    (let found (call common-interface types root interface to))
    (if (!= found no-type)
      (return found)
    )
  )
  (return no-type)
)

(fn-do _ interface-includes Bool
  (param types Types)
  (param id TypeId)
  (param target TypeId)
  (let program (. types program))
  (let completion (call (. types completion-of) id))
  (if (and (== (. completion intrinsic) .interface) (== id target))
    (return true)
  )
  (for (in interface ([] (. types children) (. completion interfaces)))
    (if (call interface-includes types interface target)
      (return true)
    )
  )
  (return false)
)

(fn-expr + variable-index U32
  (param types Types)
  (param id TypeId)
  (match ([] (. types rows) id)
    (case (call .type-variable row)
      (. row index)
    )
    (default
      (. U32 max)
    )
  )
)

(fn-do _ member-type-in TypeId
  (param types Types)
  (param module ModuleId)
  (param member DeclId)
  (param syntax SyntaxId)
  (param env TypeEnv)
  (let program (. types program))
  (let tree (. ([] (. program modules) module) tree))
  (let bound (call (. types declare-into) env tree syntax module member (. env end)))
  (let type (call (. types evaluate-type) module tree syntax bound))
  (call (. types env-truncate) env)
  (return type)
)

(type + ConverterHit (is Tuple)
  (prop + specificity Specificity)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + collision RelationReason (= .reason-none))
  (prop + implicit Bool (= true))
)

(type + ParamResult (is Tuple)
  (prop + env TypeEnv)
  (prop + specificity Specificity)
  (prop + accepted Bool)
  (prop + implicit Bool (= true))
)

(type + ExtensionHit (is Tuple)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + receiver TypeId)
  (prop + env TypeEnv)
)

(fn-do _ params-resolved Bool
  (param types Types)
  (param env TypeEnv)
  (for (in position (..< (. env start) (. env end)))
    (let name (call (. types env-name) position))
    (let bound (call (. types env-lookup) env name))
    (if (and bound (call is-variable-row types bound))
      (return false)
    )
  )
  (return true)
)

(fn-do _ collect-member-chain _
  (param types Types)
  (param id TypeId)
  (param into (list TypeId))
  (let program (. types program))
  (let interfaces (call (. types interfaces-of) id))
  (+= into id)
  (let base (call (. types base-of) id))
  (if base
    (call collect-member-chain types base into)
  )
  (for (in interface interfaces)
    (call collect-member-chain types interface into)
  )
)

(fn-expr + required-match Specificity
  (param op TypeMatchOperator)
  (match op
    (case .match-similar
      .convertible
    )
    (case .match-exactly
      .exact
    )
    (default
      .similar
    )
  )
)

(fn-expr _ variable-name (? Atom)
  (param types Types)
  (param id TypeId)
  (match? ([] (. types rows) id)
    (case (call .type-variable row)
      (. row name)
    )
  )
)

(fn-do _ bind-row Bool
  (param types Types)
  (param pattern TypeId)
  (param actual TypeId)
  (param mark ScratchMark)
  (if (== pattern actual)
    (return true)
  )
  (match? ([] (. types rows) pattern)
    (case .type-inference
      (let count (/ (- (. types scratch types length) mark) 2))
      (for (in offset (..< 0 count))
        (if (== ([] (. types scratch types) (+ mark (* offset 2))) pattern)
          (return (== ([] (. types scratch types) (+ mark (* offset 2) 1)) actual))
        )
      )
      (call (. types scratch types push) pattern)
      (call (. types scratch types push) actual)
      (return true)
    )
    (case .type-variable
      (let count (/ (- (. types scratch types length) mark) 2))
      (for (in offset (..< 0 count))
        (if (== ([] (. types scratch types) (+ mark (* offset 2))) pattern)
          (return (== ([] (. types scratch types) (+ mark (* offset 2) 1)) actual))
        )
      )
      (call (. types scratch types push) pattern)
      (call (. types scratch types push) actual)
      (return true)
    )
    (case (call .type-class row)
      (match? ([] (. types rows) actual)
        (case (call .type-class other)
          (if (or (!= (. row module) (. other module)) (!= (. row decl) (. other decl)))
            (return false)
          )
          (return (call bind-ranges types (. row args) (. other args) mark))
        )
      )
      (return false)
    )
    (case (call .type-tuple row)
      (match? ([] (. types rows) actual)
        (case (call .type-tuple other)
          (if (not (call same-names types (. row names) (. other names)))
            (return false)
          )
          (return (call bind-ranges types (. row fields) (. other fields) mark))
        )
      )
      (return false)
    )
    (case (call .type-struct row)
      (match? ([] (. types rows) actual)
        (case (call .type-struct other)
          (if (not (call same-names types (. row names) (. other names)))
            (return false)
          )
          (return (call bind-ranges types (. row fields) (. other fields) mark))
        )
      )
      (return false)
    )
    (case (call .type-function row)
      (match? ([] (. types rows) actual)
        (case (call .type-function other)
          (if (!= (. row is-c) (. other is-c))
            (return false)
          )
          (if (not (call bind-row types (. row return-type) (. other return-type) mark))
            (return false)
          )
          (if (not (call bind-ranges types (. row args) (. other args) mark))
            (return false)
          )
          (return (call bind-ranges types (. row errors) (. other errors) mark))
        )
      )
      (return false)
    )
    (case (call .type-union row)
      (match? ([] (. types rows) actual)
        (case (call .type-union other)
          (return (call bind-ranges types (. row cases) (. other cases) mark))
        )
      )
      (return false)
    )
    (case (call .type-result row)
      (match? ([] (. types rows) actual)
        (case (call .type-result other)
          (if (not (call bind-row types (. row value) (. other value) mark))
            (return false)
          )
          (return (call bind-ranges types (. row errors) (. other errors) mark))
        )
      )
      (return false)
    )
  )
  (return false)
)

(fn-do _ paired (? TypeId)
  (param types Types)
  (param pattern TypeId)
  (param mark ScratchMark)
  (param end ScratchMark)
  ; The type `bind-row` bound a pattern to, among the pairs it pushed from `mark` to `end`.
  (let count (/ (- end mark) 2))
  (for (in offset (..< 0 count))
    (if (== ([] (. types scratch types) (+ mark (* offset 2))) pattern)
      (return ([] (. types scratch types) (+ mark (* offset 2) 1)))
    )
  )
  (return null)
)

(fn-do _ bind-ranges Bool
  (param types Types)
  (param patterns (of RowRange TypeId))
  (param actuals (of RowRange TypeId))
  (param mark ScratchMark)
  (if (!= (. patterns count) (. actuals count))
    (return false)
  )
  (for (in offset (..< 0 (. patterns count)))
    (let pattern (call (. types child-type) patterns offset))
    (let actual (call (. types child-type) actuals offset))
    (if (not (call bind-row types pattern actual mark))
      (return false)
    )
  )
  (return true)
)

(fn-do _ same-names Bool
  (param types Types)
  (param left (of RowRange TypeId))
  (param right (of RowRange TypeId))
  (if (!= (. left count) (. right count))
    (return false)
  )
  (for (in offset (..< 0 (. left count)))
    (if (!= (call (. types child-name) left offset) (call (. types child-name) right offset))
      (return false)
    )
  )
  (return true)
)

(type + FromverterHit (is Tuple)
  (prop + owner TypeId)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + collision RelationReason (= .reason-none))
)

(fn-do _ lookup-equality UnitRatio
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (let mark (. types scratch types mark))
  (call (. types scratch types push) from)
  (let ratio (call find-equality types from to (call UnitRatio 1.0 1.0) mark))
  (call (. types scratch types rewind) mark)
  (return ratio)
)

(fn-do _ find-equality UnitRatio
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (param ratio UnitRatio)
  (param mark ScratchMark)
  (for (in fact (. types equalities))
    (if (== (. fact from) from)
      (let multiplier (* (. ratio multiplier) (. fact ratio multiplier)))
      (let divisor (* (. ratio divisor) (. fact ratio divisor)))
      (let this-ratio (call UnitRatio multiplier divisor))
      (if (== (. fact to) to)
        (return this-ratio)
      )
      (if (not (call on-path types mark (. fact to)))
        (let depth (. types scratch types mark))
        (call (. types scratch types push) (. fact to))
        (let deep (call find-equality types (. fact to) to this-ratio mark))
        (call (. types scratch types rewind) depth)
        (if (not (. deep is-none))
          (return deep)
        )
      )
    )
  )
  (return (call no-ratio))
)

(fn-do _ on-path Bool
  (param types Types)
  (param mark ScratchMark)
  (param id TypeId)
  (for (in position (..< mark (. types scratch types length)))
    (if (== ([] (. types scratch types) position) id)
      (return true)
    )
  )
  (return false)
)

(fn-expr _ pointer-accepts Bool
  (param type IntrinsicKind)
  (case? (call intrinsic-is-numeric type)
    true
  )
  (case? (call intrinsic-is-class type)
    true
  )
  (case? (== type .cfunction)
    true
  )
  (case? (== type .capture)
    true
  )
  (case? (== type .string)
    true
  )
  (case? (== type .interface)
    true
  )
  (default
    false
  )
)

(fn-expr _ side-cast-tiebreak I32
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (case? (== from-type .cpointer)
    (if-expr (and (call intrinsic-is-numeric to-type) (!= to-type .cpointer)) 1i32 0i32)
  )
  (case? (and (call is-integer-type from-type) (call intrinsic-is-float to-type))
    -1i32
  )
  (case? (and (call is-integer-type from-type) (== to-type .cpointer))
    1i32
  )
  (case? (and (call intrinsic-is-float from-type) (call is-integer-type to-type))
    1i32
  )
  (default
    0i32
  )
  (where
    (lazy from-type (. ([] (. types completions) from) intrinsic))
    (lazy to-type (. ([] (. types completions) to) intrinsic))
  )
)

(fn-expr _ is-integer-type Bool
  (param type IntrinsicKind)
  (and (call intrinsic-is-numeric type) (not (call intrinsic-is-float type)) (!= type .number))
)

(fn-expr _ usable-wrap Bool
  (param types Types)
  (param relation Relation)
  (case? (not (call relation-legal relation))
    false
  )
  (case? (< (. relation rank) unwrap-rank)
    true
  )
  (case? (and (== (. relation rank) converter-rank) (>= (. relation match) 1u32))
    true
  )
  (default
    (and (== (. relation rank) final-rank) (!= (. ([] (. types completions) (. relation to)) intrinsic) .bool))
  )
)

(fn-do _ push-cases Bool
  (param types Types)
  (param union TypeId)
  (param unnamed Bool (= false))
  ; Pushes the type and the place of each case of a union that is not its default, or with
  ; `unnamed` of each that has no name, and answers whether the union has a default.
  (let completion ([] (. types completions) union))
  (let index 0u32)
  (let has-default false)
  (for (in fact ([] (. types cases) (. completion cases)))
    (if (. fact is-default)
      (= has-default true)
      (else-if (or (not unnamed) (not (. fact name)))
        (call (. types scratch types push) (. fact type))
        (call (. types scratch types push) index)
      )
    )
    (+= index 1)
  )
  (return has-default)
)

(fn-expr _ generator-item TypeId
  (param types Types)
  (param from TypeId)
  (case? (and (== (. ref module) (. types generator-decl module)) (== (. ref decl) (. types generator-decl decl)))
    (call class-arg types from 0)
  )
  (default
    no-type
  )
  (where
    (lazy ref (call class-ref types from))
  )
)

(fn-expr _ list-item TypeId
  (param types Types)
  (param id TypeId)
  (case? (and (== (. ref module) (. types list-decl module)) (== (. ref decl) (. types list-decl decl)))
    (call class-arg types id 0)
  )
  (default
    no-type
  )
  (where
    (lazy ref (call class-decl-ref types id))
  )
)

(fn-do + in-base-chain Bool
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  ; Whether a type is another or a class below it, completing the type, which completes the classes
  ; above it.
  (if (== from to)
    (return true)
  )
  (if (or (== from no-type) (== from invalid-type))
    (return false)
  )
  (call (. types complete) from)
  (let base (call (. types base-of) from))
  (while base
    (if (== base to)
      (return true)
    )
    (= base (call (. types base-of) base))
  )
  (return false)
)

(fn-do _ has-interface Bool
  (param types Types)
  (param id TypeId)
  (param target TypeId)
  (let program (. types program))
  (for (in interface (call (. types interfaces-of) id))
    (if (or (== interface target) (call has-interface types interface target))
      (return true)
    )
  )
  (let base (call (. types base-of) id))
  (if base
    (return (call has-interface types base target))
  )
  (return false)
)

(fn-do _ case-present Bool
  (param types Types)
  (param union TypeId)
  (param target TypeId)
  (let completion ([] (. types completions) union))
  (for (in fact ([] (. types cases) (. completion cases)))
    (if (and (not (. fact is-default)) (== (. fact type) target))
      (return true)
    )
  )
  (return false)
)

(fn-do + push-fields _
  (param types Types)
  (param id TypeId)
  (match? ([] (. types rows) id)
    (case (call .type-tuple row)
      (for (in offset (..< 0 (. row fields count)))
        (call (. types scratch types push) (call (. types child-type) (. row fields) offset))
      )
      (return)
    )
    (case (call .type-struct row)
      (for (in offset (..< 0 (. row fields count)))
        (call (. types scratch types push) (call (. types child-type) (. row fields) offset))
      )
      (return)
    )
  )
  (let completion ([] (. types completions) id))
  (for (in fact ([] (. types properties) (. completion properties)))
    (if (!= (. fact storage-kind) .storage-getter)
      (call (. types scratch types push) (. fact type))
    )
  )
)

(fn-expr _ is-anonymous-fields Bool
  (param types Types)
  (param id TypeId)
  (match ([] (. types rows) id)
    (case .type-tuple
      true
    )
    (case .type-struct
      true
    )
    (default
      false
    )
  )
)

(fn-expr _ unify-wider TypeId
  (param types Types)
  (param a TypeId)
  (param b TypeId)
  (case? (call is-integer-type a-type)
    (case? (call intrinsic-is-numeric b-type)
      (case? (call intrinsic-is-float b-type)
        (call base-unify types b a)
      )
      (case? (> (. ([] (. types completions) b) bit-size) (. ([] (. types completions) a) bit-size))
        (call base-unify types b a)
      )
      (default
        a
      )
    )
    (default
      b
    )
  )
  (case? (call intrinsic-is-float a-type)
    (case? (call intrinsic-is-numeric b-type)
      (match a-type
        (case= .float32
          (match b-type
            (case= .float32
              (call base-unify types a b)
            )
            (default
              (. types f64-type)
            )
          )
        )
        (default
          (call base-unify types a b)
        )
      )
    )
    (default
      b
    )
  )
  (default
    (call base-unify types a b)
  )
  (where
    (lazy a-type (. ([] (. types completions) a) intrinsic))
    (lazy b-type (. ([] (. types completions) b) intrinsic))
  )
)

(fn-expr _ base-unify TypeId
  (param types Types)
  (param a TypeId)
  (param b TypeId)
  (case? (call in-base-chain types a b)
    b
  )
  (default
    a
  )
)

(fn-expr + is-variable-row Bool
  (param types Types)
  (param id TypeId)
  (match ([] (. types rows) id)
    (case .type-variable
      true
    )
    (default
      false
    )
  )
)

(fn-do + pointee-of TypeId
  (param types Types)
  (param id TypeId)
  ; What a pointer class leads to: what its base leads to when the base is a pointer, or else
  ; its own first argument.
  (let current id)
  (while true
    (let base (call (. types base-of) current))
    (if (not base)
      (return (call class-arg types current 0))
    )
    (if (!= (. (call (. types completion-of) base) intrinsic) .cpointer)
      (return (call class-arg types current 0))
    )
    (= current base)
  )
)

(fn-do + should-delay-compare Bool
  (param types Types)
  (param arg TypeId)
  (param expected TypeId)
  (if (not (. ([] (. types completions) expected) has-variables))
    (return false)
  )
  (let arg-type (. ([] (. types completions) arg) intrinsic))
  (match? ([] (. types rows) expected)
    (case .type-associated
      (return true)
    )
  )
  (return (or (== arg-type .function) (== arg-type .closure) (== arg-type .binding)))
)

(fn-do _ member-class TypeId
  (param types Types)
  (param id TypeId)
  (param module ModuleId)
  (param decl DeclId)
  (let program (. types program))
  (call (. types complete) id)
  (let ref (call class-decl-ref types id))
  (if (and (== (. ref module) module) (== (. ref decl) decl))
    (return id)
  )
  (let base (call (. types base-of) id))
  (if base
    (let found (call member-class types base module decl))
    (if (!= found no-type)
      (return found)
    )
  )
  (let interfaces (. ([] (. types completions) id) interfaces))
  (for (in offset (..< 0 (. interfaces count)))
    (let found (call member-class types (call (. types child-type) interfaces offset) module decl))
    (if (!= found no-type)
      (return found)
    )
  )
  (return no-type)
)

(fn-expr _ class-decl-ref DeclRef
  (param types Types)
  (param id TypeId)
  (match ([] (. types rows) id)
    (case (call .type-class row)
      (call DeclRef (. row module) (. row decl))
    )
    (default
      (call DeclRef (. U32 max) (. U32 max))
    )
  )
)

(type + CallableFitter (is Interface)
  (fn-expr + fit-callable (? TypeId)
    (param given TypeId)
    (param expected TypeId)
    (param scope (? MatchScope))
  )
)

(type + Relations
  (prop + types Types)
  (prop + program Program)
  (prop + params (of Table TypeParamMatch))
  (prop + callables (? CallableFitter) (= null))
  (prop + asking Bool)
  (prop _ memo (of Table Relation))
  (prop _ compare-cache (of Map Size U32 ArenaBacking))
  (prop _ unify-cache (of Map Size U32 ArenaBacking))
  (prop _ extension-uses Size (= 0))
  (prop _ callable-uses Size (= 0))
  (prop _ alternatives (of List U8 ArenaBacking))
  (prop _ arena Arena)
  (fn-do + This _
    (param types Types)
    (lazy program (. types program))
    (lazy params (call (of Table TypeParamMatch) arena 16))
    (lazy memo (call (of Table Relation) arena 16))
    (lazy compare-cache (call (of Map Size U32) arena))
    (lazy unify-cache (call (of Map Size U32) arena))
    (lazy alternatives (call (of List U8) arena))
  )
  (fn-do + release _
    (call (. arena release))
  )
  (fn-expr + holds-as Bool
    (param relation Relation)
    (param required Specificity)
    (param of-types Bool (= false))
    (case? (not (call relation-legal relation))
      false
    )
    (case? (== required .convertible)
      true
    )
    (case? (== required .exact)
      (call exactly relation of-types)
    )
    (default
      (call kin relation)
    )
  )
  (fn-expr _ kin Bool
    (param relation Relation)
    (match (. relation kind)
      (case= .relation-same
        true
      )
      (case= .relation-or-cast
        true
      )
      (case= .relation-up-cast
        true
      )
      (case= .relation-down-cast
        true
      )
      (case= .relation-interface-cast
        true
      )
      (case= .relation-interface-down-cast
        true
      )
      (case= .relation-side-cast
        (call side-kin (. relation from) (. relation to))
      )
      (case= .relation-wrap-cast
        (call wraps-kin (. relation from) (. relation to))
      )
      (case= .relation-unwrap-cast
        (call unwraps-as relation false)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ exactly Bool
    (param relation Relation)
    (param of-types Bool (= false))
    (match (. relation kind)
      (case= .relation-same
        true
      )
      (case= .relation-or-cast
        true
      )
      (case= .relation-down-cast
        (not of-types)
      )
      (case= .relation-interface-down-cast
        (not of-types)
      )
      (case= .relation-unwrap-cast
        (call unwraps-as relation true)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ side-kin Bool
    (param from TypeId)
    (param to TypeId)
    (case? (!= (. ([] (. types completions) to) intrinsic) .optional)
      (call in-base-chain types from to)
    )
    (case? (== from (. types null-type))
      true
    )
    (case? (== inner no-type)
      false
    )
    (default
      (and (!= given no-type) (call holds-as (call compare given inner) .similar))
    )
    (where
      (lazy inner (call optional-item to))
      (lazy given (if-expr (== (. ([] (. types completions) from) intrinsic) .optional) (call optional-item from) from))
    )
  )
  (fn-do _ wraps-kin Bool
    (param from TypeId)
    (param to TypeId)
    (for (in fact (call (. types cases-of) to))
      (if (and typed-case (call holds-as (call compare from (. fact type)) .similar))
        (return true)
      )
      (lazy typed-case (and (!= (. fact type) no-type) (!= (. fact type) invalid-type)))
    )
    (return false)
  )
  (fn-do _ unwraps-as Bool
    (param relation Relation)
    (param exact Bool)
    (let required (if-expr exact (. Specificity exact) (. Specificity similar)))
    (let from-type (. ([] (. types completions) (. relation from)) intrinsic))
    (if (== from-type .optional)
      (let inner (call optional-item (. relation from)))
      (return (and (!= inner no-type) (call holds-as (call compare inner (. relation to)) required)))
    )
    (if (== from-type .union)
      (let cases (call (. types cases-of) (. relation from)))
      (if (>= (. relation case-index) (. cases length))
        (return false)
      )
      (let held (. ([] cases (. relation case-index)) type))
      (return (and (!= held no-type) (call holds-as (call compare held (. relation to)) required)))
    )
    (return true)
  )
  (fn-do + implicit Bool
    (param relation Relation)
    (param texts Bool (= false))
    (if (or (not (call relation-legal relation)) (. relation explicit))
      (return false)
    )
    (let from (. ([] (. types completions) (. relation from)) intrinsic))
    (let to (. ([] (. types completions) (. relation to)) intrinsic))
    (let kind (. relation kind))
    (let converts
      (scope (or (== kind .relation-converter) (== kind .relation-fromverter) common-kind)
        (lazy common-kind (== kind .relation-common-converter))
      )
    )
    (if (and (== to .string) (!= from .string) (or converts (== kind .relation-string-cast) unwraps))
      (return texts)
    )
    (lazy unwraps (== kind .relation-unwrap-cast))
    (if (and (== from .optional) (== to .bool))
      (let inner (call optional-item (. relation from)))
      (return (and (!= inner no-type) (!= (. ([] (. types completions) inner) intrinsic) .bool)))
    )
    (if (and (== from .optional) (!= to .optional) (!= kind .relation-same))
      (return (call widens-optional relation texts))
    )
    (return
      (match kind
        (case= .relation-unwrap-cast
          (!= from .union)
        )
        (case= .relation-down-cast
          false
        )
        (case= .relation-interface-down-cast
          false
        )
        (case= .relation-string-cast
          (or texts (== from .string))
        )
        (case= .relation-final-cast
          (and (!= to .bool) (call fields-implicit (. relation from) (. relation to) texts))
        )
        (case= .relation-side-cast
          (call side-implicit (. relation from) (. relation to) texts)
        )
        (case= .relation-wrap-cast
          (call wraps-implicit relation texts)
        )
        (case= .relation-fromverter
          (and (or has-converter enumless) (call fields-implicit (. relation from) (. relation to) texts))
          (lazy has-converter (!= (. relation converter-module) (. U32 max)))
          (lazy enumless (not (. ([] (. types completions) (. relation to)) has-enums)))
        )
        (default
          true
        )
      )
    )
  )
  (fn-expr _ widens-optional Bool
    (param relation Relation)
    (param texts Bool (= false))
    (case? (or (!= (. relation kind) .relation-unwrap-cast) (!= (. ([] (. types completions) (. relation from)) intrinsic) .optional))
      false
    )
    (case? (== (call (. types null-case) (. relation to)) (. U32 max))
      false
    )
    (default
      (and (!= inner no-type) (call implicit (call compare inner (. relation to)) texts))
    )
    (where
      (lazy inner (call optional-item (. relation from)))
    )
  )
  (fn-do _ fields-implicit Bool
    (param from TypeId)
    (param to TypeId)
    (param texts Bool)
    ; Whether each field of a tuple written with no name converts unasked to the field at its place
    ; in the tuple it becomes.
    (if (or (not (call is-anonymous-fields types from)) (not (call intrinsic-is-tuple-like (. ([] (. types completions) to) intrinsic))))
      (return true)
    )
    (let from-mark (. types scratch types mark))
    (call push-fields types from)
    (let to-mark (. types scratch types mark))
    (call push-fields types to)
    (let count (- to-mark from-mark))
    (let fits true)
    (if (== (- (. types scratch types length) to-mark) count)
      (for (in offset (..< 0 count))
        (let field ([] (. types scratch types) (+ from-mark offset)))
        (let target ([] (. types scratch types) (+ to-mark offset)))
        (if (and fits (!= field no-type) (!= target no-type) (not (call implicit (call compare field target) texts)))
          (= fits false)
        )
      )
    )
    (call (. types scratch types rewind) from-mark)
    (return fits)
  )
  (fn-expr _ pointer-implicit Bool
    (param from TypeId)
    (param to TypeId)
    (param from-type IntrinsicKind)
    ; Whether a value becomes a pointer unasked: `null`; a pointer to the same type, a pointer to or
    ; from `Void`, or a pointer to bytes as a pointer to other bytes; a text as a pointer to its
    ; bytes; and an object, an interface, a union of objects or a function only as a pointer to
    ; `Void`. A number, a `Bool` or a `Char` becomes a pointer only when asked, as an address is no
    ; count.
    (case? (== from (. types null-type))
      true
    )
    (case? (== from-type .cpointer)
      (or (== held pointee) opaque (== held (. types void-type)) (and (call bytes held) (call bytes pointee)))
    )
    (case? (== from-type .string)
      (or opaque (call bytes pointee))
    )
    (default
      (and (not (call intrinsic-is-numeric from-type)) opaque)
    )
    (where
      (lazy pointee (call pointee-of types to))
      (lazy opaque (== pointee (. types void-type)))
      (lazy held (call pointee-of types from))
    )
  )
  (fn-expr _ bytes Bool
    (param type TypeId)
    ; Whether a pointer that leads to a type leads to bytes: a `Char8`, an `I8` or a `U8`.
    (or (== type (. types char8-type)) (== kind .int8) (== kind .uint8))
    (where
      (lazy kind (. (call (. types completion-of) type) intrinsic))
    )
  )
  (fn-do _ side-implicit Bool
    (param from TypeId)
    (param to TypeId)
    (param texts Bool)
    ; Whether a side cast is made unasked. A value becomes a pointer only as `pointer-implicit` says,
    ; and a function a value of another function type only as `calls-implicit` says.
    (let from-type (. ([] (. types completions) from) intrinsic))
    (let to-type (. ([] (. types completions) to) intrinsic))
    (if (== to-type .optional)
      (if (== from (. types null-type))
        (return true)
      )
      (let inner (call optional-item to))
      (let given (if-expr (== from-type .optional) (call optional-item from) from))
      (return (and (!= inner no-type) (!= given no-type) (call implicit (call compare given inner) texts)))
    )
    (if (. ([] (. types completions) to) has-enums)
      (return false)
    )
    (if (== to-type .bool)
      (return (== from-type .bool))
    )
    (if (== to-type .cpointer)
      (return (call pointer-implicit from to from-type))
    )
    (if (and (or (== to-type .function) (== to-type .cfunction)) from-callable)
      (return (call calls-implicit (call function-row types from) (call function-row types to) texts))
    )
    (lazy from-callable (or (== from-type .function) (== from-type .cfunction)))
    (if (or (== from-type .cpointer) (not (call intrinsic-is-numeric to-type)) (not (call intrinsic-is-numeric from-type)))
      (return true)
    )
    (if (or (== from-type .bool) (!= (== from-type .char) (== to-type .char)))
      (return false)
    )
    (return (call holds-every from to))
  )
  (fn-expr _ holds-every Bool
    (param from TypeId)
    (param to TypeId)
    ; Whether every value of one number type is a value of another: an integer of one as wide or
    ; wider that shares its sign, or wider and signed, an integer as a float whose significand holds
    ; each of its values exactly, so an `I32` as an `F64` but an `I64` only when asked, and a float as
    ; one as wide or wider.
    (case? (call intrinsic-is-float (. left intrinsic))
      (and (call intrinsic-is-float (. right intrinsic)) (>= (. right bit-size) (. left bit-size)))
    )
    (case? (call intrinsic-is-float (. right intrinsic))
      (>= significand (if-expr (. left is-signed) (- (. left bit-size) 1) (. left bit-size)))
    )
    (case? (== (. left is-signed) (. right is-signed))
      (>= (. right bit-size) (. left bit-size))
    )
    (default
      (and (. right is-signed) (> (. right bit-size) (. left bit-size)))
    )
    (where
      (lazy left ([] (. types completions) from))
      (lazy right ([] (. types completions) to))
      (lazy significand (call significand-bits (. right bit-size)))
    )
  )
  (fn-expr _ significand-bits U32
    (param bit-size U32)
    ; How many bits of an integer a float of a width holds exactly: its significand's.
    (match bit-size
      (case= 16
        11
      )
      (case= 32
        24
      )
      (case= 64
        53
      )
      (default
        113
      )
    )
  )
  (fn-expr _ wraps-implicit Bool
    (param relation Relation)
    (param texts Bool)
    (case? (>= (. relation case-index) (. cases length))
      true
    )
    (default
      (or (== held no-type) (== held (. relation from)) (call implicit (call compare (. relation from) held) texts))
    )
    (where
      (lazy cases (call (. types cases-of) (. relation to)))
      (lazy held (. ([] cases (. relation case-index)) type))
    )
  )
  (fn-expr + implicitly Relation
    (param relation Relation)
    (param texts Bool (= false))
    (if-expr (call implicit relation texts) relation illegal)
    (where
      (lazy illegal (call illegal-relation (. relation from) (. relation to) .reason-illegal-cast))
    )
  )
  (fn-do + joined-places TypeId
    (param one TypeId)
    (param other TypeId)
    ; What two types of values written as numbers with no suffix join to place by place: what they
    ; unify to, the float where one is an integer and the other a float, or the tuple of what their
    ; places join to. None where they do not join.
    (let relation (call unify one other))
    (return-if (. relation unified) (if (call relation-legal relation)))
    (blank)
    (let left (. ([] (. types completions) one) intrinsic))
    (let right (. ([] (. types completions) other) intrinsic))
    (return-if other (if (and (call intrinsic-is-float right) (call is-integer-type left))))
    (return-if one (if (and (call intrinsic-is-float left) (call is-integer-type right))))
    (blank)
    (let ones (call (of RowRange TypeId)))
    (let names (call (of RowRange Atom)))
    (let others (call (of RowRange TypeId)))
    (match? ([] (. types rows) one)
      (case (call .type-tuple row)
        (= ones (. row fields))
        (= names (. row names))
      )
    )
    (match? ([] (. types rows) other)
      (case (call .type-tuple row)
        (= others (. row fields))
      )
    )
    (return-if no-type (if (or (== (. ones count) 0) (!= (. ones count) (. others count)))))
    (blank)
    (let mark (. types scratch types mark))
    (let names-mark (. types scratch names mark))
    (for (in offset (..< 0 (. ones count)))
      (let place (call joined-places (call (. types child-type) ones offset) (call (. types child-type) others offset)))
      (if (== place no-type)
        (call (. types scratch types rewind) mark)
        (call (. types scratch names rewind) names-mark)
        (return no-type)
      )
      (call (. types scratch types push) place)
      (call (. types scratch names push) (call (. types child-name) names offset))
    )
    (let joined (call (. types intern-tuple) mark names-mark))
    (call (. types scratch types rewind) mark)
    (call (. types scratch names rewind) names-mark)
    (return joined)
  )
  (fn-do + compare-explicit Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId) (= null))
    ; The relation `as` casts by: the one `compare` gives, or between two named tuples of one class
    ; whose fields cast only so, as a pointer at another item type does, the cast of each field. A
    ; closure is fitted to a function type it is cast to as `asking` says.
    (let asked asking)
    (= asking true)
    (let relation (call compare from to false false null caller))
    (= asking asked)
    (if (call relation-legal relation)
      (return relation)
    )
    (if (call reads-text-as-number from to)
      (return (call declared-relation from to caller))
    )
    (let to-type (. ([] (. types completions) to) intrinsic))
    (if (or (not (call intrinsic-is-tuple-like to-type)) (call is-array-view to))
      (return relation)
    )
    (if (or (call is-anonymous-fields types from) anonymous-to (not (call same-class types from to)))
      (return relation)
    )
    (lazy anonymous-to (call is-anonymous-fields types to))
    (return (call make-relation .relation-final-cast from to to))
  )
  (fn-expr + compare-pattern Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId) (= null))
    (case? (or (call relation-legal relation) (not (call class-may-be from to)))
      relation
    )
    (default
      (call make-relation .relation-interface-down-cast from to to)
    )
    (where
      (lazy relation (call compare from to false false null caller))
    )
  )
  (fn-do + compare Relation
    (param from TypeId)
    (param to TypeId)
    (param for-unify Bool (= false))
    (param raw Bool (= false))
    (param scope (? MatchScope) (= null))
    (param caller (? ModuleId) (= null))
    (let source from)
    (if (call is-variable-row types from)
      (= source to)
    )
    (let target to)
    (let open (or (. ([] (. types completions) target) has-variables) (call holds-alternatives target)))
    (if (and (not raw) open (!= source target))
      (let completed (call complete-target target source scope))
      (if completed
        (= target completed)
      )
    )
    (if (== source target)
      (return (call make-relation .relation-same source target target))
    )
    (let generic (or (. ([] (. types completions) source) has-variables) (. ([] (. types completions) target) has-variables)))
    (let cacheable (or (not scope) (not generic)))
    (let key (call cache-key source target caller))
    (let cached (? U32) null)
    (if cacheable
      (if for-unify
        (= cached ([] unify-cache key))
        (else
          (= cached ([] compare-cache key))
        )
      )
    )
    (if cached
      (return ([] memo cached))
    )
    (let uses-before extension-uses)
    (let fits-before callable-uses)
    (let relation (call relate source target for-unify raw scope caller))
    (if (and cacheable (or (not caller) (== extension-uses uses-before)) (== callable-uses fits-before))
      (let position U32 (as (. memo length) U32))
      (call (. memo append) relation)
      (if for-unify
        (= ([] unify-cache key) position)
        (else
          (= ([] compare-cache key) position)
        )
      )
    )
    (return relation)
  )
  (fn-do + holds-alternatives Bool
    (param id TypeId)
    ; Whether a class names a type of alternatives among its parameters, or a tuple among its
    ; fields, at any depth: a value of it holds the alternative its source chooses, never the
    ; alternatives themselves.
    (while (<= (. alternatives length) id)
      (+= alternatives 0)
    )
    (let known ([] alternatives id))
    (if (!= known 0)
      (return (== known 2))
    )
    (let holds false)
    (let inner (call (of RowRange TypeId)))
    (match? ([] (. types rows) id)
      (case (call .type-class row)
        (= inner (. row args))
      )
      (case (call .type-tuple row)
        (= inner (. row fields))
      )
    )
    (for (in offset (..< 0 (. inner count)))
      (let arg (call (. types child-type) inner offset))
      (if (and (!= arg id) (or (== (call (. types intrinsic-of) arg) .or) (call holds-alternatives arg)))
        (= holds true)
      )
    )
    (= ([] alternatives id) (if-expr holds 2u8 1u8))
    (return holds)
  )
  (fn-do + complete-from (? TypeId)
    (param target TypeId)
    (param source TypeId)
    ; A type with parameters left open completed from a value of another type, as a comparison
    ; completes it, or nothing where the value does not complete it.
    (return (call complete-target target source null))
  )
  (fn-do _ complete-target (? TypeId)
    (param target TypeId)
    (param source TypeId)
    (param scope (? MatchScope))
    (if scope
      (return (call complete-against target source scope))
    )
    (let opened (call scope-open))
    (let completed (call complete-against target source opened))
    (call scope-release opened)
    (return completed)
  )
  (fn-do + unify Relation
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId) (= null))
    (let ltr (call implicitly (call compare from to true false null caller)))
    (let rtl (call implicitly (call compare to from true false null caller)))
    (if (and (not (call relation-legal ltr)) (not (call relation-legal rtl)))
      (let optioned (call unify-optioned from to caller))
      (if optioned
        (return optioned)
      )
      (let fielded (call unify-tuples from to caller))
      (if fielded
        (return fielded)
      )
    )
    (if (== (. ltr rank) (. rtl rank))
      (let wider (call unify-wider types from to))
      (return (if-expr (== wider from) rtl ltr))
    )
    (let left (call has-type from to))
    (let right (call has-type to from))
    (if (and left (not right))
      (return rtl)
    )
    (if (and right (not left))
      (return ltr)
    )
    (return (call most-specific rtl ltr))
  )
  (fn-do _ unify-tuples (? Relation)
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    ; Two tuples written with no name, of as many fields, that do not unify whole unify as the tuple
    ; of what the fields at each place unify to, when both convert to it unasked.
    (let left (call (of RowRange TypeId)))
    (let left-names (call (of RowRange Atom)))
    (let right (call (of RowRange TypeId)))
    (match? ([] (. types rows) from)
      (case (call .type-tuple row)
        (= left (. row fields))
        (= left-names (. row names))
      )
    )
    (match? ([] (. types rows) to)
      (case (call .type-tuple row)
        (= right (. row fields))
      )
    )
    (return-if null (if (or (== (. left count) 0) (!= (. left count) (. right count)))))
    (blank)
    (let unified (list TypeId))
    (for (in offset (..< 0 (. left count)))
      (let field (call unify (call (. types child-type) left offset) (call (. types child-type) right offset) caller))
      (return-if null (if (or (not (call relation-legal field)) (== (. field unified) no-type))))
      (blank)
      (+= unified (. field unified))
    )
    (let mark (. types scratch types mark))
    (let names-mark (. types scratch names mark))
    (for (in offset (..< 0 (. unified length)))
      (call (. types scratch types push) ([] unified offset))
      (call (. types scratch names push) (call (. types child-name) left-names (as offset U32)))
    )
    (let joined (call (. types intern-tuple) mark names-mark))
    (let relation (call implicitly (call compare from joined true false null caller)))
    (let other (call implicitly (call compare to joined true false null caller)))
    (return (only-if relation (if (and (call relation-legal relation) (call relation-legal other)))))
  )
  (fn-do _ unify-optioned (? Relation)
    (param from TypeId)
    (param to TypeId)
    (param caller (? ModuleId))
    ; Two types that do not unify, one of them optional or null, unify as the optional of what the
    ; values they hold unify to, when the first converts to that.
    (let from-value (if-expr (call (. types is-optional) from) (call (. types optional-inner) from) from))
    (let to-value (if-expr (call (. types is-optional) to) (call (. types optional-inner) to) to))
    (if (or (== from (. types null-type)) (== to (. types null-type)))
      (let present (if-expr (== from (. types null-type)) to-value from-value))
      (let nullable (call compare from (call (. types optional-of) present) true false null caller))
      (return (only-if nullable (if (call relation-legal nullable))))
    )
    (if (and (== from-value from) (== to-value to))
      (return null)
    )
    (let held (call unify from-value to-value caller))
    (if (or (not (call relation-legal held)) (== (. held unified) no-type))
      (return null)
    )
    (let relation (call compare from (call (. types optional-of) (. held unified)) true false null caller))
    (return (only-if relation (if (call relation-legal relation))))
  )
  (fn-do + unify-fallback Relation
    (param left TypeId)
    (param value TypeId)
    (param caller (? ModuleId) (= null))
    (let forward (call implicitly (call compare value left true false null caller)))
    (if (and (call has-type value left) (not (call has-type left value)))
      (let widening (call implicitly (call compare left value false false null caller)))
      (return (if-expr (call relation-legal widening) widening forward))
    )
    (if (and (call relation-legal forward) (not (call prefers-reverse forward)))
      (return forward)
    )
    (let reverse (call implicitly (call compare left value false false null caller)))
    (if (and (call relation-legal reverse) (or (not (call relation-legal forward)) (< (. reverse rank) (. forward rank))))
      (return reverse)
    )
    (return forward)
  )
  (fn-expr _ prefers-reverse Bool
    (param relation Relation)
    (or (>= (. relation rank) (call relation-rank .relation-common-equality)) narrows (call truncates-float relation))
    (where
      (lazy narrows (or (== (. relation kind) .relation-down-cast) (== (. relation kind) .relation-interface-down-cast)))
    )
  )
  (fn-expr _ is-narrowing Bool
    (param relation Relation)
    (case? (== (. relation kind) .relation-unwrap-cast)
      (not (call widens-optional relation))
    )
    (default
      (or (== (. relation kind) .relation-down-cast) (== (. relation kind) .relation-interface-down-cast))
    )
  )
  (fn-do + unify-present Relation
    (param left TypeId)
    (param value TypeId)
    (param caller (? ModuleId) (= null))
    (let forward (call implicitly (call compare left value false false null caller)))
    (if (call truncates-float forward)
      (let reverse (call implicitly (call compare value left false false null caller)))
      (if (call relation-legal reverse)
        (return reverse)
      )
    )
    (return forward)
  )
  (fn-do _ relate-facets (? Relation)
    (param from TypeId)
    (param to TypeId)
    ; How a value meets a facet's type: a class at or below the facet's owner, or a facet within it,
    ; narrows to it unasked, and a facet widens to its owner or a class above it only when asked, or
    ; is cast to a class below its owner as the owner is, with a test.
    (let facets (. types program facets))
    (let target (call (. types facet-of-type) to))
    (let source (call (. types facet-of-type) from))
    (if target
      (if source
        (return-if null (if (not (call (. facets is-within) source target))))
        (return (call make-relation .relation-up-cast from to to))
      )
      (return-if null (if (not (call intrinsic-is-class (. ([] (. types completions) from) intrinsic)))))
      (return-if null (if (not (call in-base-chain types from (call (. types facet-owner) target)))))
      (return (call make-relation .relation-up-cast from to to))
    )
    (return-if null (if (or (not source) (not (call intrinsic-is-class (. ([] (. types completions) to) intrinsic))))))
    (blank)
    (let owner (call (. types facet-owner) source))
    (if (and (!= to owner) (call in-base-chain types to owner))
      (return (call make-relation .relation-down-cast from to to))
    )
    (return-if null (if (not (call in-base-chain types owner to))))
    (blank)
    (let widened (call make-relation .relation-up-cast from to to))
    (= (. widened explicit) true)
    (return widened)
  )
  (fn-expr _ truncates-float Bool
    (param relation Relation)
    (and (call intrinsic-is-float from-type) (call is-integer-type to-type))
    (where
      (lazy from-type (. ([] (. types completions) (. relation from)) intrinsic))
      (lazy to-type (. ([] (. types completions) (. relation to)) intrinsic))
    )
  )
  (fn-do + join TypeId
    (param mark ScratchMark)
    ; The type several values become together, as the reference unifies them: each is unified
    ; with the type the ones before it converted to, and the last of these says what all become.
    ; Values that do not unify become nothing together, and the type is invalid.
    (let count (- (. types scratch types length) mark))
    (if (== count 0)
      (return no-type)
    )
    (let held ([] (. types scratch types) mark))
    (let joined held)
    (for (in offset (..< 1 count))
      (let next ([] (. types scratch types) (+ mark offset)))
      (let relation (call unify held next))
      (if (not (call relation-legal relation))
        (return invalid-type)
      )
      (= held (. relation to))
      (= joined (. relation unified))
    )
    (return joined)
  )
  (fn-do + join-arms TypeId
    (param mark ScratchMark)
    ; The type the values of a match's arms become together: each unified with those before it,
    ; or where it does not unify, the union of it and the cases of those before it.
    (let count (- (. types scratch types length) mark))
    (if (== count 0)
      (return no-type)
    )
    (let joined ([] (. types scratch types) mark))
    (for (in offset (..< 1 count))
      (let next ([] (. types scratch types) (+ mark offset)))
      (let relation (call unify next joined))
      (if (call relation-legal relation)
        (= joined (. relation unified))
        (else
          (let pair (. types scratch types mark))
          (match ([] (. types rows) joined)
            (case (call .type-union row)
              (for (in position (..< 0 (. row cases count)))
                (call (. types scratch types push) (call (. types child-type) (. row cases) position))
              )
            )
            (default
              (call (. types scratch types push) joined)
            )
          )
          (call (. types scratch types push) next)
          (= joined (call (. types intern-union) pair))
        )
      )
    )
    (return joined)
  )
  (fn-do _ relate Relation
    (param from TypeId)
    (param to TypeId)
    (param for-unify Bool)
    (param raw Bool)
    (param scope (? MatchScope))
    (param caller (? ModuleId))
    (call (. types complete) from)
    (call (. types complete) to)
    (if (call is-variable-row types to)
      (return (call illegal-relation from to .reason-illegal-cast))
    )
    (blank)
    (let ratio (call lookup-equality types from to))
    (if (not (. ratio is-none))
      (let equal (call make-relation .relation-equal from to to))
      (= (. equal ratio) ratio)
      (return equal)
    )
    (blank)
    (if (and (call can-side-cast to from) (not (and for-unify (call tests-truth to from))))
      (let side (call make-relation .relation-side-cast from to to))
      (= (. side rank) (+ (. side rank) (call side-cast-tiebreak types from to)))
      (return side)
    )
    (blank)
    (if (call can-unwrap-cast from to)
      (let target to)
      (if (and (== (. ([] (. types completions) from) intrinsic) .optional) (== (. ([] (. types completions) to) intrinsic) .or))
        (let alternative (call best-alternative (call optional-item from) to scope))
        (if (!= alternative no-type)
