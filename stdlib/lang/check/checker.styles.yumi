                            - home
                            - index as DeclId
                            - sheet.module
                            - sheet.decl
                        . last = tails[key] ?? U32.max
                        if last == U32.max
                            facts.sheet-extension-heads[key] = place
                        else
                            facts.sheet-extensions[last].next = place
                        tails[key] = place
                    .. sheet-decl = is-sheet-decl(sheet.module, sheet.decl)
                .. typed = target != invalid-type && target != no-type
                .. style-sheet = types.intrinsic-of(target) == .style-sheet

────────────────────
+ do extended-sheet DeclRef?
    - ref DeclRef

` The style sheet an extension of one extends, or none for any other declaration.
if !(program.modules[ref.module].decls[ref.decl] is .decl-sheet-extension)
    = null
for held in facts.sheet-extensions
    if held.module == ref.module && held.decl == ref.decl
        = DeclRef(held.sheet-module, held.sheet)
= null

────────────────────
+ do check-sheet-extension
    - index DeclId
    - extension SheetExtensionDecl

` An extension of a style sheet, `• extend Name`, as the reference's `ASTStyleSheetExtension`
` declares one: its target must be a style sheet, and each rule it adds may repeat none the
` sheet has (`repeats-part`); it holds usings and rules alone, a slot being an error. The first
` that is wrong is the reference's error. The usings and rules it adds are the sheet's
` (`sheet-parts`).
. id = extension.syntax
. row = match? tree.nodes[id]
    | .node-style-sheet-extension(written)
        written
if !row
    =
. name = match? tree.nodes[row.receiver]
    | .node-type-identifier(ident)
        ident.name
if !name
    =
types.clear-fault()
. target = types.evaluate-type(module, tree, row.receiver, frame.env)
types.clear-fault()
if target == invalid-type || target == no-type
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" not found")
    =
if types.intrinsic-of(target) != .class && types.intrinsic-of(target) != .style-sheet
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" is not a StyleSheet")
    =
. ref = class-ref(types, target)
if !is-sheet-decl(ref.module, ref.decl)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("StyleSheet extension target \"${name.text}\" is not a StyleSheet")
    =
for member in tree.children[row.body]
    do match tree.nodes[member]
        | .node-property-syntax
            frame.diagnose
                - member
                - .stated
                - program.store-atom("StyleSheet extensions may not declare slots")
