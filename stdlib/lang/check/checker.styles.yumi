if written == invalid-type || written == no-type
    = invalid-type
. text = row.name.text
. (domain, below) = accessor-domain(text)
if domain.length == 0
    frame.diagnose
        - lhs
        - .stated
        - program.store-atom("Style values are computed by settling; \"\$$text\" is not assignable")
    = invalid-type
if op != .eq-op || written != types.bool-type || is-live-statement(id) || no-style
    decline(id)
    = invalid-type
.. no-style = !program.module-by-name("core/style")
. subject = frame.self-type
if row.object != 0
    subject = infer(row.object)
    if subject == invalid-type
        = invalid-type
if row.is-optional || types.is-optional(subject) || types.intrinsic-of(subject) != .class
    decline(id)
    = invalid-type
if flag-domain(id, domain, below, row.object == 0, true) == invalid-type
    = invalid-type
= written

────────────────────
_ do demand-style-runtime Bool

` The functions of the style runtime that registering styles calls, typed once.
. runtime = facts.style-runtime
if runtime.register != no-instance
