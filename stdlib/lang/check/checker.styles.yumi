. owner = program.modules[row.module]
do match? owner.tree.nodes[nested]
    | .node-style-rule-application(inner)
        if conditional || overlay-rule(inner.name) || names-scope(element-scopes, inner.name)
            decline(id)
            = U32.max
        .. conditional = inner.condition != 0
        . given [TypeId]
        . evaluated = false
        for value in owner.tree.children[inner.args]
