    decline(id)
    = U32.max
if lines.length == 0 || preparing.content-off || !generating()
    = 0
if !(tree.nodes[id] is .node-markup)
    decline(id)
    = U32.max
if !is-markup-host(made)
    frame.diagnose
        - id
        - .stated
        - program.store-atom("Generated style content requires a MarkupElement target")
    = U32.max
. carried [U32]
. cells [U32]
. context = content-view(id, carried, cells)
. host = types.well-known-type("core/markup", "MarkupElement")
if context == U32.max || host == invalid-type || !demand-style-content(made, gates)
    decline(id)
    = U32.max
if conversions.convert(id, id, made, host, .reason-markup-host) == invalid-type
    = U32.max
if gates.length != 0 && !raises-out(id, facts.style-runtime.content-enabled)
    decline(id)
    = U32.max
. builder = builder-type(host, no-type)
. row = instances.rows[unit]
. written = program.modules[row.module].tree
. value-first = facts.content-values.length as U32
for held in carried
    facts.content-values += held
. cell-first = facts.content-cells.length as U32
for held in cells
    facts.content-cells += held
for line in lines
    . callee = demand-content(unit, line, context)
    if callee == no-instance || builder == invalid-type
        decline(id)
        = U32.max
    . closure = types.intern-closure
        - row.module
        - instances.rows[callee].decl
        - callee
        - instances.stable-keys[callee]
    conversions.record-made(callee, line, closure, builder)
    . slot = U32.max
    do match? written.nodes[line]
        | .node-markup(element)
            . name = written.identifier-name(element.slot-binding)
            slot = if name then slot-number(name.text) else U32.max
    facts.style-contents += StyleContent
        - instance
        - id
        - index
        - line
        - slot
        - callee
        - closure
        - value-first
        - carried.length as U32
        - cell-first
        - cells.length as U32
= lines.length as U32

────────────────────
_ do generating Bool

` Whether the rules markup written here applies generate content, as the reference's
` `markupStyleContentEnabled` says: not in a function that builds generated content, nor in one
` it encloses.
. around = instance
while around != no-instance
    . context = instances.rows[around].context
    if context != U32.max && instances.contexts[context].layer != 0
        = false
    around = instances.rows[around].enclosing
= true

────────────────────
_ do content-view U32
    - id SyntaxId
    - carried [U32]
    - cells [U32]

` The context of the function that builds content a style rule generates at a markup element,
` as the reference's `markupStyleContext` gives it there: the styles the markup written here sees,
` the first to answer a name first, the style sheets it sees in their groups, the rules written in
` rules it sees, with those the element's own rules bring into view (`push-scopes`), each with
` how many state cells of the `when`s around it it is seen under, which the function keeps, the
` outermost first, as `cells` gathers them, and where the values of the rule around it that
` takes some are among those it keeps, which are `carried` (`place-values`); and the layer its
` declarations take. `U32.max` where those are not known here, or a cell is not carried here.
if !sheets-known()
    = U32.max
if !scopes-known() && nested-any()
    = U32.max
. styles [TypeId]
for position in 0 .. < markup-styles.length
    styles += markup-styles[markup-styles.length - 1 - position]
. sheets [TypeId]
. levels [U32]
seen-sheets(sheets, levels)
. scopes [RuleScope]
. counts [U32]
. seen = rule-scopes.length
push-content-scopes(id)
. known = true
for use in rule-scopes
    scopes += use.scope
    counts += if use.cell == U32.max then 0u32 else 1 + facts.link-count(use.outer-cells)
    if use.cell == U32.max - 1
        known = false
    else if use.cell != U32.max
        facts.link-cells(use.outer-cells, cells)
        cells += use.cell
. valued [U32]
. value-types [TypeId]
known = known && place-values(0, valued, value-types, carried)
while rule-scopes.length > seen
    rule-scopes.pop()
if !known
    = U32.max
= instances.intern-context
    - styles
    - sheets
    - levels
    - scopes
    - counts
    - no-type
    - markup-layer()
    - valued
    - value-types

────────────────────
_ do demand-content InstanceId
    - unit InstanceId
    - line SyntaxId
    - context U32

` The function that builds the content a line of a style rule generates, the line's function in
` the frame of the instance `unit` that types the rule, typed once for each context
` (`check-content`). None where the line has no function, or its function captures.
. row = instances.rows[unit]
. decl = content-decl(row.module, line)
if decl == 0
    = no-instance
. effects = callee-effects(frame, row.module, decl)
. callee = instances.intern
    - row.module
    - decl
    - no-type
    - effects
    - unit
    - scratch.no-types
    - scratch.no-types
    - true
    - no-type
    - U32.max
    - false
    - 0
    - no-type
    - ImmutableArray'U32'ArenaBacking()
    - ImmutableArray'U32'ArenaBacking()
    - context
if instances.rows[callee].state == .instance-unstarted
    . writer = settled(unit)
    run-within(callee, writer)
    writer.dismiss()
= callee

────────────────────
_ do content-decl DeclId
    - module ModuleId
    - line SyntaxId

` The function of a line of a style rule that generates content, which the main code of its
` module declares, where it captures nothing; or none.
. binding = session.binder.bind(module, program.modules[module].main-decl)
. row = bindings.bindings[binding]
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax == line
        = if nested.captures.count == 0 then nested.decl else 0
= 0

────────────────────
_ do demand-style-content Bool
    - made TypeId
    - gates [StyleWhen]

` The functions of the style runtime generated content calls, typed once: the record of a line's
` content, made for an association, and what enables it; and, under `when`s, the row of
` `style-gates` that enables the record as they hold, with the action that runs its function.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
if runtime.template-content == no-instance
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . host = types.well-known-type("core/markup", "MarkupElement")
    . builder = if host != invalid-type then builder-type(host, no-type) else invalid-type
    if association == invalid-type || builder == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(association)
    scratch.types.push(host)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(builder)
    runtime.template-content = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-content")
        - mark
    scratch.types.rewind(mark)
    if runtime.template-content == no-instance
        = false
    scratch.types.push(instances.signatures[runtime.template-content].returns)
    scratch.types.push(types.bool-type)
    runtime.content-enabled = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-content-set-enabled")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
if runtime.template-content == no-instance || runtime.content-enabled == no-instance
    = false
if gates.length == 0
    = true
. action = demand-style-gates(made)
if action == no-instance
    = false
record-gate(made, gates, action, true)
= true

────────────────────
+ do scope-rules (U32, Bool, U32)
    - made TypeId
    - name Atom
    - given [TypeId]
    - extra [ScopeUse]
    - matched [ScopeUse]
    - mismatch U32

` The rules written in rules that markup sees (`rule-scopes`), and then those of `extra`, that
` an application of a name answers at an element of a class, as the reference's `resolveMatch`
` adds them after the rules of the classes and the style sheets, in the order they came into
` view: each of the name taking as many values as are given, each convertible to the type the
` rule takes it as, but none that reaches only the markup of an element not yet filled
` (`scope-pending`). Answers 0, 1 where one is declined and 2 where one is reported: declined
` where it has a rule around it that takes values, or around which the state cells of `when`s are
` not carried (`plain-frames`), or whose types are not known here, and reported where those types
` are written wrong (`report-argument-types`); whether one has the name; and the place of the
` last value found not to convert, or `mismatch`.
. named = false
. missed = mismatch
. count = rule-scopes.length + extra.length
for position in 0 .. < count
    . use = if position < rule-scopes.length then rule-scopes[position] else extra-use
        .. extra-use = extra[position - rule-scopes.length]
    . scope = use.scope
    if scope.own == .scope-pending
        continue
    . owner = program.modules[scope.module]
    do match? owner.decls[scope.decl]
        | .decl-style-rule(rule)
            if rule.name != name
                continue
            named = true
            if owner.tree.rule-takes(rule.syntax) != given.length
                continue
            . wanted = scope-argument-types(scope)
            if !wanted
                = (if report-argument-types(DeclRef(scope.module, scope.decl)) then 2u32 else 1u32, named, missed)
            . fits = true
            for place in 0 .. < given.length
                if !relation-legal(conversions.compare-held(given[place], wanted[place]))
                    missed = place as U32
                    fits = false
                    break
            if !fits
                continue
            if !plain-frames(use)
                = (1, named, missed)
            matched += use
= (0, named, missed)

────────────────────
_ do names-scope Bool
    - scopes [ScopeUse]
    - name Atom

` Whether a rule written in a rule among those given has a name, but for one that matches nothing
` yet (`scope-pending`).
for use in scopes
    if use.scope.own == .scope-pending
        continue
    do match? program.modules[use.scope.module].decls[use.scope.decl]
        | .decl-style-rule(rule)
            if rule.name == name
                = true
= false

────────────────────
_ do plain-frames Bool
    - use ScopeUse

` Whether the rules applied around a rule written in a rule hold it under `when`s whose state
` cells are here, one for each, and one of them at most takes values, which are here, which is
` all that is modeled of them.
if use.cell == U32.max - 1 || use.values == U32.max - 1
    = false
. gates U32
. valued U32
. frame = use.scope.frames
while frame != U32.max
    . held = instances.frames[frame]
    if held.gate != 0
        gates += 1
    . owner = program.modules[held.module]
    do match? owner.decls[held.decl]
        | .decl-style-rule(rule)
            if held.gate == 0 && owner.tree.rule-takes(rule.syntax) != 0
                if use.values == U32.max || facts.scope-values[use.values].frame != frame
                    = false
                valued += 1
    frame = held.outer
. cells = if use.cell == U32.max then 0u32 else 1 + facts.link-count(use.outer-cells)
= gates == cells && valued == (if use.values == U32.max then 0u32 else 1u32)

────────────────────
_ do scope-unit InstanceId
    - scope RuleScope
    - made TypeId

` The instance that types a rule written in a rule for an element of a class it is matched at,
` as the reference matches it (`targetOwner`): for its style sheet and the element's class where
` a sheet holds it, else for the element's class; typed now, or none where it is being typed
` already.
. sheet = types.intrinsic-of(scope.owner) == .style-sheet
. unit = instances.intern-initializer
    - scope.module
    - scope.decl
    - if sheet then scope.owner else made
    - if sheet then made else no-type
if instances.rows[unit].state == .instance-in-progress
    = no-instance
demand-body(unit)
panics.note-inlined(instance, unit)
= unit

────────────────────
_ do bring-scopes Bool
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - around U32
    - gated [StyleWhen]
    - cell U32
    - values U32
    - outer-cells U32

` Brings into view the rules written in a style rule applied to an element, which the markup
` its object makes and its body see (`collected`), as the reference's `styleRuleNestedScopes`
` gives them: those of its body, under the state cells the rule is applied under (`cell`, and
` `outer-cells` further out), then those of each of its `when`s, under its own (`when-cell`)
` within those (`outer-links`), each within the rules applied `around` them, under the `when` for
` those of one, and reading the `values` of the one that takes some. A rule applied under a
` `when` that is not a state cell may hold none, as the reference reports at the first.
. row = instances.rows[unit]
. owner = program.modules[row.module]
. scopes [ScopeUse]
. first SyntaxId = 0
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        . body = owner.tree.rule-body(rule.syntax)
        do match? owner.tree.nodes[body]
            | .node-block(block)
                for statement in owner.tree.children[block.body]
                    if owner.tree.nodes[statement] is .node-rule-syntax
                        if first == 0
                            first = statement
                        scopes += ScopeUse
                            - RuleScope
                                - row.module
                                - nested-decl(row.module, row.initializer, statement)
                                - row.self-type
                                - around
                                - scope-own(owner.tree, statement)
                            - cell
                            - values
                            - outer-cells
        for branch in owner.tree.rule-whens(body)
            . gate = U32.max
            . held = U32.max
            . links = U32.max
            for line in owner.tree.when-lines(branch)
                if owner.tree.nodes[line] is .node-rule-syntax
                    if first == 0
                        first = line
                    if gate == U32.max
                        gate = instances.intern-frame
                            - around
                            - row.module
                            - row.initializer
                            - row.self-type
                            - branch
                        held = if collecting then when-cell(cell, id, made, row.module, branch) else U32.max - 1
                        links = outer-links(held, cell, outer-cells)
                    scopes += ScopeUse
                        - RuleScope
                            - row.module
                            - nested-decl(row.module, row.initializer, line)
                            - row.self-type
                            - gate
                            - scope-own(owner.tree, line)
                        - held
                        - values
                        - links
if first == 0
    = true
for held in gated
    if held.cell == U32.max
        facts.record-diagnostic
            - instance
            - row.module
            - first
            - .stated
            - program.store-atom
                - "Conditionally applied style rules may only contain style declarations"
            - no-type
            - no-type
        = false
if collecting
    for use in scopes
        collected += use
= true

────────────────────
_ do when-cell U32
    - cell U32
    - site SyntaxId
    - owner TypeId
    - module ModuleId
    - branch SyntaxId

` The state cell of a `when` of a style rule whose body holds rules written in it, made at a site
` (`scope-cell`), as the reference binds the last frame around such a rule; `U32.max - 1`, a cell
` not carried, where the rule is applied under the state cell of a `when` that is not carried.
if cell == U32.max - 1
    = U32.max - 1
= scope-cell(site, owner, module, branch)

────────────────────
_ do outer-links U32
    - held U32
    - cell U32
    - outer-cells U32

` The state cells further out than that of a `when` (`held`) of a style rule applied under the
` cell `cell` and those further out, `outer-cells`: those with `cell` before them, where it is one;
` none where `held` is not carried.
if held >= U32.max - 1
    = U32.max
if cell >= U32.max - 1
    = outer-cells
= facts.scope-link(cell, outer-cells)

────────────────────
+ do outlet-applications U32
    - class TypeId
    - name Atom
    - content TypeId

` Brings into view the rules written in rules that the rules the outlet of the slot of a name of a
` class applies after `•` bring to what the slot is given, as the reference's
` `markupStyleRuleScopesForApplications` gathers them for the slot's type `content` there. Answers
` 0; 3, bringing none, where one is under the state cell of a `when`, which the function that
` builds the content binds to what it builds (`root-applications`); or 2 where one is declined:
` one with values, and the rules of an outlet a line forwards.
. (owner, outlet) = slot-outlet(class, name)
if owner == no-type
    = 0
. ref = class-ref(types, owner)
. written = program.modules[ref.module].tree
do match? written.nodes[outlet]
    | .node-slot-outlet(row)
        for application in written.children[row.style-rule-applications]
            do match? written.nodes[application]
                | .node-style-rule-application(applied)
                    if scoping-named(applied.name) && applied.args.count != 0
                        = 2
        . none [Atom]
        . gathered [ScopeUse]
        . own-keying = keying
        keying = Keying(true, keying.sheet-self, ref.module, outlet)
        . gathering = gather-scopes
            - content
            - none
            - row.style-rule-applications
            - outlet
            - content
            - gathered
            - written
        keying = own-keying
        if !gathering
            = 2
        for use in gathered
            if use.cell != U32.max
                = 3
        for use in gathered
            rule-scopes += use
    | .node-markup-slot-forward
        if outlet-applies(class, name)
            = 2
= 0

────────────────────
_ do outlet-applies Bool
    - class TypeId
    - name Atom

` Whether the outlet of the slot of a name of a class, or that of the class whose slot a line
` forwards it to, applies after `•` a rule whose name some rule that brings rules written in rules
` has, which brings them to what the slot is given, which is declined.
. (owner, outlet) = slot-outlet(class, name)
if owner == no-type
    = false
. ref = class-ref(types, owner)
. written = program.modules[ref.module].tree
do match? written.nodes[outlet]
    | .node-slot-outlet(row)
        for application in written.children[row.style-rule-applications]
            do match? written.nodes[application]
                | .node-style-rule-application(applied)
                    if scoping-named(applied.name)
                        = true
    | .node-markup-slot-forward
        . element = written.holder-of(written.holder-of(outlet))
        do match? written.nodes[element]
            | .node-markup(made)
                . args = RowRange'TypeId()
                do match? types.rows[owner]
                    | .type-class(row)
                        args = row.args
                . env = types.class-env-for(ref.module, ref.decl, args, owner)
                . host = types.evaluate-type(ref.module, written, made.type-id, env)
                types.env-release(env)
                if host == invalid-type || host == no-type || types.intrinsic-of(host) != .class
                    = true
                = outlet-applies(host, name)
= false

────────────────────
_ do cell-whens [StyleWhen]?
    - id SyntaxId
    - made TypeId
    - gated [StyleWhen]
    - cell U32
    - outer-cells U32
    - index U32

` The `when`s that gate a style rule applied under those given, as the reference's
` `styleScopeStateConditions` puts the state cells of the `when`s around a rule written in a rule
` before them, the outermost first, but those they hold already: its gate is recorded once
` (`StyleGate`) and the application of the rule is marked with the cells, the innermost as its
` `cell` and those further out as its `outer-cells`. None where it is declined.
if cell == U32.max
    = gated
. chain [U32]
facts.link-cells(outer-cells, chain)
chain += cell
. missing [U32]
for held in chain
    . holds = false
    for place in gated
        holds = holds || place.cell == held
    if !holds
        missing += held
if missing.length == 0
    = gated
. action = demand-style-gates(made)
if action == no-instance || instances.live.track == no-instance
    decline(id)
    = null
. whens [StyleWhen]
for held in missing
    . row = facts.scope-cells[held]
    whens += StyleWhen(row.module, row.when, held)
for held in gated
    whens += held
record-gate(made, whens, action)
facts.style-applications[index].cell = missing[missing.length - 1]
revise-application(index)
. links = U32.max
for position in 0 .. < missing.length - 1
    links = facts.scope-link(missing[position], links)
facts.style-applications[index].outer-cells = links
revise-application(index)
= whens

────────────────────
_ do same-scopes Bool
    - id SyntaxId

` Whether the rules written in rules that the style rules a markup element applies brought into
` view (`element-scopes`) are those it was made seeing.
. (start, end) = scopes-of(id)
if end - start != element-scopes.length
    = false
for position in 0 .. < element-scopes.length
    if !same-use(scoped-rows[start + position], element-scopes[position])
        = false
= true

────────────────────
_ same-use Bool
    - first ScopeUse
    - second ScopeUse

` Whether two rules written in rules seen are the same, under the same state cells, with the same
` values of the rules around.
same-cell && first.values == second.values && first.outer-cells == second.outer-cells

.. same-cell = instances.same-scope(first.scope, second.scope) && first.cell == second.cell

────────────────────
_ do push-content-scopes
    - id SyntaxId

` Brings into view, for the content a style rule generates at a markup element, the rules written
` in rules that the style rules the element applies do, those that reach only the markup of its
` class's own matching there too (`scope-entered`), as the reference's
` `enteredOwnStyleRuleScopes` gives them.
. (start, end) = scopes-of(id)
for position in start .. < end
    rule-scopes += entered-use(scoped-rows[position])

────────────────────
+ do gather-rule Bool
    - made TypeId
    - owner ModuleId
    - decl DeclId
    - holder TypeId
    - frames U32
    - cell U32
    - seen [ScopeUse]
    - site SyntaxId
    - read TypeId
    - scopes [ScopeUse]
    - gives SyntaxId
    - values U32
    - outer-cells U32

` Gathers the rules written in rules that a style rule matched for a class or style sheet
` (`holder`) brings into view, within `frames`, the state cells `cell` and `outer-cells` and the
` `values` of the rules around, as the reference's `nestedRuleScopesForMatch` gathers them: those
` the rules it applies after its name bring, within it, then its own (`bring-scopes`), with the
` state cells of its `when`s made at `site` for an object read as of class `read`, within those
` (`outer-links`), and the values the application `gives`, where one does (`scope-values`).
` False where one is declined: an
` application within it with a condition or values whose name has a rule that brings any, and
` values given within a rule around that takes some.
. around = instances.intern-frame(frames, owner, decl, holder, 0)
. framed = values
if gives != 0
    if values != U32.max
        = false
    framed = scope-values(gives, around)
. written = program.modules[owner].tree
do match? program.modules[owner].decls[decl]
    | .decl-style-rule(rule)
        do match? written.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for application in written.children[declared.style-rule-applications]
                    do match? written.nodes[application]
                        | .node-style-rule-application(applied)
                            if !scoping-named(applied.name)
                                continue
                            if applied.args.count != 0 && applied.condition == 0 && keying.discovering
                                continue
                            if applied.condition != 0 || applied.args.count != 0
                                = false
                            . none [TypeId]
                            if !gather-name(made, applied.name, seen, around, cell, site, read, scopes, none, 0, framed, outer-cells)
                                = false
                . body = declared.body
                do match? written.nodes[body]
                    | .node-block(block)
                        for statement in written.children[block.body]
                            if written.nodes[statement] is .node-rule-syntax
                                scopes += ScopeUse
                                    - RuleScope
                                        - owner
                                        - nested-decl(owner, decl, statement)
                                        - holder
                                        - around
                                        - scope-own(written, statement)
                                    - cell
                                    - framed
                                    - outer-cells
                for branch in written.rule-whens(body)
                    . gate = U32.max
                    . held = U32.max
                    . links = U32.max
                    for line in written.when-lines(branch)
                        if written.nodes[line] is .node-rule-syntax
                            if gate == U32.max
                                gate = instances.intern-frame(around, owner, decl, holder, branch)
                                held = when-cell(cell, site, read, owner, branch)
                                links = outer-links(held, cell, outer-cells)
                            scopes += ScopeUse
                                - RuleScope
                                    - owner
                                    - nested-decl(owner, decl, line)
                                    - holder
                                    - gate
                                    - scope-own(written, line)
                                - held
                                - framed
                                - links
= true

────────────────────
_ do scope-values U32
    - site SyntaxId
    - frame U32

` The values the application `site` of this instance gives the rule of a frame, which the rules
` written in it read, made once.
for index in 0 .. < facts.scope-values.length
    . held = facts.scope-values[index]
    if same-site && held.module == module && held.frame == frame
        = index as U32
    .. same-site = held.instance == instance && held.site == site
facts.scope-values += ScopeValues(instance, site, module, frame)
= (facts.scope-values.length - 1) as U32

────────────────────
_ do gates-updates Bool
    - unit InstanceId

` Whether a style rule applied in the body of a `when` sets no property of its class, which
` the reference reports at the first line that does: a gated block of declarations may only
` declare styles.
for update in facts.rule-updates
    if update.instance == unit
        . row = instances.rows[unit]
        . written = program.modules[row.module].tree
        do match? written.nodes[update.site]
            | .node-assign(line)
                . name = written.identifier-name(line.lhs)
                if name
                    facts.record-diagnostic
                        - instance
                        - row.module
                        - line.lhs
                        - .stated
                        - conditional-update(name)
                        - no-type
                        - no-type
                    = false
        decline(update.site)
        = false
= true

────────────────────
_ do gate-when [StyleWhen]?
    - id SyntaxId
    - made TypeId
    - owner ModuleId
    - branch SyntaxId
    - gated [StyleWhen]

` The `when`s that gate the declarations of the body of a `when` of a style rule applied to an
` object of a class, the outermost first: those the rule is applied under, then this one. Its
` state must be a property of the class of type `Bool`, as the reference reports, which is
` read tracked, and the gate is recorded once (`StyleGate`), with the constructor of the
` action that runs it. None where it is reported or declined.
. written = program.modules[owner].tree
. state = program.store-atom("")
do match? written.nodes[branch]
    | .node-style-when(row)
        state = row.state
. place = property-named(made, state)
. shown = type-short-name(types, made)
if !place
    facts.record-diagnostic
        - instance
        - owner
        - branch
        - .stated
        - program.store-atom("Style state \"${state.text}\" is not a property of $shown")
        - no-type
        - no-type
    = null
. property = types.properties[place]
if property.storage-kind == .storage-getter
    decline(id)
    = null
. declared = property.type
if declared == no-type
    declared = demand-member(property, made, state)
if declared == invalid-type
    = null
if declared != types.bool-type
    facts.record-diagnostic(instance, owner, branch, .stated, program.store-atom("Style state \"${state.text}\" must be a boolean property, but $shown.${state.text} is ${type-display(types, declared)}"), declared, no-type)
    = null
instances.mark-may-panic(instance)
. key = panics.property-of(made, state)
if key
    panics.track(key)
. ref = class-ref(types, property.owner)
facts.note-tracked(ref.module, ref.decl, state)
demand-live-runtime()
. action = demand-style-gates(made)
if action == no-instance || instances.live.track == no-instance
    decline(id)
    = null
. whens [StyleWhen]
for held in gated
    whens += held
whens += StyleWhen(owner, branch)
record-gate(made, whens, action)
= whens

────────────────────
_ do record-gate
    - made TypeId
    - whens [StyleWhen]
    - action InstanceId
    - content = false

. found = facts.gate-of(made, whens, content)
if found != U32.max
    facts.gate-users += GateUser(instance, found)
    =
facts.gate-users += GateUser(instance, facts.style-gates.length as U32)
facts.style-gates += StyleGate
    - made
    - facts.style-gate-whens.length as U32
    - whens.length as U32
    - action
    - content
for held in whens
    facts.style-gate-whens += held

────────────────────
+ do demand-style-gates InstanceId
    - made TypeId

` The functions of the style runtime a gated block of declarations calls, typed once, and the
` constructor of the action that gates a block on an object of a class, `StyleDynamicAction`
` of the class, given the object, the trackers of the conditions and the callback that
` evaluates them again; or none.
demand-live-runtime()
if !demand-style-sites()
    = no-instance
. runtime = facts.style-runtime
. module-id = class-ref(types, types.type-row(.style)).module
. association = types.well-known-type("core/style", "StyleSiteAssociation")
. base = types.well-known-type("core/style", "StyleDynamicActionBase")
. pointer = types.well-known-type("core", "Pointer")
. live = types.live-action-type
if base == invalid-type || pointer == invalid-type || live == invalid-type
    = no-instance
. mark = scratch.types.mark
if runtime.open-block == no-instance
    scratch.types.push(association)
    runtime.open-block = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-open-block")
        - mark
    scratch.types.push(types.type-row(.int64))
    runtime.close-block = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-close-block")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(association)
    scratch.types.push(base)
    runtime.dynamic = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-dynamic")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.block-enabled = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-set-block-enabled")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
if blocks-missing || runtime.dynamic == no-instance || runtime.block-enabled == no-instance
    = no-instance
.. blocks-missing = runtime.open-block == no-instance || runtime.close-block == no-instance
scratch.types.push(made)
. action = types.class-named-with-args(module-id, program.store-atom("StyleDynamicAction"), mark)
scratch.types.rewind(mark)
if action == invalid-type
    = no-instance
types.complete(action)
scratch.types.push(made)
scratch.types.push
    - types.properties[property-named(live, program.store-atom("trackers"))!].type
scratch.types.push(instances.live.callback)
. made-action = calls.demand-constructor(action, mark)
scratch.types.rewind(mark)
= made-action

────────────────────
_ do demand-style-authors Bool
    - made TypeId

` The function of the style runtime a live action that declares a style again for an object
` calls, typed once, with those a gated block calls, whose action it is made by.
if demand-style-gates(made) == no-instance
    = false
. runtime = facts.style-runtime
if runtime.author-dynamic == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . pointer = types.well-known-type("core", "Pointer")
    if info == invalid-type || pointer == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.author-dynamic = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-dynamic")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.author-dynamic != no-instance

────────────────────
_ do runs-code Bool
    - unit InstanceId
    - written AST
    - value SyntaxId

` Whether a value an instance typed calls a function, but the constructor the program makes for
` a type that is no class, which makes the value and does nothing else.
for node in written.subtree-start(value) .. value
    . fact = facts.first-call(unit, node)
    if fact != no-fact && !makes-value(facts.calls[fact])
        = true
= false

────────────────────
_ do makes-value Bool
    - call CallFact

` Whether a call is of the constructor the program makes for a type that is no class.
if call.form != .call-constructor || call.next != no-fact
    = false
. row = instances.rows[call.callee]
if types.intrinsic-of(row.self-type) == .class
    = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.is-generated
= false

────────────────────
_ do report-recursion
    - active [InstanceId]
    - start Size
    - again InstanceId
    - owner ModuleId
    - at SyntaxId

` The reference's error for a style rule that comes to apply itself again: the names of the
` rules from the first time it was applied on, then its own, at the application that would.
. names = ""
for position in start .. < active.length
    names += "${rule-name(active[position])} -> "
names += rule-name(again)
. text = program.store-atom("Recursive style rule application: $names")
facts.record-diagnostic(instance, owner, at, .stated, text, no-type, no-type)

────────────────────
_ do rule-name String
    - unit InstanceId

` The name of the style rule an instance types.
. row = instances.rows[unit]
do match? program.modules[row.module].decls[row.initializer]
    | .decl-style-rule(rule)
        = rule.name.text
= ""

────────────────────
_ do rule-unit InstanceId
    - level TypeId
    - member DeclRef
    - made TypeId
    - site SyntaxId

` The instance that types a style rule a class or a style sheet writes, for the class or sheet
` `level`, and for a sheet's, the class `made` of the element it is applied to, as the reference
` resolves its names there; for a class's, under the styles of the element's vocabulary it
` reads (`rule-context`), applied at `site`. Typed now, or none where it is being typed already.
` The instance that applies it runs its code, and may panic where it does.
. element = if types.intrinsic-of(level) == .style-sheet then made else no-type
. context = if element == no-type then rule-context(level, member, made, site) else U32.max
. unit = instances.intern-initializer(member.module, member.decl, level, element, context)
if instances.rows[unit].state == .instance-in-progress
    = no-instance
demand-body(unit)
panics.note-inlined(instance, unit)
= unit

────────────────────
_ do rule-context U32
    - level TypeId
    - member DeclRef
    - made TypeId
    - site SyntaxId

` The styles a style rule a class writes is typed under beside those the class sees, where it is
` applied at `site` to an element of a class: each style the element sees, as `answers-alike`
` lists them, that declares a name a line of the rule declares which no style the class sees
` answers, in the order the element sees them, as the reference keys the function of a rule by
` the styles of the element's vocabulary it reads (`keyForMarkupStyleReads`); or none.
if types.intrinsic-of(level) != .class
    = U32.max
. written = program.modules[member.module].tree
. body SyntaxId = 0
do match? program.modules[member.module].decls[member.decl]
    | .decl-style-rule(rule)
        do match? written.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                body = declared.body
if body == 0
    = U32.max
. lines [SyntaxId]
do match? written.nodes[body]
    | .node-block(block)
        for statement in written.children[block.body]
            lines += statement
for branch in written.rule-whens(body)
    for statement in written.when-lines(branch)
        lines += statement
. own [TypeId]
. seen [TypeId]
if !add-visible-styles(level, own, site) || !add-visible-styles(made, seen, site)
    = U32.max
add-markup-styles(seen)
. wanted [Bool]
for _ in seen
    wanted += false
for statement in lines
    do match? written.nodes[statement]
        | .node-assign(line)
            . name = style-name(written, line.lhs)
            if line.op == .eq-op && name && !property-named(level, name) && style-answering(own, name) == no-type
                for position in 0 .. < seen.length
                    if names-style-property(seen[position], name)
                        wanted[position] = true
. extra [TypeId]
for position in 0 .. < seen.length
    if wanted[position] && own.find(seen[position]) == null
        extra += seen[position]
if extra.length == 0
    = U32.max
. sheets [TypeId]
. levels [U32]
. scopes [RuleScope]
. cells [U32]
. valued [U32]
= instances.intern-context(extra, sheets, levels, scopes, cells, no-type, 0, valued, sheets)

────────────────────
_ do unit-vocabulary [TypeId]?
    - named TypeId
    - syntax SyntaxId

` The styles the lines of a style rule an instance types declare names of: those `named` sees
` (`style-vocabulary`), then those of the context the instance is typed under (`rule-context`).
. styles = style-vocabulary(named, syntax)
. context = instances.rows[instance].context
if !styles || context == U32.max
    = styles
. held = instances.contexts[context]
. found = styles
for position in held.first .. < held.first + held.styles
    . used = instances.context-types[position]
    if found.find(used) == null
        found += used
= found

────────────────────
_ do shares-rule Bool
    - applied [InstanceId]
    - count U32

` Whether the reference compiles a rule matched by name into a function every element it
` matches calls, as `styleRuleIsShareable` says: one whose weight, with the rules it applies,
` is more than one, each style it declares and each `when` weighing one, and none of which
` sets a property of its class or generates content.
. weight = count
for unit in applied
    if facts.updates-properties(unit)
        = false
    . row = instances.rows[unit]
    . written = program.modules[row.module].tree
    do match? program.modules[row.module].decls[row.initializer]
        | .decl-style-rule(rule)
            do match? written.nodes[rule.syntax]
                | .node-rule-syntax(declared)
                    if written.rule-content(declared.body).length != 0
                        = false
                    for branch in written.rule-whens(declared.body)
                        if written.when-content(branch).length != 0
                            = false
                    weight += written.rule-whens(declared.body).length as U32
= weight > 1

────────────────────
+ do class-style-rule (TypeId, DeclRef, Bool)
    - made TypeId
    - name Atom

` The class of a chain, the most derived first, that writes a style rule of a name taking no
` values, and the rule, as the reference resolves a rule an element applies; and whether some
` class writes a rule of that name at all.
. named = false
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-rule(rule)
                        if rule.name == name
                            named = true
                            if owner.tree.rule-takes-nothing(rule.syntax)
                                = (level, DeclRef(ref.module, member), true)
    level = types.base-of(level)
= (no-type, DeclRef(0, 0), named)

────────────────────
+ do match-style-rule (TypeId, DeclRef, Bool, U32)
    - made TypeId
    - name Atom
    - given [TypeId]

` The style rule a written application chooses by the types of its values, as the reference's
` `resolveMatch` chooses among the rules the classes of a chain write: in each class, the
` first rule of the name taking as many values, each convertible to the type the rule takes it
` as, that converts them most closely; then, of the classes, the most derived whose choice
` converts them most closely. Answers the class and the rule, or no type where none is chosen;
` whether some class writes a rule of the name; and the place of the last value found not to
` convert, at which the reference reports the mismatch, or `U32.max`. A type a rule takes that
` is not known here is answered as an invalid class with that rule, to be reported where it is
` written wrong (`report-argument-types`) or else declined.
. named = false
. mismatch = U32.max
. best = no-type
. best-member = DeclRef(0, 0)
. best-kind = 0u32
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . (found, chosen, kind, writes, missed) = match-rules-of(level, name, given, mismatch)
    if writes
        named = true
    mismatch = missed
    if found && kind == U32.max
        = (invalid-type, chosen, named, mismatch)
    if found && (best == no-type || kind > best-kind)
        best = level
        best-member = chosen
        best-kind = kind
    level = types.base-of(level)
= (best, best-member, named, mismatch)

────────────────────
_ do match-rules-of (Bool, DeclRef, U32, Bool, U32)
    - level TypeId
    - name Atom
    - given [TypeId]
    - mismatch U32

` The rule of a name a class or a style sheet writes that a written application chooses by the
` types of its values, as the reference's `matchRulesOf` chooses it: the first taking as many
` values, each convertible to the type the rule takes it as, that converts them most closely.
` A sheet writes the rules of its extensions after its own (`sheet-parts`). Answers whether
` there is one, the rule and how closely, `U32.max` for a type a rule takes that is not known
` here; whether the class writes a rule of the name; and the place of the last value found not
` to convert, or `mismatch` where none is.
. found = false
. named = false
. chosen = DeclRef(0, 0)
. kind = 0u32
. missed = mismatch
for part in sheet-parts(class-ref(types, level))
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-style-rule(rule)
                if rule.name != name
                    continue
                named = true
                if owner.tree.rule-takes(rule.syntax) != given.length
                    continue
                . written = DeclRef(part.module, member)
                . wanted = rule-argument-types(written)
                if !wanted
                    = (true, written, U32.max, named, missed)
                . fits = true
                . closeness = Specificity.exact as U32
                for position in 0 .. < given.length
                    . relation = conversions.compare-held(given[position], wanted[position])
                    if !relation-legal(relation)
                        missed = position as U32
                        fits = false
                        break
                    if (relation.match as U32) < closeness
                        closeness = relation.match
                if fits && (!found || closeness > kind)
                    found = true
                    chosen = written
                    kind = closeness
= (found, chosen, kind, named, missed)

────────────────────
_ do report-argument-types Bool
    - member DeclRef

` Reports a value a style rule takes whose type is written wrong, where it is written, as the
` reference's `resolveMatch` reports it as it matches the rule (`argument-type-error`). Says
` whether one was reported.
. owner = program.modules[member.module]
do match? owner.decls[member.decl]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(row)
                . env = holder-env(DeclRef(member.module, rule.owner))
                for arg in owner.tree.children[row.args]
                    . (at, message) = argument-type-error(member.module, arg, env)
                    if at != 0
                        types.env-release(env)
                        report-at(member.module, at, message)
                        = true
                types.env-release(env)
= false

────────────────────
_ do argument-type-error (SyntaxId, String)
    - owner ModuleId
    - argument SyntaxId
    - env TypeEnv

` Where a value a style rule takes is written wrong, and the reference's error there: a name
` written with no type, a type written that names nothing (`missing-type`), or a type written
` with no name, which the reference refuses as the rule binds it. None where it is written right.
. written = program.modules[owner].tree
do match? written.nodes[argument]
    | .node-argument-decl(row)
        do match? written.nodes[row.pattern]
            | .node-type-capture(capture)
                if capture.type == 0
                    = (argument, "Argument type not found")
                = (types.missing-type(owner, written, capture.type, env), "Type not found")
        . missing = types.missing-type(owner, written, row.pattern, env)
        if missing != 0
            = (missing, "Type not found")
        = (row.pattern, "Invalid argument")
= (0, "")

────────────────────
_ do overlay-rule Bool
    - name Atom

` Whether a style rule of a name may be answered other than by a class of the element that
` applies it, a style sheet it sees, or a rule written in a rule that it sees where those are
` known (`scopes-known`), as the reference also looks: by a rule written in a rule where they
` are not, or by one written at the top of a module. What answers is not modeled.
if !scopes-known() && nested-named(name)
    = true
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    if !program.shares-case(module, ref.module)
        continue
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-style-rule(rule)
            if rule.owner == 0
                = true
= false

────────────────────
+ do list-style-rules

` Lists, once, the style rules the program writes and the names of those written in rules; and
` the names of those that bring rules written in rules into view where they are applied
` (`scoping-names`): those with rules written in them, and those that apply one of those names
` after their own. Each name is listed with the module that writes the rule, and is seen only
` from the modules that share a case of a batch with it (`shares-case`), as one program sees all.
=? if facts.rules-listed
facts.rules-listed = true
for position in 0 .. < program.modules.length
    . owner = program.modules[position]
    . place = position as ModuleId
    . index = 0u32
    for decl in owner.decls
        do match? decl
            | .decl-style-rule(rule)
                if rule.outer != 0
                    facts.nested-rules += rule.name
                    facts.nested-modules += place
                    do match? owner.decls[rule.outer]
                        | .decl-style-rule(around)
                            if !lists-scoping(around.name, place)
                                facts.scoping-names += around.name
                                facts.scoping-modules += place
                else
                    facts.add-style-rule(DeclRef(place, index), rule.name)
        index += 1
. growing = facts.scoping-names.length != 0
while growing
    growing = false
    for position in 0 .. < program.modules.length
        . owner = program.modules[position]
        . place = position as ModuleId
        for decl in owner.decls
            do match? decl
                | .decl-style-rule(rule)
                    if lists-scoping(rule.name, place)
                        continue
                    do match? owner.tree.nodes[rule.syntax]
                        | .node-rule-syntax(written)
                            for application in owner.tree.children[written.style-rule-applications]
                                do match? owner.tree.nodes[application]
                                    | .node-style-rule-application(applied)
                                        if scoping-from(applied.name, place) && unlisted
                                            facts.scoping-names += rule.name
                                            facts.scoping-modules += place
                                            growing = true
                                        .. unlisted = !lists-scoping(rule.name, place)

────────────────────
_ do lists-scoping Bool
    - name Atom
    - owner ModuleId

` Whether `scoping-names` lists a name for a module that writes a rule of it.
for position in 0 .. < facts.scoping-names.length
    if facts.scoping-names[position] == name && facts.scoping-modules[position] == owner
        = true
= false

────────────────────
_ do style-declared Bool
    - name Atom

` Whether a module the module being typed shares a case with writes a style rule of a name, in a
` rule or outside one.
=? true if nested-named(name)
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    =? true if program.shares-case(module, ref.module)
= false

────────────────────
_ do nested-named Bool
    - name Atom

` Whether a module the module being typed shares a case with writes a rule of a name in a rule.
for position in 0 .. < facts.nested-rules.length
    if facts.nested-rules[position] == name && case-shared
        = true
    .. case-shared = program.shares-case(module, facts.nested-modules[position])
= false

────────────────────
_ do sheet-rule-name Bool
    - name Atom

` Whether a style sheet writes a style rule of a name, in a module the module being typed shares
` a case with.
. position = facts.first-style-rule(name)
while position != U32.max
    . ref = facts.style-rules[position]
    position = facts.style-rule-nexts[position]
    if !program.shares-case(module, ref.module)
        continue
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-style-rule(rule)
            if rule.owner != 0 && is-sheet-decl(ref.module, rule.owner)
                = true
= false

────────────────────
_ do answers-alike Bool
    - unit InstanceId
    - made TypeId
    - site SyntaxId

` Whether each property a style rule declares, typed for the class that writes it, is answered
` by the same style where the rule is applied to an element of a class: the reference resolves
` the names there, in the element's vocabulary, with that of a style sheet that writes the
` rule last.
. styles [TypeId]
if !add-visible-styles(made, styles, site)
    = false
add-markup-styles(styles)
. writer = instances.rows[unit].self-type
if types.intrinsic-of(writer) == .style-sheet && !add-visible-styles(writer, styles, site)
    = false
. owner = program.modules[instances.rows[unit].module].tree
. place = facts.first-style-declaration(unit)
while place != U32.max
    . row = facts.style-declarations[place]
    do match? owner.nodes[row.site]
        | .node-assign(line)
            . name = style-name(owner, line.lhs)
            if !name || style-answering(styles, name) != row.style
                = false
    place = facts.next-style-declaration(place)
= true

────────────────────
+ do check-style-unit
    - receiver TypeId
    - syntax SyntaxId
    - writer DeclId

` Types a style rule for the class that writes it, as a rule of the class is typed, with
` `this` bound and each value it takes of the type the class declares for it. Each line of its
` body, in the order written, sets a property of the class (`update-unit-property`) or names a
` property of a style the class sees and declares its value, typed and converted as an
` element's declaration is. A name no style answers is the reference's error. The lines of
` each `when` follow, which may only declare styles, as the reference reports. A declared
` value that reads something tracked is declared again as it changes where the rule is applied
` (`StyleAuthor`), and `inherit` takes the value from the parent (`declare-inherit`). A value the
` runtime holds a handle to is declared as an element's is. Any other line, and a declared
` value that reads a value the rule takes and something tracked, are declined. The rules a rule
` applies are resolved where
` it is applied. A rule answers nothing.
frame.self-type = receiver
bind-this(receiver)
frame.close-env()
open-class-env(holding-type(receiver, DeclRef(module, writer)))
if sheet-rule() && instances.rows[instance].element == no-type
    if !report-missing-type(syntax, frame.env) && assign-rule-arguments(syntax, true) && assign-outer-arguments(true)
        type-sheet-lines(receiver, syntax)
else if assign-rule-arguments(syntax) && assign-outer-arguments()
    declare-unit-styles(receiver, syntax)
instances.set-returns(instance, types.void-type, types.void-type, .return-declared)
finish-errors(frame)
close()

────────────────────
_ do type-sheet-lines
    - sheet TypeId
    - syntax SyntaxId

do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        if rule.body == 0
            =
        . styles [TypeId]
        if !add-visible-styles(sheet, styles, syntax)
            =
        do match? tree.nodes[rule.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    type-sheet-line(statement, sheet, styles)
                for branch in tree.rule-whens(rule.body)
                    for statement in tree.when-lines(branch)
                        type-sheet-line(statement, sheet, styles)

────────────────────
_ do type-sheet-line
    - statement SyntaxId
    - sheet TypeId
    - styles [TypeId]

do match? tree.nodes[statement]
    | .node-rule-syntax
        type-nested-rule(statement, sheet)
    | .node-assign(line)
        . name = tree.identifier-name(line.lhs)
        if line.op != .eq-op || !name
            =
        . answering = style-answering(styles, name)
        if answering == no-type || answering == invalid-type
            =
        . (_, declared) = declared-style-property(answering, name)
        if untyped || !sheet-value-typed(line.rhs, sheet, declared)
            =
        .. untyped = declared == no-type || declared == invalid-type
        . written = style-value(line.rhs, declared)
        if written != no-type && written != invalid-type
            conversions.convert(statement, line.rhs, written, declared, .reason-assignment)

────────────────────
_ do sheet-value-typed Bool
    - value SyntaxId
    - sheet TypeId
    - declared TypeId

if tree.is-inherit(value) || tree.reads-tracked(value) || reads-slots(value) || reads-member
    = false
.. reads-member = reads-sheet-member(value, sheet)
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            . styled = (resolution-flags /and/ ResolutionFlag.resolution-styled) != 0
                .. resolution-flags = bindings.resolution-of(frame.binding, node).flags
            if styled && (node != value || !bare-case(declared, row.name))
                = false
= true

────────────────────
_ do type-nested-rule
    - syntax SyntaxId
    - sheet TypeId

=? if !sheet-rule()
. nested = nested-decl(module, instances.rows[instance].initializer, syntax)
=? if nested == 0
. unit = instances.intern-initializer(module, nested, sheet)
if instances.rows[unit].state == .instance-unstarted
    demand-body(unit)

────────────────────
_ do assign-rule-arguments Bool
    - syntax SyntaxId
    - quiet Bool = false

` Gives each value a style rule takes, `name Type`, the type the class declares for it.
do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        for arg in tree.children[rule.args]
            . declared = tree.argument-type-syntax(arg)
            . named SyntaxId = 0
            do match? tree.nodes[arg]
                | .node-argument-decl(row)
                    do match? tree.nodes[row.pattern]
                        | .node-type-capture(capture)
                            named = capture.id
            . resolution = bindings.resolution-of(frame.binding, named)
            if declared == 0 || named == 0 || resolution.kind != .resolve-slot
                if !quiet
                    decline(arg)
                = false
            . type = types.evaluate-type(module, tree, declared, frame.env)
            if type == invalid-type
                if !quiet
                    decline(arg)
                = false
            frame.assign(resolution.slot, type)
= true

────────────────────
_ do assign-outer-arguments Bool
    - quiet Bool = false

` Gives each value the rules around a rule written in a rule take the type the class declares
` for it, as the reference defines the values of the frames it is applied within
` (`withStyleRuleLexicalFrames`), which the rule reads as the frame gives them.
. decls = program.modules[module].decls
. outer DeclId = 0
do match? decls[instances.rows[instance].initializer]
    | .decl-style-rule(rule)
        outer = rule.outer
while outer != 0
    . next DeclId = 0
    do match? decls[outer]
        | .decl-style-rule(rule)
            if !assign-rule-arguments(rule.syntax, quiet)
                = false
            next = rule.outer
    outer = next
= true

────────────────────
_ do marks-up-class Bool
    - syntax SyntaxId

` Whether the lines of a style rule that are not its own (`rule-part`) are the markup of the
` class that writes it: the rule is that class's `• This`, which the class keeps as its content
` (`defaults-content`), so its markup function types them and the rule does not.
. decl = instances.rows[instance].initializer
do match? program.modules[module].decls[decl]
    | .decl-style-rule(rule)
        do match? program.modules[module].decls[rule.owner]
            | .decl-class(class)
                = class.content == syntax
= false

────────────────────
_ do sheet-rule Bool

` Whether the style rule an instance types is written in a style sheet, whose lines may only
` declare styles and generate content: any other line is the reference's error.
. decl = instances.rows[instance].initializer
do match? program.modules[module].decls[decl]
    | .decl-style-rule(rule)
        = is-sheet-decl(module, rule.owner)
= false

────────────────────
_ do declare-unit-styles
    - receiver TypeId
    - syntax SyntaxId

` Types the lines of a style rule's body, as `check-style-unit` says, for the class or style
` sheet that writes it. The names it declares are those of the styles the class sees, then those
` of the context it is typed under, or for a rule a style sheet writes, those the class of the
` element it is typed for sees, then the sheet's, as the reference resolves them where the rule
` is applied (`unit-vocabulary`).
do match? tree.nodes[syntax]
    | .node-rule-syntax(rule)
        type-applied-values(receiver, rule)
        if rule.body == 0
            =
        . styles [TypeId]? = null
        . element = instances.rows[instance].element
        . named = if element != no-type then element else receiver
        . order U32
        . marks-up = marks-up-class(syntax)
        do match tree.nodes[rule.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(line)
                            . name = tree.identifier-name(line.lhs)
                            if assigning && name && is-class && property-named(receiver, name)
                                if !update-unit-property(statement, line, receiver, name)
                                    =
                                continue
                            .. assigning = line.op == .eq-op
                            .. is-class = types.intrinsic-of(receiver) == .class
                        | .node-style-when
                            continue
                        | .node-rule-syntax
                            type-nested-rule(statement, receiver)
                            continue
                    if !tree.rule-part(statement)
                        if marks-up
                            continue
                        if sheet-rule()
                            frame.diagnose(statement, .stated, program.store-atom("StyleSheet style rules may only contain style declarations and generated content"))
                            =
                    do match? tree.nodes[statement]
                        | .node-markup
                            if content-slot(statement) == U32.max
                                =
                            continue
                        | .node-markup-slot-forward
                            do content-slot(statement)
                            =
                    if !styles
                        styles = unit-vocabulary(named, syntax)
                        if !styles
                            =
                    if !declare-unit-style(statement, syntax, receiver, styles, order)
                        =
                    order += 1
                for branch in tree.rule-whens(rule.body)
                    for statement in tree.when-lines(branch)
                        do match? tree.nodes[statement]
                            | .node-style-rule-application
                                continue
                            | .node-rule-syntax
                                type-nested-rule(statement, receiver)
                                continue
                            | .node-markup
                                if content-slot(statement) == U32.max
                                    =
                                continue
                            | .node-markup-slot-forward
                                do content-slot(statement)
                                =
                            | .node-assign(line)
                                . name = tree.identifier-name(line.lhs)
                                if name && property-named(receiver, name)
                                    frame.diagnose(line.lhs, .stated, conditional-update(name))
                                    =
                        if !styles
                            styles = unit-vocabulary(named, syntax)
                            if !styles
                                =
                        if !declare-unit-style(statement, syntax, receiver, styles, order)
                            =
                        order += 1
            ??
                decline(rule.body)

────────────────────
_ do rule-writer TypeId
    - receiver TypeId

` The class that writes the style rule an instance types, where it is no class of the receiver's
` chain, as a rule written in a rule of one class is typed for the class of the element it
` matches; the receiver otherwise, or where the writer takes type arguments the receiver does
` not give.
do match? program.modules[module].decls[instances.rows[instance].initializer]
    | .decl-style-rule(rule)
        do match? program.modules[module].decls[rule.owner]
            | .decl-class(class)
                if class.type-args.count == 0 && same-holder && not-owner
                    = types.intern-class(module, rule.owner, scratch.types.mark)
                .. same-holder = holding-type(receiver, DeclRef(module, rule.owner)) == receiver
                .. not-owner = !same-decl(class-ref(types, receiver), DeclRef(module, rule.owner))
= receiver

────────────────────
_ do content-slot U32
    - line SyntaxId

` The slot a line of a style rule that generates content fills, 0 to 3 for before, after,
` first-child and last-child, as the reference's `styleContentTemplateFor` reads it. A line that
` forwards a slot, one that names the item of a slot that repeats, and a slot of another name are
` the reference's errors, and a markup line that binds no slot is declined; each answers
` `U32.max`.
. binding SyntaxId = 0
. parameter SyntaxId = 0
do match? tree.nodes[line]
    | .node-markup(row)
        binding = row.slot-binding
        parameter = row.slot-parameter
    | .node-markup-slot-forward(row)
        frame.diagnose
            - row.slot-binding
            - .stated
            - program.store-atom("Style content slots cannot forward markup slots")
        = U32.max
. name = tree.identifier-name(binding) if binding != 0
if !name
    decline(line)
    = U32.max
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(written)
        frame.diagnose
            - written.name
            - .stated
            - program.store-atom("Style content slots cannot declare a repeated slot parameter")
        = U32.max
. text = name.text
if text == "before"
    = 0
if text == "after"
    = 1
if text == "first-child"
    = 2
if text == "last-child"
    = 3
frame.diagnose(binding, .stated, program.store-atom("Unknown style content slot \"${text}\"; expected before, after, first-child, or last-child"))
= U32.max

────────────────────
_ do conditional-update Atom
    - name Atom

` The reference's error for a line of a style rule that sets a property of its class where the
` rule's declarations are gated by a `when`.
= program.store-atom("Conditional style declarations may only set style properties, and \"${name.text}\" is an object property")

────────────────────
_ do type-applied-values
    - receiver TypeId
    - rule ASTRule

` Types the values a style rule gives each rule it applies, after its name and then in the
` body of each `when`, as written, with nothing expected, and converts each to the type the
` rule the class chooses by them takes it as (`match-style-rule`), or where no class of its
` chain answers the name, the rule of style sheets it chooses (`own-sheet-rule`). An element
` whose class or sheets choose another is declined where the rule is applied (`apply-rule`).
` A value names the slots of the style sheets the class that writes the rule sees
` (`rule-writer`), which a rule written in a rule matches against another class's elements.
. applications [SyntaxId]
. writer = rule-writer(receiver)
for nested in tree.children[rule.style-rule-applications]
    applications += nested
for branch in tree.rule-whens(rule.body)
    for nested in tree.when-applications(branch)
        applications += nested
for nested in applications
    do match? tree.nodes[nested]
        | .node-style-rule-application(applied)
            if applied.args.count == 0
                continue
            . given [TypeId]
            for value in tree.children[applied.args]
                . sheet = types.intrinsic-of(receiver) == .style-sheet
                . scope = enter-theme
                    - if sheet then no-type else writer
                    - if sheet then receiver else no-type
                    - nested
                . type = infer(value)
                leave-theme(scope)
                if type == invalid-type || type == no-type
                    =
                given += type
            . (level, member, taken, mismatch) = match-style-rule(receiver, applied.name, given)
            . chosen = if level != no-type && level != invalid-type then member else DeclRef(0, 0)
            if level == no-type && !taken
                chosen = own-sheet-rule(receiver, applied.name, given)
            if chosen.decl != 0
                . wanted = rule-argument-types(chosen)
                for position in 0 .. < given.length
                    . value = tree.children[applied.args.start + position]
                    conversions.convert
                        - value
                        - value
                        - given[position]
                        - wanted![position]
                        - .reason-argument

────────────────────
_ do update-unit-property Bool
    - statement SyntaxId
    - line ASTAssign
    - receiver TypeId
    - name Atom

` A line of a style rule that names a property of the class that writes it, which sets the
` property where the rule is applied, as an attribute of a markup element sets one: the value
` is converted to the property's type as one assigned is. A value that reads something
` tracked or a slot of a style sheet is set again as it changes by a function of its own, as an
` attribute's is (`settle-update`), and one that reads a value the rule takes where an application
` gives it values that do (`values-live`). A property a setter answers, a getter, and one of an array are declined.
. place = property-named(receiver, name)
. property = types.properties[place!]
. live = tree.reads-tracked(line.rhs) || reads-slots(line.rhs)
if property.storage-kind == .storage-getter || is-hidden(property, name, .setter-decl)
    decline(statement)
    = false
. declared = property.type
if declared == no-type
    declared = demand-member(property, receiver, name)
if declared == no-type || declared == invalid-type || is-array-value(declared)
    decline(statement)
    = false
expect-bullets(line.rhs, declared)
. outer = unit-styling
unit-styling = unit-styling.updating = if live then statement else 0u32
. written = infer-with-expected(line.rhs, declared)
unit-styling = outer
if written == invalid-type || written == no-type
    = false
if conversions.convert(statement, line.rhs, written, declared, .reason-assignment) == invalid-type
    = false
. noted = panics.property-of(receiver, name)
if noted
    panics.note-write(instance, noted)
. given = !live && reads-rule-values(line.rhs)
facts.rule-updates += RuleUpdate(instance, statement, place! as U32, given)
if given
    owner-conversions(statement, receiver)
= !live || settle-update(statement, receiver, place! as U32)

────────────────────
_ do owner-conversions
    - statement SyntaxId
    - receiver TypeId

` Converts the object a line of a style rule that sets a property of its class is applied to, at
` the line, to the owner of the live action that sets it again: as its host where the class is a
` markup host, or as a batch where it is one.
. host = derived-interface(receiver, types.markup-host-decl)
if host != no-type
    conversions.convert(statement, statement, receiver, host, .reason-markup-host)
if is-batch(receiver)
    conversions.convert(statement, statement, receiver, batch-type(), .reason-markup-batch)

────────────────────
_ do settle-update Bool
    - statement SyntaxId
    - receiver TypeId
    - place U32

` Types the function that sets again the property a line of a style rule sets where its value
` read something tracked, as `settle-attributes` types an attribute's: the local no name
` reaches that keeps the object, declared at the line, holds one of the class. The action is
` made where the rule is applied (`rule-updater`), for the object as its host where the class
` is a markup host, to which it is converted at the line, or as a batch where it is one.
. position = facts.live-statements.length
while position != 0
    position -= 1
    . live = facts.live-statements[position]
    if live.instance != instance || live.site != statement || live.rerun != no-instance
        continue
    . resolution = bindings.resolution-of(frame.binding, statement)
    if resolution.kind != .resolve-slot || types.intrinsic-of(receiver) != .class
        decline(statement)
        = false
    frame.assign(resolution.slot, receiver)
    . rerun = demand-lambda(intern-nested(nested-decl-of(statement)), scratch.no-types)
    if rerun == no-instance || instances.signatures[rerun].errors.count != 0
        decline(statement)
        = false
    instances.mark-may-panic(instance)
    facts.live-statements[position] = LiveStatement(instance, statement, rerun, 0, place)
    owner-conversions(statement, receiver)
    = true
. resolution = bindings.resolution-of(frame.binding, statement)
if resolution.kind == .resolve-slot
    frame.assign(resolution.slot, receiver)
= true

────────────────────
_ do declare-unit-style Bool
    - statement SyntaxId
    - rule SyntaxId
    - receiver TypeId
    - styles [TypeId]
    - order U32

do match? tree.nodes[statement]
    | .node-assign(line)
        . name = style-name(tree, line.lhs)
        . sheet = types.intrinsic-of(receiver) == .style-sheet
        if line.op != .eq-op || !name || (!sheet && property-named(receiver, name))
            decline(statement)
            = false
        . (index, position) = find-style-property(styles, name, statement)
        if position == U32.max
            if (index == U32.max && program.module-by-name("core/style")) || sheet
                decline(statement)
            else if index == U32.max
                frame.diagnose(line.lhs, .stated, program.store-atom("Property not found"))
            = false
        . property = facts.style-properties[position]
        if sheet
            . slotted = declare-own-slot
                - statement
                - rule
                - index
                - position
                - order
                - line.rhs
                - receiver
            if slotted != 0
                = slotted == 1
            if reads-sheet-member(line.rhs, receiver)
                decline(statement)
                = false
        if tree.is-inherit(line.rhs)
            = declare-inherit(statement, rule, index, position, 0, order)
        if !sheet && defers-slot(line.rhs)
            if !demand-style-sites() || !demand-sheet-declarations()
                decline(statement)
                = false
            facts.add-style-declaration
                - StyleDeclaration
                    - instance
                    - rule
                    - statement
                    - facts.style-uses[index].type
                    - position
                    - 0
                    - order
                    - true
                    - false
                    - false
                    - U32.max - 1
            = true
        if !style-value-ready(property.type) || !demand-style-sites()
            decline(statement)
            = false
        . live = tree.reads-tracked(line.rhs) || reads-slots(line.rhs)
        if live && (reads-rule-values(line.rhs) || !demand-style-authors(receiver))
            decline(statement)
            = false
        . outer = unit-styling
        unit-styling = unit-styling.styling = if live then statement else 0u32
        . scope = enter-theme
            - if sheet then no-type else rule-writer(receiver)
            - if sheet then receiver else no-type
            - statement
        . written = style-value(line.rhs, property.type)
        . themed = leave-theme(scope)
        unit-styling = outer
        if written == invalid-type || written == no-type
            = false
        if conversions.convert(statement, line.rhs, written, property.type, .reason-assignment) == invalid-type
            = false
        if themed != U32.max
            = declare-themed(statement, rule, index, position, 0, order, line.rhs, themed)
        . cached = !live && holds-handle(property.type) && declaration-static(line.rhs)
        if cached
            note-static-value(statement, property.type)
        . declaration = StyleDeclaration
            - instance
            - rule
            - statement
            - facts.style-uses[index].type
            - position
            - 0
            - order
            - fixed-style-value(line.rhs)
            - false
            - cached
        declaration.reads-given = !live && reads-rule-values(line.rhs)
        if !live && !declaration.fixed && !cached
            . given = rule-value-slots(rule)
            if given.length != 0
                if holds-handle(property.type)
                    declaration.once-given = given-static(line.rhs, given)
                else
                    declaration.fixed-given = given-fixed(line.rhs, given)
        facts.add-style-declaration(declaration)
        if live
            facts.style-authors += StyleAuthor(instance, statement)
        = true
decline(statement)
= false

────────────────────
_ do declare-inherit Bool
    - statement SyntaxId
    - element SyntaxId
    - index U32
    - position U32
    - layer U32
    - order U32

` A declaration of `inherit`, as the reference makes one: the runtime takes the property's value
` from the parent as it settles, for a property that is `@inherited`; for any other it is the
` reference's error.
. property = facts.style-properties[position]
if (property.flags /and/ 1) == 0
    frame.diagnose(statement, .stated, program.store-atom("Style property \"${property.name.text}\" is not @inherited, so it cannot be assigned \"inherit\""))
    = false
if !demand-style-inherits()
    decline(statement)
    = false
facts.add-style-declaration
    - StyleDeclaration
        - instance
        - element
        - statement
        - facts.style-uses[index].type
        - position
        - layer
        - order
        - true
        - true
= true

────────────────────
_ do style-value-ready Bool
    - type TypeId

` Whether the runtime has what declares a value of a style property's type: a number or a
` truth is its own bits, as is a union whose cases are each a whole number of at most 32 bits;
` an object, a value boxed, and any other union are held by the runtime's holders
` (`demand-style-holders`), each case of a union that is no such number by its own. A union
` nested in a union has no shape here.
if !holds-handle(type)
    = true
if !demand-style-holders()
    = false
. inner = if types.is-optional(type) then types.optional-inner(type) else type
if types.intrinsic-of(inner) != .union
    = style-holder-ready(inner)
for item in types.cases-of(inner)
    if !inline-style-case(item.type) && !style-holder-ready(item.type)
        = false
= true

────────────────────
_ do style-holder-ready Bool
    - type TypeId

` Whether a style value of a type that is no union has a holder of the runtime's: an object
` its `StyleValueHolder`, which takes it as its optional, and any other value its box. The
` instance typed is noted as holding an object so (`Facts.coding-users`).
if types.intrinsic-of(type) == .union
    = false
. object = types.intrinsic-of(type) == .class
if !demand-style-coding(type, object)
    = false
if !object
    = true
for position in 0 .. < facts.style-codings.length
    . coding = facts.style-codings[position]
    if coding.type == type && coding.intern != no-instance
        if coding.value-holder == no-instance
            . box = types.well-known-type-of("core/style", "StyleValueHolder", type)
            if box == invalid-type
                = false
            . mark = scratch.types.mark
            scratch.types.push(coding.taken)
            . holder = calls.demand-constructor(box, mark)
            scratch.types.rewind(mark)
            if holder == no-instance
                = false
            facts.style-codings[position].value-holder = holder
        facts.coding-users += CodingUser(instance, type, true)
        = true
= false

────────────────────
_ do holds-handle Bool
    - type TypeId

` Whether the runtime holds a handle to a value of a style property's type, as the reference's
` `styleValueNeedsHolder` says: an object, a value boxed, or a union with a case that is no
` whole number of at most 32 bits.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
if scalar-style(inner)
    = false
if types.intrinsic-of(inner) != .union
    = true
for item in types.cases-of(inner)
    if !inline-style-case(item.type)
        = true
= false

────────────────────
_ inline-style-case Bool
    - type TypeId

` Whether a case of a union style value is kept in the slot's bits above its number: a whole
` number of at most 32 bits.
size > 0 && size <= 32 && is-integer-kind(types.intrinsic-of(type))

.. size = types.completions[type].bit-size

────────────────────
_ do declaration-static Bool
    - value SyntaxId

` Whether a style value reads nothing that differs from one making of the element, or one
` application of the rule, to the next, as the reference's `styleExpressionIsDeclarationStatic`
` says: no style, no name tracked, no `this`, and no local, argument or member.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . kind = bindings.resolution-of(frame.binding, node).kind
            if kind == .resolve-slot || kind == .resolve-member
                = false
= true

────────────────────
_ do note-static-value
    - statement SyntaxId
    - type TypeId

` A value the reference evaluates once for every making of the declaration that writes it,
` which a function of its own evaluates (`Facts.note-static-value`).
facts.note-static-value(module, statement, instance, type)

────────────────────
_ do demand-style-holders Bool

` The functions of the style runtime a declaration of a value it holds a handle to calls, typed
` once: the declaration by a holder for an association and again by a live action, and the
` declaration of a value evaluated once for every making, for a site and for an association.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
if runtime.template-object == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . pointer = types.well-known-type("core", "Pointer")
    . maker = types.well-known-type("core/style", "StyleStaticMaker")
    . base = types.well-known-type("core/style", "StyleObjectHolder")
    if info-missing || pointer == invalid-type || maker == invalid-type || base == invalid-type
        = false
    .. info-missing = info == invalid-type || association == invalid-type
    if runtime.held == no-type
        runtime.held = types.optional-of(base)
    . mark = scratch.types.mark
    scratch.types.push(association)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.template-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-object")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.size-type)
    scratch.types.push(maker)
    runtime.site-cached = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-static-cached")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.author-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-dynamic-object")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= template-ready && runtime.author-object != no-instance
    .. template-ready = runtime.template-object != no-instance && runtime.site-cached != no-instance

────────────────────
_ do demand-style-inherits Bool

` The function of the style runtime a declaration of `inherit` calls, with those of a site,
` typed once.
if !demand-style-sites()
    = false
. runtime = facts.style-runtime
if runtime.site-inherit == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . mark = scratch.types.mark
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    runtime.site-inherit = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-inherit")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.site-inherit != no-instance

────────────────────
_ do reads-slots Bool
    - value SyntaxId

` Whether a value reads a slot of a style sheet by `$name` (`read-variable`), which a theme
` switch changes: a name some sheet declares a slot of. A read of a style's property is not
` tracked.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression(row)
            if names-sheet-slot(row.name)
                = true
= false

────────────────────
_ do reads-rule-values Bool
    - value SyntaxId

` Whether a value of a style rule reads a value the rule takes.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-identifier
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot && not-this
                = true
            .. not-this = bindings.slots[resolution.slot].kind != .slot-this
= false

────────────────────
_ scalar-style Bool
    - type TypeId

` Whether a style property's value is kept in its slot as itself: a number, a truth or a
` character, not optional, as the reference's `NumberType` is.
intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    .. kind = types.intrinsic-of(type)

────────────────────
_ do style-value TypeId
    - value SyntaxId
    - declared TypeId

` The type of the value a style declaration gives a property of a type, as the reference's
` `compileStyleDeclarationExpression` reads it: a name alone, untracked, that names a case of the
` property's union that holds nothing is that case, before anything else the name may be, and is
` planned as `static-get` plans a case named on its union; any other value is typed as expected.
do match? tree.nodes[value]
    | .node-identifier(row)
        if !row.is-tracked && bare-case(declared, row.name)
            . union = if types.is-optional(declared) then inner else declared
                .. inner = types.optional-inner(declared)
            . cased = static-get(value, union, row.name)
            facts.replace-node-type(instance, value, cased)
            = cased
= infer-with-expected(value, declared)

────────────────────
_ do bare-case Bool
    - declared TypeId
    - name Atom

. union = if types.is-optional(declared) then types.optional-inner(declared) else declared
=? false if types.intrinsic-of(union) != .union
for fact in types.cases[types.completion-of(union).cases]
    if fact.name && fact.name! == name && (fact.is-default || fact.type == no-type)
        = true
= false

────────────────────
_ do fixed-style-value Bool
    - value SyntaxId

` Whether a style value reads nothing that can differ from one making of the element to the
` next, as the reference's `styleExpressionIsStatic` says: no style, no name tracked, no
` `this`, and no local, member or global but `true`, `false` and `null`.
for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot || resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-global && not-literal
                = false
            .. not-literal = !types.is-literal-global(resolution.module, resolution.decl)
= true

────────────────────
_ do rule-value-slots [SlotId]
    - rule SyntaxId

. slots [SlotId]
do match? tree.nodes[rule]
    | .node-rule-syntax(declared)
        for arg in tree.children[declared.args]
            do match? tree.nodes[arg]
                | .node-argument-decl(shape)
                    do match? tree.nodes[shape.pattern]
                        | .node-type-capture(capture)
                            . resolution = bindings.resolution-of(frame.binding, capture.id)
                            if resolution.kind == .resolve-slot
                                slots += resolution.slot
= slots

────────────────────
_ do given-fixed Bool
    - value SyntaxId
    - given [SlotId]

for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-slot && given.find(resolution.slot) == null
                = false
            if resolution.kind == .resolve-global && not-literal
                = false
            .. not-literal = !types.is-literal-global(resolution.module, resolution.decl)
= true

────────────────────
_ do given-static Bool
    - value SyntaxId
    - given [SlotId]

for node in tree.subtree-start(value) .. value
    do match? tree.nodes[node]
        | .node-style-read-expression
            = false
        | .node-identifier(row)
            if row.is-tracked || row.name.text == "this"
                = false
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-member
                = false
            if resolution.kind == .resolve-slot && given.find(resolution.slot) == null
                = false
= true

────────────────────
_ do share-written-values
    - index U32
    - written AST
    - binding BindingId

. fixed = true
. static = true
do match written.nodes[facts.style-applications[index].written]
    | .node-style-rule-application(applied)
        for value in written.children[applied.args]
            for node in written.subtree-start(value) .. value
                do match? written.nodes[node]
                    | .node-style-read-expression
                        fixed = false
                        static = false
                    | .node-get-expression(row)
                        if row.is-tracked
                            fixed = false
                            static = false
                    | .node-identifier(row)
                        . resolution = bindings.resolution-of(binding, node)
                        if tracked-or-this || resolution.kind == .resolve-slot || member-read
                            fixed = false
                            static = false
                        .. tracked-or-this = row.is-tracked || row.name.text == "this"
                        .. member-read = resolution.kind == .resolve-member
                        if resolution.kind == .resolve-global && !literal
                            fixed = false
                        .. literal = types.is-literal-global(resolution.module, resolution.decl)
    ??
        =
facts.style-applications[index].fixed-values = fixed
facts.style-applications[index].static-values = static
revise-application(index)

────────────────────
_ do bind-given-slots Bool
    - index U32
    - application SyntaxId
    - unit InstanceId
    - home ModuleId
    - reader InstanceId

` Binds the values a style rule is given as slots of style sheets where it is applied: a line
` that declares one alone takes the slot (`rule-slots`), and one that computes with them is
` evaluated from the slots by the runtime (`rule-themes`). Any other read of such a value is
` reported.
. written = program.modules[home].tree
. applied = match? written.nodes[application]
    | .node-style-rule-application(written)
        written
if !applied
    = true
. row = instances.rows[unit]
. owner = program.modules[row.module]
. names [SyntaxId]
. body SyntaxId = 0
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        body = rule.syntax
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for arg in owner.tree.children[declared.args]
                    do match? owner.tree.nodes[arg]
                        | .node-argument-decl(shape)
                            do match? owner.tree.nodes[shape.pattern]
                                | .node-type-capture(capture)
                                    names += capture.id
. params [SlotId]
. reads [ThemeRead]
. values [SyntaxId]
. positions [U32]
for position in 0 .. < applied.args.count
    . value = written.children[applied.args.start + position]
    . read = facts.theme-read-of(reader, value)
    if !read
        for node in written.subtree-start(value) .. value
            if facts.theme-read-of(reader, node)
                report-at(home, node, "A style rule takes a StyleSheet slot only alone, as in \"• bg:panel-color\", not in an expression")
                = false
        continue
    if position >= names.length || body == 0
        decline(application)
        = false
    params += bindings.resolution-of(row.binding, names[position]).slot
    reads += read
    values += value
    positions += position
=? true if params.length == 0
. covered [SyntaxId]
. count = facts.style-declarations.length as U32
. place = facts.first-style-declaration(unit)
while place < count
    . declared = facts.style-declarations[place]
    place = facts.next-style-declaration(place)
    . rhs SyntaxId = 0
    do match? owner.tree.nodes[declared.site]
        | .node-assign(line)
            rhs = line.rhs
    if rhs == 0
        continue
    if owner.tree.nodes[rhs] is .node-identifier
        . resolution = bindings.resolution-of(row.binding, rhs)
        . found = params.find(resolution.slot) if resolution.kind == .resolve-slot
        if found == null
            continue
        . read = reads[found]
        . use = facts.style-sheet-uses[read.sheet]
        . slot = facts.sheet-slots[use.first + read.slot]
        . (number, offset, projection) = slot-binding(row.module, declared.site, declared.property, rhs, slot.name, use.type, application)
        if number == U32.max
            = false
        revise-application(index)
        facts.add-rule-slot(RuleSlot(index, declared.site, number, offset, projection))
        covered += rhs
        continue
    . given = given-reads(unit, rhs, params)
    if !given || given.length == 0
        continue
    if !bind-given-theme(index, unit, declared, given, params, reads, values, positions, home, application, applied.name)
        = false
    for node in given
        covered += node
for node in owner.tree.subtree-start(body) .. body
    if names.find(node) != null || covered.find(node) != null || not-identifier
        continue
    .. not-identifier = !(owner.tree.nodes[node] is .node-identifier)
    . resolution = bindings.resolution-of(row.binding, node)
    . found = params.find(resolution.slot) if resolution.kind == .resolve-slot
    if found != null
        . read = reads[found]
        . slot = facts.sheet-slots[facts.style-sheet-uses[read.sheet].first + read.slot]
        report-at(home, values[found], "Style rule \"${applied.name.text}\" computes with what it is given, so it cannot take StyleSheet slot \"${slot.name.text}\"")
        = false
= true

────────────────────
_ do given-reads [SyntaxId]?
    - unit InstanceId
    - value SyntaxId
    - params [SlotId]

` The names by which a value a line of a style rule declares reads the values the rule takes as
` slots of style sheets (`params`); none where it also reads another local, a member, a style, a
` slot of a style sheet or anything tracked, which the runtime cannot evaluate from the slots.
. row = instances.rows[unit]
. source = program.modules[row.module].tree
. found [SyntaxId]
for node in source.subtree-start(value) .. value
    if facts.theme-read-of(unit, node)
        = null
    do match? source.nodes[node]
        | .node-style-read-expression
            = null
        | .node-identifier(ident)
            if ident.is-tracked || ident.name.text == "this"
                = null
            . resolution = bindings.resolution-of(row.binding, node)
            if resolution.kind == .resolve-member
                = null
            if resolution.kind == .resolve-slot
                if params.find(resolution.slot) == null
                    = null
                found += node
= found

────────────────────
_ do bind-given-theme Bool
    - index U32
    - unit InstanceId
    - declared StyleDeclaration
    - given [SyntaxId]
    - params [SlotId]
    - reads [ThemeRead]
    - values [SyntaxId]
    - positions [U32]
    - home ModuleId
    - application SyntaxId
    - name Atom

` Records that a line of a style rule applied at `application` computes its value with the values
` the rule takes as slots of one style sheet, read by the names `given`, as a value the runtime
` evaluates from the slots of the subtree's sheet (`rule-themes`). Each slot must have the type
` the rule takes its value as.
. row = instances.rows[unit]
. taken = rule-argument-types(DeclRef(row.module, row.initializer))
. givens [ThemedGiven]
. sheet = U32.max
for node in given
    . found = params.find(bindings.resolution-of(row.binding, node).slot)!
    . read = reads[found]
    . use = facts.style-sheet-uses[read.sheet]
    . slot = facts.sheet-slots[use.first + read.slot]
    if sheet != U32.max && sheet != read.sheet
        report-at(home, values[found], "A style value reads slots of one StyleSheet: \"${slot.name.text}\" is a slot of ${type-short-name(types, use.type)}, and others it reads are slots of ${type-short-name(types, facts.style-sheet-uses[sheet].type)}")
        = false
    sheet = read.sheet
    . wanted = if taken && place < taken.length then taken[positions[found] as Size] else no-type
        .. place = positions[found] as Size
    if wanted != slot.type
        report-at(home, values[found], "Style rule \"${name.text}\" takes ${type-display(types, wanted)}, so it can compute only with a StyleSheet slot of that type, not \"${slot.name.text}\" of type ${type-display(types, slot.type)}")
        = false
    . param = params[found]
    . seen = false
    for item in givens
        if item.param == param
            seen = true
    if !seen
        givens += ThemedGiven(param, read.slot)
if !demand-themed-runtime()
    decline(application)
    = false
. property = facts.style-properties[declared.property]
. themed = facts.note-given-themed-value
    - row.module
    - declared.site
    - unit
    - property.type
    - sheet
    - givens
revise-application(index)
facts.add-rule-theme(RuleTheme(index, declared.site, themed))
= true

────────────────────
_ do demand-style-sites Bool

` The functions of the style runtime a markup element that declares styles calls, typed once.
` The element's object is given to them as the `Pointer` the reference casts it to.
if !demand-style-runtime()
    = false
. runtime = facts.style-runtime
if runtime.info-required == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . association = types.well-known-type("core/style", "StyleSiteAssociation")
    . pointer = types.well-known-type("core", "Pointer")
    if info == invalid-type || association == invalid-type || pointer == invalid-type
        = false
    . mark = scratch.types.mark
    scratch.types.push(types.index-type)
    runtime.info-required = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-info-required")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.site-static = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-site-static")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(association)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.template-static = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-template-static")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(types.size-type)
    runtime.associate = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-associate")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    runtime.site-ready = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-ready")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    runtime.site-recording = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-recording")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(types.size-type)
    runtime.site-recorded = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-site-recorded")
        - mark
    scratch.types.rewind(mark)
    facts.style-runtime = runtime
= runtime.info-required != no-instance && runtime.site-static != no-instance && runtime.template-static != no-instance && runtime.associate != no-instance && runtime.site-ready != no-instance && runtime.site-recording != no-instance && runtime.site-recorded != no-instance

────────────────────
+ do infer-style-read Found
    - id SyntaxId
    - row ASTStyleReadExpression

` A read of a style property, `$name`, of an object or of `this`: the value the style runtime
` holds for the object, resolved against the styles the subject's class sees and those of the
` class the read is written in, as the reference resolves it, read by `style-read-bits` and
` taken as the property's type, the subject cast to a `Pointer` as the reference casts it. An
` optional is read with whether it holds nothing by `style-read-optional`, and a value the
` runtime holds a handle to is resolved from it (`style-read-ready`). A name no style answers
` that names the flag of a domain reads the flag; any other is the reference's error. A read
` written after `?` is a link of an optional chain, read from what the optional holds, as the
` reference's `pushChain` makes one. A read of an optional chain written in parentheses, of
` an optional otherwise, and of no class or interface, are declined. A read with no object where
` there is no `this` finds no property, the reference's error. The runtime's reader is a call,
` which ends what is known of properties.
if !program.module-by-name("core/style")
    frame.diagnose(id, .stated, program.store-atom("Style runtime is not loaded"))
    = Found(invalid-type)
. subject = frame.self-type
. chained = false
if row.object != 0
    if tree.optional-chain-expr(row.object) != 0
        decline(id)
        = Found(invalid-type)
    . object-found = infer-found(row.object)
    . object = object-found.type
    . own = object-found.link
    if object == invalid-type
        = Found(invalid-type)
    . form = if row.is-optional then note-chain(id, id, object) else ChainForm.chain-plain
    if form == .chain-absent || absent-after(row.object, object)
        = Found(types.null-type)
    . optional = form == .chain-tested
    subject = link-receiver(row.object, object, own, optional)
    chained = (optional || optional-chained(row.object)) && types.is-optional(object)
    if chained && optional
        facts.unwrapped.append(UnwrappedFact(instance, row.object, subject))
if subject == no-type || subject == invalid-type
    frame.diagnose(id, .stated, program.store-atom("Style property \"${row.name.text}\" not found"))
    = Found(invalid-type)
if types.is-optional(subject) || (types.intrinsic-of(subject) != .class && not-interface)
    decline(id)
    = Found(invalid-type)
.. not-interface = types.intrinsic-of(subject) != .interface
. styles [TypeId]
if !add-visible-styles(subject, styles, id) || !add-visible-styles(frame.self-type, styles, id)
    = Found(invalid-type)
. (index, position) = find-style-property(styles, row.name, id)
if position == U32.max
    if index != U32.max
        = Found(invalid-type)
    . text = row.name.text
    . (domain, below) = accessor-domain(text)
    if domain.length != 0
        = Found(flag-domain(id, domain, below, row.object == 0, false))
    . variable = read-variable(id, row.name, subject, chained)
    if variable.type != no-type
        = variable
    frame.diagnose(id, .stated, program.store-atom("Style property \"$text\" not found"))
    = Found(invalid-type)
. property = facts.style-properties[position]
if !demand-style-runtime() || !style-read-ready(property.type)
    decline(id)
    = Found(invalid-type)
. module-id = class-ref(types, types.type-row(.style)).module
. optional = types.is-optional(property.type)
. mark = scratch.types.mark
scratch.types.push(subject)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
. reader = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom(if optional then "style-read-host-optional" else "style-read-host-bits")
    - mark
scratch.types.rewind(mark)
. hosted = reader != no-instance
if !hosted
    . pointer = types.well-known-type("core", "Pointer")
    scratch.types.push(pointer)
    scratch.types.push(types.index-type)
    scratch.types.push(types.size-type)
    reader = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom(if optional then "style-read-optional" else "style-read-bits")
        - mark
    scratch.types.rewind(mark)
    if pointer == invalid-type
        reader = no-instance
if reader == no-instance
    decline(id)
    = Found(invalid-type)
facts.style-reads += StyleRead(instance, id, facts.style-uses[index].type, position, reader, hosted)
frame.forget-members()
= Found(if chained then types.optional-of(property.type) else property.type).linking(property.type)

────────────────────
+ do infer-style-property TypeId
    - id SyntaxId
    - row ASTStylePropertyExpression

if !program.module-by-name("core/style")
    frame.diagnose(id, .stated, program.store-atom("Style runtime is not loaded"))
    = invalid-type
. styles [TypeId]
if !add-visible-styles(frame.self-type, styles, id)
    = invalid-type
. (index, position) = find-style-property(styles, row.name, id)
if position == U32.max
    if index != U32.max
        = invalid-type
    frame.diagnose(id, .stated, program.store-atom("Style property \"${row.name.text}\" not found"))
    = invalid-type
. value = facts.style-properties[position].type
. component = U32.max
. part = row.component
if part
    if types.intrinsic-of(value) == .tuple
        . fields = types.properties-of(value)
        for field in 0 .. < fields.length
            if fields[field].name == part
                component = field as U32
    if component == U32.max
        frame.diagnose
            - id
            - .stated
            - program.store-atom
                - "Style property \"${row.name.text}\" has no component \"${part.text}\""
        = invalid-type
    value = types.properties-of(value)[component].type
if !demand-style-runtime()
    decline(id)
    = invalid-type
. module-id = class-ref(types, types.type-row(.style)).module
. mark = scratch.types.mark
scratch.types.push(value)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
if part
    scratch.types.push(types.index-type)
. maker = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom(if part then "style-property-component" else "style-property")
    - mark
    - 1
scratch.types.rewind(mark)
if maker == no-instance
    decline(id)
    = invalid-type
facts.style-reads += StyleRead
    - instance
    - id
    - facts.style-uses[index].type
    - position
    - maker
    - false
    - U32.max
    - 0
    - no-type
    - component
    - true
= instances.signatures[maker].returns

────────────────────
_ do read-variable Found
    - id SyntaxId
    - name Atom
    - subject TypeId
    - chained Bool

. sheets [TypeId]
. levels [U32]
add-sheet-groups(subject, sheets, levels)
add-sheet-groups(frame.self-type, sheets, levels)
. found = no-type
for sheet in sheets
    . root = family-root(sheet)
    if root != found && sheet-has-slot(root, name)
        if found != no-type
