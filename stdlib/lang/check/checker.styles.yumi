    =? parts if facets.count == 0
    . (start, end) = facets.class-range(ref.module, ref.decl)
    for position in start .. < end
        . facet = facets.class-facets[position]
        if facets.states[facet] == .facet-bound
            parts += DeclRef(facets.modules[facet], facets.decls[facet])
    = parts
. key = ((ref.module as Size) /lshift/ 32) /or/ (ref.decl as Size)
. next = facts.sheet-extension-heads[key] ?? U32.max
while next != U32.max
    . held = facts.sheet-extensions[next]
    parts += DeclRef(held.module, held.decl)
    next = held.next
