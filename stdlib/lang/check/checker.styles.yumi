+ do is-sheet-decl Bool
    - owner-module ModuleId
    - decl DeclId

` Whether a class a module declares is a style sheet, declared `• Name`, or the declaration is
` an extension of one, `• extend Name`, whose members the sheet has.
. owner = program.modules[owner-module]
do match? owner.decls[decl]
    | .decl-class(class)
        do match? owner.tree.nodes[class.syntax]
            | .node-class-block(row)
                = row.is-style-sheet
    | .decl-sheet-extension
        = true
= false

────────────────────
+ is-sheet-type Bool
    - type TypeId

|? type == no-type || type == invalid-type || types.intrinsic-of(type) != .style-sheet
    false
??
    is-sheet-decl(ref.module, ref.decl)

.. ref = class-ref(types, type)

────────────────────
_ do list-derived-sheets

=? if facts.derived-listed
facts.derived-listed = true
for position in 0 .. < program.declare-order.length
    . home = program.declare-order[position] as ModuleId
    . owner = program.modules[home]
    for index in 0 .. < owner.decls.length
        if owner.decls[index] is .decl-class && is-sheet-decl(home, index as DeclId)
            . mark = scratch.types.mark
            . sheet = types.intern-class(home, index as DeclId, mark)
            types.complete(sheet)
            if is-sheet-type(types.base-of(sheet) ?? no-type)
                facts.derived-sheets += sheet

────────────────────
+ do check-derived-sheet
    - index DeclId
    - class ClassDecl

. mark = scratch.types.mark
. sheet = types.intern-class(module, index, mark)
types.complete(sheet)
. base = types.base-of(sheet) ?? no-type
. tags = match tree.nodes[class.syntax]
    | .node-class-block(row)
        row.tags
    ??
        RowRange'Atom()
if !is-sheet-type(base)
    if base == invalid-type || base == no-type
        do match? tree.nodes[class.base]
            | .node-type-identifier(ident)
                frame.diagnose
                    - class.base
                    - .stated
                    - program.store-atom("StyleSheet base \"${ident.name.text}\" not found")
    else if base != types.type-row(.style-sheet)
        frame.diagnose
            - class.base
            - .stated
            - program.store-atom
                - "StyleSheet base \"${type-short-name(types, base)}\" is not a StyleSheet"
    else if tags.count != 0
        frame.diagnose(class.syntax, .stated, program.store-atom("StyleSheet \"${class.name.text}\" takes tags only where it derives from another StyleSheet"))
    =
for offset in 0 .. < tags.count
    . tag = tree.atoms[tags.start + offset]
    for earlier in 0 .. < offset
        if tree.atoms[tags.start + earlier] == tag
            frame.diagnose
                - class.syntax
                - .stated
                - program.store-atom("StyleSheet tag \"${tag.text}\" is repeated")
            =
. owner = program.modules[module]
for member in owner.member-pool[class.members]
    do match? owner.decls[member]
        | .decl-property(property)
            . named = property.name
            if named
                . found = property-named(base, named)
                if !found || !is-sheet-type(types.properties[found].owner)
                    frame.diagnose(property.syntax, .stated, program.store-atom("Derived StyleSheet \"${class.name.text}\" can only override slots of ${type-short-name(types, base)}, which has no slot \"${named.text}\""))

