` (`outer-cells`), first of all the `when`s that gate it, unless they hold them already
` (`cell-whens`). The content its lines generate follows its own
` declarations, and that of each `when` its declarations, each taking an order
` (`generate-content`). A rule written in a rule reads the `values` of the rule around it that
` takes some; one the element `gives` values holds them for the rules written in it
` (`scope-values`), but not within another that does.
. row = instances.rows[unit]
. owner = program.modules[row.module]
. index = facts.style-applications.length as U32
facts.style-applications += StyleApplication
    - instance
    - module
    - id
    - unit
    - 2
    - order
    - written
    - outer
    - within
facts.style-applications[index].around-values = values
revise-application(index)
if types.intrinsic-of(row.self-type) == .class && !bind-rule-slots(id, made, unit, index)
    = U32.max
. whens = cell-whens(id, made, gated, cell, outer-cells, index)
if !whens
    = U32.max
. gates = whens
if facts.authors-in(unit)
    . action = demand-style-gates(made)
    if action == no-instance
        decline(id)
        = U32.max
    facts.style-applications[index].action = action
    revise-application(index)
if written != 0
    . (live, local) = values-live(written, outer)
    if live && local
        decline(id)
        = U32.max
    if live
        facts.style-applications[index].live-values = true
        revise-application(index)
    if live && facts.updates-given(unit)
        demand-live-runtime()
    if live && facts.reads-given-in(unit)
        . action = demand-style-gates(made)
        if action == no-instance || !demand-style-authors(made)
            decline(id)
            = U32.max
        facts.style-applications[index].action = action
        revise-application(index)
if !choose-updater(index, id, made)
    = U32.max
. next = order
active += unit
applied += unit
if gates.length != 0 && !gates-updates(unit)
    = U32.max
. around = instances.intern-frame(frames, row.module, row.initializer, row.self-type, 0)
. framed = values
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                if gives && owner.tree.holds-rules(rule.syntax)
