= invalid-type

────────────────────
_ do demand-style-writes Bool

` The functions of the style runtime an assignment that declares a style for an object calls,
` typed once, with the record of a style by its number.
if !demand-style-sites() || !demand-style-holders()
    = false
. runtime = facts.style-runtime
if runtime.imperative == no-instance
    . module-id = class-ref(types, types.type-row(.style)).module
    . info = types.well-known-type("core/style", "StyleInfo")
    . pointer = types.well-known-type("core", "Pointer")
    . mark = scratch.types.mark
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.type-row(.int64))
    scratch.types.push(types.bool-type)
    runtime.imperative = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-imperative")
        - mark
    scratch.types.rewind(mark)
    scratch.types.push(pointer)
    scratch.types.push(info)
    scratch.types.push(types.size-type)
    scratch.types.push(types.bool-type)
    scratch.types.push(runtime.held)
    scratch.types.push(types.type-row(.uint32))
    scratch.types.push(types.type-row(.int64))
    runtime.imperative-object = calls.demand-runtime-call
        - module-id
        - no-type
        - program.store-atom("style-author-imperative-object")
        - mark
    scratch.types.rewind(mark)
