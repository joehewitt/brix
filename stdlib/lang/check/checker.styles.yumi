        do match? owner.decls[member]
            | .decl-style-rule(other)
                if other.name == rule.name
                    do match? owner.tree.nodes[other.syntax]
                        | .node-rule-syntax(written)
                            . (same, known) = same-signature(owner.tree, written.args, tree, rule.args)
