                                    live = true
                                else
                                    local = true
                            .. not-this = bindings.slots[resolution.slot].kind != .slot-this
= (live, local)

────────────────────
_ do declares-only Bool
    - unit InstanceId
    - body SyntaxId
    - gates [StyleWhen]

` Whether a style rule applied under the condition a rule written on a markup element gives
` declares styles alone, as the reference requires of a rule so applied: its error is at the
` first line of its body that is no declaration, `when`, rule or generated content, or else at
` the first rule written in its body, or else in the body of one of its `when`s. True where no
` such condition gates it.
. conditioned = false
for held in gates
    conditioned = conditioned || held.test != no-instance
if !conditioned || body == 0
    = true
. row = instances.rows[unit]
. written = program.modules[row.module].tree
. lines [SyntaxId]
do match written.nodes[body]
    | .node-block(block)
        for line in written.children[block.body]
            lines += line
    ??
        lines += body
. found SyntaxId = 0
for line in lines
    . kind = written.nodes[line]
    if found == 0 && undeclared && !(kind is .node-rule-syntax) && !written.generates(line)
        found = line
    .. undeclared = !(kind is .node-assign) && !(kind is .node-style-when)
for line in lines
    if found == 0 && written.nodes[line] is .node-rule-syntax
        found = line
for branch in written.rule-whens(body)
    for line in written.when-lines(branch)
        if found == 0 && written.nodes[line] is .node-rule-syntax
            found = line
if found == 0
    = true
facts.record-diagnostic
    - instance
    - row.module
    - found
    - .stated
    - program.store-atom("Conditionally applied style rules may only contain style declarations")
    - no-type
    - no-type
= false

────────────────────
_ do apply-inner U32
    - id SyntaxId
    - made TypeId
    - unit InstanceId
    - nested SyntaxId
    - order U32
    - outer U32
    - within SyntaxId
    - gated [StyleWhen]
    - active [InstanceId]
    - applied [InstanceId]
    - around U32
    - cell U32 = U32.max
    - values U32 = U32.max
    - outer-cells U32 = U32.max

` Applies a rule a style rule applies, written at `nested` in the rule's module, from an order,
` as `apply-rule` says, those of the style sheets the element sees where no class of its chain
` answers the name (`sheet-rules`), within the rules applied `around` it, the state cells of the
` `when`s among them and the values of the one that takes some, and then those written in rules
` that the markup sees (`scope-rules`), each within its own. Declined: one with a
` condition, one a rule written in a rule may answer where those are not known, or that the
` rules the element applied before bring into view, which the reference sees as it gathers them
` but not as it applies them; a name some class or style sheet has but none takes the values
` given by, values given to rules of style sheets other than the one the rule's class chose for
` them (`sheet-values-alike`) or to a rule written in a rule, and a value that calls a function where
` the reference evaluates it once more but not here: it evaluates those the rules after the name
` of a rule a markup element applies give as it prepares the element, and again as the rule is
` applied, and the emitter does too (`prepared-rule`, marked on the rule's application). A
` constructor applying its rule `• This` or the rules of its root `<This` (`values-once`)
