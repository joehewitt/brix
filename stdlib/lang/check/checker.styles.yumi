                        - id
                        - made
                        - unit
                        - index
                        - owner.tree.when-content(branch)
                        - inner
                    if gated-content == U32.max
                        = U32.max
                    next += gated-content
active.pop()
= next + facts.style-declaration-count(unit)

────────────────────
_ do values-live (Bool, Bool)
    - written SyntaxId
    - outer U32

` Whether the values an application written after `•` gives read something tracked, or, for one
` a style rule applies, a value of the rule around it whose application has `live-values`: each
` declaration of the rule that reads them is declared again as they change. Then whether those
` of a markup element read a local of the function the element is written in, which the function
` that declares them again does not keep, so that the application is declined where they are live.
. around = outer != U32.max
. unit = if around then facts.style-applications[outer].unit else no-instance
. written-tree = if around then program.modules[instances.rows[unit].module].tree else tree
. binding = if around then instances.rows[unit].binding else frame.binding
. rooted = !around && written-tree.roots-values(written)
. live = false
. local = false
do match? written-tree.nodes[written]
    | .node-style-rule-application(applied)
        for value in written-tree.children[applied.args]
            for node in written-tree.subtree-start(value) .. value
                do match? written-tree.nodes[node]
                    | .node-get-expression(row)
                        live = live || row.is-tracked
                    | .node-identifier(row)
                        live = live || row.is-tracked
                        if !rooted
                            . resolution = bindings.resolution-of(binding, node)
                            if resolution.kind == .resolve-slot && not-this
                                if around
                                    live = live || facts.style-applications[outer].live-values
