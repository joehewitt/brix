if number == U32.max
    = Found(invalid-type)
. use = facts.style-sheet-uses[number]
. offset = U32.max
for place in use.first .. < use.first + use.count
    if facts.sheet-slots[place].name == name
        offset = place - use.first
if offset == U32.max
    decline(id)
    = Found(invalid-type)
. type = facts.sheet-slots[use.first + offset].type
if !demand-style-runtime() || !style-read-ready(type)
    decline(id)
    = Found(invalid-type)
. module-id = class-ref(types, types.type-row(.style)).module
. optional = types.is-optional(type)
. mark = scratch.types.mark
scratch.types.push(subject)
scratch.types.push(types.index-type)
scratch.types.push(types.size-type)
scratch.types.push(types.bool-type)
. reader = calls.demand-runtime-call
    - module-id
    - no-type
    - program.store-atom
        - if optional then "style-read-host-sheet-optional" else "style-read-host-sheet-bits"
    - mark
scratch.types.rewind(mark)
