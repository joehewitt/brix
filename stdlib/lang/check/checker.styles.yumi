= runtime.site-sheet != no-instance

────────────────────
_ do distinct-style Bool
    - index U32
    - visible [TypeId]
    - owner ModuleId
    - written SyntaxId
    - site SyntaxId

` Whether no property of a style is one a style seen before it names, which is reported.
. use = facts.style-uses[index]
for position in use.first .. < use.first + use.count
    . name = facts.style-properties[position].name
    for other in visible
        for seen in facts.style-uses
            if seen.type != other
                continue
            for place in seen.first .. < seen.first + seen.count
                if facts.style-properties[place].name == name
                    if owner != module
                        decline(site)
                    else
                        . message = "Style property \"${name.text}\" is declared by both ${type-short-name(types, other)} and ${type-short-name(types, use.type)}"
                        frame.diagnose(written, .stated, program.store-atom(message))
                    = false
= true

────────────────────
_ do style-index U32
    - used TypeId
    - site SyntaxId
    - constructs Bool

` The number of a style among those the program registers, given when it is first used, with
` its properties, base first, each kept in a stored property of the object its constructor
` makes; or none where the style is declined or reported. Each use is noted as the instance's,
` a constructor that `constructs` with it or a line that declares with it (`note-style-user`).
` A line of a style that names the domains a change to a property raises numbers each domain as
` it is first named, and each use names it (`place-style-domains`). The type of a property
` says how its value becomes the bits of a slot: a number is cast, an object is interned, a value
` of a union is its case's number below the bits its case's value becomes, and any other value is
` boxed and the box interned. Each use notes the codings of the properties
` (`note-style-codings`), so that what the instance records is the same whichever instance
` registered the style.
for position in 0 .. < facts.style-uses.length
    if facts.style-uses[position].type == used
        place-style-domains(used, site)
        note-style-codings(facts.style-uses[position])
        note-style-user(used, module, site, constructs)
        = position as U32
. chain [TypeId]
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    chain += level
    level = types.base-of(level)
. first = facts.style-properties.length as U32
for position in 0 .. < chain.length
    . ref = class-ref(types, chain[chain.length - 1 - position])
    . owner = program.modules[ref.module]
    . members = RowRange'DeclId()
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            members = class.members
    for member in owner.member-pool[members]
        do match? owner.decls[member]
            | .decl-property(property)
                if property.name && plain-member && style-property(first, property.name) == U32.max
                    if !add-style-property(used, property, ref.module, site)
                        = U32.max
                .. plain-member = !property.defaults-root && property.element == 0
    for member in owner.member-pool[members]
        do match? owner.decls[member]
            | .decl-style-domains(domains)
                if !add-style-domains(first, owner.tree, domains.syntax, ref.module, site)
                    = U32.max
. mark = scratch.types.mark
. singleton = calls.demand-constructor(used, mark)
if singleton == no-instance || !demand-style-runtime()
    decline(site)
    = U32.max
. index = facts.style-uses.length as U32
. last = facts.style-properties.length as U32
facts.style-uses += StyleUse(used, singleton, first, last - first)
note-style-user(used, module, site, constructs)
= index

────────────────────
_ do note-style-user
    - used TypeId
    - home ModuleId
    - site SyntaxId
    - constructs Bool

` Notes that the instance being checked uses a style or a style sheet at a place in a module,
` keeping the first such place, a constructor's before any other, among those it noted last.
. position = facts.style-users.length
while position > 0 && facts.style-users[position - 1].instance == instance
    position -= 1
    . user = facts.style-users[position]
    if user.type == used
        if (constructs == user.constructed && comes-first) || (constructs && !user.constructed)
            facts.style-users[position] = StyleUser(used, instance, home, site, constructs)
        .. comes-first = precedes(home, site, user.module, user.site)
        =
facts.style-users += StyleUser(used, instance, home, site, constructs)

────────────────────
_ do note-style-codings
    - use StyleUse

` Notes the instance being checked as using the codings the properties of a registered style
` turn values into bits by, as registering them does (`add-style-property`): an object's, a
` boxed value's, and those of the cases of a union that have one.
for position in use.first .. < use.first + use.count
    . declared = facts.style-properties[position].type
    . held = if types.is-optional(declared) then types.optional-inner(declared) else declared
    . kind = types.intrinsic-of(held)
    if kind == .union
        for item in types.cases-of(held)
            note-coding-user(item.type)
    else if kind == .class || boxed-style(kind)
        note-coding-user(held)

────────────────────
_ do note-coding-user
    - type TypeId

` Notes the instance being checked as using the coding of a type, where there is one.
for coding in facts.style-codings
    if coding.type == type
        facts.coding-users += CodingUser(instance, type)
        =

────────────────────
_ do style-property U32
    - first U32
    - name Atom

` The place of a property among those of the style being registered, or none.
for position in first .. < (facts.style-properties.length as U32)
    if facts.style-properties[position].name == name
        = position
= U32.max

────────────────────
_ do add-style-property Bool
    - used TypeId
    - property PropertyDecl
    - owner ModuleId
    - site SyntaxId

` Adds a property of a style being registered. Its annotation says it is inherited; any other
` is reported, as is a type written for it that names nothing, which the reference meets as it
` registers. One that is not stored in the object, or whose type has no bits a slot holds,
` is declined.
. name = property.name!
. found = property-named(used, name)
if !found
    decline(site)
    = false
. row = types.properties[found]
if row.storage-kind != .storage-eager
    decline(site)
    = false
. declared = if row.type == no-type then demand-member(row, used, name) else row.type
if declared == invalid-type && owner == module && property.type-syntax != 0
    . env = types.class-env(owner, property.owner)
    . reported = report-missing-type(property.type-syntax, env)
    types.env-release(env)
    if reported
        = false
if declared == invalid-type || declared == no-type
    decline(site)
    = false
. held = if types.is-optional(declared) then types.optional-inner(declared) else declared
if types.intrinsic-of(held) == .style
    if owner != module
        decline(site)
    else
        . message = "Style property \"${name.text}\" cannot have a Style type; use an object-valued property with an ordinary descriptor class instead"
        frame.diagnose(property.syntax, .stated, program.store-atom(message))
    = false
. flags = 0u32
. written = program.modules[owner].tree
do match? written.nodes[property.syntax]
    | .node-property-syntax(row)
        for offset in 0 .. < row.annotations.count
            . annotation = written.atoms[row.annotations.start + offset]
            if annotation.text != "inherited"
                if owner != module
                    decline(site)
                else
                    . message = "Unknown style property annotation \"@${annotation.text}\"; only \"@inherited\" is supported"
                    frame.diagnose(property.syntax, .stated, program.store-atom(message))
                = false
            flags = 1
. shift = 0u32
. tags = 0u64
. kind = types.intrinsic-of(held)
if kind == .union
    shift = 8
    flags = flags /or/ 2
    . cases = types.cases-of(held)
    for index in 0 .. < cases.length
        . coded = style-case(cases[index].type)
        if coded == U32.max
            decline(site)
            = false
        if coded == 2 && index < 64
            tags = tags /or/ (1u64 /lshift/ (index as U64))
else if intrinsic-is-numeric(kind) || kind == .bool
    if kind == .cpointer || kind == .number
        decline(site)
        = false
    if intrinsic-is-float(kind)
        flags = flags /or/ 4
else if kind == .class
    if !demand-style-coding(held, true)
        decline(site)
        = false
    flags = flags /or/ 8
else if boxed-style(kind)
    flags = flags /or/ 2
    tags = 1
    if !demand-style-coding(held, false)
        decline(site)
        = false
else
    decline(site)
    = false
facts.style-properties += StyleProperty(name, declared, row.slot, flags, shift, tags)
= true

────────────────────
_ do style-case U32
    - type TypeId

` How a case of a union a style property holds becomes bits: 0 for a whole number of at most
` 32 bits, inline below its case's number, 1 for an object, interned, and 2 for any other
` value, boxed. None for one that has no such bits.
. kind = types.intrinsic-of(type)
if is-integer-kind(kind) && inline-bits
    = 0
.. inline-bits = types.completions[type].bit-size > 0 && types.completions[type].bit-size <= 32
if kind == .class
    = if demand-style-coding(type, true) then 1 else U32.max
if intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    = if demand-style-coding(type, false) then 2 else U32.max
if boxed-style(kind)
    = if demand-style-coding(type, false) then 2 else U32.max
= U32.max

────────────────────
_ do demand-style-coding Bool
    - type TypeId
    - object Bool

` Types how values of a type that is no number become bits as styles register: an object by
` the runtime's `style-intern-object` for the type, and any other value by the constructor of
` its box and the runtime's `style-intern-holder`. The instance typed is noted as using them
` (`Facts.coding-users`).
for coding in facts.style-codings
    if coding.type == type
        facts.coding-users += CodingUser(instance, type)
        = true
. runtime = class-ref(types, types.type-row(.style)).module
. mark = scratch.types.mark
if object
    . taken = types.optional-of(type)
    scratch.types.push(type)
    scratch.types.push(taken)
    . intern = calls.demand-runtime-call
        - runtime
        - no-type
        - program.store-atom("style-intern-object")
        - mark
        - 1
    scratch.types.rewind(mark)
    if intern == no-instance
        = false
    facts.style-codings += StyleCoding(type, intern, no-instance, taken)
    facts.coding-users += CodingUser(instance, type)
    = true
. box = types.well-known-type-of("core/style", "StyleWideHolder", type)
if box == invalid-type
    = false
scratch.types.push(type)
. holder = calls.demand-constructor(box, mark)
scratch.types.rewind(mark)
if holder == no-instance
    = false
if facts.style-runtime.intern-holder == no-instance
    facts.style-runtime.held = types.optional-of
        - types.well-known-type("core/style", "StyleObjectHolder")
    scratch.types.push(facts.style-runtime.held)
    facts.style-runtime.intern-holder = calls.demand-runtime-call
        - runtime
        - no-type
        - program.store-atom("style-intern-holder")
        - mark
    scratch.types.rewind(mark)
    if facts.style-runtime.intern-holder == no-instance
        = false
facts.style-codings += StyleCoding(type, no-instance, holder)
facts.coding-users += CodingUser(instance, type)
= true

────────────────────
_ do add-style-domains Bool
    - first U32
    - tree AST
    - id SyntaxId
    - owner ModuleId
    - site SyntaxId

` Adds the domains a line of a style names for one of its properties, each numbered as it is
` first named, raised on the node itself, or on its parent where the line says so. A line
` naming no property of the style, or a place other than the node or its parent, is reported.
do match? tree.nodes[id]
    | .node-style-annotation(row)
        . name = tree.identifier-name(row.left)
        . position = if name then style-property(first, name) else U32.max
        if position == U32.max
            . message = "Style property \"${if name then name.text else ""}\" does not exist"
            report-style(id, owner, site, message)
            = false
        for item in tree.children[row.domains]
            do match? tree.nodes[item]
                | .node-style-domain-item(domain)
                    . domain-name = tree.identifier-name(domain.domain)
                    . target = tree.identifier-name(domain.target) if domain.target != 0
                    if !domain-name
                        decline(site)
                        = false
                    . index = style-domain(domain-name, module, site, owner, item)
                    if !target || target.text == "self"
                        facts.property-domains += PropertyDomain(position, index, false)
                    else if target.text == "parent"
                        facts.property-domains += PropertyDomain(position, index, true)
                    else
                        . message = "Unknown style invalidation target \"${target.text}\"; expected \"self\" or \"parent\""
                        report-style(id, owner, site, message)
                        = false
        = true
decline(site)
= false

────────────────────
_ do report-style
    - id SyntaxId
    - owner ModuleId
    - site SyntaxId
    - message String

` Reports a style written wrong where it is written, or declines the constructor that uses it
` where that is in another module.
if owner != module
    decline(site)
else
    frame.diagnose(id, .stated, program.store-atom(message))

────────────────────
+ do style-domain U32
    - name Atom
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` The place of a domain of invalidation among `style-domains`, made as it is first named. The
` instance typed is noted as naming it at `site` in `home` by `line` (`note-domain-user`). The 32
` the runtime holds are counted once the program is typed (`Typing.number-domains`).
. known = place-style-domain(name, home, site, line-module, line)
if known != U32.max
    = known
facts.style-domains += StyleDomain(name)
. index = (facts.style-domains.length - 1) as U32
note-domain-user(index, home, site, line-module, line)
= index

────────────────────
_ do place-style-domain U32
    - name Atom
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` The number of a domain of invalidation already named, or none. The instance typed is noted as
` naming it at `site` in `home` by `line` (`note-domain-user`).
for position in 0 .. < facts.style-domains.length
    if facts.style-domains[position].name == name
        note-domain-user(position as U32, home, site, line-module, line)
        = position as U32
= U32.max

────────────────────
_ do note-domain-user
    - domain U32
    - home ModuleId
    - site SyntaxId
    - line-module ModuleId
    - line SyntaxId

` Notes that the instance being checked names a domain of invalidation at `site` in `home`, by a
` line, keeping the first such place and line (`names-before`) among those it noted last.
` Program tables register the domain at the first of those of every instance, so the place is
` the same however instances are typed.
. user = DomainUser(instance, domain, home, site, line-module, line)
. position = facts.domain-users.length
while position > 0 && facts.domain-users[position - 1].instance == instance
    position -= 1
    if facts.domain-users[position].domain == domain
        if names-before(user, facts.domain-users[position])
            facts.domain-users[position] = user
        =
facts.domain-users += user

────────────────────
_ names-before Bool
    - user DomainUser
    - other DomainUser

` Whether an instance names a domain of invalidation before another does: at an earlier place,
` or at the same place by an earlier line, each in source order and then by its syntax, as
` program tables order the places of domains.
|? user.module != other.module || user.site != other.site
    placed-before(user.module, user.site, other.module, other.site)
??
    placed-before(user.line-module, user.line, other.line-module, other.line)

────────────────────
_ placed-before Bool
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Whether a place in the program comes before another in source order (`precedes`), or, where
` the two begin together in a module, has the lesser syntax.
|? precedes(module, site, other-module, other)
    true
|? precedes(other-module, other, module, site)
    false
??
    module == other-module && site < other

────────────────────
_ do place-style-domains
    - used TypeId
    - site SyntaxId

` Places the domains the lines of a style and of the styles above it name, as a use of the style
` at `site` names each (`place-style-domain`).
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-style-domains(domains)
                        do match? owner.tree.nodes[domains.syntax]
                            | .node-style-annotation(row)
                                for item in owner.tree.children[row.domains]
                                    do match? owner.tree.nodes[item]
                                        | .node-style-domain-item(domain)
                                            . name = owner.tree.identifier-name(domain.domain)
                                            if name
                                                place-style-domain(name, module, site, ref.module, item)
    level = types.base-of(level)

────────────────────
+ do style-name Atom?
    - written AST
    - id SyntaxId

do match? written.nodes[id]
    | .node-get-expression(row)
        =? null if row.is-tracked || row.is-optional || row.is-loop
        do match? written.nodes[row.object]
            | .node-identifier(head)
                =? program.store-atom("${head.name.text}.${row.name.text}") if !head.is-tracked
        = null
= written.identifier-name(id)

────────────────────
+ styles-attribute Bool
    - op Operator
    - class TypeId
    - name Atom?

` Whether an attribute of a markup element may name a property of a style rather than one of
` the element's class: a plain assignment of a name the class has no property of, where the
` style runtime is loaded.
|? !name || op != .eq-op || types.intrinsic-of(class) != .class || generic
    false
??
    !property-named(class, name) && !interface-accessor(class, name) && program.module-by-name("core/style") != null

.. generic = types.completions[class].has-variables

────────────────────
+ do add-visible-styles Bool
    - class TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles a class sees, each once: those its bases use, base first,
` then its own, as the reference's `visibleStyleUsings`, or those an interface and each it
` extends use (`add-interface-styles`), or a style sheet uses (`add-sheet-styles`). A using of
` a style sheet gives none. One that is wrong is declined or reported, and false. What a class
` or a style sheet sees is kept once found (`visible-styles`), and added again as it was, with
` the fault the type store gives cleared where reading its usings clears it.
if class != no-type && types.intrinsic-of(class) == .interface
    = add-interface-styles(class, styles, site)
if class == no-type || (types.intrinsic-of(class) != .class && not-sheet)
    = true
.. not-sheet = types.intrinsic-of(class) != .style-sheet
. known = scratch.visible-styles[class]
if known
    . start = (known / 4294967296) as Size
    . count = (known / 2 % 2147483648) as Size
    if known % 2 == 1
        types.clear-fault()
    for offset in 0 .. < count
        . used = scratch.visible-style-list[start + offset]
        if styles.find(used) == null
            styles += used
    = true
. found [TypeId]
. (kept, usings) = find-visible-styles(class, found, site)
for used in found
    if styles.find(used) == null
        styles += used
if !kept
    = false
. start = scratch.visible-style-list.length as U64
for used in found
    scratch.visible-style-list += used
scratch.visible-styles[class] = start * 4294967296 + found-count * 2 + (if usings then 1 else 0)
    .. found-count = found.length as U64
= true

────────────────────
_ do find-visible-styles (Bool, Bool)
    - class TypeId
    - styles [TypeId]
    - site SyntaxId

` The styles a class or a style sheet sees, each once, as `add-visible-styles` adds them;
` whether none was wrong, and whether a using was read.
if types.intrinsic-of(class) == .style-sheet
    = add-sheet-styles(class, styles, site)
. usings = false
. chain [TypeId]
. level TypeId? = class
while level && types.intrinsic-of(level) == .class
    chain += level
    level = types.base-of(level)
for position in 0 .. < chain.length
    for ref in sheet-parts(class-ref(types, chain[chain.length - 1 - position]))
        . owner = program.modules[ref.module]
        for member in owner.member-pool[part-members(ref)]
            do match? owner.decls[member]
                | .decl-using(using)
                    usings = true
                    if using-sheet(ref, using) != no-type
                        continue
                    . used = using-style(ref, using, site)
                    if used == no-type
                        = (false, true)
                    if styles.find(used) == null
                        styles += used
= (true, usings)

────────────────────
_ do add-sheet-styles (Bool, Bool)
    - sheet TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles a style sheet uses, with those its extensions use
` (`sheet-parts`), which the rules it writes declare, after those of the sheet it derives from;
` whether none was wrong, and whether a using was read.
. usings = false
. base = types.base-of(sheet) ?? no-type
if is-sheet-type(base)
    . (kept, inherited) = add-sheet-styles(base, styles, site)
    =? (false, true) if !kept
    usings = inherited
for part in sheet-parts(class-ref(types, sheet))
    . owner = program.modules[part.module]
    for member in owner.member-pool[part-members(part)]
        do match? owner.decls[member]
            | .decl-using(using)
                usings = true
                if using-sheet(part, using) != no-type
                    continue
                . used = using-style(part, using, site)
                if used == no-type
                    = (false, true)
                if styles.find(used) == null
                    styles += used
= (true, usings)

────────────────────
_ do add-interface-styles Bool
    - interface TypeId
    - styles [TypeId]
    - site SyntaxId

` Adds to a vocabulary the styles an interface uses, then those of each interface it extends,
` as the reference's `visibleStyleUsings` of an interface.
. ref = class-ref(types, interface)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-using(using)
                    . used = using-style(ref, using, site)
                    if used == no-type
                        = false
                    if styles.find(used) == null
                        styles += used
for extended in types.interfaces-of(interface)
    if !add-interface-styles(extended, styles, site)
        = false
= true

────────────────────
+ do conform-styles
    - class TypeId
    - interface TypeId

` A class whose objects are made values of an interface must use each style the interface and
` those it extends use, as the reference checks as it makes the witness; the first it does not
` is the reference's error, at the class's declaration. Each instance that makes the witness
` reports it, so that it is reported whichever of them a type pass types.
. key = ((class as U64) /lshift/ 32) /or/ (interface as U64)
. known = scratch.missing-styles[key]
. missing = if known then known else missing-style(class, interface)
scratch.missing-styles[key] = missing
if missing == no-type
    =
. ref = class-ref(types, class)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        . text = program.store-atom("${type-short-name(types, class)} must use ${type-short-name(types, missing)} to implement ${type-short-name(types, interface)}")
        facts.record-diagnostic
            - instance
            - ref.module
            - declared.syntax
            - .stated
            - text
            - no-type
            - no-type

────────────────────
_ do missing-style TypeId
    - class TypeId
    - interface TypeId

` The first style an interface or one it extends uses that a class does not, or no type.
if !program.module-by-name("core/style")
    = no-type
. wanted [TypeId]
if !add-interface-styles(interface, wanted, 0) || wanted.length == 0
    = no-type
. seen [TypeId]
if !add-visible-styles(class, seen, 0)
    = no-type
for style in wanted
    if seen.find(style) == null
        = style
= no-type

────────────────────
+ do style-vocabulary [TypeId]?
    - class TypeId
    - site SyntaxId

` The styles a name written for an object of a class in markup may be a property of, in the
` order they answer it: the class's own, those of the elements the markup is in, innermost
` first, and those of the class the markup is written in, as the reference's
` `styleVocabularyFor`. None where a using is declined.
. styles [TypeId]
if !add-visible-styles(class, styles, site)
    = null
add-markup-styles(styles)
if !add-visible-styles(frame.self-type, styles, site)
    = null
= styles

────────────────────
_ do add-markup-styles
    - styles [TypeId]

` Adds to a vocabulary the styles of the elements the markup is in, innermost first, each that
` it does not hold yet, once. The stack of them holds a style again for each element that
` brings it into view, so what the vocabulary holds is marked by type rather than searched.
style-mark += 1
for style in styles
    mark-style(style)
for position in 0 .. < markup-styles.length
    . used = markup-styles[markup-styles.length - 1 - position]
    if mark-style(used)
        styles += used

────────────────────
_ do mark-style Bool
    - style TypeId

` Marks a style as one the vocabulary `add-markup-styles` gathers holds, and says whether it
` held it not yet.
while style-marks.length <= style
    style-marks += 0
if style-marks[style] == style-mark
    = false
style-marks[style] = style-mark
= true

────────────────────
_ do names-style-property Bool
    - used TypeId
    - name Atom

` Whether a style, or one above it, declares a property of a name.
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(declared)
            for member in owner.member-pool[declared.members]
                do match? owner.decls[member]
                    | .decl-property(property)
                        if property.name && property.name == name && plain-member
                            = true
                        .. plain-member = !property.defaults-root && property.element == 0
    level = types.base-of(level)
= false

────────────────────
_ do style-answering TypeId
    - styles [TypeId]
    - name Atom

` The style of a vocabulary that declares a property of a name: none where no style does, and
` the invalid type where two do, which the reference resolves by their types.
. found = no-type
for used in styles
    if names-style-property(used, name)
        if found != no-type
            = invalid-type
        found = used
= found

────────────────────
_ do first-answering TypeId
    - styles [TypeId]
    - name Atom
    - site SyntaxId

` The first style of a vocabulary that declares a property of a name where more than one does,
` as the reference resolves it where they give it one type; where two give it different types,
` the reference's error at the name `site` writes, and the invalid type.
. found = no-type
. held = no-type
. owner = no-type
. written = site
do match? tree.nodes[site]
    | .node-assign(line)
        written = line.lhs
for used in styles
    . (level, type) = declared-style-property(used, name)
    if level == no-type
        continue
    if type == invalid-type || type == no-type
        decline(site)
        = invalid-type
    if found == no-type
        found = used
        held = type
        owner = level
    else if type != held
        frame.diagnose(written, .stated, program.store-atom("Style property \"${name.text}\" has conflicting types in visible styles ${type-short-name(types, owner)} and ${type-short-name(types, level)}"))
        = invalid-type
= found

────────────────────
_ do declared-style-property (TypeId, TypeId)
    - used TypeId
    - name Atom

` The style that declares a property of a name, the one given or one above it, and the type it
` gives the property; none where none does.
. level TypeId? = used
while level && types.intrinsic-of(level) == .style && level != types.type-row(.style)
    if names-own-style-property(level, name)
        . place = property-named(level, name)
        if !place
            = (level, invalid-type)
        . property = types.properties[place]
        . declared = if typed then property.type else demand-member(property, level, name)
            .. typed = property.type != no-type
        = (level, declared)
    level = types.base-of(level)
= (no-type, no-type)

────────────────────
_ do names-own-style-property Bool
    - level TypeId
    - name Atom

` Whether a style itself, and not one above it, declares a property of a name.
. ref = class-ref(types, level)
. owner = program.modules[ref.module]
do match? owner.decls[ref.decl]
    | .decl-class(declared)
        for member in owner.member-pool[declared.members]
            do match? owner.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name && plain-member
                        = true
                    .. plain-member = !property.defaults-root && property.element == 0
= false

────────────────────
_ do find-style-property (U32, U32)
    - styles [TypeId]
    - name Atom
    - site SyntaxId

` The number of the style of a vocabulary whose property of a name answers it, and the
` property's place in `style-properties`: the first style that declares one, as the reference
` resolves it, numbered as it is first used, where all that do give it one type
` (`first-answering`). Both are `U32.max` where no style declares one, and the place alone where
` the property is declined or reported.
. found = style-answering(styles, name)
if found == invalid-type
    found = first-answering(styles, name, site)
if found == invalid-type
    = (0, U32.max)
if found == no-type
    = (U32.max, U32.max)
. index = style-index(found, site, false)
if index == U32.max
    = (0, U32.max)
. use = facts.style-uses[index]
for position in use.first .. < use.first + use.count
    if facts.style-properties[position].name == name
        = (index, position)
decline(site)
= (0, U32.max)

────────────────────
+ do declare-styles Bool
    - id SyntaxId
    - made TypeId
    - body SyntaxId
    - first U32

` Types the attributes of a markup element that name a property of a style the element sees,
` its vocabulary, not one of its class: each declares the property's value for the object at
` the element's site, as the reference declares it after the constructor and before the
` properties are stored, in the order written, at the layer `markup-layer` says. The value is
` converted to the property's type as one assigned is. A name no style answers is the
` reference's error. A value that reads something tracked is declared again as it changes by a
` live action of the object's association with the site (`settle-attributes`). `inherit` takes
` the value from the parent (`declare-inherit`). A value the runtime holds a handle to is held
` by a holder of its own (`style-value-ready`), or where it reads nothing that differs from one
` making to the next, evaluated once for every making (`note-static-value`). A name alone that
` names a slot of a style sheet the element sees declares that slot (`declare-sheet-slot`).
` Their orders follow the `first` the rules the element applies took.
` The element is a site where any of them declares, where it applies a shared rule that
` declares nothing (`empty-shared`), which the reference calls at a site all the same.
. order = first
. sited = empty-shared
empty-shared = false
if body == 0 || !(tree.nodes[body] is .node-block)
    if order != 0 || sited
        facts.style-sites += StyleSite(instance, module, id)
    = true
. layer = markup-layer()
. styles [TypeId]? = null
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    . name = style-name(tree, attribute.lhs)
                    if !styles-attribute(attribute.op, made, name)
                        continue
                    if !styles
                        styles = style-vocabulary(made, statement)
                        if !styles
                            = false
                    . (index, position) = find-style-property(styles, name!, statement)
                    if position == U32.max
                        if index == U32.max
                            attribute-not-found(attribute.lhs, name!)
                        = false
                    . property = facts.style-properties[position]
                    if tree.is-inherit(attribute.rhs)
                        if layer == U32.max
                            decline(statement)
                            = false
                        if !declare-inherit(statement, id, index, position, layer, order)
                            = false
                        order += 1
                        continue
                    . sheeted = declare-sheet-slot
                        - statement
                        - id
                        - index
                        - position
                        - layer
                        - order
                        - attribute.rhs
                        - made
                    if sheeted == 2
                        = false
                    if sheeted == 1
                        order += 1
                        continue
                    if !style-value-ready(property.type)
                        decline(statement)
                        = false
                    . scope = enter-theme(made, no-type, statement)
                    . written = style-value(attribute.rhs, property.type)
                    . themed = leave-theme(scope)
                    if written == invalid-type || written == no-type
                        = false
                    if conversions.convert(statement, attribute.rhs, written, property.type, .reason-assignment) == invalid-type
                        = false
                    if layer == U32.max || !demand-style-sites() || (is-live-statement(statement) && !demand-style-authors(made))
                        decline(statement)
                        = false
                    if themed != U32.max
                        if !declare-themed(statement, id, index, position, layer, order, attribute.rhs, themed)
                            = false
                        order += 1
                        continue
                    . fixed = fixed-style-value(attribute.rhs)
                    . cached = cacheable && declaration-static(attribute.rhs)
                        .. cacheable = !is-live-statement(statement) && holds-handle(property.type)
                    if cached
                        note-static-value(statement, property.type)
                    facts.add-style-declaration
                        - StyleDeclaration
                            - instance
                            - id
                            - statement
                            - facts.style-uses[index].type
                            - position
                            - layer
                            - order
                            - fixed
                            - false
                            - cached
                    order += 1
if order != 0 || sited
    facts.style-sites += StyleSite(instance, module, id)
= true

────────────────────
+ do apply-style-rules U32
    - id SyntaxId
    - made TypeId
    - row ASTMarkup

` The style rules a markup element applies, as the reference applies them once the object is
` made: first those that take no values whose name a class of the element, the type written
` or the element's id spelled as a selector matches (`implicit-names`), then those written
` after `•`, in order. Each is the rule the element's class, or the nearest class above it,
` writes by that name with no values; where none does, nothing is applied. Each is typed once
` for the class that writes it (`check-style-unit`) and declares at the rule layer, from the
` order the one before it ended at, with the rules it applies itself (`apply-rule`). Answers
` how many declarations they make, or `U32.max` where one is declined or reported. Rules
` apply without `core/style`, as their lines may set properties of the class. A rule matched
` by name that the reference makes a function shared by every element it matches
` (`shares-rule`) is marked `shared`. The values a written one is given are typed as they are
` written, with nothing expected, and the rule is chosen by them (`match-style-rule`); each is
` converted at its node to the type the rule takes it as. A written name some rule of the
` chain has but none takes such values by is the reference's `Type mismatch`. A written one with
` a condition is applied under it (`applied-gate`). Declined: a shared rule that declares
` nothing, which the reference makes a site for anyway, a name a rule written in a rule may
` answer (`overlay-rule`), and a
` rule whose properties the element's vocabulary answers with other styles than its class's
` does. Where no class of the chain answers a name, the style sheets the element sees may
` (`sheet-rules`), each group's rule applied in turn, lowest first. After those, each rule
` written in a rule that the element sees and that answers the name is applied over them
` (`scope-rules`), those the element's own rules applied before bring into view among them. The
` rules written in rules that its rules bring into view must be those the element was made
` seeing (`gather-scopes`), or it is declined.
if types.intrinsic-of(made) != .class
    if row.style-rule-applications.count != 0
        decline(id)
        = U32.max
    = 0
. styled = program.module-by-name("core/style") != null
. order U32
element-scopes.clear()
empty-shared = false
for name in implicit-names(made, row.type-id, row.id, tree)
    . atom = program.store-atom(name)
    if overlay-rule(atom)
        decline(id)
        = U32.max
    collecting = true
    collected.clear()
    order = apply-implicit(id, made, row.type-id, atom, order, styled)
    collecting = false
    if order == U32.max
        = U32.max
    for use in collected
        element-scopes += use
order = apply-written-rules(id, made, row.style-rule-applications, order, no-instance, true)
if order != U32.max && !same-scopes(id)
    decline(id)
    order = U32.max
element-scopes.clear()
= order

────────────────────
_ do apply-implicit U32
    - id SyntaxId
    - made TypeId
    - type-id SyntaxId
    - name Atom
    - order U32
    - styled Bool

` Applies the style rules taking no values that a markup element matches by a name, as
` `apply-style-rules` says. A rule of a style sheet the element's chain uses that a class of the
` chain matches by its name is one of that class's defaults, applied where the object is made
` (`apply-themed-defaults`), and not here (`themes-class`); the rules written in it still come
` into view for the element's body, as the element gathered them (`gather-rule`). Answers the
` order the next rule takes, or `U32.max`.
. next = order
. (level, member, named) = class-style-rule(made, name)
. none [TypeId]
if level != no-type
    next = apply-named(id, made, rule-unit(level, member, made, id), next, styled)
    if next == U32.max
        = U32.max
else
    . sheets [TypeId]
    . members [DeclRef]
    . gates [U64]
    . (status, writes, missed) = sheet-rules(made, name, none, written-name(type-id, name), sheets, members, gates, U32.max)
    if status == 1
        decline(id)
    if status != 0
        = U32.max
    for position in 0 .. < sheets.length
        if themes-class(made, name, sheets[position])
            . brought [ScopeUse]
            if !gather-rule(made, members[position].module, members[position].decl, sheets[position], U32.max, U32.max, element-scopes, id, made, brought, 0, U32.max, U32.max)
                decline(id)
                = U32.max
            for use in brought
                collected += use
            continue
        . unit = rule-unit(sheets[position], members[position], made, id)
        . first = facts.style-applications.length
        next = apply-named(id, made, unit, next, styled)
        if failed || !gate-applications(first as U32, sheets[position], gates[position], id)
            = U32.max
        .. failed = next == U32.max
. scoped [ScopeUse]
. (scoping, found, missed) = scope-rules(made, name, none, element-scopes, scoped, U32.max)
if scoping == 1
    decline(id)
if scoping != 0
    = U32.max
for use in scoped
    next = apply-named
        - id
        - made
        - scope-unit(use.scope, made)
        - next
        - styled
        - use.scope.frames
        - use.cell
        - use.values
        - use.outer-cells
    if next == U32.max
        = U32.max
= next

────────────────────
_ do themes-class Bool
    - made TypeId
    - name Atom
    - sheet TypeId

` Whether `sheet`, which writes a rule of `name`, is a style sheet the chain of a markup element's
` class uses (`add-sheet-groups`) and a class of the chain has the name, so that the rule is one
` of that class's defaults (`apply-themed-defaults`).
. own [TypeId]
. levels [U32]
add-sheet-groups(made, own, levels)
=? false if own.find(family-root(sheet)) == null
. level TypeId? = made
while level && types.intrinsic-of(level) == .class
    . ref = class-ref(types, level)
    do match? program.modules[ref.module].decls[ref.decl]
        | .decl-class(class)
            if program.store-atom(class.name.text) == name
                = true
    level = types.base-of(level)
= false

────────────────────
+ do apply-written-rules U32
    - id SyntaxId
    - made TypeId
    - applications RowRange'SyntaxId
    - first U32
    - values InstanceId = no-instance
    - gates Bool = false

` The style rules written after `•` that a markup element, or a slot outlet for what it mounts,
` applies, in order, from the order `first`, as `apply-style-rules` says, each bringing into view
` the rules written in the rules it applies (`element-scopes`). The values an application gives
` are typed here, but where the element typed them as it gathered what they bring
` (`gather-scopes`), or by the instance `values` where one types them (`check-root-values`),
` which converts them too. Where an element `gates` what its rules declare, a rule written with a
` condition is applied under it (`applied-gate`) once a rule answers its name; elsewhere it is
` declined. Answers the order the next declaration takes, or `U32.max`.
. order = first
for application in tree.children[applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if (conditional && (!gates || values != no-instance)) || overlay-rule(applied.name)
                decline(application)
                = U32.max
            .. conditional = applied.condition != 0
            . given [TypeId]
            for value in tree.children[applied.args]
                . held = if values != no-instance then values else instance
                . scope = enter-theme
                    - if values == no-instance then made else no-type
                    - no-type
                    - application
                . type = if answered then facts.answer-type(held, value) else infer(value)
                    .. answered = values != no-instance || pretyped.find(value) != null
                leave-theme(scope)
                if type == invalid-type || type == no-type
                    if values != no-instance
                        decline(application)
                    = U32.max
                given += type
            . levels [TypeId]
            . members [DeclRef]
            . gates [U64]
            . scoped [ScopeUse]
            if !choose-written-rule(made, application, given, levels, members, gates, scoped)
                = U32.max
            . gate [StyleWhen]
            if applied.condition != 0 && levels.length + scoped.length != 0
                . held = applied-gate(applied.condition, made)
                if !held
                    = U32.max
                gate += held
            collecting = true
            collected.clear()
            for chosen in 0 .. < levels.length + scoped.length
                . unit = if chosen < levels.length then rule-unit(levels[chosen], members[chosen], made, application) else scope-unit(scoped[chosen - levels.length].scope, made)
                if unit == no-instance || !answers-alike(unit, made, application)
                    collecting = false
                    decline(application)
                    = U32.max
                . wanted = if chosen < levels.length then rule-argument-types(members[chosen]) ?? scope-argument-types(scoped[chosen - levels.length].scope) else scope-argument-types(scoped[chosen - levels.length].scope)
                for position in 0 .. < given.length
                    . value = tree.children[applied.args.start + position]
                    if values == no-instance && chosen == 0 && conversions.convert(value, value, given[position], wanted![position], .reason-argument) == invalid-type
                        collecting = false
                        = U32.max
                . active [InstanceId]
                . applied [InstanceId]
                . gated [StyleWhen]
                for held in gate
                    gated += held
                . frames = if chosen >= levels.length then scoped-frames else U32.max
                    .. scoped-frames = scoped[chosen - levels.length].scope.frames
                . cell = if chosen >= levels.length then scoped-cell else U32.max
                    .. scoped-cell = scoped[chosen - levels.length].cell
                . around = if chosen >= levels.length then scoped-values else U32.max
                    .. scoped-values = scoped[chosen - levels.length].values
                . links = if chosen >= levels.length then scoped-links else U32.max
                    .. scoped-links = scoped[chosen - levels.length].outer-cells
                . recorded = facts.style-applications.length
                order = apply-rule
                    - id
                    - made
                    - unit
                    - order
                    - application
                    - U32.max
                    - 0
                    - gated
                    - active
                    - applied
                    - frames
                    - cell
                    - around
                    - values == no-instance && given.length != 0
                    - links
                if order == U32.max
                    collecting = false
                    = U32.max
                facts.style-applications[recorded].values = values
                revise-application(recorded as U32)
                if chosen < levels.length && !gate-applications(recorded as U32, levels[chosen], gates[chosen], application)
                    collecting = false
                    = U32.max
                if values == no-instance && given.length != 0
