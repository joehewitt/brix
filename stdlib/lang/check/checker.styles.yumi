                        - id
                        - made
                        - unit
                        - nested
                        - next
                        - index
                        - 0
                        - gates
                        - active
                        - applied
                        - around
                        - cell
                        - framed
                        - outer-cells
                    if next == U32.max
                        = U32.max
                if !declares-only(unit, declared.body, gates)
                    = U32.max
                if !bring-scopes(id, made, unit, around, gates, cell, framed, outer-cells)
                    = U32.max
                . generated = generate-content
                    - id
                    - made
                    - unit
                    - index
                    - owner.tree.rule-content(declared.body)
                    - gates
                if generated == U32.max
                    = U32.max
                next += generated
                for branch in owner.tree.rule-whens(declared.body)
                    . inner = gate-when(id, made, row.module, branch, gates)
                    if !inner
