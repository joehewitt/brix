────────────────────
+ do list-sheet-extensions

` Lists, once, each extension of a style sheet the program declares, with the sheet it extends,
` in the order the modules are declared, each sheet's in a chain of their own. One whose target
` is no style sheet extends nothing.
=? if facts.extensions-listed
facts.extensions-listed = true
. tails = Map'Size'U32(facts.arena)
for position in 0 .. < program.declare-order.length
    . home = program.declare-order[position] as ModuleId
    . owner = program.modules[home]
    for index in 0 .. < owner.decls.length
        do match? owner.decls[index]
            | .decl-sheet-extension(row)
                types.clear-fault()
                . target = types.evaluate-type(home, owner.tree, row.receiver, types.env-frame())
                types.clear-fault()
                if typed && (types.intrinsic-of(target) == .class || style-sheet)
                    . sheet = class-ref(types, target)
                    if program.modules[sheet.module].decls[sheet.decl] is .decl-class && sheet-decl
                        . key = ((sheet.module as Size) /lshift/ 32) /or/ (sheet.decl as Size)
                        . place = facts.sheet-extensions.length as U32
