(import ./type-signature)
(import ./type-store)
(import ./types)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(fn-do + declaring-class DeclRef
  (param types Types)
  (param owner TypeId)
  (param name Atom)
  ; The class among a type and its bases that declares a property of a name, or the type's own
  ; class where none does.
  (let current owner)
  (while (!= current no-type)
    (let ref (call class-ref types current))
    (if (and (== (. ref module) 0) (== (. ref decl) 0))
      (return ref)
    )
    (if (!= (call owner-property (. types program) (. ref module) (. ref decl) name) 0)
      (return ref)
    )
    (= current (?? (call (. types base-of) current) no-type))
  )
  (return (call class-ref types owner))
)

(fn-do + declaring-decl DeclRef
  (param types Types)
  (param fact TypeProperty)
  ; The class or facet that declares a property: the facet a facet's property has, unless a class
  ; below the facet's own gives it a new value (`is-given-below`), or else the class among a type
  ; and its bases that declares it.
  (if (or (== (. fact facet) (. U32 max)) (call is-given-below types fact))
    (return (call declaring-class types (. fact owner) (. fact name)))
  )
  (let facets (. types program facets))
  (return (call DeclRef ([] (. facets modules) (. fact facet)) ([] (. facets decls) (. fact facet))))
)

(fn-expr + is-given-below Bool
  (param types Types)
  (param fact TypeProperty)
  ; Whether a class below the class of a facet gives the facet's property a new value: the
  ; property's owner is then that class, not the facet's.
  (and (!= (. fact facet) (. U32 max)) (or (!= (. holder module) owner-module) (!= (. holder decl) owner-decl)))
  (where
    (lazy holder (call class-ref types (. fact owner)))
    (lazy owner-module ([] (. types program facets owner-modules) (. fact facet)))
    (lazy owner-decl ([] (. types program facets owner-decls) (. fact facet)))
  )
)

(fn-do + declaring-holder DeclRef
  (param types Types)
  (param fact TypeProperty)
  ; The class that holds a property: the class of a facet that declares it, unless a class below
  ; gives it a new value (`is-given-below`), or else the class that declares it.
  (if (or (== (. fact facet) (. U32 max)) (call is-given-below types fact))
    (return (call declaring-class types (. fact owner) (. fact name)))
  )
  (let facets (. types program facets))
  (return (call DeclRef ([] (. facets owner-modules) (. fact facet)) ([] (. facets owner-decls) (. fact facet))))
)

(fn-do + written-tuple DeclRef
  (param types Types)
  (param type TypeId)
  (param fields TypeId)
  (let current type)
  (while (!= current no-type)
    (let base (?? (call (. types base-of) current) no-type))
    (if (== base fields)
      (return (call class-ref types current))
    )
    (= current base)
  )
  (return (call DeclRef 0 0))
)

(fn-do + written-field SyntaxId
  (param program Program)
  (param ref DeclRef)
  (param name Atom)
  (if (== (. ref decl) 0)
    (return 0)
  )
  (let owner ([] (. program modules) (. ref module)))
  (let tree (. owner tree))
  (match? ([] (. owner decls) (. ref decl))
    (case (call .decl-class class)
      (match? ([] (. tree nodes) (. class base))
        (case (call .node-type-tuple row)
          (let position 0)
          (for (in field ([] (. tree children) (. row field-types)))
            (let written
              (match? ([] (. tree nodes) field)
                (case (call .node-type-capture capture)
                  (match? ([] (. tree nodes) (. capture id))
                    (case (call .node-identifier id)
                      (. id name text)
                    )
                  )
                )
              )
            )
            (if (== (?? written (str position)) (. name text))
              (return field)
            )
            (+= position 1)
          )
        )
      )
    )
  )
  (return 0)
)

(fn-do + names-element Bool
  (param types Types)
  (param fact TypeProperty)
  ; Whether a property is one the markup written in a class declared for an element of a
  ; name: it holds nothing until that markup makes the element.
  (let ref (call declaring-decl types fact))
  (let member (call owner-property (. types program) (. ref module) (. ref decl) (. fact name)))
  (if (== member 0)
    (return false)
  )
  (match? ([] (. ([] (. types program modules) (. ref module)) decls) member)
    (case (call .decl-property row)
      (return (!= (. row element) 0))
    )
  )
  (return false)
)

(fn-do + member-site SyntaxId
  (param types Types)
  (param ref DeclRef)
  (param name Atom)
  ; Where a class declares a property or a getter of a name.
  (let owner ([] (. types program modules) (. ref module)))
  (match? ([] (. owner decls) (. ref decl))
    (case (call .decl-class class)
      (for (in member (call (. owner members-named) (. class members) name))
        (match? ([] (. owner decls) member)
          (case (call .decl-property property)
            (if (and (. property name) (== (. property name) name))
              (return (. property syntax))
            )
          )
          (case (call .decl-function fn)
            (if (and (== (. fn kind) .getter-decl) (. fn name) (== (. fn name) name))
              (return (. fn syntax))
            )
          )
        )
      )
      (return (. class syntax))
    )
  )
  (return 0)
)

(fn-do + is-hot-field Bool
  (param types Types)
  (param property TypeProperty)
  ; Whether the declaration of a field asks to be packed first among a table row's inline bytes.
  (let owner (call declaring-decl types property))
  (let written (call member-site types owner (. property name)))
  (let target (. ([] (. types program modules) (. owner module)) tree))
  (match? ([] (. target nodes) written)
    (case (call .node-property-syntax row)
      (for (in annotation ([] (. target atoms) (. row annotations)))
        (if (== (. annotation text) "hot")
          (return true)
        )
      )
    )
  )
  (return false)
)

(fn-do + is-common-field Bool
  (param types Types)
  (param union TypeId)
  (param field TypeProperty)
  ; A field every case of a union row inherits from one declaration with one type is held in a
  ; column of its own.
  (if (!= (. field storage-kind) .storage-eager)
    (return false)
  )
  (let declared (call declaring-decl types field))
  (for (in fact (call (. types cases-of) union))
    (if (or (. fact is-default) (== (. fact type) no-type) (== (. fact type) invalid-type))
      (return false)
    )
    (let found (call (. types property-named) (. fact type) (. field name)))
    (if (not found)
      (return false)
    )
    (let other ([] (. types properties) found))
    (if (or (!= (. other storage-kind) .storage-eager) (!= (. other type) (. field type)))
      (return false)
    )
    (let held (call declaring-decl types other))
    (if (or (!= (. held module) (. declared module)) (!= (. held decl) (. declared decl)))
      (return false)
    )
  )
  (return true)
)
