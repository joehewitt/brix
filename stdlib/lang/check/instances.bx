      (for (in type params)
        (+= signature-types type)
      )
      (for (in type args)
        (+= signature-types type)
      )
      (let signature
        (call InstanceSignature
          (block
            (arg (call (of RowRange TypeId) (+ start param-count) (as (. args length) U32)))
            (arg no-type)
            (arg no-type)
            (arg .return-pending)
            (arg param-count)
          )
        )
      )
      (call (. signatures append) signature)
      (let key (call mixed (call mixed (call mixed stable-key-seed module) decl) (call (. types key-of) self-type)))
      (= key
        (call mixed
          (block
            (arg (call mixed key (/and/ effects 0x0000FFFFFFFFFFFF)))
            (arg (if-expr (!= enclosing no-instance) ([] stable-keys enclosing) 0u64))
          )
        )
      )
      (if (!= (call swap-set-of effects) 0)
        (= key (call mixed-swaps key (call swap-set-of effects)))
      )
      (= key (call mixed key param-count))
      (if (!= row-receiver no-type)
