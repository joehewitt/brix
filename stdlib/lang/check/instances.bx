    (= ([] key-scratch 2) receiver)
    (= ([] key-scratch 3) 0)
    (= ([] key-scratch 4) no-instance)
    (= ([] key-scratch 5) (. U32 max))
    (= ([] key-scratch 6) property)
    (= ([] key-scratch 7) element)
    (= ([] key-scratch 8) context)
