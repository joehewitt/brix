(import ./binding)
(import ./idmap)
(import ./stable-key)
(import ./type-store)
(import ./types)
(import /core/arena)
(import /core/scratch)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/row-range)
(blank)
(prop + no-instance InstanceId (= (. U32 max)))
(prop + dispatch-effect-bits U32 (= 94))
(prop + binder-slot _ (= "(binder)"))
(blank)
(type-line + InstanceId (is U32))

(type + Instance (is Struct)
  ; `fills-share` says a constructor's properties, as it gives them their first values, read a
  ; lazy local nested functions capture or make a nested function, where TypeScript keeps two
  ; of each lazy local: one read then and one the body reads. A rule a pattern calls under a
  ; helper is typed again as an instance of its own, given the `helper` it runs under, which
  ; `uses-helper` where its pattern makes a value through the helper or calls a rule that needs
  ; it to roll back, and `rolls-helper` where it needs the helper to roll back. A rule called for
  ; the text it matched under a helper that observes literal words is typed for the helper as one
  ; of its own that `spans`, which makes nothing through the helper. A rule a pattern on a String
  ; calls is typed again as one of its own that is `encoded`, whose buffer holds the String's
  ; UTF-8 bytes rather than its characters. A rule whose
  ; pattern holds a rollback mark `carries-mark`, which it gives the pattern calling it. A
  ; constructor a markup element calls with attributes is an instance of its own: it takes,
  ; after its arguments, the value of each property in `fills`, and gives the property that
  ; value in place of the one its class writes.
  ; A constructor a markup element calls giving slots content is one too: it takes, after
  ; those, the function that builds each slot in `slots`, which it gives the function that fills
  ; the object with its class's markup, which is one of its own for those slots too. So is one a
  ; markup element calls for a class whose markup is its content, for the styles and style
  ; sheets the element sees, its `context` among `contexts`, and the function that fills it;
  ; both take, after the values of properties and before the builders of slots, the `carried`
  ; state cells the context gives (`context-values`). The values a rule applied on a root `<This`
  ; is given are typed by an instance of their own, which types only the application
  ; `root-values` (`intern-root-values`). An instance that `casts-errors` lets out an error of a
  ; class above one it states, cast to that one. A style rule a style sheet writes is typed for
  ; the class of the `element` it is applied to, whose styles answer its names with the sheet's.
  ; A function typed in a GC-free zone names the `zone` it was first called in, as TypeScript
  ; keeps where the zone is entered as it compiles the functions called there. The default of a
  ; parameter written as a constant is typed with its function, and any other where a call first
  ; takes it; `typed-defaults` keeps a bit for each of the first 64 typed (`type-default`).
  ; A method that yields and states no errors, which a class's table holds in the place of a base's
  ; method whose generator carries errors, is typed again as an instance of its own that states
  ; those errors, as the reference's method inherits them: it `inherits` them from the base's
  ; instance, and the instance typed again names it as `retyped`. A constructor of a class above
  ; the one it makes, called with no value for a parameter named as a property the class it makes
  ; writes a default of its own for, is one of its own too: `redefaults` keeps a bit for each such
  ; parameter, among the first 32, whose property it leaves to that default, as the reference's
  ; `redefaultedArgNames` does. One typed on trial keeps the `probe` that numbers it. One made only
  ; to type the default of a parameter (`Checker.default-type`) `holds-default`: it is never
  ; typed, and no class's table holds it (`ClassTables.list-tables`). One whose
  ; typing changed what another type pass cannot take in is `unshared` (`Checker.run`), and
  ; `unretirable` where it changed more than rows retiring it removes (`Facts.retire`) and what an
  ; edit typed again in place keeps (`Facts.kept-weight`). One whose typing another pass published,
  ; which this pass took in in place of typing its body, is `imported` (`import-result`): its body
  ; stays the other's. One written in another whose typing that one's depends on, by what it notes
  ; there or keeps of it, is typed `with-enclosing`: no pass takes it in from another, and the merge
  ; takes it from a pass only with the one it is written in (`merge-sessions`).
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + self-type TypeId)
  (prop + effects EffectMask)
  (prop + enclosing InstanceId)
  (prop + state InstanceState)
  (prop + binding BindingId (= no-binding))
  (prop + node-start U32 (= (. U32 max)))
  (prop + subtree SyntaxRange)
  (prop + may-panic Bool)
  (prop + polls Bool)
  (prop + is-generator Bool)
  (prop + slot-start U32 (= (. U32 max)))
  (prop + slot-count U32)
  (prop + slot-base U32)
  (prop + holds-closure Bool)
  (prop + queued Bool)
  (prop + initializer DeclId (= 0))
  (prop + reads-self Bool)
  (prop + branches Bool)
  (prop + returns-own Bool)
  (prop + gives-unwritten Bool)
  (prop + casts-errors Bool)
  (prop + makes TypeId (= no-type))
  (prop + yields TypeId (= no-type))
  (prop + step-errors (of RowRange TypeId))
  (prop + ends-generator Bool)
  (prop + quiet Bool)
  (prop + splits-yields Bool)
  (prop + compares Bool)
  (prop + row-receiver TypeId (= no-type))
  (prop + row-case U32 (= (. U32 max)))
  (prop + row-validated Bool)
  (prop + materialized InstanceId (= no-instance))
  (prop + bound-call BoundCall (= .bound-call-none))
  (prop + fills-share Bool)
  (prop + helper TypeId (= no-type))
  (prop + spans Bool)
  (prop + encoded Bool)
  (prop + uses-helper Bool)
  (prop + rolls-helper Bool)
  (prop + carries-mark Bool)
  (prop + fills (of RowRange U32) (= (call (of RowRange U32))))
  (prop + slots (of RowRange U32) (= (call (of RowRange U32))))
  (prop + is-live Bool)
  (prop + context U32 (= (. U32 max)))
  (prop + carried U32)
  (prop + root-values SyntaxId (= 0))
  (prop + element TypeId (= no-type))
  (prop + zone ZoneEntry (= (call ZoneEntry)))
  (prop + typed-defaults U64)
  (prop + inherits InstanceId (= no-instance))
  (prop + redefaults U32)
  (prop + retyped InstanceId (= no-instance))
  (prop + probe U32)
  (prop + holds-default Bool)
  (prop + unshared Bool)
  (prop + unretirable Bool)
  (prop + imported Bool)
  (prop + with-enclosing Bool)
  (prop + consumes U64)
  (prop + hands-back U64)
)

(type + GeneratorUse (is Union)
  (variant generator-consumed)
  (variant generator-returned)
  (variant generator-kept)
)

(type + Instances
  (prop + rows (of Table Instance))
  (prop + report _ (= (call PanicReport)))
  (prop + live _ (= (call LiveRuntime)))
  (prop + probe-runtime _ (= (call ProbeRuntime)))
  (prop + signatures (of Table InstanceSignature))
  (prop + signature-types (of List TypeId ArenaBacking))
  (prop + fill-places (of List U32 ArenaBacking))
  (prop + slot-places (of List U32 ArenaBacking))
  (prop + slot-atoms (of List Atom ArenaBacking))
  (prop + stable-keys (of List StableKey ArenaBacking))
  (prop + contexts (of List StyleContext ArenaBacking))
  (prop + context-types (of List TypeId ArenaBacking))
  (prop + context-levels (of List U32 ArenaBacking))
  (prop + context-scopes (of List RuleScope ArenaBacking))
  (prop + context-cells (of List U32 ArenaBacking))
  (prop + context-valued (of List U32 ArenaBacking))
  (prop + context-value-types (of List TypeId ArenaBacking))
  (prop + state-keys (of List StateKey ArenaBacking))
  (prop + swap-entries (of List SwapEntry ArenaBacking))
  (prop + swap-set-starts (of List U32 ArenaBacking))
  (prop + swap-set-counts (of List U32 ArenaBacking))
  (prop + swap-set-entries (of List U32 ArenaBacking))
  (prop + frames (of List RuleFrame ArenaBacking))
  (prop + ranked (of Array InstanceId ArenaBacking))
  (prop + ordered (of Array InstanceId ArenaBacking))
  (prop + ranks (of Array U32 ArenaBacking))
  (prop + worklist (of List InstanceId ArenaBacking))
  (prop + worklist-next Size (= 0))
  (prop + written-in (of List InstanceId ArenaBacking))
  (prop + typed-on-read (of List InstanceId ArenaBacking))
  (prop + settled (of List InstanceId ArenaBacking))
  (prop + keeps-settled Bool)
  (prop + held (of Scratch InstanceId))
  (prop + holding U32)
  (prop + last-inserted Bool)
  (prop + sealed Bool)
  (prop + probes U32)
  (prop + arena Arena)
  (prop + wide-defaults (of List U64 ArenaBacking))
  (prop + dead InstanceId (= no-instance))
  (blank)
  (prop _ types Types)
  (prop _ keys IdMap)
  (prop _ key-scratch (of Array U32 ArenaBacking))
  (prop _ initializers (of Map InitializerKey InstanceId ArenaBacking))
  (prop _ slot-ids (of Map Atom U32))
  (fn-do + This _
    (param arena Arena)
    (param types Types)
    (lazy rows (call (of Table Instance) arena 16))
    (lazy signatures (call (of Table InstanceSignature) arena 16))
    (lazy signature-types (call (of List TypeId) arena))
    (lazy fill-places (call (of List U32) arena))
    (lazy slot-places (call (of List U32) arena))
    (lazy slot-atoms (call (of List Atom) arena))
    (lazy stable-keys (call (of List StableKey) arena))
    (lazy contexts (call (of List StyleContext) arena))
    (lazy context-types (call (of List TypeId) arena))
    (lazy context-levels (call (of List U32) arena))
    (lazy context-scopes (call (of List RuleScope) arena))
    (lazy context-cells (call (of List U32) arena))
    (lazy context-valued (call (of List U32) arena))
    (lazy context-value-types (call (of List TypeId) arena))
    (lazy state-keys (call (of List StateKey) arena))
    (lazy swap-entries (call (of List SwapEntry) arena))
    (lazy swap-set-starts (call (of List U32) arena))
    (lazy swap-set-counts (call (of List U32) arena))
    (lazy swap-set-entries (call (of List U32) arena))
    (lazy frames (call (of List RuleFrame) arena))
    (lazy ranked (call (of Array InstanceId) arena 0))
    (lazy ordered (call (of Array InstanceId) arena 0))
    (lazy ranks (call (of Array U32) arena 0))
    (lazy worklist (call (of List InstanceId) arena))
    (lazy written-in (call (of List InstanceId) arena))
    (lazy typed-on-read (call (of List InstanceId) arena))
    (lazy settled (call (of List InstanceId) arena))
    (lazy held (call (of Scratch InstanceId) arena 16))
    (lazy key-scratch (call (of Array U32) arena 16))
    (lazy initializers (call (of Map InitializerKey InstanceId) arena))
    (lazy wide-defaults (call (of List U64) arena))
  )
  (fn-expr + length Size :get
    (. rows length)
  )
  (fn-do + type-default Bool
    (param callee InstanceId)
    (param position U32)
    ; Notes that the default of a callee's parameter at a position is typed, answering whether it
    ; was not yet. One past the 64th is kept apart from its instance's bits, as a key of both.
    (if (< position 64)
      (let bit (/lshift/ 1u64 (as position U64)))
      (if (!= (/and/ (. ([] rows callee) typed-defaults) bit) 0)
        (return false)
      )
      (= (. ([] rows callee) typed-defaults) (/or/ (. ([] rows callee) typed-defaults) bit))
      (return true)
    )
    (let key (/or/ (/lshift/ (as callee U64) 32) (as position U64)))
    (for (in kept wide-defaults)
      (if (== kept key)
        (return false)
      )
    )
    (+= wide-defaults key)
    (return true)
  )
  (fn-do + default-typed Bool
    (param callee InstanceId)
    (param position U32)
    ; Whether the default of a callee's parameter at a position is typed (`type-default`).
    (if (< position 64)
      (return (!= (/and/ (. ([] rows callee) typed-defaults) (/lshift/ 1u64 (as position U64))) 0))
    )
    (let key (/or/ (/lshift/ (as callee U64) 32) (as position U64)))
    (for (in kept wide-defaults)
      (if (== kept key)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + release _
    (call (. keys release))
  )
  (fn-do + seal _
    ; Ends the table's growth: program tables and emission read a whole program's instances, so
    ; one interned after this point would be a function nothing laid out or emitted. The instances
    ; are then ranked by declaration and stable key, those that type a property's value after the
    ; rest. `ordered` lists them all by rank and `ranked` those that are not a property's value.
    ; Whatever lists a program's instances goes by rank, since an id records only which instance
    ; typing reached first.
    (= sealed true)
    (let total (. rows length))
    (= ordered (call (of Array InstanceId) arena total))
    (let spare (call (of Array InstanceId) arena total))
    (let count Size 0)
    (for (in id (..< 0 total))
      (= ([] ordered id) (as id InstanceId))
      (if (== (. ([] rows id) initializer) 0)
        (+= count 1)
      )
    )
    (let width Size 1)
    (while (< width total)
      (let start Size 0)
      (while (< start total)
        (let middle (if-expr (< (+ start width) total) (+ start width) total))
        (let end (if-expr (< (+ middle width) total) (+ middle width) total))
        (call merge-ranked spare start middle end)
        (= start end)
      )
      (let merged ordered)
      (= ordered spare)
      (= spare merged)
      (*= width 2)
    )
    (for (in position (..< 1 total))
      (throw (call Panic "Two instances of one declaration share a stable key") (if (not (call ranks-before ([] ordered (- position 1)) ([] ordered position)))))
    )
    (= ranked (call (of Array InstanceId) arena count))
    (= ranks (call (of Array U32) arena total))
    (for (in position (..< 0 total))
      (if (< position count)
        (= ([] ranked position) ([] ordered position))
      )
      (= ([] ranks ([] ordered position)) (as position U32))
    )
  )
  (fn-do + unseal _
    (= sealed false)
  )
  (fn-do + retype _
    (param id InstanceId)
    ; Starts an instance over, to be typed again where an edit is typed in place (`retype-edit`),
    ; keeping what its demanders gave it. An initializer keeps the type its property's declarations
    ; give it (`declared-returns`), which a reader sets only as it first demands the initializer.
    (let row (as ([] rows id) Instance))
    (let fresh
      (call Instance
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row self-type))
          (arg (. row effects))
          (arg (. row enclosing))
          (arg .instance-unstarted)
        )
      )
    )
    (= (. fresh holds-closure) (. row holds-closure))
    (= (. fresh initializer) (. row initializer))
    (= (. fresh compares) (. row compares))
    (= (. fresh row-receiver) (. row row-receiver))
    (= (. fresh row-case) (. row row-case))
    (= (. fresh row-validated) (. row row-validated))
    (= (. fresh bound-call) (. row bound-call))
    (= (. fresh helper) (. row helper))
    (= (. fresh spans) (. row spans))
    (= (. fresh encoded) (. row encoded))
    (= (. fresh fills) (. row fills))
    (= (. fresh slots) (. row slots))
    (= (. fresh context) (. row context))
    (= (. fresh carried) (. row carried))
    (= (. fresh root-values) (. row root-values))
    (= (. fresh element) (. row element))
    (= (. fresh zone) (. row zone))
    (= (. fresh inherits) (. row inherits))
    (= (. fresh redefaults) (. row redefaults))
    (= (. fresh probe) (. row probe))
    (= (. fresh holds-default) (. row holds-default))
    (= ([] rows id) fresh)
    (let signature (as ([] signatures id) InstanceSignature))
    (let declared (if-expr (!= (. row initializer) 0) (. signature declared-returns) no-type))
    (= ([] signatures id)
      (call InstanceSignature
        (block
          (arg (. signature args))
          (arg no-type)
          (arg declared)
          (arg .return-pending)
          (arg (. signature param-count))
        )
      )
    )
    (let wide (call (of List U64) arena))
    (for (in key wide-defaults)
      (if (!= (/rshift/ key 32) (as id U64))
        (+= wide key)
      )
    )
    (= wide-defaults wide)
  )
  (fn-do + move-syntax _
    (param module ModuleId)
    (param moved (list SyntaxId))
    ; Moves the nodes of an edited module that instances name to where the edit puts them, as
    ; `Facts.move-syntax` moves those facts name: where state cells are made, the `when`s of rules
    ; applied around rules written in rules, and where zones are entered.
    (for (in position (..< 0 (. state-keys length)))
      (if (== (. ([] state-keys position) module) module)
        (= (. ([] state-keys position) site) (call moved-node moved (. ([] state-keys position) site)))
      )
      (if (== (. ([] state-keys position) when-module) module)
        (= (. ([] state-keys position) when) (call moved-node moved (. ([] state-keys position) when)))
      )
    )
    (for (in position (..< 0 (. frames length)))
      (if (== (. ([] frames position) module) module)
        (= (. ([] frames position) gate) (call moved-node moved (. ([] frames position) gate)))
      )
    )
    (for (in position (..< 0 (. rows length)))
      (let zone (. ([] rows position) zone))
      (if (and (== (. zone module) module) (!= (. zone site) 0))
        (= (. ([] rows position) zone) (call ZoneEntry module (call moved-node moved (. zone site))))
      )
    )
  )
  (fn-do + add-dead InstanceId
    (param module ModuleId)
    (param decl DeclId)
    (return-if dead (if (!= dead no-instance)))
    (blank)
    (call ensure-scratch 1)
    (= ([] key-scratch 0) (. U32 max))
    (let id (as (call (. keys store) (. key-scratch data) 1) InstanceId))
    (call (. rows append) (call Instance module decl no-type 0 no-instance .instance-done))
    (= (. ([] rows id) initializer) decl)
    (call (. signatures append)
      (block
        (arg
          (call InstanceSignature
            (block
              (arg (call (of RowRange TypeId) (as (. signature-types length) U32) 0))
              (arg no-type)
              (arg no-type)
              (arg .return-inferred)
              (arg 0)
            )
          )
        )
      )
    )
    (+= stable-keys (. U64 max))
    (= dead id)
    (return id)
  )
  (fn-expr + rank-of U32
    (param instance InstanceId)
    ; Where an instance stands in `ordered`, or `U32.max` for none.
    (if-expr (< instance (. ranks length)) ([] ranks instance) (. U32 max))
  )
  (fn-do + intern InstanceId
    (param module ModuleId)
    (param decl DeclId)
    (param self-type TypeId)
    (param effects EffectMask)
    (param enclosing InstanceId)
    (param params (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (param args (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (param schedule Bool (= true))
    (param row-receiver TypeId (= no-type))
    (param row-case U32 (= (. U32 max)))
    (param row-validated Bool (= false))
    (param probe U32 (= 0))
    (param helper TypeId (= no-type))
    (param fills (of ImmutableArray U32 ArenaBacking) (= (call (of ImmutableArray U32 ArenaBacking))))
    (param slots (of ImmutableArray U32 ArenaBacking) (= (call (of ImmutableArray U32 ArenaBacking))))
    (param context U32 (= (. U32 max)))
    (param zone ZoneEntry (= (call ZoneEntry)))
    (param inherits InstanceId (= no-instance))
    (param redefaults U32 (= 0))
    (param spans Bool (= false))
    (param encoded Bool (= false))
    ; Interns the instance of a declaration bound to its type parameters and argument types under
    ; an effect mask, appending its signature row and scheduling it on first sight. A member of a
    ; case of a union called on a row of a table of unions that holds that case is an instance of
    ; its own: it takes the row, `row-receiver`, and its receiver is the case's cells, which it
    ; reads with no check where `row-validated`, as TypeScript's `table-row-extension` does. A
    ; `probe` numbers an instance of its own that a part of another is typed in on trial. A rule
    ; typed for the `helper` a pattern calls it under is an instance of its own, and one that
    ; `spans` too, and one that is `encoded`. So is a
    ; constructor given the properties in `fills`, by their places among all properties: their
    ; types are the last of `args`. So is one given the slots in `slots`, by their numbers as
    ; `slot-id` gives them, whose builders' types are the last of `args`, after those of `fills`.
    ; So is one for the styles and style sheets of a `context`. One interned in a GC-free zone keeps
    ; the `zone` it is first called in. So is a method that states the errors a base's generator
    ; carries, which it `inherits` from that base's instance. So is a constructor that leaves the
    ; properties of the parameters in `redefaults` to the defaults the class it makes writes.
    (let param-count U32 (as (. params length) U32))
    (let count (+ (. params length) (. args length)))
    (let filled (if-expr (== (. fills length) 0) 0 (+ (. fills length) 1)))
    (let slotted (if-expr (== (. slots length) 0) 0 (+ (. slots length) 1)))
    (let contexted (if-expr (== context (. U32 max)) 0u32 2u32))
    (let inheriting (if-expr (== inherits no-instance) 0u32 2u32))
    (let redefaulting (if-expr (== redefaults 0) 0u32 2u32))
    (let spanning (if-expr spans 1u32 0u32))
    (let encoding (if-expr encoded 1u32 0u32))
    (let high-effects (as (/rshift/ effects 32) U32))
    (let banning (if-expr (== high-effects 0) 0u32 2u32))
    (call ensure-scratch
      (block
        (arg (+ 10 count filled slotted contexted inheriting redefaulting spanning encoding banning))
      )
    )
    (= ([] key-scratch 0) module)
    (= ([] key-scratch 1) decl)
    (= ([] key-scratch 2) self-type)
    (= ([] key-scratch 3) (as (/and/ effects (. U32 max)) U32))
    (= ([] key-scratch 4) enclosing)
    (= ([] key-scratch 5) param-count)
    (= ([] key-scratch 6) row-receiver)
    (= ([] key-scratch 7) row-case)
    (= ([] key-scratch 8) (+ (if-expr row-validated 1 0) (* probe 2)))
    (= ([] key-scratch 9) helper)
    (for (in offset (..< 0 (. params length)))
      (= ([] key-scratch (+ 10 offset)) ([] params offset))
    )
    (for (in offset (..< 0 (. args length)))
      (= ([] key-scratch (+ 10 (. params length) offset)) ([] args offset))
    )
    (if (!= (. fills length) 0)
      (= ([] key-scratch (+ 10 count)) (- (. U32 max) 3))
      (for (in offset (..< 0 (. fills length)))
        (= ([] key-scratch (+ 11 count offset)) ([] fills offset))
      )
    )
    (if (!= (. slots length) 0)
      (= ([] key-scratch (+ 10 count filled)) (- (. U32 max) 4))
      (for (in offset (..< 0 (. slots length)))
        (= ([] key-scratch (+ 11 count filled offset)) ([] slots offset))
      )
    )
    (if (!= context (. U32 max))
      (= ([] key-scratch (+ 10 count filled slotted)) (- (. U32 max) 5))
      (= ([] key-scratch (+ 11 count filled slotted)) context)
    )
    (if (!= inherits no-instance)
      (= ([] key-scratch (+ 10 count filled slotted contexted)) (- (. U32 max) 6))
      (= ([] key-scratch (+ 11 count filled slotted contexted)) inherits)
    )
    (if (!= redefaults 0)
      (= ([] key-scratch (+ 10 count filled slotted contexted inheriting)) (- (. U32 max) 7))
      (= ([] key-scratch (+ 11 count filled slotted contexted inheriting)) redefaults)
    )
    (if spans
      (= ([] key-scratch (+ 10 count filled slotted contexted inheriting redefaulting)) (- (. U32 max) 8))
    )
    (if encoded
      (= ([] key-scratch (+ spans-at spanning)) (- (. U32 max) 9))
      (lazy spans-at (+ 10 count filled slotted contexted inheriting redefaulting))
    )
    (let tail-at
      (block
        (+ 10 count filled slotted contexted inheriting redefaulting spanning encoding)
      )
    )
    (if (!= high-effects 0)
      (= ([] key-scratch tail-at) (- (. U32 max) 10))
      (= ([] key-scratch (+ tail-at 1)) high-effects)
    )
    (blank)
    (let id (as (call (. keys store) (. key-scratch data) (+ tail-at banning)) InstanceId))
    (= last-inserted (. keys last-inserted))
    (if last-inserted
      (throw (call Panic "An instance cannot be interned after the instance table is sealed") (if sealed))
      (blank)
      (let row
        (call Instance
          (block
            (arg module)
            (arg decl)
            (arg self-type)
            (arg effects)
            (arg enclosing)
            (arg .instance-unstarted)
          )
        )
      )
      (= (. row row-receiver) row-receiver)
      (= (. row row-case) row-case)
      (= (. row row-validated) row-validated)
      (= (. row helper) helper)
      (= (. row spans) spans)
      (= (. row encoded) encoded)
      (= (. row context) context)
      (= (. row inherits) inherits)
      (= (. row redefaults) redefaults)
      (= (. row probe) probe)
