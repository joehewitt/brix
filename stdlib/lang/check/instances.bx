    (= ([] key-scratch 3) 0)
    (= ([] key-scratch 4) no-instance)
    (= ([] key-scratch 5) (- (. U32 max) 2))
    (= ([] key-scratch 6) application)
    (= ([] key-scratch 7) (- (. U32 max) 5))
