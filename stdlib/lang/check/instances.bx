    (for (in style styles)
      (+= context-types style)
      (+= context-levels (. U32 max))
    )
    (for (in position (..< 0 (. sheets length)))
      (+= context-types ([] sheets position))
      (+= context-levels ([] groups position))
    )
    (let scope-first (as (. context-scopes length) U32))
    (for (in position (..< 0 (. scopes length)))
      (+= context-scopes ([] scopes position))
      (+= context-cells ([] cells position))
      (+= context-valued (if-expr (!= (. valued length) 0) ([] valued position) (. U32 max)))
    )
    (let value-first (as (. context-value-types length) U32))
    (for (in type value-types)
      (+= context-value-types type)
    )
    (+= contexts
      (call StyleContext
        (block
          (arg first)
          (arg (as (. styles length) U32))
          (arg (as (. sheets length) U32))
          (arg scope-first)
          (arg (as (. scopes length) U32))
          (arg made)
          (arg layer)
          (arg value-first)
          (arg (as (. value-types length) U32))
