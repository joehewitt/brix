          (arg module)
          (arg decl)
          (arg self-type)
          (arg (call dispatch-effects (/or/ declared (. row effects))))
          (arg no-instance)
          (arg params)
          (arg args)
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg no-type)
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg (. U32 max))
          (arg (. row zone))
