      (for (in type params)
        (= closes (or closes (. ([] (. types completions) type) has-closures)))
      )
      (for (in type args)
        (= closes (or closes (. ([] (. types completions) type) has-closures)))
      )
      (= (. ([] rows id) holds-closure) closes)
      (if schedule
        (call queue id)
