      )
      (if (!= (. fills length) 0)
        (= (. row fills) (call (of RowRange U32) (as (. fill-places length) U32) (as (. fills length) U32)))
        (for (in place fills)
          (+= fill-places place)
        )
      )
      (if (!= (. slots length) 0)
        (= (. row slots) (call (of RowRange U32) (as (. slot-places length) U32) (as (. slots length) U32)))
        (for (in slot slots)
          (+= slot-places slot)
        )
      )
      (call (. rows append) row)
