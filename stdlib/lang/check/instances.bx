        (continue)
      )
      (lazy other-sheets (or (!= (. held styles) (. styles length)) (!= (. held sheets) (. sheets length))))
      (lazy other-values (or (!= (. held layer) layer) (!= (. held values) (. value-types length))))
      (let same true)
      (for (in position (..< 0 (. scopes length)))
        (let place (if-expr (!= (. valued length) 0) ([] valued position) (. U32 max)))
        (if (or (not scope-same) cell-differs (!= ([] context-valued (+ (. held scope-first) position)) place))
          (= same false)
        )
        (lazy scope-same (call same-scope ([] context-scopes (+ (. held scope-first) position)) ([] scopes position)))
        (lazy cell-differs (!= ([] context-cells (+ (. held scope-first) position)) ([] cells position)))
      )
      (for (in position (..< 0 (. value-types length)))
        (if (!= ([] context-value-types (+ (. held value-first) position)) ([] value-types position))
          (= same false)
        )
      )
      (for (in position (..< 0 (. styles length)))
        (if (!= ([] context-types (+ (. held first) position)) ([] styles position))
          (= same false)
        )
      )
      (for (in position (..< 0 (. sheets length)))
        (let place (+ (. held first) (. held styles) position))
        (if (or (!= ([] context-types place) ([] sheets position)) (!= ([] context-levels place) ([] groups position)))
          (= same false)
