  (fn-do + intern-retyped InstanceId
    (param method InstanceId)
    (param base InstanceId)
    (param params (of ImmutableArray TypeId ArenaBacking))
    (param args (of ImmutableArray TypeId ArenaBacking))
    ; The instance of a method that yields typed again for a class's table in the place of the
    ; base's method `base`, which states the errors the base's generator carries; the method names
    ; it as `retyped`.
    (let row ([] rows method))
    (let retyped
      (call intern
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row self-type))
          (arg (. row effects))
          (arg (. row enclosing))
          (arg params)
          (arg args)
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg no-type)
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg (. U32 max))
          (arg (call ZoneEntry))
          (arg base)
        )
      )
    )
    (= (. ([] rows method) retyped) retyped)
    (return retyped)
  )
  (fn-do + intern-dispatched InstanceId
    (param module ModuleId)
    (param decl DeclId)
    (param self-type TypeId)
    (param declared EffectMask)
    (param caller InstanceId)
    (param params (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (param args (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (let row ([] rows caller))
