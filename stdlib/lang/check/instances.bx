        (= key (call mixed key (- (. U32 max) 3)))
        (for (in place fills)
          (= key (call mixed-text key (. ([] (. types properties) place) name text)))
        )
      )
      (if (!= (. slots length) 0)
        (= key (call mixed key (- (. U32 max) 4)))
        (for (in slot slots)
          (= key (call mixed-text key (. ([] slot-atoms slot) text)))
        )
      )
      (if (!= context (. U32 max))
        (= key (call mixed-context key context))
      )
      (if (!= inherits no-instance)
        (= key (call mixed (call mixed key (- (. U32 max) 6)) ([] stable-keys inherits)))
      )
      (if (!= redefaults 0)
        (= key (call mixed (call mixed key (- (. U32 max) 7)) redefaults))
      )
      (if spans
        (= key (call mixed key (- (. U32 max) 8)))
      )
      (if encoded
        (= key (call mixed key (- (. U32 max) 9)))
      )
      (+= stable-keys key)
