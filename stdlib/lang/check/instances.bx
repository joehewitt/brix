    (= (. ([] signatures instance) errors) (call (of RowRange TypeId) (as (. signature-types length) U32) (as (. errors length) U32)))
    (for (in type errors)
      (+= signature-types type)
    )
  )
  (fn-do + set-step-errors _
    (param instance InstanceId)
    (param errors (of ImmutableArray TypeId ArenaBacking))
    ; Gives a function that yields the errors a step of its body raises, which its generator
    ; carries. The function itself raises none: it makes the generator and returns it.
    (= (. ([] rows instance) step-errors) (call (of RowRange TypeId) (as (. signature-types length) U32) (as (. errors length) U32)))
    (for (in type errors)
      (+= signature-types type)
    )
  )
  (fn-do + move-step-errors _
    (param instance InstanceId)
    ; Gives the errors a function that yields states, or inherits, to a step of its body.
    (if (== (. ([] signatures instance) errors count) 0)
      (return)
    )
    (= (. ([] rows instance) step-errors) (. ([] signatures instance) errors))
    (= (. ([] signatures instance) errors) (call (of RowRange TypeId)))
  )
  (fn-expr + step-error-type TypeId
    (param instance InstanceId)
    (param position U32)
    ([] signature-types (+ (. ([] rows instance) step-errors start) position))
  )
  (fn-do + state-errors _
    (param instance InstanceId)
    (param errors (of ImmutableArray TypeId ArenaBacking))
    ; Gives an instance the errors its declaration lists or inherits.
    (call set-errors instance errors)
    (= (. ([] signatures instance) error-state) .errors-stated)
  )
  (fn-do + set-result _
    (param instance InstanceId)
    (param result TypeId)
    ; Gives an instance that raises errors the type it returns: its value, or one of them.
    (= (. ([] signatures instance) result) result)
  )
  (fn-expr + errors-known Bool
    (param instance InstanceId)
    (!= (. ([] signatures instance) error-state) .errors-unsettled)
  )
  (fn-expr + param-type TypeId
    (param instance InstanceId)
    (param position U32)
    (case? (< position (. row param-count))
      ([] signature-types (+ (- (. row args start) (. row param-count)) position))
    )
    (default
      no-type
    )
    (where
      (lazy row ([] signatures instance))
    )
  )
  (fn-expr + error-type TypeId
    (param instance InstanceId)
    (param position U32)
    (case? (< position (. row errors count))
      ([] signature-types (+ (. row errors start) position))
    )
    (default
      no-type
    )
    (where
      (lazy row ([] signatures instance))
    )
  )
  (fn-do + slot-id U32
    (param name Atom)
    ; The number of a slot's name among those of every slot an instance is given, as `intern`
    ; takes them; the name of the default slot is the empty text.
    (let found ([] slot-ids name))
    (if found
      (return found)
    )
    (let id (as (. slot-atoms length) U32))
    (+= slot-atoms name)
    (= ([] slot-ids name) id)
    (return id)
  )
  (fn-expr + slot-name Atom
    (param instance InstanceId)
    (param position U32)
    ; The name of a slot an instance is given, among those it is given in order.
    ([] slot-atoms ([] slot-places (+ (. ([] rows instance) slots start) position)))
  )
  (fn-expr + takes-binder Bool
    (param instance InstanceId)
    ; Whether a constructor is given, last, the function that gives a markup element's name its
    ; object.
    (and (!= (. slots count) 0) (== (. ([] slot-atoms ([] slot-places (- (+ (. slots start) (. slots count)) 1))) text) binder-slot))
    (where
      (lazy slots (. ([] rows instance) slots))
    )
  )
  (fn-do + slot-argument U32
    (param instance InstanceId)
    (param name Atom)
    ; The place among an instance's arguments of the function that builds the slot of a name, or
    ; `U32.max` where it is given none for it.
    (let slots (. ([] rows instance) slots))
    (let declared (- (. ([] signatures instance) args count) (. slots count)))
    (for (in offset (..< 0 (. slots count)))
      (if (== ([] slot-atoms ([] slot-places (+ (. slots start) offset))) name)
        (return (+ declared offset))
      )
    )
    (return (. U32 max))
  )
  (fn-do + fill-argument U32
    (param instance InstanceId)
    (param name Atom)
    ; The place among a constructor's arguments of the value a markup element gives it for the
    ; property of a name, or `U32.max` where the constructor is given none for it.
    (let fills (. ([] rows instance) fills))
    (let declared
      (scope (- unfilled (. ([] rows instance) carried) (. ([] rows instance) slots count))
        (lazy unfilled (- (. ([] signatures instance) args count) (. fills count)))
      )
    )
    (for (in offset (..< 0 (. fills count)))
      (if (== (. ([] (. types properties) ([] fill-places (+ (. fills start) offset))) name) name)
        (return (+ declared offset))
      )
    )
    (return (. U32 max))
  )
  (fn-expr + argument-type TypeId
    (param instance InstanceId)
    (param position U32)
    (case? (< position (. row args count))
      ([] signature-types (+ (. row args start) position))
    )
    (default
      no-type
    )
    (where
      (lazy row ([] signatures instance))
    )
  )
  (fn-do + mark-may-panic _
    (param instance InstanceId)
    (= (. ([] rows instance) may-panic) true)
  )
  (fn-do + mark-live _
    (param instance InstanceId)
    ; Says a property's value reads something tracked: it runs in a live action of its own.
    (= (. ([] rows instance) is-live) true)
  )
  (fn-do + mark-quiet _
    (param instance InstanceId)
    ; Says a call of an instance is never checked for a panic: the reference takes it for one
    ; that raises none, whatever runs.
    (= (. ([] rows instance) quiet) true)
  )
  (fn-do + mark-casts-errors _
    (param instance InstanceId)
    ; Says an instance lets out an error of a class above one it states, cast to that one, which
    ; panics where the error is not of it.
    (= (. ([] rows instance) casts-errors) true)
    (= (. ([] rows instance) may-panic) true)
  )
  (fn-do + mark-returns-own _
    (param instance InstanceId)
    ; Says a constructor written in source returns a value of its own: it constructs what it
    ; returns, and makes nothing of its class.
    (= (. ([] rows instance) returns-own) true)
  )
  (fn-do + mark-gives-unwritten _
    (param instance InstanceId)
    ; Says a function written with no body gives what the type it returns makes with nothing
    ; written.
    (= (. ([] rows instance) gives-unwritten) true)
  )
  (fn-do + clear-may-panic _
    (param instance InstanceId)
    (= (. ([] rows instance) may-panic) false)
  )
  (fn-do + mark-polls _
    (param instance InstanceId)
    ; Says a body has a loop that polls for the collector and for a terminating task. Such a
    ; function returns the panic the poll can raise. It is not one that may panic: no caller
    ; checks after it, as in the reference.
    (= (. ([] rows instance) polls) true)
  )
  (fn-do + mark-generator _
    (param instance InstanceId)
    ; Says a function yields. The errors it states are a step's from here on: the function
    ; makes its generator and raises none itself.
    (= (. ([] rows instance) is-generator) true)
    (if (== (. ([] signatures instance) error-state) .errors-stated)
      (call move-step-errors instance)
    )
  )
  (fn-do + set-generator _
    (param instance InstanceId)
    (param makes TypeId)
    (param yields TypeId)
    (param splits Bool (= false))
    ; Says what a function that yields makes where it is called, the generator of its items, and what
    ; each step of its body gives: an optional of an item, which holds nothing once the body has
    ; finished, or that or an error where a step raises. `splits` says the type of the items depends on
    ; the order its yields are folded in, some of them in loops, where the reference folds them in the
    ; order of its blocks: such a function has no shape.
    (= (. ([] rows instance) makes) makes)
    (= (. ([] rows instance) yields) yields)
    (= (. ([] rows instance) splits-yields) splits)
  )
  (fn-do + mark-ends-generator _
    (param instance InstanceId)
    (param yields TypeId)
    ; Says a function is the one that ends a generator, which gives the generator its last
    ; step where it waits at a yield, and what a step of that generator gives.
    (= (. ([] rows instance) ends-generator) true)
    (= (. ([] rows instance) yields) yields)
  )
  (fn-do _ merge-ranked _
    (param into (of Array InstanceId ArenaBacking))
    (param start Size)
    (param middle Size)
    (param end Size)
    (let left start)
    (let right middle)
    (for (in position (..< start end))
      (if (and (< left middle) (or (>= right end) (not (call ranks-before ([] ordered right) ([] ordered left)))))
        (= ([] into position) ([] ordered left))
        (+= left 1)
        (else
          (= ([] into position) ([] ordered right))
          (+= right 1)
        )
      )
    )
  )
  (fn-expr _ ranks-before Bool
    (param first InstanceId)
    (param second InstanceId)
    (case? (!= (== (. left initializer) 0) (== (. right initializer) 0))
      (== (. left initializer) 0)
    )
    (case? (!= (. left module) (. right module))
      (< (. left module) (. right module))
    )
    (case? (!= (. left decl) (. right decl))
      (< (. left decl) (. right decl))
    )
    (default
      (< ([] stable-keys first) ([] stable-keys second))
    )
    (where
      (lazy left ([] rows first))
      (lazy right ([] rows second))
    )
  )
  (fn-do + intern-swap-entry U32
    (param entry SwapEntry)
    ; The number of a fake bound to an effect among `swap-entries`, counted from 1; made at the first.
    (for (in index (..< 0 (. swap-entries length)))
      (let held ([] swap-entries index))
      (if (and (== (. held effect) (. entry effect)) (== (. held fake) (. entry fake)) same-outer)
        (return (as (+ index 1) U32))
      )
      (lazy same-outer (and (== (. held outer) (. entry outer)) (== (. held banned) (. entry banned))))
    )
    (+= swap-entries entry)
    (return (as (. swap-entries length) U32))
  )
  (fn-do + intern-swap-set U32
    (param entries (list U32))
    ; The number of a set of fakes, one for each effect, in the order of the effects, among the sets
    ; `swap-set-starts` and `swap-set-counts` keep, counted from 1, or 0 for none; made at the first.
    (return-if 0 (if (== (. entries length) 0)))
    (blank)
    (for (in index (..< 0 (. swap-set-starts length)))
      (if (== ([] swap-set-counts index) (as (. entries length) U32))
        (let start ([] swap-set-starts index))
        (let same true)
        (for (in offset (..< 0 (. entries length)))
          (if (!= ([] swap-set-entries (as (+ start offset) U32)) ([] entries offset))
            (= same false)
          )
        )
        (if same
          (return (as (+ index 1) U32))
        )
      )
    )
    (+= swap-set-starts (as (. swap-set-entries length) U32))
    (+= swap-set-counts (as (. entries length) U32))
    (for (in entry entries)
      (+= swap-set-entries entry)
    )
    (return (as (. swap-set-starts length) U32))
  )
  (fn-do + swap-entry-of U32
    (param effects EffectMask)
    (param effect U32)
    ; The fake a mask binds to an effect, by its number among `swap-entries`, or 0 for none.
    (let set (call swap-set-of effects))
    (return-if 0 (if (== set 0)))
    (blank)
    (let start ([] swap-set-starts (- set 1)))
    (for (in position (..< start (+ start ([] swap-set-counts (- set 1)))))
      (let entry ([] swap-set-entries position))
      (return-if entry (if (== (. ([] swap-entries (- entry 1)) effect) effect)))
    )
    (return 0)
  )
  (fn-do + fake-of TypeId
    (param effects EffectMask)
    (param effect U32)
    ; The class of the fake a mask binds to an effect, or no type where it binds none or the effect is
    ; known to reach its real doors.
    (let entry (call swap-entry-of effects effect))
    (return (if-expr (== entry 0) no-type (. ([] swap-entries (- entry 1)) fake)))
  )
  (fn-do + fake-kind U32
    (param effect U32)
    (param fake TypeId)
    ; The number a slot of an effect holds where a `do with` binds a fake of a class to it, counted
    ; from 1 among the classes fakes of the effect are bound as, in the order they are first bound,
    ; or 0 for none.
    (let kind U32)
    (let seen (list TypeId))
    (for (in entry swap-entries)
      (if (and (== (. entry effect) effect) (!= (. entry fake) no-type) (== (call (. seen find) (. entry fake)) null))
        (+= seen (. entry fake))
        (+= kind 1)
        (return-if kind (if (== (. entry fake) fake)))
      )
    )
    (return 0)
  )
  (fn-do + fakes-of (list TypeId)
    (param effect U32)
    ; The classes fakes of an effect are bound as, in the order of their numbers (`fake-kind`).
    (let seen (list TypeId))
    (for (in entry swap-entries)
      (if (and (== (. entry effect) effect) (!= (. entry fake) no-type) (== (call (. seen find) (. entry fake)) null))
        (+= seen (. entry fake))
      )
    )
    (return seen)
  )
  (fn-do + swapped EffectMask
    (param effects EffectMask)
    (param effect U32)
    (param entry U32)
    ; A mask with what it binds to an effect replaced by an entry, or by nothing for 0.
    (let set (call swap-set-of effects))
    (let entries (list U32))
    (let placed (== entry 0))
    (if (!= set 0)
      (let start ([] swap-set-starts (- set 1)))
      (for (in position (..< start (+ start ([] swap-set-counts (- set 1)))))
        (let held ([] swap-set-entries position))
        (let held-effect (. ([] swap-entries (- held 1)) effect))
        (if (and (not placed) (< (. ([] swap-entries (- entry 1)) effect) held-effect))
          (+= entries entry)
          (= placed true)
        )
        (if (!= held-effect effect)
          (+= entries held)
        )
      )
    )
    (if (not placed)
      (+= entries entry)
    )
    (return (call with-swap-set effects (call intern-swap-set entries)))
  )
  (fn-do + bound-to EffectMask
    (param effects EffectMask)
    (param effect U32)
    (param fake TypeId)
    ; The mask of code under a `do with` that binds a fake of a class to an effect, which keeps what
    ; was bound to the effect outside and whether it was banned there.
    (let outer (call swap-entry-of effects effect))
    (let banned (!= (/and/ effects (call ban-bit effect)) 0))
    (return (call swapped effects effect (call intern-swap-entry (call SwapEntry effect fake outer banned))))
  )
  (fn-do + handled-by EffectMask
    (param effects EffectMask)
    (param entry U32)
    ; The mask a fake's method runs under where it answers a door of the effect an entry binds it to,
    ; from the door's own: the effect as it was outside the `do with`, banned or not, and bound to
    ; what was bound there, or else known to reach its real doors. The rest is as at the door.
    (let held ([] swap-entries (- entry 1)))
    (let outer
      (block
        (case? (!= (. held outer) 0)
          (. held outer)
        )
        (default
          (call intern-swap-entry (call SwapEntry (. held effect) no-type 0 false))
        )
      )
    )
    (let bit (call ban-bit (. held effect)))
    (let banned (if-expr (. held banned) (/or/ effects bit) (/and/ effects (/xor/ (. U64 max) bit))))
    (return (call swapped banned (. held effect) outer))
  )
  (fn-do _ mixed-swaps StableKey
    (param key StableKey)
    (param set U32)
    ; Mixes a set of fakes into a stable key by what each binds rather than by its number, which
    ; another type pass gives another set.
    (let mixed-key (call mixed key (- (. U32 max) 11)))
    (let start ([] swap-set-starts (- set 1)))
    (for (in position (..< start (+ start ([] swap-set-counts (- set 1)))))
      (= mixed-key (call mixed-swap-entry mixed-key ([] swap-set-entries position)))
    )
    (return mixed-key)
  )
  (fn-do _ mixed-swap-entry StableKey
    (param key StableKey)
    (param entry U32)
    (let held ([] swap-entries (- entry 1)))
    (let fake-key (if-expr (== (. held fake) no-type) 0u64 (call (. types key-of) (. held fake))))
    (let mixed-key (call mixed (call mixed (call mixed key (. held effect)) fake-key) (if-expr (. held banned) 1 0)))
    (return-if (call mixed mixed-key 0) (if (== (. held outer) 0)))
    (return (call mixed-swap-entry (call mixed mixed-key 1) (. held outer)))
  )
  (fn-do _ mixed-context StableKey
    (param key StableKey)
    (param context U32)
    ; Mixes a style context into a stable key by what it holds rather than by its number, which
    ; another type pass gives another context.
    (let held ([] contexts context))
    (let mixed-key (call mixed (call mixed (call mixed (call mixed key (- (. U32 max) 5)) (. held styles)) (. held sheets)) (. held layer)))
    (if (!= (. held made) no-type)
      (= mixed-key (call mixed mixed-key (call (. types key-of) (. held made))))
    )
    (for (in position (..< (. held first) (+ (. held first) (. held styles) (. held sheets))))
      (= mixed-key
        (call mixed
          (block
            (arg (call mixed mixed-key (call (. types key-of) ([] context-types position))))
            (arg ([] context-levels position))
          )
        )
      )
    )
    (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
      (let scoped (call mixed-scope mixed-key ([] context-scopes position)))
      (= mixed-key (call mixed (call mixed scoped ([] context-cells position)) ([] context-valued position)))
    )
    (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
      (= mixed-key (call mixed mixed-key (call (. types key-of) ([] context-value-types position))))
    )
    (return mixed-key)
  )
  (fn-do _ mixed-scope StableKey
    (param key StableKey)
    (param scope RuleScope)
    ; Mixes a rule written in a rule into a stable key by what it is: the rule, its owner, whether it
    ; reaches only its element's own markup, and each frame around it, innermost first.
    (let mixed-key
      (call mixed
        (block
          (arg (call mixed (call mixed (call mixed key (. scope module)) (. scope decl)) (call (. types key-of) (. scope owner))))
          (arg (as (. scope own) U32))
        )
      )
    )
    (let frame (. scope frames))
    (while (!= frame (. U32 max))
      (let held ([] frames frame))
      (= mixed-key
        (call mixed
          (block
            (arg (call mixed (call mixed (call mixed mixed-key (. held module)) (. held decl)) (call (. types key-of) (. held owner))))
            (arg (. held gate))
          )
        )
      )
      (= frame (. held outer))
    )
    (return mixed-key)
  )
  (fn-do _ fill-equality-key _
    (param module ModuleId)
    (param value TypeId)
    (call ensure-scratch 7)
    (= ([] key-scratch 0) module)
    (= ([] key-scratch 1) (. ([] (. types program modules) module) main-decl))
    (= ([] key-scratch 2) value)
    (= ([] key-scratch 3) 0)
    (= ([] key-scratch 4) no-instance)
    (= ([] key-scratch 5) (- (. U32 max) 1))
    (= ([] key-scratch 6) 0)
  )
  (fn-do _ ensure-scratch _
    (param count Size)
    (if (> count (. key-scratch length))
      (let capacity (. key-scratch length))
      (while (< capacity count)
        (*= capacity 2)
      )
      (= key-scratch (call (. key-scratch resize) capacity arena))
    )
  )
)

(type + InstanceState (is U32)
  (variant instance-unstarted (= 0))
  (variant instance-in-progress (= 1))
  (variant instance-done (= 2))
  (variant instance-failed (= 3))
)

(type + ReturnState (is U32)
  (variant return-declared (= 0))
  (variant return-pending (= 1))
  (variant return-inferred (= 2))
  (variant return-failed (= 3))
)

(type + HeaderState (is U32)
  ; What a call reads of a callee before the callee's body is typed. An open header leaves the
  ; return type to the body, so a call types the body first. A settled one gives the return type
  ; itself, and the body waits in the queue.
  (variant header-unread (= 0))
  (variant header-open (= 1))
  (variant header-settled (= 2))
)

(type + ErrorState (is U32)
  ; Whether the errors an instance raises are known. They are stated when the declaration lists
  ; them or inherits a list. Otherwise they are those its body lets out, and they stay unsettled
  ; until the body and every callee whose errors pass through it are typed.
  (variant errors-unsettled (= 0))
  (variant errors-stated (= 1))
  (variant errors-settled (= 2))
)

(type + BoundCall (is U8)
  ; How a binding made a value of a function type calls the instance it runs, as the
  ; instance's declaration says: as a function of no object, as a method of the object the
  ; binding holds, as a constructor written for a class, or as none of these.
  (blank)
  (variant bound-call-none (= 0))
  (variant bound-call-function (= 1))
  (variant bound-call-method (= 2))
  (variant bound-call-constructor (= 3))
)

(type + ZoneEntry (is Struct)
  ; Where a GC-free zone is entered: the `do` block that enters it, or the declaration of the
  ; function that makes it, in its module. A site of 0 is no zone.
  (blank)
  (prop + module ModuleId (= 0))
  (prop + site SyntaxId (= 0))
)

(type + StyleContext (is Struct)
  ; The styles and style sheets markup sees where it makes an object of a class whose markup is
  ; its content, as the reference's `MarkupStyleContext` holds them: `styles` styles from `first`
  ; among `context-types`, the one that answers a name first first, then `sheets` style sheets,
  ; each with its group among `context-levels`, numbered from 0, lowest first; the style rules
  ; written in rules it sees, `scopes` of them from `scope-first` among `context-scopes`, each
  ; with how many state cells of the `when`s around it are given with it (`context-cells`); and
  ; for the content of a class above the object's, the object's class (`made`), or no type. The
  ; context of the function that builds content a style rule generates holds the `layer` the
  ; declarations of the markup it makes take, which no other does, and its `context-cells` say
  ; which rules are seen under the state cell of a `when`, which it is not given. The values of the
  ; rules around rules written in rules that it gives follow the cells, `values` of them of the
  ; types from `value-first` among `context-value-types`; `context-valued` holds, for each rule,
  ; the place among what the context gives of the first value of the rule around it that takes
  ; some, or `U32.max`.
  (blank)
  (prop + first U32)
  (prop + styles U32)
  (prop + sheets U32)
  (prop + scope-first U32)
  (prop + scopes U32)
  (prop + made TypeId)
  (prop + layer U32 (= 0))
  (prop + value-first U32 (= 0))
  (prop + values U32 (= 0))
)

(type + SwapEntry (is Struct)
  ; A fake a `do with` binds to an effect: the effect's number, the class of the fake, or no type
  ; where the effect is known to reach its real doors, as in a fake's own methods; what was bound
  ; to the effect outside, by its number among `swap-entries`, or 0 for nothing; and whether the
  ; effect was banned there.
  (blank)
  (prop + effect U32)
  (prop + fake TypeId)
  (prop + outer U32)
  (prop + banned Bool)
)

(type + StateKey (is Struct)
  ; Where the state cell of a `when` is made, which tells apart the cells a markup element and the
  ; function that builds content its outlet mounts agree on, as the reference's `stateKey` numbers
  ; one for a `when` at a site: the site, in `module`, a markup element, a root `<This`, or a class
  ; for its rules `• This`, and the `when`, in `when-module`.
  (blank)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + when-module ModuleId)
  (prop + when SyntaxId)
)

(type + ScopeOwn (is U8)
  ; Whether a rule written in a rule reaches only the markup of an element's own class, as one
  ; written `• own` does, and where it is, as the reference's `MarkupStyleRuleScope.own` says:
  ; - `scope-plain`: it reaches all the markup under the element.
  ; - `scope-pending`: it was brought into view at the element and matches nothing until the function
  ;   that fills the element's object takes it.
  ; - `scope-entered`: it matches in the markup of the class being filled, and the function that fills
  ;   the object of an element there does not take it.
  (blank)
  (variant scope-plain (= 0))
  (variant scope-pending (= 1))
  (variant scope-entered (= 2))
)

(type + RuleScope (is Struct)
  ; A style rule written in another, which markup under an element the other is applied to sees,
  ; as the reference's `MarkupStyleRuleScope` holds one: the rule; the class or style sheet that
  ; holds it as the rule around it was matched (`owner`), which is a sheet for a rule of a sheet
  ; and else the class whose element the rule around it was applied to, or the class that writes
  ; it; the rules applied around it, the innermost among `frames`, or `U32.max` for none; and
  ; whether it reaches only the markup of the element's own class (`own`).
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + owner TypeId)
  (prop + frames U32)
  (prop + own ScopeOwn (= .scope-plain))
)

(type + ScopeUse (is Struct)
  ; A rule written in a rule as markup being typed sees it: the scope, and the state cell that
  ; holds whether the innermost `when` around it holds, among `Facts.scope-cells`, or `U32.max`
  ; where no `when` is around it; the values of the rule around it that takes some, among
  ; `Facts.scope-values`, or `U32.max` where none does, or `U32.max - 1` where they are not here;
  ; and the state cells of the `when`s further out (`Facts.scope-links`), or `U32.max`.
  (blank)
  (prop + scope RuleScope)
  (prop + cell U32 (= (. U32 max)))
  (prop + values U32 (= (. U32 max)))
  (prop + outer-cells U32 (= (. U32 max)))
)

(type + RuleFrame (is Struct)
  ; One style rule applied around a rule written in a rule, as the reference's
  ; `MarkupStyleRuleFrame` holds one: the rule, the class or style sheet it was matched for, the
  ; `when` of it the inner rule is written in, or none, and the frames around it (`outer`), or
  ; `U32.max`.
  (blank)
  (prop + outer U32)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + owner TypeId)
  (prop + gate SyntaxId)
)

(type + InstanceSignature (is Struct)
  (prop + args (of RowRange TypeId))
  (prop + returns TypeId (= no-type))
  (prop + declared-returns TypeId (= no-type))
  (prop + return-state ReturnState)
  (prop + param-count U32 (= 0))
  (prop + read-in-progress Bool)
  (prop + read-by InstanceId (= no-instance))
  (prop + errors (of RowRange TypeId))
  (prop + unreturned SyntaxId (= 0))
  (prop + header HeaderState)
  (prop + error-state ErrorState)
  (prop + errors-read-early Bool)
  (prop + pending U32 (= (. U32 max)))
  (prop + result TypeId (= no-type))
)

(type + ProbeRuntime (is Struct)
  ; The functions of the probes module that a program whose probes compile calls of its own
  ; accord, each `no-instance` until the type pass demands them: those that open the record of
  ; probes, make room for counters and for profile metrics, declare a key, a class, a log, an event,
  ; a counter, the type of one of their values, which `argument-type` is the type of, and a metric of
  ; the profile, and say the declarations are done; then the one that adds to a counter, which the
  ; counts the compiler keeps of events publish through, the one that counts what the collector did,
  ; the one that closes the record, the one that flushes what a thread has written, and the one a
  ; loop and a call that suspends the task look in at, which flushes when it is time and answers the
  ; controller.
  (blank)
  (prop + begin InstanceId (= no-instance))
  (prop + counter-setup InstanceId (= no-instance))
  (prop + profile-setup InstanceId (= no-instance))
  (prop + declare-key InstanceId (= no-instance))
  (prop + declare-type InstanceId (= no-instance))
  (prop + declare-log InstanceId (= no-instance))
  (prop + declare-event InstanceId (= no-instance))
  (prop + declare-counter InstanceId (= no-instance))
  (prop + declare-argument InstanceId (= no-instance))
  (prop + declare-profile-metric InstanceId (= no-instance))
  (prop + counter-add InstanceId (= no-instance))
  (prop + ready InstanceId (= no-instance))
  (prop + collector-counts InstanceId (= no-instance))
  (prop + end InstanceId (= no-instance))
  (prop + task-flush InstanceId (= no-instance))
  (prop + safepoint InstanceId (= no-instance))
  (prop + argument-type TypeId (= no-type))
  (prop + demanded Bool)
)

(type + PanicReport (is Struct)
  ; The instances the report of an unhandled panic is built from, the same for every root. Each
  ; is `no-instance` until the type pass demands the report.
  ; `message` and `source-text` convert the panic and its source to text. `source` constructs
  ; a source. `termination` is the check a polling call makes for a terminating task, and
  ; `termination-error` constructs the panic it raises. `panic` constructs a panic from a
  ; message, for the panics the compiler raises itself. `source-slot`, `trace-slot` and
  ; `previous-slot` are the slots of the panic's properties that hold its source, its stack
  ; trace, and the error a transformer raised it in place of. `union-error`
  ; constructs the error of a union that holds another case than the one asked for, and
  ; `union-text` converts it to the message of the panic raised for it; both are demanded where
  ; a union is first unwrapped. `error-text` converts to text an error that no caller handles,
  ; and is demanded where the main of some module lets an error out, or where a text written in
  ; source is converted by a function that raises.
  (blank)
  (prop + message InstanceId (= no-instance))
  (prop + source-text InstanceId (= no-instance))
  (prop + source InstanceId (= no-instance))
  (prop + termination InstanceId (= no-instance))
  (prop + termination-error InstanceId (= no-instance))
  (prop + panic InstanceId (= no-instance))
  (prop + source-slot U32 (= (. U32 max)))
  (prop + trace-slot U32 (= (. U32 max)))
  (prop + previous-slot U32 (= (. U32 max)))
  (prop + union-error InstanceId (= no-instance))
  (prop + union-text InstanceId (= no-instance))
  (prop + error-text InstanceId (= no-instance))
)

(type + LiveRuntime (is Struct)
  ; The instances a tracked value runs through, the same for every root, each `no-instance`
  ; until the type pass first types a tracked read. `trackers`, `subscribers` and `actions` make
  ; the empty lists of trackers, of subscribers and of live actions, `action` makes a live
  ; action of trackers and a callback, and `add-action` adds one to a list of them, as
  ; `add-tracker` adds a tracker to a list of trackers. `track` notes
  ; a read in the trackers of the action that runs, and `track-collection` the read of a
  ; collection, whose changes it then follows; `dispatch` runs the actions that read a
  ; property, and `previous` and `next` answer the trackers of the action that runs. `pop` and
  ; `close` take the actions an object owns off their list and close each, and `has-actions`
  ; says whether the list holds none. `callback` is the type of an action's callback, and
  ; `callback-result` what the callback answers with its errors. `demanded` says the type pass
  ; has begun typing them.
  (blank)
  (prop + trackers InstanceId (= no-instance))
  (prop + subscribers InstanceId (= no-instance))
  (prop + actions InstanceId (= no-instance))
  (prop + action InstanceId (= no-instance))
  (prop + add-action InstanceId (= no-instance))
  (prop + add-tracker InstanceId (= no-instance))
  (prop + track InstanceId (= no-instance))
  (prop + track-collection InstanceId (= no-instance))
  (prop + track-active InstanceId (= no-instance))
  (prop + track-active-collection InstanceId (= no-instance))
  (prop + dispatch InstanceId (= no-instance))
  (prop + memo-action InstanceId (= no-instance))
  (prop + memo-settle InstanceId (= no-instance))
  (prop + previous InstanceId (= no-instance))
  (prop + next InstanceId (= no-instance))
  (prop + enter InstanceId (= no-instance))
  (prop + leave InstanceId (= no-instance))
  (prop + pop InstanceId (= no-instance))
  (prop + close InstanceId (= no-instance))
  (prop + has-actions InstanceId (= no-instance))
  (prop + callback TypeId (= no-type))
  (prop + callback-result TypeId (= no-type))
  (prop + demanded Bool)
)

(fn-do + dispatch-effects EffectMask
  (param effects EffectMask)
  (let normalized effects)
  (if (!= (/and/ normalized (. CompilationEffect gc-free)) 0)
    (= normalized (/or/ normalized (. CompilationEffect no-heap)))
    (= normalized (/or/ normalized (. CompilationEffect no-safepoint)))
  )
  (if (!= (/and/ normalized (. CompilationEffect no-safepoint)) 0)
    (= normalized (/or/ normalized (. CompilationEffect no-suspend)))
  )
  (return (/and/ normalized (/or/ dispatch-effect-bits (call ban-bits) (call swap-bits))))
)

(fn-expr + runs-inline Bool
  (param row Instance)
  ; Whether an instance is typed only in the run of another, never alone from the queue: one written
  ; in another and one typed on trial.
  (or (!= (. row enclosing) no-instance) (!= (. row probe) 0))
)

(fn-expr + moved-node SyntaxId
  (param moved (list SyntaxId))
  (param syntax SyntaxId)
  ; Where an edit moves a node of the module it edits (`Instances.move-syntax`), or the node itself
  ; where it is in a body, or is none.
  (if-expr (and (< (as syntax Size) (. moved length)) (!= ([] moved syntax) 0)) ([] moved syntax) syntax)
)

(fn-expr + unmoved Bool
  (param moved (list SyntaxId))
  (param syntax SyntaxId)
  ; Whether a node of the module an edit edits is in a body the edit changes, so has nowhere it moves
  ; to (`Instances.move-syntax`).
  (and (< (as syntax Size) (. moved length)) (!= syntax 0) (== ([] moved syntax) 0))
)

(type _ InitializerKey (is Tuple)
  (implements Hashable)
  ; What the typing of one property's value is found by: the module that declares the property,
  ; the property, the receiver it is typed for, and the class of the element a style rule a style
  ; sheet writes is typed for, or no type.
  (blank)
  (prop + module ModuleId)
  (prop + property DeclId)
  (prop + receiver TypeId)
  (prop + element TypeId)
  (fn-expr + hash Hash :get
    (as (call mixed (call mixed (call mixed (call mixed stable-key-seed module) property) receiver) element) Hash)
  )
  (fn-expr + (infix this == (param other This)) _
    (and same-property (== receiver (. other receiver)) (== element (. other element)))
    (where
      (lazy same-property (and (== module (. other module)) (== property (. other property))))
    )
  )
)

(fn-expr + entered-use ScopeUse
  (param use ScopeUse)
  ; A rule written in a rule as it is seen in the markup of the class of the element it was brought
  ; into view at: matching there where it reaches only that markup and matched nothing before.
  (case? (!= (. use scope own) .scope-pending)
    use
  )
  (default
    (call ScopeUse
      (block
        (arg (call RuleScope (. scope module) (. scope decl) (. scope owner) (. scope frames) .scope-entered))
        (arg (. use cell))
        (arg (. use values))
        (arg (. use outer-cells))
      )
    )
  )
  (where
    (lazy scope (. use scope))
  )
)

(fn-do + scope-own ScopeOwn
  (param written AST)
  (param line SyntaxId)
  ; How a rule written in a rule, at a line of the module that writes it, is first brought into
  ; view: matching nothing until its element's object is filled where it is written `• own`.
  (match? ([] (. written nodes) line)
    (case (call .node-rule-syntax row)
      (return-if .scope-pending (if (. row is-own)))
    )
  )
  (return .scope-plain)
)
