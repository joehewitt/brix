(import ./instances)
(import ./session)
(import ./shared-results)
(import ./stable-key)
(import ./type-store)
(import ./types)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(blank)
(prop _ portable-none _ (= 0u32))
(prop _ portable-invalid _ (= 1u32))
(prop _ portable-class _ (= 2u32))
(prop _ portable-variable _ (= 3u32))
(prop _ portable-inference _ (= 4u32))
(prop _ portable-tuple _ (= 5u32))
(prop _ portable-struct _ (= 6u32))
(prop _ portable-union _ (= 7u32))
(prop _ portable-named-union _ (= 8u32))
(prop _ portable-function _ (= 9u32))
(prop _ portable-result _ (= 10u32))
(prop _ portable-associated _ (= 11u32))
(prop _ portable-binding _ (= 12u32))

(fn-do + export-instance (? PortableInstance)
  (param session Session)
  (param id InstanceId)
  ; The instance as another pass can intern it, or none for one that only its own pass can: one
  ; written in another or that holds a closure, the value of a property or of a rule a root
  ; applies, an equality, one a markup element makes, one in a GC-free zone or under a fake, one
  ; typed again for the errors it inherits, a constructor that leaves properties to the defaults of
  ; the class it makes (`Instance.redefaults`), a rule typed for the text it matched
  ; (`Instance.spans`), and one typed for the UTF-8 bytes of a String (`Instance.encoded`). A constructor a markup element
  ; gives properties, slots or styles is written out with them: the properties by their places
  ; among those of its class, the slots by their names and the styles by what its style context
  ; holds (`put-context`).
  (let instances (. session instances))
  (let row ([] (. instances rows) id))
  (if (or (!= (. row enclosing) no-instance) (. row holds-closure) (!= (. row initializer) 0) (!= (. row root-values) 0))
    (return null)
  )
  (if (or (. row compares) (!= (. row element) no-type) (!= (. row inherits) no-instance) materializes)
    (return null)
  )
  (lazy materializes (!= (. row materialized) no-instance))
  (if (or (!= (. row redefaults) 0) (. row spans) (. row encoded))
    (return null)
  )
  (if (or (!= (/and/ (. row effects) (. CompilationEffect gc-free)) 0) (!= (call swap-set-of (. row effects)) 0))
    (return null)
  )
  (let words (list U32))
  (let names (list Atom))
  (let types (. session types))
  (if (or (not (call put-type types (. row self-type) words names)) (not (call put-type types (. row row-receiver) words names)))
    (return null)
  )
  (if (not (call put-type types (. row helper) words names))
    (return null)
  )
  (let signature ([] (. instances signatures) id))
  (let params (- (. signature args start) (. signature param-count)))
  (+= words (. signature param-count))
  (+= words (. signature args count))
  (for (in position (..< params (+ (. signature args start) (. signature args count))))
    (if (not (call put-type types ([] (. instances signature-types) position) words names))
      (return null)
    )
  )
  (if (or (not (call put-fills session row words names)) (not (call put-context session (. row context) words names)))
    (return null)
  )
  (+= words (. row slots count))
  (for (in offset (..< 0 (. row slots count)))
    (call put-name ([] (. instances slot-atoms) ([] (. instances slot-places) (+ (. row slots start) offset))) words names)
  )
  (return
    (call PortableInstance
      (block
        (arg (. row module))
        (arg (. row decl))
        (arg (. row effects))
        (arg ([] (. instances stable-keys) id))
        (arg (. row row-case))
        (arg (. row row-validated))
        (arg words)
        (arg names)
      )
    )
  )
)

(fn-do + import-instance InstanceId
  (param session Session)
  (param item PortableInstance)
  ; Interns an instance another pass wrote out, without queueing it.
  (let types (. session types))
  (let reader (call PortableReader types (. item words) (. item names)))
  (let self-type (call (. reader type)))
  (let row-receiver (call (. reader type)))
  (let helper (call (. reader type)))
  (let param-count (call (. reader next)))
  (let arg-count (call (. reader next)))
  (let stack (. types scratch types))
  (let mark (. stack mark))
  (for (in _ (..< 0 (+ param-count arg-count)))
    (call (. stack push) (call (. reader type)))
  )
  (let params (call (. stack span) mark param-count))
  (let args (call (. stack span) (+ mark param-count) arg-count))
  (let instances (. session instances))
  (let words (. types scratch words))
  (let fills-mark (. words mark))
  (let fill-count (call (. reader next)))
  (if (!= fill-count 0)
    (call (. types complete) self-type)
    (let start (. ([] (. types completions) self-type) properties start))
    (for (in _ (..< 0 fill-count))
      (let place (+ start (call (. reader next))))
      (throw (call Panic "A property of another type pass is another property here") (if (!= (. ([] (. types properties) place) name) (call (. reader name)))))
      (blank)
      (call (. words push) place)
    )
  )
  (let fills (call (. words since) fills-mark))
  (let context (call read-context instances reader))
  (let slots-mark (. words mark))
  (let slot-count (call (. reader next)))
  (for (in _ (..< 0 slot-count))
    (call (. words push) (call (. instances slot-id) (call (. reader name))))
  )
  (let slots (call (. words since) slots-mark))
  (let id
    (call (. instances intern)
      (block
        (arg (. item module))
        (arg (. item decl))
        (arg self-type)
        (arg (. item effects))
        (arg no-instance)
        (arg params)
        (arg args)
        (arg false)
        (arg row-receiver)
        (arg (. item row-case))
        (arg (. item row-validated))
        (arg 0)
        (arg helper)
        (arg fills)
        (arg slots)
        (arg context)
      )
    )
  )
  (call (. words rewind) fills-mark)
  (call (. stack rewind) mark)
  (return id)
)

(fn-do + export-class (? PortableClass)
  (param types Types)
  (param id TypeId)
  ; The class as another pass can intern it (`import-class`), or none for one only its own pass
  ; knows.
  (let words (list U32))
  (let names (list Atom))
  (return-if null (if (not (call put-type types id words names))))
  (return (call PortableClass (call (. types key-of) id) words names))
)

(fn-do + import-class TypeId
  (param types Types)
  (param item PortableClass)
  ; Interns a class another pass wrote out.
  (return (call (. (call PortableReader types (. item words) (. item names)) type)))
)

(fn-do _ read-context U32
  (param instances Instances)
  (param reader PortableReader)
  ; Interns the style context a portable instance writes out (`put-context`), or gives none.
  (if (== (call (. reader next)) 0)
    (return (. U32 max))
  )
  (let style-count (call (. reader next)))
  (let sheet-count (call (. reader next)))
  (let styles (list TypeId))
  (let sheets (list TypeId))
  (let levels (list U32))
  (for (in position (..< 0 (+ style-count sheet-count)))
    (let type (call (. reader type)))
    (let level (call (. reader next)))
    (if (< position style-count)
      (+= styles type)
      (else
        (+= sheets type)
        (+= levels level)
      )
    )
  )
  (let scope-count (call (. reader next)))
  (let scopes (list RuleScope))
  (let cells (list U32))
  (let valued (list U32))
  (for (in _ (..< 0 scope-count))
    (let module (call (. reader next)))
    (let decl (call (. reader next)))
    (let owner (call (. reader type)))
    (let frames (call read-frames instances reader))
    (+= scopes (call RuleScope module decl owner frames (as (call (. reader next)) ScopeOwn)))
    (+= cells (call (. reader next)))
    (+= valued (call (. reader next)))
  )
  (let made (call (. reader type)))
  (let layer (call (. reader next)))
  (let value-count (call (. reader next)))
  (let value-types (list TypeId))
  (for (in _ (..< 0 value-count))
    (+= value-types (call (. reader type)))
  )
  (return (call (. instances intern-context) styles sheets levels scopes cells made layer valued value-types))
)

(fn-do _ read-frames U32
  (param instances Instances)
  (param reader PortableReader)
  ; Interns the style rules applied around a rule written in a rule that a portable instance writes
  ; out innermost first (`put-frames`), and gives the innermost, or none.
  (let count (call (. reader next)))
  (let modules (list U32))
  (let decls (list U32))
  (let owners (list TypeId))
  (let gates (list U32))
  (for (in _ (..< 0 count))
    (+= modules (call (. reader next)))
    (+= decls (call (. reader next)))
    (+= owners (call (. reader type)))
    (+= gates (call (. reader next)))
  )
  (let frame (. U32 max))
  (for (in offset (..< 0 count))
    (let position (- count 1 offset))
    (= frame
      (call (. instances intern-frame)
        (block
          (arg frame)
          (arg ([] modules position))
          (arg ([] decls position))
          (arg ([] owners position))
          (arg ([] gates position))
        )
      )
    )
  )
  (return frame)
)

(fn-do + export-result (? PortableResult)
  (param session Session)
  (param id InstanceId)
  ; What this pass knew of an instance once it typed its body, for another pass to take in, or none
  ; where taking it in might differ from typing the body there: one that pass could not intern
  ; (`export-instance`), one taken in itself, one whose typing changed what a pass cannot take in,
  ; one typed only with the one it is written in, one whose body failed or was reported on, one whose errors or return type wait on others, one
  ; that names another instance, and a rule, whose rollback marks a call reads.
  (let instances (. session instances))
  (let row ([] (. instances rows) id))
  (let signature ([] (. instances signatures) id))
  (if (or unfinished (. row imported) (. row unshared) (. row with-enclosing) (not (call (. instances errors-known) id)))
    (return null)
  )
  (lazy unfinished (!= (. row state) .instance-done))
  (if (or (== (. signature return-state) .return-pending) (== (. signature return-state) .return-failed))
    (return null)
  )
  (if (or (!= (. row materialized) no-instance) (!= (. row retyped) no-instance))
    (return null)
  )
  (if (or (!= (call rule-match (. session program) (. row module) (. row decl)) 0) (call (. session facts has-diagnostic) id))
    (return null)
  )
  (if (not (call export-instance session id))
    (return null)
  )
  (let words (list U32))
  (let names (list Atom))
  (let types (. session types))
  (if (or (not (call put-type types (. signature returns) words names)) (not (call put-type types (. signature declared-returns) words names)))
    (return null)
  )
  (if (or (not (call put-type types (. row makes) words names)) (not (call put-type types (. row yields) words names)))
    (return null)
  )
  (if (or (not (call put-errors session (. signature errors) words names)) (not (call put-errors session (. row step-errors) words names)))
    (return null)
  )
  (return
    (call PortableResult
      (block
        (arg (. row may-panic))
        (arg (. row polls))
        (arg (. row is-generator))
        (arg (. row reads-self))
        (arg (. row branches))
        (arg (. row returns-own))
        (arg (. row gives-unwritten))
        (arg (. row casts-errors))
        (arg (. row ends-generator))
        (arg (. row quiet))
        (arg (. row splits-yields))
        (arg (. row fills-share))
        (arg (. row uses-helper))
        (arg (. row rolls-helper))
        (arg (. row carries-mark))
        (arg (. row is-live))
        (arg (. row consumes))
        (arg (. row hands-back))
        (arg (. signature return-state))
        (arg (. signature header))
        (arg (. signature error-state))
        (arg (. signature unreturned))
        (arg (. signature read-in-progress))
        (arg (. signature errors-read-early))
        (arg words)
        (arg names)
      )
    )
  )
)

(fn-do _ put-errors Bool
  (param session Session)
  (param range (of RowRange TypeId))
  (param words (list U32))
  (param names (list Atom))
  (+= words (. range count))
  (for (in offset (..< 0 (. range count)))
    (if (not (call put-type (. session types) error-type words names))
      (return false)
    )
    (lazy error-type ([] (. session instances signature-types) (+ (. range start) offset)))
  )
  (return true)
)

(fn-do + import-result _
  (param session Session)
  (param id InstanceId)
  (param result PortableResult)
  ; Gives an instance not yet typed what another pass knew of it once it typed its body
  ; (`export-result`), in place of typing the body here. The body stays the other pass's.
  (let instances (. session instances))
  (let types (. session types))
  (let reader (call PortableReader types (. result words) (. result names)))
  (let returns (call (. reader type)))
  (let declared (call (. reader type)))
  (let makes (call (. reader type)))
  (let yields (call (. reader type)))
  (let stack (. types scratch types))
  (let mark (. stack mark))
  (for (in _ (..< 0 (call (. reader next))))
    (call (. stack push) (call (. reader type)))
  )
  (call (. instances set-errors) id (call (. stack since) mark))
  (call (. stack rewind) mark)
  (let step-count (call (. reader next)))
  (if (!= step-count 0)
    (for (in _ (..< 0 step-count))
      (call (. stack push) (call (. reader type)))
    )
    (call (. instances set-step-errors) id (call (. stack since) mark))
    (call (. stack rewind) mark)
  )
  (call (. instances set-returns) id returns declared (. result return-state))
  (= (. ([] (. instances signatures) id) header) (. result header))
  (= (. ([] (. instances signatures) id) error-state) (. result error-state))
  (= (. ([] (. instances signatures) id) unreturned) (. result unreturned))
  (= (. ([] (. instances signatures) id) read-in-progress) (. result read-in-progress))
  (= (. ([] (. instances signatures) id) errors-read-early) (. result errors-read-early))
  (= (. ([] (. instances rows) id) state) .instance-done)
  (= (. ([] (. instances rows) id) imported) true)
  (= (. ([] (. instances rows) id) may-panic) (. result may-panic))
  (= (. ([] (. instances rows) id) polls) (. result polls))
  (= (. ([] (. instances rows) id) is-generator) (. result is-generator))
  (= (. ([] (. instances rows) id) reads-self) (. result reads-self))
  (= (. ([] (. instances rows) id) branches) (. result branches))
  (= (. ([] (. instances rows) id) returns-own) (. result returns-own))
  (= (. ([] (. instances rows) id) gives-unwritten) (. result gives-unwritten))
  (= (. ([] (. instances rows) id) casts-errors) (. result casts-errors))
  (= (. ([] (. instances rows) id) makes) makes)
  (= (. ([] (. instances rows) id) yields) yields)
  (= (. ([] (. instances rows) id) ends-generator) (. result ends-generator))
  (= (. ([] (. instances rows) id) quiet) (. result quiet))
  (= (. ([] (. instances rows) id) splits-yields) (. result splits-yields))
  (= (. ([] (. instances rows) id) fills-share) (. result fills-share))
  (= (. ([] (. instances rows) id) uses-helper) (. result uses-helper))
  (= (. ([] (. instances rows) id) rolls-helper) (. result rolls-helper))
  (= (. ([] (. instances rows) id) carries-mark) (. result carries-mark))
  (= (. ([] (. instances rows) id) is-live) (. result is-live))
  (= (. ([] (. instances rows) id) consumes) (. result consumes))
  (= (. ([] (. instances rows) id) hands-back) (. result hands-back))
)

(fn-do + adopt Bool
  (param session Session)
  (param id InstanceId)
  ; Takes in what another pass of a parallel type pass published of an instance this pass has not
  ; begun to type (`SharedTyping`), in place of typing it, and says whether there was any.
  (if (or (not (. session shared)) (!= (. ([] (. session instances rows) id) state) .instance-unstarted))
    (return false)
  )
  (let result (call (. session shared find) ([] (. session instances stable-keys) id)))
  (if (not result)
    (return false)
  )
  (call import-result session id result)
  (return true)
)

(fn-do + offer-queued _
  (param session Session)
  ; Offers the other passes of a parallel type pass each instance typing queued here since the last
  ; offer that any of them can intern, and keeps the others in `session.local` to type here. First
  ; it publishes each instance whose errors settled since only after its body ended (`share`).
  (if (not (. session shared))
    (return)
  )
  (let shared (. session shared))
  (let instances (. session instances))
  (while (< (. session shared-settled) (. instances settled length))
    (call share session ([] (. instances settled) (. session shared-settled)))
    (+= (. session shared-settled) 1)
  )
  (while (< (. session offered) (. instances worklist length))
    (let queued ([] (. instances worklist) (. session offered)))
    (+= (. session offered) 1)
    (if (or started (call (. shared has) ([] (. instances stable-keys) queued)))
      (continue)
    )
    (lazy started (!= (. ([] (. instances rows) queued) state) .instance-unstarted))
    (let portable (call export-instance session queued))
    (if portable
      (call (. shared offer) portable)
      (else
        (+= (. session local) queued)
      )
    )
  )
)

(fn-do + share _
  (param session Session)
  (param id InstanceId)
  ; Publishes what this pass knew of an instance it typed, for the other passes of a parallel type
  ; pass to take in (`export-result`), where it can.
  (if (not (. session shared))
    (return)
  )
  (let result (call export-result session id))
  (if result
    (call (. (!! (. session shared)) publish) ([] (. session instances stable-keys) id) result)
  )
)

(fn-do _ put-type Bool
  (param types Types)
  (param id TypeId)
  (param words (list U32))
  (param names (list Atom))
  ; Writes a type out by what it is, its parts first. False for a closure, which only the pass
  ; that types the instance it is written in knows.
  (if (== id no-type)
    (+= words portable-none)
    (return true)
  )
  (match ([] (. types rows) id)
    (case .type-invalid
      (+= words portable-invalid)
    )
    (case (call .type-class row)
      (+= words portable-class)
      (+= words (. row module))
      (+= words (. row decl))
      (if (or (not (call put-range types (. row args) words names)) (not (call put-range types (. row errors) words names)))
        (return false)
      )
    )
    (case (call .type-variable row)
      (+= words portable-variable)
      (+= words (. row module))
      (+= words (. row decl))
      (+= words (. row index))
      (call put-name (. row name) words names)
    )
    (case (call .type-inference row)
      (+= words portable-inference)
      (+= words (. row scope))
      (+= words (. row ordinal))
    )
    (case (call .type-tuple row)
      (+= words portable-tuple)
      (if (not (call put-fields types (. row fields) (. row names) words names))
        (return false)
      )
    )
    (case (call .type-struct row)
      (+= words portable-struct)
      (if (not (call put-fields types (. row fields) (. row names) words names))
        (return false)
      )
    )
    (case (call .type-union row)
      (+= words portable-union)
      (if (not (call put-range types (. row cases) words names))
        (return false)
      )
    )
    (case (call .type-named-union row)
      (+= words portable-named-union)
      (call put-name (. row owner) words names)
      (+= words (. row made-in))
      (+= words (. row made-at))
      (if (not (call put-fields types (. row cases) (. row names) words names))
        (return false)
      )
    )
    (case (call .type-function row)
      (+= words portable-function)
      (+= words (if-expr (. row is-c) 1u32 0u32))
      (if (not (call put-type types (. row return-type) words names))
        (return false)
      )
      (if (or (not (call put-range types (. row args) words names)) (not (call put-range types (. row errors) words names)))
        (return false)
      )
    )
    (case (call .type-result row)
      (+= words portable-result)
      (if (or (not (call put-type types (. row value) words names)) (not (call put-range types (. row errors) words names)))
        (return false)
      )
    )
    (case (call .type-associated row)
      (+= words portable-associated)
      (+= words (. row module))
      (+= words (. row decl))
      (if (not (call put-type types (. row owner) words names))
        (return false)
      )
      (call put-name (. row name) words names)
      (if (not (call put-range types (. row args) words names))
        (return false)
      )
    )
    (case .type-closure
      (return false)
    )
    (case (call .type-binding row)
      (+= words portable-binding)
      (+= words (. row form))
      (+= words (. row scope))
      (+= words (. row module))
      (+= words (. row decl))
      (if (not (call put-type types (. row object) words names))
        (return false)
      )
      (+= words (. row param-count))
      (if (not (call put-range types (. row items) words names))
        (return false)
      )
    )
  )
  (return true)
)

(fn-do _ put-fills Bool
  (param session Session)
  (param row Instance)
  (param words (list U32))
  (param names (list Atom))
  ; Writes out the properties a markup element gives a constructor by their places among those of
  ; the class it makes, each with its name. False where one is not among them.
  (let types (. session types))
  (+= words (. row fills count))
  (if (== (. row fills count) 0)
    (return true)
  )
  (let range (. ([] (. types completions) (. row self-type)) properties))
  (for (in offset (..< 0 (. row fills count)))
    (let place ([] (. session instances fill-places) (+ (. row fills start) offset)))
    (if (or (< place (. range start)) (>= place (+ (. range start) (. range count))))
      (return false)
    )
    (+= words (- place (. range start)))
    (call put-name (. ([] (. types properties) place) name) words names)
  )
  (return true)
)

(fn-do _ put-context Bool
  (param session Session)
  (param context U32)
  (param words (list U32))
  (param names (list Atom))
  ; Writes out a style context by what it holds: its styles and its style sheets, each with its
  ; group, the rules written in rules it sees, each with the rules applied around it and what it is
  ; given, the class of the object whose content it makes, its layer, and the types of the values it
  ; gives. False where one of those types is a closure.
  (if (== context (. U32 max))
    (+= words 0)
    (return true)
  )
  (let instances (. session instances))
  (let types (. session types))
  (+= words 1)
  (let held ([] (. instances contexts) context))
  (+= words (. held styles))
  (+= words (. held sheets))
  (for (in position (..< (. held first) (+ (. held first) (. held styles) (. held sheets))))
    (if (not (call put-type types ([] (. instances context-types) position) words names))
      (return false)
    )
    (+= words ([] (. instances context-levels) position))
  )
  (+= words (. held scopes))
  (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
    (let scope ([] (. instances context-scopes) position))
    (+= words (. scope module))
    (+= words (. scope decl))
    (if (or (not (call put-type types (. scope owner) words names)) (not (call put-frames session (. scope frames) words names)))
      (return false)
    )
    (+= words (. scope own))
    (+= words ([] (. instances context-cells) position))
    (+= words ([] (. instances context-valued) position))
  )
  (if (not (call put-type types (. held made) words names))
    (return false)
  )
  (+= words (. held layer))
  (+= words (. held values))
  (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
    (if (not (call put-type types ([] (. instances context-value-types) position) words names))
      (return false)
    )
  )
  (return true)
)

(fn-do _ put-frames Bool
  (param session Session)
  (param frame U32)
  (param words (list U32))
  (param names (list Atom))
  ; Writes out the style rules applied around a rule written in a rule, innermost first.
  (let instances (. session instances))
  (let chain (list U32))
  (let current frame)
  (while (!= current (. U32 max))
    (+= chain current)
    (= current (. ([] (. instances frames) current) outer))
  )
  (+= words (as (. chain length) U32))
  (for (in held chain)
    (let row ([] (. instances frames) held))
    (+= words (. row module))
    (+= words (. row decl))
    (if (not (call put-type (. session types) (. row owner) words names))
      (return false)
    )
    (+= words (. row gate))
  )
  (return true)
)

(fn-do _ put-range Bool
  (param types Types)
  (param range (of RowRange TypeId))
  (param words (list U32))
  (param names (list Atom))
  (+= words (. range count))
  (for (in offset (..< 0 (. range count)))
    (if (not (call put-type types (call (. types child-type) range offset) words names))
      (return false)
    )
  )
  (return true)
)

(fn-do _ put-fields Bool
  (param types Types)
  (param fields (of RowRange TypeId))
  (param field-names (of RowRange Atom))
  (param words (list U32))
  (param names (list Atom))
  (+= words (. fields count))
  (for (in offset (..< 0 (. fields count)))
    (call put-name (call (. types child-name) field-names offset) words names)
    (if (not (call put-type types (call (. types child-type) fields offset) words names))
      (return false)
    )
  )
  (return true)
)

(fn-do _ put-name _
  (param name Atom)
  (param words (list U32))
  (param names (list Atom))
  (+= words (as (. names length) U32))
  (+= names name)
)

(type _ PortableReader
  ; Interns the types a portable instance writes out, in the order they are written.
  (blank)
  (prop _ types Types)
  (prop _ words (list U32))
  (prop _ names (list Atom))
  (prop _ position Size (= 0))
  (fn-do + This _
    (param types Types)
    (param words (list U32))
    (param names (list Atom))
  )
  (fn-do + next U32
    (let word ([] words position))
    (+= position 1)
    (return word)
  )
  (fn-do + name Atom
    (return ([] names (call next)))
  )
  (fn-do + type TypeId
    (let stack (. types scratch types))
    (let tag (call next))
    (if (== tag portable-none)
      (return no-type)
    )
    (if (== tag portable-invalid)
      (return invalid-type)
    )
    (if (== tag portable-class)
      (let module (call next))
      (let decl (call next))
      (let mark (. stack mark))
      (call push-range)
      (let errors-mark (. stack mark))
      (call push-range)
      (return (call (. types intern-raising-class) module decl mark errors-mark))
    )
    (if (== tag portable-variable)
      (let module (call next))
      (let decl (call next))
      (let index (call next))
      (return (call (. types intern-variable) module decl index (call name)))
    )
    (if (== tag portable-inference)
      (let scope (call next))
      (return (call (. types intern-inference) scope (call next)))
    )
    (if (or (== tag portable-tuple) (== tag portable-struct))
      (let mark (. stack mark))
      (let names-mark (. types scratch names mark))
      (call push-fields)
      (return
        (match tag
          (case= portable-tuple
            (call (. types intern-tuple) mark names-mark)
          )
          (default
            (call (. types intern-struct) mark names-mark)
          )
        )
      )
    )
    (if (== tag portable-union)
      (let mark (. stack mark))
      (call push-range)
      (return (call (. types intern-union) mark))
    )
    (if (== tag portable-named-union)
      (let owner (call name))
      (let made-in (call next))
      (let made-at (call next))
      (let mark (. stack mark))
      (let names-mark (. types scratch names mark))
      (call push-fields)
      (return (call (. types intern-named-union) owner mark names-mark made-in made-at))
    )
    (if (== tag portable-function)
      (let is-c (!= (call next) 0))
      (let returns (call type))
      (let mark (. stack mark))
      (call push-range)
      (let errors-mark (. stack mark))
      (call push-range)
      (return (call (. types intern-function) returns is-c mark errors-mark))
    )
    (if (== tag portable-result)
      (let value (call type))
      (let mark (. stack mark))
      (call push-range)
      (return (call (. types intern-ordered-result) value mark))
    )
    (if (== tag portable-associated)
      (let module (call next))
      (let decl (call next))
      (let owner (call type))
      (let named (call name))
      (let mark (. stack mark))
      (call push-range)
      (return (call (. types intern-associated) owner (call DeclRef module decl) named mark))
    )
    (throw (call Panic (str "A portable type has no kind " tag)) (if (!= tag portable-binding)))
    (blank)
    (let form (as (call next) BindingForm))
    (let scope (call next))
    (let module (call next))
    (let decl (call next))
    (let object (call type))
    (let param-count (call next))
    (let mark (. stack mark))
    (call push-range)
    (return (call (. types intern-binding) form scope module decl object param-count mark))
  )
  (fn-do _ push-range _
    (let count (call next))
    (for (in _ (..< 0 count))
      (let child (call type))
      (call (. types scratch types push) child)
    )
  )
  (fn-do _ push-fields _
    (let count (call next))
    (for (in _ (..< 0 count))
      (let named (call name))
      (let child (call type))
      (call (. types scratch names push) named)
      (call (. types scratch types push) child)
    )
  )
)
