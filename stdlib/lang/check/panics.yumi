────────────────────
+ This
    - types Types
    - program Program
    - instances Instances
    - facts Facts

.. key-scratch = Array'U32(arena, 4)

────────────────────
+ do release

keys.release()

────────────────────
+ do absorb
    - peer Panics
    - ids PeerIds

` Takes in what another type pass over the program noted of the instances this pass takes from
` it (`PeerIds.owns`), and which properties it found tracked.
. properties [PropertyId]
for index in 0 .. < peer.tracked.length
    key-scratch[0] = peer.keys.key-word(index, 0)
    key-scratch[1] = peer.keys.key-word(index, 1)
    key-scratch[2] = peer.keys.key-word(index, 2)
    . id = keys.store(key-scratch.data, 3)
    if keys.last-inserted
        tracked += false
    if peer.tracked[index]
        tracked[id] = true
    properties += id
for position in 0 .. < peer.write-instances.length
    if ids.owns(peer.write-instances[position])
        write-instances += ids.instance(peer.write-instances[position])
        write-properties += properties[peer.write-properties[position]]
for position in 0 .. < peer.untracked-instances.length
    if ids.owns(peer.untracked-instances[position])
        untracked-instances += ids.instance(peer.untracked-instances[position])
        untracked-sites += peer.untracked-sites[position]
        untracked-properties += properties[peer.untracked-properties[position]]
        untracked-relied += peer.untracked-relied[position]
for position in 0 .. < peer.forced-instances.length
    if ids.owns(peer.forced-instances[position])
        forced-instances += ids.instance(peer.forced-instances[position])
        forced-sites += peer.forced-sites[position]
        forced-operands += peer.forced-operands[position]
        forced-declared += ids.type(peer.forced-declared[position])
        forced-properties += properties[peer.forced-properties[position]]
for position in 0 .. < peer.lazy-readers.length
    if ids.owns(peer.lazy-readers[position])
        lazy-readers += ids.instance(peer.lazy-readers[position])
        lazy-units += ids.instance(peer.lazy-units[position])
for position in 0 .. < peer.outlined-instances.length
    if ids.owns(peer.outlined-instances[position])
        outlined-instances += ids.instance(peer.outlined-instances[position])
        outlined-actions += peer.outlined-actions[position]
        outlined-bodies += peer.outlined-bodies[position]
?! Panic("Typing in parallel cannot take in what a type pass settled of panics after typing")
    if peer.unit-calls.length != 0 || peer.init-gathered.length != 0

────────────────────
+ do retire
    - retired [Bool]

. writes [InstanceId]
. written [PropertyId]
for position in 0 .. < write-instances.length
    if !held-by(retired, write-instances[position])
        writes += write-instances[position]
        written += write-properties[position]
write-instances = writes
write-properties = written
. untracked [InstanceId]
. sites [SyntaxId]
. properties [PropertyId]
. relied [Bool]
for position in 0 .. < untracked-instances.length
    if !held-by(retired, untracked-instances[position])
        untracked += untracked-instances[position]
        sites += untracked-sites[position]
        properties += untracked-properties[position]
        relied += untracked-relied[position]
untracked-instances = untracked
untracked-sites = sites
untracked-properties = properties
untracked-relied = relied
. forced [InstanceId]
. forced-at [SyntaxId]
. operands [SyntaxId]
. declared [TypeId]
. forcing [PropertyId]
for position in 0 .. < forced-instances.length
    if !held-by(retired, forced-instances[position])
        forced += forced-instances[position]
        forced-at += forced-sites[position]
        operands += forced-operands[position]
        declared += forced-declared[position]
        forcing += forced-properties[position]
forced-instances = forced
forced-sites = forced-at
forced-operands = operands
forced-declared = declared
forced-properties = forcing
. readers [InstanceId]
. units [InstanceId]
for position in 0 .. < lazy-readers.length
    if !held-by(retired, lazy-readers[position])
        readers += lazy-readers[position]
        units += lazy-units[position]
lazy-readers = readers
lazy-units = units
. outlined [InstanceId]
. actions [SyntaxId]
. bodies [SyntaxId]
for position in 0 .. < outlined-instances.length
    if !held-by(retired, outlined-instances[position])
        outlined += outlined-instances[position]
        actions += outlined-actions[position]
        bodies += outlined-bodies[position]
outlined-instances = outlined
outlined-actions = actions
outlined-bodies = bodies
. generators [InstanceId]
for generator in cleared-generators
    if !held-by(retired, generator)
        generators += generator
cleared-generators = generators
unit-calls.clear()
unit-owners.clear()

────────────────────
_ held-by Bool
    - retired [Bool]
    - instance InstanceId

(instance as Size) < retired.length && retired[instance]

────────────────────
+ do property-of PropertyId?
    - receiver TypeId
    - name Atom

if receiver == no-type || receiver == invalid-type
    = null
. found = types.property-named(receiver, name)
if !found
    = null
. ref = class-ref(types, types.properties[found].owner)
= property-id(ref.module, ref.decl, name)

────────────────────
+ do property-id PropertyId
    - module ModuleId
    - decl DeclId
    - name Atom

key-scratch[0] = module
key-scratch[1] = decl
key-scratch[2] = program.atom-key(name) as U32
. id = keys.store(key-scratch.data, 3)
if keys.last-inserted
    tracked += false
= id

────────────────────
+ do track
    - property PropertyId

tracked[property] = true

────────────────────
+ do tracked-keys [U32]

. found [U32]
for index in 0 .. < tracked.length
    if tracked[index]
        found += keys.key-word(index, 0)
        found += keys.key-word(index, 1)
        found += keys.key-word(index, 2)
= found

────────────────────
+ do seed
    - seeded [U32]

for start in 0 .. < seeded.length / 3
    key-scratch[0] = seeded[start * 3]
    key-scratch[1] = seeded[start * 3 + 1]
    key-scratch[2] = seeded[start * 3 + 2]
    . id = keys.store(key-scratch.data, 3)
    if keys.last-inserted
        tracked += false
    tracked[id] = true

────────────────────
+ do note-write
    - instance InstanceId
    - property PropertyId

write-instances += instance
write-properties += property

────────────────────
+ is-tracked-property Bool
    - property PropertyId

` Whether a read typed so far tracks a property.
tracked[property]

────────────────────
+ do assume-untracked U32
    - instance InstanceId
    - site SyntaxId
    - property PropertyId

` A store to a property that no read typed so far tracks was typed as one that runs nothing,
` which leaves what is known of other properties. A read typed later may track it, and the
` store then runs the actions that read it (`typed-late`). Answers the store's place, which
` `rely-on-store` names.
untracked-instances += instance
untracked-sites += site
untracked-properties += property
untracked-relied += false
= (untracked-sites.length - 1) as U32

────────────────────
+ do rely-on-store
    - index U32

` Something typed after a store that runs nothing read what the flow knew of a property
` before it, which the store ends where it runs actions.
untracked-relied[index] = true

────────────────────
+ do note-forced
    - index U32
    - site SyntaxId
    - operand SyntaxId
    - declared TypeId

forced-instances += untracked-instances[index]
forced-sites += site
forced-operands += operand
forced-declared += declared
forced-properties += untracked-properties[index]

────────────────────
+ do typed-late Bool

` Whether a store typed as one that runs nothing has a property some read tracks once the
` program is typed, where what was typed after it read what the flow knew of a property
` (`rely-on-store`): the store ends what is known of every property, so the pass starts over
` knowing which properties are tracked (`seed`).
for position in 0 .. < untracked-sites.length
    if tracked[untracked-properties[position]] && untracked-relied[position]
        = true
= false

────────────────────
+ do retest-forces

` Tests again each force after a store typed as one that runs nothing of a property some read
` tracks once the program is typed, where the flow knew the property forced to hold a value:
` the store ends what was known of it, so it is read as declared (`note-forced`).
for position in 0 .. < forced-sites.length
    if tracked[forced-properties[position]]
        . instance = forced-instances[position]
        . declared = forced-declared[position]
        facts.replace-node-type(instance, forced-operands[position], declared)
        . force = facts.first-force(instance, forced-sites[position])
        while force != no-fact
            facts.forces[force].operand = declared
            facts.forces[force].is-narrowed = false
            force = facts.forces[force].next
        instances.mark-may-panic(instance)

────────────────────
+ do note-outlined
    - instance InstanceId
    - action SyntaxId
    - body SyntaxId

` Notes an action of a grammar that the reference runs in a function of its own, which
` a panic in it would show.
outlined-instances += instance
outlined-actions += action
outlined-bodies += body

────────────────────
+ do note-lazy-read
    - instance InstanceId
    - unit InstanceId

` Notes that an instance reads a lazy property whose value `unit` types: the read evaluates
` the value when the object has none yet, so the reader may panic where the value does.
lazy-readers += instance
lazy-units += unit

────────────────────
+ do note-inlined
    - instance InstanceId
    - unit InstanceId

` Notes that an instance runs in its own frame the code an instance of its own types, as an
` element or a constructor runs a style rule it applies: it may panic where that code does.
lazy-readers += instance
lazy-units += unit

────────────────────
+ do gather-unit-calls

` Lists the calls the values of properties make, each with the instance that typed it, while
` the facts still say which that is: they are moved to their module's main afterwards.
. position = 0u32
for fact in facts.calls
    if instances.rows[fact.instance].initializer != 0
        unit-calls += position
        unit-owners += fact.instance
    position += 1

────────────────────
+ do propagate

` Settles which instances may panic. A write to a tracked property and the construction of a tracked
` object mark their instance. A call marks its caller when it can raise by itself, or when its
` callee is marked: each such call is listed under its callee once, and a mark passes to the callers
` listed under it, so the work is one visit of each call however deep the calls go. A call in a
` module's initializers marks nothing of its main, nor does the body of a task where the task is
` spawned, and a generator is never marked by what it calls. The value of a property is marked by
` the calls it makes, those its conversions make among them, and a mark on it passes to the
` instances that read the property lazily. The value of a case of an enum is marked too by the calls
` its module's main recorded where main typed the value first, which the module's statics run. An
` instance the reference takes for one that raises nothing is marked as one no call checks. A
` generator typing marked loses its mark once it has passed it on, and gets it back when the
` instances are settled again after an edit typed in place (`retype-edit`), which starts from what
` typing marked.
for generator in cleared-generators
    instances.mark-may-panic(generator)
cleared-generators.clear()
. position = 0
for property in write-properties
    if tracked[property] && !is-generated-instance(write-instances[position])
        instances.mark-may-panic(write-instances[position])
    position += 1
. index = 0u32
for row in instances.rows
    if constructs-tracked(row)
        instances.mark-may-panic(index)
    if is-known-panic-free(row.module, row.decl)
        instances.mark-quiet(index)
    index += 1
init-gathered = Bool[program.modules.length]
init-first = U32[program.modules.length]
init-count = U32[program.modules.length]
. heads = U32[instances.rows.length]
. links = U32[facts.calls.length]
. callers = U32[facts.calls.length]
. owned = Bool[facts.calls.length]
. owned-calls [U32]
. owners [InstanceId]
position = 0
for listed in unit-calls
    owned[listed] = true
    owned-calls += listed
    owners += unit-owners[position]
    position += 1
. mains = main-instances()
index = 0
for row in instances.rows
    . main = mains[row.module]
    if row.initializer != 0 && main != no-instance
        do match? program.modules[row.module].decls[row.initializer]
            | .decl-case(case)
                . tree = program.modules[row.module].tree
                for node in tree.subtree-start(case.syntax) .. case.syntax
                    . fact = facts.first-call(main, node)
                    while fact != no-fact
                        if !owned[fact]
                            owned[fact] = true
                            owned-calls += fact
                            owners += index
                        fact = facts.calls[fact].next
    index += 1
position = 0
for fact in facts.calls
    . listed = position
    position += 1
    callers[listed] = fact.instance
    . caller = instances.rows[fact.instance]
    if caller.is-generator || owned[listed] || is-init-fact(caller, fact.syntax)
        continue
    if follows-callee(fact)
        links[listed] = heads[fact.callee]
        heads[fact.callee] = (listed + 1) as U32
    else if !caller.may-panic && panic-capable-call(fact)
        instances.mark-may-panic(fact.instance)
position = 0
for listed in owned-calls
    . unit = owners[position]
    position += 1
    . fact = facts.calls[listed]
    callers[listed] = unit
    if follows-callee(fact)
        links[listed] = heads[fact.callee]
        heads[fact.callee] = listed + 1
    else if panic-capable-call(fact)
        instances.mark-may-panic(unit)
. reader-heads = U32[instances.rows.length]
. reader-links = U32[lazy-readers.length]
position = 0
for unit in lazy-units
    reader-links[position] = reader-heads[unit]
    reader-heads[unit] = (position + 1) as U32
    position += 1
. pending [InstanceId]
index = 0
for row in instances.rows
    if row.may-panic
        pending += index
    index += 1
. next = 0
while next < pending.length
    . marked = pending[next]
    . link = heads[marked]
    next += 1
    while link != 0
        . caller = callers[link - 1]
        if !instances.rows[caller].may-panic
            instances.mark-may-panic(caller)
            pending += caller
        link = links[link - 1]
    . reader = reader-heads[marked]
    while reader != 0
        . reads = lazy-readers[reader - 1]
        if !instances.rows[reads].may-panic && !instances.rows[reads].is-generator
            instances.mark-may-panic(reads)
            pending += reads
        reader = reader-links[reader - 1]
. cleared = 0u32
for row in instances.rows
    if row.is-generator && row.may-panic
        instances.clear-may-panic(cleared)
        cleared-generators += cleared
    cleared += 1
settle-outlined()

────────────────────
_ do main-instances [InstanceId]

` The main of each module, or none where no instance types it.
. mains [InstanceId]
for _ in 0 .. < program.modules.length
    mains += no-instance
. index = 0u32
for row in instances.rows
    if row.initializer == 0 && row.decl == program.modules[row.module].main-decl
        mains[row.module] = index
    index += 1
= mains

────────────────────
_ do settle-outlined

` Plans each action noted as run in a function of its own where a call in it may panic, once
` which instances may panic is settled.
if outlined-actions.length == 0
    =
. heads [U32]
for _ in 0 .. < instances.rows.length
    heads += U32.max
. links [U32]
for position in 0 .. < outlined-actions.length
    links += heads[outlined-instances[position]]
    heads[outlined-instances[position]] = position as U32
for fact in facts.calls
    . position = heads[fact.instance]
    while position != U32.max
        . body = outlined-bodies[position]
        . tree = program.modules[instances.rows[fact.instance].module].tree
        if in-body && panic-capable-call(fact)
            facts.set-plan(fact.instance, outlined-actions[position], .plan-outlined-panic)
        .. in-body = fact.syntax >= tree.subtree-start(body) && fact.syntax <= body
        position = links[position]

────────────────────
_ do constructs-tracked Bool
    - row Instance

` Whether an instance is a constructor of a class with a property some read tracks, whose
` stores run the actions that read it.
. kind = DeclKind.function-decl
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        kind = fn.kind
if kind != .constructor-decl && kind != .default-constructor-decl
    = false
if row.self-type == no-type || row.self-type == invalid-type
    = false
for property in types.properties-of(row.self-type)
    . ref = class-ref(types, types.tracked-root(property.owner, property.name))
    if is-tracked(ref.module, ref.decl, property.name)
        = true
= false

────────────────────
_ do is-tracked Bool
    - module ModuleId
    - decl DeclId
    - name Atom

key-scratch[0] = module
key-scratch[1] = decl
key-scratch[2] = program.atom-key(name) as U32
. found = keys.find(key-scratch.data, 3)
= if found then tracked[found] else false

────────────────────
_ follows-callee Bool
    - fact CallFact

` Whether a call can raise exactly when its callee is one that may: every case of
` `panic-capable-call` that does not answer before it reads the callee's mark, and whose
` answer after it is no.
|? fact.callee == no-instance || spawns-task(fact.form)
    false
|? program.modules[callee.module].name.ends-with(".h")
    false
|? is-known-panic-free(callee.module, callee.decl) || is-table-intrinsic(callee.module, callee.decl)
    false
|? callee.self-type == no-type || callee.self-type == invalid-type
    true
??
    types.intrinsic-of(callee.self-type) != .interface

.. callee = instances.rows[fact.callee]

────────────────────
+ do panic-capable-call Bool
    - fact CallFact

` Whether a call may raise a panic. A C function that suspends the task may: the task is checked
` for being terminated after it, which raises the termination panic, and the callers of the
` function that calls it must take it. One that leaves a termination to its caller does not
` (`leaves-termination`).
if fact.form == .call-closure && fact.callee == no-instance
    = true
if fact.callee == no-instance || spawns-task(fact.form)
    = false
. callee = instances.rows[fact.callee]
if program.modules[callee.module].name.ends-with(".h")
    . name = c-function-name(callee.module, callee.decl)
    if is-elided-c-function(callee.module, callee.decl) || leaves-termination(name)
        = false
    = suspends-task(name) || !is-leaf-function(callee.module, callee.decl)
if is-known-panic-free(callee.module, callee.decl)
    = false
if is-table-intrinsic(callee.module, callee.decl)
    = true
if callee.may-panic
    = true
if callee.self-type == no-type || callee.self-type == invalid-type
    = false
= types.intrinsic-of(callee.self-type) == .interface

────────────────────
_ do is-init-fact Bool
    - caller Instance
    - syntax SyntaxId

. owner-module = program.modules[caller.module]
if caller.decl != owner-module.main-decl
    = false
if !init-gathered[caller.module]
    gather-init-ranges(caller.module)
. first = init-first[caller.module]
. low = first
. high = first + init-count[caller.module]
while low < high
    . middle = low + (high - low) / 2
    if init-starts[middle] <= syntax
        low = middle + 1
    else
        high = middle
= low > first && syntax <= init-ends[low - 1]

────────────────────
_ do gather-init-ranges
    - module ModuleId

` The ranges of a module's initializers, which do not meet, in the order of their nodes: a
` node is looked for among them by halving.
. owner-module = program.modules[module]
. tree = owner-module.tree
. first = init-starts.length as U32
. keys [U64]
for decl in owner-module.decls
    . last SyntaxId = 0
    do match? decl
        | .decl-class(class-row)
            last = class-row.syntax
        | .decl-property(property)
            if property.owner == 0
                last = property.value
    if last != 0
        . start U64 = tree.subtree-start(last)
        keys += (start /lshift/ 32) /or/ last
. sorted = sort(keys)
for key in sorted
    init-starts += (key /rshift/ 32) as SyntaxId
    init-ends += (key /and/ 0xffffffff) as SyntaxId
init-gathered[module] = true
init-first[module] = first
init-count[module] = (init-starts.length as U32) - first

────────────────────
_ is-generated-instance Bool
    - instance InstanceId

match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        fn.is-generated
    ??
        false

.. row = instances.rows[instance]

────────────────────
+ do c-function-name String
    - module ModuleId
    - decl DeclId

. name = ""
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.name
            . atom = fn.name
            name = atom.text
= name

────────────────────
_ do is-elided-c-function Bool
    - module ModuleId
    - decl DeclId

do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.name
            = fn.name == types.bench-collect-atom!
= false

────────────────────
+ do is-leaf-function Bool
    - module ModuleId
    - decl DeclId

. mask = 0u32
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        mask = fn.effects
. leaf U32 = CompilationEffect.gc-leaf
= (mask /and/ leaf) != 0

────────────────────
+ do is-table-intrinsic Bool
    - module ModuleId
    - decl DeclId

if module != types.table-module
    = false
. owner-module = program.modules[module]
. name = ""
do match? owner-module.decls[decl]
    | .decl-function(fn)
        if fn.kind == .table-arena-constructor-decl || fn.kind == .table-capacity-constructor-decl
            = true
        if fn.kind == .index-span-range-constructor-decl
            = true
        if fn.name
            . atom = fn.name
            name = atom.text
= name == "[]" || name == "[]=" || name == "append"

────────────────────
_ do is-known-panic-free Bool
    - module ModuleId
    - decl DeclId

. name = ""
. owner DeclId = 0
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.name
            . atom = fn.name
            name = atom.text
        owner = fn.owner
if owner == 0
    = false
if types.array-decl.refers-to(module, owner)
    = name == "slice-string"
if types.token-stream-decl.refers-to(module, owner)
    . reads = name == "read" || name == "has-more" || name == "location"
    = reads || name == "error-location" || name == "get-match-location"
if types.readable-decl.refers-to(module, owner)
    = name == "<-read"
= false
