(import ./checker.calls)
(import ./checker.live-actions)
(import ./checker.loops)
(import ./checker.match-arms)
(import ./checker.streams)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ Comprehensions (facet-of Checker)
  (sees CallTyping)
  (sees LiveActions)
  (sees Loops)
  (sees MatchArms)
  (sees Streams)
  (fn-do + infer-comprehension TypeId
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    (param next SyntaxId)
    ; A comprehension is a call of its generated closure with the container as the one argument, so
    ; a range literal is constructed; the closure instance is keyed like a lambda's, at the
    ; comprehension, and yields the body. One whose header is a grammar reads a container no
    ; iterator is found for through its stream all the same, and one no stream is made of is an
    ; error at the pattern. One on a stream, `<* x on s`, subscribes where it is written: see
    ; `infer-broadcaster`.
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (and (. row is-subscriber) (call (. tree is-grammar) (. row pattern)))
          (call report-pattern-on (. row pattern))
          (return invalid-type)
        )
        (if (and (. row is-subscriber) (== next 0))
          (return (call infer-broadcaster id loop (. row container) (. row clause) body))
        )
        (if (or (. row is-subscriber) (!= next 0))
          (call decline id)
          (return invalid-type)
        )
        (let container (call loop-container (. row container) false (call stated-item (. row pattern))))
        (if (== (. container type) invalid-type)
          (return invalid-type)
        )
        (if (and (call (. tree is-grammar) (. row pattern)) (not (call iterates (. container type))) no-item)
          (call (. frame diagnose) (. row pattern) .stated (call (. program store-atom) "Can't convert to iterable"))
          (return invalid-type)
        )
        (lazy no-item (== (call natural-item (. container type)) no-type))
        (let mark (. facts diagnostics length))
        (let callee (call demand-comprehension id (. container type)))
        (if (== callee no-instance)
          (call decline id)
          (return invalid-type)
        )
        (return (call generated-call id callee mark))
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ demand-comprehension InstanceId
    (param id SyntaxId)
    (param container TypeId)
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (return no-instance)
    )
    (return (call demand-nested decl container))
  )
  (fn-do + expect-feeds _
    (param expr SyntaxId)
    (param target TypeId)
    ; A feed list written where a list of a known item type is wanted casts each plain feed to that
    ; type.
    (if (or (== target no-type) (== target invalid-type))
      (return)
    )
    (let wanted (call (. types optional-inner) target))
    (let feeds (call (. tree written-feeds) expr))
    (if (== feeds 0)
      (return)
    )
    (match? ([] (. types rows) wanted)
      (case (call .type-class row)
        (let listed (and (== (. row module) (. types list-decl module)) (== (. row decl) (. types list-decl decl))))
        (if (and listed (!= (. row args count) 0))
          (let item (call (. types child-type) (. row args) 0))
          (return-if (if (call (. types is-generic) item)))
          (blank)
          (+= feed-lists feeds)
          (+= feed-items item)
          (+= feed-builds (and (!= (call nested-decl-of feeds) 0) (== (call list-of item) wanted)))
        )
      )
    )
  )
  (fn-do _ feed-item TypeId
    (param feeds SyntaxId)
    (for (in position (..< 0 (. feed-lists length)))
      (if (== ([] feed-lists position) feeds)
        (return ([] feed-items position))
      )
    )
    (return no-type)
  )
  (fn-do _ builds-feeds Bool
    (param feeds SyntaxId)
    (for (in position (..< 0 (. feed-lists length)))
      (if (== ([] feed-lists position) feeds)
        (return ([] feed-builds position))
      )
    )
    (return false)
  )
  (fn-do + infer-listed-feeds TypeId
    (param id SyntaxId)
    (param callable SyntaxId)
    (param feeds SyntaxId)
    (param want Want (= (call Want)))
    (call (. types clear-fault))
    (let listed (call (. types evaluate-type) module tree callable (. frame env)))
    (if (or (== listed invalid-type) (not (call same-decl (call class-ref types listed) (. types list-decl))))
      (call decline id)
      (return invalid-type)
    )
    (let open (. ([] (. types completions) listed) has-variables))
    (let wanted (if-expr open no-type (call first-arg listed)))
    (if (and (not open) (!= (call list-of wanted) listed))
      (call decline id)
      (return invalid-type)
    )
    (call (. instances mark-may-panic) instance)
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let sites (list SyntaxId))
    (let valid true)
    (let feed feeds)
    (while (!= feed 0)
      (let next 0u32)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (let given (call listed-item feed (. row item) (. row is-spread) (. row is-optional) wanted))
          (= valid (and valid (!= given invalid-type)))
          (call (. scratch types push) given)
          (call (. scratch syntax push) (if-expr (or (. row is-spread) (. row is-optional)) feed (. row item)))
          (+= sites feed)
          (= next (. row next))
        )
      )
      (= feed next)
    )
    (let item wanted)
    (let given types-start)
    (if (and valid (== item no-type))
      (let peer (call literal-peer types-start syntax-start (. sites length)))
      (= given (. scratch types mark))
      (for (in offset (..< 0 (. sites length)))
        (let adapted
          (call (. conversions adapted-literal)
            (block
              (arg ([] (. scratch syntax) (+ syntax-start offset)))
              (arg ([] (. scratch types) (+ types-start offset)))
              (arg peer)
            )
          )
        )
        (call (. scratch types push) adapted)
      )
      (= item (call (. relations join) given))
      (let expected (call expected-item want))
      (if (and (!= expected no-type) (call items-fit given (as (. sites length) Int) expected))
        (= item expected)
      )
      (if (== item invalid-type)
        (call (. frame diagnose) id .stated (call (. program store-atom) "Incompatible types in list"))
        (= valid false)
      )
    )
    (if valid
      (for (in offset (..< 0 (. sites length)))
        (let site ([] sites offset))
        (let written ([] (. scratch syntax) (+ syntax-start offset)))
        (let element ([] (. scratch types) (+ given offset)))
        (if (and (!= element item) (!= written site) (!= (call (. tree symbol-of) written) null))
          (= element (call infer-with-expected written item))
        )
        (if (!= element item)
          (call (. conversions convert) site written element item .reason-element)
        )
      )
    )
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (return-if invalid-type (if (not valid)))
    (blank)
    (let list (call list-of item))
    (call (. calls note-list) id list)
    (call (. calls note-append) id list item .call-list-append)
    (call (. facts set-plan) instance id .plan-built-feeds)
    (return list)
  )
  (fn-do _ listed-item TypeId
    (param feed SyntaxId)
    (param item SyntaxId)
    (param multi Bool)
    (param optional Bool)
    (param wanted TypeId)
    (call (. facts set-feed-site) instance feed feed false)
    (return-if (call listed-spread feed (call spread-container item wanted)) (if (and multi (not optional))))
    (blank)
    (let plain (and (not multi) (not optional)))
    (let value (if-expr (and plain (!= wanted no-type)) (call infer-with-expected item wanted) (call infer item)))
    (return-if invalid-type (if (== value invalid-type)))
    (blank)
    (if plain
      (return-if (call (. conversions convert) feed item value wanted .reason-explicit) (if (!= wanted no-type)))
      (return value)
    )
    (let inner (call (. types optional-inner) value))
    (return-if inner (if (not multi)))
    (return (call listed-spread feed (call LoopContainer inner no-type)))
  )
  (fn-do _ listed-spread TypeId
    (param feed SyntaxId)
    (param container LoopContainer)
    (return-if invalid-type (if (== (. container type) invalid-type)))
    (blank)
    (if (!= (. container item) no-type)
      (call plan-range-at feed (. container item))
      (return (. container item))
    )
    (let mark (. facts calls length))
    (let iterated (call iteration-container (. container type) feed))
    (let yielded (call loop-item-type iterated feed))
    (return-if invalid-type (if (== yielded invalid-type)))
    (blank)
    (call plan-iteration-at feed feed iterated yielded true)
    (call (. facts set-protocol-start) instance feed feed mark)
    (return yielded)
  )
  (fn-do + infer-feeds TypeId
    (param id SyntaxId)
    (param consumer SyntaxId)
    ; A feed list is a call of its generated closure, whose type is recorded at the first feed,
    ; yielding every item. The first feed's location is shifted one line where the closure is
    ; declared, so the facts of that feed's own yield land on the next feed or on the pipeline
    ; consuming the list, as `feed-site` places them.
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (call decline id)
      (return invalid-type)
    )
    (call (. facts set-node-type) instance id (call intern-nested decl))
    (let callee (call demand-nested decl no-type))
    (let produced (call (. calls generator-call) id callee))
    (let site (call (. tree feed-site) id consumer))
    (if (!= site id)
      (call (. facts set-node-type) instance site produced)
    )
    (return produced)
  )
  (fn-do + check-feeds _
    (param id SyntaxId)
    ; The closure's body: a feed yields its item, an optional feed only a present item, and a spread
    ; every item of its iterable. The first feed's own facts sit where its location is shifted to,
    ; the consumer being the closure's enclosing frame's pipeline when the list feeds one.
    (let feed id)
    (let site (call (. tree feed-site) id (call (. tree consumer-of) id)))
    (let wanted (if-expr outer (call (. outer feed-item) id) no-type))
    (= building-list (and outer (call (. outer builds-feeds) id)))
    (= built-item wanted)
    (let plain (list Bool))
    (= orders-yields true)
    (while (!= feed 0)
      (let next 0u32)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (call (. facts set-feed-site) instance feed site false)
          (let noted (. ordered-yields length))
          (call check-feed
            (block
              (arg feed)
              (arg site)
              (arg (. row item))
              (arg (. row is-spread))
              (arg (. row is-optional))
              (arg wanted)
              (arg (== feed id))
            )
          )
          (if (!= (. ordered-yields length) noted)
            (+= plain (and (not (. row is-spread)) (not (. row is-optional))))
          )
          (= next (. row next))
        )
      )
      (= feed next)
      (= site feed)
    )
    (= orders-yields false)
    (call fold-feed-yields plain)
  )
  (fn-do _ fold-feed-yields _
    (param plain (list Bool))
    (for (in position (..< 0 (. plain length)))
      (if ([] plain position)
        (call fold-yield
          (block
            (arg ([] ordered-yields position))
            (arg ([] ordered-sites position))
            (arg true)
            (arg ([] ordered-literals position))
          )
        )
      )
    )
    (for (in offset (..< 0 (. plain length)))
      (let position (- (. plain length) 1 offset))
      (if (not ([] plain position))
        (call fold-yield
          (block
            (arg ([] ordered-yields position))
            (arg ([] ordered-sites position))
            (arg true)
            (arg ([] ordered-literals position))
          )
        )
      )
    )
    (call (. ordered-yields clear))
    (call (. ordered-sites clear))
    (call (. ordered-literals clear))
  )
  (fn-do + feeds-consumer SyntaxId
    ; The pipeline that consumes the feed list this body is, where its first feed's facts sit,
    ; or nothing for any other body.
    (if (not outer)
      (return 0)
    )
    (match? ([] (. tree nodes) (. frame declaration syntax))
      (case .node-feed-expression
        (return (call (. tree consumer-of) (. frame declaration syntax)))
      )
    )
    (return 0)
  )
  (fn-do _ check-feed _
    (param feed SyntaxId)
    (param site SyntaxId)
    (param item SyntaxId)
    (param is-spread Bool)
    (param is-optional Bool)
    (param wanted TypeId)
    (param is-first Bool)
    ; What a feed yields is kept with where its yield is placed, to be converted to the type of the
    ; list's items once that is known. A range of integers written with no suffix that a spread
    ; yields is of the type of the items wanted.
    (if (and is-spread (not is-optional))
      (call check-spread
        (block
          (arg feed)
          (arg site)
          (arg (call spread-container item wanted))
          (arg is-first)
          (arg (call written-literal item))
        )
      )
      (return)
    )
    (let value (call infer item))
    (if (== value invalid-type)
      (call note-yield value)
      (return)
    )
    (if (and (!= wanted no-type) (not is-spread) (not is-optional))
      (= value (call (. conversions convert) item item value wanted .reason-explicit))
    )
    (if (and is-optional (call (. types is-optional) value))
      (= value (call (. types optional-inner) value))
    )
    (if (not is-spread)
      (call note-yield value site false (if-expr is-optional 0 (call written-literal item)))
      (return)
    )
    (call check-spread feed site (call LoopContainer value no-type) is-first)
  )
  (fn-do _ spread-container LoopContainer
    (param item SyntaxId)
    (param wanted TypeId)
    (match? ([] (. tree nodes) item)
      (case .node-list-syntax
        (if (!= wanted no-type)
          (let listed (call infer item))
          (if (== listed invalid-type)
            (return (call LoopContainer invalid-type no-type))
          )
          (let mark (. scratch types mark))
          (call (. scratch types push) wanted)
          (let target (call (. types class-named-with-args) module (!! (. types list-atom)) mark))
          (return
            (call LoopContainer
              (block
                (arg (call (. conversions convert) item item listed target .reason-explicit))
                (arg no-type)
              )
            )
          )
        )
      )
    )
    (return (call loop-container item true wanted))
  )
  (fn-do _ check-spread _
    (param feed SyntaxId)
    (param site SyntaxId)
    (param container LoopContainer)
    (param is-first Bool)
    (param literal SyntaxId (= 0))
    ; A spread yields every item of its iterable through the loop it is lowered to, an integer range
    ; literal counting without a range, any other container through its iteration protocol with the
    ; yielded item converted to the generator's optional. The loop is planned at the feed, which has
    ; the slots of a loop, and polls, and the loop of the first feed of a list is located on the
    ; line under it, where that feed is shifted.
    (if (== (. container type) invalid-type)
      (call note-yield invalid-type)
      (return)
    )
    (if (!= (. container item) no-type)
      (call note-yield (. container item) site true literal)
      (call plan-range-at feed (. container item))
      (return)
    )
    (let mark (. facts calls length))
    (let iterated (call iteration-container (. container type) site))
    (let yielded (call loop-item-type iterated site))
    (call note-yield yielded site true)
    (if (== yielded invalid-type)
      (return)
    )
    (call plan-iteration-at feed site iterated yielded true)
    (call (. facts set-feed-site) instance feed site is-first)
    (call (. facts set-protocol-start) instance feed site mark)
    (let wrapped (call (. types optional-of) yielded))
    (if (!= wrapped yielded)
      (call (. conversions convert) site 0 yielded wrapped .reason-join)
    )
  )
  (fn-do + infer-pipeline TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A pipeline passes its left value on: a forward pipe as the last argument of the call on the
    ; right, and a map or filter to the stream function of that name with the right operand's
    ; closure over `each`. One written as a statement that no statement before it joins has no
    ; shape.
    (if (== left 0)
      (call decline id)
      (return invalid-type)
    )
    (if (== op .pipe-write-each-op)
      (return (call infer-write-each id left right))
    )
    (if (== op .grammar-pipe-op)
      (return (call infer-pattern-pipe id left right))
    )
    (let listing (call (. tree listed-feeds) id))
    (return-if (call infer-listed-feeds id right listing) (if (!= listing 0)))
    (blank)
    (let source (call infer-pipeline-source left id))
    (if (== source invalid-type)
      (return invalid-type)
    )
    (let site (call (. tree source-site) left id))
    (let with-atom (call (. program store-atom) "with"))
    (match op
      (case= .pipe-forward-op
        (let result (call infer-pipe-forward id source site right))
        (if (== site id)
          (call (. facts set-answer-type) instance id result)
        )
        (return result)
      )
      (case= .map-op
        (return (call infer-pipeline-closure id source site (call (. program store-atom) "map") with-atom false))
      )
      (case= .filter-op
        (let where-atom (call (. program store-atom) "where"))
        (return (call infer-pipeline-closure id source site (call (. program store-atom) "filter") where-atom false))
      )
      (case= .map-filter-op
        (let map-filter-atom (call (. program store-atom) "map-filter"))
        (return (call infer-pipeline-closure id source site map-filter-atom with-atom true))
      )
      (case= .pipe-repeat-op
        (return (call infer-pipeline-closure id source site (call (. program store-atom) "tap") with-atom false))
      )
      (case= .pipe-closure-op
        (let decl (call nested-decl-of id))
        (if (== decl 0)
          (call decline id)
          (return invalid-type)
        )
        (return (call (. calls generator-call) id (call demand-nested decl source)))
      )
      (case= .pipe-write-all-op
        (let sink (call infer right))
        (if (== sink invalid-type)
          (return invalid-type)
        )
        (call (. calls operator-call) id sink (call (. program store-atom) "<-write") left source)
        (if (== site id)
          (call (. facts set-answer-type) instance id sink)
        )
        (return sink)
      )
      (default
        (call decline id)
        (return invalid-type)
      )
    )
  )
  (fn-do _ infer-pattern-pipe TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A stream piped through a pattern, `s ~> p`: a call of the generator closure generated for it,
    ; given the left value, which yields what each match of the pattern gives. The value is given as
    ; `pipe-source` casts it, and a feed the pipe reads alone is given nothing: the closure
    ; evaluates what it writes. A pattern that may match without reading, where what it reads first
    ; is known, is an error: the pipe would never end, and so is a value no stream is made of, which
    ; the closure loops over through its stream, iterable or not. A cast value that is described has
    ; no shape here: the closure is named for the cast, not for what it casts. Nor has any other
    ; list of feeds.
    (let piped (call (. tree piped-feed) id))
    (if (and (== piped 0) (is ([] (. tree nodes) left) .node-feed-expression))
      (call decline id)
      (return invalid-type)
    )
    (let source (if-expr (== piped 0) (call infer left) no-type))
    (if (== source invalid-type)
      (return invalid-type)
    )
    (let pattern right)
    (match? ([] (. tree nodes) right)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (if (or (== (call first-set pattern) 3) (call (. tree never-reads) pattern))
      (call (. frame diagnose) right .stated (call (. program store-atom) "Grammar pipeline must consume input"))
      (return invalid-type)
    )
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (call decline id)
      (return invalid-type)
    )
    (let mark (. facts diagnostics length))
    (if (!= piped 0)
      (return (call generated-call id (call demand-nested decl no-type) mark))
    )
    (let given (call pipe-source left source pattern))
    (if (or (== given invalid-type) (and (!= given source) (!= (call description-of tree left) "node")))
      (call decline id)
      (return invalid-type)
    )
    (if (and (not (call iterates given)) (== (call natural-item given) no-type))
      (call (. frame diagnose) right .stated (call (. program store-atom) "Can't convert to iterable"))
      (return invalid-type)
    )
    (return (call generated-call id (call demand-nested decl given) mark))
  )
  (fn-do _ generated-call TypeId
    (param id SyntaxId)
    (param callee InstanceId)
    (param mark Size)
    ; The call of the generator closure generated for a comprehension or a pipe, which gives the
    ; generator. None where the closure, or anything typed for it since `mark`, was refused or
    ; reported: what it yields is not known, and the value has no shape.
    (if (or (call (. facts declined-since) 0 callee) (!= (. facts diagnostics length) mark))
      (return invalid-type)
    )
    (return (call (. calls generator-call) id callee))
  )
  (fn-do _ pipe-source TypeId
    (param site SyntaxId)
    (param source TypeId)
    (param pattern SyntaxId)
    ; The value given the closure of a stream piped through a pattern, for each item the pattern
    ; prefers in turn: the value as it is where the stream it is read through reads that item, else
    ; the value cast to what `source-for-item` finds for it. The value as it is where it is cast for
    ; none.
    (let preferred (list TypeId))
    (if (not (call preferred-items pattern preferred))
      (return invalid-type)
    )
    (let natural (call natural-item source))
    (for (in item preferred)
      (if (== natural item)
        (return source)
      )
      (let target (call source-for-item source item))
      (if (!= target no-type)
        (if (and (!= target source) (== (call (. conversions convert) site site source target .reason-argument) invalid-type))
          (return invalid-type)
        )
        (return target)
      )
    )
    (return source)
  )
  (fn-do _ piped-source TypeId
    (param feed SyntaxId)
    (param pattern SyntaxId)
    ; What a feed that a stream piped through a pattern reads alone writes, evaluated in the closure
    ; and cast, for each item the pattern prefers in turn, to what `source-for-item` finds for that
    ; item. One cast for none has no shape here. The cast of a `use` is found for the type of what
    ; it uses, so one whose `begin-using` gives another type has none either.
    (let item SyntaxId 0)
    (match? ([] (. tree nodes) feed)
      (case (call .node-feed-expression row)
        (= item (. row item))
      )
    )
    (let value (call infer item))
    (if (== value invalid-type)
      (return invalid-type)
    )
    (match? ([] (. tree nodes) item)
      (case (call .node-use-expression row)
        (if (or (!= (call (. tree optional-chain-expr) (. row expr)) 0) (!= (call (. facts node-type) instance (. row expr)) value))
          (call decline feed)
          (return invalid-type)
        )
      )
    )
    (let preferred (list TypeId))
    (if (not (call preferred-items pattern preferred))
      (call decline feed)
      (return invalid-type)
    )
    (for (in preference preferred)
      (let target (call source-for-item value preference))
      (if (!= target no-type)
        (if (and (!= target value) (== (call (. conversions convert) item item value target .reason-argument) invalid-type))
          (return invalid-type)
        )
        (return target)
      )
    )
    (call decline feed)
    (return invalid-type)
  )
  (fn-do _ preferred-items Bool
    (param pattern SyntaxId)
    (param preferred (list TypeId))
    ; The items a stream piped through a pattern prefers to read, in order: where the pattern, under
    ; the captures, transforms, panics, repeats and lookaheads around it, calls a rule plainly, the
    ; one item every rule of that name the module reaches declares, where they agree; else
    ; characters and then bytes. A call of a local rule, of a pattern a name holds or given types
    ; has no shape here.
    (let node pattern)
    (let peeling true)
    (while peeling
      (= peeling false)
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-capture row)
          (= node (. row pattern))
          (= peeling true)
        )
        (case (call .node-stream-panic row)
          (= node (. row pattern))
          (= peeling true)
        )
        (case (call .node-stream-transform row)
          (if (!= (. row pattern) 0)
            (= node (. row pattern))
            (= peeling true)
          )
        )
        (case (call .node-stream-unary row)
          (= node (. row operand))
          (= peeling true)
        )
        (case (call .node-stream-length row)
          (= node (. row operand))
          (= peeling true)
        )
      )
    )
    (let declared no-type)
    (match? ([] (. tree nodes) node)
      (case (call .node-stream-call row)
        (if (or (!= (call rule-of node) 0) (call holds-value node) (!= (. row params count) 0))
          (return false)
        )
        (let agreed true)
        (for (in candidate (call (. program lookup) module (. row name)))
          (let item (call rule-item (. candidate module) (. candidate decl)))
          (if (!= item no-type)
            (= agreed (and agreed (or (== declared no-type) (== declared item))))
            (= declared item)
          )
        )
        (if (not agreed)
          (= declared no-type)
        )
      )
    )
    (if (!= declared no-type)
      (+= preferred declared)
      (else
        (+= preferred (call (. types type-row) .char))
        (+= preferred (call (. types type-row) .uint8))
      )
    )
    (return true)
  )
  (fn-do _ rule-item TypeId
    (param module ModuleId)
    (param decl DeclId)
    ; The item a rule a module declares is over, where it states one that holds no type parameter.
    ; None for any other declaration.
    (if (== (call rule-match program module decl) 0)
      (return no-type)
    )
    (let owner ([] (. program modules) module))
    (match? ([] (. owner decls) decl)
      (case (call .decl-function fn)
        (match? ([] (. owner tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (let item (call (. types evaluate-type) module (. owner tree) (. syntax pattern) (call (. types env-frame))))
            (if (and (!= item invalid-type) (not (. ([] (. types completions) item) has-variables)))
              (return item)
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ source-for-item TypeId
    (param source TypeId)
    (param item TypeId)
    ; What a value piped through a pattern is cast to, to read items of a type: the value's own type
    ; where it is a generator of them, else the first of an `Iterable`, an `Indexable` and a
    ; `Stream` of them it converts to. None where it converts to none.
    (if (and (call same-decl (call class-ref types source) (. types generator-decl)) (== (call first-arg source) item))
      (return source)
    )
    (for (in decl (list (. types iterable-decl) (. types indexable-decl) (. types stream-decl)))
      (let target (call class-over decl item))
      (if (call relation-legal (call (. conversions compare-held) source target))
        (return target)
      )
    )
    (return no-type)
  )
  (fn-do + check-pattern-pipe _
    (param id SyntaxId)
    (param right SyntaxId)
    ; The body of the generator closure a stream piped through a pattern compiles as: the value it
    ; is given is read through the stream a match would read it through, made once, and on each pass
    ; the pattern matches from where the last left the stream, as a rule's arms match, without
    ; reading the rest. Each pass first releases the input the stream has delivered, then asks the
    ; stream whether it has more, and takes its position, which holds no input, before the match and
    ; after it, to panic where a match read nothing. Each value a match gives is yielded; the
    ; closure ends where the stream has no more, or the pattern fails. A stream made of a value that
    ; is none is the closure's own, and is released whole; one given as a stream is the caller's,
    ; and keeps what the caller's marks hold. A feed the pipe reads alone is evaluated here, as
    ; `piped-source` casts it. A helper the pipe is given with `with` is evaluated once, after the
    ; stream is made, and every match runs under it, as a match given one does. One that marks the
    ; records a pipe matches is asked to begin each record where the stream has more, before the
    ; stream's position is taken, through the property it delegates that to where it does. A pattern
    ; whose value is optional is an error.
    (let pattern right)
    (let helper SyntaxId 0)
    (match? ([] (. tree nodes) right)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
        (= helper (. row helper))
      )
    )
    (let piped (call (. tree piped-feed) id))
    (let container
      (scope (if-expr (!= piped 0) (call piped-source piped pattern) first-argument)
        (lazy first-argument (call (. instances argument-type) instance 0))
      )
    )
    (if (== container invalid-type)
      (return)
    )
    (call note-poll)
    (let buffer stream-view)
    (let read (call record-stream-protocol right container))
    (let made (. stream-view type))
    (let saved-helper helping)
    (= helping (= (. helping helper) null))
    (= helping (= (. helping site) 0))
    (= helping (= (. helping rolls) false))
    (= helping (= (. helping explicit) false))
    (= helping (= (. helping body) (if-expr (!= helper 0) right 0)))
    (let helped (or (== helper 0) (call type-helper helper)))
    (let helper-type (if-expr (and (!= helper 0) helped) (call (. facts node-type) instance helper) no-type))
    (let typed (if-expr (and read helped) (call type-stream-arms pattern true) invalid-type))
    (if (and (!= typed invalid-type) (. helping rolls) (== (. (!! (. helping helper)) rollback) no-type))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg "Pattern @rollback helper must implement PatternRollback with a concrete Mark type")
              )
            )
          )
        )
      )
      (= typed invalid-type)
    )
    (= helping saved-helper)
    (= stream-view buffer)
    (if (not helped)
      (return)
    )
    (if (not read)
      (call decline id)
      (return)
    )
    (if (== typed invalid-type)
      (return)
    )
    (if (call (. types is-optional) typed)
      (call (. frame diagnose) right .stated (call (. program store-atom) (call optional-match-text "pipeline")))
      (return)
    )
    (let release
      (block
        (case? (== (call supported container (. types token-stream-decl)) no-type)
          "pattern-release"
        )
        (default
          "pattern-release-unmarked"
        )
      )
    )
    (call (. calls protocol-call) made (call (. program store-atom) release) id (:role (. CallRole role-release)))
    (if (!= (call (. calls protocol-getter) made (call (. program store-atom) "has-more") id .role-ask) (. types bool-type))
      (call decline id)
      (return)
    )
    (let mark (. (call (. calls protocol-call) made (call (. program store-atom) "pattern-position") id (:role (. CallRole role-mark))) answer))
    (if (or (== mark invalid-type) (!= (call field-of mark 1) (. types index-type)))
      (call decline id)
      (return)
    )
    (if (and (!= helper-type no-type) (!= (. (call pattern-helper types helper-type) boundary) no-type))
      (let receiver (call capability-receiver helper-type (. (call pattern-helper types helper-type) boundary)))
      (let places (list U32))
      (if (or (== receiver no-type) (and (!= receiver helper-type) (not (call (. calls ranking delegate-path) helper-type receiver places))))
        (call decline id)
        (return)
      )
      (let recording (call (. calls protocol-call) receiver (call (. program store-atom) "begin-pattern-record") id (:role (. CallRole role-record))))
      (if (== (. recording fact) no-fact)
        (call decline id)
        (return)
      )
      (if (!= (. places length) 0)
        (= (. ([] (. facts calls) (. recording fact)) through)
          (call (. facts keep-steps)
            (block
              (arg places)
              (arg (call (. calls step-getters) places))
            )
          )
        )
      )
    )
    (call keep-loop id container made helper-type)
    (call note-yield typed)
  )
  (fn-do _ infer-write-each TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A pipe that writes each item of what it reads to what is on the right: what is on the right
    ; first, then a loop over the left value, planned at the pipe with the calls of its protocol,
    ; each turn of which gives the item to the function the right's type declares for a write,
    ; recorded at the pipe after them. The pipe gives what it wrote to.
    (let sink (call infer right))
    (let container (call loop-container left))
    (if (or (== sink invalid-type) (== (. container type) invalid-type))
      (return invalid-type)
    )
    (let item (. container item))
    (if (!= item no-type)
      (call plan-range-at id item)
      (else
        (let iterated (call iteration-container (. container type) left))
        (= item (call loop-item-type iterated id))
        (if (== item invalid-type)
          (return invalid-type)
        )
        (call plan-iteration-at id id iterated item false)
      )
    )
    (call (. calls operator-call) id sink (call (. program store-atom) "<-write") left item (:role (. CallRole role-write)))
    (return sink)
  )
  (fn-do _ infer-pipeline-source TypeId
    (param left SyntaxId)
    (param id SyntaxId)
    (match? ([] (. tree nodes) left)
      (case .node-feed-expression
        (return (call infer-feeds left id))
      )
    )
    (return (call infer left))
  )
  (fn-do _ infer-pipe-forward TypeId
    (param id SyntaxId)
    (param source TypeId)
    (param site SyntaxId)
    (param right SyntaxId)
    ; A forward pipe: the call on the right given its own arguments and then, unnamed, the left
    ; value, produced at `site`.
    (let params-start (. scratch types mark))
    (let param-count 0)
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let callable right)
    (let object (call CalledObject))
    (match? ([] (. tree nodes) right)
      (case (call .node-call-expression call)
        (= callable (. call callable))
        (for (in param ([] (. tree children) (. call params)))
          (call (. scratch types push) (call (. types evaluate-type) module tree param (. frame env)))
          (+= param-count 1)
        )
        (= object (call type-called-object callable (+ (. call args count) 1)))
        (for (in arg ([] (. tree children) (. call args)))
          (match ([] (. tree nodes) arg)
            (case (call .node-argument argument)
              (call (. scratch types push)
                (block
                  (arg (call infer-argument (. argument expr) (call (. tree argument-symbol) (. argument expr))))
                )
              )
              (call (. scratch call-arguments push)
                (block
                  (arg (call argument-shape (. argument name) (. argument is-optional) (. argument expr)))
                )
              )
              (call (. scratch syntax push) arg)
            )
            (default
              (call (. scratch types push) (call infer-argument arg (call (. tree argument-symbol) arg)))
              (call (. scratch call-arguments push) (call argument-shape null false arg))
              (call (. scratch syntax push) arg)
            )
          )
        )
      )
    )
    (call (. scratch call-arguments push) (call CallArgument null false false false false null))
    (call (. scratch types push) source)
    (call (. scratch syntax push) site)
    (let params (call (. scratch types span) params-start param-count))
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg params)
          (arg false)
          (arg (if-expr (== site id) id 0))
        )
      )
    )
    (= called-object object)
    (let result (. (call infer-callable id callable arguments) type))
    (= called-object (call CalledObject))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return result)
  )
  (fn-do _ infer-pipeline-closure TypeId
    (param id SyntaxId)
    (param source TypeId)
    (param site SyntaxId)
    (param name Atom)
    (param argument-name Atom)
    (param explicit Bool)
    ; A map, filter, map-filter or tap pipeline: the stream function `name` given the left value
    ; and, as `argument-name`, the right operand's closure over `each`. Where `explicit` asks, the
    ; call names its types, the item and what the closure's optional holds; where the closure
    ; answers no optional, the call infers them. A map-filter whose closure gives a value that is
    ; never null drops nothing, and is an error that asks for a map.
    (let item (call pipeline-item-type source))
    (let decl (call nested-decl-of id))
    (if (or (== item invalid-type) (== decl 0))
      (call decline id)
      (return invalid-type)
    )
    (let callee (call demand-nested decl item))
    (let closure (call intern-nested decl))
    (let params-start (. scratch types mark))
    (let param-count 0)
    (let returned (if-expr explicit (. ([] (. instances signatures) callee) returns) no-type))
    (if (and explicit (== returned no-type))
      (call decline id)
      (return invalid-type)
    )
    (if (and explicit (!= returned invalid-type) (!= returned (. types void-type)) (not (call (. types is-optional) returned)))
      (let shown (call type-short-name types returned))
      (let message
        (paragraph
          (str "The body of this \"?*>\" gives " shown ", which is never null, so it drops no item; write \"*>\"")
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (and explicit (call (. types is-optional) returned))
      (call (. scratch types push) item)
      (call (. scratch types push) (call (. types optional-inner) returned))
      (= param-count 2)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false null))
    (call (. scratch types push) source)
    (call (. scratch syntax push) site)
    (call (. scratch call-arguments push) (call CallArgument argument-name false false false false null))
    (call (. scratch types push) closure)
    (call (. scratch syntax push) id)
    (let params (call (. scratch types span) params-start param-count))
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg params)
          (arg false)
          (arg (if-expr (== site id) id 0))
        )
      )
    )
    (let result (call (. calls function-call) id name arguments))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return result)
  )
  (fn-do _ pipeline-item-type TypeId
    (param source TypeId)
    ; The item a pipeline body receives: a generator's, else the stream, iterable, or indexable item
    ; of the left value, in that order.
    (if (or (== source invalid-type) (== source no-type))
      (return invalid-type)
    )
    (call (. types complete) source)
    (if (call same-decl (call class-ref types source) (. types generator-decl))
      (let item (call first-arg source))
      (return (if-expr (!= item no-type) item invalid-type))
    )
    (let streamed (call iterable-item source (. types stream-decl)))
    (if (== streamed no-type)
      (= streamed (call iterable-item source (. types iterable-decl)))
    )
    (if (== streamed no-type)
      (= streamed (call iterable-item source (. types indexable-decl)))
    )
    (return (if-expr (!= streamed no-type) streamed invalid-type))
  )
  (fn-do _ infer-broadcaster TypeId
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    (param clause SyntaxId)
    (param body SyntaxId)
    ; A comprehension on a stream: the container is made a `Broadcastable` as a loop on a stream's
    ; is, an event of an object as the endpoint a value of its `Broadcastable` takes, and the
    ; comprehension's subscriber, a closure of the item and the stream, writes what its body gives
    ; to an `AsyncChannel` of the body's type, which is the comprehension's value. The subscriber is
    ; typed where it is made a `Subscriber`, before the channel, whose type its body decides; the
    ; channel is then made and kept in the local the subscriber captures, and the subscriber given
    ; to the broadcaster's `subscribe`, all recorded at the comprehension, or owned by the object as
    ; a loop's is, or subscribed as `subscribe-whenever` says where it has a `whenever` clause. A
    ; body that gives nothing is not supported.
    (let decl (call nested-decl-of id))
    (let channel-slot (call (. bindings resolution-of) (. frame binding) id))
    (if (or (== decl 0) (!= (. channel-slot kind) .resolve-slot))
      (call decline id)
      (return invalid-type)
    )
    (let stream (call subscribed-stream id loop container clause false (call (. (call Want) adding) .want-adapt)))
    (if (== stream no-type)
      (return invalid-type)
    )
    (let item (call first-arg stream))
    (let subscriber (call (. types well-known-type-of) "core/stream" "Subscriber" item))
    (if (or (== item no-type) (== subscriber invalid-type))
      (call decline id)
      (return invalid-type)
    )
    (let closure (call intern-nested decl))
    (if (== (call (. conversions convert) id id closure subscriber .reason-argument) invalid-type)
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) stream)
    (let callee (call demand-lambda closure (call (. scratch types since) mark)))
    (call (. scratch types rewind) mark)
    (let written (if-expr (!= callee no-instance) (call (. facts node-type) callee body) no-type))
    (if (or (== written no-type) (== written invalid-type) (== written (. types void-type)))
      (call decline id)
      (return invalid-type)
    )
    (let channel (call (. types well-known-type-of) "core/channel" "AsyncChannel" written))
    (let made
      (scope (if-expr channeled (call (. calls demand-constructor) channel (. scratch types mark)) no-instance)
        (lazy channeled (!= channel invalid-type))
      )
    )
    (if (== made no-instance)
      (call decline id)
      (return invalid-type)
    )
    (do
      (inline (call (. facts record-call) instance id made .call-constructor (. scratch no-fills) false))
    )
    (call (. frame assign) (. channel-slot slot) channel)
    (if (!= (call whenever-of loop) 0)
      (call subscribe-whenever id (call whenever-of loop) stream item subscriber)
      (else-if (call is-owner)
        (call own-subscription id stream item subscriber)
      )
      (else-if (== (. (call (. calls protocol-call) stream (call (. program store-atom) "subscribe") id subscriber true (:role (. CallRole role-subscribe))) answer) invalid-type)
        (call decline id)
        (return invalid-type)
      )
    )
    (return channel)
  )
  (fn-do + check-broadcast _
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    ; The subscriber of a comprehension on a stream: its header takes the item it is given, its
    ; clauses are tested in the order written, and what its body gives is written to the channel the
    ; comprehension made, by `note-broadcast`. A `while` or an `until` unsubscribes it from the
    ; stream it is given, as a loop on a stream's does. Its own closure type is recorded at the
    ; comprehension, for the value it unsubscribes.
    (let item (call (. instances argument-type) instance 0))
    (let stream (call (. instances argument-type) instance 1))
    (call (. facts set-node-type) instance loop stream)
    (call (. facts set-node-type) instance id (call closure-of-self))
    (call check-loop loop (call LoopContainer stream item) body true)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (call (. tree ends-subscription) (. row clause))
          (call demand-unsubscribe loop)
        )
      )
    )
  )
  (fn-do + note-broadcast _
    (param body SyntaxId)
    (param written TypeId)
    ; What the body of a comprehension on a stream gives, written to the comprehension's channel,
    ; an `AsyncChannel` of the body's type, by its `<-`, recorded at the comprehension; its errors
    ; leave the subscriber.
    (if (or (== written invalid-type) (== written no-type))
      (return)
    )
    (let channel (call (. types well-known-type-of) "core/channel" "AsyncChannel" written))
    (if (== channel invalid-type)
      (call decline body)
      (return)
    )
    (let op (. Operator write-op))
    (do
      (inline (call (. calls operator-call) (. frame declaration syntax) channel (call (. program store-atom) (str op)) body written))
    )
  )
  (fn-do + check-comprehension _
    (param loop SyntaxId)
    (param body SyntaxId)
    ; The closure's body: the loop over its container argument, recorded at the header where the
    ; passed container is read, yielding the body. The loop polls on each pass, as the `for` block
    ; it is lowered to does.
    (let container (call (. instances argument-type) instance 0))
    (call (. facts set-node-type) instance loop container)
    (call note-poll)
    (call check-loop loop (call LoopContainer container no-type) body true false true)
  )
  (fn-do + follow-pipeline _
    (param pipeline SyntaxId)
    (param read SyntaxId)
    (param name Atom)
    (let node pipeline)
    (let handed no-instance)
    (let shown (. name text))
    (while true
      (let given (call given-index node))
      (if (and (== given null) (== handed no-instance))
        (call unfollowed read name)
        (return)
      )
      (if (== given null)
        (let message
          (paragraph
            (str "\"#" shown "\" is read for each item of a pipeline that \"" (call callee-text handed) "\" hands back without working it through, and nothing works through what it hands back as the value is made; give that to a function that works it through, as count does, or write \"" shown "\" to read it plainly")
          )
        )
        (call (. frame diagnose) read .stated (call (. program store-atom) message))
        (return)
      )
      (let use (call callee-use ([] given-callees given) ([] given-positions given)))
      (if (== use .generator-consumed)
        (call (. facts note-pulled) instance ([] given-calls given))
        (return)
      )
      (if (== use .generator-kept)
        (let message
          (paragraph
            (str "\"#" shown "\" is read for each item of a pipeline that \"" (call callee-text ([] given-callees given)) "\" keeps rather than working through as it is called, so the read would not be followed; give the pipeline to a function that works it through, as count does, or write \"" shown "\" to read it plainly")
          )
        )
        (call (. frame diagnose) read .stated (call (. program store-atom) message))
        (return)
      )
      (= handed ([] given-callees given))
      (= node ([] given-calls given))
    )
  )
  (fn-expr _ callee-text String
    (param callee InstanceId)
    (match ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function function)
        (?? (?. (. function name) text) "the function")
      )
      (default
        "the function"
      )
    )
    (where
      (lazy row ([] (. instances rows) callee))
    )
  )
)
