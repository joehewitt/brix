(import ./binding)
(import ./calls)
(import ./checker)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ Tables (facet-of Checker)
  (fn-do + row-case-field TypeId
    (param id SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    ; The field every case of a union shares, which a table row over the union reads in place:
    ; one the cases inherit from one declaration is planned as a field of the row, kept in a
    ; column of its own.
    (let row (call (. calls union-row) receiver))
    (if (== row no-type)
      (return no-type)
    )
    (let shared (call shared-case-field-type row name))
    (if (!= shared no-type)
      (let held (call (. types cases-of) row))
      (let first (only-if (call property-named (. ([] held 0) type) name) (if (!= (. held length) 0))))
      (if (and first (call is-common-field types row ([] (. types properties) first)))
        (call plan-table id .table-field (. ([] (. types properties) first) slot))
      )
    )
    (return shared)
  )
  (fn-expr + row-answers Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether a row of a table reads a name as a field of its row, or of the case its row holds,
    ; where the row's own member of the name is private, as TypeScript reads one past a member it
    ; may not use.
    (case? (and (!= kind .table-row) (!= kind .immutable-table-row))
      false
    )
    (case? (== row no-type)
      false
    )
    (case? (and (== (call (. types intrinsic-of) row) .union) (call has-case-getter row name))
      true
    )
    (default
      (!= (call property-named row name) null)
    )
    (where
      (lazy kind (call (. types intrinsic-of) receiver))
      (lazy row (call row-struct-of receiver))
    )
  )
  (fn-do + array-views TypeId
    (param receiver TypeId)
    (param name Atom)
    (let is-rows (== (. name text) "rows"))
    (if (and (not is-rows) (!= (. name text) "fields"))
      (return no-type)
    )
    (let immutable (call (. types ancestor-of) receiver (. types immutable-array-decl)))
    (let array (if-expr (!= immutable no-type) immutable (call (. types ancestor-of) receiver (. types array-decl))))
    (if (== array no-type)
      (return no-type)
    )
    (let access (if-expr (!= immutable no-type) (. types array-read-access) (. types array-write-access)))
    (let owner (if-expr is-rows (. types array-rows-decl) (. types array-fields-decl)))
    (return (call (. types array-view-of) owner (call row-struct-of array) access))
  )
  (fn-do + plan-view _
    (param id SyntaxId)
    (param slot U32 (= (. U32 max)))
    ; A node the compiler answers for a view of an array, which may raise the panics of a view:
    ; with the place in the item's layout of the field a row or a view of fields is read at.
    (if (== slot (. U32 max))
      (call (. facts set-plan) instance id .plan-view)
      (else
        (call (. facts set-constant) instance id (call ConstantFact slot 0.0 null false) .plan-view)
      )
    )
    (call (. instances mark-may-panic) instance)
  )
  (fn-do + plan-table _
    (param id SyntaxId)
    (param op TableOp)
    (param slot U32 (= 0))
    ; A node the compiler answers for a table or a view of one, as TypeScript intercepts it before
    ; any method, which may raise the panics of a table: the operation, and the place in the row's
    ; layout of the field it reads or writes.
    (let bits (/or/ (as op U64) (/lshift/ (as slot U64) 32)))
    (call (. facts set-constant) instance id (call ConstantFact bits 0.0 null false) .plan-table)
    (call (. instances mark-may-panic) instance)
  )
  (fn-do + plan-builder _
    (param id SyntaxId)
    (param builder TypeId)
    (param name String)
    (param count Size)
    ; A member of an arena's builder that TypeScript answers where it is called, which may raise
    ; the panics of its growth: `append` of an item and `reserve`. The constant tells whether the
    ; arena traces the builder's items.
    (let item (call (. types builder-item) builder))
    (if (or (== item no-type) (== item invalid-type))
      (return)
    )
    (let appends (and (== name "append") (== count 1)))
    (if (and (not appends) (!= name "reserve"))
      (return)
    )
    (let plan (if-expr appends (. OperatorPlan plan-builder-append) (. OperatorPlan plan-builder-reserve)))
    (let traces U64 (if-expr (call (. calls arena-traces) item) 1 0))
    (call (. facts set-constant) instance id (call ConstantFact traces 0.0 null false) plan)
    (call (. instances mark-may-panic) instance)
  )
  (fn-do + note-span-range _
    ; The range the constructor of an index span is given is made forward where the constructor
    ; runs, as TypeScript makes it: the call is recorded at no node of the constructor, which may
    ; raise the panics of a range that does not fit.
    (let range (call (. instances argument-type) instance 1))
    (let shapes (. scratch call-arguments mark))
    (let given (. scratch types mark))
    (let written (. scratch syntax mark))
    (let none (call arguments-since shapes given written (. scratch no-types)))
    (call (. calls method-call) 0 0 range (call (. program store-atom) "forward") none)
    (call (. instances mark-may-panic) instance)
  )
  (fn-expr + is-table-view Bool
    (param receiver TypeId)
    ; Whether an index of a value of the type may be one the compiler answers for a table or a view
    ; of one (`plan-table-index`), which says whether the index makes a call.
    (or (== kind .table) (== kind .immutable-table) spans columns selects (== kind .index-span))
    (where
      (lazy kind (call (. types intrinsic-of) receiver))
      (lazy spans (or (== kind .table-span) (== kind .immutable-table-span)))
      (lazy columns (or (== kind .table-column) (== kind .immutable-table-column)))
      (lazy selects (or (== kind .table-selection) (== kind .immutable-table-selection)))
    )
  )
  (fn-do + plan-table-index Bool
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    (param result TypeId)
    ; Plans an index of a table or of a view of one that TypeScript answers itself: a row of a
    ; table or of a span at a single index, an item of a field's column, the span or the view of
    ; the items a range spans, the rows indices select, and an index or a row of an index span or
    ; a selection, or the span a range of one spans. A range is made forward by the calls recorded
    ; here. False where those calls cannot be made.
    (let kind (call (. types intrinsic-of) receiver))
    (let tabled
      (scope (or table-kind (== kind .table-span) (== kind .immutable-table-span))
        (lazy table-kind (or (== kind .table) (== kind .immutable-table)))
      )
    )
    (let made (call (. types intrinsic-of) result))
    (let spans (and tabled (or (== made .table-span) (== made .immutable-table-span))))
    (let columns (or (== kind .table-column) (== kind .immutable-table-column)))
    (let selects (or (== kind .table-selection) (== kind .immutable-table-selection)))
    (let ranged (call is-range-type key))
    (if (and tabled (or (== made .table-row) (== made .immutable-table-row)))
      (call plan-table id .table-row)
      (else-if (and (or (== kind .table) (== kind .immutable-table)) made-selection)
        (call plan-table id .table-select)
      )
      (else-if (and columns (not ranged))
        (call plan-table id .table-item)
      )
      (else-if (and (or (== kind .index-span) selects) (not ranged))
        (call plan-table id (if-expr (== kind .index-span) .span-item .selection-row))
      )
      (else-if (and ranged (or spans (and columns (== made kind)) (== kind .index-span) selects))
        (if (not (call note-view-range id object-syntax receiver key-syntax key))
          (return false)
        )
        (let op (. TableOp table-span))
        (if (== kind .index-span)
          (= op .span-range)
          (else-if selects
            (= op .selection-range)
          )
        )
        (call plan-table id op)
      )
    )
    (lazy made-selection (or (== made .table-selection) (== made .immutable-table-selection)))
    (return true)
  )
  (fn-do + view-cell TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    ; What an index of a view of rows or of one field reads, which the compiler answers before any
    ; `[]` the view declares: a range gives the view of the rows or the items it spans, and any
    ; other key, made an `Index`, the row or the item at that index.
    (let kind (call view-kind receiver))
    (if (== kind 0)
      (return no-type)
    )
    (call plan-view id)
    (if (call is-range-type key)
      (if (not (call note-view-range id object-syntax receiver key-syntax key))
        (return invalid-type)
      )
      (return (if-expr (== kind 2) receiver (call (. types array-view-of) (. types array-row-range-decl) (call row-struct-of receiver) (call class-arg types receiver 1))))
    )
    (call (. conversions convert) key-syntax key-syntax key (. types index-type) .reason-argument)
    (return (if-expr (== kind 2) (call row-struct-of receiver) (call (. types array-view-of) (. types array-row-decl) (call row-struct-of receiver) (call class-arg types receiver 1))))
  )
  (fn-do + note-view-range Bool
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    ; Records at the index of a view the calls that make a range of it forward: a range of
    ; positions is first made one of indexes by its `normalize`, given the view.
    (let first FactId (as (. facts calls length) FactId))
    (let range key)
    (if (== (call class-arg types key 0) (. types position-type))
      (let shapes-start (. scratch call-arguments mark))
      (let types-start (. scratch types mark))
      (let syntax-start (. scratch syntax mark))
      (call (. scratch call-arguments push) (call CallArgument null false false false false null))
      (call (. scratch types push) receiver)
      (call (. scratch syntax push) object-syntax)
      (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
      (= range (call (. calls method-call) id key-syntax key (call (. program store-atom) "normalize") arguments))
      (call (. scratch syntax rewind) syntax-start)
      (call (. scratch types rewind) types-start)
      (call (. scratch call-arguments rewind) shapes-start)
    )
    (if (or (== range invalid-type) (== range no-type))
      (return false)
    )
    (let empty-shapes (. scratch call-arguments mark))
    (let empty-types (. scratch types mark))
    (let empty-syntax (. scratch syntax mark))
    (let none (call arguments-since empty-shapes empty-types empty-syntax (. scratch no-types)))
    (let forward (call (. calls method-call) id key-syntax range (call (. program store-atom) "forward") none))
    (let fact (call (. facts latest-call-of) instance))
    (while (and (!= fact no-fact) (>= fact first))
      (if (== (. ([] (. facts calls) fact) syntax) id)
        (= (. ([] (. facts calls) fact) form) .call-view-range)
      )
      (= fact (call (. facts prior-call) fact))
    )
    (return (and (!= forward invalid-type) (!= forward no-type)))
  )
  (fn-do + is-view-item Bool
    (param item TypeId)
    ; An array's rows and fields are views of a concrete tuple or struct item.
    (if (or (== item no-type) (== item invalid-type) (. ([] (. types completions) item) has-variables))
      (return false)
    )
    (let kind (call (. types intrinsic-of) item))
    (if (and (!= kind .tuple) (!= kind .struct))
      (return false)
    )
    (return
      (match ([] (. types rows) item)
        (case (call .type-class row)
          (not (call same-decl (call DeclRef (. row module) (. row decl)) (. types array-decl)))
        )
        (default
          true
        )
      )
    )
  )
  (fn-expr _ view-item TypeId
    (param receiver TypeId)
    (param owner DeclRef)
    (case? (!= (call (. types intrinsic-of) receiver) .tuple)
      no-type
    )
    (case? (== view no-type)
      no-type
    )
    (default
      (call row-struct-of view)
    )
    (where
      (lazy view (call (. types ancestor-of) receiver owner))
    )
  )
  (fn-do + view-field TypeId
    (param receiver TypeId)
    (param name Atom)
    (let row-item (call view-item receiver (. types array-row-decl)))
    (let item (if-expr (!= row-item no-type) row-item (call view-item receiver (. types array-fields-decl))))
    (if (== item no-type)
      (return no-type)
    )
    (let found (call property-named item name))
    (if (not found)
      (return no-type)
    )
    (let field (call eager-type item ([] (. types properties) found)))
    (if (or (== field no-type) (!= row-item no-type))
      (return field)
    )
    (return (call field-view receiver field))
  )
  (fn-do + view-index TypeId
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (param rows-only Bool (= false))
    (let row-item (call view-item receiver (. types array-row-decl)))
    (if (and rows-only (== row-item no-type))
      (return no-type)
    )
    (let item (if-expr (!= row-item no-type) row-item (call view-item receiver (. types array-fields-decl))))
    (if (== item no-type)
      (return no-type)
    )
    (let field (call eager-field item key-syntax))
    (if (or (== field no-type) (!= row-item no-type))
      (return field)
    )
    (return (call field-view receiver field))
  )
  (fn-expr + view-kind U32
    (param receiver TypeId)
    ; Whether a type is a view of an array's rows, 1, or of one of its fields, 2, and 0 for any
    ; other: a range of a view is assigned from a view of the same kind.
    (case? (or (== receiver no-type) (== receiver invalid-type))
      0
    )
    (case? (call same-decl ref (. types array-field-decl))
      2
    )
    (case? (or (call same-decl ref (. types array-rows-decl)) (call same-decl ref (. types array-row-range-decl)))
      1
    )
    (default
      0
    )
    (where
      (lazy ref (call class-ref types receiver))
    )
  )
  (fn-do _ field-view TypeId
    (param fields TypeId)
    (param field TypeId)
    (let view (call (. types ancestor-of) fields (. types array-fields-decl)))
    (return
      (match ([] (. types rows) view)
        (case (call .type-class row)
          (call (. types array-view-of) (. types array-field-decl) field (call (. types child-type) (. row args) 1))
        )
        (default
          no-type
        )
      )
    )
  )
  (fn-do + column-field-type TypeId
    (param receiver TypeId)
    (param name Atom)
    (let row (call row-struct-of receiver))
    (if (or (== row no-type) (== row invalid-type))
      (return no-type)
    )
    (if (== (call (. types intrinsic-of) row) .union)
      (return (call shared-case-field-type row name))
    )
    (let column (call property-named row name))
    (if (not column)
      (return no-type)
    )
    (let field ([] (. types properties) column))
    (if (!= (. field storage-kind) .storage-eager)
      (return no-type)
    )
    (if (== (. field type) no-type)
      (return (call demand-member field row name))
    )
    (return (. field type))
  )
  (fn-do _ shared-case-field-type TypeId
    (param union TypeId)
    (param name Atom)
    (let first (call first-case union))
    (if (== first no-type)
      (return no-type)
    )
    (let found (call property-named first name))
    (if (not found)
      (return no-type)
    )
    (let field ([] (. types properties) found))
    (if (not (call is-common-field types union field))
      (return no-type)
    )
    (return (call eager-type first field))
  )
  (fn-expr _ first-case TypeId
    (param union TypeId)
    (case? (== (. cases length) 0)
      no-type
    )
    (case? (or (== first invalid-type) (. ([] cases 0) is-default))
      no-type
    )
    (default
      first
    )
    (where
      (lazy cases (call (. types cases-of) union))
      (lazy first (. ([] cases 0) type))
    )
  )
  (fn-do + has-case-getter Bool
    (param union TypeId)
    (param name Atom)
    (for (in fact (call (. types cases-of) union))
      (if (and (not (. fact is-default)) (!= (. fact type) no-type) (!= (. fact type) invalid-type))
        (let found (call property-named (. fact type) name))
        (if (and found (== (. ([] (. types properties) found) storage-kind) .storage-getter))
          (return true)
        )
        (if (and (not found) (call (. calls has-getter) (. fact type) name))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do + column-at TypeId
    (param receiver TypeId)
    (param position U32)
    ; The field a table or span destructures to at a position, and no type past its last field.
    (let row (call row-struct-of receiver))
    (if (or (== row no-type) (== row invalid-type))
      (return no-type)
    )
    (let shared (== (call (. types intrinsic-of) row) .union))
    (let source (if-expr shared (call first-case row) row))
    (if (== source no-type)
      (return no-type)
    )
    (call (. types complete) source)
    (let range (. ([] (. types completions) source) properties))
    (let index 0u32)
    (for (in offset (..< 0 (. range count)))
      (let property ([] (. types properties) (as (+ (. range start) offset) Index)))
      (let counted
        (scope (if-expr shared (call is-common-field types row property) eager-property)
          (lazy eager-property (== (. property storage-kind) .storage-eager))
        )
      )
      (if counted
        (if (== index position)
          (return (call eager-type source property))
        )
        (+= index 1)
      )
    )
    (return no-type)
  )
  (fn-do + column-count U32
    (param receiver TypeId)
    (let count 0u32)
    (while (!= (call column-at receiver count) no-type)
      (+= count 1)
    )
    (return count)
  )
  (fn-expr + row-struct-of TypeId
    (param receiver TypeId)
    (match ([] (. types rows) receiver)
      (case (call .type-class row)
        (if-expr (!= (. row args count) 0) (call (. types child-type) (. row args) 0) no-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-do + is-row-table Bool
    (param callable SyntaxId)
    (param arguments Arguments)
    ; Whether a table named with its row type can lay that row out.
    (match? ([] (. tree nodes) callable)
      (case .node-type-arguments
        (let table (call (. types evaluate-type) module tree callable (. frame env)))
        (if (!= table invalid-type)
          (return (call check-table-row table arguments))
        )
      )
    )
    (return true)
  )
  (fn-do + check-table-row Bool
    (param table TypeId)
    (param arguments Arguments)
    ; A table lays its rows out in columns, so a row is a struct of eager stored fields with no
    ; delegated behavior, or a union of such tuples. A table an arena holds cannot hold managed
    ; pointers, and neither can the packed cases of union rows a table makes storage for, which an
    ; `ImmutableTable` made over storage that exists does not. Says whether the row can be laid out.
    (let kind (call (. types intrinsic-of) table))
    (if (and (!= kind .table) (!= kind .immutable-table))
      (return true)
    )
    (let row (call row-struct-of table))
    (if (or (== row no-type) (== row invalid-type) (. ([] (. types completions) row) has-variables))
      (return true)
    )
    (call (. types complete) row)
    (let row-kind (call (. types intrinsic-of) row))
    (let held (and (!= (. arguments types length) 0) (call (. types is-arena) ([] (. arguments types) 0))))
    (let ref (call class-ref types row))
    (let site (call class-site ref))
    (if (== row-kind .union)
      (if (not (call check-union-rows row (and (== kind .table) (not held))))
        (return false)
      )
      (let found (only-if (call managed-path row 0) (if held)))
      (if found
        (let shown (call type-short-name types row))
        (let path (str (call type-key types row) found))
        (let message (str "Arena type " shown " contains managed pointers through " path))
        (return (call refuse-row (. ref module) site message row))
      )
      (return true)
    )
    (if (!= row-kind .struct)
      (return (call refuse-row (. ref module) site "Table row types must be concrete fixed-layout structs"))
    )
    (if (!= (. (call (. types delegates-of) row) length) 0)
      (return (call refuse-row (. ref module) site "Table row types cannot use delegated interface behavior"))
    )
    (for (in index (..< 0 (. (call (. types properties-of) row) length)))
      (let property ([] (call (. types properties-of) row) index))
      (if (!= (. property storage-kind) .storage-eager)
        (let owner (call declaring-decl types property))
        (let written (call member-site types owner (. property name)))
        (return (call refuse-row (. owner module) written "Table row fields must be eager stored fields"))
      )
    )
    (if held
      (let found (call managed-path row 0))
      (if found
        (let shown (call type-short-name types row))
        (let message (str "Arena type " shown " contains managed pointers through " shown found))
        (return (call refuse-row (. ref module) site message))
      )
    )
    (return true)
  )
  (fn-do _ refuse-row Bool
    (param owner ModuleId)
    (param site SyntaxId)
    (param message String)
    (param mentioned TypeId (= no-type))
    (call (. facts record-diagnostic) instance owner site .stated (call (. program store-atom) message) mentioned)
    (return false)
  )
  (fn-do _ check-union-rows Bool
    (param union TypeId)
    (param creates Bool)
    ; A table of union rows keeps the fields every case shares in columns of their own and packs
    ; the rest of each case, which must be plain data where the table `creates` that storage itself.
    (let ref (call class-ref types union))
    (let site (call class-site ref))
    (let count (. (call (. types cases-of) union) length))
    (if (== count 0)
      (return (call refuse-row (. ref module) site "Table union row types must declare at least one case"))
    )
    (for (in index (..< 0 count))
      (let fact ([] (call (. types cases-of) union) index))
      (let shown (if-expr (. fact name) (. (!! (. fact name)) text) (str index)))
      (let tuple (and (not (. fact is-default)) (!= (. fact type) no-type) (!= (. fact type) invalid-type)))
      (if (or (not tuple) (not (call intrinsic-is-tuple-like (call (. types intrinsic-of) (. fact type)))))
        (let message (str "Table union case '" shown "' must use a concrete fixed-layout tuple"))
        (return (call refuse-row (. ref module) site message))
      )
      (if (!= (. (call (. types delegates-of) (. fact type)) length) 0)
        (return (call refuse-row (. ref module) site (str "Table union case '" shown "' cannot use delegated storage")))
      )
      (for (in position (..< 0 (. (call (. types properties-of) (. fact type)) length)))
        (let property ([] (call (. types properties-of) (. fact type)) position))
        (if (== (. property storage-kind) .storage-lazy)
          (let owner (call declaring-decl types property))
          (let written (call member-site types owner (. property name)))
          (let message (str "Table union case '" shown "' cannot use lazy stored fields"))
          (return (call refuse-row (. owner module) written message))
        )
      )
    )
    (let first (. ([] (call (. types cases-of) union) 0) type))
    (for (in position (..< 0 (. (call (. types properties-of) first) length)))
      (let property ([] (call (. types properties-of) first) position))
      (if (and (call is-common-field types union property) (call is-hot-field types property))
        (let owner (call declaring-decl types property))
        (let named (call type-short-name types union))
        (let message (str "Table union '" named "' common field '" (. property name text) "' cannot be @hot "))
        (++= message "because it already has a dedicated common column")
        (return (call refuse-row (. owner module) (call member-site types owner (. property name)) message))
      )
    )
    (if (not creates)
      (return true)
    )
    (for (in index (..< 0 count))
      (let fact ([] (call (. types cases-of) union) index))
      (let shown (if-expr (. fact name) (. (!! (. fact name)) text) (str index)))
      (for (in position (..< 0 (. (call (. types properties-of) (. fact type)) length)))
        (let property ([] (call (. types properties-of) (. fact type)) position))
        (if (or (!= (. property storage-kind) .storage-eager) (call is-common-field types union property))
          (continue)
        )
        (let stored (call eager-type (. fact type) property))
        (if (and (!= stored no-type) (!= stored invalid-type) (call is-managed stored 0))
          (let owner (call declaring-decl types property))
          (let message (str "Table union case '" shown "' field '" (. property name text) "' contains managed "))
          (++= message (str "pointers through " (call type-key types stored)))
          (return (call refuse-row (. owner module) (call member-site types owner (. property name)) message stored))
        )
      )
    )
    (return true)
  )
  (fn-do _ managed-path (? String)
    (param type TypeId)
    (param depth U32)
    ; The path from a value an arena holds to the first managed pointer it would carry, and none
    ; when it carries none. A string and a foreign pointer are the arena's own to hold. The path
    ; is put together on the way back from the pointer, so a value without one builds no text.
    (if (or (> depth 16) (== type no-type) (== type invalid-type))
      (return null)
    )
    (call (. types complete) type)
    (let kind (call (. types intrinsic-of) type))
    (if (or (== kind .string) (== kind .cpointer) (== kind .table-mark))
      (return null)
    )
    (if (or (call intrinsic-is-tuple-like kind) (call (. types is-plain-tuple) type))
      (for (in index (..< 0 (. (call (. types properties-of) type) length)))
        (let property ([] (call (. types properties-of) type) index))
        (if (!= (. property storage-kind) .storage-eager)
          (continue)
        )
        (let found (call managed-path (call eager-type type property) (+ depth 1)))
        (if found
          (return (str "." (. property name text) found))
        )
      )
      (return null)
    )
    (if (== kind .optional)
      (let found (call managed-path (call (. types optional-inner) type) (+ depth 1)))
      (if found
        (return (str ".value" found))
      )
      (return null)
    )
    (if (== kind .union)
      (for (in index (..< 0 (. (call (. types cases-of) type) length)))
        (let fact ([] (call (. types cases-of) type) index))
        (let found (call managed-path (. fact type) (+ depth 1)))
        (if found
          (let shown (if-expr (. fact name) (. (!! (. fact name)) text) (str index)))
          (return (str "." shown found))
        )
      )
      (return null)
    )
    (if (call is-managed type depth)
      (return "")
    )
    (return null)
  )
  (fn-do + zip-columns TypeId
    (param lhs TypeId)
    (param rhs TypeId)
    ; Mutable table fields add into the tuple of fields a table span is cast from.
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (if (or (not (call push-columns lhs mark)) (not (call push-columns rhs mark)))
      (call (. scratch types rewind) mark)
      (call (. scratch names rewind) names-mark)
      (return no-type)
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ push-columns Bool
    (param value TypeId)
    (param mark ScratchMark)
    (if (== (call (. types intrinsic-of) value) .table-column)
      (call (. scratch names push) (call (. types index-atom) (- (. scratch types length) mark)))
      (call (. scratch types push) value)
      (return true)
    )
    (let fields (call (of RowRange TypeId)))
    (match? ([] (. types rows) value)
      (case (call .type-tuple row)
        (= fields (. row fields))
      )
    )
    (for (in offset (..< 0 (. fields count)))
      (let field (call (. types child-type) fields offset))
      (if (!= (call (. types intrinsic-of) field) .table-column)
        (return false)
      )
      (call (. scratch names push) (call (. types index-atom) (- (. scratch types length) mark)))
      (call (. scratch types push) field)
    )
    (return (!= (. fields count) 0))
  )
)
