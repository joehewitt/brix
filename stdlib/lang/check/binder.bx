(import /lang/ast/state-machines)
(import /stream/sort)

(type + Binder
  ; Walks one outermost function declaration and fills its binding tables. Nested functions are
  ; bound by the same walk as nested scopes; their identifiers land in the owner's map.
  (prop + bindings Bindings)
  (prop + program Program)
  (prop + builtin-classes BuiltinClasses)
  (prop + module ModuleId (= 0))
  (prop + decl DeclId (= 0))
  (prop _ tree AST)
  (prop _ binding BindingId (= no-binding))
  (prop _ names (list Atom))
  (prop _ name-slots (list SlotId))
  (prop _ name-depths (list U32))
  (prop _ name-links (list U32))
  (prop _ latest-names (of Map Atom U32))
  (prop _ scope-marks (list Size))
  (prop _ scope-stack (list ScopeId))
  (prop _ current-scope ScopeId (= 0))
  (prop _ function-depth U32)
  (prop _ loop-depth U32)
  (prop _ branch-depth U32)
  (prop _ subscription-depth U32)
  (prop _ state-depth U32)
  (prop _ lazy-depth U32)
  (prop _ guard-depth U32)
  (prop _ stream-reach U32)
  (prop _ capture-floor U32)
  (prop _ pattern-depth U32)
  (prop _ pattern-floor U32)
  (prop _ alternative-floor U32)
  (prop _ alternative-ceiling U32)
  (prop _ stream-captures (of Map SlotId Bool))
  (prop _ coded-depth U32)
  (prop _ closed-matches (list SyntaxId))
  (prop _ receiver-modules (list ModuleId))
  (prop _ receiver-decls (list DeclId))
  (prop _ receiver-marks (list Size))
  (prop _ receiver-elements (list SyntaxId))
  (prop _ receiver-depths (list U32))
  (prop _ receiver-scopes (list ScopeId))
  (prop _ received-reads (of Map U64 U32))
  (prop _ received-elements (list SyntaxId))
  (prop _ received-scopes (list ScopeId))
  (prop _ class-lines SyntaxId (= 0))
  (prop _ rule-lines SyntaxId (= 0))
  (prop _ content-turns (list SyntaxId))
  (prop _ raised-elements (list SyntaxId))
  (prop _ placed-elements (list SyntaxId))
  (prop _ in-callee Bool)
  (prop _ redeclaring SyntaxId (= 0))
  (prop _ quiet-name SyntaxId (= 0))
  (prop _ event-source SyntaxId (= 0))
  (prop _ condition-level (? Size))
  (prop _ repeating-depth U32)
  (prop _ owner-decl DeclId (= 0))
  (prop _ value-floor U32)
  (prop _ outer-uses-self Bool)
  (prop _ initializer-positions (list U32))
  (prop _ body-names (of RowRange Atom))
  (prop _ nested-decls (list DeclId))
  (prop _ nested-syntax (list SyntaxId))
  (prop _ nested-scopes (list ScopeId))
  (prop _ nested-depths (list U32))
  (prop _ nested-by-value (list Bool))
  (prop _ nested-marks (list Size))
  (prop _ capture-frames (list Size))
  (prop _ capture-slots (list SlotId))
  (prop _ capture-flags (list U32))
  (prop _ scan-starts (list SyntaxId))
  (prop _ scan-ends (list SyntaxId))
  (prop _ scan-rows (list U32))
  (prop _ scan-stack-rows (list U32))
  (prop _ scan-stack-ends (list SyntaxId))
  (prop _ indexed (list Bool))
  (prop _ nested-index (of Map U64 U32))
  (prop _ type-index (of Map U64 U32))
  (prop _ skipped (list U64))
  (prop _ skipped-first (list U32))
  (prop _ skipped-count (list U32))
  (prop _ late-ids (list SyntaxId))
  (prop _ late-names (list Atom))
  (prop _ late-flags (list ResolutionMask))
  (prop _ late-scopes (list ScopeId))
  (prop _ late-depths (list U32))
  (prop _ late-diagnostics (list U32))
  (prop _ late-frames (list Size))
  (prop _ late-frame-decls (list DeclId))
  (prop _ late-frame-depths (list U32))
  (prop _ late-frame-values (list Bool))
  (prop _ raised-homes (list SyntaxId))
  (prop _ row-getters (list SyntaxId))
  (prop _ getter-decls (list SyntaxId))
  (prop _ getter-firsts (list Size))
  (prop _ getter-ends (list Size))
  (prop _ getter-selves (list Bool))
  (prop _ getter-names (list Atom))
  (prop _ getter-nodes (list SyntaxId))
  (prop _ getter-slots (list SlotId))
  (prop _ getter-depths (list U32))
  (prop _ getter-flags (list ResolutionMask))
  (prop _ this-name Atom)
  (prop _ super-name Atom)
  (prop _ it-name Atom)
  (prop _ each-name Atom)
  (prop _ held-name Atom)
  (prop _ using-name Atom)
  (prop _ state-name Atom)
  (prop _ active-name Atom)
  (prop _ generation-name Atom)
  (prop _ tasks-name Atom)
  (prop _ payload-name Atom)
  (prop _ subscriber-name Atom)
  (prop _ source-name Atom)
  (prop _ machine-cases (list (list SyntaxId)))
  (prop _ owning-cases (list SyntaxId))
  (prop _ tasks-cases (list SyntaxId))
  (prop _ tasks-slots (list SlotId))
  (prop _ machine-kept (list (list (list Atom))))
  (prop _ machine-roots (list (list SyntaxId)))
  (prop _ machine-bound SlotId (= no-slot))
  (prop _ machine-value-name Atom)
  (prop _ machine-valued SyntaxId (= 0))
  (prop _ held SlotId (= no-slot))
  (prop _ value-name Atom)
  (prop _ has-value-name Atom)
  (prop _ name-name Atom)
  (prop _ key-name Atom)
  (prop _ properties-name Atom)
  (prop _ unit-name Atom)
  (prop _ stream-name Atom)
  (prop _ channel-name Atom)
  (prop _ whenever-name Atom)
  (prop _ element-name Atom)
  (prop _ previous-name Atom)
  (prop _ branch-host-name Atom)
  (prop _ branch-region-name Atom)
  (prop _ branch-parent-name Atom)
  (prop _ loop-host-name Atom)
  (prop _ loop-region-name Atom)
  (prop _ batch-root-name Atom)
  (prop _ subscription-name Atom)
  (prop _ broadcaster-name Atom)
  (prop _ tracker-name Atom)
  (prop _ location-name Atom)
  (prop _ subscribers-name Atom)
  (prop _ inherit-name Atom)
  (prop _ sheet-name Atom)
  (prop _ style-names (of Map Atom Bool))
  (prop _ style-names-listed Bool)
  (prop _ styled-depth U32)
  (prop _ subscriber-slots (list SlotId))
  (prop _ builder-slots (list SlotId))
  (prop _ content-home ScopeId (= 0))
  (prop _ fills _ (= false))
  (fn-do + This _
    (param bindings Bindings)
    (param program Program)
    (param builtin-classes BuiltinClasses)
    (lazy tree (. ([] (. program modules) 0) tree))
    (lazy this-name (call (. program store-atom) "this"))
    (lazy super-name (call (. program store-atom) "super"))
    (lazy it-name (call (. program store-atom) "it"))
    (lazy each-name (call (. program store-atom) "each"))
    (lazy held-name (call (. program store-atom) "(held)"))
    (lazy using-name (call (. program store-atom) "(using)"))
    (lazy state-name (call (. program store-atom) "(loop)"))
    (lazy active-name (call (. program store-atom) "(active)"))
    (lazy generation-name (call (. program store-atom) "(generation)"))
    (lazy tasks-name (call (. program store-atom) "(tasks)"))
    (lazy payload-name (call (. program store-atom) "(payload)"))
    (lazy subscriber-name (call (. program store-atom) "(subscriber)"))
    (lazy source-name (call (. program store-atom) "(source)"))
    (lazy machine-value-name (call (. program store-atom) "(value)"))
    (lazy value-name (call (. program store-atom) "value"))
    (lazy has-value-name (call (. program store-atom) "has-value"))
    (lazy name-name (call (. program store-atom) "name"))
    (lazy key-name (call (. program store-atom) "key"))
    (lazy properties-name (call (. program store-atom) "properties"))
    (lazy unit-name (call (. program store-atom) "unit"))
    (lazy stream-name (call (. program store-atom) "(stream)"))
    (lazy channel-name (call (. program store-atom) "(channel)"))
    (lazy whenever-name (call (. program store-atom) "(whenever)"))
    (lazy element-name (call (. program store-atom) "(element)"))
    (lazy previous-name (call (. program store-atom) "(previous)"))
    (lazy branch-host-name (call (. program store-atom) "(markup-branch-host)"))
    (lazy branch-region-name (call (. program store-atom) "(markup-branch-region)"))
    (lazy branch-parent-name (call (. program store-atom) "(parent)"))
    (lazy loop-host-name (call (. program store-atom) "(collection-host)"))
    (lazy loop-region-name (call (. program store-atom) "(collection-region)"))
    (lazy batch-root-name (call (. program store-atom) "(markup-batch-root)"))
    (lazy subscription-name (call (. program store-atom) "(subscription)"))
    (lazy broadcaster-name (call (. program store-atom) "(broadcaster)"))
    (lazy tracker-name (call (. program store-atom) "(tracker)"))
    (lazy location-name (call (. program store-atom) "location"))
    (lazy subscribers-name (call (. program store-atom) "(subs)"))
    (lazy inherit-name (call (. program store-atom) "inherit"))
    (lazy sheet-name (call (. program store-atom) "StyleSheet"))
  )
  (fn-do + retarget _
    (param next Program)
    (= program next)
    (call (. style-names clear))
    (= style-names-listed false)
  )
  (fn-do + bind BindingId
    (param function-module ModuleId)
    (param function-decl DeclId)
    ; The binding of a function, made the first time it is asked for. One binder does every
    ; function of a program, so binding a function allocates only when a stack outgrows what an
    ; earlier function needed.
    (return-if existing (if existing))
    (return (call run function-module function-decl))
    (blank)
    (lazy existing (call (. bindings binding-for) function-module function-decl))
  )
  (fn-expr + member-of-class (? DeclRef)
    (param owner-module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (?? (call member-of owner-module owner name 0) (call method-of owner-module owner name 0))
  )
  (fn-do _ run BindingId
    (param function-module ModuleId)
    (param function-decl DeclId)
    (call reset function-module function-decl)
    (let decls (. ([] (. program modules) module) decls))
    (match? ([] decls decl)
      (case (call .decl-function row)
        (let range (. row subtree))
        (= binding (call (. bindings reserve) module decl range))
        (match? ([] (. tree nodes) (. row syntax))
          (case (call .node-function-syntax node)
            (call check-effect-names (. row syntax) (. node bans) (. node door))
          )
        )
        (call bind-function)
        (call share-lazy-values)
        (call scan-body (. row syntax) range)
        (call (. bindings finish) binding tree)
        (return binding)
      )
      (case (call .decl-converter row)
        (let range (call syntax-subtree (. row syntax)))
        (= binding (call (. bindings reserve) module decl range))
        (call bind-converter (. row syntax) (. row owner) 0)
        (call scan-body (. row syntax) range)
        (call (. bindings finish) binding tree)
        (return binding)
      )
      (case (call .decl-fromverter row)
        (let range (call syntax-subtree (. row syntax)))
        (= binding (call (. bindings reserve) module decl range))
        (call bind-converter (. row syntax) (. row owner) (. row source-type))
        (call scan-body (. row syntax) range)
        (call (. bindings finish) binding tree)
        (return binding)
      )
    )
    (throw (call Panic "Binding requires a function, converter, or fromverter declaration"))
  )
  (fn-do _ check-effect-names _
    (param id SyntaxId)
    (param bans (of RowRange Atom))
    (param door (? Atom))
    ; The effects a `without` section bans and a door names are effects its module sees.
    (for (in offset (..< 0 (. bans count)))
      (let name ([] (. tree atoms) (+ (. bans start) offset)))
      (if (== (. name text) (call outside-name))
        (if (> (. program effects count) (call most-effects))
          (call (. bindings diagnostics append)
            (block
              (arg
                (call Diagnostic
                  (block
                    (arg module)
                    (arg id)
                    (arg .stated)
                    (arg
                      (call (. program store-atom)
                        (block
                          (arg
                            (paragraph
                              (str "A program can ban at most " (call most-effects) " effects, and 'outside' would ban all " (. program effects count) " of its effects")
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (continue)
      )
      (let found (call (. program effect-named) module name))
      (if (not found)
        (call (. bindings diagnostics append)
          (block
            (arg
              (call Diagnostic
                (block
                  (arg module)
                  (arg id)
                  (arg .stated)
                  (arg (call (. program store-atom) (str "Unknown name '" (. name text) "' after without")))
                )
              )
            )
          )
        )
        (else-if (>= found (call most-effects))
          (call (. bindings diagnostics append)
            (block
              (arg
                (call Diagnostic
                  (block
                    (arg module)
                    (arg id)
                    (arg .stated)
                    (arg
                      (call (. program store-atom)
                        (block
                          (arg
                            (paragraph
                              (str "A program can ban at most " (call most-effects) " effects, and '" (. name text) "' is past them")
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (if (and door (not (call (. program effect-named) module door)))
      (call (. bindings diagnostics append)
        (block
          (arg
            (call Diagnostic
              (block
                (arg module)
                (arg id)
                (arg .stated)
                (arg (call (. program store-atom) (str "Unknown effect '" (. door text) "' in @door")))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ reset _
    (param function-module ModuleId)
    (param function-decl DeclId)
    (= module function-module)
    (= decl function-decl)
    (= tree (. ([] (. program modules) module) tree))
    (call index-module)
    (= binding no-binding)
    (= current-scope 0)
    (= function-depth 0)
    (= loop-depth 0)
    (= branch-depth 0)
    (= subscription-depth 0)
    (= state-depth 0)
    (= lazy-depth 0)
    (= guard-depth 0)
    (= stream-reach 0)
    (= capture-floor 0)
    (= pattern-depth 0)
    (= pattern-floor 0)
    (= alternative-floor 0)
    (= alternative-ceiling 0)
    (call (. stream-captures clear))
    (= coded-depth 0)
    (call (. closed-matches clear))
    (call (. receiver-modules clear))
    (call (. receiver-decls clear))
    (call (. receiver-marks clear))
    (call (. receiver-elements clear))
    (call (. receiver-depths clear))
    (call (. receiver-scopes clear))
    (call (. received-reads clear))
    (call (. received-elements clear))
    (call (. received-scopes clear))
    (call (. content-turns clear))
    (= class-lines 0)
    (= rule-lines 0)
    (call (. raised-elements clear))
    (call (. placed-elements clear))
    (= in-callee false)
    (= quiet-name 0)
    (= repeating-depth 0)
    (= owner-decl 0)
    (= outer-uses-self false)
    (= held no-slot)
    (call (. subscriber-slots clear))
    (call (. owning-cases clear))
    (call (. tasks-cases clear))
    (call (. tasks-slots clear))
    (call (. builder-slots clear))
    (= fills false)
    (call forget-names 0)
    (call (. names clear))
    (call (. initializer-positions clear))
    (call (. name-slots clear))
    (call (. name-depths clear))
    (call (. name-links clear))
    (call (. scope-marks clear))
    (call (. scope-stack clear))
    (call (. nested-decls clear))
    (call (. nested-syntax clear))
    (call (. nested-scopes clear))
    (call (. nested-depths clear))
    (call (. nested-by-value clear))
    (call (. nested-marks clear))
    (call (. capture-frames clear))
    (call (. capture-slots clear))
    (call (. capture-flags clear))
    (call (. scan-starts clear))
    (call (. scan-ends clear))
    (call (. scan-rows clear))
    (call (. scan-stack-rows clear))
    (call (. scan-stack-ends clear))
    (call (. late-ids clear))
    (call (. late-names clear))
    (call (. late-flags clear))
    (call (. late-scopes clear))
    (call (. late-depths clear))
    (call (. late-diagnostics clear))
    (call (. late-frames clear))
    (call (. late-frame-decls clear))
    (call (. late-frame-depths clear))
    (call (. late-frame-values clear))
    (call (. raised-homes clear))
    (call (. row-getters clear))
    (call (. getter-decls clear))
    (call (. getter-firsts clear))
    (call (. getter-ends clear))
    (call (. getter-selves clear))
    (call (. getter-names clear))
    (call (. getter-nodes clear))
    (call (. getter-slots clear))
    (call (. getter-depths clear))
    (call (. getter-flags clear))
  )
  (fn-expr _ syntax-subtree SyntaxRange
    (param syntax SyntaxId)
    (call SyntaxRange start (+ (- syntax start) 1))
    (where
      (lazy start (call (. tree subtree-start) syntax))
    )
  )
  (fn-do _ bind-converter _
    (param syntax SyntaxId)
    (param owner DeclId)
    (param source SyntaxId)
    ; A converter body reads `this`; a fromverter also binds its source pattern as an argument.
    (let body 0u32)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-converter-syntax row)
        (= body (. row body))
      )
      (case (call .node-fromverter-syntax row)
        (= body (. row body))
      )
    )
    (blank)
    (call push-scope .scope-function syntax)
    (= owner-decl owner)
    (call declare-self)
    (call declare-pattern source .slot-argument 0 0)
    (call walk body)
    (call pop-scope)
  )
  (fn-do _ declare-self _
    (call declare this-name .slot-this 0 (. SlotFlag slot-constant) 0)
    (call declare super-name .slot-super 0 (. SlotFlag slot-constant) 0)
  )
  (fn-do _ bind-function _
    ; Binds a function of the module: its receiver, its arguments and their defaults, then its body,
    ; the module's top-level lines for `main`. For the function that fills an object with its class's
    ; markup, the state machines written beside a root `<This` are bound around the root's lines.
    (let syntax 0u32)
    (let owner 0u32)
    (let is-static false)
    (let args (call (of RowRange ArgumentShape)))
    (let body 0u32)
    (let is-main false)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function row)
        (= syntax (. row syntax))
        (= owner (. row owner))
        (= is-static (. row is-static))
        (= args (. row args))
        (= body (. row body))
        (= is-main (== (. row kind) .main-decl))
        (if (and (. row is-content) (!= body 0))
          (+= content-turns body)
          (if (!= (call (. tree root-this) (. row syntax)) 0)
            (= class-lines body)
          )
          (if (is ([] (. tree nodes) (. row syntax)) .node-rule-syntax)
            (= rule-lines body)
          )
        )
      )
    )
    (blank)
    (call push-scope .scope-function syntax)
    (= owner-decl owner)
    (if (and (!= owner 0) (not is-static))
      (call declare-self)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function row)
        (if (. row is-content)
          (= fills true)
          (= content-home current-scope)
        )
      )
    )
    (blank)
    (let shapes (. ([] (. program modules) module) arg-pool))
    (for (in shape ([] shapes args))
      (call declare-pattern (. shape pattern) .slot-argument 0 0)
    )
    (= owner-decl 0)
    (for (in shape ([] shapes args))
      (call walk (. shape default-syntax))
    )
    (= owner-decl owner)
    (blank)
    (if is-main
      (call walk-top-level (. tree root))
      (else-if (and (!= body 0) (call is-slot-builder body))
        (call declare-wrapped body)
        (call walk-wrapped body)
        (if fills
          (call walk-bound body)
        )
      )
      (else
        (let content (if-expr fills syntax 0u32))
        (for (in machine (call (. tree root-machines) content false))
          (call walk machine)
        )
        (call walk body)
        (for (in machine (call (. tree root-machines) content true))
          (call walk machine)
        )
      )
    )
    (call pop-scope)
  )
  (fn-do _ share-lazy-values _
    ; A lazy local that nested functions capture is evaluated by whichever function reads it
    ; first, so each of them must reach what its value reads. The locals and the arguments of
    ; the function that declares it that the value reads are captured with it, the items of
    ; its loops, and the receiver where the value reads a member, and so on through the lazy
    ; locals among them. Those declared together with it take their values with it, and so are
    ; captured with it.
    (let first (. ([] (. bindings bindings) binding) slots start))
    (let changed true)
    (while changed
      (= changed false)
      (for (in slot (..< first (. bindings slots length)))
        (let row ([] (. bindings slots) slot))
        (if (or (!= (. row kind) .slot-lazy) (== (. row group) 0) (== (/and/ (. row flags) (. SlotFlag slot-captured)) 0))
          (continue)
        )
        (match? ([] (. tree nodes) (. row group))
          (case (call .node-declare declaration)
            (if (and (not (. declaration is-pattern)) several (call share-together first (as slot SlotId)))
              (= changed true)
            )
            (lazy several (call (. bindings names-several) tree (. declaration left)))
            (if (and (!= (. declaration right) 0) (call share-read first (. row scope) right-subtree))
              (= changed true)
            )
            (lazy right-subtree (call syntax-subtree (. declaration right)))
          )
        )
      )
    )
  )
  (fn-do _ share-together Bool
    (param first SlotId)
    (param slot SlotId)
    ; Captures the lazy locals declared together with one that nested functions capture, which
    ; lie beside it, and says whether any was not captured before.
    (let group (. ([] (. bindings slots) slot) group))
    (let start slot)
    (while (and (> start first) (== (. ([] (. bindings slots) (- start 1)) group) group))
      (-= start 1)
    )
    (let end (+ slot 1))
    (while (and (< end (. bindings slots length)) (== (. ([] (. bindings slots) end) group) group))
      (+= end 1)
    )
    (let found false)
    (for (in sibling (..< start end))
      (let row ([] (. bindings slots) sibling))
      (if (and (== (. row kind) .slot-lazy) (== (/and/ (. row flags) (. SlotFlag slot-captured)) 0))
        (call (. bindings mark-slot) sibling (. SlotFlag slot-captured))
        (= found true)
      )
    )
    (return found)
  )
  (fn-do _ share-read Bool
    (param first SlotId)
    (param scope ScopeId)
    (param range SyntaxRange)
    ; Captures each local, argument and receiver of the function of a scope that a range of
    ; syntax reads and that is declared outside the range, and says whether any was not
    ; captured before. Each it captures is noted as captured for a lazy local's value alone.
    (let home (call function-of scope))
    (let found false)
    (for (in id (..< (. range start) (+ (. range start) (. range count))))
      (let resolution (call (. bindings resolution-of) binding id))
      (let slot no-slot)
      (if (== (. resolution kind) .resolve-slot)
        (= slot (. resolution slot))
        (else-if (or (== (. resolution kind) .resolve-member) (call names-method resolution))
          (= slot (call receiver-slot first))
        )
      )
      (if (or (== slot no-slot) (< slot first))
        (continue)
      )
      (let row ([] (. bindings slots) slot))
      (if (or (!= (/and/ (. row flags) (. SlotFlag slot-captured)) 0) (!= (call function-of (. row scope)) home))
        (continue)
      )
      (if (and (>= (. row syntax) (. range start)) (< (. row syntax) (+ (. range start) (. range count))))
        (continue)
      )
      (let kept (or (== (. row kind) .slot-local) (== (. row kind) .slot-argument)))
      (let item (or (== (. row kind) .slot-loop-item) (== (. row kind) .slot-each) (== (. row kind) .slot-it)))
      (if (or kept item (== (. row kind) .slot-lazy) (== (. row kind) .slot-this))
        (call (. bindings mark-slot) slot (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-shared-read)))
        (= found true)
      )
    )
    (return found)
  )
  (fn-do _ names-method Bool
    (param resolution Resolution)
    ; Whether a name resolved to a method, which is called on the receiver.
    (if (!= (. resolution kind) .resolve-function)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. resolution module)) decls) (. resolution decl))
      (case (call .decl-function row)
        (return (and (!= (. row owner) 0) (not (. row is-static))))
      )
    )
    (return false)
  )
  (fn-do _ function-of ScopeId
    (param scope ScopeId)
    ; The scope of the function or the nested function a scope lies in.
    (let found scope)
    (while (and (!= (. ([] (. bindings scopes) found) kind) .scope-function) (!= (. ([] (. bindings scopes) found) kind) .scope-nested))
      (= found (. ([] (. bindings scopes) found) parent))
    )
    (return found)
  )
  (fn-do _ receiver-slot SlotId
    (param first SlotId)
    ; The slot of the receiver of the function being bound, or none.
    (for (in slot (..< first (. bindings slots length)))
      (if (== (. ([] (. bindings slots) slot) kind) .slot-this)
        (return (as slot SlotId))
      )
    )
    (return no-slot)
  )
  (fn-do _ walk-top-level Void
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-top-level-syntax row)
        (call predeclare-lazies (. row statements))
        (call place-elements (. row statements))
        (for (in statement ([] (. tree children) (. row statements)))
          (if (call (. tree is-finally) statement)
            (continue)
          )
          (if (not (call is-declaration-syntax tree statement))
            (call raise-element statement)
            (call walk statement)
            (else
              (call walk-initializers statement)
            )
          )
        )
        (for (in statement ([] (. tree children) (. row statements)))
          (if (call (. tree is-finally) statement)
            (call walk statement)
          )
        )
      )
    )
  )
  (fn-do _ walk-initializers _
    (param id SyntaxId)
    ; Property initializers of a class or extension are lowered in its constructor, with `this` and
    ; the members in scope. They live inside main's range, so main binds them under the declaring
    ; type, each in a scope of its own. The value of a property, of a class or of the module, does
    ; not see the locals the module's statements declare: the names in reach when it starts are out
    ; of reach until it ends.
    (let members (call (of RowRange SyntaxId)))
    (let saved-floor value-floor)
    (match? ([] (. tree nodes) id)
      (case (call .node-class-block row)
        (= members (. row members))
      )
      (case (call .node-extension row)
        (= members (. row body))
      )
      (case (call .node-style-sheet-extension row)
        (= members (. row body))
      )
      (case (call .node-property-syntax row)
        (let first (. bindings slots length))
        (= value-floor (as (. names length) U32))
        (= machine-valued (. row value))
        (call walk (. row value))
        (= machine-valued 0)
        (= value-floor saved-floor)
        (call note-window id first)
      )
    )
    (if (== (. members count) 0)
      (return)
    )
    (blank)
    (let owner (call decl-for-syntax id))
    (if (== owner 0)
      (return)
    )
    (blank)
    (let saved-owner owner-decl)
    (= owner-decl owner)
    (for (in member ([] (. tree children) members))
      (match? ([] (. tree nodes) member)
        (case (call .node-property-syntax property)
          (if (!= (. property value) 0)
            (let first (. bindings slots length))
            (= value-floor (as (. names length) U32))
            (call push-scope .scope-function member)
            (call declare-self)
            (= machine-valued (. property value))
            (call walk (. property value))
            (= machine-valued 0)
            (call pop-scope)
            (= value-floor saved-floor)
            (call note-window member first)
          )
        )
        (case (call .node-when-rule-syntax rule)
          (call walk-rule member (. rule expr) (. rule body) saved-floor)
        )
        (case (call .node-whenever-rule-syntax rule)
          (if (and (== (. rule kind text) "value") (== (. rule args count) 0))
            (call walk-rule member (. rule expr) (. rule body) saved-floor)
            (else-if (and (!= (. rule kind text) "value") (< (. rule args count) 2))
              (call walk-trigger member rule saved-floor)
            )
          )
        )
        (case (call .node-subscriber-syntax section)
          (call walk-rule member 0 (. section iterator) saved-floor)
        )
        (case (call .node-rule-syntax rule)
          (call walk-style-rule member rule saved-floor)
        )
        (case .node-content-block
          (call walk-root-values member saved-floor)
        )
      )
    )
    (= owner-decl saved-owner)
  )
  (fn-do _ walk-rule _
    (param rule SyntaxId)
    (param expr SyntaxId)
    (param body SyntaxId)
    (param saved-floor U32)
    ; A rule of a class is bound as the value of a property is: under the class, in a scope of
    ; its own, what it reads and then its body.
    (let first (. bindings slots length))
    (= value-floor (as (. names length) U32))
    (call push-scope .scope-function rule)
    (call declare-self)
    (call walk expr)
    (call walk body)
    (call pop-scope)
    (= value-floor saved-floor)
    (call note-window rule first)
  )
  (fn-do _ walk-trigger _
    (param id SyntaxId)
    (param rule ASTWheneverRule)
    (param saved-floor U32)
    ; A `whenever` rule on the markup an object is in is bound as a rule of the class is, with the
    ; changes it names, if any, declared first as a local of its body.
    (let first (. bindings slots length))
    (= value-floor (as (. names length) U32))
    (call push-scope .scope-function id)
    (call declare-self)
    (for (in arg ([] (. tree children) (. rule args)))
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (call declare-pattern (. row pattern) .slot-local (. SlotFlag slot-constant) 0)
        )
      )
    )
    (call walk (. rule body))
    (call pop-scope)
    (= value-floor saved-floor)
    (call note-window id first)
  )
  (fn-do _ walk-style-rule _
    (param id SyntaxId)
    (param rule ASTRule)
    (param saved-floor U32)
    ; A style rule is bound as a rule of the class is: under the class, in a scope of its own, the
    ; values it takes as arguments, the values it gives the rules it applies, then the value of
    ; each line of its body that declares one, those of each `when` (`walk-style-when`), each
    ; rule written in it (`walk-rule-body`), and the function of each line that generates content
    ; (`walk-content`). What a line names is a property of a style, which no scope holds.
    (let first (. bindings slots length))
    (= value-floor (as (. names length) U32))
    (call push-scope .scope-function id)
    (call walk-rule-body id rule first)
    (call pop-scope)
    (= value-floor saved-floor)
    (call note-window id first)
  )
  (fn-do _ walk-rule-body _
    (param id SyntaxId)
    (param rule ASTRule)
    (param first Size)
    ; Binds a style rule in the scope opened for it, as `walk-style-rule` says. A rule written in
    ; its body, or in that of one of its `when`s, is bound in a scope of its own under it, so that
    ; it reads the values the rules around it take, which its window holds from `first` on. A line
    ; of its own body whose value reads something tracked is given again by a function of its own,
    ; as an attribute of a markup element is (`walk-attribute`).
    (call declare-self)
    (for (in arg ([] (. tree children) (. rule args)))
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (call declare-pattern (. row pattern) .slot-argument 0 0)
        )
      )
    )
    (+= styled-depth 1)
    (for (in application ([] (. tree children) (. rule style-rule-applications)))
      (match? ([] (. tree nodes) application)
        (case (call .node-style-rule-application applied)
          (for (in value ([] (. tree children) (. applied args)))
            (call walk value)
          )
        )
      )
    )
    (match? ([] (. tree nodes) (. rule body))
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign line)
              (call walk (. line rhs))
              (if (call is-live statement)
                (call walk-attribute statement)
              )
            )
            (case (call .node-style-when when)
              (call walk-style-when (. when body) first)
            )
            (case (call .node-rule-syntax nested)
              (call walk-nested-rule statement nested first)
            )
            (case .node-markup
              (call walk-content statement)
            )
          )
        )
      )
    )
    (-= styled-depth 1)
  )
  (fn-do _ walk-nested-rule _
    (param id SyntaxId)
    (param rule ASTRule)
    (param first Size)
    (call push-scope .scope-block id)
    (call walk-rule-body id rule first)
    (call pop-scope)
    (call note-window id first)
  )
  (fn-do _ walk-style-when _
    (param body SyntaxId)
    (param first Size)
    ; The body of a `when` in a style rule is bound with the rule: the values it gives the rules it
    ; applies, the value of each line that declares one, each rule written in it
    ; (`walk-nested-rule`), and the function of each line that generates content (`walk-content`).
    (match? ([] (. tree nodes) body)
      (case (call .node-assign line)
        (call walk (. line rhs))
      )
      (case (call .node-rule-syntax nested)
        (call walk-nested-rule body nested first)
      )
      (case .node-markup
        (call walk-content body)
      )
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign line)
              (call walk (. line rhs))
            )
            (case (call .node-style-rule-application applied)
              (for (in value ([] (. tree children) (. applied args)))
                (call walk value)
              )
            )
            (case (call .node-rule-syntax nested)
              (call walk-nested-rule statement nested first)
            )
            (case .node-markup
              (call walk-content statement)
            )
          )
        )
      )
    )
  )
  (fn-do _ walk-content _
    (param element SyntaxId)
    ; The function that builds the content a line of a style rule generates, a markup element that
    ; binds a slot: the element, made and given its content in a scope of its own, which captures
    ; like a lambda, with no batch of markup kept where it is written. A markup line that binds no
    ; slot generates nothing.
    (if (not (call is-slot-builder element))
      (return)
    )
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (call push-scope .scope-nested element)
        (+= function-depth 1)
        (call open-nested element)
        (call walk-markup element (. row id) (. row type-id) (. row body))
        (call close-nested)
        (-= function-depth 1)
        (call pop-scope)
      )
    )
  )
  (fn-do _ walk-root-values _
    (param content SyntaxId)
    (param saved-floor U32)
    ; The values a root `<This` gives properties of its class are the first values of those
    ; properties, each bound as the value a property is declared with is: under the class, in a
    ; scope of its own, at the line that gives it. So are the values it gives the style rules it
    ; applies, which its constructor evaluates, at the application that gives them.
    (match? ([] (. tree nodes) (call (. tree root-this) content))
      (case (call .node-markup root)
        (for (in application ([] (. tree children) (. root style-rule-applications)))
          (match? ([] (. tree nodes) application)
            (case (call .node-style-rule-application applied)
              (if (!= (. applied args count) 0)
                (let first (. bindings slots length))
                (= value-floor (as (. names length) U32))
                (call push-scope .scope-function application)
                (call declare-self)
                (for (in value ([] (. tree children) (. applied args)))
                  (call walk value)
                )
                (call pop-scope)
                (= value-floor saved-floor)
                (call note-window application first)
              )
            )
          )
        )
        (match? ([] (. tree nodes) (. root body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (let first (. bindings slots length))
                  (= value-floor (as (. names length) U32))
                  (call push-scope .scope-function statement)
                  (call declare-self)
                  (+= styled-depth 1)
                  (call walk (. attribute rhs))
                  (-= styled-depth 1)
                  (call pop-scope)
                  (= value-floor saved-floor)
                  (call note-window statement first)
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ note-window _
    (param property SyntaxId)
    (param first Size)
    ; Keeps which locals the value of a property declared, so that the value is typed with
    ; those alone.
    (let count (- (. bindings slots length) first))
    (if (!= count 0)
      (call (. bindings windows append) (call SlotWindow property (call (of RowRange Slot) (as first U32) (as count U32))))
    )
  )
  (fn-expr _ decl-for-syntax DeclId
    (param syntax SyntaxId)
    (?? ([] type-index (/or/ (/lshift/ (as module U64) 32) syntax)) 0)
  )
  (fn-do _ predeclare-lazies Void
    (param statements (of RowRange SyntaxId))
    (param raises Bool (= true))
    (param names Bool (= true))
    ; Declares the lazy locals of a block before its statements are walked. Those of a block that is
    ; one of the statements are declared with them, so the statements beside that block read them. A
    ; match declares only an action's own for its arms. A block that `names` declares the names its
    ; markup elements are given, and those of its slot outlets, which hold the nodes they mount.
    (for (in statement ([] (. tree children) statements))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (if (and (. row is-lazy) (== (call (. row-getters find) statement) null))
            (call declare-pattern (. row left) .slot-lazy 0 statement)
          )
        )
        (case (call .node-block row)
          (if raises
            (call raise-lazies statement (. row body))
          )
        )
        (case .node-markup
          (if names
            (call declare-ids statement)
          )
        )
        (case (call .node-slot-outlet row)
          (if (and names (!= (. row name) 0))
            (call declare-pattern (. row name) .slot-local 0 statement)
            (call place-element statement)
          )
        )
      )
    )
  )
  (fn-do _ declare-ids Void
    (param element SyntaxId)
    ; Declares the name a markup element is given, and those of the elements and slot outlets
    ; written as lines of its body, as locals of the block the outermost is a statement of, so every
    ; statement of the block reaches the name. A block that runs as content each time makes each
    ; such element where it starts (`raise-elements`); any other makes it where the statement that
    ; writes it runs, or where a statement above reads its name first. A slot outlet's name holds the
    ; node it mounts once it is mounted.
    ; An element under an `if` or a `for` written as a line is not reached: its name is the business
    ; of the body it is in.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (!= (. row id) 0)
          (call declare-pattern (. row id) .slot-local 0 element)
        )
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (call declare-ids statement)
            )
          )
        )
      )
      (case (call .node-slot-outlet row)
        (if (!= (. row name) 0)
          (call declare-pattern (. row name) .slot-local 0 element)
          (call place-element element)
        )
      )
    )
  )
  (fn-do _ raise-elements Void
    (param statements (of RowRange SyntaxId))
    ; Walks, where a block of markup content starts, what makes the object of each markup element
    ; the block declares a name for: its type, its arguments and the values of its attributes, in
    ; the order the elements are written. These objects are made there, before any line of the
    ; block, so a local the block declares is not in reach of them, and neither are the members of
    ; an element they are written in. The local of each such name is marked `slot-raised`, which
    ; tells the type pass to make the object there too.
    (for (in statement ([] (. tree children) statements))
      (call raise-element statement true true)
    )
  )
  (fn-do _ place-elements Void
    (param statements (of RowRange SyntaxId))
    ; Marks, where a block of statements starts, the markup elements among them that are made
    ; where they are written (`place-element`). What makes the object of each other element the
    ; block declares a name for is walked where the statement that writes it is, so the locals
    ; declared above it are in reach of it.
    (for (in statement ([] (. tree children) statements))
      (call raise-element statement false)
    )
  )
  (fn-do _ raise-element Void
    (param element SyntaxId)
    (param raises Bool (= true))
    (param starts Bool (= false))
    (if (call is-slot-builder element)
      (call place-element element)
      (return)
    )
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (and (call hosts-slots (. row type-id)) (call supplies-slots element))
          (call place-element element)
          (return)
        )
        (if (and raises (!= (. row id) 0))
          (+= branch-depth 1)
          (call walk-made element (. row id) (. row body))
          (-= branch-depth 1)
          (+= raised-elements element)
          (let resolution (call (. bindings resolution-of) binding (. row id)))
          (if (and starts (== (. resolution kind) .resolve-slot))
            (call (. bindings mark-slot) (. resolution slot) (. SlotFlag slot-raised))
          )
        )
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (call raise-element statement raises starts)
            )
          )
        )
      )
    )
  )
  (fn-do _ walk-markup Void
    (param element SyntaxId)
    (param name SyntaxId)
    (param type SyntaxId)
    (param body SyntaxId)
    ; A markup element: what makes its object, unless `raise-element` walked it already, the
    ; function that gives its name the object where its body gives slots content, and then the
    ; content of its body, or the function that builds it where it is the default slot's
    ; (`walk-wrapped`). One written with a name in a nested function captures the receiver, whose
    ; property of the name it may give the object.
    (+= branch-depth 1)
    (if (and (!= name 0) (!= function-depth 0))
      (call hold-self)
    )
    (if (== (call (. raised-elements find) element) null)
      (if (and (!= name 0) (== (call (. placed-elements find) element) null))
        (call note-borrowed name)
        (else-if (!= name 0)
          (call hold-placed name)
        )
      )
      (call walk-made element name body)
    )
    (if (and (!= name 0) (call is-binder name))
      (call walk-binder name)
    )
    (if (and (!= body 0) (call is-slot-builder body))
      (call walk-wrapped body)
      (call walk-element element type body true)
      (else
        (call walk-element element type body)
      )
    )
    (-= branch-depth 1)
  )
  (fn-do _ hold-placed Void
    (param name SyntaxId)
    ; The name of a placed markup element is given the element's object where it is written,
    ; which a function written in the one that declares the name, such as the one that builds a
    ; slot, does through what it captures.
    (let text (call (. tree identifier-name) name))
    (let position (only-if (call lookup-position text) (if text)))
    (if position
      (call use-slot ([] name-slots position) ([] name-depths position) (. ResolutionFlag resolution-write))
    )
  )
  (fn-do _ is-binder Bool
    (param name SyntaxId)
    ; Whether the name of a markup element is where the function that gives it the element's
    ; object is written.
    (let decl (call nested-decl-for name))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .binder-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-binder Void
    (param name SyntaxId)
    ; The function a markup element whose body gives slots content gives its constructor, which
    ; gives the element's name the object before the markup of its class runs: it captures the
    ; local the name declares, and assigns it, and the receiver, whose property of the name it
    ; may give the object too.
    (call push-scope .scope-nested name)
    (+= function-depth 1)
    (call open-nested name)
    (call hold-placed name)
    (call hold-self)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-expr _ names-markup Bool
    (param slot SlotId)
    ; Whether a local is declared for the name of a markup element.
    (and (!= group 0) (is ([] (. tree nodes) group) .node-markup))
    (where
      (lazy group (. ([] (. bindings slots) slot) group))
    )
  )
  (fn-do _ hold-self Void
    ; Captures the receiver where there is one, in a function that may store in its property.
    (let position (call lookup-position this-name))
    (if position
      (call use-slot ([] name-slots position) ([] name-depths position) 0)
    )
  )
  (fn-do _ place-element Void
    (param element SyntaxId)
    ; A markup element that is made where it is written, which no block makes where it starts: one
    ; that gives slots of its class content (`supplies-slots`), and with it every element written as
    ; a line of its body, one built as what an element gives a slot, and one among the lines of a
    ; class's markup that give the default slot of the class above (`declare-wrapped`); and a slot
    ; outlet, whose node is mounted where it is written. The local declared for its name is marked,
    ; and is given the object there.
    (match? ([] (. tree nodes) element)
      (case (call .node-slot-outlet row)
        (let resolution (call (. bindings resolution-of) binding (. row name)))
        (if (== (. resolution kind) .resolve-slot)
          (call (. bindings mark-slot) (. resolution slot) (. SlotFlag slot-placed))
        )
      )
      (case (call .node-markup row)
        (if (!= (. row id) 0)
          (+= placed-elements element)
          (let resolution (call (. bindings resolution-of) binding (. row id)))
          (if (== (. resolution kind) .resolve-slot)
            (call (. bindings mark-slot) (. resolution slot) (. SlotFlag slot-placed))
          )
        )
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (call place-element statement)
            )
          )
        )
      )
    )
  )
  (fn-do _ hosts-slots Bool
    (param type SyntaxId)
    ; Whether the class a markup element names by its type, as the binder can name it, or one
    ; it derives from writes markup that holds a slot outlet or forwards a slot.
    (let class (call class-written module tree type))
    (let depth 0)
    (while (and class (<= depth member-chain-limit))
      (let owner ([] (. program modules) (. class module)))
      (let next (? DeclRef) null)
      (match? ([] (. owner decls) (. class decl))
        (case (call .decl-class row)
          (if (!= (. row content) 0)
            (for (in node (..< (call (. owner tree subtree-start) (. row content)) (. row content)))
              (if (or (is ([] (. owner tree nodes) node) .node-slot-outlet) forwards)
                (return true)
              )
              (lazy forwards (is ([] (. owner tree nodes) node) .node-markup-slot-forward))
            )
          )
          (if (!= (. row base) 0)
            (= next (call class-written (. class module) (. owner tree) (. row base)))
          )
        )
      )
      (= class next)
      (+= depth 1)
    )
    (return false)
  )
  (fn-do _ supplies-slots Bool
    (param element SyntaxId)
    ; Whether a markup element's body gives slots of its class content: a line bound to a slot by
    ; name, or what the module builder took for the default slot, which a function of its own
    ; builds. An element that gives none is made as any other is, its lines content of its object.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (call is-slot-builder (. row body))
          (return true)
        )
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in line ([] (. tree children) (. block body)))
              (if (or (call is-slot-builder line) (and (not (call gives-default line)) (not line-assigns)))
                (return true)
              )
              (lazy line-assigns (is ([] (. tree nodes) line) .node-assign))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ is-slot-builder Bool
    (param id SyntaxId)
    ; Whether a markup element is built by a function of its own, as what it binds a slot to.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .slot-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-slot Void
    (param element SyntaxId)
    (param name SyntaxId)
    (param type SyntaxId)
    (param body SyntaxId)
    ; The function that builds what a markup element gives a slot of the element whose body it is a
    ; line of: the element itself, made and given its content in a scope of its own, or the value
    ; the one line that gives the default slot content is, which captures like a lambda. It is built
    ; before that element's own content is written, so no name read there is a member of that
    ; element: the element is no receiver of it, though one around that element still is. The item a
    ; slot that repeats gives each row is its argument, by the name the element writes for it and by
    ; `each` and `it`. A name nothing declares in what such a slot is given is not reported: the
    ; type pass declines it. An element written with a name captures the receiver, whose property
    ; of the name it may give the object. It captures the local that keeps the batch in force where
    ; the element is written (`keep-root`).
    (let held (. receiver-decls length))
    (let outer-module (if-expr (!= held 0) ([] receiver-modules (- held 1)) module))
    (let outer-decl (if-expr (!= held 0) ([] receiver-decls (- held 1)) 0u32))
    (let outer-mark (if-expr (!= held 0) ([] receiver-marks (- held 1)) 0))
    (let outer-element (if-expr (!= held 0) ([] receiver-elements (- held 1)) 0u32))
    (let outer-depth (if-expr (!= held 0) ([] receiver-depths (- held 1)) 0u32))
    (let outer-scope (if-expr (!= held 0) ([] receiver-scopes (- held 1)) current-scope))
    (if (!= held 0)
      (call (. receiver-modules pop))
      (call (. receiver-decls pop))
      (call (. receiver-marks pop))
      (call (. receiver-elements pop))
      (call (. receiver-depths pop))
      (call (. receiver-scopes pop))
    )
    (let root (call keep-root element))
    (call push-scope .scope-nested element)
    (+= function-depth 1)
    (call open-nested element)
    (call record-capture root (call slot-depth root) false)
    (let repeats false)
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (match? ([] (. tree nodes) (. row slot-parameter))
          (case (call .node-markup-slot-parameter parameter)
            (call declare-pattern (. parameter name) .slot-argument 0 0)
            (let given (. (call (. bindings resolution-of) binding (. parameter name)) slot))
            (call (. bindings set-resolution)
              (block
                (arg binding)
                (arg (. row slot-parameter))
                (arg (call Resolution .resolve-slot 0 given 0 0))
              )
            )
            (if (!= (. ([] (. bindings slots) given) name) each-name)
              (call alias each-name given)
            )
            (call alias it-name given)
            (= repeats true)
          )
        )
      )
    )
    (if repeats
      (+= repeating-depth 1)
    )
    (if (!= name 0)
      (call hold-self)
    )
    (if (is ([] (. tree nodes) element) .node-markup)
      (call walk-markup element name type body)
      (else
        (call walk element)
      )
    )
    (if repeats
      (-= repeating-depth 1)
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
    (if (!= held 0)
      (+= receiver-modules outer-module)
      (+= receiver-decls outer-decl)
      (+= receiver-marks outer-mark)
      (+= receiver-elements outer-element)
      (+= receiver-depths outer-depth)
      (+= receiver-scopes outer-scope)
    )
  )
  (fn-do _ walk-outlet Void
    (param name SyntaxId)
    (param parameter SyntaxId)
    (param rules (of RowRange SyntaxId))
    (param body SyntaxId)
    ; A slot outlet of the markup written in a class: the function that builds its slot, which a
    ; nested function the outlet is written in captures from the function that fills the object
    ; (`builder-of`), the value it gives that function where the slot repeats, the values given the
    ; style rules it applies, then the lines of its body. A line that assigns gives the node the
    ; outlet mounts a property, read in the scope the outlet is written in, with the function that
    ; gives it again where it has one, as an attribute of an element is; the others are the content
    ; the outlet mounts where it is given none, written in a block of their own.
    (if (and fills (!= function-depth 0))
      (let text (call (. program store-atom) ""))
      (if (!= name 0)
        (= text (?? (call (. tree identifier-name) name) text))
      )
      (call use-slot (call builder-of text) 0 0)
    )
    (match? ([] (. tree nodes) parameter)
      (case (call .node-markup-slot-parameter row)
        (call walk (. row name))
      )
    )
    (for (in rule ([] (. tree children) rules))
      (match? ([] (. tree nodes) rule)
        (case (call .node-style-rule-application applied)
          (+= styled-depth 1)
          (for (in value ([] (. tree children) (. applied args)))
            (call walk value)
          )
          (-= styled-depth 1)
        )
      )
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (+= styled-depth 1)
              (call walk (. attribute rhs))
              (-= styled-depth 1)
              (call walk-attribute statement)
            )
          )
        )
        (call push-scope .scope-block body)
        (call predeclare-lazies (. block body))
        (call raise-elements (. block body))
        (let lazies-end (as (. names length) U32))
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (not (call (. tree is-finally) statement)) (not (is ([] (. tree nodes) statement) .node-assign)))
            (call walk-statement statement false lazies-end)
          )
        )
        (for (in statement ([] (. tree children) (. block body)))
          (if (call (. tree is-finally) statement)
            (call walk statement)
          )
        )
        (call pop-scope)
      )
    )
  )
  (fn-do _ walk-outlet-arm Void
    (param id SyntaxId)
    (param name SyntaxId)
    (param rules (of RowRange SyntaxId))
    (param body SyntaxId)
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let batch
      (scope (as (call (. bindings slots append) batch-slot) SlotId)
        (lazy batch-slot (call Slot .slot-local batch-root-name id current-scope decl 0 kept))
      )
    )
    (+= branch-depth 1)
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call record-capture batch (call slot-depth batch) false)
    (if (!= name 0)
      (call hold-placed name)
    )
    (let arm
      (scope (as (call (. bindings slots append) arm-slot) SlotId)
        (lazy arm-slot (call Slot .slot-argument branch-parent-name id current-scope decl 0 constant))
        (lazy constant (. SlotFlag slot-constant))
      )
    )
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg id)
        (arg (call Resolution .resolve-slot 0 arm 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (call walk-outlet name 0 rules body)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
    (-= branch-depth 1)
  )
  (fn-do _ walk-outlet-region Void
    (param id SyntaxId)
    (param name SyntaxId)
    (param parameter SyntaxId)
    (param rules (of RowRange SyntaxId))
    (param body SyntaxId)
    ; A slot outlet that is a markup branch region of one arm: the name its parameter gives is read
    ; where the outlet is written, to select the arm, and the outlet is built by a function of its
    ; own, written at it, which reads the name again with what it captures of what the name reads.
    ; The host, the region and the batch in force are kept in three locals no name reaches, declared
    ; at the parameter, as those of a match region are (`walk-match-region`); the function that
    ; selects the arm again, written at the parameter, captures them with what the name reads.
    (let given SyntaxId 0)
    (match? ([] (. tree nodes) parameter)
      (case (call .node-markup-slot-parameter row)
        (= given (. row name))
      )
    )
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let host
      (scope (as (call (. bindings slots append) host-slot) SlotId)
        (lazy host-slot (call Slot .slot-local branch-host-name parameter current-scope decl 0 kept))
      )
    )
    (call (. bindings slots append)
      (block
        (arg (call Slot .slot-local branch-region-name parameter current-scope decl 0 kept))
      )
    )
    (call (. bindings slots append) (call Slot .slot-local batch-root-name parameter current-scope decl 0 kept))
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg parameter)
        (arg (call Resolution .resolve-slot 0 host 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (call walk given)
    (let read (list SlotId))
    (call note-reads given read true)
    (+= branch-depth 1)
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call record-capture (+ host 2) (call slot-depth (+ host 2)) false)
    (for (in slot read)
      (call (. bindings mark-slot) slot (. SlotFlag slot-captured))
      (call record-capture slot (call slot-depth slot) (== (. ([] (. bindings slots) slot) kind) .slot-this))
    )
    (let arm
      (scope (as (call (. bindings slots append) arm-slot) SlotId)
        (lazy arm-slot (call Slot .slot-argument branch-parent-name id current-scope decl 0 constant))
        (lazy constant (. SlotFlag slot-constant))
      )
    )
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg id)
        (arg (call Resolution .resolve-slot 0 arm 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (call walk-outlet name 0 rules body)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
    (-= branch-depth 1)
    (let slots (list SlotId))
    (+= slots host)
    (+= slots (+ host 1))
    (call note-reads given slots true)
    (call capture-in parameter slots)
  )
  (fn-do _ walk-made Void
    (param element SyntaxId)
    (param name SyntaxId)
    (param body SyntaxId)
    ; What makes the object of a markup element: its type, its arguments, the values of the style
    ; rules it applies, and the values of the attributes its body gives it, which are read in the
    ; scope outside the element, each value with the function that gives it again where it has one.
    ; The condition a style rule is applied under reads a member of the element before a name of the
    ; scope outside, and is tested again by a function of its own (`walk-gates`). The slot an
    ; element binds, and the parameter it names for a slot, are names of the class it is content of,
    ; and no reads.
    (let bound SyntaxId 0)
    (let parameter SyntaxId 0)
    (let type SyntaxId 0)
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (= bound (. row slot-binding))
        (= parameter (. row slot-parameter))
        (= type (. row type-id))
      )
    )
    (let class (call class-written module tree type))
    (for (in child (call (. tree children-of) element))
      (if (and (!= child name) (!= child body) (!= child bound) (!= child parameter))
        (match ([] (. tree nodes) child)
          (case (call .node-style-rule-application applied)
            (+= styled-depth 1)
            (for (in value ([] (. tree children) (. applied args)))
              (call walk value)
            )
            (-= styled-depth 1)
            (if (!= (. applied condition) 0)
              (call open-receiver element class)
              (let around condition-level)
              (= condition-level (- (. receiver-decls length) 1))
              (call walk (. applied condition))
              (= condition-level around)
              (call close-receiver)
            )
          )
          (default
            (call walk child)
          )
        )
      )
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (+= styled-depth 1)
              (call walk (. attribute rhs))
              (-= styled-depth 1)
              (call walk-attribute statement)
            )
          )
        )
      )
    )
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (call walk-arguments element (. row args))
        (call walk-gates (. row style-rule-applications))
      )
    )
  )
  (fn-do _ walk-gates Void
    (param applications (of RowRange SyntaxId))
    ; The function that tests again the condition a style rule written on a markup element is
    ; applied under, where it has one: it captures every local, argument and receiver the condition
    ; reads, the list of subscribers of each local it reads tracked, and the element's object where
    ; it reads a member of the element (`keep-received`).
    (for (in application ([] (. tree children) applications))
      (match? ([] (. tree nodes) application)
        (case (call .node-style-rule-application applied)
          (if (and (!= (. applied condition) 0) (call is-gate (. applied condition)))
            (call keep-received (. applied condition))
            (let slots (list SlotId))
            (call note-reads (. applied condition) slots true)
            (call capture-in (. applied condition) slots)
          )
        )
      )
    )
  )
  (fn-do _ is-gate Bool
    (param id SyntaxId)
    ; Whether the nested function declared at a node tests a condition again.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .gate-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-arguments Void
    (param element SyntaxId)
    (param args (of RowRange SyntaxId))
    ; The function that gives again each argument of a markup element, given by position, whose
    ; value read something tracked: the element's object is kept in one local no name reaches,
    ; declared at the element, which each such function captures with every local, argument and
    ; receiver the value reads and the list of subscribers of each local it reads tracked.
    (let held no-slot)
    (for (in arg ([] (. tree children) args))
      (if (not (call is-live arg))
        (continue)
      )
      (if (== held no-slot)
        (= held (call element-keeper element current-scope))
      )
      (call keep-received arg)
      (let slots (list SlotId))
      (+= slots held)
      (call note-reads arg slots true)
      (call capture-in arg slots)
    )
  )
  (fn-do _ is-live Bool
    (param id SyntaxId)
    ; Whether the nested function declared at a node runs it again, as a live statement or an
    ; argument of a markup element whose value reads something tracked.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .live-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-stream Void
    (param id SyntaxId)
    ; The function that writes the value of a stream of a value as it changes, `<#value>`, again
    ; when what it read tracked changes: the channel is kept in a local no name reaches, declared at
    ; the stream, which the function captures with every local, argument and receiver the value
    ; reads and the list of subscribers of each local it reads tracked.
    (if (== (call nested-decl-for id) 0)
      (return)
    )
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let held
      (scope (as (call (. bindings slots append) channel-slot) SlotId)
        (lazy channel-slot (call Slot .slot-local channel-name id current-scope decl 0 kept))
      )
    )
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg id)
        (arg (call Resolution .resolve-slot 0 held 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (let slots (list SlotId))
    (+= slots held)
    (call note-reads id slots)
    (call capture-in id slots)
  )
  (fn-do _ walk-attribute Void
    (param statement SyntaxId)
    ; The function that gives an attribute of a markup element its value again when what the value
    ; read tracked changes, or a line of its body that gives content the element takes again: the
    ; element's object is kept in a local no name reaches, declared at the line, which the function
    ; captures with every local, argument and receiver the value reads and the list of subscribers
    ; of each local it reads tracked. A line that gives content, to the element or to the region an
    ; arm of which it is written in, keeps in the next such local what that took, which the function
    ; replaces. Such a line may be a name alone, as `#child` is, whose node resolves the name: the
    ; line resolves to neither local, they are found by their names where they are declared, and
    ; what the line itself reads is captured too.
    (if (== (call nested-decl-for statement) 0)
      (return)
    )
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let held
      (scope (as (call (. bindings slots append) element-slot) SlotId)
        (lazy element-slot (call Slot .slot-local element-name statement current-scope decl 0 kept))
      )
    )
    (let gives (call (. tree content-line) statement))
    (if (not gives)
      (let declares (. ResolutionFlag resolution-declares))
      (call (. bindings set-resolution) binding statement (call Resolution .resolve-slot 0 held 0 declares))
    )
    (call keep-received statement)
    (let slots (list SlotId))
    (+= slots held)
    (if gives
      (let replaced (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-assigned)))
      (+= slots
        (scope (as (call (. bindings slots append) prior) SlotId)
          (lazy prior (call Slot .slot-local previous-name statement current-scope decl 0 replaced))
        )
      )
    )
    (call note-reads statement slots gives)
    (call capture-in statement slots)
    (match? ([] (. tree nodes) statement)
      (case (call .node-assign row)
        (if (and (== (. row op) .bind-op) (!= (call nested-decl-for (. row lhs)) 0))
          (let written (call (. bindings resolution-of) binding (. row rhs)))
          (if (== (. written kind) .resolve-slot)
            (call (. bindings mark-slot) (. written slot) (. SlotFlag slot-assigned))
          )
          (call capture-in (. row lhs) slots)
        )
      )
    )
  )
  (fn-do _ keep-received Void
    (param id SyntaxId)
    ; Gives each name under a node that reads a member of a markup element by its name alone, where
    ; the element's body is written and not in a function of its own, the local that keeps that
    ; element's object (`element-keeper`), where the element is not written under the node: the
    ; function that gives the node again reads the member from that object, which it captures, as a
    ; function written in the element's body does (`receiver-keeper`).
    (let start (call (. tree subtree-start) id))
    (for (in node (.. start id))
      (let found ([] received-reads node))
      (if (not found)
        (continue)
      )
      (let element ([] received-elements found))
      (let resolution (call (. bindings resolution-of) binding node))
      (if (and (== (. resolution slot) no-slot) (or (< element start) (> element id)))
        (let held (call element-keeper element ([] received-scopes found)))
        (call (. bindings set-resolution)
          (block
            (arg binding)
            (arg node)
            (arg
              (call Resolution
                (block
                  (arg (. resolution kind))
                  (arg (. resolution module))
                  (arg held)
                  (arg (. resolution decl))
                  (arg (. resolution flags))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ note-borrowed Void
    (param id SyntaxId)
    ; The name of a markup element that no block declares: where something else in reach declared
    ; the name, that thing's value is taken for the element's object. What the name finds is kept
    ; for the type pass, and nothing is reported where it finds nothing.
    (let name (call (. tree identifier-name) id))
    (if (not name)
      (return)
    )
    (let position (call lookup-position name))
    (if (and (!= (. receiver-decls length) 0) (!= (call received-level name position) null))
      (let received (. ResolutionFlag resolution-received))
      (call (. bindings set-resolution) binding id (call Resolution .resolve-unresolved 0 no-slot 0 received))
      (return)
    )
    (if position
      (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 ([] name-slots position) 0 0))
      (return)
    )
    (= outer-uses-self false)
    (let outer (call resolve-outer name))
    (if (!= (. outer kind) .resolve-unresolved)
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg id)
          (arg (call Resolution (. outer kind) (. outer module) (. outer slot) (. outer decl) 0))
        )
      )
    )
  )
  (fn-do _ note-content Void
    (param statements (of RowRange SyntaxId))
    ; The lines of a markup element's body, or of a body that runs as one. Each body such a line
    ; runs as content is content each time it runs (`content-turns`): every arm of an `if`, every
    ; arm of a markup match region, which a function of its own builds, every arm of any other match
    ; or table whose arms run as content (`content-arms`), and the body of a `for`, or
    ; of a loop written with `in` that is no function of its own. Such a body declares the names of
    ; the elements written in it, and makes them where it starts (`raise-elements`), which the type
    ; pass reads from the names' locals (`slot-raised`). A handler's body runs where its stream
    ; gives a value, which is no content. The body of a markup loop region builds a row, which is no
    ; content, but where the row is a region of its own (`row-region`), whose function runs the body
    ; as content each turn.
    (for (in statement ([] (. tree children) statements))
      (call note-content-line statement)
    )
  )
  (fn-do _ note-content-line Void
    (param statement SyntaxId)
    (match? ([] (. tree nodes) statement)
      (case .node-if-block
        (let branch statement)
        (while (!= branch 0)
          (let next SyntaxId 0)
          (match? ([] (. tree nodes) branch)
            (case (call .node-if-block row)
              (+= content-turns (call (. tree arm-body) branch))
              (= next (. row next))
            )
          )
          (= branch next)
        )
      )
      (case .node-match-expression
        (if (call is-branch statement)
          (for (in arm (call (. tree region-arms) statement))
            (+= content-turns (call (. tree region-arm-body) arm))
          )
          (else
            (for (in body (call (. tree content-arms) statement))
              (+= content-turns body)
            )
          )
        )
      )
      (case .node-structure-match
        (for (in body (call (. tree content-arms) statement))
          (+= content-turns body)
        )
      )
      (case (call .node-for-block row)
        (if (and (not (call (. tree is-subscriber-loop) (. row loop))) (or (not (call is-loop-region statement)) (call (. tree row-region) (. row body))))
          (+= content-turns (. row body))
        )
      )
      (case (call .node-iterator-expression row)
        (if (== (call nested-decl-for statement) 0)
          (+= content-turns (. row body))
        )
      )
    )
  )
  (fn-do _ raise-lazies Void
    (param block SyntaxId)
    (param statements (of RowRange SyntaxId))
    (for (in statement ([] (. tree children) statements))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (if (and (. row is-lazy) (not (. row is-scoped)) (== (call (. row-getters find) statement) null))
            (call declare-pattern (. row left) .slot-lazy 0 statement)
            (+= raised-homes block)
          )
        )
      )
    )
  )
  (fn-do _ declare-scoped Void
    (param statements (of RowRange SyntaxId))
    ; Declares the lazy locals a block keeps to itself, where the rest were declared with the block
    ; around it: the value a call's guards test, which each call's own block names `it`.
    (for (in statement ([] (. tree children) statements))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (if (and (. row is-lazy) (. row is-scoped))
            (call declare-pattern (. row left) .slot-lazy 0 statement)
          )
        )
      )
    )
  )
  (fn-do _ is-constructor-body Bool
    (param id SyntaxId)
    ; Whether a block is the body of a constructor of a type, which gives the object it makes: a
    ; constructor that is a rule makes none, and its lazy declarations are its rules.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return
          (scope (and owned-body (== (. fn kind) .constructor-decl) (== (call rule-match program module decl) 0))
            (lazy owned-body (and (!= owner-decl 0) (== (. fn body) id)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ mark-initializers Void
    (param statements (of RowRange SyntaxId))
    ; A lazy declaration in a constructor that names a property of the owner gives the property its
    ; value. That value is declared as a local at the property.
    (let target ([] (. program modules) module))
    (for (in statement ([] (. tree children) statements))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (let name (only-if (call declared-name (. row left)) (if (. row is-lazy))))
          (let slot (only-if (call lookup-slot name) (if name)))
          (let member (only-if (call member-of module owner-decl (!! name) 0) (if slot)))
          (if (and member (== (. member module) module))
            (match? ([] (. target decls) (. member decl))
              (case (call .decl-property property)
                (= (. ([] (. bindings slots) (!! slot)) property) (. property syntax))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ hide-initializers Void
    (param statements (of RowRange SyntaxId))
    ; A lazy declaration in a constructor that builds its own class and names a field of it, its
    ; own or a base's, is the field's initializer, which runs before the body. The body reads and
    ; writes the field itself, so the local is in reach only of the values of such declarations.
    (for (in statement ([] (. tree children) statements))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (let name (only-if (call declared-name (. row left)) (if (. row is-lazy))))
          (let position (only-if (call lookup-position name) (if name)))
          (if (and position (call names-field (!! name)))
            (+= initializer-positions (as position U32))
          )
        )
      )
    )
    (call reach-initializers false)
  )
  (fn-do _ names-field Bool
    (param name Atom)
    (let member (call member-of module owner-decl name 0))
    (if member
      (match? ([] (. ([] (. program modules) (. member module)) decls) (. member decl))
        (case .decl-property
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ reach-initializers Void
    (param shown Bool)
    (for (in position initializer-positions)
      (= ([] latest-names ([] names position)) (if-expr shown position ([] name-links position)))
    )
  )
  (fn-do _ declare-capture _
    (param id SyntaxId)
    ; A name a grammar captures. A match keeps one slot for each name, which every place that
    ; captures the name fills. No capture is named `it`, which an action reads for what its arm
    ; matched.
    (let name (call (. tree identifier-name) id))
    (if (and name (== (. name text) "it"))
      (let message
        (paragraph
          "A capture cannot be named \"it\", which names what the arm matched; choose another name"
        )
      )
      (call (. bindings diagnostics append) (call Diagnostic module id .stated (call (. program store-atom) message)))
    )
    (let position (only-if (call lookup-position name) (if name)))
    (if (and position (>= position capture-floor) (== (. ([] (. bindings slots) ([] name-slots position)) kind) .slot-pattern))
      (let declares U32 (. ResolutionFlag resolution-declares))
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg id)
          (arg (call Resolution .resolve-slot 0 ([] name-slots position) 0 declares))
        )
      )
      (return)
    )
    (call declare-pattern id .slot-pattern (. SlotFlag slot-constant) 0)
    (if name
      (= ([] stream-captures (. (call (. bindings resolution-of) binding id) slot)) true)
    )
  )
  (fn-do _ hoist-lazies Void
    (param id SyntaxId)
    ; The lazy locals of a pattern's actions are declared where the match is, in reach of every
    ; arm's pattern and action.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (call hoist-lazies (. row pattern))
        (match? ([] (. tree nodes) (. row right))
          (case (call .node-block block)
            (call predeclare-lazies (. block body) false)
          )
        )
      )
      (case (call .node-stream-and row)
        (call hoist-lazies (. row left))
        (call hoist-lazies (. row right))
      )
      (case (call .node-stream-or row)
        (call hoist-lazies (. row left))
        (call hoist-lazies (. row right))
      )
      (case (call .node-stream-panic row)
        (call hoist-lazies (. row pattern))
      )
      (case (call .node-stream-capture row)
        (call hoist-lazies (. row pattern))
      )
      (case (call .node-stream-unary row)
        (call hoist-lazies (. row operand))
      )
      (case (call .node-stream-length row)
        (call hoist-lazies (. row operand))
      )
    )
  )
  (fn-do _ walk-element Void
    (param element SyntaxId)
    (param type SyntaxId)
    (param body SyntaxId)
    (param bound Bool (= false))
    ; The content of a markup element's body. A line that assigns is an attribute, walked with
    ; what makes the element's object. The other lines are the element's content, which read the
    ; scope outside the element, as its attributes do, but for the event a handler subscribes to,
    ; which is the element's or one it is in, as `received-level` says,
    ; each with the function that gives it again where it has one, as an attribute has. The names
    ; of the elements among them are declared by a block around this one. Where a function of its
    ; own builds the lines that give the default slot content (`walk-wrapped`), only the content
    ; bound to other slots is walked here (`bound`). A value that gives the default slot content is
    ; walked as what builds it (`walk-slot`).
    (if (== body 0)
      (return)
    )
    (let class (call class-written module tree type))
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (call open-receiver element class)
        (call push-scope .scope-block body)
        (if (not bound)
          (call note-content (. row body))
          (if (== (call (. raised-homes find) body) null)
            (call predeclare-lazies (. row body) true false)
          )
        )
        (let lazies-end (as (. names length) U32))
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not (call (. tree is-finally) statement)) (not assignment) (or (not bound) (not (call gives-default statement))))
            (if (and (not (is ([] (. tree nodes) statement) .node-markup)) (call is-slot-builder statement))
              (call walk-slot statement 0 0 0)
              (else
                (call walk-statement statement false lazies-end)
              )
            )
            (if (call is-live statement)
              (call walk-attribute statement)
            )
          )
          (lazy assignment (is ([] (. tree nodes) statement) .node-assign))
        )
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not bound) (call (. tree is-finally) statement))
            (call walk statement)
          )
        )
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (call (. tree holds-fills) statement) (not (call (. tree fills-only) statement)) (call selects statement))
            (call walk-chosen-fills statement)
          )
        )
        (call pop-scope)
        (call close-receiver)
        (return)
      )
    )
    (call open-receiver element class)
    (call walk body)
    (call close-receiver)
  )
  (fn-do _ gives-default Bool
    (param line SyntaxId)
    ; Whether a line of an element's body is content of the default slot: neither an attribute nor
    ; content bound to a slot.
    (match? ([] (. tree nodes) line)
      (case .node-assign
        (return false)
      )
      (case .node-markup-slot-forward
        (return false)
      )
      (case (call .node-markup row)
        (return (== (. row slot-binding) 0))
      )
    )
    (return (not (call (. tree fills-only) line)))
  )
  (fn-do _ keep-root SlotId
    (param syntax SyntaxId)
    ; The local no name reaches that keeps the batch of markup in force where the function that
    ; builds what a markup element gives a slot is made, declared there, at what the function
    ; builds, which the function captures.
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (return
      (scope (as (call (. bindings slots append) batch-root) SlotId)
        (lazy batch-root (call Slot .slot-local batch-root-name syntax current-scope decl 0 kept))
      )
    )
  )
  (fn-do _ walk-wrapped Void
    (param body SyntaxId)
    ; The lines of a markup element's body that give its class's default slot content, which a
    ; function of its own builds into a node of the slot's type: the function captures like a
    ; lambda, the element is no receiver in it, and those lines are the content of that node
    ; (`gives-default`). The names of the elements among them are declared by a block around the
    ; element. It captures the local that keeps the batch in force where the element is written
    ; (`keep-root`).
    (let root (call keep-root body))
    (call push-scope .scope-nested body)
    (+= function-depth 1)
    (call open-nested body)
    (call record-capture root (call slot-depth root) false)
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (call push-scope .scope-block body)
        (call note-content (. row body))
        (if (== (call (. raised-homes find) body) null)
          (call predeclare-lazies (. row body) true false)
        )
        (let lazies-end (as (. names length) U32))
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not (call (. tree is-finally) statement)) (call gives-default statement))
            (call walk-statement statement false lazies-end)
          )
        )
        (for (in statement ([] (. tree children) (. row body)))
          (if (call (. tree is-finally) statement)
            (call walk statement)
          )
        )
        (call pop-scope)
      )
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ declare-wrapped Void
    (param body SyntaxId)
    ; Declares the names of the elements among the lines of a class's markup that give the default
    ; slot of the class above, in the function that fills the object, as a block around them would
    ; declare them: the function that builds the lines reaches them there. No block of that function
    ; makes them where it starts, so each is made where it is written (`place-element`).
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (call gives-default statement)
            (call declare-ids statement)
            (call place-element statement)
          )
        )
      )
    )
  )
  (fn-do _ walk-bound Void
    (param body SyntaxId)
    ; The lines of a class's markup bound to slots of the class above, where the lines that give its
    ; default slot are built into a node by a function of their own (`walk-wrapped`): each is walked
    ; in the function that fills the object, which holds the function that builds it, as an
    ; element's body walks those it holds (`walk-element`).
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (call push-scope .scope-block body)
        (let lazies-end (as (. names length) U32))
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not (call (. tree is-finally) statement)) (not assignment) (not (call gives-default statement)))
            (call walk-statement statement false lazies-end)
          )
          (lazy assignment (is ([] (. tree nodes) statement) .node-assign))
        )
        (call pop-scope)
      )
    )
  )
  (fn-do _ open-receiver Void
    (param element SyntaxId)
    (param class (? DeclRef))
    ; Opens the body of a markup element, of a class or of none the binder can name, as a level of
    ; receivers, written in the scope and the function in force.
    (+= receiver-modules (if-expr class (. class module) module))
    (+= receiver-decls (if-expr class (. class decl) 0u32))
    (+= receiver-marks (. names length))
    (+= receiver-elements element)
    (+= receiver-depths function-depth)
    (+= receiver-scopes current-scope)
  )
  (fn-do _ close-receiver Void
    ; Closes the innermost level of receivers.
    (call (. receiver-modules pop))
    (call (. receiver-decls pop))
    (call (. receiver-marks pop))
    (call (. receiver-elements pop))
    (call (. receiver-depths pop))
    (call (. receiver-scopes pop))
  )
  (fn-do _ received-level (? Size)
    (param name Atom)
    (param position (? Size))
    (param lowest Size (= 0))
    ; The level of the markup element a name is a member of, the element or one it is in, no lower
    ; than `lowest`, rather than what the scopes give it, or none: it is none where a local the body
    ; itself declares hides the member. The innermost element is asked first. A property the markup
    ; of the element's class declares for an element is hidden there, and the name is asked of what
    ; is around. An element whose class the binder cannot name by its type may hold any member, so
    ; every name asked of it that is no local of the body is taken for one.
    (let level (. receiver-decls length))
    (while (> level lowest)
      (-= level 1)
      (if (and position (>= position ([] receiver-marks level)))
        (return null)
      )
      (if (== ([] receiver-decls level) 0)
        (return level)
      )
      (let member (call member-of ([] receiver-modules level) ([] receiver-decls level) name 0))
      (if (and member (not (call names-element member)))
        (return level)
      )
      (if (and (not member) (call method-of ([] receiver-modules level) ([] receiver-decls level) name 0))
        (return level)
      )
    )
    (return null)
  )
  (fn-do _ receiver-keeper SlotId
    (param level Size)
    ; The local that keeps the object of the markup element at a level of receivers, where a name
    ; of its member is read in a function written in its body, which captures it: the element is
    ; made outside that function, by the one whose content it is, which needs none.
    (if (<= function-depth ([] receiver-depths level))
      (return no-slot)
    )
    (let held (call element-keeper ([] receiver-elements level) ([] receiver-scopes level)))
    (call use-slot held ([] receiver-depths level) 0)
    (return held)
  )
  (fn-do _ element-keeper SlotId
    (param element SyntaxId)
    (param scope ScopeId)
    ; The local no name reaches that keeps the object of a markup element, declared at the element
    ; in the scope it is written in, once: the functions that give its arguments again and those
    ; written in its body that read its members capture it.
    (let resolution (call (. bindings resolution-of) binding element))
    (if (== (. resolution kind) .resolve-slot)
      (return (. resolution slot))
    )
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let held
      (scope (as (call (. bindings slots append) element-slot) SlotId)
        (lazy element-slot (call Slot .slot-local element-name element scope decl 0 kept))
      )
    )
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding element (call Resolution .resolve-slot 0 held 0 declares))
    (return held)
  )
  (fn-do _ names-element Bool
    (param member DeclRef)
    ; Whether a member is the property the markup of its class declares for an element.
    (match? ([] (. ([] (. program modules) (. member module)) decls) (. member decl))
      (case (call .decl-property row)
        (return (!= (. row element) 0))
      )
    )
    (return false)
  )
  (fn-do _ walk-action Void
    (param body SyntaxId)
    ; An action, whose block declares no lazy local of its own: its match declared them. Nothing
    ; after a statement that leaves the block is walked.
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (call push-scope .scope-block body)
        (let dead false)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not dead) (not (call (. tree is-finally) statement)))
            (call walk statement)
          )
          (= dead (or dead (call leaves-block statement)))
        )
        (= dead false)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not dead) (call (. tree is-finally) statement))
            (call walk statement)
          )
          (= dead (or dead (call leaves-block statement)))
        )
        (call pop-scope)
        (return)
      )
    )
    (call walk body)
  )
  (fn-do _ walk-statement Void
    (param statement SyntaxId)
    (param builds Bool)
    (param lazies-end U32)
    ; A statement of a block; in a constructor that builds its own class, a field's initializer
    ; is walked with the other initializers in reach, and with no local the body declared before
    ; it, since it runs before the body.
    (let initializes false)
    (if builds
      (for (in position initializer-positions)
        (if (== (. ([] (. bindings slots) ([] name-slots position)) group) statement)
          (= initializes true)
        )
      )
    )
    (if (not initializes)
      (call walk statement)
      (return)
    )
    (let saved body-names)
    (= body-names (call (of RowRange Atom) lazies-end (- (as (. names length) U32) lazies-end)))
    (call reach-initializers true)
    (call walk statement)
    (call reach-initializers false)
    (= body-names saved)
  )
  (fn-expr _ declared-name (? Atom)
    (param pattern SyntaxId)
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (call (. tree identifier-name) (. row id))
      )
      (default
        (call (. tree identifier-name) pattern)
      )
    )
  )
  (fn-do _ walk Void
    (param id SyntaxId)
    (if (== id 0)
      (return)
    )
    (blank)
    (match ([] (. tree nodes) id)
      (case .node-top-level-syntax
        (call walk-top-level id)
      )
      (case (call .node-block row)
        (call push-scope .scope-block id)
        (let content (!= (call (. content-turns find) id) null))
        (if content
          (call note-content (. row body))
        )
        (if (== (call (. raised-homes find) id) null)
          (call predeclare-lazies (. row body))
          (else
            (call declare-scoped (. row body))
            (for (in statement ([] (. tree children) (. row body)))
              (call declare-ids statement)
            )
          )
        )
        (if content
          (call raise-elements (. row body))
          (else
            (call place-elements (. row body))
          )
        )
        (let builds (and (call is-constructor-body id) (not (call returns-own tree id))))
        (let lazies-end (as (. names length) U32))
        (if (call is-constructor-body id)
          (call mark-initializers (. row body))
        )
        (if builds
          (call hide-initializers (. row body))
        )
        (let given (== id class-lines))
        (let ruled (== id rule-lines))
        (let dead false)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and reached (not given-assign) (not (and ruled (call (. tree rule-part) statement))))
            (if (not content)
              (call raise-element statement)
            )
            (call walk-statement statement builds lazies-end)
            (if (and given (call is-live statement))
              (call walk-attribute statement)
            )
          )
          (lazy reached (and (or (not dead) (call (. tree is-lazy-declare) statement)) (not (call (. tree is-finally) statement))))
          (lazy given-assign (and given (is ([] (. tree nodes) statement) .node-assign)))
          (= dead (or dead (and (not content) (call leaves-block statement))))
        )
        (= dead false)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (not dead) (call (. tree is-finally) statement))
            (call walk statement)
          )
          (= dead (or dead (and (not content) (call leaves-block statement))))
        )
        (if builds
          (call (. initializer-positions clear))
        )
        (call pop-scope)
      )
      (case (call .node-declare row)
        (if (!= (call (. row-getters find) id) null)
          (call walk (. row right))
          (call note-getter-reads id (. row right))
          (call declare-pattern (. row left) .slot-local 0 0)
          (match? ([] (. tree nodes) (. row left))
            (case (call .node-type-capture capture)
              (call (. bindings set-getter) (. (call (. bindings resolution-of) binding (. capture id)) slot) id)
            )
          )
          (else-if (. row is-lazy)
            (let rule (or (. row is-pattern) (is ([] (. tree nodes) (. row right)) .node-stream-match)))
            (let coded
              (scope (and valued-pattern (not (is ([] (. tree nodes) (. row right)) .node-stream-match)))
                (lazy valued-pattern (and (. row is-pattern) (!= (. row right) 0)))
              )
            )
            (let machine (if-expr (not (. row is-pattern)) (call (. tree declared-machine) (. row right)) 0))
            (let named (call (. tree declared-local) (. row left)))
            (+= lazy-depth 1)
            (if rule
              (if (and (== stream-reach 0) (== function-depth 0) (not (call lookup-slot stream-name)))
                (let site (. row left))
                (match? ([] (. tree nodes) (. row left))
                  (case (call .node-type-capture capture)
                    (= site (. capture id))
                  )
                )
                (call (. bindings diagnostics append) (call Diagnostic module site .stream-not-found null))
              )
              (+= stream-reach 1)
              (call push-scope .scope-arm (. row right))
            )
            (if coded
              (+= coded-depth 1)
            )
            (if (and (!= machine 0) (!= named 0))
              (= machine-bound (. (call (. bindings resolution-of) binding named) slot))
              (= machine-valued machine)
            )
            (call walk (if-expr (!= machine 0) (call (. tree declared-value) (. row right)) (. row right)))
            (= machine-valued 0)
            (= machine-bound no-slot)
            (if coded
              (-= coded-depth 1)
            )
            (if rule
              (call pop-scope)
              (-= stream-reach 1)
            )
            (-= lazy-depth 1)
            (call walk-live id)
          )
          (else-if (and (not (. row is-pattern)) (!= (call (. tree declared-machine) (. row right)) 0) local-named)
            (call declare-pattern (. row left) .slot-local 0 0)
            (= machine-bound (. (call (. bindings resolution-of) binding (call (. tree declared-local) (. row left))) slot))
            (= machine-valued (call (. tree declared-machine) (. row right)))
            (call walk machine-valued)
            (= machine-valued 0)
            (= machine-bound no-slot)
          )
          (else
            (call walk (. row right))
            (= redeclaring id)
            (call declare-pattern (. row left) .slot-local 0 0)
            (= redeclaring 0)
          )
        )
        (lazy local-named (!= (call (. tree declared-local) (. row left)) 0))
      )
      (case (call .node-identifier row)
        (let flags (if-expr (. row is-tracked) (. ResolutionFlag resolution-tracked) 0u32))
        (call resolve id (. row name) flags)
      )
      (case (call .node-ref-identifier row)
        (call resolve id (. row name) (. ResolutionFlag resolution-ref))
      )
      (case (call .node-assign row)
        (call walk (. row rhs))
        (let target (call (. tree identifier-name) (. row lhs)))
        (if target
          (let assignment (if-expr (== (. row op) .eq-op) id 0u32))
          (call resolve (. row lhs) target (. ResolutionFlag resolution-write) assignment)
          (else
            (call walk (. row lhs))
          )
        )
        (call walk-live id)
      )
      (case (call .node-iterable-expression row)
        (call walk (. row expr))
        (call walk-stream id)
      )
      (case (call .node-get-expression row)
        (match ([] (. tree nodes) (. row object))
          (case (call .node-identifier root)
            (if (and (. row is-tracked) (not (. root is-tracked)))
              (call resolve (. row object) (. root name) (. ResolutionFlag resolution-tracked))
              (else
                (call walk (. row object))
              )
            )
          )
          (default
            (call walk (. row object))
          )
        )
      )
      (case (call .node-function-syntax row)
        (call walk-nested id (. row args) (. row body))
      )
      (case (call .node-if-block row)
        (if (call is-branch id)
          (call walk-branch id)
          (else-if (call is-selector id)
            (call walk-selector id)
          )
          (else
            (+= branch-depth 1)
            (call walk-condition id (. row condition) (. row body))
            (call walk (. row next))
            (-= branch-depth 1)
          )
        )
      )
      (case (call .node-while-block row)
        (call push-scope .scope-loop id)
        (+= loop-depth 1)
        (call walk-condition id (. row condition) (. row body))
        (-= loop-depth 1)
        (call pop-scope)
      )
      (case (call .node-assertion-syntax row)
        (+= branch-depth 1)
        (call walk (. row exception))
        (call walk (. row condition))
        (-= branch-depth 1)
      )
      (case (call .node-latest-expression row)
        (+= branch-depth 1)
        (call walk (. row expr))
        (-= branch-depth 1)
        (call walk-latest id)
      )
      (case .node-state-machine
        (call walk-machine id)
      )
      (case (call .node-held-expression row)
        (call walk-held id (. row expr))
      )
      (case (call .node-use-expression row)
        (call walk (. row expr))
        (let keeper
          (scope (as (call (. bindings slots append) keeper-slot) SlotId)
            (lazy keeper-slot (call Slot .slot-use using-name id current-scope decl 0 0))
          )
        )
        (let declares (. ResolutionFlag resolution-declares))
        (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 keeper 0 declares))
      )
      (case .node-held-read
        (if (!= held no-slot)
          (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 held 0 0))
        )
      )
      (case (call .node-binary-expression row)
        (let short-circuit
          (scope (or logical (== (. row op) .coalesce-op) (== (. row op) .else-op))
            (lazy logical (or (== (. row op) .and-op) (== (. row op) .or-op)))
          )
        )
        (if (or short-circuit (== (. row op) .if-op))
          (+= branch-depth 1)
        )
        (if (== (call (. tree piped-feed) id) 0)
          (call walk (. row lhs))
        )
        (let streams (== (. row op) .grammar-pipe-op))
        (if streams
          (+= stream-reach 1)
        )
        (if (and streams (!= (call nested-decl-for id) 0))
          (call walk-pattern-pipe id (. row rhs))
          (else-if (and (!= (call nested-decl-for id) 0) (not (call is-live id)))
            (call walk-pipeline-body id (. row rhs) (== (. row op) .pipe-closure-op))
          )
          (else-if (== (. row op) .pipe-forward-op)
            (call resolve-callable (. row rhs))
          )
          (else-if (call is-type-test (. row op))
            (call walk-tested id (. row rhs))
          )
          (else
            (call walk (. row rhs))
          )
        )
        (if streams
          (-= stream-reach 1)
        )
        (if (== (. row op) .pipe-write-each-op)
          (call declare-loop-state id)
        )
        (if (or short-circuit (== (. row op) .if-op))
          (-= branch-depth 1)
        )
      )
      (case (call .node-markup row)
        (if (call (. tree element-fill) id)
          (return)
        )
        (if (call is-slot-builder id)
          (call walk-slot id (. row id) (. row type-id) (. row body))
          (else
            (call walk-markup id (. row id) (. row type-id) (. row body))
          )
        )
      )
      (case (call .node-slot-outlet row)
        (if (call is-branch (. row slot-parameter))
          (call walk-outlet-region
            (block
              (arg id)
              (arg (. row name))
              (arg (. row slot-parameter))
              (arg (. row style-rule-applications))
              (arg (. row body))
            )
          )
          (else-if (call (. tree builds-outlet-alone) id)
            (call walk-outlet-arm id (. row name) (. row style-rule-applications) (. row body))
          )
          (else
            (call walk-outlet (. row name) (. row slot-parameter) (. row style-rule-applications) (. row body))
          )
        )
      )
      (case (call .node-markup-slot-forward row)
        (if (and fills (!= function-depth 0))
          (call use-slot
            (block
              (arg (call builder-of (?? (call (. tree identifier-name) (. row slot-binding)) (call (. program store-atom) ""))))
              (arg 0)
              (arg 0)
            )
          )
        )
      )
      (case (call .node-for-block row)
        (if (call is-loop-region id)
          (call walk-loop-region id (. row loop) (. row body))
          (else-if (!= (call nested-decl-for id) 0)
            (call walk-generator id (. row loop) (. row body))
          )
          (else
            (call walk-loop (. row loop) (. row body))
          )
        )
        (call walk (. row next))
      )
      (case (call .node-iterator-expression row)
        (if (call is-broadcaster id)
          (call walk-broadcaster id (. row loop) (. row body))
          (else-if (!= (call nested-decl-for id) 0)
            (call walk-generator id (. row loop) (. row body))
          )
          (else
            (call walk-loop (. row loop) (. row body))
          )
        )
        (call walk (. row next))
      )
      (case .node-feed-expression
        (if (!= (call nested-decl-for id) 0)
          (call walk-feeds id)
          (else
            (call walk-feed-items id)
          )
        )
      )
      (case (call .node-pipeline-expression row)
        (if (== (call (. tree piped-feed) id) 0)
          (call walk (. row left))
        )
        (let streams (== (. row op) .grammar-pipe-op))
        (if streams
          (+= stream-reach 1)
        )
        (if (and streams (!= (call nested-decl-for id) 0))
          (call walk-pattern-pipe id (. row right))
          (else-if (and (!= (call nested-decl-for id) 0) (not (call is-live id)))
            (call walk-pipeline-body id (. row right) (== (. row op) .pipe-closure-op))
          )
          (else-if (== (. row op) .pipe-forward-op)
            (call resolve-callable (. row right))
          )
          (else
            (call walk (. row right))
          )
        )
        (if streams
          (-= stream-reach 1)
        )
        (if (== (. row op) .pipe-write-each-op)
          (call declare-loop-state id)
        )
      )
      (case .node-loop-syntax
        (call walk-loop id 0)
      )
      (case (call .node-match-expression row)
        (if (call is-branch id)
          (call walk-match-region id (. row subject))
          (return)
        )
        (if (call is-selector id)
          (call walk-selector id)
          (return)
        )
        (call walk (. row subject))
        (if (and (!= (. row subject) 0) (!= (call (. tree stream-statement) (. row body)) 0))
          (call push-scope .scope-arm id)
          (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
          (+= stream-reach 1)
          (call walk (. row body))
          (-= stream-reach 1)
          (call pop-scope)
          (else-if (!= (. row subject) 0)
            (+= stream-reach 1)
            (call walk (. row body))
            (-= stream-reach 1)
          )
          (else
            (call walk (. row body))
          )
        )
        (call walk (. row helper))
      )
      (case (call .node-structure-match row)
        (+= branch-depth 1)
        (call walk-arms (. row pattern))
        (-= branch-depth 1)
      )
      (case (call .node-stream-match row)
        (if (and (== stream-reach 0) (== function-depth 0) (not (call lookup-slot stream-name)))
          (call (. bindings diagnostics append) (call Diagnostic module id .stream-not-found null))
          (return)
        )
        (call walk (. row helper))
        (let floor capture-floor)
        (= capture-floor (as (. names length) U32))
        (+= stream-reach 1)
        (+= branch-depth 1)
        (call hoist-lazies (. row pattern))
        (call walk (. row pattern))
        (-= branch-depth 1)
        (-= stream-reach 1)
        (= capture-floor floor)
        (+= closed-matches id)
      )
      (case (call .node-stream-transform row)
        (call walk (. row pattern))
        (call push-scope .scope-arm id)
        (if (!= (. row pattern) 0)
          (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
        )
        (call declare location-name .slot-location id (. SlotFlag slot-constant) 0)
        (call walk-action (. row right))
        (call pop-scope)
      )
      (case (call .node-stream-predicate row)
        (call push-scope .scope-arm id)
        (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
        (call walk (. row predicate))
        (call pop-scope)
      )
      (case (call .node-catch-expression row)
        (+= guard-depth 1)
        (if (and (== (. row catchers count) 1) (!= (call (. tree transformer-exception) (. row body) (. row catchers)) 0))
          (call walk-transformer (. row body) (. row catchers))
          (else
            (call walk (. row body))
            (for (in catcher ([] (. tree children) (. row catchers)))
              (call walk catcher)
            )
          )
        )
        (-= guard-depth 1)
      )
      (case .node-catch-optional-expression
        (+= guard-depth 1)
        (for (in child (call (. tree children-of) id))
          (call walk child)
        )
        (-= guard-depth 1)
      )
      (case .node-optional-chain
        (+= guard-depth 1)
        (for (in child (call (. tree children-of) id))
          (call walk child)
        )
        (-= guard-depth 1)
      )
      (case (call .node-catcher row)
        (call push-scope .scope-catch id)
        (call declare-pattern (. row type) .slot-pattern (. SlotFlag slot-constant) 0)
        (call walk (. row body))
        (call pop-scope)
      )
      (case (call .node-use-block row)
        (call walk (. row subject))
        (call push-scope .scope-use id)
        (call walk (. row body))
        (call pop-scope)
      )
      (case (call .node-do-task-block row)
        (call walk (. row worker))
        (if (not (. row detached))
          (call own-task id)
        )
        (call walk-nested id (call (of RowRange SyntaxId)) (. row body) (. row catchers))
      )
      (case (call .node-do-block row)
        (call check-effect-names id (. row bans) null)
        (if (!= (call nested-decl-for id) 0)
          (call walk-nested id (call (of RowRange SyntaxId)) (. row body))
          (else
            (call push-scope .scope-do id)
            (call walk (. row body))
            (call pop-scope)
          )
        )
      )
      (case (call .node-do-finally-block row)
        (+= guard-depth 1)
        (call push-scope .scope-do id)
        (call walk (. row body))
        (call pop-scope)
        (-= guard-depth 1)
      )
      (case (call .node-stack-local-binding-block row)
        (call walk (. row value))
        (call resolve-stack-local id (. row name))
        (call walk (. row body))
      )
      (case (call .node-call-expression row)
        (call resolve-callable (. row callable))
        (for (in arg ([] (. tree children) (. row args)))
          (call walk arg)
        )
      )
      (case (call .node-cast-expression row)
        (call walk (. row lhs))
      )
      (case (call .node-type-predicate row)
        (call walk (. row expr))
      )
      (case (call .node-type-equality row)
        (call walk (. row expr))
      )
      (case .node-type-capture
        (call declare-pattern id .slot-pattern (. SlotFlag slot-constant) 0)
      )
      (case (call .node-stream-capture row)
        (call declare-capture (. row name))
        (call walk (. row pattern))
      )
      (case (call .node-stream-call row)
        (let saved in-callee)
        (= in-callee true)
        (call resolve id (. row name) 0 0 true)
        (= in-callee saved)
        (for (in child ([] (. tree children) (. row params)))
          (call walk child)
        )
        (for (in child ([] (. tree children) (. row args)))
          (call walk child)
        )
        (for (in child ([] (. tree children) (. row collector-mappings)))
          (call walk child)
        )
      )
      (case .node-type-identifier
        (return)
      )
      (case .node-type-arguments
        (return)
      )
      (case .node-type-associated
        (return)
      )
      (case .node-type-optional
        (return)
      )
      (case .node-type-tuple
        (return)
      )
      (case .node-type-transform
        (return)
      )
      (case .node-type-panic
        (return)
      )
      (case .node-type-and
        (return)
      )
      (case .node-type-or
        (return)
      )
      (case .node-type-relation
        (return)
      )
      (case .node-type-match
        (return)
      )
      (case .node-type-wildcard
        (return)
      )
      (case .node-type-remainder
        (return)
      )
      (case .node-type-list
        (return)
      )
      (case .node-type-map
        (return)
      )
      (case .node-type-map-item
        (return)
      )
      (case .node-type-function
        (return)
      )
      (case .node-type-iterable
        (return)
      )
      (case .node-type-case
        (return)
      )
      (case .node-type-property
        (return)
      )
      (case .node-type-numeric
        (return)
      )
      (case .node-class-block
        (return)
      )
      (case .node-extension
        (return)
      )
      (case .node-style-sheet-extension
        (return)
      )
      (case (call .node-property-syntax row)
        (let named (if-expr fills (call (. tree content-property-name) id) 0u32))
        (if (!= named 0)
          (call walk (. row value))
          (call resolve named (!! (call (. tree identifier-name) named)) (. ResolutionFlag resolution-write) id)
          (call walk-live id)
        )
      )
      (case .node-import-syntax
        (return)
      )
      (case .node-probe
        (call walk-probe id)
      )
      (case .node-probe-assign
        (call walk-probe id)
      )
      (case .node-probe-counter
        (call walk-probe id)
      )
      (case .node-probe-group
        (call walk-probe id)
      )
      (case (call .node-probe-scope row)
        (if (call (. program compiles-probe) module decl id)
          (call push-scope .scope-block id)
          (call predeclare-lazies (. row body))
          (for (in statement ([] (. tree children) (. row body)))
            (call walk statement)
          )
          (call pop-scope)
        )
      )
      (case (call .node-unary-expression row)
        (if (!= (. row op) .facts-of-op)
          (call walk (. row operand))
        )
      )
      (case (call .node-style-read-expression row)
        (if (== (. row object) 0)
          (call capture-self)
          (else
            (call walk (. row object))
          )
        )
      )
      (default
        (for (in child (call (. tree children-of) id))
          (call walk child)
        )
      )
    )
  )
  (fn-do _ walk-probe Void
    (param id SyntaxId)
    (+= branch-depth 1)
    (for (in child (call (. tree children-of) id))
      (call walk child)
    )
    (-= branch-depth 1)
  )
  (fn-do _ walk-condition Void
    (param id SyntaxId)
    (param condition SyntaxId)
    (param body SyntaxId)
    ; An if or while condition that is a structure match scopes its captures over the body.
    (let pattern (call match-pattern condition))
    (if (!= pattern 0)
      (call push-scope .scope-arm id)
      (call declare-pattern pattern .slot-pattern (. SlotFlag slot-constant) 0)
      (call walk-body body)
      (call pop-scope)
      (else
        (call walk condition)
        (call walk-body body)
      )
    )
  )
  (fn-expr _ match-pattern SyntaxId
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-structure-match row)
        (. row pattern)
      )
      (default
        0
      )
    )
  )
  (fn-do _ walk-nested Void
    (param id SyntaxId)
    (param args (of RowRange SyntaxId))
    (param body SyntaxId)
    (param handlers (of RowRange SyntaxId) (= (call (of RowRange SyntaxId))))
    ; A lambda, a task body or the body of a `do without gc` block: its own scope, argument slots,
    ; and capture pool. Captures gather while the body walks and are rowed when it closes,
    ; innermost first. A task's handlers run in the task, after its body, so they are bound in
    ; its scope as well.
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (for (in arg ([] (. tree children) args))
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (call declare-pattern (. row pattern) .slot-argument 0 0)
        )
      )
    )
    (for (in arg ([] (. tree children) args))
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (call walk (. row default-value))
        )
      )
    )
    (call walk body)
    (for (in handler ([] (. tree children) handlers))
      (call walk handler)
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-expr _ written-as-content Bool
    (param id SyntaxId)
    ; Whether a state machine is written as a line of the markup of the class whose object the
    ; function being bound fills.
    (and fills (!= (call (. (call (. tree content-machines) (. ([] (. bindings scopes) content-home) syntax)) find) id) null))
  )
  (fn-do _ walk-machine Void
    (param id SyntaxId)
    ; A state machine where it is written, a function of its own. A machine written as a
    ; statement, no value of a property or a declaration, first projects each case into the scope
    ; it is written in under the case's name, which no local of the function may have; one written
    ; as a line of a class's markup projects them as properties of the object instead.
    ; In its own function what it keeps is declared first, as slots no program names
    ; (`declare-machine`), and then its parts are bound; the flags of one declared into a local
    ; are declared beside the local. It captures the projections, the local it is declared into
    ; and those flags, which it writes, and the object of the function that starts it. A named
    ; machine written in one of its cases is part of it.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return)
    )
    (let depth function-depth)
    (let items (call (. tree state-items) (call (. tree state-body) id)))
    (let cases (call (. tree machine-cases) items))
    (let kept (call (. tree machine-captures) items cases))
    (let bound machine-bound)
    (let projects (and (!= machine-valued id) (not (call written-as-content id))))
    (= machine-bound no-slot)
    (= machine-valued 0)
    (let projections (list SlotId))
    (if projects
      (for (in node cases)
        (let name (!! (call (. tree state-name) node)))
        (let found (call lookup-position name))
        (if (and found (== ([] name-depths found) depth))
          (let message (call (. program store-atom) (str "State projection '" (. name text) "' already exists")))
          (call (. bindings diagnostics append) (call Diagnostic module id .stated message))
          (break)
        )
        (+= projections (call declare name .slot-machine id 0 0))
      )
    )
    (let first (. bindings slots length))
    (let flagged (!= bound no-slot))
    (if flagged
      (for (in node cases)
        (call hide active-name node)
      )
    )
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call declare-machine id items cases kept flagged)
    (let last (. bindings slots length))
    (call (. bindings machines append)
      (block
        (arg (call MachineSlots module id decl (call (of RowRange Slot) (as first U32) (as (- last first) U32)) bound))
      )
    )
    (for (in slot projections)
      (call use-slot slot depth (. ResolutionFlag resolution-write))
    )
    (if flagged
      (call use-slot bound depth (. ResolutionFlag resolution-write))
      (for (in offset (..< 0 (. cases length)))
        (call use-slot (as (+ first offset) U32) depth (. ResolutionFlag resolution-write))
      )
    )
    (let self (call lookup-position this-name))
    (if self
      (call use-slot ([] name-slots self) ([] name-depths self) 0)
    )
    (+= machine-cases cases)
    (+= machine-kept kept)
    (+= machine-roots items)
    (+= owning-cases 0)
    (+= state-depth 1)
    (call walk-entered 0 items)
    (for (in item items)
      (if (call (. tree is-transition) item)
        (call walk-case item)
      )
    )
    (call walk-groups items)
    (-= state-depth 1)
    (call (. owning-cases pop))
    (call (. machine-cases pop))
    (call (. machine-kept pop))
    (call (. machine-roots pop))
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-nested-machine _
    (param item SyntaxId)
    ; A named machine written in a case of another: part of the function of the machine around it,
    ; whose environment holds what it keeps and the name the property declares, which holds the
    ; machine's value, declared as a machine's is (`declare-machine`), and whose parts are bound as
    ; that machine's are.
    (let id (call (. tree nested-machine) item))
    (let items (call (. tree state-items) (call (. tree state-body) id)))
    (let cases (call (. tree machine-cases) items))
    (let kept (call (. tree machine-captures) items cases))
    (let bound no-slot)
    (match? ([] (. tree nodes) item)
      (case (call .node-property-syntax row)
        (call declare-pattern (. row left) .slot-local 0 0)
        (= bound (. (call (. bindings resolution-of) binding (call (. tree declared-local) (. row left))) slot))
      )
    )
    (if (!= bound no-slot)
      (call (. bindings mark-slot) bound (. SlotFlag slot-captured))
    )
    (let first (. bindings slots length))
    (let owner (if-expr (!= (. nested-decls length) 0) ([] nested-decls (- (. nested-decls length) 1)) decl))
    (call declare-machine id items cases kept false)
    (call (. bindings machines append)
      (block
        (arg
          (call MachineSlots
            (block
              (arg module)
              (arg id)
              (arg owner)
              (arg (call (of RowRange Slot) (as first U32) (as (- (. bindings slots length) first) U32)))
              (arg bound)
            )
          )
        )
      )
    )
    (+= machine-cases cases)
    (+= machine-kept kept)
    (+= machine-roots items)
    (+= owning-cases 0)
    (call walk-entered 0 items)
    (for (in item items)
      (if (call (. tree is-transition) item)
        (call walk-case item)
      )
    )
    (call walk-groups items)
    (call (. owning-cases pop))
    (call (. machine-cases pop))
    (call (. machine-kept pop))
    (call (. machine-roots pop))
  )
  (fn-do _ declare-machine _
    (param id SyntaxId)
    (param items (list SyntaxId))
    (param cases (list SyntaxId))
    (param kept (list (list Atom)))
    (param flagged Bool)
    ; A machine's value, and for each case its flag, where it was not declared beside the local
    ; the machine is kept in, generation, payload where one is given, and each name it keeps from
    ; what entered it; for each group of event transitions its subscriber and source. The
    ; machine's environment holds each.
    (call hide machine-value-name id)
    (for (in position (..< 0 (. cases length)))
      (let node ([] cases position))
      (if (not flagged)
        (call hide active-name node)
      )
      (call hide generation-name node)
      (if (call (. tree owns-in-case) items node)
        (+= tasks-cases node)
        (+= tasks-slots (as (. bindings slots length) SlotId))
        (call hide tasks-name node)
      )
      (if (call (. tree payload-source) items (!! (call (. tree state-name) node)))
        (call hide payload-name node)
      )
      (for (in name ([] kept position))
        (call hide (call (. program store-atom) (str "(kept " (. name text) ")")) node)
      )
    )
    (call hide-groups items)
  )
  (fn-do _ hide-groups _
    (param items (list SyntaxId))
    (for (in head (call (. tree group-heads) items))
      (call hide subscriber-name head)
      (call hide source-name head)
    )
    (for (in item items)
      (if (call (. tree is-transition) item)
        (call hide-groups (call (. tree state-items) (call (. tree state-body) item)))
      )
    )
  )
  (fn-do _ hide _
    (param name Atom)
    (param node SyntaxId)
    (call (. bindings slots append)
      (block
        (arg (call Slot .slot-machine name node current-scope decl 0 (. SlotFlag slot-captured)))
      )
    )
  )
  (fn-do _ walk-entered Void
    (param owner SyntaxId)
    (param items (list SyntaxId))
    ; What runs where a machine starts, or once the entry statements of a case, its `owner`, have:
    ; what its first case is given where it is entered so (`enters-initial`), which a case never is
    ; where one of its immediate transitions always passes (`always-passes`), its immediate
    ; transitions, and the streams its groups subscribe to, each trigger with the slots of a loop,
    ; which one over a stream that is only iterable reads by.
    (let initial (if-expr (or (== owner 0) (not (call (. tree always-passes) items))) (call (. tree initial-case) items) 0))
    (if (and (!= initial 0) (call (. tree enters-initial) ([] machine-roots (- (. machine-roots length) 1)) owner))
      (call walk-targets initial true)
    )
    (for (in transition (call (. tree immediate-transitions) items))
      (let trigger (call (. tree state-trigger) transition))
      (let subject (call (. tree trigger-subject) trigger))
      (if (== trigger 0)
        (call walk-targets transition)
        (else-if (!= subject 0)
          (call walk subject)
          (call push-scope .scope-arm transition)
          (call declare-pattern (call (. tree trigger-pattern) trigger) .slot-pattern (. SlotFlag slot-constant) 0)
          (call walk-targets transition)
          (call pop-scope)
        )
        (else
          (call walk (call (. tree trigger-condition) trigger))
          (call walk-targets transition)
        )
      )
    )
    (for (in head (call (. tree group-heads) items))
      (call walk (call (. tree group-stream) head))
      (call declare-loop-state (call (. tree state-trigger) head))
    )
  )
  (fn-do _ walk-targets Void
    (param transition SyntaxId)
    (param initial Bool (= false))
    ; What a transition gives the case it enters, then what each name the case keeps reads there.
    ; A name a first case is given where it is entered (`initial`) that nothing declares is no error
    ; here: only the type pass knows whether a machine this one refines enters a case of its own
    ; first, where the name names what the case holds.
    (let quiet quiet-name)
    (for (in target ([] (. tree children) (call (. tree state-targets) transition)))
      (= quiet-name (if-expr initial target quiet))
      (call walk target)
    )
    (= quiet-name quiet)
    (let cases ([] machine-cases (- (. machine-cases length) 1)))
    (let position (call (. tree case-position) cases (!! (call (. tree state-name) transition))))
    (if (== position null)
      (return)
    )
    (for (in name ([] ([] machine-kept (- (. machine-kept length) 1)) position))
      (let found (call lookup-position name))
      (let slot no-slot)
      (if found
        (= slot ([] name-slots found))
        (call use-slot slot ([] name-depths found) 0)
      )
      (call (. bindings machine-reads append) (call MachineRead module transition name slot))
    )
  )
  (fn-do _ walk-case Void
    (param node SyntaxId)
    ; A case or a continuation. Its activation is a scope of its own, which runs anew each time it
    ; is bound, where the names it was given and the names it keeps are declared. There its entry
    ; statements run in a scope of
    ; their own, with what runs once they have; then come its cases, the functions its groups run,
    ; and the `do finally` blocks of its exit in a scope of their own, beyond the entry's locals. A
    ; named machine among its entry statements is part of the machine (`walk-nested-machine`).
    ; Tasks and loops on a stream its entry statements start are the activation's of the case it
    ; enters, where that case owns them (`owning-case`); those its `do finally` blocks start are not.
    (let items (call (. tree state-items) (call (. tree state-body) node)))
    (+= owning-cases (call owning-case node))
    (call push-scope .scope-activation node)
    (call declare-activation node)
    (call push-scope .scope-block node)
    (call predeclare-lazies (call (. tree state-body) node))
    (for (in item items)
      (if (!= (call (. tree nested-machine) item) 0)
        (call walk-nested-machine item)
        (else-if (call (. tree is-entry-item) item)
          (call walk item)
        )
      )
    )
    (call walk-entered node items)
    (call pop-scope)
    (for (in item items)
      (if (call (. tree is-transition) item)
        (call walk-case item)
      )
    )
    (call walk-groups items)
    (+= owning-cases 0)
    (call push-scope .scope-block node)
    (for (in item items)
      (if (is ([] (. tree nodes) item) .node-do-finally-block)
        (call walk item)
      )
    )
    (call pop-scope)
    (call pop-scope)
    (call (. owning-cases pop))
    (call (. owning-cases pop))
  )
  (fn-do _ declare-activation _
    (param node SyntaxId)
    ; The names an activation of a case sees: those among what it was given, then those it keeps,
    ; each a constant declared at the case or continuation.
    (let names (list Atom))
    (call (. tree target-names) node names)
    (let cases ([] machine-cases (- (. machine-cases length) 1)))
    (let position (call (. tree case-position) cases (!! (call (. tree state-name) node))))
    (if (!= position null)
      (for (in name ([] ([] machine-kept (- (. machine-kept length) 1)) position))
        (if (== (call (. names find) name) null)
          (+= names name)
        )
      )
    )
    (for (in name names)
      (call declare name .slot-local node (. SlotFlag slot-constant) 0)
    )
  )
  (fn-do _ walk-groups Void
    (param items (list SyntaxId))
    ; The function each group of a body's event transitions runs for an item: `each` and `it` are
    ; the item, and each transition tests its pattern and guard and gives its targets in an arm
    ; of its own.
    (for (in head (call (. tree group-heads) items))
      (call push-scope .scope-block head)
      (call declare each-name .slot-each head (. SlotFlag slot-constant) 0)
      (call declare it-name .slot-it head (. SlotFlag slot-constant) 0)
      (for (in transition (call (. tree group-transitions) items head))
        (let trigger (call (. tree state-trigger) transition))
        (call push-scope .scope-arm transition)
        (call declare-pattern (call (. tree trigger-pattern) trigger) .slot-pattern (. SlotFlag slot-constant) 0)
        (call walk (call (. tree trigger-guard) trigger))
        (call walk-targets transition)
        (call pop-scope)
      )
      (call pop-scope)
    )
  )
  (fn-do _ open-nested _
    (param syntax SyntaxId)
    (let decl (call nested-decl-for syntax))
    (let by-value false)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function row)
        (= by-value (or (== (. row kind) .task-decl) (== (. row kind) .region-decl)))
      )
    )
    (+= nested-decls decl)
    (+= nested-syntax syntax)
    (+= nested-scopes current-scope)
    (+= nested-depths function-depth)
    (+= nested-by-value by-value)
    (+= nested-marks (. capture-slots length))
  )
  (fn-do _ close-nested _
    ; Rows the innermost open nested function: its captures move from the scratch pool into the
    ; store in first-reference order, and the entries of the enclosing functions stay behind.
    (let frame (- (. nested-decls length) 1))
    (let mark ([] nested-marks frame))
    (let start U32 (as (. bindings captures length) U32))
    (let kept mark)
    (let written (call function-of (. ([] (. bindings scopes) ([] nested-scopes frame)) parent)))
    (for (in position (..< mark (. capture-slots length)))
      (if (== ([] capture-frames position) frame)
        (let slot ([] capture-slots position))
        (call (. bindings record-capture) slot ([] capture-flags position))
        (if (and lazy-slot (== (call function-of (. ([] (. bindings slots) slot) scope)) written))
          (call (. bindings note-lazy-capture) slot (!= lazy-depth 0))
        )
        (lazy lazy-slot (== (. ([] (. bindings slots) slot) kind) .slot-lazy))
        (else
          (= ([] capture-frames kept) ([] capture-frames position))
          (= ([] capture-slots kept) ([] capture-slots position))
          (= ([] capture-flags kept) ([] capture-flags position))
          (+= kept 1)
        )
      )
    )
    (while (> (. capture-slots length) kept)
      (call (. capture-frames pop))
      (call (. capture-slots pop))
      (call (. capture-flags pop))
    )
    (let captures (call (. bindings captures-from) start))
    (let row (call NestedFunction ([] nested-decls frame) ([] nested-syntax frame) ([] nested-scopes frame) captures))
    (call (. bindings nested append) row)
    (call (. nested-decls pop))
    (call (. nested-syntax pop))
    (call (. nested-scopes pop))
    (call (. nested-depths pop))
    (call (. nested-by-value pop))
    (call (. nested-marks pop))
  )
  (fn-expr _ is-owner-scanned-decl Bool
    (param decl DeclId)
    ; A comprehension, feed list, or pipeline body closure row: its body is scanned as part of its
    ; owner, so it gets an empty scan row of its own and no interval.
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (or (== (. fn kind) .iterator-decl) (== (. fn kind) .feed-decl) (== (. fn kind) .pipeline-decl))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ nested-decl-for DeclId
    (param syntax SyntaxId)
    ; The nested function declared at a node, or none. The module's index answers, so a node
    ; costs the same however many functions its module declares.
    (?? ([] nested-index (/or/ (/lshift/ (as module U64) 32) syntax)) 0)
  )
  (fn-do + forget-module _
    (param forgotten ModuleId)
    (if (< forgotten (. indexed length))
      (= ([] indexed forgotten) false)
    )
    (let wide U64 forgotten)
    (let nested (list U64))
    (for (in (tuple key _) nested-index)
      (if (== (/rshift/ key 32) wide)
        (+= nested key)
      )
    )
    (for (in key nested)
      (-= ([] nested-index key))
    )
    (let typed (list U64))
    (for (in (tuple key _) type-index)
      (if (== (/rshift/ key 32) wide)
        (+= typed key)
      )
    )
    (for (in key typed)
      (-= ([] type-index key))
    )
  )
  (fn-do _ index-module _
    ; Indexes a module's declarations the first time one of its functions is bound: the nested
    ; function and the class or extension at each node, and the functions a scan steps over, in
    ; the order of their nodes.
    ; A module's declarations are all made before any is bound.
    (while (<= (. indexed length) module)
      (+= indexed false)
      (+= skipped-first 0)
      (+= skipped-count 0)
    )
    (if ([] indexed module)
      (return)
    )
    (= ([] indexed module) true)
    (let wide U64 module)
    (let keys (list U64))
    (let index 0u32)
    (for (in row (. ([] (. program modules) module) decls))
      (let stepped SyntaxId 0)
      (match? row
        (case (call .decl-function fn)
          (if (call is-nested-kind (. fn kind))
            (let key (/or/ (/lshift/ wide 32) (. fn syntax)))
            (if (== ([] nested-index key) null)
              (= ([] nested-index key) index)
            )
            (else-if (and (not (. fn is-generated)) (!= (. fn kind) .main-decl))
              (= stepped (. fn syntax))
            )
          )
        )
        (case (call .decl-class class)
          (let key (/or/ (/lshift/ wide 32) (. class syntax)))
          (if (== ([] type-index key) null)
            (= ([] type-index key) index)
          )
        )
        (case (call .decl-extension extension)
          (let key (/or/ (/lshift/ wide 32) (. extension syntax)))
          (if (== ([] type-index key) null)
            (= ([] type-index key) index)
          )
        )
        (case (call .decl-sheet-extension extension)
          (let key (/or/ (/lshift/ wide 32) (. extension syntax)))
          (if (== ([] type-index key) null)
            (= ([] type-index key) index)
          )
        )
        (case (call .decl-converter fn)
          (= stepped (. fn syntax))
        )
        (case (call .decl-fromverter fn)
          (= stepped (. fn syntax))
        )
      )
      (if (!= stepped 0)
        (let node U64 stepped)
        (+= keys (/or/ (/lshift/ node 32) index))
      )
      (+= index 1)
    )
    (let sorted (call sort keys))
    (= ([] skipped-first module) (as (. skipped length) U32))
    (= ([] skipped-count module) (as (. sorted length) U32))
    (for (in key sorted)
      (+= skipped key)
    )
  )
  (fn-do _ record-capture _
    (param slot SlotId)
    (param depth U32)
    (param by-value Bool)
    (param flags ResolutionMask (= 0))
    (param owner _ (= false))
    ; Every open nested function between the reference and the declaring function records the slot
    ; once. Task bodies and `this` capture by value. A capture notes whether the function assigns
    ; the slot. The body of a `do without gc` block runs where it is written, and takes the address
    ; of each local and argument it captures there. A receiver captured for anything but the `owner`
    ; of a task spawned inside is marked used, which a value of a struct cannot be.
    (if (and (not owner) (== (. ([] (. bindings slots) slot) kind) .slot-this))
      (call (. bindings mark-slot) slot (. SlotFlag slot-self-used))
    )
    (let assigned
      (scope (if-expr (!= write-bit 0) (. CaptureFlag capture-assigned) (. CaptureFlag capture-none))
        (lazy write-bit (/and/ flags (. ResolutionFlag resolution-write)))
      )
    )
    (let kind (. ([] (. bindings slots) slot) kind))
    (let held (or (== kind .slot-local) (== kind .slot-argument)))
    (let total (. nested-decls length))
    (for (in reverse (..< 0 total))
      (let frame (- total 1 reverse))
      (if (<= ([] nested-depths frame) depth)
        (return)
      )
      (let position (call frame-capture frame slot))
      (if position
        (= ([] capture-flags position) (/or/ ([] capture-flags position) assigned))
        (continue)
      )
      (let value (or by-value ([] nested-by-value frame)))
      (+= capture-frames frame)
      (+= capture-slots slot)
      (+= capture-flags (if-expr value (/or/ (. CaptureFlag capture-by-value) assigned) assigned))
      (if (and held (call is-region-frame frame))
        (call (. bindings mark-slot) slot (. SlotFlag slot-address-taken))
      )
    )
  )
  (fn-do _ frame-capture (? Size)
    (param frame Size)
    (param slot SlotId)
    (for (in position (..< ([] nested-marks frame) (. capture-slots length)))
      (if (and (== ([] capture-frames position) frame) (== ([] capture-slots position) slot))
        (return position)
      )
    )
    (return null)
  )
  (fn-expr _ is-region-frame Bool
    (param frame Size)
    (match ([] (. ([] (. program modules) module) decls) ([] nested-decls frame))
      (case (call .decl-function row)
        (== (. row kind) .region-decl)
      )
      (default
        false
      )
    )
  )
  (fn-do _ scan-body _
    (param syntax SyntaxId)
    (param range SyntaxRange)
    ; A linear pass over the tag column of the binding's range. Every nested function of this
    ; binding gets its own scan row; every other declaration inside the range, which for main is
    ; every function of the module, is skipped. The module's index lists those by node, so only
    ; the ones inside the range are visited. Subtrees nest, so a stack holds the row in force.
    ; The binding row's nested count is filled by `finish`, so the rows appended since `reserve`
    ; are counted from the table.
    (let own (call (. bindings begin-scan) decl syntax))
    (let nested-start (. ([] (. bindings bindings) binding) nested start))
    (let nested-count (- (. bindings nested length) nested-start))
    (for (in offset (..< 0 nested-count))
      (let nested ([] (. bindings nested) (+ nested-start offset)))
      (let scan (call (. bindings begin-scan) (. nested decl) (. nested syntax)))
      (if (not (call is-owner-scanned-decl (. nested decl)))
        (call add-scan-interval (call nested-subtree-start nested) (. nested syntax) scan)
      )
    )
    (blank)
    (let last (- (+ (. range start) (. range count)) 1))
    (let first ([] skipped-first module))
    (let count ([] skipped-count module))
    (let bound U64 (. range start))
    (= bound (/lshift/ bound 32))
    (let low 0u32)
    (let high count)
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< ([] skipped (+ first middle)) bound)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (while (< low count)
      (let entry ([] skipped (+ first low)))
      (let node (as (/zrshift/ entry 32) SyntaxId))
      (if (> node last)
        (break)
      )
      (let index (as (/and/ entry 0xffffffff) DeclId))
      (if (!= index decl)
        (let start 0u32)
        (match? ([] (. ([] (. program modules) module) decls) index)
          (case (call .decl-function fn)
            (= start (. fn subtree start))
          )
        )
        (if (== start 0)
          (= start (call (. tree subtree-start) node))
        )
        (call add-scan-interval start node (. U32 max))
      )
      (+= low 1)
    )
    (blank)
    (let next 0)
    (for (in offset (..< 0 (. range count)))
      (let id (+ (. range start) offset))
      (while (and (< next (. scan-starts length)) (== ([] scan-starts next) id))
        (let row ([] scan-rows next))
        (if (and (!= (. scan-stack-rows length) 0) (== ([] scan-stack-rows (- (. scan-stack-rows length) 1)) (. U32 max)))
          (= row (. U32 max))
        )
        (+= scan-stack-rows row)
        (+= scan-stack-ends ([] scan-ends next))
        (+= next 1)
      )
      (let target own)
      (if (!= (. scan-stack-rows length) 0)
        (= target ([] scan-stack-rows (- (. scan-stack-rows length) 1)))
      )
      (if (!= target (. U32 max))
        (call scan-node target id)
      )
      (while (and (!= (. scan-stack-ends length) 0) (== ([] scan-stack-ends (- (. scan-stack-ends length) 1)) id))
        (let closed (call (. scan-stack-rows pop)))
        (call (. scan-stack-ends pop))
        (if (!= closed (. U32 max))
          (let parent own)
          (if (!= (. scan-stack-rows length) 0)
            (= parent ([] scan-stack-rows (- (. scan-stack-rows length) 1)))
          )
          (if (!= parent (. U32 max))
            (call (. bindings record-scan) parent .scan-nested-function id)
          )
        )
      )
    )
  )
  (fn-do _ nested-subtree-start SyntaxId
    (param nested NestedFunction)
    (match? ([] (. ([] (. program modules) module) decls) (. nested decl))
      (case (call .decl-function fn)
        (if (== (. fn syntax) (. nested syntax))
          (return (. fn subtree start))
        )
      )
    )
    (return (call (. tree subtree-start) (. nested syntax)))
  )
  (fn-do _ add-scan-interval _
    (param start SyntaxId)
    (param end SyntaxId)
    (param row U32)
    ; Kept sorted by start, then by the wider subtree first, so the scan pushes an enclosing
    ; function before the functions that begin on its first node.
    (+= scan-starts start)
    (+= scan-ends end)
    (+= scan-rows row)
    (let position (- (. scan-starts length) 1))
    (while (and (!= position 0) (call interval-precedes position (- position 1)))
      (let start-swap ([] scan-starts (- position 1)))
      (let end-swap ([] scan-ends (- position 1)))
      (let row-swap ([] scan-rows (- position 1)))
      (= ([] scan-starts (- position 1)) ([] scan-starts position))
      (= ([] scan-ends (- position 1)) ([] scan-ends position))
      (= ([] scan-rows (- position 1)) ([] scan-rows position))
      (= ([] scan-starts position) start-swap)
      (= ([] scan-ends position) end-swap)
      (= ([] scan-rows position) row-swap)
      (-= position 1)
    )
  )
  (fn-expr _ interval-precedes Bool
    (param left Size)
    (param right Size)
    (or earlier (and same-start (> ([] scan-ends left) ([] scan-ends right))))
    (where
      (lazy earlier (< ([] scan-starts left) ([] scan-starts right)))
      (lazy same-start (== ([] scan-starts left) ([] scan-starts right)))
    )
  )
  (fn-do _ scan-node _
    (param target U32)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case .node-yield
        (call (. bindings record-scan) target .scan-yield id)
      )
      (case (call .node-identifier row)
        (if (. row is-tracked)
          (call (. bindings record-scan) target .scan-tracked-read id)
        )
      )
      (case (call .node-get-expression row)
        (if (. row is-tracked)
          (call (. bindings record-scan) target .scan-tracked-read id)
        )
      )
      (case .node-latest-expression
        (call (. bindings record-scan) target .scan-latest id)
      )
      (case .node-use-expression
        (call (. bindings record-scan) target .scan-use-expression id)
      )
      (case .node-use-block
        (call (. bindings record-scan) target .scan-use-block id)
      )
      (case .node-do-finally-block
        (call (. bindings record-scan) target .scan-do-finally id)
      )
      (case .node-stack-local-binding-block
        (call (. bindings record-scan) target .scan-stack-local id)
      )
      (case .node-call-expression
        (call (. bindings record-scan) target .scan-call id)
      )
      (case .node-assertion-syntax
        (call (. bindings record-scan) target .scan-assertion id)
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .optional-force-op)
          (call (. bindings record-scan) target .scan-force id)
        )
      )
      (case .node-index-expression
        (call (. bindings record-scan) target .scan-index id)
      )
    )
  )
  (fn-do _ own-task _
    (param id SyntaxId)
    ; A task spawned where a case's activation owns it is given the slot the machine keeps the
    ; activation's record of its tasks in, which the functions around it capture, as the task
    ; block's resolution (`own-loop`); any other is given the receiver, where there is one, for its
    ; object to own.
    (if (not (call own-loop id))
      (call capture-self true)
    )
  )
  (fn-do _ own-loop Bool
    (param id SyntaxId)
    (let tasks (call activation-tasks))
    (if (== tasks no-slot)
      (return false)
    )
    (call use-slot tasks (call slot-depth tasks) 0)
    (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 tasks 0 0))
    (return true)
  )
  (fn-do _ activation-tasks SlotId
    ; The slot of the record of the tasks of the case whose activation owns what is spawned here, or
    ; none.
    (return-if no-slot (if (== (. owning-cases length) 0)))
    (blank)
    (let case ([] owning-cases (- (. owning-cases length) 1)))
    (return-if no-slot (if (== case 0)))
    (blank)
    (for (in position (..< 0 (. tasks-cases length)))
      (return-if ([] tasks-slots position) (if (== ([] tasks-cases position) case)))
    )
    (return no-slot)
  )
  (fn-do _ owning-case SyntaxId
    (param node SyntaxId)
    ; The case among the machine's cases that a case or continuation enters, where its activation
    ; owns tasks or loops on a stream, or none.
    (let name (call (. tree state-name) node))
    (return-if 0 (if (or (not name) (== (. machine-cases length) 0))))
    (blank)
    (let cases ([] machine-cases (- (. machine-cases length) 1)))
    (let position (call (. tree case-position) cases name))
    (return-if 0 (if (== position null)))
    (blank)
    (let case ([] cases position))
    (return-if case (if (!= (call (. tasks-cases find) case) null)))
    (return 0)
  )
  (fn-do _ capture-self _
    (param owner _ (= false))
    ; A member or method reached from a nested function needs `this`, which every closure scope on
    ; the way out captures by value, as does a task spawned there that its `owner` keeps.
    (let position (call lookup-position this-name))
    (if (not position)
      (return)
    )
    (let depth ([] name-depths position))
    (if (< depth function-depth)
      (let slot ([] name-slots position))
      (call (. bindings mark-slot) slot (. SlotFlag slot-captured))
      (call record-capture slot depth true 0 owner)
    )
  )
  (fn-do _ walk-generator Void
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    ; A comprehension compiled as a generator closure, or a loop on a stream compiled as its
    ; subscriber: the caller evaluates the first container, so it binds outside, as does a
    ; `whenever` clause (see `walk-whenever`); the loop with its other clauses, chained headers,
    ; and body binds inside the closure's own scope and captures like a lambda body.
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (call walk-source row)
      )
    )
    (call walk-whenever loop)
    (if (call is-broadcaster id)
      (do
        (inline (call own-loop id))
      )
    )
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call walk-loop loop body true)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ is-broadcaster Bool
    (param id SyntaxId)
    ; Whether a comprehension is one on a stream compiled as its subscriber.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .subscriber-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-broadcaster Void
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    ; A comprehension on a stream compiled as its subscriber, which writes what its body gives to a
    ; channel the comprehension makes: the channel is a local no name reaches, declared at the
    ; comprehension, which the subscriber captures before anything its loop reads. A `whenever`
    ; clause binds outside too (see `walk-whenever`).
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (call walk-source row)
      )
    )
    (call walk-whenever loop)
    (let flags (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let channel
      (scope (as (call (. bindings slots append) channel-slot) SlotId)
        (lazy channel-slot (call Slot .slot-local channel-name id current-scope decl 0 flags))
      )
    )
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 channel 0 declares))
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call record-capture channel (- function-depth 1) false)
    (call walk-loop loop body true)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-feeds Void
    (param id SyntaxId)
    ; A feed list compiled as a generator closure: every feed's item binds inside the closure's
    ; own scope and captures like a lambda body.
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call walk-feed-items id)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-feed-items Void
    (param id SyntaxId)
    ; The items along a feed chain; the chain links are not walked as children. A feed that
    ; gives every item of what it writes is a loop, and has the slots of one.
    (let feed id)
    (while (!= feed 0)
      (let next 0u32)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (call walk (. row item))
          (if (. row is-spread)
            (call declare-loop-state feed)
          )
          (= next (. row next))
        )
      )
      (= feed next)
    )
  )
  (fn-do _ declare-loop-state _
    (param at SyntaxId)
    ; The hidden slots of a loop at a node that heads none: a spread of
    ; what it writes, a pipe that writes each item of what it reads, or one that matches a
    ; pattern again and again on what it reads.
    (let state (as (. bindings slots length) SlotId))
    (for (in _ (..< 0 loop-state-count))
      (call (. bindings slots append) (call Slot .slot-loop-state state-name at current-scope decl 0 0))
    )
    (let declares U32 (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding at (call Resolution .resolve-slot 0 state 0 declares))
  )
  (fn-do _ walk-pattern-pipe Void
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; A stream piped through a pattern, compiled as a generator closure given the stream: the
    ; pattern binds inside the closure's own scope, beside the hidden slots of the loop that
    ; matches it again and again. What a feed the pipe reads alone writes binds there too, as
    ; the closure evaluates it.
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (call declare-loop-state id)
    (match? ([] (. tree nodes) (call (. tree piped-feed) id))
      (case (call .node-feed-expression row)
        (call walk (. row item))
      )
    )
    (call walk pattern)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-pipeline-body Void
    (param id SyntaxId)
    (param body SyntaxId)
    (param whole Bool)
    ; A map or filter body compiled as a closure taking `each`: the item binds inside the closure's
    ; own scope with no declaring syntax. A closure pipe takes the whole left value as `it`.
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (if whole
      (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
      (else
        (call declare each-name .slot-each id (. SlotFlag slot-constant) 0)
      )
    )
    (call walk body)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ arrival-name SyntaxId
    (param clause SyntaxId)
    ; The name a loop's first clause tests where it is `when arrival` or `when bubbling`, or none.
    (match? ([] (. tree nodes) clause)
      (case (call .node-clause row)
        (if (is (. row op) .when-clause)
          (match? ([] (. tree nodes) (. row expr))
            (case (call .node-identifier name)
              (if (or (== (. name name text) "arrival") (== (. name name text) "bubbling"))
                (return (. row expr))
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ walk-loop Void
    (param id SyntaxId)
    (param body SyntaxId)
    (param container-bound Bool (= false))
    (param chained Bool (= false))
    ; A header of a loop, then the headers chained after it and the body. `each` and `it` are the
    ; item of the first header: one chained after it declares neither, and neither is declared where
    ; its pattern declares the name itself (`declares-name`). The `whenever` clause of a loop on a
    ; stream binds where the loop is written, not here. A loop on a stream whose clause is
    ; `when arrival` or `when bubbling` may be one on an event, where that is no test: the name is
    ; not reported here when nothing declares it, and the type pass reports it where the loop is on
    ; no event. A header whose container is evaluated where its closure is made has one slot more,
    ; after its item, for the container it is given.
    (match? ([] (. tree nodes) id)
      (case (call .node-loop-syntax row)
        (if (not container-bound)
          (call walk-source row)
        )
        (let streams (call (. tree is-grammar) (. row pattern)))
        (if streams
          (+= stream-reach 1)
        )
        (call push-scope .scope-loop id)
        (+= loop-depth 1)
        (if (. row is-subscriber)
          (+= subscription-depth 1)
        )
        (let pattern (call match-pattern (. row pattern)))
        (let item-pattern (if-expr (!= pattern 0) pattern (. row pattern)))
        (let patterned (as (. bindings slots length) SlotId))
        (if streams
          (call hoist-lazies (. row pattern))
          (call walk (. row pattern))
          (else
            (call declare-pattern item-pattern .slot-loop-item 0 0)
          )
        )
        (let named (call names-item item-pattern))
        (let implicit no-slot)
        (let each-free (not (call declares-name patterned each-name)))
        (if (and (not chained) each-free (or (not named) (not (call lookup-slot each-name))))
          (= implicit (call declare each-name .slot-each id (. SlotFlag slot-constant) 0))
        )
        (if (and (not chained) (not (call declares-name patterned it-name)) (or (not named) (not (call lookup-slot it-name))))
          (let it-slot (call declare it-name .slot-it id (. SlotFlag slot-constant) 0))
          (if (== implicit no-slot)
            (= implicit it-slot)
          )
        )
        (let state (as (. bindings slots length) SlotId))
        (let kept (if-expr container-bound (+ loop-state-count 1) loop-state-count))
        (for (in _ (..< 0 kept))
          (call (. bindings slots append) (call Slot .slot-loop-state state-name id current-scope decl 0 0))
        )
        (let declares U32 (. ResolutionFlag resolution-declares))
        (let first (if-expr (!= implicit no-slot) implicit state))
        (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 first 0 declares))
        (= quiet-name (if-expr (. row is-subscriber) (call arrival-name (. row clause)) 0))
        (let retested (call (. tree whenever-clause) id))
        (call walk-clauses (. row clause) (if-expr (!= (call nested-decl-for retested) 0) retested 0))
        (= quiet-name 0)
        (if (!= (. row next) 0)
          (call walk-loop (. row next) body false true)
          (else
            (call walk-body body)
          )
        )
        (if (. row is-subscriber)
          (-= subscription-depth 1)
        )
        (-= loop-depth 1)
        (call pop-scope)
        (if streams
          (-= stream-reach 1)
        )
      )
    )
  )
  (fn-do _ walk-source Void
    (param row ASTLoop)
    ; The container of a loop's first header. That of a handler, which names the event it subscribes
    ; to, is the one name a row of a markup element's body reads as a member of the element.
    (let around event-source)
    (= event-source (if-expr (. row is-subscriber) (. row container) 0))
    (call walk (. row container))
    (= event-source around)
  )
  (fn-do _ walk-body Void
    (param body SyntaxId)
    ; The body of a loop or an arm. One written as one line that runs as content each time runs as
    ; a block of that line would (`walk-line`).
    (if (and (!= (call (. content-turns find) body) null) (not (is ([] (. tree nodes) body) .node-block)))
      (call walk-line body)
      (else
        (call walk body)
      )
    )
  )
  (fn-do _ walk-line Void
    (param line SyntaxId)
    ; A body of markup content written as one line, which runs as a block of that line would: the
    ; line declares the name its markup element is given and those of the elements written as
    ; lines of its body, and what makes those objects is walked first.
    (call push-scope .scope-block line)
    (call note-content-line line)
    (call declare-ids line)
    (call raise-element line true true)
    (call walk line)
    (call pop-scope)
  )
  (fn-do _ walk-clauses Void
    (param clause SyntaxId)
    (param skipped SyntaxId)
    ; The clauses of a loop's header in order, but for the one `skipped`.
    (let current clause)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) current)
        (case (call .node-clause row)
          (if (!= current skipped)
            (call walk (. row expr))
          )
          (= next (. row next))
        )
      )
      (= current next)
    )
  )
  (fn-do _ walk-whenever Void
    (param loop SyntaxId)
    ; The `whenever` clause of a loop on a stream, which the function the loop is written in tests
    ; before it subscribes: its value binds there, beside three locals no name reaches, declared at
    ; the clause, which hold what it last gave, the subscription and the broadcaster. The function
    ; that tests it again captures them, and every local, argument and receiver the value reads, and
    ; the list of subscribers of each local it reads tracked.
    (let clause (call (. tree whenever-clause) loop))
    (if (or (== clause 0) (== (call nested-decl-for clause) 0))
      (return)
    )
    (match? ([] (. tree nodes) clause)
      (case (call .node-clause row)
        (call walk (. row expr))
      )
    )
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let changes (/or/ (. SlotFlag slot-assigned) (. SlotFlag slot-captured)))
    (let passed
      (scope (as (call (. bindings slots append) passed-slot) SlotId)
        (lazy passed-slot (call Slot .slot-local whenever-name clause current-scope decl 0 changes))
      )
    )
    (call (. bindings slots append) (call Slot .slot-local subscription-name clause current-scope decl 0 kept))
    (call (. bindings slots append) (call Slot .slot-local broadcaster-name clause current-scope decl 0 kept))
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding clause (call Resolution .resolve-slot 0 passed 0 declares))
    (let slots (list SlotId))
    (+= slots passed)
    (+= slots (+ passed 1))
    (+= slots (+ passed 2))
    (call note-reads clause slots)
    (call capture-in clause slots)
  )
  (fn-expr _ leaves-block Bool
    (param statement SyntaxId)
    ; Whether a statement leaves its block, so that nothing after it runs: a raise under no
    ; condition, a return, `continue` or `break`. `=? value` may leave only where the value is
    ; present, and so does not.
    (match ([] (. tree nodes) statement)
      (case (call .node-assertion-syntax row)
        (== (. row condition) 0)
      )
      (case (call .node-return row)
        (or (== (. row expr) 0) (not (is ([] (. tree nodes) (. row expr)) .node-optional-chain)))
      )
      (case .node-continue
        true
      )
      (case .node-break
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ declares-name Bool
    (param first SlotId)
    (param name Atom)
    ; Whether a slot declared from `first` on is named `name`.
    (for (in slot (..< first (. bindings slots length)))
      (if (== (. ([] (. bindings slots) slot) name) name)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ names-item Bool
    (param pattern SyntaxId)
    ; A loop that names its item leaves an enclosing `each` and `it` in reach; one that does not
    ; binds them to its own item.
    (case? (== pattern 0)
      false
    )
    (default
      (match ([] (. tree nodes) pattern)
        (case .node-identifier
          true
        )
        (case .node-type-capture
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-do _ walk-arms Void
    (param id SyntaxId)
    ; The arms of a match or a bare condition table: a type-or chain of type-transform nodes, each
    ; binding `it` and its captures over its result.
    (if (== id 0)
      (return)
    )
    (blank)
    (match ([] (. tree nodes) id)
      (case (call .node-type-or row)
        (call walk-arms (. row left))
        (call walk-arms (. row right))
      )
      (case (call .node-type-transform row)
        (call push-scope .scope-arm id)
        (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
        (call declare-pattern (. row pattern) .slot-pattern (. SlotFlag slot-constant) 0)
        (call walk-body (. row expr))
        (call pop-scope)
      )
      (default
        (call push-scope .scope-arm id)
        (call declare-pattern id .slot-pattern (. SlotFlag slot-constant) 0)
        (call pop-scope)
      )
    )
  )
  (fn-do _ walk-transformer _
    (param body SyntaxId)
    (param catchers (of RowRange SyntaxId))
    ; A raise that declares one error transformer: its exception sees the names its catcher declares
    ; for the error it takes and for those in its chain.
    (for (in catcher ([] (. tree children) catchers))
      (match? ([] (. tree nodes) catcher)
        (case (call .node-catcher row)
          (call push-scope .scope-catch catcher)
          (call declare-pattern (. row type) .slot-pattern (. SlotFlag slot-constant) 0)
          (for (in previous ([] (. tree children) (. row previous)))
            (call declare-pattern previous .slot-pattern (. SlotFlag slot-constant) 0)
          )
          (call walk body)
          (call walk (. row body))
          (call pop-scope)
        )
      )
    )
  )
  (fn-do _ declare-pattern Void
    (param id SyntaxId)
    (param kind SlotKind)
    (param flags SlotMask)
    (param group SyntaxId)
    ; Declares every name a pattern binds and maps the declaring identifiers to their slots.
    ; Predicates and equalities inside the pattern are expressions and are walked as such.
    (if (== id 0)
      (return)
    )
    (if (== pattern-depth 0)
      (= pattern-floor (as (. names length) U32))
    )
    (+= pattern-depth 1)
    (call declare-pattern-node id kind flags group)
    (-= pattern-depth 1)
  )
  (fn-do _ declare-pattern-node Void
    (param id SyntaxId)
    (param kind SlotKind)
    (param flags SlotMask)
    (param group SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-type-capture row)
        (let name (call (. tree identifier-name) (. row id)))
        (if name
          (let slot (call declare-bound name kind id flags group))
          (let declares U32 (. ResolutionFlag resolution-declares))
          (let declared (call Resolution .resolve-slot 0 slot 0 declares))
          (call (. bindings set-resolution) binding (. row id) declared)
        )
        (if (or (== kind .slot-pattern) (== kind .slot-loop-item) (not name))
          (call declare-captured (. row type) kind flags group)
          (else
            (call walk-tests (. row type))
          )
        )
      )
      (case (call .node-identifier row)
        (let slot (call declare-bound (. row name) kind id flags group))
        (let resolution (call Resolution .resolve-slot 0 slot 0 (. ResolutionFlag resolution-declares)))
        (call (. bindings set-resolution) binding id resolution)
      )
      (case (call .node-type-remainder row)
        (call declare-pattern (. row name) kind flags group)
      )
      (case (call .node-type-property row)
        (let slot (call declare-bound (. row name) kind id flags group))
        (let resolution (call Resolution .resolve-slot 0 slot 0 (. ResolutionFlag resolution-declares)))
        (call (. bindings set-resolution) binding id resolution)
      )
      (case (call .node-structure-match row)
        (call declare-pattern (. row pattern) kind flags group)
      )
      (case (call .node-type-tuple row)
        (for (in field ([] (. tree children) (. row field-types)))
          (call declare-pattern field kind flags group)
        )
      )
      (case (call .node-type-optional row)
        (for (in field ([] (. tree children) (. row field-types)))
          (call declare-pattern field kind flags group)
        )
      )
      (case (call .node-type-list row)
        (for (in pattern ([] (. tree children) (. row patterns)))
          (call declare-pattern pattern kind flags group)
        )
      )
      (case (call .node-type-map row)
        (for (in pattern ([] (. tree children) (. row patterns)))
          (call declare-pattern pattern kind flags group)
        )
      )
      (case (call .node-type-map-item row)
        (call declare-pattern (. row key) kind flags group)
        (call declare-pattern (. row value) kind flags group)
      )
      (case (call .node-type-match row)
        (call declare-pattern (. row type) kind flags group)
      )
      (case (call .node-type-case row)
        (call declare-pattern (. row type) kind flags group)
        (call declare-pattern (. row value) kind flags group)
      )
      (case (call .node-type-or row)
        (let start (as (. names length) U32))
        (call declare-pattern (. row left) kind flags group)
        (let floor alternative-floor)
        (let ceiling alternative-ceiling)
        (= alternative-floor (if-expr (> ceiling floor) floor start))
        (= alternative-ceiling (as (. names length) U32))
        (call declare-pattern (. row right) kind flags group)
        (= alternative-floor floor)
        (= alternative-ceiling ceiling)
      )
      (case (call .node-type-and row)
        (call declare-pattern (. row left) kind flags group)
        (call declare-pattern (. row right) kind flags group)
      )
      (case (call .node-type-relation row)
        (call declare-pattern (. row left) kind flags group)
        (call declare-pattern (. row right) kind flags group)
      )
      (case (call .node-type-iterable row)
        (call declare-pattern (. row pattern) kind flags group)
      )
      (case (call .node-type-panic row)
        (call declare-pattern (. row pattern) kind flags group)
      )
      (case (call .node-type-transform row)
        (call declare-pattern (. row pattern) kind flags group)
        (call walk (. row expr))
      )
      (case (call .node-type-predicate row)
        (if (not (call lookup-slot it-name))
          (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
        )
        (call walk (. row expr))
      )
      (case (call .node-type-equality row)
        (call walk (. row expr))
      )
      (case (call .node-type-numeric row)
        (call walk (. row value))
      )
      (default
        (return)
      )
    )
  )
  (fn-do _ declare-bound SlotId
    (param name Atom)
    (param kind SlotKind)
    (param syntax SyntaxId)
    (param flags SlotMask)
    (param group SyntaxId)
    ; A name an arm's pattern binds. One that an alternative before it binds, as `n` in
    ; `| .a(n) | .b(n)`, is the slot that alternative declared, which the one taken fills; one that
    ; the same alternative binds again is an error.
    (let position (call lookup-position name))
    (if (and position (== kind .slot-pattern))
      (let earlier ([] (. bindings slots) ([] name-slots position)))
      (if (and (== (. earlier kind) kind) (== (. earlier scope) current-scope))
        (if (and (>= position alternative-floor) (< position alternative-ceiling))
          (return ([] name-slots position))
        )
        (if (>= position pattern-floor)
          (let message
            (paragraph
              (str "\"" (. name text) "\" is bound twice in this pattern; give each place a name of its own")
            )
          )
          (call (. bindings diagnostics append)
            (block
              (arg (call Diagnostic module syntax .stated (call (. program store-atom) message)))
            )
          )
        )
      )
    )
    (return (call declare name kind syntax flags group))
  )
  (fn-do _ declare-captured Void
    (param id SyntaxId)
    (param kind SlotKind)
    (param flags SlotMask)
    (param group SyntaxId)
    ; Declares what the pattern a name captures binds. A name the pattern reads from its subject
    ; is not one of them: the captured name holds what it gives.
    (if (== id 0)
      (return)
    )
    (match ([] (. tree nodes) id)
      (case .node-type-property
        (return)
      )
      (case (call .node-type-and row)
        (call declare-captured (. row left) kind flags group)
        (call declare-pattern (. row right) kind flags group)
      )
      (default
        (call declare-pattern id kind flags group)
      )
    )
  )
  (fn-do _ walk-tests Void
    (param id SyntaxId)
    ; A pattern written where the type of a declared name goes declares no name of its own, and
    ; what it tests with is walked: a condition reads `it`, which is declared for it.
    (if (== id 0)
      (return)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-type-and row)
        (call walk-tests (. row left))
        (call walk-tests (. row right))
      )
      (case (call .node-type-or row)
        (call walk-tests (. row left))
        (call walk-tests (. row right))
      )
      (case (call .node-type-predicate row)
        (if (not (call lookup-slot it-name))
          (call declare it-name .slot-it id (. SlotFlag slot-constant) 0)
        )
        (call walk (. row expr))
      )
      (case (call .node-type-equality row)
        (call walk (. row expr))
      )
      (case (call .node-type-numeric row)
        (call walk (. row value))
      )
      (case (call .node-type-capture row)
        (call walk-tests (. row type))
      )
      (case (call .node-type-match row)
        (call walk-tests (. row type))
      )
      (case (call .node-type-case row)
        (call walk-tests (. row value))
      )
      (case (call .node-type-list row)
        (for (in pattern ([] (. tree children) (. row patterns)))
          (call walk-tests pattern)
        )
      )
      (case (call .node-type-map row)
        (for (in pattern ([] (. tree children) (. row patterns)))
          (call walk-tests pattern)
        )
      )
      (case (call .node-type-map-item row)
        (call walk-tests (. row value))
      )
      (case (call .node-type-tuple row)
        (for (in field ([] (. tree children) (. row field-types)))
          (call walk-tests field)
        )
      )
    )
  )
  (fn-do _ walk-tested _
    (param id SyntaxId)
    (param pattern SyntaxId)
    (call push-scope .scope-arm id)
    (match ([] (. tree nodes) pattern)
      (case .node-type-list
        (call walk-tests pattern)
      )
      (case .node-type-map
        (call walk-tests pattern)
      )
      (case .node-type-case
        (call walk-tests pattern)
      )
      (default
        (call walk pattern)
      )
    )
    (call pop-scope)
  )
  (fn-do _ walk-held _
    (param id SyntaxId)
    (param expr SyntaxId)
    ; The middle of a chain of orderings declares a slot for its value, which no name reaches.
    ; The next ordering reads it before anything else is held, so the slot held last is the one
    ; a read resolves to.
    (call walk expr)
    (let row (call Slot .slot-held held-name id current-scope decl 0 (. SlotFlag slot-constant)))
    (= held (as (call (. bindings slots append) row) SlotId))
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 held 0 declares))
  )
  (fn-do _ resolve Void
    (param id SyntaxId)
    (param name Atom)
    (param flags ResolutionMask)
    (param assignment SyntaxId (= 0))
    (param rule Bool (= false))
    ; Resolves a name to the slot, member, global, function or type it reads. `assignment` is the
    ; plain assignment the name is the target of: one that nothing declares is reported there, as a
    ; variable that is not declared, but where the function has `this` it may name a property of a
    ; style the object sees, which the type pass decides. A `rule` a pattern calls is never a name
    ; the match captures. A function that reads the name of a markup element of the one it is
    ; written in captures the receiver too, whose property of the name it reads where the element is
    ; not made yet. A name is a member of a markup element only where it is the event a handler
    ; written in the element's body subscribes to, or a name the condition of a style rule the
    ; element applies reads (`received-level`); every other row of the body reads the scope outside
    ; the element. Such a member read where the element's body is written notes the element, for a
    ; function that gives the read again (`keep-received`).
    (let position (if-expr rule (?? (call rule-position name) (call lookup-position name)) (call lookup-position name)))
    (if (and (!= coded-depth 0) (not rule))
      (= position (call coded-position position))
    )
    (let lowest (? Size) (if-expr (== id event-source) 0 condition-level))
    (let level (? Size) null)
    (if (and (!= (. receiver-decls length) 0) (not rule) (!= lowest null))
      (= level (call received-level name position lowest))
    )
    (if level
      (let received (/or/ flags (. ResolutionFlag resolution-received)))
      (let kept (call receiver-keeper level))
      (if (== kept no-slot)
        (= ([] received-reads id) (as (. received-elements length) U32))
        (+= received-elements ([] receiver-elements level))
        (+= received-scopes ([] receiver-scopes level))
      )
      (call (. bindings set-resolution) binding id (call Resolution .resolve-unresolved 0 kept 0 received))
      (return)
    )
    (if position
      (let slot ([] name-slots position))
      (if (!= (. ([] (. bindings slots) slot) getter) 0)
        (call read-getter id slot)
        (else
          (call use-slot slot ([] name-depths position) flags)
          (if (< ([] name-depths position) function-depth)
            (call use-machine-flags slot ([] name-depths position))
            (if (call names-markup slot)
              (call hold-self)
            )
          )
        )
      )
      (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 slot 0 flags))
      (return)
    )
    (blank)
    (= outer-uses-self false)
    (let outer (call resolve-outer name))
    (if outer-uses-self
      (call capture-self)
    )
    (let kind (. DiagnosticKind name-not-found))
    (let site id)
    (if (or (== name this-name) (== name super-name))
      (= kind (. DiagnosticKind required-self))
      (else-if (or (== name it-name) (== name each-name))
        (= kind (. DiagnosticKind context-not-found))
      )
      (else-if (!= assignment 0)
        (= kind (. DiagnosticKind variable-not-declared))
        (= site assignment)
      )
    )
    (if (and unresolved (== kind .name-not-found) (!= styled-depth 0) (call styles-name name))
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg id)
          (arg
            (call Resolution
              (block
                (arg .resolve-unresolved)
                (arg 0)
                (arg no-slot)
                (arg 0)
                (arg (/or/ flags (. ResolutionFlag resolution-styled)))
              )
            )
          )
        )
      )
      (return)
    )
    (lazy unresolved (== (. outer kind) .resolve-unresolved))
    (if (and (== (. outer kind) .resolve-unresolved) (== kind .variable-not-declared) (call lookup-position this-name))
      (call capture-self)
      (if (!= function-depth 0)
        (call await-declaration id name flags (. U32 max))
      )
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg id)
          (arg
            (call Resolution
              (block
                (arg .resolve-unresolved)
                (arg 0)
                (arg no-slot)
                (arg 0)
                (arg (/or/ flags (. ResolutionFlag resolution-styled)))
              )
            )
          )
        )
      )
      (return)
    )
    (if (and (== (. outer kind) .resolve-unresolved) (!= repeating-depth 0))
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg id)
          (arg (call Resolution .resolve-unresolved 0 no-slot 0 (/or/ flags (. ResolutionFlag resolution-quiet))))
        )
      )
      (return)
    )
    (let reported (. U32 max))
    (if (and (== (. outer kind) .resolve-unresolved) (not in-callee) (!= id quiet-name))
      (= reported (as (. bindings diagnostics length) U32))
      (call (. bindings diagnostics append) (call Diagnostic module site kind name))
    )
    (let awaited (or (== kind .name-not-found) (== kind .variable-not-declared)))
    (if (and (== (. outer kind) .resolve-unresolved) (!= function-depth 0) awaited)
      (call await-declaration id name flags reported)
    )
    (let inherited (call Resolution (. outer kind) (. outer module) (. outer slot) (. outer decl) flags))
    (call (. bindings set-resolution) binding id inherited)
  )
  (fn-do _ styles-name Bool
    (param name Atom)
    ; Whether a name nothing declares, read in the value a markup element's body gives one of its
    ; attributes or a line of a style rule declares, may be one read where the line names a style
    ; property: `inherit`, a slot of a style sheet, or a case of a union that holds nothing, among
    ; the names gathered once (`list-style-names`). The type pass decides.
    (return-if true (if (== name inherit-name)))
    (blank)
    (call list-style-names)
    (return (!= ([] style-names name) null))
  )
  (fn-do _ list-style-names _
    (return-if (if style-names-listed))
    (blank)
    (= style-names-listed true)
    (for (in position (..< 0 (. program modules length)))
      (let owner ([] (. program modules) position))
      (for (in decl (. owner decls))
        (match? decl
          (case (call .decl-class row)
            (if (and (!= (. row base) 0) (== (call type-head-name (. owner tree) (. row base)) sheet-name))
              (for (in member ([] (. owner member-pool) (. row members)))
                (let named (call member-name owner member))
                (if named
                  (= ([] style-names named) true)
                )
              )
            )
          )
          (case (call .decl-case row)
            (if (and (. row name) (== (. row type-syntax) 0))
              (= ([] style-names (. row name)) true)
            )
          )
        )
      )
    )
  )
  (fn-expr _ member-name (? Atom)
    (param target Module)
    (param member DeclId)
    (match? ([] (. target decls) member)
      (case (call .decl-property row)
        (. row name)
      )
      (case (call .decl-event row)
        (. row name)
      )
      (case (call .decl-function row)
        (only-if (. row name) (if (or (== (. row kind) .getter-decl) (== (. row kind) .setter-decl))))
      )
    )
  )
  (fn-do _ use-machine-flags _
    (param slot SlotId)
    (param depth U32)
    ; A function inside the one that keeps a state machine in a local, which reads the local, reads
    ; the machine's flags too, which a case test of the local reads.
    (for (in row (. bindings machines))
      (if (== (. row bound) slot)
        (for (in offset (..< 0 (. row slots count)))
          (let flag (+ (. row slots start) offset))
          (if (== (. ([] (. bindings slots) flag) scope) (. ([] (. bindings slots) slot) scope))
            (call use-slot flag depth 0)
          )
        )
      )
    )
  )
  (fn-do _ use-slot _
    (param slot SlotId)
    (param depth U32)
    (param flags ResolutionMask)
    ; What a read of a local does: a function the read is in, inside the one that declares the
    ; local, captures it, and a tracked read the list of subscribers of that function too, as does
    ; a store from such a function where the one that declares the local reads it tracked.
    (let slot-flags (call use-flags flags (< depth function-depth)))
    (if (< depth function-depth)
      (call record-capture slot depth (== (. ([] (. bindings slots) slot) kind) .slot-this) flags)
    )
    (if (!= slot-flags 0)
      (call (. bindings mark-slot) slot slot-flags)
    )
    (if (== (. ([] (. bindings slots) slot) kind) .slot-lazy)
      (call note-lazy-use slot flags)
    )
    (let tracked (!= (/and/ flags (. ResolutionFlag resolution-tracked)) 0))
    (let stored (and (!= (/and/ flags (. ResolutionFlag resolution-write)) 0) (< depth function-depth)))
    (if (and (call (. bindings is-trackable) slot) (or tracked (and stored (call reads-tracked (. ([] (. bindings slots) slot) name) slot))))
      (let subscribers (call subscribers-of slot))
      (if (< depth function-depth)
        (call (. bindings mark-slot) subscribers (. SlotFlag slot-captured))
        (call record-capture subscribers depth false)
      )
    )
  )
  (fn-do _ note-getters _
    (param loop SyntaxId)
    (param body SyntaxId)
    ; Keeps the declarations written as lines of the row of a markup loop region that are read as
    ; getters, declaring each where it is written and evaluating its value again at each read: a
    ; lazy one, and in the row of a loop keyed by a clause, one whose value reads the item by a name
    ; the row gives it, or another such local. A row of a keyed loop over anything but a collection
    ; is no such row; that is declined where the row is typed.
    (let keyed (!= (call (. tree keyed-clause) loop) 0))
    (let dependent (list Atom))
    (if keyed
      (+= dependent each-name)
      (+= dependent it-name)
      (match? ([] (. tree nodes) loop)
        (case (call .node-loop-syntax row)
          (match? ([] (. tree nodes) (. row pattern))
            (case (call .node-type-capture capture)
              (let named (call (. tree identifier-name) (. capture id)))
              (if named
                (+= dependent named)
              )
            )
          )
        )
      )
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-declare row)
              (let name (only-if (call declared-name (. row left)) (if (is ([] (. tree nodes) (. row left)) .node-type-capture))))
              (let plain
                (scope (and (not (. row is-pattern)) (!= (. row right) 0) (!= name null) no-machine)
                  (lazy no-machine (== (call (. tree declared-machine) (. row right)) 0))
                )
              )
              (if (and plain (or (. row is-lazy) (and keyed (call reads-any (. row right) dependent))))
                (+= row-getters statement)
                (if keyed
                  (+= dependent (!! name))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ reads-any Bool
    (param value SyntaxId)
    (param names (list Atom))
    (for (in node (..< (call (. tree subtree-start) value) (+ value 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (if (!= (call (. names find) (. row name)) null)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ note-getter-reads _
    (param declaration SyntaxId)
    (param value SyntaxId)
    ; Keeps, for a row local read as a getter, each name its value reads and what the name reaches
    ; where the value is written: a local, or none, and whether a member is read, which needs the
    ; receiver.
    (+= getter-decls declaration)
    (+= getter-firsts (. getter-names length))
    (let selfish false)
    (let first (. getter-names length))
    (for (in node (..< (call (. tree subtree-start) value) (+ value 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (let read (call (. bindings resolution-of) binding node))
          (if (== (. read kind) .resolve-member)
            (= selfish true)
          )
          (let seen false)
          (for (in position (..< first (. getter-names length)))
            (if (== ([] getter-names position) (. row name))
              (= ([] getter-flags position) (/or/ ([] getter-flags position) (. read flags)))
              (= seen true)
            )
          )
          (if (not seen)
            (let position (call lookup-position (. row name)))
            (+= getter-names (. row name))
            (+= getter-nodes node)
            (+= getter-slots (if-expr position ([] name-slots position) no-slot))
            (+= getter-depths (if-expr position ([] name-depths position) 0u32))
            (+= getter-flags (. read flags))
          )
        )
      )
    )
    (+= getter-ends (. getter-names length))
    (+= getter-selves selfish)
  )
  (fn-do _ read-getter _
    (param id SyntaxId)
    (param slot SlotId)
    ; A read of a row local read as a getter, which evaluates the local's value again where it is
    ; read: each name the value reads is read here, so a function the read is in captures it, and
    ; one that reaches another local here than where the value is written is an error, reported at
    ; the read.
    (let getter (. ([] (. bindings slots) slot) getter))
    (let index (call (. getter-decls find) getter))
    (if (== index null)
      (return)
    )
    (let first ([] getter-firsts index))
    (let end ([] getter-ends index))
    (for (in position (..< first end))
      (let name ([] getter-names position))
      (let here (call lookup-position name))
      (let reached (if-expr here ([] name-slots here) no-slot))
      (if (!= reached ([] getter-slots position))
        (let message
          (paragraph
            (str "Markup row local " (. ([] (. bindings slots) slot) name text) " reads " (. name text) ", which is shadowed here; rename one of them")
          )
        )
        (call (. bindings diagnostics append) (call Diagnostic module id .stated (call (. program store-atom) message)))
        (return)
      )
    )
    (for (in position (..< first end))
      (let read ([] getter-slots position))
      (if (!= read no-slot)
        (if (!= (. ([] (. bindings slots) read) getter) 0)
          (call read-getter ([] getter-nodes position) read)
          (else
            (call use-slot read ([] getter-depths position) ([] getter-flags position))
          )
        )
      )
    )
    (if ([] getter-selves index)
      (call capture-self)
    )
  )
  (fn-do _ subscribers-of SlotId
    (param slot SlotId)
    ; The hidden local that holds the list of subscribers of the function that declares a local read
    ; tracked, which is made where that function starts and every tracked read of its locals goes
    ; through. It is declared once, in the function's own scope.
    (let home (call function-of (. ([] (. bindings slots) slot) scope)))
    (for (in held subscriber-slots)
      (if (== (. ([] (. bindings slots) held) scope) home)
        (return held)
      )
    )
    (let flags (. SlotFlag slot-constant))
    (let made
      (scope (as (call (. bindings slots append) subscribers) SlotId)
        (lazy subscribers (call Slot .slot-subscribers subscribers-name home-syntax home decl 0 flags))
        (lazy home-syntax (. ([] (. bindings scopes) home) syntax))
      )
    )
    (+= subscriber-slots made)
    (return made)
  )
  (fn-do _ builder-of SlotId
    (param name Atom)
    ; The hidden local that holds the function that builds the slot of a name, which the function
    ; that fills an object with the markup of its class is given, declared once in that function's
    ; own scope.
    (for (in held builder-slots)
      (if (== (. ([] (. bindings slots) held) name) name)
        (return held)
      )
    )
    (let flags (. SlotFlag slot-constant))
    (let made
      (scope (as (call (. bindings slots append) builder) SlotId)
        (lazy builder (call Slot .slot-builder name home-syntax content-home decl 0 flags))
        (lazy home-syntax (. ([] (. bindings scopes) content-home) syntax))
      )
    )
    (+= builder-slots made)
    (return made)
  )
  (fn-do _ walk-latest Void
    (param id SyntaxId)
    ; The latest item of a stream, read in a live action: the tracker that holds it is kept in a
    ; local no name reaches, declared at the read, which the function that runs the action again
    ; captures.
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let slot
      (scope (as (call (. bindings slots append) tracker) SlotId)
        (lazy tracker (call Slot .slot-local tracker-name id current-scope decl 0 kept))
      )
    )
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 slot 0 declares))
  )
  (fn-do _ walk-live Void
    (param id SyntaxId)
    ; The function that runs a live statement again: it captures every local, argument and
    ; receiver the statement reads or writes, the local a declaration declares, with the list of
    ; subscribers it stores through where the function that declares it reads it tracked, and the
    ; list of subscribers of each local it reads tracked, so that it reaches them where the
    ; enclosing function keeps them.
    (let live (call nested-decl-for id))
    (if (== live 0)
      (return)
    )
    (let slots (list SlotId))
    (match? ([] (. tree nodes) id)
      (case (call .node-declare row)
        (let named (. row left))
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= named (. capture id))
          )
        )
        (let declared (call (. tree identifier-name) named))
        (let found (only-if (call lookup-position declared) (if declared)))
        (if found
          (+= slots ([] name-slots found))
          (if (call reads-tracked (!! declared) ([] name-slots found))
            (+= slots (call subscribers-of ([] name-slots found)))
          )
        )
      )
    )
    (call note-reads id slots)
    (call capture-in id slots)
  )
  (fn-do _ reads-tracked Bool
    (param name Atom)
    (param slot SlotId)
    ; Whether the function that declares a local reads a local of its name tracked anywhere in it,
    ; alone or as the object a tracked member is read from, though later than here.
    (let home (. ([] (. bindings scopes) (call function-of (. ([] (. bindings slots) slot) scope))) syntax))
    (for (in node (.. (call (. tree subtree-start) home) home))
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (if (and (. row is-tracked) (== (. row name) name))
            (return true)
          )
        )
        (case (call .node-get-expression row)
          (if (. row is-tracked)
            (match? ([] (. tree nodes) (. row object))
              (case (call .node-identifier root)
                (if (== (. root name) name)
                  (return true)
                )
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ is-branch Bool
    (param id SyntaxId)
    ; Whether an `if` or a `match` is a markup branch region, whose arm a function of its own
    ; selects again.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .branch-decl))
      )
    )
    (return false)
  )
  (fn-do _ is-selector Bool
    (param id SyntaxId)
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .selector-decl))
      )
    )
    (return false)
  )
  (fn-do _ selects Bool
    (param control SyntaxId)
    (let anchor (call (. tree selector-anchor) control))
    (return-if false (if (== anchor 0)))
    (blank)
    (let decl (call nested-decl-for anchor))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .selector-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-selector Void
    (param id SyntaxId)
    (+= branch-depth 1)
    (match? ([] (. tree nodes) id)
      (case (call .node-match-expression row)
        (call walk (. row subject))
      )
    )
    (for (in arm (call (. tree region-arms) id))
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (if (!= (. row condition) 0)
            (call walk (. row condition))
          )
        )
        (case (call .node-type-transform row)
          (if (!= (. row pattern) 0)
            (call push-scope .scope-arm arm)
            (call walk (. row pattern))
            (call pop-scope)
          )
        )
      )
    )
    (-= branch-depth 1)
    (call walk-chosen-fills id)
  )
  (fn-do _ walk-chosen-fills Void
    (param control SyntaxId)
    (let slots (list SlotId))
    (match? ([] (. tree nodes) control)
      (case (call .node-match-expression row)
        (call note-reads (. row subject) slots true)
      )
    )
    (for (in arm (call (. tree region-arms) control))
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (if (!= (. row condition) 0)
            (call note-reads (. row condition) slots true)
          )
        )
        (case (call .node-type-transform row)
          (if (!= (. row pattern) 0)
            (call note-reads (. row pattern) slots true)
          )
        )
      )
      (let pattern (call (. tree arm-pattern) arm))
      (let bound (list Atom))
      (if (!= pattern 0)
        (call (. tree pattern-names) pattern bound)
      )
      (if (!= (. bound length) 0)
        (call push-scope .scope-arm arm)
        (call declare-pattern pattern .slot-pattern (. SlotFlag slot-constant) 0)
      )
      (match? ([] (. tree nodes) (call (. tree region-arm-body) arm))
        (case (call .node-block block)
          (for (in line ([] (. tree children) (. block body)))
            (match? ([] (. tree nodes) line)
              (case (call .node-markup row)
                (if (and (!= (. row slot-binding) 0) (call is-slot-builder line))
                  (call walk-slot line (. row id) (. row type-id) (. row body))
                )
              )
              (case .node-markup-slot-forward
                (call walk line)
              )
            )
          )
        )
      )
      (if (!= (. bound length) 0)
        (call pop-scope)
      )
    )
    (call capture-in (call (. tree selector-anchor) control) slots)
  )
  (fn-do _ walk-branch Void
    (param id SyntaxId)
    ; A markup branch region: its conditions are read where the `if` is written, to select the first
    ; arm, and each arm's body is built by a function of its own (`walk-arm`). The host of the
    ; region and the region itself are kept in two locals no name reaches, declared at the `if`,
    ; which the function that selects the arm again captures with every local, argument and receiver
    ; the conditions read and the list of subscribers of each local they read tracked. Each later
    ; arm, which follows the `if` in the tree, resolves to the first of those locals too, which the
    ; `if` declares. A third such local keeps the batch in force where the region is written, which
    ; each arm captures. An arm written with a pattern, `if | x = v`, is read and built as an arm of
    ; a match region is (`walk-match-arm`): its subject is read where the `if` is written, and again
    ; by the function that builds the arm.
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let host
      (scope (as (call (. bindings slots append) host-slot) SlotId)
        (lazy host-slot (call Slot .slot-local branch-host-name id current-scope decl 0 kept))
      )
    )
    (call (. bindings slots append) (call Slot .slot-local branch-region-name id current-scope decl 0 kept))
    (call (. bindings slots append) (call Slot .slot-local batch-root-name id current-scope decl 0 kept))
    (let declares (. ResolutionFlag resolution-declares))
    (call (. bindings set-resolution) binding id (call Resolution .resolve-slot 0 host 0 declares))
    (+= branch-depth 1)
    (let arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (if (!= arm id)
            (call (. bindings set-resolution) binding arm (call Resolution .resolve-slot 0 host 0 0))
          )
          (let pattern (call (. tree pattern-arm) arm))
          (if (!= pattern 0)
            (let subject (call (. tree matched-subject) (. row condition)))
            (call walk subject)
            (let read (list SlotId))
            (+= read host)
            (call note-reads subject read true)
            (call walk-match-arm pattern (call (. tree arm-body) arm) (+ host 2) read)
            (else
              (call walk (. row condition))
              (call walk-arm (. row body) (+ host 2))
            )
          )
          (= next (. row next))
        )
      )
      (= arm next)
    )
    (-= branch-depth 1)
    (let slots (list SlotId))
    (+= slots host)
    (+= slots (+ host 1))
    (= arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (let pattern (call (. tree pattern-arm) arm))
          (if (!= pattern 0)
            (call note-reads (call (. tree matched-subject) (. row condition)) slots true)
            (match? ([] (. tree nodes) pattern)
              (case (call .node-type-transform transform)
                (if (!= (. transform pattern) 0)
                  (call note-reads (. transform pattern) slots true)
                )
              )
            )
            (else-if (!= (. row condition) 0)
              (call note-reads (. row condition) slots)
            )
          )
          (= next (. row next))
        )
      )
      (= arm next)
    )
    (call capture-in id slots)
  )
  (fn-do _ walk-match-region Void
    (param id SyntaxId)
    (param subject SyntaxId)
    ; A markup match region: its subject is read where the `match` is written and each arm's pattern
    ; tested against it, to select the first arm, and each arm is built by a function of its own
    ; (`walk-match-arm`), which reads the subject again. The host, the region and the batch in force
    ; are kept in three locals no name reaches, declared at the `match`, as those of a branch region
    ; are (`walk-branch`); the function that selects the arm again captures them with what the
    ; subject and the patterns read.
    (call walk subject)
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let host
      (scope (as (call (. bindings slots append) host-slot) SlotId)
        (lazy host-slot (call Slot .slot-local branch-host-name id current-scope decl 0 kept))
      )
    )
    (call (. bindings slots append) (call Slot .slot-local branch-region-name id current-scope decl 0 kept))
    (call (. bindings slots append) (call Slot .slot-local batch-root-name id current-scope decl 0 kept))
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg id)
        (arg (call Resolution .resolve-slot 0 host 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (let read (list SlotId))
    (+= read host)
    (call note-reads subject read true)
    (let arms (list SyntaxId))
    (call (. tree match-arms) id arms)
    (+= branch-depth 1)
    (for (in arm arms)
      (call walk-match-arm arm (call (. tree region-arm-body) arm) (+ host 2) read)
    )
    (-= branch-depth 1)
    (let slots (list SlotId))
    (+= slots host)
    (+= slots (+ host 1))
    (call note-reads subject slots true)
    (for (in arm arms)
      (match? ([] (. tree nodes) arm)
        (case (call .node-type-transform row)
          (if (!= (. row pattern) 0)
            (call note-reads (. row pattern) slots true)
          )
        )
      )
    )
    (call capture-in id slots)
  )
  (fn-do _ walk-match-arm Void
    (param arm SyntaxId)
    (param body SyntaxId)
    (param root SlotId)
    (param read (list SlotId))
    ; The function that builds an arm of a markup match region, or of a branch region written with
    ; a pattern, at `body`: given the region, as an arm of a branch region is (`walk-arm`), it reads
    ; the subject again, with what it captures of `read`, and binds `it` and the names the arm's
    ; pattern declares before its body runs.
    (match? ([] (. tree nodes) arm)
      (case (call .node-type-transform row)
        (call push-scope .scope-nested body)
        (+= function-depth 1)
        (call open-nested body)
        (call record-capture root (call slot-depth root) false)
        (for (in slot read)
          (call (. bindings mark-slot) slot (. SlotFlag slot-captured))
          (call record-capture slot (call slot-depth slot) (== (. ([] (. bindings slots) slot) kind) .slot-this))
        )
        (let given (as (call (. bindings slots append) parent) SlotId))
        (lazy parent (call Slot .slot-argument branch-parent-name body current-scope decl 0 constant))
        (lazy constant (. SlotFlag slot-constant))
        (call (. bindings set-resolution)
          (block
            (arg binding)
            (arg body)
            (arg (call Resolution .resolve-slot 0 given 0 (. ResolutionFlag resolution-declares)))
          )
        )
        (call push-scope .scope-arm arm)
        (call declare it-name .slot-it arm (. SlotFlag slot-constant) 0)
        (call declare-pattern (. row pattern) .slot-pattern (. SlotFlag slot-constant) 0)
        (call walk-body body)
        (call walk-arm-lines body)
        (call pop-scope)
        (call close-nested)
        (-= function-depth 1)
        (call pop-scope)
      )
    )
  )
  (fn-do _ walk-arm Void
    (param body SyntaxId)
    (param root SlotId)
    ; The function that builds an arm of a markup branch region: its one argument, which no name
    ; reaches, is the region, and the arm's body runs as content of it. It captures like a lambda,
    ; and captures the local that keeps the batch in force where the region is written.
    (call push-scope .scope-nested body)
    (+= function-depth 1)
    (call open-nested body)
    (call record-capture root (call slot-depth root) false)
    (let given
      (scope (as (call (. bindings slots append) parent) SlotId)
        (lazy parent (call Slot .slot-argument branch-parent-name body current-scope decl 0 constant))
        (lazy constant (. SlotFlag slot-constant))
      )
    )
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg body)
        (arg (call Resolution .resolve-slot 0 given 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (call walk-body body)
    (call walk-arm-lines body)
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-arm-lines Void
    (param body SyntaxId)
    ; The functions that give lines of an arm's body content again, as those of an element's body
    ; are (`walk-attribute`), where the region takes them.
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (call is-live statement) (call (. tree content-line) statement))
            (call walk-attribute statement)
          )
        )
      )
    )
  )
  (fn-do _ is-loop-region Bool
    (param id SyntaxId)
    ; Whether a `for` is a markup loop region, whose container a function of its own reads again.
    (let decl (call nested-decl-for id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .source-decl))
      )
    )
    (return false)
  )
  (fn-do _ walk-loop-region Void
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    ; A markup loop region: its container is read where the `for` is written, and each row is built
    ; by a function of its own (`walk-row`), and keyed by one where the loop is keyed (`walk-key`).
    ; The host of the region and the region itself are kept in two locals no name reaches, declared
    ; at the `for`, which the function that reads the container again captures with every local,
    ; argument and receiver the container reads and the list of subscribers of each local it reads
    ; tracked. A third such local keeps the batch in force where the region is written, which the
    ; row's function captures.
    (let container SyntaxId 0)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (= container (. row container))
      )
    )
    (call walk container)
    (let kept (/or/ (. SlotFlag slot-constant) (. SlotFlag slot-captured)))
    (let host
      (scope (as (call (. bindings slots append) host-slot) SlotId)
        (lazy host-slot (call Slot .slot-local loop-host-name id current-scope decl 0 kept))
      )
    )
    (call (. bindings slots append) (call Slot .slot-local loop-region-name id current-scope decl 0 kept))
    (call (. bindings slots append) (call Slot .slot-local batch-root-name id current-scope decl 0 kept))
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg id)
        (arg (call Resolution .resolve-slot 0 host 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (+= branch-depth 1)
    (call walk-row loop body (+ host 2))
    (let clause (call (. tree keyed-clause) loop))
    (if (!= clause 0)
      (call walk-key loop clause)
    )
    (let filter (call (. tree when-clause) loop))
    (if (!= filter 0)
      (call walk-key loop filter)
    )
    (-= branch-depth 1)
    (let slots (list SlotId))
    (+= slots host)
    (+= slots (+ host 1))
    (call note-reads container slots true)
    (call capture-in id slots)
  )
  (fn-do _ walk-row Void
    (param loop SyntaxId)
    (param body SyntaxId)
    (param root SlotId)
    ; The function that builds a row of a markup loop region: its one argument is the row's item,
    ; which the name the loop's header writes, `each` and `it` all reach, and the loop's body gives
    ; the row. The argument resolves at the body. It captures like a lambda, and captures the local
    ; that keeps the batch in force where the region is written.
    (call push-scope .scope-nested body)
    (+= function-depth 1)
    (call open-nested body)
    (call record-capture root (call slot-depth root) false)
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (= pattern (. row pattern))
      )
    )
    (let given no-slot)
    (if (call names-item pattern)
      (call declare-pattern pattern .slot-argument 0 0)
      (let named pattern)
      (match? ([] (. tree nodes) pattern)
        (case (call .node-type-capture capture)
          (= named (. capture id))
        )
      )
      (= given (. (call (. bindings resolution-of) binding named) slot))
      (else
        (= given (call declare each-name .slot-argument body 0 0))
      )
    )
    (call (. bindings set-resolution) binding body (call Resolution .resolve-slot 0 given 0 0))
    (let regioned (call (. tree row-region) body))
    (if regioned
      (let parent
        (call Slot
          (block
            (arg .slot-argument)
            (arg branch-parent-name)
            (arg loop)
            (arg current-scope)
            (arg decl)
            (arg 0)
            (arg (. SlotFlag slot-constant))
          )
        )
      )
      (let region (as (call (. bindings slots append) parent) SlotId))
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg loop)
          (arg (call Resolution .resolve-slot 0 region 0 (. ResolutionFlag resolution-declares)))
        )
      )
    )
    (if (!= (. ([] (. bindings slots) given) name) each-name)
      (call alias each-name given)
    )
    (call alias it-name given)
    (call note-getters loop body)
    (call walk body)
    (if regioned
      (call walk-arm-lines body)
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ walk-key Void
    (param loop SyntaxId)
    (param clause SyntaxId)
    ; The function that keys a row of a markup loop region: its one argument is the row's item,
    ; which the name the loop's header writes, `each` and `it` all reach, and it gives the value of
    ; the `keyed by` clause. The argument resolves at the clause. It captures like a lambda.
    (call push-scope .scope-nested clause)
    (+= function-depth 1)
    (call open-nested clause)
    (let name each-name)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-capture capture)
            (= name (?? (call (. tree identifier-name) (. capture id)) each-name))
          )
        )
      )
    )
    (let given (call declare name .slot-argument clause 0 0))
    (call (. bindings set-resolution)
      (block
        (arg binding)
        (arg clause)
        (arg (call Resolution .resolve-slot 0 given 0 (. ResolutionFlag resolution-declares)))
      )
    )
    (if (!= name each-name)
      (call alias each-name given)
    )
    (call alias it-name given)
    (match? ([] (. tree nodes) clause)
      (case (call .node-clause row)
        (call walk (. row expr))
      )
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ alias _
    (param name Atom)
    (param slot SlotId)
    ; Brings a slot declared under one name into reach by another too.
    (let hidden (?? ([] latest-names name) (. U32 max)))
    (+= name-links hidden)
    (= ([] latest-names name) (as (. names length) U32))
    (+= names name)
    (+= name-slots slot)
    (+= name-depths function-depth)
  )
  (fn-do _ note-reads _
    (param id SyntaxId)
    (param slots (list SlotId))
    (param itself Bool (= false))
    ; Adds to `slots` once each the locals, arguments and receiver the nodes below a node read or
    ; write, and the node itself where `itself` says, but those of a function inside, the local that
    ; keeps a markup element whose member one reads by its name alone (`receiver-keeper`), and the
    ; list of subscribers of each local read tracked. A row local read as a getter is none of
    ; them: what its value reads is.
    (let this-slot no-slot)
    (let position (call lookup-position this-name))
    (if position
      (= this-slot ([] name-slots position))
    )
    (let end (if-expr itself (+ id 1) id))
    (for (in node (..< (call (. tree subtree-start) id) end))
      (let resolution (call (. bindings resolution-of) binding node))
      (let slot no-slot)
      (let received (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-received)) 0))
      (if (or (== (. resolution kind) .resolve-slot) received)
        (= slot (. resolution slot))
        (else-if (or (== (. resolution kind) .resolve-member) (call names-method resolution) (call reads-own-style node))
          (= slot this-slot)
        )
      )
      (if (or (== slot no-slot) (> (call slot-depth slot) function-depth))
        (continue)
      )
      (if (!= (. ([] (. bindings slots) slot) getter) 0)
        (call note-getter-slots slot slots this-slot)
        (continue)
      )
      (call note-slot slot slots (if-expr (not received) (. resolution flags) 0))
    )
  )
  (fn-do _ reads-own-style Bool
    (param node SyntaxId)
    (match? ([] (. tree nodes) node)
      (case (call .node-style-read-expression row)
        (return (== (. row object) 0))
      )
    )
    (return false)
  )
  (fn-do _ note-slot _
    (param slot SlotId)
    (param slots (list SlotId))
    (param flags ResolutionMask)
    ; Adds a slot to `slots` once, with the list of subscribers where it is read tracked, or
    ; stored to where the function that declares it reads it tracked.
    (if (== (call (. slots find) slot) null)
      (+= slots slot)
    )
    (let tracked (!= (/and/ flags (. ResolutionFlag resolution-tracked)) 0))
    (let stored (!= (/and/ flags (. ResolutionFlag resolution-write)) 0))
    (if (and (call (. bindings is-trackable) slot) (or tracked (and stored (call reads-tracked (. ([] (. bindings slots) slot) name) slot))))
      (let subscribers (call subscribers-of slot))
      (if (== (call (. slots find) subscribers) null)
        (+= slots subscribers)
      )
    )
  )
  (fn-do _ note-getter-slots _
    (param slot SlotId)
    (param slots (list SlotId))
    (param this-slot SlotId)
    ; Adds to `slots` once each the locals a row local read as a getter reads where its value is
    ; written, through the getters among them, with the list of subscribers of each it reads
    ; tracked, and the receiver where the value reads a member.
    (let index (call (. getter-decls find) (. ([] (. bindings slots) slot) getter)))
    (if (== index null)
      (return)
    )
    (for (in position (..< ([] getter-firsts index) ([] getter-ends index)))
      (let read ([] getter-slots position))
      (if (== read no-slot)
        (continue)
      )
      (if (!= (. ([] (. bindings slots) read) getter) 0)
        (call note-getter-slots read slots this-slot)
        (else
          (call note-slot read slots ([] getter-flags position))
        )
      )
    )
    (if (and ([] getter-selves index) (!= this-slot no-slot) (== (call (. slots find) this-slot) null))
      (+= slots this-slot)
    )
  )
  (fn-do _ capture-in _
    (param id SyntaxId)
    (param slots (list SlotId))
    ; Opens the nested function declared at a node to capture each of `slots` where the
    ; enclosing function keeps it.
    (call push-scope .scope-nested id)
    (+= function-depth 1)
    (call open-nested id)
    (for (in slot slots)
      (call (. bindings mark-slot) slot (. SlotFlag slot-captured))
      (call record-capture slot (call slot-depth slot) (== (. ([] (. bindings slots) slot) kind) .slot-this))
    )
    (call close-nested)
    (-= function-depth 1)
    (call pop-scope)
  )
  (fn-do _ slot-depth U32
    (param slot SlotId)
    ; How many nested functions lie around the scope that declares a slot.
    (let depth 0u32)
    (let scope (. ([] (. bindings slots) slot) scope))
    (while (!= (. ([] (. bindings scopes) scope) kind) .scope-function)
      (if (== (. ([] (. bindings scopes) scope) kind) .scope-nested)
        (+= depth 1)
      )
      (= scope (. ([] (. bindings scopes) scope) parent))
    )
    (return depth)
  )
  (fn-do _ use-flags SlotMask
    (param flags ResolutionMask)
    (param captured Bool)
    (let slot-flags (if-expr captured (. SlotFlag slot-captured) 0u32))
    (if (!= (/and/ flags (. ResolutionFlag resolution-write)) 0)
      (= slot-flags (/or/ slot-flags (. SlotFlag slot-assigned)))
      (if (not captured)
        (= slot-flags (/or/ slot-flags (. SlotFlag slot-assigned-own)))
      )
    )
    (if (!= (/and/ flags (. ResolutionFlag resolution-ref)) 0)
      (= slot-flags (/or/ slot-flags (. SlotFlag slot-address-taken)))
    )
    (if (!= (/and/ flags (. ResolutionFlag resolution-tracked)) 0)
      (= slot-flags (/or/ slot-flags (. SlotFlag slot-tracked)))
    )
    (return slot-flags)
  )
  (fn-do _ await-declaration _
    (param id SyntaxId)
    (param name Atom)
    (param flags ResolutionMask)
    (param reported U32)
    ; A nested function's body resolves when the function is first called, so a name in it that
    ; nothing declares yet waits for a local that an enclosing block declares later.
    (+= late-ids id)
    (+= late-names name)
    (+= late-flags flags)
    (+= late-scopes current-scope)
    (+= late-depths function-depth)
    (+= late-diagnostics reported)
    (+= late-frames (. late-frame-decls length))
    (for (in frame (..< 0 (. nested-decls length)))
      (+= late-frame-decls ([] nested-decls frame))
      (+= late-frame-depths ([] nested-depths frame))
      (+= late-frame-values ([] nested-by-value frame))
    )
  )
  (fn-do _ settle-late _
    (param name Atom)
    (param slot SlotId)
    ; Gives a new local to the waiting names it is declared in time for: those of nested functions
    ; written earlier in the declaring block or in a block inside it. A task body captures by
    ; value where it is written, so it never waits.
    (for (in index (..< 0 (. late-ids length)))
      (if (and (== ([] late-names index) name) (> ([] late-depths index) function-depth))
        (if (and (call encloses current-scope ([] late-scopes index)) (not (call waits-by-value index)))
          (let flags ([] late-flags index))
          (call (. bindings mark-slot) slot (call use-flags flags true))
          (let found (call Resolution .resolve-slot 0 slot 0 flags))
          (call (. bindings set-resolution) binding ([] late-ids index) found)
          (for (in frame (..< ([] late-frames index) (call frames-end index)))
            (if (> ([] late-frame-depths frame) function-depth)
              (call add-capture ([] late-frame-decls frame) slot)
            )
          )
          (call retract index)
          (= ([] late-depths index) 0)
        )
      )
    )
  )
  (fn-expr _ frames-end Size
    (param index Size)
    (if-expr (< (+ index 1) (. late-frames length)) ([] late-frames (+ index 1)) (. late-frame-decls length))
  )
  (fn-do _ waits-by-value Bool
    (param index Size)
    (for (in frame (..< ([] late-frames index) (call frames-end index)))
      (if (and (> ([] late-frame-depths frame) function-depth) ([] late-frame-values frame))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ encloses Bool
    (param outer ScopeId)
    (param inner ScopeId)
    (let scope inner)
    (while (!= scope outer)
      (let parent (. ([] (. bindings scopes) scope) parent))
      (if (>= parent scope)
        (return false)
      )
      (= scope parent)
    )
    (return true)
  )
  (fn-do _ add-capture _
    (param nested DeclId)
    (param slot SlotId)
    ; A closed nested function gains a capture: its row moves to the end of the capture store with
    ; the new slot last.
    (let first Size (. ([] (. bindings bindings) binding) nested start))
    (for (in position (..< first (. bindings nested length)))
      (if (== (. ([] (. bindings nested) position) decl) nested)
        (let held (. ([] (. bindings nested) position) captures))
        (for (in offset (..< 0 (. held count)))
          (if (== (. ([] (. bindings captures) (+ (. held start) offset)) slot) slot)
            (return)
          )
        )
        (let start U32 (as (. bindings captures length) U32))
        (for (in offset (..< 0 (. held count)))
          (let capture ([] (. bindings captures) (+ (. held start) offset)))
          (call (. bindings record-capture) (. capture slot) (. capture flags))
        )
        (call (. bindings record-capture) slot 0)
        (= (. ([] (. bindings nested) position) captures) (call (. bindings captures-from) start))
        (return)
      )
    )
  )
  (fn-do _ retract _
    (param index Size)
    ; Withdraws the name-not-found diagnostic of a name that a later local resolved.
    (let row ([] late-diagnostics index))
    (if (== row (. U32 max))
      (return)
    )
    (let last (- (. bindings diagnostics length) 1))
    (for (in position (..< row last))
      (let moved ([] (. bindings diagnostics) (+ position 1)))
      (let shifted (call Diagnostic (. moved module) (. moved syntax) (. moved kind) (. moved name) (. moved earlier)))
      (= ([] (. bindings diagnostics) position) shifted)
    )
    (call (. bindings diagnostics truncate) last)
    (for (in other (..< 0 (. late-diagnostics length)))
      (if (and (!= ([] late-diagnostics other) (. U32 max)) (> ([] late-diagnostics other) row))
        (-= ([] late-diagnostics other) 1)
      )
    )
    (= ([] late-diagnostics index) (. U32 max))
  )
  (fn-do _ resolve-stack-local _
    (param id SyntaxId)
    (param name Atom)
    (let bindable (list Candidate))
    (for (in candidate (call (. program lookup) module name))
      (if (and (call is-stack-bindable candidate) (not (call holds-candidate bindable candidate)))
        (+= bindable candidate)
      )
    )
    (if (== (. bindable length) 0)
      (call (. bindings diagnostics append) (call Diagnostic module id .name-not-found name))
      (return)
    )
    (let chosen ([] bindable 0))
    (let problem (call stack-binding-problem name bindable))
    (if problem
      (call (. bindings diagnostics append) (call Diagnostic module id .stated (call (. program store-atom) problem)))
      (return)
    )
    (call (. bindings set-resolution) binding id (call Resolution .resolve-global (. chosen module) no-slot (. chosen decl) 0))
  )
  (fn-do _ is-stack-bindable Bool
    (param candidate Candidate)
    (let reaches (call (. program reaches-private) module (. candidate module)))
    (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
      (case (call .decl-property row)
        (return (and (== (. row owner) 0) (or (call is-public (. row access)) reaches)))
      )
      (case (call .decl-effect row)
        (return (or (call is-public (. row access)) reaches))
      )
    )
    (return false)
  )
  (fn-do _ holds-candidate Bool
    (param found (list Candidate))
    (param candidate Candidate)
    (for (in each found)
      (return-if true (if (and (== (. each module) (. candidate module)) (== (. each decl) (. candidate decl)))))
    )
    (return false)
  )
  (fn-do _ stack-binding-problem (? String)
    (param name Atom)
    (param bindable (list Candidate))
    (let chosen ([] bindable 0))
    (let imported (list Candidate))
    (let named (list String))
    (for (in each bindable)
      (if (!= (. each module) module)
        (+= imported each)
        (+= named (call stack-candidate-text each))
      )
    )
    (if (== (. chosen module) module)
      (for (in other imported)
        (if (call is-effect-candidate other)
          (return (str "This module's global '" (. name text) "' hides " (call stack-candidate-text other) ". Rename the global to bind the effect."))
        )
      )
    )
    (if (> (. imported length) 1)
      (return (str "'" (. name text) "' names more than one value a do-with can bind: " (call (. ", " join) named) ". Import only the one meant."))
    )
    (if (not (or (call is-effect-candidate chosen) (call is-stack-global chosen)))
      (return (str "'" (. name text) "' is a global that is not @stack, so a do-with cannot bind it"))
    )
    (return null)
  )
  (fn-do _ is-effect-candidate Bool
    (param candidate Candidate)
    (return (is ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl)) .decl-effect))
  )
  (fn-do _ is-stack-global Bool
    (param candidate Candidate)
    (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
      (case (call .decl-property row)
        (return (and (!= (. row decoration) null) (== (. row decoration text) "stack")))
      )
    )
    (return false)
  )
  (fn-expr _ stack-candidate-text String
    (param candidate Candidate)
    (str (if-expr (call is-effect-candidate candidate) "the effect" "the global") " in " (. ([] (. program modules) (. candidate module)) name))
  )
  (fn-do _ note-lazy-use _
    (param slot SlotId)
    (param flags LazyUseMask)
    ; The counts and context flags the emitter's lazy policy reads: which kind of use, and whether
    ; it sits in a loop, a nested function, a branch, a subscription loop, or a state machine.
    (let is-write (!= (/and/ flags (. ResolutionFlag resolution-write)) 0))
    (let is-ref (!= (/and/ flags (. ResolutionFlag resolution-ref)) 0))
    (let is-tracked (!= (/and/ flags (. ResolutionFlag resolution-tracked)) 0))
    (let is-read (and (not is-write) (not is-ref) (not is-tracked)))
    (let bases (call (. bindings lazy-use-of) slot))
    (let use-flags 0u32)
    (if (> loop-depth (. bases loop-base))
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-loop)))
    )
    (if (call is-captured-slot slot)
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-nested)))
    )
    (if (> branch-depth (. bases branch-base))
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-branch)))
    )
    (if (> subscription-depth (. bases subscription-base))
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-subscription)))
    )
    (if (> state-depth (. bases state-base))
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-state-machine)))
    )
    (if (!= lazy-depth 0)
      (= use-flags (/or/ use-flags (. LazyUseFlag read-in-lazy)))
    )
    (let reads (if-expr is-read 1u32 0u32))
    (let writes (if-expr is-write 1u32 0u32))
    (let refs (if-expr is-ref 1u32 0u32))
    (let tracked (if-expr is-tracked 1u32 0u32))
    (call (. bindings record-lazy-use) slot reads writes refs tracked use-flags)
    (let apart
      (scope (or control-apart (!= subscription-depth (. bases subscription-base)))
        (lazy control-apart (or (!= branch-depth (. bases branch-base)) (!= loop-depth (. bases loop-base))))
      )
    )
    (if (and is-read (not apart) (== state-depth (. bases state-base)) unguarded (not (call is-captured-slot slot)))
      (call (. bindings settle-lazy-read) slot)
    )
    (lazy unguarded (and (== lazy-depth 0) (== guard-depth 0)))
  )
  (fn-do _ is-captured-slot Bool
    (param slot SlotId)
    (let total (. names length))
    (for (in reverse (..< 0 total))
      (let position (- total 1 reverse))
      (if (== ([] name-slots position) slot)
        (return (< ([] name-depths position) function-depth))
      )
    )
    (return false)
  )
  (fn-expr _ lookup-slot (? SlotId)
    (param name Atom)
    (case? position
      ([] name-slots position)
    )
    (default
      null
    )
    (where
      (lazy position (call lookup-position name))
    )
  )
  (fn-expr _ lookup-position (? Size)
    (param name Atom)
    ; The place of the name declared last among the names in reach. Each name knows the place
    ; of its last declaration, so no other name is read.
    (call in-reach (?? ([] latest-names name) (. U32 max)))
  )
  (fn-do _ rule-position (? Size)
    (param name Atom)
    ; The place of the rule a pattern calls by a name: the name declared last in reach that no
    ; grammar captures, nor any other pattern of the match being read. A name an enclosing match
    ; captures is passed over too, where an argument of a call or a local rule's body is a match of
    ; its own.
    (let position (call lookup-position name))
    (while (and position (== (. ([] (. bindings slots) ([] name-slots position)) kind) .slot-pattern) (or (>= position capture-floor) (?? ([] stream-captures ([] name-slots position)) false)))
      (= position (call in-reach ([] name-links position)))
    )
    (return position)
  )
  (fn-do _ coded-position (? Size)
    (param found (? Size))
    ; The place of a name in reach of the code of a local rule whose body is code. A name a match
    ; captured is in its reach only while the match is being read: within an action of the match,
    ; and not beside it.
    (let position found)
    (while (and position (== (. ([] (. bindings slots) ([] name-slots position)) kind) .slot-pattern) (call is-closed (. ([] (. bindings slots) ([] name-slots position)) syntax)))
      (= position (call in-reach ([] name-links position)))
    )
    (return position)
  )
  (fn-do _ is-closed Bool
    (param capture SyntaxId)
    ; Whether a name was captured by a grammar that has been read to its end.
    (for (in matched closed-matches)
      (if (and (<= (call (. tree subtree-start) matched) capture) (<= capture matched))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ in-reach (? Size)
    (param position U32)
    ; A place among the names, where the name is in reach. A name declared before the value of a
    ; property began is not in reach of the value, nor one a constructor's body declared before a
    ; field's initializer.
    (case? (or (== position (. U32 max)) (< position value-floor) in-body)
      null
    )
    (default
      (as position Size)
    )
    (where
      (lazy in-body (and (>= position (. body-names start)) (< position (. body-names end))))
    )
  )
  (fn-do _ forget-names _
    (param mark Size)
    ; Takes the names declared since a mark out of reach. The last declaration of each is again
    ; the one it hid.
    (let position (. names length))
    (while (> position mark)
      (-= position 1)
      (= ([] latest-names ([] names position)) ([] name-links position))
    )
  )
  (fn-do _ resolve-callable _
    (param callable SyntaxId)
    (let head
      (match? ([] (. tree nodes) callable)
        (case (call .node-type-identifier row)
          (. row name)
        )
        (case .node-type-arguments
          (call type-head-name tree callable)
        )
      )
    )
    (if (not head)
      (let direct
        (match ([] (. tree nodes) callable)
          (case .node-identifier
            true
          )
          (default
            false
          )
        )
      )
      (let saved in-callee)
      (= in-callee direct)
      (call walk callable)
      (= in-callee saved)
      (return)
    )
    (let class (call first-class-named module head (call type-argument-count tree callable)))
    (if class
      (call (. bindings set-resolution)
        (block
          (arg binding)
          (arg callable)
          (arg (call Resolution .resolve-type (. class module) no-slot (. class decl) 0))
        )
      )
    )
  )
  (fn-do _ resolve-outer Resolution
    (param name Atom)
    ; Members of the owner chain, then module globals, then functions and types through the name
    ; index, then unresolved. A type is named by its own name alone: another name it is known by,
    ; such as the one a number of it is written with, names nothing in an expression. A function
    ; found through the name index whose name a method of the owner chain has uses the receiver
    ; too, as the type pass may call the method.
    (if (!= owner-decl 0)
      (let member (call member-of module owner-decl name 0))
      (if member
        (= outer-uses-self true)
        (return (call Resolution .resolve-member (. member module) no-slot (. member decl) 0))
      )
    )
    (blank)
    (let global (? DeclRef) null)
    (let class (? DeclRef) null)
    (let function (? DeclRef) null)
    (for (in candidate (call (. program lookup) module name))
      (let target ([] (. program modules) (. candidate module)))
      (match? ([] (. target decls) (. candidate decl))
        (case (call .decl-property row)
          (if (and (== (. row owner) 0) (not global))
            (if (or (call is-public (. row access)) reaches)
              (= global (call DeclRef (. candidate module) (. candidate decl)))
            )
            (lazy reaches (call (. program reaches-private) module (. candidate module)))
          )
        )
        (case (call .decl-class row)
          (if (and (== (. row name) name) (or (not class) (and (== (. candidate module) (. class module)) no-type-args)))
            (= class (call DeclRef (. candidate module) (. candidate decl)))
          )
          (lazy no-type-args (== (. row type-args count) 0))
        )
        (case .decl-function
          (if (not function)
            (= function (call DeclRef (. candidate module) (. candidate decl)))
          )
        )
      )
    )
    (blank)
    (if global
      (return (call Resolution .resolve-global (. global module) no-slot (. global decl) 0))
    )
    (if (and class (not (and in-callee function)))
      (return (call Resolution .resolve-type (. class module) no-slot (. class decl) 0))
    )
    (if function
      (if (and (!= owner-decl 0) (call method-of module owner-decl name 0))
        (= outer-uses-self true)
      )
      (return (call Resolution .resolve-function (. function module) no-slot (. function decl) 0))
    )
    (if (!= owner-decl 0)
      (let method (call method-of module owner-decl name 0))
      (if method
        (= outer-uses-self true)
        (return (call Resolution .resolve-function (. method module) no-slot (. method decl) 0))
      )
    )
    (return (call Resolution .resolve-unresolved 0 no-slot 0 0))
  )
  (fn-do _ method-of (? DeclRef)
    (param owner-module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (param depth U32)
    ; A function declared on the owner chain or on an extension visible from this module that
    ; applies to a class of the chain. They are found after every variable lookup fails.
    (if (> depth member-chain-limit)
      (return null)
    )
    (blank)
    (let target ([] (. program modules) owner-module))
    (let owner-tree (. target tree))
    (match? ([] (. target decls) owner)
      (case (call .decl-class row)
        (let direct (call function-row target (. row members) name))
        (if direct
          (return (call DeclRef owner-module direct))
        )
        (for (in extension (call (. program extensions-for) module owner-module owner))
          (let extended ([] (. program modules) (. extension module)))
          (match? ([] (. extended decls) (. extension decl))
            (case (call .decl-extension body)
              (let found (call function-row extended (. body members) name))
              (if found
                (return (call DeclRef (. extension module) found))
              )
            )
          )
        )
        (if (!= (. row base) 0)
          (let base (call class-written owner-module owner-tree (. row base)))
          (if base
            (return (call method-of (. base module) (. base decl) name (+ depth 1)))
          )
        )
      )
      (case (call .decl-extension row)
        (let direct (call function-row target (. row members) name))
        (if direct
          (return (call DeclRef owner-module direct))
        )
        (let receiver (call extended-decl owner-module owner row))
        (if receiver
          (return (call method-of (. receiver module) (. receiver decl) name (+ depth 1)))
        )
      )
    )
    (return null)
  )
  (fn-do _ function-row (? DeclId)
    (param target Module)
    (param members (of RowRange DeclId))
    (param name Atom)
    (for (in member (call (. target members-named) members name))
      (match? ([] (. target decls) member)
        (case (call .decl-function row)
          (if (and (!= (. row kind) .getter-decl) (!= (. row kind) .setter-decl) (. row name) (== (. row name) name))
            (return member)
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ member-of (? DeclRef)
    (param owner-module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (param depth U32)
    ; A property, event, or tuple base field on a class or extension chain, walked by declaration:
    ; the member rows, then the fields of a tuple base, then the base head through the name index,
    ; then the interfaces a property answers for the class, and those the class is of.
    (if (> depth member-chain-limit)
      (return null)
    )
    (blank)
    (let target ([] (. program modules) owner-module))
    (let owner-tree (. target tree))
    (match? ([] (. target decls) owner)
      (case (call .decl-class row)
        (let direct (call member-row target (. row members) name))
        (if direct
          (return (call DeclRef owner-module direct))
        )
        (let faceted (call facet-member owner-module owner name))
        (if faceted
          (return faceted)
        )
        (if (call is-builtin-member owner-module owner name)
          (return (call DeclRef owner-module owner))
        )
        (if (!= (. row base) 0)
          (if (call tuple-field-named owner-tree (. row base) name)
            (return (call DeclRef owner-module owner))
          )
          (let base (call class-written owner-module owner-tree (. row base)))
          (if base
            (let inherited (call member-of (. base module) (. base decl) name (+ depth 1)))
            (if inherited
              (return inherited)
            )
          )
        )
        (for (in delegate ([] (. target syntax-pool) (. row delegated)))
          (let declared (call class-written owner-module owner-tree delegate))
          (if declared
            (let provided (call member-of (. declared module) (. declared decl) name (+ depth 1)))
            (if provided
              (return provided)
            )
          )
        )
        (for (in interface ([] (. target syntax-pool) (. row interfaces)))
          (let declared (call class-written owner-module owner-tree interface))
          (if declared
            (let provided (call member-of (. declared module) (. declared decl) name (+ depth 1)))
            (if provided
              (return provided)
            )
          )
        )
      )
      (case (call .decl-extension row)
        (let direct (call member-row target (. row members) name))
        (if direct
          (return (call DeclRef owner-module direct))
        )
        (let receiver (call extended-decl owner-module owner row))
        (if receiver
          (return (call member-of (. receiver module) (. receiver decl) name (+ depth 1)))
        )
      )
      (case (call .decl-sheet-extension row)
        (let receiver (call class-written owner-module owner-tree (. row receiver)))
        (if receiver
          (return (call member-of (. receiver module) (. receiver decl) name (+ depth 1)))
        )
      )
    )
    (return null)
  )
  (fn-expr _ is-builtin-member Bool
    (param class-module ModuleId)
    (param class-decl DeclId)
    (param name Atom)
    (case? (call (. builtin-classes optional refers-to) class-module class-decl)
      (or (== name value-name) (== name has-value-name))
    )
    (case? (call (. builtin-classes type-info refers-to) class-module class-decl)
      (or (== name name-name) (== name key-name) (== name properties-name))
    )
    (case? (call (. builtin-classes number refers-to) class-module class-decl)
      (== name unit-name)
    )
    (default
      false
    )
  )
  (fn-do _ extended-decl (? DeclRef)
    (param module ModuleId)
    (param decl DeclId)
    (param row ExtensionDecl)
    ; What an extension adds to: the class it names, or for a facet, the class or facet it is part
    ; of.
    (return-if (call class-written module (. ([] (. program modules) module) tree) (. row receiver)) (if (not (. row facet))))
    (blank)
    (let facets (. program facets))
    (let facet (call (. facets index-of) module decl))
    (return-if null (if (or (not facet) (== ([] (. facets parent-modules) facet) (. U32 max)))))
    (return (call DeclRef ([] (. facets parent-modules) facet) ([] (. facets parent-decls) facet)))
  )
  (fn-do _ facet-member (? DeclRef)
    (param owner-module ModuleId)
    (param owner DeclId)
    (param name Atom)
    ; A member of a name that a facet of a class declares, among the facets this module sees: a
    ; public one, or a private one of a facet this module declares.
    (let facets (. program facets))
    (return-if null (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) owner-module owner))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (let facet-module ([] (. facets modules) facet))
      (if (call (. program sees-facet) module facet)
        (let target ([] (. program modules) facet-module))
        (match? ([] (. target decls) ([] (. facets decls) facet))
          (case (call .decl-extension row)
            (let found (call member-row target (. row members) name))
            (if (and found (or (== facet-module module) (call member-reaches target found facet-module)))
              (return (call DeclRef facet-module found))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ member-reaches Bool
    (param target Module)
    (param member DeclId)
    (param other ModuleId)
    ; Whether this module reaches a member of a facet another module declares: a public one, or one
    ; shared with this module's file family.
    (let access
      (match ([] (. target decls) member)
        (case (call .decl-property row)
          (. row access)
        )
        (case (call .decl-event row)
          (. row access)
        )
        (case (call .decl-function row)
          (. row access)
        )
        (default
          (. Access private-access)
        )
      )
    )
    (return (or (is access .public-access) (and (is access .family-access) (call (. program same-family) module other))))
  )
  (fn-do _ member-row (? DeclId)
    (param target Module)
    (param members (of RowRange DeclId))
    (param name Atom)
    (for (in member (call (. target members-named) members name))
      (if (call member-named target member name)
        (return member)
      )
    )
    (return null)
  )
  (fn-expr _ member-named Bool
    (param target Module)
    (param member DeclId)
    (param name Atom)
    (match ([] (. target decls) member)
      (case (call .decl-property row)
        (and (. row name) (== (. row name) name))
      )
      (case (call .decl-event row)
        (== (. row name) name)
      )
      (case (call .decl-function row)
        (and (or (== (. row kind) .getter-decl) (== (. row kind) .setter-decl)) (. row name) (== (. row name) name))
      )
      (default
        false
      )
    )
  )
  (fn-do _ tuple-field-named Bool
    (param owner-tree AST)
    (param base SyntaxId)
    (param name Atom)
    (match? ([] (. owner-tree nodes) base)
      (case (call .node-type-tuple row)
        (for (in field ([] (. owner-tree children) (. row field-types)))
          (if (call capture-named owner-tree field name)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ capture-named Bool
    (param owner-tree AST)
    (param id SyntaxId)
    (param name Atom)
    ; Whether a field of a type written as a tuple is a capture that names `name`.
    (match ([] (. owner-tree nodes) id)
      (case (call .node-type-capture row)
        (== (call (. owner-tree identifier-name) (. row id)) name)
      )
      (default
        false
      )
    )
  )
  (fn-do _ first-class-named (? DeclRef)
    (param caller ModuleId)
    (param name Atom)
    (param given Size)
    (let first (? DeclRef) null)
    (for (in candidate (call (. program lookup) caller name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case (call .decl-class row)
          (if (not first)
            (= first (call DeclRef (. candidate module) (. candidate decl)))
          )
          (if (and (== (. candidate module) (. first module)) (== (. row type-args count) given))
            (return (call DeclRef (. candidate module) (. candidate decl)))
          )
        )
      )
    )
    (return first)
  )
  (fn-expr _ class-written (? DeclRef)
    (param caller ModuleId)
    (param tree AST)
    (param type SyntaxId)
    (only-if (call first-class-named caller head (call type-argument-count tree type)) (if head))
    (where
      (lazy head (call type-head-name tree type))
    )
  )
  (fn-expr _ type-argument-count Size
    (param tree AST)
    (param type SyntaxId)
    (match ([] (. tree nodes) type)
      (case (call .node-type-arguments row)
        (. row args count)
      )
      (default
        0
      )
    )
  )
  (fn-do _ declare SlotId
    (param name Atom)
    (param kind SlotKind)
    (param syntax SyntaxId)
    (param flags SlotMask)
    (param group SyntaxId)
    (let hidden (?? ([] latest-names name) (. U32 max)))
    (if (or (== kind .slot-local) (== kind .slot-lazy))
      (let mark ([] scope-marks (- (. scope-marks length) 1)))
      (let earlier hidden)
      (let named (and (!= group 0) (is ([] (. tree nodes) group) .node-markup)))
      (let taken
        (scope (if-expr (or (== kind .slot-lazy) named) (. DiagnosticKind lazy-defined) redefined)
          (lazy redefined (. DiagnosticKind already-defined))
        )
      )
      (let site (if-expr (!= earlier (. U32 max)) (. ([] (. bindings slots) ([] name-slots earlier)) syntax) 0))
      (let again (and (!= redeclaring 0) (< site (call (. tree subtree-start) redeclaring))))
      (if (and (!= earlier (. U32 max)) (>= earlier mark) again earlier-local)
        (call (. bindings diagnostics append) (call Diagnostic module syntax .redeclared name site))
        (= earlier (. U32 max))
      )
      (lazy earlier-local (== (. ([] (. bindings slots) ([] name-slots earlier)) kind) .slot-local))
      (while (and (!= earlier (. U32 max)) (>= earlier mark))
        (call (. bindings diagnostics append)
          (block
            (arg (call Diagnostic module (if-expr named group syntax) taken name))
          )
        )
        (= earlier ([] name-links earlier))
      )
    )
    (blank)
    (let row (call Slot kind name syntax current-scope decl group flags))
    (let slot (as (call (. bindings slots append) row) SlotId))
    (+= name-links hidden)
    (= ([] latest-names name) (as (. names length) U32))
    (+= names name)
    (+= name-slots slot)
    (+= name-depths function-depth)
    (if (== kind .slot-local)
      (call settle-late name slot)
    )
    (if (== kind .slot-lazy)
      (let declared (if-expr (!= loop-depth 0) (. LazyUseFlag declared-in-loop) 0u32))
      (call (. bindings record-lazy-use) slot 0 0 0 0 declared)
      (call (. bindings set-lazy-bases) slot branch-depth loop-depth subscription-depth state-depth)
    )
    (return slot)
  )
  (fn-do _ push-scope _
    (param kind ScopeKind)
    (param syntax SyntaxId)
    (let id (as (call (. bindings scopes append) (call Scope current-scope kind syntax)) ScopeId))
    (+= scope-marks (. names length))
    (+= scope-stack current-scope)
    (= current-scope id)
  )
  (fn-do _ pop-scope _
    (throw (call Panic "Binder has no scope to pop") (if (== (. scope-marks length) 0)))
    (blank)
    (let mark ([] scope-marks (- (. scope-marks length) 1)))
    (-= ([] scope-marks (- (. scope-marks length) 1)))
    (call forget-names mark)
    (-= ([] names (..< mark (. names length))))
    (-= ([] name-slots (..< mark (. name-slots length))))
    (-= ([] name-depths (..< mark (. name-depths length))))
    (-= ([] name-links (..< mark (. name-links length))))
    (= current-scope ([] scope-stack (- (. scope-stack length) 1)))
    (-= ([] scope-stack (- (. scope-stack length) 1)))
  )
)
