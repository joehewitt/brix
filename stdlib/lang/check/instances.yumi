+ This
    - arena Arena
    - types Types

.. rows = Table'Instance(arena, 16)
.. signatures = Table'InstanceSignature(arena, 16)
.. signature-types = List'TypeId(arena)
.. fill-places = List'U32(arena)
.. slot-places = List'U32(arena)
.. slot-atoms = List'Atom(arena)
.. stable-keys = List'StableKey(arena)
.. contexts = List'StyleContext(arena)
.. context-types = List'TypeId(arena)
.. context-levels = List'U32(arena)
.. context-scopes = List'RuleScope(arena)
.. context-cells = List'U32(arena)
.. context-valued = List'U32(arena)
.. context-value-types = List'TypeId(arena)
.. state-keys = List'StateKey(arena)
.. frames = List'RuleFrame(arena)
.. ranked = Array'InstanceId(arena, 0)
.. ordered = Array'InstanceId(arena, 0)
.. ranks = Array'U32(arena, 0)
.. worklist = List'InstanceId(arena)
.. written-in = List'InstanceId(arena)
.. typed-on-read = List'InstanceId(arena)
.. settled = List'InstanceId(arena)
.. held = Scratch'InstanceId(arena, 16)
.. key-scratch = Array'U32(arena, 16)
.. initializers = Map'InitializerKey'InstanceId(arena)
.. wide-defaults = List'U64(arena)

