(type + Assigned (is Tuple)
  (prop + type TypeId)
  (prop + match Specificity)
  (prop + implicit Bool (= true))
)

(type + MatchScope (is Tuple)
  (prop + start Size)
  (prop + end Size)
)

(type + TypeParamMatch (is Struct)
  (prop + name Atom)
  (prop + type TypeId (= no-type))
  (prop + is-explicit Bool)
  (prop + is-pinned Bool)
  (prop + specificity Specificity)
  (prop + has-specificity Bool)
  (prop + links U64)
  (prop + syntax-module ModuleId)
  (prop + assign-syntax SyntaxId)
  (prop + must-match Bool)
  (prop + default-syntax SyntaxId)
  (prop + constraint-syntax SyntaxId)
  (prop + constraint-op Specificity)
)

(fn-expr + is-illegal-base Bool
  (param kind IntrinsicKind)
  (match kind
    (case= .bool
      true
    )
    (case= .optional
      true
    )
    (case= .void
      true
    )
    (case= .closure
      true
    )
    (case= .capture
      true
    )
    (case= .binding
      true
    )
    (case= .type-info
      true
    )
    (default
      false
    )
  )
)

(fn-expr + is-index-reader Bool
  (param kind IntrinsicKind)
  ; Whether a value reads indices: an index span, or a selection of a table's rows by one.
  (or (== kind .index-span) (== kind .table-selection) (== kind .immutable-table-selection))
)

(fn-expr + is-table-container Bool
  (param kind IntrinsicKind)
  (or table spans (== .immutable-table-selection kind) (== .index-span kind))
  (where
    (lazy table (or (== kind .table) (== kind .immutable-table)))
    (lazy spans (or (== kind .table-span) (== kind .immutable-table-span)))
  )
)

(fn-expr + known-type Bool
  (param type TypeId)
  (and (!= type no-type) (!= type invalid-type))
)

(fn-expr + down-cast-rank RelationRank
  (call relation-rank .relation-down-cast)
)

(fn-expr + boxed-style Bool
  (param kind IntrinsicKind)
  ; Whether a style value of a kind is kept in a box the runtime holds a handle to, as the
  ; reference's `styleValueClass` says of a value that is no number, object or union: a tuple, a
  ; struct or a string.
  (or (== kind .tuple) (== kind .struct) (== kind .string))
)

(fn-expr + is-column-receiver Bool
  (param kind IntrinsicKind)
  (case? (or (== kind .table) (== kind .immutable-table))
    true
  )
  (default
    (or (== kind .table-span) (== kind .immutable-table-span))
  )
)

(fn-expr + is-field-view Bool
  (param kind IntrinsicKind)
  ; Whether a value is a view of a field's column.
  (or (== kind .table-column) (== kind .immutable-table-column))
)

(fn-expr + is-immutable-view Bool
  (param kind IntrinsicKind)
  ; Whether a value is a table that was finished, or a view of one, which holds no metadata.
  (or table-or-span (== kind .immutable-table-row) (== kind .immutable-table-column))
  (where
    (lazy table-or-span (or (== kind .immutable-table) (== kind .immutable-table-span)))
  )
)

(fn-expr + is-row-source Bool
  (param kind IntrinsicKind)
  ; Whether a value is a table or a span of one, whose rows can be read.
  (or (== kind .table) (== kind .table-span) (== kind .immutable-table) (== kind .immutable-table-span))
)

(fn-expr + source-name String
  (param kind IntrinsicKind)
  ; The name of a table, or of a span of one, its panics give.
  (case? (== kind .table)
    "Table"
  )
  (case? (== kind .table-span)
    "TableSpan"
  )
  (case? (== kind .immutable-table)
    "ImmutableTable"
  )
  (default
    "ImmutableTableSpan"
  )
)
