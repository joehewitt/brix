  (param type IntrinsicKind)
  (match type
    (case= .number
      true
    )
    (case= .int1
      true
    )
    (case= .int8
      true
    )
    (case= .uint8
      true
    )
    (case= .int16
      true
    )
    (case= .uint16
      true
    )
    (case= .int32
      true
    )
    (case= .uint32
      true
    )
    (case= .int64
      true
    )
    (case= .uint64
      true
    )
    (case= .float32
      true
    )
    (case= .float64
      true
    )
    (case= .bool
      true
    )
    (case= .char
      true
    )
    (case= .cpointer
      true
    )
    (default
      false
    )
  )
)

(fn-expr + intrinsic-is-float Bool
