━━━━━━━━━━━━━━━━━━━━
_ ClassName is Tuple
    is Hashable

` What tells a class apart from the others of its module: its name and the number of type
` parameters it takes.

+ name Atom
+ arity U32

────────────────────
+ get hash Hash

hash-for(name) /xor/ hash-for(arity)

────────────────────
+ this == other This

name == other.name && arity == other.arity

━━━━━━━━━━━━━━━━━━━━
_ do redeclares-class Bool
    - classes Map'ClassName'Bool
    - class ClassDecl

` Whether a class has the name and the number of type parameters of one its module declares
` before it, which `classes` holds, and holds from now on. The reference takes the later of
` the two wherever the name is written, which is not modeled.
. key = ClassName(class.name, class.type-args.count)
if classes[key] ?? false
    = true
classes[key] = true
= false

━━━━━━━━━━━━━━━━━━━━
_ Declarations is facet of Checker
    sees Assignments
    sees Comprehensions
    sees LiveActions
    sees Loops
    sees Markup
    sees MatchArms
    sees Styles

_ class-cursor Size = 0

────────────────────
+ do initialize-classes

` Checks the declarations of this module's types that have come into use since the last time.
while class-cursor < types.class-uses.length
    . used = types.class-uses[class-cursor]
    class-cursor += 1
    if used.module == (module)
        initialize-class(used.decl)

────────────────────
+ do list-declarations

` Lists what typing reads of the program's declarations as a whole, once for the session and
` before it types any instance, so that no instance's typing changes it: the style rules
` (`list-style-rules`) and the extensions of style sheets (`list-sheet-extensions`). An edit
` retyped in place keeps both, as it changes no declaration (`retype-edit`).
list-style-rules()
list-sheet-extensions()

────────────────────
+ do initialize-class
    - decl DeclId

` What a type declares is checked once, where the reference checks it: when the type is first
` used, by the checker of its module's statements where they use it and otherwise after the
` program is typed (`check-used-classes`). A type nothing uses is not checked. Its base and
` associated types come first, then its properties, getters and events in the order it declares
` them.
. key = DeclRef(module, decl).key
if types.checked-classes[key] != null
    =
types.checked-classes[key] = instance
. decls = program.modules[module].decls
do match? decls[decl]
    | .decl-class(class)
        check-base(decl, class)
        check-interfaces(decl, class)
        check-content(decl, class)
        check-associated(decl, class)
        check-default-cycles(decl, class)
        for member in program.modules[module].member-pool[class.members]
            do match? decls[member]
                | .decl-function(fn)
                    if !fn.is-generated && fn.kind == .getter-decl && fn.name
                        . getter-name = fn.name
                        . getter = StorageKind.storage-getter
                        check-member
                            - member
                            - decl
                            - getter-name
                            - fn.syntax
                            - getter
                            - fn.return-type != 0
                        check-union-member(decl, getter-name, fn.syntax, false)
                    if !fn.is-generated && !fn.is-static && fn.kind == .function-decl && fn.name
                        check-inherited-method(decl, fn.name, fn.syntax)
                | .decl-event(event)
                    check-inherited-event(event)
                | .decl-property(property)
                    if !property.defaults-root && property.element == 0
                        check-member-property(member, property)

────────────────────
+ do declaring-interface TypeId
    - interface TypeId
    - declarer DeclRef

` The interface, of one and those it extends, that a declaration declares.
. ref = class-ref(types, interface)
if ref.module == declarer.module && ref.decl == declarer.decl
    = interface
for extended in types.interfaces-of(interface)
    . found = declaring-interface(extended, declarer)
    if found != no-type
        = found
= no-type

────────────────────
+ do check-initializer
    - property DeclId

` Types the value of one property in the frame of its module's main. A global whose type names
` a generic class without its arguments takes them from its value, or from the conversion its
` value is given, as a local does. A class's property is typed for one receiver, with `this`
` bound to it and the type parameters of the class that writes the value as the receiver gives
` them; a bullet list a root `<This` gives a list takes the list's item type. A case of an enum
` is typed for its enum. A line of a root `<This` that names no property is a style's
` declaration (`check-root-style`).
prepare()
. receiver = instances.rows[instance].self-type
do match? program.modules[module].decls[property]
    | .decl-case(row)
        if row.name
            check-case(receiver, row.name, row.value, row.syntax)
        instances.set-returns(instance, receiver, no-type, .return-inferred)
        finish-errors(frame)
        close()
        =
    | .decl-rule(row)
        check-class-rule(receiver, row.syntax, row.owner)
        =
    | .decl-style-rule(row)
        check-style-unit(receiver, row.syntax, row.owner)
        =
    | .decl-property(row)
        if row.defaults-root && row.name && received && !property-named(receiver, row.name)
            check-root-style(receiver, row)
            =
        .. received = receiver != no-type
. annotation = 0u32
. initializer = 0u32
. site = 0u32
. eager = false
. writer = 0u32
do match? program.modules[module].decls[property]
    | .decl-property(row)
        annotation = row.type-syntax
        initializer = row.value
        site = row.syntax
        eager = !row.is-lazy
        writer = row.owner
. result = no-type
if receiver == no-type
    . declared = no-type
    if annotation != 0
        declared = types.evaluate-type(module, tree, annotation, types.env-frame())
        if declared == invalid-type
            report-missing-type(annotation, types.env-frame())
    . value = no-type
    if initializer != 0
        initializing = if eager then property else 0
        value = infer-with-expected(initializer, declared)
        initializing = 0
        if declared != no-type
            note-declared-value(0, property, initializer, annotation, declared, value)
        if bare-generic-annotation(declared, value)
            declared = relations.complete-from(declared, value) ?? value
        if declared != no-type
            . chosen = conversions.convert(site, initializer, value, declared, .reason-declaration)
            if chosen != invalid-type
                declared = chosen
    else if declared != no-type
        construct-value(site, declared)
    result = if declared != no-type then declared else value
    if eager && is-constant-global(module, property)
        facts.constant-globals.append(ConstantGlobal(module, property))
else
    . declared = instances.signatures[instance].declared-returns
    frame.self-type = receiver
    bind-this(receiver)
    frame.close-env()
    open-class-env(holding-type(receiver, DeclRef(module, writer)))
    reading = reading.eager = eager
    if initializer == 0
        construct-value(site, declared)
        result = declared
    else
        if root-value() != 0
            expect-bullets(initializer, declared)
        result = infer-with-expected(initializer, declared)
        if declared != no-type
            conversions.convert(site, initializer, result, declared, .reason-declaration)
        note-value-shape(initializer)
if result == no-type
    result = invalid-type
. stated = instances.signatures[instance].declared-returns
instances.set-returns(instance, result, stated, .return-inferred)
finish-errors(frame)
close()

────────────────────
_ do note-value-shape
    - value SyntaxId

` Records how the value a class writes for a property depends on the object it is evaluated
` for: each property it reads, by a name the binder resolved to a member or after the
` receiver, and whether the value evaluates the read whenever it is evaluated; whether it names
` the receiver, and so may read any property; and whether it may evaluate a part of itself and
` not another, which is every value but one made of names, literals, calls, reads and operators
` that test nothing.
if value == 0
    =
for node in tree.subtree-start(value) .. < value + 1
    if !tree.tests-nothing(node)
        instances.rows[instance].branches = true
    do match? tree.nodes[node]
        | .node-identifier(row)
            . resolution = bindings.resolution-of(frame.binding, node)
            if resolution.kind == .resolve-slot && this-slot
                instances.rows[instance].reads-self = true
            .. this-slot = bindings.slots[resolution.slot].kind == .slot-this
            if resolution.kind == .resolve-member
                facts.value-reads.append
                    - ValueRead(instance, row.name, node, tree.evaluated-surely(value, node))
        | .node-get-expression(row)
            do match? tree.nodes[row.object]
                | .node-identifier
                    . resolution = bindings.resolution-of(frame.binding, row.object)
                    if resolution.kind == .resolve-slot && this-object
                        facts.value-reads.append
                            - ValueRead(instance, row.name, node, tree.evaluated-surely(value, node))
                    .. this-object = bindings.slots[resolution.slot].kind == .slot-this

────────────────────
_ do early-union-of TypeId
    - unit InstanceId

` The union made early of the state machine a property's value is, or none. A machine that
` refines another, read while the machines it refines are typed, is read as the union of the
` machine none refines, typed for the same class (`inherited-union`). Where the machine's union is
` made only once its cases are typed, invalid.
. owner = instances.rows[unit].module
. owner-tree = program.modules[owner].tree
do match? program.modules[owner].decls[instances.rows[unit].initializer]
    | .decl-property(found)
        . machine = owner-tree.declared-machine(found.value)
        if machine == 0
            = no-type
        for row in facts.early-unions
            if row.module == owner && row.syntax == machine
                = row.union
        . inherited = inherited-union(instances.rows[unit].self-type, found.name)
        = if inherited != no-type then inherited else invalid-type
= no-type

────────────────────
_ do inherited-union TypeId
    - receiver TypeId
    - name Atom?

` The union of the machine of a property of a name that refines none, typed for a class or for
` the class above it that declares it, where it is typed already, or none.
if !name || receiver == no-type
    = no-type
for fact in facts.machines
    if fact.refined != no-instance || fact.outer != 0 || fact.store != .store-member
        continue
    . held = decl-property-name(fact.module, fact.decl)
    . level = instances.rows[instances.rows[fact.instance].enclosing].self-type
    if held && held == name && holding-type(receiver, class-ref(types, level)) == level
        = fact.union
= no-type

────────────────────
+ do demand-initializer TypeId
    - unit InstanceId
    - written SyntaxId

` The type of a property's value, typed when the property is first read. A read that reaches
` the property again while its value is being typed is a circular reference, unless the value is
` a state machine whose union was made before its cases were typed (`early-union`).
. owner = instances.rows[unit].module
if instances.rows[unit].state == .instance-in-progress
    . early = early-union-of(unit)
    if early == invalid-type
        decline(written)
    if early != no-type
        = early
    facts.record-diagnostic(instance, owner, written, .circular-reference)
    = invalid-type
instances.intern(owner, program.modules[owner].main-decl, no-type, 0, no-instance)
demand-body(unit)
= instances.signatures[unit].returns

────────────────────
_ do note-value-errors
    - property DeclId
    - site SyntaxId

` A module gives its globals their values as it starts, so the errors a value lets out leave
` the module's main at the global's declaration.
. unit = instances.intern-initializer(module, property, no-type)
if instances.rows[unit].state != .instance-done
    =
note-unit-errors(unit, site)

────────────────────
+ do check-top-level
    - id SyntaxId

` Checks what a module declares, then its statements. A declaration the module holds no row
` for is one no pass models, so it is declined where it is written: no program that holds one
` is taken for understood. One that is a member of a class waits for the class to be used, but
` a section with nothing written in it is the reference's error, and so are a section that
` follows the class's content (`follows-content`) and a member that takes a name the class took
` before (`declare-members`). A local the statements declare again is settled as a block's is
` (`settle-redeclared`).
. decls = program.modules[module].decls
. previous = facts.initializer
facts.initializer = this
. declaring = tree.declaring-type-names()
. classes = Map'ClassName'Bool()
. suffixes = Map'Atom'Atom()
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-case(row)
            if row.value != 0 && is-enum-owner(row.owner)
                infer(row.value)
        | .decl-function(fn)
            if !fn.is-generated
                check-shared-access(fn.syntax, fn.access, fn.owner)
                check-argument-shapes(fn.args)
                if declares-within(declaring, fn.subtree)
                    check-type-params(fn)
                check-duplicate(index as DeclId, fn)
                check-getter-annotations(fn.syntax)
                check-return-mode(index as DeclId, fn.return-type)
        | .decl-event(event)
            check-shared-access(event.syntax, event.access, event.owner)
            if event.owner != 0 && is-facet-decl(event.owner)
                check-facet-event(event)
            else if event.owner != 0 && !is-class(event.owner)
                decline(event.syntax)
            else if event.owner != 0
                check-event-owner(event)
        | .decl-associated(associated)
            if associated.binding != 0 && !is-type-syntax(tree, associated.binding)
                . message = program.store-atom("Associated type binding must be a type")
                frame.diagnose(associated.binding, .stated, message)
        | .decl-extension(extension)
            check-shared-access(extension.syntax, extension.access, 0)
            if extension.facet
                declare-members(extension.members)
                check-facet(index as DeclId, extension)
            else
                check-extension(extension.syntax)
        | .decl-sheet-extension(extension)
            check-sheet-extension(index as DeclId, extension)
        | .decl-class(class)
            check-shared-access(class.syntax, class.access, 0)
            if redeclares-class(classes, class)
                decline(class.syntax)
            else if class.name.text == "This" && is-sheet-decl(module, index as DeclId)
                frame.diagnose
                    - class.syntax
                    - .stated
                    - program.store-atom("\"This\" is not a valid style sheet name")
            else
                declare-members(class.members)
                check-unit-base(class)
                check-suffixes(class, suffixes)
                check-below-facets(index as DeclId, class)
                if is-sheet-decl(module, index as DeclId)
                    check-derived-sheet(index as DeclId, class)
                    check-sheet-domains(index as DeclId, class)
        | .decl-style-rule(rule)
            if rule.outer == 0
                check-style-rule(index as DeclId, rule)
        | .decl-converter(converter)
            check-conversion-access(converter.syntax, converter.access)
            check-return-mode(index as DeclId, 0)
        | .decl-fromverter(fromverter)
            check-conversion-access(fromverter.syntax, fromverter.access)
            check-return-mode(index as DeclId, 0)
        | .decl-unit(unit)
            check-shared-access(unit.syntax, unit.access, unit.owner)
            check-equality(unit)
        | .decl-property(property)
            check-shared-access(property.syntax, property.access, property.owner)
            if !is-class(property.owner)
                check-member-property(index as DeclId, property)
            . literal = core-literal-type(module, index as DeclId) != no-type
            if property.owner == 0 && property.value != 0 && !property.is-lazy && !literal
                initializing = index as DeclId
                if is-object-construction(property.value)
                    check-module-property(index as DeclId, property.value, property.type-syntax)
                else
                    demand-property(module, index as DeclId)
                    note-value-errors(index as DeclId, property.syntax)
                initializing = 0
do match? tree.nodes[id]
    | .node-top-level-syntax(row)
        . finals [SyntaxId]
        . limits [SyntaxId]
        . open = 0
        . awaiting = await-elements(row.statements)
        . redeclares = redeclares-in(id)
        . projected SyntaxId = 0
        for statement in tree.children[row.statements]
            if redeclares
                if projects()
                    projected = statement
                settle-redeclared(statement, projected)
            if tree.is-finally(statement)
                finals += statement
                limits += 0
            else if !is-declaration-syntax(tree, statement)
                . calls-before U32 = facts.calls.length as U32
                . watches = open < finals.length
                if watches
                    watching-leaves += 1
                raise-statement(statement)
                check-called(statement, check-statement(statement, Want().adding(.want-unused)), true, row.statements)
                if watches
                    watching-leaves -= 1
                if watches && may-leave(calls-before)
                    for position in open .. < finals.length
                        limits[position] = statement
                    open = finals.length
        for position in 0 .. < finals.length
            check-finally(finals[position], limits[position])
        settle-elements(awaiting)
        if program.runs-main(module)
            note-main-end(id)
. undeclared = program.modules[module].undeclared
for position in 0 .. < undeclared.length
    . owner = program.modules[module].undeclared-owners[position]
    if owner == 0
        decline(undeclared[position])
    else if tree.is-empty-section(undeclared[position])
        frame.diagnose
            - undeclared[position]
            - .stated
            - program.store-atom("Empty content section not permitted")
    else if follows-content(undeclared[position], owner)
        frame.diagnose
            - undeclared[position]
            - .stated
            - program.store-atom("Only one content section permitted")
initialize-classes()
facts.initializer = previous

────────────────────
_ do note-main-end
    - id SyntaxId

` The program's main calls `end-main` of core where its statements end, before its cleanups run,
` as the reference does. The call is recorded at the main's node.
. found = program.module-by-name("core/task")
if !found
    decline(id)
    =
. mark = scratch.types.mark
. callee = calls.demand-runtime-call(found as ModuleId, no-type, program.store-atom("end-main"), mark)
scratch.types.rewind(mark)
if callee == no-instance
    decline(id)
    =
facts.record-call(frame.instance, id, callee, .call-function, scratch.no-fills, false)

────────────────────
_ do declare-members
    - declared RowRange'DeclId

` Checks each member of a class or a facet against those it declares before, as the reference
` does as it declares the class, whether or not the class is used: a property or a getter takes a name for
` a property, which a property or a getter of that name redefines, and an event or an associated
` type takes a name for a member, which nothing may take again. A setter takes the name for a
` property where nothing took it.
. owner = program.modules[module]
. properties [Atom]
. members [Atom]
for member in owner.member-pool[declared]
    do match? owner.decls[member]
        | .decl-property(property)
            if property.name && !property.defaults-root && property.element == 0
                take-property-name(property.name, property.syntax, properties, members)
        | .decl-function(fn)
            if fn.name && !fn.is-generated && fn.kind == .getter-decl
                take-property-name(fn.name, fn.syntax, properties, members)
            if fn.name && plain-setter && properties.find(fn.name) == null
                take-property-name(fn.name, fn.syntax, properties, members)
            .. plain-setter = !fn.is-generated && fn.kind == .setter-decl
            if fn.name && plain-method && members.find(fn.name) != null
                frame.diagnose
                    - fn.syntax
                    - .stated
                    - program.store-atom("Redefinition of class member")
            .. plain-method = !fn.is-generated && !fn.is-static && fn.kind == .function-decl
        | .decl-event(event)
            take-member-name(event.name, event.syntax, properties, members)
        | .decl-associated(associated)
            take-member-name(associated.name, associated.syntax, properties, members)

────────────────────
_ do take-property-name
    - name Atom
    - site SyntaxId
    - properties [Atom]
    - members [Atom]

if members.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of class member"))
else if properties.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of property"))
else
    properties += name

────────────────────
_ do take-member-name
    - name Atom
    - site SyntaxId
    - properties [Atom]
    - members [Atom]

if members.find(name) != null || properties.find(name) != null
    frame.diagnose(site, .stated, program.store-atom("Redefinition of class member"))
else
    members += name

────────────────────
_ do check-member-property
    - decl DeclId
    - property PropertyDecl

=? if !check-keyed-name(property)
check-annotations(property)
check-property(decl, property)
if property.owner != 0 && property.name
    check-union-member(property.owner, property.name, property.syntax, true)

────────────────────
_ do check-event-owner
    - event EventDecl

` Reports an event a struct or a tuple declares: an event belongs to an object, whose
` subscribers it keeps, and a value of a struct or a tuple is copied, so none would hear it.
do match? program.modules[module].decls[event.owner]
    | .decl-class(class)
        if class.base == 0
            =
        . base = types.evaluate-type(module, tree, class.base, frame.env)
        if base == invalid-type || base == no-type
            =
        . kind = types.intrinsic-of(base)
        if kind != .struct && kind != .tuple
            =
        . shape = if kind == .struct then "struct" else "tuple"
        . text = "Only a class can declare an event, which belongs to an object, and ${class.name.text} is a ${shape}, whose values are copied; declare ${class.name.text} as a class"
        frame.diagnose(event.syntax, .stated, program.store-atom(text))

────────────────────
_ do check-default-cycles
    - decl DeclId
    - class ClassDecl

` A stored property's value cannot depend on itself through the values of the properties
` beside it. The values are followed once: a property is not reached yet, being followed, or
` done, and a value that reads one being followed closes a circle. Only then is the first
` property declared that is on a circle looked for, to be reported: as one that initializes
` after the class's markup where a value on the circle reads an element the markup names. A
` state machine is no such value: its cases run on the object, as the reference compiles them.
. owner = program.modules[module]
. count = class.members.count
. values = SyntaxId[count]
. sites = SyntaxId[count]
. states = U8[count]
. offset = 0u32
for member in owner.member-pool[class.members]
    do match? owner.decls[member]
        | .decl-property(property)
            if property.name && property.value != 0 && !property.is-lazy && no-machine
                values[offset] = property.value
                sites[offset] = property.syntax
            .. no-machine = tree.declared-machine(property.value) == 0
    offset += 1
. circular = false
. pending [U32]
. cursors [SyntaxId]
for start in 0 .. < count
    if values[start] == 0 || states[start] != 0 || circular
        continue
    states[start] = 1
    pending += start
    cursors += tree.subtree-start(values[start])
    while pending.length != 0 && !circular
        . current = pending[pending.length - 1]
        . id = cursors[cursors.length - 1]
        if id > values[current]
            states[current] = 2
            pending.pop()
            cursors.pop()
            continue
        cursors[cursors.length - 1] = id + 1
        . read = default-read(class, id)
        if read == U32.max || values[read] == 0
            continue
        if states[read] == 1
            circular = true
        else if states[read] == 0
            states[read] = 1
            pending += read
            cursors += tree.subtree-start(values[read])
if !circular
    =
for start in 0 .. < count
    if values[start] != 0 && reads-itself(class, values, start)
        if puts-off-circle(decl, class, values, start)
            . name = default-name(class, start)
            . message = "Property \"${name.text}\" depends on itself through properties that initialize after its markup"
            frame.diagnose(sites[start], .stated, program.store-atom(message))
        else
            frame.diagnose(sites[start], .circular-reference)
        =

────────────────────
_ do reads-itself Bool
    - class ClassDecl
    - values [SyntaxId]
    - start U32

` Whether the value of a stored property reads the property, by itself or through the values
` of the properties it reads.
. reached = Bool[values.length]
. pending [U32]
pending += start
while pending.length != 0
    . current = pending[pending.length - 1]
    pending.pop()
    for id in tree.subtree-start(values[current]) .. values[current]
        . read = default-read(class, id)
        if read == U32.max || values[read] == 0
            continue
        if read == start
            = true
        if !reached[read]
            reached[read] = true
            pending += read
= false

────────────────────
_ do puts-off-circle Bool
    - decl DeclId
    - class ClassDecl
    - values [SyntaxId]
    - start U32

` Whether a value on a circle, or one it reads, reads an element the markup of the class
` names, so that the reference puts the circle off until the markup has run.
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, decl, mark)
scratch.types.rewind(mark)
if owner == invalid-type || owner == no-type
    = false
types.complete(owner)
. reached = Bool[values.length]
. pending [U32]
pending += start
reached[start] = true
while pending.length != 0
    . current = pending[pending.length - 1]
    pending.pop()
    if reads-element(owner, tree, values[current])
        = true
    for id in tree.subtree-start(values[current]) .. values[current]
        . read = default-read(class, id)
        if read != U32.max && values[read] != 0 && !reached[read]
            reached[read] = true
            pending += read
= false

────────────────────
_ do default-name Atom
    - class ClassDecl
    - offset U32

. owner = program.modules[module]
do match? owner.decls[owner.member-pool[class.members.start + offset]]
    | .decl-property(property)
        = property.name!
?! Panic("A value on a circle belongs to no property")

────────────────────
_ do default-read U32
    - class ClassDecl
    - id SyntaxId

` The place among a class's members of the stored property with a value that a node names,
` or none.
. owner = program.modules[module]
do match? tree.nodes[id]
    | .node-identifier(row)
        . place = owner.first-member(class.members, row.name)
        while place != no-member
            do match? owner.decls[owner.member-pool[place]]
                | .decl-property(property)
                    if property.value != 0 && !property.is-lazy
                        = place - class.members.start
            place = owner.member-links[place]
= U32.max

────────────────────
_ do check-associated
    - decl DeclId
    - class ClassDecl

` A type binds every associated type the interfaces it implements require, as openly as the
` requirement and with as many parameters.
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, decl, mark)
if owner == invalid-type
    =
types.complete(owner)
if types.intrinsic-of(owner) == .interface
    =
. seen [TypeId]
. level TypeId? = owner
while level
    for interface in types.interfaces-of(level)
        if !check-requirements(owner, class, interface, seen)
            =
    level = types.base-of(level)

────────────────────
_ do check-requirements Bool
    - owner TypeId
    - class ClassDecl
    - interface TypeId
    - seen [TypeId]

if seen.find(interface) != null
    = true
seen += interface
types.complete(interface)
. ref = class-ref(types, interface)
. declaring = program.modules[ref.module]
do match? declaring.decls[ref.decl]
    | .decl-class(required)
        for member in declaring.member-pool[required.members]
            do match? declaring.decls[member]
                | .decl-associated(requirement)
                    if !check-binding(owner, class, requirement)
                        = false
for parent in types.interfaces-of(interface)
    if !check-requirements(owner, class, parent, seen)
        = false
. base = types.base-of(interface)
if base
    = check-requirements(owner, class, base, seen)
= true

────────────────────
_ do check-binding Bool
    - owner TypeId
    - class ClassDecl
    - requirement AssociatedDecl

. name = requirement.name
. level TypeId? = owner
while level
    . ref = class-ref(types, level)
    . declaring = program.modules[ref.module]
    do match? declaring.decls[ref.decl]
        | .decl-class(holder)
            for member in declaring.member-pool[holder.members]
                do match? declaring.decls[member]
                    | .decl-associated(binding)
                        if binding.name != name
                            continue
                        . message = ""
                        if is-public(requirement.access) && !is-public(binding.access)
                            message = "Associated type ${name.text} must be public"
                        else if binding.type-args.count != requirement.type-args.count
                            message = "Associated type ${name.text} has incompatible arity"
                        if message.length == 0
                            = true
                        facts.record-diagnostic
                            - instance
                            - ref.module
                            - binding.syntax
                            - .stated
                            - program.store-atom(message)
                        = false
    level = types.base-of(level)
. shown = type-short-name(types, owner)
. message = "Must implement associated type ${name.text} in $shown"
frame.diagnose(class.syntax, .stated, program.store-atom(message))
= false

────────────────────
_ is-facet-decl Bool
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-extension(row)
        row.facet != null
    ??
        false

────────────────────
_ do check-facet-event
    - event EventDecl

` An event a facet declares is its class's, and its types are checked as a class's event's are.
` One of a facet that is not bound to its class was reported with the facet.
. facets = program.facets
. found = facets.index-of(module, event.owner)
=? if !found || facets.states[found] != .facet-bound
. index = found
. owner = types.plain-class(facets.owner-modules[index], facets.owner-decls[index])
check-event-types(event, owner)

────────────────────
_ do check-shared-access
    - syntax SyntaxId
    - access Access
    - owner DeclId

` Only a member is shared with its file family; what a module declares itself is public or private.
if owner == 0 && access is .family-access
    . message = "Only a member can be shared with its file family; declare this + or _"
    frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-conversion-access
    - syntax SyntaxId
    - access Access

` A conversion applies wherever its types meet, so it cannot be private to a module.
if !is-public(access)
    frame.diagnose(syntax, .stated, program.store-atom("Converters must be public"))

────────────────────
_ do check-suffixes
    - class ClassDecl
    - suffixes Map'Atom'Atom

` Reports a name written in parentheses after a class's own, as a unit's suffix is, that a class
` its module declares before it wrote already, which `suffixes` holds, and holds from now on, or
` that a class of a module it can name writes (`imported-suffix`), which it would hide there. It
` is reported at the class's base, written on the line of the name.
for offset in 0 .. < class.aliases.count
    . alias = tree.atoms[class.aliases.start + offset]
    . earlier = suffixes[alias] ?? imported-suffix(alias)
    if earlier
        . message = "\"${alias.text}\" already names ${earlier.text}; give ${class.name.text} a suffix of its own"
        frame.diagnose(if class.base != 0 then class.base else class.syntax, .stated, program.store-atom(message))
    else
        suffixes[alias] = class.name

────────────────────
_ do imported-suffix Atom?
    - alias Atom

` The name of a public class of another module this one can name that writes a name in
` parentheses after its own, as `Char` writes `c`, or none.
for candidate in program.lookup(module, alias)
    if candidate.module == module || program.listed-last(module, candidate.module) == U32.max
        continue
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-class(row)
            if row.name != alias && row.access == .public-access
                = row.name
= null

────────────────────
_ do check-unit-base
    - class ClassDecl

` A class declared as a number of a unit, as `Hours` is `60minutes`, is declared in a unit the
` program has, as `misstates-unit` says.
if class.base != 0
    do match? tree.nodes[class.base]
        | .node-type-numeric(numeric)
            do misstates-unit(numeric.value)

────────────────────
_ do check-extension
    - syntax SyntaxId

` An extension adds behavior to a type it does not own: it cannot yet make the type implement
` an interface, and it cannot add storage.
do match? tree.nodes[syntax]
    | .node-extension(row)
        if row.as-types.count != 0
            frame.diagnose(syntax, .stated, program.store-atom("Not yet implemented"))
            =
        for member in tree.children[row.body]
            do match? tree.nodes[member]
                | .node-property-syntax
                    . message = "Stored properties are not allowed in extensions"
                    frame.diagnose(member, .stated, program.store-atom(message))
                    =

────────────────────
_ do check-facet
    - decl DeclId
    - facet ExtensionDecl

` A facet is part of a class, or of another facet of it, declared in the class's file family. It
` holds what a class body may but for what only a class has: a base, type parameters,
` constructors, static functions and markup. The interfaces it names are its class's, and each
` names an interface. Its stored properties have their first values from the class's
` constructors, so each has a value or an optional type. Its members are found wherever the
` class's are, so none takes a name the class answers, nor a name, not private, that another facet
` of the class declares.
. facets = program.facets
. found = facets.index-of(module, decl)
=? if !found
. index = found
. name = facet.facet!.text
. owner = (types.type-syntax-name(tree, facet.receiver)?.text) ?? "its owner"
. state = facets.states[index]
if state != .facet-bound
    . (root-module, _) = facets.root-of(index)
    . family = "its class's"
    if root-module != U32.max
        family = path-file(program.modules[root-module].path)
    . message = facet-state-message(state, name, owner, family)
    frame.diagnose(facet.receiver, .stated, program.store-atom(message))
check-facet-shape(facet, name)
=? if state != .facet-bound
check-facet-interfaces(decl, facet, name)
. owner-ref = DeclRef(facets.owner-modules[index], facets.owner-decls[index])
. owner-type = types.plain-class(owner-ref.module, owner-ref.decl)
if types.intrinsic-of(owner-type) != .class
    . message = "$name can't be part of $owner, since only a class has facets"
    frame.diagnose(facet.receiver, .stated, program.store-atom(message))
    =
. sees-start = facets.sees-starts[index]
for position in sees-start .. < facets.sees-starts[index + 1]
    if facets.sees[position] == U32.max
        . written = program.modules[module].syntax-pool[facet.sees.start + position - sees-start]
        . seen = (types.type-syntax-name(tree, written)?.text) ?? "It"
        . message = "\"$seen\" is no other facet of ${class-name-of(owner-ref)}, so $name can't see it"
        frame.diagnose(written, .stated, program.store-atom(message))
check-facet-names(index, facet, name)

────────────────────
_ do check-below-facets
    - decl DeclId
    - class ClassDecl

` A class below one with facets may not declare a member of the name of a member, not private,
` that a facet of a class above declares, but to override a facet's method, getter or setter, or
` to give a property the facet stores a new value (`overrides-facet`).
. facets = program.facets
=? if facets.count == 0 || class.base == 0
. env = types.class-env(module, decl)
. level TypeId? = types.evaluate-type(module, tree, class.base, env)
types.env-release(env)
. target = program.modules[module]
while level && level != invalid-type
    . ref = class-ref(types, level)
    . (start, end) = facets.class-range(ref.module, ref.decl)
    for position in start .. < end
        . facet = facets.class-facets[position]
        for member in target.member-pool[class.members]
            . (named, _, site) = target.member-name(member)
            . facet-module = facets.modules[facet]
            if named && declares-name(facet-module, facets.decls[facet], named, true) && !overriding
                . message = "${class.name.text} can't declare ${named.text}, since facet ${facet-name-of(facet)} of ${class-name-of(ref)} declares it"
                frame.diagnose(site, .stated, program.store-atom(message))
            .. overriding = overrides-facet(target.decls[member], facet-module, facets.decls[facet])
    level = types.base-of(level)

────────────────────
_ do overrides-facet Bool
    - decl Decl
    - facet-module ModuleId
    - facet-decl DeclId

` Whether a member of a class below one with facets overrides a facet's: a method, getter or
` setter where the facet declares one of its name and kind, or a property with a value where the
` facet stores one of its name.
. target = program.modules[facet-module]
. members = match target.decls[facet-decl]
    | .decl-extension(row)
        row.members
    ??
        RowRange'DeclId()
do match? decl
    | .decl-function(fn)
        =? false if fn.is-static || !fn.name || !is-overridable-kind(fn.kind)
        for member in target.members-named(members, fn.name)
            do match? target.decls[member]
                | .decl-function(other)
                    =? true if other.name == fn.name && other.kind == fn.kind && !other.is-static
    | .decl-property(property)
        =? false if property.value == 0 || !property.name
        for member in target.members-named(members, property.name)
            do match? target.decls[member]
                | .decl-property(other)
                    =? true if other.name == property.name
= false

────────────────────
_ do check-facet-interfaces
    - decl DeclId
    - facet ExtensionDecl
    - name String

` An interface a facet names that names nothing is reported (`missing-type`), and so is a class, a
` struct or a tuple, which a facet, part of its class, is not built on.
=? if facet.interfaces.count == 0
. env = holder-env(DeclRef(module, decl))
for interface in program.modules[module].syntax-pool[facet.interfaces]
    if !report-missing-type(interface, env)
        . named = types.evaluate-type(module, tree, interface, env)
        . kind = if named != invalid-type then types.intrinsic-of(named) else IntrinsicKind.none
        if kind == .class || kind == .struct || kind == .tuple
            . shown = type-short-name(types, named)
            . text = "$name cannot implement $shown, which is not an interface; a facet is part of its class and is built on no type"
            frame.diagnose(interface, .stated, program.store-atom(text))
types.env-release(env)

────────────────────
_ do check-facet-shape
    - facet ExtensionDecl
    - name String

` What a facet may not hold, in what it writes and in what it declares.
do match? tree.nodes[facet.syntax]
    | .node-class-block(row)
        if row.type-args.count != 0
            . message = "$name is a facet, so it takes no type parameters"
            frame.diagnose(facet.syntax, .stated, program.store-atom(message))
        if row.base != 0
            . message = "$name is a facet, part of its owner, so it derives from no class"
            frame.diagnose(row.base, .stated, program.store-atom(message))
        for member in tree.children[row.members]
            . shown = match tree.nodes[member]
                | .node-content-block
                    "$name is a facet, so it writes no markup; a content section is its owner's alone"
                ??
                    ""
            if shown.length != 0
                frame.diagnose(member, .stated, program.store-atom(shown))
. target = program.modules[module]
for member in target.member-pool[facet.members]
    do match? target.decls[member]
        | .decl-function(fn)
            if is-constructor-kind(fn.kind)
                . message = "$name is a facet, so it has no constructors; its owner's give its properties their first values"
                frame.diagnose(fn.syntax, .stated, program.store-atom(message))
            else if fn.is-static
                . message = "$name is a facet, so it has no static functions"
                frame.diagnose(fn.syntax, .stated, program.store-atom(message))
        | .decl-property(property)
            if property.value == 0 && property.name && !starts-empty(property.type-syntax)
                . message = "${property.name.text} needs a value or an optional type, since $name is a facet and no constructor gives it one"
                frame.diagnose(property.syntax, .stated, program.store-atom(message))

────────────────────
_ do starts-empty Bool
    - written SyntaxId

` Whether a facet's property of a type written may start with no value: an optional type, or one
` that names nothing, which is reported where it is written.
=? false if written == 0
types.clear-fault()
. made = types.evaluate-type(module, tree, written, frame.env)
types.clear-fault()
= made == invalid-type || types.is-optional(made)

────────────────────
_ do check-facet-names
    - index U32
    - facet ExtensionDecl
    - name String

` A facet's member may not take a name its class, or a class above it or a facet of one, declares;
` nor may one that is not private take the name of such a member of another facet of the class.
. facets = program.facets
. owner-ref = DeclRef(facets.owner-modules[index], facets.owner-decls[index])
. owner = types.plain-class(owner-ref.module, owner-ref.decl)
. target = program.modules[module]
. (start, end) = facets.class-range(owner-ref.module, owner-ref.decl)
for member in target.member-pool[facet.members]
    . (named, is-shared, site) = target.member-name(member)
    if !named
        continue
    . declared = named
    . level TypeId? = owner
    . taken = false
    while level && !taken
        . ref = class-ref(types, level)
        . above = level != owner && facet-declares(ref, declared)
        taken = above || declares-name(ref.module, ref.decl, declared, false)
        level = types.base-of(level)
    if taken
        . message = "${declared.text} is already a member of ${class-name-of(owner-ref)}, so facet $name can't declare it"
        frame.diagnose(site, .stated, program.store-atom(message))
        continue
    if !is-shared
        continue
    . event = target.decls[member] is .decl-event
    for position in start .. < end
        . other = facets.class-facets[position]
        . shared = declares-name(facets.modules[other], facets.decls[other], declared, !event)
        if other != index && shared
            . other-name = facet-name-of(other)
            . reason = if event then "an event's name is its class's alone, private or not" else "a facet's members that are not private are its class's, so a name is one facet's"
            . message = "Facets $name and $other-name of ${class-name-of(owner-ref)} both declare ${declared.text}; $reason"
            frame.diagnose(site, .stated, program.store-atom(message))

────────────────────
_ do facet-declares Bool
    - ref DeclRef
    - name Atom

` Whether a facet of a class declares a member of a name that is not private.
. facets = program.facets
. (start, end) = facets.class-range(ref.module, ref.decl)
for position in start .. < end
    . facet = facets.class-facets[position]
    =? true if declares-name(facets.modules[facet], facets.decls[facet], name, true)
= false

────────────────────
_ do check-base
    - decl DeclId
    - class ClassDecl

` A type cannot derive from a function type by name, nor from a type no value is an instance
` of in its own right. A base written that names nothing, as one declared in a module this one
` does not import, is reported (`missing-type`); `check-derived-sheet` reports a style sheet's.
if class.base == 0
    =
. named = types.type-syntax-name(tree, class.base)
. illegal = named != null && (named == types.function-atom! || named == types.cfunction-atom!)
if !illegal
    . env = types.class-env(module, decl)
    . sole = class.or-bases.count == 0 && !is-sheet-decl(module, decl)
    . missing = sole && report-missing-type(class.base, env)
    for alternative in tree.children[class.or-bases]
        missing = missing || report-missing-type(alternative, env)
    . base = types.evaluate-type(module, tree, class.base, env)
    types.env-release(env)
    =? if missing
    illegal = base != invalid-type && is-illegal-base(types.intrinsic-of(base))
if illegal
    frame.diagnose(class.syntax, .stated, program.store-atom("Type has illegal base class"))

────────────────────
_ do check-interfaces
    - decl DeclId
    - class ClassDecl

` An interface written that names nothing, as one declared in a module this one does not import,
` is reported (`missing-type`). A row that names a class, a struct or a tuple names no interface:
` the type it is built on is written in its header, and it has one.
if class.interfaces.count == 0
    =
. env = types.class-env(module, decl)
for interface in program.modules[module].syntax-pool[class.interfaces]
    if !report-missing-type(interface, env)
        . named = types.evaluate-type(module, tree, interface, env)
        . kind = if named != invalid-type then types.intrinsic-of(named) else IntrinsicKind.none
        if kind == .class || kind == .struct || kind == .tuple
            . shown = type-short-name(types, named)
            . lead = "${class.name.text} cannot implement $shown, which is not an interface"
            . base = if class.base != 0 then types.evaluate-type(module, tree, class.base, env) else no-type
            . text = if base == no-type || base == invalid-type then "$lead; a type is built on one type, written in its header, as in \"+ ${class.name.text} is $shown\"" else "$lead; ${class.name.text} is built on ${type-short-name(types, base)}, and a type is built on one type"
            frame.diagnose(interface, .stated, program.store-atom(text))
types.env-release(env)

────────────────────
_ do check-property
    - decl DeclId
    - property PropertyDecl

` A property a type declares for itself has one declaration, a type or a value to take its
` type from, or a line of the class's markup that gives it one (`content-property`), and a way
` of being stored that the type's layout can hold. A type written for it that names nothing is
` reported (`missing-type`). The flag of a case of a machine that refines the machine of its
` base's property is the base's, and so is the projection of one that refines a machine of its
` base's markup. An interface stores nothing: what it requires of the types that are it is a
` getter.
if property.owner == 0 || !property.name
    =
. name = property.name
. storage = if property.is-lazy then StorageKind.storage-lazy else StorageKind.storage-eager
. typed = stated || property.context != 0 || property.line != 0
    .. stated = property.type-syntax != 0 || property.flag != 0
typed = typed || property.part != 0 || property.projection != 0
if !check-member(decl, property.owner, name, property.syntax, storage, plainly-typed)
    =
.. plainly-typed = typed && property.flag == 0 && property.projection == 0
if property.type-syntax != 0
    . env = types.class-env(module, property.owner)
    . reported = report-missing-type(property.type-syntax, env)
    types.env-release(env)
    =? if reported
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, property.owner, mark)
if owner == invalid-type
    =
. kind = types.intrinsic-of(owner)
if kind == .interface
    frame.diagnose(property.syntax, .stated, program.store-atom(stored-interface-text(property)))
    =
if kind == .struct && property.value != 0
    do match? tree.nodes[property.value]
        | .node-state-machine
            . message = "State machine properties are not supported on structs"
            frame.diagnose(property.syntax, .stated, program.store-atom(message))
            =
if !typed && property.value == 0
    . shown = type-short-name(types, owner)
    . message = "Property '${name.text}' of '$shown' needs either a type or a value"
    frame.diagnose(property.syntax, .stated, program.store-atom(message))

────────────────────
_ do check-union-member
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId
    - stored Bool

` A union holds one of its cases and nothing more, so it declares only getters, and none
` under a name every union already answers to.
. owned = match program.modules[module].decls[owner-decl]
    | .decl-class
        true
    ??
        false
if !owned
    =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type || types.intrinsic-of(owner) != .union
    =
if stored
    . message = program.store-atom("Unions can only declare getter properties")
    frame.diagnose(syntax, .stated, message)
    =
. label = name.text
if label == "case" || label == "name" || label == "type"
    . message = "Union property '$label' conflicts with reserved union property"
    frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-member Bool
    - decl DeclId
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId
    - storage StorageKind
    - typed Bool

` Checks a property or getter against the others of its name: one the same type declares
` before it, which `declare-members` reported, and one the type inherits, which it may restate
` only stored the same way and without a type of its own. A state case that restates an inherited
` case is a refinement's to check (`refines-shaped`). Says whether the member stands.
. decls = program.modules[module].decls
do match decls[owner-decl]
    | .decl-class(class)
        if storage != .storage-getter
            for member in program.modules[module].members-named(class.members, name)
                do match? decls[member]
                    | .decl-property(other)
                        if member < decl && other.name && other.name == name
                            = false
                    | .decl-event(other)
                        if member < decl && other.name == name
                            = false
    ??
        = true
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type
    = true
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && declares-event(base, name)
    . message = "Inherited event \"${name.text}\" cannot be redeclared as a property"
    frame.diagnose(syntax, .stated, program.store-atom(message))
    = false
. inherited = property-named(base, name) if base != no-type
if inherited && tree.nodes[syntax] is .node-state-case
    = true
if inherited
    if types.properties[inherited].storage-kind != storage
        . message = "Inherited properties must have same assignment type"
        frame.diagnose(syntax, .stated, program.store-atom(message))
        = false
    if typed && (storage != .storage-getter || states-getter-type(base, name))
        . message = "Illegal to redefine type of inherited property"
        frame.diagnose(syntax, .stated, program.store-atom(message))
        = false
    = true
. kind = types.intrinsic-of(owner)
. stores = storage != .storage-getter
. unsupported = stores && intrinsic-is-numeric(kind)
if storage == .storage-lazy && (kind == .tuple || kind == .struct)
    unsupported = true
if unsupported
    frame.diagnose(syntax, .stated, program.store-atom("Property not supported"))
    = false
= true

────────────────────
_ do check-inherited-method
    - owner-decl DeclId
    - name Atom
    - syntax SyntaxId

. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, owner-decl, mark)
if owner == invalid-type
    =
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && declares-event(base, name)
    . message = "Inherited event \"${name.text}\" cannot be redeclared as a method"
    frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-inherited-event
    - event EventDecl

` An event may not take the name of a property or an event its class inherits, and its types are
` as `check-event-types` says. One whose class took its name before is checked no further, as
` `declare-members` reported it.
. decls = program.modules[module].decls
do match? decls[event.owner]
    | .decl-class(class)
        for member in program.modules[module].members-named(class.members, event.name)
            . earlier = match decls[member]
                | .decl-property(other)
                    other.syntax < event.syntax && other.name && other.name == event.name
                | .decl-event(other)
                    other.syntax < event.syntax && other.name == event.name
                | .decl-associated(other)
                    other.syntax < event.syntax && other.name == event.name
                ??
                    false
            if earlier
                =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, event.owner, mark)
if owner == invalid-type
    =
types.complete(owner)
. base = types.base-of(owner) ?? no-type
if base != no-type && property-named(base, event.name) != null
    . message = "Inherited property \"${event.name.text}\" cannot be redeclared as an event"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
if base != no-type && declares-event(base, event.name)
    . message = "Inherited event \"${event.name.text}\" cannot be redeclared"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
if base != no-type && declares-method(base, event.name)
    . message = "Inherited method \"${event.name.text}\" cannot be redeclared as an event"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))
    =
check-event-types(event, owner)

────────────────────
_ do check-event-types
    - event EventDecl
    - owner TypeId

` What an event publishes is a type other than `Void`, and the key it is published by, where it
` has one, is an `EventKey` (see `event-key`).
. payload = declared-payload(owner, event.type-syntax, module)
if payload == no-type
    if !report-missing-type(event.type-syntax, frame.env)
        decline(event.syntax)
    =
if payload == types.void-type
    . message = "An event gives each subscriber a value, so it cannot carry Void; an event that only signals carries Bool, as in \"+ event ${event.name.text} Bool\""
    frame.diagnose(event.type-syntax, .stated, program.store-atom(message))
    =
if event.key-type == 0
    =
. key = declared-payload(owner, event.key-type, module)
if key == no-type
    if !report-missing-type(event.key-type, frame.env)
        decline(event.syntax)
    =
if !event-key(key)
    . message = "Keyed event keys must conform to EventKey: integer, Char, Bool, interned identity, or an integer (index, generation) handle; Float and user-defined equality/hash keys are not supported"
    frame.diagnose(event.syntax, .stated, program.store-atom(message))

────────────────────
_ do check-getter-annotations
    - syntax SyntaxId

` A getter stores nothing, so no property annotation applies to it.
do match? tree.nodes[syntax]
    | .node-function-syntax(row)
        if row.property-annotations.count != 0
            report-annotation(row.property-site, tree.atoms[row.property-annotations.start])

────────────────────
_ do check-return-mode
    - decl DeclId
    - returns SyntaxId

` A function that is not `do` is one expression, which the reference checks as it declares the
` function, whether or not anything calls it: its body returns nowhere explicitly, and outside
` a `do` block it declares nothing immediately, loops nowhere and yields nothing, apart from
` in the functions, tasks and deferred blocks written in it. One written to give `Void` gives
` nothing. Closures are checked where they are typed (`require-do`).
. described = describe(program, module, decl)
if !described || !checks-at-declaration(described)
    =
. body = described.body
. returned = tree.first-unexpressed(body, false)
if returned != 0
    frame.diagnose(returned, .explicit-return-requires-do)
    =
. statement = tree.first-unexpressed(body, true)
if statement != 0
    frame.diagnose(statement, .stated, program.store-atom(tree.requires-do-text(statement)))
    =
. stated = first-stated(body)
if stated != 0
    frame.diagnose(stated, .stated, program.store-atom(tree.requires-do-text(stated)))
    =
do match? tree.nodes[returns]
    | .node-type-identifier(row)
        if row.name.text == "Void"
            frame.diagnose(described.syntax, .non-void-return)

────────────────────
_ do check-keyed-name Bool
    - property PropertyDecl

. name = property.name
=? true if !name || name.text.find(".") == null
if property.owner != 0
    . mark = scratch.types.mark
    . owner = types.class-pattern-with-args(module, property.owner, mark)
    =? true if owner == invalid-type || types.intrinsic-of(owner) == .style
. message = "Only a Style may declare a keyed property such as \"${name.text}\""
frame.diagnose(property.syntax, .stated, program.store-atom(message))
= false

────────────────────
_ do check-annotations
    - property PropertyDecl

` `@hot` marks an eager stored field of a tuple-layout type that does not hold a delegate;
` no other annotation is known outside a style.
. annotations = RowRange'Atom()
do match? tree.nodes[property.syntax]
    | .node-property-syntax(row)
        annotations = row.annotations
if annotations.count == 0
    =
if property.owner == 0
    report-annotation(property.syntax, tree.atoms[annotations.start])
    =
. mark = scratch.types.mark
. owner = types.class-pattern-with-args(module, property.owner, mark)
if owner == invalid-type
    =
. kind = types.intrinsic-of(owner)
. tuple-layout = intrinsic-is-tuple-like(kind)
for offset in 0 .. < annotations.count
    . annotation = tree.atoms[annotations.start + offset]
    if annotation.text == "hot"
        . eager = !property.is-lazy && property.delegates.count == 0
        if !tuple-layout || !eager
            report-annotation(property.syntax, annotation)
            =
    else if kind != .style
        report-annotation(property.syntax, annotation)
        =

────────────────────
_ do report-annotation
    - syntax SyntaxId
    - annotation Atom

. label = annotation.text
. message = "Unknown property annotation \"@$label\"; only \"@hot\" is supported on eager "
message ++= "tuple fields"
if label == "hot"
    message = "Property annotation \"@hot\" requires an eager stored field on a tuple-layout type"
frame.diagnose(syntax, .stated, program.store-atom(message))

────────────────────
_ do check-argument-shapes
    - args RowRange'ArgumentShape

` The shape rules of a declaration's arguments: nothing follows a variadic argument, and once
` an argument has a default every later one needs one.
. defaulted = false
. variadic = false
for shape in program.modules[module].arg-pool[args]
    if variadic
        . message = "Variadic arguments must be the last one"
        frame.diagnose(shape.pattern, .stated, program.store-atom(message))
        =
    variadic = shape.is-variadic
    if shape.has-default
        defaulted = true
    else if defaulted
        frame.diagnose(shape.pattern, .stated, program.store-atom("Default value required"))
        =

────────────────────
_ do check-duplicate
    - decl DeclId
    - fn FunctionDecl

` A module or a type defines a function of one name and one signature once.
if fn.body == 0 || !fn.name
    =
. fn-name = fn.name
. target = program.modules[module]
. repeated = false
if fn.owner == 0
    for candidate in program.lookup(module, fn-name)
        if candidate.module == module && candidate.decl < decl
            repeated = repeated || same-definition(candidate.decl, fn)
else
    do match? target.decls[fn.owner]
        | .decl-class(class)
            for member in target.members-named(class.members, fn-name)
                if member < decl
                    repeated = repeated || same-definition(member, fn)
if repeated
    . message = "Duplicate definition of ${fn-name.text} with the same signature"
    frame.diagnose(fn.syntax, .stated, program.store-atom(message))

────────────────────
_ do same-definition Bool
    - other DeclId
    - fn FunctionDecl

. target = program.modules[module]
do match? target.decls[other]
    | .decl-function(row)
        if row.body == 0 || !row.name || row.name != fn.name! || row.kind != fn.kind
            = false
        if row.owner != fn.owner || row.is-static != fn.is-static
            = false
        if row.type-args.count != fn.type-args.count || row.args.count != fn.args.count
            = false
        if !tree.same-syntax(row.return-type, fn.return-type)
            = false
        if !tree.same-syntaxes(row.param-constraints, fn.param-constraints)
            = false
        for offset in 0 .. < fn.args.count
            . mine = target.arg-pool[fn.args.start + offset]
            . theirs = target.arg-pool[row.args.start + offset]
            if mine.is-variadic != theirs.is-variadic || !same-atom(mine.name, theirs.name)
                = false
            if !tree.same-syntax(mine.type-syntax, theirs.type-syntax)
                = false
        = true
= false

────────────────────
_ do check-type-params
    - fn FunctionDecl

` A type parameter an argument declares in passing cannot repeat one the function names.
. names [Atom]
for param in tree.children[fn.type-args]
    . named = types.type-syntax-name(tree, param)
    if named
        names += named
for shape in program.modules[module].arg-pool[fn.args]
    if shape.pattern != 0 && repeats-param(shape.pattern, names)
        =

────────────────────
_ do repeats-param Bool
    - id SyntaxId
    - names [Atom]

do match? tree.nodes[id]
    | .node-type-identifier(row)
        if row.is-declare
            if names.find(row.name) != null
                frame.diagnose(id, .stated, program.store-atom("Duplicate type parameter"))
                = true
            names += row.name
for child in tree.children-of(id)
    if repeats-param(child, names)
        = true
= false

────────────────────
_ do check-module-property
    - property DeclId
    - initializer SyntaxId
    - annotation SyntaxId

. value = infer(initializer)
if annotation == 0 || value == invalid-type || value == no-type
    =
. declared = types.evaluate-type(module, tree, annotation, frame.env)
note-declared-value(0, property, initializer, annotation, declared, value)
if declared != invalid-type && declared != value
    conversions.convert(initializer, initializer, value, declared, .reason-declaration)

────────────────────
_ do is-object-construction Bool
    - initializer SyntaxId

do match? tree.nodes[initializer]
    | .node-call-expression(call)
        . resolution = bindings.resolution-of(frame.binding, call.callable)
        if resolution.kind == .resolve-type
            = is-object-class(resolution.module, resolution.decl)
= false

────────────────────
_ do is-object-class Bool
    - class-module ModuleId
    - class-decl DeclId

do match? program.modules[class-module].decls[class-decl]
    | .decl-class(row)
        if row.type-args.count != 0
            . env = types.class-env(class-module, class-decl)
            . pattern = env.this-type
            types.env-release(env)
            = types.intrinsic-of(pattern) == .class
        . type = types.class-with-args(class-module, class-decl, scratch.types.mark)
        types.complete(type)
        = types.intrinsic-of(type) == .class
= false

────────────────────
_ is-enum-owner Bool
    - owner DeclId

match program.modules[module].decls[owner]
    | .decl-class(row)
        row.base != 0
    ??
        false

────────────────────
_ do check-case
    - about TypeId
    - name Atom
    - written SyntaxId
    - declared SyntaxId

` A case's value is converted to its enum once, where the case is declared, however many
` places name the case. One a constructor of the enum makes has the call recorded there
` instead, with the value written as its argument. The value of a case of a union is held as
` that case, though another case holds the same type.
. literal = enum-case-type(about, name)
if literal == invalid-type && written != 0
    literal = written-type(written)
if literal == no-type || literal == invalid-type || literal == about
    =
if !is-numeric(types, about) && types.intrinsic-of(about) != .union
    . mark = scratch.types.mark
    if written != 0
        scratch.types.push(literal)
    . callee = calls.demand-constructor(about, mark)
    scratch.types.rewind(mark)
    if callee != no-instance
        if written != 0
            written-type(written)
        make-case(declared, about, written, literal)
        =
. relation = relations.compare(literal, about, false, false, null, module)
if written != 0 && !relation-legal(relation)
    facts.record-diagnostic(instance, module, written, .illegal-cast, null, literal, about)
    =
. site = if written != 0 then written else declared
if types.intrinsic-of(about) == .union
    . position U32
    for fact in types.cases-of(about)
        if fact.name && fact.name! == name
            conversions.convert-into-case(site, literal, about, position, .reason-assignment)
            =
        position += 1
conversions.convert(site, site, literal, about, .reason-assignment, true, true)

────────────────────
_ do make-case
    - declared SyntaxId
    - about TypeId
    - written SyntaxId
    - literal TypeId

` Records, where a case is declared, the call of the constructor of its enum that makes its
` value: given the value written for the case, or nothing.
. shapes-start = scratch.call-arguments.mark
. types-start = scratch.types.mark
. syntax-start = scratch.syntax.mark
if written != 0
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
    scratch.types.push(literal)
    scratch.syntax.push(written)
. arguments = arguments-since(shapes-start, types-start, syntax-start, scratch.no-types)
calls.construction-on(declared, about, arguments)
scratch.syntax.rewind(syntax-start)
scratch.types.rewind(types-start)
scratch.call-arguments.rewind(shapes-start)

────────────────────
_ do written-type TypeId
    - written SyntaxId

` The type of a value written for a case that is no literal: as the module's main typed it
` where it did, and else typed here.
. main = instances.intern(module, program.modules[module].main-decl, no-type, 0, no-instance)
. typed = facts.node-type(main, written)
= if typed != no-type then typed else infer(written)

────────────────────
+ initializes-early Bool

` Whether the value being typed is that of a global each task or each thread holds its own
` of, or that `do with` binds: one that takes its value before the module's other globals.
|? initializing == 0
    false
??
    is-task-local(module, initializing) || is-thread-local(module, initializing) || stack-bound

.. stack-bound = is-stack-global(module, initializing)

────────────────────
_ do enum-case-type TypeId
    - about TypeId
    - name Atom

` The type of the value a case of an enum is written with, a number with no unit by its
` magnitude, as the number is typed where it is written.
. value = enum-case-value(about, name)
if !value
    = no-type
if value == 0
    = types.type-row(.int64)
. ref = class-ref(types, about)
. env = types.env-frame()
. tree = program.modules[ref.module].tree
do match? tree.nodes[value]
    | .node-integer-syntax(row)
        if !row.unit
            = magnitude-type(types, parse-integer-literal(row.value))
= literal-type(types, ref.module, tree, value, env)

────────────────────
+ do check-initializer-reads

` A field's initializer runs before the constructor's body, so one that reads a field the body
` assigns would read it from before the assignment: an error, at the read. The body assigns a
` field by its name or through `this`, apart from nested functions, `for ... on` loops and the
` names it declares.
. assigned [Atom]
. declared [Atom]
for statement in tree.children[body-statements()]
    if !tree.is-lazy-declare(statement)
        collect-assigned(statement, assigned, declared)
. fields [Atom]
for name in assigned
    if declared.find(name) == null && property-named(frame.self-type, name)
        fields += name
if fields.length == 0
    =
for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . name = pattern-name(types, tree, row.left) if row.is-lazy
            if name && property-named(frame.self-type, name)
                . read = field-read(row.right, fields)
                if read != 0
                    . field = field-reference(read)!
                    . assigns = "before the constructor body assigns it"
                    . runs = "constructor .. initializers run before the body"
                    . text = "Initializer of ${name.text} reads ${field.text} $assigns; $runs"
                    frame.diagnose(read, .stated, program.store-atom(text))
                    =

────────────────────
_ do field-read SyntaxId
    - id SyntaxId
    - fields [Atom]

` The first read, in the order its value is evaluated, of one of the fields named.
do match? tree.nodes[id]
    | .node-function-syntax
        = 0
for child in tree.children-of(id)
    . found = field-read(child, fields)
    if found != 0
        = found
. name = field-reference(id)
= if name && fields.find(name) != null then id else 0

────────────────────
+ do is-constructor-initializer Bool
    - name Atom

for statement in tree.children[body-statements()]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . slot = declaring-slot(row.left) if row.is-lazy
            if slot && bindings.slots[slot].name == name
                = true
= false

━━━━━━━━━━━━━━━━━━━━
_ path-file String
    - path String

|? path.find-reverse("/")
    path[it! + 1 ...]
??
    path

━━━━━━━━━━━━━━━━━━━━
_ same-atom Bool
    - left Atom?
    - right Atom?

|? left == null || right == null
    left == null && right == null
??
    left == right
