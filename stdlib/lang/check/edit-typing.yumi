./checker
./class-tables
./facts
./instances
./panics
./parallel-typing
./session
./stable-key
./stack-locals
./type-store
./types
./typing
./witnesses
/core/arena
/core/map
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range
/lang/ast/state-machines
/lang/ast/syntax-program
/stream/aggregate
/stream/sort

_ kept-typing-slots Size = 4

━━━━━━━━━━━━━━━━━━━━
+ do retype-edit String?
    - session Session
    - next Program
    - emits Bool

. old = session.program
=? "modules" if old.modules.length != next.modules.length
=? "atoms" if !next.shares-atoms-with(old)
next.continue-keys(old)
. changed [ModuleId]
for position in 0 .. < old.modules.length
    . kept = old.modules[position]
    . made = next.modules[position]
    =? "paths" if kept.path != made.path
    if kept.tree.source != made.tree.source
        changed += position as ModuleId
next.note-derived-names()
=? "derived properties" if !old.same-derived-names(next)
if changed.length == 0
    session.retarget(next)
    = null
=? "${changed.length} modules changed" if changed.length != 1
. module = changed[0]
=? "declarations" if !same-decls(old.modules[module], next.modules[module])
=? "outside bodies" if outline(old.modules[module]) != outline(next.modules[module])
=? "constructor subscriptions" if subscriptions(old.modules[module]) != next-subscriptions
.. next-subscriptions = subscriptions(next.modules[module])
. moved = node-map(old.modules[module], next.modules[module])
=? "nodes" if !moved
. instances = session.instances
. facts = session.facts
. count = instances.length
. retired [Bool]
. edited [InstanceId]
for position in 0 .. < count
    . row = instances.rows[position]
    . held = in-module && row.state != .instance-unstarted && position != instances.dead
        .. in-module = row.module == module || typed-for(session, row, module)
    retired += held
    if held
        =? "unretirable ${position}" if row.unretirable
        =? "state ${position}" if row.state != .instance-done
        edited += position as InstanceId
for id in facts.unmoved-namers(module, moved, instances)
    if id != no-instance && id != instances.dead && !retired[id]
        . row = instances.rows[id]
        =? "unretirable ${id}" if row.unretirable
        =? "state ${id}" if row.state != .instance-done
        retired[id] = true
        edited += id
=? retired-refinements(session, retired, edited)
if emits
    =? "diagnostics" if !keeps-errors(session, module, retired) && !all-retired
    .. all-retired = retires-all(session.typed-amid-errors, retired)
. diagnosed = diagnosed-decls(session, module)
. defaults [U64]
for id in edited
    defaults += instances.rows[id].typed-defaults
. wide [U64]
for key in instances.wide-defaults
    if (key /rshift/ 32) < (count as U64) && retired[(key /rshift/ 32) as Size]
        wide += key
. summaries [String]
for id in edited
    summaries += summary(session, id)
. planned = plan-size(facts)
. owner = (old.modules.length - 1) as ModuleId
. dead = instances.add-dead(owner, (old.modules[owner].decls.length - 1) as DeclId)
while retired.length < instances.length
    retired += false
. made = instances.length
. machine-count = facts.machines.length
. union-count = facts.early-unions.length
facts.retire(retired, dead)
session.panics.retire(retired)
session.errors.retire(retired, dead)
. checked [Size]
for (class, checker) in session.types.checked-classes
    if (checker as Size) < count && retired[checker]
        checked += class
for class in checked
    -= session.types.checked-classes[class]
session.bindings.forget-module(module)
session.binder.forget-module(module)
session.types.forget-module(module)
. used [Size]
for key, _ in session.scratch.using-types
    if (key /rshift/ 32) == (module as Size)
        used += key
for key in used
    -= session.scratch.using-types[key]
facts.stack-needs.clear()
facts.stack-holds.clear()
for id in edited
    instances.retype(id)
session.types.unseal()
instances.unseal()
=? facts.move-syntax(module, moved, instances, retired, dead)
instances.move-syntax(module, moved)
session.retarget(next)
queue-edited(session, edited)
retype(session)
retype-overrides(session, retired)
retype-witnesses(session, retired)
retype-defaults(session, edited, defaults, wide)
retype(session)
=? facts.replace-machines(retired, machine-count, union-count)
=? "added instances" if !settled-added(instances, made)
=? "event plan" if plan-size(facts) != planned
for id in edited
    . row = instances.rows[id]
    =? "retyped state ${id}" if row.state != .instance-done
    =? "retyped unretirable ${id}" if row.unretirable
for decl in diagnosed
    =? "unbound diagnostics" if !session.bindings.binding-for(module, decl)
session.panics.retest-forces()
check-forces(session)
check-chains(session)
number-style-sites(session)
number-domains(session)
=? "domains" if facts.domain-order.length > 32
session.panics.gather-unit-calls()
facts.fold-initializers(session.bindings, retired)
facts.chain-loose-calls()
session.panics.propagate()
StackLocals(session).check()
=? "settled added instances" if !settled-added(instances, made)
for position in 0 .. < edited.length
    . now = summary(session, edited[position])
    =? "summary ${edited[position]}: ${summaries[position]} -> $now" if now != summaries[position]
if emits
    note-amid-errors(session, edited, made)
    session.seal()
= null

━━━━━━━━━━━━━━━━━━━━
_ do keeps-errors Bool
    - session Session
    - module ModuleId
    - retired [Bool]

for row in session.facts.diagnostics
    =? true if (row.instance as Size) >= retired.length || !retired[row.instance]
= session.bindings.reports(module)

━━━━━━━━━━━━━━━━━━━━
_ retires-all Bool
    - amid [Bool]
    - retired [Bool]

all(0 .. < amid.length) • where !amid[each] || (each < retired.length && retired[each])

━━━━━━━━━━━━━━━━━━━━
_ has-errors Bool
    - session Session

session.facts.diagnostics.length != 0 || session.bindings.reports()

━━━━━━━━━━━━━━━━━━━━
_ do note-amid-errors
    - session Session
    - edited [InstanceId]
    - made Size

. instances = session.instances
if !has-errors(session)
    session.typed-amid-errors.clear()
    =
while session.typed-amid-errors.length < instances.length
    session.typed-amid-errors += false
for id in edited
    session.typed-amid-errors[id] = true
for id in made .. < instances.length
    if instances.rows[id].state != .instance-unstarted
        session.typed-amid-errors[id] = true

━━━━━━━━━━━━━━━━━━━━
_ do diagnosed-decls [DeclId]
    - session Session
    - module ModuleId

. bindings = session.bindings
. found [DeclId]
for position in 0 .. < session.program.modules[module].decls.length
    . binding = bindings.binding-for(module, position as DeclId)
    if binding && bindings.bindings[binding].diagnostics.count != 0
        found += position as DeclId
= found

━━━━━━━━━━━━━━━━━━━━
_ do retired-refinements String?
    - session Session
    - retired [Bool]
    - edited [InstanceId]

` Retires each state machine that refines one retired, through every refinement between: its
` typing read the machine it refines, its cases and its union, which typing that machine again
` makes anew. Gives why an edit cannot retire one, or nothing.
. instances = session.instances
. growing = true
while growing
    growing = false
    for machine in session.facts.machines
        . above = machine.refined
        if above != no-instance && retired[above] && !retired[machine.instance]
            . row = instances.rows[machine.instance]
            =? "unretirable ${machine.instance}" if row.unretirable
            =? "state ${machine.instance}" if row.state != .instance-done
            retired[machine.instance] = true
            edited += machine.instance
            growing = true
= null

━━━━━━━━━━━━━━━━━━━━
_ do typed-for Bool
    - session Session
    - row Instance
    - module ModuleId

` Whether an instance is typed for a class a module declares, or for one that derives from such a
` class, as a constructor a class takes from its base is: it reads the declarations of those
` classes, such as the rules, the markup queries and the defaults rule `• This` it applies, so an
` edit to the module retires it with the module's own.
=? false if row.self-type == no-type
. level TypeId? = row.self-type
while level
    do match? session.types.rows[level]
        | .type-class(class)
            =? true if class.module == module
    level = session.types.base-of(level)
= false

━━━━━━━━━━━━━━━━━━━━
_ do node-map [SyntaxId]?
    - kept Module
    - made Module

` Where an edit to a module moves each node, by its node in the edited tree, or 0 for one whose
` lines the edit changes in a body. The edit leaves the lines `outline` keeps as they were, and
` a node in a body all of whose subtree's lines are as they were parses as it did, so the trees
` hold the same nodes there, but the edit numbers them anew where it adds or removes nodes before
` them. A body the edit changes is followed down to the nodes whose lines it leaves, while their
` places line up. Gives nothing where the trees differ outside bodies.
. kept-tree = kept.tree
. made-tree = made.tree
. kept-lines = List(kept-tree.source.split("\n"))
. made-lines = List(made-tree.source.split("\n"))
. kept-spans = line-spans(kept-tree)
. made-spans = line-spans(made-tree)
. kept-bodies = body-nodes(kept)
. made-bodies = body-nodes(made)
. moved [SyntaxId]
for _ in 0 .. < kept-tree.nodes.length
    moved += 0
. olds [SyntaxId]
. news [SyntaxId]
. ways [NodeWay]
olds += kept-tree.root
news += made-tree.root
ways += .outside
while olds.length != 0
    . was = olds[olds.length - 1]
    . now = news[news.length - 1]
    . way = ways[ways.length - 1]
    olds.pop()
    news.pop()
    ways.pop()
    . was-at = kept-tree.nodes.loc[was]
    . now-at = made-tree.nodes.loc[now]
    if way == .same
        moved[was] = now
        . was-children = kept-tree.children-of(was)
        . now-children = made-tree.children-of(now)
        =? null if was-children.length != now-children.length
        for position in 0 .. < was-children.length
            olds += was-children[position]
            news += now-children[position]
            ways += .same
        continue
    if way == .inside || kept-bodies[was]
        if was-at.begin.column != now-at.begin.column
            continue
        if same-lines(kept-lines, kept-spans[was], made-lines, made-spans[now])
            olds += was
            news += now
            ways += .same
            continue
        . was-children = kept-tree.children-of(was)
        . now-children = made-tree.children-of(now)
        if was-children.length == now-children.length
            for position in 0 .. < was-children.length
                olds += was-children[position]
                news += now-children[position]
                ways += .inside
        continue
    =? null if was-at.begin.column != now-at.begin.column
    moved[was] = now
    . was-children = some-children(kept-tree, was, kept-bodies, false)
    . now-children = some-children(made-tree, now, made-bodies, false)
    =? null if was-children.length != now-children.length
    for position in 0 .. < was-children.length
        olds += was-children[position]
        news += now-children[position]
        ways += .outside
    . was-bodies = some-children(kept-tree, was, kept-bodies, true)
    . now-bodies = some-children(made-tree, now, made-bodies, true)
    if was-bodies.length == now-bodies.length
        for position in 0 .. < was-bodies.length
            olds += was-bodies[position]
            news += now-bodies[position]
            ways += .inside
= moved

━━━━━━━━━━━━━━━━━━━━
_ NodeWay is U8

` How `node-map` follows a pair of nodes: outside bodies, where the trees must line up; in a body
` the edit may change; or below a node whose lines it leaves as they were.
| outside
| inside
| same

━━━━━━━━━━━━━━━━━━━━
_ do body-nodes [Bool]
    - module Module

` The nodes of a module that begin the bodies whose lines `outline` leaves out.
. tree = module.tree
. bodies [Bool]
for _ in 0 .. < tree.nodes.length
    bodies += false
for decl in module.decls
    do match? decl
        | .decl-function(fn)
            if fn.body != 0
                do match? tree.nodes[fn.body]
                    | .node-block
                        bodies[fn.body] = true
                    | .node-top-level-syntax(row)
                        for statement in tree.children[row.statements]
                            if !is-declaration-syntax(tree, statement)
                                bodies[statement] = true
        | .decl-property(property)
            . machine = tree.declared-machine(property.value)
            if machine != 0
                for item in tree.state-items(tree.state-body(machine))
                    bodies[item] = true
= bodies

━━━━━━━━━━━━━━━━━━━━
_ some-children [SyntaxId]
    - tree AST
    - id SyntaxId
    - bodies [Bool]
    - begin-bodies Bool

each in tree.children-of(id) when bodies[each] == begin-bodies

━━━━━━━━━━━━━━━━━━━━
_ do line-spans [U64]
    - tree AST

` The first and last lines of each node's subtree, the first in the high half, or `U64.max` for
` a node with none, so that a node is judged by all that is below it, whether or not its own place
` holds it.
. spans [U64]
for id in 0u32 .. < tree.nodes.length
    . place = tree.nodes.loc[id]
    spans += if place != MatchLocation() then line-span else U64.max
        .. line-span = ((place.begin.line as U64) /lshift/ 32) /or/ (place.end.line as U64)
. order [SyntaxId]
. open [SyntaxId]
open += tree.root
while open.length != 0
    . id = open[open.length - 1]
    open.pop()
    order += id
    for child in tree.children-of(id)
        open += child
for position in 0 .. < order.length
    . id = order[order.length - 1 - position]
    for child in tree.children-of(id)
        spans[id] = joined-span(spans[id], spans[child])
= spans

━━━━━━━━━━━━━━━━━━━━
_ joined-span U64
    - span U64
    - other U64

|? span == U64.max
    other
|? other == U64.max
    span
??
    (first /lshift/ 32) /or/ last

.. first = if other /rshift/ 32 < span /rshift/ 32 then other /rshift/ 32 else span /rshift/ 32
.. last = if (other /and/ (U32.max as U64)) > (span /and/ (U32.max as U64)) then other /and/ (U32.max as U64) else span /and/ (U32.max as U64)

━━━━━━━━━━━━━━━━━━━━
_ do same-lines Bool
    - kept [String]
    - kept-span U64
    - made [String]
    - made-span U64

=? false if kept-span == U64.max || made-span == U64.max
. kept-first = (kept-span /rshift/ 32) as Size
. kept-last = (kept-span /and/ (U32.max as U64)) as Size
. made-first = (made-span /rshift/ 32) as Size
. made-last = (made-span /and/ (U32.max as U64)) as Size
=? false if kept-last < kept-first || made-last < made-first || past-end
.. past-end = kept-last >= kept.length || made-last >= made.length
=? false if kept-last - kept-first != made-last - made-first
for offset in 0 .. kept-last - kept-first
    =? false if kept[kept-first + offset] != made[made-first + offset]
= true

━━━━━━━━━━━━━━━━━━━━
_ do settled-added Bool
    - instances Instances
    - start Size

for added in start .. < instances.length
    . row = instances.rows[added]
    if row.state != .instance-unstarted && (row.state != .instance-done || row.unretirable)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do queue-edited
    - session Session
    - edited [InstanceId]

. instances = session.instances
. places = Map'StableKey'InstanceId()
. keys [StableKey]
for id in edited
    places[instances.stable-keys[id]] = id
    keys += instances.stable-keys[id]
. sorted = sort(keys)
for key in sorted
    . id = places[key]!
    . row = instances.rows[id]
    if row.probe != 0
        continue
    if row.enclosing != no-instance
        instances.written-in += id
    else if row.initializer != 0 || row.root-values != 0
        instances.typed-on-read += id
    else
        instances.queue(id)

━━━━━━━━━━━━━━━━━━━━
_ do retype
    - session Session

. instances = session.instances
while true
    while instances.worklist-next < instances.worklist.length
        . id = instances.worklist[instances.worklist-next]
        instances.worklist-next += 1
        demand-instance(session, id)
    if type-written-in(session) || type-unread(session)
        continue
    session.errors.settle-open()
    if check-used-classes(session)
        continue
    =

━━━━━━━━━━━━━━━━━━━━
_ do retype-overrides
    - session Session
    - retired [Bool]

` Checks again the answers of the overrides an edit typed again in place, as the type pass
` checks them once both an override and its base are typed (`ClassTables.check-retyped`).
. any = false
for fact in session.facts.overrides
    any = any || ((fact.override as Size) < retired.length && retired[fact.override])
=? if !any
. tables = ClassTables(session)
. checker = checker-for(session, seed-main(session, session.program.entry-module))
checker.prepare()
tables.check-retyped(checker, retired)
checker.close()
checker.retire()
tables.release()

━━━━━━━━━━━━━━━━━━━━
_ do retype-witnesses
    - session Session
    - retired [Bool]

` Notes again the answers to the functions of interfaces that an edit typed again in place, as the
` type pass notes them once it finds them (`WitnessTables.check-retyped`).
. any = false
for slot in session.facts.witness-slots
    any = any || (callee-in-range && retired[slot.callee])
        .. callee-in-range = slot.callee != no-instance && (slot.callee as Size) < retired.length
=? if !any
. witnesses = WitnessTables(session)
. checker = checker-for(session, seed-main(session, session.program.entry-module))
checker.prepare()
witnesses.check-retyped(checker, checker.conversions, retired)
checker.close()
checker.retire()

━━━━━━━━━━━━━━━━━━━━
_ do retype-defaults
    - session Session
    - edited [InstanceId]
    - defaults [U64]
    - wide [U64]

. checker = checker-for(session, seed-main(session, session.program.entry-module))
checker.prepare()
for position in 0 .. < edited.length
    . bits = defaults[position]
    for place in 0u32 .. < 64u32
        if (bits /and/ (1u64 /lshift/ (place as U64))) != 0
            checker.type-default(edited[position], place)
for key in wide
    checker.type-default((key /rshift/ 32) as InstanceId, (key /and/ (U32.max as U64)) as U32)
checker.close()
checker.retire()

━━━━━━━━━━━━━━━━━━━━
_ do summary String
    - session Session
    - id InstanceId

. instances = session.instances
. row = instances.rows[id]
. signature = instances.signatures[id]
. errors [String]
for offset in 0 .. < signature.errors.count
    errors += "${instances.signature-types[signature.errors.start + offset]}"
. flags = "${row.may-panic} ${row.polls} ${row.is-generator} ${row.reads-self} ${row.branches} ${row.returns-own} ${row.gives-unwritten} ${row.casts-errors} ${row.ends-generator} ${row.quiet} ${row.splits-yields} ${row.fills-share} ${row.uses-helper} ${row.rolls-helper} ${row.carries-mark} ${row.is-live}"
= "${signature.returns} ${signature.declared-returns} ${signature.return-state} ${signature.error-state} [${",".join(errors)}] ${row.makes} ${row.yields} ${row.materialized} ${row.retyped} $flags"

━━━━━━━━━━━━━━━━━━━━
_ do same-decls Bool
    - kept Module
    - made Module

=? false if kept.decls.length != made.decls.length
for position in 0 .. < kept.decls.length
    if decl-shape(kept.decls[position]) != decl-shape(made.decls[position])
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do outline String
    - module Module

` The lines of a module that an edit typed again in place must leave as they were: all but the
` bodies of its functions and the cases and transitions of the state machines its properties
` hold, whose unions a retyped machine must make again as they were (`Facts.replace-machines`).
. tree = module.tree
. lines = List(tree.source.split("\n"))
. inside [Bool]
for _ in lines
    inside += false
for decl in module.decls
    do match? decl
        | .decl-function(fn)
            if fn.body != 0
                mark-body(tree, fn.body, inside)
        | .decl-property(property)
            . machine = tree.declared-machine(property.value)
            if machine != 0
                for item in tree.state-items(tree.state-body(machine))
                    mark-lines(tree, item, inside)
= "\n".join(lines[each] in 0 .. < lines.length when !inside[each] && !blank(lines[each]))

━━━━━━━━━━━━━━━━━━━━
_ do mark-body
    - tree AST
    - body SyntaxId
    - inside [Bool]

do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            mark-lines(tree, statement, inside)
    | .node-top-level-syntax(row)
        for statement in tree.children[row.statements]
            if !is-declaration-syntax(tree, statement)
                mark-lines(tree, statement, inside)

━━━━━━━━━━━━━━━━━━━━
_ do mark-lines
    - tree AST
    - statement SyntaxId
    - inside [Bool]

. loc = tree.nodes.loc[statement]
for line in loc.begin.line .. loc.end.line
    if (line as Size) < inside.length
        inside[line] = true

━━━━━━━━━━━━━━━━━━━━
_ do subscriptions String
    - module Module

` The events the constructors of a module subscribe to in their bodies, as
` `Checker.constructor-events` finds them: a loop's container that is a name alone or a name read
` from `this`. The event plans of the classes are kept across an edit retyped in place, so it may
` not change these.
. tree = module.tree
. found [String]
for decl in module.decls
    do match? decl
        | .decl-function(fn)
            if fn.kind == .constructor-decl && !fn.is-generated && fn.body != 0
                . floor = tree.subtree-start(fn.body)
                . node = fn.body + 1
                while node > floor
                    node -= 1
                    do match? tree.nodes[node]
                        | .node-function-syntax
                            node = tree.subtree-start(node)
                        | .node-for-block(block)
                            do match? tree.nodes[block.loop]
                                | .node-loop-syntax(loop)
                                    if loop.is-subscriber
                                        found += subscribed-name(tree, loop.container)
= "\n".join(found)

━━━━━━━━━━━━━━━━━━━━
_ do subscribed-name String
    - tree AST
    - container SyntaxId

do match? tree.nodes[container]
    | .node-identifier(row)
        = row.name.text
    | .node-get-expression(get)
        do match? tree.nodes[get.object]
            | .node-identifier(row)
                if row.name.text == "this"
                    = "this.${get.name.text}"
= "-"

━━━━━━━━━━━━━━━━━━━━
_ plan-size Size
    - facts Facts

` How many rows the event plans of the classes hold, which typing an edit again in place may not
` add to (`Checker.plan-event-handlers`).
plan-rows + facts.lowered-sections.length + facts.rebinding-sections.length

.. plan-rows = handler-rows + facts.subscribed-sections.length
.. handler-rows = facts.lowered-handlers.length + facts.lowered-types.length

━━━━━━━━━━━━━━━━━━━━
_ do blank Bool
    - line String

for char in line
    if char != ' ' && char != '\t' && char != '\r'
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do decl-shape String
    - decl Decl

do match? decl
    | .decl-function(row)
        = "function ${named(row.name)}"
    | .decl-class(row)
        = "class ${row.name.text}"
    | .decl-property(row)
        = "property ${named(row.name)} ${row.owner}"
= "${decl-kind(decl)}"

━━━━━━━━━━━━━━━━━━━━
_ decl-kind U32
    - decl Decl

match decl
    | .decl-extension
        1
    | .decl-converter
        2
    | .decl-fromverter
        3
    | .decl-event
        4
    | .decl-unit
        5
    | .decl-import
        6
    | .decl-associated
        7
    | .decl-case
        8
    | .decl-using
        9
    | .decl-rule
        10
    | .decl-style-domains
        11
    | .decl-style-rule
        12
    | .decl-sheet-extension
        13
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ named String
    - name Atom?

if name then name.text else ""

━━━━━━━━━━━━━━━━━━━━
+ KeptTyping
    is Usable'Void

+ modules ModuleView?
+ refusal String?
_ slots [KeptTypingSlot]
_ uses U64

────────────────────
+ This
    - modules ModuleView? = null

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

for slot in slots
    slot.release()
slots.clear()

────────────────────
+ do typed Session
    - key String
    - next Program
    - workers Int
    - unreached Bool = false

uses += 1
. slot = slot-for(key)
slot.touched = uses
refusal = if !slot.session then "first build" else retype-edit(slot.session, next, true)
if !refusal
    slot.program!.release()
    slot.program = next
    slot.pin(next, modules)
    = slot.session!
slot.release()
slot.program = next
. made = Session(next)
slot.session = made
if unreached
    made.unreached-modules += next.entry-module
type-program(made, workers)
if has-errors(made)
    for _ in 0 .. < made.instances.length
        made.typed-amid-errors += true
made.seal()
slot.pin(next, modules)
= made

────────────────────
_ do slot-for KeptTypingSlot
    - key String

for slot in slots
    =? slot if slot.key == key
if slots.length >= kept-typing-slots
    . oldest Size = 0
    for index in 1 .. < slots.length
        if slots[index].touched < slots[oldest].touched
            oldest = index
    slots[oldest].release()
    slots.remove(oldest)
. made = KeptTypingSlot(key)
slots += made
= made

━━━━━━━━━━━━━━━━━━━━
_ KeptTypingSlot

+ key String
+ session Session?
+ program Program?
+ touched U64
_ pins ModulePins?

────────────────────
+ This
    - key

────────────────────
+ do pin
    - program Program
    - modules ModuleView?

=? if !modules
. paths [String]
for module in program.modules
    paths += module.path
. fresh = modules.pin(paths)
pins?.release()
pins = fresh

────────────────────
+ do release

if session
    session.release()
session = null
if program
    program.release()
program = null
pins?.release()
pins = null

