(import ./type-relation)
(import ./type-store)
(import ./types)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/viability)

(type + ConstructorCandidate (is Tuple)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + owner TypeId)
  (prop + viability ViabilityKind)
)

(type + GeneratedFamily (is U32)
  (variant no-generated (= 0))
  (variant plain-generated (= 1))
  (variant tuple-generated (= 2))
  (variant typed-generated (= 3))
)

(fn-expr + generated-family GeneratedFamily
  (param tag IntrinsicKind)
  (match tag
    (case= .interface
      .no-generated
    )
    (case= .function
      .no-generated
    )
    (case= .cfunction
      .no-generated
    )
    (case= .closure
      .no-generated
    )
    (case= .capture
      .no-generated
    )
    (case= .tuple
      .tuple-generated
    )
    (case= .struct
      .tuple-generated
    )
    (case= .array-builder
      .tuple-generated
    )
    (case= .table-row
      .tuple-generated
    )
    (case= .table-span
      .tuple-generated
    )
    (case= .table-selection
      .tuple-generated
    )
    (case= .table-column
      .tuple-generated
    )
    (case= .table-mark
      .tuple-generated
    )
    (case= .immutable-table-row
      .tuple-generated
    )
    (case= .immutable-table-span
      .tuple-generated
    )
    (case= .immutable-table-selection
      .tuple-generated
    )
    (case= .immutable-table-column
      .tuple-generated
    )
    (case= .table
      .typed-generated
    )
    (case= .immutable-table
      .typed-generated
    )
    (case= .index-span
      .typed-generated
    )
    (default
      .plain-generated
    )
  )
)

(fn-do + constructor-candidates _
  (param relations Relations)
  (param type TypeId)
  (param calls (list CallArgument))
  (param into (list ConstructorCandidate))
  (param caller (? ModuleId) (= null))
  (param first-arg TypeId (= no-type))
  (param sole TypeId (= no-type))
  ; `sole` is the type of the one field of a tuple called with one value, as the caller worked
  ; it out where the tuple does not write it.
  (let types (. relations types))
  (let program (. types program))
  (let slots (list U32))
  (call (. into clear))
  (call gather-constructors relations type type calls into slots true caller first-arg sole)
)

(fn-do + candidate-text String
  (param program Program)
  (param candidate ConstructorCandidate)
  (let module ([] (. program modules) (. candidate module)))
  (let kind "?")
  (let owner-name "?")
  (let ordinal "")
  (match? ([] (. module decls) (. candidate decl))
    (case (call .decl-function row)
      (= kind
        (match (. row kind)
          (case= .default-constructor-decl
            "default"
          )
          (case= .cast-constructor-decl
            "cast"
          )
          (case= .tuple-constructor-decl
            "tuple"
          )
          (default
            "declared"
          )
        )
      )
      (match? ([] (. module decls) (. row owner))
        (case (call .decl-class owner)
          (= owner-name (. owner name text))
          (if (== (. row kind) .constructor-decl)
            (= ordinal (str "#" (call constructor-ordinal module (. owner members) (. candidate decl))))
          )
        )
        (case (call .decl-extension owner)
          (= kind "extension")
          (= owner-name (str (. module name) "#" (call extension-ordinal module (. row owner))))
          (= ordinal (str "#" (call constructor-ordinal module (. owner members) (. candidate decl))))
        )
      )
    )
  )
  (let partial (if-expr (== (. candidate viability) .partially-viable) "~" ""))
  (return (str kind ":" owner-name ordinal partial))
)

(fn-do + viable-fields Bool
  (param types Types)
  (param owner TypeId)
  (param calls (list CallArgument))
  (let completion ([] (. types completions) owner))
  (let names (list Atom))
  (for (in fact ([] (. types properties) (. completion properties)))
    (if (!= (. fact slot) (. U32 max))
      (+= names (. fact name))
    )
  )
  (let count (. names length))
  (let occupied (list Bool))
  (for (in _ (..< 0 count))
    (+= occupied false)
  )
  (let supplied 0)
  (for (in call calls)
    (if (and (not (. call is-skipped)) (not (. call is-property)))
      (+= supplied 1)
    )
  )
  (if (or (== supplied 0) (> supplied count))
    (return false)
  )
  ; The index is a Size so the not-found sentinel stays above every count instead of becoming
  ; a negative signed index.
  (let next Size 0)
  (for (in call calls)
    (if (or (. call is-skipped) (. call is-property))
      (continue)
    )
    (while (and (< next count) ([] occupied next))
      (+= next 1)
    )
    (let index Size next)
    (if (. call name)
      (= index (call field-index names (. call name)))
    )
    (if (or (>= index count) ([] occupied index))
      (return false)
    )
    (= ([] occupied index) true)
    (if (== index next)
      (+= next 1)
    )
  )
  (return true)
)

(fn-do _ gives-field Bool
  (param types Types)
  (param owner TypeId)
  (param calls (list CallArgument))
  (param given TypeId)
  (param sole TypeId)
  ; Whether the one argument of a call of a tuple is a field of it and not a value to convert
  ; to it: an argument that names a field, or one of the type of the tuple's only field, which
  ; is `sole` where the tuple does not write it.
  (let name (? Atom) null)
  (for (in call calls)
    (if (and (not (. call is-skipped)) (not (. call is-property)))
      (= name (. call name))
    )
  )
  (let fields 0)
  (let written no-type)
  (let is-named false)
  (for (in fact ([] (. types properties) (. ([] (. types completions) owner) properties)))
    (if (== (. fact slot) (. U32 max))
      (continue)
    )
    (+= fields 1)
    (= written (. fact type))
    (if (and name (== (. fact name) name))
      (= is-named true)
    )
  )
  (if name
    (return is-named)
  )
  (return (and (== fields 1) (== (if-expr (!= written no-type) written sole) given)))
)

(fn-do _ field-index Size
  (param names (list Atom))
  (param name Atom)
  (let index 0)
  (for (in candidate names)
    (if (== candidate name)
      (return index)
    )
    (+= index 1)
  )
  (return (. Size max))
)

(fn-do _ gather-constructors _
  (param relations Relations)
  (param current TypeId)
  (param outer TypeId)
  (param calls (list CallArgument))
  (param into (list ConstructorCandidate))
  (param slots (list U32))
  (param is-outer Bool)
  (param caller (? ModuleId))
  (param first-arg TypeId (= no-type))
  (param sole TypeId (= no-type))
  (let types (. relations types))
  (let program (. types program))
  (let ref
    (match? ([] (. types rows) current)
      (case (call .type-class row)
        (call DeclRef (. row module) (. row decl))
      )
      (case (call .type-tuple row)
        (call DeclRef (. row module) (. row decl))
      )
      (case (call .type-struct row)
        (call DeclRef (. row module) (. row decl))
      )
      (case (call .type-union row)
        (call DeclRef (. row module) (. row decl))
      )
      (case (call .type-named-union row)
        (call DeclRef (. row module) (. row decl))
      )
    )
  )
  (if (not ref)
    (return)
  )
  (let declaring ref)
  (let module ([] (. program modules) (. declaring module)))
  (let members
    (match? ([] (. module decls) (. declaring decl))
      (case (call .decl-class row)
        (. row members)
      )
    )
  )
  (if (not members)
    (return)
  )
  (let range members)
  (call (. types ensure-representation) current)
  (if is-outer
    (let family (call generated-family (. ([] (. types completions) current) intrinsic)))
    (let supplied (call supplied-count calls))
    (if (== family .typed-generated)
      (let arena (and (!= first-arg no-type) (call (. types is-arena) first-arg)))
      (let source (and (!= first-arg no-type) (call is-index-source types first-arg)))
      (let owner (. declaring module))
      (let shape (call TableCall supplied arena source))
      (call add-table-generated module owner range calls into slots outer shape)
      (else-if (and (== family .tuple-generated) (== supplied 1) (!= first-arg no-type))
        (let hit (call (. relations fromverter-owner) outer first-arg caller))
        (let converts (and (!= (. hit owner) no-type) (!= (. hit module) (. U32 max))))
        (if (and converts (not (call gives-field types outer calls first-arg sole)))
          (+= into (call ConstructorCandidate (. hit module) (. hit decl) outer .fully-viable))
          (else
            (call add-generated types module (. declaring module) range calls into slots outer family)
          )
        )
      )
      (else
        (call add-generated types module (. declaring module) range calls into slots outer family)
        (if (and (== supplied 1) (!= first-arg no-type) (call (. relations reads-text-as-number) first-arg outer))
          (let read (call (. relations fromverter-owner) outer first-arg caller))
          (if (and (!= (. read owner) no-type) (!= (. read module) (. U32 max)))
            (+= into (call ConstructorCandidate (. read module) (. read decl) outer .fully-viable))
          )
        )
      )
    )
  )
  (let base (call (. types base-of) current))
  (if base
    (call gather-constructors relations base outer calls into slots false caller first-arg sole)
  )
  (if caller
    (for (in extension (call (. program extensions-for) caller (. declaring module) (. declaring decl)))
      (let owner ([] (. program modules) (. extension module)))
      (match? ([] (. owner decls) (. extension decl))
        (case (call .decl-extension row)
          (let home (. extension module))
          (let open (call (. program reaches-private) caller home))
          (let shared (call (. program same-family) caller home))
          (call add-declared owner home (. row members) calls into slots outer open shared)
        )
      )
    )
  )
  (let reached (or (not caller) (call (. program reaches-private) caller (. declaring module))))
  (let shared (or (not caller) (call (. program same-family) caller (. declaring module))))
  (call add-declared module (. declaring module) range calls into slots outer reached shared)
)

(fn-do _ add-generated _
  (param types Types)
  (param module Module)
  (param module-index ModuleId)
  (param range (of RowRange DeclId))
  (param calls (list CallArgument))
  (param into (list ConstructorCandidate))
  (param slots (list U32))
  (param owner TypeId)
  (param family GeneratedFamily)
  (if (or (== (. range count) 0) (== family .no-generated) (== family .typed-generated))
    (return)
  )
  (for (in member ([] (. module member-pool) range))
    (match? ([] (. module decls) member)
      (case (call .decl-function row)
        (let accepted
          (match (. row kind)
            (case= .default-constructor-decl
              (call shapes-fit module row calls slots)
            )
            (case= .cast-constructor-decl
              (and (== family .plain-generated) (call shapes-fit module row calls slots))
            )
            (case= .tuple-constructor-decl
              (and (== family .tuple-generated) (call viable-fields types owner calls))
            )
            (default
              false
            )
          )
        )
        (if accepted
          (+= into (call ConstructorCandidate module-index member owner .fully-viable))
        )
      )
    )
  )
)

(fn-do _ supplied-count Size
  (param calls (list CallArgument))
  (let supplied Size 0)
  (for (in call calls)
    (if (and (not (. call is-skipped)) (not (. call is-property)))
      (+= supplied 1)
    )
  )
  (return supplied)
)

(fn-do _ is-index-source Bool
  (param types Types)
  (param type TypeId)
  ; An index span reads its indices from an array, an immutable array, or an array builder an
  ; arena backs.
  (call (. types complete) type)
  (match? ([] (. types rows) type)
    (case (call .type-class row)
      (if (== (. ([] (. types completions) type) intrinsic) .array-builder)
        (return (!= (call (. types builder-item) type) no-type))
      )
      (let array (. types array-decl))
      (if (and (== (. row module) (. array module)) (== (. row decl) (. array decl)))
        (return true)
      )
      (let immutable (. types immutable-array-decl))
      (return (and (== (. row module) (. immutable module)) (== (. row decl) (. immutable decl))))
    )
  )
  (return false)
)

(type _ TableCall (is Tuple)
  ; What picks a table type's generated constructor: how many arguments the call supplies, and
  ; whether its first is an arena or a source of indices.
  (blank)
  (prop + supplied Size)
  (prop + arena Bool)
  (prop + source Bool)
)

(fn-do _ add-table-generated _
  (param module Module)
  (param module-index ModuleId)
  (param range (of RowRange DeclId))
  (param calls (list CallArgument))
  (param into (list ConstructorCandidate))
  (param slots (list U32))
  (param owner TypeId)
  (param shape TableCall)
  (let supplied (. shape supplied))
  (let arena (. shape arena))
  (if (== (. range count) 0)
    (return)
  )
  (for (in member ([] (. module member-pool) range))
    (match? ([] (. module decls) member)
      (case (call .decl-function row)
        (let accepted
          (match (. row kind)
            (case= .table-size-constructor-decl
              (and (== supplied 1) (not arena))
            )
            (case= .table-arena-constructor-decl
              (and (== supplied 1) arena)
            )
            (case= .table-capacity-constructor-decl
              (and (== supplied 2) arena)
            )
            (case= .table-filler-constructor-decl
              (and (== supplied 2) (not arena))
            )
            (case= .index-span-source-constructor-decl
              (and (== supplied 1) (. shape source))
            )
            (case= .index-span-range-constructor-decl
              (and (== supplied 2) (. shape source))
            )
            (default
              false
            )
          )
        )
        (if (and accepted (call shapes-fit module row calls slots))
          (+= into (call ConstructorCandidate module-index member owner .fully-viable))
        )
      )
    )
  )
)

(fn-expr _ shapes-fit Bool
  (param module Module)
  (param row FunctionDecl)
  (param calls (list CallArgument))
  (param slots (list U32))
  (== (. (call viable-shapes module row calls slots) kind) .fully-viable)
)

(fn-do _ add-declared _
  (param module Module)
  (param module-index ModuleId)
  (param range (of RowRange DeclId))
  (param calls (list CallArgument))
  (param into (list ConstructorCandidate))
  (param slots (list U32))
  (param owner TypeId)
  (param reached Bool)
  (param shared Bool)
  ; A private constructor constructs only for code that reaches its module's private declarations,
  ; and one shared with a file family only for code of that family.
  (if (== (. range count) 0)
    (return)
  )
  (for (in member ([] (. module member-pool) range))
    (match? ([] (. module decls) member)
      (case (call .decl-function row)
        (let open
          (match (. row access)
            (case .private-access
              reached
            )
            (case .family-access
              shared
            )
            (default
              true
            )
          )
        )
        (if (and (== (. row kind) .constructor-decl) open)
          (let result (call viable-shapes module row calls slots))
          (if (!= (. result kind) .not-viable)
            (+= into (call ConstructorCandidate module-index member owner (. result kind)))
          )
        )
      )
    )
  )
)

(fn-do _ constructor-ordinal U32
  (param module Module)
  (param range (of RowRange DeclId))
  (param decl DeclId)
  (let ordinal 0u32)
  (if (== (. range count) 0)
    (return ordinal)
  )
  (for (in member ([] (. module member-pool) range))
    (if (== member decl)
      (return ordinal)
    )
    (match? ([] (. module decls) member)
      (case (call .decl-function row)
        (if (== (. row kind) .constructor-decl)
          (+= ordinal 1)
        )
      )
    )
  )
  (return ordinal)
)
