────────────────────
+ This

.. bindings = Table'Binding(arena, 16)
.. slots = Table'Slot(arena, 16)
.. scopes = Table'Scope(arena, 16)
.. resolutions = Table'Resolution(arena, 16)
.. diagnostics = Table'Diagnostic(arena, 16)
.. lazy-uses = Table'LazyUse(arena, 16)
.. nested = Table'NestedFunction(arena, 16)
.. captures = Table'Capture(arena, 16)
.. scans = Table'BodyScan(arena, 16)
.. scan-sites = Table'ScanSite(arena, 16)
.. windows = Table'SlotWindow(arena, 16)
.. machines = Table'MachineSlots(arena, 4)
.. machine-reads = Table'MachineRead(arena, 4)
.. by-decl = Map'Size'U32(arena)

