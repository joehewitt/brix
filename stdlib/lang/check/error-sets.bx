(import ./facts)
(import ./instances)
(import ./peer-ids)
(import ./type-relation)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + ErrorSets
  ; The errors a function raises are those its body raises and those of the calls in it that let
  ; errors through. A call can reach a callee before the callee's body is typed, so the end of a
  ; body may not know them all. It then leaves what it has here, and `settle` finishes the set
  ; once the bodies it waits on are typed. Functions on a cycle of such calls share the errors
  ; of the cycle.
  (blank)
  (prop + held (of Table HeldErrors))
  (prop + open (of List InstanceId ArenaBacking))
  (prop + unready (of Scratch U32))
  (blank)
  (prop _ entries (of Scratch Outgoing))
  (prop _ transforms (of Scratch ErrorTransform))
  (prop _ expanded (of Scratch TypedSite))
  (prop _ seen (of Scratch U32))
  (prop _ order (of Scratch U32))
  (prop _ low (of Scratch U32))
  (prop _ stacked (of Scratch U32))
  (prop _ stack (of Scratch U32))
  (prop _ reports (of Scratch ErrorReport))
  (prop _ reported Size (= 0))
  (prop _ round U32)
  (prop _ counter U32)
  (prop _ settled-through Size (= 0))
  (prop _ arena Arena)
  (prop _ types Types)
  (prop _ relations Relations)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ program Program)
  (fn-do + This _
    (param arena Arena)
    (param types Types)
    (param relations Relations)
    (param instances Instances)
    (param facts Facts)
    (param program Program)
    (lazy held (call (of Table HeldErrors) arena 16))
    (lazy open (call (of List InstanceId) arena))
    (lazy unready (call (of Scratch U32) arena 64))
    (lazy entries (call (of Scratch Outgoing) arena 64))
    (lazy transforms (call (of Scratch ErrorTransform) arena 16))
    (lazy expanded (call (of Scratch TypedSite) arena 64))
    (lazy seen (call (of Scratch U32) arena 16))
    (lazy order (call (of Scratch U32) arena 16))
    (lazy low (call (of Scratch U32) arena 16))
    (lazy stacked (call (of Scratch U32) arena 16))
    (lazy stack (call (of Scratch U32) arena 16))
    (lazy reports (call (of Scratch ErrorReport) arena 16))
  )
  (fn-do + close-body _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param outgoing (of ImmutableArray Outgoing ArenaBacking))
    (param declared (list ErrorTransform))
    (param lacks-result Bool)
    (param unbuildable Bool)
    ; Ends a body's errors. When no entry waits on a callee they are finished at once. Otherwise
    ; the entries and the transformers are kept until `settle` reaches the instance.
    (let waits false)
    (for (in entry outgoing)
      (if (!= (. entry callee) (. U32 max))
        (= waits true)
      )
    )
    (if (not waits)
      (let mark (. expanded mark))
      (for (in entry outgoing)
        (call (. expanded push) (call TypedSite (. entry type) (. entry syntax)))
      )
      (call finish instance syntax mark lacks-result unbuildable false)
      (call (. expanded rewind) mark)
      (call flush-reports)
      (return)
    )
    (let entries-start U32 (as (. entries length) U32))
    (for (in entry outgoing)
      (call (. entries push) entry)
    )
    (let transforms-start U32 (as (. transforms length) U32))
    (for (in transform declared)
      (call (. transforms push) transform)
    )
    (let entry-count U32 (as (. outgoing length) U32))
    (let transform-count U32 (as (. declared length) U32))
    (let row
      (call HeldErrors
        (block
          (arg instance)
          (arg syntax)
          (arg (call (of RowRange Outgoing) entries-start entry-count))
          (arg (call (of RowRange ErrorTransform) transforms-start transform-count))
          (arg lacks-result)
          (arg unbuildable)
        )
      )
    )
    (let id U32 (as (. held length) U32))
    (call (. held append) row)
    (call (. seen push) 0)
    (call (. order push) 0)
    (call (. low push) 0)
    (call (. stacked push) 0)
    (= (. ([] (. instances signatures) instance) pending) id)
    (+= open instance)
  )
  (fn-do + retarget _
    (param next Program)
    (= program next)
  )
  (fn-do + retire _
    (param retired (list Bool))
    (param dead InstanceId)
    (for (in node (..< 0 (. held length)))
      (let owner (. ([] held node) instance))
      (if (and (< (as owner Size) (. retired length)) ([] retired owner))
        (= (. ([] held node) instance) dead)
      )
    )
  )
  (fn-do + absorb _
    (param peer ErrorSets)
    (param ids PeerIds)
    ; Takes in the errors another type pass over the program still held of the instances this pass
    ; takes from it (`PeerIds.owns`), which wait here on the bodies of their callees as they waited
    ; there.
    (for (in node (..< 0 (. peer held length)))
      (let row (as ([] (. peer held) node) HeldErrors))
      (if (or (not (call (. ids owns) (. row instance))) (!= (. ([] (. peer instances signatures) (. row instance)) pending) (as node U32)))
        (continue)
      )
      (let instance (call (. ids instance) (. row instance)))
      (let entries-start U32 (as (. entries length) U32))
      (for (in offset (..< 0 (. row entries count)))
        (let entry ([] (. peer entries) (+ (. row entries start) offset)))
        (let type (call (. ids type) (. entry type)))
        (let callee (if-expr (== (. entry callee) (. U32 max)) (. U32 max) (call (. ids instance) (. entry callee))))
        (let call (if-expr (== (. entry call) (. U32 max)) (. U32 max) ([] (. ids calls) (. entry call))))
        (throw (call Panic "Errors held by another type pass wait on a call it leaves") (if (and (!= (. entry call) (. U32 max)) (== call (. U32 max)))))
        (call (. entries push) (call Outgoing type (. entry syntax) callee call (. entry transforms)))
      )
      (let transforms-start U32 (as (. transforms length) U32))
      (for (in offset (..< 0 (. row transforms count)))
        (let transform ([] (. peer transforms) (+ (. row transforms start) offset)))
        (let source (call (. ids type) (. transform source)))
        (let raised (call (. ids type) (. transform raised)))
        (let fact (if-expr (== (. transform fact) (. U32 max)) (. U32 max) ([] (. ids transforms) (. transform fact))))
        (call (. transforms push) (call ErrorTransform source raised (. transform site) fact (. transform conditional)))
      )
      (let id U32 (as (. held length) U32))
      (let entry-range (call (of RowRange Outgoing) entries-start (. row entries count)))
      (let transform-range (call (of RowRange ErrorTransform) transforms-start (. row transforms count)))
      (call (. held append)
        (block
          (arg
            (call HeldErrors
              (block
                (arg instance)
                (arg (. row syntax))
                (arg entry-range)
                (arg transform-range)
                (arg (. row lacks-result))
                (arg (. row unbuildable))
              )
            )
          )
        )
      )
      (call (. seen push) 0)
      (call (. order push) 0)
      (call (. low push) 0)
      (call (. stacked push) 0)
      (= (. ([] (. instances signatures) instance) pending) id)
      (+= open instance)
    )
  )
  (fn-do + gather ScratchMark
    (param root InstanceId)
    ; Pushes onto `unready` every instance the root's errors wait on whose body is not typed yet,
    ; and gives the mark below them.
    (let base (. unready mark))
    (if (call (. instances errors-known) root)
      (return base)
    )
    (let node (. ([] (. instances signatures) root) pending))
    (if (== node (. U32 max))
      (if (== (. ([] (. instances rows) root) state) .instance-unstarted)
        (call (. unready push) root)
      )
      (return base)
    )
    (+= round 1)
    (call reach node)
    (return base)
  )
  (fn-do + settle _
    (param root InstanceId)
    ; Finishes the errors of an instance and of every instance they wait on. The bodies they pass
    ; through are typed by now, apart from any still running further up the stack, which only a
    ; cycle reaches. Such a one counts as raising nothing so far, and is marked as read early.
    (let node (. ([] (. instances signatures) root) pending))
    (if (== node (. U32 max))
      (if (not (call (. instances errors-known) root))
        (= (. ([] (. instances signatures) root) errors-read-early) true)
      )
      (return)
    )
    (+= round 1)
    (= counter 0)
    (call visit node)
    (call flush-reports)
  )
  (fn-do + settle-open _
    ; Finishes every error set still held, once no body is left to type.
    (for (in position (..< settled-through (. open length)))
      (call settle ([] open position))
    )
    (= settled-through (. open length))
  )
  (fn-do _ reach _
    (param node U32)
    (= ([] seen node) round)
    (let row ([] held node))
    (for (in offset (..< 0 (. row entries count)))
      (let entry ([] entries (+ (. row entries start) offset)))
      (if (or (== (. entry callee) (. U32 max)) (call (. instances errors-known) (. entry callee)))
        (continue)
      )
      (let next (. ([] (. instances signatures) (. entry callee)) pending))
      (if (!= next (. U32 max))
        (if (!= ([] seen next) round)
          (call reach next)
        )
        (else-if (== (. ([] (. instances rows) (. entry callee)) state) .instance-unstarted)
          (call (. unready push) (. entry callee))
        )
      )
    )
  )
  (fn-do _ report _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param kind TypeDiagnosticKind)
    (param name (? Atom) (= null))
    (param source TypeId (= no-type))
    ; Keeps a diagnostic until the search that found it is over. Recording one can check a class
    ; declaration, which can type a body and so start a search of its own.
    (call (. reports push) (call ErrorReport instance syntax kind name source))
  )
  (fn-do _ flush-reports _
    ; Records the diagnostics kept so far, in the order they were found.
    (while (< reported (. reports length))
      (let row ([] reports reported))
      (+= reported 1)
      (let module (. ([] (. instances rows) (. row instance)) module))
      (call (. facts record-diagnostic) (. row instance) module (. row syntax) (. row kind) (. row name) (. row source))
    )
    (call (. reports rewind) 0)
    (= reported 0)
  )
  (fn-do _ visit _
    (param node U32)
    ; One step of the search for the cycles among held instances. An instance whose calls lead
    ; back to nothing above it closes a group: itself, or itself and everything on a cycle with it.
    (= ([] seen node) round)
    (= ([] order node) counter)
    (= ([] low node) counter)
    (+= counter 1)
    (let base (. stack mark))
    (call (. stack push) node)
    (= ([] stacked node) 1)
    (let loops false)
    (let row ([] held node))
    (for (in offset (..< 0 (. row entries count)))
      (let entry ([] entries (+ (. row entries start) offset)))
      (if (== (. entry callee) (. U32 max))
        (continue)
      )
      (let next (. ([] (. instances signatures) (. entry callee)) pending))
      (if (== next (. U32 max))
        (if (not (call (. instances errors-known) (. entry callee)))
          (= (. ([] (. instances signatures) (. entry callee)) errors-read-early) true)
        )
        (continue)
      )
      (if (== next node)
        (= loops true)
      )
      (if (!= ([] seen next) round)
        (call visit next)
        (= ([] low node) (call lower ([] low node) ([] low next)))
        (else-if (== ([] stacked next) 1)
          (= ([] low node) (call lower ([] low node) ([] order next)))
        )
      )
    )
    (if (!= ([] low node) ([] order node))
      (return)
    )
    (let cyclic (or loops (> (- (. stack length) base) 1)))
    (let changed cyclic)
    (while changed
      (= changed false)
      (for (in position (..< base (. stack length)))
        (if (call grow ([] stack position))
          (= changed true)
        )
      )
    )
    (for (in position (..< base (. stack length)))
      (let member ([] stack position))
      (call conclude member cyclic)
      (= ([] stacked member) 0)
    )
    (call (. stack rewind) base)
  )
  (fn-expr _ lower U32
    (param first U32)
    (param second U32)
    (if-expr (< first second) first second)
  )
  (fn-do _ grow Bool
    (param node U32)
    ; Takes into an instance's inferred errors whatever its callees have gained, and says whether
    ; there was anything.
    (let row ([] held node))
    (let signature ([] (. instances signatures) (. row instance)))
    (if (== (. signature error-state) .errors-stated)
      (return false)
    )
    (let mark (. expanded mark))
    (call expand node false)
    (let scratch (. types scratch))
    (let types-mark (. scratch types mark))
    (for (in position (..< mark (. expanded length)))
      (call (. scratch types push) (. ([] expanded position) type))
    )
    (call (. expanded rewind) mark)
    (call order-errors types types-mark)
    (let count (- (. scratch types length) types-mark))
    (let generator (. ([] (. instances rows) (. row instance)) is-generator))
    (let known
      (scope (if-expr generator step-count (. signature errors count))
        (lazy step-count (. ([] (. instances rows) (. row instance)) step-errors count))
      )
    )
    (let grew (!= count known))
    (if (and grew generator)
      (call (. instances set-step-errors) (. row instance) (call (. scratch types since) types-mark))
      (else-if grew
        (call (. instances set-errors) (. row instance) (call (. scratch types since) types-mark))
      )
    )
    (call (. scratch types rewind) types-mark)
    (return grew)
  )
  (fn-do _ conclude _
    (param node U32)
    (param cyclic Bool)
    (let row ([] held node))
    (let mark (. expanded mark))
    (call expand node true)
    (= (. ([] (. instances signatures) (. row instance)) pending) (. U32 max))
    (call finish (. row instance) (. row syntax) mark (. row lacks-result) (. row unbuildable) cyclic)
    (call (. expanded rewind) mark)
  )
  (fn-do _ expand _
    (param node U32)
    (param marking Bool)
    ; Lists the errors that leave a held instance in the order its body met them. A call stands for
    ; its callee's errors, each as the instance's transformers declared before the call let it
    ; out. With `marking`, a call whose callee raises is marked as propagating.
    (let row ([] held node))
    (for (in offset (..< 0 (. row entries count)))
      (let entry ([] entries (+ (. row entries start) offset)))
      (if (== (. entry callee) (. U32 max))
        (call (. expanded push) (call TypedSite (. entry type) (. entry syntax)))
        (continue)
      )
      (let callee ([] (. instances signatures) (. entry callee)))
      (if (and marking (!= (. callee errors count) 0) (!= (. entry call) (. U32 max)))
        (= (. ([] (. facts calls) (. entry call)) propagates) true)
      )
      (let declared (list ErrorTransform))
      (if (!= (. callee errors count) 0)
        (for (in index (..< 0 (. entry transforms)))
          (+= declared ([] transforms (+ (. row transforms start) index)))
        )
      )
      (for (in position (..< 0 (. callee errors count)))
        (let error ([] (. instances signature-types) (+ (. callee errors start) position)))
        (if (== (. entry transforms) 0)
          (call (. expanded push) (call TypedSite error (. entry syntax)))
          (continue)
        )
        (let tried (list U32))
        (call order-transforms relations error declared tried)
        (let leaving (list TypeId))
        (call transform-leaving
          (block
            (arg facts)
            (arg types)
            (arg (. row instance))
            (arg (. entry syntax))
            (arg error)
            (arg declared)
            (arg tried)
            (arg leaving)
            (arg marking)
          )
        )
        (for (in type leaving)
          (call (. expanded push) (call TypedSite type (. entry syntax)))
        )
      )
    )
  )
  (fn-do _ finish _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param mark ScratchMark)
    (param lacks-result Bool)
    (param unbuildable Bool)
    (param cyclic Bool)
    ; Checks the errors above the mark, which leave an instance, against the errors it states, or
    ; makes them its error set when it states none. Where the instances keep those whose errors settle
    ; (`Instances.keeps-settled`), it joins them.
    (if (and lacks-result (== (. expanded length) mark))
      (call report instance syntax .non-void-return)
    )
    (if unbuildable
      (call report instance syntax .stated (call (. program store-atom) "Type can not be constructed"))
    )
    (let signature ([] (. instances signatures) instance))
    (if (== (. signature error-state) .errors-stated)
      (if (. ([] (. instances rows) instance) is-generator)
        (call (. instances move-step-errors) instance)
      )
      (let stated
        (scope (if-expr (. ([] (. instances rows) instance) is-generator) step-errors (. signature errors))
          (lazy step-errors (. ([] (. instances rows) instance) step-errors))
        )
      )
      (call check-stated instance syntax stated)
      (call check-leaving instance stated mark)
      (return)
    )
    (= (. ([] (. instances signatures) instance) error-state) .errors-settled)
    (if (. instances keeps-settled)
      (+= (. instances settled) instance)
    )
    (if (== (. expanded length) mark)
      (return)
    )
    (call report-rules instance mark)
    (let scratch (. types scratch))
    (let types-mark (. scratch types mark))
    (for (in position (..< mark (. expanded length)))
      (call (. scratch types push) (. ([] expanded position) type))
    )
    (call order-errors types types-mark)
    (let generator (. ([] (. instances rows) instance) is-generator))
    (if (or cyclic (. signature errors-read-early))
      (let names "")
      (for (in error (call (. scratch types since) types-mark))
        (if (!= (. names length) 0)
          (+= names ", ")
        )
        (+= names (call type-short-name types error))
      )
      (let kind (if-expr generator "generator" "function"))
      (let message (str names " can leave recursive " kind " " (call function-name instance) " before its errors "))
      (++= message (str "are inferred; declare them with ?! " names ", or catch them here"))
      (call report instance (. ([] expanded mark) syntax) .stated (call (. program store-atom) message))
    )
    (if generator
      (call (. instances set-step-errors) instance (call (. scratch types since) types-mark))
      (else
        (call (. instances set-errors) instance (call (. scratch types since) types-mark))
      )
    )
    (call (. scratch types rewind) types-mark)
  )
  (fn-do _ report-rules _
    (param instance InstanceId)
    (param mark ScratchMark)
    ; The reference makes functions of a local rule beside a match that calls itself before it
    ; knows what the function the rule is written in raises. So where that function states no
    ; errors, one that leaves the rule's arms, or the arms of a local rule they call, is
    ; reported as the reference reports it: at the first call of a rule in the rule's arms.
    (let row ([] (. instances rows) instance))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (let scratch (. types scratch))
    (for (in local (. facts local-rules))
      (if (or (!= (. local instance) instance) (not (. local recursive)) (== (. local stream) no-type))
        (continue)
      )
      (let reached (list SyntaxId))
      (+= reached (. local syntax))
      (let next 0)
      (while (< next (. reached length))
        (for (in call (. facts rule-calls))
          (if (and (== (. call instance) instance) (== (. call from) ([] reached next)) unreached)
            (+= reached (. call to))
          )
          (lazy unreached (== (call (. reached find) (. call to)) null))
        )
        (+= next 1)
      )
      (let types-mark (. scratch types mark))
      (for (in position (..< mark (. expanded length)))
        (let site (. ([] expanded position) syntax))
        (for (in rule reached)
          (if (and (>= site (call (. tree subtree-start) rule)) (<= site rule))
            (call (. scratch types push) (. ([] expanded position) type))
            (break)
          )
        )
      )
      (call order-errors types types-mark)
      (let names "")
      (for (in error (call (. scratch types since) types-mark))
        (if (!= (. names length) 0)
          (+= names ", ")
        )
        (+= names (call type-short-name types error))
      )
      (call (. scratch types rewind) types-mark)
      (if (== (. names length) 0)
        (continue)
      )
      (let first (. local syntax))
      (for (in node (..< (call (. tree subtree-start) (. local syntax)) (. local syntax)))
        (if (is ([] (. tree nodes) node) .node-stream-call)
          (= first node)
          (break)
        )
      )
      (let message
        (scope (str names " can leave recursive function " rule-text " before its errors are ")
          (lazy rule-text (call rule-name tree (. local syntax)))
        )
      )
      (++= message (str "inferred; For a local '.. name ~' grammar, declare ?! " names " on the enclosing "))
      (++= message "'+ name ~ ...' function so generated pattern helpers inherit the result ABI.")
      (call report instance first .stated (call (. program store-atom) message))
      (return)
    )
  )
  (fn-do _ rule-name String
    (param tree AST)
    (param rule SyntaxId)
    ; The name a local rule is declared with.
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (let named (. declaration left))
        (match? ([] (. tree nodes) named)
          (case (call .node-type-capture row)
            (= named (. row id))
          )
        )
        (match? ([] (. tree nodes) named)
          (case (call .node-identifier row)
            (return (. row name text))
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ function-name String
    (param instance InstanceId)
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (. fn name)
          (return (. fn name text))
        )
      )
    )
    (return "")
  )
  (fn-do _ check-stated _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param stated (of RowRange TypeId))
    ; Only an error can be declared after `?!`: a panic ends its task instead of returning, and
    ; nothing else is raised at all.
    (for (in offset (..< 0 (. stated count)))
      (let declared ([] (. instances signature-types) (+ (. stated start) offset)))
      (if (or (== declared invalid-type) (== declared no-type))
        (continue)
      )
      (call (. types complete) declared)
      (let shown (call type-short-name types declared))
      (let message "")
      (if (call is-subtype types declared (. types panic-type))
        (= message
          (block
            (str shown " cannot be returned as a recoverable error; use ?! Panic(...) to end the task, ")
          )
        )
        (++= message "or convert it explicitly.")
        (else-if (not (call is-subtype types declared (. types error-type)))
          (= message (str shown " is not a recoverable error type; only subclasses of Error may appear "))
          (++= message "after ?!.")
        )
      )
      (if (!= (. message length) 0)
        (call report instance syntax .stated (call (. program store-atom) message) declared)
        (return)
      )
    )
  )
  (fn-do _ check-leaving _
    (param instance InstanceId)
    (param stated (of RowRange TypeId))
    (param mark ScratchMark)
    ; Reports each error above the mark that leaves an instance and that no error it states takes.
    ; One takes an error that converts to it, as the reference compares them: a class below it, or
    ; one above it that a cast may find to be it, which panics where it is not, so the instance may.
    (for (in position (..< mark (. expanded length)))
      (let error (. ([] expanded position) type))
      (if (== error invalid-type)
        (continue)
      )
      (let accepted false)
      (let casts false)
      (for (in offset (..< 0 (. stated count)))
        (let declared ([] (. instances signature-types) (+ (. stated start) offset)))
        (if (call is-subtype types error declared)
          (= accepted true)
          (else-if (call relation-legal (call (. relations compare) error declared))
            (= casts true)
          )
        )
      )
      (if (and (not accepted) casts)
        (call (. instances mark-casts-errors) instance)
        (= accepted true)
      )
      (if (not accepted)
        (let name (call (. program store-atom) (call function-name instance)))
        (let kind
          (scope (if-expr (. ([] (. instances rows) instance) is-generator) generator-kind function-kind)
            (lazy generator-kind (. TypeDiagnosticKind error-leaves-generator))
            (lazy function-kind (. TypeDiagnosticKind error-leaves-function))
          )
        )
        (call report instance (. ([] expanded position) syntax) kind name error)
      )
    )
  )
)

(type + ErrorTransform (is Tuple)
  ; A transformer a function declares: the error it takes, what it raises, the raise it is
  ; written with, its fact, and whether it tests a chain of earlier errors.
  (blank)
  (prop + source TypeId)
  (prop + raised TypeId)
  (prop + site SyntaxId)
  (prop + fact U32)
  (prop + conditional Bool)
)

(type + HeldErrors (is Struct)
  ; What the end of a body leaves when a callee's errors were not known: the entries on their way
  ; out, the function's transformers, and the two reports that wait on whether anything leaves.
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + entries (of RowRange Outgoing))
  (prop + transforms (of RowRange ErrorTransform))
  (prop + lacks-result Bool)
  (prop + unbuildable Bool)
)

(fn-do + note-previous _
  (param facts Facts)
  (param types Types)
  (param instance InstanceId)
  (param site SyntaxId)
  (param error TypeId)
  ; An error a transformer takes becomes the `previous` of the error raised in its place, which
  ; holds any error or none. That is a conversion at the transformer.
  (if (or (== error invalid-type) (== error no-type))
    (return)
  )
  (let held (call (. types optional-of) (. types error-type)))
  (call (. facts record-conversion) instance site (call side-cast-relation error held) .reason-assignment)
)

(fn-expr + caught-rank (? RelationRank)
  (param relations Relations)
  (param error TypeId)
  (param source TypeId)
  ; The rank at which a transformer declared for a source takes an error, or null when it does
  ; not take it.
  (only-if (. relation rank) (if (or (== (. relation kind) .relation-same) (== (. relation kind) .relation-up-cast))))
  (where
    (lazy relation (call (. relations compare) error source))
  )
)

(fn-do + order-transforms _
  (param relations Relations)
  (param error TypeId)
  (param declared (list ErrorTransform))
  (param tried (list U32))
  ; The transformers an error leaving a function is tried with, as TypeScript tries them: those
  ; whose source takes it, nearest first and then in the order declared, up to the first that
  ; tests no chain of earlier errors, which takes it whatever came before. Their places among
  ; `declared` are added to `tried`.
  (let ranks (list RelationRank))
  (for (in index (..< 0 (. declared length)))
    (let rank (call caught-rank relations error (. ([] declared index) source)))
    (if (== rank null)
      (continue)
    )
    (let place (. tried length))
    (while (and (> place 0) (> ([] ranks (- place 1)) rank))
      (-= place 1)
    )
    (call (. tried insert) (as index U32) place)
    (call (. ranks insert) rank place)
  )
  (for (in position (..< 0 (. tried length)))
    (if (not (. ([] declared ([] tried position)) conditional))
      (while (> (. tried length) (+ position 1))
        (call (. tried pop))
      )
      (return)
    )
  )
)

(fn-do + transform-leaving _
  (param facts Facts)
  (param types Types)
  (param instance InstanceId)
  (param syntax SyntaxId)
  (param error TypeId)
  (param declared (list ErrorTransform))
  (param tried (list U32))
  (param leaving (list TypeId))
  (param noting Bool)
  ; What an error leaving at a node leaves as through the transformers it is tried with: what
  ; each raises, and the error itself where each tests a chain of earlier errors. With `noting`
  ; each converts the error to the `previous` of what it raises, and the node keeps them.
  (let facts-tried (list U32))
  (for (in place tried)
    (let transform ([] declared place))
    (if noting
      (call note-previous facts types instance (. transform site) error)
    )
    (+= leaving (. transform raised))
    (+= facts-tried (. transform fact))
  )
  (if (or (== (. tried length) 0) (. ([] declared ([] tried (- (. tried length) 1))) conditional))
    (+= leaving error)
  )
  (if (and noting (!= (. tried length) 0))
    (call (. facts note-leave) instance syntax error facts-tried)
  )
)

(fn-expr + is-subtype Bool
  (param types Types)
  (param from TypeId)
  (param to TypeId)
  (and (!= to invalid-type) (!= from invalid-type) (call in-base-chain types from to))
)

(type _ ErrorReport (is Tuple)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + kind TypeDiagnosticKind)
  (prop + name (? Atom))
  (prop + source TypeId)
)
