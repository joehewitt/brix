(import ./types)
(import /core/arena)
(import /lang/ast/decl)
(import /lang/ast/module)

(type + SheetExtension (is Struct)
  ; An extension of a style sheet the program declares, the declaration `decl` of `module`, and the
  ; style sheet it extends, the class `sheet` of `sheet-module`; `next` is the next extension of
  ; the same sheet, in the order the modules are declared, or none.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + sheet-module ModuleId)
  (prop + sheet DeclId)
  (prop + next U32 (= (. U32 max)))
)

(type + CheckerCaches
  (prop + open-targets (of List Size ArenaBacking))
  (prop + opens-any-target Bool)
  (prop + derived-sheets (of List TypeId ArenaBacking))
  (prop + derived-listed Bool)
  (prop + sheet-slot-names (of Map Atom U32 ArenaBacking))
  (prop + slot-names-listed Bool)
  (prop + chain-sheets (of List TypeId ArenaBacking))
  (prop + chain-sheet-positions (of List U32 ArenaBacking))
  (prop + chain-sheet-places (of Map Size U32 ArenaBacking))
  (prop + style-rules (of List DeclRef ArenaBacking))
  (prop + style-rule-nexts (of List U32 ArenaBacking))
  (prop _ style-rule-firsts (of Map Atom U32 ArenaBacking))
  (prop _ style-rule-lasts (of Map Atom U32 ArenaBacking))
  (prop + nested-rules (of List Atom ArenaBacking))
  (prop + nested-modules (of List U32 ArenaBacking))
  (prop + scoping-names (of List Atom ArenaBacking))
  (prop + scoping-modules (of List U32 ArenaBacking))
  (prop + rules-listed Bool)
  (prop + sheet-extensions (of List SheetExtension ArenaBacking))
  (prop + sheet-extension-heads (of Map Size U32 ArenaBacking))
  (prop + extensions-listed Bool)
  (fn-do + This _
    (param arena Arena)
    (lazy open-targets (call (of List Size) arena))
    (lazy derived-sheets (call (of List TypeId) arena))
    (lazy sheet-slot-names (call (of Map Atom U32) arena))
    (lazy chain-sheets (call (of List TypeId) arena))
    (lazy chain-sheet-positions (call (of List U32) arena))
    (lazy chain-sheet-places (call (of Map Size U32) arena))
    (lazy style-rules (call (of List DeclRef) arena))
    (lazy style-rule-nexts (call (of List U32) arena))
    (lazy style-rule-firsts (call (of Map Atom U32) arena))
    (lazy style-rule-lasts (call (of Map Atom U32) arena))
    (lazy nested-rules (call (of List Atom) arena))
    (lazy nested-modules (call (of List U32) arena))
    (lazy scoping-names (call (of List Atom) arena))
    (lazy scoping-modules (call (of List U32) arena))
    (lazy sheet-extensions (call (of List SheetExtension) arena))
    (lazy sheet-extension-heads (call (of Map Size U32) arena))
  )
  (fn-do + add-style-rule _
    (param ref DeclRef)
    (param name Atom)
    ; Lists a style rule written outside any rule, after those of its name listed before it.
    (let position (as (. style-rules length) U32))
    (+= style-rules ref)
    (+= style-rule-nexts (. U32 max))
    (let last ([] style-rule-lasts name))
    (if last
      (= ([] style-rule-nexts last) position)
      (else
        (= ([] style-rule-firsts name) position)
      )
    )
    (= ([] style-rule-lasts name) position)
  )
  (fn-expr + first-style-rule U32
    (param name Atom)
    ; The place of the first style rule of a name written outside any rule, or U32.max when none is;
    ; each leads to the next of its name (`style-rule-nexts`).
    (?? ([] style-rule-firsts name) (. U32 max))
  )
)
