    )
    (let found (call loop-source id container read))
    (let item (. found item))
    (let source (. found given))
    (if (== item invalid-type)
      (return invalid-type)
    )
    (if (not (call is-markup-host parent))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Dynamic markup loop parent must implement MarkupElement"))
        )
      )
      (return invalid-type)
    )
    (let tree-host (call derived-interface parent (. types markup-tree-host-decl)))
    (let content (if-expr (!= tree-host no-type) (call first-arg tree-host) no-type))
    (if (or (== content no-type) (== content invalid-type) (. ([] (. types completions) content) has-variables))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Dynamic markup loop host content type could not be resolved"))
        )
      )
      (return invalid-type)
    )
    (if (and (== (call (. types intrinsic-of) content) .class) (not (call makes-region parent)))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (lazy message (str "Markup loop host " (call type-source types parent) " must declare markup-make-region, or extend MarkupNode"))
      (return invalid-type)
    )
    (let regioned (call (. tree row-region) body))
    (if (not (call knows-getters body))
      (return invalid-type)
    )
    (let refreshes (and (!= keyed 0) (== (. found kind) "collection")))
    (let given (if-expr refreshes (call (. types well-known-type-of) "core/markup" "MarkupRowItem" item) item))
    (let builder
      (call (. types well-known-type-of)
        (block
          (arg "core/markup")
          (arg (if-expr refreshes "MarkupCollectionRowBuilder" "MarkupRowBuilder"))
          (arg item)
          (arg content)
        )
      )
    )
    (let shaped (if-expr regioned (call (. types well-known-type-of) "core/markup" "MarkupRegionRowBuilder" given content) builder))
    (let decl (call nested-decl-of body))
    (if (or classless (== builder invalid-type) (== shaped invalid-type) (== given invalid-type) (== decl 0))
      (call decline id)
      (return invalid-type)
    )
    (lazy classless (!= (call (. types intrinsic-of) content) .class))
    (let rooted (call in-batch))
    (let hosted (call is-batch parent))
    (let outer-content region)
    (= region (= (. region content) content))
    (= region (= (. region batch) rooted))
    (= region (= (. region root) (+ (. resolution slot) 2)))
    (let built (call demand-nested decl given (if-expr regioned content no-type)))
    (= region outer-content)
    (if (== built no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let closure (call intern-nested decl))
    (call (. facts set-node-type) instance body closure)
    (if (== (call (. conversions convert) id id closure shaped .reason-markup-row) invalid-type)
      (return invalid-type)
    )
    (let keyer no-type)
    (if (!= keyed 0)
      (= keyer (call (. types well-known-type-of) "core/markup" "MarkupKeyBuilder" item))
      (let key (call nested-decl-of keyed))
      (if (or (== keyer invalid-type) (== key 0) (== (call demand-nested key item) no-instance))
        (call decline id)
        (return invalid-type)
      )
      (let keying (call intern-nested key))
      (call (. facts set-node-type) instance keyed keying)
      (if (== (call (. conversions convert) keyed keyed keying keyer .reason-markup-key) invalid-type)
        (return invalid-type)
      )
    )
    (let filter (call (. tree when-clause) loop))
    (let tester no-type)
    (if (!= filter 0)
      (= tester (call (. types well-known-type-of) "core/markup" "MarkupRowFilter" given))
      (let test (call nested-decl-of filter))
      (if (or (== tester invalid-type) (== test 0) (== (call demand-nested test given) no-instance))
        (call decline id)
        (return invalid-type)
      )
      (let testing (call intern-nested test))
      (call (. facts set-node-type) instance filter testing)
      (if (== (call (. conversions convert) filter filter testing tester .reason-markup-key) invalid-type)
        (return invalid-type)
      )
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (let markup (. types markup-host-decl module))
    (let mark (. scratch types mark))
    (let optional (== (call (. types intrinsic-of) source) .optional))
    (let held (if-expr optional (call (. types optional-inner) source) source))
    (call (. scratch types push) item)
    (call (. scratch types push) content)
    (call (. scratch types push) parent)
    (call (. scratch types push) held)
    (call (. scratch types push) parent)
    (call (. scratch types push) builder)
    (if (!= keyer no-type)
      (call (. scratch types push) keyer)
    )
    (call (. scratch types push) source)
    (let creates (str "markup-create-" (if-expr optional "optional-" "") (if-expr (!= keyed 0) "keyed-" "") (. found kind) "-region"))
    (let create (call (. calls demand-runtime-call) markup no-type (call (. program store-atom) creates) mark 4))
    (call (. scratch types rewind) mark)
    (let made (if-expr (!= create no-instance) (. ([] (. instances signatures) create) returns) no-type))
    (if (or (== made no-type) (!= (call (. types intrinsic-of) made) .class) (not (call is-markup-host made)) (== (. live has-actions) no-instance))
      (call decline id)
      (return invalid-type)
    )
    (call (. scratch types push) item)
    (call (. scratch types push) made)
    (call (. scratch types push) held)
    (call (. scratch types push) made)
    (call (. scratch types push) source)
    (let replaces (str "markup-replace-" (if-expr optional "optional-" "") (. found kind) "-source"))
    (let replace (call (. calls demand-runtime-call) markup no-type (call (. program store-atom) replaces) mark 3))
    (call (. scratch types rewind) mark)
    (if (== replace no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let adapts no-instance)
    (if regioned
      (call (. scratch types push) item)
      (call (. scratch types push) content)
      (call (. scratch types push) parent)
      (call (. scratch types push) parent)
      (call (. scratch types push) shaped)
      (if (!= tester no-type)
        (call (. scratch types push) tester)
      )
      (let kind (if-expr (!= tester no-type) "filtered-row" "row"))
      (let adapter (if-expr refreshes (str "markup-region-keyed-" kind) (str "markup-region-" kind)))
      (= adapts (call (. calls demand-runtime-call) markup no-type (call (. program store-atom) adapter) mark 3))
      (call (. scratch types rewind) mark)
      (if (or (== adapts no-instance) (!= (. ([] (. instances signatures) adapts) returns) builder) (not (call raises-out id adapts)))
        (call decline id)
        (return invalid-type)
      )
    )
    (let host (call derived-interface made (. types markup-host-decl)))
    (call (. scratch types push)
      (block
        (arg (if-expr (!= (. live trackers) no-instance) (. ([] (. instances signatures) (. live trackers)) returns) no-type))
      )
    )
    (call (. scratch types push) (. live callback))
    (call (. scratch types push) (if-expr rooted (call batch-type) host))
    (let action
      (call (. calls demand-runtime-call)
        (block
          (arg markup)
          (arg no-type)
          (arg (call (. program store-atom) (if-expr rooted "make-markup-action" "make-owner-markup-action")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let structural (call mark-structural id made))
    (if (or (== action no-instance) (== structural no-instance) other-return)
      (call decline id)
      (return invalid-type)
    )
    (lazy other-return (!= (. ([] (. instances signatures) action) returns) (. types live-action-type)))
    (if (or (not (call raises-out id create)) (not (call raises-out id action)) (not (call raises-out id structural)))
      (call decline id)
      (return invalid-type)
    )
    (if hosted
      (call (. conversions convert) id id parent (call batch-type) .reason-markup-batch)
    )
    (let ensure (call region-ensure id made (or rooted hosted) .reason-markup-region))
    (if (not ensure)
      (return invalid-type)
    )
    (call (. conversions convert) id id made host .reason-markup-host)
    (call (. frame assign) (. resolution slot) parent)
    (call (. frame assign) (+ (. resolution slot) 1) made)
    (call (. frame assign) (+ (. resolution slot) 2) (if-expr rooted (call batch-type) (. types void-type)))
    (let outer-source region)
    (= region (= (. region source) source))
    (= region (= (. region replace) replace))
    (let updater (call demand-lambda (call intern-nested (call nested-decl-of id)) (. scratch no-types)))
    (= region outer-source)
    (if (or (== updater no-instance) (and updater-raises (== (. live callback-result) no-type)))
      (call decline id)
      (return invalid-type)
    )
    (lazy updater-raises (!= (. ([] (. instances signatures) updater) errors count) 0))
    (call (. instances mark-may-panic) instance)
    (+= (. facts loop-regions)
      (call LoopRegion
        (block
          (arg instance)
          (arg id)
          (arg parent)
          (arg content)
          (arg source)
          (arg create)
          (arg updater)
          (arg action)
          (arg structural)
          (arg ensure)
          (arg hosted)
          (arg rooted)
          (arg replace)
          (arg adapts)
        )
      )
    )
    (return made)
  )
  (fn-do _ knows-getters Bool
    (param body SyntaxId)
    ; Whether the lazy declarations of the body of a markup loop region's row are those the binder
    ; found a getter in. One it found none in has no shape here.
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) line)
            (case (call .node-declare declared)
              (if (and (. declared is-lazy) (not (call declares-getter (. declared left))))
                (call decline line)
                (return false)
              )
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do + check-selector _
    (param anchor SyntaxId)
    (let id (call (. tree selector-control) anchor))
    (call prepare)
    (call demand-live-runtime)
    (let selected (call (. types optional-of) (. types index-type)))
    (call (. instances set-returns) instance selected selected .return-declared)
    (+= content-blocks 0)
    (+= content-parents no-type)
    (call read-arms id)
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (call finish-errors frame)
    (call close)
  )
  (fn-do + host-content _
    (param statement SyntaxId)
    (param parent TypeId)
    ; An `if`, a match or table whose arms run as content (`runs-content`), a `for`, and a loop
    ; written with `in` that is no function of its own, written as lines of a markup element's body,
    ; run their bodies as content of the same element: each body is noted as such while the
    ; statement is typed. A loop on a stream subscribes, and its body is no content, the arms of a
    ; markup branch region are content of the region, which functions of their own build, and the
    ; body of a markup loop region builds a row.
    (if (or (call is-region statement) (call is-loop-region statement))
      (return)
    )
    (match? ([] (. tree nodes) statement)
      (case .node-if-block
        (let branch statement)
        (while (!= branch 0)
          (let next SyntaxId 0)
          (match? ([] (. tree nodes) branch)
            (case (call .node-if-block row)
              (+= content-blocks (call (. tree arm-body) branch))
              (+= content-parents parent)
              (= next (. row next))
            )
          )
          (= branch next)
        )
      )
      (case .node-match-expression
        (for (in body (call (. tree content-arms) statement))
          (+= content-blocks body)
          (+= content-parents parent)
        )
      )
      (case .node-structure-match
        (for (in body (call (. tree content-arms) statement))
          (+= content-blocks body)
          (+= content-parents parent)
        )
      )
      (case (call .node-for-block row)
        (if (call (. tree is-subscriber-loop) (. row loop))
          (return)
        )
        (+= content-blocks (. row body))
        (+= content-parents parent)
      )
      (case (call .node-iterator-expression row)
        (if (!= (call nested-decl-of statement) 0)
          (return)
        )
        (+= content-blocks (. row body))
        (+= content-parents parent)
      )
    )
  )
  (fn-do + link-content _
    (param statement SyntaxId)
    (param produced TypeId)
    (param parent TypeId)
    ; A line of a markup element's body that gives a value is taken by the element: by its
    ; `+=`, or else its `++=`, with the value converted as an argument of the one found, or where
    ; the element is a markup host as `link-hosted` says. The call is kept for the line. An
    ; assignment, a print and a state machine give the element nothing, and a loop written as an
    ; expression has no shape as a line. An element no local is declared for, named for the property
    ; its class's markup declares for it, gives the property what the call answers, or the object
    ; where it answers nothing.
    (if (or untyped (== produced (. types void-type)) (call (. tree is-quasi-syntax) statement))
      (return)
    )
    (lazy untyped (or (== produced no-type) (== produced invalid-type)))
    (if (is ([] (. tree nodes) statement) .node-state-machine)
      (return)
    )
    (if (is ([] (. tree nodes) statement) .node-iterator-expression)
      (call decline statement)
      (return)
    )
    (if (call is-markup-host parent)
      (call link-hosted statement produced parent)
      (return)
    )
    (let content (call (. calls content-call) parent (call (. program store-atom) "+=") statement produced))
    (if (== (. content taken) no-type)
      (= content (call (. calls content-call) parent (call (. program store-atom) "++=") statement produced))
    )
    (let taken (. content taken))
    (let link (. content fact))
    (let answered (. content answer))
    (if (or (== taken no-type) (== link no-fact))
      (call (. frame diagnose) statement .stated (call (. program store-atom) "Content not accepted"))
      (return)
    )
    (call (. conversions convert) statement statement produced taken .reason-argument)
    (let answers no-type)
    (let named (call named-element statement))
    (if (and named (!= answered no-type))
      (if (== answered invalid-type)
        (call decline statement)
        (return)
      )
      (if (== (call (. conversions convert) statement statement answered (call (. frame slot-type) named) .reason-assignment true true) invalid-type)
        (return)
      )
      (= answers answered)
    )
    (call (. facts note-content-link) (call ContentLink instance statement parent taken link answers))
    (if named
      (call note-named statement (if-expr (!= answers no-type) answers (call (. frame slot-type) named)))
      (else-if (call content-named statement)
        (call note-named
          (block
            (arg statement)
            (arg (if-expr (and (!= answered no-type) (!= answered (. types void-type))) answered produced))
          )
        )
      )
    )
  )
  (fn-do _ link-hosted _
    (param statement SyntaxId)
    (param produced TypeId)
    (param parent TypeId)
    ; A line of the body of a markup element whose class is a markup host is taken through the
    ; markup protocol: by the host's `markup-absorb` where the value is an argument of one, which
    ; keeps it in the host's own state; else by its `markup-content`, which answers the node the
    ; value becomes, and that node is linked as the host's last child by the markup runtime's
    ; `markup-append`. A line that is an element a name is declared for gives the name the node,
    ; converted as a value assigned to the name, which casts it, checked, to the element's class;
    ; but where the element gives slots content and its name is a property of the class the markup
    ; is run on, the name and the property keep the object, as the reference keeps it there. One no
    ; local is declared for, named for the property its class's markup declares for it, gives the
    ; property the node, or the object where the host absorbs it.
    (let absorbing (call (. calls content-call) parent (call (. program store-atom) "markup-absorb") statement produced))
    (let absorbed (. absorbing taken))
    (if (!= absorbed no-type)
      (call (. conversions convert) statement statement produced absorbed .reason-argument)
      (call (. facts note-content-link) (call ContentLink instance statement parent absorbed (. absorbing fact)))
      (let kept (call named-element statement))
      (if kept
        (call note-named statement (call (. frame slot-type) kept))
        (else-if (call content-named statement)
          (call note-named statement produced)
        )
      )
      (return)
    )
    (let content (call (. calls content-call) parent (call (. program store-atom) "markup-content") statement produced))
    (let taken (. content taken))
    (let link (. content fact))
    (let answered (. content answer))
    (if (or (== taken no-type) (== link no-fact) (== answered no-type))
      (call (. frame diagnose) statement .stated (call (. program store-atom) "Content not accepted"))
      (return)
    )
    (let named (call named-element statement))
    (if (== answered invalid-type)
      (call decline statement)
      (return)
    )
    (call (. conversions convert) statement statement produced taken .reason-argument)
    (let kept (and named (not (call binds-property statement))))
    (if (and kept (== (call (. conversions convert) statement statement answered (call (. frame slot-type) (!! named)) .reason-assignment true true) invalid-type))
      (return)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) parent)
    (call (. scratch types push) answered)
    (let append
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "markup-append"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== append no-instance)
      (call decline statement)
      (return)
    )
    (let answers (if-expr kept answered no-type))
    (call (. facts note-content-link) (call ContentLink instance statement parent taken link answers append))
    (if kept
      (call note-named statement answered)
      (else-if (call content-named statement)
        (call note-named statement answered)
      )
      (else-if named
        (call note-named statement (call (. frame slot-type) named))
      )
    )
  )
  (fn-do _ content-named Bool
    (param statement SyntaxId)
    ; Whether a line of content is a markup element that no block declares a local for, whose name
    ; is that of the property the markup of the class declares for it (`names-content-property`).
    (match? ([] (. tree nodes) statement)
      (case (call .node-markup row)
        (return
          (scope (and unslotted (call names-content-property statement (. row id)))
            (lazy unslotted (and (!= (. row id) 0) (not (call element-slot statement (. row id)))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ names-content-property Bool
    (param element SyntaxId)
    (param name SyntaxId)
    ; Whether the name of a markup element is that of a property the markup of the class of the
    ; object the function runs on declares for its elements of that name, where the element is one
    ; of them: written in that markup outside any function or loop of it. The reference gives such
    ; a property each such element's object, as `named-place` says.
    (if (!= (. (call (. bindings resolution-of) (. frame binding) name) kind) .resolve-member)
      (return false)
    )
    (let self (. frame self-type))
    (if (or (== self no-type) (== self invalid-type) (!= (call (. types intrinsic-of) self) .class) (call lacks-self))
      (return false)
    )
    (let text (call (. tree identifier-name) name))
    (let place (only-if (call property-named self text) (if text)))
    (if (not place)
      (return false)
    )
    (let ref (call declaring-decl types ([] (. types properties) place)))
    (let member (call owner-property program (. ref module) (. ref decl) (!! text)))
    (if (== member 0)
      (return false)
    )
    (let content SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class class)
        (= content (. class content))
      )
    )
    (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
      (case (call .decl-property declared)
        (return
          (scope (and owned (<= (call (. tree subtree-start) content) element) (not enclosed))
            (lazy owned (and (!= (. declared element) 0) (== (. ref module) module) (> content element)))
            (lazy enclosed (call (. tree enclosed-element) element content))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + named-element (? SlotId)
    (param statement SyntaxId)
    ; The local a line of content that is a markup element declares for the element, where a
    ; block declares one.
    (match? ([] (. tree nodes) statement)
      (case (call .node-markup row)
        (return (call element-slot statement (. row id)))
      )
    )
    (return null)
  )
  (fn-expr + element-slot (? SlotId)
    (param element SyntaxId)
    (param name SyntaxId)
    ; The local a block declares for a markup element written with a name. A name no block
    ; declares for the element may find a local something else declared, which is not one.
    (case? (== name 0)
      null
    )
    (case? (and slot (== (. ([] (. bindings slots) slot) group) element))
      slot
    )
    (default
      null
    )
    (where
      (lazy slot (call declaring-slot name))
    )
  )
  (fn-expr + places-across Bool
    (param slot SlotId)
    ; Whether a local a function this one is written in declares for a markup element's name is
    ; reached through functions that build slots alone, from this one out to the one that
    ; declares it.
    (case? (or (not outer) (not (call (. frame is-captured) slot)))
      true
    )
    (case? (!= (. frame declaration kind) .slot-decl)
      false
    )
    (default
      (call (. outer places-across) slot)
    )
  )
  (fn-do + check-region _
    (param id SyntaxId)
    (param body SyntaxId)
    ; A `do without gc` block written where code is outside the zone the collector never sees, as the
    ; reference outlines it: a function of its own, typed once, which reaches the locals and
    ; arguments of the function around it where they are kept and is called where the block is.
    ; What the flow knows of those locals holds in the body as in a plain block, and what the body
    ; leaves them as holds after it (`leave-region`). The call ends what is known of properties, as
    ; any call does. A block whose last line returns or raises is the reference's error. One that
    ; lets an error out has no shape here. A body that captures a local is given an object the
    ; collector owns where it runs.
    (if (call (. tree ends-returning) body)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "GC-free do blocks cannot return from their enclosing function"))
        )
      )
      (return)
    )
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) id)
        (let mask (call callee-effects frame module (. nested decl)))
        (let none (. scratch no-types))
        (let callee (call (. instances intern) module (. nested decl) no-type mask instance none none false))
        (let left (list Narrowed))
        (if (== (. ([] (. instances rows) callee) state) .instance-unstarted)
          (+= (. facts region-bodies) callee)
          (= left (call run-within callee this))
        )
        (if (!= (. ([] (. instances signatures) callee) errors count) 0)
          (call decline id)
          (return)
        )
        (if (!= (. nested captures count) 0)
          (call (. frame check-allocates) id)
        )
        (call (. facts record-call) instance id callee .call-function (. scratch no-fills) false)
        (if (. ([] (. instances rows) callee) may-panic)
          (call (. instances mark-may-panic) instance)
        )
        (call forget-assigned nested)
        (call (. frame keep-assigned) left)
        (call (. frame forget-members))
        (return)
      )
    )
    (call decline id)
  )
  (fn-do _ forget-assigned _
    (param nested NestedFunction)
    ; Each local a `do without gc` block assigns is known past the block as its own type, until what
    ; the body left it as is known again (`leave-region`): a body typed before is not typed again.
    (for (in index (..< 0 (. nested captures count)))
      (let capture ([] (. bindings captures) (+ (. nested captures start) index)))
      (if (== (/and/ (. capture flags) (. CaptureFlag capture-assigned)) 0)
        (continue)
      )
      (let held (call slot-known (. capture slot)))
      (if (or (== held no-type) (== held invalid-type))
        (continue)
      )
      (call (. frame push-assigned) (call slot-key (. capture slot)) held)
      (call (. frame reset-paths) (call slot-key (. capture slot)))
    )
  )
  (fn-do + read-later-element TypeId
    (param id SyntaxId)
    (param name Atom)
    (param slot SlotId)
    (if (call starts-task slot)
      (let message (str "Named markup element \"" (. name text) "\" is read in a task started before its markup constructs it, and a task keeps what it reads as it starts; start the task after the markup"))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let class (call foresee-element slot))
    (if (or (== class invalid-type) (== class no-type))
      (call decline id)
      (return invalid-type)
    )
    (if (. ([] (. types completions) class) has-variables)
      (let written (call class-name-of (call class-ref types class)))
      (let message (str "Named markup element \"" (. name text) "\" is read in a closure made before its markup constructs it, so it needs its type arguments written after \"" written "\""))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (call (. instances mark-may-panic) instance)
    (call (. facts set-plan) instance id .plan-guarded-read)
    (return class)
  )
  (fn-do _ keep-element Bool
    (param element SyntaxId)
    (param made TypeId)
    ; The local no name reaches that keeps the object of a markup element, where a function written
    ; in its body reads its members by name alone or one gives its arguments again, holds one of the
    ; element's class: the class written, as the functions that build regions of its body are typed
    ; with the body, and then that of the object made, which must be the same. False where it is not.
    (let resolution (call (. bindings resolution-of) (. frame binding) element))
    (if (!= (. resolution kind) .resolve-slot)
      (return true)
    )
    (let held (call (. frame slot-type) (. resolution slot)))
    (if (and (!= held no-type) (!= held made))
      (return false)
    )
    (call (. frame assign) (. resolution slot) made)
    (return true)
  )
  (fn-do + writes-markup Bool
    ; Whether the body of the function being typed writes a markup element.
    (let body (. frame declaration body))
    (if (== body 0)
      (return false)
    )
    (for (in node (.. (call (. tree subtree-start) body) body))
      (if (is ([] (. tree nodes) node) .node-markup)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + is-markup-query Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (or (call (. types ancestor-decl refers-to) (. row module) (. row decl)) descendant-query)
        (blank)
        (lazy descendant-query (call (. types descendants-decl refers-to) (. row module) (. row decl)))
      )
      (default
        false
      )
    )
  )
  (fn-do + content-property-type TypeId
    (param ref DeclRef)
    (param line SyntaxId)
    ; The type of the property a line of a class's markup declares (`content-property`): that of the
    ; value the line gives it, as each function that fills an object with the markup typed it, which
    ; must agree, as the reference gives the property the type of the first value stored. Where none
    ; has typed the line yet, a filler or constructor of the class still waiting in the queue is typed
    ; first, one at a time, until one has (`pending-filler`). None where none is left.
    (let owner-module ([] (. program modules) (. ref module)))
    (let filler DeclId 0)
    (match? ([] (. owner-module decls) (. ref decl))
      (case (call .decl-class class)
        (= filler (. class content-function))
      )
    )
    (let value SyntaxId 0)
    (match? ([] (. owner-module tree nodes) line)
      (case (call .node-property-syntax row)
        (= value (. row value))
      )
    )
    (if (or (== filler 0) (== value 0))
      (return invalid-type)
    )
    (while true
      (let found no-type)
      (for (in unit (..< 0u32 (as (. instances rows length) U32)))
        (let row ([] (. instances rows) unit))
        (if (and (== (. row module) (. ref module)) (== (. row decl) filler))
          (let typed (call (. facts node-type) unit value))
          (if (and (!= typed no-type) (!= typed invalid-type))
            (if (and (!= found no-type) (!= found typed))
              (return invalid-type)
            )
            (= found typed)
          )
        )
      )
      (if (!= found no-type)
        (return found)
      )
      (let pending (call pending-filler ref filler))
      (if (== pending no-instance)
        (return invalid-type)
      )
      (call demand-body pending)
    )
  )
  (fn-do + infer-content-property TypeId
    (param id SyntaxId)
    (param value SyntaxId)
    (param want Want)
    ; A line of a class's markup that declares a property it gives its value (`content-property`), as
    ; the reference's content runs it: the value is stored in the property of the object being filled
    ; where the line runs, as an assignment to the property named alone stores it, and runs again
    ; where it reads something tracked, as a live assignment does. The line gives no content. One
    ; whose name its class or a class above declares too is reported (`report-content-clash`).
    (let left (call (. tree content-property-name) id))
    (let name (only-if (call (. tree identifier-name) left) (if (!= left 0))))
    (if (or (not name) (!= (. (call (. bindings resolution-of) (. frame binding) left) kind) .resolve-member))
      (call decline id)
      (return invalid-type)
    )
    (if (not (call owns-content-property (. frame self-type) name id))
      (call report-content-clash (. frame self-type) name id)
      (return invalid-type)
    )
    (let assigned (call infer-assign id .eq-op left value want))
    (if (and (!= assigned invalid-type) (!= (. facts live-statements length) 0))
      (call settle-live-statement id left value (call (. facts node-type) instance value))
    )
    (return assigned)
  )
  (fn-do _ report-content-clash _
    (param receiver TypeId)
    (param name Atom)
    (param id SyntaxId)
    ; Reports the property of a name that the class whose markup holds the line `id`, or a class
    ; above it, declares otherwise than the line does (`content-property`), as the reference reports
    ; a property stored two ways: `Inherited properties must have same assignment type` at that
    ; declaration, where it is a stored one of this module. Any other clash, one a class below
    ; declares among them, is declined.
    (let level (? TypeId) receiver)
    (let reached false)
    (while level
      (let ref (call class-ref types level))
      (= reached (or reached (call holds-line ref id)))
      (let member (call owner-property program (. ref module) (. ref decl) name))
      (if (!= member 0)
        (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
          (case (call .decl-property row)
            (if (and (!= (. row line) id) reached)
              (if (and (== (. ref module) module) (not (. row is-lazy)))
                (call (. frame diagnose)
                  (block
                    (arg (. row syntax))
                    (arg .stated)
                    (arg
                      (call (. program store-atom)
                        (block
                          (arg "Inherited properties must have same assignment type")
                        )
                      )
                    )
                  )
                )
                (return)
              )
              (call decline id)
              (return)
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (call decline id)
  )
  (fn-do _ holds-line Bool
    (param ref DeclRef)
    (param id SyntaxId)
    ; Whether a line of this module is one of the markup the class `ref` writes.
    (if (!= (. ref module) module)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) (. ref decl))
      (case (call .decl-class class)
        (return (and (!= (. class content) 0) (<= (call (. tree subtree-start) (. class content)) id) (<= id (. class content))))
      )
    )
    (return false)
  )
  (fn-do _ owns-content-property Bool
    (param receiver TypeId)
    (param name Atom)
    (param line SyntaxId)
    ; Whether the property of a name an object of `receiver` has is the one a line of the markup of
    ; its class, or of a class above, declares (`content-property`), and no class above that one
    ; declares one of the name.
    (let level (? TypeId) receiver)
    (while level
      (let ref (call class-ref types level))
      (let member (call owner-property program (. ref module) (. ref decl) name))
      (if (!= member 0)
        (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
          (case (call .decl-property row)
            (if (or (!= (. row line) line) (!= (. ref module) module))
              (return false)
            )
            (let above (call (. types base-of) level))
            (return (or (not above) (not (call property-named above name))))
          )
        )
        (return false)
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
)
