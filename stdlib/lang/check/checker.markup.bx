(type _ Markup (facet-of Checker)
  (sees Assignments)
  (sees CallTyping)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Styles)
  (fn-do + leave-region _
    ; Keeps what the assignments of the body of a `do without gc` block left each local it captures as,
    ; for the function around it to take once the body is checked (`check-region`): that holds after
    ; the block as after a plain one.
    (for (in row (. frame assigned-in-frame))
      (if (and (not (call is-member-key (. row key))) (call (. frame is-captured) (call key-slot (. row key))))
        (+= region-left row)
      )
    )
  )
  (fn-do + clashes-element Bool
    (param receiver TypeId)
    (param content SyntaxId)
    (if (or (== content 0) no-receiver (!= (call (. types intrinsic-of) receiver) .class))
      (return false)
    )
    (lazy no-receiver (or (== receiver no-type) (== receiver invalid-type)))
    (let root (call (. tree root-this) content))
    (for (in node (..< (call (. tree subtree-start) content) content))
      (match? ([] (. tree nodes) node)
        (case (call .node-markup row)
          (if (and named-element (call clashes-property receiver node (. row id) (. row type-id)))
            (return true)
          )
          (lazy named-element (and (!= (. row id) 0) (!= node root) (not (call (. tree enclosed-element) node content))))
        )
      )
    )
    (return false)
  )
  (fn-do _ clashes-property Bool
    (param receiver TypeId)
    (param element SyntaxId)
    (param name SyntaxId)
    (param written SyntaxId)
    (let text (call (. tree identifier-name) name))
    (let place (only-if (call property-named receiver text) (if text)))
    (if (or (not place) (call names-element types ([] (. types properties) place)))
      (return false)
    )
    (let property ([] (. types properties) place))
    (let held (. property type))
    (if (== held no-type)
      (= held (call demand-member property receiver (!! text)))
    )
    (call (. types clear-fault))
    (let made (call (. types evaluate-type) module tree written (. frame env)))
    (call (. types clear-fault))
    (if (or (== held no-type) (== held invalid-type) (== made invalid-type) generic)
      (return false)
    )
    (lazy generic (. ([] (. types completions) made) has-variables))
    (if (call holds-object made held)
      (return false)
    )
    (let message (str "Named markup element \"" (. (!! text) text) "\" clashes with property \"" (. (!! text) text) "\", which holds " (call type-source types held) ", not " (call type-source types made) "; rename the element"))
    (call (. frame diagnose) element .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-expr _ holds-object Bool
    (param made TypeId)
    (param held TypeId)
    (case? (and (== kind .relation-side-cast) (call (. types is-optional) held))
      (call holds-object made (call (. types optional-inner) held))
    )
    (default
      (or direct interface-cast (== kind .relation-or-cast) (== kind .relation-wrap-cast))
    )
    (where
      (lazy kind (. (call (. relations compare) made held) kind))
      (lazy direct (or (== kind .relation-same) (== kind .relation-equal) (== kind .relation-up-cast)))
      (lazy interface-cast (== kind .relation-interface-cast))
    )
  )
  (fn-do + waits-for-markup Bool
    (param level TypeId)
    (param module ModuleId)
    (param syntax SyntaxId)
    ; Whether a rule a class writes runs once the markup of the class has, as the reference runs
    ; it, rather than once a constructor's body has: where the class, or one above it, writes
    ; markup, each section that subscribes to a stream does, and so does a `when` or `whenever`
    ; rule whose test reads a member of a name the markup gives an element, apart from the
    ; functions written there.
    (if (not (call writes-content level))
      (return false)
    )
    (let tree (. ([] (. program modules) module) tree))
    (let test SyntaxId 0)
    (match? ([] (. tree nodes) syntax)
      (case .node-subscriber-syntax
        (return true)
      )
      (case (call .node-when-rule-syntax rule)
        (= test (. rule expr))
      )
      (case (call .node-whenever-rule-syntax rule)
        (= test (. rule expr))
      )
    )
    (if (== test 0)
      (return false)
    )
    (let floor (call (. tree subtree-start) test))
    (let node (+ test 1))
    (while (> node floor)
      (-= node 1)
      (match? ([] (. tree nodes) node)
        (case .node-function-syntax
          (= node (call (. tree subtree-start) node))
        )
        (case (call .node-get-expression get)
          (match? ([] (. tree nodes) (. get object))
            (case (call .node-identifier read)
              (let place (call property-named level (. read name)))
              (if (and place (call names-element types ([] (. types properties) place)))
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + own-markup-actions _
    (param receiver TypeId)
    (param site SyntaxId)
    ; How the function being typed makes the live actions the object it makes or fills owns, where
    ; its class is a markup host or batch, as the reference's `createMarkupAction` makes them with
    ; the object as owner: for a markup host, the markup runtime's `make-owner-markup-action`,
    ; given the object as its host, else `make-markup-action`, given it as the batch, each
    ; converted at `site`. It is noted only where a value or rule it runs is live
    ; (`live-owned`), and otherwise noted with none, so that a plain action is made for no such
    ; object. Either may raise.
    (if (or (== receiver no-type) (== receiver invalid-type) (call owns-plain-actions receiver))
      (return)
    )
    (if (not live-owned)
      (+= (. facts self-actions) (call SelfAction instance site no-instance false))
      (return)
    )
    (let host (call derived-interface receiver (. types markup-host-decl)))
    (let rooted (== host no-type))
    (let wanted (if-expr rooted (call batch-type) host))
    (call demand-live-runtime)
    (let live (. instances live))
    (let mark (. scratch types mark))
    (call (. scratch types push)
      (block
        (arg (if-expr (!= (. live trackers) no-instance) (. ([] (. instances signatures) (. live trackers)) returns) no-type))
      )
    )
    (call (. scratch types push) (. live callback))
    (call (. scratch types push) wanted)
    (let action
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) (if-expr rooted "make-markup-action" "make-owner-markup-action")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== action no-instance) (== (. live has-actions) no-instance) wrong-return)
      (call decline site)
      (return)
    )
    (lazy wrong-return (!= (. ([] (. instances signatures) action) returns) (. types live-action-type)))
    (if (not (call raises-out site action))
      (call decline site)
      (return)
    )
    (if rooted
      (call (. conversions convert) site site receiver wanted .reason-markup-batch)
      (else
        (do
          (inline (call host-self receiver site))
        )
      )
    )
    (+= (. facts self-actions) (call SelfAction instance site action rooted))
  )
  (fn-do + is-ancestor-query Bool
    (param query TypeId)
    ; Whether a query of the markup an object is in looks for an ancestor, `Ancestor'T`.
    (match? ([] (. types rows) query)
      (case (call .type-class row)
        (return (call (. types ancestor-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return false)
  )
  (fn-do + trigger-target TypeId
    (param ref DeclRef)
    (param syntax SyntaxId)
    ; The class a rule a class or a facet of one writes looks for among the children or descendants
    ; of the object's markup host, `whenever children T` or `whenever descendants T`, where it is a
    ; markup host, or no type.
    (let env (call holder-env ref))
    (let type (call rule-target (. ref module) syntax env))
    (call (. types env-release) env)
    (return type)
  )
  (fn-do + markup-query U32
    (param level TypeId)
    (param query TypeId)
    (param site SyntaxId)
    (param written-module ModuleId)
    (param written SyntaxId)
    (param name (? Atom))
    ; The row of `markup-queries` for a property a class declares as a query of the markup its
    ; object is in, recorded the first time a constructor registers it, and found by the class and
    ; the property after that, taking again where the property is written, which an edit typed again
    ; in place may move (`retype-edit`): the functions the reference makes for it read the object as
    ; one of the class, made its markup host as converted here, and call the markup runtime to find
    ; a parent host, or to add an object to a list kept in order or take one from it. The class and
    ; the class the query looks for must be markup hosts, which the reference reports, and the latter
    ; must declare no `==`, since a new answer is compared with the old as one object. Those have no
    ; shape here.
    (let place (only-if (call property-named level name) (if name)))
    (if (not place)
      (call decline site)
      (return (. U32 max))
    )
    (for (in offset (..< 0 (. facts markup-queries length)))
      (if (and same-level (== (. ([] (. facts markup-queries) offset) place) (as place U32)))
        (= (. ([] (. facts markup-queries) offset) module) written-module)
        (= (. ([] (. facts markup-queries) offset) site) written)
        (return (as offset U32))
      )
      (lazy same-level (== (. ([] (. facts markup-queries) offset) level) level))
    )
    (let target (call query-target query))
    (let ancestor (call is-ancestor-query query))
    (if (or (not (call is-markup-host level)) (not (call is-markup-host target)))
      (call decline site)
      (return (. U32 max))
    )
    (for (in token (list "==" "!="))
      (if (call (. calls has-operator) target (call (. program store-atom) token) target)
        (call decline site)
        (return (. U32 max))
      )
    )
    (let host (call derived-interface level (. types markup-host-decl)))
    (let held (. ([] (. types properties) place) type))
    (let module (. types markup-host-decl module))
    (let row
      (call MarkupQuery
        (block
          (arg level)
          (arg (as place U32))
          (arg written-module)
          (arg written)
          (arg target)
          (arg 0)
          (arg no-fact)
          (arg no-instance)
          (arg no-instance)
          (arg no-instance)
        )
      )
    )
    (let mark (. scratch types mark))
    (if ancestor
      (call (. scratch types push) host)
      (= (. row parent)
        (call (. calls demand-runtime-call)
          (block
            (arg module)
            (arg no-type)
            (arg (call (. program store-atom) "markup-query-parent-host"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (or (== (. row parent) no-instance) (!= held (call (. types optional-of) target)))
        (call decline site)
        (return (. U32 max))
      )
      (else
        (let found (call (. facts query-targets find) target))
        (if (not found)
          (call decline site)
          (return (. U32 max))
        )
        (= (. row target-id) (as (+ found 1) U32))
        (call (. scratch types push) held)
        (call (. scratch types push) host)
        (call (. scratch types push) target)
        (= (. row add)
          (call (. calls demand-runtime-call)
            (block
              (arg module)
              (arg no-type)
              (arg (call (. program store-atom) "markup-query-add-descendant"))
              (arg mark)
            )
          )
        )
        (= (. row remove)
          (call (. calls demand-runtime-call)
            (block
              (arg module)
              (arg no-type)
              (arg (call (. program store-atom) "markup-query-remove-descendant"))
              (arg mark)
            )
          )
        )
        (call (. scratch types rewind) mark)
        (if (or (== (. row add) no-instance) (== (. row remove) no-instance))
          (call decline site)
          (return (. U32 max))
        )
      )
    )
    (let recorded (. facts conversions length))
    (call (. conversions convert) 0 0 level host .reason-markup-host)
    (if (or unrecorded (!= (. ([] (. facts conversions) recorded) from) level) (!= (. ([] (. facts conversions) recorded) to) host))
      (call decline site)
      (return (. U32 max))
    )
    (lazy unrecorded (== (. facts conversions length) recorded))
    (= (. row hosted) (as recorded FactId))
    (+= (. facts markup-queries) row)
    (return (as (- (. facts markup-queries length) 1) U32))
  )
  (fn-do _ element-context U32
    (param class TypeId)
    (param id SyntaxId)
    ; The styles and style sheets a markup element of a class sees, which the reference hands the
    ; constructor of a class whose markup is its content, to make it under them
    ; (`markupStyleContextFor`): the element's vocabulary (`style-vocabulary`), the sheets it sees
    ; (`visible-sheets`) and the rules written in rules it sees, with those its own rules bring into
    ; view (`push-scopes`), as a context among `instances.contexts`; the sheets alone for a class
    ; that writes none but whose defaults apply rules (`defaults-apply-rules`); none for any other
    ; class, or where there are none. Each rule written in a rule under the state cell of a `when`
    ; gives the constructor the cell (`CarriedCell`), in turn, and then the values of each rule
    ; around rules written in it that takes some, once each (`CarriedValues`). `U32.max - 1` where
    ; it is declined: where they are not known here, or a using is.
    (if (or (!= (call (. types intrinsic-of) class) .class) (not (call (. program module-by-name) "core/style")))
      (return (. U32 max))
    )
    (let content (call writes-content class))
    (if (and (not content) (not (call defaults-apply-rules class)))
      (return (. U32 max))
    )
    (if (not (call sheets-known))
      (call decline id)
      (return (- (. U32 max) 1))
    )
    (let styles (list TypeId))
    (if content
      (let seen (call style-vocabulary class id))
      (if (not seen)
        (return (- (. U32 max) 1))
      )
      (= styles seen)
    )
    (let sheets (list TypeId))
    (let levels (list U32))
    (if (!= (call (. types well-known-type) "core/style" "StyleSheetInfo") invalid-type)
      (call visible-sheets class sheets levels)
    )
    (if (and (not content) (== (. sheets length) 0))
      (return (. U32 max))
    )
    (let scopes (list RuleScope))
    (let cells (list U32))
    (let carried (list U32))
    (let valued (list U32))
    (let value-types (list TypeId))
    (let rows (list U32))
    (if content
      (if (and (not (call scopes-known)) (call nested-any))
        (call decline id)
        (return (- (. U32 max) 1))
      )
      (let seen (. rule-scopes length))
      (call push-scopes id)
      (let next U32)
      (for (in use rule-scopes)
        (+= scopes (. use scope))
        (let count (call use-cells use))
        (+= cells count)
        (if (!= count 0)
          (call (. facts link-cells) (. use outer-cells) carried)
          (+= carried (. use cell))
          (+= next count)
        )
      )
      (let known (call place-values next valued value-types rows))
      (while (> (. rule-scopes length) seen)
        (call (. rule-scopes pop))
      )
      (if (not known)
        (call decline id)
        (return (- (. U32 max) 1))
      )
    )
    (let recorded false)
    (for (in held (. facts carried-cells))
      (= recorded (or recorded (and (== (. held instance) instance) (== (. held site) id))))
    )
    (for (in held (. facts carried-values))
      (= recorded (or recorded (and (== (. held instance) instance) (== (. held site) id))))
    )
    (if (not recorded)
      (for (in cell carried)
        (+= (. facts carried-cells) (call CarriedCell instance id cell))
      )
      (for (in row rows)
        (+= (. facts carried-values) (call CarriedValues instance id row))
      )
    )
    (return (call (. instances intern-context) styles sheets levels scopes cells no-type 0 valued value-types))
  )
  (fn-do + content-context U32
    ; The context the function that fills an object with its class's markup is made under, as
    ; `load-context` took it, which it hands the function of the class above: with the rules
    ; written in rules of the markup that made the object as it was given them, but not those its own
    ; markup brings into view, with the state cells it was given, which it gives on; and where a rule
    ; `• This` holds rules (`scoping-names`), the class of the object, which the class above brings
    ; those of its chain's rules `• This` into view for.
    (let styles (list TypeId))
    (for (in position (..< 0 (. markup-styles length)))
      (+= styles ([] markup-styles (- (. markup-styles length) 1 position)))
    )
    (let scopes (list RuleScope))
    (let cells (list U32))
    (let valued (list U32))
    (let context (. ([] (. instances rows) instance) context))
    (let value-types (list TypeId))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
        (+= scopes ([] (. instances context-scopes) position))
        (+= cells ([] (. instances context-cells) position))
        (+= valued ([] (. instances context-valued) position))
      )
      (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
        (+= value-types ([] (. instances context-value-types) position))
      )
    )
    (let made (if-expr (!= context (. U32 max)) (. ([] (. instances contexts) context) made) no-type))
    (if (and (== made no-type) (call scoping-named (call (. program store-atom) "This")))
      (= made (. frame self-type))
    )
    (return
      (call (. instances intern-context)
        (block
          (arg styles)
          (arg markup-sheets)
          (arg sheet-levels)
          (arg scopes)
          (arg cells)
          (arg made)
          (arg 0)
          (arg valued)
          (arg value-types)
        )
      )
    )
  )
  (fn-expr _ use-cells U32
    (param use ScopeUse)
    ; How many state cells of the `when`s around a rule written in a rule seen are carried with it:
    ; none where it is under none, or under one not carried.
    (if-expr (>= (. use cell) (- (. U32 max) 1)) 0 (+ 1 (call (. facts link-count) (. use outer-cells))))
  )
  (fn-do _ content-values U32
    (param scope RuleScope)
    (param place U32)
    ; The values of the rule around a rule written in a rule that the function that builds content a
    ; style rule generates keeps, from the `place`th on among those its context names, made once, in
    ; the order kept; the markup element it is generated at gives them (`StyleContent`). `U32.max - 1`,
    ; values not here, where their types are not known.
    (let frame (call valued-frame (. scope frames)))
    (let count U32)
    (for (in index (..< 0 (. facts scope-values length)))
      (let held ([] (. facts scope-values) index))
      (if (and (== (. held instance) instance) (!= (. held kept) (. U32 max)))
        (if (== (. held argument) place)
          (return (as index U32))
        )
        (+= count 1)
      )
    )
    (if (== frame (. U32 max))
      (return (- (. U32 max) 1))
    )
    (let taken (call frame-types frame))
    (if (not taken)
      (return (- (. U32 max) 1))
    )
    (let first (as (. facts scope-value-types length) U32))
    (for (in type taken)
      (+= (. facts scope-value-types) type)
    )
    (+= (. facts scope-values)
      (call ScopeValues
        (block
          (arg instance)
          (arg 0)
          (arg module)
          (arg frame)
          (arg place)
          (arg count)
          (arg (. U32 max))
          (arg first)
          (arg (as (. taken length) U32))
        )
      )
    )
    (return (as (- (. facts scope-values length) 1) U32))
  )
  (fn-do + demand-outlet-states Bool
    ; The functions of the style runtime a slot outlet calls to hold state cells while what it mounts
    ; is built, and the one that reads them, typed once.
    (let runtime (. facts style-runtime))
    (if (!= (. runtime outlet-state) no-instance)
      (return true)
    )
    (let cell (call (. types well-known-type) "core/style" "StyleScopeState"))
    (if (== cell invalid-type)
      (return false)
    )
    (call (. types complete) cell)
    (let module-id (. (call class-ref types cell) module))
    (let mark (. scratch types mark))
    (= (. runtime outlet-mark)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-outlet-states-mark"))
          (arg mark)
        )
      )
    )
    (if (== (. runtime outlet-mark) no-instance)
      (return false)
    )
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) cell)
    (= (. runtime outlet-push)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-outlet-state-push"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) (. ([] (. instances signatures) (. runtime outlet-mark)) returns))
    (= (. runtime outlet-release)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-outlet-states-release"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) (call (. types type-row) .uint32))
    (= (. runtime outlet-state)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-outlet-state"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return
      (scope (and outlets-ready (!= (. runtime outlet-state) no-instance))
        (lazy outlets-ready (and (!= (. runtime outlet-push) no-instance) (!= (. runtime outlet-release) no-instance)))
      )
    )
  )
  (fn-do _ slot-scopes-for Bool
    (param element SyntaxId)
    (param class TypeId)
    (param scopes (list ScopeUse))
    ; The rules written in rules that the functions building what the lines of a markup element's
    ; body give the slots of its class see before those found on the way to each slot's outlet, as
    ; the reference's `slotOutletStyleContext` holds them: those the element sees, those its rules
    ; bring (`scopes-of`), and those of the rules `• This` of its class's chain, under state cells
    ; made at the element, but those that reach only the markup of its class's own
    ; (`scope-pending`). False where they are not known here.
    (if (or (not (call scoping-any)) (not (call scopes-known)) (not (call sheets-known)))
      (return false)
    )
    (for (in use rule-scopes)
      (+= scopes use)
    )
    (let (tuple start end) (call scopes-of element))
    (for (in position (..< start end))
      (if (!= (. ([] scoped-rows position) scope own) .scope-pending)
        (+= scopes ([] scoped-rows position))
      )
    )
    (call default-scopes class element scopes false)
    (return true)
  )
  (fn-do + slot-outlet (tuple TypeId SyntaxId)
    (param class TypeId)
    (param name Atom)
    ; The class of a chain whose markup declares the slot of a name, and its outlet there or the line
    ; that forwards it, as `level-slots` finds them; or no type.
    (let level (? TypeId) class)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (let content SyntaxId 0)
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class row)
          (= content (. row content))
        )
      )
      (if (!= content 0)
        (for (in node (..< (call (. owner tree subtree-start) content) content))
          (match? ([] (. owner tree nodes) node)
            (case (call .node-slot-outlet row)
              (let named (call (. program store-atom) ""))
              (if (!= (. row name) 0)
                (= named (?? (call (. owner tree identifier-name) (. row name)) named))
              )
              (if (and (== named name) (not (call (. owner tree inner-outlet) content node)))
                (return (tuple level node))
              )
            )
            (case (call .node-markup-slot-forward row)
              (if (== (call (. owner tree identifier-name) (. row slot-binding)) name)
                (return (tuple level node))
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return (tuple no-type 0u32))
  )
  (fn-do + outlet-scopes U32
    (param class TypeId)
    (param name Atom)
    (param content TypeId)
    (param applies Bool)
    (param base (list ScopeUse))
    (param sheets (list TypeId))
    (param levels (list U32))
    (param found (list ScopeUse))
    (param keeps-own Bool)
    ; The rules written in rules that the function building what a line gives a slot of a class, of
    ; type `content`, sees after those of the markup that gives it (`base`, seeing the style sheets
    ; `sheets` in their `levels`), found on the way to the slot's outlet, as the reference's
    ; `markupSlotOutletRuleScopes` finds them (`follow-outlet`), the state cell of the `when` around
    ; each one the cell that outlet holds of those made there (`discovering`); then, where it
    ; `applies` them, as `markupSlotScopeAdditions` does, those the rules the outlet applies bring
    ; (`outlet-applications`). None are found on the way to an outlet being followed already. Answers
    ; 0, 2 where one is declined, or 3 where the rules the outlet applies bring rules under the state
    ; cells of `when`s, which the function that builds the content brings itself
    ; (`root-applications`); `found` is given those found for 0, and those but these for 3. The way
    ; sees of `base` those that match in the markup of the class being filled (`scope-entered`) only
    ; where that markup `keeps-own`, as the class's chain does, as the reference's
    ; `markupSlotScopeAdditions` leaves them, and none found reaches only the markup of an element's
    ; class (`scope-pending`), which what a line gives a slot is not.
    (let (tuple owner outlet) (call slot-outlet class name))
    (if (== owner no-type)
      (return 0)
    )
    (let ref (call class-ref types owner))
    (let tag (/or/ (/lshift/ (as (. ref module) U64) 32) (as outlet U64)))
    (let followed (!= (call (. discoveries find) tag) null))
    (let written (. ([] (. program modules) (. ref module)) tree))
    (let markup SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class declared)
        (= markup (. declared content))
      )
    )
    (let root (call (. written root-this) markup))
    (let path (list SyntaxId))
    (let node (call (. written holder-of) outlet))
    (while (and (!= node 0) (!= node markup))
      (if (and (!= node root) (is ([] (. written nodes) node) .node-markup))
        (+= path node)
      )
      (= node (call (. written holder-of) node))
    )
    (let saved-scopes (list ScopeUse))
    (for (in use rule-scopes)
      (+= saved-scopes use)
    )
    (let saved-sheets (list TypeId))
    (for (in sheet markup-sheets)
      (+= saved-sheets sheet)
    )
    (let saved-levels (list U32))
    (for (in level sheet-levels)
      (+= saved-levels level)
    )
    (let own-keying keying)
    (call (. rule-scopes clear))
    (for (in use base)
      (if (or keeps-own (!= (. use scope own) .scope-entered))
        (+= rule-scopes use)
      )
    )
    (let based (. rule-scopes length))
    (call (. markup-sheets clear))
    (call (. sheet-levels clear))
    (for (in sheet sheets)
      (+= markup-sheets sheet)
    )
    (for (in level levels)
      (+= sheet-levels level)
    )
    (= keying (= (. keying sheet-self) owner))
    (= keying (= (. keying discovering) true))
    (let status 1u32)
    (if (not followed)
      (+= discoveries tag)
      (= status (call follow-outlet owner (. ref module) written root path outlet name))
      (call (. discoveries pop))
    )
    (if (== status 3)
      (= status 2)
    )
    (if (== status 1)
      (= status 0)
      (while (> (. rule-scopes length) based)
        (call (. rule-scopes pop))
      )
    )
    (if (and (== status 0) applies)
      (call (. markup-sheets clear))
      (call (. sheet-levels clear))
      (for (in sheet sheets)
        (+= markup-sheets sheet)
      )
      (for (in level levels)
        (+= sheet-levels level)
      )
      (= status (call outlet-applications class name content))
    )
    (if (or (== status 0) (== status 3))
      (for (in position (..< based (. rule-scopes length)))
        (if (!= (. ([] rule-scopes position) scope own) .scope-pending)
          (+= found ([] rule-scopes position))
        )
      )
    )
    (call (. rule-scopes clear))
    (for (in use saved-scopes)
      (+= rule-scopes use)
    )
    (call (. markup-sheets clear))
    (for (in sheet saved-sheets)
      (+= markup-sheets sheet)
    )
    (call (. sheet-levels clear))
    (for (in level saved-levels)
      (+= sheet-levels level)
    )
    (= keying own-keying)
    (return status)
  )
  (fn-do _ follow-outlet U32
    (param owner TypeId)
    (param home ModuleId)
    (param written AST)
    (param root SyntaxId)
    (param path (list SyntaxId))
    (param outlet SyntaxId)
    (param name Atom)
    ; Follows the way to a slot outlet of the markup written in the class `owner`, in `home`, through
    ; the markup elements `path` it is in, innermost first, bringing into view the rules written in
    ; rules seen on the way (`rule-scopes`), as `markupSlotOutletRuleScopes` does: where the class
    ; above writes markup, those of its root `<This` and those found on the way to the outlet of the
    ; slot the outermost element gives content, or the default one; else those of the class's root
    ; `<This` (`gather-root`). Then, for each element, outermost first, those its rules bring; where
    ; the next is content of a slot of the element's class, or the outlet forwards one of it, those of
    ; the rules `• This` of its chain, made at the element, and those found on the way to that slot's
    ; outlet in turn. Answers as `outlet-scopes` does.
    (let above (?? (call (. types base-of) owner) no-type))
    (let entered false)
    (if (and (!= above no-type) (call writes-content above))
      (let first (if-expr (!= (. path length) 0) ([] path (- (. path length) 1)) 0u32))
      (let slot (call (. program store-atom) ""))
      (let bound false)
      (match? ([] (. written nodes) first)
        (case (call .node-markup row)
          (if (and (!= (. row slot-binding) 0) (== (call (. written holder-of) first) owner-lines))
            (= bound true)
            (= slot (?? (call (. written identifier-name) (. row slot-binding)) slot))
          )
          (lazy owner-lines (call (. written content-lines) (call class-content owner)))
        )
      )
      (let names (list Atom))
      (let wanted (list TypeId))
      (let items (list TypeId))
      (if (not (call class-outlets above names wanted items))
        (return 2)
      )
      (let has (!= (call (. names find) slot) null))
      (if (and bound (not has))
        (return 1)
      )
      (if has
        (let base-written (. ([] (. program modules) (. (call class-ref types above) module)) tree))
        (let base-content (call class-content above))
        (if (!= (call gather-root above base-module base-written (call (. base-written root-this) base-content)) 0)
          (return 2)
        )
        (lazy base-module (. (call class-ref types above) module))
        (let seen (list ScopeUse))
        (for (in use rule-scopes)
          (+= seen use)
        )
        (let sheets (list TypeId))
        (for (in sheet markup-sheets)
          (+= sheets sheet)
        )
        (let levels (list U32))
        (for (in level sheet-levels)
          (+= levels level)
        )
        (let inner (list ScopeUse))
        (let status
          (call outlet-scopes
            (block
              (arg above)
              (arg slot)
              (arg ([] wanted (!! (call (. names find) slot))))
              (arg true)
              (arg seen)
              (arg sheets)
              (arg levels)
              (arg inner)
              (arg true)
            )
          )
        )
        (if (!= status 0)
          (return status)
        )
        (for (in use inner)
          (+= rule-scopes use)
        )
        (= entered true)
      )
    )
    (if (and (not entered) (!= (call gather-root owner home written root) 0))
      (return 2)
    )
    (let ref (call class-ref types owner))
    (let args (call (of RowRange TypeId)))
    (match? ([] (. types rows) owner)
      (case (call .type-class row)
        (= args (. row args))
      )
    )
    (let env (call (. types class-env-for) (. ref module) (. ref decl) args owner))
    (let status 0u32)
    (for (in index (..< 0 (. path length)))
      (let node ([] path (- (. path length) 1 index)))
      (let next (if-expr (< (+ index 1) (. path length)) ([] path (- (. path length) 2 index)) 0u32))
      (match? ([] (. written nodes) node)
        (case (call .node-markup row)
          (call (. types clear-fault))
          (let type (call (. types evaluate-type) home written (. row type-id) env))
          (call (. types clear-fault))
          (if (or (== type invalid-type) (== type no-type) (!= (call (. types intrinsic-of) type) .class))
            (= status 1)
            (break)
          )
          (let names (list Atom))
          (for (in text (call implicit-names type (. row type-id) (. row id) written))
            (+= names (call (. program store-atom) text))
          )
          (let gathered (list ScopeUse))
          (let own-keying keying)
          (= keying (call Keying (. keying discovering) (. keying sheet-self) home node))
          (let gathering
            (call gather-scopes
              (block
                (arg type)
                (arg names)
                (arg (. row style-rule-applications))
                (arg node)
                (arg type)
                (arg gathered)
                (arg written)
              )
            )
          )
          (= keying own-keying)
          (if (not gathering)
            (= status 2)
            (break)
          )
          (for (in use gathered)
            (+= rule-scopes use)
          )
          (call add-sheet-groups type markup-sheets sheet-levels)
          (let forwards
            (scope (and (is ([] (. written nodes) outlet) .node-markup-slot-forward) last-step)
              (lazy last-step (== index (- (. path length) 1)))
            )
          )
          (let bound SyntaxId 0)
          (match? ([] (. written nodes) next)
            (case (call .node-markup line)
              (if (and (!= (. line slot-binding) 0) (!= (. row body) 0) in-body)
                (= bound next)
              )
              (lazy in-body (== (call (. written holder-of) next) (. row body)))
            )
          )
          (let slot (call (. program store-atom) ""))
          (if forwards
            (= slot name)
            (else-if (!= bound 0)
              (match? ([] (. written nodes) bound)
                (case (call .node-markup line)
                  (= slot (?? (call (. written identifier-name) (. line slot-binding)) slot))
                )
              )
            )
          )
          (let slots (list Atom))
          (let wanted (list TypeId))
          (let items (list TypeId))
          (if (not (call class-outlets type slots wanted items))
            (= status 2)
            (break)
          )
          (let has (!= (call (. slots find) slot) null))
          (if (and (or (!= bound 0) forwards) (not has))
            (= status 1)
            (break)
          )
          (if (not has)
            (continue)
          )
          (let outer-keying keying)
          (= keying (call Keying (. keying discovering) (. keying sheet-self) home node))
          (call default-scopes type node rule-scopes false)
          (= keying outer-keying)
          (let seen (list ScopeUse))
          (for (in use rule-scopes)
            (+= seen use)
          )
          (let sheets (list TypeId))
          (for (in sheet markup-sheets)
            (+= sheets sheet)
          )
          (let levels (list U32))
          (for (in level sheet-levels)
            (+= levels level)
          )
          (let inner (list ScopeUse))
          (let held
            (call outlet-scopes
              (block
                (arg type)
                (arg slot)
                (arg ([] wanted (!! (call (. slots find) slot))))
                (arg (not forwards))
                (arg seen)
                (arg sheets)
                (arg levels)
                (arg inner)
                (arg false)
              )
            )
          )
          (if (!= held 0)
            (= status held)
            (break)
          )
          (for (in use inner)
            (+= rule-scopes use)
          )
        )
      )
    )
    (call (. types env-release) env)
    (return status)
  )
  (fn-do _ gather-root U32
    (param class TypeId)
    (param home ModuleId)
    (param written AST)
    (param root SyntaxId)
    ; Brings into view, on the way to a slot outlet, the rules written in rules that the rules a root
    ; `<This` of the markup a class writes matches bring, each not in view already, as the reference's
    ; `classContentRootStyleRuleScopes` gathers them, the state cell of each made where the root is.
    ; Answers 0, or 2 where one is declined.
    (match? ([] (. written nodes) root)
      (case (call .node-markup row)
        (let names (list Atom))
        (for (in text (call implicit-names class (. row type-id) 0 written))
          (+= names (call (. program store-atom) text))
        )
        (let gathered (list ScopeUse))
        (let own-keying keying)
        (= keying (call Keying (. keying discovering) (. keying sheet-self) home root))
        (let gathering
          (call gather-scopes
            (block
              (arg class)
              (arg names)
              (arg (. row style-rule-applications))
              (arg root)
              (arg class)
              (arg gathered)
              (arg written)
            )
          )
        )
        (= keying own-keying)
        (if (not gathering)
          (return 2)
        )
        (let added (list ScopeUse))
        (for (in use gathered)
          (let shown false)
          (for (in held rule-scopes)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (for (in held added)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (if (not shown)
            (+= added use)
          )
        )
        (for (in use added)
          (+= rule-scopes use)
        )
      )
    )
    (return 0)
  )
  (fn-do + class-content SyntaxId
    (param class TypeId)
    ; The section of markup a class writes, or none.
    (let ref (call class-ref types class))
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class declared)
        (return (. declared content))
      )
    )
    (return 0)
  )
  (fn-do _ content-cell U32
    (param scope RuleScope)
    (param kept U32)
    (param depth U32)
    ; The state cell the function that builds generated content keeps, its `kept`th, for a `when`
    ; around a rule written in a rule its context gives: the frame of the rule that is the `depth`th
    ; `when`'s from the innermost, which the markup element the content is generated at holds
    ; (`StyleContent`).
    (let frame (. scope frames))
    (let passed U32)
    (while (!= frame (. U32 max))
      (if (!= (. ([] (. instances frames) frame) gate) 0)
        (if (== passed depth)
          (break)
        )
        (+= passed 1)
      )
      (= frame (. ([] (. instances frames) frame) outer))
    )
    (let module (if-expr (!= frame (. U32 max)) (. ([] (. instances frames) frame) module) 0u32))
    (let branch (if-expr (!= frame (. U32 max)) (. ([] (. instances frames) frame) gate) 0u32))
    (+= (. facts scope-cells)
      (call ScopeCell
        (block
          (arg instance)
          (arg (. U32 max))
          (arg module)
          (arg branch)
          (arg no-type)
          (arg true)
          (arg (. U32 max))
          (arg (. U32 max))
          (arg kept)
        )
      )
    )
    (return (as (- (. facts scope-cells length) 1) U32))
  )
  (fn-do _ record-scopes _
    (param id SyntaxId)
    (param scopes (list ScopeUse))
    ; Keeps the rules written in rules that the style rules a markup element applies bring into view,
    ; for the markup its object makes and its body.
    (+= scoped-sites id)
    (+= scoped-starts (as (. scoped-rows length) U32))
    (for (in scope scopes)
      (+= scoped-rows scope)
    )
    (+= scoped-ends (as (. scoped-rows length) U32))
  )
  (fn-do _ push-scopes _
    (param id SyntaxId)
    ; Brings into view, for the constructor of a markup element's object, the rules written in rules
    ; that the style rules the element applies do, those that reach only the markup of its class's
    ; own (`scope-pending`) with them.
    (let (tuple start end) (call scopes-of id))
    (for (in position (..< start end))
      (+= rule-scopes ([] scoped-rows position))
    )
  )
  (fn-do _ push-body-scopes _
    (param id SyntaxId)
    ; Brings into view, for the markup in a markup element's body, the rules written in rules that the
    ; style rules the element applies do, but those that reach only the markup of its class's own
    ; (`scope-pending`), as the reference's `withoutPendingOwnStyleRuleScopes` leaves them out.
    (let (tuple start end) (call scopes-of id))
    (for (in position (..< start end))
      (if (!= (. ([] scoped-rows position) scope own) .scope-pending)
        (+= rule-scopes ([] scoped-rows position))
      )
    )
  )
  (fn-do + markup-layer U32
    ; The layer at which the elements of markup written here declare styles: content, 1, in the
    ; function that makes a class's content, as the reference sets it there, and inline, 5,
    ; anywhere else. A function that builds markup takes that of the markup around it
    ; (`layer-given`), as the reference's builders carry it. None in another function nested in one
    ; that makes content, which the reference gives the layer of the function it is made in only in
    ; some ways of making it.
    (if (!= layer-given 0)
      (return layer-given)
    )
    (if (. frame declaration is-content)
      (return 1)
    )
    (let outer (. ([] (. instances rows) instance) enclosing))
    (while (!= outer no-instance)
      (let row ([] (. instances rows) outer))
      (let written (call describe program (. row module) (. row decl)))
      (if (and written (. written is-content))
        (return (. U32 max))
      )
      (= outer (. row enclosing))
    )
    (return 5)
  )
  (fn-do + reads-element Bool
    (param receiver TypeId)
    (param tree AST)
    (param value SyntaxId)
    ; Whether a value reads by its name alone a property the markup of a class declares for an
    ; element, apart from in the functions written in it.
    (let floor (call (. tree subtree-start) value))
    (let node (+ value 1))
    (while (> node floor)
      (-= node 1)
      (match? ([] (. tree nodes) node)
        (case .node-function-syntax
          (= node (call (. tree subtree-start) node))
        )
        (case (call .node-identifier row)
          (let place (call property-named receiver (. row name)))
          (if (and place (call names-element types ([] (. types properties) place)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do + writes-content Bool
    (param type TypeId)
    ; Whether a class, or one above it, has a section of markup.
    (let level (? TypeId) type)
    (while level
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (match? ([] (. owner decls) (. class content-function))
            (case (call .decl-function fn)
              (if (and (. fn is-content) (!= (. fn syntax) 0))
                (return true)
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do + check-markup-trigger _
    (param receiver TypeId)
    (param syntax SyntaxId)
    (param rule ASTWheneverRule)
    ; A `whenever` rule on the markup an object is in, typed as the reference compiles it: the
    ; object must be a markup host, and so must the class the rule looks for, which, for an
    ; ancestor, must declare no `==`, since a new ancestor is compared with the last as one object,
    ; which an optional of the class holds.
    ; Children and descendants are looked for by the number of the class among the targets of
    ; descendant queries; a class numbered only as the rule is typed, as one a class with type
    ; parameters looks for is, has no shape here. Where the rule names its changes, a
    ; `MarkupChangeSet` of that class is made for it, whose lists take each object added or
    ; removed and which is emptied after each run. The rule registers with the markup runtime,
    ; finds parent hosts there, and runs its live action by a call; its body runs in that action.
    ; The reference's errors for these, and runtime functions that raise, have no shape here.
    (let ancestor (== (. rule kind text) "ancestor"))
    (let host
      (scope (if-expr (call is-markup-host receiver) markup-host no-type)
        (lazy markup-host (call derived-interface receiver (. types markup-host-decl)))
      )
    )
    (let target (call (. types evaluate-type) module tree (. rule target-type) (. frame env)))
    (if (or (== host no-type) (== target invalid-type) (not (call is-markup-host target)))
      (call decline syntax)
      (return)
    )
    (if ancestor
      (for (in token (list "==" "!="))
        (if (call (. calls has-operator) target (call (. program store-atom) token) target)
          (call decline syntax)
          (return)
        )
      )
    )
    (let found (if-expr ancestor (call (. types optional-of) target) no-type))
    (if (!= found no-type)
      (call (. types complete) found)
    )
    (let trigger
      (call MarkupTrigger
        (block
          (arg instance)
          (arg target)
          (arg 0)
          (arg found)
          (arg host)
          (arg no-type)
          (arg no-instance)
          (arg no-instance)
          (arg no-instance)
          (arg no-instance)
          (arg no-instance)
          (arg no-instance)
        )
      )
    )
    (if (not ancestor)
      (call note-class-targets receiver)
      (let found (call (. facts query-targets find) target))
      (if (not found)
        (call decline syntax)
        (return)
      )
      (= (. trigger target-id) (as (+ found 1) U32))
    )
    (call demand-live-runtime)
    (let markup (. types markup-host-decl module))
    (let mark (. scratch types mark))
    (for (in arg ([] (. tree children) (. rule args)))
      (let named SyntaxId 0)
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (match? ([] (. tree nodes) (. row pattern))
            (case .node-identifier
              (= named (. row pattern))
            )
            (case (call .node-type-capture capture)
              (= named (if-expr (== (. capture type) 0) (. capture id) 0))
            )
          )
        )
      )
      (let resolution (call (. bindings resolution-of) (. frame binding) named))
      (let name (only-if (call (. tree identifier-atom) named) (if (!= named 0))))
      (= (. trigger changes) (call (. types well-known-type-of) "core/markup" "MarkupChangeSet" target))
      (let added (only-if (call property-named (. trigger changes) (call (. program store-atom) "added")) (if (!= (. trigger changes) invalid-type))))
      (if (or (not name) (!= (. name text) "changes") (!= (. resolution kind) .resolve-slot) (not added))
        (call decline arg)
        (return)
      )
      (call (. frame assign) (. resolution slot) (. trigger changes))
      (= (. trigger made) (call (. calls demand-constructor) (. trigger changes) mark))
      (= (. trigger clear) (call (. calls demand-method) (. trigger changes) (call (. program store-atom) "clear")))
      (call (. scratch types push) target)
      (= (. trigger record)
        (call (. calls demand-runtime-call)
          (block
            (arg markup)
            (arg (. ([] (. types properties) added) type))
            (arg (call (. program store-atom) "+="))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
    )
    (if (!= (. rule kind text) "descendants")
      (call (. scratch types push) host)
      (= (. trigger parent)
        (call (. calls demand-runtime-call)
          (block
            (arg markup)
            (arg no-type)
            (arg (call (. program store-atom) "markup-query-parent-host"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
    )
    (let callback
      (call (. types well-known-type)
        (block
          (arg "core/markup")
          (arg (if-expr ancestor "MarkupAncestorQueryRefresher" "MarkupDescendantsQueryApplier"))
        )
      )
    )
    (call (. scratch types push) host)
    (if (not ancestor)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) callback)
    )
    (call (. scratch types push) callback)
    (= (. trigger register)
      (call (. calls demand-runtime-call)
        (block
          (arg markup)
          (arg no-type)
          (arg
            (call (. program store-atom)
              (block
                (arg (if-expr ancestor "register-markup-ancestor-query" "register-markup-descendants-query"))
              )
            )
          )
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. trigger schedule) (if-expr (. types call-atom) (call (. calls demand-method) (. types live-action-type) (. types call-atom)) no-instance))
    (for (in callee (list (. trigger made) (. trigger clear) (. trigger record) (. trigger parent) (. trigger register) (. trigger schedule)))
      (if (!= callee no-instance)
        (call demand-errors callee)
      )
    )
    (let orphaned (and (== (. trigger parent) no-instance) (!= (. rule kind text) "descendants")))
    (let missing (or orphaned (== (. trigger register) no-instance) (== (. trigger schedule) no-instance)))
    (let unmade
      (scope (and (!= (. trigger changes) no-type) (or set-missing (== (. trigger record) no-instance)))
        (lazy set-missing (or (== (. trigger made) no-instance) (== (. trigger clear) no-instance)))
      )
    )
    (if (or missing unmade (== callback invalid-type))
      (call decline syntax)
      (return)
    )
    (for (in callee (list (. trigger made) (. trigger clear) (. trigger record) (. trigger parent) (. trigger register) (. trigger schedule)))
      (if (and (!= callee no-instance) (!= (. ([] (. instances signatures) callee) errors count) 0))
        (call decline syntax)
        (return)
      )
    )
    (+= (. facts markup-triggers) trigger)
    (call check-statement (. rule body))
  )
  (fn-do + follows-content Bool
    (param member SyntaxId)
    (param owner DeclId)
    ; Whether a section written in a class follows the class's content: an earlier section, or a
    ; `• This` with lines that are not its own (`rule-part`), which the reference makes the content.
    ; The reference reports a second as it declares the class, used or not.
    (if (not (is ([] (. tree nodes) member) .node-content-block))
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) owner)
      (case (call .decl-class class)
        (match? ([] (. tree nodes) (. class syntax))
          (case (call .node-class-block row)
            (for (in written ([] (. tree children) (. row members)))
              (if (== written member)
                (return false)
              )
              (if (or (is ([] (. tree nodes) written) .node-content-block) (call (. tree holds-markup) written))
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + check-content _
    (param decl DeclId)
    (param class ClassDecl)
    ; A section of a type with markup written in it is the type's content, which only a class
    ; holds. A struct says that it holds none; in a type of any other kind the section is declined.
    ; A root `<This` is checked as the reference checks it.
    (if (== (. class content) 0)
      (return)
    )
    (if (!= (. class or-bases count) 0)
      (call decline (. class content))
      (return)
    )
    (if (!= (. class base) 0)
      (let env (call (. types class-env) module decl))
      (let base (call (. types evaluate-type) module tree (. class base) env))
      (call (. types env-release) env)
      (if (== base invalid-type)
        (return)
      )
      (let kind (call (. types intrinsic-of) base))
      (if (== kind .struct)
        (let message (call (. program store-atom) "Content is not supported on structs"))
        (call (. frame diagnose) (. class syntax) .stated message)
        (return)
      )
      (if (!= kind .class)
        (call decline (. class content))
        (return)
      )
    )
    (call check-root decl class)
  )
  (fn-do _ check-root _
    (param decl DeclId)
    (param class ClassDecl)
    ; The root `<This` of the markup written in a class names no object, takes no argument and fills no
    ; slot, and every other line of the markup is written in it, but state machines. Each of its lines
    ; that assigns gives a property the class has from a class above its first value: a property stored
    ; in the object, given one value. One the class declares itself with a value is given two; one it
    ; declares with none takes this one. A name that is no property is one of a style, where a style
    ; could answer it, which the constructor declares (`apply-root-rules`), and else is no name at all.
    ; The style rules it applies are applied by the constructor (`apply-root-rules`), and are declined
    ; where the program has no style runtime.
    (let root (call (. tree root-this) (. class content)))
    (match? ([] (. tree nodes) root)
      (case (call .node-markup row)
        (if (!= (. row id) 0)
          (call (. frame diagnose) (. row id) .stated (call (. program store-atom) "Root <This> cannot have an id"))
          (return)
        )
        (if (!= (. row slot-binding) 0)
          (call (. frame diagnose)
            (block
              (arg (. row slot-binding))
              (arg .stated)
              (arg (call (. program store-atom) "Root <This> cannot bind a slot"))
            )
          )
          (return)
        )
        (if (!= (. row args count) 0)
          (let message (call (. program store-atom) "Root <This> cannot pass constructor arguments"))
          (call (. frame diagnose) ([] (. tree children) (. row args start)) .stated message)
          (return)
        )
        (if (or (!= (. row slot-parameter) 0) (and (!= (. row style-rule-applications count) 0) no-style-module))
          (call decline root)
          (return)
        )
        (lazy no-style-module (not (call (. program module-by-name) "core/style")))
        (match? ([] (. tree nodes) (. class content))
          (case (call .node-content-block section)
            (match? ([] (. tree nodes) (. section body))
              (case (call .node-block block)
                (for (in statement ([] (. tree children) (. block body)))
                  (if (or (== statement root) (is ([] (. tree nodes) statement) .node-state-machine))
                    (continue)
                  )
                  (let message
                    (call (. program store-atom)
                      (block
                        (arg "Root <This> must wrap all class content")
                      )
                    )
                  )
                  (call (. frame diagnose) root .stated message)
                  (return)
                )
              )
            )
          )
        )
        (let mark (. scratch types mark))
        (let owner (call (. types class-pattern-with-args) module decl mark))
        (if (== owner invalid-type)
          (return)
        )
        (call (. types complete) owner)
        (let seen (list Atom))
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (let name (call style-name tree (. attribute lhs)))
                  (if (== (. attribute op) .bind-op)
                    (let message "A root <This> cannot bind with \"<->\", since its attributes give the object's own properties their first values; bind the property where the object is made")
                    (call (. frame diagnose) statement .stated (call (. program store-atom) message))
                    (return)
                  )
                  (if (or (not name) (!= (. attribute op) .eq-op))
                    (call decline statement)
                    (return)
                  )
                  (let place (call property-named owner name))
                  (if (not place)
                    (if (call (. program module-by-name) "core/style")
                      (continue)
                    )
                    (call (. frame diagnose)
                      (block
                        (arg (. attribute lhs))
                        (arg .stated)
                        (arg (call (. program store-atom) "Property not found"))
                      )
                    )
                    (return)
                  )
                  (if (!= (call (. seen find) name) null)
                    (let message
                      (call (. program store-atom)
                        (block
                          (arg "Duplicate root <This> property default")
                        )
                      )
                    )
                    (call (. frame diagnose) (. attribute lhs) .stated message)
                    (return)
                  )
                  (+= seen name)
                  (if (!= (. ([] (. types properties) place) storage-kind) .storage-eager)
                    (let message
                      (call (. program store-atom)
                        (block
                          (arg "Root <This> can only default eager properties")
                        )
                      )
                    )
                    (call (. frame diagnose) (. attribute lhs) .stated message)
                    (return)
                  )
                  (let own (call owner-property program module decl name))
                  (match? ([] (. ([] (. program modules) module) decls) own)
                    (case (call .decl-property property)
                      (if (and (!= own 0) (not (. property defaults-root)) (!= (. property value) 0))
                        (let message "Root <This> property default duplicates property declaration")
                        (call (. frame diagnose)
                          (block
                            (arg (. attribute lhs))
                            (arg .stated)
                            (arg (call (. program store-atom) message))
                          )
                        )
                        (return)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-expr + is-region-body Bool
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (== (. fn kind) .region-decl)
      )
      (default
        false
      )
    )
  )
  (fn-expr + awaits-element Bool
    (param slot SlotId)
    ; Whether a local an enclosing function declares is the name of a markup element it has not
    ; made yet. A closure made before then reads it when it runs (`read-later-element`).
    (case? (and outer (call (. frame is-captured) slot))
      (call (. outer awaits-element) slot)
    )
    (default
      (and (!= waited null) (!= ([] awaited waited) 0))
    )
    (where
      (lazy waited (call (. unbuilt find) slot))
    )
  )
  (fn-do _ starts-task Bool
    (param slot SlotId)
    (let enclosing outer)
    (if (or (not enclosing) (not (call (. frame is-captured) slot)))
      (return false)
    )
    (return (or (call (. enclosing starts-task) slot) (and (== (. frame declaration kind) .task-decl) (not (call (. enclosing frame is-captured) slot)))))
  )
  (fn-do _ foresee-element TypeId
    (param slot SlotId)
    (if (and outer (call (. frame is-captured) slot))
      (return (call (. outer foresee-element) slot))
    )
    (let known (call (. foreseen find) slot))
    (if (!= known null)
      (return ([] foreseen-types known))
    )
    (let waited (call (. unbuilt find) slot))
    (if (or (== waited null) (== ([] awaited waited) 0))
      (return no-type)
    )
    (match? ([] (. tree nodes) ([] awaited waited))
      (case (call .node-markup row)
        (call (. types clear-fault))
        (let class (call (. types evaluate-type) module tree (. row type-id) (. frame env)))
        (call (. types clear-fault))
        (if (!= class invalid-type)
          (+= foreseen slot)
          (+= foreseen-types class)
        )
        (return class)
      )
    )
    (return no-type)
  )
  (fn-do + assign-element _
    (param slot SlotId)
    (param made TypeId)
    (param element SyntaxId)
    (call (. frame assign) slot made)
    (let known (call (. foreseen find) slot))
    (if (or (== known null) (== made invalid-type) (== ([] foreseen-types known) made))
      (return)
    )
    (let name (. ([] (. bindings slots) slot) name))
    (let read (call type-source types ([] foreseen-types known)))
    (let message (str "Named markup element \"" (. name text) "\" is read in a closure made before its markup constructs it, as " read ", but its markup makes " (call type-source types made) "; write its type in full"))
    (call (. frame diagnose) element .stated (call (. program store-atom) message))
  )
  (fn-do + infer-markup-read Found
    (param id SyntaxId)
    (param row ASTMarkupReadExpression)
    ; A read of a markup link, `%parent`, `%first-child`, `%last-child`, `%previous-sibling` or
    ; `%next-sibling`, of an object or of `this` whose class is a markup host: the optional of the
    ; host the markup runtime links it to. Where the class is a tree host of a concrete class of
    ; children, a child read gives that class, and so do a parent and a sibling read where the
    ; subject is one; else a sibling read gives the subject's class, and any other the host. The
    ; link is the host's object taken as that class, unchecked, as the reference takes it. A read
    ; written after `?` reads from what the optional before it holds, as a read of a member does. A
    ; link given as an interface has no shape here.
    (let name (. row name text))
    (let reader (str "markup-structural-" name "-host"))
    (if (and (!= name "parent") (!= name "first-child") (!= name "last-child") no-sibling)
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Markup link \"%" name "\" not found")))
      (return (call Found invalid-type))
    )
    (lazy no-sibling (and (!= name "previous-sibling") (!= name "next-sibling")))
    (let subject no-type)
    (if (!= (. row object) 0)
      (if (!= (call (. this tree optional-chain-expr) (. row object)) 0)
        (call decline id)
        (return (call Found invalid-type))
      )
      (let object-found (call infer-found (. row object)))
      (let object (. object-found type))
      (let own (. object-found link))
      (if (== object invalid-type)
        (return (call Found invalid-type))
      )
      (let form (if-expr (. row is-optional) (call note-chain id id object) (. ChainForm chain-plain)))
      (if (or (== form .chain-absent) (call absent-after (. row object) object))
        (return (call Found (. types null-type)))
      )
      (let optional (== form .chain-tested))
      (= subject (call link-receiver (. row object) object own optional))
      (if optional
        (call (. facts unwrapped append) (call UnwrappedFact instance (. row object) subject))
      )
      (else
        (= subject (. frame self-type))
      )
    )
    (if (== subject no-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Markup link \"%" name "\" not found")))
      (return (call Found invalid-type))
    )
    (if (call (. types is-optional) subject)
      (call decline id)
      (return (call Found invalid-type))
    )
    (let host-decl (. types markup-host-decl))
    (let host
      (scope (if-expr hostable (call derived-interface subject host-decl) no-type)
        (lazy hostable (and (!= subject no-type) (or (!= (. host-decl module) 0) (!= (. host-decl decl) 0))))
      )
    )
    (if (== host no-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Markup link \"%" name "\" not found")))
      (return (call Found invalid-type))
    )
    (if (and (!= (call (. types intrinsic-of) subject) .class) (!= subject host))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let tree
      (scope (if-expr tree-host (call derived-interface subject (. types markup-tree-host-decl)) no-type)
        (lazy tree-host (or (!= (. types markup-tree-host-decl module) 0) (!= (. types markup-tree-host-decl decl) 0)))
      )
    )
    (let child (if-expr (!= tree no-type) (call first-arg tree) no-type))
    (let concrete (and (!= child no-type) (not (. ([] (. types completions) child) has-variables))))
    (let target no-type)
    (if (or (== name "first-child") (== name "last-child"))
      (= target (if-expr concrete child no-type))
      (else-if (and concrete (== (call derived-interface subject (call class-ref types child)) child))
        (= target child)
      )
      (else-if (or (== name "previous-sibling") (== name "next-sibling"))
        (= target (if-expr (not (. ([] (. types completions) subject) has-variables)) subject no-type))
      )
    )
    (if (== target host)
      (= target no-type)
    )
    (if (and (!= target no-type) (!= (call (. types intrinsic-of) target) .class))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) host)
    (let read (call (. calls demand-runtime-call) (. host-decl module) no-type (call (. program store-atom) reader) mark))
    (call (. scratch types rewind) mark)
    (if (== read no-instance)
      (call decline id)
      (return (call Found invalid-type))
    )
    (call (. conversions convert) id (if-expr (!= (. row object) 0) (. row object) id) subject host .reason-argument)
    (+= (. facts markup-reads) (call MarkupRead instance id read target))
    (let link (call (. types optional-of) (if-expr (!= target no-type) target host)))
    (return (call (. (call Found link) linking) link))
  )
  (fn-do + infer-markup TypeId
    (param id SyntaxId)
    (param row ASTMarkup)
    (param want Want (= (call Want)))
    ; A markup element: an object of its class, whose body runs with each of its lines as
    ; content of the object. A line that gives a value is taken by the element: by its `+=`, or
    ; else by its `++=`. An `if` and a `for` written as lines run their bodies as content of the
    ; same element; a `do` block runs as it would anywhere. The object of an element a block
    ; declares a name for was made before this line, where the block starts or where the statement
    ; that writes it runs, as the binder says (`raise-elements`, `raise-statement`), and the name
    ; holds it; one nothing made is the compiler's fault, reported here. Where the name is placed
    ; (`is-placed`), the object is made here and the name given it, which a
    ; function written in another may not do. An element written with a name no block declares,
    ; where the name is one something else declared, is that thing's value to the reference and
    ; makes no object: it is declined, but where that is the property the markup of the class
    ; declares for the element (`names-content-property`), whose object is made here and given to
    ; the property once the line has run. A name placed so that the function building a slot an
    ; element is given declares it in a function the slot is written in is given the object
    ; there, as the reference's builder writes the local it captures (`places-across`). What
    ; makes a placed element reads its name only in a function of its own: read anywhere else, the
    ; name is the reference's error. An
    ; element that binds a slot is made only by the function
    ; that builds the slot; written as a line anywhere else it is the reference's error. An
    ; element of a markup host runs under the batch of markup in force, as `batch-element` says.
    (if (and (!= (. row slot-binding) 0) (not (call builds-slot id)))
      (if (call (. want asks) .want-content-line)
        (call (. frame diagnose)
          (block
            (arg (. row slot-binding))
            (arg .stated)
            (arg (call (. program store-atom) "A slot is filled by a line of the element's body, or by a line of an arm of an if or match there"))
          )
        )
        (else
          (call decline id)
        )
      )
      (return invalid-type)
    )
    (let slot (call element-slot id (. row id)))
    (if (and (!= (. row id) 0) (not slot))
      (let resolution (call (. bindings resolution-of) (. frame binding) (. row id)))
      (let found (and (!= (. resolution kind) .resolve-unresolved) (!= (. resolution kind) .resolve-none)))
      (if (or (and found (not (call names-content-property id (. row id)))) received)
        (call decline id)
        (return invalid-type)
      )
      (lazy received (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-received)) 0))
    )
    (let placed (and slot (call (. bindings is-placed) slot)))
    (if (and placed (call (. frame is-captured) (!! slot)) (not (call places-across (!! slot))))
      (call decline id)
      (return invalid-type)
    )
    (let made (if-expr (and slot (not placed)) (call (. frame slot-type) slot) no-type))
    (if (and slot (not placed) (== made no-type))
      (let name (. ([] (. bindings slots) slot) name))
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "The compiler made no object for the markup element named \"" (. name text) "\" where the body that names it starts")))
      (return invalid-type)
    )
    (if placed
      (let first (. unbuilt length))
      (let around building)
      (+= unbuilt (!! slot))
      (+= awaited 0)
      (= building (!! slot))
      (= made (call make-element id row))
      (= building around)
      (while (> (. unbuilt length) first)
        (call (. unbuilt pop))
        (call (. awaited pop))
      )
      (else-if (not slot)
        (= made (call make-element id row))
      )
    )
    (if (or (== made invalid-type) (== made no-type))
      (return invalid-type)
    )
    (if placed
      (call assign-placed (!! slot) made)
    )
    (if (not (call keep-element id made))
      (call decline id)
      (return invalid-type)
    )
    (let rooted (call batch-element id row made (call (. want asks) .want-content-line)))
    (if (and (!= (. row body) 0) (not (call wraps-default (. row body))))
      (let styled (. markup-styles length))
      (if (and (call (. program module-by-name) "core/style") (not (call add-visible-styles made markup-styles id)))
        (return invalid-type)
      )
      (let sheeted (. markup-sheets length))
      (if (call (. program module-by-name) "core/style")
        (if (== (. markup-sheets length) 0)
          (call add-sheet-groups (. frame self-type) markup-sheets sheet-levels)
        )
        (call add-sheet-groups made markup-sheets sheet-levels)
      )
      (let scoped (. rule-scopes length))
      (call push-body-scopes id)
      (+= content-blocks (. row body))
      (+= content-parents made)
      (+= element-bodies (. row body))
      (+= batched rooted)
      (call check-statement (. row body))
      (call (. batched pop))
      (call (. content-blocks pop))
      (call (. content-parents pop))
      (call (. element-bodies pop))
      (while (> (. rule-scopes length) scoped)
        (call (. rule-scopes pop))
      )
      (while (> (. markup-styles length) styled)
        (call (. markup-styles pop))
      )
      (while (> (. markup-sheets length) sheeted)
        (call (. markup-sheets pop))
        (call (. sheet-levels pop))
      )
    )
    (return made)
  )
  (fn-do _ batch-element Bool
    (param id SyntaxId)
    (param row ASTMarkup)
    (param made TypeId)
    (param linked Bool)
    ; Whether a batch of markup is in force in the body of a markup element: the element itself
    ; where its class is a batch, else the one in force where the element is written. An element
    ; of a markup host under one whose body gives it content (`gives-default`) is put under the
    ; batch by the markup runtime's `ensure-markup-root` before its body runs, and one that is no
    ; line of another element is mounted as a root of the batch by `markup-mount-root` once it is
    ; made, as the reference does, but for one the function that builds a row of a markup loop
    ; region or what a line gives a slot makes, which the reference builds with both put off. An
    ; element that is a batch is converted to the `MarkupRootElement` what is made under it is put under.
    (let owns (call is-batch made))
    (let rooted (or owns (call in-batch)))
    (if (not rooted)
      (return false)
    )
    (let root (call ElementRoot instance id no-instance no-instance owns))
    (let batch (call batch-type))
    (if owns
      (call (. conversions convert) (. row type-id) (. row type-id) made batch .reason-markup-batch)
    )
    (let bodied (call gives-default (. row body)))
    (if (and (call is-markup-host made) (not (call defers-roots)) (or bodied (not linked)))
      (let markup (. types markup-host-decl module))
      (let host (call derived-interface made (. types markup-host-decl)))
      (let optional (call (. types optional-of) batch))
      (let mark (. scratch types mark))
      (call (. scratch types push) host)
      (call (. scratch types push) optional)
      (if bodied
        (= (. root ensure)
          (call (. calls demand-runtime-call)
            (block
              (arg markup)
              (arg no-type)
              (arg (call (. program store-atom) "ensure-markup-root"))
              (arg mark)
            )
          )
        )
      )
      (if (not linked)
        (= (. root mount)
          (call (. calls demand-runtime-call)
            (block
              (arg markup)
              (arg no-type)
              (arg (call (. program store-atom) "markup-mount-root"))
              (arg mark)
            )
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (or (and bodied (== (. root ensure) no-instance)) (and (not linked) (== (. root mount) no-instance)))
        (call decline id)
        (return rooted)
      )
      (call (. conversions convert) (. row type-id) (. row type-id) made host .reason-markup-host)
      (call (. conversions convert) (. row type-id) (. row type-id) batch optional .reason-markup-root)
    )
    (if (or owns (!= (. root ensure) no-instance) (!= (. root mount) no-instance))
      (+= (. facts element-roots) root)
    )
    (return rooted)
  )
  (fn-expr _ defers-roots Bool
    ; Whether the function being typed builds markup with its roots neither put under the batch in
    ; force nor mounted: one that builds a row of a markup loop region or what a line gives a slot,
    ; as the reference builds them.
    (or (== (. frame declaration kind) .row-decl) (== (. frame declaration kind) .slot-decl))
  )
  (fn-do + make-element TypeId
    (param id SyntaxId)
    (param row ASTMarkup)
    ; The object of a markup element, made by the constructor its arguments choose. An argument
    ; whose parameter has the name of a property of the class is stored in that property once
    ; the object is made, as the reference binds the two.
    ; An attribute whose value reads something tracked is given again by a function of its own.
    ; An attribute that names a property of a style the element sees is a style declaration
    ; (`declare-styles`), after the style rules the element applies (`apply-style-rules`). An
    ; element whose body gives slots content gives its constructor the functions that build them
    ; (`supply-slots`). The constructor of a class whose markup is its content is one of its own
    ; for the styles and style sheets the element sees (`element-context`). The rules written in
    ; rules that the element's style rules bring into view are gathered first, for the class
    ; written, as the reference prepares them (`gather-scopes`); an element whose object is of
    ; another class is declined then. One whose class takes its content through the markup protocol
    ; or builds content of its own is declined, and so is a body that tracks what it reads
    ; elsewhere. The local that keeps the object for the functions of its body that read its members
    ; holds the class written while the body is typed (`keep-element`).
    (if (not (call is-plain-body (. row body)))
      (call decline id)
      (return invalid-type)
    )
    (call (. types clear-fault))
    (let class (call (. types evaluate-type) module tree (. row type-id) (. frame env)))
    (if (== class invalid-type)
      (if (and (not (call report-circular)) (not (call report-fault (. row type-id))))
        (call (. frame diagnose) (. row type-id) .stated (call (. program store-atom) "Type not found"))
      )
      (return invalid-type)
    )
    (let reported (. facts diagnostics length))
    (let scoping (call may-scope class row))
    (if scoping
      (let names (list Atom))
      (for (in name (call implicit-names class (. row type-id) (. row id) tree))
        (+= names (call (. program store-atom) name))
      )
      (let gathered (list ScopeUse))
      (if (not (call gather-scopes class names (. row style-rule-applications) id class gathered tree))
        (call decline id)
        (return invalid-type)
      )
      (call record-scopes id gathered)
    )
    (let names-mark (. scratch names mark))
    (let builders-mark (. scratch types mark))
    (if (not (call supply-slots id (. row body) class))
      (call (. scratch names rewind) names-mark)
      (call (. scratch types rewind) builders-mark)
      (return invalid-type)
    )
    (let slots (call (. scratch names since) names-mark))
    (let builders (call (. scratch types since) builders-mark))
    (let context (call element-context class id))
    (if (== context (- (. U32 max) 1))
      (call (. scratch names rewind) names-mark)
      (call (. scratch types rewind) builders-mark)
      (return invalid-type)
    )
    (do
      (inline (call keep-element id class))
    )
    (let made (. (call infer-call id (. row type-id) (call (of RowRange SyntaxId)) (. row args) false (. row body) class (call Want) slots builders context) type))
    (call (. scratch names rewind) names-mark)
    (call (. scratch types rewind) builders-mark)
    (if (or (== made invalid-type) (== made no-type))
      (return invalid-type)
    )
    (if (not (call fills-constructor id row made))
      (return invalid-type)
    )
    (if (or (not accepts) (and (call (. tree has-attributes) (. row body)) (!= made class)) (and scoping (!= made class)))
      (call decline id)
      (return invalid-type)
    )
    (lazy accepts (or (call takes-lines made) (call takes-hosted made) (and (call holds-slot made) (call is-markup-host made))))
    (if (not (call check-cells id id made true))
      (return invalid-type)
    )
    (let outer-prepared preparing)
    (= preparing (= (. preparing site) id))
    (let applied (call apply-style-rules id made row))
    (= preparing outer-prepared)
    (if (or (== applied (. U32 max)) (not (call declare-styles id made (. row body) applied)))
      (return invalid-type)
    )
    (if (or (not (call store-attributes id made (. row args) (. row body))) (not (call store-arguments id made (. row args))))
      (if (== (. facts diagnostics length) reported)
        (call decline id)
      )
      (return invalid-type)
    )
    (call settle-attributes (. row body) made (. row type-id))
    (call settle-arguments id (. row args) made (. row type-id))
    (return made)
  )
  (fn-do _ fills-constructor Bool
    (param id SyntaxId)
    (param row ASTMarkup)
    (param made TypeId)
    (let fact (call (. facts latest-call) instance id))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return true)
    )
    (let callee ([] (. instances rows) (. ([] (. facts calls) fact) callee)))
    (match? ([] (. ([] (. program modules) (. callee module)) decls) (. callee decl))
      (case (call .decl-function fn)
        (if (!= (. fn kind) .default-constructor-decl)
          (return true)
        )
      )
    )
    (let given (list Atom))
    (match? (only-if ([] (. tree nodes) (. row body)) (if (!= (. row body) 0)))
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (let name (call (. tree identifier-name) (. attribute lhs)))
              (if name
                (+= given name)
              )
            )
          )
        )
      )
    )
    (let count 0)
    (let wanted (? Atom) null)
    (let ref (call class-ref types made))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class class)
        (if (!= (. class members count) 0)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-function fn)
                (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)))
                  (+= count 1)
                  (let fills true)
                  (for (in shape ([] (. owner arg-pool) (. fn args)))
                    (if (and (not (. shape has-default)) ungiven)
                      (= fills false)
                      (if (not wanted)
                        (= wanted (. shape name))
                      )
                    )
                    (lazy ungiven (or (not (. shape name)) (== (call (. given find) (. shape name)) null)))
                  )
                  (if fills
                    (return true)
                  )
                )
              )
            )
          )
        )
      )
    )
    (if (== count 0)
      (return true)
    )
    (let shown (call type-source types made))
    (let message (str "Markup element <" shown " gives none of the arguments the constructors of " shown " require"))
    (if (and (== count 1) wanted)
      (= message (str "Markup element <" shown " gives no value for \"" (. wanted text) "\", which the constructor of " shown " requires"))
    )
    (let named (only-if (call (. tree identifier-name) (. row id)) (if (!= (. row id) 0))))
    (if named
      (= message (str message "; \"" (. named text) "\" after <" shown " names the element"))
    )
    (call (. frame diagnose) (. row type-id) .stated (call (. program store-atom) message))
    (return false)
  )
  (fn-do _ settle-attributes _
    (param body SyntaxId)
    (param made TypeId)
    (param type-id SyntaxId)
    ; Types the function that gives again each attribute of a markup element whose value read
    ; something tracked, once the element's object is typed, as the reference makes it: the
    ; local no name reaches that keeps the object for it, declared at the attribute, holds one of
    ; the element's class, and the action is made as `owner-action` says, or for a style the
    ; attribute declares is the style runtime's `StyleDynamicAction` of the class. The local holds
    ; one also where the value read nothing tracked after all, as where a name the module builder
    ; took for one of a keyed row's is a member of an element around it, and nothing gives it again.
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (and (is ([] (. tree nodes) statement) .node-assign) (call is-live-statement statement))
            (let kept (call (. bindings resolution-of) (. frame binding) statement))
            (if (== (. kept kind) .resolve-slot)
              (call (. frame assign) (. kept slot) made)
            )
          )
          (let position (. facts live-statements length))
          (while (!= position 0)
            (-= position 1)
            (let live ([] (. facts live-statements) position))
            (if (or (!= (. live instance) instance) (!= (. live site) statement) (!= (. live rerun) no-instance))
              (continue)
            )
            (let resolution (call (. bindings resolution-of) (. frame binding) statement))
            (if (!= (. resolution kind) .resolve-slot)
              (call decline statement)
              (return)
            )
            (let styled (!= (call (. facts style-declaration-of) instance statement) null))
            (let owned (? InstanceId) null)
            (if styled
              (= owned (call demand-style-gates made))
              (else
                (= owned (call owner-action statement made type-id))
              )
            )
            (if (not owned)
              (return)
            )
            (call (. frame assign) (. resolution slot) made)
            (let rerun (call demand-lambda (call intern-nested (call nested-decl-of statement)) (. scratch no-types)))
            (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
              (call decline statement)
              (return)
            )
            (call (. instances mark-may-panic) instance)
            (= ([] (. facts live-statements) position)
              (call LiveStatement
                (block
                  (arg instance)
                  (arg statement)
                  (arg rerun)
                  (arg 0)
                  (arg (. U32 max))
                  (arg owned)
                  (arg (and (not styled) (!= owned no-instance) (call owns-batch made)))
                )
              )
            )
            (break)
          )
          (call settle-binding statement)
        )
      )
    )
  )
  (fn-do _ settle-binding _
    (param statement SyntaxId)
    (match? ([] (. tree nodes) statement)
      (case (call .node-assign row)
        (if (!= (. row op) .bind-op)
          (return)
        )
        (let given (call (. facts live-statement-of) instance statement))
        (if (or (not given) (== (. given rerun) no-instance))
          (return)
        )
        (let rerun (call demand-lambda (call intern-nested (call nested-decl-of (. row lhs))) (. scratch no-types)))
        (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
          (call decline statement)
          (return)
        )
        (+= (. facts live-statements) (call LiveStatement instance (. row lhs) rerun 0 (. U32 max) (. given owned) (. given rooted)))
      )
    )
  )
  (fn-do + settle-content _
    (param statement SyntaxId)
    (param parent TypeId)
    (param produced TypeId)
    ; Types the function that gives a line of a markup element's body again where its value read
    ; something tracked, once the element has taken it, as the reference makes it: an element of a
    ; markup host that absorbed the value by its `markup-absorb` absorbs it again, and one that took
    ; it another way replaces what it took (`replace-again`). The local no name reaches that keeps
    ; the element's object, declared at the line, holds one of the element's class, the one after it
    ; what the element took, and the action is made as `owner-action` says. A line of the body of an
    ; arm of a region is given so to what the arm's function is given, converted at the line.
    (let position (. facts live-statements length))
    (while (!= position 0)
      (-= position 1)
      (let live ([] (. facts live-statements) position))
      (if (or (!= (. live instance) instance) (!= (. live site) statement) (!= (. live rerun) no-instance))
        (continue)
      )
      (let link (call (. facts content-link-of) instance statement))
      (let kept (call line-keeper statement))
      (let absorbed
        (scope (and (!= link (. U32 max)) (call is-markup-host parent) unappended link-called)
          (lazy unappended (== (. ([] (. facts content-links) link) append) no-instance))
          (lazy link-called (!= (. ([] (. facts content-links) link) call) no-fact))
        )
      )
      (let replaced
        (scope (if-expr (or absorbed (== link (. U32 max))) no-type taken-type)
          (lazy taken-type (call content-taken ([] (. facts content-links) link) produced))
        )
      )
      (if (or (and (not absorbed) (== replaced no-type)) (== kept no-slot))
        (call decline statement)
        (return)
      )
      (let type-id SyntaxId statement)
      (match? ([] (. tree nodes) (call (. tree content-element) statement))
        (case (call .node-markup row)
          (= type-id (. row type-id))
        )
      )
      (let owned (call owner-action statement parent type-id))
      (if (not owned)
        (return)
      )
      (call (. frame assign) kept parent)
      (call (. frame assign) (+ kept 1) (if-expr absorbed (. types void-type) replaced))
      (let rerun (call demand-lambda (call intern-nested (call nested-decl-of statement)) (. scratch no-types)))
      (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
        (call decline statement)
        (return)
      )
      (call (. instances mark-may-panic) instance)
      (= ([] (. facts live-statements) position)
        (call LiveStatement
          (block
            (arg instance)
            (arg statement)
            (arg rerun)
            (arg 0)
            (arg (. U32 max))
            (arg owned)
            (arg (and (!= owned no-instance) (call owns-batch parent)))
          )
        )
      )
      (return)
    )
  )
  (fn-expr _ content-taken TypeId
    (param row ContentLink)
    (param produced TypeId)
    ; What a markup element took of a line of its body, which a function that gives the line again
    ; replaces: the node the markup runtime linked for a markup host, else what the element's
    ; method answered, or the value where it answers nothing, as the reference keeps it.
    (case? (== (. row call) no-fact)
      no-type
    )
    (case? (!= (. row append) no-instance)
      (call (. instances argument-type) (. row append) 1)
    )
    (default
      (if-expr (== answered (. types void-type)) produced answered)
    )
    (where
      (lazy answered (. ([] (. instances signatures) (. ([] (. facts calls) (. row call)) callee)) returns))
    )
  )
  (fn-do _ owner-action (? InstanceId)
    (param site SyntaxId)
    (param made TypeId)
    (param type-id SyntaxId)
    ; The function that makes the live action a markup element owns where an attribute or an
    ; argument of it read something tracked, as the reference makes it: where a batch is found
    ; for the element, as `owns-batch` says, the markup runtime's `make-markup-action`, given the
    ; batch; else none where the element's actions are plain ones, and for an element of a markup
    ; host `make-owner-markup-action`, given the element as the host, to which it is converted at
    ; its type once, however many of its attributes read something tracked. Either may raise. One
    ; that has no shape here is declined, which is answered with nothing.
    (let rooted (call owns-batch made))
    (if (and (call owns-plain-actions made) (not rooted))
      (return no-instance)
    )
    (let action (call action-maker site made rooted))
    (if (not action)
      (return null)
    )
    (if (and (not rooted) (not (call converts-at type-id .reason-markup-host)))
      (call (. conversions convert)
        (block
          (arg type-id)
          (arg type-id)
          (arg made)
          (arg (call derived-interface made (. types markup-host-decl)))
          (arg .reason-markup-host)
        )
      )
    )
    (return action)
  )
  (fn-do _ converts-at Bool
    (param site SyntaxId)
    (param reason ConversionReason)
    ; Whether a conversion for a reason is recorded at a node of the instance being typed.
    (let fact (call (. facts first-conversion) instance site))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts conversions) fact) reason) reason)
        (return true)
      )
      (= fact (. ([] (. facts conversions) fact) next))
    )
    (return false)
  )
  (fn-do _ settle-arguments _
    (param id SyntaxId)
    (param args (of RowRange SyntaxId))
    (param made TypeId)
    (param type-id SyntaxId)
    ; Types the function that gives again each argument of a markup element, given by position,
    ; whose value read something tracked, once the element's object is typed, as the reference
    ; makes it: the parameter the argument fills must name a property of the element's class,
    ; which is the reference's error otherwise, and the local no name reaches that keeps the
    ; object, declared at the element, holds one of the element's class. The action is made as
    ; `owner-action` says.
    (for (in arg ([] (. tree children) args))
      (let position (. facts live-statements length))
      (while (!= position 0)
        (-= position 1)
        (let live ([] (. facts live-statements) position))
        (if (or (!= (. live instance) instance) (!= (. live site) arg) (!= (. live rerun) no-instance))
          (continue)
        )
        (let name (call argument-name arg id instance))
        (let place (only-if (call property-named made name) (if name)))
        (if (not place)
          (call (. frame diagnose)
            (block
              (arg arg)
              (arg .stated)
              (arg (call (. program store-atom) "Tracked markup constructor argument must match a property"))
            )
          )
          (return)
        )
        (let resolution (call (. bindings resolution-of) (. frame binding) id))
        (if (!= (. resolution kind) .resolve-slot)
          (call decline arg)
          (return)
        )
        (let owned (call owner-action arg made type-id))
        (if (not owned)
          (return)
        )
        (call (. frame assign) (. resolution slot) made)
        (let rerun (call demand-lambda (call intern-nested (call nested-decl-of arg)) (. scratch no-types)))
        (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
          (call decline arg)
          (return)
        )
        (call (. instances mark-may-panic) instance)
        (= ([] (. facts live-statements) position)
          (call LiveStatement
            (block
              (arg instance)
              (arg arg)
              (arg rerun)
              (arg 0)
              (arg (as place U32))
              (arg owned)
              (arg (and (!= owned no-instance) (call owns-batch made)))
            )
          )
        )
        (break)
      )
    )
  )
  (fn-do + push-attributes Bool
    (param body SyntaxId)
    (param class TypeId)
    ; Types the attributes of a markup element in the order written and pushes each as an
    ; argument of its constructor's call: one named as the property, marked as a property, of
    ; the property's type, to which the value is converted as one assigned is. One that may name a
    ; style property is left to `declare-styles`, and one a setter answers is no argument
    ; (`setter-attribute`). False where an attribute has no shape or names no property, which is
    ; reported.
    (let given true)
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (let name (call style-name tree (. attribute lhs)))
              (if (call styles-attribute (. attribute op) class name)
                (continue)
              )
              (if (and name (call attribute-accessor class name))
                (if (not (call setter-attribute statement (. attribute op) (. attribute lhs) (. attribute rhs) class))
                  (= given false)
                )
                (continue)
              )
              (let type
                (call attribute-type
                  (block
                    (arg statement)
                    (arg (. attribute op))
                    (arg (. attribute lhs))
                    (arg (. attribute rhs))
                    (arg class)
                  )
                )
              )
              (if (== type invalid-type)
                (= given false)
                (else
                  (call (. scratch call-arguments push) (call CallArgument name false false true false))
                  (call (. scratch types push) type)
                  (call (. scratch syntax push) statement)
                )
              )
            )
          )
        )
      )
    )
    (return given)
  )
  (fn-do + setter-attribute Bool
    (param statement SyntaxId)
    (param op Operator)
    (param target SyntaxId)
    (param value SyntaxId)
    (param class TypeId)
    ; An attribute of a markup element that a setter answers, which the reference gives the object
    ; once it is made, as it updates any property the constructor does not fill: the value is typed
    ; by itself and the setter chosen for it as an assignment to the property chooses one, the
    ; reference's error where none answers. One of a setter private to another module, one written
    ; with an assigning operator, and one of a class with type variables are declined.
    (let name (call (. tree identifier-name) target))
    (let found (call attribute-accessor class (!! name)))
    (if (== op .bind-op)
      (let shown (call type-short-name types class))
      (let message (str "\"<->\" binds a property the element stores, and " shown " answers \"" (. (!! name) text) "\" with a getter or a setter, which a binding cannot follow; bind a property " shown " stores"))
      (call (. frame diagnose) target .stated (call (. program store-atom) message))
      (return false)
    )
    (if (or (!= op .eq-op) (not found) (. ([] (. types completions) class) has-variables) (call is-hidden ([] (. types properties) found) (!! name) .setter-decl))
      (call decline statement)
      (return false)
    )
    (let given (call stored-value value (call infer value)))
    (if (== given invalid-type)
      (return false)
    )
    (let diagnosed (. facts diagnostics length))
    (if (== (call (. calls setter-call) target target class (!! name) value given) invalid-type)
      (call (. facts restate)
        (block
          (arg diagnosed)
          (arg instance)
          (arg statement)
          (arg .function-not-found)
          (arg .stated)
          (arg (call (. program store-atom) "Setter not found"))
        )
      )
      (return false)
    )
    (return true)
  )
  (fn-do + attribute-accessor (? Index)
    (param class TypeId)
    (param name Atom)
    (let found (call property-named class name))
    (if found
      (return-if found (if (== (. ([] (. types properties) found) storage-kind) .storage-getter)))
      (return null)
    )
    (return (call interface-accessor class name))
  )
  (fn-do + attribute-not-found _
    (param target SyntaxId)
    (param name Atom)
    (let message (str "Property \"" (. name text) "\" not found; an assignment in an element's body sets the element's property. To assign a local, put it in a do row: \"do " (. name text) " = …\""))
    (call (. frame diagnose) target .stated (call (. program store-atom) message))
  )
  (fn-do + attribute-type TypeId
    (param statement SyntaxId)
    (param op Operator)
    (param target SyntaxId)
    (param value SyntaxId)
    (param class TypeId)
    ; The type an attribute of a markup element gives its constructor: that of the property it
    ; names, to which the value written is converted as a value assigned to the property is. A
    ; feed list written for a list takes the list's item type, as the reference contextualizes it.
    ; A name that is no property of the class, or one private to another module, is the
    ; reference's error where no style could answer it. An attribute a setter answers, one of an
    ; array and one written with an assigning operator are declined. An event written is wanted as
    ; the property's type, as `use-event` says.
    (let name (call (. tree identifier-name) target))
    (if (or (and (!= op .eq-op) (!= op .bind-op)) (not name) (!= (call (. types intrinsic-of) class) .class) generic)
      (call decline statement)
      (return invalid-type)
    )
    (lazy generic (. ([] (. types completions) class) has-variables))
    (let place (call property-named class name))
    (if (and (== op .bind-op) (or (not place) (call is-hidden ([] (. types properties) place) name .setter-decl)))
      (let message (str "\"<->\" binds a property of the element, and " (call type-short-name types class) " has no property \"" (. name text) "\""))
      (call (. frame diagnose) target .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (or (not place) (call is-hidden ([] (. types properties) place) name .setter-decl))
      (if (call (. program module-by-name) "core/style")
        (call decline statement)
        (else-if place
          (call (. frame diagnose) target .stated (call (. program store-atom) "Property not found"))
        )
        (else
          (call attribute-not-found target name)
        )
      )
      (return invalid-type)
    )
    (let property ([] (. types properties) place))
    (if (== (. property storage-kind) .storage-getter)
      (call decline statement)
      (return invalid-type)
    )
    (let declared (. property type))
    (if (== declared no-type)
      (= declared (call demand-member property class name))
    )
    (if (or (== declared no-type) (== declared invalid-type))
      (call decline statement)
      (return invalid-type)
    )
    (if (call is-array-value declared)
      (call decline statement)
      (return invalid-type)
    )
    (call expect-feeds value declared)
    (let written (call infer-with-expected value declared (call (. (call Want) escaping) declared value)))
    (if (or (== written invalid-type) (== written no-type))
      (return invalid-type)
    )
    (if (== (call (. conversions convert) statement value written declared .reason-assignment) invalid-type)
      (return invalid-type)
    )
    (return declared)
  )
  (fn-do _ store-attributes Bool
    (param id SyntaxId)
    (param made TypeId)
    (param args (of RowRange SyntaxId))
    (param body SyntaxId)
    ; Keeps, for each attribute of a markup element that names no parameter of its constructor,
    ; that the value is stored in the property again once the object is made, as the reference
    ; does, or given to the setter that answers it. An attribute that names a parameter an
    ; argument fills is the reference's error. One that names another parameter fills it, as an
    ; argument by name does, and is not stored again; one a setter answers that names a parameter
    ; is declined.
    (let fact (call (. facts latest-call) instance id))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return (not (call (. tree has-attributes) body)))
    )
    (let call ([] (. facts calls) fact))
    (let callee ([] (. instances rows) (. call callee)))
    (let owner ([] (. program modules) (. callee module)))
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (match? ([] (. owner decls) (. callee decl))
          (case (call .decl-function fn)
            (let given U32)
            (let setters U32)
            (for (in statement ([] (. tree children) (. row body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (let name (call (. tree identifier-name) (. attribute lhs)))
                  (let place (only-if (?? (call property-named made name) (call interface-accessor made name)) (if name)))
                  (if (and (not place) (call (. facts style-declaration-of) instance statement))
                    (continue)
                  )
                  (if (not place)
                    (return false)
                  )
                  (let parameter (call shape-index owner fn (!! name)))
                  (if (== (. ([] (. types properties) place) storage-kind) .storage-getter)
                    (if (!= parameter (. U32 max))
                      (call decline statement)
                      (return false)
                    )
                    (call (. facts note-element-store)
                      (block
                        (arg (call ElementStore instance id setters (. U32 max) 0 (. attribute lhs)))
                      )
                    )
                    (+= setters 1)
                    (continue)
                  )
                  (if (!= parameter (. U32 max))
                    (let fill
                      (scope (if-expr in-fills kept (. ArgumentFill fill-empty))
                        (lazy in-fills (< parameter (. call fills count)))
                        (lazy kept (as ([] (. facts call-fills) (+ (. call fills start) parameter)) U32))
                      )
                    )
                    (if (< fill (+ (. args count) given))
                      (let shown (str "Parameter \"" (. (!! name) text) "\" is given twice"))
                      (let text
                        (scope (if-expr (< fill (. args count)) from-header from-above)
                          (lazy from-header (str shown ", by the element's header and by this attribute; give it once"))
                          (lazy from-above (str shown ", by an attribute above and by this one; remove one"))
                        )
                      )
                      (call (. frame diagnose) statement .stated (call (. program store-atom) text))
                      (return false)
                    )
                    (if (!= fill (+ (. args count) given))
                      (return false)
                    )
                    (+= given 1)
                    (continue)
                  )
                  (if (== (call (. instances fill-argument) (. call callee) (!! name)) (. U32 max))
                    (return false)
                  )
                  (let written (call (. panics property-of) made (!! name)))
                  (if written
                    (call (. panics note-write) instance written)
                  )
                  (call (. facts note-element-store)
                    (block
                      (arg (call ElementStore instance id (+ (. args count) given) (as place U32) 0))
                    )
                  )
                  (+= given 1)
                )
              )
            )
            (return true)
          )
        )
      )
    )
    (return (not (call (. tree has-attributes) body)))
  )
  (fn-do + raise-elements _
    (param block SyntaxId)
    (param statements (of RowRange SyntaxId))
    ; Makes, where a block starts, the object of each markup element the block declares a name for
    ; that the binder makes there (`made-at-start`): one written as a line of a body that runs as
    ; content each time, or as a line of the body of such an element, in the order they are written,
    ; as the reference does before it runs any line of the block. What makes one object may read the
    ; name of an element the block has not made yet, which makes that one first (`raise-early`); its
    ; own is the reference's error. The others are made where the statement that writes them runs
    ; (`raise-statement`).
    (for (in statement ([] (. tree children) statements))
      (call raise-element block statement true)
    )
  )
  (fn-expr + awaits-unmade Bool
    (param first Int)
    ; Whether a markup element a block noted it would make, after the first `first` noted, is not
    ; made yet.
    (call some (:stream ([] unbuilt (..< first (. unbuilt length)))) (:where (!= each no-slot)))
  )
  (fn-do + await-elements Int
    (param statements (of RowRange SyntaxId))
    (param block SyntaxId (= 0))
    ; Notes, where a block starts, each markup element the block declares a name for and has not
    ; made, and gives how many were noted before them, for `settle-elements` where the block ends.
    ; The name is the block's where the binder declared it in the scope of the block (`owns-name`):
    ; the names of the elements written in a markup element's body are those of the block around
    ; the element.
    (let first (. unbuilt length))
    (for (in statement ([] (. tree children) statements))
      (call await-element statement block)
    )
    (return first)
  )
  (fn-do + settle-elements _
    (param first Int)
    ; Forgets the markup elements a block noted it would make, where the block ends.
    (while (> (. unbuilt length) first)
      (call (. unbuilt pop))
      (call (. awaited pop))
    )
  )
  (fn-do + await-element _
    (param element SyntaxId)
    (param block SyntaxId (= 0))
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (let slot (call element-slot element (. row id)))
        (if (and slot (not (call (. bindings is-placed) slot)) (call (. bindings owns-name) block slot))
          (+= unbuilt slot)
          (+= awaited element)
        )
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block body)
            (for (in statement ([] (. tree children) (. body body)))
              (call await-element statement block)
            )
          )
        )
      )
    )
  )
  (fn-do + raise-element _
    (param block SyntaxId)
    (param element SyntaxId)
    (param starts Bool (= false))
    ; Makes the object of a markup element that declares a name, then those of the lines of its
    ; body, under the styles and style sheets the class it names sees and the rules written in rules
    ; its style rules bring into view (`gather-scopes`), as the reference installs them before it
    ; evaluates the names a body declares. One a read made first is not made again. Where a block
    ; `starts`, only the elements the binder makes there are made.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (let slot (call element-slot element (. row id)))
        (if (and slot (not (call (. bindings is-placed) slot)) (!= (call (. unbuilt find) slot) null) (or (not starts) made-here))
          (let around building)
          (= building slot)
          (let made (call make-element element row))
          (= building around)
          (call assign-element slot made element)
          (let waited (call (. unbuilt find) slot))
          (if (!= waited null)
            (= ([] unbuilt waited) no-slot)
          )
          (call (. facts note-raised) instance block element)
        )
        (lazy made-here (call (. bindings made-at-start) slot))
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block body)
            (let styled (. markup-styles length))
            (let sheeted (. markup-sheets length))
            (if (call (. program module-by-name) "core/style")
              (call (. types clear-fault))
              (let written (call (. types evaluate-type) module tree (. row type-id) (. frame env)))
              (call (. types clear-fault))
              (if (and (!= written invalid-type) (== (call (. types intrinsic-of) written) .class))
                (do
                  (inline (call add-visible-styles written markup-styles element))
                )
                (if (== (. markup-sheets length) 0)
                  (call add-sheet-groups (. frame self-type) markup-sheets sheet-levels)
                )
                (call add-sheet-groups written markup-sheets sheet-levels)
                (let (tuple start end) (call scopes-of element))
                (if (and (== end start) (call may-scope written row))
                  (let names (list Atom))
                  (for (in name (call implicit-names written (. row type-id) (. row id) tree))
                    (+= names (call (. program store-atom) name))
                  )
                  (let gathered (list ScopeUse))
                  (if (not (call gather-scopes written names (. row style-rule-applications) element written gathered tree))
                    (call decline element)
                    (return)
                  )
                  (call record-scopes element gathered)
                )
              )
            )
            (let scoped (. rule-scopes length))
            (call push-body-scopes element)
            (for (in statement ([] (. tree children) (. body body)))
              (call raise-element block statement starts)
            )
            (while (> (. rule-scopes length) scoped)
              (call (. rule-scopes pop))
            )
            (while (> (. markup-styles length) styled)
              (call (. markup-styles pop))
            )
            (while (> (. markup-sheets length) sheeted)
              (call (. markup-sheets pop))
              (call (. sheet-levels pop))
            )
          )
        )
      )
    )
  )
  (fn-do + check-content _
    (param element SyntaxId)
    ; The function that builds what a line of a style rule generates where the rule is applied to a
    ; markup element, as the reference's `styleContentBuilderFunc` builds it: the element made with
    ; its content, as it would be anywhere, as a `MarkupElement`, under the styles, the style sheets and
    ; the rules written in rules its context holds, at the layer it holds, with no content generated
    ; by the rules the markup it makes applies (`generating`). A rule seen under the state cells of
    ; `when`s is seen under those it keeps (`content-cell`), and the values of the rule around one are
    ; kept (`content-values`), as the reference's closure captures its frames. It answers that type,
    ; and lets out what making the element raises. An element written with a name is declined.
    (call prepare)
    (let host (call (. types well-known-type) "core/markup" "MarkupElement"))
    (let held ([] (. instances contexts) (. ([] (. instances rows) instance) context)))
    (let named false)
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (= named (!= (. row id) 0))
      )
    )
    (if (or (== host invalid-type) named)
      (call decline element)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (call (. instances set-returns) instance host host .return-declared)
    (for (in position (..< 0 (. held styles)))
      (+= markup-styles ([] (. instances context-types) (- (+ (. held first) (. held styles)) 1 position)))
    )
    (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
      (+= markup-sheets ([] (. instances context-types) position))
      (+= sheet-levels ([] (. instances context-levels) position))
    )
    (= sheets-given true)
    (let kept U32)
    (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
      (let scope ([] (. instances context-scopes) position))
      (let place ([] (. instances context-valued) position))
      (let values (if-expr (== place (. U32 max)) (. U32 max) (call content-values scope place)))
      (let count ([] (. instances context-cells) position))
      (if (!= count 0)
        (let links (. U32 max))
        (for (in depth (..< 0 (- count 1)))
          (= links (call (. facts scope-link) (call content-cell scope (+ kept depth) (- count 1 depth)) links))
        )
        (+= rule-scopes (call ScopeUse scope (call content-cell scope (- (+ kept count) 1) 0) values links))
        (+= kept count)
        (else
          (+= rule-scopes (call ScopeUse scope (. U32 max) values))
        )
      )
    )
    (= scopes-given true)
    (= layer-given (. held layer))
    (+= batched false)
    (let made (call infer element))
    (call (. batched pop))
    (if (and (!= made invalid-type) (!= made no-type))
      (call (. conversions convert) element element made host .reason-return)
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ binds-property Bool
    (param statement SyntaxId)
    ; Whether a markup element gives a function of its own its name's object, as one whose body
    ; gives slots content does, and the name is a property of the class the markup is run on.
    (match? ([] (. tree nodes) statement)
      (case (call .node-markup row)
        (return (and (!= (. row id) 0) (!= (call nested-decl-of (. row id)) 0) (call names-property (. row id))))
      )
    )
    (return false)
  )
  (fn-do _ give-binder Bool
    (param element SyntaxId)
    (param name SyntaxId)
    (param class TypeId)
    ; Types the function that gives a markup element's name its object, where its body gives
    ; slots content, as the `MarkupIdBinder` the constructor is given after the functions that
    ; build the slots: before those, so that what they are given reads the name as the object.
    ; The name must be one the element is made in place for, or, where no block declares it, as
    ; under an `if` written as a line, a property the markup of the class declares for it.
    (let slot (call element-slot element name))
    (let decl (call nested-decl-of name))
    (let binds (call (. types well-known-type-of) "core/markup" "MarkupIdBinder" class))
    (let held (if-expr slot (call (. bindings is-placed) slot) (call names-content-property element name)))
    (if (or (not held) (== decl 0) (== binds invalid-type))
      (call decline element)
      (return false)
    )
    (let callee (call demand-nested decl class))
    (if (== callee no-instance)
      (call decline element)
      (return false)
    )
    (let closure (call intern-nested decl))
    (call (. facts set-node-type) instance name closure)
    (return (!= (call (. conversions convert) name name closure binds .reason-markup-slot) invalid-type))
  )
  (fn-do _ supply-slots Bool
    (param element SyntaxId)
    (param body SyntaxId)
    (param class TypeId)
    ; The slots of the markup written in a class that the lines of a markup element's body give
    ; content, each line an element that binds a slot by name, or the one line that is no attribute
    ; and binds none, which gives the default slot. Each is built by a function of its own, typed
    ; here for the type the slot's outlet declares, and made the `MarkupSlotBuilder` of that type
    ; the constructor is given, after its other arguments, in the order of the slots' names, the
    ; default one first, as the reference orders them. A name bound twice is the reference's error,
    ; as is one the class declares no slot of. Content the default slot is given in another shape,
    ; or which a class declaring none is given by a line the module builder took for it, is
    ; declined. What a slot is given is made under the styles the element's own body sees, as the
    ; reference makes it under the element's context. Slots of a class whose slots have no shape
    ; here (`class-outlets`) are declined, whose outlets are checked wherever an element of it is
    ; written, as the reference finds them there.
    ; An element written with a name gives its constructor last the function that gives the name
    ; the object (`give-binder`). The name of each slot is pushed on the names, and the type of its
    ; builder on the types. Answers false where the element is not made.
    (let lines (list SyntaxId))
    (if (call wraps-default body)
      (+= lines body)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (or (call binds-slot statement) (call (. tree holds-fills) statement))
            (+= lines statement)
          )
        )
      )
    )
    (let outlets (and (== (call (. types intrinsic-of) class) .class) (call holds-outlets class)))
    (if (and (== (. lines length) 0) (not outlets))
      (return true)
    )
    (if (or (!= (call (. types intrinsic-of) class) .class) (. ([] (. types completions) class) has-variables))
      (call decline element)
      (return false)
    )
    (let names (list Atom))
    (let wanted (list TypeId))
    (let items (list TypeId))
    (let reported (. facts diagnostics length))
    (if (not (call class-outlets class names wanted items))
      (if (== (. facts diagnostics length) reported)
        (call decline element)
      )
      (return false)
    )
    (let defaulted (!= (call (. names find) (call (. program store-atom) "")) null))
    (if (and defaulted (call gives-default body))
      (call decline element)
      (return false)
    )
    (if (== (. lines length) 0)
      (return true)
    )
    (let name SyntaxId 0)
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (= name (. row id))
      )
    )
    (let binder (if-expr (!= name 0) (call (. types well-known-type-of) "core/markup" "MarkupIdBinder" class) no-type))
    (if (and (!= name 0) (not (call give-binder element name class)))
      (return false)
    )
    (let styles (list TypeId))
    (if (call (. program module-by-name) "core/style")
      (for (in style markup-styles)
        (+= styles style)
      )
      (if (not (call add-visible-styles class styles element))
        (return false)
      )
    )
    (let sheets (list TypeId))
    (let levels (list U32))
    (call visible-sheets class sheets levels)
    (let given (list Atom))
    (let builders (list TypeId))
    (let scopes (list ScopeUse))
    (let scoped (call slot-scopes-for element class scopes))
    (if (not (call give-lines lines names wanted items styles sheets levels given builders class scopes scoped false))
      (return false)
    )
    (for (in offset (..< 0 (. given length)))
      (call (. scratch names push) ([] given offset))
      (call (. scratch types push) ([] builders offset))
    )
    (if (!= binder no-type)
      (call (. scratch names push) (call (. program store-atom) binder-slot))
      (call (. scratch types push) binder)
    )
    (return true)
  )
  (fn-do + give-choices Bool
    (param control SyntaxId)
    (param names (list Atom))
    (param wanted (list TypeId))
    (param items (list TypeId))
    (param styles (list TypeId))
    (param sheets (list TypeId))
    (param levels (list U32))
    (param given (list Atom))
    (param builders (list TypeId))
    (param class TypeId)
    (param scopes (list ScopeUse))
    (param scoped Bool)
    (param keeps-own Bool)
    (param seen (list Atom))
    (if keeps-own
      (call (. frame diagnose) control .stated (call (. program store-atom) "A subclass fills its base's slots with lines of its content, not inside an if or match"))
      (return false)
    )
    (let filled (list Atom))
    (let firsts (list SyntaxId))
    (for (in arm (call (. tree region-arms) control))
      (let fills (list SyntaxId))
      (match? ([] (. tree nodes) (call (. tree region-arm-body) arm))
        (case (call .node-block block)
          (for (in line ([] (. tree children) (. block body)))
            (if (call (. tree fills-slot) line)
              (+= fills line)
            )
          )
        )
      )
      (if (== (. fills length) 0)
        (continue)
      )
      (for (in line fills)
        (if (is ([] (. tree nodes) line) .node-markup-slot-forward)
          (call (. frame diagnose) line .stated (call (. program store-atom) "A slot is not passed on with <+ inside an if or match; write <+ as a line of the element's body"))
          (return false)
        )
      )
      (let pattern (call (. tree arm-pattern) arm))
      (let bound (list Atom))
      (if (!= pattern 0)
        (call (. tree pattern-names) pattern bound)
      )
      (if (and (!= pattern 0) (is ([] (. tree nodes) arm) .node-if-block))
        (call (. frame diagnose) pattern .stated (call (. program store-atom) "An if that fills a slot tests a condition, not a pattern; write is or == instead"))
        (return false)
      )
      (if (!= (. bound length) 0)
        (call (. frame diagnose) pattern .stated (call (. program store-atom) "A match arm that fills a slot binds no names; test the subject without binding, as |= value or a type alone does"))
        (return false)
      )
      (let arm-given (list Atom))
      (let arm-builders (list TypeId))
      (let arm-mark (. scratch narrowings mark))
      (let known (call (. frame save-members)))
      (call narrow-arm control arm)
      (let gave (call give-lines fills names wanted items styles sheets levels arm-given arm-builders class scopes scoped keeps-own))
      (call (. frame pop-narrowing) arm-mark)
      (call (. frame restore-members) known)
      (if (not gave)
        (return false)
      )
      (for (in line fills)
        (let name (call (. tree filled-name) line))
        (if (and name (== (call (. filled find) name) null))
          (+= filled name)
          (+= firsts line)
        )
      )
    )
    (let selector (call (. types well-known-type) "core/markup" "MarkupSlotSelector"))
    (let anchor (call (. tree selector-anchor) control))
    (let decl (if-expr (!= anchor 0) (call nested-decl-of anchor) 0u32))
    (if (or (== selector invalid-type) (== decl 0) (== (call demand-nested decl no-type) no-instance))
      (call decline control)
      (return false)
    )
    (let closure (call intern-nested decl))
    (if (== (call (. conversions convert) anchor anchor closure selector .reason-markup-slot) invalid-type)
      (return false)
    )
    (let index (. types index-type))
    (for (in offset (..< 0 (. filled length)))
      (let name ([] filled offset))
      (let first ([] firsts offset))
      (if (or (!= (call (. seen find) name) null) (!= (call (. given find) name) null))
        (call (. frame diagnose) first .stated (call (. program store-atom) "Duplicate slot content"))
        (return false)
      )
      (+= seen name)
      (let position (!! (call (. names find) name)))
      (if (!= ([] items position) no-type)
        (call (. frame diagnose) first .stated (call (. program store-atom) "A repeated slot cannot be filled inside an if or match"))
        (return false)
      )
      (let content ([] wanted position))
      (let choice (call (. types well-known-type-of) "core/markup" "MarkupSlotChoice" content))
      (let builder (call builder-type content no-type))
      (if (or (== choice invalid-type) (== builder invalid-type))
        (call decline first)
        (return false)
      )
      (let markup (. types markup-host-decl module))
      (let mark (. scratch types mark))
      (call (. scratch types push) content)
      (call (. scratch types push) selector)
      (call (. scratch types push) index)
      (let create (call (. calls demand-runtime-call) markup no-type (call (. program store-atom) "markup-slot-choice") mark 1))
      (call (. scratch types rewind) mark)
      (call (. scratch types push) content)
      (call (. scratch types push) choice)
      (call (. scratch types push) index)
      (call (. scratch types push) builder)
      (let fill (call (. calls demand-runtime-call) markup no-type (call (. program store-atom) "markup-slot-arm") mark 1))
      (call (. scratch types rewind) mark)
      (if (or (== create no-instance) (== fill no-instance))
        (call decline first)
        (return false)
      )
      (+= (. facts slot-choices) (call SlotChoice instance control first choice create fill closure))
      (call add-slot name choice given builders)
    )
    (return true)
  )
  (fn-do _ narrow-arm _
    (param control SyntaxId)
    (param arm SyntaxId)
    (for (in other (call (. tree region-arms) control))
      (match? ([] (. tree nodes) other)
        (case (call .node-if-block row)
          (call (. narrowing narrow-condition) (. row condition) (== other arm))
        )
      )
      (if (== other arm)
        (return)
      )
    )
  )
  (fn-do + forwards-choice Bool
    (param name Atom)
    (let filling (call filling-checker))
    (if (not filling)
      (return false)
    )
    (let argument (call (. instances slot-argument) (. filling instance) name))
    (return (and (!= argument (. U32 max)) (!= (call chosen-slot (call (. instances argument-type) (. filling instance) argument)) no-type)))
  )
  (fn-do + class-outlets Bool
    (param class TypeId)
    (param names (list Atom))
    (param wanted (list TypeId))
    (param items (list TypeId))
    ; The slots the markup written in a class declares by its outlets, each named, the default one
    ; by the empty text, with the type its outlet declares, and the type of the item it gives the
    ; function that builds it where the slot repeats, or no type: every outlet written in the
    ; markup but one in the body of another, which is content the other mounts where it is given
    ; none, those of the classes above it first, from the top. A name declared twice, in one class
    ; or two, and an outlet that repeats with no type for its item, are the reference's errors,
    ; reported where the class is written in this module and else declined. An outlet whose type
    ; names nothing is reported where the type is written, in whichever module that is, since the
    ; element fails before the class's own markup is checked. A slot its markup
    ; forwards is declared as `level-slots` says. The slots of a class are looked for with it, and
    ; then each class above it, marked as being looked for (`outlet-classes`), as the reference marks
    ; them (`recursing-class`). Slots of a class whose markup passes an outlet as an argument have
    ; no shape here: answers false.
    (+= outlet-classes class)
    (let base (call (. types base-of) class))
    (let complete (if-expr base (call class-outlets base names wanted items) true))
    (if complete
      (= complete (call level-slots class names wanted items))
    )
    (call (. outlet-classes pop))
    (return complete)
  )
  (fn-do _ recursing-class TypeId
    (param class TypeId)
    ; The first of a class and those above it whose slots are being looked for, from the class up,
    ; which the reference reports looking for again, or no type.
    (let level (? TypeId) class)
    (while level
      (if (!= (call (. outlet-classes find) level) null)
        (return level)
      )
      (= level (call (. types base-of) level))
    )
    (return no-type)
  )
  (fn-do _ level-slots Bool
    (param class TypeId)
    (param names (list Atom))
    (param wanted (list TypeId))
    (param items (list TypeId))
    ; The slots the markup written in one class declares, not counting those of the classes above
    ; it, added to those found so far, as `class-outlets` finds them. A line of an element's body
    ; that forwards a slot declares the slot of that name the element's class declares, where it
    ; declares one, as the reference takes it. Where that class's slots are being looked for, it
    ; is the reference's error, at the element, reported where the class is written in this module
    ; and else declined.
    (let ref (call class-ref types class))
    (let owner ([] (. program modules) (. ref module)))
    (let content SyntaxId 0)
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class row)
        (= content (. row content))
      )
    )
    (if (== content 0)
      (return true)
    )
    (let found (list SyntaxId))
    (for (in node (..< (call (. owner tree subtree-start) content) content))
      (match? ([] (. owner tree nodes) node)
        (case (call .node-slot-outlet row)
          (if (!= (call (. owner tree argument-element) node) 0)
            (return false)
          )
          (+= found node)
        )
        (case .node-markup-slot-forward
          (+= found node)
        )
      )
    )
    (let forwarded (list SyntaxId))
    (for (in node found)
      (match? ([] (. owner tree nodes) node)
        (case (call .node-markup-slot-forward row)
          (+= forwarded (. row outlet))
        )
      )
    )
    (let args (call (of RowRange TypeId)))
    (match? ([] (. types rows) class)
      (case (call .type-class row)
        (= args (. row args))
      )
    )
    (let env (call (. types class-env-for) (. ref module) (. ref decl) args class))
    (let complete true)
    (for (in outlet found)
      (let inner (!= (call (. forwarded find) outlet) null))
      (for (in other found)
        (match? ([] (. owner tree nodes) other)
          (case (call .node-slot-outlet row)
            (if (and (!= (. row body) 0) after-start (<= outlet (. row body)))
              (= inner true)
            )
            (lazy after-start (<= (call (. owner tree subtree-start) (. row body)) outlet))
          )
        )
      )
      (if inner
        (continue)
      )
      (match? ([] (. owner tree nodes) outlet)
        (case (call .node-markup-slot-forward row)
          (let name (call (. owner tree identifier-name) (. row slot-binding)))
          (let body (call (. owner tree holder-of) outlet))
          (let element (call (. owner tree holder-of) body))
          (if (not (is ([] (. owner tree nodes) element) .node-markup))
            (let control (call (. owner tree arm-control) body))
            (if (!= control 0)
              (= element (call (. owner tree holder-of) (call (. owner tree holder-of) control)))
            )
          )
          (let host no-type)
          (match? ([] (. owner tree nodes) element)
            (case (call .node-markup made)
              (= host (call (. types evaluate-type) (. ref module) (. owner tree) (. made type-id) env))
            )
          )
          (if (or (not name) (== host invalid-type))
            (= complete false)
            (break)
          )
          (if (or (== host no-type) (!= (call (. types intrinsic-of) host) .class))
            (continue)
          )
          (let recursing (call recursing-class host))
          (if (!= recursing no-type)
            (if (== (. ref module) module)
              (call (. frame diagnose) element .stated (call (. program store-atom) (str "Recursive markup slot signature discovery for " (call type-short-name types recursing))))
            )
            (= complete false)
            (break)
          )
          (let held (list Atom))
          (let contents (list TypeId))
          (let kept (list TypeId))
          (if (not (call class-outlets host held contents kept))
            (= complete false)
            (break)
          )
          (let position (call (. held find) name))
          (if (== position null)
            (continue)
          )
          (if (!= (call (. names find) name) null)
            (if (== (. ref module) module)
              (call (. frame diagnose)
                (block
                  (arg (. row slot-binding))
                  (arg .stated)
                  (arg (call (. program store-atom) "Duplicate slot outlet"))
                )
              )
            )
            (= complete false)
            (break)
          )
          (+= names name)
          (+= wanted ([] contents position))
          (+= items ([] kept position))
        )
        (case (call .node-slot-outlet row)
          (let name (call (. program store-atom) ""))
          (if (!= (. row name) 0)
            (= name (?? (call (. owner tree identifier-name) (. row name)) name))
          )
          (if (!= (call (. names find) name) null)
            (if (== (. ref module) module)
              (call (. frame diagnose) outlet .stated (call (. program store-atom) "Duplicate slot outlet"))
            )
            (= complete false)
            (break)
          )
          (call (. types clear-fault))
          (let type (call (. types evaluate-type) (. ref module) (. owner tree) (. row type-id) env))
          (if (== type invalid-type)
            (let message (?? (. types fault) (call (. program store-atom) "Type not found")))
            (call (. types clear-fault))
            (call (. facts record-diagnostic) instance (. ref module) (. row type-id) .stated message)
          )
          (if (or (== type invalid-type) (!= (call (. types intrinsic-of) type) .class))
            (= complete false)
            (break)
          )
          (let item no-type)
          (match? ([] (. owner tree nodes) (. row slot-parameter))
            (case (call .node-markup-slot-parameter parameter)
              (if (== (. parameter type-id) 0)
                (if (== (. ref module) module)
                  (call (. frame diagnose)
                    (block
                      (arg (. parameter name))
                      (arg .stated)
                      (arg
                        (call (. program store-atom)
                          (block
                            (arg "Repeated slot outlet requires a slot parameter type")
                          )
                        )
                      )
                    )
                  )
                )
                (= complete false)
                (break)
              )
              (= item (call (. types evaluate-type) (. ref module) (. owner tree) (. parameter type-id) env))
              (if (== item invalid-type)
                (= complete false)
                (break)
              )
            )
          )
          (+= names name)
          (+= wanted type)
          (+= items item)
        )
      )
    )
    (call (. types env-release) env)
    (return complete)
  )
  (fn-do + holds-outlets Bool
    (param class TypeId)
    ; Whether the markup a class writes, or that of a class above it, holds a slot outlet or
    ; forwards a slot.
    (let level (? TypeId) class)
    (while level
      (if (call writes-outlets level)
        (return true)
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do _ writes-outlets Bool
    (param class TypeId)
    ; Whether the markup a class writes, not counting that of the classes above it, holds a slot
    ; outlet or forwards a slot.
    (let ref (call class-ref types class))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class row)
        (if (!= (. row content) 0)
          (for (in node (..< (call (. owner tree subtree-start) (. row content)) (. row content)))
            (if (or (is ([] (. owner tree nodes) node) .node-slot-outlet) slot-forward)
              (return true)
            )
            (lazy slot-forward (is ([] (. owner tree nodes) node) .node-markup-slot-forward))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + infer-outlet TypeId
    (param id SyntaxId)
    (param row ASTSlotOutlet)
    ; A slot outlet of the markup written in a class, in the function that fills an object of it,
    ; or in a function written in that one, which reaches what the filling function was given
    ; through the local that holds it (`builder-slot`). Its node is of the type it declares: the one
    ; the function that builds the slot gives, which the filling function was given for the slot
    ; by the constructor; or else, where it was given none, the one the element its body writes
    ; makes, cast to that type, made where the outlet is and the line of no element. Nothing is
    ; mounted where it has neither. Where the slot repeats, the function that builds it is given
    ; the item the outlet names, as the type it declares for it. The local its name declares holds
    ; the node. Content of several lines, or one `if`, `match` or loop of content, is built into a
    ; node of the slot's type made with no arguments (`wrap`), as the reference builds it. Then each
    ; line of its body that assigns gives the node a property as an attribute gives an element's
    ; object one, and one whose value read something tracked is given again by a function of its
    ; own, owned by the node. The style rules the outlet applies after `•`, then the lines of its
    ; body that declare styles, declare them for the node at a site of the outlet's own, as the
    ; reference's `compileSlotOverlay` does, seeing the style sheets of the markup but none of the
    ; node's class (`overlaying`). An outlet anywhere but the markup of a class, one whose item is
    ; read again where the row it is in is bound to another, body content of one line that is no
    ; element, and content built into a node under a batch where roots are not put off, which the
    ; reference puts under the batch, are declined. A type that names nothing is reported where it
    ; is written, as an element's is. Where it is given a builder, the locals its
    ; content declares are built nowhere here (`leave-unbuilt`), nor, where it mounts nothing, those
    ; its attributes declare. One that is a markup branch region
    ; (`outlet-region`) is built by the function of its one arm, which reads the item plainly and
    ; gives its name nothing; one of those given no builder is declined.
    (let filling (call filling-checker))
    (if (not filling)
      (call decline id)
      (return invalid-type)
    )
    (call (. types clear-fault))
    (let content (call (. types evaluate-type) module tree (. row type-id) (. filling frame env)))
    (if (== content invalid-type)
      (if (and (not (call report-circular)) (not (call report-fault (. row type-id))))
        (call (. frame diagnose) (. row type-id) .stated (call (. program store-atom) "Type not found"))
      )
      (return invalid-type)
    )
    (if (!= (call (. types intrinsic-of) content) .class)
      (call decline id)
      (return invalid-type)
    )
    (let name (call (. program store-atom) ""))
    (if (!= (. row name) 0)
      (= name (?? (call (. tree identifier-name) (. row name)) name))
    )
    (let item no-type)
    (let given SyntaxId 0)
    (match? ([] (. tree nodes) (. row slot-parameter))
      (case (call .node-markup-slot-parameter parameter)
        (if (!= (. parameter type-id) 0)
          (= item (call (. types evaluate-type) module tree (. parameter type-id) (. filling frame env)))
        )
        (= given (. parameter name))
        (if (or (== item invalid-type) (== item no-type))
          (call decline id)
          (return invalid-type)
        )
      )
    )
    (let lines (list SyntaxId))
    (match? ([] (. tree nodes) (. row body))
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (not (is ([] (. tree nodes) statement) .node-assign))
            (+= lines statement)
          )
        )
      )
    )
    (let argument (call (. instances slot-argument) (. filling instance) name))
    (let rebuilt (and (== (. frame declaration kind) .branch-arm-decl) (== (. frame declaration syntax) id)))
    (if (and rebuilt (== argument (. U32 max)) (not (call (. tree builds-outlet-alone) id)))
      (call decline id)
      (return invalid-type)
    )
    (let held no-slot)
    (let fallback SyntaxId 0)
    (let picks no-type)
    (let supplied (!= argument (. U32 max)))
    (if supplied
      (let builder (call (. instances argument-type) (. filling instance) argument))
      (let chosen (call chosen-slot builder))
      (if (!= chosen no-type)
        (if (or (. frame declaration is-content) (!= given 0))
          (call decline id)
          (return invalid-type)
        )
        (= picks (call (. types well-known-type-of) "core/markup" "MarkupSlotBuilder" chosen))
        (= builder picks)
      )
      (if (not (. frame declaration is-content))
        (= held (call builder-slot name))
        (if (== held no-slot)
          (call decline id)
          (return invalid-type)
        )
        (= argument (. U32 max))
      )
      (if (!= given 0)
        (let value (call infer given))
        (if (== value invalid-type)
          (return invalid-type)
        )
        (if (and (not rebuilt) (or (== (call (. facts plan-of) instance given) .plan-row-item) (call reads-getter given)))
          (call decline id)
          (return invalid-type)
        )
        (if (== (call (. conversions convert) given given value item .reason-argument) invalid-type)
          (return invalid-type)
        )
      )
      (let produced (call (. calls builder-call) id builder (if-expr (== given 0) 0 1)))
      (if (== produced invalid-type)
        (return invalid-type)
      )
      (if (!= produced content)
        (call decline id)
        (return invalid-type)
      )
      (if (not (call hold-cells id rule-scopes))
        (return invalid-type)
      )
      (if (and (!= (. row body) 0) (== picks no-type))
        (call leave-unbuilt (. row body))
      )
    )
    (if (and supplied (== picks no-type))
      (= fallback 0)
      (else-if (== (. lines length) 0)
        (if (== picks no-type)
          (+= (. facts slot-outlets) (call SlotOutlet instance id (. U32 max) 0 content))
          (if (!= (. row body) 0)
            (call leave-unbuilt (. row body))
          )
          (return no-type)
        )
      )
      (else-if (or (> (. lines length) 1) (call (. tree is-control-line) ([] lines 0)))
        (= fallback (. row body))
        (if (and (call in-batch) (not (call defers-roots)))
          (call decline id)
          (return invalid-type)
        )
        (let made (call wrap fallback content))
        (if (== made invalid-type)
          (return invalid-type)
        )
        (if (== (call (. conversions convert) fallback fallback made content .reason-assignment) invalid-type)
          (return invalid-type)
        )
      )
      (else
        (= fallback ([] lines 0))
        (match ([] (. tree nodes) fallback)
          (case (call .node-markup element)
            (if (!= (. element slot-binding) 0)
              (call decline fallback)
              (return invalid-type)
            )
          )
          (default
            (call decline fallback)
            (return invalid-type)
          )
        )
        (let made (call infer fallback))
        (if (or (== made invalid-type) (== made no-type))
          (return invalid-type)
        )
        (if (== (call (. conversions convert) fallback fallback made content .reason-assignment) invalid-type)
          (return invalid-type)
        )
      )
    )
    (+= (. facts slot-outlets) (call SlotOutlet instance id argument fallback content held given no-instance picks))
    (let named (only-if (call declaring-slot (. row name)) (if (and (!= (. row name) 0) (not rebuilt)))))
    (if (and named (== (. ([] (. bindings slots) named) group) id))
      (call (. frame assign) named content)
    )
    (let outer-overlay preparing)
    (= preparing (= (. preparing overlaying) true))
    (= preparing (= (. preparing site) 0))
    (call (. element-scopes clear))
    (= empty-shared false)
    (let applied (call apply-written-rules id content (. row style-rule-applications) 0))
    (call (. element-scopes clear))
    (let declared (and (!= applied (. U32 max)) (call declare-styles id content (. row body) applied)))
    (= preparing outer-overlay)
    (if (not declared)
      (return invalid-type)
    )
    (match? ([] (. tree nodes) (. row body))
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (if (== (. attribute op) .bind-op)
                (call misplaced-binding statement)
                (return invalid-type)
              )
              (if (call styles-attribute (. attribute op) content (call style-name tree (. attribute lhs)))
                (continue)
              )
              (if (== (call attribute-type statement (. attribute op) (. attribute lhs) (. attribute rhs) content) invalid-type)
                (return invalid-type)
              )
            )
          )
        )
      )
    )
    (call settle-attributes (. row body) content (. row type-id))
    (return content)
  )
  (fn-do _ outlet-name Atom
    (param row ASTSlotOutlet)
    (let name (call (. program store-atom) ""))
    (if (!= (. row name) 0)
      (= name (?? (call (. tree identifier-name) (. row name)) name))
    )
    (return name)
  )
  (fn-do + outlet-choice TypeId
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-slot-outlet row)
        (return-if no-type (if (!= (. row slot-parameter) 0)))
        (let filling (call filling-checker))
        (return-if no-type (if (not filling)))
        (let argument (call (. instances slot-argument) (. filling instance) (call outlet-name row)))
        (return-if no-type (if (== argument (. U32 max))))
        (return (call chosen-slot (call (. instances argument-type) (. filling instance) argument)))
      )
    )
    (return no-type)
  )
  (fn-do + check-chosen-outlet TypeId
    (param id SyntaxId)
    (param parent TypeId)
    (param slot TypeId)
    (match? ([] (. tree nodes) id)
      (case (call .node-slot-outlet row)
        (return (call check-chosen-region id row parent slot))
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ check-chosen-region TypeId
    (param id SyntaxId)
    (param row ASTSlotOutlet)
    (param parent TypeId)
    (param slot TypeId)
    (let tree-host (call derived-interface parent (. types markup-tree-host-decl)))
    (let content (if-expr (!= tree-host no-type) (call first-arg tree-host) no-type))
    (let filling (call filling-checker))
    (if (or (== content no-type) (== content invalid-type) (not filling) (call in-batch))
      (call decline id)
      (return invalid-type)
    )
    (if (not (call makes-region parent))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (lazy message (str "Markup branch host " (call type-source types parent) " must declare markup-make-region, or extend MarkupNode"))
      (return invalid-type)
    )
    (let name (call outlet-name row))
    (let argument (call (. instances slot-argument) (. filling instance) name))
    (let choice (call (. instances argument-type) (. filling instance) argument))
    (let held no-slot)
    (if (not (. frame declaration is-content))
      (= held (call builder-slot name))
      (if (== held no-slot)
        (call decline id)
        (return invalid-type)
      )
      (= argument (. U32 max))
    )
    (let alone (call (. tree builds-outlet-alone) id))
    (let builder (call (. types well-known-type-of) "core/markup" "MarkupBranchBuilder" content))
    (let arm (if-expr (and alone (!= builder invalid-type)) (call check-chosen-arm id row content builder) no-type))
    (if (and alone (or (== arm no-type) (== arm invalid-type)))
      (call decline id)
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) slot)
    (call (. scratch types push) content)
    (call (. scratch types push) parent)
    (call (. scratch types push) parent)
    (call (. scratch types push) choice)
    (if alone
      (call (. scratch types push) builder)
      (call (. scratch types push) (. types bool-type))
    )
    (let call
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) (if-expr alone "markup-chosen-arm" "markup-chosen-slot")))
          (arg mark)
          (arg 3)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== call no-instance) (not (call raises-out id call)))
      (call decline id)
      (return invalid-type)
    )
    (let fallback (if-expr (and alone (call (. tree falls-back) row)) (. row body) 0))
    (+= (. facts slot-outlets) (call SlotOutlet instance id argument fallback slot held 0 call no-type arm))
    (let made (. ([] (. instances signatures) call) returns))
    (call (. facts set-node-type) instance id made)
    (return made)
  )
  (fn-do _ check-chosen-arm TypeId
    (param id SyntaxId)
    (param row ASTSlotOutlet)
    (param content TypeId)
    (param builder TypeId)
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (let decl (call nested-decl-of id))
    (if (or (!= (. resolution kind) .resolve-slot) (== decl 0) (!= (. ([] (. bindings slots) (- (. resolution slot) 1)) syntax) id))
      (return no-type)
    )
    (call (. frame assign) (- (. resolution slot) 1) (. types void-type))
    (let named (only-if (call declaring-slot (. row name)) (if (!= (. row name) 0))))
    (if (and named (== (. ([] (. bindings slots) named) group) id))
      (let filling (call filling-checker))
      (if filling
        (let made (call (. types evaluate-type) module tree (. row type-id) (. filling frame env)))
        (if (!= made invalid-type)
          (call (. frame assign) named made)
        )
      )
    )
    (let outer-batch region)
    (= region (= (. region batch) false))
    (= region (= (. region root) (- (. resolution slot) 1)))
    (let demanded (call demand-nested decl content))
    (= region outer-batch)
    (if (== demanded no-instance)
      (return no-type)
    )
    (let closure (call intern-nested decl))
    (if (== (call (. conversions convert) id id closure builder .reason-markup-arm) invalid-type)
      (return invalid-type)
    )
    (return closure)
  )
  (fn-do + check-outlet-arm TypeId
    (param id SyntaxId)
    (param parent TypeId)
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (let decl (call nested-decl-of id))
    (if (or (!= (. resolution kind) .resolve-slot) (== decl 0) (!= (. ([] (. bindings slots) batch) syntax) id))
      (call decline id)
      (return invalid-type)
    )
    (lazy batch (- (. resolution slot) 1))
    (let rooted (call in-batch))
    (call (. frame assign) batch (if-expr rooted (call batch-type) (. types void-type)))
    (match? ([] (. tree nodes) id)
      (case (call .node-slot-outlet row)
        (let named (only-if (call declaring-slot (. row name)) (if (!= (. row name) 0))))
        (let filling (call filling-checker))
        (if (and named filling (== (. ([] (. bindings slots) named) group) id))
          (let content (call (. types evaluate-type) module tree (. row type-id) (. filling frame env)))
          (if (!= content invalid-type)
            (call (. frame assign) named content)
          )
        )
      )
    )
    (let outer-batch region)
    (= region (= (. region batch) rooted))
    (= region (= (. region root) batch))
    (let made (call demand-nested decl parent))
    (= region outer-batch)
    (if (== made no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let closure (call intern-nested decl))
    (call (. facts set-node-type) instance id closure)
    (let builder (call (. types well-known-type-of) "core/markup" "MarkupBranchBuilder" parent))
    (if (== builder invalid-type)
      (call decline id)
      (return invalid-type)
    )
    (if (== (call (. conversions convert) id id closure builder .reason-markup-arm) invalid-type)
      (return invalid-type)
    )
    (if (== (call (. calls builder-call) id builder 1) invalid-type)
      (call decline id)
      (return invalid-type)
    )
    (return (. types void-type))
  )
  (fn-do _ leave-unbuilt _
    (param body SyntaxId)
    ; Gives each local a body declares, which nothing here runs, the void type, so that the
    ; environment that holds those a nested function would capture has room for none of them: the
    ; content an outlet mounts where it is given none, in a function given a builder for it.
    (let start (call (. tree subtree-start) body))
    (let range (. ([] (. bindings bindings) (. frame binding)) slots))
    (for (in offset (..< 0 (. range count)))
      (let slot (+ (. range start) offset))
      (let syntax (. ([] (. bindings slots) slot) syntax))
      (if (and (>= syntax start) (<= syntax body) (== (call (. frame known) slot) no-type))
        (call (. frame assign) slot (. types void-type))
      )
    )
  )
  (fn-do + runs-content Bool
    (param line SyntaxId)
    ; Whether a line of markup content is a match or a table that runs the arm it takes as content
    ; of the element, as an `if` does, and gives the element nothing itself: one that is no markup
    ; branch region, whose arms the binder made content of (`content-arms`).
    (return (and (not (call is-region line)) (!= (. (call (. tree content-arms) line) length) 0)))
  )
  (fn-do _ store-arguments Bool
    (param id SyntaxId)
    (param made TypeId)
    (param args (of RowRange SyntaxId))
    ; Keeps, for each argument of a markup element whose parameter has the name of a property of
    ; the element's class, that the argument is stored in the property once the object is made,
    ; converted as a value assigned to the property is. False where such a store has no shape
    ; here: an argument written with a name or a `?`, or given to a variadic parameter, a
    ; property that is not stored in the object or is private to another module, or an array,
    ; whose storage the runtime is told is replaced.
    (let fact (call (. facts latest-call) instance id))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return (== (. args count) 0))
    )
    (let callee ([] (. instances rows) (. ([] (. facts calls) fact) callee)))
    (let owner ([] (. program modules) (. callee module)))
    (match? ([] (. owner decls) (. callee decl))
      (case (call .decl-function fn)
        (let position U32)
        (for (in arg ([] (. tree children) args))
          (if (is ([] (. tree nodes) arg) .node-argument)
            (return false)
          )
          (if (< position (. fn args count))
            (let shape ([] (. owner arg-pool) (+ (. fn args start) position)))
            (let place (only-if (call property-named made (. shape name)) (if (. shape name))))
            (if place
              (let property ([] (. types properties) place))
              (let given (call (. facts node-type) instance arg))
              (if (or (. shape is-variadic) (!= (. property storage-kind) .storage-eager))
                (return false)
              )
              (if (call is-hidden property (!! (. shape name)) .setter-decl)
                (return false)
              )
              (let declared (. property type))
              (if (== declared no-type)
                (= declared (call demand-member property made (!! (. shape name))))
              )
              (if (or (== declared no-type) (== declared invalid-type))
                (return false)
              )
              (if (call is-array-value declared)
                (return false)
              )
              (if (== (call (. conversions convert) arg arg given declared .reason-assignment) invalid-type)
                (return false)
              )
              (let written (call (. panics property-of) made (!! (. shape name))))
              (if written
                (call (. panics note-write) instance written)
              )
              (call (. facts note-element-store)
                (block
                  (arg (call ElementStore instance id position (as place U32) arg))
                )
              )
            )
          )
          (+= position 1)
        )
        (return true)
      )
    )
    (return (== (. args count) 0))
  )
  (fn-do + outlet-region SyntaxId
    (param outlet SyntaxId)
    ; The parameter of a slot outlet that is a markup branch region of one arm, the outlet, at which
    ; the region is written, or none.
    (match? ([] (. tree nodes) outlet)
      (case (call .node-slot-outlet row)
        (return
          (scope (if-expr (and (!= (. row slot-parameter) 0) region-slot) (. row slot-parameter) 0u32)
            (lazy region-slot (call is-region (. row slot-parameter)))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + region-ensure (? InstanceId)
    (param id SyntaxId)
    (param made TypeId)
    (param batched Bool)
    (param reason ConversionReason)
    ; The call that puts a markup region under the batch the reference finds for its host, as
    ; `applyMarkupBatchRoot` does: none where no batch is found or the region is no markup host.
    ; The region is converted at the `if` or `for` to the host for the given reason, and the
    ; batch to the optional the call takes. One that has no shape here is declined, which is
    ; answered with nothing.
    (if (or (not batched) (not (call is-markup-host made)))
      (return no-instance)
    )
    (let host (call derived-interface made (. types markup-host-decl)))
    (let optional (call (. types optional-of) (call batch-type)))
    (let mark (. scratch types mark))
    (call (. scratch types push) host)
    (call (. scratch types push) optional)
    (let ensure
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "ensure-markup-root"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== ensure no-instance) (not (call raises-out id ensure)))
      (call decline id)
      (return null)
    )
    (call (. conversions convert) id id made host reason)
    (call (. conversions convert) id id (call batch-type) optional .reason-markup-root)
    (return ensure)
  )
  (fn-do + makes-region Bool
    (param host TypeId)
    ; Whether a markup host makes the regions of live loops and branches: a class declares
    ; `markup-make-region`, itself or in a base class, which the markup runtime calls for an empty
    ; region of the host's content to hold the region's controller. A host that is no class is left
    ; to the runtime.
    (return-if true (if (!= (call (. types intrinsic-of) host) .class)))
    (return (call declares-method host (call (. program store-atom) "markup-make-region")))
  )
  (fn-do + check-loop-region TypeId
    (param id SyntaxId)
    (param parent TypeId)
    ; A markup loop region, as the reference compiles one:
    ; one header, whose pattern is a name alone or none, with no clause but `keyed by`,
    ; by whose last one a function of its own keys each row (`check-key`).
    ; Its container is read in a live action of the region's own, where its read of a collection
    ; is no change the action follows, since the region observes the collection itself, and is the
    ; region's source as `loop-source` says. The host the `for` is content of must be a
    ; `MarkupElement`, whose `MarkupParent` gives the type of its content. Each row is built by a
    ; function of its own given the item, which gives one element as the host's content, made a
    ; `MarkupRowBuilder` at the `for`; that of a keyed loop over a collection is given a
    ; `MarkupRowItem` that holds the item, and made a `MarkupCollectionRowBuilder`. The key's
    ; function is made a `MarkupKeyBuilder` at its clause. A row whose body is not one element, as
    ; `row-region` says, is built as an arm is, into a region of its own: its function is given the
    ; region after the item, made a `MarkupRegionRowBuilder` at the `for`, and the markup runtime's
    ; `markup-region-row`, or `markup-region-keyed-row`, makes the builder of it, which makes the
    ; region of the host for each row. The markup runtime makes the region of
    ; the host, the builders and the source, given last, as `loop-source` says, keyed where the loop
    ; is, and gives the region a source again by a replacer of its own; the region is the line's
    ; value, which the host takes. The host and the region are kept, in the
    ; two locals no name reaches declared at the `for`, for the function that reads the container
    ; again, which the action runs: made by
    ; `make-owner-markup-action`, owned by the region and marked structural. Where a batch is found
    ; for the host, the host itself where it is a batch and else the one in force, the region is
    ; put under it by `ensure-markup-root` once made; where one is in force it is kept in a third
    ; local no name reaches, which the rows are built under, and the action is made with it by
    ; `make-markup-action`. One whose region is no class is declined; one of a class with events
    ; is kept as any other, as the reference keeps it. One whose content is a class and whose host
    ; makes no regions, as `makes-region` says, is an error at the `for`.
    (let loop SyntaxId 0)
    (let body SyntaxId 0)
    (match? ([] (. tree nodes) id)
      (case (call .node-for-block row)
        (= loop (. row loop))
        (= body (. row body))
      )
    )
    (let pattern SyntaxId 0)
    (let container SyntaxId 0)
    (let clause SyntaxId 0)
    (let chained SyntaxId 0)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (= pattern (. row pattern))
        (= container (. row container))
        (= clause (. row clause))
        (= chained (. row next))
      )
    )
    (if (!= chained 0)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Combined markup loops not supported"))
