    )
    (if (and (!= pattern 0) (not (is ([] (. tree nodes) pattern) .node-type-capture)))
      (call (. frame diagnose)
        (block
          (arg pattern)
          (arg .stated)
          (arg (call (. program store-atom) "Markup loop patterns must be simple captures"))
        )
      )
      (return invalid-type)
    )
    (let current clause)
    (let filters 0)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) current)
        (case (call .node-clause row)
          (if (== (. row op) .when-clause)
            (+= filters 1)
          )
          (if (and (!= (. row op) .keyed-by-clause) (!= (. row op) .when-clause))
