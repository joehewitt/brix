        (if (!= (. ([] rule-scopes position) scope own) .scope-pending)
          (+= found ([] rule-scopes position))
        )
      )
    )
    (call (. rule-scopes clear))
    (for (in use saved-scopes)
      (+= rule-scopes use)
    )
    (call (. markup-sheets clear))
    (for (in sheet saved-sheets)
      (+= markup-sheets sheet)
    )
    (call (. sheet-levels clear))
    (for (in level saved-levels)
      (+= sheet-levels level)
    )
    (= keying own-keying)
    (return status)
  )
  (fn-do _ follow-outlet U32
    (param owner TypeId)
    (param home ModuleId)
    (param written AST)
    (param root SyntaxId)
    (param path (list SyntaxId))
    (param outlet SyntaxId)
