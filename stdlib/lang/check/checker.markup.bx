    (+= scoped-starts (as (. scoped-rows length) U32))
    (for (in scope scopes)
      (+= scoped-rows scope)
    )
    (+= scoped-ends (as (. scoped-rows length) U32))
  )
  (fn-do _ push-scopes _
    (param id SyntaxId)
    ; Brings into view, for the constructor of a markup element's object, the rules written in rules
    ; that the style rules the element applies do, those that reach only the markup of its class's
    ; own (`scope-pending`) with them.
    (let (tuple start end) (call scopes-of id))
    (for (in position (..< start end))
      (+= rule-scopes ([] scoped-rows position))
    )
  )
  (fn-do _ push-body-scopes _
    (param id SyntaxId)
    ; Brings into view, for the markup in a markup element's body, the rules written in rules that
    ; the style rules the element applies do, but those that reach only the markup of its class's
    ; own (`scope-pending`).
    (let (tuple start end) (call scopes-of id))
    (for (in position (..< start end))
      (if (!= (. ([] scoped-rows position) scope own) .scope-pending)
        (+= rule-scopes ([] scoped-rows position))
      )
    )
  )
  (fn-do + markup-layer U32
    ; The layer at which the elements of markup written here declare styles: content, 1, in the
    ; function that makes a class's content, and inline, 5, anywhere else. A function that builds
    ; markup takes that of the markup around it (`layer-given`). None in another function nested in
    ; one that makes content.
    (if (!= layer-given 0)
      (return layer-given)
    )
    (if (. frame declaration is-content)
      (return 1)
    )
    (let outer (. ([] (. instances rows) instance) enclosing))
    (while (!= outer no-instance)
      (let row ([] (. instances rows) outer))
      (let written (call describe program (. row module) (. row decl)))
      (if (and written (. written is-content))
        (return (. U32 max))
      )
      (= outer (. row enclosing))
    )
    (return 5)
  )
  (fn-do + reads-element Bool
    (param receiver TypeId)
    (param tree AST)
    (param value SyntaxId)
    ; Whether a value reads by its name alone a property the markup of a class declares for an
    ; element, apart from in the functions written in it.
