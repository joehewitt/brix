        (return invalid-type)
      )
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (let markup (. types markup-host-decl module))
    (let mark (. scratch types mark))
    (let optional (== (call (. types intrinsic-of) source) .optional))
    (let held (if-expr optional (call (. types optional-inner) source) source))
    (call (. scratch types push) item)
    (call (. scratch types push) content)
    (call (. scratch types push) parent)
    (call (. scratch types push) held)
    (call (. scratch types push) parent)
    (call (. scratch types push) builder)
    (if (!= keyer no-type)
      (call (. scratch types push) keyer)
