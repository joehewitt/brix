          (let shown false)
          (for (in held rule-scopes)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (for (in held added)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (if (not shown)
            (+= added use)
          )
        )
        (for (in use added)
          (+= rule-scopes use)
        )
      )
    )
