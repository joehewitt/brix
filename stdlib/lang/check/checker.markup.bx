    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (let content SyntaxId 0)
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class row)
          (= content (. row content))
        )
      )
      (if (!= content 0)
        (for (in node (..< (call (. owner tree subtree-start) content) content))
          (match? ([] (. owner tree nodes) node)
            (case (call .node-slot-outlet row)
              (let named (call (. program store-atom) ""))
              (if (!= (. row name) 0)
                (= named (?? (call (. owner tree identifier-name) (. row name)) named))
              )
              (if (and (== named name) (not (call (. owner tree inner-outlet) content node)))
                (return (tuple level node))
              )
            )
            (case (call .node-markup-slot-forward row)
              (if (== (call (. owner tree identifier-name) (. row slot-binding)) name)
                (return (tuple level node))
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
