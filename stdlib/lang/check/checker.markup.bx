      (+= discoveries tag)
      (= status (call follow-outlet owner (. ref module) written root path outlet name))
      (call (. discoveries pop))
    )
    (if (== status 3)
      (= status 2)
    )
    (if (== status 1)
      (= status 0)
      (while (> (. rule-scopes length) based)
        (call (. rule-scopes pop))
      )
    )
    (if (and (== status 0) applies)
      (call (. markup-sheets clear))
      (call (. sheet-levels clear))
      (for (in sheet sheets)
        (+= markup-sheets sheet)
      )
      (for (in level levels)
        (+= sheet-levels level)
      )
      (= status (call outlet-applications class name content))
    )
    (if (or (== status 0) (== status 3))
