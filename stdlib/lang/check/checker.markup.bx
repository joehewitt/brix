  (fn-do + class-content SyntaxId
    (param class TypeId)
    ; The section of markup a class writes, or none.
    (let ref (call class-ref types class))
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class declared)
        (return (. declared content))
      )
    )
    (return 0)
  )
  (fn-do _ content-cell U32
    (param scope RuleScope)
    (param kept U32)
    (param depth U32)
    ; The state cell the function that builds generated content keeps, its `kept`th, for a `when`
    ; around a rule written in a rule its context gives: the frame of the rule that is the `depth`th
    ; `when`'s from the innermost, which the markup element the content is generated at holds
    ; (`StyleContent`).
