./instances
./session
./shared-results
./stable-key
./type-store
./types
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range

_ portable-none = 0u32
_ portable-invalid = 1u32
_ portable-class = 2u32
_ portable-variable = 3u32
_ portable-inference = 4u32
_ portable-tuple = 5u32
_ portable-struct = 6u32
_ portable-union = 7u32
_ portable-named-union = 8u32
_ portable-function = 9u32
_ portable-result = 10u32
_ portable-associated = 11u32
_ portable-binding = 12u32

━━━━━━━━━━━━━━━━━━━━
+ do export-instance PortableInstance?
    - session Session
    - id InstanceId

` The instance as another pass can intern it, or none for one that only its own pass can: one
` written in another or that holds a closure, the value of a property or of a rule a root
` applies, an equality, one a markup element makes, one in a GC-free zone or under a fake, one
` typed again for the errors it inherits, a constructor that leaves properties to the defaults of
` the class it makes (`Instance.redefaults`), a rule typed for the text it matched
` (`Instance.spans`), and one typed for the UTF-8 bytes of a String (`Instance.encoded`). A constructor a markup element
` gives properties, slots or styles is written out with them: the properties by their places
` among those of its class, the slots by their names and the styles by what its style context
` holds (`put-context`).
. instances = session.instances
. row = instances.rows[id]
if row.enclosing != no-instance || row.holds-closure || row.initializer != 0 || row.root-values != 0
    = null
if row.compares || row.element != no-type || row.inherits != no-instance || materializes
    = null
.. materializes = row.materialized != no-instance
if row.redefaults != 0 || row.spans || row.encoded
    = null
if (row.effects /and/ CompilationEffect.gc-free) != 0 || swap-set-of(row.effects) != 0
    = null
. words [U32]
. names [Atom]
. types = session.types
if !put-type(types, row.self-type, words, names) || !put-type(types, row.row-receiver, words, names)
    = null
if !put-type(types, row.helper, words, names)
    = null
. signature = instances.signatures[id]
. params = signature.args.start - signature.param-count
words += signature.param-count
words += signature.args.count
for position in params .. < signature.args.start + signature.args.count
    if !put-type(types, instances.signature-types[position], words, names)
        = null
if !put-fills(session, row, words, names) || !put-context(session, row.context, words, names)
    = null
words += row.slots.count
for offset in 0 .. < row.slots.count
    put-name(instances.slot-atoms[instances.slot-places[row.slots.start + offset]], words, names)
= PortableInstance
    - row.module
    - row.decl
    - row.effects
    - instances.stable-keys[id]
    - row.row-case
    - row.row-validated
    - words
    - names

━━━━━━━━━━━━━━━━━━━━
+ do import-instance InstanceId
    - session Session
    - item PortableInstance

` Interns an instance another pass wrote out, without queueing it.
. types = session.types
. reader = PortableReader(types, item.words, item.names)
. self-type = reader.type()
. row-receiver = reader.type()
. helper = reader.type()
. param-count = reader.next()
. arg-count = reader.next()
. stack = types.scratch.types
. mark = stack.mark
for _ in 0 .. < param-count + arg-count
    stack.push(reader.type())
. params = stack.span(mark, param-count)
. args = stack.span(mark + param-count, arg-count)
. instances = session.instances
. words = types.scratch.words
. fills-mark = words.mark
. fill-count = reader.next()
if fill-count != 0
    types.complete(self-type)
    . start = types.completions[self-type].properties.start
    for _ in 0 .. < fill-count
        . place = start + reader.next()
        ?! Panic("A property of another type pass is another property here")
            if types.properties[place].name != reader.name()
        words.push(place)
. fills = words.since(fills-mark)
. context = read-context(instances, reader)
. slots-mark = words.mark
. slot-count = reader.next()
for _ in 0 .. < slot-count
    words.push(instances.slot-id(reader.name()))
. slots = words.since(slots-mark)
. id = instances.intern
    - item.module
    - item.decl
    - self-type
    - item.effects
    - no-instance
    - params
    - args
    - false
    - row-receiver
    - item.row-case
    - item.row-validated
    - 0
    - helper
    - fills
    - slots
    - context
words.rewind(fills-mark)
stack.rewind(mark)
= id

━━━━━━━━━━━━━━━━━━━━
+ do export-class PortableClass?
    - types Types
    - id TypeId

` The class as another pass can intern it (`import-class`), or none for one only its own pass
` knows.
. words [U32]
. names [Atom]
=? null if !put-type(types, id, words, names)
= PortableClass(types.key-of(id), words, names)

━━━━━━━━━━━━━━━━━━━━
+ do import-class TypeId
    - types Types
    - item PortableClass

` Interns a class another pass wrote out.
= PortableReader(types, item.words, item.names).type()

━━━━━━━━━━━━━━━━━━━━
_ do read-context U32
    - instances Instances
    - reader PortableReader

` Interns the style context a portable instance writes out (`put-context`), or gives none.
if reader.next() == 0
    = U32.max
. style-count = reader.next()
. sheet-count = reader.next()
. styles [TypeId]
. sheets [TypeId]
. levels [U32]
for position in 0 .. < style-count + sheet-count
    . type = reader.type()
    . level = reader.next()
    if position < style-count
        styles += type
    else
        sheets += type
        levels += level
. scope-count = reader.next()
. scopes [RuleScope]
. cells [U32]
. valued [U32]
for _ in 0 .. < scope-count
    . module = reader.next()
    . decl = reader.next()
    . owner = reader.type()
    . frames = read-frames(instances, reader)
    scopes += RuleScope(module, decl, owner, frames, reader.next() as ScopeOwn)
    cells += reader.next()
    valued += reader.next()
. made = reader.type()
. layer = reader.next()
. value-count = reader.next()
. value-types [TypeId]
for _ in 0 .. < value-count
    value-types += reader.type()
= instances.intern-context(styles, sheets, levels, scopes, cells, made, layer, valued, value-types)

━━━━━━━━━━━━━━━━━━━━
_ do read-frames U32
    - instances Instances
    - reader PortableReader

` Interns the style rules applied around a rule written in a rule that a portable instance writes
` out innermost first (`put-frames`), and gives the innermost, or none.
. count = reader.next()
. modules [U32]
. decls [U32]
. owners [TypeId]
. gates [U32]
for _ in 0 .. < count
    modules += reader.next()
    decls += reader.next()
    owners += reader.type()
    gates += reader.next()
. frame = U32.max
for offset in 0 .. < count
    . position = count - 1 - offset
    frame = instances.intern-frame
        - frame
        - modules[position]
        - decls[position]
        - owners[position]
        - gates[position]
= frame

━━━━━━━━━━━━━━━━━━━━
+ do export-result PortableResult?
    - session Session
    - id InstanceId

` What this pass knew of an instance once it typed its body, for another pass to take in, or none
` where taking it in might differ from typing the body there: one that pass could not intern
` (`export-instance`), one taken in itself, one whose typing changed what a pass cannot take in,
` one typed only with the one it is written in, one whose body failed or was reported on, one whose errors or return type wait on others, one
` that names another instance, and a rule, whose rollback marks a call reads.
. instances = session.instances
. row = instances.rows[id]
. signature = instances.signatures[id]
if unfinished || row.imported || row.unshared || row.with-enclosing || !instances.errors-known(id)
    = null
.. unfinished = row.state != .instance-done
if signature.return-state == .return-pending || signature.return-state == .return-failed
    = null
if row.materialized != no-instance || row.retyped != no-instance
    = null
if rule-match(session.program, row.module, row.decl) != 0 || session.facts.has-diagnostic(id)
    = null
if !export-instance(session, id)
    = null
. words [U32]
. names [Atom]
. types = session.types
if !put-type(types, signature.returns, words, names) || !put-type(types, signature.declared-returns, words, names)
    = null
if !put-type(types, row.makes, words, names) || !put-type(types, row.yields, words, names)
    = null
if !put-errors(session, signature.errors, words, names) || !put-errors(session, row.step-errors, words, names)
    = null
= PortableResult
    - row.may-panic
    - row.polls
    - row.is-generator
    - row.reads-self
    - row.branches
    - row.returns-own
    - row.gives-unwritten
    - row.casts-errors
    - row.ends-generator
    - row.quiet
    - row.splits-yields
    - row.fills-share
    - row.uses-helper
    - row.rolls-helper
    - row.carries-mark
    - row.is-live
    - row.consumes
    - row.hands-back
    - signature.return-state
    - signature.header
    - signature.error-state
    - signature.unreturned
    - signature.read-in-progress
    - signature.errors-read-early
    - words
    - names

━━━━━━━━━━━━━━━━━━━━
_ do put-errors Bool
    - session Session
    - range RowRange'TypeId
    - words [U32]
    - names [Atom]

words += range.count
for offset in 0 .. < range.count
    if !put-type(session.types, error-type, words, names)
        = false
    .. error-type = session.instances.signature-types[range.start + offset]
= true

━━━━━━━━━━━━━━━━━━━━
+ do import-result
    - session Session
    - id InstanceId
    - result PortableResult

` Gives an instance not yet typed what another pass knew of it once it typed its body
` (`export-result`), in place of typing the body here. The body stays the other pass's.
. instances = session.instances
. types = session.types
. reader = PortableReader(types, result.words, result.names)
. returns = reader.type()
. declared = reader.type()
. makes = reader.type()
. yields = reader.type()
. stack = types.scratch.types
. mark = stack.mark
for _ in 0 .. < reader.next()
    stack.push(reader.type())
instances.set-errors(id, stack.since(mark))
stack.rewind(mark)
. step-count = reader.next()
if step-count != 0
    for _ in 0 .. < step-count
        stack.push(reader.type())
    instances.set-step-errors(id, stack.since(mark))
    stack.rewind(mark)
instances.set-returns(id, returns, declared, result.return-state)
instances.signatures[id].header = result.header
instances.signatures[id].error-state = result.error-state
instances.signatures[id].unreturned = result.unreturned
instances.signatures[id].read-in-progress = result.read-in-progress
instances.signatures[id].errors-read-early = result.errors-read-early
instances.rows[id].state = .instance-done
instances.rows[id].imported = true
instances.rows[id].may-panic = result.may-panic
instances.rows[id].polls = result.polls
instances.rows[id].is-generator = result.is-generator
instances.rows[id].reads-self = result.reads-self
instances.rows[id].branches = result.branches
instances.rows[id].returns-own = result.returns-own
instances.rows[id].gives-unwritten = result.gives-unwritten
instances.rows[id].casts-errors = result.casts-errors
instances.rows[id].makes = makes
instances.rows[id].yields = yields
instances.rows[id].ends-generator = result.ends-generator
instances.rows[id].quiet = result.quiet
instances.rows[id].splits-yields = result.splits-yields
instances.rows[id].fills-share = result.fills-share
instances.rows[id].uses-helper = result.uses-helper
instances.rows[id].rolls-helper = result.rolls-helper
instances.rows[id].carries-mark = result.carries-mark
instances.rows[id].is-live = result.is-live
instances.rows[id].consumes = result.consumes
instances.rows[id].hands-back = result.hands-back

━━━━━━━━━━━━━━━━━━━━
+ do adopt Bool
    - session Session
    - id InstanceId

` Takes in what another pass of a parallel type pass published of an instance this pass has not
` begun to type (`SharedTyping`), in place of typing it, and says whether there was any.
if !session.shared || session.instances.rows[id].state != .instance-unstarted
    = false
. result = session.shared.find(session.instances.stable-keys[id])
if !result
    = false
import-result(session, id, result)
= true

━━━━━━━━━━━━━━━━━━━━
+ do offer-queued
    - session Session

` Offers the other passes of a parallel type pass each instance typing queued here since the last
` offer that any of them can intern, and keeps the others in `session.local` to type here. First
` it publishes each instance whose errors settled since only after its body ended (`share`).
if !session.shared
    =
. shared = session.shared
. instances = session.instances
while session.shared-settled < instances.settled.length
    share(session, instances.settled[session.shared-settled])
    session.shared-settled += 1
while session.offered < instances.worklist.length
    . queued = instances.worklist[session.offered]
    session.offered += 1
    if started || shared.has(instances.stable-keys[queued])
        continue
    .. started = instances.rows[queued].state != .instance-unstarted
    . portable = export-instance(session, queued)
    if portable
        shared.offer(portable)
    else
        session.local += queued

━━━━━━━━━━━━━━━━━━━━
+ do share
    - session Session
    - id InstanceId

` Publishes what this pass knew of an instance it typed, for the other passes of a parallel type
` pass to take in (`export-result`), where it can.
if !session.shared
    =
. result = export-result(session, id)
if result
    session.shared!.publish(session.instances.stable-keys[id], result)

━━━━━━━━━━━━━━━━━━━━
_ do put-type Bool
    - types Types
    - id TypeId
    - words [U32]
    - names [Atom]

` Writes a type out by what it is, its parts first. False for a closure, which only the pass
` that types the instance it is written in knows.
if id == no-type
    words += portable-none
    = true
do match types.rows[id]
    | .type-invalid
        words += portable-invalid
    | .type-class(row)
        words += portable-class
        words += row.module
        words += row.decl
        if !put-range(types, row.args, words, names) || !put-range(types, row.errors, words, names)
            = false
    | .type-variable(row)
        words += portable-variable
        words += row.module
        words += row.decl
        words += row.index
        put-name(row.name, words, names)
    | .type-inference(row)
        words += portable-inference
        words += row.scope
        words += row.ordinal
    | .type-tuple(row)
        words += portable-tuple
        if !put-fields(types, row.fields, row.names, words, names)
            = false
    | .type-struct(row)
        words += portable-struct
        if !put-fields(types, row.fields, row.names, words, names)
            = false
    | .type-union(row)
        words += portable-union
        if !put-range(types, row.cases, words, names)
            = false
    | .type-named-union(row)
        words += portable-named-union
        put-name(row.owner, words, names)
        words += row.made-in
        words += row.made-at
        if !put-fields(types, row.cases, row.names, words, names)
            = false
    | .type-function(row)
        words += portable-function
        words += if row.is-c then 1u32 else 0u32
        if !put-type(types, row.return-type, words, names)
            = false
        if !put-range(types, row.args, words, names) || !put-range(types, row.errors, words, names)
            = false
    | .type-result(row)
        words += portable-result
        if !put-type(types, row.value, words, names) || !put-range(types, row.errors, words, names)
            = false
    | .type-associated(row)
        words += portable-associated
        words += row.module
        words += row.decl
        if !put-type(types, row.owner, words, names)
            = false
        put-name(row.name, words, names)
        if !put-range(types, row.args, words, names)
            = false
    | .type-closure
        = false
    | .type-binding(row)
        words += portable-binding
        words += row.form
        words += row.scope
        words += row.module
        words += row.decl
        if !put-type(types, row.object, words, names)
            = false
        words += row.param-count
        if !put-range(types, row.items, words, names)
            = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-fills Bool
    - session Session
    - row Instance
    - words [U32]
    - names [Atom]

` Writes out the properties a markup element gives a constructor by their places among those of
` the class it makes, each with its name. False where one is not among them.
. types = session.types
words += row.fills.count
if row.fills.count == 0
    = true
. range = types.completions[row.self-type].properties
for offset in 0 .. < row.fills.count
    . place = session.instances.fill-places[row.fills.start + offset]
    if place < range.start || place >= range.start + range.count
        = false
    words += place - range.start
    put-name(types.properties[place].name, words, names)
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-context Bool
    - session Session
    - context U32
    - words [U32]
    - names [Atom]

` Writes out a style context by what it holds: its styles and its style sheets, each with its
` group, the rules written in rules it sees, each with the rules applied around it and what it is
` given, the class of the object whose content it makes, its layer, and the types of the values it
` gives. False where one of those types is a closure.
if context == U32.max
    words += 0
    = true
. instances = session.instances
. types = session.types
words += 1
. held = instances.contexts[context]
words += held.styles
words += held.sheets
for position in held.first .. < held.first + held.styles + held.sheets
    if !put-type(types, instances.context-types[position], words, names)
        = false
    words += instances.context-levels[position]
words += held.scopes
for position in held.scope-first .. < held.scope-first + held.scopes
    . scope = instances.context-scopes[position]
    words += scope.module
    words += scope.decl
    if !put-type(types, scope.owner, words, names) || !put-frames(session, scope.frames, words, names)
        = false
    words += scope.own
    words += instances.context-cells[position]
    words += instances.context-valued[position]
if !put-type(types, held.made, words, names)
    = false
words += held.layer
words += held.values
for position in held.value-first .. < held.value-first + held.values
    if !put-type(types, instances.context-value-types[position], words, names)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-frames Bool
    - session Session
    - frame U32
    - words [U32]
    - names [Atom]

` Writes out the style rules applied around a rule written in a rule, innermost first.
. instances = session.instances
. chain [U32]
. current = frame
while current != U32.max
    chain += current
    current = instances.frames[current].outer
words += chain.length as U32
for held in chain
    . row = instances.frames[held]
    words += row.module
    words += row.decl
    if !put-type(session.types, row.owner, words, names)
        = false
    words += row.gate
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-range Bool
    - types Types
    - range RowRange'TypeId
    - words [U32]
    - names [Atom]

words += range.count
for offset in 0 .. < range.count
    if !put-type(types, types.child-type(range, offset), words, names)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-fields Bool
    - types Types
    - fields RowRange'TypeId
    - field-names RowRange'Atom
    - words [U32]
    - names [Atom]

words += fields.count
for offset in 0 .. < fields.count
    put-name(types.child-name(field-names, offset), words, names)
    if !put-type(types, types.child-type(fields, offset), words, names)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do put-name
    - name Atom
    - words [U32]
    - names [Atom]

words += names.length as U32
names += name

━━━━━━━━━━━━━━━━━━━━
_ PortableReader

` Interns the types a portable instance writes out, in the order they are written.

_ types Types
_ words [U32]
_ names [Atom]
_ position Size = 0

────────────────────
+ This
    - types Types
    - words [U32]
    - names [Atom]

────────────────────
+ do next U32

. word = words[position]
position += 1
= word

────────────────────
+ do name Atom

= names[next()]

────────────────────
+ do type TypeId

. stack = types.scratch.types
. tag = next()
if tag == portable-none
    = no-type
if tag == portable-invalid
    = invalid-type
if tag == portable-class
    . module = next()
    . decl = next()
    . mark = stack.mark
    push-range()
    . errors-mark = stack.mark
    push-range()
    = types.intern-raising-class(module, decl, mark, errors-mark)
if tag == portable-variable
    . module = next()
    . decl = next()
    . index = next()
    = types.intern-variable(module, decl, index, name())
if tag == portable-inference
    . scope = next()
    = types.intern-inference(scope, next())
if tag == portable-tuple || tag == portable-struct
    . mark = stack.mark
    . names-mark = types.scratch.names.mark
    push-fields()
    = if tag == portable-tuple then types.intern-tuple(mark, names-mark) else types.intern-struct(mark, names-mark)
if tag == portable-union
    . mark = stack.mark
    push-range()
    = types.intern-union(mark)
if tag == portable-named-union
    . owner = name()
    . made-in = next()
    . made-at = next()
    . mark = stack.mark
    . names-mark = types.scratch.names.mark
    push-fields()
    = types.intern-named-union(owner, mark, names-mark, made-in, made-at)
if tag == portable-function
    . is-c = next() != 0
    . returns = type()
    . mark = stack.mark
    push-range()
    . errors-mark = stack.mark
    push-range()
    = types.intern-function(returns, is-c, mark, errors-mark)
if tag == portable-result
    . value = type()
    . mark = stack.mark
    push-range()
    = types.intern-ordered-result(value, mark)
if tag == portable-associated
    . module = next()
    . decl = next()
    . owner = type()
    . named = name()
    . mark = stack.mark
    push-range()
    = types.intern-associated(owner, DeclRef(module, decl), named, mark)
?! Panic("A portable type has no kind $tag")
    if tag != portable-binding
. form = next() as BindingForm
. scope = next()
. module = next()
. decl = next()
. object = type()
. param-count = next()
. mark = stack.mark
push-range()
= types.intern-binding(form, scope, module, decl, object, param-count, mark)

────────────────────
_ do push-range

. count = next()
for _ in 0 .. < count
    . child = type()
    types.scratch.types.push(child)

────────────────────
_ do push-fields

. count = next()
for _ in 0 .. < count
    . named = name()
    . child = type()
    types.scratch.names.push(named)
    types.scratch.types.push(child)
