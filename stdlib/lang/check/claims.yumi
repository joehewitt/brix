/lang/constants

+ task-suspending-names [String] = ["brixSuspendTask", "brixWaitForSemaphore", "brixPostSemaphore", "brixLockMutex", "brixGCSafepoint", "brixTaskSafepoint", "brixGCLeaveFFI", "brixClaimLazyGlobal"]

+ task-suspending-prefix = "brixSuspendActiveTask"

+ task-yielding-names [String] = ["brixWaitForTask", "brixTaskEndingWait", "brixCancelTask", "brixResumeTaskNow"]

+ termination-leaving-names [String] = ["brixLockMutex", "brixSuspendTask"]

+ allocating-names [String] = ["brixAllocObject", "brixAllocObjectDescribed", "brixAllocBuffer", "brixAllocBufferDescribed", "brixResizeBuffer", "brixResizeBufferDescribed", "brixGCAllocObject", "brixGCAllocObjectDescribed", "brixGCAllocBuffer", "brixGCAllocBufferDescribed", "brixGCResizeBuffer", "brixGCResizeBufferDescribed", "brixGCResizeBufferCopy", "brixAllocObjectWithSiteKey", "brixGCAllocationBufferRefill", "brixGCCompilerAllocationBufferRefill", "brixGCTestAllocBatch", "brixParseRegionPromote", "brixParseRegionPromoteValue", "brixTakePanic", "brixArrayViewCreate", "brixCharToString", "brixDoubleToFixedString", "brixDoubleToString", "brixFloatToString", "brixIntToString", "brixLonglongToString", "brixStringAdopt", "brixStringConcat", "brixStringCreate", "brixStringCreateASCII", "brixStringCreateValidated", "brixStringDecompose", "brixStringNormalize", "brixStringRepeat", "brixStringSlice", "brixStringSliceUtf8", "brixStringFromUtf8Codepoint", "brixStringFromUtf8Codepoints", "brixStringToLowercase", "brixStringToUppercase", "brixStringToUtf8Codepoints", "brixToHex", "brixUintToString", "brixUlonglongToString"]

+ plain-polling-names [String] = ["brixPrint", "brixPrintUnhandledError", "brixReportUnhandledError", "brixReportUnhandledPanic", "brixReportFatalPanic", "brixStartTask", "brixStartOwnedTask", "brixCancelOwnedTasks", "brixCancelOwnedTasksTo", "brixForkTask", "brixForkMainTask", "brixTerminate", "brixTerminateActiveTask", "brixSaveArgs", "brixGCValidateAllocationABI", "brixGetProcessExitCode", "exit", "brixInterruptRequestedFlags", "brixGCEnterFFI", "brixGCEnterZone", "brixGCLeaveZone", "brixArrayCopySlice", "brixArrayCopySliceDescribed", "brixArrayViewsReplace", "brixArrayViewsInvalidate", "brixArenaReserveDescribed", "brixGCObjectSidePayload", "brixGCClearObjectSidePayload", "brixBatchStartIndex", "brixBatchEndIndex", "brixBatchTestStart", "brixBatchTestFinish", "brixActiveTaskQueueActivity", "brixReleaseLazyGlobal", "brixAbandonLazyGlobal", "brixProbeTracing", "brixCollect", "brixGCCollect", "brixGCScavenge", "brixGCStartConcurrentMark", "brixGCFinishConcurrentMark", "brixGCFrameBudget", "brixGCOwnerWeakLoad", "brixGCRegisterOwnerWeak", "brixGCReleaseOwnerWeak", "brixGCAddRoot", "brixGCRegisterCleanup", "brixGCCancelCleanup", "brixCollectionObserverActivate", "brixCollectionObserverDeactivate", "brixGCPublishObjectSidePayload", "brixGCPublishCleanupObjectSidePayload", "brixBenchTemporaryRootShim", "brixStringMeasureDisplayWidth"]

+ code-running-names [String] = ["brixRunEventLoop", "brixGCDrainCleanups"]

━━━━━━━━━━━━━━━━━━━━
+ suspends-task Bool
    - name String

canonical.starts-with(task-suspending-prefix) || task-suspending-names.find(canonical) != null
.. canonical = canonical-runtime-name(name)

━━━━━━━━━━━━━━━━━━━━
+ leaves-termination Bool
    - name String

` Whether a C function suspends the task but leaves a termination to what follows, so the call is
` not followed by the check that ends a terminated task. `brixLockMutex` takes a lock: a waiter is
` woken only to take it, and a task ended there would hold it before its `use` keeps it, to give it
` back. `brixSuspendTask` answers whether the task is cancelled, as a termination makes it, and
` its caller checks the answer, doing its own work first, such as leaving a queue.
termination-leaving-names.find(canonical-runtime-name(name)) != null

━━━━━━━━━━━━━━━━━━━━
+ allocates Bool
    - name String

allocating-names.find(canonical-runtime-name(name)) != null

━━━━━━━━━━━━━━━━━━━━
+ is-claimed Bool
    - name String

` Whether a C function is classified: one that suspends the task or yields to a task, one that
` allocates from the collector, one that runs code that may do either, or one that polls and does
` neither.
suspends-task(name) || yields-to-task(name) || allocates(name) || is-plain-polling || runs-code(name)
.. is-plain-polling = plain-polling-names.find(canonical-runtime-name(name)) != null

━━━━━━━━━━━━━━━━━━━━
+ runs-code Bool
    - name String

code-running-names.find(canonical-runtime-name(name)) != null

━━━━━━━━━━━━━━━━━━━━
+ yields-to-task Bool
    - name String

` Whether a C function lets another task run before it returns: one that waits for a task to end,
` or one that cancels or resumes a task and yields to it. It suspends the task, but is called as
` its declaration says, as one that may block, and not as one that suspends it.
task-yielding-names.find(canonical-runtime-name(name)) != null

━━━━━━━━━━━━━━━━━━━━
+ may-suspend Bool
    - name String
    - polls Bool

` Whether a C function may suspend the task where a restriction forbids it: one that suspends it
` or yields to a task does. Any other that polls the collector can, so one that polls and is not
` classified is taken to.
suspends-task(name) || yields-to-task(name) || runs-code(name) || (polls && !is-claimed(name))

━━━━━━━━━━━━━━━━━━━━
+ may-allocate Bool
    - name String
    - polls Bool

` Whether a C function may allocate from the collector where a restriction forbids it. Only a
` function that polls the collector can, so one that polls and is not classified is taken to.
allocates(name) || runs-code(name) || (polls && !is-claimed(name))
