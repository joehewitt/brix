+ task-suspending-names [String] = ["yumiSuspendTask", "yumiWaitForSemaphore", "yumiPostSemaphore", "yumiLockMutex", "yumiGCSafepoint", "yumiTaskSafepoint", "yumiGCLeaveFFI", "yumiClaimLazyGlobal"]

+ task-suspending-prefix = "yumiSuspendActiveTask"

+ task-waiting-names [String] = ["yumiWaitForTask", "yumiTaskEndingWait"]

+ allocating-names [String] = ["yumiAllocObject", "yumiAllocObjectDescribed", "yumiAllocBuffer", "yumiAllocBufferDescribed", "yumiResizeBuffer", "yumiResizeBufferDescribed", "yumiGCAllocObject", "yumiGCAllocObjectDescribed", "yumiGCAllocBuffer", "yumiGCAllocBufferDescribed", "yumiGCResizeBuffer", "yumiGCResizeBufferDescribed", "yumiGCResizeBufferCopy", "yumiAllocObjectWithSiteKey", "yumiGCAllocationBufferRefill", "yumiGCCompilerAllocationBufferRefill", "yumiGCTestAllocBatch", "yumiParseRegionPromote", "yumiParseRegionPromoteValue", "yumiTakePanic", "yumiArrayViewCreate", "yumiCharToString", "yumiDoubleToFixedString", "yumiDoubleToString", "yumiFloatToString", "yumiIntToString", "yumiLonglongToString", "yumiStringAdopt", "yumiStringConcat", "yumiStringCreate", "yumiStringCreateASCII", "yumiStringCreateValidated", "yumiStringDecompose", "yumiStringNormalize", "yumiStringRepeat", "yumiStringSlice", "yumiStringSliceUtf8", "yumiStringFromUtf8Codepoint", "yumiStringFromUtf8Codepoints", "yumiStringToLowercase", "yumiStringToUppercase", "yumiStringToUtf8Codepoints", "yumiToHex", "yumiUintToString", "yumiUlonglongToString"]

+ plain-polling-names [String] = ["yumiPrint", "yumiPrintUnhandledError", "yumiReportUnhandledError", "yumiReportUnhandledPanic", "yumiReportFatalPanic", "yumiStartTask", "yumiForkTask", "yumiForkMainTask", "yumiTerminate", "yumiTerminateActiveTask", "yumiSaveArgs", "yumiGCValidateAllocationABI", "yumiGetProcessExitCode", "exit", "yumiInterruptRequestedFlags", "yumiGCEnterFFI", "yumiGCEnterZone", "yumiGCLeaveZone", "yumiArrayCopySlice", "yumiArrayCopySliceDescribed", "yumiArrayViewsReplace", "yumiArrayViewsInvalidate", "yumiArenaReserveDescribed", "yumiGCObjectSidePayload", "yumiGCClearObjectSidePayload", "yumiBatchStartIndex", "yumiBatchEndIndex", "yumiBatchTestStart", "yumiBatchTestFinish", "yumiActiveTaskQueueActivity", "yumiReleaseLazyGlobal", "yumiAbandonLazyGlobal", "yumiProbeTracing", "yumiCollect", "yumiGCCollect", "yumiGCScavenge", "yumiGCStartConcurrentMark", "yumiGCFinishConcurrentMark", "yumiGCFrameBudget", "yumiGCOwnerWeakLoad", "yumiGCRegisterOwnerWeak", "yumiGCReleaseOwnerWeak", "yumiGCAddRoot", "yumiGCRegisterCleanup", "yumiGCCancelCleanup", "yumiCollectionObserverActivate", "yumiCollectionObserverDeactivate", "yumiGCPublishObjectSidePayload", "yumiGCPublishCleanupObjectSidePayload", "yumiBenchTemporaryRootShim", "yumiStringMeasureDisplayWidth"]

+ code-running-names [String] = ["yumiRunEventLoop", "yumiGCDrainCleanups"]

━━━━━━━━━━━━━━━━━━━━
+ suspends-task Bool
    - name String

name.starts-with(task-suspending-prefix) || task-suspending-names.find(name) != null

━━━━━━━━━━━━━━━━━━━━
+ allocates Bool
    - name String

allocating-names.find(name) != null

━━━━━━━━━━━━━━━━━━━━
+ is-claimed Bool
    - name String

` Whether a C function is classified: one that suspends the task or waits for a task, one that
` allocates from the collector, one that runs code that may do either, or one that polls and does
` neither.
suspends-task(name) || waits-for-task(name) || allocates(name) || is-plain-polling || runs-code(name)
.. is-plain-polling = plain-polling-names.find(name) != null

━━━━━━━━━━━━━━━━━━━━
+ runs-code Bool
    - name String

code-running-names.find(name) != null

━━━━━━━━━━━━━━━━━━━━
+ waits-for-task Bool
    - name String

` Whether a C function waits for a task to end. It suspends the task, but is called as its
` declaration says, as one that may block, and not as one that suspends it.
task-waiting-names.find(name) != null

━━━━━━━━━━━━━━━━━━━━
+ may-suspend Bool
    - name String
    - polls Bool

` Whether a C function may suspend the task where a restriction forbids it: one that suspends it
` or waits for a task does. Any other that polls the collector can, so one that polls and is not
` classified is taken to.
suspends-task(name) || waits-for-task(name) || runs-code(name) || (polls && !is-claimed(name))

━━━━━━━━━━━━━━━━━━━━
+ may-allocate Bool
    - name String
    - polls Bool

` Whether a C function may allocate from the collector where a restriction forbids it. Only a
` function that polls the collector can, so one that polls and is not classified is taken to.
allocates(name) || runs-code(name) || (polls && !is-claimed(name))
