(type _ Assignments (facet-of Checker)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Styles)
  (sees Tables)
  (fn-do _ is-query-property Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether a property of a class is declared as a query of the markup its object is in, which
    ; the markup runtime keeps and nothing assigns.
    (if (or (!= (call (. types intrinsic-of) receiver) .class) (== (call property-named receiver name) null))
      (return false)
    )
    (let ref (call declaring-class types receiver name))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class class)
        (for (in member ([] (. owner member-pool) (. class members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-property property)
              (if (and (. property name) (== (. property name) name) (!= (. property type-syntax) 0))
                (return (!= (call query-type ref (. property type-syntax)) no-type))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-zone-store _
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param value TypeId)
    ; A GC-free zone stores no managed pointer anywhere but in a local of its own, which
    ; TypeScript reports where the assignment is: a property, a global or a captured local
    ; holds what the collector must be told of. A store of `null` holds nothing.
    (if (or outside-zone (call (. narrowing is-null-syntax) rhs) (not (call is-managed value 0)))
      (return)
    )
    (lazy outside-zone (== (/and/ (. frame surround effects) (. CompilationEffect gc-free)) 0))
    (let held false)
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (= held (or (!= (. resolution kind) .resolve-slot) (call (. frame is-captured) (. resolution slot))))
      )
      (case .node-get-expression
        (= held true)
      )
    )
    (if (not held)
      (return)
    )
    (let text
      (paragraph
        (str "storing a managed pointer is not allowed in a GC-free zone (entered at " (call (. frame zone-entry)) "); compute into a zone buffer and publish after the zone exits")
      )
    )
    (call (. frame diagnose) id .restricted (call (. program store-atom) text))
  )
  (fn-do + stored-interface-text String
    (param property PropertyDecl)
    ; The error of a property an interface declares to store: one with no value is a getter the
    ; types that are the interface answer, and one with a value a getter that gives it. A state
    ; machine, or one of its cases, belongs in the types that are the interface.
    (let shown
      (match ([] (. ([] (. program modules) module) decls) (. property owner))
        (case (call .decl-class class)
          (. class name text)
        )
        (default
          "?"
        )
      )
    )
    (let machine (and (!= (. property value) 0) (is ([] (. tree nodes) (. property value)) .node-state-machine)))
    (if (or machine (is ([] (. tree nodes) (. property syntax)) .node-state-case))
      (return
        (paragraph
          (str shown " is an interface, so it cannot hold a state machine; declare the machine in the classes that are " shown)
        )
      )
    )
    (let name (. (!! (. property name)) text))
    (let lead (str shown " is an interface, so it cannot store \"" name "\""))
    (if (!= (. property value) 0)
      (return (str lead "; declare a getter that gives the value, as in \"(fn-expr + " name " _ :get …)\""))
    )
    (if (== (. property type-syntax) 0)
      (return (str lead "; declare a getter for the types that are " shown " to answer"))
    )
    (let env (call (. types class-env) module (. property owner)))
    (let stated (call (. types evaluate-type) module tree (. property type-syntax) env))
    (call (. types env-release) env)
    (return
      (paragraph
        (str lead "; declare a getter for the types that are " shown " to answer, as in \"+ get " name " " (call type-source types stated) "\"")
      )
    )
  )
  (fn-expr _ assigns-early Bool
    (param lhs SyntaxId)
    (and (== (. resolution kind) .resolve-slot) (call precedes-declaration (. resolution slot)))
    (where
      (lazy resolution (call (. bindings resolution-of) (. frame binding) lhs))
    )
  )
  (fn-do _ stores-loop-constant Bool
    (param lhs SyntaxId)
    (param op Operator)
    (param target TypeId)
    (param value TypeId)
    (param rhs SyntaxId)
    ; Whether an assignment stores to the item of a loop that counts through its range itself,
    ; or to that loop's `it` or `each`. The loop gives them their value on each pass, and nothing
    ; else may. An assigning operator the type answers with a function of its own stores nothing.
    ; Whether the item of any other loop is a constant depends on how the loop is lowered.
    (let loop SyntaxId 0)
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (if (== (. resolution kind) .resolve-slot)
          (let row ([] (. bindings slots) (. resolution slot)))
          (if (== (. row kind) .slot-loop-item)
            (= loop (. ([] (. bindings scopes) (. row scope)) syntax))
            (else-if (or (== (. row kind) .slot-it) (== (. row kind) .slot-each))
              (= loop (. row syntax))
            )
          )
        )
      )
    )
    (if (or (== loop 0) (!= (call (. facts plan-of) instance loop) .plan-range-loop))
      (return false)
    )
    (return (or (== op .eq-op) (not (call (. calls has-operator) target (call (. program store-atom) (str op)) value (:arg-syntax rhs)))))
  )
  (fn-do + merge-assignments _
    (param condition SyntaxId)
    (param body SyntaxId)
    (param settled (list Narrowed))
    ; After an `if` without an else whose body falls through and leaves an optional local holding
    ; a present value, the local stays present when the condition's false branch narrows it the
    ; same way: both paths agree, as the reference's flow facts merge them. What the body leaves a
    ; local as is what the last of its assignments settled, so a match whose arms that fall through
    ; agree counts, and an assignment in a nested branch that may not run, which was widened back,
    ; does not. A local that holds a union stays known to hold the case both paths leave it as.
    (let seen (list NarrowingKey))
    (let position (. settled length))
    (while (!= position 0)
      (-= position 1)
      (let row ([] settled position))
      (if (or (call is-member-key (. row key)) (!= (call (. seen find) (. row key)) null))
        (continue)
      )
      (+= seen (. row key))
      (let slot (call key-slot (. row key)))
      (if (or (== (. row type) no-type) (== (. row type) (call slot-known slot)))
        (continue)
      )
      (let probe (. scratch narrowings mark))
      (call (. narrowing narrow-condition) condition false)
      (let narrowed (call (. frame key-type) (. row key)))
      (let cases (call (. frame narrowed-cases) (. row key)))
      (call (. frame pop-narrowing) probe)
      (if (== narrowed (. row type))
        (call (. frame push-assigned) (. row key) (. row type) (if-expr (== cases (. row cases)) cases 0))
      )
    )
  )
  (fn-do + check-branch-update _
    (param id SyntaxId)
    ; The function the action of a markup branch region runs: it reads the conditions again, where
    ; a member of the region's host read by its name alone is read from the host, kept where the
    ; region was made, as is the region, given to the markup runtime as the host's content. What
    ; the markup runtime raises leaves the function, and the callback that runs it, as the
    ; reference's does.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (let content (if-expr outer (. outer region content) no-type))
    (if (or (!= (. resolution kind) .resolve-slot) (== content no-type))
      (call decline id)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (+= content-blocks 0)
    (+= content-parents (call (. frame slot-type) (. resolution slot)))
    (call read-arms id)
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (call (. conversions convert) id id (call (. frame slot-type) (+ (. resolution slot) 1)) content .reason-argument)
    (let keeps (. (!! outer) region keeps))
    (if (or (and (!= keeps no-instance) (not (call raises-out id keeps))) (not (call raises-out id (. (!! outer) region select))))
      (call decline id)
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do + check-source-update _
    (param id SyntaxId)
    ; The function the action of a markup loop region runs: it reads the container again, where its
    ; read of a collection is no change the action follows and a member of the region's host read by
    ; its name alone is read from the host, kept where the region was made, and gives what it gives
    ; to the region, kept there too, by the markup runtime's replacer for the region's source, which
    ; hands it to the region's controller. What that raises leaves the function, and the callback that
    ; runs it, as the reference's does.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (let container SyntaxId 0)
    (match? ([] (. tree nodes) id)
      (case (call .node-for-block row)
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (= container (. loop container))
          )
        )
      )
    )
    (let expected (if-expr outer (. outer region source) no-type))
    (if (or (!= (. resolution kind) .resolve-slot) (== container 0) (== expected no-type))
      (call decline id)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (+= content-blocks 0)
    (+= content-parents (call (. frame slot-type) (. resolution slot)))
    (let read (call infer container (call (. (call Want) adding) .want-observed)))
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (let source (if-expr (!= read invalid-type) (. (call loop-source id container read) given) no-type))
    (let replace (if-expr outer (. outer region replace) no-instance))
    (if (or (!= source expected) (== replace no-instance) (not (call raises-out id replace)))
      (call decline id)
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do + assign-placed _
    (param slot SlotId)
    (param made TypeId)
    ; Gives the local declared for a markup element's name the element's object, in the function
    ; that declares it.
    (if (and outer (call (. frame is-captured) slot))
      (call (. outer assign-placed) slot made)
      (else
        (call (. frame assign) slot made)
      )
    )
  )
  (fn-do _ store-event Bool
    (param rhs SyntaxId)
    (param event NamedEvent)
    (param kept Bool)
    (param target TypeId)
    ; An event stored in a property, once the property is known: one whose `Broadcastable` the
    ; property is not is reported as `refuse-event-value` says, one stored in a property of that
    ; very `Broadcastable` is made that endpoint, as `escape-event` says, and any other, or one
    ; read in a function written in a markup element's body, has no shape here. Says whether the
    ; store goes on.
    (let endpoint (call endpoint-of event))
    (if (not (call takes-endpoint endpoint target))
      (call refuse-event-value rhs (. event owner) (. event name))
      (return false)
    )
    (if (or kept (!= target endpoint))
      (call decline rhs)
      (return false)
    )
    (call escape-event rhs event endpoint rhs)
    (return true)
  )
  (fn-do _ tuple-arity-at Bool
    (param object TypeId)
    (param key-syntax SyntaxId)
    ; Whether a constant index names the position just past a tuple's last field: assigning there
    ; gives a new tuple with one more field.
    (match? ([] (. types rows) object)
      (case (call .type-tuple row)
        (match? ([] (. tree nodes) key-syntax)
          (case (call .node-integer-syntax key)
            (let literal (call parse-integer-literal (. key value)))
            (return (and (not (. literal negative)) (not (. literal overflow)) (== (. literal value) (. row fields count))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ extended-tuple TypeId
    (param object TypeId)
    (param value TypeId)
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (match? ([] (. types rows) object)
      (case (call .type-tuple row)
        (for (in offset (..< 0 (. row fields count)))
          (call (. scratch names push) (call (. types index-atom) offset))
          (call (. scratch types push) (call (. types child-type) (. row fields) offset))
        )
      )
    )
    (call (. scratch names push) (call (. types index-atom) (- (. scratch types length) mark)))
    (call (. scratch types push) value)
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do + collect-assigned _
    (param id SyntaxId)
    (param assigned (list Atom))
    (param declared (list Atom))
    (match? ([] (. tree nodes) id)
      (case .node-function-syntax
        (return)
      )
      (case (call .node-for-block row)
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (if (. loop is-subscriber)
              (return)
            )
          )
        )
      )
      (case (call .node-declare row)
        (let name (call pattern-name types tree (. row left)))
        (if name
          (+= declared name)
        )
      )
      (case (call .node-assign row)
        (call collect-target (. row lhs) assigned)
        (call collect-assigned (. row rhs) assigned declared)
        (return)
      )
    )
    (for (in child (call (. tree children-of) id))
      (call collect-assigned child assigned declared)
    )
  )
  (fn-do _ collect-target _
    (param target SyntaxId)
    (param assigned (list Atom))
    (let name (call field-reference target))
    (if name
      (+= assigned name)
      (return)
    )
    (match? ([] (. tree nodes) target)
      (case (call .node-tuple-syntax row)
        (for (in item ([] (. tree children) (. row items)))
          (call collect-target item assigned)
        )
      )
    )
  )
  (fn-do + writes-value Bool
    (param fact TypeProperty)
    ; Whether the nearest class that declares a property writes a value for it.
    (let ref (call declaring-decl types fact))
    (let member (call valued-property program (. ref module) (. ref decl) (. fact name)))
    (if (== member 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
      (case (call .decl-property row)
        (return (!= (. row value) 0))
      )
    )
    (return false)
  )
  (fn-do _ forget-store-root Bool
    (param object SyntaxId)
    ; A store to a property of an object ends what the reference knows of every property of the
    ; name the object is read from through properties, and of every path from it, and it ends
    ; what it knows of every property of the receiver where that name is the receiver or one of
    ; its properties. What is known of a local itself the reference keeps. A store through a row of
    ; a table read in place (`answers-in-place`) ends what is known of every property, as the
    ; reference checks the table there and its failure makes calls. Answers whether the object is
    ; read from a local, the receiver or such a row, where the store ends just that.
    (let root object)
    (while (is ([] (. tree nodes) root) .node-get-expression)
      (match? ([] (. tree nodes) root)
        (case (call .node-get-expression row)
          (= root (. row object))
        )
      )
    )
    (match? ([] (. tree nodes) root)
      (case .node-index-expression
        (if (call (. facts answers-in-place) instance root)
          (call (. frame forget-members))
          (return true)
        )
      )
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) root))
        (if (== (. resolution kind) .resolve-member)
          (call (. frame forget-receiver))
          (return true)
        )
        (if (!= (. resolution kind) .resolve-slot)
          (return false)
        )
        (if (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this)
          (call (. frame forget-receiver))
          (return true)
        )
        (call (. frame forget-escaped) (call slot-key (. resolution slot)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + check-probe-assign _
    (param id SyntaxId)
    (param row ASTProbeAssign)
    ; A probe that assigns a property writes an event named `set-property`, of the object it is written
    ; of where it has one: the key, then the value. Its record is flushed at once.
    (let found (call probes-module id))
    (if (not found)
      (return)
    )
    (let probes found)
    (let object (call check-probe-object (. row object)))
    (if (== object invalid-type)
      (return)
    )
    (let head (if-expr (!= object no-type) "probe-object-event-head" "probe-event-head"))
    (if (or (not (call record-probe-head id probes head object)) (not (call record-probe-call id probes "probe-write" (list (. types string-type)))) (not (call check-probe-value id probes (. row content) false)))
      (return)
    )
    (call record-probe-flush id probes "probe-flush")
  )
  (fn-do _ refuses-machine-write Bool
    (param id SyntaxId)
    (param name Atom)
    (param resolution Resolution)
    ; Reports an assignment to a name of a state machine, which moves only by its transitions: the
    ; local or the property it is kept in, or the property that says whether one of its cases is
    ; active or holds what the case holds, and says whether it did.
    (if (== (. resolution kind) .resolve-member)
      (return (call writes-machine id (. frame self-type) name))
    )
    (if (== (. resolution kind) .resolve-global)
      (return (call writes-machine-property id (. resolution module) (. resolution decl) name))
    )
    (if (!= (. resolution kind) .resolve-slot)
      (return false)
    )
    (if (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-machine)
      (return (call machine-write id (str "\"" (. name text) "\" is a case of a state machine, which")))
    )
    (for (in row (. bindings machines))
      (if (and (!= (. row bound) no-slot) (== (. row bound) (. resolution slot)))
        (return (call machine-write id (str "State machine \"" (. name text) "\"")))
      )
    )
    (return false)
  )
  (fn-do _ writes-machine Bool
    (param id SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    ; Reports an assignment to a property of a class that is a state machine or one of its cases, as
    ; `refuses-machine-write` does, and says whether it did.
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) receiver)))
      (return false)
    )
    (let ref (call declaring-class types receiver name))
    (return (call writes-machine-property id (. ref module) (call owner-property program (. ref module) (. ref decl) name) name))
  )
  (fn-do _ writes-machine-property Bool
    (param id SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    ; Reports an assignment to a property that is a state machine or one of its cases, as
    ; `refuses-machine-write` does, and says whether it did.
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-property row)
        (if (!= (call (. ([] (. program modules) module) tree declared-machine) (. row value)) 0)
          (return (call machine-write id (str "State machine \"" (. name text) "\"")))
        )
        (if (or (!= (. row flag) 0) (!= (. row projection) 0))
          (return (call machine-write id (str "\"" (. name text) "\" is a case of a state machine, which")))
        )
      )
    )
    (return false)
  )
  (fn-do _ machine-write Bool
    (param id SyntaxId)
    (param subject String)
    ; Reports an assignment to a state machine or to one of its cases.
    (let text
      (paragraph
        (str subject " moves only by its transitions, so it cannot be assigned; add a transition that enters the case")
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) text))
    (return true)
  )
  (fn-do + infer-assign TypeId
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param want Want)
    (if (== op .bind-op)
      (let message
        (paragraph
          "\"<->\" binds a property of a markup element to a place, so it is written in the element's body; to store a value here, write \"=\""
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (match? ([] (. tree nodes) lhs)
      (case (call .node-tuple-syntax row)
        (if (== op .eq-op)
          (return (call infer-destructure lhs (. row items) rhs))
        )
      )
      (case .node-list-syntax
        (call infer rhs)
        (let text
          (paragraph
            "Names in a list pattern can be declared from a list, as in \"(let (list x y) items)\", but not assigned again; assign a tuple to them, as in \"(= (tuple x y) (tuple ([] items 0) ([] items 1)))\""
          )
        )
        (call (. frame diagnose) lhs .stated (call (. program store-atom) text))
        (return invalid-type)
      )
      (case .node-call-expression
        (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal assignment"))
        (return invalid-type)
      )
      (case (call .node-style-read-expression row)
        (return (call infer-style-write id op lhs row rhs))
      )
      (case (call .node-index-expression row)
        (let stored (call infer-index-assign lhs id op (. row object) (. row index) rhs (. row is-optional)))
        (return (call chain-stored lhs stored))
      )
      (case (call .node-get-expression row)
        (let stored
          (call infer-property-assign
            (block
              (arg id)
              (arg lhs)
              (arg op)
              (arg (. row object))
              (arg (. row name))
              (arg rhs)
              (arg (. row is-optional))
              (arg no-type)
              (arg want)
            )
          )
        )
        (return (call chain-stored lhs stored))
      )
      (case (call .node-identifier row)
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (if (call refuses-machine-write id (. row name) resolution)
          (return invalid-type)
        )
        (if (== (. resolution kind) .resolve-member)
          (return (call infer-property-assign id lhs op 0 (. row name) rhs false no-type want))
        )
        (if (and (== (. resolution kind) .resolve-function) module-accessor)
          (return (call infer-module-setter-assign id lhs op (. row name) rhs))
        )
        (lazy module-accessor (call names-module-accessor (. resolution module) (. resolution decl)))
        (if (== (. resolution kind) .resolve-function)
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg (call (. program store-atom) (str "Function \"" (. row name text) "\" cannot be assigned")))
            )
          )
          (return invalid-type)
        )
        (if (and (== (. resolution kind) .resolve-unresolved) styled)
          (return (call infer-self-style-assign id lhs op (. row name) rhs))
        )
        (lazy styled (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-styled)) 0))
        (if (call is-stack-local lhs)
          (let message (str "Stack-local variable '" (. row name text) "' can only be rebound with do with"))
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return invalid-type)
        )
        (if (call assigns-early lhs)
          (if (== op .eq-op)
            (call (. frame diagnose) id .stated (call (. program store-atom) "Variable not declared"))
            (else
              (call (. frame diagnose) lhs .stated (call (. program store-atom) "Name not found"))
            )
          )
          (return invalid-type)
        )
        (if (!= op .eq-op)
          (call (. facts set-node-type) instance lhs (call target-of lhs true))
          (let assigned (call (. bindings resolution-of) (. frame binding) lhs))
          (if (and (== (. assigned kind) .resolve-global) (call guards-read lhs (. assigned module) (. assigned decl)))
            (call note-guarded lhs (. assigned module) (. assigned decl))
          )
        )
        (call check-tracked-store id lhs)
      )
    )
    (let target (call target-of lhs (!= op .eq-op)))
    (if (== op .eq-op)
      (call expect-feeds rhs target)
    )
    (let primed (and (== op .eq-op) (call expect-arms rhs target)))
    (= arms-given no-type)
    (let written
      (match op
        (case= .eq-op
          (call infer-with-expected rhs target (call (. (call Want) escaping) target rhs))
        )
        (default
          (call infer rhs)
        )
      )
    )
    (let given (if-expr (and primed (!= arms-given no-type)) arms-given written))
    (if (or (== written invalid-type) (== target invalid-type))
      (return invalid-type)
    )
    (let value (call stored-value rhs written))
    (let withheld (!= value written))
    (if (call stores-loop-constant lhs op target value rhs)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal to update const variables"))
      (return invalid-type)
    )
    (call note-escape rhs)
    (if (and (== op .eq-op) (call (. tree is-identifier-syntax) lhs))
      (call (. calls note-context-cast) rhs target .cast-assignment)
    )
    (let result (call assign-into id lhs op target rhs value))
    (call check-zone-store id lhs rhs value)
    (if (not withheld)
      (call note-replacement id target (if-expr (== op .eq-op) value result))
    )
    (let key (call (. narrowing condition-slot) lhs))
    (if key
      (let slot (call key-slot key))
      (let settled (call slot-known slot))
      (let held U64)
      (if (and (== op .eq-op) withheld)
        (if (== (call (. frame slot-type) slot) (call assigned-narrowing settled value))
          (= settled (call (. frame slot-type) slot))
        )
        (else-if (== op .eq-op)
          (= held (call assigned-case settled given))
          (= settled (call assigned-narrowing settled given))
        )
        (else-if (not (and outer (call (. frame is-captured) slot)))
          (let current (call (. frame slot-type) slot))
          (if (and (!= current no-type) (!= current invalid-type))
            (= settled current)
          )
        )
      )
      (call (. frame push-assigned) key settled held)
      (call (. frame reset-paths) key)
      (call (. frame note-assignment) id slot settled)
    )
    (if (and withheld (== op .eq-op))
      (return (call infer lhs))
    )
    (return result)
  )
  (fn-do _ infer-module-setter-assign TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param op Operator)
    (param name Atom)
    (param rhs SyntaxId)
    (if (== op .eq-op)
      (let value (call infer rhs))
      (return-if invalid-type (if (== value invalid-type)))
      (return (call store-through-module-setter lhs name rhs value .call-setter))
    )
    (let target (call infer lhs))
    (return-if invalid-type (if (== target invalid-type)))
    (blank)
    (let value (call infer rhs))
    (return-if invalid-type (if (== value invalid-type)))
    (blank)
    (if (call updates-in-place target op value rhs)
      (call decline id)
      (return invalid-type)
    )
    (let result (call assign-into id lhs op target rhs value))
    (return-if invalid-type (if (== result invalid-type)))
    (blank)
    (if (== (call store-through-module-setter lhs name lhs target .call-store-setter) invalid-type)
      (return invalid-type)
    )
    (return result)
  )
  (fn-do _ store-through-module-setter TypeId
    (param lhs SyntaxId)
    (param name Atom)
    (param argument SyntaxId)
    (param value TypeId)
    (param form CallForm)
    (let diagnosed (. facts diagnostics length))
    (let set (call (. calls module-setter-call) lhs name argument value form))
    (if (== set invalid-type)
      (call (. facts restate)
        (block
          (arg diagnosed)
          (arg instance)
          (arg lhs)
          (arg .function-not-found)
          (arg .stated)
          (arg (call (. program store-atom) "Setter not found"))
        )
      )
    )
    (return set)
  )
  (fn-do _ reads-as-declared Bool
    (param rhs SyntaxId)
    (param target TypeId)
    ; Whether a value stored is a read of a property of a path a test narrowed, made to a place of
    ; the type the path declares the property as: the read is then taken as declared, which gives
    ; what the narrowed one would where the property holds what was tested, and what it gives where
    ; a store before it ended what is known, so it relies on nothing the flow knew.
    (match? ([] (. tree nodes) rhs)
      (case (call .node-get-expression row)
        (if (or (. row is-optional) (. row is-tracked))
          (return false)
        )
        (let base (call (. narrowing base-key) (. row object)))
        (if (not base)
          (return false)
        )
        (let key (call (. frame find-path-key) base (. row name)))
        (if (or (not key) (not (call is-path-key key)))
          (return false)
        )
        (let narrowed (call (. frame held-member) key))
        (if (or (== narrowed no-type) (!= (call (. facts node-type) instance rhs) narrowed))
          (return false)
        )
        (if (!= (call (. frame path-declared-type) key) target)
          (return false)
        )
        (call (. facts replace-node-type) instance rhs target)
        (-= (. frame member-reads) 1)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ chain-stored TypeId
    (param lhs SyntaxId)
    (param stored TypeId)
    ; What an assignment gives where the place assigned is a link of an optional chain: the
    ; optional of what the store gives, which holds nothing where the store was not made.
    (if (or (== stored invalid-type) (== stored no-type) (not (call optional-chained lhs)))
      (return stored)
    )
    (return (call (. types optional-of) stored))
  )
  (fn-do + assigned-narrowing TypeId
    (param declared TypeId)
    (param value TypeId)
    ; An optional local assigned a present value, or a union local assigned the value of one of
    ; its cases, reads as that value until the next assignment, as the reference's flow facts
    ; track it.
    (if (or (== value invalid-type) (== value no-type) (== declared invalid-type) (== declared no-type))
      (return declared)
    )
    (if (and (== (call (. types intrinsic-of) declared) .union) (!= (call (. types intrinsic-of) value) .union))
      (let wrap (call (. relations compare) value declared))
      (if (== (. wrap kind) .relation-wrap-cast)
        (let fact ([] (call (. types cases-of) declared) (. wrap case-index)))
        (if (and (not (. fact is-default)) (!= (. fact type) no-type))
          (return (. fact type))
        )
      )
      (return declared)
    )
    (if (or (not (call (. types is-optional) declared)) (call (. types is-optional) value) (== value (. types null-type)))
      (return declared)
    )
    (return (call (. types optional-inner) declared))
  )
  (fn-expr _ assigned-case U64
    (param declared TypeId)
    (param value TypeId)
    ; The one case a union local holds after it is assigned a value of that case, as a mask, or
    ; none where it reads as the union still.
    (case? (== (call assigned-narrowing declared value) declared)
      0
    )
    (case? (!= (call (. types intrinsic-of) declared) .union)
      0
    )
    (default
      (if-expr (< (. wrap case-index) 64) (/lshift/ 1u64 (. wrap case-index)) 0u64)
    )
    (where
      (lazy wrap (call (. relations compare) value declared))
    )
  )
  (fn-do _ infer-property-assign TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param op Operator)
    (param object-syntax SyntaxId)
    (param name Atom)
    (param rhs SyntaxId)
    (param is-optional Bool (= false))
    (param owner TypeId (= no-type))
    (param want Want (= (call Want)))
    ; What an assignment to a property gives as a value. A property named alone is the receiver's,
    ; or the `owner`'s where one is given, and gives the value assigned, as it was before the store
    ; converted it. A field of a tuple gives the new tuple,
    ; also by an assigning operator that assigns it (`updates-in-place`), which is not stored, and
    ; any other place, of an object, a struct, a row or a builder, gives what it then holds. A
    ; property written after `?` is that of what the optional before it holds, and the object of
    ; a property written after a link of an optional chain is what that link gives by itself. A
    ; store to a property some read tracks runs the actions that read it, which ends what is known
    ; of every property. One no read typed so far tracks is taken as running nothing where that
    ; matters, and the pass starts over knowing it tracked where a read typed later tracks it
    ; (`Panics.typed-late`). A narrowed read stored after such a store is taken as declared where
    ; that is what the place holds (`reads-as-declared`), and one in doubt that is stored any other
    ; way is declined. The object of an assignment that applies an operator is typed before the
    ; value, and that of a plain one after it, as the reference evaluates them, but before a case
    ; named by its symbol alone, which evaluates nothing, so that a state machine is found before
    ; the case is (`writes-machine`), and before arms, which take the type the property is declared
    ; as (`expect-arms`). An event stored is taken once the property is known, as `store-event`
    ; says.
    (let armed (and (== op .eq-op) (call (. tree is-arms-syntax) (call (. tree arms-value) rhs))))
    (let fed (and (== op .eq-op) (!= (call (. tree written-feeds) rhs) 0)))
    (let object-first
      (block
        (and (or (!= op .eq-op) (is ([] (. tree nodes) rhs) .node-symbol) armed fed) (!= object-syntax 0))
      )
    )
    (let early (if-expr object-first (call infer-found object-syntax) (call Found no-type)))
    (if (and object-first (== op .eq-op) (call writes-machine id (. early type) name))
      (return invalid-type)
    )
    (let own-receiver (if-expr (!= owner no-type) owner (. frame self-type)))
    (if armed
      (call expect-arms rhs (call stored-type (if-expr (!= object-syntax 0) (. early type) own-receiver) name))
    )
    (if fed
      (call expect-feeds rhs (call stored-type (if-expr (!= object-syntax 0) (. early type) own-receiver) name))
    )
    (let assigned (call infer-found rhs (if-expr (== op .eq-op) (call (. (call Want) adding) .want-store) (call Want))))
    (let value (call stored-value rhs (. assigned type)))
    (let doubted (. assigned doubted))
    (let stored (call found-event-of assigned))
    (let kept (. assigned kept))
    (let unqualified (== object-syntax 0))
    (let late (if-expr (or unqualified object-first) (call Found no-type) (call infer-found object-syntax)))
    (let receiver (if-expr unqualified own-receiver (if-expr object-first (. early type) (. late type))))
    (let own (if-expr object-first (. early link) (. late link)))
    (if (or (== value invalid-type) (== receiver invalid-type) (== receiver no-type))
      (return invalid-type)
    )
    (let form (if-expr is-optional (call note-chain lhs lhs receiver) (. ChainForm chain-plain)))
    (if (or (== form .chain-absent) (and (!= object-syntax 0) (call absent-after object-syntax receiver)))
      (return value)
    )
    (let optional (== form .chain-tested))
    (if optional
      (= receiver (call (. types optional-inner) receiver))
      (else-if (and (!= object-syntax 0) (call (. types is-optional) receiver) (call optional-chained object-syntax))
        (= receiver (call link-receiver object-syntax receiver own false))
        (call (. facts set-node-type) instance object-syntax receiver)
      )
    )
    (if (and (!= object-syntax 0) (call refuses-write lhs receiver false))
      (return invalid-type)
    )
    (if (and (!= object-syntax 0) (call writes-machine id receiver name))
      (return invalid-type)
    )
    (let sets-length (and (== name (!! (. types length-atom))) (not (call property-named receiver name))))
    (if (and (!= object-syntax 0) (== op .eq-op) (call refuses-layout id lhs object-syntax receiver name rhs want))
      (return invalid-type)
    )
    (let added (call sets-added receiver name value rhs))
    (if (and (or doubted stored) (or (call is-accessor receiver name) added (call forwards-setter receiver name)))
      (call decline rhs)
      (return invalid-type)
    )
    (if (and (== op .eq-op) (or (call is-accessor receiver name) added))
      (return (call store-through-setter lhs object-syntax receiver name rhs value .call-setter))
    )
    (if (and (== op .eq-op) (call forwards-setter receiver name))
      (let site (if-expr (!= object-syntax 0) object-syntax lhs))
      (let sent no-type)
      (let cased (. facts calls length))
      (for (in index (..< 0 (. (call (. types cases-of) receiver) length)))
        (let payload (. ([] (call (. types cases-of) receiver) index) type))
        (= sent (call (. calls setter-call) lhs site payload name rhs value))
        (if (== sent invalid-type)
          (return invalid-type)
        )
      )
      (call (. facts name-roles-since) instance lhs cased .role-case)
      (call (. facts set-plan) instance lhs .plan-forward)
      (call (. facts note-forward) instance lhs sent rhs)
      (return sent)
    )
    (if (call is-batch-flush receiver)
      (let (tuple domain below) (call accessor-domain (. name text)))
      (let flag (and (!= (. domain length) 0) (not below)))
      (let message
        (block
          (case? flag
            "Markup batch flush domain flags are immutable"
          )
          (default
            "Markup batch flush summaries are immutable"
          )
        )
      )
      (call (. frame diagnose) lhs .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (and (== op .eq-op) (call is-query-property receiver name))
      (call (. frame diagnose)
        (block
          (arg lhs)
          (arg .stated)
          (arg (call (. program store-atom) "Markup query properties are compiler-managed and cannot be assigned"))
        )
      )
      (return invalid-type)
    )
    (if (!= object-syntax 0)
      (let styled (call infer-style-assign id lhs receiver name op rhs value))
      (if (and styled (or doubted stored))
        (call decline rhs)
        (return invalid-type)
      )
      (if styled
        (return styled)
      )
    )
    (= assigns-plainly (== op .eq-op))
    (let target
      (block
        (. (call read-property lhs (if-expr (!= object-syntax 0) object-syntax lhs) receiver name) type)
      )
    )
    (= assigns-plainly false)
    (if (== target invalid-type)
      (return invalid-type)
    )
    (if (and stored (not (call store-event rhs stored kept target)))
      (return invalid-type)
    )
    (if (and (== op .eq-op) (call reads-as-declared rhs target))
      (= value target)
      (else-if doubted
        (call decline rhs)
        (return invalid-type)
      )
    )
    (call check-zone-store id lhs rhs value)
    (if (and (== op .eq-op) (!= (call (. tree symbol-of) rhs) null))
      (= value (call infer-with-expected rhs target))
    )
    (let written (call (. panics property-of) receiver name))
    (if written
      (call (. panics note-write) instance written)
    )
    (call (. facts set-node-type) instance lhs (if-expr (and (== op .eq-op) (== object-syntax 0)) value target))
    (call note-escape rhs)
    (if (== object-syntax 0)
      (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
      (if (== (. resolution kind) .resolve-member)
        (call (. frame push-assigned) (call member-key (. resolution module) (. resolution decl)) target)
        (call (. frame reset-paths) (call member-key (. resolution module) (. resolution decl)))
      )
      (else
        (let shared (call (. narrowing receiver-member) object-syntax name))
        (let base (call (. narrowing base-key) object-syntax))
        (if shared
          (call (. frame push-assigned) shared target)
          (call (. frame reset-paths) shared)
          (else-if base
            (let key (call (. frame find-path-key) base name))
            (if key
              (call (. frame push-assigned) key target)
              (call (. frame reset-paths) key)
            )
          )
        )
      )
    )
    (let result (call assign-into id lhs op target rhs value))
    (if (and compound-result sets (not (call updates-in-place target op value rhs)))
      (return-if invalid-type (if (== (call store-through-setter lhs object-syntax receiver name lhs target .call-store-setter) invalid-type)))
    )
    (lazy compound-result (and (!= op .eq-op) (!= result invalid-type)))
    (lazy sets (or (call is-accessor receiver name) (call sets-added receiver name target lhs)))
    (call note-replacement id target (if-expr (== op .eq-op) value result))
    (if (and (!= object-syntax 0) (not (call (. facts is-replacing) instance id)) (call forget-store-root object-syntax))
      (= settled-store id)
    )
    (if (and written (call (. frame knows-properties)))
      (if (call (. panics is-tracked-property) written)
        (call (. frame forget-members))
        (else
          (call (. frame note-unsure-store) (as (. unsure-stores length) U32))
          (+= unsure-stores (call (. panics assume-untracked) instance id written))
          (+= unsure-reads (. frame member-reads))
        )
      )
    )
    (if (and (!= object-syntax 0) (!= op .eq-op) (not sets-length) (not (call is-row-cursor object-syntax)))
      (if (and (!= result invalid-type) (not (call updates-in-place target op value rhs)))
        (if (call refuses-layout id lhs object-syntax receiver name rhs want)
          (return invalid-type)
        )
        (let updated (call replaced-tuple id object-syntax receiver name rhs))
        (return-if updated (if (!= updated no-type)))
      )
    )
    (if (!= op .eq-op)
      (return result)
    )
    (if (== object-syntax 0)
      (return value)
    )
    (if (call is-row-cursor object-syntax)
      (return target)
    )
    (let replaced (call replaced-tuple id object-syntax receiver name rhs))
    (if (!= replaced no-type)
      (return replaced)
    )
    (let kind (call (. types intrinsic-of) receiver))
    (let plain (or (call (. types is-plain-tuple) receiver) (and (== kind .tuple) (== (call view-kind receiver) 0))))
    (return (if-expr plain no-type target))
  )
  (fn-do _ store-through-setter TypeId
    (param lhs SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param argument SyntaxId)
    (param value TypeId)
    (param form CallForm)
    ; A value stored in a property its setter answers: by an assignment, or by an assigning operator
    ; that stores the value it makes through the setter (`call-store-setter`).
    (let found (call property-named receiver name))
    (if (and found (call is-hidden ([] (. types properties) found) name .setter-decl))
      (let message (call privacy-message ([] (. types properties) found) name .setter-decl))
      (call (. frame diagnose) lhs .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let diagnosed (. facts diagnostics length))
    (let site (if-expr (!= object-syntax 0) object-syntax lhs))
    (let set (call (. calls setter-call) lhs site receiver name argument value form))
    (if (== set invalid-type)
      (call (. facts restate)
        (block
          (arg diagnosed)
          (arg instance)
          (arg lhs)
          (arg .function-not-found)
          (arg .stated)
          (arg (call (. program store-atom) "Setter not found"))
        )
      )
    )
    (return set)
  )
  (fn-do _ updates-in-place Bool
    (param target TypeId)
    (param op Operator)
    (param value TypeId)
    (param rhs SyntaxId)
    ; Whether an assigning operator changes what a place holds without assigning the place: a
    ; function of its own name on a type that is not a struct or a tuple, as the reference's
    ; `increment` calls it and stores nothing.
    (let held (call (. types intrinsic-of) target))
    (if (or (== held .struct) (== held .tuple))
      (return false)
    )
    (return (call (. calls has-operator) target (call (. program store-atom) (str op)) value (:arg-syntax rhs)))
  )
  (fn-do _ replaced-tuple TypeId
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param rhs SyntaxId)
    ; What an assignment to a field of a tuple gives: a new tuple of the same type, or of its
    ; first fields when it is the length that is assigned, where the tuple declares no `length`
    ; of its own. An assignment to any other place gives nothing here.
    (if (== object-syntax 0)
      (return no-type)
    )
    (let kind (call (. types intrinsic-of) receiver))
    (if (and (not (call (. types is-plain-tuple) receiver)) (or (!= kind .tuple) (!= (call view-kind receiver) 0)))
      (return no-type)
    )
    (if (and (== name (!! (. types length-atom))) (not (call property-named receiver name)))
      (return (call truncated-tuple id receiver rhs))
    )
    (let field (call property-named receiver name))
    (if (or (not field) (!= (. ([] (. types properties) field) storage-kind) .storage-eager))
      (return no-type)
    )
    (return receiver)
  )
  (fn-do _ truncated-tuple TypeId
    (param id SyntaxId)
    (param receiver TypeId)
    (param rhs SyntaxId)
    ; The tuple of the first fields of a tuple, as many as a constant says. A count written
    ; below zero has no plan.
    (let count U64 (. U64 max))
    (let counted true)
    (match? ([] (. tree nodes) rhs)
      (case (call .node-integer-syntax row)
        (let literal (call parse-integer-literal (. row value)))
        (= count (. literal value))
        (= counted (and (not (. literal negative)) (not (. literal overflow))))
      )
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (match? ([] (. types rows) receiver)
      (case (call .type-tuple row)
        (if (> count (as (. row fields count) U64))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal to increase tuple length"))
          (return invalid-type)
        )
        (let kept (as count U32))
        (for (in offset (..< 0 kept))
          (call (. scratch names push) (call (. types index-atom) offset))
          (call (. scratch types push) (call (. types child-type) (. row fields) offset))
        )
        (if counted
          (call (. facts set-plan) instance id .plan-truncate)
        )
        (return (call (. types intern-tuple) mark names-mark))
      )
    )
    (return no-type)
  )
  (fn-do _ refuses-layout Bool
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param rhs SyntaxId)
    (param want Want)
    ; A tuple is a value: assigning one of its fields, by `=` or by an assigning operator that
    ; assigns it (`updates-in-place`), gives a new tuple, which a statement that does nothing with
    ; it loses, and its length changes only to a constant. A struct's layout does not change at all. A `length` the type declares is a
    ; field like any other. As the reference has it, a statement loses the tuple in a `do`
    ; function or a module's main, and in the body of another function only as one of its own
    ; statements (`want-quasi`): the value of an arm or a block inside gives the tuple. A struct's
    ; field is changed in place, which loses the change where nothing holds the struct: a struct
    ; cast to its base, which is a copy, or one a call gives.
    (let kind (call (. types intrinsic-of) receiver))
    (let plain (or (call (. types is-plain-tuple) receiver) (and (== kind .tuple) (== (call view-kind receiver) 0))))
    (if (and (== name (!! (. types length-atom))) (not (call property-named receiver name)))
      (if (== kind .struct)
        (call (. frame diagnose) lhs .stated (call (. program store-atom) "Struct layout cannot be changed"))
        (return true)
      )
      (if (and plain (not (call (. tree is-integer-literal) rhs)))
        (call (. frame diagnose) lhs .stated (call (. program store-atom) "Value has no constant form"))
        (return true)
      )
      (return false)
    )
    (if (and (== kind .struct) (not (call (. tree holds-struct) object-syntax)))
      (let stored (call property-named receiver name))
      (if (and stored (== (. ([] (. types properties) stored) storage-kind) .storage-eager))
        (let shown (call type-display types receiver))
        (let message
          (paragraph
            (str "Assigning " (. name text) " changes a " shown " struct that nothing holds, so the change is lost; assign " (. name text) " where the struct is held")
          )
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) message) receiver)
        (return true)
      )
    )
    (if (or (not plain) (not (call (. want asks) .want-statement)) (call is-row-cursor object-syntax))
      (return false)
    )
    (if (and (not (call (. want asks) .want-quasi)) (not (. frame declaration is-imperative)) (not (. frame declaration is-main)))
      (return false)
    )
    (let field (call property-named receiver name))
    (if (or (not field) (!= (. ([] (. types properties) field) storage-kind) .storage-eager))
      (return false)
    )
    (let owner (call description-of tree object-syntax))
    (let shown (call type-display types receiver))
    (let message (str "Assigning " (. name text) " creates a new " shown " tuple that is discarded; "))
    (++= message (str "write " owner " = " owner "." (. name text) " = value"))
    (call (. frame diagnose) id .stated (call (. program store-atom) message) receiver)
    (return true)
  )
  (fn-expr _ is-row-cursor Bool
    (param object-syntax SyntaxId)
    ; Whether a name stands for the case of a table row a pattern matched: a place in the table,
    ; which a field assignment writes through.
    (and (!= object-syntax 0) (!= (call row-capture-of object-syntax) null))
  )
  (fn-do _ sets-added Bool
    (param receiver TypeId)
    (param name Atom)
    (param value TypeId)
    (param rhs SyntaxId)
    ; Whether a setter that an extension or a facet adds takes a value stored to a name the class has
    ; no property of.
    (return-if false (if (or (!= (call property-named receiver name) null) (!= (call (. types intrinsic-of) receiver) .class))))
    (return (call (. calls has-setter) receiver name value rhs))
  )
  (fn-do _ stored-type TypeId
    (param receiver TypeId)
    (param name Atom)
    (return-if no-type (if (or (== receiver no-type) (== receiver invalid-type))))
    (blank)
    (let found (call property-named receiver name))
    (return-if no-type (if (not found)))
    (return
      (block
        (case? (== (. ([] (. types properties) found) storage-kind) .storage-getter)
          no-type
        )
        (default
          (. ([] (. types properties) found) type)
        )
      )
    )
  )
  (fn-do _ forwards-setter Bool
    (param receiver TypeId)
    (param name Atom)
    ; A union whose every case sets a member through a setter sets it through each case's own.
    (if (not (call (. calls forwards-to-cases) receiver))
      (return false)
    )
    (for (in fact (call (. types cases-of) receiver))
      (if (not (call is-accessor (. fact type) name))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ refuses-write Bool
    (param id SyntaxId)
    (param target TypeId)
    (param indexed Bool)
    ; Reports a store through a value that only reads: an immutable table and its rows, spans and
    ; fields, a constant array, an immutable array's elements, and an array view with read access.
    (let message (call read-only-message target indexed))
    (if (== (. message length) 0)
      (return false)
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ read-only-message String
    (param target TypeId)
    (param indexed Bool)
    (let kind (call (. types intrinsic-of) target))
    (if (== kind .immutable-table)
      (return "ImmutableTable is read-only")
    )
    (if (== kind .immutable-table-row)
      (return "ImmutableTableRow is read-only")
    )
    (if (== kind .immutable-table-span)
      (return "ImmutableTableSpan is read-only")
    )
    (if (== kind .immutable-table-column)
      (return "ImmutableTableField is read-only")
    )
    (if (and indexed (call is-const-array target))
      (return "ConstArray values are read-only")
    )
    (if (!= kind .tuple)
      (return "")
    )
    (if (and indexed (!= (call (. types ancestor-of) target (. types immutable-array-decl)) no-type))
      (return "ImmutableArray does not support element assignment")
    )
    (for (in view (list (. types array-row-decl) (. types array-row-range-decl) (. types array-field-decl)))
      (let found (call (. types ancestor-of) target view))
      (if (!= found no-type)
        (match? ([] (. types rows) found)
          (case (call .type-class row)
            (if (and (== (. row args count) 2) (== (call (. types child-type) (. row args) 1) (. types array-read-access)))
              (return "Cannot write through a read-only array view")
            )
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ assign-into TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param op Operator)
    (param target TypeId)
    (param rhs SyntaxId)
    (param value TypeId)
    (param in-place Bool (= false))
    ; `in-place` says the node is itself the place assigned, a field of a struct named by an
    ; index, so an assigning operator is planned at it as it is at an assignment. The value of
    ; an assignment is what was assigned, or what the function of an assigning operator answers.
    ; A struct and a tuple are values, so what such a function answers for one is assigned to the
    ; place, as the reference assigns it: the value is then what the place holds, but for a local
    ; or a global, where it is the answer. A function of its own name answers before any rule for
    ; numbers does.
    (if (== op .eq-op)
      (call (. conversions convert) id rhs value target .reason-assignment)
      (return value)
    )
    (let token (call (. program store-atom) (str op)))
    (if (and (== op .add-eq-op) (call (. types is-plain-tuple) target))
      (let extended (call extended-tuple target value))
      (call (. facts set-node-type) instance id extended)
      (call (. facts set-plan) instance id .plan-extend)
      (return extended)
    )
    (let stepped (call increment-base op))
    (if (and stepped (!= stepped .pow-op) (!= stepped .concat-op))
      (call (. calls note-operand-suffix) rhs lhs target)
    )
    (let given (call (. conversions adapted-literal) rhs value target))
    (let numeric (and (call is-numeric types target) (call is-numeric types given)))
    (if (and numeric (not (call (. calls has-operator) target token given)))
      (let promoted (call promote types target given))
      (let base (call increment-base op))
      (if (and (or (!= lhs id) in-place) (or (== base .multiply-op) (== base .divide-op)))
        (let scaling (call scaling-of (== base .multiply-op) target given))
        (if (call scales-into scaling target)
          (call plan-scaling id lhs target rhs given scaling)
          (return target)
        )
        (if (and (!= (call unit-root types target) no-type) (or (== base .multiply-op) (and (!= target given) (not (call (. types unit-families same-family) target given)))))
          (let product (call product-of (== base .multiply-op) target given))
          (if (!= (. product problem) "")
            (call (. frame diagnose) rhs .stated (call (. program store-atom) (. product problem)))
            (return invalid-type)
          )
          (if (. product applies)
            (if (and (== (. product result) target) (call keeps-scaled target))
              (call plan-product id lhs target rhs given product)
              (return target)
            )
            (let shown (if-expr (== (. product result) no-type) "a plain number" (call type-short-name types (. product result))))
            (let message (str (if-expr (== base .multiply-op) "Multiplying " "Dividing ") (call type-short-name types target) " by " (call type-short-name types given) " gives " shown ", which a place of " (call type-short-name types target) " cannot hold"))
            (call (. frame diagnose) rhs .stated (call (. program store-atom) message))
            (return invalid-type)
          )
        )
      )
      (if (and (or (!= lhs id) in-place) base (!= base .pow-op))
        (let unit (call unit-arithmetic-type types target given false false (or (== base .multiply-op) (== base .divide-op))))
        (if (== unit invalid-type)
          (call (. frame diagnose) rhs .illegal-cast null given target)
          (return invalid-type)
        )
        (call plan-arithmetic id lhs target rhs given unit promoted)
        (if (!= unit no-type)
          (return target)
        )
      )
      (if (and (or (!= lhs id) in-place) base (== base .pow-op))
        (let raised (call infer-binary-values id base lhs target rhs given))
        (if (!= raised invalid-type)
          (call (. conversions convert) id id raised target .reason-assignment)
        )
        (return target)
      )
      (if (!= promoted target)
        (call (. conversions convert) id id promoted target .reason-assignment true (== given target))
        (if (or (== lhs id) (call (. tree is-identifier-syntax) lhs))
          (call (. facts set-node-type) instance id promoted)
          (return promoted)
        )
        (else-if in-place
          (call (. facts set-node-type) instance id target)
        )
      )
      (return target)
    )
    (let result invalid-type)
    (let diagnosed (. facts diagnostics length))
    (let answers true)
    (let stores false)
    (if (call (. calls has-operator) target token value (:arg-syntax rhs))
      (= result (call (. calls operator-call) lhs target token rhs value))
      (let held (call (. types intrinsic-of) target))
      (= stores (and (!= result invalid-type) (or (== held .struct) (== held .tuple))))
      (else
        (let base (call increment-base op))
        (if base
          (= answers false)
          (= result (call infer-binary-values id base lhs target rhs value))
          (if (!= result invalid-type)
            (call (. conversions convert) id id result target .reason-assignment)
          )
          (else
            (= result (call (. calls operator-call) lhs target token rhs value))
          )
        )
      )
    )
    (if (and (== result invalid-type) (== (call (. types intrinsic-of) target) .struct))
      (call (. facts restate) diagnosed instance id .illegal-operation .function-not-found)
    )
    (call (. facts set-node-type) instance id result)
    (if (and answers (!= result invalid-type))
      (call place-given id rhs value)
    )
    (if stores
      (call (. facts set-plan) instance id .plan-store-answer)
      (call (. conversions convert) id id result target .reason-assignment)
      (return (if-expr (call names-variable lhs) result target))
    )
    (return (if-expr (and answers (!= result invalid-type)) result target))
  )
  (fn-do _ place-given _
    (param statement SyntaxId)
    (param written SyntaxId)
    (param closure TypeId)
    ; Says where the reference places the function a closure runs as a value of a function type
    ; once the function that answers an assigning operator is given it: where the closure's
    ; value is made. That is the statement for a closure written in a loop of its function,
    ; whose turn holds it, and the line below the closure for any other.
    (if (or (== closure no-type) (== closure invalid-type) (!= (call (. types intrinsic-of) closure) .closure))
      (return)
    )
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (!= (. nested syntax) written)
        (continue)
      )
      (let scope (. ([] (. bindings scopes) (. nested scope)) parent))
      (let looped false)
      (while (and (!= (. ([] (. bindings scopes) scope) kind) .scope-function) (!= (. ([] (. bindings scopes) scope) kind) .scope-nested))
        (= looped (or looped (== (. ([] (. bindings scopes) scope) kind) .scope-loop)))
        (= scope (. ([] (. bindings scopes) scope) parent))
      )
      (call (. types place-closure) closure (if-expr looped statement written) (not looped))
      (return)
    )
  )
  (fn-expr _ names-variable Bool
    (param id SyntaxId)
    ; Whether an expression is the name of a local or of a global.
    (case? (not (call (. tree is-identifier-syntax) id))
      false
    )
    (default
      (or (== kind .resolve-slot) (== kind .resolve-global))
    )
    (where
      (lazy kind (. (call (. bindings resolution-of) (. frame binding) id) kind))
    )
  )
  (fn-do _ infer-destructure TypeId
    (param lhs SyntaxId)
    (param items (of RowRange SyntaxId))
    (param rhs SyntaxId)
    (let value (call infer rhs))
    (if (== value invalid-type)
      (return invalid-type)
    )
    (call (. facts set-node-type) instance lhs value)
    (call (. types complete) value)
    (let arity (call tuple-arity value))
    (if (== arity (. U32 max))
      (call (. frame diagnose) lhs .stated (call (. program store-atom) "Tuple expected"))
      (return invalid-type)
    )
    (if (!= (. items count) arity)
      (call (. frame diagnose) lhs .stated (call (. program store-atom) "Tuple sizes don't match"))
      (return invalid-type)
    )
    (let position 0u32)
    (for (in item ([] (. tree children) items))
      (if (< position arity)
        (let field (call field-of value position))
        (match? ([] (. tree nodes) item)
          (case .node-identifier
            (let resolution (call (. bindings resolution-of) (. frame binding) item))
            (if (== (. resolution kind) .resolve-slot)
              (call (. frame assign)
                (block
                  (arg (. resolution slot))
                  (arg (call assigned-part item (call (. tree written-part) rhs position) field))
                )
              )
            )
          )
        )
      )
      (+= position 1)
    )
    (return value)
  )
  (fn-do _ assigned-part TypeId
    (param item SyntaxId)
    (param written SyntaxId)
    (param field TypeId)
    ; What a local a tuple is taken apart into holds of a field: the field converted to the local's
    ; type at the local's name, as an assignment converts it, and then the field itself, or the
    ; local's type where both are numbers.
    (let target (call target-of item))
    (return-if field (if (or (== target field) (== target no-type) (== target invalid-type))))
    (blank)
    (if (== (call (. conversions convert) item written field target .reason-assignment) invalid-type)
      (return target)
    )
    (return (if-expr (and (call is-numeric types field) (call is-numeric types target)) target field))
  )
  (fn-do _ infer-index-assign TypeId
    (param id SyntaxId)
    (param assignment SyntaxId)
    (param op Operator)
    (param object-syntax SyntaxId)
    (param key-syntax SyntaxId)
    (param rhs SyntaxId)
    (param is-optional Bool)
    ; An index assigned. An assigning operator reads the item by `[]` and gives the value its
    ; operator makes to `[]=`, but where the item holds no struct or tuple and a function of the
    ; operator's own name answers it, as the reference compiles it for an object: that function is
    ; called on the item, and nothing is stored (`plan-answer-item`). An item past a pointer is
    ; read and stored by its plan, and the operator is planned at the assignment, as for a field.
    ; A text's item assigned gives a new text, stored where the text is held, so one written where
    ; nothing holds it, as a literal or what a call gives, is an error.
    (let value (call stored-value rhs (call infer rhs)))
    (let noted (. facts diagnostics length))
    (let object-found (call infer-found object-syntax))
    (let object (. object-found type))
    (let own (. object-found link))
    (if (== object invalid-type)
      (call (. facts resite) noted instance object-syntax id)
    )
    (let key (call infer key-syntax))
    (if (or (== object invalid-type) (== key invalid-type) (== value invalid-type))
      (return invalid-type)
    )
    (let form (if-expr is-optional (call note-chain id id object) (. ChainForm chain-plain)))
    (if (or (== form .chain-absent) (call absent-after object-syntax object))
      (return value)
    )
    (let optional (== form .chain-tested))
    (= object (call link-receiver object-syntax object own optional))
    (if (call refuses-write id object true)
      (return invalid-type)
    )
    (if (and (== object (. types string-type)) (not (call (. tree holds-text) object-syntax)))
      (let message
        (paragraph
          "Assigning an item of a text makes a new text, and nothing holds this one, so the change is lost; assign the item of a text a name holds"
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let pointee (call cpointer-item object))
    (if (== pointee (. types void-type))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Void has no physical address"))
      (return invalid-type)
    )
    (if (!= pointee no-type)
      (call (. facts set-plan) instance id .plan-item)
      (if (!= op .eq-op)
        (call (. facts set-node-type) instance id pointee)
        (return (call assign-into assignment id op pointee rhs value))
      )
      (call (. conversions convert) id rhs value pointee .reason-assignment)
      (return pointee)
    )
    (if (and (== op .eq-op) (call tuple-arity-at object key-syntax))
      (call note-field id object key-syntax)
      (return (call extended-tuple object value))
    )
    (let cell (call view-index object key-syntax true))
    (if (== cell no-type)
      (= cell (call aggregate-field object key-syntax key (!! (. types index-assign-atom)) value))
      (if (!= cell no-type)
        (call note-field id object key-syntax)
        (let held (call (. types intrinsic-of) object))
        (let stored (call assign-into id id op cell rhs value (== held .struct)))
        (if (and (== op .eq-op) (== held .struct))
          (return cell)
        )
        (return (if-expr (and (== op .eq-op) (== held .tuple)) object stored))
      )
    )
    (if (!= cell no-type)
      (call plan-view id (call eager-slot (call row-struct-of object) key-syntax))
      (return (call assign-into id id op cell rhs value))
    )
    (if (and (== op .eq-op) (call is-range-type key) (!= (call view-kind object) 0))
      (let same-item (== (call row-struct-of object) (call row-struct-of value)))
      (if (or (!= (call view-kind value) (call view-kind object)) (not same-item))
        (let message "Array view range assignment requires a compatible view")
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
        (return invalid-type)
      )
      (call plan-view id)
      (if (not (call note-view-range id object-syntax object key-syntax key))
        (return invalid-type)
      )
      (return (. types void-type))
    )
    (if (and (== op .eq-op) (!= (call view-kind object) 0))
      (call plan-view id)
      (call (. conversions convert) key-syntax key-syntax key (. types index-type) .reason-argument)
      (return (call assign-into id id op (call row-struct-of object) rhs value))
    )
    (let is-array (and (call is-array-type object) (not (call is-range-type key))))
    (let diagnosed (. facts diagnostics length))
    (if (!= op .eq-op)
      (let current (call (. calls operator-call) id object (!! (. types index-op-atom)) key-syntax key (:role (. CallRole role-item))))
      (if (== current invalid-type)
        (call restate-index diagnosed id object key-syntax)
        (return invalid-type)
      )
      (let held (call (. types intrinsic-of) current))
      (let alone (and (!= held .struct) (!= held .tuple) (call (. calls has-operator) current (call (. program store-atom) (str op)) value (:arg-syntax rhs))))
      (if alone
        (call (. facts set-node-type) instance id current)
        (call (. facts set-plan) instance id .plan-answer-item)
      )
      (let updated (call assign-into id id op current rhs value true))
      (if alone
        (return updated)
      )
      (return (call (. calls index-assign-call) id object key-syntax key rhs current is-array))
    )
    (let literal (call (. tree is-integer-literal) rhs))
    (let first-call FactId (as (. facts calls length) FactId))
    (let stored (call (. calls index-assign-call) id object key-syntax key rhs value is-array literal))
    (if (and (!= stored invalid-type) array-item (< first-call (. facts calls length)))
      (let store ([] (. facts calls) first-call))
      (if (and (== (. store syntax) id) (!= (. store callee) no-instance) two-args)
        (call (. calls note-replaced-read) id object (call (. instances argument-type) (. store callee) 0))
      )
      (lazy two-args (== (. ([] (. instances signatures) (. store callee)) args count) 2))
    )
    (lazy array-item (and (call is-array-value value) (not (call is-range-type key))))
    (if (and (!= stored invalid-type) (not optional) is-array own-call stores-item)
      (call (. facts set-plan) instance id .plan-array-item)
    )
    (lazy own-call (and (< first-call (. facts calls length)) (== (. ([] (. facts calls) first-call) syntax) id)))
    (lazy stores-item (call (. calls stores-array-item) (. ([] (. facts calls) first-call) callee)))
    (if (== stored invalid-type)
      (call restate-index diagnosed id object key-syntax)
      (else-if (not optional)
        (call store-through id object-syntax object)
      )
    )
    (if (and (!= stored invalid-type) (< first-call (. facts calls length)) stores-row)
      (call plan-table id .table-store)
      (else-if (and (!= stored invalid-type) (== (call (. types intrinsic-of) object) .table-column) (not (call is-range-type key)))
        (call plan-table id .table-item-store)
      )
      (else-if (and (!= stored invalid-type) (call is-range-type key) (call copies-range object value))
        (if (not (call note-view-range id object-syntax object key-syntax key))
          (return invalid-type)
        )
        (call plan-table id .table-range-store)
      )
    )
    (lazy stores-row (call stores-table-row object (. ([] (. facts calls) first-call) callee)))
    (return stored)
  )
  (fn-expr _ stores-table-row Bool
    (param object TypeId)
    (param callee InstanceId)
    ; Whether an index assigned of a table or a span of one stores a row at a single index, which
    ; TypeScript answers itself.
    (case? (or (and (!= kind .table) (!= kind .table-span)) (== callee no-instance))
      false
    )
    (default
      (and takes-two (== (call (. instances argument-type) callee 0) (. types index-type)))
    )
    (where
      (lazy kind (call (. types intrinsic-of) object))
      (lazy takes-two (== (. ([] (. instances signatures) callee) args count) 2))
    )
  )
  (fn-do _ copies-range Bool
    (param object TypeId)
    (param given TypeId)
    ; Whether a range of a table, of a span of one or of a view of a field's column is assigned
    ; from what TypeScript copies into it itself: the rows of a span or a table of struct or union
    ; rows, or the items of a view of the same field's type.
    (let kind (call (. types intrinsic-of) object))
    (let given-kind (call (. types intrinsic-of) given))
    (if (== kind .table-column)
      (return (and (== given-kind .table-column) (== (call class-arg types given 0) (call class-arg types object 0))))
    )
    (if (and (!= kind .table) (!= kind .table-span))
      (return false)
    )
    (let row (call (. types intrinsic-of) (call row-struct-of object)))
    (return
      (scope (and given-table (or (== row .struct) (== row .union)) (== (call row-struct-of given) (call row-struct-of object)))
        (lazy given-table (or (== given-kind .table-span) (== given-kind .table)))
      )
    )
  )
  (fn-do _ store-through _
    (param id SyntaxId)
    (param held-syntax SyntaxId)
    (param held TypeId)
    ; Where the object of an index assigned is itself an index, has the `[]=` of the object that
    ; inner index reads from recorded, for the answer the type pass planned to be stored.
    (match? ([] (. tree nodes) held-syntax)
      (case (call .node-index-expression row)
        (let container (call (. facts node-type) instance (. row object)))
        (let key (call (. facts node-type) instance (. row index)))
        (let known (and (!= container no-type) (!= container invalid-type)))
        (if (and known (!= key no-type) (!= key invalid-type) (not (. row is-optional)))
          (call (. calls index-store-through) id held-syntax container key held)
        )
      )
    )
  )
  (fn-do _ target-of TypeId
    (param lhs SyntaxId)
    (param narrowed Bool (= false))
    (match? ([] (. tree nodes) lhs)
      (case (call .node-identifier ident)
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (match (. resolution kind)
          (case= .resolve-slot
            (let slot (. resolution slot))
            (let known (if-expr narrowed (call (. frame slot-type) slot) (call slot-known slot)))
            (return (if-expr (== known no-type) (call read-slot slot) known))
          )
          (case= .resolve-global
            (return (call demand-global lhs (. resolution module) (. resolution decl)))
          )
          (case= .resolve-member
            (return (. (call read-member lhs (. ident name)) type))
          )
          (default
            (return invalid-type)
          )
        )
      )
    )
    (return (call infer lhs))
  )
)
