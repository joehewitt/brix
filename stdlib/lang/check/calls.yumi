for place in places
    . property = types.properties[place]
    . getter = no-instance
    if property.storage-kind == .storage-getter && property.owner != no-type
        getter = getter-instance(property.owner, property.name)
        if getter != no-instance
            facts.record-call
                - frame.instance
                - site
                - getter
                - .call-getter
                - scratch.no-fills
                - false
                - site == 0
