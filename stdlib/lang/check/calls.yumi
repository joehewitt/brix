. shapes-mark = scratch.call-arguments.mark
. types-mark = scratch.types.mark
. local = Ranking(frame.session, frame.module)
local.begin(scratch.call-arguments.since(shapes-mark), scratch.types.since(types-mark))
. hit = local.dispatch-getter(types.properties[held].type, types.data-atom!)
. reads = no-instance
if hit
