. pointer = types.well-known-type("core", "Pointer")
if task == invalid-type || pointer == invalid-type
    = invalid-type
. mark = scratch.types.mark
scratch.types.push(pointer)
. callee = demand-runtime-call(class-ref(types, task).module, no-type, program.store-atom("task-started"), mark)
scratch.types.rewind(mark)
if callee == no-instance
    = invalid-type
facts.record-call(frame.instance, syntax, callee, .call-function, scratch.no-fills, false)
= task

────────────────────
+ do demand-runtime-call InstanceId
    - module ModuleId
    - receiver TypeId
    - name Atom
    - mark ScratchMark
    - explicit-count Size = 0

` A function a module declares, or a method of `receiver`, which compiled code calls of its
` own accord with no node to record the call at, for the types pushed since `mark`: the first
` `explicit-count` are its type arguments, and the rest those of its arguments. It is typed as
` a call written in that module is, or no instance where none takes them.
. shapes-mark = scratch.call-arguments.mark
. count = scratch.types.length - mark - explicit-count
for _ in 0 .. < count
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. shapes = scratch.call-arguments.since(shapes-mark)
. given = scratch.types.since(mark + explicit-count)
. local = local-ranking(module)
local.begin(shapes, given)
if explicit-count != 0
