facts.record-witness-func(owner, hit.module, hit.decl)
facts.record-witness-call(hit.receiver, hit.module, hit.decl)

────────────────────
_ do declaring-interface TypeId
    - receiver TypeId
    - module ModuleId
    - decl DeclId

` The interface that declares a function called on a receiver, among the receiver and the
` interfaces it is derived from, as the reference fills the function's slot in that interface's
` part of a table. The receiver where the function belongs to no interface found.
. owner DeclId = 0
match? program.modules[module].decls[decl]
    | .decl-function(fn)
        owner = fn.owner
if owner == 0 || receiver == no-type
    = receiver
. pending [TypeId]
pending += receiver
. position = 0
while position < pending.length
    . current = pending[position]
    . ref = class-ref(types, current)
    if ref.module == module && ref.decl == owner
        = current
    for parent in types.interfaces-of(current)
        if pending.find(parent) == null
            pending += parent
    position += 1
= receiver

────────────────────
_ do inherits-from Bool
    - type TypeId
    - base TypeId

. above = types.base-of(type)
while above
    =? true if above == base
    above = types.base-of(above)
= false

────────────────────
_ receiver-reason ConversionReason
    - id SyntaxId
    - object-syntax SyntaxId

` Why the receiver of a call is converted: as the receiver of the function the call is in where
` the call writes none, its own node then standing for the receiver, and else as the one written.
if object-syntax == id then ConversionReason.reason-own-receiver else as-written

.. as-written = ConversionReason.reason-receiver

────────────────────
_ do pair-receiver
    - receiver TypeId
    - expected TypeId

if receiver == expected
    facts.record-pair(frame.instance, receiver, expected, same-relation(receiver))
    =
. relation = relations.compare(receiver, expected, false, false, null, frame.module)
facts.record-pair(frame.instance, receiver, expected, relation)

────────────────────
_ do resolve-hit InstanceId
