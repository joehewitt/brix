────────────────────
_ do adapt-row Hit?
    - receiver TypeId
    - hit Hit?
    - capture RowCapture? = null

` A member called on a name that stands for the case of a row runs on the row, as TypeScript's
` `table-row-extension` runs it: one of the case itself on the case's cells, an instance of
` its own, and one of a base every case shares on the row itself, an extension's member of
` that base among them though it runs on the case elsewhere.
if !hit || !capture || ranking.ambiguity()
    = hit
. found = if hit.level != no-type then hit.level else hit.receiver
if found == receiver
    interning = capture
    = hit
if !shares-row-base(capture.row, found)
    = hit
= Hit
    - hit.module
    - hit.decl
    - capture.row
    - hit.params
    - hit.args
    - hit.fills
    - hit.relations
    - hit.tail-fills
    - hit.tail-relations
    - true
    - hit.level

────────────────────
_ do shares-row-base Bool
    - row TypeId
    - base TypeId

` Whether every case of the union a row is a row of derives from a base.
. union = class-arg(types, row, 0)
if union == no-type || types.intrinsic-of(union) != .union
    = false
. shared = types.shared-case-base(union)
while shared != no-type
    if shared == base
        = true
    shared = types.shared-case-base(union, shared)
= false

────────────────────
+ do setter-call TypeId
    - id SyntaxId
    - object-syntax SyntaxId
    - receiver TypeId
    - name Atom
    - rhs SyntaxId
    - value TypeId
    - form CallForm = CallForm.call-setter

. site = open-site()
push-argument(value, rhs)
ranking.begin(site.shapes, site.types)
. hit = ranking.dispatch-setter(receiver, name)
note-interface-call(receiver, hit)
. delegated = hit && ranking.delegates-to(receiver, hit.receiver)
if delegated
