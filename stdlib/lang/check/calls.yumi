────────────────────
_ is-tuple-class Bool
    - class-module ModuleId
    - class-decl DeclId

types.type-decl(.tuple).refers-to(class-module, class-decl)

────────────────────
_ do tuple-of-arguments TypeId
    - arguments Arguments

. mark = scratch.types.mark
. names-mark = scratch.names.mark
. position = 0u32
for type in arguments.types
    if type == invalid-type
        scratch.types.rewind(mark)
        scratch.names.rewind(names-mark)
        = invalid-type
    scratch.names.push(types.index-atom(position))
    scratch.types.push(type)
    position += 1
= types.intern-tuple(mark, names-mark)

────────────────────
_ do construction-receiver TypeId
    - callable SyntaxId
    - class-module ModuleId
    - class-decl DeclId

match? frame.tree.nodes[callable]
    | .node-type-arguments(row)
        . mark = scratch.types.mark
        for child in frame.tree.children[row.args]
            . evaluated = types.evaluate-type(frame.module, frame.tree, child, frame.env)
            scratch.types.push(evaluated)
