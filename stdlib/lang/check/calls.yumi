────────────────────
+ do demand-getter
    - receiver TypeId
    - name Atom
    - syntax SyntaxId = 0

. callee = getter-instance(receiver, name)
if callee != no-instance && syntax != 0
    facts.record-call(frame.instance, syntax, callee, .call-getter, scratch.no-fills, false)

────────────────────
+ do demand-module-getter
    - module ModuleId
    - name Atom
    - syntax SyntaxId

` A getter a module declares, which the reference's lowering reads of its own accord at a
` node: typed, and recorded there as a call.
. decls = program.modules[module].decls
for position in 0 .. < decls.length
    match? decls[position]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .getter-decl && fn.name == name
                . decl = position as DeclId
                . callee = instances.intern
                    - module
                    - decl
                    - no-type
                    - callee-effects(frame, module, decl)
                    - no-instance
                host!.demand(callee)
                facts.record-call
                    - frame.instance
                    - syntax
                    - callee
                    - .call-getter
