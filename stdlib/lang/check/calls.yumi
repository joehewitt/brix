────────────────────
_ do prove-casts
    - hit Hit
    - syntax ImmutableArray'SyntaxId'ArenaBacking

` Records each argument written as a cast to the type the call takes it as, where the call,
` ranked again with what is cast in its place, chooses the same function the same way
` (`ContextCastFact`). A cast that changes the type of what it casts to a type written with the
` type parameters, or to one the call binds a parameter to, is kept, since it may choose the
` function. A call given a function is not ranked again, since ranking types the function for
` what each candidate passes it.
if !facts.traces-lint || ranking.ambiguity() != null || answers-table-index()
    =
for position in 0 .. < ranking.shape-count
    . kind = types.completions[ranking.given-at(position as U32)].intrinsic
    if kind == .closure || kind == .binding
        =
for position in 0 .. < syntax.length
    . written = syntax[position]
    match? frame.tree.nodes[written]
        | .node-argument(row)
            written = row.expr
    . fill = position as U32
    match? frame.tree.nodes[written]
        | .node-cast-expression(row)
            . target = ranking.given-at(fill)
            if types.evaluate-type(frame.module, frame.tree, row.rhs, frame.env) == target
                . source = facts.node-type(frame.instance, row.lhs)
                if source == target || !frame.names-type-param(row.rhs)
                    prove-cast(hit, fill, written, source, conversions.literal-of(row.lhs))
        | .node-integer-syntax
            prove-suffix(hit, fill, written)
        | .node-float-syntax
            prove-suffix(hit, fill, written)

────────────────────
_ do note-case-owners
    - hit Hit
    - syntax ImmutableArray'SyntaxId'ArenaBacking

` Records the types candidates took each argument that is a case named by its symbol alone as a
` case of, where they took it as one of more than one (`CaseOwnerFact`).
if !facts.traces-lint
    =
. noted [CaseOwnerNote]
ranking.symbol-owners-noted(hit, noted)
for note in noted
    if note.fill < syntax.length
        . fact = CaseOwnerFact
            - frame.instance
            - syntax[note.fill]
            - note.name
            - note.owner
            - note.chosen
        facts.case-owners.append(fact)

────────────────────
_ do prove-suffix
    - hit Hit
    - fill U32
    - literal SyntaxId

if conversions.suffix-type(literal) != ranking.given-at(fill)
    =
. saved = conversions.unsuffixed
conversions.unsuffixed = literal
prove-cast(hit, fill, literal, conversions.unsuffixed-type(literal), literal)
conversions.unsuffixed = saved

────────────────────
_ do prove-cast
    - hit Hit
    - fill U32
    - cast SyntaxId
    - source TypeId
    - literal SyntaxId

. target = ranking.given-at(fill)
if source == no-type || source == invalid-type || slot-type(hit, fill) != target
    =
if source != target
    for param in hit.params
        if param == target
            =
. mark = scratch.types.mark
for position in 0 .. < ranking.shape-count
    . given = position as U32
    scratch.types.push(if given == fill then source else ranking.given-at(given))
. shadow = Ranking(frame.session, frame.module)
. again = shadow.replay
    - ranking
    - scratch.types.since(mark)
    - if literal != 0 then fill else U32.max
    - literal
. chosen = again != null && shadow.missing-site == 0 && shadow.ambiguity() == null
. same = chosen && same-hit(hit, again!) && slot-type(again!, fill) == target
shadow.release()
scratch.types.rewind(mark)
if same
    . fact = ContextCastFact(frame.instance, cast, .cast-argument, target)
    facts.context-casts.append(fact)

────────────────────
+ do note-context-cast
    - value SyntaxId
    - expected TypeId
    - kind ContextCastKind

` Records a value written as a cast to the type its place takes it as, where what is cast
` converts to that type without it, for the rule that reads how it is written
` (`ContextCastFact`). An argument cast from another type to one written with the type
` parameters is not, since it may choose what is called, nor a cast whose value is not of the
` type written, as a cast to a stream keeps what it casts.
if !facts.traces-lint || expected == no-type || expected == invalid-type
    =
. written = value
match? frame.tree.nodes[written]
    | .node-argument(row)
        written = row.expr
match? frame.tree.nodes[written]
    | .node-cast-expression(row)
        . source = facts.node-type(frame.instance, row.lhs)
        . target = facts.node-type(frame.instance, written)
        if target != expected || source == no-type || source == invalid-type
            =
        if types.evaluate-type(frame.module, frame.tree, row.rhs, frame.env) != target
            =
        . named = frame.names-type-param(row.rhs)
        if kind == .cast-argument && named && source != expected
            =
        if conversions.fits-unasked(row.lhs, expected)
            . fact = ContextCastFact(frame.instance, written, kind, expected)
            facts.context-casts.append(fact)
note-suffixes(written, expected, kind)

────────────────────
_ do note-suffixes
    - value SyntaxId
    - expected TypeId
    - kind ContextCastKind

match? frame.tree.nodes[value]
    | .node-integer-syntax
        note-suffix(value, expected, kind)
    | .node-float-syntax
        note-suffix(value, expected, kind)
    | .node-binary-expression(row)
        if row.op == .else-op
            match? frame.tree.nodes[row.lhs]
                | .node-binary-expression(chosen)
                    . yes = facts.node-type(frame.instance, chosen.lhs)
                    . no = facts.node-type(frame.instance, row.rhs)
                    if chosen.op == .if-op && yes == expected && no == expected
                        note-suffixes(chosen.lhs, expected, kind)
                        note-suffixes(row.rhs, expected, kind)

────────────────────
_ do note-suffix
    - literal SyntaxId
    - expected TypeId
    - kind ContextCastKind

. suffixed = conversions.suffix-type(literal)
if suffixed != no-type && suffixed == expected && conversions.unsuffixed-fits(literal, expected)
    facts.context-casts.append(ContextCastFact(frame.instance, literal, kind, expected))

────────────────────
+ do note-operand-suffix
    - operand SyntaxId
    - other SyntaxId
    - beside TypeId

if !facts.traces-lint || written-number(other)
    =
. suffixed = conversions.suffix-type(operand)
if suffixed != no-type && conversions.unsuffixed-beside(operand, beside) == suffixed
    facts.context-casts.append(ContextCastFact(frame.instance, operand, .cast-operand, suffixed))

────────────────────
_ do written-number Bool
    - syntax SyntaxId

=? true if conversions.literal-of(syntax) != 0
match? frame.tree.nodes[syntax]
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-unary-expression(row)
        = row.op == .negative-op && written-number(row.operand)
= false

────────────────────
_ answers-table-index Bool

` Whether the call is an index of a table or of a view of one by an integer, or an assignment
` through one, which TypeScript answers itself without choosing a function.
|? ranking.request != .request-method || !name || ranking.shape-count == 0
    false
|? !assigns && name != types.index-op-atom!
    false
|? !tables && !spans && !columns && !selects
    false
??
    assigns || is-integer-kind(types.intrinsic-of(ranking.given-at(0)))

.. name = ranking.request-name
.. assigns = name == types.index-assign-atom!
.. kind = types.intrinsic-of(ranking.request-receiver)
.. tables = kind == .table || kind == .immutable-table || kind == .index-span
.. spans = kind == .table-span || kind == .immutable-table-span
.. columns = kind == .table-column || kind == .immutable-table-column
.. selects = kind == .table-selection || kind == .immutable-table-selection

────────────────────
_ do slot-type TypeId
    - hit Hit
    - fill U32

` The type a hit takes an argument as: that of the slot the argument fills, or the item of the
` list its variadic tail is made into.
for position in 0 .. < hit.fills.length
    if hit.fills[position] == fill
        = hit.args[position]
for offset in 0 .. < hit.tail-fills.length
    if hit.tail-fills[offset] == fill
        = hit.tail-relations[offset].to
= no-type

────────────────────
_ do same-hit Bool
    - one Hit
    - other Hit

` Whether two hits choose the same function the same way: on the same receiver, binding the
` same type parameters and taking each argument slot as the same type.
if one.module != other.module || one.decl != other.decl || one.receiver != other.receiver
    = false
if one.level != other.level || one.is-extension != other.is-extension
    = false
if one.params.length != other.params.length || one.args.length != other.args.length
    = false
for position in 0 .. < one.params.length
    if one.params[position] != other.params[position]
        = false
for position in 0 .. < one.args.length
    if one.args[position] != other.args[position]
        = false
= true

────────────────────
_ do keep-through
    - id SyntaxId
    - callee InstanceId
    - owner TypeId
    - held TypeId

` Notes at a call that a property its receiver delegates to answers the properties read
` from the receiver to reach what the function takes, in the order they are read. A call the
` receiver's own type answers has none. A property on the way that a getter answers is read
` by a call of the getter, which is typed for the type that declares it and kept with the
` step; the caller calls it, with no node of its own.
. places [U32]
if !ranking.delegate-path(owner, held, places)
    =
. getters = step-getters(places)
. fact = facts.first-call(frame.instance, id)
while fact != no-fact
    if facts.calls[fact].callee == callee && facts.calls[fact].through.count == 0
        facts.calls[fact].through = facts.keep-steps(places, getters)
        =
    fact = facts.calls[fact].next

────────────────────
_ do unresolved-param Atom?
    - hit Hit

` The first type parameter a call gave its candidate no way to work out.
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. module Index = hit.module
. signature = signature-into
    - types
    - module as ModuleId
    - hit.decl
    - no-type-arguments(types)
    - hit.receiver
    - true
. open Atom? = null
for position in 0 .. < hit.params.length
    if !open && position < signature.params.length
        if types.completions[hit.params[position]].has-variables
            open = signature.params[position]
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
