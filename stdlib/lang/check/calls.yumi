` A call of the operator `name` of the receiver given one argument. `deferred` leaves ending what
` is known of properties to the caller, which learns whether the compiler answers it in place.

. site = open-site()
push-argument(arg, arg-syntax)
ranking.begin(site.shapes, site.types)
. hit = ranking.dispatch-method(receiver, name)
note-interface-call(receiver, hit)
. ambiguous = ranking.ambiguity()
. result = invalid-type
if hit && ambiguous
    ranking.release()
    frame.diagnose(id, ambiguous, name)
else if hit
    if object-syntax != 0 && hit.receiver != receiver && inherits-from(receiver, hit.receiver)
        conversions.convert
            - object-syntax
            - object-syntax
            - receiver
            - hit.receiver
            - receiver-reason(id, object-syntax)
    if is-virtual-receiver(receiver)
        instances.mark-may-panic(frame.instance)
    . callee = commit-hit(id, hit, .call-operator, site.syntax, deferred)
    ranking.release()
    result = demand-return(callee, id)
else
    ranking.release()
    frame.diagnose(id, .illegal-operation, name, receiver, arg)
