if !owned || stored == no-type || stored == invalid-type
    = false
= is-array-number(stored)

────────────────────
_ do is-array-number Bool
    - read TypeId

types.complete(read)
. held = types.completions[read]
if !intrinsic-is-numeric(held.intrinsic)
    = false
if held.intrinsic == .cpointer
    . pointee = pointee-of(types, read)
    types.complete(pointee)
    if !types.completions[pointee].is-pointer
        = false
= narrow || held.bit-size == 16 || held.bit-size == 32 || held.bit-size == 64
    .. narrow = held.bit-size == 1 || held.bit-size == 8

