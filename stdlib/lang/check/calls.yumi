scratch.call-arguments.rewind(shapes-mark)
if callee == no-instance || !host || instances.argument-type(callee, 0) != types.index-type
    =
host.demand(callee)
facts.calls[first].callee = callee
facts.set-plan(frame.instance, syntax, .plan-array-item)

────────────────────
_ do reads-array-item Bool
    - callee InstanceId
    - read TypeId

` Whether `[]` is ReadableArray's own of an index, called on an array, for a read of a number
` TypeScript reads where it lies: a number, a truth or a character of 1, 8, 16, 32 or 64 bits,
` or a C pointer to what is itself a pointer.
if callee == no-instance || instances.signatures[callee].args.count != 1 || not-indexed
    = false
.. not-indexed = instances.argument-type(callee, 0) != types.index-type
. own = instances.rows[callee]
. readable = types.readable-array-decl
if own.module != readable.module
    = false
. owned = false
match? program.modules[own.module].decls[own.decl]
    | .decl-function(fn)
        owned = fn.owner == readable.decl
if !owned
    = false
. arrayed = false
