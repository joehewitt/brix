        - object-syntax
        - object-syntax
        - receiver
        - hit.receiver
        - receiver-reason(id, object-syntax)
if hit && is-virtual-receiver(receiver)
    instances.mark-may-panic(frame.instance)
. callee = resolve-hit(id, .call-getter, site.syntax, .property-not-found, hit, name)
interning = null
