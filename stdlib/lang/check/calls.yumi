. callee = resolve-hit(id, form, site.syntax, .function-not-found, hit, name)
ranking.release()
. result = invalid-type
if callee != no-instance
    pair-receiver(receiver, hit!.receiver)
    . returned = demand-return(callee, id)
    result = if returned == types.void-type || returned == no-type then value else returned
close-site(site)
= result

────────────────────
+ do module-getter-call TypeId
    - id SyntaxId
