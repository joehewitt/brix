local.release()
scratch.types.rewind(types-mark)
scratch.call-arguments.rewind(shapes-mark)
if callee != no-instance && host
    host.demand(callee)
    . fills-start = scratch.words.mark
    scratch.words.push(0)
    facts.record-call
        - frame.instance
        - syntax
        - callee
        - form
        - scratch.words.since(fills-start)
