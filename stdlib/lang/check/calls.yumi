────────────────────
+ do push-argument
    - type TypeId
    - syntax SyntaxId
    - name Atom? = null

. literal = if syntax != 0 then conversions.literal-of(syntax) else 0
scratch.call-arguments.push(CallArgument(name, false, false, false, false, null, literal))
scratch.types.push(type)
scratch.syntax.push(syntax)

────────────────────
+ do close-site
    - site CallSite

scratch.syntax.rewind(site.syntax-mark)
scratch.types.rewind(site.types-mark)
scratch.call-arguments.rewind(site.shapes-mark)

