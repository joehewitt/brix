. hit Hit? = null
if receiver == no-type
    hit = local.dispatch-function(no-type, name)
else
    hit = local.dispatch-method(receiver, name)
. callee = no-instance
if hit && !local.ambiguity()
    . declared = declared-effects(program, hit.module, hit.decl)
    callee = intern-settled(hit, dispatch-effects(exceptional-effects(frame.surround.effects) /or/ declared))
