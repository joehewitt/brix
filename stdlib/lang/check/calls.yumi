= found

────────────────────
+ do concat-call
    - id SyntaxId
    - right SyntaxId
    - piece TypeId

. site = open-site()
push-argument(piece, right)
ranking.begin(site.shapes, site.types)
ranking.texts = true
. hit = ranking.dispatch-method(types.string-type, types.concat-atom!)
ranking.texts = false
if hit
    commit-hit(id, hit, .call-operator, site.syntax)
else if !ranking.ambiguity()
    frame.diagnose(id, .illegal-operation, null, types.string-type, piece)
ranking.release()
close-site(site)

────────────────────
_ stores-back Bool
    - receiver TypeId

` Whether what `[]=` answers for an object of a type is stored back in the object when it
` is of that type: for a struct, for a number, and for a text, where the assignment then
` gives the text stored.
kind == .struct || kind == .string || (intrinsic-is-numeric(kind) && kind != .cpointer)

.. kind = types.intrinsic-of(receiver)

────────────────────
+ do index-assign-call TypeId
    - id SyntaxId
    - object TypeId
    - key-syntax SyntaxId
    - key TypeId
    - rhs SyntaxId
    - value TypeId
    - value-at-site Bool = false
    - literal-value Bool = false

. name = types.index-assign-atom!
. site = open-site()
push-argument(key, key-syntax)
push-argument(value, rhs)
ranking.begin(site.shapes, site.types)
. hit = ranking.dispatch-method(object, name)
note-interface-call(object, hit)
. ambiguous = ranking.ambiguity()
. result = invalid-type
if hit && ambiguous
    ranking.release()
    frame.diagnose(id, ambiguous, name)
else if hit
    . callee = commit-hit(id, hit, .call-operator, site.syntax)
    . answered = stored-back && demand-return(callee, id) == hit.receiver
        .. stored-back = callee != no-instance && stores-back(hit.receiver)
    if answered
        facts.set-plan(frame.instance, id, .plan-store-answer)
    if value-at-site
        . expected-value = hit.args[1]
