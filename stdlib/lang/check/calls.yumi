────────────────────
_ do admits-value-call Bool
    - id SyntaxId

. restricted = heap-free /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend /or/ ban-bits()
    .. heap-free = CompilationEffect.gc-free /or/ CompilationEffect.no-heap
=? true if (dispatch-effects(frame.surround.effects) /and/ restricted) == 0
frame.diagnose(id, .restricted, program.store-atom("Function value call requires unrestricted effects"))
= false

────────────────────
_ do note-interface-call
    - receiver TypeId
    - hit Hit?

if !hit || hit.is-extension || ranking.ambiguity()
    =
if receiver == no-type || types.completions[receiver].intrinsic != .interface
    =
. owner = declaring-interface(hit.receiver, hit.module, hit.decl)
if owner == no-type || types.completions[owner].intrinsic != .interface
