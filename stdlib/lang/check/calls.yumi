if types.class-type-args(class-module, class-decl).count == 0
    = types.class-with-args(class-module, class-decl, scratch.types.mark)
. env = types.class-env(class-module, class-decl)
. pattern = env.this-type
types.env-release(env)
= pattern

────────────────────
_ is-this-callable Bool
    - callable SyntaxId

|? !types.this-atom
    false
??
    match frame.tree.nodes[callable]
        | .node-identifier(row)
            row.name == types.this-atom
        | .node-type-identifier(row)
            row.name == types.this-atom
        ??
            false

────────────────────
+ do operator-call TypeId
    - id SyntaxId
    - receiver TypeId
    - name Atom
    - arg-syntax SyntaxId
    - arg TypeId
