. fills = scratch.words.span(fills-mark, slots-mark - fills-mark)
. slots = scratch.words.since(slots-mark)
. settled = scratch.types.since(args-mark)
. row = interning
interning = null
. callee = instances.intern
    - hit.module
    - hit.decl
    - hit.receiver
    - effects
    - no-instance
    - hit.params
    - settled
    - true
    - if row then row.row else no-type
    - if row then row.case-index else U32.max
    - row && row.validated
    - 0
    - no-type
    - fills
    - slots
    - given
    - frame.zone()
    - no-instance
