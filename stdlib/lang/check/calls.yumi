= is-array-number(read)

────────────────────
+ do stores-array-item Bool
    - callee InstanceId

if callee == no-instance || instances.signatures[callee].args.count != 2 || not-indexed
    = false
.. not-indexed = instances.argument-type(callee, 0) != types.index-type
. own = instances.rows[callee]
. array = types.array-decl
if own.module != array.module
    = false
. owned = false
