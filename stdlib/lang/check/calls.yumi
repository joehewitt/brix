. wanted = types.reserve-atom!
. owner-module = program.modules[ref.module]
. members = RowRange'DeclId()
match? owner-module.decls[ref.decl]
    | .decl-class(row)
        members = row.members
for member in owner-module.members-named(members, wanted)
    match? owner-module.decls[member]
        | .decl-function(fn)
            if fn.kind == .function-decl && fn.name && fn.name == wanted && fn.args.count == 1
                . mark = scratch.types.mark
                scratch.types.push(types.size-type)
                . effects = callee-effects(frame, ref.module, member)
                . size-arg = scratch.types.since(mark)
                . none = scratch.no-types
                . callee = instances.intern
                    - ref.module
                    - member
                    - receiver
                    - effects
                    - no-instance
                    - none
                    - size-arg
