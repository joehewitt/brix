. site = open-site()
ranking.begin(site.shapes, site.types)
. hit = ranking.dispatch-getter(receiver, name)
note-interface-call(receiver, hit)
. callee = no-instance
if hit && !ranking.ambiguity()
    callee = intern-hit(hit, callee-effects(frame, hit.module, hit.decl), false)
    host!.demand(callee)
