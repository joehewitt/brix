. hit = ranking.dispatch-method(receiver, types.index-op-atom!)
. result = invalid-type
if hit && !ranking.ambiguity()
    . names-mark = scratch.names.mark
    . items-mark = scratch.types.mark
    . arguments = no-type-arguments(types)
    . signature = signature-into(types, hit.module, hit.decl, arguments, hit.receiver, true)
    result = signature.returns
    scratch.types.rewind(items-mark)
    scratch.names.rewind(names-mark)
