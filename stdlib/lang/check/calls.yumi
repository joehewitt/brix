` The constructor of a value the compiler makes, chosen as a call written in the module chooses
` it, so a parameter typed by its default ranks with that type. It is typed outside any GC-free
` zone, as an error or a panic is made on the path out of one; one `zoned` is typed in the zone
` it is made in, and one `reported`, for a report one instance serves wherever it is made, as
` declared. The defaults of the parameters it leaves out are typed, as the value is made with
` them.
. shapes-mark = scratch.call-arguments.mark
. count = scratch.types.length - mark
for _ in 0 .. < count
    scratch.call-arguments.push(CallArgument(null, false, false, false, false))
. shapes = scratch.call-arguments.since(shapes-mark)
. given = scratch.types.since(mark)
types.complete(receiver)
. local = local-ranking(frame.module)
local.begin(shapes, given)
. hit = local.dispatch-constructor(receiver, false)
. callee = no-instance
if hit
    . declared = declared-effects(program, hit.module, hit.decl)
    . held = if reported then 0u32 else if zoned then frame.surround.effects else exceptional-effects(frame.surround.effects)
    callee = intern-settled(hit, dispatch-effects(held /or/ declared))
    . empty U32 = ArgumentFill.fill-empty
    for position in 0 .. < hit.fills.length
        if host && hit.fills[position] == empty
            host.type-default(callee, position as U32)
local.release()
scratch.call-arguments.rewind(shapes-mark)
if callee != no-instance && host
    host.demand(callee)
= callee

────────────────────
_ intern-hit InstanceId
    - hit Hit
    - effects EffectMask
    - with-args Bool
    - schedule Bool = true

` The callee instance a hit names: its declaration under the hit's type parameters and, when
` the call passes arguments, the expected type of every slot.
instances.intern
    - hit.module
    - hit.decl
    - hit.receiver
    - effects
    - no-instance
    - hit.params
    - args
    - schedule

.. args = if with-args then hit.args else scratch.no-types

────────────────────
_ is-tuple-constructor Bool
    - module ModuleId
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-function(fn)
        fn.kind == .tuple-constructor-decl
    ??
        false

────────────────────
_ do demand-return TypeId
    - callee InstanceId
    - call SyntaxId

` A callee that has not settled its errors holds a place among those that leave the caller.
` A call whose type or report depends on them settles them first, and so does a call back to
` a function still being checked, which reads it as raising nothing so far.
host!.demand(callee)
. deferred = false
if !instances.errors-known(callee)
    . running = instances.rows[callee].state == .instance-in-progress
    if frame.surround.transformer-depth != 0 || frame.surround.catch-depth != 0 || running
        host!.demand-errors(callee)
    else
        defer-outgoing(callee, call)
        deferred = true
. signature = instances.signatures[callee]
. returns = signature.returns
if signature.errors.count != 0 && !deferred
    if frame.surround.transformer-depth != 0
        . message = "Error transformer expressions must not call result-returning functions"
        frame.diagnose(call, .stated, program.store-atom(message))
    else if frame.surround.catch-depth != 0
        returns = result-of(frame, signature)
    else
        for offset in 0 .. < signature.errors.count
            . error = instances.signature-types[signature.errors.start + offset]
            note-outgoing(error, call)
        facts.mark-propagates(frame.instance, call)
if instances.rows[callee].state == .instance-in-progress
    instances.mark-read-in-progress(callee, frame.instance)
    = returns
if signature.return-state == .return-pending
    = invalid-type
= returns
