    push-argument(argument, 0, named)
    count = 1
if second != no-type
    push-argument(second, 0)
    count = 2
if third != no-type
    push-argument(third, 0)
    count = 3
ranking.begin(opened.shapes, opened.types)
. hit = ranking.dispatch-method(receiver, name)
note-interface-call(receiver, hit)
. result = invalid-type
if hit && !ranking.ambiguity()
    . effects = if restricted then callee-effects(frame, hit.module, hit.decl) else declared-effects(program, hit.module, hit.decl)
    . callee = intern-hit(hit, effects, true)
