_ do live-name Atom?
    - hit Hit

. owner-module = program.modules[hit.module]
match? owner-module.decls[hit.decl]
    | .decl-function(fn)
        match? owner-module.tree.nodes[fn.syntax]
            | .node-function-syntax(row)
                =? fn.name if row.is-live
= null

────────────────────
_ argument-site SyntaxId
    - syntax SyntaxId

match frame.tree.nodes[syntax]
    | .node-argument(row)
        if !row.name then row.expr else syntax
    ??
        syntax

────────────────────
_ argument-expr SyntaxId
    - syntax SyntaxId

match frame.tree.nodes[syntax]
    | .node-argument(row)
        row.expr
    ??
        syntax

────────────────────
_ is-argument-form Bool
    - form CallForm

match form
    |= .call-function
        true
    |= .call-method
        true
    |= .call-static
        true
    |= .call-constructor
        true
    |= .call-this-constructor
        true
    ??
        false

────────────────────
_ do convert-default
    - site SyntaxId
    - hit Hit
    - callee InstanceId
    - position Size
    - is-given Bool

` The default a parameter declares, converted to the parameter's type where a call takes it:
` at the call for an argument it leaves out, and at an argument it gives that is an optional,
` which takes the default when it holds no value. The callee types the default then, if no call
` took it before, as a tuple's constructor types the value written for a field a call leaves out.
` A default is cast to the parameter's type, as `as` casts it, whether the parameter writes that
` type or the call decides it for a type parameter.
. owner-module = program.modules[hit.module]
match? owner-module.decls[hit.decl]
    | .decl-function(fn)
        if fn.is-generated && fn.kind == .tuple-constructor-decl && !is-given
            host!.type-default(callee, position as U32)
            =
        if position >= fn.args.count
            =
        . start Index = fn.args.start
        . shape = owner-module.arg-pool[start + position]
        if shape.default-syntax == 0
            =
        host!.type-default(callee, position as U32)
        . env = types.env-frame()
        . tree = owner-module.tree
        . owner Index = hit.module
        . literal = literal-type(types, owner as ModuleId, tree, shape.default-syntax, env)
        types.env-release(env)
        . expected = hit.args[position]
        match? tree.nodes[shape.default-syntax]
            | .node-symbol(row)
                literal = contextual-symbol(types, relations, expected, row.name, owner as ModuleId)
        if literal == invalid-type || literal == expected
            =
        if !is-given
            conversions.convert(site, site, literal, expected, .reason-default, true, true)
            =
        . relation = conversions.compare-held(literal, expected)
        if relation-legal(relation)
            conversions.record-conversion(site, relation, .reason-default, true)

