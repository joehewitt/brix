_ do commit-partial
    - id SyntaxId
    - hit Hit
    - form CallForm

. callee = intern-hit(hit, callee-effects(frame, hit.module, hit.decl), true, false)
facts.record-call(frame.instance, id, callee, form, hit.fills, true)

────────────────────
_ do commit-hit InstanceId
    - id SyntaxId
    - hit Hit
    - form CallForm
    - syntax ImmutableArray'SyntaxId'ArenaBacking
    - deferred Bool = false
    - piped SyntaxId = 0

` Turns the winning candidate into the callee instance and records what the call site learned:
` the pair relation per argument, literal fits, conversions, enum symbols, the list a variadic
` tail is made into, and default conversions. An integer written with no suffix that a parameter
` holds takes the parameter's type, and needs no conversion. Where an argument of the tail has a name or a
` bullet `•?`, what it gives the list before its conversion is kept at the argument: the
` tuple of its name and its value, or what it holds where it is present. A tail with a bullet
` `•?` appends each argument to the list, by a call recorded at the argument. A list of one
` bullet piped into the call at `piped` is converted for a reason of its own, apart from the
` pipe's value, which is kept at the same node: the first argument written at the pipe. A case
` named by its symbol alone is a case of the parameter's type where that type has it, as the
` reference casts it there, whatever type the call was ranked with; one that several types have,
` cast to a parameter type without it, is of none of them (`keeps-symbol`). What is known of
` properties ends at the call, unless the compiler answers it in place (`answered-in-place`) or
` that is left to the caller (`deferred`).
prove-casts(hit, syntax)
note-case-owners(hit, syntax)
. empty U32 = ArgumentFill.fill-empty
. variadic U32 = ArgumentFill.fill-variadic
. callee = intern-settled(hit, callee-effects(frame, hit.module, hit.decl))
. at-site = is-argument-form(form)
. piped-fill = U32.max
if piped != 0 && id == piped
    for offset in 0 .. < syntax.length
        if syntax[offset] == piped
            piped-fill = offset as U32
            break
if !deferred && !answered-in-place(callee)
    frame.forget-members()
for position in 0 .. < hit.fills.length
    . fill = hit.fills[position]
    if fill != empty && fill != variadic
        . relation = hit.relations[position]
        . arg-syntax = syntax[fill]
        . site = argument-site(arg-syntax)
        . expected = hit.args[position]
        if types.completions[expected].intrinsic == .or || relations.holds-alternatives(expected)
            expected = relation.to
        . shape = ranking.shape-at(fill)
        . symbol = shape.symbol
        if symbol
            . target = if types.is-optional(expected) then expected-inner else expected
                .. expected-inner = types.optional-inner(expected)
            . holds = symbols-type(types, program, target, shape) != invalid-type
            if relation.from != target && holds
                relation = relations.compare(target, expected, false, false, null, frame.module)
            facts.set-node-type(frame.instance, site, relation.from)
            if shape.other-symbol
                host!.note-symbol-choice(relation.from, argument-expr(arg-syntax))
            else
                host!.note-enum-case(relation.from, symbol, site, holds)
                if keeps-symbol(site, relation.from, expected, symbol)
                    settle-later(site, symbol)
        . applied = relation
        . mismatched = relation.kind == .relation-same && relation.from != expected
        . unbound = relation.to == relation.unified && types.is-generic(relation.to)
        if mismatched && !types.completions[expected].has-variables
            . fresh = relations.compare(relation.from, expected, false, false, null, frame.module)
            if relation-legal(fresh)
                applied = fresh
        else if unbound && !types.is-generic(expected)
            applied.to = expected
            applied.unified = expected
        if records-pairs
            facts.record-pair(frame.instance, applied.from, expected, applied)
        conversions.check-literal-fit(site, expected)
        . adapted = conversions.adapted-literal(site, applied.from, expected)
        if adapted != applied.from
            . refit = relations.compare(adapted, expected, false, false, null, frame.module)
            if relation-legal(refit)
                applied = refit
        . recast = recast-property(hit, position, expected)
        . reason ConversionReason = if fill == piped-fill then .reason-piped else .reason-argument
        if recast != 0 && applied.from != types.null-type
            convert-recast(arg-syntax, applied.from, expected, callee, recast)
        else if holds-callable(applied.from, expected)
            conversions.convert(arg-syntax, arg-syntax, applied.from, expected, reason)
        else if applied.kind != .relation-same
            conversions.record-conversion(arg-syntax, applied, reason, at-site, no-type, arg-syntax)
        if types.is-optional(relation.from)
            convert-default(arg-syntax, hit, callee, position, true)
. listed = no-type
for position in 0 .. < hit.fills.length
    if hit.fills[position] == variadic
        listed = hit.args[position]
. appends = false
for fill in hit.tail-fills
    if ranking.shape-at(fill).is-optional
        appends = true
for offset in 0 .. < hit.tail-fills.length
    . relation = hit.tail-relations[offset]
    . arg-syntax = syntax[hit.tail-fills[offset]]
    . shape = ranking.shape-at(hit.tail-fills[offset])
    if shape.name || shape.is-optional
        facts.set-node-type(frame.instance, arg-syntax, relation.from)
    if appends
        note-append(arg-syntax, listed, relation.to)
    if records-pairs
        facts.record-pair(frame.instance, relation.from, relation.to, relation)
    . site = argument-site(arg-syntax)
    conversions.check-literal-fit(site, relation.to)
    . adapted = conversions.adapted-literal(site, relation.from, relation.to)
    if adapted != relation.from
        . refit = relations.compare(adapted, relation.to, false, false, null, frame.module)
        if relation-legal(refit)
            relation = refit
    if relation.kind != .relation-same
        conversions.record-conversion
            - arg-syntax
            - relation
            - .reason-element
            - at-site
            - no-type
            - arg-syntax
for position in 0 .. < hit.fills.length
    . fill = hit.fills[position]
    if fill == variadic
        note-list(id, hit.args[position])
    if fill == empty
        convert-default(id, hit, callee, position, false)
facts.record-call(frame.instance, id, callee, form, hit.fills, false)
for position in 0 .. < hit.fills.length
    . fill = hit.fills[position]
    if fill != empty && fill != variadic
        host!.note-given(id, argument-expr(syntax[fill]), callee, position as U32)
. live = live-name(hit)
if live
    host!.note-live-call(id, live)
= callee

