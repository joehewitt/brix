. fact = facts.calls[first]
if fact.syntax != syntax || fact.form != .call-operator || !reads-array-item(fact.callee, read)
    =
. receiver = instances.rows[fact.callee].self-type
. shapes-mark = scratch.call-arguments.mark
. types-mark = scratch.types.mark
scratch.call-arguments.push(CallArgument(null, false, false, false, false))
scratch.types.push(key)
. local = Ranking(frame.session, types.readable-array-decl.module)
local.begin(scratch.call-arguments.since(shapes-mark), scratch.types.since(types-mark))
. hit = local.dispatch-method(receiver, types.absent-atom!)
. callee = no-instance
if hit && !local.ambiguity()
