. site = open-site()
push-argument(key, 0)
push-argument(item, 0)
ranking.begin(site.shapes, site.types)
. hit = ranking.dispatch-method(container, types.index-assign-atom!)
if hit && !ranking.ambiguity()
    . callee = intern-settled(hit, callee-effects(frame, hit.module, hit.decl))
    if callee != no-instance && host
        host.demand(callee)
        facts.record-call(frame.instance, held, callee, .call-store-through, hit.fills, false)
ranking.release()
