(import /stream/sort)

(type _ PatternArms (is Tuple)
  ; The arms of a grammar being typed (`arms-type`): whether an arm selects what it
  ; materializes, whether they are scoped, whether an action's type cannot be inferred, whether
  ; they join as alternatives, and the arm being typed (`enter-arm`).
  (blank)
  (prop + selects Bool)
  (prop + scoped Bool)
  (prop + uninferred Bool)
  (prop + joined Bool)
  (prop + arm SyntaxId (= 0))
)

(type _ Streams (facet-of Checker)
  (sees CallTyping)
  (sees Loops)
  (sees MatchArms)
  (sees StateMachines)
  (prop _ pattern-arms _ (= (call PatternArms)))
  (prop _ action-selects _ (= false))
  (prop _ remakes-result _ (= false))
  (prop _ outline-unsure _ (= false))
  (fn-expr _ buffer-item TypeId :get
    ; The type of the items the buffer of the stream a pattern reads holds: the stream's items, or
    ; bytes where it is `encoded`.
    (if-expr (!= (. stream-view buffer) no-type) (call class-arg types (. stream-view buffer) 0) (. stream-view item))
  )
  (fn-expr _ beside-rule Bool :get
    ; Whether the local rules being typed are those of a rule a module declares, beside its own
    ; pattern, rather than those of a match.
    (and (== (. rule-streaming matched) 0) (!= own-match 0))
    (where
      (lazy own-match (call rule-match program (. ([] (. instances rows) instance) module) (. ([] (. instances rows) instance) decl)))
    )
  )
  (fn-expr _ own-helper Bool :get
    ; Whether the helper in force is the rule's own: the one this instance is typed for, or the one
    ; the rule is given as an argument.
    (and (!= rule-helper-site 0) (== (. helping site) rule-helper-site))
  )
  (fn-do + type-helper Bool
    (param helper SyntaxId)
    ; Types the helper a stream match is given with `with`, after its subject, and resolves what it
    ; can do as the reference does, reporting there what the reference reports. One that can do
    ; nothing is reported; one that can is the helper of the match's pattern. One whose collector
    ; storages disagree, or that is no object, has no shape here. False where the match has no shape.
    (let type (call infer helper))
    (if (== type invalid-type)
      (return false)
    )
    (if (== type no-type)
      (call decline helper)
      (return false)
    )
    (let resolved (call pattern-helper types type))
    (if (!= (. resolved problem) null)
      (call (. frame diagnose) helper .stated (call (. program store-atom) (. resolved problem)))
      (return false)
    )
    (if (not (. resolved is-active))
      (call (. frame diagnose)
        (block
          (arg helper)
          (arg .stated)
          (arg (call (. program store-atom) "Pattern helper implements no pattern capability"))
        )
      )
      (return false)
    )
    (if (or (== (. resolved storage) invalid-type) (!= (call (. types intrinsic-of) type) .class))
      (call decline helper)
      (return false)
    )
    (call (. facts set-plan) instance helper .plan-pattern-helper)
    (= helping (= (. helping helper) resolved))
    (= helping (= (. helping site) helper))
    (return true)
  )
  (fn-do + infer-stream-match TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param is-root Bool)
    ; A grammar a match runs, typed over a stream of its own: a pattern around it, whose
    ; action holds the match, reads its own stream again after.
    (let buffer stream-view)
    (let result (call infer-grammar id pattern is-root))
    (= stream-view buffer)
    (return result)
  )
  (fn-do _ infer-grammar TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param is-root Bool)
    ; A grammar a match runs on the String it is on. The String is read through a
    ; `TextTokenStream`, whose buffer holds its UTF-8 bytes, by calls the type pass records at the
    ; pattern, in the order `record-stream-protocol` makes them. Its arms are typed as the
    ; reference declares them and joined, and its value is optional unless its last arm always
    ; passes. Where an arm gives the text it matched, or an action reads it as `it`, the call
    ; that slices it from the stream's buffer is recorded there. A match that is returned has the
    ; type the function returns, as its arms do, even those that give an optional, or what that
    ; type holds where it is optional. One that always passes panics where the stream defers its last arm, which no stream a
    ; String is read through does. The names the pattern captures are typed before its arms. The
    ; match `if` or `while` tests a pattern with gives true where its arm ran, and false where
    ; none did.
    (if (!= id (. rule-streaming matched))
      (return (call infer-scoped-pattern id pattern is-root))
    )
    (if (== (. matching subject) invalid-type)
      (return invalid-type)
    )
    (if (and is-root (not (call iterates (. matching subject))) (== (call natural-item (. matching subject)) no-type))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Can't convert to iterable"))
      (return invalid-type)
    )
    (if (or (not is-root) (not (call record-stream-protocol id (. matching subject))))
      (call decline id)
      (return invalid-type)
    )
    (let returned (call (. facts node-type) instance id))
    (let target no-type)
    (if (and (!= returned no-type) (!= returned invalid-type))
      (= target (if-expr (call (. types is-optional) returned) (call (. types optional-inner) returned) returned))
    )
    (let result (call type-stream-arms pattern true target (!= target returned)))
    (if (== result invalid-type)
      (return invalid-type)
    )
    (if (. matching open)
      (if (!= result (. types bool-type))
        (call decline id)
        (return invalid-type)
      )
      (call (. facts set-plan) instance id .plan-open)
      (return result)
    )
    (if (not (call always-passes pattern))
      (return (call (. types optional-around) result))
    )
    (call (. instances mark-may-panic) instance)
    (return result)
  )
  (fn-do _ infer-scoped-pattern TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param is-root Bool)
    ; A grammar written in the code of a function declared over the items of a stream, as
    ; the reference runs it: on the stream the function is given, from where the stream stands,
    ; through the calls a match on that stream records at the pattern. Its arms are typed and
    ; joined with no type to give but their own, and one that gives no value gives what its last
    ; part gives where that is optional, as the reference gives it. It gives an optional
    ; `CaptureResult` of the stream's items and what the arms give, which holds the items the
    ; pattern read beside that, and nothing where no arm passed. One in the code of a local rule
    ; runs on the stream the rule is called on, as `coded-rule-type` says. One in any other
    ; function is an error, and one in the arms of another pattern or under a helper has no shape
    ; here. Where the
    ; metrics of grammars compile, each result it gives is counted, as the reference counts it.
    ; A function or local rule a pattern on a String calls reads the stream's UTF-8 bytes, and its
    ; `CaptureResult` holds those bytes.
    (let stream (if-expr (!= (. rule-streaming stream) no-type) (. rule-streaming stream) (call scope-stream)))
    (let texts
      (block
        (case? (!= (. rule-streaming stream) no-type)
          (. rule-streaming encoded)
        )
        (default
          (. ([] (. instances rows) instance) encoded)
        )
      )
    )
    (if (or is-root (== stream no-type) (!= (. rule-streaming matched) 0) (!= (. helping helper) null))
      (if (and (== stream no-type) (== (. rule-streaming matched) 0) (== (. helping helper) null))
        (call (. frame diagnose) id .stated (call (. program store-atom) streamless-text))
        (else
          (call decline id)
        )
      )
      (return invalid-type)
      (blank)
      (lazy streamless-text
        (paragraph
          "This pattern has no stream to read; outside a rule, write it in a match whose arms are all ~ patterns"
        )
      )
    )
    (let saved-rule rule-streaming)
    (= rule-streaming (= (. rule-streaming stream) no-type))
    (= rule-streaming (= (. rule-streaming encoded) false))
    (let own-matching matching)
    (let saved-body helping)
    (= matching (= (. matching subject) stream))
    (= matching (= (. matching optional) false))
    (= matching (= (. matching closed) 0))
    (= matching (= (. matching arms) 0))
    (= matching (= (. matching open) false))
    (= matching (= (. matching rows) false))
    (= rule-streaming (= (. rule-streaming matched) id))
    (= helping (= (. helping body) id))
    (let result invalid-type)
    (let item no-type)
    (if (call record-stream-protocol id stream texts)
      (= item buffer-item)
      (= result (call type-stream-arms pattern false))
      (else
        (call decline id)
      )
    )
    (= rule-streaming (= (. rule-streaming matched) 0))
    (let carried-rolls (. helping rolls))
    (= helping saved-body)
    (= helping (= (. helping rolls) carried-rolls))
    (= matching own-matching)
    (= rule-streaming saved-rule)
    (if (== result invalid-type)
      (return invalid-type)
    )
    (if (call (. program probes compiles-metrics) "grammar")
      (call (. facts record-call) instance id no-instance .call-probe-metric (. scratch no-fills) false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) result)
    (return
      (call (. types optional-of)
        (block
          (arg (call (. types class-with-args) (. types capture-result-decl module) (. types capture-result-decl decl) mark))
        )
      )
    )
  )
  (fn-do _ scope-stream TypeId
    ; The stream a function declared over the items of one is given, which a pattern written in
    ; its code runs on. None in a rule, whose pattern is its body, in a function written in
    ; another, and in any other function.
    (let row ([] (. instances rows) instance))
    (if (or (!= (. row enclosing) no-instance) (== (. ([] (. instances signatures) instance) args count) 0) ruled)
      (return no-type)
    )
    (lazy ruled (!= (call rule-match program (. row module) (. row decl)) 0))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (if (and (!= (. syntax pattern) 0) (not (. fn is-generated)))
              (return (call (. instances argument-type) instance 0))
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do + type-stream-arms TypeId
    (param pattern SyntaxId)
    (param texts Bool)
    (param target TypeId (= no-type))
    (param lifts Bool (= true))
    ; The arms of a grammar over the stream in force, typed as the reference declares them
    ; and joined: the names it captures first, then each arm, the text it matched where it gives
    ; no other value. Where the pattern `texts`, as the arms of a match, a pipe or a loop do, an arm
    ; that gives no value gives its text though its last part is optional; elsewhere the reference
    ; gives that part.
    ; The arms are converted to the `target` where one is given, and else to the type they join
    ; as; where an arm gives null or an optional and the target `lifts`, to the `target` as an
    ; optional, which null is absent of.
    (if (and (not (call text-items)) (not (call is-integer (. stream-view item))))
      (let site (call class-error-site pattern))
      (if (== site (. U32 max))
        (call decline pattern)
        (return invalid-type)
      )
      (if (!= site 0)
        (call (. frame diagnose)
          (block
            (arg site)
            (arg .stated)
            (arg (call (. program store-atom) "Character patterns can only match character or integer items"))
          )
        )
        (return invalid-type)
      )
    )
    (let own-arms rule-arming)
    (let base (. capture-sites length))
    (= rule-arming (call RuleArms target false false texts pattern base (. rule-arming casting)))
    (let joined (call arms-type pattern))
    (-= ([] capture-sites (..< base (. capture-sites length))))
    (-= ([] capture-slots (..< base (. capture-slots length))))
    (-= ([] capture-accumulating (..< base (. capture-accumulating length))))
    (-= ([] capture-patterns (..< base (. capture-patterns length))))
    (-= ([] capture-repeats (..< base (. capture-repeats length))))
    (= rule-arming own-arms)
    (if (== joined invalid-type)
      (return invalid-type)
    )
    (let result
      (scope (if-expr (!= target no-type) target joined-text)
        (lazy joined-text (if-expr (== joined no-type) (. types string-type) joined))
      )
    )
    (if (and lifts (!= target no-type) joined-null (not (call (. types is-optional) target)))
      (= result (call (. types optional-of) target))
    )
    (lazy joined-null (or (call (. types is-optional) joined) (== joined (. types null-type))))
    (call convert-stream-arms pattern result)
    (call (. facts set-node-type) instance pattern result)
    (return result)
  )
  (fn-do + arms-type TypeId
    (param pattern SyntaxId)
    ; The arms of a grammar, typed after the names it captures and joined, with what
    ; `settle-captures` then records for those names, and what `results-assumed` settles of the
    ; actions that took their own type for the one the arms give, which is the one they declare
    ; or else join as, text where they give none. While they are typed, `pattern-arms` says whether
    ; an action or a call of this pattern makes a value through the helper (`selects`), which arm is
    ; being typed (`arm`), and that arms are scoped (`scoped`), each of which the
    ; reference gives a scope of its own, so that one name may hold another type in another arm.
    ; Where the arms declare no type and an action is `uninferred`, the reference
    ; takes that arm to give none, so the arms have a shape here only where they give text, which
    ; is what the reference takes them to give then. An arm that made the text it matched as the
    ; type its last part gives, taking that for the type the arms join as, has a shape only where
    ; they join as it.
    (let saved pattern-arms)
    (= pattern-arms (= (. pattern-arms selects) false))
    (= pattern-arms (= (. pattern-arms uninferred) false))
    (= pattern-arms (= (. pattern-arms scoped) true))
    (= pattern-arms (= (. pattern-arms arm) 0))
    (= pattern-arms (= (. pattern-arms joined) (is ([] (. tree nodes) pattern) .node-stream-or)))
    (let assumed (. assumed-results length))
    (let sourced (. assumed-sources length))
    (let joined (if-expr (call type-captures pattern 0) (call stream-arm-type pattern) invalid-type))
    (call note-observed pattern)
    (for (in position (..< sourced (. assumed-sources length)))
      (if (and (!= joined invalid-type) (!= ([] assumed-sources position) joined))
        (call decline pattern)
        (= joined invalid-type)
      )
    )
    (-= ([] assumed-sources (..< sourced (. assumed-sources length))))
    (if (and (!= joined invalid-type) (not (call settle-captures pattern settled-target)))
      (= joined invalid-type)
    )
    (lazy settled-target (if-expr (!= (. rule-arming target) no-type) (. rule-arming target) joined))
    (if (== joined invalid-type)
      (-= ([] assumed-results (..< assumed (. assumed-results length))))
      (else-if (not (call results-assumed assumed (if-expr targeted (. rule-arming target) joined-text) pattern))
        (= joined invalid-type)
      )
    )
    (lazy targeted (!= (. rule-arming target) no-type))
    (lazy joined-text (if-expr (== joined no-type) (. types string-type) joined))
    (if (and (. pattern-arms uninferred) (!= joined invalid-type) (!= joined no-type) (!= joined (. types string-type)))
      (call decline pattern)
      (= joined invalid-type)
    )
    (= pattern-arms saved)
    (return joined)
  )
  (fn-do _ top-arm SyntaxId
    (param node SyntaxId)
    ; The arm of the pattern being typed that a node lies in, or none. The nodes of an arm lie
    ; together, though those of the alternatives that join the arms do not.
    (let arms (list SyntaxId))
    (call stream-arms (. rule-arming capture-root) arms)
    (for (in arm arms)
      (if (and (<= (call (. tree subtree-start) arm) node) (<= node arm))
        (return arm)
      )
    )
    (return 0)
  )
  (fn-do _ enter-arm _
    (param id SyntaxId)
    ; Begins typing an arm of the pattern: each name the arm captures has the type its place in
    ; this arm gave it.
    (= pattern-arms (= (. pattern-arms arm) id))
    (if (not (. pattern-arms scoped))
      (return)
    )
    (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
      (let site ([] capture-sites position))
      (if (and (<= (call (. tree subtree-start) id) site) (<= site id))
        (call (. frame assign) ([] capture-slots position) (call (. facts node-type) instance site))
      )
    )
  )
  (fn-do _ optional-text Bool
    (param id SyntaxId)
    ; Whether a name captured over the text a part of a grammar matched may hold none, as
    ; the reference types it: where the part is optional, or alternatives one of which is. A
    ; sequence holds the text it matched, though the part it ends with may be optional.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-unary row)
        (return (== (. row op) .zero-or-one-op))
      )
      (case (call .node-stream-or row)
        (return (or (call optional-text (. row left)) (call optional-text (. row right))))
      )
      (case (call .node-stream-capture row)
        (return (call optional-text (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call optional-text (. row pattern))))
      )
    )
    (return false)
  )
  (fn-do _ settle-captures Bool
    (param pattern SyntaxId)
    (param result TypeId)
    ; Records what the reference makes through the helper where a part a name captures passes,
    ; whether or not anything reads it, once the arms are typed. An optional part captured as a
    ; whole that gives its text makes it, as the type it holds, but for one literal, whose text
    ; the reference has as a constant, and one of text that actions read, but none for more than
    ; its length, which the reference keeps as the span it matched. Where no action or call of the
    ; pattern makes a value through the helper, a call of a rule that gives its text makes it
    ; too, as the type the rule states, but for one whose name the reference keeps as the span
    ; it matched: a name that holds text, so captured outside optional parts and repeats, and
    ; does not accumulate. Each is made by the capture materializer `record-eager` selects, and
    ; nothing where the helper has none. There, a call in a repeat that states another type
    ; than text, a name an action reads for more than its length, a sequence that ends with
    ; such a call, a count whose bounds are computed, and a helper that delegates what makes the
    ; type the arms give have no shape here. False where the pattern was declined.
    (if (or (== (. helping helper) null) (== (. helping helper captures length) 0))
      (return true)
    )
    (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
      (let name ([] capture-sites position))
      (let part ([] capture-patterns position))
      (if (== (call (. facts plan-of) instance name) .plan-stream-value)
        (continue)
      )
      (let held (call (. facts node-type) instance name))
      (if (!= (call (. tree optional-operand) part) 0)
        (if (or ([] capture-accumulating position) literal-part sourceless)
          (continue)
        )
        (lazy literal-part (is ([] (. tree nodes) (call (. tree optional-operand) part)) .node-stream-string))
        (lazy sourceless (== (. (call source-candidates (call peeled-optional held)) length) 0))
        (if (and (== held (call (. types optional-of) (. types string-type))) read-in (not plain-read))
          (continue)
        )
        (lazy read-in (call reads-slot-in pattern ([] capture-slots position)))
        (lazy plain-read (call reads-plainly pattern ([] capture-slots position)))
        (if (and (not (. pattern-arms selects)) (call delegates-result result))
          (call decline name)
          (return false)
        )
        (if (not (call record-eager part (call peeled-optional held)))
          (return false)
        )
        (continue)
      )
      (if (. pattern-arms selects)
        (continue)
      )
      (let called (call closing-call part))
      (if (== called 0)
        (continue)
      )
      (let stated (call (. facts node-type) instance called))
      (if (or (== (. (call source-candidates stated) length) 0) (call made-at called .material-text))
        (continue)
      )
      (if (or (!= called part) (call (. tree computed-counts) pattern) (call delegates-result result) reads-wide)
        (call decline name)
        (return false)
      )
      (lazy reads-wide (call reads-plainly pattern ([] capture-slots position)))
      (if (and (== stated (. types string-type)) (== held (. types string-type)) (not ([] capture-accumulating position)))
        (continue)
      )
      (if (and (!= stated (. types string-type)) (call is-listed held))
        (call decline name)
        (return false)
      )
      (if (not (call record-eager part stated))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ record-eager Bool
    (param site SyntaxId)
    (param held TypeId)
    ; Records at a part of a grammar the call of the capture materializer that makes a
    ; type of the text the part matched, as the reference's implicit materialization selects it
    ; among those that make that type from the stream's items, which the part makes where it
    ; passes. Nothing where the helper has none. False where the part has no shape, as one over
    ; items that are not characters has none.
    (let candidates (call source-candidates held))
    (if (== (. candidates length) 0)
      (return true)
    )
    (if (not (call text-items))
      (call decline site)
      (return false)
    )
    (let interface (call select-materializer candidates buffer-item held true site))
    (if (== interface invalid-type)
      (return false)
    )
    (if (== interface no-type)
      (return true)
    )
    (return (call record-material site .material-eager no-slot (call second-type-arg interface) interface no-type))
  )
  (fn-do _ closing-call SyntaxId
    (param id SyntaxId)
    ; The call of a rule that gives its text which a part of a grammar is, or which the
    ; sequence it is ends with, or none.
    (match? ([] (. tree nodes) id)
      (case .node-stream-call
        (return (if-expr (== (call (. facts plan-of) instance id) .plan-span-call) id 0))
      )
      (case (call .node-stream-and row)
        (return (call closing-call (. row right)))
      )
      (case (call .node-stream-capture row)
        (return (call closing-call (. row pattern)))
      )
    )
    (return 0)
  )
  (fn-do _ made-at Bool
    (param site SyntaxId)
    (param kind MaterialKind)
    ; Whether the helper makes a value of a kind at a place, as recorded so far.
    (let row (call (. facts first-material) instance site))
    (while (!= row (. U32 max))
      (if (== (. ([] (. facts materials) row) kind) kind)
        (return true)
      )
      (= row (. ([] (. facts materials) row) next))
    )
    (return false)
  )
  (fn-do _ delegates-result Bool
    (param result TypeId)
    ; Whether a materializer that makes what a type holds, past optionals and lists, answers for
    ; the helper through a property the helper delegates it to.
    (let leaf (if-expr (and (!= result no-type) (!= result invalid-type)) (call desired-leaf result) no-type))
    (for (in materializer (. (!! (. helping helper)) captures))
      (if (and (== (call second-type-arg materializer) leaf) (!= (call capability-receiver (. (!! (. helping helper)) participant) materializer) (. (!! (. helping helper)) participant)))
        (return true)
      )
    )
    (for (in materializer (. (!! (. helping helper)) values))
      (if (and (== (call second-type-arg materializer) leaf) (!= (call capability-receiver (. (!! (. helping helper)) participant) materializer) (. (!! (. helping helper)) participant)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ reads-slot-in Bool
    (param pattern SyntaxId)
    (param slot SlotId)
    ; Whether an action of a grammar reads a name.
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-transform row)
          (if (and (!= (. row right) 0) (not (call (. tree lazies-only) (. row right))) (call reads-slot (. row right) slot))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ reads-plainly Bool
    (param pattern SyntaxId)
    (param slot SlotId)
    ; Whether an action of a grammar reads a name for more than its length, through `.` or,
    ; for an optional name, `?.`.
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-transform row)
          (if (and (!= (. row right) 0) slot-read (not (call reads-length-only slot (. row right))) wide-optional)
            (return true)
          )
          (lazy slot-read (and (not (call (. tree lazies-only) (. row right))) (call reads-slot (. row right) slot)))
          (lazy wide-optional (not (call reads-length-only slot (. row right) true)))
        )
      )
    )
    (return false)
  )
  (fn-do _ type-captures Bool
    (param id SyntaxId)
    (param depth U32)
    (param repeats U32 (= 0))
    (param held Bool (= false))
    ; Types the names a grammar captures, as the reference's matchmaker types them: each
    ; the text its part matched, or what a rule the part calls gives, optional within an optional
    ; part, and within a repeat an `ImmutableArray` of what each pass captured. A name captured in
    ; more than one place keeps one type, and its places must be alternatives of one another, so
    ; that no way through the pattern passes two of them; a name may hold another type in
    ; another arm, though, as the reference gives each arm a scope of its own, but for one
    ; captured in a repeat. A name captured in a lookahead,
    ; optional twice over, or in a repeat but for text no optional part holds, has no shape here,
    ; nor has any name but one that accumulates where `held`. A name that accumulates is typed
    ; wherever it is captured but in a count, whose names the reference never declares. A name
    ; captured over a call of a rule that gives its text but states another type has that type,
    ; and holds the text until an action makes it so: under a helper, optional where the call or
    ; a part around it is, and in one repeat a list that keeps the range of each pass. Records
    ; where each name holds text the call that makes it, and for one in a repeat the calls that
    ; grow its lists; plans each that holds a rule's value so. A name captured over a sequence
    ; that ends by testing an item against a value has no shape here: the reference converts the
    ; text the sequence matched to the value's type. False where the pattern was declined.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (if (. row accumulating)
          (return (call type-accumulating id (. row name) (. row pattern)))
        )
        (let inner (call stream-node-type (. row pattern)))
        (if (== inner invalid-type)
          (return false)
        )
        (let slot (call capture-slot (. row name)))
        (if held
          (call decline id)
          (return false)
        )
        (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
          (if (and (== ([] capture-slots position) slot) ([] capture-accumulating position))
            (call (. frame diagnose) id .stated (call (. program store-atom) (str "Capture " (call (. tree name-text) (. row name)) " mixes ordinary and accumulating capture modes")))
            (return false)
          )
        )
        (let valued (or (call stream-valued (. row pattern)) (call takes-item (. row pattern))))
        (let optional (call (. types optional-of) (. types string-type)))
        (if (and (not valued) (== inner optional) (not (call optional-text (. row pattern))))
          (= inner (. types string-type))
        )
        (let type (if-expr (!= depth 0) optional inner))
        (if valued
          (= type (if-expr (!= depth 0) (call (. types optional-of) inner) inner))
        )
        (let shapeless
          (scope (if-expr (not valued) text-mismatch (and (!= depth 0) (call (. types is-optional) inner)))
            (lazy text-mismatch (and (!= inner (. types string-type)) (or (!= inner optional) (!= depth 0))))
          )
        )
        (let sliced
          (scope (and (not (call text-items)) (not valued) pattern-spans (not (call (. tree holds-count) (. row pattern))))
            (lazy pattern-spans (call returns-span instance (. row pattern)))
          )
        )
        (let whole (call (. tree optional-operand) (. row pattern)))
        (let spanned
          (scope (and textless-inner (== (call (. facts plan-of) instance planned-part) .plan-span-call))
            (lazy textless-inner (and (not valued) (!= (call peeled-optional inner) (. types string-type))))
            (lazy planned-part (if-expr (!= whole 0) whole (. row pattern)))
          )
        )
        (if (and spanned (!= whole 0))
          (= type inner)
          (= shapeless
            (scope (or (!= depth 0) (!= repeats 0) (== (. helping helper) null) whole-optional)
              (lazy whole-optional (call (. types is-optional) (call (. facts node-type) instance whole)))
            )
          )
          (else-if (and spanned (!= repeats 0))
            (= type (call listed-type repeats inner))
            (= shapeless
              (scope (or (!= depth 0) (!= repeats 1) (== (. helping helper) null) inner-optional)
                (lazy inner-optional (call (. types is-optional) inner))
              )
            )
          )
          (else-if spanned
            (= type (if-expr (!= depth 0) (call (. types optional-of) inner) inner))
            (= shapeless (and (!= depth 0) (or (== (. helping helper) null) (call (. types is-optional) inner))))
          )
          (else-if sliced
            (= type (. stream-view buffer))
            (= shapeless (or (!= depth 0) (!= repeats 0)))
          )
          (else-if (and (not (call text-items)) (not valued))
            (= shapeless true)
          )
          (else-if (!= repeats 0)
            (= shapeless
              (scope (or (!= depth 0) valued-optional (not (or valued (== inner (. types string-type)))))
                (lazy valued-optional (and valued (call (. types is-optional) inner)))
              )
            )
            (= type (call listed-type repeats (if-expr valued inner (. types string-type))))
          )
        )
        (if (or (== slot no-slot) (> depth 1) shapeless (and valued (call sequence-tests-item (. row pattern))))
          (call decline id)
          (return false)
        )
        (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
          (if (== ([] capture-slots position) slot)
            (let known (call (. facts node-type) instance ([] capture-sites position)))
            (let apart
              (scope (and (. pattern-arms scoped) other-arm unrepeated (== repeats 0))
                (lazy other-arm (!= (call top-arm ([] capture-sites position)) (call top-arm (. row name))))
                (lazy unrepeated (== ([] capture-repeats position) 0))
              )
            )
            (if (not (call alternatives ([] capture-sites position)))
              (call (. frame diagnose) id .stated (call (. program store-atom) (str "Capture " (call (. tree name-text) (. row name)) " is captured twice on one way through the pattern")))
              (return false)
            )
            (if (and (!= known type) (not apart))
              (let shown
                (paragraph
                  (str (call type-short-name types known) " in one alternative and " (call type-short-name types type) " in another")
                )
              )
              (call (. frame diagnose) id .stated (call (. program store-atom) (str "Capture " (call (. tree name-text) (. row name)) " holds " shown)))
              (return false)
            )
          )
        )
        (if valued
          (call (. facts set-plan) instance (. row name) .plan-stream-value)
          (if (call takes-item (. row pattern))
            (call (. facts set-node-type) instance (. row pattern) inner)
          )
          (if (and (!= repeats 0) (not (call record-collectors (. row name) repeats inner)))
            (call decline id)
            (return false)
          )
          (else-if sliced
            (call (. facts set-plan) instance (. row name) .plan-stream-slice)
          )
          (else-if (not (call record-stream-text (. row name)))
            (call decline id)
            (return false)
          )
          (else
            (let ranged (and spanned (!= repeats 0)))
            (if (and (not ranged) (!= repeats 0) (!= (. helping helper) null))
              (let found (call ranged-capture id slot))
              (if (== found null)
                (return false)
              )
              (= ranged found)
            )
            (let item (if-expr ranged (. types pattern-capture-range-type) (. types string-type)))
            (if (and ranged (!= repeats 1))
              (call decline id)
              (return false)
            )
            (if (not (call record-collectors (. row name) repeats item))
              (call decline id)
              (return false)
            )
            (if ranged
              (call (. facts record-material)
                (block
                  (arg
                    (call MaterialFact
                      (block
                        (arg instance)
                        (arg (. row name))
                        (arg .material-ranges)
                        (arg slot)
                        (arg (call class-over (. types immutable-array-decl) item))
                        (arg no-type)
                        (arg no-fact)
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (call (. frame assign) slot type)
        (call (. facts set-node-type) instance (. row name) type)
        (+= capture-sites (. row name))
        (+= capture-slots slot)
        (+= capture-accumulating false)
        (+= capture-patterns (. row pattern))
        (+= capture-repeats repeats)
        (return (call type-captures (. row pattern) depth repeats))
      )
      (case (call .node-stream-and row)
        (return (and (call type-captures (. row left) depth repeats held) (call type-captures (. row right) depth repeats held)))
      )
      (case (call .node-stream-or row)
        (if (not (call type-captures (. row left) depth repeats held))
          (return false)
        )
        (+= right-arms id)
        (let passes (call type-captures (. row right) depth repeats held))
        (call (. right-arms pop))
        (return passes)
      )
      (case (call .node-stream-transform row)
        (return (call type-captures (. row pattern) depth repeats held))
      )
      (case (call .node-stream-panic row)
        (return (call type-captures (. row pattern) depth repeats held))
      )
      (case (call .node-stream-unary row)
        (if (== (. row op) .zero-or-one-op)
          (return (call type-captures (. row operand) (+ depth 1) repeats held))
        )
        (let repeat (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op)))
        (if (and repeat (== depth 0) (not held) (call listable (. row operand) (. row operand)))
          (return (call type-captures (. row operand) 0 (+ repeats 1)))
        )
        (return (call type-captures (. row operand) depth repeats true))
      )
      (case (call .node-stream-length row)
        (return (call captures-none (. row operand)))
      )
    )
    (return true)
  )
  (fn-do _ type-accumulating Bool
    (param id SyntaxId)
    (param name SyntaxId)
    (param pattern SyntaxId)
    ; Types a name that accumulates what its part gives each time the part passes, wherever it
    ; is captured, as the reference types one: an `ImmutableArray` of what the part gives, the
    ; text it matched or what a rule it calls gives, which every place that captures the name
    ; must give alike. Records where the part gives text the call that makes it, and the call
    ; that grows the list the match keeps of them. A name captured both so and plainly is
    ; TypeScript's error at the later place, as is a part that gives another type than the first.
    ; One over items that are not characters, or whose part gives an optional, has no shape here.
    (let inner (call stream-node-type pattern))
    (if (== inner invalid-type)
      (return false)
    )
    (let slot (call capture-slot name))
    (if (== slot no-slot)
      (call decline id)
      (return false)
    )
    (let text (call (. tree name-text) name))
    (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
      (if (and (== ([] capture-slots position) slot) (not ([] capture-accumulating position)))
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg (call (. program store-atom) (str "Capture " text " mixes ordinary and accumulating capture modes")))
          )
        )
        (return false)
      )
    )
    (let valued (call stream-valued pattern))
    (if (or (not (call text-items)) (call (. types is-optional) inner) (and (not valued) (!= inner (. types string-type))))
      (call decline id)
      (return false)
    )
    (let list (call class-over (. types immutable-array-decl) inner))
    (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
      (if (== ([] capture-slots position) slot)
        (let first (call (. facts node-type) instance ([] capture-sites position)))
        (if (!= first list)
          (let given (call class-arg types first 0))
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        (str "Accumulating capture " text " has incompatible contribution types " (call type-key types given) " and " (call type-key types inner))
                      )
                    )
                  )
                )
              )
              (arg given)
              (arg inner)
            )
          )
          (return false)
        )
        (break)
      )
    )
    (if valued
      (call (. facts set-plan) instance name .plan-stream-value)
      (else-if (not (call record-stream-text name))
        (call decline id)
        (return false)
      )
    )
    (if (not (call record-collectors name 1 inner))
      (call decline id)
      (return false)
    )
    (call (. frame assign) slot list)
    (call (. facts set-node-type) instance name list)
    (+= capture-sites name)
    (+= capture-slots slot)
    (+= capture-accumulating true)
    (+= capture-patterns pattern)
    (+= capture-repeats 0)
    (return (call type-captures pattern 0 0 true))
  )
  (fn-do _ accumulates Bool
    (param slot SlotId)
    ; Whether a name the match captures accumulates what its parts give.
    (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
      (if (== ([] capture-slots position) slot)
        (return ([] capture-accumulating position))
      )
    )
    (return false)
  )
  (fn-expr _ capture-slot SlotId
    (param name SyntaxId)
    (if-expr (== (. resolution kind) .resolve-slot) (. resolution slot) no-slot)
    (where
      (lazy resolution (call (. bindings resolution-of) (. frame binding) name))
    )
  )
  (fn-do _ alternatives Bool
    (param earlier SyntaxId)
    ; Whether a place a name was captured lies in an alternative tried before one the pattern is
    ; being typed in, so that no way through the pattern passes both.
    (for (in arm right-arms)
      (match? ([] (. tree nodes) arm)
        (case (call .node-stream-or row)
          (if (and (>= earlier (call (. tree subtree-start) (. row left))) (<= earlier (. row left)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ listed-type TypeId
    (param repeats U32)
    (param item TypeId)
    ; The type of a name captured in repeats nested this deep: an `ImmutableArray` of what each
    ; pass captured, the text or the item, for each.
    (let type item)
    (for (in level (..< 0 repeats))
      (= type (call class-over (. types immutable-array-decl) type))
    )
    (return type)
  )
  (fn-do _ record-collectors Bool
    (param name SyntaxId)
    (param repeats U32)
    (param first TypeId)
    ; Records at a name captured in repeats nested this deep the call that grows the list each
    ; repeat keeps of what its passes captured, from the innermost out: a `PatternCollector` of
    ; what one pass captured, the text or the item, then of the lists the repeat inside it made.
    (let item first)
    (for (in level (..< 0 repeats))
      (let collector (call collector-over item))
      (if (== collector invalid-type)
        (return false)
      )
      (if (!= (. (call (. calls protocol-call) collector (call (. program store-atom) "grow") name (:role (. CallRole role-grow))) answer) (call grown-items collector))
        (return false)
      )
      (= item (call class-over (. types immutable-array-decl) item))
    )
    (return true)
  )
  (fn-do _ collector-over TypeId
    (param item TypeId)
    ; The `PatternCollector` a grammar keeps a list of items of a type in, as the
    ; reference makes it: backed as the helper of the pattern keeps collectors, which the body
    ; then reads the context of where it makes one, and else by the collector. A match without
    ; such a helper in a rule whose own helper keeps collectors has no shape here, and the rule
    ; is typed for its helper so that the call of it has none either.
    (let decl (. types pattern-collector-decl))
    (if (== (. decl module) 0)
      (return invalid-type)
    )
    (let backing (. types gc-backing-type))
    (if (and (!= (. helping helper) null) (!= (. helping helper storage) no-type))
      (if (not (call note-storage))
        (return invalid-type)
      )
      (= backing (. (!! (. helping helper)) storage))
      (else-if (and (!= rule-helper-site 0) (!= (. helping site) rule-helper-site) (call rule-stores))
        (= (. ([] (. instances rows) instance) uses-helper) true)
        (return invalid-type)
      )
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) backing)
    (return (call (. types class-with-args) (. decl module) (. decl decl) mark))
  )
  (fn-do _ grown-items TypeId
    (param collector TypeId)
    ; The `Array` a `PatternCollector` keeps its items in: of its item, with its backing.
    (let item (call class-arg types collector 0))
    (let backing (call class-arg types collector 1))
    (if (== backing (. types gc-backing-type))
      (return (call class-over (. types array-decl) item))
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (call (. scratch types push) backing)
    (return (call (. types class-with-args) (. types array-decl module) (. types array-decl decl) mark))
  )
  (fn-do _ note-storage Bool
    ; Notes that the body being typed keeps the items of its collectors where the helper says:
    ; the property read from the helper for the context, which answers `pattern-collector-context`
    ; for it, is recorded once, at the body, with the getter that answers it where the helper
    ; stores none, after the properties the helper delegates its collector storage through. A rule
    ; typed for the helper uses it so. False where the body or the property has no shape here.
    (if (or (== (. helping body) 0) (== (. (!! (. helping helper)) storage) invalid-type))
      (return false)
    )
    (if (== (call (. facts storage-body-of) instance (. helping body)) (. U32 max))
      (let participant (. (!! (. helping helper)) participant))
      (let receiver (call capability-receiver (. (!! (. helping helper)) participant) ([] (. (!! (. helping helper)) storages) 0)))
      (let places (list U32))
      (if (or (== receiver no-type) (and (!= receiver participant) (not (call (. calls ranking delegate-path) participant receiver places))))
        (return false)
      )
      (let found (call property-named receiver (call (. program store-atom) "pattern-collector-context")))
      (if (not found)
        (return false)
      )
      (let property ([] (. types properties) found))
      (if (or (== (. property type) no-type) (== (. property type) invalid-type))
        (return false)
      )
      (+= places (as found U32))
      (let steps (call (. facts keep-steps) places (call (. calls step-getters) places (. helping body))))
      (call (. facts add-storage-body) (call StorageBody instance (. helping body) steps (. property type)))
    )
    (call note-helper-use false)
    (return true)
  )
  (fn-do _ rule-stores Bool
    ; Whether the helper a rule this instance types is given keeps collectors where it says.
    (let given (. ([] (. instances rows) instance) helper))
    (if (== given no-type)
      (let position (call ambient-position types instances instance))
      (if (== position (. U32 max))
        (return false)
      )
      (= given (call (. instances argument-type) instance position))
    )
    (return (!= (. (call pattern-helper types given) storage) no-type))
  )
  (fn-do _ listable Bool
    (param id SyntaxId)
    (param operand SyntaxId)
    ; Whether the names a repeat's part captures can be kept as lists: each is captured on every
    ; way the part passes, and the part runs no action. A name that accumulates keeps no list.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (if (. row accumulating)
          (return (call listable (. row pattern) operand))
        )
        (let slot (call capture-slot (. row name)))
        (return (and (!= slot no-slot) (call covers operand slot) (call listable (. row pattern) operand)))
      )
      (case (call .node-stream-and row)
        (return (and (call listable (. row left) operand) (call listable (. row right) operand)))
      )
      (case (call .node-stream-or row)
        (return (and (call listable (. row left) operand) (call listable (. row right) operand)))
      )
      (case (call .node-stream-unary row)
        (return (call listable (. row operand) operand))
      )
      (case (call .node-stream-length row)
        (return (call listable (. row operand) operand))
      )
      (case .node-stream-transform
        (return false)
      )
      (case .node-stream-panic
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ holds Bool
    (param id SyntaxId)
    (param slot SlotId)
    ; Whether a part of a pattern captures a name anywhere in it.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (return (or (== (call capture-slot (. row name)) slot) (call holds (. row pattern) slot)))
      )
      (case (call .node-stream-and row)
        (return (or (call holds (. row left) slot) (call holds (. row right) slot)))
      )
      (case (call .node-stream-or row)
        (return (or (call holds (. row left) slot) (call holds (. row right) slot)))
      )
      (case (call .node-stream-unary row)
        (return (call holds (. row operand) slot))
      )
      (case (call .node-stream-length row)
        (return (call holds (. row operand) slot))
      )
    )
    (return false)
  )
  (fn-do _ captures-none Bool
    (param id SyntaxId)
    (param quiet Bool (= false))
    ; Whether a part of a pattern captures no name, declining the first that does where it is not
    ; `quiet`.
    (for (in node (..< (call (. tree subtree-start) id) (+ id 1)))
      (if (is ([] (. tree nodes) node) .node-stream-capture)
        (if (not quiet)
          (call decline node)
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ is-capture Bool
    (param slot SlotId)
    (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
      (if (== ([] capture-slots position) slot)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ covers Bool
    (param id SyntaxId)
    (param slot SlotId)
    ; Whether a pattern gives a name the match captures a value on every way it passes. An
    ; optional part gives the names in it nothing where it does not pass; a repeat gives each a
    ; list, empty where it took its part no time.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (return (or (== (call capture-slot (. row name)) slot) (call covers (. row pattern) slot)))
      )
      (case (call .node-stream-and row)
        (return (or (call covers (. row left) slot) (call covers (. row right) slot)))
      )
      (case (call .node-stream-or row)
        (return (and (call covers (. row left) slot) (call covers (. row right) slot)))
      )
      (case (call .node-stream-unary row)
        (if (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op))
          (return (call holds (. row operand) slot))
        )
        (return (and (== (. row op) .zero-or-one-op) (call covers (. row operand) slot)))
      )
    )
    (return false)
  )
  (fn-do _ uncovered-read SyntaxId
    (param pattern SyntaxId)
    (param body SyntaxId)
    ; Where an action reads a name the match captures that may hold no value on some way the
    ; action's pattern passes, or none where each holds one: the reference leaves one that an
    ; alternative not taken captures unset. A name that accumulates always holds its list. A
    ; function the action makes reads only names that hold one value each, as `reads-captures`
    ; says, and is where it reads another.
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let slot (call capture-slot node))
          (if (and (!= slot no-slot) (call is-capture slot) (not (call accumulates slot)) (not (call covers pattern slot)))
            (return node)
          )
        )
        (case .node-function-syntax
          (if (and (!= (. capture-sites length) (. rule-arming capture-base)) (call reads-captures node))
            (return node)
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ unplain-slice SyntaxId
    (param body SyntaxId)
    ; Where an action reads a name captured as a slice of a stream that holds no characters for
    ; more than its length or an item of it, or none. The reference types the name as an
    ; `ImmutableArray` but gives it the `Array` it reads, which shares the stream's buffer, and the
    ; two agree only there.
    (let receivers (list SyntaxId))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-get-expression row)
          (if (and (== (. row name) (!! (. types length-atom))) (not (. row is-optional)))
            (+= receivers (. row object))
          )
        )
        (case (call .node-index-expression row)
          (if (not (. row is-optional))
            (+= receivers (. row object))
          )
        )
      )
    )
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (if (is ([] (. tree nodes) node) .node-identifier)
        (let slot (call capture-slot node))
        (if (and (!= slot no-slot) (call is-capture slot) sliced (== (call (. receivers find) node) null))
          (return node)
        )
        (lazy sliced (== (call (. facts plan-of) instance (. ([] (. bindings slots) slot) syntax)) .plan-stream-slice))
      )
    )
    (return 0)
  )
  (fn-do _ reads-captures Bool
    (param function SyntaxId)
    ; Whether a function an action makes reads a name the match captures that holds more than the
    ; one value the function takes as it is made: one that collects what its parts give, or any
    ; under a helper, which makes the action's values. The binder records what the function reads
    ; of the function around it; one it kept no record of is taken to.
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) function)
        (for (in index (..< 0 (. nested captures count)))
          (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
          (if (and (call is-capture slot) (or (!= (. helping helper) null) (call collects slot)))
            (return true)
          )
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ collects Bool
    (param slot SlotId)
    ; Whether a name the match captures collects what its parts give: one that accumulates, or one
    ; written inside a repeat.
    (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
      (if (and (== ([] capture-slots position) slot) gathers)
        (return true)
      )
      (lazy gathers (or ([] capture-accumulating position) (!= ([] capture-repeats position) 0)))
    )
    (return false)
  )
  (fn-do _ outlines Bool
    (param pattern SyntaxId)
    (param body SyntaxId)
    (param value TypeId)
    ; Whether the reference runs an action in a function of its own, `stream-action`, which a
    ; panic in it would show: one with a pattern, whose value is not String and holds no function,
    ; in a function with no type parameters, a rule's own item type aside, that is more than a
    ; name, a number or text written alone, makes no function, and reads no local of the
    ; functions it is in but the names its match captures, `it` and `location`, none of which
    ; holds a function. The reference asks some of this by the names the action reads, so for an
    ; action that reads a name a local of its function also has the answer is not sure, which
    ; `outline-unsure` says. An action that names `This` is kept inline, as the reference finds
    ; no such type in the module.
    (= outline-unsure false)
    (if (or (== pattern 0) (== value (. types string-type)) (call (. tree trivial-action) body))
      (return false)
    )
    (let params (. ([] (. instances signatures) instance) param-count))
    (let item-params (if-expr (!= (call rule-match program module (. frame decl)) 0) 1u32 0u32))
    (if (> params item-params)
      (return false)
    )
    (if (call holds-function value)
      (return false)
    )
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-function-syntax
          (return false)
        )
        (case (call .node-type-identifier row)
          (if (and (. types this-atom) (== (. row name) (. types this-atom)))
            (return false)
          )
        )
        (case (call .node-identifier row)
          (if (and (. types this-atom) (== (. row name) (. types this-atom)))
            (return false)
          )
          (let slot (call capture-slot node))
          (let declared (only-if ([] (. bindings slots) slot) (if (!= slot no-slot))))
          (let inside
            (scope (and declared (>= (. declared syntax) body-start) (<= (. declared syntax) body))
              (lazy body-start (call (. tree subtree-start) body))
            )
          )
          (if (or (not declared) inside)
            (if (call named-before (. row name) body)
              (= outline-unsure true)
            )
            (else-if (or (== (. declared kind) .slot-it) (== (. declared kind) .slot-location) (call is-capture slot))
              (if (call holds-function (call (. frame slot-type) slot))
                (return false)
              )
            )
            (else
              (return false)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ named-before Bool
    (param name Atom)
    (param body SyntaxId)
    ; Whether a local of the function an action is in has a name: one declared before the
    ; action, in a scope the action is in.
    (let bound ([] (. bindings bindings) (. frame binding)))
    (let start (call (. tree subtree-start) body))
    (for (in offset (..< 0 (. bound slots count)))
      (let other ([] (. bindings slots) (+ (. bound slots start) offset)))
      (if (or (!= (. other name) name) (>= (. other syntax) start))
        (continue)
      )
      (let held (. ([] (. bindings scopes) (. other scope)) syntax))
      (if (or (== held 0) (and (<= (call (. tree subtree-start) held) start) (<= body held)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ holds-function Bool
    (param type TypeId)
    ; Whether a type holds a function anywhere in it: a closure, a binding or a function type, or a
    ; field, case, argument or property of one that does.
    (let seen (list TypeId))
    (let waiting (list TypeId))
    (+= waiting type)
    (while (!= (. waiting length) 0)
      (let next ([] waiting (- (. waiting length) 1)))
      (call (. waiting pop))
      (if (or (== next no-type) (== next invalid-type) (!= (call (. seen find) next) null))
        (continue)
      )
      (+= seen next)
      (match? ([] (. types rows) next)
        (case .type-closure
          (return true)
        )
        (case .type-binding
          (return true)
        )
        (case .type-function
          (return true)
        )
        (case (call .type-tuple row)
          (for (in position (..< 0 (. row fields count)))
            (+= waiting (call (. types child-type) (. row fields) position))
          )
        )
        (case (call .type-union row)
          (for (in position (..< 0 (. row cases count)))
            (+= waiting (call (. types child-type) (. row cases) position))
          )
        )
        (case (call .type-named-union row)
          (for (in position (..< 0 (. row cases count)))
            (+= waiting (call (. types child-type) (. row cases) position))
          )
        )
        (case (call .type-class row)
          (for (in position (..< 0 (. row args count)))
            (+= waiting (call (. types child-type) (. row args) position))
          )
          (for (in property (call (. types properties-of) next))
            (+= waiting (. property type))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ note-outlined-action _
    (param arm SyntaxId)
    (param body SyntaxId)
    (param it-type TypeId)
    ; Records an action the reference runs in a function of its own, with the names it gives the
    ; function: `location`, `it` and the names the match captures, in the order the action first
    ; reads them, each of the type the arm gives it, which a helper may have made another.
    (let start U32 (as (. facts action-slots length) U32))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let slot (call capture-slot node))
          (let type no-type)
          (if (!= slot no-slot)
            (let row ([] (. bindings slots) slot))
            (if (and (== (. row kind) .slot-location) (== (. row syntax) arm))
              (= type (. types match-location-type))
              (else-if (and (== (. row kind) .slot-it) (== (. row syntax) arm))
                (= type it-type)
              )
              (else-if (call is-capture slot)
                (= type (call (. frame known) slot))
              )
            )
          )
          (let known false)
          (for (in position (..< start (. facts action-slots length)))
            (= known (or known (== ([] (. facts action-slots) position) slot)))
          )
          (if (and (!= type no-type) (not known))
            (call (. facts action-slots append) slot)
            (call (. facts action-types append) type)
          )
        )
      )
    )
    (let count U32 (as (- (. facts action-slots length) start) U32))
    (call (. facts outlined append)
      (block
        (arg (call OutlinedAction instance arm (call (of RowRange U32) start count) no-type outline-unsure))
      )
    )
  )
  (fn-do + record-stream-protocol Bool
    (param id SyntaxId)
    (param subject TypeId)
    (param encoded Bool (= false))
    ; Records at a grammar the calls the reference makes to run it on the value a match is
    ; on, in order: the stream it reads the value through, the stream's `pattern-view`, its
    ; `pattern-commit` of where the pattern ended and how far it read, and its `pattern-extend`. What a value is is what it
    ; is `supported` as. A value that is a stream
    ; is read as the `TokenStream` it is, converted to that interface, through the view of its
    ; UTF-8 bytes where it is a `TextTokenStream` or the stream given to a function a pattern on a
    ; String calls, which is `encoded`. A String is read through a `TextTokenStream` of
    ; it, whose buffer holds its UTF-8 bytes. A generator is read
    ; through a `ChunkedTokenStream` of its items, which pulls them as the pattern needs them. So
    ; is a stream of items a parameter is written as, `<T>`, which the reference passes as a
    ; generator and which is the `CursorIterable` it is here, given its `Iterable`; and a value
    ; that is `ByteReadable`, given it as that interface, whose items are what it is `Decodable`
    ; as, else bytes. An Array is read as an `ArrayTokenStream` of its items, any other
    ; value that is `Indexable` as an `IndexableTokenStream`, and one that is only `Iterable`
    ; through a `ChunkedTokenStream`, each given it as that interface.
    (if (or (== subject invalid-type) (== subject no-type))
      (return false)
    )
    (let kind (call (. types intrinsic-of) subject))
    (let given
      (scope (if-expr (or (== kind .class) (== kind .interface)) stream-support no-type)
        (lazy stream-support (call supported subject (. types token-stream-decl)))
      )
    )
    (let ref (call class-ref types subject))
    (if (!= given no-type)
      (if (and retyped (== (call (. conversions convert) id id subject given .reason-argument) invalid-type))
        (return false)
      )
      (lazy retyped (!= subject given))
      (return
        (call record-stream-view
          (block
            (arg id)
            (arg given)
            (arg (call first-arg given))
            (arg (or encoded (call same-decl ref (. types text-token-stream-decl))))
          )
        )
      )
    )
    (let mark (. scratch types mark))
    (let item no-type)
    (let made (. types array-token-stream-decl))
    (let texts (== subject (. types string-type)))
    (if texts
      (= item (call (. types type-row) .char))
      (= made (. types text-token-stream-decl))
      (call (. scratch types push) subject)
      (else-if (call same-decl ref (. types generator-decl))
        (= item (call first-arg subject))
        (= made (. types chunked-token-stream-decl))
        (call (. scratch types push) subject)
      )
      (else-if (and (== kind .interface) (call same-decl ref (. types cursor-iterable-decl)))
        (= item (call first-arg subject))
        (let iterable (call class-over (. types iterable-decl) item))
        (if (or (== item no-type) (== (call (. conversions convert) id id subject iterable .reason-argument) invalid-type))
          (return false)
        )
        (= made (. types chunked-token-stream-decl))
        (call (. scratch types push) iterable)
      )
      (else
        (if (and (!= kind .class) (!= kind .struct) (!= kind .tuple) (!= kind .interface))
          (return false)
        )
        (let readable (call supported subject (. types byte-readable-decl)))
        (let indexable (if-expr (== readable no-type) (call supported subject (. types indexable-decl)) no-type))
        (let iterable
          (scope (if-expr (and (== readable no-type) (== indexable no-type)) iterable-support no-type)
            (lazy iterable-support (call supported subject (. types iterable-decl)))
          )
        )
        (let read readable)
        (if (!= readable no-type)
          (let decodable (call supported subject (. types decodable-decl)))
          (= item (if-expr (!= decodable no-type) (call first-arg decodable) (call (. types type-row) .uint8)))
          (= made (. types chunked-token-stream-decl))
          (else-if (!= indexable no-type)
            (= item (call first-arg indexable))
            (= read (if-expr (call same-decl ref (. types array-decl)) no-type indexable))
            (if (!= read no-type)
              (= made (. types indexable-token-stream-decl))
            )
          )
          (else-if (!= iterable no-type)
            (= item (call first-arg iterable))
            (= read iterable)
            (= made (. types chunked-token-stream-decl))
          )
          (else
            (return false)
          )
        )
        (if (== read no-type)
          (call (. scratch types push) subject)
          (else
            (if (== (call (. conversions convert) id id subject read .reason-argument) invalid-type)
              (call (. scratch types rewind) mark)
              (return false)
            )
            (call (. scratch types push) read)
          )
        )
      )
    )
    (if (or (== (. made module) 0) (== item no-type))
      (call (. scratch types rewind) mark)
      (return false)
    )
    (let stream
      (block
        (case? texts
          (call (. types class-with-args) (. made module) (. made decl) (. scratch types mark))
        )
        (default
          (call class-over made item)
        )
      )
    )
    (let constructs (call (. calls demand-constructor) stream mark))
    (call (. scratch types rewind) mark)
    (if (== constructs no-instance)
      (return false)
    )
    (call (. facts record-call) instance id constructs .call-constructor (. scratch no-fills) false (:role (. CallRole role-stream)))
    (return (call record-stream-view id stream item texts))
  )
  (fn-do _ record-stream-view Bool
    (param id SyntaxId)
    (param stream TypeId)
    (param item TypeId)
    (param encoded Bool)
    ; Records at a grammar the calls the reference makes of the stream it runs on, in
    ; order: its view of its buffer, which is its `pattern-text-view` of the UTF-8 bytes of its
    ; characters where it is `encoded` and else its `pattern-view`, its `pattern-commit`, and its
    ; `pattern-extend`, which a stream that may give more input is asked where the pattern reads
    ; past the end of its buffer.
    (let view (call (. calls protocol-getter) stream (call view-name encoded) id .role-view))
    (if (not (call (. types is-optional) view))
      (return false)
    )
    (let buffer (call field-of (call (. types optional-inner) view) 0))
    (if (and encoded (!= (call class-arg types buffer 0) (call (. types type-row) .uint8)))
      (return false)
    )
    (if (== (. (call (. calls protocol-call) stream (call (. program store-atom) "pattern-commit") id (. types index-type) false (. types index-type) (:role (. CallRole role-commit))) answer) invalid-type)
      (return false)
    )
    (= stream-view (= (. stream-view buffer) buffer))
    (= stream-view (= (. stream-view type) stream))
    (= stream-view (= (. stream-view item) item))
    (return (== (. (call (. calls protocol-call) stream (call (. program store-atom) "pattern-extend") id (:role (. CallRole role-extend))) answer) (. types bool-type)))
  )
  (fn-do + record-growth Bool
    (param stream TypeId)
    (param id SyntaxId)
    (param encoded Bool)
    ; Records at a pattern a function runs on a stream it is given the calls the reference makes of a
    ; stream that may give more input where the pattern reads past the end of its buffer, in order:
    ; the stream's view of its buffer, as `view-name` names it for a function that is `encoded`,
    ; which gives the buffer it then holds, and its `pattern-extend`.
    (if (not (call (. types is-optional) (call (. calls protocol-getter) stream (call view-name encoded) id .role-view)))
      (return false)
    )
    (return (== (. (call (. calls protocol-call) stream (call (. program store-atom) "pattern-extend") id (:role (. CallRole role-extend))) answer) (. types bool-type)))
  )
  (fn-do _ stream-arm-type TypeId
    (param id SyntaxId)
    ; The type of the arms of a grammar, joined as the reference joins them, in the order
    ; written. An arm that raises gives none. An arm with no expression, or one whose body only
    ; declares lazy locals, gives the text its pattern matched, or what a rule its pattern calls
    ; gives. One whose pattern is one literal gives that text as it is, which no helper makes. One
    ; whose body only declares lazy locals and that would ask the helper for a rollback mark has
    ; no shape here. In a rule that states the `CaptureSpan` of its stream's items, each arm gives
    ; the span of the items it matched; elsewhere an arm that gives a span a rule gave, which the
    ; reference reads as text, has no shape here. An arm with no expression that is a sequence of
    ; parts gives the text it matched whatever its last part gives, made as the type the arms
    ; give, where its rule has other arms, where that type is text, which leaves the last part's
    ; value unmade where the arm is alone, where it is optional text and the arm has others or is
    ; alone in arms that state no type and give their text, though not where the arms give their
    ; text whatever their last part gives, or where the helper makes that type of
    ; the stream's items; one that the reference would make of text as a type nothing makes of it
    ; has no shape here. Where the arms state no type, that type is the one the arm's last part
    ; gives, which `arms-type` holds the other arms to. An arm that only looks ahead gives the
    ; text it matched, none, though it joins the other arms as the type of what it looks for, as
    ; the reference declares it, where the arms state text or no type and those then join as text.
    (call note-observer)
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (let left (call stream-arm-type (. row left)))
        (let right (call stream-arm-type (. row right)))
        (return (call join-stream-types id left right))
      )
    )
    (call enter-arm id)
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (if (or (== (. row pattern) 0) (not (call (. tree lazies-only) (. row right))))
          (return (call stream-action-type id (. row pattern) (. row right)))
        )
        (if (or (. row rollback) (. helping explicit))
          (call decline id)
          (return invalid-type)
        )
      )
      (case (call .node-stream-panic row)
        (call check-stream-panic id (. row pattern))
        (return no-type)
      )
    )
    (if (call spans-source (. rule-arming target))
      (return (call span-arm-type id))
    )
    (let sequence (call arm-sequence id))
    (let alone (and sequence (not (. pattern-arms joined)) (== (. rule-arming target) (. types string-type))))
    (let kept valuing)
    (if alone
      (= valuing (= (. valuing unvalued) true))
    )
    (let matched (call stream-node-type id))
    (= valuing kept)
    (if (== matched invalid-type)
      (return invalid-type)
    )
    (if (and sequence (call stream-valued id))
      (let wanted (if-expr (== (. rule-arming target) no-type) matched (. rule-arming target)))
      (let optional-text (call (. types optional-of) (. types string-type)))
      (let spanned (and (== (. rule-arming target) no-type) (call returns-span instance (. rule-arming capture-root))))
      (let optional (and (== wanted optional-text) (or (. pattern-arms joined) spanned)))
      (let makes
        (scope (or (== wanted (. types string-type)) optional helper-made)
          (lazy helper-made (and (!= (. helping helper) null) (!= (. (call source-candidates wanted) length) 0)))
        )
      )
      (if (or (. pattern-arms joined) makes)
        (if (or (not makes) (not (call text-items)) (call observes-span matched) (not stream-and))
          (call decline id)
          (return invalid-type)
        )
        (lazy stream-and (is ([] (. tree nodes) id) .node-stream-and))
        (let sourced (call record-source-text id wanted))
        (if (== sourced invalid-type)
          (call decline id)
          (return invalid-type)
        )
        (let given (if-expr (and optional (== sourced (. types string-type))) optional-text sourced))
        (if (and (== (. rule-arming target) no-type) (. pattern-arms joined))
          (+= assumed-sources given)
        )
        (call (. facts set-node-type) instance id sourced)
        (return given)
      )
    )
    (if (call stream-valued id)
      (if (call observes-span matched)
        (call decline id)
        (return invalid-type)
      )
      (call plan-valued id)
      (else
        (let texted
          (scope (and (. rule-arming texts) (== matched (call (. types optional-of) (. types string-type))) arm-spans)
            (lazy arm-spans (call returns-span instance id))
          )
        )
        (let ahead
          (scope (and (!= matched (. types string-type)) (call looks-ahead id) text-target)
            (lazy text-target (or (== (. rule-arming target) no-type) (== (. rule-arming target) (. types string-type))))
          )
        )
        (let whole
          (scope (and joined-target (== matched (call (. types optional-of) (. types string-type))))
            (lazy joined-target (and sequence (. pattern-arms joined) (!= (. rule-arming target) no-type)))
          )
        )
        (let lone
          (scope (and (not texted) lone-arm (== matched (call (. types optional-of) (. types string-type))) lone-spans)
            (lazy lone-arm (and sequence (not (. pattern-arms joined)) (== (. rule-arming target) no-type)))
            (lazy lone-spans (call returns-span instance id))
          )
        )
        (let recorded
          (scope (if-expr literal (call sliced-text id) (call record-source-text id wanted-text))
            (lazy literal (call (. tree literal-arm) id))
            (lazy wanted-text
              (block
                (case? (!= (. rule-arming target) no-type)
                  (. rule-arming target)
                )
                (default
                  (. types string-type)
                )
              )
            )
          )
        )
        (if (or untextual (not (call text-items)) (== recorded invalid-type))
          (call decline id)
          (return invalid-type)
        )
        (lazy untextual (and (!= matched (. types string-type)) (not texted) (not ahead) (not whole) (not lone)))
        (if (and ahead (== (. rule-arming target) no-type))
          (+= assumed-sources recorded)
          (call (. facts set-node-type) instance id recorded)
          (return matched)
        )
        (if lone
          (call (. facts set-node-type) instance id recorded)
          (return matched)
        )
        (= matched recorded)
      )
    )
    (call (. facts set-node-type) instance id matched)
    (return matched)
  )
  (fn-do _ arm-sequence Bool
    (param id SyntaxId)
    ; Whether an arm that runs no expression is a sequence of parts, alone or under lazy locals
    ; it only declares.
    (match? ([] (. tree nodes) id)
      (case .node-stream-and
        (return true)
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call arm-sequence (. row pattern))))
      )
    )
    (return false)
  )
  (fn-do _ looks-ahead Bool
    (param id SyntaxId)
    ; Whether an arm's pattern only looks ahead, for a part there or not.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-unary row)
        (return (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call looks-ahead (. row pattern))))
      )
    )
    (return false)
  )
  (fn-do _ plan-valued _
    (param id SyntaxId)
    ; Plans a part of a grammar as giving what a rule it calls gives, unless it is a call of
    ; a pattern given to the rule or a test of an item for a case of a union, whose own plans say as
    ; much, or a call planned to give its text, which gives what the helper makes of that text where
    ; the type pass recorded that.
    (let plan (call (. facts plan-of) instance id))
    (if (and (!= plan .plan-pattern-call) (!= plan .plan-span-call) (!= plan .plan-case))
      (call (. facts set-plan) instance id .plan-stream-value)
    )
  )
  (fn-do _ record-stream-text Bool
    (param id SyntaxId)
    ; Records where a part of a grammar gives the text it matched the call that makes it:
    ; `slice-string` of the part of the stream's buffer it matched. Within a rule typed with no
    ; helper for the text of a call of it under one, the call is not made, so it is typed outside any
    ; restriction.
    (let unmade (and (. helping span-typing) (== (. helping helper) null)))
    (let call
      (call (. calls protocol-call)
        (block
          (arg (. stream-view buffer))
          (arg (call (. program store-atom) "slice-string"))
          (arg id)
          (:restricted (not unmade))
          (:role (. CallRole role-text))
        )
      )
    )
    (return (== (. call answer) (. types string-type)))
  )
  (fn-do _ join-stream-types TypeId
    (param id SyntaxId)
    (param left TypeId)
    (param right TypeId)
    ; Two types a pattern may give, as one: where either side gives none, the other's; where
    ; either is null, the other's as an optional, unless it is one or null; else the two unified,
    ; or else their union.
    (if (or (== left invalid-type) (== right invalid-type))
      (return invalid-type)
    )
    (if (== left no-type)
      (return right)
    )
    (if (== right no-type)
      (return left)
    )
    (if (or (== left (. types null-type)) (== right (. types null-type)))
      (let valued (if-expr (== left (. types null-type)) right left))
      (return
        (scope (if-expr nullable valued (call (. types optional-of) valued))
          (lazy nullable (or (== valued (. types null-type)) (call (. types is-optional) valued)))
        )
      )
    )
    (let relation (call (. relations unify) left right module))
    (if (call relation-legal relation)
      (return (. relation unified))
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) left)
    (call (. scratch types push) right)
    (return (call (. types intern-union) mark))
  )
  (fn-do + convert-stream-arms _
    (param id SyntaxId)
    (param result TypeId)
    ; Converts what each arm of a grammar gives to the type of the pattern, where the arm
    ; is. The type a pattern is declared to give asks for what its arms match as that type, as text
    ; read as a number or pieces matched as text, and for an integer written with no suffix that it
    ; holds.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (call convert-stream-arms (. row left) result)
        (call convert-stream-arms (. row right) result)
        (return)
      )
      (case .node-stream-panic
        (return)
      )
    )
    (if (call (. facts is-spanning-arm) instance id)
      (return)
    )
    (let given (call (. facts node-type) instance id))
    (return-if (if (or (== given no-type) (== given result))))
    (blank)
    (if (and (call (. relations reads-text-as-number) given result) (not (call (. tree acts) id)))
      (let read (call (. relations compare-explicit) given result module))
      (if (call relation-legal read)
        (call (. conversions record-conversion) id read .reason-join false no-type id)
        (return)
      )
    )
    (let written
      (match ([] (. tree nodes) id)
        (case (call .node-stream-transform row)
          (and (!= (. row right) 0) (call (. conversions fitting-literal) (call (. tree arm-value) (. row right)) result))
        )
        (default
          false
        )
      )
    )
    (call (. conversions convert)
      (block
        (arg id)
        (arg id)
        (arg given)
        (arg result)
        (arg .reason-join)
        (arg true)
        (arg (or (== result (. types string-type)) written))
      )
    )
  )
  (fn-do + note-arm-casts _
    (param id SyntaxId)
    (param declared TypeId)
    ; Records each arm of a rule's pattern whose action gives a cast to the type the rule states
    ; (`note-context-cast`). A rule that states none takes its type from its arms, casts and all,
    ; and one that states `String` has the text of each arm made by a call, as the reference makes it.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (call note-arm-casts (. row left) declared)
        (call note-arm-casts (. row right) declared)
      )
      (case (call .node-stream-transform row)
        (call (. calls note-context-cast) (call (. tree action-value) (. row right)) declared .cast-return)
      )
    )
  )
  (fn-do _ stream-action-type TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param body SyntaxId)
    ; An arm that runs an expression where its pattern matched, which gives the arm's value. The
    ; expression sees as `it` the text its pattern matched, or what a rule its pattern calls gives where
    ; the pattern is no sequence, as the reference gives it the pattern's value. The text of a sequence
    ; of items that are no characters is what `slice-string` makes of them. Where the pattern is an
    ; optional part that gives its text, `it` is that text as an optional, which the part makes where
    ; its operand passes, a literal's by the slice and any other as `record-source-text` says. Any other
    ; value a pattern has has no shape here, and `it` in an arm with no pattern, which the reference
    ; types as the subject but gives empty text, is an error. Nothing reads the value of a pattern whose expression does
    ; not read `it`. It reads as `location` where its pattern began and ended, or where it is tried
    ; where it has none. One the reference runs in a function of its own is recorded, and is planned to
    ; run so where it is not quiet and its own code may panic, which the panic would show; the panic
    ; pass plans one whose calls may. Nor has an expression that leaves the function, one of a match's
    ; local rule marked to roll back with no helper, or one that reads a name its pattern may pass
    ; without capturing. One of a match's own arms marked to roll back where the match has no helper is
    ; the reference's error, at the match's first arm. One of a rule's marked so with no helper still
    ; asks for a mark, which the rule's function cannot give where a pattern calls it so. One under a
    ; helper that cannot roll back makes the match need it to, and one under a helper that can asks it
    ; for a mark before the expression runs, as does every arm of a rule whose pattern is marked so.
    ; Under a helper, the names the expression reads, `it` and what it gives are made as
    ; `materialize-captures` and `materialize-result` say; `it` alone, where a capture materializer
    ; makes the type the arms give, is made as that type. One that reads a name the helper made as
    ; another type than it is wanted as, which the reference does, has a shape only where it gives the
    ; type it gives with the name as it was, as the reference then takes what it gives for that type. A
    ; name that holds a `CaptureSpan` reads as text, as `observe-spans` says. In a rule that states a
    ; `CaptureSpan` the arm gives the span of the items it matched, and its expression, whose value the
    ; reference drops, has a shape only where it gives that type; elsewhere one that gives a span, or
    ; reads `it` that holds one, which the reference reads as text, has none.
    (let rolls-back (. helping explicit))
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (= rolls-back (or rolls-back (. row rollback)))
      )
    )
    (if rolls-back
      (if (and (== (. helping helper) null) (!= (. rule-streaming matched) 0) within-matched)
        (call (. frame diagnose)
          (block
            (arg (. rule-streaming matched))
            (arg .stated)
            (arg (call (. program store-atom) "Pattern @rollback requires a with helper"))
          )
        )
        (return invalid-type)
      )
      (lazy within-matched
        (block
          (and (<= (call (. tree subtree-start) (. rule-streaming matched)) id) (< id (. rule-streaming matched)))
        )
      )
      (if (and (== (. helping helper) null) (!= (. rule-streaming matched) 0))
        (call decline id)
        (return invalid-type)
      )
      (if (== (. helping helper) null)
        (call (. facts note-marking-arm) instance id)
        (else
          (= helping (= (. helping rolls) true))
          (call note-helper-use true)
          (if (!= (. (!! (. helping helper)) rollback) no-type)
            (call (. facts note-marking-arm) instance id)
            (call (. facts note-asked-mark) (call first-type-arg types (. (!! (. helping helper)) rollback)))
            (call note-mark)
          )
        )
      )
    )
    (if (and (call spans-source (. rule-arming target)) (not (. rule-arming span)))
      (call decline id)
      (return invalid-type)
    )
    (let forwards-it
      (scope (and forwarding (== (call (. tree name-text) (call (. tree forwarded-read) body)) "it"))
        (lazy forwarding (and (!= (. helping helper) null) (!= (call (. tree forwarded-read) body) 0)))
      )
    )
    (let it-wanted (. types string-type))
    (if (and forwards-it non-text-target (!= (. (call source-candidates (. rule-arming target)) length) 0))
      (= it-wanted (. rule-arming target))
    )
    (lazy non-text-target
      (block
        (and (!= (. rule-arming target) no-type) (!= (call peeled-optional (. rule-arming target)) (. types string-type)))
      )
    )
    (let it-type (. types string-type))
    (let spans-it no-type)
    (if (!= pattern 0)
      (let reads (call (. tree mentions) body "it"))
      (let slot (call arm-slot id .slot-it))
      (let sequence (is ([] (. tree nodes) pattern) .node-stream-and))
      (if (and reads (not forwards-it))
        (= spans-it (call it-span pattern body slot))
      )
      (let saved-unvalued valuing)
      (= valuing
        (= (. valuing unvalued)
          (scope (or (not reads) (and (!= spans-it no-type) (or sequence calls-stream)))
            (lazy calls-stream (is ([] (. tree nodes) pattern) .node-stream-call))
          )
        )
      )
      (let matched (call stream-node-type pattern))
      (= valuing saved-unvalued)
      (if (== matched invalid-type)
        (return invalid-type)
      )
      (if (and (!= spans-it no-type) (not sequence) (!= matched (. types string-type)))
        (= spans-it no-type)
      )
      (if (!= spans-it no-type)
        (= it-type spans-it)
        (call (. facts note-spanning-it) instance id spans-it)
        (call (. frame assign) slot spans-it)
        (else-if (and (not sequence) (call stream-valued pattern) (!= matched no-type))
          (call plan-valued pattern)
          (= it-type matched)
          (if (!= slot no-slot)
            (call (. frame assign) slot matched)
          )
        )
        (else
          (let held (call (. tree optional-operand) pattern))
          (if (and reads (!= held 0) (call text-items) (== matched (call (. types optional-of) (. types string-type))))
            (let made
              (block
                (case? (is ([] (. tree nodes) held) .node-stream-string)
                  (call sliced-text pattern)
                )
                (default
                  (call record-source-text pattern (. types string-type))
                )
              )
            )
            (if (!= made (. types string-type))
              (call decline id)
              (return invalid-type)
            )
            (call plan-valued pattern)
            (call (. facts set-node-type) instance pattern matched)
            (= it-type matched)
            (else-if reads
              (let made
                (scope (if-expr text-sourced (call record-source-text id it-wanted) invalid-type)
                  (lazy text-sourced (or sequence (and (call text-items) (== matched (. types string-type)))))
                )
              )
              (if (== made invalid-type)
                (call decline id)
                (return invalid-type)
              )
              (= it-type made)
            )
          )
          (if (and (!= slot no-slot) (or (call text-items) reads))
            (call (. frame assign) slot it-type)
          )
        )
      )
      (else-if (call (. tree mentions) body "it")
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg (call (. program store-atom) "An arm with no pattern has no \"it\"; read the subject by its name"))
          )
        )
        (return invalid-type)
      )
    )
    (if (not (call type-location id (!= pattern 0) body))
      (call decline id)
      (return invalid-type)
    )
    (let restores (list SlotId))
    (let restored (list TypeId))
    (if (and (!= (. helping helper) null) (not (call materialize-captures id body restores restored)))
      (return invalid-type)
    )
    (if (or (not (call observe-spans id body restores restored)) it-spanned)
      (call decline id)
      (return invalid-type)
    )
    (lazy it-spanned (and (call observes-span it-type) (== spans-it no-type) (call (. tree mentions) body "it")))
    (call keep-text-spans body restores restored)
    (let selects action-selects)
    (let remade (list U32))
    (let unmade (list TypeId))
    (for (in offset (..< 0 (. remade-positions length)))
      (+= remade ([] remade-positions offset))
      (+= unmade ([] remade-types offset))
    )
    (let was (. ([] (. instances rows) instance) may-panic))
    (call (. instances clear-may-panic) instance)
    (let outer-arm valuing)
    (= valuing (= (. valuing action-arm) id))
    (let value (call check-statement body))
    (= valuing outer-arm)
    (if (and (or (== value no-type) (== value (. types void-type))) (!= (call (. tree final-print) body) 0))
      (call (. frame diagnose) (call (. tree final-print) body) .stated (call (. program store-atom) (call print-block-text)))
      (return invalid-type)
    )
    (let panics-here (. ([] (. instances rows) instance) may-panic))
    (if was
      (call (. instances mark-may-panic) instance)
    )
    (if (== value invalid-type)
      (return invalid-type)
    )
    (if (and (== (. rule-arming target) no-type) (call reads-atom body))
      (= pattern-arms (= (. pattern-arms uninferred) true))
    )
    (if (and rolled-remakes (or outer (!= (call trial-type body remade unmade) value)))
      (call decline id)
      (return invalid-type)
    )
    (lazy rolled-remakes (and (!= (. remade length) 0) (!= (. (!! (. helping helper)) rollback) no-type)))
    (= remakes-result false)
    (if (and (!= (. helping helper) null) (!= value no-type))
      (= value (call materialize-result id pattern body value selects forwards-it))
      (if (== value invalid-type)
        (return invalid-type)
      )
    )
    (let raise (if-expr (!= pattern 0) (call final-raise body) 0))
    (if (!= raise 0)
      (let advice
        (paragraph
          "call a function that raises it, or write \"(throw error)\" as the rule's last arm, which raises where no arm before it matches"
        )
      )
      (call (. frame diagnose)
        (block
          (arg raise)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg (str "An arm's action gives the arm's value, so it cannot be a raise; " advice))
              )
            )
          )
        )
      )
      (return invalid-type)
    )
    (if (or (== value no-type) (call (. narrowing exits) body))
      (call decline id)
      (return invalid-type)
    )
    (let uncovered (call uncovered-read pattern body))
    (if (!= uncovered 0)
      (if (is ([] (. tree nodes) uncovered) .node-identifier)
        (call (. frame diagnose) uncovered .stated (call (. program store-atom) (call (. tree uncovered-text) uncovered)))
        (else
          (call decline id)
        )
      )
      (return invalid-type)
    )
    (let unplain (call unplain-slice body))
    (if (!= unplain 0)
      (call (. frame diagnose) unplain .stated (call (. program store-atom) (call slice-read-text)))
      (return invalid-type)
    )
    (if (. rule-arming span)
      (if (or (!= value (. rule-arming target)) remakes-result forwards-it)
        (call decline id)
        (return invalid-type)
      )
      (call (. facts note-spanning-arm) instance id)
      (else-if (call observes-span value)
        (call decline id)
        (return invalid-type)
      )
    )
    (if (and (not remakes-result) (call outlines pattern body value))
      (call note-outlined-action id body it-type)
      (if (not (call is-quiet body))
        (if panics-here
          (call (. facts set-plan) instance id .plan-outlined-panic)
        )
        (call (. panics note-outlined) instance id body)
      )
    )
    (for (in position (..< 0 (. restores length)))
      (call (. frame assign) ([] restores position) ([] restored position))
    )
    (call (. facts set-node-type) instance id value)
    (return value)
  )
  (fn-expr _ it-span TypeId
    (param pattern SyntaxId)
    (param body SyntaxId)
    (param slot SlotId)
    ; The `CaptureSpan` an action that reads `it` sees it as, as the reference keeps it where the
    ; action reads it only for numbers its span gives as its text does and `it` is the text of the
    ; characters the arm's pattern matched: that of a sequence, or of a part that gives the text it
    ; matched, which is not optional; none where it is anything else, and in a rule that states a
    ; span.
    (case? (or (== slot no-slot) (not (call text-items)) (. rule-arming span) (!= (call (. tree optional-operand) pattern) 0))
      no-type
    )
    (case? (and (not (is ([] (. tree nodes) pattern) .node-stream-and)) (not (call returns-span instance pattern)))
      no-type
    )
    (default
      (if-expr (call reads-span-numbers body slot span) span no-type)
    )
    (where
      (lazy span (call class-over (. types capture-span-decl) buffer-item))
    )
  )
  (fn-do _ reads-atom Bool
    (param body SyntaxId)
    ; Whether an action reads a property of an `Atom`, which the reference finds no type for
    ; where it infers what an action gives, and so takes the action to give none.
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-get-expression row)
          (let held (call (. facts node-type) instance (. row object)))
          (if (and (!= held no-type) (!= held invalid-type) holds-atom)
            (return true)
          )
          (lazy holds-atom (== (call (. types intrinsic-of) (call peeled-optional held)) .atom))
        )
      )
    )
    (return false)
  )
  (fn-do _ observe-spans Bool
    (param id SyntaxId)
    (param body SyntaxId)
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Plans how an action reads the names that hold a `CaptureSpan`, as the reference makes them
    ; where the action starts, with a helper or none: one that holds the span of the stream's
    ; characters reads as their text, made by `slice-string` of the items it spans. One the helper
    ; made as another type is left as that. One that holds a span of other items, or in an
    ; optional or a list, has no shape here. Keeps the slots it retypes, and their types before.
    ; False where an action has no shape.
    (let seen (list SlotId))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let slot (call capture-slot node))
          (let position
            (block
              (case? (!= slot no-slot)
                (call capture-position slot (. pattern-arms arm))
              )
              (default
                (. U32 max)
              )
            )
          )
          (if (and (!= position (. U32 max)) (== (call (. seen find) slot) null))
            (+= seen slot)
            (let held (call (. facts node-type) instance ([] capture-sites position)))
            (if (or (not (call observes-span held)) (!= (call (. restores find) slot) null))
              (continue)
            )
            (if (or (not (call text-items)) (not (call gives-source-span held)))
              (return false)
            )
            (if (call reads-span-numbers body slot held)
              (continue)
            )
            (let made
              (call (. calls protocol-call)
                (block
                  (arg (call field-of held 0))
                  (arg (call (. program store-atom) "slice-string"))
                  (arg id)
                  (arg no-type)
                  (arg false)
                  (arg no-type)
                  (arg no-type)
                  (arg false)
                )
              )
            )
            (if (or (!= (. made answer) (. types string-type)) (== (. made fact) no-fact))
              (return false)
            )
            (call (. facts record-material)
              (block
                (arg
                  (call MaterialFact
                    (block
                      (arg instance)
                      (arg id)
                      (arg .material-span-text)
                      (arg slot)
                      (arg (. types string-type))
                      (arg no-type)
                      (arg (. made fact))
                    )
                  )
                )
              )
            )
            (+= restores slot)
            (+= restored held)
            (call (. frame assign) slot (. types string-type))
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ keep-text-spans _
    (param body SyntaxId)
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Keeps as the `CaptureSpan` of the characters it matched each name captured over text that an
    ; action reads only for numbers its span gives as its text does, as the reference keeps such a
    ; name, with a helper or none, where nothing made it otherwise: as an optional span, read only
    ; through `?.`, where the name is captured over an optional part. Keeps the slots it retypes,
    ; and their types before.
    (if (not (call text-items))
      (return)
    )
    (let span (call class-over (. types capture-span-decl) buffer-item))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let slot (call capture-slot node))
          (if (or (== slot no-slot) (!= (call (. restores find) slot) null))
            (continue)
          )
          (let text (call plain-text slot))
          (if (== text no-type)
            (continue)
          )
          (let optional (call (. types is-optional) text))
          (if (not (call reads-span-numbers body slot span optional))
            (continue)
          )
          (+= restores slot)
          (+= restored text)
          (call (. frame assign) slot (if-expr optional (call (. types optional-of) span) span))
        )
      )
    )
  )
  (fn-do _ plain-text TypeId
    (param slot SlotId)
    ; The text a name holds where it is captured, once or as alternatives of one another, over text
    ; that no repeat holds and the stream's buffer gives no part of, and it does not accumulate:
    ; text, or optional text where each place it is captured is an optional part. None where it is
    ; anything else.
    (let found no-type)
    (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
      (if (!= ([] capture-slots position) slot)
        (continue)
      )
      (let site ([] capture-sites position))
      (let plan (call (. facts plan-of) instance site))
      (let type (call (. facts node-type) instance site))
      (let optional
        (scope (and (== type (call (. types optional-of) (. types string-type))) optional-part)
          (lazy optional-part (!= (call (. tree optional-operand) ([] capture-patterns position)) 0))
        )
      )
      (if (or ([] capture-accumulating position) (!= ([] capture-repeats position) 0) (and (!= type (. types string-type)) (not optional)) (== plan .plan-stream-value) (== plan .plan-stream-slice) (and (!= found no-type) (!= found type)))
        (return no-type)
      )
      (= found type)
    )
    (return found)
  )
  (fn-do _ reads-span-numbers Bool
    (param body SyntaxId)
    (param slot SlotId)
    (param span TypeId)
    (param optional Bool (= false))
    (let names 0)
    (let reads 0)
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-function-syntax
          (return false)
        )
        (case .node-identifier
          (if (== (call capture-slot node) slot)
            (+= names 1)
          )
        )
        (case (call .node-get-expression row)
          (if (and (is ([] (. tree nodes) (. row object)) .node-identifier) (== (call capture-slot (. row object)) slot))
            (if (or (. row is-tracked) (!= (. row is-optional) optional) (. row is-loop) foreign-number)
              (return false)
            )
            (lazy foreign-number (not (call shares-number span (. row name))))
            (+= reads 1)
          )
        )
        (case (call .node-call-expression row)
          (if (not optional)
            (+= reads (call passed-spans row slot span))
          )
        )
      )
    )
    (return (== names reads))
  )
  (fn-do _ passes-spans-only Bool
    (param slot SlotId)
    (param body SyntaxId)
    ; Whether an action gives a name captured over text to a function that takes its span, and
    ; reads it otherwise only for numbers its span gives as its text does (`reads-span-numbers`).
    (let passed false)
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-call-expression row)
          (= passed (or passed (!= (call passed-spans row slot (call class-over (. types capture-span-decl) buffer-item)) 0)))
        )
      )
    )
    (return (and passed (call reads-span-numbers body slot (call class-over (. types capture-span-decl) buffer-item))))
  )
  (fn-do _ passed-spans Int
    (param call ASTCallExpression)
    (param slot SlotId)
    (param span TypeId)
    ; How many times a call gives a name, alone, as a positional argument that no named one precedes,
    ; to a function that takes its span there (`takes-span`).
    (let passed 0)
    (let position 0u32)
    (for (in arg ([] (. tree children) (. call args)))
      (let expr arg)
      (let optional false)
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument argument)
          (if (. argument name)
            (break)
          )
          (= expr (. argument expr))
          (= optional (. argument is-optional))
        )
      )
      (if (and (not optional) captured-name (call takes-span call position span))
        (+= passed 1)
      )
      (lazy captured-name (and (is ([] (. tree nodes) expr) .node-identifier) (== (call capture-slot expr) slot)))
      (+= position 1)
    )
    (return passed)
  )
  (fn-do _ takes-span Bool
    (param call ASTCallExpression)
    (param position U32)
    (param span TypeId)
    ; Whether a call by a name alone reaches a function that states a `CaptureSpan` for the parameter
    ; at a position, as the reference finds one among the functions of a module the name looks up:
    ; one that is no method, takes no list of the rest, and is seen from here.
    (if (or (. call is-curried) (!= (. call param-count) 0))
      (return false)
    )
    (let callee (? Atom) null)
    (match? ([] (. tree nodes) (. call callable))
      (case (call .node-identifier read)
        (= callee (. read name))
      )
    )
    (if (not callee)
      (return false)
    )
    (for (in candidate (call (. program lookup) module callee))
      (let target ([] (. program modules) (. candidate module)))
      (match? ([] (. target decls) (. candidate decl))
        (case (call .decl-function fn)
          (if (and (== (. fn owner) 0) (== (. fn kind) .function-decl) positional visible)
            (let types-mark (. types scratch types mark))
            (let names-mark (. types scratch names mark))
            (let signature
              (call signature-into
                (block
                  (arg types)
                  (arg (. candidate module))
                  (arg (. candidate decl))
                  (arg (call no-type-arguments types))
                  (arg no-type)
                  (arg true)
                )
              )
            )
            (let wanted
              (scope (and in-signature (call same-class types ([] (. signature args) position) span))
                (lazy in-signature (< position (. signature args length)))
              )
            )
            (call (. types scratch types rewind) types-mark)
            (call (. types scratch names rewind) names-mark)
            (if wanted
              (return true)
            )
          )
          (lazy positional (and (== (. fn variadic-index) (. U32 max)) (< position (. fn args count))))
          (lazy visible (or (== (. fn access) .public-access) (== (. candidate module) module)))
        )
      )
    )
    (return false)
  )
  (fn-expr _ shares-number Bool
    (param span TypeId)
    (param name Atom)
    (case? (or (!= (call class-arg types span 0) (call (. types type-row) .char)) (not found) (not text))
      false
    )
    (default
      (and (call is-numeric types type) (== type (call member-type ([] (. types properties) text) (. types string-type))))
    )
    (where
      (lazy found (call property-named span name))
      (lazy text (call property-named (. types string-type) name))
      (lazy type (call member-type ([] (. types properties) found) span))
    )
  )
  (fn-do _ observes-span Bool
    (param type TypeId)
    ; Whether a value holds a `CaptureSpan`, itself or in an optional or a list, which the
    ; reference has an action read, and give, as the text or the items it spans.
    (if (or (== type no-type) (== type invalid-type))
      (return false)
    )
    (let inner (call peeled-optional type))
    (match? ([] (. types rows) inner)
      (case (call .type-class row)
        (if (call (. types capture-span-decl refers-to) (. row module) (. row decl))
          (return true)
        )
        (if (or (call (. types list-decl refers-to) (. row module) (. row decl)) immutable-array)
          (return (call observes-span (call class-arg types inner 0)))
        )
        (lazy immutable-array (call (. types immutable-array-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return false)
  )
  (fn-do _ span-arm-type TypeId
    (param id SyntaxId)
    ; An arm that runs no expression in a pattern that is to give a `CaptureSpan`: where a rule
    ; states the span of its stream's items, the arm gives the span of the items it matched, and
    ; nothing reads what its pattern gives. Any other such pattern has no shape here.
    (if (not (. rule-arming span))
      (call decline id)
      (return invalid-type)
    )
    (let saved-unvalued valuing)
    (= valuing (= (. valuing unvalued) true))
    (let matched (call stream-node-type id))
    (= valuing saved-unvalued)
    (if (== matched invalid-type)
      (return invalid-type)
    )
    (call (. facts note-spanning-arm) instance id)
    (return (. rule-arming target))
  )
  (fn-expr + gives-source-span Bool
    (param type TypeId)
    ; Whether a type a rule states is the `CaptureSpan` of the items its stream holds, over the
    ; buffer the stream reads. The reference then has each arm of the rule give the span of the
    ; items it matched, whatever its pattern or its action gives.
    (case? (or (== type no-type) (== type invalid-type) (call (. types is-optional) type) (not (call spans-source type)))
      false
    )
    (default
      (and (!= (. stream-view item) no-type) over-buffer (== (call field-of type 0) (. stream-view buffer)))
    )
    (where
      (lazy over-buffer (== (call class-arg types type 0) buffer-item))
    )
  )
  (fn-do _ spans-source Bool
    (param type TypeId)
    ; Whether a pattern is to give a `CaptureSpan`, optional or not. The reference then gives the
    ; span of the items the pattern matched, whatever its actions give, which has a shape only
    ; for the arms of a rule that `gives-source-span` says.
    (if (or (== type no-type) (== type invalid-type))
      (return false)
    )
    (match? ([] (. types rows) (call peeled-optional type))
      (case (call .type-class row)
        (return (call (. types capture-span-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return false)
  )
  (fn-do _ ranged-capture (? Bool)
    (param id SyntaxId)
    (param slot SlotId)
    ; Whether a name captured over text in a repeat keeps the ranges of its passes, as the
    ; reference keeps one an action that reads it makes through a capture materializer, wanted as
    ; a list of text or, where the action is that name alone, as what the arms give. A name some
    ; actions make so and others read as text has no shape here; null where a choice is ambiguous
    ; or the pattern has no shape.
    (let listed (call class-over (. types immutable-array-decl) (. types string-type)))
    (let made false)
    (let plain false)
    (for (in node (..< (call (. tree subtree-start) (. rule-arming capture-root)) (+ (. rule-arming capture-root) 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-transform row)
          (if (and (!= (. row right) 0) (not (call (. tree lazies-only) (. row right))) (call reads-slot (. row right) slot))
            (let forwarded (call (. tree forwarded-read) (. row right)))
            (let forwards (and (!= forwarded 0) (== (call capture-slot forwarded) slot)))
            (let result (if-expr (!= (. rule-arming target) no-type) (. rule-arming target) listed))
            (let desired (if-expr (and forwards (call contains-output result)) result listed))
            (let chosen
              (call select-materializer
                (block
                  (arg (. (!! (. helping helper)) captures))
                  (arg buffer-item)
                  (arg (call desired-leaf desired))
                  (arg true)
                  (arg node)
                )
              )
            )
            (if (== chosen invalid-type)
              (return null)
            )
            (if (== chosen no-type)
              (= plain true)
              (else
                (= made true)
              )
            )
          )
        )
      )
    )
    (if (and made plain)
      (call decline id)
      (return null)
    )
    (return made)
  )
  (fn-do _ results-assumed Bool
    (param mark Size)
    (param result TypeId)
    (param pattern SyntaxId)
    ; Whether the arms that a helper made values for, where the arms declare no type, chose as they
    ; would have with the type they join as, which the reference takes. Where any did not, the
    ; pattern has no shape here. An action taken to make its value again does so where the arms
    ; give the type it took.
    (let agreed true)
    (for (in position (..< mark (. assumed-results length)))
      (let assumed ([] assumed-results position))
      (if (not (call agrees assumed result))
        (= agreed false)
        (else-if (and (!= (. assumed interface) no-type) (== (. assumed value) result))
          (if (not (call record-result (. assumed site) (. assumed value) (. assumed interface)))
            (= agreed false)
          )
        )
      )
    )
    (-= ([] assumed-results (..< mark (. assumed-results length))))
    (if (not agreed)
      (call decline pattern)
    )
    (return agreed)
  )
  (fn-expr _ agrees Bool
    (param assumed AssumedResult)
    (param result TypeId)
    ; Whether an action that took its own type for the type the arms give chose as it would have
    ; with the type they join as: where the type is the same; else where it materializes with
    ; both or with neither, a name it forwards wanted as the type it would be wanted as selects no
    ; materializer, `it` forwarded would be no other text, and where the action materializes, the
    ; helper makes neither type. Where the helper makes the type it took and not the one the arms
    ; give, the action's value is not made again, which is as the action chose but for the
    ; function of its own the reference may then run it in: so only where it surely runs none, an
    ; action with no pattern, one that gives text, or a name, a number or text written alone.
    (case? (== (. assumed value) result)
      true
    )
    (case? (!= selected (or (. assumed selects) (call values-select (. assumed value))))
      false
    )
    (case? (and forwarding changed (!= (call selects (. assumed forwarded) result (. assumed backed) (. assumed site)) 0))
      false
    )
    (case? (and (. assumed forwards-it) untexted (!= (. (call source-candidates result) length) 0))
      false
    )
    (case? (or (not selected) (and (not (call contains-output (. assumed value))) (not (call contains-output result))))
      true
    )
    (default
      (and (not (call contains-output result)) (or (== (. assumed pattern) 0) gives-text trivial))
    )
    (where
      (lazy selected (or (. assumed selects) (call values-select result)))
      (lazy trivial (call (. tree trivial-action) (. assumed body)))
      (lazy forwarding (and (!= (. assumed forwarded) no-type) (call contains-output result)))
      (lazy changed (!= result (. assumed forwarded)))
      (lazy untexted (!= (call peeled-optional result) (. types string-type)))
      (lazy gives-text (== (. assumed value) (. types string-type)))
    )
  )
  (fn-do _ capture-position U32
    (param slot SlotId)
    (param arm SyntaxId)
    ; Where among the names the match captures a slot is kept, or `U32.max` for one it does not:
    ; the place in `arm` where it has one, as a name of a rule's pattern may hold another type in
    ; another arm.
    (if (!= arm 0)
      (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
        (if (and (== ([] capture-slots position) slot) after-start (<= ([] capture-sites position) arm))
          (return (as position U32))
        )
        (lazy after-start (<= (call (. tree subtree-start) arm) ([] capture-sites position)))
      )
    )
    (for (in position (..< (. rule-arming capture-base) (. capture-slots length)))
      (if (== ([] capture-slots position) slot)
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ materialize-captures Bool
    (param id SyntaxId)
    (param body SyntaxId)
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Plans how the helper makes the names an action reads, in the order the expression first reads
    ; them, as the reference materializes them where the action starts. Each is wanted as the type
    ; `capture-wanted` says, or, where one could be made as another type and the expression is not
    ; typed with the first, as the one choice of the others it is typed with, as the reference
    ; chooses; two such choices are its error. Each is then made as `materialize-capture` says,
    ; and the expression is typed with what it holds. Notes in `action-selects` whether any name
    ; selects a materializer. Keeps the slots it retypes, and their types before.
    (= action-selects false)
    (call (. remade-positions clear))
    (call (. remade-types clear))
    (let forwarded (call (. tree forwarded-read) body))
    (let seen (list SlotId))
    (let positions (list U32))
    (let sites (list SyntaxId))
    (let candidates (list TypeId))
    (let starts (list U32))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let slot (call capture-slot node))
          (let position
            (block
              (case? (!= slot no-slot)
                (call capture-position slot (. pattern-arms arm))
              )
              (default
                (. U32 max)
              )
            )
          )
          (if (and (!= position (. U32 max)) (== (call (. seen find) slot) null))
            (+= seen slot)
            (+= positions position)
            (+= sites node)
            (+= starts (as (. candidates length) U32))
            (if (not (call capture-wanted id position (== node forwarded) candidates))
              (return false)
            )
          )
        )
      )
    )
    (+= starts (as (. candidates length) U32))
    (let chosen (call choose-captures id body positions candidates starts))
    (if (== chosen null)
      (return false)
    )
    (for (in offset (..< 0 (. positions length)))
      (if (not (call materialize-capture id body ([] positions offset) ([] chosen offset) restores restored))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ capture-wanted Bool
    (param id SyntaxId)
    (param position U32)
    (param forwards Bool)
    (param candidates (list TypeId))
    ; The types a name an action reads may be wanted as, first the one the reference wants it as: what
    ; it holds, or where the action is that name alone and the arms give a type a materializer makes,
    ; that type; then each other type the materializers that apply to it make, put in what it holds past
    ; optionals and lists, where one is selected for it. Under a helper with no materializer, only what
    ; it holds, as is a name that accumulates what rules gave where no value materializer takes one, and
    ; a name that holds the text of a rule that states another type, which the reference holds as that
    ; type. Otherwise a name that accumulates, holds a part of the buffer, or holds what a rule gave
    ; that is the text it matched has no shape here. False where the pattern has no shape.
    (let name ([] capture-sites position))
    (let natural (call (. facts node-type) instance name))
    (if (and (== (. (!! (. helping helper)) captures length) 0) (== (. (!! (. helping helper)) values length) 0))
      (+= candidates natural)
      (return true)
    )
    (let plan (call (. facts plan-of) instance name))
    (let backed (!= plan .plan-stream-value))
    (if (and ([] capture-accumulating position) (not backed) (== (call selects natural natural false id) 0))
      (+= candidates natural)
      (return true)
    )
    (if (or (and ([] capture-accumulating position) backed) (== plan .plan-stream-slice))
      (call decline id)
      (return false)
    )
    (if (and (not backed) (call returns-span instance ([] capture-patterns position)))
      (call decline id)
      (return false)
    )
    (let result (if-expr (!= (. rule-arming target) no-type) (. rule-arming target) natural))
    (let desired (if-expr (and forwards (call contains-output result)) result natural))
    (+= candidates desired)
    (if (and backed (!= (call desired-leaf natural) (. types string-type)))
      (return true)
    )
    (for (in materializer (if-expr backed (. (!! (. helping helper)) captures) (. (!! (. helping helper)) values)))
      (let candidate (call with-leaf desired (call second-type-arg materializer)))
      (if (and (!= candidate desired) (== (call (. candidates find) candidate) null))
        (let also (call selects natural candidate backed id))
        (if (== also 2)
          (return false)
        )
        (if (== also 1)
          (+= candidates candidate)
        )
      )
    )
    (return true)
  )
  (fn-do _ choose-captures (? (list TypeId))
    (param id SyntaxId)
    (param body SyntaxId)
    (param positions (list U32))
    (param candidates (list TypeId))
    (param starts (list U32))
    ; The types the names an action reads are wanted as, as the reference chooses them: each the
    ; first it may be wanted as, where none may be wanted as another or the expression is typed
    ; with those; else of the choices of the others, tried in order, that the expression is typed
    ; with, the one that makes the most names as a materializer does, or the first where none is.
    ; Two such choices that make as many are the reference's error at the action, which names the
    ; first two. An action of a closure has no shape here where a choice must be tried. Null where
    ; the pattern has no shape.
    (let firsts (list TypeId))
    (let several false)
    (for (in offset (..< 0 (. positions length)))
      (+= firsts ([] candidates ([] starts offset)))
      (if (> (- ([] starts (+ offset 1)) ([] starts offset)) 1)
        (= several true)
      )
    )
    (if (not several)
      (return firsts)
    )
    (if outer
      (call decline id)
      (return null)
    )
    (if (call accepts body positions firsts)
      (return firsts)
    )
    (let found (list TypeId))
    (let second (list TypeId))
    (let count 0)
    (let most 0)
    (let picks (list U32))
    (for (in _ positions)
      (+= picks 0)
    )
    (let done false)
    (while (not done)
      (let moved false)
      (let place (. positions length))
      (while (and (!= place 0) (not moved))
        (-= place 1)
        (if (< (+ ([] picks place) 1) (- ([] starts (+ place 1)) ([] starts place)))
          (+= ([] picks place) 1)
          (for (in later (..< (+ place 1) (. positions length)))
            (= ([] picks later) 0)
          )
          (= moved true)
        )
      )
      (if (not moved)
        (= done true)
        (else
          (let made 0)
          (for (in pick picks)
            (if (!= pick 0)
              (+= made 1)
            )
          )
          (if (>= made most)
            (let tried (list TypeId))
            (for (in offset (..< 0 (. positions length)))
              (+= tried ([] candidates (+ ([] starts offset) ([] picks offset))))
            )
            (if (call accepts body positions tried)
              (if (> made most)
                (= most made)
                (= count 1)
                (= found tried)
                (else
                  (+= count 1)
                  (if (== count 2)
                    (= second tried)
                  )
                )
              )
            )
          )
        )
      )
    )
    (if (> count 1)
      (let options (list String))
      (for (in choice (list found second))
        (let parts (list String))
        (for (in offset (..< 0 (. positions length)))
          (+= parts
            (scope (str (call (. tree name-text) ([] capture-sites ([] positions offset))) "=" choice-key)
              (lazy choice-key (call type-key types ([] choice offset)))
            )
          )
        )
        (+= options (call (. ", " join) parts))
      )
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg (str "Ambiguous pattern action capture materialization: " (call (. " or " join) options)))
              )
            )
          )
        )
      )
      (call (. frame mention) (++ found second))
      (return null)
    )
    (return (if-expr (== count 1) found firsts))
  )
  (fn-do _ accepts Bool
    (param body SyntaxId)
    (param positions (list U32))
    (param wanted (list TypeId))
    ; Whether an action's expression is typed with the names it reads holding the types given, as
    ; `trial-type` types it.
    (let value (call trial-type body positions wanted))
    (return (and (!= value invalid-type) (!= value no-type)))
  )
  (fn-do _ trial-type TypeId
    (param body SyntaxId)
    (param positions (list U32))
    (param wanted (list TypeId))
    ; The type an action's expression gives with the names it reads holding the types given, as
    ; the reference tries it, on trial (`trial-checker`). Invalid where it reports any.
    (let checker (call trial-checker body))
    (for (in offset (..< 0 (. positions length)))
      (call (. checker frame assign) ([] capture-slots ([] positions offset)) ([] wanted offset))
    )
    (let reported (. facts diagnostics length))
    (let value (call (. checker check-statement) body))
    (if (!= (. facts diagnostics length) reported)
      (= value invalid-type)
    )
    (call (. facts diagnostics truncate) reported)
    (call (. checker close))
    (call (. checker retire))
    (return value)
  )
  (fn-do + foresee-transition _
    (param transition SyntaxId)
    (param items (list SyntaxId))
    (param wanted (list SlotId))
    (param found (list TypeId))
    (param targets (list TypeId))
    ; A transition typed on trial as the group it is in runs it, without its guard: `each` and `it`
    ; are an item of its stream (`foreseen-item`), or what an `if | p = s` tests, which its pattern
    ; matches, and then its targets are typed. Its guard is left out, as the reference leaves it
    ; out where it infers what a case holds, since it may read the machine.
    (let reported (. facts diagnostics length))
    (let trigger (call (. tree state-trigger) transition))
    (if (!= trigger 0)
      (let subject (call (. tree trigger-subject) trigger))
      (let stream (call (. tree trigger-stream) trigger))
      (let item
        (block
          (case? (!= subject 0)
            (call infer subject)
          )
          (case? (!= stream 0)
            (call foreseen-item stream)
          )
          (default
            no-type
          )
        )
      )
      (if (and (!= stream 0) (!= item no-type) (!= item invalid-type))
        (for (in head (call (. tree group-heads) items))
          (if (!= (call (. (call (. tree group-transitions) items head) find) transition) null)
            (let each (call (. bindings declared-kind-at) (. frame slots) head .slot-each))
            (let it (call (. bindings declared-kind-at) (. frame slots) head .slot-it))
            (if (!= each no-slot)
              (call (. frame assign) each item)
            )
            (if (!= it no-slot)
              (call (. frame assign) it item)
            )
          )
        )
      )
      (if (!= (call (. tree trigger-pattern) trigger) 0)
        (if (or (== item no-type) (== item invalid-type))
          (return)
        )
        (call type-trigger-pattern trigger item)
      )
    )
    (if (!= (. facts diagnostics length) reported)
      (return)
    )
    (for (in slot wanted)
      (+= found (call (. frame slot-type) slot))
    )
    (let given (. facts diagnostics length))
    (for (in target ([] (. tree children) (call (. tree state-targets) transition)))
      (+= targets (call infer target))
    )
    (if (!= (. facts diagnostics length) given)
      (call (. targets clear))
    )
  )
  (fn-do _ foreseen-item TypeId
    (param written SyntaxId)
    ; The item the stream a trigger is on gives, as `type-group` finds it: what an event of an
    ; object publishes, the item of the `Broadcastable` the stream is or converts to, or the item of
    ; a stream that is only iterable. No type where it is none of these.
    (let found (call infer-found written (call (. (call Want) adding) .want-event)))
    (let given (. found type))
    (if (!= (. found event) (. U32 max))
      (let event ([] found-events (. found event)))
      (return (. event payload))
    )
    (if (or (== given invalid-type) (== given no-type) (== (. types broadcastable-decl module) 0))
      (return no-type)
    )
    (if (and (== (call interface-of given (. types broadcastable-decl)) no-type) (call iterates-as-source given))
      (return (call loop-item-type (call iteration-container given written) written))
    )
    (let stream (call supported given (. types broadcastable-decl)))
    (if (== stream no-type)
      (return no-type)
    )
    (return (call first-arg stream))
  )
  (fn-do + trial-checker Checker
    (param body SyntaxId)
    ; A checker of its own for an instance of this one's declaration that nothing runs, nested
    ; where this one is, which reserves only the nodes of a part of the body and knows the slots
    ; this frame knows, and whose facts are dropped, to type that part on trial.
    (+= (. instances probes) 1)
    (let row ([] (. instances rows) instance))
    (let signature ([] (. instances signatures) instance))
    (let mark (. scratch types mark))
    (for (in position (..< 0 (. signature param-count)))
      (call (. scratch types push) (call (. instances param-type) instance position))
    )
    (let params (call (. scratch types since) mark))
    (let args-mark (. scratch types mark))
    (for (in position (..< 0 (. signature args count)))
      (call (. scratch types push) (call (. instances argument-type) instance position))
    )
    (let args (call (. scratch types since) args-mark))
    (let probe
      (call (. instances intern)
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row self-type))
          (arg (. row effects))
          (arg (. row enclosing))
          (arg params)
          (arg args)
          (arg false)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg (. instances probes))
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let start (call (. tree subtree-start) body))
    (let checker (call checker-for session probe outer true false (call SyntaxRange start (+ (- body start) 1))))
    (call (. checker prepare))
    (for (in offset (..< 0 (. frame slots count)))
      (let slot (+ (. frame slots start) offset))
      (let known (call (. frame known) slot))
      (if (and (!= known no-type) (!= known invalid-type))
        (call (. checker frame assign) slot known)
      )
    )
    (return checker)
  )
  (fn-do _ materialize-capture Bool
    (param id SyntaxId)
    (param body SyntaxId)
    (param position U32)
    (param desired TypeId)
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Plans how the helper makes a name an action reads, wanted as a type, as the reference does
    ; where the action starts. A name captured over text is made by the capture materializer
    ; selected for the stream's items and the type wanted, where one is, from its cursors; a name
    ; that holds a value, by the value materializer selected for its type. An optional name is
    ; made only where it holds a value; a list of text, one by one, from the ranges its passes
    ; kept. A name the action reads only for its length, an optional one through `?.`, or gives
    ; only to functions that take its span (`passes-spans-only`), is left as its text. A name no
    ; materializer is selected for is left as it is, whatever type it is wanted as, but one that
    ; holds text for another type has no shape here, nor has such a name the action reads only
    ; for its length or its span. A name that
    ; holds a value wanted as its own type, for which the reference selects a value materializer
    ; that makes another, is made as that other all the same, and noted in `remade-positions`.
    (let helper (!! (. helping helper)))
    (let name ([] capture-sites position))
    (let slot ([] capture-slots position))
    (let natural (call (. facts node-type) instance name))
    (let backed (!= (call (. facts plan-of) instance name) .plan-stream-value))
    (let ranges (call (. facts first-material) instance name))
    (let chosen (call selects natural desired backed id))
    (if (== chosen 2)
      (return false)
    )
    (let texted (or (not backed) (== (call desired-leaf natural) (. types string-type))))
    (if (== chosen 0)
      (if (not texted)
        (call decline id)
        (return false)
      )
      (return true)
    )
    (= action-selects true)
    (if (and backed (not texted) (or (call reads-length-only slot body) (call passes-spans-only slot body)))
      (call decline id)
      (return false)
    )
    (if (call is-listed natural)
      (return (call materialize-list id position ranges desired backed restores restored))
    )
    (let optional (call (. types is-optional) natural))
    (let leaf (if-expr optional (call (. types optional-inner) natural) natural))
    (let wanted (if-expr (call (. types is-optional) desired) (call (. types optional-inner) desired) desired))
    (if (and backed texted (or length-only (and (not optional) (call passes-spans-only slot body))))
      (return true)
    )
    (lazy length-only (call reads-length-only slot body optional))
    (let interface
      (call select-materializer
        (block
          (arg (if-expr backed (. helper captures) (. helper values)))
          (arg (if-expr backed buffer-item leaf))
          (arg wanted)
          (arg backed)
          (arg id)
        )
      )
    )
    (if (== interface invalid-type)
      (return false)
    )
    (let made (call second-type-arg interface))
    (if (and (not backed) (== wanted leaf) (!= made leaf))
      (+= remade-positions position)
      (+= remade-types natural)
    )
    (let kind (if-expr backed (. MaterialKind material-capture) (. MaterialKind material-value)))
    (if (not (call record-material id kind slot (if-expr optional (call (. types optional-of) made) made) interface leaf))
      (return false)
    )
    (let typed (if-expr optional (call (. types optional-of) made) made))
    (+= restores slot)
    (+= restored natural)
    (call (. frame assign) slot typed)
    (return true)
  )
  (fn-do _ materialize-list Bool
    (param id SyntaxId)
    (param position U32)
    (param ranges U32)
    (param desired TypeId)
    (param backed Bool)
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Plans how the helper makes a name captured in a repeat, one pass at a time, in order, into a
    ; collector of what it makes, whose list the action reads: for text, each range the passes
    ; kept, by the capture materializer selected for the stream's items and what the list is
    ; wanted to hold; for values, each value, by the value materializer selected for its type,
    ; noted in `remade-positions` where it makes another type than the list is wanted to hold.
    (if (and backed (or (== ranges (. U32 max)) (!= (. ([] (. facts materials) ranges) kind) .material-ranges)))
      (call decline id)
      (return false)
    )
    (let slot ([] capture-slots position))
    (let natural (call (. facts node-type) instance ([] capture-sites position)))
    (let item (call first-arg natural))
    (if (call (. types is-optional) item)
      (call decline id)
      (return false)
    )
    (let interface
      (call select-materializer
        (block
          (arg (if-expr backed (. (!! (. helping helper)) captures) (. (!! (. helping helper)) values)))
          (arg (if-expr backed buffer-item item))
          (arg (call desired-leaf desired))
          (arg backed)
          (arg id)
        )
      )
    )
    (if (== interface invalid-type)
      (return false)
    )
    (let made (call second-type-arg interface))
    (if (and (not backed) (== (call desired-leaf desired) item) (!= made item))
      (+= remade-positions position)
      (+= remade-types natural)
    )
    (let listed (call class-over (. types immutable-array-decl) made))
    (let collector (call collector-over made))
    (let kind (if-expr backed (. MaterialKind material-capture) (. MaterialKind material-value)))
    (if (or (== collector invalid-type) (not (call record-material id kind slot listed interface item)))
      (call decline id)
      (return false)
    )
    (let growing
      (call (. calls protocol-call)
        (block
          (arg collector)
          (arg (call (. program store-atom) "grow"))
          (arg id)
          (arg no-type)
          (arg false)
          (arg no-type)
          (arg no-type)
          (arg false)
        )
      )
    )
    (if (or (!= (. growing answer) (call grown-items collector)) (== (. growing fact) no-fact))
      (call decline id)
      (return false)
    )
    (call (. facts record-material)
      (block
        (arg (call MaterialFact instance id .material-grow slot collector no-type (. growing fact)))
      )
    )
    (if (!= listed natural)
      (+= restores slot)
      (+= restored natural)
      (call (. frame assign) slot listed)
    )
    (return true)
  )
  (fn-do _ materialize-result TypeId
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param body SyntaxId)
    (param value TypeId)
    (param selects Bool)
    (param forwards-it Bool)
    ; What an action gives under a helper, as the reference materializes it: an action whose names
    ; select a materializer, or whose arms give a type a value materializer's output converts to
    ; better than down, materializes, and has the helper roll back where it implements
    ; `PatternRollback`. Where the arms give a type a materializer makes, what such an action gives is
    ; made again by the value materializer selected for it, and the action gives what that makes; but
    ; not where the action is `it` alone, made as that type already. An optional value is made again
    ; only where it holds one, where the arms give an optional too, and a list item by item, where
    ; they give a list; an optional the arms give as what it holds, a list they give as none, and a
    ; list of optionals or of lists have no shape here. Where the arms declare no type, the action's
    ; own stands for theirs, as `results-assumed` then checks, and the value materializer selected is
    ; only noted there, to be called once the arms are known to give that type. An action that
    ; materializes where the arms give such a type `remakes-result`, which the reference runs where
    ; its arm does, never in a function of its own.
    (let helper (!! (. helping helper)))
    (let result (. rule-arming target))
    (let assuming (== result no-type))
    (let natural no-type)
    (let backed false)
    (if assuming
      (= result value)
      (let forwarded
        (scope (if-expr (!= (call (. tree forwarded-read) body) 0) forwarded-position (. U32 max))
          (lazy forwarded-position
            (call capture-position
              (block
                (arg (call capture-slot (call (. tree forwarded-read) body)))
                (arg (. pattern-arms arm))
              )
            )
          )
        )
      )
      (= natural
        (scope (if-expr (!= forwarded (. U32 max)) forwarded-type no-type)
          (lazy forwarded-type (call (. facts node-type) instance ([] capture-sites forwarded)))
        )
      )
      (= backed
        (scope (and (!= forwarded (. U32 max)) plain-forward)
          (lazy plain-forward (!= (call (. facts plan-of) instance ([] capture-sites forwarded)) .plan-stream-value))
        )
      )
      (+= assumed-results
        (call AssumedResult
          (block
            (arg value)
            (arg selects)
            (arg forwards-it)
            (arg natural)
            (arg backed)
            (arg id)
            (arg pattern)
            (arg body)
            (arg no-type)
          )
        )
      )
    )
    (let selected (or selects (call values-select result)))
    (if (not selected)
      (return value)
    )
    (= pattern-arms (= (. pattern-arms selects) true))
    (= remakes-result (call contains-output result))
    (call note-helper-use (!= (. helper rollback) no-type))
    (if (or (not (call contains-output result)) forwards-it)
      (return value)
    )
    (let requires (call result-requires value result id))
    (if (== requires 2)
      (return invalid-type)
    )
    (if (== requires 0)
      (return value)
    )
    (let listing (call is-listed value))
    (let optional (call (. types is-optional) value))
    (if (or (and listing (not (call is-listed result))) (and optional (not (call (. types is-optional) result))))
      (call decline id)
      (return invalid-type)
    )
    (let leaf
      (scope (if-expr listing (call first-arg value) (if-expr optional inner-value value))
        (lazy inner-value (call (. types optional-inner) value))
      )
    )
    (if (or (call (. types is-optional) leaf) (call is-listed leaf))
      (call decline id)
      (return invalid-type)
    )
    (let wanted
      (scope (if-expr listing (call first-arg result) (if-expr optional inner-result result))
        (lazy inner-result (call (. types optional-inner) result))
      )
    )
    (let interface (call select-materializer (. helper values) leaf wanted false id))
    (if (== interface invalid-type)
      (return invalid-type)
    )
    (if (== interface no-type)
      (return value)
    )
    (let made (call remade-as value interface))
    (if assuming
      (if (!= made value)
        (call decline id)
        (return invalid-type)
      )
      (= ([] assumed-results (- (. assumed-results length) 1))
        (call AssumedResult
          (block
            (arg value)
            (arg selects)
            (arg forwards-it)
            (arg natural)
            (arg backed)
            (arg id)
            (arg pattern)
            (arg body)
            (arg interface)
          )
        )
      )
      (return made)
    )
    (if (not (call record-result id value interface))
      (return invalid-type)
    )
    (return made)
  )
  (fn-do _ remade-as TypeId
    (param value TypeId)
    (param interface TypeId)
    ; The type a value made again by a value materializer has: what the materializer makes, as
    ; an optional where the value is one, or a list where it is a list.
    (let made (call second-type-arg interface))
    (if (call is-listed value)
      (return (call class-over (. types immutable-array-decl) made))
    )
    (return (if-expr (call (. types is-optional) value) (call (. types optional-of) made) made))
  )
  (fn-do _ record-result Bool
    (param site SyntaxId)
    (param value TypeId)
    (param interface TypeId)
    ; Records the call of the value materializer that makes what an action gives again: of the
    ; value; of what an optional one holds, which is made only where it holds one and given as
    ; the optional of what the materializer makes; or of each item of a list, into a collector of
    ; what the materializer makes, grown by the call recorded after the materializer's, whose
    ; list the action then gives. False where the pattern has no shape.
    (let made (call second-type-arg interface))
    (if (not (call is-listed value))
      (return
        (call record-material
          (block
            (arg site)
            (arg .material-result)
            (arg no-slot)
            (arg (call remade-as value interface))
            (arg interface)
            (arg (if-expr (call (. types is-optional) value) (call (. types optional-inner) value) value))
          )
        )
      )
    )
    (let collector (call collector-over made))
    (if (or (== collector invalid-type) (not (call record-material site .material-result no-slot (call remade-as value interface) interface (call first-arg value))))
      (call decline site)
      (return false)
    )
    (let growing
      (call (. calls protocol-call)
        (block
          (arg collector)
          (arg (call (. program store-atom) "grow"))
          (arg site)
          (arg no-type)
          (arg false)
          (arg no-type)
          (arg no-type)
          (arg false)
        )
      )
    )
    (if (or (!= (. growing answer) (call grown-items collector)) (== (. growing fact) no-fact))
      (call decline site)
      (return false)
    )
    (call (. facts record-material)
      (block
        (arg (call MaterialFact instance site .material-grow no-slot collector no-type (. growing fact)))
      )
    )
    (return true)
  )
  (fn-do _ values-select Bool
    (param type TypeId)
    ; Whether what a value materializer of the helper makes converts to a type better than down,
    ; as the reference finds an action that gives that type materializing.
    (for (in materializer (. (!! (. helping helper)) values))
      (let relation (call (. relations compare) (call second-type-arg materializer) type))
      (if (and (call relation-legal relation) (< (. relation rank) (call down-cast-rank)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ result-requires U8
    (param value TypeId)
    (param result TypeId)
    (param site SyntaxId)
    ; Whether the reference makes what an action gives again as the type the arms give: where it
    ; is optional and they are not, or a list and they are not, or what it holds past optionals
    ; and lists is another type than theirs, or has a value materializer selected for it. 0 for
    ; no, 1 for yes, 2 where the choice is ambiguous, reported at the site.
    (if (call (. types is-optional) value)
      (return
        (scope (if-expr (call (. types is-optional) result) (call result-requires inner-value inner-result site) 1)
          (lazy inner-value (call (. types optional-inner) value))
          (lazy inner-result (call (. types optional-inner) result))
        )
      )
    )
    (if (call is-listed value)
      (return (if-expr (call is-listed result) (call result-requires (call first-arg value) (call first-arg result) site) 1))
    )
    (let chosen (call select-materializer (. (!! (. helping helper)) values) value result false site))
    (if (== chosen invalid-type)
      (return 2)
    )
    (return (if-expr (or (!= chosen no-type) (!= value result)) 1 0))
  )
  (fn-do _ record-source-text TypeId
    (param id SyntaxId)
    (param result TypeId)
    ; Records where a part of a grammar gives the text it matched as a value, the call that
    ; makes it: under a helper with a capture materializer that makes the type the value is
    ; wanted as from the stream's items, that materializer's, as the reference's implicit
    ; materialization; else the slice `record-stream-text` records. The type the text is given
    ; as, or invalid where the part has no shape.
    (if (== (. helping helper) null)
      (return (call sliced-text id))
    )
    (let candidates (call source-candidates result))
    (if (== (. candidates length) 0)
      (return (call sliced-text id))
    )
    (let interface (call select-materializer candidates buffer-item (call peeled-optional result) true id))
    (if (== interface invalid-type)
      (return invalid-type)
    )
    (if (== interface no-type)
      (return (call sliced-text id))
    )
    (let made (call second-type-arg interface))
    (return
      (block
        (case? (call record-material id .material-text no-slot made interface no-type)
          made
        )
        (default
          invalid-type
        )
      )
    )
  )
  (fn-do _ sliced-text TypeId
    (param id SyntaxId)
    ; The type of the text a part of a grammar gives as `record-stream-text` records it.
    (return (if-expr (call record-stream-text id) (. types string-type) invalid-type))
  )
  (fn-do _ source-candidates (list TypeId)
    (param result TypeId)
    ; The capture materializers of the helper that make the type a value is wanted as, what it
    ; holds where it is optional.
    (let wanted (call peeled-optional result))
    (let found (list TypeId))
    (for (in materializer (. (!! (. helping helper)) captures))
      (if (== (call second-type-arg materializer) wanted)
        (+= found materializer)
      )
    )
    (return found)
  )
  (fn-do _ peeled-optional TypeId
    (param type TypeId)
    (let current type)
    (while (call (. types is-optional) current)
      (= current (call (. types optional-inner) current))
    )
    (return current)
  )
  (fn-expr _ is-listed Bool
    (param type TypeId)
    (call same-decl (call class-ref types type) (. types immutable-array-decl))
  )
  (fn-expr _ desired-leaf TypeId
    (param type TypeId)
    ; What a type a value is wanted as holds, past optionals and lists, as the reference selects a
    ; materializer for it.
    (if-expr (call is-listed current) (call desired-leaf (call first-arg current)) current)
    (where
      (lazy current (call peeled-optional type))
    )
  )
  (fn-do _ with-leaf TypeId
    (param type TypeId)
    (param leaf TypeId)
    ; A type a value is wanted as, with what it holds past optionals and lists another type.
    (if (call (. types is-optional) type)
      (return (call (. types optional-of) (call with-leaf (call (. types optional-inner) type) leaf)))
    )
    (if (call is-listed type)
      (return (call class-over (. types immutable-array-decl) (call with-leaf (call first-arg type) leaf)))
    )
    (return leaf)
  )
  (fn-do _ contains-output Bool
    (param type TypeId)
    ; Whether what a type holds past optionals and lists is what one of the helper's materializers
    ; makes.
    (let leaf (call desired-leaf type))
    (for (in materializer (. (!! (. helping helper)) captures))
      (if (== (call second-type-arg materializer) leaf)
        (return true)
      )
    )
    (for (in materializer (. (!! (. helping helper)) values))
      (if (== (call second-type-arg materializer) leaf)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ selects U8
    (param type TypeId)
    (param desired TypeId)
    (param backed Bool)
    (param site SyntaxId)
    ; Whether the helper selects a materializer for a name of a type wanted as another, past
    ; optionals and lists: for a name captured over text, a capture materializer of the stream's
    ; items; else a value materializer of what it holds, which for a value wanted as its own type
    ; must make that type. 0 for none, 1 for one, 2 where the choice is ambiguous, reported at the
    ; site.
    (let held (call peeled-optional type))
    (let wanted (if-expr (call (. types is-optional) desired) (call (. types optional-inner) desired) desired))
    (if (call is-listed held)
      (= held (call first-arg held))
      (= wanted (if-expr (call is-listed wanted) (call first-arg wanted) wanted))
    )
    (let chosen
      (call select-materializer
        (block
          (arg (if-expr backed (. (!! (. helping helper)) captures) (. (!! (. helping helper)) values)))
          (arg (if-expr backed buffer-item held))
          (arg wanted)
          (arg backed)
          (arg site)
        )
      )
    )
    (if (== chosen invalid-type)
      (return 2)
    )
    (if (== chosen no-type)
      (return 0)
    )
    (if (and (not backed) (== held wanted))
      (let made (call (. relations compare) (call second-type-arg chosen) (call desired-leaf wanted)))
      (if (or (not (call relation-legal made)) (>= (. made rank) (call down-cast-rank)))
        (return 0)
      )
    )
    (return 1)
  )
  (fn-do _ select-materializer TypeId
    (param candidates (list TypeId))
    (param input TypeId)
    (param desired TypeId)
    (param capture Bool)
    (param site SyntaxId)
    ; The materializer the reference selects among some for an input and a type wanted: of those
    ; that take the input better than down, and a union only as itself, those that take it as it
    ; is where any does; of those, the ones whose output
    ; converts to what the wanted type holds better than down, or else all; the one whose
    ; conversion ranks best, its output's to the wanted type or else to the input's own text. None
    ; where none takes the input; a tie is the reference's error at the site.
    (let leaf (if-expr (!= desired no-type) (call desired-leaf desired) no-type))
    (let fallback input)
    (if capture
      (= fallback (if-expr (call text-items) (. types string-type) (call class-over (. types array-decl) input)))
    )
    (let compatible (list TypeId))
    (let ranks (list I32))
    (let fits (list Bool))
    (let exact false)
    (for (in candidate candidates)
      (= exact (or exact (and (== (call first-type-arg types candidate) input) (call takes-input candidate input))))
    )
    (for (in candidate candidates)
      (if (or (not (call takes-input candidate input)) (and exact (!= (call first-type-arg types candidate) input)))
        (continue)
      )
      (let output (call second-type-arg candidate))
      (let fit false)
      (let rank (. I32 max))
      (if (!= leaf no-type)
        (let given (call (. relations compare) output leaf))
        (if (and (call relation-legal given) (< (. given rank) (call down-cast-rank)))
          (= fit true)
          (= rank (. given rank))
        )
      )
      (if (not fit)
        (let plain (call (. relations compare) output fallback))
        (if (and (call relation-legal plain) (< (. plain rank) (call down-cast-rank)))
          (= rank (. plain rank))
        )
      )
      (+= compatible candidate)
      (+= ranks rank)
      (+= fits fit)
    )
    (let any-fit (!= (call (. fits find) true) null))
    (let best (. I32 max))
    (for (in position (..< 0 (. compatible length)))
      (if (and (or ([] fits position) (not any-fit)) (< ([] ranks position) best))
        (= best ([] ranks position))
      )
    )
    (let chosen (list TypeId))
    (for (in position (..< 0 (. compatible length)))
      (if (and (or ([] fits position) (not any-fit)) (== ([] ranks position) best))
        (+= chosen ([] compatible position))
      )
    )
    (if (> (. chosen length) 1)
      (let keys (list String))
      (for (in type chosen)
        (+= keys (call type-key types type))
      )
      (let named (call (. ", " join) keys))
      (let wanted (if-expr (!= desired no-type) (call type-key types desired) "*"))
      (let capability (if-expr capture "PatternCaptureMaterializer" "PatternValueMaterializer"))
      (call (. frame diagnose)
        (block
          (arg site)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Pattern helper has ambiguous " capability " capabilities for input " (call type-key types input) ", output " wanted ": " named)
                  )
                )
              )
            )
          )
          (arg input)
          (arg desired)
        )
      )
      (call (. frame mention) chosen)
      (return invalid-type)
    )
    (return (if-expr (!= (. chosen length) 0) ([] chosen 0) no-type))
  )
  (fn-expr _ takes-input Bool
    (param candidate TypeId)
    (param input TypeId)
    (case? (and (call unites input) (!= input accepted))
      false
    )
    (default
      (and (call relation-legal taken) (< (. taken rank) (call down-cast-rank)))
    )
    (where
      (lazy accepted (call first-type-arg types candidate))
      (lazy taken (call (. relations compare) input accepted))
    )
  )
  (fn-do _ unites Bool
    (param type TypeId)
    ; Whether a type is a union as the reference holds one: one written of its cases, or one a
    ; module declares.
    (match? ([] (. types rows) type)
      (case .type-union
        (return true)
      )
      (case .type-named-union
        (return true)
      )
      (case .type-class
        (return (== (call (. types intrinsic-of) type) .union))
      )
    )
    (return false)
  )
  (fn-expr _ second-type-arg TypeId
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (if-expr (> (. row args count) 1) (call (. types child-type) (. row args) 1) no-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-do + capability-receiver TypeId
    (param participant TypeId)
    (param interface TypeId)
    ; The type of what answers a capability interface for a helper, a materializer, a collector
    ; storage or a record boundary: the helper, or what the property it delegates that interface to
    ; holds, its initializer typed where it declares no type, followed while that delegates it again.
    ; None where such a property has no type.
    (let current participant)
    (let visited (list TypeId))
    (while (== (call (. visited find) current) null)
      (+= visited current)
      (let pairs (call (. types delegates-of) current))
      (let delegated false)
      (let next no-type)
      (for (in offset (..< 0 (/ (. pairs length) 2)))
        (if (and (== ([] pairs (* offset 2)) interface) (not delegated))
          (= delegated true)
          (= next (call (. calls ranking delegate-type) current offset))
        )
      )
      (if (not delegated)
        (return current)
      )
      (if (or (== next no-type) (== next invalid-type))
        (return no-type)
      )
      (= current next)
    )
    (return current)
  )
  (fn-do _ record-material Bool
    (param site SyntaxId)
    (param kind MaterialKind)
    (param slot SlotId)
    (param type TypeId)
    (param interface TypeId)
    (param input TypeId)
    ; Records the call of a materializer that makes a value at a place, kept apart from the calls
    ; of its node: `materialize-capture` of the stream's buffer and two cursors, or
    ; `materialize-value` of the value, on what answers the interface for the helper, reached
    ; through the properties the helper delegates it to, which the call keeps.
    (let receiver (call capability-receiver (. (!! (. helping helper)) participant) interface))
    (let places (list U32))
    (if (or (== receiver no-type) (and (!= receiver (. (!! (. helping helper)) participant)) (not (call (. calls ranking delegate-path) (. (!! (. helping helper)) participant) receiver places))))
      (call decline site)
      (return false)
    )
    (let made (call ProtocolCall))
    (if (or (== kind .material-text) (== kind .material-capture) (== kind .material-eager))
      (= made
        (call (. calls protocol-call)
          (block
            (arg receiver)
            (arg (call (. program store-atom) "materialize-capture"))
            (arg site)
            (arg (. stream-view buffer))
            (arg false)
            (arg (. types index-type))
            (arg (. types index-type))
            (arg false)
          )
        )
      )
      (else
        (= made
          (call (. calls protocol-call)
            (block
              (arg receiver)
              (arg (call (. program store-atom) "materialize-value"))
              (arg site)
              (arg input)
              (arg false)
              (arg no-type)
              (arg no-type)
              (arg false)
            )
          )
        )
      )
    )
    (if (or (== (. made fact) no-fact) (!= (. made answer) (call second-type-arg interface)))
      (call decline site)
      (return false)
    )
    (if (!= (. places length) 0)
      (= (. ([] (. facts calls) (. made fact)) through) (call (. facts keep-steps) places (call (. calls step-getters) places)))
    )
    (call (. facts record-material)
      (block
        (arg (call MaterialFact instance site kind slot type interface (. made fact)))
      )
    )
    (call note-helper-use false)
    (return true)
  )
  (fn-do _ note-helper-use _
    (param rolls Bool)
    ; Notes that the pattern of a rule typed for a helper makes a value through it, or needs it to
    ; roll back, where the helper is the rule's and not that of a match in one of its actions.
    (if (or (== rule-helper-site 0) (!= (. helping site) rule-helper-site))
      (return)
    )
    (= (. ([] (. instances rows) instance) uses-helper) true)
    (if rolls
      (= (. ([] (. instances rows) instance) rolls-helper) true)
    )
  )
  (fn-do _ note-mark _
    ; Notes that the body being typed holds a rollback mark, which its parts ask the helper for or
    ; are given by the rules they call: the calls of `mark` and `rewind` that body makes on the
    ; helper are recorded once, at the body. A rule's own pattern that holds one gives it to the
    ; pattern calling it.
    (if (or (== (. helping body) 0) (== (. helping helper) null) (== (. helping helper rollback) no-type))
      (return)
    )
    (if (== (call (. facts rollback-body-of) instance (. helping body)) (. U32 max))
      (let participant (. (!! (. helping helper)) participant))
      (let held (call first-type-arg types (. (!! (. helping helper)) rollback)))
      (let made
        (call (. calls protocol-call)
          (block
            (arg participant)
            (arg (call (. program store-atom) "mark"))
            (arg (. helping body))
            (arg no-type)
            (arg false)
            (arg no-type)
            (arg no-type)
            (arg false)
          )
        )
      )
      (let mark-call (. made fact))
      (let rewinding
        (call (. calls protocol-call)
          (block
            (arg participant)
            (arg (call (. program store-atom) "rewind"))
            (arg (. helping body))
            (arg held)
            (arg false)
            (arg no-type)
            (arg no-type)
            (arg false)
          )
        )
      )
      (let rewind-call (. rewinding fact))
      (if (or (!= (. made answer) held) (== mark-call no-fact) (== rewind-call no-fact))
        (call decline (. helping body))
        (return)
      )
      (let kept (if-expr (call is-integer-kind (call (. types intrinsic-of) held)) held (call (. types optional-of) held)))
      (call (. facts add-rollback-body)
        (block
          (arg (call RollbackBody instance (. helping body) mark-call rewind-call held kept))
        )
      )
    )
    (if (and (!= rule-helper-site 0) (== (. helping site) rule-helper-site) (== (. helping body) rule-helper-site))
      (= (. ([] (. instances rows) instance) carries-mark) true)
    )
  )
  (fn-do _ note-observer _
    ; Notes that the body being typed runs under a helper that observes the literal words it
    ; matches: the calls of `record-pattern-literal` and `rewind-pattern-literals` that body makes
    ; on the helper are recorded once, at the body.
    (if (or (== (. helping body) 0) (== (. helping helper) null) (== (. helping helper observer) no-type))
      (return)
    )
    (if (!= (call (. facts observer-body-of) instance (. helping body)) (. U32 max))
      (return)
    )
    (let participant (. (!! (. helping helper)) participant))
    (let recording
      (call (. calls protocol-call)
        (block
          (arg participant)
          (arg (call (. program store-atom) "record-pattern-literal"))
          (arg (. helping body))
          (arg (. types index-type))
          (arg false)
          (arg (. types index-type))
          (arg no-type)
          (arg false)
        )
      )
    )
    (let record (. recording fact))
    (let rewinding
      (call (. calls protocol-call)
        (block
          (arg participant)
          (arg (call (. program store-atom) "rewind-pattern-literals"))
          (arg (. helping body))
          (arg (. types index-type))
          (arg false)
          (arg no-type)
          (arg no-type)
          (arg false)
        )
      )
    )
    (let rewind (. rewinding fact))
    (if (or (== record no-fact) (== rewind no-fact))
      (call decline (. helping body))
      (return)
    )
    (call (. facts add-observer-body) (call ObserverBody instance (. helping body) record rewind))
  )
  (fn-do _ note-observed _
    (param pattern SyntaxId)
    ; Notes that a pattern typed under a helper that observes literal words runs under it, as the
    ; reference runs one that `observes-literals` says does, which needs the helper to roll back.
    (if (or unobserved (not (call observes-literals tree facts instance pattern)))
      (return)
    )
    (lazy unobserved (or (== (. helping helper) null) (== (. helping helper observer) no-type)))
    (= helping (= (. helping rolls) true))
    (call note-helper-use true)
  )
  (fn-do _ reads-length-only Bool
    (param slot SlotId)
    (param body SyntaxId)
    (param optional Bool (= false))
    ; Whether an action reads a name only for its `length`, a number the span it captured has too,
    ; as the reference keeps such a name as the span it captured; an `optional` name, only through
    ; `?.`.
    (let receivers (list SyntaxId))
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-get-expression row)
          (if (and length-read (== (. row is-optional) optional) (not (. row is-tracked)) (not (. row is-loop)))
            (+= receivers (. row object))
          )
          (lazy length-read (== (. row name) (!! (. types length-atom))))
        )
      )
    )
    (let found false)
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (if (and (is ([] (. tree nodes) node) .node-identifier) (== (call capture-slot node) slot))
        (if (== (call (. receivers find) node) null)
          (return false)
        )
        (= found true)
      )
    )
    (return found)
  )
  (fn-do _ type-location Bool
    (param arm SyntaxId)
    (param spans Bool)
    (param body SyntaxId)
    ; Types the `location` an arm of a grammar declares where its expression reads it: a
    ; `MatchLocation` where the arm has a pattern, and else a `TokenLocation`. The call that
    ; answers where in the input a cursor lies, the stream's `pattern-location-at`, is recorded at
    ; the arm, as the reference makes it there before the expression runs. Only
    ; the stream a match makes, and the one a rule a module declares is given, are known here.
    (let slot (call arm-slot arm .slot-location))
    (if (or (== slot no-slot) (not (call reads-slot body slot)))
      (return true)
    )
    (let type (if-expr spans (. types match-location-type) (. types token-location-type)))
    (if (or (== (. stream-view type) no-type) (== type invalid-type))
      (return false)
    )
    (if (!= (. (call (. calls protocol-call) (. stream-view type) (call (. program store-atom) "pattern-location-at") arm (. types index-type) (:role (. CallRole role-location))) answer) (. types token-location-type))
      (return false)
    )
    (call (. frame assign) slot type)
    (return true)
  )
  (fn-do _ reads-slot Bool
    (param body SyntaxId)
    (param slot SlotId)
    ; Whether an expression, or a function written in it, reads a slot.
    (for (in node (..< (call (. tree subtree-start) body) (+ body 1)))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (and (== (. resolution kind) .resolve-slot) (== (. resolution slot) slot))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ is-quiet Bool
    (param id SyntaxId)
    ; Whether an expression cannot panic: a local or a constant named, a literal, a case of an
    ; anonymous union or a tuple made of them, texts joined or compared, a text printed, and
    ; blocks of them.
    (match? ([] (. tree nodes) id)
      (case (call .node-block row)
        (return (call all-quiet (. row body)))
      )
      (case (call .node-do-block row)
        (return (call is-quiet (. row body)))
      )
      (case (call .node-print row)
        (return (and (== (call (. facts node-type) instance (. row body)) (. types string-type)) (call is-quiet (. row body))))
      )
      (case (call .node-binary-expression row)
        (let texts
          (scope (and text-left (== (call (. facts node-type) instance (. row rhs)) (. types string-type)))
            (lazy text-left (== (call (. facts node-type) instance (. row lhs)) (. types string-type)))
          )
        )
        (let joins
          (scope (or concatenates (== (. row op) .equals-op) (== (. row op) .not-equals-op))
            (lazy concatenates (or (== (. row op) .concat-op) (== (. row op) .concat-string-op)))
          )
        )
        (return (and texts joins (call is-quiet (. row lhs)) (call is-quiet (. row rhs))))
      )
      (case (call .node-identifier row)
        (if (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom)))
          (return true)
        )
        (let slot (call capture-slot id))
        (return (and (!= slot no-slot) (!= (. ([] (. bindings slots) slot) kind) .slot-lazy)))
      )
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case (call .node-anonymous-case row)
        (return (call all-quiet (. row args)))
      )
      (case (call .node-tuple-syntax row)
        (return (call all-quiet (. row items)))
      )
      (case (call .node-argument row)
        (return (call is-quiet (. row expr)))
      )
    )
    (return false)
  )
  (fn-do _ all-quiet Bool
    (param args (of RowRange SyntaxId))
    (for (in arg ([] (. tree children) args))
      (if (not (call is-quiet arg))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ check-stream-panic _
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; An arm that raises what it gives where no arm before it passed: a panic, or an error that
    ; leaves the function. Its value is evaluated as an assertion's exception is, and reads as
    ; `location` where the pattern failed farthest. One with a pattern of its own, or that gives
    ; any other value, has no shape here.
    (let exception SyntaxId 0)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-stream-transform row)
        (if (== (. row pattern) 0)
          (= exception (. row right))
        )
      )
    )
    (if (or (== exception 0) (call (. tree mentions) exception "it"))
      (call decline id)
      (return)
    )
    (if (not (call type-location pattern false exception))
      (call decline id)
      (return)
    )
    (let saved (. frame surround))
    (= (. frame surround) (= (. frame surround effects) (call exceptional-effects (. saved effects))))
    (let raised (call infer exception))
    (= (. frame surround) saved)
    (if (or (== raised invalid-type) (== raised no-type))
      (return)
    )
    (if (call is-subtype types raised (. types panic-type))
      (call (. instances mark-may-panic) instance)
      (return)
    )
    (if (call is-subtype types raised (. types error-type))
      (call note-outgoing raised id)
      (call (. facts set-plan) instance id .plan-raise)
      (return)
    )
    (call decline id)
  )
  (fn-do _ stream-node-type TypeId
    (param id SyntaxId)
    ; The type the reference declares for a part of a grammar that runs nothing: the text
    ; it matched for a literal, a range of characters or any one, and for a repeat or a count of
    ; a part; for a call of a rule, what the rule gives. Over integer items, a range of characters
    ; gives the item it matched and a literal, where nothing reads it, none; each tests items
    ; against code points they hold, and other text is an error, as is any text over items of
    ; another type. A sequence has the type of its last part
    ; and a lookahead that of its operand; an optional part is optional, and alternatives join.
    ; An optional part whose operand gives an optional is one of that optional, as the reference
    ; types it, only where nothing reads its value. A repeat or a count of a part gives its text only where the reference reckons the part
    ; gives the text it matched; a repeat of a part that gives a value, neither text nor optional,
    ; gives an `ImmutableArray` of the values, kept by a `PatternCollector` whose growing call is
    ; recorded at the repeat, and so does a count of such a part, or of a `.`, over items that are
    ; no characters. A count of another part that gives its text is text over any items, as the reference
    ; types it, though over items that are no characters what it gives is empty, so nothing may
    ; read it there. Alternatives that call rules are valued by their text only where each rule
    ; gives its text; where each gives a value of one type that is not optional, they give the
    ; value of the one that passed, and are planned so, as are alternatives that each test an item
    ; against a value of one type. Nothing reads what the alternatives of a part that gives the
    ; text it matched give, as the reference replaces it with that text. A repeat or a count whose value nothing
    ; reads, of a part that gives neither its text nor a value, gives none, as the reference makes
    ; none, and so do alternatives whose value nothing reads. Another count of a part that gives a
    ; value, other alternatives that call rules, and any other part have no shape here.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-string row)
        (if (call text-items)
          (return (. types string-type))
        )
        (if (and (. valuing unvalued) (call is-integer (. stream-view item)))
          (if (call some (. row text codepoints) (:where (not (call item-holds (as each U64)))))
            (return (call report-unheld id))
          )
          (return no-type)
        )
        (if (and (!= (. stream-view item) no-type) (not (call is-integer (. stream-view item))))
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg (call (. program store-atom) "Text in a pattern can only match character or integer items"))
            )
          )
          (return invalid-type)
        )
      )
      (case .node-stream-any
        (return (if-expr (call text-items) (. types string-type) (. stream-view item)))
      )
      (case (call .node-stream-char-range row)
        (if (and (call (. tree char-bound) (. row first)) (call (. tree char-bound) (. row last)))
          (if (call text-items)
            (return (. types string-type))
          )
          (if (call is-integer (. stream-view item))
            (if (or (not (call item-holds (call (. tree bound) (. row first)))) (not (call item-holds (call (. tree bound) (. row last)))))
              (return (call report-unheld id))
            )
            (return (. stream-view item))
          )
        )
      )
      (case (call .node-stream-predicate row)
        (return (call predicate-type id (. row predicate)))
      )
      (case (call .node-stream-equality row)
        (return (call equality-type id (. row value)))
      )
      (case (call .node-stream-and row)
        (let saved valuing)
        (= valuing (= (. valuing unvalued) true))
        (let left (call stream-node-type (. row left)))
        (= valuing saved)
        (let right (call stream-node-type (. row right)))
        (return (if-expr (== left invalid-type) invalid-type right))
      )
      (case (call .node-stream-or row)
        (let saved valuing)
        (if (call returns-span instance id)
          (= valuing (= (. valuing unvalued) true))
        )
        (let left (call stream-node-type (. row left)))
        (let right (call stream-node-type (. row right)))
        (= valuing saved)
        (let items (call tests-item id))
        (if (and (or items (call stream-valued (. row left)) (call stream-valued (. row right))) unspanned)
          (if (and (. valuing unvalued) (!= left invalid-type) (!= right invalid-type))
            (return no-type)
          )
          (= left (call valued-alternatives (. row left) left))
          (= right (call valued-alternatives (. row right) right))
          (if (or (!= left right) left-unfit (not (call stream-valued (. row left))) (not (call stream-valued (. row right))))
            (if (and (!= left right) (call typed left) (call typed right))
              (let shown (str (call type-short-name types left) " and " (call type-short-name types right)))
              (call (. frame diagnose) id .stated (call (. program store-atom) (str "Alternatives give " shown "; give each a value of one type")))
              (else
                (call decline id)
              )
            )
            (return invalid-type)
          )
          (lazy left-unfit (or (== left invalid-type) (== left no-type) (call (. types is-optional) left)))
          (lazy typed (=> (type) (and (!= type invalid-type) (!= type no-type))))
          (call (. facts set-plan) instance id .plan-stream-value)
          (call (. facts set-node-type) instance id left)
          (return left)
        )
        (lazy unspanned (or items (not (call returns-span instance id))))
        (return (call join-stream-types id left right))
      )
      (case (call .node-stream-unary row)
        (let operand (call stream-node-type (. row operand)))
        (if (or (== operand invalid-type) (== operand no-type))
          (return operand)
        )
        (if (== (. row op) .zero-or-one-op)
          (let optional (call (. types optional-of) operand))
          (if (call stream-valued (. row operand))
            (if (call (. types is-optional) operand)
              (if (not (. valuing unvalued))
                (call decline id)
                (return invalid-type)
              )
              (= optional (call (. types optional-around) operand))
            )
            (call (. facts set-node-type) instance id optional)
          )
          (return optional)
        )
        (if (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op))
          (if (and (not (call text-items)) (not (call stream-valued (. row operand))))
            (if (call returns-span instance (. row operand))
              (return (call class-over (. types immutable-array-decl) (. stream-view item)))
            )
            (call decline id)
            (return invalid-type)
          )
          (if (and (call text-items) (call returns-span instance (. row operand)))
            (return (. types string-type))
          )
          (return (call repeated-values id (. row operand) operand))
        )
        (if (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op))
          (if (call (. tree guards) (. row operand))
            (call (. facts set-plan) instance id .plan-stream-guard)
          )
          (return operand)
        )
      )
      (case (call .node-stream-capture row)
        (let saved valuing)
        (= valuing (= (. valuing unvalued) false))
        (let captured (call stream-node-type (. row pattern)))
        (= valuing saved)
        (return captured)
      )
      (case (call .node-stream-transform row)
        (if (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)))
          (return (call stream-node-type (. row pattern)))
        )
      )
      (case .node-stream-call
        (return (call stream-call-type id))
      )
      (case (call .node-stream-type row)
        (return (call type-node-type id (. row type)))
      )
      (case (call .node-stream-length row)
        (if (or (not (call counts id (. row min) (== (. row max) 0))) (and (!= (. row max) 0) (not (call counts id (. row max) true))))
          (return invalid-type)
        )
        (let counted (call stream-node-type (. row operand)))
        (if (== counted invalid-type)
          (return invalid-type)
        )
        (if (call stream-valued id)
          (return (call repeated-values id (. row operand) counted))
        )
        (if (not (call returns-span instance (. row operand)))
          (if (. valuing unvalued)
            (return no-type)
          )
          (call decline id)
          (return invalid-type)
        )
        (return (. types string-type))
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ class-error-site SyntaxId
    (param pattern SyntaxId)
    ; Where the reference reports a range of characters in a pattern over items that are neither
    ; characters nor integers, which it cannot test: at the first it meets as it emits the arms in
    ; turn. Where the pattern has more than one arm and one of them may start with anything, the
    ; reference first tests the item an arm starts with where the arm must start with one of
    ; certain characters, and reports that test at the arm. None where no range is met; `U32.max`
    ; where the pattern is shaped so that where the reference meets one first is not known here.
    (let arms (list SyntaxId))
    (call stream-arms pattern arms)
    (let ranged false)
    (for (in arm arms)
      (= ranged (or ranged (!= (call range-site arm) 0)))
    )
    (if (not ranged)
      (return 0)
    )
    (let guarded false)
    (if (> (. arms length) 1)
      (let open false)
      (for (in arm arms)
        (let first (call first-items arm))
        (if (== first .first-unsure)
          (return (. U32 max))
        )
        (= open (or open (== first .first-open)))
        (= guarded (or guarded (== first .first-ranges)))
      )
      (if (and guarded (not open))
        (return (. U32 max))
      )
    )
    (for (in arm arms)
      (if (and guarded (== (call first-items arm) .first-ranges))
        (return arm)
      )
      (let site (call range-site arm))
      (if (!= site 0)
        (return site)
      )
    )
    (return 0)
  )
  (fn-do _ valued-alternatives TypeId
    (param id SyntaxId)
    (param type TypeId)
    ; What a side of alternatives that give the value of the one that passed gives: alternatives
    ; nested there that gave none, typed as part of alternatives that give the text they matched,
    ; typed again now that their value is read.
    (return-if type (if (or (!= type no-type) (not (is ([] (. tree nodes) id) .node-stream-or)))))
    (return (call stream-node-type id))
  )
  (fn-do _ stream-arms _
    (param id SyntaxId)
    (param arms (list SyntaxId))
    ; The arms of a grammar, in the order written.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (call stream-arms (. row left) arms)
        (call stream-arms (. row right) arms)
        (return)
      )
    )
    (+= arms id)
  )
  (fn-do _ first-items FirstItems
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (return (if-expr (!= (. row pattern) 0) (call first-items (. row pattern)) .first-open))
      )
      (case (call .node-stream-panic row)
        (return (call first-items (. row pattern)))
      )
      (case (call .node-stream-capture row)
        (return (call first-items (. row pattern)))
      )
      (case (call .node-stream-and row)
        (let left (call first-items (. row left)))
        (return (if-expr (== left .first-open) (call first-items (. row right)) left))
      )
      (case .node-stream-any
        (return .first-any)
      )
      (case .node-stream-char-range
        (return .first-ranges)
      )
      (case .node-stream-predicate
        (return .first-open)
      )
      (case (call .node-stream-unary row)
        (if (or (== (. row op) .zero-or-one-op) (== (. row op) .zero-or-more-op) lookahead)
          (return .first-open)
        )
        (lazy lookahead (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op)))
        (if (== (. row op) .one-or-more-op)
          (return (call first-items (. row operand)))
        )
      )
    )
    (return .first-unsure)
  )
  (fn-do _ range-site SyntaxId
    (param id SyntaxId)
    ; Where the reference reports the first range of characters it meets in a part of a pattern
    ; over items that cannot be tested so: at the range, or at a repeat it scans for. None where
    ; the part has none, and `U32.max` where one lies where the reference meets it otherwise.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (return (if-expr (!= (. row pattern) 0) (call range-site (. row pattern)) 0))
      )
      (case (call .node-stream-panic row)
        (return (call range-site (. row pattern)))
      )
      (case (call .node-stream-capture row)
        (return (call range-site (. row pattern)))
      )
      (case (call .node-stream-and row)
        (let left (call range-site (. row left)))
        (return (if-expr (== left 0) (call range-site (. row right)) left))
      )
      (case .node-stream-char-range
        (return id)
      )
      (case (call .node-stream-unary row)
        (let inner (call range-site (. row operand)))
        (if (and (!= inner 0) (== inner (. row operand)) repeats)
          (return id)
        )
        (lazy repeats (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op)))
        (return inner)
      )
      (case (call .node-stream-length row)
        (return (call range-site (. row operand)))
      )
      (case (call .node-stream-or row)
        (if (or (!= (call range-site (. row left)) 0) (!= (call range-site (. row right)) 0))
          (return (. U32 max))
        )
      )
    )
    (return 0)
  )
  (fn-expr _ text-items Bool
    ; Whether the stream a pattern reads holds characters, whose parts give the text they matched.
    (== (. stream-view item) (call (. types type-row) .char))
  )
  (fn-expr + encoded Bool
    ; Whether the buffer of the stream a pattern reads holds the UTF-8 bytes of the characters the
    ; stream gives, as a `TextTokenStream`'s text view does, rather than the characters.
    (and (!= (. stream-view buffer) no-type) (!= (call class-arg types (. stream-view buffer) 0) (. stream-view item)))
  )
  (fn-do _ view-name Atom
    (param encoded Bool)
    ; The getter of a stream's view of its buffer: `pattern-text-view` where the buffer holds the
    ; UTF-8 bytes of its characters, and else `pattern-view`.
    (return (call (. program store-atom) (if-expr encoded "pattern-text-view" "pattern-view")))
  )
  (fn-do _ pattern-argument-type TypeId
    (param arg SyntaxId)
    ; A pattern given to a rule as an argument, `~ p`, which the reference passes as a function
    ; the rule calls with the stream: one that is a call of a rule a module declares written
    ; alone passes the function made of that rule, and any other a function made of the pattern
    ; where it is written. It is typed over the items of the stream the call reads, as a rule's
    ; arms are, read as the `TokenStream` of those items the function is given, as a
    ; `PatternFunc` of those items and what it gives, which asks the stream for more input through
    ; the calls `record-growth` keeps. One that captures a name is an error, as nothing can read
    ; it; one that runs an action has no shape here, nor one that reads a name or calls a local
    ; rule but as `plain-argument` says, which keeps the names its function is given. Under a helper it is typed for the
    ; helper as a pattern of its own, which holds a rollback mark where the helper can roll back,
    ; and needs the helper to roll back where its parts do.
    (let known (call (. facts node-type) instance arg))
    (if (!= known no-type)
      (return known)
    )
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) arg)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (let reads (list SlotId))
    (let read-types (list TypeId))
    (if (or (== pattern 0) (== (. stream-view item) no-type))
      (call decline arg)
      (return invalid-type)
    )
    (let capture (call (. tree first-capture) pattern))
    (if (!= capture 0)
      (call (. frame diagnose)
        (block
          (arg capture)
          (arg .stated)
          (arg (call (. program store-atom) "A pattern given as an argument can't capture names"))
        )
      )
      (return invalid-type)
    )
    (if (not (call plain-argument pattern reads read-types))
      (call decline arg)
      (return invalid-type)
    )
    (let given (call class-over (. types token-stream-decl) (. stream-view item)))
    (if (not (call record-growth given arg (call encoded)))
      (call decline arg)
      (return invalid-type)
    )
    (let outer stream-view)
    (let texts rule-arming)
    (let rolls helping)
    (= stream-view (= (. stream-view type) given))
    (= rule-arming (= (. rule-arming texts) false))
    (= rule-arming (= (. rule-arming capture-root) pattern))
    (= rule-arming (= (. rule-arming target) no-type))
    (= rule-arming (= (. rule-arming rule) true))
    (= rule-arming (= (. rule-arming span) false))
    (= helping (= (. helping rolls) false))
    (= rule-arming (= (. rule-arming casting) 0))
    (= helping (= (. helping explicit) false))
    (= helping (= (. helping body) arg))
    (match? ([] (. tree nodes) pattern)
      (case (call .node-stream-call call)
        (if (and (== (. call params count) 0) (== (. call args count) 0) (== (call rule-of pattern) 0))
          (= rule-arming (= (. rule-arming casting) pattern))
        )
      )
    )
    (let joined (call stream-arm-type pattern))
    (call note-observed pattern)
    (let rolled (. helping rolls))
    (if (!= (. helping helper) null)
      (call note-mark)
    )
    (= stream-view outer)
    (= rule-arming texts)
    (= helping rolls)
    (if rolled
      (= helping (= (. helping rolls) true))
      (call note-helper-use true)
    )
    (if (== joined invalid-type)
      (return invalid-type)
    )
    (let result (if-expr (== joined no-type) (. types string-type) joined))
    (call convert-stream-arms pattern result)
    (call (. facts set-node-type) instance pattern result)
    (let rule no-instance)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-stream-call row)
        (if (and (== (. row params count) 0) (== (. row args count) 0))
          (let fact (call (. facts first-call) instance pattern))
          (= rule (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
        )
      )
    )
    (if (== (. stream-view buffer) no-type)
      (call decline arg)
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (. stream-view item))
    (call (. scratch types push) result)
    (let type (call (. types class-with-args) (. types pattern-func-decl module) (. types pattern-func-decl decl) mark))
    (let answer (call (. types optional-of) result))
    (let helper (if-expr (!= (. helping helper) null) (. helping helper participant) no-type))
    (let start U32 (as (. facts action-slots length) U32))
    (if (== rule no-instance)
      (for (in position (..< 0 (. reads length)))
        (call (. facts action-slots append) ([] reads position))
        (call (. facts action-types append) ([] read-types position))
      )
    )
    (let count U32 (as (- (. facts action-slots length) start) U32))
    (let local SyntaxId 0)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-stream-call row)
        (if (and (== rule no-instance) (== (. row params count) 0) (== (. row args count) 0))
          (= local (call rule-of pattern))
        )
      )
    )
    (call (. facts pattern-arguments append)
      (block
        (arg
          (call PatternArgument
            (block
              (arg instance)
              (arg arg)
              (arg result)
              (arg answer)
              (arg given)
              (arg (. stream-view buffer))
              (arg rule)
              (arg helper)
              (arg (call (of RowRange U32) start count))
              (arg local)
            )
          )
        )
      )
    )
    (call (. facts set-node-type) instance arg type)
    (return type)
  )
  (fn-do _ plain-argument Bool
    (param pattern SyntaxId)
    (param reads (list SlotId))
    (param read-types (list TypeId))
    (param quiet Bool (= false))
    ; Whether a pattern given to a rule runs no action and reads no name but a global or one
    ; `reads-given` says the function made of it can be given, so that the function needs no more
    ; of the function it is written in. It calls a local rule given no values, the ways the
    ; reference compiles: written alone, a rule that is such a pattern itself and calls no rule,
    ; which the function then runs where it calls it, as the reference's function of the rule shows
    ; no frame where nothing it runs may panic, or a rule of a match in a function that is no rule
    ; that runs actions and captures names but calls no rule, panics in no arm and reads no name
    ; but a global, one it declares or one the function can be given; or anywhere in it, any rule
    ; `gives-arguments` says
    ; the function can run, as in a rule a module declares. The first is given the rule's arguments
    ; too wherever it can be, as the rule runs in a function of its own where a helper it makes its
    ; value through may panic. Keeps the names the function is given, each once, with its type.
    ; A name the binder resolved nothing for is one the parser left where it tried another way to
    ; read the text, and is no part of the pattern. One that is `quiet` declines nothing.
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (let plain true)
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let kind (. (call (. bindings resolution-of) (. frame binding) node) kind))
          (= plain (or (== kind .resolve-none) (== kind .resolve-global) (call reads-given node reads read-types)))
        )
        (case .node-ref-identifier
          (= plain false)
        )
        (case (call .node-stream-transform row)
          (= plain (== (. row right) 0))
        )
        (case .node-stream-panic
          (= plain false)
        )
        (case (call .node-stream-call row)
          (let rule (call rule-of node))
          (if (!= rule 0)
            (= plain (and (== (. row params count) 0) (== (. row args count) 0)))
            (if plain
              (let runs (and (== node pattern) (or (call plain-rule rule reads read-types) (call acting-rule rule reads read-types))))
              (let given (call gives-arguments reads read-types))
              (= plain (or runs given))
            )
          )
        )
      )
      (if (not plain)
        (if (not quiet)
          (call decline node)
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ plain-rule Bool
    (param rule SyntaxId)
    (param reads (list SlotId))
    (param read-types (list TypeId))
    ; Whether a local rule a pattern given to a rule calls captures no name, runs no action, calls
    ; no rule and reads no name but one the function made of the pattern can be given. Keeps
    ; those names only where it is.
    (let pattern (call (. tree local-rule-pattern) rule))
    (if (== pattern 0)
      (return false)
    )
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (if (is ([] (. tree nodes) node) .node-stream-call)
        (return false)
      )
    )
    (let held (. reads length))
    (if (and (call captures-none pattern true) (call plain-argument pattern reads read-types true))
      (return true)
    )
    (while (> (. reads length) held)
      (call (. reads pop))
      (call (. read-types pop))
    )
    (return false)
  )
  (fn-do _ acting-rule Bool
    (param rule SyntaxId)
    (param reads (list SlotId))
    (param read-types (list TypeId))
    (let row ([] (. instances rows) instance))
    (let pattern (call (. tree local-rule-pattern) rule))
    (if (or (== pattern 0) (!= (call rule-match program (. row module) (. row decl)) 0))
      (return false)
    )
    (let first (call (. tree subtree-start) rule))
    (let held (. reads length))
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (let plain true)
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (let own
            (scope (and (== (. resolution kind) .resolve-slot) from-first within-rule)
              (lazy from-first (>= (. ([] (. bindings slots) (. resolution slot)) syntax) first))
              (lazy within-rule (<= (. ([] (. bindings slots) (. resolution slot)) syntax) rule))
            )
          )
          (= plain (or own (== (. resolution kind) .resolve-none) (== (. resolution kind) .resolve-global) (== (. resolution kind) .resolve-type) (call module-function resolution) (call reads-given node reads read-types)))
        )
        (case .node-ref-identifier
          (= plain false)
        )
        (case .node-function-syntax
          (= plain false)
        )
        (case .node-stream-panic
          (= plain false)
        )
        (case .node-stream-call
          (= plain false)
        )
      )
      (if (not plain)
        (while (> (. reads length) held)
          (call (. reads pop))
          (call (. read-types pop))
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ module-function Bool
    (param resolution Resolution)
    (if (!= (. resolution kind) .resolve-function)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. resolution module)) decls) (. resolution decl))
      (case (call .decl-function fn)
        (return (== (. fn owner) 0))
      )
    )
    (return false)
  )
  (fn-do _ reads-given Bool
    (param node SyntaxId)
    (param reads (list SlotId))
    (param read-types (list TypeId))
    ; Whether a name a pattern given to a rule reads is one the function made of the pattern can
    ; be given where the pattern is passed: an argument of the function being typed, which
    ; nothing tracks, narrowed or captured from a function around it. The reference finds no
    ; local there. Keeps each once, with its type.
    (let resolution (call (. bindings resolution-of) (. frame binding) node))
    (if (or (!= (. resolution kind) .resolve-slot) outer)
      (return false)
    )
    (let slot (. resolution slot))
    (let row ([] (. bindings slots) slot))
    (if (or (!= (. row kind) .slot-argument) tracked (call (. frame is-captured) slot))
      (return false)
    )
    (lazy tracked (!= (/and/ (. row flags) (. SlotFlag slot-tracked)) 0))
    (let type (call (. frame known) slot))
    (if (or (== type no-type) (== type invalid-type) (!= (call (. frame slot-type) slot) type))
      (return false)
    )
    (if (== (call (. reads find) slot) null)
      (+= reads slot)
      (+= read-types type)
    )
    (return true)
  )
  (fn-do _ gives-arguments Bool
    (param reads (list SlotId))
    (param read-types (list TypeId))
    ; Whether the function made of a pattern that calls a local rule can run the rule: in a rule a
    ; module declares, the function is given the arguments the rule was given, which it gives the
    ; function of the local rule, or reads where it runs the local rule itself. Keeps each once,
    ; with its type, and none where it cannot be given them all.
    (let row ([] (. instances rows) instance))
    (if (or outer (== (call rule-match program (. row module) (. row decl)) 0))
      (return false)
    )
    (for (in position (..< 1 (. ([] (. instances signatures) instance) args count)))
      (let slot (call argument-slot position))
      (if (or (== slot no-slot) tracked (call (. frame is-captured) slot))
        (return false)
      )
      (lazy tracked (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-tracked)) 0))
    )
    (for (in position (..< 1 (. ([] (. instances signatures) instance) args count)))
      (let slot (call argument-slot position))
      (if (== (call (. reads find) slot) null)
        (+= reads slot)
        (+= read-types (call (. instances argument-type) instance position))
      )
    )
    (return true)
  )
  (fn-do _ pattern-result TypeId
    (param type TypeId)
    ; What a pattern given to a rule gives, where a value is a `PatternFunc` of the stream's
    ; items; none otherwise.
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (if (and pattern-func (== (. row args count) 2) (== (call class-arg types type 0) (. stream-view item)))
          (return (call class-arg types type 1))
        )
        (lazy pattern-func (call (. types pattern-func-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return no-type)
  )
  (fn-expr + names-given-pattern Bool
    (param slot SlotId)
    ; Whether a name is a pattern a rule a module declares is given, which the reference reads
    ; only as `$name` and `\name` call it, and reports as no name anywhere else: in an action, as
    ; an action it cannot compile.
    (and (== (. ([] (. bindings slots) slot) kind) .slot-argument) (!= (call rule-match program (. row module) (. row decl)) 0))
    (where
      (lazy row ([] (. instances rows) instance))
    )
  )
  (fn-do _ plan-pattern-call TypeId
    (param id SyntaxId)
    (param called TypeId)
    ; Plans a part of a grammar as a call of a pattern given to the rule, which gives what
    ; the pattern gives, and whose function answers the optional of it. What the function runs is
    ; not known, so the rule may panic. In a rule typed for a helper that can roll back, the
    ; function gives the rollback mark it holds, which the rule's pattern then holds.
    (call (. facts set-node-type) instance id called)
    (call (. facts set-plan) instance id .plan-pattern-call)
    (call (. facts set-answer-type) instance id (call (. types optional-of) called))
    (call (. instances mark-may-panic) instance)
    (if (!= (. ([] (. instances rows) instance) helper) no-type)
      (call note-mark)
    )
    (return called)
  )
  (fn-do _ equality-type TypeId
    (param id SyntaxId)
    (param value SyntaxId)
    ; What `$value` matches as a pattern runs. A pattern given to the rule the part is in, a
    ; `PatternFunc` of the stream's items, is called as a rule is, and gives what it gives. Text
    ; over a stream of characters gives the text it matched: the value is evaluated where the
    ; part is tried, with the names captured before it in reach; its length is read checked, by
    ; its `validated-length`, and its characters in turn by its `next-iterator`, as the reference
    ; reads them, or where the buffer is `encoded`, its count of bytes by its `size`, which are
    ; compared with the buffer's. A value of a type like the items', as the reference compares
    ; them, is compared
    ; with one item, and gives the value. A case of a union of the items named by its symbol alone,
    ; as `.press`, tests one item for the case, by its number, and gives what the case holds, or the
    ; item where it holds nothing. A value of any other type has no shape here.
    (let known (call (. facts node-type) instance id))
    (if (!= known no-type)
      (return known)
    )
    (let named (call (. tree symbol-of) value))
    (if (and named (== (call (. types intrinsic-of) (. stream-view item)) .union))
      (call note-case id (. stream-view item) named)
      (if (== (call (. facts plan-of) instance id) .plan-case)
        (let held (call case-payload (. stream-view item) named))
        (let given (if-expr (or (== held no-type) (== held invalid-type)) (. stream-view item) held))
        (call (. facts set-node-type) instance id given)
        (return given)
      )
    )
    (let type
      (call infer
        (block
          (arg value)
          (arg (if-expr (is ([] (. tree nodes) value) .node-identifier) (call (. (call Want) adding) .want-pattern) (call Want)))
        )
      )
    )
    (if (or (== type invalid-type) (== type no-type))
      (return invalid-type)
    )
    (let called (call pattern-result type))
    (if (!= called no-type)
      (return (call plan-pattern-call id called))
    )
    (if (!= type (. types string-type))
      (let relation (call (. relations compare) type (. stream-view item) false false null module))
      (if (or (== (. stream-view item) no-type) (not (call validate-relation relation .similar)))
        (call decline id)
        (return invalid-type)
      )
      (call (. facts set-node-type) instance id type)
      (return type)
    )
    (if (not (call text-items))
      (call decline id)
      (return invalid-type)
    )
    (if (!= (call (. calls protocol-getter) (. types string-type) (call (. program store-atom) "validated-length") id .role-length) (. types size-type))
      (call decline id)
      (return invalid-type)
    )
    (if (call encoded)
      (if (!= (call (. calls protocol-getter) (. types string-type) (call (. program store-atom) "size") id .role-size) (. types size-type))
        (call decline id)
        (return invalid-type)
      )
      (else-if (== (. (call (. calls protocol-call) (. types string-type) (call (. program store-atom) "next-iterator") id (. types size-type) (:role (. CallRole role-step))) answer) invalid-type)
        (call decline id)
        (return invalid-type)
      )
    )
    (call (. facts set-node-type) instance id (. types string-type))
    (return (. types string-type))
  )
  (fn-do _ predicate-type TypeId
    (param id SyntaxId)
    (param predicate SyntaxId)
    ; A test of one item of a stream, which gives the item where it passes, a character in a stream
    ; of them: its expression sees the item as `it`, and is tested as a condition.
    (let known (call (. facts node-type) instance id))
    (if (!= known no-type)
      (return known)
    )
    (let slot (call arm-slot id .slot-it))
    (if (!= slot no-slot)
      (call (. frame assign) slot (. stream-view item))
    )
    (let tested (call infer predicate))
    (if (or (== tested invalid-type) (== tested no-type))
      (return invalid-type)
    )
    (call note-truthiness predicate predicate tested)
    (call (. facts set-node-type) instance id (. stream-view item))
    (return (. stream-view item))
  )
  (fn-do _ repeated-values TypeId
    (param id SyntaxId)
    (param operand SyntaxId)
    (param item TypeId)
    ; A repeat of a part that gives a value: an `ImmutableArray` of what each pass gave, whose
    ; collector's growing call is recorded at the repeat, once. A part whose value is text gives
    ; the text a rule it ends with gave. A repeat whose value is not read, as a part of a sequence
    ; before its last is not, gives none and keeps no collector, as the reference makes none.
    (let known (call (. facts node-type) instance id))
    (if (!= known no-type)
      (return known)
    )
    (if (. valuing unvalued)
      (return no-type)
    )
    (let valued
      (block
        (case? (and (== item (. types string-type)) (call text-items))
          (call ends-with-rule operand)
        )
        (default
          (or (call stream-valued operand) (call takes-item operand))
        )
      )
    )
    (let collector (if-expr valued (call collector-over item) invalid-type))
    (if (or (== collector invalid-type) (!= (. (call (. calls protocol-call) collector (call (. program store-atom) "grow") id (:role (. CallRole role-grow))) answer) (call grown-items collector)))
      (call decline id)
      (return invalid-type)
    )
    (if (call takes-item operand)
      (call (. facts set-node-type) instance operand item)
    )
    (let list (call class-over (. types immutable-array-decl) item))
    (call (. facts set-node-type) instance id list)
    (call (. facts set-plan) instance id .plan-stream-value)
    (return list)
  )
  (fn-expr _ returns-span Bool
    (param owner InstanceId)
    (param id SyntaxId)
    ; Whether a part of a grammar of an instance gives the text it matched, as
    ; `spans-in` says.
    (call spans-in (. ([] (. instances rows) owner) module) (. ([] (. instances rows) owner) binding) owner id)
  )
  (fn-do _ spans-in Bool
    (param module ModuleId)
    (param binding BindingId)
    (param owner InstanceId)
    (param id SyntaxId)
    ; Whether a part of a grammar a function of a module writes gives the text it matched,
    ; as the reference reckons it where it repeats or counts the part: a part that matches items,
    ; a count, an arm that runs nothing, and a name captured over, a repeat or lookahead of, or a
    ; sequence or alternatives of such parts. A call of a rule gives its text where the rule's
    ; pattern does, and a rule met again while it is asked of does. The instance that runs the
    ; pattern, where there is one, says what a test of a value matches, and a call of a pattern
    ; given to the rule does not give its text; where none, one does not give its text.
    (let source (. ([] (. program modules) module) tree))
    (let key (/or/ (/lshift/ (as binding U64) 32) (as id U64)))
    (for (in held spanning)
      (if (== held key)
        (return true)
      )
    )
    (+= spanning key)
    (let spans false)
    (match? ([] (. source nodes) id)
      (case (call .node-stream-transform arm)
        (= spans (and (== (. arm right) 0) (!= (. arm pattern) 0) (call spans-in module binding owner (. arm pattern))))
      )
      (case (call .node-stream-capture capture)
        (= spans (call spans-in module binding owner (. capture pattern)))
      )
      (case (call .node-stream-and pair)
        (= spans (and (call spans-in module binding owner (. pair left)) (call spans-in module binding owner (. pair right))))
      )
      (case (call .node-stream-or pair)
        (= spans (and (call spans-in module binding owner (. pair left)) (call spans-in module binding owner (. pair right))))
      )
      (case (call .node-stream-unary unary)
        (= spans (call spans-in module binding owner (. unary operand)))
      )
      (case .node-stream-call
        (= spans (call called-spans module binding owner id))
      )
      (case .node-stream-string
        (= spans true)
      )
      (case .node-stream-char-range
        (= spans true)
      )
      (case .node-stream-any
        (= spans true)
      )
      (case .node-stream-length
        (= spans true)
      )
      (case .node-stream-predicate
        (= spans true)
      )
      (case (call .node-stream-equality test)
        (= spans (and (!= owner no-instance) (not (call calls-given-pattern owner binding id (. test value)))))
      )
    )
    (call (. spanning pop))
    (return spans)
  )
  (fn-expr _ calls-given-pattern Bool
    (param owner InstanceId)
    (param binding BindingId)
    (param id SyntaxId)
    (param value SyntaxId)
    ; Whether `$value` calls a pattern given to the rule rather than testing a value: as the type
    ; pass planned it, or, before it typed the part in the instance being typed, where the value
    ; is a name that holds a `PatternFunc` of the stream's items there.
    (case? (== (call (. facts plan-of) owner id) .plan-pattern-call)
      true
    )
    (case? (or (!= owner instance) (!= binding (. frame binding)) (not (is ([] (. tree nodes) value) .node-identifier)))
      false
    )
    (case? (!= (. resolution kind) .resolve-slot)
      false
    )
    (default
      (and (!= type no-type) (!= (call pattern-result type) no-type))
    )
    (where
      (lazy resolution (call (. bindings resolution-of) binding value))
      (lazy type (call (. frame slot-type) (. resolution slot)))
    )
  )
  (fn-do _ called-spans Bool
    (param module ModuleId)
    (param binding BindingId)
    (param owner InstanceId)
    (param call SyntaxId)
    ; Whether a rule a pattern calls gives the text it matched: a local rule of the function, or
    ; the rule of the function its call was resolved to, or where the instance has not resolved
    ; it, the rule a module declares that the name binds. A call given collectors gives it.
    (let source (. ([] (. program modules) module) tree))
    (match? ([] (. source nodes) call)
      (case (call .node-stream-call written)
        (if (!= (. written collector-mappings count) 0)
          (return true)
        )
      )
    )
    (if (== binding no-binding)
      (return false)
    )
    (let resolution (call (. bindings resolution-of) binding call))
    (if (== (. resolution kind) .resolve-slot)
      (let slot ([] (. bindings slots) (. resolution slot)))
      (if (and (== (. slot kind) .slot-lazy) (!= (. slot group) 0))
        (match? ([] (. source nodes) (. slot group))
          (case (call .node-declare declaration)
            (match? ([] (. source nodes) (. declaration right))
              (case (call .node-stream-match rule)
                (return (call spans-in module binding owner (. rule pattern)))
              )
            )
          )
        )
      )
      (return false)
    )
    (let fact (if-expr (!= owner no-instance) (call (. facts first-call) owner call) no-fact))
    (if (and (!= fact no-fact) (!= (. ([] (. facts calls) fact) callee) no-instance))
      (let callee (. ([] (. facts calls) fact) callee))
      (let called ([] (. instances rows) callee))
      (let matched (call rule-match program (. called module) (. called decl)))
      (match? ([] (. ([] (. program modules) (. called module)) tree nodes) matched)
        (case (call .node-stream-match rule)
          (return
            (call spans-in
              (block
                (arg (. called module))
                (arg (call (. session binder bind) (. called module) (. called decl)))
                (arg callee)
                (arg (. rule pattern))
              )
            )
          )
        )
      )
      (return false)
    )
    (if (!= (. resolution kind) .resolve-function)
      (return false)
    )
    (let matched (call rule-match program (. resolution module) (. resolution decl)))
    (match? ([] (. ([] (. program modules) (. resolution module)) tree nodes) matched)
      (case (call .node-stream-match rule)
        (return
          (call spans-in
            (block
              (arg (. resolution module))
              (arg (call (. session binder bind) (. resolution module) (. resolution decl)))
              (arg no-instance)
              (arg (. rule pattern))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ stream-valued Bool
    (param id SyntaxId)
    ; Whether a part of a grammar gives what a rule it calls gives rather than the text it
    ; matched, as the reference's parts give their values: a call of a rule, a name captured over
    ; one, an optional one, a repeat of one that gives no text or that ends with one, and a
    ; sequence whose last part gives one that is no text, a test of an item, a type named, a call
    ; of a pattern given to the rule, a test of a value like the items', and a count of a part
    ; that gives a value, as a repeat of one does over characters; and alternatives
    ; `stream-node-type` planned to give the value of the one that passed. A call given collectors
    ; gives the text it matched, as does one that `span-call` says gives it.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (return (and (== (. row collector-mappings count) 0) (or (not (call span-call id)) (call spans-valued id))))
      )
      (case .node-stream-or
        (return (== (call (. facts plan-of) instance id) .plan-stream-value))
      )
      (case (call .node-stream-capture row)
        (return (call stream-valued (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call stream-valued (. row pattern))))
      )
      (case (call .node-stream-unary row)
        (if (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op))
          (if (not (call text-items))
            (return (call stream-valued (. row operand)))
          )
          (return
            (scope (and repeat-unspanned (or (call stream-valued (. row operand)) (call ends-with-rule (. row operand))))
              (lazy repeat-unspanned (not (call returns-span instance (. row operand))))
            )
          )
        )
        (return (and (== (. row op) .zero-or-one-op) (call stream-valued (. row operand))))
      )
      (case (call .node-stream-and row)
        (return (and (call stream-valued (. row right)) (or (!= (call stream-node-type (. row right)) (. types string-type)) (not (call text-items)))))
      )
      (case .node-stream-predicate
        (return true)
      )
      (case .node-stream-type
        (return true)
      )
      (case .node-stream-equality
        (return (or (== (call (. facts plan-of) instance id) .plan-pattern-call) (call tests-item id)))
      )
      (case (call .node-stream-length row)
        (if (not (call text-items))
          (return (or (call stream-valued (. row operand)) (call takes-item (. row operand))))
        )
        (return
          (scope (and counted-unspanned (or (call stream-valued (. row operand)) (call ends-with-rule (. row operand))))
            (lazy counted-unspanned (not (call returns-span instance (. row operand))))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ takes-item Bool
    (param id SyntaxId)
    ; Whether a part of a grammar is a `.` over items that are not characters, which gives
    ; the item it matched where a name captures it or a count takes it, as a name captured over a
    ; test of the item holds it.
    (and (not (call text-items)) (is ([] (. tree nodes) id) .node-stream-any))
  )
  (fn-do _ sequence-tests-item Bool
    (param id SyntaxId)
    ; Whether a part of a grammar is a sequence whose value is that of a part that tests
    ; an item against a value, as `tests-item` says.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-and row)
        (return (call ends-testing-item (. row right)))
      )
      (case (call .node-stream-capture row)
        (return (call sequence-tests-item (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call sequence-tests-item (. row pattern))))
      )
    )
    (return false)
  )
  (fn-do _ ends-testing-item Bool
    (param id SyntaxId)
    ; Whether a part of a grammar ends with a part that tests an item against a value.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-and row)
        (return (call ends-testing-item (. row right)))
      )
      (case (call .node-stream-capture row)
        (return (call ends-testing-item (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call ends-testing-item (. row pattern))))
      )
    )
    (return (call tests-item id))
  )
  (fn-do _ tests-item Bool
    (param id SyntaxId)
    ; Whether a part of a grammar tests one item against a value of a type like the
    ; items' that `equality-type` typed, or for a case of a union, or is alternatives that each do.
    (match? ([] (. tree nodes) id)
      (case .node-stream-equality
        (let type (call (. facts node-type) instance id))
        (if (== (call (. facts plan-of) instance id) .plan-case)
          (return true)
        )
        (return
          (scope (and unpatterned (!= type no-type) (!= type invalid-type) (!= type (. types string-type)))
            (lazy unpatterned (!= (call (. facts plan-of) instance id) .plan-pattern-call))
          )
        )
      )
      (case (call .node-stream-or row)
        (return (and (call tests-item (. row left)) (call tests-item (. row right))))
      )
    )
    (return false)
  )
  (fn-do _ ends-with-rule Bool
    (param id SyntaxId)
    ; Whether a part of a grammar ends with a call of a rule, whose value is what the part
    ; gives on each pass of a repeat around it: a call, a type named, or a sequence that ends with
    ; one or with a name captured over one. A call given collectors gives no value of its own,
    ; nor does one that `span-call` says gives its text.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (return (and (== (. row collector-mappings count) 0) (or (not (call span-call id)) (call spans-valued id))))
      )
      (case (call .node-stream-capture row)
        (return (call ends-with-rule (. row pattern)))
      )
      (case .node-stream-type
        (return true)
      )
      (case .node-stream-equality
        (return (== (call (. facts plan-of) instance id) .plan-pattern-call))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call ends-with-rule (. row pattern))))
      )
      (case (call .node-stream-and row)
        (return (call ends-with-rule (. row right)))
      )
    )
    (return false)
  )
  (fn-expr _ span-call Bool
    (param id SyntaxId)
    ; Whether a call of a rule under a helper gives the text it matched rather than what the rule
    ; gives, as the reference calls a rule whose pattern gives its text for the span it matched,
    ; which the pattern calling it makes through the helper only where it needs it; so does such
    ; a call in a rule called so. Over items that are not characters, such a call has no shape. A
    ; call written alone as a pattern given to a rule passes the rule's function, which makes its
    ; text itself. A call of a local rule whose value its arm gives runs the rule for its value
    ; where the rule states a type other than text that no capture materializer of the helper
    ; makes, as the reference compiles such a call for the type the rule states.
    (or (and helped (!= id (. rule-arming casting)) (call returns-span instance id) (not (call rule-valued id))) span-planned)
    (where
      (lazy helped (or (!= (. helping helper) null) (. helping span-typing)))
      (lazy span-planned (== (call (. facts plan-of) instance id) .plan-span-call))
    )
  )
  (fn-do _ rule-valued Bool
    (param id SyntaxId)
    (if (or (== (. helping helper) null) (. helping span-typing))
      (return false)
    )
    (let rule (call rule-of id))
    (if (== rule 0)
      (return false)
    )
    (let stated (call local-rule-declared rule))
    (if (or unstated (== (call peeled-optional stated) (. types string-type)) (not (call value-position id)))
      (return false)
    )
    (lazy unstated (or (== stated no-type) (== stated invalid-type)))
    (for (in candidate (call source-candidates stated))
      (if (call takes-input candidate (. stream-view item))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ bare-span Bool
    (param id SyntaxId)
    (param rule SyntaxId)
    (case? (or (!= (. helping helper) null) (. helping span-typing) (== id (. rule-arming casting)) (call (. facts is-recursive-rule) instance rule))
      false
    )
    (case? (or (and (!= stated no-type) (!= stated (. types string-type))) (not (call returns-span instance id)))
      false
    )
    (default
      (call bare-arm id)
    )
    (where
      (lazy stated (call local-rule-declared rule))
    )
  )
  (fn-expr _ module-span Bool
    (param id SyntaxId)
    ; Whether a call of a rule a module declares that gives text, with no helper in force, gives
    ; the text it matched rather than what the rule makes, as the reference calls such a rule for
    ; its span where the value it makes is not wanted: one whose value nothing reads, and one
    ; captured alone in an arm whose action does not read `it`.
    (case? (or (!= (. helping helper) null) (. helping span-typing) (== id (. rule-arming casting)) (not (call returns-span instance id)))
      false
    )
    (default
      (or (. valuing unvalued) (call bare-arm id))
    )
  )
  (fn-do _ bare-arm Bool
    (param id SyntaxId)
    ; Whether a call is the pattern of an arm whose action does not read `it`, or a name captured
    ; over it alone, or over it as an optional part, in the sequence of such an arm.
    (let arms (list SyntaxId))
    (call stream-arms (. rule-arming capture-root) arms)
    (for (in arm arms)
      (if (and (<= (call (. tree subtree-start) arm) id) (<= id arm))
        (match? ([] (. tree nodes) arm)
          (case (call .node-stream-transform row)
            (return
              (scope (and (!= (. row pattern) 0) (not (call (. tree lazies-only) (. row right))) it-unread own-part)
                (lazy it-unread (not (call (. tree mentions) (. row right) "it")))
                (lazy own-part (or (== (. row pattern) id) (call bare-part (. row pattern) id)))
              )
            )
          )
        )
        (return false)
      )
    )
    (return false)
  )
  (fn-do _ bare-part Bool
    (param node SyntaxId)
    (param id SyntaxId)
    (match? ([] (. tree nodes) node)
      (case (call .node-stream-capture row)
        (return (and (or (== (. row pattern) id) (== (call (. tree optional-operand) (. row pattern)) id)) (not (. row accumulating))))
      )
      (case (call .node-stream-and row)
        (return (or (call bare-part (. row left) id) (call bare-part (. row right) id)))
      )
    )
    (return false)
  )
  (fn-do _ stream-call-type TypeId
    (param id SyntaxId)
    ; A call of a rule: the type of what the rule gives. A local rule given no arguments is typed
    ; where it is first called. A rule a module declares is called as its function is, and a
    ; pattern a name holds as `$name` calls it; a local rule given arguments or types is an
    ; error. A rule given collectors is typed as `mapped-call-type` says, where it can take
    ; them, and is TypeScript's error where not; under a helper that makes text, one whose text is
    ; read has no shape here. Under a helper, a local rule the match runs where it is called and a
    ; rule a module declares have a shape here, and no other; one whose pattern gives its text is
    ; typed as `span-call-type` says. A local rule a function of its own
    ; runs has a shape only under its rule's own helper, the one the rule is typed for or given as
    ; an argument. A local rule whose body is code is typed as `coded-rule-type` says, given
    ; nothing. With no helper, a call of a
    ; rule that gives text gives the text it matched where `bare-span` or `module-span` says.
    (let known (call (. facts node-type) instance id))
    (if (!= known no-type)
      (return known)
    )
    (let result invalid-type)
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (let plain (and (== (. row params count) 0) (== (. row args count) 0)))
        (let rule (call rule-of id))
        (let coded (call coded-rule id))
        (if (!= coded 0)
          (if (or (not plain) (!= (. row collector-mappings count) 0))
            (call decline id)
            (else
              (= result (call coded-rule-type id coded))
            )
          )
          (else-if (and (!= (. helping helper) null) (== rule 0) (call holds-value id))
            (if (!= (. row collector-mappings count) 0)
              (call decline id)
              (else
                (= result (call held-pattern-type id (. row name) plain))
              )
            )
          )
          (else-if (and (!= (. row collector-mappings count) 0) (!= (. helping helper) null) (not (. helping span-typing)))
            (if (or (not plain) (and (not (. valuing unvalued)) (!= (. helping helper captures length) 0)))
              (call decline id)
              (else
                (= result (call mapped-call-type id rule (. row name) (. row collector-mappings)))
              )
            )
          )
          (else-if (call span-call id)
            (= result (call span-call-type id rule (. row name) (. row params) (. row args)))
          )
          (else-if (!= (. row collector-mappings count) 0)
            (if (or (not plain) (and (== rule 0) (call holds-value id)))
              (call decline id)
              (else
                (= result (call mapped-call-type id rule (. row name) (. row collector-mappings)))
              )
            )
          )
          (else-if (and (!= rule 0) (not plain))
            (call (. frame diagnose)
              (block
                (arg id)
                (arg .stated)
                (arg
                  (call (. program store-atom)
                    (block
                      (arg
                        (paragraph
                          "A local rule takes no arguments or types; declare it at module level to give it some"
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          (else-if (!= rule 0)
            (let recurs (and (not beside-rule) (!= (call (. rules find) rule) null)))
            (if (and (not beside-rule) (!= (. rules length) 0))
              (call (. facts note-rule-call) instance ([] rules (- (. rules length) 1)) rule)
            )
            (= result (call rule-type rule))
            (if (and recurs (!= result invalid-type) (not (call record-recursion id rule result)))
              (= result invalid-type)
            )
            (if (and (!= (. helping helper) null) (call (. facts is-recursive-rule) instance rule) (not own-helper))
              (call decline id)
              (= result invalid-type)
              (else-if (and (== result (. types string-type)) (== (call (. rules find) rule) null) (call bare-span id rule))
                (call (. facts set-plan) instance id .plan-span-call)
              )
            )
          )
          (else-if (call holds-value id)
            (= result (call held-pattern-type id (. row name) plain))
          )
          (else
            (= result (call module-rule-type id (. row name) (. row params) (. row args)))
            (if (and (== result (. types string-type)) plain (call module-span id))
              (call (. facts set-plan) instance id .plan-span-call)
            )
          )
        )
      )
    )
    (if (== result invalid-type)
      (return invalid-type)
    )
    (call (. facts set-node-type) instance id result)
    (return result)
  )
  (fn-expr _ spans-valued Bool
    (param id SyntaxId)
    ; Whether a call `span-call` says gives its text gives a value of another type, which its arm
    ; gives, made from that text.
    (and (!= known no-type) (!= known invalid-type) (!= known (. types string-type)) (call value-position id))
    (where
      (lazy known (call (. facts node-type) instance id))
    )
  )
  (fn-do _ span-call-type TypeId
    (param id SyntaxId)
    (param rule SyntaxId)
    (param name Atom)
    (param params (of RowRange SyntaxId))
    (param args (of RowRange SyntaxId))
    ; A call of a rule under a helper that gives the text it matched, as the reference compiles
    ; one: the rule is typed with no helper, a local rule as giving its text whatever type it
    ; states, and the call has the type the rule states. A call of one that states text, or none,
    ; gives the text, as a part matching characters does. Where the rule states another type, a
    ; call whose value its arm gives is made that type from its text, by `record-source-text`,
    ; or for an optional type what it holds, which the call then gives as the optional; any other
    ; gives none. Within a rule called so, every such call gives its text. A local rule given
    ; arguments or types, a pattern given as an argument, a rule a module declares that gives
    ; another type than text, and items that are not characters have no shape here. Under a helper
    ; that observes literal words, the rule is typed under the helper, which makes nothing for it,
    ; so a call within it still gives its text.
    (if (or (not (call text-items)) (and (!= rule 0) (or (!= (. params count) 0) (!= (. args count) 0))))
      (call decline id)
      (return invalid-type)
    )
    (for (in arg ([] (. tree children) args))
      (let given arg)
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument argument)
          (= given (. argument expr))
        )
      )
      (if (is ([] (. tree nodes) given) .node-stream-match)
        (call decline given)
        (return invalid-type)
      )
    )
    (let saved-helper helping)
    (if (and (!= (. helping helper) null) (!= (. helping helper observer) no-type))
      (= helping (= (. helping helper) (call spanning-helper (. helping helper))))
      (else
        (= helping (= (. helping helper) null))
        (= helping (= (. helping site) 0))
      )
    )
    (= helping (= (. helping span-typing) true))
    (let called (if-expr (!= rule 0) (call rule-type rule) (call module-rule-type id name params args)))
    (let carried-rolls (. helping rolls))
    (= helping saved-helper)
    (= helping (= (. helping rolls) carried-rolls))
    (if (== called invalid-type)
      (return invalid-type)
    )
    (if (!= called (. types string-type))
      (call decline id)
      (return invalid-type)
    )
    (call (. facts set-plan) instance id .plan-span-call)
    (let stated
      (scope (if-expr helped-rule (call local-rule-declared rule) no-type)
        (lazy helped-rule (and (!= rule 0) (!= (. helping helper) null) (not (. helping span-typing))))
      )
    )
    (if (== stated invalid-type)
      (call decline id)
      (return invalid-type)
    )
    (if (or (== stated no-type) (== stated (. types string-type)))
      (return (. types string-type))
    )
    (if (not (call value-position id))
      (return stated)
    )
    (let made (call record-source-text id stated))
    (if (or (== made invalid-type) (== made stated))
      (return made)
    )
    (if (and (call (. types is-optional) stated) (== (call (. types optional-inner) stated) made))
      (return stated)
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ local-rule-declared TypeId
    (param rule SyntaxId)
    ; The type a local rule's declaration states, or none.
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (match? ([] (. tree nodes) (. declaration left))
          (case (call .node-type-capture row)
            (if (!= (. row type) 0)
              (return (call (. types evaluate-type) module tree (. row type) (. frame env)))
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ value-position Bool
    (param id SyntaxId)
    ; Whether the value of a part of the grammar being typed is what its arm gives, as the
    ; reference requires it of the part: the arm's pattern, the last part of a sequence that is,
    ; and the pattern of an action that reads it as `it`.
    (let arms (list SyntaxId))
    (call stream-arms (. rule-arming capture-root) arms)
    (for (in arm arms)
      (if (and (<= (call (. tree subtree-start) arm) id) (<= id arm))
        (return (call value-site arm id))
      )
    )
    (return false)
  )
  (fn-do _ value-site Bool
    (param node SyntaxId)
    (param id SyntaxId)
    (if (== node id)
      (return true)
    )
    (match? ([] (. tree nodes) node)
      (case (call .node-stream-transform row)
        (if (or (== (. row pattern) 0) (and (not (call (. tree lazies-only) (. row right))) (not (call (. tree mentions) (. row right) "it"))))
          (return false)
        )
        (return (call value-site (. row pattern) id))
      )
      (case (call .node-stream-and row)
        (return (and (<= (call (. tree subtree-start) (. row right)) id) (<= id (. row right)) (call value-site (. row right) id)))
      )
    )
    (return false)
  )
  (fn-do _ mapped Bool
    (param mappings (of RowRange SyntaxId))
    (param name Atom)
    (param source AST)
    (param target SyntaxId)
    ; Whether the collectors a call maps are ones the rule it calls and the pattern calling it
    ; accumulate, as the reference checks them where it compiles the call: no name of the rule's
    ; is mapped twice and no name of the caller's receives twice, each name of the rule's is one
    ; its own pattern accumulates, and each of the caller's one the pattern calling it does. Each
    ; name of the rule's is the caller's where none is written. TypeScript's error where not.
    (let callees (list String))
    (let callers (list String))
    (let sites (list SyntaxId))
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping row)
          (let callee (if-expr (. row callee) (. row callee text) (. row caller text)))
          (if (!= (call (. callees find) callee) null)
            (call (. frame diagnose)
              (block
                (arg mapping)
                (arg .stated)
                (arg
                  (call (. program store-atom)
                    (block
                      (arg (str "Accumulating capture " callee " cannot be mapped more than once"))
                    )
                  )
                )
              )
            )
            (return false)
          )
          (if (!= (call (. callers find) (. row caller text)) null)
            (call (. frame diagnose)
              (block
                (arg mapping)
                (arg .stated)
                (arg
                  (call (. program store-atom)
                    (block
                      (arg (str "Collector " (. row caller text) " cannot receive multiple mapped accumulators"))
                    )
                  )
                )
              )
            )
            (return false)
          )
          (+= callees callee)
          (+= callers (. row caller text))
          (+= sites mapping)
        )
      )
    )
    (for (in position (..< 0 (. sites length)))
      (if (not (call accumulates-in source target ([] callees position)))
        (call (. frame diagnose)
          (block
            (arg ([] sites position))
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg (str "Pattern " (. name text) " has no accumulating capture " ([] callees position)))
                )
              )
            )
          )
        )
        (return false)
      )
    )
    (for (in position (..< 0 (. sites length)))
      (if (not (call accumulates-in tree (. rule-arming capture-root) ([] callers position)))
        (call (. frame diagnose)
          (block
            (arg ([] sites position))
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg
                    (paragraph
                      (str "Collector mapping target " ([] callers position) " is not an active accumulating capture")
                    )
                  )
                )
              )
            )
          )
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ mapped-call-type TypeId
    (param id SyntaxId)
    (param rule SyntaxId)
    (param name Atom)
    (param mappings (of RowRange SyntaxId))
    ; A call of a rule given collectors, as the reference compiles one: the rule, a local one or
    ; one a module declares, is typed as where it is called plainly, and each name of the rule's
    ; that a collector is given for adds to the list the caller's name keeps, which for a local
    ; rule must be a list of what the rule's name accumulates; the emitter checks one a module
    ; declares. The call gives the text it matched, as the reference's call gives no value of its
    ; own. One over items that are not characters, or given a name of the caller's not yet typed,
    ; has no shape here.
    (if (not (call text-items))
      (call decline id)
      (return invalid-type)
    )
    (if (!= rule 0)
      (let pattern (call (. tree local-rule-pattern) rule))
      (if (not (call mapped mappings name tree pattern))
        (return invalid-type)
      )
      (if (== (call rule-type rule) invalid-type)
        (return invalid-type)
      )
      (for (in mapping ([] (. tree children) mappings))
        (match? ([] (. tree nodes) mapping)
          (case (call .node-stream-collector-mapping row)
            (let callee (if-expr (. row callee) (. row callee text) (. row caller text)))
            (let given (call accumulated-type pattern callee))
            (if (or (== given no-type) (!= given (call accumulator-type (. row caller text))))
              (call decline id)
              (return invalid-type)
            )
          )
        )
      )
      (return (. types string-type))
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (if (== (call module-rule-type id (. row name) (. row params) (. row args)) invalid-type)
          (return invalid-type)
        )
      )
    )
    (let fact (call (. facts first-call) instance id))
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (== callee no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let called ([] (. instances rows) callee))
    (let source (. ([] (. program modules) (. called module)) tree))
    (let pattern SyntaxId 0)
    (match? ([] (. source nodes) (call rule-match program (. called module) (. called decl)))
      (case (call .node-stream-match matched)
        (= pattern (. matched pattern))
      )
    )
    (if (== pattern 0)
      (call decline id)
      (return invalid-type)
    )
    (if (not (call mapped mappings name source pattern))
      (return invalid-type)
    )
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping row)
          (if (== (call accumulator-type (. row caller text)) no-type)
            (call decline id)
            (return invalid-type)
          )
        )
      )
    )
    (return (. types string-type))
  )
  (fn-do _ accumulator-type TypeId
    (param name String)
    ; The list the pattern being typed keeps for a name it accumulates, where the name was typed.
    (for (in position (..< (. rule-arming capture-base) (. capture-sites length)))
      (if (and ([] capture-accumulating position) (== (call (. tree name-text) ([] capture-sites position)) name))
        (return (call (. facts node-type) instance ([] capture-sites position)))
      )
    )
    (return no-type)
  )
  (fn-do _ accumulated-type TypeId
    (param id SyntaxId)
    (param name String)
    ; The list a pattern keeps of what a name it accumulates in a part of its own adds, or none.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (if (and (. row accumulating) (== (call (. tree name-text) (. row name)) name))
          (return (call (. facts node-type) instance (. row name)))
        )
        (return (call accumulated-type (. row pattern) name))
      )
      (case (call .node-stream-and row)
        (let left (call accumulated-type (. row left) name))
        (return (if-expr (!= left no-type) left (call accumulated-type (. row right) name)))
      )
      (case (call .node-stream-or row)
        (let left (call accumulated-type (. row left) name))
        (return (if-expr (!= left no-type) left (call accumulated-type (. row right) name)))
      )
      (case (call .node-stream-transform row)
        (if (!= (. row pattern) 0)
          (return (call accumulated-type (. row pattern) name))
        )
      )
      (case (call .node-stream-panic row)
        (return (call accumulated-type (. row pattern) name))
      )
      (case (call .node-stream-unary row)
        (return (call accumulated-type (. row operand) name))
      )
      (case (call .node-stream-length row)
        (return (call accumulated-type (. row operand) name))
      )
    )
    (return no-type)
  )
  (fn-do _ accumulates-in Bool
    (param source AST)
    (param id SyntaxId)
    (param name String)
    ; Whether a pattern accumulates a name in a part of its own, not in a rule it calls.
    (match? ([] (. source nodes) id)
      (case (call .node-stream-capture row)
        (let named (call (. source identifier-name) (. row name)))
        (return
          (scope (or accumulates-own (call accumulates-in source (. row pattern) name))
            (lazy accumulates-own (and (. row accumulating) named (== (. named text) name)))
          )
        )
      )
      (case (call .node-stream-and row)
        (return (or (call accumulates-in source (. row left) name) (call accumulates-in source (. row right) name)))
      )
      (case (call .node-stream-or row)
        (return (or (call accumulates-in source (. row left) name) (call accumulates-in source (. row right) name)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call accumulates-in source (. row pattern) name)))
      )
      (case (call .node-stream-panic row)
        (return (call accumulates-in source (. row pattern) name))
      )
      (case (call .node-stream-unary row)
        (return (call accumulates-in source (. row operand) name))
      )
      (case (call .node-stream-length row)
        (return (call accumulates-in source (. row operand) name))
      )
    )
    (return false)
  )
  (fn-expr + holds-value Bool
    (param call SyntaxId)
    ; Whether a call of a rule names a local, an argument or the item of a loop, rather than a
    ; local rule or a rule a module declares.
    (case? (!= (. resolution kind) .resolve-slot)
      false
    )
    (default
      (or (== kind .slot-local) (== kind .slot-argument) (== kind .slot-loop-item))
    )
    (where
      (lazy resolution (call (. bindings resolution-of) (. frame binding) call))
      (lazy kind (. ([] (. bindings slots) (. resolution slot)) kind))
    )
  )
  (fn-do _ held-pattern-type TypeId
    (param call SyntaxId)
    (param name Atom)
    (param plain Bool)
    ; A call of a pattern given to the rule, `\name`, as `$name` calls one. One given arguments
    ; or types, or that names a value of any other type, has no shape here.
    (let type
      (block
        (case? plain
          (. (call infer-identifier call name (call (. (call Want) adding) .want-pattern)) type)
        )
        (default
          invalid-type
        )
      )
    )
    (let called (if-expr (!= type invalid-type) (call pattern-result type) no-type))
    (if (== called no-type)
      (call decline call)
      (return invalid-type)
    )
    (return (call plan-pattern-call call called))
  )
  (fn-do _ type-node-type TypeId
    (param id SyntaxId)
    (param written SyntaxId)
    ; A type named as a part of a grammar, as the reference types it: a call of the type's
    ; constructor that takes the stream, which gives what the constructor gives where it passes;
    ; for a number, a call of the rule `num` or `dec` given the type that reads one, where a rule
    ; of that name takes the stream; else a test of one item for the type, which gives the item.
    (let known (call (. facts node-type) instance id))
    (if (!= known no-type)
      (return known)
    )
    (let class (call (. types evaluate-type) module tree written (. frame env)))
    (if (or (== class invalid-type) (== class no-type))
      (if (not (call report-missing-type written (. frame env)))
        (call decline id)
      )
      (return invalid-type)
    )
    (let made (call stream-constructor-type id class))
    (if (== made no-type)
      (let kind (call (. types intrinsic-of) class))
      (let reader (call (. program store-atom) (if-expr (call intrinsic-is-float kind) "dec" "num")))
      (if (and (call intrinsic-is-numeric kind) (call reads-stream reader class))
        (let empty (call (of RowRange SyntaxId)))
        (= made (call module-rule-type id reader empty empty class))
        (else
          (= made (call item-test-type id written class))
        )
      )
    )
    (if (== made invalid-type)
      (return invalid-type)
    )
    (call (. facts set-node-type) instance id made)
    (return made)
  )
  (fn-do _ stream-constructor-type TypeId
    (param id SyntaxId)
    (param class TypeId)
    ; A call of the constructor of a type that takes the stream, as a `TokenStream` of its items,
    ; with the type of the items as its type parameter, as the reference dispatches it. It gives
    ; what the constructor gives where it passes, as the rule the constructor is: no type where
    ; the type has no such constructor. A constructor that is no rule, or that gives what it
    ; captured, has no shape here. A pattern whose buffer is `encoded` calls the constructor typed
    ; again for that buffer, as `encoded-callee` says.
    (let stream (call class-over (. types token-stream-decl) (. stream-view item)))
    (let params-start (. scratch types mark))
    (call (. scratch types push) (. stream-view item))
    (let shapes-start (. scratch call-arguments mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (let types-start (. scratch types mark))
    (call (. scratch types push) stream)
    (let syntax-start (. scratch syntax mark))
    (call (. scratch syntax push) id)
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg (call (. scratch types span) params-start 1))
        )
      )
    )
    (call (. types complete) class)
    (call (. calls ranking begin) (. arguments shapes) (. arguments types))
    (call (. calls ranking explicit-params) (. arguments params))
    (let hit (call (. calls ranking dispatch-constructor) class true))
    (call (. calls ranking release))
    (let made no-type)
    (if hit
      (if (and (!= (. stream-view type) stream) (== (call (. conversions convert) id id (. stream-view type) stream .reason-argument) invalid-type))
        (= made invalid-type)
        (else
          (= made (call (. calls construction-on) id class arguments true 0 false true))
        )
      )
    )
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (if (or (== made no-type) (== made invalid-type))
      (return made)
    )
    (let fact (call (. facts first-call) instance id))
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (or (== callee no-instance) (not (call (. types is-optional) made)) no-rule)
      (call decline id)
      (return invalid-type)
    )
    (lazy no-rule (== (call rule-match program (. ([] (. instances rows) callee) module) (. ([] (. instances rows) callee) decl)) 0))
    (let given (call (. types optional-inner) made))
    (if (call same-decl (call class-ref types given) (. types capture-result-decl))
      (call decline id)
      (return invalid-type)
    )
    (let chosen (if-expr (!= (. helping helper) null) (call helped-callee id callee false) (call plain-callee callee)))
    (if (== chosen no-instance)
      (return invalid-type)
    )
    (= (. ([] (. facts calls) fact) callee) chosen)
    (return given)
  )
  (fn-do _ reads-stream Bool
    (param name Atom)
    (param class TypeId)
    ; Whether the function of a name given the stream, with the type of its items and a type as its
    ; type parameters, is a rule, as the reference looks for the rule that reads a number of that
    ; type.
    (let params-start (. scratch types mark))
    (call (. scratch types push) (. stream-view item))
    (call (. scratch types push) class)
    (let shapes-start (. scratch call-arguments mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (let types-start (. scratch types mark))
    (call (. scratch types push) (. stream-view type))
    (let syntax-start (. scratch syntax mark))
    (call (. scratch syntax push) 0)
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg (call (. scratch types span) params-start 2))
        )
      )
    )
    (call (. calls ranking begin) (. arguments shapes) (. arguments types))
    (call (. calls ranking explicit-params) (. arguments params))
    (let hit (call (. calls ranking dispatch-function) no-type name))
    (call (. calls ranking release))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return (and (not (not hit)) (!= (call rule-match program (. hit module) (. hit decl)) 0)))
  )
  (fn-do _ item-test-type TypeId
    (param id SyntaxId)
    (param written SyntaxId)
    (param class TypeId)
    ; A test of one item for a type, as the reference tests it: the item's type must relate to the
    ; type, as it is reported where not, and the test passes where the item is of it. It gives the
    ; item as the type. An item of the type itself is tested here, and one of a class the type
    ; derives from or of a union that has the type as a case, which is tested as the type named as
    ; a pattern tests a value, by what `plan-type-pattern` records at the type written. An item that is a number of another type is
    ; never of it, as the reference compares the two types alone, so the test never passes.
    ; The reference first tells the stream the pattern stands at the item, as it does before it
    ; calls a function that reads the type, and finds none.
    (let relation (call (. relations compare) (. stream-view item) class false false null module))
    (if (not (call relation-legal relation))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Type has no stream constructor for this stream item type"))
        )
      )
      (return invalid-type)
    )
    (if (and (!= (. stream-view item) class) (call intrinsic-is-numeric (call (. types intrinsic-of) (. stream-view item))))
      (if (not (call record-commit id))
        (call decline id)
        (return invalid-type)
      )
      (return class)
    )
    (if (!= (. stream-view item) class)
      (if (and (not (call derives class (. stream-view item))) (!= (call (. types intrinsic-of) (. stream-view item)) .union))
        (call decline id)
        (return invalid-type)
      )
      (let planned (. facts conversions length))
      (call plan-type-pattern written (. stream-view item) class .similar)
      (if (== (. facts conversions length) planned)
        (call decline id)
        (return invalid-type)
      )
    )
    (if (not (call record-commit id))
      (call decline id)
      (return invalid-type)
    )
    (return class)
  )
  (fn-do _ derives Bool
    (param type TypeId)
    (param ancestor TypeId)
    ; Whether a class derives from another, however far.
    (if (or (!= (call (. types intrinsic-of) type) .class) (!= (call (. types intrinsic-of) ancestor) .class))
      (return false)
    )
    (let base (call (. types base-of) type))
    (while base
      (if (== base ancestor)
        (return true)
      )
      (= base (call (. types base-of) base))
    )
    (return false)
  )
  (fn-do _ module-rule-type TypeId
    (param id SyntaxId)
    (param name Atom)
    (param params (of RowRange SyntaxId))
    (param args (of RowRange SyntaxId))
    (param named TypeId (= no-type))
    ; A call of a rule a module declares, as the reference matches it: a call of the function of
    ; that name given the stream as its first argument, as a `TokenStream` of its items, before
    ; the arguments written, and the type of the stream's items as its first type parameter,
    ; before the types written. It gives what the rule gives where the rule passes. Where no
    ; function of the name takes them, the call is reported as the reference reports it, unless
    ; an argument has no type, as a pattern given as an argument has none here. A type `named`
    ; stands for the types written. A function that
    ; is no rule, a rule that belongs to a type, and one that calls itself without stating its
    ; type have no shape here, but where the call reads no type yet the rule reports that it
    ; cannot be typed, as the reference does. Under a helper, the rule runs as `helped-callee`
    ; says, and a function that is no rule has no shape. A rule given a pattern there runs typed
    ; for the helper, which it gives each pattern it calls: a pattern written as the argument,
    ; typed for the helper too; any other has no shape. The names of the pattern its arguments
    ; read are made before the call as `materialize-arguments` says. A rule typed again for the
    ; helper runs in place of the rule as it is, whose body this call then leaves untyped, as the
    ; reference compiles only the one the pattern calls. A pattern whose buffer is `encoded` calls the
    ; rule, or the function that is no rule, typed again for that buffer, as `encoded-callee` says,
    ; in place of the one as it is.
    (if (or slot-named (== (. stream-view item) no-type) (== (. stream-view type) no-type))
      (call decline id)
      (return invalid-type)
    )
    (lazy slot-named (== (. (call (. bindings resolution-of) (. frame binding) id) kind) .resolve-slot))
    (let stream (call class-over (. types token-stream-decl) (. stream-view item)))
    (if (and retyped (== (call (. conversions convert) id id (. stream-view type) stream .reason-argument) invalid-type))
      (call decline id)
      (return invalid-type)
    )
    (lazy retyped (!= (. stream-view type) stream))
    (let restores (list SlotId))
    (let restored (list TypeId))
    (if (and (!= (. helping helper) null) (not (call materialize-arguments id args restores restored)))
      (return invalid-type)
    )
    (let params-start (. scratch types mark))
    (call (. scratch types push) (. stream-view item))
    (let param-count 1)
    (if (!= named no-type)
      (call (. scratch types push) named)
      (+= param-count 1)
    )
    (for (in param ([] (. tree children) params))
      (call (. scratch types push) (call (. types evaluate-type) module tree param (. frame env)))
      (+= param-count 1)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false null))
    (call (. scratch types push) stream)
    (call (. scratch syntax push) id)
    (let typed true)
    (let patterned false)
    (for (in arg ([] (. tree children) args))
      (let given arg)
      (let label (? Atom) null)
      (let optional false)
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument argument)
          (= given (. argument expr))
          (= label (. argument name))
          (= optional (. argument is-optional))
        )
      )
      (let written (is ([] (. tree nodes) given) .node-stream-match))
      (let type
        (scope (if-expr written (call pattern-argument-type given) (call infer-argument given given-symbol))
          (lazy given-symbol (call (. tree argument-symbol) given))
        )
      )
      (call (. scratch call-arguments push) (call argument-shape label optional given))
      (if (and (!= (. helping helper) null) (call (. types is-pattern-func) type))
        (= patterned true)
        (if (not written)
          (call decline given)
          (= type invalid-type)
        )
      )
      (= typed (and typed (!= type invalid-type)))
      (call (. scratch types push) type)
      (call (. scratch syntax push) arg)
    )
    (let arguments
      (call arguments-since
        (block
          (arg shapes-start)
          (arg types-start)
          (arg syntax-start)
          (arg (call (. scratch types span) params-start param-count))
        )
      )
    )
    (let diagnosed (. facts diagnostics length))
    (let holds (or (!= (. helping helper) null) (call encoded)))
    (let mark (if-expr holds (call (. instances hold)) (. instances held mark)))
    (= deferring holds)
    (let result (if-expr typed (call (. calls function-call) id name arguments) invalid-type))
    (= deferring false)
    (let resolved (. instances held mark))
    (if (and (== result invalid-type) typed)
      (let known false)
      (let ruled false)
      (for (in candidate (call (. program lookup) module name))
        (= known true)
        (let owner ([] (. program modules) (. candidate module)))
        (match? ([] (. owner decls) (. candidate decl))
          (case (call .decl-function fn)
            (= ruled (or ruled (and (!= (. fn args count) 0) (== (?. (. ([] (. owner arg-pool) (. fn args start)) name) text) "(stream)"))))
          )
        )
      )
      (let missing (str "Rule \"" (. name text) "\" not found"))
      (let unruled (str "\"" (. name text) "\" is a function, not a rule; call it outside the pattern"))
      (let unmatched
        (paragraph
          (str "No rule \"" (. name text) "\" matches " (call type-short-name types (. stream-view item)) " items with these arguments")
        )
      )
      (let message
        (call (. program store-atom)
          (block
            (arg (if-expr (not known) missing (if-expr (not ruled) unruled unmatched)))
          )
        )
      )
      (call (. facts restate) diagnosed instance id .function-not-found .stated message)
    )
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) params-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (for (in position (..< 0 (. restores length)))
      (call (. frame assign) ([] restores position) ([] restored position))
    )
    (let answer invalid-type)
    (let dropped no-instance)
    (let fact
      (scope (if-expr (and (!= result invalid-type) (!= result no-type)) called-fact no-fact)
        (lazy called-fact (call (. facts first-call) instance id))
      )
    )
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (or (== result invalid-type) (== result no-type))
      (= answer invalid-type)
      (else-if (== callee no-instance)
        (call decline id)
      )
      (else-if (or (!= (. ([] (. instances rows) callee) self-type) no-type) (and in-progress undeclared))
        (call decline id)
      )
      (else-if (== (call rule-match program (. ([] (. instances rows) callee) module) (. ([] (. instances rows) callee) decl)) 0)
        (if (!= (. helping helper) null)
          (call decline id)
          (else
            (= answer (call boundary-type id callee result))
            (if (and (!= answer invalid-type) (call encoded))
              (= (. ([] (. facts calls) fact) callee) (call plain-callee callee))
              (= dropped callee)
            )
          )
        )
      )
      (else-if (not (call (. types is-optional) result))
        (call decline id)
      )
      (else
        (let chosen
          (scope (if-expr has-helper (call helped-callee id callee patterned) (call plain-callee callee))
            (lazy has-helper (!= (. helping helper) null))
          )
        )
        (if (!= chosen no-instance)
          (= (. ([] (. facts calls) fact) callee) chosen)
          (= answer (call (. types optional-inner) result))
          (if (!= chosen callee)
            (= dropped callee)
          )
        )
      )
    )
    (lazy in-progress (== (. ([] (. instances rows) callee) state) .instance-in-progress))
    (lazy undeclared (!= (. ([] (. instances signatures) callee) return-state) .return-declared))
    (if holds
      (call (. instances release) mark resolved dropped)
    )
    (return answer)
  )
  (fn-do _ materialize-arguments Bool
    (param id SyntaxId)
    (param args (of RowRange SyntaxId))
    (param restores (list SlotId))
    (param restored (list TypeId))
    ; Plans how the helper makes the names of the pattern that the arguments of a call of a rule
    ; read, as the reference makes them before the call where one selects a materializer: each
    ; wanted as what it holds, in the order the arguments first read them, made as
    ; `materialize-capture` says. A call that makes one makes its pattern one that makes a value
    ; through the helper. A pattern written as an argument reads none. A name read only for its
    ; length has no shape here. Keeps the slots it retypes, and their types before.
    (let seen (list SlotId))
    (let arm (call top-arm id))
    (= action-selects false)
    (let planned true)
    (for (in arg ([] (. tree children) args))
      (let given arg)
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument argument)
          (= given (. argument expr))
        )
      )
      (if (is ([] (. tree nodes) given) .node-stream-match)
        (continue)
      )
      (for (in node (..< (call (. tree subtree-start) given) (+ given 1)))
        (match? ([] (. tree nodes) node)
          (case .node-identifier
            (let slot (call capture-slot node))
            (let position (if-expr (!= slot no-slot) (call capture-position slot arm) (. U32 max)))
            (if (and planned (!= position (. U32 max)) (== (call (. seen find) slot) null))
              (+= seen slot)
              (if (call reads-length-only slot given)
                (call decline id)
                (= planned false)
                (else-if (not (call materialize-capture id given position (call (. facts node-type) instance ([] capture-sites position)) restores restored))
                  (= planned false)
                )
              )
            )
          )
        )
      )
    )
    (if action-selects
      (= pattern-arms (= (. pattern-arms selects) true))
    )
    (= action-selects false)
    (return planned)
  )
  (fn-do _ helped-callee InstanceId
    (param id SyntaxId)
    (param callee InstanceId)
    (param patterned Bool)
    ; The instance a call of a rule a module declares runs under the helper of the pattern calling
    ; it, as the reference compiles the call: the rule typed again for the helper where its own
    ; pattern makes a value through it or needs it to roll back, which the call then gives it, and
    ; the rule as it is elsewhere where not. The pattern calling such a rule uses the helper too,
    ; and needs it to roll back where the rule does. A call of the rule from its own pattern,
    ; typed for the helper, has no shape here. A rule given its own helper as an argument runs
    ; under that, and where it needs it to roll back, so does the pattern calling it; where that
    ; is not yet known and the helper in force cannot roll back, the call has no shape here. A
    ; rule given patterns typed for the helper is always typed for it, and one given its own
    ; helper has no shape then. A rule that holds a rollback mark gives it to the pattern calling
    ; it, which then holds one too; one given its own helper that holds one gives it so only
    ; where the pattern calling it keeps marks of the same type, and has no shape here elsewhere.
    ; Under a helper that observes literal words, a rule is typed for the helper first, and runs
    ; under it where its pattern does (`observes-literals`); a rule given its own helper runs under
    ; that only where not, and a call of the rule from its own pattern runs it under the helper.
    (let observed (!= (. (!! (. helping helper)) observer) no-type))
    (if (and (!= (call ambient-position types instances callee) (. U32 max)) (not observed))
      (return (call ambient-callee id callee patterned))
    )
    (let row ([] (. instances rows) callee))
    (let signature ([] (. instances signatures) callee))
    (let start (- (. signature args start) (. signature param-count)))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (+ (. signature param-count) (. signature args count))))
      (call (. scratch types push) ([] (. instances signature-types) (+ start offset)))
    )
    (let params (call (. scratch types span) mark (. signature param-count)))
    (let args (call (. scratch types span) (+ mark (. signature param-count)) (. signature args count)))
    (let none (call (of ImmutableArray U32 ArenaBacking)))
    (let helped
      (call (. instances intern)
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row self-type))
          (arg (. row effects))
          (arg (. row enclosing))
          (arg params)
          (arg args)
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg (. (!! (. helping helper)) participant))
          (arg none)
          (arg none)
          (arg (. U32 max))
          (arg (call ZoneEntry))
          (arg no-instance)
          (arg 0)
          (arg (. helping span-typing))
          (arg (call encoded))
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call demand-body helped)
    (let recursive (and observed (== (. ([] (. instances rows) helped) state) .instance-in-progress)))
    (if (and (!= (. ([] (. instances rows) helped) state) .instance-done) (not recursive))
      (call decline id)
      (return no-instance)
    )
    (if (and (not (. ([] (. instances rows) helped) uses-helper)) (not patterned) (not recursive))
      (if (!= (call ambient-position types instances callee) (. U32 max))
        (return (call ambient-callee id callee patterned))
      )
      (return (call plain-callee callee))
    )
    (if (. ([] (. instances rows) helped) rolls-helper)
      (= helping (= (. helping rolls) true))
    )
    (call note-helper-use (. ([] (. instances rows) helped) rolls-helper))
    (if (. ([] (. instances rows) helped) carries-mark)
      (call note-mark)
    )
    (return helped)
  )
  (fn-do _ plain-callee InstanceId
    (param callee InstanceId)
    ; The instance of a rule, or of a function given the stream that is no rule, a pattern calls
    ; under no helper: the one it resolved to, or where the pattern's buffer is `encoded`, the one
    ; `encoded-callee` gives.
    (return (if-expr (call encoded) (call encoded-callee callee) callee))
  )
  (fn-do _ encoded-callee InstanceId
    (param callee InstanceId)
    ; The instance of a rule, or of a function given the stream that is no rule, a pattern calls
    ; whose buffer holds the UTF-8 bytes of a String: the one typed again as `encoded`, whose own
    ; patterns on the stream read those bytes, under the helper and for the text it is typed for
    ; already.
    (let row ([] (. instances rows) callee))
    (let signature ([] (. instances signatures) callee))
    (let start (- (. signature args start) (. signature param-count)))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (+ (. signature param-count) (. signature args count))))
      (call (. scratch types push) ([] (. instances signature-types) (+ start offset)))
    )
    (let params (call (. scratch types span) mark (. signature param-count)))
    (let args (call (. scratch types span) (+ mark (. signature param-count)) (. signature args count)))
    (let none (call (of ImmutableArray U32 ArenaBacking)))
    (let made
      (call (. instances intern)
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg (. row self-type))
          (arg (. row effects))
          (arg (. row enclosing))
          (arg params)
          (arg args)
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg (. row helper))
          (arg none)
          (arg none)
          (arg (. U32 max))
          (arg (call ZoneEntry))
          (arg no-instance)
          (arg 0)
          (arg (. row spans))
          (arg true)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call demand-body made)
    (return made)
  )
  (fn-do _ ambient-callee InstanceId
    (param id SyntaxId)
    (param callee InstanceId)
    (param patterned Bool)
    ; The instance a call of a rule given its own helper as an argument runs under that helper, as
    ; `helped-callee` says, typed again as `plain-callee` says.
    (if patterned
      (call decline id)
      (return no-instance)
    )
    (let ruled (call plain-callee callee))
    (call demand-body ruled)
    (if (and (!= (. ([] (. instances rows) ruled) state) .instance-done) (== (. (!! (. helping helper)) rollback) no-type))
      (call decline id)
      (return no-instance)
    )
    (if (. ([] (. instances rows) ruled) carries-mark)
      (call note-mark)
      (let theirs
        (call (. facts rollback-body-of)
          (block
            (arg ruled)
            (arg (call rule-match program (. ([] (. instances rows) ruled) module) (. ([] (. instances rows) ruled) decl)))
          )
        )
      )
      (let ours (if-expr (!= (. helping body) 0) (call (. facts rollback-body-of) instance (. helping body)) (. U32 max)))
      (if (or (== theirs (. U32 max)) (== ours (. U32 max)) kept-differs)
        (call decline id)
        (return no-instance)
      )
      (lazy kept-differs (!= (. ([] (. facts rollback-bodies) theirs) kept) (. ([] (. facts rollback-bodies) ours) kept)))
    )
    (if (. ([] (. instances rows) ruled) rolls-helper)
      (= helping (= (. helping rolls) true))
      (call note-helper-use true)
    )
    (return ruled)
  )
  (fn-do _ boundary-type TypeId
    (param id SyntaxId)
    (param callee InstanceId)
    (param result TypeId)
    ; A call of a function given the stream that is no rule, as the reference calls it: the stream
    ; is told the pattern stands at the cursor before, and asked for its view after, which says
    ; where the function left it and how far it read. It gives what the function gives, which
    ; the call holds where the function answers an optional, and the result of a `CaptureResult`
    ; where it answers one. A function that raises errors has no shape here, and a rule declared
    ; over items whose body is not only `~` arms, which is called so, is an error that says so.
    (if (!= (. ([] (. instances signatures) callee) errors count) 0)
      (if (call declared-rule callee)
        (let named
          (match ([] (. tree nodes) id)
            (case (call .node-stream-call row)
              (. row name text)
            )
            (default
              "This rule"
            )
          )
        )
        (let advice
          (paragraph
            "give it a \"(~ …)\" arm before its \"(throw …)\" arm with any \"({} …)\" test in its pattern, or raise from a function an action calls"
          )
        )
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg
                    (paragraph
                      (str "\"" named "\" raises, and a rule a pattern calls may raise only where its body is \"(~ …)\" arms, the last of which may be \"(throw …)\"; " advice)
                    )
                  )
                )
              )
            )
          )
        )
        (else
          (call decline id)
        )
      )
      (return invalid-type)
    )
    (if (not (call record-commit id))
      (call decline id)
      (return invalid-type)
    )
    (let view (call (. calls protocol-getter) (. stream-view type) (call view-name (call encoded)) id .role-view))
    (if (not (call (. types is-optional) view))
      (call decline id)
      (return invalid-type)
    )
    (let given (if-expr (call (. types is-optional) result) (call (. types optional-inner) result) result))
    (return
      (scope (if-expr capturing (call class-arg types given 1) given)
        (lazy capturing (call same-decl (call class-ref types given) (. types capture-result-decl)))
      )
    )
  )
  (fn-do _ declared-rule Bool
    (param callee InstanceId)
    ; Whether a function is declared as a rule, over the items of a stream.
    (let owner ([] (. program modules) (. ([] (. instances rows) callee) module)))
    (match? ([] (. owner decls) (. ([] (. instances rows) callee) decl))
      (case (call .decl-function fn)
        (match? ([] (. owner tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (return (!= (. syntax pattern) 0))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ record-commit Bool
    (param id SyntaxId)
    ; Records at a part of a grammar the stream's `pattern-commit` of the cursor where the
    ; part begins, which the reference makes there before it calls a function that is no rule.
    (return (!= (. (call (. calls protocol-call) (. stream-view type) (call (. program store-atom) "pattern-commit") id (. types index-type) false (. types index-type) (:role (. CallRole role-commit))) answer) invalid-type))
  )
  (fn-do + rule-of SyntaxId
    (param call SyntaxId)
    ; The declaration of the local rule a call of a rule names, or none where it names another.
    (let resolution (call (. bindings resolution-of) (. frame binding) call))
    (if (!= (. resolution kind) .resolve-slot)
      (return 0)
    )
    (let row ([] (. bindings slots) (. resolution slot)))
    (if (or (!= (. row kind) .slot-lazy) (== (. row group) 0))
      (return 0)
    )
    (match? ([] (. tree nodes) (. row group))
      (case (call .node-declare declaration)
        (if (is ([] (. tree nodes) (. declaration right)) .node-stream-match)
          (return (. row group))
        )
      )
    )
    (return 0)
  )
  (fn-do _ record-recursion Bool
    (param id SyntaxId)
    (param rule SyntaxId)
    (param result TypeId)
    ; Records what the reference does at a call of a local rule beside a match made from the
    ; rule's own arms. It calls a function it makes of the rule as it calls a function given the
    ; stream: the stream is told the pattern stands at the cursor before, and asked for its view
    ; after. That function runs the rule on the stream's view and commits where it ended, by the
    ; calls a match on the stream records, which are kept at the rule's pattern; the stream, its
    ; buffer, and the optional `CaptureResult` the function answers are kept with the rule. A
    ; rule another rule calls back, one called under a helper, and one called on another stream
    ; than it was first, have no shape here.
    (let matched SyntaxId 0)
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (= matched (. declaration right))
      )
    )
    (let pattern (call (. tree local-rule-pattern) rule))
    (if (or (== pattern 0) (== (. rules length) 0) (!= ([] rules (- (. rules length) 1)) rule) (!= (. helping helper) null))
      (if (and (!= pattern 0) (!= (call (. rules find) rule) null) (== (. helping helper) null))
        (let text
          (paragraph
            "The local rules of a match cannot call one another in a cycle; declare them below a rule the module declares, whose local rules can"
          )
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) text))
        (else
          (call decline id)
        )
      )
      (return false)
    )
    (let place (call (. facts note-local-rule) instance rule))
    (if (== (. ([] (. facts local-rules) place) stream) no-type)
      (let stream (. stream-view type))
      (let item (. stream-view item))
      (if (not (call record-stream-view matched stream item (call encoded)))
        (call decline id)
        (return false)
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) buffer-item)
      (call (. scratch types push) result)
      (let captured
        (call (. types class-with-args)
          (block
            (arg (. types capture-result-decl module))
            (arg (. types capture-result-decl decl))
            (arg mark)
          )
        )
      )
      (call (. types complete) captured)
      (let adapted (call (. types optional-of) captured))
      (call (. types complete) adapted)
      (= (. ([] (. facts local-rules) place) adapted) adapted)
      (= (. ([] (. facts local-rules) place) stream) stream)
      (= (. ([] (. facts local-rules) place) buffer) (. stream-view buffer))
      (else-if (!= (. ([] (. facts local-rules) place) stream) (. stream-view type))
        (call decline id)
        (return false)
      )
    )
    (if (or (not (call record-commit id)) (not (call (. types is-optional) (call (. calls protocol-getter) (. stream-view type) (call view-name (call encoded)) id .role-view))))
      (call decline id)
      (return false)
    )
    (return true)
  )
  (fn-do _ coded-rule SyntaxId
    (param call SyntaxId)
    ; The declaration of the local rule a call of a rule names whose body is code that runs
    ; patterns rather than a pattern, or none where it names another.
    (let resolution (call (. bindings resolution-of) (. frame binding) call))
    (if (!= (. resolution kind) .resolve-slot)
      (return 0)
    )
    (let row ([] (. bindings slots) (. resolution slot)))
    (if (or (!= (. row kind) .slot-lazy) (== (. row group) 0))
      (return 0)
    )
    (match? ([] (. tree nodes) (. row group))
      (case (call .node-declare declaration)
        (if (and (. declaration is-pattern) (!= (. declaration right) 0) (not stream-match))
          (return (. row group))
        )
        (lazy stream-match (is ([] (. tree nodes) (. declaration right)) .node-stream-match))
      )
    )
    (return 0)
  )
  (fn-do _ coded-rule-type TypeId
    (param id SyntaxId)
    (param rule SyntaxId)
    ; A call of a local rule whose body is code, as the reference calls the function it makes of
    ; it: the stream is told the pattern stands at the cursor before, the code runs, each pattern
    ; in it on the stream from where the stream stands, and the stream is asked for its view
    ; after, which says where the code left it and how far it read. The reference's function
    ; holds the names the code reads; here the code runs where the rule is called, where they
    ; are. The code is typed where the rule is first called, for the stream it is called on, and
    ; must give an optional `CaptureResult` of the stream's items, as a pattern in it does, whose
    ; result the call gives; code that gives anything else, or that calls the rule, is reported
    ; as the reference reports it. A rule that states a type or is marked to roll back, and one
    ; called on another stream or under a helper, have no shape here.
    (let left SyntaxId 0)
    (let code SyntaxId 0)
    (let marked false)
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (= left (. declaration left))
        (= code (. declaration right))
        (= marked (. declaration rollback))
      )
    )
    (let stated false)
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (= stated (!= (. row type) 0))
      )
    )
    (if (or (== code 0) marked stated (!= (. helping helper) null))
      (call decline id)
      (return invalid-type)
    )
    (let untyped (call (. program store-atom) "Unable to infer pattern result type"))
    (if (!= (call (. coded-rules find) rule) null)
      (call (. frame diagnose) id .stated untyped)
      (return invalid-type)
    )
    (if (not (call record-commit id))
      (call decline id)
      (return invalid-type)
    )
    (let typed (call (. coded-typed find) rule))
    (if (and (!= typed null) (!= ([] coded-streams typed) (. stream-view type)))
      (call decline id)
      (return invalid-type)
    )
    (let given (call (. facts node-type) instance code))
    (if (== typed null)
      (let saved-stream rule-streaming)
      (let saved-expected arms-expected)
      (let saved-unvalued valuing)
      (let saved-explicit helping)
      (let ran stream-view)
      (+= coded-rules rule)
      (= rule-streaming (= (. rule-streaming matched) 0))
      (= rule-streaming (= (. rule-streaming stream) (. ran type)))
      (= rule-streaming (= (. rule-streaming encoded) (call encoded)))
      (= arms-expected no-type)
      (= valuing (= (. valuing unvalued) false))
      (= helping (= (. helping explicit) false))
      (= given (call infer code))
      (let carried-rolls (. helping rolls))
      (= helping saved-explicit)
      (= helping (= (. helping rolls) carried-rolls))
      (= valuing saved-unvalued)
      (= arms-expected saved-expected)
      (= rule-streaming saved-stream)
      (= stream-view ran)
      (call (. coded-rules pop))
      (+= coded-typed rule)
      (+= coded-streams (. ran type))
    )
    (if (== given invalid-type)
      (return invalid-type)
    )
    (let view (call (. calls protocol-getter) (. stream-view type) (call view-name (call encoded)) id .role-view))
    (if (not (call (. types is-optional) view))
      (call decline id)
      (return invalid-type)
    )
    (let held
      (scope (if-expr (and (!= given no-type) (call (. types is-optional) given)) inner-given no-type)
        (lazy inner-given (call (. types optional-inner) given))
      )
    )
    (if (or (== held no-type) (not (call same-decl (call class-ref types held) (. types capture-result-decl))))
      (call (. frame diagnose) id .stated untyped)
      (return invalid-type)
    )
    (if (!= (call class-arg types held 0) buffer-item)
      (call decline id)
      (return invalid-type)
    )
    (return (call class-arg types held 1))
  )
  (fn-do + left-call SyntaxId
    (param id SyntaxId)
    (param target SyntaxId)
    (param seen (list SyntaxId))
    ; The call by which a part of a grammar calls a rule before it reads an item, or none:
    ; the local rule `target`, or for none the rule the module declares that is being checked,
    ; called directly or through the local rules called first. A call of any other rule is taken
    ; to read before it calls anything. Such a rule would call itself forever.
    (match? ([] (. tree nodes) id)
      (case .node-stream-call
        (if (call calls-target id target)
          (return id)
        )
        (let rule (call rule-of id))
        (if (or (== rule 0) (!= (call (. seen find) rule) null))
          (return 0)
        )
        (+= seen rule)
        (return (call left-call (call (. tree rule-pattern) rule) target seen))
      )
      (case (call .node-stream-and row)
        (let leading (call left-call (. row left) target seen))
        (if (or (!= leading 0) (not (call may-read-none (. row left) (call (of List SyntaxId)))))
          (return leading)
        )
        (return (call left-call (. row right) target seen))
      )
      (case (call .node-stream-or row)
        (let leading (call left-call (. row left) target seen))
        (return (if-expr (!= leading 0) leading (call left-call (. row right) target seen)))
      )
      (case (call .node-stream-unary row)
        (return (call left-call (. row operand) target seen))
      )
      (case (call .node-stream-length row)
        (return (call left-call (. row operand) target seen))
      )
      (case (call .node-stream-capture row)
        (return (call left-call (. row pattern) target seen))
      )
      (case (call .node-stream-transform row)
        (if (!= (. row pattern) 0)
          (return (call left-call (. row pattern) target seen))
        )
      )
      (case (call .node-stream-panic row)
        (if (!= (. row pattern) 0)
          (return (call left-call (. row pattern) target seen))
        )
      )
    )
    (return 0)
  )
  (fn-do _ calls-target Bool
    (param call SyntaxId)
    (param target SyntaxId)
    ; Whether a call of a rule names the local rule `target`, or for none the rule the module
    ; declares that is being checked.
    (if (!= target 0)
      (return (== (call rule-of call) target))
    )
    (let resolution (call (. bindings resolution-of) (. frame binding) call))
    (return (and (== (. resolution kind) .resolve-function) (== (. resolution decl) (. frame decl)) (== (. resolution module) module)))
  )
  (fn-do _ may-read-none Bool
    (param id SyntaxId)
    (param seen (list SyntaxId))
    ; Whether a part of a grammar may match without reading an item, as far as it is
    ; known here: a call of a rule other than a local one is taken to read.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-string row)
        (return (== (. row text length) 0))
      )
      (case (call .node-stream-and row)
        (return (and (call may-read-none (. row left) seen) (call may-read-none (. row right) seen)))
      )
      (case (call .node-stream-or row)
        (return (or (call may-read-none (. row left) seen) (call may-read-none (. row right) seen)))
      )
      (case (call .node-stream-unary row)
        (return (or (!= (. row op) .one-or-more-op) (call may-read-none (. row operand) seen)))
      )
      (case (call .node-stream-length row)
        (match? ([] (. tree nodes) (. row min))
          (case (call .node-integer-syntax bound)
            (if (== (. (call parse-integer-literal (. bound value)) value) 0)
              (return true)
            )
          )
        )
        (return (call may-read-none (. row operand) seen))
      )
      (case (call .node-stream-capture row)
        (return (call may-read-none (. row pattern) seen))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call may-read-none (. row pattern) seen)))
      )
      (case (call .node-stream-panic row)
        (return (and (!= (. row pattern) 0) (call may-read-none (. row pattern) seen)))
      )
      (case .node-stream-call
        (let rule (call rule-of id))
        (if (or (== rule 0) (!= (call (. seen find) rule) null))
          (return false)
        )
        (+= seen rule)
        (return (call may-read-none (call (. tree rule-pattern) rule) seen))
      )
    )
    (return false)
  )
  (fn-do + report-left-recursion _
    (param call SyntaxId)
    ; Reports a call by which a rule calls itself before it reads anything.
    (let name "")
    (match? ([] (. tree nodes) call)
      (case (call .node-stream-call row)
        (= name (. row name text))
      )
    )
    (let text
      (paragraph
        (str "\"" name "\" calls itself before reading any input, so it never ends; read input before this call, or write the repetition with \"*\"")
      )
    )
    (call (. frame diagnose) call .stated (call (. program store-atom) text))
  )
  (fn-do _ rule-type TypeId
    (param rule SyntaxId)
    ; What a local rule gives, typed where it is first called: its arms are typed as a pattern of
    ; their own whose names are its own, which reads the stream from where it is called, and
    ; joined, then converted to the type its declaration states. The reference runs the rule in
    ; the function that calls it, where the rule reads that function's locals and the names its
    ; match captured. A rule that calls itself, directly or through other local rules, gives at
    ; those calls the type its declaration states, and each rule on the way is one the reference
    ; runs as a function of its own, which answers the optional of what the rule gives; one that
    ; states no type is an error at the rule. Nor has a rule called under another helper than it was
    ; typed under, whose values that helper made. One typed for a call that gives its text states
    ; that it gives text. A rule beside a rule's pattern that is marked to roll back, or whose
    ; pattern has an arm that is, asks the helper for a mark before each of its actions, as the
    ; reference does a rule it compiles on its own. One beside a match's pattern that is marked
    ; so gives the mark to each of its arms. Its arms give their values whether or not the call it
    ; is first typed at reads what it gives: a later call may.
    (let left SyntaxId 0)
    (let matched SyntaxId 0)
    (let marked false)
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (= left (. declaration left))
        (= matched (. declaration right))
        (= marked (. declaration rollback))
      )
    )
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (if (== pattern 0)
      (call decline rule)
      (return invalid-type)
    )
    (let known (call (. facts node-type) instance matched))
    (if (!= known no-type)
      (let typed (call (. typed-rules find) rule))
      (if (and (!= typed null) (!= ([] typed-helpers typed) (. helping site)))
        (call decline rule)
        (return invalid-type)
      )
      (return known)
    )
    (let declared no-type)
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (if (!= (. row type) 0)
          (= declared (call (. types evaluate-type) module tree (. row type) (. frame env)))
        )
      )
    )
    (if (== declared invalid-type)
      (call decline rule)
      (return invalid-type)
    )
    (if (. helping span-typing)
      (= declared (. types string-type))
    )
    (let calling (call (. rules find) rule))
    (if (!= calling null)
      (let closing (call left-call pattern rule (call (of List SyntaxId))))
      (if (!= closing 0)
        (call report-left-recursion closing)
        (return invalid-type)
      )
      (if (== declared no-type)
        (call (. frame diagnose) left .stated (call (. program store-atom) "Can't infer return type after recursion"))
        (return invalid-type)
      )
      (for (in position (..< calling (. rules length)))
        (= (. ([] (. facts local-rules) (call (. facts note-local-rule) instance ([] rules position))) recursive) true)
      )
      (return declared)
    )
    (let place (call (. facts note-local-rule) instance rule))
    (+= rules rule)
    (+= typed-rules rule)
    (+= typed-helpers (. helping site))
    (let own-arms rule-arming)
    (let base (. capture-sites length))
    (= rule-arming
      (call RuleArms
        (block
          (arg declared)
          (arg (call gives-source-span declared))
          (arg true)
          (arg (== declared (. types string-type)))
          (arg pattern)
          (arg base)
          (arg (. rule-arming casting))
        )
      )
    )
    (let saved-explicit helping)
    (let saved-unvalued valuing)
    (= helping (= (. helping explicit) (or marked (and beside-rule (call (. tree holds-rollback) pattern)))))
    (= valuing (= (. valuing unvalued) false))
    (let joined (call arms-type pattern))
    (= valuing saved-unvalued)
    (let carried-rolls (. helping rolls))
    (= helping saved-explicit)
    (= helping (= (. helping rolls) carried-rolls))
    (-= ([] capture-sites (..< base (. capture-sites length))))
    (-= ([] capture-slots (..< base (. capture-slots length))))
    (-= ([] capture-accumulating (..< base (. capture-accumulating length))))
    (-= ([] capture-patterns (..< base (. capture-patterns length))))
    (-= ([] capture-repeats (..< base (. capture-repeats length))))
    (= rule-arming own-arms)
    (call (. rules pop))
    (if (== joined invalid-type)
      (return invalid-type)
    )
    (let result declared)
    (if (== result no-type)
      (= result (if-expr (== joined no-type) (. types string-type) joined))
    )
    (call convert-stream-arms pattern result)
    (if (and (!= declared no-type) (!= declared (. types string-type)))
      (call note-arm-casts pattern declared)
    )
    (call (. facts set-node-type) instance pattern result)
    (call (. facts set-node-type) instance matched result)
    (= (. ([] (. facts local-rules) place) answer) (call (. types optional-around) result))
    (return result)
  )
  (fn-expr _ item-holds Bool
    (param point U64)
    ; Whether integer items hold a character a pattern tests them against as its code point: one
    ; their type fits, and over items of a byte, which hold the UTF-8 of text, one that is ASCII.
    (and (call literal-fits-target types (call IntegerLiteral point false false) (. stream-view item)) ascii-or-wide)
    (where
      (lazy ascii-or-wide (or (< point 0x80) (> (. (call (. types completion-of) (. stream-view item)) bit-size) 8)))
    )
  )
  (fn-do _ counts Bool
    (param part SyntaxId)
    (param id SyntaxId)
    (param repeated Bool)
    ; Whether a bound of a count has a shape here, and the error at the bound where it has not: a
    ; number written, or an integer computed as the match runs. The reference reads the most again
    ; before each time it takes the part, so a bound it reads more than once must give the same
    ; each time without doing anything, as `steady` says. A bound is typed once, however often the
    ; part is.
    (if (call (. tree count-bound) id)
      (return true)
    )
    (let known (call (. facts node-type) instance id))
    (let type (if-expr (!= known no-type) known (call infer id)))
    (if (or (== type invalid-type) (== type no-type))
      (call decline part)
      (return false)
    )
    (if (not (call is-integer-kind (call (. types intrinsic-of) type)))
      (let shown (call type-display types type))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "A count in a pattern must be an integer, not " shown)))
        )
      )
      (return false)
    )
    (if (and repeated (not (call steady id)))
      (let advice "compute it in a \"lazy\" local and count by its name")
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "A count in a pattern is read each time the part repeats, and this one may change between reads; " advice)
                  )
                )
              )
            )
          )
        )
      )
      (return false)
    )
    (return true)
  )
  (fn-do _ steady Bool
    (param id SyntaxId)
    ; Whether an expression gives the same each time it is read without doing anything: a name, a
    ; literal, a constant such as the size of a type, a lazy local or a global, an integer cast to
    ; another, one of two such picked by such a number or truth, and such numbers or truths
    ; compared, joined by `&&` or `||`, or added, taken away, multiplied or combined bit by bit,
    ; which wrap rather than panic.
    (if (call is-quiet id)
      (return true)
    )
    (let plan (call (. facts plan-of) instance id))
    (if (or (== plan .plan-constant) (== plan .plan-type-size))
      (return true)
    )
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) id))
        (if (== (. resolution kind) .resolve-global)
          (return true)
        )
        (let slot (call capture-slot id))
        (return (and (!= slot no-slot) (== (. ([] (. bindings slots) slot) kind) .slot-lazy)))
      )
      (case (call .node-cast-expression row)
        (let given (call (. types intrinsic-of) (call (. facts node-type) instance (. row lhs))))
        (let made (call (. types intrinsic-of) (call (. facts node-type) instance id)))
        (return (and (call is-integer-kind given) (call is-integer-kind made) (call steady (. row lhs))))
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .if-op)
          (let test (call (. types intrinsic-of) (call (. facts node-type) instance (. row rhs))))
          (return (and (or (call is-integer-kind test) (== test .bool)) (call steady (. row lhs)) (call steady (. row rhs))))
        )
        (if (or (== (. row op) .coalesce-op) (== (. row op) .else-op))
          (return (and (call steady (. row lhs)) (call steady (. row rhs))))
        )
        (if (call steady-operator (. row op))
          (let left (call (. types intrinsic-of) (call (. facts node-type) instance (. row lhs))))
          (let right (call (. types intrinsic-of) (call (. facts node-type) instance (. row rhs))))
          (let plain (and (or (call is-integer-kind left) (== left .bool)) (or (call is-integer-kind right) (== right .bool))))
          (return (and plain (call steady (. row lhs)) (call steady (. row rhs))))
        )
      )
    )
    (return false)
  )
  (fn-do _ final-raise SyntaxId
    (param body SyntaxId)
    ; The raise that always runs that an action ends in, as `?! Oops(1009)` is, or none.
    (match? ([] (. tree nodes) body)
      (case (call .node-assertion-syntax row)
        (return (if-expr (== (. row condition) 0) body 0))
      )
      (case (call .node-block row)
        (let last SyntaxId 0)
        (for (in statement ([] (. tree children) (. row body)))
          (let lazy false)
          (match? ([] (. tree nodes) statement)
            (case (call .node-declare declaration)
              (= lazy (. declaration is-lazy))
            )
          )
          (if (not lazy)
            (= last statement)
          )
        )
        (return (if-expr (!= last 0) (call final-raise last) 0))
      )
    )
    (return 0)
  )
  (fn-expr + always-passes Bool
    (param id SyntaxId)
    ; Whether a grammar always gives a value or raises: its last arm has no pattern, or
    ; raises.
    (match ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (call always-passes (. row right))
      )
      (case (call .node-stream-transform row)
        (or (== (. row pattern) 0) (call always-passes (. row pattern)))
      )
      (case .node-stream-panic
        true
      )
      (default
        false
      )
    )
  )
)

(fn-expr _ slice-read-text String
  ; The error for a name captured as a slice of a stream that holds no characters, read for more
  ; than its length or an item.
  "A capture over items that aren't characters can only be read for its length or an item"
)
