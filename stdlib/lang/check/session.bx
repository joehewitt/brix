(import ./binder)
(import ./binding)
(import ./checker-caches)
(import ./error-sets)
(import ./facts)
(import ./instances)
(import ./panics)
(import ./shared-results)
(import ./type-relation)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /lang/ast/ast-nodes)
(import /lang/ast/module)
(import /lang/ast/program)

(type + Session
  (implements (of Usable Void))
  ; One type pass over a program. A pass of a parallel type pass holds what the passes share
  ; (`shared`), has offered them the instances its typing queued before `offered`, and keeps in
  ; `local` those of them only it can intern, to type itself. It has published those of
  ; `Instances.settled` before `shared-settled`, whose errors settled after their bodies ended. The
  ; modules whose mains or whose functions it was seeded with (`seeded-modules`,
  ; `seeded-functions`) seed it again where it starts over (`restart`).
  (blank)
  (prop + program Program)
  (prop + bindings Bindings)
  (prop + binder Binder)
  (prop + types Types)
  (prop + relations Relations)
  (prop + scratch TypingScratch)
  (prop + instances Instances)
  (prop + facts Facts)
  (prop + caches CheckerCaches)
  (prop + errors ErrorSets)
  (prop + panics Panics)
  (prop + shared (? SharedTyping))
  (prop + offered Size)
  (prop + shared-settled Size)
  (prop + local (list InstanceId))
  (prop + seeded-modules (list ModuleId))
  (prop + seeded-functions (list Bool))
  (prop + unreached-modules (list ModuleId))
  (prop + typed-amid-errors (list Bool))
  (prop + fresh-bytes Size (= 0))
  (prop _ arena Arena)
  (prop _ facts-arena Arena)
  (prop _ typing-released Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param program Program)
    (lazy bindings (call Bindings))
    (lazy scratch (call TypingScratch))
    (lazy types (call bound-types program scratch))
    (lazy binder (call Binder bindings program (. types builtin-classes)))
    (lazy relations (call Relations types))
    (lazy instances (call Instances arena types))
    (lazy facts (call Facts facts-arena instances))
    (lazy caches (call CheckerCaches facts-arena))
    (lazy errors (call ErrorSets facts-arena types relations instances facts program))
    (lazy panics (call Panics types program instances facts))
  )
  (fn-expr + held-bytes Size :get
    (+ (. arena active-bytes) (. facts-arena active-bytes))
  )
  (fn-do + note-seed _
    (param module ModuleId)
    (param functions Bool)
    (+= seeded-modules module)
    (+= seeded-functions functions)
  )
  (fn-do + retarget _
    (param next Program)
    (= program next)
    (call (. binder retarget) next)
    (= (. types program) next)
    (= (. relations program) next)
    (= (. panics program) next)
    (call (. errors retarget) next)
    (call (. scratch idle clear))
  )
  (fn-do + restart _
    ; Drops everything typed so far for a pass that knows from the start every property the
    ; pass so far found tracked (`Panics.seed`).
    (let tracked (call (. panics tracked-keys)))
    (let traces-lint (. facts traces-lint))
    (call release)
    (= released false)
    (= typing-released false)
    (= fresh-bytes 0)
    (= arena (call Arena))
    (= facts-arena (call Arena))
    (= scratch (call TypingScratch))
    (= bindings (call Bindings))
    (= types (call bound-types program scratch))
    (= binder (call Binder bindings program (. types builtin-classes)))
    (= relations (call Relations types))
    (= instances (call Instances arena types))
    (= facts (call Facts facts-arena instances))
    (= (. facts traces-lint) traces-lint)
    (= caches (call CheckerCaches facts-arena))
    (= errors (call ErrorSets facts-arena types relations instances facts program))
    (= panics (call Panics types program instances facts))
    (call (. panics seed) tracked)
    (= offered 0)
    (call (. local clear))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + seal _
    ; Seals the type store over every type the instances typed and the facts still name, and the
    ; instance table with it, so nothing that runs after typing can intern or complete a type or
    ; schedule an instance. An instance that raises errors is first given the type it returns, which
    ; emission can no longer make, and so is a member a union forwards whose cases let errors out,
    ; and a local rule of one, for the function the reference may make of the rule, an action
    ; of one the reference runs in a function of its own, and a pattern of one given to a rule
    ; that calls a local rule, with the rule it is given to.
    (for (in position (..< 0 (. instances signatures length)))
      (let signature ([] (. instances signatures) position))
      (if (or (== (. signature errors count) 0) (== (. signature returns) invalid-type))
        (continue)
      )
      (let mark (. scratch types mark))
      (for (in offset (..< 0 (. signature errors count)))
        (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
      )
      (let value (if-expr (== (. signature returns) no-type) (. types void-type) (. signature returns)))
      (call (. instances set-result) (as position InstanceId) (call result-type types value mark))
    )
    (for (in position (..< 0 (. facts local-rules length)))
      (let row ([] (. facts local-rules) position))
      (let signature ([] (. instances signatures) (. row instance)))
      (if (and (!= (. signature errors count) 0) (!= (. row answer) no-type) (!= (. row answer) invalid-type))
        (let mark (. scratch types mark))
        (for (in offset (..< 0 (. signature errors count)))
          (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
        )
        (= (. ([] (. facts local-rules) position) result) (call result-type types (. row answer) mark))
        (if (!= (. row adapted) no-type)
          (let relayed (. scratch types mark))
          (for (in offset (..< 0 (. signature errors count)))
            (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
          )
          (= (. ([] (. facts local-rules) position) relayed) (call result-type types (. row adapted) relayed))
        )
      )
    )
    (for (in position (..< 0 (. facts outlined length)))
      (let row ([] (. facts outlined) position))
      (let signature ([] (. instances signatures) (. row instance)))
      (let value (call (. facts node-type) (. row instance) (. row arm)))
      (if (and (!= (. signature errors count) 0) (!= value no-type) (!= value invalid-type))
        (let mark (. scratch types mark))
        (for (in offset (..< 0 (. signature errors count)))
          (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
        )
        (= (. ([] (. facts outlined) position) result) (call result-type types value mark))
      )
    )
    (let raised false)
    (for (in position (..< 0 (. facts pattern-arguments length)))
      (let row ([] (. facts pattern-arguments) position))
      (let signature ([] (. instances signatures) (. row instance)))
      (if (and (!= (. row local) 0) (!= (. signature errors count) 0) answered)
        (let mark (. scratch types mark))
        (for (in offset (..< 0 (. signature errors count)))
          (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
        )
        (= (. ([] (. facts pattern-arguments) position) raised) (call result-type types (. row answer) mark))
        (= raised true)
      )
      (lazy answered (and (!= (. row answer) no-type) (!= (. row answer) invalid-type)))
    )
    (if raised
      (call note-raising-rules)
    )
    (for (in position (..< 0 (. facts forwards length)))
      (call settle-forward position)
    )
    (for (in position (..< 0 (. instances rows length)))
      (let row ([] (. instances rows) position))
      (if (== (. row state) .instance-unstarted)
        (continue)
      )
      (let signature ([] (. instances signatures) position))
      (call (. types reach) (. row self-type))
      (call (. types reach) (. row yields))
      (call (. types reach) (. signature returns))
      (call (. types reach) (. signature declared-returns))
      (call (. types reach) (. signature result))
      (for (in offset (..< (- (. signature args start) (. signature param-count)) (+ (. signature args start) (. signature args count))))
        (call (. types reach) ([] (. instances signature-types) offset))
      )
      (for (in offset (..< (. signature errors start) (+ (. signature errors start) (. signature errors count))))
        (call (. types reach) ([] (. instances signature-types) offset))
      )
      (for (in offset (..< (. row step-errors start) (+ (. row step-errors start) (. row step-errors count))))
        (call (. types reach) ([] (. instances signature-types) offset))
      )
      (if (!= (. row slot-start) (. U32 max))
        (for (in offset (..< (. row slot-start) (+ (. row slot-start) (. row slot-count))))
          (call (. types reach) ([] (. facts slot-types) offset))
        )
      )
      (if (!= (. row node-start) (. U32 max))
        (for (in offset (..< (. row node-start) (+ (. row node-start) (. row subtree count))))
          (call (. types reach) ([] (. facts node-types) offset))
        )
      )
    )
    (for (in held (. facts loose-types))
      (call (. types reach) (. held type))
    )
    (for (in held (. facts answer-types))
      (call (. types reach) (. held type))
    )
    (for (in row (. facts pattern-arguments))
      (call (. types reach) (. row result))
      (call (. types reach) (. row answer))
      (call (. types reach) (. row stream))
      (call (. types reach) (. row buffer))
      (call (. types reach) (. row helper))
      (call (. types reach) (. row raised))
    )
    (for (in row (. facts raising-rules))
      (call (. types reach) (. row given))
      (call (. types reach) (. row result))
    )
    (for (in row (. facts local-rules))
      (call (. types reach) (. row answer))
      (call (. types reach) (. row result))
      (call (. types reach) (. row stream))
      (call (. types reach) (. row buffer))
      (call (. types reach) (. row adapted))
      (call (. types reach) (. row relayed))
    )
    (for (in row (. facts outlined))
      (call (. types reach) (. row result))
    )
    (for (in forward (. facts forwards))
      (call (. types reach) (. forward result))
    )
    (for (in fact (. facts conversions))
      (call (. types reach) (. fact from))
      (call (. types reach) (. fact to))
    )
    (for (in fact (. facts conversion-parts))
      (call (. types reach) (. fact from))
      (call (. types reach) (. fact to))
    )
    (for (in fact (. facts pairs))
      (call (. types reach) (. fact from))
      (call (. types reach) (. fact to))
      (call (. types reach) (. fact unified))
    )
    (for (in type (. facts equalities))
      (call (. types reach) type)
    )
    (for (in type (. facts carried))
      (call (. types reach) type)
    )
    (for (in fact (. facts unwrapped))
      (call (. types reach) (. fact type))
    )
    (for (in fact (. facts relations))
      (call (. types reach) (. fact from))
      (call (. types reach) (. fact to))
    )
    (for (in fact (. facts forces))
      (call (. types reach) (. fact operand))
      (call (. types reach) (. fact result))
    )
    (for (in fact (. facts declared-values))
      (call (. types reach) (. fact declared))
      (call (. types reach) (. fact found))
    )
    (for (in fact (. facts context-casts))
      (call (. types reach) (. fact target))
    )
    (for (in fact (. facts case-owners))
      (call (. types reach) (. fact owner))
    )
    (for (in table (. facts witness-tables))
      (call (. types reach) (. table value))
      (call (. types reach) (. table interface))
    )
    (for (in table (. facts dynamic-witnesses))
      (call (. types reach) (. table value))
      (call (. types reach) (. table interface))
    )
    (for (in func (. facts witness-funcs))
      (call (. types reach) (. func interface))
    )
    (for (in call (. facts witness-calls))
      (call (. types reach) (. call interface))
    )
    (for (in diagnostic (. facts diagnostics))
      (call (. types reach) (. diagnostic from))
      (call (. types reach) (. diagnostic to))
    )
    (for (in type (. facts diagnostic-mentions))
      (call (. types reach) type)
    )
    (for (in material (. facts materials))
      (call (. types reach) (. material type))
      (call (. types reach) (. material interface))
    )
    (for (in body (. facts rollback-bodies))
      (call (. types reach) (. body held))
      (call (. types reach) (. body kept))
    )
    (for (in body (. facts storage-bodies))
      (call (. types reach) (. body context))
    )
    (for (in trigger (. facts markup-triggers))
      (call (. types reach) (. trigger target))
      (call (. types reach) (. trigger found))
      (call (. types reach) (. trigger host))
      (call (. types reach) (. trigger changes))
    )
    (call (. facts check-roles))
    (call (. types seal))
    (call (. instances seal))
  )
  (fn-do _ note-raising-rules _
    ; Records, for each call of a rule that gives it a pattern whose function may raise errors,
    ; what the function of the rule made for such a pattern returns: the rule's answer or one of
    ; the errors the pattern's function returns. A rule that raises errors of its own has none.
    (for (in fact (. facts calls))
      (if (or (== (. fact callee) no-instance) (== (. fact instance) (. instances dead)) raises)
        (continue)
      )
      (lazy raises (!= (. ([] (. instances signatures) (. fact callee)) errors count) 0))
      (let tree (. ([] (. program modules) (. ([] (. instances rows) (. fact instance)) module)) tree))
      (match? ([] (. tree nodes) (. fact syntax))
        (case (call .node-stream-call call)
          (for (in offset (..< 0 (. call args count)))
            (let argument ([] (. tree children) (+ (. call args start) offset)))
            (let expression argument)
            (match? ([] (. tree nodes) argument)
              (case (call .node-argument named)
                (= expression (. named expr))
              )
            )
            (let given (call raised-pattern (. fact instance) expression))
            (if (!= given no-type)
              (call note-raising-rule (. fact callee) (. fact instance) given)
            )
          )
        )
      )
    )
  )
  (fn-do _ raised-pattern TypeId
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; What the function made of a pattern an instance gives a rule returns where it may raise
    ; errors, or none.
    (for (in row (. facts pattern-arguments))
      (if (and (== (. row instance) instance) (== (. row syntax) syntax))
        (return (. row raised))
      )
    )
    (return no-type)
  )
  (fn-do _ note-raising-rule _
    (param callee InstanceId)
    (param caller InstanceId)
    (param given TypeId)
    ; Records what a rule given a pattern whose function returns `given` returns, once, and
    ; what the function of each of its local rules does.
    (for (in row (. facts raising-rules))
      (if (and (== (. row instance) callee) (== (. row given) given))
        (return)
      )
    )
    (let returns (. ([] (. instances signatures) callee) returns))
    (if (or (== returns no-type) (== returns invalid-type))
      (return)
    )
    (let signature ([] (. instances signatures) caller))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature errors count)))
      (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
    )
    (call (. facts raising-rules append) (call RaisingRule callee given (call result-type types returns mark)))
    (for (in position (..< 0 (. facts local-rules length)))
      (let local ([] (. facts local-rules) position))
      (if (or (!= (. local instance) callee) (== (. local answer) no-type) (== (. local answer) invalid-type))
        (continue)
      )
      (let held (. scratch types mark))
      (for (in offset (..< 0 (. signature errors count)))
        (call (. scratch types push) ([] (. instances signature-types) (+ (. signature errors start) offset)))
      )
      (call (. facts raising-rules append)
        (block
          (arg (call RaisingRule callee given (call result-type types (. local answer) held) (. local syntax)))
        )
      )
    )
  )
  (fn-do _ settle-forward _
    (param position Size)
    ; Gives a member a union forwards the type its function answers with, where the call of a
    ; case lets errors out: those of every case that does, each once.
    (let forward ([] (. facts forwards) position))
    (let mark (. scratch types mark))
    (let call (call (. facts first-call) (. forward instance) (. forward syntax)))
    (while (!= call no-fact)
      (let fact ([] (. facts calls) call))
      (if (and (. fact propagates) (!= (. fact callee) no-instance))
        (let signature ([] (. instances signatures) (. fact callee)))
        (for (in offset (..< 0 (. signature errors count)))
          (let error ([] (. instances signature-types) (+ (. signature errors start) offset)))
          (let known false)
          (for (in held (..< mark (. scratch types length)))
            (if (== ([] (. scratch types) held) error)
              (= known true)
            )
          )
          (if (not known)
            (call (. scratch types push) error)
          )
        )
      )
      (= call (. fact next))
    )
    (if (or (== (. scratch types length) mark) (== (. forward value) invalid-type))
      (call (. scratch types rewind) mark)
      (return)
    )
    (let value (if-expr (== (. forward value) no-type) (. types void-type) (. forward value)))
    (= (. ([] (. facts forwards) position) result) (call result-type types value mark))
  )
  (fn-do + release-typing _
    ; Frees everything the type pass needed only while it ran: the facts, bindings, panic marks,
    ; relation memo, and the scratch stacks. Types and instances survive for emission, so
    ; the types must be sealed first.
    (if typing-released
      (return)
    )
    (= typing-released true)
    (call (. panics release))
    (call (. facts release))
    (call (. facts-arena release))
    (call (. bindings release))
    (call (. relations release))
    (call (. scratch release))
  )
  (fn-do + release _
    (if released
      (return)
    )
    (= released true)
    (call release-typing)
    (call (. instances release))
    (call (. types release))
    (call (. arena release))
  )
)

(fn-do _ bound-types Types
  (param program Program)
  (param scratch TypingScratch)
  (let types (call Types program scratch))
  (call (. types bind-types))
  (call (. types declare-unit-equalities))
  (return types)
)
