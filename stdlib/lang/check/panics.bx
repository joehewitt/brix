(import ./claims)
(import ./facts)
(import ./idmap)
(import ./instances)
(import ./peer-ids)
(import ./type-store)
(import ./types)
(import /core/arena)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /stream/sort)
(blank)
(type-line + PropertyId (is Index))

(type + Panics
  (prop + types Types)
  (prop + program Program)
  (prop + instances Instances)
  (prop + facts Facts)
  (prop + arena Arena)
  (prop _ keys IdMap)
  (prop _ key-scratch (of Array U32 ArenaBacking))
  (prop _ tracked (list Bool))
  (prop _ write-instances (list InstanceId))
  (prop _ write-properties (list PropertyId))
  (prop _ untracked-instances (list InstanceId))
  (prop _ untracked-sites (list SyntaxId))
  (prop _ untracked-properties (list PropertyId))
  (prop _ untracked-relied (list Bool))
  (prop _ forced-instances (list InstanceId))
  (prop _ forced-sites (list SyntaxId))
  (prop _ forced-operands (list SyntaxId))
  (prop _ forced-declared (list TypeId))
  (prop _ forced-properties (list PropertyId))
  (prop _ lazy-readers (list InstanceId))
  (prop _ lazy-units (list InstanceId))
  (prop _ unit-calls (list U32))
  (prop _ unit-owners (list InstanceId))
  (prop _ init-gathered (list Bool))
  (prop _ init-first (list U32))
  (prop _ init-count (list U32))
  (prop _ init-starts (list SyntaxId))
  (prop _ init-ends (list SyntaxId))
  (prop _ outlined-instances (list InstanceId))
  (prop _ outlined-actions (list SyntaxId))
  (prop _ outlined-bodies (list SyntaxId))
  (prop _ cleared-generators (list InstanceId))
  (fn-do + This _
    (param types Types)
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (lazy key-scratch (call (of Array U32) arena 4))
  )
  (fn-do + release _
    (call (. keys release))
  )
  (fn-do + absorb _
    (param peer Panics)
    (param ids PeerIds)
    ; Takes in what another type pass over the program noted of the instances this pass takes from
    ; it (`PeerIds.owns`), and which properties it found tracked.
    (let properties (list PropertyId))
    (for (in index (..< 0 (. peer tracked length)))
      (= ([] key-scratch 0) (call (. peer keys key-word) index 0))
      (= ([] key-scratch 1) (call (. peer keys key-word) index 1))
      (= ([] key-scratch 2) (call (. peer keys key-word) index 2))
      (let id (call (. keys store) (. key-scratch data) 3))
      (if (. keys last-inserted)
        (+= tracked false)
      )
      (if ([] (. peer tracked) index)
        (= ([] tracked id) true)
      )
      (+= properties id)
    )
    (for (in position (..< 0 (. peer write-instances length)))
      (if (call (. ids owns) ([] (. peer write-instances) position))
        (+= write-instances (call (. ids instance) ([] (. peer write-instances) position)))
        (+= write-properties ([] properties ([] (. peer write-properties) position)))
      )
    )
    (for (in position (..< 0 (. peer untracked-instances length)))
      (if (call (. ids owns) ([] (. peer untracked-instances) position))
        (+= untracked-instances (call (. ids instance) ([] (. peer untracked-instances) position)))
        (+= untracked-sites ([] (. peer untracked-sites) position))
        (+= untracked-properties ([] properties ([] (. peer untracked-properties) position)))
        (+= untracked-relied ([] (. peer untracked-relied) position))
      )
    )
    (for (in position (..< 0 (. peer forced-instances length)))
      (if (call (. ids owns) ([] (. peer forced-instances) position))
        (+= forced-instances (call (. ids instance) ([] (. peer forced-instances) position)))
        (+= forced-sites ([] (. peer forced-sites) position))
        (+= forced-operands ([] (. peer forced-operands) position))
        (+= forced-declared (call (. ids type) ([] (. peer forced-declared) position)))
        (+= forced-properties ([] properties ([] (. peer forced-properties) position)))
      )
    )
    (for (in position (..< 0 (. peer lazy-readers length)))
      (if (call (. ids owns) ([] (. peer lazy-readers) position))
        (+= lazy-readers (call (. ids instance) ([] (. peer lazy-readers) position)))
        (+= lazy-units (call (. ids instance) ([] (. peer lazy-units) position)))
      )
    )
    (for (in position (..< 0 (. peer outlined-instances length)))
      (if (call (. ids owns) ([] (. peer outlined-instances) position))
        (+= outlined-instances (call (. ids instance) ([] (. peer outlined-instances) position)))
        (+= outlined-actions ([] (. peer outlined-actions) position))
        (+= outlined-bodies ([] (. peer outlined-bodies) position))
      )
    )
    (throw (call Panic "Typing in parallel cannot take in what a type pass settled of panics after typing") (if (or (!= (. peer unit-calls length) 0) (!= (. peer init-gathered length) 0))))
  )
  (fn-do + retire _
    (param retired (list Bool))
    (let writes (list InstanceId))
    (let written (list PropertyId))
    (for (in position (..< 0 (. write-instances length)))
      (if (not (call held-by retired ([] write-instances position)))
        (+= writes ([] write-instances position))
        (+= written ([] write-properties position))
      )
    )
    (= write-instances writes)
    (= write-properties written)
    (let untracked (list InstanceId))
    (let sites (list SyntaxId))
    (let properties (list PropertyId))
    (let relied (list Bool))
    (for (in position (..< 0 (. untracked-instances length)))
      (if (not (call held-by retired ([] untracked-instances position)))
        (+= untracked ([] untracked-instances position))
        (+= sites ([] untracked-sites position))
        (+= properties ([] untracked-properties position))
        (+= relied ([] untracked-relied position))
      )
    )
    (= untracked-instances untracked)
    (= untracked-sites sites)
    (= untracked-properties properties)
    (= untracked-relied relied)
    (let forced (list InstanceId))
    (let forced-at (list SyntaxId))
    (let operands (list SyntaxId))
    (let declared (list TypeId))
    (let forcing (list PropertyId))
    (for (in position (..< 0 (. forced-instances length)))
      (if (not (call held-by retired ([] forced-instances position)))
        (+= forced ([] forced-instances position))
        (+= forced-at ([] forced-sites position))
        (+= operands ([] forced-operands position))
        (+= declared ([] forced-declared position))
        (+= forcing ([] forced-properties position))
      )
    )
    (= forced-instances forced)
    (= forced-sites forced-at)
    (= forced-operands operands)
    (= forced-declared declared)
    (= forced-properties forcing)
    (let readers (list InstanceId))
    (let units (list InstanceId))
    (for (in position (..< 0 (. lazy-readers length)))
      (if (not (call held-by retired ([] lazy-readers position)))
        (+= readers ([] lazy-readers position))
        (+= units ([] lazy-units position))
      )
    )
    (= lazy-readers readers)
    (= lazy-units units)
    (let outlined (list InstanceId))
    (let actions (list SyntaxId))
    (let bodies (list SyntaxId))
    (for (in position (..< 0 (. outlined-instances length)))
      (if (not (call held-by retired ([] outlined-instances position)))
        (+= outlined ([] outlined-instances position))
        (+= actions ([] outlined-actions position))
        (+= bodies ([] outlined-bodies position))
      )
    )
    (= outlined-instances outlined)
    (= outlined-actions actions)
    (= outlined-bodies bodies)
    (let generators (list InstanceId))
    (for (in generator cleared-generators)
      (if (not (call held-by retired generator))
        (+= generators generator)
      )
    )
    (= cleared-generators generators)
    (call (. unit-calls clear))
    (call (. unit-owners clear))
  )
  (fn-expr _ held-by Bool
    (param retired (list Bool))
    (param instance InstanceId)
    (and (< (as instance Size) (. retired length)) ([] retired instance))
  )
  (fn-do + property-of (? PropertyId)
    (param receiver TypeId)
    (param name Atom)
    (if (or (== receiver no-type) (== receiver invalid-type))
      (return null)
    )
    (let found (call (. types property-named) receiver name))
    (if (not found)
      (return null)
    )
    (let ref (call class-ref types (. ([] (. types properties) found) owner)))
    (return (call property-id (. ref module) (. ref decl) name))
  )
  (fn-do + property-id PropertyId
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (= ([] key-scratch 0) module)
    (= ([] key-scratch 1) decl)
    (= ([] key-scratch 2) (as (call (. program atom-key) name) U32))
    (let id (call (. keys store) (. key-scratch data) 3))
    (if (. keys last-inserted)
      (+= tracked false)
    )
    (return id)
  )
  (fn-do + track _
    (param property PropertyId)
    (= ([] tracked property) true)
  )
  (fn-do + tracked-keys (list U32)
    (let found (list U32))
    (for (in index (..< 0 (. tracked length)))
      (if ([] tracked index)
        (+= found (call (. keys key-word) index 0))
        (+= found (call (. keys key-word) index 1))
        (+= found (call (. keys key-word) index 2))
      )
    )
    (return found)
  )
  (fn-do + seed _
    (param seeded (list U32))
    (for (in start (..< 0 (/ (. seeded length) 3)))
      (= ([] key-scratch 0) ([] seeded (* start 3)))
      (= ([] key-scratch 1) ([] seeded (+ (* start 3) 1)))
      (= ([] key-scratch 2) ([] seeded (+ (* start 3) 2)))
      (let id (call (. keys store) (. key-scratch data) 3))
      (if (. keys last-inserted)
        (+= tracked false)
      )
      (= ([] tracked id) true)
    )
  )
  (fn-do + note-write _
    (param instance InstanceId)
    (param property PropertyId)
    (+= write-instances instance)
    (+= write-properties property)
  )
  (fn-expr + is-tracked-property Bool
    (param property PropertyId)
    ; Whether a read typed so far tracks a property.
    ([] tracked property)
  )
  (fn-do + assume-untracked U32
    (param instance InstanceId)
    (param site SyntaxId)
    (param property PropertyId)
    ; A store to a property that no read typed so far tracks was typed as one that runs nothing,
    ; which leaves what is known of other properties. A read typed later may track it, and the
    ; store then runs the actions that read it (`typed-late`). Answers the store's place, which
    ; `rely-on-store` names.
    (+= untracked-instances instance)
    (+= untracked-sites site)
    (+= untracked-properties property)
    (+= untracked-relied false)
    (return (as (- (. untracked-sites length) 1) U32))
  )
  (fn-do + rely-on-store _
    (param index U32)
    ; Something typed after a store that runs nothing read what the flow knew of a property
    ; before it, which the store ends where it runs actions.
    (= ([] untracked-relied index) true)
  )
  (fn-do + note-forced _
    (param index U32)
    (param site SyntaxId)
    (param operand SyntaxId)
    (param declared TypeId)
    (+= forced-instances ([] untracked-instances index))
    (+= forced-sites site)
    (+= forced-operands operand)
    (+= forced-declared declared)
    (+= forced-properties ([] untracked-properties index))
  )
  (fn-do + typed-late Bool
    ; Whether a store typed as one that runs nothing has a property some read tracks once the
    ; program is typed, where what was typed after it read what the flow knew of a property
    ; (`rely-on-store`): the store ends what is known of every property, so the pass starts over
    ; knowing which properties are tracked (`seed`).
    (for (in position (..< 0 (. untracked-sites length)))
      (if (and ([] tracked ([] untracked-properties position)) ([] untracked-relied position))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + retest-forces _
    ; Tests again each force after a store typed as one that runs nothing of a property some read
    ; tracks once the program is typed, where the flow knew the property forced to hold a value:
    ; the store ends what was known of it, so it is read as declared (`note-forced`).
    (for (in position (..< 0 (. forced-sites length)))
      (if ([] tracked ([] forced-properties position))
        (let instance ([] forced-instances position))
        (let declared ([] forced-declared position))
        (call (. facts replace-node-type) instance ([] forced-operands position) declared)
        (let force (call (. facts first-force) instance ([] forced-sites position)))
        (while (!= force no-fact)
          (= (. ([] (. facts forces) force) operand) declared)
          (= (. ([] (. facts forces) force) is-narrowed) false)
          (= force (. ([] (. facts forces) force) next))
        )
        (call (. instances mark-may-panic) instance)
      )
    )
  )
  (fn-do + note-outlined _
    (param instance InstanceId)
    (param action SyntaxId)
    (param body SyntaxId)
    ; Notes an action of a grammar that the reference runs in a function of its own, which
    ; a panic in it would show.
    (+= outlined-instances instance)
    (+= outlined-actions action)
    (+= outlined-bodies body)
  )
  (fn-do + note-lazy-read _
    (param instance InstanceId)
    (param unit InstanceId)
    ; Notes that an instance reads a lazy property whose value `unit` types: the read evaluates
    ; the value when the object has none yet, so the reader may panic where the value does.
    (+= lazy-readers instance)
    (+= lazy-units unit)
  )
  (fn-do + note-inlined _
    (param instance InstanceId)
    (param unit InstanceId)
    ; Notes that an instance runs in its own frame the code an instance of its own types, as an
    ; element or a constructor runs a style rule it applies: it may panic where that code does.
    (+= lazy-readers instance)
    (+= lazy-units unit)
  )
  (fn-do + gather-unit-calls _
    ; Lists the calls the values of properties make, each with the instance that typed it, while
    ; the facts still say which that is: they are moved to their module's main afterwards.
    (let position 0u32)
    (for (in fact (. facts calls))
      (if (!= (. ([] (. instances rows) (. fact instance)) initializer) 0)
        (+= unit-calls position)
        (+= unit-owners (. fact instance))
      )
      (+= position 1)
    )
  )
  (fn-do + propagate _
    ; Settles which instances may panic. A write to a tracked property and the construction of a tracked
    ; object mark their instance. A call marks its caller when it can raise by itself, or when its
    ; callee is marked: each such call is listed under its callee once, and a mark passes to the callers
    ; listed under it, so the work is one visit of each call however deep the calls go. A call in a
    ; module's initializers marks nothing of its main, nor does the body of a task where the task is
    ; spawned, and a generator is never marked by what it calls. The value of a property is marked by
    ; the calls it makes, those its conversions make among them, and a mark on it passes to the
    ; instances that read the property lazily. The value of a case of an enum is marked too by the calls
    ; its module's main recorded where main typed the value first, which the module's statics run. An
    ; instance the reference takes for one that raises nothing is marked as one no call checks. A
    ; generator typing marked loses its mark once it has passed it on, and gets it back when the
    ; instances are settled again after an edit typed in place (`retype-edit`), which starts from what
    ; typing marked.
    (for (in generator cleared-generators)
      (call (. instances mark-may-panic) generator)
    )
    (call (. cleared-generators clear))
    (let position 0)
    (for (in property write-properties)
      (if (and ([] tracked property) (not (call is-generated-instance ([] write-instances position))))
        (call (. instances mark-may-panic) ([] write-instances position))
      )
      (+= position 1)
    )
    (let index 0u32)
    (for (in row (. instances rows))
      (if (call constructs-tracked row)
        (call (. instances mark-may-panic) index)
      )
      (if (call is-known-panic-free (. row module) (. row decl))
        (call (. instances mark-quiet) index)
      )
      (+= index 1)
    )
    (= init-gathered ([] Bool (. program modules length)))
    (= init-first ([] U32 (. program modules length)))
    (= init-count ([] U32 (. program modules length)))
    (let heads ([] U32 (. instances rows length)))
    (let links ([] U32 (. facts calls length)))
    (let callers ([] U32 (. facts calls length)))
    (let owned ([] Bool (. facts calls length)))
    (let owned-calls (list U32))
    (let owners (list InstanceId))
    (= position 0)
    (for (in listed unit-calls)
      (= ([] owned listed) true)
      (+= owned-calls listed)
      (+= owners ([] unit-owners position))
      (+= position 1)
    )
    (let mains (call main-instances))
    (= index 0)
    (for (in row (. instances rows))
      (let main ([] mains (. row module)))
      (if (and (!= (. row initializer) 0) (!= main no-instance))
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
          (case (call .decl-case case)
            (let tree (. ([] (. program modules) (. row module)) tree))
            (for (in node (.. (call (. tree subtree-start) (. case syntax)) (. case syntax)))
              (let fact (call (. facts first-call) main node))
              (while (!= fact no-fact)
                (if (not ([] owned fact))
                  (= ([] owned fact) true)
                  (+= owned-calls fact)
                  (+= owners index)
                )
                (= fact (. ([] (. facts calls) fact) next))
              )
            )
          )
        )
      )
      (+= index 1)
    )
    (= position 0)
    (for (in fact (. facts calls))
      (let listed position)
      (+= position 1)
      (= ([] callers listed) (. fact instance))
      (let caller ([] (. instances rows) (. fact instance)))
      (if (or (. caller is-generator) ([] owned listed) (call is-init-fact caller (. fact syntax)))
        (continue)
      )
      (if (call follows-callee fact)
        (= ([] links listed) ([] heads (. fact callee)))
        (= ([] heads (. fact callee)) (as (+ listed 1) U32))
        (else-if (and (not (. caller may-panic)) (call panic-capable-call fact))
          (call (. instances mark-may-panic) (. fact instance))
        )
      )
    )
    (= position 0)
    (for (in listed owned-calls)
      (let unit ([] owners position))
      (+= position 1)
      (let fact ([] (. facts calls) listed))
      (= ([] callers listed) unit)
      (if (call follows-callee fact)
        (= ([] links listed) ([] heads (. fact callee)))
        (= ([] heads (. fact callee)) (+ listed 1))
        (else-if (call panic-capable-call fact)
          (call (. instances mark-may-panic) unit)
        )
      )
    )
    (let reader-heads ([] U32 (. instances rows length)))
    (let reader-links ([] U32 (. lazy-readers length)))
    (= position 0)
    (for (in unit lazy-units)
      (= ([] reader-links position) ([] reader-heads unit))
      (= ([] reader-heads unit) (as (+ position 1) U32))
      (+= position 1)
    )
    (let pending (list InstanceId))
    (= index 0)
    (for (in row (. instances rows))
      (if (. row may-panic)
        (+= pending index)
      )
      (+= index 1)
    )
    (let next 0)
    (while (< next (. pending length))
      (let marked ([] pending next))
      (let link ([] heads marked))
      (+= next 1)
      (while (!= link 0)
        (let caller ([] callers (- link 1)))
        (if (not (. ([] (. instances rows) caller) may-panic))
          (call (. instances mark-may-panic) caller)
          (+= pending caller)
        )
        (= link ([] links (- link 1)))
      )
      (let reader ([] reader-heads marked))
      (while (!= reader 0)
        (let reads ([] lazy-readers (- reader 1)))
        (if (and (not (. ([] (. instances rows) reads) may-panic)) (not (. ([] (. instances rows) reads) is-generator)))
          (call (. instances mark-may-panic) reads)
          (+= pending reads)
        )
        (= reader ([] reader-links (- reader 1)))
      )
    )
    (let cleared 0u32)
    (for (in row (. instances rows))
      (if (and (. row is-generator) (. row may-panic))
        (call (. instances clear-may-panic) cleared)
        (+= cleared-generators cleared)
      )
      (+= cleared 1)
    )
    (call settle-outlined)
  )
  (fn-do _ main-instances (list InstanceId)
    ; The main of each module, or none where no instance types it.
    (let mains (list InstanceId))
    (for (in _ (..< 0 (. program modules length)))
      (+= mains no-instance)
    )
    (let index 0u32)
    (for (in row (. instances rows))
      (if (and (== (. row initializer) 0) (== (. row decl) (. ([] (. program modules) (. row module)) main-decl)))
        (= ([] mains (. row module)) index)
      )
      (+= index 1)
    )
    (return mains)
  )
  (fn-do _ settle-outlined _
    ; Plans each action noted as run in a function of its own where a call in it may panic, once
    ; which instances may panic is settled.
    (if (== (. outlined-actions length) 0)
      (return)
    )
    (let heads (list U32))
    (for (in _ (..< 0 (. instances rows length)))
      (+= heads (. U32 max))
    )
    (let links (list U32))
    (for (in position (..< 0 (. outlined-actions length)))
      (+= links ([] heads ([] outlined-instances position)))
      (= ([] heads ([] outlined-instances position)) (as position U32))
    )
    (for (in fact (. facts calls))
      (let position ([] heads (. fact instance)))
      (while (!= position (. U32 max))
        (let body ([] outlined-bodies position))
        (let tree (. ([] (. program modules) (. ([] (. instances rows) (. fact instance)) module)) tree))
        (if (and in-body (call panic-capable-call fact))
          (call (. facts set-plan) (. fact instance) ([] outlined-actions position) .plan-outlined-panic)
        )
        (lazy in-body (and (>= (. fact syntax) (call (. tree subtree-start) body)) (<= (. fact syntax) body)))
        (= position ([] links position))
      )
    )
  )
  (fn-do _ constructs-tracked Bool
    (param row Instance)
    ; Whether an instance is a constructor of a class with a property some read tracks, whose
    ; stores run the actions that read it.
    (let kind (. DeclKind function-decl))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= kind (. fn kind))
      )
    )
    (if (and (!= kind .constructor-decl) (!= kind .default-constructor-decl))
      (return false)
    )
    (if (or (== (. row self-type) no-type) (== (. row self-type) invalid-type))
      (return false)
    )
    (for (in property (call (. types properties-of) (. row self-type)))
      (let ref (call class-ref types (call (. types tracked-root) (. property owner) (. property name))))
      (if (call is-tracked (. ref module) (. ref decl) (. property name))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-tracked Bool
    (param module ModuleId)
    (param decl DeclId)
    (param name Atom)
    (= ([] key-scratch 0) module)
    (= ([] key-scratch 1) decl)
    (= ([] key-scratch 2) (as (call (. program atom-key) name) U32))
    (let found (call (. keys find) (. key-scratch data) 3))
    (return (if-expr found ([] tracked found) false))
  )
  (fn-expr _ follows-callee Bool
    (param fact CallFact)
    ; Whether a call can raise exactly when its callee is one that may: every case of
    ; `panic-capable-call` that does not answer before it reads the callee's mark, and whose
    ; answer after it is no.
    (case? (or (== (. fact callee) no-instance) (call spawns-task (. fact form)))
      false
    )
    (case? (call (. ([] (. program modules) (. callee module)) name ends-with) ".h")
      false
    )
    (case? (or (call is-known-panic-free (. callee module) (. callee decl)) (call is-table-intrinsic (. callee module) (. callee decl)))
      false
    )
    (case? (or (== (. callee self-type) no-type) (== (. callee self-type) invalid-type))
      true
    )
    (default
      (!= (call (. types intrinsic-of) (. callee self-type)) .interface)
    )
    (where
      (lazy callee ([] (. instances rows) (. fact callee)))
    )
  )
  (fn-do + panic-capable-call Bool
    (param fact CallFact)
    ; Whether a call may raise a panic. A C function that suspends the task may: the task is checked
    ; for being terminated after it, which raises the termination panic, and the callers of the
    ; function that calls it must take it. One that leaves a termination to its caller does not
    ; (`leaves-termination`).
    (if (and (== (. fact form) .call-closure) (== (. fact callee) no-instance))
      (return true)
    )
    (if (or (== (. fact callee) no-instance) (call spawns-task (. fact form)))
      (return false)
    )
    (let callee ([] (. instances rows) (. fact callee)))
    (if (call (. ([] (. program modules) (. callee module)) name ends-with) ".h")
      (let name (call c-function-name (. callee module) (. callee decl)))
      (if (or (call is-elided-c-function (. callee module) (. callee decl)) (call leaves-termination name))
        (return false)
      )
      (return (or (call suspends-task name) (not (call is-leaf-function (. callee module) (. callee decl)))))
    )
    (if (call is-known-panic-free (. callee module) (. callee decl))
      (return false)
    )
    (if (call is-table-intrinsic (. callee module) (. callee decl))
      (return true)
    )
    (if (. callee may-panic)
      (return true)
    )
    (if (or (== (. callee self-type) no-type) (== (. callee self-type) invalid-type))
      (return false)
    )
    (return (== (call (. types intrinsic-of) (. callee self-type)) .interface))
  )
  (fn-do _ is-init-fact Bool
    (param caller Instance)
    (param syntax SyntaxId)
    (let owner-module ([] (. program modules) (. caller module)))
    (if (!= (. caller decl) (. owner-module main-decl))
      (return false)
    )
    (if (not ([] init-gathered (. caller module)))
      (call gather-init-ranges (. caller module))
    )
    (let first ([] init-first (. caller module)))
    (let low first)
    (let high (+ first ([] init-count (. caller module))))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] init-starts middle) syntax)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return (and (> low first) (<= syntax ([] init-ends (- low 1)))))
  )
  (fn-do _ gather-init-ranges _
    (param module ModuleId)
    ; The ranges of a module's initializers, which do not meet, in the order of their nodes: a
    ; node is looked for among them by halving.
    (let owner-module ([] (. program modules) module))
    (let tree (. owner-module tree))
    (let first (as (. init-starts length) U32))
    (let keys (list U64))
    (for (in decl (. owner-module decls))
      (let last SyntaxId 0)
      (match? decl
        (case (call .decl-class class-row)
          (= last (. class-row syntax))
        )
        (case (call .decl-property property)
          (if (== (. property owner) 0)
            (= last (. property value))
          )
        )
      )
      (if (!= last 0)
        (let start U64 (call (. tree subtree-start) last))
        (+= keys (/or/ (/lshift/ start 32) last))
      )
    )
    (let sorted (call sort keys))
    (for (in key sorted)
      (+= init-starts (as (/rshift/ key 32) SyntaxId))
      (+= init-ends (as (/and/ key 0xffffffff) SyntaxId))
    )
    (= ([] init-gathered module) true)
    (= ([] init-first module) first)
    (= ([] init-count module) (- (as (. init-starts length) U32) first))
  )
  (fn-expr _ is-generated-instance Bool
    (param instance InstanceId)
    (match ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (. fn is-generated)
      )
      (default
        false
      )
    )
    (where
      (lazy row ([] (. instances rows) instance))
    )
  )
  (fn-do + c-function-name String
    (param module ModuleId)
    (param decl DeclId)
    (let name "")
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (if (. fn name)
          (let atom (. fn name))
          (= name (. atom text))
        )
      )
    )
    (return name)
  )
  (fn-do _ is-elided-c-function Bool
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (if (. fn name)
          (return (== (. fn name) (!! (. types bench-collect-atom))))
        )
      )
    )
    (return false)
  )
  (fn-do + is-leaf-function Bool
    (param module ModuleId)
    (param decl DeclId)
    (let mask 0u32)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (= mask (. fn effects))
      )
    )
    (let leaf U32 (. CompilationEffect gc-leaf))
    (return (!= (/and/ mask leaf) 0))
  )
  (fn-do + is-table-intrinsic Bool
    (param module ModuleId)
    (param decl DeclId)
    (if (!= module (. types table-module))
      (return false)
    )
    (let owner-module ([] (. program modules) module))
    (let name "")
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-function fn)
        (if (or (== (. fn kind) .table-arena-constructor-decl) (== (. fn kind) .table-capacity-constructor-decl))
          (return true)
        )
        (if (== (. fn kind) .index-span-range-constructor-decl)
          (return true)
        )
        (if (. fn name)
          (let atom (. fn name))
          (= name (. atom text))
        )
      )
    )
    (return (or (== name "[]") (== name "[]=") (== name "append")))
  )
  (fn-do _ is-known-panic-free Bool
    (param module ModuleId)
    (param decl DeclId)
    (let name "")
    (let owner DeclId 0)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (if (. fn name)
          (let atom (. fn name))
          (= name (. atom text))
        )
        (= owner (. fn owner))
      )
    )
    (if (== owner 0)
      (return false)
    )
    (if (call (. types array-decl refers-to) module owner)
      (return (== name "slice-string"))
    )
    (if (call (. types token-stream-decl refers-to) module owner)
      (let reads (or (== name "read") (== name "has-more") (== name "location")))
      (return (or reads (== name "error-location") (== name "get-match-location")))
    )
    (if (call (. types readable-decl refers-to) module owner)
      (return (== name "<-read"))
    )
    (return false)
  )
)
