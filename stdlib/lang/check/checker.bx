)

(fn-do _ add-name _
  (param names (list String))
  (param name String)
  (if (and (!= name "This") (== (call (. names find) name) null))
    (+= names name)
  )
)

(fn-do _ add-slot _
  (param name Atom)
  (param builder TypeId)
  (param given (list Atom))
  (param builders (list TypeId))
  ; Adds a slot to those given, with its builder, in the order of their names, the default one
  ; first, as the reference orders them.
  (let spot (. given length))
  (while (and (!= spot 0) (> (. ([] given (- spot 1)) text) (. name text)))
    (-= spot 1)
  )
  (call (. given insert) name spot)
  (call (. builders insert) builder spot)
)

(fn-expr _ bare-value-text String
  "A value cannot stand alone as a step; use it, or remove it"
)

(fn-expr _ is-type-info-flag Bool
  (param name Atom)
  ; The Bool facts a type's info answers in the reference: `Item.is-integer` and its kin.
  (match (. name text)
    (case= "is-integer"
      true
    )
    (case= "is-number"
      true
    )
    (case= "is-signed"
      true
    )
    (case= "is-tuple"
      true
    )
    (case= "is-struct"
      true
    )
    (case= "read-only"
      true
    )
    (default
      false
    )
  )
)

(fn-expr _ is-type-info-text Bool
  (param name Atom)
  (match (. name text)
    (case= "name"
      true
    )
    (case= "inlined-name"
      true
    )
    (case= "concrete-name"
      true
    )
    (case= "concrete-key"
      true
    )
    (case= "key"
      true
    )
    (default
      false
    )
  )
)

(fn-expr _ optional-match-text String
  (param form String)
  ; The error for a grammar loop or pipeline whose matches give an optional value, which
  ; the values it gives can't hold, since none of them ends it.
  (str "Grammar " form " can't give an optional value; add an action that gives one")
)

(fn-do _ owns-case Bool
  (param owner (? Atom))
  (param written (? Atom))
  (if (and owner written)
    (return (== owner written))
  )
  (return (and (not owner) (not written)))
)

(fn-expr _ print-block-text String
  "A print is a step and gives no value; end the block with its value"
)

(fn-do _ selector-name String
  (param name String)
  ; An id as a style rule's name matches it: each capital is a hyphen and its small letter.
  (let spelled "")
  (for (in char name)
    (if (and (>= char 'A') (<= char 'Z'))
      (+= spelled "-")
      (+= spelled (. (str char) lowercased))
      (else
        (+= spelled char)
      )
    )
  )
  (return spelled)
)

(fn-do _ unbind-names _
  (param mark Size)
  (param names (list Atom))
  (param held (list Bool))
  ; Takes out of reach the names put in reach since a mark.
  (while (> (. names length) mark)
    (call (. names pop))
    (call (. held pop))
  )
)
